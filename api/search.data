119535,"_31325":119536,"_21467":119539,"_28174":72275},"Despliega desde AWS Marketplace",[50623,119537,119538],"Despliegue","Otros modelos",[],{"_3602":72276,"_30987":72275,"_21467":119541,"_5":14750,"_28174":72275,"_3058":119542},[],"Ejecuta una instancia preconfigurada de Lamassu IoT en Amazon EC2.",{"_3602":72277,"_30987":72275,"_5":31322,"_21467":119544,"_28174":119545,"_3058":119546},[],"/docs/es/deployment/aws-marketplace#antes-de-empezar","Antes de empezar",{"_3602":72278,"_30987":72275,"_5":31322,"_21467":119548,"_28174":119549,"_3058":119550},[],"/docs/es/deployment/aws-marketplace#requisitos-de-infraestructura","Requisitos de infraestructura",{"_3602":72279,"_30987":72275,"_5":31322,"_21467":119552,"_28174":119553,"_3058":119554},[],"/docs/es/deployment/aws-marketplace#abre-la-oferta","Abre la oferta",{"_3602":72280,"_30987":72275,"_5":31322,"_21467":119556,"_28174":119557,"_3058":119558},[],"/docs/es/deployment/aws-marketplace#configura-la-instancia","Configura la instancia",{"_3602":72281,"_30987":72275,"_5":31322,"_21467":119560,"_28174":119561,"_3058":119562},[],"/docs/es/deployment/aws-marketplace#limita-el-acceso-de-red","Limita el acceso de red",{"_3602":72282,"_30987":72275,"_5":31322,"_21467":119564,"_28174":119565,"_3058":119566},[],"/docs/es/deployment/aws-marketplace#lanza-y-verifica","Lanza y verifica",{"_3602":72283,"_30987":72275,"_5":31322,"_21467":119568,"_28174":119569,"_3058":119570},[],"/docs/es/deployment/aws-marketplace#siguiente-paso","Siguiente paso",{"_3602":72284,"_30987":72275,"_21467":119572,"_5":14750,"_28174":72275,"_3058":119573},[],"La oferta de AWS Marketplace reduce la preparación inicial a una instancia EC2 dentro de tu cuenta. Tú mantienes el control de la red, el almacenamiento y la operación de la máquina.",{"_3602":72285,"_30987":72275,"_21467":119575,"_5":14750,"_28174":119545,"_3058":119576},[],"Permisos para suscribirte a productos de AWS Marketplace y lanzar instancias EC2.",{"_3602":72286,"_30987":72275,"_21467":119578,"_5":14750,"_28174":119545,"_3058":119579},[],"Una VPC y una subred desde la que puedan acceder administradores y dispositivos.",{"_3602":72287,"_30987":72275,"_21467":119581,"_5":14750,"_28174":119545,"_3058":119582},[],"Un grupo de seguridad que permita los endpoints necesarios.",{"_3602":72288,"_30987":72275,"_21467":119584,"_5":14750,"_28174":119549,"_3058":119585},[],"**Cómputo:** una instancia `t3.large` como mínimo. Utiliza `t3.xlarge` o superior cuando la carga lo requiera.",{"_3602":72289,"_30987":72275,"_21467":119587,"_5":14750,"_28174":119549,"_3058":119588},[],"**Almacenamiento:** un volumen EBS `gp3` de al menos 50 GB, ajustado al tamaño del inventario y la retención.",{"_3602":72290,"_30987":72275,"_21467":119590,"_5":14750,"_28174":119549,"_3058":119591},[],"**Red:** acceso HTTPS desde los consumidores necesarios, restringido a redes de confianza.",{"_3602":72291,"_30987":72275,"_21467":119593,"_5":14750,"_28174":119553,"_3058":119594},[],"Accede a Lamassu IoT en AWS Marketplace y revisa las condiciones antes de suscribirte.",{"_3602":72292,"_30987":72275,"_21467":119596,"_5":14750,"_28174":119557,"_3058":119597},[],"Selecciona `t3.large` o superior, asigna al menos 50 GB de almacenamiento `gp3` y elige la VPC y subred de destino.",{"_3602":72293,"_30987":72275,"_21467":119599,"_5":14750,"_28174":119561,"_3058":119600},[],"Configura el grupo de seguridad para los puertos `443`, `8443` y `9443`. Restringe los orígenes a las redes administrativas y de dispositivos que realmente necesiten conectarse.",{"_3602":72294,"_30987":72275,"_21467":119602,"_5":14750,"_28174":119565,"_3058":119603},[],"Inicia la instancia y abre la consola en `https://<ip-publica>`. Comprueba que puedes autenticarte antes de continuar.",{"_3602":72295,"_30987":72275,"_21467":119605,"_5":14750,"_28174":119569,"_3058":119606},[],"Continúa con Crea tu primera CA para validar la configuración criptográfica de la instancia.",{"_3602":72296,"_30987":72296,"_5":15110,"_3058":119608,"_31325":119609,"_21467":119610,"_28174":72296},"Despliega Lamassu",[50623,119537],[],{"_3602":72297,"_30987":72296,"_21467":119612,"_5":14750,"_28174":72296,"_3058":119613},[],"Elige el modelo operativo que encaja con tu infraestructura y requisitos de control.",{"_3602":72298,"_30987":72296,"_5":31322,"_21467":119615,"_28174":119616,"_3058":119617},[],"/docs/es/deployment/overview#elige-un-modelo","Elige un modelo",{"_3602":72299,"_30987":72296,"_5":31322,"_21467":119619,"_28174":119620,"_3058":119621},[],"/docs/es/deployment/overview#solo-quieres-evaluar-la-plataforma","¿Solo quieres evaluar la plataforma?",{"_3602":72300,"_30987":72296,"_5":31322,"_21467":119623,"_28174":119624,"_3058":119625},[],"/docs/es/deployment/overview#después-del-despliegue","Después del despliegue",{"_3602":72301,"_30987":72296,"_21467":119627,"_5":14750,"_28174":72296,"_3058":119628},[],"Puedes ejecutar Lamassu en tu propio clúster Kubernetes, desplegar una imagen preparada desde AWS Marketplace o consumir la plataforma como servicio gestionado.",{"_3602":72302,"_30987":72296,"_21467":119630,"_5":14750,"_28174":119616,"_3058":119631},[],"Modelo",{"_3602":72303,"_30987":72296,"_21467":119633,"_5":14750,"_28174":119616,"_3058":119634},[],"Recomendado para",{"_3602":72304,"_30987":72296,"_21467":119636,"_5":14750,"_28174":119616,"_3058":119637},[],"Quién opera la infraestructura",{"_3602":72305,"_30987":72296,"_21467":119639,"_5":14750,"_28174":119616,"_3058":119640},[],"Punto de partida",{"_3602":72306,"_30987":72296,"_21467":119642,"_5":14750,"_28174":119616,"_3058":50730},[],{"_3602":72307,"_30987":72296,"_21467":119644,"_5":14750,"_28174":119616,"_3058":119645},[],"Producción, entornos regulados y despliegues personalizados",{"_3602":72308,"_30987":72296,"_21467":119647,"_5":14750,"_28174":119616,"_3058":119648},[],"Tu equipo",{"_3602":72309,"_30987":72296,"_21467":119650,"_5":14750,"_28174":119616,"_3058":119651},[],"Helm o Fastlane",{"_3602":72310,"_30987":72296,"_21467":119653,"_5":14750,"_28174":119616,"_3058":50742},[],{"_3602":72311,"_30987":72296,"_21467":119655,"_5":14750,"_28174":119616,"_3058":119656},[],"Evaluación o despliegue dedicado dentro de una cuenta AWS",{"_3602":72312,"_30987":72296,"_21467":119658,"_5":14750,"_28174":119616,"_3058":119648},[],{"_3602":72313,"_30987":72296,"_21467":119660,"_5":14750,"_28174":119616,"_3058":119661},[],"Imagen preconfigurada en EC2",{"_3602":72314,"_30987":72296,"_21467":119663,"_5":14750,"_28174":119616,"_3058":50753},[],{"_3602":72315,"_30987":72296,"_21467":119665,"_5":14750,"_28174":119616,"_3058":119666},[],"Equipos que quieren utilizar la plataforma sin operarla",{"_3602":72316,"_30987":72296,"_21467":119668,"_5":14750,"_28174":119616,"_3058":50759},[],{"_3602":72317,"_30987":72296,"_21467":119670,"_5":14750,"_28174":119616,"_3058":119671},[],"Suscripción gestionada",{"_3602":72318,"_30987":72296,"_21467":119673,"_5":14750,"_28174":119616,"_3058":119674},[],"<Card title=\"Kubernetes self-managed\" description=\"Controla red, almacenamiento, claves, dependencias y ciclo de actualización.\" href=\"/docs/deployment/self-hosted/overview\" />",{"_3602":72319,"_30987":72296,"_21467":119676,"_5":14750,"_28174":119616,"_3058":119677},[],"<Card title=\"AWS Marketplace\" description=\"Lanza una instancia preconfigurada de Lamassu en AWS EC2.\" href=\"/docs/deployment/aws-marketplace\" />",{"_3602":72320,"_30987":72296,"_21467":119679,"_5":14750,"_28174":119616,"_3058":119680},[],"<Card title=\"Lamassu SaaS\" description=\"Utiliza una instancia operada y actualizada como servicio gestionado.\" href=\"/docs/deployment/saas\" />",{"_3602":72321,"_30987":72296,"_21467":119682,"_5":14750,"_28174":119620,"_3058":119683},[],"Usa Fastlane para levantar PostgreSQL, Keycloak, RabbitMQ y Lamassu en un clúster Kubernetes mediante un único flujo. Está pensado para laboratorios, demos y bootstrap; para producción, configura las dependencias y los valores Helm de forma explícita.",{"_3602":72322,"_30987":72296,"_21467":119685,"_5":14750,"_28174":119624,"_3058":119686},[],"Cuando la consola esté disponible, continúa con Crea tu primera CA. Ese quickstart verifica que el motor criptográfico y la emisión funcionan correctamente.",{"_3602":72323,"_30987":72323,"_5":15110,"_3058":119688,"_31325":119689,"_21467":119690,"_28174":72323},"Utiliza Lamassu como SaaS",[50623,119537,119538],[],{"_3602":72324,"_30987":72323,"_21467":119692,"_5":14750,"_28174":72323,"_3058":119693},[],"Consume Lamassu como servicio gestionado sin operar infraestructura propia.",{"_3602":72325,"_30987":72323,"_5":31322,"_21467":119695,"_28174":119696,"_3058":119697},[],"/docs/es/deployment/saas#qué-gestiona-el-servicio","Qué gestiona el servicio",{"_3602":72326,"_30987":72323,"_5":31322,"_21467":119699,"_28174":119700,"_3058":119701},[],"/docs/es/deployment/saas#planes","Planes",{"_3602":72327,"_30987":72323,"_5":31322,"_21467":119703,"_28174":119704,"_3058":119705},[],"/docs/es/deployment/saas#solicita-acceso","Solicita acceso",{"_3602":72328,"_30987":72323,"_21467":119707,"_5":14750,"_28174":72323,"_3058":119708},[],"Lamassu SaaS ofrece las capacidades de la plataforma en un entorno administrado. Es la opción indicada cuando tu equipo quiere centrarse en la PKI y las identidades de los dispositivos, no en mantener la infraestructura que las soporta.",{"_3602":72329,"_30987":72323,"_21467":119710,"_5":14750,"_28174":119696,"_3058":119711},[],"Disponibilidad y mantenimiento de la plataforma.",{"_3602":72330,"_30987":72323,"_21467":119713,"_5":14750,"_28174":119696,"_3058":119714},[],"Copias de seguridad automáticas.",{"_3602":72331,"_30987":72323,"_21467":119716,"_5":14750,"_28174":119696,"_3058":119717},[],"Actualizaciones de versión.",{"_3602":72332,"_30987":72323,"_21467":119719,"_5":14750,"_28174":119696,"_3058":119720},[],"Soporte técnico y SLA según el plan contratado.",{"_3602":72333,"_30987":72323,"_21467":119722,"_5":14750,"_28174":119700,"_3058":50814},[],{"_3602":72334,"_30987":72323,"_21467":119724,"_5":14750,"_28174":119700,"_3058":119725},[],"Dispositivos",{"_3602":72335,"_30987":72323,"_21467":119727,"_5":14750,"_28174":119700,"_3058":119728},[],"Soporte",{"_3602":72336,"_30987":72323,"_21467":119730,"_5":14750,"_28174":119700,"_3058":50823},[],{"_3602":72337,"_30987":72323,"_21467":119732,"_5":14750,"_28174":119700,"_3058":50826},[],{"_3602":72338,"_30987":72323,"_21467":119734,"_5":14750,"_28174":119700,"_3058":119735},[],"Hasta 1.000",{"_3602":72339,"_30987":72323,"_21467":119737,"_5":14750,"_28174":119700,"_3058":50832},[],{"_3602":72340,"_30987":72323,"_21467":119739,"_5":14750,"_28174":119700,"_3058":119740},[],"99,5 %",{"_3602":72341,"_30987":72323,"_21467":119742,"_5":14750,"_28174":119700,"_3058":50838},[],{"_3602":72342,"_30987":72323,"_21467":119744,"_5":14750,"_28174":119700,"_3058":119745},[],"Hasta 10.000",{"_3602":72343,"_30987":72323,"_21467":119747,"_5":14750,"_28174":119700,"_3058":119748},[],"Email y chat",{"_3602":72344,"_30987":72323,"_21467":119750,"_5":14750,"_28174":119700,"_3058":119751},[],"99,9 %",{"_3602":72345,"_30987":72323,"_21467":119753,"_5":14750,"_28174":119700,"_3058":50850},[],{"_3602":72346,"_30987":72323,"_21467":119755,"_5":14750,"_28174":119700,"_3058":119756},[],"Ilimitados",{"_3602":72347,"_30987":72323,"_21467":119758,"_5":14750,"_28174":119700,"_3058":119759},[],"Dedicado",{"_3602":72348,"_30987":72323,"_21467":119761,"_5":14750,"_28174":119700,"_3058":119762},[],"99,99 %",{"_3602":72349,"_30987":72323,"_21467":119764,"_5":14750,"_28174":119704,"_3058":119765},[],"Contacta con el equipo de Lamassu a través de lamassu.io para solicitar una demo o elegir un plan.",{"_3602":72350,"_30987":72323,"_21467":119767,"_5":14750,"_28174":119704,"_3058":119768},[],"Cuando recibas las credenciales de tu instancia, continúa con Primeros pasos.",{"_3602":72351,"_30987":72351,"_5":15110,"_3058":50867,"_31325":119770,"_21467":119772,"_28174":72351},[50623,119537,119771],"Kubernetes autogestionado",[],{"_3602":72352,"_30987":72351,"_21467":119774,"_5":14750,"_28174":72351,"_3058":119775},[],"Arranca un entorno completo de evaluación o laboratorio de Lamassu en un clúster Kubernetes existente.",{"_3602":72353,"_30987":72351,"_5":31322,"_21467":119777,"_28174":119778,"_3058":119779},[],"/docs/es/deployment/self-hosted/fastlane#despliega-con-fastlane","Despliega con Fastlane",{"_3602":72354,"_30987":72351,"_5":31322,"_21467":119781,"_28174":119782,"_3058":119783},[],"/docs/es/deployment/self-hosted/fastlane#qué-añade-fastlane","Qué añade Fastlane",{"_3602":72355,"_30987":72351,"_5":31322,"_21467":119785,"_28174":119786,"_3058":119787},[],"/docs/es/deployment/self-hosted/fastlane#antes-de-comenzar","Antes de comenzar",{"_3602":72356,"_30987":72351,"_5":31322,"_21467":119789,"_28174":119790,"_3058":119791},[],"/docs/es/deployment/self-hosted/fastlane#inicio-rápido","Inicio rápido",{"_3602":72357,"_30987":72351,"_5":31322,"_21467":119793,"_28174":119794,"_3058":119795},[],"/docs/es/deployment/self-hosted/fastlane#selección-de-la-dirección-del-gateway","Selección de la dirección del Gateway",{"_3602":72358,"_30987":72351,"_5":31322,"_21467":119797,"_28174":119798,"_3058":119799},[],"/docs/es/deployment/self-hosted/fastlane#opciones-de-línea-de-comandos","Opciones de línea de comandos",{"_3602":72359,"_30987":72351,"_5":31322,"_21467":119801,"_28174":119802,"_3058":119803},[],"/docs/es/deployment/self-hosted/fastlane#modo-de-desarrollo","Modo de desarrollo",{"_3602":72360,"_30987":72351,"_5":31322,"_21467":119805,"_28174":119806,"_3058":119807},[],"/docs/es/deployment/self-hosted/fastlane#qué-configura-el-script","Qué configura el script",{"_3602":72361,"_30987":72351,"_5":31322,"_21467":119809,"_28174":119810,"_3058":119811},[],"/docs/es/deployment/self-hosted/fastlane#comportamiento-tls","Comportamiento TLS",{"_3602":72362,"_30987":72351,"_5":31322,"_21467":119813,"_28174":119814,"_3058":119815},[],"/docs/es/deployment/self-hosted/fastlane#credenciales-y-archivos-generados","Credenciales y archivos generados",{"_3602":72363,"_30987":72351,"_5":31322,"_21467":119817,"_28174":119818,"_3058":119819},[],"/docs/es/deployment/self-hosted/fastlane#verifica-la-instalación","Verifica la instalación",{"_3602":72364,"_30987":72351,"_21467":119821,"_5":14750,"_28174":119778,"_3058":119822},[],"Fastlane es el camino automatizado para evaluaciones, demos, CI y pequeños clústeres de laboratorio. Instala PostgreSQL, Keycloak, RabbitMQ, Envoy Gateway y Lamassu, y los configura para trabajar juntos.",{"_3602":72365,"_30987":72351,"_21467":119824,"_5":14750,"_28174":119778,"_3058":119825},[],"Para producción, usa Helm para mantener explícitas las decisiones de base de datos, identidad, credenciales, certificados, almacenamiento y upgrades.",{"_3602":72366,"_30987":72351,"_21467":119827,"_5":14750,"_28174":119782,"_3058":119828},[],"Fastlane cubre algunas de las dependencias que el chart de aplicación deja deliberadamente fuera:",{"_3602":72367,"_30987":72351,"_21467":119830,"_5":14750,"_28174":119782,"_3058":119831},[],"Fastlane instala o configura",{"_3602":72368,"_30987":72351,"_21467":119833,"_5":14750,"_28174":119782,"_3058":119834},[],"Tú sigues proporcionando",{"_3602":72369,"_30987":72351,"_21467":119836,"_5":14750,"_28174":119782,"_3058":119837},[],"Instancias de PostgreSQL, RabbitMQ y Keycloak para evaluación",{"_3602":72370,"_30987":72351,"_21467":119839,"_5":14750,"_28174":119782,"_3058":119840},[],"El clúster Kubernetes, sus nodos y el almacenamiento persistente",{"_3602":72371,"_30987":72351,"_21467":119842,"_5":14750,"_28174":119782,"_3058":119843},[],"Envoy Gateway 1.8 y la `GatewayClass` `eg`",{"_3602":72372,"_30987":72351,"_21467":119845,"_5":14750,"_28174":119782,"_3058":119846},[],"cert-manager, accesibilidad desde la red externa, DNS y reglas de firewall/NAT",{"_3602":72373,"_30987":72351,"_21467":119848,"_5":14750,"_28174":119782,"_3058":119849},[],"Un flujo de certificado self-signed para Lamassu, credenciales de las dependencias almacenadas en Secrets de Kubernetes (mediante el External Secrets Operator) y un usuario inicial",{"_3602":72374,"_30987":72351,"_21467":119851,"_5":14750,"_28174":119782,"_3058":119852},[],"Confianza de los clientes en la CA self-signed, o un certificado de confianza pasado al script",{"_3602":72375,"_30987":72351,"_21467":119854,"_5":14750,"_28174":119782,"_3058":119855},[],"Componentes opcionales de observabilidad y HSM de laboratorio",{"_3602":72376,"_30987":72351,"_21467":119857,"_5":14750,"_28174":119782,"_3058":119858},[],"Retención de monitorización, backups, HA y un HSM/servicio de claves de producción",{"_3602":72377,"_30987":72351,"_21467":119860,"_5":14750,"_28174":119782,"_3058":119861},[],"Fastlane no convierte el stack en un servicio de producción: no crea el clúster, DNS público, reglas de firewall, backups, alta disponibilidad ni un certificado público de confianza.",{"_3602":72378,"_30987":72351,"_21467":119863,"_5":14750,"_28174":119786,"_3058":119864},[],"Necesitas:",{"_3602":72379,"_30987":72351,"_21467":119866,"_5":14750,"_28174":119786,"_3058":119867},[],"un clúster Kubernetes existente",{"_3602":72380,"_30987":72351,"_21467":119869,"_5":14750,"_28174":119786,"_3058":119870},[],"`kubectl` y Helm, o la CLI de MicroK8s",{"_3602":72381,"_30987":72351,"_21467":119872,"_5":14750,"_28174":119786,"_3058":50969},[],{"_3602":72382,"_30987":72351,"_21467":119874,"_5":14750,"_28174":119786,"_3058":24268},[],{"_3602":72383,"_30987":72351,"_21467":119876,"_5":14750,"_28174":119786,"_3058":119877},[],"`jq` solo si usas `--sample-data` o `--development`",{"_3602":72384,"_30987":72351,"_21467":119879,"_5":14750,"_28174":119786,"_3058":119880},[],"`ssh-keygen` solo si usas `--with-hsm`",{"_3602":72385,"_30987":72351,"_21467":119882,"_5":14750,"_28174":119786,"_3058":119883},[],"los puertos externos 80 y 443 libres en un host K3s de un único nodo",{"_3602":72386,"_30987":72351,"_21467":119885,"_5":14750,"_28174":119786,"_3058":119886},[],"Fastlane detecta MicroK8s, K3s, kind o un kubeconfig estándar. Usa `--context` cuando el clúster deseado no sea el contexto actual.",{"_3602":72387,"_30987":72351,"_21467":119888,"_5":14750,"_28174":119786,"_3058":119889},[],"Fastlane instala varios componentes y crea credenciales. Comprueba `kubectl config current-context` o pasa `--context` antes de ejecutarlo.",{"_3602":72388,"_30987":72351,"_21467":119891,"_5":14750,"_28174":119790,"_3058":119892},[],"Ejecuta el script desde un clon del repositorio Helm:",{"_3602":72389,"_30987":72351,"_21467":119894,"_5":14750,"_28174":119790,"_3058":119895},[],"Crea un registro DNS para el dominio elegido antes de probar desde otra máquina. En una VM pequeña, apúntalo a la dirección de la VM o del balanceador que realmente recibe los puertos 80 y 443.",{"_3602":72390,"_30987":72351,"_21467":119897,"_5":14750,"_28174":119794,"_3058":119898},[],"Por defecto, Fastlane ejecuta `hostname -I` y escribe las direcciones devueltas en `gateway.addresses` y en los SAN IP del certificado self-signed.",{"_3602":72391,"_30987":72351,"_21467":119900,"_5":14750,"_28174":119794,"_3058":119901},[],"En una VM de laboratorio con una única interfaz puede seleccionar la dirección esperada. En hosts con Docker, VPN, WireGuard o varias interfaces también puede elegir direcciones inaccesibles para los clientes. Sobrescribe el resultado:",{"_3602":72392,"_30987":72351,"_21467":119903,"_5":14750,"_28174":119794,"_3058":119904},[],"El valor debe ser una dirección gestionada en el lado Kubernetes de la ruta. Si una IP pública de EC2 reenvía tráfico por WireGuard, pasa la dirección accesible de la VM o clúster, no la IP pública de EC2.",{"_3602":72393,"_30987":72351,"_21467":119906,"_5":14750,"_28174":119794,"_3058":119907},[],"Consulta Expón el Gateway para los conflictos de puertos de K3s, VIP, NAT externo y diseños con varios Gateways.",{"_3602":72394,"_30987":72351,"_21467":119909,"_5":14750,"_28174":119798,"_3058":119910},[],"Opción",{"_3602":72395,"_30987":72351,"_21467":119912,"_5":14750,"_28174":119798,"_3058":119913},[],"Valor predeterminado",{"_3602":72396,"_30987":72351,"_21467":119915,"_5":14750,"_28174":119798,"_3058":119916},[],"Propósito",{"_3602":72397,"_30987":72351,"_21467":119918,"_5":14750,"_28174":119798,"_3058":51016},[],{"_3602":72398,"_30987":72351,"_21467":119920,"_5":14750,"_28174":119798,"_3058":51019},[],{"_3602":72399,"_30987":72351,"_21467":119922,"_5":14750,"_28174":119798,"_3058":119923},[],"Muestra la ayuda",{"_3602":72400,"_30987":72351,"_21467":119925,"_5":14750,"_28174":119798,"_3058":51025},[],{"_3602":72401,"_30987":72351,"_21467":119927,"_5":14750,"_28174":119798,"_3058":119928},[],"contexto actual",{"_3602":72402,"_30987":72351,"_21467":119930,"_5":14750,"_28174":119798,"_3058":119931},[],"Selecciona el contexto de kubeconfig para kubectl y Helm",{"_3602":72403,"_30987":72351,"_21467":119933,"_5":14750,"_28174":119798,"_3058":51034},[],{"_3602":72404,"_30987":72351,"_21467":119935,"_5":14750,"_28174":119798,"_3058":6759},[],{"_3602":72405,"_30987":72351,"_21467":119937,"_5":14750,"_28174":119798,"_3058":119938},[],"Omite prompts y genera credenciales para las dependencias",{"_3602":72406,"_30987":72351,"_21467":119940,"_5":14750,"_28174":119798,"_3058":51042},[],{"_3602":72407,"_30987":72351,"_21467":119942,"_5":14750,"_28174":119798,"_3058":51045},[],{"_3602":72408,"_30987":72351,"_21467":119944,"_5":14750,"_28174":119798,"_3058":119945},[],"Namespace de la instalación",{"_3602":72409,"_30987":72351,"_21467":119947,"_5":14750,"_28174":119798,"_3058":51051},[],{"_3602":72410,"_30987":72351,"_21467":119949,"_5":14750,"_28174":119798,"_3058":51054},[],{"_3602":72411,"_30987":72351,"_21467":119951,"_5":14750,"_28174":119798,"_3058":119952},[],"Dominio usado por la UI, OIDC y el certificado",{"_3602":72412,"_30987":72351,"_21467":119954,"_5":14750,"_28174":119798,"_3058":51060},[],{"_3602":72413,"_30987":72351,"_21467":119956,"_5":14750,"_28174":119798,"_3058":15461},[],{"_3602":72414,"_30987":72351,"_21467":119958,"_5":14750,"_28174":119798,"_3058":119959},[],"Versión del chart de Lamassu",{"_3602":72415,"_30987":72351,"_21467":119961,"_5":14750,"_28174":119798,"_3058":51068},[],{"_3602":72416,"_30987":72351,"_21467":119963,"_5":14750,"_28174":119798,"_3058":51071},[],{"_3602":72417,"_30987":72351,"_21467":119965,"_5":14750,"_28174":119798,"_3058":119966},[],"Puerto del listener HTTPS",{"_3602":72418,"_30987":72351,"_21467":119968,"_5":14750,"_28174":119798,"_3058":51077},[],{"_3602":72419,"_30987":72351,"_21467":119970,"_5":14750,"_28174":119798,"_3058":51080},[],{"_3602":72420,"_30987":72351,"_21467":119972,"_5":14750,"_28174":119798,"_3058":119973},[],"Puerto del listener HTTP",{"_3602":72421,"_30987":72351,"_21467":119975,"_5":14750,"_28174":119798,"_3058":51086},[],{"_3602":72422,"_30987":72351,"_21467":119977,"_5":14750,"_28174":119798,"_3058":51019},[],{"_3602":72423,"_30987":72351,"_21467":119979,"_5":14750,"_28174":119798,"_3058":119980},[],"Certificado PEM para TLS downstream",{"_3602":72424,"_30987":72351,"_21467":119982,"_5":14750,"_28174":119798,"_3058":51094},[],{"_3602":72425,"_30987":72351,"_21467":119984,"_5":14750,"_28174":119798,"_3058":51019},[],{"_3602":72426,"_30987":72351,"_21467":119986,"_5":14750,"_28174":119798,"_3058":119987},[],"Clave privada PEM para TLS downstream",{"_3602":72427,"_30987":72351,"_21467":119989,"_5":14750,"_28174":119798,"_3058":51102},[],{"_3602":72428,"_30987":72351,"_21467":119991,"_5":14750,"_28174":119798,"_3058":119992},[],"chart del repositorio",{"_3602":72429,"_30987":72351,"_21467":119994,"_5":14750,"_28174":119798,"_3058":119995},[],"Usa un chart local de Lamassu sin empaquetar",{"_3602":72430,"_30987":72351,"_21467":119997,"_5":14750,"_28174":119798,"_3058":51111},[],{"_3602":72431,"_30987":72351,"_21467":119999,"_5":14750,"_28174":119798,"_3058":120000},[],"detección automática",{"_3602":72432,"_30987":72351,"_21467":120002,"_5":14750,"_28174":119798,"_3058":120003},[],"Sobrescribe la dirección escrita en `gateway.addresses`",{"_3602":72433,"_30987":72351,"_21467":120005,"_5":14750,"_28174":119798,"_3058":51119},[],{"_3602":72434,"_30987":72351,"_21467":120007,"_5":14750,"_28174":119798,"_3058":6759},[],{"_3602":72435,"_30987":72351,"_21467":120009,"_5":14750,"_28174":119798,"_3058":120010},[],"Instala Victoria Logs, VictoriaTraces, Jaeger y un OpenTelemetry Collector",{"_3602":72436,"_30987":72351,"_21467":120012,"_5":14750,"_28174":119798,"_3058":51127},[],{"_3602":72437,"_30987":72351,"_21467":120014,"_5":14750,"_28174":119798,"_3058":6759},[],{"_3602":72438,"_30987":72351,"_21467":120016,"_5":14750,"_28174":119798,"_3058":120017},[],"Modo desarrollo: provisiona completamente el usuario `lamassu` de Keycloak (contraseña fija `lamassu`/`lamassu`, sin pasos en el primer inicio) y permite al cliente `frontend` aceptar cualquier redirect URI u origen web. No es para producción",{"_3602":72439,"_30987":72351,"_21467":120019,"_5":14750,"_28174":119798,"_3058":51135},[],{"_3602":72440,"_30987":72351,"_21467":120021,"_5":14750,"_28174":119798,"_3058":6759},[],{"_3602":72441,"_30987":72351,"_21467":120023,"_5":14750,"_28174":119798,"_3058":120024},[],"Crea CA, perfiles, certificados, DMS y dispositivos de ejemplo",{"_3602":72442,"_30987":72351,"_21467":120026,"_5":14750,"_28174":119798,"_3058":51143},[],{"_3602":72443,"_30987":72351,"_21467":120028,"_5":14750,"_28174":119798,"_3058":6759},[],{"_3602":72444,"_30987":72351,"_21467":120030,"_5":14750,"_28174":119798,"_3058":120031},[],"Instala componentes HSM de laboratorio y configura KMS con PKCS#11",{"_3602":72445,"_30987":72351,"_21467":120033,"_5":14750,"_28174":119798,"_3058":51151},[],{"_3602":72446,"_30987":72351,"_21467":120035,"_5":14750,"_28174":119798,"_3058":51154},[],{"_3602":72447,"_30987":72351,"_21467":120037,"_5":14750,"_28174":119798,"_3058":120038},[],"Usa otro chart local de SoftHSM",{"_3602":72448,"_30987":72351,"_21467":120040,"_5":14750,"_28174":119798,"_3058":120041},[],"Fastlane no ofrece un modo offline. Para entornos sin conexión, usa el flujo manual con Helm y prepara un registro y mirror de charts.",{"_3602":72449,"_30987":72351,"_21467":120043,"_5":14750,"_28174":119802,"_3058":120044},[],"`--development` ajusta el realm `lamassu` de Keycloak que genera Fastlane para un entorno de evaluación desechable:",{"_3602":72450,"_30987":72351,"_21467":120046,"_5":14750,"_28174":119802,"_3058":120047},[],"el usuario `lamassu` queda completamente provisionado (nombre Lamassu, apellido Admin, email `lamassu@lamassu.io`, verificado): no hay pasos de perfil ni de cambio de contraseña en el primer inicio de sesión",{"_3602":72451,"_30987":72351,"_21467":120049,"_5":14750,"_28174":119802,"_3058":120050},[],"la contraseña conocida `lamassu`/`lamassu` es fija y permanente: no se rota nunca y concede el rol `pki-admin`, incluidos tokens no interactivos a través del cliente `frontend`",{"_3602":72452,"_30987":72351,"_21467":120052,"_5":14750,"_28174":119802,"_3058":120053},[],"el cliente `frontend` acepta cualquier redirect URI y cualquier origen web (`*`) en lugar de los patrones `/*` originales",{"_3602":72453,"_30987":72351,"_21467":120055,"_5":14750,"_28174":119802,"_3058":120056},[],"Con `--development`, la contraseña fija `lamassu`/`lamassu` concede acceso `pki-admin` a cualquiera que alcance la instalación. No lo uses nunca en nada expuesto más allá de una máquina de desarrollo o de un host accesible por red.",{"_3602":72454,"_30987":72351,"_21467":120058,"_5":14750,"_28174":119802,"_3058":120059},[],"`--development` se aplica cuando el realm `lamassu` se importa por primera vez. No modifica un clúster existente. Puede combinarse con `--sample-data`: la transformación de desarrollo se ejecuta primero y después se añaden los datos de ejemplo a la misma configuración del realm.",{"_3602":72455,"_30987":72351,"_21467":120061,"_5":14750,"_28174":119806,"_3058":51181},[],{"_3602":72456,"_30987":72351,"_21467":120063,"_5":14750,"_28174":119806,"_3058":120064},[],"valida las herramientas locales y el clúster seleccionado",{"_3602":72457,"_30987":72351,"_21467":120066,"_5":14750,"_28174":119806,"_3058":120067},[],"instala o actualiza Envoy Gateway 1.8 y crea la `GatewayClass` `eg`",{"_3602":72458,"_30987":72351,"_21467":120069,"_5":14750,"_28174":119806,"_3058":120070},[],"crea el namespace",{"_3602":72459,"_30987":72351,"_21467":120072,"_5":14750,"_28174":119806,"_3058":120073},[],"instala el External Secrets Operator y crea las credenciales de PostgreSQL, RabbitMQ y del administrador de Keycloak como Secrets a través de un `ClusterSecretStore` Fake",{"_3602":72460,"_30987":72351,"_21467":120075,"_5":14750,"_28174":119806,"_3058":120076},[],"instala PostgreSQL y crea las bases de datos necesarias",{"_3602":72461,"_30987":72351,"_21467":120078,"_5":14750,"_28174":119806,"_3058":120079},[],"instala Keycloak y crea el realm `lamassu`, el cliente frontend, el rol administrador y el usuario inicial",{"_3602":72462,"_30987":72351,"_21467":120081,"_5":14750,"_28174":119806,"_3058":120082},[],"instala RabbitMQ",{"_3602":72463,"_30987":72351,"_21467":120084,"_5":14750,"_28174":119806,"_3058":120085},[],"instala opcionalmente observabilidad y componentes HSM de laboratorio",{"_3602":72464,"_30987":72351,"_21467":120087,"_5":14750,"_28174":119806,"_3058":120088},[],"genera `lamassu.yaml`, que referencia los Secrets en lugar de credenciales inline, e instala el chart de Lamassu",{"_3602":72465,"_30987":72351,"_21467":120090,"_5":14750,"_28174":119806,"_3058":120091},[],"carga datos de ejemplo opcionalmente",{"_3602":72466,"_30987":72351,"_21467":120093,"_5":14750,"_28174":119806,"_3058":120094},[],"La configuración generada expone Keycloak en `/auth` a través del mismo Gateway y provisiona al usuario inicial `lamassu` como superadministrador de Lamassu.",{"_3602":72467,"_30987":72351,"_21467":120096,"_5":14750,"_28174":119810,"_3058":120097},[],"Al proporcionar `--tls-crt` y `--tls-key`, Fastlane crea el Secret `downstream-provided-crt` y configura `tls.type: external`.",{"_3602":72468,"_30987":72351,"_21467":120099,"_5":14750,"_28174":119810,"_3058":120100},[],"Sin ellos, configura cert-manager con un emisor self-signed. Es adecuado para laboratorio, pero los clientes no confiarán en él hasta que distribuyas la CA. Usa Helm si necesitas un Issuer corporativo, un emisor ACME público o un Secret existente gestionado por otro sistema.",{"_3602":72469,"_30987":72351,"_21467":120102,"_5":14750,"_28174":119814,"_3058":120103},[],"El modo no interactivo genera contraseñas aleatorias para los administradores de PostgreSQL, RabbitMQ y Keycloak y las almacena en Secrets de Kubernetes a través del `ClusterSecretStore` Fake del External Secrets Operator. Fastlane escribe `lamassu.yaml` en el directorio actual referenciando esos Secrets — el archivo de valores ya no contiene las credenciales.",{"_3602":72470,"_30987":72351,"_21467":120105,"_5":14750,"_28174":119814,"_3058":120106},[],"La contraseña del administrador de Keycloak ya no se imprime por pantalla. Recupérala del Secret cuando la necesites:",{"_3602":72471,"_30987":72351,"_21467":120108,"_5":14750,"_28174":119814,"_3058":120109},[],"El acceso inicial a Lamassu es `lamassu` / `lamassu` y obliga a cambiar la contraseña en el primer uso, salvo que se haya usado `--development`: en ese caso la contraseña permanece fija y permanente.",{"_3602":72472,"_30987":72351,"_21467":120111,"_5":14750,"_28174":119814,"_3058":120112},[],"El `ClusterSecretStore` Fake almacena las credenciales en texto plano y es solo para laboratorio: sustitúyelo por un proveedor ESO real para cualquier uso que vaya más allá de un entorno desechable. Protege el archivo de valores generado, guarda las credenciales en un almacén de secretos apropiado y no reutilices la configuración de identidad de evaluación en producción.",{"_3602":72473,"_30987":72351,"_21467":120114,"_5":14750,"_28174":119818,"_3058":120115},[],"Abre `https://pki.example.com` e inicia sesión con el usuario inicial. Si el Gateway está programado pero la URL no es accesible, sigue las comprobaciones de Expón el Gateway.",{"_3602":72474,"_30987":72474,"_5":15110,"_3058":120117,"_31325":120118,"_21467":120119,"_28174":72474},"Instala con Helm",[50623,119537,119771],[],{"_3602":72475,"_30987":72474,"_21467":120121,"_5":14750,"_28174":72474,"_3058":120122},[],"Prepara las dependencias, configura el chart de Lamassu y verifica un despliegue controlado en Kubernetes.",{"_3602":72476,"_30987":72474,"_5":31322,"_21467":120124,"_28174":120125,"_3058":120126},[],"/docs/es/deployment/self-hosted/helm#instala-lamassu-con-helm","Instala Lamassu con Helm",{"_3602":72477,"_30987":72474,"_5":31322,"_21467":120128,"_28174":120129,"_3058":119787},[],"/docs/es/deployment/self-hosted/helm#antes-de-comenzar",{"_3602":72478,"_30987":72474,"_5":31322,"_21467":120131,"_28174":120132,"_3058":120133},[],"/docs/es/deployment/self-hosted/helm#1-instala-los-requisitos-del-gateway","1\\. Instala los requisitos del Gateway",{"_3602":72479,"_30987":72474,"_5":31322,"_21467":120135,"_28174":120136,"_3058":120137},[],"/docs/es/deployment/self-hosted/helm#2-crea-un-archivo-de-valores","2\\. Crea un archivo de valores",{"_3602":72480,"_30987":72474,"_5":31322,"_21467":120139,"_28174":120140,"_3058":120141},[],"/docs/es/deployment/self-hosted/helm#credenciales-en-secrets-de-kubernetes","Credenciales en Secrets de Kubernetes",{"_3602":72481,"_30987":72474,"_5":31322,"_21467":120143,"_28174":120144,"_3058":120145},[],"/docs/es/deployment/self-hosted/helm#tls-con-un-secret-existente","TLS con un Secret existente",{"_3602":72482,"_30987":72474,"_5":31322,"_21467":120147,"_28174":120148,"_3058":120149},[],"/docs/es/deployment/self-hosted/helm#tls-de-amqp-amqps","TLS de AMQP (AMQPS)",{"_3602":72483,"_30987":72474,"_5":31322,"_21467":120151,"_28174":120152,"_3058":120153},[],"/docs/es/deployment/self-hosted/helm#provisiona-el-primer-administrador","Provisiona el primer administrador",{"_3602":72484,"_30987":72474,"_5":31322,"_21467":120155,"_28174":120156,"_3058":120157},[],"/docs/es/deployment/self-hosted/helm#3-instala-lamassu","3\\. Instala Lamassu",{"_3602":72485,"_30987":72474,"_5":31322,"_21467":120159,"_28174":120160,"_3058":120161},[],"/docs/es/deployment/self-hosted/helm#4-verifica-el-despliegue","4\\. Verifica el despliegue",{"_3602":72486,"_30987":72474,"_5":31322,"_21467":120163,"_28174":120164,"_3058":120165},[],"/docs/es/deployment/self-hosted/helm#actualiza-lamassu","Actualiza Lamassu",{"_3602":72487,"_30987":72474,"_5":31322,"_21467":120167,"_28174":120168,"_3058":120169},[],"/docs/es/deployment/self-hosted/helm#decisiones-para-producción","Decisiones para producción",{"_3602":72488,"_30987":72474,"_21467":120171,"_5":14750,"_28174":120125,"_3058":120172},[],"Usa Helm cuando necesites control explícito sobre identidad, bases de datos, mensajería, certificados, almacenamiento y upgrades. Para un entorno de evaluación en el que el script pueda tomar esas decisiones, usa Fastlane.",{"_3602":72489,"_30987":72474,"_21467":120174,"_5":14750,"_28174":120129,"_3058":120175},[],"Prepara los servicios de plataforma que quedan deliberadamente fuera del chart de Lamassu:",{"_3602":72490,"_30987":72474,"_21467":120177,"_5":14750,"_28174":120129,"_3058":120178},[],"un clúster Kubernetes 1.24+ y Helm 3.2+",{"_3602":72491,"_30987":72474,"_21467":120180,"_5":14750,"_28174":120129,"_3058":120181},[],"un servidor PostgreSQL accesible y un rol autorizado para crear bases de datos y schemas",{"_3602":72492,"_30987":72474,"_21467":120183,"_5":14750,"_28174":120129,"_3058":120184},[],"un broker RabbitMQ accesible y sus credenciales",{"_3602":72493,"_30987":72474,"_21467":120186,"_5":14750,"_28174":120129,"_3058":120187},[],"Secrets de Kubernetes en el namespace del release con las credenciales de PostgreSQL y RabbitMQ (y las credenciales SMTP cuando el SMTP exija autenticación) — el chart lee las credenciales de Secrets y rechaza los valores inline (consulta Credenciales en Secrets de Kubernetes)",{"_3602":72494,"_30987":72474,"_21467":120189,"_5":14750,"_28174":120129,"_3058":120190},[],"un proveedor OIDC, normalmente Keycloak, con un realm/tenant y un cliente para Lamassu",{"_3602":72495,"_30987":72474,"_21467":120192,"_5":14750,"_28174":120129,"_3058":120193},[],"Envoy Gateway 1.8+ y una `GatewayClass`",{"_3602":72496,"_30987":72474,"_21467":120195,"_5":14750,"_28174":120129,"_3058":120196},[],"cert-manager 1.14+ (solo para el modo predeterminado `tls.type: certManager`); para TLS de confianza, un emisor de confianza o un Secret TLS de Kubernetes",{"_3602":72497,"_30987":72474,"_21467":120198,"_5":14750,"_28174":120129,"_3058":120199},[],"una StorageClass y un diseño de tráfico externo",{"_3602":72498,"_30987":72474,"_21467":120201,"_5":14750,"_28174":120129,"_3058":120202},[],"El chart usa por defecto una `GatewayClass` llamada `eg`. Cambia `gateway.className` si tu equipo de plataforma utiliza otro nombre.",{"_3602":72499,"_30987":72474,"_21467":120204,"_5":14750,"_28174":120129,"_3058":120205},[],"Tú proporcionas el servidor PostgreSQL. El job de pre-install del chart se conecta con las credenciales indicadas, crea las bases de datos `pki`, `authz` y `wfx` y los schemas de los servicios, ejecuta las migraciones y aplica `services.authz.bootstrap`.",{"_3602":72500,"_30987":72474,"_21467":120207,"_5":14750,"_28174":120129,"_3058":120208},[],"El chart no tiene dependencias Helm que instalen PostgreSQL, RabbitMQ, un proveedor OIDC, Envoy Gateway ni cert-manager.",{"_3602":72501,"_30987":72474,"_21467":120210,"_5":14750,"_28174":120132,"_3058":120211},[],"Instala o actualiza las CRD de Envoy Gateway antes de su controlador. Estos comandos usan la misma versión que el repositorio Helm de Lamassu:",{"_3602":72502,"_30987":72474,"_21467":120213,"_5":14750,"_28174":120132,"_3058":120214},[],"Crea la `GatewayClass` predeterminada si todavía no existe. Guarda este manifiesto como `gateway-class.yaml`:",{"_3602":72503,"_30987":72474,"_21467":120216,"_5":14750,"_28174":120132,"_3058":120217},[],"Instala cert-manager por separado antes de Lamassu, pero solo para el modo predeterminado `tls.type: certManager`. En ese modo el chart renderiza sus recursos de Issuer self-signed y Certificate CA tanto si `tls.certManagerOptions.clusterIssuer` está definido como si no, por lo que cert-manager sigue siendo un requisito. Con `tls.type: external`, el chart no renderiza recursos de cert-manager y el Gateway termina el TLS con un Secret existente que tú proporcionas.",{"_3602":72504,"_30987":72474,"_21467":120219,"_5":14750,"_28174":120136,"_3058":120220},[],"Parte de los valores predeterminados del chart y sobrescribe los específicos del entorno. Este ejemplo supone que PostgreSQL, RabbitMQ y Keycloak son accesibles mediante DNS de Kubernetes y expone Keycloak en `/auth` a través del Gateway compartido:",{"_3602":72505,"_30987":72474,"_21467":120222,"_5":14750,"_28174":120136,"_3058":120223},[],"No añadas `gateway.addresses` por defecto. Deja la asignación de dirección a la implementación del balanceador salvo que tu diseño de red requiera una VIP concreta en Kubernetes. La IP pública de un NAT o proxy upstream no corresponde a este valor.",{"_3602":72506,"_30987":72474,"_21467":120225,"_5":14750,"_28174":120136,"_3058":120226},[],"Si Keycloak es externo y ya tiene una URL accesible, apunta la configuración OIDC hacia él y omite la entrada `/auth` de `gateway.extraRouting`.",{"_3602":72507,"_30987":72474,"_21467":120228,"_5":14750,"_28174":120136,"_3058":120229},[],"Si tu archivo de valores aún contiene los ajustes heredados de validación JWT del Gateway — `auth.oidc.apiGateway.jwks`, `auth.authorization.rolesClaim` o `auth.authorization.roles.admin` — elimínalos. La guía de migración `charts/lamassu/CHANGELOG/3.8.0->4.0.0.md` documenta su eliminación sin alias de compatibilidad, y `values.schema.json` rechaza los bloques residuales en lugar de ignorarlos silenciosamente. Los reemplazos son `services.authz.jwkUrl` y `services.authz.bootstrap`, que ya aparecen en el ejemplo anterior.",{"_3602":72508,"_30987":72474,"_21467":120231,"_5":14750,"_28174":120140,"_3058":120232},[],"El chart lee las credenciales de PostgreSQL, AMQP y SMTP de Secrets de Kubernetes en el namespace del release. Referéncialas con `existingSecret` más las claves de datos `usernameKey` y `passwordKey`; los valores inline `username` y `password` se han eliminado y `values.schema.json` los rechaza.",{"_3602":72509,"_30987":72474,"_21467":120234,"_5":14750,"_28174":120140,"_3058":120235},[],"Los Secrets deben existir antes de instalar o actualizar: el job de migración de pre-install y pre-upgrade se conecta a PostgreSQL con el Secret de PostgreSQL, y los contenedores de los servicios leen las credenciales de AMQP y SMTP cuando arrancan.",{"_3602":72510,"_30987":72474,"_21467":120237,"_5":14750,"_28174":120140,"_3058":120238},[],"`postgres.existingSecret` (por defecto `lamassu-postgres`) y `amqp.existingSecret` (por defecto `lamassu-amqp`) son obligatorios siempre.",{"_3602":72511,"_30987":72474,"_21467":120240,"_5":14750,"_28174":120140,"_3058":120241},[],"`services.alerts.smtp_server.existingSecret` está vacío por defecto, lo que significa SMTP sin autenticación. Defínelo, junto con sus nombres de clave, solo cuando tu servidor SMTP exija autenticación.",{"_3602":72512,"_30987":72474,"_21467":120243,"_5":14750,"_28174":120140,"_3058":120244},[],"Cada entrada de `services.authz.credentials` nombra su `database` y usa el Secret global de PostgreSQL — `postgres.existingSecret` con sus nombres de clave configurados — salvo que la entrada defina su propio `existingSecret`.",{"_3602":72513,"_30987":72474,"_21467":120246,"_5":14750,"_28174":120140,"_3058":120247},[],"Cambiar el contenido de un Secret no reinicia los pods que lo consumen: los servicios leen las credenciales cuando arrancan. Reinicia los pods afectados después de rotar una credencial.",{"_3602":72514,"_30987":72474,"_21467":120249,"_5":14750,"_28174":120140,"_3058":120250},[],"Para producción, gestiona los Secrets con el External Secrets Operator (ESO), que el chart no instala. El `charts/lamassu/README.md` del repositorio Helm documenta en su sección *Secret management* un ejemplo completo y funcional: instalar external-secrets 0.20.2, un `ClusterSecretStore` de prueba, los recursos `ExternalSecret` y la espera antes de instalar el chart. Su proveedor Fake es solo para pruebas — sustitúyelo por la configuración de tu proveedor para cualquier uso que vaya más allá de un entorno desechable; AWS Secrets Manager, Vault, Azure Key Vault, GCP Secret Manager y otros proveedores están documentados en external-secrets.io.",{"_3602":72515,"_30987":72474,"_21467":120252,"_5":14750,"_28174":120140,"_3058":120253},[],"Solo estas credenciales pasan a Secrets: el resto de values, como la configuración de conectores o de motores criptográficos, sigue configurándose en el archivo de values.",{"_3602":72516,"_30987":72474,"_21467":120255,"_5":14750,"_28174":120144,"_3058":120256},[],"Crea un Secret con `tls.crt` y `tls.key` y referéncialo. El Secret debe existir antes de instalar: en modo `external` el chart no renderiza recursos de cert-manager ni crea nunca este Secret.",{"_3602":72517,"_30987":72474,"_21467":120258,"_5":14750,"_28174":120148,"_3058":120259},[],"`amqp.tls: true` selecciona AMQPS en todos los bloques de configuración del bus de eventos. El puerto por defecto sigue siendo `5672` y no cambia automáticamente al habilitar TLS, así que define `amqp.port` con el listener TLS del broker, normalmente `5671`.",{"_3602":72518,"_30987":72474,"_21467":120261,"_5":14750,"_28174":120148,"_3058":120262},[],"Sin un Secret de CA configurado, los clientes del bus de eventos usan las CA de confianza del sistema. Para confiar en una CA privada, crea un Secret en el namespace del release con el certificado de la CA en formato PEM y define `amqp.ca.secretName` (y `amqp.ca.certificateKey` si la clave de datos no es `ca.crt`).",{"_3602":72519,"_30987":72474,"_21467":120264,"_5":14750,"_28174":120148,"_3058":120265},[],"Para brokers que exijan TLS mutuo, crea un Secret con el certificado de cliente y su clave privada y define `amqp.client.secretName` (con `amqp.client.certificateKey` y `amqp.client.privateKeyKey` si las claves de datos no son `tls.crt` y `tls.key`).",{"_3602":72520,"_30987":72474,"_21467":120267,"_5":14750,"_28174":120148,"_3058":120268},[],"El chart monta los Secrets configurados en modo de solo lectura en todas las cargas de trabajo que consumen AMQP: el certificado de la CA en `/etc/lamassu/amqp/ca` y el certificado y la clave de cliente en `/etc/lamassu/amqp/client`. Los nombres de los archivos montados son siempre `ca.crt`, `tls.crt` y `tls.key` — los valores `certificateKey` y `privateKeyKey` renombran solo las claves de datos del Secret, nunca las rutas en disco. La clave privada del cliente se monta con permisos restrictivos (`defaultMode: 0440`; el volumen de la CA usa `0444`), que funcionan porque el chart añade `fsGroup` al security context del pod cuando `amqp.client.secretName` está definido — el security context del pod por defecto del chart ya define `fsGroup: 65532` para todos los pods de servicio, por lo que este ajuste solo se aplica cuando se ha sobrescrito un `podSecurityContext` explícito sin `fsGroup` y hay un Secret de cliente AMQP configurado — y usa el `runAsGroup` del contenedor (por defecto `65532`) cuando `fsGroup` no está ya definido.",{"_3602":72521,"_30987":72474,"_21467":120270,"_5":14750,"_28174":120148,"_3058":120271},[],"Ambas opciones de Secret exigen `amqp.tls: true`: `values.schema.json` rechaza un `secretName` no vacío cuando `tls` es false, rechaza claves desconocidas y rechaza nombres de clave de datos fuera de `^[A-Za-z0-9._-]+$`. El Secret referenciado debe existir en el namespace del release o los pods consumidores no llegan a arrancar.",{"_3602":72522,"_30987":72474,"_21467":120273,"_5":14750,"_28174":120148,"_3058":120274},[],"El cliente AMQP carga los certificados al arrancar, así que reinicia los pods consumidores tras actualizar cualquiera de los dos Secrets. Cambiar cualquier valor de `amqp` reinicia las cargas de trabajo consumidoras mediante la anotación `checksum/config`, pero cambiar solo el contenido de un Secret no desencadena un rollout.",{"_3602":72523,"_30987":72474,"_21467":120276,"_5":14750,"_28174":120148,"_3058":120277},[],"Según la guía de migración `charts/lamassu/CHANGELOG/3.8.0->4.0.0.md`: en 3.8.0 `amqp.tls` no se aplicaba y los clientes del bus de eventos usaban AMQP en claro; desde 4.0.0, `amqp.tls: true` los cambia a AMQPS. Define `amqp.port` con el listener TLS del broker antes del upgrade, o usa `amqp.tls: false` para mantener AMQP en claro. `amqp.tls: false` envía las credenciales del broker y todo el tráfico del bus de eventos en claro.",{"_3602":72524,"_30987":72474,"_21467":120279,"_5":14750,"_28174":120152,"_3058":120280},[],"No existe un superusuario implícito. Crea en el proveedor OIDC el rol o grupo esperado por `services.authz.bootstrap` y asígnalo al menos a un administrador antes de exponer Lamassu.",{"_3602":72525,"_30987":72474,"_21467":120282,"_5":14750,"_28174":120152,"_3058":120283},[],"El job de pre-install y pre-upgrade aplica el bootstrap de forma idempotente: conserva los principales existentes y añade los grants que falten.",{"_3602":72526,"_30987":72474,"_21467":120285,"_5":14750,"_28174":120152,"_3058":120286},[],"Prueba una identidad autorizada y otra denegada. Si ningún token coincide con un principal activo del bootstrap, nadie podrá administrar la PKI.",{"_3602":72527,"_30987":72474,"_21467":120288,"_5":14750,"_28174":120152,"_3058":120289},[],"Consulta Control de acceso para conocer el modelo de principales y políticas.",{"_3602":72528,"_30987":72474,"_21467":120291,"_5":14750,"_28174":120156,"_3058":120292},[],"Para instalar un checkout local:",{"_3602":72529,"_30987":72474,"_21467":120294,"_5":14750,"_28174":120160,"_3058":120295},[],"El Gateway debe mostrar `PROGRAMMED=True`. Si está programado pero no tiene una dirección utilizable, continúa con Expón el Gateway.",{"_3602":72530,"_30987":72474,"_21467":120297,"_5":14750,"_28174":120160,"_3058":120298},[],"El test de Helm comprueba los endpoints de salud de CA, DMS Manager, Device Manager y VA, y verifica la respuesta de la UI.",{"_3602":72531,"_30987":72474,"_21467":120300,"_5":14750,"_28174":120164,"_3058":120301},[],"Los pasos de upgrade específicos de cada versión se mantienen en `charts/lamassu/CHANGELOG/` dentro del repositorio Helm. El chart también incluye un job de pre-upgrade opcional que migra las claves privadas de CA existentes al motor KMS configurado para el release. Está desactivado por defecto (`migrations.caToKms.enabled: false`) y solo es necesario cuando actualizas desde una versión anterior a 3.7.0.",{"_3602":72532,"_30987":72474,"_21467":120303,"_5":14750,"_28174":120164,"_3058":120304},[],"Mientras el flag esté activo, cada `helm upgrade` crea el job `<chart fullname>-ca-to-kms-migration` (`lamassu-ca-to-kms-migration` para el release `lamassu`); una instalación nueva no lo crea. Su hook weight es `-10`, por lo que se ejecuta antes de los otros hooks de pre-upgrade: la configuración de bootstrap de autorización (peso `-4`) y el job de migración de base de datos (peso `-3`).",{"_3602":72533,"_30987":72474,"_21467":120306,"_5":14750,"_28174":120164,"_3058":120307},[],"El job consume la misma configuración del servicio KMS que el chart renderiza en el ConfigMap de KMS, incluidos los motores de `services.kms.cryptoEngines`, y ejecuta la imagen de la herramienta de migración definida en `migrations.caToKms.image`. La monta en modo read-only en `/etc/lamassuiot/config.yml` desde la clave `config` del ConfigMap, así que configura el motor de destino en tus valores antes del upgrade que realiza la migración.",{"_3602":72534,"_30987":72474,"_21467":120309,"_5":14750,"_28174":120164,"_3058":120310},[],"El job resuelve su configuración mediante un volumen proyectado con dos fuentes opcionales: el ConfigMap `<chart fullname>-kms-config`, cuyo nombre incorpora el release (`lamassu-kms-config` para el release `lamassu`, `prod-lamassu-kms-config` para el release `prod`), y el ConfigMap legacy `kms-config`, sin el nombre del release, creado por versiones anteriores del chart. La configuración legacy mantiene la autoridad mientras siga presente y el job usa el ConfigMap del release una vez el legacy desaparece. Ambas fuentes son opcionales, por lo que un ConfigMap ausente nunca deja el pod del upgrade en `ContainerCreating`.",{"_3602":72535,"_30987":72474,"_21467":120312,"_5":14750,"_28174":120164,"_3058":120313},[],"Mantén `migrations.caToKms.enabled: true` en el upgrade que realiza la migración y elimina después el flag de tus valores una vez completada la migración; su valor por defecto es `false`.",{"_3602":72536,"_30987":72474,"_21467":120315,"_5":14750,"_28174":120168,"_3058":120316},[],"Antes de pasar a producción, revisa:",{"_3602":72537,"_30987":72474,"_21467":120318,"_5":14750,"_28174":120168,"_3058":120319},[],"backup y recuperación de PostgreSQL y volúmenes persistentes",{"_3602":72538,"_30987":72474,"_21467":120321,"_5":14750,"_28174":120168,"_3058":120322},[],"un motor KMS de producción; el motor filesystem predeterminado no ofrece alta disponibilidad",{"_3602":72539,"_30987":72474,"_21467":120324,"_5":14750,"_28174":120168,"_3058":120325},[],"almacenamiento compartido para VA antes de aumentar sus réplicas",{"_3602":72540,"_30987":72474,"_21467":120327,"_5":14750,"_28174":120168,"_3058":120328},[],"roles OIDC gestionados y eliminación de credenciales de evaluación",{"_3602":72541,"_30987":72474,"_21467":120330,"_5":14750,"_28174":120168,"_3058":120331},[],"un emisor TLS de confianza o un certificado gestionado externamente",{"_3602":72542,"_30987":72474,"_21467":120333,"_5":14750,"_28174":120168,"_3058":120334},[],"recursos, réplicas, autoscaling, disruption budgets y placement",{"_3602":72543,"_30987":72474,"_21467":120336,"_5":14750,"_28174":120168,"_3058":120337},[],"SMTP, observabilidad y entrega de alertas",{"_3602":72544,"_30987":72474,"_21467":120339,"_5":14750,"_28174":120168,"_3058":120340},[],"las guías de actualización entre versiones y las notas de migración de `charts/lamassu/CHANGELOG/` antes de cada upgrade, incluido el hook opcional de migración CA-to-KMS descrito arriba",{"_3602":72545,"_30987":72474,"_21467":120342,"_5":14750,"_28174":120168,"_3058":120343},[],"La referencia completa de valores se mantiene en `charts/lamassu/VALUES.md` dentro del repositorio Helm.",{"_3602":72546,"_30987":72546,"_5":15110,"_3058":120345,"_31325":120346,"_21467":120347,"_28174":72546},"Expón el Gateway",[50623,119537,119771],[],{"_3602":72547,"_30987":72546,"_21467":120349,"_5":14750,"_28174":72546,"_3058":120350},[],"Elige cómo llegan los clientes a Lamassu, cuándo definir gateway.addresses y cómo diseñar varios Gateways.",{"_3602":72548,"_30987":72546,"_5":31322,"_21467":120352,"_28174":120353,"_3058":120354},[],"/docs/es/deployment/self-hosted/networking#expón-el-gateway-de-lamassu","Expón el Gateway de Lamassu",{"_3602":72549,"_30987":72546,"_5":31322,"_21467":120356,"_28174":120357,"_3058":120358},[],"/docs/es/deployment/self-hosted/networking#necesitas-gatewayaddresses","¿Necesitas `gateway.addresses`?",{"_3602":72550,"_30987":72546,"_5":31322,"_21467":120360,"_28174":120361,"_3058":120362},[],"/docs/es/deployment/self-hosted/networking#diseño-recomendado-para-un-solo-nodo","Diseño recomendado para un solo nodo",{"_3602":72551,"_30987":72546,"_5":31322,"_21467":120364,"_28174":120365,"_3058":51486},[],"/docs/es/deployment/self-hosted/networking#k3s",{"_3602":72552,"_30987":72546,"_5":31322,"_21467":120367,"_28174":120368,"_3058":120369},[],"/docs/es/deployment/self-hosted/networking#bare-metal-con-metallb-o-kube-vip","Bare metal con MetalLB o kube-vip",{"_3602":72553,"_30987":72546,"_5":31322,"_21467":120371,"_28174":120372,"_3058":120373},[],"/docs/es/deployment/self-hosted/networking#proxy-externo-nat-o-vpn","Proxy externo, NAT o VPN",{"_3602":72554,"_30987":72546,"_5":31322,"_21467":120375,"_28174":120376,"_3058":120377},[],"/docs/es/deployment/self-hosted/networking#qué-ocurre-si-necesitas-tres-gateways","¿Qué ocurre si necesitas tres Gateways?",{"_3602":72555,"_30987":72546,"_5":31322,"_21467":120379,"_28174":120380,"_3058":120381},[],"/docs/es/deployment/self-hosted/networking#certificados-de-cliente-y-cabeceras-de-identidad","Certificados de cliente y cabeceras de identidad",{"_3602":72556,"_30987":72546,"_5":31322,"_21467":120383,"_28174":120384,"_3058":120385},[],"/docs/es/deployment/self-hosted/networking#guía-de-decisión","Guía de decisión",{"_3602":72557,"_30987":72546,"_5":31322,"_21467":120387,"_28174":120388,"_3058":120389},[],"/docs/es/deployment/self-hosted/networking#proxy-de-salida","Proxy de salida",{"_3602":72558,"_30987":72546,"_5":31322,"_21467":120391,"_28174":120392,"_3058":120393},[],"/docs/es/deployment/self-hosted/networking#verifica-la-ruta-de-tráfico","Verifica la ruta de tráfico",{"_3602":72559,"_30987":72546,"_21467":120395,"_5":14750,"_28174":120353,"_3058":120396},[],"El chart de Lamassu crea un Gateway compartido con listeners HTTP y HTTPS. Envoy Gateway crea normalmente un deployment de proxy dedicado y un Service `LoadBalancer`.",{"_3602":72560,"_30987":72546,"_21467":120398,"_5":14750,"_28174":120353,"_3058":120399},[],"La accesibilidad externa depende de toda la ruta. Un recurso `Gateway` no configura por sí mismo el router, firewall, DNS, balanceador cloud ni NAT upstream.",{"_3602":72561,"_30987":72546,"_21467":120401,"_5":14750,"_28174":120357,"_3058":120402},[],"Normalmente no. Si lo omites, el controlador del Gateway y la implementación del balanceador pueden asignar una dirección y publicarla en `Gateway.status.addresses` y en el estado del Service generado.",{"_3602":72562,"_30987":72546,"_21467":120404,"_5":14750,"_28174":120357,"_3058":120405},[],"Defínelo únicamente cuando:",{"_3602":72563,"_30987":72546,"_21467":120407,"_5":14750,"_28174":120357,"_3058":120408},[],"tu balanceador cloud o bare metal permite solicitar una dirección concreta",{"_3602":72564,"_30987":72546,"_21467":120410,"_5":14750,"_28174":120357,"_3058":120411},[],"esa dirección está asignada a este Gateway",{"_3602":72565,"_30987":72546,"_21467":120413,"_5":14750,"_28174":120357,"_3058":120414},[],"la red ya enruta el tráfico de esa dirección hasta el clúster",{"_3602":72566,"_30987":72546,"_21467":120416,"_5":14750,"_28174":120357,"_3058":120417},[],"Esto solicita `192.168.1.50`; no reclama la IP en tu LAN ni la vuelve accesible.",{"_3602":72567,"_30987":72546,"_21467":120419,"_5":14750,"_28174":120357,"_3058":120420},[],"No confundas estos valores:",{"_3602":72568,"_30987":72546,"_21467":120422,"_5":14750,"_28174":120357,"_3058":120423},[],"`gateway.addresses` solicita una dirección para el Gateway.",{"_3602":72569,"_30987":72546,"_21467":120425,"_5":14750,"_28174":120357,"_3058":120426},[],"`tls.certManagerOptions.certSpec.addresses` añade direcciones IP a los SAN del certificado TLS.",{"_3602":72570,"_30987":72546,"_21467":120428,"_5":14750,"_28174":120357,"_3058":120429},[],"Si los usuarios se conectan por DNS, añade el nombre a `tls.certManagerOptions.certSpec.hostnames`. No copies la IP pública de un proxy upstream en `gateway.addresses`.",{"_3602":72571,"_30987":72546,"_21467":120431,"_5":14750,"_28174":120361,"_3058":120432},[],"Para una VM pequeña con K3s o MicroK8s, usa un único Gateway externo de Lamassu y enruta todos los endpoints a través de él:",{"_3602":72572,"_30987":72546,"_21467":120434,"_5":14750,"_28174":120361,"_3058":120435},[],"Este diseño utiliza una IP, un punto de entrada TLS y un único par de puertos. El chart ya crea las rutas necesarias.",{"_3602":72573,"_30987":72546,"_21467":120437,"_5":14750,"_28174":120365,"_3058":120438},[],"K3s ServiceLB implementa cada Service `LoadBalancer` mediante pods que reservan los puertos del Service en el nodo. En un único nodo, solo un Service puede ocupar el puerto 80 y otro el 443. El Service Traefik que K3s instala por defecto puede estar ocupando ambos.",{"_3602":72574,"_30987":72546,"_21467":120440,"_5":14750,"_28174":120365,"_3058":120441},[],"Para el diseño recomendado:",{"_3602":72575,"_30987":72546,"_21467":120443,"_5":14750,"_28174":120365,"_3058":120444},[],"Usa un único Gateway de Lamassu expuesto externamente.",{"_3602":72576,"_30987":72546,"_21467":120446,"_5":14750,"_28174":120365,"_3058":120447},[],"Comprueba que los puertos 80 y 443 están libres. Deshabilita o reconfigura Traefik si no forma parte de la ruta de tráfico.",{"_3602":72577,"_30987":72546,"_21467":120449,"_5":14750,"_28174":120365,"_3058":120450},[],"Permite esos puertos en el firewall de la VM y en cualquier security group upstream.",{"_3602":72578,"_30987":72546,"_21467":120452,"_5":14750,"_28174":120365,"_3058":120453},[],"Apunta DNS a la dirección accesible de la VM.",{"_3602":72579,"_30987":72546,"_21467":120455,"_5":14750,"_28174":120365,"_3058":120456},[],"Consulta la documentación de K3s ServiceLB para conocer el uso de host ports y cómo sustituirlo por otro balanceador.",{"_3602":72580,"_30987":72546,"_21467":120458,"_5":14750,"_28174":120368,"_3058":120459},[],"Asigna una VIP de un pool accesible desde la LAN. Puedes solicitarla con `gateway.addresses` si la implementación lo permite. Confirma la dirección asignada en el estado en lugar de asumir que la solicitud tuvo éxito.",{"_3602":72581,"_30987":72546,"_21467":120461,"_5":14750,"_28174":120372,"_3058":120462},[],"Una dirección pública externa puede reenviar TCP 80 y 443 a la VM o a una VIP de Kubernetes:",{"_3602":72582,"_30987":72546,"_21467":120464,"_5":14750,"_28174":120372,"_3058":120465},[],"La IP pública pertenece al dispositivo externo. Deja `gateway.addresses` sin definir o usa la dirección real del lado de Kubernetes, nunca una IP que el clúster no pueda asociar.",{"_3602":72583,"_30987":72546,"_21467":120467,"_5":14750,"_28174":120376,"_3058":120468},[],"Primero decide si necesitas tres data planes independientes o solo tres nombres de host.",{"_3602":72584,"_30987":72546,"_21467":120470,"_5":14750,"_28174":120376,"_3058":120471},[],"Requisito",{"_3602":72585,"_30987":72546,"_21467":120473,"_5":14750,"_28174":120376,"_3058":120474},[],"Diseño recomendado",{"_3602":72586,"_30987":72546,"_21467":120476,"_5":14750,"_28174":120376,"_3058":120477},[],"Consecuencia",{"_3602":72587,"_30987":72546,"_21467":120479,"_5":14750,"_28174":120376,"_3058":120480},[],"Varias URL o servicios de Lamassu",{"_3602":72588,"_30987":72546,"_21467":120482,"_5":14750,"_28174":120376,"_3058":120483},[],"Un Gateway con varias rutas",{"_3602":72589,"_30987":72546,"_21467":120485,"_5":14750,"_28174":120376,"_3058":120486},[],"Una IP y un proxy fleet; es el comportamiento predeterminado del chart",{"_3602":72590,"_30987":72546,"_21467":120488,"_5":14750,"_28174":120376,"_3058":120489},[],"Gateways independientes e IP externas distintas",{"_3602":72591,"_30987":72546,"_21467":120491,"_5":14750,"_28174":120376,"_3058":120492},[],"Una VIP por Gateway",{"_3602":72592,"_30987":72546,"_21467":120494,"_5":14750,"_28174":120376,"_3058":120495},[],"Todos pueden usar 80/443; requiere un balanceador con un pool de direcciones",{"_3602":72593,"_30987":72546,"_21467":120497,"_5":14750,"_28174":120376,"_3058":120498},[],"Gateways independientes, un nodo y una IP",{"_3602":72594,"_30987":72546,"_21467":120500,"_5":14750,"_28174":120376,"_3058":120501},[],"Puertos externos diferentes",{"_3602":72595,"_30987":72546,"_21467":120503,"_5":14750,"_28174":120376,"_3058":120504},[],"Los clientes deben indicar puertos no estándar",{"_3602":72596,"_30987":72546,"_21467":120506,"_5":14750,"_28174":120376,"_3058":120507},[],"Terminación TLS/mTLS separada detrás de una IP",{"_3602":72597,"_30987":72546,"_21467":120509,"_5":14750,"_28174":120376,"_3058":120510},[],"Front door con enrutamiento SNI hacia Gateways internos",{"_3602":72598,"_30987":72546,"_21467":120512,"_5":14750,"_28174":120376,"_3058":120513},[],"Diseño avanzado; el front door usa TLS passthrough y cada Gateway termina su propio TLS",{"_3602":72599,"_30987":72546,"_21467":120515,"_5":14750,"_28174":120376,"_3058":120516},[],"Recursos Gateway separados pero proxy compartido",{"_3602":72600,"_30987":72546,"_21467":120518,"_5":14750,"_28174":120376,"_3058":120519},[],"Modo merged Gateway de Envoy",{"_3602":72601,"_30987":72546,"_21467":120521,"_5":14750,"_28174":120376,"_3058":120522},[],"Solo separación lógica; cada listener necesita una tupla única de puerto, protocolo y hostname",{"_3602":72602,"_30987":72546,"_21467":120524,"_5":14750,"_28174":120376,"_3058":120525},[],"Tres Services `LoadBalancer` independientes no pueden reservar a la vez los mismos puertos 80 y 443 mediante K3s ServiceLB. Usa un Gateway compartido, asigna VIP distintas con otro balanceador o utiliza puertos diferentes.",{"_3602":72603,"_30987":72546,"_21467":120527,"_5":14750,"_28174":120376,"_3058":120528},[],"Envoy Gateway provisiona normalmente un proxy fleet por `Gateway`. Su modo merged Gateway puede compartir un fleet y una dirección, pero no es un cambio directo para varias releases de Lamassu: los listeners generados usan los mismos puertos y protocolos sin hostnames distintos, por lo que entran en conflicto salvo que personalices el diseño.",{"_3602":72604,"_30987":72546,"_21467":120530,"_5":14750,"_28174":120376,"_3058":120531},[],"Usa un front door con SNI solo cuando los Gateways internos deban mantener políticas TLS o mTLS independientes:",{"_3602":72605,"_30987":72546,"_21467":120533,"_5":14750,"_28174":120376,"_3058":120534},[],"Esto requiere hostnames SNI distintos y configuración de red externa al chart de Lamassu.",{"_3602":72606,"_30987":72546,"_21467":120536,"_5":14750,"_28174":120380,"_3058":120537},[],"El chart aplica automáticamente una `ClientTrafficPolicy` llamada `enable-mtls` a su Gateway compartido; ningún valor de Helm la activa ni la desactiva. La terminación TLS acepta peticiones con o sin certificado de cliente: los dispositivos pueden presentar uno, pero no están obligados a hacerlo. Antes de reenviar una petición, el Gateway elimina las cabeceras de identidad y de certificado que un cliente podría suministrarse por sí mismo: `X-Principal-Id`, `X-Lms-Source`, `X-Forwarded-Client-Cert`, `X-Forwarded-Cert`, `X-Forwarded-Tls-Client-Cert` (la grafía de Traefik), `Ssl-Client-Cert` y `X-Amzn-Mtls-Clientcert`. La grafía de Traefik se incluye porque los backends que aceptan `X-Forwarded-Tls-Client-Cert` directamente recibirían, si no, datos de identidad de certificado suministrados por el propio cliente sin haber presentado un certificado. Tras la eliminación, Envoy añade su propia cabecera `X-Forwarded-Client-Cert` con el certificado presentado y su cadena, de modo que los servicios que leen la identidad del certificado reciben solo valores generados por el Gateway. Ningún valor de Helm modifica la lista de cabeceras eliminadas. La página Control de acceso describe cómo aprovecha `authz` esta protección para mantener `X-Principal-ID` fuera del alcance de los clientes.",{"_3602":72607,"_30987":72546,"_21467":120539,"_5":14750,"_28174":120384,"_3058":120540},[],"Si un Gateway puede gestionar TLS y el enrutamiento, usa el valor predeterminado del chart.",{"_3602":72608,"_30987":72546,"_21467":120542,"_5":14750,"_28174":120384,"_3058":120543},[],"Si los Gateways necesitan políticas independientes y puedes asignar IP, usa una VIP por Gateway.",{"_3602":72609,"_30987":72546,"_21467":120545,"_5":14750,"_28174":120384,"_3058":120546},[],"Si solo necesitas separar los recursos Kubernetes, evalúa merged Gateway y usa tuplas de listener únicas.",{"_3602":72610,"_30987":72546,"_21467":120548,"_5":14750,"_28174":120384,"_3058":120549},[],"Si los data planes y la terminación TLS deben ser independientes detrás de una IP, añade un front door con TLS passthrough y SNI.",{"_3602":72611,"_30987":72546,"_21467":120551,"_5":14750,"_28174":120384,"_3058":120552},[],"Si nada de lo anterior es posible, usa puertos externos distintos o cambia el diseño de red.",{"_3602":72612,"_30987":72546,"_21467":120554,"_5":14750,"_28174":120388,"_3058":120555},[],"Los clientes internos de Lamassu — la conexión con el motor de Vault, las llamadas entre servicios y los webhooks salientes — respetan las variables de entorno `HTTP_PROXY`, `HTTPS_PROXY` y `NO_PROXY`. La excepción es el conector del motor de autorización: usa su propio transporte y no consulta estas variables de proxy. Si tu despliegue enruta el tráfico de salida por un proxy, incluye los nombres de servicio internos del clúster en `NO_PROXY` (por ejemplo `.svc,.cluster.local`) para que el tráfico interno permanezca dentro del clúster. El tráfico de loopback nunca se envía por un proxy.",{"_3602":72613,"_30987":72546,"_21467":120557,"_5":14750,"_28174":120388,"_3058":120558},[],"El transporte predeterminado de estos clientes acota el timeout de conexión (30 segundos), el handshake TLS (10 segundos) y la reutilización de conexiones inactivas (90 segundos), de modo que una dependencia inalcanzable falla rápido en lugar de bloquearse; estos valores son los predeterminados del transporte de Go, no configuración de Lamassu. HTTP/2 se negocia cuando el otro extremo lo soporta. El conector del motor de autorización mantiene su propio transporte sin estos timeouts de conexión ni de handshake TLS; solo su timeout global de petición de 30 segundos acota cada llamada.",{"_3602":72614,"_30987":72546,"_21467":120560,"_5":14750,"_28174":120392,"_3058":120561},[],"Comprueba, en orden:",{"_3602":72615,"_30987":72546,"_21467":120563,"_5":14750,"_28174":120392,"_3058":120564},[],"El `Gateway` muestra `Accepted=True` y `Programmed=True`.",{"_3602":72616,"_30987":72546,"_21467":120566,"_5":14750,"_28174":120392,"_3058":120567},[],"Su estado contiene la dirección esperada.",{"_3602":72617,"_30987":72546,"_21467":120569,"_5":14750,"_28174":120392,"_3058":120570},[],"El Service `LoadBalancer` generado tiene una dirección externa utilizable.",{"_3602":72618,"_30987":72546,"_21467":120572,"_5":14750,"_28174":120392,"_3058":120573},[],"El puerto 443 de esa dirección es accesible desde la red del cliente.",{"_3602":72619,"_30987":72546,"_21467":120575,"_5":14750,"_28174":120392,"_3058":120576},[],"DNS resuelve al endpoint accesible externamente.",{"_3602":72620,"_30987":72546,"_21467":120578,"_5":14750,"_28174":120392,"_3058":120579},[],"El certificado contiene el nombre DNS o la IP usada por el cliente.",{"_3602":72621,"_30987":72546,"_21467":120581,"_5":14750,"_28174":120392,"_3058":120582},[],"Gateway API trata las direcciones como estado deseado que el controlador puede asignar o rechazar; consulta la introducción a Gateway API para conocer el modelo.",{"_3602":72622,"_30987":72622,"_5":15110,"_3058":50730,"_31325":120584,"_21467":120585,"_28174":72622},[50623,119537,119771],[],{"_3602":72623,"_30987":72622,"_21467":120587,"_5":14750,"_28174":72622,"_3058":120588},[],"Elige un flujo de instalación y una arquitectura de red para Lamassu en tu clúster Kubernetes.",{"_3602":72624,"_30987":72622,"_5":31322,"_21467":120590,"_28174":120591,"_3058":120592},[],"/docs/es/deployment/self-hosted/overview#despliegue-self-managed-con-kubernetes","Despliegue self-managed con Kubernetes",{"_3602":72625,"_30987":72622,"_5":31322,"_21467":120594,"_28174":120595,"_3058":120596},[],"/docs/es/deployment/self-hosted/overview#elige-un-flujo-de-instalación","Elige un flujo de instalación",{"_3602":72626,"_30987":72622,"_5":31322,"_21467":120598,"_28174":120599,"_3058":120600},[],"/docs/es/deployment/self-hosted/overview#qué-proporciona-el-chart-de-lamassu","Qué proporciona el chart de Lamassu",{"_3602":72627,"_30987":72622,"_5":31322,"_21467":120602,"_28174":120603,"_3058":120604},[],"/docs/es/deployment/self-hosted/overview#cómo-encaja-el-despliegue","Cómo encaja el despliegue",{"_3602":72628,"_30987":72622,"_5":31322,"_21467":120606,"_28174":120607,"_3058":120608},[],"/docs/es/deployment/self-hosted/overview#requisitos-de-plataforma","Requisitos de plataforma",{"_3602":72629,"_30987":72622,"_5":31322,"_21467":120610,"_28174":120611,"_3058":120612},[],"/docs/es/deployment/self-hosted/overview#elige-la-siguiente-página","Elige la siguiente página",{"_3602":72630,"_30987":72622,"_21467":120614,"_5":14750,"_28174":120591,"_3058":120615},[],"Ejecuta Lamassu en un clúster Kubernetes operado por tu equipo. El chart Helm despliega los servicios de Lamassu y sus recursos de enrutamiento; tú proporcionas el clúster, el almacenamiento persistente, el proveedor de identidad, PostgreSQL, RabbitMQ y la ruta de red utilizada por los clientes.",{"_3602":72631,"_30987":72622,"_21467":120617,"_5":14750,"_28174":120595,"_3058":120618},[],"Flujo",{"_3602":72632,"_30987":72622,"_21467":120620,"_5":14750,"_28174":120595,"_3058":120621},[],"Úsalo para",{"_3602":72633,"_30987":72622,"_21467":120623,"_5":14750,"_28174":120595,"_3058":120624},[],"Qué instala",{"_3602":72634,"_30987":72622,"_21467":120626,"_5":14750,"_28174":120595,"_3058":51748},[],{"_3602":72635,"_30987":72622,"_21467":120628,"_5":14750,"_28174":120595,"_3058":120629},[],"Producción y entornos controlados",{"_3602":72636,"_30987":72622,"_21467":120631,"_5":14750,"_28174":120595,"_3058":120632},[],"Servicios de Lamassu y recursos de Gateway API",{"_3602":72637,"_30987":72622,"_21467":120634,"_5":14750,"_28174":120595,"_3058":50867},[],{"_3602":72638,"_30987":72622,"_21467":120636,"_5":14750,"_28174":120595,"_3058":120637},[],"Evaluación, demos, CI y pequeños clústeres de laboratorio",{"_3602":72639,"_30987":72622,"_21467":120639,"_5":14750,"_28174":120595,"_3058":120640},[],"PostgreSQL, Keycloak, RabbitMQ, Envoy Gateway y Lamassu",{"_3602":72640,"_30987":72622,"_21467":120642,"_5":14750,"_28174":120599,"_3058":120643},[],"El chart de Lamassu es un **chart de aplicación**, no un chart de bootstrap del clúster. Crea los recursos Kubernetes que ejecutan y configuran Lamassu, pero espera que ya existan los servicios de plataforma de los que dependen.",{"_3602":72641,"_30987":72622,"_21467":120645,"_5":14750,"_28174":120599,"_3058":120646},[],"Área",{"_3602":72642,"_30987":72622,"_21467":120648,"_5":14750,"_28174":120599,"_3058":120649},[],"El chart de Lamassu proporciona",{"_3602":72643,"_30987":72622,"_21467":120651,"_5":14750,"_28174":120599,"_3058":120652},[],"Tú proporcionas",{"_3602":72644,"_30987":72622,"_21467":120654,"_5":14750,"_28174":120599,"_3058":120655},[],"Aplicaciones Lamassu",{"_3602":72645,"_30987":72622,"_21467":120657,"_5":14750,"_28174":120599,"_3058":120658},[],"Deployments y StatefulSets para la UI y las APIs, Services internos, ConfigMaps, una ServiceAccount y HPA/PDB opcionales",{"_3602":72646,"_30987":72622,"_21467":120660,"_5":14750,"_28174":120599,"_3058":120661},[],"Un clúster Kubernetes operativo, capacidad de cómputo y acceso a las imágenes",{"_3602":72647,"_30987":72622,"_21467":120663,"_5":14750,"_28174":120599,"_3058":120664},[],"Datos PostgreSQL",{"_3602":72648,"_30987":72622,"_21467":120666,"_5":14750,"_28174":120599,"_3058":120667},[],"Un job de pre-install/pre-upgrade que crea las bases de datos y schemas necesarios, ejecuta migraciones y aplica el bootstrap de autorización",{"_3602":72649,"_30987":72622,"_21467":120669,"_5":14750,"_28174":120599,"_3058":120670},[],"Un servidor PostgreSQL accesible, credenciales autorizadas para crear bases de datos y schemas, y operaciones de backup/HA",{"_3602":72650,"_30987":72622,"_21467":120672,"_5":14750,"_28174":120599,"_3058":120673},[],"Mensajería",{"_3602":72651,"_30987":72622,"_21467":120675,"_5":14750,"_28174":120599,"_3058":120676},[],"Configuración de conexión a RabbitMQ para los servicios Lamassu; la conexión puede usar AMQPS, con una CA privada y un certificado de cliente opcionales, definidos mediante valores del chart",{"_3602":72652,"_30987":72622,"_21467":120678,"_5":14750,"_28174":120599,"_3058":120679},[],"Un broker RabbitMQ accesible, credenciales y la gestión de su ciclo de vida",{"_3602":72653,"_30987":72622,"_21467":120681,"_5":14750,"_28174":120599,"_3058":120682},[],"Identidad",{"_3602":72654,"_30987":72622,"_21467":120684,"_5":14750,"_28174":120599,"_3058":120685},[],"Configuración OIDC/JWT y de autorización externa, además de los principales iniciales de Lamassu",{"_3602":72655,"_30987":72622,"_21467":120687,"_5":14750,"_28174":120599,"_3058":120688},[],"Un proveedor OIDC, realm/tenant, cliente, usuarios, grupos y roles",{"_3602":72656,"_30987":72622,"_21467":120690,"_5":14750,"_28174":120599,"_3058":120691},[],"Enrutamiento externo",{"_3602":72657,"_30987":72622,"_21467":120693,"_5":14750,"_28174":120599,"_3058":120694},[],"Un `Gateway`, recursos `HTTPRoute`, una configuración `EnvoyProxy` y políticas de seguridad de Envoy",{"_3602":72658,"_30987":72622,"_21467":120696,"_5":14750,"_28174":120599,"_3058":120697},[],"Las CRD de Gateway API y Envoy, el controlador Envoy Gateway, una `GatewayClass`, un balanceador y la ruta de red externa",{"_3602":72659,"_30987":72622,"_21467":120699,"_5":14750,"_28174":120599,"_3058":51822},[],{"_3602":72660,"_30987":72622,"_21467":120701,"_5":14750,"_28174":120599,"_3058":120702},[],"En el modo predeterminado `tls.type: certManager`, recursos `Issuer` y `Certificate` CA de cert-manager y un `Certificate` downstream gestionado por el chart; en el modo `tls.type: external`, una referencia a tu Secret TLS",{"_3602":72661,"_30987":72622,"_21467":120704,"_5":14750,"_28174":120599,"_3058":120705},[],"cert-manager solo para el modo predeterminado `tls.type: certManager`; para TLS de confianza, un emisor de confianza o un Secret TLS ya poblado",{"_3602":72662,"_30987":72622,"_21467":120707,"_5":14750,"_28174":120599,"_3058":120708},[],"Datos persistentes de la aplicación",{"_3602":72663,"_30987":72622,"_21467":120710,"_5":14750,"_28174":120599,"_3058":120711},[],"PersistentVolumeClaims necesarios para el almacenamiento local predeterminado de KMS y VA",{"_3602":72664,"_30987":72622,"_21467":120713,"_5":14750,"_28174":120599,"_3058":120714},[],"Una StorageClass, almacenamiento físico, backups y un backend compartido/externo cuando el escalado lo requiera",{"_3602":72665,"_30987":72622,"_21467":120716,"_5":14750,"_28174":120599,"_3058":120717},[],"Integraciones opcionales",{"_3602":72666,"_30987":72622,"_21467":120719,"_5":14750,"_28174":120599,"_3058":120720},[],"Puntos de configuración para observabilidad, conectores AWS y conectividad PKCS#11/HSM",{"_3602":72667,"_30987":72622,"_21467":120722,"_5":14750,"_28174":120599,"_3058":120723},[],"Los backends de observabilidad, credenciales cloud y un HSM de producción o servicio externo de claves",{"_3602":72668,"_30987":72622,"_21467":120725,"_5":14750,"_28174":120599,"_3058":120726},[],"El chart crea el `Gateway` y las rutas de Lamassu. No instala el controlador Envoy Gateway ni hace que el Service `LoadBalancer` generado sea accesible desde tu red.",{"_3602":72669,"_30987":72622,"_21467":120728,"_5":14750,"_28174":120599,"_3058":120729},[],"Usa un único Gateway de Lamassu en los puertos 80 y 443 y deja que sus HTTPRoutes distribuyan el tráfico a todos los servicios. Proporciona a ese Gateway un único endpoint accesible mediante el balanceador del clúster, o reenvía tráfico desde un proxy externo o un dispositivo NAT. No necesitas un Gateway por servicio.",{"_3602":72670,"_30987":72622,"_21467":120731,"_5":14750,"_28174":120603,"_3058":120732},[],"El chart crea un `Gateway` compartido por cada release de Helm. Todos los recursos `HTTPRoute` gestionados por el chart se conectan a él. Envoy Gateway provisiona el data plane del proxy y un Service `LoadBalancer` de Kubernetes para ese Gateway.",{"_3602":72671,"_30987":72622,"_21467":120734,"_5":14750,"_28174":120603,"_3058":120735},[],"El valor `gateway.addresses` solo solicita una dirección al controlador del Gateway. No hace que una IP sea enrutable, abre un firewall, configura DNS ni crea NAT. Consulta Expón el Gateway antes de definirlo.",{"_3602":72672,"_30987":72622,"_21467":120737,"_5":14750,"_28174":120607,"_3058":120738},[],"Kubernetes 1.24 o posterior",{"_3602":72673,"_30987":72622,"_21467":120740,"_5":14750,"_28174":120607,"_3058":120741},[],"Helm 3.2 o posterior",{"_3602":72674,"_30987":72622,"_21467":120743,"_5":14750,"_28174":120607,"_3058":120744},[],"Envoy Gateway 1.8 o posterior y una `GatewayClass`",{"_3602":72675,"_30987":72622,"_21467":120746,"_5":14750,"_28174":120607,"_3058":120747},[],"cert-manager 1.14 o posterior; necesario solo para el modo TLS predeterminado `tls.type: certManager`, no para `tls.type: external`",{"_3602":72676,"_30987":72622,"_21467":120749,"_5":14750,"_28174":120607,"_3058":120750},[],"almacenamiento persistente adecuado para la configuración elegida de PostgreSQL, RabbitMQ, VA y KMS",{"_3602":72677,"_30987":72622,"_21467":120752,"_5":14750,"_28174":120607,"_3058":120753},[],"una implementación de balanceador o alguna otra ruta deliberada desde los clientes hasta el Gateway",{"_3602":72678,"_30987":72622,"_21467":120755,"_5":14750,"_28174":120607,"_3058":120756},[],"Los despliegues KMS que usan el sidecar PKCS#11 nativo requieren Kubernetes 1.29 o posterior. Las imágenes de contenedor precompiladas de Lamassu se publican para `linux/amd64` y `linux/arm64`, y el módulo cliente PKCS#11 del KMS (`p11-kit-client.so`) se instala en la ruta de biblioteca Debian de la arquitectura destino: `/usr/lib/x86_64-linux-gnu/pkcs11/p11-kit-client.so` en amd64 y `/usr/lib/aarch64-linux-gnu/pkcs11/p11-kit-client.so` en arm64. La ruta x86\\_64 se conserva como alias de compatibilidad para configuraciones existentes.",{"_3602":72679,"_30987":72622,"_21467":120758,"_5":14750,"_28174":120611,"_3058":120759},[],"<Card title=\"Instala con Helm\" description=\"Prepara dependencias, configura valores, instala y verifica un despliegue controlado.\" href=\"/docs/deployment/self-hosted/helm\" />",{"_3602":72680,"_30987":72622,"_21467":120761,"_5":14750,"_28174":120611,"_3058":120762},[],"<Card title=\"Actualiza desde 3.8.0\" description=\"Actualiza una release de Helm existente a 4.0.0: cambios de arquitectura, breaking changes, pasos de migración y validación.\" href=\"/docs/upgrades/3-8-0-to-4-0-0\" />",{"_3602":72681,"_30987":72622,"_21467":120764,"_5":14750,"_28174":120611,"_3058":120765},[],"<Card title=\"Expón el Gateway\" description=\"Elige un diseño de tráfico externo, comprende gateway.addresses y gestiona varios Gateways.\" href=\"/docs/deployment/self-hosted/networking\" />",{"_3602":72682,"_30987":72622,"_21467":120767,"_5":14750,"_28174":120611,"_3058":120768},[],"<Card title=\"Usa Fastlane\" description=\"Arranca un entorno completo de evaluación o laboratorio con un script.\" href=\"/docs/deployment/self-hosted/fastlane\" />",{"_3602":72683,"_30987":72683,"_5":15110,"_3058":120770,"_31325":120771,"_21467":120773,"_28174":72683},"Resolución de problemas de despliegue",[50623,119537,120772],"Operación",[],{"_3602":72684,"_30987":72683,"_21467":120775,"_5":14750,"_28174":72683,"_3058":120776},[],"Diagnostica acceso, salud de los servicios y dependencias de infraestructura.",{"_3602":72685,"_30987":72683,"_5":31322,"_21467":120778,"_28174":120779,"_3058":120780},[],"/docs/es/deployment/troubleshooting#secuencia-de-diagnóstico","Secuencia de diagnóstico",{"_3602":72686,"_30987":72683,"_5":31322,"_21467":120782,"_28174":120783,"_3058":120784},[],"/docs/es/deployment/troubleshooting#reproduce-una-sola-operación","Reproduce una sola operación",{"_3602":72687,"_30987":72683,"_5":31322,"_21467":120786,"_28174":120787,"_3058":120788},[],"/docs/es/deployment/troubleshooting#separa-cliente-gateway-y-servicio","Separa cliente, Gateway y servicio",{"_3602":72688,"_30987":72683,"_5":31322,"_21467":120790,"_28174":120791,"_3058":120792},[],"/docs/es/deployment/troubleshooting#revisa-el-estado-de-kubernetes","Revisa el estado de Kubernetes",{"_3602":72689,"_30987":72683,"_5":31322,"_21467":120794,"_28174":120795,"_3058":120796},[],"/docs/es/deployment/troubleshooting#consulta-el-servicio-afectado","Consulta el servicio afectado",{"_3602":72690,"_30987":72683,"_5":31322,"_21467":120798,"_28174":120799,"_3058":120800},[],"/docs/es/deployment/troubleshooting#valida-el-resultado-desde-fuera","Valida el resultado desde fuera",{"_3602":72691,"_30987":72683,"_5":31322,"_21467":120802,"_28174":120803,"_3058":120804},[],"/docs/es/deployment/troubleshooting#recogida-mínima-de-evidencias","Recogida mínima de evidencias",{"_3602":72692,"_30987":72683,"_5":31322,"_21467":120806,"_28174":120807,"_3058":120808},[],"/docs/es/deployment/troubleshooting#no-puedo-iniciar-sesión","No puedo iniciar sesión",{"_3602":72693,"_30987":72683,"_5":31322,"_21467":120810,"_28174":120811,"_3058":120812},[],"/docs/es/deployment/troubleshooting#todo-devuelve-403-o-5xx","Todo devuelve 403 o 5xx",{"_3602":72694,"_30987":72683,"_5":31322,"_21467":120814,"_28174":120815,"_3058":120816},[],"/docs/es/deployment/troubleshooting#errores-500-de-la-api","Errores 500 de la API",{"_3602":72695,"_30987":72683,"_5":31322,"_21467":120818,"_28174":120819,"_3058":120820},[],"/docs/es/deployment/troubleshooting#un-pod-no-está-ready","Un pod no está Ready",{"_3602":72696,"_30987":72683,"_5":31322,"_21467":120822,"_28174":120823,"_3058":120824},[],"/docs/es/deployment/troubleshooting#los-eventos-no-llegan","Los eventos no llegan",{"_3602":72697,"_30987":72683,"_5":31322,"_21467":120826,"_28174":120827,"_3058":120828},[],"/docs/es/deployment/troubleshooting#observabilidad","Observabilidad",{"_3602":72698,"_30987":72683,"_21467":120830,"_5":14750,"_28174":72683,"_3058":120831},[],"Empieza por localizar la capa que falla. Una respuesta del Gateway y un pod no preparado requieren evidencias distintas. Para emisión rechazada o resultados de validación, consulta el diagnóstico PKI; para enrolamiento, el diagnóstico EST.",{"_3602":72699,"_30987":72683,"_21467":120833,"_5":14750,"_28174":120783,"_3058":120834},[],"Anota hora en UTC, usuario o principal, recurso, endpoint y resultado. Evita repetir una acción destructiva como revocación o eliminación.",{"_3602":72700,"_30987":72683,"_21467":120836,"_5":14750,"_28174":120787,"_3058":120837},[],"Comprueba el código HTTP. Un 401 apunta a autenticación; un 403, a autorización; un 404, a ruta o recurso; un 5xx, al servicio o una dependencia.",{"_3602":72701,"_30987":72683,"_21467":120839,"_5":14750,"_28174":120791,"_3058":120840},[],"Localiza pods no preparados, reinicios, eventos recientes y el estado del release.",{"_3602":72702,"_30987":72683,"_21467":120842,"_5":14750,"_28174":120795,"_3058":120843},[],"Revisa su endpoint /health y sus logs en la misma ventana temporal. Después sigue la dependencia indicada: PostgreSQL, RabbitMQ, proveedor OIDC o motor criptográfico.",{"_3602":72703,"_30987":72683,"_21467":120845,"_5":14750,"_28174":120799,"_3058":120846},[],"Para PKI, comprueba el certificado, la cadena, OCSP o CRL con el mismo tipo de cliente que utiliza producción.",{"_3602":72704,"_30987":72683,"_21467":120848,"_5":14750,"_28174":120803,"_3058":120849},[],"Sustituye los marcadores por tu release, namespace y deployment reales.",{"_3602":72705,"_30987":72683,"_21467":120851,"_5":14750,"_28174":120803,"_3058":120852},[],"Ejecuta también la prueba de conectividad del chart:",{"_3602":72706,"_30987":72683,"_21467":120854,"_5":14750,"_28174":120803,"_3058":120855},[],"El test consulta la salud de CA, DMS Manager, Device Manager y VA, y comprueba que la UI devuelve HTML. Un test correcto confirma conectividad básica, no un flujo completo de emisión.",{"_3602":72707,"_30987":72683,"_21467":120857,"_5":14750,"_28174":120803,"_3058":120858},[],"Los servicios del chart exponen sondas de inicio, disponibilidad y vida sobre /health. Un pod puede estar ejecutándose pero no recibir tráfico si la readiness probe falla.",{"_3602":72708,"_30987":72683,"_21467":120860,"_5":14750,"_28174":120807,"_3058":120861},[],"Si recibes un 401:",{"_3602":72709,"_30987":72683,"_21467":120863,"_5":14750,"_28174":120807,"_3058":120864},[],"comprueba que la autoridad OIDC de la UI sea accesible desde el navegador;",{"_3602":72710,"_30987":72683,"_21467":120866,"_5":14750,"_28174":120807,"_3058":120867},[],"verifica emisor, audiencia y expiración del token;",{"_3602":72711,"_30987":72683,"_21467":120869,"_5":14750,"_28174":120807,"_3058":120870},[],"confirma que el Gateway puede obtener las claves de la URI JWKS;",{"_3602":72712,"_30987":72683,"_21467":120872,"_5":14750,"_28174":120807,"_3058":120873},[],"revisa que la ruta pública e interna del proveedor apunten al mismo realm.",{"_3602":72713,"_30987":72683,"_21467":120875,"_5":14750,"_28174":120807,"_3058":120876},[],"Si el login termina pero las APIs devuelven 403:",{"_3602":72714,"_30987":72683,"_21467":120878,"_5":14750,"_28174":120807,"_3058":120879},[],"inspecciona los claims reales del token;",{"_3602":72715,"_30987":72683,"_21467":120881,"_5":14750,"_28174":120807,"_3058":120882},[],"confirma que coinciden con un principal activo;",{"_3602":72716,"_30987":72683,"_21467":120884,"_5":14750,"_28174":120807,"_3058":120885},[],"revisa las políticas concedidas al principal;",{"_3602":72717,"_30987":72683,"_21467":120887,"_5":14750,"_28174":120807,"_3058":120888},[],"verifica que authz alcanza PostgreSQL y su JWKS.",{"_3602":72718,"_30987":72683,"_21467":120890,"_5":14750,"_28174":120807,"_3058":120891},[],"En una instalación nueva, confirma que el Job de migración terminó. Ese Job crea esquemas, migra authz, precarga políticas y provisiona los principales definidos en services.authz.bootstrap.",{"_3602":72719,"_30987":72683,"_21467":120893,"_5":14750,"_28174":120811,"_3058":120894},[],"La autorización externa falla cerrada por defecto. Si authz no está disponible, las rutas protegidas se bloquean.",{"_3602":72720,"_30987":72683,"_21467":120896,"_5":14750,"_28174":120811,"_3058":120897},[],"Localiza el pod y Service de authz.",{"_3602":72721,"_30987":72683,"_21467":120899,"_5":14750,"_28174":120811,"_3058":120900},[],"Comprueba /health, logs y conexión a su base de datos.",{"_3602":72722,"_30987":72683,"_21467":120902,"_5":14750,"_28174":120811,"_3058":120903},[],"Verifica el DNS y puerto configurados en externalAuthorization.",{"_3602":72723,"_30987":72683,"_21467":120905,"_5":14750,"_28174":120811,"_3058":120906},[],"Comprueba que la ruta del check es /v1/ext\\_authz/check.",{"_3602":72724,"_30987":72683,"_21467":120908,"_5":14750,"_28174":120811,"_3058":120909},[],"No cambies a failOpen: true como solución permanente: permitiría tráfico sin autorización durante la caída.",{"_3602":72725,"_30987":72683,"_21467":120911,"_5":14750,"_28174":120815,"_3058":120912},[],"Un 500 indica un fallo interno, como una base de datos no disponible. El cuerpo `{\"err\": ...}` incluye hoy el texto del error interno, que puede contener nombres de esquema, tabla y restricción y, en fallos de conexión, el host y el usuario de la base de datos (no la contraseña). Localiza la causa en el log del servicio con la hora de la petición, y no reenvíes el cuerpo a terceros ni lo muestres a usuarios finales. Es un defecto conocido de divulgación de información: está previsto devolver un mensaje genérico en los 500 y dejar el detalle solo en el log del servicio (seguimiento en lamassuiot#814). El conector de autorización también devuelve el error interno, en el campo `details.error`. Algunos errores de petición, como un tamaño de clave que el motor no admite, se devuelven también como 500.",{"_3602":72726,"_30987":72683,"_21467":120914,"_5":14750,"_28174":120819,"_3058":120915},[],"Revisa primero kubectl describe pod. Las causas habituales son:",{"_3602":72727,"_30987":72683,"_21467":120917,"_5":14750,"_28174":120819,"_3058":120918},[],"credenciales o DNS incorrectos para PostgreSQL o RabbitMQ;",{"_3602":72728,"_30987":72683,"_21467":120920,"_5":14750,"_28174":120819,"_3058":120921},[],"un Secret de CA o de certificado de cliente de AMQP inexistente referenciado por `amqp.ca.secretName` o `amqp.client.secretName`;",{"_3602":72729,"_30987":72683,"_21467":120923,"_5":14750,"_28174":120819,"_3058":120924},[],"volumen persistente sin enlazar;",{"_3602":72730,"_30987":72683,"_21467":120926,"_5":14750,"_28174":120819,"_3058":120927},[],"imagen inaccesible o política de pull incorrecta;",{"_3602":72731,"_30987":72683,"_21467":120929,"_5":14750,"_28174":120819,"_3058":120930},[],"configuración inválida del motor criptográfico;",{"_3602":72732,"_30987":72683,"_21467":120932,"_5":14750,"_28174":120819,"_3058":120933},[],"límites de CPU o memoria demasiado bajos;",{"_3602":72733,"_30987":72683,"_21467":120935,"_5":14750,"_28174":120819,"_3058":120936},[],"migración previa incompleta.",{"_3602":72734,"_30987":72683,"_21467":120938,"_5":14750,"_28174":120819,"_3058":120939},[],"Los valores genéricos solicitan 100 mCPU y 128 MiB y limitan a 500 mCPU y 512 MiB. Ajusta por servicio cuando haya OOMKills, throttling o arranques lentos.",{"_3602":72735,"_30987":72683,"_21467":120941,"_5":14750,"_28174":120819,"_3058":120942},[],"Los motores KMS basados en filesystem y el almacenamiento local de VA utilizan volúmenes de acceso exclusivo. Mantén una réplica o migra a backends compartidos antes de habilitar autoscaling.",{"_3602":72736,"_30987":72683,"_21467":120944,"_5":14750,"_28174":120819,"_3058":120945},[],"Las llamadas internas ahora fallan rápido en lugar de bloquearse para los clientes cubiertos por Proxy de salida: los intentos de conexión agotan el tiempo tras 30 segundos y los handshakes TLS tras 10 segundos. El conector del motor de autorización mantiene su propio transporte sin estos timeouts de conexión ni de handshake TLS; solo su timeout global de petición de 30 segundos acota cada llamada. Si un proxy de salida gestiona el tráfico de salida del clúster, comprueba las variables de entorno `HTTP_PROXY`, `HTTPS_PROXY` y `NO_PROXY` del pod e incluye los nombres de servicio internos en `NO_PROXY`.",{"_3602":72737,"_30987":72683,"_21467":120947,"_5":14750,"_28174":120823,"_3058":120948},[],"Los eventos de dominio y auditoría dependen del publisher del bus:",{"_3602":72738,"_30987":72683,"_21467":120950,"_5":14750,"_28174":120823,"_3058":120951},[],"verifica que esté habilitado en el servicio emisor;",{"_3602":72739,"_30987":72683,"_21467":120953,"_5":14750,"_28174":120823,"_3058":120954},[],"comprueba conectividad y credenciales AMQP;",{"_3602":72740,"_30987":72683,"_21467":120956,"_5":14750,"_28174":120823,"_3058":120957},[],"revisa exchange, routing key, colas y consumidores;",{"_3602":72741,"_30987":72683,"_21467":120959,"_5":14750,"_28174":120823,"_3058":120960},[],"inspecciona dead-letter queues;",{"_3602":72742,"_30987":72683,"_21467":120962,"_5":14750,"_28174":120823,"_3058":120963},[],"alerta sobre colas durables huérfanas y crecimiento de backlog.",{"_3602":72743,"_30987":72683,"_21467":120965,"_5":14750,"_28174":120823,"_3058":120966},[],"Si `amqp.tls` está habilitado, revisa también la parte TLS:",{"_3602":72744,"_30987":72683,"_21467":120968,"_5":14750,"_28174":120823,"_3058":120969},[],"confirma que el listener del broker hable AMQPS en el puerto configurado — el puerto por defecto sigue siendo `5672` y no cambia automáticamente al habilitar TLS;",{"_3602":72745,"_30987":72683,"_21467":120971,"_5":14750,"_28174":120823,"_3058":120972},[],"si defines `amqp.ca.secretName`, confirma que el Secret exista en el namespace del release y que su clave de datos coincida con `amqp.ca.certificateKey` (por defecto `ca.crt`); si no defines `amqp.ca.secretName`, los clientes confían en las CA del sistema;",{"_3602":72746,"_30987":72683,"_21467":120974,"_5":14750,"_28174":120823,"_3058":120975},[],"recuerda que un Secret referenciado inexistente impide arrancar los pods consumidores;",{"_3602":72747,"_30987":72683,"_21467":120977,"_5":14750,"_28174":120823,"_3058":120978},[],"tras actualizar el Secret de la CA o del certificado de cliente, reinicia los pods consumidores: el cliente AMQP carga los certificados al arrancar.",{"_3602":72748,"_30987":72683,"_21467":120980,"_5":14750,"_28174":120823,"_3058":120981},[],"Consulta TLS de AMQP (AMQPS) para la configuración completa.",{"_3602":72749,"_30987":72683,"_21467":120983,"_5":14750,"_28174":120823,"_3058":120984},[],"Una caída del consumidor no siempre impide que la operación principal termine. Por eso debes monitorizar RabbitMQ y verificar de forma independiente la persistencia de auditoría.",{"_3602":72750,"_30987":72683,"_21467":120986,"_5":14750,"_28174":120827,"_3058":120987},[],"El chart puede habilitar la instrumentación OpenTelemetry para los servicios que la admiten, incluido authz; no configura OpenTelemetry para el AWS Connector, wfx ni la UI. Las trazas se exportan por OTLP HTTP y los logs pueden dirigirse a un endpoint compatible, como VictoriaLogs. Usa un identificador de correlación y la misma ventana temporal para unir Gateway, servicio y dependencia.",{"_3602":72751,"_30987":72683,"_21467":120989,"_5":14750,"_28174":120827,"_3058":120990},[],"Antes de cerrar una incidencia, guarda:",{"_3602":72752,"_30987":72683,"_21467":120992,"_5":14750,"_28174":120827,"_3058":120993},[],"causa confirmada;",{"_3602":72753,"_30987":72683,"_21467":120995,"_5":14750,"_28174":120827,"_3058":120996},[],"alcance temporal y recursos afectados;",{"_3602":72754,"_30987":72683,"_21467":120998,"_5":14750,"_28174":120827,"_3058":120999},[],"comandos o consultas utilizados;",{"_3602":72755,"_30987":72683,"_21467":121001,"_5":14750,"_28174":120827,"_3058":121002},[],"cambio aplicado y forma de revertirlo;",{"_3602":72756,"_30987":72683,"_21467":121004,"_5":14750,"_28174":120827,"_3058":121005},[],"validación desde un consumidor;",{"_3602":72757,"_30987":72683,"_21467":121007,"_5":14750,"_28174":120827,"_3058":121008},[],"acción preventiva y propietario.",{"_3602":72758,"_30987":72758,"_5":15110,"_3058":121010,"_31325":121011,"_21467":121015,"_28174":72758},"Modelo de datos",[50623,121012,121013,121014],"Plataforma","Administración","Control de acceso",[],{"_3602":72759,"_30987":72758,"_21467":121017,"_5":14750,"_28174":72758,"_3058":121018},[],"Entidades y relaciones del esquema pki.json que utiliza authz para evaluar políticas de acceso.",{"_3602":72760,"_30987":72758,"_5":31322,"_21467":121020,"_28174":121021,"_3058":121022},[],"/docs/es/platform/administration/access-control/data-model#relaciones-del-esquema","Relaciones del esquema",{"_3602":72761,"_30987":72758,"_5":31322,"_21467":121024,"_28174":121025,"_3058":121026},[],"/docs/es/platform/administration/access-control/data-model#entidades-del-esquema","Entidades del esquema",{"_3602":72762,"_30987":72758,"_21467":121028,"_5":14750,"_28174":72758,"_3058":121029},[],"El esquema `connectors/authz/pki.json` define las entidades del dominio `pki` para el control de acceso. Una política identifica el tipo de recurso mediante `namespace: pki`, `schema_name` y `entity_type`. Por ejemplo, `ca.certificate` corresponde al esquema `ca` y al tipo de entidad `certificate`.",{"_3602":72763,"_30987":72758,"_21467":121031,"_5":14750,"_28174":121021,"_3058":121032},[],"Cada flecha sale de la entidad que declara la relación y apunta a su `target_entity`. Debajo de la etiqueta aparece el valor de `foreign_key`, la columna de origen. En `pki.json`, el `name` de cada relación coincide con esa columna. El diagrama se puede pulsar para ampliarlo y recorrerlo.",{"_3602":72764,"_30987":72758,"_21467":121034,"_5":14750,"_28174":121021,"_3058":121035},[],"Una política puede propagar acciones desde la entidad referenciada hacia la que declara la relación. Por ejemplo, para conceder lectura de los dispositivos de un DMS, la regla parte de `dmsmanager.dms`, apunta a `devicemanager.device` y especifica `via: dms_owner`.",{"_3602":72765,"_30987":72758,"_21467":121037,"_5":14750,"_28174":121021,"_3058":121038},[],"En los filtros de acceso heredado, `authz` compara la columna `foreign_key` con la primera columna de `primary_key` de la entidad referenciada. Así, `subject_common_name` se compara con `device.id`, `issuer_meta_serial_number` con `ca_certificate.id` y los enlaces hacia `kms_key` con `kms_key.key_id`.",{"_3602":72766,"_30987":72758,"_21467":121040,"_5":14750,"_28174":121025,"_3058":121041},[],"Entidad (`schema_name.entity_type`)",{"_3602":72767,"_30987":72758,"_21467":121043,"_5":14750,"_28174":121025,"_3058":121044},[],"Tabla (`table_name`)",{"_3602":72768,"_30987":72758,"_21467":121046,"_5":14750,"_28174":121025,"_3058":121047},[],"Clave (`primary_key`)",{"_3602":72769,"_30987":72758,"_21467":121049,"_5":14750,"_28174":121025,"_3058":52173},[],{"_3602":72770,"_30987":72758,"_21467":121051,"_5":14750,"_28174":121025,"_3058":52176},[],{"_3602":72771,"_30987":72758,"_21467":121053,"_5":14750,"_28174":121025,"_3058":52179},[],{"_3602":72772,"_30987":72758,"_21467":121055,"_5":14750,"_28174":121025,"_3058":52182},[],{"_3602":72773,"_30987":72758,"_21467":121057,"_5":14750,"_28174":121025,"_3058":52185},[],{"_3602":72774,"_30987":72758,"_21467":121059,"_5":14750,"_28174":121025,"_3058":52188},[],{"_3602":72775,"_30987":72758,"_21467":121061,"_5":14750,"_28174":121025,"_3058":52191},[],{"_3602":72776,"_30987":72758,"_21467":121063,"_5":14750,"_28174":121025,"_3058":52194},[],{"_3602":72777,"_30987":72758,"_21467":121065,"_5":14750,"_28174":121025,"_3058":52188},[],{"_3602":72778,"_30987":72758,"_21467":121067,"_5":14750,"_28174":121025,"_3058":52199},[],{"_3602":72779,"_30987":72758,"_21467":121069,"_5":14750,"_28174":121025,"_3058":52202},[],{"_3602":72780,"_30987":72758,"_21467":121071,"_5":14750,"_28174":121025,"_3058":52205},[],{"_3602":72781,"_30987":72758,"_21467":121073,"_5":14750,"_28174":121025,"_3058":52208},[],{"_3602":72782,"_30987":72758,"_21467":121075,"_5":14750,"_28174":121025,"_3058":52211},[],{"_3602":72783,"_30987":72758,"_21467":121077,"_5":14750,"_28174":121025,"_3058":52188},[],{"_3602":72784,"_30987":72758,"_21467":121079,"_5":14750,"_28174":121025,"_3058":52216},[],{"_3602":72785,"_30987":72758,"_21467":121081,"_5":14750,"_28174":121025,"_3058":52219},[],{"_3602":72786,"_30987":72758,"_21467":121083,"_5":14750,"_28174":121025,"_3058":52188},[],{"_3602":72787,"_30987":72758,"_21467":121085,"_5":14750,"_28174":121025,"_3058":52224},[],{"_3602":72788,"_30987":72758,"_21467":121087,"_5":14750,"_28174":121025,"_3058":52227},[],{"_3602":72789,"_30987":72758,"_21467":121089,"_5":14750,"_28174":121025,"_3058":52188},[],{"_3602":72790,"_30987":72758,"_21467":121091,"_5":14750,"_28174":121025,"_3058":52232},[],{"_3602":72791,"_30987":72758,"_21467":121093,"_5":14750,"_28174":121025,"_3058":52235},[],{"_3602":72792,"_30987":72758,"_21467":121095,"_5":14750,"_28174":121025,"_3058":52188},[],{"_3602":72793,"_30987":72758,"_21467":121097,"_5":14750,"_28174":121025,"_3058":52240},[],{"_3602":72794,"_30987":72758,"_21467":121099,"_5":14750,"_28174":121025,"_3058":52243},[],{"_3602":72795,"_30987":72758,"_21467":121101,"_5":14750,"_28174":121025,"_3058":52246},[],{"_3602":72796,"_30987":72758,"_21467":121103,"_5":14750,"_28174":121025,"_3058":52249},[],{"_3602":72797,"_30987":72758,"_21467":121105,"_5":14750,"_28174":121025,"_3058":52252},[],{"_3602":72798,"_30987":72758,"_21467":121107,"_5":14750,"_28174":121025,"_3058":52255},[],{"_3602":72799,"_30987":72758,"_21467":121109,"_5":14750,"_28174":121025,"_3058":121110},[],"Los eventos, las suscripciones y los grupos de dispositivos tienen acciones y filtros propios. Sus listas `relations` están vacías y tienen cero referencias entrantes en el esquema. Para `ca.certificate`, `view_tables` también registra `certificates_view`.",{"_3602":72800,"_30987":72758,"_21467":121112,"_5":14750,"_28174":121025,"_3058":121113},[],"Cada entidad declara sus acciones sobre instancias en `atomic_actions`, sus acciones sin identificador de recurso en `global_actions` y las columnas y tipos que admite en `column_filters` mediante `filterable`.",{"_3602":72801,"_30987":72758,"_21467":121115,"_5":14750,"_28174":121025,"_3058":121116},[],"<Card title=\"Acceso heredado por relaciones\" href=\"/docs/platform/administration/access-control#acceso-heredado-por-relaciones\" />",{"_3602":72802,"_30987":72802,"_5":15110,"_3058":121118,"_31325":121119,"_21467":121120,"_28174":72802},"Visión general del control de acceso",[50623,121012,121013,121014],[],{"_3602":72803,"_30987":72802,"_21467":121122,"_5":14750,"_28174":72802,"_3058":121123},[],"Diseña quién puede acceder a Lamassu mediante principales, políticas, permisos sobre recursos y autorización de rutas HTTP.",{"_3602":72804,"_30987":72802,"_5":31322,"_21467":121125,"_28174":121126,"_3058":121127},[],"/docs/es/platform/administration/access-control#conceptos-esenciales","Conceptos esenciales",{"_3602":72805,"_30987":72802,"_5":31322,"_21467":121129,"_28174":121130,"_3058":121131},[],"/docs/es/platform/administration/access-control#dos-sistemas-de-decisión","Dos sistemas de decisión",{"_3602":72806,"_30987":72802,"_5":31322,"_21467":121133,"_28174":121134,"_3058":121135},[],"/docs/es/platform/administration/access-control#servicios-http-integrados-o-externos","Servicios HTTP integrados o externos",{"_3602":72807,"_30987":72802,"_5":31322,"_21467":121137,"_28174":121138,"_3058":121139},[],"/docs/es/platform/administration/access-control#rutas-solo-de-autenticación-y-rutas-no-mapeadas","Rutas solo de autenticación y rutas no mapeadas",{"_3602":72808,"_30987":72802,"_5":31322,"_21467":121141,"_28174":121142,"_3058":121143},[],"/docs/es/platform/administration/access-control#servicios-desarrollados-por-lamassu","Servicios desarrollados por Lamassu",{"_3602":72809,"_30987":72802,"_5":31322,"_21467":121145,"_28174":121146,"_3058":121147},[],"/docs/es/platform/administration/access-control#cómo-se-relacionan-ambos-caminos","Cómo se relacionan ambos caminos",{"_3602":72810,"_30987":72802,"_5":31322,"_21467":121149,"_28174":121150,"_3058":121151},[],"/docs/es/platform/administration/access-control#principales-oidc","Principales OIDC",{"_3602":72811,"_30987":72802,"_5":31322,"_21467":121153,"_28174":121154,"_3058":121155},[],"/docs/es/platform/administration/access-control#principales-x509","Principales X.509",{"_3602":72812,"_30987":72802,"_5":31322,"_21467":121157,"_28174":121158,"_3058":121159},[],"/docs/es/platform/administration/access-control#cuando-coinciden-varios-principales","Cuando coinciden varios principales",{"_3602":72813,"_30987":72802,"_5":31322,"_21467":121161,"_28174":121162,"_3058":121163},[],"/docs/es/platform/administration/access-control#cómo-expresan-acceso-las-políticas","Cómo expresan acceso las políticas",{"_3602":72814,"_30987":72802,"_5":31322,"_21467":121165,"_28174":121166,"_3058":121167},[],"/docs/es/platform/administration/access-control#acceso-global-y-acceso-directo","Acceso global y acceso directo",{"_3602":72815,"_30987":72802,"_5":31322,"_21467":121169,"_28174":121170,"_3058":121171},[],"/docs/es/platform/administration/access-control#acceso-heredado-por-relaciones","Acceso heredado por relaciones",{"_3602":72816,"_30987":72802,"_5":31322,"_21467":121173,"_28174":121174,"_3058":121175},[],"/docs/es/platform/administration/access-control#acceso-filtrado-por-atributos","Acceso filtrado por atributos",{"_3602":72817,"_30987":72802,"_5":31322,"_21467":121177,"_28174":121178,"_3058":121179},[],"/docs/es/platform/administration/access-control#reglas-http","Reglas HTTP",{"_3602":72818,"_30987":72802,"_5":31322,"_21467":121181,"_28174":121182,"_3058":121183},[],"/docs/es/platform/administration/access-control#políticas-incluidas","Políticas incluidas",{"_3602":72819,"_30987":72802,"_5":31322,"_21467":121185,"_28174":121186,"_3058":120153},[],"/docs/es/platform/administration/access-control#provisiona-el-primer-administrador",{"_3602":72820,"_30987":72802,"_5":31322,"_21467":121188,"_28174":121189,"_3058":121190},[],"/docs/es/platform/administration/access-control#prepara-el-proveedor-de-identidad","Prepara el proveedor de identidad",{"_3602":72821,"_30987":72802,"_5":31322,"_21467":121192,"_28174":121193,"_3058":121194},[],"/docs/es/platform/administration/access-control#configura-la-validación-de-tokens","Configura la validación de tokens",{"_3602":72822,"_30987":72802,"_5":31322,"_21467":121196,"_28174":121197,"_3058":121198},[],"/docs/es/platform/administration/access-control#instala-y-verifica-el-acceso-administrativo","Instala y verifica el acceso administrativo",{"_3602":72823,"_30987":72802,"_5":31322,"_21467":121200,"_28174":121201,"_3058":121202},[],"/docs/es/platform/administration/access-control#prueba-una-identidad-sin-privilegios","Prueba una identidad sin privilegios",{"_3602":72824,"_30987":72802,"_5":31322,"_21467":121204,"_28174":121205,"_3058":121206},[],"/docs/es/platform/administration/access-control#reduce-el-uso-del-administrador-de-bootstrap","Reduce el uso del administrador de bootstrap",{"_3602":72825,"_30987":72802,"_5":31322,"_21467":121208,"_28174":121209,"_3058":121210},[],"/docs/es/platform/administration/access-control#bootstrap-de-fastlane","Bootstrap de Fastlane",{"_3602":72826,"_30987":72802,"_5":31322,"_21467":121212,"_28174":121213,"_3058":121214},[],"/docs/es/platform/administration/access-control#diseña-roles-de-mínimo-privilegio","Diseña roles de mínimo privilegio",{"_3602":72827,"_30987":72802,"_5":31322,"_21467":121216,"_28174":121217,"_3058":121218},[],"/docs/es/platform/administration/access-control#cambios-y-revocación-de-acceso","Cambios y revocación de acceso",{"_3602":72828,"_30987":72802,"_5":31322,"_21467":121220,"_28174":121221,"_3058":121222},[],"/docs/es/platform/administration/access-control#lista-de-comprobación-operativa","Lista de comprobación operativa",{"_3602":72829,"_30987":72802,"_5":31322,"_21467":121224,"_28174":121225,"_3058":121226},[],"/docs/es/platform/administration/access-control#diagnóstico","Diagnóstico",{"_3602":72830,"_30987":72802,"_5":31322,"_21467":121228,"_28174":121229,"_3058":121230},[],"/docs/es/platform/administration/access-control#la-respuesta-es-401","La respuesta es 401",{"_3602":72831,"_30987":72802,"_5":31322,"_21467":121232,"_28174":121233,"_3058":121234},[],"/docs/es/platform/administration/access-control#la-respuesta-es-403","La respuesta es 403",{"_3602":72832,"_30987":72802,"_5":31322,"_21467":121236,"_28174":121237,"_3058":121238},[],"/docs/es/platform/administration/access-control#todo-devuelve-403","Todo devuelve 403",{"_3602":72833,"_30987":72802,"_5":31322,"_21467":121240,"_28174":121241,"_3058":121242},[],"/docs/es/platform/administration/access-control#aparece-acceso-sin-política-concedida","Aparece acceso sin política concedida",{"_3602":72834,"_30987":72802,"_5":31322,"_21467":121244,"_28174":121245,"_3058":121246},[],"/docs/es/platform/administration/access-control#todo-falla-cuando-authz-no-está-disponible","Todo falla cuando authz no está disponible",{"_3602":72835,"_30987":72802,"_21467":121248,"_5":14750,"_28174":72802,"_3058":121249},[],"El control de acceso de Lamassu transforma una identidad autenticada en permisos concretos. El proveedor OIDC o el certificado cliente demuestra **quién** realiza una petición; el servicio `authz` decide **qué puede hacer** esa identidad y **sobre qué recursos**.",{"_3602":72836,"_30987":72802,"_21467":121251,"_5":14750,"_28174":72802,"_3058":121252},[],"Lamassu no asigna permisos directamente a usuarios. La cadena completa es:",{"_3602":72837,"_30987":72802,"_21467":121254,"_5":14750,"_28174":72802,"_3058":121255},[],"Este modelo permite representar personas, grupos del proveedor de identidad, cuentas de servicio y dispositivos sin acoplar la autorización a un proveedor concreto.",{"_3602":72838,"_30987":72802,"_21467":121257,"_5":14750,"_28174":121126,"_3058":121258},[],"Un **principal** conecta una credencial con Lamassu. Define cómo reconocer una identidad OIDC o X.509 y puede estar activo o desactivado.",{"_3602":72839,"_30987":72802,"_21467":121260,"_5":14750,"_28174":121126,"_3058":121261},[],"Una **política** agrupa permisos reutilizables. Puede concederse a varios principales y puede contener reglas sobre entidades de Lamassu, reglas sobre rutas HTTP o ambas.",{"_3602":72840,"_30987":72802,"_21467":121263,"_5":14750,"_28174":121126,"_3058":121264},[],"Una **regla de entidad** concede acciones sobre recursos como autoridades certificadoras, certificados, perfiles de emisión, dispositivos, DMS, claves o suscripciones de alertas. Puede abarcar todos los recursos de un tipo o limitarse por identificador, relación o atributo.",{"_3602":72841,"_30987":72802,"_21467":121266,"_5":14750,"_28174":121126,"_3058":121267},[],"Una **regla HTTP** concede acciones asociadas a rutas de una API. Es el mecanismo que utiliza el Gateway para decidir si una petición puede atravesar el perímetro.",{"_3602":72842,"_30987":72802,"_21467":121269,"_5":14750,"_28174":121126,"_3058":121270},[],"Un **grant** es la asociación entre un principal y una política. Quitar el grant elimina todos los permisos aportados por esa política, sin modificarla para los demás principales.",{"_3602":72843,"_30987":72802,"_21467":121272,"_5":14750,"_28174":121126,"_3058":121273},[],"Un JWT válido o un certificado cliente válido no concede acceso por sí mismo. La credencial debe coincidir con al menos un principal activo y, salvo que el esquema HTTP exima la ruta, alguna de sus políticas debe permitir la operación solicitada. Consulta *Rutas solo de autenticación y rutas no mapeadas* para esas excepciones.",{"_3602":72844,"_30987":72802,"_21467":121275,"_5":14750,"_28174":121130,"_3058":121276},[],"Lamassu utiliza dos caminos de autorización según quién implementa el servicio protegido. Comparten principales, políticas y grants, pero no interpretan las reglas de la misma manera.",{"_3602":72845,"_30987":72802,"_21467":121278,"_5":14750,"_28174":121130,"_3058":121279},[],"Un servicio externo puede quedar protegido sin conocer el modelo interno de autorización de Lamassu. Un servicio desarrollado por Lamassu integra el motor de autorización y puede decidir sobre recursos concretos y filtrar sus consultas.",{"_3602":72846,"_30987":72802,"_21467":121281,"_5":14750,"_28174":121134,"_3058":121282},[],"Este camino protege APIs que se incorporan a la plataforma a través del Gateway pero que no implementan de forma nativa el SDK de autorización de Lamassu. Job Manager es el ejemplo actual. El mismo patrón permite integrar otros servicios HTTP siempre que sus rutas estén descritas en un esquema HTTP de `authz`.",{"_3602":72847,"_30987":72802,"_21467":121284,"_5":14750,"_28174":121134,"_3058":121285},[],"La decisión se toma **antes de reenviar la petición al servicio**:",{"_3602":72848,"_30987":72802,"_21467":121287,"_5":14750,"_28174":121134,"_3058":121288},[],"Envoy Gateway autentica la petición, normalmente validando un JWT contra el JWKS del proveedor OIDC.",{"_3602":72849,"_30987":72802,"_21467":121290,"_5":14750,"_28174":121134,"_3058":121291},[],"Para una ruta protegida, Envoy envía el método, la URL, las cabeceras y los datos necesarios a `/v1/ext_authz/check`.",{"_3602":72850,"_30987":72802,"_21467":121293,"_5":14750,"_28174":121134,"_3058":121294},[],"`authz` extrae la credencial y resuelve todos los principales activos que coinciden con ella.",{"_3602":72851,"_30987":72802,"_21467":121296,"_5":14750,"_28174":121134,"_3058":121297},[],"Carga por separado las políticas concedidas a cada principal.",{"_3602":72852,"_30987":72802,"_21467":121299,"_5":14750,"_28174":121134,"_3058":121300},[],"El esquema HTTP traduce la combinación de método y ruta a una acción lógica, como `nbi-job-read` o `nbi-workflow-create`.",{"_3602":72853,"_30987":72802,"_21467":121302,"_5":14750,"_28174":121134,"_3058":121303},[],"`authz` busca una regla HTTP que conceda esa acción.",{"_3602":72854,"_30987":72802,"_21467":121305,"_5":14750,"_28174":121134,"_3058":121306},[],"Si la ruta declara restricciones, compara datos de la petición con los atributos normalizados del mismo principal que aporta la política; los `param_constraints` de la propia política también fijan la acción concedida a valores literales de la petición.",{"_3602":72855,"_30987":72802,"_21467":121308,"_5":14750,"_28174":121134,"_3058":121309},[],"Un resultado satisfactorio permite a Envoy reenviar la petición; cualquier otra respuesta la bloquea en el Gateway.",{"_3602":72856,"_30987":72802,"_21467":121311,"_5":14750,"_28174":121134,"_3058":121312},[],"Cuando permite el acceso, `authz` devuelve el principal seleccionado en la cabecera de respuesta `X-Principal-ID`. El Gateway puede propagar esa cabecera al servicio para conservar el contexto de identidad. Los clientes no pueden falsificarla: el Gateway elimina la cabecera `X-Principal-Id` suministrada por el cliente (y las demás cabeceras de identidad y certificado reenviadas) antes de reenviar, de modo que solo `authz` puede establecerla. Consulta Expón el Gateway para ver la lista completa de cabeceras eliminadas.",{"_3602":72857,"_30987":72802,"_21467":121314,"_5":14750,"_28174":121134,"_3058":121315},[],"Las reglas HTTP responden principalmente a &#x2A;*“¿puede esta identidad llamar a esta operación de la API?”**. Por sí solas no generan filtros sobre la base de datos del servicio externo. Para limitar una ruta a un dispositivo, tenant o cliente concreto, o bien el esquema declara una restricción que relaciona un valor de la petición con un atributo normalizado del principal, o bien la política fija ese valor de la petición a un literal con `param_constraints`. Lo primero limita cada identidad a sus propios recursos con un único grant; lo segundo restringe un grant a un valor fijo, sin importar quién lo posea.",{"_3602":72858,"_30987":72802,"_21467":121317,"_5":14750,"_28174":121138,"_3058":121318},[],"Dos ajustes del propio esquema cubren endpoints que las políticas no mencionan:",{"_3602":72859,"_30987":72802,"_21467":121320,"_5":14750,"_28174":121138,"_3058":121321},[],"**`skip_authz: true` en una ruta** permite alcanzarla a cualquier identidad que coincida con un principal activo, aunque no tenga políticas concedidas. Úsalo para rutas como `/openapi.json` o `/health` que todo cliente autenticado debería poder consultar. La petición sigue necesitando una autenticación válida: una credencial que no supera la validación o no coincide con ningún principal activo se rechaza antes de considerar este ajuste. Una ruta con `skip_authz` no puede declarar restricciones, y prevalece sobre la ruta o la acción por defecto de cualquier otro esquema para la misma petición.",{"_3602":72860,"_30987":72802,"_21467":121323,"_5":14750,"_28174":121138,"_3058":121324},[],"**`default_action` con `base_paths`** decide qué ocurre cuando una petición cae bajo un prefijo de ruta que el esquema posee pero ninguna ruta explícita coincide. `deny` — el valor con el que se entrega el esquema del Job Manager — convierte la denegación implícita de las rutas no mapeadas en una declaración explícita y auditable; `allow` abre los endpoints no mapeados bajo ese prefijo a cualquier identidad que coincida con un principal activo.",{"_3602":72861,"_30987":72802,"_21467":121326,"_5":14750,"_28174":121138,"_3058":121327},[],"Son decisiones del esquema, no de una política: `skip_authz` elimina la comprobación del grant para esa ruta, incluso cuando otro esquema asigna la misma petición a una acción que exige un grant, y `default_action` solo cubre las peticiones que ninguna ruta explícita de ningún esquema cubre. Ten en cuenta tres reglas:",{"_3602":72862,"_30987":72802,"_21467":121329,"_5":14750,"_28174":121138,"_3058":121330},[],"`default_action` exige al menos una entrada en `base_paths`, y las rutas base son rutas absolutas como `/api/wfx/nbi/v1`.",{"_3602":72863,"_30987":72802,"_21467":121332,"_5":14750,"_28174":121138,"_3058":121333},[],"Una ruta explícita de cualquier esquema tiene prioridad: la acción por defecto solo decide peticiones que ninguna ruta de ningún esquema cubre. Cuando los prefijos de dos esquemas se solapan, decide el prefijo coincidente más largo.",{"_3602":72864,"_30987":72802,"_21467":121335,"_5":14750,"_28174":121138,"_3058":121336},[],"Dos esquemas no pueden reclamar la misma ruta base con acciones por defecto distintas; el esquema en conflicto no llega a cargar.",{"_3602":72865,"_30987":72802,"_21467":121338,"_5":14750,"_28174":121138,"_3058":121339},[],"Una ruta con `skip_authz` y un prefijo con `default_action: \"allow\"` conceden acceso sin consultar ninguna política. Cualquier identidad que coincida con un principal activo puede alcanzar lo que abran, incluidas las identidades sin políticas concedidas. Una ruta con `skip_authz` en un esquema también abre una petición que otro esquema asigna a una acción protegida por un grant. Revisa estos ajustes cada vez que integres o actualices un servicio.",{"_3602":72866,"_30987":72802,"_21467":121341,"_5":14750,"_28174":121138,"_3058":121342},[],"Un esquema también puede hacer que una ruta individual acepte la credencial por la URL. **`query_token: true` en una ruta** hace que acepte el token de acceso OIDC del parámetro de consulta `access_token`, pero solo cuando la petición no lleva ni una cabecera `Authorization: Bearer` ni una cabecera de certificado de cliente: la credencial en una cabecera siempre prevalece. El token se valida y autoriza exactamente igual que un token Bearer, así que la acción de la ruta sigue exigiendo un grant, y las rutas que no activan esta opción nunca leen el parámetro de consulta. La terminal experimental del dashboard usa este mecanismo, porque la conexión WebSocket que abre su cliente de navegador no puede establecer cabeceras de petición.",{"_3602":72867,"_30987":72802,"_21467":121344,"_5":14750,"_28174":121138,"_3058":121345},[],"Las cadenas de consulta suelen quedar registradas. `authz` sustituye el valor de `access_token` por `REDACTED` en sus propios logs de decisión, pero otros logs que capturan la URL —el access log del Gateway, los logs de petición de los servicios, el tracing— no la redactan. Reserva `query_token` para rutas WebSocket y tokens de corta duración.",{"_3602":72868,"_30987":72802,"_21467":121347,"_5":14750,"_28174":121142,"_3058":121348},[],"Los servicios nativos de Lamassu integran autorización en su middleware y conocen las entidades sobre las que operan: certificados, CAs, perfiles de emisión, claves, dispositivos, DMS o suscripciones, entre otras.",{"_3602":72869,"_30987":72802,"_21467":121350,"_5":14750,"_28174":121142,"_3058":121351},[],"La decisión se toma con el contexto de la operación de dominio:",{"_3602":72870,"_30987":72802,"_21467":121353,"_5":14750,"_28174":121142,"_3058":121354},[],"El middleware extrae la credencial y resuelve los principales coincidentes.",{"_3602":72871,"_30987":72802,"_21467":121356,"_5":14750,"_28174":121142,"_3058":121357},[],"El endpoint identifica la acción, el tipo de entidad y, cuando corresponde, la clave del recurso solicitado.",{"_3602":72872,"_30987":72802,"_21467":121359,"_5":14750,"_28174":121142,"_3058":121360},[],"`authz` reúne las reglas de entidad de las políticas concedidas.",{"_3602":72873,"_30987":72802,"_21467":121362,"_5":14750,"_28174":121142,"_3058":121363},[],"El motor evalúa grants directos, filtros por atributos y relaciones con otras entidades.",{"_3602":72874,"_30987":72802,"_21467":121365,"_5":14750,"_28174":121142,"_3058":121366},[],"Para una operación individual, comprueba que el recurso concreto satisface el alcance calculado.",{"_3602":72875,"_30987":72802,"_21467":121368,"_5":14750,"_28174":121142,"_3058":121369},[],"Para un listado, genera un filtro SQL que el servicio añade a su propia consulta.",{"_3602":72876,"_30987":72802,"_21467":121371,"_5":14750,"_28174":121142,"_3058":121372},[],"Aquí el motor responde a &#x2A;*“¿puede esta identidad realizar esta acción sobre este recurso concreto?”**.",{"_3602":72877,"_30987":72802,"_21467":121374,"_5":14750,"_28174":121142,"_3058":121375},[],"Las acciones se dividen en dos grupos:",{"_3602":72878,"_30987":72802,"_21467":121377,"_5":14750,"_28174":121142,"_3058":121378},[],"Las **acciones globales** no necesitan un identificador de recurso. `create`, `import` o el acceso a una sección de la interfaz son ejemplos habituales.",{"_3602":72879,"_30987":72802,"_21467":121380,"_5":14750,"_28174":121142,"_3058":121381},[],"Las **acciones atómicas** se evalúan sobre una instancia concreta. En certificados aparecen `read`, `metadata-update`, `status-update` y `delete`; para una CA también existen `sign`, `reissue` y otras operaciones de ciclo de vida.",{"_3602":72880,"_30987":72802,"_21467":121383,"_5":14750,"_28174":121142,"_3058":121384},[],"El filtrado dentro del servicio evita fugas en listados: los recursos no autorizados quedan fuera de la consulta SQL en lugar de recuperarse y ocultarse después en la interfaz.",{"_3602":72881,"_30987":72802,"_21467":121386,"_5":14750,"_28174":121146,"_3058":121387},[],"No son dos controles equivalentes aplicados dos veces. Las reglas HTTP protegen el perímetro de un servicio integrado; las reglas de entidad expresan permisos sobre el modelo de datos de los servicios nativos.",{"_3602":72882,"_30987":72802,"_21467":121389,"_5":14750,"_28174":121146,"_3058":121390},[],"Una política puede contener ambos tipos de reglas cuando una identidad necesita operar recursos de Lamassu y también llamar a una API integrada. Conceder una regla de entidad no concede automáticamente una acción HTTP, ni una regla HTTP crea acceso sobre una entidad.",{"_3602":72883,"_30987":72802,"_21467":121392,"_5":14750,"_28174":121146,"_3058":121393},[],"Si ninguna combinación de principal, política y regla permite la operación, Lamassu la deniega, salvo que el esquema HTTP declare `skip_authz` en la ruta o `default_action: allow` en una ruta base que la cubra (consulta *Rutas solo de autenticación y rutas no mapeadas*). Además, `auth.externalAuthorization.failOpen` vale `false` por defecto: si `authz` no está disponible, el Gateway bloquea las rutas protegidas.",{"_3602":72884,"_30987":72802,"_21467":121395,"_5":14750,"_28174":121150,"_3058":121396},[],"Un principal OIDC coincide con los claims de un JWT validado. Es apropiado para usuarios humanos, grupos corporativos, roles del IdP y cuentas de servicio que obtienen tokens.",{"_3602":72885,"_30987":72802,"_21467":121398,"_5":14750,"_28174":121150,"_3058":121399},[],"El siguiente principal representa a cualquier identidad que tenga el rol `pki-operators` en Keycloak:",{"_3602":72886,"_30987":72802,"_21467":121401,"_5":14750,"_28174":121150,"_3058":121402},[],"Las rutas de claims pueden estar anidadas, como `realm_access.roles`. Dentro de un mismo principal, **todas** las condiciones deben cumplirse. Esto permite exigir, por ejemplo, un grupo y una audiencia organizativa a la vez.",{"_3602":72887,"_30987":72802,"_21467":121404,"_5":14750,"_28174":121150,"_3058":121405},[],"Los operadores implementados son:",{"_3602":72888,"_30987":72802,"_21467":121407,"_5":14750,"_28174":121150,"_3058":121408},[],"`equals`, para igualdad exacta;",{"_3602":72889,"_30987":72802,"_21467":121410,"_5":14750,"_28174":121150,"_3058":121411},[],"`contains`, para comprobar la pertenencia a una lista o la presencia de texto en un valor escalar.",{"_3602":72890,"_30987":72802,"_21467":121413,"_5":14750,"_28174":121150,"_3058":121414},[],"Diseña la coincidencia con atributos estables. Para personas, suele ser mejor enlazar permisos a grupos o roles gestionados centralmente que al correo o al nombre de usuario. Para una cuenta de servicio, un `sub` estable evita que sus permisos se mezclen con los de un operador humano.",{"_3602":72891,"_30987":72802,"_21467":121416,"_5":14750,"_28174":121150,"_3058":121417},[],"Aunque el modelo reconoce el nombre de operador `matches`, la implementación actual no evalúa expresiones regulares y la condición nunca coincide. Usa `equals` o `contains`.",{"_3602":72892,"_30987":72802,"_21467":121419,"_5":14750,"_28174":121154,"_3058":121420},[],"Un principal X.509 permite reconocer una carga de trabajo o un dispositivo mediante su certificado cliente. Lamassu comprueba la firma del certificado contra la CA configurada y, según el modo, también su número de serie o Common Name.",{"_3602":72893,"_30987":72802,"_21467":121422,"_5":14750,"_28174":121154,"_3058":121423},[],"Los modos disponibles son:",{"_3602":72894,"_30987":72802,"_21467":121425,"_5":14750,"_28174":121154,"_3058":121426},[],"`serial_and_ca`: un certificado exacto, identificado por número de serie y CA;",{"_3602":72895,"_30987":72802,"_21467":121428,"_5":14750,"_28174":121154,"_3058":121429},[],"`cn_and_ca`: un Common Name exacto o con comodines y una CA concreta;",{"_3602":72896,"_30987":72802,"_21467":121431,"_5":14750,"_28174":121154,"_3058":121432},[],"`any_from_ca`: cualquier certificado emitido directamente por la CA indicada.",{"_3602":72897,"_30987":72802,"_21467":121434,"_5":14750,"_28174":121154,"_3058":121435},[],"Este ejemplo reconoce certificados cuyo CN comienza por `factory-a-` y que están firmados por la CA configurada:",{"_3602":72898,"_30987":72802,"_21467":121437,"_5":14750,"_28174":121154,"_3058":121438},[],"`ca_trust.identity_type` acepta `fingerprint` o `authority_key_id`. En ambos casos debes aportar el certificado de la CA en `ca_trust.pem`; Lamassu verifica tanto la firma como la identidad esperada de la CA.",{"_3602":72899,"_30987":72802,"_21467":121440,"_5":14750,"_28174":121154,"_3058":121441},[],"Usa `any_from_ca` únicamente cuando todas las identidades emitidas por esa CA deban compartir los mismos permisos. Si una CA emite certificados para poblaciones distintas, separa el acceso por serie o CN, o utiliza CAs de emisión diferentes.",{"_3602":72900,"_30987":72802,"_21467":121443,"_5":14750,"_28174":121158,"_3058":121444},[],"Una misma credencial puede coincidir con más de un principal. Es habitual que un usuario coincida con un principal de su equipo y con otro de su función operativa.",{"_3602":72901,"_30987":72802,"_21467":121446,"_5":14750,"_28174":121158,"_3058":121447},[],"Para permisos de entidad, Lamassu combina los permisos con lógica OR: basta con que una de las políticas de uno de los principales permita la acción. Los listados contienen la unión de los recursos visibles para todos ellos.",{"_3602":72902,"_30987":72802,"_21467":121449,"_5":14750,"_28174":121158,"_3058":121450},[],"Las rutas HTTP con restricciones son más estrictas. El mismo principal que aporta la política debe satisfacer también los atributos exigidos por la ruta. Lamassu no combina la política de un principal con un atributo perteneciente a otro.",{"_3602":72903,"_30987":72802,"_21467":121452,"_5":14750,"_28174":121158,"_3058":121453},[],"Por esta razón, añadir un principal coincidente solo puede ampliar el acceso. Antes de crear reglas solapadas, revisa el conjunto completo de políticas que recibirá una identidad real.",{"_3602":72904,"_30987":72802,"_21467":121455,"_5":14750,"_28174":121166,"_3058":121456},[],"Una regla identifica el dominio (`namespace`), el esquema de datos (`schema_name`) y el tipo de entidad (`entity_type`). `actions` enumera las operaciones permitidas.",{"_3602":72905,"_30987":72802,"_21467":121458,"_5":14750,"_28174":121166,"_3058":121459},[],"`direct_grants` limita la regla a identificadores concretos. El valor `*` abarca todas las instancias del tipo. Una política de superadministrador utiliza comodines en esquema, entidad, acciones y grants; una política de mínimo privilegio debe evitarlos siempre que sea posible.",{"_3602":72906,"_30987":72802,"_21467":121461,"_5":14750,"_28174":121170,"_3058":121462},[],"Las reglas pueden seguir relaciones declaradas entre entidades. Por ejemplo, el esquema conoce la relación de un certificado con su CA emisora, la de un dispositivo con su DMS y la de un certificado con la clave KMS que almacena su clave privada, de modo que un grant sobre la clave también cubre los certificados que la utilizan. Una política puede conceder acceso a un recurso padre y propagar acciones seleccionadas hacia sus recursos relacionados.",{"_3602":72907,"_30987":72802,"_21467":121464,"_5":14750,"_28174":121170,"_3058":121465},[],"Esto permite expresar modelos como “puede operar los dispositivos de este DMS” sin mantener una lista individual de cada dispositivo. Cuando se añade un recurso bajo esa relación, hereda el alcance previsto por la política.",{"_3602":72908,"_30987":72802,"_21467":121467,"_5":14750,"_28174":121170,"_3058":121468},[],"El modelo de datos muestra cómo se conectan los recursos sobre los que se aplican las reglas de entidad.",{"_3602":72909,"_30987":72802,"_21467":121470,"_5":14750,"_28174":121170,"_3058":121471},[],"Una regla solo puede seguir relaciones que el esquema de datos declare entre sus dos entidades. Puedes referenciar la relación por su nombre o por su columna de clave foránea —ambas formas son equivalentes— y es el esquema el que decide qué columna utiliza la consulta. Al guardar una política, `authz` comprueba cada relación contra los esquemas cargados: una que ningún esquema declare, o que apunte a una entidad no cargada, se rechaza en ese momento.",{"_3602":72910,"_30987":72802,"_21467":121473,"_5":14750,"_28174":121170,"_3058":121474},[],"Las políticas almacenadas antes de esta validación pueden contener todavía relaciones que los esquemas no declaran. Esa relación no concede nada: `authz` registra una advertencia, `skipping relation that grants nothing`, indicando la política y la relación, y continúa evaluando el resto de la política. La referencia siempre se resuelve contra el esquema antes de construir cualquier consulta, por lo que una relación no declarada nunca puede alterarla. Si el acceso heredado se reduce tras una actualización, busca esta advertencia en los logs de `authz` y corrige la relación de la política afectada.",{"_3602":72911,"_30987":72802,"_21467":121476,"_5":14750,"_28174":121174,"_3058":121477},[],"`column_filters` aplica condiciones a columnas que el esquema haya declarado como filtrables. Todos los filtros de una misma regla se combinan con AND.",{"_3602":72912,"_30987":72802,"_21467":121479,"_5":14750,"_28174":121174,"_3058":121480},[],"Por ejemplo, esta regla permite leer certificados activos emitidos por una CA concreta:",{"_3602":72913,"_30987":72802,"_21467":121482,"_5":14750,"_28174":121174,"_3058":121483},[],"Los operadores disponibles son `eq`, `neq`, `gt`, `gte`, `lt`, `lte`, `in` y `like`. Usa comparaciones coherentes con el tipo de columna: `like` para texto, comparaciones de orden para números o fechas y `in` cuando haya una colección de valores aceptados.",{"_3602":72914,"_30987":72802,"_21467":121485,"_5":14750,"_28174":121178,"_3058":121486},[],"Las reglas HTTP no apuntan directamente a tablas. Referencian un esquema de rutas y conceden sus acciones lógicas. Las políticas del Job Manager son un ejemplo: distinguen lectura, creación, actualización y eliminación de workflows o jobs.",{"_3602":72915,"_30987":72802,"_21467":121488,"_5":14750,"_28174":121178,"_3058":121489},[],"Algunas rutas también comparan un valor de la petición —extraído de la ruta, query, cabecera o cuerpo JSON— con un atributo normalizado del principal. Así puede verificarse que un dispositivo solo consulte trabajos dirigidos a su propio `client_id`.",{"_3602":72916,"_30987":72802,"_21467":121491,"_5":14750,"_28174":121178,"_3058":121492},[],"Los atributos normalizados desacoplan la política del mecanismo de autenticación. `subject_attribute_mappings` puede derivar, por ejemplo, `device_id` desde `oidc.claim.device_id` o desde `x509.subject.cn`. La regla consume `device_id` en ambos casos.",{"_3602":72917,"_30987":72802,"_21467":121494,"_5":14750,"_28174":121178,"_3058":121495},[],"Una regla HTTP también puede fijar una acción concedida a un valor literal que la propia petición transporte, mediante `param_constraints`. Extrae el valor con las mismas fuentes que las restricciones de ruta —`path_regex_group`, `query`, `header` o `json_body`— pero lo compara con un literal `equals` escrito en la política, no con un atributo del principal. El grant depende entonces solo de la petición, no de quién posea la política:",{"_3602":72918,"_30987":72802,"_21467":121497,"_5":14750,"_28174":121178,"_3058":121498},[],"Combinada con una ruta del esquema como `^/api/mysvc/system/([^/]+)/info$`, concede `GET /api/mysvc/system/1/info` y deniega la misma llamada para el sistema `2`, con independencia de los atributos del principal. El mismo mecanismo fija parámetros de query, cabeceras o campos del cuerpo JSON, por ejemplo `{ \"source\": \"query\", \"name\": \"tenant_id\" }` con `\"equals\": \"1\"` para aceptar solo peticiones que lleven `?tenant_id=1`.",{"_3602":72919,"_30987":72802,"_21467":121500,"_5":14750,"_28174":121178,"_3058":121501},[],"Ten en cuenta que:",{"_3602":72920,"_30987":72802,"_21467":121503,"_5":14750,"_28174":121178,"_3058":121504},[],"`action` debe estar entre las acciones concedidas por la regla; `equals` es obligatorio; `path_regex_group` necesita un `index` mayor que cero, `query` y `header` un `name`, y `json_body` un `path` como `$.tenant_id`.",{"_3602":72921,"_30987":72802,"_21467":121506,"_5":14750,"_28174":121178,"_3058":121507},[],"`param_constraints` no se coteja con el esquema al cargar la política. Una referencia que la ruta no puede satisfacer —por ejemplo, un `path_regex_group` sobre una ruta sin grupos de captura— simplemente nunca coincide y la petición se deniega.",{"_3602":72922,"_30987":72802,"_21467":121509,"_5":14750,"_28174":121178,"_3058":121510},[],"Varios `param_constraints` para la misma acción se combinan con AND. Una regla sin ellos conserva el comportamiento habitual: la acción se concede donde la ruta coincida y las restricciones del principal se cumplan.",{"_3602":72923,"_30987":72802,"_21467":121512,"_5":14750,"_28174":121182,"_3058":121513},[],"La precarga de `authz` instala políticas reutilizables para los dominios principales. Entre ellas se encuentran:",{"_3602":72924,"_30987":72802,"_21467":121515,"_5":14750,"_28174":121182,"_3058":121516},[],"acceso completo y de solo lectura a certificados y autoridades;",{"_3602":72925,"_30987":72802,"_21467":121518,"_5":14750,"_28174":121182,"_3058":121519},[],"acceso completo y de solo lectura a KMS;",{"_3602":72926,"_30987":72802,"_21467":121521,"_5":14750,"_28174":121182,"_3058":121522},[],"acceso completo y de solo lectura a Device Manager, DMS Manager, Validation Authority y alertas;",{"_3602":72927,"_30987":72802,"_21467":121524,"_5":14750,"_28174":121182,"_3058":121525},[],"una política `Auditor` de lectura de PKI y visibilidad de autorización;",{"_3602":72928,"_30987":72802,"_21467":121527,"_5":14750,"_28174":121182,"_3058":121528},[],"acceso a la interfaz;",{"_3602":72929,"_30987":72802,"_21467":121530,"_5":14750,"_28174":121182,"_3058":121531},[],"políticas de administración y observación para las APIs NBI y SBI del Job Manager;",{"_3602":72930,"_30987":72802,"_21467":121533,"_5":14750,"_28174":121182,"_3058":121534},[],"acceso a la terminal experimental del dashboard (Terminal Network);",{"_3602":72931,"_30987":72802,"_21467":121536,"_5":14750,"_28174":121182,"_3058":121537},[],"`SUPER ADMIN`, que concede todas las acciones sobre los dominios `authz` y `pki`.",{"_3602":72932,"_30987":72802,"_21467":121539,"_5":14750,"_28174":121182,"_3058":121540},[],"Empieza por estas políticas antes de crear otras. Si ninguna refleja el límite que necesitas, crea una política específica y pequeña en lugar de copiar `SUPER ADMIN` y retirar permisos de forma informal.",{"_3602":72933,"_30987":72802,"_21467":121542,"_5":14750,"_28174":121182,"_3058":121543},[],"La política de Terminal Network la crea la precarga de `authz` la próxima vez que `authz` arranque tras la actualización. Las políticas precargadas son políticas del sistema —sus identificadores empiezan por `lamassu.`— y no se pueden editar a través de la API.",{"_3602":72934,"_30987":72802,"_21467":121545,"_5":14750,"_28174":121186,"_3058":121546},[],"Una instalación sin un principal que coincida con tu identidad queda sin nadie capaz de administrar la autorización. Configura el IdP y el bootstrap antes de exponer la plataforma.",{"_3602":72935,"_30987":72802,"_21467":121548,"_5":14750,"_28174":121186,"_3058":121549},[],"El chart incluye un principal de bootstrap que busca el rol OIDC `pki-admin` en `realm_access.roles`. Le concede `SUPER ADMIN` y, cuando Job Manager está habilitado, la política administrativa de su API NBI.",{"_3602":72936,"_30987":72802,"_21467":121551,"_5":14750,"_28174":121186,"_3058":121552},[],"El Job Helm de preinstalación y preactualización ejecuta las migraciones de `authz`, precarga las políticas y crea los principales de bootstrap antes de iniciar los servicios. Si el principal ya existe, no lo reemplaza: añade únicamente los grants configurados que todavía falten. Puedes conservar la entrada en `values.yaml` durante las actualizaciones.",{"_3602":72937,"_30987":72802,"_21467":121554,"_5":14750,"_28174":121189,"_3058":121555},[],"Crea el rol o grupo que utilizarás para recuperar y administrar Lamassu. Asígnalo al menos a dos identidades humanas controladas. Si tu proveedor no usa `realm_access.roles`, adapta la ruta del claim tanto en el frontend como en `auth_config.claims`.",{"_3602":72938,"_30987":72802,"_21467":121557,"_5":14750,"_28174":121193,"_3058":121558},[],"`authz` valida cada token contra `services.authz.jwkUrl`, que se consulta desde el pod de `authz`. El Gateway no valida los tokens por sí mismo: los servicios de Lamassu autorizan cada petición a través de `authz`, y las rutas con la etiqueta `auth=external`, como las de Job Manager, las comprueba el Gateway a través de `authz` cuando `auth.externalAuthorization` está habilitado. El endpoint debe servir las claves del emisor configurado en `auth.oidc.frontend.authority`.",{"_3602":72939,"_30987":72802,"_21467":121560,"_5":14750,"_28174":121193,"_3058":121561},[],"Las releases actualizadas desde 3.8.0 deben eliminar `auth.oidc.apiGateway` y `auth.authorization`, que el chart 4.0.0 rechaza. Consulta 3.8.0 a 4.0.0.",{"_3602":72940,"_30987":72802,"_21467":121563,"_5":14750,"_28174":121197,"_3058":121564},[],"Inicia sesión con una identidad que tenga `pki-admin`. Confirma que puede acceder a la administración de autorización y realizar una operación de lectura no destructiva.",{"_3602":72941,"_30987":72802,"_21467":121566,"_5":14750,"_28174":121201,"_3058":121567},[],"Usa un segundo usuario sin el rol y confirma que la misma operación queda denegada. Esta prueba detecta claims mal interpretados, políticas demasiado amplias y configuraciones `failOpen` accidentales.",{"_3602":72942,"_30987":72802,"_21467":121569,"_5":14750,"_28174":121205,"_3058":121570},[],"Crea principales operativos con políticas de menor alcance. Reserva `pki-admin` para administración de autorización y recuperación, no para el trabajo diario.",{"_3602":72943,"_30987":72802,"_21467":121572,"_5":14750,"_28174":121209,"_3058":121573},[],"Fastlane instala un realm de Keycloak para laboratorio y crea el usuario `lamassu` con contraseña temporal `lamassu`, rol `pki-admin` y cambio de contraseña obligatorio. Su principal de bootstrap coincide mediante `preferred_username=lamassu`.",{"_3602":72944,"_30987":72802,"_21467":121575,"_5":14750,"_28174":121209,"_3058":121576},[],"Cambia la contraseña en el primer acceso. No reutilices el usuario, la contraseña ni el IdP de Fastlane como diseño de producción.",{"_3602":72945,"_30987":72802,"_21467":121578,"_5":14750,"_28174":121213,"_3058":121579},[],"Evita reproducir la estructura interna de tu empresa con decenas de políticas casi idénticas. Empieza por las responsabilidades que realmente necesitan acceso:",{"_3602":72946,"_30987":72802,"_21467":121581,"_5":14750,"_28174":121213,"_3058":121582},[],"**Administración de autorización**: gestiona principales, políticas y grants. Debe pertenecer a un grupo pequeño y separado.",{"_3602":72947,"_30987":72802,"_21467":121584,"_5":14750,"_28174":121213,"_3058":121585},[],"**Operación de PKI**: administra CAs, perfiles y certificados, pero no necesariamente puede modificar quién obtiene acceso.",{"_3602":72948,"_30987":72802,"_21467":121587,"_5":14750,"_28174":121213,"_3058":121588},[],"**Registro de dispositivos**: opera dispositivos y DMS sin recibir permisos sobre claves o configuración de autorización.",{"_3602":72949,"_30987":72802,"_21467":121590,"_5":14750,"_28174":121213,"_3058":121591},[],"**Auditoría**: consulta configuración y actividad sin crear, modificar, firmar, revocar ni eliminar.",{"_3602":72950,"_30987":72802,"_21467":121593,"_5":14750,"_28174":121213,"_3058":121594},[],"**Automatización**: utiliza una cuenta técnica o certificado independiente, con permisos limitados al flujo y recursos que controla.",{"_3602":72951,"_30987":72802,"_21467":121596,"_5":14750,"_28174":121213,"_3058":121597},[],"Para cada rol, separa “ver” de “cambiar”, limita los recursos mediante grants, relaciones o atributos y evita `*` salvo que el rol deba abarcar futuras acciones automáticamente.",{"_3602":72952,"_30987":72802,"_21467":121599,"_5":14750,"_28174":121213,"_3058":121600},[],"Una regla con `actions: [\"*\"]` se expande a todas las acciones definidas por el esquema. Cuando una versión nueva añade una acción, una política con comodín puede empezar a concederla. Revisa estas políticas durante cada actualización.",{"_3602":72953,"_30987":72802,"_21467":121602,"_5":14750,"_28174":121217,"_3058":121603},[],"Para retirar acceso de inmediato, desactiva el principal o revoca sus grants. Desactivar un principal conserva su configuración y asociaciones para investigación o restauración, pero deja de participar en la coincidencia.",{"_3602":72954,"_30987":72802,"_21467":121605,"_5":14750,"_28174":121217,"_3058":121606},[],"Eliminar un rol o grupo en el IdP evita que nuevos tokens contengan el claim, pero un token ya emitido puede seguir siendo válido hasta expirar. Si la retirada es urgente, combina el cambio en el IdP con la desactivación del principal en Lamassu y la revocación de sesiones o tokens en el proveedor.",{"_3602":72955,"_30987":72802,"_21467":121608,"_5":14750,"_28174":121217,"_3058":121609},[],"Cuando edites una política compartida, recuerda que el cambio afecta a todos sus principales. Para probar un nuevo alcance, crea una política separada, concédela a una identidad de prueba y valida operaciones permitidas y denegadas antes de sustituir la anterior.",{"_3602":72956,"_30987":72802,"_21467":121611,"_5":14750,"_28174":121221,"_3058":121612},[],"Mantén `failOpen: false` salvo que una evaluación de riesgo documentada justifique lo contrario.",{"_3602":72957,"_30987":72802,"_21467":121614,"_5":14750,"_28174":121221,"_3058":121615},[],"Usa grupos o roles estables para personas e identidades independientes para automatizaciones.",{"_3602":72958,"_30987":72802,"_21467":121617,"_5":14750,"_28174":121221,"_3058":121618},[],"Conserva al menos dos administradores de recuperación y prueba su acceso periódicamente.",{"_3602":72959,"_30987":72802,"_21467":121620,"_5":14750,"_28174":121221,"_3058":121621},[],"Revisa los principales activos, sus coincidencias y sus grants después de cambios en el IdP.",{"_3602":72960,"_30987":72802,"_21467":121623,"_5":14750,"_28174":121221,"_3058":121624},[],"Busca comodines en políticas antes de actualizar Lamassu.",{"_3602":72961,"_30987":72802,"_21467":121626,"_5":14750,"_28174":121221,"_3058":121627},[],"Revisa las rutas `skip_authz` y los ajustes de `default_action` de los esquemas HTTP al integrar o actualizar un servicio.",{"_3602":72962,"_30987":72802,"_21467":121629,"_5":14750,"_28174":121221,"_3058":121630},[],"Prueba siempre una operación permitida y otra denegada para cada rol.",{"_3602":72963,"_30987":72802,"_21467":121632,"_5":14750,"_28174":121221,"_3058":121633},[],"Correlaciona los cambios de principales, políticas y grants con los registros de auditoría.",{"_3602":72964,"_30987":72802,"_21467":121635,"_5":14750,"_28174":121229,"_3058":121636},[],"La autenticación falló antes de evaluar permisos. Comprueba la firma y expiración del JWT, el emisor, la audiencia y la disponibilidad del JWKS configurado en el Gateway. Para X.509, revisa que el certificado cliente llegue hasta el punto que extrae la credencial.",{"_3602":72965,"_30987":72802,"_21467":121638,"_5":14750,"_28174":121233,"_3058":121639},[],"La credencial pudo procesarse, pero no produjo una autorización positiva. Revisa en este orden:",{"_3602":72966,"_30987":72802,"_21467":121641,"_5":14750,"_28174":121233,"_3058":121642},[],"que exista un principal activo del tipo correcto;",{"_3602":72967,"_30987":72802,"_21467":121644,"_5":14750,"_28174":121233,"_3058":121645},[],"que las rutas de claims y sus valores coincidan exactamente con el token real;",{"_3602":72968,"_30987":72802,"_21467":121647,"_5":14750,"_28174":121233,"_3058":121648},[],"que todas las condiciones del principal se cumplan;",{"_3602":72969,"_30987":72802,"_21467":121650,"_5":14750,"_28174":121233,"_3058":121651},[],"que el principal tenga concedida la política esperada;",{"_3602":72970,"_30987":72802,"_21467":121653,"_5":14750,"_28174":121233,"_3058":121654},[],"que la política incluya la acción y el tipo de recurso o ruta solicitados;",{"_3602":72971,"_30987":72802,"_21467":121656,"_5":14750,"_28174":121233,"_3058":121657},[],"que el identificador, relación, filtro de columna o restricción HTTP incluya el recurso real.",{"_3602":72972,"_30987":72802,"_21467":121659,"_5":14750,"_28174":121233,"_3058":121660},[],"En los logs de `authz`, una decisión del endpoint externo incluye `allowed`, `reason`, `matched_principals`, `evaluated_policy_ids`, `matched_policy_id` y el código de estado. Estos campos permiten separar un fallo de coincidencia de un fallo de permisos. Con las trazas OpenTelemetry habilitadas, una solicitud que llega al motor de políticas genera un span `engine.CheckHTTPRequest` cuyos atributos registran `authz.allowed`, la política coincidente y el principal coincidente. Para correlacionarlo con la traza del Gateway, el contexto de traza debe propagarse hasta authz.",{"_3602":72973,"_30987":72802,"_21467":121662,"_5":14750,"_28174":121233,"_3058":121663},[],"Si una política que dependía de acceso heredado dejó de concederlo tras una actualización, busca en los logs de `authz` el mensaje `skipping relation that grants nothing`: la advertencia indica la política y la relación que los esquemas ya no declaran. Corrige la relación de esa política para que coincida con los esquemas actuales.",{"_3602":72974,"_30987":72802,"_21467":121665,"_5":14750,"_28174":121237,"_3058":121666},[],"Comprueba que el principal de bootstrap fue creado y que las políticas fueron precargadas por el Job de migración. Verifica también que `services.authz.jwkUrl` sea alcanzable desde el pod de `authz`; no asumas que una URL pública accesible desde el navegador también funciona dentro del clúster.",{"_3602":72975,"_30987":72802,"_21467":121668,"_5":14750,"_28174":121241,"_3058":121669},[],"La ruta puede estar cubierta por una decisión del esquema y no por una política: las rutas marcadas con `skip_authz` permiten el paso a cualquier identidad que coincida con un principal activo, y una petición bajo un prefijo de `base_paths` cuyo esquema fija `default_action: allow` también se concede sin consultar políticas. Comprueba cuál de las dos situaciones aplica antes de buscar grants ausentes o mal asignados.",{"_3602":72976,"_30987":72802,"_21467":121671,"_5":14750,"_28174":121245,"_3058":121672},[],"Es el comportamiento esperado con `failOpen: false`. Restaura el servicio, su conexión con PostgreSQL y su conectividad con el JWKS. No cambies temporalmente a `failOpen: true` sin aceptar que las rutas protegidas podrían quedar accesibles sin decisión de autorización.",{"_3602":72977,"_30987":72802,"_21467":121674,"_5":14750,"_28174":121245,"_3058":121675},[],"Continúa con Registros de auditoría para investigar cambios de configuración o con Resolución de problemas para diagnosticar el despliegue.",{"_3602":72978,"_30987":72978,"_5":15110,"_3058":121677,"_31325":121678,"_21467":121679,"_28174":72978},"Alertas y suscripciones",[50623,121012,121013],[],{"_3602":72979,"_30987":72978,"_21467":121681,"_5":14750,"_28174":72978,"_3058":121682},[],"Envía eventos de la PKI a personas y sistemas externos.",{"_3602":72980,"_30987":72978,"_5":31322,"_21467":121684,"_28174":121685,"_3058":121686},[],"/docs/es/platform/administration/alerts#cómo-funciona","Cómo funciona",{"_3602":72981,"_30987":72978,"_5":31322,"_21467":121688,"_28174":121689,"_3058":121690},[],"/docs/es/platform/administration/alerts#canales-disponibles","Canales disponibles",{"_3602":72982,"_30987":72978,"_5":31322,"_21467":121692,"_28174":121693,"_3058":121694},[],"/docs/es/platform/administration/alerts#crea-una-suscripción","Crea una suscripción",{"_3602":72983,"_30987":72978,"_5":31322,"_21467":121696,"_28174":121697,"_3058":121698},[],"/docs/es/platform/administration/alerts#elige-el-evento","Elige el evento",{"_3602":72984,"_30987":72978,"_5":31322,"_21467":121700,"_28174":121701,"_3058":121702},[],"/docs/es/platform/administration/alerts#configura-el-destino","Configura el destino",{"_3602":72985,"_30987":72978,"_5":31322,"_21467":121704,"_28174":121705,"_3058":121706},[],"/docs/es/platform/administration/alerts#limita-las-notificaciones","Limita las notificaciones",{"_3602":72986,"_30987":72978,"_5":31322,"_21467":121708,"_28174":121709,"_3058":121710},[],"/docs/es/platform/administration/alerts#revisa-y-activa","Revisa y activa",{"_3602":72987,"_30987":72978,"_5":31322,"_21467":121712,"_28174":121713,"_3058":121714},[],"/docs/es/platform/administration/alerts#configura-el-cliente-http-del-webhook","Configura el cliente HTTP del webhook",{"_3602":72988,"_30987":72978,"_5":31322,"_21467":121716,"_28174":121717,"_3058":121718},[],"/docs/es/platform/administration/alerts#reglas-de-entrega-del-webhook","Reglas de entrega del webhook",{"_3602":72989,"_30987":72978,"_5":31322,"_21467":121720,"_28174":121721,"_3058":121722},[],"/docs/es/platform/administration/alerts#gestiona-una-suscripción","Gestiona una suscripción",{"_3602":72990,"_30987":72978,"_5":31322,"_21467":121724,"_28174":121725,"_3058":121726},[],"/docs/es/platform/administration/alerts#familias-de-eventos","Familias de eventos",{"_3602":72991,"_30987":72978,"_21467":121728,"_5":14750,"_28174":72978,"_3058":121729},[],"Las suscripciones convierten los eventos de Lamassu en notificaciones accionables. Puedes avisar a un equipo, alimentar un sistema de incidentes o activar una automatización cuando cambia una CA, un certificado o un dispositivo.",{"_3602":72992,"_30987":72978,"_21467":121731,"_5":14750,"_28174":121685,"_3058":121732},[],"Un servicio publica un evento de dominio.",{"_3602":72993,"_30987":72978,"_21467":121734,"_5":14750,"_28174":121685,"_3058":121735},[],"Lamassu evalúa las suscripciones asociadas a ese tipo de evento.",{"_3602":72994,"_30987":72978,"_21467":121737,"_5":14750,"_28174":121685,"_3058":121738},[],"El filtro de cada suscripción decide si debe notificarse.",{"_3602":72995,"_30987":72978,"_21467":121740,"_5":14750,"_28174":121685,"_3058":121741},[],"Lamassu entrega el evento al canal configurado.",{"_3602":72996,"_30987":72978,"_21467":121743,"_5":14750,"_28174":121685,"_3058":121744},[],"El inventario de eventos muestra cuándo se observó cada tipo por última vez, cuántas veces ha ocurrido y cuántas suscripciones tiene. Puedes expandir un evento para inspeccionar un ejemplo de su payload JSON antes de crear el filtro.",{"_3602":72997,"_30987":72978,"_21467":121746,"_5":14750,"_28174":121689,"_3058":121747},[],"**Email** envía avisos a una persona o lista operativa. Solo requiere la dirección de destino. El contenido del evento se entrega como texto HTML escapado, nunca como marcado.",{"_3602":72998,"_30987":72978,"_21467":121749,"_5":14750,"_28174":121689,"_3058":121750},[],"**Microsoft Teams** publica la notificación en un canal mediante su URL de webhook.",{"_3602":72999,"_30987":72978,"_21467":121752,"_5":14750,"_28174":121689,"_3058":121753},[],"**Webhook** entrega el evento a una automatización, SIEM o sistema de incidentes mediante `POST` o `PUT`.",{"_3602":73000,"_30987":72978,"_21467":121755,"_5":14750,"_28174":121689,"_3058":121756},[],"Los canales Microsoft Teams y Webhook aceptan un bloque opcional `http_client` que autentica la llamada al receptor. `auth_mode` selecciona `noauth` (por defecto), `apikey`, `jwt` o `mtls`; cada modo exige sus propias opciones:",{"_3602":73001,"_30987":72978,"_21467":121758,"_5":14750,"_28174":121689,"_3058":121759},[],"`apikey_options` necesita `header` y `key`.",{"_3602":73002,"_30987":72978,"_21467":121761,"_5":14750,"_28174":121689,"_3058":121762},[],"`jwt_options` necesita `oidc_client_id`, `oidc_client_secret` y un `oidc_well_known` absoluto `http` o `https`.",{"_3602":73003,"_30987":72978,"_21467":121764,"_5":14750,"_28174":121689,"_3058":121765},[],"`mtls_options` necesita `cert_content` y `key_content` como PEM codificado en Base64, como el resto de certificados de la API; también se acepta el PEM en claro. Los valores que referencian archivos del servidor se rechazan, y el par debe corresponder a un certificado y una clave privada coincidentes.",{"_3602":73004,"_30987":72978,"_21467":121767,"_5":14750,"_28174":121689,"_3058":121768},[],"La referencia de la API de Alerts documenta el esquema completo de `http_client`.",{"_3602":73005,"_30987":72978,"_21467":121770,"_5":14750,"_28174":121697,"_3058":121771},[],"Abre **Alerts**, localiza el tipo de evento y selecciona **Subscribe**. Revisa el último ejemplo JSON para identificar los campos que necesitarás filtrar.",{"_3602":73006,"_30987":72978,"_21467":121773,"_5":14750,"_28174":121701,"_3058":121774},[],"Selecciona Email, Microsoft Teams o Webhook e introduce los datos del canal.",{"_3602":73007,"_30987":72978,"_21467":121776,"_5":14750,"_28174":121705,"_3058":121777},[],"Añade un filtro si no quieres recibir todas las instancias del evento.",{"_3602":73008,"_30987":72978,"_21467":121779,"_5":14750,"_28174":121705,"_3058":121780},[],"**None** notifica todas las instancias del evento.",{"_3602":73009,"_30987":72978,"_21467":121782,"_5":14750,"_28174":121705,"_3058":121783},[],"**JSON Path** evalúa uno o varios campos concretos.",{"_3602":73010,"_30987":72978,"_21467":121785,"_5":14750,"_28174":121705,"_3058":121786},[],"**JSON Schema** acepta únicamente payloads con una estructura determinada.",{"_3602":73011,"_30987":72978,"_21467":121788,"_5":14750,"_28174":121705,"_3058":121789},[],"**JavaScript** permite expresar lógica personalizada. Cada filtro se ejecuta como máximo durante 100 milisegundos; un filtro que supera ese límite hace fallar la condición y la notificación se omite con el error `javascript filter execution timed out`.",{"_3602":73012,"_30987":72978,"_21467":121791,"_5":14750,"_28174":121705,"_3058":121792},[],"Por ejemplo, `function (event) { return event.data.status == \"NO_IDENTITY\"; }` limita una suscripción a dispositivos sin identidad.",{"_3602":73013,"_30987":72978,"_21467":121794,"_5":14750,"_28174":121705,"_3058":121795},[],"La consola evalúa el filtro contra el JSON del editor **Input Event**, que está prellenado con el último evento, e indica si coincide. Para los filtros JSON Path y JavaScript, muestra **The filter matches this Cloud Event** o **The filter does not match this Cloud Event**. Las expresiones JSON Path se evalúan sobre el Cloud Event completo, así que el valor por defecto, `$.data`, selecciona el campo `data` del evento, y la expresión debe empezar por `$`.",{"_3602":73014,"_30987":72978,"_21467":121797,"_5":14750,"_28174":121709,"_3058":121798},[],"Comprueba el evento, el canal y el filtro en el resumen. Selecciona **Confirm Subscription** para comenzar la entrega.",{"_3602":73015,"_30987":72978,"_21467":121800,"_5":14750,"_28174":121713,"_3058":121801},[],"Los canales Webhook y Microsoft Teams muestran esta configuración en el formulario de suscripción, en el paso del canal, y de nuevo al editar una suscripción; Email no la utiliza. Los campos se corresponden con el bloque opcional `http_client` descrito arriba:",{"_3602":73016,"_30987":72978,"_21467":121803,"_5":14750,"_28174":121713,"_3058":121804},[],"**Log Level** selecciona `debug`, `info`, `warn` o `error`; `info` es el valor por defecto.",{"_3602":73017,"_30987":72978,"_21467":121806,"_5":14750,"_28174":121713,"_3058":121807},[],"**Call Timeout** es de 10 segundos por defecto. La consola rechaza un valor superior a 30 segundos con `Webhook timeout must be at most 30s.`; la API ajusta ese mismo valor al tope en lugar de rechazarlo (ver Las llamadas están limitadas).",{"_3602":73018,"_30987":72978,"_21467":121809,"_5":14750,"_28174":121713,"_3058":121810},[],"No hay interruptor de verificación TLS para estos canales, porque el servicio siempre verifica el certificado del receptor (ver TLS siempre se verifica).",{"_3602":73019,"_30987":72978,"_21467":121812,"_5":14750,"_28174":121713,"_3058":121813},[],"**HTTP Authentication** selecciona `No Authentication` (por defecto), `API Key` (valor de la API key y Header Name, `X-API-Key` por defecto), `OIDC Client Credentials` (Client ID, Client Secret y Well-Known URL) o `Mutual TLS` (Client Certificate y Client Private Key pegados como PEM). Una clave privada guardada permanece oculta hasta que seleccionas **Show**.",{"_3602":73020,"_30987":72978,"_21467":121815,"_5":14750,"_28174":121713,"_3058":121816},[],"Una URL `http://` muestra en la consola la advertencia `Unencrypted HTTP connection` (ver la llamada Credenciales sobre http\\:// más abajo).",{"_3602":73021,"_30987":72978,"_21467":121818,"_5":14750,"_28174":121713,"_3058":121819},[],"Los campos se validan en línea con las mismas reglas de entrega: la URL del webhook y la Well-Known URL de OIDC deben ser URLs absolutas `http` o `https`, una cabecera API-key no puede usar un nombre reservado y el certificado y la clave mTLS deben ser contenido PEM, no rutas de ficheros.",{"_3602":73022,"_30987":72978,"_21467":121821,"_5":14750,"_28174":121713,"_3058":121822},[],"El resumen del paso de confirmación muestra la autenticación como `None`, `OIDC client credentials`, `API key` o `Mutual TLS`. Los detalles de la suscripción muestran la autenticación, el nombre de la cabecera API-key (nunca el valor), la URL del emisor OIDC, mTLS como `Configured` y una fila fija `TLS verification: Verified`. La API key, el client secret y la clave privada no se muestran en los detalles de la suscripción.",{"_3602":73023,"_30987":72978,"_21467":121824,"_5":14750,"_28174":121717,"_3058":121825},[],"Las notificaciones enviadas por los canales Microsoft Teams y Webhook siguen una política HTTP fija:",{"_3602":73024,"_30987":72978,"_21467":121827,"_5":14750,"_28174":121717,"_3058":121828},[],"**TLS siempre se verifica.** El certificado del receptor se comprueba contra el almacén de confianza del sistema. `insecure_skip_verify` se aplica siempre como `false` — también cuando se establece en `true` — así que un receptor con certificado propio o no confiable falla la entrega.",{"_3602":73025,"_30987":72978,"_21467":121830,"_5":14750,"_28174":121717,"_3058":121831},[],"**No se siguen redirecciones.** Una respuesta `3xx` falla con `unexpected status code: <n>: redirects are not followed`. Configura `webhook_url` con la URL final absoluta `http` o `https`: una dirección `http://` que un ingress redirige a `https://` deja de funcionar.",{"_3602":73026,"_30987":72978,"_21467":121833,"_5":14750,"_28174":121717,"_3058":121834},[],"**Las llamadas están limitadas.** Una llamada tiene por defecto un timeout de 10 segundos; un `call_timeout` configurado se limita a 30 segundos. Los valores por encima del tope se ajustan, no se rechazan.",{"_3602":73027,"_30987":72978,"_21467":121836,"_5":14750,"_28174":121717,"_3058":121837},[],"**El cuerpo de la respuesta se ignora.** La entrega comprueba solo el código de estado, así que el receptor puede responder con cualquier cuerpo.",{"_3602":73028,"_30987":72978,"_21467":121839,"_5":14750,"_28174":121717,"_3058":121840},[],"**Las cabeceras API-key están restringidas.** Un `apikey_options.header` propio no puede usar nombres en los que la plataforma o los servicios receptores confían — por ejemplo `X-Principal-Id`, `X-Request-Id`, `Host`, `Content-Type` o `Forwarded` — y ningún nombre puede empezar por `X-Forwarded-`, `X-Envoy-` o `X-Lms-`. La comparación no distingue mayúsculas.",{"_3602":73029,"_30987":72978,"_21467":121842,"_5":14750,"_28174":121717,"_3058":121843},[],"**Las configuraciones inválidas se rechazan al suscribir.** Una configuración de canal que fallaría en cada entrega devuelve HTTP 400 con un cuerpo que empieza por `struct validation error:` y la suscripción no se crea.",{"_3602":73030,"_30987":72978,"_21467":121845,"_5":14750,"_28174":121717,"_3058":121846},[],"Las credenciales se envían sea cual sea el esquema de la URL. Con un `webhook_url` `http://`, la API key o el bearer token viajan en texto claro y mTLS no tiene efecto. Prefiere `https://` para `webhook_url`, `oidc_well_known` y el token endpoint que anuncia.",{"_3602":73031,"_30987":72978,"_21467":121848,"_5":14750,"_28174":121721,"_3058":121849},[],"Abre una suscripción existente para consultar su destino y filtro, modificar la configuración o seleccionar **Unsubscribe**. Elimina las suscripciones que ya no tengan un propietario operativo para evitar entregas ignoradas o endpoints obsoletos.",{"_3602":73032,"_30987":72978,"_21467":121851,"_5":14750,"_28174":121721,"_3058":121852},[],"Las suscripciones creadas con versiones anteriores de la consola pueden guardar el destino del webhook en `url` y `method` en lugar de `webhook_url` y `webhook_method`. El servicio entrega solo a través de `webhook_url` y `webhook_method`, así que una suscripción así no entrega aunque los detalles de la suscripción muestren el destino guardado. Abre la suscripción y vuelve a guardarla: el formulario de edición precarga el destino guardado, y al guardar se reescribe la configuración del canal con el formato actual.",{"_3602":73033,"_30987":72978,"_21467":121854,"_5":14750,"_28174":121725,"_3058":121855},[],"**Autoridades:** `ca.create`, `ca.import`, `ca.reissue` y `ca.delete`.",{"_3602":73034,"_30987":72978,"_21467":121857,"_5":14750,"_28174":121725,"_3058":121858},[],"**Certificados:** `ca.sign.certificate` y `certificate.delete`.",{"_3602":73035,"_30987":72978,"_21467":121860,"_5":14750,"_28174":121725,"_3058":121861},[],"**Perfiles:** `profile.issuance.create`, `profile.issuance.update` y `profile.issuance.delete`.",{"_3602":73036,"_30987":72978,"_21467":121863,"_5":14750,"_28174":121725,"_3058":121864},[],"**Enrolamiento:** `dms.create`, `dms.update`, `dms.enroll` y `dms.reenroll`.",{"_3602":73037,"_30987":72978,"_21467":121866,"_5":14750,"_28174":121725,"_3058":121867},[],"**Dispositivos:** `device.create`, `device.identity.update` y `device.status.update`.",{"_3602":73038,"_30987":72978,"_21467":121869,"_5":14750,"_28174":121725,"_3058":121870},[],"**Validación:** `va.role.crl.create`, `va.crl-settings.init`, `va.crl-settings.update`, `va.crl-settings.finalize`, `va.crl-settings.archive` y `va.crl-settings.delete`.",{"_3602":73039,"_30987":72978,"_21467":121872,"_5":14750,"_28174":121725,"_3058":121873},[],"**Claves:** `kms.create`, `kms.import`, `kms.sign` y `kms.delete`.",{"_3602":73040,"_30987":72978,"_21467":121875,"_5":14750,"_28174":121725,"_3058":121876},[],"Utiliza el catálogo que muestra la consola como fuente para los tipos disponibles en la versión que tienes desplegada.",{"_3602":73041,"_30987":72978,"_21467":121878,"_5":14750,"_28174":121725,"_3058":121879},[],"Desde 4.0.0, `va.crl-settings.init` y `va.crl-settings.update` transportan los ajustes de CRL de una CA (`ca_id`) y sustituyen a `va.role.crl.init` y `va.role.update`. La migración de la actualización renombra automáticamente los tipos de las suscripciones existentes, pero no reescribe sus condiciones: revisa los filtros que lean el payload antiguo o el subject antiguo `crl/<ski>`, incluidos los de `va.role.crl.create` (consulta 3.8.0 a 4.0.0).",{"_3602":73042,"_30987":72978,"_21467":121881,"_5":14750,"_28174":121725,"_3058":121882},[],"La VA publica además `va.crl-settings.finalize` cuando una CA se revoca de forma permanente o caduca, `va.crl-settings.archive` cuando la CA se elimina, y `va.crl-settings.delete` cuando se eliminan ajustes archivados.",{"_3602":73043,"_30987":73043,"_5":15110,"_3058":121884,"_31325":121885,"_21467":121886,"_28174":73043},"Registros de auditoría",[50623,121012,121013],[],{"_3602":73044,"_30987":73043,"_21467":121888,"_5":14750,"_28174":73043,"_3058":121889},[],"Entiende qué eventos de auditoría genera Lamassu y cómo convertirlos en una pista durable.",{"_3602":73045,"_30987":73043,"_5":31322,"_21467":121891,"_28174":121892,"_3058":121893},[],"/docs/es/platform/administration/audit-logs#qué-contiene-un-evento","Qué contiene un evento",{"_3602":73046,"_30987":73043,"_5":31322,"_21467":121895,"_28174":121896,"_3058":121897},[],"/docs/es/platform/administration/audit-logs#cobertura","Cobertura",{"_3602":73047,"_30987":73043,"_5":31322,"_21467":121899,"_28174":121900,"_3058":121901},[],"/docs/es/platform/administration/audit-logs#publicación-y-persistencia","Publicación y persistencia",{"_3602":73048,"_30987":73043,"_5":31322,"_21467":121903,"_28174":121904,"_3058":121905},[],"/docs/es/platform/administration/audit-logs#datos-sensibles","Datos sensibles",{"_3602":73049,"_30987":73043,"_5":31322,"_21467":121907,"_28174":121908,"_3058":121909},[],"/docs/es/platform/administration/audit-logs#una-investigación-reproducible","Una investigación reproducible",{"_3602":73050,"_30987":73043,"_5":31322,"_21467":121911,"_28174":121912,"_3058":121913},[],"/docs/es/platform/administration/audit-logs#acota-el-intervalo","Acota el intervalo",{"_3602":73051,"_30987":73043,"_5":31322,"_21467":121915,"_28174":121916,"_3058":121917},[],"/docs/es/platform/administration/audit-logs#identifica-la-operación","Identifica la operación",{"_3602":73052,"_30987":73043,"_5":31322,"_21467":121919,"_28174":121920,"_3058":121921},[],"/docs/es/platform/administration/audit-logs#atribuye-el-principal","Atribuye el principal",{"_3602":73053,"_30987":73043,"_5":31322,"_21467":121923,"_28174":121924,"_3058":121925},[],"/docs/es/platform/administration/audit-logs#compara-intención-y-resultado","Compara intención y resultado",{"_3602":73054,"_30987":73043,"_5":31322,"_21467":121927,"_28174":121928,"_3058":121929},[],"/docs/es/platform/administration/audit-logs#sigue-el-efecto","Sigue el efecto",{"_3602":73055,"_30987":73043,"_5":31322,"_21467":121931,"_28174":121932,"_3058":121933},[],"/docs/es/platform/administration/audit-logs#verificación-periódica","Verificación periódica",{"_3602":73056,"_30987":73043,"_21467":121935,"_5":14750,"_28174":73043,"_3058":121936},[],"Lamassu instrumenta las operaciones mutables de sus servicios con eventos de auditoría. Cada evento describe la operación, los principales que coincidieron, la entrada, el resultado y si terminó con error.",{"_3602":73057,"_30987":73043,"_21467":121938,"_5":14750,"_28174":121892,"_3058":121939},[],"El cuerpo de auditoría incluye:",{"_3602":73058,"_30987":73043,"_21467":121941,"_5":14750,"_28174":121892,"_3058":121942},[],"input: datos recibidos por la operación;",{"_3602":73059,"_30987":73043,"_21467":121944,"_5":14750,"_28174":121892,"_3058":121945},[],"has\\_error: indica si el servicio devolvió un error;",{"_3602":73060,"_30987":73043,"_21467":121947,"_5":14750,"_28174":121892,"_3058":121948},[],"output: resultado producido o mensaje de error;",{"_3602":73061,"_30987":73043,"_21467":121950,"_5":14750,"_28174":121892,"_3058":121951},[],"principals: identificadores de los principales que coincidieron con la petición.",{"_3602":73062,"_30987":73043,"_21467":121953,"_5":14750,"_28174":121892,"_3058":121954},[],"Las operaciones correctas usan un tipo con prefijo audit.. Los fallos publican el tipo de operación con sufijo .error. El evento CloudEvents añade, además, fuente, identificador, fecha y tipo.",{"_3602":73063,"_30987":73043,"_21467":121956,"_5":14750,"_28174":121892,"_3058":121957},[],"Los middlewares publican el registro después de ejecutar la operación, tanto si tuvo éxito como si devolvió un error. Esto permite investigar intentos además de cambios confirmados.",{"_3602":73064,"_30987":73043,"_21467":121959,"_5":14750,"_28174":121896,"_3058":121960},[],"El backend aplica auditoría a mutaciones de:",{"_3602":73065,"_30987":73043,"_21467":121962,"_5":14750,"_28174":121896,"_3058":121963},[],"autoridades, certificados y perfiles de emisión;",{"_3602":73066,"_30987":73043,"_21467":121965,"_5":14750,"_28174":121896,"_3058":121966},[],"claves y motores KMS;",{"_3602":73067,"_30987":73043,"_21467":121968,"_5":14750,"_28174":121896,"_3058":121969},[],"dispositivos e identidades;",{"_3602":73068,"_30987":73043,"_21467":121971,"_5":14750,"_28174":121896,"_3058":121972},[],"DMS y operaciones de enrolamiento;",{"_3602":73069,"_30987":73043,"_21467":121974,"_5":14750,"_28174":121896,"_3058":121975},[],"funciones de validación y CRL;",{"_3602":73070,"_30987":73043,"_21467":121977,"_5":14750,"_28174":121896,"_3058":121978},[],"principales, políticas y concesiones de autorización.",{"_3602":73071,"_30987":73043,"_21467":121980,"_5":14750,"_28174":121896,"_3058":121981},[],"No confundas estos eventos con los eventos de dominio. Un evento de dominio comunica que un recurso cambió para que otro componente reaccione; el evento de auditoría conserva contexto de entrada, salida y principal para investigación.",{"_3602":73072,"_30987":73043,"_21467":121983,"_5":14750,"_28174":121900,"_3058":121984},[],"Los servicios publican auditoría en el bus de eventos cuando su PublisherEventBus está habilitado. El código del backend no implementa un archivo de auditoría consultable y durable por sí solo.",{"_3602":73073,"_30987":73043,"_21467":121986,"_5":14750,"_28174":121900,"_3058":121987},[],"Si necesitas retención, búsquedas, protección contra alteraciones o exportación regulatoria, conecta un consumidor que persista los eventos en el sistema aprobado por tu organización.",{"_3602":73074,"_30987":73043,"_21467":121989,"_5":14750,"_28174":121900,"_3058":121990},[],"Diseña el consumidor para:",{"_3602":73075,"_30987":73043,"_21467":121992,"_5":14750,"_28174":121900,"_3058":121993},[],"suscribirse a los tipos audit.# y también a los tipos de operación terminados en .error;",{"_3602":73076,"_30987":73043,"_21467":121995,"_5":14750,"_28174":121900,"_3058":121996},[],"conservar el CloudEvent completo sin modificar;",{"_3602":73077,"_30987":73043,"_21467":121998,"_5":14750,"_28174":121900,"_3058":121999},[],"registrar el momento de ingestión y detectar duplicados por ID;",{"_3602":73078,"_30987":73043,"_21467":122001,"_5":14750,"_28174":121900,"_3058":122002},[],"cifrar en tránsito y en reposo;",{"_3602":73079,"_30987":73043,"_21467":122004,"_5":14750,"_28174":121900,"_3058":122005},[],"limitar lectura y borrado a un rol separado del operador de PKI;",{"_3602":73080,"_30987":73043,"_21467":122007,"_5":14750,"_28174":121900,"_3058":122008},[],"aplicar una política explícita de retención y legal hold;",{"_3602":73081,"_30987":73043,"_21467":122010,"_5":14750,"_28174":121900,"_3058":122011},[],"alertar si deja de consumir o aumenta la cola pendiente.",{"_3602":73082,"_30987":73043,"_21467":122013,"_5":14750,"_28174":121904,"_3058":122014},[],"Los campos input y output pueden contener sujetos, metadatos, material público, configuración o mensajes de error. Evalúa su clasificación antes de enviarlos a una plataforma externa.",{"_3602":73083,"_30987":73043,"_21467":122016,"_5":14750,"_28174":121904,"_3058":122017},[],"No registres claves privadas, secretos de proveedores ni tokens completos en automatizaciones que rodean a Lamassu. Restringe la exportación y aplica redacción en el destino sin destruir los campos necesarios para atribución.",{"_3602":73084,"_30987":73043,"_21467":122019,"_5":14750,"_28174":121912,"_3058":122020},[],"Parte de la hora reportada y normaliza todas las fuentes a UTC.",{"_3602":73085,"_30987":73043,"_21467":122022,"_5":14750,"_28174":121916,"_3058":122023},[],"Filtra por tipo de evento, fuente de servicio e identificador del recurso.",{"_3602":73086,"_30987":73043,"_21467":122025,"_5":14750,"_28174":121920,"_3058":122026},[],"Revisa principals y correlaciónalo con el proveedor OIDC o la identidad X.509 vigente en ese momento.",{"_3602":73087,"_30987":73043,"_21467":122028,"_5":14750,"_28174":121924,"_3058":122029},[],"Contrasta input, has\\_error y output. Un intento fallido no implica que el recurso haya cambiado.",{"_3602":73088,"_30987":73043,"_21467":122031,"_5":14750,"_28174":121928,"_3058":122032},[],"Busca los eventos de dominio y registros del servicio que compartan recurso y ventana temporal. En una revocación de CA, incluye las operaciones en cascada.",{"_3602":73089,"_30987":73043,"_21467":122034,"_5":14750,"_28174":121932,"_3058":122035},[],"Genera una mutación controlada en un entorno de prueba y comprueba que:",{"_3602":73090,"_30987":73043,"_21467":122037,"_5":14750,"_28174":121932,"_3058":122038},[],"aparece un evento de auditoría correcto;",{"_3602":73091,"_30987":73043,"_21467":122040,"_5":14750,"_28174":121932,"_3058":122041},[],"el principal coincide con la identidad utilizada;",{"_3602":73092,"_30987":73043,"_21467":122043,"_5":14750,"_28174":121932,"_3058":122044},[],"el consumidor lo persiste una sola vez;",{"_3602":73093,"_30987":73043,"_21467":122046,"_5":14750,"_28174":121932,"_3058":122047},[],"puede recuperarse por recurso, actor y periodo;",{"_3602":73094,"_30987":73043,"_21467":122049,"_5":14750,"_28174":121932,"_3058":122050},[],"una interrupción del consumidor produce una alerta.",{"_3602":73095,"_30987":73043,"_21467":122052,"_5":14750,"_28174":121932,"_3058":122053},[],"Para métricas, trazas y logs técnicos del despliegue, consulta Resolución de problemas. La auditoría responde a “quién intentó cambiar qué”; la observabilidad explica cómo se comportó el sistema.",{"_3602":73096,"_30987":73096,"_5":15110,"_3058":122055,"_31325":122056,"_21467":122057,"_28174":73096},"Arquitectura de la plataforma",[50623,121012],[],{"_3602":73097,"_30987":73096,"_21467":122059,"_5":14750,"_28174":73096,"_3058":122060},[],"Componentes de Lamassu y relación entre control, claves, emisión y dispositivos.",{"_3602":73098,"_30987":73096,"_5":31322,"_21467":122062,"_28174":122063,"_3058":122064},[],"/docs/es/platform/concepts/architecture#plano-de-control","Plano de control",{"_3602":73099,"_30987":73096,"_5":31322,"_21467":122066,"_28174":122067,"_3058":122068},[],"/docs/es/platform/concepts/architecture#custodia-y-operaciones-criptográficas","Custodia y operaciones criptográficas",{"_3602":73100,"_30987":73096,"_5":31322,"_21467":122070,"_28174":122071,"_3058":122072},[],"/docs/es/platform/concepts/architecture#emisión-y-enrolamiento","Emisión y enrolamiento",{"_3602":73101,"_30987":73096,"_5":31322,"_21467":122074,"_28174":122075,"_3058":122076},[],"/docs/es/platform/concepts/architecture#estado-y-validación","Estado y validación",{"_3602":73102,"_30987":73096,"_5":31322,"_21467":122078,"_28174":122079,"_3058":122080},[],"/docs/es/platform/concepts/architecture#dependencias-de-la-plataforma","Dependencias de la plataforma",{"_3602":73103,"_30987":73096,"_21467":122082,"_5":14750,"_28174":73096,"_3058":122083},[],"Lamassu se despliega como un conjunto de servicios independientes. La separación evita que todos los componentes necesiten acceso directo a las claves privadas y permite escalar cada capacidad según la carga.",{"_3602":73104,"_30987":73096,"_21467":122085,"_5":14750,"_28174":73096,"_3058":122086},[],"Cambia al nivel bajo para ver el interior de la caja de la plataforma Lamassu (CA, KMS, DMS, Device Manager, VA, Alerts, el conector de AWS IoT, Job Manager y la consola/API), y al nivel medio para verla como una única plataforma junto a sus dependencias externas.",{"_3602":73105,"_30987":73096,"_21467":122088,"_5":14750,"_28174":122063,"_3058":122089},[],"La consola y las APIs administran autoridades, certificados, DMS, dispositivos, alertas y configuración. Los eventos de dominio permiten que conectores y automatizaciones reaccionen a los cambios sin sondear continuamente la plataforma.",{"_3602":73106,"_30987":73096,"_21467":122091,"_5":14750,"_28174":122067,"_3058":122092},[],"El KMS ofrece una interfaz común sobre motores software, PKCS#11 y proveedores cloud. El motor seleccionado conserva la clave o delega la operación criptográfica sin que los demás servicios conozcan su implementación.",{"_3602":73107,"_30987":73096,"_21467":122094,"_5":14750,"_28174":122071,"_3058":122095},[],"El servicio de CA emite certificados y mantiene la relación con su autoridad. El DMS aplica las reglas de enrolamiento y expone los flujos EST para que un dispositivo solicite o renueve una identidad.",{"_3602":73108,"_30987":73096,"_21467":122097,"_5":14750,"_28174":122075,"_3058":122098},[],"Device Manager conserva la vista operativa del dispositivo y su historial. Validation Authority publica OCSP y CRLs para que otros sistemas decidan si deben confiar en un certificado presentado.",{"_3602":73109,"_30987":73096,"_21467":122100,"_5":14750,"_28174":122079,"_3058":122101},[],"En un despliegue autogestionado, Lamassu utiliza PostgreSQL para persistencia, RabbitMQ para mensajería y un proveedor OIDC para autenticación. Consulta la arquitectura de despliegue para ver cómo se publican los servicios en Kubernetes.",{"_3602":73110,"_30987":73110,"_5":15110,"_3058":122103,"_31325":122104,"_21467":122105,"_28174":73110},"Cómo funciona Lamassu",[50623,121012],[],{"_3602":73111,"_30987":73110,"_21467":122107,"_5":14750,"_28174":73110,"_3058":122108},[],"El modelo mental de confianza, claves, certificados y dispositivos.",{"_3602":73112,"_30987":73110,"_5":31322,"_21467":122110,"_28174":122111,"_3058":122112},[],"/docs/es/platform/concepts/overview#el-modelo-en-cinco-piezas","El modelo en cinco piezas",{"_3602":73113,"_30987":73110,"_5":31322,"_21467":122114,"_28174":122115,"_3058":122116},[],"/docs/es/platform/concepts/overview#del-alta-a-la-operación","Del alta a la operación",{"_3602":73114,"_30987":73110,"_21467":122118,"_5":14750,"_28174":73110,"_3058":122119},[],"Lamassu conecta tres elementos: una **raíz de confianza**, una **política de emisión** y una **entidad que necesita demostrar su identidad**. La plataforma coordina esos elementos durante todo el ciclo de vida del certificado.",{"_3602":73115,"_30987":73110,"_21467":122121,"_5":14750,"_28174":122111,"_3058":122122},[],"**Motor criptográfico.** Genera o custodia claves y ejecuta las operaciones privadas sin exponer el material criptográfico al resto de servicios.",{"_3602":73116,"_30987":73110,"_21467":122124,"_5":14750,"_28174":122111,"_3058":122125},[],"**Autoridad de certificación (CA).** Firma certificados y establece la cadena de confianza.",{"_3602":73117,"_30987":73110,"_21467":122127,"_5":14750,"_28174":122111,"_3058":122128},[],"**Device Management Service (DMS).** Define cómo se registran, autentican y renuevan los dispositivos de una flota.",{"_3602":73118,"_30987":73110,"_21467":122130,"_5":14750,"_28174":122111,"_3058":122131},[],"**Dispositivo.** Conserva su clave privada y presenta el certificado para demostrar su identidad.",{"_3602":73119,"_30987":73110,"_21467":122133,"_5":14750,"_28174":122111,"_3058":122134},[],"**Validation Authority (VA).** Publica el estado de los certificados mediante OCSP y CRL.",{"_3602":73120,"_30987":73110,"_21467":122136,"_5":14750,"_28174":122115,"_3058":122137},[],"Un administrador configura un motor criptográfico y crea o importa una CA.",{"_3602":73121,"_30987":73110,"_21467":122139,"_5":14750,"_28174":122115,"_3058":122140},[],"Un DMS relaciona esa CA con una política de enrolamiento.",{"_3602":73122,"_30987":73110,"_21467":122142,"_5":14750,"_28174":122115,"_3058":122143},[],"El dispositivo genera una clave y solicita un certificado mediante EST, o un operador le asigna una identidad.",{"_3602":73123,"_30987":73110,"_21467":122145,"_5":14750,"_28174":122115,"_3058":122146},[],"Lamassu conserva el inventario, el historial y el estado de la identidad.",{"_3602":73124,"_30987":73110,"_21467":122148,"_5":14750,"_28174":122115,"_3058":122149},[],"Los consumidores comprueban la cadena y consultan OCSP o una CRL cuando necesitan conocer su vigencia.",{"_3602":73125,"_30987":73110,"_21467":122151,"_5":14750,"_28174":122115,"_3058":122152},[],"<Card title=\"Arquitectura\" description=\"Conoce los componentes y dónde termina la responsabilidad de cada uno.\" href=\"/docs/platform/concepts/architecture\" />",{"_3602":73126,"_30987":73110,"_21467":122154,"_5":14750,"_28174":122115,"_3058":122155},[],"<Card title=\"Ciclo de vida de una identidad\" description=\"Sigue un certificado desde el enrolamiento hasta la renovación o revocación.\" href=\"/docs/platform/pki/concepts/certificate-lifecycle\" />",{"_3602":73127,"_30987":73127,"_5":15110,"_3058":122157,"_31325":122158,"_21467":122159,"_28174":73127},"Dispositivos e identidades",[50623,121012,53307,122157],[],{"_3602":73128,"_30987":73127,"_21467":122161,"_5":14750,"_28174":73127,"_3058":122162},[],"Registra, inspecciona y retira dispositivos comprobando su identidad actual y su historial.",{"_3602":73129,"_30987":73127,"_5":31322,"_21467":122164,"_28174":122165,"_3058":122166},[],"/docs/es/platform/iot-fleets/device-management#estados-del-dispositivo","Estados del dispositivo",{"_3602":73130,"_30987":73127,"_5":31322,"_21467":122168,"_28174":122169,"_3058":122170},[],"/docs/es/platform/iot-fleets/device-management#inspecciona-un-dispositivo","Inspecciona un dispositivo",{"_3602":73131,"_30987":73127,"_5":31322,"_21467":122172,"_28174":122173,"_3058":122174},[],"/docs/es/platform/iot-fleets/device-management#registra-un-dispositivo-manualmente","Registra un dispositivo manualmente",{"_3602":73132,"_30987":73127,"_5":31322,"_21467":122176,"_28174":122177,"_3058":122178},[],"/docs/es/platform/iot-fleets/device-management#crea-el-dispositivo","Crea el dispositivo",{"_3602":73133,"_30987":73127,"_5":31322,"_21467":122180,"_28174":122181,"_3058":122182},[],"/docs/es/platform/iot-fleets/device-management#define-su-pertenencia","Define su pertenencia",{"_3602":73134,"_30987":73127,"_5":31322,"_21467":122184,"_28174":122185,"_3058":122186},[],"/docs/es/platform/iot-fleets/device-management#clasifica-el-dispositivo","Clasifica el dispositivo",{"_3602":73135,"_30987":73127,"_5":31322,"_21467":122188,"_28174":122189,"_3058":122190},[],"/docs/es/platform/iot-fleets/device-management#verifica-el-alta","Verifica el alta",{"_3602":73136,"_30987":73127,"_5":31322,"_21467":122192,"_28174":122193,"_3058":122194},[],"/docs/es/platform/iot-fleets/device-management#asigna-una-identidad-manualmente","Asigna una identidad manualmente",{"_3602":73137,"_30987":73127,"_5":31322,"_21467":122196,"_28174":122197,"_3058":122198},[],"/docs/es/platform/iot-fleets/device-management#revoca-la-identidad-actual","Revoca la identidad actual",{"_3602":73138,"_30987":73127,"_5":31322,"_21467":122200,"_28174":122201,"_3058":122202},[],"/docs/es/platform/iot-fleets/device-management#retira-un-dispositivo","Retira un dispositivo",{"_3602":73139,"_30987":73127,"_5":31322,"_21467":122204,"_28174":122205,"_3058":122206},[],"/docs/es/platform/iot-fleets/device-management#automatiza-el-enrolamiento","Automatiza el enrolamiento",{"_3602":73140,"_30987":73127,"_21467":122208,"_5":14750,"_28174":73127,"_3058":122209},[],"Esta guía se dirige al operador de una flota. Necesitas permisos sobre dispositivos, DMS y certificados para las acciones que vayas a realizar. Una flota se organiza mediante esos recursos, etiquetas y metadatos; no se crea un objeto independiente de «flota».",{"_3602":73141,"_30987":73127,"_21467":122211,"_5":14750,"_28174":73127,"_3058":122212},[],"Cada dispositivo tiene un `Device ID`, un DMS propietario (`dms_owner`) y, cuando está aprovisionado, un slot de identidad con una versión activa y versiones anteriores. En los flujos descritos, mantén el `Common Name` de la CSR y del certificado igual al `Device ID`: la vinculación utiliza ese CN para actualizar el dispositivo.",{"_3602":73142,"_30987":73127,"_21467":122214,"_5":14750,"_28174":122165,"_3058":122215},[],"Vista operativa",{"_3602":73143,"_30987":73127,"_21467":122217,"_5":14750,"_28174":122165,"_3058":122218},[],"Interpretación",{"_3602":73144,"_30987":73127,"_21467":122220,"_5":14750,"_28174":122165,"_3058":53370},[],{"_3602":73145,"_30987":73127,"_21467":122222,"_5":14750,"_28174":122165,"_3058":122223},[],"Hay registro, pero todavía no hay identidad asociada.",{"_3602":73146,"_30987":73127,"_21467":122225,"_5":14750,"_28174":122165,"_3058":53376},[],{"_3602":73147,"_30987":73127,"_21467":122227,"_5":14750,"_28174":122165,"_3058":122228},[],"El slot está activo; comprueba además las fechas, estado y usos del certificado.",{"_3602":73148,"_30987":73127,"_21467":122230,"_5":14750,"_28174":122165,"_3058":53382},[],{"_3602":73149,"_30987":73127,"_21467":122232,"_5":14750,"_28174":122165,"_3058":122233},[],"La identidad está en la ventana operativa de renovación.",{"_3602":73150,"_30987":73127,"_21467":122235,"_5":14750,"_28174":122165,"_3058":53388},[],{"_3602":73151,"_30987":73127,"_21467":122237,"_5":14750,"_28174":122165,"_3058":122238},[],"Se aproxima al vencimiento según los umbrales configurados.",{"_3602":73152,"_30987":73127,"_21467":122240,"_5":14750,"_28174":122165,"_3058":53394},[],{"_3602":73153,"_30987":73127,"_21467":122242,"_5":14750,"_28174":122165,"_3058":122243},[],"La identidad ha vencido.",{"_3602":73154,"_30987":73127,"_21467":122245,"_5":14750,"_28174":122165,"_3058":53400},[],{"_3602":73155,"_30987":73127,"_21467":122247,"_5":14750,"_28174":122165,"_3058":122248},[],"La identidad está marcada como revocada.",{"_3602":73156,"_30987":73127,"_21467":122250,"_5":14750,"_28174":122165,"_3058":53406},[],{"_3602":73157,"_30987":73127,"_21467":122252,"_5":14750,"_28174":122165,"_3058":122253},[],"El registro está retirado y no vuelve al estado operativo mediante una actualización normal.",{"_3602":73158,"_30987":73127,"_21467":122255,"_5":14750,"_28174":122165,"_3058":122256},[],"Los estados de dispositivo, slot y certificado son distintos. Los eventos y trabajos pueden actualizar la vista después de guardar el certificado; una etiqueta **Active** no prueba aceptación por un consumidor.",{"_3602":73159,"_30987":73127,"_21467":122258,"_5":14750,"_28174":122169,"_3058":122259},[],"Filtra el inventario por ID, etiquetas y estado. Abre el detalle y registra DMS propietario, versión activa y serie del certificado actual.",{"_3602":73160,"_30987":73127,"_21467":122261,"_5":14750,"_28174":122169,"_3058":122262},[],"**Certificate History** relaciona versiones anteriores y actuales. Sustituir el slot no revoca por sí solo todas las versiones anteriores.",{"_3602":73161,"_30987":73127,"_21467":122264,"_5":14750,"_28174":122169,"_3058":122265},[],"**Device Event Timeline** ayuda a reconstruir altas, aprovisionamientos, renovaciones y cambios de estado. Un cambio puede haberse guardado aunque falle la persistencia de su evento; contrasta también el registro y los certificados.",{"_3602":73162,"_30987":73127,"_21467":122267,"_5":14750,"_28174":122169,"_3058":122268},[],"Compara esos datos con la identidad instalada en el dispositivo. Un slot actualizado en Lamassu no instala archivos en el equipo remoto.",{"_3602":73163,"_30987":73127,"_21467":122270,"_5":14750,"_28174":122173,"_3058":122271},[],"Utiliza este flujo para preparar inventario o asignar una identidad desde la consola. Necesitas un DMS existente.",{"_3602":73164,"_30987":73127,"_21467":122273,"_5":14750,"_28174":122177,"_3058":122274},[],"Desde **Managed Devices**, abre el registro. Confirma que el ID no exista en otro DMS: la búsqueda por ID no está limitada a una flota.",{"_3602":73165,"_30987":73127,"_21467":122276,"_5":14750,"_28174":122181,"_3058":122277},[],"Introduce el **Device ID** y selecciona el DMS que será su propietario. La etiqueta **Registration Authority** de la consola se refiere a ese DMS.",{"_3602":73166,"_30987":73127,"_21467":122279,"_5":14750,"_28174":122185,"_3058":122280},[],"Añade icono y etiquetas de modelo, entorno o ubicación según tu inventario.",{"_3602":73167,"_30987":73127,"_21467":122282,"_5":14750,"_28174":122189,"_3058":122283},[],"Vuelve a leer el dispositivo: debe tener el DMS previsto y estar en **No Identity**. Sigue Registro manual para completar la asignación.",{"_3602":73168,"_30987":73127,"_21467":122285,"_5":14750,"_28174":122189,"_3058":122286},[],"Prerregistrar no demuestra que `/simpleenroll` vaya a admitir la solicitud. Revisa la interacción con `enable_replaceable_enrollment` en Estrategias de aprovisionamiento.",{"_3602":73169,"_30987":73127,"_21467":122288,"_5":14750,"_28174":122193,"_3058":122289},[],"Desde **No Identity**, utiliza **Assign Identity**:",{"_3602":73170,"_30987":73127,"_21467":122291,"_5":14750,"_28174":122193,"_3058":122292},[],"Elige un certificado activo, vigente y adecuado para el consumidor, con `CN` exactamente igual al `Device ID`.",{"_3602":73171,"_30987":73127,"_21467":122294,"_5":14750,"_28174":122193,"_3058":122295},[],"Si no existe, **Issue New Instead** permite iniciar una emisión con la CA prevista. Revisa primero el perfil.",{"_3602":73172,"_30987":73127,"_21467":122297,"_5":14750,"_28174":122193,"_3058":122298},[],"Confirma y vuelve a consultar serie, versión activa e historial.",{"_3602":73173,"_30987":73127,"_21467":122300,"_5":14750,"_28174":122193,"_3058":122301},[],"Instala la pareja clave/certificado y las intermedias necesarias en el dispositivo, y prueba su uso.",{"_3602":73174,"_30987":73127,"_21467":122303,"_5":14750,"_28174":122193,"_3058":122304},[],"Emitir, vincular e instalar son pasos distintos. Si falla la operación, comprueba cuáles se guardaron antes de repetirla.",{"_3602":73175,"_30987":73127,"_21467":122306,"_5":14750,"_28174":122197,"_3058":122307},[],"Localiza la serie activa en el historial y revócala con una razón apropiada. Comprueba registro, publicación OCSP/CRL y rechazo de una conexión nueva en el consumidor con la guía de certificados.",{"_3602":73176,"_30987":73127,"_21467":122309,"_5":14750,"_28174":122197,"_3058":122310},[],"La revocación no elimina el dispositivo. Tampoco habilita automáticamente una nueva inscripción: la recuperación depende de su credencial, estado y política DMS. `CertificateHold` puede reactivarse bajo las condiciones de PKI; otras razones bloquean cambios posteriores del certificado.",{"_3602":73177,"_30987":73127,"_21467":122312,"_5":14750,"_28174":122201,"_3058":122313},[],"Antes de **Decommission**, inventaría identidades activas y anteriores, conexiones y permisos del destino. Prepara su retirada en el consumidor.",{"_3602":73178,"_30987":73127,"_21467":122315,"_5":14750,"_28174":122201,"_3058":122316},[],"El backend guarda **Decommissioned** e intenta revocar el certificado de la versión activa con `CessationOfOperation` si el slot no estaba expirado o revocado. No recorre todo el historial. La revocación diferida puede fallar después de guardar la baja; verifica su resultado por serie.",{"_3602":73179,"_30987":73127,"_21467":122318,"_5":14750,"_28174":122201,"_3058":122319},[],"El estado retirado protege las actualizaciones normales del dispositivo y su slot. No constituye una garantía de que toda solicitud EST sea rechazada antes de emitir: la vinculación puede omitir un dispositivo retirado sin devolver error. Confirma que no quedan certificados o permisos utilizables y bloquea nuevas admisiones en el control correspondiente.",{"_3602":73180,"_30987":73127,"_21467":122321,"_5":14750,"_28174":122201,"_3058":122322},[],"Conserva los registros según tu política de auditoría. No reutilices un ID retirado para ocultar el cambio de equipo.",{"_3602":73181,"_30987":73127,"_21467":122324,"_5":14750,"_28174":122205,"_3058":122325},[],"<Card title=\"Enrola y conecta un dispositivo\" description=\"Obtén una identidad desde el cliente y prueba mTLS.\" href=\"/docs/platform/iot-fleets/quickstarts/enroll-device\" />",{"_3602":73182,"_30987":73127,"_21467":122327,"_5":14750,"_28174":122205,"_3058":122328},[],"<Card title=\"Renovación y recuperación\" description=\"Instala el sucesor y trata fallos sin perder el estado conocido.\" href=\"/docs/platform/iot-fleets/enrollment/renewal-and-recovery\" />",{"_3602":73183,"_30987":73183,"_5":15110,"_3058":122330,"_31325":122331,"_21467":122333,"_28174":73183},"Identidad inicial y autenticación",[50623,121012,53307,122157,122332],"Enrolamiento con PKI",[],{"_3602":73184,"_30987":73183,"_21467":122335,"_5":14750,"_28174":73183,"_3058":122336},[],"Prepara confianza del servidor y pruebas de admisión para enroll y reenroll.",{"_3602":73185,"_30987":73183,"_5":31322,"_21467":122338,"_28174":122339,"_3058":122340},[],"/docs/es/platform/iot-fleets/enrollment/bootstrap-identity#confianza-inicial-del-servidor","Confianza inicial del servidor",{"_3602":73186,"_30987":73183,"_5":31322,"_21467":122342,"_28174":122343,"_3058":122344},[],"/docs/es/platform/iot-fleets/enrollment/bootstrap-identity#credencial-bootstrap","Credencial bootstrap",{"_3602":73187,"_30987":73183,"_5":31322,"_21467":122346,"_28174":122347,"_3058":122348},[],"/docs/es/platform/iot-fleets/enrollment/bootstrap-identity#modos-por-operación","Modos por operación",{"_3602":73188,"_30987":73183,"_5":31322,"_21467":122350,"_28174":122351,"_3058":122352},[],"/docs/es/platform/iot-fleets/enrollment/bootstrap-identity#contrato-del-webhook","Contrato del webhook",{"_3602":73189,"_30987":73183,"_5":31322,"_21467":122354,"_28174":122355,"_3058":122356},[],"/docs/es/platform/iot-fleets/enrollment/bootstrap-identity#revocación-y-comprobaciones","Revocación y comprobaciones",{"_3602":73190,"_30987":73183,"_21467":122358,"_5":14750,"_28174":73183,"_3058":122359},[],"Esta guía conecta al administrador DMS con quien fabrica o integra el dispositivo. Antes de solicitar su identidad operativa, el cliente debe poder autenticar al servidor EST y demostrar que tiene derecho a solicitar el ID previsto.",{"_3602":73191,"_30987":73183,"_21467":122361,"_5":14750,"_28174":122339,"_3058":122362},[],"Instala una raíz, cadena o pin previamente verificado mediante un canal confiable: fabricación, configuración aprobada o distribución autenticada. Ese material permite verificar TLS y el nombre del servidor antes de descargar `/cacerts`.",{"_3602":73192,"_30987":73183,"_21467":122364,"_5":14750,"_28174":122339,"_3058":122365},[],"No puedes obtener tu única prueba de confianza del mismo servidor todavía no autenticado. El certificado TLS del servidor EST, el certificado bootstrap y la CA emisora de la identidad operativa pueden pertenecer a jerarquías distintas.",{"_3602":73193,"_30987":73183,"_21467":122367,"_5":14750,"_28174":122343,"_3058":122368},[],"Con `CLIENT_CERTIFICATE`, el dispositivo presenta su certificado inicial y demuestra posesión de su clave en TLS. El DMS lo valida frente a sus CAs de admisión. En el flujo examinado, el validador recibe una credencial de hoja: configura y prueba el emisor directo para el caso sencillo; enviar más intermedias desde el cliente no demuestra que lleguen al servicio.",{"_3602":73194,"_30987":73183,"_21467":122370,"_5":14750,"_28174":122343,"_3058":122371},[],"Comprueba fechas, certificado y clave correspondientes y estado de revocación antes de provisionarlos. Una credencial compartida entre equipos identifica esa credencial compartida, no a un equipo concreto.",{"_3602":73195,"_30987":73183,"_21467":122373,"_5":14750,"_28174":122343,"_3058":122374},[],"En el primer enrolamiento, la validación mTLS no compara por sí sola el CN del bootstrap con el CN solicitado en la CSR. Si necesitas que un solicitante solo pueda pedir su propio `Device ID`, añade un control que vincule credencial e ID, por ejemplo el webhook combinado, y prueba una solicitud con otro CN. En reenrolamiento con certificado sí se compara su CN con el de la CSR; las comprobaciones posteriores utilizan la identidad activa registrada.",{"_3602":73196,"_30987":73183,"_21467":122376,"_5":14750,"_28174":122347,"_3058":122377},[],"Los cuatro modos se seleccionan independientemente para enrolamiento y reenrolamiento en DMS. La credencial utilizada al renovar depende de ese bloque; no presupongas que siempre será el bootstrap o que el webhook desaparezca.",{"_3602":73197,"_30987":73183,"_21467":122379,"_5":14750,"_28174":122347,"_3058":122380},[],"Un token OIDC de administración no es un modo EST nativo. Un webhook puede interpretar una cabecera de credencial que acuerdes con él; en ese caso la autorización la realiza ese servicio. En NO\\_AUTH, enviar un token no añade autenticación al DMS.",{"_3602":73198,"_30987":73183,"_21467":122382,"_5":14750,"_28174":122351,"_3058":122383},[],"El DMS envía el contexto de la operación al servicio configurado. El método procede de la configuración; acuerda su contrato antes de seleccionar POST o PUT. La espera de autorización tiene un valor inicial de 10 segundos, sustituido por un timeout positivo configurado. El DMS verifica el certificado del receptor salvo que se active `insecure_skip_verify` en la configuración del webhook — por defecto se verifica — y no sigue redirecciones, así que la URL configurada debe ser la final. La respuesta de autorización debe ser JSON de como máximo 1 MiB. Con la autenticación de Lamassu hacia el webhook configurada sobre `http://`, la API key o el bearer token viajan en texto claro, y mTLS no tiene efecto porque no hay handshake TLS, así que el certificado de cliente nunca se presenta; prefiere `https://`. Configura esas opciones en los ajustes del webhook externo de la guía DMS.",{"_3602":73199,"_30987":73183,"_21467":122385,"_5":14750,"_28174":122351,"_3058":122386},[],"Ejemplo de cuerpo:",{"_3602":73200,"_30987":73183,"_21467":122388,"_5":14750,"_28174":122351,"_3058":122389},[],"`csr` contiene **base64 del PEM**, a diferencia del cuerpo EST, que contiene base64 del DER. `http_request` recoge URL y primeras entradas de cabeceras del contexto HTTP disponible. El campo `operation` no se envía en este cuerpo; distingue enroll y reenroll mediante la ruta y la política configurada.",{"_3602":73201,"_30987":73183,"_21467":122391,"_5":14750,"_28174":122351,"_3058":122392},[],"El webhook debe verificar la credencial, su relación con `device_cn`, DMS, operación y política de admisión. Las cabeceras transportadas no son por sí mismas evidencia de confianza. La autenticación de **Lamassu hacia el webhook** es otra relación distinta que se configura en el cliente HTTP del servidor.",{"_3602":73202,"_30987":73183,"_21467":122394,"_5":14750,"_28174":122351,"_3058":122395},[],"La continuación requiere respuesta HTTP satisfactoria y JSON:",{"_3602":73203,"_30987":73183,"_21467":122397,"_5":14750,"_28174":122351,"_3058":122398},[],"Un `204` sin cuerpo no cumple el contrato. Rechazo, error de transporte, respuesta no interpretable o timeout abortan la autorización. En modo combinado, primero se valida el certificado y después se consulta el webhook. Consulta la especificación del webhook.",{"_3602":73204,"_30987":73183,"_21467":122400,"_5":14750,"_28174":122355,"_3058":122401},[],"El DMS busca primero el certificado en Lamassu; para uno externo intenta OCSP y CRL. Si no logra comprobar revocación, los validadores pueden continuar tratándolo como no revocado. El código tampoco permite asumir que todo estado externo distinto de Good se rechace. Verifica el comportamiento requerido con tu credencial y endpoint reales; no presentes esta comprobación como una política estricta garantizada para todas las fuentes.",{"_3602":73205,"_30987":73183,"_21467":122403,"_5":14750,"_28174":122355,"_3058":122404},[],"Prueba certificado permitido, certificado incorrecto, CN ajeno, webhook denegado, timeout y reenrolamiento bajo su propia política. Conserva el resultado y programa la retirada de las credenciales bootstrap cuando corresponda. Continúa con Cliente EST.",{"_3602":73206,"_30987":73206,"_5":15110,"_3058":122406,"_31325":122407,"_21467":122408,"_28174":73206},"Configura y opera el DMS",[50623,121012,53307,122157,122332],[],{"_3602":73207,"_30987":73206,"_21467":122410,"_5":14750,"_28174":73206,"_3058":122411},[],"Define registro, autenticación por operación, emisión, renovación y confianza distribuida.",{"_3602":73208,"_30987":73206,"_5":31322,"_21467":122413,"_28174":122414,"_3058":119546},[],"/docs/es/platform/iot-fleets/enrollment/dms#antes-de-empezar",{"_3602":73209,"_30987":73206,"_5":31322,"_21467":122416,"_28174":122417,"_3058":122418},[],"/docs/es/platform/iot-fleets/enrollment/dms#configura-un-dms","Configura un DMS",{"_3602":73210,"_30987":73206,"_5":31322,"_21467":122420,"_28174":122421,"_3058":122422},[],"/docs/es/platform/iot-fleets/enrollment/dms#identifica-la-flota","Identifica la flota",{"_3602":73211,"_30987":73206,"_5":31322,"_21467":122424,"_28174":122425,"_3058":122426},[],"/docs/es/platform/iot-fleets/enrollment/dms#selecciona-la-ca-de-enrolamiento","Selecciona la CA de enrolamiento",{"_3602":73212,"_30987":73206,"_5":31322,"_21467":122428,"_28174":122429,"_3058":122430},[],"/docs/es/platform/iot-fleets/enrollment/dms#configura-est","Configura EST",{"_3602":73213,"_30987":73206,"_5":31322,"_21467":122432,"_28174":122433,"_3058":122434},[],"/docs/es/platform/iot-fleets/enrollment/dms#distribuye-la-confianza","Distribuye la confianza",{"_3602":73214,"_30987":73206,"_5":31322,"_21467":122436,"_28174":122437,"_3058":122438},[],"/docs/es/platform/iot-fleets/enrollment/dms#verifica-los-endpoints","Verifica los endpoints",{"_3602":73215,"_30987":73206,"_5":31322,"_21467":122440,"_28174":122441,"_3058":122442},[],"/docs/es/platform/iot-fleets/enrollment/dms#configuración-de-enrollment","Configuración de enrollment",{"_3602":73216,"_30987":73206,"_5":31322,"_21467":122444,"_28174":122445,"_3058":53602},[],"/docs/es/platform/iot-fleets/enrollment/dms#enrollment-device-registration",{"_3602":73217,"_30987":73206,"_5":31322,"_21467":122447,"_28174":122448,"_3058":53606},[],"/docs/es/platform/iot-fleets/enrollment/dms#enrollment-settings",{"_3602":73218,"_30987":73206,"_5":31322,"_21467":122450,"_28174":122451,"_3058":122452},[],"/docs/es/platform/iot-fleets/enrollment/dms#autenticación-por-operación","Autenticación por operación",{"_3602":73219,"_30987":73206,"_5":31322,"_21467":122454,"_28174":122455,"_3058":122456},[],"/docs/es/platform/iot-fleets/enrollment/dms#ajustes-del-webhook-externo","Ajustes del webhook externo",{"_3602":73220,"_30987":73206,"_5":31322,"_21467":122458,"_28174":122459,"_3058":122460},[],"/docs/es/platform/iot-fleets/enrollment/dms#perfil-de-emisión","Perfil de emisión",{"_3602":73221,"_30987":73206,"_5":31322,"_21467":122462,"_28174":122463,"_3058":122464},[],"/docs/es/platform/iot-fleets/enrollment/dms#configuración-de-re-enrollment","Configuración de re-enrollment",{"_3602":73222,"_30987":73206,"_5":31322,"_21467":122466,"_28174":122467,"_3058":53626},[],"/docs/es/platform/iot-fleets/enrollment/dms#serverkeygen",{"_3602":73223,"_30987":73206,"_5":31322,"_21467":122469,"_28174":122470,"_3058":122471},[],"/docs/es/platform/iot-fleets/enrollment/dms#distribución-de-confianza","Distribución de confianza",{"_3602":73224,"_30987":73206,"_5":31322,"_21467":122473,"_28174":122474,"_3058":122475},[],"/docs/es/platform/iot-fleets/enrollment/dms#opera-el-inventario-de-dms","Opera el inventario de DMS",{"_3602":73225,"_30987":73206,"_5":31322,"_21467":122477,"_28174":122478,"_3058":122479},[],"/docs/es/platform/iot-fleets/enrollment/dms#integra-los-dispositivos","Integra los dispositivos",{"_3602":73226,"_30987":73206,"_21467":122481,"_5":14750,"_28174":73206,"_3058":122482},[],"Un &#x2A;*Device Management Service (DMS)** configura la admisión y el ciclo de identidad de sus dispositivos. Actúa como autoridad de registro; la CA indicada en `Enrollment CA` firma los certificados. Esta guía se dirige a quien administra esa política.",{"_3602":73227,"_30987":73206,"_21467":122484,"_5":14750,"_28174":122414,"_3058":122485},[],"Necesitas permisos para gestionar DMS, una CA activa con clave utilizable y un perfil de emisión probado. Acuerda con el integrador ID del dispositivo, credencial inicial, consumidor y ventana de renovación. Revisa la estrategia de aprovisionamiento antes de elegir registro y sustitución.",{"_3602":73228,"_30987":73206,"_21467":122487,"_5":14750,"_28174":122414,"_3058":122488},[],"Prepara confianza del servidor EST y acceso desde el dispositivo con Despliegue. La autenticación administrativa de tu operador no sustituye la autenticación EST del dispositivo.",{"_3602":73229,"_30987":73206,"_21467":122490,"_5":14750,"_28174":122421,"_3058":122491},[],"Crea el DMS con un nombre reconocible y conserva su ID. Las URLs EST utilizan ese identificador, no el nombre visible. Cada dispositivo conserva un DMS propietario.",{"_3602":73230,"_30987":73206,"_21467":122493,"_5":14750,"_28174":122425,"_3058":122494},[],"Elige **Enrollment CA** y un perfil explícito apropiado para la identidad final. Mantén CN compatible con `Device ID`. El certificado de prueba debe permitir el uso previsto y terminar dentro de la vigencia del emisor.",{"_3602":73231,"_30987":73206,"_21467":122496,"_5":14750,"_28174":122429,"_3058":122497},[],"Selecciona registro y autenticación del primer enrolamiento. Configura por separado la autenticación de reenrolamiento, sus umbrales y la retirada del certificado anterior. Deja ServerKeyGen deshabilitado si el cliente genera su clave.",{"_3602":73232,"_30987":73206,"_21467":122499,"_5":14750,"_28174":122433,"_3058":122500},[],"Selecciona los certificados que devolverá `/cacerts`. Incluye explícitamente las intermedias y raíces necesarias, sin confundir distribución con instalación automática de confianza.",{"_3602":73233,"_30987":73206,"_21467":122502,"_5":14750,"_28174":122437,"_3058":122503},[],"Guarda y vuelve a leer la configuración. Consulta `/cacerts`, realiza un enrolamiento permitido y otro rechazado, y comprueba dispositivo, serie e historial. Crear el DMS o descargar cacerts no demuestra que autenticación y emisión funcionen.",{"_3602":73234,"_30987":73206,"_21467":122505,"_5":14750,"_28174":122445,"_3058":122506},[],"`settings.enrollment_settings.registration_mode` permite `JITP` o `PRE_REGISTRATION`. En JITP se crea el dispositivo desconocido con el CN de la CSR como ID y el DMS como propietario. El `device_provisioning_profile` aporta etiquetas, metadatos e icono a ese alta.",{"_3602":73235,"_30987":73206,"_21467":122508,"_5":14750,"_28174":122445,"_3058":122509},[],"En PRE\\_REGISTRATION, el ID debe existir previamente. En el código examinado, un dispositivo existente pasa antes por el control de sustitución, incluso si no tiene identidad. Consulta las condiciones de prerregistro antes de utilizar este modo.",{"_3602":73236,"_30987":73206,"_21467":122511,"_5":14750,"_28174":122448,"_3058":122512},[],"Campo de `settings.enrollment_settings`",{"_3602":73237,"_30987":73206,"_21467":122514,"_5":14750,"_28174":122448,"_3058":122515},[],"Decisión",{"_3602":73238,"_30987":73206,"_21467":122517,"_5":14750,"_28174":122448,"_3058":53677},[],{"_3602":73239,"_30987":73206,"_21467":122519,"_5":14750,"_28174":122448,"_3058":122520},[],"`EST_RFC7030` para estas operaciones.",{"_3602":73240,"_30987":73206,"_21467":122522,"_5":14750,"_28174":122448,"_3058":53683},[],{"_3602":73241,"_30987":73206,"_21467":122524,"_5":14750,"_28174":122448,"_3058":122525},[],"ID de la CA que firmará.",{"_3602":73242,"_30987":73206,"_21467":122527,"_5":14750,"_28174":122448,"_3058":53689},[],{"_3602":73243,"_30987":73206,"_21467":122529,"_5":14750,"_28174":122448,"_3058":122530},[],"Mantén `true` para comprobar posesión de la clave de la CSR.",{"_3602":73244,"_30987":73206,"_21467":122532,"_5":14750,"_28174":122448,"_3058":53695},[],{"_3602":73245,"_30987":73206,"_21467":122534,"_5":14750,"_28174":122448,"_3058":122535},[],"Permite `/simpleenroll` para un ID existente del mismo DMS. Puede intentar revocar el anterior incluso si falla una fase posterior; no es un cambio atómico.",{"_3602":73246,"_30987":73206,"_21467":122537,"_5":14750,"_28174":122448,"_3058":53701},[],{"_3602":73247,"_30987":73206,"_21467":122539,"_5":14750,"_28174":122448,"_3058":122540},[],"Uno de los cuatro modos de autenticación.",{"_3602":73248,"_30987":73206,"_21467":122542,"_5":14750,"_28174":122448,"_3058":122543},[],"Si el ID pertenece a otro DMS, el enrolamiento inicial se rechaza. No actives sustitución como respuesta automática a un error; el diagnóstico distingue ID repetido, propiedad y cambios parciales.",{"_3602":73249,"_30987":73206,"_21467":122545,"_5":14750,"_28174":122451,"_3058":122546},[],"Los bloques son independientes:",{"_3602":73250,"_30987":73206,"_21467":122548,"_5":14750,"_28174":122451,"_3058":122549},[],"`settings.enrollment_settings.est_rfc7030_settings` para `/simpleenroll` y `/serverkeygen`.",{"_3602":73251,"_30987":73206,"_21467":122551,"_5":14750,"_28174":122451,"_3058":122552},[],"`settings.reenrollment_settings.est_rfc7030_settings` para `/simplereenroll`.",{"_3602":73252,"_30987":73206,"_21467":122554,"_5":14750,"_28174":122451,"_3058":53719},[],{"_3602":73253,"_30987":73206,"_21467":122556,"_5":14750,"_28174":122451,"_3058":122557},[],"Control aplicado en la operación configurada",{"_3602":73254,"_30987":73206,"_21467":122559,"_5":14750,"_28174":122451,"_3058":53725},[],{"_3602":73255,"_30987":73206,"_21467":122561,"_5":14750,"_28174":122451,"_3058":122562},[],"Validación del certificado presentado.",{"_3602":73256,"_30987":73206,"_21467":122564,"_5":14750,"_28174":122451,"_3058":53731},[],{"_3602":73257,"_30987":73206,"_21467":122566,"_5":14750,"_28174":122451,"_3058":122567},[],"Autorización del webhook configurado.",{"_3602":73258,"_30987":73206,"_21467":122569,"_5":14750,"_28174":122451,"_3058":53737},[],{"_3602":73259,"_30987":73206,"_21467":122571,"_5":14750,"_28174":122451,"_3058":122572},[],"Validación del certificado y, después, aprobación del webhook.",{"_3602":73260,"_30987":73206,"_21467":122574,"_5":14750,"_28174":122451,"_3058":53743},[],{"_3602":73261,"_30987":73206,"_21467":122576,"_5":14750,"_28174":122451,"_3058":122577},[],"Sin autenticación del solicitante por el DMS.",{"_3602":73262,"_30987":73206,"_21467":122579,"_5":14750,"_28174":122451,"_3058":122580},[],"Webhook y modo combinado también se ejecutan en reenrolamiento si se configuran en su bloque. No hay una degradación implícita a NO\\_AUTH en esos casos. Un modo ausente o no reconocido falla.",{"_3602":73263,"_30987":73206,"_21467":122582,"_5":14750,"_28174":122451,"_3058":122583},[],"Para mTLS inicial, `client_certificate_settings` contiene `validation_cas`, `allow_expired` y `chain_level_validation`. El flujo examinado recibe una credencial de certificado, no garantiza transportar todas las intermedias del handshake al validador. Para el caso directo, configura como CA de validación el emisor directo del bootstrap y prueba la ruta real del Gateway.",{"_3602":73264,"_30987":73206,"_21467":122585,"_5":14750,"_28174":122451,"_3058":122586},[],"En el reenrolamiento con certificado, el validador prueba primero la CA de enrolamiento y después las CAs listadas en `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`; esas son las CAs de validación de reenrolamiento. Esa lista es opcional porque la CA de enrolamiento siempre es confiable en el reenrolamiento, y cada bloque de ajustes consulta solo su propia `validation_cas`. Las CAs presentes solo en la `validation_cas` del bloque inicial no amplían la aceptación en reenrolamiento; durante una rotación de CAs, añade la CA de emisión anterior a la lista del bloque de reenrolamiento. El validador de reenrolamiento compara la hoja TLS presentada con esas CAs; los valores `chain_level_validation` y `allow_expired` del bloque de reenrolamiento se almacenan pero no se consultan, y el vencimiento lo rige `enable_expired_renewal`.",{"_3602":73265,"_30987":73206,"_21467":122588,"_5":14750,"_28174":122451,"_3058":122589},[],"Para el webhook, configura destino, autenticación de Lamassu hacia ese servicio, método y timeout. El contrato de autenticación explica la credencial del dispositivo y el cuerpo de la llamada. `NO_AUTH` no acredita propiedad del ID solicitado.",{"_3602":73266,"_30987":73206,"_21467":122591,"_5":14750,"_28174":122455,"_3058":122592},[],"Los modos de autenticación por webhook leen `external_webhook_settings` en el mismo bloque `est_rfc7030_settings`:",{"_3602":73267,"_30987":73206,"_21467":122594,"_5":14750,"_28174":122455,"_3058":122595},[],"Campo de `external_webhook_settings`",{"_3602":73268,"_30987":73206,"_21467":122597,"_5":14750,"_28174":122455,"_3058":122515},[],{"_3602":73269,"_30987":73206,"_21467":122599,"_5":14750,"_28174":122455,"_3058":53769},[],{"_3602":73270,"_30987":73206,"_21467":122601,"_5":14750,"_28174":122455,"_3058":122602},[],"URL absoluta `http` o `https` del receptor. Debe ser la URL final; no se siguen redirecciones.",{"_3602":73271,"_30987":73206,"_21467":122604,"_5":14750,"_28174":122455,"_3058":53775},[],{"_3602":73272,"_30987":73206,"_21467":122606,"_5":14750,"_28174":122455,"_3058":122607},[],"`POST` o `PUT`; `POST` por defecto.",{"_3602":73273,"_30987":73206,"_21467":122609,"_5":14750,"_28174":122455,"_3058":53781},[],{"_3602":73274,"_30987":73206,"_21467":122611,"_5":14750,"_28174":122455,"_3058":122612},[],"Etiqueta usada en los logs del servicio.",{"_3602":73275,"_30987":73206,"_21467":122614,"_5":14750,"_28174":122455,"_3058":53787},[],{"_3602":73276,"_30987":73206,"_21467":122616,"_5":14750,"_28174":122455,"_3058":122617},[],"`noauth`, `apikey`, `jwt` o `mtls`. Un valor ausente o desconocido se comporta como `noauth`.",{"_3602":73277,"_30987":73206,"_21467":122619,"_5":14750,"_28174":122455,"_3058":53793},[],{"_3602":73278,"_30987":73206,"_21467":122621,"_5":14750,"_28174":122455,"_3058":122622},[],"Nivel de log de la llamada del webhook: `debug`, `info`, `warn` o `error`; `info` por defecto.",{"_3602":73279,"_30987":73206,"_21467":122624,"_5":14750,"_28174":122455,"_3058":53799},[],{"_3602":73280,"_30987":73206,"_21467":122626,"_5":14750,"_28174":122455,"_3058":122627},[],"Obligatorios para `apikey`: `header` y `key`. Los nombres de cabecera reservados se rechazan.",{"_3602":73281,"_30987":73206,"_21467":122629,"_5":14750,"_28174":122455,"_3058":53805},[],{"_3602":73282,"_30987":73206,"_21467":122631,"_5":14750,"_28174":122455,"_3058":122632},[],"Obligatorios para `jwt`: `oidc_client_id`, `oidc_client_secret` y un `oidc_well_known` absoluto `http` o `https`.",{"_3602":73283,"_30987":73206,"_21467":122634,"_5":14750,"_28174":122455,"_3058":53811},[],{"_3602":73284,"_30987":73206,"_21467":122636,"_5":14750,"_28174":122455,"_3058":122637},[],"Obligatorios para `mtls`: `cert_content` y `key_content` como PEM codificado en Base64, como el resto de certificados de la API; también se acepta el PEM en claro.",{"_3602":73285,"_30987":73206,"_21467":122639,"_5":14750,"_28174":122455,"_3058":53817},[],{"_3602":73286,"_30987":73206,"_21467":122641,"_5":14750,"_28174":122455,"_3058":122642},[],"Con `true`, omite la verificación del certificado del receptor. Por defecto se verifica. A diferencia de los canales de alertas, este ajuste se respeta aquí.",{"_3602":73287,"_30987":73206,"_21467":122644,"_5":14750,"_28174":122455,"_3058":53823},[],{"_3602":73288,"_30987":73206,"_21467":122646,"_5":14750,"_28174":122455,"_3058":122647},[],"Duración máxima de la llamada de autorización (por ejemplo `10s`); 10 segundos por defecto.",{"_3602":73289,"_30987":73206,"_21467":122649,"_5":14750,"_28174":122455,"_3058":122650},[],"Reglas de esa configuración:",{"_3602":73290,"_30987":73206,"_21467":122652,"_5":14750,"_28174":122455,"_3058":122653},[],"Crear o actualizar un DMS cuyo `auth_mode` de enrolamiento o reenrolamiento use el webhook valida el bloque y devuelve HTTP 400 — el cuerpo empieza por `struct validation error:` y continúa con `invalid enrollment external webhook config` o `invalid reenrollment external webhook config` — cuando la URL, el método o las opciones no son válidos. Eso incluye un par `mtls_options.cert_content`/`key_content` que no se corresponde con un certificado y una clave privada coincidentes. Las referencias a archivos (`ca_cert_file`, `mtls_options.cert_file`, `mtls_options.key_file`) siempre son inválidas: el servicio no lee archivos, así que introduce el certificado y la clave como PEM codificado en Base64 en `mtls_options.cert_content` y `key_content`, o como PEM en claro.",{"_3602":73291,"_30987":73206,"_21467":122655,"_5":14750,"_28174":122455,"_3058":122656},[],"Un `apikey_options.header` propio no puede usar nombres en los que la plataforma o el servicio receptor confían — por ejemplo `X-Principal-Id`, `X-Request-Id`, `Host`, `Content-Type` o `Forwarded` — y ningún nombre puede empezar por `X-Forwarded-`, `X-Envoy-` o `X-Lms-` (sin distinguir mayúsculas). La referencia de la API DMS documenta los esquemas `WebhookCall` y `WebhookCallHttpClient` y que las cabeceras API-key reservadas se rechazan.",{"_3602":73292,"_30987":73206,"_21467":122658,"_5":14750,"_28174":122455,"_3058":122659},[],"La clave anidada `http_client` existe solo en las configuraciones de canales de alertas; en un cuerpo de DMS se ignora. La clave de DMS es `external_webhook_settings.config`.",{"_3602":73293,"_30987":73206,"_21467":122661,"_5":14750,"_28174":122455,"_3058":122662},[],"Un cuerpo con `config.auth_mode` establecido a `apikey`, `jwt` o `mtls` debe llevar su bloque de opciones correspondiente (`apikey_options`, `jwt_options` o `mtls_options`) — y nada más. Los cuerpos con esos modos de autenticación que solo contengan `apikey`, `oidc` o `mtls` fallan la validación con 400, y `validate_server_cert` siempre se ignora: usa `insecure_skip_verify`. Solo se aceptan como `noauth` los cuerpos sin bloques de opciones, y sus credenciales se descartan.",{"_3602":73294,"_30987":73206,"_21467":122664,"_5":14750,"_28174":122455,"_3058":122665},[],"La respuesta de autorización debe ser JSON de como máximo 1 MiB; un cuerpo mayor hace fallar la llamada.",{"_3602":73295,"_30987":73206,"_21467":122667,"_5":14750,"_28174":122455,"_3058":122668},[],"Si hay credenciales configuradas, se envían sea cual sea el esquema de la URL: un webhook `http://` recibe la API key o el bearer token en claro, y mTLS no tiene efecto porque no hay handshake TLS, así que el certificado de cliente nunca se presenta. Usa preferentemente `https://` en `url`, en `oidc_well_known` y en el endpoint de token que este anuncia.",{"_3602":73296,"_30987":73206,"_21467":122670,"_5":14750,"_28174":122455,"_3058":122671},[],"La autenticación inicial y los ajustes de renovación se almacenan por separado. Si un DMS solo tiene el bloque de autenticación inicial, la renovación lo reutiliza: lee ambos bloques antes de editar. La consola expone editores independientes para la autenticación de enrolamiento y de reenrolamiento, con los mismos campos Log Level, Call Timeout, HTTP Authentication y credenciales que los canales webhook, además de un interruptor **Skip TLS Verification** (desactivado por defecto, así que la verificación permanece activa; la consola avisa cuando lo activas).",{"_3602":73297,"_30987":73206,"_21467":122673,"_5":14750,"_28174":122455,"_3058":122674},[],"Las credenciales del webhook deben almacenarse como contenido PEM. Las referencias a archivos (`ca_cert_file`, `mtls_options.cert_file`, `mtls_options.key_file`) nunca son válidas en una configuración de webhook almacenada: la entrega rechaza cualquier configuración de webhook que haga referencia a archivos, sea cual sea su modo de autenticación, por lo que todos los enroll y reenroll que llaman a ese webhook fallan hasta que el certificado y la clave se introduzcan como contenido PEM, en Base64 o plano, en `mtls_options.cert_content` y `key_content`, o se eliminen los campos de archivo si el webhook no usa mTLS. Si una configuración almacenada guarda rutas de archivos en `mtls_options.cert_content` o `key_content`, toda actualización completa de ajustes (`POST /v1/dms`, `PUT /v1/dms/:id`) falla la validación — los ajustes se sustituyen al completo, así que la configuración almacenada debe reenviarse — hasta que esos valores se sustituyan por contenido PEM o el webhook deje de usarse. Mientras tanto, la entrega de ese webhook falla en cada llamada; una actualización solo de metadatos mediante `PUT` o `PATCH` en `/v1/dms/:id/metadata` sigue funcionando. Para corregirlo en la consola, abre el DMS, sustituye cualquier valor de ruta de fichero por contenido PEM — el editor rechaza las rutas de fichero con un error en el propio campo — y guarda. Al guardar se reescribe `external_webhook_settings.config` con las claves actuales, y la consola lee tanto el PEM sin codificar como el codificado en Base64 de las configuraciones migradas, y almacena el material codificado en Base64. Si tu configuración almacenada se apoyaba antes en `validate_server_cert: false`, ahora lleva `insecure_skip_verify: true`: la verificación del certificado del receptor sigue sin realizarse hasta que pongas ese flag a `false`. Consulta 3.8.0 a 4.0.0 para las notas de actualización y la lista de verificación del operador.",{"_3602":73298,"_30987":73206,"_21467":122676,"_5":14750,"_28174":122455,"_3058":122677},[],"El conjunto de confianza del reenrolamiento vive en `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`. El campo plano `reenrollment_settings.additional_validation_cas` no forma parte de la API: los cuerpos que lo contienen se aceptan, pero su valor se ignora en silencio — los campos JSON desconocidos se descartan — y las respuestas GET no lo incluyen. Lee el DMS antes de enviar ediciones por API: un cuerpo de actualización construido con ese campo plano vacía en silencio `validation_cas`.",{"_3602":73299,"_30987":73206,"_21467":122679,"_5":14750,"_28174":122459,"_3058":122680},[],"`settings.issuance_profile_id` tiene precedencia sobre `settings.issuance_profile`; si ninguno existe, se utiliza el perfil predeterminado de la CA. El perfil resuelto — incluido el perfil predeterminado de la CA, que se usa como alternativa cuando el DMS no define ninguno — debe definir un certificado final: un perfil con `Sign as CA` se rechaza en el enrolamiento y en el reenrolamiento. Las reglas se documentan una sola vez en Perfiles. Cambiar un DMS afecta a solicitudes futuras; no modifica certificados ya firmados ni instala confianza en clientes.",{"_3602":73300,"_30987":73206,"_21467":122682,"_5":14750,"_28174":122463,"_3058":122683},[],"Campo de `settings.reenrollment_settings`",{"_3602":73301,"_30987":73206,"_21467":122685,"_5":14750,"_28174":122463,"_3058":122686},[],"Función",{"_3602":73302,"_30987":73206,"_21467":122688,"_5":14750,"_28174":122463,"_3058":53867},[],{"_3602":73303,"_30987":73206,"_21467":122690,"_5":14750,"_28174":122463,"_3058":122691},[],"La ventana abre en `NotAfter` del certificado activo menos este delta.",{"_3602":73304,"_30987":73206,"_21467":122693,"_5":14750,"_28174":122463,"_3058":53873},[],{"_3602":73305,"_30987":73206,"_21467":122695,"_5":14750,"_28174":122463,"_3058":122696},[],"Umbral operativo preventivo de monitorización.",{"_3602":73306,"_30987":73206,"_21467":122698,"_5":14750,"_28174":122463,"_3058":53879},[],{"_3602":73307,"_30987":73206,"_21467":122700,"_5":14750,"_28174":122463,"_3058":122701},[],"Umbral operativo crítico de monitorización.",{"_3602":73308,"_30987":73206,"_21467":122703,"_5":14750,"_28174":122463,"_3058":53885},[],{"_3602":73309,"_30987":73206,"_21467":122705,"_5":14750,"_28174":122463,"_3058":122706},[],"Aceptación de un certificado presentado vencido en el validador mTLS de renovación. No autoriza por sí solo otro modo ni elimina restricciones del Gateway.",{"_3602":73310,"_30987":73206,"_21467":122708,"_5":14750,"_28174":122463,"_3058":53891},[],{"_3602":73311,"_30987":73206,"_21467":122710,"_5":14750,"_28174":122463,"_3058":122711},[],"CAs de validación de reenrolamiento para la credencial mTLS de renovación, probadas después de la CA de enrolamiento; opcional, porque la CA de enrolamiento siempre es confiable. Suelen poblarse durante la rotación de CAs mientras las cohortes con certificados antiguos se renuevan.",{"_3602":73312,"_30987":73206,"_21467":122713,"_5":14750,"_28174":122463,"_3058":53897},[],{"_3602":73313,"_30987":73206,"_21467":122715,"_5":14750,"_28174":122463,"_3058":122716},[],"Si el certificado anterior está ACTIVE, intenta revocarlo con Superseded antes de vincular el sucesor.",{"_3602":73314,"_30987":73206,"_21467":122718,"_5":14750,"_28174":122463,"_3058":122719},[],"Monitorizar no renueva: el cliente debe programar la solicitud y la instalación. En modos webhook o NO\\_AUTH, la política de credencial vencida no pasa por el mismo validador mTLS; el webhook debe autorizar explícitamente la recuperación que admita. Revisa Renovación y recuperación para orden de operaciones y fallos parciales.",{"_3602":73315,"_30987":73206,"_21467":122721,"_5":14750,"_28174":122467,"_3058":122722},[],"`settings.server_keygen_settings.enabled` habilita generación software en el servidor. La consola lo expone mediante un interruptor **Enable server-side key generation** y una selección de **Key type**: `ECDSA` P-256, P-384 o P-521, o `RSA` de 2048, 3072 o 4096 bits; los valores predeterminados son P-256 para `ECDSA` y 4096 bits para `RSA`. Algoritmo y tamaño proceden de su campo `key`, que se guarda como `{type,bits}` donde P-256, P-384 y P-521 equivalen a `bits` 256, 384 y 521; `key` se omite cuando está deshabilitado. El perfil de emisión debe permitirlos. La respuesta contiene una clave PKCS#8 sin cifrar dentro de TLS, además del certificado. Consulta formato y extracción en Referencia EST.",{"_3602":73316,"_30987":73206,"_21467":122724,"_5":14750,"_28174":122470,"_3058":119910},[],{"_3602":73317,"_30987":73206,"_21467":122726,"_5":14750,"_28174":122470,"_3058":122727},[],"Qué publica",{"_3602":73318,"_30987":73206,"_21467":122729,"_5":14750,"_28174":122470,"_3058":53914},[],{"_3602":73319,"_30987":73206,"_21467":122731,"_5":14750,"_28174":122470,"_3058":122732},[],"Certificado TLS downstream disponible; puede ser una hoja, no una CA de emisión.",{"_3602":73320,"_30987":73206,"_21467":122734,"_5":14750,"_28174":122470,"_3058":53920},[],{"_3602":73321,"_30987":73206,"_21467":122736,"_5":14750,"_28174":122470,"_3058":122737},[],"Certificado de la CA emisora seleccionada.",{"_3602":73322,"_30987":73206,"_21467":122739,"_5":14750,"_28174":122470,"_3058":53926},[],{"_3602":73323,"_30987":73206,"_21467":122741,"_5":14750,"_28174":122470,"_3058":122742},[],"Certificados de las CAs elegidas explícitamente.",{"_3602":73324,"_30987":73206,"_21467":122744,"_5":14750,"_28174":122470,"_3058":122745},[],"No se añaden todos los ascendientes automáticamente. La distribución de confianza distingue raíces confiables, intermedias y confianza inicial del servidor.",{"_3602":73325,"_30987":73206,"_21467":122747,"_5":14750,"_28174":122474,"_3058":122748},[],"**Edit** cambia nombre, ajustes y metadatos. Las actualizaciones se realizan mediante la API de DMS. `PUT /v1/dms/{id}` siempre actúa sobre el DMS identificado en la ruta de la URL: el cuerpo no lleva campo `id`, y cualquier `id` o `creation_ts` que contenga se ignora silenciosamente; la autorización se evalúa contra ese mismo identificador de la ruta. El cuerpo debe incluir un `name` no vacío y un objeto `settings`; si falta alguno, la respuesta es HTTP 400 y el DMS almacenado no se modifica. `name` y `settings` se sustituyen siempre por completo, así que lee el DMS antes de enviar una edición por API para no perder campos. `metadata` es opcional: si se omite o se envía `null`, se conservan los metadatos almacenados; un objeto suministrado los sustituye por completo; `{}` los borra (una consulta GET posterior devuelve un objeto vacío, no `null`). Los cuerpos al estilo antiguo que transportan el DMS completo siguen funcionando mientras incluyan `name` y `settings`; los campos desconocidos se ignoran. La actualización rechaza un `name` vacío con HTTP 400: un DMS cuyo nombre almacenado quedó vacío por una actualización anterior debe renombrarse antes de que cualquier cliente lo vuelva a leer y reenviar, incluida la escritura de vuelta del conector de AWS IoT en modo JITP. Si el objeto no incluye la clave del conector de AWS IoT (`lamassu.io/iot/{connector_id}`), el conector ignora los eventos siguientes del DMS.",{"_3602":73326,"_30987":73206,"_21467":122750,"_5":14750,"_28174":122474,"_3058":122751},[],"**Go to DMS owned devices** limita el inventario al propietario. **Show/Edit Metadata** contiene datos operativos y de integraciones; consulta su guía antes de alterarlos. &#x2A;*EST (RFC-7030)** ayuda a localizar las URLs.",{"_3602":73327,"_30987":73206,"_21467":122753,"_5":14750,"_28174":122474,"_3058":122754},[],"**Delete** elimina el registro y la configuración del DMS; no realiza por sí solo una cascada de revocación sobre todos sus dispositivos y certificados. Migra dependencias y conserva las referencias de auditoría antes de retirarlo.",{"_3602":73328,"_30987":73206,"_21467":122756,"_5":14750,"_28174":122478,"_3058":122757},[],"Continúa con Cliente EST o el tutorial de enrolamiento y mTLS. La Referencia EST recoge formatos; Diagnóstico recoge fallos.",{"_3602":73329,"_30987":73329,"_5":15110,"_3058":122759,"_31325":122760,"_21467":122761,"_28174":73329},"Integra el cliente EST",[50623,121012,53307,122157,122332],[],{"_3602":73330,"_30987":73329,"_21467":122763,"_5":14750,"_28174":73329,"_3058":122764},[],"Prepara la confianza, envía una CSR y comprueba la identidad recibida.",{"_3602":73331,"_30987":73329,"_5":31322,"_21467":122766,"_28174":122767,"_3058":119546},[],"/docs/es/platform/iot-fleets/enrollment/est-client#antes-de-empezar",{"_3602":73332,"_30987":73329,"_5":31322,"_21467":122769,"_28174":122770,"_3058":122771},[],"/docs/es/platform/iot-fleets/enrollment/est-client#descarga-e-inspecciona-cacerts","Descarga e inspecciona cacerts",{"_3602":73333,"_30987":73329,"_5":31322,"_21467":122773,"_28174":122774,"_3058":122775},[],"/docs/es/platform/iot-fleets/enrollment/est-client#prepara-la-csr","Prepara la CSR",{"_3602":73334,"_30987":73329,"_5":31322,"_21467":122777,"_28174":122778,"_3058":122779},[],"/docs/es/platform/iot-fleets/enrollment/est-client#solicita-la-identidad","Solicita la identidad",{"_3602":73335,"_30987":73329,"_5":31322,"_21467":122781,"_28174":122782,"_3058":122783},[],"/docs/es/platform/iot-fleets/enrollment/est-client#comprueba-e-instala-el-resultado","Comprueba e instala el resultado",{"_3602":73336,"_30987":73329,"_5":31322,"_21467":122785,"_28174":122786,"_3058":122787},[],"/docs/es/platform/iot-fleets/enrollment/est-client#siguientes-pasos","Siguientes pasos",{"_3602":73337,"_30987":73329,"_21467":122789,"_5":14750,"_28174":73329,"_3058":122790},[],"Esta guía es para quien implementa el cliente del dispositivo. El administrador debe haber preparado la política DMS. Para una primera ejecución completa, sigue Enrola y conecta tu primer dispositivo.",{"_3602":73338,"_30987":73329,"_21467":122792,"_5":14750,"_28174":122767,"_3058":122793},[],"Necesitas el URL HTTPS público del DMS, la confianza del servidor obtenida por un canal aprobado, el modo de autenticación de la operación y un identificador admitido. Los ejemplos usan Bash, OpenSSL 3.x y curl con `--fail-with-body`; utiliza un directorio privado de trabajo y una versión compatible de esas herramientas.",{"_3602":73339,"_30987":73329,"_21467":122795,"_5":14750,"_28174":122767,"_3058":122796},[],"Prepara `est-trust.pem` para verificar al servidor EST, `bootstrap.crt` y `bootstrap.key` para la autenticación inicial por certificado, y `device-root.pem` como raíz aprobada del emisor de dispositivos. Los dos archivos de confianza pueden contener raíces distintas. Si usas otra autenticación, adapta las credenciales según Identidad inicial.",{"_3602":73340,"_30987":73329,"_21467":122798,"_5":14750,"_28174":122767,"_3058":122799},[],"Sustituye el host y `REPLACE_DMS_ID` por los de tu instalación. El APS del URL es el identificador del DMS, no su nombre visible.",{"_3602":73341,"_30987":73329,"_21467":122801,"_5":14750,"_28174":122770,"_3058":122802},[],"El contenido predeterminado es PKCS#7 DER codificado en Base64. No es un archivo PEM directo.",{"_3602":73342,"_30987":73329,"_21467":122804,"_5":14750,"_28174":122770,"_3058":122805},[],"Comprueba las huellas, emisores y fechas frente a la política de distribución de confianza. La respuesta puede contener una selección de CAs y el certificado TLS de Lamassu. No conviertas todo el contenido en raíces confiables ni lo utilices para autenticar la misma descarga inicial. Un HTTP 200 aquí no demuestra que la autenticación ni la emisión funcionen.",{"_3602":73343,"_30987":73329,"_21467":122807,"_5":14750,"_28174":122774,"_3058":122808},[],"El ejemplo genera una clave EC P-256 nueva y usa `est-device-001`, que debe estar libre si el DMS registra automáticamente. El `Common Name` será el identificador del dispositivo. Comprueba que el perfil permite la clave y el sujeto elegidos.",{"_3602":73344,"_30987":73329,"_21467":122810,"_5":14750,"_28174":122774,"_3058":122811},[],"Una implementación con hardware o almacén propio debe producir la CSR mediante su clave residente. `simpleenroll` envía la solicitud y conserva la clave en el cliente. Honor Extensions no autoriza todos los atributos pedidos: consulta Perfiles.",{"_3602":73345,"_30987":73329,"_21467":122813,"_5":14750,"_28174":122778,"_3058":122814},[],"Con autenticación inicial `CLIENT_CERTIFICATE`, envía la CSR DER en Base64 con `Content-Type: application/pkcs10`:",{"_3602":73346,"_30987":73329,"_21467":122816,"_5":14750,"_28174":122778,"_3058":122817},[],"Detén el proceso si curl falla. Conserva el código HTTP, cabeceras y cuerpo para el diagnóstico; una respuesta de error no se decodifica como certificado. El ejemplo Bash se detiene antes de esa conversión. Un timeout deja el resultado de la operación por comprobar en Lamassu: no repitas automáticamente una emisión.",{"_3602":73347,"_30987":73329,"_21467":122819,"_5":14750,"_28174":122782,"_3058":122820},[],"Para el caso de una raíz que emite directamente:",{"_3602":73348,"_30987":73329,"_21467":122822,"_5":14750,"_28174":122782,"_3058":122823},[],"Verifica además que el CN es el esperado, el certificado es final, los usos permiten tu aplicación y las fechas satisfacen el perfil. `cmp` debe terminar con código 0. Si hay intermedias, aporta la cadena con `-untrusted` según Validación PKI.",{"_3602":73349,"_30987":73329,"_21467":122825,"_5":14750,"_28174":122782,"_3058":122826},[],"Consulta el dispositivo: DMS propietario, número de serie actual e historial deben corresponder al resultado. Guarda la pareja clave/certificado de forma protegida e instala ambos mediante el mecanismo del dispositivo. La asociación en Lamassu no instala archivos en el cliente. Comprueba una conexión real antes de considerar terminado el proceso.",{"_3602":73350,"_30987":73329,"_21467":122828,"_5":14750,"_28174":122786,"_3058":122829},[],"Implementa renovación y recuperación y la actualización de confianza. La referencia EST recoge endpoints, formatos y ServerKeyGen; el diagnóstico ayuda a distinguir errores de transporte, admisión y persistencia.",{"_3602":73351,"_30987":73351,"_5":15110,"_3058":122831,"_31325":122832,"_21467":122833,"_28174":73351},"Referencia EST",[50623,121012,53307,122157,122332],[],{"_3602":73352,"_30987":73351,"_21467":122835,"_5":14750,"_28174":73351,"_3058":122836},[],"Consulta las rutas, formatos, autenticación y respuesta multipart de Lamassu.",{"_3602":73353,"_30987":73351,"_5":31322,"_21467":122838,"_28174":122839,"_3058":122840},[],"/docs/es/platform/iot-fleets/enrollment/est-reference#referencia-de-endpoints","Referencia de endpoints",{"_3602":73354,"_30987":73351,"_5":31322,"_21467":122842,"_28174":122843,"_3058":23264},[],"/docs/es/platform/iot-fleets/enrollment/est-reference#cacerts",{"_3602":73355,"_30987":73351,"_5":31322,"_21467":122845,"_28174":122846,"_3058":26730},[],"/docs/es/platform/iot-fleets/enrollment/est-reference#simpleenroll",{"_3602":73356,"_30987":73351,"_5":31322,"_21467":122848,"_28174":122849,"_3058":26737},[],"/docs/es/platform/iot-fleets/enrollment/est-reference#simplereenroll",{"_3602":73357,"_30987":73351,"_5":31322,"_21467":122851,"_28174":122852,"_3058":26015},[],"/docs/es/platform/iot-fleets/enrollment/est-reference#serverkeygen",{"_3602":73358,"_30987":73351,"_5":31322,"_21467":122854,"_28174":122855,"_3058":122856},[],"/docs/es/platform/iot-fleets/enrollment/est-reference#formato-de-respuesta","Formato de respuesta",{"_3602":73359,"_30987":73351,"_5":31322,"_21467":122858,"_28174":122859,"_3058":122860},[],"/docs/es/platform/iot-fleets/enrollment/est-reference#solicitud-y-extracción","Solicitud y extracción",{"_3602":73360,"_30987":73351,"_5":31322,"_21467":122862,"_28174":122863,"_3058":122864},[],"/docs/es/platform/iot-fleets/enrollment/est-reference#notas-de-compatibilidad","Notas de compatibilidad",{"_3602":73361,"_30987":73351,"_21467":122866,"_5":14750,"_28174":73351,"_3058":122867},[],"Referencia del contrato del backend examinado, basada en RFC 7030. Utiliza Cliente EST para el procedimiento y DMS para configurar la política.",{"_3602":73362,"_30987":73351,"_21467":122869,"_5":14750,"_28174":122839,"_3058":122870},[],"Ruta pública de los ejemplos: `/.well-known/est/{APS}/{operation}`. `APS` es el ID del DMS. El router admite rutas sin ese segmento, pero el controlador lo requiere; no las utilices como servicio predeterminado. La configuración del Gateway determina el host y la ruta públicos.",{"_3602":73363,"_30987":73351,"_21467":122872,"_5":14750,"_28174":122839,"_3058":120772},[],{"_3602":73364,"_30987":73351,"_21467":122874,"_5":14750,"_28174":122839,"_3058":122875},[],"Método",{"_3602":73365,"_30987":73351,"_21467":122877,"_5":14750,"_28174":122839,"_3058":122878},[],"Autenticación y condición",{"_3602":73366,"_30987":73351,"_21467":122880,"_5":14750,"_28174":122839,"_3058":54069},[],{"_3602":73367,"_30987":73351,"_21467":122882,"_5":14750,"_28174":122839,"_3058":54072},[],{"_3602":73368,"_30987":73351,"_21467":122884,"_5":14750,"_28174":122839,"_3058":122885},[],"La lectura DMS no exige credencial EST; HTTPS y controles de infraestructura siguen aplicándose.",{"_3602":73369,"_30987":73351,"_21467":122887,"_5":14750,"_28174":122839,"_3058":54078},[],{"_3602":73370,"_30987":73351,"_21467":122889,"_5":14750,"_28174":122839,"_3058":54081},[],{"_3602":73371,"_30987":73351,"_21467":122891,"_5":14750,"_28174":122839,"_3058":122892},[],"Autenticación inicial y política de registro/sustitución del DMS.",{"_3602":73372,"_30987":73351,"_21467":122894,"_5":14750,"_28174":122839,"_3058":54087},[],{"_3602":73373,"_30987":73351,"_21467":122896,"_5":14750,"_28174":122839,"_3058":54081},[],{"_3602":73374,"_30987":73351,"_21467":122898,"_5":14750,"_28174":122839,"_3058":122899},[],"Autenticación de renovación, identidad existente, sujeto, revocación y ventana.",{"_3602":73375,"_30987":73351,"_21467":122901,"_5":14750,"_28174":122839,"_3058":54095},[],{"_3602":73376,"_30987":73351,"_21467":122903,"_5":14750,"_28174":122839,"_3058":54081},[],{"_3602":73377,"_30987":73351,"_21467":122905,"_5":14750,"_28174":122839,"_3058":122906},[],"Autenticación y admisión iniciales; generación en servidor habilitada.",{"_3602":73378,"_30987":73351,"_21467":122908,"_5":14750,"_28174":122839,"_3058":122909},[],"Estas rutas no implementan `/csrattrs` ni `/fullcmc`. No hay un modo EST nativo de autenticación JWT; un webhook puede interpretar una credencial de la petición según su propio contrato.",{"_3602":73379,"_30987":73351,"_21467":122911,"_5":14750,"_28174":122843,"_3058":122912},[],"La respuesta predeterminada tiene `Content-Type: application/pkcs7-mime; smime-type=certs-only` y `Content-Transfer-Encoding: base64`. El cuerpo es PKCS#7 DER en Base64 con líneas de hasta 76 caracteres. Incluye los certificados seleccionados por el DMS, no necesariamente todos los ascendientes.",{"_3602":73380,"_30987":73351,"_21467":122914,"_5":14750,"_28174":122843,"_3058":122915},[],"`Accept: application/x-pem-file` solicita el conjunto en PEM mediante una extensión de Lamassu. Su contenido debe inspeccionarse y aprobarse antes de modificar raíces confiables.",{"_3602":73381,"_30987":73351,"_21467":122917,"_5":14750,"_28174":122846,"_3058":122918},[],"Envía una CSR PKCS#10 DER codificada en Base64, con `Content-Type: application/pkcs10`. El controlador examinado compara ese media type literalmente; evita añadir parámetros como charset. El CN identifica el dispositivo y la firma de la CSR debe verificarse mediante la política DMS.",{"_3602":73382,"_30987":73351,"_21467":122920,"_5":14750,"_28174":122846,"_3058":122921},[],"La respuesta predeterminada usa el formato PKCS#7/Base64 descrito para cacerts, pero contiene el certificado emitido; no presupongas que incluye toda su cadena. `Accept: application/x-pem-file` devuelve ese certificado en PEM. El cliente conserva la clave que firmó la CSR.",{"_3602":73383,"_30987":73351,"_21467":122923,"_5":14750,"_28174":122849,"_3058":122924},[],"Usa el mismo formato de solicitud y de certificado de respuesta. La autenticación se obtiene del bloque independiente `reenrollment_settings.est_rfc7030_settings`. Con certificado cliente, su CN debe coincidir con el CN de la CSR; también se comprueba el sujeto frente al certificado actual.",{"_3602":73384,"_30987":73351,"_21467":122926,"_5":14750,"_28174":122849,"_3058":122927},[],"En el modo mTLS, la CA de enrolamiento siempre valida la credencial de reenrolamiento; los certificados de otros emisores se aceptan solo si figuran como CAs de validación en el bloque de reenrolamiento. La comprobación de vencimiento por `enable_expired_renewal` corresponde a ese validador. El certificado actual revocado y una solicitud anterior a la ventana se rechazan. Consulta Renovación para instalación y recuperación.",{"_3602":73385,"_30987":73351,"_21467":122929,"_5":14750,"_28174":122852,"_3058":122930},[],"El servidor genera una clave software, reconstruye la CSR con esa clave y ejecuta el enrolamiento inicial. El flag debe estar habilitado y el algoritmo permitido por el perfil. La clave de esta operación no pasa a ser una clave hardware por utilizar una CA alojada en HSM.",{"_3602":73386,"_30987":73351,"_21467":122932,"_5":14750,"_28174":122852,"_3058":122933},[],"El código admite RSA y ECDSA, y el valor `bits` del ajuste de clave del DMS significa algo distinto en cada caso. En ECDSA selecciona la curva: 224, 256, 384 o 521 corresponden a P-224, P-256, P-384 y P-521, y un tamaño no reconocido produce fallback a P-256, así que elige explícitamente un tamaño compatible y comprueba la clave resultante. En RSA se usa directamente como tamaño del módulo; la consola ofrece 2048, 3072 y 4096 bits. No reutilices un ID enrolado para probar esta operación sin revisar sustitución.",{"_3602":73387,"_30987":73351,"_21467":122935,"_5":14750,"_28174":122855,"_3058":122936},[],"El cuerpo es **MIME multipart/mixed**, con boundary indicado en `Content-Type`. Tiene dos partes:",{"_3602":73388,"_30987":73351,"_21467":122938,"_5":14750,"_28174":122855,"_3058":122939},[],"Parte",{"_3602":73389,"_30987":73351,"_21467":122941,"_5":14750,"_28174":122855,"_3058":122942},[],"Contenido tras decodificar su Base64",{"_3602":73390,"_30987":73351,"_21467":122944,"_5":14750,"_28174":122855,"_3058":54139},[],{"_3602":73391,"_30987":73351,"_21467":122946,"_5":14750,"_28174":122855,"_3058":122947},[],"Clave privada PKCS#8 DER sin cifrar.",{"_3602":73392,"_30987":73351,"_21467":122949,"_5":14750,"_28174":122855,"_3058":54145},[],{"_3602":73393,"_30987":73351,"_21467":122951,"_5":14750,"_28174":122855,"_3058":122952},[],"PKCS#7 DER con el certificado emitido.",{"_3602":73394,"_30987":73351,"_21467":122954,"_5":14750,"_28174":122855,"_3058":122955},[],"El controlador también añade `Content-Transfer-Encoding: base64` en la cabecera exterior, aunque el cuerpo exterior es texto MIME. &#x2A;*No decodifiques el cuerpo completo como Base64.** Lee el boundary real y decodifica cada parte según sus cabeceras.",{"_3602":73395,"_30987":73351,"_21467":122957,"_5":14750,"_28174":122859,"_3058":122958},[],"En una sesión Bash con `set -euo pipefail` y `umask 077`, utiliza `EST_BASE` y los archivos de confianza/bootstrap de Cliente EST. Elige `est-serverkeygen-001` libre y admitido. La clave `server-request.key` solo firma la CSR de entrada; la identidad recibida utilizará la clave generada por el servidor.",{"_3602":73396,"_30987":73351,"_21467":122960,"_5":14750,"_28174":122859,"_3058":122961},[],"Guarda este extractor Python 3. Valida las dos partes antes de escribir y rechaza archivos de salida existentes:",{"_3602":73397,"_30987":73351,"_21467":122963,"_5":14750,"_28174":122859,"_3058":122964},[],"Convierte y comprueba el resultado:",{"_3602":73398,"_30987":73351,"_21467":122966,"_5":14750,"_28174":122859,"_3058":122967},[],"Inspecciona CN, serie, fechas y usos; comprueba la asociación en Lamassu antes de instalar. Protege los archivos DER y PEM que contienen la clave y elimina copias temporales según el almacenamiento del dispositivo. Consulta openssl-pkcs8 y el parser MIME de Python.",{"_3602":73399,"_30987":73351,"_21467":122969,"_5":14750,"_28174":122863,"_3058":122970},[],"No interpretes cualquier 500 como un fallo transitorio. La entrada inválida suele producir 400; rechazos y errores del servicio suelen producir 500 con un cuerpo JSON `err`. Los errores de Gateway y algunos caminos del controlador pueden tener otro formato. Conserva cabeceras y cuerpo antes de decodificar y consulta el diagnóstico.",{"_3602":73400,"_30987":73351,"_21467":122972,"_5":14750,"_28174":122863,"_3058":122973},[],"Los ejemplos utilizan openssl-pkcs7 para extraer certificados y openssl-x509 para preparar renovación. Comprueba capacidades y respuestas de tu versión antes de integrar un cliente EST genérico.",{"_3602":73401,"_30987":73401,"_5":15110,"_3058":122332,"_31325":122975,"_21467":122976,"_28174":73401},[50623,121012,53307,122157,122332],[],{"_3602":73402,"_30987":73401,"_21467":122978,"_5":14750,"_28174":73401,"_3058":122979},[],"Elige la política de admisión y conecta DMS, confianza inicial y cliente EST.",{"_3602":73403,"_30987":73401,"_5":31322,"_21467":122981,"_28174":122982,"_3058":122983},[],"/docs/es/platform/iot-fleets/enrollment/overview#el-recorrido","El recorrido",{"_3602":73404,"_30987":73401,"_5":31322,"_21467":122985,"_28174":122986,"_3058":122987},[],"/docs/es/platform/iot-fleets/enrollment/overview#para-el-administrador","Para el administrador",{"_3602":73405,"_30987":73401,"_5":31322,"_21467":122989,"_28174":122990,"_3058":122991},[],"/docs/es/platform/iot-fleets/enrollment/overview#para-el-integrador","Para el integrador",{"_3602":73406,"_30987":73401,"_5":31322,"_21467":122993,"_28174":122994,"_3058":122995},[],"/docs/es/platform/iot-fleets/enrollment/overview#versión-del-contrato","Versión del contrato",{"_3602":73407,"_30987":73401,"_21467":122997,"_5":14750,"_28174":73401,"_3058":122998},[],"Enrollment with PKI reúne el recorrido desde la admisión del dispositivo hasta la instalación y renovación de su identidad. El DMS actúa como autoridad de registro: autentica la solicitud, aplica la política de registro y pide a la CA que firme. El cliente conserva o recibe la clave, instala el resultado y lo presenta al consumidor.",{"_3602":73408,"_30987":73401,"_21467":123000,"_5":14750,"_28174":122982,"_3058":123001},[],"El administrador prepara CA, perfil de emisión y DMS.",{"_3602":73409,"_30987":73401,"_21467":123003,"_5":14750,"_28174":122982,"_3058":123004},[],"El integrador instala confianza inicial en el servidor EST y una credencial de admisión.",{"_3602":73410,"_30987":73401,"_21467":123006,"_5":14750,"_28174":122982,"_3058":123007},[],"El cliente solicita una identidad para su `Device ID` mediante EST.",{"_3602":73411,"_30987":73401,"_21467":123009,"_5":14750,"_28174":122982,"_3058":123010},[],"Se comprueban certificado, vinculación al dispositivo e instalación de la pareja clave/certificado.",{"_3602":73412,"_30987":73401,"_21467":123012,"_5":14750,"_28174":122982,"_3058":123013},[],"El consumidor valida y autoriza la identidad; el cliente programa renovación y recuperación.",{"_3602":73413,"_30987":73401,"_21467":123015,"_5":14750,"_28174":122982,"_3058":123016},[],"EST utiliza `/.well-known/est/{DMS_ID}`. Las APIs administrativas y la asignación manual siguen siendo recorridos distintos. Enrola y conecta un dispositivo completa una primera prueba con mTLS.",{"_3602":73414,"_30987":73401,"_21467":123018,"_5":14750,"_28174":122986,"_3058":123019},[],"<Card title=\"Estrategias de aprovisionamiento\" description=\"Elige registro automático, prerregistro o asignación manual.\" href=\"/docs/platform/iot-fleets/enrollment/provisioning-strategies\" />",{"_3602":73415,"_30987":73401,"_21467":123021,"_5":14750,"_28174":122986,"_3058":123022},[],"<Card title=\"Configura el DMS\" description=\"Separa admisión, autenticación por operación, perfil y distribución.\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_3602":73416,"_30987":73401,"_21467":123024,"_5":14750,"_28174":122986,"_3058":123025},[],"<Card title=\"Identidad inicial y autenticación\" description=\"Decide qué prueba permite solicitar la primera identidad.\" href=\"/docs/platform/iot-fleets/enrollment/bootstrap-identity\" />",{"_3602":73417,"_30987":73401,"_21467":123027,"_5":14750,"_28174":122986,"_3058":123028},[],"<Card title=\"Distribución de confianza\" description=\"Actualiza raíces y cadenas con un solapamiento comprobado.\" href=\"/docs/platform/iot-fleets/enrollment/trust-distribution\" />",{"_3602":73418,"_30987":73401,"_21467":123030,"_5":14750,"_28174":122990,"_3058":123031},[],"<Card title=\"Cliente EST\" description=\"Prepara la solicitud, verifica la respuesta e instala la identidad.\" href=\"/docs/platform/iot-fleets/enrollment/est-client\" />",{"_3602":73419,"_30987":73401,"_21467":123033,"_5":14750,"_28174":122990,"_3058":123034},[],"<Card title=\"Renovación y recuperación\" description=\"Genera el sucesor y trata credenciales vencidas o perdidas.\" href=\"/docs/platform/iot-fleets/enrollment/renewal-and-recovery\" />",{"_3602":73420,"_30987":73401,"_21467":123036,"_5":14750,"_28174":122990,"_3058":123037},[],"<Card title=\"Referencia EST\" description=\"Consulta rutas, formatos, autenticación y ServerKeyGen.\" href=\"/docs/platform/iot-fleets/enrollment/est-reference\" />",{"_3602":73421,"_30987":73401,"_21467":123039,"_5":14750,"_28174":122990,"_3058":123040},[],"<Card title=\"Diagnóstico\" description=\"Distingue fallos de transporte, política, emisión e instalación.\" href=\"/docs/platform/iot-fleets/enrollment/troubleshooting\" />",{"_3602":73422,"_30987":73401,"_21467":123042,"_5":14750,"_28174":122994,"_3058":123043},[],"Este bloque describe el código de `main` examinado en el commit `8f42c47157f9a36bac3ed5caa3692aebebe19c4b`. El catálogo del sitio publica `main (unstable)`; no se atribuye este comportamiento a una release estable. Antes de utilizar otra versión, comprueba su contrato, especialmente la autenticación independiente de reenrolamiento. Las comprobaciones de cliente y las pruebas contra una instancia se distinguen en el plan de revisión.",{"_3602":73423,"_30987":73401,"_21467":123045,"_5":14750,"_28174":122994,"_3058":123046},[],"La configuración del Gateway, TLS, proveedores y servicios pertenece a Despliegue. El uso de la identidad en AWS u otros destinos corresponde a Integraciones.",{"_3602":73424,"_30987":73424,"_5":15110,"_3058":123048,"_31325":123049,"_21467":123050,"_28174":73424},"Estrategias de aprovisionamiento",[50623,121012,53307,122157,122332],[],{"_3602":73425,"_30987":73424,"_21467":123052,"_5":14750,"_28174":73424,"_3058":123053},[],"Elige cómo se registra el dispositivo, quién autoriza su identidad y dónde se genera la clave.",{"_3602":73426,"_30987":73424,"_5":31322,"_21467":123055,"_28174":123056,"_3058":123057},[],"/docs/es/platform/iot-fleets/enrollment/provisioning-strategies#elige-el-registro","Elige el registro",{"_3602":73427,"_30987":73424,"_5":31322,"_21467":123059,"_28174":123060,"_3058":123061},[],"/docs/es/platform/iot-fleets/enrollment/provisioning-strategies#prerregistro-y-sustitución","Prerregistro y sustitución",{"_3602":73428,"_30987":73424,"_5":31322,"_21467":123063,"_28174":123064,"_3058":123065},[],"/docs/es/platform/iot-fleets/enrollment/provisioning-strategies#elige-la-autenticación","Elige la autenticación",{"_3602":73429,"_30987":73424,"_5":31322,"_21467":123067,"_28174":123068,"_3058":123069},[],"/docs/es/platform/iot-fleets/enrollment/provisioning-strategies#elige-la-custodia","Elige la custodia",{"_3602":73430,"_30987":73424,"_5":31322,"_21467":123071,"_28174":123072,"_3058":123073},[],"/docs/es/platform/iot-fleets/enrollment/provisioning-strategies#comprueba-la-decisión","Comprueba la decisión",{"_3602":73431,"_30987":73424,"_21467":123075,"_5":14750,"_28174":73424,"_3058":123076},[],"Esta guía ayuda al administrador de aprovisionamiento a elegir un recorrido antes de configurar el DMS. Separa tres decisiones: cuándo existe el dispositivo, cómo se autoriza la solicitud y quién genera su clave. Ninguna de ellas concede por sí sola acceso en el destino.",{"_3602":73432,"_30987":73424,"_21467":123078,"_5":14750,"_28174":123056,"_3058":123079},[],"Recorrido",{"_3602":73433,"_30987":73424,"_21467":123081,"_5":14750,"_28174":123056,"_3058":123082},[],"Cuándo existe el dispositivo",{"_3602":73434,"_30987":73424,"_21467":123084,"_5":14750,"_28174":123056,"_3058":123085},[],"Qué compruebas",{"_3602":73435,"_30987":73424,"_21467":123087,"_5":14750,"_28174":123056,"_3058":123088},[],"Asignación manual",{"_3602":73436,"_30987":73424,"_21467":123090,"_5":14750,"_28174":123056,"_3058":123091},[],"El operador lo crea antes de asociar un certificado.",{"_3602":73437,"_30987":73424,"_21467":123093,"_5":14750,"_28174":123056,"_3058":123094},[],"ID, DMS propietario, CN del certificado y serie vinculada.",{"_3602":73438,"_30987":73424,"_21467":123096,"_5":14750,"_28174":123056,"_3058":123097},[],"EST con `JITP`",{"_3602":73439,"_30987":73424,"_21467":123099,"_5":14750,"_28174":123056,"_3058":123100},[],"Se crea para un CN desconocido durante `/simpleenroll`.",{"_3602":73440,"_30987":73424,"_21467":123102,"_5":14750,"_28174":123056,"_3058":123103},[],"Credencial autorizada, ID libre, perfil, alta e identidad resultantes.",{"_3602":73441,"_30987":73424,"_21467":123105,"_5":14750,"_28174":123056,"_3058":123106},[],"EST con `PRE_REGISTRATION`",{"_3602":73442,"_30987":73424,"_21467":123108,"_5":14750,"_28174":123056,"_3058":123109},[],"Debe existir antes de `/simpleenroll`.",{"_3602":73443,"_30987":73424,"_21467":123111,"_5":14750,"_28174":123056,"_3058":123112},[],"Registro aprobado, mismo DMS y condiciones de sustitución de tu versión.",{"_3602":73444,"_30987":73424,"_21467":123114,"_5":14750,"_28174":123056,"_3058":123115},[],"`JITP` de Lamassu crea inventario e identidad en Lamassu. JITP de AWS aprovisiona un destino en AWS; son decisiones diferentes.",{"_3602":73445,"_30987":73424,"_21467":123117,"_5":14750,"_28174":123056,"_3058":123118},[],"Para una primera prueba desde el cliente, utiliza Enrola y conecta un dispositivo. Para preparar inventario sin EST, sigue Registro manual.",{"_3602":73446,"_30987":73424,"_21467":123120,"_5":14750,"_28174":123060,"_3058":123121},[],"En el código examinado, encontrar cualquier dispositivo del mismo DMS activa el control `enable_replaceable_enrollment` antes de comprobar PRE\\_REGISTRATION. Con el flag desactivado, un dispositivo prerregistrado puede recibir `forbiddenNewEnrollment` incluso estando en **No Identity**. No se presenta ese recorrido como garantizado por seleccionar únicamente PRE\\_REGISTRATION.",{"_3602":73447,"_30987":73424,"_21467":123123,"_5":14750,"_28174":123060,"_3058":123124},[],"Activar el flag permite repetir `/simpleenroll` para un ID existente. El backend programa un intento diferido de revocación del certificado anterior con `Superseded`; también puede ejecutarlo si después falla la emisión o vinculación. Si no había identidad, el intento puede fallar por falta de serie. El flag no es una transacción de sustitución ni garantiza restaurar el estado anterior.",{"_3602":73448,"_30987":73424,"_21467":123126,"_5":14750,"_28174":123060,"_3058":123127},[],"Prueba el caso exacto de tu versión antes de habilitarlo en una población. Para una identidad ya operativa y una renovación autorizada, utiliza `/simplereenroll`; para recuperar una identidad, sigue Renovación y recuperación y confirma el estado persistido antes de reintentar.",{"_3602":73449,"_30987":73424,"_21467":123129,"_5":14750,"_28174":123064,"_3058":123130},[],"Decide por separado primer enrolamiento y reenrolamiento:",{"_3602":73450,"_30987":73424,"_21467":123132,"_5":14750,"_28174":123064,"_3058":123133},[],"**Certificado cliente:** útil cuando cada equipo dispone de una credencial inicial cuya clave controla.",{"_3602":73451,"_30987":73424,"_21467":123135,"_5":14750,"_28174":123064,"_3058":123136},[],"**Webhook:** útil cuando otra autoridad conoce inventario, credenciales o derecho a solicitar un ID.",{"_3602":73452,"_30987":73424,"_21467":123138,"_5":14750,"_28174":123064,"_3058":123139},[],"**Certificado y webhook:** exige ambos controles en la operación configurada.",{"_3602":73453,"_30987":73424,"_21467":123141,"_5":14750,"_28174":123064,"_3058":123142},[],"**NO\\_AUTH:** no acredita al solicitante; solo encaja cuando el control de admisión se resuelve de forma deliberada fuera de ese DMS.",{"_3602":73454,"_30987":73424,"_21467":123144,"_5":14750,"_28174":123064,"_3058":123145},[],"Autenticar un certificado inicial no demuestra por sí solo el derecho a elegir cualquier CN en la CSR. Define esa autorización en Identidad inicial y autenticación.",{"_3602":73455,"_30987":73424,"_21467":123147,"_5":14750,"_28174":123068,"_3058":119910},[],{"_3602":73456,"_30987":73424,"_21467":123149,"_5":14750,"_28174":123068,"_3058":123150},[],"Material que atraviesa EST",{"_3602":73457,"_30987":73424,"_21467":123152,"_5":14750,"_28174":123068,"_3058":123153},[],"Clave generada por el dispositivo",{"_3602":73458,"_30987":73424,"_21467":123155,"_5":14750,"_28174":123068,"_3058":123156},[],"CSR pública y certificado; la clave permanece en el cliente.",{"_3602":73459,"_30987":73424,"_21467":123158,"_5":14750,"_28174":123068,"_3058":123159},[],"Clave ya disponible en el dispositivo",{"_3602":73460,"_30987":73424,"_21467":123161,"_5":14750,"_28174":123068,"_3058":123162},[],"CSR firmada con la clave existente y certificado nuevo.",{"_3602":73461,"_30987":73424,"_21467":123164,"_5":14750,"_28174":123068,"_3058":53626},[],{"_3602":73462,"_30987":73424,"_21467":123166,"_5":14750,"_28174":123068,"_3058":123167},[],"Clave privada PKCS#8 y certificado en una respuesta multipart protegida por TLS.",{"_3602":73463,"_30987":73424,"_21467":123169,"_5":14750,"_28174":123068,"_3058":123170},[],"Elegir ServerKeyGen no utiliza automáticamente el HSM o KMS de la CA para la clave del dispositivo. Revisa su contrato y extracción y la capacidad del dispositivo para instalar el material.",{"_3602":73464,"_30987":73424,"_21467":123172,"_5":14750,"_28174":123072,"_3058":123173},[],"Antes de extender el flujo, prueba alta permitida, credencial incorrecta, ID de otro DMS, solicitud repetida y recuperación tras un fallo. Conserva ID, serie, versión activa y error. Comprueba también aceptación y rechazo en el consumidor; un certificado emitido no implica que el destino lo conozca o permita operar.",{"_3602":73465,"_30987":73465,"_5":15110,"_3058":123175,"_31325":123176,"_21467":123177,"_28174":73465},"Renovación y recuperación",[50623,121012,53307,122157,122332],[],{"_3602":73466,"_30987":73465,"_21467":123179,"_5":14750,"_28174":73465,"_3058":123180},[],"Renueva sin perder la identidad y recupera dispositivos según su estado real.",{"_3602":73467,"_30987":73465,"_5":31322,"_21467":123182,"_28174":123183,"_3058":123184},[],"/docs/es/platform/iot-fleets/enrollment/renewal-and-recovery#prepara-la-renovación","Prepara la renovación",{"_3602":73468,"_30987":73465,"_5":31322,"_21467":123186,"_28174":123187,"_3058":123188},[],"/docs/es/platform/iot-fleets/enrollment/renewal-and-recovery#solicita-el-certificado-sucesor","Solicita el certificado sucesor",{"_3602":73469,"_30987":73465,"_5":31322,"_21467":123190,"_28174":123191,"_3058":123192},[],"/docs/es/platform/iot-fleets/enrollment/renewal-and-recovery#instala-y-comprueba-la-nueva-pareja","Instala y comprueba la nueva pareja",{"_3602":73470,"_30987":73465,"_5":31322,"_21467":123194,"_28174":123195,"_3058":123196},[],"/docs/es/platform/iot-fleets/enrollment/renewal-and-recovery#recupera-según-el-estado","Recupera según el estado",{"_3602":73471,"_30987":73465,"_5":31322,"_21467":123198,"_28174":123199,"_3058":123200},[],"/docs/es/platform/iot-fleets/enrollment/renewal-and-recovery#operación-continua","Operación continua",{"_3602":73472,"_30987":73465,"_21467":123202,"_5":14750,"_28174":73465,"_3058":123203},[],"La renovación conserva el identificador del dispositivo y solicita un certificado sucesor. Es un proceso que debe completar el cliente: comprobar la respuesta, instalar la pareja correspondiente y demostrar que el consumidor la acepta. Las alertas de Lamassu avisan; no ejecutan esos pasos.",{"_3602":73473,"_30987":73465,"_21467":123205,"_5":14750,"_28174":123183,"_3058":123206},[],"Consulta el certificado actual en Lamassu y compáralo con el instalado. Necesitas su sujeto, serie y fechas, además de la clave del cliente.",{"_3602":73474,"_30987":73465,"_21467":123208,"_5":14750,"_28174":123183,"_3058":123209},[],"Comprueba el modo de autenticación de **re-enrollment**: es independiente del inicial. En `CLIENT_CERTIFICATE`, utiliza la identidad actual, no asumas que la credencial bootstrap está admitida.",{"_3602":73475,"_30987":73465,"_21467":123211,"_5":14750,"_28174":123183,"_3058":123212},[],"Calcula el inicio de la ventana: `NotAfter` del certificado actual menos `reenrollment_delta`. Los umbrales preventivo y crítico producen estados/avisos; no amplían esa ventana.",{"_3602":73476,"_30987":73465,"_21467":123214,"_5":14750,"_28174":123183,"_3058":123215},[],"Revisa **Revoke on Re-enrollment** y la recuperación si la instalación falla. Si está habilitado, Lamassu puede revocar la identidad anterior antes de que el cliente instale la nueva.",{"_3602":73477,"_30987":73465,"_21467":123217,"_5":14750,"_28174":123187,"_3058":123218},[],"El ejemplo continúa el tutorial EST, en la misma sesión Bash con `set -euo pipefail`, `umask 077` y `EST_BASE`. Usa una nueva clave compatible con el perfil. La conversión desde el certificado conserva el sujeto y copia solo SAN cuando existe; comprueba el sujeto y los nombres solicitados antes de enviarla. El backend comprueba el sujeto frente a la identidad actual: intenta igualdad de RawSubject y después compara CN, OU, O, L, ST y C. Volver a construir únicamente el CN puede perder atributos requeridos.",{"_3602":73478,"_30987":73465,"_21467":123220,"_5":14750,"_28174":123187,"_3058":123221},[],"La petición se autentica con `device.crt` y `device.key`; la CSR contiene la clave pública nueva. Comprueba también extensiones, fechas y correspondencia de serie con el slot actual en Lamassu. No vuelvas a enviar una solicitud que falló sin consultar ese estado: la emisión, la revocación anterior y la vinculación del sucesor pueden tener resultados parciales.",{"_3602":73479,"_30987":73465,"_21467":123223,"_5":14750,"_28174":123191,"_3058":123224},[],"Conserva el resultado como `device.next.crt` y `device.next.key` hasta verificarlo. Cambia la pareja mediante una operación coordinada del almacén o configuración del dispositivo; evita exponer temporalmente un certificado con la clave de otra versión.",{"_3602":73480,"_30987":73465,"_21467":123226,"_5":14750,"_28174":123191,"_3058":123227},[],"Prueba mTLS con el consumidor y verifica que utiliza la nueva serie. Confirma el historial y el certificado actual en Lamassu. Si **Revoke on Re-enrollment** estaba deshabilitado, la identidad anterior puede seguir válida: retírala conforme a la política de PKI después de probar el sucesor y comprueba la publicación y consumo de su revocación.",{"_3602":73481,"_30987":73465,"_21467":123229,"_5":14750,"_28174":123191,"_3058":123230},[],"Si la identidad anterior ya está revocada, conservar sus archivos no permite restaurar una conexión válida. La recuperación requiere una credencial admitida y una intervención autorizada según la situación.",{"_3602":73482,"_30987":73465,"_21467":123232,"_5":14750,"_28174":123195,"_3058":123233},[],"Situación",{"_3602":73483,"_30987":73465,"_21467":123235,"_5":14750,"_28174":123195,"_3058":123236},[],"Procedimiento",{"_3602":73484,"_30987":73465,"_21467":123238,"_5":14750,"_28174":123195,"_3058":123239},[],"Certificado vigente, fuera de ventana",{"_3602":73485,"_30987":73465,"_21467":123241,"_5":14750,"_28174":123195,"_3058":123242},[],"Programa la solicitud dentro de la ventana. No recurras a `simpleenroll` para saltarla.",{"_3602":73486,"_30987":73465,"_21467":123244,"_5":14750,"_28174":123195,"_3058":123245},[],"Certificado vencido, clave disponible",{"_3602":73487,"_30987":73465,"_21467":123247,"_5":14750,"_28174":123195,"_3058":123248},[],"Con autenticación por certificado, revisa `enable_expired_renewal` y que Gateway permita presentar esa credencial. Siguen aplicándose revocación, sujeto y el resto de comprobaciones.",{"_3602":73488,"_30987":73465,"_21467":123250,"_5":14750,"_28174":123195,"_3058":123251},[],"Renovación por webhook o `NO_AUTH`",{"_3602":73489,"_30987":73465,"_21467":123253,"_5":14750,"_28174":123195,"_3058":123254},[],"La comprobación mTLS de vencimiento no se ejecuta en esos modos. Define la política de vencimiento y autorización en la admisión correspondiente; el flag no constituye una prohibición universal.",{"_3602":73490,"_30987":73465,"_21467":123256,"_5":14750,"_28174":123195,"_3058":123257},[],"Clave perdida o inaccesible",{"_3602":73491,"_30987":73465,"_21467":123259,"_5":14750,"_28174":123195,"_3058":123260},[],"No puedes probar posesión de la identidad anterior. Autoriza una nueva admisión y, si procede, sustitución controlada; revoca la identidad comprometida.",{"_3602":73492,"_30987":73465,"_21467":123262,"_5":14750,"_28174":123195,"_3058":123263},[],"Identidad actual revocada",{"_3602":73493,"_30987":73465,"_21467":123265,"_5":14750,"_28174":123195,"_3058":123266},[],"`simplereenroll` rechaza el certificado actual revocado. Investiga la razón y prepara un procedimiento de readmisión autorizado; no desactives autenticación para forzarlo.",{"_3602":73494,"_30987":73465,"_21467":123268,"_5":14750,"_28174":123195,"_3058":123269},[],"Dispositivo sin identidad",{"_3602":73495,"_30987":73465,"_21467":123271,"_5":14750,"_28174":123195,"_3058":123272},[],"Usa el enrolamiento inicial. En un registro existente, comprueba la restricción de sustitución de aprovisionamiento.",{"_3602":73496,"_30987":73465,"_21467":123274,"_5":14750,"_28174":123195,"_3058":123275},[],"Dispositivo retirado",{"_3602":73497,"_30987":73465,"_21467":123277,"_5":14750,"_28174":123195,"_3058":123278},[],"Revisa la decisión operativa antes de readmitirlo. El estado Decommissioned y la revocación de todo el historial no son equivalentes.",{"_3602":73498,"_30987":73465,"_21467":123280,"_5":14750,"_28174":123195,"_3058":123281},[],"Timeout, HTTP 500 o fallo de instalación",{"_3602":73499,"_30987":73465,"_21467":123283,"_5":14750,"_28174":123195,"_3058":123284},[],"Inspecciona dispositivo, certificados emitidos e historial antes de reintentar. Puede haberse emitido un sucesor o revocado el anterior.",{"_3602":73500,"_30987":73465,"_21467":123286,"_5":14750,"_28174":123199,"_3058":123287},[],"Programa las renovaciones con margen para desconexiones, distribución de confianza y comprobación del consumidor. Escalona solicitudes de la población y limita los reintentos dentro de la ventana; los errores de autenticación, sujeto o política requieren corregir su causa. Conserva un mecanismo de recuperación admitido y probado para las claves perdidas y las parejas que no pudieron instalarse.",{"_3602":73501,"_30987":73465,"_21467":123289,"_5":14750,"_28174":123199,"_3058":123290},[],"Continúa con Distribución de confianza, Dispositivos e identidades y Diagnóstico.",{"_3602":73502,"_30987":73502,"_5":15110,"_3058":123292,"_31325":123293,"_21467":123294,"_28174":73502},"Diagnóstico de enrolamiento",[50623,121012,53307,122157,122332],[],{"_3602":73503,"_30987":73502,"_21467":123296,"_5":14750,"_28174":73502,"_3058":123297},[],"Localiza fallos de transporte, autenticación, registro, emisión e instalación.",{"_3602":73504,"_30987":73502,"_5":31322,"_21467":123299,"_28174":123300,"_3058":123301},[],"/docs/es/platform/iot-fleets/enrollment/troubleshooting#diagnóstico-y-compatibilidad","Diagnóstico y compatibilidad",{"_3602":73505,"_30987":73502,"_5":31322,"_21467":123303,"_28174":123304,"_3058":123305},[],"/docs/es/platform/iot-fleets/enrollment/troubleshooting#códigos-de-error-y-diagnóstico","Códigos de error y diagnóstico",{"_3602":73506,"_30987":73502,"_5":31322,"_21467":123307,"_28174":123308,"_3058":122864},[],"/docs/es/platform/iot-fleets/enrollment/troubleshooting#notas-de-compatibilidad",{"_3602":73507,"_30987":73502,"_5":31322,"_21467":123310,"_28174":123311,"_3058":123312},[],"/docs/es/platform/iot-fleets/enrollment/troubleshooting#el-enrolamiento-est-falla","El enrolamiento EST falla",{"_3602":73508,"_30987":73502,"_21467":123314,"_5":14750,"_28174":73502,"_3058":123315},[],"Diagnostica una operación y un dispositivo cada vez. Anota DMS/APS, endpoint, hora, código HTTP, serie presentada y CN de la CSR. Conserva la respuesta sin incluir claves privadas ni credenciales de webhook en el informe.",{"_3602":73509,"_30987":73502,"_21467":123317,"_5":14750,"_28174":123304,"_3058":123318},[],"El controlador EST devuelve normalmente 400 al rechazar entrada y 500 cuando el servicio rechaza o falla la operación. Un 500 también puede representar una denegación de política; no implica que reintentar sea seguro. Gateway puede generar sus propios códigos y cuerpos. Revisa el cuerpo real y el resultado persistido.",{"_3602":73510,"_30987":73502,"_21467":123320,"_5":14750,"_28174":123304,"_3058":123321},[],"Síntoma o mensaje",{"_3602":73511,"_30987":73502,"_21467":123323,"_5":14750,"_28174":123304,"_3058":123324},[],"Qué revisar",{"_3602":73512,"_30987":73502,"_21467":123326,"_5":14750,"_28174":123304,"_3058":123327},[],"curl rechaza TLS, nombre o emisor",{"_3602":73513,"_30987":73502,"_21467":123329,"_5":14750,"_28174":123304,"_3058":123330},[],"URL, reloj, SAN del servidor y raíz aprobada en `est-trust.pem`. Resolver la confianza en Despliegue; no omitir la verificación.",{"_3602":73514,"_30987":73502,"_21467":123332,"_5":14750,"_28174":123304,"_3058":123333},[],"404 o APS ausente",{"_3602":73515,"_30987":73502,"_21467":123335,"_5":14750,"_28174":123304,"_3058":123336},[],"Ruta pública `/.well-known/est/{DMS_ID}/{operation}` y DMS existente. El APS no es el nombre del servicio.",{"_3602":73516,"_30987":73502,"_21467":123338,"_5":14750,"_28174":123304,"_3058":123339},[],"400, error de CSR o formato",{"_3602":73517,"_30987":73502,"_21467":123341,"_5":14750,"_28174":123304,"_3058":123342},[],"`Content-Type: application/pkcs10`, Base64 de DER, firma válida y cuerpo conservado sin doble codificación.",{"_3602":73518,"_30987":73502,"_21467":123344,"_5":14750,"_28174":123304,"_3058":123345},[],"Credencial ausente o certificado no válido",{"_3602":73519,"_30987":73502,"_21467":123347,"_5":14750,"_28174":123304,"_3058":123348},[],"Modo de la operación, CA validante, fechas, revocación y entrega de la credencial por Gateway. No confundir confianza TLS del servidor con CA de bootstrap.",{"_3602":73520,"_30987":73502,"_21467":123350,"_5":14750,"_28174":123304,"_3058":123351},[],"Webhook deniega, expira o responde sin autorización",{"_3602":73521,"_30987":73502,"_21467":123353,"_5":14750,"_28174":123304,"_3058":123354},[],"Configuración, conectividad y respuesta JSON con `authorized: true`. No hay degradación automática a `NO_AUTH`.",{"_3602":73522,"_30987":73502,"_21467":123356,"_5":14750,"_28174":123304,"_3058":54552},[],{"_3602":73523,"_30987":73502,"_21467":123358,"_5":14750,"_28174":123304,"_3058":123359},[],"El webhook respondió con una redirección. Configura la URL final absoluta `http` o `https` en la configuración del webhook; nunca se siguen redirecciones.",{"_3602":73524,"_30987":73502,"_21467":123361,"_5":14750,"_28174":123304,"_3058":54558},[],{"_3602":73525,"_30987":73502,"_21467":123363,"_5":14750,"_28174":123304,"_3058":123364},[],"El receptor devolvió más de 1 MiB de JSON. Reduce la respuesta del webhook de autorización.",{"_3602":73526,"_30987":73502,"_21467":123366,"_5":14750,"_28174":123304,"_3058":54564},[],{"_3602":73527,"_30987":73502,"_21467":123368,"_5":14750,"_28174":123304,"_3058":123369},[],"La configuración del webhook apunta a archivos (`ca_cert_file`, `mtls_options.cert_file`, `mtls_options.key_file`). Para mTLS, introduce el certificado y la clave como PEM codificado en Base64 en `cert_content` y `key_content`, o como PEM en claro; elimina cualquier otro campo de archivo, incluido `ca_cert_file`, que no tiene equivalente en línea (el certificado del receptor debe encadenar con el almacén de confianza del sistema). Consulta la guía de credenciales del webhook en DMS.",{"_3602":73528,"_30987":73502,"_21467":123371,"_5":14750,"_28174":123304,"_3058":54570},[],{"_3602":73529,"_30987":73502,"_21467":123373,"_5":14750,"_28174":123304,"_3058":123374},[],"El valor no es ni PEM codificado en Base64 ni PEM en claro: es una ruta de archivo o es Base64 de datos que no son PEM. Introduce el certificado y la clave como PEM codificado en Base64, como el resto de certificados de la API, o como PEM en claro (consulta los ajustes del webhook en DMS). El mismo mensaje nombra `mtls_options.key_content` cuando el valor no válido es la clave.",{"_3602":73530,"_30987":73502,"_21467":123376,"_5":14750,"_28174":123304,"_3058":54576},[],{"_3602":73531,"_30987":73502,"_21467":123378,"_5":14750,"_28174":123304,"_3058":123379},[],"El certificado y la clave no forman un par coincidente. Introduce ambos valores del mismo par; la comprobación se ejecuta al guardar el DMS y de nuevo en cada llamada del webhook.",{"_3602":73532,"_30987":73502,"_21467":123381,"_5":14750,"_28174":123304,"_3058":123382},[],"400 `struct validation error` al crear o actualizar un DMS",{"_3602":73533,"_30987":73502,"_21467":123384,"_5":14750,"_28174":123304,"_3058":123385},[],"La configuración del webhook de la operación que lo usa no es válida. Revisa `external_webhook_settings` en DMS.",{"_3602":73534,"_30987":73502,"_21467":123387,"_5":14750,"_28174":123304,"_3058":123388},[],"HTTP 500 con cuerpo `err` en enroll o reenroll",{"_3602":73535,"_30987":73502,"_21467":123390,"_5":14750,"_28174":123304,"_3058":123391},[],"Los fallos del servicio llegan al cliente EST como 500 con un cuerpo de `err` más el mensaje; los errores de autorización del webhook se nombran ahí.",{"_3602":73536,"_30987":73502,"_21467":123393,"_5":14750,"_28174":123304,"_3058":54594},[],{"_3602":73537,"_30987":73502,"_21467":123395,"_5":14750,"_28174":123304,"_3058":123396},[],"PRE\\_REGISTRATION requiere la entrada de inventario previa.",{"_3602":73538,"_30987":73502,"_21467":123398,"_5":14750,"_28174":123304,"_3058":54600},[],{"_3602":73539,"_30987":73502,"_21467":123400,"_5":14750,"_28174":123304,"_3058":123401},[],"Un dispositivo ya existente exige sustitución habilitada, incluso en No Identity. Investiga antes de activar el flag.",{"_3602":73540,"_30987":73502,"_21467":123403,"_5":14750,"_28174":123304,"_3058":123404},[],"DMS propietario distinto",{"_3602":73541,"_30987":73502,"_21467":123406,"_5":14750,"_28174":123304,"_3058":123407},[],"CN/ID, inventario global y DMS dueño; no reutilices un ID de otro contexto.",{"_3602":73542,"_30987":73502,"_21467":123409,"_5":14750,"_28174":123304,"_3058":54612},[],{"_3602":73543,"_30987":73502,"_21467":123411,"_5":14750,"_28174":123304,"_3058":123412},[],"Sujeto de la CSR frente al certificado actual. Conserva sus atributos, además del CN.",{"_3602":73544,"_30987":73502,"_21467":123414,"_5":14750,"_28174":123304,"_3058":54618},[],{"_3602":73545,"_30987":73502,"_21467":123416,"_5":14750,"_28174":123304,"_3058":123417},[],"NotAfter de la identidad actual y reenrollment\\_delta. Los umbrales de alerta no cambian esa ventana.",{"_3602":73546,"_30987":73502,"_21467":123419,"_5":14750,"_28174":123304,"_3058":123420},[],"Certificado actual revocado",{"_3602":73547,"_30987":73502,"_21467":123422,"_5":14750,"_28174":123304,"_3058":123423},[],"Renovación rechazada; prepara recuperación autorizada según la causa.",{"_3602":73548,"_30987":73502,"_21467":123425,"_5":14750,"_28174":123304,"_3058":123426},[],"Error de CA, perfil o firma",{"_3602":73549,"_30987":73502,"_21467":123428,"_5":14750,"_28174":123304,"_3058":123429},[],"CA activa, clave disponible, perfil seleccionado y restricciones. Un cacerts correcto no prueba emisión.",{"_3602":73550,"_30987":73502,"_21467":123431,"_5":14750,"_28174":123304,"_3058":123432},[],"HTTP 200 sin conexión del dispositivo",{"_3602":73551,"_30987":73502,"_21467":123434,"_5":14750,"_28174":123304,"_3058":123435},[],"Pareja instalada, cadena, usos, confianza y permisos del consumidor. Comprueba también el slot e historial.",{"_3602":73552,"_30987":73502,"_21467":123437,"_5":14750,"_28174":123304,"_3058":123438},[],"Timeout o error después de emitir",{"_3602":73553,"_30987":73502,"_21467":123440,"_5":14750,"_28174":123304,"_3058":123441},[],"Certificados nuevos, slot actual y estado de la identidad anterior antes de repetir.",{"_3602":73554,"_30987":73502,"_21467":123443,"_5":14750,"_28174":123308,"_3058":123444},[],"Los ejemplos usan el contrato del backend examinado. No atribuyas automáticamente ese comportamiento a otra release. Verifica el modo de renovación guardado y el comportamiento del Gateway con certificados vencidos y con la CA inicial.",{"_3602":73555,"_30987":73502,"_21467":123446,"_5":14750,"_28174":123308,"_3058":123447},[],"La respuesta predeterminada es PKCS#7 DER en Base64; el PEM por `Accept: application/x-pem-file` es una extensión de Lamassu. ServerKeyGen devuelve multipart y requiere tratar cada parte por separado. Consulta la referencia EST.",{"_3602":73556,"_30987":73502,"_21467":123449,"_5":14750,"_28174":123311,"_3058":123450},[],"Comprueba HTTPS con la raíz aprobada y consulta cacerts para el APS correcto.",{"_3602":73557,"_30987":73502,"_21467":123452,"_5":14750,"_28174":123311,"_3058":123453},[],"Revisa el DMS guardado: protocolo, registro, autenticación de esa operación, CA, perfil y ventana.",{"_3602":73558,"_30987":73502,"_21467":123455,"_5":14750,"_28174":123311,"_3058":123456},[],"Verifica la CSR localmente y relaciona su CN con el inventario.",{"_3602":73559,"_30987":73502,"_21467":123458,"_5":14750,"_28174":123311,"_3058":123459},[],"Ejecuta una solicitud, guarda cabeceras/cuerpo y consulta el dispositivo y los certificados.",{"_3602":73560,"_30987":73502,"_21467":123461,"_5":14750,"_28174":123311,"_3058":123462},[],"Si recibes identidad, comprueba clave, sujeto, uso y conexión con el consumidor.",{"_3602":73561,"_30987":73502,"_21467":123464,"_5":14750,"_28174":123311,"_3058":123465},[],"Las comprobaciones externas de revocación del bootstrap tienen límites: ausencia de evidencia puede aceptarse, y OCSP Unknown no produce el mismo rechazo que Revoked. No presupongas una política de rechazo ante cualquier incertidumbre. Una CA intermedia en la cadena TLS tampoco demuestra que toda la cadena haya llegado al validador DMS.",{"_3602":73562,"_30987":73502,"_21467":123467,"_5":14750,"_28174":123311,"_3058":123468},[],"Para logs, red, pods o cabeceras de Gateway, continúa en Diagnóstico de Despliegue. Para identidades emitidas, revocadas o vinculadas parcialmente, utiliza Renovación y recuperación y Dispositivos e identidades.",{"_3602":73563,"_30987":73563,"_5":15110,"_3058":123470,"_31325":123471,"_21467":123472,"_28174":73563},"Distribución y actualización de confianza",[50623,121012,53307,122157,122332],[],{"_3602":73564,"_30987":73563,"_21467":123474,"_5":14750,"_28174":73563,"_3058":123475},[],"Separa raíces, intermedias y confianza TLS inicial al distribuir o migrar certificados.",{"_3602":73565,"_30987":73563,"_5":31322,"_21467":123477,"_28174":123478,"_3058":123479},[],"/docs/es/platform/iot-fleets/enrollment/trust-distribution#tres-relaciones-de-confianza","Tres relaciones de confianza",{"_3602":73566,"_30987":73563,"_5":31322,"_21467":123481,"_28174":123482,"_3058":123483},[],"/docs/es/platform/iot-fleets/enrollment/trust-distribution#qué-devuelve-cacerts","Qué devuelve cacerts",{"_3602":73567,"_30987":73563,"_5":31322,"_21467":123485,"_28174":123486,"_3058":123487},[],"/docs/es/platform/iot-fleets/enrollment/trust-distribution#instala-lo-necesario","Instala lo necesario",{"_3602":73568,"_30987":73563,"_5":31322,"_21467":123489,"_28174":123490,"_3058":123491},[],"/docs/es/platform/iot-fleets/enrollment/trust-distribution#migra-la-confianza","Migra la confianza",{"_3602":73569,"_30987":73563,"_5":31322,"_21467":123493,"_28174":123494,"_3058":123495},[],"/docs/es/platform/iot-fleets/enrollment/trust-distribution#comprueba-la-actualización","Comprueba la actualización",{"_3602":73570,"_30987":73563,"_21467":123497,"_5":14750,"_28174":73563,"_3058":123498},[],"Esta guía se dirige a quien administra la confianza de dispositivos y consumidores. Necesitas inventario de emisores, acceso a los almacenes de confianza y un canal autenticado de actualización. Distribuir certificados es distinto de decidir cuáles serán anclas confiables.",{"_3602":73571,"_30987":73563,"_21467":123500,"_5":14750,"_28174":123478,"_3058":123501},[],"Relación",{"_3602":73572,"_30987":73563,"_21467":123503,"_5":14750,"_28174":123478,"_3058":123504},[],"Material que prepara el responsable",{"_3602":73573,"_30987":73563,"_21467":123506,"_5":14750,"_28174":123478,"_3058":123507},[],"Dispositivo → servidor EST",{"_3602":73574,"_30987":73563,"_21467":123509,"_5":14750,"_28174":123478,"_3058":123510},[],"Raíz, cadena o pin previamente verificado del servidor y su nombre TLS.",{"_3602":73575,"_30987":73563,"_21467":123512,"_5":14750,"_28174":123478,"_3058":123513},[],"DMS → solicitante",{"_3602":73576,"_30987":73563,"_21467":123515,"_5":14750,"_28174":123478,"_3058":123516},[],"CAs y reglas que autorizan la credencial inicial o de renovación.",{"_3602":73577,"_30987":73563,"_21467":123518,"_5":14750,"_28174":123478,"_3058":123519},[],"Consumidor → dispositivo",{"_3602":73578,"_30987":73563,"_21467":123521,"_5":14750,"_28174":123478,"_3058":123522},[],"Raíces de la identidad operativa, intermedias, validación y permisos.",{"_3602":73579,"_30987":73563,"_21467":123524,"_5":14750,"_28174":123478,"_3058":123525},[],"Un dispositivo que obtiene un certificado no configura automáticamente ninguna de esas relaciones en terceros. Revisa el modelo de confianza.",{"_3602":73580,"_30987":73563,"_21467":123527,"_5":14750,"_28174":123482,"_3058":123528},[],"El DMS puede incluir el certificado TLS downstream disponible, las Managed CAs elegidas y la CA de enrolamiento. No incorpora todos los ascendientes por seleccionar la emisora. El conjunto puede contener hojas, raíces e intermedias, incluso más de una jerarquía durante una migración.",{"_3602":73581,"_30987":73563,"_21467":123530,"_5":14750,"_28174":123482,"_3058":123531},[],"La posición no define la cadena. Identifica cada certificado por sujeto, emisor, AKI/SKI, firma y restricciones. Descarga e inspecciona con Cliente EST.",{"_3602":73582,"_30987":73563,"_21467":123533,"_5":14750,"_28174":123486,"_3058":123534},[],"Mantén por separado la confianza inicial del servidor EST y la del consumidor de identidades.",{"_3602":73583,"_30987":73563,"_21467":123536,"_5":14750,"_28174":123486,"_3058":123537},[],"Selecciona raíces que tu política haya aprobado como anclas.",{"_3602":73584,"_30987":73563,"_21467":123539,"_5":14750,"_28174":123486,"_3058":123540},[],"Conserva intermedias para construir o presentar cadenas; no las conviertas automáticamente en raíces.",{"_3602":73585,"_30987":73563,"_21467":123542,"_5":14750,"_28174":123486,"_3058":123543},[],"Presenta hoja e intermedias requeridas en mTLS. Normalmente no necesitas enviar la raíz al interlocutor que ya confía en ella.",{"_3602":73586,"_30987":73563,"_21467":123545,"_5":14750,"_28174":123486,"_3058":123546},[],"Verifica cadena, fechas, nombres, usos y revocación desde el consumidor.",{"_3602":73587,"_30987":73563,"_21467":123548,"_5":14750,"_28174":123486,"_3058":123549},[],"No uses indiscriminadamente todo `cacerts.pem` como `-CAfile`: eso puede ampliar el conjunto de autoridades confiadas, ocultar intermedias faltantes o confiar una hoja TLS que tenía otra finalidad.",{"_3602":73588,"_30987":73563,"_21467":123551,"_5":14750,"_28174":123490,"_3058":123552},[],"Antes de cambiar Enrollment CA, inventaría equipos desconectados, bootstrap, certificados operativos y consumidores. Distribuye la nueva raíz y las intermedias necesarias; comprueba que una cohorte acepta cadenas antigua y nueva.",{"_3602":73589,"_30987":73563,"_21467":123554,"_5":14750,"_28174":123490,"_3058":123555},[],"En el DMS, separa las CAs distribuidas de las CAs de validación de reenrolamiento en `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`, utilizadas para la credencial de reenrolamiento. Esa lista es opcional porque la CA de enrolamiento siempre valida las credenciales de reenrolamiento, pero al cambiar la CA de enrolamiento, añade a ella la CA de emisión anterior para que las identidades de la CA antigua sigan reenrolándose durante el solapamiento. El validador examinado prueba la CA de enrolamiento y después esas CAs con la hoja recibida; aceptar una cadena multinivel requiere verificar cómo llega al servicio y qué emisor está configurado.",{"_3602":73590,"_30987":73563,"_21467":123557,"_5":14750,"_28174":123490,"_3058":123558},[],"Cambia emisión, renueva por grupos y compara la serie instalada con el slot activo. Retira la confianza anterior cuando ningún equipo legítimo la necesite y tu política permita cerrar el solapamiento. Sigue Jerarquía y rotación para la operación PKI.",{"_3602":73591,"_30987":73563,"_21467":123560,"_5":14750,"_28174":123494,"_3058":123561},[],"Prueba una identidad antigua permitida durante el solapamiento, una nueva, una cadena desconocida y el resultado después de retirar la confianza antigua. Conserva versión del almacén, conjunto aprobado, fecha y resultado. `/cacerts` accesible solo demuestra distribución; no demuestra instalación ni aceptación por todos los dispositivos.",{"_3602":73592,"_30987":73592,"_5":15110,"_3058":54767,"_31325":123563,"_21467":123565,"_28174":73592},[50623,121012,53307,122157,123564],"Integraciones",[],{"_3602":73593,"_30987":73592,"_21467":123567,"_5":14750,"_28174":73592,"_3058":123568},[],"El conector de Lamassu para AWS IoT Core sincroniza las identidades de los dispositivos con la plataforma AWS, gestionando el registro de CAs, el aprovisionamiento de Things y el ciclo de vida de los certificados de forma automática y orientada a eventos.",{"_3602":73594,"_30987":73592,"_5":31322,"_21467":123570,"_28174":123571,"_3058":123572},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#arquitectura-del-conector","Arquitectura del conector",{"_3602":73595,"_30987":73592,"_5":31322,"_21467":123574,"_28174":123575,"_3058":123576},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#prerrequisitos","Prerrequisitos",{"_3602":73596,"_30987":73592,"_5":31322,"_21467":123578,"_28174":123579,"_3058":123580},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#permisos-iam-necesarios","Permisos IAM necesarios",{"_3602":73597,"_30987":73592,"_5":31322,"_21467":123582,"_28174":123583,"_3058":123584},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#parámetros-de-configuración","Parámetros de configuración",{"_3602":73598,"_30987":73592,"_5":31322,"_21467":123586,"_28174":123587,"_3058":123588},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#eventos-y-recursos-de-aws","Eventos y recursos de AWS",{"_3602":73599,"_30987":73592,"_5":31322,"_21467":123590,"_28174":123591,"_3058":123592},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#registro-de-la-ca-en-aws-iot-core","Registro de la CA en AWS IoT Core",{"_3602":73600,"_30987":73592,"_5":31322,"_21467":123594,"_28174":123595,"_3058":123596},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#cómo-solicitar-el-registro","Cómo solicitar el registro",{"_3602":73601,"_30987":73592,"_5":31322,"_21467":123598,"_28174":123599,"_3058":123600},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#estados-del-registro-de-la-ca","Estados del registro de la CA",{"_3602":73602,"_30987":73592,"_5":31322,"_21467":123602,"_28174":123603,"_3058":54809},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#primary-account",{"_3602":73603,"_30987":73592,"_5":31322,"_21467":123605,"_28174":123606,"_3058":54813},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#secondary-account-sni-only",{"_3602":73604,"_30987":73592,"_5":31322,"_21467":123608,"_28174":123609,"_3058":123610},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#configuración-del-dms","Configuración del DMS",{"_3602":73605,"_30987":73592,"_5":31322,"_21467":123612,"_28174":123613,"_3058":123614},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#modo-none","Modo `none`",{"_3602":73606,"_30987":73592,"_5":31322,"_21467":123616,"_28174":123617,"_3058":123618},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#modo-auto","Modo `auto`",{"_3602":73607,"_30987":73592,"_5":31322,"_21467":123620,"_28174":123621,"_3058":123622},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#modo-jitp","Modo `jitp`",{"_3602":73608,"_30987":73592,"_5":31322,"_21467":123624,"_28174":123625,"_3058":123626},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#estados-del-modo-de-registro-del-dms","Estados del modo de registro del DMS",{"_3602":73609,"_30987":73592,"_5":31322,"_21467":123628,"_28174":123629,"_3058":123630},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#aprovisionamiento-de-dispositivos-modo-automático","Aprovisionamiento de dispositivos (modo automático)",{"_3602":73610,"_30987":73592,"_5":31322,"_21467":123632,"_28174":123633,"_3058":123634},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#ciclo-de-vida-del-thing","Ciclo de vida del Thing",{"_3602":73611,"_30987":73592,"_5":31322,"_21467":123636,"_28174":123637,"_3058":123638},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#aprovisionamiento-de-dispositivos-modo-jitp","Aprovisionamiento de dispositivos (modo JITP)",{"_3602":73612,"_30987":73592,"_5":31322,"_21467":123640,"_28174":123641,"_3058":123642},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#sincronización-del-estado-del-certificado","Sincronización del estado del certificado",{"_3602":73613,"_30987":73592,"_5":31322,"_21467":123644,"_28174":123645,"_3058":123646},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#estados-del-certificado","Estados del certificado",{"_3602":73614,"_30987":73592,"_5":31322,"_21467":123648,"_28174":123649,"_3058":123650},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#desconexión-forzada-al-revocar","Desconexión forzada al revocar",{"_3602":73615,"_30987":73592,"_5":31322,"_21467":123652,"_28174":123653,"_3058":123654},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#device-shadow-y-automatización","Device Shadow y automatización",{"_3602":73616,"_30987":73592,"_5":31322,"_21467":123656,"_28174":123657,"_3058":123658},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#qué-escribe-el-conector-en-el-shadow","Qué escribe el conector en el shadow",{"_3602":73617,"_30987":73592,"_5":31322,"_21467":123660,"_28174":123661,"_3058":123662},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#políticas-de-aws-iot","Políticas de AWS IoT",{"_3602":73618,"_30987":73592,"_5":31322,"_21467":123664,"_28174":123665,"_3058":123666},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#solución-de-problemas","Solución de problemas",{"_3602":73619,"_30987":73592,"_21467":123668,"_5":14750,"_28174":73592,"_3058":123669},[],"La integración de Lamassu con AWS IoT Core cubre el puente entre la PKI gestionada por Lamassu y la plataforma de conectividad de AWS. Cuando un dispositivo obtiene su certificado a través del proceso de enrolamiento EST, el conector se encarga de que ese certificado y la identidad asociada sean reconocidos en AWS IoT Core sin intervención manual. El resultado es que el dispositivo puede autenticarse directamente en AWS con el mismo certificado X.509 que Lamassu emitió.",{"_3602":73620,"_30987":73592,"_21467":123671,"_5":14750,"_28174":73592,"_3058":123672},[],"Desde el punto de vista del protocolo, el dispositivo se autentica ante AWS IoT Core mediante TLS mutuo (mTLS): presenta su certificado X.509 emitido por Lamassu como certificado de cliente, y AWS IoT Core verifica la cadena de certificados hasta llegar a la CA registrada en la cuenta. Lamassu actúa como autoridad de certificación (CA); el conector se encarga de que esa CA esté registrada en AWS y de que el certificado del dispositivo sea conocido por la plataforma antes de que el dispositivo intente conectarse (en modo `auto`) o en su primera conexión (en modo JITP).",{"_3602":73621,"_30987":73592,"_21467":123674,"_5":14750,"_28174":73592,"_3058":123675},[],"Este documento está dirigido tanto al administrador PKI, que necesita configurar el conector y registrar las CAs, como al desarrollador de firmware de dispositivos, que necesita entender cómo se nombran los Things, cómo funciona el Device Shadow y qué ocurre cuando un certificado se revoca. Para el desarrollador de firmware, el dato más importante es que el **nombre del Thing en AWS (ThingName) corresponde siempre al Common Name (CN) del certificado emitido por Lamassu**, independientemente del modo de aprovisionamiento.",{"_3602":73622,"_30987":73592,"_21467":123677,"_5":14750,"_28174":123571,"_3058":123678},[],"El conector de AWS IoT Core es un proceso Go independiente, un binario o contenedor separado del núcleo de Lamassu. En un despliegue monolítico se compila por defecto (etiqueta de compilación `!noaws`) y se activa mediante `aws_iot_manager.enabled: true` en el fichero de configuración. En despliegues distribuidos, se ejecuta como un contenedor propio con acceso a los servicios de CA, DMS Manager y Device Manager de Lamassu a través de HTTP.",{"_3602":73623,"_30987":73592,"_21467":123680,"_5":14750,"_28174":123571,"_3058":123681},[],"El conector no sondea los servicios de Lamassu periódicamente. En su lugar, **se suscribe al bus de eventos interno** de Lamassu (AMQP o AWS SQS/SNS, configurable) y reacciona a los eventos que le interesan: creación o actualización de CAs, creación o actualización de DMS, vinculación de identidad de dispositivo, cambio de estado de certificado, actualización de metadatos de certificado y actualización de metadatos de dispositivo. Este modelo orientado a eventos garantiza que la sincronización con AWS sea casi inmediata y no genere carga de sondeo.",{"_3602":73624,"_30987":73592,"_21467":123683,"_5":14750,"_28174":123571,"_3058":123684},[],"Para evitar bucles infinitos, el conector ignora cualquier evento cuyo campo `source` de CloudEvent coincida con su propia URI de origen. Esto previene que las escrituras de metadatos que el propio conector realiza vuelvan a disparar el mismo flujo.",{"_3602":73625,"_30987":73592,"_21467":123686,"_5":14750,"_28174":123571,"_3058":123687},[],"Cuando se ejecutan varios conectores en paralelo, por ejemplo, para distintas cuentas de AWS, cada instancia tiene su propio `connector_id`. Todos los metadatos que el conector escribe en Lamassu se almacenan bajo la clave `lamassu.io/iot/{connector_id}`, lo que permite coexistencia sin colisiones.",{"_3602":73626,"_30987":73592,"_21467":123689,"_5":14750,"_28174":123575,"_3058":123690},[],"Antes de activar el conector es necesario disponer de una cuenta AWS con los permisos IAM adecuados y tener el conector correctamente configurado. El proceso de despliegue (Docker Compose, Kubernetes o binario) se describe en la documentación de despliegue.",{"_3602":73627,"_30987":73592,"_21467":123692,"_5":14750,"_28174":123579,"_3058":123693},[],"La identidad IAM con la que opera el conector debe tener al mínimo los siguientes permisos sobre los recursos de la cuenta destino:",{"_3602":73628,"_30987":73592,"_21467":123695,"_5":14750,"_28174":123579,"_3058":123696},[],"Acción IAM",{"_3602":73629,"_30987":73592,"_21467":123698,"_5":14750,"_28174":123579,"_3058":119916},[],{"_3602":73630,"_30987":73592,"_21467":123700,"_5":14750,"_28174":123579,"_3058":54908},[],{"_3602":73631,"_30987":73592,"_21467":123702,"_5":14750,"_28174":123579,"_3058":123703},[],"Obtener el código de verificación para el registro de CA en Primary Account",{"_3602":73632,"_30987":73592,"_21467":123705,"_5":14750,"_28174":123579,"_3058":54914},[],{"_3602":73633,"_30987":73592,"_21467":123707,"_5":14750,"_28174":123579,"_3058":123708},[],"Registrar la CA en AWS IoT",{"_3602":73634,"_30987":73592,"_21467":123710,"_5":14750,"_28174":123579,"_3058":54920},[],{"_3602":73635,"_30987":73592,"_21467":123712,"_5":14750,"_28174":123579,"_3058":123713},[],"Consultar el estado del registro de la CA",{"_3602":73636,"_30987":73592,"_21467":123715,"_5":14750,"_28174":123579,"_3058":54926},[],{"_3602":73637,"_30987":73592,"_21467":123717,"_5":14750,"_28174":123579,"_3058":123718},[],"Crear o actualizar Things en IoT Core",{"_3602":73638,"_30987":73592,"_21467":123720,"_5":14750,"_28174":123579,"_3058":54932},[],{"_3602":73639,"_30987":73592,"_21467":123722,"_5":14750,"_28174":123579,"_3058":123723},[],"Aprovisionar Things mediante plantilla",{"_3602":73640,"_30987":73592,"_21467":123725,"_5":14750,"_28174":123579,"_3058":54938},[],{"_3602":73641,"_30987":73592,"_21467":123727,"_5":14750,"_28174":123579,"_3058":123728},[],"Registrar certificados de dispositivo",{"_3602":73642,"_30987":73592,"_21467":123730,"_5":14750,"_28174":123579,"_3058":54944},[],{"_3602":73643,"_30987":73592,"_21467":123732,"_5":14750,"_28174":123579,"_3058":123733},[],"Cambiar el estado de un certificado (ACTIVE / INACTIVE / REVOKED)",{"_3602":73644,"_30987":73592,"_21467":123735,"_5":14750,"_28174":123579,"_3058":54950},[],{"_3602":73645,"_30987":73592,"_21467":123737,"_5":14750,"_28174":123579,"_3058":123738},[],"Crear y adjuntar políticas IoT",{"_3602":73646,"_30987":73592,"_21467":123740,"_5":14750,"_28174":123579,"_3058":54956},[],{"_3602":73647,"_30987":73592,"_21467":123742,"_5":14750,"_28174":123579,"_3058":123743},[],"Gestionar grupos de Things",{"_3602":73648,"_30987":73592,"_21467":123745,"_5":14750,"_28174":123579,"_3058":54962},[],{"_3602":73649,"_30987":73592,"_21467":123747,"_5":14750,"_28174":123579,"_3058":123748},[],"Crear plantillas JITP",{"_3602":73650,"_30987":73592,"_21467":123750,"_5":14750,"_28174":123579,"_3058":54968},[],{"_3602":73651,"_30987":73592,"_21467":123752,"_5":14750,"_28174":123579,"_3058":123753},[],"Leer y escribir el Device Shadow",{"_3602":73652,"_30987":73592,"_21467":123755,"_5":14750,"_28174":123579,"_3058":123756},[],"Para el mecanismo de desconexión forzada tras revocación también se requiere acceso a la API del plano de datos de AWS IoT (`iot:Connect` con SigV4 sobre WebSocket), que se negocia de forma implícita con las credenciales del conector.",{"_3602":73653,"_30987":73592,"_21467":123758,"_5":14750,"_28174":123583,"_3058":123759},[],"Parámetro",{"_3602":73654,"_30987":73592,"_21467":123761,"_5":14750,"_28174":123583,"_3058":123762},[],"Tipo",{"_3602":73655,"_30987":73592,"_21467":123764,"_5":14750,"_28174":123583,"_3058":123765},[],"Requerido",{"_3602":73656,"_30987":73592,"_21467":123767,"_5":14750,"_28174":123583,"_3058":123768},[],"Descripción",{"_3602":73657,"_30987":73592,"_21467":123770,"_5":14750,"_28174":123583,"_3058":54989},[],{"_3602":73658,"_30987":73592,"_21467":123772,"_5":14750,"_28174":123583,"_3058":25625},[],{"_3602":73659,"_30987":73592,"_21467":123774,"_5":14750,"_28174":123583,"_3058":123775},[],"Sí",{"_3602":73660,"_30987":73592,"_21467":123777,"_5":14750,"_28174":123583,"_3058":123778},[],"Identificador único de esta instancia del conector. Se usa como espacio de nombres para los metadatos: `lamassu.io/iot/{connector_id}`.",{"_3602":73661,"_30987":73592,"_21467":123780,"_5":14750,"_28174":123583,"_3058":55000},[],{"_3602":73662,"_30987":73592,"_21467":123782,"_5":14750,"_28174":123583,"_3058":25625},[],{"_3602":73663,"_30987":73592,"_21467":123784,"_5":14750,"_28174":123583,"_3058":123775},[],{"_3602":73664,"_30987":73592,"_21467":123786,"_5":14750,"_28174":123583,"_3058":123787},[],"Región AWS donde opera el conector.",{"_3602":73665,"_30987":73592,"_21467":123789,"_5":14750,"_28174":123583,"_3058":55010},[],{"_3602":73666,"_30987":73592,"_21467":123791,"_5":14750,"_28174":123583,"_3058":25625},[],{"_3602":73667,"_30987":73592,"_21467":123793,"_5":14750,"_28174":123583,"_3058":123775},[],{"_3602":73668,"_30987":73592,"_21467":123795,"_5":14750,"_28174":123583,"_3058":123796},[],"Método de autenticación: `static`, `role` o vacío (cadena de credenciales por defecto del SDK).",{"_3602":73669,"_30987":73592,"_21467":123798,"_5":14750,"_28174":123583,"_3058":55020},[],{"_3602":73670,"_30987":73592,"_21467":123800,"_5":14750,"_28174":123583,"_3058":25625},[],{"_3602":73671,"_30987":73592,"_21467":123802,"_5":14750,"_28174":123583,"_3058":123803},[],"Solo con `auth_method=static`",{"_3602":73672,"_30987":73592,"_21467":123805,"_5":14750,"_28174":123583,"_3058":123806},[],"Clave de acceso AWS.",{"_3602":73673,"_30987":73592,"_21467":123808,"_5":14750,"_28174":123583,"_3058":55031},[],{"_3602":73674,"_30987":73592,"_21467":123810,"_5":14750,"_28174":123583,"_3058":25625},[],{"_3602":73675,"_30987":73592,"_21467":123812,"_5":14750,"_28174":123583,"_3058":123803},[],{"_3602":73676,"_30987":73592,"_21467":123814,"_5":14750,"_28174":123583,"_3058":123815},[],"Clave secreta AWS.",{"_3602":73677,"_30987":73592,"_21467":123817,"_5":14750,"_28174":123583,"_3058":55041},[],{"_3602":73678,"_30987":73592,"_21467":123819,"_5":14750,"_28174":123583,"_3058":25625},[],{"_3602":73679,"_30987":73592,"_21467":123821,"_5":14750,"_28174":123583,"_3058":55046},[],{"_3602":73680,"_30987":73592,"_21467":123823,"_5":14750,"_28174":123583,"_3058":123824},[],"Token de sesión (con `auth_method=static`).",{"_3602":73681,"_30987":73592,"_21467":123826,"_5":14750,"_28174":123583,"_3058":55052},[],{"_3602":73682,"_30987":73592,"_21467":123828,"_5":14750,"_28174":123583,"_3058":25625},[],{"_3602":73683,"_30987":73592,"_21467":123830,"_5":14750,"_28174":123583,"_3058":123831},[],"Solo con `auth_method=role`",{"_3602":73684,"_30987":73592,"_21467":123833,"_5":14750,"_28174":123583,"_3058":123834},[],"ARN del rol a asumir.",{"_3602":73685,"_30987":73592,"_21467":123836,"_5":14750,"_28174":123583,"_3058":55063},[],{"_3602":73686,"_30987":73592,"_21467":123838,"_5":14750,"_28174":123583,"_3058":25625},[],{"_3602":73687,"_30987":73592,"_21467":123840,"_5":14750,"_28174":123583,"_3058":55046},[],{"_3602":73688,"_30987":73592,"_21467":123842,"_5":14750,"_28174":123583,"_3058":123843},[],"URL alternativa para todos los servicios AWS (útil con LocalStack en pruebas).",{"_3602":73689,"_30987":73592,"_21467":123845,"_5":14750,"_28174":123583,"_3058":55073},[],{"_3602":73690,"_30987":73592,"_21467":123847,"_5":14750,"_28174":123583,"_3058":92339},[],{"_3602":73691,"_30987":73592,"_21467":123849,"_5":14750,"_28174":123583,"_3058":123775},[],{"_3602":73692,"_30987":73592,"_21467":123851,"_5":14750,"_28174":123583,"_3058":123852},[],"Configuración del bus de eventos al que se suscribe el conector (AMQP o AWS SQS/SNS).",{"_3602":73693,"_30987":73592,"_21467":123854,"_5":14750,"_28174":123583,"_3058":55083},[],{"_3602":73694,"_30987":73592,"_21467":123856,"_5":14750,"_28174":123583,"_3058":25625},[],{"_3602":73695,"_30987":73592,"_21467":123858,"_5":14750,"_28174":123583,"_3058":123775},[],{"_3602":73696,"_30987":73592,"_21467":123860,"_5":14750,"_28174":123583,"_3058":123861},[],"URL HTTP del servicio DMS Manager de Lamassu.",{"_3602":73697,"_30987":73592,"_21467":123863,"_5":14750,"_28174":123583,"_3058":55093},[],{"_3602":73698,"_30987":73592,"_21467":123865,"_5":14750,"_28174":123583,"_3058":25625},[],{"_3602":73699,"_30987":73592,"_21467":123867,"_5":14750,"_28174":123583,"_3058":123775},[],{"_3602":73700,"_30987":73592,"_21467":123869,"_5":14750,"_28174":123583,"_3058":123870},[],"URL HTTP del Device Manager de Lamassu.",{"_3602":73701,"_30987":73592,"_21467":123872,"_5":14750,"_28174":123583,"_3058":55103},[],{"_3602":73702,"_30987":73592,"_21467":123874,"_5":14750,"_28174":123583,"_3058":25625},[],{"_3602":73703,"_30987":73592,"_21467":123876,"_5":14750,"_28174":123583,"_3058":123775},[],{"_3602":73704,"_30987":73592,"_21467":123878,"_5":14750,"_28174":123583,"_3058":123879},[],"URL HTTP del servicio de CA de Lamassu.",{"_3602":73705,"_30987":73592,"_21467":123881,"_5":14750,"_28174":123587,"_3058":123882},[],"El conector gestiona el lado AWS de cuatro tipos de recursos: CAs, plantillas de aprovisionamiento de DMS (JITP), certificados de dispositivo y Things. Esta sección mapea los eventos del bus que consume el conector a los recursos de AWS que toca y a las llamadas AWS que ejecuta cada flujo. La máquina de estados de cada recurso está junto a su explicación detallada; la última columna enlaza a ella. Los recursos de AWS se referencian con la notación `IoTCore/<recurso>`.",{"_3602":73706,"_30987":73592,"_21467":123884,"_5":14750,"_28174":123587,"_3058":123885},[],"La columna **Tipo de CloudEvent** lista el nombre del evento en el bus interno de Lamassu; la columna **Acciones IAM** lista las operaciones exactas del SDK de AWS que invoca cada flujo, para que los permisos necesarios se deriven directamente de esta tabla.",{"_3602":73707,"_30987":73592,"_21467":123887,"_5":14750,"_28174":123587,"_3058":123888},[],"Tipo de CloudEvent",{"_3602":73708,"_30987":73592,"_21467":123890,"_5":14750,"_28174":123587,"_3058":123891},[],"Recurso en Lamassu",{"_3602":73709,"_30987":73592,"_21467":123893,"_5":14750,"_28174":123587,"_3058":123894},[],"Recurso AWS",{"_3602":73710,"_30987":73592,"_21467":123896,"_5":14750,"_28174":123587,"_3058":123897},[],"Acciones IAM",{"_3602":73711,"_30987":73592,"_21467":123899,"_5":14750,"_28174":123587,"_3058":123900},[],"Llamadas AWS y efecto",{"_3602":73712,"_30987":73592,"_21467":123902,"_5":14750,"_28174":123587,"_3058":123903},[],"Dónde en esta página",{"_3602":73713,"_30987":73592,"_21467":123905,"_5":14750,"_28174":123587,"_3058":55137},[],{"_3602":73714,"_30987":73592,"_21467":123907,"_5":14750,"_28174":123587,"_3058":55140},[],{"_3602":73715,"_30987":73592,"_21467":123909,"_5":14750,"_28174":123587,"_3058":55143},[],{"_3602":73716,"_30987":73592,"_21467":123911,"_5":14750,"_28174":123587,"_3058":55146},[],{"_3602":73717,"_30987":73592,"_21467":123913,"_5":14750,"_28174":123587,"_3058":123914},[],"Carga la CA en el estado del conector; una escritura de `registration.status = REQUESTED` dispara el flujo de registro (Primary con certificado de verificación, o SNI-only) y escribe `SUCCEEDED` o `FAILED` en los metadatos de la CA.",{"_3602":73718,"_30987":73592,"_21467":123916,"_5":14750,"_28174":123587,"_3058":123600},[],{"_3602":73719,"_30987":73592,"_21467":123918,"_5":14750,"_28174":123587,"_3058":55154},[],{"_3602":73720,"_30987":73592,"_21467":123920,"_5":14750,"_28174":123587,"_3058":55157},[],{"_3602":73721,"_30987":73592,"_21467":123922,"_5":14750,"_28174":123587,"_3058":55160},[],{"_3602":73722,"_30987":73592,"_21467":123924,"_5":14750,"_28174":123587,"_3058":55163},[],{"_3602":73723,"_30987":73592,"_21467":123926,"_5":14750,"_28174":123587,"_3058":123927},[],"En modo `jitp`, intenta crear la plantilla de aprovisionamiento y la adjunta a la CA registrada. No idempotente: una edición `PUT /v1/dms/{id}` reintenta la creación y acaba en `lamassu-dlq` tras 3 reintentos. Idempotente para `none` y `auto` (solo configuración).",{"_3602":73724,"_30987":73592,"_21467":123929,"_5":14750,"_28174":123587,"_3058":123626},[],{"_3602":73725,"_30987":73592,"_21467":123931,"_5":14750,"_28174":123587,"_3058":55171},[],{"_3602":73726,"_30987":73592,"_21467":123933,"_5":14750,"_28174":123587,"_3058":123934},[],"Dispositivo",{"_3602":73727,"_30987":73592,"_21467":123936,"_5":14750,"_28174":123587,"_3058":55177},[],{"_3602":73728,"_30987":73592,"_21467":123938,"_5":14750,"_28174":123587,"_3058":55180},[],{"_3602":73729,"_30987":73592,"_21467":123940,"_5":14750,"_28174":123587,"_3058":123941},[],"En modo `auto`: crea/actualiza políticas, asegura los grupos de Things, revoca principals obsoletos y aprovisiona el Thing vía `iot:RegisterThing`. En modo `jitp`: no hay llamadas AWS; AWS ejecuta la plantilla JITP en la primera conexión.",{"_3602":73730,"_30987":73592,"_21467":123943,"_5":14750,"_28174":123587,"_3058":123634},[],{"_3602":73731,"_30987":73592,"_21467":123945,"_5":14750,"_28174":123587,"_3058":55188},[],{"_3602":73732,"_30987":73592,"_21467":123947,"_5":14750,"_28174":123587,"_3058":123948},[],"Certificado",{"_3602":73733,"_30987":73592,"_21467":123950,"_5":14750,"_28174":123587,"_3058":55194},[],{"_3602":73734,"_30987":73592,"_21467":123952,"_5":14750,"_28174":123587,"_3058":123953},[],"`iot:UpdateCertificate`, `iot:Connect` (plano de datos)",{"_3602":73735,"_30987":73592,"_21467":123955,"_5":14750,"_28174":123587,"_3058":123956},[],"Mapea el estado a AWS (`ACTIVE`, `INACTIVE`, `REVOKED`), llama a `iot:UpdateCertificate` y fuerza una desconexión MQTT al revocar.",{"_3602":73736,"_30987":73592,"_21467":123958,"_5":14750,"_28174":123587,"_3058":123646},[],{"_3602":73737,"_30987":73592,"_21467":123960,"_5":14750,"_28174":123587,"_3058":55205},[],{"_3602":73738,"_30987":73592,"_21467":123962,"_5":14750,"_28174":123587,"_3058":123963},[],"Certificado / Dispositivo",{"_3602":73739,"_30987":73592,"_21467":123965,"_5":14750,"_28174":123587,"_3058":55211},[],{"_3602":73740,"_30987":73592,"_21467":123967,"_5":14750,"_28174":123587,"_3058":51019},[],{"_3602":73741,"_30987":73592,"_21467":123969,"_5":14750,"_28174":123587,"_3058":123970},[],"Refresca el estado interno; el conector ignora los eventos cuyo campo CloudEvent `source` coincide con su propia URI para evitar bucles autodisparados.",{"_3602":73742,"_30987":73592,"_21467":123972,"_5":14750,"_28174":123587,"_3058":123654},[],{"_3602":73743,"_30987":73592,"_21467":123974,"_5":14750,"_28174":123591,"_3058":123975},[],"Para que los dispositivos puedan autenticarse en AWS IoT Core con certificados emitidos por una CA de Lamassu, esa CA debe registrarse previamente en la cuenta AWS. El conector gestiona este registro de forma automática en respuesta a los eventos `EventCreateCAKey`, `EventImportCAKey` y `EventUpdateCAMetadataKey`, pero la operación **solo se dispara cuando el administrador la solicita explícitamente** mediante el campo de metadatos de la CA.",{"_3602":73744,"_30987":73592,"_21467":123977,"_5":14750,"_28174":123595,"_3058":123978},[],"El registro se desencadena estableciendo el valor `registration.status = \"REQUESTED\"` en la clave `lamassu.io/iot/{connector_id}` de los metadatos de la CA. Esto puede hacerse desde la consola de Lamassu en la sección de gestión de la CA o mediante la API.",{"_3602":73745,"_30987":73592,"_21467":123980,"_5":14750,"_28174":123595,"_3058":123981},[],"Una vez recibido el evento, el conector intenta registrar la CA en AWS y actualiza el campo `registration.status` en los metadatos de la CA con el resultado: `\"SUCCEEDED\"` si el registro fue correcto, o `\"FAILED\"` acompañado de un mensaje de error en caso contrario. El proceso es asíncrono, por lo que es necesario consultar periódicamente el estado de los metadatos hasta que la operación concluya.",{"_3602":73746,"_30987":73592,"_21467":123983,"_5":14750,"_28174":123599,"_3058":123984},[],"El flujo de registro de la CA se gobierna por el campo `registration.status` de los metadatos del conector en la CA:",{"_3602":73747,"_30987":73592,"_21467":123986,"_5":14750,"_28174":123599,"_3058":123987},[],"Transición",{"_3602":73748,"_30987":73592,"_21467":123989,"_5":14750,"_28174":123599,"_3058":123990},[],"Llamadas AWS",{"_3602":73749,"_30987":73592,"_21467":123992,"_5":14750,"_28174":123599,"_3058":123993},[],"`NoRegistrada` → `Solicitada`",{"_3602":73750,"_30987":73592,"_21467":123995,"_5":14750,"_28174":123599,"_3058":123996},[],"ninguna (solo escritura de metadatos)",{"_3602":73751,"_30987":73592,"_21467":123998,"_5":14750,"_28174":123599,"_3058":123999},[],"`Solicitada` → `Registrando`",{"_3602":73752,"_30987":73592,"_21467":124001,"_5":14750,"_28174":123599,"_3058":124002},[],"`iot:GetRegistrationCode` (solo Primary Account)",{"_3602":73753,"_30987":73592,"_21467":124004,"_5":14750,"_28174":123599,"_3058":124005},[],"`Registrando` → `Completada`",{"_3602":73754,"_30987":73592,"_21467":124007,"_5":14750,"_28174":123599,"_3058":124008},[],"`iot:RegisterCACertificate` (Primary: prueba de posesión con clave efímera; SNI-only: `CertificateMode: SNI_ONLY`)",{"_3602":73755,"_30987":73592,"_21467":124010,"_5":14750,"_28174":123599,"_3058":124011},[],"`Registrando` → `Fallida`",{"_3602":73756,"_30987":73592,"_21467":124013,"_5":14750,"_28174":123599,"_3058":124014},[],"`iot:RegisterCACertificate` fallida; el detalle del error se escribe en los metadatos de la CA",{"_3602":73757,"_30987":73592,"_21467":124016,"_5":14750,"_28174":123599,"_3058":124017},[],"`Fallida` / `Completada` → `Solicitada`",{"_3602":73758,"_30987":73592,"_21467":124019,"_5":14750,"_28174":123599,"_3058":124020},[],"ninguna (una nueva escritura `REQUESTED` reejecuta el flujo)",{"_3602":73759,"_30987":73592,"_21467":124022,"_5":14750,"_28174":123603,"_3058":124023},[],"Cuando el parámetro `primary_account` es `true`, el conector ejecuta el flujo completo de registro con verificación de posesión de clave privada:",{"_3602":73760,"_30987":73592,"_21467":124025,"_5":14750,"_28174":123603,"_3058":124026},[],"Llama a `iot:GetRegistrationCode` para obtener el código de verificación de AWS.",{"_3602":73761,"_30987":73592,"_21467":124028,"_5":14750,"_28174":123603,"_3058":124029},[],"El conector genera internamente un par de claves RSA-2048 efímero y construye un CSR cuyo Common Name es exactamente ese código de registro. A continuación llama al servicio de firma de Lamassu para que la CA registrada emita un certificado de verificación X.509 real firmando ese CSR. La clave privada efímera se usa únicamente para este propósito y no se almacena ni se envía a AWS.",{"_3602":73762,"_30987":73592,"_21467":124031,"_5":14750,"_28174":123603,"_3058":124032},[],"Envía a AWS la CA (en PEM) y el certificado de verificación mediante `iot:RegisterCACertificate`, activando el registro con `AllowAutoRegistration: true`.",{"_3602":73763,"_30987":73592,"_21467":124034,"_5":14750,"_28174":123603,"_3058":124035},[],"Solo una cuenta puede ser propietaria de una CA en una región AWS dada. Si la CA ya está registrada con el mismo número de serie, el conector omite el paso silenciosamente.",{"_3602":73764,"_30987":73592,"_21467":124037,"_5":14750,"_28174":123603,"_3058":124038},[],"Los tags que AWS IoT Core aplica al certificado de CA registrado son `LMS.CA.ID`, `LMS.CA.SN` y `LMS.CA.CN`.",{"_3602":73765,"_30987":73592,"_21467":124040,"_5":14750,"_28174":123606,"_3058":124041},[],"Cuando `primary_account` es `false`, el conector registra la CA usando el modo `CertificateMode: SNI_ONLY`. Este modo no requiere código de verificación ni acceso a la clave privada de la CA, por lo que es la opción adecuada cuando la CA se gestiona desde otra cuenta de AWS o cuando el administrador no dispone de la clave privada. Es el método habitual para registrar la misma CA en varias cuentas de AWS simultáneamente.",{"_3602":73766,"_30987":73592,"_21467":124043,"_5":14750,"_28174":123609,"_3058":124044},[],"Cada DMS que participe en la integración con AWS IoT Core debe tener configurada la clave de metadatos `lamassu.io/iot/{connector_id}`. El campo más importante de esa configuración es `registration_mode`, que determina cómo se aprovisionan los dispositivos en AWS.",{"_3602":73767,"_30987":73592,"_21467":124046,"_5":14750,"_28174":123609,"_3058":124047},[],"Existen tres modos de registro, y la elección entre ellos depende de la estrategia de aprovisionamiento de la flota.",{"_3602":73768,"_30987":73592,"_21467":124049,"_5":14750,"_28174":123613,"_3058":124050},[],"En este modo el conector **no crea Things, grupos ni políticas** en AWS IoT Core. Se limita a sincronizar el estado de los certificados (activo, revocado, suspendido) a medida que cambian en Lamassu. Es el modo adecuado cuando el aprovisionamiento de Things en AWS se gestiona por un sistema externo y solo se necesita que Lamassu mantenga el estado de los certificados actualizado.",{"_3602":73769,"_30987":73592,"_21467":124052,"_5":14750,"_28174":123617,"_3058":124053},[],"El modo `auto` delega en Lamassu el aprovisionamiento completo del dispositivo en AWS en el momento del enrolamiento. Cuando el dispositivo completa con éxito su enrolamiento EST y Lamassu emite el evento `EventBindDeviceIdentityKey`, el conector ejecuta automáticamente la siguiente secuencia:",{"_3602":73770,"_30987":73592,"_21467":124055,"_5":14750,"_28174":123617,"_3058":124056},[],"Crea o actualiza las políticas IoT configuradas en el DMS.",{"_3602":73771,"_30987":73592,"_21467":124058,"_5":14750,"_28174":123617,"_3058":124059},[],"Crea el grupo raíz `LAMASSU` en la cuenta AWS (si no existe) y los grupos hijos configurados en el DMS como subgrupos de `LAMASSU`. Si los grupos ya existen, el error `ResourceAlreadyExistsException` se ignora, por lo que la operación es idempotente.",{"_3602":73772,"_30987":73592,"_21467":124061,"_5":14750,"_28174":123617,"_3058":124062},[],"Si el Thing ya existía en AWS IoT Core, el conector itera todos los certificados (principals) actualmente adjuntos a ese Thing y los marca como `REVOKED` en AWS, para garantizar que los certificados anteriores no puedan seguir siendo usados para autenticarse.",{"_3602":73773,"_30987":73592,"_21467":124064,"_5":14750,"_28174":123617,"_3058":124065},[],"Llama a `iot:RegisterThing` con una plantilla de aprovisionamiento de estilo CloudFormation que crea el Thing, registra el certificado del dispositivo (PEM del certificado del dispositivo y del certificado de la CA emisora) y adjunta las políticas configuradas.\nUna vez completado el aprovisionamiento, el conector almacena el ARN del certificado resultante en los metadatos del certificado de Lamassu bajo la clave `lamassu.io/iot/{connector_id}` y marca el dispositivo como `Registered: true` en Device Manager.",{"_3602":73774,"_30987":73592,"_21467":124067,"_5":14750,"_28174":123617,"_3058":124068},[],"**El nombre del Thing en AWS es el Common Name (CN) del certificado del dispositivo.** Esta convención es fundamental para el desarrollador de firmware: el valor `/CN=` que el dispositivo incluye en su CSR al enrolarse se convierte en el ThingName con el que deberá identificarse en todas las operaciones MQTT contra AWS IoT Core.",{"_3602":73775,"_30987":73592,"_21467":124070,"_5":14750,"_28174":123621,"_3058":124071},[],"El modo Just-In-Time Provisioning (JITP) delega el aprovisionamiento en AWS en lugar de hacerlo el conector directamente. Cuando el conector detecta que el DMS está en modo `jitp`, crea una plantilla de aprovisionamiento JITP en AWS IoT Core y la adjunta al certificado de CA registrado. El conector intenta crear esta plantilla cuando el DMS se crea y de nuevo en cada edición completa del DMS (`PUT /v1/dms/{id}`) - no en el momento del enrolamiento del dispositivo. El intento no es idempotente: cuando ya existe una plantilla nombrada con el ID del DMS, la llamada de creación falla, el evento se reintenta tres veces y acaba en la cola de mensajes fallidos `lamassu-dlq` (ver Solución de problemas). La plantilla se crea una sola vez; las ediciones posteriores nunca actualizan su contenido. Una actualización del DMS que omite `metadata` o envía `null` conserva los metadatos almacenados, así que la clave del conector `lamassu.io/iot/{connector_id}` sigue presente y el intento se sigue disparando. Un cuerpo que suministra un objeto `metadata` sustituye por completo los metadatos almacenados: si ese objeto no lleva la clave del conector, la clave se elimina y el conector omite silenciosamente los eventos futuros del DMS. Una vez adjuntada la plantilla, cuando un dispositivo con un certificado emitido por esa CA se conecta por primera vez a AWS IoT Core, AWS ejecuta la plantilla automáticamente: crea el Thing, registra el certificado y lo activa.",{"_3602":73776,"_30987":73592,"_21467":124073,"_5":14750,"_28174":123621,"_3058":124074},[],"El conector crea la plantilla, nombrada con el ID del DMS, una sola vez. Cada edición posterior del DMS que conserve la clave del conector intenta crearla de nuevo y falla, porque el conector no actualiza plantillas existentes. Los cambios posteriores en `jitp_config.provisioning_role_arn`, `jitp_config.enable_template` o en los grupos y políticas que la plantilla referencia deben aplicarse a mano en AWS IoT Core.",{"_3602":73777,"_30987":73592,"_21467":124076,"_5":14750,"_28174":123621,"_3058":124077},[],"El evento fallido se reintenta y termina en `lamassu-dlq`. Los grupos y las políticas se registran antes del fallo, pero se omiten la asignación de la plantilla a la CA registrada, la escritura del ARN en el DMS y la actualización de las shadows al cambiar `ManagedCAs`.",{"_3602":73778,"_30987":73592,"_21467":124079,"_5":14750,"_28174":123621,"_3058":124080},[],"El nombre del Thing en la plantilla JITP se deriva de `AWS::IoT::Certificate::CommonName`, que corresponde al CN del certificado del dispositivo - la misma convención que el modo `auto`.",{"_3602":73779,"_30987":73592,"_21467":124082,"_5":14750,"_28174":123621,"_3058":124083},[],"Este modo requiere que se configure el campo `jitp_config.provisioning_role_arn` con el ARN de un rol IAM que AWS IoT Core pueda asumir para ejecutar la plantilla. Si no se configura, el conector utiliza el valor por defecto `arn:aws:iam::{account}:role/JITPRole` y registra un aviso en el log. El administrador debe asegurarse de que ese rol existe en la cuenta y tiene los permisos necesarios antes de activar el modo JITP.",{"_3602":73780,"_30987":73592,"_21467":124085,"_5":14750,"_28174":123625,"_3058":124086},[],"El `registration_mode` del DMS determina qué hace el conector en el lado AWS cuando el DMS se crea o se edita por completo:",{"_3602":73781,"_30987":73592,"_21467":124088,"_5":14750,"_28174":123625,"_3058":123987},[],{"_3602":73782,"_30987":73592,"_21467":124090,"_5":14750,"_28174":123625,"_3058":123990},[],{"_3602":73783,"_30987":73592,"_21467":124092,"_5":14750,"_28174":123625,"_3058":124093},[],"`SinConfigurar` → `None` / `Auto`",{"_3602":73784,"_30987":73592,"_21467":124095,"_5":14750,"_28174":123625,"_3058":124096},[],"ninguna (solo configuración)",{"_3602":73785,"_30987":73592,"_21467":124098,"_5":14750,"_28174":123625,"_3058":55348},[],{"_3602":73786,"_30987":73592,"_21467":124100,"_5":14750,"_28174":123625,"_3058":124096},[],{"_3602":73787,"_30987":73592,"_21467":124102,"_5":14750,"_28174":123625,"_3058":124103},[],"Cualquiera → `Jitp`",{"_3602":73788,"_30987":73592,"_21467":124105,"_5":14750,"_28174":123625,"_3058":124106},[],"`iot:CreateProvisioningTemplate` (no idempotente: falla si la plantilla ya existe; tras 3 reintentos el evento acaba en `lamassu-dlq`)",{"_3602":73789,"_30987":73592,"_21467":124108,"_5":14750,"_28174":123625,"_3058":55359},[],{"_3602":73790,"_30987":73592,"_21467":124110,"_5":14750,"_28174":123625,"_3058":124111},[],"ninguna (la plantilla permanece en la cuenta AWS)",{"_3602":73791,"_30987":73592,"_21467":124113,"_5":14750,"_28174":123629,"_3058":124114},[],"Para el desarrollador de firmware, el modo `auto` es transparente: el dispositivo realiza su enrolamiento EST de la forma habitual y, como efecto secundario, queda aprovisionado en AWS IoT Core sin ningún paso adicional.",{"_3602":73792,"_30987":73592,"_21467":124116,"_5":14750,"_28174":123629,"_3058":124117},[],"El flujo completo desde el punto de vista del dispositivo es el siguiente:",{"_3602":73793,"_30987":73592,"_21467":124119,"_5":14750,"_28174":123629,"_3058":124120},[],"Una vez que el conector completa el aprovisionamiento, el dispositivo puede conectarse al endpoint AWS IoT Core de MQTT usando su clave privada y el certificado emitido por Lamassu. El ThingName con el que debe identificarse en AWS es exactamente el CN del certificado.",{"_3602":73794,"_30987":73592,"_21467":124122,"_5":14750,"_28174":123633,"_3058":124123},[],"Los Things solo existen en modo `auto`; en modo `jitp` AWS crea el Thing por sí mismo cuando el dispositivo se conecta por primera vez. El nombre del Thing es siempre el CN del certificado del dispositivo:",{"_3602":73795,"_30987":73592,"_21467":124125,"_5":14750,"_28174":123633,"_3058":123987},[],{"_3602":73796,"_30987":73592,"_21467":124127,"_5":14750,"_28174":123633,"_3058":123990},[],{"_3602":73797,"_30987":73592,"_21467":124129,"_5":14750,"_28174":123633,"_3058":124130},[],"`Ausente` → `Aprovisionado`",{"_3602":73798,"_30987":73592,"_21467":124132,"_5":14750,"_28174":123633,"_3058":124133},[],"políticas creadas/actualizadas, grupos de Things asegurados, `iot:RegisterThing` (crea el Thing, registra el certificado, adjunta políticas)",{"_3602":73799,"_30987":73592,"_21467":124135,"_5":14750,"_28174":123633,"_3058":124136},[],"`Aprovisionado` → `Aprovisionado` (re-enrolamiento)",{"_3602":73800,"_30987":73592,"_21467":124138,"_5":14750,"_28174":123633,"_3058":124139},[],"principals obsoletos marcados como `REVOKED`, nueva ejecución de `iot:RegisterThing`; el nuevo ARN del certificado sustituye al anterior en los metadatos de Lamassu",{"_3602":73801,"_30987":73592,"_21467":124141,"_5":14750,"_28174":123633,"_3058":124142},[],"En modo `jitp` el conector no hace llamadas de aprovisionamiento: AWS ejecuta la plantilla JITP en la primera conexión del dispositivo y crea el Thing, registra el certificado y lo activa por su cuenta.",{"_3602":73802,"_30987":73592,"_21467":124144,"_5":14750,"_28174":123637,"_3058":124145},[],"En el modo JITP el dispositivo también realiza su enrolamiento EST de forma convencional y obtiene su certificado de Lamassu. La diferencia es que AWS IoT Core no conoce al dispositivo hasta que este intenta conectarse por primera vez.",{"_3602":73803,"_30987":73592,"_21467":124147,"_5":14750,"_28174":123637,"_3058":124148},[],"Cuando el dispositivo establece su primera conexión MQTT a AWS IoT Core presentando el certificado emitido por Lamassu, AWS detecta que el certificado pertenece a una CA registrada con una plantilla JITP, ejecuta esa plantilla y crea el Thing automáticamente. La conexión inicial puede fallar o demorarse mientras se ejecuta la plantilla; el firmware debe estar preparado para reintentar la conexión.",{"_3602":73804,"_30987":73592,"_21467":124150,"_5":14750,"_28174":123637,"_3058":124151},[],"Para que el flujo JITP funcione correctamente:",{"_3602":73805,"_30987":73592,"_21467":124153,"_5":14750,"_28174":123637,"_3058":124154},[],"La CA debe estar registrada en AWS en modo Primary Account (el modo SNI-only no admite JITP).",{"_3602":73806,"_30987":73592,"_21467":124156,"_5":14750,"_28174":123637,"_3058":124157},[],"El rol IAM configurado en `jitp_config.provisioning_role_arn` debe existir y tener permisos para crear Things, registrar certificados y adjuntar políticas en la cuenta AWS.",{"_3602":73807,"_30987":73592,"_21467":124159,"_5":14750,"_28174":123637,"_3058":124160},[],"El dispositivo debe presentar tanto su certificado como el certificado de la CA emisora en el handshake TLS con AWS IoT Core.",{"_3602":73808,"_30987":73592,"_21467":124162,"_5":14750,"_28174":123637,"_3058":124163},[],"Los certificados aprovisionados mediante JITP **no tienen asociada la clave de metadatos del conector** (`lamassu.io/iot/{connector_id}`) en Lamassu. Como consecuencia, los cambios de estado de esos certificados en Lamassu no se sincronizan automáticamente con AWS a través del mecanismo de sincronización de estado descrito en la siguiente sección.",{"_3602":73809,"_30987":73592,"_21467":124165,"_5":14750,"_28174":123641,"_3058":124166},[],"El conector escucha el evento `EventUpdateCertificateStatusKey` y, cuando un certificado que tiene la clave de metadatos del conector cambia de estado en Lamassu, replica ese cambio en AWS IoT Core. La tabla siguiente muestra la correspondencia de estados:",{"_3602":73810,"_30987":73592,"_21467":124168,"_5":14750,"_28174":123641,"_3058":124169},[],"Estado en Lamassu",{"_3602":73811,"_30987":73592,"_21467":124171,"_5":14750,"_28174":123641,"_3058":124172},[],"Razón de revocación",{"_3602":73812,"_30987":73592,"_21467":124174,"_5":14750,"_28174":123641,"_3058":124175},[],"Estado en AWS IoT Core",{"_3602":73813,"_30987":73592,"_21467":124177,"_5":14750,"_28174":123641,"_3058":55429},[],{"_3602":73814,"_30987":73592,"_21467":124179,"_5":14750,"_28174":123641,"_3058":124180},[],"Ninguna",{"_3602":73815,"_30987":73592,"_21467":124182,"_5":14750,"_28174":123641,"_3058":55435},[],{"_3602":73816,"_30987":73592,"_21467":124184,"_5":14750,"_28174":123641,"_3058":55438},[],{"_3602":73817,"_30987":73592,"_21467":124186,"_5":14750,"_28174":123641,"_3058":55441},[],{"_3602":73818,"_30987":73592,"_21467":124188,"_5":14750,"_28174":123641,"_3058":55444},[],{"_3602":73819,"_30987":73592,"_21467":124190,"_5":14750,"_28174":123641,"_3058":55438},[],{"_3602":73820,"_30987":73592,"_21467":124192,"_5":14750,"_28174":123641,"_3058":124193},[],"Cualquier otra razón",{"_3602":73821,"_30987":73592,"_21467":124195,"_5":14750,"_28174":123641,"_3058":55452},[],{"_3602":73822,"_30987":73592,"_21467":124197,"_5":14750,"_28174":123641,"_3058":124198},[],"Solo los estados `Active` y `Revoked` producen una llamada a `iot:UpdateCertificate`. Los demás estados del ciclo de vida de Lamassu (`RenewalWindow`, `AboutToExpire`, `Expired`) no se sincronizan con AWS IoT Core; el estado del certificado en AWS permanece sin cambios hasta que el estado en Lamassu sea `Active` o `Revoked`.",{"_3602":73823,"_30987":73592,"_21467":124200,"_5":14750,"_28174":123645,"_3058":124201},[],"Los certificados con la clave de metadatos del conector sincronizan su estado; los aprovisionados vía JITP no tienen clave de metadatos y quedan fuera de esta máquina:",{"_3602":73824,"_30987":73592,"_21467":124203,"_5":14750,"_28174":123645,"_3058":123987},[],{"_3602":73825,"_30987":73592,"_21467":124205,"_5":14750,"_28174":123645,"_3058":123990},[],{"_3602":73826,"_30987":73592,"_21467":124207,"_5":14750,"_28174":123645,"_3058":124208},[],"`NoSincronizado` → `Active`",{"_3602":73827,"_30987":73592,"_21467":124210,"_5":14750,"_28174":123645,"_3058":54944},[],{"_3602":73828,"_30987":73592,"_21467":124212,"_5":14750,"_28174":123645,"_3058":55470},[],{"_3602":73829,"_30987":73592,"_21467":124214,"_5":14750,"_28174":123645,"_3058":124215},[],"`iot:UpdateCertificate` + desconexión MQTT forzada",{"_3602":73830,"_30987":73592,"_21467":124217,"_5":14750,"_28174":123645,"_3058":55476},[],{"_3602":73831,"_30987":73592,"_21467":124219,"_5":14750,"_28174":123645,"_3058":124215},[],{"_3602":73832,"_30987":73592,"_21467":124221,"_5":14750,"_28174":123645,"_3058":55481},[],{"_3602":73833,"_30987":73592,"_21467":124223,"_5":14750,"_28174":123645,"_3058":54944},[],{"_3602":73834,"_30987":73592,"_21467":124225,"_5":14750,"_28174":123645,"_3058":55486},[],{"_3602":73835,"_30987":73592,"_21467":124227,"_5":14750,"_28174":123645,"_3058":124228},[],"ninguna (estos estados no se sincronizan con AWS)",{"_3602":73836,"_30987":73592,"_21467":124230,"_5":14750,"_28174":123649,"_3058":124231},[],"Cuando el conector marca un certificado como `REVOKED` o `INACTIVE` en AWS, ejecuta adicionalmente una desconexión forzada del dispositivo. Para ello abre una conexión MQTT sobre WebSocket (con autenticación SigV4 con las credenciales del conector) al endpoint de datos de AWS IoT Core, usando el CN del certificado como identificador de cliente MQTT, y la cierra inmediatamente. Esto termina cualquier sesión MQTT activa que el dispositivo pueda tener en ese momento.",{"_3602":73837,"_30987":73592,"_21467":124233,"_5":14750,"_28174":123649,"_3058":124234},[],"Esta desconexión forzada se produce en el momento en que Lamassu registra el cambio de estado. Si el dispositivo vuelve a intentar conectarse tras la desconexión, AWS IoT Core rechazará la conexión porque el certificado ya figura como `REVOKED` o `INACTIVE`.",{"_3602":73838,"_30987":73592,"_21467":124236,"_5":14750,"_28174":123649,"_3058":124237},[],"Los certificados aprovisionados en modo JITP no disponen de esta sincronización automática, ya que no tienen la clave de metadatos del conector.",{"_3602":73839,"_30987":73592,"_21467":124239,"_5":14750,"_28174":123653,"_3058":124240},[],"El conector puede escribir en el Device Shadow de AWS IoT Core para enviar señales de acción al firmware del dispositivo. Esta funcionalidad se activa por DMS mediante `shadow_config.enable: true`.",{"_3602":73840,"_30987":73592,"_21467":124242,"_5":14750,"_28174":123653,"_3058":124243},[],"Si `shadow_config.shadow_name` contiene un valor, el conector usa un Named Shadow con ese nombre; en caso contrario, usa el Classic Shadow (shadow predeterminado del Thing).",{"_3602":73841,"_30987":73592,"_21467":124245,"_5":14750,"_28174":123657,"_3058":124246},[],"El conector escribe en el campo `desired.identity_actions` del documento shadow. Cada entrada contiene un timestamp Unix en milisegundos. El firmware del dispositivo debe leer este campo y actuar en consecuencia.",{"_3602":73842,"_30987":73592,"_21467":124248,"_5":14750,"_28174":123657,"_3058":124249},[],"Existen dos tipos de acciones:",{"_3602":73843,"_30987":73592,"_21467":124251,"_5":14750,"_28174":123657,"_3058":124252},[],"**`UPDATE_CERTIFICATE`**: se escribe cuando la ventana de renovación preventiva de un certificado se activa - es decir, cuando el campo `triggered` de la delta de renovación preventiva pasa de `false` a `true`. Esta acción indica al dispositivo que debe iniciar el proceso de re-enrolamiento para renovar su certificado antes de que expire.",{"_3602":73844,"_30987":73592,"_21467":124254,"_5":14750,"_28174":123657,"_3058":124255},[],"**`UPDATE_TRUST_ANCHOR_LIST`**: se escribe en todos los dispositivos de un DMS cuando la lista `ManagedCAs` del DMS cambia. Esta acción indica al dispositivo que debe actualizar su almacén de CAs de confianza.",{"_3602":73845,"_30987":73592,"_21467":124257,"_5":14750,"_28174":123657,"_3058":124258},[],"El proceso de escritura en el shadow consiste en leer el shadow actual (`iotdata:GetThingShadow`), combinar las nuevas acciones con las existentes y escribir el resultado (`iotdata:UpdateThingShadow`). Si el shadow no existe, el conector lo crea. Tras una escritura correcta, la lista de acciones pendientes en los metadatos del dispositivo en Lamassu se limpia.",{"_3602":73846,"_30987":73592,"_21467":124260,"_5":14750,"_28174":123661,"_3058":124261},[],"El conector crea y adjunta las políticas que se configuran en el DMS. Una política típica para un dispositivo que usa MQTT y Device Shadow tiene la siguiente estructura:",{"_3602":73847,"_30987":73592,"_21467":124263,"_5":14750,"_28174":123661,"_3058":124264},[],"En la política anterior, los marcadores `<AWS_REGION>` y `<AWS_ACCOUNT_ID>` deben reemplazarse por la región AWS y el identificador de cuenta de doce dígitos de la cuenta destino antes de aplicar la política. La variable `${iot:Connection.Thing.ThingName}` limita automáticamente cada permiso al Thing al que el dispositivo está conectado, siguiendo el principio de mínimo privilegio. La variable `${ShadowName}` en los ARN de shadow es un marcador que debe reemplazarse con el valor de `shadow_config.shadow_name` configurado en el DMS; si se usa el Classic Shadow, se puede simplificar eliminando el segmento `name/${ShadowName}/`. Las políticas de AWS IoT no admiten expresiones regulares con alternancia; la notación `[name/${ShadowName}/]*` representa la opcionalidad del segmento dentro de las restricciones de la sintaxis de ARN.",{"_3602":73848,"_30987":73592,"_21467":124266,"_5":14750,"_28174":123661,"_3058":124267},[],"El primer statement permite que el dispositivo se conecte usando su ThingName como identificador MQTT. El segundo autoriza la publicación en el topic MQTT genérico del Thing y en los topics del shadow, necesario para que el dispositivo pueda actualizar el estado reportado. Los dos últimos statements otorgan permisos de suscripción y recepción sobre los mismos topics, lo que permite al dispositivo recibir actualizaciones del shadow (por ejemplo, las acciones `UPDATE_CERTIFICATE` y `UPDATE_TRUST_ANCHOR_LIST` escritas por el conector).",{"_3602":73849,"_30987":73592,"_21467":124269,"_5":14750,"_28174":123665,"_3058":124270},[],"**Síntoma:** El registro de la CA permanece indefinidamente en estado `REQUESTED`.",{"_3602":73850,"_30987":73592,"_21467":124272,"_5":14750,"_28174":123665,"_3058":124273},[],"**Causa:** El conector no está en ejecución o no está suscrito al bus de eventos. También puede indicar credenciales IAM incorrectas, permisos insuficientes o que la clave de metadatos se escribió con un `connector_id` incorrecto.",{"_3602":73851,"_30987":73592,"_21467":124275,"_5":14750,"_28174":123665,"_3058":124276},[],"**Resolución:** Verificar que el proceso del conector está activo y que los logs no muestran errores de comunicación con AWS. Comprobar que el campo de metadatos se escribió bajo la clave exacta `lamassu.io/iot/{connector_id}`. Si el error persiste, el conector actualizará el estado a `FAILED` con un mensaje descriptivo en los metadatos de la CA.",{"_3602":73852,"_30987":73592,"_21467":124278,"_5":14750,"_28174":123665,"_3058":124279},[],"**Síntoma:** El estado de un certificado no se sincroniza con AWS tras una revocación.",{"_3602":73853,"_30987":73592,"_21467":124281,"_5":14750,"_28174":123665,"_3058":124282},[],"**Causa:** Lo más habitual es que el certificado fue aprovisionado en modo JITP. Los certificados JITP no tienen la clave de metadatos del conector y quedan fuera del mecanismo de sincronización de estado. Si el DMS está en modo `auto`, puede indicar que el aprovisionamiento inicial no completó correctamente y el ARN de AWS no se almacenó en los metadatos del certificado.",{"_3602":73854,"_30987":73592,"_21467":124284,"_5":14750,"_28174":123665,"_3058":124285},[],"**Resolución:** Para certificados JITP, migrar el DMS a modo `auto` y re-aprovisionar los dispositivos afectados. Para certificados en modo `auto`, verificar que el certificado tiene el ARN de AWS almacenado en sus metadatos; si no lo tiene, repetir el aprovisionamiento.",{"_3602":73855,"_30987":73592,"_21467":124287,"_5":14750,"_28174":123665,"_3058":124288},[],"**Síntoma:** La desconexión forzada no termina la sesión MQTT del dispositivo tras la revocación.",{"_3602":73856,"_30987":73592,"_21467":124290,"_5":14750,"_28174":123665,"_3058":124291},[],"**Causa:** El dispositivo usa un client ID MQTT diferente al CN del certificado. La desconexión forzada abre una conexión usando el CN como client ID; si el firmware usa otro identificador, la desconexión no afecta a esa sesión.",{"_3602":73857,"_30987":73592,"_21467":124293,"_5":14750,"_28174":123665,"_3058":124294},[],"**Resolución:** Asegurarse de que el firmware usa exactamente el CN del certificado como identificador de cliente MQTT. Ese CN coincide con el ThingName en AWS IoT Core.",{"_3602":73858,"_30987":73592,"_21467":124296,"_5":14750,"_28174":123665,"_3058":124297},[],"**Síntoma:** El dispositivo recibe `CLIENT_ID_REJECTED` al conectarse a AWS IoT Core.",{"_3602":73859,"_30987":73592,"_21467":124299,"_5":14750,"_28174":123665,"_3058":124300},[],"**Causa:** El client ID MQTT no coincide con el ThingName, que es siempre el CN del certificado emitido por Lamassu.",{"_3602":73860,"_30987":73592,"_21467":124302,"_5":14750,"_28174":123665,"_3058":124303},[],"**Resolución:** Verificar que el firmware usa exactamente el valor del campo CN incluido en el CSR de enrolamiento como identificador de cliente MQTT.",{"_3602":73861,"_30987":73592,"_21467":124305,"_5":14750,"_28174":123665,"_3058":124306},[],"**Síntoma:** La primera conexión MQTT del dispositivo en modo JITP falla o excede el tiempo de espera.",{"_3602":73862,"_30987":73592,"_21467":124308,"_5":14750,"_28174":123665,"_3058":124309},[],"**Causa:** Es el comportamiento esperado mientras AWS ejecuta la plantilla JITP en la primera conexión del dispositivo.",{"_3602":73863,"_30987":73592,"_21467":124311,"_5":14750,"_28174":123665,"_3058":124312},[],"**Resolución:** El firmware debe implementar reintentos con backoff exponencial para la primera conexión. Si el fallo persiste más allá de unos minutos, verificar que el rol IAM configurado en `jitp_config.provisioning_role_arn` existe en la cuenta y tiene permisos para crear Things, registrar certificados y adjuntar políticas.",{"_3602":73864,"_30987":73592,"_21467":124314,"_5":14750,"_28174":123665,"_3058":124315},[],"**Síntoma:** El Device Shadow no se actualiza cuando debería.",{"_3602":73865,"_30987":73592,"_21467":124317,"_5":14750,"_28174":123665,"_3058":124318},[],"**Causa:** La función de shadow está desactivada en la configuración del DMS, las credenciales del conector carecen de permisos sobre la API de datos de IoT, o el firmware lee un shadow diferente al configurado.",{"_3602":73866,"_30987":73592,"_21467":124320,"_5":14750,"_28174":123665,"_3058":124321},[],"**Resolución:** Comprobar que `shadow_config.enable` está a `true` en los metadatos del conector para el DMS correspondiente. Si se usa Named Shadow, verificar que `shadow_config.shadow_name` contiene el nombre correcto y que el firmware lee ese Named Shadow y no el Classic Shadow. Confirmar que las credenciales del conector tienen permisos `iotdata:GetThingShadow` y `iotdata:UpdateThingShadow`.",{"_3602":73867,"_30987":73592,"_21467":124323,"_5":14750,"_28174":123665,"_3058":124324},[],"**Síntoma:** Tras editar un DMS en modo `jitp`, aparecen mensajes de actualización del DMS en `lamassu-dlq`, o los cambios de configuración JITP no tienen efecto en AWS.",{"_3602":73868,"_30987":73592,"_21467":124326,"_5":14750,"_28174":123665,"_3058":124327},[],"**Causa:** Cada edición completa del DMS (`PUT /v1/dms/{id}`) dispara un nuevo intento de `CreateProvisioningTemplate` para la plantilla nombrada con el ID del DMS, y la llamada no es idempotente: cuando la plantilla ya existe, falla, el evento se reintenta tres veces y acaba en `lamassu-dlq`. Se omiten los pasos posteriores del conector.",{"_3602":73869,"_30987":73592,"_21467":124329,"_5":14750,"_28174":123665,"_3058":124330},[],"**Resolución:** Comprobar que la plantilla nombrada con el ID del DMS existe en AWS IoT Core y que el enrolamiento JITP funciona. Si se cambió la configuración JITP, aplicarla a mano en la plantilla de AWS.",{"_3602":73870,"_30987":73592,"_21467":124332,"_5":14750,"_28174":123665,"_3058":124333},[],"<Card title=\"Configurar un DMS\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_3602":73871,"_30987":73592,"_21467":124335,"_5":14750,"_28174":123665,"_3058":124336},[],"<Card title=\"Enrolamiento de dispositivos (EST)\" href=\"/docs/platform/iot-fleets/enrollment/overview\" />",{"_3602":73872,"_30987":73592,"_21467":124338,"_5":14750,"_28174":123665,"_3058":124339},[],"<Card title=\"Gestión de certificados\" href=\"/docs/platform/pki/certificates\" />",{"_3602":73873,"_30987":73873,"_5":15110,"_3058":53307,"_31325":124341,"_21467":124342,"_28174":73873},[50623,121012,53307],[],{"_3602":73874,"_30987":73873,"_21467":124344,"_5":14750,"_28174":73873,"_3058":124345},[],"Organiza los dispositivos y sus identidades, prepara el enrolamiento e integra consumidores.",{"_3602":73875,"_30987":73873,"_5":31322,"_21467":124347,"_28174":124348,"_3058":124349},[],"/docs/es/platform/iot-fleets/overview#empieza-aquí","Empieza aquí",{"_3602":73876,"_30987":73873,"_5":31322,"_21467":124351,"_28174":124352,"_3058":122157},[],"/docs/es/platform/iot-fleets/overview#dispositivos-e-identidades",{"_3602":73877,"_30987":73873,"_5":31322,"_21467":124354,"_28174":124355,"_3058":122332},[],"/docs/es/platform/iot-fleets/overview#enrolamiento-con-pki",{"_3602":73878,"_30987":73873,"_5":31322,"_21467":124357,"_28174":124358,"_3058":123564},[],"/docs/es/platform/iot-fleets/overview#integraciones",{"_3602":73879,"_30987":73873,"_5":31322,"_21467":124360,"_28174":124361,"_3058":124362},[],"/docs/es/platform/iot-fleets/overview#quién-prepara-cada-parte","Quién prepara cada parte",{"_3602":73880,"_30987":73873,"_21467":124364,"_5":14750,"_28174":73873,"_3058":124365},[],"IoT Fleets aplica la PKI al ciclo de vida de dispositivos: registro, obtención de identidad, renovación y retirada. Está dirigido a quien administra una población de dispositivos y a quien integra su cliente de enrolamiento o el sistema que los acepta.",{"_3602":73881,"_30987":73873,"_21467":124367,"_5":14750,"_28174":124348,"_3058":124368},[],"Sigue Enrola y conecta tu primer dispositivo para preparar un DMS, obtener la identidad desde el cliente y demostrar una conexión mTLS. El recorrido automático incluye confianza inicial, CSR y comprobación del resultado.",{"_3602":73882,"_30987":73873,"_21467":124370,"_5":14750,"_28174":124348,"_3058":124371},[],"Si necesitas comenzar con un certificado existente, utiliza Registra un dispositivo manualmente. Después podrás preparar el enrolamiento y la renovación del siguiente dispositivo.",{"_3602":73883,"_30987":73873,"_21467":124373,"_5":14750,"_28174":124352,"_3058":124374},[],"Recurso",{"_3602":73884,"_30987":73873,"_21467":124376,"_5":14750,"_28174":124352,"_3058":124377},[],"Qué representa",{"_3602":73885,"_30987":73873,"_21467":124379,"_5":14750,"_28174":124352,"_3058":124380},[],"**Dispositivo**",{"_3602":73886,"_30987":73873,"_21467":124382,"_5":14750,"_28174":124352,"_3058":124383},[],"Una entrada de inventario con identificador, DMS propietario y clasificación.",{"_3602":73887,"_30987":73873,"_21467":124385,"_5":14750,"_28174":124352,"_3058":124386},[],"**Identidad**",{"_3602":73888,"_30987":73873,"_21467":124388,"_5":14750,"_28174":124352,"_3058":124389},[],"La asociación del dispositivo con sus certificados: una versión activa y un historial.",{"_3602":73889,"_30987":73873,"_21467":124391,"_5":14750,"_28174":124352,"_3058":55653},[],{"_3602":73890,"_30987":73873,"_21467":124393,"_5":14750,"_28174":124352,"_3058":124394},[],"El servicio que configura admisión, enrolamiento, renovación y distribución de confianza.",{"_3602":73891,"_30987":73873,"_21467":124396,"_5":14750,"_28174":124352,"_3058":124397},[],"**Flota**",{"_3602":73892,"_30987":73873,"_21467":124399,"_5":14750,"_28174":124352,"_3058":124400},[],"La población que operas, representada mediante dispositivos, DMS, etiquetas y metadatos.",{"_3602":73893,"_30987":73873,"_21467":124402,"_5":14750,"_28174":124352,"_3058":124403},[],"Cada dispositivo tiene un DMS propietario. Puedes organizar una población mediante varios DMS cuando necesita políticas distintas, y utilizar etiquetas para clasificarla. «Flota» describe ese contexto operativo; los recursos que creas y consultas son DMS y dispositivos.",{"_3602":73894,"_30987":73873,"_21467":124405,"_5":14750,"_28174":124352,"_3058":124406},[],"La gestión de dispositivos reúne estados, historial de certificados y acciones sobre la identidad. Al renovar, debes conservar la relación con el dispositivo y comprobar qué certificado pasa a ser la identidad actual.",{"_3602":73895,"_30987":73873,"_21467":124408,"_5":14750,"_28174":124355,"_3058":124409},[],"Este bloque conecta las reglas PKI con el cliente del dispositivo. La preparación sigue este orden:",{"_3602":73896,"_30987":73873,"_21467":124411,"_5":14750,"_28174":124355,"_3058":124412},[],"**CA y perfil:** prepara el emisor y las reglas del certificado en PKI.",{"_3602":73897,"_30987":73873,"_21467":124414,"_5":14750,"_28174":124355,"_3058":124415},[],"**Política DMS:** define cómo se admite el dispositivo, cómo se autentican sus solicitudes y qué confianza se distribuye.",{"_3602":73898,"_30987":73873,"_21467":124417,"_5":14750,"_28174":124355,"_3058":124418},[],"**Cliente:** prepara la credencial inicial, la confianza del servidor y la generación o custodia de la clave.",{"_3602":73899,"_30987":73873,"_21467":124420,"_5":14750,"_28174":124355,"_3058":124421},[],"**Resultado:** solicita el certificado, instálalo y comprueba su asociación con el dispositivo.",{"_3602":73900,"_30987":73873,"_21467":124423,"_5":14750,"_28174":124355,"_3058":124424},[],"**Continuidad:** configura renovación, instalación del sucesor y recuperación según la política del DMS.",{"_3602":73901,"_30987":73873,"_21467":124426,"_5":14750,"_28174":124355,"_3058":124427},[],"<Card title=\"Configura el DMS\" description=\"Prepara la CA, la admisión, la autenticación y las reglas de renovación.\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_3602":73902,"_30987":73873,"_21467":124429,"_5":14750,"_28174":124355,"_3058":124430},[],"<Card title=\"Integra el cliente EST\" description=\"Consulta los endpoints, formatos y comprobaciones del dispositivo.\" href=\"/docs/platform/iot-fleets/enrollment/est-client\" />",{"_3602":73903,"_30987":73873,"_21467":124432,"_5":14750,"_28174":124358,"_3058":124433},[],"Una identidad emitida necesita un consumidor que confíe en su emisor, valide el certificado y conceda permisos al dispositivo. Prepara tanto la confianza del dispositivo en el servidor como la del servidor en el dispositivo.",{"_3602":73904,"_30987":73873,"_21467":124435,"_5":14750,"_28174":124358,"_3058":124436},[],"La guía de AWS IoT Core explica cómo utilizar la identidad en ese destino. El aprovisionamiento en Lamassu y el aprovisionamiento en el destino son decisiones distintas; revisa las condiciones del modo elegido antes de esperar sincronización de estados.",{"_3602":73905,"_30987":73873,"_21467":124438,"_5":14750,"_28174":124361,"_3058":124439},[],"Participante",{"_3602":73906,"_30987":73873,"_21467":124441,"_5":14750,"_28174":124361,"_3058":124442},[],"Responsabilidad",{"_3602":73907,"_30987":73873,"_21467":124444,"_5":14750,"_28174":124361,"_3058":124445},[],"Administrador PKI",{"_3602":73908,"_30987":73873,"_21467":124447,"_5":14750,"_28174":124361,"_3058":124448},[],"CA, perfil de emisión, cadena y publicación de revocación.",{"_3602":73909,"_30987":73873,"_21467":124450,"_5":14750,"_28174":124361,"_3058":124451},[],"Administrador del aprovisionamiento",{"_3602":73910,"_30987":73873,"_21467":124453,"_5":14750,"_28174":124361,"_3058":124454},[],"DMS, admisión, autenticación por operación e inventario.",{"_3602":73911,"_30987":73873,"_21467":124456,"_5":14750,"_28174":124361,"_3058":124457},[],"Integrador del dispositivo",{"_3602":73912,"_30987":73873,"_21467":124459,"_5":14750,"_28174":124361,"_3058":124460},[],"Credencial inicial, clave, cliente EST, confianza e instalación de certificados.",{"_3602":73913,"_30987":73873,"_21467":124462,"_5":14750,"_28174":124361,"_3058":124463},[],"Integrador del consumidor",{"_3602":73914,"_30987":73873,"_21467":124465,"_5":14750,"_28174":124361,"_3058":124466},[],"Emisores confiables, validación y permisos del dispositivo en el destino.",{"_3602":73915,"_30987":73873,"_21467":124468,"_5":14750,"_28174":124361,"_3058":124469},[],"Los permisos y la auditoría son compartidos con el resto de Plataforma. La instalación y la conectividad de la instancia se preparan en Despliegue.",{"_3602":73916,"_30987":73916,"_5":15110,"_3058":124471,"_31325":124472,"_21467":124474,"_28174":73916},"Enrola y conecta tu primer dispositivo",[50623,121012,53307,124473],"Primeros pasos",[],{"_3602":73917,"_30987":73916,"_21467":124476,"_5":14750,"_28174":73916,"_3058":124477},[],"Obtén una identidad por EST, verifica su asociación y úsala en una conexión mTLS.",{"_3602":73918,"_30987":73916,"_5":31322,"_21467":124479,"_28174":124480,"_3058":119546},[],"/docs/es/platform/iot-fleets/quickstarts/enroll-device#antes-de-empezar",{"_3602":73919,"_30987":73916,"_5":31322,"_21467":124482,"_28174":124483,"_3058":124484},[],"/docs/es/platform/iot-fleets/quickstarts/enroll-device#prepara-la-credencial-inicial","Prepara la credencial inicial",{"_3602":73920,"_30987":73916,"_5":31322,"_21467":124486,"_28174":124487,"_3058":124488},[],"/docs/es/platform/iot-fleets/quickstarts/enroll-device#configura-el-dms-de-evaluación","Configura el DMS de evaluación",{"_3602":73921,"_30987":73916,"_5":31322,"_21467":124490,"_28174":124491,"_3058":124492},[],"/docs/es/platform/iot-fleets/quickstarts/enroll-device#prepara-el-cliente-y-comprueba-cacerts","Prepara el cliente y comprueba cacerts",{"_3602":73922,"_30987":73916,"_5":31322,"_21467":124494,"_28174":124495,"_3058":124496},[],"/docs/es/platform/iot-fleets/quickstarts/enroll-device#enrola-el-dispositivo","Enrola el dispositivo",{"_3602":73923,"_30987":73916,"_5":31322,"_21467":124498,"_28174":124499,"_3058":124500},[],"/docs/es/platform/iot-fleets/quickstarts/enroll-device#verifica-la-identidad-obtenida","Verifica la identidad obtenida",{"_3602":73924,"_30987":73916,"_5":31322,"_21467":124502,"_28174":124503,"_3058":124504},[],"/docs/es/platform/iot-fleets/quickstarts/enroll-device#demuestra-una-conexión-mtls","Demuestra una conexión mTLS",{"_3602":73925,"_30987":73916,"_5":31322,"_21467":124506,"_28174":124507,"_3058":124508},[],"/docs/es/platform/iot-fleets/quickstarts/enroll-device#resultado-y-continuidad","Resultado y continuidad",{"_3602":73926,"_30987":73916,"_21467":124510,"_5":14750,"_28174":73916,"_3058":124511},[],"Prepararás un DMS de evaluación, enrolarás `est-device-001` desde el cliente y usarás su identidad frente a un consumidor local que exige certificado. El recorrido conecta la política del administrador con el material que realmente instala el dispositivo.",{"_3602":73927,"_30987":73916,"_21467":124513,"_5":14750,"_28174":124480,"_3058":124514},[],"Instancia Lamassu accesible por HTTPS y permisos para CAs, perfiles, DMS y lectura de dispositivos/certificados.",{"_3602":73928,"_30987":73916,"_21467":124516,"_5":14750,"_28174":124480,"_3058":124517},[],"Bash, OpenSSL 3.x, curl con `--fail-with-body` y dos terminales en tu equipo. Trabaja en un directorio nuevo con acceso restringido.",{"_3602":73929,"_30987":73916,"_21467":124519,"_5":14750,"_28174":124480,"_3058":124520},[],"Una CA raíz activa que emita directamente, con clave disponible y vigencia suficiente. Sigue Crea tu primera CA. Guarda su certificado público verificado como `device-root.pem`.",{"_3602":73930,"_30987":73916,"_21467":124522,"_5":14750,"_28174":124480,"_3058":124523},[],"El identificador global `est-device-001` libre. Este recorrido utiliza registro automático: no crees primero el dispositivo desde la consola.",{"_3602":73931,"_30987":73916,"_21467":124525,"_5":14750,"_28174":124480,"_3058":124526},[],"La raíz aprobada para el HTTPS de Lamassu en `est-trust.pem`, obtenida por un canal independiente. Puede ser distinta de la CA de dispositivos; prepara red/TLS en Despliegue.",{"_3602":73932,"_30987":73916,"_21467":124528,"_5":14750,"_28174":124483,"_3058":124529},[],"Emite un certificado final bootstrap con `CN=est-device-001`, clave propia y uso Client Authentication. Puedes seguir Emite y verifica un certificado, sustituyendo su CN y guardando el resultado como `bootstrap.crt` y `bootstrap.key`. Elige una validez que cubra esta prueba y comprueba la pareja y la cadena.",{"_3602":73933,"_30987":73916,"_21467":124531,"_5":14750,"_28174":124483,"_3058":124532},[],"Para esta evaluación aislada puede emitirlo la misma CA raíz. La identidad operativa tendrá una clave y un certificado distintos. El CN igual facilita la lectura del ejemplo; la autenticación inicial por certificado no vincula por sí sola el CN del bootstrap con el ID pedido. Revisa la admisión antes de aplicar la política a una población.",{"_3602":73934,"_30987":73916,"_21467":124534,"_5":14750,"_28174":124487,"_3058":124535},[],"Crea un perfil final explícito, compatible con EC P-256, con **Honor Subject**, CN de la CSR, **Digital Signature**, **Client Authentication** y una validez de **1 hora** dentro de la vigencia de la raíz. No habilites firma como CA. Las reglas y precedencia se explican en Perfiles.",{"_3602":73935,"_30987":73916,"_21467":124537,"_5":14750,"_28174":124487,"_3058":124538},[],"Crea el DMS `Acme EST Evaluation` con esta configuración:",{"_3602":73936,"_30987":73916,"_21467":124540,"_5":14750,"_28174":124487,"_3058":124541},[],"Ajuste",{"_3602":73937,"_30987":73916,"_21467":124543,"_5":14750,"_28174":124487,"_3058":124544},[],"Valor de evaluación",{"_3602":73938,"_30987":73916,"_21467":124546,"_5":14750,"_28174":124487,"_3058":55809},[],{"_3602":73939,"_30987":73916,"_21467":124548,"_5":14750,"_28174":124487,"_3058":124549},[],"Raíz emisora de `device-root.pem`.",{"_3602":73940,"_30987":73916,"_21467":124551,"_5":14750,"_28174":124487,"_3058":122460},[],{"_3602":73941,"_30987":73916,"_21467":124553,"_5":14750,"_28174":124487,"_3058":124554},[],"Perfil final de 1 hora que acabas de preparar.",{"_3602":73942,"_30987":73916,"_21467":124556,"_5":14750,"_28174":124487,"_3058":55820},[],{"_3602":73943,"_30987":73916,"_21467":124558,"_5":14750,"_28174":124487,"_3058":55823},[],{"_3602":73944,"_30987":73916,"_21467":124560,"_5":14750,"_28174":124487,"_3058":55826},[],{"_3602":73945,"_30987":73916,"_21467":124562,"_5":14750,"_28174":124487,"_3058":124563},[],"Habilitado.",{"_3602":73946,"_30987":73916,"_21467":124565,"_5":14750,"_28174":124487,"_3058":55832},[],{"_3602":73947,"_30987":73916,"_21467":124567,"_5":14750,"_28174":124487,"_3058":124568},[],"Deshabilitado; el ID debe ser nuevo.",{"_3602":73948,"_30987":73916,"_21467":124570,"_5":14750,"_28174":124487,"_3058":124571},[],"Autenticación inicial",{"_3602":73949,"_30987":73916,"_21467":124573,"_5":14750,"_28174":124487,"_3058":124574},[],"`CLIENT_CERTIFICATE`; Validation CAs incluye el emisor directo del bootstrap; no aceptar vencidos.",{"_3602":73950,"_30987":73916,"_21467":124576,"_5":14750,"_28174":124487,"_3058":124577},[],"Autenticación de renovación",{"_3602":73951,"_30987":73916,"_21467":124579,"_5":14750,"_28174":124487,"_3058":124580},[],"`CLIENT_CERTIFICATE`, configurada en el bloque independiente de re-enrollment.",{"_3602":73952,"_30987":73916,"_21467":124582,"_5":14750,"_28174":124487,"_3058":55850},[],{"_3602":73953,"_30987":73916,"_21467":124584,"_5":14750,"_28174":124487,"_3058":124585},[],"No se necesitan para esta emisión directa; la CA de enrolamiento siempre es confiable en el reenrolamiento / deshabilitado.",{"_3602":73954,"_30987":73916,"_21467":124587,"_5":14750,"_28174":124487,"_3058":55856},[],{"_3602":73955,"_30987":73916,"_21467":124589,"_5":14750,"_28174":124487,"_3058":124590},[],"1 hora.",{"_3602":73956,"_30987":73916,"_21467":124592,"_5":14750,"_28174":124487,"_3058":55862},[],{"_3602":73957,"_30987":73916,"_21467":124594,"_5":14750,"_28174":124487,"_3058":124595},[],"30 minutos / 10 minutos.",{"_3602":73958,"_30987":73916,"_21467":124597,"_5":14750,"_28174":124487,"_3058":55868},[],{"_3602":73959,"_30987":73916,"_21467":124599,"_5":14750,"_28174":124487,"_3058":124600},[],"Deshabilitado para probar el sucesor antes de retirar el anterior.",{"_3602":73960,"_30987":73916,"_21467":124602,"_5":14750,"_28174":124487,"_3058":53626},[],{"_3602":73961,"_30987":73916,"_21467":124604,"_5":14750,"_28174":124487,"_3058":124605},[],"Deshabilitado; la clave operativa se genera en el cliente.",{"_3602":73962,"_30987":73916,"_21467":124607,"_5":14750,"_28174":124487,"_3058":55879},[],{"_3602":73963,"_30987":73916,"_21467":124609,"_5":14750,"_28174":124487,"_3058":124610},[],"Include Enrollment CA habilitado; Include Lamassu System CA deshabilitado.",{"_3602":73964,"_30987":73916,"_21467":124612,"_5":14750,"_28174":124487,"_3058":124613},[],"La duración y ventana iguales permiten probar renovación inmediatamente. Son valores de evaluación; dimensiona producción según conectividad y tiempos de recuperación. Guarda, vuelve a leer los dos bloques de autenticación y conserva el ID del DMS. La consola expone editores independientes para la autenticación de enrolamiento y de reenrolamiento; la guía DMS describe sus campos, y también puedes comprobar el recurso mediante la API DMS.",{"_3602":73965,"_30987":73916,"_21467":124615,"_5":14750,"_28174":124491,"_3058":124616},[],"En el directorio nuevo, coloca los cuatro archivos de confianza y bootstrap. Sustituye el URL por el de tu instalación:",{"_3602":73966,"_30987":73916,"_21467":124618,"_5":14750,"_28174":124491,"_3058":124619},[],"La descarga debe ser satisfactoria y contener la raíz de enrolamiento prevista. Compara su huella con `device-root.pem`. Esta comprobación no convierte la respuesta en confianza inicial ni demuestra que puedas emitir.",{"_3602":73967,"_30987":73916,"_21467":124621,"_5":14750,"_28174":124495,"_3058":124622},[],"Genera una clave nueva y una CSR con el identificador elegido:",{"_3602":73968,"_30987":73916,"_21467":124624,"_5":14750,"_28174":124495,"_3058":124625},[],"Solicita la identidad con la credencial inicial y extrae el certificado de la respuesta predeterminada:",{"_3602":73969,"_30987":73916,"_21467":124627,"_5":14750,"_28174":124495,"_3058":124628},[],"Si curl falla, consulta Diagnóstico con el cuerpo guardado. No ejecutes la conversión ni repitas la solicitud sin consultar el inventario: un timeout o error puede seguir a una emisión persistida.",{"_3602":73970,"_30987":73916,"_21467":124630,"_5":14750,"_28174":124499,"_3058":124631},[],"Espera `device.crt: OK` y código 0 de `cmp`. Comprueba CN, serie, fechas, Digital Signature y Client Authentication. El certificado debe ser final: no declarar `CA:TRUE` ni uso Certificate Sign. Revisa que su validez corresponda al perfil de una hora.",{"_3602":73971,"_30987":73916,"_21467":124633,"_5":14750,"_28174":124499,"_3058":124634},[],"En Lamassu, abre `est-device-001`. Debe estar creado con el DMS propietario previsto, una identidad actual y el certificado recibido en su historial. Compara la serie local con la del slot; los umbrales pueden mostrar un estado de renovación en vez de un simple Active.",{"_3602":73972,"_30987":73916,"_21467":124636,"_5":14750,"_28174":124503,"_3058":124637},[],"En una segunda terminal, entra en el mismo directorio y ejecuta `umask 077`. Crea un certificado local de servidor y arranca un consumidor de prueba. Este servidor confía en `device-root.pem` y exige una identidad cliente válida:",{"_3602":73973,"_30987":73916,"_21467":124639,"_5":14750,"_28174":124503,"_3058":124640},[],"Déjalo funcionando. En la primera terminal, realiza la conexión con la identidad obtenida:",{"_3602":73974,"_30987":73916,"_21467":124642,"_5":14750,"_28174":124503,"_3058":124643},[],"Espera HTTP `200`. La confianza del cliente en este servidor local es su certificado autofirmado `consumer.crt`; el servidor verifica al dispositivo contra `device-root.pem`. El archivo HTML muestra información de diagnóstico de OpenSSL.",{"_3602":73975,"_30987":73916,"_21467":124645,"_5":14750,"_28174":124503,"_3058":124646},[],"Con el mismo servidor todavía funcionando, prueba que una solicitud sin certificado cliente se rechaza:",{"_3602":73976,"_30987":73916,"_21467":124648,"_5":14750,"_28174":124503,"_3058":124649},[],"El rechazo debe corresponder a la falta de certificado en el servidor, no a un servidor detenido. Termina el consumidor con Ctrl+C después de la prueba. Este ejercicio demuestra autenticación TLS y posesión de la clave; tu aplicación debe definir además autorización y consumo de revocación. Las opciones del servidor se describen en openssl-s\\_server.",{"_3602":73977,"_30987":73916,"_21467":124651,"_5":14750,"_28174":124507,"_3058":124652},[],"Comprobación",{"_3602":73978,"_30987":73916,"_21467":124654,"_5":14750,"_28174":124507,"_3058":124655},[],"Resultado esperado",{"_3602":73979,"_30987":73916,"_21467":124657,"_5":14750,"_28174":124507,"_3058":124658},[],"Registro",{"_3602":73980,"_30987":73916,"_21467":124660,"_5":14750,"_28174":124507,"_3058":124661},[],"ID creado automáticamente y DMS correcto.",{"_3602":73981,"_30987":73916,"_21467":124663,"_5":14750,"_28174":124507,"_3058":123948},[],{"_3602":73982,"_30987":73916,"_21467":124665,"_5":14750,"_28174":124507,"_3058":124666},[],"CN, perfil, serie y clave verificados.",{"_3602":73983,"_30987":73916,"_21467":124668,"_5":14750,"_28174":124507,"_3058":124669},[],"Inventario",{"_3602":73984,"_30987":73916,"_21467":124671,"_5":14750,"_28174":124507,"_3058":124672},[],"Serie recibida visible como identidad actual y en el historial.",{"_3602":73985,"_30987":73916,"_21467":124674,"_5":14750,"_28174":124507,"_3058":124675},[],"Consumidor",{"_3602":73986,"_30987":73916,"_21467":124677,"_5":14750,"_28174":124507,"_3058":124678},[],"mTLS responde 200 con la identidad y rechaza falta de certificado.",{"_3602":73987,"_30987":73916,"_21467":124680,"_5":14750,"_28174":124507,"_3058":124681},[],"Continúa con Renovación y recuperación para solicitar una pareja sucesora dentro de la ventana, instalarla y repetir la comprobación mTLS. El consumidor debe utilizar los archivos nuevos en esa prueba. Después de comprobar el sucesor, retira el certificado anterior según la política PKI; el ejemplo no lo revoca automáticamente.",{"_3602":73988,"_30987":73916,"_21467":124683,"_5":14750,"_28174":124507,"_3058":124684},[],"Dispositivos e identidades explica la retirada y los límites de revocación del historial. Para un destino real, prepara confianza, validación y permisos del consumidor; AWS IoT Core es una integración disponible.",{"_3602":73989,"_30987":73989,"_5":15110,"_3058":122174,"_31325":124686,"_21467":124687,"_28174":73989},[50623,121012,53307,124473],[],{"_3602":73990,"_30987":73989,"_21467":124689,"_5":14750,"_28174":73989,"_3058":124690},[],"Prepara un DMS, registra un dispositivo y asocia un certificado comprobado a su identidad.",{"_3602":73991,"_30987":73989,"_5":31322,"_21467":124692,"_28174":124693,"_3058":119546},[],"/docs/es/platform/iot-fleets/quickstarts/register-device#antes-de-empezar",{"_3602":73992,"_30987":73989,"_5":31322,"_21467":124695,"_28174":124696,"_3058":124697},[],"/docs/es/platform/iot-fleets/quickstarts/register-device#prepara-el-dms","Prepara el DMS",{"_3602":73993,"_30987":73989,"_5":31322,"_21467":124699,"_28174":124700,"_3058":124701},[],"/docs/es/platform/iot-fleets/quickstarts/register-device#registra-el-dispositivo","Registra el dispositivo",{"_3602":73994,"_30987":73989,"_5":31322,"_21467":124703,"_28174":124704,"_3058":124705},[],"/docs/es/platform/iot-fleets/quickstarts/register-device#comprueba-el-estado-inicial","Comprueba el estado inicial",{"_3602":73995,"_30987":73989,"_5":31322,"_21467":124707,"_28174":124708,"_3058":124709},[],"/docs/es/platform/iot-fleets/quickstarts/register-device#asigna-una-identidad","Asigna una identidad",{"_3602":73996,"_30987":73989,"_5":31322,"_21467":124711,"_28174":124712,"_3058":124713},[],"/docs/es/platform/iot-fleets/quickstarts/register-device#verifica-el-dispositivo","Verifica el dispositivo",{"_3602":73997,"_30987":73989,"_5":31322,"_21467":124715,"_28174":124716,"_3058":124655},[],"/docs/es/platform/iot-fleets/quickstarts/register-device#resultado-esperado",{"_3602":73998,"_30987":73989,"_5":31322,"_21467":124718,"_28174":124719,"_3058":124720},[],"/docs/es/platform/iot-fleets/quickstarts/register-device#si-el-resultado-falla","Si el resultado falla",{"_3602":73999,"_30987":73989,"_5":31322,"_21467":124722,"_28174":124723,"_3058":124724},[],"/docs/es/platform/iot-fleets/quickstarts/register-device#automatiza-el-siguiente-dispositivo","Automatiza el siguiente dispositivo",{"_3602":74000,"_30987":73989,"_21467":124726,"_5":14750,"_28174":73989,"_3058":124727},[],"Este recorrido está dirigido a quien empieza a administrar identidades de dispositivos. Registrarás `device-001` y le asignarás un certificado existente para comprobar la relación entre dispositivo, DMS e historial de identidad.",{"_3602":74001,"_30987":73989,"_21467":124729,"_5":14750,"_28174":73989,"_3058":124730},[],"La asignación modifica el inventario de Lamassu. La clave y el certificado se instalan por separado en el dispositivo; la conexión con un consumidor se comprueba en la integración de ese destino.",{"_3602":74002,"_30987":73989,"_21467":124732,"_5":14750,"_28174":124693,"_3058":124733},[],"Una instancia accesible y permisos para administrar DMS, dispositivos y la asociación de certificados.",{"_3602":74003,"_30987":73989,"_21467":124735,"_5":14750,"_28174":124693,"_3058":124736},[],"Una CA activa con clave disponible. Si todavía no existe, sigue Crea tu primera CA.",{"_3602":74004,"_30987":73989,"_21467":124738,"_5":14750,"_28174":124693,"_3058":124739},[],"Un certificado final activo de esa CA cuyo `Common Name` sea exactamente `device-001`, con su clave privada. Sigue Emite y verifica un certificado para obtener y comprobar ambos.",{"_3602":74005,"_30987":73989,"_21467":124741,"_5":14750,"_28174":124693,"_3058":124742},[],"El identificador `device-001` libre en el inventario. Si ya lo usaste, elige otro y emite el certificado con ese mismo `Common Name`.",{"_3602":74006,"_30987":73989,"_21467":124744,"_5":14750,"_28174":124696,"_3058":124745},[],"Un DMS debe existir antes de registrar el dispositivo. Si ya tienes uno adecuado, comprueba su CA y anota su identificador; si necesitas crearlo:",{"_3602":74007,"_30987":73989,"_21467":124747,"_5":14750,"_28174":124696,"_3058":124748},[],"Abre el inventario de DMS y la acción de creación. Asigna un nombre reconocible, como `Acme Evaluation DMS`.",{"_3602":74008,"_30987":73989,"_21467":124750,"_5":14750,"_28174":124696,"_3058":124751},[],"En **Enrollment CA**, selecciona la CA que emitió `device.crt`.",{"_3602":74009,"_30987":73989,"_21467":124753,"_5":14750,"_28174":124696,"_3058":124754},[],"En **Registration Mode**, selecciona `PRE_REGISTRATION` para el recorrido que comienza con un alta explícita.",{"_3602":74010,"_30987":73989,"_21467":124756,"_5":14750,"_28174":124696,"_3058":124757},[],"En la sección de autenticación, activa **Require client certificate** y deja **Call external webhook** desactivado. Bajo **Require client certificate**, añade a **Validation CAs** la CA cuyos certificados iniciales aceptarás; para esta evaluación puede ser la misma CA. Mantén habilitada **Verify CSR Signature** y deja **Enable server-side key generation** desactivado si no lo vas a utilizar.",{"_3602":74011,"_30987":73989,"_21467":124759,"_5":14750,"_28174":124696,"_3058":124760},[],"Revisa los ajustes de renovación y distribución de confianza con la guía DMS, guarda el servicio y anota su identificador.",{"_3602":74012,"_30987":73989,"_21467":124762,"_5":14750,"_28174":124696,"_3058":124763},[],"Vuelve a abrir el DMS y confirma que la CA de enrolamiento es la prevista y que el servicio aparece en el inventario.",{"_3602":74013,"_30987":73989,"_21467":124765,"_5":14750,"_28174":124696,"_3058":124766},[],"Estos ajustes preparan la política DMS. Los pasos siguientes realizan el alta y la asignación desde la consola; no envían una solicitud EST ni prueban la admisión por ese protocolo.",{"_3602":74014,"_30987":73989,"_21467":124768,"_5":14750,"_28174":124700,"_3058":124769},[],"Abre **Managed Devices** y la acción de registro. Completa:",{"_3602":74015,"_30987":73989,"_21467":124771,"_5":14750,"_28174":124700,"_3058":56044},[],{"_3602":74016,"_30987":73989,"_21467":124773,"_5":14750,"_28174":124700,"_3058":124774},[],"**Registration Authority**: el DMS que acabas de preparar; la etiqueta identifica al servicio que cumple el rol de autoridad de registro.",{"_3602":74017,"_30987":73989,"_21467":124776,"_5":14750,"_28174":124700,"_3058":124777},[],"**Icon** y **Tags**: clasificación opcional.",{"_3602":74018,"_30987":73989,"_21467":124779,"_5":14750,"_28174":124700,"_3058":124780},[],"Confirma el registro.",{"_3602":74019,"_30987":73989,"_21467":124782,"_5":14750,"_28174":124704,"_3058":124783},[],"Abre el dispositivo. Debe aparecer en **No Identity** y mostrar el DMS propietario seleccionado.",{"_3602":74020,"_30987":73989,"_21467":124785,"_5":14750,"_28174":124704,"_3058":124786},[],"El registro crea la entrada de inventario; el certificado todavía debe asociarse.",{"_3602":74021,"_30987":73989,"_21467":124788,"_5":14750,"_28174":124708,"_3058":124789},[],"Selecciona **Assign Identity** y el certificado existente con `CN=device-001`. Comprueba su número de serie, emisor y vigencia frente al certificado que verificaste en PKI.",{"_3602":74022,"_30987":73989,"_21467":124791,"_5":14750,"_28174":124708,"_3058":124792},[],"Confirma la asociación. La alternativa **Issue New Instead** se explica en Dispositivos e identidades.",{"_3602":74023,"_30987":73989,"_21467":124794,"_5":14750,"_28174":124712,"_3058":124795},[],"Comprueba que tiene una identidad activa. En **Certificate History**, verifica el número de serie asociado; en **Device Event Timeline**, localiza el evento de asignación.",{"_3602":74024,"_30987":73989,"_21467":124797,"_5":14750,"_28174":124712,"_3058":124798},[],"Conserva el identificador del dispositivo, el DMS propietario y el número de serie como referencias del resultado.",{"_3602":74025,"_30987":73989,"_21467":124800,"_5":14750,"_28174":124716,"_3058":124652},[],{"_3602":74026,"_30987":73989,"_21467":124802,"_5":14750,"_28174":124716,"_3058":124803},[],"Resultado",{"_3602":74027,"_30987":73989,"_21467":124805,"_5":14750,"_28174":124716,"_3058":123934},[],{"_3602":74028,"_30987":73989,"_21467":124807,"_5":14750,"_28174":124716,"_3058":124808},[],"`device-001` aparece en el inventario con el DMS previsto.",{"_3602":74029,"_30987":73989,"_21467":124810,"_5":14750,"_28174":124716,"_3058":124811},[],"Identidad actual",{"_3602":74030,"_30987":73989,"_21467":124813,"_5":14750,"_28174":124716,"_3058":124814},[],"El certificado asociado coincide con el que verificaste en PKI.",{"_3602":74031,"_30987":73989,"_21467":124816,"_5":14750,"_28174":124716,"_3058":124817},[],"Historial",{"_3602":74032,"_30987":73989,"_21467":124819,"_5":14750,"_28174":124716,"_3058":124820},[],"La emisión asociada aparece con su número de serie y fechas.",{"_3602":74033,"_30987":73989,"_21467":124822,"_5":14750,"_28174":124716,"_3058":124823},[],"Clave y certificado",{"_3602":74034,"_30987":73989,"_21467":124825,"_5":14750,"_28174":124716,"_3058":124826},[],"Dispones de la pareja comprobada para instalarla en el dispositivo.",{"_3602":74035,"_30987":73989,"_21467":124828,"_5":14750,"_28174":124719,"_3058":124829},[],"Si el DMS no puede seleccionarse, confirma su creación y tus permisos de lectura.",{"_3602":74036,"_30987":73989,"_21467":124831,"_5":14750,"_28174":124719,"_3058":124832},[],"Si no aparece un certificado elegible, comprueba que su `Common Name` coincide exactamente con el `Device ID`, está activo y lo emitió la CA prevista.",{"_3602":74037,"_30987":73989,"_21467":124834,"_5":14750,"_28174":124719,"_3058":124835},[],"Si falla la asignación, revisa los permisos y el diagnóstico de la operación antes de repetirla. Vuelve a consultar el dispositivo y su historial para conocer el resultado persistido.",{"_3602":74038,"_30987":73989,"_21467":124837,"_5":14750,"_28174":124719,"_3058":124838},[],"Si aparece un estado relacionado con vencimiento o renovación, comprueba las fechas del certificado y los umbrales del DMS en Dispositivos e identidades.",{"_3602":74039,"_30987":73989,"_21467":124840,"_5":14750,"_28174":124723,"_3058":124841},[],"Continúa con DMS y EST para que el dispositivo solicite y renueve sus certificados. Prepara la confianza del servidor, la credencial inicial y las políticas de cada operación antes de implementar el cliente.",{"_3602":74040,"_30987":73989,"_21467":124843,"_5":14750,"_28174":124723,"_3058":124844},[],"Para un recorrido desde el cliente hasta mTLS, sigue Enrola y conecta tu primer dispositivo con un ID nuevo.",{"_3602":74041,"_30987":73989,"_21467":124846,"_5":14750,"_28174":124723,"_3058":124847},[],"Para utilizar la identidad en AWS IoT Core, prepara también la confianza y los permisos del destino. Comprueba la conexión desde el dispositivo después de instalar la clave, el certificado y la cadena necesarios.",{"_3602":74042,"_30987":74042,"_5":15110,"_3058":124849,"_31325":124850,"_21467":124851,"_28174":74042},"Plataforma Lamassu IoT",[50623,121012],[],{"_3602":74043,"_30987":74042,"_21467":124853,"_5":14750,"_28174":74042,"_3058":124854},[],"Construye una PKI y aplica sus certificados al ciclo de vida de tus dispositivos.",{"_3602":74044,"_30987":74042,"_5":31322,"_21467":124856,"_28174":124857,"_3058":124349},[],"/docs/es/platform/overview#empieza-aquí",{"_3602":74045,"_30987":74042,"_5":31322,"_21467":124859,"_28174":124860,"_3058":124861},[],"/docs/es/platform/overview#elige-tu-recorrido","Elige tu recorrido",{"_3602":74046,"_30987":74042,"_5":31322,"_21467":124863,"_28174":124864,"_3058":124865},[],"/docs/es/platform/overview#arquitectura-de-un-vistazo","Arquitectura de un vistazo",{"_3602":74047,"_30987":74042,"_5":31322,"_21467":124867,"_28174":124868,"_3058":124869},[],"/docs/es/platform/overview#capacidades-principales","Capacidades principales",{"_3602":74048,"_30987":74042,"_5":31322,"_21467":124871,"_28174":124872,"_3058":124873},[],"/docs/es/platform/overview#construye-tu-jerarquía-de-confianza","Construye tu jerarquía de confianza",{"_3602":74049,"_30987":74042,"_5":31322,"_21467":124875,"_28174":124876,"_3058":124877},[],"/docs/es/platform/overview#protege-las-claves-criptográficas","Protege las claves criptográficas",{"_3602":74050,"_30987":74042,"_5":31322,"_21467":124879,"_28174":124880,"_3058":124881},[],"/docs/es/platform/overview#emite-y-controla-certificados","Emite y controla certificados",{"_3602":74051,"_30987":74042,"_5":31322,"_21467":124883,"_28174":124884,"_3058":124885},[],"/docs/es/platform/overview#automatiza-identidades-de-dispositivos","Automatiza identidades de dispositivos",{"_3602":74052,"_30987":74042,"_5":31322,"_21467":124887,"_28174":124888,"_3058":124889},[],"/docs/es/platform/overview#publica-el-estado-de-validación","Publica el estado de validación",{"_3602":74053,"_30987":74042,"_5":31322,"_21467":124891,"_28174":124892,"_3058":124893},[],"/docs/es/platform/overview#reacciona-a-los-eventos","Reacciona a los eventos",{"_3602":74054,"_30987":74042,"_5":31322,"_21467":124895,"_28174":124896,"_3058":124897},[],"/docs/es/platform/overview#referencia-operativa","Referencia operativa",{"_3602":74055,"_30987":74042,"_21467":124899,"_5":14750,"_28174":74042,"_3058":124900},[],"Lamassu IoT permite administrar una PKI privada y utilizarla para emitir, renovar y revocar identidades X.509 de dispositivos. La documentación de Plataforma sigue dos recorridos: **PKI**, para gestionar las autoridades y los certificados, e **IoT Fleets**, para aplicar esas identidades a una población de dispositivos.",{"_3602":74056,"_30987":74042,"_21467":124902,"_5":14750,"_28174":124857,"_3058":124903},[],"Elige el resultado que necesitas obtener:",{"_3602":74057,"_30987":74042,"_21467":124905,"_5":14750,"_28174":124857,"_3058":124906},[],"<Card title=\"Emitir y verificar un certificado\" description=\"Prepara una CA, emite una identidad X.509 y comprueba su cadena y su clave.\" href=\"/docs/platform/pki/quickstarts/overview\" />",{"_3602":74058,"_30987":74042,"_21467":124908,"_5":14750,"_28174":124857,"_3058":124909},[],"<Card title=\"Enrolar y conectar un dispositivo\" description=\"Prepara el DMS, solicita la identidad por EST y comprueba una conexión mTLS.\" href=\"/docs/platform/iot-fleets/quickstarts/enroll-device\" />",{"_3602":74059,"_30987":74042,"_21467":124911,"_5":14750,"_28174":124857,"_3058":124912},[],"Si todavía estás preparando la instancia, empieza en Despliegue. Los recorridos de Plataforma parten de una consola accesible y de permisos para realizar las operaciones.",{"_3602":74060,"_30987":74042,"_21467":124914,"_5":14750,"_28174":124860,"_3058":124915},[],"Bloque",{"_3602":74061,"_30987":74042,"_21467":124917,"_5":14750,"_28174":124860,"_3058":124918},[],"Qué gestionas",{"_3602":74062,"_30987":74042,"_21467":124920,"_5":14750,"_28174":124860,"_3058":124921},[],"Punto de entrada",{"_3602":74063,"_30987":74042,"_21467":124923,"_5":14750,"_28174":124860,"_3058":56197},[],{"_3602":74064,"_30987":74042,"_21467":124925,"_5":14750,"_28174":124860,"_3058":124926},[],"Claves, autoridades, perfiles, certificados y publicación del estado de revocación.",{"_3602":74065,"_30987":74042,"_21467":124928,"_5":14750,"_28174":124860,"_3058":124929},[],"Visión general de PKI",{"_3602":74066,"_30987":74042,"_21467":124931,"_5":14750,"_28174":124860,"_3058":56206},[],{"_3602":74067,"_30987":74042,"_21467":124933,"_5":14750,"_28174":124860,"_3058":124934},[],"Dispositivos, historial de identidad, políticas DMS, enrolamiento EST e integraciones.",{"_3602":74068,"_30987":74042,"_21467":124936,"_5":14750,"_28174":124860,"_3058":124937},[],"Visión general de IoT Fleets",{"_3602":74069,"_30987":74042,"_21467":124939,"_5":14750,"_28174":124860,"_3058":124940},[],"**Administración**",{"_3602":74070,"_30987":74042,"_21467":124942,"_5":14750,"_28174":124860,"_3058":124943},[],"Permisos de operadores, auditoría y suscripciones a eventos.",{"_3602":74071,"_30987":74042,"_21467":124945,"_5":14750,"_28174":124860,"_3058":121014},[],{"_3602":74072,"_30987":74042,"_21467":124947,"_5":14750,"_28174":124860,"_3058":124948},[],"Una CA determina quién firma y un perfil establece qué puede emitirse. El DMS aplica la política de admisión y enrolamiento. El dispositivo conserva la asociación con sus certificados, y el consumidor externo decide qué identidad acepta.",{"_3602":74073,"_30987":74042,"_21467":124950,"_5":14750,"_28174":124864,"_3058":124951},[],"El recorrido de una identidad conecta cuatro responsabilidades:",{"_3602":74074,"_30987":74042,"_21467":124953,"_5":14750,"_28174":124864,"_3058":124954},[],"El administrador PKI prepara la autoridad, su clave y las reglas de emisión.",{"_3602":74075,"_30987":74042,"_21467":124956,"_5":14750,"_28174":124864,"_3058":124957},[],"El administrador del aprovisionamiento configura el DMS y la confianza inicial.",{"_3602":74076,"_30987":74042,"_21467":124959,"_5":14750,"_28174":124864,"_3058":124960},[],"El cliente del dispositivo solicita un certificado y lo instala junto con la clave que le corresponde.",{"_3602":74077,"_30987":74042,"_21467":124962,"_5":14750,"_28174":124864,"_3058":124963},[],"El consumidor valida la identidad y aplica sus permisos de acceso.",{"_3602":74078,"_30987":74042,"_21467":124965,"_5":14750,"_28174":124864,"_3058":124966},[],"Consulta Cómo funciona Lamassu para entender los recursos y la arquitectura de la plataforma para conocer los servicios. La instalación, la exposición de red y las dependencias se explican en Despliegue.",{"_3602":74079,"_30987":74042,"_21467":124968,"_5":14750,"_28174":124872,"_3058":124969},[],"Crea o incorpora autoridades y organiza sus relaciones en PKI. La jerarquía y su rotación determinan qué cadenas deberán reconocer los consumidores.",{"_3602":74080,"_30987":74042,"_21467":124971,"_5":14750,"_28174":124876,"_3058":124972},[],"Elige el motor que custodiará las claves de las autoridades y controla quién puede utilizarlas. Consulta Claves y motores; la preparación del proveedor forma parte del despliegue.",{"_3602":74081,"_30987":74042,"_21467":124974,"_5":14750,"_28174":124880,"_3058":124975},[],"Define perfiles de emisión, firma solicitudes y consulta el inventario de certificados. El certificado emitido debe comprobarse desde el cliente que lo utilizará.",{"_3602":74082,"_30987":74042,"_21467":124977,"_5":14750,"_28174":124884,"_3058":124978},[],"Configura un DMS y utiliza EST para solicitar y renovar certificados. La preparación de la credencial inicial y la instalación del resultado pertenecen a la integración del dispositivo.",{"_3602":74083,"_30987":74042,"_21467":124980,"_5":14750,"_28174":124888,"_3058":124981},[],"Utiliza OCSP y CRL para publicar el estado de revocación. Cada consumidor debe configurar cómo consulta y aplica esa información.",{"_3602":74084,"_30987":74042,"_21467":124983,"_5":14750,"_28174":124892,"_3058":124984},[],"Consulta auditoría para investigar cambios y configura alertas y suscripciones para reaccionar a eventos del ciclo de vida.",{"_3602":74085,"_30987":74042,"_21467":124986,"_5":14750,"_28174":124896,"_3058":124442},[],{"_3602":74086,"_30987":74042,"_21467":124988,"_5":14750,"_28174":124896,"_3058":124989},[],"Qué prepara o comprueba",{"_3602":74087,"_30987":74042,"_21467":124991,"_5":14750,"_28174":124896,"_3058":124445},[],{"_3602":74088,"_30987":74042,"_21467":124993,"_5":14750,"_28174":124896,"_3058":124994},[],"Custodia de claves, jerarquía de CAs, perfiles y validación.",{"_3602":74089,"_30987":74042,"_21467":124996,"_5":14750,"_28174":124896,"_3058":124997},[],"Administrador de la flota",{"_3602":74090,"_30987":74042,"_21467":124999,"_5":14750,"_28174":124896,"_3058":125000},[],"DMS, admisión de dispositivos, política de renovación e inventario.",{"_3602":74091,"_30987":74042,"_21467":125002,"_5":14750,"_28174":124896,"_3058":124457},[],{"_3602":74092,"_30987":74042,"_21467":125004,"_5":14750,"_28174":124896,"_3058":125005},[],"Credencial inicial, confianza en el servidor, cliente EST y almacenamiento de clave y certificado.",{"_3602":74093,"_30987":74042,"_21467":125007,"_5":14750,"_28174":124896,"_3058":124463},[],{"_3602":74094,"_30987":74042,"_21467":125009,"_5":14750,"_28174":124896,"_3058":125010},[],"Confianza en los emisores, validación de certificados y permisos en el destino.",{"_3602":74095,"_30987":74042,"_21467":125012,"_5":14750,"_28174":124896,"_3058":125013},[],"Operador de infraestructura",{"_3602":74096,"_30987":74042,"_21467":125015,"_5":14750,"_28174":124896,"_3058":125016},[],"Instalación, red, disponibilidad, dependencias y diagnóstico de despliegue.",{"_3602":74097,"_30987":74042,"_21467":125018,"_5":14750,"_28174":124896,"_3058":125019},[],"La Referencia API recoge los contratos para automatizar las operaciones. Para resolver un fallo, empieza en el bloque afectado: PKI, EST o Despliegue.",{"_3602":74098,"_30987":74098,"_5":15110,"_3058":125021,"_31325":125022,"_21467":125024,"_28174":74098},"Jerarquía y rotación de CAs",[50623,121012,56298,125023],"Claves, autoridades y certificados",[],{"_3602":74099,"_30987":74098,"_21467":125026,"_5":14750,"_28174":74098,"_3058":125027},[],"Diseña autoridades raíz e intermedias y sustituye certificados o claves sin romper la confianza.",{"_3602":74100,"_30987":74098,"_5":31322,"_21467":125029,"_28174":125030,"_3058":125031},[],"/docs/es/platform/pki/ca-hierarchy-and-rotation#diseña-la-jerarquía","Diseña la jerarquía",{"_3602":74101,"_30987":74098,"_5":31322,"_21467":125033,"_28174":125034,"_3058":125035},[],"/docs/es/platform/pki/ca-hierarchy-and-rotation#reemisión-y-rotación-no-son-lo-mismo","Reemisión y rotación no son lo mismo",{"_3602":74102,"_30987":74098,"_5":31322,"_21467":125037,"_28174":125038,"_3058":125039},[],"/docs/es/platform/pki/ca-hierarchy-and-rotation#cuándo-elegir-cada-operación","Cuándo elegir cada operación",{"_3602":74103,"_30987":74098,"_5":31322,"_21467":125041,"_28174":125042,"_3058":125043},[],"/docs/es/platform/pki/ca-hierarchy-and-rotation#procedimiento-de-rotación-de-clave","Procedimiento de rotación de clave",{"_3602":74104,"_30987":74098,"_5":31322,"_21467":125045,"_28174":125046,"_3058":125047},[],"/docs/es/platform/pki/ca-hierarchy-and-rotation#inventaría-las-dependencias","Inventaría las dependencias",{"_3602":74105,"_30987":74098,"_5":31322,"_21467":125049,"_28174":125050,"_3058":125051},[],"/docs/es/platform/pki/ca-hierarchy-and-rotation#crea-la-ca-sucesora","Crea la CA sucesora",{"_3602":74106,"_30987":74098,"_5":31322,"_21467":125053,"_28174":125054,"_3058":125055},[],"/docs/es/platform/pki/ca-hierarchy-and-rotation#distribuye-la-nueva-confianza","Distribuye la nueva confianza",{"_3602":74107,"_30987":74098,"_5":31322,"_21467":125057,"_28174":125058,"_3058":125059},[],"/docs/es/platform/pki/ca-hierarchy-and-rotation#cambia-la-emisión","Cambia la emisión",{"_3602":74108,"_30987":74098,"_5":31322,"_21467":125061,"_28174":125062,"_3058":125063},[],"/docs/es/platform/pki/ca-hierarchy-and-rotation#renueva-por-lotes","Renueva por lotes",{"_3602":74109,"_30987":74098,"_5":31322,"_21467":125065,"_28174":125066,"_3058":125067},[],"/docs/es/platform/pki/ca-hierarchy-and-rotation#cierra-el-solapamiento","Cierra el solapamiento",{"_3602":74110,"_30987":74098,"_5":31322,"_21467":125069,"_28174":125070,"_3058":125071},[],"/docs/es/platform/pki/ca-hierarchy-and-rotation#revocación-en-cascada","Revocación en cascada",{"_3602":74111,"_30987":74098,"_5":31322,"_21467":125073,"_28174":125074,"_3058":125075},[],"/docs/es/platform/pki/ca-hierarchy-and-rotation#comprobaciones-después-del-cambio","Comprobaciones después del cambio",{"_3602":74112,"_30987":74098,"_21467":125077,"_5":14750,"_28174":74098,"_3058":125078},[],"La jerarquía determina el alcance de cualquier error o compromiso. Una raíz firma CAs intermedias; las intermedias emiten las identidades que usan dispositivos y servicios. Esta separación permite aislar entornos y rotar una rama sin reemplazar toda la confianza.",{"_3602":74113,"_30987":74098,"_21467":125080,"_5":14750,"_28174":74098,"_3058":125081},[],"Este procedimiento se dirige al operador PKI que sustituye una autoridad en uso. Necesitas acceso a las CAs, claves y perfiles, un inventario de dependencias y coordinación con quienes gestionan los almacenes de confianza y dispositivos. Antes de cambiar la emisión, prepara una cohorte de prueba y decide el criterio para cerrar el solapamiento.",{"_3602":74114,"_30987":74098,"_21467":125083,"_5":14750,"_28174":125030,"_3058":125084},[],"Para una instalación de producción, utiliza una raíz muy restringida y una o más intermedias operativas. Separa intermedias cuando cambie alguno de estos límites:",{"_3602":74115,"_30987":74098,"_21467":125086,"_5":14750,"_28174":125030,"_3058":125087},[],"entorno, como producción y preproducción;",{"_3602":74116,"_30987":74098,"_21467":125089,"_5":14750,"_28174":125030,"_3058":125090},[],"propietario o equipo operador;",{"_3602":74117,"_30987":74098,"_21467":125092,"_5":14750,"_28174":125030,"_3058":125093},[],"familia de dispositivos o proceso de fabricación;",{"_3602":74118,"_30987":74098,"_21467":125095,"_5":14750,"_28174":125030,"_3058":125096},[],"región o requisito regulatorio;",{"_3602":74119,"_30987":74098,"_21467":125098,"_5":14750,"_28174":125030,"_3058":125099},[],"motor criptográfico o política de clave;",{"_3602":74120,"_30987":74098,"_21467":125101,"_5":14750,"_28174":125030,"_3058":125102},[],"ventana de mantenimiento y ritmo de renovación.",{"_3602":74121,"_30987":74098,"_21467":125104,"_5":14750,"_28174":125030,"_3058":125105},[],"Evita jerarquías profundas sin una necesidad concreta. Cada nivel añade distribución de cadena, validación y otro certificado que debes renovar.",{"_3602":74122,"_30987":74098,"_21467":125107,"_5":14750,"_28174":125030,"_3058":125108},[],"Una CA hija y los certificados finales deben expirar antes que su emisor. Reserva un margen que permita distribuir otra cadena y renovar los certificados dependientes.",{"_3602":74123,"_30987":74098,"_21467":125110,"_5":14750,"_28174":125034,"_3058":125111},[],"**Reemitir una CA** crea un certificado nuevo sobre la clave existente. Lamassu genera una CSR con esa clave, autofirma si es una raíz o pide a la CA padre que firme si es subordinada. El nuevo certificado queda activo y la CA apunta a su número de serie; los certificados anterior y nuevo quedan enlazados mediante metadatos.",{"_3602":74124,"_30987":74098,"_21467":125113,"_5":14750,"_28174":125034,"_3058":125114},[],"Si los ajustes de CRL de la CA están firmados por el certificado de la CA sustituido, al reemitir el firmante se mueve al certificado nuevo, siempre que incluya `cRLSign`, y se republica la CRL. En caso contrario, y para unos ajustes firmados por otro certificado, el firmante se conserva, así que comprueba el uso de clave del certificado nuevo tras reemitir; consulta la guía de CRL.",{"_3602":74125,"_30987":74098,"_21467":125116,"_5":14750,"_28174":125034,"_3058":125117},[],"**Rotar una CA** crea una clave y una autoridad sucesoras. Es la opción adecuada ante compromiso, cambio criptográfico, migración de motor o política de claves no exportables.",{"_3602":74126,"_30987":74098,"_21467":125119,"_5":14750,"_28174":125034,"_3058":125120},[],"Lamassu no permite reemitir una CA ya revocada ni una CA cuya fecha de expiración haya pasado. Una CA subordinada la firma su CA padre, de modo que esta también debe estar `ACTIVE` y dentro de su periodo de validez; en caso contrario la reemisión falla con `400`. Anticípate a estas condiciones.",{"_3602":74127,"_30987":74098,"_21467":125122,"_5":14750,"_28174":125038,"_3058":125123},[],"Reemite si la clave sigue siendo confiable y solo necesitas otro periodo de validez o un certificado actualizado.",{"_3602":74128,"_30987":74098,"_21467":125125,"_5":14750,"_28174":125038,"_3058":125126},[],"Rota la clave si existe sospecha de compromiso, cambia el algoritmo o quieres mover la custodia a otro motor.",{"_3602":74129,"_30987":74098,"_21467":125128,"_5":14750,"_28174":125038,"_3058":125129},[],"Crea una rama paralela si no puedes actualizar todos los consumidores al mismo tiempo.",{"_3602":74130,"_30987":74098,"_21467":125131,"_5":14750,"_28174":125038,"_3058":125132},[],"Revoca inmediatamente solo cuando el riesgo de mantener la CA supera el impacto de interrumpir la flota.",{"_3602":74131,"_30987":74098,"_21467":125134,"_5":14750,"_28174":125046,"_3058":125135},[],"Localiza CAs hijas, certificados emitidos, DMS, conectores y almacenes de confianza externos. Incluye dispositivos que pueden permanecer desconectados durante semanas o meses.",{"_3602":74132,"_30987":74098,"_21467":125137,"_5":14750,"_28174":125050,"_3058":125138},[],"Genera una clave nueva en el motor previsto, crea la CA y asígnale un perfil explícito. No reutilices el identificador operativo para ocultar que es una generación distinta.",{"_3602":74133,"_30987":74098,"_21467":125140,"_5":14750,"_28174":125054,"_3058":125141},[],"Añade la nueva raíz o cadena a los consumidores antes de emitir con ella. Si distribuyes mediante EST `/cacerts`, incluye explícitamente las CAs gestionadas necesarias y comprueba el contenido; no presupongas que incluir la CA emisora añade todas sus intermedias. Instala la nueva confianza en una cohorte y verifica que también sigue aceptando la identidad anterior.",{"_3602":74134,"_30987":74098,"_21467":125143,"_5":14750,"_28174":125058,"_3058":125144},[],"Actualiza la CA de enrolamiento y el perfil de los DMS. Mientras sigan renovando cohortes con certificados antiguos, añade la CA de enrolamiento anterior a las CAs de validación de re-enrolamiento (`reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`) de cada DMS: la nueva CA de enrolamiento se considera confiable automáticamente, pero la antigua era la CA de enrolamiento y no figura en ninguna lista de confianza de re-enrolamiento, así que sin esa entrada sus certificados ya no podrán renovarse. La guía DMS documenta ese ajuste.",{"_3602":74135,"_30987":74098,"_21467":125146,"_5":14750,"_28174":125062,"_3058":125147},[],"Migra una cohorte pequeña, valida mTLS, OCSP y CRL desde el consumidor y amplía progresivamente. Supervisa qué dispositivos siguen presentando la cadena antigua.",{"_3602":74136,"_30987":74098,"_21467":125149,"_5":14750,"_28174":125066,"_3058":125150},[],"Cuando ningún consumidor legítimo dependa de la autoridad anterior, retírala de la emisión, de las CAs de validación de re-enrolamiento y de las CAs distribuidas. Revócala si la política lo exige.",{"_3602":74137,"_30987":74098,"_21467":125152,"_5":14750,"_28174":125070,"_3058":125153},[],"Lamassu guarda la revocación de la CA y después intenta revocar sus CAs hijas y certificados emitidos con `CessationOfOperation`. La propagación continúa recursivamente por las hijas. No es una transacción sobre toda la jerarquía: puede haber recursos ya modificados y otros cuya actualización haya fallado.",{"_3602":74138,"_30987":74098,"_21467":125155,"_5":14750,"_28174":125070,"_3058":125156},[],"Los recursos en estado `EXPIRED` y los ya revocados por una razón definitiva no admiten otra transición de estado. Los errores por descendiente se registran; revisa el inventario y los registros aunque la operación sobre el padre haya terminado.",{"_3602":74139,"_30987":74098,"_21467":125158,"_5":14750,"_28174":125070,"_3058":125159},[],"`CertificateHold` permite reactivar el padre mientras no esté expirado, pero no restaura las hijas ni los certificados revocados definitivamente durante la cascada. Por eso suspender una CA tampoco sirve como pausa reversible de toda la rama.",{"_3602":74140,"_30987":74098,"_21467":125161,"_5":14750,"_28174":125070,"_3058":125162},[],"Antes de cerrar el cambio, contrasta el listado de dependencias inicial con los estados finales y verifica la publicación de revocación en cada emisor. No utilices la revocación como mecanismo ordinario para dejar de emitir: completa la migración y retira la CA de los flujos operativos.",{"_3602":74141,"_30987":74098,"_21467":125164,"_5":14750,"_28174":125074,"_3058":125165},[],"La cadena nueva termina en un ancla instalada por el consumidor.",{"_3602":74142,"_30987":74098,"_21467":125167,"_5":14750,"_28174":125074,"_3058":125168},[],"Los certificados nuevos contienen AKI, SKI, KU, EKU y SAN esperados.",{"_3602":74143,"_30987":74098,"_21467":125170,"_5":14750,"_28174":125074,"_3058":125171},[],"El DMS entrega la cadena correcta mediante EST `/cacerts`.",{"_3602":74144,"_30987":74098,"_21467":125173,"_5":14750,"_28174":125074,"_3058":125174},[],"El re-enrolamiento acepta la identidad antigua durante el periodo previsto.",{"_3602":74145,"_30987":74098,"_21467":125176,"_5":14750,"_28174":125074,"_3058":125177},[],"OCSP y CRL responden para las autoridades que siguen activas.",{"_3602":74146,"_30987":74098,"_21467":125179,"_5":14750,"_28174":125074,"_3058":125180},[],"No quedan DMS emitiendo accidentalmente desde la CA anterior.",{"_3602":74147,"_30987":74098,"_21467":125182,"_5":14750,"_28174":125074,"_3058":125183},[],"Consulta el Modelo de confianza para entender los conjuntos de CAs del DMS y Ciclo de vida de un certificado para los estados y efectos de revocación.",{"_3602":74148,"_30987":74148,"_5":15110,"_3058":125185,"_31325":125186,"_21467":125187,"_28174":74148},"Autoridades de certificación",[50623,121012,56298,125023],[],{"_3602":74149,"_30987":74148,"_21467":125189,"_5":14750,"_28174":74148,"_3058":125190},[],"Crea, importa y opera las autoridades que establecen la confianza de tu PKI.",{"_3602":74150,"_30987":74148,"_5":31322,"_21467":125192,"_28174":125193,"_3058":125194},[],"/docs/es/platform/pki/certificate-authorities#elige-un-flujo","Elige un flujo",{"_3602":74151,"_30987":74148,"_5":31322,"_21467":125196,"_28174":125197,"_3058":125198},[],"/docs/es/platform/pki/certificate-authorities#crea-una-autoridad-nueva","Crea una autoridad nueva",{"_3602":74152,"_30987":74148,"_5":31322,"_21467":125200,"_28174":125201,"_3058":119546},[],"/docs/es/platform/pki/certificate-authorities#antes-de-empezar",{"_3602":74153,"_30987":74148,"_5":31322,"_21467":125203,"_28174":125204,"_3058":125205},[],"/docs/es/platform/pki/certificate-authorities#abre-el-asistente","Abre el asistente",{"_3602":74154,"_30987":74148,"_5":31322,"_21467":125207,"_28174":125208,"_3058":125209},[],"/docs/es/platform/pki/certificate-authorities#configura-la-clave","Configura la clave",{"_3602":74155,"_30987":74148,"_5":31322,"_21467":125211,"_28174":125212,"_3058":125213},[],"/docs/es/platform/pki/certificate-authorities#elige-el-tipo-de-ca","Elige el tipo de CA",{"_3602":74156,"_30987":74148,"_5":31322,"_21467":125215,"_28174":125216,"_3058":125217},[],"/docs/es/platform/pki/certificate-authorities#define-la-identidad","Define la identidad",{"_3602":74157,"_30987":74148,"_5":31322,"_21467":125219,"_28174":125220,"_3058":125221},[],"/docs/es/platform/pki/certificate-authorities#configura-validez-y-usos","Configura validez y usos",{"_3602":74158,"_30987":74148,"_5":31322,"_21467":125223,"_28174":125224,"_3058":125225},[],"/docs/es/platform/pki/certificate-authorities#crea-y-verifica","Crea y verifica",{"_3602":74159,"_30987":74148,"_5":31322,"_21467":125227,"_28174":125228,"_3058":125229},[],"/docs/es/platform/pki/certificate-authorities#utiliza-una-clave-del-kms","Utiliza una clave del KMS",{"_3602":74160,"_30987":74148,"_5":31322,"_21467":125231,"_28174":125232,"_3058":125233},[],"/docs/es/platform/pki/certificate-authorities#importa-una-ca-externa","Importa una CA externa",{"_3602":74161,"_30987":74148,"_5":31322,"_21467":125235,"_28174":125236,"_3058":125237},[],"/docs/es/platform/pki/certificate-authorities#selecciona-el-motor","Selecciona el motor",{"_3602":74162,"_30987":74148,"_5":31322,"_21467":125239,"_28174":125240,"_3058":125241},[],"/docs/es/platform/pki/certificate-authorities#carga-el-material","Carga el material",{"_3602":74163,"_30987":74148,"_5":31322,"_21467":125243,"_28174":125244,"_3058":125245},[],"/docs/es/platform/pki/certificate-authorities#define-la-emisión-predeterminada","Define la emisión predeterminada",{"_3602":74164,"_30987":74148,"_5":31322,"_21467":125247,"_28174":125248,"_3058":125249},[],"/docs/es/platform/pki/certificate-authorities#verifica-la-importación","Verifica la importación",{"_3602":74165,"_30987":74148,"_5":31322,"_21467":125251,"_28174":125252,"_3058":125253},[],"/docs/es/platform/pki/certificate-authorities#inspecciona-una-autoridad","Inspecciona una autoridad",{"_3602":74166,"_30987":74148,"_5":31322,"_21467":125255,"_28174":125256,"_3058":125257},[],"/docs/es/platform/pki/certificate-authorities#emite-certificados","Emite certificados",{"_3602":74167,"_30987":74148,"_5":31322,"_21467":125259,"_28174":125260,"_3058":125261},[],"/docs/es/platform/pki/certificate-authorities#revoca-una-ca","Revoca una CA",{"_3602":74168,"_30987":74148,"_5":31322,"_21467":125263,"_28174":125264,"_3058":125265},[],"/docs/es/platform/pki/certificate-authorities#evalúa-el-impacto","Evalúa el impacto",{"_3602":74169,"_30987":74148,"_5":31322,"_21467":125267,"_28174":125268,"_3058":125269},[],"/docs/es/platform/pki/certificate-authorities#inicia-la-revocación","Inicia la revocación",{"_3602":74170,"_30987":74148,"_5":31322,"_21467":125271,"_28174":125272,"_3058":125273},[],"/docs/es/platform/pki/certificate-authorities#confirma-la-identidad","Confirma la identidad",{"_3602":74171,"_30987":74148,"_5":31322,"_21467":125275,"_28174":125276,"_3058":125277},[],"/docs/es/platform/pki/certificate-authorities#comprueba-la-publicación","Comprueba la publicación",{"_3602":74172,"_30987":74148,"_5":31322,"_21467":125279,"_28174":125280,"_3058":125281},[],"/docs/es/platform/pki/certificate-authorities#elimina-una-ca","Elimina una CA",{"_3602":74173,"_30987":74148,"_21467":125283,"_5":14750,"_28174":74148,"_3058":125284},[],"Una autoridad de certificación (CA) vincula identidades con claves públicas mediante certificados firmados. En Lamassu puedes crear una jerarquía nueva, utilizar una clave que ya está en el KMS o incorporar una CA externa.",{"_3602":74174,"_30987":74148,"_21467":125286,"_5":14750,"_28174":74148,"_3058":125287},[],"Para diseñar una cadena completa o sustituir una autoridad en producción, consulta Jerarquía y rotación de CAs. Si necesitas estandarizar qué puede firmar cada autoridad, utiliza Perfiles de certificado.",{"_3602":74175,"_30987":74148,"_21467":125289,"_5":14750,"_28174":74148,"_3058":125290},[],"Para administrar CAs necesitas permisos sobre las autoridades y las claves, un motor accesible y un perfil revisado. La CA de un consumidor externo no queda confiada por aparecer en este inventario: acuerda por separado la distribución de su raíz y cadena.",{"_3602":74176,"_30987":74148,"_21467":125292,"_5":14750,"_28174":125193,"_3058":125293},[],"**Nueva CA y nueva clave:** crea una raíz de confianza desde cero. Lamassu genera y custodia el par de claves.",{"_3602":74177,"_30987":74148,"_21467":125295,"_5":14750,"_28174":125193,"_3058":125296},[],"**Nueva CA desde KMS:** reutiliza una clave que ya está registrada en la plataforma.",{"_3602":74178,"_30987":74148,"_21467":125298,"_5":14750,"_28174":125193,"_3058":125299},[],"**Importar CA con clave privada:** incorpora una autoridad externa con la que Lamassu podrá emitir.",{"_3602":74179,"_30987":74148,"_21467":125301,"_5":14750,"_28174":125193,"_3058":125302},[],"**Importar solo el certificado:** registra material público. Si Lamassu encuentra su clave en el KMS, puede asociarla; si no la encuentra, la CA queda sin clave utilizable para emitir.",{"_3602":74180,"_30987":74148,"_21467":125304,"_5":14750,"_28174":125193,"_3058":125305},[],"¿Es tu primera vez? Sigue Crea tu primera CA para completar el recorrido mínimo.",{"_3602":74181,"_30987":74148,"_21467":125307,"_5":14750,"_28174":125201,"_3058":125308},[],"Decide si la CA será raíz o intermedia.",{"_3602":74182,"_30987":74148,"_21467":125310,"_5":14750,"_28174":125201,"_3058":125311},[],"Elige el motor que custodiará la clave.",{"_3602":74183,"_30987":74148,"_21467":125313,"_5":14750,"_28174":125201,"_3058":125314},[],"Define una validez superior a la de los certificados que emitirá.",{"_3602":74184,"_30987":74148,"_21467":125316,"_5":14750,"_28174":125201,"_3058":125317},[],"Para una CA intermedia, asegúrate de que la CA padre esté activa.",{"_3602":74185,"_30987":74148,"_21467":125319,"_5":14750,"_28174":125204,"_3058":125320},[],"En **Certification Authorities**, selecciona **Create New CA** y elige generar un par de claves nuevo.",{"_3602":74186,"_30987":74148,"_21467":125322,"_5":14750,"_28174":125208,"_3058":125323},[],"Selecciona el motor criptográfico, el algoritmo y el tamaño o curva. Lamassu admite claves RSA y EC según las capacidades del motor.",{"_3602":74187,"_30987":74148,"_21467":125325,"_5":14750,"_28174":125208,"_3058":125326},[],"Utiliza únicamente tamaños y curvas admitidos por el motor y por la política criptográfica del perfil. Consulta Claves y motores antes de reutilizar material externo.",{"_3602":74188,"_30987":74148,"_21467":125328,"_5":14750,"_28174":125212,"_3058":125329},[],"Selecciona **Root CA** para una autoridad autofirmada o **Intermediate CA** para una autoridad firmada por otra CA. En el segundo caso, elige la CA emisora.",{"_3602":74189,"_30987":74148,"_21467":125331,"_5":14750,"_28174":125216,"_3058":125332},[],"Introduce un **CA Name** único. Este nombre se convierte en el `Common Name` del certificado. Completa los campos del Distinguished Name que necesite tu política:",{"_3602":74190,"_30987":74148,"_21467":125334,"_5":14750,"_28174":125216,"_3058":125335},[],"`C`: código de país ISO 3166-1 de dos letras.",{"_3602":74191,"_30987":74148,"_21467":125337,"_5":14750,"_28174":125216,"_3058":125338},[],"`ST`: estado o provincia.",{"_3602":74192,"_30987":74148,"_21467":125340,"_5":14750,"_28174":125216,"_3058":125341},[],"`L`: localidad.",{"_3602":74193,"_30987":74148,"_21467":125343,"_5":14750,"_28174":125216,"_3058":125344},[],"`O`: organización.",{"_3602":74194,"_30987":74148,"_21467":125346,"_5":14750,"_28174":125216,"_3058":125347},[],"`OU`: unidad organizativa.",{"_3602":74195,"_30987":74148,"_21467":125349,"_5":14750,"_28174":125216,"_3058":125350},[],"El identificador interno de la CA se genera automáticamente y no se puede modificar.",{"_3602":74196,"_30987":74148,"_21467":125352,"_5":14750,"_28174":125220,"_3058":125353},[],"Define **CA Certificate Expiration** y **Default End-Entity Certificate Issuance Expiration**. Puedes expresar una duración (`5y 8w 4d`), seleccionar una fecha o utilizar la fecha máxima permitida.",{"_3602":74197,"_30987":74148,"_21467":125355,"_5":14750,"_28174":125220,"_3058":125356},[],"Revisa por separado el certificado de la propia CA y el perfil predeterminado para lo que emitirá después. Elige una política explícita de emisión; no confíes en que los valores iniciales del formulario sean adecuados para tus consumidores.",{"_3602":74198,"_30987":74148,"_21467":125358,"_5":14750,"_28174":125224,"_3058":125359},[],"Confirma el formulario y abre la CA. Comprueba estado, emisor, fechas, motor y clave asociados. Descarga el certificado: debe tener `CA:TRUE` y un uso que permita firmar certificados. Verifica la autofirma para una raíz o la cadena hasta tu raíz para una intermedia. Completa una emisión de prueba para comprobar que la clave realmente puede firmar.",{"_3602":74199,"_30987":74148,"_21467":125361,"_5":14750,"_28174":125224,"_3058":125362},[],"Planifica y verifica los vencimientos con las reglas de Perfiles. La emisión no recorta automáticamente la validez al vencimiento del emisor; deja margen para sustituir la autoridad y renovar las identidades.",{"_3602":74200,"_30987":74148,"_21467":125364,"_5":14750,"_28174":125228,"_3058":125365},[],"Selecciona &#x2A;*Create New CA (Existing Key)** cuando la clave ya esté registrada en Lamassu. El asistente pide primero la clave de soporte y después muestra la misma configuración de tipo, identidad, validez y perfil.",{"_3602":74201,"_30987":74148,"_21467":125367,"_5":14750,"_28174":125228,"_3058":125368},[],"Este flujo resulta útil cuando la clave se creó previamente en un HSM, se importó mediante BYOK o debe reutilizarse con una política de custodia concreta.",{"_3602":74202,"_30987":74148,"_21467":125370,"_5":14750,"_28174":125232,"_3058":125371},[],"Necesitas el certificado de CA en PEM, su cadena hasta una raíz conocida y, si vas a importarla, una clave privada exportable. Antes de cargar el material, verifica firma, fechas, `CA:TRUE`, usos de firma (incluido `cRLSign`, sin el cual la CA no puede publicar su CRL) y correspondencia de la clave pública. El procedimiento de verificación de claves también sirve para comparar la clave y el certificado de una CA.",{"_3602":74203,"_30987":74148,"_21467":125373,"_5":14750,"_28174":125232,"_3058":125374},[],"El backend rechaza una importación cuyo certificado carece de la restricción básica de CA (`basicConstraints cA flag is not set`), cuyo número de serie coincide con el de un certificado almacenado con contenido distinto, o cuyo certificado idéntico ya pertenece a una CA existente. El registro de certificado de una CA eliminada se conserva y puede reutilizarse al reimportar el mismo certificado, incluido su estado anterior. Reimportar otro certificado con ese número de serie se rechaza; comprueba el certificado y su estado tras reimportarlo.",{"_3602":74204,"_30987":74148,"_21467":125376,"_5":14750,"_28174":125232,"_3058":125377},[],"Eliminar una CA libera las referencias a la clave de su propio certificado actual y de sus certificados reemitidos vinculados, pero conserva esos registros para la CRL y el OCSP de su emisor. Después intenta eliminar la clave; el KMS la conserva si otros certificados todavía la referencian, como los de otra CA que comparte la clave. Revocar los certificados emitidos por la CA eliminada no libera sus propias referencias a claves.",{"_3602":74205,"_30987":74148,"_21467":125379,"_5":14750,"_28174":125236,"_3058":125380},[],"Comprueba el motor predeterminado de la instalación antes de importar una CA con clave. La operación de importación de CA delega la importación de la clave en ese motor; no garantiza selección de cualquier proveedor desde el formulario. Para seleccionar un motor al importar la clave por separado, utiliza el KMS.",{"_3602":74206,"_30987":74148,"_21467":125382,"_5":14750,"_28174":125240,"_3058":125383},[],"Importa el certificado y, cuando corresponda, su clave PEM. Registra las CAs de la cadena necesarias para identificar al emisor. Tener una CA en el inventario no la instala en los almacenes de confianza externos.",{"_3602":74207,"_30987":74148,"_21467":125385,"_5":14750,"_28174":125240,"_3058":125386},[],"El backend valida antes de importar ninguna clave: se rechazan un ID de CA duplicado y un certificado que no es de CA (falta `basicConstraints` `cA=TRUE`), este último con `400` `certificate is not a CA: basicConstraints cA flag is not set`. Si ocurre un fallo después de haber importado la clave, la clave se conserva en el KMS y un aviso te pide eliminarla manualmente.",{"_3602":74208,"_30987":74148,"_21467":125388,"_5":14750,"_28174":125244,"_3058":125389},[],"Asocia un perfil de emisión explícito si la CA va a firmar. Comprueba sus usos y fechas según Perfiles.",{"_3602":74209,"_30987":74148,"_21467":125391,"_5":14750,"_28174":125248,"_3058":125392},[],"Revisa el tipo registrado, la clave y el motor asociados y la relación con el emisor. Una importación sin clave puede asociarse a una clave ya existente en KMS mediante el identificador de clave del certificado. Si no existe una clave utilizable, la CA sirve como material público pero no puede firmar.",{"_3602":74210,"_30987":74148,"_21467":125394,"_5":14750,"_28174":125248,"_3058":125395},[],"Para una CA emisora, completa una emisión de prueba y comprueba OCSP y CRL. El alta del registro por sí sola no demuestra disponibilidad de la clave, coherencia completa de la cadena ni publicación del estado.",{"_3602":74211,"_30987":74148,"_21467":125397,"_5":14750,"_28174":125252,"_3058":125398},[],"Abre una CA desde el inventario para consultar:",{"_3602":74212,"_30987":74148,"_21467":125400,"_5":14750,"_28174":125252,"_3058":125401},[],"Estado y periodo de validez.",{"_3602":74213,"_30987":74148,"_21467":125403,"_5":14750,"_28174":125252,"_3058":125404},[],"Certificado y cadena en formato PEM.",{"_3602":74214,"_30987":74148,"_21467":125406,"_5":14750,"_28174":125252,"_3058":125407},[],"Número de certificados activos, expirados y revocados.",{"_3602":74215,"_30987":74148,"_21467":125409,"_5":14750,"_28174":125252,"_3058":125410},[],"Certificados emitidos en **Issued Certificates**.",{"_3602":74216,"_30987":74148,"_21467":125412,"_5":14750,"_28174":125252,"_3058":125413},[],"CRL vinculada a la autoridad.",{"_3602":74217,"_30987":74148,"_21467":125415,"_5":14750,"_28174":125252,"_3058":125416},[],"Metadatos y motor criptográfico asociado.",{"_3602":74218,"_30987":74148,"_21467":125418,"_5":14750,"_28174":125252,"_3058":125419},[],"Puedes filtrar el inventario por nombre, estado y tipo de CA.",{"_3602":74219,"_30987":74148,"_21467":125421,"_5":14750,"_28174":125256,"_3058":125422},[],"Puedes iniciar una emisión desde **Issued Certificates**, desde la acción de una CA o desde el inventario global de certificados.",{"_3602":74220,"_30987":74148,"_21467":125424,"_5":14750,"_28174":125256,"_3058":125425},[],"**Generate Key & CSR in Browser** resulta útil para una operación manual o una prueba rápida. El navegador genera la clave y debes descargarla al finalizar.",{"_3602":74221,"_30987":74148,"_21467":125427,"_5":14750,"_28174":125256,"_3058":125428},[],"**Upload Existing CSR** es la opción adecuada cuando la clave debe permanecer en el sistema de destino. Lamassu recibe la solicitud, pero nunca la clave privada.",{"_3602":74222,"_30987":74148,"_21467":125430,"_5":14750,"_28174":125256,"_3058":125431},[],"Sigue Emite tu primer certificado para el flujo guiado. La gestión de certificados explica el inventario, la inspección y la revocación.",{"_3602":74223,"_30987":74148,"_21467":125433,"_5":14750,"_28174":125256,"_3058":125434},[],"La clave de una CA solo firma certificados. La API de CA no tiene ningún endpoint para firmar o verificar datos arbitrarios. Para firmar y verificar un mensaje con una clave, utiliza las operaciones del KMS descritas en Gestión de claves, sujetas a sus propios permisos.",{"_3602":74224,"_30987":74148,"_21467":125436,"_5":14750,"_28174":125256,"_3058":125437},[],"Una CA solo firma mientras su estado es `ACTIVE` y la hora actual está dentro del periodo de validez de su certificado. Lamassu comprueba ambas condiciones porque el estado almacenado puede ir por detrás de las fechas hasta que se ejecuta el monitor de expiración. En caso contrario, la petición falla con `400` y el mensaje `CA Status inconsistent`, antes de llamar al KMS. La misma comprobación se aplica cuando la CA firma el certificado de una CA subordinada, también al crearla o reemitirla.",{"_3602":74225,"_30987":74148,"_21467":125439,"_5":14750,"_28174":125260,"_3058":125440},[],"Revocar una CA impide que emita y puede interrumpir toda su rama. Solo `CertificateHold` permite reactivar la propia CA si no está expirada. Sus descendientes se intentan revocar con `CessationOfOperation`; reactivar el padre no restaura esos descendientes. Sigue las condiciones de revocación en cascada.",{"_3602":74226,"_30987":74148,"_21467":125442,"_5":14750,"_28174":125264,"_3058":125443},[],"Identifica los certificados, dispositivos y consumidores que dependen de la CA. Prepara una autoridad y una cadena de sustitución cuando sea necesario.",{"_3602":74227,"_30987":74148,"_21467":125445,"_5":14750,"_28174":125268,"_3058":125446},[],"Abre la autoridad y selecciona **Revoke CA**. Elige la razón que describa el incidente, por ejemplo `KeyCompromise`, `CACompromise`, `Superseded` o `CessationOfOperation`.",{"_3602":74228,"_30987":74148,"_21467":125448,"_5":14750,"_28174":125272,"_3058":125449},[],"Escribe exactamente el nombre de la CA para habilitar **Confirm Revocation**.",{"_3602":74229,"_30987":74148,"_21467":125451,"_5":14750,"_28174":125276,"_3058":125452},[],"Comprueba **REVOKED** en la CA y revisa los descendientes uno a uno; la propagación admite fallos parciales. Verifica por separado la publicación de OCSP y CRL y el rechazo por los consumidores. Un registro revocado no garantiza que una sesión existente se cierre.",{"_3602":74230,"_30987":74148,"_21467":125454,"_5":14750,"_28174":125280,"_3058":125455},[],"La eliminación permanente solo está disponible con la CA revocada o caducada; una CA importada sin clave puede eliminarse en cualquier estado. Elimina el registro únicamente cuando la política de retención y auditoría lo permita.",{"_3602":74231,"_30987":74148,"_21467":125457,"_5":14750,"_28174":125280,"_3058":125458},[],"Los ajustes de CRL de la CA se conservan. La eliminación se rechaza con un error `409` mientras sigan `ACTIVE`: la VA debe publicar primero la CRL final de la CA, lo que puede tardar hasta aproximadamente una hora después de la revocación con la programación predeterminada del trabajo, así que reintenta cuando se haya publicado la CRL final. Una CA caducada se finaliza sin CRL final, y una CA en retención (`CertificateHold`) se rechaza con un mensaje que te pide revocarla de forma permanente primero. La eliminación también se rechaza con un `409` cuando la clave de la CA firma las CRLs de otra CA: el error nombra a esa CA, así que cambia su firmante de CRL, o elimínala o revócala, antes de eliminar esta. La CA y todos sus descendientes se comprueban antes de eliminar nada; si alguno no puede eliminarse, no cambia nada.",{"_3602":74232,"_30987":74148,"_21467":125460,"_5":14750,"_28174":125280,"_3058":125461},[],"Tras la eliminación, los ajustes quedan archivados y la última CRL sigue sirviéndose pero nunca se regenera; puedes eliminarlos cuando ningún certificado emitido por la CA necesite ya evidencia de revocación, con `DELETE /v1/crl-settings/{ca-id}` o desde la página **Verification Authorities** de la consola. Borrarlos deja de servir la CRL y no puede deshacerse. Ajusta la validez y el firmante antes de revocar o eliminar la CA (consulta CRL). La clave de la CA se libera, pero el KMS la conserva mientras otros certificados la referencien.",{"_3602":74233,"_30987":74148,"_21467":125463,"_5":14750,"_28174":125280,"_3058":125464},[],"Lamassu conserva el registro del certificado de una CA eliminada. Si se importa de nuevo ese mismo certificado, la importación termina bien y reutiliza el registro: actualiza el tipo, el emisor y la clave, pero conserva el estado, así que la CA reaparece con el que tenía al eliminarse (normalmente revocada o caducada). Un certificado distinto con el mismo número de serie se rechaza con error 400, y un certificado que ya pertenece a una CA existente, con error 409. Para no heredar el estado anterior, usa un certificado con otro número de serie y comprueba el resultado tras importar. La CA reimportada se registra con un ID de CA nuevo generado por el backend y no hereda los ajustes de CRL de la CA eliminada: hasta que se eliminen esos ajustes, estos siguen sirviendo su última CRL en la URL del ID de CA y, si los migró la actualización, en `/crl/<ski>` — la que llevan los certificados emitidos antes de la actualización a 4.0.0 —; cuando están archivados, dejan de poder editarse (consulta CRL).",{"_3602":74234,"_30987":74234,"_5":15110,"_3058":125466,"_31325":125467,"_21467":125468,"_28174":74234},"Perfiles de certificado",[50623,121012,56298,125023],[],{"_3602":74235,"_30987":74234,"_21467":125470,"_5":14750,"_28174":74234,"_3058":125471},[],"Define políticas reutilizables para emitir certificados coherentes y limitar las claves aceptadas.",{"_3602":74236,"_30987":74234,"_5":31322,"_21467":125473,"_28174":125474,"_3058":125475},[],"/docs/es/platform/pki/certificate-profiles#qué-controla-un-perfil","Qué controla un perfil",{"_3602":74237,"_30987":74234,"_5":31322,"_21467":125477,"_28174":125478,"_3058":125479},[],"/docs/es/platform/pki/certificate-profiles#validez","Validez",{"_3602":74238,"_30987":74234,"_5":31322,"_21467":125481,"_28174":125482,"_3058":125483},[],"/docs/es/platform/pki/certificate-profiles#certificado-de-ca-o-certificado-final","Certificado de CA o certificado final",{"_3602":74239,"_30987":74234,"_5":31322,"_21467":125485,"_28174":125486,"_3058":125487},[],"/docs/es/platform/pki/certificate-profiles#key-usage-y-extended-key-usage","Key Usage y Extended Key Usage",{"_3602":74240,"_30987":74234,"_5":31322,"_21467":125489,"_28174":125490,"_3058":125491},[],"/docs/es/platform/pki/certificate-profiles#sujeto","Sujeto",{"_3602":74241,"_30987":74234,"_5":31322,"_21467":125493,"_28174":125494,"_3058":125495},[],"/docs/es/platform/pki/certificate-profiles#extensiones-de-la-csr","Extensiones de la CSR",{"_3602":74242,"_30987":74234,"_5":31322,"_21467":125497,"_28174":125498,"_3058":125499},[],"/docs/es/platform/pki/certificate-profiles#restricciones-criptográficas","Restricciones criptográficas",{"_3602":74243,"_30987":74234,"_5":31322,"_21467":125501,"_28174":125502,"_3058":125503},[],"/docs/es/platform/pki/certificate-profiles#precedencia-del-perfil","Precedencia del perfil",{"_3602":74244,"_30987":74234,"_5":31322,"_21467":125505,"_28174":125506,"_3058":125507},[],"/docs/es/platform/pki/certificate-profiles#crea-un-perfil","Crea un perfil",{"_3602":74245,"_30987":74234,"_5":31322,"_21467":125509,"_28174":125510,"_3058":125511},[],"/docs/es/platform/pki/certificate-profiles#define-un-único-propósito","Define un único propósito",{"_3602":74246,"_30987":74234,"_5":31322,"_21467":125513,"_28174":125514,"_3058":125515},[],"/docs/es/platform/pki/certificate-profiles#elige-la-validez","Elige la validez",{"_3602":74247,"_30987":74234,"_5":31322,"_21467":125517,"_28174":125518,"_3058":125519},[],"/docs/es/platform/pki/certificate-profiles#fija-usos-y-sujeto","Fija usos y sujeto",{"_3602":74248,"_30987":74234,"_5":31322,"_21467":125521,"_28174":125522,"_3058":125523},[],"/docs/es/platform/pki/certificate-profiles#restringe-las-claves","Restringe las claves",{"_3602":74249,"_30987":74234,"_5":31322,"_21467":125525,"_28174":125526,"_3058":125527},[],"/docs/es/platform/pki/certificate-profiles#asócialo-y-prueba","Asócialo y prueba",{"_3602":74250,"_30987":74234,"_5":31322,"_21467":125529,"_28174":125530,"_3058":125531},[],"/docs/es/platform/pki/certificate-profiles#ejemplos-de-diseño","Ejemplos de diseño",{"_3602":74251,"_30987":74234,"_5":31322,"_21467":125533,"_28174":125534,"_3058":125535},[],"/docs/es/platform/pki/certificate-profiles#cambios-y-eliminación","Cambios y eliminación",{"_3602":74252,"_30987":74234,"_21467":125537,"_5":14750,"_28174":74234,"_3058":125538},[],"Un perfil de emisión convierte una política de certificados en configuración reutilizable. En lugar de decidir validez, sujeto, extensiones y algoritmos en cada solicitud, defines una vez qué está permitido y asocias el perfil a una CA, un DMS o una emisión concreta.",{"_3602":74253,"_30987":74234,"_21467":125540,"_5":14750,"_28174":74234,"_3058":125541},[],"Esta guía se dirige al administrador PKI que define la política de emisión. Necesitas permisos para gestionar perfiles y asociarlos a la CA o DMS previstos, además de un consumidor de prueba con requisitos de identidad y uso conocidos.",{"_3602":74254,"_30987":74234,"_21467":125543,"_5":14750,"_28174":125478,"_3058":125544},[],"Puedes expresar la vigencia como una duración desde el momento de emisión o como una fecha final fija. Una duración funciona bien para identidades recurrentes; una fecha común sirve para hacer que todo un lote termine antes de una migración o retirada.",{"_3602":74255,"_30987":74234,"_21467":125546,"_5":14750,"_28174":125478,"_3058":125547},[],"Planifica la fecha final dentro de la vigencia de la CA emisora y deja margen para renovar. El firmador calcula la fecha desde el perfil; no recorta automáticamente la validez al vencimiento del emisor. Comprueba ambas fechas en el certificado resultante. Una fecha fija ya pasada tampoco representa una identidad utilizable.",{"_3602":74256,"_30987":74234,"_21467":125549,"_5":14750,"_28174":125482,"_3058":125550},[],"`Sign as CA` establece `IsCA` y las restricciones básicas necesarias para una autoridad. Lamassu lo aplica: un perfil con `Sign as CA` solo se consume al crear o reemitir una CA. Toda solicitud de firma que resuelva a un perfil así se rechaza — la firma directa con una CA, incluidas las solicitudes de emisión de certificados sobre ella, y el enrolamiento o reenrolamiento del DMS. Nada valida el perfil al guardarlo: si el perfil predeterminado de una CA o el perfil de un DMS lo tiene activado, el problema aparece en la primera solicitud de firma que lo resuelva — en el caso de un DMS, cuando un dispositivo intenta enrolarse o reenrolarse — y la renovación sigue bloqueada hasta que se cambia el perfil.",{"_3602":74257,"_30987":74234,"_21467":125552,"_5":14750,"_28174":125486,"_3058":125553},[],"El perfil puede imponer usos como `DigitalSignature`, `KeyEncipherment`, `CertSign`, `CRLSign`, `ClientAuth`, `ServerAuth` u `OCSPSigning`.",{"_3602":74258,"_30987":74234,"_21467":125555,"_5":14750,"_28174":125486,"_3058":125556},[],"Si activas **Honor Key Usage** o **Honor Extended Key Usages**, Lamassu conserva los valores solicitados por la CSR. Si los desactivas, los sustituye por los definidos en el perfil.",{"_3602":74259,"_30987":74234,"_21467":125558,"_5":14750,"_28174":125486,"_3058":125559},[],"No habilites las opciones `Honor…` para solicitudes no confiables salvo que otro componente valide esos campos. De lo contrario, el solicitante puede elegir capacidades más amplias de las previstas.",{"_3602":74260,"_30987":74234,"_21467":125561,"_5":14750,"_28174":125490,"_3058":125562},[],"Con **Honor Subject**, el certificado conserva el sujeto de la CSR. Sin esa opción, Lamassu aplica `CN`, `O`, `OU`, `C`, `ST` y `L` del perfil. Si el perfil no define `Common Name`, se conserva el CN solicitado.",{"_3602":74261,"_30987":74234,"_21467":125564,"_5":14750,"_28174":125494,"_3058":125565},[],"Con **Honor Extensions**, Lamassu filtra las extensiones adicionales solicitadas y conserva únicamente SAN. Sin esa opción, descarta las extensiones adicionales de la CSR.",{"_3602":74262,"_30987":74234,"_21467":125567,"_5":14750,"_28174":125494,"_3058":125568},[],"Esto conserva SAN, pero no comprueba que el solicitante tenga derecho a utilizar esos DNS, IP, correos o URI. Valida esa autorización antes de emitir. Los puntos OCSP y CRL proceden de la configuración del servicio de emisión; `Honor Extensions` no copia los puntos de distribución de la CSR.",{"_3602":74263,"_30987":74234,"_21467":125570,"_5":14750,"_28174":125498,"_3058":125571},[],"La aplicación criptográfica puede:",{"_3602":74264,"_30987":74234,"_21467":125573,"_5":14750,"_28174":125498,"_3058":125574},[],"permitir o bloquear claves RSA;",{"_3602":74265,"_30987":74234,"_21467":125576,"_5":14750,"_28174":125498,"_3058":125577},[],"limitar los tamaños RSA admitidos;",{"_3602":74266,"_30987":74234,"_21467":125579,"_5":14750,"_28174":125498,"_3058":125580},[],"permitir o bloquear claves ECDSA;",{"_3602":74267,"_30987":74234,"_21467":125582,"_5":14750,"_28174":125498,"_3058":125583},[],"limitar los tamaños o curvas ECDSA admitidos.",{"_3602":74268,"_30987":74234,"_21467":125585,"_5":14750,"_28174":125498,"_3058":125586},[],"Cuando está habilitada, Lamassu comprueba la clave pública antes de crear una CA o firmar una CSR. Una clave cuyo tipo o tamaño no figure en el perfil se rechaza.",{"_3602":74269,"_30987":74234,"_21467":125588,"_5":14750,"_28174":125502,"_3058":125589},[],"La resolución depende del punto de entrada. Se selecciona un perfil completo; sus campos no se fusionan con los del perfil de la CA.",{"_3602":74270,"_30987":74234,"_21467":125591,"_5":14750,"_28174":125502,"_3058":120772},[],{"_3602":74271,"_30987":74234,"_21467":125593,"_5":14750,"_28174":125502,"_3058":125594},[],"Primera opción",{"_3602":74272,"_30987":74234,"_21467":125596,"_5":14750,"_28174":125502,"_3058":125597},[],"Segunda opción",{"_3602":74273,"_30987":74234,"_21467":125599,"_5":14750,"_28174":125502,"_3058":125600},[],"Si no hay ninguna",{"_3602":74274,"_30987":74234,"_21467":125602,"_5":14750,"_28174":125502,"_3058":125603},[],"Firma directa con una CA",{"_3602":74275,"_30987":74234,"_21467":125605,"_5":14750,"_28174":125502,"_3058":125606},[],"`issuance_profile` incluido en la solicitud",{"_3602":74276,"_30987":74234,"_21467":125608,"_5":14750,"_28174":125502,"_3058":125609},[],"`issuance_profile_id` de la solicitud",{"_3602":74277,"_30987":74234,"_21467":125611,"_5":14750,"_28174":125502,"_3058":125612},[],"Perfil predeterminado de la CA (`profile_id`).",{"_3602":74278,"_30987":74234,"_21467":125614,"_5":14750,"_28174":125502,"_3058":125615},[],"Emisión mediante DMS",{"_3602":74279,"_30987":74234,"_21467":125617,"_5":14750,"_28174":125502,"_3058":56894},[],{"_3602":74280,"_30987":74234,"_21467":125619,"_5":14750,"_28174":125502,"_3058":125620},[],"`settings.issuance_profile` incluido en el DMS",{"_3602":74281,"_30987":74234,"_21467":125622,"_5":14750,"_28174":125502,"_3058":125623},[],"Perfil predeterminado de la CA de enrolamiento.",{"_3602":74282,"_30987":74234,"_21467":125625,"_5":14750,"_28174":125502,"_3058":125626},[],"Si el identificador seleccionado no puede resolverse, la operación falla; no se sustituye silenciosamente por el perfil de la CA. Evita definir las dos opciones a la vez. Registrar qué perfil se seleccionó facilita explicar por qué el resultado difiere de la CSR.",{"_3602":74283,"_30987":74234,"_21467":125628,"_5":14750,"_28174":125502,"_3058":125629},[],"Varias flotas pueden compartir CA y mantener perfiles distintos mediante sus DMS. La autenticación del solicitante y la política de registro del dispositivo se configuran aparte en DMS.",{"_3602":74284,"_30987":74234,"_21467":125631,"_5":14750,"_28174":125510,"_3058":125632},[],"Separa, por ejemplo, dispositivos mTLS, servidores y CAs intermedias. Un perfil pequeño y específico es más fácil de revisar que uno que permita todos los usos.",{"_3602":74285,"_30987":74234,"_21467":125634,"_5":14750,"_28174":125514,"_3058":125635},[],"Alinea la duración con la capacidad real de renovación de la flota. Deja margen respecto a la expiración de la CA.",{"_3602":74286,"_30987":74234,"_21467":125637,"_5":14750,"_28174":125518,"_3058":125638},[],"Para un dispositivo que se autentica como cliente, el punto de partida habitual es `DigitalSignature` y `ClientAuth`. Añade `ServerAuth` o `KeyEncipherment` solo si el protocolo lo necesita.",{"_3602":74287,"_30987":74234,"_21467":125640,"_5":14750,"_28174":125522,"_3058":125641},[],"Habilita la aplicación criptográfica y enumera únicamente algoritmos y tamaños compatibles con tu política y tus dispositivos.",{"_3602":74288,"_30987":74234,"_21467":125643,"_5":14750,"_28174":125526,"_3058":125644},[],"Asocia el perfil a una CA o DMS y verifica la precedencia anterior. Emite una CSR con usos y SAN conocidos; inspecciona el resultado con `openssl x509 -in device.crt -noout -text`. Comprueba sujeto, SAN, KU, EKU y fechas. Para una identidad final, `Sign as CA` debe estar desactivado, no debe aparecer `CA:TRUE` ni `Certificate Sign`; si existe Basic Constraints, debe indicar `CA:FALSE`.",{"_3602":74289,"_30987":74234,"_21467":125646,"_5":14750,"_28174":125526,"_3058":125647},[],"Prueba también una clave excluida por la política: la emisión debe rechazarse. Sigue la verificación del certificado y prueba su aceptación en el consumidor previsto.",{"_3602":74290,"_30987":74234,"_21467":125649,"_5":14750,"_28174":125530,"_3058":125650},[],"**Dispositivo mTLS**\\\nCertificado final, validez corta, `DigitalSignature`, `ClientAuth`, sujeto controlado por el DMS y SAN permitido cuando identifica al dispositivo.",{"_3602":74291,"_30987":74234,"_21467":125652,"_5":14750,"_28174":125530,"_3058":125653},[],"**Servidor TLS**\\\nCertificado final, `DigitalSignature`, `ServerAuth` y SAN obligatorio con los nombres que utilizarán los clientes.",{"_3602":74292,"_30987":74234,"_21467":125655,"_5":14750,"_28174":125530,"_3058":125656},[],"**CA intermedia**\\\n`Sign as CA`, `CertSign` y `CRLSign`, validez superior a sus certificados finales y restricciones criptográficas más exigentes.",{"_3602":74293,"_30987":74234,"_21467":125658,"_5":14750,"_28174":125530,"_3058":125659},[],"Estos patrones expresan decisiones de diseño. Activar `Honor Extensions` no exige que la CSR incluya SAN ni valida sus nombres; debes hacer esa comprobación en el flujo de solicitud. El perfil tampoco instala confianza ni concede permisos en el consumidor.",{"_3602":74294,"_30987":74234,"_21467":125661,"_5":14750,"_28174":125534,"_3058":125662},[],"Actualizar un perfil afecta a emisiones futuras; no modifica certificados ya firmados. Prueba los cambios antes de aplicarlos a una CA en producción y conserva la justificación operativa.",{"_3602":74295,"_30987":74234,"_21467":125664,"_5":14750,"_28174":125534,"_3058":125665},[],"Antes de eliminar un perfil, comprueba que ninguna CA o DMS dependa de él. Si deseas sustituirlo, crea la versión nueva, actualiza las referencias y realiza una emisión de prueba antes de retirar el anterior.",{"_3602":74296,"_30987":74296,"_5":15110,"_3058":125667,"_31325":125668,"_21467":125670,"_28174":74296},"Validación de certificados",[50623,121012,56298,125669],"Validación",[],{"_3602":74297,"_30987":74296,"_21467":125672,"_5":14750,"_28174":74296,"_3058":125673},[],"Comprueba cadena, identidad, usos y revocación desde el consumidor.",{"_3602":74298,"_30987":74296,"_5":31322,"_21467":125675,"_28174":125676,"_3058":125677},[],"/docs/es/platform/pki/certificate-validation#antes-de-consultar-el-estado","Antes de consultar el estado",{"_3602":74299,"_30987":74296,"_5":31322,"_21467":125679,"_28174":125680,"_3058":125681},[],"/docs/es/platform/pki/certificate-validation#elige-un-mecanismo","Elige un mecanismo",{"_3602":74300,"_30987":74296,"_5":31322,"_21467":125683,"_28174":125684,"_3058":125685},[],"/docs/es/platform/pki/certificate-validation#comprueba-el-comportamiento-del-consumidor","Comprueba el comportamiento del consumidor",{"_3602":74301,"_30987":74296,"_21467":125687,"_5":14750,"_28174":74296,"_3058":125688},[],"Esta guía reúne las comprobaciones que necesita quien integra un consumidor de certificados. Necesitas el certificado presentado, las intermedias y las raíces que tu aplicación ha decidido confiar. Lamassu publica estado; el consumidor aplica la política de aceptación.",{"_3602":74302,"_30987":74296,"_21467":125690,"_5":14750,"_28174":125676,"_3058":125691},[],"Verifica estos criterios juntos:",{"_3602":74303,"_30987":74296,"_21467":125693,"_5":14750,"_28174":125676,"_3058":124652},[],{"_3602":74304,"_30987":74296,"_21467":125695,"_5":14750,"_28174":125676,"_3058":125696},[],"Resultado necesario",{"_3602":74305,"_30987":74296,"_21467":125698,"_5":14750,"_28174":125676,"_3058":125699},[],"Cadena y firma",{"_3602":74306,"_30987":74296,"_21467":125701,"_5":14750,"_28174":125676,"_3058":125702},[],"Cadena válida hasta una raíz instalada deliberadamente en el consumidor.",{"_3602":74307,"_30987":74296,"_21467":125704,"_5":14750,"_28174":125676,"_3058":125705},[],"Fechas",{"_3602":74308,"_30987":74296,"_21467":125707,"_5":14750,"_28174":125676,"_3058":125708},[],"Fecha actual entre `Not Before` y `Not After`, también para las CAs de la cadena.",{"_3602":74309,"_30987":74296,"_21467":125710,"_5":14750,"_28174":125676,"_3058":120682},[],{"_3602":74310,"_30987":74296,"_21467":125712,"_5":14750,"_28174":125676,"_3058":125713},[],"Nombre, SAN o identificador corresponden al interlocutor esperado.",{"_3602":74311,"_30987":74296,"_21467":125715,"_5":14750,"_28174":125676,"_3058":125716},[],"Uso",{"_3602":74312,"_30987":74296,"_21467":125718,"_5":14750,"_28174":125676,"_3058":125719},[],"KU, EKU y restricciones permiten la operación concreta.",{"_3602":74313,"_30987":74296,"_21467":125721,"_5":14750,"_28174":125676,"_3058":125722},[],"Revocación",{"_3602":74314,"_30987":74296,"_21467":125724,"_5":14750,"_28174":125676,"_3058":125725},[],"Evidencia firmada, vigente y correspondiente al emisor y certificado consultados.",{"_3602":74315,"_30987":74296,"_21467":125727,"_5":14750,"_28174":125676,"_3058":125728},[],"Autorización",{"_3602":74316,"_30987":74296,"_21467":125730,"_5":14750,"_28174":125676,"_3058":125731},[],"La aplicación permite la acción a esa identidad.",{"_3602":74317,"_30987":74296,"_21467":125733,"_5":14750,"_28174":125676,"_3058":125734},[],"El recorrido de emisión comprueba cadena y uso con OpenSSL. Esa comprobación no consulta automáticamente OCSP ni descarga una CRL. Un certificado presente en el inventario o una respuesta OCSP `Good` no sustituyen los demás criterios.",{"_3602":74318,"_30987":74296,"_21467":125736,"_5":14750,"_28174":125680,"_3058":125737},[],"Mecanismo",{"_3602":74319,"_30987":74296,"_21467":125739,"_5":14750,"_28174":125680,"_3058":125740},[],"Cuándo utilizarlo",{"_3602":74320,"_30987":74296,"_21467":125742,"_5":14750,"_28174":125680,"_3058":125743},[],"Qué debes mantener",{"_3602":74321,"_30987":74296,"_21467":125745,"_5":14750,"_28174":125680,"_3058":57022},[],{"_3602":74322,"_30987":74296,"_21467":125747,"_5":14750,"_28174":125680,"_3058":125748},[],"Consulta del estado de un certificado concreto.",{"_3602":74323,"_30987":74296,"_21467":125750,"_5":14750,"_28174":125680,"_3058":125751},[],"Acceso al respondedor, verificación de la firma y política de caché/vigencia.",{"_3602":74324,"_30987":74296,"_21467":125753,"_5":14750,"_28174":125680,"_3058":57031},[],{"_3602":74325,"_30987":74296,"_21467":125755,"_5":14750,"_28174":125680,"_3058":125756},[],"Consulta local de muchos certificados o funcionamiento offline.",{"_3602":74326,"_30987":74296,"_21467":125758,"_5":14750,"_28174":125680,"_3058":125759},[],"Descarga periódica de una lista firmada por el emisor y rechazo de listas vencidas.",{"_3602":74327,"_30987":74296,"_21467":125761,"_5":14750,"_28174":125680,"_3058":125762},[],"OCSP también puede devolver una respuesta reutilizable hasta `nextUpdate`; una CRL cambia al publicarse una versión nueva. Ninguno garantiza por sí solo que un consumidor conozca una revocación en el momento de guardarla.",{"_3602":74328,"_30987":74296,"_21467":125764,"_5":14750,"_28174":125680,"_3058":125765},[],"Si utilizas ambos, define cuándo se permite el mecanismo alternativo y qué hace el cliente si falla la descarga, la firma, la vigencia o devuelve `Unknown`. Aceptar una identidad cuando no puedes comprobar su estado debe ser una decisión explícita de tu aplicación.",{"_3602":74329,"_30987":74296,"_21467":125767,"_5":14750,"_28174":125684,"_3058":125768},[],"Acepta un certificado vigente, autorizado y con cadena conocida.",{"_3602":74330,"_30987":74296,"_21467":125770,"_5":14750,"_28174":125684,"_3058":125771},[],"Rechaza otro con raíz desconocida o uso incompatible.",{"_3602":74331,"_30987":74296,"_21467":125773,"_5":14750,"_28174":125684,"_3058":125774},[],"Revoca un certificado de prueba y verifica la respuesta OCSP o la nueva CRL.",{"_3602":74332,"_30987":74296,"_21467":125776,"_5":14750,"_28174":125684,"_3058":125777},[],"Comprueba que una conexión nueva con esa identidad se rechaza.",{"_3602":74333,"_30987":74296,"_21467":125779,"_5":14750,"_28174":125684,"_3058":125780},[],"Simula un endpoint inaccesible y evidencia vencida; observa si el resultado coincide con tu política.",{"_3602":74334,"_30987":74296,"_21467":125782,"_5":14750,"_28174":125684,"_3058":125783},[],"Conserva número de serie, emisor, razón de revocación, hora de consulta y tiempos de la evidencia. Una sesión ya abierta puede necesitar cierre o reautenticación explícita en el servicio consumidor; publicar revocación no la cierra automáticamente.",{"_3602":74335,"_30987":74296,"_21467":125785,"_5":14750,"_28174":125684,"_3058":125786},[],"Para una cadena con intermedias, valida también su estado según la política del consumidor. La CRL del emisor de una identidad final no reemplaza las comprobaciones de todas las CAs de la cadena.",{"_3602":74336,"_30987":74296,"_21467":125788,"_5":14750,"_28174":125684,"_3058":125789},[],"<Card title=\"Validación online con OCSP\" description=\"Genera una consulta y verifica firma, estado y tiempos.\" href=\"/docs/platform/pki/ocsp\" />",{"_3602":74337,"_30987":74296,"_21467":125791,"_5":14750,"_28174":125684,"_3058":125792},[],"<Card title=\"Listas de revocación\" description=\"Descarga, inspecciona y utiliza una CRL del emisor.\" href=\"/docs/platform/pki/crl\" />",{"_3602":74338,"_30987":74338,"_5":15110,"_3058":125794,"_31325":125795,"_21467":125796,"_28174":74338},"Certificados",[50623,121012,56298,125023],[],{"_3602":74339,"_30987":74338,"_21467":125798,"_5":14750,"_28174":74338,"_3058":125799},[],"Consulta, descarga y revoca los certificados emitidos por Lamassu.",{"_3602":74340,"_30987":74338,"_5":31322,"_21467":125801,"_28174":125802,"_3058":125803},[],"/docs/es/platform/pki/certificates#busca-un-certificado","Busca un certificado",{"_3602":74341,"_30987":74338,"_5":31322,"_21467":125805,"_28174":125806,"_3058":125807},[],"/docs/es/platform/pki/certificates#descarga-el-certificado","Descarga el certificado",{"_3602":74342,"_30987":74338,"_5":31322,"_21467":125809,"_28174":125810,"_3058":125811},[],"/docs/es/platform/pki/certificates#emite-desde-una-csr-existente","Emite desde una CSR existente",{"_3602":74343,"_30987":74338,"_5":31322,"_21467":125813,"_28174":125814,"_3058":125815},[],"/docs/es/platform/pki/certificates#revoca-un-certificado","Revoca un certificado",{"_3602":74344,"_30987":74338,"_5":31322,"_21467":125817,"_28174":125818,"_3058":125819},[],"/docs/es/platform/pki/certificates#abre-la-acción","Abre la acción",{"_3602":74345,"_30987":74338,"_5":31322,"_21467":125821,"_28174":125822,"_3058":125823},[],"/docs/es/platform/pki/certificates#elige-una-razón","Elige una razón",{"_3602":74346,"_30987":74338,"_5":31322,"_21467":125825,"_28174":125826,"_3058":125827},[],"/docs/es/platform/pki/certificates#confirma-y-verifica","Confirma y verifica",{"_3602":74347,"_30987":74338,"_5":31322,"_21467":125829,"_28174":125830,"_3058":125831},[],"/docs/es/platform/pki/certificates#reactiva-una-suspensión","Reactiva una suspensión",{"_3602":74348,"_30987":74338,"_5":31322,"_21467":125833,"_28174":125834,"_3058":125835},[],"/docs/es/platform/pki/certificates#continúa","Continúa",{"_3602":74349,"_30987":74338,"_21467":125837,"_5":14750,"_28174":74338,"_3058":125838},[],"Esta guía sirve al operador PKI que necesita inspeccionar o retirar una identidad ya emitida. Necesitas acceso al inventario y, para cambiar estados, permisos sobre el certificado. Abre **Certificates** para una vista global o **Issued Certificates** dentro de una CA para limitarla a ese emisor.",{"_3602":74350,"_30987":74338,"_21467":125840,"_5":14750,"_28174":125802,"_3058":125841},[],"Filtra por `Common Name`, serie, estado y autoridad emisora. Un certificado no contiene su clave privada, así que las superficies de clave privada responden qué certificados tienen su clave custodiada en el KMS de Lamassu:",{"_3602":74351,"_30987":74338,"_21467":125843,"_5":14750,"_28174":125802,"_3058":125844},[],"El filtro avanzado **Private Key**, disponible en la página Certificates y en la pestaña **Issued Certificates** de una CA, limita la lista a **All Certificates**, **With Private Key** o **Without Private Key**.",{"_3602":74352,"_30987":74338,"_21467":125846,"_5":14750,"_28174":125802,"_3058":125847},[],"La columna ordenable **Private Key** — visible por defecto y oculta en pantallas estrechas — marca con una marca de verificación verde la clave custodiada en el KMS y muestra `-` en los demás casos.",{"_3602":74353,"_30987":74338,"_21467":125849,"_5":14750,"_28174":125802,"_3058":125850},[],"En los detalles del certificado, la pestaña **Information** muestra una fila **Private Key** en la sección **Key & Signature**. Cuando el certificado indica que tiene clave privada y están disponibles los identificadores de la clave y del motor del KMS, la fila enlaza a la clave (tooltip: **Open private key in KMS**). En caso contrario, muestra **Present** si el certificado indica que tiene clave privada o **Not available** si no lo indica. Esto no determina si existe una clave fuera de Lamassu.",{"_3602":74354,"_30987":74338,"_21467":125852,"_5":14750,"_28174":125802,"_3058":125853},[],"Usa **Quick Inspect** para una revisión rápida o **View Details** para sujeto, SAN, usos, cadena, fechas y metadatos.",{"_3602":74355,"_30987":74338,"_21467":125855,"_5":14750,"_28174":125802,"_3058":125856},[],"Los registros de certificados exponen `key_id` (la clave del KMS que custodia la clave privada, vacía cuando el KMS no la custodia) y `has_private_key` (derivada al leerla desde el KMS). Los listados de certificados y CAs admiten un filtro `has_private_key`, útil, por ejemplo, para comprobar el resultado de la migración de CA a KMS de la actualización a 4.0.0.",{"_3602":74356,"_30987":74338,"_21467":125858,"_5":14750,"_28174":125802,"_3058":125859},[],"Identifica el certificado por emisor y número de serie; un nombre puede corresponder a varias renovaciones. Comprueba cuál utiliza realmente el consumidor y cuál ocupa la identidad activa del dispositivo. El historial de identidades y el inventario de certificados responden preguntas distintas.",{"_3602":74357,"_30987":74338,"_21467":125861,"_5":14750,"_28174":125806,"_3058":125862},[],"Descarga el PEM e inspecciónalo:",{"_3602":74358,"_30987":74338,"_21467":125864,"_5":14750,"_28174":125806,"_3058":125865},[],"Comprueba la política de emisión, cadena y usos con el recorrido de verificación. El certificado no contiene su clave privada. Para una CSR externa, esa clave permanece donde se generó; para el flujo de navegador, conserva el archivo descargado al completar la emisión. Si has perdido la clave, planifica una identidad nueva en lugar de esperar recuperarla desde el certificado.",{"_3602":74359,"_30987":74338,"_21467":125867,"_5":14750,"_28174":125810,"_3058":125868},[],"Utiliza este flujo cuando la clave de la identidad debe permanecer en el sistema que la generó. Necesitas una CA activa con clave utilizable, una CSR PEM y un perfil apropiado.",{"_3602":74360,"_30987":74338,"_21467":125870,"_5":14750,"_28174":125810,"_3058":125871},[],"Verifica la solicitud con `openssl req -in request.csr -noout -verify -text`. Revisa sujeto, SAN y algoritmo, y autoriza la identidad solicitada.",{"_3602":74361,"_30987":74338,"_21467":125873,"_5":14750,"_28174":125810,"_3058":125874},[],"Inicia la emisión desde la CA o el inventario y selecciona **Upload Existing CSR**.",{"_3602":74362,"_30987":74338,"_21467":125876,"_5":14750,"_28174":125810,"_3058":125877},[],"Confirma la CA y el perfil que se resolverá según Perfiles; la solicitud no garantiza que todos sus campos se conserven.",{"_3602":74363,"_30987":74338,"_21467":125879,"_5":14750,"_28174":125810,"_3058":125880},[],"Descarga el certificado e inspecciona fechas, emisor, sujeto, SAN, KU y EKU. Comprueba su correspondencia con la clave privada en el sistema de origen.",{"_3602":74364,"_30987":74338,"_21467":125882,"_5":14750,"_28174":125810,"_3058":125883},[],"Instala certificado y cadena en el consumidor previsto y prueba una conexión. Emitir no registra por sí solo un dispositivo ni concede acceso en una integración.",{"_3602":74365,"_30987":74338,"_21467":125885,"_5":14750,"_28174":125810,"_3058":125886},[],"Para generar la clave en el navegador, sigue Emite tu primer certificado.",{"_3602":74366,"_30987":74338,"_21467":125888,"_5":14750,"_28174":125814,"_3058":125889},[],"Revoca cuando la clave se haya comprometido, el sujeto ya no esté autorizado o la identidad deba dejar de aceptarse antes de expirar. Antes de cambiar el estado, identifica los consumidores y prepara la sustitución necesaria.",{"_3602":74367,"_30987":74338,"_21467":125891,"_5":14750,"_28174":125818,"_3058":125892},[],"Localiza emisor y serie correctos y selecciona **Revoke Certificate**. Los registros `EXPIRED` y los revocados por una razón definitiva no admiten posteriores cambios de estado.",{"_3602":74368,"_30987":74338,"_21467":125894,"_5":14750,"_28174":125822,"_3058":125895},[],"Selecciona la razón del incidente. `CertificateHold` representa una suspensión reversible del certificado; las demás razones bloquean cambios posteriores. No uses una suspensión para tratar una clave comprometida.",{"_3602":74369,"_30987":74338,"_21467":125897,"_5":14750,"_28174":125826,"_3058":125898},[],"Guarda el cambio y vuelve a consultar el registro: exige **REVOKED**, razón y fecha. Verifica después una consulta OCSP nueva y, si utilizas CRL, su versión publicada y presencia de la serie. Finalmente, comprueba el rechazo de una conexión nueva en el consumidor.",{"_3602":74370,"_30987":74338,"_21467":125900,"_5":14750,"_28174":125826,"_3058":125901},[],"La revocación no borra el certificado, no elimina la clave ni garantiza cierre de sesiones existentes. El estado y su publicación son pasos distintos.",{"_3602":74371,"_30987":74338,"_21467":125903,"_5":14750,"_28174":125826,"_3058":125904},[],"Un certificado revocado con `CertificateHold` puede reactivarse si no está en estado `EXPIRED`. Sus fechas y la confianza del consumidor siguen siendo obligatorias.",{"_3602":74372,"_30987":74338,"_21467":125906,"_5":14750,"_28174":125830,"_3058":125907},[],"Comprueba que la razón guardada es `CertificateHold` y que la identidad todavía cumple tu política. Solicita `ACTIVE` mediante la operación de actualización de estado que exponga tu instalación; consulta la Referencia API. No supongas que cambiar permisos del consumidor cambia también el estado en Lamassu.",{"_3602":74373,"_30987":74338,"_21467":125909,"_5":14750,"_28174":125830,"_3058":125910},[],"Vuelve a consultar el registro y OCSP. Con `regenerate_on_revoke` habilitado, el evento de reactivación solicita regeneración de la CRL: verifica que la nueva lista omite la serie. Una lista anterior puede seguir marcándola como revocada hasta que el cliente renueve su copia.",{"_3602":74374,"_30987":74338,"_21467":125912,"_5":14750,"_28174":125830,"_3058":125913},[],"Esto no revierte una revocación definitiva ni la cascada iniciada al revocar una CA.",{"_3602":74375,"_30987":74338,"_21467":125915,"_5":14750,"_28174":125834,"_3058":125916},[],"<Card title=\"Validar con OCSP\" description=\"Consulta y verifica el estado firmado de un certificado.\" href=\"/docs/platform/pki/ocsp\" />",{"_3602":74376,"_30987":74338,"_21467":125918,"_5":14750,"_28174":125834,"_3058":125919},[],"<Card title=\"Distribuir una CRL\" description=\"Publica el estado para validación local.\" href=\"/docs/platform/pki/crl\" />",{"_3602":74377,"_30987":74377,"_5":15110,"_3058":125921,"_31325":125922,"_21467":125924,"_28174":74377},"Ciclo de vida de un certificado",[50623,121012,56298,125923],"Conceptos",[],{"_3602":74378,"_30987":74377,"_21467":125926,"_5":14750,"_28174":74377,"_3058":125927},[],"Emisión, uso, renovación, revocación y retirada de certificados en Lamassu.",{"_3602":74379,"_30987":74377,"_5":31322,"_21467":125929,"_28174":125930,"_3058":125931},[],"/docs/es/platform/pki/concepts/certificate-lifecycle#el-recorrido-completo","El recorrido completo",{"_3602":74380,"_30987":74377,"_5":31322,"_21467":125933,"_28174":125934,"_3058":125935},[],"/docs/es/platform/pki/concepts/certificate-lifecycle#solicitud","Solicitud",{"_3602":74381,"_30987":74377,"_5":31322,"_21467":125937,"_28174":125938,"_3058":125939},[],"/docs/es/platform/pki/concepts/certificate-lifecycle#emisión","Emisión",{"_3602":74382,"_30987":74377,"_5":31322,"_21467":125941,"_28174":125942,"_3058":125943},[],"/docs/es/platform/pki/concepts/certificate-lifecycle#uso-y-supervisión","Uso y supervisión",{"_3602":74383,"_30987":74377,"_5":31322,"_21467":125945,"_28174":125946,"_3058":125947},[],"/docs/es/platform/pki/concepts/certificate-lifecycle#renovación-o-re-enrolamiento","Renovación o re-enrolamiento",{"_3602":74384,"_30987":74377,"_5":31322,"_21467":125949,"_28174":125950,"_3058":125951},[],"/docs/es/platform/pki/concepts/certificate-lifecycle#revocación-o-retirada","Revocación o retirada",{"_3602":74385,"_30987":74377,"_5":31322,"_21467":125953,"_28174":125954,"_3058":123646},[],"/docs/es/platform/pki/concepts/certificate-lifecycle#estados-del-certificado",{"_3602":74386,"_30987":74377,"_5":31322,"_21467":125956,"_28174":125957,"_3058":125958},[],"/docs/es/platform/pki/concepts/certificate-lifecycle#renovación-y-revocación-no-son-equivalentes","Renovación y revocación no son equivalentes",{"_3602":74387,"_30987":74377,"_5":31322,"_21467":125960,"_28174":125961,"_3058":125962},[],"/docs/es/platform/pki/concepts/certificate-lifecycle#efecto-de-revocar-una-ca","Efecto de revocar una CA",{"_3602":74388,"_30987":74377,"_5":31322,"_21467":125964,"_28174":125965,"_3058":125966},[],"/docs/es/platform/pki/concepts/certificate-lifecycle#qué-debes-observar","Qué debes observar",{"_3602":74389,"_30987":74377,"_21467":125968,"_5":14750,"_28174":74377,"_3058":125969},[],"Emitir un certificado es solo el comienzo. Durante su vida útil debes comprobar su vigencia, renovarlo antes de que caduque y retirarlo cuando deje de ser fiable. Lamassu conserva el certificado, su CA emisora, su estado y, cuando pertenece a un dispositivo, la identidad a la que está vinculado.",{"_3602":74390,"_30987":74377,"_21467":125971,"_5":14750,"_28174":125934,"_3058":125972},[],"El solicitante genera una clave y una CSR. En los flujos recomendados, la clave privada permanece en el dispositivo, navegador o motor criptográfico que la creó.",{"_3602":74391,"_30987":74377,"_21467":125974,"_5":14750,"_28174":125938,"_3058":125975},[],"La CA firma la CSR. El perfil de emisión determina la validez, los usos, el sujeto, las extensiones admitidas y las restricciones criptográficas.",{"_3602":74392,"_30987":74377,"_21467":125977,"_5":14750,"_28174":125942,"_3058":125978},[],"El certificado queda en estado `ACTIVE`. Lamassu monitoriza su fecha `Not After`; el trabajo de monitorización criptográfica marca como `EXPIRED` los certificados que han vencido.",{"_3602":74393,"_30987":74377,"_21467":125980,"_5":14750,"_28174":125946,"_3058":125981},[],"Se emite un certificado nuevo antes de que caduque el anterior. En un DMS puedes abrir ventanas preventiva y crítica para que el dispositivo se re-enrole mediante EST.",{"_3602":74394,"_30987":74377,"_21467":125983,"_5":14750,"_28174":125950,"_3058":125984},[],"Si la identidad deja de ser fiable, Lamassu registra la razón y la hora de revocación. OCSP y las CRLs permiten que los consumidores conozcan ese estado.",{"_3602":74395,"_30987":74377,"_21467":125986,"_5":14750,"_28174":125954,"_3058":125987},[],"Lamassu persiste cuatro estados X.509:",{"_3602":74396,"_30987":74377,"_21467":125989,"_5":14750,"_28174":125954,"_3058":125990},[],"**`ACTIVE`**: el registro está habilitado. Comprueba además `Not Before` y `Not After`: este estado no demuestra vigencia temporal.",{"_3602":74397,"_30987":74377,"_21467":125992,"_5":14750,"_28174":125954,"_3058":125993},[],"**`EXPIRED`**: ha superado su fecha de expiración. El monitor lo detecta de forma periódica; no es un estado que deba asignarse manualmente.",{"_3602":74398,"_30987":74377,"_21467":125995,"_5":14750,"_28174":125954,"_3058":125996},[],"**`REVOKED`**: fue invalidado antes de expirar, con una razón y una marca temporal.",{"_3602":74399,"_30987":74377,"_21467":125998,"_5":14750,"_28174":125954,"_3058":125999},[],"**`INACTIVE`**: está deshabilitado sin representar una revocación definitiva.",{"_3602":74400,"_30987":74377,"_21467":126001,"_5":14750,"_28174":125954,"_3058":126002},[],"La vista del dispositivo puede añadir estados operativos como ausencia de identidad, renovación pendiente, expiración próxima o baja. Son una interpretación del estado del dispositivo y de sus certificados, no nuevos estados X.509.",{"_3602":74401,"_30987":74377,"_21467":126004,"_5":14750,"_28174":125957,"_3058":126005},[],"La **renovación** crea un certificado sucesor para una identidad que continúa siendo válida. La **revocación** comunica que el certificado actual ya no debe aceptarse. Renueva para mantener continuidad; revoca ante compromiso, retirada o un cambio que invalide la identidad.",{"_3602":74402,"_30987":74377,"_21467":126007,"_5":14750,"_28174":125957,"_3058":126008},[],"Solo `CertificateHold` permite reactivar un certificado revocado que no esté en estado `EXPIRED`. Una revocación con otra razón bloquea posteriores cambios de estado. Los registros `EXPIRED` también rechazan cambios; el consumidor debe comprobar las fechas aunque el monitor todavía no haya actualizado el estado. Certificados explica cómo comprobar revocación y reactivación.",{"_3602":74403,"_30987":74377,"_21467":126010,"_5":14750,"_28174":125957,"_3058":126011},[],"La operación **Reissue CA** genera otro certificado para la misma clave y enlaza ambos números de serie mediante metadatos. No equivale a una rotación de clave. Para cambiar la clave, crea una CA sucesora y realiza una migración con periodo de solapamiento.",{"_3602":74404,"_30987":74377,"_21467":126013,"_5":14750,"_28174":125961,"_3058":126014},[],"Revocar una CA inicia una cascada que intenta revocar sus descendientes con `CessationOfOperation`. Puede terminar con fallos parciales y no se deshace al reactivar el padre. Consulta Jerarquía y rotación para sus condiciones y comprobaciones.",{"_3602":74405,"_30987":74377,"_21467":126016,"_5":14750,"_28174":125961,"_3058":126017},[],"Antes de confirmar:",{"_3602":74406,"_30987":74377,"_21467":126019,"_5":14750,"_28174":125961,"_3058":126020},[],"Identifica DMS, dispositivos y servicios que confían en esa cadena.",{"_3602":74407,"_30987":74377,"_21467":126022,"_5":14750,"_28174":125961,"_3058":126023},[],"Distribuye la nueva cadena de confianza.",{"_3602":74408,"_30987":74377,"_21467":126025,"_5":14750,"_28174":125961,"_3058":126026},[],"Reemite las identidades necesarias.",{"_3602":74409,"_30987":74377,"_21467":126028,"_5":14750,"_28174":125961,"_3058":126029},[],"Comprueba OCSP y CRL desde un consumidor real.",{"_3602":74410,"_30987":74377,"_21467":126031,"_5":14750,"_28174":125961,"_3058":126032},[],"Revoca la CA antigua cuando ya no exista tráfico legítimo.",{"_3602":74411,"_30987":74377,"_21467":126034,"_5":14750,"_28174":125961,"_3058":126035},[],"La baja de un dispositivo pertenece al ciclo de vida de IoT Fleets. Afecta a su identidad activa; no equivale a recorrer y revocar automáticamente todos los certificados del historial. Revisa por separado las identidades anteriores y los permisos del consumidor en Gestión de dispositivos.",{"_3602":74412,"_30987":74377,"_21467":126037,"_5":14750,"_28174":125965,"_3058":126038},[],"Certificados que entran en la ventana preventiva o crítica de renovación.",{"_3602":74413,"_30987":74377,"_21467":126040,"_5":14750,"_28174":125965,"_3058":126041},[],"Errores repetidos de enrolamiento o re-enrolamiento.",{"_3602":74414,"_30987":74377,"_21467":126043,"_5":14750,"_28174":125965,"_3058":126044},[],"Cambios de estado y razones de revocación.",{"_3602":74415,"_30987":74377,"_21467":126046,"_5":14750,"_28174":125965,"_3058":126047},[],"Publicación y vigencia de OCSP y CRLs.",{"_3602":74416,"_30987":74377,"_21467":126049,"_5":14750,"_28174":125965,"_3058":126050},[],"Dependencias que todavía presentan un certificado sustituido.",{"_3602":74417,"_30987":74377,"_21467":126052,"_5":14750,"_28174":125965,"_3058":126053},[],"El historial del dispositivo relaciona sus identidades anteriores y actuales. Para cambios administrativos y errores de mutación, consulta Registros de auditoría.",{"_3602":74418,"_30987":74418,"_5":15110,"_3058":126055,"_31325":126056,"_21467":126057,"_28174":74418},"Modelo de confianza",[50623,121012,56298,125923],[],{"_3602":74419,"_30987":74418,"_21467":126059,"_5":14750,"_28174":74418,"_3058":126060},[],"Entiende dónde nace la confianza, cómo se distribuye y qué valida cada componente.",{"_3602":74420,"_30987":74418,"_5":31322,"_21467":126062,"_28174":126063,"_3058":126064},[],"/docs/es/platform/pki/concepts/trust-model#las-cuatro-decisiones-de-confianza","Las cuatro decisiones de confianza",{"_3602":74421,"_30987":74418,"_5":31322,"_21467":126066,"_28174":126067,"_3058":126068},[],"/docs/es/platform/pki/concepts/trust-model#quién-puede-emitir","Quién puede emitir",{"_3602":74422,"_30987":74418,"_5":31322,"_21467":126070,"_28174":126071,"_3058":126072},[],"/docs/es/platform/pki/concepts/trust-model#qué-puede-emitirse","Qué puede emitirse",{"_3602":74423,"_30987":74418,"_5":31322,"_21467":126074,"_28174":126075,"_3058":126076},[],"/docs/es/platform/pki/concepts/trust-model#quién-puede-solicitarlo","Quién puede solicitarlo",{"_3602":74424,"_30987":74418,"_5":31322,"_21467":126078,"_28174":126079,"_3058":126080},[],"/docs/es/platform/pki/concepts/trust-model#quién-acepta-el-resultado","Quién acepta el resultado",{"_3602":74425,"_30987":74418,"_5":31322,"_21467":126082,"_28174":126083,"_3058":126084},[],"/docs/es/platform/pki/concepts/trust-model#flujo-de-una-identidad","Flujo de una identidad",{"_3602":74426,"_30987":74418,"_5":31322,"_21467":126086,"_28174":126087,"_3058":126088},[],"/docs/es/platform/pki/concepts/trust-model#cas-de-enrolamiento-validación-y-distribución","CAs de enrolamiento, validación y distribución",{"_3602":74427,"_30987":74418,"_5":31322,"_21467":126090,"_28174":126091,"_3058":126092},[],"/docs/es/platform/pki/concepts/trust-model#validación-y-revocación","Validación y revocación",{"_3602":74428,"_30987":74418,"_5":31322,"_21467":126094,"_28174":126095,"_3058":126096},[],"/docs/es/platform/pki/concepts/trust-model#límites-de-custodia","Límites de custodia",{"_3602":74429,"_30987":74418,"_5":31322,"_21467":126098,"_28174":126099,"_3058":126100},[],"/docs/es/platform/pki/concepts/trust-model#patrón-recomendado","Patrón recomendado",{"_3602":74430,"_30987":74418,"_21467":126102,"_5":14750,"_28174":74418,"_3058":126103},[],"En Lamassu, confianza no significa simplemente que un certificado exista en el inventario. Un consumidor confía en una identidad cuando puede construir una cadena hasta una raíz que reconoce, comprobar que el certificado sirve para el uso esperado y verificar que sigue vigente.",{"_3602":74431,"_30987":74418,"_21467":126105,"_5":14750,"_28174":126067,"_3058":126106},[],"La jerarquía de CAs define qué autoridades pueden firmar. Una CA raíz establece el ancla de confianza; las CAs intermedias separan ámbitos operativos y evitan utilizar la raíz para cada emisión.",{"_3602":74432,"_30987":74418,"_21467":126108,"_5":14750,"_28174":126071,"_3058":126109},[],"Los perfiles de certificado limitan validez, sujeto, usos, extensiones y parámetros criptográficos. La posesión de una CA no sustituye a una política de emisión.",{"_3602":74433,"_30987":74418,"_21467":126111,"_5":14750,"_28174":126075,"_3058":126112},[],"El DMS actúa como punto de enrolamiento. Puede autenticar una solicitud EST con certificado cliente, webhook externo o una combinación de ambos. Las CAs configuradas para validar al solicitante no tienen por qué ser la CA que emitirá la identidad nueva.",{"_3602":74434,"_30987":74418,"_21467":126114,"_5":14750,"_28174":126079,"_3058":126115},[],"El consumidor mantiene su propio almacén de confianza. EST `/cacerts` puede distribuir el certificado TLS del servicio, la CA de enrolamiento y CAs gestionadas seleccionadas. La confianza inicial para autenticar ese servicio debe proceder de un canal ya confiable. Descarga e inspecciona el contenido: no asumas que es una cadena completa ni instales todas las entradas como raíces.",{"_3602":74435,"_30987":74418,"_21467":126117,"_5":14750,"_28174":126083,"_3058":126118},[],"El dispositivo demuestra que puede enrolarse según la política del DMS.",{"_3602":74436,"_30987":74418,"_21467":126120,"_5":14750,"_28174":126083,"_3058":126121},[],"El DMS valida la solicitud y remite la CSR a la CA de enrolamiento.",{"_3602":74437,"_30987":74418,"_21467":126123,"_5":14750,"_28174":126083,"_3058":126124},[],"En el flujo con CSR generado en el dispositivo, la CA aplica el perfil y firma sin recibir su clave privada.",{"_3602":74438,"_30987":74418,"_21467":126126,"_5":14750,"_28174":126083,"_3058":126127},[],"El dispositivo instala el certificado y la cadena que necesita.",{"_3602":74439,"_30987":74418,"_21467":126129,"_5":14750,"_28174":126083,"_3058":126130},[],"El sistema que confía en el dispositivo valida cadena, fechas, usos y estado de revocación.",{"_3602":74440,"_30987":74418,"_21467":126132,"_5":14750,"_28174":126083,"_3058":126133},[],"OIDC o X.509 identifica al operador que llama a Lamassu. El servicio de autorización decide qué acciones puede realizar. La jerarquía X.509, en cambio, determina si un certificado presentado por un dispositivo es confiable.",{"_3602":74441,"_30987":74418,"_21467":126135,"_5":14750,"_28174":126087,"_3058":126136},[],"Un DMS relaciona tres conjuntos que conviene diseñar por separado:",{"_3602":74442,"_30987":74418,"_21467":126138,"_5":14750,"_28174":126087,"_3058":126139},[],"**CA de enrolamiento:** firma las nuevas identidades.",{"_3602":74443,"_30987":74418,"_21467":126141,"_5":14750,"_28174":126087,"_3058":126142},[],"**CAs de validación:** autentican certificados cliente usados para enrolamiento o migración. En re-enrolamiento, la CA de enrolamiento siempre es confiable y Lamassu prueba después las CAs de validación configuradas en el bloque de re-enrolamiento; estas son opcionales.",{"_3602":74444,"_30987":74418,"_21467":126144,"_5":14750,"_28174":126087,"_3058":126145},[],"**CAs distribuidas:** forman el contenido que el dispositivo obtiene mediante EST `/cacerts`. Puedes incluir el certificado TLS del servicio, la CA de enrolamiento y una lista explícita de CAs gestionadas. Incluir la CA emisora no añade automáticamente todos sus ascendientes.",{"_3602":74445,"_30987":74418,"_21467":126147,"_5":14750,"_28174":126087,"_3058":126148},[],"Esta separación permite migrar una flota: aceptas temporalmente certificados de la jerarquía anterior, emites con la nueva y distribuyes ambas cadenas durante el solapamiento.",{"_3602":74446,"_30987":74418,"_21467":126150,"_5":14750,"_28174":126091,"_3058":126151},[],"Una cadena válida no garantiza por sí sola que el certificado deba aceptarse. El consumidor también debe comprobar:",{"_3602":74447,"_30987":74418,"_21467":126153,"_5":14750,"_28174":126091,"_3058":126154},[],"que la fecha actual está entre `Not Before` y `Not After`;",{"_3602":74448,"_30987":74418,"_21467":126156,"_5":14750,"_28174":126091,"_3058":126157},[],"que `Key Usage` y `Extended Key Usage` permiten la operación;",{"_3602":74449,"_30987":74418,"_21467":126159,"_5":14750,"_28174":126091,"_3058":126160},[],"que nombres, SANs y sujeto coinciden con la identidad esperada;",{"_3602":74450,"_30987":74418,"_21467":126162,"_5":14750,"_28174":126091,"_3058":126163},[],"que el certificado no aparece revocado mediante OCSP o una CRL.",{"_3602":74451,"_30987":74418,"_21467":126165,"_5":14750,"_28174":126091,"_3058":126166},[],"El estado `Good` de OCSP tampoco sustituye la comprobación de cadena, fechas, uso e identidad; Validación reúne esos criterios.",{"_3602":74452,"_30987":74418,"_21467":126168,"_5":14750,"_28174":126091,"_3058":126169},[],"Durante la autenticación mTLS de un DMS, Lamassu intenta comprobar la revocación. Si el certificado no contiene información suficiente para efectuar esa comprobación, el backend registra una advertencia y continúa tratándolo como no revocado. Diseña los perfiles y puntos de distribución para evitar esa situación en producción.",{"_3602":74453,"_30987":74418,"_21467":126171,"_5":14750,"_28174":126095,"_3058":126172},[],"El KMS conserva la referencia de la clave y delega la operación al motor configurado. Con un HSM o un KMS cloud, la clave privada puede permanecer no exportable. Eso protege la custodia, pero no impide por sí solo el uso indebido: todavía debes restringir quién puede ordenar una firma y auditar esas operaciones.",{"_3602":74454,"_30987":74418,"_21467":126174,"_5":14750,"_28174":126099,"_3058":126175},[],"Mantén la raíz fuera de las operaciones diarias o con acceso muy restringido.",{"_3602":74455,"_30987":74418,"_21467":126177,"_5":14750,"_28174":126099,"_3058":126178},[],"Emite desde CAs intermedias separadas por entorno o dominio de riesgo.",{"_3602":74456,"_30987":74418,"_21467":126180,"_5":14750,"_28174":126099,"_3058":126181},[],"Asigna perfiles explícitos a cada caso de uso.",{"_3602":74457,"_30987":74418,"_21467":126183,"_5":14750,"_28174":126099,"_3058":126184},[],"Distribuye la nueva confianza antes de comenzar una rotación.",{"_3602":74458,"_30987":74418,"_21467":126186,"_5":14750,"_28174":126099,"_3058":126187},[],"Mantén solapamiento suficiente para renovar una flota desconectada.",{"_3602":74459,"_30987":74418,"_21467":126189,"_5":14750,"_28174":126099,"_3058":126190},[],"Valida desde el sistema consumidor, no solo desde la consola de Lamassu.",{"_3602":74460,"_30987":74418,"_21467":126192,"_5":14750,"_28174":126099,"_3058":126193},[],"Continúa con Jerarquía y rotación de CAs para convertir este modelo en un procedimiento operativo.",{"_3602":74461,"_30987":74461,"_5":15110,"_3058":126195,"_31325":126196,"_21467":126197,"_28174":74461},"Listas de revocación (CRL)",[50623,121012,56298,125669],[],{"_3602":74462,"_30987":74461,"_21467":126199,"_5":14750,"_28174":74461,"_3058":126200},[],"Genera y distribuye listas firmadas para validar certificados sin conexión.",{"_3602":74463,"_30987":74461,"_5":31322,"_21467":126202,"_28174":126203,"_3058":126204},[],"/docs/es/platform/pki/crl#ajustes-de-crl","Ajustes de CRL",{"_3602":74464,"_30987":74461,"_5":31322,"_21467":126206,"_28174":126207,"_3058":126208},[],"/docs/es/platform/pki/crl#cas-que-comparten-clave","CAs que comparten clave",{"_3602":74465,"_30987":74461,"_5":31322,"_21467":126210,"_28174":126211,"_3058":126212},[],"/docs/es/platform/pki/crl#regeneración-periódica-y-automática","Regeneración periódica y automática",{"_3602":74466,"_30987":74461,"_5":31322,"_21467":126214,"_28174":126215,"_3058":126216},[],"/docs/es/platform/pki/crl#contenido-de-la-crl","Contenido de la CRL",{"_3602":74467,"_30987":74461,"_5":31322,"_21467":126218,"_28174":126219,"_3058":126220},[],"/docs/es/platform/pki/crl#endpoint-público-de-descarga","Endpoint público de descarga",{"_3602":74468,"_30987":74461,"_5":31322,"_21467":126222,"_28174":126223,"_3058":126224},[],"/docs/es/platform/pki/crl#api-de-gestión-de-los-ajustes-de-crl","API de gestión de los ajustes de CRL",{"_3602":74469,"_30987":74461,"_5":31322,"_21467":126226,"_28174":126227,"_3058":126228},[],"/docs/es/platform/pki/crl#errores-frecuentes-de-los-ajustes-de-crl","Errores frecuentes de los ajustes de CRL",{"_3602":74470,"_30987":74461,"_5":31322,"_21467":126230,"_28174":126231,"_3058":126232},[],"/docs/es/platform/pki/crl#referencias","Referencias",{"_3602":74471,"_30987":74461,"_21467":126234,"_5":14750,"_28174":74461,"_3058":126235},[],"Una CRL es una lista firmada de certificados revocados por un emisor. Esta guía sirve al operador que publica listas y al integrador que las utiliza localmente. Necesitas el certificado de la CA emisora, su ID de CA y acceso al endpoint publicado. El cliente debe mantener una copia vigente: funcionar offline no elimina la necesidad de renovar la evidencia.",{"_3602":74472,"_30987":74461,"_21467":126237,"_5":14750,"_28174":126203,"_3058":126238},[],"Los ajustes de CRL de una CA guardan la configuración y los metadatos de su última lista publicada. Cada CA tiene los suyos, indexados por su ID de CA — incluso cuando dos CAs comparten clave: comparten el SKI, no la CRL. La generación requiere una clave emisora utilizable; no presupongas que una CA importada sin clave tiene una CRL disponible.",{"_3602":74473,"_30987":74461,"_21467":126240,"_5":14750,"_28174":126203,"_3058":126241},[],"Campo",{"_3602":74474,"_30987":74461,"_21467":126243,"_5":14750,"_28174":126203,"_3058":122686},[],{"_3602":74475,"_30987":74461,"_21467":126245,"_5":14750,"_28174":126203,"_3058":52255},[],{"_3602":74476,"_30987":74461,"_21467":126247,"_5":14750,"_28174":126203,"_3058":126248},[],"ID de la CA a la que pertenecen los ajustes.",{"_3602":74477,"_30987":74461,"_21467":126250,"_5":14750,"_28174":126203,"_3058":57530},[],{"_3602":74478,"_30987":74461,"_21467":126252,"_5":14750,"_28174":126203,"_3058":126253},[],"Ciclo de vida de los ajustes. Los `ACTIVE` generan CRLs. Los `FINAL` pertenecen a una CA revocada de forma permanente o caducada: la primera publica una CRL final, válida hasta que expire el certificado actual de la CA, y la segunda pasa a `FINAL` sin CRL final. Los `ARCHIVED` pertenecen a una CA eliminada: su última CRL sigue sirviéndose, pero nunca se regenera.",{"_3602":74479,"_30987":74461,"_21467":126255,"_5":14750,"_28174":126203,"_3058":57536},[],{"_3602":74480,"_30987":74461,"_21467":126257,"_5":14750,"_28174":126203,"_3058":126258},[],"Solo lectura. SKI por el que los ajustes estaban indexados antes de la migración de 4.0.0; solo lo tienen los migrados, y `/crl/<ski>` sigue resolviendo a ellos.",{"_3602":74481,"_30987":74461,"_21467":126260,"_5":14750,"_28174":126203,"_3058":57542},[],{"_3602":74482,"_30987":74461,"_21467":126262,"_5":14750,"_28174":126203,"_3058":126263},[],"Versión, inicio y fin de validez de la última lista publicada. Solo lectura.",{"_3602":74483,"_30987":74461,"_21467":126265,"_5":14750,"_28174":126203,"_3058":126266},[],"Campo de `crl_options`",{"_3602":74484,"_30987":74461,"_21467":126268,"_5":14750,"_28174":126203,"_3058":122686},[],{"_3602":74485,"_30987":74461,"_21467":126270,"_5":14750,"_28174":126203,"_3058":126271},[],"Valor inicial",{"_3602":74486,"_30987":74461,"_21467":126273,"_5":14750,"_28174":126203,"_3058":57556},[],{"_3602":74487,"_30987":74461,"_21467":126275,"_5":14750,"_28174":126203,"_3058":126276},[],"Tiempo desde `thisUpdate` hasta `nextUpdate`.",{"_3602":74488,"_30987":74461,"_21467":126278,"_5":14750,"_28174":126203,"_3058":126279},[],"7 días.",{"_3602":74489,"_30987":74461,"_21467":126281,"_5":14750,"_28174":126203,"_3058":57565},[],{"_3602":74490,"_30987":74461,"_21467":126283,"_5":14750,"_28174":126203,"_3058":126284},[],"Tiempo desde la emisión de la última CRL publicada que activa la renovación programada; `0` desactiva solo este disparador. La granularidad efectiva está limitada por la frecuencia del job (consulta Regeneración periódica y automática).",{"_3602":74491,"_30987":74461,"_21467":126286,"_5":14750,"_28174":126203,"_3058":126287},[],"6 días y 23 horas.",{"_3602":74492,"_30987":74461,"_21467":126289,"_5":14750,"_28174":126203,"_3058":57574},[],{"_3602":74493,"_30987":74461,"_21467":126291,"_5":14750,"_28174":126203,"_3058":126292},[],"Solicitar regeneración por eventos de revocación o reactivación desde `CertificateHold`.",{"_3602":74494,"_30987":74461,"_21467":126294,"_5":14750,"_28174":126203,"_3058":57580},[],{"_3602":74495,"_30987":74461,"_21467":126296,"_5":14750,"_28174":126203,"_3058":57583},[],{"_3602":74496,"_30987":74461,"_21467":126298,"_5":14750,"_28174":126203,"_3058":126299},[],"Número de serie del certificado existente que firma la CRL.",{"_3602":74497,"_30987":74461,"_21467":126301,"_5":14750,"_28174":126203,"_3058":126302},[],"Número de serie del certificado actual de la CA.",{"_3602":74498,"_30987":74461,"_21467":126304,"_5":14750,"_28174":126203,"_3058":126305},[],"El firmante debe ser un certificado existente con el uso `cRLSign`, el mismo sujeto y la misma clave pública que la CA. Quedan incluidos los certificados anteriores a una reemisión. No se admite un firmante delegado: un certificado con el sujeto de la CA pero con otra clave se rechaza.",{"_3602":74499,"_30987":74461,"_21467":126307,"_5":14750,"_28174":126203,"_3058":126308},[],"Al reemitir una CA, si el firmante es el certificado de la CA sustituido, la VA lo mueve al certificado nuevo — siempre que incluya `cRLSign` — y republica la CRL. Si el certificado nuevo carece de `cRLSign`, la VA mantiene el firmante anterior y registra un aviso. Si el firmante es cualquier otro certificado con el sujeto y la clave de la CA, se deja deliberadamente sin cambios; en ese caso el certificado anterior no puede eliminarse mientras los ajustes lo usen (la API devuelve `409` `certificate is in use`), y para retirarlo actualizas el firmante con `PUT`.",{"_3602":74500,"_30987":74461,"_21467":126310,"_5":14750,"_28174":126203,"_3058":126311},[],"Las decisiones del ciclo de vida de la CRL — cuándo deja de publicarse y cuándo expira la CRL final — usan únicamente el certificado actual de la CA. Si un certificado reemitido expira antes que un certificado antiguo que sigue vigente, la publicación de CRLs puede detenerse, o la CRL final puede expirar, mientras el certificado antiguo siga vigente. Es una limitación aceptada del comportamiento actual.",{"_3602":74501,"_30987":74461,"_21467":126313,"_5":14750,"_28174":126203,"_3058":126314},[],"Una CA cuyo firmante no tiene `cRLSign` no puede generar su CRL, y una actualización que seleccione un firmante sin `cRLSign` se rechaza (error 400). Desde 4.0 la VA exige este uso. Comprueba antes de importar con `openssl x509 -noout -ext keyUsage` y, si falta, obtén un certificado de la misma CA y clave que lo incluya y actualiza los ajustes para usarlo como firmante. Tras reemitir una CA, comprueba también el uso de clave del certificado nuevo: puede no conservar los usos del original, y sin `cRLSign` los ajustes conservan su firmante anterior.",{"_3602":74502,"_30987":74461,"_21467":126316,"_5":14750,"_28174":126203,"_3058":126317},[],"Eliminar una CA conserva sus ajustes de CRL; permanecen hasta que borres los archivados por API o desde la página Verification Authorities de la consola (consulta API de gestión de los ajustes de CRL). Lo que ocurre con ellos depende de cómo terminó la CA:",{"_3602":74503,"_30987":74461,"_21467":126319,"_5":14750,"_28174":126203,"_3058":126320},[],"La migración de la actualización a 4.0.0 archiva los ajustes de las CAs que se habían eliminado antes de la actualización. Su `status` es `ARCHIVED` y su `ca_id` es `legacy-<ski>`: la última CRL sigue sirviéndose, pero nunca se regenera, cualquier `PUT` devuelve 409 y no hay forma de volver a `ACTIVE` por API.",{"_3602":74504,"_30987":74461,"_21467":126322,"_5":14750,"_28174":126203,"_3058":126323},[],"Revocar una CA de forma permanente o dejar que caduque finaliza sus ajustes: su `status` pasa a `FINAL`, cualquier `PUT` devuelve 409 y no se genera ninguna CRL nueva. Una CA revocada permanentemente publica una CRL final, válida hasta que expire el certificado actual de la CA; una CA caducada no recibe ninguna. Eliminar después la CA archiva sus ajustes, que pasan a comportarse como los archivados de la migración.",{"_3602":74505,"_30987":74461,"_21467":126325,"_5":14750,"_28174":126203,"_3058":126326},[],"Los ajustes dejan de poder editarse mientras su `status` no sea `ACTIVE`. Ajusta validez y firmante antes de revocar o eliminar una CA.",{"_3602":74506,"_30987":74461,"_21467":126328,"_5":14750,"_28174":126203,"_3058":126329},[],"El `PUT` valida el firmante solo cuando la petición lo cambia. Si el firmante guardado ya no es válido, las demás opciones siguen editándose, pero la CRL no puede regenerarse hasta asignar uno válido.",{"_3602":74507,"_30987":74461,"_21467":126331,"_5":14750,"_28174":126203,"_3058":126332},[],"Compartir una clave entre CAs bloquea la migración: la actualización a 4.0.0 aborta mientras un SKI pertenezca a más de una CA. Consulta CAs que comparten clave.",{"_3602":74508,"_30987":74461,"_21467":126334,"_5":14750,"_28174":126203,"_3058":126335},[],"Las versiones de las CRLs se conservan en el almacenamiento de objetos como PEM bajo `pki/va/crl/<ca-id>/<version>.crl`; el endpoint público entrega DER. Las CRLs publicadas antes de la actualización a 4.0.0 permanecen bajo `pki/va/crl/<ski>/<version>.crl` y siguen sirviéndose.",{"_3602":74509,"_30987":74461,"_21467":126337,"_5":14750,"_28174":126207,"_3058":126338},[],"Desde 4.0.0, cada CA publica su propia CRL aunque comparta clave: dos CAs con la misma clave tienen el mismo SKI, pero cada una tiene sus propios ajustes de CRL y su propia lista, firmada por un certificado con la identidad de esa CA.",{"_3602":74510,"_30987":74461,"_21467":126340,"_5":14750,"_28174":126207,"_3058":126341},[],"Los certificados emitidos a partir de ahora llevan puntos de distribución `/crl/<ca-id>`, así que los certificados de cada CA resuelven a su propia lista. Los certificados emitidos antes de la actualización conservan sus puntos de distribución `/crl/<ski>`: esa URL sigue resolviendo a los ajustes que migró la actualización y sirve siempre la lista de la CA propietaria de ese SKI cuando se ejecutó la actualización. Nunca se reasigna a una CA creada después con la misma clave. Tras la regeneración, la lista migrada incluye ambas URLs en su *Issuing Distribution Point* (OID `2.5.29.28`), de modo que un verificador que compara el IDP con el CDP del certificado acepta cualquiera de las dos formas. Hasta que el job de CRL de la VA la regenere correctamente, la lista anterior a la actualización solo contiene el IDP heredado `/crl/<ski>`; los verificadores que comprueban el IDP no pueden validar los certificados recién emitidos con CDP `/crl/<ca-id>`. Con la frecuencia predeterminada, la primera ejecución puede tardar hasta aproximadamente una hora y los fallos pueden prolongar ese intervalo.",{"_3602":74511,"_30987":74461,"_21467":126343,"_5":14750,"_28174":126207,"_3058":126344},[],"Compartir un SKI entre CAs bloquea la actualización: la migración aborta y nombra los SKIs. Para detectar el problema antes de actualizar, compara el SKI de las CAs en el inventario: dos con el mismo SKI están afectadas. Para resolverlo, crea una CA con clave propia y reemite sus certificados; los ya emitidos conservan la URL antigua y no se corrigen hasta reemitirlos.",{"_3602":74512,"_30987":74461,"_21467":126346,"_5":14750,"_28174":126207,"_3058":126347},[],"Lamassu toma el SKI del certificado importado tal cual y no comprueba que corresponda a su clave pública. Hasta que Lamassu rechace las importaciones cuyo SKI colisione con el de una CA existente — rechazo propuesto en lamassuiot#834, junto con la CRL por CA que 4.0.0 implementa —, limita el permiso de importar CAs como control provisional; cubre solo la vía de importación. Crear una CA con &#x2A;*Create New CA (Existing Key)** sobre una clave KMS que otra CA ya usa produce la misma colisión de SKI, así que evita reutilizar claves entre CAs.",{"_3602":74513,"_30987":74461,"_21467":126349,"_5":14750,"_28174":126211,"_3058":126350},[],"El job de la VA revisa los ajustes de CRL de todas las CA en cada ejecución y solicita una lista nueva cuando se cumple alguna de estas condiciones:",{"_3602":74514,"_30987":74461,"_21467":126352,"_5":14750,"_28174":126211,"_3058":126353},[],"**La lista está a punto de vencer:** a `latest_crl` le queda menos validez que el intervalo entre ejecuciones del trabajo. Esta condición se aplica siempre y no puede desactivarse.",{"_3602":74515,"_30987":74461,"_21467":126355,"_5":14750,"_28174":126211,"_3058":126356},[],"**Ha transcurrido el intervalo de renovación:** el tiempo desde la emisión de la última CRL publicada alcanza `refresh_interval`. Con `refresh_interval` a `0` se desactiva solo esta condición; la lista se sigue regenerando cuando está a punto de vencer.",{"_3602":74516,"_30987":74461,"_21467":126358,"_5":14750,"_28174":126211,"_3058":126359},[],"Poner `refresh_interval` a `0` no congela, por tanto, la regeneración. Con la validez por defecto de 7 días y un trabajo cada hora, la CRL se renueva hasta una hora antes de vencer aunque `refresh_interval` sea `0`. Como el trabajo se ejecuta según su propia planificación, el `refresh_interval` se respeta solo con la precisión que permita la frecuencia del job.",{"_3602":74517,"_30987":74461,"_21467":126361,"_5":14750,"_28174":126211,"_3058":126362},[],"La frecuencia del trabajo se configura en Helm con `services.va.job.crl.frequency` (por defecto `0 * * * *`) y admite una duración (`1h`) o una expresión cron. Una expresión cron se convierte en un intervalo constante igual al tiempo que falta para su siguiente disparo cuando arranca el servicio, así que no se alinea con el reloj. Mantén `validity` claramente por encima de ese intervalo: con una validez menor, la lista se regenera en cada ciclo.",{"_3602":74518,"_30987":74461,"_21467":126364,"_5":14750,"_28174":126211,"_3058":126365},[],"Si la generación falla (por ejemplo, porque no puede resolver la CA o el firmante es inválido), el trabajo registra el aviso `something went wrong while calculating CRL for CA <ca-id>` y lo reintenta en el ciclo siguiente. No hay otra vía de renovación hasta corregir la causa, y la última lista publicada se sigue sirviendo hasta vencer. Todo ello depende de que el trabajo, el almacenamiento y la firma funcionen.",{"_3602":74519,"_30987":74461,"_21467":126367,"_5":14750,"_28174":126211,"_3058":126368},[],"Los ajustes con `status` distinto de `ACTIVE` — `FINAL` o `ARCHIVED` — se omiten: nada regenera su CRL.",{"_3602":74520,"_30987":74461,"_21467":126370,"_5":14750,"_28174":126211,"_3058":126371},[],"Con `regenerate_on_revoke`, el manejador de eventos solicita una nueva CRL cuando recibe una revocación o la reactivación de un certificado desde `CertificateHold` a `ACTIVE`. Es un paso posterior al cambio de estado, con sus propios posibles errores: si falla la generación (por ejemplo, por un firmante inválido), el evento se reintenta y, agotados los reintentos, pasa a la cola de eventos fallidos. Si la CA emisora no tiene ajustes de CRL, no hay CRL que regenerar: el evento se da por atendido sin reintento, la VA registra un aviso y no aparece nada en la cola de eventos fallidos. Confirmar la revocación no demuestra que la CRL nueva ya esté publicada ni que todos los clientes la hayan descargado.",{"_3602":74521,"_30987":74461,"_21467":126373,"_5":14750,"_28174":126211,"_3058":126374},[],"Comprueba el número de CRL y sus tiempos antes y después del cambio. Supervisa listas vencidas y fallos de generación; los clientes deben aplicar su política cuando no disponen de evidencia vigente.",{"_3602":74522,"_30987":74461,"_21467":126376,"_5":14750,"_28174":126215,"_3058":126377},[],"Cada entrada incluye serie, fecha de revocación y razón. El generador consulta certificados en estado `REVOKED` para la CA seleccionada. Un certificado reactivado deja de aparecer al recalcular la lista; una copia descargada anteriormente conserva su contenido.",{"_3602":74523,"_30987":74461,"_21467":126379,"_5":14750,"_28174":126215,"_3058":126380},[],"La lista incluye un *Issuing Distribution Point* crítico (OID `2.5.29.28`) con las URLs de distribución configuradas. Comprueba que tu cliente interpreta esa extensión y que corresponde al ámbito de la lista. Si la rechaza, investiga el formato y el alcance; ignorar una extensión crítica no es una validación satisfactoria.",{"_3602":74524,"_30987":74461,"_21467":126382,"_5":14750,"_28174":126219,"_3058":126383},[],"El servicio VA expone `GET /crl/{id}` sin autorización de gestión. Usa el **ID de la CA emisora**, no el ID ni el número de serie del certificado final. Los certificados emitidos antes de la actualización a 4.0.0 llevan URLs `/crl/<ski>` con el SKI de la clave de la CA; esa forma sigue resolviendo. Inspecciona primero el CDP del certificado:",{"_3602":74525,"_30987":74461,"_21467":126385,"_5":14750,"_28174":126219,"_3058":126386},[],"Sustituye la URL siguiente por la del CDP y revisa la exposición en Despliegue:",{"_3602":74526,"_30987":74461,"_21467":126388,"_5":14750,"_28174":126219,"_3058":126389},[],"Necesitas OpenSSL 3.x e `issuer.pem` con el certificado del emisor directo. Un certificado firmante aceptado tiene el mismo sujeto y la misma clave pública que la CA, por lo que esta comprobación de firma también funciona cuando los ajustes apuntan a un certificado anterior de esa CA y clave. Exige firma válida, tiempos vigentes y emisor esperado. Para una prueba con una raíz que emite directamente:",{"_3602":74527,"_30987":74461,"_21467":126391,"_5":14750,"_28174":126219,"_3058":126392},[],"`roots.pem` contiene las raíces deliberadamente confiables. Si hay intermedias, añade `-untrusted intermediates.pem` antes del argumento `device.crt`. `-crl_check` comprueba la revocación del certificado final usando la lista local; no descarga otras listas ni demuestra el estado de toda la cadena. Para comprobarla completa, necesitas las CRL correspondientes y una política que las exija.",{"_3602":74528,"_30987":74461,"_21467":126394,"_5":14750,"_28174":126219,"_3058":126395},[],"La prueba debe aceptar un certificado permitido que no esté en la lista y rechazarlo con `certificate revoked` después de publicar y utilizar la lista que contiene su serie.",{"_3602":74529,"_30987":74461,"_21467":126397,"_5":14750,"_28174":126223,"_3058":126398},[],"Los paths siguientes son relativos al servicio VA; el prefijo público debe confirmarse en el Gateway. No son las URLs de los endpoints públicos de OCSP y CRL.",{"_3602":74530,"_30987":74461,"_21467":126400,"_5":14750,"_28174":126223,"_3058":122875},[],{"_3602":74531,"_30987":74461,"_21467":126402,"_5":14750,"_28174":126223,"_3058":126403},[],"Path relativo",{"_3602":74532,"_30987":74461,"_21467":126405,"_5":14750,"_28174":126223,"_3058":120772},[],{"_3602":74533,"_30987":74461,"_21467":126407,"_5":14750,"_28174":126223,"_3058":57695},[],{"_3602":74534,"_30987":74461,"_21467":126409,"_5":14750,"_28174":126223,"_3058":57698},[],{"_3602":74535,"_30987":74461,"_21467":126411,"_5":14750,"_28174":126223,"_3058":126412},[],"Listar los ajustes de CRL; filtrable al menos por `ca_id`, `status` y `legacy_ski`.",{"_3602":74536,"_30987":74461,"_21467":126414,"_5":14750,"_28174":126223,"_3058":57695},[],{"_3602":74537,"_30987":74461,"_21467":126416,"_5":14750,"_28174":126223,"_3058":57706},[],{"_3602":74538,"_30987":74461,"_21467":126418,"_5":14750,"_28174":126223,"_3058":126419},[],"Consultar los `crl_options` y `latest_crl` de una CA.",{"_3602":74539,"_30987":74461,"_21467":126421,"_5":14750,"_28174":126223,"_3058":57712},[],{"_3602":74540,"_30987":74461,"_21467":126423,"_5":14750,"_28174":126223,"_3058":57706},[],{"_3602":74541,"_30987":74461,"_21467":126425,"_5":14750,"_28174":126223,"_3058":126426},[],"Sustituir la configuración de CRL de una CA.",{"_3602":74542,"_30987":74461,"_21467":126428,"_5":14750,"_28174":126223,"_3058":57720},[],{"_3602":74543,"_30987":74461,"_21467":126430,"_5":14750,"_28174":126223,"_3058":57706},[],{"_3602":74544,"_30987":74461,"_21467":126432,"_5":14750,"_28174":126223,"_3058":126433},[],"Eliminar los ajustes de CRL archivados de una CA.",{"_3602":74545,"_30987":74461,"_21467":126435,"_5":14750,"_28174":126223,"_3058":126436},[],"Necesitas autenticación y permisos de lectura, actualización o borrado de los ajustes de CRL. Consulta la Referencia API y el control de acceso de tu instalación. Lee la configuración actual antes de actualizarla y envía el objeto completo esperado por el contrato — `refresh_interval`, `validity`, `signer_serial_number` y `regenerate_on_revoke`: el backend sustituye los cuatro; no fusiona campos omitidos. `status`, `legacy_ski` y `latest_crl` son de solo lectura. Un `PUT` devuelve 409 cuando los ajustes no están `ACTIVE`, valida el firmante solo cuando cambia y no regenera la CRL.",{"_3602":74546,"_30987":74461,"_21467":126438,"_5":14750,"_28174":126223,"_3058":126439},[],"Los ajustes archivados, cuya CA ya no existe, pueden eliminarse con `DELETE`: la llamada devuelve 204 en caso de éxito, 404 cuando la CA no tiene ajustes y 409 mientras los ajustes no estén todavía archivados. Tras el borrado, el endpoint público `/crl/{id}` y cualquier endpoint heredado `/crl/<ski>` dejan de servir la lista de la CA, aunque los ficheros de CRL publicados permanecen en el bucket. Conserva los ajustes archivados mientras cualquier certificado emitido por la CA pueda necesitar evidencia de revocación: `DELETE` deja de servir la lista inmediatamente, independientemente de la validez de `latest_crl`. La acción no puede deshacerse.",{"_3602":74547,"_30987":74461,"_21467":126441,"_5":14750,"_28174":126223,"_3058":126442},[],"Después de un cambio, comprueba la configuración guardada y la siguiente lista efectivamente publicada. Modificar los ajustes no prueba por sí solo regeneración ni aceptación por el cliente.",{"_3602":74548,"_30987":74461,"_21467":126444,"_5":14750,"_28174":126227,"_3058":126445},[],"Síntoma",{"_3602":74549,"_30987":74461,"_21467":126447,"_5":14750,"_28174":126227,"_3058":126448},[],"Causa",{"_3602":74550,"_30987":74461,"_21467":126450,"_5":14750,"_28174":126227,"_3058":126451},[],"Acción",{"_3602":74551,"_30987":74461,"_21467":126453,"_5":14750,"_28174":126227,"_3058":126454},[],"`PUT /v1/crl-settings/{ca-id}` devuelve 409.",{"_3602":74552,"_30987":74461,"_21467":126456,"_5":14750,"_28174":126227,"_3058":126457},[],"Los ajustes no están `ACTIVE`: revocar la CA de forma permanente o dejar que caduque los finalizó, o la migración los archivó porque su CA se eliminó antes de la actualización.",{"_3602":74553,"_30987":74461,"_21467":126459,"_5":14750,"_28174":126227,"_3058":126460},[],"No hay vuelta a `ACTIVE` por API. La última CRL sigue sirviéndose.",{"_3602":74554,"_30987":74461,"_21467":126462,"_5":14750,"_28174":126227,"_3058":126463},[],"`DELETE /v1/crl-settings/{ca-id}` devuelve 409.",{"_3602":74555,"_30987":74461,"_21467":126465,"_5":14750,"_28174":126227,"_3058":126466},[],"Los ajustes no están todavía `ARCHIVED`: la CA no se ha eliminado.",{"_3602":74556,"_30987":74461,"_21467":126468,"_5":14750,"_28174":126227,"_3058":126469},[],"Elimina primero la CA; su eliminación archiva los ajustes.",{"_3602":74557,"_30987":74461,"_21467":126471,"_5":14750,"_28174":126227,"_3058":126472},[],"`PUT` devuelve 400.",{"_3602":74558,"_30987":74461,"_21467":126474,"_5":14750,"_28174":126227,"_3058":126475},[],"El firmante nuevo no tiene `cRLSign`, o su sujeto y su clave pública no coinciden con los de la CA.",{"_3602":74559,"_30987":74461,"_21467":126477,"_5":14750,"_28174":126227,"_3058":126478},[],"Asigna el número de serie de un certificado válido de esa CA.",{"_3602":74560,"_30987":74461,"_21467":126480,"_5":14750,"_28174":126227,"_3058":126481},[],"`PUT` devuelve 404.",{"_3602":74561,"_30987":74461,"_21467":126483,"_5":14750,"_28174":126227,"_3058":126484},[],"La CA o el certificado firmante nuevo no existen, o la CA no tiene ajustes de CRL (por ejemplo, una CA importada).",{"_3602":74562,"_30987":74461,"_21467":126486,"_5":14750,"_28174":126227,"_3058":126487},[],"Revisa el ID de CA y el número de serie del firmante.",{"_3602":74563,"_30987":74461,"_21467":126489,"_5":14750,"_28174":126227,"_3058":126490},[],"`PUT` devuelve 400 desde un cliente de 3.x.",{"_3602":74564,"_30987":74461,"_21467":126492,"_5":14750,"_28174":126227,"_3058":126493},[],"`crl_options.subject_key_id_signer` se sustituyó por `crl_options.signer_serial_number`, que es obligatorio.",{"_3602":74565,"_30987":74461,"_21467":126495,"_5":14750,"_28174":126227,"_3058":126496},[],"Actualiza el cliente para enviar el campo nuevo.",{"_3602":74566,"_30987":74461,"_21467":126498,"_5":14750,"_28174":126227,"_3058":126499},[],"La CRL no cambia tras revocar un certificado.",{"_3602":74567,"_30987":74461,"_21467":126501,"_5":14750,"_28174":126227,"_3058":126502},[],"`regenerate_on_revoke` es `false`, la CA emisora no tiene ajustes de CRL, o la generación falló por un firmante inválido.",{"_3602":74568,"_30987":74461,"_21467":126504,"_5":14750,"_28174":126227,"_3058":126505},[],"Revisa los logs de la VA. La falta de ajustes solo genera un aviso (sin reintento ni entrada en la cola de eventos fallidos); un firmante inválido además deja el evento en la cola de eventos fallidos, así que corrige el firmante.",{"_3602":74569,"_30987":74461,"_21467":126507,"_5":14750,"_28174":126227,"_3058":126508},[],"Un verificador rechaza la CRL por el emisor.",{"_3602":74570,"_30987":74461,"_21467":126510,"_5":14750,"_28174":126227,"_3058":126511},[],"La lista se descargó por una URL heredada `/crl/<ski>` y pertenece a la CA propietaria de ese SKI cuando se ejecutó la actualización.",{"_3602":74571,"_30987":74461,"_21467":126513,"_5":14750,"_28174":126227,"_3058":126514},[],"Usa el CDP del certificado que validas: los certificados emitidos en 4.0.0 llevan URLs `/crl/<ca-id>`.",{"_3602":74572,"_30987":74461,"_21467":126516,"_5":14750,"_28174":126231,"_3058":126517},[],"RFC 5280: perfil X.509 y CRL.",{"_3602":74573,"_30987":74461,"_21467":126519,"_5":14750,"_28174":126231,"_3058":57812},[],{"_3602":74574,"_30987":74461,"_21467":126521,"_5":14750,"_28174":126231,"_3058":57815},[],{"_3602":74575,"_30987":74461,"_21467":126523,"_5":14750,"_28174":126231,"_3058":126524},[],"<Card title=\"Servicio OCSP\" href=\"/docs/platform/pki/ocsp\" />",{"_3602":74576,"_30987":74461,"_21467":126526,"_5":14750,"_28174":126231,"_3058":126527},[],"<Card title=\"Validación de certificados\" href=\"/docs/platform/pki/certificate-validation\" />",{"_3602":74577,"_30987":74577,"_5":15110,"_3058":126529,"_31325":126530,"_21467":126531,"_28174":74577},"Claves y motores criptográficos",[50623,121012,56298,125023],[],{"_3602":74578,"_30987":74577,"_21467":126533,"_5":14750,"_28174":74577,"_3058":126534},[],"Genera, importa y opera claves sin acoplar la PKI a un proveedor concreto.",{"_3602":74579,"_30987":74577,"_5":31322,"_21467":126536,"_28174":126537,"_3058":126538},[],"/docs/es/platform/pki/key-management#qué-resuelve-el-kms","Qué resuelve el KMS",{"_3602":74580,"_30987":74577,"_5":31322,"_21467":126540,"_28174":126541,"_3058":126542},[],"/docs/es/platform/pki/key-management#motores-criptográficos","Motores criptográficos",{"_3602":74581,"_30987":74577,"_5":31322,"_21467":126544,"_28174":126545,"_3058":57840},[],"/docs/es/platform/pki/key-management#file-system",{"_3602":74582,"_30987":74577,"_5":31322,"_21467":126547,"_28174":126548,"_3058":57844},[],"/docs/es/platform/pki/key-management#hashicorp-vault",{"_3602":74583,"_30987":74577,"_5":31322,"_21467":126550,"_28174":126551,"_3058":57848},[],"/docs/es/platform/pki/key-management#aws-secrets-manager",{"_3602":74584,"_30987":74577,"_5":31322,"_21467":126553,"_28174":126554,"_3058":57852},[],"/docs/es/platform/pki/key-management#aws-kms",{"_3602":74585,"_30987":74577,"_5":31322,"_21467":126556,"_28174":126557,"_3058":57856},[],"/docs/es/platform/pki/key-management#pkcs11",{"_3602":74586,"_30987":74577,"_5":31322,"_21467":126559,"_28174":126560,"_3058":57860},[],"/docs/es/platform/pki/key-management#azure-key-vault",{"_3602":74587,"_30987":74577,"_5":31322,"_21467":126562,"_28174":126563,"_3058":126564},[],"/docs/es/platform/pki/key-management#inventario-de-claves","Inventario de claves",{"_3602":74588,"_30987":74577,"_5":31322,"_21467":126566,"_28174":126567,"_3058":126568},[],"/docs/es/platform/pki/key-management#crear-o-importar-claves","Crear o importar claves",{"_3602":74589,"_30987":74577,"_5":31322,"_21467":126570,"_28174":126571,"_3058":126572},[],"/docs/es/platform/pki/key-management#generar-un-nuevo-par-de-claves","Generar un nuevo par de claves",{"_3602":74590,"_30987":74577,"_5":31322,"_21467":126574,"_28174":126575,"_3058":126576},[],"/docs/es/platform/pki/key-management#importar-un-par-existente","Importar un par existente",{"_3602":74591,"_30987":74577,"_5":31322,"_21467":126578,"_28174":126579,"_3058":126580},[],"/docs/es/platform/pki/key-management#operaciones-sobre-una-clave","Operaciones sobre una clave",{"_3602":74592,"_30987":74577,"_5":31322,"_21467":126582,"_28174":126583,"_3058":126584},[],"/docs/es/platform/pki/key-management#ver-detalles","Ver detalles",{"_3602":74593,"_30987":74577,"_5":31322,"_21467":126586,"_28174":126587,"_3058":126588},[],"/docs/es/platform/pki/key-management#firmar-y-verificar","Firmar y verificar",{"_3602":74594,"_30987":74577,"_5":31322,"_21467":126590,"_28174":126591,"_3058":57892},[],"/docs/es/platform/pki/key-management#sign",{"_3602":74595,"_30987":74577,"_5":31322,"_21467":126593,"_28174":126594,"_3058":57896},[],"/docs/es/platform/pki/key-management#verify",{"_3602":74596,"_30987":74577,"_5":31322,"_21467":126596,"_28174":126597,"_3058":126598},[],"/docs/es/platform/pki/key-management#generar-un-csr","Generar un CSR",{"_3602":74597,"_30987":74577,"_5":31322,"_21467":126600,"_28174":126601,"_3058":126602},[],"/docs/es/platform/pki/key-management#firma-local-con-pkcs11","Firma local con PKCS#11",{"_3602":74598,"_30987":74577,"_5":31322,"_21467":126604,"_28174":126605,"_3058":126606},[],"/docs/es/platform/pki/key-management#antes-de-eliminar-una-clave","Antes de eliminar una clave",{"_3602":74599,"_30987":74577,"_21467":126608,"_5":14750,"_28174":74577,"_3058":126609},[],"El servicio de Gestión de Claves Criptográficas (KMS) de Lamassu IoT centraliza la generación, importación, custodia y uso de las claves de la plataforma. Desde aquí se gestionan las claves que soportan a las CAs y al resto de operaciones de firma que dependen de la PKI.",{"_3602":74600,"_30987":74577,"_21467":126611,"_5":14750,"_28174":74577,"_3058":126612},[],"En la configuración actual, Lamassu IoT trabaja exclusivamente con claves asimétricas, como RSA y curvas elípticas. Estas claves se usan para emitir certificados X.509, firmar solicitudes y realizar operaciones de autenticación y validación dentro del sistema.",{"_3602":74601,"_30987":74577,"_21467":126614,"_5":14750,"_28174":126537,"_3058":126615},[],"El KMS unifica la gestión del ciclo de vida de las claves y evita que cada servicio tenga que integrarse directamente con un proveedor criptográfico concreto.",{"_3602":74602,"_30987":74577,"_21467":126617,"_5":14750,"_28174":126537,"_3058":126618},[],"En la práctica, permite:",{"_3602":74603,"_30987":74577,"_21467":126620,"_5":14750,"_28174":126537,"_3058":126621},[],"Generar nuevos pares de claves desde Lamassu IoT.",{"_3602":74604,"_30987":74577,"_21467":126623,"_5":14750,"_28174":126537,"_3058":126624},[],"Importar claves creadas externamente.",{"_3602":74605,"_30987":74577,"_21467":126626,"_5":14750,"_28174":126537,"_3058":126627},[],"Delegar la custodia y las operaciones criptográficas en motores externos.",{"_3602":74606,"_30987":74577,"_21467":126629,"_5":14750,"_28174":126537,"_3058":126630},[],"Reutilizar claves ya existentes para CAs, CSR y tareas de firma o verificación.",{"_3602":74607,"_30987":74577,"_21467":126632,"_5":14750,"_28174":126541,"_3058":126633},[],"Lamassu puede trabajar con distintos motores criptográficos según los requisitos del despliegue. En algunos entornos bastará con un motor software; en otros será necesario delegar la custodia en un HSM, en un servicio cloud o en una plataforma especializada.",{"_3602":74608,"_30987":74577,"_21467":126635,"_5":14750,"_28174":126541,"_3058":126636},[],"Una misma instancia puede tener varios motores configurados al mismo tiempo, incluso varias instancias del mismo tipo. Esto permite adaptar la operación a distintos niveles de seguridad, coste y requisitos regulatorios.",{"_3602":74609,"_30987":74577,"_21467":126638,"_5":14750,"_28174":126541,"_3058":126639},[],"Esta guía se dirige al operador PKI: elige y utiliza un motor ya habilitado. La instalación, credenciales, almacenamiento persistente y conectividad corresponden a Despliegue. Antes de generar una CA, comprueba el motor predeterminado, los algoritmos publicados y que una firma de prueba funciona. La disponibilidad en tu instalación depende de su versión y configuración.",{"_3602":74610,"_30987":74577,"_21467":126641,"_5":14750,"_28174":126545,"_3058":126642},[],"Genera claves software y almacena el material privado en archivos. Su custodia depende de permisos, almacenamiento y copias de seguridad de la instalación. Antes de utilizarlo para una CA operativa, acuerda cómo se recuperará la clave y cómo accederán a ella las réplicas; el registro del KMS no sustituye esos archivos.",{"_3602":74611,"_30987":74577,"_21467":126644,"_5":14750,"_28174":126548,"_3058":126645},[],"El adaptador utiliza almacenamiento KV para el material privado. No equivale a una operación de firma dentro de Vault Transit: quien pueda leer el secreto puede recuperar la clave. Revisa los permisos de lectura, disponibilidad y recuperación con el responsable de Despliegue.",{"_3602":74612,"_30987":74577,"_21467":126647,"_5":14750,"_28174":126548,"_3058":126648},[],"El adaptador se comunica con Vault a través de su endpoint HTTP(S) configurado. El certificado del servidor de Vault se verifica contra el almacén de confianza del sistema; para confiar en un Vault con certificado emitido por una CA privada, añade ese certificado de CA al `ca_cert_file` del motor (codificado en PEM). `insecure_skip_verify=true` desactiva la verificación y es un último recurso; acuerda los ajustes de transporte con el responsable de Despliegue.",{"_3602":74613,"_30987":74577,"_21467":126650,"_5":14750,"_28174":126551,"_3058":126651},[],"Ofrece persistencia cifrada en AWS con coste asociado. Protege la clave en reposo, pero un administrador autorizado puede recuperarla; no proporciona la misma resistencia a la extracción que un KMS o HSM.",{"_3602":74614,"_30987":74577,"_21467":126653,"_5":14750,"_28174":126554,"_3058":126654},[],"Delega las firmas en el servicio AWS KMS. El adaptador también contempla importación de material externo, sujeta a las capacidades y permisos del proveedor. Una clave generada fuera del servicio ya ha existido fuera de su custodia; importarla no elimina esas copias. Comprueba generación, importación y firma como operaciones distintas.",{"_3602":74615,"_30987":74577,"_21467":126656,"_5":14750,"_28174":126557,"_3058":126657},[],"Permite integrar HSMs locales, entornos aislados y servicios *Key as a Service*. La generación, persistencia y resistencia a la extracción dependen del dispositivo o proveedor concreto. Es la opción más flexible cuando la política exige custodia hardware.",{"_3602":74616,"_30987":74577,"_21467":126659,"_5":14750,"_28174":126560,"_3058":126660},[],"El backend también dispone de adaptadores para **Key Vault Keys** y **Key Vault Secrets**. El primero delega firmas al servicio de claves; el segundo conserva material privado como secretos y firma con ese material. No intercambies ambos modelos de custodia. Confirma qué adaptador está habilitado en tu instalación y prueba las operaciones necesarias.",{"_3602":74617,"_30987":74577,"_21467":126662,"_5":14750,"_28174":126560,"_3058":126663},[],"Lamassu muestra en la consola el listado de motores habilitados.",{"_3602":74618,"_30987":74577,"_21467":126665,"_5":14750,"_28174":126560,"_3058":126666},[],"Cada motor define qué algoritmos soporta, como RSA o ECC/ECDSA, y qué tamaños de clave puede generar.",{"_3602":74619,"_30987":74577,"_21467":126668,"_5":14750,"_28174":126560,"_3058":126669},[],"Revisa con el operador de Despliegue qué motor está definido como predeterminado. Ese motor se utilizará cuando un proceso necesite crear o persistir una clave y el usuario no haya seleccionado uno específico, por ejemplo al crear o importar una CA.",{"_3602":74620,"_30987":74577,"_21467":126671,"_5":14750,"_28174":126563,"_3058":126672},[],"La pantalla principal de KMS muestra el inventario completo de claves registradas en el sistema. Es la vista de referencia para revisar qué claves existen, dónde están custodiadas y con qué entidades están relacionadas.",{"_3602":74621,"_30987":74577,"_21467":126674,"_5":14750,"_28174":126563,"_3058":126675},[],"La tabla incluye los siguientes campos:",{"_3602":74622,"_30987":74577,"_21467":126677,"_5":14750,"_28174":126563,"_3058":126678},[],"**Name**: nombre descriptivo de la clave.",{"_3602":74623,"_30987":74577,"_21467":126680,"_5":14750,"_28174":126563,"_3058":126681},[],"**Type**: algoritmo y tamaño de clave, por ejemplo RSA 2048 o EC P-256.",{"_3602":74624,"_30987":74577,"_21467":126683,"_5":14750,"_28174":126563,"_3058":126684},[],"**Strength**: indicador visual de fortaleza criptográfica.",{"_3602":74625,"_30987":74577,"_21467":126686,"_5":14750,"_28174":126563,"_3058":126687},[],"**Public/Private**: indica si Lamassu gestiona el par completo o solo la clave pública.",{"_3602":74626,"_30987":74577,"_21467":126689,"_5":14750,"_28174":126563,"_3058":126690},[],"**Crypto Engine**: motor criptográfico que custodia la clave.",{"_3602":74627,"_30987":74577,"_21467":126692,"_5":14750,"_28174":126563,"_3058":126693},[],"**Aliases**: nombres alternativos asociados a la clave.",{"_3602":74628,"_30987":74577,"_21467":126695,"_5":14750,"_28174":126563,"_3058":126696},[],"**Tags**: etiquetas para clasificación y búsqueda.",{"_3602":74629,"_30987":74577,"_21467":126698,"_5":14750,"_28174":126563,"_3058":126699},[],"**Related Entities**: certificados u otras entidades vinculadas a esa clave.",{"_3602":74630,"_30987":74577,"_21467":126701,"_5":14750,"_28174":126563,"_3058":126702},[],"Desde esta vista también se accede a las acciones más habituales:",{"_3602":74631,"_30987":74577,"_21467":126704,"_5":14750,"_28174":126563,"_3058":126705},[],"**View Details** para consultar metadatos, identificadores y relaciones.",{"_3602":74632,"_30987":74577,"_21467":126707,"_5":14750,"_28174":126563,"_3058":126708},[],"**Generate CSR** para crear una solicitud PKCS#10 con la clave seleccionada.",{"_3602":74633,"_30987":74577,"_21467":126710,"_5":14750,"_28174":126563,"_3058":126711},[],"**Sign / Verify** para probar operaciones criptográficas sobre la clave.",{"_3602":74634,"_30987":74577,"_21467":126713,"_5":14750,"_28174":126563,"_3058":126714},[],"**Delete Key** para eliminar la clave del sistema.",{"_3602":74635,"_30987":74577,"_21467":126716,"_5":14750,"_28174":126567,"_3058":126717},[],"Necesitas permisos de administración de claves y un motor accesible. El perfil de emisión debe admitir el algoritmo que eliges si la clave va a utilizarse en una CA o CSR. Abre **Create New Key** y elige generación o importación.",{"_3602":74636,"_30987":74577,"_21467":126719,"_5":14750,"_28174":126571,"_3058":126720},[],"Si la clave va a nacer dentro de Lamassu, el flujo recomendado es generar un nuevo par gestionado directamente por uno de los motores configurados.",{"_3602":74637,"_30987":74577,"_21467":126722,"_5":14750,"_28174":126571,"_3058":126723},[],"En la primera pantalla del asistente, elige **Generate New Key Pair** y después define los parámetros principales:",{"_3602":74638,"_30987":74577,"_21467":126725,"_5":14750,"_28174":126571,"_3058":126726},[],"**Key Name**: nombre único y descriptivo.",{"_3602":74639,"_30987":74577,"_21467":126728,"_5":14750,"_28174":126571,"_3058":126729},[],"**Crypto Engine**: motor que custodiará la clave.",{"_3602":74640,"_30987":74577,"_21467":126731,"_5":14750,"_28174":126571,"_3058":126732},[],"**Key Type** y **Key Size**: algoritmo y tamaño o curva.",{"_3602":74641,"_30987":74577,"_21467":126734,"_5":14750,"_28174":126571,"_3058":126735},[],"**Tags**: metadatos para clasificar la clave.",{"_3602":74642,"_30987":74577,"_21467":126737,"_5":14750,"_28174":126571,"_3058":126738},[],"**Metadata**: información adicional para usos avanzados.",{"_3602":74643,"_30987":74577,"_21467":126740,"_5":14750,"_28174":126575,"_3058":126741},[],"La importación permite registrar en Lamassu una clave generada fuera de la plataforma. Es el flujo habitual en escenarios BYOK, migraciones o integración con material criptográfico que ya está en producción.",{"_3602":74644,"_30987":74577,"_21467":126743,"_5":14750,"_28174":126575,"_3058":126744},[],"Cuando tienes una clave privada exportable y el motor de destino admite su importación.",{"_3602":74645,"_30987":74577,"_21467":126746,"_5":14750,"_28174":126575,"_3058":126747},[],"Cuando se necesita migrar una PKI existente sin reemitir certificados.",{"_3602":74646,"_30987":74577,"_21467":126749,"_5":14750,"_28174":126575,"_3058":126750},[],"Cuando Lamassu debe operar con una raíz de confianza creada por un tercero.",{"_3602":74647,"_30987":74577,"_21467":126752,"_5":14750,"_28174":126575,"_3058":126753},[],"En el asistente, elige **Import Existing Key Pair** y completa los campos solicitados:",{"_3602":74648,"_30987":74577,"_21467":126755,"_5":14750,"_28174":126575,"_3058":126756},[],"**Key Name**: nombre descriptivo dentro de Lamassu IoT.",{"_3602":74649,"_30987":74577,"_21467":126758,"_5":14750,"_28174":126575,"_3058":126759},[],"**Crypto Engine**: motor que custodiará la clave importada.",{"_3602":74650,"_30987":74577,"_21467":126761,"_5":14750,"_28174":126575,"_3058":126762},[],"**Tags**: etiquetas para organización y búsqueda.",{"_3602":74651,"_30987":74577,"_21467":126764,"_5":14750,"_28174":126575,"_3058":126765},[],"**Metadata**: información adicional opcional.",{"_3602":74652,"_30987":74577,"_21467":126767,"_5":14750,"_28174":126575,"_3058":126768},[],"**Private Key (PEM)**: clave privada en formato PEM.",{"_3602":74653,"_30987":74577,"_21467":126770,"_5":14750,"_28174":126575,"_3058":126771},[],"Si la importación termina correctamente, abre el registro, comprueba motor y clave pública y realiza una firma de prueba. Una clave no exportable en un HSM no puede cargarse mediante este formulario PEM: configura el acceso al motor y comprueba cómo se registra la clave existente. Revisa dependencias y recursos que puedan haberse creado en el proveedor si una operación falla a mitad.",{"_3602":74654,"_30987":74577,"_21467":126773,"_5":14750,"_28174":126579,"_3058":126774},[],"Cada clave registrada dispone de una vista de detalle y de varias acciones operativas.",{"_3602":74655,"_30987":74577,"_21467":126776,"_5":14750,"_28174":126583,"_3058":126777},[],"La pantalla **View Details** concentra la información técnica y administrativa de la clave.",{"_3602":74656,"_30987":74577,"_21467":126779,"_5":14750,"_28174":126583,"_3058":126780},[],"En la pestaña **Overview** se muestran, entre otros, estos campos:",{"_3602":74657,"_30987":74577,"_21467":126782,"_5":14750,"_28174":126583,"_3058":126783},[],"**Key Name**: nombre descriptivo.",{"_3602":74658,"_30987":74577,"_21467":126785,"_5":14750,"_28174":126583,"_3058":126786},[],"**Key Identifier**: identificador único del sistema. Lamassu utiliza formatos de ID basados en PKCS11.",{"_3602":74659,"_30987":74577,"_21467":126788,"_5":14750,"_28174":126583,"_3058":126789},[],"**Tags**: etiquetas asociadas.",{"_3602":74660,"_30987":74577,"_21467":126791,"_5":14750,"_28174":126583,"_3058":126792},[],"**Aliases**: nombres alternativos.",{"_3602":74661,"_30987":74577,"_21467":126794,"_5":14750,"_28174":126583,"_3058":126795},[],"**Crypto Engine**: motor en el que reside la clave.",{"_3602":74662,"_30987":74577,"_21467":126797,"_5":14750,"_28174":126583,"_3058":126798},[],"**Algorithm, Key Size & Strength**: algoritmo, parámetros y nivel de fortaleza.",{"_3602":74663,"_30987":74577,"_21467":126800,"_5":14750,"_28174":126583,"_3058":126801},[],"La sección **Related Entities** muestra qué objetos de Lamassu dependen de esa clave.",{"_3602":74664,"_30987":74577,"_21467":126803,"_5":14750,"_28174":126583,"_3058":126804},[],"La pestaña **Public Key** muestra el material público en PEM. El identificador y la URI del registro sirven para localizar la clave; una URI con formato PKCS#11 no demuestra que el motor sea un HSM ni que exista un módulo local para acceder a ella.",{"_3602":74665,"_30987":74577,"_21467":126806,"_5":14750,"_28174":126587,"_3058":126807},[],"La acción **Sign / Verify** sirve para validar que la clave y el motor criptográfico funcionan correctamente.",{"_3602":74666,"_30987":74577,"_21467":126809,"_5":14750,"_28174":126587,"_3058":126810},[],"Firma un mensaje de prueba, guarda la firma y verifícala con la misma clave pública, algoritmo y codificación. Cambia después el mensaje: la verificación debe fallar. Esto comprueba una operación concreta; no certifica todas las capacidades del motor ni la cadena de una CA.",{"_3602":74667,"_30987":74577,"_21467":126812,"_5":14750,"_28174":126587,"_3058":126813},[],"Al abrirla aparecen dos áreas: **Sign** y **Verify**.",{"_3602":74668,"_30987":74577,"_21467":126815,"_5":14750,"_28174":126591,"_3058":126816},[],"Esta pestaña usa la clave privada para generar una firma digital sobre un mensaje o sobre un *digest* ya calculado.",{"_3602":74669,"_30987":74577,"_21467":126818,"_5":14750,"_28174":126591,"_3058":126819},[],"Campos principales:",{"_3602":74670,"_30987":74577,"_21467":126821,"_5":14750,"_28174":126591,"_3058":126822},[],"**Algorithm**: algoritmo de firma disponible para el tipo de clave.",{"_3602":74671,"_30987":74577,"_21467":126824,"_5":14750,"_28174":126591,"_3058":126825},[],"**Message Type**: `Raw` para datos en claro o `Digest` para un hash precalculado.",{"_3602":74672,"_30987":74577,"_21467":126827,"_5":14750,"_28174":126591,"_3058":126828},[],"**Payload Encoding**: codificación de entrada, como UTF-8, Hex o Base64.",{"_3602":74673,"_30987":74577,"_21467":126830,"_5":14750,"_28174":126591,"_3058":126831},[],"**Message**: contenido que se va a firmar.",{"_3602":74674,"_30987":74577,"_21467":126833,"_5":14750,"_28174":126591,"_3058":126834},[],"**Signature**: resultado de la operación, mostrado en hexadecimal.",{"_3602":74675,"_30987":74577,"_21467":126836,"_5":14750,"_28174":126594,"_3058":126837},[],"Esta pestaña comprueba si una firma corresponde a la clave pública asociada.",{"_3602":74676,"_30987":74577,"_21467":126839,"_5":14750,"_28174":126594,"_3058":126819},[],{"_3602":74677,"_30987":74577,"_21467":126841,"_5":14750,"_28174":126594,"_3058":126842},[],"**Algorithm**: debe coincidir con el algoritmo usado para la firma.",{"_3602":74678,"_30987":74577,"_21467":126844,"_5":14750,"_28174":126594,"_3058":126845},[],"**Message Type**: `Raw` o `Digest`.",{"_3602":74679,"_30987":74577,"_21467":126847,"_5":14750,"_28174":126594,"_3058":126848},[],"**Payload Encoding**: codificación del mensaje.",{"_3602":74680,"_30987":74577,"_21467":126850,"_5":14750,"_28174":126594,"_3058":126851},[],"**Message**: mensaje original o hash.",{"_3602":74681,"_30987":74577,"_21467":126853,"_5":14750,"_28174":126594,"_3058":126854},[],"**Signature**: firma que se desea comprobar.",{"_3602":74682,"_30987":74577,"_21467":126856,"_5":14750,"_28174":126594,"_3058":126857},[],"**Result**: indicador del resultado de la validación.",{"_3602":74683,"_30987":74577,"_21467":126859,"_5":14750,"_28174":126597,"_3058":126860},[],"La acción **Generate CSR** crea una solicitud PKCS#10 firmada con la clave privada custodiada en Lamassu, sin exponerla fuera del motor criptográfico.",{"_3602":74684,"_30987":74577,"_21467":126862,"_5":14750,"_28174":126597,"_3058":126863},[],"Este flujo es útil para:",{"_3602":74685,"_30987":74577,"_21467":126865,"_5":14750,"_28174":126597,"_3058":126866},[],"Solicitar certificados a una CA externa.",{"_3602":74686,"_30987":74577,"_21467":126868,"_5":14750,"_28174":126597,"_3058":126869},[],"Renovar una identidad manteniendo la misma clave.",{"_3602":74687,"_30987":74577,"_21467":126871,"_5":14750,"_28174":126597,"_3058":126872},[],"Al abrir el formulario se solicitan los datos del sujeto y los atributos principales del certificado:",{"_3602":74688,"_30987":74577,"_21467":126874,"_5":14750,"_28174":126597,"_3058":126875},[],"**Common Name (CN)**: nombre principal de la identidad.",{"_3602":74689,"_30987":74577,"_21467":126877,"_5":14750,"_28174":126597,"_3058":126878},[],"**Organization (O)**: organización o empresa.",{"_3602":74690,"_30987":74577,"_21467":126880,"_5":14750,"_28174":126597,"_3058":126881},[],"**Organizational Unit (OU)**: departamento o unidad.",{"_3602":74691,"_30987":74577,"_21467":126883,"_5":14750,"_28174":126597,"_3058":126884},[],"**Country (C)**: código de país de dos letras.",{"_3602":74692,"_30987":74577,"_21467":126886,"_5":14750,"_28174":126597,"_3058":126887},[],"**State / Province (ST)**: estado o provincia.",{"_3602":74693,"_30987":74577,"_21467":126889,"_5":14750,"_28174":126597,"_3058":126890},[],"**Locality (L)**: ciudad o localidad.",{"_3602":74694,"_30987":74577,"_21467":126892,"_5":14750,"_28174":126597,"_3058":126893},[],"**Email Address**: correo de contacto.",{"_3602":74695,"_30987":74577,"_21467":126895,"_5":14750,"_28174":126597,"_3058":126896},[],"**Subject Alternative Names (SANs)**: nombres o identificadores alternativos, como DNS o IP.",{"_3602":74696,"_30987":74577,"_21467":126898,"_5":14750,"_28174":126597,"_3058":126899},[],"Descarga la CSR y ejecuta `openssl req -in request.csr -noout -verify -text`. Comprueba firma, sujeto y SAN antes de enviarla. La CSR no determina por sí sola el certificado final: la política de emisión puede sustituir sus campos.",{"_3602":74697,"_30987":74577,"_21467":126901,"_5":14750,"_28174":126601,"_3058":126902},[],"Lamassu también ofrece una ayuda específica para integraciones locales mediante **Sign locally with OpenSSL & PKCS11 tools**.",{"_3602":74698,"_30987":74577,"_21467":126904,"_5":14750,"_28174":126601,"_3058":126905},[],"Requiere el módulo, token y permisos del proveedor correspondiente. Comprueba que el identificador de Lamassu se corresponde con el objeto accesible desde ese módulo. La configuración del módulo pertenece al entorno del cliente o al Despliegue.",{"_3602":74699,"_30987":74577,"_21467":126907,"_5":14750,"_28174":126605,"_3058":126908},[],"Revisa **Related Entities** y localiza CAs, certificados y procesos de validación que siguen necesitando firmas. Revocar una CA no elimina la necesidad de publicar estado durante su periodo de retención. Eliminar una clave tampoco revoca automáticamente sus certificados. Planifica sustitución y retención antes de usar **Delete Key**; el efecto de borrado en el proveedor depende del motor.",{"_3602":74700,"_30987":74577,"_21467":126910,"_5":14750,"_28174":126605,"_3058":126911},[],"El KMS se niega a eliminar una clave que todavía está referenciada por certificados, con `409` `key is in use`. Revocar un certificado o dejar que caduque no libera su referencia a la clave. Eliminar una CA libera las referencias de su propio certificado actual y de sus certificados reemitidos vinculados, que se conservan para respaldar la CRL y OCSP, y después intenta eliminar la clave. Si otros certificados todavía la referencian, como los de otra CA que la comparte, el KMS la conserva. Los certificados emitidos por la CA conservan sus propias referencias a claves, incluso revocados. La API solo permite eliminar uno de ellos cuando su CA emisora ya no existe, y eliminarlo lo quita de la CRL y de las respuestas OCSP, así que conserva los certificados revocados durante su periodo de retención y elimina solo los caducados o sustituidos. El KMS también se niega a eliminar una clave que firma la CRL de una CA cuyos ajustes de CRL siguen `ACTIVE`, con el mismo `409` `key is in use`; esa referencia se libera cuando los ajustes se finalizan, después de que la CA se revoca de forma permanente o caduca (consulta CRL). La guía de actualización describe las referencias heredadas que conserva la migración.",{"_3602":74701,"_30987":74701,"_5":15110,"_3058":126913,"_31325":126914,"_21467":126915,"_28174":74701},"Validación online con OCSP",[50623,121012,56298,125669],[],{"_3602":74702,"_30987":74701,"_21467":126917,"_5":14750,"_28174":74701,"_3058":126918},[],"Consulta el estado firmado y verifica la respuesta del respondedor.",{"_3602":74703,"_30987":74701,"_5":31322,"_21467":126920,"_28174":126921,"_3058":126922},[],"/docs/es/platform/pki/ocsp#cómo-funciona-el-respondedor-en-lamassu","Cómo funciona el respondedor en Lamassu",{"_3602":74704,"_30987":74701,"_5":31322,"_21467":126924,"_28174":126925,"_3058":126926},[],"/docs/es/platform/pki/ocsp#enlace-en-los-certificados-emitidos","Enlace en los certificados emitidos",{"_3602":74705,"_30987":74701,"_5":31322,"_21467":126928,"_28174":126929,"_3058":126930},[],"/docs/es/platform/pki/ocsp#endpoints-http","Endpoints HTTP",{"_3602":74706,"_30987":74701,"_5":31322,"_21467":126932,"_28174":126933,"_3058":126934},[],"/docs/es/platform/pki/ocsp#genera-y-verifica-una-consulta","Genera y verifica una consulta",{"_3602":74707,"_30987":74701,"_5":31322,"_21467":126936,"_28174":126937,"_3058":126938},[],"/docs/es/platform/pki/ocsp#comprobación-desde-la-interfaz","Comprobación desde la interfaz",{"_3602":74708,"_30987":74701,"_5":31322,"_21467":126940,"_28174":126941,"_3058":126232},[],"/docs/es/platform/pki/ocsp#referencias",{"_3602":74709,"_30987":74701,"_21467":126943,"_5":14750,"_28174":74701,"_3058":126944},[],"OCSP permite consultar el estado de un certificado y obtener una respuesta firmada. Esta guía sirve al integrador que necesita comprobar qué publica Lamassu y cómo debe verificarlo el consumidor. Para la validación completa de una identidad, sigue Validación de certificados.",{"_3602":74710,"_30987":74701,"_21467":126946,"_5":14750,"_28174":126921,"_3058":126947},[],"El respondedor obtiene el certificado por número de serie y localiza su CA emisora en el inventario. Traduce el estado persistido así:",{"_3602":74711,"_30987":74701,"_21467":126949,"_5":14750,"_28174":126921,"_3058":126950},[],"Estado del registro",{"_3602":74712,"_30987":74701,"_21467":126952,"_5":14750,"_28174":126921,"_3058":126953},[],"Respuesta firmada",{"_3602":74713,"_30987":74701,"_21467":126955,"_5":14750,"_28174":126921,"_3058":55435},[],{"_3602":74714,"_30987":74701,"_21467":126957,"_5":14750,"_28174":126921,"_3058":58260},[],{"_3602":74715,"_30987":74701,"_21467":126959,"_5":14750,"_28174":126921,"_3058":55452},[],{"_3602":74716,"_30987":74701,"_21467":126961,"_5":14750,"_28174":126921,"_3058":126962},[],"`Revoked`, con razón y fecha de revocación.",{"_3602":74717,"_30987":74701,"_21467":126964,"_5":14750,"_28174":126921,"_3058":126965},[],"Otros estados, incluidos `INACTIVE` y `EXPIRED`",{"_3602":74718,"_30987":74701,"_21467":126967,"_5":14750,"_28174":126921,"_3058":126968},[],"`Unknown` si puede obtener el certificado y su emisor.",{"_3602":74719,"_30987":74701,"_21467":126970,"_5":14750,"_28174":126921,"_3058":126971},[],"Un número de serie ausente provoca un error de búsqueda; no garantiza una respuesta firmada `Unknown`. Los errores de búsqueda o firma se devuelven como fallo HTTP. Trata ese fallo como falta de evidencia, según la política del consumidor.",{"_3602":74720,"_30987":74701,"_21467":126973,"_5":14750,"_28174":126921,"_3058":126974},[],"La propia CA emisora firma la respuesta mediante su clave asociada al KMS. No se utiliza un certificado delegado de firma OCSP. Una CA importada sin clave utilizable no puede firmar respuestas.",{"_3602":74721,"_30987":74701,"_21467":126976,"_5":14750,"_28174":126921,"_3058":126977},[],"La implementación establece `thisUpdate` aproximadamente un día antes de generar la respuesta y `nextUpdate` un día después: la ventana declarada es de unas 48 horas. Inspecciona los valores recibidos y aplica tu política de vigencia. La respuesta refleja el estado almacenado al consultarla; una copia anterior en caché no cambia al revocar.",{"_3602":74722,"_30987":74701,"_21467":126979,"_5":14750,"_28174":126925,"_3058":126980},[],"El firmador construye las URLs OCSP a partir de los dominios VA configurados y las añade a AIA. Si no hay dominios, no hay URL que añadir; un certificado importado conserva sus extensiones originales. Revisa el certificado real:",{"_3602":74723,"_30987":74701,"_21467":126982,"_5":14750,"_28174":126925,"_3058":126983},[],"Comprueba que esa URL es accesible desde el consumidor. DNS, exposición del endpoint y configuración de dominios pertenecen a Despliegue. Cambiar esa configuración no modifica certificados ya firmados.",{"_3602":74724,"_30987":74701,"_21467":126985,"_5":14750,"_28174":126929,"_3058":126986},[],"El servicio acepta:",{"_3602":74725,"_30987":74701,"_21467":126988,"_5":14750,"_28174":126929,"_3058":122875},[],{"_3602":74726,"_30987":74701,"_21467":126990,"_5":14750,"_28174":126929,"_3058":126991},[],"Ruta del servicio VA",{"_3602":74727,"_30987":74701,"_21467":126993,"_5":14750,"_28174":126929,"_3058":126994},[],"Formato",{"_3602":74728,"_30987":74701,"_21467":126996,"_5":14750,"_28174":126929,"_3058":58300},[],{"_3602":74729,"_30987":74701,"_21467":126998,"_5":14750,"_28174":126929,"_3058":58303},[],{"_3602":74730,"_30987":74701,"_21467":127000,"_5":14750,"_28174":126929,"_3058":127001},[],"Solicitud DER, `Content-Type: application/ocsp-request`.",{"_3602":74731,"_30987":74701,"_21467":127003,"_5":14750,"_28174":126929,"_3058":57695},[],{"_3602":74732,"_30987":74701,"_21467":127005,"_5":14750,"_28174":126929,"_3058":58311},[],{"_3602":74733,"_30987":74701,"_21467":127007,"_5":14750,"_28174":126929,"_3058":127008},[],"Solicitud DER codificada en Base64 URL con padding.",{"_3602":74734,"_30987":74701,"_21467":127010,"_5":14750,"_28174":126929,"_3058":127011},[],"Utiliza POST para evitar diferencias de codificación entre clientes. La respuesta correcta tiene `Content-Type: application/ocsp-response` y cuerpo DER. El prefijo público depende del Gateway; utiliza la URL publicada en el certificado y comprobada por el operador.",{"_3602":74735,"_30987":74701,"_21467":127013,"_5":14750,"_28174":126933,"_3058":127014},[],"Necesitas OpenSSL 3.x, `device.crt`, el certificado de su emisor directo `issuer.pem` y las raíces confiables del consumidor en `roots.pem`. Si el emisor es intermedio, prepara además `intermediates.pem` con las CAs intermedias.",{"_3602":74736,"_30987":74701,"_21467":127016,"_5":14750,"_28174":126933,"_3058":127017},[],"Genera la solicitud:",{"_3602":74737,"_30987":74701,"_21467":127019,"_5":14750,"_28174":126933,"_3058":127020},[],"Este ejemplo omite el nonce porque el respondedor no lo devuelve. La verificación depende de firma, correspondencia de la respuesta y tiempos; no demuestra frescura mediante un nonce.",{"_3602":74738,"_30987":74701,"_21467":127022,"_5":14750,"_28174":126933,"_3058":127023},[],"Sustituye la URL de ejemplo por el endpoint inspeccionado:",{"_3602":74739,"_30987":74701,"_21467":127025,"_5":14750,"_28174":126933,"_3058":127026},[],"Verifica el DER recibido:",{"_3602":74740,"_30987":74701,"_21467":127028,"_5":14750,"_28174":126933,"_3058":127029},[],"Si hay intermedias, añade `-verify_other intermediates.pem`. Exige verificación correcta de la respuesta y comprueba el estado correspondiente a `device.crt`, emisor, serie, `thisUpdate` y `nextUpdate`. Un resultado `Response verify OK` solo valida la respuesta: también debes observar `good`, `revoked` o `unknown`. No aceptes una identidad basándote únicamente en el código de salida del comando.",{"_3602":74741,"_30987":74701,"_21467":127031,"_5":14750,"_28174":126937,"_3058":127032},[],"**OCSP Check** permite observar lo que responde Lamassu para un certificado seleccionado. Completa la comprobación desde la red y el almacén de confianza del consumidor: la consulta de la consola no prueba su configuración de validación.",{"_3602":74742,"_30987":74701,"_21467":127034,"_5":14750,"_28174":126937,"_3058":127035},[],"Para comprobar un cambio, guarda una respuesta anterior, revoca un certificado de prueba y solicita otra. La consulta nueva debe reflejar el estado persistido; compara los tiempos para descartar reutilización de una respuesta anterior. Si falla, sigue Diagnóstico PKI.",{"_3602":74743,"_30987":74701,"_21467":127037,"_5":14750,"_28174":126941,"_3058":58344},[],{"_3602":74744,"_30987":74701,"_21467":127039,"_5":14750,"_28174":126941,"_3058":58347},[],{"_3602":74745,"_30987":74701,"_21467":127041,"_5":14750,"_28174":126941,"_3058":127042},[],"<Card title=\"Servicio CRL\" href=\"/docs/platform/pki/crl\" />",{"_3602":74746,"_30987":74701,"_21467":127044,"_5":14750,"_28174":126941,"_3058":126527},[],{"_3602":74747,"_30987":74747,"_5":15110,"_3058":56298,"_31325":127046,"_21467":127047,"_28174":74747},[50623,121012,56298],[],{"_3602":74748,"_30987":74747,"_21467":127049,"_5":14750,"_28174":74747,"_3058":127050},[],"Administra claves y autoridades, define la emisión y verifica los certificados resultantes.",{"_3602":74749,"_30987":74747,"_5":31322,"_21467":127052,"_28174":127053,"_3058":124349},[],"/docs/es/platform/pki/overview#empieza-aquí",{"_3602":74750,"_30987":74747,"_5":31322,"_21467":127055,"_28174":127056,"_3058":127057},[],"/docs/es/platform/pki/overview#qué-necesitas","Qué necesitas",{"_3602":74751,"_30987":74747,"_5":31322,"_21467":127059,"_28174":127060,"_3058":124869},[],"/docs/es/platform/pki/overview#capacidades-principales",{"_3602":74752,"_30987":74747,"_5":31322,"_21467":127062,"_28174":127063,"_3058":124873},[],"/docs/es/platform/pki/overview#construye-tu-jerarquía-de-confianza",{"_3602":74753,"_30987":74747,"_5":31322,"_21467":127065,"_28174":127066,"_3058":124877},[],"/docs/es/platform/pki/overview#protege-las-claves-criptográficas",{"_3602":74754,"_30987":74747,"_5":31322,"_21467":127068,"_28174":127069,"_3058":124881},[],"/docs/es/platform/pki/overview#emite-y-controla-certificados",{"_3602":74755,"_30987":74747,"_5":31322,"_21467":127071,"_28174":127072,"_3058":124889},[],"/docs/es/platform/pki/overview#publica-el-estado-de-validación",{"_3602":74756,"_30987":74747,"_5":31322,"_21467":127074,"_28174":127075,"_3058":127076},[],"/docs/es/platform/pki/overview#cómo-comprobar-el-resultado","Cómo comprobar el resultado",{"_3602":74757,"_30987":74747,"_5":31322,"_21467":127078,"_28174":127079,"_3058":125835},[],"/docs/es/platform/pki/overview#continúa",{"_3602":74758,"_30987":74747,"_21467":127081,"_5":14750,"_28174":74747,"_3058":127082},[],"El bloque PKI explica cómo construir y operar la confianza X.509 de Lamassu: qué autoridades emiten, qué reglas aplican y cómo se comprueban los certificados. Está dirigido al administrador PKI y a quien necesita utilizar certificados en un sistema consumidor.",{"_3602":74759,"_30987":74747,"_21467":127084,"_5":14750,"_28174":127053,"_3058":127085},[],"Sigue Primeros pasos de PKI para crear una CA, emitir un certificado de cliente y verificarlo con OpenSSL. El resultado es un certificado, su clave privada y una cadena comprobada.",{"_3602":74760,"_30987":74747,"_21467":127087,"_5":14750,"_28174":127053,"_3058":127088},[],"Puedes completar ese recorrido antes de gestionar dispositivos. Cuando necesites asociar la identidad a un inventario o automatizar su enrolamiento, continúa en IoT Fleets.",{"_3602":74761,"_30987":74747,"_21467":127090,"_5":14750,"_28174":127056,"_3058":127091},[],"Una instancia accesible y permisos para gestionar las claves, CAs y certificados que usarás.",{"_3602":74762,"_30987":74747,"_21467":127093,"_5":14750,"_28174":127056,"_3058":127094},[],"Un motor criptográfico disponible para custodiar la clave de la autoridad.",{"_3602":74763,"_30987":74747,"_21467":127096,"_5":14750,"_28174":127056,"_3058":127097},[],"El propósito del certificado: por ejemplo, autenticar un cliente mediante mTLS.",{"_3602":74764,"_30987":74747,"_21467":127099,"_5":14750,"_28174":127056,"_3058":127100},[],"Los requisitos del consumidor: emisores aceptados, algoritmos, nombres y usos permitidos.",{"_3602":74765,"_30987":74747,"_21467":127102,"_5":14750,"_28174":127056,"_3058":127103},[],"La configuración de la instancia y del proveedor criptográfico se prepara en Despliegue. La elección de jerarquía se explica en el modelo de confianza.",{"_3602":74766,"_30987":74747,"_21467":127105,"_5":14750,"_28174":127063,"_3058":127106},[],"Las autoridades firman certificados. Una raíz establece el ancla de confianza y una intermedia permite separar la emisión por entorno o propósito. La jerarquía y rotación explica cómo mantener esa confianza al sustituir una autoridad.",{"_3602":74767,"_30987":74747,"_21467":127108,"_5":14750,"_28174":127066,"_3058":127109},[],"Las claves de firma de las CAs se gestionan mediante KMS y motores criptográficos. La clave de un cliente que genera una CSR puede permanecer en ese cliente: conserva su custodia al elegir el método de emisión.",{"_3602":74768,"_30987":74747,"_21467":127111,"_5":14750,"_28174":127069,"_3058":127112},[],"Un perfil establece restricciones de sujeto, validez, usos y claves. La CA aplica la configuración de emisión y firma el certificado. En el inventario puedes inspeccionar el resultado, descargarlo y gestionar su estado.",{"_3602":74769,"_30987":74747,"_21467":127114,"_5":14750,"_28174":127072,"_3058":127115},[],"La validación reúne cadena, vigencia, usos y estado de revocación. Lamassu publica estado mediante OCSP y CRL; el consumidor configura qué emisores reconoce y cómo comprueba ese estado.",{"_3602":74770,"_30987":74747,"_21467":127117,"_5":14750,"_28174":127075,"_3058":127118},[],"Un certificado activo en la consola es una parte de la comprobación. Revisa también que:",{"_3602":74771,"_30987":74747,"_21467":127120,"_5":14750,"_28174":127075,"_3058":127121},[],"su sujeto y sus extensiones identifiquen al cliente esperado;",{"_3602":74772,"_30987":74747,"_21467":127123,"_5":14750,"_28174":127075,"_3058":127124},[],"su clave pública corresponda a la clave privada del cliente;",{"_3602":74773,"_30987":74747,"_21467":127126,"_5":14750,"_28174":127075,"_3058":127127},[],"su cadena alcance una raíz confiable para el consumidor;",{"_3602":74774,"_30987":74747,"_21467":127129,"_5":14750,"_28174":127075,"_3058":127130},[],"sus fechas y usos permitan la operación;",{"_3602":74775,"_30987":74747,"_21467":127132,"_5":14750,"_28174":127075,"_3058":127133},[],"el consumidor aplique la comprobación de revocación y su autorización.",{"_3602":74776,"_30987":74747,"_21467":127135,"_5":14750,"_28174":127075,"_3058":127136},[],"El recorrido de emisión incluye las primeras comprobaciones independientes.",{"_3602":74777,"_30987":74747,"_21467":127138,"_5":14750,"_28174":127079,"_3058":127139},[],"<Card title=\"Primeros pasos de PKI\" description=\"Crea una CA y emite y verifica un certificado de cliente.\" href=\"/docs/platform/pki/quickstarts/overview\" />",{"_3602":74778,"_30987":74747,"_21467":127141,"_5":14750,"_28174":127079,"_3058":127142},[],"<Card title=\"Aplica la PKI a dispositivos\" description=\"Asocia certificados al inventario y prepara el enrolamiento.\" href=\"/docs/platform/iot-fleets/overview\" />",{"_3602":74779,"_30987":74747,"_21467":127144,"_5":14750,"_28174":127079,"_3058":127145},[],"<Card title=\"Diagnóstico PKI\" description=\"Comprueba emisión, OCSP y CRL cuando el resultado falla.\" href=\"/docs/platform/pki/troubleshooting\" />",{"_3602":74780,"_30987":74780,"_5":15110,"_3058":127147,"_31325":127148,"_21467":127149,"_28174":74780},"Crea tu primera CA",[50623,121012,56298,124473],[],{"_3602":74781,"_30987":74780,"_21467":127151,"_5":14750,"_28174":74780,"_3058":127152},[],"Crea una raíz de evaluación y comprueba su certificado antes de emitir.",{"_3602":74782,"_30987":74780,"_5":31322,"_21467":127154,"_28174":127155,"_3058":119546},[],"/docs/es/platform/pki/quickstarts/create-certificate-authority#antes-de-empezar",{"_3602":74783,"_30987":74780,"_5":31322,"_21467":127157,"_28174":127158,"_3058":127159},[],"/docs/es/platform/pki/quickstarts/create-certificate-authority#abre-el-asistente-de-creación-toc","Abre el asistente de creación [!toc]",{"_3602":74784,"_30987":74780,"_5":31322,"_21467":127161,"_28174":127162,"_3058":127163},[],"/docs/es/platform/pki/quickstarts/create-certificate-authority#selecciona-la-clave-toc","Selecciona la clave [!toc]",{"_3602":74785,"_30987":74780,"_5":31322,"_21467":127165,"_28174":127166,"_3058":127167},[],"/docs/es/platform/pki/quickstarts/create-certificate-authority#define-la-autoridad-toc","Define la autoridad [!toc]",{"_3602":74786,"_30987":74780,"_5":31322,"_21467":127169,"_28174":127170,"_3058":127171},[],"/docs/es/platform/pki/quickstarts/create-certificate-authority#revisa-y-crea-la-ca-toc","Revisa y crea la CA [!toc]",{"_3602":74787,"_30987":74780,"_5":31322,"_21467":127173,"_28174":127174,"_3058":127175},[],"/docs/es/platform/pki/quickstarts/create-certificate-authority#verifica-el-resultado-toc","Verifica el resultado [!toc]",{"_3602":74788,"_30987":74780,"_5":31322,"_21467":127177,"_28174":127178,"_3058":127179},[],"/docs/es/platform/pki/quickstarts/create-certificate-authority#comprueba-el-certificado-de-ca","Comprueba el certificado de CA",{"_3602":74789,"_30987":74780,"_5":31322,"_21467":127181,"_28174":127182,"_3058":124720},[],"/docs/es/platform/pki/quickstarts/create-certificate-authority#si-el-resultado-falla",{"_3602":74790,"_30987":74780,"_5":31322,"_21467":127184,"_28174":127185,"_3058":119570},[],"/docs/es/platform/pki/quickstarts/create-certificate-authority#siguiente-paso",{"_3602":74791,"_30987":74780,"_21467":127187,"_5":14750,"_28174":74780,"_3058":127188},[],"Crearás una autoridad raíz con una clave nueva custodiada por un motor de Lamassu. Al terminar tendrás una CA activa y su certificado público en `ca.pem`, preparado para verificar la emisión del siguiente recorrido.",{"_3602":74792,"_30987":74780,"_21467":127190,"_5":14750,"_28174":127155,"_3058":127191},[],"Acceso a la consola y permisos para crear claves y autoridades.",{"_3602":74793,"_30987":74780,"_21467":127193,"_5":14750,"_28174":127155,"_3058":127194},[],"Un motor criptográfico disponible que admita el algoritmo elegido.",{"_3602":74794,"_30987":74780,"_21467":127196,"_5":14750,"_28174":127155,"_3058":127197},[],"OpenSSL 3.x para comprobar el certificado descargado.",{"_3602":74795,"_30987":74780,"_21467":127199,"_5":14750,"_28174":127155,"_3058":127200},[],"Utiliza una instancia de evaluación o una autoridad destinada a estas pruebas. El ejemplo crea una raíz que emite directamente; para diseñar una jerarquía operativa, consulta Jerarquía y rotación.",{"_3602":74796,"_30987":74780,"_21467":127202,"_5":14750,"_28174":127158,"_3058":127203},[],"En **Certification Authorities**, selecciona **Create New CA** y elige crear una CA con un par de claves nuevo.",{"_3602":74797,"_30987":74780,"_21467":127205,"_5":14750,"_28174":127158,"_3058":127206},[],"El flujo &#x2A;*Create New CA (Existing Key)** se explica en la guía de autoridades.",{"_3602":74798,"_30987":74780,"_21467":127208,"_5":14750,"_28174":127162,"_3058":127209},[],"Elige el motor que custodiará la clave y un algoritmo permitido por sus capacidades. Para este ejemplo puedes utilizar **EC P-384** si está disponible.",{"_3602":74799,"_30987":74780,"_21467":127211,"_5":14750,"_28174":127162,"_3058":127212},[],"La clave privada de la CA se utiliza a través del motor. En este recorrido descargarás únicamente el certificado público de la autoridad.",{"_3602":74800,"_30987":74780,"_21467":127214,"_5":14750,"_28174":127166,"_3058":127215},[],"Selecciona **Root CA** y completa:",{"_3602":74801,"_30987":74780,"_21467":127217,"_5":14750,"_28174":127166,"_3058":58526},[],{"_3602":74802,"_30987":74780,"_21467":127219,"_5":14750,"_28174":127166,"_3058":127220},[],"**Subject**: los datos de organización y país de tu evaluación.",{"_3602":74803,"_30987":74780,"_21467":127222,"_5":14750,"_28174":127166,"_3058":127223},[],"**CA Certificate Expiration**: por ejemplo, un año desde la creación.",{"_3602":74804,"_30987":74780,"_21467":127225,"_5":14750,"_28174":127166,"_3058":127226},[],"**Default End-Entity Certificate Issuance Expiration**: por ejemplo, 90 días, dentro de la vigencia de la CA.",{"_3602":74805,"_30987":74780,"_21467":127228,"_5":14750,"_28174":127166,"_3058":127229},[],"El nombre de la CA se utilizará como `Common Name`. Mantén los usos de CA necesarios para firmar certificados y CRLs.",{"_3602":74806,"_30987":74780,"_21467":127231,"_5":14750,"_28174":127170,"_3058":127232},[],"Comprueba motor, algoritmo, sujeto, tipo raíz y fechas. Confirma la creación y anota el identificador de la autoridad para reconocerla en el DMS o en la API.",{"_3602":74807,"_30987":74780,"_21467":127234,"_5":14750,"_28174":127174,"_3058":127235},[],"Abre la nueva CA. Debe aparecer activa, mostrar su certificado y permitir acceder a **Issued Certificates**.",{"_3602":74808,"_30987":74780,"_21467":127237,"_5":14750,"_28174":127174,"_3058":127238},[],"Descarga o copia el certificado PEM de la autoridad y guárdalo como `ca.pem`. Comprueba que el archivo contiene el bloque completo, incluidos `BEGIN CERTIFICATE` y `END CERTIFICATE`.",{"_3602":74809,"_30987":74780,"_21467":127240,"_5":14750,"_28174":127178,"_3058":127241},[],"Ejecuta desde el directorio donde guardaste `ca.pem`:",{"_3602":74810,"_30987":74780,"_21467":127243,"_5":14750,"_28174":127178,"_3058":127244},[],"Comprueba que sujeto y emisor corresponden a la raíz creada, las fechas incluyen el momento actual, **Basic Constraints** contiene `CA:TRUE` y **Key Usage** permite firmar certificados. El último comando debe devolver `ca.pem: OK`.",{"_3602":74811,"_30987":74780,"_21467":127246,"_5":14750,"_28174":127178,"_3058":127247},[],"Has elegido explícitamente `ca.pem` como ancla de esta prueba. Que la autofirma sea válida no instala esa confianza en otros consumidores. Consulta la referencia de openssl-verify para las opciones de comprobación.",{"_3602":74812,"_30987":74780,"_21467":127249,"_5":14750,"_28174":127182,"_3058":127250},[],"Si la creación falla, comprueba permisos, disponibilidad del motor y algoritmo seleccionado.",{"_3602":74813,"_30987":74780,"_21467":127252,"_5":14750,"_28174":127182,"_3058":127253},[],"Si OpenSSL no lee el archivo, vuelve a copiar el bloque PEM completo.",{"_3602":74814,"_30987":74780,"_21467":127255,"_5":14750,"_28174":127182,"_3058":127256},[],"Si fallan la firma o las fechas, revisa que hayas descargado el certificado de esta CA y que el reloj del equipo sea correcto.",{"_3602":74815,"_30987":74780,"_21467":127258,"_5":14750,"_28174":127182,"_3058":127259},[],"El diagnóstico PKI reúne las comprobaciones de emisión y dependencias criptográficas.",{"_3602":74816,"_30987":74780,"_21467":127261,"_5":14750,"_28174":127185,"_3058":127262},[],"Continúa con Emite y verifica un certificado, utilizando esta autoridad y `ca.pem`.",{"_3602":74817,"_30987":74817,"_5":15110,"_3058":127264,"_31325":127265,"_21467":127266,"_28174":74817},"Emite y verifica un certificado",[50623,121012,56298,124473],[],{"_3602":74818,"_30987":74817,"_21467":127268,"_5":14750,"_28174":74817,"_3058":127269},[],"Emite un certificado de cliente y comprueba contenido, cadena y correspondencia de clave.",{"_3602":74819,"_30987":74817,"_5":31322,"_21467":127271,"_28174":127272,"_3058":119546},[],"/docs/es/platform/pki/quickstarts/issue-certificate#antes-de-empezar",{"_3602":74820,"_30987":74817,"_5":31322,"_21467":127274,"_28174":127275,"_3058":127276},[],"/docs/es/platform/pki/quickstarts/issue-certificate#inicia-la-emisión","Inicia la emisión",{"_3602":74821,"_30987":74817,"_5":31322,"_21467":127278,"_28174":127279,"_3058":127280},[],"/docs/es/platform/pki/quickstarts/issue-certificate#elige-el-método","Elige el método",{"_3602":74822,"_30987":74817,"_5":31322,"_21467":127282,"_28174":127283,"_3058":127284},[],"/docs/es/platform/pki/quickstarts/issue-certificate#identifica-el-certificado","Identifica el certificado",{"_3602":74823,"_30987":74817,"_5":31322,"_21467":127286,"_28174":127287,"_3058":127288},[],"/docs/es/platform/pki/quickstarts/issue-certificate#configura-clave-y-usos","Configura clave y usos",{"_3602":74824,"_30987":74817,"_5":31322,"_21467":127290,"_28174":127291,"_3058":127292},[],"/docs/es/platform/pki/quickstarts/issue-certificate#emite-y-descarga","Emite y descarga",{"_3602":74825,"_30987":74817,"_5":31322,"_21467":127294,"_28174":127295,"_3058":127296},[],"/docs/es/platform/pki/quickstarts/issue-certificate#verifica-el-resultado","Verifica el resultado",{"_3602":74826,"_30987":74817,"_5":31322,"_21467":127298,"_28174":127299,"_3058":127300},[],"/docs/es/platform/pki/quickstarts/issue-certificate#inspecciona-contenido-y-fechas","Inspecciona contenido y fechas",{"_3602":74827,"_30987":74817,"_5":31322,"_21467":127302,"_28174":127303,"_3058":127304},[],"/docs/es/platform/pki/quickstarts/issue-certificate#verifica-la-cadena","Verifica la cadena",{"_3602":74828,"_30987":74817,"_5":31322,"_21467":127306,"_28174":127307,"_3058":127308},[],"/docs/es/platform/pki/quickstarts/issue-certificate#comprueba-que-la-clave-corresponde","Comprueba que la clave corresponde",{"_3602":74829,"_30987":74817,"_5":31322,"_21467":127310,"_28174":127311,"_3058":124720},[],"/docs/es/platform/pki/quickstarts/issue-certificate#si-el-resultado-falla",{"_3602":74830,"_30987":74817,"_5":31322,"_21467":127313,"_28174":127314,"_3058":119570},[],"/docs/es/platform/pki/quickstarts/issue-certificate#siguiente-paso",{"_3602":74831,"_30987":74817,"_21467":127316,"_5":14750,"_28174":74817,"_3058":127317},[],"Emitirás un certificado final para `device-001` mediante el flujo de generación de clave y CSR en el navegador. Al terminar conservarás `device.crt`, `device.key` y el certificado público de la raíz emisora, `ca.pem`.",{"_3602":74832,"_30987":74817,"_21467":127319,"_5":14750,"_28174":127272,"_3058":127320},[],"Una CA raíz activa con clave de firma disponible y permisos para emitir. Si todavía no existe, sigue Crea tu primera CA.",{"_3602":74833,"_30987":74817,"_21467":127322,"_5":14750,"_28174":127272,"_3058":127323},[],"Su certificado público en `ca.pem`; este ejemplo utiliza la raíz creada en el recorrido anterior.",{"_3602":74834,"_30987":74817,"_21467":127325,"_5":14750,"_28174":127272,"_3058":127326},[],"OpenSSL 3.x y un directorio de trabajo con acceso restringido.",{"_3602":74835,"_30987":74817,"_21467":127328,"_5":14750,"_28174":127272,"_3058":127329},[],"Un identificador para el cliente: aquí usaremos `device-001`.",{"_3602":74836,"_30987":74817,"_21467":127331,"_5":14750,"_28174":127272,"_3058":127332},[],"En este flujo la clave del cliente se genera en el navegador y debes descargarla al finalizar. Si la pierdes, tendrás que generar una clave y emitir otro certificado. El inventario de certificados permite descargar el certificado público, pero no recuperar esta clave.",{"_3602":74837,"_30987":74817,"_21467":127334,"_5":14750,"_28174":127275,"_3058":127335},[],"Abre la CA del recorrido anterior, entra en **Issued Certificates** y selecciona **Issue New**.",{"_3602":74838,"_30987":74817,"_21467":127337,"_5":14750,"_28174":127279,"_3058":127338},[],"Selecciona **Generate Key & CSR in Browser** para seguir este ejemplo.",{"_3602":74839,"_30987":74817,"_21467":127340,"_5":14750,"_28174":127279,"_3058":127341},[],"Si la clave debe generarse y permanecer en el sistema de destino, utiliza **Upload Existing CSR**, descrito en la guía de autoridades.",{"_3602":74840,"_30987":74817,"_21467":127343,"_5":14750,"_28174":127283,"_3058":127344},[],"Introduce `device-001` como `Common Name`. Añade los datos de sujeto requeridos por tu política y SANs si el consumidor los utiliza para identificar al cliente.",{"_3602":74841,"_30987":74817,"_21467":127346,"_5":14750,"_28174":127283,"_3058":127347},[],"Si vas a continuar con el registro manual, el `Device ID` será exactamente `device-001`.",{"_3602":74842,"_30987":74817,"_21467":127349,"_5":14750,"_28174":127287,"_3058":127350},[],"Elige un algoritmo y tamaño admitidos por el perfil; por ejemplo, ECDSA P-256 si está permitido. Para este certificado de cliente, selecciona **Digital Signature** y **Client Authentication** y emite como certificado final.",{"_3602":74843,"_30987":74817,"_21467":127352,"_5":14750,"_28174":127287,"_3058":127353},[],"Solicita, por ejemplo, 30 días de validez, siempre dentro de la vigencia de la CA. Revisa el perfil de emisión si el contenido resultante difiere de lo solicitado.",{"_3602":74844,"_30987":74817,"_21467":127355,"_5":14750,"_28174":127291,"_3058":127356},[],"Confirma la emisión. Guarda el certificado PEM como `device.crt` y la clave privada como `device.key` en el directorio preparado.",{"_3602":74845,"_30987":74817,"_21467":127358,"_5":14750,"_28174":127295,"_3058":127359},[],"Comprueba en **Issued Certificates** que el certificado aparece activo. Anota su número de serie y verifica el material descargado con las comprobaciones siguientes.",{"_3602":74846,"_30987":74817,"_21467":127361,"_5":14750,"_28174":127299,"_3058":127362},[],"Comprueba `CN=device-001`, el emisor esperado, fechas vigentes, **Digital Signature** y el uso extendido **TLS Web Client Authentication**. Debe ser un certificado final: no debe declarar `CA:TRUE` ni habilitar **Certificate Sign**. Si **Basic Constraints** está presente, debe indicar `CA:FALSE`. Si solicitaste SANs, revisa que los identificadores esperados aparezcan en el certificado.",{"_3602":74847,"_30987":74817,"_21467":127364,"_5":14750,"_28174":127303,"_3058":127365},[],"El resultado esperado es `device.crt: OK`. Esta comprobación utiliza tu raíz explícita y evalúa la cadena, las fechas y la compatibilidad con el propósito de cliente TLS. La presencia de los usos y nombres esperados se comprueba también mediante la inspección anterior.",{"_3602":74848,"_30987":74817,"_21467":127367,"_5":14750,"_28174":127303,"_3058":127368},[],"Si utilizas una CA intermedia, la raíz confiable debe estar en `ca.pem` y debes aportar las intermedias mediante `-untrusted intermediates.pem`. Esta variante se desarrolla en el modelo de confianza.",{"_3602":74849,"_30987":74817,"_21467":127370,"_5":14750,"_28174":127303,"_3058":127371},[],"El comando no consulta OCSP ni CRL. Para comprobar revocación, continúa con Validación de certificados. Consulta la referencia de openssl-verify para sus opciones.",{"_3602":74850,"_30987":74817,"_21467":127373,"_5":14750,"_28174":127307,"_3058":127374},[],"En Bash, compara los dos resúmenes de clave pública:",{"_3602":74851,"_30987":74817,"_21467":127376,"_5":14750,"_28174":127307,"_3058":127377},[],"Ambos comandos deben terminar correctamente y mostrar el mismo resumen SHA-256. Si difieren, la clave privada no corresponde al certificado seleccionado. Vuelve a localizar la pareja correcta antes de instalarla.",{"_3602":74852,"_30987":74817,"_21467":127379,"_5":14750,"_28174":127307,"_3058":127380},[],"Las opciones utilizadas se recogen en openssl-x509 y openssl-pkey.",{"_3602":74853,"_30987":74817,"_21467":127382,"_5":14750,"_28174":127311,"_3058":124803},[],{"_3602":74854,"_30987":74817,"_21467":127384,"_5":14750,"_28174":127311,"_3058":123324},[],{"_3602":74855,"_30987":74817,"_21467":127386,"_5":14750,"_28174":127311,"_3058":127387},[],"La CA rechaza la emisión",{"_3602":74856,"_30987":74817,"_21467":127389,"_5":14750,"_28174":127311,"_3058":127390},[],"Permisos, estado y clave de la CA, algoritmo y perfil.",{"_3602":74857,"_30987":74817,"_21467":127392,"_5":14750,"_28174":127311,"_3058":127393},[],"Sujeto o usos diferentes",{"_3602":74858,"_30987":74817,"_21467":127395,"_5":14750,"_28174":127311,"_3058":127396},[],"Perfil aplicado y valores solicitados.",{"_3602":74859,"_30987":74817,"_21467":127398,"_5":14750,"_28174":127311,"_3058":127399},[],"No se encuentra el emisor",{"_3602":74860,"_30987":74817,"_21467":127401,"_5":14750,"_28174":127311,"_3058":127402},[],"CA descargada y cadena intermedia necesaria.",{"_3602":74861,"_30987":74817,"_21467":127404,"_5":14750,"_28174":127311,"_3058":127405},[],"Falla la vigencia",{"_3602":74862,"_30987":74817,"_21467":127407,"_5":14750,"_28174":127311,"_3058":127408},[],"Fechas del certificado y de la CA, y reloj del equipo.",{"_3602":74863,"_30987":74817,"_21467":127410,"_5":14750,"_28174":127311,"_3058":127411},[],"Los resúmenes de clave difieren",{"_3602":74864,"_30987":74817,"_21467":127413,"_5":14750,"_28174":127311,"_3058":127414},[],"Archivos de certificado y clave de la misma emisión.",{"_3602":74865,"_30987":74817,"_21467":127416,"_5":14750,"_28174":127311,"_3058":127417},[],"Consulta Diagnóstico PKI si necesitas acotar un fallo de emisión.",{"_3602":74866,"_30987":74817,"_21467":127419,"_5":14750,"_28174":127314,"_3058":127420},[],"Has completado el recorrido PKI cuando el certificado verifica y su clave corresponde. Elige cómo utilizarlo:",{"_3602":74867,"_30987":74817,"_21467":127422,"_5":14750,"_28174":127314,"_3058":127423},[],"Gestionar certificados para inspección, estado y revocación.",{"_3602":74868,"_30987":74817,"_21467":127425,"_5":14750,"_28174":127314,"_3058":127426},[],"Registrar un dispositivo manualmente para asociar esta identidad al inventario de Lamassu.",{"_3602":74869,"_30987":74817,"_21467":127428,"_5":14750,"_28174":127314,"_3058":127429},[],"Preparar EST para que el dispositivo solicite sus siguientes identidades.",{"_3602":74870,"_30987":74817,"_21467":127431,"_5":14750,"_28174":127314,"_3058":127432},[],"La aceptación en un consumidor requiere configurar su confianza, su comprobación de revocación y los permisos concedidos a la identidad.",{"_3602":74871,"_30987":74871,"_5":15110,"_3058":127434,"_31325":127435,"_21467":127436,"_28174":74871},"Primeros pasos de PKI",[50623,121012,56298,124473],[],{"_3602":74872,"_30987":74871,"_21467":127438,"_5":14750,"_28174":74871,"_3058":127439},[],"Crea una CA, emite un certificado de cliente y comprueba su cadena y su clave.",{"_3602":74873,"_30987":74871,"_5":31322,"_21467":127441,"_28174":127442,"_3058":119546},[],"/docs/es/platform/pki/quickstarts/overview#antes-de-empezar",{"_3602":74874,"_30987":74871,"_5":31322,"_21467":127444,"_28174":127445,"_3058":127446},[],"/docs/es/platform/pki/quickstarts/overview#ruta-recomendada","Ruta recomendada",{"_3602":74875,"_30987":74871,"_5":31322,"_21467":127448,"_28174":127449,"_3058":124655},[],"/docs/es/platform/pki/quickstarts/overview#resultado-esperado",{"_3602":74876,"_30987":74871,"_5":31322,"_21467":127451,"_28174":127452,"_3058":127453},[],"/docs/es/platform/pki/quickstarts/overview#continúa-según-tu-objetivo","Continúa según tu objetivo",{"_3602":74877,"_30987":74871,"_21467":127455,"_5":14750,"_28174":74871,"_3058":127456},[],"Este recorrido está dirigido a quien empieza a administrar la PKI o necesita una primera identidad X.509 de cliente. Termina con tres archivos: el certificado de una CA raíz, un certificado final y la clave privada de ese cliente.",{"_3602":74878,"_30987":74871,"_21467":127458,"_5":14750,"_28174":127442,"_3058":127459},[],"Una instancia de Lamassu accesible desde el navegador. Si necesitas prepararla, consulta Despliegue.",{"_3602":74879,"_30987":74871,"_21467":127461,"_5":14750,"_28174":127442,"_3058":127462},[],"Permisos para gestionar claves, autoridades y emisión. Consulta Control de acceso si una operación está bloqueada.",{"_3602":74880,"_30987":74871,"_21467":127464,"_5":14750,"_28174":127442,"_3058":127465},[],"Un motor criptográfico disponible para la clave de la CA; comprueba el inventario de claves y motores.",{"_3602":74881,"_30987":74871,"_21467":127467,"_5":14750,"_28174":127442,"_3058":127468},[],"OpenSSL 3.x en el equipo desde el que verificarás los archivos.",{"_3602":74882,"_30987":74871,"_21467":127470,"_5":14750,"_28174":127442,"_3058":127471},[],"Un directorio de trabajo con acceso restringido para custodiar la clave descargada.",{"_3602":74883,"_30987":74871,"_21467":127473,"_5":14750,"_28174":127445,"_3058":127474},[],"<Card title=\"1. Crea tu primera CA\" description=\"Crea una raíz de evaluación y guarda su certificado público como ca.pem.\" href=\"/docs/platform/pki/quickstarts/create-certificate-authority\" />",{"_3602":74884,"_30987":74871,"_21467":127476,"_5":14750,"_28174":127445,"_3058":127477},[],"<Card title=\"2. Emite y verifica un certificado\" description=\"Emite para device-001 y comprueba contenido, cadena y correspondencia de clave.\" href=\"/docs/platform/pki/quickstarts/issue-certificate\" />",{"_3602":74885,"_30987":74871,"_21467":127479,"_5":14750,"_28174":127445,"_3058":127480},[],"Usaremos `Acme Evaluation Root CA` y `device-001` como nombres de ejemplo. Si los sustituyes, conserva el mismo identificador de cliente en los pasos que quieras conectar.",{"_3602":74886,"_30987":74871,"_21467":127482,"_5":14750,"_28174":127445,"_3058":127483},[],"La raíz de este recorrido firma directamente el certificado final para facilitar la evaluación. Antes de diseñar una PKI operativa, revisa el modelo de confianza y la jerarquía de CAs.",{"_3602":74887,"_30987":74871,"_21467":127485,"_5":14750,"_28174":127449,"_3058":127486},[],"Archivo o recurso",{"_3602":74888,"_30987":74871,"_21467":127488,"_5":14750,"_28174":127449,"_3058":124652},[],{"_3602":74889,"_30987":74871,"_21467":127490,"_5":14750,"_28174":127449,"_3058":127491},[],"CA raíz activa y `ca.pem`",{"_3602":74890,"_30987":74871,"_21467":127493,"_5":14750,"_28174":127449,"_3058":127494},[],"Es un certificado de CA, está vigente y su autofirma se comprueba.",{"_3602":74891,"_30987":74871,"_21467":127496,"_5":14750,"_28174":127449,"_3058":127497},[],"Certificado final y `device.crt`",{"_3602":74892,"_30987":74871,"_21467":127499,"_5":14750,"_28174":127449,"_3058":127500},[],"Identifica a `device-001`, admite autenticación de cliente y verifica hasta `ca.pem`.",{"_3602":74893,"_30987":74871,"_21467":127502,"_5":14750,"_28174":127449,"_3058":127503},[],"Clave privada `device.key`",{"_3602":74894,"_30987":74871,"_21467":127505,"_5":14750,"_28174":127449,"_3058":127506},[],"Su clave pública coincide con la incluida en `device.crt`.",{"_3602":74895,"_30987":74871,"_21467":127508,"_5":14750,"_28174":127449,"_3058":127509},[],"Estas comprobaciones validan el material emitido. La aceptación en un servicio requiere además su configuración de confianza, autorización y revocación.",{"_3602":74896,"_30987":74871,"_21467":127511,"_5":14750,"_28174":127452,"_3058":127512},[],"Para operar certificados, continúa con Certificados y Validación.",{"_3602":74897,"_30987":74871,"_21467":127514,"_5":14750,"_28174":127452,"_3058":127515},[],"Para gestionar una identidad de dispositivo en Lamassu, sigue Registro manual. Ese recorrido incluye la preparación del DMS.",{"_3602":74898,"_30987":74871,"_21467":127517,"_5":14750,"_28174":127452,"_3058":127518},[],"Para que el dispositivo solicite su certificado, prepara el DMS y el cliente EST.",{"_3602":74899,"_30987":74899,"_5":15110,"_3058":127520,"_31325":127521,"_21467":127523,"_28174":74899},"Resolución de problemas PKI",[50623,121012,56298,127522],"Resolución de problemas",[],{"_3602":74900,"_30987":74899,"_21467":127525,"_5":14750,"_28174":74899,"_3058":127526},[],"Diagnostica emisión de certificados, OCSP y CRL.",{"_3602":74901,"_30987":74899,"_5":31322,"_21467":127528,"_28174":127529,"_3058":127530},[],"/docs/es/platform/pki/troubleshooting#la-emisión-falla","La emisión falla",{"_3602":74902,"_30987":74899,"_5":31322,"_21467":127532,"_28174":127533,"_3058":127534},[],"/docs/es/platform/pki/troubleshooting#ocsp-o-crl-no-reflejan-un-cambio","OCSP o CRL no reflejan un cambio",{"_3602":74903,"_30987":74899,"_5":31322,"_21467":127536,"_28174":127537,"_3058":127538},[],"/docs/es/platform/pki/troubleshooting#la-cadena-se-valida-pero-la-conexión-falla","La cadena se valida pero la conexión falla",{"_3602":74904,"_30987":74899,"_21467":127540,"_5":14750,"_28174":74899,"_3058":127541},[],"Esta guía ayuda al operador PKI a localizar fallos de emisión y publicación de estado. Conserva versión de Lamassu, operación, CA, emisor, serie, hora y error devuelto. No incluyas claves privadas ni tokens en el diagnóstico.",{"_3602":74905,"_30987":74899,"_21467":127543,"_5":14750,"_28174":74899,"_3058":127544},[],"Para Gateway, inicio de sesión, pods, dependencias y mensajería, consulta Diagnóstico de Despliegue. Para enrolamiento de dispositivos, consulta Diagnóstico EST.",{"_3602":74906,"_30987":74899,"_21467":127546,"_5":14750,"_28174":127529,"_3058":124652},[],{"_3602":74907,"_30987":74899,"_21467":127548,"_5":14750,"_28174":127529,"_3058":123324},[],{"_3602":74908,"_30987":74899,"_21467":127550,"_5":14750,"_28174":127529,"_3058":119570},[],{"_3602":74909,"_30987":74899,"_21467":127552,"_5":14750,"_28174":127529,"_3058":55140},[],{"_3602":74910,"_30987":74899,"_21467":127554,"_5":14750,"_28174":127529,"_3058":127555},[],"Existe, está activa y sus fechas son utilizables.",{"_3602":74911,"_30987":74899,"_21467":127557,"_5":14750,"_28174":127529,"_3058":127558},[],"Autoridades.",{"_3602":74912,"_30987":74899,"_21467":127560,"_5":14750,"_28174":127529,"_3058":127561},[],"Clave",{"_3602":74913,"_30987":74899,"_21467":127563,"_5":14750,"_28174":127529,"_3058":127564},[],"El registro tiene clave privada utilizable y el motor puede firmar.",{"_3602":74914,"_30987":74899,"_21467":127566,"_5":14750,"_28174":127529,"_3058":127567},[],"Prueba **Sign / Verify** en KMS; revisa permisos y disponibilidad del proveedor.",{"_3602":74915,"_30987":74899,"_21467":127569,"_5":14750,"_28174":127529,"_3058":58880},[],{"_3602":74916,"_30987":74899,"_21467":127571,"_5":14750,"_28174":127529,"_3058":127572},[],"PEM correcto y firma verificable.",{"_3602":74917,"_30987":74899,"_21467":127574,"_5":14750,"_28174":127529,"_3058":58886},[],{"_3602":74918,"_30987":74899,"_21467":127576,"_5":14750,"_28174":127529,"_3058":127577},[],"Perfil",{"_3602":74919,"_30987":74899,"_21467":127579,"_5":14750,"_28174":127529,"_3058":127580},[],"Fuente seleccionada, ID existente, algoritmo y tamaño admitidos.",{"_3602":74920,"_30987":74899,"_21467":127582,"_5":14750,"_28174":127529,"_3058":127583},[],"Revisa la precedencia de Perfiles; CA y DMS resuelven de forma distinta.",{"_3602":74921,"_30987":74899,"_21467":127585,"_5":14750,"_28174":127529,"_3058":124803},[],{"_3602":74922,"_30987":74899,"_21467":127587,"_5":14750,"_28174":127529,"_3058":127588},[],"Sujeto, SAN, usos y fechas adecuados.",{"_3602":74923,"_30987":74899,"_21467":127590,"_5":14750,"_28174":127529,"_3058":127591},[],"Compara CSR, perfil y certificado; emitir correctamente no demuestra aceptación por el consumidor.",{"_3602":74924,"_30987":74899,"_21467":127593,"_5":14750,"_28174":127529,"_3058":127594},[],"Si el certificado emitido tiene campos inesperados, revisa `Honor Subject`, `Honor Key Usage`, `Honor Extended Key Usages` y `Honor Extensions`. Esta última solo conserva SAN, sin validar el derecho a esos nombres. La validez no se recorta automáticamente al vencimiento de la CA.",{"_3602":74925,"_30987":74899,"_21467":127596,"_5":14750,"_28174":127529,"_3058":127597},[],"Si la emisión falla con `400` y `CA Status inconsistent`, la CA emisora no está `ACTIVE` o está fuera del periodo de validez de su certificado. El estado almacenado puede ir por detrás de las fechas hasta que se ejecuta el monitor de expiración, así que comprueba también las fechas. Reemite la CA mientras siga vigente o emite desde otra CA.",{"_3602":74926,"_30987":74899,"_21467":127599,"_5":14750,"_28174":127529,"_3058":127600},[],"Si falla la reemisión de una CA, comprueba revocación y fecha: no se admite para una CA revocada o ya vencida. Si es subordinada, comprueba también el estado y las fechas de su CA padre. Para cambiar la clave, utiliza Jerarquía y rotación.",{"_3602":74927,"_30987":74899,"_21467":127602,"_5":14750,"_28174":127533,"_3058":127603},[],"Revisa cada frontera por separado:",{"_3602":74928,"_30987":74899,"_21467":127605,"_5":14750,"_28174":127533,"_3058":127606},[],"**Registro:** vuelve a leer el certificado correcto por serie y emisor. Confirma estado, razón y hora; los registros expirados o revocados definitivamente no admiten otra transición.",{"_3602":74929,"_30987":74899,"_21467":127608,"_5":14750,"_28174":127533,"_3058":127609},[],"**Endpoint:** inspecciona AIA y CDP del certificado. Consulta esas URLs desde la red del consumidor; una ruta antigua o un emisor incorrecto puede explicar la diferencia.",{"_3602":74930,"_30987":74899,"_21467":127611,"_5":14750,"_28174":127533,"_3058":127612},[],"**OCSP:** guarda una respuesta nueva, verifica firma y tiempos y observa su estado. Un error HTTP por una serie ausente no equivale a `Good` ni garantiza un `Unknown` firmado.",{"_3602":74931,"_30987":74899,"_21467":127614,"_5":14750,"_28174":127533,"_3058":127615},[],"**CRL:** compara `latest_crl`, número y tiempos de la lista descargada. Confirma la serie en el contenido. Si no cambia, revisa `regenerate_on_revoke`, entrega del evento, trabajos, firma y almacenamiento con el operador de Despliegue.",{"_3602":74932,"_30987":74899,"_21467":127617,"_5":14750,"_28174":127533,"_3058":127618},[],"**Cliente:** comprueba caché, política ante evidencia vencida o no disponible, extensión IDP crítica y rechazo de una conexión nueva.",{"_3602":74933,"_30987":74899,"_21467":127620,"_5":14750,"_28174":127533,"_3058":127621},[],"Una reactivación desde `CertificateHold` requiere una CRL nueva para que el cliente deje de ver la suspensión. Reactivar una CA no restaura su cascada de descendientes; revisa todos los estados y los errores individuales de la operación.",{"_3602":74934,"_30987":74899,"_21467":127623,"_5":14750,"_28174":127537,"_3058":127624},[],"Comprueba la identidad esperada, SAN, KU/EKU, clave correspondiente, intermedias enviadas y permisos del consumidor. Diferencia confianza TLS en el servidor, autenticación del cliente y autorización de la acción. Sigue Validación para una prueba positiva y otras de rechazo.",{"_3602":74935,"_30987":74899,"_21467":127626,"_5":14750,"_28174":127537,"_3058":127627},[],"Cuando necesites escalar un problema, entrega los identificadores, error y evidencia pública relevante, con tiempos de consulta y versión. Esto permite distinguir un fallo de emisión, de publicación o de la aplicación consumidora.",{"_3602":74936,"_30987":74936,"_5":15110,"_3058":127629,"_31325":127630,"_21467":127631,"_28174":74936},"Seguridad",[50623],[],{"_3602":74937,"_30987":74936,"_21467":127633,"_5":14750,"_28174":74936,"_3058":127634},[],"Cómo reportar de forma privada una vulnerabilidad de seguridad en Lamassu, qué incluir en el reporte y qué releases reciben correcciones de seguridad.",{"_3602":74938,"_30987":74936,"_5":31322,"_21467":127636,"_28174":127637,"_3058":127638},[],"/docs/es/security#cómo-reportar-una-vulnerabilidad","Cómo reportar una vulnerabilidad",{"_3602":74939,"_30987":74936,"_5":31322,"_21467":127640,"_28174":127641,"_3058":127642},[],"/docs/es/security#qué-incluir-en-un-reporte","Qué incluir en un reporte",{"_3602":74940,"_30987":74936,"_5":31322,"_21467":127644,"_28174":127645,"_3058":127646},[],"/docs/es/security#versiones-soportadas","Versiones soportadas",{"_3602":74941,"_30987":74936,"_5":31322,"_21467":127648,"_28174":127649,"_3058":127650},[],"/docs/es/security#divulgación-responsable","Divulgación responsable",{"_3602":74942,"_30987":74936,"_21467":127652,"_5":14750,"_28174":74936,"_3058":127653},[],"¿Has encontrado una vulnerabilidad de seguridad en lamassuiot, lamassu-dashboard o lamassu-helm? Esta página explica cómo reportarla de forma privada, qué incluir en tu reporte y qué releases reciben correcciones de seguridad.",{"_3602":74943,"_30987":74936,"_21467":127655,"_5":14750,"_28174":127637,"_3058":127656},[],"No reportes vulnerabilidades de seguridad mediante issues, discusiones o pull requests públicos de GitHub. Un reporte público divulga el problema antes de que los mantenedores puedan corregirlo.",{"_3602":74944,"_30987":74936,"_21467":127658,"_5":14750,"_28174":127637,"_3058":127659},[],"En su lugar, reporta de forma privada mediante GitHub Security Advisories para el repositorio afectado:",{"_3602":74945,"_30987":74936,"_21467":127661,"_5":14750,"_28174":127637,"_3058":15388},[],{"_3602":74946,"_30987":74936,"_21467":127663,"_5":14750,"_28174":127637,"_3058":15317},[],{"_3602":74947,"_30987":74936,"_21467":127665,"_5":14750,"_28174":127637,"_3058":15375},[],{"_3602":74948,"_30987":74936,"_21467":127667,"_5":14750,"_28174":127637,"_3058":127668},[],"Así los mantenedores pueden evaluar y resolver el problema antes de que se publique.",{"_3602":74949,"_30987":74936,"_21467":127670,"_5":14750,"_28174":127637,"_3058":127671},[],"Si el reporte privado de vulnerabilidades no está habilitado en ese repositorio, reporta la vulnerabilidad de forma privada a lamassuiot\\@lksnext.com antes de divulgar cualquier detalle públicamente.",{"_3602":74950,"_30987":74936,"_21467":127673,"_5":14750,"_28174":127641,"_3058":127674},[],"Describe la vulnerabilidad, su impacto potencial y los pasos para reproducirla usando ejemplos no sensibles y anonimizados.",{"_3602":74951,"_30987":74936,"_21467":127676,"_5":14750,"_28174":127641,"_3058":127677},[],"No incluyas en el reporte:",{"_3602":74952,"_30987":74936,"_21467":127679,"_5":14750,"_28174":127641,"_3058":127680},[],"Credenciales, tokens o claves privadas",{"_3602":74953,"_30987":74936,"_21467":127682,"_5":14750,"_28174":127641,"_3058":127683},[],"Datos de clientes o información identificable de clientes",{"_3602":74954,"_30987":74936,"_21467":127685,"_5":14750,"_28174":127641,"_3058":127686},[],"Detalles confidenciales de arquitectura o de infraestructura interna",{"_3602":74955,"_30987":74936,"_21467":127688,"_5":14750,"_28174":127645,"_3058":127689},[],"Solo el último release estable recibe soporte de seguridad. El soporte de un release estable termina cuando se publica el siguiente release estable. Los releases anteriores y los pre-releases no tienen soporte.",{"_3602":74956,"_30987":74936,"_21467":127691,"_5":14750,"_28174":127645,"_3058":127692},[],"Para saber cómo actualizar, consulta Actualizaciones.",{"_3602":74957,"_30987":74936,"_21467":127694,"_5":14750,"_28174":127649,"_3058":127695},[],"Da a los mantenedores un tiempo razonable para investigar y resolver la vulnerabilidad reportada antes de cualquier divulgación pública.",{"_3602":74958,"_30987":74936,"_21467":127697,"_5":14750,"_28174":127649,"_3058":127698},[],"Evita violaciones de privacidad, destrucción de datos e interrupciones de servicio mientras investigas la vulnerabilidad.",{"_3602":74959,"_30987":74936,"_21467":127700,"_5":14750,"_28174":127649,"_3058":127701},[],"Interactúa solo con cuentas o datos que sean tuyos o sobre los que tengas permiso explícito.",{"_3602":74960,"_30987":74936,"_21467":127703,"_5":14750,"_28174":127649,"_3058":127704},[],"Los mantenedores reconocen los reportes en un tiempo razonable y te mantienen informado del progreso de la remediación.",{"_3602":74961,"_30987":74936,"_21467":127706,"_5":14750,"_28174":127649,"_3058":127707},[],"Esta política cubre el código fuente, la configuración y los flujos de CI/CD de los repositorios lamassuiot, lamassu-dashboard y lamassu-helm.",{"_3602":74962,"_30987":74962,"_5":15110,"_3058":127709,"_31325":127710,"_21467":127712,"_28174":74962},"3.8.0 a 4.0.0",[50623,127711],"Actualizaciones",[],{"_3602":74963,"_30987":74962,"_21467":127714,"_5":14750,"_28174":74962,"_3058":127715},[],"Qué cambia en la arquitectura de 4.0.0, qué cambios rompen un despliegue 3.8.0, cómo actualizar paso a paso una release de Helm y cómo validar el resultado.",{"_3602":74964,"_30987":74962,"_5":31322,"_21467":127717,"_28174":127718,"_3058":127719},[],"/docs/es/upgrades/3-8-0-to-4-0-0#cambios-de-arquitectura","Cambios de arquitectura",{"_3602":74965,"_30987":74962,"_5":31322,"_21467":127721,"_28174":127722,"_3058":127723},[],"/docs/es/upgrades/3-8-0-to-4-0-0#una-única-base-de-datos-postgresql-con-esquemas","Una única base de datos PostgreSQL con esquemas",{"_3602":74966,"_30987":74962,"_5":31322,"_21467":127725,"_28174":127726,"_3058":127727},[],"/docs/es/upgrades/3-8-0-to-4-0-0#la-autorización-pasa-al-servicio-authz","La autorización pasa al servicio authz",{"_3602":74967,"_30987":74962,"_5":31322,"_21467":127729,"_28174":127730,"_3058":127731},[],"/docs/es/upgrades/3-8-0-to-4-0-0#los-eventos-de-dispositivo-tienen-almacenamiento-propio","Los eventos de dispositivo tienen almacenamiento propio",{"_3602":74968,"_30987":74962,"_5":31322,"_21467":127733,"_28174":127734,"_3058":127735},[],"/docs/es/upgrades/3-8-0-to-4-0-0#un-chart-de-helm-reforzado","Un chart de Helm reforzado",{"_3602":74969,"_30987":74962,"_5":31322,"_21467":127737,"_28174":127738,"_3058":127739},[],"/docs/es/upgrades/3-8-0-to-4-0-0#qué-migra-automáticamente-la-actualización","Qué migra automáticamente la actualización",{"_3602":74970,"_30987":74962,"_5":31322,"_21467":127741,"_28174":127742,"_3058":59055},[],"/docs/es/upgrades/3-8-0-to-4-0-0#breaking-changes",{"_3602":74971,"_30987":74962,"_5":31322,"_21467":127744,"_28174":127745,"_3058":127746},[],"/docs/es/upgrades/3-8-0-to-4-0-0#chart-de-helm-y-values","Chart de Helm y values",{"_3602":74972,"_30987":74962,"_5":31322,"_21467":127748,"_28174":127749,"_3058":127750},[],"/docs/es/upgrades/3-8-0-to-4-0-0#nombres-de-recursos-con-ámbito-de-release","Nombres de recursos con ámbito de release",{"_3602":74973,"_30987":74962,"_5":31322,"_21467":127752,"_28174":127753,"_3058":127754},[],"/docs/es/upgrades/3-8-0-to-4-0-0#validación-estricta-de-values","Validación estricta de values",{"_3602":74974,"_30987":74962,"_5":31322,"_21467":127756,"_28174":127757,"_3058":120141},[],"/docs/es/upgrades/3-8-0-to-4-0-0#credenciales-en-secrets-de-kubernetes",{"_3602":74975,"_30987":74962,"_5":31322,"_21467":127759,"_28174":127760,"_3058":127761},[],"/docs/es/upgrades/3-8-0-to-4-0-0#configuración-de-autorización-obligatoria","Configuración de autorización obligatoria",{"_3602":74976,"_30987":74962,"_5":31322,"_21467":127763,"_28174":127764,"_3058":127765},[],"/docs/es/upgrades/3-8-0-to-4-0-0#retirada-de-la-validación-de-tokens-en-el-gateway","Retirada de la validación de tokens en el gateway",{"_3602":74977,"_30987":74962,"_5":31322,"_21467":127767,"_28174":127768,"_3058":127769},[],"/docs/es/upgrades/3-8-0-to-4-0-0#contenedores-sin-root","Contenedores sin root",{"_3602":74978,"_30987":74962,"_5":31322,"_21467":127771,"_28174":127772,"_3058":127773},[],"/docs/es/upgrades/3-8-0-to-4-0-0#amqp-sobre-tls","AMQP sobre TLS",{"_3602":74979,"_30987":74962,"_5":31322,"_21467":127775,"_28174":127776,"_3058":127777},[],"/docs/es/upgrades/3-8-0-to-4-0-0#values-renombrados-y-reestructurados","Values renombrados y reestructurados",{"_3602":74980,"_30987":74962,"_5":31322,"_21467":127779,"_28174":127780,"_3058":127781},[],"/docs/es/upgrades/3-8-0-to-4-0-0#datos-y-almacenamiento","Datos y almacenamiento",{"_3602":74981,"_30987":74962,"_5":31322,"_21467":127783,"_28174":127784,"_3058":127785},[],"/docs/es/upgrades/3-8-0-to-4-0-0#consolidación-en-postgresql","Consolidación en PostgreSQL",{"_3602":74982,"_30987":74962,"_5":31322,"_21467":127787,"_28174":127788,"_3058":127789},[],"/docs/es/upgrades/3-8-0-to-4-0-0#retirada-de-sqlite","Retirada de SQLite",{"_3602":74983,"_30987":74962,"_5":31322,"_21467":127791,"_28174":127792,"_3058":127793},[],"/docs/es/upgrades/3-8-0-to-4-0-0#claves-de-ca-heredadas-en-el-kms","Claves de CA heredadas en el KMS",{"_3602":74984,"_30987":74962,"_5":31322,"_21467":127795,"_28174":127796,"_3058":127797},[],"/docs/es/upgrades/3-8-0-to-4-0-0#referencias-entre-certificados-claves-y-ajustes-de-crl","Referencias entre certificados, claves y ajustes de CRL",{"_3602":74985,"_30987":74962,"_5":31322,"_21467":127799,"_28174":127800,"_3058":127801},[],"/docs/es/upgrades/3-8-0-to-4-0-0#apis-y-configuración-almacenada","APIs y configuración almacenada",{"_3602":74986,"_30987":74962,"_5":31322,"_21467":127803,"_28174":127804,"_3058":127805},[],"/docs/es/upgrades/3-8-0-to-4-0-0#webhooks-del-dms","Webhooks del DMS",{"_3602":74987,"_30987":74962,"_5":31322,"_21467":127807,"_28174":127808,"_3058":127809},[],"/docs/es/upgrades/3-8-0-to-4-0-0#conjunto-de-confianza-del-reenrolamiento","Conjunto de confianza del reenrolamiento",{"_3602":74988,"_30987":74962,"_5":31322,"_21467":127811,"_28174":127812,"_3058":127813},[],"/docs/es/upgrades/3-8-0-to-4-0-0#autenticación-de-reenrolamiento-independiente","Autenticación de reenrolamiento independiente",{"_3602":74989,"_30987":74962,"_5":31322,"_21467":127815,"_28174":127816,"_3058":127817},[],"/docs/es/upgrades/3-8-0-to-4-0-0#api-de-actualización-del-dms","API de actualización del DMS",{"_3602":74990,"_30987":74962,"_5":31322,"_21467":127819,"_28174":127820,"_3058":127821},[],"/docs/es/upgrades/3-8-0-to-4-0-0#valores-de-tipo-de-certificado","Valores de tipo de certificado",{"_3602":74991,"_30987":74962,"_5":31322,"_21467":127823,"_28174":127824,"_3058":127825},[],"/docs/es/upgrades/3-8-0-to-4-0-0#eventos-de-dispositivo","Eventos de dispositivo",{"_3602":74992,"_30987":74962,"_5":31322,"_21467":127827,"_28174":127828,"_3058":127829},[],"/docs/es/upgrades/3-8-0-to-4-0-0#campo-firmante-de-la-crl","Campo firmante de la CRL",{"_3602":74993,"_30987":74962,"_5":31322,"_21467":127831,"_28174":127832,"_3058":127833},[],"/docs/es/upgrades/3-8-0-to-4-0-0#ajustes-de-crl-indexados-por-id-de-ca","Ajustes de CRL indexados por ID de CA",{"_3602":74994,"_30987":74962,"_5":31322,"_21467":127835,"_28174":127836,"_3058":127837},[],"/docs/es/upgrades/3-8-0-to-4-0-0#eventos-de-va-renombrados","Eventos de VA renombrados",{"_3602":74995,"_30987":74962,"_5":31322,"_21467":127839,"_28174":127840,"_3058":127841},[],"/docs/es/upgrades/3-8-0-to-4-0-0#los-ids-de-ca-los-asigna-siempre-el-backend","Los IDs de CA los asigna siempre el backend",{"_3602":74996,"_30987":74962,"_5":31322,"_21467":127843,"_28174":127844,"_3058":127845},[],"/docs/es/upgrades/3-8-0-to-4-0-0#endpoints-de-firma-de-ca-eliminados","Endpoints de firma de CA eliminados",{"_3602":74997,"_30987":74962,"_5":31322,"_21467":127847,"_28174":127848,"_3058":127849},[],"/docs/es/upgrades/3-8-0-to-4-0-0#firmante-de-crl-de-la-va","Firmante de CRL de la VA",{"_3602":74998,"_30987":74962,"_5":31322,"_21467":127851,"_28174":127852,"_3058":127853},[],"/docs/es/upgrades/3-8-0-to-4-0-0#guía-de-migración-con-helm","Guía de migración con Helm",{"_3602":74999,"_30987":74962,"_5":31322,"_21467":127855,"_28174":127856,"_3058":127857},[],"/docs/es/upgrades/3-8-0-to-4-0-0#paso-1-prepara","Paso 1: Prepara",{"_3602":75000,"_30987":74962,"_5":31322,"_21467":127859,"_28174":127860,"_3058":127861},[],"/docs/es/upgrades/3-8-0-to-4-0-0#comprobación-previa-a-la-actualización","Comprobación previa a la actualización",{"_3602":75001,"_30987":74962,"_5":31322,"_21467":127863,"_28174":127864,"_3058":127865},[],"/docs/es/upgrades/3-8-0-to-4-0-0#paso-2-actualiza-el-archivo-de-values","Paso 2: Actualiza el archivo de values",{"_3602":75002,"_30987":74962,"_5":31322,"_21467":127867,"_28174":127868,"_3058":127869},[],"/docs/es/upgrades/3-8-0-to-4-0-0#paso-3-ejecuta-la-actualización","Paso 3: Ejecuta la actualización",{"_3602":75003,"_30987":74962,"_5":31322,"_21467":127871,"_28174":127872,"_3058":127873},[],"/docs/es/upgrades/3-8-0-to-4-0-0#paso-4-migra-los-datos-del-kms-y-la-va","Paso 4: Migra los datos del KMS y la VA",{"_3602":75004,"_30987":74962,"_5":31322,"_21467":127875,"_28174":127876,"_3058":127877},[],"/docs/es/upgrades/3-8-0-to-4-0-0#paso-5-elimina-los-values-de-migración-puntual","Paso 5: Elimina los values de migración puntual",{"_3602":75005,"_30987":74962,"_5":31322,"_21467":127879,"_28174":127880,"_3058":127881},[],"/docs/es/upgrades/3-8-0-to-4-0-0#despliegues-sin-helm","Despliegues sin Helm",{"_3602":75006,"_30987":74962,"_5":31322,"_21467":127883,"_28174":127884,"_3058":123666},[],"/docs/es/upgrades/3-8-0-to-4-0-0#solución-de-problemas",{"_3602":75007,"_30987":74962,"_5":31322,"_21467":127886,"_28174":127887,"_3058":127888},[],"/docs/es/upgrades/3-8-0-to-4-0-0#checklist-de-validación","Checklist de validación",{"_3602":75008,"_30987":74962,"_5":31322,"_21467":127890,"_28174":127891,"_3058":127892},[],"/docs/es/upgrades/3-8-0-to-4-0-0#elimina-los-volúmenes-antiguos","Elimina los volúmenes antiguos",{"_3602":75009,"_30987":74962,"_21467":127894,"_5":14750,"_28174":74962,"_3058":127895},[],"Lamassu 4.0.0 es una versión mayor. El almacenamiento se consolida en una única base de datos PostgreSQL, un nuevo servicio `authz` autoriza cada petición, el chart de Helm se refuerza y varias APIs y configuraciones almacenadas cambian de forma. La mayoría de los datos se convierten automáticamente durante la actualización, pero algunos cambios requieren acción del operador antes, durante o después.",{"_3602":75010,"_30987":74962,"_21467":127897,"_5":14750,"_28174":74962,"_3058":127898},[],"La página se organiza en cuatro partes. Léelas en orden antes de actualizar producción:",{"_3602":75011,"_30987":74962,"_21467":127900,"_5":14750,"_28174":74962,"_3058":127901},[],"Cambios de arquitectura: qué es distinto en 4.0.0 y qué migra la actualización por sí sola.",{"_3602":75012,"_30987":74962,"_21467":127903,"_5":14750,"_28174":74962,"_3058":127904},[],"Breaking changes: cada cambio que puede romper un despliegue 3.8.0, a quién afecta y qué hacer.",{"_3602":75013,"_30987":74962,"_21467":127906,"_5":14750,"_28174":74962,"_3058":127907},[],"Guía de migración con Helm: el procedimiento paso a paso para una release gestionada con Helm.",{"_3602":75014,"_30987":74962,"_21467":127909,"_5":14750,"_28174":74962,"_3058":127910},[],"Checklist de validación: cómo confirmar que la actualización ha funcionado antes de eliminar los datos antiguos.",{"_3602":75015,"_30987":74962,"_21467":127912,"_5":14750,"_28174":74962,"_3058":127913},[],"La versión 4.0.0 está próxima y los pasos de migración del backend de esta página son provisionales. Verifica cada procedimiento con los artefactos definitivos de la versión antes de actualizar producción.",{"_3602":75016,"_30987":74962,"_21467":127915,"_5":14750,"_28174":127722,"_3058":127916},[],"En 3.8.0 cada servicio tenía su propia base de datos. El backend de 4.0.0 se conecta a una única base de datos PostgreSQL llamada `pki` y aísla cada servicio en un esquema: `kms`, `ca`, `va`, `devicemanager`, `dmsmanager` y `alerts`. El servicio `authz` guarda sus principales, permisos y políticas en una base de datos `authz` separada (el monolítico de desarrollo usa en su lugar un esquema `authz` dentro de `pki`), y WFX conserva su propia base `wfx`.",{"_3602":75017,"_30987":74962,"_21467":127918,"_5":14750,"_28174":127722,"_3058":127919},[],"PostgreSQL pasa a ser el único motor de almacenamiento. Se elimina el soporte de SQLite, y los motores `couch_db` y `dynamo_db` no están registrados en 4.0.0.",{"_3602":75018,"_30987":74962,"_21467":127921,"_5":14750,"_28174":127726,"_3058":127922},[],"En 3.8.0 el API Gateway validaba los tokens: una política JWT en cada ruta privada comprobaba la firma y solo dejaba pasar los tokens con el rol de administrador. Cualquier token que superase esa comprobación tenía acceso a todas las rutas.",{"_3602":75019,"_30987":74962,"_21467":127924,"_5":14750,"_28174":127726,"_3058":127925},[],"4.0.0 elimina la política del gateway. Las rutas `/api/*` llegan directamente a los servicios, y cada servicio autoriza cada petición a través de `authz`, que valida el token contra el endpoint JWKS del proveedor de identidad y aplica políticas de grano fino, a nivel de entidad, sobre CAs, certificados, dispositivos, DMS, claves del KMS y ajustes de CRL. No existe un superusuario implícito: el primer administrador sale de un principal de bootstrap que configuras tú. La página de control de acceso documenta los principales, las políticas y el primer administrador.",{"_3602":75020,"_30987":74962,"_21467":127927,"_5":14750,"_28174":127730,"_3058":127928},[],"Los eventos históricos de los dispositivos pasan de la columna `devices.events` a un almacenamiento dedicado, `device_events`, con sus propios endpoints. El endpoint de eventos también puede emitirlos mediante Server-Sent Events (SSE); para difundirlos entre las instancias del servicio, cada instancia de Device Manager enlaza su propia cola AMQP duradera.",{"_3602":75021,"_30987":74962,"_21467":127930,"_5":14750,"_28174":127734,"_3058":127931},[],"La versión 4.0.0 del chart refuerza la seguridad:",{"_3602":75022,"_30987":74962,"_21467":127933,"_5":14750,"_28174":127734,"_3058":127934},[],"**Nombres de recursos con ámbito de release.** Cada recurso gestionado por el chart se llama `<release>-lamassu-<componente>` en lugar de los nombres fijos de 3.8.0 (`kms`, `va`, `ca`...). Con una release llamada `prod`, los StatefulSets pasan a ser `prod-lamassu-kms` y `prod-lamassu-va`. Los values `nameOverride` y `fullnameOverride` cambian el prefijo.",{"_3602":75023,"_30987":74962,"_21467":127936,"_5":14750,"_28174":127734,"_3058":127937},[],"**Contenedores sin root.** Todas las cargas se ejecutan con el usuario numérico `65532:65532`, con un perfil seccomp `RuntimeDefault` y sin capabilities. Los pods no montan el token de la service account por defecto, y el chart crea una ServiceAccount dedicada.",{"_3602":75024,"_30987":74962,"_21467":127939,"_5":14750,"_28174":127734,"_3058":127940},[],"**Validación estricta de values.** `values.schema.json` rechaza las claves desconocidas, así que los bloques sobrantes de 3.8.0 hacen fallar `helm lint` y `helm upgrade` en lugar de ignorarse en silencio.",{"_3602":75025,"_30987":74962,"_21467":127942,"_5":14750,"_28174":127734,"_3058":127943},[],"**Sin reglas de planificación inyectadas.** El chart ya no añade por su cuenta reglas de anti-afinidad ni de topology spread.",{"_3602":75026,"_30987":74962,"_21467":127945,"_5":14750,"_28174":127738,"_3058":127946},[],"Al actualizar una release de Helm se ejecutan varias migraciones sin intervención:",{"_3602":75027,"_30987":74962,"_21467":127948,"_5":14750,"_28174":127738,"_3058":127949},[],"Antes de que arranque ningún servicio, el job de preinstalación y preactualización del chart prepara PostgreSQL. Crea las bases `pki`, `authz` y `wfx` si no existen, crea un esquema por servicio dentro de `pki` e importa cada base de datos por servicio de 3.8.0 en su esquema. Cada importación se ejecuta en una única transacción, de modo que una importación fallida no deja un esquema a medias y un reintento del job vuelve a importar. Después, el job ejecuta las migraciones de base de datos de cada esquema, migra `authz`, precarga sus políticas y da de alta los principales de `services.authz.bootstrap`. Es idempotente y necesita un rol de PostgreSQL con permiso para crear bases de datos y esquemas, como se describe en Instalar con Helm.",{"_3602":75028,"_30987":74962,"_21467":127951,"_5":14750,"_28174":127738,"_3058":127952},[],"La configuración almacenada de los DMS se reescribe al formato de 4.0.0, y los eventos históricos de los dispositivos se transforman al nuevo almacenamiento.",{"_3602":75029,"_30987":74962,"_21467":127954,"_5":14750,"_28174":127738,"_3058":127955},[],"La migración del KMS elimina los metadatos de clave obsoletos `lamassu.io/kms/binded-resources`, y la migración de la VA resuelve el firmante de CRL de cada rol (consulta Firmante de CRL de la VA).",{"_3602":75030,"_30987":74962,"_21467":127957,"_5":14750,"_28174":127738,"_3058":127958},[],"Si se activa `migrations.caToKms.enabled`, un hook de preactualización registra en el KMS las claves de CA heredadas.",{"_3602":75031,"_30987":74962,"_21467":127960,"_5":14750,"_28174":127738,"_3058":127961},[],"Dos cosas nunca migran solas: los datos del KMS y de la VA en volúmenes locales, que se quedan en volúmenes que los pods actualizados ya no usan, y el archivo de values, que se actualiza a mano. Los despliegues que no usan el chart de Helm también tienen que mover ellos mismos los datos de la base de datos; consulta Despliegues sin Helm.",{"_3602":75032,"_30987":74962,"_21467":127963,"_5":14750,"_28174":127742,"_3058":127964},[],"Cambio",{"_3602":75033,"_30987":74962,"_21467":127966,"_5":14750,"_28174":127742,"_3058":127967},[],"A quién afecta",{"_3602":75034,"_30987":74962,"_21467":127969,"_5":14750,"_28174":127742,"_3058":127970},[],"Gravedad",{"_3602":75035,"_30987":74962,"_21467":127972,"_5":14750,"_28174":127742,"_3058":126451},[],{"_3602":75036,"_30987":74962,"_21467":127974,"_5":14750,"_28174":127742,"_3058":127750},[],{"_3602":75037,"_30987":74962,"_21467":127976,"_5":14750,"_28174":127742,"_3058":127977},[],"Releases de Helm con motor de KMS en sistema de archivos o CRLs de la VA en almacenamiento local",{"_3602":75038,"_30987":74962,"_21467":127979,"_5":14750,"_28174":127742,"_3058":127980},[],"Alta: KMS y VA arrancan con volúmenes vacíos",{"_3602":75039,"_30987":74962,"_21467":127982,"_5":14750,"_28174":127742,"_3058":127983},[],"Copiar los datos a los volúmenes nuevos",{"_3602":75040,"_30987":74962,"_21467":127985,"_5":14750,"_28174":127742,"_3058":127754},[],{"_3602":75041,"_30987":74962,"_21467":127987,"_5":14750,"_28174":127742,"_3058":127988},[],"Todas las releases de Helm",{"_3602":75042,"_30987":74962,"_21467":127990,"_5":14750,"_28174":127742,"_3058":127991},[],"Alta: `helm upgrade` falla",{"_3602":75043,"_30987":74962,"_21467":127993,"_5":14750,"_28174":127742,"_3058":127994},[],"Eliminar o renombrar las claves heredadas",{"_3602":75044,"_30987":74962,"_21467":127996,"_5":14750,"_28174":127742,"_3058":120141},[],{"_3602":75045,"_30987":74962,"_21467":127998,"_5":14750,"_28174":127742,"_3058":127988},[],{"_3602":75046,"_30987":74962,"_21467":128000,"_5":14750,"_28174":127742,"_3058":128001},[],"Alta: `helm upgrade` falla con credenciales inline",{"_3602":75047,"_30987":74962,"_21467":128003,"_5":14750,"_28174":127742,"_3058":128004},[],"Crear primero los Secrets; consulta el paso 2",{"_3602":75048,"_30987":74962,"_21467":128006,"_5":14750,"_28174":127742,"_3058":127761},[],{"_3602":75049,"_30987":74962,"_21467":128008,"_5":14750,"_28174":127742,"_3058":128009},[],"Todos los despliegues",{"_3602":75050,"_30987":74962,"_21467":128011,"_5":14750,"_28174":127742,"_3058":128012},[],"Alta: sin principal de bootstrap no hay administrador",{"_3602":75051,"_30987":74962,"_21467":128014,"_5":14750,"_28174":127742,"_3058":128015},[],"Configurar `services.authz`",{"_3602":75052,"_30987":74962,"_21467":128017,"_5":14750,"_28174":127742,"_3058":127765},[],{"_3602":75053,"_30987":74962,"_21467":128019,"_5":14750,"_28174":127742,"_3058":127988},[],{"_3602":75054,"_30987":74962,"_21467":128021,"_5":14750,"_28174":127742,"_3058":128022},[],"Alta: `helm upgrade` falla con las claves antiguas",{"_3602":75055,"_30987":74962,"_21467":128024,"_5":14750,"_28174":127742,"_3058":128025},[],"Mover JWKS y roles a `services.authz`",{"_3602":75056,"_30987":74962,"_21467":128027,"_5":14750,"_28174":127742,"_3058":127785},[],{"_3602":75057,"_30987":74962,"_21467":128029,"_5":14750,"_28174":127742,"_3058":128030},[],"Despliegues 3.8.0 con bases de datos por servicio",{"_3602":75058,"_30987":74962,"_21467":128032,"_5":14750,"_28174":127742,"_3058":128033},[],"Alta: los servicios no encuentran datos, o una migración aborta",{"_3602":75059,"_30987":74962,"_21467":128035,"_5":14750,"_28174":127742,"_3058":128036},[],"Limpiar antes IDs de CA duplicados y `engine_id` vacíos; fuera de Helm, mover los datos a mano",{"_3602":75060,"_30987":74962,"_21467":128038,"_5":14750,"_28174":127742,"_3058":127789},[],{"_3602":75061,"_30987":74962,"_21467":128040,"_5":14750,"_28174":127742,"_3058":128041},[],"Despliegues sobre SQLite, `couch_db` o `dynamo_db`",{"_3602":75062,"_30987":74962,"_21467":128043,"_5":14750,"_28174":127742,"_3058":128044},[],"Alta: el backend ya no arranca con ellos",{"_3602":75063,"_30987":74962,"_21467":128046,"_5":14750,"_28174":127742,"_3058":128047},[],"Pasar a PostgreSQL antes de actualizar",{"_3602":75064,"_30987":74962,"_21467":128049,"_5":14750,"_28174":127742,"_3058":127833},[],{"_3602":75065,"_30987":74962,"_21467":128051,"_5":14750,"_28174":127742,"_3058":128052},[],"Todos los despliegues; también afecta a clientes de API, políticas personalizadas y suscripciones de alertas",{"_3602":75066,"_30987":74962,"_21467":128054,"_5":14750,"_28174":127742,"_3058":128055},[],"Alta: se eliminan las rutas `/v1/roles` y la migración es irreversible",{"_3602":75067,"_30987":74962,"_21467":128057,"_5":14750,"_28174":127742,"_3058":128058},[],"Corregir los datos en los que aborta la migración y hacer copia de la base de datos y del bucket de CRLs",{"_3602":75068,"_30987":74962,"_21467":128060,"_5":14750,"_28174":127742,"_3058":128061},[],"Webhooks con referencias a archivos",{"_3602":75069,"_30987":74962,"_21467":128063,"_5":14750,"_28174":127742,"_3058":128064},[],"DMS cuyo certificado o clave mTLS del webhook eran rutas de archivo",{"_3602":75070,"_30987":74962,"_21467":128066,"_5":14750,"_28174":127742,"_3058":128067},[],"Alta: los enrolamientos que llaman al webhook fallan",{"_3602":75071,"_30987":74962,"_21467":128069,"_5":14750,"_28174":127742,"_3058":128070},[],"Volver a introducir certificado y clave como PEM, o eliminar los campos de archivo",{"_3602":75072,"_30987":74962,"_21467":128072,"_5":14750,"_28174":127742,"_3058":127769},[],{"_3602":75073,"_30987":74962,"_21467":128074,"_5":14750,"_28174":127742,"_3058":128075},[],"Releases con identidades por servicio o material de claves montado",{"_3602":75074,"_30987":74962,"_21467":128077,"_5":14750,"_28174":127742,"_3058":128078},[],"Media: los servicios no pueden leer sus archivos",{"_3602":75075,"_30987":74962,"_21467":128080,"_5":14750,"_28174":127742,"_3058":128081},[],"Eliminar las sobrescrituras y corregir la propiedad de los volúmenes",{"_3602":75076,"_30987":74962,"_21467":128083,"_5":14750,"_28174":127742,"_3058":127773},[],{"_3602":75077,"_30987":74962,"_21467":128085,"_5":14750,"_28174":127742,"_3058":128086},[],"Releases que definen `amqp.tls`",{"_3602":75078,"_30987":74962,"_21467":128088,"_5":14750,"_28174":127742,"_3058":128089},[],"Media: los clientes se conectan al puerto equivocado",{"_3602":75079,"_30987":74962,"_21467":128091,"_5":14750,"_28174":127742,"_3058":128092},[],"Apuntar `amqp.port` al listener TLS, o desactivar TLS",{"_3602":75080,"_30987":74962,"_21467":128094,"_5":14750,"_28174":127742,"_3058":127793},[],{"_3602":75081,"_30987":74962,"_21467":128096,"_5":14750,"_28174":127742,"_3058":128097},[],"Instalaciones cuyas claves de CA son anteriores al KMS",{"_3602":75082,"_30987":74962,"_21467":128099,"_5":14750,"_28174":127742,"_3058":128100},[],"Media: las claves de CA quedan sin gestionar",{"_3602":75083,"_30987":74962,"_21467":128102,"_5":14750,"_28174":127742,"_3058":128103},[],"Ejecutar la migración de CA a KMS",{"_3602":75084,"_30987":74962,"_21467":128105,"_5":14750,"_28174":127742,"_3058":128106},[],"Verificación del certificado del receptor",{"_3602":75085,"_30987":74962,"_21467":128108,"_5":14750,"_28174":127742,"_3058":128109},[],"DMS cuyo webhook tenía `validate_server_cert: false`",{"_3602":75086,"_30987":74962,"_21467":128111,"_5":14750,"_28174":127742,"_3058":128112},[],"Media: las credenciales viajan a un receptor sin verificar",{"_3602":75087,"_30987":74962,"_21467":128114,"_5":14750,"_28174":127742,"_3058":128115},[],"Poner `insecure_skip_verify` a `false`",{"_3602":75088,"_30987":74962,"_21467":128117,"_5":14750,"_28174":127742,"_3058":127809},[],{"_3602":75089,"_30987":74962,"_21467":128119,"_5":14750,"_28174":127742,"_3058":128120},[],"Scripts y consolas que editan DMS por API",{"_3602":75090,"_30987":74962,"_21467":128122,"_5":14750,"_28174":127742,"_3058":128123},[],"Media: una edición con el formato antiguo vacía `validation_cas` sin avisar",{"_3602":75091,"_30987":74962,"_21467":128125,"_5":14750,"_28174":127742,"_3058":128126},[],"Leer el DMS antes de editarlo y usar el campo nuevo",{"_3602":75092,"_30987":74962,"_21467":128128,"_5":14750,"_28174":127742,"_3058":127829},[],{"_3602":75093,"_30987":74962,"_21467":128130,"_5":14750,"_28174":127742,"_3058":128131},[],"Clientes que crean o actualizan ajustes de CRL por API",{"_3602":75094,"_30987":74962,"_21467":128133,"_5":14750,"_28174":127742,"_3058":128134},[],"Media: las peticiones con el campo antiguo devuelven un error",{"_3602":75095,"_30987":74962,"_21467":128136,"_5":14750,"_28174":127742,"_3058":128137},[],"Sustituir `crl_options.subject_key_id_signer` por el obligatorio `crl_options.signer_serial_number`",{"_3602":75096,"_30987":74962,"_21467":128139,"_5":14750,"_28174":127742,"_3058":127837},[],{"_3602":75097,"_30987":74962,"_21467":128141,"_5":14750,"_28174":127742,"_3058":128142},[],"Suscripciones de alertas y consumidores de los eventos de la VA",{"_3602":75098,"_30987":74962,"_21467":128144,"_5":14750,"_28174":127742,"_3058":128145},[],"Media: los tipos de suscripción se renombran automáticamente, sus condiciones no",{"_3602":75099,"_30987":74962,"_21467":128147,"_5":14750,"_28174":127742,"_3058":128148},[],"Revisar las condiciones que filtran por el payload o el subject antiguo del evento",{"_3602":75100,"_30987":74962,"_21467":128150,"_5":14750,"_28174":127742,"_3058":127825},[],{"_3602":75101,"_30987":74962,"_21467":128152,"_5":14750,"_28174":127742,"_3058":128153},[],"Consumidores que leen el campo `events` del dispositivo",{"_3602":75102,"_30987":74962,"_21467":128155,"_5":14750,"_28174":127742,"_3058":128156},[],"Media: el campo desaparece",{"_3602":75103,"_30987":74962,"_21467":128158,"_5":14750,"_28174":127742,"_3058":128159},[],"Usar los nuevos endpoints de eventos",{"_3602":75104,"_30987":74962,"_21467":128161,"_5":14750,"_28174":127742,"_3058":127849},[],{"_3602":75105,"_30987":74962,"_21467":128163,"_5":14750,"_28174":127742,"_3058":128164},[],"Despliegues con roles VA cuyo firmante no puede resolverse de forma única",{"_3602":75106,"_30987":74962,"_21467":128166,"_5":14750,"_28174":127742,"_3058":128167},[],"Media: la migración de la VA aborta",{"_3602":75107,"_30987":74962,"_21467":128169,"_5":14750,"_28174":127742,"_3058":128170},[],"Corregir los roles afectados antes de actualizar",{"_3602":75108,"_30987":74962,"_21467":128172,"_5":14750,"_28174":127742,"_3058":127777},[],{"_3602":75109,"_30987":74962,"_21467":128174,"_5":14750,"_28174":127742,"_3058":128175},[],"Releases que sobrescriben `toolbox`, `services.connectors`, puertos, sondas o planificación",{"_3602":75110,"_30987":74962,"_21467":128177,"_5":14750,"_28174":127742,"_3058":128178},[],"Baja a media: errores de validación o cambios de valores por defecto",{"_3602":75111,"_30987":74962,"_21467":128180,"_5":14750,"_28174":127742,"_3058":128181},[],"Actualizar el archivo de values",{"_3602":75112,"_30987":74962,"_21467":128183,"_5":14750,"_28174":127742,"_3058":127817},[],{"_3602":75113,"_30987":74962,"_21467":128185,"_5":14750,"_28174":127742,"_3058":128186},[],"Clientes que envían el ID del DMS en el cuerpo de la actualización",{"_3602":75114,"_30987":74962,"_21467":128188,"_5":14750,"_28174":127742,"_3058":128189},[],"Baja: prevalece el ID de la URL",{"_3602":75115,"_30987":74962,"_21467":128191,"_5":14750,"_28174":127742,"_3058":128192},[],"Enviar el ID en la URL",{"_3602":75116,"_30987":74962,"_21467":128194,"_5":14750,"_28174":127742,"_3058":127841},[],{"_3602":75117,"_30987":74962,"_21467":128196,"_5":14750,"_28174":127742,"_3058":128197},[],"Clientes que envían un `id` al crear o importar CAs",{"_3602":75118,"_30987":74962,"_21467":128199,"_5":14750,"_28174":127742,"_3058":128200},[],"Baja: el ID del cuerpo se ignora y el campo desaparece",{"_3602":75119,"_30987":74962,"_21467":128202,"_5":14750,"_28174":127742,"_3058":128203},[],"Dejar que el backend asigne el ID y usar el que devuelve",{"_3602":75120,"_30987":74962,"_21467":128205,"_5":14750,"_28174":127742,"_3058":127845},[],{"_3602":75121,"_30987":74962,"_21467":128207,"_5":14750,"_28174":127742,"_3058":128208},[],"Clientes de API y SDK que llaman a `/v1/cas/{id}/signature/sign` o `/verify`, y suscripciones de alertas sobre `ca.sign.signature`",{"_3602":75122,"_30987":74962,"_21467":128210,"_5":14750,"_28174":127742,"_3058":128211},[],"Media: las llamadas devuelven `404` y las suscripciones no se disparan nunca",{"_3602":75123,"_30987":74962,"_21467":128213,"_5":14750,"_28174":127742,"_3058":128214},[],"Utilizar las operaciones `sign` y `verify` del KMS",{"_3602":75124,"_30987":74962,"_21467":128216,"_5":14750,"_28174":127742,"_3058":127821},[],{"_3602":75125,"_30987":74962,"_21467":128218,"_5":14750,"_28174":127742,"_3058":128219},[],"Consumidores que comparan el `type` del certificado",{"_3602":75126,"_30987":74962,"_21467":128221,"_5":14750,"_28174":127742,"_3058":128222},[],"Baja: dos valores cambian de nombre",{"_3602":75127,"_30987":74962,"_21467":128224,"_5":14750,"_28174":127742,"_3058":128225},[],"Adaptar los consumidores",{"_3602":75128,"_30987":74962,"_21467":128227,"_5":14750,"_28174":127742,"_3058":127813},[],{"_3602":75129,"_30987":74962,"_21467":128229,"_5":14750,"_28174":127742,"_3058":128230},[],"Cualquier DMS",{"_3602":75130,"_30987":74962,"_21467":128232,"_5":14750,"_28174":127742,"_3058":128233},[],"Baja: solo informativo",{"_3602":75131,"_30987":74962,"_21467":128235,"_5":14750,"_28174":127742,"_3058":128236},[],"Revisar ambos bloques antes de editar",{"_3602":75132,"_30987":74962,"_21467":128238,"_5":14750,"_28174":127749,"_3058":128239},[],"Kubernetes deriva el nombre del PVC de un StatefulSet a partir del nombre de su pod (`<volumeClaimTemplate>-<nombre-del-pod>`). Al renombrar los StatefulSets `kms` y `va`, `helm upgrade` enlaza PVC nuevos y vacíos en lugar de los existentes. El material de claves del KMS y las CRLs de la VA no se borran —los PVC antiguos quedan huérfanos, no eliminados—, pero los pods actualizados fallan con `no such file or directory` (KMS) o `code=NotFound` (VA) hasta que copies los datos. Afecta al KMS cuando `services.kms.cryptoEngines` usa un motor `filesystem` y a la VA cuando `services.va.fileStore.type` es `local`. El resto de recursos renombrados no tienen estado y se recrean sin riesgo de pérdida de datos.",{"_3602":75133,"_30987":74962,"_21467":128241,"_5":14750,"_28174":127749,"_3058":128242},[],"El paso 4 de la guía de migración copia los datos.",{"_3602":75134,"_30987":74962,"_21467":128244,"_5":14750,"_28174":127753,"_3058":128245},[],"`values.schema.json` rechaza las claves desconocidas, así que cualquier bloque que 4.0.0 haya eliminado o renombrado —`toolbox`, `auth.oidc.apiGateway`, `auth.authorization` y otros— hace fallar directamente `helm lint` y `helm upgrade`. El paso 2 recoge todos los cambios.",{"_3602":75135,"_30987":74962,"_21467":128247,"_5":14750,"_28174":127757,"_3058":128248},[],"En 4.0.0 el chart lee las credenciales de PostgreSQL, AMQP y SMTP de Secrets de Kubernetes en el namespace del release en lugar de valores inline: `postgres.existingSecret`, `amqp.existingSecret` y — cuando hay autenticación SMTP configurada — `services.alerts.smtp_server.existingSecret`, cada uno con `usernameKey` y `passwordKey` nombrando las claves de datos del Secret. Los valores inline `postgres.username`/`postgres.password` y `amqp.username`/`amqp.password` se eliminan y `values.schema.json` los rechaza, así que un archivo de values de 3.8.0 hace fallar `helm lint` y `helm upgrade` hasta que las credenciales pasen a Secrets.",{"_3602":75136,"_30987":74962,"_21467":128250,"_5":14750,"_28174":127757,"_3058":128251},[],"Los Secrets deben existir antes de ejecutar `helm upgrade`: el job de base de datos de pre-upgrade se conecta a PostgreSQL con ellos. El paso 2 los crea mediante el External Secrets Operator.",{"_3602":75137,"_30987":74962,"_21467":128253,"_5":14750,"_28174":127760,"_3058":128254},[],"3.8.0 no tenía servicio de autorización, así que un archivo de values de 3.8.0 no tiene nada desde lo que migrar: hay que añadir la configuración de `services.authz` a mano. Necesita el endpoint JWKS del proveedor de identidad, las bases de datos que usa el motor de autorización y un principal de bootstrap que coincida con la forma en que el proveedor asigna el rol de administrador. Sin un principal coincidente nadie puede administrar la PKI.",{"_3602":75138,"_30987":74962,"_21467":128256,"_5":14750,"_28174":127764,"_3058":128257},[],"`auth.oidc.apiGateway.jwks`, `auth.authorization.rolesClaim` y `auth.authorization.roles.admin` se eliminan sin alias de compatibilidad, y el schema los rechaza. Su configuración pasa a `services.authz`: la URL de JWKS se convierte en `services.authz.jwkUrl`, y el claim de roles y el rol de administrador pasan a ser una regla de claims del principal de bootstrap. `auth.oidc.frontend` no cambia.",{"_3602":75139,"_30987":74962,"_21467":128259,"_5":14750,"_28174":127768,"_3058":128260},[],"Las imágenes de servicio se basan en distroless y se ejecutan con el usuario numérico `65532`; la imagen de `authz` es Ubuntu con un usuario sin root que tiene el mismo UID. Se eliminan las sobrescrituras por servicio `services.kms.securityContext.runAsGroup: 0` y `services.authz.securityContext.runAsUser`/`runAsGroup: 999`; el acceso de grupo al volumen del KMS y al socket PKCS#11 lo gestiona ahora el `fsGroup: 65532` del pod.",{"_3602":75140,"_30987":74962,"_21467":128262,"_5":14750,"_28174":127768,"_3058":128263},[],"3.8.0 no fijaba la identidad del contenedor, por lo que los archivos existentes pueden tener cualquier UID. Todo volumen con claves o CRLs debe pertenecer a `65532:65532`, o al menos ser legible (y, si hace falta, escribible) por esa identidad.",{"_3602":75141,"_30987":74962,"_21467":128265,"_5":14750,"_28174":127768,"_3058":128266},[],"Los pods llevan ahora un `fsGroup: 65532` a nivel de pod con `fsGroupChangePolicy: OnRootMismatch`, que se salta los cambios recursivos de propiedad cuando la raíz del volumen ya tiene el grupo esperado. Si tus herramientas de backup o jobs usan otro GID, verifica que sigan pudiendo acceder a los volúmenes que necesitan.",{"_3602":75142,"_30987":74962,"_21467":128268,"_5":14750,"_28174":127772,"_3058":128269},[],"En 3.8.0 `amqp.tls` no se aplicaba y los clientes del bus de eventos se conectaban siempre en texto plano. En 4.0.0, `amqp.tls: true` los pasa a AMQPS. El valor por defecto de `amqp.port` sigue siendo `5672` y no cambia al activar TLS, así que un archivo de values que ya tuviera `amqp.tls: true` debe apuntar `amqp.port` al listener TLS del broker (`amqps`, habitualmente `5671`), o poner `amqp.tls: false` para seguir en texto plano. Los clientes deben además confiar en el certificado del broker.",{"_3602":75143,"_30987":74962,"_21467":128271,"_5":14750,"_28174":127776,"_3058":128272},[],"`toolbox` pasa a llamarse `connectivityTest`, y el hook de `helm test` usa la imagen upstream `curlimages/curl` fijada por digest.",{"_3602":75144,"_30987":74962,"_21467":128274,"_5":14750,"_28174":127776,"_3058":128275},[],"`services.connectors` pasa a ser un mapa indexado por ID de conector en lugar de una lista.",{"_3602":75145,"_30987":74962,"_21467":128277,"_5":14750,"_28174":127776,"_3058":128278},[],"El valor por defecto de `services.ui.port` es `8085`, el puerto sin privilegios de la imagen sin root.",{"_3602":75146,"_30987":74962,"_21467":128280,"_5":14750,"_28174":127776,"_3058":128281},[],"El bloque compartido `probes:` se sustituye por los bloques independientes `livenessProbe`, `readinessProbe` y `startupProbe`.",{"_3602":75147,"_30987":74962,"_21467":128283,"_5":14750,"_28174":127776,"_3058":128284},[],"Con `tls.certManagerOptions.issuer` vacío, el chart crea un issuer autofirmado con ámbito de release, por ejemplo `lamassu-downstream-ca-selfsigned-issuer`. El literal heredado `downstream-ca-selfsigned-issuer` se sigue aceptando y se resuelve a ese issuer.",{"_3602":75148,"_30987":74962,"_21467":128286,"_5":14750,"_28174":127776,"_3058":128287},[],"La anti-afinidad y el topology spread deben configurarse explícitamente con `affinity` y `topologySpreadConstraints`.",{"_3602":75149,"_30987":74962,"_21467":128289,"_5":14750,"_28174":127784,"_3058":128290},[],"Cada base de datos por servicio de 3.8.0 debe acabar como un esquema de `pki`, conservando su estructura, índices, restricciones, datos e historial de migraciones. El chart de Helm lo hace automáticamente; los despliegues sin Helm lo hacen a mano (consulta Despliegues sin Helm).",{"_3602":75150,"_30987":74962,"_21467":128292,"_5":14750,"_28174":127784,"_3058":128293},[],"Dos migraciones de esquema abortan con datos que 3.8.0 permitía, así que limpia los datos antes de actualizar:",{"_3602":75151,"_30987":74962,"_21467":128295,"_5":14750,"_28174":127784,"_3058":128296},[],"La migración de CA añade una restricción UNIQUE sobre `ca_certificates.id` y aborta si existen IDs de CA duplicados. Las importaciones ya rechazan los duplicados con `409`, así que normalmente no aparecen duplicados nuevos.",{"_3602":75152,"_30987":74962,"_21467":128298,"_5":14750,"_28174":127784,"_3058":128299},[],"La migración del KMS convierte la clave primaria en `(key_id, engine_id)` y aborta con `cannot promote (key_id, engine_id) to primary key: N row(s) have no engine_id; backfill them before migrating` cuando hay filas de `kms_keys` sin `engine_id`. Rellena antes `engine_id`.",{"_3602":75153,"_30987":74962,"_21467":128301,"_5":14750,"_28174":127784,"_3058":128302},[],"Esa misma migración del KMS elimina, con un `NOTICE`, los alias iguales a un ID de clave existente, porque los identificadores se resuelven ahora como ID de clave antes que como alias. Los alias afectados se descartan, no se redirigen.",{"_3602":75154,"_30987":74962,"_21467":128304,"_5":14750,"_28174":127788,"_3058":128305},[],"Se elimina el motor de almacenamiento SQLite, y los motores `couch_db` y `dynamo_db` no están registrados en 4.0.0: sus constantes de configuración siguen existiendo, pero no seleccionan ningún motor. Los despliegues sobre cualquiera de ellos deben pasar a PostgreSQL y consolidar sus datos en los esquemas de `pki` antes de actualizar.",{"_3602":75155,"_30987":74962,"_21467":128307,"_5":14750,"_28174":127792,"_3058":128308},[],"Los certificados de CA de tipo `MANAGED` o `IMPORTED_WITH_KEY` cuyas claves privadas son anteriores al servicio KMS tienen la clave guardada solo en el motor criptográfico, bajo el `subject_key_id` del certificado, sin registro en el KMS. La herramienta `ca-to-kms-migration` los registra:",{"_3602":75156,"_30987":74962,"_21467":128310,"_5":14750,"_28174":127792,"_3058":128311},[],"El `key_id` es el `subject_key_id` del certificado; solo coincide con el resumen SHA-256 de la clave pública si el SKI se calculó de esa forma.",{"_3602":75157,"_30987":74962,"_21467":128313,"_5":14750,"_28174":127792,"_3058":128314},[],"La herramienta es idempotente: las claves que ya están en el KMS se omiten, así que puede ejecutarse varias veces.",{"_3602":75158,"_30987":74962,"_21467":128316,"_5":14750,"_28174":127792,"_3058":128317},[],"Los certificados que no pueden leerse, o que carecen de motor o de ID de clave de sujeto, se omiten con un aviso. Revisa los logs y resuelve los registros afectados.",{"_3602":75159,"_30987":74962,"_21467":128319,"_5":14750,"_28174":127792,"_3058":128320},[],"Cuando certificados de CA que comparten un `subject_key_id` declaran `engine_id` en conflicto, la herramienta marca esa clave como fallida y sale con código `1`, lo que hace fallar un hook de preactualización de Helm. Resuelve el conflicto a mano antes de volver a ejecutarla.",{"_3602":75160,"_30987":74962,"_21467":128322,"_5":14750,"_28174":127792,"_3058":128323},[],"Una vez registradas las claves, los certificados las referencian en la base de datos y el KMS se niega a eliminar una clave que un certificado aún usa (`409` `key is in use`). Eliminar el registro de un certificado lo quita de la CRL y de OCSP, así que lee Antes de eliminar una clave antes de liberar una clave.",{"_3602":75161,"_30987":74962,"_21467":128325,"_5":14750,"_28174":127792,"_3058":128326},[],"Opcionalmente, las instalaciones con CAs importadas anteriores a 3.7 pueden arrancar el KMS una vez con `crypto_engines.migrate_keys_format: true`: el KMS renombra esas claves heredadas con nombre de SKI al resumen SHA-256 de su clave pública (el nombre antiguo se conserva como alias, y las referencias de los certificados se actualizan solas). Ejecútalo una vez y vuelve a desactivar la opción; repetirla es seguro.",{"_3602":75162,"_30987":74962,"_21467":128328,"_5":14750,"_28174":127792,"_3058":128329},[],"Con Helm, activa el hook para la actualización en el paso 2; sin Helm, ejecuta la herramienta a mano.",{"_3602":75163,"_30987":74962,"_21467":128331,"_5":14750,"_28174":127796,"_3058":128332},[],"Los certificados referencian ahora su clave del KMS, y los ajustes de CRL referencian su certificado firmante, de modo que no se puede eliminar una clave o un certificado en uso. La migración del KMS descarta los metadatos de clave heredados `lamassu.io/kms/binded-resources`. Antes de 4.0.0, eliminar una CA podía borrar su clave y dejar referencias a ella en los registros de certificado conservados. La migración de CA registra esas claves ausentes en el KMS solo con su clave pública para satisfacer las referencias conservadas. Estas entradas no pueden eliminarse mientras los certificados conservados las referencien; no recuperan la clave privada. En 4.0.0, eliminar una CA libera las referencias de su propio certificado actual y de sus certificados reemitidos vinculados antes de intentar eliminar la clave; los demás certificados que todavía la referencien impiden su eliminación.",{"_3602":75164,"_30987":74962,"_21467":128334,"_5":14750,"_28174":127804,"_3058":128335},[],"Las configuraciones de webhook almacenadas se reescriben al formato actual y sus campos se renombran:",{"_3602":75165,"_30987":74962,"_21467":128337,"_5":14750,"_28174":127804,"_3058":128338},[],"Campo en 3.8.0",{"_3602":75166,"_30987":74962,"_21467":128340,"_5":14750,"_28174":127804,"_3058":128341},[],"Campo en 4.0.0",{"_3602":75167,"_30987":74962,"_21467":128343,"_5":14750,"_28174":127804,"_3058":59657},[],{"_3602":75168,"_30987":74962,"_21467":128345,"_5":14750,"_28174":127804,"_3058":128346},[],"`insecure_skip_verify` (con el valor negado)",{"_3602":75169,"_30987":74962,"_21467":128348,"_5":14750,"_28174":127804,"_3058":59663},[],{"_3602":75170,"_30987":74962,"_21467":128350,"_5":14750,"_28174":127804,"_3058":59666},[],{"_3602":75171,"_30987":74962,"_21467":128352,"_5":14750,"_28174":127804,"_3058":59669},[],{"_3602":75172,"_30987":74962,"_21467":128354,"_5":14750,"_28174":127804,"_3058":59672},[],{"_3602":75173,"_30987":74962,"_21467":128356,"_5":14750,"_28174":127804,"_3058":59675},[],{"_3602":75174,"_30987":74962,"_21467":128358,"_5":14750,"_28174":127804,"_3058":59678},[],{"_3602":75175,"_30987":74962,"_21467":128360,"_5":14750,"_28174":127804,"_3058":128361},[],"Cuando el certificado y la clave mTLS heredados son ambos PEM, se trasladan a `mtls_options.cert_content` y `mtls_options.key_content` y no requieren acción. Hay dos casos que sí la requieren.",{"_3602":75176,"_30987":74962,"_21467":128363,"_5":14750,"_28174":127804,"_3058":128364},[],"**Webhooks con referencias a archivos.** Una configuración mixta, con el certificado en PEM y la clave como ruta de archivo, se migra a `mtls_options.cert_file` y `mtls_options.key_file`. La entrega del webhook rechaza esos campos en cada llamada, sea cual sea el modo de autenticación configurado, de modo que todos los enrolamientos y reenrolamientos que llaman a ese webhook fallan hasta corregir la configuración. Si el webhook usa mTLS, vuelve a introducir el certificado y la clave como PEM, en Base64 o en texto plano; si no lo usa, elimina los campos de archivo sobrantes. Mientras tanto, las actualizaciones de solo metadatos siguen funcionando (`PUT` o `PATCH` sobre `/v1/dms/:id/metadata`). En una variante del mismo problema, una configuración almacenada con rutas de archivo dentro de `mtls_options.cert_content` o `mtls_options.key_content` hace fallar la validación de toda actualización completa de ajustes (`POST /v1/dms` o `PUT /v1/dms/:id`); los ajustes se sustituyen al completo, así que reenvía la configuración con el certificado y la clave como PEM.",{"_3602":75177,"_30987":74962,"_21467":128366,"_5":14750,"_28174":127804,"_3058":128367},[],"**Verificación del certificado del receptor.** Una configuración con `validate_server_cert: false` pasa a `insecure_skip_verify: true`, así que la verificación del receptor sigue sin realizarse hasta que ese campo se ponga a `false`. Corrígelo en cada configuración migrada: el canal de autorización del webhook transporta la API key o el bearer token, y saltarse la verificación expone esas credenciales a un atacante con posición de red. Mantén `insecure_skip_verify: true` solo si el certificado del receptor no es verificable de forma deliberada.",{"_3602":75178,"_30987":74962,"_21467":128369,"_5":14750,"_28174":127808,"_3058":128370},[],"El campo plano `reenrollment_settings.additional_validation_cas` se traslada al campo anidado `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`:",{"_3602":75179,"_30987":74962,"_21467":128372,"_5":14750,"_28174":127808,"_3058":128373},[],"El conjunto de confianza efectivo no cambia, porque el valor anidado nunca se consultó al validar reenrolamientos. Si la lista plana estaba ausente o era nula, pasa a ser una lista vacía.",{"_3602":75180,"_30987":74962,"_21467":128375,"_5":14750,"_28174":127808,"_3058":128376},[],"Lo que cambia es el tratamiento de las peticiones por API. Los cuerpos que aún contienen `additional_validation_cas` se aceptan, pero su valor se descarta en silencio porque los campos JSON desconocidos se ignoran, y las respuestas GET ya no lo incluyen. Por tanto, un cuerpo de actualización construido con el formato antiguo vacía `validation_cas` sin ningún error. Lee siempre el DMS antes de enviar una edición y reutiliza el formato que devuelve la API.",{"_3602":75181,"_30987":74962,"_21467":128378,"_5":14750,"_28174":127812,"_3058":128379},[],"Los ajustes de autenticación del reenrolamiento se almacenan ahora de forma independiente de los de la autenticación inicial. No hay nada que migrar, pero lee ambos bloques antes de editar un DMS para no modificar uno creyendo que editas el otro. La consola expone editores independientes para ambos bloques; la guía de DMS describe sus campos, y también puedes editarlos mediante la API DMS.",{"_3602":75182,"_30987":74962,"_21467":128381,"_5":14750,"_28174":127816,"_3058":128382},[],"`PUT /v1/dms/:id` toma el ID del DMS de la URL y valida el cuerpo de la petición. Un ID en el cuerpo se ignora, así que actualiza los clientes que dependían de él.",{"_3602":75183,"_30987":74962,"_21467":128384,"_5":14750,"_28174":127820,"_3058":128385},[],"Los valores de tipo de certificado almacenados cambian de nombre: `IMPORTED` pasa a `IMPORTED_WITH_KEY` y `EXTERNAL` pasa a `IMPORTED_WITHOUT_KEY`. `MANAGED` no cambia. Adapta los consumidores que leen o comparan esos valores.",{"_3602":75184,"_30987":74962,"_21467":128387,"_5":14750,"_28174":127824,"_3058":128388},[],"El campo `events` ya no aparece en la representación del dispositivo. Apunta los consumidores a los nuevos endpoints:",{"_3602":75185,"_30987":74962,"_21467":128390,"_5":14750,"_28174":127824,"_3058":128391},[],"`GET /v1/devices/:id/events` devuelve los eventos de un dispositivo.",{"_3602":75186,"_30987":74962,"_21467":128393,"_5":14750,"_28174":127824,"_3058":128394},[],"`POST /v1/devices/:id/events` crea un evento.",{"_3602":75187,"_30987":74962,"_21467":128396,"_5":14750,"_28174":127824,"_3058":128397},[],"Cuando la cabecera `Accept` de la petición incluye `text/event-stream`, el endpoint de eventos emite por SSE con un keepalive cada 15 segundos, y responde `501` cuando SSE está deshabilitado en el despliegue. Cada instancia de Device Manager enlaza una cola AMQP duradera con el nombre de su ID de servicio, `device-manager-sse-<uuid>`. Las colas de instancias caídas o reemplazadas permanecen hasta que se eliminan, así que configura en el broker una política de expiración o limpieza.",{"_3602":75188,"_30987":74962,"_21467":128399,"_5":14750,"_28174":127828,"_3058":128400},[],"`crl_options.subject_key_id_signer` se sustituye por el obligatorio `crl_options.signer_serial_number`, el número de serie del certificado existente que firma la CRL. El valor inicial de una CA nueva es el número de serie de su certificado actual. Las peticiones que aún contienen `subject_key_id_signer` devuelven un error. La entidad de autorización que guarda estos ajustes también cambia de nombre; consulta Ajustes de CRL indexados por ID de CA.",{"_3602":75189,"_30987":74962,"_21467":128402,"_5":14750,"_28174":127832,"_3058":128403},[],"En 3.8.0 la VA indexaba cada CRL por el SKI de la CA, y `GET`/`PUT /v1/roles/{ca-ski}` la leían y actualizaban. En 4.0.0 los ajustes de CRL de una CA se indexan por su ID de CA, y cada CA tiene los suyos, incluso cuando dos CAs comparten clave:",{"_3602":75190,"_30987":74962,"_21467":128405,"_5":14750,"_28174":127832,"_3058":128406},[],"Ruta",{"_3602":75191,"_30987":74962,"_21467":128408,"_5":14750,"_28174":127832,"_3058":120772},[],{"_3602":75192,"_30987":74962,"_21467":128410,"_5":14750,"_28174":127832,"_3058":59731},[],{"_3602":75193,"_30987":74962,"_21467":128412,"_5":14750,"_28174":127832,"_3058":128413},[],"Lista los ajustes de CRL; filtrable al menos por `ca_id`, `status` y `legacy_ski`.",{"_3602":75194,"_30987":74962,"_21467":128415,"_5":14750,"_28174":127832,"_3058":59737},[],{"_3602":75195,"_30987":74962,"_21467":128417,"_5":14750,"_28174":127832,"_3058":128418},[],"Lee los ajustes de una CA.",{"_3602":75196,"_30987":74962,"_21467":128420,"_5":14750,"_28174":127832,"_3058":59743},[],{"_3602":75197,"_30987":74962,"_21467":128422,"_5":14750,"_28174":127832,"_3058":128423},[],"Sustituye los `crl_options`.",{"_3602":75198,"_30987":74962,"_21467":128425,"_5":14750,"_28174":127832,"_3058":59749},[],{"_3602":75199,"_30987":74962,"_21467":128427,"_5":14750,"_28174":127832,"_3058":128428},[],"Elimina los ajustes archivados de una CA.",{"_3602":75200,"_30987":74962,"_21467":128430,"_5":14750,"_28174":127832,"_3058":128431},[],"Las opciones conservan su significado y sus valores por defecto: 7 días de `validity`, 6 días y 23 horas de `refresh_interval`, y `regenerate_on_revoke` a `true`. `status` (`ACTIVE`, `FINAL` o `ARCHIVED`), `legacy_ski` y `latest_crl` son de solo lectura. Un `PUT` valida el firmante solo cuando cambia, no regenera la CRL y devuelve `409` cuando los ajustes no están `ACTIVE`.",{"_3602":75201,"_30987":74962,"_21467":128433,"_5":14750,"_28174":127832,"_3058":128434},[],"El endpoint público `GET /crl/{id}` toma el ID de la CA — la forma que usan los CDP de los certificados emitidos a partir de ahora — y sigue resolviendo la forma por SKI de los certificados emitidos antes de la actualización. Los certificados anteriores a la actualización conservan sus puntos de distribución `/crl/<ski>`; los recién emitidos llevan `/crl/<ca-id>`, y ambos resuelven a los mismos ajustes. El job de CRL de la VA solicita una lista nueva en su primera ejecución, y esta incluye ambas URLs en su *Issuing Distribution Point*. Hasta que lo consiga, la lista antigua solo contiene el IDP heredado `/crl/<ski>`: los verificadores que lo comparan con el CDP de certificados recién emitidos no pueden validar esos certificados. Con la frecuencia predeterminada, la primera ejecución puede tardar hasta aproximadamente una hora; los fallos pueden prolongar ese intervalo.",{"_3602":75202,"_30987":74962,"_21467":128436,"_5":14750,"_28174":127832,"_3058":128437},[],"La migración que convierte los roles de VA en ajustes de CRL no puede revertirse: su rollback no hace nada. Las CRLs generadas después de la actualización se guardan bajo el ID de CA, donde 3.8.0 no las busca, y los ajustes archivados de las CAs eliminadas antes de la actualización no tienen firmante al que volver. Volver a 3.8.0 exige restaurar tanto la base de datos como el bucket de CRLs — el almacenamiento de objetos que contiene las listas publicadas — a partir de las copias de seguridad tomadas antes de la actualización.",{"_3602":75203,"_30987":74962,"_21467":128439,"_5":14750,"_28174":127832,"_3058":128440},[],"La migración aborta, y con ella la actualización, con cinco tipos de datos:",{"_3602":75204,"_30987":74962,"_21467":128442,"_5":14750,"_28174":127832,"_3058":128443},[],"IDs de CA que contienen `/`: no pueden usarse en URLs de CRL. Recrea esas CAs con otro ID.",{"_3602":75205,"_30987":74962,"_21467":128445,"_5":14750,"_28174":127832,"_3058":128446},[],"Un SKI compartido por más de una CA: el error nombra los SKIs y pide recrear todas menos una con otra clave.",{"_3602":75206,"_30987":74962,"_21467":128448,"_5":14750,"_28174":127832,"_3058":128449},[],"Un rol de VA cuyo certificado firmante no tiene clave: apunta el rol a un firmante con clave, o corrige la referencia de clave del certificado, antes de actualizar.",{"_3602":75207,"_30987":74962,"_21467":128451,"_5":14750,"_28174":127832,"_3058":128452},[],"Una CA cuyo ID coincide con el ID `legacy-<ski>` que la migración reserva para los ajustes archivados de otro rol cuya CA se eliminó: recrea esa CA con otro ID.",{"_3602":75208,"_30987":74962,"_21467":128454,"_5":14750,"_28174":127832,"_3058":128455},[],"Un ID de CA igual al SKI de otro rol de VA: sus URLs de CRL serían ambiguas.",{"_3602":75209,"_30987":74962,"_21467":128457,"_5":14750,"_28174":127832,"_3058":128458},[],"Los ajustes de una CA eliminada antes de la actualización se migran como `ARCHIVED`, con un ID `legacy-<ski>` y sin firmante: su última CRL sigue sirviéndose, pero nunca se regenera, y `PUT` devuelve `409`. No hay forma de volver a `ACTIVE` por API. La guía de CRL describe el comportamiento completo.",{"_3602":75210,"_30987":74962,"_21467":128460,"_5":14750,"_28174":127832,"_3058":128461},[],"**Políticas de autorización personalizadas.** La entidad `va_role` se renombra a `crl_settings`, con `ca_id` como clave primaria y `signer_serial_number` como su relación con certificados. Actualiza las políticas que referencien la entidad antigua. La entidad incorpora la acción atómica `delete`, una relación `signer_key_id` con las claves del KMS y las columnas filtrables `signer_engine_id` y `signer_key_id`; concede la acción nueva a quien pueda borrar ajustes de CRL archivados. Sustituye el filtro de firmante de 3.8.0 `crl_subject_key_id_signer` (o `crl_signer_certificate_serial_number` si se usa en una versión intermedia) por `signer_serial_number`. Sustituye los valores SKI del filtro por los números de serie de los certificados correspondientes; cambiar solo el nombre del filtro no basta.",{"_3602":75211,"_30987":74962,"_21467":128463,"_5":14750,"_28174":127836,"_3058":128464},[],"`va.role.update` pasa a `va.crl-settings.update` y `va.role.crl.init` pasa a `va.crl-settings.init`; `va.role.crl.create` conserva su nombre y su payload. Todos los subjects cambian de `crl/<ski>` a `crl/<ca-id>`, y el payload de los eventos renombrados pasa del rol de VA antiguo a los ajustes de CRL de la CA, con `ca_id` en lugar de `ca_ski`. La migración de alerts renombra automáticamente los tipos de evento de las suscripciones existentes, pero no reescribe sus condiciones — JSON Path, JSON Schema o JavaScript: revisa las condiciones que filtren por el payload antiguo o por el subject antiguo `crl/<ski>`, incluidas las de `va.role.crl.create`. Los consumidores directos del bus de eventos y las búsquedas de auditoría deben adoptar por su cuenta los nombres y el payload nuevos.",{"_3602":75212,"_30987":74962,"_21467":128466,"_5":14750,"_28174":127840,"_3058":128467},[],"Crear o importar una CA la registra con un UUID generado por el backend. Cualquier `id` enviado en el cuerpo de la petición se ignora, y el campo desaparece de los cuerpos de creación e importación. Los scripts que enviaban su propio ID y se dirigían a la CA con él deben leer el ID que devuelve el backend.",{"_3602":75213,"_30987":74962,"_21467":128469,"_5":14750,"_28174":127844,"_3058":128470},[],"La clave de una CA ahora solo firma certificados. 3.8.0 permitía firmar datos arbitrarios con la clave de una CA mediante `POST /v1/cas/{id}/signature/sign` y comprobar el resultado con `POST /v1/cas/{id}/signature/verify`. 4.0.0 elimina ambos endpoints, los métodos `SignatureSign` y `SignatureVerify` de `CAService` en el SDK de Go y el evento `ca.sign.signature`. Una suscripción de alertas a ese evento deja de dispararse: elimínala o muévela a otro evento.",{"_3602":75214,"_30987":74962,"_21467":128472,"_5":14750,"_28174":127844,"_3058":128473},[],"Para firmar y verificar datos, utiliza las operaciones del KMS `POST /v1/keys/{id}/sign` y `POST /v1/keys/{id}/verify`, que tienen su propia autorización. Firmar un certificado con una CA que no está `ACTIVE`, o cuyo periodo de validez no incluye la hora actual, falla ahora con `400`, aunque el estado almacenado aún no haya pasado a `EXPIRED`: consulta Autoridades de certificación.",{"_3602":75215,"_30987":74962,"_21467":128475,"_5":14750,"_28174":127848,"_3058":128476},[],"La migración de la VA resuelve el firmante de cada rol a partir de su SKI guardado. Primero busca certificados de CA con ese SKI; si coinciden varios, selecciona la CA más antigua y registra un aviso. Si no coincide ningún certificado de CA, busca entre todos los certificados con ese SKI. La migración aborta con `cannot resolve signer certificate for VA role <ca-ski>, SKI <ski>` si esa búsqueda encuentra cero o varios candidatos. Corrige los roles afectados antes de actualizar.",{"_3602":75216,"_30987":74962,"_21467":128478,"_5":14750,"_28174":127852,"_3058":128479},[],"La actualización sigue un orden fijo: preparar los datos y los values, ejecutar `helm upgrade` y después copiar los datos del KMS y la VA a los volúmenes nuevos. La copia debe hacerse después de la actualización, porque los StatefulSets y PVC de destino no existen antes. Si no estás actualizando una release existente, ve directamente a Instalar con Helm.",{"_3602":75217,"_30987":74962,"_21467":128481,"_5":14750,"_28174":127856,"_3058":128482},[],"Haz una copia de seguridad verificable de PostgreSQL y del almacenamiento de objetos de las CRLs — el bucket de la VA, o el volumen local que contiene las CRLs — y programa una parada de servicio. La actualización mueve los datos de todos los servicios a `pki`, y la migración de la VA es irreversible: volver a 3.8.0 requiere ambas copias (consulta Ajustes de CRL indexados por ID de CA).",{"_3602":75218,"_30987":74962,"_21467":128484,"_5":14750,"_28174":127856,"_3058":128485},[],"Si el despliegue usa SQLite, `couch_db` o `dynamo_db`, pásalo antes a PostgreSQL.",{"_3602":75219,"_30987":74962,"_21467":128487,"_5":14750,"_28174":127856,"_3058":128488},[],"Resuelve los IDs de CA duplicados y rellena `engine_id` en `kms_keys`, como se describe en Consolidación en PostgreSQL.",{"_3602":75220,"_30987":74962,"_21467":128490,"_5":14750,"_28174":127856,"_3058":128491},[],"Opcionalmente, ejecuta la comprobación previa a la actualización sobre los datos de 3.8.0 consolidados antes de aplicar las migraciones.",{"_3602":75221,"_30987":74962,"_21467":128493,"_5":14750,"_28174":127856,"_3058":128494},[],"Anota los nombres de tus PVC de almacenamiento local:",{"_3602":75222,"_30987":74962,"_21467":128496,"_5":14750,"_28174":127856,"_3058":128497},[],"`helm upgrade` no toca ni borra los PVC antiguos, pero tras la actualización nada los referencia. Necesitas sus nombres para copiar los datos y para limpiar más tarde.",{"_3602":75223,"_30987":74962,"_21467":128499,"_5":14750,"_28174":127860,"_3058":128500},[],"Las migraciones de base de datos de 4.0.0 se niegan a ejecutarse con datos que no pueden migrar de forma segura: abortan y nombran los objetos conflictivos. La herramienta `upgrade-check` informa de todos esos problemas antes de la actualización, en una única ejecución y con el mismo texto que usaría la migración. Es de solo lectura: nunca escribe filas en la base de datos ni claves.",{"_3602":75224,"_30987":74962,"_21467":128502,"_5":14750,"_28174":127860,"_3058":128503},[],"Imagen: `ghcr.io/lamassuiot/lamassu-upgrade-check`. Se configura con un archivo YAML al estilo del KMS pasado por `LAMASSU_CONFIG_FILE`; solo admite el proveedor de almacenamiento `postgres`.",{"_3602":75225,"_30987":74962,"_21467":128505,"_5":14750,"_28174":127860,"_3058":128506},[],"Ejecútala sobre los datos de 3.8.0 una vez consolidados en los esquemas de `pki`, y antes de que se ejecute cualquier migración de 4.0.0 o arranque cualquier servicio de 4.0.0.",{"_3602":75226,"_30987":74962,"_21467":128508,"_5":14750,"_28174":127860,"_3058":128509},[],"Códigos de salida: `0` significa que no se encontraron problemas, `1` que se encontró al menos uno y `2` que la orden no pudo ejecutarse (configuración incorrecta, base de datos inalcanzable o una base de datos que no es de 3.8.0), o que alguna comprobación no pudo ejecutarse.",{"_3602":75227,"_30987":74962,"_21467":128511,"_5":14750,"_28174":127860,"_3058":128512},[],"Cubre solo las migraciones de la VA: un resultado limpio no demuestra que las comprobaciones de las migraciones de CA y del KMS vayan a pasar, así que no sustituye a las verificaciones de IDs de CA duplicados y de `engine_id` descritas en Consolidación en PostgreSQL.",{"_3602":75228,"_30987":74962,"_21467":128514,"_5":14750,"_28174":127864,"_3058":128515},[],"**Crea los Secrets de credenciales.** El chart de 4.0.0 lee las credenciales de PostgreSQL, AMQP y SMTP de Secrets de Kubernetes, y el job de base de datos de pre-upgrade las necesita antes de que se ejecute la actualización. Copia las credenciales de 3.8.0 a tu proveedor de gestión de secretos y crea los Secrets con el External Secrets Operator (ESO), que el chart no instala:",{"_3602":75229,"_30987":74962,"_21467":128517,"_5":14750,"_28174":127864,"_3058":128518},[],"Configura ESO y su proveedor (`SecretStore` o `ClusterSecretStore`).",{"_3602":75230,"_30987":74962,"_21467":128520,"_5":14750,"_28174":127864,"_3058":128521},[],"Crea un `ExternalSecret` por cada conjunto de credenciales que uses. Su Secret de destino debe vivir en el namespace de la release, llamarse como el valor `existingSecret` correspondiente y contener estas claves:",{"_3602":75231,"_30987":74962,"_21467":128523,"_5":14750,"_28174":127864,"_3058":59848},[],{"_3602":75232,"_30987":74962,"_21467":128525,"_5":14750,"_28174":127864,"_3058":128526},[],"Claves de datos obligatorias",{"_3602":75233,"_30987":74962,"_21467":128528,"_5":14750,"_28174":127864,"_3058":128529},[],"Cuándo",{"_3602":75234,"_30987":74962,"_21467":128531,"_5":14750,"_28174":127864,"_3058":128532},[],"`lamassu-postgres` (por defecto de `postgres.existingSecret`)",{"_3602":75235,"_30987":74962,"_21467":128534,"_5":14750,"_28174":127864,"_3058":59860},[],{"_3602":75236,"_30987":74962,"_21467":128536,"_5":14750,"_28174":127864,"_3058":128537},[],"Siempre",{"_3602":75237,"_30987":74962,"_21467":128539,"_5":14750,"_28174":127864,"_3058":128540},[],"`lamassu-amqp` (por defecto de `amqp.existingSecret`)",{"_3602":75238,"_30987":74962,"_21467":128542,"_5":14750,"_28174":127864,"_3058":59860},[],{"_3602":75239,"_30987":74962,"_21467":128544,"_5":14750,"_28174":127864,"_3058":128537},[],{"_3602":75240,"_30987":74962,"_21467":128546,"_5":14750,"_28174":127864,"_3058":59873},[],{"_3602":75241,"_30987":74962,"_21467":128548,"_5":14750,"_28174":127864,"_3058":59860},[],{"_3602":75242,"_30987":74962,"_21467":128550,"_5":14750,"_28174":127864,"_3058":128551},[],"Solo cuando hay autenticación SMTP",{"_3602":75243,"_30987":74962,"_21467":128553,"_5":14750,"_28174":127864,"_3058":128554},[],"Espera a que cada `ExternalSecret` esté Ready y verifica los Secrets generados antes de ejecutar la actualización.",{"_3602":75244,"_30987":74962,"_21467":128556,"_5":14750,"_28174":127864,"_3058":128557},[],"No cambies las contraseñas de la base de datos ni del broker como parte de esta migración: ESO sincroniza credenciales en Secrets, pero no actualiza los usuarios configurados en el servidor PostgreSQL ni en el broker. Quitar credenciales del archivo de values no deshace la exposición previa — si se llegaron a subir a Git, rotarlas cuando la migración se haya completado.",{"_3602":75245,"_30987":74962,"_21467":128559,"_5":14750,"_28174":127864,"_3058":128560},[],"El `charts/lamassu/README.md` del repositorio Helm documenta en su sección *Secret management* un ejemplo completo y funcional: instalar external-secrets 0.20.2, un `ClusterSecretStore` Fake de prueba, los recursos `ExternalSecret` y la espera de la sincronización. Su proveedor Fake es solo para pruebas; para producción, sustitúyelo por la configuración de tu proveedor.",{"_3602":75246,"_30987":74962,"_21467":128562,"_5":14750,"_28174":127864,"_3058":128563},[],"**Añade `services.authz`.** Configura el endpoint JWKS, las bases de datos y el principal de bootstrap:",{"_3602":75247,"_30987":74962,"_21467":128565,"_5":14750,"_28174":127864,"_3058":128566},[],"`jwkUrl` se consulta desde el pod de `authz`, no desde el gateway, así que un Service del namespace de la release puede referenciarse por su nombre corto. El valor por defecto apunta a un Service de Keycloak llamado `auth-keycloak`; defínelo explícitamente si tu proveedor de identidad está en otro sitio.",{"_3602":75248,"_30987":74962,"_21467":128568,"_5":14750,"_28174":127864,"_3058":128569},[],"`authz` es el almacenamiento propio del servicio de autorización para principales, permisos y políticas. `pki` es la base de datos que consulta el motor de autorización al evaluar las políticas sobre las entidades. Solo se exige el campo `database` de cada entrada; los `hostname` y `port` por esquema se siguen aceptando pero se ignoran — la conexión usa siempre los `postgres.hostname` y `postgres.port` globales con el Secret de credenciales de PostgreSQL global, `postgres.existingSecret` con sus nombres de clave configurados, salvo que la entrada defina su propio `existingSecret` (con `usernameKey` y `passwordKey` opcionales).",{"_3602":75249,"_30987":74962,"_21467":128571,"_5":14750,"_28174":127864,"_3058":128572},[],"Si mantuviste los roles por defecto de 3.8.0 (`realm_access.roles` y `pki-admin`), el `services.authz.bootstrap` por defecto ya coincide con ellos.",{"_3602":75250,"_30987":74962,"_21467":128574,"_5":14750,"_28174":127864,"_3058":128575},[],"**Elimina los bloques de validación de tokens del gateway.** Quita `auth.oidc.apiGateway` y `auth.authorization` una vez que su configuración esté en `services.authz`:",{"_3602":75251,"_30987":74962,"_21467":128577,"_5":14750,"_28174":127864,"_3058":128578},[],"**Renombra `toolbox` a `connectivityTest`:**",{"_3602":75252,"_30987":74962,"_21467":128580,"_5":14750,"_28174":127864,"_3058":128581},[],"**Elimina las sobrescrituras de identidad por servicio** `services.kms.securityContext.runAsGroup` y `services.authz.securityContext.runAsUser`/`runAsGroup`.",{"_3602":75253,"_30987":74962,"_21467":128583,"_5":14750,"_28174":127864,"_3058":128584},[],"**Convierte `services.connectors` en un mapa** indexado por ID de conector, con el `type` y la `image` de cada entrada:",{"_3602":75254,"_30987":74962,"_21467":128586,"_5":14750,"_28174":127864,"_3058":128587},[],"**Revisa AMQP.** Si defines `amqp.tls: true`, define también `amqp.port` con el listener TLS del broker (habitualmente `5671`), o pon `amqp.tls: false` para seguir en texto plano.",{"_3602":75255,"_30987":74962,"_21467":128589,"_5":14750,"_28174":127864,"_3058":128590},[],"**Activa la migración de CA a KMS** si tus claves de CA son anteriores al KMS:",{"_3602":75256,"_30987":74962,"_21467":128592,"_5":14750,"_28174":127864,"_3058":128593},[],"**Revisa el resto de values:** sobrescrituras que fijaban `services.ui.port` a `80`, el antiguo bloque `probes:`, el issuer de TLS, y `affinity` y `topologySpreadConstraints` explícitos donde tu clúster los necesite. Values renombrados y reestructurados describe cada uno.",{"_3602":75257,"_30987":74962,"_21467":128595,"_5":14750,"_28174":127864,"_3058":128596},[],"Ejecuta `helm lint` con los values nuevos antes de actualizar; el schema estricto informa de cualquier clave que siga siendo desconocida. Antes de ejecutar el paso 3, confirma que cada `ExternalSecret` de credenciales esté Ready y que los Secrets generados contengan las claves esperadas.",{"_3602":75258,"_30987":74962,"_21467":128598,"_5":14750,"_28174":127868,"_3058":128599},[],"Helm ejecuta los hooks de preactualización —la migración de CA a KMS si está activada y el job de base de datos— antes de aplicar ninguna carga, así que los servicios nunca arrancan contra una base de datos sin preparar. Si la validación rechaza values desconocidos, corrige el archivo y vuelve a ejecutar.",{"_3602":75259,"_30987":74962,"_21467":128601,"_5":14750,"_28174":127868,"_3058":128602},[],"Si el despliegue usa almacenamiento local en el KMS o la VA, esos pods fallan hasta que completes el paso 4, así que `--wait` no puede terminar bien: Helm espera a que estén listos, agota el tiempo, sale con error y marca la release como `failed`. Para entonces los hooks ya se han ejecutado y se han aplicado todos los manifiestos, incluidos los nuevos StatefulSets y sus PVC. Sin `--atomic`, Helm no revierte nada. Continúa con el paso 4 y después vuelve a lanzar el mismo comando `helm upgrade` para que termine y Helm registre la release como `deployed`. Los dos hooks son idempotentes, así que es seguro volver a ejecutarlos.",{"_3602":75260,"_30987":74962,"_21467":128604,"_5":14750,"_28174":127872,"_3058":128605},[],"Omite este paso si `services.kms.cryptoEngines` nunca usó un motor `filesystem` y `services.va.fileStore.type` nunca fue `local`.",{"_3602":75261,"_30987":74962,"_21467":128607,"_5":14750,"_28174":127872,"_3058":128608},[],"**Localiza los nuevos StatefulSets y PVC.** Sus nombres dependen del nombre de la release y de cualquier `nameOverride` o `fullnameOverride`; el nombre del PVC es `<volumeClaimTemplate>-<nombre del StatefulSet>-0`:",{"_3602":75262,"_30987":74962,"_21467":128610,"_5":14750,"_28174":127872,"_3058":128611},[],"Con la release `lamassu` y el nombre de chart por defecto, los nuevos PVC son `golang-engine-storage-lamassu-kms-0` y `local-crl-file-storage-lamassu-va-0`; con la release `prod` son `golang-engine-storage-prod-lamassu-kms-0` y `local-crl-file-storage-prod-lamassu-va-0`. Comprueba que existen los PVC antiguos y nuevos antes de continuar. Si `claims_ok` imprime `ABORT`, el bloque se detiene antes de listar las PVC: o falló la búsqueda de un StatefulSet, o una PVC nueva resuelve a la PVC de 3.8.0. En el segundo caso la copia se verificaría contra sí misma y la limpieza final borraría el volumen en uso. El chart siempre añade `-kms` y `-va` al nombre con ámbito de release, así que una colisión indica que las PVC no son las que esta guía espera; investiga antes de seguir. El punto 3 repite la comprobación y no crea el pod auxiliar, así que nada toca los volúmenes. La comprobación devuelve un error en lugar de llamar a `exit`, que cerraría tu shell y perdería las variables definidas hasta ahora. Si solo migras uno de los dos servicios, quita las PVC del otro de los comandos siguientes.",{"_3602":75263,"_30987":74962,"_21467":128613,"_5":14750,"_28174":127872,"_3058":128614},[],"**Anota el número de réplicas, reduce a cero los nuevos StatefulSets y espera a que terminen todos los pods que usan las PVC**, para que nada escriba en ninguno de los volúmenes mientras copias. Helm elimina los StatefulSets `kms` y `va` de 3.8.0 durante la actualización, pero sus pods `kms-0` y `va-0` pueden seguir terminando y reteniendo las PVC antiguas. Mientras sigan en marcha, el pod auxiliar no puede montar las PVC o copia un volumen en el que aún se escribe. El `wait` termina al instante para los pods que ya no existen:",{"_3602":75264,"_30987":74962,"_21467":128616,"_5":14750,"_28174":127872,"_3058":128617},[],"**Arranca un pod auxiliar efímero** que monte las cuatro PVC. Se ejecuta como root para poder cambiar la propiedad de los archivos, así que fija su imagen por digest y no montes el token de la service account:",{"_3602":75265,"_30987":74962,"_21467":128619,"_5":14750,"_28174":127872,"_3058":128620},[],"**Inspecciona antes de escribir** para no machacar datos que los pods nuevos pudieran haber escrito ya:",{"_3602":75266,"_30987":74962,"_21467":128622,"_5":14750,"_28174":127872,"_3058":128623},[],"Un resultado vacío es lo habitual: el pod propio de un StatefulSet rara vez llega a escribir nada cuando le faltan sus datos. Si la salida no está vacía, anota los archivos y confirma con el responsable del servicio que se pueden descartar antes de copiar; no superpongas los datos de 3.8.0 sobre un almacén desconocido.",{"_3602":75267,"_30987":74962,"_21467":128625,"_5":14750,"_28174":127872,"_3058":128626},[],"**Copia los datos, ajusta la propiedad y verifica la copia.** El segundo comando debe imprimir `copy verified`; cualquier salida de `diff` indica que la copia está incompleta, así que no continúes:",{"_3602":75268,"_30987":74962,"_21467":128628,"_5":14750,"_28174":127872,"_3058":128629},[],"El `chown` es obligatorio aunque los archivos antiguos ya parezcan pertenecer a un usuario sin root, porque 4.0.0 exige exactamente `65532:65532` y no recurre a lo que declare la imagen.",{"_3602":75269,"_30987":74962,"_21467":128631,"_5":14750,"_28174":127872,"_3058":128632},[],"**Elimina el auxiliar y restaura el número de réplicas anotado:**",{"_3602":75270,"_30987":74962,"_21467":128634,"_5":14750,"_28174":127872,"_3058":128635},[],"**Vuelve a lanzar el comando `helm upgrade` del paso 3.** Los pods del KMS y la VA arrancan ahora con los datos copiados, así que `--wait` termina bien y la release pasa de `failed` a `deployed`.",{"_3602":75271,"_30987":74962,"_21467":128637,"_5":14750,"_28174":127876,"_3058":128638},[],"Cuando la actualización que realizó la migración de CA a KMS termine correctamente, quita `migrations.caToKms.enabled` de tus values (su valor por defecto es `false`). El hook lee el ConfigMap heredado `kms-config` de 3.8.0 mientras existe y, cuando desaparece, recurre al ConfigMap con ámbito de release `<release>-lamassu-kms-config`.",{"_3602":75272,"_30987":74962,"_21467":128640,"_5":14750,"_28174":127876,"_3058":128641},[],"Después recorre el checklist de validación. Conserva los PVC antiguos hasta que lo superes.",{"_3602":75273,"_30987":74962,"_21467":128643,"_5":14750,"_28174":127880,"_3058":128644},[],"Sin el job de base de datos del chart, ninguna herramienta mueve datos entre bases de datos: las herramientas de migración solo aplican migraciones sobre un esquema que ya existe. Traslada tú cada base de datos por servicio a su esquema de `pki`, conservando estructura, índices, restricciones, datos e historial de migraciones, con las escrituras detenidas y una copia de seguridad verificada.",{"_3602":75274,"_30987":74962,"_21467":128646,"_5":14750,"_28174":127880,"_3058":128647},[],"Ejecuta las migraciones en el orden obligatorio, un esquema cada vez: primero `kms`, después la herramienta `ca-to-kms-migration` (necesaria solo en despliegues heredados cuyas claves de CA se nombran por SKI), luego `ca` y por último `va`. Los esquemas `devicemanager`, `dmsmanager` y `alerts` son independientes y pueden migrarse en cualquier orden. Con Helm, el job de preinstalación del chart aplica los esquemas en el orden correcto automáticamente.",{"_3602":75275,"_30987":74962,"_21467":128649,"_5":14750,"_28174":127880,"_3058":128650},[],"Si `kms` no se ha migrado, la migración de `ca` falla con `kms schema not found: migrate the kms schema before the ca schema`. La migración de `va` requiere que `ca` y `kms` se hayan migrado primero: falla con `ca schema not found: migrate the ca schema before the va schema` o `kms schema not found: migrate the kms schema before the va schema` si falta alguno de los dos.",{"_3602":75276,"_30987":74962,"_21467":128652,"_5":14750,"_28174":127880,"_3058":128653},[],"Los esquemas se referencian entre sí, así que el rol de PostgreSQL que ejecuta las migraciones necesita privilegios entre esquemas: el esquema `ca` necesita `USAGE` sobre `kms` más `SELECT`, `REFERENCES` e `INSERT` sobre `kms.kms_keys`, y el esquema `va` necesita `USAGE` sobre `ca` más `SELECT` y `REFERENCES` sobre `ca.certificates`, `SELECT` sobre `ca.ca_certificates`, y `USAGE` sobre `kms` más `SELECT` y `REFERENCES` sobre `kms.kms_keys`. Sin ellos la migración aborta; concede los privilegios que falten y vuelve a ejecutar el esquema fallido. Tras migrar `ca`, si el servicio de CA corre con un usuario distinto del usuario de migración, concédele `SELECT` sobre `ca.certificates_view` (`GRANT SELECT ON ca.certificates_view TO service_user`). Sin ese permiso, las lecturas de certificados y CAs fallan con `permission denied for table certificates_view`. Tras migrar `va`, si el servicio de CA corre con un usuario distinto, concédele `USAGE` sobre el esquema `va` y `SELECT` sobre `va.crl_settings` (`GRANT USAGE ON SCHEMA va TO service_user; GRANT SELECT ON va.crl_settings TO service_user`): el servicio de CA lee `va.crl_settings` cuando elimina una CA, y sin estos permisos toda eliminación de una CA que tenga motor criptográfico falla con `permission denied for schema va` (o `for table crl_settings`).",{"_3602":75277,"_30987":74962,"_21467":128655,"_5":14750,"_28174":127880,"_3058":128656},[],"Para aplicar las migraciones a mano, `goose-lamassu` debe ejecutarse contra la base `pki` con `search_path=<esquema>` en la cadena de conexión. El binario solo valida `search_path`, no el nombre de la base de datos, así que comprueba `dbname=pki` antes de ejecutarlo, y repítelo para `kms`, `ca`, `va`, `devicemanager`, `dmsmanager` y `alerts`:",{"_3602":75278,"_30987":74962,"_21467":128658,"_5":14750,"_28174":127880,"_3058":128659},[],"Ejecuta `ca-to-kms-migration` primero con `--dry-run`, que informa sin escribir en el almacenamiento del KMS, y después de forma real:",{"_3602":75279,"_30987":74962,"_21467":128661,"_5":14750,"_28174":127880,"_3058":128662},[],"Apunta la configuración `storage` de la herramienta a la base `pki`, donde los datos de CA y del KMS viven ahora en los esquemas `ca` y `kms`. Las opciones de la herramienta se describen en `backend/cmd/ca-to-kms-migration/README.md`, en el repositorio `lamassuiot`.",{"_3602":75280,"_30987":74962,"_21467":128664,"_5":14750,"_28174":127880,"_3058":128665},[],"Los README de ambas herramientas documentan el formato de 4.0.0 con la base `pki` y coinciden con esta página: `goose-lamassu` usa ejemplos con `dbname=pki` y no valida el nombre de la base de datos, y el README de `ca-to-kms-migration` describe la base única `pki` y el orden de migración.",{"_3602":75281,"_30987":74962,"_21467":128667,"_5":14750,"_28174":127884,"_3058":128668},[],"**Los pods del KMS o la VA fallan con `no such file or directory` o `code=NotFound` justo después de actualizar.** Los pods están enlazados a los PVC nuevos y vacíos y la migración de datos aún no se ha hecho, o se copió en el PVC equivocado. Sigue el paso 4 y comprueba que existen las cuatro PVC.",{"_3602":75282,"_30987":74962,"_21467":128670,"_5":14750,"_28174":127884,"_3058":128671},[],"**`helm upgrade --wait` agota el tiempo y `helm status` muestra la release como `failed`.** Con almacenamiento local en el KMS o la VA es lo esperado en la primera ejecución: los nuevos pods no pueden estar listos hasta que se copien sus datos. Los hooks se ejecutaron y los manifiestos y PVC se aplicaron, así que completa el paso 4 y vuelve a lanzar el mismo comando `helm upgrade`. Si otros pods tampoco están listos, revisa sus logs, porque falla algo más.",{"_3602":75283,"_30987":74962,"_21467":128673,"_5":14750,"_28174":127884,"_3058":128674},[],"**El pod auxiliar se queda en `Pending` o `ContainerCreating` y `kubectl wait` agota el tiempo.** Otro pod sigue reteniendo alguna de las PVC; en almacenamiento de bloque, `kubectl describe pod pvc-migrate-helper` muestra un `Multi-Attach error`. Comprueba con `kubectl get pods -n $NAMESPACE` que `kms-0`, `va-0` y los nuevos pods del KMS y la VA han desaparecido, y vuelve a ejecutar el wait.",{"_3602":75284,"_30987":74962,"_21467":128676,"_5":14750,"_28174":127884,"_3058":128677},[],"**`helm upgrade` falla con un error de validación por clave desconocida.** Elimina o renombra los values heredados —normalmente `toolbox`, `auth.oidc.apiGateway` o `auth.authorization`—, porque el schema estricto rechaza las claves que no conoce.",{"_3602":75285,"_30987":74962,"_21467":128679,"_5":14750,"_28174":127884,"_3058":128680},[],"**La actualización falla en el job de base de datos.** El rol de PostgreSQL no puede crear bases de datos o esquemas, o una migración de esquema abortó: por IDs de CA duplicados o por valores de `engine_id` vacíos, o en el esquema de la VA por un ID de CA que contiene `/`, un SKI compartido por más de una CA (el error pide recrear todas menos una con otra clave), un rol cuyo certificado firmante no tiene clave, un ID de CA reservado para los ajustes archivados de otro rol, o un ID de CA igual al SKI de otro rol. El mensaje de aborto nombra los objetos conflictivos; corrígelos y vuelve a ejecutar la actualización.",{"_3602":75286,"_30987":74962,"_21467":128682,"_5":14750,"_28174":127884,"_3058":128683},[],"**La actualización falla en el hook de CA a KMS.** Hay certificados de CA que comparten un `subject_key_id` y declaran `engine_id` en conflicto. Resuelve el conflicto y vuelve a ejecutar.",{"_3602":75287,"_30987":74962,"_21467":128685,"_5":14750,"_28174":127884,"_3058":128686},[],"**Nadie puede iniciar sesión tras la actualización.** Comprueba que `services.authz.jwkUrl` es accesible desde el pod de `authz`, que `services.authz.bootstrap` coincide con un rol que tu proveedor OIDC asigna realmente y que el job de base de datos terminó.",{"_3602":75288,"_30987":74962,"_21467":128688,"_5":14750,"_28174":127884,"_3058":128689},[],"**Una migración aborta con `kms schema not found`.** Los esquemas deben migrarse en orden: ejecuta la migración del esquema `kms` antes que las migraciones de los esquemas `ca` y `va`.",{"_3602":75289,"_30987":74962,"_21467":128691,"_5":14750,"_28174":127884,"_3058":128692},[],"**Una migración aborta con `ca schema not found`.** Ejecuta la migración del esquema `ca` antes que la del esquema `va`.",{"_3602":75290,"_30987":74962,"_21467":128694,"_5":14750,"_28174":127884,"_3058":128695},[],"**La migración de VA falla con `cannot resolve signer certificate for VA role ... N candidates`.** La migración no puede identificar un certificado firmante de forma única a partir del SKI guardado en el rol. Revisa el SKI y los certificados candidatos indicados en el error; corrige los datos anteriores a la migración con una copia de seguridad verificada y vuelve a ejecutar la migración. El nuevo campo `signer_serial_number` se crea durante esa migración, por lo que no se puede configurar mediante la API de VA mientras esta falla.",{"_3602":75291,"_30987":74962,"_21467":128697,"_5":14750,"_28174":127884,"_3058":128698},[],"**Una migración o un servicio falla con `permission denied for table ...` o `permission denied for schema ...`.** Al rol de PostgreSQL le faltan los privilegios entre esquemas listados en Despliegues sin Helm; incluye `certificates_view` cuando se omitió el `GRANT SELECT` posterior a la migración, y `permission denied for schema va` (o `for table crl_settings`) al eliminar una CA sin los permisos de `va`. Concede los privilegios que falten y vuelve a ejecutar.",{"_3602":75292,"_30987":74962,"_21467":128700,"_5":14750,"_28174":127887,"_3058":128701},[],"Tras la actualización, comprueba en este orden:",{"_3602":75293,"_30987":74962,"_21467":128703,"_5":14750,"_28174":127887,"_3058":128704},[],"**Bases de datos.** Cada servicio lee la base `pki` con su propio esquema, los datos de `authz` y `wfx` son accesibles y el estado de las migraciones está registrado por esquema, incluidas las migraciones del ID único de CA y de la clave compuesta del KMS, y las migraciones de claves foráneas que se ejecutan por esquema en el orden obligatorio.",{"_3602":75294,"_30987":74962,"_21467":128706,"_5":14750,"_28174":127887,"_3058":128707},[],"**KMS y VA arrancan sin errores.** Sus logs no muestran errores `no such file or directory` ni `code=NotFound`.",{"_3602":75295,"_30987":74962,"_21467":128709,"_5":14750,"_28174":127887,"_3058":128710},[],"**Las claves existentes del KMS funcionan.** Emite un certificado desde una CA que ya existía antes de la actualización. Ninguna de las otras comprobaciones lee una clave del KMS, así que esta es la única que demuestra que el material de claves se ha copiado.",{"_3602":75296,"_30987":74962,"_21467":128712,"_5":14750,"_28174":127887,"_3058":128713},[],"**Las CRLs existentes se sirven.** `GET /crl/<ca-id>` sobre la VA devuelve una CRL emitida anteriormente, y `GET /crl/<ca-ski>` con el SKI heredado de un certificado emitido antes de la actualización también resuelve. El job de CRL de la VA ha emitido una lista nueva bajo el ID de CA con ambas URLs en su IDP; revisa sus logs si la regeneración aún no ha terminado correctamente.",{"_3602":75297,"_30987":74962,"_21467":128715,"_5":14750,"_28174":127887,"_3058":128716},[],"**Eventos de VA renombrados.** Las suscripciones de alertas a `va.role.update` y `va.role.crl.init` se suscriben ahora a `va.crl-settings.update` y `va.crl-settings.init`, y se han revisado las condiciones de todos los eventos de la VA, incluido `va.role.crl.create`, frente al payload nuevo (`ca_id` en lugar de `ca_ski`) y al subject nuevo (`crl/<ca-id>` en lugar de `crl/<ski>`). Los consumidores directos y las búsquedas de auditoría usan los nombres de evento nuevos.",{"_3602":75298,"_30987":74962,"_21467":128718,"_5":14750,"_28174":127887,"_3058":128719},[],"**Claves de CA heredadas.** Si se ejecutó la migración de CA a KMS, revisa su informe y sus avisos y confirma que las claves esperadas aparecen en el KMS. Los certificados de CA migrados informan ahora de `key_id` y `has_private_key`, que permiten confirmar el registro.",{"_3602":75299,"_30987":74962,"_21467":128721,"_5":14750,"_28174":127887,"_3058":128722},[],"**Conectividad.** `helm test \"$RELEASE\" -n $NAMESPACE --logs` pasa; el hook comprueba los endpoints de salud de CA, DMS Manager, Device Manager y VA, y la respuesta de la UI.",{"_3602":75300,"_30987":74962,"_21467":128724,"_5":14750,"_28174":127887,"_3058":128725},[],"**Autorización.** Inicia sesión con el principal de bootstrap y confirma que la administración funciona, comprueba que una identidad sin permisos recibe `403` y revisa los permisos de clientes e integraciones.",{"_3602":75301,"_30987":74962,"_21467":128727,"_5":14750,"_28174":127887,"_3058":128728},[],"**AMQP.** El backend se conecta al broker con la configuración TLS esperada, y la política de limpieza de las colas de SSE está en marcha.",{"_3602":75302,"_30987":74962,"_21467":128730,"_5":14750,"_28174":127887,"_3058":128731},[],"**Eventos de dispositivo.** `GET /v1/devices/:id/events` devuelve los eventos históricos de un dispositivo que los tenía.",{"_3602":75303,"_30987":74962,"_21467":128733,"_5":14750,"_28174":127887,"_3058":128734},[],"**Webhooks sin campos de archivo.** En cada DMS que usa webhook en enrolamiento o reenrolamiento, el bloque `config` incluye `insecure_skip_verify` y el bloque de opciones esperado (`apikey_options`, `jwt_options` o `mtls_options`), con el certificado y la clave en PEM y sin `cert_file` ni `key_file`.",{"_3602":75304,"_30987":74962,"_21467":128736,"_5":14750,"_28174":127887,"_3058":128737},[],"**Verificación del receptor.** `insecure_skip_verify` es `false`, salvo que el certificado del receptor no sea verificable de forma intencionada.",{"_3602":75305,"_30987":74962,"_21467":128739,"_5":14750,"_28174":127887,"_3058":128740},[],"**Entrega de webhooks.** Un enrolamiento o reenrolamiento a través de cada webhook migrado completa su llamada de autorización.",{"_3602":75306,"_30987":74962,"_21467":128742,"_5":14750,"_28174":127887,"_3058":128743},[],"**Conjunto de confianza.** `est_rfc7030_settings.client_certificate_settings.validation_cas` contiene las CAs esperadas, en particular las de la CA antigua durante los solapamientos de rotación.",{"_3602":75307,"_30987":74962,"_21467":128745,"_5":14750,"_28174":127887,"_3058":128746},[],"**Clientes de la API.** Los scripts y consolas ya no usan el formato antiguo del DMS (`additional_validation_cas` plano, o los campos heredados `mtls`, `apikey` y `oidc`), envían las actualizaciones del DMS con el ID en la URL y comparan con los nuevos valores de `type` del certificado.",{"_3602":75308,"_30987":74962,"_21467":128748,"_5":14750,"_28174":127891,"_3058":128749},[],"Solo cuando pasen todas las comprobaciones, elimina los volúmenes huérfanos de 3.8.0 para recuperar almacenamiento. El borrado es irreversible y el volumen antiguo del KMS puede contener la última copia del material de claves de tus CA, así que antes haz un `VolumeSnapshot` o una copia de seguridad de ambos PVC antiguos y consérvala hasta que confíes en que el despliegue actualizado funciona correctamente. Son los nombres fijos de 3.8.0 que anotaste en el paso 1; antes de borrarlos, confirma que ningún pod en marcha los monta, por ejemplo con `kubectl describe pvc -n $NAMESPACE golang-engine-storage-kms-0 local-crl-file-storage-va-0`, donde `Used By` debe ser `<none>`:",{"_3602":75309,"_30987":74962,"_21467":128751,"_5":14750,"_28174":127891,"_3058":128752},[],"Las bases de datos por servicio de 3.8.0 tampoco se usan ya. Elimínalas solo cuando pasen las mismas comprobaciones y tengas verificada la copia de seguridad de PostgreSQL.",{"_3602":75310,"_30987":74962,"_21467":128754,"_5":14750,"_28174":127891,"_3058":128755},[],"<Card title=\"Instalar con Helm\" description=\"Prepara las dependencias, configura los values e instala un despliegue controlado.\" href=\"/docs/deployment/self-hosted/helm\" />",{"_3602":75311,"_30987":74962,"_21467":128757,"_5":14750,"_28174":127891,"_3058":128758},[],"<Card title=\"Control de acceso\" description=\"Principales, políticas y el primer administrador.\" href=\"/docs/platform/administration/access-control\" />",{"_3602":75312,"_30987":74962,"_21467":128760,"_5":14750,"_28174":127891,"_3058":128761},[],"<Card title=\"Configurar un DMS\" description=\"Ajustes de enrolamiento, reenrolamiento y webhooks.\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_60091":128763,"_60093":128764,"_60095":128765,"_60097":128766,"_18592":3093,"_72268":3093},"spanish",[3058,30987,5,28174],{"_3058":25625,"_30987":25625,"_5":25625,"_28174":25625},{"_3058":128767,"_30987":131808,"_5":134849,"_28174":137890},{"_4800":128768,"_60101":128769,"_5":25625},{"_14826":26021,"_15209":6313,"_15228":7165,"_29986":6936,"_15215":4186,"_20374":3350,"_14847":4905,"_14854":4211,"_29928":12799,"_30342":6189,"_30363":14822,"_29962":3835,"_35354":6826,"_30065":20860,"_30407":10166,"