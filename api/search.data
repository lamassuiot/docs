massu IoT instance on Amazon EC2.",{"_3640":17,"_31229":15,"_5":31564,"_21648":51062,"_28426":51063,"_3090":51064},[],"/docs/deployment/aws-marketplace#before-you-begin","Before you begin",{"_3640":18,"_31229":15,"_5":31564,"_21648":51066,"_28426":51067,"_3090":51068},[],"/docs/deployment/aws-marketplace#infrastructure-requirements","Infrastructure requirements",{"_3640":19,"_31229":15,"_5":31564,"_21648":51070,"_28426":51071,"_3090":51072},[],"/docs/deployment/aws-marketplace#open-the-offer","Open the offer",{"_3640":20,"_31229":15,"_5":31564,"_21648":51074,"_28426":51075,"_3090":51076},[],"/docs/deployment/aws-marketplace#configure-the-instance","Configure the instance",{"_3640":21,"_31229":15,"_5":31564,"_21648":51078,"_28426":51079,"_3090":51080},[],"/docs/deployment/aws-marketplace#limit-network-access","Limit network access",{"_3640":22,"_31229":15,"_5":31564,"_21648":51082,"_28426":51083,"_3090":51084},[],"/docs/deployment/aws-marketplace#launch-and-verify","Launch and verify",{"_3640":23,"_31229":15,"_5":31564,"_21648":51086,"_28426":51087,"_3090":51088},[],"/docs/deployment/aws-marketplace#next-step","Next step",{"_3640":24,"_31229":15,"_21648":51090,"_5":14899,"_28426":15,"_3090":51091},[],"The AWS Marketplace offering reduces initial setup to an EC2 instance inside your account. You keep control of the network, storage and operation of the machine.",{"_3640":25,"_31229":15,"_21648":51093,"_5":14899,"_28426":51063,"_3090":51094},[],"Permissions to subscribe to AWS Marketplace products and launch EC2 instances.",{"_3640":26,"_31229":15,"_21648":51096,"_5":14899,"_28426":51063,"_3090":51097},[],"A VPC and a subnet from which administrators and devices can reach the instance.",{"_3640":27,"_31229":15,"_21648":51099,"_5":14899,"_28426":51063,"_3090":51100},[],"A security group allowing the necessary endpoints.",{"_3640":28,"_31229":15,"_21648":51102,"_5":14899,"_28426":51067,"_3090":51103},[],"**Compute:** a `t3.large` instance at minimum. Use `t3.xlarge` or higher when the load requires it.",{"_3640":29,"_31229":15,"_21648":51105,"_5":14899,"_28426":51067,"_3090":51106},[],"**Storage:** an EBS `gp3` volume of at least 50 GB, sized to your inventory and retention needs.",{"_3640":30,"_31229":15,"_21648":51108,"_5":14899,"_28426":51067,"_3090":51109},[],"**Network:** HTTPS access from the necessary consumers, restricted to trusted networks.",{"_3640":31,"_31229":15,"_21648":51111,"_5":14899,"_28426":51071,"_3090":51112},[],"Go to Lamassu IoT on AWS Marketplace and review the terms before subscribing.",{"_3640":32,"_31229":15,"_21648":51114,"_5":14899,"_28426":51075,"_3090":51115},[],"Select `t3.large` or higher, assign at least 50 GB of `gp3` storage and choose the target VPC and subnet.",{"_3640":33,"_31229":15,"_21648":51117,"_5":14899,"_28426":51079,"_3090":51118},[],"Configure the security group for ports `443`, `8443` and `9443`. Restrict the origins to the administrative and device networks that really need to connect.",{"_3640":34,"_31229":15,"_21648":51120,"_5":14899,"_28426":51083,"_3090":51121},[],"Start the instance and open the console at `https://<public-ip>`. Check you can authenticate before continuing.",{"_3640":35,"_31229":15,"_21648":51123,"_5":14899,"_28426":51087,"_3090":51124},[],"Continue with Create your first CA to validate the instance's cryptographic configuration.",{"_3640":36,"_31229":36,"_5":15259,"_3090":51126,"_31567":51127,"_21648":51128,"_28426":36},"Deploy Lamassu",[51054,51055],[],{"_3640":37,"_31229":36,"_21648":51130,"_5":14899,"_28426":36,"_3090":51131},[],"Choose the operating model that fits your infrastructure and control requirements.",{"_3640":38,"_31229":36,"_5":31564,"_21648":51133,"_28426":51134,"_3090":51135},[],"/docs/deployment/overview#choose-a-model","Choose a model",{"_3640":39,"_31229":36,"_5":31564,"_21648":51137,"_28426":51138,"_3090":51139},[],"/docs/deployment/overview#just-want-to-evaluate-the-platform","Just want to evaluate the platform?",{"_3640":40,"_31229":36,"_5":31564,"_21648":51141,"_28426":51142,"_3090":51143},[],"/docs/deployment/overview#after-deployment","After deployment",{"_3640":41,"_31229":36,"_21648":51145,"_5":14899,"_28426":36,"_3090":51146},[],"You can run Lamassu on your own Kubernetes cluster, deploy a prebuilt image from AWS Marketplace or consume the platform as a managed service.",{"_3640":42,"_31229":36,"_21648":51148,"_5":14899,"_28426":51134,"_3090":51149},[],"Model",{"_3640":43,"_31229":36,"_21648":51151,"_5":14899,"_28426":51134,"_3090":51152},[],"Recommended for",{"_3640":44,"_31229":36,"_21648":51154,"_5":14899,"_28426":51134,"_3090":51155},[],"Who operates the infrastructure",{"_3640":45,"_31229":36,"_21648":51157,"_5":14899,"_28426":51134,"_3090":51158},[],"Starting point",{"_3640":46,"_31229":36,"_21648":51160,"_5":14899,"_28426":51134,"_3090":51161},[],"Kubernetes self-managed",{"_3640":47,"_31229":36,"_21648":51163,"_5":14899,"_28426":51134,"_3090":51164},[],"Production, regulated environments and custom deployments",{"_3640":48,"_31229":36,"_21648":51166,"_5":14899,"_28426":51134,"_3090":51167},[],"Your team",{"_3640":49,"_31229":36,"_21648":51169,"_5":14899,"_28426":51134,"_3090":51170},[],"Helm or Fastlane",{"_3640":50,"_31229":36,"_21648":51172,"_5":14899,"_28426":51134,"_3090":51173},[],"AWS Marketplace",{"_3640":51,"_31229":36,"_21648":51175,"_5":14899,"_28426":51134,"_3090":51176},[],"Evaluation or a dedicated deployment inside an AWS account",{"_3640":52,"_31229":36,"_21648":51178,"_5":14899,"_28426":51134,"_3090":51167},[],{"_3640":53,"_31229":36,"_21648":51180,"_5":14899,"_28426":51134,"_3090":51181},[],"Preconfigured image on EC2",{"_3640":54,"_31229":36,"_21648":51183,"_5":14899,"_28426":51134,"_3090":51184},[],"SaaS",{"_3640":55,"_31229":36,"_21648":51186,"_5":14899,"_28426":51134,"_3090":51187},[],"Teams that want to use the platform without operating it",{"_3640":56,"_31229":36,"_21648":51189,"_5":14899,"_28426":51134,"_3090":51190},[],"Lamassu",{"_3640":57,"_31229":36,"_21648":51192,"_5":14899,"_28426":51134,"_3090":51193},[],"Managed subscription",{"_3640":58,"_31229":36,"_21648":51195,"_5":14899,"_28426":51134,"_3090":51196},[],"<Card title=\"Kubernetes self-managed\" description=\"Control network, storage, keys, dependencies and the upgrade cycle.\" href=\"/docs/deployment/self-hosted/overview\" />",{"_3640":59,"_31229":36,"_21648":51198,"_5":14899,"_28426":51134,"_3090":51199},[],"<Card title=\"AWS Marketplace\" description=\"Launch a preconfigured Lamassu instance on AWS EC2.\" href=\"/docs/deployment/aws-marketplace\" />",{"_3640":60,"_31229":36,"_21648":51201,"_5":14899,"_28426":51134,"_3090":51202},[],"<Card title=\"Lamassu SaaS\" description=\"Use an operated and updated instance as a managed service.\" href=\"/docs/deployment/saas\" />",{"_3640":61,"_31229":36,"_21648":51204,"_5":14899,"_28426":51138,"_3090":51205},[],"Use Fastlane to bring up PostgreSQL, Keycloak, RabbitMQ and Lamassu on a Kubernetes cluster through a single flow. It is intended for labs, demos and bootstrap; for production, configure dependencies and Helm values explicitly.",{"_3640":62,"_31229":36,"_21648":51207,"_5":14899,"_28426":51142,"_3090":51208},[],"Once the console is available, continue with Create your first CA. That quickstart verifies the cryptographic engine and issuance work correctly.",{"_3640":63,"_31229":63,"_5":15259,"_3090":51210,"_31567":51211,"_21648":51212,"_28426":63},"Use Lamassu as SaaS",[51054,51055,51056],[],{"_3640":64,"_31229":63,"_21648":51214,"_5":14899,"_28426":63,"_3090":51215},[],"Consume Lamassu as a managed service without operating your own infrastructure.",{"_3640":65,"_31229":63,"_5":31564,"_21648":51217,"_28426":51218,"_3090":51219},[],"/docs/deployment/saas#what-the-service-manages","What the service manages",{"_3640":66,"_31229":63,"_5":31564,"_21648":51221,"_28426":51222,"_3090":51223},[],"/docs/deployment/saas#plans","Plans",{"_3640":67,"_31229":63,"_5":31564,"_21648":51225,"_28426":51226,"_3090":51227},[],"/docs/deployment/saas#request-access","Request access",{"_3640":68,"_31229":63,"_21648":51229,"_5":14899,"_28426":63,"_3090":51230},[],"Lamassu SaaS offers the platform's capabilities in a managed environment. It is the right option when your team wants to focus on PKI and device identities, not on maintaining the infrastructure that supports them.",{"_3640":69,"_31229":63,"_21648":51232,"_5":14899,"_28426":51218,"_3090":51233},[],"Platform availability and maintenance.",{"_3640":70,"_31229":63,"_21648":51235,"_5":14899,"_28426":51218,"_3090":51236},[],"Automatic backups.",{"_3640":71,"_31229":63,"_21648":51238,"_5":14899,"_28426":51218,"_3090":51239},[],"Version upgrades.",{"_3640":72,"_31229":63,"_21648":51241,"_5":14899,"_28426":51218,"_3090":51242},[],"Technical support and SLA according to your plan.",{"_3640":73,"_31229":63,"_21648":51244,"_5":14899,"_28426":51222,"_3090":51245},[],"Plan",{"_3640":74,"_31229":63,"_21648":51247,"_5":14899,"_28426":51222,"_3090":51248},[],"Devices",{"_3640":75,"_31229":63,"_21648":51250,"_5":14899,"_28426":51222,"_3090":51251},[],"Support",{"_3640":76,"_31229":63,"_21648":51253,"_5":14899,"_28426":51222,"_3090":51254},[],"SLA",{"_3640":77,"_31229":63,"_21648":51256,"_5":14899,"_28426":51222,"_3090":51257},[],"Starter",{"_3640":78,"_31229":63,"_21648":51259,"_5":14899,"_28426":51222,"_3090":51260},[],"Up to 1,000",{"_3640":79,"_31229":63,"_21648":51262,"_5":14899,"_28426":51222,"_3090":51263},[],"Email",{"_3640":80,"_31229":63,"_21648":51265,"_5":14899,"_28426":51222,"_3090":51266},[],"99.5 %",{"_3640":81,"_31229":63,"_21648":51268,"_5":14899,"_28426":51222,"_3090":51269},[],"Professional",{"_3640":82,"_31229":63,"_21648":51271,"_5":14899,"_28426":51222,"_3090":51272},[],"Up to 10,000",{"_3640":83,"_31229":63,"_21648":51274,"_5":14899,"_28426":51222,"_3090":51275},[],"Email and chat",{"_3640":84,"_31229":63,"_21648":51277,"_5":14899,"_28426":51222,"_3090":51278},[],"99.9 %",{"_3640":85,"_31229":63,"_21648":51280,"_5":14899,"_28426":51222,"_3090":51281},[],"Enterprise",{"_3640":86,"_31229":63,"_21648":51283,"_5":14899,"_28426":51222,"_3090":51284},[],"Unlimited",{"_3640":87,"_31229":63,"_21648":51286,"_5":14899,"_28426":51222,"_3090":51287},[],"Dedicated",{"_3640":88,"_31229":63,"_21648":51289,"_5":14899,"_28426":51222,"_3090":51290},[],"99.99 %",{"_3640":89,"_31229":63,"_21648":51292,"_5":14899,"_28426":51226,"_3090":51293},[],"Contact the Lamassu team through lamassu.io to request a demo or choose a plan.",{"_3640":90,"_31229":63,"_21648":51295,"_5":14899,"_28426":51226,"_3090":51296},[],"When you receive your instance's credentials, continue with Get started.",{"_3640":91,"_31229":91,"_5":15259,"_3090":51298,"_31567":51299,"_21648":51300,"_28426":91},"Fastlane",[51054,51055,51161],[],{"_3640":92,"_31229":91,"_21648":51302,"_5":14899,"_28426":91,"_3090":51303},[],"Bootstrap a complete Lamassu evaluation or lab environment on an existing Kubernetes cluster.",{"_3640":93,"_31229":91,"_5":31564,"_21648":51305,"_28426":51306,"_3090":51307},[],"/docs/deployment/self-hosted/fastlane#deploy-with-fastlane","Deploy with Fastlane",{"_3640":94,"_31229":91,"_5":31564,"_21648":51309,"_28426":51310,"_3090":51311},[],"/docs/deployment/self-hosted/fastlane#what-fastlane-adds","What Fastlane adds",{"_3640":95,"_31229":91,"_5":31564,"_21648":51313,"_28426":51314,"_3090":51064},[],"/docs/deployment/self-hosted/fastlane#before-you-begin",{"_3640":96,"_31229":91,"_5":31564,"_21648":51316,"_28426":51317,"_3090":51318},[],"/docs/deployment/self-hosted/fastlane#quick-start","Quick start",{"_3640":97,"_31229":91,"_5":31564,"_21648":51320,"_28426":51321,"_3090":51322},[],"/docs/deployment/self-hosted/fastlane#gateway-address-selection","Gateway address selection",{"_3640":98,"_31229":91,"_5":31564,"_21648":51324,"_28426":51325,"_3090":51326},[],"/docs/deployment/self-hosted/fastlane#command-line-options","Command-line options",{"_3640":99,"_31229":91,"_5":31564,"_21648":51328,"_28426":51329,"_3090":51330},[],"/docs/deployment/self-hosted/fastlane#development-mode","Development mode",{"_3640":100,"_31229":91,"_5":31564,"_21648":51332,"_28426":51333,"_3090":51334},[],"/docs/deployment/self-hosted/fastlane#what-the-script-configures","What the script configures",{"_3640":101,"_31229":91,"_5":31564,"_21648":51336,"_28426":51337,"_3090":51338},[],"/docs/deployment/self-hosted/fastlane#tls-behavior","TLS behavior",{"_3640":102,"_31229":91,"_5":31564,"_21648":51340,"_28426":51341,"_3090":51342},[],"/docs/deployment/self-hosted/fastlane#credentials-and-generated-files","Credentials and generated files",{"_3640":103,"_31229":91,"_5":31564,"_21648":51344,"_28426":51345,"_3090":51346},[],"/docs/deployment/self-hosted/fastlane#verify-the-installation","Verify the installation",{"_3640":104,"_31229":91,"_21648":51348,"_5":14899,"_28426":51306,"_3090":51349},[],"Fastlane is the automated path for evaluations, demos, CI and small lab clusters. It installs PostgreSQL, Keycloak, RabbitMQ, Envoy Gateway and Lamassu, then configures them to work together.",{"_3640":105,"_31229":91,"_21648":51351,"_5":14899,"_28426":51306,"_3090":51352},[],"For production, use Helm so database, identity, credentials, certificates, storage and upgrades remain explicit.",{"_3640":106,"_31229":91,"_21648":51354,"_5":14899,"_28426":51310,"_3090":51355},[],"Fastlane closes some of the gaps intentionally left by the application chart:",{"_3640":107,"_31229":91,"_21648":51357,"_5":14899,"_28426":51310,"_3090":51358},[],"Fastlane installs or configures",{"_3640":108,"_31229":91,"_21648":51360,"_5":14899,"_28426":51310,"_3090":51361},[],"You still provide",{"_3640":109,"_31229":91,"_21648":51363,"_5":14899,"_28426":51310,"_3090":51364},[],"PostgreSQL, RabbitMQ and Keycloak instances for evaluation",{"_3640":110,"_31229":91,"_21648":51366,"_5":14899,"_28426":51310,"_3090":51367},[],"The Kubernetes cluster, nodes and persistent storage",{"_3640":111,"_31229":91,"_21648":51369,"_5":14899,"_28426":51310,"_3090":51370},[],"Envoy Gateway 1.8 and the `eg` `GatewayClass`",{"_3640":112,"_31229":91,"_21648":51372,"_5":14899,"_28426":51310,"_3090":51373},[],"cert-manager, external network reachability, DNS and firewall/NAT rules",{"_3640":113,"_31229":91,"_21648":51375,"_5":14899,"_28426":51310,"_3090":51376},[],"A self-signed Lamassu certificate flow, dependency credentials stored in Kubernetes Secrets (through the External Secrets Operator) and an initial user",{"_3640":114,"_31229":91,"_21648":51378,"_5":14899,"_28426":51310,"_3090":51379},[],"Client trust for the self-signed CA, or a trusted certificate passed to the script",{"_3640":115,"_31229":91,"_21648":51381,"_5":14899,"_28426":51310,"_3090":51382},[],"Optional observability and lab HSM components",{"_3640":116,"_31229":91,"_21648":51384,"_5":14899,"_28426":51310,"_3090":51385},[],"Production monitoring retention, backups, HA and a production HSM/key service",{"_3640":117,"_31229":91,"_21648":51387,"_5":14899,"_28426":51310,"_3090":51388},[],"Fastlane does not turn the resulting stack into a production service: it does not create the cluster, public DNS, firewall rules, backups, high availability or a trusted public certificate.",{"_3640":118,"_31229":91,"_21648":51390,"_5":14899,"_28426":51314,"_3090":51391},[],"You need:",{"_3640":119,"_31229":91,"_21648":51393,"_5":14899,"_28426":51314,"_3090":51394},[],"an existing Kubernetes cluster",{"_3640":120,"_31229":91,"_21648":51396,"_5":14899,"_28426":51314,"_3090":51397},[],"`kubectl` and Helm, or the MicroK8s CLI",{"_3640":121,"_31229":91,"_21648":51399,"_5":14899,"_28426":51314,"_3090":51400},[],"`yq`",{"_3640":122,"_31229":91,"_21648":51402,"_5":14899,"_28426":51314,"_3090":24461},[],{"_3640":123,"_31229":91,"_21648":51404,"_5":14899,"_28426":51314,"_3090":51405},[],"`jq` only when using `--sample-data` or `--development`",{"_3640":124,"_31229":91,"_21648":51407,"_5":14899,"_28426":51314,"_3090":51408},[],"`ssh-keygen` only when using `--with-hsm`",{"_3640":125,"_31229":91,"_21648":51410,"_5":14899,"_28426":51314,"_3090":51411},[],"free external ports 80 and 443 on a single-node K3s host",{"_3640":126,"_31229":91,"_21648":51413,"_5":14899,"_28426":51314,"_3090":51414},[],"Fastlane detects MicroK8s, K3s, kind or a standard kubeconfig. Use `--context` when the intended cluster is not the current context.",{"_3640":127,"_31229":91,"_21648":51416,"_5":14899,"_28426":51314,"_3090":51417},[],"Fastlane installs several components and creates credentials. Check `kubectl config current-context` or pass `--context` before running it.",{"_3640":128,"_31229":91,"_21648":51419,"_5":14899,"_28426":51317,"_3090":51420},[],"Run the script from a clone of the Helm repository:",{"_3640":129,"_31229":91,"_21648":51422,"_5":14899,"_28426":51317,"_3090":51423},[],"Create a DNS record for the chosen domain before testing from another machine. For a small VM, point it at the VM or load-balancer address that actually receives ports 80 and 443.",{"_3640":130,"_31229":91,"_21648":51425,"_5":14899,"_28426":51321,"_3090":51426},[],"By default, Fastlane runs `hostname -I` and writes the returned addresses to `gateway.addresses` and to the self-signed certificate's IP SANs.",{"_3640":131,"_31229":91,"_21648":51428,"_5":14899,"_28426":51321,"_3090":51429},[],"On a single-homed lab VM this can select the expected node address. On hosts with Docker, VPN, WireGuard or several interfaces it can also select addresses clients cannot reach. Override the result explicitly:",{"_3640":132,"_31229":91,"_21648":51431,"_5":14899,"_28426":51321,"_3090":51432},[],"The value must be an address handled on the Kubernetes side of the traffic path. If a public EC2 address forwards through WireGuard to the cluster, pass the reachable cluster/VM address, not the EC2 public address.",{"_3640":133,"_31229":91,"_21648":51434,"_5":14899,"_28426":51321,"_3090":51435},[],"See Expose the Gateway for K3s port conflicts, VIPs, external NAT and multi-Gateway designs.",{"_3640":134,"_31229":91,"_21648":51437,"_5":14899,"_28426":51325,"_3090":51438},[],"Option",{"_3640":135,"_31229":91,"_21648":51440,"_5":14899,"_28426":51325,"_3090":51441},[],"Default",{"_3640":136,"_31229":91,"_21648":51443,"_5":14899,"_28426":51325,"_3090":51444},[],"Purpose",{"_3640":137,"_31229":91,"_21648":51446,"_5":14899,"_28426":51325,"_3090":51447},[],"`-h`, `--help`",{"_3640":138,"_31229":91,"_21648":51449,"_5":14899,"_28426":51325,"_3090":51450},[],"—",{"_3640":139,"_31229":91,"_21648":51452,"_5":14899,"_28426":51325,"_3090":51453},[],"Show help",{"_3640":140,"_31229":91,"_21648":51455,"_5":14899,"_28426":51325,"_3090":51456},[],"`-c`, `--context`",{"_3640":141,"_31229":91,"_21648":51458,"_5":14899,"_28426":51325,"_3090":51459},[],"current context",{"_3640":142,"_31229":91,"_21648":51461,"_5":14899,"_28426":51325,"_3090":51462},[],"Select the kubeconfig context for kubectl and Helm",{"_3640":143,"_31229":91,"_21648":51464,"_5":14899,"_28426":51325,"_3090":51465},[],"`-n`, `--non-interactive`",{"_3640":144,"_31229":91,"_21648":51467,"_5":14899,"_28426":51325,"_3090":6820},[],{"_3640":145,"_31229":91,"_21648":51469,"_5":14899,"_28426":51325,"_3090":51470},[],"Skip prompts and generate dependency credentials",{"_3640":146,"_31229":91,"_21648":51472,"_5":14899,"_28426":51325,"_3090":51473},[],"`-ns`, `--namespace`",{"_3640":147,"_31229":91,"_21648":51475,"_5":14899,"_28426":51325,"_3090":51476},[],"`lamassu-dev`",{"_3640":148,"_31229":91,"_21648":51478,"_5":14899,"_28426":51325,"_3090":51479},[],"Namespace for the installation",{"_3640":149,"_31229":91,"_21648":51481,"_5":14899,"_28426":51325,"_3090":51482},[],"`-d`, `--domain`",{"_3640":150,"_31229":91,"_21648":51484,"_5":14899,"_28426":51325,"_3090":51485},[],"`dev.lamassu.io`",{"_3640":151,"_31229":91,"_21648":51487,"_5":14899,"_28426":51325,"_3090":51488},[],"Domain used by the UI, OIDC and certificate",{"_3640":152,"_31229":91,"_21648":51490,"_5":14899,"_28426":51325,"_3090":51491},[],"`-v`, `--version`",{"_3640":153,"_31229":91,"_21648":51493,"_5":14899,"_28426":51325,"_3090":15611},[],{"_3640":154,"_31229":91,"_21648":51495,"_5":14899,"_28426":51325,"_3090":51496},[],"Lamassu chart version",{"_3640":155,"_31229":91,"_21648":51498,"_5":14899,"_28426":51325,"_3090":51499},[],"`--https-port`",{"_3640":156,"_31229":91,"_21648":51501,"_5":14899,"_28426":51325,"_3090":51502},[],"`443`",{"_3640":157,"_31229":91,"_21648":51504,"_5":14899,"_28426":51325,"_3090":51505},[],"Gateway HTTPS listener port",{"_3640":158,"_31229":91,"_21648":51507,"_5":14899,"_28426":51325,"_3090":51508},[],"`--http-port`",{"_3640":159,"_31229":91,"_21648":51510,"_5":14899,"_28426":51325,"_3090":51511},[],"`80`",{"_3640":160,"_31229":91,"_21648":51513,"_5":14899,"_28426":51325,"_3090":51514},[],"Gateway HTTP listener port",{"_3640":161,"_31229":91,"_21648":51516,"_5":14899,"_28426":51325,"_3090":51517},[],"`--tls-crt`",{"_3640":162,"_31229":91,"_21648":51519,"_5":14899,"_28426":51325,"_3090":51450},[],{"_3640":163,"_31229":91,"_21648":51521,"_5":14899,"_28426":51325,"_3090":51522},[],"PEM certificate for downstream TLS",{"_3640":164,"_31229":91,"_21648":51524,"_5":14899,"_28426":51325,"_3090":51525},[],"`--tls-key`",{"_3640":165,"_31229":91,"_21648":51527,"_5":14899,"_28426":51325,"_3090":51450},[],{"_3640":166,"_31229":91,"_21648":51529,"_5":14899,"_28426":51325,"_3090":51530},[],"PEM private key for downstream TLS",{"_3640":167,"_31229":91,"_21648":51532,"_5":14899,"_28426":51325,"_3090":51533},[],"`-l`, `--local-chart-path`",{"_3640":168,"_31229":91,"_21648":51535,"_5":14899,"_28426":51325,"_3090":51536},[],"repository chart",{"_3640":169,"_31229":91,"_21648":51538,"_5":14899,"_28426":51325,"_3090":51539},[],"Use an unpacked local Lamassu chart",{"_3640":170,"_31229":91,"_21648":51541,"_5":14899,"_28426":51325,"_3090":51542},[],"`-ip`, `--gateway-ip`",{"_3640":171,"_31229":91,"_21648":51544,"_5":14899,"_28426":51325,"_3090":9117},[],{"_3640":172,"_31229":91,"_21648":51546,"_5":14899,"_28426":51325,"_3090":51547},[],"Override the address written to `gateway.addresses`",{"_3640":173,"_31229":91,"_21648":51549,"_5":14899,"_28426":51325,"_3090":51550},[],"`--otel`",{"_3640":174,"_31229":91,"_21648":51552,"_5":14899,"_28426":51325,"_3090":6820},[],{"_3640":175,"_31229":91,"_21648":51554,"_5":14899,"_28426":51325,"_3090":51555},[],"Install Victoria Logs, VictoriaTraces, Jaeger and an OpenTelemetry Collector",{"_3640":176,"_31229":91,"_21648":51557,"_5":14899,"_28426":51325,"_3090":51558},[],"`--development`",{"_3640":177,"_31229":91,"_21648":51560,"_5":14899,"_28426":51325,"_3090":6820},[],{"_3640":178,"_31229":91,"_21648":51562,"_5":14899,"_28426":51325,"_3090":51563},[],"Development mode: fully provisions the Keycloak `lamassu` user (fixed `lamassu`/`lamassu` password, no first-login steps) and lets the `frontend` client accept any redirect URI or web origin. Not for production",{"_3640":179,"_31229":91,"_21648":51565,"_5":14899,"_28426":51325,"_3090":51566},[],"`--sample-data`",{"_3640":180,"_31229":91,"_21648":51568,"_5":14899,"_28426":51325,"_3090":6820},[],{"_3640":181,"_31229":91,"_21648":51570,"_5":14899,"_28426":51325,"_3090":51571},[],"Create sample CAs, profiles, certificates, DMS data and devices",{"_3640":182,"_31229":91,"_21648":51573,"_5":14899,"_28426":51325,"_3090":51574},[],"`--with-hsm`",{"_3640":183,"_31229":91,"_21648":51576,"_5":14899,"_28426":51325,"_3090":6820},[],{"_3640":184,"_31229":91,"_21648":51578,"_5":14899,"_28426":51325,"_3090":51579},[],"Install lab HSM components and configure KMS for PKCS#11",{"_3640":185,"_31229":91,"_21648":51581,"_5":14899,"_28426":51325,"_3090":51582},[],"`--softhsm-chart-path`",{"_3640":186,"_31229":91,"_21648":51584,"_5":14899,"_28426":51325,"_3090":51585},[],"`./charts/softhsm`",{"_3640":187,"_31229":91,"_21648":51587,"_5":14899,"_28426":51325,"_3090":51588},[],"Use a different local SoftHSM chart",{"_3640":188,"_31229":91,"_21648":51590,"_5":14899,"_28426":51325,"_3090":51591},[],"Fastlane does not provide an offline mode. Use the manual Helm workflow and a prepared registry/chart mirror for disconnected environments.",{"_3640":189,"_31229":91,"_21648":51593,"_5":14899,"_28426":51329,"_3090":51594},[],"`--development` adjusts the Keycloak `lamassu` realm generated by Fastlane for a disposable evaluation environment:",{"_3640":190,"_31229":91,"_21648":51596,"_5":14899,"_28426":51329,"_3090":51597},[],"the `lamassu` user is fully provisioned (first name Lamassu, last name Admin, email `lamassu@lamassu.io`, verified): there are no profile setup or password change steps on first login",{"_3640":191,"_31229":91,"_21648":51599,"_5":14899,"_28426":51329,"_3090":51600},[],"the well-known `lamassu`/`lamassu` password is fixed and permanent: it is never rotated and grants the `pki-admin` role, including non-interactive tokens through the `frontend` client",{"_3640":192,"_31229":91,"_21648":51602,"_5":14899,"_28426":51329,"_3090":51603},[],"the `frontend` client accepts any redirect URI and any web origin (`*`) instead of the original `/*` patterns",{"_3640":193,"_31229":91,"_21648":51605,"_5":14899,"_28426":51329,"_3090":51606},[],"With `--development`, the fixed `lamassu`/`lamassu` password grants `pki-admin` access to anyone who can reach the installation. Never use it on anything exposed beyond a development machine or a network-reachable host.",{"_3640":194,"_31229":91,"_21648":51608,"_5":14899,"_28426":51329,"_3090":51609},[],"`--development` applies when the `lamassu` realm is first imported. It does not modify an existing cluster. It can be combined with `--sample-data`: the development transform runs first, then sample data is added to the same realm configuration.",{"_3640":195,"_31229":91,"_21648":51611,"_5":14899,"_28426":51333,"_3090":51612},[],"Fastlane:",{"_3640":196,"_31229":91,"_21648":51614,"_5":14899,"_28426":51333,"_3090":51615},[],"validates local tools and the selected cluster",{"_3640":197,"_31229":91,"_21648":51617,"_5":14899,"_28426":51333,"_3090":51618},[],"installs or upgrades Envoy Gateway 1.8 and creates the `eg` `GatewayClass`",{"_3640":198,"_31229":91,"_21648":51620,"_5":14899,"_28426":51333,"_3090":51621},[],"creates the namespace",{"_3640":199,"_31229":91,"_21648":51623,"_5":14899,"_28426":51333,"_3090":51624},[],"installs the External Secrets Operator and creates the PostgreSQL, RabbitMQ and Keycloak administrator credentials as Secrets through a Fake `ClusterSecretStore`",{"_3640":200,"_31229":91,"_21648":51626,"_5":14899,"_28426":51333,"_3090":51627},[],"installs PostgreSQL and creates the required databases",{"_3640":201,"_31229":91,"_21648":51629,"_5":14899,"_28426":51333,"_3090":51630},[],"installs Keycloak and creates the `lamassu` realm, frontend client, admin role and initial user",{"_3640":202,"_31229":91,"_21648":51632,"_5":14899,"_28426":51333,"_3090":51633},[],"installs RabbitMQ",{"_3640":203,"_31229":91,"_21648":51635,"_5":14899,"_28426":51333,"_3090":51636},[],"optionally installs observability and lab HSM components",{"_3640":204,"_31229":91,"_21648":51638,"_5":14899,"_28426":51333,"_3090":51639},[],"generates `lamassu.yaml`, which references the Secrets instead of inline credentials, and installs the Lamassu chart",{"_3640":205,"_31229":91,"_21648":51641,"_5":14899,"_28426":51333,"_3090":51642},[],"optionally loads sample data",{"_3640":206,"_31229":91,"_21648":51644,"_5":14899,"_28426":51333,"_3090":51645},[],"The generated configuration exposes Keycloak at `/auth` through the same Gateway and bootstraps the initial `lamassu` user as a Lamassu super administrator.",{"_3640":207,"_31229":91,"_21648":51647,"_5":14899,"_28426":51337,"_3090":51648},[],"With both `--tls-crt` and `--tls-key`, Fastlane creates the `downstream-provided-crt` Secret and configures `tls.type: external`.",{"_3640":208,"_31229":91,"_21648":51650,"_5":14899,"_28426":51337,"_3090":51651},[],"Without them, it configures cert-manager with a self-signed issuer. This is suitable for a lab but will not be trusted by clients until you distribute the CA. Use Helm when you need a corporate Issuer, public ACME issuer or an existing Secret managed by another system.",{"_3640":209,"_31229":91,"_21648":51653,"_5":14899,"_28426":51341,"_3090":51654},[],"Non-interactive mode generates random PostgreSQL, RabbitMQ and Keycloak administrator passwords and stores them in Kubernetes Secrets through the External Secrets Operator's Fake `ClusterSecretStore`. Fastlane writes `lamassu.yaml` in the current directory referencing those Secrets — the values file no longer contains the credentials.",{"_3640":210,"_31229":91,"_21648":51656,"_5":14899,"_28426":51341,"_3090":51657},[],"The Keycloak administrator password is not printed by the script. Retrieve it from the Secret when needed:",{"_3640":211,"_31229":91,"_21648":51659,"_5":14899,"_28426":51341,"_3090":51660},[],"The initial Lamassu login is `lamassu` / `lamassu` and requires a password change on first use, unless `--development` was used: in that case the password stays fixed and permanent.",{"_3640":212,"_31229":91,"_21648":51662,"_5":14899,"_28426":51341,"_3090":51663},[],"The Fake `ClusterSecretStore` stores the credentials in plain text and is for lab use only: replace it with a real ESO provider for anything beyond a throwaway environment. Protect the generated values file, record the generated credentials in an appropriate secret store and do not reuse the evaluation identity setup in production.",{"_3640":213,"_31229":91,"_21648":51665,"_5":14899,"_28426":51345,"_3090":51666},[],"Then open `https://pki.example.com` and sign in with the initial user. If the Gateway is programmed but the URL is unreachable, follow the checks in Expose the Gateway.",{"_3640":214,"_31229":214,"_5":15259,"_3090":51668,"_31567":51669,"_21648":51670,"_28426":214},"Install with Helm",[51054,51055,51161],[],{"_3640":215,"_31229":214,"_21648":51672,"_5":14899,"_28426":214,"_3090":51673},[],"Prepare dependencies, configure the Lamassu chart and verify a controlled Kubernetes deployment.",{"_3640":216,"_31229":214,"_5":31564,"_21648":51675,"_28426":51676,"_3090":51677},[],"/docs/deployment/self-hosted/helm#install-lamassu-with-helm","Install Lamassu with Helm",{"_3640":217,"_31229":214,"_5":31564,"_21648":51679,"_28426":51680,"_3090":51064},[],"/docs/deployment/self-hosted/helm#before-you-begin",{"_3640":218,"_31229":214,"_5":31564,"_21648":51682,"_28426":51683,"_3090":51684},[],"/docs/deployment/self-hosted/helm#1-install-the-gateway-prerequisites","1\\. Install the Gateway prerequisites",{"_3640":219,"_31229":214,"_5":31564,"_21648":51686,"_28426":51687,"_3090":51688},[],"/docs/deployment/self-hosted/helm#2-create-a-values-file","2\\. Create a values file",{"_3640":220,"_31229":214,"_5":31564,"_21648":51690,"_28426":51691,"_3090":51692},[],"/docs/deployment/self-hosted/helm#credentials-in-kubernetes-secrets","Credentials in Kubernetes Secrets",{"_3640":221,"_31229":214,"_5":31564,"_21648":51694,"_28426":51695,"_3090":51696},[],"/docs/deployment/self-hosted/helm#tls-with-an-existing-secret","TLS with an existing Secret",{"_3640":222,"_31229":214,"_5":31564,"_21648":51698,"_28426":51699,"_3090":51700},[],"/docs/deployment/self-hosted/helm#amqp-tls-amqps","AMQP TLS (AMQPS)",{"_3640":223,"_31229":214,"_5":31564,"_21648":51702,"_28426":51703,"_3090":51704},[],"/docs/deployment/self-hosted/helm#provision-the-first-administrator","Provision the first administrator",{"_3640":224,"_31229":214,"_5":31564,"_21648":51706,"_28426":51707,"_3090":51708},[],"/docs/deployment/self-hosted/helm#experimental-dashboard-terminal-optional","Experimental dashboard terminal (optional)",{"_3640":225,"_31229":214,"_5":31564,"_21648":51710,"_28426":51711,"_3090":51712},[],"/docs/deployment/self-hosted/helm#3-install-lamassu","3\\. Install Lamassu",{"_3640":226,"_31229":214,"_5":31564,"_21648":51714,"_28426":51715,"_3090":51716},[],"/docs/deployment/self-hosted/helm#4-verify-the-deployment","4\\. Verify the deployment",{"_3640":227,"_31229":214,"_5":31564,"_21648":51718,"_28426":51719,"_3090":51720},[],"/docs/deployment/self-hosted/helm#upgrading-lamassu","Upgrading Lamassu",{"_3640":228,"_31229":214,"_5":31564,"_21648":51722,"_28426":51723,"_3090":51724},[],"/docs/deployment/self-hosted/helm#production-decisions","Production decisions",{"_3640":229,"_31229":214,"_21648":51726,"_5":14899,"_28426":51676,"_3090":51727},[],"Use the Helm workflow when you need explicit control over identity, databases, messaging, certificates, storage and upgrades. For an evaluation environment where the script can make those choices for you, use Fastlane.",{"_3640":230,"_31229":214,"_21648":51729,"_5":14899,"_28426":51680,"_3090":51730},[],"Prepare the platform services that are deliberately outside the Lamassu chart:",{"_3640":231,"_31229":214,"_21648":51732,"_5":14899,"_28426":51680,"_3090":51733},[],"a Kubernetes 1.24+ cluster and Helm 3.2+",{"_3640":232,"_31229":214,"_21648":51735,"_5":14899,"_28426":51680,"_3090":51736},[],"a reachable PostgreSQL server and a role allowed to create databases and schemas",{"_3640":233,"_31229":214,"_21648":51738,"_5":14899,"_28426":51680,"_3090":51739},[],"a reachable RabbitMQ broker and credentials",{"_3640":234,"_31229":214,"_21648":51741,"_5":14899,"_28426":51680,"_3090":51742},[],"Kubernetes Secrets in the release namespace holding the PostgreSQL and RabbitMQ credentials (and SMTP credentials when SMTP authentication is required) — the chart reads credentials from Secrets and rejects inline values (see Credentials in Kubernetes Secrets)",{"_3640":235,"_31229":214,"_21648":51744,"_5":14899,"_28426":51680,"_3090":51745},[],"an OIDC provider, normally Keycloak, with a realm/tenant and client for Lamassu",{"_3640":236,"_31229":214,"_21648":51747,"_5":14899,"_28426":51680,"_3090":51748},[],"Envoy Gateway 1.8+ and a `GatewayClass`",{"_3640":237,"_31229":214,"_21648":51750,"_5":14899,"_28426":51680,"_3090":51751},[],"cert-manager 1.14+ (only for the default `tls.type: certManager` mode); for trusted TLS, either a trusted issuer or a Kubernetes TLS Secret",{"_3640":238,"_31229":214,"_21648":51753,"_5":14899,"_28426":51680,"_3090":51754},[],"a StorageClass and an external traffic design",{"_3640":239,"_31229":214,"_21648":51756,"_5":14899,"_28426":51680,"_3090":51757},[],"The chart defaults to a `GatewayClass` named `eg`. Change `gateway.className` if your platform team uses another name.",{"_3640":240,"_31229":214,"_21648":51759,"_5":14899,"_28426":51680,"_3090":51760},[],"You provide the PostgreSQL server. The chart's pre-install job connects with the supplied credentials, creates the required `pki`, `authz` and `wfx` databases and service schemas, runs migrations, and applies `services.authz.bootstrap`.",{"_3640":241,"_31229":214,"_21648":51762,"_5":14899,"_28426":51680,"_3090":51763},[],"The chart has no Helm dependencies that install PostgreSQL, RabbitMQ, an OIDC provider, Envoy Gateway or cert-manager.",{"_3640":242,"_31229":214,"_21648":51765,"_5":14899,"_28426":51683,"_3090":51766},[],"Install or upgrade the Envoy Gateway CRDs before its controller. The commands below match the version used by the Lamassu Helm repository:",{"_3640":243,"_31229":214,"_21648":51768,"_5":14899,"_28426":51683,"_3090":51769},[],"Create the default `GatewayClass` if it does not already exist. Save this manifest as `gateway-class.yaml`:",{"_3640":244,"_31229":214,"_21648":51771,"_5":14899,"_28426":51683,"_3090":51772},[],"Install cert-manager separately before Lamassu, but only for the default `tls.type: certManager` mode. In that mode the chart renders its self-signed Issuer and CA Certificate resources regardless of whether `tls.certManagerOptions.clusterIssuer` is set, so cert-manager stays a prerequisite. With `tls.type: external`, the chart renders no cert-manager resources and the Gateway terminates TLS with an existing Secret you provide instead.",{"_3640":245,"_31229":214,"_21648":51774,"_5":14899,"_28426":51687,"_3090":51775},[],"Start with the chart defaults and override the environment-specific values. This example assumes PostgreSQL, RabbitMQ and Keycloak are reachable through Kubernetes DNS, and exposes Keycloak at `/auth` through the shared Lamassu Gateway:",{"_3640":246,"_31229":214,"_21648":51777,"_5":14899,"_28426":51687,"_3090":51778},[],"Do not add `gateway.addresses` by default. Leave address assignment to the load-balancer implementation unless your network design requires a specific Kubernetes-side VIP. The public IP of an upstream NAT gateway or reverse proxy does not belong in this value.",{"_3640":247,"_31229":214,"_21648":51780,"_5":14899,"_28426":51687,"_3090":51781},[],"If Keycloak is external and already has its own reachable URL, point the OIDC settings at it and omit the `/auth` entry from `gateway.extraRouting`.",{"_3640":248,"_31229":214,"_21648":51783,"_5":14899,"_28426":51687,"_3090":51784},[],"If your values file still carries the legacy gateway JWT validation settings — `auth.oidc.apiGateway.jwks`, `auth.authorization.rolesClaim` or `auth.authorization.roles.admin` — remove them. The migration guide `charts/lamassu/CHANGELOG/3.8.0->4.0.0.md` documents their removal with no compatibility aliases, and `values.schema.json` rejects the leftover blocks instead of silently ignoring them. The replacements are `services.authz.jwkUrl` and `services.authz.bootstrap`, already shown in the example above.",{"_3640":249,"_31229":214,"_21648":51786,"_5":14899,"_28426":51691,"_3090":51787},[],"The chart reads the PostgreSQL, AMQP and SMTP credentials from Kubernetes Secrets in the release namespace. Reference them with `existingSecret` plus the `usernameKey` and `passwordKey` data keys; inline `username` and `password` values are removed and rejected by `values.schema.json`.",{"_3640":250,"_31229":214,"_21648":51789,"_5":14899,"_28426":51691,"_3090":51790},[],"The Secrets must exist before you install or upgrade: the pre-install and pre-upgrade migration job connects to PostgreSQL with the PostgreSQL Secret, and the service containers read the AMQP and SMTP credentials when they start.",{"_3640":251,"_31229":214,"_21648":51792,"_5":14899,"_28426":51691,"_3090":51793},[],"`postgres.existingSecret` (default `lamassu-postgres`) and `amqp.existingSecret` (default `lamassu-amqp`) are always required.",{"_3640":252,"_31229":214,"_21648":51795,"_5":14899,"_28426":51691,"_3090":51796},[],"`services.alerts.smtp_server.existingSecret` is empty by default, which means SMTP without authentication. Set it, together with its key names, only when your SMTP server requires authentication.",{"_3640":253,"_31229":214,"_21648":51798,"_5":14899,"_28426":51691,"_3090":51799},[],"Each `services.authz.credentials` entry names its `database` and uses the global PostgreSQL Secret — `postgres.existingSecret` with its configured key names — unless the entry sets its own `existingSecret`.",{"_3640":254,"_31229":214,"_21648":51801,"_5":14899,"_28426":51691,"_3090":51802},[],"Changing a Secret's contents does not roll the pods that consume it: the services read the credentials when they start. Restart the affected pods after rotating a credential.",{"_3640":255,"_31229":214,"_21648":51804,"_5":14899,"_28426":51691,"_3090":51805},[],"For production, manage the Secrets with the External Secrets Operator (ESO), which the chart does not install. The `charts/lamassu/README.md` in the Helm repository documents a complete working example in its *Secret management* section: installing external-secrets 0.20.2, a test `ClusterSecretStore`, the `ExternalSecret` resources and the wait before installing the chart. Its Fake provider is for testing only — replace it with your provider's configuration for anything beyond a throwaway environment; AWS Secrets Manager, Vault, Azure Key Vault, GCP Secret Manager and other providers are documented at external-secrets.io.",{"_3640":256,"_31229":214,"_21648":51807,"_5":14899,"_28426":51691,"_3090":51808},[],"Only these credentials moved into Secrets: other values, such as connector and crypto-engine settings, are still configured through the values file.",{"_3640":257,"_31229":214,"_21648":51810,"_5":14899,"_28426":51695,"_3090":51811},[],"Create a Secret containing `tls.crt` and `tls.key`, then reference it. The Secret must already exist before installing: in `external` mode the chart renders no cert-manager resources and never creates this Secret.",{"_3640":258,"_31229":214,"_21648":51813,"_5":14899,"_28426":51699,"_3090":51814},[],"`amqp.tls: true` selects AMQPS in every event-bus configuration block. The default port stays `5672` and does not change automatically when TLS is enabled, so set `amqp.port` to the broker's TLS listener, commonly `5671`.",{"_3640":259,"_31229":214,"_21648":51816,"_5":14899,"_28426":51699,"_3090":51817},[],"With no CA Secret configured, the event-bus clients use the system-trusted CAs. To trust a private CA, create a Secret in the release namespace containing the CA certificate in PEM format and set `amqp.ca.secretName` (and `amqp.ca.certificateKey` if the data key is not `ca.crt`).",{"_3640":260,"_31229":214,"_21648":51819,"_5":14899,"_28426":51699,"_3090":51820},[],"For brokers that require mutual TLS, create a Secret containing the client certificate and private key and set `amqp.client.secretName` (with `amqp.client.certificateKey` and `amqp.client.privateKeyKey` if the data keys are not `tls.crt` and `tls.key`).",{"_3640":261,"_31229":214,"_21648":51822,"_5":14899,"_28426":51699,"_3090":51823},[],"The chart mounts configured Secrets read-only into every AMQP-consuming workload: the CA certificate under `/etc/lamassu/amqp/ca` and the client certificate and key under `/etc/lamassu/amqp/client`. The mounted file names are always `ca.crt`, `tls.crt` and `tls.key` — the `certificateKey` and `privateKeyKey` values rename only the Secret data keys, never the on-disk paths. The client private key is mounted with restrictive permissions (`defaultMode: 0440`; the CA volume uses `0444`), which works because the chart adds `fsGroup` to the pod security context when `amqp.client.secretName` is set — the chart's default pod security context already sets `fsGroup: 65532` for every service pod, so this top-up applies only when an explicit `podSecurityContext` without `fsGroup` was overridden and an AMQP client Secret is configured — and it uses the container `runAsGroup` (default `65532`) when `fsGroup` is not already set.",{"_3640":262,"_31229":214,"_21648":51825,"_5":14899,"_28426":51699,"_3090":51826},[],"Both Secret options require `amqp.tls: true`: `values.schema.json` rejects a non-empty `secretName` when `tls` is false, rejects unknown keys and rejects data-key names outside `^[A-Za-z0-9._-]+$`. The referenced Secret must exist in the release namespace or the consuming pods fail to start.",{"_3640":263,"_31229":214,"_21648":51828,"_5":14899,"_28426":51699,"_3090":51829},[],"The AMQP client loads certificates at startup, so restart the consuming pods after updating either Secret. Changing any `amqp` value rolls the consuming pods through the `checksum/config` annotation, but a change to Secret content alone does not trigger a rollout.",{"_3640":264,"_31229":214,"_21648":51831,"_5":14899,"_28426":51699,"_3090":51832},[],"Per the migration guide `charts/lamassu/CHANGELOG/3.8.0->4.0.0.md`: in 3.8.0 `amqp.tls` was not applied and event-bus clients used plaintext AMQP; from 4.0.0, `amqp.tls: true` switches them to AMQPS. Set `amqp.port` to the broker TLS listener before upgrading, or set `amqp.tls: false` to keep plaintext AMQP. `amqp.tls: false` sends the broker credentials and all event-bus traffic in cleartext.",{"_3640":265,"_31229":214,"_21648":51834,"_5":14899,"_28426":51703,"_3090":51835},[],"There is no implicit superuser. Create the role or group expected by `services.authz.bootstrap` in the OIDC provider and assign it to at least one administrator before exposing Lamassu.",{"_3640":266,"_31229":214,"_21648":51837,"_5":14899,"_28426":51703,"_3090":51838},[],"The pre-install and pre-upgrade job applies the bootstrap idempotently: existing principals are preserved and missing grants are added.",{"_3640":267,"_31229":214,"_21648":51840,"_5":14899,"_28426":51703,"_3090":51841},[],"Test both an authorized identity and a denied identity. If no token matches an active bootstrap principal, nobody can administer the PKI.",{"_3640":268,"_31229":214,"_21648":51843,"_5":14899,"_28426":51703,"_3090":51844},[],"See Access control for the principal and policy model.",{"_3640":269,"_31229":214,"_21648":51846,"_5":14899,"_28426":51707,"_3090":51847},[],"The dashboard includes an experimental browser terminal for working with devices. It is disabled by default; enable it in the values file:",{"_3640":270,"_31229":214,"_21648":51849,"_5":14899,"_28426":51707,"_3090":51850},[],"Enabling the terminal requires external authorization: set `auth.externalAuthorization.enabled: true` and `auth.externalAuthorization.failOpen: false`. The chart refuses to render the release otherwise, because the terminal's WebSocket endpoint would then be exposed through the Gateway without external authorization.",{"_3640":271,"_31229":214,"_21648":51852,"_5":14899,"_28426":51707,"_3090":51853},[],"Only identities granted the preloaded \"Terminal Network\" policy can open terminal sessions. See Access control for how policies are assigned.",{"_3640":272,"_31229":214,"_21648":51855,"_5":14899,"_28426":51707,"_3090":51856},[],"Note that even with the terminal enabled, pods inside the cluster can still reach the UI service directly unless network policies restrict that access — the external authorization applies to traffic entering through the Gateway.",{"_3640":273,"_31229":214,"_21648":51858,"_5":14899,"_28426":51711,"_3090":51859},[],"To install a local checkout instead:",{"_3640":274,"_31229":214,"_21648":51861,"_5":14899,"_28426":51715,"_3090":51862},[],"The Gateway should report `PROGRAMMED=True`. If it is programmed but has no usable address, continue with Expose the Gateway.",{"_3640":275,"_31229":214,"_21648":51864,"_5":14899,"_28426":51715,"_3090":51865},[],"The Helm test checks the CA, DMS Manager, Device Manager and VA health endpoints and verifies the UI response.",{"_3640":276,"_31229":214,"_21648":51867,"_5":14899,"_28426":51719,"_3090":51868},[],"Version-specific upgrade steps live in `charts/lamassu/CHANGELOG/` in the Helm repository. The chart also ships an optional pre-upgrade Job that migrates existing CA private keys into the KMS engine configured for the release. It is off by default (`migrations.caToKms.enabled: false`) and is only needed when upgrading from a version prior to 3.7.0.",{"_3640":277,"_31229":214,"_21648":51870,"_5":14899,"_28426":51719,"_3090":51871},[],"While the flag is enabled, every `helm upgrade` creates the `<chart fullname>-ca-to-kms-migration` Job (`lamassu-ca-to-kms-migration` for release `lamassu`); a fresh install does not create it. Its hook weight is `-10`, so it runs before the other pre-upgrade hooks: the authorization bootstrap configuration (weight `-4`) and the database-migration Job (weight `-3`).",{"_3640":278,"_31229":214,"_21648":51873,"_5":14899,"_28426":51719,"_3090":51874},[],"The Job consumes the same KMS service configuration the chart renders into the KMS ConfigMap, including the engines from `services.kms.cryptoEngines`, and runs the migration tool defined in `migrations.caToKms.image`. It mounts that configuration read-only at `/etc/lamassuiot/config.yml` from the ConfigMap key `config`, so configure the destination engine in your values before the upgrade that performs the migration.",{"_3640":279,"_31229":214,"_21648":51876,"_5":14899,"_28426":51719,"_3090":51877},[],"The Job resolves its configuration through a projected volume with two optional sources: the release-scoped `<chart fullname>-kms-config` (`lamassu-kms-config` for release `lamassu`, `prod-lamassu-kms-config` for release `prod`) and the legacy unscoped `kms-config` created by chart versions before release-scoped naming. The legacy configuration remains authoritative while it is still present, and the release-scoped one is used once the legacy one is gone. Both sources are optional, so a missing ConfigMap never leaves the upgrade pod in `ContainerCreating`.",{"_3640":280,"_31229":214,"_21648":51879,"_5":14899,"_28426":51719,"_3090":51880},[],"Keep `migrations.caToKms.enabled: true` for the upgrade that performs the migration, then remove the flag from your values once the migration completes; it defaults to `false`.",{"_3640":281,"_31229":214,"_21648":51882,"_5":14899,"_28426":51723,"_3090":51883},[],"Before going live, review:",{"_3640":282,"_31229":214,"_21648":51885,"_5":14899,"_28426":51723,"_3090":51886},[],"backup and recovery for PostgreSQL and persistent volumes",{"_3640":283,"_31229":214,"_21648":51888,"_5":14899,"_28426":51723,"_3090":51889},[],"a production KMS engine; the default filesystem engine is not an HA design",{"_3640":284,"_31229":214,"_21648":51891,"_5":14899,"_28426":51723,"_3090":51892},[],"shared VA storage before increasing VA replicas",{"_3640":285,"_31229":214,"_21648":51894,"_5":14899,"_28426":51723,"_3090":51895},[],"managed OIDC roles and removal of evaluation credentials",{"_3640":286,"_31229":214,"_21648":51897,"_5":14899,"_28426":51723,"_3090":51898},[],"a trusted TLS issuer or externally managed certificate",{"_3640":287,"_31229":214,"_21648":51900,"_5":14899,"_28426":51723,"_3090":51901},[],"resource requests, replicas, autoscaling, disruption budgets and placement",{"_3640":288,"_31229":214,"_21648":51903,"_5":14899,"_28426":51723,"_3090":51904},[],"SMTP, observability and alert delivery",{"_3640":289,"_31229":214,"_21648":51906,"_5":14899,"_28426":51723,"_3090":51907},[],"the version upgrade guides and migration notes in `charts/lamassu/CHANGELOG/` before every upgrade, including the optional CA-to-KMS migration hook described above",{"_3640":290,"_31229":214,"_21648":51909,"_5":14899,"_28426":51723,"_3090":51910},[],"The complete values reference is maintained in `charts/lamassu/VALUES.md` in the Helm repository.",{"_3640":291,"_31229":291,"_5":15259,"_3090":51912,"_31567":51913,"_21648":51914,"_28426":291},"Expose the Gateway",[51054,51055,51161],[],{"_3640":292,"_31229":291,"_21648":51916,"_5":14899,"_28426":291,"_3090":51917},[],"Choose how clients reach Lamassu, when to set gateway.addresses and how to design multiple Gateways.",{"_3640":293,"_31229":291,"_5":31564,"_21648":51919,"_28426":51920,"_3090":51921},[],"/docs/deployment/self-hosted/networking#expose-the-lamassu-gateway","Expose the Lamassu Gateway",{"_3640":294,"_31229":291,"_5":31564,"_21648":51923,"_28426":51924,"_3090":51925},[],"/docs/deployment/self-hosted/networking#do-you-need-gatewayaddresses","Do you need `gateway.addresses`?",{"_3640":295,"_31229":291,"_5":31564,"_21648":51927,"_28426":51928,"_3090":51929},[],"/docs/deployment/self-hosted/networking#recommended-single-node-design","Recommended single-node design",{"_3640":296,"_31229":291,"_5":31564,"_21648":51931,"_28426":51932,"_3090":51933},[],"/docs/deployment/self-hosted/networking#k3s","K3s",{"_3640":297,"_31229":291,"_5":31564,"_21648":51935,"_28426":51936,"_3090":51937},[],"/docs/deployment/self-hosted/networking#bare-metal-with-metallb-or-kube-vip","Bare metal with MetalLB or kube-vip",{"_3640":298,"_31229":291,"_5":31564,"_21648":51939,"_28426":51940,"_3090":51941},[],"/docs/deployment/self-hosted/networking#external-reverse-proxy-nat-or-vpn","External reverse proxy, NAT or VPN",{"_3640":299,"_31229":291,"_5":31564,"_21648":51943,"_28426":51944,"_3090":51945},[],"/docs/deployment/self-hosted/networking#what-if-you-need-three-gateways","What if you need three Gateways?",{"_3640":300,"_31229":291,"_5":31564,"_21648":51947,"_28426":51948,"_3090":51949},[],"/docs/deployment/self-hosted/networking#client-certificates-and-identity-headers","Client certificates and identity headers",{"_3640":301,"_31229":291,"_5":31564,"_21648":51951,"_28426":51952,"_3090":51953},[],"/docs/deployment/self-hosted/networking#decision-guide","Decision guide",{"_3640":302,"_31229":291,"_5":31564,"_21648":51955,"_28426":51956,"_3090":51957},[],"/docs/deployment/self-hosted/networking#egress-proxy","Egress proxy",{"_3640":303,"_31229":291,"_5":31564,"_21648":51959,"_28426":51960,"_3090":51961},[],"/docs/deployment/self-hosted/networking#verify-the-traffic-path","Verify the traffic path",{"_3640":304,"_31229":291,"_21648":51963,"_5":14899,"_28426":51920,"_3090":51964},[],"The Lamassu chart creates one shared Gateway with HTTP and HTTPS listeners. Envoy Gateway normally creates a dedicated proxy deployment and a `LoadBalancer` Service for it.",{"_3640":305,"_31229":291,"_21648":51966,"_5":14899,"_28426":51920,"_3090":51967},[],"External reachability is the result of the whole path. A `Gateway` resource alone does not configure your router, firewall, DNS, cloud load balancer or upstream NAT.",{"_3640":306,"_31229":291,"_21648":51969,"_5":14899,"_28426":51924,"_3090":51970},[],"Usually, no. If you omit it, the Gateway controller and the cluster load-balancer implementation can assign an address and report it in `Gateway.status.addresses` and the generated Service status.",{"_3640":307,"_31229":291,"_21648":51972,"_5":14899,"_28426":51924,"_3090":51973},[],"Set it only when:",{"_3640":308,"_31229":291,"_21648":51975,"_5":14899,"_28426":51924,"_3090":51976},[],"your cloud or bare-metal load balancer supports requesting a specific address",{"_3640":309,"_31229":291,"_21648":51978,"_5":14899,"_28426":51924,"_3090":51979},[],"that address is allocated to this Gateway",{"_3640":310,"_31229":291,"_21648":51981,"_5":14899,"_28426":51924,"_3090":51982},[],"the surrounding network already routes traffic for it to the cluster",{"_3640":311,"_31229":291,"_21648":51984,"_5":14899,"_28426":51924,"_3090":51985},[],"This requests `192.168.1.50`; it does not claim the IP on your LAN or make it reachable.",{"_3640":312,"_31229":291,"_21648":51987,"_5":14899,"_28426":51924,"_3090":51988},[],"Keep these two settings separate:",{"_3640":313,"_31229":291,"_21648":51990,"_5":14899,"_28426":51924,"_3090":51991},[],"`gateway.addresses` requests an address for the Gateway.",{"_3640":314,"_31229":291,"_21648":51993,"_5":14899,"_28426":51924,"_3090":51994},[],"`tls.certManagerOptions.certSpec.addresses` adds IP subject alternative names to the TLS certificate.",{"_3640":315,"_31229":291,"_21648":51996,"_5":14899,"_28426":51924,"_3090":51997},[],"If users connect by DNS name, put that name in `tls.certManagerOptions.certSpec.hostnames`. Do not copy an upstream proxy's public IP into `gateway.addresses`.",{"_3640":316,"_31229":291,"_21648":51999,"_5":14899,"_28426":51928,"_3090":52000},[],"For a small VM running K3s or MicroK8s, use one external Lamassu Gateway and route every Lamassu endpoint through it:",{"_3640":317,"_31229":291,"_21648":52002,"_5":14899,"_28426":51928,"_3090":52003},[],"This design uses one IP, one TLS entry point and one pair of ports. The chart already creates the required routes.",{"_3640":318,"_31229":291,"_21648":52005,"_5":14899,"_28426":51932,"_3090":52006},[],"K3s ServiceLB implements each `LoadBalancer` Service with pods that reserve the Service ports on the node. On a single node, only one Service can therefore own port 80 and one can own port 443. The default K3s Traefik Service may already hold both ports.",{"_3640":319,"_31229":291,"_21648":52008,"_5":14899,"_28426":51932,"_3090":52009},[],"For the recommended design:",{"_3640":320,"_31229":291,"_21648":52011,"_5":14899,"_28426":51932,"_3090":52012},[],"Use only one externally exposed Lamassu Gateway.",{"_3640":321,"_31229":291,"_21648":52014,"_5":14899,"_28426":51932,"_3090":52015},[],"Ensure ports 80 and 443 are free. Disable or reconfigure Traefik if it is not part of your traffic path.",{"_3640":322,"_31229":291,"_21648":52017,"_5":14899,"_28426":51932,"_3090":52018},[],"Allow those ports through the VM firewall and any upstream security group.",{"_3640":323,"_31229":291,"_21648":52020,"_5":14899,"_28426":51932,"_3090":52021},[],"Point DNS at the VM's reachable address.",{"_3640":324,"_31229":291,"_21648":52023,"_5":14899,"_28426":51932,"_3090":52024},[],"See the K3s ServiceLB documentation for its host-port behavior and how to replace it with another load-balancer implementation.",{"_3640":325,"_31229":291,"_21648":52026,"_5":14899,"_28426":51936,"_3090":52027},[],"Allocate a VIP from an address pool reachable on your LAN. You may request that VIP with `gateway.addresses` if the selected implementation supports it. Confirm the assigned address in status rather than assuming the request succeeded.",{"_3640":326,"_31229":291,"_21648":52029,"_5":14899,"_28426":51940,"_3090":52030},[],"An external public address can forward TCP 80 and 443 to the VM or to a Kubernetes-side VIP:",{"_3640":327,"_31229":291,"_21648":52032,"_5":14899,"_28426":51940,"_3090":52033},[],"The public IP belongs to the external device. Leave `gateway.addresses` unset or set it to the actual Kubernetes-side address, never to an address that the cluster cannot bind.",{"_3640":328,"_31229":291,"_21648":52035,"_5":14899,"_28426":51944,"_3090":52036},[],"First decide whether you need three independent data planes or only three hostnames.",{"_3640":329,"_31229":291,"_21648":52038,"_5":14899,"_28426":51944,"_3090":52039},[],"Requirement",{"_3640":330,"_31229":291,"_21648":52041,"_5":14899,"_28426":51944,"_3090":52042},[],"Recommended design",{"_3640":331,"_31229":291,"_21648":52044,"_5":14899,"_28426":51944,"_3090":52045},[],"Consequence",{"_3640":332,"_31229":291,"_21648":52047,"_5":14899,"_28426":51944,"_3090":52048},[],"Several Lamassu URLs or services",{"_3640":333,"_31229":291,"_21648":52050,"_5":14899,"_28426":51944,"_3090":52051},[],"One Gateway with multiple routes",{"_3640":334,"_31229":291,"_21648":52053,"_5":14899,"_28426":51944,"_3090":52054},[],"One IP and one proxy fleet; this is the chart default",{"_3640":335,"_31229":291,"_21648":52056,"_5":14899,"_28426":51944,"_3090":52057},[],"Independent Gateways and separate external IPs",{"_3640":336,"_31229":291,"_21648":52059,"_5":14899,"_28426":51944,"_3090":52060},[],"One VIP per Gateway",{"_3640":337,"_31229":291,"_21648":52062,"_5":14899,"_28426":51944,"_3090":52063},[],"All Gateways can use 80/443; requires a load balancer with an address pool",{"_3640":338,"_31229":291,"_21648":52065,"_5":14899,"_28426":51944,"_3090":52066},[],"Independent Gateways on one node and one IP",{"_3640":339,"_31229":291,"_21648":52068,"_5":14899,"_28426":51944,"_3090":52069},[],"Use different external ports",{"_3640":340,"_31229":291,"_21648":52071,"_5":14899,"_28426":51944,"_3090":52072},[],"Clients must include non-standard ports",{"_3640":341,"_31229":291,"_21648":52074,"_5":14899,"_28426":51944,"_3090":52075},[],"Separate TLS/mTLS termination behind one IP",{"_3640":342,"_31229":291,"_21648":52077,"_5":14899,"_28426":51944,"_3090":52078},[],"Front-door SNI routing to internal Gateways",{"_3640":343,"_31229":291,"_21648":52080,"_5":14899,"_28426":51944,"_3090":52081},[],"Advanced design; the front door uses TLS passthrough and each internal Gateway terminates its own TLS",{"_3640":344,"_31229":291,"_21648":52083,"_5":14899,"_28426":51944,"_3090":52084},[],"Separate Gateway resources but shared proxy infrastructure",{"_3640":345,"_31229":291,"_21648":52086,"_5":14899,"_28426":51944,"_3090":52087},[],"Envoy merged-Gateway mode",{"_3640":346,"_31229":291,"_21648":52089,"_5":14899,"_28426":51944,"_3090":52090},[],"Logical separation only; listeners must have unique port, protocol and hostname tuples",{"_3640":347,"_31229":291,"_21648":52092,"_5":14899,"_28426":51944,"_3090":52093},[],"Three independent `LoadBalancer` Services cannot all reserve the same node ports 80 and 443 through K3s ServiceLB. Use one shared Gateway, allocate distinct VIPs with another load-balancer implementation, or use different ports.",{"_3640":348,"_31229":291,"_21648":52095,"_5":14899,"_28426":51944,"_3090":52096},[],"Envoy Gateway normally provisions a proxy fleet per `Gateway`. Its merged-Gateway mode can share one fleet and address, but it is not a drop-in switch for multiple Lamassu releases: the generated Lamassu listeners use the same ports and protocols without distinct hostnames, so they conflict unless you deliberately customize the listener design.",{"_3640":349,"_31229":291,"_21648":52098,"_5":14899,"_28426":51944,"_3090":52099},[],"Use a front-door SNI design only when the internal Gateways must retain independent TLS or mTLS policy:",{"_3640":350,"_31229":291,"_21648":52101,"_5":14899,"_28426":51944,"_3090":52102},[],"This requires distinct SNI hostnames and cluster networking outside the Lamassu chart.",{"_3640":351,"_31229":291,"_21648":52104,"_5":14899,"_28426":51948,"_3090":52105},[],"The chart renders a `ClientTrafficPolicy` named `enable-mtls` on its shared Gateway automatically; no Helm value enables or disables it. TLS termination accepts requests with or without a client certificate: devices may present one, but they are not required to. Before forwarding a request, the Gateway removes identity and certificate headers that a client could otherwise supply itself: `X-Principal-Id`, `X-Lms-Source`, `X-Forwarded-Client-Cert`, `X-Forwarded-Cert`, `X-Forwarded-Tls-Client-Cert` (the Traefik spelling), `Ssl-Client-Cert` and `X-Amzn-Mtls-Clientcert`. The Traefik spelling is included because backends that accept `X-Forwarded-Tls-Client-Cert` directly would otherwise receive certificate identity data supplied by the client itself, without a client certificate having been presented. After stripping, Envoy adds its own `X-Forwarded-Client-Cert` carrying the presented certificate and its chain, so services that read certificate identity receive only gateway-generated values. No Helm value changes the list of stripped headers. The Access control page describes how `authz` uses this protection to keep `X-Principal-ID` out of reach of clients.",{"_3640":352,"_31229":291,"_21648":52107,"_5":14899,"_28426":51952,"_3090":52108},[],"If one Gateway can own TLS and routing, use the chart default.",{"_3640":353,"_31229":291,"_21648":52110,"_5":14899,"_28426":51952,"_3090":52111},[],"If Gateways need independent policy and you can allocate IPs, use one VIP per Gateway.",{"_3640":354,"_31229":291,"_21648":52113,"_5":14899,"_28426":51952,"_3090":52114},[],"If only the Kubernetes resources need separation, evaluate merged-Gateway mode and make every listener tuple unique.",{"_3640":355,"_31229":291,"_21648":52116,"_5":14899,"_28426":51952,"_3090":52117},[],"If data planes and TLS termination must stay independent behind one IP, add a front-door SNI passthrough layer.",{"_3640":356,"_31229":291,"_21648":52119,"_5":14899,"_28426":51952,"_3090":52120},[],"If none of those are possible, use different external ports or change the external network design.",{"_3640":357,"_31229":291,"_21648":52122,"_5":14899,"_28426":51956,"_3090":52123},[],"Internal Lamassu clients — the Vault engine connection, service-to-service calls and webhook deliveries — honor the `HTTP_PROXY`, `HTTPS_PROXY` and `NO_PROXY` environment variables. The exception is the authorization-engine connector: it uses its own transport and does not consult these proxy variables. If your deployment routes egress through a proxy, list in-cluster service names in `NO_PROXY` (for example `.svc,.cluster.local`) so internal traffic stays inside the cluster. Loopback traffic is never sent through a proxy.",{"_3640":358,"_31229":291,"_21648":52125,"_5":14899,"_28426":51956,"_3090":52126},[],"The default transport of these clients bounds the dial timeout (30 seconds), the TLS handshake (10 seconds) and idle connection reuse (90 seconds) so an unreachable dependency fails fast instead of hanging; these values are Go transport defaults, not Lamassu settings. HTTP/2 is negotiated when the peer supports it. The authorization-engine connector keeps its own transport without these dial and handshake timeouts; only its overall 30-second request timeout bounds each call.",{"_3640":359,"_31229":291,"_21648":52128,"_5":14899,"_28426":51960,"_3090":52129},[],"Check, in order:",{"_3640":360,"_31229":291,"_21648":52131,"_5":14899,"_28426":51960,"_3090":52132},[],"`Gateway` has `Accepted=True` and `Programmed=True`.",{"_3640":361,"_31229":291,"_21648":52134,"_5":14899,"_28426":51960,"_3090":52135},[],"Its status contains the expected address.",{"_3640":362,"_31229":291,"_21648":52137,"_5":14899,"_28426":51960,"_3090":52138},[],"The generated `LoadBalancer` Service has a usable external address.",{"_3640":363,"_31229":291,"_21648":52140,"_5":14899,"_28426":51960,"_3090":52141},[],"Port 443 reaches that address from the client network.",{"_3640":364,"_31229":291,"_21648":52143,"_5":14899,"_28426":51960,"_3090":52144},[],"DNS resolves to the externally reachable endpoint.",{"_3640":365,"_31229":291,"_21648":52146,"_5":14899,"_28426":51960,"_3090":52147},[],"The certificate contains the DNS name or IP used by the client.",{"_3640":366,"_31229":291,"_21648":52149,"_5":14899,"_28426":51960,"_3090":52150},[],"The Gateway API treats addresses as desired state that a controller may assign or reject; see the Gateway API overview for the resource model.",{"_3640":367,"_31229":367,"_5":15259,"_3090":51161,"_31567":52152,"_21648":52153,"_28426":367},[51054,51055,51161],[],{"_3640":368,"_31229":367,"_21648":52155,"_5":14899,"_28426":367,"_3090":52156},[],"Choose an installation workflow and network architecture for Lamassu on your Kubernetes cluster.",{"_3640":369,"_31229":367,"_5":31564,"_21648":52158,"_28426":52159,"_3090":52160},[],"/docs/deployment/self-hosted/overview#self-managed-kubernetes-deployment","Self-managed Kubernetes deployment",{"_3640":370,"_31229":367,"_5":31564,"_21648":52162,"_28426":52163,"_3090":52164},[],"/docs/deployment/self-hosted/overview#choose-an-installation-workflow","Choose an installation workflow",{"_3640":371,"_31229":367,"_5":31564,"_21648":52166,"_28426":52167,"_3090":52168},[],"/docs/deployment/self-hosted/overview#what-the-lamassu-chart-provides","What the Lamassu chart provides",{"_3640":372,"_31229":367,"_5":31564,"_21648":52170,"_28426":52171,"_3090":52172},[],"/docs/deployment/self-hosted/overview#how-the-deployment-fits-together","How the deployment fits together",{"_3640":373,"_31229":367,"_5":31564,"_21648":52174,"_28426":52175,"_3090":52176},[],"/docs/deployment/self-hosted/overview#platform-requirements","Platform requirements",{"_3640":374,"_31229":367,"_5":31564,"_21648":52178,"_28426":52179,"_3090":52180},[],"/docs/deployment/self-hosted/overview#choose-the-next-page","Choose the next page",{"_3640":375,"_31229":367,"_21648":52182,"_5":14899,"_28426":52159,"_3090":52183},[],"Run Lamassu in a Kubernetes cluster operated by your team. The Helm chart deploys the Lamassu services and their routing resources; you provide the cluster, persistent storage, identity provider, PostgreSQL, RabbitMQ and the network path used by clients.",{"_3640":376,"_31229":367,"_21648":52185,"_5":14899,"_28426":52163,"_3090":52186},[],"Workflow",{"_3640":377,"_31229":367,"_21648":52188,"_5":14899,"_28426":52163,"_3090":52189},[],"Use it for",{"_3640":378,"_31229":367,"_21648":52191,"_5":14899,"_28426":52163,"_3090":52192},[],"What it installs",{"_3640":379,"_31229":367,"_21648":52194,"_5":14899,"_28426":52163,"_3090":52195},[],"Helm",{"_3640":380,"_31229":367,"_21648":52197,"_5":14899,"_28426":52163,"_3090":52198},[],"Production and controlled environments",{"_3640":381,"_31229":367,"_21648":52200,"_5":14899,"_28426":52163,"_3090":52201},[],"Lamassu services and Gateway API resources",{"_3640":382,"_31229":367,"_21648":52203,"_5":14899,"_28426":52163,"_3090":51298},[],{"_3640":383,"_31229":367,"_21648":52205,"_5":14899,"_28426":52163,"_3090":52206},[],"Evaluation, demos, CI and small lab clusters",{"_3640":384,"_31229":367,"_21648":52208,"_5":14899,"_28426":52163,"_3090":52209},[],"PostgreSQL, Keycloak, RabbitMQ, Envoy Gateway and Lamassu",{"_3640":385,"_31229":367,"_21648":52211,"_5":14899,"_28426":52167,"_3090":52212},[],"The Lamassu chart is an **application chart**, not a cluster bootstrap chart. It creates the Kubernetes resources that run and configure Lamassu, but it expects the platform services those resources depend on to exist.",{"_3640":386,"_31229":367,"_21648":52214,"_5":14899,"_28426":52167,"_3090":52215},[],"Area",{"_3640":387,"_31229":367,"_21648":52217,"_5":14899,"_28426":52167,"_3090":52218},[],"The Lamassu chart provides",{"_3640":388,"_31229":367,"_21648":52220,"_5":14899,"_28426":52167,"_3090":52221},[],"You provide",{"_3640":389,"_31229":367,"_21648":52223,"_5":14899,"_28426":52167,"_3090":52224},[],"Lamassu applications",{"_3640":390,"_31229":367,"_21648":52226,"_5":14899,"_28426":52167,"_3090":52227},[],"Deployments and StatefulSets for the UI and APIs, internal Services, ConfigMaps, a ServiceAccount, and optional HPAs and PDBs",{"_3640":391,"_31229":367,"_21648":52229,"_5":14899,"_28426":52167,"_3090":52230},[],"A working Kubernetes cluster, compute capacity and access to the container images",{"_3640":392,"_31229":367,"_21648":52232,"_5":14899,"_28426":52167,"_3090":52233},[],"PostgreSQL data",{"_3640":393,"_31229":367,"_21648":52235,"_5":14899,"_28426":52167,"_3090":52236},[],"A pre-install/pre-upgrade job that creates the required databases and schemas, runs migrations and applies the authorization bootstrap",{"_3640":394,"_31229":367,"_21648":52238,"_5":14899,"_28426":52167,"_3090":52239},[],"A reachable PostgreSQL server, credentials allowed to create databases and schemas, and backup/HA operations",{"_3640":395,"_31229":367,"_21648":52241,"_5":14899,"_28426":52167,"_3090":52242},[],"Messaging",{"_3640":396,"_31229":367,"_21648":52244,"_5":14899,"_28426":52167,"_3090":52245},[],"RabbitMQ connection configuration for the Lamassu services; the connection can use AMQPS, with an optional private CA and an optional client certificate, both set through chart values",{"_3640":397,"_31229":367,"_21648":52247,"_5":14899,"_28426":52167,"_3090":52248},[],"A reachable RabbitMQ broker, credentials and its lifecycle",{"_3640":398,"_31229":367,"_21648":52250,"_5":14899,"_28426":52167,"_3090":52251},[],"Identity",{"_3640":399,"_31229":367,"_21648":52253,"_5":14899,"_28426":52167,"_3090":52254},[],"OIDC/JWT and external-authorization configuration, plus initial Lamassu authorization principals",{"_3640":400,"_31229":367,"_21648":52256,"_5":14899,"_28426":52167,"_3090":52257},[],"An OIDC provider, realm/tenant, client, users, groups and roles",{"_3640":401,"_31229":367,"_21648":52259,"_5":14899,"_28426":52167,"_3090":52260},[],"External routing",{"_3640":402,"_31229":367,"_21648":52262,"_5":14899,"_28426":52167,"_3090":52263},[],"One `Gateway`, `HTTPRoute` resources, an `EnvoyProxy` configuration and Envoy security policies",{"_3640":403,"_31229":367,"_21648":52265,"_5":14899,"_28426":52167,"_3090":52266},[],"Gateway API and Envoy CRDs, the Envoy Gateway controller, a `GatewayClass`, a load-balancer implementation and the external network path",{"_3640":404,"_31229":367,"_21648":52268,"_5":14899,"_28426":52167,"_3090":52269},[],"TLS",{"_3640":405,"_31229":367,"_21648":52271,"_5":14899,"_28426":52167,"_3090":52272},[],"In the default `tls.type: certManager` mode, cert-manager `Issuer` and CA `Certificate` resources and a chart-managed downstream `Certificate`; in the `tls.type: external` mode, a reference to your TLS Secret",{"_3640":406,"_31229":367,"_21648":52274,"_5":14899,"_28426":52167,"_3090":52275},[],"cert-manager only for the default `tls.type: certManager` mode; for trusted TLS, a trusted issuer or a populated TLS Secret",{"_3640":407,"_31229":367,"_21648":52277,"_5":14899,"_28426":52167,"_3090":52278},[],"Persistent application data",{"_3640":408,"_31229":367,"_21648":52280,"_5":14899,"_28426":52167,"_3090":52281},[],"PersistentVolumeClaims required by the default local KMS and VA storage",{"_3640":409,"_31229":367,"_21648":52283,"_5":14899,"_28426":52167,"_3090":52284},[],"A StorageClass, physical storage, backups and a shared/external backend when scaling requires one",{"_3640":410,"_31229":367,"_21648":52286,"_5":14899,"_28426":52167,"_3090":52287},[],"Optional integrations",{"_3640":411,"_31229":367,"_21648":52289,"_5":14899,"_28426":52167,"_3090":52290},[],"Configuration hooks for observability, AWS connectors and PKCS#11/HSM connectivity",{"_3640":412,"_31229":367,"_21648":52292,"_5":14899,"_28426":52167,"_3090":52293},[],"The observability backends, cloud credentials and production HSM or external key service",{"_3640":413,"_31229":367,"_21648":52295,"_5":14899,"_28426":52167,"_3090":52296},[],"The chart creates Lamassu's `Gateway` and routes. It does not install the Envoy Gateway controller or make the generated `LoadBalancer` Service reachable from your network.",{"_3640":414,"_31229":367,"_21648":52298,"_5":14899,"_28426":52167,"_3090":52299},[],"Use one Lamassu Gateway on ports 80 and 443 and let its HTTPRoutes dispatch traffic to every Lamassu service. Give that Gateway one externally reachable endpoint through the cluster load balancer, or forward traffic to it from an external proxy or NAT device. You do not need one Gateway per service.",{"_3640":415,"_31229":367,"_21648":52301,"_5":14899,"_28426":52171,"_3090":52302},[],"The chart creates one shared `Gateway` per Helm release. All chart-managed `HTTPRoute` resources attach to it. Envoy Gateway provisions the proxy data plane and a Kubernetes `LoadBalancer` Service for that Gateway.",{"_3640":416,"_31229":367,"_21648":52304,"_5":14899,"_28426":52171,"_3090":52305},[],"The `gateway.addresses` value is only an address request to the Gateway controller. It does not make an IP routable, open a firewall, configure DNS or create NAT. See Expose the Gateway before setting it.",{"_3640":417,"_31229":367,"_21648":52307,"_5":14899,"_28426":52175,"_3090":52308},[],"Kubernetes 1.24 or newer",{"_3640":418,"_31229":367,"_21648":52310,"_5":14899,"_28426":52175,"_3090":52311},[],"Helm 3.2 or newer",{"_3640":419,"_31229":367,"_21648":52313,"_5":14899,"_28426":52175,"_3090":52314},[],"Envoy Gateway 1.8 or newer and a `GatewayClass`",{"_3640":420,"_31229":367,"_21648":52316,"_5":14899,"_28426":52175,"_3090":52317},[],"cert-manager 1.14 or newer; required only for the default `tls.type: certManager` TLS mode, not for `tls.type: external`",{"_3640":421,"_31229":367,"_21648":52319,"_5":14899,"_28426":52175,"_3090":52320},[],"persistent storage suitable for the selected PostgreSQL, RabbitMQ, VA and KMS configuration",{"_3640":422,"_31229":367,"_21648":52322,"_5":14899,"_28426":52175,"_3090":52323},[],"a load-balancer implementation or another deliberate path from clients to the Gateway",{"_3640":423,"_31229":367,"_21648":52325,"_5":14899,"_28426":52175,"_3090":52326},[],"KMS deployments using the native PKCS#11 sidecar require Kubernetes 1.29 or newer. Prebuilt Lamassu container images are published for `linux/amd64` and `linux/arm64`, and the KMS PKCS#11 client module (`p11-kit-client.so`) is installed at the target architecture's Debian library path: `/usr/lib/x86_64-linux-gnu/pkcs11/p11-kit-client.so` on amd64 and `/usr/lib/aarch64-linux-gnu/pkcs11/p11-kit-client.so` on arm64. The x86\\_64 path is retained as a compatibility alias for existing configurations.",{"_3640":424,"_31229":367,"_21648":52328,"_5":14899,"_28426":52179,"_3090":52329},[],"<Card title=\"Install with Helm\" description=\"Prepare dependencies, configure values, install and verify a controlled deployment.\" href=\"/docs/deployment/self-hosted/helm\" />",{"_3640":425,"_31229":367,"_21648":52331,"_5":14899,"_28426":52179,"_3090":52332},[],"<Card title=\"Upgrade from 3.8.0\" description=\"Upgrade an existing Helm release to 4.0.0: architecture changes, breaking changes, migration steps and validation.\" href=\"/docs/upgrades/3-8-0-to-4-0-0\" />",{"_3640":426,"_31229":367,"_21648":52334,"_5":14899,"_28426":52179,"_3090":52335},[],"<Card title=\"Expose the Gateway\" description=\"Choose an external traffic design, understand gateway.addresses and handle multiple Gateways.\" href=\"/docs/deployment/self-hosted/networking\" />",{"_3640":427,"_31229":367,"_21648":52337,"_5":14899,"_28426":52179,"_3090":52338},[],"<Card title=\"Use Fastlane\" description=\"Bootstrap a complete evaluation or lab environment with one script.\" href=\"/docs/deployment/self-hosted/fastlane\" />",{"_3640":428,"_31229":428,"_5":15259,"_3090":52340,"_31567":52341,"_21648":52343,"_28426":428},"Deployment troubleshooting",[51054,51055,52342],"Operations",[],{"_3640":429,"_31229":428,"_21648":52345,"_5":14899,"_28426":428,"_3090":52346},[],"Diagnose access, service health and infrastructure dependencies.",{"_3640":430,"_31229":428,"_5":31564,"_21648":52348,"_28426":52349,"_3090":52350},[],"/docs/deployment/troubleshooting#diagnostic-sequence","Diagnostic sequence",{"_3640":431,"_31229":428,"_5":31564,"_21648":52352,"_28426":52353,"_3090":52354},[],"/docs/deployment/troubleshooting#reproduce-a-single-operation","Reproduce a single operation",{"_3640":432,"_31229":428,"_5":31564,"_21648":52356,"_28426":52357,"_3090":52358},[],"/docs/deployment/troubleshooting#separate-client-gateway-and-service","Separate client, Gateway and service",{"_3640":433,"_31229":428,"_5":31564,"_21648":52360,"_28426":52361,"_3090":52362},[],"/docs/deployment/troubleshooting#review-kubernetes-status","Review Kubernetes status",{"_3640":434,"_31229":428,"_5":31564,"_21648":52364,"_28426":52365,"_3090":52366},[],"/docs/deployment/troubleshooting#query-the-affected-service","Query the affected service",{"_3640":435,"_31229":428,"_5":31564,"_21648":52368,"_28426":52369,"_3090":52370},[],"/docs/deployment/troubleshooting#validate-the-result-from-outside","Validate the result from outside",{"_3640":436,"_31229":428,"_5":31564,"_21648":52372,"_28426":52373,"_3090":52374},[],"/docs/deployment/troubleshooting#minimal-evidence-collection","Minimal evidence collection",{"_3640":437,"_31229":428,"_5":31564,"_21648":52376,"_28426":52377,"_3090":52378},[],"/docs/deployment/troubleshooting#i-cannot-sign-in","I cannot sign in",{"_3640":438,"_31229":428,"_5":31564,"_21648":52380,"_28426":52381,"_3090":52382},[],"/docs/deployment/troubleshooting#everything-returns-403-or-5xx","Everything returns 403 or 5xx",{"_3640":439,"_31229":428,"_5":31564,"_21648":52384,"_28426":52385,"_3090":52386},[],"/docs/deployment/troubleshooting#api-500-errors","API 500 errors",{"_3640":440,"_31229":428,"_5":31564,"_21648":52388,"_28426":52389,"_3090":52390},[],"/docs/deployment/troubleshooting#a-pod-is-not-ready","A pod is not Ready",{"_3640":441,"_31229":428,"_5":31564,"_21648":52392,"_28426":52393,"_3090":52394},[],"/docs/deployment/troubleshooting#events-are-not-arriving","Events are not arriving",{"_3640":442,"_31229":428,"_5":31564,"_21648":52396,"_28426":52397,"_3090":52398},[],"/docs/deployment/troubleshooting#observability","Observability",{"_3640":443,"_31229":428,"_21648":52400,"_5":14899,"_28426":428,"_3090":52401},[],"Start by locating the failing layer. A Gateway response and an unready pod require different evidence. For rejected issuance or validation results, see PKI troubleshooting; for enrollment, see EST diagnostics.",{"_3640":444,"_31229":428,"_21648":52403,"_5":14899,"_28426":52353,"_3090":52404},[],"Note the time in UTC, user or principal, resource, endpoint and result. Avoid repeating a destructive action such as revocation or deletion.",{"_3640":445,"_31229":428,"_21648":52406,"_5":14899,"_28426":52357,"_3090":52407},[],"Check the HTTP status. A 401 points to authentication; a 403, to authorization; a 404, to route or resource; a 5xx, to the service or a dependency.",{"_3640":446,"_31229":428,"_21648":52409,"_5":14899,"_28426":52361,"_3090":52410},[],"Locate unready pods, restarts, recent events and the state of the release.",{"_3640":447,"_31229":428,"_21648":52412,"_5":14899,"_28426":52365,"_3090":52413},[],"Review its /health endpoint and its logs in the same time window. Then follow the indicated dependency: PostgreSQL, RabbitMQ, the OIDC provider or the cryptographic engine.",{"_3640":448,"_31229":428,"_21648":52415,"_5":14899,"_28426":52369,"_3090":52416},[],"For PKI, check the certificate, the chain, OCSP or CRL with the same type of client production uses.",{"_3640":449,"_31229":428,"_21648":52418,"_5":14899,"_28426":52373,"_3090":52419},[],"Replace the placeholders with your real release, namespace and deployment.",{"_3640":450,"_31229":428,"_21648":52421,"_5":14899,"_28426":52373,"_3090":52422},[],"Also run the chart's connectivity test:",{"_3640":451,"_31229":428,"_21648":52424,"_5":14899,"_28426":52373,"_3090":52425},[],"The test checks the health of CA, DMS Manager, Device Manager and VA, and verifies that the UI returns HTML. A passing test confirms basic connectivity, not a full issuance flow.",{"_3640":452,"_31229":428,"_21648":52427,"_5":14899,"_28426":52373,"_3090":52428},[],"The chart's services expose startup, readiness and liveness probes over /health. A pod can be running but receive no traffic if the readiness probe fails.",{"_3640":453,"_31229":428,"_21648":52430,"_5":14899,"_28426":52377,"_3090":52431},[],"If you receive a 401:",{"_3640":454,"_31229":428,"_21648":52433,"_5":14899,"_28426":52377,"_3090":52434},[],"check that the UI's OIDC authority is reachable from the browser;",{"_3640":455,"_31229":428,"_21648":52436,"_5":14899,"_28426":52377,"_3090":52437},[],"verify issuer, audience and expiration of the token;",{"_3640":456,"_31229":428,"_21648":52439,"_5":14899,"_28426":52377,"_3090":52440},[],"confirm the Gateway can fetch the keys from the JWKS URI;",{"_3640":457,"_31229":428,"_21648":52442,"_5":14899,"_28426":52377,"_3090":52443},[],"check that the provider's public and internal routes point to the same realm.",{"_3640":458,"_31229":428,"_21648":52445,"_5":14899,"_28426":52377,"_3090":52446},[],"If login succeeds but the APIs return 403:",{"_3640":459,"_31229":428,"_21648":52448,"_5":14899,"_28426":52377,"_3090":52449},[],"inspect the token's real claims;",{"_3640":460,"_31229":428,"_21648":52451,"_5":14899,"_28426":52377,"_3090":52452},[],"confirm they match an active principal;",{"_3640":461,"_31229":428,"_21648":52454,"_5":14899,"_28426":52377,"_3090":52455},[],"review the policies granted to that principal;",{"_3640":462,"_31229":428,"_21648":52457,"_5":14899,"_28426":52377,"_3090":52458},[],"verify that authz reaches PostgreSQL and its JWKS.",{"_3640":463,"_31229":428,"_21648":52460,"_5":14899,"_28426":52377,"_3090":52461},[],"On a fresh installation, confirm the migration Job finished. That Job creates schemas, migrates authz, preloads policies and provisions the principals defined in services.authz.bootstrap.",{"_3640":464,"_31229":428,"_21648":52463,"_5":14899,"_28426":52381,"_3090":52464},[],"External authorization fails closed by default. If authz is unavailable, protected routes are blocked.",{"_3640":465,"_31229":428,"_21648":52466,"_5":14899,"_28426":52381,"_3090":52467},[],"Locate the authz pod and Service.",{"_3640":466,"_31229":428,"_21648":52469,"_5":14899,"_28426":52381,"_3090":52470},[],"Check /health, logs and its database connection.",{"_3640":467,"_31229":428,"_21648":52472,"_5":14899,"_28426":52381,"_3090":52473},[],"Verify the DNS and port configured in externalAuthorization.",{"_3640":468,"_31229":428,"_21648":52475,"_5":14899,"_28426":52381,"_3090":52476},[],"Check the check route is /v1/ext\\_authz/check.",{"_3640":469,"_31229":428,"_21648":52478,"_5":14899,"_28426":52381,"_3090":52479},[],"Do not switch to failOpen: true as a permanent workaround: it would allow traffic without authorization during the outage.",{"_3640":470,"_31229":428,"_21648":52481,"_5":14899,"_28426":52385,"_3090":52482},[],"A 500 indicates an internal failure, such as an unavailable database. The `{\"err\": ...}` body currently includes the text of the internal error, which can contain schema, table and constraint names and, on connection failures, the database host and user (not the password). Find the cause in the service log using the request time, and do not forward the body to third parties or show it to end users. This is a known information-disclosure defect: generic messages are planned for 500 responses, keeping the detail only in the service log (tracked in lamassuiot#814). The authorization connector also returns the internal error, in the `details.error` field. Some request errors, such as a key size the engine does not support, are also returned as 500.",{"_3640":471,"_31229":428,"_21648":52484,"_5":14899,"_28426":52389,"_3090":52485},[],"Review kubectl describe pod first. Common causes are:",{"_3640":472,"_31229":428,"_21648":52487,"_5":14899,"_28426":52389,"_3090":52488},[],"wrong credentials or DNS for PostgreSQL or RabbitMQ;",{"_3640":473,"_31229":428,"_21648":52490,"_5":14899,"_28426":52389,"_3090":52491},[],"a missing AMQP CA or client certificate Secret referenced by `amqp.ca.secretName` or `amqp.client.secretName`;",{"_3640":474,"_31229":428,"_21648":52493,"_5":14899,"_28426":52389,"_3090":52494},[],"unbound persistent volume;",{"_3640":475,"_31229":428,"_21648":52496,"_5":14899,"_28426":52389,"_3090":52497},[],"inaccessible image or incorrect pull policy;",{"_3640":476,"_31229":428,"_21648":52499,"_5":14899,"_28426":52389,"_3090":52500},[],"invalid cryptographic engine configuration;",{"_3640":477,"_31229":428,"_21648":52502,"_5":14899,"_28426":52389,"_3090":52503},[],"CPU or memory limits set too low;",{"_3640":478,"_31229":428,"_21648":52505,"_5":14899,"_28426":52389,"_3090":52506},[],"an incomplete prior migration.",{"_3640":479,"_31229":428,"_21648":52508,"_5":14899,"_28426":52389,"_3090":52509},[],"Generic values request 100 mCPU and 128 MiB and limit to 500 mCPU and 512 MiB. Tune per service when you see OOMKills, throttling or slow startups.",{"_3640":480,"_31229":428,"_21648":52511,"_5":14899,"_28426":52389,"_3090":52512},[],"Filesystem-based KMS engines and VA local storage use exclusive-access volumes. Keep a single replica or migrate to shared backends before enabling autoscaling.",{"_3640":481,"_31229":428,"_21648":52514,"_5":14899,"_28426":52389,"_3090":52515},[],"Internal calls now fail fast instead of hanging for the clients covered by Egress proxy: connection attempts time out after 30 seconds and TLS handshakes after 10 seconds. The authorization-engine connector keeps its own transport without these dial and handshake timeouts; only its overall 30-second request timeout bounds each call. If an egress proxy handles the cluster's outbound traffic, check the pod's `HTTP_PROXY`, `HTTPS_PROXY` and `NO_PROXY` environment variables and list in-cluster service names in `NO_PROXY`.",{"_3640":482,"_31229":428,"_21648":52517,"_5":14899,"_28426":52393,"_3090":52518},[],"Domain and audit events depend on the bus publisher:",{"_3640":483,"_31229":428,"_21648":52520,"_5":14899,"_28426":52393,"_3090":52521},[],"verify it is enabled in the emitting service;",{"_3640":484,"_31229":428,"_21648":52523,"_5":14899,"_28426":52393,"_3090":52524},[],"check AMQP connectivity and credentials;",{"_3640":485,"_31229":428,"_21648":52526,"_5":14899,"_28426":52393,"_3090":52527},[],"review exchange, routing key, queues and consumers;",{"_3640":486,"_31229":428,"_21648":52529,"_5":14899,"_28426":52393,"_3090":52530},[],"inspect dead-letter queues;",{"_3640":487,"_31229":428,"_21648":52532,"_5":14899,"_28426":52393,"_3090":52533},[],"alert on orphan durable queues and backlog growth.",{"_3640":488,"_31229":428,"_21648":52535,"_5":14899,"_28426":52393,"_3090":52536},[],"If `amqp.tls` is enabled, verify the TLS side as well:",{"_3640":489,"_31229":428,"_21648":52538,"_5":14899,"_28426":52393,"_3090":52539},[],"confirm the broker listener speaks AMQPS on the configured port — the default port stays `5672` and does not follow TLS automatically;",{"_3640":490,"_31229":428,"_21648":52541,"_5":14899,"_28426":52393,"_3090":52542},[],"if you set `amqp.ca.secretName`, confirm the Secret exists in the release namespace and its data key matches `amqp.ca.certificateKey` (default `ca.crt`); if `amqp.ca.secretName` is not set, the clients trust the system CAs;",{"_3640":491,"_31229":428,"_21648":52544,"_5":14899,"_28426":52393,"_3090":52545},[],"remember that a missing referenced Secret prevents the consuming pods from starting;",{"_3640":492,"_31229":428,"_21648":52547,"_5":14899,"_28426":52393,"_3090":52548},[],"after updating the CA or client certificate Secret, restart the consuming pods: the AMQP client loads certificates at startup.",{"_3640":493,"_31229":428,"_21648":52550,"_5":14899,"_28426":52393,"_3090":52551},[],"See AMQP TLS (AMQPS) for the full configuration.",{"_3640":494,"_31229":428,"_21648":52553,"_5":14899,"_28426":52393,"_3090":52554},[],"A consumer outage does not always prevent the main operation from completing. That is why you must monitor RabbitMQ and independently verify the persistence of audit logs.",{"_3640":495,"_31229":428,"_21648":52556,"_5":14899,"_28426":52397,"_3090":52557},[],"The chart can enable OpenTelemetry instrumentation for the services that support it, including authz; it does not configure OpenTelemetry for AWS Connector, wfx or the UI. Traces are exported over OTLP HTTP and logs can be directed to a compatible endpoint, such as VictoriaLogs. Use a correlation identifier and the same time window to join Gateway, service and dependency.",{"_3640":496,"_31229":428,"_21648":52559,"_5":14899,"_28426":52397,"_3090":52560},[],"Before closing an incident, record:",{"_3640":497,"_31229":428,"_21648":52562,"_5":14899,"_28426":52397,"_3090":52563},[],"the confirmed cause;",{"_3640":498,"_31229":428,"_21648":52565,"_5":14899,"_28426":52397,"_3090":52566},[],"the time scope and affected resources;",{"_3640":499,"_31229":428,"_21648":52568,"_5":14899,"_28426":52397,"_3090":52569},[],"the commands or queries used;",{"_3640":500,"_31229":428,"_21648":52571,"_5":14899,"_28426":52397,"_3090":52572},[],"the applied change and how to revert it;",{"_3640":501,"_31229":428,"_21648":52574,"_5":14899,"_28426":52397,"_3090":52575},[],"validation from a consumer;",{"_3640":502,"_31229":428,"_21648":52577,"_5":14899,"_28426":52397,"_3090":52578},[],"the preventive action and its owner.",{"_3640":503,"_31229":503,"_5":15259,"_3090":52580,"_31567":52581,"_21648":52585,"_28426":503},"Data model",[51054,52582,52583,52584],"Platform","Administration","Access control",[],{"_3640":504,"_31229":503,"_21648":52587,"_5":14899,"_28426":503,"_3090":52588},[],"Entities and relationships from the pki.json schema that authz uses to evaluate access policies.",{"_3640":505,"_31229":503,"_5":31564,"_21648":52590,"_28426":52591,"_3090":52592},[],"/docs/platform/administration/access-control/data-model#schema-relationships","Schema relationships",{"_3640":506,"_31229":503,"_5":31564,"_21648":52594,"_28426":52595,"_3090":52596},[],"/docs/platform/administration/access-control/data-model#schema-entities","Schema entities",{"_3640":507,"_31229":503,"_21648":52598,"_5":14899,"_28426":503,"_3090":52599},[],"The `connectors/authz/pki.json` schema defines the entities in the `pki` authorization namespace. A policy identifies a resource type through `namespace: pki`, `schema_name` and `entity_type`. For example, `ca.certificate` identifies the `certificate` entity type in the `ca` schema.",{"_3640":508,"_31229":503,"_21648":52601,"_5":14899,"_28426":52591,"_3090":52602},[],"Each arrow starts at the entity that declares the relationship and points to its `target_entity`. The value of `foreign_key`, the source column, appears below the label. In `pki.json`, each relationship's `name` matches that column. Select the diagram to enlarge it and scroll through it.",{"_3640":509,"_31229":503,"_21648":52604,"_5":14899,"_28426":52591,"_3090":52605},[],"A policy can propagate actions from the referenced entity to the one that declares the relationship. For example, to grant read access to a DMS's devices, a rule starts from `dmsmanager.dms`, targets `devicemanager.device` and specifies `via: dms_owner`.",{"_3640":510,"_31229":503,"_21648":52607,"_5":14899,"_28426":52591,"_3090":52608},[],"When filtering inherited access, `authz` matches the `foreign_key` column against the first `primary_key` column of the referenced entity. For example, it matches `subject_common_name` to `device.id`, `issuer_meta_serial_number` to `ca_certificate.id` and the links to `kms_key` to `kms_key.key_id`.",{"_3640":511,"_31229":503,"_21648":52610,"_5":14899,"_28426":52595,"_3090":52611},[],"Entity (`schema_name.entity_type`)",{"_3640":512,"_31229":503,"_21648":52613,"_5":14899,"_28426":52595,"_3090":52614},[],"Table (`table_name`)",{"_3640":513,"_31229":503,"_21648":52616,"_5":14899,"_28426":52595,"_3090":52617},[],"Key (`primary_key`)",{"_3640":514,"_31229":503,"_21648":52619,"_5":14899,"_28426":52595,"_3090":52620},[],"`alerts.event`",{"_3640":515,"_31229":503,"_21648":52622,"_5":14899,"_28426":52595,"_3090":52623},[],"`events`",{"_3640":516,"_31229":503,"_21648":52625,"_5":14899,"_28426":52595,"_3090":52626},[],"`event_type`",{"_3640":517,"_31229":503,"_21648":52628,"_5":14899,"_28426":52595,"_3090":52629},[],"`alerts.subscription`",{"_3640":518,"_31229":503,"_21648":52631,"_5":14899,"_28426":52595,"_3090":52632},[],"`subscriptions`",{"_3640":519,"_31229":503,"_21648":52634,"_5":14899,"_28426":52595,"_3090":52635},[],"`id`",{"_3640":520,"_31229":503,"_21648":52637,"_5":14899,"_28426":52595,"_3090":52638},[],"`ca.ca_certificate`",{"_3640":521,"_31229":503,"_21648":52640,"_5":14899,"_28426":52595,"_3090":52641},[],"`ca_certificates`",{"_3640":522,"_31229":503,"_21648":52643,"_5":14899,"_28426":52595,"_3090":52635},[],{"_3640":523,"_31229":503,"_21648":52645,"_5":14899,"_28426":52595,"_3090":52646},[],"`ca.certificate`",{"_3640":524,"_31229":503,"_21648":52648,"_5":14899,"_28426":52595,"_3090":52649},[],"`certificates`",{"_3640":525,"_31229":503,"_21648":52651,"_5":14899,"_28426":52595,"_3090":52652},[],"`serial_number`",{"_3640":526,"_31229":503,"_21648":52654,"_5":14899,"_28426":52595,"_3090":52655},[],"`ca.issuance_profile`",{"_3640":527,"_31229":503,"_21648":52657,"_5":14899,"_28426":52595,"_3090":52658},[],"`issuance_profiles`",{"_3640":528,"_31229":503,"_21648":52660,"_5":14899,"_28426":52595,"_3090":52635},[],{"_3640":529,"_31229":503,"_21648":52662,"_5":14899,"_28426":52595,"_3090":52663},[],"`devicemanager.device_group`",{"_3640":530,"_31229":503,"_21648":52665,"_5":14899,"_28426":52595,"_3090":52666},[],"`device_groups`",{"_3640":531,"_31229":503,"_21648":52668,"_5":14899,"_28426":52595,"_3090":52635},[],{"_3640":532,"_31229":503,"_21648":52670,"_5":14899,"_28426":52595,"_3090":52671},[],"`devicemanager.device`",{"_3640":533,"_31229":503,"_21648":52673,"_5":14899,"_28426":52595,"_3090":52674},[],"`devices`",{"_3640":534,"_31229":503,"_21648":52676,"_5":14899,"_28426":52595,"_3090":52635},[],{"_3640":535,"_31229":503,"_21648":52678,"_5":14899,"_28426":52595,"_3090":52679},[],"`dmsmanager.dms`",{"_3640":536,"_31229":503,"_21648":52681,"_5":14899,"_28426":52595,"_3090":52682},[],"`dms`",{"_3640":537,"_31229":503,"_21648":52684,"_5":14899,"_28426":52595,"_3090":52635},[],{"_3640":538,"_31229":503,"_21648":52686,"_5":14899,"_28426":52595,"_3090":52687},[],"`kms.kms_key`",{"_3640":539,"_31229":503,"_21648":52689,"_5":14899,"_28426":52595,"_3090":52690},[],"`kms_keys`",{"_3640":540,"_31229":503,"_21648":52692,"_5":14899,"_28426":52595,"_3090":52693},[],"`key_id`, `engine_id`",{"_3640":541,"_31229":503,"_21648":52695,"_5":14899,"_28426":52595,"_3090":52696},[],"`va.crl_settings`",{"_3640":542,"_31229":503,"_21648":52698,"_5":14899,"_28426":52595,"_3090":52699},[],"`crl_settings`",{"_3640":543,"_31229":503,"_21648":52701,"_5":14899,"_28426":52595,"_3090":52702},[],"`ca_id`",{"_3640":544,"_31229":503,"_21648":52704,"_5":14899,"_28426":52595,"_3090":52705},[],"Events, subscriptions and device groups have their own actions and filters. Their `relations` lists are empty and they have zero incoming references in the schema. For `ca.certificate`, `view_tables` also lists `certificates_view`.",{"_3640":545,"_31229":503,"_21648":52707,"_5":14899,"_28426":52595,"_3090":52708},[],"Each entity declares instance-level operations in `atomic_actions`, operations that require no resource ID in `global_actions`, and the columns and types accepted by `column_filters` in `filterable`.",{"_3640":546,"_31229":503,"_21648":52710,"_5":14899,"_28426":52595,"_3090":52711},[],"<Card title=\"Access inherited through relations\" href=\"/docs/platform/administration/access-control#access-inherited-through-relations\" />",{"_3640":547,"_31229":547,"_5":15259,"_3090":52713,"_31567":52714,"_21648":52715,"_28426":547},"Access control overview",[51054,52582,52583,52584],[],{"_3640":548,"_31229":547,"_21648":52717,"_5":14899,"_28426":547,"_3090":52718},[],"Design who can access Lamassu through principals, policies, resource permissions and HTTP route authorization.",{"_3640":549,"_31229":547,"_5":31564,"_21648":52720,"_28426":52721,"_3090":52722},[],"/docs/platform/administration/access-control#essential-concepts","Essential concepts",{"_3640":550,"_31229":547,"_5":31564,"_21648":52724,"_28426":52725,"_3090":52726},[],"/docs/platform/administration/access-control#two-decision-systems","Two decision systems",{"_3640":551,"_31229":547,"_5":31564,"_21648":52728,"_28426":52729,"_3090":52730},[],"/docs/platform/administration/access-control#integrated-or-external-http-services","Integrated or external HTTP services",{"_3640":552,"_31229":547,"_5":31564,"_21648":52732,"_28426":52733,"_3090":52734},[],"/docs/platform/administration/access-control#authentication-only-routes-and-unmapped-paths","Authentication-only routes and unmapped paths",{"_3640":553,"_31229":547,"_5":31564,"_21648":52736,"_28426":52737,"_3090":52738},[],"/docs/platform/administration/access-control#services-developed-by-lamassu","Services developed by Lamassu",{"_3640":554,"_31229":547,"_5":31564,"_21648":52740,"_28426":52741,"_3090":52742},[],"/docs/platform/administration/access-control#how-the-two-paths-relate","How the two paths relate",{"_3640":555,"_31229":547,"_5":31564,"_21648":52744,"_28426":52745,"_3090":52746},[],"/docs/platform/administration/access-control#oidc-principals","OIDC principals",{"_3640":556,"_31229":547,"_5":31564,"_21648":52748,"_28426":52749,"_3090":52750},[],"/docs/platform/administration/access-control#x509-principals","X.509 principals",{"_3640":557,"_31229":547,"_5":31564,"_21648":52752,"_28426":52753,"_3090":52754},[],"/docs/platform/administration/access-control#when-several-principals-match","When several principals match",{"_3640":558,"_31229":547,"_5":31564,"_21648":52756,"_28426":52757,"_3090":52758},[],"/docs/platform/administration/access-control#how-policies-express-access","How policies express access",{"_3640":559,"_31229":547,"_5":31564,"_21648":52760,"_28426":52761,"_3090":52762},[],"/docs/platform/administration/access-control#global-and-direct-access","Global and direct access",{"_3640":560,"_31229":547,"_5":31564,"_21648":52764,"_28426":52765,"_3090":52766},[],"/docs/platform/administration/access-control#access-inherited-through-relations","Access inherited through relations",{"_3640":561,"_31229":547,"_5":31564,"_21648":52768,"_28426":52769,"_3090":52770},[],"/docs/platform/administration/access-control#attribute-filtered-access","Attribute-filtered access",{"_3640":562,"_31229":547,"_5":31564,"_21648":52772,"_28426":52773,"_3090":52774},[],"/docs/platform/administration/access-control#http-rules","HTTP rules",{"_3640":563,"_31229":547,"_5":31564,"_21648":52776,"_28426":52777,"_3090":52778},[],"/docs/platform/administration/access-control#included-policies","Included policies",{"_3640":564,"_31229":547,"_5":31564,"_21648":52780,"_28426":52781,"_3090":51704},[],"/docs/platform/administration/access-control#provision-the-first-administrator",{"_3640":565,"_31229":547,"_5":31564,"_21648":52783,"_28426":52784,"_3090":52785},[],"/docs/platform/administration/access-control#prepare-the-identity-provider","Prepare the identity provider",{"_3640":566,"_31229":547,"_5":31564,"_21648":52787,"_28426":52788,"_3090":52789},[],"/docs/platform/administration/access-control#configure-token-validation","Configure token validation",{"_3640":567,"_31229":547,"_5":31564,"_21648":52791,"_28426":52792,"_3090":52793},[],"/docs/platform/administration/access-control#install-and-verify-administrative-access","Install and verify administrative access",{"_3640":568,"_31229":547,"_5":31564,"_21648":52795,"_28426":52796,"_3090":52797},[],"/docs/platform/administration/access-control#test-an-unprivileged-identity","Test an unprivileged identity",{"_3640":569,"_31229":547,"_5":31564,"_21648":52799,"_28426":52800,"_3090":52801},[],"/docs/platform/administration/access-control#reduce-use-of-the-bootstrap-administrator","Reduce use of the bootstrap administrator",{"_3640":570,"_31229":547,"_5":31564,"_21648":52803,"_28426":52804,"_3090":52805},[],"/docs/platform/administration/access-control#fastlane-bootstrap","Fastlane bootstrap",{"_3640":571,"_31229":547,"_5":31564,"_21648":52807,"_28426":52808,"_3090":52809},[],"/docs/platform/administration/access-control#design-least-privilege-roles","Design least-privilege roles",{"_3640":572,"_31229":547,"_5":31564,"_21648":52811,"_28426":52812,"_3090":52813},[],"/docs/platform/administration/access-control#changes-and-access-revocation","Changes and access revocation",{"_3640":573,"_31229":547,"_5":31564,"_21648":52815,"_28426":52816,"_3090":52817},[],"/docs/platform/administration/access-control#operational-checklist","Operational checklist",{"_3640":574,"_31229":547,"_5":31564,"_21648":52819,"_28426":52820,"_3090":52821},[],"/docs/platform/administration/access-control#diagnostics","Diagnostics",{"_3640":575,"_31229":547,"_5":31564,"_21648":52823,"_28426":52824,"_3090":52825},[],"/docs/platform/administration/access-control#the-response-is-401","The response is 401",{"_3640":576,"_31229":547,"_5":31564,"_21648":52827,"_28426":52828,"_3090":52829},[],"/docs/platform/administration/access-control#the-response-is-403","The response is 403",{"_3640":577,"_31229":547,"_5":31564,"_21648":52831,"_28426":52832,"_3090":52833},[],"/docs/platform/administration/access-control#everything-returns-403","Everything returns 403",{"_3640":578,"_31229":547,"_5":31564,"_21648":52835,"_28426":52836,"_3090":52837},[],"/docs/platform/administration/access-control#access-appears-without-a-policy-grant","Access appears without a policy grant",{"_3640":579,"_31229":547,"_5":31564,"_21648":52839,"_28426":52840,"_3090":52841},[],"/docs/platform/administration/access-control#everything-fails-when-authz-is-unavailable","Everything fails when authz is unavailable",{"_3640":580,"_31229":547,"_21648":52843,"_5":14899,"_28426":547,"_3090":52844},[],"Lamassu access control turns an authenticated identity into concrete permissions. The OIDC provider or the client certificate proves **who** makes a request; the `authz` service decides **what that identity can do** and **over which resources**.",{"_3640":581,"_31229":547,"_21648":52846,"_5":14899,"_28426":547,"_3090":52847},[],"Lamassu does not assign permissions directly to users. The full chain is:",{"_3640":582,"_31229":547,"_21648":52849,"_5":14899,"_28426":547,"_3090":52850},[],"This model lets you represent people, identity-provider groups, service accounts and devices without coupling authorization to a specific provider.",{"_3640":583,"_31229":547,"_21648":52852,"_5":14899,"_28426":52721,"_3090":52853},[],"A **principal** connects a credential to Lamassu. It defines how to recognize an OIDC or X.509 identity and can be active or disabled.",{"_3640":584,"_31229":547,"_21648":52855,"_5":14899,"_28426":52721,"_3090":52856},[],"A **policy** groups reusable permissions. It can be granted to several principals and can contain rules about Lamassu entities, rules about HTTP routes or both.",{"_3640":585,"_31229":547,"_21648":52858,"_5":14899,"_28426":52721,"_3090":52859},[],"An **entity rule** grants actions over resources such as certification authorities, certificates, issuance profiles, devices, DMSs, keys or alert subscriptions. It can cover all resources of a type or be limited by identifier, relation or attribute.",{"_3640":586,"_31229":547,"_21648":52861,"_5":14899,"_28426":52721,"_3090":52862},[],"An **HTTP rule** grants actions associated with API routes. It is the mechanism the Gateway uses to decide whether a request may cross the perimeter.",{"_3640":587,"_31229":547,"_21648":52864,"_5":14899,"_28426":52721,"_3090":52865},[],"A **grant** is the association between a principal and a policy. Removing the grant removes all permissions contributed by that policy, without modifying it for other principals.",{"_3640":588,"_31229":547,"_21648":52867,"_5":14899,"_28426":52721,"_3090":52868},[],"A valid JWT or a valid client certificate does not grant access by itself. The credential must match at least one active principal and, unless the HTTP schema exempts the route, one of its policies must allow the requested operation. See *Authentication-only routes and unmapped paths* for those exemptions.",{"_3640":589,"_31229":547,"_21648":52870,"_5":14899,"_28426":52725,"_3090":52871},[],"Lamassu uses two authorization paths depending on who implements the protected service. They share principals, policies and grants, but they do not interpret the rules the same way.",{"_3640":590,"_31229":547,"_21648":52873,"_5":14899,"_28426":52725,"_3090":52874},[],"An external service can be protected without knowing Lamassu's internal authorization model. A service developed by Lamassu embeds the authorization engine and can decide on concrete resources and filter its queries.",{"_3640":591,"_31229":547,"_21648":52876,"_5":14899,"_28426":52729,"_3090":52877},[],"This path protects APIs that join the platform through the Gateway but do not natively implement Lamassu's authorization SDK. Job Manager is the current example. The same pattern allows integrating other HTTP services as long as their routes are described in an `authz` HTTP schema.",{"_3640":592,"_31229":547,"_21648":52879,"_5":14899,"_28426":52729,"_3090":52880},[],"The decision is made **before forwarding the request to the service**:",{"_3640":593,"_31229":547,"_21648":52882,"_5":14899,"_28426":52729,"_3090":52883},[],"Envoy Gateway authenticates the request, usually validating a JWT against the OIDC provider's JWKS.",{"_3640":594,"_31229":547,"_21648":52885,"_5":14899,"_28426":52729,"_3090":52886},[],"For a protected route, Envoy sends the method, URL, headers and required data to `/v1/ext_authz/check`.",{"_3640":595,"_31229":547,"_21648":52888,"_5":14899,"_28426":52729,"_3090":52889},[],"`authz` extracts the credential and resolves all active principals matching it.",{"_3640":596,"_31229":547,"_21648":52891,"_5":14899,"_28426":52729,"_3090":52892},[],"It separately loads the policies granted to each principal.",{"_3640":597,"_31229":547,"_21648":52894,"_5":14899,"_28426":52729,"_3090":52895},[],"The HTTP schema translates the method and route combination into a logical action, such as `nbi-job-read` or `nbi-workflow-create`.",{"_3640":598,"_31229":547,"_21648":52897,"_5":14899,"_28426":52729,"_3090":52898},[],"`authz` looks for an HTTP rule granting that action.",{"_3640":599,"_31229":547,"_21648":52900,"_5":14899,"_28426":52729,"_3090":52901},[],"If the route declares constraints, it compares request data with the normalized attributes of the same principal contributing the policy; the policy's own `param_constraints` also pin the granted action to literal request values.",{"_3640":600,"_31229":547,"_21648":52903,"_5":14899,"_28426":52729,"_3090":52904},[],"A satisfying result lets Envoy forward the request; any other response blocks it at the Gateway.",{"_3640":601,"_31229":547,"_21648":52906,"_5":14899,"_28426":52729,"_3090":52907},[],"When it allows access, `authz` returns the selected principal in the `X-Principal-ID` response header. The Gateway can propagate that header to the service to preserve the identity context. Clients cannot forge this header: the Gateway removes client-supplied `X-Principal-Id` (and the other forwarded identity and certificate headers) before forwarding, so only `authz` can set it. See Expose the Gateway for the full list of stripped headers.",{"_3640":602,"_31229":547,"_21648":52909,"_5":14899,"_28426":52729,"_3090":52910},[],"HTTP rules primarily answer &#x2A;*\"can this identity call this API operation?\"**. On their own they do not produce filters over the external service's database. To limit a route to a specific device, tenant or client, either the schema declares a constraint relating a request value to a normalized attribute of the principal, or the policy pins the request value to a literal with `param_constraints`. The first scopes each identity to its own resources through a single grant; the second restricts a grant to a fixed value regardless of who holds it.",{"_3640":603,"_31229":547,"_21648":52912,"_5":14899,"_28426":52733,"_3090":52913},[],"Two schema-level settings cover endpoints that policies do not mention:",{"_3640":604,"_31229":547,"_21648":52915,"_5":14899,"_28426":52733,"_3090":52916},[],"**`skip_authz: true` on a route** allows any identity that matches an active principal to reach it, even one with no granted policies. Use it for paths such as `/openapi.json` or `/health` that every authenticated caller should be able to access. The request still has to authenticate successfully: a credential that fails validation or matches no active principal is rejected before this setting is considered. A `skip_authz` route cannot declare constraints, and it wins over any other schema's route or default action for the same request.",{"_3640":605,"_31229":547,"_21648":52918,"_5":14899,"_28426":52733,"_3090":52919},[],"**`default_action` with `base_paths`** decides what happens when a request falls under a path prefix the schema owns but no explicit route matches. `deny` — the value the Job Manager schema ships with — turns the implicit denial of unmapped paths into an explicit, auditable statement; `allow` opens unmapped endpoints under that prefix to any identity that matches an active principal.",{"_3640":606,"_31229":547,"_21648":52921,"_5":14899,"_28426":52733,"_3090":52922},[],"These are decisions of the schema, not of a policy: `skip_authz` removes the grant check for that route, even when another schema maps the same request to an action that requires a grant, and `default_action` only covers requests that no explicit route in any schema matches. Keep three rules in mind:",{"_3640":607,"_31229":547,"_21648":52924,"_5":14899,"_28426":52733,"_3090":52925},[],"`default_action` requires at least one `base_paths` entry, and base paths are absolute paths such as `/api/wfx/nbi/v1`.",{"_3640":608,"_31229":547,"_21648":52927,"_5":14899,"_28426":52733,"_3090":52928},[],"An explicit route in any schema takes precedence: the fallback only decides requests that no schema's routes cover. When the prefixes of two schemas overlap, the longest matching prefix decides.",{"_3640":609,"_31229":547,"_21648":52930,"_5":14899,"_28426":52733,"_3090":52931},[],"Two schemas cannot claim the same base path with different default actions; the conflicting schema fails to load.",{"_3640":610,"_31229":547,"_21648":52933,"_5":14899,"_28426":52733,"_3090":52934},[],"A `skip_authz` route and a `default_action: \"allow\"` prefix grant access without consulting any policy. Every identity that matches an active principal can reach what they open, including identities with no granted policies. A `skip_authz` route in one schema also opens a request that another schema maps to a grant-protected action. Review these settings whenever you add or upgrade an integrated service.",{"_3640":611,"_31229":547,"_21648":52936,"_5":14899,"_28426":52733,"_3090":52937},[],"A schema can also make an individual route accept the credential from the URL. **`query_token: true` on a route** makes it accept the OIDC access token from the `access_token` query parameter, but only when the request carries neither an `Authorization: Bearer` header nor a client-certificate header: a credential in a header always wins. The token is validated and authorized exactly like a Bearer token, so the route's action still requires a policy grant, and routes that do not opt in never read the query parameter. The dashboard's experimental browser terminal uses this mechanism, because the WebSocket connection its browser client opens cannot set request headers.",{"_3640":612,"_31229":547,"_21648":52939,"_5":14899,"_28426":52733,"_3090":52940},[],"Query strings are often recorded. `authz` replaces the `access_token` value with `REDACTED` in its own decision logs, but other logs that capture the URL — the Gateway access log, service request logs, tracing — are not redacted. Keep `query_token` for WebSocket routes and short-lived tokens.",{"_3640":613,"_31229":547,"_21648":52942,"_5":14899,"_28426":52737,"_3090":52943},[],"Lamassu's native services embed authorization in their middleware and know the entities they operate on: certificates, CAs, issuance profiles, keys, devices, DMSs or subscriptions, among others.",{"_3640":614,"_31229":547,"_21648":52945,"_5":14899,"_28426":52737,"_3090":52946},[],"The decision is made with the domain operation context:",{"_3640":615,"_31229":547,"_21648":52948,"_5":14899,"_28426":52737,"_3090":52949},[],"The middleware extracts the credential and resolves the matching principals.",{"_3640":616,"_31229":547,"_21648":52951,"_5":14899,"_28426":52737,"_3090":52952},[],"The endpoint identifies the action, the entity type and, when applicable, the key of the requested resource.",{"_3640":617,"_31229":547,"_21648":52954,"_5":14899,"_28426":52737,"_3090":52955},[],"`authz` gathers the entity rules of the granted policies.",{"_3640":618,"_31229":547,"_21648":52957,"_5":14899,"_28426":52737,"_3090":52958},[],"The engine evaluates direct grants, attribute filters and relations with other entities.",{"_3640":619,"_31229":547,"_21648":52960,"_5":14899,"_28426":52737,"_3090":52961},[],"For an individual operation, it checks that the concrete resource satisfies the computed scope.",{"_3640":620,"_31229":547,"_21648":52963,"_5":14899,"_28426":52737,"_3090":52964},[],"For a listing, it generates a SQL filter that the service adds to its own query.",{"_3640":621,"_31229":547,"_21648":52966,"_5":14899,"_28426":52737,"_3090":52967},[],"Here the engine answers &#x2A;*\"can this identity perform this action on this concrete resource?\"**.",{"_3640":622,"_31229":547,"_21648":52969,"_5":14899,"_28426":52737,"_3090":52970},[],"Actions fall into two groups:",{"_3640":623,"_31229":547,"_21648":52972,"_5":14899,"_28426":52737,"_3090":52973},[],"**Global actions** do not need a resource identifier. `create`, `import` or access to a console section are common examples.",{"_3640":624,"_31229":547,"_21648":52975,"_5":14899,"_28426":52737,"_3090":52976},[],"**Atomic actions** are evaluated on a concrete instance. For certificates these include `read`, `metadata-update`, `status-update` and `delete`; for a CA there are also `sign`, `reissue` and other lifecycle operations.",{"_3640":625,"_31229":547,"_21648":52978,"_5":14899,"_28426":52737,"_3090":52979},[],"Filtering inside the service prevents leaks in listings: unauthorized resources are excluded from the SQL query instead of being fetched and hidden later in the interface.",{"_3640":626,"_31229":547,"_21648":52981,"_5":14899,"_28426":52741,"_3090":52982},[],"They are not two equivalent controls applied twice. HTTP rules protect the perimeter of an integrated service; entity rules express permissions over the data model of the native services.",{"_3640":627,"_31229":547,"_21648":52984,"_5":14899,"_28426":52741,"_3090":52985},[],"A policy can contain both rule types when an identity needs to operate Lamassu resources and also call an integrated API. Granting an entity rule does not automatically grant an HTTP action, nor does an HTTP rule create access over an entity.",{"_3640":628,"_31229":547,"_21648":52987,"_5":14899,"_28426":52741,"_3090":52988},[],"If no combination of principal, policy and rule allows the operation, Lamassu denies it, unless the HTTP schema declares `skip_authz` on the route or `default_action: allow` on a base path that covers it (see *Authentication-only routes and unmapped paths*). Additionally, `auth.externalAuthorization.failOpen` is `false` by default: if `authz` is unavailable, the Gateway blocks protected routes.",{"_3640":629,"_31229":547,"_21648":52990,"_5":14899,"_28426":52745,"_3090":52991},[],"An OIDC principal matches the claims of a validated JWT. It is appropriate for human users, corporate groups, IdP roles and service accounts that obtain tokens.",{"_3640":630,"_31229":547,"_21648":52993,"_5":14899,"_28426":52745,"_3090":52994},[],"The following principal represents any identity holding the `pki-operators` role in Keycloak:",{"_3640":631,"_31229":547,"_21648":52996,"_5":14899,"_28426":52745,"_3090":52997},[],"Claim paths can be nested, such as `realm_access.roles`. Within a single principal, **all** conditions must hold. This lets you require, for example, a group and an organizational audience at the same time.",{"_3640":632,"_31229":547,"_21648":52999,"_5":14899,"_28426":52745,"_3090":53000},[],"The implemented operators are:",{"_3640":633,"_31229":547,"_21648":53002,"_5":14899,"_28426":52745,"_3090":53003},[],"`equals`, for exact equality;",{"_3640":634,"_31229":547,"_21648":53005,"_5":14899,"_28426":52745,"_3090":53006},[],"`contains`, to check membership in a list or the presence of text in a scalar value.",{"_3640":635,"_31229":547,"_21648":53008,"_5":14899,"_28426":52745,"_3090":53009},[],"Design matching with stable attributes. For people, it is usually better to bind permissions to centrally managed groups or roles than to the email or username. For a service account, a stable `sub` keeps its permissions from mixing with a human operator's.",{"_3640":636,"_31229":547,"_21648":53011,"_5":14899,"_28426":52745,"_3090":53012},[],"Although the model recognizes the operator name `matches`, the current implementation does not evaluate regular expressions and the condition never matches. Use `equals` or `contains`.",{"_3640":637,"_31229":547,"_21648":53014,"_5":14899,"_28426":52749,"_3090":53015},[],"An X.509 principal lets you recognize a workload or a device by its client certificate. Lamassu checks the certificate signature against the configured CA and, depending on the mode, also its serial number or Common Name.",{"_3640":638,"_31229":547,"_21648":53017,"_5":14899,"_28426":52749,"_3090":53018},[],"The available modes are:",{"_3640":639,"_31229":547,"_21648":53020,"_5":14899,"_28426":52749,"_3090":53021},[],"`serial_and_ca`: an exact certificate, identified by serial number and CA;",{"_3640":640,"_31229":547,"_21648":53023,"_5":14899,"_28426":52749,"_3090":53024},[],"`cn_and_ca`: an exact or wildcard Common Name and a specific CA;",{"_3640":641,"_31229":547,"_21648":53026,"_5":14899,"_28426":52749,"_3090":53027},[],"`any_from_ca`: any certificate issued directly by the given CA.",{"_3640":642,"_31229":547,"_21648":53029,"_5":14899,"_28426":52749,"_3090":53030},[],"This example recognizes certificates whose CN starts with `factory-a-` and that are signed by the configured CA:",{"_3640":643,"_31229":547,"_21648":53032,"_5":14899,"_28426":52749,"_3090":53033},[],"`ca_trust.identity_type` accepts `fingerprint` or `authority_key_id`. In both cases you must provide the CA certificate in `ca_trust.pem`; Lamassu verifies both the signature and the expected identity of the CA.",{"_3640":644,"_31229":547,"_21648":53035,"_5":14899,"_28426":52749,"_3090":53036},[],"Use `any_from_ca` only when every identity issued by that CA should share the same permissions. If a CA issues certificates for different populations, separate access by serial or CN, or use different issuing CAs.",{"_3640":645,"_31229":547,"_21648":53038,"_5":14899,"_28426":52753,"_3090":53039},[],"A single credential can match more than one principal. It is common for a user to match a principal of their team and another of their operational function.",{"_3640":646,"_31229":547,"_21648":53041,"_5":14899,"_28426":52753,"_3090":53042},[],"For entity permissions, Lamassu combines permissions with OR logic: it is enough that one policy of one of the principals allows the action. Listings contain the union of the resources visible to all of them.",{"_3640":647,"_31229":547,"_21648":53044,"_5":14899,"_28426":52753,"_3090":53045},[],"HTTP routes with constraints are stricter. The same principal contributing the policy must also satisfy the attributes required by the route. Lamassu does not combine one principal's policy with an attribute belonging to another.",{"_3640":648,"_31229":547,"_21648":53047,"_5":14899,"_28426":52753,"_3090":53048},[],"For this reason, adding a matching principal can only broaden access. Before creating overlapping rules, review the full set of policies a real identity will receive.",{"_3640":649,"_31229":547,"_21648":53050,"_5":14899,"_28426":52761,"_3090":53051},[],"A rule identifies the domain (`namespace`), the data schema (`schema_name`) and the entity type (`entity_type`). `actions` lists the allowed operations.",{"_3640":650,"_31229":547,"_21648":53053,"_5":14899,"_28426":52761,"_3090":53054},[],"`direct_grants` limits the rule to concrete identifiers. The value `*` covers all instances of the type. A superadministrator policy uses wildcards in schema, entity, actions and grants; a least-privilege policy should avoid them whenever possible.",{"_3640":651,"_31229":547,"_21648":53056,"_5":14899,"_28426":52765,"_3090":53057},[],"Rules can follow relations declared between entities. For example, the schema knows the relation of a certificate to its issuing CA, of a device to its DMS and of a certificate to the KMS key that stores its private key, so a grant on the key also covers the certificates that use it. A policy can grant access to a parent resource and propagate selected actions to its related resources.",{"_3640":652,"_31229":547,"_21648":53059,"_5":14899,"_28426":52765,"_3090":53060},[],"This lets you express models like \"can operate the devices of this DMS\" without maintaining an individual list of every device. When a resource is added under that relation, it inherits the scope planned by the policy.",{"_3640":653,"_31229":547,"_21648":53062,"_5":14899,"_28426":52765,"_3090":53063},[],"The data model shows how the resources used in entity rules are connected.",{"_3640":654,"_31229":547,"_21648":53065,"_5":14899,"_28426":52765,"_3090":53066},[],"A rule can only follow relations that the data schema declares between its two entities. You can reference the relation by its name or by its foreign-key column — both spellings are equivalent, and it is the schema that decides which column the query uses. When you save a policy, `authz` checks every relation against the loaded schemas: one that no schema declares, or one pointing at an entity that is not loaded, is rejected at that moment.",{"_3640":655,"_31229":547,"_21648":53068,"_5":14899,"_28426":52765,"_3090":53069},[],"Policies stored before this validation may still carry relations the schemas do not declare. Such a relation grants nothing: `authz` logs a warning, `skipping relation that grants nothing`, naming the policy and the relation, and continues evaluating the rest of the policy. The reference is always resolved against the schema before any query is built, so an undeclared relation can never alter it. If inherited access narrows after an upgrade, check the `authz` logs for this warning and correct the relation of the affected policy.",{"_3640":656,"_31229":547,"_21648":53071,"_5":14899,"_28426":52769,"_3090":53072},[],"`column_filters` applies conditions to columns the schema has declared filterable. All filters of the same rule are combined with AND.",{"_3640":657,"_31229":547,"_21648":53074,"_5":14899,"_28426":52769,"_3090":53075},[],"For example, this rule allows reading active certificates issued by a specific CA:",{"_3640":658,"_31229":547,"_21648":53077,"_5":14899,"_28426":52769,"_3090":53078},[],"The available operators are `eq`, `neq`, `gt`, `gte`, `lt`, `lte`, `in` and `like`. Use comparisons consistent with the column type: `like` for text, ordering comparisons for numbers or dates and `in` when there is a collection of accepted values.",{"_3640":659,"_31229":547,"_21648":53080,"_5":14899,"_28426":52773,"_3090":53081},[],"HTTP rules do not point directly at tables. They reference a route schema and grant its logical actions. Job Manager's policies are an example: they distinguish reading, creating, updating and deleting workflows or jobs.",{"_3640":660,"_31229":547,"_21648":53083,"_5":14899,"_28426":52773,"_3090":53084},[],"Some routes also compare a request value — taken from the path, query, header or JSON body — with a normalized attribute of the principal. This way you can verify that a device only queries jobs addressed to its own `client_id`.",{"_3640":661,"_31229":547,"_21648":53086,"_5":14899,"_28426":52773,"_3090":53087},[],"Normalized attributes decouple the policy from the authentication mechanism. `subject_attribute_mappings` can derive, for example, `device_id` from `oidc.claim.device_id` or from `x509.subject.cn`. The rule consumes `device_id` in both cases.",{"_3640":662,"_31229":547,"_21648":53089,"_5":14899,"_28426":52773,"_3090":53090},[],"An HTTP rule can also pin a granted action to a literal value carried by the request itself through `param_constraints`. It extracts the value with the same sources as route constraints — `path_regex_group`, `query`, `header` or `json_body` — but compares it against an `equals` literal written into the policy rather than against a subject attribute. The grant then depends only on the request, not on who holds the policy:",{"_3640":663,"_31229":547,"_21648":53092,"_5":14899,"_28426":52773,"_3090":53093},[],"Combined with a schema route such as `^/api/mysvc/system/([^/]+)/info$`, this grants `GET /api/mysvc/system/1/info` and denies the same call for system `2`, regardless of the principal's attributes. The same mechanism pins query parameters, headers or JSON body fields, for example `{ \"source\": \"query\", \"name\": \"tenant_id\" }` with `\"equals\": \"1\"` to accept only requests carrying `?tenant_id=1`.",{"_3640":664,"_31229":547,"_21648":53095,"_5":14899,"_28426":52773,"_3090":53096},[],"Note that:",{"_3640":665,"_31229":547,"_21648":53098,"_5":14899,"_28426":52773,"_3090":53099},[],"`action` must be one of the actions granted by the rule; `equals` is required; `path_regex_group` needs an `index` greater than zero, `query` and `header` need a `name`, and `json_body` needs a `path` such as `$.tenant_id`.",{"_3640":666,"_31229":547,"_21648":53101,"_5":14899,"_28426":52773,"_3090":53102},[],"`param_constraints` are not cross-checked against the schema when the policy is loaded. A reference the route cannot satisfy — for instance a `path_regex_group` on a route without capture groups — simply never matches, and the request is denied.",{"_3640":667,"_31229":547,"_21648":53104,"_5":14899,"_28426":52773,"_3090":53105},[],"Several `param_constraints` for the same action combine with AND. A rule without them keeps the usual behavior: the action is granted wherever the route matches and the subject constraints pass.",{"_3640":668,"_31229":547,"_21648":53107,"_5":14899,"_28426":52777,"_3090":53108},[],"The `authz` preload installs reusable policies for the main domains. Among them are:",{"_3640":669,"_31229":547,"_21648":53110,"_5":14899,"_28426":52777,"_3090":53111},[],"full and read-only access to certificates and authorities;",{"_3640":670,"_31229":547,"_21648":53113,"_5":14899,"_28426":52777,"_3090":53114},[],"full and read-only access to the KMS;",{"_3640":671,"_31229":547,"_21648":53116,"_5":14899,"_28426":52777,"_3090":53117},[],"full and read-only access to Device Manager, DMS Manager, Validation Authority and alerts;",{"_3640":672,"_31229":547,"_21648":53119,"_5":14899,"_28426":52777,"_3090":53120},[],"an `Auditor` policy with PKI read access and authorization visibility;",{"_3640":673,"_31229":547,"_21648":53122,"_5":14899,"_28426":52777,"_3090":53123},[],"console access;",{"_3640":674,"_31229":547,"_21648":53125,"_5":14899,"_28426":52777,"_3090":53126},[],"administration and observation policies for the Job Manager NBI and SBI APIs;",{"_3640":675,"_31229":547,"_21648":53128,"_5":14899,"_28426":52777,"_3090":53129},[],"access to the dashboard's experimental terminal (Terminal Network);",{"_3640":676,"_31229":547,"_21648":53131,"_5":14899,"_28426":52777,"_3090":53132},[],"`SUPER ADMIN`, which grants all actions over the `authz` and `pki` domains.",{"_3640":677,"_31229":547,"_21648":53134,"_5":14899,"_28426":52777,"_3090":53135},[],"Start with these policies before creating others. If none reflects the boundary you need, create a specific, small policy instead of copying `SUPER ADMIN` and informally removing permissions.",{"_3640":678,"_31229":547,"_21648":53137,"_5":14899,"_28426":52777,"_3090":53138},[],"The Terminal Network policy is created by the `authz` preload the next time `authz` starts after the upgrade. Preloaded policies are system policies — their ids begin with `lamassu.` — and cannot be edited through the API.",{"_3640":679,"_31229":547,"_21648":53140,"_5":14899,"_28426":52781,"_3090":53141},[],"An installation without a principal matching your identity is left with nobody able to administer authorization. Configure the IdP and the bootstrap before exposing the platform.",{"_3640":680,"_31229":547,"_21648":53143,"_5":14899,"_28426":52781,"_3090":53144},[],"The chart includes a bootstrap principal that looks for the OIDC role `pki-admin` in `realm_access.roles`. It grants it `SUPER ADMIN` and, when Job Manager is enabled, the administrative policy of its NBI API.",{"_3640":681,"_31229":547,"_21648":53146,"_5":14899,"_28426":52781,"_3090":53147},[],"The pre-install and pre-upgrade Helm Job runs the `authz` migrations, preloads the policies and creates the bootstrap principals before the services start. If the principal already exists, it does not replace it: it only adds the configured grants that are still missing. You can keep the entry in `values.yaml` across upgrades.",{"_3640":682,"_31229":547,"_21648":53149,"_5":14899,"_28426":52784,"_3090":53150},[],"Create the role or group you will use to administer Lamassu. Assign it to at least two controlled human identities. If your provider does not use `realm_access.roles`, adapt the claim path in both the frontend and `auth_config.claims`.",{"_3640":683,"_31229":547,"_21648":53152,"_5":14899,"_28426":52788,"_3090":53153},[],"`authz` validates every token against `services.authz.jwkUrl`, which is fetched from the `authz` pod. The Gateway does not validate tokens itself: Lamassu services authorize each request through `authz`, and routes labeled `auth=external`, such as the Job Manager ones, are checked by the Gateway through `authz` when `auth.externalAuthorization` is enabled. The endpoint must serve the keys of the issuer configured in `auth.oidc.frontend.authority`.",{"_3640":684,"_31229":547,"_21648":53155,"_5":14899,"_28426":52788,"_3090":53156},[],"Releases upgraded from 3.8.0 must remove `auth.oidc.apiGateway` and `auth.authorization`, which the 4.0.0 chart rejects. See 3.8.0 to 4.0.0.",{"_3640":685,"_31229":547,"_21648":53158,"_5":14899,"_28426":52792,"_3090":53159},[],"Sign in with an identity holding `pki-admin`. Confirm it can access authorization administration and perform a non-destructive read operation.",{"_3640":686,"_31229":547,"_21648":53161,"_5":14899,"_28426":52796,"_3090":53162},[],"Use a second user without the role and confirm the same operation is denied. This test catches misread claims, overly broad policies and accidental `failOpen` configurations.",{"_3640":687,"_31229":547,"_21648":53164,"_5":14899,"_28426":52800,"_3090":53165},[],"Create operational principals with narrower policies. Reserve `pki-admin` for authorization administration and recovery, not for daily work.",{"_3640":688,"_31229":547,"_21648":53167,"_5":14899,"_28426":52804,"_3090":53168},[],"Fastlane installs a Keycloak realm for the lab and creates the user `lamassu` with the temporary password `lamassu`, the role `pki-admin` and a mandatory password change. Its bootstrap principal matches through `preferred_username=lamassu`.",{"_3640":689,"_31229":547,"_21648":53170,"_5":14899,"_28426":52804,"_3090":53171},[],"Change the password on first login. Do not reuse the Fastlane user, password or IdP as a production design.",{"_3640":690,"_31229":547,"_21648":53173,"_5":14899,"_28426":52808,"_3090":53174},[],"Avoid reproducing your company's internal structure with dozens of nearly identical policies. Start from the responsibilities that actually need access:",{"_3640":691,"_31229":547,"_21648":53176,"_5":14899,"_28426":52808,"_3090":53177},[],"**Authorization administration**: manages principals, policies and grants. It should belong to a small, separate group.",{"_3640":692,"_31229":547,"_21648":53179,"_5":14899,"_28426":52808,"_3090":53180},[],"**PKI operation**: administers CAs, profiles and certificates, but not necessarily who gets access.",{"_3640":693,"_31229":547,"_21648":53182,"_5":14899,"_28426":52808,"_3090":53183},[],"**Device registration**: operates devices and DMSs without receiving permissions over keys or authorization configuration.",{"_3640":694,"_31229":547,"_21648":53185,"_5":14899,"_28426":52808,"_3090":53186},[],"**Audit**: reviews configuration and activity without creating, modifying, signing, revoking or deleting.",{"_3640":695,"_31229":547,"_21648":53188,"_5":14899,"_28426":52808,"_3090":53189},[],"**Automation**: uses a technical account or a separate certificate, with permissions limited to the flow and resources it controls.",{"_3640":696,"_31229":547,"_21648":53191,"_5":14899,"_28426":52808,"_3090":53192},[],"For each role, separate \"view\" from \"change\", limit resources through grants, relations or attributes and avoid `*` unless the role must automatically cover future actions.",{"_3640":697,"_31229":547,"_21648":53194,"_5":14899,"_28426":52808,"_3090":53195},[],"A rule with `actions: [\"*\"]` expands to every action defined by the schema. When a new version adds an action, a wildcard policy may start granting it. Review these policies on every upgrade.",{"_3640":698,"_31229":547,"_21648":53197,"_5":14899,"_28426":52812,"_3090":53198},[],"To revoke access immediately, disable the principal or revoke its grants. Disabling a principal keeps its configuration and associations for investigation or restoration, but it stops taking part in matching.",{"_3640":699,"_31229":547,"_21648":53200,"_5":14899,"_28426":52812,"_3090":53201},[],"Deleting a role or group in the IdP prevents new tokens from containing the claim, but an already-issued token may remain valid until it expires. If removal is urgent, combine the IdP change with disabling the principal in Lamassu and revoking sessions or tokens at the provider.",{"_3640":700,"_31229":547,"_21648":53203,"_5":14899,"_28426":52812,"_3090":53204},[],"When you edit a shared policy, remember the change affects all its principals. To test a new scope, create a separate policy, grant it to a test identity and validate allowed and denied operations before replacing the old one.",{"_3640":701,"_31229":547,"_21648":53206,"_5":14899,"_28426":52816,"_3090":53207},[],"Keep `failOpen: false` unless a documented risk assessment justifies otherwise.",{"_3640":702,"_31229":547,"_21648":53209,"_5":14899,"_28426":52816,"_3090":53210},[],"Use groups or stable roles for people and independent identities for automations.",{"_3640":703,"_31229":547,"_21648":53212,"_5":14899,"_28426":52816,"_3090":53213},[],"Keep at least two recovery administrators and test their access periodically.",{"_3640":704,"_31229":547,"_21648":53215,"_5":14899,"_28426":52816,"_3090":53216},[],"Review active principals, their matches and their grants after IdP changes.",{"_3640":705,"_31229":547,"_21648":53218,"_5":14899,"_28426":52816,"_3090":53219},[],"Search for wildcards in policies before upgrading Lamassu.",{"_3640":706,"_31229":547,"_21648":53221,"_5":14899,"_28426":52816,"_3090":53222},[],"Review `skip_authz` routes and `default_action` settings in HTTP schemas when integrating or upgrading a service.",{"_3640":707,"_31229":547,"_21648":53224,"_5":14899,"_28426":52816,"_3090":53225},[],"Always test one allowed and one denied operation for each role.",{"_3640":708,"_31229":547,"_21648":53227,"_5":14899,"_28426":52816,"_3090":53228},[],"Correlate changes to principals, policies and grants with the audit logs.",{"_3640":709,"_31229":547,"_21648":53230,"_5":14899,"_28426":52824,"_3090":53231},[],"Authentication failed before permissions were evaluated. Check the JWT signature and expiration, issuer, audience and the availability of the JWKS configured in the Gateway. For X.509, check that the client certificate reaches the point that extracts the credential.",{"_3640":710,"_31229":547,"_21648":53233,"_5":14899,"_28426":52828,"_3090":53234},[],"The credential could be processed but did not produce a positive authorization. Review in this order:",{"_3640":711,"_31229":547,"_21648":53236,"_5":14899,"_28426":52828,"_3090":53237},[],"that an active principal of the correct type exists;",{"_3640":712,"_31229":547,"_21648":53239,"_5":14899,"_28426":52828,"_3090":53240},[],"that the claim paths and values match the real token exactly;",{"_3640":713,"_31229":547,"_21648":53242,"_5":14899,"_28426":52828,"_3090":53243},[],"that all of the principal's conditions hold;",{"_3640":714,"_31229":547,"_21648":53245,"_5":14899,"_28426":52828,"_3090":53246},[],"that the principal has the expected policy granted;",{"_3640":715,"_31229":547,"_21648":53248,"_5":14899,"_28426":52828,"_3090":53249},[],"that the policy includes the action and the requested resource type or route;",{"_3640":716,"_31229":547,"_21648":53251,"_5":14899,"_28426":52828,"_3090":53252},[],"that the identifier, relation, column filter or HTTP constraint includes the real resource.",{"_3640":717,"_31229":547,"_21648":53254,"_5":14899,"_28426":52828,"_3090":53255},[],"In the `authz` logs, an external endpoint decision includes `allowed`, `reason`, `matched_principals`, `evaluated_policy_ids`, `matched_policy_id` and the status code. These fields let you separate a matching failure from a permissions failure. With OpenTelemetry tracing enabled, a request that reaches the policy engine produces an `engine.CheckHTTPRequest` span whose attributes record `authz.allowed`, the matched policy and the matched principal. Correlation with the Gateway trace requires trace context to be propagated to authz.",{"_3640":718,"_31229":547,"_21648":53257,"_5":14899,"_28426":52828,"_3090":53258},[],"If a policy that relied on inherited access stopped granting it after an upgrade, look in the `authz` logs for `skipping relation that grants nothing`: the warning names the policy and the relation the schemas no longer declare. Correct that policy's relation so it matches the current schemas.",{"_3640":719,"_31229":547,"_21648":53260,"_5":14899,"_28426":52832,"_3090":53261},[],"Check that the bootstrap principal was created and that the policies were preloaded by the migration Job. Also verify that `services.authz.jwkUrl` is reachable from the `authz` pod; do not assume that a URL accessible from the browser also works inside the cluster.",{"_3640":720,"_31229":547,"_21648":53263,"_5":14899,"_28426":52836,"_3090":53264},[],"The path may be covered by a schema-level decision rather than by a policy: routes marked `skip_authz` allow any identity that matches an active principal, and a request under a `base_paths` prefix whose schema sets `default_action: allow` is likewise allowed without consulting policies. Confirm which of the two applies before looking for missing or misassigned grants.",{"_3640":721,"_31229":547,"_21648":53266,"_5":14899,"_28426":52840,"_3090":53267},[],"This is the expected behavior with `failOpen: false`. Restore the service, its PostgreSQL connection and its JWKS connectivity. Do not temporarily switch to `failOpen: true` without accepting that protected routes could become accessible without an authorization decision.",{"_3640":722,"_31229":547,"_21648":53269,"_5":14899,"_28426":52840,"_3090":53270},[],"Continue with Audit logs to investigate configuration changes or with Troubleshooting to diagnose the deployment.",{"_3640":723,"_31229":723,"_5":15259,"_3090":53272,"_31567":53273,"_21648":53274,"_28426":723},"Alerts and subscriptions",[51054,52582,52583],[],{"_3640":724,"_31229":723,"_21648":53276,"_5":14899,"_28426":723,"_3090":53277},[],"Send PKI events to people and external systems.",{"_3640":725,"_31229":723,"_5":31564,"_21648":53279,"_28426":53280,"_3090":53281},[],"/docs/platform/administration/alerts#how-it-works","How it works",{"_3640":726,"_31229":723,"_5":31564,"_21648":53283,"_28426":53284,"_3090":53285},[],"/docs/platform/administration/alerts#available-channels","Available channels",{"_3640":727,"_31229":723,"_5":31564,"_21648":53287,"_28426":53288,"_3090":53289},[],"/docs/platform/administration/alerts#create-a-subscription","Create a subscription",{"_3640":728,"_31229":723,"_5":31564,"_21648":53291,"_28426":53292,"_3090":53293},[],"/docs/platform/administration/alerts#choose-the-event","Choose the event",{"_3640":729,"_31229":723,"_5":31564,"_21648":53295,"_28426":53296,"_3090":53297},[],"/docs/platform/administration/alerts#configure-the-destination","Configure the destination",{"_3640":730,"_31229":723,"_5":31564,"_21648":53299,"_28426":53300,"_3090":53301},[],"/docs/platform/administration/alerts#limit-the-notifications","Limit the notifications",{"_3640":731,"_31229":723,"_5":31564,"_21648":53303,"_28426":53304,"_3090":53305},[],"/docs/platform/administration/alerts#review-and-activate","Review and activate",{"_3640":732,"_31229":723,"_5":31564,"_21648":53307,"_28426":53308,"_3090":53309},[],"/docs/platform/administration/alerts#configure-the-webhook-http-client","Configure the webhook HTTP client",{"_3640":733,"_31229":723,"_5":31564,"_21648":53311,"_28426":53312,"_3090":53313},[],"/docs/platform/administration/alerts#webhook-delivery-rules","Webhook delivery rules",{"_3640":734,"_31229":723,"_5":31564,"_21648":53315,"_28426":53316,"_3090":53317},[],"/docs/platform/administration/alerts#manage-a-subscription","Manage a subscription",{"_3640":735,"_31229":723,"_5":31564,"_21648":53319,"_28426":53320,"_3090":53321},[],"/docs/platform/administration/alerts#event-families","Event families",{"_3640":736,"_31229":723,"_21648":53323,"_5":14899,"_28426":723,"_3090":53324},[],"Subscriptions turn Lamassu events into actionable notifications. You can alert a team, feed an incident system or trigger an automation when a CA, certificate or device changes.",{"_3640":737,"_31229":723,"_21648":53326,"_5":14899,"_28426":53280,"_3090":53327},[],"A service publishes a domain event.",{"_3640":738,"_31229":723,"_21648":53329,"_5":14899,"_28426":53280,"_3090":53330},[],"Lamassu evaluates the subscriptions associated with that event type.",{"_3640":739,"_31229":723,"_21648":53332,"_5":14899,"_28426":53280,"_3090":53333},[],"Each subscription's filter decides whether it should be notified.",{"_3640":740,"_31229":723,"_21648":53335,"_5":14899,"_28426":53280,"_3090":53336},[],"Lamassu delivers the event to the configured channel.",{"_3640":741,"_31229":723,"_21648":53338,"_5":14899,"_28426":53280,"_3090":53339},[],"The event inventory shows when each type was last observed, how many times it has occurred and how many subscriptions it has. You can expand an event to inspect an example of its JSON payload before creating the filter.",{"_3640":742,"_31229":723,"_21648":53341,"_5":14899,"_28426":53284,"_3090":53342},[],"**Email** sends alerts to a person or an operational list. It only requires the destination address. Event content is rendered as HTML-escaped text, never as markup.",{"_3640":743,"_31229":723,"_21648":53344,"_5":14899,"_28426":53284,"_3090":53345},[],"**Microsoft Teams** posts the notification to a channel through its webhook URL.",{"_3640":744,"_31229":723,"_21648":53347,"_5":14899,"_28426":53284,"_3090":53348},[],"**Webhook** delivers the event to an automation, SIEM or incident system via `POST` or `PUT`.",{"_3640":745,"_31229":723,"_21648":53350,"_5":14899,"_28426":53284,"_3090":53351},[],"The Microsoft Teams and Webhook channels accept an optional `http_client` block that authenticates the call to the receiver. `auth_mode` selects `noauth` (the default), `apikey`, `jwt` or `mtls`; each mode requires its own options:",{"_3640":746,"_31229":723,"_21648":53353,"_5":14899,"_28426":53284,"_3090":53354},[],"`apikey_options` requires `header` and `key`.",{"_3640":747,"_31229":723,"_21648":53356,"_5":14899,"_28426":53284,"_3090":53357},[],"`jwt_options` requires `oidc_client_id`, `oidc_client_secret` and an absolute `http` or `https` `oidc_well_known`.",{"_3640":748,"_31229":723,"_21648":53359,"_5":14899,"_28426":53284,"_3090":53360},[],"`mtls_options` requires `cert_content` and `key_content` as Base64-encoded PEM, like certificates elsewhere in the API; plain PEM is also accepted. Values that reference files on the server are rejected, and the pair must decode to a matching certificate and private key.",{"_3640":749,"_31229":723,"_21648":53362,"_5":14899,"_28426":53284,"_3090":53363},[],"The alerts API reference documents the full `http_client` schema.",{"_3640":750,"_31229":723,"_21648":53365,"_5":14899,"_28426":53292,"_3090":53366},[],"Open **Alerts**, locate the event type and select **Subscribe**. Review the latest JSON example to identify the fields you will need to filter on.",{"_3640":751,"_31229":723,"_21648":53368,"_5":14899,"_28426":53296,"_3090":53369},[],"Select Email, Microsoft Teams or Webhook and enter the channel details.",{"_3640":752,"_31229":723,"_21648":53371,"_5":14899,"_28426":53300,"_3090":53372},[],"Add a filter if you don't want to receive every instance of the event.",{"_3640":753,"_31229":723,"_21648":53374,"_5":14899,"_28426":53300,"_3090":53375},[],"**None** notifies all instances of the event.",{"_3640":754,"_31229":723,"_21648":53377,"_5":14899,"_28426":53300,"_3090":53378},[],"**JSON Path** evaluates one or more specific fields.",{"_3640":755,"_31229":723,"_21648":53380,"_5":14899,"_28426":53300,"_3090":53381},[],"**JSON Schema** accepts only payloads with a particular structure.",{"_3640":756,"_31229":723,"_21648":53383,"_5":14899,"_28426":53300,"_3090":53384},[],"**JavaScript** lets you express custom logic. Each filter runs for at most 100 milliseconds; a filter that exceeds this limit fails the condition and the notification is skipped with the error `javascript filter execution timed out`.",{"_3640":757,"_31229":723,"_21648":53386,"_5":14899,"_28426":53300,"_3090":53387},[],"For example, `function (event) { return event.data.status == \"NO_IDENTITY\"; }` limits a subscription to devices without an identity.",{"_3640":758,"_31229":723,"_21648":53389,"_5":14899,"_28426":53300,"_3090":53390},[],"The console evaluates the filter against the JSON shown in the **Input Event** editor, which is prefilled with the latest event, and reports whether it matches. For JSON Path and JavaScript filters, it shows **The filter matches this Cloud Event** or **The filter does not match this Cloud Event**. JSON Path expressions are evaluated against the full Cloud Event, so the default `$.data` selects the event's `data` field, and the expression must start with `$`.",{"_3640":759,"_31229":723,"_21648":53392,"_5":14899,"_28426":53304,"_3090":53393},[],"Check the event, channel and filter in the summary. Select **Confirm Subscription** to start delivery.",{"_3640":760,"_31229":723,"_21648":53395,"_5":14899,"_28426":53308,"_3090":53396},[],"The Webhook and Microsoft Teams channels show this configuration in the subscribe form, at the channel step, and again when editing a subscription; Email does not use it. The fields map to the optional `http_client` block described above:",{"_3640":761,"_31229":723,"_21648":53398,"_5":14899,"_28426":53308,"_3090":53399},[],"**Log Level** selects `debug`, `info`, `warn` or `error`; `info` is the default.",{"_3640":762,"_31229":723,"_21648":53401,"_5":14899,"_28426":53308,"_3090":53402},[],"**Call Timeout** defaults to 10 seconds. The console rejects a value above 30 seconds with `Webhook timeout must be at most 30s.`; the API clamps the same value to the cap instead (see Calls are bounded).",{"_3640":763,"_31229":723,"_21648":53404,"_5":14899,"_28426":53308,"_3090":53405},[],"There is no TLS-verification switch for these channels, because the service always verifies the receiver certificate (see TLS is always verified).",{"_3640":764,"_31229":723,"_21648":53407,"_5":14899,"_28426":53308,"_3090":53408},[],"**HTTP Authentication** selects `No Authentication` (the default), `API Key` (API key value and Header Name, `X-API-Key` by default), `OIDC Client Credentials` (Client ID, Client Secret and Well-Known URL) or `Mutual TLS` (Client Certificate and Client Private Key pasted as PEM). A stored private key stays hidden until you select **Show**.",{"_3640":765,"_31229":723,"_21648":53410,"_5":14899,"_28426":53308,"_3090":53411},[],"A `http://` URL shows the console warning `Unencrypted HTTP connection` (see the Credentials over http\\:// callout below).",{"_3640":766,"_31229":723,"_21648":53413,"_5":14899,"_28426":53308,"_3090":53414},[],"The form validates inline against the same delivery rules: the webhook URL and the OIDC Well-Known URL must be absolute `http` or `https` URLs, an API-key header may not use a reserved name, and the mTLS certificate and key must be PEM content, not file paths.",{"_3640":767,"_31229":723,"_21648":53416,"_5":14899,"_28426":53308,"_3090":53417},[],"The summary in the Confirm step shows the authentication as `None`, `OIDC client credentials`, `API key` or `Mutual TLS`. The subscription details show the authentication, the API key header name (never the value), the OIDC issuer URL, mTLS as `Configured` and a fixed `TLS verification: Verified` row. The API key, client secret and private key are not shown in the subscription details.",{"_3640":768,"_31229":723,"_21648":53419,"_5":14899,"_28426":53312,"_3090":53420},[],"Notifications delivered through the Microsoft Teams and Webhook channels follow a fixed HTTP policy:",{"_3640":769,"_31229":723,"_21648":53422,"_5":14899,"_28426":53312,"_3090":53423},[],"**TLS is always verified.** The receiver certificate is checked against the system trust store. `insecure_skip_verify` is enforced as `false` — including when it is set to `true` — so self-signed or otherwise untrusted receivers fail delivery.",{"_3640":770,"_31229":723,"_21648":53425,"_5":14899,"_28426":53312,"_3090":53426},[],"**Redirects are not followed.** A `3xx` response fails with `unexpected status code: <n>: redirects are not followed`. Configure `webhook_url` with the final absolute `http` or `https` URL: an `http://` address that an ingress redirects to `https://` stops working.",{"_3640":771,"_31229":723,"_21648":53428,"_5":14899,"_28426":53312,"_3090":53429},[],"**Calls are bounded.** A call defaults to a 10 second timeout; a configured `call_timeout` is capped at 30 seconds. Values above the cap are clamped, not rejected.",{"_3640":772,"_31229":723,"_21648":53431,"_5":14899,"_28426":53312,"_3090":53432},[],"**The response body is ignored.** Delivery checks the status code only, so the receiver may answer with any body.",{"_3640":773,"_31229":723,"_21648":53434,"_5":14899,"_28426":53312,"_3090":53435},[],"**API-key headers are restricted.** A custom `apikey_options.header` may not use names that the platform or receiving services trust — for example `X-Principal-Id`, `X-Request-Id`, `Host`, `Content-Type` or `Forwarded` — and no name may start with `X-Forwarded-`, `X-Envoy-` or `X-Lms-`. Comparisons are case-insensitive.",{"_3640":774,"_31229":723,"_21648":53437,"_5":14899,"_28426":53312,"_3090":53438},[],"**Invalid configurations are rejected at subscribe time.** A channel configuration that would fail on every delivery returns HTTP 400 with a body that starts with `struct validation error:`, and the subscription is not created.",{"_3640":775,"_31229":723,"_21648":53440,"_5":14899,"_28426":53312,"_3090":53441},[],"Credentials are sent regardless of the URL scheme. With an `http://` `webhook_url`, the API key or bearer token travels in cleartext and mTLS has no effect. Prefer `https://` for `webhook_url`, `oidc_well_known` and the token endpoint it advertises.",{"_3640":776,"_31229":723,"_21648":53443,"_5":14899,"_28426":53316,"_3090":53444},[],"Open an existing subscription to review its destination and filter, modify the configuration or select **Unsubscribe**. Remove subscriptions that no longer have an operational owner to avoid ignored deliveries or stale endpoints.",{"_3640":777,"_31229":723,"_21648":53446,"_5":14899,"_28426":53316,"_3090":53447},[],"Subscriptions created with older console versions may store the webhook target under `url` and `method` instead of `webhook_url` and `webhook_method`. The service delivers only through `webhook_url` and `webhook_method`, so such a subscription does not deliver even though the subscription details show the stored target. Open the subscription and save it again: the edit form prefills the stored target, and saving rewrites the channel configuration in the current layout.",{"_3640":778,"_31229":723,"_21648":53449,"_5":14899,"_28426":53320,"_3090":53450},[],"**Authorities:** `ca.create`, `ca.import`, `ca.reissue` and `ca.delete`.",{"_3640":779,"_31229":723,"_21648":53452,"_5":14899,"_28426":53320,"_3090":53453},[],"**Certificates:** `ca.sign.certificate` and `certificate.delete`.",{"_3640":780,"_31229":723,"_21648":53455,"_5":14899,"_28426":53320,"_3090":53456},[],"**Profiles:** `profile.issuance.create`, `profile.issuance.update` and `profile.issuance.delete`.",{"_3640":781,"_31229":723,"_21648":53458,"_5":14899,"_28426":53320,"_3090":53459},[],"**Enrollment:** `dms.create`, `dms.update`, `dms.enroll` and `dms.reenroll`.",{"_3640":782,"_31229":723,"_21648":53461,"_5":14899,"_28426":53320,"_3090":53462},[],"**Devices:** `device.create`, `device.identity.update` and `device.status.update`.",{"_3640":783,"_31229":723,"_21648":53464,"_5":14899,"_28426":53320,"_3090":53465},[],"**Validation:** `va.role.crl.create`, `va.crl-settings.init`, `va.crl-settings.update`, `va.crl-settings.finalize`, `va.crl-settings.archive` and `va.crl-settings.delete`.",{"_3640":784,"_31229":723,"_21648":53467,"_5":14899,"_28426":53320,"_3090":53468},[],"**Keys:** `kms.create`, `kms.import`, `kms.sign` and `kms.delete`.",{"_3640":785,"_31229":723,"_21648":53470,"_5":14899,"_28426":53320,"_3090":53471},[],"Use the catalog shown in the console as the source for the types available in your deployed version.",{"_3640":786,"_31229":723,"_21648":53473,"_5":14899,"_28426":53320,"_3090":53474},[],"Since 4.0.0, `va.crl-settings.init` and `va.crl-settings.update` carry the CRL settings of a CA (`ca_id`) and replace `va.role.crl.init` and `va.role.update`. The upgrade migration renames the types of existing subscriptions automatically, but it does not rewrite their conditions: review filters that read the old payload or the old `crl/<ski>` subject, including filters for `va.role.crl.create` (see 3.8.0 to 4.0.0).",{"_3640":787,"_31229":723,"_21648":53476,"_5":14899,"_28426":53320,"_3090":53477},[],"The VA also publishes `va.crl-settings.finalize` when a CA is revoked permanently or expires, `va.crl-settings.archive` when the CA is deleted, and `va.crl-settings.delete` when archived settings are removed.",{"_3640":788,"_31229":788,"_5":15259,"_3090":53479,"_31567":53480,"_21648":53481,"_28426":788},"Audit logs",[51054,52582,52583],[],{"_3640":789,"_31229":788,"_21648":53483,"_5":14899,"_28426":788,"_3090":53484},[],"Understand which audit events Lamassu generates and how to turn them into a durable trail.",{"_3640":790,"_31229":788,"_5":31564,"_21648":53486,"_28426":53487,"_3090":53488},[],"/docs/platform/administration/audit-logs#what-an-event-contains","What an event contains",{"_3640":791,"_31229":788,"_5":31564,"_21648":53490,"_28426":53491,"_3090":53492},[],"/docs/platform/administration/audit-logs#coverage","Coverage",{"_3640":792,"_31229":788,"_5":31564,"_21648":53494,"_28426":53495,"_3090":53496},[],"/docs/platform/administration/audit-logs#publication-and-persistence","Publication and persistence",{"_3640":793,"_31229":788,"_5":31564,"_21648":53498,"_28426":53499,"_3090":53500},[],"/docs/platform/administration/audit-logs#sensitive-data","Sensitive data",{"_3640":794,"_31229":788,"_5":31564,"_21648":53502,"_28426":53503,"_3090":53504},[],"/docs/platform/administration/audit-logs#a-reproducible-investigation","A reproducible investigation",{"_3640":795,"_31229":788,"_5":31564,"_21648":53506,"_28426":53507,"_3090":53508},[],"/docs/platform/administration/audit-logs#bound-the-interval","Bound the interval",{"_3640":796,"_31229":788,"_5":31564,"_21648":53510,"_28426":53511,"_3090":53512},[],"/docs/platform/administration/audit-logs#identify-the-operation","Identify the operation",{"_3640":797,"_31229":788,"_5":31564,"_21648":53514,"_28426":53515,"_3090":53516},[],"/docs/platform/administration/audit-logs#attribute-the-principal","Attribute the principal",{"_3640":798,"_31229":788,"_5":31564,"_21648":53518,"_28426":53519,"_3090":53520},[],"/docs/platform/administration/audit-logs#compare-intent-and-result","Compare intent and result",{"_3640":799,"_31229":788,"_5":31564,"_21648":53522,"_28426":53523,"_3090":53524},[],"/docs/platform/administration/audit-logs#follow-the-effect","Follow the effect",{"_3640":800,"_31229":788,"_5":31564,"_21648":53526,"_28426":53527,"_3090":53528},[],"/docs/platform/administration/audit-logs#periodic-verification","Periodic verification",{"_3640":801,"_31229":788,"_21648":53530,"_5":14899,"_28426":788,"_3090":53531},[],"Lamassu instruments the mutable operations of its services with audit events. Each event describes the operation, the principals that matched, the input, the result and whether it ended in error.",{"_3640":802,"_31229":788,"_21648":53533,"_5":14899,"_28426":53487,"_3090":53534},[],"The audit body includes:",{"_3640":803,"_31229":788,"_21648":53536,"_5":14899,"_28426":53487,"_3090":53537},[],"input: data received by the operation;",{"_3640":804,"_31229":788,"_21648":53539,"_5":14899,"_28426":53487,"_3090":53540},[],"has\\_error: whether the service returned an error;",{"_3640":805,"_31229":788,"_21648":53542,"_5":14899,"_28426":53487,"_3090":53543},[],"output: produced result or error message;",{"_3640":806,"_31229":788,"_21648":53545,"_5":14899,"_28426":53487,"_3090":53546},[],"principals: identifiers of the principals that matched the request.",{"_3640":807,"_31229":788,"_21648":53548,"_5":14899,"_28426":53487,"_3090":53549},[],"Successful operations use a type prefixed with audit.. Failures publish the operation type suffixed with .error. The CloudEvents event additionally adds source, identifier, date and type.",{"_3640":808,"_31229":788,"_21648":53551,"_5":14899,"_28426":53487,"_3090":53552},[],"The middlewares publish the record after executing the operation, whether it succeeded or returned an error. This lets you investigate attempts as well as confirmed changes.",{"_3640":809,"_31229":788,"_21648":53554,"_5":14899,"_28426":53491,"_3090":53555},[],"The backend applies auditing to mutations of:",{"_3640":810,"_31229":788,"_21648":53557,"_5":14899,"_28426":53491,"_3090":53558},[],"authorities, certificates and issuance profiles;",{"_3640":811,"_31229":788,"_21648":53560,"_5":14899,"_28426":53491,"_3090":53561},[],"keys and KMS engines;",{"_3640":812,"_31229":788,"_21648":53563,"_5":14899,"_28426":53491,"_3090":53564},[],"devices and identities;",{"_3640":813,"_31229":788,"_21648":53566,"_5":14899,"_28426":53491,"_3090":53567},[],"DMSs and enrollment operations;",{"_3640":814,"_31229":788,"_21648":53569,"_5":14899,"_28426":53491,"_3090":53570},[],"validation functions and CRL;",{"_3640":815,"_31229":788,"_21648":53572,"_5":14899,"_28426":53491,"_3090":53573},[],"principals, policies and authorization grants.",{"_3640":816,"_31229":788,"_21648":53575,"_5":14899,"_28426":53491,"_3090":53576},[],"Do not confuse these events with domain events. A domain event announces that a resource changed so another component can react; the audit event keeps input, output and principal context for investigation.",{"_3640":817,"_31229":788,"_21648":53578,"_5":14899,"_28426":53495,"_3090":53579},[],"Services publish audit records to the event bus when their PublisherEventBus is enabled. The backend code does not, by itself, implement a queryable, durable audit file.",{"_3640":818,"_31229":788,"_21648":53581,"_5":14899,"_28426":53495,"_3090":53582},[],"If you need retention, search, tamper protection or regulatory export, connect a consumer that persists the events into the system approved by your organization.",{"_3640":819,"_31229":788,"_21648":53584,"_5":14899,"_28426":53495,"_3090":53585},[],"Design the consumer to:",{"_3640":820,"_31229":788,"_21648":53587,"_5":14899,"_28426":53495,"_3090":53588},[],"subscribe to the audit.# types and also to operation types ending in .error;",{"_3640":821,"_31229":788,"_21648":53590,"_5":14899,"_28426":53495,"_3090":53591},[],"keep the complete CloudEvent unmodified;",{"_3640":822,"_31229":788,"_21648":53593,"_5":14899,"_28426":53495,"_3090":53594},[],"record the ingestion time and detect duplicates by ID;",{"_3640":823,"_31229":788,"_21648":53596,"_5":14899,"_28426":53495,"_3090":53597},[],"encrypt in transit and at rest;",{"_3640":824,"_31229":788,"_21648":53599,"_5":14899,"_28426":53495,"_3090":53600},[],"restrict reading and deletion to a role separate from the PKI operator;",{"_3640":825,"_31229":788,"_21648":53602,"_5":14899,"_28426":53495,"_3090":53603},[],"apply an explicit retention and legal hold policy;",{"_3640":826,"_31229":788,"_21648":53605,"_5":14899,"_28426":53495,"_3090":53606},[],"alert if it stops consuming or the pending queue grows.",{"_3640":827,"_31229":788,"_21648":53608,"_5":14899,"_28426":53499,"_3090":53609},[],"The input and output fields can contain subjects, metadata, public material, configuration or error messages. Evaluate their classification before sending them to an external platform.",{"_3640":828,"_31229":788,"_21648":53611,"_5":14899,"_28426":53499,"_3090":53612},[],"Do not log private keys, provider secrets or full tokens in automations around Lamassu. Restrict export and apply redaction at the destination without destroying the fields needed for attribution.",{"_3640":829,"_31229":788,"_21648":53614,"_5":14899,"_28426":53507,"_3090":53615},[],"Start from the reported time and normalize every source to UTC.",{"_3640":830,"_31229":788,"_21648":53617,"_5":14899,"_28426":53511,"_3090":53618},[],"Filter by event type, service source and resource identifier.",{"_3640":831,"_31229":788,"_21648":53620,"_5":14899,"_28426":53515,"_3090":53621},[],"Review principals and correlate them with the OIDC provider or the X.509 identity valid at that moment.",{"_3640":832,"_31229":788,"_21648":53623,"_5":14899,"_28426":53519,"_3090":53624},[],"Contrast input, has\\_error and output. A failed attempt does not mean the resource changed.",{"_3640":833,"_31229":788,"_21648":53626,"_5":14899,"_28426":53523,"_3090":53627},[],"Look for the domain events and service records that share resource and time window. In a CA revocation, include the cascading operations.",{"_3640":834,"_31229":788,"_21648":53629,"_5":14899,"_28426":53527,"_3090":53630},[],"Generate a controlled mutation in a test environment and check that:",{"_3640":835,"_31229":788,"_21648":53632,"_5":14899,"_28426":53527,"_3090":53633},[],"a successful audit event appears;",{"_3640":836,"_31229":788,"_21648":53635,"_5":14899,"_28426":53527,"_3090":53636},[],"the principal matches the identity used;",{"_3640":837,"_31229":788,"_21648":53638,"_5":14899,"_28426":53527,"_3090":53639},[],"the consumer persists it exactly once;",{"_3640":838,"_31229":788,"_21648":53641,"_5":14899,"_28426":53527,"_3090":53642},[],"it can be retrieved by resource, actor and period;",{"_3640":839,"_31229":788,"_21648":53644,"_5":14899,"_28426":53527,"_3090":53645},[],"a consumer outage raises an alert.",{"_3640":840,"_31229":788,"_21648":53647,"_5":14899,"_28426":53527,"_3090":53648},[],"For metrics, traces and technical logs of the deployment, see Troubleshooting. Audit answers \"who tried to change what\"; observability explains how the system behaved.",{"_3640":841,"_31229":841,"_5":15259,"_3090":53650,"_31567":53651,"_21648":53652,"_28426":841},"Platform architecture",[51054,52582],[],{"_3640":842,"_31229":841,"_21648":53654,"_5":14899,"_28426":841,"_3090":53655},[],"Lamassu components and how control, keys, issuance and devices relate.",{"_3640":843,"_31229":841,"_5":31564,"_21648":53657,"_28426":53658,"_3090":53659},[],"/docs/platform/concepts/architecture#control-plane","Control plane",{"_3640":844,"_31229":841,"_5":31564,"_21648":53661,"_28426":53662,"_3090":53663},[],"/docs/platform/concepts/architecture#key-custody-and-cryptographic-operations","Key custody and cryptographic operations",{"_3640":845,"_31229":841,"_5":31564,"_21648":53665,"_28426":53666,"_3090":53667},[],"/docs/platform/concepts/architecture#issuance-and-enrollment","Issuance and enrollment",{"_3640":846,"_31229":841,"_5":31564,"_21648":53669,"_28426":53670,"_3090":53671},[],"/docs/platform/concepts/architecture#status-and-validation","Status and validation",{"_3640":847,"_31229":841,"_5":31564,"_21648":53673,"_28426":53674,"_3090":53675},[],"/docs/platform/concepts/architecture#platform-dependencies","Platform dependencies",{"_3640":848,"_31229":841,"_21648":53677,"_5":14899,"_28426":841,"_3090":53678},[],"Lamassu deploys as a set of independent services. This separation keeps every component from needing direct access to private keys and lets each capability scale according to load.",{"_3640":849,"_31229":841,"_21648":53680,"_5":14899,"_28426":841,"_3090":53681},[],"Switch to the low level to see the internals of the Lamassu platform box (CA, KMS, DMS, Device Manager, VA, Alerts, AWS IoT connector, Job Manager and the console/API), and to medium to see it as a single platform alongside its external dependencies.",{"_3640":850,"_31229":841,"_21648":53683,"_5":14899,"_28426":53658,"_3090":53684},[],"The console and the APIs manage authorities, certificates, DMSs, devices, alerts and configuration. Domain events allow connectors and automations to react to changes without continuously polling the platform.",{"_3640":851,"_31229":841,"_21648":53686,"_5":14899,"_28426":53662,"_3090":53687},[],"The KMS offers a common interface over software engines, PKCS#11 and cloud providers. The selected engine keeps the key or delegates the cryptographic operation without the other services knowing its implementation.",{"_3640":852,"_31229":841,"_21648":53689,"_5":14899,"_28426":53666,"_3090":53690},[],"The CA service issues certificates and maintains the relationship with its authority. The DMS applies the enrollment rules and exposes the EST flows so a device can request or renew an identity.",{"_3640":853,"_31229":841,"_21648":53692,"_5":14899,"_28426":53670,"_3090":53693},[],"Device Manager keeps the operational view of the device and its history. The Validation Authority publishes OCSP and CRLs so other systems can decide whether to trust a presented certificate.",{"_3640":854,"_31229":841,"_21648":53695,"_5":14899,"_28426":53674,"_3090":53696},[],"In a self-managed deployment, Lamassu uses PostgreSQL for persistence, RabbitMQ for messaging and an OIDC provider for authentication. See the deployment architecture for how the services are published on Kubernetes.",{"_3640":855,"_31229":855,"_5":15259,"_3090":53698,"_31567":53699,"_21648":53700,"_28426":855},"How Lamassu works",[51054,52582],[],{"_3640":856,"_31229":855,"_21648":53702,"_5":14899,"_28426":855,"_3090":53703},[],"The mental model of trust, keys, certificates and devices.",{"_3640":857,"_31229":855,"_5":31564,"_21648":53705,"_28426":53706,"_3090":53707},[],"/docs/platform/concepts/overview#the-model-in-five-pieces","The model in five pieces",{"_3640":858,"_31229":855,"_5":31564,"_21648":53709,"_28426":53710,"_3090":53711},[],"/docs/platform/concepts/overview#from-onboarding-to-operation","From onboarding to operation",{"_3640":859,"_31229":855,"_21648":53713,"_5":14899,"_28426":855,"_3090":53714},[],"Lamassu connects three elements: a **root of trust**, an **issuance policy** and an **entity that needs to prove its identity**. The platform coordinates these elements throughout the certificate lifecycle.",{"_3640":860,"_31229":855,"_21648":53716,"_5":14899,"_28426":53706,"_3090":53717},[],"**Cryptographic engine.** Generates or safeguards keys and executes private-key operations without exposing key material to the rest of the services.",{"_3640":861,"_31229":855,"_21648":53719,"_5":14899,"_28426":53706,"_3090":53720},[],"**Certification Authority (CA).** Signs certificates and establishes the chain of trust.",{"_3640":862,"_31229":855,"_21648":53722,"_5":14899,"_28426":53706,"_3090":53723},[],"**Device Management Service (DMS).** Defines how the devices of a fleet are registered, authenticated and renewed.",{"_3640":863,"_31229":855,"_21648":53725,"_5":14899,"_28426":53706,"_3090":53726},[],"**Device.** Keeps its private key and presents the certificate to prove its identity.",{"_3640":864,"_31229":855,"_21648":53728,"_5":14899,"_28426":53706,"_3090":53729},[],"**Validation Authority (VA).** Publishes the status of certificates through OCSP and CRL.",{"_3640":865,"_31229":855,"_21648":53731,"_5":14899,"_28426":53710,"_3090":53732},[],"An administrator configures a cryptographic engine and creates or imports a CA.",{"_3640":866,"_31229":855,"_21648":53734,"_5":14899,"_28426":53710,"_3090":53735},[],"A DMS relates that CA to an enrollment policy.",{"_3640":867,"_31229":855,"_21648":53737,"_5":14899,"_28426":53710,"_3090":53738},[],"The device generates a key and requests a certificate through EST, or an operator assigns it an identity.",{"_3640":868,"_31229":855,"_21648":53740,"_5":14899,"_28426":53710,"_3090":53741},[],"Lamassu keeps the inventory, history and status of the identity.",{"_3640":869,"_31229":855,"_21648":53743,"_5":14899,"_28426":53710,"_3090":53744},[],"Consumers check the chain and query OCSP or a CRL when they need to know whether it is still valid.",{"_3640":870,"_31229":855,"_21648":53746,"_5":14899,"_28426":53710,"_3090":53747},[],"<Card title=\"Architecture\" description=\"Get to know the components and where each one's responsibility ends.\" href=\"/docs/platform/concepts/architecture\" />",{"_3640":871,"_31229":855,"_21648":53749,"_5":14899,"_28426":53710,"_3090":53750},[],"<Card title=\"Identity lifecycle\" description=\"Follow a certificate from enrollment to renewal or revocation.\" href=\"/docs/platform/pki/concepts/certificate-lifecycle\" />",{"_3640":872,"_31229":872,"_5":15259,"_3090":53752,"_31567":53753,"_21648":53755,"_28426":872},"Devices and identities",[51054,52582,53754,53752],"IoT Fleets",[],{"_3640":873,"_31229":872,"_21648":53757,"_5":14899,"_28426":872,"_3090":53758},[],"Register, inspect and retire devices while checking their current identity and history.",{"_3640":874,"_31229":872,"_5":31564,"_21648":53760,"_28426":53761,"_3090":53762},[],"/docs/platform/iot-fleets/device-management#device-states","Device states",{"_3640":875,"_31229":872,"_5":31564,"_21648":53764,"_28426":53765,"_3090":53766},[],"/docs/platform/iot-fleets/device-management#inspect-a-device","Inspect a device",{"_3640":876,"_31229":872,"_5":31564,"_21648":53768,"_28426":53769,"_3090":53770},[],"/docs/platform/iot-fleets/device-management#register-a-device-manually","Register a device manually",{"_3640":877,"_31229":872,"_5":31564,"_21648":53772,"_28426":53773,"_3090":53774},[],"/docs/platform/iot-fleets/device-management#create-the-device","Create the device",{"_3640":878,"_31229":872,"_5":31564,"_21648":53776,"_28426":53777,"_3090":53778},[],"/docs/platform/iot-fleets/device-management#define-its-membership","Define its membership",{"_3640":879,"_31229":872,"_5":31564,"_21648":53780,"_28426":53781,"_3090":53782},[],"/docs/platform/iot-fleets/device-management#classify-the-device","Classify the device",{"_3640":880,"_31229":872,"_5":31564,"_21648":53784,"_28426":53785,"_3090":53786},[],"/docs/platform/iot-fleets/device-management#verify-the-registration","Verify the registration",{"_3640":881,"_31229":872,"_5":31564,"_21648":53788,"_28426":53789,"_3090":53790},[],"/docs/platform/iot-fleets/device-management#assign-an-identity-manually","Assign an identity manually",{"_3640":882,"_31229":872,"_5":31564,"_21648":53792,"_28426":53793,"_3090":53794},[],"/docs/platform/iot-fleets/device-management#revoke-the-current-identity","Revoke the current identity",{"_3640":883,"_31229":872,"_5":31564,"_21648":53796,"_28426":53797,"_3090":53798},[],"/docs/platform/iot-fleets/device-management#decommission-a-device","Decommission a device",{"_3640":884,"_31229":872,"_5":31564,"_21648":53800,"_28426":53801,"_3090":53802},[],"/docs/platform/iot-fleets/device-management#automate-enrollment","Automate enrollment",{"_3640":885,"_31229":872,"_21648":53804,"_5":14899,"_28426":872,"_3090":53805},[],"This guide is for a fleet operator. You need device, DMS and certificate permissions for the intended actions. A fleet is organized through these resources, tags and metadata; there is no separate “fleet” object to create.",{"_3640":886,"_31229":872,"_21648":53807,"_5":14899,"_28426":872,"_3090":53808},[],"Each device has a `Device ID`, one owning DMS (`dms_owner`) and, once provisioned, an identity slot with an active version and previous versions. In these flows, keep the CSR and certificate `Common Name` equal to `Device ID`: binding uses that CN to update the device.",{"_3640":887,"_31229":872,"_21648":53810,"_5":14899,"_28426":53761,"_3090":53811},[],"Operational view",{"_3640":888,"_31229":872,"_21648":53813,"_5":14899,"_28426":53761,"_3090":53814},[],"Meaning",{"_3640":889,"_31229":872,"_21648":53816,"_5":14899,"_28426":53761,"_3090":53817},[],"**No Identity**",{"_3640":890,"_31229":872,"_21648":53819,"_5":14899,"_28426":53761,"_3090":53820},[],"A record exists without an associated identity.",{"_3640":891,"_31229":872,"_21648":53822,"_5":14899,"_28426":53761,"_3090":53823},[],"**Active**",{"_3640":892,"_31229":872,"_21648":53825,"_5":14899,"_28426":53761,"_3090":53826},[],"The slot is active; also check certificate dates, status and usages.",{"_3640":893,"_31229":872,"_21648":53828,"_5":14899,"_28426":53761,"_3090":53829},[],"**Renewal Pending**",{"_3640":894,"_31229":872,"_21648":53831,"_5":14899,"_28426":53761,"_3090":53832},[],"The identity is in the operational renewal window.",{"_3640":895,"_31229":872,"_21648":53834,"_5":14899,"_28426":53761,"_3090":53835},[],"**Expiring Soon**",{"_3640":896,"_31229":872,"_21648":53837,"_5":14899,"_28426":53761,"_3090":53838},[],"Expiration is approaching according to configured thresholds.",{"_3640":897,"_31229":872,"_21648":53840,"_5":14899,"_28426":53761,"_3090":53841},[],"**Expired**",{"_3640":898,"_31229":872,"_21648":53843,"_5":14899,"_28426":53761,"_3090":53844},[],"The identity has expired.",{"_3640":899,"_31229":872,"_21648":53846,"_5":14899,"_28426":53761,"_3090":53847},[],"**Revoked**",{"_3640":900,"_31229":872,"_21648":53849,"_5":14899,"_28426":53761,"_3090":53850},[],"The identity is marked revoked. A hold cascaded from its CA shows here and is lifted when that CA is released.",{"_3640":901,"_31229":872,"_21648":53852,"_5":14899,"_28426":53761,"_3090":53853},[],"**Decommissioned**",{"_3640":902,"_31229":872,"_21648":53855,"_5":14899,"_28426":53761,"_3090":53856},[],"The record is retired and ordinary updates do not restore operation.",{"_3640":903,"_31229":872,"_21648":53858,"_5":14899,"_28426":53761,"_3090":53859},[],"Device, slot and certificate states are distinct. Events and jobs can update the view after saving a certificate; an **Active** label does not establish consumer acceptance.",{"_3640":904,"_31229":872,"_21648":53861,"_5":14899,"_28426":53765,"_3090":53862},[],"Filter the inventory by ID, tags and status. Open details and record the owning DMS, active version and current certificate serial.",{"_3640":905,"_31229":872,"_21648":53864,"_5":14899,"_28426":53765,"_3090":53865},[],"**Certificate History** relates previous and current versions. Replacing the slot does not by itself revoke every previous version.",{"_3640":906,"_31229":872,"_21648":53867,"_5":14899,"_28426":53765,"_3090":53868},[],"**Device Event Timeline** helps reconstruct registration, provisioning, renewal and status changes. A change may be saved even if event persistence fails; also inspect the record and certificates.",{"_3640":907,"_31229":872,"_21648":53870,"_5":14899,"_28426":53765,"_3090":53871},[],"Compare these values with the identity installed on the device. Updating a Lamassu slot does not install files on the remote equipment.",{"_3640":908,"_31229":872,"_21648":53873,"_5":14899,"_28426":53769,"_3090":53874},[],"Use this flow to prepare inventory or assign an identity through the console. You need an existing DMS.",{"_3640":909,"_31229":872,"_21648":53876,"_5":14899,"_28426":53773,"_3090":53877},[],"Open registration in **Managed Devices**. Confirm the ID does not already exist in another DMS: ID lookup is not restricted to a fleet.",{"_3640":910,"_31229":872,"_21648":53879,"_5":14899,"_28426":53777,"_3090":53880},[],"Enter **Device ID** and select its owning DMS. The console’s **Registration Authority** label refers to that DMS.",{"_3640":911,"_31229":872,"_21648":53882,"_5":14899,"_28426":53781,"_3090":53883},[],"Add model, environment or location tags and an icon according to your inventory.",{"_3640":912,"_31229":872,"_21648":53885,"_5":14899,"_28426":53785,"_3090":53886},[],"Read the device again: require the intended DMS and **No Identity**. Follow Manual registration to complete assignment.",{"_3640":913,"_31229":872,"_21648":53888,"_5":14899,"_28426":53785,"_3090":53889},[],"Preregistration does not establish that `/simpleenroll` will admit the request. Review its interaction with `enable_replaceable_enrollment` in Provisioning strategies.",{"_3640":914,"_31229":872,"_21648":53891,"_5":14899,"_28426":53789,"_3090":53892},[],"From **No Identity**, use **Assign Identity**:",{"_3640":915,"_31229":872,"_21648":53894,"_5":14899,"_28426":53789,"_3090":53895},[],"Select an active, current certificate suitable for the consumer, with `CN` exactly equal to `Device ID`.",{"_3640":916,"_31229":872,"_21648":53897,"_5":14899,"_28426":53789,"_3090":53898},[],"If unavailable, **Issue New Instead** starts issuance using the intended CA. Review the profile first.",{"_3640":917,"_31229":872,"_21648":53900,"_5":14899,"_28426":53789,"_3090":53901},[],"Confirm and read the serial, active version and history again.",{"_3640":918,"_31229":872,"_21648":53903,"_5":14899,"_28426":53789,"_3090":53904},[],"Install the key/certificate pair and required intermediates on the device and test usage.",{"_3640":919,"_31229":872,"_21648":53906,"_5":14899,"_28426":53789,"_3090":53907},[],"Issuing, binding and installing are separate steps. If an operation fails, check which steps persisted before repeating it.",{"_3640":920,"_31229":872,"_21648":53909,"_5":14899,"_28426":53793,"_3090":53910},[],"Locate the active serial in history and revoke it with an appropriate reason. Verify the record, OCSP/CRL publication and rejection of a new consumer connection using the certificate guide.",{"_3640":921,"_31229":872,"_21648":53912,"_5":14899,"_28426":53793,"_3090":53913},[],"Revocation does not remove the device. It does not automatically enable another enrollment either: recovery depends on its credential, status and DMS policy. `CertificateHold` can be reactivated under PKI conditions; other reasons block subsequent certificate changes.",{"_3640":922,"_31229":872,"_21648":53915,"_5":14899,"_28426":53793,"_3090":53916},[],"A certificate suspended by a CA hold cascade shows as **Revoked** and returns to active when the holding CA is released. If its certificate expired during the hold, the monitoring job marks it as expired again after the release. If you revoke a held identity yourself, that revocation is permanent.",{"_3640":923,"_31229":872,"_21648":53918,"_5":14899,"_28426":53797,"_3090":53919},[],"Before **Decommission**, inventory active and previous identities, connections and destination permissions. Prepare retirement in the consumer.",{"_3640":924,"_31229":872,"_21648":53921,"_5":14899,"_28426":53797,"_3090":53922},[],"The backend saves **Decommissioned** and attempts to revoke the active version’s certificate with `CessationOfOperation` if the slot was not expired or revoked. It does not traverse all history. Deferred revocation can fail after retirement is saved; check the result by serial.",{"_3640":925,"_31229":872,"_21648":53924,"_5":14899,"_28426":53797,"_3090":53925},[],"Retired status protects ordinary device and slot updates. It does not guarantee that every EST request is rejected before issuance: binding can skip a retired device without returning an error. Check for remaining usable certificates or permissions and block new admission in the relevant control.",{"_3640":926,"_31229":872,"_21648":53927,"_5":14899,"_28426":53797,"_3090":53928},[],"Retain records according to audit policy. Do not reuse a retired ID to hide an equipment change.",{"_3640":927,"_31229":872,"_21648":53930,"_5":14899,"_28426":53801,"_3090":53931},[],"<Card title=\"Enroll and connect a device\" description=\"Obtain an identity from the client and test mTLS.\" href=\"/docs/platform/iot-fleets/quickstarts/enroll-device\" />",{"_3640":928,"_31229":872,"_21648":53933,"_5":14899,"_28426":53801,"_3090":53934},[],"<Card title=\"Renewal and recovery\" description=\"Install the successor and handle failures without losing known state.\" href=\"/docs/platform/iot-fleets/enrollment/renewal-and-recovery\" />",{"_3640":929,"_31229":929,"_5":15259,"_3090":53936,"_31567":53937,"_21648":53939,"_28426":929},"Bootstrap identity and authentication",[51054,52582,53754,53752,53938],"Enrollment with PKI",[],{"_3640":930,"_31229":929,"_21648":53941,"_5":14899,"_28426":929,"_3090":53942},[],"Prepare server trust and admission proofs for enroll and reenroll.",{"_3640":931,"_31229":929,"_5":31564,"_21648":53944,"_28426":53945,"_3090":53946},[],"/docs/platform/iot-fleets/enrollment/bootstrap-identity#initial-server-trust","Initial server trust",{"_3640":932,"_31229":929,"_5":31564,"_21648":53948,"_28426":53949,"_3090":53950},[],"/docs/platform/iot-fleets/enrollment/bootstrap-identity#bootstrap-credential","Bootstrap credential",{"_3640":933,"_31229":929,"_5":31564,"_21648":53952,"_28426":53953,"_3090":53954},[],"/docs/platform/iot-fleets/enrollment/bootstrap-identity#modes-per-operation","Modes per operation",{"_3640":934,"_31229":929,"_5":31564,"_21648":53956,"_28426":53957,"_3090":53958},[],"/docs/platform/iot-fleets/enrollment/bootstrap-identity#webhook-contract","Webhook contract",{"_3640":935,"_31229":929,"_5":31564,"_21648":53960,"_28426":53961,"_3090":53962},[],"/docs/platform/iot-fleets/enrollment/bootstrap-identity#revocation-and-checks","Revocation and checks",{"_3640":936,"_31229":929,"_21648":53964,"_5":14899,"_28426":929,"_3090":53965},[],"This guide connects the DMS administrator with device manufacturing and integration. Before requesting an operational identity, the client must authenticate the EST server and establish entitlement to request the intended ID.",{"_3640":937,"_31229":929,"_21648":53967,"_5":14899,"_28426":53945,"_3090":53968},[],"Install a previously verified root, chain or pin through a trusted channel: manufacturing, approved configuration or authenticated distribution. It enables TLS and server-name verification before downloading `/cacerts`.",{"_3640":938,"_31229":929,"_21648":53970,"_5":14899,"_28426":53945,"_3090":53971},[],"Your only trust proof cannot come from the same unauthenticated server. The EST server TLS certificate, bootstrap certificate and operational identity issuer may belong to different hierarchies.",{"_3640":939,"_31229":929,"_21648":53973,"_5":14899,"_28426":53949,"_3090":53974},[],"With `CLIENT_CERTIFICATE`, the device presents its initial certificate and proves key possession through TLS. The DMS validates it against admission CAs. The validator receives one leaf credential: configure and test the direct issuer for the simple case; sending more intermediates does not establish delivery to the service.",{"_3640":940,"_31229":929,"_21648":53976,"_5":14899,"_28426":53949,"_3090":53977},[],"Check dates, matching certificate/key and revocation before provisioning. A credential shared across equipment identifies that shared credential, not an individual device.",{"_3640":941,"_31229":929,"_21648":53979,"_5":14899,"_28426":53949,"_3090":53980},[],"Initial mTLS validation does not by itself compare bootstrap CN with the requested CSR CN. If a requester should only request its own `Device ID`, add a control binding credential to ID, such as the combined webhook, and test a request with another CN. Certificate re-enrollment does compare its CN to the CSR; subsequent checks use the registered active identity.",{"_3640":942,"_31229":929,"_21648":53982,"_5":14899,"_28426":53953,"_3090":53983},[],"Select the four modes independently for enrollment and re-enrollment in DMS. Renewal credentials depend on that block; do not assume the bootstrap is always used or the webhook disappears.",{"_3640":943,"_31229":929,"_21648":53985,"_5":14899,"_28426":53953,"_3090":53986},[],"An administrative OIDC token is not a native EST mode. A webhook may interpret an agreed credential header; that service then performs authorization. In NO\\_AUTH, sending a token does not add DMS authentication.",{"_3640":944,"_31229":929,"_21648":53988,"_5":14899,"_28426":53957,"_3090":53989},[],"The DMS sends operation context to the configured service. Method comes from configuration; agree the contract before selecting POST or PUT. Authorization wait defaults to 10 seconds, replaced by a configured positive timeout. The DMS verifies the receiver certificate unless `insecure_skip_verify` is enabled in the webhook config — verification is on by default — and does not follow redirects, so the configured URL must be the final one. The authorization response must be JSON of at most 1 MiB. With Lamassu-to-webhook authentication configured over `http://`, the API key or bearer token travels in cleartext, and mTLS has no effect because no TLS handshake takes place, so the client certificate is never presented; prefer `https://`. Configure those options in the webhook settings of the DMS guide.",{"_3640":945,"_31229":929,"_21648":53991,"_5":14899,"_28426":53957,"_3090":53992},[],"Example body:",{"_3640":946,"_31229":929,"_21648":53994,"_5":14899,"_28426":53957,"_3090":53995},[],"`csr` is **base64 of PEM**, unlike the EST body, which is base64 of DER. `http_request` contains URL and first header entries from available HTTP context. This body does not include an `operation` field; distinguish enroll and reenroll through the path and configured policy.",{"_3640":947,"_31229":929,"_21648":53997,"_5":14899,"_28426":53957,"_3090":53998},[],"The webhook should verify credential, its relationship to `device_cn`, DMS, operation and admission policy. Forwarded headers are not themselves trusted evidence. **Lamassu-to-webhook authentication** is a separate relationship configured in the server’s HTTP client.",{"_3640":948,"_31229":929,"_21648":54000,"_5":14899,"_28426":53957,"_3090":54001},[],"Continuation requires a successful HTTP response and JSON:",{"_3640":949,"_31229":929,"_21648":54003,"_5":14899,"_28426":53957,"_3090":54004},[],"A bodyless `204` does not satisfy the contract. Denial, transport error, uninterpretable response or timeout abort authorization. Combined mode validates the certificate first, then queries the webhook. See the webhook specification.",{"_3640":950,"_31229":929,"_21648":54006,"_5":14899,"_28426":53961,"_3090":54007},[],"The DMS first looks up the presented certificate in Lamassu; certificates it issued and manages are checked against their stored status. External certificates are checked through their OCSP servers and then their CRL distribution points. By default, unverifiable revocation is a rejection, not an acceptance: a certificate that is not managed by Lamassu and lists no OCSP or CRL endpoint is rejected unless `allow_unverifiable_revocation` is set in that operation's block (see Authentication per operation).",{"_3640":951,"_31229":929,"_21648":54009,"_5":14899,"_28426":53961,"_3090":54010},[],"A certificate that does list endpoints is held to a stricter standard, with or without the option: unreachable endpoints, stale or invalid evidence, or an inconclusive (unknown) status reject the certificate. The evidence must be fresh — `thisUpdate` not in the future, `nextUpdate` not passed, and an answer without `nextUpdate` accepted only while it is less than about 24 hours old — and OCSP responses must be signed by the certificate's issuer itself or by a delegated responder that carries the `id-kp-OCSPSigning` EKU and is within its validity. A revoked verdict is honored regardless of its age. Each OCSP or CRL request has a 10-second timeout.",{"_3640":952,"_31229":929,"_21648":54012,"_5":14899,"_28426":53961,"_3090":54013},[],"One caveat remains: a signed Good OCSP response or CRL captured before a revocation keeps validating until its `nextUpdate` (up to about 24 hours without `nextUpdate`). Revocation propagates to devices at the pace the responders publish evidence, not at the moment of revocation.",{"_3640":953,"_31229":929,"_21648":54015,"_5":14899,"_28426":53961,"_3090":54016},[],"Test an allowed certificate, an incorrect one, another CN, webhook denial, timeout and re-enrollment under its own policy. Keep results and schedule bootstrap credential retirement where appropriate. Continue with EST client.",{"_3640":954,"_31229":954,"_5":15259,"_3090":54018,"_31567":54019,"_21648":54020,"_28426":954},"Configure and operate the DMS",[51054,52582,53754,53752,53938],[],{"_3640":955,"_31229":954,"_21648":54022,"_5":14899,"_28426":954,"_3090":54023},[],"Define registration, authentication per operation, issuance, renewal and distributed trust.",{"_3640":956,"_31229":954,"_5":31564,"_21648":54025,"_28426":54026,"_3090":51064},[],"/docs/platform/iot-fleets/enrollment/dms#before-you-begin",{"_3640":957,"_31229":954,"_5":31564,"_21648":54028,"_28426":54029,"_3090":54030},[],"/docs/platform/iot-fleets/enrollment/dms#configure-a-dms","Configure a DMS",{"_3640":958,"_31229":954,"_5":31564,"_21648":54032,"_28426":54033,"_3090":54034},[],"/docs/platform/iot-fleets/enrollment/dms#identify-the-fleet","Identify the fleet",{"_3640":959,"_31229":954,"_5":31564,"_21648":54036,"_28426":54037,"_3090":54038},[],"/docs/platform/iot-fleets/enrollment/dms#select-the-enrollment-ca","Select the enrollment CA",{"_3640":960,"_31229":954,"_5":31564,"_21648":54040,"_28426":54041,"_3090":54042},[],"/docs/platform/iot-fleets/enrollment/dms#configure-est","Configure EST",{"_3640":961,"_31229":954,"_5":31564,"_21648":54044,"_28426":54045,"_3090":54046},[],"/docs/platform/iot-fleets/enrollment/dms#distribute-trust","Distribute trust",{"_3640":962,"_31229":954,"_5":31564,"_21648":54048,"_28426":54049,"_3090":54050},[],"/docs/platform/iot-fleets/enrollment/dms#verify-the-endpoints","Verify the endpoints",{"_3640":963,"_31229":954,"_5":31564,"_21648":54052,"_28426":54053,"_3090":54054},[],"/docs/platform/iot-fleets/enrollment/dms#enrollment-configuration","Enrollment configuration",{"_3640":964,"_31229":954,"_5":31564,"_21648":54056,"_28426":54057,"_3090":54058},[],"/docs/platform/iot-fleets/enrollment/dms#enrollment-device-registration","Enrollment Device Registration",{"_3640":965,"_31229":954,"_5":31564,"_21648":54060,"_28426":54061,"_3090":54062},[],"/docs/platform/iot-fleets/enrollment/dms#enrollment-settings","Enrollment Settings",{"_3640":966,"_31229":954,"_5":31564,"_21648":54064,"_28426":54065,"_3090":54066},[],"/docs/platform/iot-fleets/enrollment/dms#authentication-per-operation","Authentication per operation",{"_3640":967,"_31229":954,"_5":31564,"_21648":54068,"_28426":54069,"_3090":54070},[],"/docs/platform/iot-fleets/enrollment/dms#external-webhook-settings","External webhook settings",{"_3640":968,"_31229":954,"_5":31564,"_21648":54072,"_28426":54073,"_3090":54074},[],"/docs/platform/iot-fleets/enrollment/dms#issuance-profile","Issuance profile",{"_3640":969,"_31229":954,"_5":31564,"_21648":54076,"_28426":54077,"_3090":54078},[],"/docs/platform/iot-fleets/enrollment/dms#re-enrollment-configuration","Re-enrollment configuration",{"_3640":970,"_31229":954,"_5":31564,"_21648":54080,"_28426":54081,"_3090":54082},[],"/docs/platform/iot-fleets/enrollment/dms#serverkeygen","ServerKeyGen",{"_3640":971,"_31229":954,"_5":31564,"_21648":54084,"_28426":54085,"_3090":54086},[],"/docs/platform/iot-fleets/enrollment/dms#trust-distribution","Trust distribution",{"_3640":972,"_31229":954,"_5":31564,"_21648":54088,"_28426":54089,"_3090":54090},[],"/docs/platform/iot-fleets/enrollment/dms#operate-the-dms-inventory","Operate the DMS inventory",{"_3640":973,"_31229":954,"_5":31564,"_21648":54092,"_28426":54093,"_3090":54094},[],"/docs/platform/iot-fleets/enrollment/dms#integrate-the-devices","Integrate the devices",{"_3640":974,"_31229":954,"_21648":54096,"_5":14899,"_28426":954,"_3090":54097},[],"A &#x2A;*Device Management Service (DMS)** configures admission and identity lifecycle for its devices. It acts as a registration authority; the CA selected in `Enrollment CA` signs certificates. This guide is for the policy administrator.",{"_3640":975,"_31229":954,"_21648":54099,"_5":14899,"_28426":54026,"_3090":54100},[],"You need DMS management permissions, an active CA with a usable key and a tested issuance profile. Agree device ID, initial credential, consumer and renewal window with the integrator. Review Provisioning strategies before choosing registration and replacement.",{"_3640":976,"_31229":954,"_21648":54102,"_5":14899,"_28426":54026,"_3090":54103},[],"Prepare EST server trust and device connectivity through Deployment. Your operator’s administrative authentication does not replace device EST authentication.",{"_3640":977,"_31229":954,"_21648":54105,"_5":14899,"_28426":54033,"_3090":54106},[],"Create the DMS with a recognizable name and retain its ID. EST URLs use this identifier, not the display name. Each device retains one owning DMS.",{"_3640":978,"_31229":954,"_21648":54108,"_5":14899,"_28426":54037,"_3090":54109},[],"Choose **Enrollment CA** and an explicit profile appropriate for the end-entity identity. Keep CN compatible with `Device ID`. The test certificate should allow its intended purpose and expire within issuer validity.",{"_3640":979,"_31229":954,"_21648":54111,"_5":14899,"_28426":54041,"_3090":54112},[],"Select initial enrollment registration and authentication. Separately configure re-enrollment authentication, thresholds and previous certificate retirement. Leave ServerKeyGen disabled if the client generates its key.",{"_3640":980,"_31229":954,"_21648":54114,"_5":14899,"_28426":54045,"_3090":54115},[],"Select certificates returned by `/cacerts`. Explicitly include required intermediates and roots, keeping distribution distinct from automatic trust installation.",{"_3640":981,"_31229":954,"_21648":54117,"_5":14899,"_28426":54049,"_3090":54118},[],"Save and read configuration again. Query `/cacerts`, perform an allowed and a rejected enrollment, and inspect device, serial and history. Creating the DMS or downloading cacerts does not establish working authentication and issuance.",{"_3640":982,"_31229":954,"_21648":54120,"_5":14899,"_28426":54057,"_3090":54121},[],"`settings.enrollment_settings.registration_mode` accepts `JITP` or `PRE_REGISTRATION`. JITP creates an unknown device with the CSR CN as ID and the DMS as owner. `device_provisioning_profile` supplies tags, metadata and icon for that registration.",{"_3640":983,"_31229":954,"_21648":54123,"_5":14899,"_28426":54057,"_3090":54124},[],"PRE\\_REGISTRATION requires an existing ID. An existing device encounters replacement checks first, even without an identity. Review preregistration conditions before using this mode.",{"_3640":984,"_31229":954,"_21648":54126,"_5":14899,"_28426":54061,"_3090":54127},[],"`settings.enrollment_settings` field",{"_3640":985,"_31229":954,"_21648":54129,"_5":14899,"_28426":54061,"_3090":54130},[],"Decision",{"_3640":986,"_31229":954,"_21648":54132,"_5":14899,"_28426":54061,"_3090":54133},[],"`protocol`",{"_3640":987,"_31229":954,"_21648":54135,"_5":14899,"_28426":54061,"_3090":54136},[],"`EST_RFC7030` for these operations.",{"_3640":988,"_31229":954,"_21648":54138,"_5":14899,"_28426":54061,"_3090":54139},[],"`enrollment_ca`",{"_3640":989,"_31229":954,"_21648":54141,"_5":14899,"_28426":54061,"_3090":54142},[],"ID of the signing CA.",{"_3640":990,"_31229":954,"_21648":54144,"_5":14899,"_28426":54061,"_3090":54145},[],"`verify_csr_signature`",{"_3640":991,"_31229":954,"_21648":54147,"_5":14899,"_28426":54061,"_3090":54148},[],"Keep `true` to verify CSR key possession.",{"_3640":992,"_31229":954,"_21648":54150,"_5":14899,"_28426":54061,"_3090":54151},[],"`enable_replaceable_enrollment`",{"_3640":993,"_31229":954,"_21648":54153,"_5":14899,"_28426":54061,"_3090":54154},[],"Allows `/simpleenroll` for an existing ID in the same DMS. It can attempt previous certificate revocation even if a later phase fails; this is not atomic.",{"_3640":994,"_31229":954,"_21648":54156,"_5":14899,"_28426":54061,"_3090":54157},[],"`est_rfc7030_settings.auth_mode`",{"_3640":995,"_31229":954,"_21648":54159,"_5":14899,"_28426":54061,"_3090":54160},[],"One of the four authentication modes.",{"_3640":996,"_31229":954,"_21648":54162,"_5":14899,"_28426":54061,"_3090":54163},[],"Initial enrollment rejects an ID owned by another DMS. Do not automatically enable replacement in response to an error; Troubleshooting distinguishes repeated IDs, ownership and partial changes.",{"_3640":997,"_31229":954,"_21648":54165,"_5":14899,"_28426":54065,"_3090":54166},[],"The blocks are independent:",{"_3640":998,"_31229":954,"_21648":54168,"_5":14899,"_28426":54065,"_3090":54169},[],"`settings.enrollment_settings.est_rfc7030_settings` for `/simpleenroll` and `/serverkeygen`.",{"_3640":999,"_31229":954,"_21648":54171,"_5":14899,"_28426":54065,"_3090":54172},[],"`settings.reenrollment_settings.est_rfc7030_settings` for `/simplereenroll`.",{"_3640":1000,"_31229":954,"_21648":54174,"_5":14899,"_28426":54065,"_3090":54175},[],"`auth_mode`",{"_3640":1001,"_31229":954,"_21648":54177,"_5":14899,"_28426":54065,"_3090":54178},[],"Control applied in the configured operation",{"_3640":1002,"_31229":954,"_21648":54180,"_5":14899,"_28426":54065,"_3090":54181},[],"`CLIENT_CERTIFICATE`",{"_3640":1003,"_31229":954,"_21648":54183,"_5":14899,"_28426":54065,"_3090":54184},[],"Presented certificate validation.",{"_3640":1004,"_31229":954,"_21648":54186,"_5":14899,"_28426":54065,"_3090":54187},[],"`EXTERNAL_WEBHOOK`",{"_3640":1005,"_31229":954,"_21648":54189,"_5":14899,"_28426":54065,"_3090":54190},[],"Configured webhook authorization.",{"_3640":1006,"_31229":954,"_21648":54192,"_5":14899,"_28426":54065,"_3090":54193},[],"`CLIENT_CERTIFICATE_AND_EXTERNAL_WEBHOOK`",{"_3640":1007,"_31229":954,"_21648":54195,"_5":14899,"_28426":54065,"_3090":54196},[],"Certificate validation followed by webhook approval.",{"_3640":1008,"_31229":954,"_21648":54198,"_5":14899,"_28426":54065,"_3090":54199},[],"`NO_AUTH`",{"_3640":1009,"_31229":954,"_21648":54201,"_5":14899,"_28426":54065,"_3090":54202},[],"No DMS requester authentication.",{"_3640":1010,"_31229":954,"_21648":54204,"_5":14899,"_28426":54065,"_3090":54205},[],"Webhook and combined modes also execute during re-enrollment when configured in its block. They do not implicitly degrade to NO\\_AUTH. An absent or unrecognized mode fails.",{"_3640":1011,"_31229":954,"_21648":54207,"_5":14899,"_28426":54065,"_3090":54208},[],"For initial mTLS, `client_certificate_settings` contains `validation_cas`, `allow_expired`, `chain_level_validation` and `allow_unverifiable_revocation`. The validator receives one certificate credential; the flow does not guarantee forwarding every handshake intermediate to it. For a direct case, configure the bootstrap’s direct issuer as validation CA and test the actual Gateway path.",{"_3640":1012,"_31229":954,"_21648":54210,"_5":14899,"_28426":54065,"_3090":54211},[],"The authentication editor offers an **Allow certificates without revocation information** switch (`allow_unverifiable_revocation`, off by default). When it is on, certificates — and intermediate CAs of the chain — that Lamassu does not manage and that list no OCSP or CRL endpoint are accepted; unreachable, stale or inconclusive revocation answers are always rejected. While the switch is on, the console shows an amber warning: **Revocation will not be verified** — a revoked certificate with no OCSP or CRL endpoint, and not managed by Lamassu, will be accepted, and this also applies to the intermediate CAs of the chain.",{"_3640":1013,"_31229":954,"_21648":54213,"_5":14899,"_28426":54065,"_3090":54214},[],"The same switch is offered in both the enrollment and re-enrollment authentication editors and is stored per block inside `est_rfc7030_settings.client_certificate_settings`; a DMS stored before this field existed loads with the switch off. The console also shows an amber warning alert whenever an authentication option is in its insecure state — **Allow expired certificates** on, **Allow expired renewal** on or **Verify CSR signature** off — and the No authentication note is presented as a warning alert too.",{"_3640":1014,"_31229":954,"_21648":54216,"_5":14899,"_28426":54065,"_3090":54217},[],"Revocation is checked for every presented certificate. In initial enrollment the client certificate **and** every intermediate CA between it and the validation CA are checked, each against its issuer; extra certificates the device sends in the handshake are ignored. A validation CA that is revoked in Lamassu rejects the operation: the first validation CA that validates the certificate is used, and a revoked one is not replaced by the remaining validation CAs. Certificates issued and managed by Lamassu are checked against their stored status. External certificates are checked through their OCSP and CRL endpoints, and the operation fails closed when revocation cannot be verified: only `allow_unverifiable_revocation` — `false` by default in both blocks — relaxes the case of an external certificate that lists no endpoint at all. Endpoints that exist but are unreachable, return stale or invalid evidence, or report an inconclusive status are always rejected, whatever the option says. The details and the evidence the endpoints must present are in Revocation and checks.",{"_3640":1015,"_31229":954,"_21648":54219,"_5":14899,"_28426":54065,"_3090":54220},[],"For certificate re-enrollment, the validator tries the enrollment CA first and then the CAs listed in `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`; those are the re-enrollment validation CAs. That list is optional because the enrollment CA is always trusted for re-enrollment, and each settings block consults only its own `validation_cas`. CAs listed only in the initial block's `validation_cas` do not extend re-enrollment acceptance; during a CA rotation, add the old issuance CA to the re-enrollment block's list. The re-enrollment validator compares the presented TLS leaf against those CAs; the re-enrollment block's `chain_level_validation` and `allow_expired` values are stored but not consulted, and expiry is governed by `enable_expired_renewal`. Re-enrollment checks revocation of the client certificate only; that check is governed by the re-enrollment block's own `allow_unverifiable_revocation`.",{"_3640":1016,"_31229":954,"_21648":54222,"_5":14899,"_28426":54065,"_3090":54223},[],"For a webhook, configure destination, Lamassu-to-service authentication, method and timeout. The authentication contract explains the device credential and request body. `NO_AUTH` does not establish ownership of the requested ID.",{"_3640":1017,"_31229":954,"_21648":54225,"_5":14899,"_28426":54069,"_3090":54226},[],"The webhook authentication modes read `external_webhook_settings` in the same `est_rfc7030_settings` block:",{"_3640":1018,"_31229":954,"_21648":54228,"_5":14899,"_28426":54069,"_3090":54229},[],"`external_webhook_settings` field",{"_3640":1019,"_31229":954,"_21648":54231,"_5":14899,"_28426":54069,"_3090":54130},[],{"_3640":1020,"_31229":954,"_21648":54233,"_5":14899,"_28426":54069,"_3090":54234},[],"`url`",{"_3640":1021,"_31229":954,"_21648":54236,"_5":14899,"_28426":54069,"_3090":54237},[],"Absolute `http` or `https` URL of the receiver. It must be the final URL; redirects are not followed.",{"_3640":1022,"_31229":954,"_21648":54239,"_5":14899,"_28426":54069,"_3090":54240},[],"`method`",{"_3640":1023,"_31229":954,"_21648":54242,"_5":14899,"_28426":54069,"_3090":54243},[],"`POST` or `PUT`; `POST` by default.",{"_3640":1024,"_31229":954,"_21648":54245,"_5":14899,"_28426":54069,"_3090":54246},[],"`name`",{"_3640":1025,"_31229":954,"_21648":54248,"_5":14899,"_28426":54069,"_3090":54249},[],"Label used in service logs.",{"_3640":1026,"_31229":954,"_21648":54251,"_5":14899,"_28426":54069,"_3090":54252},[],"`config.auth_mode`",{"_3640":1027,"_31229":954,"_21648":54254,"_5":14899,"_28426":54069,"_3090":54255},[],"`noauth`, `apikey`, `jwt` or `mtls`. An absent or unknown value behaves as `noauth`.",{"_3640":1028,"_31229":954,"_21648":54257,"_5":14899,"_28426":54069,"_3090":54258},[],"`config.log_level`",{"_3640":1029,"_31229":954,"_21648":54260,"_5":14899,"_28426":54069,"_3090":54261},[],"Log level of the webhook call: `debug`, `info`, `warn` or `error`; `info` by default.",{"_3640":1030,"_31229":954,"_21648":54263,"_5":14899,"_28426":54069,"_3090":54264},[],"`config.apikey_options`",{"_3640":1031,"_31229":954,"_21648":54266,"_5":14899,"_28426":54069,"_3090":54267},[],"Required for `apikey`: `header` and `key`. Reserved header names are rejected.",{"_3640":1032,"_31229":954,"_21648":54269,"_5":14899,"_28426":54069,"_3090":54270},[],"`config.jwt_options`",{"_3640":1033,"_31229":954,"_21648":54272,"_5":14899,"_28426":54069,"_3090":54273},[],"Required for `jwt`: `oidc_client_id`, `oidc_client_secret` and an absolute `http` or `https` `oidc_well_known`.",{"_3640":1034,"_31229":954,"_21648":54275,"_5":14899,"_28426":54069,"_3090":54276},[],"`config.mtls_options`",{"_3640":1035,"_31229":954,"_21648":54278,"_5":14899,"_28426":54069,"_3090":54279},[],"Required for `mtls`: `cert_content` and `key_content` as Base64-encoded PEM, like certificates elsewhere in the API; plain PEM is also accepted.",{"_3640":1036,"_31229":954,"_21648":54281,"_5":14899,"_28426":54069,"_3090":54282},[],"`config.insecure_skip_verify`",{"_3640":1037,"_31229":954,"_21648":54284,"_5":14899,"_28426":54069,"_3090":54285},[],"Skips verification of the receiver certificate when `true`. Verification is on by default. Unlike alert channels, this flag is honored here.",{"_3640":1038,"_31229":954,"_21648":54287,"_5":14899,"_28426":54069,"_3090":54288},[],"`config.call_timeout`",{"_3640":1039,"_31229":954,"_21648":54290,"_5":14899,"_28426":54069,"_3090":54291},[],"Maximum duration of the authorization call (for example `10s`); 10 seconds by default.",{"_3640":1040,"_31229":954,"_21648":54293,"_5":14899,"_28426":54069,"_3090":54294},[],"Rules for that configuration:",{"_3640":1041,"_31229":954,"_21648":54296,"_5":14899,"_28426":54069,"_3090":54297},[],"Creating or updating a DMS whose enrollment or reenrollment `auth_mode` uses the webhook validates the block and returns HTTP 400 — the body starts with `struct validation error:` and continues with `invalid enrollment external webhook config` or `invalid reenrollment external webhook config` — when the URL, method or options are invalid. That includes an `mtls_options.cert_content`/`key_content` pair that does not decode to a matching certificate and private key. File references (`ca_cert_file`, `mtls_options.cert_file`, `mtls_options.key_file`) are always invalid: the service does not read files, so enter the certificate and key as Base64-encoded PEM in `mtls_options.cert_content` and `key_content`, or as plain PEM.",{"_3640":1042,"_31229":954,"_21648":54299,"_5":14899,"_28426":54069,"_3090":54300},[],"A custom `apikey_options.header` may not use names that the platform or the receiving service trusts — for example `X-Principal-Id`, `X-Request-Id`, `Host`, `Content-Type` or `Forwarded` — and no name may start with `X-Forwarded-`, `X-Envoy-` or `X-Lms-` (case-insensitive). The DMS API reference documents the `WebhookCall` and `WebhookCallHttpClient` schemas and that reserved API-key headers are rejected.",{"_3640":1043,"_31229":954,"_21648":54302,"_5":14899,"_28426":54069,"_3090":54303},[],"The nested `http_client` key exists only in alert channel configurations; in a DMS body it is ignored. The DMS key is `external_webhook_settings.config`.",{"_3640":1044,"_31229":954,"_21648":54305,"_5":14899,"_28426":54069,"_3090":54306},[],"A body with `config.auth_mode` set to `apikey`, `jwt` or `mtls` must carry its corresponding option block (`apikey_options`, `jwt_options` or `mtls_options`) — and nothing else. Bodies with those auth modes carrying only `apikey`, `oidc` or `mtls` fail validation with 400, and `validate_server_cert` is always ignored: use `insecure_skip_verify`. Only bodies without option blocks are accepted as `noauth`, and their credentials are dropped.",{"_3640":1045,"_31229":954,"_21648":54308,"_5":14899,"_28426":54069,"_3090":54309},[],"The authorization response must be JSON of at most 1 MiB; a larger body fails the call.",{"_3640":1046,"_31229":954,"_21648":54311,"_5":14899,"_28426":54069,"_3090":54312},[],"With credentials configured, they are sent regardless of the URL scheme: an `http://` webhook receives the API key or bearer token in cleartext, and mTLS has no effect because no TLS handshake takes place, so the client certificate is never presented. Prefer `https://` for `url`, `oidc_well_known` and the token endpoint it advertises.",{"_3640":1047,"_31229":954,"_21648":54314,"_5":14899,"_28426":54069,"_3090":54315},[],"Initial authentication and renewal settings are stored independently. If a DMS only has the initial authentication block, renewal reuses it: read both blocks before editing. The console exposes independent editors for the enrollment and re-enrollment authentication, with the same Log Level, Call Timeout, HTTP Authentication and credential fields as the webhook channels, plus a **Skip TLS Verification** switch (off by default, so verification stays on; the console warns when you enable it).",{"_3640":1048,"_31229":954,"_21648":54317,"_5":14899,"_28426":54069,"_3090":54318},[],"Webhook credentials must be stored as PEM content. File references (`ca_cert_file`, `mtls_options.cert_file`, `mtls_options.key_file`) are never valid in a stored webhook config: delivery rejects any webhook config that references files, whatever its auth mode, so every enroll and reenroll that calls that webhook fails until the certificate and key are entered as Base64-encoded or plain PEM in `mtls_options.cert_content` and `key_content`, or the file fields are removed if the webhook does not use mTLS. If a stored config holds file paths in `mtls_options.cert_content` or `key_content`, every full settings update (`POST /v1/dms`, `PUT /v1/dms/:id`) fails validation — settings are replaced wholesale, so the stored config must be resent — until the values are replaced by PEM content or the webhook stops being used. Meanwhile, delivery of that webhook fails on every call; a metadata-only update through `PUT` or `PATCH` on `/v1/dms/:id/metadata` still succeeds. To fix it in the console, open the DMS, replace any file-path value with PEM content — the editor rejects file paths with an inline field error — and save. Saving rewrites `external_webhook_settings.config` with the current keys, and the console reads both plain and Base64-encoded PEM from migrated configurations and stores the material Base64-encoded. If your stored config previously relied on `validate_server_cert: false`, it now carries `insecure_skip_verify: true`: receiver-certificate verification stays skipped until you set that flag to `false`. See 3.8.0 to 4.0.0 for the upgrade notes and the operator checklist.",{"_3640":1049,"_31229":954,"_21648":54320,"_5":14899,"_28426":54069,"_3090":54321},[],"The re-enrollment trust set lives in `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`. The flat field `reenrollment_settings.additional_validation_cas` is not part of the API: bodies that carry it are accepted but the value is silently ignored — unknown JSON fields are dropped — and GET responses do not include it. Read the DMS before sending API edits: an update body built with that flat field silently empties `validation_cas`.",{"_3640":1050,"_31229":954,"_21648":54323,"_5":14899,"_28426":54073,"_3090":54324},[],"`settings.issuance_profile_id` takes precedence over `settings.issuance_profile`; without either, the CA default profile is used. The resolved profile — including the CA default used as fallback when the DMS defines none — must define an end-entity certificate: a `Sign as CA` profile is rejected at enrollment and re-enrollment time. Rules are documented once in Profiles. DMS changes affect future requests; they do not modify signed certificates or install client trust.",{"_3640":1051,"_31229":954,"_21648":54326,"_5":14899,"_28426":54077,"_3090":54327},[],"`settings.reenrollment_settings` field",{"_3640":1052,"_31229":954,"_21648":54329,"_5":14899,"_28426":54077,"_3090":51444},[],{"_3640":1053,"_31229":954,"_21648":54331,"_5":14899,"_28426":54077,"_3090":54332},[],"`reenrollment_delta`",{"_3640":1054,"_31229":954,"_21648":54334,"_5":14899,"_28426":54077,"_3090":54335},[],"Opens the window at the active certificate’s `NotAfter` minus this delta.",{"_3640":1055,"_31229":954,"_21648":54337,"_5":14899,"_28426":54077,"_3090":54338},[],"`preventive_delta`",{"_3640":1056,"_31229":954,"_21648":54340,"_5":14899,"_28426":54077,"_3090":54341},[],"Preventive operational monitoring threshold.",{"_3640":1057,"_31229":954,"_21648":54343,"_5":14899,"_28426":54077,"_3090":54344},[],"`critical_delta`",{"_3640":1058,"_31229":954,"_21648":54346,"_5":14899,"_28426":54077,"_3090":54347},[],"Critical operational monitoring threshold.",{"_3640":1059,"_31229":954,"_21648":54349,"_5":14899,"_28426":54077,"_3090":54350},[],"`enable_expired_renewal`",{"_3640":1060,"_31229":954,"_21648":54352,"_5":14899,"_28426":54077,"_3090":54353},[],"Accepts an expired presented certificate in the renewal mTLS validator. Does not authorize another mode or remove Gateway constraints by itself.",{"_3640":1061,"_31229":954,"_21648":54355,"_5":14899,"_28426":54077,"_3090":54356},[],"`est_rfc7030_settings.client_certificate_settings.validation_cas`",{"_3640":1062,"_31229":954,"_21648":54358,"_5":14899,"_28426":54077,"_3090":54359},[],"Re-enrollment validation CAs for the renewal mTLS credential, tried after the enrollment CA; optional, because the enrollment CA is always trusted. Typically populated during CA rotation while old-CA cohorts renew.",{"_3640":1063,"_31229":954,"_21648":54361,"_5":14899,"_28426":54077,"_3090":54362},[],"`revoke_on_reenrollment`",{"_3640":1064,"_31229":954,"_21648":54364,"_5":14899,"_28426":54077,"_3090":54365},[],"If the previous certificate is ACTIVE, attempts Superseded revocation before binding its successor.",{"_3640":1065,"_31229":954,"_21648":54367,"_5":14899,"_28426":54077,"_3090":54368},[],"Monitoring does not renew: the client must schedule the request and installation. Webhook and NO\\_AUTH modes do not use the same mTLS expired-credential validator; the webhook must explicitly authorize permitted recovery. Review Renewal and recovery for operation order and partial failures.",{"_3640":1066,"_31229":954,"_21648":54370,"_5":14899,"_28426":54081,"_3090":54371},[],"`settings.server_keygen_settings.enabled` enables software key generation on the server. The console exposes it through an **Enable server-side key generation** switch and a **Key type** selection: `ECDSA` P-256, P-384 or P-521, or `RSA` with 2048, 3072 or 4096 bits; the defaults are P-256 for `ECDSA` and 4096 bit for `RSA`. Algorithm and size come from its `key` field, stored as `{type,bits}` where P-256, P-384 and P-521 map to `bits` 256, 384 and 521; `key` is omitted when disabled. The profile must permit them. The response contains an unencrypted PKCS#8 key inside TLS alongside the certificate. See format and extraction in EST reference.",{"_3640":1067,"_31229":954,"_21648":54373,"_5":14899,"_28426":54085,"_3090":51438},[],{"_3640":1068,"_31229":954,"_21648":54375,"_5":14899,"_28426":54085,"_3090":54376},[],"Published material",{"_3640":1069,"_31229":954,"_21648":54378,"_5":14899,"_28426":54085,"_3090":54379},[],"**Include Lamassu System CA**",{"_3640":1070,"_31229":954,"_21648":54381,"_5":14899,"_28426":54085,"_3090":54382},[],"Available downstream TLS certificate; it can be a leaf, not an issuing CA.",{"_3640":1071,"_31229":954,"_21648":54384,"_5":14899,"_28426":54085,"_3090":54385},[],"**Include Enrollment CA**",{"_3640":1072,"_31229":954,"_21648":54387,"_5":14899,"_28426":54085,"_3090":54388},[],"Selected issuing CA certificate.",{"_3640":1073,"_31229":954,"_21648":54390,"_5":14899,"_28426":54085,"_3090":54391},[],"**Managed CAs**",{"_3640":1074,"_31229":954,"_21648":54393,"_5":14899,"_28426":54085,"_3090":54394},[],"Explicitly selected CA certificates.",{"_3640":1075,"_31229":954,"_21648":54396,"_5":14899,"_28426":54085,"_3090":54397},[],"All ancestors are not added automatically. Trust distribution distinguishes trusted roots, intermediates and initial server trust.",{"_3640":1076,"_31229":954,"_21648":54399,"_5":14899,"_28426":54089,"_3090":54400},[],"**Edit** changes name, settings and metadata. Updates go through the DMS API. `PUT /v1/dms/{id}` always targets the DMS identified by the URL path: the body carries no `id` field, and any `id` or `creation_ts` in it is silently ignored — authorization is evaluated against the same URL identifier. The body must include a non-empty `name` and a `settings` object; missing either returns HTTP 400 and leaves the stored DMS unchanged. `name` and `settings` are always full replacements, so read the DMS before sending API edits to avoid losing fields. `metadata` is optional: omitting it or sending `null` keeps the stored metadata, a supplied object replaces it entirely, and `{}` clears it (a later GET returns an empty object, not `null`). Old-style bodies that carry the full DMS object keep working while they include `name` and `settings`; unknown fields are ignored. Updates reject an empty `name` with HTTP 400: a DMS whose stored name was zeroed by an earlier update must be renamed before any client round-trips it — the AWS IoT connector’s JITP writeback included. If the object does not include the AWS IoT connector key (`lamassu.io/iot/{connector_id}`), the connector ignores the DMS's later events.",{"_3640":1077,"_31229":954,"_21648":54402,"_5":14899,"_28426":54089,"_3090":54403},[],"**Go to DMS owned devices** restricts inventory by owner. **Show/Edit Metadata** contains operational and integration data; consult the integration guide before changing it. &#x2A;*EST (RFC-7030)** helps locate URLs.",{"_3640":1078,"_31229":954,"_21648":54405,"_5":14899,"_28426":54089,"_3090":54406},[],"**Delete** removes the DMS record and configuration; it does not itself cascade revocation across every device and certificate. Migrate dependencies and retain audit references before retirement.",{"_3640":1079,"_31229":954,"_21648":54408,"_5":14899,"_28426":54093,"_3090":54409},[],"Continue with EST client or the enrollment and mTLS tutorial. EST reference covers formats; Troubleshooting covers failures.",{"_3640":1080,"_31229":1080,"_5":15259,"_3090":54411,"_31567":54412,"_21648":54413,"_28426":1080},"Integrate the EST client",[51054,52582,53754,53752,53938],[],{"_3640":1081,"_31229":1080,"_21648":54415,"_5":14899,"_28426":1080,"_3090":54416},[],"Prepare trust, send a CSR and check the identity you receive.",{"_3640":1082,"_31229":1080,"_5":31564,"_21648":54418,"_28426":54419,"_3090":51064},[],"/docs/platform/iot-fleets/enrollment/est-client#before-you-begin",{"_3640":1083,"_31229":1080,"_5":31564,"_21648":54421,"_28426":54422,"_3090":54423},[],"/docs/platform/iot-fleets/enrollment/est-client#download-and-inspect-cacerts","Download and inspect cacerts",{"_3640":1084,"_31229":1080,"_5":31564,"_21648":54425,"_28426":54426,"_3090":54427},[],"/docs/platform/iot-fleets/enrollment/est-client#prepare-the-csr","Prepare the CSR",{"_3640":1085,"_31229":1080,"_5":31564,"_21648":54429,"_28426":54430,"_3090":54431},[],"/docs/platform/iot-fleets/enrollment/est-client#request-the-identity","Request the identity",{"_3640":1086,"_31229":1080,"_5":31564,"_21648":54433,"_28426":54434,"_3090":54435},[],"/docs/platform/iot-fleets/enrollment/est-client#check-and-install-the-result","Check and install the result",{"_3640":1087,"_31229":1080,"_5":31564,"_21648":54437,"_28426":54438,"_3090":54439},[],"/docs/platform/iot-fleets/enrollment/est-client#next-steps","Next steps",{"_3640":1088,"_31229":1080,"_21648":54441,"_5":14899,"_28426":1080,"_3090":54442},[],"This guide is for those implementing the device client. The administrator must have prepared the DMS policy. For a complete first run, follow Enroll and connect your first device.",{"_3640":1089,"_31229":1080,"_21648":54444,"_5":14899,"_28426":54419,"_3090":54445},[],"You need the public HTTPS DMS URL, server trust obtained through an approved channel, the operation's authentication mode and an admitted identifier. The examples use Bash, OpenSSL 3.x and curl with `--fail-with-body`; use a private working directory and compatible versions of these tools.",{"_3640":1090,"_31229":1080,"_21648":54447,"_5":14899,"_28426":54419,"_3090":54448},[],"Prepare `est-trust.pem` to verify the EST server, `bootstrap.crt` and `bootstrap.key` for initial certificate authentication, and `device-root.pem` as the approved root of the device issuer. The two trust files can contain different roots. For another authentication mode, adapt the credentials according to Bootstrap identity.",{"_3640":1091,"_31229":1080,"_21648":54450,"_5":14899,"_28426":54419,"_3090":54451},[],"Replace the host and `REPLACE_DMS_ID` with those of your installation. The URL's APS is the DMS identifier, not its display name.",{"_3640":1092,"_31229":1080,"_21648":54453,"_5":14899,"_28426":54422,"_3090":54454},[],"The default content is Base64-encoded DER PKCS#7. It is not a direct PEM file.",{"_3640":1093,"_31229":1080,"_21648":54456,"_5":14899,"_28426":54422,"_3090":54457},[],"Check fingerprints, issuers and dates against the trust distribution policy. The response can contain a selection of CAs and Lamassu's TLS certificate. Do not turn the entire bundle into trusted roots or use it to authenticate its own initial download. HTTP 200 here does not prove that authentication or issuance works.",{"_3640":1094,"_31229":1080,"_21648":54459,"_5":14899,"_28426":54426,"_3090":54460},[],"The example generates a new EC P-256 key and uses `est-device-001`, which must be available if the DMS registers automatically. The `Common Name` becomes the device identifier. Check that the profile permits the selected key and subject.",{"_3640":1095,"_31229":1080,"_21648":54462,"_5":14899,"_28426":54426,"_3090":54463},[],"An implementation using hardware or its own store must produce the CSR through its resident key. `simpleenroll` sends the request and retains the key in the client. Honor Extensions does not authorize every requested attribute: see Profiles.",{"_3640":1096,"_31229":1080,"_21648":54465,"_5":14899,"_28426":54430,"_3090":54466},[],"With initial `CLIENT_CERTIFICATE` authentication, send the Base64-encoded DER CSR using `Content-Type: application/pkcs10`:",{"_3640":1097,"_31229":1080,"_21648":54468,"_5":14899,"_28426":54430,"_3090":54469},[],"Stop if curl fails. Retain the HTTP code, headers and body for diagnosis; an error response is not decoded as a certificate. The Bash example stops before that conversion. A timeout leaves the operation's result to be checked in Lamassu: do not automatically repeat issuance.",{"_3640":1098,"_31229":1080,"_21648":54471,"_5":14899,"_28426":54434,"_3090":54472},[],"For a root that issues directly:",{"_3640":1099,"_31229":1080,"_21648":54474,"_5":14899,"_28426":54434,"_3090":54475},[],"Also verify that the CN is correct, the certificate is a leaf, its uses permit your application and its dates satisfy the profile. `cmp` must exit with code 0. With intermediates, provide the chain through `-untrusted` as described in PKI validation.",{"_3640":1100,"_31229":1080,"_21648":54477,"_5":14899,"_28426":54434,"_3090":54478},[],"Query the device: the owning DMS, current serial number and history must match the result. Protect the key/certificate pair and install both using the device's mechanism. Association in Lamassu does not install files in the client. Check a real connection before considering the process complete.",{"_3640":1101,"_31229":1080,"_21648":54480,"_5":14899,"_28426":54438,"_3090":54481},[],"Implement renewal and recovery and trust updates. The EST reference covers endpoints, formats and ServerKeyGen; troubleshooting helps distinguish transport, admission and persistence failures.",{"_3640":1102,"_31229":1102,"_5":15259,"_3090":54483,"_31567":54484,"_21648":54485,"_28426":1102},"EST reference",[51054,52582,53754,53752,53938],[],{"_3640":1103,"_31229":1102,"_21648":54487,"_5":14899,"_28426":1102,"_3090":54488},[],"Look up Lamassu routes, formats, authentication and multipart responses.",{"_3640":1104,"_31229":1102,"_5":31564,"_21648":54490,"_28426":54491,"_3090":54492},[],"/docs/platform/iot-fleets/enrollment/est-reference#endpoint-reference","Endpoint reference",{"_3640":1105,"_31229":1102,"_5":31564,"_21648":54494,"_28426":54495,"_3090":23451},[],"/docs/platform/iot-fleets/enrollment/est-reference#cacerts",{"_3640":1106,"_31229":1102,"_5":31564,"_21648":54497,"_28426":54498,"_3090":26966},[],"/docs/platform/iot-fleets/enrollment/est-reference#simpleenroll",{"_3640":1107,"_31229":1102,"_5":31564,"_21648":54500,"_28426":54501,"_3090":26973},[],"/docs/platform/iot-fleets/enrollment/est-reference#simplereenroll",{"_3640":1108,"_31229":1102,"_5":31564,"_21648":54503,"_28426":54504,"_3090":26235},[],"/docs/platform/iot-fleets/enrollment/est-reference#serverkeygen",{"_3640":1109,"_31229":1102,"_5":31564,"_21648":54506,"_28426":54507,"_3090":54508},[],"/docs/platform/iot-fleets/enrollment/est-reference#response-format","Response format",{"_3640":1110,"_31229":1102,"_5":31564,"_21648":54510,"_28426":54511,"_3090":54512},[],"/docs/platform/iot-fleets/enrollment/est-reference#request-and-extraction","Request and extraction",{"_3640":1111,"_31229":1102,"_5":31564,"_21648":54514,"_28426":54515,"_3090":54516},[],"/docs/platform/iot-fleets/enrollment/est-reference#compatibility-notes","Compatibility notes",{"_3640":1112,"_31229":1102,"_21648":54518,"_5":14899,"_28426":1102,"_3090":54519},[],"Reference for the Lamassu EST service, based on RFC 7030. Use EST client for the procedure and DMS to configure policy.",{"_3640":1113,"_31229":1102,"_21648":54521,"_5":14899,"_28426":54491,"_3090":54522},[],"Public route in the examples: `/.well-known/est/{APS}/{operation}`. `APS` is the DMS ID. The router admits routes without that segment, but the controller requires it; do not use them as a default service. Gateway configuration determines the public host and route.",{"_3640":1114,"_31229":1102,"_21648":54524,"_5":14899,"_28426":54491,"_3090":54525},[],"Operation",{"_3640":1115,"_31229":1102,"_21648":54527,"_5":14899,"_28426":54491,"_3090":54528},[],"Method",{"_3640":1116,"_31229":1102,"_21648":54530,"_5":14899,"_28426":54491,"_3090":54531},[],"Authentication and condition",{"_3640":1117,"_31229":1102,"_21648":54533,"_5":14899,"_28426":54491,"_3090":54534},[],"`/cacerts`",{"_3640":1118,"_31229":1102,"_21648":54536,"_5":14899,"_28426":54491,"_3090":54537},[],"GET",{"_3640":1119,"_31229":1102,"_21648":54539,"_5":14899,"_28426":54491,"_3090":54540},[],"DMS reading does not require an EST credential; HTTPS and infrastructure controls still apply.",{"_3640":1120,"_31229":1102,"_21648":54542,"_5":14899,"_28426":54491,"_3090":54543},[],"`/simpleenroll`",{"_3640":1121,"_31229":1102,"_21648":54545,"_5":14899,"_28426":54491,"_3090":54546},[],"POST",{"_3640":1122,"_31229":1102,"_21648":54548,"_5":14899,"_28426":54491,"_3090":54549},[],"Initial authentication and DMS registration/replacement policy.",{"_3640":1123,"_31229":1102,"_21648":54551,"_5":14899,"_28426":54491,"_3090":54552},[],"`/simplereenroll`",{"_3640":1124,"_31229":1102,"_21648":54554,"_5":14899,"_28426":54491,"_3090":54546},[],{"_3640":1125,"_31229":1102,"_21648":54556,"_5":14899,"_28426":54491,"_3090":54557},[],"Renewal authentication, existing identity, subject, revocation and window.",{"_3640":1126,"_31229":1102,"_21648":54559,"_5":14899,"_28426":54491,"_3090":54560},[],"`/serverkeygen`",{"_3640":1127,"_31229":1102,"_21648":54562,"_5":14899,"_28426":54491,"_3090":54546},[],{"_3640":1128,"_31229":1102,"_21648":54564,"_5":14899,"_28426":54491,"_3090":54565},[],"Initial authentication and admission; server generation enabled.",{"_3640":1129,"_31229":1102,"_21648":54567,"_5":14899,"_28426":54491,"_3090":54568},[],"These routes do not implement `/csrattrs` or `/fullcmc`. There is no native JWT EST authentication mode; a webhook can interpret a request credential according to its own contract.",{"_3640":1130,"_31229":1102,"_21648":54570,"_5":14899,"_28426":54495,"_3090":54571},[],"The default response has `Content-Type: application/pkcs7-mime; smime-type=certs-only` and `Content-Transfer-Encoding: base64`. The body is Base64-encoded DER PKCS#7 with lines of up to 76 characters. It includes the certificates selected by the DMS, not necessarily every ancestor.",{"_3640":1131,"_31229":1102,"_21648":54573,"_5":14899,"_28426":54495,"_3090":54574},[],"`Accept: application/x-pem-file` requests the bundle in PEM through a Lamassu extension. Inspect and approve its contents before modifying trusted roots.",{"_3640":1132,"_31229":1102,"_21648":54576,"_5":14899,"_28426":54498,"_3090":54577},[],"Send a Base64-encoded DER PKCS#10 CSR with `Content-Type: application/pkcs10`. The controller compares that media type literally; avoid adding parameters such as charset. The CN identifies the device and the CSR signature must be verified through DMS policy.",{"_3640":1133,"_31229":1102,"_21648":54579,"_5":14899,"_28426":54498,"_3090":54580},[],"The default response uses the PKCS#7/Base64 format described for cacerts, but contains the issued certificate; do not assume it includes its entire chain. `Accept: application/x-pem-file` returns that certificate in PEM. The client retains the key that signed the CSR.",{"_3640":1134,"_31229":1102,"_21648":54582,"_5":14899,"_28426":54501,"_3090":54583},[],"Use the same request and certificate response formats. Authentication comes from the independent `reenrollment_settings.est_rfc7030_settings` block. With a client certificate, its CN must match the CSR CN; the subject is also checked against the current certificate.",{"_3640":1135,"_31229":1102,"_21648":54585,"_5":14899,"_28426":54501,"_3090":54586},[],"In mTLS mode, the enrollment CA always validates the re-enrollment credential; certificates from other issuers are accepted only if they are listed as validation CAs in the re-enrollment block. The expiry check through `enable_expired_renewal` belongs to that validator. A revoked current certificate and a request before the window are rejected. With default settings, a client certificate whose revocation cannot be verified is also rejected; the DMS guide describes `allow_unverifiable_revocation`. See Renewal for installation and recovery.",{"_3640":1136,"_31229":1102,"_21648":54588,"_5":14899,"_28426":54504,"_3090":54589},[],"The server generates a software key, rebuilds the CSR with that key and performs initial enrollment. The flag must be enabled and the algorithm permitted by the profile. This operation's key does not become a hardware key because the CA is hosted in an HSM.",{"_3640":1137,"_31229":1102,"_21648":54591,"_5":14899,"_28426":54504,"_3090":54592},[],"The code supports RSA and ECDSA, and the `bits` value of the DMS key setting means something different for each. For ECDSA it selects the curve: 224, 256, 384 or 521 map to P-224, P-256, P-384 and P-521, and an unrecognized size falls back to P-256, so explicitly select a compatible size and check the resulting key. For RSA it is used directly as the modulus size; the console offers 2048, 3072 and 4096 bits. Do not reuse an enrolled ID to test this operation without reviewing replacement.",{"_3640":1138,"_31229":1102,"_21648":54594,"_5":14899,"_28426":54507,"_3090":54595},[],"The body is **MIME multipart/mixed**, with the boundary specified in `Content-Type`. It contains two parts:",{"_3640":1139,"_31229":1102,"_21648":54597,"_5":14899,"_28426":54507,"_3090":54598},[],"Part",{"_3640":1140,"_31229":1102,"_21648":54600,"_5":14899,"_28426":54507,"_3090":54601},[],"Content after decoding its Base64",{"_3640":1141,"_31229":1102,"_21648":54603,"_5":14899,"_28426":54507,"_3090":54604},[],"`application/pkcs8`",{"_3640":1142,"_31229":1102,"_21648":54606,"_5":14899,"_28426":54507,"_3090":54607},[],"Unencrypted DER PKCS#8 private key.",{"_3640":1143,"_31229":1102,"_21648":54609,"_5":14899,"_28426":54507,"_3090":54610},[],"`application/pkcs7-mime; smime-type=certs-only`",{"_3640":1144,"_31229":1102,"_21648":54612,"_5":14899,"_28426":54507,"_3090":54613},[],"DER PKCS#7 containing the issued certificate.",{"_3640":1145,"_31229":1102,"_21648":54615,"_5":14899,"_28426":54507,"_3090":54616},[],"The controller also adds `Content-Transfer-Encoding: base64` to the outer header, although the outer body is MIME text. &#x2A;*Do not Base64-decode the entire body.** Read the actual boundary and decode each part according to its headers.",{"_3640":1146,"_31229":1102,"_21648":54618,"_5":14899,"_28426":54511,"_3090":54619},[],"In a Bash session with `set -euo pipefail` and `umask 077`, use `EST_BASE` and the trust/bootstrap files from EST client. Select an available and admitted `est-serverkeygen-001`. The `server-request.key` only signs the input CSR; the received identity uses the server-generated key.",{"_3640":1147,"_31229":1102,"_21648":54621,"_5":14899,"_28426":54511,"_3090":54622},[],"Save this Python 3 extractor. It validates both parts before writing and rejects existing output files:",{"_3640":1148,"_31229":1102,"_21648":54624,"_5":14899,"_28426":54511,"_3090":54625},[],"Convert and check the result:",{"_3640":1149,"_31229":1102,"_21648":54627,"_5":14899,"_28426":54511,"_3090":54628},[],"Inspect the CN, serial, dates and uses; check association in Lamassu before installing. Protect the DER and PEM files containing the key and remove temporary copies according to the device's storage mechanism. See openssl-pkcs8 and the Python MIME parser.",{"_3640":1150,"_31229":1102,"_21648":54630,"_5":14899,"_28426":54515,"_3090":54631},[],"Do not interpret every 500 as a transient failure. Invalid input typically produces 400; service denials and errors typically produce 500 with a JSON `err` body. Gateway errors and some controller paths can have another format. Retain headers and body before decoding and see troubleshooting.",{"_3640":1151,"_31229":1102,"_21648":54633,"_5":14899,"_28426":54515,"_3090":54634},[],"The examples use openssl-pkcs7 to extract certificates and openssl-x509 to prepare renewal. Check your version's capabilities and responses before integrating a generic EST client.",{"_3640":1152,"_31229":1152,"_5":15259,"_3090":53938,"_31567":54636,"_21648":54637,"_28426":1152},[51054,52582,53754,53752,53938],[],{"_3640":1153,"_31229":1152,"_21648":54639,"_5":14899,"_28426":1152,"_3090":54640},[],"Choose admission policy and connect DMS, initial trust and the EST client.",{"_3640":1154,"_31229":1152,"_5":31564,"_21648":54642,"_28426":54643,"_3090":54644},[],"/docs/platform/iot-fleets/enrollment/overview#the-journey","The journey",{"_3640":1155,"_31229":1152,"_5":31564,"_21648":54646,"_28426":54647,"_3090":54648},[],"/docs/platform/iot-fleets/enrollment/overview#for-the-administrator","For the administrator",{"_3640":1156,"_31229":1152,"_5":31564,"_21648":54650,"_28426":54651,"_3090":54652},[],"/docs/platform/iot-fleets/enrollment/overview#for-the-integrator","For the integrator",{"_3640":1157,"_31229":1152,"_21648":54654,"_5":14899,"_28426":1152,"_3090":54655},[],"Enrollment with PKI covers the path from device admission to identity installation and renewal. The DMS acts as a registration authority: it authenticates the request, applies registration policy and asks the CA to sign. The client keeps or receives the key, installs the result and presents it to the consumer.",{"_3640":1158,"_31229":1152,"_21648":54657,"_5":14899,"_28426":54643,"_3090":54658},[],"The administrator prepares the CA, issuance profile and DMS.",{"_3640":1159,"_31229":1152,"_21648":54660,"_5":14899,"_28426":54643,"_3090":54661},[],"The integrator installs initial EST server trust and an admission credential.",{"_3640":1160,"_31229":1152,"_21648":54663,"_5":14899,"_28426":54643,"_3090":54664},[],"The client requests an identity for its `Device ID` through EST.",{"_3640":1161,"_31229":1152,"_21648":54666,"_5":14899,"_28426":54643,"_3090":54667},[],"Certificate, device binding and key/certificate installation are checked.",{"_3640":1162,"_31229":1152,"_21648":54669,"_5":14899,"_28426":54643,"_3090":54670},[],"The consumer validates and authorizes the identity; the client schedules renewal and recovery.",{"_3640":1163,"_31229":1152,"_21648":54672,"_5":14899,"_28426":54643,"_3090":54673},[],"EST uses `/.well-known/est/{DMS_ID}`. Administrative APIs and manual assignment remain separate paths. Enroll and connect a device completes an initial mTLS test.",{"_3640":1164,"_31229":1152,"_21648":54675,"_5":14899,"_28426":54647,"_3090":54676},[],"<Card title=\"Provisioning strategies\" description=\"Choose automatic registration, preregistration or manual assignment.\" href=\"/docs/platform/iot-fleets/enrollment/provisioning-strategies\" />",{"_3640":1165,"_31229":1152,"_21648":54678,"_5":14899,"_28426":54647,"_3090":54679},[],"<Card title=\"Configure the DMS\" description=\"Separate admission, authentication per operation, profiles and distribution.\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_3640":1166,"_31229":1152,"_21648":54681,"_5":14899,"_28426":54647,"_3090":54682},[],"<Card title=\"Bootstrap identity and authentication\" description=\"Decide which proof allows requesting the first identity.\" href=\"/docs/platform/iot-fleets/enrollment/bootstrap-identity\" />",{"_3640":1167,"_31229":1152,"_21648":54684,"_5":14899,"_28426":54647,"_3090":54685},[],"<Card title=\"Trust distribution\" description=\"Update roots and chains with verified overlap.\" href=\"/docs/platform/iot-fleets/enrollment/trust-distribution\" />",{"_3640":1168,"_31229":1152,"_21648":54687,"_5":14899,"_28426":54651,"_3090":54688},[],"<Card title=\"EST client\" description=\"Prepare the request, verify the response and install the identity.\" href=\"/docs/platform/iot-fleets/enrollment/est-client\" />",{"_3640":1169,"_31229":1152,"_21648":54690,"_5":14899,"_28426":54651,"_3090":54691},[],"<Card title=\"Renewal and recovery\" description=\"Generate the successor and handle expired or lost credentials.\" href=\"/docs/platform/iot-fleets/enrollment/renewal-and-recovery\" />",{"_3640":1170,"_31229":1152,"_21648":54693,"_5":14899,"_28426":54651,"_3090":54694},[],"<Card title=\"EST reference\" description=\"Look up paths, formats, authentication and ServerKeyGen.\" href=\"/docs/platform/iot-fleets/enrollment/est-reference\" />",{"_3640":1171,"_31229":1152,"_21648":54696,"_5":14899,"_28426":54651,"_3090":54697},[],"<Card title=\"Troubleshooting\" description=\"Distinguish transport, policy, issuance and installation failures.\" href=\"/docs/platform/iot-fleets/enrollment/troubleshooting\" />",{"_3640":1172,"_31229":1152,"_21648":54699,"_5":14899,"_28426":54651,"_3090":54700},[],"Gateway, TLS, provider and service configuration belongs to Deployment. Identity use in AWS or other destinations belongs to Integrations.",{"_3640":1173,"_31229":1173,"_5":15259,"_3090":54702,"_31567":54703,"_21648":54704,"_28426":1173},"Provisioning strategies",[51054,52582,53754,53752,53938],[],{"_3640":1174,"_31229":1173,"_21648":54706,"_5":14899,"_28426":1173,"_3090":54707},[],"Choose device registration, identity authorization and key generation.",{"_3640":1175,"_31229":1173,"_5":31564,"_21648":54709,"_28426":54710,"_3090":54711},[],"/docs/platform/iot-fleets/enrollment/provisioning-strategies#choose-registration","Choose registration",{"_3640":1176,"_31229":1173,"_5":31564,"_21648":54713,"_28426":54714,"_3090":54715},[],"/docs/platform/iot-fleets/enrollment/provisioning-strategies#preregistration-and-replacement","Preregistration and replacement",{"_3640":1177,"_31229":1173,"_5":31564,"_21648":54717,"_28426":54718,"_3090":54719},[],"/docs/platform/iot-fleets/enrollment/provisioning-strategies#choose-authentication","Choose authentication",{"_3640":1178,"_31229":1173,"_5":31564,"_21648":54721,"_28426":54722,"_3090":54723},[],"/docs/platform/iot-fleets/enrollment/provisioning-strategies#choose-custody","Choose custody",{"_3640":1179,"_31229":1173,"_5":31564,"_21648":54725,"_28426":54726,"_3090":54727},[],"/docs/platform/iot-fleets/enrollment/provisioning-strategies#check-the-decision","Check the decision",{"_3640":1180,"_31229":1173,"_21648":54729,"_5":14899,"_28426":1173,"_3090":54730},[],"This guide helps the provisioning administrator choose a path before configuring the DMS. Separate three decisions: when the device exists, how its request is authorized and who generates its key. None grants destination access by itself.",{"_3640":1181,"_31229":1173,"_21648":54732,"_5":14899,"_28426":54710,"_3090":54733},[],"Path",{"_3640":1182,"_31229":1173,"_21648":54735,"_5":14899,"_28426":54710,"_3090":54736},[],"When the device exists",{"_3640":1183,"_31229":1173,"_21648":54738,"_5":14899,"_28426":54710,"_3090":54739},[],"What to check",{"_3640":1184,"_31229":1173,"_21648":54741,"_5":14899,"_28426":54710,"_3090":54742},[],"Manual assignment",{"_3640":1185,"_31229":1173,"_21648":54744,"_5":14899,"_28426":54710,"_3090":54745},[],"An operator creates it before associating a certificate.",{"_3640":1186,"_31229":1173,"_21648":54747,"_5":14899,"_28426":54710,"_3090":54748},[],"ID, owning DMS, certificate CN and bound serial.",{"_3640":1187,"_31229":1173,"_21648":54750,"_5":14899,"_28426":54710,"_3090":54751},[],"EST with `JITP`",{"_3640":1188,"_31229":1173,"_21648":54753,"_5":14899,"_28426":54710,"_3090":54754},[],"Created for an unknown CN during `/simpleenroll`.",{"_3640":1189,"_31229":1173,"_21648":54756,"_5":14899,"_28426":54710,"_3090":54757},[],"Authorized credential, unused ID, profile, resulting registration and identity.",{"_3640":1190,"_31229":1173,"_21648":54759,"_5":14899,"_28426":54710,"_3090":54760},[],"EST with `PRE_REGISTRATION`",{"_3640":1191,"_31229":1173,"_21648":54762,"_5":14899,"_28426":54710,"_3090":54763},[],"Must exist before `/simpleenroll`.",{"_3640":1192,"_31229":1173,"_21648":54765,"_5":14899,"_28426":54710,"_3090":54766},[],"Approved record, same DMS and replacement conditions for your version.",{"_3640":1193,"_31229":1173,"_21648":54768,"_5":14899,"_28426":54710,"_3090":54769},[],"Lamassu `JITP` creates inventory and identity in Lamassu. AWS JITP provisions a destination in AWS; these are separate decisions.",{"_3640":1194,"_31229":1173,"_21648":54771,"_5":14899,"_28426":54710,"_3090":54772},[],"For an initial client test, use Enroll and connect a device. To prepare inventory without EST, follow Manual registration.",{"_3640":1195,"_31229":1173,"_21648":54774,"_5":14899,"_28426":54714,"_3090":54775},[],"Finding any device owned by the same DMS triggers the `enable_replaceable_enrollment` check before PRE\\_REGISTRATION. With the flag disabled, a preregistered device can receive `forbiddenNewEnrollment` even in **No Identity**. Selecting PRE\\_REGISTRATION alone therefore does not establish a working path.",{"_3640":1196,"_31229":1173,"_21648":54777,"_5":14899,"_28426":54714,"_3090":54778},[],"Enabling the flag permits repeated `/simpleenroll` for an existing ID. The backend schedules a deferred attempt to revoke the previous certificate with `Superseded`; it can also run if later issuance or binding fails. Without an identity, that attempt can fail because no serial exists. The flag does not provide a replacement transaction or guarantee restoration of previous state.",{"_3640":1197,"_31229":1173,"_21648":54780,"_5":14899,"_28426":54714,"_3090":54781},[],"Test the exact case on your version before enabling it for a population. For an operational identity with authorized renewal, use `/simplereenroll`; for recovery, follow Renewal and recovery and check persisted state before retrying.",{"_3640":1198,"_31229":1173,"_21648":54783,"_5":14899,"_28426":54718,"_3090":54784},[],"Decide initial enrollment and re-enrollment separately:",{"_3640":1199,"_31229":1173,"_21648":54786,"_5":14899,"_28426":54718,"_3090":54787},[],"**Client certificate:** useful when each device has an initial credential whose key it controls.",{"_3640":1200,"_31229":1173,"_21648":54789,"_5":14899,"_28426":54718,"_3090":54790},[],"**Webhook:** useful when another authority knows inventory, credentials or entitlement to a requested ID.",{"_3640":1201,"_31229":1173,"_21648":54792,"_5":14899,"_28426":54718,"_3090":54793},[],"**Certificate and webhook:** requires both controls in the configured operation.",{"_3640":1202,"_31229":1173,"_21648":54795,"_5":14899,"_28426":54718,"_3090":54796},[],"**NO\\_AUTH:** does not establish requester identity; appropriate only when admission is deliberately controlled outside that DMS.",{"_3640":1203,"_31229":1173,"_21648":54798,"_5":14899,"_28426":54718,"_3090":54799},[],"Authenticating an initial certificate does not itself establish entitlement to choose any CSR CN. Define that authorization in Bootstrap identity and authentication.",{"_3640":1204,"_31229":1173,"_21648":54801,"_5":14899,"_28426":54722,"_3090":51438},[],{"_3640":1205,"_31229":1173,"_21648":54803,"_5":14899,"_28426":54722,"_3090":54804},[],"Material crossing EST",{"_3640":1206,"_31229":1173,"_21648":54806,"_5":14899,"_28426":54722,"_3090":54807},[],"Device-generated key",{"_3640":1207,"_31229":1173,"_21648":54809,"_5":14899,"_28426":54722,"_3090":54810},[],"Public CSR and certificate; the key stays on the client.",{"_3640":1208,"_31229":1173,"_21648":54812,"_5":14899,"_28426":54722,"_3090":54813},[],"Existing device key",{"_3640":1209,"_31229":1173,"_21648":54815,"_5":14899,"_28426":54722,"_3090":54816},[],"CSR signed with that key and a new certificate.",{"_3640":1210,"_31229":1173,"_21648":54818,"_5":14899,"_28426":54722,"_3090":54082},[],{"_3640":1211,"_31229":1173,"_21648":54820,"_5":14899,"_28426":54722,"_3090":54821},[],"Private PKCS#8 key and certificate in a TLS-protected multipart response.",{"_3640":1212,"_31229":1173,"_21648":54823,"_5":14899,"_28426":54722,"_3090":54824},[],"ServerKeyGen does not automatically use the CA’s HSM or KMS for the device key. Review its contract and extraction and the device’s ability to install the material.",{"_3640":1213,"_31229":1173,"_21648":54826,"_5":14899,"_28426":54726,"_3090":54827},[],"Before expanding the flow, test allowed registration, incorrect credentials, an ID owned by another DMS, repeated requests and recovery after failure. Keep ID, serial, active version and error. Also test consumer acceptance and rejection; issuance does not imply destination registration or permission to operate.",{"_3640":1214,"_31229":1214,"_5":15259,"_3090":54829,"_31567":54830,"_21648":54831,"_28426":1214},"Renewal and recovery",[51054,52582,53754,53752,53938],[],{"_3640":1215,"_31229":1214,"_21648":54833,"_5":14899,"_28426":1214,"_3090":54834},[],"Renew without losing the identity and recover devices according to their actual state.",{"_3640":1216,"_31229":1214,"_5":31564,"_21648":54836,"_28426":54837,"_3090":54838},[],"/docs/platform/iot-fleets/enrollment/renewal-and-recovery#prepare-renewal","Prepare renewal",{"_3640":1217,"_31229":1214,"_5":31564,"_21648":54840,"_28426":54841,"_3090":54842},[],"/docs/platform/iot-fleets/enrollment/renewal-and-recovery#request-the-successor-certificate","Request the successor certificate",{"_3640":1218,"_31229":1214,"_5":31564,"_21648":54844,"_28426":54845,"_3090":54846},[],"/docs/platform/iot-fleets/enrollment/renewal-and-recovery#install-and-check-the-new-pair","Install and check the new pair",{"_3640":1219,"_31229":1214,"_5":31564,"_21648":54848,"_28426":54849,"_3090":54850},[],"/docs/platform/iot-fleets/enrollment/renewal-and-recovery#recover-according-to-state","Recover according to state",{"_3640":1220,"_31229":1214,"_5":31564,"_21648":54852,"_28426":54853,"_3090":54854},[],"/docs/platform/iot-fleets/enrollment/renewal-and-recovery#continuous-operation","Continuous operation",{"_3640":1221,"_31229":1214,"_21648":54856,"_5":14899,"_28426":1214,"_3090":54857},[],"Renewal retains the device identifier and requests a successor certificate. The client must complete the process: check the response, install the matching pair and demonstrate that the consumer accepts it. Lamassu alerts notify you; they do not perform those steps.",{"_3640":1222,"_31229":1214,"_21648":54859,"_5":14899,"_28426":54837,"_3090":54860},[],"Query the current certificate in Lamassu and compare it with the installed certificate. You need its subject, serial and dates, as well as the client key.",{"_3640":1223,"_31229":1214,"_21648":54862,"_5":14899,"_28426":54837,"_3090":54863},[],"Check the **re-enrollment** authentication mode: it is independent of initial authentication. With `CLIENT_CERTIFICATE`, use the current identity; do not assume the bootstrap credential is admitted.",{"_3640":1224,"_31229":1214,"_21648":54865,"_5":14899,"_28426":54837,"_3090":54866},[],"Calculate the window's start: the current certificate's `NotAfter` minus `reenrollment_delta`. Preventive and critical thresholds produce states/notifications; they do not extend that window.",{"_3640":1225,"_31229":1214,"_21648":54868,"_5":14899,"_28426":54837,"_3090":54869},[],"Review **Revoke on Re-enrollment** and recovery if installation fails. When enabled, Lamassu can revoke the previous identity before the client installs the new one.",{"_3640":1226,"_31229":1214,"_21648":54871,"_5":14899,"_28426":54841,"_3090":54872},[],"The example continues the EST tutorial, in the same Bash session with `set -euo pipefail`, `umask 077` and `EST_BASE`. Use a new key compatible with the profile. Conversion from the certificate preserves the subject and copies only SAN when present; check the subject and requested names before sending it. The backend checks the subject against the current identity: it attempts RawSubject equality and then compares CN, OU, O, L, ST and C. Rebuilding only the CN can lose required attributes.",{"_3640":1227,"_31229":1214,"_21648":54874,"_5":14899,"_28426":54841,"_3090":54875},[],"The request authenticates with `device.crt` and `device.key`; the CSR contains the new public key. Also check extensions, dates and correspondence of the serial with the current slot in Lamassu. Do not resubmit a failed request without querying that state: issuance, previous revocation and successor binding can have partial results.",{"_3640":1228,"_31229":1214,"_21648":54877,"_5":14899,"_28426":54845,"_3090":54878},[],"Keep the result as `device.next.crt` and `device.next.key` until verified. Switch the pair through a coordinated operation in the device store or configuration; avoid temporarily exposing a certificate with another version's key.",{"_3640":1229,"_31229":1214,"_21648":54880,"_5":14899,"_28426":54845,"_3090":54881},[],"Test mTLS with the consumer and verify that it uses the new serial. Confirm the history and current certificate in Lamassu. If **Revoke on Re-enrollment** was disabled, the previous identity can remain valid: retire it according to PKI policy after testing the successor, and check revocation publication and consumption.",{"_3640":1230,"_31229":1214,"_21648":54883,"_5":14899,"_28426":54845,"_3090":54884},[],"If the previous identity is already revoked, retaining its files does not restore a valid connection. Recovery requires an admitted credential and authorized intervention according to the situation.",{"_3640":1231,"_31229":1214,"_21648":54886,"_5":14899,"_28426":54849,"_3090":54887},[],"Situation",{"_3640":1232,"_31229":1214,"_21648":54889,"_5":14899,"_28426":54849,"_3090":54890},[],"Procedure",{"_3640":1233,"_31229":1214,"_21648":54892,"_5":14899,"_28426":54849,"_3090":54893},[],"Valid certificate, outside the window",{"_3640":1234,"_31229":1214,"_21648":54895,"_5":14899,"_28426":54849,"_3090":54896},[],"Schedule the request within the window. Do not use `simpleenroll` to bypass it.",{"_3640":1235,"_31229":1214,"_21648":54898,"_5":14899,"_28426":54849,"_3090":54899},[],"Expired certificate, key available",{"_3640":1236,"_31229":1214,"_21648":54901,"_5":14899,"_28426":54849,"_3090":54902},[],"With certificate authentication, review `enable_expired_renewal` and whether Gateway permits presenting that credential. Revocation, subject and the remaining checks still apply.",{"_3640":1237,"_31229":1214,"_21648":54904,"_5":14899,"_28426":54849,"_3090":54905},[],"Renewal through webhook or `NO_AUTH`",{"_3640":1238,"_31229":1214,"_21648":54907,"_5":14899,"_28426":54849,"_3090":54908},[],"The mTLS expiry check does not run in these modes. Define expiry and authorization policy in the corresponding admission process; the flag is not a universal prohibition.",{"_3640":1239,"_31229":1214,"_21648":54910,"_5":14899,"_28426":54849,"_3090":54911},[],"Lost or inaccessible key",{"_3640":1240,"_31229":1214,"_21648":54913,"_5":14899,"_28426":54849,"_3090":54914},[],"You cannot prove possession of the previous identity. Authorize new admission and, if appropriate, controlled replacement; revoke the compromised identity.",{"_3640":1241,"_31229":1214,"_21648":54916,"_5":14899,"_28426":54849,"_3090":54917},[],"Current identity revoked",{"_3640":1242,"_31229":1214,"_21648":54919,"_5":14899,"_28426":54849,"_3090":54920},[],"`simplereenroll` rejects the revoked current certificate. Investigate the reason and prepare an authorized readmission procedure; do not disable authentication to force it.",{"_3640":1243,"_31229":1214,"_21648":54922,"_5":14899,"_28426":54849,"_3090":54923},[],"Device without an identity",{"_3640":1244,"_31229":1214,"_21648":54925,"_5":14899,"_28426":54849,"_3090":54926},[],"Use initial enrollment. For an existing entry, check the replacement restriction in provisioning.",{"_3640":1245,"_31229":1214,"_21648":54928,"_5":14899,"_28426":54849,"_3090":54929},[],"Retired device",{"_3640":1246,"_31229":1214,"_21648":54931,"_5":14899,"_28426":54849,"_3090":54932},[],"Review the operational decision before readmission. Decommissioned state and revocation of the entire history are not equivalent.",{"_3640":1247,"_31229":1214,"_21648":54934,"_5":14899,"_28426":54849,"_3090":54935},[],"Timeout, HTTP 500 or installation failure",{"_3640":1248,"_31229":1214,"_21648":54937,"_5":14899,"_28426":54849,"_3090":54938},[],"Inspect the device, issued certificates and history before retrying. A successor may have been issued or the previous identity revoked.",{"_3640":1249,"_31229":1214,"_21648":54940,"_5":14899,"_28426":54853,"_3090":54941},[],"Schedule renewal with time for disconnections, trust distribution and consumer checks. Stagger requests across the population and bound retries within the window; authentication, subject and policy errors require correcting their cause. Maintain an admitted and tested recovery mechanism for lost keys and pairs that could not be installed.",{"_3640":1250,"_31229":1214,"_21648":54943,"_5":14899,"_28426":54853,"_3090":54944},[],"Continue with Trust distribution, Devices and identities and Troubleshooting.",{"_3640":1251,"_31229":1251,"_5":15259,"_3090":54946,"_31567":54947,"_21648":54948,"_28426":1251},"Enrollment troubleshooting",[51054,52582,53754,53752,53938],[],{"_3640":1252,"_31229":1251,"_21648":54950,"_5":14899,"_28426":1251,"_3090":54951},[],"Locate transport, authentication, registration, issuance and installation failures.",{"_3640":1253,"_31229":1251,"_5":31564,"_21648":54953,"_28426":54954,"_3090":54955},[],"/docs/platform/iot-fleets/enrollment/troubleshooting#diagnostics-and-compatibility","Diagnostics and compatibility",{"_3640":1254,"_31229":1251,"_5":31564,"_21648":54957,"_28426":54958,"_3090":54959},[],"/docs/platform/iot-fleets/enrollment/troubleshooting#error-codes-and-diagnostics","Error codes and diagnostics",{"_3640":1255,"_31229":1251,"_5":31564,"_21648":54961,"_28426":54962,"_3090":54516},[],"/docs/platform/iot-fleets/enrollment/troubleshooting#compatibility-notes",{"_3640":1256,"_31229":1251,"_5":31564,"_21648":54964,"_28426":54965,"_3090":54966},[],"/docs/platform/iot-fleets/enrollment/troubleshooting#est-enrollment-fails","EST enrollment fails",{"_3640":1257,"_31229":1251,"_21648":54968,"_5":14899,"_28426":1251,"_3090":54969},[],"Diagnose one operation and device at a time. Record the DMS/APS, endpoint, time, HTTP code, presented serial and CSR CN. Retain the response without including private keys or webhook credentials in the report.",{"_3640":1258,"_31229":1251,"_21648":54971,"_5":14899,"_28426":54958,"_3090":54972},[],"The EST controller normally returns 400 when rejecting input and 500 when the service rejects or fails the operation. A 500 can also represent a policy denial; it does not mean retrying is safe. Gateway can produce its own codes and bodies. Examine the actual body and persisted result.",{"_3640":1259,"_31229":1251,"_21648":54974,"_5":14899,"_28426":54958,"_3090":54975},[],"Symptom or message",{"_3640":1260,"_31229":1251,"_21648":54977,"_5":14899,"_28426":54958,"_3090":54739},[],{"_3640":1261,"_31229":1251,"_21648":54979,"_5":14899,"_28426":54958,"_3090":54980},[],"curl rejects TLS, name or issuer",{"_3640":1262,"_31229":1251,"_21648":54982,"_5":14899,"_28426":54958,"_3090":54983},[],"URL, clock, server SAN and approved root in `est-trust.pem`. Resolve trust in Deployment; do not skip verification.",{"_3640":1263,"_31229":1251,"_21648":54985,"_5":14899,"_28426":54958,"_3090":54986},[],"404 or missing APS",{"_3640":1264,"_31229":1251,"_21648":54988,"_5":14899,"_28426":54958,"_3090":54989},[],"Public route `/.well-known/est/{DMS_ID}/{operation}` and existing DMS. APS is not the service name.",{"_3640":1265,"_31229":1251,"_21648":54991,"_5":14899,"_28426":54958,"_3090":54992},[],"400, CSR or format error",{"_3640":1266,"_31229":1251,"_21648":54994,"_5":14899,"_28426":54958,"_3090":54995},[],"`Content-Type: application/pkcs10`, Base64 of DER, valid signature and a body preserved without double encoding.",{"_3640":1267,"_31229":1251,"_21648":54997,"_5":14899,"_28426":54958,"_3090":54998},[],"Missing credential or invalid certificate",{"_3640":1268,"_31229":1251,"_21648":55000,"_5":14899,"_28426":54958,"_3090":55001},[],"Operation mode, validating CA, dates, revocation and credential delivery by Gateway. Do not confuse server TLS trust with the bootstrap CA.",{"_3640":1269,"_31229":1251,"_21648":55003,"_5":14899,"_28426":54958,"_3090":55004},[],"Enroll or re-enroll rejects a certificate for unverifiable revocation",{"_3640":1270,"_31229":1251,"_21648":55006,"_5":14899,"_28426":54958,"_3090":55007},[],"Whether the certificate is managed by Lamassu, whether its OCSP/CRL endpoints are configured and reachable from the service, and whether `allow_unverifiable_revocation` is set for that operation's block. See DMS and Revocation and checks.",{"_3640":1271,"_31229":1251,"_21648":55009,"_5":14899,"_28426":54958,"_3090":55010},[],"Webhook denies, times out or responds without authorization",{"_3640":1272,"_31229":1251,"_21648":55012,"_5":14899,"_28426":54958,"_3090":55013},[],"Configuration, connectivity and JSON response with `authorized: true`. There is no automatic fallback to `NO_AUTH`.",{"_3640":1273,"_31229":1251,"_21648":55015,"_5":14899,"_28426":54958,"_3090":55016},[],"`unexpected status code: <n>: redirects are not followed`",{"_3640":1274,"_31229":1251,"_21648":55018,"_5":14899,"_28426":54958,"_3090":55019},[],"The webhook answered with a redirect. Configure the final absolute `http` or `https` URL in the webhook config; redirects are never followed.",{"_3640":1275,"_31229":1251,"_21648":55021,"_5":14899,"_28426":54958,"_3090":55022},[],"`webhook response exceeds 1048576 bytes`",{"_3640":1276,"_31229":1251,"_21648":55024,"_5":14899,"_28426":54958,"_3090":55025},[],"The receiver returned more than 1 MiB of JSON. Reduce the response of the authorization webhook.",{"_3640":1277,"_31229":1251,"_21648":55027,"_5":14899,"_28426":54958,"_3090":55028},[],"`webhook config must not reference files`",{"_3640":1278,"_31229":1251,"_21648":55030,"_5":14899,"_28426":54958,"_3090":55031},[],"The webhook config points to files (`ca_cert_file`, `mtls_options.cert_file`, `mtls_options.key_file`). For mTLS, enter the certificate and key as Base64-encoded PEM in `cert_content` and `key_content`, or as plain PEM; remove any other file field, including `ca_cert_file`, which has no inline equivalent (the receiver certificate must chain to the system trust store). See the webhook credentials guidance in DMS.",{"_3640":1279,"_31229":1251,"_21648":55033,"_5":14899,"_28426":54958,"_3090":55034},[],"`mtls_options.cert_content must be base64-encoded PEM`",{"_3640":1280,"_31229":1251,"_21648":55036,"_5":14899,"_28426":54958,"_3090":55037},[],"The value is neither Base64-encoded PEM nor plain PEM: it is a file path or Base64 of non-PEM data. Enter the certificate and key as Base64-encoded PEM, like certificates elsewhere in the API, or as plain PEM (see the webhook settings in DMS). The same message names `mtls_options.key_content` when the key is the offending value.",{"_3640":1281,"_31229":1251,"_21648":55039,"_5":14899,"_28426":54958,"_3090":55040},[],"`webhook mTLS certificate and key are invalid: …`",{"_3640":1282,"_31229":1251,"_21648":55042,"_5":14899,"_28426":54958,"_3090":55043},[],"The certificate and key do not form a matching pair. Enter both values from the same pair; the check runs when the DMS is saved and again on every webhook call.",{"_3640":1283,"_31229":1251,"_21648":55045,"_5":14899,"_28426":54958,"_3090":55046},[],"400 `struct validation error` creating or updating a DMS",{"_3640":1284,"_31229":1251,"_21648":55048,"_5":14899,"_28426":54958,"_3090":55049},[],"The webhook config of the operation that uses it is invalid. Review `external_webhook_settings` in DMS.",{"_3640":1285,"_31229":1251,"_21648":55051,"_5":14899,"_28426":54958,"_3090":55052},[],"HTTP 500 with an `err` body on enroll or reenroll",{"_3640":1286,"_31229":1251,"_21648":55054,"_5":14899,"_28426":54958,"_3090":55055},[],"Service failures reach the EST client as 500 with a body of `err` plus the message; webhook authorization errors are named there.",{"_3640":1287,"_31229":1251,"_21648":55057,"_5":14899,"_28426":54958,"_3090":55058},[],"`device not preregistered`",{"_3640":1288,"_31229":1251,"_21648":55060,"_5":14899,"_28426":54958,"_3090":55061},[],"PRE\\_REGISTRATION requires an existing inventory entry.",{"_3640":1289,"_31229":1251,"_21648":55063,"_5":14899,"_28426":54958,"_3090":55064},[],"`forbiddenNewEnrollment`",{"_3640":1290,"_31229":1251,"_21648":55066,"_5":14899,"_28426":54958,"_3090":55067},[],"An existing device requires replacement to be enabled, even in No Identity. Investigate before enabling the flag.",{"_3640":1291,"_31229":1251,"_21648":55069,"_5":14899,"_28426":54958,"_3090":55070},[],"Different owning DMS",{"_3640":1292,"_31229":1251,"_21648":55072,"_5":14899,"_28426":54958,"_3090":55073},[],"CN/ID, global inventory and owning DMS; do not reuse an ID from another context.",{"_3640":1293,"_31229":1251,"_21648":55075,"_5":14899,"_28426":54958,"_3090":55076},[],"`invalid RawSubject bytes`",{"_3640":1294,"_31229":1251,"_21648":55078,"_5":14899,"_28426":54958,"_3090":55079},[],"CSR subject versus the current certificate. Preserve its attributes as well as its CN.",{"_3640":1295,"_31229":1251,"_21648":55081,"_5":14899,"_28426":54958,"_3090":55082},[],"`invalid reenroll window`",{"_3640":1296,"_31229":1251,"_21648":55084,"_5":14899,"_28426":54958,"_3090":55085},[],"Current identity's NotAfter and reenrollment\\_delta. Alert thresholds do not change that window.",{"_3640":1297,"_31229":1251,"_21648":55087,"_5":14899,"_28426":54958,"_3090":55088},[],"Current certificate revoked",{"_3640":1298,"_31229":1251,"_21648":55090,"_5":14899,"_28426":54958,"_3090":55091},[],"Renewal rejected; prepare authorized recovery according to the cause.",{"_3640":1299,"_31229":1251,"_21648":55093,"_5":14899,"_28426":54958,"_3090":55094},[],"CA, profile or signing error",{"_3640":1300,"_31229":1251,"_21648":55096,"_5":14899,"_28426":54958,"_3090":55097},[],"Active CA, available key, selected profile and restrictions. Successful cacerts does not prove issuance.",{"_3640":1301,"_31229":1251,"_21648":55099,"_5":14899,"_28426":54958,"_3090":55100},[],"HTTP 200 without a device connection",{"_3640":1302,"_31229":1251,"_21648":55102,"_5":14899,"_28426":54958,"_3090":55103},[],"Installed pair, chain, uses, consumer trust and permissions. Also check the slot and history.",{"_3640":1303,"_31229":1251,"_21648":55105,"_5":14899,"_28426":54958,"_3090":55106},[],"Timeout or error after issuance",{"_3640":1304,"_31229":1251,"_21648":55108,"_5":14899,"_28426":54958,"_3090":55109},[],"New certificates, current slot and previous identity's state before retrying.",{"_3640":1305,"_31229":1251,"_21648":55111,"_5":14899,"_28426":54962,"_3090":55112},[],"Check the saved renewal mode and Gateway behavior with expired certificates and the bootstrap CA.",{"_3640":1306,"_31229":1251,"_21648":55114,"_5":14899,"_28426":54962,"_3090":55115},[],"The default response is Base64-encoded DER PKCS#7; PEM through `Accept: application/x-pem-file` is a Lamassu extension. ServerKeyGen returns multipart and requires handling each part separately. See the EST reference.",{"_3640":1307,"_31229":1251,"_21648":55117,"_5":14899,"_28426":54965,"_3090":55118},[],"Check HTTPS with the approved root and query cacerts for the correct APS.",{"_3640":1308,"_31229":1251,"_21648":55120,"_5":14899,"_28426":54965,"_3090":55121},[],"Review the saved DMS: protocol, registration, authentication for that operation, CA, profile and window.",{"_3640":1309,"_31229":1251,"_21648":55123,"_5":14899,"_28426":54965,"_3090":55124},[],"Verify the CSR locally and relate its CN to the inventory.",{"_3640":1310,"_31229":1251,"_21648":55126,"_5":14899,"_28426":54965,"_3090":55127},[],"Make one request, save headers/body and query the device and certificates.",{"_3640":1311,"_31229":1251,"_21648":55129,"_5":14899,"_28426":54965,"_3090":55130},[],"If you receive an identity, check the key, subject, use and connection with the consumer.",{"_3640":1312,"_31229":1251,"_21648":55132,"_5":14899,"_28426":54965,"_3090":55133},[],"External bootstrap revocation checks fail closed: a certificate whose revocation cannot be verified — including an OCSP Unknown status — is rejected by default. Only `allow_unverifiable_revocation` in that operation's block (see DMS) relaxes it, and only for certificates that carry no OCSP/CRL endpoint at all; unreachable, stale or inconclusive endpoints are rejected whatever the option says. See Revocation and checks. An intermediate CA in the TLS chain does not prove that the entire chain reached the DMS validator either.",{"_3640":1313,"_31229":1251,"_21648":55135,"_5":14899,"_28426":54965,"_3090":55136},[],"For logs, networking, pods or Gateway headers, continue in Deployment troubleshooting. For identities issued, revoked or bound partially, use Renewal and recovery and Devices and identities.",{"_3640":1314,"_31229":1314,"_5":15259,"_3090":55138,"_31567":55139,"_21648":55140,"_28426":1314},"Trust distribution and updates",[51054,52582,53754,53752,53938],[],{"_3640":1315,"_31229":1314,"_21648":55142,"_5":14899,"_28426":1314,"_3090":55143},[],"Separate roots, intermediates and initial TLS trust when distributing or migrating certificates.",{"_3640":1316,"_31229":1314,"_5":31564,"_21648":55145,"_28426":55146,"_3090":55147},[],"/docs/platform/iot-fleets/enrollment/trust-distribution#three-trust-relationships","Three trust relationships",{"_3640":1317,"_31229":1314,"_5":31564,"_21648":55149,"_28426":55150,"_3090":55151},[],"/docs/platform/iot-fleets/enrollment/trust-distribution#what-cacerts-returns","What cacerts returns",{"_3640":1318,"_31229":1314,"_5":31564,"_21648":55153,"_28426":55154,"_3090":55155},[],"/docs/platform/iot-fleets/enrollment/trust-distribution#install-the-required-material","Install the required material",{"_3640":1319,"_31229":1314,"_5":31564,"_21648":55157,"_28426":55158,"_3090":55159},[],"/docs/platform/iot-fleets/enrollment/trust-distribution#migrate-trust","Migrate trust",{"_3640":1320,"_31229":1314,"_5":31564,"_21648":55161,"_28426":55162,"_3090":55163},[],"/docs/platform/iot-fleets/enrollment/trust-distribution#check-the-update","Check the update",{"_3640":1321,"_31229":1314,"_21648":55165,"_5":14899,"_28426":1314,"_3090":55166},[],"This guide is for device and consumer trust administrators. You need issuer inventory, trust-store access and an authenticated update channel. Distributing certificates is separate from choosing trusted anchors.",{"_3640":1322,"_31229":1314,"_21648":55168,"_5":14899,"_28426":55146,"_3090":55169},[],"Relationship",{"_3640":1323,"_31229":1314,"_21648":55171,"_5":14899,"_28426":55146,"_3090":55172},[],"Material prepared by its owner",{"_3640":1324,"_31229":1314,"_21648":55174,"_5":14899,"_28426":55146,"_3090":55175},[],"Device → EST server",{"_3640":1325,"_31229":1314,"_21648":55177,"_5":14899,"_28426":55146,"_3090":55178},[],"Previously verified server root, chain or pin and TLS name.",{"_3640":1326,"_31229":1314,"_21648":55180,"_5":14899,"_28426":55146,"_3090":55181},[],"DMS → requester",{"_3640":1327,"_31229":1314,"_21648":55183,"_5":14899,"_28426":55146,"_3090":55184},[],"CAs and rules authorizing initial or renewal credentials.",{"_3640":1328,"_31229":1314,"_21648":55186,"_5":14899,"_28426":55146,"_3090":55187},[],"Consumer → device",{"_3640":1329,"_31229":1314,"_21648":55189,"_5":14899,"_28426":55146,"_3090":55190},[],"Operational identity roots, intermediates, validation and permissions.",{"_3640":1330,"_31229":1314,"_21648":55192,"_5":14899,"_28426":55146,"_3090":55193},[],"Obtaining a certificate does not automatically configure these relationships in third parties. Review the Trust model.",{"_3640":1331,"_31229":1314,"_21648":55195,"_5":14899,"_28426":55150,"_3090":55196},[],"The DMS may include the available downstream TLS certificate, selected Managed CAs and enrollment CA. Selecting the issuer does not include every ancestor. The set may contain leaves, roots and intermediates, including multiple hierarchies during migration.",{"_3640":1332,"_31229":1314,"_21648":55198,"_5":14899,"_28426":55150,"_3090":55199},[],"Position does not define the chain. Identify certificates by subject, issuer, AKI/SKI, signature and constraints. Download and inspect using EST client.",{"_3640":1333,"_31229":1314,"_21648":55201,"_5":14899,"_28426":55154,"_3090":55202},[],"Keep initial EST server trust separate from identity consumer trust.",{"_3640":1334,"_31229":1314,"_21648":55204,"_5":14899,"_28426":55154,"_3090":55205},[],"Select policy-approved roots as anchors.",{"_3640":1335,"_31229":1314,"_21648":55207,"_5":14899,"_28426":55154,"_3090":55208},[],"Retain intermediates for chain building or presentation; do not automatically turn them into roots.",{"_3640":1336,"_31229":1314,"_21648":55210,"_5":14899,"_28426":55154,"_3090":55211},[],"Present the leaf and required intermediates in mTLS. Normally the peer already trusts its root and does not need it sent.",{"_3640":1337,"_31229":1314,"_21648":55213,"_5":14899,"_28426":55154,"_3090":55214},[],"Verify chain, dates, names, usages and revocation from the consumer.",{"_3640":1338,"_31229":1314,"_21648":55216,"_5":14899,"_28426":55154,"_3090":55217},[],"Do not indiscriminately use all of `cacerts.pem` as `-CAfile`: this can expand trusted authorities, hide missing intermediates or trust a TLS leaf intended for another purpose.",{"_3640":1339,"_31229":1314,"_21648":55219,"_5":14899,"_28426":55158,"_3090":55220},[],"Before changing Enrollment CA, inventory disconnected equipment, bootstrap and operational certificates, and consumers. Distribute the new root and required intermediates; check that a cohort accepts both old and new chains.",{"_3640":1340,"_31229":1314,"_21648":55222,"_5":14899,"_28426":55158,"_3090":55223},[],"In the DMS, separate distributed CAs from the re-enrollment validation CAs at `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`, used for re-enrollment credentials. That list is optional because the enrollment CA always validates re-enrollment credentials, but when switching the enrollment CA, add the previous issuance CA to it so old-CA identities keep re-enrolling during overlap. The validator tries the enrollment CA followed by those CAs against the received leaf; accepting a multilevel chain requires checking what reaches the service and which issuer is configured.",{"_3640":1341,"_31229":1314,"_21648":55225,"_5":14899,"_28426":55158,"_3090":55226},[],"Switch issuance, renew in cohorts and compare the installed serial with the active slot. Remove previous trust once no legitimate equipment needs it and policy permits ending overlap. Follow Hierarchy and rotation for the PKI operation.",{"_3640":1342,"_31229":1314,"_21648":55228,"_5":14899,"_28426":55162,"_3090":55229},[],"Test an old identity allowed during overlap, a new one, an unknown chain and the result after removing old trust. Keep trust-store version, approved set, date and result. Reachable `/cacerts` establishes distribution only; it does not establish installation or acceptance across every device.",{"_3640":1343,"_31229":1343,"_5":15259,"_3090":55231,"_31567":55232,"_21648":55234,"_28426":1343},"AWS IoT Core",[51054,52582,53754,53752,55233],"Integrations",[],{"_3640":1344,"_31229":1343,"_21648":55236,"_5":14899,"_28426":1343,"_3090":55237},[],"Lamassu's connector for AWS IoT Core syncs device identities with the AWS platform, handling CA registration, Thing provisioning and certificate lifecycle automatically and event-driven.",{"_3640":1345,"_31229":1343,"_5":31564,"_21648":55239,"_28426":55240,"_3090":55241},[],"/docs/platform/iot-fleets/integrations/aws-iot-core#connector-architecture","Connector architecture",{"_3640":1346,"_31229":1343,"_5":31564,"_21648":55243,"_28426":55244,"_3090":55245},[],"/docs/platform/iot-fleets/integrations/aws-iot-core#prerequisites","Prerequisites",{"_3640":1347,"_31229":1343,"_5":31564,"_21648":55247,"_28426":55248,"_3090":55249},[],"/docs/platform/iot-fleets/integrations/aws-iot-core#required-iam-permissions","Required IAM permissions",{"_3640":1348,"_31229":1343,"_5":31564,"_21648":55251,"_28426":55252,"_3090":55253},[],"/docs/platform/iot-fleets/integrations/aws-iot-core#configuration-parameters","Configuration parameters",{"_3640":1349,"_31229":1343,"_5":31564,"_21648":55255,"_28426":55256,"_3090":55257},[],"/docs/platform/iot-fleets/integrations/aws-iot-core#events-and-aws-resources","Events and AWS resources",{"_3640":1350,"_31229":1343,"_5":31564,"_21648":55259,"_28426":55260,"_3090":55261},[],"/docs/platform/iot-fleets/integrations/aws-iot-core#ca-registration-in-aws-iot-core","CA registration in AWS IoT Core",{"_3640":1351,"_31229":1343,"_5":31564,"_21648":55263,"_28426":55264,"_3090":55265},[],"/docs/platform/iot-fleets/integrations/aws-iot-core#how-to-request-registration","How to request registration",{"_3640":1352,"_31229":1343,"_5":31564,"_21648":55267,"_28426":55268,"_3090":55269},[],"/docs/platform/iot-fleets/integrations/aws-iot-core#ca-registration-states","CA registration states",{"_3640":1353,"_31229":1343,"_5":31564,"_21648":55271,"_28426":55272,"_3090":55273},[],"/docs/platform/iot-fleets/integrations/aws-iot-core#primary-account","Primary Account",{"_3640":1354,"_31229":1343,"_5":31564,"_21648":55275,"_28426":55276,"_3090":55277},[],"/docs/platform/iot-fleets/integrations/aws-iot-core#secondary-account-sni-only","Secondary Account (SNI-only)",{"_3640":1355,"_31229":1343,"_5":31564,"_21648":55279,"_28426":55280,"_3090":55281},[],"/docs/platform/iot-fleets/integrations/aws-iot-core#dms-configuration","DMS configuration",{"_3640":1356,"_31229":1343,"_5":31564,"_21648":55283,"_28426":55284,"_3090":55285},[],"/docs/platform/iot-fleets/integrations/aws-iot-core#none-mode","`none` mode",{"_3640":1357,"_31229":1343,"_5":31564,"_21648":55287,"_28426":55288,"_3090":55289},[],"/docs/platform/iot-fleets/integrations/aws-iot-core#auto-mode","`auto` mode",{"_3640":1358,"_31229":1343,"_5":31564,"_21648":55291,"_28426":55292,"_3090":55293},[],"/docs/platform/iot-fleets/integrations/aws-iot-core#jitp-mode","`jitp` mode",{"_3640":1359,"_31229":1343,"_5":31564,"_21648":55295,"_28426":55296,"_3090":55297},[],"/docs/platform/iot-fleets/integrations/aws-iot-core#dms-registration-mode-states","DMS registration-mode states",{"_3640":1360,"_31229":1343,"_5":31564,"_21648":55299,"_28426":55300,"_3090":55301},[],"/docs/platform/iot-fleets/integrations/aws-iot-core#device-provisioning-automatic-mode","Device provisioning (automatic mode)",{"_3640":1361,"_31229":1343,"_5":31564,"_21648":55303,"_28426":55304,"_3090":55305},[],"/docs/platform/iot-fleets/integrations/aws-iot-core#thing-lifecycle","Thing lifecycle",{"_3640":1362,"_31229":1343,"_5":31564,"_21648":55307,"_28426":55308,"_3090":55309},[],"/docs/platform/iot-fleets/integrations/aws-iot-core#device-provisioning-jitp-mode","Device provisioning (JITP mode)",{"_3640":1363,"_31229":1343,"_5":31564,"_21648":55311,"_28426":55312,"_3090":55313},[],"/docs/platform/iot-fleets/integrations/aws-iot-core#certificate-status-synchronization","Certificate status synchronization",{"_3640":1364,"_31229":1343,"_5":31564,"_21648":55315,"_28426":55316,"_3090":55317},[],"/docs/platform/iot-fleets/integrations/aws-iot-core#certificate-status-states","Certificate status states",{"_3640":1365,"_31229":1343,"_5":31564,"_21648":55319,"_28426":55320,"_3090":55321},[],"/docs/platform/iot-fleets/integrations/aws-iot-core#forced-disconnect-on-revocation","Forced disconnect on revocation",{"_3640":1366,"_31229":1343,"_5":31564,"_21648":55323,"_28426":55324,"_3090":55325},[],"/docs/platform/iot-fleets/integrations/aws-iot-core#device-shadow-and-automation","Device Shadow and automation",{"_3640":1367,"_31229":1343,"_5":31564,"_21648":55327,"_28426":55328,"_3090":55329},[],"/docs/platform/iot-fleets/integrations/aws-iot-core#what-the-connector-writes-to-the-shadow","What the connector writes to the shadow",{"_3640":1368,"_31229":1343,"_5":31564,"_21648":55331,"_28426":55332,"_3090":55333},[],"/docs/platform/iot-fleets/integrations/aws-iot-core#aws-iot-policies","AWS IoT policies",{"_3640":1369,"_31229":1343,"_5":31564,"_21648":55335,"_28426":55336,"_3090":55337},[],"/docs/platform/iot-fleets/integrations/aws-iot-core#troubleshooting","Troubleshooting",{"_3640":1370,"_31229":1343,"_21648":55339,"_5":14899,"_28426":1343,"_3090":55340},[],"Lamassu's integration with AWS IoT Core bridges the PKI managed by Lamassu and AWS's connectivity platform. When a device obtains its certificate through the EST enrollment process, the connector ensures that certificate and its associated identity are recognized in AWS IoT Core without manual intervention. The result is that the device can authenticate directly to AWS with the same X.509 certificate Lamassu issued.",{"_3640":1371,"_31229":1343,"_21648":55342,"_5":14899,"_28426":1343,"_3090":55343},[],"From a protocol standpoint, the device authenticates to AWS IoT Core via mutual TLS (mTLS): it presents its Lamassu-issued X.509 certificate as the client certificate, and AWS IoT Core verifies the certificate chain up to the CA registered in the account. Lamassu acts as the certification authority (CA); the connector ensures that CA is registered in AWS and that the device's certificate is known to the platform before the device attempts to connect (in `auto` mode) or on its first connection (in JITP mode).",{"_3640":1372,"_31229":1343,"_21648":55345,"_5":14899,"_28426":1343,"_3090":55346},[],"This document is aimed both at the PKI administrator, who needs to configure the connector and register CAs, and at the device firmware developer, who needs to understand how Things are named, how the Device Shadow works and what happens when a certificate is revoked. For the firmware developer, the most important fact is that **the AWS Thing name (ThingName) always corresponds to the Common Name (CN) of the certificate issued by Lamassu**, regardless of the provisioning mode.",{"_3640":1373,"_31229":1343,"_21648":55348,"_5":14899,"_28426":55240,"_3090":55349},[],"The AWS IoT Core connector is an independent Go process, a binary or container separate from Lamassu's core. In a monolithic deployment it is compiled by default (build tag `!noaws`) and activated with `aws_iot_manager.enabled: true` in the configuration file. In distributed deployments, it runs as its own container with access to Lamassu's CA, DMS Manager and Device Manager services over HTTP.",{"_3640":1374,"_31229":1343,"_21648":55351,"_5":14899,"_28426":55240,"_3090":55352},[],"The connector does not poll Lamassu's services periodically. Instead, it **subscribes to Lamassu's internal event bus** (AMQP or AWS SQS/SNS, configurable) and reacts to the events it cares about: CA creation or update, DMS creation or update, device identity binding, certificate status change, certificate metadata update and device metadata update. This event-driven model ensures synchronization with AWS is nearly immediate and produces no polling load.",{"_3640":1375,"_31229":1343,"_21648":55354,"_5":14899,"_28426":55240,"_3090":55355},[],"To avoid infinite loops, the connector ignores any event whose CloudEvent `source` field matches its own origin URI. This prevents the metadata writes the connector itself performs from re-triggering the same flow.",{"_3640":1376,"_31229":1343,"_21648":55357,"_5":14899,"_28426":55240,"_3090":55358},[],"When several connectors run in parallel, for example for different AWS accounts, each instance has its own `connector_id`. All metadata the connector writes to Lamassu is stored under the key `lamassu.io/iot/{connector_id}`, allowing coexistence without collisions.",{"_3640":1377,"_31229":1343,"_21648":55360,"_5":14899,"_28426":55244,"_3090":55361},[],"Before enabling the connector you need an AWS account with the proper IAM permissions and the connector correctly configured. The deployment process (Docker Compose, Kubernetes or binary) is described in the deployment documentation.",{"_3640":1378,"_31229":1343,"_21648":55363,"_5":14899,"_28426":55248,"_3090":55364},[],"The IAM identity operating the connector needs at minimum the following permissions on the target account's resources:",{"_3640":1379,"_31229":1343,"_21648":55366,"_5":14899,"_28426":55248,"_3090":55367},[],"IAM action",{"_3640":1380,"_31229":1343,"_21648":55369,"_5":14899,"_28426":55248,"_3090":51444},[],{"_3640":1381,"_31229":1343,"_21648":55371,"_5":14899,"_28426":55248,"_3090":55372},[],"`iot:GetRegistrationCode`",{"_3640":1382,"_31229":1343,"_21648":55374,"_5":14899,"_28426":55248,"_3090":55375},[],"Obtain the verification code for CA registration in the Primary Account",{"_3640":1383,"_31229":1343,"_21648":55377,"_5":14899,"_28426":55248,"_3090":55378},[],"`iot:RegisterCACertificate`",{"_3640":1384,"_31229":1343,"_21648":55380,"_5":14899,"_28426":55248,"_3090":55381},[],"Register the CA in AWS IoT",{"_3640":1385,"_31229":1343,"_21648":55383,"_5":14899,"_28426":55248,"_3090":55384},[],"`iot:DescribeCACertificate`",{"_3640":1386,"_31229":1343,"_21648":55386,"_5":14899,"_28426":55248,"_3090":55387},[],"Check the CA registration status",{"_3640":1387,"_31229":1343,"_21648":55389,"_5":14899,"_28426":55248,"_3090":55390},[],"`iot:CreateThing` / `iot:UpdateThing`",{"_3640":1388,"_31229":1343,"_21648":55392,"_5":14899,"_28426":55248,"_3090":55393},[],"Create or update Things in IoT Core",{"_3640":1389,"_31229":1343,"_21648":55395,"_5":14899,"_28426":55248,"_3090":55396},[],"`iot:RegisterThing`",{"_3640":1390,"_31229":1343,"_21648":55398,"_5":14899,"_28426":55248,"_3090":55399},[],"Provision Things through a template",{"_3640":1391,"_31229":1343,"_21648":55401,"_5":14899,"_28426":55248,"_3090":55402},[],"`iot:RegisterCertificate`",{"_3640":1392,"_31229":1343,"_21648":55404,"_5":14899,"_28426":55248,"_3090":55405},[],"Register device certificates",{"_3640":1393,"_31229":1343,"_21648":55407,"_5":14899,"_28426":55248,"_3090":55408},[],"`iot:UpdateCertificate`",{"_3640":1394,"_31229":1343,"_21648":55410,"_5":14899,"_28426":55248,"_3090":55411},[],"Change a certificate's status (ACTIVE / INACTIVE / REVOKED)",{"_3640":1395,"_31229":1343,"_21648":55413,"_5":14899,"_28426":55248,"_3090":55414},[],"`iot:CreatePolicy` / `iot:AttachPolicy`",{"_3640":1396,"_31229":1343,"_21648":55416,"_5":14899,"_28426":55248,"_3090":55417},[],"Create and attach IoT policies",{"_3640":1397,"_31229":1343,"_21648":55419,"_5":14899,"_28426":55248,"_3090":55420},[],"`iot:CreateThingGroup` / `iot:AddThingToThingGroup`",{"_3640":1398,"_31229":1343,"_21648":55422,"_5":14899,"_28426":55248,"_3090":55423},[],"Manage Thing groups",{"_3640":1399,"_31229":1343,"_21648":55425,"_5":14899,"_28426":55248,"_3090":55426},[],"`iot:CreateProvisioningTemplate`",{"_3640":1400,"_31229":1343,"_21648":55428,"_5":14899,"_28426":55248,"_3090":55429},[],"Create JITP templates",{"_3640":1401,"_31229":1343,"_21648":55431,"_5":14899,"_28426":55248,"_3090":55432},[],"`iotdata:GetThingShadow` / `iotdata:UpdateThingShadow`",{"_3640":1402,"_31229":1343,"_21648":55434,"_5":14899,"_28426":55248,"_3090":55435},[],"Read and write the Device Shadow",{"_3640":1403,"_31229":1343,"_21648":55437,"_5":14899,"_28426":55248,"_3090":55438},[],"The forced-disconnect mechanism after revocation also requires access to the AWS IoT data plane API (`iot:Connect` with SigV4 over WebSocket), negotiated implicitly with the connector's credentials.",{"_3640":1404,"_31229":1343,"_21648":55440,"_5":14899,"_28426":55252,"_3090":55441},[],"Parameter",{"_3640":1405,"_31229":1343,"_21648":55443,"_5":14899,"_28426":55252,"_3090":55444},[],"Type",{"_3640":1406,"_31229":1343,"_21648":55446,"_5":14899,"_28426":55252,"_3090":55447},[],"Required",{"_3640":1407,"_31229":1343,"_21648":55449,"_5":14899,"_28426":55252,"_3090":55450},[],"Description",{"_3640":1408,"_31229":1343,"_21648":55452,"_5":14899,"_28426":55252,"_3090":55453},[],"`connector_id`",{"_3640":1409,"_31229":1343,"_21648":55455,"_5":14899,"_28426":55252,"_3090":25835},[],{"_3640":1410,"_31229":1343,"_21648":55457,"_5":14899,"_28426":55252,"_3090":55458},[],"Yes",{"_3640":1411,"_31229":1343,"_21648":55460,"_5":14899,"_28426":55252,"_3090":55461},[],"Unique identifier of this connector instance. Used as the metadata namespace: `lamassu.io/iot/{connector_id}`.",{"_3640":1412,"_31229":1343,"_21648":55463,"_5":14899,"_28426":55252,"_3090":55464},[],"`aws_config.region`",{"_3640":1413,"_31229":1343,"_21648":55466,"_5":14899,"_28426":55252,"_3090":25835},[],{"_3640":1414,"_31229":1343,"_21648":55468,"_5":14899,"_28426":55252,"_3090":55458},[],{"_3640":1415,"_31229":1343,"_21648":55470,"_5":14899,"_28426":55252,"_3090":55471},[],"AWS region where the connector operates.",{"_3640":1416,"_31229":1343,"_21648":55473,"_5":14899,"_28426":55252,"_3090":55474},[],"`aws_config.auth_method`",{"_3640":1417,"_31229":1343,"_21648":55476,"_5":14899,"_28426":55252,"_3090":25835},[],{"_3640":1418,"_31229":1343,"_21648":55478,"_5":14899,"_28426":55252,"_3090":55458},[],{"_3640":1419,"_31229":1343,"_21648":55480,"_5":14899,"_28426":55252,"_3090":55481},[],"Authentication method: `static`, `role` or empty (SDK default credential chain).",{"_3640":1420,"_31229":1343,"_21648":55483,"_5":14899,"_28426":55252,"_3090":55484},[],"`aws_config.access_key_id`",{"_3640":1421,"_31229":1343,"_21648":55486,"_5":14899,"_28426":55252,"_3090":25835},[],{"_3640":1422,"_31229":1343,"_21648":55488,"_5":14899,"_28426":55252,"_3090":55489},[],"Only with `auth_method=static`",{"_3640":1423,"_31229":1343,"_21648":55491,"_5":14899,"_28426":55252,"_3090":55492},[],"AWS access key.",{"_3640":1424,"_31229":1343,"_21648":55494,"_5":14899,"_28426":55252,"_3090":55495},[],"`aws_config.secret_access_key`",{"_3640":1425,"_31229":1343,"_21648":55497,"_5":14899,"_28426":55252,"_3090":25835},[],{"_3640":1426,"_31229":1343,"_21648":55499,"_5":14899,"_28426":55252,"_3090":55489},[],{"_3640":1427,"_31229":1343,"_21648":55501,"_5":14899,"_28426":55252,"_3090":55502},[],"AWS secret key.",{"_3640":1428,"_31229":1343,"_21648":55504,"_5":14899,"_28426":55252,"_3090":55505},[],"`aws_config.session_token`",{"_3640":1429,"_31229":1343,"_21648":55507,"_5":14899,"_28426":55252,"_3090":25835},[],{"_3640":1430,"_31229":1343,"_21648":55509,"_5":14899,"_28426":55252,"_3090":55510},[],"No",{"_3640":1431,"_31229":1343,"_21648":55512,"_5":14899,"_28426":55252,"_3090":55513},[],"Session token (with `auth_method=static`).",{"_3640":1432,"_31229":1343,"_21648":55515,"_5":14899,"_28426":55252,"_3090":55516},[],"`aws_config.role_arn`",{"_3640":1433,"_31229":1343,"_21648":55518,"_5":14899,"_28426":55252,"_3090":25835},[],{"_3640":1434,"_31229":1343,"_21648":55520,"_5":14899,"_28426":55252,"_3090":55521},[],"Only with `auth_method=role`",{"_3640":1435,"_31229":1343,"_21648":55523,"_5":14899,"_28426":55252,"_3090":55524},[],"ARN of the role to assume.",{"_3640":1436,"_31229":1343,"_21648":55526,"_5":14899,"_28426":55252,"_3090":55527},[],"`aws_config.endpoint_url`",{"_3640":1437,"_31229":1343,"_21648":55529,"_5":14899,"_28426":55252,"_3090":25835},[],{"_3640":1438,"_31229":1343,"_21648":55531,"_5":14899,"_28426":55252,"_3090":55510},[],{"_3640":1439,"_31229":1343,"_21648":55533,"_5":14899,"_28426":55252,"_3090":55534},[],"Alternative URL for all AWS services (useful with LocalStack in tests).",{"_3640":1440,"_31229":1343,"_21648":55536,"_5":14899,"_28426":55252,"_3090":55537},[],"`subscriber_event_bus`",{"_3640":1441,"_31229":1343,"_21648":55539,"_5":14899,"_28426":55252,"_3090":18256},[],{"_3640":1442,"_31229":1343,"_21648":55541,"_5":14899,"_28426":55252,"_3090":55458},[],{"_3640":1443,"_31229":1343,"_21648":55543,"_5":14899,"_28426":55252,"_3090":55544},[],"Configuration of the event bus the connector subscribes to (AMQP or AWS SQS/SNS).",{"_3640":1444,"_31229":1343,"_21648":55546,"_5":14899,"_28426":55252,"_3090":55547},[],"`dms_manager_client`",{"_3640":1445,"_31229":1343,"_21648":55549,"_5":14899,"_28426":55252,"_3090":25835},[],{"_3640":1446,"_31229":1343,"_21648":55551,"_5":14899,"_28426":55252,"_3090":55458},[],{"_3640":1447,"_31229":1343,"_21648":55553,"_5":14899,"_28426":55252,"_3090":55554},[],"HTTP URL of Lamassu's DMS Manager service.",{"_3640":1448,"_31229":1343,"_21648":55556,"_5":14899,"_28426":55252,"_3090":55557},[],"`device_manager_client`",{"_3640":1449,"_31229":1343,"_21648":55559,"_5":14899,"_28426":55252,"_3090":25835},[],{"_3640":1450,"_31229":1343,"_21648":55561,"_5":14899,"_28426":55252,"_3090":55458},[],{"_3640":1451,"_31229":1343,"_21648":55563,"_5":14899,"_28426":55252,"_3090":55564},[],"HTTP URL of Lamassu's Device Manager.",{"_3640":1452,"_31229":1343,"_21648":55566,"_5":14899,"_28426":55252,"_3090":55567},[],"`ca_client`",{"_3640":1453,"_31229":1343,"_21648":55569,"_5":14899,"_28426":55252,"_3090":25835},[],{"_3640":1454,"_31229":1343,"_21648":55571,"_5":14899,"_28426":55252,"_3090":55458},[],{"_3640":1455,"_31229":1343,"_21648":55573,"_5":14899,"_28426":55252,"_3090":55574},[],"HTTP URL of Lamassu's CA service.",{"_3640":1456,"_31229":1343,"_21648":55576,"_5":14899,"_28426":55256,"_3090":55577},[],"The connector owns the AWS side of four resource types — CAs, DMS provisioning templates (JITP), device certificates and Things. This section maps the bus events the connector consumes to the AWS resources they touch and to the AWS calls each flow performs. The state machine of each resource lives next to its detailed explanation; the last column links to it. AWS resources are referenced with the notation `IoTCore/<resource>`.",{"_3640":1457,"_31229":1343,"_21648":55579,"_5":14899,"_28426":55256,"_3090":55580},[],"The **CloudEvent type** column lists the event name on Lamassu's internal event bus; the **IAM actions** column lists the exact AWS SDK operations each flow invokes, so the required permissions can be derived directly from this table.",{"_3640":1458,"_31229":1343,"_21648":55582,"_5":14899,"_28426":55256,"_3090":55583},[],"CloudEvent type",{"_3640":1459,"_31229":1343,"_21648":55585,"_5":14899,"_28426":55256,"_3090":55586},[],"Lamassu resource",{"_3640":1460,"_31229":1343,"_21648":55588,"_5":14899,"_28426":55256,"_3090":55589},[],"AWS Resource",{"_3640":1461,"_31229":1343,"_21648":55591,"_5":14899,"_28426":55256,"_3090":55592},[],"IAM actions",{"_3640":1462,"_31229":1343,"_21648":55594,"_5":14899,"_28426":55256,"_3090":55595},[],"AWS calls and effect",{"_3640":1463,"_31229":1343,"_21648":55597,"_5":14899,"_28426":55256,"_3090":55598},[],"Where in this page",{"_3640":1464,"_31229":1343,"_21648":55600,"_5":14899,"_28426":55256,"_3090":55601},[],"`EventCreateCAKey` / `EventImportCAKey` / `EventUpdateCAMetadataKey`",{"_3640":1465,"_31229":1343,"_21648":55603,"_5":14899,"_28426":55256,"_3090":55604},[],"CA",{"_3640":1466,"_31229":1343,"_21648":55606,"_5":14899,"_28426":55256,"_3090":55607},[],"`IoTCore/CACertificate`",{"_3640":1467,"_31229":1343,"_21648":55609,"_5":14899,"_28426":55256,"_3090":55610},[],"`iot:GetRegistrationCode`, `iot:RegisterCACertificate`, `iot:DescribeCACertificate`, `iot:ListCACertificates`",{"_3640":1468,"_31229":1343,"_21648":55612,"_5":14899,"_28426":55256,"_3090":55613},[],"Loads the CA into connector state; a `registration.status = REQUESTED` write fires the registration flow (Primary with verification certificate, or SNI-only) and writes `SUCCEEDED` or `FAILED` back to the CA's metadata.",{"_3640":1469,"_31229":1343,"_21648":55615,"_5":14899,"_28426":55256,"_3090":55269},[],{"_3640":1470,"_31229":1343,"_21648":55617,"_5":14899,"_28426":55256,"_3090":55618},[],"`EventCreateDMSKey` / `EventUpdateDMSKey`",{"_3640":1471,"_31229":1343,"_21648":55620,"_5":14899,"_28426":55256,"_3090":55621},[],"DMS",{"_3640":1472,"_31229":1343,"_21648":55623,"_5":14899,"_28426":55256,"_3090":55624},[],"`IoTCore/ProvisioningTemplate`",{"_3640":1473,"_31229":1343,"_21648":55626,"_5":14899,"_28426":55256,"_3090":55627},[],"`iot:CreateProvisioningTemplate`, `iot:UpdateCACertificate`",{"_3640":1474,"_31229":1343,"_21648":55629,"_5":14899,"_28426":55256,"_3090":55630},[],"In `jitp` mode, attempts to create the provisioning template and attaches it to the registered CA. Non-idempotent: a `PUT /v1/dms/{id}` edit retries the creation and lands in `lamassu-dlq` after 3 retries. Idempotent for `none` and `auto` (configuration only).",{"_3640":1475,"_31229":1343,"_21648":55632,"_5":14899,"_28426":55256,"_3090":55297},[],{"_3640":1476,"_31229":1343,"_21648":55634,"_5":14899,"_28426":55256,"_3090":55635},[],"`EventBindDeviceIdentityKey`",{"_3640":1477,"_31229":1343,"_21648":55637,"_5":14899,"_28426":55256,"_3090":55638},[],"Device",{"_3640":1478,"_31229":1343,"_21648":55640,"_5":14899,"_28426":55256,"_3090":55641},[],"`IoTCore/Policy`, `IoTCore/ThingGroup`, `IoTCore/Thing`",{"_3640":1479,"_31229":1343,"_21648":55643,"_5":14899,"_28426":55256,"_3090":55644},[],"`iot:CreatePolicy` / `iot:DeletePolicyVersion`, `iot:GetPolicy` / `iot:ListPolicyVersions`, `iot:CreateThingGroup`, `iot:DescribeThing` / `iot:ListThingPrincipals`, `iot:RegisterThing`",{"_3640":1480,"_31229":1343,"_21648":55646,"_5":14899,"_28426":55256,"_3090":55647},[],"In `auto` mode: creates/updates policies, ensures Thing groups, revokes stale principals and provisions the Thing via `iot:RegisterThing`. In `jitp` mode: no AWS calls; AWS runs the JITP template on first connection.",{"_3640":1481,"_31229":1343,"_21648":55649,"_5":14899,"_28426":55256,"_3090":55305},[],{"_3640":1482,"_31229":1343,"_21648":55651,"_5":14899,"_28426":55256,"_3090":55652},[],"`EventUpdateCertificateStatusKey`",{"_3640":1483,"_31229":1343,"_21648":55654,"_5":14899,"_28426":55256,"_3090":55655},[],"Certificate",{"_3640":1484,"_31229":1343,"_21648":55657,"_5":14899,"_28426":55256,"_3090":55658},[],"`IoTCore/Certificate`",{"_3640":1485,"_31229":1343,"_21648":55660,"_5":14899,"_28426":55256,"_3090":55661},[],"`iot:UpdateCertificate`, `iot:Connect` (data plane)",{"_3640":1486,"_31229":1343,"_21648":55663,"_5":14899,"_28426":55256,"_3090":55664},[],"Maps status to AWS (`ACTIVE`, `INACTIVE`, `REVOKED`), calls `iot:UpdateCertificate` and forces an MQTT disconnect on revoke.",{"_3640":1487,"_31229":1343,"_21648":55666,"_5":14899,"_28426":55256,"_3090":55317},[],{"_3640":1488,"_31229":1343,"_21648":55668,"_5":14899,"_28426":55256,"_3090":55669},[],"`EventUpdateCertificateMetadataKey` / `EventUpdateDeviceMetadataKey`",{"_3640":1489,"_31229":1343,"_21648":55671,"_5":14899,"_28426":55256,"_3090":55672},[],"Certificate / Device",{"_3640":1490,"_31229":1343,"_21648":55674,"_5":14899,"_28426":55256,"_3090":55675},[],"`IoTCore/Certificate`, `IoTCore/Thing`",{"_3640":1491,"_31229":1343,"_21648":55677,"_5":14899,"_28426":55256,"_3090":51450},[],{"_3640":1492,"_31229":1343,"_21648":55679,"_5":14899,"_28426":55256,"_3090":55680},[],"Refreshes internal state; the connector ignores events whose CloudEvent `source` matches its own URI to avoid self-triggered loops.",{"_3640":1493,"_31229":1343,"_21648":55682,"_5":14899,"_28426":55256,"_3090":55325},[],{"_3640":1494,"_31229":1343,"_21648":55684,"_5":14899,"_28426":55260,"_3090":55685},[],"For devices to authenticate to AWS IoT Core with certificates issued by a Lamassu CA, that CA must first be registered in the AWS account. The connector handles this registration automatically in response to the `EventCreateCAKey`, `EventImportCAKey` and `EventUpdateCAMetadataKey` events, but the operation **only fires when the administrator explicitly requests it** through the CA metadata field.",{"_3640":1495,"_31229":1343,"_21648":55687,"_5":14899,"_28426":55264,"_3090":55688},[],"Registration is triggered by setting `registration.status = \"REQUESTED\"` on the `lamassu.io/iot/{connector_id}` key of the CA's metadata. This can be done from the Lamassu console in the CA management section or through the API.",{"_3640":1496,"_31229":1343,"_21648":55690,"_5":14899,"_28426":55264,"_3090":55691},[],"Once the event is received, the connector attempts to register the CA in AWS and updates the `registration.status` field in the CA's metadata with the result: `\"SUCCEEDED\"` if registration was successful, or `\"FAILED\"` with an error message otherwise. The process is asynchronous, so you must periodically check the metadata status until the operation completes.",{"_3640":1497,"_31229":1343,"_21648":55693,"_5":14899,"_28426":55268,"_3090":55694},[],"The CA registration flow is driven by the `registration.status` field of the CA's connector metadata:",{"_3640":1498,"_31229":1343,"_21648":55696,"_5":14899,"_28426":55268,"_3090":55697},[],"Transition",{"_3640":1499,"_31229":1343,"_21648":55699,"_5":14899,"_28426":55268,"_3090":55700},[],"AWS calls",{"_3640":1500,"_31229":1343,"_21648":55702,"_5":14899,"_28426":55268,"_3090":55703},[],"`NotRegistered` → `Requested`",{"_3640":1501,"_31229":1343,"_21648":55705,"_5":14899,"_28426":55268,"_3090":55706},[],"none (metadata write only)",{"_3640":1502,"_31229":1343,"_21648":55708,"_5":14899,"_28426":55268,"_3090":55709},[],"`Requested` → `Registering`",{"_3640":1503,"_31229":1343,"_21648":55711,"_5":14899,"_28426":55268,"_3090":55712},[],"`iot:GetRegistrationCode` (Primary Account only)",{"_3640":1504,"_31229":1343,"_21648":55714,"_5":14899,"_28426":55268,"_3090":55715},[],"`Registering` → `Succeeded`",{"_3640":1505,"_31229":1343,"_21648":55717,"_5":14899,"_28426":55268,"_3090":55718},[],"`iot:RegisterCACertificate` (Primary: proof-of-possession with an ephemeral key; SNI-only: `CertificateMode: SNI_ONLY`)",{"_3640":1506,"_31229":1343,"_21648":55720,"_5":14899,"_28426":55268,"_3090":55721},[],"`Registering` → `Failed`",{"_3640":1507,"_31229":1343,"_21648":55723,"_5":14899,"_28426":55268,"_3090":55724},[],"failed `iot:RegisterCACertificate`; the error detail is written to the CA's metadata",{"_3640":1508,"_31229":1343,"_21648":55726,"_5":14899,"_28426":55268,"_3090":55727},[],"`Failed` / `Succeeded` → `Requested`",{"_3640":1509,"_31229":1343,"_21648":55729,"_5":14899,"_28426":55268,"_3090":55730},[],"none (a new `REQUESTED` write re-runs the flow)",{"_3640":1510,"_31229":1343,"_21648":55732,"_5":14899,"_28426":55272,"_3090":55733},[],"When the `primary_account` parameter is `true`, the connector runs the full registration flow with proof-of-possession of the private key:",{"_3640":1511,"_31229":1343,"_21648":55735,"_5":14899,"_28426":55272,"_3090":55736},[],"It calls `iot:GetRegistrationCode` to obtain AWS's verification code.",{"_3640":1512,"_31229":1343,"_21648":55738,"_5":14899,"_28426":55272,"_3090":55739},[],"The connector internally generates an ephemeral RSA-2048 key pair and builds a CSR whose Common Name is exactly that registration code. It then calls Lamassu's signing service so the registered CA issues a real X.509 verification certificate signing that CSR. The ephemeral private key is used only for this purpose and is neither stored nor sent to AWS.",{"_3640":1513,"_31229":1343,"_21648":55741,"_5":14899,"_28426":55272,"_3090":55742},[],"It sends the CA (in PEM) and the verification certificate to AWS via `iot:RegisterCACertificate`, enabling registration with `AllowAutoRegistration: true`.",{"_3640":1514,"_31229":1343,"_21648":55744,"_5":14899,"_28426":55272,"_3090":55745},[],"Only one account can own a CA in a given AWS region. If the CA is already registered with the same serial number, the connector silently skips the step.",{"_3640":1515,"_31229":1343,"_21648":55747,"_5":14899,"_28426":55272,"_3090":55748},[],"The tags AWS IoT Core applies to the registered CA certificate are `LMS.CA.ID`, `LMS.CA.SN` and `LMS.CA.CN`.",{"_3640":1516,"_31229":1343,"_21648":55750,"_5":14899,"_28426":55276,"_3090":55751},[],"When `primary_account` is `false`, the connector registers the CA using `CertificateMode: SNI_ONLY`. This mode requires no verification code or access to the CA's private key, so it is the right choice when the CA is managed from another AWS account or when the administrator does not hold the private key. It is the usual method to register the same CA in several AWS accounts simultaneously.",{"_3640":1517,"_31229":1343,"_21648":55753,"_5":14899,"_28426":55280,"_3090":55754},[],"Each DMS participating in the AWS IoT Core integration must have the metadata key `lamassu.io/iot/{connector_id}` configured. The most important field of that configuration is `registration_mode`, which determines how devices are provisioned in AWS.",{"_3640":1518,"_31229":1343,"_21648":55756,"_5":14899,"_28426":55280,"_3090":55757},[],"There are three registration modes, and the choice among them depends on the fleet's provisioning strategy.",{"_3640":1519,"_31229":1343,"_21648":55759,"_5":14899,"_28426":55284,"_3090":55760},[],"In this mode the connector **creates no Things, groups or policies** in AWS IoT Core. It only syncs certificate status (active, revoked, suspended) as it changes in Lamassu. It is the right mode when Thing provisioning in AWS is managed by an external system and Lamassu only needs to keep certificate status up to date.",{"_3640":1520,"_31229":1343,"_21648":55762,"_5":14899,"_28426":55288,"_3090":55763},[],"`auto` mode delegates full device provisioning in AWS to Lamassu at enrollment time. When the device successfully completes its EST enrollment and Lamassu emits the `EventBindDeviceIdentityKey` event, the connector automatically executes the following sequence:",{"_3640":1521,"_31229":1343,"_21648":55765,"_5":14899,"_28426":55288,"_3090":55766},[],"Creates or updates the IoT policies configured in the DMS.",{"_3640":1522,"_31229":1343,"_21648":55768,"_5":14899,"_28426":55288,"_3090":55769},[],"Creates the root group `LAMASSU` in the AWS account (if it does not exist) and the child groups configured in the DMS as subgroups of `LAMASSU`. If the groups already exist, the `ResourceAlreadyExistsException` error is ignored, making the operation idempotent.",{"_3640":1523,"_31229":1343,"_21648":55771,"_5":14899,"_28426":55288,"_3090":55772},[],"If the Thing already existed in AWS IoT Core, the connector iterates all certificates (principals) currently attached to that Thing and marks them as `REVOKED` in AWS, ensuring previous certificates cannot keep being used to authenticate.",{"_3640":1524,"_31229":1343,"_21648":55774,"_5":14899,"_28426":55288,"_3090":55775},[],"Calls `iot:RegisterThing` with a CloudFormation-style provisioning template that creates the Thing, registers the device's certificate (PEM of the device certificate and of the issuing CA certificate) and attaches the configured policies.",{"_3640":1525,"_31229":1343,"_21648":55777,"_5":14899,"_28426":55288,"_3090":55778},[],"Once provisioning completes, the connector stores the resulting certificate's ARN in the Lamassu certificate's metadata under the key `lamassu.io/iot/{connector_id}` and marks the device as `Registered: true` in Device Manager.",{"_3640":1526,"_31229":1343,"_21648":55780,"_5":14899,"_28426":55288,"_3090":55781},[],"**The Thing name in AWS is the Common Name (CN) of the device's certificate.** This convention is fundamental for the firmware developer: the `/CN=` value the device includes in its CSR when enrolling becomes the ThingName it must identify itself with in all MQTT operations against AWS IoT Core.",{"_3640":1527,"_31229":1343,"_21648":55783,"_5":14899,"_28426":55292,"_3090":55784},[],"Just-In-Time Provisioning (JITP) mode delegates provisioning to AWS instead of the connector doing it directly. When the connector detects the DMS is in `jitp` mode, it creates a JITP provisioning template in AWS IoT Core and attaches it to the registered CA certificate. The connector attempts to create this template when the DMS is created and again on every full DMS edit (`PUT /v1/dms/{id}`) — not at device enrollment time. The attempt is not idempotent: when a template named after the DMS ID already exists, the creation call fails, the event is retried three times and finally lands in the `lamassu-dlq` poison queue (see Troubleshooting). The template is created once; later DMS edits never update its content. A DMS update that omits `metadata` or sends `null` keeps the stored metadata, so the connector key `lamassu.io/iot/{connector_id}` remains present and the attempt is still triggered. A body that supplies a `metadata` object replaces the stored metadata entirely: if that object does not carry the connector key, the key is dropped and the connector silently skips the DMS's future events. Once the template is attached, when a device with a certificate issued by that CA connects to AWS IoT Core for the first time, AWS executes the template automatically: it creates the Thing, registers the certificate and activates it.",{"_3640":1528,"_31229":1343,"_21648":55786,"_5":14899,"_28426":55292,"_3090":55787},[],"The connector creates the template, named after the DMS ID, only once. Each later edit of the DMS that keeps the connector key tries to create it again and fails, because the connector does not update existing templates. Later changes to `jitp_config.provisioning_role_arn`, `jitp_config.enable_template` or to the groups and policies the template references must be applied by hand in AWS IoT Core.",{"_3640":1529,"_31229":1343,"_21648":55789,"_5":14899,"_28426":55292,"_3090":55790},[],"The failed event is retried and ends in `lamassu-dlq`. Groups and policies are registered before the failure, but the assignment of the template to the registered CA, the write-back of the ARN to the DMS and the shadow update when `ManagedCAs` changes are skipped.",{"_3640":1530,"_31229":1343,"_21648":55792,"_5":14899,"_28426":55292,"_3090":55793},[],"The Thing name in the JITP template is derived from `AWS::IoT::Certificate::CommonName`, which corresponds to the device certificate's CN — the same convention as `auto` mode.",{"_3640":1531,"_31229":1343,"_21648":55795,"_5":14899,"_28426":55292,"_3090":55796},[],"This mode requires the `jitp_config.provisioning_role_arn` field to be configured with the ARN of an IAM role AWS IoT Core can assume to execute the template. If not configured, the connector uses the default `arn:aws:iam::{account}:role/JITPRole` and logs a warning. The administrator must ensure that role exists in the account and has the necessary permissions before enabling JITP mode.",{"_3640":1532,"_31229":1343,"_21648":55798,"_5":14899,"_28426":55296,"_3090":55799},[],"The DMS's `registration_mode` determines what the connector does on the AWS side when the DMS is created or fully edited:",{"_3640":1533,"_31229":1343,"_21648":55801,"_5":14899,"_28426":55296,"_3090":55697},[],{"_3640":1534,"_31229":1343,"_21648":55803,"_5":14899,"_28426":55296,"_3090":55700},[],{"_3640":1535,"_31229":1343,"_21648":55805,"_5":14899,"_28426":55296,"_3090":55806},[],"`Unconfigured` → `None` / `Auto`",{"_3640":1536,"_31229":1343,"_21648":55808,"_5":14899,"_28426":55296,"_3090":55809},[],"none (configuration only)",{"_3640":1537,"_31229":1343,"_21648":55811,"_5":14899,"_28426":55296,"_3090":55812},[],"`None` ↔ `Auto`",{"_3640":1538,"_31229":1343,"_21648":55814,"_5":14899,"_28426":55296,"_3090":55809},[],{"_3640":1539,"_31229":1343,"_21648":55816,"_5":14899,"_28426":55296,"_3090":55817},[],"Any → `Jitp`",{"_3640":1540,"_31229":1343,"_21648":55819,"_5":14899,"_28426":55296,"_3090":55820},[],"`iot:CreateProvisioningTemplate` (non-idempotent: it fails when the template already exists; after 3 retries the event lands in `lamassu-dlq`)",{"_3640":1541,"_31229":1343,"_21648":55822,"_5":14899,"_28426":55296,"_3090":55823},[],"`Jitp` → `None` / `Auto`",{"_3640":1542,"_31229":1343,"_21648":55825,"_5":14899,"_28426":55296,"_3090":55826},[],"none (the template stays in the AWS account)",{"_3640":1543,"_31229":1343,"_21648":55828,"_5":14899,"_28426":55300,"_3090":55829},[],"For the firmware developer, `auto` mode is transparent: the device performs its EST enrollment as usual and, as a side effect, it is provisioned in AWS IoT Core with no additional step.",{"_3640":1544,"_31229":1343,"_21648":55831,"_5":14899,"_28426":55300,"_3090":55832},[],"The full flow from the device's perspective is:",{"_3640":1545,"_31229":1343,"_21648":55834,"_5":14899,"_28426":55300,"_3090":55835},[],"Once the connector completes provisioning, the device can connect to the AWS IoT Core MQTT endpoint using its private key and the certificate issued by Lamassu. The ThingName it must identify itself with in AWS is exactly the certificate's CN.",{"_3640":1546,"_31229":1343,"_21648":55837,"_5":14899,"_28426":55304,"_3090":55838},[],"Things only exist under `auto` mode; in `jitp` mode AWS creates the Thing itself when the device first connects. The Thing name is always the device certificate's CN:",{"_3640":1547,"_31229":1343,"_21648":55840,"_5":14899,"_28426":55304,"_3090":55697},[],{"_3640":1548,"_31229":1343,"_21648":55842,"_5":14899,"_28426":55304,"_3090":55700},[],{"_3640":1549,"_31229":1343,"_21648":55844,"_5":14899,"_28426":55304,"_3090":55845},[],"`Absent` → `Provisioned`",{"_3640":1550,"_31229":1343,"_21648":55847,"_5":14899,"_28426":55304,"_3090":55848},[],"policies created/updated, Thing groups ensured, `iot:RegisterThing` (creates the Thing, registers the certificate, attaches policies)",{"_3640":1551,"_31229":1343,"_21648":55850,"_5":14899,"_28426":55304,"_3090":55851},[],"`Provisioned` → `Provisioned` (re-enrollment)",{"_3640":1552,"_31229":1343,"_21648":55853,"_5":14899,"_28426":55304,"_3090":55854},[],"stale principals marked `REVOKED`, new `iot:RegisterThing` run; the new certificate ARN replaces the old one in Lamassu metadata",{"_3640":1553,"_31229":1343,"_21648":55856,"_5":14899,"_28426":55304,"_3090":55857},[],"In `jitp` mode the connector makes no provisioning calls: AWS executes the JITP template on the device's first connection and creates the Thing, registers the certificate and activates it on its own.",{"_3640":1554,"_31229":1343,"_21648":55859,"_5":14899,"_28426":55308,"_3090":55860},[],"In JITP mode the device also performs its EST enrollment conventionally and obtains its certificate from Lamassu. The difference is that AWS IoT Core does not know the device until it attempts its first connection.",{"_3640":1555,"_31229":1343,"_21648":55862,"_5":14899,"_28426":55308,"_3090":55863},[],"When the device establishes its first MQTT connection to AWS IoT Core presenting the Lamassu-issued certificate, AWS detects that the certificate belongs to a CA registered with a JITP template, executes that template and creates the Thing automatically. The initial connection may fail or be delayed while the template runs; firmware must be prepared to retry the connection.",{"_3640":1556,"_31229":1343,"_21648":55865,"_5":14899,"_28426":55308,"_3090":55866},[],"For the JITP flow to work correctly:",{"_3640":1557,"_31229":1343,"_21648":55868,"_5":14899,"_28426":55308,"_3090":55869},[],"The CA must be registered in AWS in Primary Account mode (SNI-only mode does not support JITP).",{"_3640":1558,"_31229":1343,"_21648":55871,"_5":14899,"_28426":55308,"_3090":55872},[],"The IAM role configured in `jitp_config.provisioning_role_arn` must exist and have permissions to create Things, register certificates and attach policies in the AWS account.",{"_3640":1559,"_31229":1343,"_21648":55874,"_5":14899,"_28426":55308,"_3090":55875},[],"The device must present both its certificate and the issuing CA's certificate in the TLS handshake with AWS IoT Core.",{"_3640":1560,"_31229":1343,"_21648":55877,"_5":14899,"_28426":55308,"_3090":55878},[],"Certificates provisioned via JITP **do not have the connector's metadata key** (`lamassu.io/iot/{connector_id}`) in Lamassu. As a consequence, status changes of those certificates in Lamassu are not automatically synced to AWS through the state synchronization mechanism described in the next section.",{"_3640":1561,"_31229":1343,"_21648":55880,"_5":14899,"_28426":55312,"_3090":55881},[],"The connector listens for the `EventUpdateCertificateStatusKey` event and, when a certificate holding the connector's metadata key changes status in Lamassu, replicates that change in AWS IoT Core. The following table shows the status mapping:",{"_3640":1562,"_31229":1343,"_21648":55883,"_5":14899,"_28426":55312,"_3090":55884},[],"Status in Lamassu",{"_3640":1563,"_31229":1343,"_21648":55886,"_5":14899,"_28426":55312,"_3090":55887},[],"Revocation reason",{"_3640":1564,"_31229":1343,"_21648":55889,"_5":14899,"_28426":55312,"_3090":55890},[],"Status in AWS IoT Core",{"_3640":1565,"_31229":1343,"_21648":55892,"_5":14899,"_28426":55312,"_3090":55893},[],"`Active`",{"_3640":1566,"_31229":1343,"_21648":55895,"_5":14899,"_28426":55312,"_3090":55896},[],"None",{"_3640":1567,"_31229":1343,"_21648":55898,"_5":14899,"_28426":55312,"_3090":55899},[],"`ACTIVE`",{"_3640":1568,"_31229":1343,"_21648":55901,"_5":14899,"_28426":55312,"_3090":55902},[],"`Revoked`",{"_3640":1569,"_31229":1343,"_21648":55904,"_5":14899,"_28426":55312,"_3090":55905},[],"`certificateHold`",{"_3640":1570,"_31229":1343,"_21648":55907,"_5":14899,"_28426":55312,"_3090":55908},[],"`INACTIVE`",{"_3640":1571,"_31229":1343,"_21648":55910,"_5":14899,"_28426":55312,"_3090":55902},[],{"_3640":1572,"_31229":1343,"_21648":55912,"_5":14899,"_28426":55312,"_3090":55913},[],"Any other reason",{"_3640":1573,"_31229":1343,"_21648":55915,"_5":14899,"_28426":55312,"_3090":55916},[],"`REVOKED`",{"_3640":1574,"_31229":1343,"_21648":55918,"_5":14899,"_28426":55312,"_3090":55919},[],"Only the `Active` and `Revoked` states produce a call to `iot:UpdateCertificate`. The other lifecycle states of Lamassu (`RenewalWindow`, `AboutToExpire`, `Expired`) are not synced to AWS IoT Core; the certificate status in AWS remains unchanged until the status in Lamassu becomes `Active` or `Revoked`.",{"_3640":1575,"_31229":1343,"_21648":55921,"_5":14899,"_28426":55316,"_3090":55922},[],"Certificates holding the connector's metadata key sync their status; certificates provisioned via JITP have no metadata key and stay out of this machine:",{"_3640":1576,"_31229":1343,"_21648":55924,"_5":14899,"_28426":55316,"_3090":55697},[],{"_3640":1577,"_31229":1343,"_21648":55926,"_5":14899,"_28426":55316,"_3090":55700},[],{"_3640":1578,"_31229":1343,"_21648":55928,"_5":14899,"_28426":55316,"_3090":55929},[],"`NotSynced` → `Active`",{"_3640":1579,"_31229":1343,"_21648":55931,"_5":14899,"_28426":55316,"_3090":55408},[],{"_3640":1580,"_31229":1343,"_21648":55933,"_5":14899,"_28426":55316,"_3090":55934},[],"`Active` → `Inactive`",{"_3640":1581,"_31229":1343,"_21648":55936,"_5":14899,"_28426":55316,"_3090":55937},[],"`iot:UpdateCertificate` + forced MQTT disconnect",{"_3640":1582,"_31229":1343,"_21648":55939,"_5":14899,"_28426":55316,"_3090":55940},[],"`Active` → `Revoked`",{"_3640":1583,"_31229":1343,"_21648":55942,"_5":14899,"_28426":55316,"_3090":55937},[],{"_3640":1584,"_31229":1343,"_21648":55944,"_5":14899,"_28426":55316,"_3090":55945},[],"`Inactive` / `Revoked` → `Active`",{"_3640":1585,"_31229":1343,"_21648":55947,"_5":14899,"_28426":55316,"_3090":55408},[],{"_3640":1586,"_31229":1343,"_21648":55949,"_5":14899,"_28426":55316,"_3090":55950},[],"`RenewalWindow` / `AboutToExpire` / `Expired`",{"_3640":1587,"_31229":1343,"_21648":55952,"_5":14899,"_28426":55316,"_3090":55953},[],"none (these states are not synced to AWS)",{"_3640":1588,"_31229":1343,"_21648":55955,"_5":14899,"_28426":55320,"_3090":55956},[],"When the connector marks a certificate as `REVOKED` or `INACTIVE` in AWS, it additionally performs a forced disconnect of the device. To do so it opens an MQTT connection over WebSocket (with SigV4 authentication using the connector's credentials) to the AWS IoT Core data endpoint, using the certificate's CN as the MQTT client identifier, and closes it immediately. This terminates any active MQTT session the device may have at that moment.",{"_3640":1589,"_31229":1343,"_21648":55958,"_5":14899,"_28426":55320,"_3090":55959},[],"This forced disconnect happens at the moment Lamassu records the status change. If the device tries to reconnect after the disconnect, AWS IoT Core will reject the connection because the certificate is already listed as `REVOKED` or `INACTIVE`.",{"_3640":1590,"_31229":1343,"_21648":55961,"_5":14899,"_28426":55320,"_3090":55962},[],"Certificates provisioned in JITP mode do not have this automatic sync, since they lack the connector's metadata key.",{"_3640":1591,"_31229":1343,"_21648":55964,"_5":14899,"_28426":55324,"_3090":55965},[],"The connector can write to the AWS IoT Core Device Shadow to send action signals to the device firmware. This feature is enabled per DMS with `shadow_config.enable: true`.",{"_3640":1592,"_31229":1343,"_21648":55967,"_5":14899,"_28426":55324,"_3090":55968},[],"If `shadow_config.shadow_name` holds a value, the connector uses a Named Shadow with that name; otherwise it uses the Classic Shadow (the Thing's default shadow).",{"_3640":1593,"_31229":1343,"_21648":55970,"_5":14899,"_28426":55328,"_3090":55971},[],"The connector writes to the `desired.identity_actions` field of the shadow document. Each entry contains a Unix timestamp in milliseconds. The device firmware must read this field and act accordingly.",{"_3640":1594,"_31229":1343,"_21648":55973,"_5":14899,"_28426":55328,"_3090":55974},[],"There are two action types:",{"_3640":1595,"_31229":1343,"_21648":55976,"_5":14899,"_28426":55328,"_3090":55977},[],"**`UPDATE_CERTIFICATE`**: written when a certificate's preventive renewal window activates — that is, when the `triggered` field of the preventive renewal delta flips from `false` to `true`. This action tells the device it must start the re-enrollment process to renew its certificate before it expires.",{"_3640":1596,"_31229":1343,"_21648":55979,"_5":14899,"_28426":55328,"_3090":55980},[],"**`UPDATE_TRUST_ANCHOR_LIST`**: written to all devices of a DMS when the DMS's `ManagedCAs` list changes. This action tells the device it must update its trusted CA store.",{"_3640":1597,"_31229":1343,"_21648":55982,"_5":14899,"_28426":55328,"_3090":55983},[],"The shadow write process consists of reading the current shadow (`iotdata:GetThingShadow`), merging the new actions with the existing ones and writing the result (`iotdata:UpdateThingShadow`). If the shadow does not exist, the connector creates it. After a successful write, the list of pending actions in the device's metadata in Lamassu is cleared.",{"_3640":1598,"_31229":1343,"_21648":55985,"_5":14899,"_28426":55332,"_3090":55986},[],"The connector creates and attaches the policies configured in the DMS. A typical policy for a device using MQTT and the Device Shadow has this structure:",{"_3640":1599,"_31229":1343,"_21648":55988,"_5":14899,"_28426":55332,"_3090":55989},[],"In the policy above, the `<AWS_REGION>` and `<AWS_ACCOUNT_ID>` placeholders must be replaced with the AWS region and the twelve-digit account identifier of the target account before applying the policy. The `${iot:Connection.Thing.ThingName}` variable automatically limits each permission to the Thing the device is connected as, following the principle of least privilege. The `${ShadowName}` variable in the shadow ARNs is a placeholder that must be replaced with the `shadow_config.shadow_name` value configured in the DMS; if the Classic Shadow is used, it can be simplified by removing the `name/${ShadowName}/` segment. AWS IoT policies do not support regex alternation; the `[name/${ShadowName}/]*` notation represents the optionality of that segment within ARN syntax constraints.",{"_3640":1600,"_31229":1343,"_21648":55991,"_5":14899,"_28426":55332,"_3090":55992},[],"The first statement lets the device connect using its ThingName as the MQTT identifier. The second authorizes publishing to the Thing's generic MQTT topic and to the shadow topics, needed so the device can update its reported state. The last two statements grant subscribe and receive permissions over the same topics, letting the device receive shadow updates (for example, the `UPDATE_CERTIFICATE` and `UPDATE_TRUST_ANCHOR_LIST` actions written by the connector).",{"_3640":1601,"_31229":1343,"_21648":55994,"_5":14899,"_28426":55336,"_3090":55995},[],"**Symptom:** The CA registration stays in `REQUESTED` indefinitely.",{"_3640":1602,"_31229":1343,"_21648":55997,"_5":14899,"_28426":55336,"_3090":55998},[],"**Cause:** The connector is not running or is not subscribed to the event bus. It can also indicate incorrect IAM credentials, insufficient permissions or that the metadata key was written with a wrong `connector_id`.",{"_3640":1603,"_31229":1343,"_21648":56000,"_5":14899,"_28426":55336,"_3090":56001},[],"**Resolution:** Verify the connector process is active and the logs show no AWS communication errors. Check the metadata field was written under the exact key `lamassu.io/iot/{connector_id}`. If the error persists, the connector will update the status to `FAILED` with a descriptive message in the CA metadata.",{"_3640":1604,"_31229":1343,"_21648":56003,"_5":14899,"_28426":55336,"_3090":56004},[],"**Symptom:** A certificate's status is not synced to AWS after a revocation.",{"_3640":1605,"_31229":1343,"_21648":56006,"_5":14899,"_28426":55336,"_3090":56007},[],"**Cause:** Most commonly the certificate was provisioned in JITP mode. JITP certificates lack the connector's metadata key and are outside the state synchronization mechanism. If the DMS is in `auto` mode, it may indicate the initial provisioning did not complete correctly and the AWS ARN was not stored in the certificate metadata.",{"_3640":1606,"_31229":1343,"_21648":56009,"_5":14899,"_28426":55336,"_3090":56010},[],"**Resolution:** For JITP certificates, migrate the DMS to `auto` mode and re-provision the affected devices. For `auto` mode certificates, verify the certificate has the AWS ARN stored in its metadata; if not, repeat the provisioning.",{"_3640":1607,"_31229":1343,"_21648":56012,"_5":14899,"_28426":55336,"_3090":56013},[],"**Symptom:** The forced disconnect does not terminate the device's MQTT session after revocation.",{"_3640":1608,"_31229":1343,"_21648":56015,"_5":14899,"_28426":55336,"_3090":56016},[],"**Cause:** The device uses an MQTT client ID different from the certificate's CN. The forced disconnect opens a connection using the CN as client ID; if the firmware uses another identifier, the disconnect does not affect that session.",{"_3640":1609,"_31229":1343,"_21648":56018,"_5":14899,"_28426":55336,"_3090":56019},[],"**Resolution:** Make sure the firmware uses exactly the certificate's CN as the MQTT client identifier. That CN matches the ThingName in AWS IoT Core.",{"_3640":1610,"_31229":1343,"_21648":56021,"_5":14899,"_28426":55336,"_3090":56022},[],"**Symptom:** The device receives `CLIENT_ID_REJECTED` when connecting to AWS IoT Core.",{"_3640":1611,"_31229":1343,"_21648":56024,"_5":14899,"_28426":55336,"_3090":56025},[],"**Cause:** The MQTT client ID does not match the ThingName, which is always the CN of the certificate issued by Lamassu.",{"_3640":1612,"_31229":1343,"_21648":56027,"_5":14899,"_28426":55336,"_3090":56028},[],"**Resolution:** Verify the firmware uses exactly the value of the CN field included in the enrollment CSR as the MQTT client identifier.",{"_3640":1613,"_31229":1343,"_21648":56030,"_5":14899,"_28426":55336,"_3090":56031},[],"**Symptom:** The device's first MQTT connection in JITP mode fails or times out.",{"_3640":1614,"_31229":1343,"_21648":56033,"_5":14899,"_28426":55336,"_3090":56034},[],"**Cause:** This is expected behavior while AWS executes the JITP template on the device's first connection.",{"_3640":1615,"_31229":1343,"_21648":56036,"_5":14899,"_28426":55336,"_3090":56037},[],"**Resolution:** Firmware must implement retries with exponential backoff for the first connection. If the failure persists beyond a few minutes, verify the IAM role configured in `jitp_config.provisioning_role_arn` exists in the account and has permissions to create Things, register certificates and attach policies.",{"_3640":1616,"_31229":1343,"_21648":56039,"_5":14899,"_28426":55336,"_3090":56040},[],"**Symptom:** The Device Shadow is not updated when it should be.",{"_3640":1617,"_31229":1343,"_21648":56042,"_5":14899,"_28426":55336,"_3090":56043},[],"**Cause:** The shadow feature is disabled in the DMS configuration, the connector's credentials lack IoT data-plane permissions, or the firmware reads a different shadow than the configured one.",{"_3640":1618,"_31229":1343,"_21648":56045,"_5":14899,"_28426":55336,"_3090":56046},[],"**Resolution:** Check that `shadow_config.enable` is `true` in the connector metadata for the corresponding DMS. If a Named Shadow is used, verify `shadow_config.shadow_name` holds the correct name and that the firmware reads that Named Shadow and not the Classic Shadow. Confirm the connector's credentials have `iotdata:GetThingShadow` and `iotdata:UpdateThingShadow` permissions.",{"_3640":1619,"_31229":1343,"_21648":56048,"_5":14899,"_28426":55336,"_3090":56049},[],"**Symptom:** After editing a DMS in `jitp` mode, DMS update messages appear in `lamassu-dlq`, or JITP configuration changes have no effect in AWS.",{"_3640":1620,"_31229":1343,"_21648":56051,"_5":14899,"_28426":55336,"_3090":56052},[],"**Cause:** Every full DMS edit (`PUT /v1/dms/{id}`) triggers a `CreateProvisioningTemplate` attempt for the template named after the DMS ID, and the call is not idempotent: when the template already exists, it fails, the event is retried three times and finally lands in `lamassu-dlq`. The connector’s later steps are skipped.",{"_3640":1621,"_31229":1343,"_21648":56054,"_5":14899,"_28426":55336,"_3090":56055},[],"**Resolution:** Check that the template named with the DMS ID exists in AWS IoT Core and that JITP enrollment works. If the JITP configuration was changed, apply it by hand to the AWS template.",{"_3640":1622,"_31229":1343,"_21648":56057,"_5":14899,"_28426":55336,"_3090":56058},[],"<Card title=\"Configure a DMS\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_3640":1623,"_31229":1343,"_21648":56060,"_5":14899,"_28426":55336,"_3090":56061},[],"<Card title=\"Device enrollment (EST)\" href=\"/docs/platform/iot-fleets/enrollment/overview\" />",{"_3640":1624,"_31229":1343,"_21648":56063,"_5":14899,"_28426":55336,"_3090":56064},[],"<Card title=\"Certificate management\" href=\"/docs/platform/pki/certificates\" />",{"_3640":1625,"_31229":1625,"_5":15259,"_3090":53754,"_31567":56066,"_21648":56067,"_28426":1625},[51054,52582,53754],[],{"_3640":1626,"_31229":1625,"_21648":56069,"_5":14899,"_28426":1625,"_3090":56070},[],"Organize devices and their identities, prepare enrollment and integrate consumers.",{"_3640":1627,"_31229":1625,"_5":31564,"_21648":56072,"_28426":56073,"_3090":56074},[],"/docs/platform/iot-fleets/overview#start-here","Start here",{"_3640":1628,"_31229":1625,"_5":31564,"_21648":56076,"_28426":56077,"_3090":53752},[],"/docs/platform/iot-fleets/overview#devices-and-identities",{"_3640":1629,"_31229":1625,"_5":31564,"_21648":56079,"_28426":56080,"_3090":53938},[],"/docs/platform/iot-fleets/overview#enrollment-with-pki",{"_3640":1630,"_31229":1625,"_5":31564,"_21648":56082,"_28426":56083,"_3090":55233},[],"/docs/platform/iot-fleets/overview#integrations",{"_3640":1631,"_31229":1625,"_5":31564,"_21648":56085,"_28426":56086,"_3090":56087},[],"/docs/platform/iot-fleets/overview#who-prepares-each-part","Who prepares each part",{"_3640":1632,"_31229":1625,"_21648":56089,"_5":14899,"_28426":1625,"_3090":56090},[],"IoT Fleets applies PKI to the device lifecycle: registration, obtaining an identity, renewal and retirement. It is intended for those who administer a device population and those who integrate its enrollment client or the system that accepts it.",{"_3640":1633,"_31229":1625,"_21648":56092,"_5":14899,"_28426":56073,"_3090":56093},[],"Follow Enroll and connect your first device to prepare a DMS, obtain the identity from the client and demonstrate an mTLS connection. The automatic path includes initial trust, a CSR and result checks.",{"_3640":1634,"_31229":1625,"_21648":56095,"_5":14899,"_28426":56073,"_3090":56096},[],"To start with an existing certificate, use Register a device manually. You can then prepare enrollment and renewal for the next device.",{"_3640":1635,"_31229":1625,"_21648":56098,"_5":14899,"_28426":56077,"_3090":56099},[],"Resource",{"_3640":1636,"_31229":1625,"_21648":56101,"_5":14899,"_28426":56077,"_3090":56102},[],"What it represents",{"_3640":1637,"_31229":1625,"_21648":56104,"_5":14899,"_28426":56077,"_3090":56105},[],"**Device**",{"_3640":1638,"_31229":1625,"_21648":56107,"_5":14899,"_28426":56077,"_3090":56108},[],"An inventory entry with an identifier, owning DMS and classification.",{"_3640":1639,"_31229":1625,"_21648":56110,"_5":14899,"_28426":56077,"_3090":56111},[],"**Identity**",{"_3640":1640,"_31229":1625,"_21648":56113,"_5":14899,"_28426":56077,"_3090":56114},[],"The device's association with its certificates: an active version and a history.",{"_3640":1641,"_31229":1625,"_21648":56116,"_5":14899,"_28426":56077,"_3090":56117},[],"**DMS**",{"_3640":1642,"_31229":1625,"_21648":56119,"_5":14899,"_28426":56077,"_3090":56120},[],"The service that configures admission, enrollment, renewal and trust distribution.",{"_3640":1643,"_31229":1625,"_21648":56122,"_5":14899,"_28426":56077,"_3090":56123},[],"**Fleet**",{"_3640":1644,"_31229":1625,"_21648":56125,"_5":14899,"_28426":56077,"_3090":56126},[],"The population you operate, represented through devices, DMSs, tags and metadata.",{"_3640":1645,"_31229":1625,"_21648":56128,"_5":14899,"_28426":56077,"_3090":56129},[],"Each device has an owning DMS. You can organize a population through several DMSs when it needs different policies, and use tags to classify it. “Fleet” describes that operational context; the resources you create and query are DMSs and devices.",{"_3640":1646,"_31229":1625,"_21648":56131,"_5":14899,"_28426":56077,"_3090":56132},[],"Device management covers states, certificate history and identity actions. During renewal, retain the relationship with the device and check which certificate becomes the current identity.",{"_3640":1647,"_31229":1625,"_21648":56134,"_5":14899,"_28426":56080,"_3090":56135},[],"This section connects PKI rules to the device client. Preparation follows this order:",{"_3640":1648,"_31229":1625,"_21648":56137,"_5":14899,"_28426":56080,"_3090":56138},[],"**CA and profile:** prepare the issuer and certificate rules in PKI.",{"_3640":1649,"_31229":1625,"_21648":56140,"_5":14899,"_28426":56080,"_3090":56141},[],"**DMS policy:** define how the device is admitted, how requests authenticate and which trust is distributed.",{"_3640":1650,"_31229":1625,"_21648":56143,"_5":14899,"_28426":56080,"_3090":56144},[],"**Client:** prepare the initial credential, server trust, and key generation or custody.",{"_3640":1651,"_31229":1625,"_21648":56146,"_5":14899,"_28426":56080,"_3090":56147},[],"**Result:** request the certificate, install it and check its association with the device.",{"_3640":1652,"_31229":1625,"_21648":56149,"_5":14899,"_28426":56080,"_3090":56150},[],"**Continuity:** configure renewal, successor installation and recovery according to DMS policy.",{"_3640":1653,"_31229":1625,"_21648":56152,"_5":14899,"_28426":56080,"_3090":56153},[],"<Card title=\"Configure the DMS\" description=\"Prepare the CA, admission, authentication and renewal rules.\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_3640":1654,"_31229":1625,"_21648":56155,"_5":14899,"_28426":56080,"_3090":56156},[],"<Card title=\"Integrate the EST client\" description=\"Review the device endpoints, formats and checks.\" href=\"/docs/platform/iot-fleets/enrollment/est-client\" />",{"_3640":1655,"_31229":1625,"_21648":56158,"_5":14899,"_28426":56083,"_3090":56159},[],"An issued identity needs a consumer that trusts its issuer, validates the certificate and grants the device permissions. Prepare both the device's trust in the server and the server's trust in the device.",{"_3640":1656,"_31229":1625,"_21648":56161,"_5":14899,"_28426":56083,"_3090":56162},[],"The AWS IoT Core guide explains how to use the identity in that destination. Provisioning in Lamassu and provisioning in the destination are separate decisions; review the conditions of the chosen mode before expecting state synchronization.",{"_3640":1657,"_31229":1625,"_21648":56164,"_5":14899,"_28426":56086,"_3090":56165},[],"Participant",{"_3640":1658,"_31229":1625,"_21648":56167,"_5":14899,"_28426":56086,"_3090":56168},[],"Responsibility",{"_3640":1659,"_31229":1625,"_21648":56170,"_5":14899,"_28426":56086,"_3090":56171},[],"PKI administrator",{"_3640":1660,"_31229":1625,"_21648":56173,"_5":14899,"_28426":56086,"_3090":56174},[],"CA, issuance profile, chain and revocation publication.",{"_3640":1661,"_31229":1625,"_21648":56176,"_5":14899,"_28426":56086,"_3090":56177},[],"Provisioning administrator",{"_3640":1662,"_31229":1625,"_21648":56179,"_5":14899,"_28426":56086,"_3090":56180},[],"DMS, admission, authentication per operation and inventory.",{"_3640":1663,"_31229":1625,"_21648":56182,"_5":14899,"_28426":56086,"_3090":56183},[],"Device integrator",{"_3640":1664,"_31229":1625,"_21648":56185,"_5":14899,"_28426":56086,"_3090":56186},[],"Initial credential, key, EST client, trust and certificate installation.",{"_3640":1665,"_31229":1625,"_21648":56188,"_5":14899,"_28426":56086,"_3090":56189},[],"Consumer integrator",{"_3640":1666,"_31229":1625,"_21648":56191,"_5":14899,"_28426":56086,"_3090":56192},[],"Trusted issuers, validation and device permissions in the destination.",{"_3640":1667,"_31229":1625,"_21648":56194,"_5":14899,"_28426":56086,"_3090":56195},[],"Permissions and audit are shared with the rest of Platform. Prepare installation and instance connectivity in Deployment.",{"_3640":1668,"_31229":1668,"_5":15259,"_3090":56197,"_31567":56198,"_21648":56200,"_28426":1668},"Enroll and connect your first device",[51054,52582,53754,56199],"Getting started",[],{"_3640":1669,"_31229":1668,"_21648":56202,"_5":14899,"_28426":1668,"_3090":56203},[],"Obtain an identity through EST, verify its association and use it in an mTLS connection.",{"_3640":1670,"_31229":1668,"_5":31564,"_21648":56205,"_28426":56206,"_3090":51064},[],"/docs/platform/iot-fleets/quickstarts/enroll-device#before-you-begin",{"_3640":1671,"_31229":1668,"_5":31564,"_21648":56208,"_28426":56209,"_3090":56210},[],"/docs/platform/iot-fleets/quickstarts/enroll-device#prepare-the-bootstrap-credential","Prepare the bootstrap credential",{"_3640":1672,"_31229":1668,"_5":31564,"_21648":56212,"_28426":56213,"_3090":56214},[],"/docs/platform/iot-fleets/quickstarts/enroll-device#configure-the-evaluation-dms","Configure the evaluation DMS",{"_3640":1673,"_31229":1668,"_5":31564,"_21648":56216,"_28426":56217,"_3090":56218},[],"/docs/platform/iot-fleets/quickstarts/enroll-device#prepare-the-client-and-check-cacerts","Prepare the client and check cacerts",{"_3640":1674,"_31229":1668,"_5":31564,"_21648":56220,"_28426":56221,"_3090":56222},[],"/docs/platform/iot-fleets/quickstarts/enroll-device#enroll-the-device","Enroll the device",{"_3640":1675,"_31229":1668,"_5":31564,"_21648":56224,"_28426":56225,"_3090":56226},[],"/docs/platform/iot-fleets/quickstarts/enroll-device#verify-the-obtained-identity","Verify the obtained identity",{"_3640":1676,"_31229":1668,"_5":31564,"_21648":56228,"_28426":56229,"_3090":56230},[],"/docs/platform/iot-fleets/quickstarts/enroll-device#demonstrate-an-mtls-connection","Demonstrate an mTLS connection",{"_3640":1677,"_31229":1668,"_5":31564,"_21648":56232,"_28426":56233,"_3090":56234},[],"/docs/platform/iot-fleets/quickstarts/enroll-device#result-and-continuity","Result and continuity",{"_3640":1678,"_31229":1668,"_21648":56236,"_5":14899,"_28426":1668,"_3090":56237},[],"Prepare an evaluation DMS, enroll `est-device-001` from the client and use its identity with a local consumer that requires a certificate. The path connects administrator policy to the material the device actually installs.",{"_3640":1679,"_31229":1668,"_21648":56239,"_5":14899,"_28426":56206,"_3090":56240},[],"A Lamassu instance accessible through HTTPS and permissions for CAs, profiles, DMSs and reading devices/certificates.",{"_3640":1680,"_31229":1668,"_21648":56242,"_5":14899,"_28426":56206,"_3090":56243},[],"Bash, OpenSSL 3.x, curl with `--fail-with-body` and two terminals on your computer. Work in a new directory with restricted access.",{"_3640":1681,"_31229":1668,"_21648":56245,"_5":14899,"_28426":56206,"_3090":56246},[],"An active root CA that issues directly, with an available key and sufficient validity. Follow Create your first CA. Save its verified public certificate as `device-root.pem`.",{"_3640":1682,"_31229":1668,"_21648":56248,"_5":14899,"_28426":56206,"_3090":56249},[],"Available global identifier `est-device-001`. This path uses automatic registration: do not create the device in the console first.",{"_3640":1683,"_31229":1668,"_21648":56251,"_5":14899,"_28426":56206,"_3090":56252},[],"The approved root for Lamassu HTTPS in `est-trust.pem`, obtained through an independent channel. It can differ from the device CA; prepare networking/TLS in Deployment.",{"_3640":1684,"_31229":1668,"_21648":56254,"_5":14899,"_28426":56209,"_3090":56255},[],"Issue a bootstrap leaf certificate with `CN=est-device-001`, its own key and Client Authentication use. Follow Issue and verify a certificate, changing its CN and saving the result as `bootstrap.crt` and `bootstrap.key`. Choose validity that covers this test and check the pair and chain.",{"_3640":1685,"_31229":1668,"_21648":56257,"_5":14899,"_28426":56209,"_3090":56258},[],"The same root CA can issue it for this isolated evaluation. The operational identity will have a different key and certificate. The matching CN makes the example easier to read; initial certificate authentication does not itself bind the bootstrap CN to the requested ID. Review admission before applying the policy to a population.",{"_3640":1686,"_31229":1668,"_21648":56260,"_5":14899,"_28426":56213,"_3090":56261},[],"Create an explicit leaf profile compatible with EC P-256, with **Honor Subject**, CN from the CSR, **Digital Signature**, **Client Authentication** and **1 hour** validity within the root's validity. Do not enable CA signing. Rules and precedence are explained in Profiles.",{"_3640":1687,"_31229":1668,"_21648":56263,"_5":14899,"_28426":56213,"_3090":56264},[],"Create the `Acme EST Evaluation` DMS with this configuration:",{"_3640":1688,"_31229":1668,"_21648":56266,"_5":14899,"_28426":56213,"_3090":56267},[],"Setting",{"_3640":1689,"_31229":1668,"_21648":56269,"_5":14899,"_28426":56213,"_3090":56270},[],"Evaluation value",{"_3640":1690,"_31229":1668,"_21648":56272,"_5":14899,"_28426":56213,"_3090":56273},[],"Enrollment CA",{"_3640":1691,"_31229":1668,"_21648":56275,"_5":14899,"_28426":56213,"_3090":56276},[],"Issuing root from `device-root.pem`.",{"_3640":1692,"_31229":1668,"_21648":56278,"_5":14899,"_28426":56213,"_3090":54074},[],{"_3640":1693,"_31229":1668,"_21648":56280,"_5":14899,"_28426":56213,"_3090":56281},[],"The 1-hour leaf profile you just prepared.",{"_3640":1694,"_31229":1668,"_21648":56283,"_5":14899,"_28426":56213,"_3090":56284},[],"Protocol / Registration Mode",{"_3640":1695,"_31229":1668,"_21648":56286,"_5":14899,"_28426":56213,"_3090":56287},[],"`EST_RFC7030` / `JITP`.",{"_3640":1696,"_31229":1668,"_21648":56289,"_5":14899,"_28426":56213,"_3090":56290},[],"Verify CSR Signature",{"_3640":1697,"_31229":1668,"_21648":56292,"_5":14899,"_28426":56213,"_3090":56293},[],"Enabled.",{"_3640":1698,"_31229":1668,"_21648":56295,"_5":14899,"_28426":56213,"_3090":56296},[],"Enable Replaceable Enrollment",{"_3640":1699,"_31229":1668,"_21648":56298,"_5":14899,"_28426":56213,"_3090":56299},[],"Disabled; the ID must be new.",{"_3640":1700,"_31229":1668,"_21648":56301,"_5":14899,"_28426":56213,"_3090":56302},[],"Initial authentication",{"_3640":1701,"_31229":1668,"_21648":56304,"_5":14899,"_28426":56213,"_3090":56305},[],"`CLIENT_CERTIFICATE`; Validation CAs includes the direct bootstrap issuer; no expired certificates.",{"_3640":1702,"_31229":1668,"_21648":56307,"_5":14899,"_28426":56213,"_3090":56308},[],"Renewal authentication",{"_3640":1703,"_31229":1668,"_21648":56310,"_5":14899,"_28426":56213,"_3090":56311},[],"`CLIENT_CERTIFICATE`, configured in the independent re-enrollment block.",{"_3640":1704,"_31229":1668,"_21648":56313,"_5":14899,"_28426":56213,"_3090":56314},[],"Re-enrollment Validation CAs / Enable Expired Renewal",{"_3640":1705,"_31229":1668,"_21648":56316,"_5":14899,"_28426":56213,"_3090":56317},[],"Not needed for this direct issuance; the Enrollment CA is always trusted for re-enrollment / disabled.",{"_3640":1706,"_31229":1668,"_21648":56319,"_5":14899,"_28426":56213,"_3090":56320},[],"Re-enrollment Delta",{"_3640":1707,"_31229":1668,"_21648":56322,"_5":14899,"_28426":56213,"_3090":56323},[],"1 hour.",{"_3640":1708,"_31229":1668,"_21648":56325,"_5":14899,"_28426":56213,"_3090":56326},[],"Preventive / Critical Delta",{"_3640":1709,"_31229":1668,"_21648":56328,"_5":14899,"_28426":56213,"_3090":56329},[],"30 minutes / 10 minutes.",{"_3640":1710,"_31229":1668,"_21648":56331,"_5":14899,"_28426":56213,"_3090":56332},[],"Revoke on Re-enrollment",{"_3640":1711,"_31229":1668,"_21648":56334,"_5":14899,"_28426":56213,"_3090":56335},[],"Disabled to test the successor before retiring the previous identity.",{"_3640":1712,"_31229":1668,"_21648":56337,"_5":14899,"_28426":56213,"_3090":54082},[],{"_3640":1713,"_31229":1668,"_21648":56339,"_5":14899,"_28426":56213,"_3090":56340},[],"Disabled; the operational key is generated in the client.",{"_3640":1714,"_31229":1668,"_21648":56342,"_5":14899,"_28426":56213,"_3090":56343},[],"CA Distribution",{"_3640":1715,"_31229":1668,"_21648":56345,"_5":14899,"_28426":56213,"_3090":56346},[],"Include Enrollment CA enabled; Include Lamassu System CA disabled.",{"_3640":1716,"_31229":1668,"_21648":56348,"_5":14899,"_28426":56213,"_3090":56349},[],"Equal duration and window allow immediate renewal testing. These are evaluation values; size production settings according to connectivity and recovery times. Save, reread both authentication blocks and retain the DMS ID. The console exposes independent editors for the enrollment and re-enrollment authentication; the DMS guide describes their fields, and you can also check the resource through the DMS API.",{"_3640":1717,"_31229":1668,"_21648":56351,"_5":14899,"_28426":56217,"_3090":56352},[],"Place the four trust and bootstrap files in the new directory. Replace the URL with your installation's URL:",{"_3640":1718,"_31229":1668,"_21648":56354,"_5":14899,"_28426":56217,"_3090":56355},[],"The download must succeed and contain the expected enrollment root. Compare its fingerprint with `device-root.pem`. This check does not turn the response into initial trust or prove that you can issue.",{"_3640":1719,"_31229":1668,"_21648":56357,"_5":14899,"_28426":56221,"_3090":56358},[],"Generate a new key and CSR with the selected identifier:",{"_3640":1720,"_31229":1668,"_21648":56360,"_5":14899,"_28426":56221,"_3090":56361},[],"Request the identity with the bootstrap credential and extract the certificate from the default response:",{"_3640":1721,"_31229":1668,"_21648":56363,"_5":14899,"_28426":56221,"_3090":56364},[],"If curl fails, use Troubleshooting with the saved body. Do not convert it or repeat the request without querying inventory: a timeout or error can follow persisted issuance.",{"_3640":1722,"_31229":1668,"_21648":56366,"_5":14899,"_28426":56225,"_3090":56367},[],"Expect `device.crt: OK` and exit code 0 from `cmp`. Check the CN, serial, dates, Digital Signature and Client Authentication. The certificate must be a leaf: it must not declare `CA:TRUE` or Certificate Sign use. Check that its validity matches the one-hour profile.",{"_3640":1723,"_31229":1668,"_21648":56369,"_5":14899,"_28426":56225,"_3090":56370},[],"In Lamassu, open `est-device-001`. It must be created with the intended owning DMS, a current identity and the received certificate in its history. Compare the local serial with the slot; thresholds can show a renewal state rather than simply Active.",{"_3640":1724,"_31229":1668,"_21648":56372,"_5":14899,"_28426":56229,"_3090":56373},[],"In a second terminal, enter the same directory and run `umask 077`. Create a local server certificate and start a test consumer. This server trusts `device-root.pem` and requires a valid client identity:",{"_3640":1725,"_31229":1668,"_21648":56375,"_5":14899,"_28426":56229,"_3090":56376},[],"Leave it running. In the first terminal, connect using the obtained identity:",{"_3640":1726,"_31229":1668,"_21648":56378,"_5":14899,"_28426":56229,"_3090":56379},[],"Expect HTTP `200`. The client's trust in this local server is its self-signed `consumer.crt`; the server verifies the device against `device-root.pem`. The HTML file displays OpenSSL diagnostic information.",{"_3640":1727,"_31229":1668,"_21648":56381,"_5":14899,"_28426":56229,"_3090":56382},[],"With the same server still running, test that a request without a client certificate is rejected:",{"_3640":1728,"_31229":1668,"_21648":56384,"_5":14899,"_28426":56229,"_3090":56385},[],"Rejection must correspond to a missing certificate at the server, not a stopped server. Stop the consumer with Ctrl+C after the test. This exercise demonstrates TLS authentication and key possession; your application must also define authorization and revocation consumption. Server options are described in openssl-s\\_server.",{"_3640":1729,"_31229":1668,"_21648":56387,"_5":14899,"_28426":56233,"_3090":56388},[],"Check",{"_3640":1730,"_31229":1668,"_21648":56390,"_5":14899,"_28426":56233,"_3090":56391},[],"Expected result",{"_3640":1731,"_31229":1668,"_21648":56393,"_5":14899,"_28426":56233,"_3090":56394},[],"Registration",{"_3640":1732,"_31229":1668,"_21648":56396,"_5":14899,"_28426":56233,"_3090":56397},[],"ID created automatically and correct DMS.",{"_3640":1733,"_31229":1668,"_21648":56399,"_5":14899,"_28426":56233,"_3090":55655},[],{"_3640":1734,"_31229":1668,"_21648":56401,"_5":14899,"_28426":56233,"_3090":56402},[],"CN, profile, serial and key verified.",{"_3640":1735,"_31229":1668,"_21648":56404,"_5":14899,"_28426":56233,"_3090":56405},[],"Inventory",{"_3640":1736,"_31229":1668,"_21648":56407,"_5":14899,"_28426":56233,"_3090":56408},[],"Received serial visible as the current identity and in history.",{"_3640":1737,"_31229":1668,"_21648":56410,"_5":14899,"_28426":56233,"_3090":56411},[],"Consumer",{"_3640":1738,"_31229":1668,"_21648":56413,"_5":14899,"_28426":56233,"_3090":56414},[],"mTLS responds 200 with the identity and rejects a missing certificate.",{"_3640":1739,"_31229":1668,"_21648":56416,"_5":14899,"_28426":56233,"_3090":56417},[],"Continue with Renewal and recovery to request a successor pair within the window, install it and repeat the mTLS check. The consumer must use the new files in that test. After checking the successor, retire the previous certificate according to PKI policy; the example does not revoke it automatically.",{"_3640":1740,"_31229":1668,"_21648":56419,"_5":14899,"_28426":56233,"_3090":56420},[],"Devices and identities explains retirement and the limits of historical revocation. For a real destination, prepare consumer trust, validation and permissions; AWS IoT Core is an available integration.",{"_3640":1741,"_31229":1741,"_5":15259,"_3090":53770,"_31567":56422,"_21648":56423,"_28426":1741},[51054,52582,53754,56199],[],{"_3640":1742,"_31229":1741,"_21648":56425,"_5":14899,"_28426":1741,"_3090":56426},[],"Prepare a DMS, register a device and associate a verified certificate with its identity.",{"_3640":1743,"_31229":1741,"_5":31564,"_21648":56428,"_28426":56429,"_3090":51064},[],"/docs/platform/iot-fleets/quickstarts/register-device#before-you-begin",{"_3640":1744,"_31229":1741,"_5":31564,"_21648":56431,"_28426":56432,"_3090":56433},[],"/docs/platform/iot-fleets/quickstarts/register-device#prepare-the-dms","Prepare the DMS",{"_3640":1745,"_31229":1741,"_5":31564,"_21648":56435,"_28426":56436,"_3090":56437},[],"/docs/platform/iot-fleets/quickstarts/register-device#register-the-device","Register the device",{"_3640":1746,"_31229":1741,"_5":31564,"_21648":56439,"_28426":56440,"_3090":56441},[],"/docs/platform/iot-fleets/quickstarts/register-device#check-the-initial-status","Check the initial status",{"_3640":1747,"_31229":1741,"_5":31564,"_21648":56443,"_28426":56444,"_3090":56445},[],"/docs/platform/iot-fleets/quickstarts/register-device#assign-an-identity","Assign an identity",{"_3640":1748,"_31229":1741,"_5":31564,"_21648":56447,"_28426":56448,"_3090":56449},[],"/docs/platform/iot-fleets/quickstarts/register-device#verify-the-device","Verify the device",{"_3640":1749,"_31229":1741,"_5":31564,"_21648":56451,"_28426":56452,"_3090":56391},[],"/docs/platform/iot-fleets/quickstarts/register-device#expected-result",{"_3640":1750,"_31229":1741,"_5":31564,"_21648":56454,"_28426":56455,"_3090":56456},[],"/docs/platform/iot-fleets/quickstarts/register-device#if-the-result-fails","If the result fails",{"_3640":1751,"_31229":1741,"_5":31564,"_21648":56458,"_28426":56459,"_3090":56460},[],"/docs/platform/iot-fleets/quickstarts/register-device#automate-the-next-device","Automate the next device",{"_3640":1752,"_31229":1741,"_21648":56462,"_5":14899,"_28426":1741,"_3090":56463},[],"This path is intended for those starting to administer device identities. You will register `device-001` and assign an existing certificate to check the relationship between device, DMS and identity history.",{"_3640":1753,"_31229":1741,"_21648":56465,"_5":14899,"_28426":1741,"_3090":56466},[],"Assignment updates Lamassu's inventory. Install the key and certificate separately on the device; check the connection to a consumer in that destination's integration.",{"_3640":1754,"_31229":1741,"_21648":56468,"_5":14899,"_28426":56429,"_3090":56469},[],"An accessible instance and permission to administer DMSs, devices and certificate associations.",{"_3640":1755,"_31229":1741,"_21648":56471,"_5":14899,"_28426":56429,"_3090":56472},[],"An active CA with an available key. If one does not exist yet, follow Create your first CA.",{"_3640":1756,"_31229":1741,"_21648":56474,"_5":14899,"_28426":56429,"_3090":56475},[],"An active end-entity certificate from that CA whose `Common Name` is exactly `device-001`, together with its private key. Follow Issue and verify a certificate to obtain and check both.",{"_3640":1757,"_31229":1741,"_21648":56477,"_5":14899,"_28426":56429,"_3090":56478},[],"The identifier `device-001` available in the inventory. If you already used it, choose another and issue the certificate with that same `Common Name`.",{"_3640":1758,"_31229":1741,"_21648":56480,"_5":14899,"_28426":56432,"_3090":56481},[],"A DMS must exist before registering the device. If you already have a suitable one, check its CA and note its identifier; to create one:",{"_3640":1759,"_31229":1741,"_21648":56483,"_5":14899,"_28426":56432,"_3090":56484},[],"Open the DMS inventory and its creation action. Assign a recognizable name, such as `Acme Evaluation DMS`.",{"_3640":1760,"_31229":1741,"_21648":56486,"_5":14899,"_28426":56432,"_3090":56487},[],"In **Enrollment CA**, select the CA that issued `device.crt`.",{"_3640":1761,"_31229":1741,"_21648":56489,"_5":14899,"_28426":56432,"_3090":56490},[],"In **Registration Mode**, select `PRE_REGISTRATION` for the path that starts with explicit registration.",{"_3640":1762,"_31229":1741,"_21648":56492,"_5":14899,"_28426":56432,"_3090":56493},[],"In the authentication section, enable **Require client certificate** and leave **Call external webhook** off. Under **Require client certificate**, add the CA whose initial certificates you will accept to **Validation CAs**; for this evaluation, it can be the same CA. Keep **Verify CSR Signature** enabled and leave **Enable server-side key generation** off if you will not use it.",{"_3640":1763,"_31229":1741,"_21648":56495,"_5":14899,"_28426":56432,"_3090":56496},[],"Review renewal and trust distribution settings with the DMS guide, save the service and note its identifier.",{"_3640":1764,"_31229":1741,"_21648":56498,"_5":14899,"_28426":56432,"_3090":56499},[],"Reopen the DMS and confirm that the enrollment CA is the expected one and the service appears in inventory.",{"_3640":1765,"_31229":1741,"_21648":56501,"_5":14899,"_28426":56432,"_3090":56502},[],"These settings prepare DMS policy. The next steps register and assign through the console; they do not send an EST request or test admission through that protocol.",{"_3640":1766,"_31229":1741,"_21648":56504,"_5":14899,"_28426":56436,"_3090":56505},[],"Open **Managed Devices** and the registration action. Complete:",{"_3640":1767,"_31229":1741,"_21648":56507,"_5":14899,"_28426":56436,"_3090":56508},[],"**Device ID**: `device-001`.",{"_3640":1768,"_31229":1741,"_21648":56510,"_5":14899,"_28426":56436,"_3090":56511},[],"**Registration Authority**: the DMS you just prepared; this label identifies the service fulfilling the registration authority role.",{"_3640":1769,"_31229":1741,"_21648":56513,"_5":14899,"_28426":56436,"_3090":56514},[],"**Icon** and **Tags**: optional classification.",{"_3640":1770,"_31229":1741,"_21648":56516,"_5":14899,"_28426":56436,"_3090":56517},[],"Confirm registration.",{"_3640":1771,"_31229":1741,"_21648":56519,"_5":14899,"_28426":56440,"_3090":56520},[],"Open the device. It should appear in **No Identity** and show the selected owning DMS.",{"_3640":1772,"_31229":1741,"_21648":56522,"_5":14899,"_28426":56440,"_3090":56523},[],"Registration creates the inventory entry; the certificate must still be associated.",{"_3640":1773,"_31229":1741,"_21648":56525,"_5":14899,"_28426":56444,"_3090":56526},[],"Select **Assign Identity** and the existing certificate with `CN=device-001`. Check its serial number, issuer and validity against the certificate you verified in PKI.",{"_3640":1774,"_31229":1741,"_21648":56528,"_5":14899,"_28426":56444,"_3090":56529},[],"Confirm the association. The **Issue New Instead** alternative is explained in Devices and identities.",{"_3640":1775,"_31229":1741,"_21648":56531,"_5":14899,"_28426":56448,"_3090":56532},[],"Check that it has an active identity. In **Certificate History**, verify the associated serial number; in **Device Event Timeline**, find the assignment event.",{"_3640":1776,"_31229":1741,"_21648":56534,"_5":14899,"_28426":56448,"_3090":56535},[],"Keep the device identifier, owning DMS and serial number as references for the result.",{"_3640":1777,"_31229":1741,"_21648":56537,"_5":14899,"_28426":56452,"_3090":56388},[],{"_3640":1778,"_31229":1741,"_21648":56539,"_5":14899,"_28426":56452,"_3090":56540},[],"Result",{"_3640":1779,"_31229":1741,"_21648":56542,"_5":14899,"_28426":56452,"_3090":55638},[],{"_3640":1780,"_31229":1741,"_21648":56544,"_5":14899,"_28426":56452,"_3090":56545},[],"`device-001` appears in inventory with the expected DMS.",{"_3640":1781,"_31229":1741,"_21648":56547,"_5":14899,"_28426":56452,"_3090":56548},[],"Current identity",{"_3640":1782,"_31229":1741,"_21648":56550,"_5":14899,"_28426":56452,"_3090":56551},[],"The associated certificate matches the one you verified in PKI.",{"_3640":1783,"_31229":1741,"_21648":56553,"_5":14899,"_28426":56452,"_3090":56554},[],"History",{"_3640":1784,"_31229":1741,"_21648":56556,"_5":14899,"_28426":56452,"_3090":56557},[],"The associated issuance appears with its serial number and dates.",{"_3640":1785,"_31229":1741,"_21648":56559,"_5":14899,"_28426":56452,"_3090":56560},[],"Key and certificate",{"_3640":1786,"_31229":1741,"_21648":56562,"_5":14899,"_28426":56452,"_3090":56563},[],"You have the verified pair ready to install on the device.",{"_3640":1787,"_31229":1741,"_21648":56565,"_5":14899,"_28426":56455,"_3090":56566},[],"If you cannot select the DMS, confirm its creation and your read permissions.",{"_3640":1788,"_31229":1741,"_21648":56568,"_5":14899,"_28426":56455,"_3090":56569},[],"If no eligible certificate appears, check that its `Common Name` matches the `Device ID` exactly, it is active and it was issued by the expected CA.",{"_3640":1789,"_31229":1741,"_21648":56571,"_5":14899,"_28426":56455,"_3090":56572},[],"If assignment fails, review permissions and operation diagnostics before repeating it. Query the device and its history again to find the persisted result.",{"_3640":1790,"_31229":1741,"_21648":56574,"_5":14899,"_28426":56455,"_3090":56575},[],"If an expiration or renewal state appears, check certificate dates and DMS thresholds in Devices and identities.",{"_3640":1791,"_31229":1741,"_21648":56577,"_5":14899,"_28426":56459,"_3090":56578},[],"Continue with DMS and EST for the device to request and renew certificates. Prepare server trust, the initial credential and policies for each operation before implementing the client.",{"_3640":1792,"_31229":1741,"_21648":56580,"_5":14899,"_28426":56459,"_3090":56581},[],"For a path from the client through mTLS, follow Enroll and connect your first device with a new ID.",{"_3640":1793,"_31229":1741,"_21648":56583,"_5":14899,"_28426":56459,"_3090":56584},[],"To use the identity in AWS IoT Core, also prepare trust and permissions in the destination. Check the connection from the device after installing the required key, certificate and chain.",{"_3640":1794,"_31229":1794,"_5":15259,"_3090":56586,"_31567":56587,"_21648":56588,"_28426":1794},"Lamassu IoT Platform",[51054,52582],[],{"_3640":1795,"_31229":1794,"_21648":56590,"_5":14899,"_28426":1794,"_3090":56591},[],"Build a PKI and apply its certificates to your devices' lifecycle.",{"_3640":1796,"_31229":1794,"_5":31564,"_21648":56593,"_28426":56594,"_3090":56074},[],"/docs/platform/overview#start-here",{"_3640":1797,"_31229":1794,"_5":31564,"_21648":56596,"_28426":56597,"_3090":56598},[],"/docs/platform/overview#choose-your-path","Choose your path",{"_3640":1798,"_31229":1794,"_5":31564,"_21648":56600,"_28426":56601,"_3090":56602},[],"/docs/platform/overview#architecture-at-a-glance","Architecture at a glance",{"_3640":1799,"_31229":1794,"_5":31564,"_21648":56604,"_28426":56605,"_3090":56606},[],"/docs/platform/overview#core-capabilities","Core capabilities",{"_3640":1800,"_31229":1794,"_5":31564,"_21648":56608,"_28426":56609,"_3090":56610},[],"/docs/platform/overview#build-your-trust-hierarchy","Build your trust hierarchy",{"_3640":1801,"_31229":1794,"_5":31564,"_21648":56612,"_28426":56613,"_3090":56614},[],"/docs/platform/overview#protect-cryptographic-keys","Protect cryptographic keys",{"_3640":1802,"_31229":1794,"_5":31564,"_21648":56616,"_28426":56617,"_3090":56618},[],"/docs/platform/overview#issue-and-control-certificates","Issue and control certificates",{"_3640":1803,"_31229":1794,"_5":31564,"_21648":56620,"_28426":56621,"_3090":56622},[],"/docs/platform/overview#automate-device-identities","Automate device identities",{"_3640":1804,"_31229":1794,"_5":31564,"_21648":56624,"_28426":56625,"_3090":56626},[],"/docs/platform/overview#publish-validation-status","Publish validation status",{"_3640":1805,"_31229":1794,"_5":31564,"_21648":56628,"_28426":56629,"_3090":56630},[],"/docs/platform/overview#react-to-events","React to events",{"_3640":1806,"_31229":1794,"_5":31564,"_21648":56632,"_28426":56633,"_3090":56634},[],"/docs/platform/overview#operational-reference","Operational reference",{"_3640":1807,"_31229":1794,"_21648":56636,"_5":14899,"_28426":1794,"_3090":56637},[],"Lamassu IoT lets you administer a private PKI and use it to issue, renew and revoke X.509 device identities. The Platform documentation follows two paths: **PKI**, for authorities and certificates, and **IoT Fleets**, for applying those identities to a device population.",{"_3640":1808,"_31229":1794,"_21648":56639,"_5":14899,"_28426":56594,"_3090":56640},[],"Choose the result you need:",{"_3640":1809,"_31229":1794,"_21648":56642,"_5":14899,"_28426":56594,"_3090":56643},[],"<Card title=\"Issue and verify a certificate\" description=\"Prepare a CA, issue an X.509 identity and check its chain and key.\" href=\"/docs/platform/pki/quickstarts/overview\" />",{"_3640":1810,"_31229":1794,"_21648":56645,"_5":14899,"_28426":56594,"_3090":56646},[],"<Card title=\"Enroll and connect a device\" description=\"Prepare the DMS, request an identity through EST and check an mTLS connection.\" href=\"/docs/platform/iot-fleets/quickstarts/enroll-device\" />",{"_3640":1811,"_31229":1794,"_21648":56648,"_5":14899,"_28426":56594,"_3090":56649},[],"If you are still preparing the instance, start in Deployment. The Platform paths assume an accessible console and permission to perform the operations.",{"_3640":1812,"_31229":1794,"_21648":56651,"_5":14899,"_28426":56597,"_3090":56652},[],"Section",{"_3640":1813,"_31229":1794,"_21648":56654,"_5":14899,"_28426":56597,"_3090":56655},[],"What you manage",{"_3640":1814,"_31229":1794,"_21648":56657,"_5":14899,"_28426":56597,"_3090":56658},[],"Entry point",{"_3640":1815,"_31229":1794,"_21648":56660,"_5":14899,"_28426":56597,"_3090":56661},[],"**PKI**",{"_3640":1816,"_31229":1794,"_21648":56663,"_5":14899,"_28426":56597,"_3090":56664},[],"Keys, authorities, profiles, certificates and publication of revocation status.",{"_3640":1817,"_31229":1794,"_21648":56666,"_5":14899,"_28426":56597,"_3090":56667},[],"PKI overview",{"_3640":1818,"_31229":1794,"_21648":56669,"_5":14899,"_28426":56597,"_3090":56670},[],"**IoT Fleets**",{"_3640":1819,"_31229":1794,"_21648":56672,"_5":14899,"_28426":56597,"_3090":56673},[],"Devices, identity history, DMS policies, EST enrollment and integrations.",{"_3640":1820,"_31229":1794,"_21648":56675,"_5":14899,"_28426":56597,"_3090":56676},[],"IoT Fleets overview",{"_3640":1821,"_31229":1794,"_21648":56678,"_5":14899,"_28426":56597,"_3090":56679},[],"**Administration**",{"_3640":1822,"_31229":1794,"_21648":56681,"_5":14899,"_28426":56597,"_3090":56682},[],"Operator permissions, audit and event subscriptions.",{"_3640":1823,"_31229":1794,"_21648":56684,"_5":14899,"_28426":56597,"_3090":52584},[],{"_3640":1824,"_31229":1794,"_21648":56686,"_5":14899,"_28426":56597,"_3090":56687},[],"A CA determines who signs, and a profile defines what can be issued. The DMS applies admission and enrollment policy. The device retains its association with certificates, and the external consumer decides which identity it accepts.",{"_3640":1825,"_31229":1794,"_21648":56689,"_5":14899,"_28426":56601,"_3090":56690},[],"An identity's journey connects four responsibilities:",{"_3640":1826,"_31229":1794,"_21648":56692,"_5":14899,"_28426":56601,"_3090":56693},[],"The PKI administrator prepares the authority, its key and issuance rules.",{"_3640":1827,"_31229":1794,"_21648":56695,"_5":14899,"_28426":56601,"_3090":56696},[],"The provisioning administrator configures the DMS and initial trust.",{"_3640":1828,"_31229":1794,"_21648":56698,"_5":14899,"_28426":56601,"_3090":56699},[],"The device client requests a certificate and installs it with the matching key.",{"_3640":1829,"_31229":1794,"_21648":56701,"_5":14899,"_28426":56601,"_3090":56702},[],"The consumer validates the identity and applies its access permissions.",{"_3640":1830,"_31229":1794,"_21648":56704,"_5":14899,"_28426":56601,"_3090":56705},[],"See How Lamassu works to understand the resources and platform architecture for the services. Installation, network exposure and dependencies are explained in Deployment.",{"_3640":1831,"_31229":1794,"_21648":56707,"_5":14899,"_28426":56609,"_3090":56708},[],"Create or incorporate authorities and organize their relationships in PKI. The hierarchy and its rotation determine which chains consumers must recognize.",{"_3640":1832,"_31229":1794,"_21648":56710,"_5":14899,"_28426":56613,"_3090":56711},[],"Choose the engine that keeps authority keys and control who can use them. See Keys and engines; provider setup belongs to deployment.",{"_3640":1833,"_31229":1794,"_21648":56713,"_5":14899,"_28426":56617,"_3090":56714},[],"Define issuance profiles, sign requests and review the certificate inventory. Check the issued certificate from the client that will use it.",{"_3640":1834,"_31229":1794,"_21648":56716,"_5":14899,"_28426":56621,"_3090":56717},[],"Configure a DMS and use EST to request and renew certificates. Preparing the initial credential and installing the result belong to device integration.",{"_3640":1835,"_31229":1794,"_21648":56719,"_5":14899,"_28426":56625,"_3090":56720},[],"Use OCSP and CRL to publish revocation status. Each consumer must configure how it retrieves and applies that information.",{"_3640":1836,"_31229":1794,"_21648":56722,"_5":14899,"_28426":56629,"_3090":56723},[],"Use audit logs to investigate changes and configure alerts and subscriptions to react to lifecycle events.",{"_3640":1837,"_31229":1794,"_21648":56725,"_5":14899,"_28426":56633,"_3090":56168},[],{"_3640":1838,"_31229":1794,"_21648":56727,"_5":14899,"_28426":56633,"_3090":56728},[],"What it prepares or checks",{"_3640":1839,"_31229":1794,"_21648":56730,"_5":14899,"_28426":56633,"_3090":56171},[],{"_3640":1840,"_31229":1794,"_21648":56732,"_5":14899,"_28426":56633,"_3090":56733},[],"Key custody, CA hierarchy, profiles and validation.",{"_3640":1841,"_31229":1794,"_21648":56735,"_5":14899,"_28426":56633,"_3090":56736},[],"Fleet administrator",{"_3640":1842,"_31229":1794,"_21648":56738,"_5":14899,"_28426":56633,"_3090":56739},[],"DMS, device admission, renewal policy and inventory.",{"_3640":1843,"_31229":1794,"_21648":56741,"_5":14899,"_28426":56633,"_3090":56183},[],{"_3640":1844,"_31229":1794,"_21648":56743,"_5":14899,"_28426":56633,"_3090":56744},[],"Initial credential, server trust, EST client, and key and certificate storage.",{"_3640":1845,"_31229":1794,"_21648":56746,"_5":14899,"_28426":56633,"_3090":56189},[],{"_3640":1846,"_31229":1794,"_21648":56748,"_5":14899,"_28426":56633,"_3090":56749},[],"Issuer trust, certificate validation and permissions in the destination.",{"_3640":1847,"_31229":1794,"_21648":56751,"_5":14899,"_28426":56633,"_3090":56752},[],"Infrastructure operator",{"_3640":1848,"_31229":1794,"_21648":56754,"_5":14899,"_28426":56633,"_3090":56755},[],"Installation, network, availability, dependencies and deployment diagnosis.",{"_3640":1849,"_31229":1794,"_21648":56757,"_5":14899,"_28426":56633,"_3090":56758},[],"The API reference contains contracts for automating operations. To investigate a failure, start in the affected section: PKI, EST or Deployment.",{"_3640":1850,"_31229":1850,"_5":15259,"_3090":56760,"_31567":56761,"_21648":56764,"_28426":1850},"CA hierarchy and rotation",[51054,52582,56762,56763],"PKI","Keys, authorities and certificates",[],{"_3640":1851,"_31229":1850,"_21648":56766,"_5":14899,"_28426":1850,"_3090":56767},[],"Design root and intermediate authorities and replace certificates or keys without breaking trust.",{"_3640":1852,"_31229":1850,"_5":31564,"_21648":56769,"_28426":56770,"_3090":56771},[],"/docs/platform/pki/ca-hierarchy-and-rotation#design-the-hierarchy","Design the hierarchy",{"_3640":1853,"_31229":1850,"_5":31564,"_21648":56773,"_28426":56774,"_3090":56775},[],"/docs/platform/pki/ca-hierarchy-and-rotation#reissuance-and-rotation-are-not-the-same","Reissuance and rotation are not the same",{"_3640":1854,"_31229":1850,"_5":31564,"_21648":56777,"_28426":56778,"_3090":56779},[],"/docs/platform/pki/ca-hierarchy-and-rotation#when-to-choose-each-operation","When to choose each operation",{"_3640":1855,"_31229":1850,"_5":31564,"_21648":56781,"_28426":56782,"_3090":56783},[],"/docs/platform/pki/ca-hierarchy-and-rotation#key-rotation-procedure","Key rotation procedure",{"_3640":1856,"_31229":1850,"_5":31564,"_21648":56785,"_28426":56786,"_3090":56787},[],"/docs/platform/pki/ca-hierarchy-and-rotation#inventory-the-dependencies","Inventory the dependencies",{"_3640":1857,"_31229":1850,"_5":31564,"_21648":56789,"_28426":56790,"_3090":56791},[],"/docs/platform/pki/ca-hierarchy-and-rotation#create-the-successor-ca","Create the successor CA",{"_3640":1858,"_31229":1850,"_5":31564,"_21648":56793,"_28426":56794,"_3090":56795},[],"/docs/platform/pki/ca-hierarchy-and-rotation#distribute-the-new-trust","Distribute the new trust",{"_3640":1859,"_31229":1850,"_5":31564,"_21648":56797,"_28426":56798,"_3090":56799},[],"/docs/platform/pki/ca-hierarchy-and-rotation#switch-issuance","Switch issuance",{"_3640":1860,"_31229":1850,"_5":31564,"_21648":56801,"_28426":56802,"_3090":56803},[],"/docs/platform/pki/ca-hierarchy-and-rotation#renew-in-batches","Renew in batches",{"_3640":1861,"_31229":1850,"_5":31564,"_21648":56805,"_28426":56806,"_3090":56807},[],"/docs/platform/pki/ca-hierarchy-and-rotation#close-the-overlap","Close the overlap",{"_3640":1862,"_31229":1850,"_5":31564,"_21648":56809,"_28426":56810,"_3090":56811},[],"/docs/platform/pki/ca-hierarchy-and-rotation#cascading-revocation","Cascading revocation",{"_3640":1863,"_31229":1850,"_5":31564,"_21648":56813,"_28426":56814,"_3090":56815},[],"/docs/platform/pki/ca-hierarchy-and-rotation#checks-after-the-change","Checks after the change",{"_3640":1864,"_31229":1850,"_21648":56817,"_5":14899,"_28426":1850,"_3090":56818},[],"The hierarchy determines the blast radius of any error or compromise. A root signs intermediate CAs; intermediates issue the identities used by devices and services. This separation lets you isolate environments and rotate a branch without replacing all trust.",{"_3640":1865,"_31229":1850,"_21648":56820,"_5":14899,"_28426":1850,"_3090":56821},[],"This procedure is for the PKI operator replacing an authority in use. You need access to CAs, keys and profiles, a dependency inventory and coordination with trust-store and device owners. Before switching issuance, prepare a test cohort and decide the criterion for ending overlap.",{"_3640":1866,"_31229":1850,"_21648":56823,"_5":14899,"_28426":56770,"_3090":56824},[],"For a production installation, use a very restricted root and one or more operational intermediates. Separate intermediates when any of these boundaries change:",{"_3640":1867,"_31229":1850,"_21648":56826,"_5":14899,"_28426":56770,"_3090":56827},[],"environment, such as production and preproduction;",{"_3640":1868,"_31229":1850,"_21648":56829,"_5":14899,"_28426":56770,"_3090":56830},[],"owner or operating team;",{"_3640":1869,"_31229":1850,"_21648":56832,"_5":14899,"_28426":56770,"_3090":56833},[],"device family or manufacturing process;",{"_3640":1870,"_31229":1850,"_21648":56835,"_5":14899,"_28426":56770,"_3090":56836},[],"region or regulatory requirement;",{"_3640":1871,"_31229":1850,"_21648":56838,"_5":14899,"_28426":56770,"_3090":56839},[],"cryptographic engine or key policy;",{"_3640":1872,"_31229":1850,"_21648":56841,"_5":14899,"_28426":56770,"_3090":56842},[],"maintenance window and renewal cadence.",{"_3640":1873,"_31229":1850,"_21648":56844,"_5":14899,"_28426":56770,"_3090":56845},[],"Avoid deep hierarchies without a concrete need. Each level adds chain distribution, validation and one more certificate you must renew.",{"_3640":1874,"_31229":1850,"_21648":56847,"_5":14899,"_28426":56770,"_3090":56848},[],"A child CA and its end-entity certificates must expire before their issuer. Reserve a margin that allows distributing another chain and renewing dependent certificates.",{"_3640":1875,"_31229":1850,"_21648":56850,"_5":14899,"_28426":56774,"_3090":56851},[],"**Reissuing a CA** creates a new certificate over the existing key. Lamassu generates a CSR with that key, self-signs it if it is a root or asks the parent CA to sign it if it is subordinate. The new certificate becomes active and the CA points to its serial number; the old and new certificates are linked through metadata.",{"_3640":1876,"_31229":1850,"_21648":56853,"_5":14899,"_28426":56774,"_3090":56854},[],"If the CRL settings of the CA are signed by the superseded CA certificate, reissuing moves the signer to the new certificate — provided it carries `cRLSign` — and republishes the CRL. Otherwise, and for settings signed by a different certificate, the signer is kept, so check the new certificate’s key usage after reissuing. A CA with no CRL settings — for example, one imported without its key or without `cRLSign` — has them initialized by the reissue when the new certificate carries `cRLSign`; otherwise it keeps none. See the CRL guide.",{"_3640":1877,"_31229":1850,"_21648":56856,"_5":14899,"_28426":56774,"_3090":56857},[],"**Rotating a CA** creates a successor key and authority. It is the right choice in the face of compromise, a cryptographic change, an engine migration or non-exportable key policies.",{"_3640":1878,"_31229":1850,"_21648":56859,"_5":14899,"_28426":56774,"_3090":56860},[],"Lamassu does not allow reissuing an already-revoked CA or a CA whose expiration date has passed. A subordinate CA is signed by its parent, so the parent must also be `ACTIVE` and inside its validity period; otherwise the reissue fails with `400`. Plan ahead for these conditions.",{"_3640":1879,"_31229":1850,"_21648":56862,"_5":14899,"_28426":56778,"_3090":56863},[],"Reissue if the key is still trustworthy and you only need another validity period or an updated certificate.",{"_3640":1880,"_31229":1850,"_21648":56865,"_5":14899,"_28426":56778,"_3090":56866},[],"Rotate the key if compromise is suspected, the algorithm changes or you want to move custody to another engine.",{"_3640":1881,"_31229":1850,"_21648":56868,"_5":14899,"_28426":56778,"_3090":56869},[],"Create a parallel branch if you cannot update all consumers at the same time.",{"_3640":1882,"_31229":1850,"_21648":56871,"_5":14899,"_28426":56778,"_3090":56872},[],"Revoke immediately only when the risk of keeping the CA outweighs the impact of interrupting the fleet.",{"_3640":1883,"_31229":1850,"_21648":56874,"_5":14899,"_28426":56786,"_3090":56875},[],"Locate child CAs, issued certificates, DMSs, connectors and external trust stores. Include devices that may stay offline for weeks or months.",{"_3640":1884,"_31229":1850,"_21648":56877,"_5":14899,"_28426":56790,"_3090":56878},[],"Generate a new key in the planned engine, create the CA and assign it an explicit profile. Do not reuse the operational identifier to hide that it is a different generation.",{"_3640":1885,"_31229":1850,"_21648":56880,"_5":14899,"_28426":56794,"_3090":56881},[],"Add the new root or chain to consumers before issuing with it. If distributing through EST `/cacerts`, explicitly include the required managed CAs and inspect the content; including the issuer does not automatically include every intermediate. Install the new trust in a cohort and verify that it still accepts the previous identity.",{"_3640":1886,"_31229":1850,"_21648":56883,"_5":14899,"_28426":56798,"_3090":56884},[],"Update the enrollment CA and profile of the DMSs. While old-CA cohorts still renew, add the previous enrollment CA to each DMS's re-enrollment validation CAs (`reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`): the new enrollment CA is trusted automatically, but the old one was the enrollment CA and appears in no re-enrollment trust list, so without that entry its certificates can no longer renew. The DMS guide documents the setting.",{"_3640":1887,"_31229":1850,"_21648":56886,"_5":14899,"_28426":56802,"_3090":56887},[],"Migrate a small cohort, validate mTLS, OCSP and CRL from the consumer and expand progressively. Monitor which devices still present the old chain.",{"_3640":1888,"_31229":1850,"_21648":56889,"_5":14899,"_28426":56806,"_3090":56890},[],"Once no legitimate consumer depends on the previous authority, remove it from issuance, from the re-enrollment validation CAs and from the distributed CAs. Revoke it if policy requires it.",{"_3640":1889,"_31229":1850,"_21648":56892,"_5":14899,"_28426":56810,"_3090":56893},[],"Lamassu saves the CA’s revocation, then applies the same revocation to child CAs and issued certificates. Propagation continues recursively through child CAs. This is not a transaction over the whole hierarchy: some resources may have changed while other updates failed.",{"_3640":1890,"_31229":1850,"_21648":56895,"_5":14899,"_28426":56810,"_3090":56896},[],"Resources in `EXPIRED` state and resources already revoked for a final reason reject further status transitions. Per-descendant failures are logged; review the inventory and logs even when the parent operation completes.",{"_3640":1891,"_31229":1850,"_21648":56898,"_5":14899,"_28426":56810,"_3090":56899},[],"`CertificateHold` is the reversible exception. Holding a CA suspends its active sub-CAs and issued certificates with `CertificateHold` and marks them as suspended by that CA. Releasing the CA — to `ACTIVE` or to any other non-revoked status such as `EXPIRED` — reactivates exactly the descendants still on hold that carry that mark. Holds placed manually before or after the cascade are left untouched, and any later status change of a descendant clears the mark. Revoking a held CA with any other reason remains permanent: descendants are revoked with `CessationOfOperation` and cannot be restored.",{"_3640":1892,"_31229":1850,"_21648":56901,"_5":14899,"_28426":56810,"_3090":56902},[],"Before closing the change, compare the original dependency inventory with final states and verify revocation publication for each issuer. Do not use revocation as the ordinary mechanism to stop issuance: complete migration and remove the CA from operational flows.",{"_3640":1893,"_31229":1850,"_21648":56904,"_5":14899,"_28426":56814,"_3090":56905},[],"The new chain ends in an anchor installed by the consumer.",{"_3640":1894,"_31229":1850,"_21648":56907,"_5":14899,"_28426":56814,"_3090":56908},[],"New certificates contain the expected AKI, SKI, KU, EKU and SAN.",{"_3640":1895,"_31229":1850,"_21648":56910,"_5":14899,"_28426":56814,"_3090":56911},[],"The DMS delivers the correct chain through EST `/cacerts`.",{"_3640":1896,"_31229":1850,"_21648":56913,"_5":14899,"_28426":56814,"_3090":56914},[],"Re-enrollment accepts the old identity during the planned period.",{"_3640":1897,"_31229":1850,"_21648":56916,"_5":14899,"_28426":56814,"_3090":56917},[],"OCSP and CRL respond for the authorities that remain active.",{"_3640":1898,"_31229":1850,"_21648":56919,"_5":14899,"_28426":56814,"_3090":56920},[],"No DMS is left accidentally issuing from the old CA.",{"_3640":1899,"_31229":1850,"_21648":56922,"_5":14899,"_28426":56814,"_3090":56923},[],"See the Trust model to understand the DMS's CA sets and Certificate lifecycle for states and revocation effects.",{"_3640":1900,"_31229":1900,"_5":15259,"_3090":56925,"_31567":56926,"_21648":56927,"_28426":1900},"Certification authorities",[51054,52582,56762,56763],[],{"_3640":1901,"_31229":1900,"_21648":56929,"_5":14899,"_28426":1900,"_3090":56930},[],"Create, import and operate the authorities that establish your PKI's trust.",{"_3640":1902,"_31229":1900,"_5":31564,"_21648":56932,"_28426":56933,"_3090":56934},[],"/docs/platform/pki/certificate-authorities#choose-a-flow","Choose a flow",{"_3640":1903,"_31229":1900,"_5":31564,"_21648":56936,"_28426":56937,"_3090":56938},[],"/docs/platform/pki/certificate-authorities#create-a-new-authority","Create a new authority",{"_3640":1904,"_31229":1900,"_5":31564,"_21648":56940,"_28426":56941,"_3090":51064},[],"/docs/platform/pki/certificate-authorities#before-you-begin",{"_3640":1905,"_31229":1900,"_5":31564,"_21648":56943,"_28426":56944,"_3090":56945},[],"/docs/platform/pki/certificate-authorities#open-the-wizard","Open the wizard",{"_3640":1906,"_31229":1900,"_5":31564,"_21648":56947,"_28426":56948,"_3090":56949},[],"/docs/platform/pki/certificate-authorities#configure-the-key","Configure the key",{"_3640":1907,"_31229":1900,"_5":31564,"_21648":56951,"_28426":56952,"_3090":56953},[],"/docs/platform/pki/certificate-authorities#choose-the-ca-type","Choose the CA type",{"_3640":1908,"_31229":1900,"_5":31564,"_21648":56955,"_28426":56956,"_3090":56957},[],"/docs/platform/pki/certificate-authorities#define-the-identity","Define the identity",{"_3640":1909,"_31229":1900,"_5":31564,"_21648":56959,"_28426":56960,"_3090":56961},[],"/docs/platform/pki/certificate-authorities#configure-validity-and-uses","Configure validity and uses",{"_3640":1910,"_31229":1900,"_5":31564,"_21648":56963,"_28426":56964,"_3090":56965},[],"/docs/platform/pki/certificate-authorities#create-and-verify","Create and verify",{"_3640":1911,"_31229":1900,"_5":31564,"_21648":56967,"_28426":56968,"_3090":56969},[],"/docs/platform/pki/certificate-authorities#use-a-key-from-the-kms","Use a key from the KMS",{"_3640":1912,"_31229":1900,"_5":31564,"_21648":56971,"_28426":56972,"_3090":56973},[],"/docs/platform/pki/certificate-authorities#import-an-external-ca","Import an external CA",{"_3640":1913,"_31229":1900,"_5":31564,"_21648":56975,"_28426":56976,"_3090":56977},[],"/docs/platform/pki/certificate-authorities#select-the-engine","Select the engine",{"_3640":1914,"_31229":1900,"_5":31564,"_21648":56979,"_28426":56980,"_3090":56981},[],"/docs/platform/pki/certificate-authorities#load-the-material","Load the material",{"_3640":1915,"_31229":1900,"_5":31564,"_21648":56983,"_28426":56984,"_3090":56985},[],"/docs/platform/pki/certificate-authorities#define-the-default-issuance","Define the default issuance",{"_3640":1916,"_31229":1900,"_5":31564,"_21648":56987,"_28426":56988,"_3090":56989},[],"/docs/platform/pki/certificate-authorities#verify-the-import","Verify the import",{"_3640":1917,"_31229":1900,"_5":31564,"_21648":56991,"_28426":56992,"_3090":56993},[],"/docs/platform/pki/certificate-authorities#ca-states","CA states",{"_3640":1918,"_31229":1900,"_5":31564,"_21648":56995,"_28426":56996,"_3090":56997},[],"/docs/platform/pki/certificate-authorities#inspect-an-authority","Inspect an authority",{"_3640":1919,"_31229":1900,"_5":31564,"_21648":56999,"_28426":57000,"_3090":57001},[],"/docs/platform/pki/certificate-authorities#issue-certificates","Issue certificates",{"_3640":1920,"_31229":1900,"_5":31564,"_21648":57003,"_28426":57004,"_3090":57005},[],"/docs/platform/pki/certificate-authorities#revoke-a-ca","Revoke a CA",{"_3640":1921,"_31229":1900,"_5":31564,"_21648":57007,"_28426":57008,"_3090":57009},[],"/docs/platform/pki/certificate-authorities#assess-the-impact","Assess the impact",{"_3640":1922,"_31229":1900,"_5":31564,"_21648":57011,"_28426":57012,"_3090":57013},[],"/docs/platform/pki/certificate-authorities#start-the-revocation","Start the revocation",{"_3640":1923,"_31229":1900,"_5":31564,"_21648":57015,"_28426":57016,"_3090":57017},[],"/docs/platform/pki/certificate-authorities#confirm-the-identity","Confirm the identity",{"_3640":1924,"_31229":1900,"_5":31564,"_21648":57019,"_28426":57020,"_3090":57021},[],"/docs/platform/pki/certificate-authorities#check-the-publication","Check the publication",{"_3640":1925,"_31229":1900,"_5":31564,"_21648":57023,"_28426":57024,"_3090":57025},[],"/docs/platform/pki/certificate-authorities#delete-a-ca","Delete a CA",{"_3640":1926,"_31229":1900,"_21648":57027,"_5":14899,"_28426":1900,"_3090":57028},[],"A certification authority (CA) binds identities to public keys through signed certificates. In Lamassu you can create a new hierarchy, use a key already in the KMS or incorporate an external CA.",{"_3640":1927,"_31229":1900,"_21648":57030,"_5":14899,"_28426":1900,"_3090":57031},[],"To design a full chain or replace an authority in production, see CA hierarchy and rotation. If you need to standardize what each authority can sign, use Certificate profiles.",{"_3640":1928,"_31229":1900,"_21648":57033,"_5":14899,"_28426":1900,"_3090":57034},[],"To administer CAs, you need authority and key permissions, a reachable engine and a reviewed profile. An external consumer does not trust a CA merely because it appears in this inventory: agree root and chain distribution separately.",{"_3640":1929,"_31229":1900,"_21648":57036,"_5":14899,"_28426":56933,"_3090":57037},[],"**New CA with a new key:** create a root of trust from scratch. Lamassu generates and keeps the key pair.",{"_3640":1930,"_31229":1900,"_21648":57039,"_5":14899,"_28426":56933,"_3090":57040},[],"**New CA from the KMS:** reuse a key already registered in the platform.",{"_3640":1931,"_31229":1900,"_21648":57042,"_5":14899,"_28426":56933,"_3090":57043},[],"**Import a CA with its private key:** incorporate an external authority that Lamassu can issue with.",{"_3640":1932,"_31229":1900,"_21648":57045,"_5":14899,"_28426":56933,"_3090":57046},[],"**Import only the certificate:** register public material. If Lamassu finds its key in the KMS, it can associate it; otherwise, the CA has no usable key for issuance.",{"_3640":1933,"_31229":1900,"_21648":57048,"_5":14899,"_28426":56933,"_3090":57049},[],"First time here? Follow Create your first CA to complete the minimal journey.",{"_3640":1934,"_31229":1900,"_21648":57051,"_5":14899,"_28426":56941,"_3090":57052},[],"Decide whether the CA will be a root or an intermediate.",{"_3640":1935,"_31229":1900,"_21648":57054,"_5":14899,"_28426":56941,"_3090":57055},[],"Choose the engine that will keep the key.",{"_3640":1936,"_31229":1900,"_21648":57057,"_5":14899,"_28426":56941,"_3090":57058},[],"Define a validity longer than that of the certificates it will issue.",{"_3640":1937,"_31229":1900,"_21648":57060,"_5":14899,"_28426":56941,"_3090":57061},[],"For an intermediate CA, make sure the parent CA is active.",{"_3640":1938,"_31229":1900,"_21648":57063,"_5":14899,"_28426":56944,"_3090":57064},[],"In **Certification Authorities**, select **Create New CA** and choose to generate a new key pair.",{"_3640":1939,"_31229":1900,"_21648":57066,"_5":14899,"_28426":56948,"_3090":57067},[],"Select the cryptographic engine, the algorithm and the size or curve. Lamassu supports RSA and EC keys according to the engine's capabilities.",{"_3640":1940,"_31229":1900,"_21648":57069,"_5":14899,"_28426":56948,"_3090":57070},[],"Use only sizes and curves supported by the engine and the profile’s cryptographic policy. Read Keys and engines before reusing external material.",{"_3640":1941,"_31229":1900,"_21648":57072,"_5":14899,"_28426":56952,"_3090":57073},[],"Select **Root CA** for a self-signed authority or **Intermediate CA** for an authority signed by another CA. In the latter case, choose the issuing CA.",{"_3640":1942,"_31229":1900,"_21648":57075,"_5":14899,"_28426":56956,"_3090":57076},[],"Enter a unique **CA Name**. This name becomes the certificate's `Common Name`. Complete the Distinguished Name fields your policy requires:",{"_3640":1943,"_31229":1900,"_21648":57078,"_5":14899,"_28426":56956,"_3090":57079},[],"`C`: two-letter ISO 3166-1 country code.",{"_3640":1944,"_31229":1900,"_21648":57081,"_5":14899,"_28426":56956,"_3090":57082},[],"`ST`: state or province.",{"_3640":1945,"_31229":1900,"_21648":57084,"_5":14899,"_28426":56956,"_3090":57085},[],"`L`: locality.",{"_3640":1946,"_31229":1900,"_21648":57087,"_5":14899,"_28426":56956,"_3090":57088},[],"`O`: organization.",{"_3640":1947,"_31229":1900,"_21648":57090,"_5":14899,"_28426":56956,"_3090":57091},[],"`OU`: organizational unit.",{"_3640":1948,"_31229":1900,"_21648":57093,"_5":14899,"_28426":56956,"_3090":57094},[],"The CA's internal identifier is generated automatically and cannot be changed.",{"_3640":1949,"_31229":1900,"_21648":57096,"_5":14899,"_28426":56960,"_3090":57097},[],"Define **CA Certificate Expiration** and **Default End-Entity Certificate Issuance Expiration**. You can express a duration (`5y 8w 4d`), pick a date or use the maximum allowed date.",{"_3640":1950,"_31229":1900,"_21648":57099,"_5":14899,"_28426":56960,"_3090":57100},[],"Review the CA’s own certificate separately from the default profile for certificates it will issue later. Choose an explicit issuance policy; do not assume the form’s initial values suit your consumers.",{"_3640":1951,"_31229":1900,"_21648":57102,"_5":14899,"_28426":56964,"_3090":57103},[],"Confirm the form and open the CA. Check status, issuer, dates, associated engine and key. Download the certificate: it should contain `CA:TRUE` and a usage permitting certificate signing. Verify the self-signature for a root or the chain to your root for an intermediate. Complete a test issuance to check that the key can actually sign.",{"_3640":1952,"_31229":1900,"_21648":57105,"_5":14899,"_28426":56964,"_3090":57106},[],"Plan and verify expiration using the Profiles rules. Issuance does not automatically clamp validity to the issuer’s expiration; leave time to replace the authority and renew identities.",{"_3640":1953,"_31229":1900,"_21648":57108,"_5":14899,"_28426":56968,"_3090":57109},[],"Select &#x2A;*Create New CA (Existing Key)** when the key is already registered in Lamassu. The wizard first asks for the backing key and then shows the same configuration of type, identity, validity and profile.",{"_3640":1954,"_31229":1900,"_21648":57111,"_5":14899,"_28426":56968,"_3090":57112},[],"This flow is useful when the key was previously created in an HSM, imported through BYOK or must be reused under a specific custody policy.",{"_3640":1955,"_31229":1900,"_21648":57114,"_5":14899,"_28426":56972,"_3090":57115},[],"You need the CA certificate in PEM, its chain to a known root and, when importing it, an exportable private key. Before uploading material, verify signature, dates, `CA:TRUE`, signing usages (including `cRLSign`, without which the CA cannot publish its CRL) and public-key correspondence. The key verification procedure also compares a CA key and certificate.",{"_3640":1956,"_31229":1900,"_21648":57117,"_5":14899,"_28426":56972,"_3090":57118},[],"The backend rejects an import whose certificate lacks the CA basic constraint (`basicConstraints cA flag is not set`), whose serial number matches a stored certificate with different contents, or whose identical certificate already belongs to an existing CA. A deleted CA's certificate record is kept and can be reused when re-importing the same certificate, including its previous status. Re-importing a different certificate with that serial number is rejected; check the certificate and status after re-importing.",{"_3640":1957,"_31229":1900,"_21648":57120,"_5":14899,"_28426":56972,"_3090":57121},[],"A certificate whose validity period has already ended, such as that of a retired external authority, is accepted and, when Lamassu has no stored record of that certificate yet, the CA is stored as `EXPIRED` from the start, as happens when importing a plain certificate. If the import reuses the record of a deleted CA (see above and Delete a CA), the previous status is kept instead, even if the certificate has expired in the meantime. An `EXPIRED` CA rejects status changes; see certificate lifecycle.",{"_3640":1958,"_31229":1900,"_21648":57123,"_5":14899,"_28426":56972,"_3090":57124},[],"Deleting a CA releases the key references of its own current certificate and linked reissued certificates, while keeping those records for its issuer's CRL and OCSP. It then attempts to delete the key; the KMS keeps it if other certificates still reference it, such as another CA sharing the key. Revoking certificates issued by the deleted CA does not release their own key references.",{"_3640":1959,"_31229":1900,"_21648":57126,"_5":14899,"_28426":56976,"_3090":57127},[],"Check the installation’s default engine before importing a CA with a key. CA import delegates key import to that engine; it does not guarantee arbitrary provider selection from the form. To select an engine while importing the key separately, use the KMS.",{"_3640":1960,"_31229":1900,"_21648":57129,"_5":14899,"_28426":56980,"_3090":57130},[],"Import the certificate and, when applicable, its PEM key. Register the CAs needed to identify the issuer. Registering a CA does not install it in external trust stores.",{"_3640":1961,"_31229":1900,"_21648":57132,"_5":14899,"_28426":56980,"_3090":57133},[],"The backend validates before importing any key: a duplicate CA ID and a certificate that is not a CA (missing `basicConstraints` `cA=TRUE`) are rejected, the latter with `400` `certificate is not a CA: basicConstraints cA flag is not set`. If a failure occurs after the key was imported, the key is kept in the KMS and a warning tells you to delete it manually.",{"_3640":1962,"_31229":1900,"_21648":57135,"_5":14899,"_28426":56984,"_3090":57136},[],"Associate an explicit issuance profile if the CA will sign. Check usages and dates using Profiles.",{"_3640":1963,"_31229":1900,"_21648":57138,"_5":14899,"_28426":56988,"_3090":57139},[],"Review the registered type, associated key and engine, and issuer relationship. Certificate-only import may associate an existing KMS key using the certificate’s key identifier. Without a usable key, the CA is public material and cannot sign.",{"_3640":1964,"_31229":1900,"_21648":57141,"_5":14899,"_28426":56988,"_3090":57142},[],"An imported CA whose key is in the KMS and whose certificate carries `cRLSign` receives its CRL settings and first CRL automatically; without a key in the KMS or without `cRLSign` it receives none, and this is not an import error (see CRL).",{"_3640":1965,"_31229":1900,"_21648":57144,"_5":14899,"_28426":56988,"_3090":57145},[],"For an issuing CA, complete a test issuance and check OCSP and CRL. Creating the record alone does not establish key availability, complete chain consistency or status publication.",{"_3640":1966,"_31229":1900,"_21648":57147,"_5":14899,"_28426":56992,"_3090":57148},[],"A CA only signs in `ACTIVE`. From there it can move to `EXPIRED` or to `REVOKED`, and it leaves those states only by deletion, with one exception: a revocation with `CertificateHold` can be undone.",{"_3640":1967,"_31229":1900,"_21648":57150,"_5":14899,"_28426":56992,"_3090":57151},[],"**Expiry.** The expiry monitor marks as `EXPIRED` the `ACTIVE` CAs whose validity period has ended. Until it runs, the CA already does not sign, because Lamassu checks the dates (Issue certificates).",{"_3640":1968,"_31229":1900,"_21648":57153,"_5":14899,"_28426":56992,"_3090":57154},[],"**Revocation.** Revoking with the `CertificateHold` reason is reversible. A revocation with any other reason, like `EXPIRED`, rejects every later status change. Revoking, also with `CertificateHold`, additionally acts on the subordinate CAs and the certificates it issued: Revoke a CA.",{"_3640":1969,"_31229":1900,"_21648":57156,"_5":14899,"_28426":56992,"_3090":57157},[],"**Deletion.** Only a CA revoked with another reason, or an expired one, can be deleted; an imported CA without a key can be deleted from any state. Conditions and effects in Delete a CA.",{"_3640":1970,"_31229":1900,"_21648":57159,"_5":14899,"_28426":56996,"_3090":57160},[],"Open a CA from the inventory to review:",{"_3640":1971,"_31229":1900,"_21648":57162,"_5":14899,"_28426":56996,"_3090":57163},[],"Status and validity period.",{"_3640":1972,"_31229":1900,"_21648":57165,"_5":14899,"_28426":56996,"_3090":57166},[],"Certificate and chain in PEM format.",{"_3640":1973,"_31229":1900,"_21648":57168,"_5":14899,"_28426":56996,"_3090":57169},[],"Number of active, expired and revoked certificates.",{"_3640":1974,"_31229":1900,"_21648":57171,"_5":14899,"_28426":56996,"_3090":57172},[],"Certificates issued in **Issued Certificates**.",{"_3640":1975,"_31229":1900,"_21648":57174,"_5":14899,"_28426":56996,"_3090":57175},[],"The CRL linked to the authority.",{"_3640":1976,"_31229":1900,"_21648":57177,"_5":14899,"_28426":56996,"_3090":57178},[],"Metadata and the associated cryptographic engine.",{"_3640":1977,"_31229":1900,"_21648":57180,"_5":14899,"_28426":56996,"_3090":57181},[],"You can filter the inventory by name, status and CA type.",{"_3640":1978,"_31229":1900,"_21648":57183,"_5":14899,"_28426":57000,"_3090":57184},[],"You can start an issuance from **Issued Certificates**, from a CA's action menu or from the global certificate inventory.",{"_3640":1979,"_31229":1900,"_21648":57186,"_5":14899,"_28426":57000,"_3090":57187},[],"**Generate Key & CSR in Browser** is useful for a manual operation or a quick test. The browser generates the key and you must download it at the end.",{"_3640":1980,"_31229":1900,"_21648":57189,"_5":14899,"_28426":57000,"_3090":57190},[],"**Upload Existing CSR** is the right option when the key must remain on the target system. Lamassu receives the request but never the private key.",{"_3640":1981,"_31229":1900,"_21648":57192,"_5":14899,"_28426":57000,"_3090":57193},[],"Follow Issue your first certificate for the guided flow. Certificate management explains the inventory, inspection and revocation.",{"_3640":1982,"_31229":1900,"_21648":57195,"_5":14899,"_28426":57000,"_3090":57196},[],"A CA key signs certificates only. The CA API has no endpoint to sign or verify arbitrary data. To sign and verify a message with a key, use the KMS operations described in Key management, subject to their own permissions.",{"_3640":1983,"_31229":1900,"_21648":57198,"_5":14899,"_28426":57000,"_3090":57199},[],"A CA signs only while its status is `ACTIVE` and the current time falls inside the validity period of its certificate. Lamassu checks both, because the stored status can lag behind the dates until the expiration monitor runs. Otherwise the request fails with `400` and the message `CA Status inconsistent`, before the KMS is called. The same check applies when the CA signs the certificate of a subordinate CA, including when you create or reissue it.",{"_3640":1984,"_31229":1900,"_21648":57201,"_5":14899,"_28426":57004,"_3090":57202},[],"Revoking a CA prevents issuance and may interrupt its entire branch. With `CertificateHold` the cascade is reversible: descendants are suspended on hold and are restored when you release the CA. Any other revocation reason revokes descendants permanently with `CessationOfOperation`. Follow the cascading revocation conditions.",{"_3640":1985,"_31229":1900,"_21648":57204,"_5":14899,"_28426":57008,"_3090":57205},[],"Identify the certificates, devices and consumers that depend on the CA. Prepare a replacement authority and chain when necessary.",{"_3640":1986,"_31229":1900,"_21648":57207,"_5":14899,"_28426":57012,"_3090":57208},[],"Open the authority and select **Revoke CA**. Choose the reason that describes the incident, for example `KeyCompromise`, `CACompromise`, `Superseded` or `CessationOfOperation`.",{"_3640":1987,"_31229":1900,"_21648":57210,"_5":14899,"_28426":57016,"_3090":57211},[],"Type the CA's name exactly to enable **Confirm Revocation**.",{"_3640":1988,"_31229":1900,"_21648":57213,"_5":14899,"_28426":57020,"_3090":57214},[],"Check **REVOKED** on the CA and review descendants individually; propagation permits partial failures. Independently verify OCSP and CRL publication and consumer rejection. A revoked record does not guarantee that an existing session closes.",{"_3640":1989,"_31229":1900,"_21648":57216,"_5":14899,"_28426":57024,"_3090":57217},[],"Permanent deletion is only available with the CA revoked or expired; a CA imported without a key can be deleted in any state. Delete the record only when your retention and audit policy allows it.",{"_3640":1990,"_31229":1900,"_21648":57219,"_5":14899,"_28426":57024,"_3090":57220},[],"What the deletion does to what the CA issued depends on its status. Deleting an active CA imported without a key whose validity period has not ended only removes the record from Lamassu: the CA, its descendants and the certificates it issued keep their status, since the CA keeps operating outside Lamassu — its key was never in Lamassu. But if the validity period has already ended while the stored status still says `ACTIVE` — the stored status can lag behind the dates until the expiration monitor runs — the CA counts as expired for deletion. Deleting a revoked or expired CA revokes what it issued with `CessationOfOperation`, the same cascade as when revoking a CA. To retire an active keyless CA together with everything it issued, revoke it first with `POST /v1/cas/:id/status` and then delete it.",{"_3640":1991,"_31229":1900,"_21648":57222,"_5":14899,"_28426":57024,"_3090":57223},[],"The CA’s CRL settings are kept. A deletion is refused with a `409` error while they are still `ACTIVE`: the VA must first publish the CA’s final CRL, which can take up to about an hour after revocation with the default job schedule, so retry after the final CRL is published. An expired CA is finalized without a final CRL, and a CA on hold (`CertificateHold`) is refused with a message asking you to revoke it permanently first. The deletion is also refused with a `409` when the CA’s key signs the CRLs of another CA: the error names that CA, so change its CRL signer, or delete or revoke it, before deleting this one. The CA and all its descendants are checked before anything is deleted; nothing changes if any of them cannot be deleted.",{"_3640":1992,"_31229":1900,"_21648":57225,"_5":14899,"_28426":57024,"_3090":57226},[],"After the deletion, the settings are archived and the last CRL keeps being served but is never regenerated; you can remove them once no certificate issued by the CA still needs revocation evidence, using `DELETE /v1/crl-settings/{ca-id}` or the console's **Verification Authorities** page. Deleting them stops the CRL from being served and cannot be undone. Adjust the validity and signer before revoking or deleting the CA (see CRL). The CA’s key is released, but the KMS keeps it while other certificates still reference it.",{"_3640":1993,"_31229":1900,"_21648":57228,"_5":14899,"_28426":57024,"_3090":57229},[],"Lamassu keeps the certificate record of a deleted CA. If that same certificate is imported again, the import succeeds and reuses the record: it updates the type, issuer and key but keeps the status, so the CA reappears in the state it had when deleted (normally revoked or expired). A different certificate with the same serial number is rejected with a 400 error, and a certificate that already belongs to an existing CA with a 409 error. To avoid inheriting the previous status, use a certificate with a different serial number and check the result after importing. The reimported CA is registered under a new, backend-generated CA ID and does not inherit the CRL settings of the deleted CA: until those settings are deleted, those keep serving their last CRL at the CA ID URL, and at `/crl/<ski>` — the URL that certificates issued before the 4.0.0 upgrade carry — when the settings were migrated by that upgrade; when they are archived, they can no longer be edited (see CRL).",{"_3640":1994,"_31229":1994,"_5":15259,"_3090":57231,"_31567":57232,"_21648":57233,"_28426":1994},"Certificate profiles",[51054,52582,56762,56763],[],{"_3640":1995,"_31229":1994,"_21648":57235,"_5":14899,"_28426":1994,"_3090":57236},[],"Define reusable policies to issue consistent certificates and constrain accepted keys.",{"_3640":1996,"_31229":1994,"_5":31564,"_21648":57238,"_28426":57239,"_3090":57240},[],"/docs/platform/pki/certificate-profiles#what-a-profile-controls","What a profile controls",{"_3640":1997,"_31229":1994,"_5":31564,"_21648":57242,"_28426":57243,"_3090":57244},[],"/docs/platform/pki/certificate-profiles#validity","Validity",{"_3640":1998,"_31229":1994,"_5":31564,"_21648":57246,"_28426":57247,"_3090":57248},[],"/docs/platform/pki/certificate-profiles#ca-certificate-or-end-entity-certificate","CA certificate or end-entity certificate",{"_3640":1999,"_31229":1994,"_5":31564,"_21648":57250,"_28426":57251,"_3090":57252},[],"/docs/platform/pki/certificate-profiles#key-usage-and-extended-key-usage","Key Usage and Extended Key Usage",{"_3640":2000,"_31229":1994,"_5":31564,"_21648":57254,"_28426":57255,"_3090":57256},[],"/docs/platform/pki/certificate-profiles#subject","Subject",{"_3640":2001,"_31229":1994,"_5":31564,"_21648":57258,"_28426":57259,"_3090":57260},[],"/docs/platform/pki/certificate-profiles#csr-extensions","CSR extensions",{"_3640":2002,"_31229":1994,"_5":31564,"_21648":57262,"_28426":57263,"_3090":57264},[],"/docs/platform/pki/certificate-profiles#cryptographic-constraints","Cryptographic constraints",{"_3640":2003,"_31229":1994,"_5":31564,"_21648":57266,"_28426":57267,"_3090":57268},[],"/docs/platform/pki/certificate-profiles#profile-precedence","Profile precedence",{"_3640":2004,"_31229":1994,"_5":31564,"_21648":57270,"_28426":57271,"_3090":57272},[],"/docs/platform/pki/certificate-profiles#create-a-profile","Create a profile",{"_3640":2005,"_31229":1994,"_5":31564,"_21648":57274,"_28426":57275,"_3090":57276},[],"/docs/platform/pki/certificate-profiles#define-a-single-purpose","Define a single purpose",{"_3640":2006,"_31229":1994,"_5":31564,"_21648":57278,"_28426":57279,"_3090":57280},[],"/docs/platform/pki/certificate-profiles#choose-the-validity","Choose the validity",{"_3640":2007,"_31229":1994,"_5":31564,"_21648":57282,"_28426":57283,"_3090":57284},[],"/docs/platform/pki/certificate-profiles#fix-usages-and-subject","Fix usages and subject",{"_3640":2008,"_31229":1994,"_5":31564,"_21648":57286,"_28426":57287,"_3090":57288},[],"/docs/platform/pki/certificate-profiles#constrain-the-keys","Constrain the keys",{"_3640":2009,"_31229":1994,"_5":31564,"_21648":57290,"_28426":57291,"_3090":57292},[],"/docs/platform/pki/certificate-profiles#attach-it-and-test","Attach it and test",{"_3640":2010,"_31229":1994,"_5":31564,"_21648":57294,"_28426":57295,"_3090":57296},[],"/docs/platform/pki/certificate-profiles#design-examples","Design examples",{"_3640":2011,"_31229":1994,"_5":31564,"_21648":57298,"_28426":57299,"_3090":57300},[],"/docs/platform/pki/certificate-profiles#changes-and-deletion","Changes and deletion",{"_3640":2012,"_31229":1994,"_21648":57302,"_5":14899,"_28426":1994,"_3090":57303},[],"An issuance profile turns a certificate policy into reusable configuration. Instead of deciding validity, subject, extensions and algorithms on every request, you define once what is allowed and attach the profile to a CA, a DMS or a specific issuance.",{"_3640":2013,"_31229":1994,"_21648":57305,"_5":14899,"_28426":1994,"_3090":57306},[],"This guide is for the PKI administrator defining issuance policy. You need permissions to manage profiles and associate them with the intended CA or DMS, plus a test consumer with known identity and purpose requirements.",{"_3640":2014,"_31229":1994,"_21648":57308,"_5":14899,"_28426":57243,"_3090":57309},[],"You can express the lifetime as a duration from the moment of issuance or as a fixed end date. A duration works well for recurring identities; a common date is useful to make a whole batch end before a migration or retirement.",{"_3640":2015,"_31229":1994,"_21648":57311,"_5":14899,"_28426":57243,"_3090":57312},[],"Plan the end date within the issuing CA’s validity and leave a renewal margin. The signer calculates the date from the profile; it does not automatically clamp validity to the issuer’s expiration. Check both dates in the resulting certificate. A fixed date in the past does not produce a usable identity either.",{"_3640":2016,"_31229":1994,"_21648":57314,"_5":14899,"_28426":57247,"_3090":57315},[],"`Sign as CA` sets `IsCA` and the basic constraints needed for an authority. Lamassu enforces this: a profile with `Sign as CA` is consumed only when creating or reissuing a CA. Any signing request that resolves to such a profile is rejected — direct signing with a CA, including certificate issuance requests on it, and DMS enrollment or re-enrollment. Nothing validates the profile when it is saved: if a CA's default profile or a DMS profile has `Sign as CA` enabled, the problem appears on the first signing request that resolves to it — for a DMS profile, when a device tries to enroll or re-enroll — and renewal stays blocked until the profile is changed.",{"_3640":2017,"_31229":1994,"_21648":57317,"_5":14899,"_28426":57251,"_3090":57318},[],"The profile can enforce usages such as `DigitalSignature`, `KeyEncipherment`, `CertSign`, `CRLSign`, `ClientAuth`, `ServerAuth` or `OCSPSigning`.",{"_3640":2018,"_31229":1994,"_21648":57320,"_5":14899,"_28426":57251,"_3090":57321},[],"If you enable **Honor Key Usage** or **Honor Extended Key Usages**, Lamassu keeps the values requested by the CSR. If you disable them, it replaces them with the ones defined in the profile.",{"_3640":2019,"_31229":1994,"_21648":57323,"_5":14899,"_28426":57251,"_3090":57324},[],"Do not enable the `Honor…` options for untrusted requests unless another component validates those fields. Otherwise, the requester may choose broader capabilities than intended.",{"_3640":2020,"_31229":1994,"_21648":57326,"_5":14899,"_28426":57255,"_3090":57327},[],"With **Honor Subject**, the certificate keeps the subject of the CSR. Without that option, Lamassu applies the profile's `CN`, `O`, `OU`, `C`, `ST` and `L`. If the profile does not define a `Common Name`, the requested CN is kept.",{"_3640":2021,"_31229":1994,"_21648":57329,"_5":14899,"_28426":57259,"_3090":57330},[],"With **Honor Extensions**, Lamassu filters the additional requested extensions and keeps only SAN. Without that option, it discards the CSR's additional extensions.",{"_3640":2022,"_31229":1994,"_21648":57332,"_5":14899,"_28426":57259,"_3090":57333},[],"This preserves SAN, but does not establish that the requester is entitled to those DNS names, IP addresses, emails or URIs. Validate that authorization before issuing. OCSP and CRL locations come from the issuance service configuration; `Honor Extensions` does not copy CSR distribution points.",{"_3640":2023,"_31229":1994,"_21648":57335,"_5":14899,"_28426":57263,"_3090":57336},[],"The cryptographic enforcement can:",{"_3640":2024,"_31229":1994,"_21648":57338,"_5":14899,"_28426":57263,"_3090":57339},[],"allow or block RSA keys;",{"_3640":2025,"_31229":1994,"_21648":57341,"_5":14899,"_28426":57263,"_3090":57342},[],"limit the supported RSA sizes;",{"_3640":2026,"_31229":1994,"_21648":57344,"_5":14899,"_28426":57263,"_3090":57345},[],"allow or block ECDSA keys;",{"_3640":2027,"_31229":1994,"_21648":57347,"_5":14899,"_28426":57263,"_3090":57348},[],"limit the supported ECDSA sizes or curves.",{"_3640":2028,"_31229":1994,"_21648":57350,"_5":14899,"_28426":57263,"_3090":57351},[],"When it is enabled, Lamassu checks the public key before creating a CA or signing a CSR. A key whose type or size is not listed in the profile is rejected.",{"_3640":2029,"_31229":1994,"_21648":57353,"_5":14899,"_28426":57267,"_3090":57354},[],"Resolution depends on the entry point. One complete profile is selected; its fields are not merged with the CA’s profile.",{"_3640":2030,"_31229":1994,"_21648":57356,"_5":14899,"_28426":57267,"_3090":54525},[],{"_3640":2031,"_31229":1994,"_21648":57358,"_5":14899,"_28426":57267,"_3090":57359},[],"First choice",{"_3640":2032,"_31229":1994,"_21648":57361,"_5":14899,"_28426":57267,"_3090":57362},[],"Second choice",{"_3640":2033,"_31229":1994,"_21648":57364,"_5":14899,"_28426":57267,"_3090":57365},[],"If neither is supplied",{"_3640":2034,"_31229":1994,"_21648":57367,"_5":14899,"_28426":57267,"_3090":57368},[],"Direct signing with a CA",{"_3640":2035,"_31229":1994,"_21648":57370,"_5":14899,"_28426":57267,"_3090":57371},[],"`issuance_profile` embedded in the request",{"_3640":2036,"_31229":1994,"_21648":57373,"_5":14899,"_28426":57267,"_3090":57374},[],"Request `issuance_profile_id`",{"_3640":2037,"_31229":1994,"_21648":57376,"_5":14899,"_28426":57267,"_3090":57377},[],"CA default profile (`profile_id`).",{"_3640":2038,"_31229":1994,"_21648":57379,"_5":14899,"_28426":57267,"_3090":57380},[],"Issuance through a DMS",{"_3640":2039,"_31229":1994,"_21648":57382,"_5":14899,"_28426":57267,"_3090":57383},[],"`settings.issuance_profile_id`",{"_3640":2040,"_31229":1994,"_21648":57385,"_5":14899,"_28426":57267,"_3090":57386},[],"`settings.issuance_profile` embedded in the DMS",{"_3640":2041,"_31229":1994,"_21648":57388,"_5":14899,"_28426":57267,"_3090":57389},[],"Enrollment CA default profile.",{"_3640":2042,"_31229":1994,"_21648":57391,"_5":14899,"_28426":57267,"_3090":57392},[],"If the selected identifier cannot be resolved, the operation fails; it does not silently fall back to the CA’s profile. Avoid setting both options at once. Recording which profile was selected helps explain why a certificate differs from its CSR.",{"_3640":2043,"_31229":1994,"_21648":57394,"_5":14899,"_28426":57267,"_3090":57395},[],"Several fleets can share a CA while keeping different profiles through their DMSs. Requester authentication and device registration policy are configured separately in DMS.",{"_3640":2044,"_31229":1994,"_21648":57397,"_5":14899,"_28426":57275,"_3090":57398},[],"Separate, for example, mTLS devices, servers and intermediate CAs. A small, specific profile is easier to review than one that allows every use.",{"_3640":2045,"_31229":1994,"_21648":57400,"_5":14899,"_28426":57279,"_3090":57401},[],"Align the duration with the fleet's real renewal capacity. Leave margin against the CA's expiration.",{"_3640":2046,"_31229":1994,"_21648":57403,"_5":14899,"_28426":57283,"_3090":57404},[],"For a device that authenticates as a client, the usual starting point is `DigitalSignature` and `ClientAuth`. Add `ServerAuth` or `KeyEncipherment` only if the protocol needs it.",{"_3640":2047,"_31229":1994,"_21648":57406,"_5":14899,"_28426":57287,"_3090":57407},[],"Enable cryptographic enforcement and list only algorithms and sizes compatible with your policy and your devices.",{"_3640":2048,"_31229":1994,"_21648":57409,"_5":14899,"_28426":57291,"_3090":57410},[],"Attach the profile to a CA or DMS and check the precedence above. Issue a CSR with known usages and SAN; inspect the result with `openssl x509 -in device.crt -noout -text`. Check subject, SAN, KU, EKU and dates. For an end-entity identity, disable `Sign as CA`, require no `CA:TRUE` or `Certificate Sign`, and require `CA:FALSE` if Basic Constraints is present.",{"_3640":2049,"_31229":1994,"_21648":57412,"_5":14899,"_28426":57291,"_3090":57413},[],"Also try a key excluded by policy: issuance should fail. Follow the certificate verification and test acceptance in the intended consumer.",{"_3640":2050,"_31229":1994,"_21648":57415,"_5":14899,"_28426":57295,"_3090":57416},[],"**mTLS device**\\\nEnd-entity certificate, short validity, `DigitalSignature`, `ClientAuth`, subject controlled by the DMS and SAN allowed when it identifies the device.",{"_3640":2051,"_31229":1994,"_21648":57418,"_5":14899,"_28426":57295,"_3090":57419},[],"**TLS server**\\\nEnd-entity certificate, `DigitalSignature`, `ServerAuth` and mandatory SAN with the names clients will use.",{"_3640":2052,"_31229":1994,"_21648":57421,"_5":14899,"_28426":57295,"_3090":57422},[],"**Intermediate CA**\\\n`Sign as CA`, `CertSign` and `CRLSign`, validity longer than its end-entity certificates and stricter cryptographic constraints.",{"_3640":2053,"_31229":1994,"_21648":57424,"_5":14899,"_28426":57295,"_3090":57425},[],"These patterns express design decisions. Enabling `Honor Extensions` does not require a CSR to contain SAN or validate its names; enforce that in the request workflow. A profile does not install trust or grant permissions in the consumer.",{"_3640":2054,"_31229":1994,"_21648":57427,"_5":14899,"_28426":57299,"_3090":57428},[],"Updating a profile affects future issuances; it does not modify already-signed certificates. Test changes before applying them to a CA in production and keep the operational justification.",{"_3640":2055,"_31229":1994,"_21648":57430,"_5":14899,"_28426":57299,"_3090":57431},[],"Before deleting a profile, check that no CA or DMS depends on it. If you want to replace it, create the new version, update the references and perform a test issuance before retiring the old one.",{"_3640":2056,"_31229":2056,"_5":15259,"_3090":57433,"_31567":57434,"_21648":57436,"_28426":2056},"Certificate validation",[51054,52582,56762,57435],"Validation",[],{"_3640":2057,"_31229":2056,"_21648":57438,"_5":14899,"_28426":2056,"_3090":57439},[],"Check chain, identity, purpose and revocation from the consumer.",{"_3640":2058,"_31229":2056,"_5":31564,"_21648":57441,"_28426":57442,"_3090":57443},[],"/docs/platform/pki/certificate-validation#before-querying-status","Before querying status",{"_3640":2059,"_31229":2056,"_5":31564,"_21648":57445,"_28426":57446,"_3090":57447},[],"/docs/platform/pki/certificate-validation#choose-a-mechanism","Choose a mechanism",{"_3640":2060,"_31229":2056,"_5":31564,"_21648":57449,"_28426":57450,"_3090":57451},[],"/docs/platform/pki/certificate-validation#check-consumer-behavior","Check consumer behavior",{"_3640":2061,"_31229":2056,"_21648":57453,"_5":14899,"_28426":2056,"_3090":57454},[],"This guide brings together the checks needed when integrating a certificate consumer. You need the presented certificate, intermediates and roots that your application has deliberately chosen to trust. Lamassu publishes status; the consumer applies acceptance policy.",{"_3640":2062,"_31229":2056,"_21648":57456,"_5":14899,"_28426":57442,"_3090":57457},[],"Verify these criteria together:",{"_3640":2063,"_31229":2056,"_21648":57459,"_5":14899,"_28426":57442,"_3090":56388},[],{"_3640":2064,"_31229":2056,"_21648":57461,"_5":14899,"_28426":57442,"_3090":57462},[],"Required result",{"_3640":2065,"_31229":2056,"_21648":57464,"_5":14899,"_28426":57442,"_3090":57465},[],"Chain and signature",{"_3640":2066,"_31229":2056,"_21648":57467,"_5":14899,"_28426":57442,"_3090":57468},[],"Valid chain to a root deliberately installed in the consumer.",{"_3640":2067,"_31229":2056,"_21648":57470,"_5":14899,"_28426":57442,"_3090":57471},[],"Dates",{"_3640":2068,"_31229":2056,"_21648":57473,"_5":14899,"_28426":57442,"_3090":57474},[],"Current time between `Not Before` and `Not After`, including the CAs in the chain.",{"_3640":2069,"_31229":2056,"_21648":57476,"_5":14899,"_28426":57442,"_3090":52251},[],{"_3640":2070,"_31229":2056,"_21648":57478,"_5":14899,"_28426":57442,"_3090":57479},[],"Name, SAN or identifier matches the expected peer.",{"_3640":2071,"_31229":2056,"_21648":57481,"_5":14899,"_28426":57442,"_3090":51444},[],{"_3640":2072,"_31229":2056,"_21648":57483,"_5":14899,"_28426":57442,"_3090":57484},[],"KU, EKU and constraints permit the specific operation.",{"_3640":2073,"_31229":2056,"_21648":57486,"_5":14899,"_28426":57442,"_3090":57487},[],"Revocation",{"_3640":2074,"_31229":2056,"_21648":57489,"_5":14899,"_28426":57442,"_3090":57490},[],"Signed, current evidence corresponding to the queried issuer and certificate.",{"_3640":2075,"_31229":2056,"_21648":57492,"_5":14899,"_28426":57442,"_3090":57493},[],"Authorization",{"_3640":2076,"_31229":2056,"_21648":57495,"_5":14899,"_28426":57442,"_3090":57496},[],"The application permits that identity to perform the action.",{"_3640":2077,"_31229":2056,"_21648":57498,"_5":14899,"_28426":57442,"_3090":57499},[],"The issuance walkthrough checks chain and purpose with OpenSSL. That check does not automatically query OCSP or download a CRL. Inventory presence or an OCSP `Good` response does not replace the other criteria.",{"_3640":2078,"_31229":2056,"_21648":57501,"_5":14899,"_28426":57446,"_3090":57502},[],"Mechanism",{"_3640":2079,"_31229":2056,"_21648":57504,"_5":14899,"_28426":57446,"_3090":57505},[],"When to use it",{"_3640":2080,"_31229":2056,"_21648":57507,"_5":14899,"_28426":57446,"_3090":57508},[],"What you must maintain",{"_3640":2081,"_31229":2056,"_21648":57510,"_5":14899,"_28426":57446,"_3090":57511},[],"OCSP",{"_3640":2082,"_31229":2056,"_21648":57513,"_5":14899,"_28426":57446,"_3090":57514},[],"Status query for a specific certificate.",{"_3640":2083,"_31229":2056,"_21648":57516,"_5":14899,"_28426":57446,"_3090":57517},[],"Responder access, signature verification and cache/freshness policy.",{"_3640":2084,"_31229":2056,"_21648":57519,"_5":14899,"_28426":57446,"_3090":57520},[],"CRL",{"_3640":2085,"_31229":2056,"_21648":57522,"_5":14899,"_28426":57446,"_3090":57523},[],"Local checks for many certificates or offline operation.",{"_3640":2086,"_31229":2056,"_21648":57525,"_5":14899,"_28426":57446,"_3090":57526},[],"Periodic download of an issuer-signed list and rejection of expired lists.",{"_3640":2087,"_31229":2056,"_21648":57528,"_5":14899,"_28426":57446,"_3090":57529},[],"OCSP can also return a response reusable until `nextUpdate`; a CRL changes when a new version is published. Neither mechanism alone guarantees that a consumer learns a revocation at the moment it is saved.",{"_3640":2088,"_31229":2056,"_21648":57531,"_5":14899,"_28426":57446,"_3090":57532},[],"If using both, define when fallback is allowed and what the client does when retrieval, signature or freshness checks fail, or the result is `Unknown`. Accepting an identity when its status cannot be checked must be an explicit application decision.",{"_3640":2089,"_31229":2056,"_21648":57534,"_5":14899,"_28426":57450,"_3090":57535},[],"Accept a current, authorized certificate with a known chain.",{"_3640":2090,"_31229":2056,"_21648":57537,"_5":14899,"_28426":57450,"_3090":57538},[],"Reject another certificate with an unknown root or incompatible purpose.",{"_3640":2091,"_31229":2056,"_21648":57540,"_5":14899,"_28426":57450,"_3090":57541},[],"Revoke a test certificate and verify the OCSP response or new CRL.",{"_3640":2092,"_31229":2056,"_21648":57543,"_5":14899,"_28426":57450,"_3090":57544},[],"Check that a new connection with that identity is rejected.",{"_3640":2093,"_31229":2056,"_21648":57546,"_5":14899,"_28426":57450,"_3090":57547},[],"Simulate an unreachable endpoint and expired evidence; observe whether the result matches policy.",{"_3640":2094,"_31229":2056,"_21648":57549,"_5":14899,"_28426":57450,"_3090":57550},[],"Keep the serial number, issuer, revocation reason, query time and evidence timestamps. An existing session may need explicit closure or reauthentication in the consumer; publishing revocation does not automatically close it.",{"_3640":2095,"_31229":2056,"_21648":57552,"_5":14899,"_28426":57450,"_3090":57553},[],"For a chain with intermediates, validate their status according to consumer policy as well. An end-entity issuer’s CRL does not replace checks on every CA in the chain.",{"_3640":2096,"_31229":2056,"_21648":57555,"_5":14899,"_28426":57450,"_3090":57556},[],"<Card title=\"Online validation with OCSP\" description=\"Generate a query and verify signature, status and timestamps.\" href=\"/docs/platform/pki/ocsp\" />",{"_3640":2097,"_31229":2056,"_21648":57558,"_5":14899,"_28426":57450,"_3090":57559},[],"<Card title=\"Revocation lists\" description=\"Download, inspect and use an issuer’s CRL.\" href=\"/docs/platform/pki/crl\" />",{"_3640":2098,"_31229":2098,"_5":15259,"_3090":57561,"_31567":57562,"_21648":57563,"_28426":2098},"Certificates",[51054,52582,56762,56763],[],{"_3640":2099,"_31229":2098,"_21648":57565,"_5":14899,"_28426":2098,"_3090":57566},[],"Inspect, download and revoke the certificates issued by Lamassu.",{"_3640":2100,"_31229":2098,"_5":31564,"_21648":57568,"_28426":57569,"_3090":57570},[],"/docs/platform/pki/certificates#find-a-certificate","Find a certificate",{"_3640":2101,"_31229":2098,"_5":31564,"_21648":57572,"_28426":57573,"_3090":57574},[],"/docs/platform/pki/certificates#download-the-certificate","Download the certificate",{"_3640":2102,"_31229":2098,"_5":31564,"_21648":57576,"_28426":57577,"_3090":57578},[],"/docs/platform/pki/certificates#issue-from-an-existing-csr","Issue from an existing CSR",{"_3640":2103,"_31229":2098,"_5":31564,"_21648":57580,"_28426":57581,"_3090":57582},[],"/docs/platform/pki/certificates#revoke-a-certificate","Revoke a certificate",{"_3640":2104,"_31229":2098,"_5":31564,"_21648":57584,"_28426":57585,"_3090":57586},[],"/docs/platform/pki/certificates#open-the-action","Open the action",{"_3640":2105,"_31229":2098,"_5":31564,"_21648":57588,"_28426":57589,"_3090":57590},[],"/docs/platform/pki/certificates#choose-a-reason","Choose a reason",{"_3640":2106,"_31229":2098,"_5":31564,"_21648":57592,"_28426":57593,"_3090":57594},[],"/docs/platform/pki/certificates#confirm-and-verify","Confirm and verify",{"_3640":2107,"_31229":2098,"_5":31564,"_21648":57596,"_28426":57597,"_3090":57598},[],"/docs/platform/pki/certificates#reactivate-a-hold","Reactivate a hold",{"_3640":2108,"_31229":2098,"_5":31564,"_21648":57600,"_28426":57601,"_3090":57602},[],"/docs/platform/pki/certificates#continue","Continue",{"_3640":2109,"_31229":2098,"_21648":57604,"_5":14899,"_28426":2098,"_3090":57605},[],"This guide is for a PKI operator inspecting or retiring an issued identity. You need inventory access and, to change states, permissions on the certificate. Open **Certificates** for a global view or **Issued Certificates** within a CA to restrict it to that issuer.",{"_3640":2110,"_31229":2098,"_21648":57607,"_5":14899,"_28426":57569,"_3090":57608},[],"Filter by `Common Name`, serial, status and issuer. A certificate does not contain its private key, so the private-key surfaces answer which certificates have their key held in Lamassu’s KMS:",{"_3640":2111,"_31229":2098,"_21648":57610,"_5":14899,"_28426":57569,"_3090":57611},[],"The advanced **Private Key** filter, available on the Certificates page and on a CA’s **Issued Certificates** tab, narrows the list to **All Certificates**, **With Private Key** or **Without Private Key**.",{"_3640":2112,"_31229":2098,"_21648":57613,"_5":14899,"_28426":57569,"_3090":57614},[],"The sortable **Private Key** column — shown by default, hidden on narrow screens — marks a key held in the KMS with a green check mark and otherwise shows `-`.",{"_3640":2113,"_31229":2098,"_21648":57616,"_5":14899,"_28426":57569,"_3090":57617},[],"In certificate details, the **Information** tab shows a **Private Key** row in the **Key & Signature** section. When the certificate reports a private key and its KMS engine and key IDs are available, the row links to the key (tooltip: **Open private key in KMS**). Otherwise, it shows **Present** if the certificate reports a private key, or **Not available** if it does not. This does not establish whether a key exists outside Lamassu.",{"_3640":2114,"_31229":2098,"_21648":57619,"_5":14899,"_28426":57569,"_3090":57620},[],"Use **Quick Inspect** for a quick review or **View Details** for subject, SAN, usages, chain, dates and metadata.",{"_3640":2115,"_31229":2098,"_21648":57622,"_5":14899,"_28426":57569,"_3090":57623},[],"Certificate records expose `key_id` (the KMS key that holds the private key, empty when the KMS does not hold it) and `has_private_key` (derived at read time from the KMS). Certificate and CA listings accept a `has_private_key` filter, which is useful, for example, to check the result of the CA-to-KMS migration of the 4.0.0 upgrade.",{"_3640":2116,"_31229":2098,"_21648":57625,"_5":14899,"_28426":57569,"_3090":57626},[],"Identify a certificate by issuer and serial; a name can correspond to several renewals. Check which certificate the consumer actually uses and which occupies the device’s active identity. Identity history and the certificate inventory answer different questions.",{"_3640":2117,"_31229":2098,"_21648":57628,"_5":14899,"_28426":57573,"_3090":57629},[],"Download the PEM and inspect it:",{"_3640":2118,"_31229":2098,"_21648":57631,"_5":14899,"_28426":57573,"_3090":57632},[],"Check issuance policy, chain and usages with the verification walkthrough. A certificate does not contain its private key. For an external CSR, the key remains where it was generated; for the browser flow, retain the file downloaded upon issuance. If the key is lost, plan a new identity rather than expecting recovery from the certificate.",{"_3640":2119,"_31229":2098,"_21648":57634,"_5":14899,"_28426":57577,"_3090":57635},[],"Use this flow when the identity’s key must remain on the system that generated it. You need an active CA with a usable key, a PEM CSR and a suitable profile.",{"_3640":2120,"_31229":2098,"_21648":57637,"_5":14899,"_28426":57577,"_3090":57638},[],"Verify the request with `openssl req -in request.csr -noout -verify -text`. Review subject, SAN and algorithm, and authorize the requested identity.",{"_3640":2121,"_31229":2098,"_21648":57640,"_5":14899,"_28426":57577,"_3090":57641},[],"Start issuance from the CA or inventory and select **Upload Existing CSR**.",{"_3640":2122,"_31229":2098,"_21648":57643,"_5":14899,"_28426":57577,"_3090":57644},[],"Confirm the CA and profile resolved according to Profiles; the request does not guarantee that every field is retained.",{"_3640":2123,"_31229":2098,"_21648":57646,"_5":14899,"_28426":57577,"_3090":57647},[],"Download the certificate and inspect dates, issuer, subject, SAN, KU and EKU. Check correspondence with the private key on the originating system.",{"_3640":2124,"_31229":2098,"_21648":57649,"_5":14899,"_28426":57577,"_3090":57650},[],"Install certificate and chain in the intended consumer and test a connection. Issuance alone does not register a device or grant access in an integration.",{"_3640":2125,"_31229":2098,"_21648":57652,"_5":14899,"_28426":57577,"_3090":57653},[],"For browser key generation, follow Issue your first certificate.",{"_3640":2126,"_31229":2098,"_21648":57655,"_5":14899,"_28426":57581,"_3090":57656},[],"Revoke when the key is compromised, the subject is no longer authorized or the identity must stop being accepted before expiration. Before changing status, identify consumers and prepare any required replacement.",{"_3640":2127,"_31229":2098,"_21648":57658,"_5":14899,"_28426":57585,"_3090":57659},[],"Locate the correct issuer and serial and select **Revoke Certificate**. `EXPIRED` records and records revoked for a final reason reject subsequent status changes.",{"_3640":2128,"_31229":2098,"_21648":57661,"_5":14899,"_28426":57589,"_3090":57662},[],"Select the incident reason. `CertificateHold` represents a reversible certificate suspension; other reasons block later changes. Do not use a suspension to address a compromised key.",{"_3640":2129,"_31229":2098,"_21648":57664,"_5":14899,"_28426":57593,"_3090":57665},[],"Save the change and read the record again: require **REVOKED**, reason and timestamp. Then verify a fresh OCSP query and, if using CRL, its published version and the serial’s presence. Finally check rejection of a new connection in the consumer.",{"_3640":2130,"_31229":2098,"_21648":57667,"_5":14899,"_28426":57593,"_3090":57668},[],"Revocation does not erase the certificate, delete the key or guarantee closure of existing sessions. Status and publication are separate steps.",{"_3640":2131,"_31229":2098,"_21648":57670,"_5":14899,"_28426":57593,"_3090":57671},[],"A certificate revoked with `CertificateHold` can be reactivated if it is not in `EXPIRED` state. Its dates and consumer trust remain mandatory.",{"_3640":2132,"_31229":2098,"_21648":57673,"_5":14899,"_28426":57597,"_3090":57674},[],"Check that the saved reason is `CertificateHold` and the identity still satisfies policy. Request `ACTIVE` through the status update operation exposed by your installation; consult the API reference. Do not assume changing consumer permissions also changes status in Lamassu.",{"_3640":2133,"_31229":2098,"_21648":57676,"_5":14899,"_28426":57597,"_3090":57677},[],"Read the record and query OCSP again. With `regenerate_on_revoke` enabled, the reactivation event requests CRL regeneration: check that the new list omits the serial. An earlier list can still mark it revoked until the client refreshes its copy.",{"_3640":2134,"_31229":2098,"_21648":57679,"_5":14899,"_28426":57597,"_3090":57680},[],"This does not undo permanent revocation or the cascade of a CA revoked for good; the hold cascaded by a CA is lifted by releasing that CA.",{"_3640":2135,"_31229":2098,"_21648":57682,"_5":14899,"_28426":57601,"_3090":57683},[],"<Card title=\"Validate with OCSP\" description=\"Query and verify a certificate’s signed status.\" href=\"/docs/platform/pki/ocsp\" />",{"_3640":2136,"_31229":2098,"_21648":57685,"_5":14899,"_28426":57601,"_3090":57686},[],"<Card title=\"Distribute a CRL\" description=\"Publish status for local validation.\" href=\"/docs/platform/pki/crl\" />",{"_3640":2137,"_31229":2137,"_5":15259,"_3090":57688,"_31567":57689,"_21648":57691,"_28426":2137},"Certificate lifecycle",[51054,52582,56762,57690],"Concepts",[],{"_3640":2138,"_31229":2137,"_21648":57693,"_5":14899,"_28426":2137,"_3090":57694},[],"Issuance, use, renewal, revocation and retirement of certificates in Lamassu.",{"_3640":2139,"_31229":2137,"_5":31564,"_21648":57696,"_28426":57697,"_3090":57698},[],"/docs/platform/pki/concepts/certificate-lifecycle#the-full-journey","The full journey",{"_3640":2140,"_31229":2137,"_5":31564,"_21648":57700,"_28426":57701,"_3090":57702},[],"/docs/platform/pki/concepts/certificate-lifecycle#request","Request",{"_3640":2141,"_31229":2137,"_5":31564,"_21648":57704,"_28426":57705,"_3090":57706},[],"/docs/platform/pki/concepts/certificate-lifecycle#issuance","Issuance",{"_3640":2142,"_31229":2137,"_5":31564,"_21648":57708,"_28426":57709,"_3090":57710},[],"/docs/platform/pki/concepts/certificate-lifecycle#use-and-monitoring","Use and monitoring",{"_3640":2143,"_31229":2137,"_5":31564,"_21648":57712,"_28426":57713,"_3090":57714},[],"/docs/platform/pki/concepts/certificate-lifecycle#renewal-or-re-enrollment","Renewal or re-enrollment",{"_3640":2144,"_31229":2137,"_5":31564,"_21648":57716,"_28426":57717,"_3090":57718},[],"/docs/platform/pki/concepts/certificate-lifecycle#revocation-or-retirement","Revocation or retirement",{"_3640":2145,"_31229":2137,"_5":31564,"_21648":57720,"_28426":57721,"_3090":57722},[],"/docs/platform/pki/concepts/certificate-lifecycle#certificate-states","Certificate states",{"_3640":2146,"_31229":2137,"_5":31564,"_21648":57724,"_28426":57725,"_3090":57726},[],"/docs/platform/pki/concepts/certificate-lifecycle#renewal-and-revocation-are-not-equivalent","Renewal and revocation are not equivalent",{"_3640":2147,"_31229":2137,"_5":31564,"_21648":57728,"_28426":57729,"_3090":57730},[],"/docs/platform/pki/concepts/certificate-lifecycle#effect-of-revoking-a-ca","Effect of revoking a CA",{"_3640":2148,"_31229":2137,"_5":31564,"_21648":57732,"_28426":57733,"_3090":57734},[],"/docs/platform/pki/concepts/certificate-lifecycle#what-you-should-watch","What you should watch",{"_3640":2149,"_31229":2137,"_21648":57736,"_5":14899,"_28426":2137,"_3090":57737},[],"Issuing a certificate is only the beginning. During its useful life you must check its validity, renew it before it expires and retire it when it stops being trustworthy. Lamassu keeps the certificate, its issuing CA, its status and, when it belongs to a device, the identity it is linked to.",{"_3640":2150,"_31229":2137,"_21648":57739,"_5":14899,"_28426":57701,"_3090":57740},[],"The requester generates a key and a CSR. In the recommended flows, the private key stays in the device, browser or cryptographic engine that created it.",{"_3640":2151,"_31229":2137,"_21648":57742,"_5":14899,"_28426":57705,"_3090":57743},[],"The CA signs the CSR. The issuance profile determines the validity, uses, subject, allowed extensions and cryptographic constraints.",{"_3640":2152,"_31229":2137,"_21648":57745,"_5":14899,"_28426":57709,"_3090":57746},[],"The certificate enters the `ACTIVE` state. Lamassu monitors its `Not After` date; the cryptographic monitoring job marks certificates that have expired as `EXPIRED`.",{"_3640":2153,"_31229":2137,"_21648":57748,"_5":14899,"_28426":57713,"_3090":57749},[],"A new certificate is issued before the previous one expires. In a DMS you can open preventive and critical windows so the device re-enrolls through EST.",{"_3640":2154,"_31229":2137,"_21648":57751,"_5":14899,"_28426":57717,"_3090":57752},[],"If the identity stops being trustworthy, Lamassu records the reason and time of revocation. OCSP and CRLs let consumers learn that status.",{"_3640":2155,"_31229":2137,"_21648":57754,"_5":14899,"_28426":57721,"_3090":57755},[],"Lamassu persists four X.509 states:",{"_3640":2156,"_31229":2137,"_21648":57757,"_5":14899,"_28426":57721,"_3090":57758},[],"**`ACTIVE`**: the record is enabled. Also check `Not Before` and `Not After`: this state does not establish time validity.",{"_3640":2157,"_31229":2137,"_21648":57760,"_5":14899,"_28426":57721,"_3090":57761},[],"**`EXPIRED`**: it has passed its expiration date. The monitor detects this periodically; it is not a state that should be assigned manually.",{"_3640":2158,"_31229":2137,"_21648":57763,"_5":14899,"_28426":57721,"_3090":57764},[],"**`REVOKED`**: it was invalidated before expiring, with a reason and a timestamp.",{"_3640":2159,"_31229":2137,"_21648":57766,"_5":14899,"_28426":57721,"_3090":57767},[],"**`INACTIVE`**: it is disabled without representing a definitive revocation.",{"_3640":2160,"_31229":2137,"_21648":57769,"_5":14899,"_28426":57721,"_3090":57770},[],"The device view may add operational states such as missing identity, pending renewal, expiring soon or decommissioned. These are an interpretation of the device's status and its certificates, not new X.509 states.",{"_3640":2161,"_31229":2137,"_21648":57772,"_5":14899,"_28426":57725,"_3090":57773},[],"**Renewal** creates a successor certificate for an identity that remains valid. **Revocation** communicates that the current certificate must no longer be accepted. Renew to maintain continuity; revoke in response to compromise, retirement or a change that invalidates the identity.",{"_3640":2162,"_31229":2137,"_21648":57775,"_5":14899,"_28426":57725,"_3090":57776},[],"Only `CertificateHold` allows reactivating a revoked certificate that is not in `EXPIRED` state. Revocation for another reason blocks subsequent status changes. `EXPIRED` records also reject changes; the consumer must check dates even before the monitor updates the state. Certificates explains how to verify revocation and reactivation.",{"_3640":2163,"_31229":2137,"_21648":57778,"_5":14899,"_28426":57725,"_3090":57779},[],"The **Reissue CA** operation generates another certificate for the same key and links both serial numbers through metadata. It is not a key rotation. To change the key, create a successor CA and perform a migration with an overlapping period.",{"_3640":2164,"_31229":2137,"_21648":57781,"_5":14899,"_28426":57729,"_3090":57782},[],"Revoking a CA starts a cascade that attempts to revoke descendants. A `CertificateHold` cascade suspends them reversibly: releasing the CA restores those still on hold. Any other revocation reason revokes descendants permanently with `CessationOfOperation`. Read Hierarchy and rotation for conditions and checks.",{"_3640":2165,"_31229":2137,"_21648":57784,"_5":14899,"_28426":57729,"_3090":57785},[],"Before confirming:",{"_3640":2166,"_31229":2137,"_21648":57787,"_5":14899,"_28426":57729,"_3090":57788},[],"Identify DMSs, devices and services that trust that chain.",{"_3640":2167,"_31229":2137,"_21648":57790,"_5":14899,"_28426":57729,"_3090":57791},[],"Distribute the new chain of trust.",{"_3640":2168,"_31229":2137,"_21648":57793,"_5":14899,"_28426":57729,"_3090":57794},[],"Reissue the necessary identities.",{"_3640":2169,"_31229":2137,"_21648":57796,"_5":14899,"_28426":57729,"_3090":57797},[],"Check OCSP and CRL from a real consumer.",{"_3640":2170,"_31229":2137,"_21648":57799,"_5":14899,"_28426":57729,"_3090":57800},[],"Revoke the old CA once no legitimate traffic remains.",{"_3640":2171,"_31229":2137,"_21648":57802,"_5":14899,"_28426":57729,"_3090":57803},[],"Device retirement belongs to the IoT Fleets lifecycle. It affects the active identity; it does not automatically traverse and revoke every historical certificate. Review previous identities and consumer permissions separately in Device management.",{"_3640":2172,"_31229":2137,"_21648":57805,"_5":14899,"_28426":57733,"_3090":57806},[],"Certificates entering the preventive or critical renewal window.",{"_3640":2173,"_31229":2137,"_21648":57808,"_5":14899,"_28426":57733,"_3090":57809},[],"Repeated enrollment or re-enrollment failures.",{"_3640":2174,"_31229":2137,"_21648":57811,"_5":14899,"_28426":57733,"_3090":57812},[],"Status changes and revocation reasons.",{"_3640":2175,"_31229":2137,"_21648":57814,"_5":14899,"_28426":57733,"_3090":57815},[],"OCSP and CRL publication and validity.",{"_3640":2176,"_31229":2137,"_21648":57817,"_5":14899,"_28426":57733,"_3090":57818},[],"Dependencies still presenting a replaced certificate.",{"_3640":2177,"_31229":2137,"_21648":57820,"_5":14899,"_28426":57733,"_3090":57821},[],"The device history relates its previous and current identities. For administrative changes and mutation errors, see Audit logs.",{"_3640":2178,"_31229":2178,"_5":15259,"_3090":57823,"_31567":57824,"_21648":57825,"_28426":2178},"Trust model",[51054,52582,56762,57690],[],{"_3640":2179,"_31229":2178,"_21648":57827,"_5":14899,"_28426":2178,"_3090":57828},[],"Understand where trust originates, how it is distributed and what each component validates.",{"_3640":2180,"_31229":2178,"_5":31564,"_21648":57830,"_28426":57831,"_3090":57832},[],"/docs/platform/pki/concepts/trust-model#the-four-trust-decisions","The four trust decisions",{"_3640":2181,"_31229":2178,"_5":31564,"_21648":57834,"_28426":57835,"_3090":57836},[],"/docs/platform/pki/concepts/trust-model#who-can-issue","Who can issue",{"_3640":2182,"_31229":2178,"_5":31564,"_21648":57838,"_28426":57839,"_3090":57840},[],"/docs/platform/pki/concepts/trust-model#what-can-be-issued","What can be issued",{"_3640":2183,"_31229":2178,"_5":31564,"_21648":57842,"_28426":57843,"_3090":57844},[],"/docs/platform/pki/concepts/trust-model#who-can-request-it","Who can request it",{"_3640":2184,"_31229":2178,"_5":31564,"_21648":57846,"_28426":57847,"_3090":57848},[],"/docs/platform/pki/concepts/trust-model#who-accepts-the-result","Who accepts the result",{"_3640":2185,"_31229":2178,"_5":31564,"_21648":57850,"_28426":57851,"_3090":57852},[],"/docs/platform/pki/concepts/trust-model#identity-flow","Identity flow",{"_3640":2186,"_31229":2178,"_5":31564,"_21648":57854,"_28426":57855,"_3090":57856},[],"/docs/platform/pki/concepts/trust-model#enrollment-validation-and-distribution-cas","Enrollment, validation and distribution CAs",{"_3640":2187,"_31229":2178,"_5":31564,"_21648":57858,"_28426":57859,"_3090":57860},[],"/docs/platform/pki/concepts/trust-model#validation-and-revocation","Validation and revocation",{"_3640":2188,"_31229":2178,"_5":31564,"_21648":57862,"_28426":57863,"_3090":57864},[],"/docs/platform/pki/concepts/trust-model#custody-limits","Custody limits",{"_3640":2189,"_31229":2178,"_5":31564,"_21648":57866,"_28426":57867,"_3090":57868},[],"/docs/platform/pki/concepts/trust-model#recommended-pattern","Recommended pattern",{"_3640":2190,"_31229":2178,"_21648":57870,"_5":14899,"_28426":2178,"_3090":57871},[],"In Lamassu, trust does not simply mean that a certificate exists in the inventory. A consumer trusts an identity when it can build a chain to a root it recognizes, check that the certificate is fit for the intended use and verify that it is still valid.",{"_3640":2191,"_31229":2178,"_21648":57873,"_5":14899,"_28426":57835,"_3090":57874},[],"The CA hierarchy defines which authorities can sign. A root CA establishes the anchor of trust; intermediate CAs separate operating domains and avoid using the root for every issuance.",{"_3640":2192,"_31229":2178,"_21648":57876,"_5":14899,"_28426":57839,"_3090":57877},[],"Certificate profiles limit validity, subject, uses, extensions and cryptographic parameters. Possessing a CA does not replace an issuance policy.",{"_3640":2193,"_31229":2178,"_21648":57879,"_5":14899,"_28426":57843,"_3090":57880},[],"The DMS acts as the enrollment point. It can authenticate an EST request with a client certificate, an external webhook or a combination of both. CAs configured to validate the requester do not have to be the CA that will issue the new identity.",{"_3640":2194,"_31229":2178,"_21648":57882,"_5":14899,"_28426":57847,"_3090":57883},[],"The consumer keeps its own trust store. EST `/cacerts` can distribute the service TLS certificate, the enrollment CA and selected managed CAs. Initial trust for authenticating that service must come from an already trusted channel. Download and inspect the contents: do not assume they form a complete chain or install every entry as a root.",{"_3640":2195,"_31229":2178,"_21648":57885,"_5":14899,"_28426":57851,"_3090":57886},[],"The device proves it can enroll according to the DMS policy.",{"_3640":2196,"_31229":2178,"_21648":57888,"_5":14899,"_28426":57851,"_3090":57889},[],"The DMS validates the request and forwards the CSR to the enrollment CA.",{"_3640":2197,"_31229":2178,"_21648":57891,"_5":14899,"_28426":57851,"_3090":57892},[],"In the device-generated CSR flow, the CA applies the profile and signs without receiving the device’s private key.",{"_3640":2198,"_31229":2178,"_21648":57894,"_5":14899,"_28426":57851,"_3090":57895},[],"The device installs the certificate and the chain it needs.",{"_3640":2199,"_31229":2178,"_21648":57897,"_5":14899,"_28426":57851,"_3090":57898},[],"The system that trusts the device validates the chain, dates, uses and revocation status.",{"_3640":2200,"_31229":2178,"_21648":57900,"_5":14899,"_28426":57851,"_3090":57901},[],"OIDC or X.509 identifies the operator calling Lamassu. The authorization service decides which actions it may perform. The X.509 hierarchy, on the other hand, determines whether a certificate presented by a device is trustworthy.",{"_3640":2201,"_31229":2178,"_21648":57903,"_5":14899,"_28426":57855,"_3090":57904},[],"A DMS relates three sets that are worth designing separately:",{"_3640":2202,"_31229":2178,"_21648":57906,"_5":14899,"_28426":57855,"_3090":57907},[],"**Enrollment CA:** signs the new identities.",{"_3640":2203,"_31229":2178,"_21648":57909,"_5":14899,"_28426":57855,"_3090":57910},[],"**Validation CAs:** authenticate the client certificates used for enrollment or migration. During re-enrollment, the enrollment CA is always trusted and Lamassu then tries the validation CAs configured in the re-enrollment block; those are optional.",{"_3640":2204,"_31229":2178,"_21648":57912,"_5":14899,"_28426":57855,"_3090":57913},[],"**Distributed CAs:** form the content the device obtains through EST `/cacerts`. You can include the service TLS certificate, the enrollment CA and an explicit list of managed CAs. Including the issuer does not automatically add all its ancestors.",{"_3640":2205,"_31229":2178,"_21648":57915,"_5":14899,"_28426":57855,"_3090":57916},[],"This separation makes it possible to migrate a fleet: you temporarily accept certificates from the old hierarchy, issue with the new one and distribute both chains during the overlap.",{"_3640":2206,"_31229":2178,"_21648":57918,"_5":14899,"_28426":57859,"_3090":57919},[],"A valid chain does not by itself guarantee that a certificate should be accepted. The consumer must also check:",{"_3640":2207,"_31229":2178,"_21648":57921,"_5":14899,"_28426":57859,"_3090":57922},[],"that the current date is between `Not Before` and `Not After`;",{"_3640":2208,"_31229":2178,"_21648":57924,"_5":14899,"_28426":57859,"_3090":57925},[],"that `Key Usage` and `Extended Key Usage` allow the operation;",{"_3640":2209,"_31229":2178,"_21648":57927,"_5":14899,"_28426":57859,"_3090":57928},[],"that names, SANs and subject match the expected identity;",{"_3640":2210,"_31229":2178,"_21648":57930,"_5":14899,"_28426":57859,"_3090":57931},[],"that the certificate does not appear revoked in OCSP or a CRL.",{"_3640":2211,"_31229":2178,"_21648":57933,"_5":14899,"_28426":57859,"_3090":57934},[],"An OCSP `Good` status does not replace chain, date, usage and identity checks either; Validation brings those criteria together.",{"_3640":2212,"_31229":2178,"_21648":57936,"_5":14899,"_28426":57859,"_3090":57937},[],"During the mTLS authentication of a DMS, Lamassu checks revocation and fails closed: a certificate whose revocation cannot be verified is rejected by default. The `allow_unverifiable_revocation` option of the DMS (see DMS) is the opt-out, and it only relaxes certificates that carry no OCSP/CRL endpoint at all. Design your profiles and distribution points so that the check succeeds.",{"_3640":2213,"_31229":2178,"_21648":57939,"_5":14899,"_28426":57863,"_3090":57940},[],"The KMS keeps the reference to the key and delegates the operation to the configured engine. With an HSM or a cloud KMS, the private key can remain non-exportable. That protects custody, but it does not by itself prevent misuse: you still must restrict who can request a signature and audit those operations.",{"_3640":2214,"_31229":2178,"_21648":57942,"_5":14899,"_28426":57867,"_3090":57943},[],"Keep the root out of daily operations, or with very restricted access.",{"_3640":2215,"_31229":2178,"_21648":57945,"_5":14899,"_28426":57867,"_3090":57946},[],"Issue from intermediate CAs separated by environment or risk domain.",{"_3640":2216,"_31229":2178,"_21648":57948,"_5":14899,"_28426":57867,"_3090":57949},[],"Assign explicit profiles to every use case.",{"_3640":2217,"_31229":2178,"_21648":57951,"_5":14899,"_28426":57867,"_3090":57952},[],"Distribute the new trust before starting a rotation.",{"_3640":2218,"_31229":2178,"_21648":57954,"_5":14899,"_28426":57867,"_3090":57955},[],"Keep enough overlap to renew a disconnected fleet.",{"_3640":2219,"_31229":2178,"_21648":57957,"_5":14899,"_28426":57867,"_3090":57958},[],"Validate from the consuming system, not only from the Lamassu console.",{"_3640":2220,"_31229":2178,"_21648":57960,"_5":14899,"_28426":57867,"_3090":57961},[],"Continue with CA hierarchy and rotation to turn this model into an operating procedure.",{"_3640":2221,"_31229":2221,"_5":15259,"_3090":57963,"_31567":57964,"_21648":57965,"_28426":2221},"Revocation lists (CRL)",[51054,52582,56762,57435],[],{"_3640":2222,"_31229":2221,"_21648":57967,"_5":14899,"_28426":2221,"_3090":57968},[],"Generate and distribute signed lists to validate certificates offline.",{"_3640":2223,"_31229":2221,"_5":31564,"_21648":57970,"_28426":57971,"_3090":57972},[],"/docs/platform/pki/crl#crl-settings","CRL settings",{"_3640":2224,"_31229":2221,"_5":31564,"_21648":57974,"_28426":57975,"_3090":57976},[],"/docs/platform/pki/crl#cas-that-share-a-key","CAs that share a key",{"_3640":2225,"_31229":2221,"_5":31564,"_21648":57978,"_28426":57979,"_3090":57980},[],"/docs/platform/pki/crl#periodic-and-automatic-regeneration","Periodic and automatic regeneration",{"_3640":2226,"_31229":2221,"_5":31564,"_21648":57982,"_28426":57983,"_3090":57984},[],"/docs/platform/pki/crl#crl-contents","CRL contents",{"_3640":2227,"_31229":2221,"_5":31564,"_21648":57986,"_28426":57987,"_3090":57988},[],"/docs/platform/pki/crl#public-download-endpoint","Public download endpoint",{"_3640":2228,"_31229":2221,"_5":31564,"_21648":57990,"_28426":57991,"_3090":57992},[],"/docs/platform/pki/crl#crl-settings-api","CRL settings API",{"_3640":2229,"_31229":2221,"_5":31564,"_21648":57994,"_28426":57995,"_3090":57996},[],"/docs/platform/pki/crl#common-crl-settings-errors","Common CRL settings errors",{"_3640":2230,"_31229":2221,"_5":31564,"_21648":57998,"_28426":57999,"_3090":58000},[],"/docs/platform/pki/crl#references","References",{"_3640":2231,"_31229":2221,"_21648":58002,"_5":14899,"_28426":2221,"_3090":58003},[],"A CRL is an issuer-signed list of revoked certificates. This guide is for an operator publishing lists and an integrator using them locally. You need the issuing CA certificate, its CA ID and access to the published endpoint. The client must maintain a current copy: offline operation still requires refreshing evidence.",{"_3640":2232,"_31229":2221,"_21648":58005,"_5":14899,"_28426":57971,"_3090":58006},[],"The CRL settings of a CA store the configuration and metadata of its latest published list. Each CA has its own settings, keyed by its CA ID — even when two CAs share a key: they share the SKI, not the CRL. The VA creates them when a CA is created; when a CA is imported whose key is in the KMS — either imported with the private key or already held by the KMS — and whose certificate carries `cRLSign`: such a CA publishes its first CRL immediately, like a created one; and when a CA without settings is reissued with a certificate that can sign CRLs. An imported CA whose key is not in the KMS, or whose certificate lacks `cRLSign`, receives no settings: the import succeeds without error, and the CA's CRL endpoints report the settings as missing. Settings are never created retroactively: a CA that has none keeps none until it is reissued. Generation requires a usable issuer key; do not assume an imported CA without a key has an available CRL.",{"_3640":2233,"_31229":2221,"_21648":58008,"_5":14899,"_28426":57971,"_3090":58009},[],"Field",{"_3640":2234,"_31229":2221,"_21648":58011,"_5":14899,"_28426":57971,"_3090":51444},[],{"_3640":2235,"_31229":2221,"_21648":58013,"_5":14899,"_28426":57971,"_3090":52702},[],{"_3640":2236,"_31229":2221,"_21648":58015,"_5":14899,"_28426":57971,"_3090":58016},[],"ID of the CA the settings belong to.",{"_3640":2237,"_31229":2221,"_21648":58018,"_5":14899,"_28426":57971,"_3090":58019},[],"`status`",{"_3640":2238,"_31229":2221,"_21648":58021,"_5":14899,"_28426":57971,"_3090":58022},[],"Lifecycle of the settings. `ACTIVE` ones generate CRLs. `FINAL` ones belong to a CA revoked permanently or expired: the first publishes one final CRL, valid until the CA's current certificate expires, and the second is turned `FINAL` without one. `ARCHIVED` ones belong to a deleted CA: their last CRL is still served, but never regenerated.",{"_3640":2239,"_31229":2221,"_21648":58024,"_5":14899,"_28426":57971,"_3090":58025},[],"`legacy_ski`",{"_3640":2240,"_31229":2221,"_21648":58027,"_5":14899,"_28426":57971,"_3090":58028},[],"Read-only. SKI the settings were keyed by before the 4.0.0 migration; only migrated settings have it, and `/crl/<ski>` keeps resolving to them.",{"_3640":2241,"_31229":2221,"_21648":58030,"_5":14899,"_28426":57971,"_3090":58031},[],"`latest_crl`",{"_3640":2242,"_31229":2221,"_21648":58033,"_5":14899,"_28426":57971,"_3090":58034},[],"Version, validity start and end of the last published list. Read-only.",{"_3640":2243,"_31229":2221,"_21648":58036,"_5":14899,"_28426":57971,"_3090":58037},[],"`crl_options` field",{"_3640":2244,"_31229":2221,"_21648":58039,"_5":14899,"_28426":57971,"_3090":51444},[],{"_3640":2245,"_31229":2221,"_21648":58041,"_5":14899,"_28426":57971,"_3090":58042},[],"Initial value",{"_3640":2246,"_31229":2221,"_21648":58044,"_5":14899,"_28426":57971,"_3090":58045},[],"`validity`",{"_3640":2247,"_31229":2221,"_21648":58047,"_5":14899,"_28426":57971,"_3090":58048},[],"Time from `thisUpdate` to `nextUpdate`.",{"_3640":2248,"_31229":2221,"_21648":58050,"_5":14899,"_28426":57971,"_3090":58051},[],"7 days.",{"_3640":2249,"_31229":2221,"_21648":58053,"_5":14899,"_28426":57971,"_3090":58054},[],"`refresh_interval`",{"_3640":2250,"_31229":2221,"_21648":58056,"_5":14899,"_28426":57971,"_3090":58057},[],"Time since the issuance of the latest published CRL that triggers scheduled renewal; `0` disables only this trigger. The effective granularity is bounded by the job frequency (see Periodic and automatic regeneration).",{"_3640":2251,"_31229":2221,"_21648":58059,"_5":14899,"_28426":57971,"_3090":58060},[],"6 days and 23 hours.",{"_3640":2252,"_31229":2221,"_21648":58062,"_5":14899,"_28426":57971,"_3090":58063},[],"`regenerate_on_revoke`",{"_3640":2253,"_31229":2221,"_21648":58065,"_5":14899,"_28426":57971,"_3090":58066},[],"Request regeneration on revocation or reactivation from `CertificateHold` events.",{"_3640":2254,"_31229":2221,"_21648":58068,"_5":14899,"_28426":57971,"_3090":58069},[],"`true`.",{"_3640":2255,"_31229":2221,"_21648":58071,"_5":14899,"_28426":57971,"_3090":58072},[],"`signer_serial_number`",{"_3640":2256,"_31229":2221,"_21648":58074,"_5":14899,"_28426":57971,"_3090":58075},[],"Serial number of the existing certificate that signs the CRL.",{"_3640":2257,"_31229":2221,"_21648":58077,"_5":14899,"_28426":57971,"_3090":58078},[],"Serial number of the CA’s current certificate.",{"_3640":2258,"_31229":2221,"_21648":58080,"_5":14899,"_28426":57971,"_3090":58081},[],"The signer must be an existing certificate with the `cRLSign` key usage and the same subject and public key as the CA. Certificates from before a reissue qualify. A delegated signer is not supported: a certificate with the CA’s subject but a different key is rejected.",{"_3640":2259,"_31229":2221,"_21648":58083,"_5":14899,"_28426":57971,"_3090":58084},[],"When a CA is reissued and the signer is the superseded CA certificate, the VA moves the signer to the new certificate — provided it carries `cRLSign` — and republishes the CRL. If the new certificate lacks `cRLSign`, the VA keeps the previous signer and logs a warning. If the signer is any other certificate with the CA’s subject and key, it is deliberately left unchanged; the previous certificate then cannot be deleted while the settings use it (the API returns `409` `certificate is in use`), and to retire it you update the signer with `PUT`.",{"_3640":2260,"_31229":2221,"_21648":58086,"_5":14899,"_28426":57971,"_3090":58087},[],"The CRL lifecycle decisions — when publication stops and when the final CRL expires — use only the CA's current certificate. If a reissued certificate expires earlier than an older certificate that is still valid, CRL publication can stop, or the final CRL can expire, while the older certificate is still valid. This is an accepted limitation of the current behavior.",{"_3640":2261,"_31229":2221,"_21648":58089,"_5":14899,"_28426":57971,"_3090":58090},[],"A CA whose signer lacks `cRLSign` cannot generate its CRL, and an update that selects a signer without `cRLSign` is rejected (400 error). Since 4.0 the VA requires this usage. Check before importing with `openssl x509 -noout -ext keyUsage` and, if it is missing, obtain a certificate for the same CA and key that includes it and update the settings to use it as the signer. A CA that has no settings at all — for example, one imported without `cRLSign` — has nothing to update: the only way to obtain them is to reissue the CA with a certificate that carries `cRLSign`. After reissuing a CA, also check the key usage of the new certificate: it may not keep the original’s usages, and without `cRLSign` the settings keep their previous signer.",{"_3640":2262,"_31229":2221,"_21648":58092,"_5":14899,"_28426":57971,"_3090":58093},[],"Deleting a CA keeps its CRL settings; they remain until you delete the archived ones through the API or from the console's Verification Authorities page (see CRL settings API). What happens to them depends on how the CA ended:",{"_3640":2263,"_31229":2221,"_21648":58095,"_5":14899,"_28426":57971,"_3090":58096},[],"The 4.0.0 upgrade migration archives the settings of the CAs that had been deleted before the upgrade. Their `status` is `ARCHIVED` and their `ca_id` is `legacy-<ski>`: the last CRL keeps being served, but it is never regenerated, any `PUT` returns 409, and there is no API way back to `ACTIVE`.",{"_3640":2264,"_31229":2221,"_21648":58098,"_5":14899,"_28426":57971,"_3090":58099},[],"Revoking a CA permanently or letting it expire finalizes its settings: their `status` becomes `FINAL`, any `PUT` returns 409, and no new CRL is generated. A permanently revoked CA publishes one final CRL, valid until the CA's current certificate expires; an expired CA gets none. Deleting the CA afterwards archives its settings, which then behave like the archived ones of the migration.",{"_3640":2265,"_31229":2221,"_21648":58101,"_5":14899,"_28426":57971,"_3090":58102},[],"The settings can no longer be edited while their `status` is not `ACTIVE`. Adjust validity and signer before revoking or deleting a CA.",{"_3640":2266,"_31229":2221,"_21648":58104,"_5":14899,"_28426":57971,"_3090":58105},[],"`PUT` validates the signer only when the request changes it. If the stored signer is no longer valid, the other options can still be edited, but the CRL cannot be regenerated until a valid signer is set.",{"_3640":2267,"_31229":2221,"_21648":58107,"_5":14899,"_28426":57971,"_3090":58108},[],"Sharing a key between CAs is a migration blocker: the 4.0.0 upgrade aborts while an SKI belongs to more than one CA. See CAs that share a key.",{"_3640":2268,"_31229":2221,"_21648":58110,"_5":14899,"_28426":57971,"_3090":58111},[],"CRL versions are kept as PEM in object storage at `pki/va/crl/<ca-id>/<version>.crl`; the public endpoint returns DER. CRLs published before the 4.0.0 upgrade remain at `pki/va/crl/<ski>/<version>.crl` and keep being served.",{"_3640":2269,"_31229":2221,"_21648":58113,"_5":14899,"_28426":57975,"_3090":58114},[],"Since 4.0.0, each CA publishes its own CRL even when its key is shared: two CAs with the same key have the same SKI, but each has its own CRL settings and its own list, signed by a certificate with that CA’s identity.",{"_3640":2270,"_31229":2221,"_21648":58116,"_5":14899,"_28426":57975,"_3090":58117},[],"Certificates issued from now on carry `/crl/<ca-id>` distribution points, so each CA’s certificates resolve to its own list. Certificates issued before the upgrade keep their `/crl/<ski>` distribution points: that URL keeps resolving to the settings the upgrade migrated, and always serves the list of the CA that owned that SKI when the upgrade ran. It is never rebound to a CA created later with the same key. After regeneration, the migrated list includes both URLs in its *Issuing Distribution Point* (OID `2.5.29.28`), so a verifier that compares the IDP with the CDP of the certificate accepts either form. Until the VA scheduled CRL job successfully regenerates it, the pre-upgrade list contains only the legacy `/crl/<ski>` IDP; IDP-checking verifiers cannot validate newly issued certificates with `/crl/<ca-id>` CDPs. The first run can take up to about an hour with the default schedule, and failures can extend the window.",{"_3640":2271,"_31229":2221,"_21648":58119,"_5":14899,"_28426":57975,"_3090":58120},[],"Sharing an SKI between CAs blocks the upgrade: the migration aborts and names the SKIs. To detect the problem before upgrading, compare the SKI of the CAs in the inventory: two with the same SKI are affected. To fix it, create a CA with its own key and reissue its certificates; those already issued keep the old URL and are not corrected until reissued.",{"_3640":2272,"_31229":2221,"_21648":58122,"_5":14899,"_28426":57975,"_3090":58123},[],"Lamassu takes the SKI of an imported certificate as-is and does not check that it corresponds to its public key. Until Lamassu rejects imports whose SKI collides with an existing CA — proposed in lamassuiot#834, together with the per-CA CRL that 4.0.0 implements — restrict the permission to import CAs as an interim control; it covers only the import path. Creating a CA with &#x2A;*Create New CA (Existing Key)** on a KMS key another CA already uses produces the same SKI collision, so avoid reusing keys across CAs.",{"_3640":2273,"_31229":2221,"_21648":58125,"_5":14899,"_28426":57979,"_3090":58126},[],"The VA scheduled job checks the CRL settings of every CA on each run and requests a new list when either of these conditions is met:",{"_3640":2274,"_31229":2221,"_21648":58128,"_5":14899,"_28426":57979,"_3090":58129},[],"**The list is about to expire:** the remaining validity of `latest_crl` is less than the interval between job runs. This condition always applies and cannot be disabled.",{"_3640":2275,"_31229":2221,"_21648":58131,"_5":14899,"_28426":57979,"_3090":58132},[],"**The refresh interval has elapsed:** the time since the issuance of the latest published CRL reaches `refresh_interval`. Setting `refresh_interval` to `0` disables only this condition; the list is still regenerated when it is about to expire.",{"_3640":2276,"_31229":2221,"_21648":58134,"_5":14899,"_28426":57979,"_3090":58135},[],"Setting `refresh_interval` to `0` therefore does not freeze regeneration. With the default 7-day validity and an hourly job, a CRL is renewed up to an hour before it expires even if `refresh_interval` is `0`. Because the job runs on its own schedule, `refresh_interval` is honored only as precisely as the job frequency allows.",{"_3640":2277,"_31229":2221,"_21648":58137,"_5":14899,"_28426":57979,"_3090":58138},[],"The job frequency is set in Helm with `services.va.job.crl.frequency` (default `0 * * * *`) and accepts a duration (`1h`) or a cron expression. A cron expression is converted into a constant interval equal to the time left until its next firing when the service starts, so it is not aligned with the clock. Keep `validity` well above that interval: with a shorter validity, the list is regenerated on every cycle.",{"_3640":2278,"_31229":2221,"_21648":58140,"_5":14899,"_28426":57979,"_3090":58141},[],"If generation fails (for example, because the CA cannot be resolved or the signer is invalid), the job logs the warning `something went wrong while calculating CRL for CA <ca-id>` and retries on the next cycle. There is no other renewal path until the cause is fixed, and the last published list keeps being served until it expires. All of this depends on working jobs, storage and signing.",{"_3640":2279,"_31229":2221,"_21648":58143,"_5":14899,"_28426":57979,"_3090":58144},[],"Settings whose `status` is not `ACTIVE` — `FINAL` or `ARCHIVED` — are skipped: nothing regenerates their CRL.",{"_3640":2280,"_31229":2221,"_21648":58146,"_5":14899,"_28426":57979,"_3090":58147},[],"With `regenerate_on_revoke`, the event handler requests a new CRL upon revocation or reactivation from `CertificateHold` to `ACTIVE`. This happens after the status change and has its own failure paths: if generation fails (for example, because of an invalid signer), the event is retried and, once retries are exhausted, moves to the failed-events queue. If the issuing CA has no CRL settings, there is no CRL to regenerate: the event is acknowledged without retry, the VA logs a warning, and nothing appears in the failed-events queue. Confirming revocation does not establish that the new CRL is already published or that all clients have downloaded it.",{"_3640":2281,"_31229":2221,"_21648":58149,"_5":14899,"_28426":57979,"_3090":58150},[],"Compare CRL numbers and timestamps before and after a change. Monitor expired lists and generation failures; clients must apply policy when current evidence is unavailable.",{"_3640":2282,"_31229":2221,"_21648":58152,"_5":14899,"_28426":57983,"_3090":58153},[],"Each entry contains serial number, revocation time and reason. The generator queries certificates in `REVOKED` state for the selected CA. A reactivated certificate disappears when the list is recalculated; an earlier downloaded copy retains its contents.",{"_3640":2283,"_31229":2221,"_21648":58155,"_5":14899,"_28426":57983,"_3090":58156},[],"When the VA has configured domains, the list contains a critical *Issuing Distribution Point* (OID `2.5.29.28`) with those distribution URLs; a VA with no configured domains publishes the list without an IDP, and a CRL without an IDP covers every certificate of its CA. When the extension is present, check that your client interprets it and that it matches the list’s scope. If rejected, investigate format and scope; ignoring a critical extension is not successful validation.",{"_3640":2284,"_31229":2221,"_21648":58158,"_5":14899,"_28426":57987,"_3090":58159},[],"The VA service exposes `GET /crl/{id}` without management authorization. Use the **issuing CA’s** ID, not the end-entity certificate’s ID or serial. Certificates issued before the 4.0.0 upgrade carry `/crl/<ski>` URLs with the SKI of the CA key; that form keeps resolving. First inspect the certificate’s CDP:",{"_3640":2285,"_31229":2221,"_21648":58161,"_5":14899,"_28426":57987,"_3090":58162},[],"Replace the following URL with the CDP URL and review exposure in Deployment:",{"_3640":2286,"_31229":2221,"_21648":58164,"_5":14899,"_28426":57987,"_3090":58165},[],"You need OpenSSL 3.x and `issuer.pem` containing the direct issuer’s certificate. An accepted signer certificate has the same subject and public key as the CA, so this signature check also works when the settings point to an earlier certificate for that CA and key. Require a valid signature, current timestamps and the expected issuer. For a root that issues directly:",{"_3640":2287,"_31229":2221,"_21648":58167,"_5":14899,"_28426":57987,"_3090":58168},[],"`roots.pem` contains deliberately trusted roots. For intermediates, add `-untrusted intermediates.pem` before the `device.crt` argument. `-crl_check` checks the end-entity certificate’s revocation against the local list; it does not download other lists or establish the status of the whole chain. A complete chain check needs the corresponding CRLs and a policy requiring them.",{"_3640":2288,"_31229":2221,"_21648":58170,"_5":14899,"_28426":57987,"_3090":58171},[],"The test should accept an allowed certificate absent from the list and reject it with `certificate revoked` after publishing and using the list containing its serial.",{"_3640":2289,"_31229":2221,"_21648":58173,"_5":14899,"_28426":57991,"_3090":58174},[],"The following paths are relative to the VA service; confirm the public prefix in the Gateway. They are not the URLs of the public OCSP and CRL endpoints.",{"_3640":2290,"_31229":2221,"_21648":58176,"_5":14899,"_28426":57991,"_3090":54528},[],{"_3640":2291,"_31229":2221,"_21648":58178,"_5":14899,"_28426":57991,"_3090":58179},[],"Relative path",{"_3640":2292,"_31229":2221,"_21648":58181,"_5":14899,"_28426":57991,"_3090":54525},[],{"_3640":2293,"_31229":2221,"_21648":58183,"_5":14899,"_28426":57991,"_3090":58184},[],"`GET`",{"_3640":2294,"_31229":2221,"_21648":58186,"_5":14899,"_28426":57991,"_3090":58187},[],"`/v1/crl-settings`",{"_3640":2295,"_31229":2221,"_21648":58189,"_5":14899,"_28426":57991,"_3090":58190},[],"List the CRL settings; filterable at least by `ca_id`, `status` and `legacy_ski`.",{"_3640":2296,"_31229":2221,"_21648":58192,"_5":14899,"_28426":57991,"_3090":58184},[],{"_3640":2297,"_31229":2221,"_21648":58194,"_5":14899,"_28426":57991,"_3090":58195},[],"`/v1/crl-settings/{ca-id}`",{"_3640":2298,"_31229":2221,"_21648":58197,"_5":14899,"_28426":57991,"_3090":58198},[],"Read the `crl_options` and `latest_crl` of a CA.",{"_3640":2299,"_31229":2221,"_21648":58200,"_5":14899,"_28426":57991,"_3090":58201},[],"`PUT`",{"_3640":2300,"_31229":2221,"_21648":58203,"_5":14899,"_28426":57991,"_3090":58195},[],{"_3640":2301,"_31229":2221,"_21648":58205,"_5":14899,"_28426":57991,"_3090":58206},[],"Replace the CRL configuration of a CA.",{"_3640":2302,"_31229":2221,"_21648":58208,"_5":14899,"_28426":57991,"_3090":58209},[],"`DELETE`",{"_3640":2303,"_31229":2221,"_21648":58211,"_5":14899,"_28426":57991,"_3090":58195},[],{"_3640":2304,"_31229":2221,"_21648":58213,"_5":14899,"_28426":57991,"_3090":58214},[],"Remove the archived CRL settings of a CA.",{"_3640":2305,"_31229":2221,"_21648":58216,"_5":14899,"_28426":57991,"_3090":58217},[],"You need authentication and CRL settings read, update or delete permissions. Consult your installation’s API reference and Access control. Read current configuration before updating and send the full object expected by the contract — `refresh_interval`, `validity`, `signer_serial_number` and `regenerate_on_revoke`: the backend replaces all four; it does not merge omitted fields. `status`, `legacy_ski` and `latest_crl` are read-only. A `PUT` returns 409 when the settings are not `ACTIVE`, validates the signer only when it changes, and does not regenerate the CRL.",{"_3640":2306,"_31229":2221,"_21648":58219,"_5":14899,"_28426":57991,"_3090":58220},[],"Archived settings, whose CA no longer exists, can be removed with `DELETE`: the call returns 204 on success, 404 when the CA has no settings and 409 while the settings are not yet archived. After the deletion, the public `/crl/{id}` endpoint and any legacy `/crl/<ski>` endpoint stop serving the CA’s list, although the published CRL files remain in the bucket. Keep the archived settings while any certificate issued by the CA may still need revocation evidence: `DELETE` stops serving the list immediately, regardless of `latest_crl` validity. The action cannot be undone.",{"_3640":2307,"_31229":2221,"_21648":58222,"_5":14899,"_28426":57991,"_3090":58223},[],"After a change, check saved configuration and the next list actually published. Updating the settings alone does not establish regeneration or client acceptance.",{"_3640":2308,"_31229":2221,"_21648":58225,"_5":14899,"_28426":57995,"_3090":58226},[],"Symptom",{"_3640":2309,"_31229":2221,"_21648":58228,"_5":14899,"_28426":57995,"_3090":58229},[],"Cause",{"_3640":2310,"_31229":2221,"_21648":58231,"_5":14899,"_28426":57995,"_3090":58232},[],"Action",{"_3640":2311,"_31229":2221,"_21648":58234,"_5":14899,"_28426":57995,"_3090":58235},[],"`PUT /v1/crl-settings/{ca-id}` returns 409.",{"_3640":2312,"_31229":2221,"_21648":58237,"_5":14899,"_28426":57995,"_3090":58238},[],"The settings are not `ACTIVE`: revoking the CA permanently or letting it expire finalized them, or the migration archived them because their CA was deleted before the upgrade.",{"_3640":2313,"_31229":2221,"_21648":58240,"_5":14899,"_28426":57995,"_3090":58241},[],"There is no API way back to `ACTIVE`. The last CRL keeps being served.",{"_3640":2314,"_31229":2221,"_21648":58243,"_5":14899,"_28426":57995,"_3090":58244},[],"`DELETE /v1/crl-settings/{ca-id}` returns 409.",{"_3640":2315,"_31229":2221,"_21648":58246,"_5":14899,"_28426":57995,"_3090":58247},[],"The settings are not yet `ARCHIVED`: the CA has not been deleted.",{"_3640":2316,"_31229":2221,"_21648":58249,"_5":14899,"_28426":57995,"_3090":58250},[],"Delete the CA first; deleting it archives its settings.",{"_3640":2317,"_31229":2221,"_21648":58252,"_5":14899,"_28426":57995,"_3090":58253},[],"`PUT` returns 400.",{"_3640":2318,"_31229":2221,"_21648":58255,"_5":14899,"_28426":57995,"_3090":58256},[],"The new signer lacks `cRLSign`, or its subject and public key do not match the CA.",{"_3640":2319,"_31229":2221,"_21648":58258,"_5":14899,"_28426":57995,"_3090":58259},[],"Set the serial number of a valid certificate of that CA.",{"_3640":2320,"_31229":2221,"_21648":58261,"_5":14899,"_28426":57995,"_3090":58262},[],"`PUT` returns 404.",{"_3640":2321,"_31229":2221,"_21648":58264,"_5":14899,"_28426":57995,"_3090":58265},[],"The CA or the new signer certificate does not exist, or the CA has no CRL settings, for example because it was imported without its key or its certificate lacks `cRLSign`.",{"_3640":2322,"_31229":2221,"_21648":58267,"_5":14899,"_28426":57995,"_3090":58268},[],"Check the CA ID and the signer serial number.",{"_3640":2323,"_31229":2221,"_21648":58270,"_5":14899,"_28426":57995,"_3090":58271},[],"`PUT` returns 400 from a 3.x client.",{"_3640":2324,"_31229":2221,"_21648":58273,"_5":14899,"_28426":57995,"_3090":58274},[],"`crl_options.subject_key_id_signer` was replaced by `crl_options.signer_serial_number`, which is required.",{"_3640":2325,"_31229":2221,"_21648":58276,"_5":14899,"_28426":57995,"_3090":58277},[],"Update the client to send the new field.",{"_3640":2326,"_31229":2221,"_21648":58279,"_5":14899,"_28426":57995,"_3090":58280},[],"The CRL does not change after revoking a certificate.",{"_3640":2327,"_31229":2221,"_21648":58282,"_5":14899,"_28426":57995,"_3090":58283},[],"`regenerate_on_revoke` is `false`, the issuing CA has no CRL settings, or generation failed because of an invalid signer.",{"_3640":2328,"_31229":2221,"_21648":58285,"_5":14899,"_28426":57995,"_3090":58286},[],"Check the VA logs. Missing settings only produce a warning (no retry, no failed-events entry); an invalid signer also leaves the event in the failed-events queue, so fix the signer.",{"_3640":2329,"_31229":2221,"_21648":58288,"_5":14899,"_28426":57995,"_3090":58289},[],"A verifier rejects the CRL because of the issuer.",{"_3640":2330,"_31229":2221,"_21648":58291,"_5":14899,"_28426":57995,"_3090":58292},[],"The list was fetched through a legacy `/crl/<ski>` URL and belongs to the CA that owned that SKI when the upgrade ran.",{"_3640":2331,"_31229":2221,"_21648":58294,"_5":14899,"_28426":57995,"_3090":58295},[],"Use the CDP of the certificate being validated: certificates issued in 4.0.0 carry `/crl/<ca-id>` URLs.",{"_3640":2332,"_31229":2221,"_21648":58297,"_5":14899,"_28426":57999,"_3090":58298},[],"RFC 5280: X.509 and CRL profile.",{"_3640":2333,"_31229":2221,"_21648":58300,"_5":14899,"_28426":57999,"_3090":58301},[],"OpenSSL: openssl-crl.",{"_3640":2334,"_31229":2221,"_21648":58303,"_5":14899,"_28426":57999,"_3090":58304},[],"OpenSSL: openssl-verify.",{"_3640":2335,"_31229":2221,"_21648":58306,"_5":14899,"_28426":57999,"_3090":58307},[],"<Card title=\"OCSP service\" href=\"/docs/platform/pki/ocsp\" />",{"_3640":2336,"_31229":2221,"_21648":58309,"_5":14899,"_28426":57999,"_3090":58310},[],"<Card title=\"Certificate validation\" href=\"/docs/platform/pki/certificate-validation\" />",{"_3640":2337,"_31229":2337,"_5":15259,"_3090":58312,"_31567":58313,"_21648":58314,"_28426":2337},"Keys and cryptographic engines",[51054,52582,56762,56763],[],{"_3640":2338,"_31229":2337,"_21648":58316,"_5":14899,"_28426":2337,"_3090":58317},[],"Generate, import and operate keys without coupling the PKI to a specific provider.",{"_3640":2339,"_31229":2337,"_5":31564,"_21648":58319,"_28426":58320,"_3090":58321},[],"/docs/platform/pki/key-management#what-the-kms-solves","What the KMS solves",{"_3640":2340,"_31229":2337,"_5":31564,"_21648":58323,"_28426":58324,"_3090":58325},[],"/docs/platform/pki/key-management#cryptographic-engines","Cryptographic engines",{"_3640":2341,"_31229":2337,"_5":31564,"_21648":58327,"_28426":58328,"_3090":58329},[],"/docs/platform/pki/key-management#file-system","File System",{"_3640":2342,"_31229":2337,"_5":31564,"_21648":58331,"_28426":58332,"_3090":58333},[],"/docs/platform/pki/key-management#hashicorp-vault","HashiCorp Vault",{"_3640":2343,"_31229":2337,"_5":31564,"_21648":58335,"_28426":58336,"_3090":58337},[],"/docs/platform/pki/key-management#aws-secrets-manager","AWS Secrets Manager",{"_3640":2344,"_31229":2337,"_5":31564,"_21648":58339,"_28426":58340,"_3090":58341},[],"/docs/platform/pki/key-management#aws-kms","AWS KMS",{"_3640":2345,"_31229":2337,"_5":31564,"_21648":58343,"_28426":58344,"_3090":58345},[],"/docs/platform/pki/key-management#pkcs11","PKCS#11",{"_3640":2346,"_31229":2337,"_5":31564,"_21648":58347,"_28426":58348,"_3090":58349},[],"/docs/platform/pki/key-management#azure-key-vault","Azure Key Vault",{"_3640":2347,"_31229":2337,"_5":31564,"_21648":58351,"_28426":58352,"_3090":58353},[],"/docs/platform/pki/key-management#key-inventory","Key inventory",{"_3640":2348,"_31229":2337,"_5":31564,"_21648":58355,"_28426":58356,"_3090":58357},[],"/docs/platform/pki/key-management#create-or-import-keys","Create or import keys",{"_3640":2349,"_31229":2337,"_5":31564,"_21648":58359,"_28426":58360,"_3090":58361},[],"/docs/platform/pki/key-management#generate-a-new-key-pair","Generate a new key pair",{"_3640":2350,"_31229":2337,"_5":31564,"_21648":58363,"_28426":58364,"_3090":58365},[],"/docs/platform/pki/key-management#import-an-existing-pair","Import an existing pair",{"_3640":2351,"_31229":2337,"_5":31564,"_21648":58367,"_28426":58368,"_3090":58369},[],"/docs/platform/pki/key-management#operations-on-a-key","Operations on a key",{"_3640":2352,"_31229":2337,"_5":31564,"_21648":58371,"_28426":58372,"_3090":58373},[],"/docs/platform/pki/key-management#view-details","View details",{"_3640":2353,"_31229":2337,"_5":31564,"_21648":58375,"_28426":58376,"_3090":58377},[],"/docs/platform/pki/key-management#sign-and-verify","Sign and verify",{"_3640":2354,"_31229":2337,"_5":31564,"_21648":58379,"_28426":58380,"_3090":58381},[],"/docs/platform/pki/key-management#sign","Sign",{"_3640":2355,"_31229":2337,"_5":31564,"_21648":58383,"_28426":58384,"_3090":58385},[],"/docs/platform/pki/key-management#verify","Verify",{"_3640":2356,"_31229":2337,"_5":31564,"_21648":58387,"_28426":58388,"_3090":58389},[],"/docs/platform/pki/key-management#generate-a-csr","Generate a CSR",{"_3640":2357,"_31229":2337,"_5":31564,"_21648":58391,"_28426":58392,"_3090":58393},[],"/docs/platform/pki/key-management#sign-locally-with-pkcs11","Sign locally with PKCS#11",{"_3640":2358,"_31229":2337,"_5":31564,"_21648":58395,"_28426":58396,"_3090":58397},[],"/docs/platform/pki/key-management#before-deleting-a-key","Before deleting a key",{"_3640":2359,"_31229":2337,"_21648":58399,"_5":14899,"_28426":2337,"_3090":58400},[],"The Cryptographic Key Management Service (KMS) of Lamassu IoT centralizes the generation, import, custody and use of the platform's keys. This is where you manage the keys that support the CAs and the rest of the signing operations that depend on the PKI.",{"_3640":2360,"_31229":2337,"_21648":58402,"_5":14899,"_28426":2337,"_3090":58403},[],"In the current configuration, Lamassu IoT works exclusively with asymmetric keys, such as RSA and elliptic curves. These keys are used to issue X.509 certificates, sign requests and perform authentication and validation operations within the system.",{"_3640":2361,"_31229":2337,"_21648":58405,"_5":14899,"_28426":58320,"_3090":58406},[],"The KMS unifies key lifecycle management and prevents every service from having to integrate directly with a specific cryptographic provider.",{"_3640":2362,"_31229":2337,"_21648":58408,"_5":14899,"_28426":58320,"_3090":58409},[],"In practice, it lets you:",{"_3640":2363,"_31229":2337,"_21648":58411,"_5":14899,"_28426":58320,"_3090":58412},[],"Generate new key pairs from Lamassu IoT.",{"_3640":2364,"_31229":2337,"_21648":58414,"_5":14899,"_28426":58320,"_3090":58415},[],"Import keys created externally.",{"_3640":2365,"_31229":2337,"_21648":58417,"_5":14899,"_28426":58320,"_3090":58418},[],"Delegate custody and cryptographic operations to external engines.",{"_3640":2366,"_31229":2337,"_21648":58420,"_5":14899,"_28426":58320,"_3090":58421},[],"Reuse existing keys for CAs, CSRs and signing or verification tasks.",{"_3640":2367,"_31229":2337,"_21648":58423,"_5":14899,"_28426":58324,"_3090":58424},[],"Lamassu can work with different cryptographic engines depending on deployment requirements. In some environments a software engine is enough; in others custody must be delegated to an HSM, a cloud service or a specialized platform.",{"_3640":2368,"_31229":2337,"_21648":58426,"_5":14899,"_28426":58324,"_3090":58427},[],"A single instance can have several engines configured at the same time, including multiple instances of the same type. This lets you adapt operations to different security, cost and regulatory requirements.",{"_3640":2369,"_31229":2337,"_21648":58429,"_5":14899,"_28426":58324,"_3090":58430},[],"This guide is for the PKI operator: select and use an already enabled engine. Installation, credentials, persistent storage and connectivity belong to Deployment. Before generating a CA, check the default engine, advertised algorithms and a test signature. Availability in your installation depends on its version and configuration.",{"_3640":2370,"_31229":2337,"_21648":58432,"_5":14899,"_28426":58328,"_3090":58433},[],"Generates software keys and stores private material in files. Custody depends on installation permissions, storage and backups. Before using it for an operational CA, agree how the key will be recovered and how replicas will access it; the KMS record does not replace those files.",{"_3640":2371,"_31229":2337,"_21648":58435,"_5":14899,"_28426":58332,"_3090":58436},[],"The adapter uses KV storage for private material. This is not signing within Vault Transit: someone able to read the secret can recover the key. Review read permissions, availability and recovery with the deployment owner.",{"_3640":2372,"_31229":2337,"_21648":58438,"_5":14899,"_28426":58332,"_3090":58439},[],"The adapter reaches Vault over its configured HTTP(S) endpoint. The Vault server certificate is verified against the system trust store; a Vault signed by a private CA is trusted by adding its CA certificate to the engine's `ca_cert_file` (PEM-encoded). `insecure_skip_verify=true` disables verification and is a last resort; agree the transport settings with the deployment owner.",{"_3640":2373,"_31229":2337,"_21648":58441,"_5":14899,"_28426":58336,"_3090":58442},[],"Offers encrypted persistence in AWS at a cost. It protects the key at rest, but an authorized administrator can recover it; it does not provide the same extraction resistance as a KMS or HSM.",{"_3640":2374,"_31229":2337,"_21648":58444,"_5":14899,"_28426":58340,"_3090":58445},[],"Delegates signing to AWS KMS. The adapter also implements external material import, subject to provider capabilities and permissions. A key generated outside the service has already existed outside its custody; importing it does not remove those copies. Check generation, import and signing as separate operations.",{"_3640":2375,"_31229":2337,"_21648":58447,"_5":14899,"_28426":58344,"_3090":58448},[],"Allows integrating local HSMs, isolated environments and *Key as a Service* offerings. Generation, persistence and extraction resistance depend on the specific device or provider. It is the most flexible option when policy requires hardware custody.",{"_3640":2376,"_31229":2337,"_21648":58450,"_5":14899,"_28426":58348,"_3090":58451},[],"The backend also provides adapters for **Key Vault Keys** and **Key Vault Secrets**. The former delegates signing to the key service; the latter stores private material as secrets and signs using that material. These are different custody models. Confirm which adapter is enabled in your installation and test the required operations.",{"_3640":2377,"_31229":2337,"_21648":58453,"_5":14899,"_28426":58348,"_3090":58454},[],"Lamassu shows the enabled engines in the console.",{"_3640":2378,"_31229":2337,"_21648":58456,"_5":14899,"_28426":58348,"_3090":58457},[],"Each engine defines which algorithms it supports, such as RSA or ECC/ECDSA, and which key sizes it can generate.",{"_3640":2379,"_31229":2337,"_21648":58459,"_5":14899,"_28426":58348,"_3090":58460},[],"Confirm with the deployment operator which engine is configured as the default. That engine will be used when a process needs to create or persist a key and the user has not selected a specific one, for example when creating or importing a CA.",{"_3640":2380,"_31229":2337,"_21648":58462,"_5":14899,"_28426":58352,"_3090":58463},[],"The main KMS screen shows the complete inventory of keys registered in the system. It is the reference view for reviewing which keys exist, where they are kept and which entities they relate to.",{"_3640":2381,"_31229":2337,"_21648":58465,"_5":14899,"_28426":58352,"_3090":58466},[],"The table includes the following fields:",{"_3640":2382,"_31229":2337,"_21648":58468,"_5":14899,"_28426":58352,"_3090":58469},[],"**Name**: descriptive name of the key.",{"_3640":2383,"_31229":2337,"_21648":58471,"_5":14899,"_28426":58352,"_3090":58472},[],"**Type**: algorithm and key size, for example RSA 2048 or EC P-256.",{"_3640":2384,"_31229":2337,"_21648":58474,"_5":14899,"_28426":58352,"_3090":58475},[],"**Strength**: visual indicator of cryptographic strength.",{"_3640":2385,"_31229":2337,"_21648":58477,"_5":14899,"_28426":58352,"_3090":58478},[],"**Public/Private**: whether Lamassu manages the full pair or only the public key.",{"_3640":2386,"_31229":2337,"_21648":58480,"_5":14899,"_28426":58352,"_3090":58481},[],"**Crypto Engine**: cryptographic engine keeping the key.",{"_3640":2387,"_31229":2337,"_21648":58483,"_5":14899,"_28426":58352,"_3090":58484},[],"**Aliases**: alternative names associated with the key.",{"_3640":2388,"_31229":2337,"_21648":58486,"_5":14899,"_28426":58352,"_3090":58487},[],"**Tags**: labels for classification and search.",{"_3640":2389,"_31229":2337,"_21648":58489,"_5":14899,"_28426":58352,"_3090":58490},[],"**Related Entities**: certificates or other entities linked to that key.",{"_3640":2390,"_31229":2337,"_21648":58492,"_5":14899,"_28426":58352,"_3090":58493},[],"From this view you also reach the most common actions:",{"_3640":2391,"_31229":2337,"_21648":58495,"_5":14899,"_28426":58352,"_3090":58496},[],"**View Details** to inspect metadata, identifiers and relationships.",{"_3640":2392,"_31229":2337,"_21648":58498,"_5":14899,"_28426":58352,"_3090":58499},[],"**Generate CSR** to create a PKCS#10 request with the selected key.",{"_3640":2393,"_31229":2337,"_21648":58501,"_5":14899,"_28426":58352,"_3090":58502},[],"**Sign / Verify** to test cryptographic operations on the key.",{"_3640":2394,"_31229":2337,"_21648":58504,"_5":14899,"_28426":58352,"_3090":58505},[],"**Delete Key** to remove the key from the system.",{"_3640":2395,"_31229":2337,"_21648":58507,"_5":14899,"_28426":58356,"_3090":58508},[],"You need key administration permissions and a reachable engine. The issuance profile must allow the chosen algorithm if the key will be used in a CA or CSR. Open **Create New Key** and choose generation or import.",{"_3640":2396,"_31229":2337,"_21648":58510,"_5":14899,"_28426":58360,"_3090":58511},[],"If the key will be born inside Lamassu, the recommended flow is to generate a new pair managed directly by one of the configured engines.",{"_3640":2397,"_31229":2337,"_21648":58513,"_5":14899,"_28426":58360,"_3090":58514},[],"On the wizard's first screen, choose **Generate New Key Pair** and then define the main parameters:",{"_3640":2398,"_31229":2337,"_21648":58516,"_5":14899,"_28426":58360,"_3090":58517},[],"**Key Name**: unique and descriptive name.",{"_3640":2399,"_31229":2337,"_21648":58519,"_5":14899,"_28426":58360,"_3090":58520},[],"**Crypto Engine**: engine that will keep the key.",{"_3640":2400,"_31229":2337,"_21648":58522,"_5":14899,"_28426":58360,"_3090":58523},[],"**Key Type** and **Key Size**: algorithm and size or curve.",{"_3640":2401,"_31229":2337,"_21648":58525,"_5":14899,"_28426":58360,"_3090":58526},[],"**Tags**: metadata to classify the key.",{"_3640":2402,"_31229":2337,"_21648":58528,"_5":14899,"_28426":58360,"_3090":58529},[],"**Metadata**: additional information for advanced uses.",{"_3640":2403,"_31229":2337,"_21648":58531,"_5":14899,"_28426":58364,"_3090":58532},[],"Importing lets you register in Lamassu a key generated outside the platform. It is the usual flow in BYOK scenarios, migrations or integration with cryptographic material already in production.",{"_3640":2404,"_31229":2337,"_21648":58534,"_5":14899,"_28426":58364,"_3090":58535},[],"When you have an exportable private key and the destination engine supports import.",{"_3640":2405,"_31229":2337,"_21648":58537,"_5":14899,"_28426":58364,"_3090":58538},[],"When an existing PKI needs to be migrated without reissuing certificates.",{"_3640":2406,"_31229":2337,"_21648":58540,"_5":14899,"_28426":58364,"_3090":58541},[],"When Lamassu must operate with a root of trust created by a third party.",{"_3640":2407,"_31229":2337,"_21648":58543,"_5":14899,"_28426":58364,"_3090":58544},[],"In the wizard, choose **Import Existing Key Pair** and complete the requested fields:",{"_3640":2408,"_31229":2337,"_21648":58546,"_5":14899,"_28426":58364,"_3090":58547},[],"**Key Name**: descriptive name within Lamassu IoT.",{"_3640":2409,"_31229":2337,"_21648":58549,"_5":14899,"_28426":58364,"_3090":58550},[],"**Crypto Engine**: engine that will keep the imported key.",{"_3640":2410,"_31229":2337,"_21648":58552,"_5":14899,"_28426":58364,"_3090":58553},[],"**Tags**: labels for organization and search.",{"_3640":2411,"_31229":2337,"_21648":58555,"_5":14899,"_28426":58364,"_3090":58556},[],"**Metadata**: additional optional information.",{"_3640":2412,"_31229":2337,"_21648":58558,"_5":14899,"_28426":58364,"_3090":58559},[],"**Private Key (PEM)**: private key in PEM format.",{"_3640":2413,"_31229":2337,"_21648":58561,"_5":14899,"_28426":58364,"_3090":58562},[],"After a successful import, open the record, check the engine and public key, and perform a test signature. A non-exportable HSM key cannot be uploaded through this PEM form: configure engine access and check how the existing key is registered. Review dependencies and any provider resources already created if an operation fails partway through.",{"_3640":2414,"_31229":2337,"_21648":58564,"_5":14899,"_28426":58368,"_3090":58565},[],"Each registered key has a detail view and several operational actions.",{"_3640":2415,"_31229":2337,"_21648":58567,"_5":14899,"_28426":58372,"_3090":58568},[],"The **View Details** screen concentrates the technical and administrative information of the key.",{"_3640":2416,"_31229":2337,"_21648":58570,"_5":14899,"_28426":58372,"_3090":58571},[],"The **Overview** tab shows, among others, these fields:",{"_3640":2417,"_31229":2337,"_21648":58573,"_5":14899,"_28426":58372,"_3090":58574},[],"**Key Name**: descriptive name.",{"_3640":2418,"_31229":2337,"_21648":58576,"_5":14899,"_28426":58372,"_3090":58577},[],"**Key Identifier**: unique system identifier. Lamassu uses PKCS11-based ID formats.",{"_3640":2419,"_31229":2337,"_21648":58579,"_5":14899,"_28426":58372,"_3090":58580},[],"**Tags**: associated labels.",{"_3640":2420,"_31229":2337,"_21648":58582,"_5":14899,"_28426":58372,"_3090":58583},[],"**Aliases**: alternative names.",{"_3640":2421,"_31229":2337,"_21648":58585,"_5":14899,"_28426":58372,"_3090":58586},[],"**Crypto Engine**: engine where the key resides.",{"_3640":2422,"_31229":2337,"_21648":58588,"_5":14899,"_28426":58372,"_3090":58589},[],"**Algorithm, Key Size & Strength**: algorithm, parameters and strength level.",{"_3640":2423,"_31229":2337,"_21648":58591,"_5":14899,"_28426":58372,"_3090":58592},[],"The **Related Entities** section shows which Lamassu objects depend on that key.",{"_3640":2424,"_31229":2337,"_21648":58594,"_5":14899,"_28426":58372,"_3090":58595},[],"The **Public Key** tab shows public material in PEM. The record’s identifier and URI locate the key; a PKCS#11-formatted URI does not establish that the engine is an HSM or that a local module can access it.",{"_3640":2425,"_31229":2337,"_21648":58597,"_5":14899,"_28426":58376,"_3090":58598},[],"The **Sign / Verify** action validates that the key and the cryptographic engine work correctly.",{"_3640":2426,"_31229":2337,"_21648":58600,"_5":14899,"_28426":58376,"_3090":58601},[],"Sign a test message, save the signature and verify it using the same public key, algorithm and encoding. Then change the message: verification should fail. This tests one operation; it does not establish every engine capability or a CA’s chain.",{"_3640":2427,"_31229":2337,"_21648":58603,"_5":14899,"_28426":58376,"_3090":58604},[],"When you open it, two areas appear: **Sign** and **Verify**.",{"_3640":2428,"_31229":2337,"_21648":58606,"_5":14899,"_28426":58380,"_3090":58607},[],"This tab uses the private key to generate a digital signature over a message or an already computed *digest*.",{"_3640":2429,"_31229":2337,"_21648":58609,"_5":14899,"_28426":58380,"_3090":58610},[],"Main fields:",{"_3640":2430,"_31229":2337,"_21648":58612,"_5":14899,"_28426":58380,"_3090":58613},[],"**Algorithm**: signing algorithm available for the key type.",{"_3640":2431,"_31229":2337,"_21648":58615,"_5":14899,"_28426":58380,"_3090":58616},[],"**Message Type**: `Raw` for clear data or `Digest` for a precomputed hash.",{"_3640":2432,"_31229":2337,"_21648":58618,"_5":14899,"_28426":58380,"_3090":58619},[],"**Payload Encoding**: input encoding, such as UTF-8, Hex or Base64.",{"_3640":2433,"_31229":2337,"_21648":58621,"_5":14899,"_28426":58380,"_3090":58622},[],"**Message**: content to sign.",{"_3640":2434,"_31229":2337,"_21648":58624,"_5":14899,"_28426":58380,"_3090":58625},[],"**Signature**: result of the operation, shown in hexadecimal.",{"_3640":2435,"_31229":2337,"_21648":58627,"_5":14899,"_28426":58384,"_3090":58628},[],"This tab checks whether a signature corresponds to the associated public key.",{"_3640":2436,"_31229":2337,"_21648":58630,"_5":14899,"_28426":58384,"_3090":58610},[],{"_3640":2437,"_31229":2337,"_21648":58632,"_5":14899,"_28426":58384,"_3090":58633},[],"**Algorithm**: must match the algorithm used for the signature.",{"_3640":2438,"_31229":2337,"_21648":58635,"_5":14899,"_28426":58384,"_3090":58636},[],"**Message Type**: `Raw` or `Digest`.",{"_3640":2439,"_31229":2337,"_21648":58638,"_5":14899,"_28426":58384,"_3090":58639},[],"**Payload Encoding**: encoding of the message.",{"_3640":2440,"_31229":2337,"_21648":58641,"_5":14899,"_28426":58384,"_3090":58642},[],"**Message**: original message or hash.",{"_3640":2441,"_31229":2337,"_21648":58644,"_5":14899,"_28426":58384,"_3090":58645},[],"**Signature**: signature to check.",{"_3640":2442,"_31229":2337,"_21648":58647,"_5":14899,"_28426":58384,"_3090":58648},[],"**Result**: indicator of the validation result.",{"_3640":2443,"_31229":2337,"_21648":58650,"_5":14899,"_28426":58388,"_3090":58651},[],"The **Generate CSR** action creates a PKCS#10 request signed with the private key kept in Lamassu, without exposing it outside the cryptographic engine.",{"_3640":2444,"_31229":2337,"_21648":58653,"_5":14899,"_28426":58388,"_3090":58654},[],"This flow is useful for:",{"_3640":2445,"_31229":2337,"_21648":58656,"_5":14899,"_28426":58388,"_3090":58657},[],"Requesting certificates from an external CA.",{"_3640":2446,"_31229":2337,"_21648":58659,"_5":14899,"_28426":58388,"_3090":58660},[],"Renewing an identity while keeping the same key.",{"_3640":2447,"_31229":2337,"_21648":58662,"_5":14899,"_28426":58388,"_3090":58663},[],"When you open the form, it asks for the subject data and the main certificate attributes:",{"_3640":2448,"_31229":2337,"_21648":58665,"_5":14899,"_28426":58388,"_3090":58666},[],"**Common Name (CN)**: main name of the identity.",{"_3640":2449,"_31229":2337,"_21648":58668,"_5":14899,"_28426":58388,"_3090":58669},[],"**Organization (O)**: organization or company.",{"_3640":2450,"_31229":2337,"_21648":58671,"_5":14899,"_28426":58388,"_3090":58672},[],"**Organizational Unit (OU)**: department or unit.",{"_3640":2451,"_31229":2337,"_21648":58674,"_5":14899,"_28426":58388,"_3090":58675},[],"**Country (C)**: two-letter country code.",{"_3640":2452,"_31229":2337,"_21648":58677,"_5":14899,"_28426":58388,"_3090":58678},[],"**State / Province (ST)**: state or province.",{"_3640":2453,"_31229":2337,"_21648":58680,"_5":14899,"_28426":58388,"_3090":58681},[],"**Locality (L)**: city or locality.",{"_3640":2454,"_31229":2337,"_21648":58683,"_5":14899,"_28426":58388,"_3090":58684},[],"**Email Address**: contact email.",{"_3640":2455,"_31229":2337,"_21648":58686,"_5":14899,"_28426":58388,"_3090":58687},[],"**Subject Alternative Names (SANs)**: alternative names or identifiers, such as DNS or IP.",{"_3640":2456,"_31229":2337,"_21648":58689,"_5":14899,"_28426":58388,"_3090":58690},[],"Download the CSR and run `openssl req -in request.csr -noout -verify -text`. Check signature, subject and SAN before sending it. A CSR does not determine the final certificate by itself: issuance policy can replace its fields.",{"_3640":2457,"_31229":2337,"_21648":58692,"_5":14899,"_28426":58392,"_3090":58693},[],"Lamassu also offers specific help for local integrations through **Sign locally with OpenSSL & PKCS11 tools**.",{"_3640":2458,"_31229":2337,"_21648":58695,"_5":14899,"_28426":58392,"_3090":58696},[],"It requires the module, token and permissions of the corresponding provider. Check that the Lamassu identifier matches the object accessible from that module. Module configuration belongs to the client environment or Deployment.",{"_3640":2459,"_31229":2337,"_21648":58698,"_5":14899,"_28426":58396,"_3090":58699},[],"Review **Related Entities** and locate CAs, certificates and validation processes that still need signatures. Revoking a CA does not remove the need to publish status during its retention period. Deleting a key does not automatically revoke its certificates either. Plan replacement and retention before using **Delete Key**; provider deletion behavior depends on the engine.",{"_3640":2460,"_31229":2337,"_21648":58701,"_5":14899,"_28426":58396,"_3090":58702},[],"The KMS refuses to delete a key that certificates still reference, with `409` `key is in use`. Revoking a certificate or letting it expire does not release its key reference. Deleting a CA releases the references from its own current certificate and linked reissued certificates, which stay in place to back the CRL and OCSP, and then attempts to delete the key. If other certificates still reference the key, such as another CA sharing it, the KMS keeps it. The certificates the CA issued keep their own key references, even when revoked. The API lets you delete such a certificate only once its issuer CA no longer exists, and deleting it removes it from the CRL and OCSP responses, so keep revoked certificates for their retention period and delete only expired or superseded ones. The KMS also refuses to delete a key that signs the CRL of a CA whose CRL settings are still `ACTIVE`, with the same `409` `key is in use`; that reference is released when the settings are finalized, after the CA is revoked permanently or expires (see CRL). Legacy references retained by the upgrade migration are described in the upgrade guide.",{"_3640":2461,"_31229":2461,"_5":15259,"_3090":58704,"_31567":58705,"_21648":58706,"_28426":2461},"Online validation with OCSP",[51054,52582,56762,57435],[],{"_3640":2462,"_31229":2461,"_21648":58708,"_5":14899,"_28426":2461,"_3090":58709},[],"Query signed status and verify the responder’s response.",{"_3640":2463,"_31229":2461,"_5":31564,"_21648":58711,"_28426":58712,"_3090":58713},[],"/docs/platform/pki/ocsp#how-the-responder-works-in-lamassu","How the responder works in Lamassu",{"_3640":2464,"_31229":2461,"_5":31564,"_21648":58715,"_28426":58716,"_3090":58717},[],"/docs/platform/pki/ocsp#embedding-in-issued-certificates","Embedding in issued certificates",{"_3640":2465,"_31229":2461,"_5":31564,"_21648":58719,"_28426":58720,"_3090":58721},[],"/docs/platform/pki/ocsp#http-endpoints","HTTP endpoints",{"_3640":2466,"_31229":2461,"_5":31564,"_21648":58723,"_28426":58724,"_3090":58725},[],"/docs/platform/pki/ocsp#generate-and-verify-a-query","Generate and verify a query",{"_3640":2467,"_31229":2461,"_5":31564,"_21648":58727,"_28426":58728,"_3090":58729},[],"/docs/platform/pki/ocsp#check-from-the-interface","Check from the interface",{"_3640":2468,"_31229":2461,"_5":31564,"_21648":58731,"_28426":58732,"_3090":58000},[],"/docs/platform/pki/ocsp#references",{"_3640":2469,"_31229":2461,"_21648":58734,"_5":14899,"_28426":2461,"_3090":58735},[],"OCSP queries a certificate’s status and returns a signed response. This guide is for an integrator checking what Lamassu publishes and how the consumer must verify it. For complete identity validation, follow Certificate validation.",{"_3640":2470,"_31229":2461,"_21648":58737,"_5":14899,"_28426":58712,"_3090":58738},[],"The responder retrieves the certificate by serial number and locates its issuing CA in the inventory. It translates persisted status as follows:",{"_3640":2471,"_31229":2461,"_21648":58740,"_5":14899,"_28426":58712,"_3090":58741},[],"Record status",{"_3640":2472,"_31229":2461,"_21648":58743,"_5":14899,"_28426":58712,"_3090":58744},[],"Signed response",{"_3640":2473,"_31229":2461,"_21648":58746,"_5":14899,"_28426":58712,"_3090":55899},[],{"_3640":2474,"_31229":2461,"_21648":58748,"_5":14899,"_28426":58712,"_3090":58749},[],"`Good`.",{"_3640":2475,"_31229":2461,"_21648":58751,"_5":14899,"_28426":58712,"_3090":55916},[],{"_3640":2476,"_31229":2461,"_21648":58753,"_5":14899,"_28426":58712,"_3090":58754},[],"`Revoked`, with revocation reason and timestamp.",{"_3640":2477,"_31229":2461,"_21648":58756,"_5":14899,"_28426":58712,"_3090":58757},[],"Other states, including `INACTIVE` and `EXPIRED`",{"_3640":2478,"_31229":2461,"_21648":58759,"_5":14899,"_28426":58712,"_3090":58760},[],"`Unknown` if the certificate and issuer can be retrieved.",{"_3640":2479,"_31229":2461,"_21648":58762,"_5":14899,"_28426":58712,"_3090":58763},[],"An absent serial number causes a lookup error; it does not guarantee a signed `Unknown` response. Lookup or signing errors produce an HTTP failure. Treat that as unavailable evidence according to consumer policy.",{"_3640":2480,"_31229":2461,"_21648":58765,"_5":14899,"_28426":58712,"_3090":58766},[],"The issuing CA itself signs the response through its KMS-associated key. A delegated OCSP signing certificate is not used. An imported CA without a usable key cannot sign responses.",{"_3640":2481,"_31229":2461,"_21648":58768,"_5":14899,"_28426":58712,"_3090":58769},[],"The implementation sets `thisUpdate` approximately one day before response generation and `nextUpdate` one day after: the declared window is about 48 hours. Inspect received values and apply your freshness policy. The response reflects stored status when queried; a previously cached copy does not change upon revocation.",{"_3640":2482,"_31229":2461,"_21648":58771,"_5":14899,"_28426":58716,"_3090":58772},[],"The signer constructs OCSP URLs from configured VA domains and adds them to AIA. Without domains, there is no URL to add; an imported certificate retains its original extensions. Inspect the actual certificate:",{"_3640":2483,"_31229":2461,"_21648":58774,"_5":14899,"_28426":58716,"_3090":58775},[],"Check that the consumer can reach this URL. DNS, endpoint exposure and domain configuration belong to Deployment. Changing configuration does not modify already signed certificates.",{"_3640":2484,"_31229":2461,"_21648":58777,"_5":14899,"_28426":58720,"_3090":58778},[],"The service accepts:",{"_3640":2485,"_31229":2461,"_21648":58780,"_5":14899,"_28426":58720,"_3090":54528},[],{"_3640":2486,"_31229":2461,"_21648":58782,"_5":14899,"_28426":58720,"_3090":58783},[],"VA service path",{"_3640":2487,"_31229":2461,"_21648":58785,"_5":14899,"_28426":58720,"_3090":58786},[],"Format",{"_3640":2488,"_31229":2461,"_21648":58788,"_5":14899,"_28426":58720,"_3090":58789},[],"`POST`",{"_3640":2489,"_31229":2461,"_21648":58791,"_5":14899,"_28426":58720,"_3090":58792},[],"`/ocsp`",{"_3640":2490,"_31229":2461,"_21648":58794,"_5":14899,"_28426":58720,"_3090":58795},[],"DER request, `Content-Type: application/ocsp-request`.",{"_3640":2491,"_31229":2461,"_21648":58797,"_5":14899,"_28426":58720,"_3090":58184},[],{"_3640":2492,"_31229":2461,"_21648":58799,"_5":14899,"_28426":58720,"_3090":58800},[],"`/ocsp/{ocsp_request}`",{"_3640":2493,"_31229":2461,"_21648":58802,"_5":14899,"_28426":58720,"_3090":58803},[],"DER request encoded using padded URL Base64.",{"_3640":2494,"_31229":2461,"_21648":58805,"_5":14899,"_28426":58720,"_3090":58806},[],"Use POST to avoid client encoding differences. A successful response has `Content-Type: application/ocsp-response` and a DER body. The public prefix depends on the Gateway; use the URL published in the certificate and checked by the operator.",{"_3640":2495,"_31229":2461,"_21648":58808,"_5":14899,"_28426":58724,"_3090":58809},[],"You need OpenSSL 3.x, `device.crt`, its direct issuer’s certificate `issuer.pem` and the consumer’s trusted roots in `roots.pem`. For an intermediate issuer, also prepare `intermediates.pem` containing the intermediate CAs.",{"_3640":2496,"_31229":2461,"_21648":58811,"_5":14899,"_28426":58724,"_3090":58812},[],"Generate the request:",{"_3640":2497,"_31229":2461,"_21648":58814,"_5":14899,"_28426":58724,"_3090":58815},[],"This example omits the nonce because the responder does not echo it. Verification relies on signature, response correspondence and timestamps; it does not demonstrate freshness through a nonce.",{"_3640":2498,"_31229":2461,"_21648":58817,"_5":14899,"_28426":58724,"_3090":58818},[],"Replace the example URL with the inspected endpoint:",{"_3640":2499,"_31229":2461,"_21648":58820,"_5":14899,"_28426":58724,"_3090":58821},[],"Verify the returned DER:",{"_3640":2500,"_31229":2461,"_21648":58823,"_5":14899,"_28426":58724,"_3090":58824},[],"For intermediates, add `-verify_other intermediates.pem`. Require successful response verification and inspect the status corresponding to `device.crt`, issuer, serial, `thisUpdate` and `nextUpdate`. `Response verify OK` validates the response only: also observe `good`, `revoked` or `unknown`. Do not accept an identity based only on the command’s exit code.",{"_3640":2501,"_31229":2461,"_21648":58826,"_5":14899,"_28426":58728,"_3090":58827},[],"**OCSP Check** shows what Lamassu returns for a selected certificate. Complete the check from the consumer’s network and trust store: a console query does not establish its validation configuration.",{"_3640":2502,"_31229":2461,"_21648":58829,"_5":14899,"_28426":58728,"_3090":58830},[],"To check a change, save an earlier response, revoke a test certificate and request another response. The new query should reflect persisted status; compare timestamps to rule out reuse of an earlier response. If it fails, follow PKI troubleshooting.",{"_3640":2503,"_31229":2461,"_21648":58832,"_5":14899,"_28426":58732,"_3090":58833},[],"RFC 6960: OCSP.",{"_3640":2504,"_31229":2461,"_21648":58835,"_5":14899,"_28426":58732,"_3090":58836},[],"OpenSSL: openssl-ocsp.",{"_3640":2505,"_31229":2461,"_21648":58838,"_5":14899,"_28426":58732,"_3090":58839},[],"<Card title=\"CRL service\" href=\"/docs/platform/pki/crl\" />",{"_3640":2506,"_31229":2461,"_21648":58841,"_5":14899,"_28426":58732,"_3090":58310},[],{"_3640":2507,"_31229":2507,"_5":15259,"_3090":56762,"_31567":58843,"_21648":58844,"_28426":2507},[51054,52582,56762],[],{"_3640":2508,"_31229":2507,"_21648":58846,"_5":14899,"_28426":2507,"_3090":58847},[],"Administer keys and authorities, define issuance and verify the resulting certificates.",{"_3640":2509,"_31229":2507,"_5":31564,"_21648":58849,"_28426":58850,"_3090":56074},[],"/docs/platform/pki/overview#start-here",{"_3640":2510,"_31229":2507,"_5":31564,"_21648":58852,"_28426":58853,"_3090":58854},[],"/docs/platform/pki/overview#what-you-need","What you need",{"_3640":2511,"_31229":2507,"_5":31564,"_21648":58856,"_28426":58857,"_3090":56606},[],"/docs/platform/pki/overview#core-capabilities",{"_3640":2512,"_31229":2507,"_5":31564,"_21648":58859,"_28426":58860,"_3090":56610},[],"/docs/platform/pki/overview#build-your-trust-hierarchy",{"_3640":2513,"_31229":2507,"_5":31564,"_21648":58862,"_28426":58863,"_3090":56614},[],"/docs/platform/pki/overview#protect-cryptographic-keys",{"_3640":2514,"_31229":2507,"_5":31564,"_21648":58865,"_28426":58866,"_3090":56618},[],"/docs/platform/pki/overview#issue-and-control-certificates",{"_3640":2515,"_31229":2507,"_5":31564,"_21648":58868,"_28426":58869,"_3090":56626},[],"/docs/platform/pki/overview#publish-validation-status",{"_3640":2516,"_31229":2507,"_5":31564,"_21648":58871,"_28426":58872,"_3090":58873},[],"/docs/platform/pki/overview#how-to-check-the-result","How to check the result",{"_3640":2517,"_31229":2507,"_5":31564,"_21648":58875,"_28426":58876,"_3090":57602},[],"/docs/platform/pki/overview#continue",{"_3640":2518,"_31229":2507,"_21648":58878,"_5":14899,"_28426":2507,"_3090":58879},[],"The PKI section explains how to build and operate X.509 trust in Lamassu: which authorities issue, which rules apply and how to check certificates. It is intended for PKI administrators and anyone who needs to use certificates in a consuming system.",{"_3640":2519,"_31229":2507,"_21648":58881,"_5":14899,"_28426":58850,"_3090":58882},[],"Follow PKI getting started to create a CA, issue a client certificate and verify it with OpenSSL. The result is a certificate, its private key and a verified chain.",{"_3640":2520,"_31229":2507,"_21648":58884,"_5":14899,"_28426":58850,"_3090":58885},[],"You can complete that path before managing devices. When you need to associate the identity with an inventory or automate its enrollment, continue in IoT Fleets.",{"_3640":2521,"_31229":2507,"_21648":58887,"_5":14899,"_28426":58853,"_3090":58888},[],"An accessible instance and permission to manage the keys, CAs and certificates you will use.",{"_3640":2522,"_31229":2507,"_21648":58890,"_5":14899,"_28426":58853,"_3090":58891},[],"An available cryptographic engine to keep the authority's key.",{"_3640":2523,"_31229":2507,"_21648":58893,"_5":14899,"_28426":58853,"_3090":58894},[],"The certificate's purpose, such as authenticating a client through mTLS.",{"_3640":2524,"_31229":2507,"_21648":58896,"_5":14899,"_28426":58853,"_3090":58897},[],"Consumer requirements: accepted issuers, algorithms, names and permitted usages.",{"_3640":2525,"_31229":2507,"_21648":58899,"_5":14899,"_28426":58853,"_3090":58900},[],"Prepare the instance and cryptographic provider in Deployment. The trust model explains hierarchy choices.",{"_3640":2526,"_31229":2507,"_21648":58902,"_5":14899,"_28426":58860,"_3090":58903},[],"Authorities sign certificates. A root establishes the trust anchor, and an intermediate separates issuance by environment or purpose. Hierarchy and rotation explains how to maintain trust when replacing an authority.",{"_3640":2527,"_31229":2507,"_21648":58905,"_5":14899,"_28426":58863,"_3090":58906},[],"CA signing keys are managed through KMS and cryptographic engines. A client that generates a CSR can keep its own key: preserve that custody when choosing the issuance method.",{"_3640":2528,"_31229":2507,"_21648":58908,"_5":14899,"_28426":58866,"_3090":58909},[],"A profile establishes subject, validity, usage and key restrictions. The CA applies issuance configuration and signs the certificate. In the inventory, you can inspect the result, download it and manage its status.",{"_3640":2529,"_31229":2507,"_21648":58911,"_5":14899,"_28426":58869,"_3090":58912},[],"Validation covers the chain, validity, usages and revocation status. Lamassu publishes status through OCSP and CRL; the consumer configures which issuers it recognizes and how it checks that status.",{"_3640":2530,"_31229":2507,"_21648":58914,"_5":14899,"_28426":58872,"_3090":58915},[],"An active certificate in the console is one part of the check. Also verify that:",{"_3640":2531,"_31229":2507,"_21648":58917,"_5":14899,"_28426":58872,"_3090":58918},[],"its subject and extensions identify the expected client;",{"_3640":2532,"_31229":2507,"_21648":58920,"_5":14899,"_28426":58872,"_3090":58921},[],"its public key matches the client's private key;",{"_3640":2533,"_31229":2507,"_21648":58923,"_5":14899,"_28426":58872,"_3090":58924},[],"its chain reaches a root trusted by the consumer;",{"_3640":2534,"_31229":2507,"_21648":58926,"_5":14899,"_28426":58872,"_3090":58927},[],"its dates and usages allow the operation;",{"_3640":2535,"_31229":2507,"_21648":58929,"_5":14899,"_28426":58872,"_3090":58930},[],"the consumer applies revocation checks and authorization.",{"_3640":2536,"_31229":2507,"_21648":58932,"_5":14899,"_28426":58872,"_3090":58933},[],"The issuance path includes the first independent checks.",{"_3640":2537,"_31229":2507,"_21648":58935,"_5":14899,"_28426":58876,"_3090":58936},[],"<Card title=\"PKI getting started\" description=\"Create a CA, then issue and verify a client certificate.\" href=\"/docs/platform/pki/quickstarts/overview\" />",{"_3640":2538,"_31229":2507,"_21648":58938,"_5":14899,"_28426":58876,"_3090":58939},[],"<Card title=\"Apply PKI to devices\" description=\"Associate certificates with inventory and prepare enrollment.\" href=\"/docs/platform/iot-fleets/overview\" />",{"_3640":2539,"_31229":2507,"_21648":58941,"_5":14899,"_28426":58876,"_3090":58942},[],"<Card title=\"PKI diagnostics\" description=\"Check issuance, OCSP and CRL when the result fails.\" href=\"/docs/platform/pki/troubleshooting\" />",{"_3640":2540,"_31229":2540,"_5":15259,"_3090":58944,"_31567":58945,"_21648":58946,"_28426":2540},"Create your first CA",[51054,52582,56762,56199],[],{"_3640":2541,"_31229":2540,"_21648":58948,"_5":14899,"_28426":2540,"_3090":58949},[],"Create an evaluation root and check its certificate before issuing.",{"_3640":2542,"_31229":2540,"_5":31564,"_21648":58951,"_28426":58952,"_3090":51064},[],"/docs/platform/pki/quickstarts/create-certificate-authority#before-you-begin",{"_3640":2543,"_31229":2540,"_5":31564,"_21648":58954,"_28426":58955,"_3090":58956},[],"/docs/platform/pki/quickstarts/create-certificate-authority#open-the-creation-wizard-toc","Open the creation wizard [!toc]",{"_3640":2544,"_31229":2540,"_5":31564,"_21648":58958,"_28426":58959,"_3090":58960},[],"/docs/platform/pki/quickstarts/create-certificate-authority#select-the-key-toc","Select the key [!toc]",{"_3640":2545,"_31229":2540,"_5":31564,"_21648":58962,"_28426":58963,"_3090":58964},[],"/docs/platform/pki/quickstarts/create-certificate-authority#define-the-authority-toc","Define the authority [!toc]",{"_3640":2546,"_31229":2540,"_5":31564,"_21648":58966,"_28426":58967,"_3090":58968},[],"/docs/platform/pki/quickstarts/create-certificate-authority#review-and-create-the-ca-toc","Review and create the CA [!toc]",{"_3640":2547,"_31229":2540,"_5":31564,"_21648":58970,"_28426":58971,"_3090":58972},[],"/docs/platform/pki/quickstarts/create-certificate-authority#verify-the-result-toc","Verify the result [!toc]",{"_3640":2548,"_31229":2540,"_5":31564,"_21648":58974,"_28426":58975,"_3090":58976},[],"/docs/platform/pki/quickstarts/create-certificate-authority#check-the-ca-certificate","Check the CA certificate",{"_3640":2549,"_31229":2540,"_5":31564,"_21648":58978,"_28426":58979,"_3090":56456},[],"/docs/platform/pki/quickstarts/create-certificate-authority#if-the-result-fails",{"_3640":2550,"_31229":2540,"_5":31564,"_21648":58981,"_28426":58982,"_3090":51088},[],"/docs/platform/pki/quickstarts/create-certificate-authority#next-step",{"_3640":2551,"_31229":2540,"_21648":58984,"_5":14899,"_28426":2540,"_3090":58985},[],"You will create a root authority with a new key kept by a Lamassu engine. The result is an active CA and its public certificate in `ca.pem`, ready to verify issuance in the next path.",{"_3640":2552,"_31229":2540,"_21648":58987,"_5":14899,"_28426":58952,"_3090":58988},[],"Console access and permission to create keys and authorities.",{"_3640":2553,"_31229":2540,"_21648":58990,"_5":14899,"_28426":58952,"_3090":58991},[],"An available cryptographic engine that supports the chosen algorithm.",{"_3640":2554,"_31229":2540,"_21648":58993,"_5":14899,"_28426":58952,"_3090":58994},[],"OpenSSL 3.x to check the downloaded certificate.",{"_3640":2555,"_31229":2540,"_21648":58996,"_5":14899,"_28426":58952,"_3090":58997},[],"Use an evaluation instance or an authority intended for these tests. The example creates a root that issues directly; to design an operational hierarchy, see Hierarchy and rotation.",{"_3640":2556,"_31229":2540,"_21648":58999,"_5":14899,"_28426":58955,"_3090":59000},[],"In **Certification Authorities**, select **Create New CA** and choose to create a CA with a new key pair.",{"_3640":2557,"_31229":2540,"_21648":59002,"_5":14899,"_28426":58955,"_3090":59003},[],"The &#x2A;*Create New CA (Existing Key)** flow is explained in the authorities guide.",{"_3640":2558,"_31229":2540,"_21648":59005,"_5":14899,"_28426":58959,"_3090":59006},[],"Choose the engine that will keep the key and an algorithm its capabilities allow. For this example, you can use **EC P-384** if available.",{"_3640":2559,"_31229":2540,"_21648":59008,"_5":14899,"_28426":58959,"_3090":59009},[],"The CA private key is used through the engine. In this path, you will download only the authority's public certificate.",{"_3640":2560,"_31229":2540,"_21648":59011,"_5":14899,"_28426":58963,"_3090":59012},[],"Select **Root CA** and complete:",{"_3640":2561,"_31229":2540,"_21648":59014,"_5":14899,"_28426":58963,"_3090":59015},[],"**CA Name**: `Acme Evaluation Root CA`.",{"_3640":2562,"_31229":2540,"_21648":59017,"_5":14899,"_28426":58963,"_3090":59018},[],"**Subject**: organization and country details for your evaluation.",{"_3640":2563,"_31229":2540,"_21648":59020,"_5":14899,"_28426":58963,"_3090":59021},[],"**CA Certificate Expiration**: for example, one year from creation.",{"_3640":2564,"_31229":2540,"_21648":59023,"_5":14899,"_28426":58963,"_3090":59024},[],"**Default End-Entity Certificate Issuance Expiration**: for example, 90 days, within the CA's lifetime.",{"_3640":2565,"_31229":2540,"_21648":59026,"_5":14899,"_28426":58963,"_3090":59027},[],"The CA name becomes its `Common Name`. Keep the CA usages needed to sign certificates and CRLs.",{"_3640":2566,"_31229":2540,"_21648":59029,"_5":14899,"_28426":58967,"_3090":59030},[],"Check the engine, algorithm, subject, root type and dates. Confirm creation and note the authority identifier so you can recognize it in the DMS or API.",{"_3640":2567,"_31229":2540,"_21648":59032,"_5":14899,"_28426":58971,"_3090":59033},[],"Open the new CA. It should appear active, show its certificate and allow access to **Issued Certificates**.",{"_3640":2568,"_31229":2540,"_21648":59035,"_5":14899,"_28426":58971,"_3090":59036},[],"Download or copy the authority's PEM certificate and save it as `ca.pem`. Check that the file contains the complete block, including `BEGIN CERTIFICATE` and `END CERTIFICATE`.",{"_3640":2569,"_31229":2540,"_21648":59038,"_5":14899,"_28426":58975,"_3090":59039},[],"Run from the directory where you saved `ca.pem`:",{"_3640":2570,"_31229":2540,"_21648":59041,"_5":14899,"_28426":58975,"_3090":59042},[],"Check that the subject and issuer match the root you created, the dates include the current time, **Basic Constraints** contains `CA:TRUE` and **Key Usage** allows certificate signing. The last command should return `ca.pem: OK`.",{"_3640":2571,"_31229":2540,"_21648":59044,"_5":14899,"_28426":58975,"_3090":59045},[],"You explicitly selected `ca.pem` as the trust anchor for this test. A valid self-signature does not install that trust in other consumers. See the openssl-verify reference for verification options.",{"_3640":2572,"_31229":2540,"_21648":59047,"_5":14899,"_28426":58979,"_3090":59048},[],"If creation fails, check permissions, engine availability and the selected algorithm.",{"_3640":2573,"_31229":2540,"_21648":59050,"_5":14899,"_28426":58979,"_3090":59051},[],"If OpenSSL cannot read the file, copy the complete PEM block again.",{"_3640":2574,"_31229":2540,"_21648":59053,"_5":14899,"_28426":58979,"_3090":59054},[],"If signature or date checks fail, check that you downloaded this CA's certificate and that your computer's clock is correct.",{"_3640":2575,"_31229":2540,"_21648":59056,"_5":14899,"_28426":58979,"_3090":59057},[],"PKI diagnostics covers issuance checks and cryptographic dependencies.",{"_3640":2576,"_31229":2540,"_21648":59059,"_5":14899,"_28426":58982,"_3090":59060},[],"Continue with Issue and verify a certificate, using this authority and `ca.pem`.",{"_3640":2577,"_31229":2577,"_5":15259,"_3090":59062,"_31567":59063,"_21648":59064,"_28426":2577},"Issue and verify a certificate",[51054,52582,56762,56199],[],{"_3640":2578,"_31229":2577,"_21648":59066,"_5":14899,"_28426":2577,"_3090":59067},[],"Issue a client certificate and check content, chain and key correspondence.",{"_3640":2579,"_31229":2577,"_5":31564,"_21648":59069,"_28426":59070,"_3090":51064},[],"/docs/platform/pki/quickstarts/issue-certificate#before-you-begin",{"_3640":2580,"_31229":2577,"_5":31564,"_21648":59072,"_28426":59073,"_3090":59074},[],"/docs/platform/pki/quickstarts/issue-certificate#start-the-issuance","Start the issuance",{"_3640":2581,"_31229":2577,"_5":31564,"_21648":59076,"_28426":59077,"_3090":59078},[],"/docs/platform/pki/quickstarts/issue-certificate#choose-the-method","Choose the method",{"_3640":2582,"_31229":2577,"_5":31564,"_21648":59080,"_28426":59081,"_3090":59082},[],"/docs/platform/pki/quickstarts/issue-certificate#identify-the-certificate","Identify the certificate",{"_3640":2583,"_31229":2577,"_5":31564,"_21648":59084,"_28426":59085,"_3090":59086},[],"/docs/platform/pki/quickstarts/issue-certificate#configure-key-and-uses","Configure key and uses",{"_3640":2584,"_31229":2577,"_5":31564,"_21648":59088,"_28426":59089,"_3090":59090},[],"/docs/platform/pki/quickstarts/issue-certificate#issue-and-download","Issue and download",{"_3640":2585,"_31229":2577,"_5":31564,"_21648":59092,"_28426":59093,"_3090":59094},[],"/docs/platform/pki/quickstarts/issue-certificate#verify-the-result","Verify the result",{"_3640":2586,"_31229":2577,"_5":31564,"_21648":59096,"_28426":59097,"_3090":59098},[],"/docs/platform/pki/quickstarts/issue-certificate#inspect-content-and-dates","Inspect content and dates",{"_3640":2587,"_31229":2577,"_5":31564,"_21648":59100,"_28426":59101,"_3090":59102},[],"/docs/platform/pki/quickstarts/issue-certificate#verify-the-chain","Verify the chain",{"_3640":2588,"_31229":2577,"_5":31564,"_21648":59104,"_28426":59105,"_3090":59106},[],"/docs/platform/pki/quickstarts/issue-certificate#check-that-the-key-matches","Check that the key matches",{"_3640":2589,"_31229":2577,"_5":31564,"_21648":59108,"_28426":59109,"_3090":56456},[],"/docs/platform/pki/quickstarts/issue-certificate#if-the-result-fails",{"_3640":2590,"_31229":2577,"_5":31564,"_21648":59111,"_28426":59112,"_3090":51088},[],"/docs/platform/pki/quickstarts/issue-certificate#next-step",{"_3640":2591,"_31229":2577,"_21648":59114,"_5":14899,"_28426":2577,"_3090":59115},[],"You will issue an end-entity certificate for `device-001` using browser key and CSR generation. The result is `device.crt`, `device.key` and the issuing root's public certificate, `ca.pem`.",{"_3640":2592,"_31229":2577,"_21648":59117,"_5":14899,"_28426":59070,"_3090":59118},[],"An active root CA with an available signing key and permission to issue. If one does not exist yet, follow Create your first CA.",{"_3640":2593,"_31229":2577,"_21648":59120,"_5":14899,"_28426":59070,"_3090":59121},[],"Its public certificate in `ca.pem`; this example uses the root created in the previous path.",{"_3640":2594,"_31229":2577,"_21648":59123,"_5":14899,"_28426":59070,"_3090":59124},[],"OpenSSL 3.x and a working directory with restricted access.",{"_3640":2595,"_31229":2577,"_21648":59126,"_5":14899,"_28426":59070,"_3090":59127},[],"A client identifier: here we use `device-001`.",{"_3640":2596,"_31229":2577,"_21648":59129,"_5":14899,"_28426":59070,"_3090":59130},[],"In this flow, the client's key is generated in the browser and must be downloaded when issuance finishes. If you lose it, you must generate a key and issue another certificate. The certificate inventory lets you download the public certificate, but cannot recover this key.",{"_3640":2597,"_31229":2577,"_21648":59132,"_5":14899,"_28426":59073,"_3090":59133},[],"Open the CA from the previous path, go to **Issued Certificates** and select **Issue New**.",{"_3640":2598,"_31229":2577,"_21648":59135,"_5":14899,"_28426":59077,"_3090":59136},[],"Select **Generate Key & CSR in Browser** to follow this example.",{"_3640":2599,"_31229":2577,"_21648":59138,"_5":14899,"_28426":59077,"_3090":59139},[],"If the key must be generated and kept on the destination system, use **Upload Existing CSR**, described in the authorities guide.",{"_3640":2600,"_31229":2577,"_21648":59141,"_5":14899,"_28426":59081,"_3090":59142},[],"Enter `device-001` as the `Common Name`. Add subject details required by your policy and SANs if the consumer uses them to identify the client.",{"_3640":2601,"_31229":2577,"_21648":59144,"_5":14899,"_28426":59081,"_3090":59145},[],"If you continue with manual registration, the `Device ID` will be exactly `device-001`.",{"_3640":2602,"_31229":2577,"_21648":59147,"_5":14899,"_28426":59085,"_3090":59148},[],"Choose an algorithm and size allowed by the profile; for example, ECDSA P-256 if permitted. For this client certificate, select **Digital Signature** and **Client Authentication**, and issue it as an end-entity certificate.",{"_3640":2603,"_31229":2577,"_21648":59150,"_5":14899,"_28426":59085,"_3090":59151},[],"Request, for example, 30 days of validity, always within the CA's lifetime. Review the issuance profile if the resulting content differs from the request.",{"_3640":2604,"_31229":2577,"_21648":59153,"_5":14899,"_28426":59089,"_3090":59154},[],"Confirm issuance. Save the PEM certificate as `device.crt` and the private key as `device.key` in your prepared directory.",{"_3640":2605,"_31229":2577,"_21648":59156,"_5":14899,"_28426":59093,"_3090":59157},[],"Check in **Issued Certificates** that the certificate appears active. Note its serial number and verify the downloaded material using the checks below.",{"_3640":2606,"_31229":2577,"_21648":59159,"_5":14899,"_28426":59097,"_3090":59160},[],"Check `CN=device-001`, the expected issuer, current validity, **Digital Signature** and the extended usage **TLS Web Client Authentication**. It must be an end-entity certificate: it must not declare `CA:TRUE` or enable **Certificate Sign**. If **Basic Constraints** is present, it must indicate `CA:FALSE`. If you requested SANs, check that the expected identifiers appear in the certificate.",{"_3640":2607,"_31229":2577,"_21648":59162,"_5":14899,"_28426":59101,"_3090":59163},[],"The expected result is `device.crt: OK`. This check uses your explicit root and evaluates the chain, dates and compatibility with the TLS client purpose. Also check for the expected usages and names through the inspection above.",{"_3640":2608,"_31229":2577,"_21648":59165,"_5":14899,"_28426":59101,"_3090":59166},[],"If you use an intermediate CA, the trusted root must be in `ca.pem` and you must supply the intermediates with `-untrusted intermediates.pem`. This variant is covered in the trust model.",{"_3640":2609,"_31229":2577,"_21648":59168,"_5":14899,"_28426":59101,"_3090":59169},[],"The command does not query OCSP or CRL. For revocation checks, continue with Certificate validation. See the openssl-verify reference for its options.",{"_3640":2610,"_31229":2577,"_21648":59171,"_5":14899,"_28426":59105,"_3090":59172},[],"In Bash, compare the two public-key digests:",{"_3640":2611,"_31229":2577,"_21648":59174,"_5":14899,"_28426":59105,"_3090":59175},[],"Both commands must finish successfully and show the same SHA-256 digest. If they differ, the private key does not match the selected certificate. Find the correct pair before installing it.",{"_3640":2612,"_31229":2577,"_21648":59177,"_5":14899,"_28426":59105,"_3090":59178},[],"The options used are documented in openssl-x509 and openssl-pkey.",{"_3640":2613,"_31229":2577,"_21648":59180,"_5":14899,"_28426":59109,"_3090":56540},[],{"_3640":2614,"_31229":2577,"_21648":59182,"_5":14899,"_28426":59109,"_3090":59183},[],"What to review",{"_3640":2615,"_31229":2577,"_21648":59185,"_5":14899,"_28426":59109,"_3090":59186},[],"The CA rejects issuance",{"_3640":2616,"_31229":2577,"_21648":59188,"_5":14899,"_28426":59109,"_3090":59189},[],"Permissions, CA state and key, algorithm and profile.",{"_3640":2617,"_31229":2577,"_21648":59191,"_5":14899,"_28426":59109,"_3090":59192},[],"Different subject or usages",{"_3640":2618,"_31229":2577,"_21648":59194,"_5":14899,"_28426":59109,"_3090":59195},[],"Applied profile and requested values.",{"_3640":2619,"_31229":2577,"_21648":59197,"_5":14899,"_28426":59109,"_3090":59198},[],"Issuer cannot be found",{"_3640":2620,"_31229":2577,"_21648":59200,"_5":14899,"_28426":59109,"_3090":59201},[],"Downloaded CA and required intermediate chain.",{"_3640":2621,"_31229":2577,"_21648":59203,"_5":14899,"_28426":59109,"_3090":59204},[],"Validity fails",{"_3640":2622,"_31229":2577,"_21648":59206,"_5":14899,"_28426":59109,"_3090":59207},[],"Certificate and CA dates, and the computer's clock.",{"_3640":2623,"_31229":2577,"_21648":59209,"_5":14899,"_28426":59109,"_3090":59210},[],"Public-key digests differ",{"_3640":2624,"_31229":2577,"_21648":59212,"_5":14899,"_28426":59109,"_3090":59213},[],"Certificate and key files from the same issuance.",{"_3640":2625,"_31229":2577,"_21648":59215,"_5":14899,"_28426":59109,"_3090":59216},[],"See PKI diagnostics to narrow an issuance failure.",{"_3640":2626,"_31229":2577,"_21648":59218,"_5":14899,"_28426":59112,"_3090":59219},[],"You have completed the PKI path when the certificate verifies and the key matches. Choose how to use it:",{"_3640":2627,"_31229":2577,"_21648":59221,"_5":14899,"_28426":59112,"_3090":59222},[],"Manage certificates for inspection, status and revocation.",{"_3640":2628,"_31229":2577,"_21648":59224,"_5":14899,"_28426":59112,"_3090":59225},[],"Register a device manually to associate this identity with Lamassu's inventory.",{"_3640":2629,"_31229":2577,"_21648":59227,"_5":14899,"_28426":59112,"_3090":59228},[],"Prepare EST for the device to request its next identities.",{"_3640":2630,"_31229":2577,"_21648":59230,"_5":14899,"_28426":59112,"_3090":59231},[],"Acceptance by a consumer requires configuring its trust, revocation checks and permissions granted to the identity.",{"_3640":2631,"_31229":2631,"_5":15259,"_3090":59233,"_31567":59234,"_21648":59235,"_28426":2631},"PKI getting started",[51054,52582,56762,56199],[],{"_3640":2632,"_31229":2631,"_21648":59237,"_5":14899,"_28426":2631,"_3090":59238},[],"Create a CA, issue a client certificate and check its chain and key.",{"_3640":2633,"_31229":2631,"_5":31564,"_21648":59240,"_28426":59241,"_3090":51064},[],"/docs/platform/pki/quickstarts/overview#before-you-begin",{"_3640":2634,"_31229":2631,"_5":31564,"_21648":59243,"_28426":59244,"_3090":59245},[],"/docs/platform/pki/quickstarts/overview#recommended-path","Recommended path",{"_3640":2635,"_31229":2631,"_5":31564,"_21648":59247,"_28426":59248,"_3090":56391},[],"/docs/platform/pki/quickstarts/overview#expected-result",{"_3640":2636,"_31229":2631,"_5":31564,"_21648":59250,"_28426":59251,"_3090":59252},[],"/docs/platform/pki/quickstarts/overview#continue-according-to-your-goal","Continue according to your goal",{"_3640":2637,"_31229":2631,"_21648":59254,"_5":14899,"_28426":2631,"_3090":59255},[],"This path is intended for those starting to administer PKI or needing a first X.509 client identity. It ends with three files: a root CA certificate, an end-entity certificate and the client's private key.",{"_3640":2638,"_31229":2631,"_21648":59257,"_5":14899,"_28426":59241,"_3090":59258},[],"A Lamassu instance accessible from your browser. To prepare one, see Deployment.",{"_3640":2639,"_31229":2631,"_21648":59260,"_5":14899,"_28426":59241,"_3090":59261},[],"Permission to manage keys, authorities and issuance. See Access control if an operation is blocked.",{"_3640":2640,"_31229":2631,"_21648":59263,"_5":14899,"_28426":59241,"_3090":59264},[],"An available cryptographic engine for the CA key; check the keys and engines inventory.",{"_3640":2641,"_31229":2631,"_21648":59266,"_5":14899,"_28426":59241,"_3090":59267},[],"OpenSSL 3.x on the computer where you will verify the files.",{"_3640":2642,"_31229":2631,"_21648":59269,"_5":14899,"_28426":59241,"_3090":59270},[],"A working directory with restricted access for the downloaded key.",{"_3640":2643,"_31229":2631,"_21648":59272,"_5":14899,"_28426":59244,"_3090":59273},[],"<Card title=\"1. Create your first CA\" description=\"Create an evaluation root and save its public certificate as ca.pem.\" href=\"/docs/platform/pki/quickstarts/create-certificate-authority\" />",{"_3640":2644,"_31229":2631,"_21648":59275,"_5":14899,"_28426":59244,"_3090":59276},[],"<Card title=\"2. Issue and verify a certificate\" description=\"Issue for device-001 and check content, chain and key correspondence.\" href=\"/docs/platform/pki/quickstarts/issue-certificate\" />",{"_3640":2645,"_31229":2631,"_21648":59278,"_5":14899,"_28426":59244,"_3090":59279},[],"We use `Acme Evaluation Root CA` and `device-001` as example names. If you replace them, keep the same client identifier in the steps you want to connect.",{"_3640":2646,"_31229":2631,"_21648":59281,"_5":14899,"_28426":59244,"_3090":59282},[],"The root in this path signs the end-entity certificate directly to simplify evaluation. Before designing an operational PKI, review the trust model and CA hierarchy.",{"_3640":2647,"_31229":2631,"_21648":59284,"_5":14899,"_28426":59248,"_3090":59285},[],"File or resource",{"_3640":2648,"_31229":2631,"_21648":59287,"_5":14899,"_28426":59248,"_3090":56388},[],{"_3640":2649,"_31229":2631,"_21648":59289,"_5":14899,"_28426":59248,"_3090":59290},[],"Active root CA and `ca.pem`",{"_3640":2650,"_31229":2631,"_21648":59292,"_5":14899,"_28426":59248,"_3090":59293},[],"It is a CA certificate, is currently valid and its self-signature verifies.",{"_3640":2651,"_31229":2631,"_21648":59295,"_5":14899,"_28426":59248,"_3090":59296},[],"End-entity certificate and `device.crt`",{"_3640":2652,"_31229":2631,"_21648":59298,"_5":14899,"_28426":59248,"_3090":59299},[],"It identifies `device-001`, supports client authentication and verifies against `ca.pem`.",{"_3640":2653,"_31229":2631,"_21648":59301,"_5":14899,"_28426":59248,"_3090":59302},[],"Private key `device.key`",{"_3640":2654,"_31229":2631,"_21648":59304,"_5":14899,"_28426":59248,"_3090":59305},[],"Its public key matches the one included in `device.crt`.",{"_3640":2655,"_31229":2631,"_21648":59307,"_5":14899,"_28426":59248,"_3090":59308},[],"These checks validate the issued material. Acceptance by a service also requires its trust, authorization and revocation configuration.",{"_3640":2656,"_31229":2631,"_21648":59310,"_5":14899,"_28426":59251,"_3090":59311},[],"To operate certificates, continue with Certificates and Validation.",{"_3640":2657,"_31229":2631,"_21648":59313,"_5":14899,"_28426":59251,"_3090":59314},[],"To manage a device identity in Lamassu, follow Manual registration. That path includes DMS preparation.",{"_3640":2658,"_31229":2631,"_21648":59316,"_5":14899,"_28426":59251,"_3090":59317},[],"For the device to request its certificate, prepare the DMS and EST client.",{"_3640":2659,"_31229":2659,"_5":15259,"_3090":59319,"_31567":59320,"_21648":59321,"_28426":2659},"PKI troubleshooting",[51054,52582,56762,55337],[],{"_3640":2660,"_31229":2659,"_21648":59323,"_5":14899,"_28426":2659,"_3090":59324},[],"Diagnose certificate issuance, OCSP and CRL.",{"_3640":2661,"_31229":2659,"_5":31564,"_21648":59326,"_28426":59327,"_3090":59328},[],"/docs/platform/pki/troubleshooting#issuance-fails","Issuance fails",{"_3640":2662,"_31229":2659,"_5":31564,"_21648":59330,"_28426":59331,"_3090":59332},[],"/docs/platform/pki/troubleshooting#ocsp-or-crl-do-not-reflect-a-change","OCSP or CRL do not reflect a change",{"_3640":2663,"_31229":2659,"_5":31564,"_21648":59334,"_28426":59335,"_3090":59336},[],"/docs/platform/pki/troubleshooting#the-chain-validates-but-the-connection-fails","The chain validates but the connection fails",{"_3640":2664,"_31229":2659,"_21648":59338,"_5":14899,"_28426":2659,"_3090":59339},[],"This guide helps a PKI operator locate issuance and status publication failures. Keep the Lamassu version, operation, CA, issuer, serial, time and returned error. Do not include private keys or tokens in diagnostics.",{"_3640":2665,"_31229":2659,"_21648":59341,"_5":14899,"_28426":2659,"_3090":59342},[],"For Gateway, sign-in, pods, dependencies and messaging, see Deployment troubleshooting. For device enrollment, see EST diagnostics.",{"_3640":2666,"_31229":2659,"_21648":59344,"_5":14899,"_28426":59327,"_3090":56388},[],{"_3640":2667,"_31229":2659,"_21648":59346,"_5":14899,"_28426":59327,"_3090":59347},[],"What to inspect",{"_3640":2668,"_31229":2659,"_21648":59349,"_5":14899,"_28426":59327,"_3090":51088},[],{"_3640":2669,"_31229":2659,"_21648":59351,"_5":14899,"_28426":59327,"_3090":55604},[],{"_3640":2670,"_31229":2659,"_21648":59353,"_5":14899,"_28426":59327,"_3090":59354},[],"Exists, is active and has usable dates.",{"_3640":2671,"_31229":2659,"_21648":59356,"_5":14899,"_28426":59327,"_3090":59357},[],"Authorities.",{"_3640":2672,"_31229":2659,"_21648":59359,"_5":14899,"_28426":59327,"_3090":59360},[],"Key",{"_3640":2673,"_31229":2659,"_21648":59362,"_5":14899,"_28426":59327,"_3090":59363},[],"The record has a usable private key and the engine can sign.",{"_3640":2674,"_31229":2659,"_21648":59365,"_5":14899,"_28426":59327,"_3090":59366},[],"Try **Sign / Verify** in KMS; check provider permissions and availability.",{"_3640":2675,"_31229":2659,"_21648":59368,"_5":14899,"_28426":59327,"_3090":59369},[],"CSR",{"_3640":2676,"_31229":2659,"_21648":59371,"_5":14899,"_28426":59327,"_3090":59372},[],"Correct PEM and verifiable signature.",{"_3640":2677,"_31229":2659,"_21648":59374,"_5":14899,"_28426":59327,"_3090":59375},[],"`openssl req -in request.csr -noout -verify -text`.",{"_3640":2678,"_31229":2659,"_21648":59377,"_5":14899,"_28426":59327,"_3090":59378},[],"Profile",{"_3640":2679,"_31229":2659,"_21648":59380,"_5":14899,"_28426":59327,"_3090":59381},[],"Selected source, existing ID, allowed algorithm and size.",{"_3640":2680,"_31229":2659,"_21648":59383,"_5":14899,"_28426":59327,"_3090":59384},[],"Check Profiles precedence; CA and DMS resolve differently.",{"_3640":2681,"_31229":2659,"_21648":59386,"_5":14899,"_28426":59327,"_3090":56540},[],{"_3640":2682,"_31229":2659,"_21648":59388,"_5":14899,"_28426":59327,"_3090":59389},[],"Appropriate subject, SAN, usages and dates.",{"_3640":2683,"_31229":2659,"_21648":59391,"_5":14899,"_28426":59327,"_3090":59392},[],"Compare CSR, profile and certificate; successful issuance does not establish consumer acceptance.",{"_3640":2684,"_31229":2659,"_21648":59394,"_5":14899,"_28426":59327,"_3090":59395},[],"For unexpected certificate fields, review `Honor Subject`, `Honor Key Usage`, `Honor Extended Key Usages` and `Honor Extensions`. The latter preserves SAN only, without validating entitlement to those names. Validity is not automatically clamped to CA expiration.",{"_3640":2685,"_31229":2659,"_21648":59397,"_5":14899,"_28426":59327,"_3090":59398},[],"If issuance fails with `400` and `CA Status inconsistent`, the issuing CA is not `ACTIVE` or is outside the validity period of its certificate. The stored status can lag behind the dates until the expiration monitor runs, so check the dates too. Reissue the CA while it is still valid, or issue from another CA.",{"_3640":2686,"_31229":2659,"_21648":59400,"_5":14899,"_28426":59327,"_3090":59401},[],"For CA reissuance failures, check revocation and date: reissuance is not supported for a revoked or already expired CA. For a subordinate CA, also check the status and dates of its parent. To change its key, use Hierarchy and rotation.",{"_3640":2687,"_31229":2659,"_21648":59403,"_5":14899,"_28426":59331,"_3090":59404},[],"Check each boundary independently:",{"_3640":2688,"_31229":2659,"_21648":59406,"_5":14899,"_28426":59331,"_3090":59407},[],"**Record:** read the correct certificate again by serial and issuer. Confirm status, reason and time; expired or permanently revoked records reject further transitions.",{"_3640":2689,"_31229":2659,"_21648":59409,"_5":14899,"_28426":59331,"_3090":59410},[],"**Endpoint:** inspect AIA and CDP. Query those URLs from the consumer’s network; an old route or incorrect issuer can explain a discrepancy.",{"_3640":2690,"_31229":2659,"_21648":59412,"_5":14899,"_28426":59331,"_3090":59413},[],"**OCSP:** save a fresh response, verify signature and timestamps, and observe status. An HTTP error for an absent serial does not mean `Good` or guarantee a signed `Unknown`.",{"_3640":2691,"_31229":2659,"_21648":59415,"_5":14899,"_28426":59331,"_3090":59416},[],"**CRL:** compare `latest_crl`, number and timestamps with the downloaded list. Check the serial in its contents. If unchanged, review `regenerate_on_revoke`, event delivery, jobs, signing and storage with the deployment operator.",{"_3640":2692,"_31229":2659,"_21648":59418,"_5":14899,"_28426":59331,"_3090":59419},[],"**Client:** check cache, policy for expired or unavailable evidence, critical IDP extension and rejection of a new connection.",{"_3640":2693,"_31229":2659,"_21648":59421,"_5":14899,"_28426":59331,"_3090":59422},[],"Reactivation from `CertificateHold` needs a new CRL for the client to stop seeing the hold. A hold cascaded from a CA is lifted by releasing that CA; a cascade from a CA revoked for good is not. Inspect every status and individual operation failure.",{"_3640":2694,"_31229":2659,"_21648":59424,"_5":14899,"_28426":59335,"_3090":59425},[],"Check expected identity, SAN, KU/EKU, matching key, presented intermediates and consumer permissions. Distinguish server TLS trust, client authentication and action authorization. Follow Validation for positive and rejection tests.",{"_3640":2695,"_31229":2659,"_21648":59427,"_5":14899,"_28426":59335,"_3090":59428},[],"When escalating a problem, provide identifiers, error and relevant public evidence, including query timestamps and version. This distinguishes issuance, publication and consumer application failures.",{"_3640":2696,"_31229":2696,"_5":15259,"_3090":59430,"_31567":59431,"_21648":59432,"_28426":2696},"Security",[51054],[],{"_3640":2697,"_31229":2696,"_21648":59434,"_5":14899,"_28426":2696,"_3090":59435},[],"How to report a security vulnerability in Lamassu privately, what to include in a report and which releases receive security fixes.",{"_3640":2698,"_31229":2696,"_5":31564,"_21648":59437,"_28426":59438,"_3090":59439},[],"/docs/security#report-a-vulnerability","Report a vulnerability",{"_3640":2699,"_31229":2696,"_5":31564,"_21648":59441,"_28426":59442,"_3090":59443},[],"/docs/security#what-to-include-in-a-report","What to include in a report",{"_3640":2700,"_31229":2696,"_5":31564,"_21648":59445,"_28426":59446,"_3090":59447},[],"/docs/security#supported-versions","Supported versions",{"_3640":2701,"_31229":2696,"_5":31564,"_21648":59449,"_28426":59450,"_3090":59451},[],"/docs/security#responsible-disclosure","Responsible disclosure",{"_3640":2702,"_31229":2696,"_21648":59453,"_5":14899,"_28426":2696,"_3090":59454},[],"Found a security vulnerability in lamassuiot, lamassu-dashboard, or lamassu-helm? This page explains how to report it privately, what to include in your report and which releases receive security fixes.",{"_3640":2703,"_31229":2696,"_21648":59456,"_5":14899,"_28426":59438,"_3090":59457},[],"Do not report security vulnerabilities through public GitHub issues, discussions, or pull requests. Public reports disclose the problem before maintainers can fix it.",{"_3640":2704,"_31229":2696,"_21648":59459,"_5":14899,"_28426":59438,"_3090":59460},[],"Instead, report privately using GitHub Security Advisories for the affected repository:",{"_3640":2705,"_31229":2696,"_21648":59462,"_5":14899,"_28426":59438,"_3090":15538},[],{"_3640":2706,"_31229":2696,"_21648":59464,"_5":14899,"_28426":59438,"_3090":15467},[],{"_3640":2707,"_31229":2696,"_21648":59466,"_5":14899,"_28426":59438,"_3090":15525},[],{"_3640":2708,"_31229":2696,"_21648":59468,"_5":14899,"_28426":59438,"_3090":59469},[],"This lets maintainers assess and address the issue before it is publicly disclosed.",{"_3640":2709,"_31229":2696,"_21648":59471,"_5":14899,"_28426":59438,"_3090":59472},[],"If private vulnerability reporting is not enabled for that repository, report the vulnerability privately to lamassuiot\\@lksnext.com before disclosing any details publicly.",{"_3640":2710,"_31229":2696,"_21648":59474,"_5":14899,"_28426":59442,"_3090":59475},[],"Describe the vulnerability, its potential impact, and steps to reproduce it using non-sensitive, redacted examples.",{"_3640":2711,"_31229":2696,"_21648":59477,"_5":14899,"_28426":59442,"_3090":59478},[],"Do not include in the report:",{"_3640":2712,"_31229":2696,"_21648":59480,"_5":14899,"_28426":59442,"_3090":59481},[],"Credentials, tokens, or private keys",{"_3640":2713,"_31229":2696,"_21648":59483,"_5":14899,"_28426":59442,"_3090":59484},[],"Customer data or customer-identifiable information",{"_3640":2714,"_31229":2696,"_21648":59486,"_5":14899,"_28426":59442,"_3090":59487},[],"Confidential architecture or internal infrastructure details",{"_3640":2715,"_31229":2696,"_21648":59489,"_5":14899,"_28426":59446,"_3090":59490},[],"Only the latest stable release receives security support. Support for a stable release ends when the next stable release is published. Older releases and pre-releases are not supported.",{"_3640":2716,"_31229":2696,"_21648":59492,"_5":14899,"_28426":59446,"_3090":59493},[],"For upgrade guidance, see Upgrades.",{"_3640":2717,"_31229":2696,"_21648":59495,"_5":14899,"_28426":59450,"_3090":59496},[],"Give maintainers reasonable time to investigate and address a reported vulnerability before any public disclosure.",{"_3640":2718,"_31229":2696,"_21648":59498,"_5":14899,"_28426":59450,"_3090":59499},[],"Avoid privacy violations, data destruction, and service disruption while researching a vulnerability.",{"_3640":2719,"_31229":2696,"_21648":59501,"_5":14899,"_28426":59450,"_3090":59502},[],"Only interact with accounts or data you own, or for which you have explicit permission.",{"_3640":2720,"_31229":2696,"_21648":59504,"_5":14899,"_28426":59450,"_3090":59505},[],"Maintainers acknowledge reports in a timely manner and keep you informed of remediation progress.",{"_3640":2721,"_31229":2696,"_21648":59507,"_5":14899,"_28426":59450,"_3090":59508},[],"This policy covers the source code, configuration, and CI/CD workflows of the lamassuiot, lamassu-dashboard, and lamassu-helm repositories.",{"_3640":2722,"_31229":2722,"_5":15259,"_3090":59510,"_31567":59511,"_21648":59513,"_28426":2722},"3.8.0 to 4.0.0",[51054,59512],"Upgrades",[],{"_3640":2723,"_31229":2722,"_21648":59515,"_5":14899,"_28426":2722,"_3090":59516},[],"What changes in the 4.0.0 architecture, which changes break a 3.8.0 deployment, how to upgrade a Helm release step by step and how to validate the result.",{"_3640":2724,"_31229":2722,"_5":31564,"_21648":59518,"_28426":59519,"_3090":59520},[],"/docs/upgrades/3-8-0-to-4-0-0#architecture-changes","Architecture changes",{"_3640":2725,"_31229":2722,"_5":31564,"_21648":59522,"_28426":59523,"_3090":59524},[],"/docs/upgrades/3-8-0-to-4-0-0#one-postgresql-database-with-schemas","One PostgreSQL database with schemas",{"_3640":2726,"_31229":2722,"_5":31564,"_21648":59526,"_28426":59527,"_3090":59528},[],"/docs/upgrades/3-8-0-to-4-0-0#authorization-moves-into-the-authz-service","Authorization moves into the authz service",{"_3640":2727,"_31229":2722,"_5":31564,"_21648":59530,"_28426":59531,"_3090":59532},[],"/docs/upgrades/3-8-0-to-4-0-0#device-events-get-their-own-store","Device events get their own store",{"_3640":2728,"_31229":2722,"_5":31564,"_21648":59534,"_28426":59535,"_3090":59536},[],"/docs/upgrades/3-8-0-to-4-0-0#a-hardened-helm-chart","A hardened Helm chart",{"_3640":2729,"_31229":2722,"_5":31564,"_21648":59538,"_28426":59539,"_3090":59540},[],"/docs/upgrades/3-8-0-to-4-0-0#what-the-upgrade-migrates-automatically","What the upgrade migrates automatically",{"_3640":2730,"_31229":2722,"_5":31564,"_21648":59542,"_28426":59543,"_3090":59544},[],"/docs/upgrades/3-8-0-to-4-0-0#breaking-changes","Breaking changes",{"_3640":2731,"_31229":2722,"_5":31564,"_21648":59546,"_28426":59547,"_3090":59548},[],"/docs/upgrades/3-8-0-to-4-0-0#helm-chart-and-values","Helm chart and values",{"_3640":2732,"_31229":2722,"_5":31564,"_21648":59550,"_28426":59551,"_3090":59552},[],"/docs/upgrades/3-8-0-to-4-0-0#release-scoped-resource-names","Release-scoped resource names",{"_3640":2733,"_31229":2722,"_5":31564,"_21648":59554,"_28426":59555,"_3090":59556},[],"/docs/upgrades/3-8-0-to-4-0-0#strict-values-validation","Strict values validation",{"_3640":2734,"_31229":2722,"_5":31564,"_21648":59558,"_28426":59559,"_3090":51692},[],"/docs/upgrades/3-8-0-to-4-0-0#credentials-in-kubernetes-secrets",{"_3640":2735,"_31229":2722,"_5":31564,"_21648":59561,"_28426":59562,"_3090":59563},[],"/docs/upgrades/3-8-0-to-4-0-0#required-authorization-configuration","Required authorization configuration",{"_3640":2736,"_31229":2722,"_5":31564,"_21648":59565,"_28426":59566,"_3090":59567},[],"/docs/upgrades/3-8-0-to-4-0-0#gateway-token-validation-removed","Gateway token validation removed",{"_3640":2737,"_31229":2722,"_5":31564,"_21648":59569,"_28426":59570,"_3090":59571},[],"/docs/upgrades/3-8-0-to-4-0-0#non-root-containers","Non-root containers",{"_3640":2738,"_31229":2722,"_5":31564,"_21648":59573,"_28426":59574,"_3090":59575},[],"/docs/upgrades/3-8-0-to-4-0-0#amqp-over-tls","AMQP over TLS",{"_3640":2739,"_31229":2722,"_5":31564,"_21648":59577,"_28426":59578,"_3090":59579},[],"/docs/upgrades/3-8-0-to-4-0-0#renamed-and-reshaped-values","Renamed and reshaped values",{"_3640":2740,"_31229":2722,"_5":31564,"_21648":59581,"_28426":59582,"_3090":59583},[],"/docs/upgrades/3-8-0-to-4-0-0#data-and-storage","Data and storage",{"_3640":2741,"_31229":2722,"_5":31564,"_21648":59585,"_28426":59586,"_3090":59587},[],"/docs/upgrades/3-8-0-to-4-0-0#postgresql-consolidation","PostgreSQL consolidation",{"_3640":2742,"_31229":2722,"_5":31564,"_21648":59589,"_28426":59590,"_3090":59591},[],"/docs/upgrades/3-8-0-to-4-0-0#sqlite-storage-removed","SQLite storage removed",{"_3640":2743,"_31229":2722,"_5":31564,"_21648":59593,"_28426":59594,"_3090":59595},[],"/docs/upgrades/3-8-0-to-4-0-0#legacy-ca-keys-in-the-kms","Legacy CA keys in the KMS",{"_3640":2744,"_31229":2722,"_5":31564,"_21648":59597,"_28426":59598,"_3090":59599},[],"/docs/upgrades/3-8-0-to-4-0-0#references-between-certificates-keys-and-crl-settings","References between certificates, keys and CRL settings",{"_3640":2745,"_31229":2722,"_5":31564,"_21648":59601,"_28426":59602,"_3090":59603},[],"/docs/upgrades/3-8-0-to-4-0-0#apis-and-stored-configuration","APIs and stored configuration",{"_3640":2746,"_31229":2722,"_5":31564,"_21648":59605,"_28426":59606,"_3090":59607},[],"/docs/upgrades/3-8-0-to-4-0-0#dms-webhooks","DMS webhooks",{"_3640":2747,"_31229":2722,"_5":31564,"_21648":59609,"_28426":59610,"_3090":59611},[],"/docs/upgrades/3-8-0-to-4-0-0#re-enrollment-trust-set","Re-enrollment trust set",{"_3640":2748,"_31229":2722,"_5":31564,"_21648":59613,"_28426":59614,"_3090":59615},[],"/docs/upgrades/3-8-0-to-4-0-0#fail-closed-revocation-checks","Fail-closed revocation checks",{"_3640":2749,"_31229":2722,"_5":31564,"_21648":59617,"_28426":59618,"_3090":59619},[],"/docs/upgrades/3-8-0-to-4-0-0#independent-re-enrollment-authentication","Independent re-enrollment authentication",{"_3640":2750,"_31229":2722,"_5":31564,"_21648":59621,"_28426":59622,"_3090":59623},[],"/docs/upgrades/3-8-0-to-4-0-0#dms-update-api","DMS update API",{"_3640":2751,"_31229":2722,"_5":31564,"_21648":59625,"_28426":59626,"_3090":59627},[],"/docs/upgrades/3-8-0-to-4-0-0#certificate-type-values","Certificate type values",{"_3640":2752,"_31229":2722,"_5":31564,"_21648":59629,"_28426":59630,"_3090":59631},[],"/docs/upgrades/3-8-0-to-4-0-0#device-events","Device events",{"_3640":2753,"_31229":2722,"_5":31564,"_21648":59633,"_28426":59634,"_3090":59635},[],"/docs/upgrades/3-8-0-to-4-0-0#crl-signer-field","CRL signer field",{"_3640":2754,"_31229":2722,"_5":31564,"_21648":59637,"_28426":59638,"_3090":59639},[],"/docs/upgrades/3-8-0-to-4-0-0#crl-settings-keyed-by-ca-id","CRL settings keyed by CA ID",{"_3640":2755,"_31229":2722,"_5":31564,"_21648":59641,"_28426":59642,"_3090":59643},[],"/docs/upgrades/3-8-0-to-4-0-0#renamed-va-events","Renamed VA events",{"_3640":2756,"_31229":2722,"_5":31564,"_21648":59645,"_28426":59646,"_3090":59647},[],"/docs/upgrades/3-8-0-to-4-0-0#ca-signature-endpoints-removed","CA signature endpoints removed",{"_3640":2757,"_31229":2722,"_5":31564,"_21648":59649,"_28426":59650,"_3090":59651},[],"/docs/upgrades/3-8-0-to-4-0-0#ca-ids-are-always-assigned-by-the-backend","CA IDs are always assigned by the backend",{"_3640":2758,"_31229":2722,"_5":31564,"_21648":59653,"_28426":59654,"_3090":59647},[],"/docs/upgrades/3-8-0-to-4-0-0#ca-signature-endpoints-removed-1",{"_3640":2759,"_31229":2722,"_5":31564,"_21648":59656,"_28426":59657,"_3090":59658},[],"/docs/upgrades/3-8-0-to-4-0-0#va-crl-signer","VA CRL signer",{"_3640":2760,"_31229":2722,"_5":31564,"_21648":59660,"_28426":59661,"_3090":59662},[],"/docs/upgrades/3-8-0-to-4-0-0#helm-migration-guide","Helm migration guide",{"_3640":2761,"_31229":2722,"_5":31564,"_21648":59664,"_28426":59665,"_3090":59666},[],"/docs/upgrades/3-8-0-to-4-0-0#step-1-prepare","Step 1: Prepare",{"_3640":2762,"_31229":2722,"_5":31564,"_21648":59668,"_28426":59669,"_3090":59670},[],"/docs/upgrades/3-8-0-to-4-0-0#pre-upgrade-check","Pre-upgrade check",{"_3640":2763,"_31229":2722,"_5":31564,"_21648":59672,"_28426":59673,"_3090":59674},[],"/docs/upgrades/3-8-0-to-4-0-0#step-2-update-the-values-file","Step 2: Update the values file",{"_3640":2764,"_31229":2722,"_5":31564,"_21648":59676,"_28426":59677,"_3090":59678},[],"/docs/upgrades/3-8-0-to-4-0-0#step-3-run-the-upgrade","Step 3: Run the upgrade",{"_3640":2765,"_31229":2722,"_5":31564,"_21648":59680,"_28426":59681,"_3090":59682},[],"/docs/upgrades/3-8-0-to-4-0-0#step-4-migrate-the-kms-and-va-data","Step 4: Migrate the KMS and VA data",{"_3640":2766,"_31229":2722,"_5":31564,"_21648":59684,"_28426":59685,"_3090":59686},[],"/docs/upgrades/3-8-0-to-4-0-0#step-5-remove-the-one-off-migration-values","Step 5: Remove the one-off migration values",{"_3640":2767,"_31229":2722,"_5":31564,"_21648":59688,"_28426":59689,"_3090":59690},[],"/docs/upgrades/3-8-0-to-4-0-0#deployments-without-helm","Deployments without Helm",{"_3640":2768,"_31229":2722,"_5":31564,"_21648":59692,"_28426":59693,"_3090":55337},[],"/docs/upgrades/3-8-0-to-4-0-0#troubleshooting",{"_3640":2769,"_31229":2722,"_5":31564,"_21648":59695,"_28426":59696,"_3090":59697},[],"/docs/upgrades/3-8-0-to-4-0-0#validation-checklist","Validation checklist",{"_3640":2770,"_31229":2722,"_5":31564,"_21648":59699,"_28426":59700,"_3090":59701},[],"/docs/upgrades/3-8-0-to-4-0-0#delete-the-old-volumes","Delete the old volumes",{"_3640":2771,"_31229":2722,"_21648":59703,"_5":14899,"_28426":2722,"_3090":59704},[],"Lamassu 4.0.0 is a major release. Storage consolidates into a single PostgreSQL database, a new `authz` service authorizes every request, the Helm chart is hardened, and several APIs and stored configurations change shape. Most data converts automatically during the upgrade, but some changes need operator action before, during or after it.",{"_3640":2772,"_31229":2722,"_21648":59706,"_5":14899,"_28426":2722,"_3090":59707},[],"This page is organized in four parts. Read them in order before you upgrade production:",{"_3640":2773,"_31229":2722,"_21648":59709,"_5":14899,"_28426":2722,"_3090":59710},[],"Architecture changes: what is different in 4.0.0 and what the upgrade migrates on its own.",{"_3640":2774,"_31229":2722,"_21648":59712,"_5":14899,"_28426":2722,"_3090":59713},[],"Breaking changes: every change that can break a 3.8.0 deployment, who it affects and what to do.",{"_3640":2775,"_31229":2722,"_21648":59715,"_5":14899,"_28426":2722,"_3090":59716},[],"Helm migration guide: the step-by-step procedure for a Helm-managed release.",{"_3640":2776,"_31229":2722,"_21648":59718,"_5":14899,"_28426":2722,"_3090":59719},[],"Validation checklist: how to confirm the upgrade worked before you remove the old data.",{"_3640":2777,"_31229":2722,"_21648":59721,"_5":14899,"_28426":2722,"_3090":59722},[],"The 4.0.0 release is upcoming and the backend migration steps on this page are provisional. Verify each procedure against the final release artifacts before upgrading production.",{"_3640":2778,"_31229":2722,"_21648":59724,"_5":14899,"_28426":59523,"_3090":59725},[],"3.8.0 gave each service its own database. The 4.0.0 backend connects to a single PostgreSQL database named `pki` and isolates each service in a schema: `kms`, `ca`, `va`, `devicemanager`, `dmsmanager` and `alerts`. The `authz` service keeps its principals, grants and policies in a separate `authz` database (the development monolith uses an `authz` schema inside `pki` instead), and WFX keeps its own `wfx` database.",{"_3640":2779,"_31229":2722,"_21648":59727,"_5":14899,"_28426":59523,"_3090":59728},[],"PostgreSQL is now the only storage engine. SQLite support is removed, and the `couch_db` and `dynamo_db` engines are not registered in 4.0.0.",{"_3640":2780,"_31229":2722,"_21648":59730,"_5":14899,"_28426":59527,"_3090":59731},[],"In 3.8.0 the API Gateway validated tokens: a JWT policy on every private route checked the signature and only let through tokens that carried the administrator role. Every route was open to any token that passed that check.",{"_3640":2781,"_31229":2722,"_21648":59733,"_5":14899,"_28426":59527,"_3090":59734},[],"4.0.0 removes the gateway policy. The `/api/*` routes reach the services directly, and each service authorizes every request through `authz`, which validates the token against the identity provider's JWKS endpoint and applies fine-grained, entity-level policies to CAs, certificates, devices, DMSs, KMS keys and CRL settings. There is no implicit superuser: the first administrator comes from a bootstrap principal that you configure. The access control page documents principals, policies and the first administrator.",{"_3640":2782,"_31229":2722,"_21648":59736,"_5":14899,"_28426":59531,"_3090":59737},[],"Historical device events move from the `devices.events` column to a dedicated `device_events` store with their own endpoints. The events endpoint can also stream events over Server-Sent Events (SSE); to fan events out across service instances, each Device Manager instance binds its own durable AMQP queue.",{"_3640":2783,"_31229":2722,"_21648":59739,"_5":14899,"_28426":59535,"_3090":59740},[],"Version 4.0.0 of the chart is a security-hardening release:",{"_3640":2784,"_31229":2722,"_21648":59742,"_5":14899,"_28426":59535,"_3090":59743},[],"**Release-scoped resource names.** Every chart-managed resource is named `<release>-lamassu-<component>` instead of the fixed names used in 3.8.0 (`kms`, `va`, `ca`, ...). With a release named `prod` the StatefulSets become `prod-lamassu-kms` and `prod-lamassu-va`. The `nameOverride` and `fullnameOverride` values change the prefix.",{"_3640":2785,"_31229":2722,"_21648":59745,"_5":14899,"_28426":59535,"_3090":59746},[],"**Non-root containers.** Every workload runs as the numeric user `65532:65532` with a `RuntimeDefault` seccomp profile and dropped capabilities. Pods do not mount the service-account token by default, and the chart creates a dedicated ServiceAccount.",{"_3640":2786,"_31229":2722,"_21648":59748,"_5":14899,"_28426":59535,"_3090":59749},[],"**Strict values validation.** `values.schema.json` rejects unknown keys, so leftover 3.8.0 blocks fail `helm lint` and `helm upgrade` instead of being silently ignored.",{"_3640":2787,"_31229":2722,"_21648":59751,"_5":14899,"_28426":59535,"_3090":59752},[],"**No injected scheduling rules.** The chart no longer adds pod anti-affinity or topology spread constraints on its own.",{"_3640":2788,"_31229":2722,"_21648":59754,"_5":14899,"_28426":59539,"_3090":59755},[],"Several migrations run without intervention when you upgrade a Helm release:",{"_3640":2789,"_31229":2722,"_21648":59757,"_5":14899,"_28426":59539,"_3090":59758},[],"Before any service starts, the chart's pre-install/pre-upgrade job prepares PostgreSQL. It creates the `pki`, `authz` and `wfx` databases when they do not exist, creates one schema per service inside `pki`, and imports each 3.8.0 per-service database into its schema. Each import runs as a single transaction, so a failed import leaves no partial schema and a retried job imports again. The job then runs the database migrations for every schema, migrates `authz`, preloads its policies and seeds the `services.authz.bootstrap` principals. It is idempotent and requires a PostgreSQL role allowed to create databases and schemas, as described in Install with Helm.",{"_3640":2790,"_31229":2722,"_21648":59760,"_5":14899,"_28426":59539,"_3090":59761},[],"Stored DMS configuration is rewritten to the 4.0.0 layout, and historical device events are transformed into the new store.",{"_3640":2791,"_31229":2722,"_21648":59763,"_5":14899,"_28426":59539,"_3090":59764},[],"The KMS migration removes the stale `lamassu.io/kms/binded-resources` key metadata, and the VA migration resolves each role's CRL signer (see VA CRL signer).",{"_3640":2792,"_31229":2722,"_21648":59766,"_5":14899,"_28426":59539,"_3090":59767},[],"When `migrations.caToKms.enabled` is set, a pre-upgrade hook registers legacy CA keys in the KMS.",{"_3640":2793,"_31229":2722,"_21648":59769,"_5":14899,"_28426":59539,"_3090":59770},[],"Two things never migrate on their own: the KMS and VA data on local volumes, which stays on volumes the upgraded pods no longer use, and the values file, which you update by hand. Deployments that do not use the Helm chart also have to move their database data themselves; see Deployments without Helm.",{"_3640":2794,"_31229":2722,"_21648":59772,"_5":14899,"_28426":59543,"_3090":59773},[],"Change",{"_3640":2795,"_31229":2722,"_21648":59775,"_5":14899,"_28426":59543,"_3090":59776},[],"Who is affected",{"_3640":2796,"_31229":2722,"_21648":59778,"_5":14899,"_28426":59543,"_3090":59779},[],"Severity",{"_3640":2797,"_31229":2722,"_21648":59781,"_5":14899,"_28426":59543,"_3090":58232},[],{"_3640":2798,"_31229":2722,"_21648":59783,"_5":14899,"_28426":59543,"_3090":59552},[],{"_3640":2799,"_31229":2722,"_21648":59785,"_5":14899,"_28426":59543,"_3090":59786},[],"Helm releases with a filesystem KMS engine or local VA CRL storage",{"_3640":2800,"_31229":2722,"_21648":59788,"_5":14899,"_28426":59543,"_3090":59789},[],"High: KMS and VA start on empty volumes",{"_3640":2801,"_31229":2722,"_21648":59791,"_5":14899,"_28426":59543,"_3090":59792},[],"Copy the data into the new volumes",{"_3640":2802,"_31229":2722,"_21648":59794,"_5":14899,"_28426":59543,"_3090":59556},[],{"_3640":2803,"_31229":2722,"_21648":59796,"_5":14899,"_28426":59543,"_3090":59797},[],"Every Helm release",{"_3640":2804,"_31229":2722,"_21648":59799,"_5":14899,"_28426":59543,"_3090":59800},[],"High: `helm upgrade` fails",{"_3640":2805,"_31229":2722,"_21648":59802,"_5":14899,"_28426":59543,"_3090":59803},[],"Remove or rename legacy keys",{"_3640":2806,"_31229":2722,"_21648":59805,"_5":14899,"_28426":59543,"_3090":51692},[],{"_3640":2807,"_31229":2722,"_21648":59807,"_5":14899,"_28426":59543,"_3090":59797},[],{"_3640":2808,"_31229":2722,"_21648":59809,"_5":14899,"_28426":59543,"_3090":59810},[],"High: `helm upgrade` fails on inline credentials",{"_3640":2809,"_31229":2722,"_21648":59812,"_5":14899,"_28426":59543,"_3090":59813},[],"Create the Secrets first; see Step 2",{"_3640":2810,"_31229":2722,"_21648":59815,"_5":14899,"_28426":59543,"_3090":59563},[],{"_3640":2811,"_31229":2722,"_21648":59817,"_5":14899,"_28426":59543,"_3090":59818},[],"Every deployment",{"_3640":2812,"_31229":2722,"_21648":59820,"_5":14899,"_28426":59543,"_3090":59821},[],"High: without a bootstrap principal there is no administrator",{"_3640":2813,"_31229":2722,"_21648":59823,"_5":14899,"_28426":59543,"_3090":59824},[],"Configure `services.authz`",{"_3640":2814,"_31229":2722,"_21648":59826,"_5":14899,"_28426":59543,"_3090":59567},[],{"_3640":2815,"_31229":2722,"_21648":59828,"_5":14899,"_28426":59543,"_3090":59797},[],{"_3640":2816,"_31229":2722,"_21648":59830,"_5":14899,"_28426":59543,"_3090":59831},[],"High: `helm upgrade` fails on the old keys",{"_3640":2817,"_31229":2722,"_21648":59833,"_5":14899,"_28426":59543,"_3090":59834},[],"Move JWKS and roles into `services.authz`",{"_3640":2818,"_31229":2722,"_21648":59836,"_5":14899,"_28426":59543,"_3090":59587},[],{"_3640":2819,"_31229":2722,"_21648":59838,"_5":14899,"_28426":59543,"_3090":59839},[],"3.8.0 deployments with per-service databases",{"_3640":2820,"_31229":2722,"_21648":59841,"_5":14899,"_28426":59543,"_3090":59842},[],"High: services find no data, or a migration aborts",{"_3640":2821,"_31229":2722,"_21648":59844,"_5":14899,"_28426":59543,"_3090":59845},[],"Clean duplicate CA IDs and empty `engine_id` values first; move data manually outside Helm",{"_3640":2822,"_31229":2722,"_21648":59847,"_5":14899,"_28426":59543,"_3090":59591},[],{"_3640":2823,"_31229":2722,"_21648":59849,"_5":14899,"_28426":59543,"_3090":59850},[],"Deployments on SQLite, `couch_db` or `dynamo_db`",{"_3640":2824,"_31229":2722,"_21648":59852,"_5":14899,"_28426":59543,"_3090":59853},[],"High: the backend no longer starts with them",{"_3640":2825,"_31229":2722,"_21648":59855,"_5":14899,"_28426":59543,"_3090":59856},[],"Move to PostgreSQL before upgrading",{"_3640":2826,"_31229":2722,"_21648":59858,"_5":14899,"_28426":59543,"_3090":59639},[],{"_3640":2827,"_31229":2722,"_21648":59860,"_5":14899,"_28426":59543,"_3090":59861},[],"Every deployment; API clients, custom policies and alert subscriptions are also affected",{"_3640":2828,"_31229":2722,"_21648":59863,"_5":14899,"_28426":59543,"_3090":59864},[],"High: the `/v1/roles` routes are removed and the migration is irreversible",{"_3640":2829,"_31229":2722,"_21648":59866,"_5":14899,"_28426":59543,"_3090":59867},[],"Fix the data the migration aborts on, and back up the database and the CRL bucket",{"_3640":2830,"_31229":2722,"_21648":59869,"_5":14899,"_28426":59543,"_3090":59870},[],"Webhooks with file references",{"_3640":2831,"_31229":2722,"_21648":59872,"_5":14899,"_28426":59543,"_3090":59873},[],"DMSs whose webhook mTLS certificate or key were file paths",{"_3640":2832,"_31229":2722,"_21648":59875,"_5":14899,"_28426":59543,"_3090":59876},[],"High: enrollments calling the webhook fail",{"_3640":2833,"_31229":2722,"_21648":59878,"_5":14899,"_28426":59543,"_3090":59879},[],"Re-enter certificate and key as PEM, or remove the file fields",{"_3640":2834,"_31229":2722,"_21648":59881,"_5":14899,"_28426":59543,"_3090":59571},[],{"_3640":2835,"_31229":2722,"_21648":59883,"_5":14899,"_28426":59543,"_3090":59884},[],"Releases with per-service identity overrides or mounted key material",{"_3640":2836,"_31229":2722,"_21648":59886,"_5":14899,"_28426":59543,"_3090":59887},[],"Medium: services cannot read their files",{"_3640":2837,"_31229":2722,"_21648":59889,"_5":14899,"_28426":59543,"_3090":59890},[],"Remove the overrides and fix volume ownership",{"_3640":2838,"_31229":2722,"_21648":59892,"_5":14899,"_28426":59543,"_3090":59575},[],{"_3640":2839,"_31229":2722,"_21648":59894,"_5":14899,"_28426":59543,"_3090":59895},[],"Releases that set `amqp.tls`",{"_3640":2840,"_31229":2722,"_21648":59897,"_5":14899,"_28426":59543,"_3090":59898},[],"Medium: clients connect to the wrong port",{"_3640":2841,"_31229":2722,"_21648":59900,"_5":14899,"_28426":59543,"_3090":59901},[],"Point `amqp.port` at the TLS listener, or disable TLS",{"_3640":2842,"_31229":2722,"_21648":59903,"_5":14899,"_28426":59543,"_3090":59595},[],{"_3640":2843,"_31229":2722,"_21648":59905,"_5":14899,"_28426":59543,"_3090":59906},[],"Installations whose CA keys predate the KMS",{"_3640":2844,"_31229":2722,"_21648":59908,"_5":14899,"_28426":59543,"_3090":59909},[],"Medium: CA keys stay unmanaged",{"_3640":2845,"_31229":2722,"_21648":59911,"_5":14899,"_28426":59543,"_3090":59912},[],"Run the CA-to-KMS migration",{"_3640":2846,"_31229":2722,"_21648":59914,"_5":14899,"_28426":59543,"_3090":59915},[],"Receiver certificate verification",{"_3640":2847,"_31229":2722,"_21648":59917,"_5":14899,"_28426":59543,"_3090":59918},[],"DMSs whose webhook had `validate_server_cert: false`",{"_3640":2848,"_31229":2722,"_21648":59920,"_5":14899,"_28426":59543,"_3090":59921},[],"Medium: credentials go to an unverified receiver",{"_3640":2849,"_31229":2722,"_21648":59923,"_5":14899,"_28426":59543,"_3090":59924},[],"Set `insecure_skip_verify` to `false`",{"_3640":2850,"_31229":2722,"_21648":59926,"_5":14899,"_28426":59543,"_3090":59611},[],{"_3640":2851,"_31229":2722,"_21648":59928,"_5":14899,"_28426":59543,"_3090":59929},[],"Scripts and consoles that edit DMSs through the API",{"_3640":2852,"_31229":2722,"_21648":59931,"_5":14899,"_28426":59543,"_3090":59932},[],"Medium: an old-layout edit silently empties `validation_cas`",{"_3640":2853,"_31229":2722,"_21648":59934,"_5":14899,"_28426":59543,"_3090":59935},[],"Read the DMS before editing and use the new field",{"_3640":2854,"_31229":2722,"_21648":59937,"_5":14899,"_28426":59543,"_3090":59615},[],{"_3640":2855,"_31229":2722,"_21648":59939,"_5":14899,"_28426":59543,"_3090":59940},[],"Every deployment with devices presenting certificates not managed by Lamassu",{"_3640":2856,"_31229":2722,"_21648":59942,"_5":14899,"_28426":59543,"_3090":59943},[],"Medium: enrollment or re-enrollment of those devices fails",{"_3640":2857,"_31229":2722,"_21648":59945,"_5":14899,"_28426":59543,"_3090":59946},[],"Set `allow_unverifiable_revocation` to `true` in the affected DMS blocks, or make sure the certificates carry reachable OCSP/CRL distribution points",{"_3640":2858,"_31229":2722,"_21648":59948,"_5":14899,"_28426":59543,"_3090":59635},[],{"_3640":2859,"_31229":2722,"_21648":59950,"_5":14899,"_28426":59543,"_3090":59951},[],"Clients that create or update CRL settings through the API",{"_3640":2860,"_31229":2722,"_21648":59953,"_5":14899,"_28426":59543,"_3090":59954},[],"Medium: requests with the old field return an error",{"_3640":2861,"_31229":2722,"_21648":59956,"_5":14899,"_28426":59543,"_3090":59957},[],"Replace `crl_options.subject_key_id_signer` with the required `crl_options.signer_serial_number`",{"_3640":2862,"_31229":2722,"_21648":59959,"_5":14899,"_28426":59543,"_3090":59643},[],{"_3640":2863,"_31229":2722,"_21648":59961,"_5":14899,"_28426":59543,"_3090":59962},[],"Alert subscriptions and consumers of the VA events",{"_3640":2864,"_31229":2722,"_21648":59964,"_5":14899,"_28426":59543,"_3090":59965},[],"Medium: subscription types are renamed automatically, their conditions are not",{"_3640":2865,"_31229":2722,"_21648":59967,"_5":14899,"_28426":59543,"_3090":59968},[],"Review conditions filtering on the old event payload or subject",{"_3640":2866,"_31229":2722,"_21648":59970,"_5":14899,"_28426":59543,"_3090":59647},[],{"_3640":2867,"_31229":2722,"_21648":59972,"_5":14899,"_28426":59543,"_3090":59973},[],"Clients that sign or verify arbitrary data through the CA API or the Go SDK, and alert subscriptions on the `ca.sign.signature` event",{"_3640":2868,"_31229":2722,"_21648":59975,"_5":14899,"_28426":59543,"_3090":59976},[],"Medium: the endpoints, the SDK methods and the event no longer exist",{"_3640":2869,"_31229":2722,"_21648":59978,"_5":14899,"_28426":59543,"_3090":59979},[],"Sign and verify with KMS keys instead; remove subscriptions on the event",{"_3640":2870,"_31229":2722,"_21648":59981,"_5":14899,"_28426":59543,"_3090":59631},[],{"_3640":2871,"_31229":2722,"_21648":59983,"_5":14899,"_28426":59543,"_3090":59984},[],"Consumers that read the device `events` field",{"_3640":2872,"_31229":2722,"_21648":59986,"_5":14899,"_28426":59543,"_3090":59987},[],"Medium: the field disappears",{"_3640":2873,"_31229":2722,"_21648":59989,"_5":14899,"_28426":59543,"_3090":59990},[],"Use the new event endpoints",{"_3640":2874,"_31229":2722,"_21648":59992,"_5":14899,"_28426":59543,"_3090":59658},[],{"_3640":2875,"_31229":2722,"_21648":59994,"_5":14899,"_28426":59543,"_3090":59995},[],"Deployments with VA roles whose signer cannot be resolved uniquely",{"_3640":2876,"_31229":2722,"_21648":59997,"_5":14899,"_28426":59543,"_3090":59998},[],"Medium: the VA migration aborts",{"_3640":2877,"_31229":2722,"_21648":60000,"_5":14899,"_28426":59543,"_3090":60001},[],"Fix the affected roles before upgrading",{"_3640":2878,"_31229":2722,"_21648":60003,"_5":14899,"_28426":59543,"_3090":59579},[],{"_3640":2879,"_31229":2722,"_21648":60005,"_5":14899,"_28426":59543,"_3090":60006},[],"Releases that override `toolbox`, `services.connectors`, ports, probes or scheduling",{"_3640":2880,"_31229":2722,"_21648":60008,"_5":14899,"_28426":59543,"_3090":60009},[],"Low to medium: validation errors or changed defaults",{"_3640":2881,"_31229":2722,"_21648":60011,"_5":14899,"_28426":59543,"_3090":60012},[],"Update the values file",{"_3640":2882,"_31229":2722,"_21648":60014,"_5":14899,"_28426":59543,"_3090":59623},[],{"_3640":2883,"_31229":2722,"_21648":60016,"_5":14899,"_28426":59543,"_3090":60017},[],"Clients that send the DMS ID in the update body",{"_3640":2884,"_31229":2722,"_21648":60019,"_5":14899,"_28426":59543,"_3090":60020},[],"Low: the ID in the URL wins",{"_3640":2885,"_31229":2722,"_21648":60022,"_5":14899,"_28426":59543,"_3090":60023},[],"Send the ID in the URL",{"_3640":2886,"_31229":2722,"_21648":60025,"_5":14899,"_28426":59543,"_3090":59651},[],{"_3640":2887,"_31229":2722,"_21648":60027,"_5":14899,"_28426":59543,"_3090":60028},[],"Clients that send an `id` when creating or importing CAs",{"_3640":2888,"_31229":2722,"_21648":60030,"_5":14899,"_28426":59543,"_3090":60031},[],"Low: the ID in the body is ignored, and the field is removed",{"_3640":2889,"_31229":2722,"_21648":60033,"_5":14899,"_28426":59543,"_3090":60034},[],"Let the backend assign the ID and use the returned one",{"_3640":2890,"_31229":2722,"_21648":60036,"_5":14899,"_28426":59543,"_3090":59647},[],{"_3640":2891,"_31229":2722,"_21648":60038,"_5":14899,"_28426":59543,"_3090":60039},[],"API and SDK clients that call `/v1/cas/{id}/signature/sign` or `/verify`, and alert subscriptions on `ca.sign.signature`",{"_3640":2892,"_31229":2722,"_21648":60041,"_5":14899,"_28426":59543,"_3090":60042},[],"Medium: the calls return `404` and the subscriptions never fire",{"_3640":2893,"_31229":2722,"_21648":60044,"_5":14899,"_28426":59543,"_3090":60045},[],"Use the KMS `sign` and `verify` operations",{"_3640":2894,"_31229":2722,"_21648":60047,"_5":14899,"_28426":59543,"_3090":59627},[],{"_3640":2895,"_31229":2722,"_21648":60049,"_5":14899,"_28426":59543,"_3090":60050},[],"Consumers that match on certificate `type`",{"_3640":2896,"_31229":2722,"_21648":60052,"_5":14899,"_28426":59543,"_3090":60053},[],"Low: two values are renamed",{"_3640":2897,"_31229":2722,"_21648":60055,"_5":14899,"_28426":59543,"_3090":60056},[],"Adapt consumers",{"_3640":2898,"_31229":2722,"_21648":60058,"_5":14899,"_28426":59543,"_3090":59619},[],{"_3640":2899,"_31229":2722,"_21648":60060,"_5":14899,"_28426":59543,"_3090":60061},[],"Any DMS",{"_3640":2900,"_31229":2722,"_21648":60063,"_5":14899,"_28426":59543,"_3090":60064},[],"Low: informational",{"_3640":2901,"_31229":2722,"_21648":60066,"_5":14899,"_28426":59543,"_3090":60067},[],"Read both blocks before editing",{"_3640":2902,"_31229":2722,"_21648":60069,"_5":14899,"_28426":59551,"_3090":60070},[],"Kubernetes derives a StatefulSet's PVC name from its pod name (`<volumeClaimTemplate>-<pod-name>`). Renaming the `kms` and `va` StatefulSets means `helm upgrade` binds brand-new, empty PVCs instead of the existing ones. The KMS key material and VA CRLs are not deleted — the old PVCs are orphaned, not removed — but the upgraded pods fail with `no such file or directory` (KMS) or `code=NotFound` (VA) until you copy the data across. This affects KMS when `services.kms.cryptoEngines` uses a `filesystem` engine and VA when `services.va.fileStore.type` is `local`. Every other renamed resource is stateless and is recreated without data-loss risk.",{"_3640":2903,"_31229":2722,"_21648":60072,"_5":14899,"_28426":59551,"_3090":60073},[],"Step 4 of the migration guide copies the data.",{"_3640":2904,"_31229":2722,"_21648":60075,"_5":14899,"_28426":59555,"_3090":60076},[],"`values.schema.json` rejects unknown keys, so every block that 4.0.0 removed or renamed — `toolbox`, `auth.oidc.apiGateway`, `auth.authorization` and others — fails `helm lint` and `helm upgrade` outright. Step 2 lists every change.",{"_3640":2905,"_31229":2722,"_21648":60078,"_5":14899,"_28426":59559,"_3090":60079},[],"In 4.0.0 the chart reads PostgreSQL, AMQP and SMTP credentials from Kubernetes Secrets in the release namespace instead of inline values: `postgres.existingSecret`, `amqp.existingSecret` and — when SMTP authentication is configured — `services.alerts.smtp_server.existingSecret`, each with `usernameKey` and `passwordKey` naming the Secret data keys. The inline `postgres.username`/`postgres.password` and `amqp.username`/`amqp.password` values are removed and rejected by `values.schema.json`, so a 3.8.0 values file fails `helm lint` and `helm upgrade` until the credentials move into Secrets.",{"_3640":2906,"_31229":2722,"_21648":60081,"_5":14899,"_28426":59559,"_3090":60082},[],"The Secrets must exist before `helm upgrade` runs: the pre-upgrade database job connects to PostgreSQL with them. Step 2 creates them through the External Secrets Operator.",{"_3640":2907,"_31229":2722,"_21648":60084,"_5":14899,"_28426":59562,"_3090":60085},[],"3.8.0 had no authorization service, so a 3.8.0 values file has nothing to migrate from: you must add the `services.authz` configuration yourself. It needs the JWKS endpoint of your identity provider, the database mappings the authorization engine uses, and a bootstrap principal that matches how your provider assigns the administrator role. Without a matching principal nobody can administer the PKI.",{"_3640":2908,"_31229":2722,"_21648":60087,"_5":14899,"_28426":59566,"_3090":60088},[],"`auth.oidc.apiGateway.jwks`, `auth.authorization.rolesClaim` and `auth.authorization.roles.admin` are removed with no compatibility aliases, and the schema rejects them. Their settings move into `services.authz`: the JWKS URL becomes `services.authz.jwkUrl`, and the role claim and administrator role become a claim rule of the bootstrap principal. `auth.oidc.frontend` is unchanged.",{"_3640":2909,"_31229":2722,"_21648":60090,"_5":14899,"_28426":59570,"_3090":60091},[],"Service images run on a distroless base as the numeric user `65532`; the `authz` image is Ubuntu with a non-root user that has the same UID. The per-service overrides `services.kms.securityContext.runAsGroup: 0` and `services.authz.securityContext.runAsUser`/`runAsGroup: 999` are removed; group access to the KMS volume and PKCS#11 socket is now handled by the pod-level `fsGroup: 65532`.",{"_3640":2910,"_31229":2722,"_21648":60093,"_5":14899,"_28426":59570,"_3090":60094},[],"3.8.0 did not pin a container identity, so existing files can carry any UID. Any volume that holds keys or CRLs must be owned by `65532:65532`, or at least readable (and, where needed, writable) by that identity.",{"_3640":2911,"_31229":2722,"_21648":60096,"_5":14899,"_28426":59570,"_3090":60097},[],"Pods now carry a pod-level `fsGroup: 65532` with `fsGroupChangePolicy: OnRootMismatch`, which skips recursive ownership changes when the volume root already has the expected group. If your backup helpers or jobs run with a different GID, verify they can still access the volumes they need.",{"_3640":2912,"_31229":2722,"_21648":60099,"_5":14899,"_28426":59574,"_3090":60100},[],"In 3.8.0 `amqp.tls` was not applied and event-bus clients always connected over plaintext. In 4.0.0 `amqp.tls: true` switches them to AMQPS. The default `amqp.port` stays `5672` and does not change when TLS is enabled, so a values file that already set `amqp.tls: true` must point `amqp.port` at the broker's TLS listener (`amqps`, commonly `5671`), or set `amqp.tls: false` to keep plaintext. Clients must also trust the broker's certificate.",{"_3640":2913,"_31229":2722,"_21648":60102,"_5":14899,"_28426":59578,"_3090":60103},[],"`toolbox` is renamed to `connectivityTest`, and the `helm test` hook uses the upstream `curlimages/curl` image pinned by digest.",{"_3640":2914,"_31229":2722,"_21648":60105,"_5":14899,"_28426":59578,"_3090":60106},[],"`services.connectors` is a map keyed by connector ID instead of a list.",{"_3640":2915,"_31229":2722,"_21648":60108,"_5":14899,"_28426":59578,"_3090":60109},[],"The `services.ui.port` default is `8085`, the unprivileged port of the rootless image.",{"_3640":2916,"_31229":2722,"_21648":60111,"_5":14899,"_28426":59578,"_3090":60112},[],"The shared `probes:` block is replaced by independent `livenessProbe`, `readinessProbe` and `startupProbe` blocks.",{"_3640":2917,"_31229":2722,"_21648":60114,"_5":14899,"_28426":59578,"_3090":60115},[],"With `tls.certManagerOptions.issuer` empty, the chart creates a release-scoped self-signed issuer, for example `lamassu-downstream-ca-selfsigned-issuer`. The legacy literal `downstream-ca-selfsigned-issuer` is still accepted and resolves to it.",{"_3640":2918,"_31229":2722,"_21648":60117,"_5":14899,"_28426":59578,"_3090":60118},[],"Anti-affinity and topology spread must be configured explicitly through `affinity` and `topologySpreadConstraints`.",{"_3640":2919,"_31229":2722,"_21648":60120,"_5":14899,"_28426":59586,"_3090":60121},[],"Every 3.8.0 per-service database must end up as a schema of `pki`, keeping its structure, indexes, constraints, data and migration history. The Helm chart does this automatically; deployments without Helm do it by hand (see Deployments without Helm).",{"_3640":2920,"_31229":2722,"_21648":60123,"_5":14899,"_28426":59586,"_3090":60124},[],"Two schema migrations abort on data that 3.8.0 allowed, so clean the data before upgrading:",{"_3640":2921,"_31229":2722,"_21648":60126,"_5":14899,"_28426":59586,"_3090":60127},[],"The CA migration adds a UNIQUE constraint on `ca_certificates.id` and aborts if duplicate CA IDs exist. Imports already reject duplicates with `409`, so new ones cannot normally appear.",{"_3640":2922,"_31229":2722,"_21648":60129,"_5":14899,"_28426":59586,"_3090":60130},[],"The KMS migration promotes the primary key to `(key_id, engine_id)` and aborts with `cannot promote (key_id, engine_id) to primary key: N row(s) have no engine_id; backfill them before migrating` when `kms_keys` rows lack `engine_id`. Backfill `engine_id` first.",{"_3640":2923,"_31229":2722,"_21648":60132,"_5":14899,"_28426":59586,"_3090":60133},[],"The same KMS migration deletes, with a `NOTICE`, aliases that equal an existing key ID, because identifiers now resolve as a key ID before an alias. Affected aliases are dropped, not redirected.",{"_3640":2924,"_31229":2722,"_21648":60135,"_5":14899,"_28426":59590,"_3090":60136},[],"The SQLite storage engine is removed, and the `couch_db` and `dynamo_db` engines are not registered in 4.0.0: their configuration constants remain, but they select no engine. Deployments on any of them must move to PostgreSQL and consolidate their data into the `pki` schemas before upgrading.",{"_3640":2925,"_31229":2722,"_21648":60138,"_5":14899,"_28426":59594,"_3090":60139},[],"CA certificates of type `MANAGED` or `IMPORTED_WITH_KEY` whose private keys predate the KMS service have the key stored only in the crypto engine, under the certificate's `subject_key_id`, with no KMS record. The `ca-to-kms-migration` tool registers them:",{"_3640":2926,"_31229":2722,"_21648":60141,"_5":14899,"_28426":59594,"_3090":60142},[],"The `key_id` is the certificate's `subject_key_id`; it matches the SHA-256 digest of the public key only when the SKI was computed that way.",{"_3640":2927,"_31229":2722,"_21648":60144,"_5":14899,"_28426":59594,"_3090":60145},[],"The tool is idempotent: keys already in the KMS are skipped, so it can be run several times.",{"_3640":2928,"_31229":2722,"_21648":60147,"_5":14899,"_28426":59594,"_3090":60148},[],"Certificates that cannot be read, or lack an engine or a subject key ID, are skipped with a warning. Review the logs and resolve the affected records.",{"_3640":2929,"_31229":2722,"_21648":60150,"_5":14899,"_28426":59594,"_3090":60151},[],"When CA certificates sharing a `subject_key_id` declare conflicting `engine_id`s, the tool fails that key and exits with code `1`, which fails a Helm pre-upgrade hook. Resolve the conflict manually before rerunning.",{"_3640":2930,"_31229":2722,"_21648":60153,"_5":14899,"_28426":59594,"_3090":60154},[],"Once the keys are registered, certificates reference them in the database and the KMS refuses to delete a key that a certificate still uses (`409` `key is in use`). Deleting a certificate record removes it from the CRL and OCSP, so read Before deleting a key before freeing a key.",{"_3640":2931,"_31229":2722,"_21648":60156,"_5":14899,"_28426":59594,"_3090":60157},[],"Optionally, installations with imported CAs from before 3.7 can start the KMS once with `crypto_engines.migrate_keys_format: true`: the KMS renames those SKI-named legacy keys to the SHA-256 digest of their public key (the old name is kept as an alias, and the certificate references follow automatically). Run it once and disable the option again; running it again is safe.",{"_3640":2932,"_31229":2722,"_21648":60159,"_5":14899,"_28426":59594,"_3090":60160},[],"With Helm, enable the hook for the upgrade in step 2; without Helm, run the tool by hand.",{"_3640":2933,"_31229":2722,"_21648":60162,"_5":14899,"_28426":59598,"_3090":60163},[],"Certificates now reference their KMS key, and CRL settings reference their signer certificate, so a key or certificate in use cannot be deleted. The KMS migration drops the legacy `lamassu.io/kms/binded-resources` key metadata. Before 4.0.0, deleting a CA could remove its key while leaving key references in its retained certificate records. The CA migration registers those missing keys in the KMS with only their public key to satisfy the retained references. These entries cannot be deleted while the retained certificates reference them; they do not restore the private key. In 4.0.0, deleting a CA releases the references from its own current certificate and linked reissued certificates before attempting to delete the key; other certificates that still reference it prevent deletion.",{"_3640":2934,"_31229":2722,"_21648":60165,"_5":14899,"_28426":59606,"_3090":60166},[],"Stored webhook configs are rewritten to the current layout and their fields renamed:",{"_3640":2935,"_31229":2722,"_21648":60168,"_5":14899,"_28426":59606,"_3090":60169},[],"Field in 3.8.0",{"_3640":2936,"_31229":2722,"_21648":60171,"_5":14899,"_28426":59606,"_3090":60172},[],"Field in 4.0.0",{"_3640":2937,"_31229":2722,"_21648":60174,"_5":14899,"_28426":59606,"_3090":60175},[],"`validate_server_cert`",{"_3640":2938,"_31229":2722,"_21648":60177,"_5":14899,"_28426":59606,"_3090":60178},[],"`insecure_skip_verify` (value negated)",{"_3640":2939,"_31229":2722,"_21648":60180,"_5":14899,"_28426":59606,"_3090":60181},[],"`oidc`",{"_3640":2940,"_31229":2722,"_21648":60183,"_5":14899,"_28426":59606,"_3090":60184},[],"`jwt_options`",{"_3640":2941,"_31229":2722,"_21648":60186,"_5":14899,"_28426":59606,"_3090":60187},[],"`apikey`",{"_3640":2942,"_31229":2722,"_21648":60189,"_5":14899,"_28426":59606,"_3090":60190},[],"`apikey_options`",{"_3640":2943,"_31229":2722,"_21648":60192,"_5":14899,"_28426":59606,"_3090":60193},[],"`mtls`",{"_3640":2944,"_31229":2722,"_21648":60195,"_5":14899,"_28426":59606,"_3090":60196},[],"`mtls_options`",{"_3640":2945,"_31229":2722,"_21648":60198,"_5":14899,"_28426":59606,"_3090":60199},[],"When the legacy mTLS certificate and key are both PEM, they move into `mtls_options.cert_content` and `mtls_options.key_content` and need no action. Two cases do need it.",{"_3640":2946,"_31229":2722,"_21648":60201,"_5":14899,"_28426":59606,"_3090":60202},[],"**Webhooks with file references.** A mixed config, with a PEM certificate and a file-path key, is migrated to `mtls_options.cert_file` and `mtls_options.key_file`. Webhook delivery rejects those fields on every call, whatever the configured authentication mode, so every enroll and re-enroll that calls that webhook fails until the config is fixed. If the webhook uses mTLS, re-enter the certificate and key as Base64-encoded or plain PEM; if it does not, remove the leftover file fields. Metadata-only updates keep working in the meantime (`PUT` or `PATCH` on `/v1/dms/:id/metadata`). In a variant of the same problem, a stored config with file paths inside `mtls_options.cert_content` or `mtls_options.key_content` makes every full settings update (`POST /v1/dms` or `PUT /v1/dms/:id`) fail validation; settings are replaced wholesale, so resend the config with the certificate and key as PEM.",{"_3640":2947,"_31229":2722,"_21648":60204,"_5":14899,"_28426":59606,"_3090":60205},[],"**Receiver certificate verification.** A config with `validate_server_cert: false` becomes `insecure_skip_verify: true`, so receiver verification stays skipped until that field is set to `false`. Correct it on every migrated config: the webhook authorization channel carries the API key or bearer token, and skipping verification exposes those credentials to a network-positioned attacker. Keep `insecure_skip_verify: true` only when the receiver certificate is deliberately unverifiable.",{"_3640":2948,"_31229":2722,"_21648":60207,"_5":14899,"_28426":59610,"_3090":60208},[],"The flat field `reenrollment_settings.additional_validation_cas` moves into the nested field `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`:",{"_3640":2949,"_31229":2722,"_21648":60210,"_5":14899,"_28426":59610,"_3090":60211},[],"The effective trust set does not change, because the nested value was never consulted when validating re-enrollments. If the flat list was missing or null, it becomes an empty list.",{"_3640":2950,"_31229":2722,"_21648":60213,"_5":14899,"_28426":59610,"_3090":60214},[],"What changes is how API requests are handled. Bodies that still carry `additional_validation_cas` are accepted, but the value is silently dropped because unknown JSON fields are ignored, and GET responses no longer include it. An update body built from the old layout therefore empties `validation_cas` without any error. Always read the DMS before sending an edit and reuse the layout the API returns.",{"_3640":2951,"_31229":2722,"_21648":60216,"_5":14899,"_28426":59614,"_3090":60217},[],"Enrollment and re-enrollment now verify the revocation of the presented certificates and fail closed when it cannot be verified. There is no migration: every pre-existing DMS has the new `allow_unverifiable_revocation` option at its default `false`, so a certificate that is not managed by Lamassu and carries no OCSP or CRL distribution points is rejected until the option is set to `true` in the affected block, independently for the enrollment and the re-enrollment block.",{"_3640":2952,"_31229":2722,"_21648":60219,"_5":14899,"_28426":59614,"_3090":60220},[],"Certificates that do carry endpoints are still strictly checked: unreachable endpoints, stale or inconclusive answers reject the certificate even when `allow_unverifiable_revocation` is enabled, and certificates managed by Lamassu are unaffected because their stored status is used. A validation CA revoked in Lamassu also rejects the operation, without falling back to the remaining validation CAs. See the DMS guide and Revocation and checks.",{"_3640":2953,"_31229":2722,"_21648":60222,"_5":14899,"_28426":59618,"_3090":60223},[],"Re-enrollment authentication settings are now stored independently from initial authentication. Nothing needs migrating, but read both blocks before editing a DMS so that you do not modify one while believing you are editing the other. The console exposes independent editors for both blocks; the DMS guide describes their fields, and you can also edit them through the DMS API.",{"_3640":2954,"_31229":2722,"_21648":60225,"_5":14899,"_28426":59622,"_3090":60226},[],"`PUT /v1/dms/:id` takes the DMS ID from the URL and validates the request body. An ID in the body is ignored, so update clients that relied on it.",{"_3640":2955,"_31229":2722,"_21648":60228,"_5":14899,"_28426":59626,"_3090":60229},[],"Stored certificate type values are renamed: `IMPORTED` becomes `IMPORTED_WITH_KEY` and `EXTERNAL` becomes `IMPORTED_WITHOUT_KEY`. `MANAGED` is unchanged. Adapt consumers that read or match on those values.",{"_3640":2956,"_31229":2722,"_21648":60231,"_5":14899,"_28426":59630,"_3090":60232},[],"The `events` field no longer appears in the device representation. Point consumers at the new endpoints:",{"_3640":2957,"_31229":2722,"_21648":60234,"_5":14899,"_28426":59630,"_3090":60235},[],"`GET /v1/devices/:id/events` returns a device's events.",{"_3640":2958,"_31229":2722,"_21648":60237,"_5":14899,"_28426":59630,"_3090":60238},[],"`POST /v1/devices/:id/events` creates an event.",{"_3640":2959,"_31229":2722,"_21648":60240,"_5":14899,"_28426":59630,"_3090":60241},[],"When the request `Accept` header includes `text/event-stream`, the events endpoint streams over SSE with a keepalive every 15 seconds, and returns `501` when SSE is disabled in the deployment. Each Device Manager instance binds a durable AMQP queue named after its service ID, `device-manager-sse-<uuid>`. Queues from crashed or replaced instances linger until removed, so configure an expiration or cleanup policy on the broker.",{"_3640":2960,"_31229":2722,"_21648":60243,"_5":14899,"_28426":59634,"_3090":60244},[],"`crl_options.subject_key_id_signer` is replaced by the required `crl_options.signer_serial_number`, the serial number of the existing certificate that signs the CRL. A new CA's initial value is the serial number of its current certificate. Requests that still carry `subject_key_id_signer` return an error. The authorization entity that holds these settings is also renamed; see CRL settings keyed by CA ID.",{"_3640":2961,"_31229":2722,"_21648":60246,"_5":14899,"_28426":59638,"_3090":60247},[],"In 3.8.0 the VA keyed each CRL by the CA's SKI, and `GET`/`PUT /v1/roles/{ca-ski}` read and updated it. In 4.0.0 the CRL settings of a CA are keyed by its CA ID, and every CA has its own, even when two CAs share a key:",{"_3640":2962,"_31229":2722,"_21648":60249,"_5":14899,"_28426":59638,"_3090":60250},[],"Route",{"_3640":2963,"_31229":2722,"_21648":60252,"_5":14899,"_28426":59638,"_3090":54525},[],{"_3640":2964,"_31229":2722,"_21648":60254,"_5":14899,"_28426":59638,"_3090":60255},[],"`GET /v1/crl-settings`",{"_3640":2965,"_31229":2722,"_21648":60257,"_5":14899,"_28426":59638,"_3090":60258},[],"Lists the CRL settings; filterable at least by `ca_id`, `status` and `legacy_ski`.",{"_3640":2966,"_31229":2722,"_21648":60260,"_5":14899,"_28426":59638,"_3090":60261},[],"`GET /v1/crl-settings/{ca-id}`",{"_3640":2967,"_31229":2722,"_21648":60263,"_5":14899,"_28426":59638,"_3090":60264},[],"Reads the settings of a CA.",{"_3640":2968,"_31229":2722,"_21648":60266,"_5":14899,"_28426":59638,"_3090":60267},[],"`PUT /v1/crl-settings/{ca-id}`",{"_3640":2969,"_31229":2722,"_21648":60269,"_5":14899,"_28426":59638,"_3090":60270},[],"Replaces `crl_options`.",{"_3640":2970,"_31229":2722,"_21648":60272,"_5":14899,"_28426":59638,"_3090":60273},[],"`DELETE /v1/crl-settings/{ca-id}`",{"_3640":2971,"_31229":2722,"_21648":60275,"_5":14899,"_28426":59638,"_3090":60276},[],"Removes the archived settings of a CA.",{"_3640":2972,"_31229":2722,"_21648":60278,"_5":14899,"_28426":59638,"_3090":60279},[],"The options keep their meaning and their defaults: 7 days of `validity`, 6 days and 23 hours of `refresh_interval`, and `regenerate_on_revoke` `true`. `status` (`ACTIVE`, `FINAL` or `ARCHIVED`), `legacy_ski` and `latest_crl` are read-only. A `PUT` validates the signer only when it changes, does not regenerate the CRL, and returns `409` when the settings are not `ACTIVE`.",{"_3640":2973,"_31229":2722,"_21648":60281,"_5":14899,"_28426":59638,"_3090":60282},[],"The public endpoint `GET /crl/{id}` takes the CA ID — the form the CDPs of newly issued certificates use — and keeps resolving the SKI form of certificates issued before the upgrade. Certificates issued before the upgrade keep their `/crl/<ski>` distribution points; newly issued ones carry `/crl/<ca-id>`, and both resolve to the same settings. The VA scheduled CRL job requests a new list on its first run, and the new list includes both URLs in its *Issuing Distribution Point*. Until it succeeds, the old list has only the legacy `/crl/<ski>` IDP: verifiers that compare it with the CDP of newly issued certificates cannot validate those certificates. The default schedule can delay the first run by up to about an hour; failures can extend the window.",{"_3640":2974,"_31229":2722,"_21648":60284,"_5":14899,"_28426":59638,"_3090":60285},[],"The migration that turns VA roles into CRL settings cannot be rolled back: its rollback does nothing. CRLs generated after the upgrade are stored under the CA ID, where 3.8.0 does not look for them, and the archived settings of CAs deleted before the upgrade have no signer to go back to. Returning to 3.8.0 requires restoring both the database and the CRL bucket — the object storage that holds the published lists — from the backups taken before the upgrade.",{"_3640":2975,"_31229":2722,"_21648":60287,"_5":14899,"_28426":59638,"_3090":60288},[],"The migration aborts, and the upgrade fails, on five kinds of data:",{"_3640":2976,"_31229":2722,"_21648":60290,"_5":14899,"_28426":59638,"_3090":60291},[],"CA IDs containing `/`: they cannot be used in CRL URLs. Recreate those CAs with a different ID.",{"_3640":2977,"_31229":2722,"_21648":60293,"_5":14899,"_28426":59638,"_3090":60294},[],"An SKI shared by more than one CA: the error names the SKIs and asks you to recreate all but one of them on a different key.",{"_3640":2978,"_31229":2722,"_21648":60296,"_5":14899,"_28426":59638,"_3090":60297},[],"A VA role whose signer certificate has no key: point the role to a signer with a key, or fix the key reference of the certificate, before upgrading.",{"_3640":2979,"_31229":2722,"_21648":60299,"_5":14899,"_28426":59638,"_3090":60300},[],"A CA whose ID equals the `legacy-<ski>` ID the migration reserves for the archived settings of another role whose CA was deleted: recreate that CA with a different ID.",{"_3640":2980,"_31229":2722,"_21648":60302,"_5":14899,"_28426":59638,"_3090":60303},[],"A CA ID equal to the SKI of another VA role: their CRL URLs would be ambiguous.",{"_3640":2981,"_31229":2722,"_21648":60305,"_5":14899,"_28426":59638,"_3090":60306},[],"The settings of a CA deleted before the upgrade are migrated as `ARCHIVED`, with a `legacy-<ski>` ID and no signer: their last CRL is still served, but never regenerated, and `PUT` returns `409`. There is no API way back to `ACTIVE`. The CRL guide describes the full behavior.",{"_3640":2982,"_31229":2722,"_21648":60308,"_5":14899,"_28426":59638,"_3090":60309},[],"**Custom authorization policies.** The entity `va_role` is renamed to `crl_settings`, with `ca_id` as its primary key and `signer_serial_number` as its relation to certificates. Update policies referencing the old entity. The entity gains the `delete` atomic action, a `signer_key_id` relation to KMS keys, and the filterable columns `signer_engine_id` and `signer_key_id`; grant the new action to whoever may delete archived CRL settings. Replace the 3.8.0 signer filter `crl_subject_key_id_signer` (or `crl_signer_certificate_serial_number` if used by an intermediate version) with `signer_serial_number`. Replace SKI filter values with the corresponding certificate serial numbers; renaming the filter alone is insufficient.",{"_3640":2983,"_31229":2722,"_21648":60311,"_5":14899,"_28426":59642,"_3090":60312},[],"`va.role.update` becomes `va.crl-settings.update` and `va.role.crl.init` becomes `va.crl-settings.init`; `va.role.crl.create` keeps its name and its payload. Every subject changes from `crl/<ski>` to `crl/<ca-id>`, and the payload of the renamed events changes from the old VA role to the CRL settings of the CA, with `ca_id` instead of `ca_ski`. The alerts migration renames the event types of existing subscriptions automatically, but it does not rewrite their conditions — JSON Path, JSON Schema or JavaScript: review conditions that filter on the old payload or on the old `crl/<ski>` subject, including those for `va.role.crl.create`. Direct event-bus consumers and audit searches must adopt the new names and payload themselves.",{"_3640":2984,"_31229":2722,"_21648":60314,"_5":14899,"_28426":59646,"_3090":60315},[],"`POST /v1/cas/{id}/signature/sign` and `POST /v1/cas/{id}/signature/verify` no longer exist: the CA service no longer signs or verifies arbitrary data, so a CA's private key only signs certificates. The Go SDK's `CAService.SignatureSign` and `CAService.SignatureVerify` methods are removed too, and the `ca.sign.signature` event is no longer published, so alert subscriptions and event-bus consumers that rely on it never fire again — remove those subscriptions and point consumers elsewhere. Sign and verify arbitrary data with a KMS key instead, through `POST /api/kms/v1/keys/{id}/sign` and `POST /api/kms/v1/keys/{id}/verify` (the Go SDK's `KMSService.SignMessage` and `KMSService.VerifySignature`); the console equivalent is described in Sign and verify. A CA is also only accepted for signing when its validity window includes the current time, even if its stored status still reads `ACTIVE`.",{"_3640":2985,"_31229":2722,"_21648":60317,"_5":14899,"_28426":59650,"_3090":60318},[],"Creating or importing a CA registers it under a backend-generated UUID. Any `id` sent in the request body is ignored, and the field is removed from the create and import bodies. Scripts that supplied their own IDs and addressed CAs by them must read the ID the backend returns instead.",{"_3640":2986,"_31229":2722,"_21648":60320,"_5":14899,"_28426":59654,"_3090":60321},[],"A CA key now signs only certificates. 3.8.0 let a client sign arbitrary data with a CA key through `POST /v1/cas/{id}/signature/sign` and check the result with `POST /v1/cas/{id}/signature/verify`. 4.0.0 removes both endpoints, the matching `SignatureSign` and `SignatureVerify` methods of the Go SDK `CAService`, and the `ca.sign.signature` event. An alert subscription on that event no longer fires: delete it or move it to another event.",{"_3640":2987,"_31229":2722,"_21648":60323,"_5":14899,"_28426":59654,"_3090":60324},[],"To sign and verify data, use the KMS operations `POST /v1/keys/{id}/sign` and `POST /v1/keys/{id}/verify`, which have their own authorization. Signing a certificate with a CA that is not `ACTIVE` or whose validity period does not include the current time now fails with `400`, even if the stored status has not yet changed to `EXPIRED`: see Certificate authorities.",{"_3640":2988,"_31229":2722,"_21648":60326,"_5":14899,"_28426":59657,"_3090":60327},[],"The VA migration resolves each role's signer from its stored SKI. It first looks for CA certificates with that SKI; if several match, it selects the oldest CA and logs a warning. If no CA certificate matches, it looks among all certificates with that SKI. The migration aborts with `cannot resolve signer certificate for VA role <ca-ski>, SKI <ski>` if that fallback finds zero or multiple candidates. Fix affected roles before upgrading.",{"_3640":2989,"_31229":2722,"_21648":60329,"_5":14899,"_28426":59661,"_3090":60330},[],"The upgrade runs in a fixed order: prepare the data and values, run `helm upgrade`, then copy the KMS and VA data into the new volumes. The copy must run after the upgrade, because the destination StatefulSets and PVCs do not exist before it. If you are not upgrading an existing release, go straight to Install with Helm.",{"_3640":2990,"_31229":2722,"_21648":60332,"_5":14899,"_28426":59665,"_3090":60333},[],"Take a verifiable backup of PostgreSQL and of the CRL object storage — the VA bucket, or the local volume that holds the CRLs — and schedule downtime. The upgrade moves every service's data into `pki`, and the VA migration is irreversible: returning to 3.8.0 needs both backups (see CRL settings keyed by CA ID).",{"_3640":2991,"_31229":2722,"_21648":60335,"_5":14899,"_28426":59665,"_3090":60336},[],"If the deployment runs on SQLite, `couch_db` or `dynamo_db`, move it to PostgreSQL first.",{"_3640":2992,"_31229":2722,"_21648":60338,"_5":14899,"_28426":59665,"_3090":60339},[],"Resolve duplicate CA IDs and backfill `engine_id` in `kms_keys`, as described in PostgreSQL consolidation.",{"_3640":2993,"_31229":2722,"_21648":60341,"_5":14899,"_28426":59665,"_3090":60342},[],"Optionally, run the pre-upgrade check against the consolidated 3.8.0 data before applying the migrations.",{"_3640":2994,"_31229":2722,"_21648":60344,"_5":14899,"_28426":59665,"_3090":60345},[],"Record the names of your local-storage PVCs:",{"_3640":2995,"_31229":2722,"_21648":60347,"_5":14899,"_28426":59665,"_3090":60348},[],"`helm upgrade` does not touch or delete the old PVCs, but nothing references them after the upgrade. You need their names to copy the data and to clean up later.",{"_3640":2996,"_31229":2722,"_21648":60350,"_5":14899,"_28426":59669,"_3090":60351},[],"The 4.0.0 database migrations refuse data they cannot migrate safely: they abort and name the offending objects. The `upgrade-check` tool reports all of those problems before the upgrade, in one run, with the same wording the migration would use. It is read-only: it never writes database rows or keys.",{"_3640":2997,"_31229":2722,"_21648":60353,"_5":14899,"_28426":59669,"_3090":60354},[],"Image: `ghcr.io/lamassuiot/lamassu-upgrade-check`. Configure it with a KMS-style YAML file passed through `LAMASSU_CONFIG_FILE`; only the `postgres` storage provider is supported.",{"_3640":2998,"_31229":2722,"_21648":60356,"_5":14899,"_28426":59669,"_3090":60357},[],"Run it on the 3.8.0 data after it has been consolidated into the `pki` schemas, and before any 4.0.0 migration runs or any 4.0.0 service starts.",{"_3640":2999,"_31229":2722,"_21648":60359,"_5":14899,"_28426":59669,"_3090":60360},[],"Exit codes: `0` means no problems were found, `1` means at least one problem was found, and `2` means the command could not run (bad configuration, unreachable database, or a database that is not a 3.8.0 one), or a check could not run.",{"_3640":3000,"_31229":2722,"_21648":60362,"_5":14899,"_28426":59669,"_3090":60363},[],"It covers the VA migrations only: an all-clear does not prove that the CA and KMS migration guards pass, so it does not replace the duplicate CA ID and `engine_id` checks described in PostgreSQL consolidation.",{"_3640":3001,"_31229":2722,"_21648":60365,"_5":14899,"_28426":59673,"_3090":60366},[],"**Create the credential Secrets.** The 4.0.0 chart reads PostgreSQL, AMQP and SMTP credentials from Kubernetes Secrets, and the pre-upgrade database job needs them before the upgrade runs. Copy the 3.8.0 credentials into your secret-management provider and create the Secrets with the External Secrets Operator (ESO), which the chart does not install:",{"_3640":3002,"_31229":2722,"_21648":60368,"_5":14899,"_28426":59673,"_3090":60369},[],"Configure ESO and its provider (`SecretStore` or `ClusterSecretStore`).",{"_3640":3003,"_31229":2722,"_21648":60371,"_5":14899,"_28426":59673,"_3090":60372},[],"Create an `ExternalSecret` for each credential set you use. Its target Secret must live in the release namespace, be named after the corresponding `existingSecret` value, and contain these keys:",{"_3640":3004,"_31229":2722,"_21648":60374,"_5":14899,"_28426":59673,"_3090":60375},[],"Secret (`existingSecret`)",{"_3640":3005,"_31229":2722,"_21648":60377,"_5":14899,"_28426":59673,"_3090":60378},[],"Required data keys",{"_3640":3006,"_31229":2722,"_21648":60380,"_5":14899,"_28426":59673,"_3090":60381},[],"When",{"_3640":3007,"_31229":2722,"_21648":60383,"_5":14899,"_28426":59673,"_3090":60384},[],"`lamassu-postgres` (default of `postgres.existingSecret`)",{"_3640":3008,"_31229":2722,"_21648":60386,"_5":14899,"_28426":59673,"_3090":60387},[],"`username`, `password`",{"_3640":3009,"_31229":2722,"_21648":60389,"_5":14899,"_28426":59673,"_3090":60390},[],"Always",{"_3640":3010,"_31229":2722,"_21648":60392,"_5":14899,"_28426":59673,"_3090":60393},[],"`lamassu-amqp` (default of `amqp.existingSecret`)",{"_3640":3011,"_31229":2722,"_21648":60395,"_5":14899,"_28426":59673,"_3090":60387},[],{"_3640":3012,"_31229":2722,"_21648":60397,"_5":14899,"_28426":59673,"_3090":60390},[],{"_3640":3013,"_31229":2722,"_21648":60399,"_5":14899,"_28426":59673,"_3090":60400},[],"`services.alerts.smtp_server.existingSecret`",{"_3640":3014,"_31229":2722,"_21648":60402,"_5":14899,"_28426":59673,"_3090":60387},[],{"_3640":3015,"_31229":2722,"_21648":60404,"_5":14899,"_28426":59673,"_3090":60405},[],"Only when SMTP authentication is enabled",{"_3640":3016,"_31229":2722,"_21648":60407,"_5":14899,"_28426":59673,"_3090":60408},[],"Wait for every `ExternalSecret` to be Ready and verify the generated Secrets before running the upgrade.",{"_3640":3017,"_31229":2722,"_21648":60410,"_5":14899,"_28426":59673,"_3090":60411},[],"Do not change the database or broker passwords as part of this migration: ESO synchronizes credentials into Secrets, but it does not update the users configured on the PostgreSQL server or the broker. Removing credentials from the values file does not undo past exposure — if they were ever committed to Git, rotate them after the migration is complete.",{"_3640":3018,"_31229":2722,"_21648":60413,"_5":14899,"_28426":59673,"_3090":60414},[],"The `charts/lamassu/README.md` in the Helm repository documents a full worked example in its *Secret management* section: installing external-secrets 0.20.2, a test Fake `ClusterSecretStore`, the `ExternalSecret` resources and the wait for synchronization. Its Fake provider is for testing only; for production, replace it with your provider's configuration.",{"_3640":3019,"_31229":2722,"_21648":60416,"_5":14899,"_28426":59673,"_3090":60417},[],"**Add `services.authz`.** Configure the JWKS endpoint, the database mappings and the bootstrap principal:",{"_3640":3020,"_31229":2722,"_21648":60419,"_5":14899,"_28426":59673,"_3090":60420},[],"`jwkUrl` is fetched from the `authz` pod, not from the gateway, so a Service in the release namespace can be referenced by its short name. The default points at a Keycloak Service named `auth-keycloak`; set it explicitly if your identity provider lives anywhere else.",{"_3640":3021,"_31229":2722,"_21648":60422,"_5":14899,"_28426":59673,"_3090":60423},[],"`authz` is the authorization service's own storage for principals, grants and policies. `pki` is the database the authorization engine queries when it evaluates policies against entities. Only the `database` field of each entry is required; per-schema `hostname` and `port` values remain accepted but are ignored — the connection always uses the global `postgres.hostname` and `postgres.port` with the global PostgreSQL credential Secret, `postgres.existingSecret` with its configured key names, unless the entry sets its own `existingSecret` (with optional `usernameKey` and `passwordKey`).",{"_3640":3022,"_31229":2722,"_21648":60425,"_5":14899,"_28426":59673,"_3090":60426},[],"If you kept the 3.8.0 role defaults (`realm_access.roles` and `pki-admin`), the default `services.authz.bootstrap` already matches them.",{"_3640":3023,"_31229":2722,"_21648":60428,"_5":14899,"_28426":59673,"_3090":60429},[],"**Delete the gateway token validation blocks.** Remove `auth.oidc.apiGateway` and `auth.authorization` once their settings are in `services.authz`:",{"_3640":3024,"_31229":2722,"_21648":60431,"_5":14899,"_28426":59673,"_3090":60432},[],"**Rename `toolbox` to `connectivityTest`:**",{"_3640":3025,"_31229":2722,"_21648":60434,"_5":14899,"_28426":59673,"_3090":60435},[],"**Remove the per-service identity overrides** `services.kms.securityContext.runAsGroup` and `services.authz.securityContext.runAsUser`/`runAsGroup`.",{"_3640":3026,"_31229":2722,"_21648":60437,"_5":14899,"_28426":59673,"_3090":60438},[],"**Convert `services.connectors` to a map** keyed by connector ID, each entry with its `type` and `image`:",{"_3640":3027,"_31229":2722,"_21648":60440,"_5":14899,"_28426":59673,"_3090":60441},[],"**Check AMQP.** If you set `amqp.tls: true`, also set `amqp.port` to the broker's TLS listener (commonly `5671`), or set `amqp.tls: false` to stay on plaintext.",{"_3640":3028,"_31229":2722,"_21648":60443,"_5":14899,"_28426":59673,"_3090":60444},[],"**Enable the CA-to-KMS migration** if your CA keys predate the KMS:",{"_3640":3029,"_31229":2722,"_21648":60446,"_5":14899,"_28426":59673,"_3090":60447},[],"**Review the remaining values:** overrides that pinned `services.ui.port` to `80`, the old `probes:` block, the TLS issuer, and explicit `affinity` and `topologySpreadConstraints` where your cluster needs them. Renamed and reshaped values describes each one.",{"_3640":3030,"_31229":2722,"_21648":60449,"_5":14899,"_28426":59673,"_3090":60450},[],"Run `helm lint` with the new values before upgrading; the strict schema reports any key that is still unknown. Before running Step 3, confirm every credential `ExternalSecret` is Ready and the generated Secrets contain the expected keys.",{"_3640":3031,"_31229":2722,"_21648":60452,"_5":14899,"_28426":59677,"_3090":60453},[],"Helm runs the pre-upgrade hooks — the CA-to-KMS migration when enabled, and the database job — before applying any workload, so services never start against an unprepared database. If validation rejects unknown values, fix the values file and re-run.",{"_3640":3032,"_31229":2722,"_21648":60455,"_5":14899,"_28426":59677,"_3090":60456},[],"If the deployment uses local KMS or VA storage, those pods fail until you complete step 4, so `--wait` cannot succeed: Helm waits for them to become ready, times out, exits with an error and marks the release `failed`. The hooks have already run by then, and every manifest, including the new StatefulSets and their PVCs, has been applied. Helm does not roll anything back without `--atomic`. Continue with step 4, then re-run the same `helm upgrade` command so it completes and Helm records the release as `deployed`. Both hooks are idempotent, so they are safe to run again.",{"_3640":3033,"_31229":2722,"_21648":60458,"_5":14899,"_28426":59681,"_3090":60459},[],"Skip this step when `services.kms.cryptoEngines` never used a `filesystem` engine and `services.va.fileStore.type` was never `local`.",{"_3640":3034,"_31229":2722,"_21648":60461,"_5":14899,"_28426":59681,"_3090":60462},[],"**Find the new StatefulSets and PVCs.** Their names depend on the release name and any `nameOverride` or `fullnameOverride`; the PVC name is `<volumeClaimTemplate>-<StatefulSet name>-0`:",{"_3640":3035,"_31229":2722,"_21648":60464,"_5":14899,"_28426":59681,"_3090":60465},[],"With release `lamassu` and the default chart name, the new PVCs are `golang-engine-storage-lamassu-kms-0` and `local-crl-file-storage-lamassu-va-0`; with release `prod` they are `golang-engine-storage-prod-lamassu-kms-0` and `local-crl-file-storage-prod-lamassu-va-0`. Confirm both old and new PVCs exist before continuing. If `claims_ok` prints `ABORT`, the block stops before listing the claims: either a StatefulSet lookup failed, or a new claim resolves to the 3.8.0 claim. In the second case the copy would verify against itself and the final cleanup would delete the live volume. The chart always appends `-kms` and `-va` to the release-scoped name, so a collision means the claims are not what this guide expects; investigate before going on. Item 3 runs the same check and refuses to create the helper pod, so nothing touches the volumes. The check returns instead of calling `exit`, which would close your shell and lose the variables set so far. If you only migrate one of the two services, drop the other one's claims from the commands that follow.",{"_3640":3036,"_31229":2722,"_21648":60467,"_5":14899,"_28426":59681,"_3090":60468},[],"**Record the replica counts, scale the new StatefulSets down and wait for every pod that uses the claims to exit**, so nothing writes to either volume while you copy. Helm removes the 3.8.0 `kms` and `va` StatefulSets during the upgrade, but their pods `kms-0` and `va-0` can still be terminating and holding the old claims. While they run, the helper pod either cannot attach the claims or copies a volume that is still being written. The `wait` returns at once for pods that are already gone:",{"_3640":3037,"_31229":2722,"_21648":60470,"_5":14899,"_28426":59681,"_3090":60471},[],"**Run a short-lived helper pod** that mounts all four claims. It runs as root so it can change file ownership, so pin its image by digest and do not mount the service-account token:",{"_3640":3038,"_31229":2722,"_21648":60473,"_5":14899,"_28426":59681,"_3090":60474},[],"**Inspect before writing** so you do not clobber data the new pods may already have written:",{"_3640":3039,"_31229":2722,"_21648":60476,"_5":14899,"_28426":59681,"_3090":60477},[],"An empty result is the common case: a StatefulSet's own pod rarely gets far enough to write anything when its dependent data is missing. If the output is not empty, record the files and confirm with the service owner that they are disposable before you run the copy; do not overlay the 3.8.0 data onto an unknown store.",{"_3640":3040,"_31229":2722,"_21648":60479,"_5":14899,"_28426":59681,"_3090":60480},[],"**Copy the data, align ownership and verify the copy.** The second command must print `copy verified`; any `diff` output means the copy is incomplete, so do not continue:",{"_3640":3041,"_31229":2722,"_21648":60482,"_5":14899,"_28426":59681,"_3090":60483},[],"The `chown` is required even if the old files already look non-root-owned, because 4.0.0 requires exactly `65532:65532` and does not fall back to whatever the image declares.",{"_3640":3042,"_31229":2722,"_21648":60485,"_5":14899,"_28426":59681,"_3090":60486},[],"**Remove the helper and restore the recorded replica counts:**",{"_3640":3043,"_31229":2722,"_21648":60488,"_5":14899,"_28426":59681,"_3090":60489},[],"**Re-run the step 3 `helm upgrade` command.** The KMS and VA pods now start against the copied data, so `--wait` succeeds and the release moves from `failed` to `deployed`.",{"_3640":3044,"_31229":2722,"_21648":60491,"_5":14899,"_28426":59685,"_3090":60492},[],"After the upgrade that performed the CA-to-KMS migration succeeds, remove `migrations.caToKms.enabled` from your values (it defaults to `false`). The hook reads the legacy 3.8.0 `kms-config` ConfigMap while it still exists and falls back to the release-scoped `<release>-lamassu-kms-config` once it is gone.",{"_3640":3045,"_31229":2722,"_21648":60494,"_5":14899,"_28426":59685,"_3090":60495},[],"Then go through the validation checklist. Keep the old PVCs until it passes.",{"_3640":3046,"_31229":2722,"_21648":60497,"_5":14899,"_28426":59689,"_3090":60498},[],"Without the chart's database job, no tool moves data between databases: the migration tooling only applies migrations to a schema that already exists. Move each per-service database into its `pki` schema yourself, preserving structure, indexes, constraints, data and migration history, with writes stopped and a verified backup in hand.",{"_3640":3047,"_31229":2722,"_21648":60500,"_5":14899,"_28426":59689,"_3090":60501},[],"Run the migrations in the required order, one schema at a time: `kms` first, then the `ca-to-kms-migration` tool (needed only for legacy deployments whose CA keys are named by SKI), then `ca`, then `va`. The `devicemanager`, `dmsmanager` and `alerts` schemas are independent and can be migrated in any order. With Helm, the chart's pre-install job applies the schemas in the correct order automatically.",{"_3640":3048,"_31229":2722,"_21648":60503,"_5":14899,"_28426":59689,"_3090":60504},[],"If `kms` has not been migrated, the `ca` migration fails with `kms schema not found: migrate the kms schema before the ca schema`. The `va` migration requires `ca` and `kms` to be migrated first: it fails with `ca schema not found: migrate the ca schema before the va schema` or `kms schema not found: migrate the kms schema before the va schema` if one of them is missing.",{"_3640":3049,"_31229":2722,"_21648":60506,"_5":14899,"_28426":59689,"_3090":60507},[],"The schemas reference each other, so the PostgreSQL role running the migrations needs cross-schema privileges: the `ca` schema needs `USAGE` on `kms` plus `SELECT`, `REFERENCES` and `INSERT` on `kms.kms_keys`, and the `va` schema needs `USAGE` on `ca` plus `SELECT` and `REFERENCES` on `ca.certificates`, `SELECT` on `ca.ca_certificates`, and `USAGE` on `kms` plus `SELECT` and `REFERENCES` on `kms.kms_keys`. Without them the migration aborts; grant the missing privileges and rerun the failed schema. After migrating `ca`, if the CA service runs as a different user than the migration user, grant it `SELECT` on `ca.certificates_view` (`GRANT SELECT ON ca.certificates_view TO service_user`). Without this grant, certificate and CA reads fail with `permission denied for table certificates_view`. After migrating `va`, if the CA service runs as a different user, grant it `USAGE` on the `va` schema and `SELECT` on `va.crl_settings` (`GRANT USAGE ON SCHEMA va TO service_user; GRANT SELECT ON va.crl_settings TO service_user`): the CA service reads `va.crl_settings` when it deletes a CA, and without these grants every deletion of a CA that has a crypto engine fails with `permission denied for schema va` (or `for table crl_settings`).",{"_3640":3050,"_31229":2722,"_21648":60509,"_5":14899,"_28426":59689,"_3090":60510},[],"To apply migrations by hand, `goose-lamassu` must run against the `pki` database with `search_path=<schema>` in the connection string. The binary validates only `search_path`, not the database name, so check `dbname=pki` before running it, and repeat for `kms`, `ca`, `va`, `devicemanager`, `dmsmanager` and `alerts`:",{"_3640":3051,"_31229":2722,"_21648":60512,"_5":14899,"_28426":59689,"_3090":60513},[],"Run `ca-to-kms-migration` first with `--dry-run`, which reports without writing to KMS storage, and then for real:",{"_3640":3052,"_31229":2722,"_21648":60515,"_5":14899,"_28426":59689,"_3090":60516},[],"Point the tool's `storage` configuration at the `pki` database, where the CA and KMS data now live in the `ca` and `kms` schemas. The tool's options are described in `backend/cmd/ca-to-kms-migration/README.md` in the `lamassuiot` repository.",{"_3640":3053,"_31229":2722,"_21648":60518,"_5":14899,"_28426":59689,"_3090":60519},[],"Both tools' READMEs document the 4.0.0 `pki` layout and match this page: `goose-lamassu` uses `dbname=pki` examples and does not validate the database name, and the `ca-to-kms-migration` README describes the single `pki` database and the migration order.",{"_3640":3054,"_31229":2722,"_21648":60521,"_5":14899,"_28426":59693,"_3090":60522},[],"**KMS or VA pods crash with `no such file or directory` or `code=NotFound` right after the upgrade.** The pods are bound to the new, empty PVCs and the data migration has not run yet, or was copied into the wrong PVC. Follow step 4 and check that all four claims exist.",{"_3640":3055,"_31229":2722,"_21648":60524,"_5":14899,"_28426":59693,"_3090":60525},[],"**`helm upgrade --wait` times out and `helm status` reports the release as `failed`.** With local KMS or VA storage this is expected on the first run: the new pods cannot become ready before their data is copied. The hooks ran and the manifests and PVCs were applied, so complete step 4 and re-run the same `helm upgrade` command. If other pods are also not ready, check their logs, because something else is wrong.",{"_3640":3056,"_31229":2722,"_21648":60527,"_5":14899,"_28426":59693,"_3090":60528},[],"**The helper pod stays `Pending` or `ContainerCreating` and `kubectl wait` times out.** Another pod still holds one of the claims; on block storage `kubectl describe pod pvc-migrate-helper` shows a `Multi-Attach error`. Check with `kubectl get pods -n $NAMESPACE` that `kms-0`, `va-0` and the new KMS and VA pods are gone, then re-run the wait.",{"_3640":3057,"_31229":2722,"_21648":60530,"_5":14899,"_28426":59693,"_3090":60531},[],"**`helm upgrade` fails with an unknown-key validation error.** Remove or rename the legacy values — typically `toolbox`, `auth.oidc.apiGateway` or `auth.authorization` — because the strict schema rejects keys it does not know.",{"_3640":3058,"_31229":2722,"_21648":60533,"_5":14899,"_28426":59693,"_3090":60534},[],"**The upgrade fails at the database job.** The PostgreSQL role cannot create databases or schemas, or a schema migration aborted: on duplicate CA IDs or missing `engine_id` values, or in the VA schema on a CA ID containing `/`, an SKI shared by more than one CA (the error asks you to recreate all but one of them on a different key), a role whose signer certificate has no key, a CA ID reserved for the archived settings of another role, or a CA ID equal to another role's SKI. The abort message names the offending objects; fix them and re-run the upgrade.",{"_3640":3059,"_31229":2722,"_21648":60536,"_5":14899,"_28426":59693,"_3090":60537},[],"**The upgrade fails at the CA-to-KMS hook.** CA certificates that share a `subject_key_id` declare conflicting `engine_id`s. Resolve the conflict and re-run.",{"_3640":3060,"_31229":2722,"_21648":60539,"_5":14899,"_28426":59693,"_3090":60540},[],"**Nobody can log in after the upgrade.** Check that `services.authz.jwkUrl` is reachable from the `authz` pod, that `services.authz.bootstrap` matches a role your OIDC provider actually assigns, and that the database job completed.",{"_3640":3061,"_31229":2722,"_21648":60542,"_5":14899,"_28426":59693,"_3090":60543},[],"**A migration aborts with `kms schema not found`.** The schemas must be migrated in order: run the `kms` schema migration before the `ca` and `va` schema migrations.",{"_3640":3062,"_31229":2722,"_21648":60545,"_5":14899,"_28426":59693,"_3090":60546},[],"**A migration aborts with `ca schema not found`.** Run the `ca` schema migration before the `va` schema migration.",{"_3640":3063,"_31229":2722,"_21648":60548,"_5":14899,"_28426":59693,"_3090":60549},[],"**The VA migration fails with `cannot resolve signer certificate for VA role ... N candidates`.** The migration cannot uniquely identify a signer certificate from the SKI stored on the role. Review the SKI and candidate certificates reported in the error; correct the pre-migration data with a verified backup and rerun the migration. The new `signer_serial_number` field is created during that migration, so it cannot be set through the VA API while the migration is failing.",{"_3640":3064,"_31229":2722,"_21648":60551,"_5":14899,"_28426":59693,"_3090":60552},[],"**A migration or service fails with `permission denied for table ...` or `permission denied for schema ...`.** The PostgreSQL role is missing the cross-schema privileges listed in Deployments without Helm; this includes `certificates_view` when the post-migration `GRANT SELECT` was skipped, and `permission denied for schema va` (or `for table crl_settings`) when deleting a CA without the `va` grants. Grant the missing privileges and re-run.",{"_3640":3065,"_31229":2722,"_21648":60554,"_5":14899,"_28426":59696,"_3090":60555},[],"After the upgrade, check in this order:",{"_3640":3066,"_31229":2722,"_21648":60557,"_5":14899,"_28426":59696,"_3090":60558},[],"**Databases.** Each service reads the `pki` database with its own schema, `authz` and `wfx` data are reachable, and the migration status is registered per schema, including the CA unique-ID and KMS composite-key migrations and the foreign-key migrations that run per schema in the required order.",{"_3640":3067,"_31229":2722,"_21648":60560,"_5":14899,"_28426":59696,"_3090":60561},[],"**KMS and VA start cleanly.** Their logs show no `no such file or directory` or `code=NotFound` errors.",{"_3640":3068,"_31229":2722,"_21648":60563,"_5":14899,"_28426":59696,"_3090":60564},[],"**Existing KMS keys work.** Issue a certificate from a CA that existed before the upgrade. None of the other checks reads a KMS key, so this is the only one that proves the key material was copied.",{"_3640":3069,"_31229":2722,"_21648":60566,"_5":14899,"_28426":59696,"_3090":60567},[],"**Existing CRLs are served.** `GET /crl/<ca-id>` on VA returns a previously issued CRL, and `GET /crl/<ca-ski>` with the legacy SKI of a certificate issued before the upgrade also resolves. The VA scheduled CRL job has issued a new list under the CA ID with both URLs in its IDP; check its logs if regeneration has not succeeded.",{"_3640":3070,"_31229":2722,"_21648":60569,"_5":14899,"_28426":59696,"_3090":60570},[],"**Renamed VA events.** Alert subscriptions to `va.role.update` and `va.role.crl.init` now subscribe to `va.crl-settings.update` and `va.crl-settings.init`, and conditions for all VA events, including `va.role.crl.create`, have been reviewed against the new payload (`ca_id` instead of `ca_ski`) and subject (`crl/<ca-id>` instead of `crl/<ski>`). Direct consumers and audit searches use the new event names.",{"_3640":3071,"_31229":2722,"_21648":60572,"_5":14899,"_28426":59696,"_3090":60573},[],"**Legacy CA keys.** If the CA-to-KMS migration ran, review its report and warnings and confirm the expected keys appear in the KMS. Migrated CA certificates now report `key_id` and `has_private_key`, which you can use to confirm the registration.",{"_3640":3072,"_31229":2722,"_21648":60575,"_5":14899,"_28426":59696,"_3090":60576},[],"**Connectivity.** `helm test \"$RELEASE\" -n $NAMESPACE --logs` passes; the hook checks the CA, DMS Manager, Device Manager and VA health endpoints and the UI response.",{"_3640":3073,"_31229":2722,"_21648":60578,"_5":14899,"_28426":59696,"_3090":60579},[],"**Authorization.** Sign in as the bootstrap principal and confirm administration works, check that an identity without permissions receives `403`, and review client and integration permissions.",{"_3640":3074,"_31229":2722,"_21648":60581,"_5":14899,"_28426":59696,"_3090":60582},[],"**AMQP.** The backend connects to the broker with the expected TLS settings, and the cleanup policy for SSE queues is in place.",{"_3640":3075,"_31229":2722,"_21648":60584,"_5":14899,"_28426":59696,"_3090":60585},[],"**Device events.** `GET /v1/devices/:id/events` returns the historical events of a device that had them.",{"_3640":3076,"_31229":2722,"_21648":60587,"_5":14899,"_28426":59696,"_3090":60588},[],"**Webhooks without file fields.** For each DMS that uses a webhook for enrollment or re-enrollment, the `config` block carries `insecure_skip_verify` and the expected option block (`apikey_options`, `jwt_options` or `mtls_options`), with the certificate and key as PEM and no `cert_file` or `key_file`.",{"_3640":3077,"_31229":2722,"_21648":60590,"_5":14899,"_28426":59696,"_3090":60591},[],"**Receiver verification.** `insecure_skip_verify` is `false`, unless the receiver certificate is intentionally unverified.",{"_3640":3078,"_31229":2722,"_21648":60593,"_5":14899,"_28426":59696,"_3090":60594},[],"**Webhook delivery.** One enroll or re-enroll through each migrated webhook completes its authorization call.",{"_3640":3079,"_31229":2722,"_21648":60596,"_5":14899,"_28426":59696,"_3090":60597},[],"**Trust set.** `est_rfc7030_settings.client_certificate_settings.validation_cas` holds the expected CAs, in particular those of the old CA during rotation overlaps.",{"_3640":3080,"_31229":2722,"_21648":60599,"_5":14899,"_28426":59696,"_3090":60600},[],"**API clients.** Scripts and consoles no longer use the old DMS layout (flat `additional_validation_cas`, or the legacy `mtls`, `apikey` and `oidc` fields), send DMS updates with the ID in the URL, and match on the new certificate `type` values.",{"_3640":3081,"_31229":2722,"_21648":60602,"_5":14899,"_28426":59700,"_3090":60603},[],"Only once every check passes, delete the orphaned 3.8.0 volumes to reclaim storage. The delete is irreversible and the old KMS volume may hold the last copy of your CA key material, so take a `VolumeSnapshot` or a backup of both old PVCs first and keep it until you are confident the upgraded deployment is healthy. These are the fixed 3.8.0 names recorded in step 1; before deleting, confirm that neither is mounted by a running pod, for example with `kubectl describe pvc -n $NAMESPACE golang-engine-storage-kms-0 local-crl-file-storage-va-0`, where `Used By` must be `<none>`:",{"_3640":3082,"_31229":2722,"_21648":60605,"_5":14899,"_28426":59700,"_3090":60606},[],"The 3.8.0 per-service databases are no longer used either. Drop them only after the same checks pass and your PostgreSQL backup is verified.",{"_3640":3083,"_31229":2722,"_21648":60608,"_5":14899,"_28426":59700,"_3090":60609},[],"<Card title=\"Install with Helm\" description=\"Prepare dependencies, configure values and install a controlled deployment.\" href=\"/docs/deployment/self-hosted/helm\" />",{"_3640":3084,"_31229":2722,"_21648":60611,"_5":14899,"_28426":59700,"_3090":60612},[],"<Card title=\"Access control\" description=\"Principals, policies and the first administrator.\" href=\"/docs/platform/administration/access-control\" />",{"_3640":3085,"_31229":2722,"_21648":60614,"_5":14899,"_28426":59700,"_3090":60615},[],"<Card title=\"Configure a DMS\" description=\"Enrollment, re-enrollment and webhook settings.\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />","sorting",{"_60618":60619,"_60620":60621,"_60622":60623,"_60624":60625,"_18780":3125,"_72923":3125},"language","english","sortableProperties",[3090,31229,5,28426],"sortablePropertiesWithTypes",{"_3090":25835,"_31229":25835,"_5":25835,"_28426":25835},"sorts",{"_3090":60626,"_31229":63701,"_5":66775,"_28426":69849},{"_4845":60627,"_60628":60629,"_5":25835},{"_14980":7920,"_15359":6640,"_15378":3565,"_30229":13389,"_15365":4547,"_20555":6229,"_15001":7951,"_15008":3166,"_30171":7961,"_30579":7322,"_30606":5394,"_30205":5003,"_35622":4384,"_30308":7852,"_30650":5647,"_35629":15430,"_35632":4933,"_35635":14265,"_35638":4500,"_31052":6270,"_35643":24654,"_35645":4477,"_31087":8948,"_15374":6222,"_35649":3486,"_35652":4558,"_35654":6464,"_30634":5413,"_31072":6918,"_31100":5201,"_35659":3319,"_35661":3496,"_35663":3512,"_30319":3191,"_35666":3435,"_35668":20853,"_35670":15809,"_35672":3821,"_35674":6253,"_30242":4850,"_35677":3311,"_35679":360