:119838,"_38807":119841,"_38809":119844,"_38811":119847,"_38813":119850,"_38815":119853,"_38817":119856,"_38819":119859,"_38821":119862,"_38823":119865,"_38825":119868,"_38827":119871,"_38829":119874,"_38831":119877,"_38833":119880,"_38835":119883,"_38837":119886,"_38840":119889,"_38842":119892,"_38844":119895,"_38847":119898,"_38849":119901,"_38851":119904,"_38853":119907,"_38855":119910,"_38857":119913,"_38859":119916,"_38861":119919,"_38863":119922,"_38865":119925,"_38867":119928,"_38869":119931,"_38871":119934,"_38873":119937,"_38875":119940,"_38877":119943,"_38879":119946,"_38881":119949,"_38883":119952,"_38885":119955,"_38887":119958,"_38889":119961,"_38891":119964,"_38893":119967,"_38895":119970,"_38897":119973,"_38899":119976,"_38901":119979,"_38903":119982,"_38905":119985,"_38907":119988,"_38909":119991,"_38911":119994,"_38913":119997,"_38915":120000,"_38917":120003,"_38919":120006,"_38921":120009,"_38924":120012,"_38926":120015,"_38928":120018},{"_3328":67362,"_29138":67362,"_5":14177,"_2816":111477,"_29461":111478,"_20209":111481,"_26493":67362},"Despliega desde AWS Marketplace",[47397,111479,111480],"Despliegue","Otros modelos",[],{"_3328":67363,"_29138":67362,"_20209":111483,"_5":13819,"_26493":67362,"_2816":111484},[],"Ejecuta una instancia preconfigurada de Lamassu IoT en Amazon EC2.",{"_3328":67364,"_29138":67362,"_5":29458,"_20209":111486,"_26493":111487,"_2816":111488},[],"/docs/es/deployment/aws-marketplace#antes-de-empezar","Antes de empezar",{"_3328":67365,"_29138":67362,"_5":29458,"_20209":111490,"_26493":111491,"_2816":111492},[],"/docs/es/deployment/aws-marketplace#requisitos-de-infraestructura","Requisitos de infraestructura",{"_3328":67366,"_29138":67362,"_5":29458,"_20209":111494,"_26493":111495,"_2816":111496},[],"/docs/es/deployment/aws-marketplace#abre-la-oferta","Abre la oferta",{"_3328":67367,"_29138":67362,"_5":29458,"_20209":111498,"_26493":111499,"_2816":111500},[],"/docs/es/deployment/aws-marketplace#configura-la-instancia","Configura la instancia",{"_3328":67368,"_29138":67362,"_5":29458,"_20209":111502,"_26493":111503,"_2816":111504},[],"/docs/es/deployment/aws-marketplace#limita-el-acceso-de-red","Limita el acceso de red",{"_3328":67369,"_29138":67362,"_5":29458,"_20209":111506,"_26493":111507,"_2816":111508},[],"/docs/es/deployment/aws-marketplace#lanza-y-verifica","Lanza y verifica",{"_3328":67370,"_29138":67362,"_5":29458,"_20209":111510,"_26493":111511,"_2816":111512},[],"/docs/es/deployment/aws-marketplace#siguiente-paso","Siguiente paso",{"_3328":67371,"_29138":67362,"_20209":111514,"_5":13819,"_26493":67362,"_2816":111515},[],"La oferta de AWS Marketplace reduce la preparación inicial a una instancia EC2 dentro de tu cuenta. Tú mantienes el control de la red, el almacenamiento y la operación de la máquina.",{"_3328":67372,"_29138":67362,"_20209":111517,"_5":13819,"_26493":111487,"_2816":111518},[],"Permisos para suscribirte a productos de AWS Marketplace y lanzar instancias EC2.",{"_3328":67373,"_29138":67362,"_20209":111520,"_5":13819,"_26493":111487,"_2816":111521},[],"Una VPC y una subred desde la que puedan acceder administradores y dispositivos.",{"_3328":67374,"_29138":67362,"_20209":111523,"_5":13819,"_26493":111487,"_2816":111524},[],"Un grupo de seguridad que permita los endpoints necesarios.",{"_3328":67375,"_29138":67362,"_20209":111526,"_5":13819,"_26493":111491,"_2816":111527},[],"**Cómputo:** una instancia `t3.large` como mínimo. Utiliza `t3.xlarge` o superior cuando la carga lo requiera.",{"_3328":67376,"_29138":67362,"_20209":111529,"_5":13819,"_26493":111491,"_2816":111530},[],"**Almacenamiento:** un volumen EBS `gp3` de al menos 50 GB, ajustado al tamaño del inventario y la retención.",{"_3328":67377,"_29138":67362,"_20209":111532,"_5":13819,"_26493":111491,"_2816":111533},[],"**Red:** acceso HTTPS desde los consumidores necesarios, restringido a redes de confianza.",{"_3328":67378,"_29138":67362,"_20209":111535,"_5":13819,"_26493":111495,"_2816":111536},[],"Accede a Lamassu IoT en AWS Marketplace y revisa las condiciones antes de suscribirte.",{"_3328":67379,"_29138":67362,"_20209":111538,"_5":13819,"_26493":111499,"_2816":111539},[],"Selecciona `t3.large` o superior, asigna al menos 50 GB de almacenamiento `gp3` y elige la VPC y subred de destino.",{"_3328":67380,"_29138":67362,"_20209":111541,"_5":13819,"_26493":111503,"_2816":111542},[],"Configura el grupo de seguridad para los puertos `443`, `8443` y `9443`. Restringe los orígenes a las redes administrativas y de dispositivos que realmente necesiten conectarse.",{"_3328":67381,"_29138":67362,"_20209":111544,"_5":13819,"_26493":111507,"_2816":111545},[],"Inicia la instancia y abre la consola en `https://<ip-publica>`. Comprueba que puedes autenticarte antes de continuar.",{"_3328":67382,"_29138":67362,"_20209":111547,"_5":13819,"_26493":111511,"_2816":111548},[],"Continúa con Crea tu primera CA para validar la configuración criptográfica de la instancia.",{"_3328":67383,"_29138":67383,"_5":14177,"_2816":111550,"_29461":111551,"_20209":111552,"_26493":67383},"Despliega Lamassu",[47397,111479],[],{"_3328":67384,"_29138":67383,"_20209":111554,"_5":13819,"_26493":67383,"_2816":111555},[],"Elige el modelo operativo que encaja con tu infraestructura y requisitos de control.",{"_3328":67385,"_29138":67383,"_5":29458,"_20209":111557,"_26493":111558,"_2816":111559},[],"/docs/es/deployment/overview#elige-un-modelo","Elige un modelo",{"_3328":67386,"_29138":67383,"_5":29458,"_20209":111561,"_26493":111562,"_2816":111563},[],"/docs/es/deployment/overview#solo-quieres-evaluar-la-plataforma","¿Solo quieres evaluar la plataforma?",{"_3328":67387,"_29138":67383,"_5":29458,"_20209":111565,"_26493":111566,"_2816":111567},[],"/docs/es/deployment/overview#después-del-despliegue","Después del despliegue",{"_3328":67388,"_29138":67383,"_20209":111569,"_5":13819,"_26493":67383,"_2816":111570},[],"Puedes ejecutar Lamassu en tu propio clúster Kubernetes, desplegar una imagen preparada desde AWS Marketplace o consumir la plataforma como servicio gestionado.",{"_3328":67389,"_29138":67383,"_20209":111572,"_5":13819,"_26493":111558,"_2816":111573},[],"Modelo",{"_3328":67390,"_29138":67383,"_20209":111575,"_5":13819,"_26493":111558,"_2816":111576},[],"Recomendado para",{"_3328":67391,"_29138":67383,"_20209":111578,"_5":13819,"_26493":111558,"_2816":111579},[],"Quién opera la infraestructura",{"_3328":67392,"_29138":67383,"_20209":111581,"_5":13819,"_26493":111558,"_2816":111582},[],"Punto de partida",{"_3328":67393,"_29138":67383,"_20209":111584,"_5":13819,"_26493":111558,"_2816":47504},[],{"_3328":67394,"_29138":67383,"_20209":111586,"_5":13819,"_26493":111558,"_2816":111587},[],"Producción, entornos regulados y despliegues personalizados",{"_3328":67395,"_29138":67383,"_20209":111589,"_5":13819,"_26493":111558,"_2816":111590},[],"Tu equipo",{"_3328":67396,"_29138":67383,"_20209":111592,"_5":13819,"_26493":111558,"_2816":111593},[],"Helm o Fastlane",{"_3328":67397,"_29138":67383,"_20209":111595,"_5":13819,"_26493":111558,"_2816":47516},[],{"_3328":67398,"_29138":67383,"_20209":111597,"_5":13819,"_26493":111558,"_2816":111598},[],"Evaluación o despliegue dedicado dentro de una cuenta AWS",{"_3328":67399,"_29138":67383,"_20209":111600,"_5":13819,"_26493":111558,"_2816":111590},[],{"_3328":67400,"_29138":67383,"_20209":111602,"_5":13819,"_26493":111558,"_2816":111603},[],"Imagen preconfigurada en EC2",{"_3328":67401,"_29138":67383,"_20209":111605,"_5":13819,"_26493":111558,"_2816":47527},[],{"_3328":67402,"_29138":67383,"_20209":111607,"_5":13819,"_26493":111558,"_2816":111608},[],"Equipos que quieren utilizar la plataforma sin operarla",{"_3328":67403,"_29138":67383,"_20209":111610,"_5":13819,"_26493":111558,"_2816":47533},[],{"_3328":67404,"_29138":67383,"_20209":111612,"_5":13819,"_26493":111558,"_2816":111613},[],"Suscripción gestionada",{"_3328":67405,"_29138":67383,"_20209":111615,"_5":13819,"_26493":111558,"_2816":111616},[],"<Card title=\"Kubernetes self-managed\" description=\"Controla red, almacenamiento, claves, dependencias y ciclo de actualización.\" href=\"/docs/deployment/self-hosted/overview\" />",{"_3328":67406,"_29138":67383,"_20209":111618,"_5":13819,"_26493":111558,"_2816":111619},[],"<Card title=\"AWS Marketplace\" description=\"Lanza una instancia preconfigurada de Lamassu en AWS EC2.\" href=\"/docs/deployment/aws-marketplace\" />",{"_3328":67407,"_29138":67383,"_20209":111621,"_5":13819,"_26493":111558,"_2816":111622},[],"<Card title=\"Lamassu SaaS\" description=\"Utiliza una instancia operada y actualizada como servicio gestionado.\" href=\"/docs/deployment/saas\" />",{"_3328":67408,"_29138":67383,"_20209":111624,"_5":13819,"_26493":111562,"_2816":111625},[],"Usa Fastlane para levantar PostgreSQL, Keycloak, RabbitMQ y Lamassu en un clúster Kubernetes mediante un único flujo. Está pensado para laboratorios, demos y bootstrap; para producción, configura las dependencias y los valores Helm de forma explícita.",{"_3328":67409,"_29138":67383,"_20209":111627,"_5":13819,"_26493":111566,"_2816":111628},[],"Cuando la consola esté disponible, continúa con Crea tu primera CA. Ese quickstart verifica que el motor criptográfico y la emisión funcionan correctamente.",{"_3328":67410,"_29138":67410,"_5":14177,"_2816":111630,"_29461":111631,"_20209":111632,"_26493":67410},"Utiliza Lamassu como SaaS",[47397,111479,111480],[],{"_3328":67411,"_29138":67410,"_20209":111634,"_5":13819,"_26493":67410,"_2816":111635},[],"Consume Lamassu como servicio gestionado sin operar infraestructura propia.",{"_3328":67412,"_29138":67410,"_5":29458,"_20209":111637,"_26493":111638,"_2816":111639},[],"/docs/es/deployment/saas#qué-gestiona-el-servicio","Qué gestiona el servicio",{"_3328":67413,"_29138":67410,"_5":29458,"_20209":111641,"_26493":111642,"_2816":111643},[],"/docs/es/deployment/saas#planes","Planes",{"_3328":67414,"_29138":67410,"_5":29458,"_20209":111645,"_26493":111646,"_2816":111647},[],"/docs/es/deployment/saas#solicita-acceso","Solicita acceso",{"_3328":67415,"_29138":67410,"_20209":111649,"_5":13819,"_26493":67410,"_2816":111650},[],"Lamassu SaaS ofrece las capacidades de la plataforma en un entorno administrado. Es la opción indicada cuando tu equipo quiere centrarse en la PKI y las identidades de los dispositivos, no en mantener la infraestructura que las soporta.",{"_3328":67416,"_29138":67410,"_20209":111652,"_5":13819,"_26493":111638,"_2816":111653},[],"Disponibilidad y mantenimiento de la plataforma.",{"_3328":67417,"_29138":67410,"_20209":111655,"_5":13819,"_26493":111638,"_2816":111656},[],"Copias de seguridad automáticas.",{"_3328":67418,"_29138":67410,"_20209":111658,"_5":13819,"_26493":111638,"_2816":111659},[],"Actualizaciones de versión.",{"_3328":67419,"_29138":67410,"_20209":111661,"_5":13819,"_26493":111638,"_2816":111662},[],"Soporte técnico y SLA según el plan contratado.",{"_3328":67420,"_29138":67410,"_20209":111664,"_5":13819,"_26493":111642,"_2816":47588},[],{"_3328":67421,"_29138":67410,"_20209":111666,"_5":13819,"_26493":111642,"_2816":111667},[],"Dispositivos",{"_3328":67422,"_29138":67410,"_20209":111669,"_5":13819,"_26493":111642,"_2816":111670},[],"Soporte",{"_3328":67423,"_29138":67410,"_20209":111672,"_5":13819,"_26493":111642,"_2816":47597},[],{"_3328":67424,"_29138":67410,"_20209":111674,"_5":13819,"_26493":111642,"_2816":47600},[],{"_3328":67425,"_29138":67410,"_20209":111676,"_5":13819,"_26493":111642,"_2816":111677},[],"Hasta 1.000",{"_3328":67426,"_29138":67410,"_20209":111679,"_5":13819,"_26493":111642,"_2816":47606},[],{"_3328":67427,"_29138":67410,"_20209":111681,"_5":13819,"_26493":111642,"_2816":111682},[],"99,5 %",{"_3328":67428,"_29138":67410,"_20209":111684,"_5":13819,"_26493":111642,"_2816":47612},[],{"_3328":67429,"_29138":67410,"_20209":111686,"_5":13819,"_26493":111642,"_2816":111687},[],"Hasta 10.000",{"_3328":67430,"_29138":67410,"_20209":111689,"_5":13819,"_26493":111642,"_2816":111690},[],"Email y chat",{"_3328":67431,"_29138":67410,"_20209":111692,"_5":13819,"_26493":111642,"_2816":111693},[],"99,9 %",{"_3328":67432,"_29138":67410,"_20209":111695,"_5":13819,"_26493":111642,"_2816":47624},[],{"_3328":67433,"_29138":67410,"_20209":111697,"_5":13819,"_26493":111642,"_2816":111698},[],"Ilimitados",{"_3328":67434,"_29138":67410,"_20209":111700,"_5":13819,"_26493":111642,"_2816":111701},[],"Dedicado",{"_3328":67435,"_29138":67410,"_20209":111703,"_5":13819,"_26493":111642,"_2816":111704},[],"99,99 %",{"_3328":67436,"_29138":67410,"_20209":111706,"_5":13819,"_26493":111646,"_2816":111707},[],"Contacta con el equipo de Lamassu a través de lamassu.io para solicitar una demo o elegir un plan.",{"_3328":67437,"_29138":67410,"_20209":111709,"_5":13819,"_26493":111646,"_2816":111710},[],"Cuando recibas las credenciales de tu instancia, continúa con Primeros pasos.",{"_3328":67438,"_29138":67438,"_5":14177,"_2816":47641,"_29461":111712,"_20209":111714,"_26493":67438},[47397,111479,111713],"Kubernetes autogestionado",[],{"_3328":67439,"_29138":67438,"_20209":111716,"_5":13819,"_26493":67438,"_2816":111717},[],"Arranca un entorno completo de evaluación o laboratorio de Lamassu en un clúster Kubernetes existente.",{"_3328":67440,"_29138":67438,"_5":29458,"_20209":111719,"_26493":111720,"_2816":111721},[],"/docs/es/deployment/self-hosted/fastlane#despliega-con-fastlane","Despliega con Fastlane",{"_3328":67441,"_29138":67438,"_5":29458,"_20209":111723,"_26493":111724,"_2816":111725},[],"/docs/es/deployment/self-hosted/fastlane#qué-añade-fastlane","Qué añade Fastlane",{"_3328":67442,"_29138":67438,"_5":29458,"_20209":111727,"_26493":111728,"_2816":111729},[],"/docs/es/deployment/self-hosted/fastlane#antes-de-comenzar","Antes de comenzar",{"_3328":67443,"_29138":67438,"_5":29458,"_20209":111731,"_26493":111732,"_2816":111733},[],"/docs/es/deployment/self-hosted/fastlane#inicio-rápido","Inicio rápido",{"_3328":67444,"_29138":67438,"_5":29458,"_20209":111735,"_26493":111736,"_2816":111737},[],"/docs/es/deployment/self-hosted/fastlane#selección-de-la-dirección-del-gateway","Selección de la dirección del Gateway",{"_3328":67445,"_29138":67438,"_5":29458,"_20209":111739,"_26493":111740,"_2816":111741},[],"/docs/es/deployment/self-hosted/fastlane#opciones-de-línea-de-comandos","Opciones de línea de comandos",{"_3328":67446,"_29138":67438,"_5":29458,"_20209":111743,"_26493":111744,"_2816":111745},[],"/docs/es/deployment/self-hosted/fastlane#modo-de-desarrollo","Modo de desarrollo",{"_3328":67447,"_29138":67438,"_5":29458,"_20209":111747,"_26493":111748,"_2816":111749},[],"/docs/es/deployment/self-hosted/fastlane#qué-configura-el-script","Qué configura el script",{"_3328":67448,"_29138":67438,"_5":29458,"_20209":111751,"_26493":111752,"_2816":111753},[],"/docs/es/deployment/self-hosted/fastlane#comportamiento-tls","Comportamiento TLS",{"_3328":67449,"_29138":67438,"_5":29458,"_20209":111755,"_26493":111756,"_2816":111757},[],"/docs/es/deployment/self-hosted/fastlane#credenciales-y-archivos-generados","Credenciales y archivos generados",{"_3328":67450,"_29138":67438,"_5":29458,"_20209":111759,"_26493":111760,"_2816":111761},[],"/docs/es/deployment/self-hosted/fastlane#verifica-la-instalación","Verifica la instalación",{"_3328":67451,"_29138":67438,"_20209":111763,"_5":13819,"_26493":111720,"_2816":111764},[],"Fastlane es el camino automatizado para evaluaciones, demos, CI y pequeños clústeres de laboratorio. Instala PostgreSQL, Keycloak, RabbitMQ, Envoy Gateway y Lamassu, y los configura para trabajar juntos.",{"_3328":67452,"_29138":67438,"_20209":111766,"_5":13819,"_26493":111720,"_2816":111767},[],"Para producción, usa Helm para mantener explícitas las decisiones de base de datos, identidad, credenciales, certificados, almacenamiento y upgrades.",{"_3328":67453,"_29138":67438,"_20209":111769,"_5":13819,"_26493":111724,"_2816":111770},[],"Fastlane cubre algunas de las dependencias que el chart de aplicación deja deliberadamente fuera:",{"_3328":67454,"_29138":67438,"_20209":111772,"_5":13819,"_26493":111724,"_2816":111773},[],"Fastlane instala o configura",{"_3328":67455,"_29138":67438,"_20209":111775,"_5":13819,"_26493":111724,"_2816":111776},[],"Tú sigues proporcionando",{"_3328":67456,"_29138":67438,"_20209":111778,"_5":13819,"_26493":111724,"_2816":111779},[],"Instancias de PostgreSQL, RabbitMQ y Keycloak para evaluación",{"_3328":67457,"_29138":67438,"_20209":111781,"_5":13819,"_26493":111724,"_2816":111782},[],"El clúster Kubernetes, sus nodos y el almacenamiento persistente",{"_3328":67458,"_29138":67438,"_20209":111784,"_5":13819,"_26493":111724,"_2816":111785},[],"Envoy Gateway 1.8 y la `GatewayClass` `eg`",{"_3328":67459,"_29138":67438,"_20209":111787,"_5":13819,"_26493":111724,"_2816":111788},[],"cert-manager, accesibilidad desde la red externa, DNS y reglas de firewall/NAT",{"_3328":67460,"_29138":67438,"_20209":111790,"_5":13819,"_26493":111724,"_2816":111791},[],"Un flujo de certificado self-signed para Lamassu, credenciales generadas para las dependencias y un usuario inicial",{"_3328":67461,"_29138":67438,"_20209":111793,"_5":13819,"_26493":111724,"_2816":111794},[],"Confianza de los clientes en la CA self-signed, o un certificado de confianza pasado al script",{"_3328":67462,"_29138":67438,"_20209":111796,"_5":13819,"_26493":111724,"_2816":111797},[],"Componentes opcionales de observabilidad y HSM de laboratorio",{"_3328":67463,"_29138":67438,"_20209":111799,"_5":13819,"_26493":111724,"_2816":111800},[],"Retención de monitorización, backups, HA y un HSM/servicio de claves de producción",{"_3328":67464,"_29138":67438,"_20209":111802,"_5":13819,"_26493":111724,"_2816":111803},[],"Fastlane no convierte el stack en un servicio de producción: no crea el clúster, DNS público, reglas de firewall, backups, alta disponibilidad ni un certificado público de confianza.",{"_3328":67465,"_29138":67438,"_20209":111805,"_5":13819,"_26493":111728,"_2816":111806},[],"Necesitas:",{"_3328":67466,"_29138":67438,"_20209":111808,"_5":13819,"_26493":111728,"_2816":111809},[],"un clúster Kubernetes existente",{"_3328":67467,"_29138":67438,"_20209":111811,"_5":13819,"_26493":111728,"_2816":111812},[],"`kubectl` y Helm, o la CLI de MicroK8s",{"_3328":67468,"_29138":67438,"_20209":111814,"_5":13819,"_26493":111728,"_2816":47743},[],{"_3328":67469,"_29138":67438,"_20209":111816,"_5":13819,"_26493":111728,"_2816":22856},[],{"_3328":67470,"_29138":67438,"_20209":111818,"_5":13819,"_26493":111728,"_2816":111819},[],"`jq` solo si usas `--sample-data` o `--development`",{"_3328":67471,"_29138":67438,"_20209":111821,"_5":13819,"_26493":111728,"_2816":111822},[],"`ssh-keygen` solo si usas `--with-hsm`",{"_3328":67472,"_29138":67438,"_20209":111824,"_5":13819,"_26493":111728,"_2816":111825},[],"los puertos externos 80 y 443 libres en un host K3s de un único nodo",{"_3328":67473,"_29138":67438,"_20209":111827,"_5":13819,"_26493":111728,"_2816":111828},[],"Fastlane detecta MicroK8s, K3s, kind o un kubeconfig estándar. Usa `--context` cuando el clúster deseado no sea el contexto actual.",{"_3328":67474,"_29138":67438,"_20209":111830,"_5":13819,"_26493":111728,"_2816":111831},[],"Fastlane instala varios componentes y crea credenciales. Comprueba `kubectl config current-context` o pasa `--context` antes de ejecutarlo.",{"_3328":67475,"_29138":67438,"_20209":111833,"_5":13819,"_26493":111732,"_2816":111834},[],"Ejecuta el script desde un clon del repositorio Helm:",{"_3328":67476,"_29138":67438,"_20209":111836,"_5":13819,"_26493":111732,"_2816":111837},[],"Crea un registro DNS para el dominio elegido antes de probar desde otra máquina. En una VM pequeña, apúntalo a la dirección de la VM o del balanceador que realmente recibe los puertos 80 y 443.",{"_3328":67477,"_29138":67438,"_20209":111839,"_5":13819,"_26493":111736,"_2816":111840},[],"Por defecto, Fastlane ejecuta `hostname -I` y escribe las direcciones devueltas en `gateway.addresses` y en los SAN IP del certificado self-signed.",{"_3328":67478,"_29138":67438,"_20209":111842,"_5":13819,"_26493":111736,"_2816":111843},[],"En una VM de laboratorio con una única interfaz puede seleccionar la dirección esperada. En hosts con Docker, VPN, WireGuard o varias interfaces también puede elegir direcciones inaccesibles para los clientes. Sobrescribe el resultado:",{"_3328":67479,"_29138":67438,"_20209":111845,"_5":13819,"_26493":111736,"_2816":111846},[],"El valor debe ser una dirección gestionada en el lado Kubernetes de la ruta. Si una IP pública de EC2 reenvía tráfico por WireGuard, pasa la dirección accesible de la VM o clúster, no la IP pública de EC2.",{"_3328":67480,"_29138":67438,"_20209":111848,"_5":13819,"_26493":111736,"_2816":111849},[],"Consulta Expón el Gateway para los conflictos de puertos de K3s, VIP, NAT externo y diseños con varios Gateways.",{"_3328":67481,"_29138":67438,"_20209":111851,"_5":13819,"_26493":111740,"_2816":111852},[],"Opción",{"_3328":67482,"_29138":67438,"_20209":111854,"_5":13819,"_26493":111740,"_2816":111855},[],"Valor predeterminado",{"_3328":67483,"_29138":67438,"_20209":111857,"_5":13819,"_26493":111740,"_2816":111858},[],"Propósito",{"_3328":67484,"_29138":67438,"_20209":111860,"_5":13819,"_26493":111740,"_2816":47790},[],{"_3328":67485,"_29138":67438,"_20209":111862,"_5":13819,"_26493":111740,"_2816":47793},[],{"_3328":67486,"_29138":67438,"_20209":111864,"_5":13819,"_26493":111740,"_2816":111865},[],"Muestra la ayuda",{"_3328":67487,"_29138":67438,"_20209":111867,"_5":13819,"_26493":111740,"_2816":47799},[],{"_3328":67488,"_29138":67438,"_20209":111869,"_5":13819,"_26493":111740,"_2816":111870},[],"contexto actual",{"_3328":67489,"_29138":67438,"_20209":111872,"_5":13819,"_26493":111740,"_2816":111873},[],"Selecciona el contexto de kubeconfig para kubectl y Helm",{"_3328":67490,"_29138":67438,"_20209":111875,"_5":13819,"_26493":111740,"_2816":47808},[],{"_3328":67491,"_29138":67438,"_20209":111877,"_5":13819,"_26493":111740,"_2816":6245},[],{"_3328":67492,"_29138":67438,"_20209":111879,"_5":13819,"_26493":111740,"_2816":111880},[],"Omite prompts y genera credenciales para las dependencias",{"_3328":67493,"_29138":67438,"_20209":111882,"_5":13819,"_26493":111740,"_2816":47816},[],{"_3328":67494,"_29138":67438,"_20209":111884,"_5":13819,"_26493":111740,"_2816":47819},[],{"_3328":67495,"_29138":67438,"_20209":111886,"_5":13819,"_26493":111740,"_2816":111887},[],"Namespace de la instalación",{"_3328":67496,"_29138":67438,"_20209":111889,"_5":13819,"_26493":111740,"_2816":47825},[],{"_3328":67497,"_29138":67438,"_20209":111891,"_5":13819,"_26493":111740,"_2816":47828},[],{"_3328":67498,"_29138":67438,"_20209":111893,"_5":13819,"_26493":111740,"_2816":111894},[],"Dominio usado por la UI, OIDC y el certificado",{"_3328":67499,"_29138":67438,"_20209":111896,"_5":13819,"_26493":111740,"_2816":47834},[],{"_3328":67500,"_29138":67438,"_20209":111898,"_5":13819,"_26493":111740,"_2816":14491},[],{"_3328":67501,"_29138":67438,"_20209":111900,"_5":13819,"_26493":111740,"_2816":111901},[],"Versión del chart de Lamassu",{"_3328":67502,"_29138":67438,"_20209":111903,"_5":13819,"_26493":111740,"_2816":47842},[],{"_3328":67503,"_29138":67438,"_20209":111905,"_5":13819,"_26493":111740,"_2816":47845},[],{"_3328":67504,"_29138":67438,"_20209":111907,"_5":13819,"_26493":111740,"_2816":111908},[],"Puerto del listener HTTPS",{"_3328":67505,"_29138":67438,"_20209":111910,"_5":13819,"_26493":111740,"_2816":47851},[],{"_3328":67506,"_29138":67438,"_20209":111912,"_5":13819,"_26493":111740,"_2816":47854},[],{"_3328":67507,"_29138":67438,"_20209":111914,"_5":13819,"_26493":111740,"_2816":111915},[],"Puerto del listener HTTP",{"_3328":67508,"_29138":67438,"_20209":111917,"_5":13819,"_26493":111740,"_2816":47860},[],{"_3328":67509,"_29138":67438,"_20209":111919,"_5":13819,"_26493":111740,"_2816":47793},[],{"_3328":67510,"_29138":67438,"_20209":111921,"_5":13819,"_26493":111740,"_2816":111922},[],"Certificado PEM para TLS downstream",{"_3328":67511,"_29138":67438,"_20209":111924,"_5":13819,"_26493":111740,"_2816":47868},[],{"_3328":67512,"_29138":67438,"_20209":111926,"_5":13819,"_26493":111740,"_2816":47793},[],{"_3328":67513,"_29138":67438,"_20209":111928,"_5":13819,"_26493":111740,"_2816":111929},[],"Clave privada PEM para TLS downstream",{"_3328":67514,"_29138":67438,"_20209":111931,"_5":13819,"_26493":111740,"_2816":47876},[],{"_3328":67515,"_29138":67438,"_20209":111933,"_5":13819,"_26493":111740,"_2816":111934},[],"chart del repositorio",{"_3328":67516,"_29138":67438,"_20209":111936,"_5":13819,"_26493":111740,"_2816":111937},[],"Usa un chart local de Lamassu sin empaquetar",{"_3328":67517,"_29138":67438,"_20209":111939,"_5":13819,"_26493":111740,"_2816":47885},[],{"_3328":67518,"_29138":67438,"_20209":111941,"_5":13819,"_26493":111740,"_2816":111942},[],"detección automática",{"_3328":67519,"_29138":67438,"_20209":111944,"_5":13819,"_26493":111740,"_2816":111945},[],"Sobrescribe la dirección escrita en `gateway.addresses`",{"_3328":67520,"_29138":67438,"_20209":111947,"_5":13819,"_26493":111740,"_2816":47893},[],{"_3328":67521,"_29138":67438,"_20209":111949,"_5":13819,"_26493":111740,"_2816":6245},[],{"_3328":67522,"_29138":67438,"_20209":111951,"_5":13819,"_26493":111740,"_2816":111952},[],"Instala Victoria Logs, VictoriaTraces, Jaeger y un OpenTelemetry Collector",{"_3328":67523,"_29138":67438,"_20209":111954,"_5":13819,"_26493":111740,"_2816":47901},[],{"_3328":67524,"_29138":67438,"_20209":111956,"_5":13819,"_26493":111740,"_2816":6245},[],{"_3328":67525,"_29138":67438,"_20209":111958,"_5":13819,"_26493":111740,"_2816":111959},[],"Modo desarrollo: provisiona completamente el usuario `lamassu` de Keycloak (contraseña fija `lamassu`/`lamassu`, sin pasos en el primer inicio) y permite al cliente `frontend` aceptar cualquier redirect URI u origen web. No es para producción",{"_3328":67526,"_29138":67438,"_20209":111961,"_5":13819,"_26493":111740,"_2816":47909},[],{"_3328":67527,"_29138":67438,"_20209":111963,"_5":13819,"_26493":111740,"_2816":6245},[],{"_3328":67528,"_29138":67438,"_20209":111965,"_5":13819,"_26493":111740,"_2816":111966},[],"Crea CA, perfiles, certificados, DMS y dispositivos de ejemplo",{"_3328":67529,"_29138":67438,"_20209":111968,"_5":13819,"_26493":111740,"_2816":47917},[],{"_3328":67530,"_29138":67438,"_20209":111970,"_5":13819,"_26493":111740,"_2816":6245},[],{"_3328":67531,"_29138":67438,"_20209":111972,"_5":13819,"_26493":111740,"_2816":111973},[],"Instala componentes HSM de laboratorio y configura KMS con PKCS#11",{"_3328":67532,"_29138":67438,"_20209":111975,"_5":13819,"_26493":111740,"_2816":47925},[],{"_3328":67533,"_29138":67438,"_20209":111977,"_5":13819,"_26493":111740,"_2816":47928},[],{"_3328":67534,"_29138":67438,"_20209":111979,"_5":13819,"_26493":111740,"_2816":111980},[],"Usa otro chart local de SoftHSM",{"_3328":67535,"_29138":67438,"_20209":111982,"_5":13819,"_26493":111740,"_2816":111983},[],"Fastlane no ofrece un modo offline. Para entornos sin conexión, usa el flujo manual con Helm y prepara un registro y mirror de charts.",{"_3328":67536,"_29138":67438,"_20209":111985,"_5":13819,"_26493":111744,"_2816":111986},[],"`--development` ajusta el realm `lamassu` de Keycloak que genera Fastlane para un entorno de evaluación desechable:",{"_3328":67537,"_29138":67438,"_20209":111988,"_5":13819,"_26493":111744,"_2816":111989},[],"el usuario `lamassu` queda completamente provisionado (nombre Lamassu, apellido Admin, email `lamassu@lamassu.io`, verificado): no hay pasos de perfil ni de cambio de contraseña en el primer inicio de sesión",{"_3328":67538,"_29138":67438,"_20209":111991,"_5":13819,"_26493":111744,"_2816":111992},[],"la contraseña conocida `lamassu`/`lamassu` es fija y permanente: no se rota nunca y concede el rol `pki-admin`, incluidos tokens no interactivos a través del cliente `frontend`",{"_3328":67539,"_29138":67438,"_20209":111994,"_5":13819,"_26493":111744,"_2816":111995},[],"el cliente `frontend` acepta cualquier redirect URI y cualquier origen web (`*`) en lugar de los patrones `/*` originales",{"_3328":67540,"_29138":67438,"_20209":111997,"_5":13819,"_26493":111744,"_2816":111998},[],"Con `--development`, la contraseña fija `lamassu`/`lamassu` concede acceso `pki-admin` a cualquiera que alcance la instalación. No lo uses nunca en nada expuesto más allá de una máquina de desarrollo o de un host accesible por red.",{"_3328":67541,"_29138":67438,"_20209":112000,"_5":13819,"_26493":111744,"_2816":112001},[],"`--development` se aplica cuando el realm `lamassu` se importa por primera vez. No modifica un clúster existente. Puede combinarse con `--sample-data`: la transformación de desarrollo se ejecuta primero y después se añaden los datos de ejemplo a la misma configuración del realm.",{"_3328":67542,"_29138":67438,"_20209":112003,"_5":13819,"_26493":111748,"_2816":47955},[],{"_3328":67543,"_29138":67438,"_20209":112005,"_5":13819,"_26493":111748,"_2816":112006},[],"valida las herramientas locales y el clúster seleccionado",{"_3328":67544,"_29138":67438,"_20209":112008,"_5":13819,"_26493":111748,"_2816":112009},[],"instala o actualiza Envoy Gateway 1.8 y crea la `GatewayClass` `eg`",{"_3328":67545,"_29138":67438,"_20209":112011,"_5":13819,"_26493":111748,"_2816":112012},[],"crea el namespace",{"_3328":67546,"_29138":67438,"_20209":112014,"_5":13819,"_26493":111748,"_2816":112015},[],"instala PostgreSQL y crea las bases de datos necesarias",{"_3328":67547,"_29138":67438,"_20209":112017,"_5":13819,"_26493":111748,"_2816":112018},[],"instala Keycloak y crea el realm `lamassu`, el cliente frontend, el rol administrador y el usuario inicial",{"_3328":67548,"_29138":67438,"_20209":112020,"_5":13819,"_26493":111748,"_2816":112021},[],"instala RabbitMQ",{"_3328":67549,"_29138":67438,"_20209":112023,"_5":13819,"_26493":111748,"_2816":112024},[],"instala opcionalmente observabilidad y componentes HSM de laboratorio",{"_3328":67550,"_29138":67438,"_20209":112026,"_5":13819,"_26493":111748,"_2816":112027},[],"genera `lamassu.yaml` e instala el chart de Lamassu",{"_3328":67551,"_29138":67438,"_20209":112029,"_5":13819,"_26493":111748,"_2816":112030},[],"carga datos de ejemplo opcionalmente",{"_3328":67552,"_29138":67438,"_20209":112032,"_5":13819,"_26493":111748,"_2816":112033},[],"La configuración generada expone Keycloak en `/auth` a través del mismo Gateway y provisiona al usuario inicial `lamassu` como superadministrador de Lamassu.",{"_3328":67553,"_29138":67438,"_20209":112035,"_5":13819,"_26493":111752,"_2816":112036},[],"Al proporcionar `--tls-crt` y `--tls-key`, Fastlane crea el Secret `downstream-provided-crt` y configura `tls.type: external`.",{"_3328":67554,"_29138":67438,"_20209":112038,"_5":13819,"_26493":111752,"_2816":112039},[],"Sin ellos, configura cert-manager con un emisor self-signed. Es adecuado para laboratorio, pero los clientes no confiarán en él hasta que distribuyas la CA. Usa Helm si necesitas un Issuer corporativo, un emisor ACME público o un Secret existente gestionado por otro sistema.",{"_3328":67555,"_29138":67438,"_20209":112041,"_5":13819,"_26493":111756,"_2816":112042},[],"El modo no interactivo genera contraseñas aleatorias para los administradores de PostgreSQL, RabbitMQ y Keycloak. El acceso inicial a Lamassu es `lamassu` / `lamassu` y obliga a cambiar la contraseña en el primer uso, salvo que se haya usado `--development`: en ese caso la contraseña permanece fija y permanente.",{"_3328":67556,"_29138":67438,"_20209":112044,"_5":13819,"_26493":111756,"_2816":112045},[],"Fastlane escribe `lamassu.yaml` en el directorio actual e incluye credenciales en él.",{"_3328":67557,"_29138":67438,"_20209":112047,"_5":13819,"_26493":111756,"_2816":112048},[],"Protege el archivo de valores generado, guarda las credenciales en un almacén de secretos apropiado y no reutilices la configuración de identidad de evaluación en producción.",{"_3328":67558,"_29138":67438,"_20209":112050,"_5":13819,"_26493":111760,"_2816":112051},[],"Abre `https://pki.example.com` e inicia sesión con el usuario inicial. Si el Gateway está programado pero la URL no es accesible, sigue las comprobaciones de Expón el Gateway.",{"_3328":67559,"_29138":67559,"_5":14177,"_2816":112053,"_29461":112054,"_20209":112055,"_26493":67559},"Instala con Helm",[47397,111479,111713],[],{"_3328":67560,"_29138":67559,"_20209":112057,"_5":13819,"_26493":67559,"_2816":112058},[],"Prepara las dependencias, configura el chart de Lamassu y verifica un despliegue controlado en Kubernetes.",{"_3328":67561,"_29138":67559,"_5":29458,"_20209":112060,"_26493":112061,"_2816":112062},[],"/docs/es/deployment/self-hosted/helm#instala-lamassu-con-helm","Instala Lamassu con Helm",{"_3328":67562,"_29138":67559,"_5":29458,"_20209":112064,"_26493":112065,"_2816":111729},[],"/docs/es/deployment/self-hosted/helm#antes-de-comenzar",{"_3328":67563,"_29138":67559,"_5":29458,"_20209":112067,"_26493":112068,"_2816":112069},[],"/docs/es/deployment/self-hosted/helm#1-instala-los-requisitos-del-gateway","1\\. Instala los requisitos del Gateway",{"_3328":67564,"_29138":67559,"_5":29458,"_20209":112071,"_26493":112072,"_2816":112073},[],"/docs/es/deployment/self-hosted/helm#2-crea-un-archivo-de-valores","2\\. Crea un archivo de valores",{"_3328":67565,"_29138":67559,"_5":29458,"_20209":112075,"_26493":112076,"_2816":112077},[],"/docs/es/deployment/self-hosted/helm#tls-con-un-secret-existente","TLS con un Secret existente",{"_3328":67566,"_29138":67559,"_5":29458,"_20209":112079,"_26493":112080,"_2816":112081},[],"/docs/es/deployment/self-hosted/helm#tls-de-amqp-amqps","TLS de AMQP (AMQPS)",{"_3328":67567,"_29138":67559,"_5":29458,"_20209":112083,"_26493":112084,"_2816":112085},[],"/docs/es/deployment/self-hosted/helm#provisiona-el-primer-administrador","Provisiona el primer administrador",{"_3328":67568,"_29138":67559,"_5":29458,"_20209":112087,"_26493":112088,"_2816":112089},[],"/docs/es/deployment/self-hosted/helm#3-instala-lamassu","3\\. Instala Lamassu",{"_3328":67569,"_29138":67559,"_5":29458,"_20209":112091,"_26493":112092,"_2816":112093},[],"/docs/es/deployment/self-hosted/helm#4-verifica-el-despliegue","4\\. Verifica el despliegue",{"_3328":67570,"_29138":67559,"_5":29458,"_20209":112095,"_26493":112096,"_2816":112097},[],"/docs/es/deployment/self-hosted/helm#actualiza-lamassu","Actualiza Lamassu",{"_3328":67571,"_29138":67559,"_5":29458,"_20209":112099,"_26493":112100,"_2816":112101},[],"/docs/es/deployment/self-hosted/helm#decisiones-para-producción","Decisiones para producción",{"_3328":67572,"_29138":67559,"_20209":112103,"_5":13819,"_26493":112061,"_2816":112104},[],"Usa Helm cuando necesites control explícito sobre identidad, bases de datos, mensajería, certificados, almacenamiento y upgrades. Para un entorno de evaluación en el que el script pueda tomar esas decisiones, usa Fastlane.",{"_3328":67573,"_29138":67559,"_20209":112106,"_5":13819,"_26493":112065,"_2816":112107},[],"Prepara los servicios de plataforma que quedan deliberadamente fuera del chart de Lamassu:",{"_3328":67574,"_29138":67559,"_20209":112109,"_5":13819,"_26493":112065,"_2816":112110},[],"un clúster Kubernetes 1.24+ y Helm 3.2+",{"_3328":67575,"_29138":67559,"_20209":112112,"_5":13819,"_26493":112065,"_2816":112113},[],"un servidor PostgreSQL accesible y un rol autorizado para crear bases de datos y schemas",{"_3328":67576,"_29138":67559,"_20209":112115,"_5":13819,"_26493":112065,"_2816":112116},[],"un broker RabbitMQ accesible y sus credenciales",{"_3328":67577,"_29138":67559,"_20209":112118,"_5":13819,"_26493":112065,"_2816":112119},[],"un proveedor OIDC, normalmente Keycloak, con un realm/tenant y un cliente para Lamassu",{"_3328":67578,"_29138":67559,"_20209":112121,"_5":13819,"_26493":112065,"_2816":112122},[],"Envoy Gateway 1.8+ y una `GatewayClass`",{"_3328":67579,"_29138":67559,"_20209":112124,"_5":13819,"_26493":112065,"_2816":112125},[],"cert-manager 1.14+ (solo para el modo predeterminado `tls.type: certManager`); para TLS de confianza, un emisor de confianza o un Secret TLS de Kubernetes",{"_3328":67580,"_29138":67559,"_20209":112127,"_5":13819,"_26493":112065,"_2816":112128},[],"una StorageClass y un diseño de tráfico externo",{"_3328":67581,"_29138":67559,"_20209":112130,"_5":13819,"_26493":112065,"_2816":112131},[],"El chart usa por defecto una `GatewayClass` llamada `eg`. Cambia `gateway.className` si tu equipo de plataforma utiliza otro nombre.",{"_3328":67582,"_29138":67559,"_20209":112133,"_5":13819,"_26493":112065,"_2816":112134},[],"Tú proporcionas el servidor PostgreSQL. El job de pre-install del chart se conecta con las credenciales indicadas, crea las bases de datos `pki`, `authz` y `wfx` y los schemas de los servicios, ejecuta las migraciones y aplica `services.authz.bootstrap`.",{"_3328":67583,"_29138":67559,"_20209":112136,"_5":13819,"_26493":112065,"_2816":112137},[],"El chart no tiene dependencias Helm que instalen PostgreSQL, RabbitMQ, un proveedor OIDC, Envoy Gateway ni cert-manager.",{"_3328":67584,"_29138":67559,"_20209":112139,"_5":13819,"_26493":112068,"_2816":112140},[],"Instala o actualiza las CRD de Envoy Gateway antes de su controlador. Estos comandos usan la misma versión que el repositorio Helm de Lamassu:",{"_3328":67585,"_29138":67559,"_20209":112142,"_5":13819,"_26493":112068,"_2816":112143},[],"Crea la `GatewayClass` predeterminada si todavía no existe. Guarda este manifiesto como `gateway-class.yaml`:",{"_3328":67586,"_29138":67559,"_20209":112145,"_5":13819,"_26493":112068,"_2816":112146},[],"Instala cert-manager por separado antes de Lamassu, pero solo para el modo predeterminado `tls.type: certManager`. En ese modo el chart renderiza sus recursos de Issuer self-signed y Certificate CA tanto si `tls.certManagerOptions.clusterIssuer` está definido como si no, por lo que cert-manager sigue siendo un requisito. Con `tls.type: external`, el chart no renderiza recursos de cert-manager y el Gateway termina el TLS con un Secret existente que tú proporcionas.",{"_3328":67587,"_29138":67559,"_20209":112148,"_5":13819,"_26493":112072,"_2816":112149},[],"Parte de los valores predeterminados del chart y sobrescribe los específicos del entorno. Este ejemplo supone que PostgreSQL, RabbitMQ y Keycloak son accesibles mediante DNS de Kubernetes y expone Keycloak en `/auth` a través del Gateway compartido:",{"_3328":67588,"_29138":67559,"_20209":112151,"_5":13819,"_26493":112072,"_2816":112152},[],"No añadas `gateway.addresses` por defecto. Deja la asignación de dirección a la implementación del balanceador salvo que tu diseño de red requiera una VIP concreta en Kubernetes. La IP pública de un NAT o proxy upstream no corresponde a este valor.",{"_3328":67589,"_29138":67559,"_20209":112154,"_5":13819,"_26493":112072,"_2816":112155},[],"Si Keycloak es externo y ya tiene una URL accesible, apunta la configuración OIDC hacia él y omite la entrada `/auth` de `gateway.extraRouting`.",{"_3328":67590,"_29138":67559,"_20209":112157,"_5":13819,"_26493":112072,"_2816":112158},[],"Si tu archivo de valores aún contiene los ajustes heredados de validación JWT del Gateway — `auth.oidc.apiGateway.jwks`, `auth.authorization.rolesClaim` o `auth.authorization.roles.admin` — elimínalos. La guía de migración `charts/lamassu/CHANGELOG/3.8.0->4.0.0.md` documenta su eliminación sin alias de compatibilidad, y `values.schema.json` rechaza los bloques residuales en lugar de ignorarlos silenciosamente. Los reemplazos son `services.authz.jwkUrl` y `services.authz.bootstrap`, que ya aparecen en el ejemplo anterior.",{"_3328":67591,"_29138":67559,"_20209":112160,"_5":13819,"_26493":112076,"_2816":112161},[],"Crea un Secret con `tls.crt` y `tls.key` y referéncialo. El Secret debe existir antes de instalar: en modo `external` el chart no renderiza recursos de cert-manager ni crea nunca este Secret.",{"_3328":67592,"_29138":67559,"_20209":112163,"_5":13819,"_26493":112080,"_2816":112164},[],"`amqp.tls: true` selecciona AMQPS en todos los bloques de configuración del bus de eventos. El puerto por defecto sigue siendo `5672` y no cambia automáticamente al habilitar TLS, así que define `amqp.port` con el listener TLS del broker, normalmente `5671`.",{"_3328":67593,"_29138":67559,"_20209":112166,"_5":13819,"_26493":112080,"_2816":112167},[],"Sin un Secret de CA configurado, los clientes del bus de eventos usan las CA de confianza del sistema. Para confiar en una CA privada, crea un Secret en el namespace del release con el certificado de la CA en formato PEM y define `amqp.ca.secretName` (y `amqp.ca.certificateKey` si la clave de datos no es `ca.crt`).",{"_3328":67594,"_29138":67559,"_20209":112169,"_5":13819,"_26493":112080,"_2816":112170},[],"Para brokers que exijan TLS mutuo, crea un Secret con el certificado de cliente y su clave privada y define `amqp.client.secretName` (con `amqp.client.certificateKey` y `amqp.client.privateKeyKey` si las claves de datos no son `tls.crt` y `tls.key`).",{"_3328":67595,"_29138":67559,"_20209":112172,"_5":13819,"_26493":112080,"_2816":112173},[],"El chart monta los Secrets configurados en modo de solo lectura en todas las cargas de trabajo que consumen AMQP: el certificado de la CA en `/etc/lamassu/amqp/ca` y el certificado y la clave de cliente en `/etc/lamassu/amqp/client`. Los nombres de los archivos montados son siempre `ca.crt`, `tls.crt` y `tls.key` — los valores `certificateKey` y `privateKeyKey` renombran solo las claves de datos del Secret, nunca las rutas en disco. La clave privada del cliente se monta con permisos restrictivos (`defaultMode: 0440`; el volumen de la CA usa `0444`), que funcionan porque el chart añade `fsGroup` al security context del pod cuando `amqp.client.secretName` está definido — usa el `runAsGroup` del contenedor (por defecto `65532`) cuando `fsGroup` no está ya definido.",{"_3328":67596,"_29138":67559,"_20209":112175,"_5":13819,"_26493":112080,"_2816":112176},[],"Ambas opciones de Secret exigen `amqp.tls: true`: `values.schema.json` rechaza un `secretName` no vacío cuando `tls` es false, rechaza claves desconocidas y rechaza nombres de clave de datos fuera de `^[A-Za-z0-9._-]+$`. El Secret referenciado debe existir en el namespace del release o los pods consumidores no llegan a arrancar.",{"_3328":67597,"_29138":67559,"_20209":112178,"_5":13819,"_26493":112080,"_2816":112179},[],"El cliente AMQP carga los certificados al arrancar, así que reinicia los pods consumidores tras actualizar cualquiera de los dos Secrets. Cambiar cualquier valor de `amqp` reinicia las cargas de trabajo consumidoras mediante la anotación `checksum/config`, pero cambiar solo el contenido de un Secret no desencadena un rollout.",{"_3328":67598,"_29138":67559,"_20209":112181,"_5":13819,"_26493":112080,"_2816":112182},[],"Según la guía de migración `charts/lamassu/CHANGELOG/3.8.0->4.0.0.md`: en 3.8.0 `amqp.tls` no se aplicaba y los clientes del bus de eventos usaban AMQP en claro; desde 4.0.0, `amqp.tls: true` los cambia a AMQPS. Define `amqp.port` con el listener TLS del broker antes del upgrade, o usa `amqp.tls: false` para mantener AMQP en claro. `amqp.tls: false` envía las credenciales del broker y todo el tráfico del bus de eventos en claro.",{"_3328":67599,"_29138":67559,"_20209":112184,"_5":13819,"_26493":112084,"_2816":112185},[],"No existe un superusuario implícito. Crea en el proveedor OIDC el rol o grupo esperado por `services.authz.bootstrap` y asígnalo al menos a un administrador antes de exponer Lamassu.",{"_3328":67600,"_29138":67559,"_20209":112187,"_5":13819,"_26493":112084,"_2816":112188},[],"El job de pre-install y pre-upgrade aplica el bootstrap de forma idempotente: conserva los principales existentes y añade los grants que falten.",{"_3328":67601,"_29138":67559,"_20209":112190,"_5":13819,"_26493":112084,"_2816":112191},[],"Prueba una identidad autorizada y otra denegada. Si ningún token coincide con un principal activo del bootstrap, nadie podrá administrar la PKI.",{"_3328":67602,"_29138":67559,"_20209":112193,"_5":13819,"_26493":112084,"_2816":112194},[],"Consulta Control de acceso para conocer el modelo de principales y políticas.",{"_3328":67603,"_29138":67559,"_20209":112196,"_5":13819,"_26493":112088,"_2816":112197},[],"Para instalar un checkout local:",{"_3328":67604,"_29138":67559,"_20209":112199,"_5":13819,"_26493":112092,"_2816":112200},[],"El Gateway debe mostrar `PROGRAMMED=True`. Si está programado pero no tiene una dirección utilizable, continúa con Expón el Gateway.",{"_3328":67605,"_29138":67559,"_20209":112202,"_5":13819,"_26493":112092,"_2816":112203},[],"El test de Helm comprueba los endpoints de salud de CA, DMS Manager, Device Manager y VA, y verifica la respuesta de la UI.",{"_3328":67606,"_29138":67559,"_20209":112205,"_5":13819,"_26493":112096,"_2816":112206},[],"Los pasos de upgrade específicos de cada versión se mantienen en `charts/lamassu/CHANGELOG/` dentro del repositorio Helm. El chart también incluye un job de pre-upgrade opcional que migra las claves privadas de CA existentes al motor KMS configurado para el release. Está desactivado por defecto (`migrations.caToKms.enabled: false`) y solo es necesario cuando actualizas desde una versión anterior a 3.7.0.",{"_3328":67607,"_29138":67559,"_20209":112208,"_5":13819,"_26493":112096,"_2816":112209},[],"Mientras el flag esté activo, cada `helm upgrade` crea el job `<chart fullname>-ca-to-kms-migration` (`lamassu-ca-to-kms-migration` para el release `lamassu`); una instalación nueva no lo crea. Su hook weight es `-10`, por lo que se ejecuta antes de los otros hooks de pre-upgrade: la configuración de bootstrap de autorización (peso `-4`) y el job de migración de base de datos (peso `-3`).",{"_3328":67608,"_29138":67559,"_20209":112211,"_5":13819,"_26493":112096,"_2816":112212},[],"El job consume la misma configuración del servicio KMS que el chart renderiza en el ConfigMap de KMS, incluidos los motores de `services.kms.cryptoEngines`, y ejecuta la imagen de la herramienta de migración definida en `migrations.caToKms.image`. La monta en modo read-only en `/etc/lamassuiot/config.yml` desde la clave `config` del ConfigMap, así que configura el motor de destino en tus valores antes del upgrade que realiza la migración.",{"_3328":67609,"_29138":67559,"_20209":112214,"_5":13819,"_26493":112096,"_2816":112215},[],"El job resuelve su configuración mediante un volumen proyectado con dos fuentes opcionales: el ConfigMap `<chart fullname>-kms-config`, cuyo nombre incorpora el release (`lamassu-kms-config` para el release `lamassu`, `prod-lamassu-kms-config` para el release `prod`), y el ConfigMap legacy `kms-config`, sin el nombre del release, creado por versiones anteriores del chart. La configuración legacy mantiene la autoridad mientras siga presente y el job usa el ConfigMap del release una vez el legacy desaparece. Ambas fuentes son opcionales, por lo que un ConfigMap ausente nunca deja el pod del upgrade en `ContainerCreating`.",{"_3328":67610,"_29138":67559,"_20209":112217,"_5":13819,"_26493":112096,"_2816":112218},[],"Mantén `migrations.caToKms.enabled: true` en el upgrade que realiza la migración y elimina después el flag de tus valores una vez completada la migración; su valor por defecto es `false`.",{"_3328":67611,"_29138":67559,"_20209":112220,"_5":13819,"_26493":112100,"_2816":112221},[],"Antes de pasar a producción, revisa:",{"_3328":67612,"_29138":67559,"_20209":112223,"_5":13819,"_26493":112100,"_2816":112224},[],"backup y recuperación de PostgreSQL y volúmenes persistentes",{"_3328":67613,"_29138":67559,"_20209":112226,"_5":13819,"_26493":112100,"_2816":112227},[],"un motor KMS de producción; el motor filesystem predeterminado no ofrece alta disponibilidad",{"_3328":67614,"_29138":67559,"_20209":112229,"_5":13819,"_26493":112100,"_2816":112230},[],"almacenamiento compartido para VA antes de aumentar sus réplicas",{"_3328":67615,"_29138":67559,"_20209":112232,"_5":13819,"_26493":112100,"_2816":112233},[],"roles OIDC gestionados y eliminación de credenciales de evaluación",{"_3328":67616,"_29138":67559,"_20209":112235,"_5":13819,"_26493":112100,"_2816":112236},[],"un emisor TLS de confianza o un certificado gestionado externamente",{"_3328":67617,"_29138":67559,"_20209":112238,"_5":13819,"_26493":112100,"_2816":112239},[],"recursos, réplicas, autoscaling, disruption budgets y placement",{"_3328":67618,"_29138":67559,"_20209":112241,"_5":13819,"_26493":112100,"_2816":112242},[],"SMTP, observabilidad y entrega de alertas",{"_3328":67619,"_29138":67559,"_20209":112244,"_5":13819,"_26493":112100,"_2816":112245},[],"las guías de actualización entre versiones y las notas de migración de `charts/lamassu/CHANGELOG/` antes de cada upgrade, incluido el hook opcional de migración CA-to-KMS descrito arriba",{"_3328":67620,"_29138":67559,"_20209":112247,"_5":13819,"_26493":112100,"_2816":112248},[],"La referencia completa de valores se mantiene en `charts/lamassu/VALUES.md` dentro del repositorio Helm.",{"_3328":67621,"_29138":67621,"_5":14177,"_2816":112250,"_29461":112251,"_20209":112252,"_26493":67621},"Expón el Gateway",[47397,111479,111713],[],{"_3328":67622,"_29138":67621,"_20209":112254,"_5":13819,"_26493":67621,"_2816":112255},[],"Elige cómo llegan los clientes a Lamassu, cuándo definir gateway.addresses y cómo diseñar varios Gateways.",{"_3328":67623,"_29138":67621,"_5":29458,"_20209":112257,"_26493":112258,"_2816":112259},[],"/docs/es/deployment/self-hosted/networking#expón-el-gateway-de-lamassu","Expón el Gateway de Lamassu",{"_3328":67624,"_29138":67621,"_5":29458,"_20209":112261,"_26493":112262,"_2816":112263},[],"/docs/es/deployment/self-hosted/networking#necesitas-gatewayaddresses","¿Necesitas `gateway.addresses`?",{"_3328":67625,"_29138":67621,"_5":29458,"_20209":112265,"_26493":112266,"_2816":112267},[],"/docs/es/deployment/self-hosted/networking#diseño-recomendado-para-un-solo-nodo","Diseño recomendado para un solo nodo",{"_3328":67626,"_29138":67621,"_5":29458,"_20209":112269,"_26493":112270,"_2816":48223},[],"/docs/es/deployment/self-hosted/networking#k3s",{"_3328":67627,"_29138":67621,"_5":29458,"_20209":112272,"_26493":112273,"_2816":112274},[],"/docs/es/deployment/self-hosted/networking#bare-metal-con-metallb-o-kube-vip","Bare metal con MetalLB o kube-vip",{"_3328":67628,"_29138":67621,"_5":29458,"_20209":112276,"_26493":112277,"_2816":112278},[],"/docs/es/deployment/self-hosted/networking#proxy-externo-nat-o-vpn","Proxy externo, NAT o VPN",{"_3328":67629,"_29138":67621,"_5":29458,"_20209":112280,"_26493":112281,"_2816":112282},[],"/docs/es/deployment/self-hosted/networking#qué-ocurre-si-necesitas-tres-gateways","¿Qué ocurre si necesitas tres Gateways?",{"_3328":67630,"_29138":67621,"_5":29458,"_20209":112284,"_26493":112285,"_2816":112286},[],"/docs/es/deployment/self-hosted/networking#guía-de-decisión","Guía de decisión",{"_3328":67631,"_29138":67621,"_5":29458,"_20209":112288,"_26493":112289,"_2816":112290},[],"/docs/es/deployment/self-hosted/networking#proxy-de-salida","Proxy de salida",{"_3328":67632,"_29138":67621,"_5":29458,"_20209":112292,"_26493":112293,"_2816":112294},[],"/docs/es/deployment/self-hosted/networking#verifica-la-ruta-de-tráfico","Verifica la ruta de tráfico",{"_3328":67633,"_29138":67621,"_20209":112296,"_5":13819,"_26493":112258,"_2816":112297},[],"El chart de Lamassu crea un Gateway compartido con listeners HTTP y HTTPS. Envoy Gateway crea normalmente un deployment de proxy dedicado y un Service `LoadBalancer`.",{"_3328":67634,"_29138":67621,"_20209":112299,"_5":13819,"_26493":112258,"_2816":112300},[],"La accesibilidad externa depende de toda la ruta. Un recurso `Gateway` no configura por sí mismo el router, firewall, DNS, balanceador cloud ni NAT upstream.",{"_3328":67635,"_29138":67621,"_20209":112302,"_5":13819,"_26493":112262,"_2816":112303},[],"Normalmente no. Si lo omites, el controlador del Gateway y la implementación del balanceador pueden asignar una dirección y publicarla en `Gateway.status.addresses` y en el estado del Service generado.",{"_3328":67636,"_29138":67621,"_20209":112305,"_5":13819,"_26493":112262,"_2816":112306},[],"Defínelo únicamente cuando:",{"_3328":67637,"_29138":67621,"_20209":112308,"_5":13819,"_26493":112262,"_2816":112309},[],"tu balanceador cloud o bare metal permite solicitar una dirección concreta",{"_3328":67638,"_29138":67621,"_20209":112311,"_5":13819,"_26493":112262,"_2816":112312},[],"esa dirección está asignada a este Gateway",{"_3328":67639,"_29138":67621,"_20209":112314,"_5":13819,"_26493":112262,"_2816":112315},[],"la red ya enruta el tráfico de esa dirección hasta el clúster",{"_3328":67640,"_29138":67621,"_20209":112317,"_5":13819,"_26493":112262,"_2816":112318},[],"Esto solicita `192.168.1.50`; no reclama la IP en tu LAN ni la vuelve accesible.",{"_3328":67641,"_29138":67621,"_20209":112320,"_5":13819,"_26493":112262,"_2816":112321},[],"No confundas estos valores:",{"_3328":67642,"_29138":67621,"_20209":112323,"_5":13819,"_26493":112262,"_2816":112324},[],"`gateway.addresses` solicita una dirección para el Gateway.",{"_3328":67643,"_29138":67621,"_20209":112326,"_5":13819,"_26493":112262,"_2816":112327},[],"`tls.certManagerOptions.certSpec.addresses` añade direcciones IP a los SAN del certificado TLS.",{"_3328":67644,"_29138":67621,"_20209":112329,"_5":13819,"_26493":112262,"_2816":112330},[],"Si los usuarios se conectan por DNS, añade el nombre a `tls.certManagerOptions.certSpec.hostnames`. No copies la IP pública de un proxy upstream en `gateway.addresses`.",{"_3328":67645,"_29138":67621,"_20209":112332,"_5":13819,"_26493":112266,"_2816":112333},[],"Para una VM pequeña con K3s o MicroK8s, usa un único Gateway externo de Lamassu y enruta todos los endpoints a través de él:",{"_3328":67646,"_29138":67621,"_20209":112335,"_5":13819,"_26493":112266,"_2816":112336},[],"Este diseño utiliza una IP, un punto de entrada TLS y un único par de puertos. El chart ya crea las rutas necesarias.",{"_3328":67647,"_29138":67621,"_20209":112338,"_5":13819,"_26493":112270,"_2816":112339},[],"K3s ServiceLB implementa cada Service `LoadBalancer` mediante pods que reservan los puertos del Service en el nodo. En un único nodo, solo un Service puede ocupar el puerto 80 y otro el 443. El Service Traefik que K3s instala por defecto puede estar ocupando ambos.",{"_3328":67648,"_29138":67621,"_20209":112341,"_5":13819,"_26493":112270,"_2816":112342},[],"Para el diseño recomendado:",{"_3328":67649,"_29138":67621,"_20209":112344,"_5":13819,"_26493":112270,"_2816":112345},[],"Usa un único Gateway de Lamassu expuesto externamente.",{"_3328":67650,"_29138":67621,"_20209":112347,"_5":13819,"_26493":112270,"_2816":112348},[],"Comprueba que los puertos 80 y 443 están libres. Deshabilita o reconfigura Traefik si no forma parte de la ruta de tráfico.",{"_3328":67651,"_29138":67621,"_20209":112350,"_5":13819,"_26493":112270,"_2816":112351},[],"Permite esos puertos en el firewall de la VM y en cualquier security group upstream.",{"_3328":67652,"_29138":67621,"_20209":112353,"_5":13819,"_26493":112270,"_2816":112354},[],"Apunta DNS a la dirección accesible de la VM.",{"_3328":67653,"_29138":67621,"_20209":112356,"_5":13819,"_26493":112270,"_2816":112357},[],"Consulta la documentación de K3s ServiceLB para conocer el uso de host ports y cómo sustituirlo por otro balanceador.",{"_3328":67654,"_29138":67621,"_20209":112359,"_5":13819,"_26493":112273,"_2816":112360},[],"Asigna una VIP de un pool accesible desde la LAN. Puedes solicitarla con `gateway.addresses` si la implementación lo permite. Confirma la dirección asignada en el estado en lugar de asumir que la solicitud tuvo éxito.",{"_3328":67655,"_29138":67621,"_20209":112362,"_5":13819,"_26493":112277,"_2816":112363},[],"Una dirección pública externa puede reenviar TCP 80 y 443 a la VM o a una VIP de Kubernetes:",{"_3328":67656,"_29138":67621,"_20209":112365,"_5":13819,"_26493":112277,"_2816":112366},[],"La IP pública pertenece al dispositivo externo. Deja `gateway.addresses` sin definir o usa la dirección real del lado de Kubernetes, nunca una IP que el clúster no pueda asociar.",{"_3328":67657,"_29138":67621,"_20209":112368,"_5":13819,"_26493":112281,"_2816":112369},[],"Primero decide si necesitas tres data planes independientes o solo tres nombres de host.",{"_3328":67658,"_29138":67621,"_20209":112371,"_5":13819,"_26493":112281,"_2816":112372},[],"Requisito",{"_3328":67659,"_29138":67621,"_20209":112374,"_5":13819,"_26493":112281,"_2816":112375},[],"Diseño recomendado",{"_3328":67660,"_29138":67621,"_20209":112377,"_5":13819,"_26493":112281,"_2816":112378},[],"Consecuencia",{"_3328":67661,"_29138":67621,"_20209":112380,"_5":13819,"_26493":112281,"_2816":112381},[],"Varias URL o servicios de Lamassu",{"_3328":67662,"_29138":67621,"_20209":112383,"_5":13819,"_26493":112281,"_2816":112384},[],"Un Gateway con varias rutas",{"_3328":67663,"_29138":67621,"_20209":112386,"_5":13819,"_26493":112281,"_2816":112387},[],"Una IP y un proxy fleet; es el comportamiento predeterminado del chart",{"_3328":67664,"_29138":67621,"_20209":112389,"_5":13819,"_26493":112281,"_2816":112390},[],"Gateways independientes e IP externas distintas",{"_3328":67665,"_29138":67621,"_20209":112392,"_5":13819,"_26493":112281,"_2816":112393},[],"Una VIP por Gateway",{"_3328":67666,"_29138":67621,"_20209":112395,"_5":13819,"_26493":112281,"_2816":112396},[],"Todos pueden usar 80/443; requiere un balanceador con un pool de direcciones",{"_3328":67667,"_29138":67621,"_20209":112398,"_5":13819,"_26493":112281,"_2816":112399},[],"Gateways independientes, un nodo y una IP",{"_3328":67668,"_29138":67621,"_20209":112401,"_5":13819,"_26493":112281,"_2816":112402},[],"Puertos externos diferentes",{"_3328":67669,"_29138":67621,"_20209":112404,"_5":13819,"_26493":112281,"_2816":112405},[],"Los clientes deben indicar puertos no estándar",{"_3328":67670,"_29138":67621,"_20209":112407,"_5":13819,"_26493":112281,"_2816":112408},[],"Terminación TLS/mTLS separada detrás de una IP",{"_3328":67671,"_29138":67621,"_20209":112410,"_5":13819,"_26493":112281,"_2816":112411},[],"Front door con enrutamiento SNI hacia Gateways internos",{"_3328":67672,"_29138":67621,"_20209":112413,"_5":13819,"_26493":112281,"_2816":112414},[],"Diseño avanzado; el front door usa TLS passthrough y cada Gateway termina su propio TLS",{"_3328":67673,"_29138":67621,"_20209":112416,"_5":13819,"_26493":112281,"_2816":112417},[],"Recursos Gateway separados pero proxy compartido",{"_3328":67674,"_29138":67621,"_20209":112419,"_5":13819,"_26493":112281,"_2816":112420},[],"Modo merged Gateway de Envoy",{"_3328":67675,"_29138":67621,"_20209":112422,"_5":13819,"_26493":112281,"_2816":112423},[],"Solo separación lógica; cada listener necesita una tupla única de puerto, protocolo y hostname",{"_3328":67676,"_29138":67621,"_20209":112425,"_5":13819,"_26493":112281,"_2816":112426},[],"Tres Services `LoadBalancer` independientes no pueden reservar a la vez los mismos puertos 80 y 443 mediante K3s ServiceLB. Usa un Gateway compartido, asigna VIP distintas con otro balanceador o utiliza puertos diferentes.",{"_3328":67677,"_29138":67621,"_20209":112428,"_5":13819,"_26493":112281,"_2816":112429},[],"Envoy Gateway provisiona normalmente un proxy fleet por `Gateway`. Su modo merged Gateway puede compartir un fleet y una dirección, pero no es un cambio directo para varias releases de Lamassu: los listeners generados usan los mismos puertos y protocolos sin hostnames distintos, por lo que entran en conflicto salvo que personalices el diseño.",{"_3328":67678,"_29138":67621,"_20209":112431,"_5":13819,"_26493":112281,"_2816":112432},[],"Usa un front door con SNI solo cuando los Gateways internos deban mantener políticas TLS o mTLS independientes:",{"_3328":67679,"_29138":67621,"_20209":112434,"_5":13819,"_26493":112281,"_2816":112435},[],"Esto requiere hostnames SNI distintos y configuración de red externa al chart de Lamassu.",{"_3328":67680,"_29138":67621,"_20209":112437,"_5":13819,"_26493":112285,"_2816":112438},[],"Si un Gateway puede gestionar TLS y el enrutamiento, usa el valor predeterminado del chart.",{"_3328":67681,"_29138":67621,"_20209":112440,"_5":13819,"_26493":112285,"_2816":112441},[],"Si los Gateways necesitan políticas independientes y puedes asignar IP, usa una VIP por Gateway.",{"_3328":67682,"_29138":67621,"_20209":112443,"_5":13819,"_26493":112285,"_2816":112444},[],"Si solo necesitas separar los recursos Kubernetes, evalúa merged Gateway y usa tuplas de listener únicas.",{"_3328":67683,"_29138":67621,"_20209":112446,"_5":13819,"_26493":112285,"_2816":112447},[],"Si los data planes y la terminación TLS deben ser independientes detrás de una IP, añade un front door con TLS passthrough y SNI.",{"_3328":67684,"_29138":67621,"_20209":112449,"_5":13819,"_26493":112285,"_2816":112450},[],"Si nada de lo anterior es posible, usa puertos externos distintos o cambia el diseño de red.",{"_3328":67685,"_29138":67621,"_20209":112452,"_5":13819,"_26493":112289,"_2816":112453},[],"Los clientes internos de Lamassu — la conexión con el motor de Vault, las llamadas entre servicios y los webhooks salientes — respetan las variables de entorno `HTTP_PROXY`, `HTTPS_PROXY` y `NO_PROXY`. La excepción es el conector del motor de autorización: usa su propio transporte y no consulta estas variables de proxy. Si tu despliegue enruta el tráfico de salida por un proxy, incluye los nombres de servicio internos del clúster en `NO_PROXY` (por ejemplo `.svc,.cluster.local`) para que el tráfico interno permanezca dentro del clúster. El tráfico de loopback nunca se envía por un proxy.",{"_3328":67686,"_29138":67621,"_20209":112455,"_5":13819,"_26493":112289,"_2816":112456},[],"El transporte predeterminado de estos clientes acota el timeout de conexión (30 segundos), el handshake TLS (10 segundos) y la reutilización de conexiones inactivas (90 segundos), de modo que una dependencia inalcanzable falla rápido en lugar de bloquearse; estos valores son los predeterminados del transporte de Go, no configuración de Lamassu. HTTP/2 se negocia cuando el otro extremo lo soporta. El conector del motor de autorización mantiene su propio transporte sin estos timeouts de conexión ni de handshake TLS; solo su timeout global de petición de 30 segundos acota cada llamada.",{"_3328":67687,"_29138":67621,"_20209":112458,"_5":13819,"_26493":112293,"_2816":112459},[],"Comprueba, en orden:",{"_3328":67688,"_29138":67621,"_20209":112461,"_5":13819,"_26493":112293,"_2816":112462},[],"El `Gateway` muestra `Accepted=True` y `Programmed=True`.",{"_3328":67689,"_29138":67621,"_20209":112464,"_5":13819,"_26493":112293,"_2816":112465},[],"Su estado contiene la dirección esperada.",{"_3328":67690,"_29138":67621,"_20209":112467,"_5":13819,"_26493":112293,"_2816":112468},[],"El Service `LoadBalancer` generado tiene una dirección externa utilizable.",{"_3328":67691,"_29138":67621,"_20209":112470,"_5":13819,"_26493":112293,"_2816":112471},[],"El puerto 443 de esa dirección es accesible desde la red del cliente.",{"_3328":67692,"_29138":67621,"_20209":112473,"_5":13819,"_26493":112293,"_2816":112474},[],"DNS resuelve al endpoint accesible externamente.",{"_3328":67693,"_29138":67621,"_20209":112476,"_5":13819,"_26493":112293,"_2816":112477},[],"El certificado contiene el nombre DNS o la IP usada por el cliente.",{"_3328":67694,"_29138":67621,"_20209":112479,"_5":13819,"_26493":112293,"_2816":112480},[],"Gateway API trata las direcciones como estado deseado que el controlador puede asignar o rechazar; consulta la introducción a Gateway API para conocer el modelo.",{"_3328":67695,"_29138":67695,"_5":14177,"_2816":47504,"_29461":112482,"_20209":112483,"_26493":67695},[47397,111479,111713],[],{"_3328":67696,"_29138":67695,"_20209":112485,"_5":13819,"_26493":67695,"_2816":112486},[],"Elige un flujo de instalación y una arquitectura de red para Lamassu en tu clúster Kubernetes.",{"_3328":67697,"_29138":67695,"_5":29458,"_20209":112488,"_26493":112489,"_2816":112490},[],"/docs/es/deployment/self-hosted/overview#despliegue-self-managed-con-kubernetes","Despliegue self-managed con Kubernetes",{"_3328":67698,"_29138":67695,"_5":29458,"_20209":112492,"_26493":112493,"_2816":112494},[],"/docs/es/deployment/self-hosted/overview#elige-un-flujo-de-instalación","Elige un flujo de instalación",{"_3328":67699,"_29138":67695,"_5":29458,"_20209":112496,"_26493":112497,"_2816":112498},[],"/docs/es/deployment/self-hosted/overview#qué-proporciona-el-chart-de-lamassu","Qué proporciona el chart de Lamassu",{"_3328":67700,"_29138":67695,"_5":29458,"_20209":112500,"_26493":112501,"_2816":112502},[],"/docs/es/deployment/self-hosted/overview#cómo-encaja-el-despliegue","Cómo encaja el despliegue",{"_3328":67701,"_29138":67695,"_5":29458,"_20209":112504,"_26493":112505,"_2816":112506},[],"/docs/es/deployment/self-hosted/overview#requisitos-de-plataforma","Requisitos de plataforma",{"_3328":67702,"_29138":67695,"_5":29458,"_20209":112508,"_26493":112509,"_2816":112510},[],"/docs/es/deployment/self-hosted/overview#elige-la-siguiente-página","Elige la siguiente página",{"_3328":67703,"_29138":67695,"_20209":112512,"_5":13819,"_26493":112489,"_2816":112513},[],"Ejecuta Lamassu en un clúster Kubernetes operado por tu equipo. El chart Helm despliega los servicios de Lamassu y sus recursos de enrutamiento; tú proporcionas el clúster, el almacenamiento persistente, el proveedor de identidad, PostgreSQL, RabbitMQ y la ruta de red utilizada por los clientes.",{"_3328":67704,"_29138":67695,"_20209":112515,"_5":13819,"_26493":112493,"_2816":112516},[],"Flujo",{"_3328":67705,"_29138":67695,"_20209":112518,"_5":13819,"_26493":112493,"_2816":112519},[],"Úsalo para",{"_3328":67706,"_29138":67695,"_20209":112521,"_5":13819,"_26493":112493,"_2816":112522},[],"Qué instala",{"_3328":67707,"_29138":67695,"_20209":112524,"_5":13819,"_26493":112493,"_2816":48478},[],{"_3328":67708,"_29138":67695,"_20209":112526,"_5":13819,"_26493":112493,"_2816":112527},[],"Producción y entornos controlados",{"_3328":67709,"_29138":67695,"_20209":112529,"_5":13819,"_26493":112493,"_2816":112530},[],"Servicios de Lamassu y recursos de Gateway API",{"_3328":67710,"_29138":67695,"_20209":112532,"_5":13819,"_26493":112493,"_2816":47641},[],{"_3328":67711,"_29138":67695,"_20209":112534,"_5":13819,"_26493":112493,"_2816":112535},[],"Evaluación, demos, CI y pequeños clústeres de laboratorio",{"_3328":67712,"_29138":67695,"_20209":112537,"_5":13819,"_26493":112493,"_2816":112538},[],"PostgreSQL, Keycloak, RabbitMQ, Envoy Gateway y Lamassu",{"_3328":67713,"_29138":67695,"_20209":112540,"_5":13819,"_26493":112497,"_2816":112541},[],"El chart de Lamassu es un **chart de aplicación**, no un chart de bootstrap del clúster. Crea los recursos Kubernetes que ejecutan y configuran Lamassu, pero espera que ya existan los servicios de plataforma de los que dependen.",{"_3328":67714,"_29138":67695,"_20209":112543,"_5":13819,"_26493":112497,"_2816":112544},[],"Área",{"_3328":67715,"_29138":67695,"_20209":112546,"_5":13819,"_26493":112497,"_2816":112547},[],"El chart de Lamassu proporciona",{"_3328":67716,"_29138":67695,"_20209":112549,"_5":13819,"_26493":112497,"_2816":112550},[],"Tú proporcionas",{"_3328":67717,"_29138":67695,"_20209":112552,"_5":13819,"_26493":112497,"_2816":112553},[],"Aplicaciones Lamassu",{"_3328":67718,"_29138":67695,"_20209":112555,"_5":13819,"_26493":112497,"_2816":112556},[],"Deployments y StatefulSets para la UI y las APIs, Services internos, ConfigMaps, una ServiceAccount y HPA/PDB opcionales",{"_3328":67719,"_29138":67695,"_20209":112558,"_5":13819,"_26493":112497,"_2816":112559},[],"Un clúster Kubernetes operativo, capacidad de cómputo y acceso a las imágenes",{"_3328":67720,"_29138":67695,"_20209":112561,"_5":13819,"_26493":112497,"_2816":112562},[],"Datos PostgreSQL",{"_3328":67721,"_29138":67695,"_20209":112564,"_5":13819,"_26493":112497,"_2816":112565},[],"Un job de pre-install/pre-upgrade que crea las bases de datos y schemas necesarios, ejecuta migraciones y aplica el bootstrap de autorización",{"_3328":67722,"_29138":67695,"_20209":112567,"_5":13819,"_26493":112497,"_2816":112568},[],"Un servidor PostgreSQL accesible, credenciales autorizadas para crear bases de datos y schemas, y operaciones de backup/HA",{"_3328":67723,"_29138":67695,"_20209":112570,"_5":13819,"_26493":112497,"_2816":112571},[],"Mensajería",{"_3328":67724,"_29138":67695,"_20209":112573,"_5":13819,"_26493":112497,"_2816":112574},[],"Configuración de conexión a RabbitMQ para los servicios Lamassu; la conexión puede usar AMQPS, con una CA privada y un certificado de cliente opcionales, definidos mediante valores del chart",{"_3328":67725,"_29138":67695,"_20209":112576,"_5":13819,"_26493":112497,"_2816":112577},[],"Un broker RabbitMQ accesible, credenciales y la gestión de su ciclo de vida",{"_3328":67726,"_29138":67695,"_20209":112579,"_5":13819,"_26493":112497,"_2816":112580},[],"Identidad",{"_3328":67727,"_29138":67695,"_20209":112582,"_5":13819,"_26493":112497,"_2816":112583},[],"Configuración OIDC/JWT y de autorización externa, además de los principales iniciales de Lamassu",{"_3328":67728,"_29138":67695,"_20209":112585,"_5":13819,"_26493":112497,"_2816":112586},[],"Un proveedor OIDC, realm/tenant, cliente, usuarios, grupos y roles",{"_3328":67729,"_29138":67695,"_20209":112588,"_5":13819,"_26493":112497,"_2816":112589},[],"Enrutamiento externo",{"_3328":67730,"_29138":67695,"_20209":112591,"_5":13819,"_26493":112497,"_2816":112592},[],"Un `Gateway`, recursos `HTTPRoute`, una configuración `EnvoyProxy` y políticas de seguridad de Envoy",{"_3328":67731,"_29138":67695,"_20209":112594,"_5":13819,"_26493":112497,"_2816":112595},[],"Las CRD de Gateway API y Envoy, el controlador Envoy Gateway, una `GatewayClass`, un balanceador y la ruta de red externa",{"_3328":67732,"_29138":67695,"_20209":112597,"_5":13819,"_26493":112497,"_2816":48552},[],{"_3328":67733,"_29138":67695,"_20209":112599,"_5":13819,"_26493":112497,"_2816":112600},[],"En el modo predeterminado `tls.type: certManager`, recursos `Issuer` y `Certificate` CA de cert-manager y un `Certificate` downstream gestionado por el chart; en el modo `tls.type: external`, una referencia a tu Secret TLS",{"_3328":67734,"_29138":67695,"_20209":112602,"_5":13819,"_26493":112497,"_2816":112603},[],"cert-manager solo para el modo predeterminado `tls.type: certManager`; para TLS de confianza, un emisor de confianza o un Secret TLS ya poblado",{"_3328":67735,"_29138":67695,"_20209":112605,"_5":13819,"_26493":112497,"_2816":112606},[],"Datos persistentes de la aplicación",{"_3328":67736,"_29138":67695,"_20209":112608,"_5":13819,"_26493":112497,"_2816":112609},[],"PersistentVolumeClaims necesarios para el almacenamiento local predeterminado de KMS y VA",{"_3328":67737,"_29138":67695,"_20209":112611,"_5":13819,"_26493":112497,"_2816":112612},[],"Una StorageClass, almacenamiento físico, backups y un backend compartido/externo cuando el escalado lo requiera",{"_3328":67738,"_29138":67695,"_20209":112614,"_5":13819,"_26493":112497,"_2816":112615},[],"Integraciones opcionales",{"_3328":67739,"_29138":67695,"_20209":112617,"_5":13819,"_26493":112497,"_2816":112618},[],"Puntos de configuración para observabilidad, conectores AWS y conectividad PKCS#11/HSM",{"_3328":67740,"_29138":67695,"_20209":112620,"_5":13819,"_26493":112497,"_2816":112621},[],"Los backends de observabilidad, credenciales cloud y un HSM de producción o servicio externo de claves",{"_3328":67741,"_29138":67695,"_20209":112623,"_5":13819,"_26493":112497,"_2816":112624},[],"El chart crea el `Gateway` y las rutas de Lamassu. No instala el controlador Envoy Gateway ni hace que el Service `LoadBalancer` generado sea accesible desde tu red.",{"_3328":67742,"_29138":67695,"_20209":112626,"_5":13819,"_26493":112497,"_2816":112627},[],"Usa un único Gateway de Lamassu en los puertos 80 y 443 y deja que sus HTTPRoutes distribuyan el tráfico a todos los servicios. Proporciona a ese Gateway un único endpoint accesible mediante el balanceador del clúster, o reenvía tráfico desde un proxy externo o un dispositivo NAT. No necesitas un Gateway por servicio.",{"_3328":67743,"_29138":67695,"_20209":112629,"_5":13819,"_26493":112501,"_2816":112630},[],"El chart crea un `Gateway` compartido por cada release de Helm. Todos los recursos `HTTPRoute` gestionados por el chart se conectan a él. Envoy Gateway provisiona el data plane del proxy y un Service `LoadBalancer` de Kubernetes para ese Gateway.",{"_3328":67744,"_29138":67695,"_20209":112632,"_5":13819,"_26493":112501,"_2816":112633},[],"El valor `gateway.addresses` solo solicita una dirección al controlador del Gateway. No hace que una IP sea enrutable, abre un firewall, configura DNS ni crea NAT. Consulta Expón el Gateway antes de definirlo.",{"_3328":67745,"_29138":67695,"_20209":112635,"_5":13819,"_26493":112505,"_2816":112636},[],"Kubernetes 1.24 o posterior",{"_3328":67746,"_29138":67695,"_20209":112638,"_5":13819,"_26493":112505,"_2816":112639},[],"Helm 3.2 o posterior",{"_3328":67747,"_29138":67695,"_20209":112641,"_5":13819,"_26493":112505,"_2816":112642},[],"Envoy Gateway 1.8 o posterior y una `GatewayClass`",{"_3328":67748,"_29138":67695,"_20209":112644,"_5":13819,"_26493":112505,"_2816":112645},[],"cert-manager 1.14 o posterior; necesario solo para el modo TLS predeterminado `tls.type: certManager`, no para `tls.type: external`",{"_3328":67749,"_29138":67695,"_20209":112647,"_5":13819,"_26493":112505,"_2816":112648},[],"almacenamiento persistente adecuado para la configuración elegida de PostgreSQL, RabbitMQ, VA y KMS",{"_3328":67750,"_29138":67695,"_20209":112650,"_5":13819,"_26493":112505,"_2816":112651},[],"una implementación de balanceador o alguna otra ruta deliberada desde los clientes hasta el Gateway",{"_3328":67751,"_29138":67695,"_20209":112653,"_5":13819,"_26493":112505,"_2816":112654},[],"Los despliegues KMS que usan el sidecar PKCS#11 nativo requieren Kubernetes 1.29 o posterior. Las imágenes de contenedor precompiladas de Lamassu se publican para `linux/amd64` y `linux/arm64`, y el módulo cliente PKCS#11 del KMS (`p11-kit-client.so`) se instala en la ruta de biblioteca Debian de la arquitectura destino: `/usr/lib/x86_64-linux-gnu/pkcs11/p11-kit-client.so` en amd64 y `/usr/lib/aarch64-linux-gnu/pkcs11/p11-kit-client.so` en arm64. La ruta x86\\_64 se conserva como alias de compatibilidad para configuraciones existentes.",{"_3328":67752,"_29138":67695,"_20209":112656,"_5":13819,"_26493":112509,"_2816":112657},[],"<Card title=\"Instala con Helm\" description=\"Prepara dependencias, configura valores, instala y verifica un despliegue controlado.\" href=\"/docs/deployment/self-hosted/helm\" />",{"_3328":67753,"_29138":67695,"_20209":112659,"_5":13819,"_26493":112509,"_2816":112660},[],"<Card title=\"Actualiza desde 3.8.0\" description=\"Actualiza una release de Helm existente a 4.0.0: cambios de arquitectura, breaking changes, pasos de migración y validación.\" href=\"/docs/upgrades/3-8-0-to-4-0-0\" />",{"_3328":67754,"_29138":67695,"_20209":112662,"_5":13819,"_26493":112509,"_2816":112663},[],"<Card title=\"Expón el Gateway\" description=\"Elige un diseño de tráfico externo, comprende gateway.addresses y gestiona varios Gateways.\" href=\"/docs/deployment/self-hosted/networking\" />",{"_3328":67755,"_29138":67695,"_20209":112665,"_5":13819,"_26493":112509,"_2816":112666},[],"<Card title=\"Usa Fastlane\" description=\"Arranca un entorno completo de evaluación o laboratorio con un script.\" href=\"/docs/deployment/self-hosted/fastlane\" />",{"_3328":67756,"_29138":67756,"_5":14177,"_2816":112668,"_29461":112669,"_20209":112671,"_26493":67756},"Resolución de problemas de despliegue",[47397,111479,112670],"Operación",[],{"_3328":67757,"_29138":67756,"_20209":112673,"_5":13819,"_26493":67756,"_2816":112674},[],"Diagnostica acceso, salud de los servicios y dependencias de infraestructura.",{"_3328":67758,"_29138":67756,"_5":29458,"_20209":112676,"_26493":112677,"_2816":112678},[],"/docs/es/deployment/troubleshooting#secuencia-de-diagnóstico","Secuencia de diagnóstico",{"_3328":67759,"_29138":67756,"_5":29458,"_20209":112680,"_26493":112681,"_2816":112682},[],"/docs/es/deployment/troubleshooting#reproduce-una-sola-operación","Reproduce una sola operación",{"_3328":67760,"_29138":67756,"_5":29458,"_20209":112684,"_26493":112685,"_2816":112686},[],"/docs/es/deployment/troubleshooting#separa-cliente-gateway-y-servicio","Separa cliente, Gateway y servicio",{"_3328":67761,"_29138":67756,"_5":29458,"_20209":112688,"_26493":112689,"_2816":112690},[],"/docs/es/deployment/troubleshooting#revisa-el-estado-de-kubernetes","Revisa el estado de Kubernetes",{"_3328":67762,"_29138":67756,"_5":29458,"_20209":112692,"_26493":112693,"_2816":112694},[],"/docs/es/deployment/troubleshooting#consulta-el-servicio-afectado","Consulta el servicio afectado",{"_3328":67763,"_29138":67756,"_5":29458,"_20209":112696,"_26493":112697,"_2816":112698},[],"/docs/es/deployment/troubleshooting#valida-el-resultado-desde-fuera","Valida el resultado desde fuera",{"_3328":67764,"_29138":67756,"_5":29458,"_20209":112700,"_26493":112701,"_2816":112702},[],"/docs/es/deployment/troubleshooting#recogida-mínima-de-evidencias","Recogida mínima de evidencias",{"_3328":67765,"_29138":67756,"_5":29458,"_20209":112704,"_26493":112705,"_2816":112706},[],"/docs/es/deployment/troubleshooting#no-puedo-iniciar-sesión","No puedo iniciar sesión",{"_3328":67766,"_29138":67756,"_5":29458,"_20209":112708,"_26493":112709,"_2816":112710},[],"/docs/es/deployment/troubleshooting#todo-devuelve-403-o-5xx","Todo devuelve 403 o 5xx",{"_3328":67767,"_29138":67756,"_5":29458,"_20209":112712,"_26493":112713,"_2816":112714},[],"/docs/es/deployment/troubleshooting#errores-500-de-la-api","Errores 500 de la API",{"_3328":67768,"_29138":67756,"_5":29458,"_20209":112716,"_26493":112717,"_2816":112718},[],"/docs/es/deployment/troubleshooting#un-pod-no-está-ready","Un pod no está Ready",{"_3328":67769,"_29138":67756,"_5":29458,"_20209":112720,"_26493":112721,"_2816":112722},[],"/docs/es/deployment/troubleshooting#los-eventos-no-llegan","Los eventos no llegan",{"_3328":67770,"_29138":67756,"_5":29458,"_20209":112724,"_26493":112725,"_2816":112726},[],"/docs/es/deployment/troubleshooting#observabilidad","Observabilidad",{"_3328":67771,"_29138":67756,"_20209":112728,"_5":13819,"_26493":67756,"_2816":112729},[],"Empieza por localizar la capa que falla. Una respuesta del Gateway y un pod no preparado requieren evidencias distintas. Para emisión rechazada o resultados de validación, consulta el diagnóstico PKI; para enrolamiento, el diagnóstico EST.",{"_3328":67772,"_29138":67756,"_20209":112731,"_5":13819,"_26493":112681,"_2816":112732},[],"Anota hora en UTC, usuario o principal, recurso, endpoint y resultado. Evita repetir una acción destructiva como revocación o eliminación.",{"_3328":67773,"_29138":67756,"_20209":112734,"_5":13819,"_26493":112685,"_2816":112735},[],"Comprueba el código HTTP. Un 401 apunta a autenticación; un 403, a autorización; un 404, a ruta o recurso; un 5xx, al servicio o una dependencia.",{"_3328":67774,"_29138":67756,"_20209":112737,"_5":13819,"_26493":112689,"_2816":112738},[],"Localiza pods no preparados, reinicios, eventos recientes y el estado del release.",{"_3328":67775,"_29138":67756,"_20209":112740,"_5":13819,"_26493":112693,"_2816":112741},[],"Revisa su endpoint /health y sus logs en la misma ventana temporal. Después sigue la dependencia indicada: PostgreSQL, RabbitMQ, proveedor OIDC o motor criptográfico.",{"_3328":67776,"_29138":67756,"_20209":112743,"_5":13819,"_26493":112697,"_2816":112744},[],"Para PKI, comprueba el certificado, la cadena, OCSP o CRL con el mismo tipo de cliente que utiliza producción.",{"_3328":67777,"_29138":67756,"_20209":112746,"_5":13819,"_26493":112701,"_2816":112747},[],"Sustituye los marcadores por tu release, namespace y deployment reales.",{"_3328":67778,"_29138":67756,"_20209":112749,"_5":13819,"_26493":112701,"_2816":112750},[],"Ejecuta también la prueba de conectividad del chart:",{"_3328":67779,"_29138":67756,"_20209":112752,"_5":13819,"_26493":112701,"_2816":112753},[],"El test consulta la salud de CA, DMS Manager, Device Manager y VA, y comprueba que la UI devuelve HTML. Un test correcto confirma conectividad básica, no un flujo completo de emisión.",{"_3328":67780,"_29138":67756,"_20209":112755,"_5":13819,"_26493":112701,"_2816":112756},[],"Los servicios del chart exponen sondas de inicio, disponibilidad y vida sobre /health. Un pod puede estar ejecutándose pero no recibir tráfico si la readiness probe falla.",{"_3328":67781,"_29138":67756,"_20209":112758,"_5":13819,"_26493":112705,"_2816":112759},[],"Si recibes un 401:",{"_3328":67782,"_29138":67756,"_20209":112761,"_5":13819,"_26493":112705,"_2816":112762},[],"comprueba que la autoridad OIDC de la UI sea accesible desde el navegador;",{"_3328":67783,"_29138":67756,"_20209":112764,"_5":13819,"_26493":112705,"_2816":112765},[],"verifica emisor, audiencia y expiración del token;",{"_3328":67784,"_29138":67756,"_20209":112767,"_5":13819,"_26493":112705,"_2816":112768},[],"confirma que el Gateway puede obtener las claves de la URI JWKS;",{"_3328":67785,"_29138":67756,"_20209":112770,"_5":13819,"_26493":112705,"_2816":112771},[],"revisa que la ruta pública e interna del proveedor apunten al mismo realm.",{"_3328":67786,"_29138":67756,"_20209":112773,"_5":13819,"_26493":112705,"_2816":112774},[],"Si el login termina pero las APIs devuelven 403:",{"_3328":67787,"_29138":67756,"_20209":112776,"_5":13819,"_26493":112705,"_2816":112777},[],"inspecciona los claims reales del token;",{"_3328":67788,"_29138":67756,"_20209":112779,"_5":13819,"_26493":112705,"_2816":112780},[],"confirma que coinciden con un principal activo;",{"_3328":67789,"_29138":67756,"_20209":112782,"_5":13819,"_26493":112705,"_2816":112783},[],"revisa las políticas concedidas al principal;",{"_3328":67790,"_29138":67756,"_20209":112785,"_5":13819,"_26493":112705,"_2816":112786},[],"verifica que authz alcanza PostgreSQL y su JWKS.",{"_3328":67791,"_29138":67756,"_20209":112788,"_5":13819,"_26493":112705,"_2816":112789},[],"En una instalación nueva, confirma que el Job de migración terminó. Ese Job crea esquemas, migra authz, precarga políticas y provisiona los principales definidos en services.authz.bootstrap.",{"_3328":67792,"_29138":67756,"_20209":112791,"_5":13819,"_26493":112709,"_2816":112792},[],"La autorización externa falla cerrada por defecto. Si authz no está disponible, las rutas protegidas se bloquean.",{"_3328":67793,"_29138":67756,"_20209":112794,"_5":13819,"_26493":112709,"_2816":112795},[],"Localiza el pod y Service de authz.",{"_3328":67794,"_29138":67756,"_20209":112797,"_5":13819,"_26493":112709,"_2816":112798},[],"Comprueba /health, logs y conexión a su base de datos.",{"_3328":67795,"_29138":67756,"_20209":112800,"_5":13819,"_26493":112709,"_2816":112801},[],"Verifica el DNS y puerto configurados en externalAuthorization.",{"_3328":67796,"_29138":67756,"_20209":112803,"_5":13819,"_26493":112709,"_2816":112804},[],"Comprueba que la ruta del check es /v1/ext\\_authz/check.",{"_3328":67797,"_29138":67756,"_20209":112806,"_5":13819,"_26493":112709,"_2816":112807},[],"No cambies a failOpen: true como solución permanente: permitiría tráfico sin autorización durante la caída.",{"_3328":67798,"_29138":67756,"_20209":112809,"_5":13819,"_26493":112713,"_2816":112810},[],"Un 500 indica un fallo interno, como una base de datos no disponible. El cuerpo `{\"err\": ...}` incluye hoy el texto del error interno, que puede contener nombres de esquema, tabla y restricción y, en fallos de conexión, el host y el usuario de la base de datos (no la contraseña). Localiza la causa en el log del servicio con la hora de la petición, y no reenvíes el cuerpo a terceros ni lo muestres a usuarios finales. Es un defecto conocido de divulgación de información: está previsto devolver un mensaje genérico en los 500 y dejar el detalle solo en el log del servicio (seguimiento en lamassuiot#814). El conector de autorización también devuelve el error interno, en el campo `details.error`. Algunos errores de petición, como un tamaño de clave que el motor no admite, se devuelven también como 500.",{"_3328":67799,"_29138":67756,"_20209":112812,"_5":13819,"_26493":112717,"_2816":112813},[],"Revisa primero kubectl describe pod. Las causas habituales son:",{"_3328":67800,"_29138":67756,"_20209":112815,"_5":13819,"_26493":112717,"_2816":112816},[],"credenciales o DNS incorrectos para PostgreSQL o RabbitMQ;",{"_3328":67801,"_29138":67756,"_20209":112818,"_5":13819,"_26493":112717,"_2816":112819},[],"un Secret de CA o de certificado de cliente de AMQP inexistente referenciado por `amqp.ca.secretName` o `amqp.client.secretName`;",{"_3328":67802,"_29138":67756,"_20209":112821,"_5":13819,"_26493":112717,"_2816":112822},[],"volumen persistente sin enlazar;",{"_3328":67803,"_29138":67756,"_20209":112824,"_5":13819,"_26493":112717,"_2816":112825},[],"imagen inaccesible o política de pull incorrecta;",{"_3328":67804,"_29138":67756,"_20209":112827,"_5":13819,"_26493":112717,"_2816":112828},[],"configuración inválida del motor criptográfico;",{"_3328":67805,"_29138":67756,"_20209":112830,"_5":13819,"_26493":112717,"_2816":112831},[],"límites de CPU o memoria demasiado bajos;",{"_3328":67806,"_29138":67756,"_20209":112833,"_5":13819,"_26493":112717,"_2816":112834},[],"migración previa incompleta.",{"_3328":67807,"_29138":67756,"_20209":112836,"_5":13819,"_26493":112717,"_2816":112837},[],"Los valores genéricos solicitan 100 mCPU y 128 MiB y limitan a 500 mCPU y 512 MiB. Ajusta por servicio cuando haya OOMKills, throttling o arranques lentos.",{"_3328":67808,"_29138":67756,"_20209":112839,"_5":13819,"_26493":112717,"_2816":112840},[],"Los motores KMS basados en filesystem y el almacenamiento local de VA utilizan volúmenes de acceso exclusivo. Mantén una réplica o migra a backends compartidos antes de habilitar autoscaling.",{"_3328":67809,"_29138":67756,"_20209":112842,"_5":13819,"_26493":112717,"_2816":112843},[],"Las llamadas internas ahora fallan rápido en lugar de bloquearse para los clientes cubiertos por Proxy de salida: los intentos de conexión agotan el tiempo tras 30 segundos y los handshakes TLS tras 10 segundos. El conector del motor de autorización mantiene su propio transporte sin estos timeouts de conexión ni de handshake TLS; solo su timeout global de petición de 30 segundos acota cada llamada. Si un proxy de salida gestiona el tráfico de salida del clúster, comprueba las variables de entorno `HTTP_PROXY`, `HTTPS_PROXY` y `NO_PROXY` del pod e incluye los nombres de servicio internos en `NO_PROXY`.",{"_3328":67810,"_29138":67756,"_20209":112845,"_5":13819,"_26493":112721,"_2816":112846},[],"Los eventos de dominio y auditoría dependen del publisher del bus:",{"_3328":67811,"_29138":67756,"_20209":112848,"_5":13819,"_26493":112721,"_2816":112849},[],"verifica que esté habilitado en el servicio emisor;",{"_3328":67812,"_29138":67756,"_20209":112851,"_5":13819,"_26493":112721,"_2816":112852},[],"comprueba conectividad y credenciales AMQP;",{"_3328":67813,"_29138":67756,"_20209":112854,"_5":13819,"_26493":112721,"_2816":112855},[],"revisa exchange, routing key, colas y consumidores;",{"_3328":67814,"_29138":67756,"_20209":112857,"_5":13819,"_26493":112721,"_2816":112858},[],"inspecciona dead-letter queues;",{"_3328":67815,"_29138":67756,"_20209":112860,"_5":13819,"_26493":112721,"_2816":112861},[],"alerta sobre colas durables huérfanas y crecimiento de backlog.",{"_3328":67816,"_29138":67756,"_20209":112863,"_5":13819,"_26493":112721,"_2816":112864},[],"Si `amqp.tls` está habilitado, revisa también la parte TLS:",{"_3328":67817,"_29138":67756,"_20209":112866,"_5":13819,"_26493":112721,"_2816":112867},[],"confirma que el listener del broker hable AMQPS en el puerto configurado — el puerto por defecto sigue siendo `5672` y no cambia automáticamente al habilitar TLS;",{"_3328":67818,"_29138":67756,"_20209":112869,"_5":13819,"_26493":112721,"_2816":112870},[],"si defines `amqp.ca.secretName`, confirma que el Secret exista en el namespace del release y que su clave de datos coincida con `amqp.ca.certificateKey` (por defecto `ca.crt`); si no defines `amqp.ca.secretName`, los clientes confían en las CA del sistema;",{"_3328":67819,"_29138":67756,"_20209":112872,"_5":13819,"_26493":112721,"_2816":112873},[],"recuerda que un Secret referenciado inexistente impide arrancar los pods consumidores;",{"_3328":67820,"_29138":67756,"_20209":112875,"_5":13819,"_26493":112721,"_2816":112876},[],"tras actualizar el Secret de la CA o del certificado de cliente, reinicia los pods consumidores: el cliente AMQP carga los certificados al arrancar.",{"_3328":67821,"_29138":67756,"_20209":112878,"_5":13819,"_26493":112721,"_2816":112879},[],"Consulta TLS de AMQP (AMQPS) para la configuración completa.",{"_3328":67822,"_29138":67756,"_20209":112881,"_5":13819,"_26493":112721,"_2816":112882},[],"Una caída del consumidor no siempre impide que la operación principal termine. Por eso debes monitorizar RabbitMQ y verificar de forma independiente la persistencia de auditoría.",{"_3328":67823,"_29138":67756,"_20209":112884,"_5":13819,"_26493":112725,"_2816":112885},[],"El chart puede habilitar la instrumentación OpenTelemetry para los servicios que la admiten, incluido authz; no configura OpenTelemetry para el AWS Connector, wfx ni la UI. Las trazas se exportan por OTLP HTTP y los logs pueden dirigirse a un endpoint compatible, como VictoriaLogs. Usa un identificador de correlación y la misma ventana temporal para unir Gateway, servicio y dependencia.",{"_3328":67824,"_29138":67756,"_20209":112887,"_5":13819,"_26493":112725,"_2816":112888},[],"Antes de cerrar una incidencia, guarda:",{"_3328":67825,"_29138":67756,"_20209":112890,"_5":13819,"_26493":112725,"_2816":112891},[],"causa confirmada;",{"_3328":67826,"_29138":67756,"_20209":112893,"_5":13819,"_26493":112725,"_2816":112894},[],"alcance temporal y recursos afectados;",{"_3328":67827,"_29138":67756,"_20209":112896,"_5":13819,"_26493":112725,"_2816":112897},[],"comandos o consultas utilizados;",{"_3328":67828,"_29138":67756,"_20209":112899,"_5":13819,"_26493":112725,"_2816":112900},[],"cambio aplicado y forma de revertirlo;",{"_3328":67829,"_29138":67756,"_20209":112902,"_5":13819,"_26493":112725,"_2816":112903},[],"validación desde un consumidor;",{"_3328":67830,"_29138":67756,"_20209":112905,"_5":13819,"_26493":112725,"_2816":112906},[],"acción preventiva y propietario.",{"_3328":67831,"_29138":67831,"_5":14177,"_2816":112908,"_29461":112909,"_20209":112912,"_26493":67831},"Control de acceso",[47397,112910,112911],"Plataforma","Administración",[],{"_3328":67832,"_29138":67831,"_20209":112914,"_5":13819,"_26493":67831,"_2816":112915},[],"Diseña quién puede acceder a Lamassu mediante principales, políticas, permisos sobre recursos y autorización de rutas HTTP.",{"_3328":67833,"_29138":67831,"_5":29458,"_20209":112917,"_26493":112918,"_2816":112919},[],"/docs/es/platform/administration/access-control#conceptos-esenciales","Conceptos esenciales",{"_3328":67834,"_29138":67831,"_5":29458,"_20209":112921,"_26493":112922,"_2816":112923},[],"/docs/es/platform/administration/access-control#dos-sistemas-de-decisión","Dos sistemas de decisión",{"_3328":67835,"_29138":67831,"_5":29458,"_20209":112925,"_26493":112926,"_2816":112927},[],"/docs/es/platform/administration/access-control#servicios-http-integrados-o-externos","Servicios HTTP integrados o externos",{"_3328":67836,"_29138":67831,"_5":29458,"_20209":112929,"_26493":112930,"_2816":112931},[],"/docs/es/platform/administration/access-control#rutas-solo-de-autenticación-y-rutas-no-mapeadas","Rutas solo de autenticación y rutas no mapeadas",{"_3328":67837,"_29138":67831,"_5":29458,"_20209":112933,"_26493":112934,"_2816":112935},[],"/docs/es/platform/administration/access-control#servicios-desarrollados-por-lamassu","Servicios desarrollados por Lamassu",{"_3328":67838,"_29138":67831,"_5":29458,"_20209":112937,"_26493":112938,"_2816":112939},[],"/docs/es/platform/administration/access-control#cómo-se-relacionan-ambos-caminos","Cómo se relacionan ambos caminos",{"_3328":67839,"_29138":67831,"_5":29458,"_20209":112941,"_26493":112942,"_2816":112943},[],"/docs/es/platform/administration/access-control#principales-oidc","Principales OIDC",{"_3328":67840,"_29138":67831,"_5":29458,"_20209":112945,"_26493":112946,"_2816":112947},[],"/docs/es/platform/administration/access-control#principales-x509","Principales X.509",{"_3328":67841,"_29138":67831,"_5":29458,"_20209":112949,"_26493":112950,"_2816":112951},[],"/docs/es/platform/administration/access-control#cuando-coinciden-varios-principales","Cuando coinciden varios principales",{"_3328":67842,"_29138":67831,"_5":29458,"_20209":112953,"_26493":112954,"_2816":112955},[],"/docs/es/platform/administration/access-control#cómo-expresan-acceso-las-políticas","Cómo expresan acceso las políticas",{"_3328":67843,"_29138":67831,"_5":29458,"_20209":112957,"_26493":112958,"_2816":112959},[],"/docs/es/platform/administration/access-control#acceso-global-y-acceso-directo","Acceso global y acceso directo",{"_3328":67844,"_29138":67831,"_5":29458,"_20209":112961,"_26493":112962,"_2816":112963},[],"/docs/es/platform/administration/access-control#acceso-heredado-por-relaciones","Acceso heredado por relaciones",{"_3328":67845,"_29138":67831,"_5":29458,"_20209":112965,"_26493":112966,"_2816":112967},[],"/docs/es/platform/administration/access-control#acceso-filtrado-por-atributos","Acceso filtrado por atributos",{"_3328":67846,"_29138":67831,"_5":29458,"_20209":112969,"_26493":112970,"_2816":112971},[],"/docs/es/platform/administration/access-control#reglas-http","Reglas HTTP",{"_3328":67847,"_29138":67831,"_5":29458,"_20209":112973,"_26493":112974,"_2816":112975},[],"/docs/es/platform/administration/access-control#políticas-incluidas","Políticas incluidas",{"_3328":67848,"_29138":67831,"_5":29458,"_20209":112977,"_26493":112978,"_2816":112085},[],"/docs/es/platform/administration/access-control#provisiona-el-primer-administrador",{"_3328":67849,"_29138":67831,"_5":29458,"_20209":112980,"_26493":112981,"_2816":112982},[],"/docs/es/platform/administration/access-control#prepara-el-proveedor-de-identidad","Prepara el proveedor de identidad",{"_3328":67850,"_29138":67831,"_5":29458,"_20209":112984,"_26493":112985,"_2816":112986},[],"/docs/es/platform/administration/access-control#configura-la-validación-de-tokens","Configura la validación de tokens",{"_3328":67851,"_29138":67831,"_5":29458,"_20209":112988,"_26493":112989,"_2816":112990},[],"/docs/es/platform/administration/access-control#instala-y-verifica-el-acceso-administrativo","Instala y verifica el acceso administrativo",{"_3328":67852,"_29138":67831,"_5":29458,"_20209":112992,"_26493":112993,"_2816":112994},[],"/docs/es/platform/administration/access-control#prueba-una-identidad-sin-privilegios","Prueba una identidad sin privilegios",{"_3328":67853,"_29138":67831,"_5":29458,"_20209":112996,"_26493":112997,"_2816":112998},[],"/docs/es/platform/administration/access-control#reduce-el-uso-del-administrador-de-bootstrap","Reduce el uso del administrador de bootstrap",{"_3328":67854,"_29138":67831,"_5":29458,"_20209":113000,"_26493":113001,"_2816":113002},[],"/docs/es/platform/administration/access-control#bootstrap-de-fastlane","Bootstrap de Fastlane",{"_3328":67855,"_29138":67831,"_5":29458,"_20209":113004,"_26493":113005,"_2816":113006},[],"/docs/es/platform/administration/access-control#diseña-roles-de-mínimo-privilegio","Diseña roles de mínimo privilegio",{"_3328":67856,"_29138":67831,"_5":29458,"_20209":113008,"_26493":113009,"_2816":113010},[],"/docs/es/platform/administration/access-control#cambios-y-revocación-de-acceso","Cambios y revocación de acceso",{"_3328":67857,"_29138":67831,"_5":29458,"_20209":113012,"_26493":113013,"_2816":113014},[],"/docs/es/platform/administration/access-control#lista-de-comprobación-operativa","Lista de comprobación operativa",{"_3328":67858,"_29138":67831,"_5":29458,"_20209":113016,"_26493":113017,"_2816":113018},[],"/docs/es/platform/administration/access-control#diagnóstico","Diagnóstico",{"_3328":67859,"_29138":67831,"_5":29458,"_20209":113020,"_26493":113021,"_2816":113022},[],"/docs/es/platform/administration/access-control#la-respuesta-es-401","La respuesta es 401",{"_3328":67860,"_29138":67831,"_5":29458,"_20209":113024,"_26493":113025,"_2816":113026},[],"/docs/es/platform/administration/access-control#la-respuesta-es-403","La respuesta es 403",{"_3328":67861,"_29138":67831,"_5":29458,"_20209":113028,"_26493":113029,"_2816":113030},[],"/docs/es/platform/administration/access-control#todo-devuelve-403","Todo devuelve 403",{"_3328":67862,"_29138":67831,"_5":29458,"_20209":113032,"_26493":113033,"_2816":113034},[],"/docs/es/platform/administration/access-control#aparece-acceso-sin-política-concedida","Aparece acceso sin política concedida",{"_3328":67863,"_29138":67831,"_5":29458,"_20209":113036,"_26493":113037,"_2816":113038},[],"/docs/es/platform/administration/access-control#todo-falla-cuando-authz-no-está-disponible","Todo falla cuando authz no está disponible",{"_3328":67864,"_29138":67831,"_20209":113040,"_5":13819,"_26493":67831,"_2816":113041},[],"El control de acceso de Lamassu transforma una identidad autenticada en permisos concretos. El proveedor OIDC o el certificado cliente demuestra **quién** realiza una petición; el servicio `authz` decide **qué puede hacer** esa identidad y **sobre qué recursos**.",{"_3328":67865,"_29138":67831,"_20209":113043,"_5":13819,"_26493":67831,"_2816":113044},[],"Lamassu no asigna permisos directamente a usuarios. La cadena completa es:",{"_3328":67866,"_29138":67831,"_20209":113046,"_5":13819,"_26493":67831,"_2816":113047},[],"Este modelo permite representar personas, grupos del proveedor de identidad, cuentas de servicio y dispositivos sin acoplar la autorización a un proveedor concreto.",{"_3328":67867,"_29138":67831,"_20209":113049,"_5":13819,"_26493":112918,"_2816":113050},[],"Un **principal** conecta una credencial con Lamassu. Define cómo reconocer una identidad OIDC o X.509 y puede estar activo o desactivado.",{"_3328":67868,"_29138":67831,"_20209":113052,"_5":13819,"_26493":112918,"_2816":113053},[],"Una **política** agrupa permisos reutilizables. Puede concederse a varios principales y puede contener reglas sobre entidades de Lamassu, reglas sobre rutas HTTP o ambas.",{"_3328":67869,"_29138":67831,"_20209":113055,"_5":13819,"_26493":112918,"_2816":113056},[],"Una **regla de entidad** concede acciones sobre recursos como autoridades certificadoras, certificados, perfiles de emisión, dispositivos, DMS, claves o suscripciones de alertas. Puede abarcar todos los recursos de un tipo o limitarse por identificador, relación o atributo.",{"_3328":67870,"_29138":67831,"_20209":113058,"_5":13819,"_26493":112918,"_2816":113059},[],"Una **regla HTTP** concede acciones asociadas a rutas de una API. Es el mecanismo que utiliza el Gateway para decidir si una petición puede atravesar el perímetro.",{"_3328":67871,"_29138":67831,"_20209":113061,"_5":13819,"_26493":112918,"_2816":113062},[],"Un **grant** es la asociación entre un principal y una política. Quitar el grant elimina todos los permisos aportados por esa política, sin modificarla para los demás principales.",{"_3328":67872,"_29138":67831,"_20209":113064,"_5":13819,"_26493":112918,"_2816":113065},[],"Un JWT válido o un certificado cliente válido no concede acceso por sí mismo. La credencial debe coincidir con al menos un principal activo y, salvo que el esquema HTTP exima la ruta, alguna de sus políticas debe permitir la operación solicitada. Consulta *Rutas solo de autenticación y rutas no mapeadas* para esas excepciones.",{"_3328":67873,"_29138":67831,"_20209":113067,"_5":13819,"_26493":112922,"_2816":113068},[],"Lamassu utiliza dos caminos de autorización según quién implementa el servicio protegido. Comparten principales, políticas y grants, pero no interpretan las reglas de la misma manera.",{"_3328":67874,"_29138":67831,"_20209":113070,"_5":13819,"_26493":112922,"_2816":113071},[],"Un servicio externo puede quedar protegido sin conocer el modelo interno de autorización de Lamassu. Un servicio desarrollado por Lamassu integra el motor de autorización y puede decidir sobre recursos concretos y filtrar sus consultas.",{"_3328":67875,"_29138":67831,"_20209":113073,"_5":13819,"_26493":112926,"_2816":113074},[],"Este camino protege APIs que se incorporan a la plataforma a través del Gateway pero que no implementan de forma nativa el SDK de autorización de Lamassu. Job Manager es el ejemplo actual. El mismo patrón permite integrar otros servicios HTTP siempre que sus rutas estén descritas en un esquema HTTP de `authz`.",{"_3328":67876,"_29138":67831,"_20209":113076,"_5":13819,"_26493":112926,"_2816":113077},[],"La decisión se toma **antes de reenviar la petición al servicio**:",{"_3328":67877,"_29138":67831,"_20209":113079,"_5":13819,"_26493":112926,"_2816":113080},[],"Envoy Gateway autentica la petición, normalmente validando un JWT contra el JWKS del proveedor OIDC.",{"_3328":67878,"_29138":67831,"_20209":113082,"_5":13819,"_26493":112926,"_2816":113083},[],"Para una ruta protegida, Envoy envía el método, la URL, las cabeceras y los datos necesarios a `/v1/ext_authz/check`.",{"_3328":67879,"_29138":67831,"_20209":113085,"_5":13819,"_26493":112926,"_2816":113086},[],"`authz` extrae la credencial y resuelve todos los principales activos que coinciden con ella.",{"_3328":67880,"_29138":67831,"_20209":113088,"_5":13819,"_26493":112926,"_2816":113089},[],"Carga por separado las políticas concedidas a cada principal.",{"_3328":67881,"_29138":67831,"_20209":113091,"_5":13819,"_26493":112926,"_2816":113092},[],"El esquema HTTP traduce la combinación de método y ruta a una acción lógica, como `nbi-job-read` o `nbi-workflow-create`.",{"_3328":67882,"_29138":67831,"_20209":113094,"_5":13819,"_26493":112926,"_2816":113095},[],"`authz` busca una regla HTTP que conceda esa acción.",{"_3328":67883,"_29138":67831,"_20209":113097,"_5":13819,"_26493":112926,"_2816":113098},[],"Si la ruta declara restricciones, compara datos de la petición con los atributos normalizados del mismo principal que aporta la política; los `param_constraints` de la propia política también fijan la acción concedida a valores literales de la petición.",{"_3328":67884,"_29138":67831,"_20209":113100,"_5":13819,"_26493":112926,"_2816":113101},[],"Un resultado satisfactorio permite a Envoy reenviar la petición; cualquier otra respuesta la bloquea en el Gateway.",{"_3328":67885,"_29138":67831,"_20209":113103,"_5":13819,"_26493":112926,"_2816":113104},[],"Cuando permite el acceso, `authz` devuelve el principal seleccionado en la cabecera de respuesta `X-Principal-ID`. El Gateway puede propagar esa cabecera al servicio para conservar el contexto de identidad.",{"_3328":67886,"_29138":67831,"_20209":113106,"_5":13819,"_26493":112926,"_2816":113107},[],"Las reglas HTTP responden principalmente a &#x2A;*“¿puede esta identidad llamar a esta operación de la API?”**. Por sí solas no generan filtros sobre la base de datos del servicio externo. Para limitar una ruta a un dispositivo, tenant o cliente concreto, o bien el esquema declara una restricción que relaciona un valor de la petición con un atributo normalizado del principal, o bien la política fija ese valor de la petición a un literal con `param_constraints`. Lo primero limita cada identidad a sus propios recursos con un único grant; lo segundo restringe un grant a un valor fijo, sin importar quién lo posea.",{"_3328":67887,"_29138":67831,"_20209":113109,"_5":13819,"_26493":112930,"_2816":113110},[],"Dos ajustes del propio esquema cubren endpoints que las políticas no mencionan:",{"_3328":67888,"_29138":67831,"_20209":113112,"_5":13819,"_26493":112930,"_2816":113113},[],"**`skip_authz: true` en una ruta** permite alcanzarla a cualquier identidad que coincida con un principal activo, aunque no tenga políticas concedidas. Úsalo para rutas como `/openapi.json` o `/health` que todo cliente autenticado debería poder consultar. La petición sigue necesitando una autenticación válida: una credencial que no supera la validación o no coincide con ningún principal activo se rechaza antes de considerar este ajuste. Una ruta con `skip_authz` no puede declarar restricciones, y prevalece sobre la ruta o la acción por defecto de cualquier otro esquema para la misma petición.",{"_3328":67889,"_29138":67831,"_20209":113115,"_5":13819,"_26493":112930,"_2816":113116},[],"**`default_action` con `base_paths`** decide qué ocurre cuando una petición cae bajo un prefijo de ruta que el esquema posee pero ninguna ruta explícita coincide. `deny` — el valor con el que se entrega el esquema del Job Manager — convierte la denegación implícita de las rutas no mapeadas en una declaración explícita y auditable; `allow` abre los endpoints no mapeados bajo ese prefijo a cualquier identidad que coincida con un principal activo.",{"_3328":67890,"_29138":67831,"_20209":113118,"_5":13819,"_26493":112930,"_2816":113119},[],"Son decisiones del esquema, no de una política: `skip_authz` elimina la comprobación del grant para esa ruta, incluso cuando otro esquema asigna la misma petición a una acción que exige un grant, y `default_action` solo cubre las peticiones que ninguna ruta explícita de ningún esquema cubre. Ten en cuenta tres reglas:",{"_3328":67891,"_29138":67831,"_20209":113121,"_5":13819,"_26493":112930,"_2816":113122},[],"`default_action` exige al menos una entrada en `base_paths`, y las rutas base son rutas absolutas como `/api/wfx/nbi/v1`.",{"_3328":67892,"_29138":67831,"_20209":113124,"_5":13819,"_26493":112930,"_2816":113125},[],"Una ruta explícita de cualquier esquema tiene prioridad: la acción por defecto solo decide peticiones que ninguna ruta de ningún esquema cubre. Cuando los prefijos de dos esquemas se solapan, decide el prefijo coincidente más largo.",{"_3328":67893,"_29138":67831,"_20209":113127,"_5":13819,"_26493":112930,"_2816":113128},[],"Dos esquemas no pueden reclamar la misma ruta base con acciones por defecto distintas; el esquema en conflicto no llega a cargar.",{"_3328":67894,"_29138":67831,"_20209":113130,"_5":13819,"_26493":112930,"_2816":113131},[],"Una ruta con `skip_authz` y un prefijo con `default_action: \"allow\"` conceden acceso sin consultar ninguna política. Cualquier identidad que coincida con un principal activo puede alcanzar lo que abran, incluidas las identidades sin políticas concedidas. Una ruta con `skip_authz` en un esquema también abre una petición que otro esquema asigna a una acción protegida por un grant. Revisa estos ajustes cada vez que integres o actualices un servicio.",{"_3328":67895,"_29138":67831,"_20209":113133,"_5":13819,"_26493":112934,"_2816":113134},[],"Los servicios nativos de Lamassu integran autorización en su middleware y conocen las entidades sobre las que operan: certificados, CAs, perfiles de emisión, claves, dispositivos, DMS o suscripciones, entre otras.",{"_3328":67896,"_29138":67831,"_20209":113136,"_5":13819,"_26493":112934,"_2816":113137},[],"La decisión se toma con el contexto de la operación de dominio:",{"_3328":67897,"_29138":67831,"_20209":113139,"_5":13819,"_26493":112934,"_2816":113140},[],"El middleware extrae la credencial y resuelve los principales coincidentes.",{"_3328":67898,"_29138":67831,"_20209":113142,"_5":13819,"_26493":112934,"_2816":113143},[],"El endpoint identifica la acción, el tipo de entidad y, cuando corresponde, la clave del recurso solicitado.",{"_3328":67899,"_29138":67831,"_20209":113145,"_5":13819,"_26493":112934,"_2816":113146},[],"`authz` reúne las reglas de entidad de las políticas concedidas.",{"_3328":67900,"_29138":67831,"_20209":113148,"_5":13819,"_26493":112934,"_2816":113149},[],"El motor evalúa grants directos, filtros por atributos y relaciones con otras entidades.",{"_3328":67901,"_29138":67831,"_20209":113151,"_5":13819,"_26493":112934,"_2816":113152},[],"Para una operación individual, comprueba que el recurso concreto satisface el alcance calculado.",{"_3328":67902,"_29138":67831,"_20209":113154,"_5":13819,"_26493":112934,"_2816":113155},[],"Para un listado, genera un filtro SQL que el servicio añade a su propia consulta.",{"_3328":67903,"_29138":67831,"_20209":113157,"_5":13819,"_26493":112934,"_2816":113158},[],"Aquí el motor responde a &#x2A;*“¿puede esta identidad realizar esta acción sobre este recurso concreto?”**.",{"_3328":67904,"_29138":67831,"_20209":113160,"_5":13819,"_26493":112934,"_2816":113161},[],"Las acciones se dividen en dos grupos:",{"_3328":67905,"_29138":67831,"_20209":113163,"_5":13819,"_26493":112934,"_2816":113164},[],"Las **acciones globales** no necesitan un identificador de recurso. `create`, `import` o el acceso a una sección de la interfaz son ejemplos habituales.",{"_3328":67906,"_29138":67831,"_20209":113166,"_5":13819,"_26493":112934,"_2816":113167},[],"Las **acciones atómicas** se evalúan sobre una instancia concreta. En certificados aparecen `read`, `metadata-update`, `status-update` y `delete`; para una CA también existen `sign`, `reissue` y otras operaciones de ciclo de vida.",{"_3328":67907,"_29138":67831,"_20209":113169,"_5":13819,"_26493":112934,"_2816":113170},[],"El filtrado dentro del servicio evita fugas en listados: los recursos no autorizados quedan fuera de la consulta SQL en lugar de recuperarse y ocultarse después en la interfaz.",{"_3328":67908,"_29138":67831,"_20209":113172,"_5":13819,"_26493":112938,"_2816":113173},[],"No son dos controles equivalentes aplicados dos veces. Las reglas HTTP protegen el perímetro de un servicio integrado; las reglas de entidad expresan permisos sobre el modelo de datos de los servicios nativos.",{"_3328":67909,"_29138":67831,"_20209":113175,"_5":13819,"_26493":112938,"_2816":113176},[],"Una política puede contener ambos tipos de reglas cuando una identidad necesita operar recursos de Lamassu y también llamar a una API integrada. Conceder una regla de entidad no concede automáticamente una acción HTTP, ni una regla HTTP crea acceso sobre una entidad.",{"_3328":67910,"_29138":67831,"_20209":113178,"_5":13819,"_26493":112938,"_2816":113179},[],"Si ninguna combinación de principal, política y regla permite la operación, Lamassu la deniega, salvo que el esquema HTTP declare `skip_authz` en la ruta o `default_action: allow` en una ruta base que la cubra (consulta *Rutas solo de autenticación y rutas no mapeadas*). Además, `auth.externalAuthorization.failOpen` vale `false` por defecto: si `authz` no está disponible, el Gateway bloquea las rutas protegidas.",{"_3328":67911,"_29138":67831,"_20209":113181,"_5":13819,"_26493":112942,"_2816":113182},[],"Un principal OIDC coincide con los claims de un JWT validado. Es apropiado para usuarios humanos, grupos corporativos, roles del IdP y cuentas de servicio que obtienen tokens.",{"_3328":67912,"_29138":67831,"_20209":113184,"_5":13819,"_26493":112942,"_2816":113185},[],"El siguiente principal representa a cualquier identidad que tenga el rol `pki-operators` en Keycloak:",{"_3328":67913,"_29138":67831,"_20209":113187,"_5":13819,"_26493":112942,"_2816":113188},[],"Las rutas de claims pueden estar anidadas, como `realm_access.roles`. Dentro de un mismo principal, **todas** las condiciones deben cumplirse. Esto permite exigir, por ejemplo, un grupo y una audiencia organizativa a la vez.",{"_3328":67914,"_29138":67831,"_20209":113190,"_5":13819,"_26493":112942,"_2816":113191},[],"Los operadores implementados son:",{"_3328":67915,"_29138":67831,"_20209":113193,"_5":13819,"_26493":112942,"_2816":113194},[],"`equals`, para igualdad exacta;",{"_3328":67916,"_29138":67831,"_20209":113196,"_5":13819,"_26493":112942,"_2816":113197},[],"`contains`, para comprobar la pertenencia a una lista o la presencia de texto en un valor escalar.",{"_3328":67917,"_29138":67831,"_20209":113199,"_5":13819,"_26493":112942,"_2816":113200},[],"Diseña la coincidencia con atributos estables. Para personas, suele ser mejor enlazar permisos a grupos o roles gestionados centralmente que al correo o al nombre de usuario. Para una cuenta de servicio, un `sub` estable evita que sus permisos se mezclen con los de un operador humano.",{"_3328":67918,"_29138":67831,"_20209":113202,"_5":13819,"_26493":112942,"_2816":113203},[],"Aunque el modelo reconoce el nombre de operador `matches`, la implementación actual no evalúa expresiones regulares y la condición nunca coincide. Usa `equals` o `contains`.",{"_3328":67919,"_29138":67831,"_20209":113205,"_5":13819,"_26493":112946,"_2816":113206},[],"Un principal X.509 permite reconocer una carga de trabajo o un dispositivo mediante su certificado cliente. Lamassu comprueba la firma del certificado contra la CA configurada y, según el modo, también su número de serie o Common Name.",{"_3328":67920,"_29138":67831,"_20209":113208,"_5":13819,"_26493":112946,"_2816":113209},[],"Los modos disponibles son:",{"_3328":67921,"_29138":67831,"_20209":113211,"_5":13819,"_26493":112946,"_2816":113212},[],"`serial_and_ca`: un certificado exacto, identificado por número de serie y CA;",{"_3328":67922,"_29138":67831,"_20209":113214,"_5":13819,"_26493":112946,"_2816":113215},[],"`cn_and_ca`: un Common Name exacto o con comodines y una CA concreta;",{"_3328":67923,"_29138":67831,"_20209":113217,"_5":13819,"_26493":112946,"_2816":113218},[],"`any_from_ca`: cualquier certificado emitido directamente por la CA indicada.",{"_3328":67924,"_29138":67831,"_20209":113220,"_5":13819,"_26493":112946,"_2816":113221},[],"Este ejemplo reconoce certificados cuyo CN comienza por `factory-a-` y que están firmados por la CA configurada:",{"_3328":67925,"_29138":67831,"_20209":113223,"_5":13819,"_26493":112946,"_2816":113224},[],"`ca_trust.identity_type` acepta `fingerprint` o `authority_key_id`. En ambos casos debes aportar el certificado de la CA en `ca_trust.pem`; Lamassu verifica tanto la firma como la identidad esperada de la CA.",{"_3328":67926,"_29138":67831,"_20209":113226,"_5":13819,"_26493":112946,"_2816":113227},[],"Usa `any_from_ca` únicamente cuando todas las identidades emitidas por esa CA deban compartir los mismos permisos. Si una CA emite certificados para poblaciones distintas, separa el acceso por serie o CN, o utiliza CAs de emisión diferentes.",{"_3328":67927,"_29138":67831,"_20209":113229,"_5":13819,"_26493":112950,"_2816":113230},[],"Una misma credencial puede coincidir con más de un principal. Es habitual que un usuario coincida con un principal de su equipo y con otro de su función operativa.",{"_3328":67928,"_29138":67831,"_20209":113232,"_5":13819,"_26493":112950,"_2816":113233},[],"Para permisos de entidad, Lamassu combina los permisos con lógica OR: basta con que una de las políticas de uno de los principales permita la acción. Los listados contienen la unión de los recursos visibles para todos ellos.",{"_3328":67929,"_29138":67831,"_20209":113235,"_5":13819,"_26493":112950,"_2816":113236},[],"Las rutas HTTP con restricciones son más estrictas. El mismo principal que aporta la política debe satisfacer también los atributos exigidos por la ruta. Lamassu no combina la política de un principal con un atributo perteneciente a otro.",{"_3328":67930,"_29138":67831,"_20209":113238,"_5":13819,"_26493":112950,"_2816":113239},[],"Por esta razón, añadir un principal coincidente solo puede ampliar el acceso. Antes de crear reglas solapadas, revisa el conjunto completo de políticas que recibirá una identidad real.",{"_3328":67931,"_29138":67831,"_20209":113241,"_5":13819,"_26493":112958,"_2816":113242},[],"Una regla identifica el dominio (`namespace`), el esquema de datos (`schema_name`) y el tipo de entidad (`entity_type`). `actions` enumera las operaciones permitidas.",{"_3328":67932,"_29138":67831,"_20209":113244,"_5":13819,"_26493":112958,"_2816":113245},[],"`direct_grants` limita la regla a identificadores concretos. El valor `*` abarca todas las instancias del tipo. Una política de superadministrador utiliza comodines en esquema, entidad, acciones y grants; una política de mínimo privilegio debe evitarlos siempre que sea posible.",{"_3328":67933,"_29138":67831,"_20209":113247,"_5":13819,"_26493":112962,"_2816":113248},[],"Las reglas pueden seguir relaciones declaradas entre entidades. Por ejemplo, el esquema conoce la relación de un certificado con su CA emisora y la de un dispositivo con su DMS. Una política puede conceder acceso a un recurso padre y propagar acciones seleccionadas hacia sus recursos relacionados.",{"_3328":67934,"_29138":67831,"_20209":113250,"_5":13819,"_26493":112962,"_2816":113251},[],"Esto permite expresar modelos como “puede operar los dispositivos de este DMS” sin mantener una lista individual de cada dispositivo. Cuando se añade un recurso bajo esa relación, hereda el alcance previsto por la política.",{"_3328":67935,"_29138":67831,"_20209":113253,"_5":13819,"_26493":112966,"_2816":113254},[],"`column_filters` aplica condiciones a columnas que el esquema haya declarado como filtrables. Todos los filtros de una misma regla se combinan con AND.",{"_3328":67936,"_29138":67831,"_20209":113256,"_5":13819,"_26493":112966,"_2816":113257},[],"Por ejemplo, esta regla permite leer certificados activos emitidos por una CA concreta:",{"_3328":67937,"_29138":67831,"_20209":113259,"_5":13819,"_26493":112966,"_2816":113260},[],"Los operadores disponibles son `eq`, `neq`, `gt`, `gte`, `lt`, `lte`, `in` y `like`. Usa comparaciones coherentes con el tipo de columna: `like` para texto, comparaciones de orden para números o fechas y `in` cuando haya una colección de valores aceptados.",{"_3328":67938,"_29138":67831,"_20209":113262,"_5":13819,"_26493":112970,"_2816":113263},[],"Las reglas HTTP no apuntan directamente a tablas. Referencian un esquema de rutas y conceden sus acciones lógicas. Las políticas del Job Manager son un ejemplo: distinguen lectura, creación, actualización y eliminación de workflows o jobs.",{"_3328":67939,"_29138":67831,"_20209":113265,"_5":13819,"_26493":112970,"_2816":113266},[],"Algunas rutas también comparan un valor de la petición —extraído de la ruta, query, cabecera o cuerpo JSON— con un atributo normalizado del principal. Así puede verificarse que un dispositivo solo consulte trabajos dirigidos a su propio `client_id`.",{"_3328":67940,"_29138":67831,"_20209":113268,"_5":13819,"_26493":112970,"_2816":113269},[],"Los atributos normalizados desacoplan la política del mecanismo de autenticación. `subject_attribute_mappings` puede derivar, por ejemplo, `device_id` desde `oidc.claim.device_id` o desde `x509.subject.cn`. La regla consume `device_id` en ambos casos.",{"_3328":67941,"_29138":67831,"_20209":113271,"_5":13819,"_26493":112970,"_2816":113272},[],"Una regla HTTP también puede fijar una acción concedida a un valor literal que la propia petición transporte, mediante `param_constraints`. Extrae el valor con las mismas fuentes que las restricciones de ruta —`path_regex_group`, `query`, `header` o `json_body`— pero lo compara con un literal `equals` escrito en la política, no con un atributo del principal. El grant depende entonces solo de la petición, no de quién posea la política:",{"_3328":67942,"_29138":67831,"_20209":113274,"_5":13819,"_26493":112970,"_2816":113275},[],"Combinada con una ruta del esquema como `^/api/mysvc/system/([^/]+)/info$`, concede `GET /api/mysvc/system/1/info` y deniega la misma llamada para el sistema `2`, con independencia de los atributos del principal. El mismo mecanismo fija parámetros de query, cabeceras o campos del cuerpo JSON, por ejemplo `{ \"source\": \"query\", \"name\": \"tenant_id\" }` con `\"equals\": \"1\"` para aceptar solo peticiones que lleven `?tenant_id=1`.",{"_3328":67943,"_29138":67831,"_20209":113277,"_5":13819,"_26493":112970,"_2816":113278},[],"Ten en cuenta que:",{"_3328":67944,"_29138":67831,"_20209":113280,"_5":13819,"_26493":112970,"_2816":113281},[],"`action` debe estar entre las acciones concedidas por la regla; `equals` es obligatorio; `path_regex_group` necesita un `index` mayor que cero, `query` y `header` un `name`, y `json_body` un `path` como `$.tenant_id`.",{"_3328":67945,"_29138":67831,"_20209":113283,"_5":13819,"_26493":112970,"_2816":113284},[],"`param_constraints` no se coteja con el esquema al cargar la política. Una referencia que la ruta no puede satisfacer —por ejemplo, un `path_regex_group` sobre una ruta sin grupos de captura— simplemente nunca coincide y la petición se deniega.",{"_3328":67946,"_29138":67831,"_20209":113286,"_5":13819,"_26493":112970,"_2816":113287},[],"Varios `param_constraints` para la misma acción se combinan con AND. Una regla sin ellos conserva el comportamiento habitual: la acción se concede donde la ruta coincida y las restricciones del principal se cumplan.",{"_3328":67947,"_29138":67831,"_20209":113289,"_5":13819,"_26493":112974,"_2816":113290},[],"La precarga de `authz` instala políticas reutilizables para los dominios principales. Entre ellas se encuentran:",{"_3328":67948,"_29138":67831,"_20209":113292,"_5":13819,"_26493":112974,"_2816":113293},[],"acceso completo y de solo lectura a certificados y autoridades;",{"_3328":67949,"_29138":67831,"_20209":113295,"_5":13819,"_26493":112974,"_2816":113296},[],"acceso completo y de solo lectura a KMS;",{"_3328":67950,"_29138":67831,"_20209":113298,"_5":13819,"_26493":112974,"_2816":113299},[],"acceso completo y de solo lectura a Device Manager, DMS Manager, Validation Authority y alertas;",{"_3328":67951,"_29138":67831,"_20209":113301,"_5":13819,"_26493":112974,"_2816":113302},[],"una política `Auditor` de lectura de PKI y visibilidad de autorización;",{"_3328":67952,"_29138":67831,"_20209":113304,"_5":13819,"_26493":112974,"_2816":113305},[],"acceso a la interfaz;",{"_3328":67953,"_29138":67831,"_20209":113307,"_5":13819,"_26493":112974,"_2816":113308},[],"políticas de administración y observación para las APIs NBI y SBI del Job Manager;",{"_3328":67954,"_29138":67831,"_20209":113310,"_5":13819,"_26493":112974,"_2816":113311},[],"`SUPER ADMIN`, que concede todas las acciones sobre los dominios `authz` y `pki`.",{"_3328":67955,"_29138":67831,"_20209":113313,"_5":13819,"_26493":112974,"_2816":113314},[],"Empieza por estas políticas antes de crear otras. Si ninguna refleja el límite que necesitas, crea una política específica y pequeña en lugar de copiar `SUPER ADMIN` y retirar permisos de forma informal.",{"_3328":67956,"_29138":67831,"_20209":113316,"_5":13819,"_26493":112978,"_2816":113317},[],"Una instalación sin un principal que coincida con tu identidad queda sin nadie capaz de administrar la autorización. Configura el IdP y el bootstrap antes de exponer la plataforma.",{"_3328":67957,"_29138":67831,"_20209":113319,"_5":13819,"_26493":112978,"_2816":113320},[],"El chart incluye un principal de bootstrap que busca el rol OIDC `pki-admin` en `realm_access.roles`. Le concede `SUPER ADMIN` y, cuando Job Manager está habilitado, la política administrativa de su API NBI.",{"_3328":67958,"_29138":67831,"_20209":113322,"_5":13819,"_26493":112978,"_2816":113323},[],"El Job Helm de preinstalación y preactualización ejecuta las migraciones de `authz`, precarga las políticas y crea los principales de bootstrap antes de iniciar los servicios. Si el principal ya existe, no lo reemplaza: añade únicamente los grants configurados que todavía falten. Puedes conservar la entrada en `values.yaml` durante las actualizaciones.",{"_3328":67959,"_29138":67831,"_20209":113325,"_5":13819,"_26493":112981,"_2816":113326},[],"Crea el rol o grupo que utilizarás para recuperar y administrar Lamassu. Asígnalo al menos a dos identidades humanas controladas. Si tu proveedor no usa `realm_access.roles`, adapta la ruta del claim tanto en el frontend como en `auth_config.claims`.",{"_3328":67960,"_29138":67831,"_20209":113328,"_5":13819,"_26493":112985,"_2816":113329},[],"`authz` valida cada token contra `services.authz.jwkUrl`, que se consulta desde el pod de `authz`. El Gateway no valida los tokens por sí mismo: los servicios de Lamassu autorizan cada petición a través de `authz`, y las rutas con la etiqueta `auth=external`, como las de Job Manager, las comprueba el Gateway a través de `authz` cuando `auth.externalAuthorization` está habilitado. El endpoint debe servir las claves del emisor configurado en `auth.oidc.frontend.authority`.",{"_3328":67961,"_29138":67831,"_20209":113331,"_5":13819,"_26493":112985,"_2816":113332},[],"Las releases actualizadas desde 3.8.0 deben eliminar `auth.oidc.apiGateway` y `auth.authorization`, que el chart 4.0.0 rechaza. Consulta 3.8.0 a 4.0.0.",{"_3328":67962,"_29138":67831,"_20209":113334,"_5":13819,"_26493":112989,"_2816":113335},[],"Inicia sesión con una identidad que tenga `pki-admin`. Confirma que puede acceder a la administración de autorización y realizar una operación de lectura no destructiva.",{"_3328":67963,"_29138":67831,"_20209":113337,"_5":13819,"_26493":112993,"_2816":113338},[],"Usa un segundo usuario sin el rol y confirma que la misma operación queda denegada. Esta prueba detecta claims mal interpretados, políticas demasiado amplias y configuraciones `failOpen` accidentales.",{"_3328":67964,"_29138":67831,"_20209":113340,"_5":13819,"_26493":112997,"_2816":113341},[],"Crea principales operativos con políticas de menor alcance. Reserva `pki-admin` para administración de autorización y recuperación, no para el trabajo diario.",{"_3328":67965,"_29138":67831,"_20209":113343,"_5":13819,"_26493":113001,"_2816":113344},[],"Fastlane instala un realm de Keycloak para laboratorio y crea el usuario `lamassu` con contraseña temporal `lamassu`, rol `pki-admin` y cambio de contraseña obligatorio. Su principal de bootstrap coincide mediante `preferred_username=lamassu`.",{"_3328":67966,"_29138":67831,"_20209":113346,"_5":13819,"_26493":113001,"_2816":113347},[],"Cambia la contraseña en el primer acceso. No reutilices el usuario, la contraseña ni el IdP de Fastlane como diseño de producción.",{"_3328":67967,"_29138":67831,"_20209":113349,"_5":13819,"_26493":113005,"_2816":113350},[],"Evita reproducir la estructura interna de tu empresa con decenas de políticas casi idénticas. Empieza por las responsabilidades que realmente necesitan acceso:",{"_3328":67968,"_29138":67831,"_20209":113352,"_5":13819,"_26493":113005,"_2816":113353},[],"**Administración de autorización**: gestiona principales, políticas y grants. Debe pertenecer a un grupo pequeño y separado.",{"_3328":67969,"_29138":67831,"_20209":113355,"_5":13819,"_26493":113005,"_2816":113356},[],"**Operación de PKI**: administra CAs, perfiles y certificados, pero no necesariamente puede modificar quién obtiene acceso.",{"_3328":67970,"_29138":67831,"_20209":113358,"_5":13819,"_26493":113005,"_2816":113359},[],"**Registro de dispositivos**: opera dispositivos y DMS sin recibir permisos sobre claves o configuración de autorización.",{"_3328":67971,"_29138":67831,"_20209":113361,"_5":13819,"_26493":113005,"_2816":113362},[],"**Auditoría**: consulta configuración y actividad sin crear, modificar, firmar, revocar ni eliminar.",{"_3328":67972,"_29138":67831,"_20209":113364,"_5":13819,"_26493":113005,"_2816":113365},[],"**Automatización**: utiliza una cuenta técnica o certificado independiente, con permisos limitados al flujo y recursos que controla.",{"_3328":67973,"_29138":67831,"_20209":113367,"_5":13819,"_26493":113005,"_2816":113368},[],"Para cada rol, separa “ver” de “cambiar”, limita los recursos mediante grants, relaciones o atributos y evita `*` salvo que el rol deba abarcar futuras acciones automáticamente.",{"_3328":67974,"_29138":67831,"_20209":113370,"_5":13819,"_26493":113005,"_2816":113371},[],"Una regla con `actions: [\"*\"]` se expande a todas las acciones definidas por el esquema. Cuando una versión nueva añade una acción, una política con comodín puede empezar a concederla. Revisa estas políticas durante cada actualización.",{"_3328":67975,"_29138":67831,"_20209":113373,"_5":13819,"_26493":113009,"_2816":113374},[],"Para retirar acceso de inmediato, desactiva el principal o revoca sus grants. Desactivar un principal conserva su configuración y asociaciones para investigación o restauración, pero deja de participar en la coincidencia.",{"_3328":67976,"_29138":67831,"_20209":113376,"_5":13819,"_26493":113009,"_2816":113377},[],"Eliminar un rol o grupo en el IdP evita que nuevos tokens contengan el claim, pero un token ya emitido puede seguir siendo válido hasta expirar. Si la retirada es urgente, combina el cambio en el IdP con la desactivación del principal en Lamassu y la revocación de sesiones o tokens en el proveedor.",{"_3328":67977,"_29138":67831,"_20209":113379,"_5":13819,"_26493":113009,"_2816":113380},[],"Cuando edites una política compartida, recuerda que el cambio afecta a todos sus principales. Para probar un nuevo alcance, crea una política separada, concédela a una identidad de prueba y valida operaciones permitidas y denegadas antes de sustituir la anterior.",{"_3328":67978,"_29138":67831,"_20209":113382,"_5":13819,"_26493":113013,"_2816":113383},[],"Mantén `failOpen: false` salvo que una evaluación de riesgo documentada justifique lo contrario.",{"_3328":67979,"_29138":67831,"_20209":113385,"_5":13819,"_26493":113013,"_2816":113386},[],"Usa grupos o roles estables para personas e identidades independientes para automatizaciones.",{"_3328":67980,"_29138":67831,"_20209":113388,"_5":13819,"_26493":113013,"_2816":113389},[],"Conserva al menos dos administradores de recuperación y prueba su acceso periódicamente.",{"_3328":67981,"_29138":67831,"_20209":113391,"_5":13819,"_26493":113013,"_2816":113392},[],"Revisa los principales activos, sus coincidencias y sus grants después de cambios en el IdP.",{"_3328":67982,"_29138":67831,"_20209":113394,"_5":13819,"_26493":113013,"_2816":113395},[],"Busca comodines en políticas antes de actualizar Lamassu.",{"_3328":67983,"_29138":67831,"_20209":113397,"_5":13819,"_26493":113013,"_2816":113398},[],"Revisa las rutas `skip_authz` y los ajustes de `default_action` de los esquemas HTTP al integrar o actualizar un servicio.",{"_3328":67984,"_29138":67831,"_20209":113400,"_5":13819,"_26493":113013,"_2816":113401},[],"Prueba siempre una operación permitida y otra denegada para cada rol.",{"_3328":67985,"_29138":67831,"_20209":113403,"_5":13819,"_26493":113013,"_2816":113404},[],"Correlaciona los cambios de principales, políticas y grants con los registros de auditoría.",{"_3328":67986,"_29138":67831,"_20209":113406,"_5":13819,"_26493":113021,"_2816":113407},[],"La autenticación falló antes de evaluar permisos. Comprueba la firma y expiración del JWT, el emisor, la audiencia y la disponibilidad del JWKS configurado en el Gateway. Para X.509, revisa que el certificado cliente llegue hasta el punto que extrae la credencial.",{"_3328":67987,"_29138":67831,"_20209":113409,"_5":13819,"_26493":113025,"_2816":113410},[],"La credencial pudo procesarse, pero no produjo una autorización positiva. Revisa en este orden:",{"_3328":67988,"_29138":67831,"_20209":113412,"_5":13819,"_26493":113025,"_2816":113413},[],"que exista un principal activo del tipo correcto;",{"_3328":67989,"_29138":67831,"_20209":113415,"_5":13819,"_26493":113025,"_2816":113416},[],"que las rutas de claims y sus valores coincidan exactamente con el token real;",{"_3328":67990,"_29138":67831,"_20209":113418,"_5":13819,"_26493":113025,"_2816":113419},[],"que todas las condiciones del principal se cumplan;",{"_3328":67991,"_29138":67831,"_20209":113421,"_5":13819,"_26493":113025,"_2816":113422},[],"que el principal tenga concedida la política esperada;",{"_3328":67992,"_29138":67831,"_20209":113424,"_5":13819,"_26493":113025,"_2816":113425},[],"que la política incluya la acción y el tipo de recurso o ruta solicitados;",{"_3328":67993,"_29138":67831,"_20209":113427,"_5":13819,"_26493":113025,"_2816":113428},[],"que el identificador, relación, filtro de columna o restricción HTTP incluya el recurso real.",{"_3328":67994,"_29138":67831,"_20209":113430,"_5":13819,"_26493":113025,"_2816":113431},[],"En los logs de `authz`, una decisión del endpoint externo incluye `allowed`, `reason`, `matched_principals`, `evaluated_policy_ids`, `matched_policy_id` y el código de estado. Estos campos permiten separar un fallo de coincidencia de un fallo de permisos. Con las trazas OpenTelemetry habilitadas, una solicitud que llega al motor de políticas genera un span `engine.CheckHTTPRequest` cuyos atributos registran `authz.allowed`, la política coincidente y el principal coincidente. Para correlacionarlo con la traza del Gateway, el contexto de traza debe propagarse hasta authz.",{"_3328":67995,"_29138":67831,"_20209":113433,"_5":13819,"_26493":113029,"_2816":113434},[],"Comprueba que el principal de bootstrap fue creado y que las políticas fueron precargadas por el Job de migración. Verifica también que `services.authz.jwkUrl` sea alcanzable desde el pod de `authz`; no asumas que una URL pública accesible desde el navegador también funciona dentro del clúster.",{"_3328":67996,"_29138":67831,"_20209":113436,"_5":13819,"_26493":113033,"_2816":113437},[],"La ruta puede estar cubierta por una decisión del esquema y no por una política: las rutas marcadas con `skip_authz` permiten el paso a cualquier identidad que coincida con un principal activo, y una petición bajo un prefijo de `base_paths` cuyo esquema fija `default_action: allow` también se concede sin consultar políticas. Comprueba cuál de las dos situaciones aplica antes de buscar grants ausentes o mal asignados.",{"_3328":67997,"_29138":67831,"_20209":113439,"_5":13819,"_26493":113037,"_2816":113440},[],"Es el comportamiento esperado con `failOpen: false`. Restaura el servicio, su conexión con PostgreSQL y su conectividad con el JWKS. No cambies temporalmente a `failOpen: true` sin aceptar que las rutas protegidas podrían quedar accesibles sin decisión de autorización.",{"_3328":67998,"_29138":67831,"_20209":113442,"_5":13819,"_26493":113037,"_2816":113443},[],"Continúa con Registros de auditoría para investigar cambios de configuración o con Resolución de problemas para diagnosticar el despliegue.",{"_3328":67999,"_29138":67999,"_5":14177,"_2816":113445,"_29461":113446,"_20209":113447,"_26493":67999},"Alertas y suscripciones",[47397,112910,112911],[],{"_3328":68000,"_29138":67999,"_20209":113449,"_5":13819,"_26493":67999,"_2816":113450},[],"Envía eventos de la PKI a personas y sistemas externos.",{"_3328":68001,"_29138":67999,"_5":29458,"_20209":113452,"_26493":113453,"_2816":113454},[],"/docs/es/platform/administration/alerts#cómo-funciona","Cómo funciona",{"_3328":68002,"_29138":67999,"_5":29458,"_20209":113456,"_26493":113457,"_2816":113458},[],"/docs/es/platform/administration/alerts#canales-disponibles","Canales disponibles",{"_3328":68003,"_29138":67999,"_5":29458,"_20209":113460,"_26493":113461,"_2816":113462},[],"/docs/es/platform/administration/alerts#crea-una-suscripción","Crea una suscripción",{"_3328":68004,"_29138":67999,"_5":29458,"_20209":113464,"_26493":113465,"_2816":113466},[],"/docs/es/platform/administration/alerts#elige-el-evento","Elige el evento",{"_3328":68005,"_29138":67999,"_5":29458,"_20209":113468,"_26493":113469,"_2816":113470},[],"/docs/es/platform/administration/alerts#configura-el-destino","Configura el destino",{"_3328":68006,"_29138":67999,"_5":29458,"_20209":113472,"_26493":113473,"_2816":113474},[],"/docs/es/platform/administration/alerts#limita-las-notificaciones","Limita las notificaciones",{"_3328":68007,"_29138":67999,"_5":29458,"_20209":113476,"_26493":113477,"_2816":113478},[],"/docs/es/platform/administration/alerts#revisa-y-activa","Revisa y activa",{"_3328":68008,"_29138":67999,"_5":29458,"_20209":113480,"_26493":113481,"_2816":113482},[],"/docs/es/platform/administration/alerts#configura-el-cliente-http-del-webhook","Configura el cliente HTTP del webhook",{"_3328":68009,"_29138":67999,"_5":29458,"_20209":113484,"_26493":113485,"_2816":113486},[],"/docs/es/platform/administration/alerts#reglas-de-entrega-del-webhook","Reglas de entrega del webhook",{"_3328":68010,"_29138":67999,"_5":29458,"_20209":113488,"_26493":113489,"_2816":113490},[],"/docs/es/platform/administration/alerts#gestiona-una-suscripción","Gestiona una suscripción",{"_3328":68011,"_29138":67999,"_5":29458,"_20209":113492,"_26493":113493,"_2816":113494},[],"/docs/es/platform/administration/alerts#familias-de-eventos","Familias de eventos",{"_3328":68012,"_29138":67999,"_20209":113496,"_5":13819,"_26493":67999,"_2816":113497},[],"Las suscripciones convierten los eventos de Lamassu en notificaciones accionables. Puedes avisar a un equipo, alimentar un sistema de incidentes o activar una automatización cuando cambia una CA, un certificado o un dispositivo.",{"_3328":68013,"_29138":67999,"_20209":113499,"_5":13819,"_26493":113453,"_2816":113500},[],"Un servicio publica un evento de dominio.",{"_3328":68014,"_29138":67999,"_20209":113502,"_5":13819,"_26493":113453,"_2816":113503},[],"Lamassu evalúa las suscripciones asociadas a ese tipo de evento.",{"_3328":68015,"_29138":67999,"_20209":113505,"_5":13819,"_26493":113453,"_2816":113506},[],"El filtro de cada suscripción decide si debe notificarse.",{"_3328":68016,"_29138":67999,"_20209":113508,"_5":13819,"_26493":113453,"_2816":113509},[],"Lamassu entrega el evento al canal configurado.",{"_3328":68017,"_29138":67999,"_20209":113511,"_5":13819,"_26493":113453,"_2816":113512},[],"El inventario de eventos muestra cuándo se observó cada tipo por última vez, cuántas veces ha ocurrido y cuántas suscripciones tiene. Puedes expandir un evento para inspeccionar un ejemplo de su payload JSON antes de crear el filtro.",{"_3328":68018,"_29138":67999,"_20209":113514,"_5":13819,"_26493":113457,"_2816":113515},[],"**Email** envía avisos a una persona o lista operativa. Solo requiere la dirección de destino. El contenido del evento se entrega como texto HTML escapado, nunca como marcado.",{"_3328":68019,"_29138":67999,"_20209":113517,"_5":13819,"_26493":113457,"_2816":113518},[],"**Microsoft Teams** publica la notificación en un canal mediante su URL de webhook.",{"_3328":68020,"_29138":67999,"_20209":113520,"_5":13819,"_26493":113457,"_2816":113521},[],"**Webhook** entrega el evento a una automatización, SIEM o sistema de incidentes mediante `POST` o `PUT`.",{"_3328":68021,"_29138":67999,"_20209":113523,"_5":13819,"_26493":113457,"_2816":113524},[],"Los canales Microsoft Teams y Webhook aceptan un bloque opcional `http_client` que autentica la llamada al receptor. `auth_mode` selecciona `noauth` (por defecto), `apikey`, `jwt` o `mtls`; cada modo exige sus propias opciones:",{"_3328":68022,"_29138":67999,"_20209":113526,"_5":13819,"_26493":113457,"_2816":113527},[],"`apikey_options` necesita `header` y `key`.",{"_3328":68023,"_29138":67999,"_20209":113529,"_5":13819,"_26493":113457,"_2816":113530},[],"`jwt_options` necesita `oidc_client_id`, `oidc_client_secret` y un `oidc_well_known` absoluto `http` o `https`.",{"_3328":68024,"_29138":67999,"_20209":113532,"_5":13819,"_26493":113457,"_2816":113533},[],"`mtls_options` necesita `cert_content` y `key_content` como PEM codificado en Base64, como el resto de certificados de la API; también se acepta el PEM en claro. Los valores que referencian archivos del servidor se rechazan, y el par debe corresponder a un certificado y una clave privada coincidentes.",{"_3328":68025,"_29138":67999,"_20209":113535,"_5":13819,"_26493":113457,"_2816":113536},[],"La referencia de la API de Alerts documenta el esquema completo de `http_client`.",{"_3328":68026,"_29138":67999,"_20209":113538,"_5":13819,"_26493":113465,"_2816":113539},[],"Abre **Alerts**, localiza el tipo de evento y selecciona **Subscribe**. Revisa el último ejemplo JSON para identificar los campos que necesitarás filtrar.",{"_3328":68027,"_29138":67999,"_20209":113541,"_5":13819,"_26493":113469,"_2816":113542},[],"Selecciona Email, Microsoft Teams o Webhook e introduce los datos del canal.",{"_3328":68028,"_29138":67999,"_20209":113544,"_5":13819,"_26493":113473,"_2816":113545},[],"Añade un filtro si no quieres recibir todas las instancias del evento.",{"_3328":68029,"_29138":67999,"_20209":113547,"_5":13819,"_26493":113473,"_2816":113548},[],"**None** notifica todas las instancias del evento.",{"_3328":68030,"_29138":67999,"_20209":113550,"_5":13819,"_26493":113473,"_2816":113551},[],"**JSON Path** evalúa uno o varios campos concretos.",{"_3328":68031,"_29138":67999,"_20209":113553,"_5":13819,"_26493":113473,"_2816":113554},[],"**JSON Schema** acepta únicamente payloads con una estructura determinada.",{"_3328":68032,"_29138":67999,"_20209":113556,"_5":13819,"_26493":113473,"_2816":113557},[],"**JavaScript** permite expresar lógica personalizada. Cada filtro se ejecuta como máximo durante 100 milisegundos; un filtro que supera ese límite hace fallar la condición y la notificación se omite con el error `javascript filter execution timed out`.",{"_3328":68033,"_29138":67999,"_20209":113559,"_5":13819,"_26493":113473,"_2816":113560},[],"Por ejemplo, `function (event) { return event.data.status == \"NO_IDENTITY\"; }` limita una suscripción a dispositivos sin identidad.",{"_3328":68034,"_29138":67999,"_20209":113562,"_5":13819,"_26493":113477,"_2816":113563},[],"Comprueba el evento, el canal y el filtro en el resumen. Selecciona **Confirm Subscription** para comenzar la entrega.",{"_3328":68035,"_29138":67999,"_20209":113565,"_5":13819,"_26493":113481,"_2816":113566},[],"Los canales Webhook y Microsoft Teams muestran esta configuración en el formulario de suscripción, en el paso del canal, y de nuevo al editar una suscripción; Email no la utiliza. Los campos se corresponden con el bloque opcional `http_client` descrito arriba:",{"_3328":68036,"_29138":67999,"_20209":113568,"_5":13819,"_26493":113481,"_2816":113569},[],"**Log Level** selecciona `debug`, `info`, `warn` o `error`; `info` es el valor por defecto.",{"_3328":68037,"_29138":67999,"_20209":113571,"_5":13819,"_26493":113481,"_2816":113572},[],"**Call Timeout** es de 10 segundos por defecto. La consola rechaza un valor superior a 30 segundos con `Webhook timeout must be at most 30s.`; la API ajusta ese mismo valor al tope en lugar de rechazarlo (ver Las llamadas están limitadas).",{"_3328":68038,"_29138":67999,"_20209":113574,"_5":13819,"_26493":113481,"_2816":113575},[],"No hay interruptor de verificación TLS para estos canales, porque el servicio siempre verifica el certificado del receptor (ver TLS siempre se verifica).",{"_3328":68039,"_29138":67999,"_20209":113577,"_5":13819,"_26493":113481,"_2816":113578},[],"**HTTP Authentication** selecciona `No Authentication` (por defecto), `API Key` (valor de la API key y Header Name, `X-API-Key` por defecto), `OIDC Client Credentials` (Client ID, Client Secret y Well-Known URL) o `Mutual TLS` (Client Certificate y Client Private Key pegados como PEM). Una clave privada guardada permanece oculta hasta que seleccionas **Show**.",{"_3328":68040,"_29138":67999,"_20209":113580,"_5":13819,"_26493":113481,"_2816":113581},[],"Una URL `http://` muestra en la consola la advertencia `Unencrypted HTTP connection` (ver la llamada Credenciales sobre http\\:// más abajo).",{"_3328":68041,"_29138":67999,"_20209":113583,"_5":13819,"_26493":113481,"_2816":113584},[],"Los campos se validan en línea con las mismas reglas de entrega: la URL del webhook y la Well-Known URL de OIDC deben ser URLs absolutas `http` o `https`, una cabecera API-key no puede usar un nombre reservado y el certificado y la clave mTLS deben ser contenido PEM, no rutas de ficheros.",{"_3328":68042,"_29138":67999,"_20209":113586,"_5":13819,"_26493":113481,"_2816":113587},[],"El resumen del paso de confirmación muestra la autenticación como `None`, `OIDC client credentials`, `API key` o `Mutual TLS`. Los detalles de la suscripción muestran la autenticación, el nombre de la cabecera API-key (nunca el valor), la URL del emisor OIDC, mTLS como `Configured` y una fila fija `TLS verification: Verified`. La API key, el client secret y la clave privada no se muestran en los detalles de la suscripción.",{"_3328":68043,"_29138":67999,"_20209":113589,"_5":13819,"_26493":113485,"_2816":113590},[],"Las notificaciones enviadas por los canales Microsoft Teams y Webhook siguen una política HTTP fija:",{"_3328":68044,"_29138":67999,"_20209":113592,"_5":13819,"_26493":113485,"_2816":113593},[],"**TLS siempre se verifica.** El certificado del receptor se comprueba contra el almacén de confianza del sistema. `insecure_skip_verify` se aplica siempre como `false` — también cuando se establece en `true` — así que un receptor con certificado propio o no confiable falla la entrega.",{"_3328":68045,"_29138":67999,"_20209":113595,"_5":13819,"_26493":113485,"_2816":113596},[],"**No se siguen redirecciones.** Una respuesta `3xx` falla con `unexpected status code: <n>: redirects are not followed`. Configura `webhook_url` con la URL final absoluta `http` o `https`: una dirección `http://` que un ingress redirige a `https://` deja de funcionar.",{"_3328":68046,"_29138":67999,"_20209":113598,"_5":13819,"_26493":113485,"_2816":113599},[],"**Las llamadas están limitadas.** Una llamada tiene por defecto un timeout de 10 segundos; un `call_timeout` configurado se limita a 30 segundos. Los valores por encima del tope se ajustan, no se rechazan.",{"_3328":68047,"_29138":67999,"_20209":113601,"_5":13819,"_26493":113485,"_2816":113602},[],"**El cuerpo de la respuesta se ignora.** La entrega comprueba solo el código de estado, así que el receptor puede responder con cualquier cuerpo.",{"_3328":68048,"_29138":67999,"_20209":113604,"_5":13819,"_26493":113485,"_2816":113605},[],"**Las cabeceras API-key están restringidas.** Un `apikey_options.header` propio no puede usar nombres en los que la plataforma o los servicios receptores confían — por ejemplo `X-Principal-Id`, `X-Request-Id`, `Host`, `Content-Type` o `Forwarded` — y ningún nombre puede empezar por `X-Forwarded-`, `X-Envoy-` o `X-Lms-`. La comparación no distingue mayúsculas.",{"_3328":68049,"_29138":67999,"_20209":113607,"_5":13819,"_26493":113485,"_2816":113608},[],"**Las configuraciones inválidas se rechazan al suscribir.** Una configuración de canal que fallaría en cada entrega devuelve HTTP 400 con un cuerpo que empieza por `struct validation error:` y la suscripción no se crea.",{"_3328":68050,"_29138":67999,"_20209":113610,"_5":13819,"_26493":113485,"_2816":113611},[],"Las credenciales se envían sea cual sea el esquema de la URL. Con un `webhook_url` `http://`, la API key o el bearer token viajan en texto claro y mTLS no tiene efecto. Prefiere `https://` para `webhook_url`, `oidc_well_known` y el token endpoint que anuncia.",{"_3328":68051,"_29138":67999,"_20209":113613,"_5":13819,"_26493":113489,"_2816":113614},[],"Abre una suscripción existente para consultar su destino y filtro, modificar la configuración o seleccionar **Unsubscribe**. Elimina las suscripciones que ya no tengan un propietario operativo para evitar entregas ignoradas o endpoints obsoletos.",{"_3328":68052,"_29138":67999,"_20209":113616,"_5":13819,"_26493":113489,"_2816":113617},[],"Las suscripciones creadas con versiones anteriores de la consola pueden guardar el destino del webhook en `url` y `method` en lugar de `webhook_url` y `webhook_method`. El servicio entrega solo a través de `webhook_url` y `webhook_method`, así que una suscripción así no entrega aunque los detalles de la suscripción muestren el destino guardado. Abre la suscripción y vuelve a guardarla: el formulario de edición precarga el destino guardado, y al guardar se reescribe la configuración del canal con el formato actual.",{"_3328":68053,"_29138":67999,"_20209":113619,"_5":13819,"_26493":113493,"_2816":113620},[],"**Autoridades:** `ca.create`, `ca.import`, `ca.reissue` y `ca.delete`.",{"_3328":68054,"_29138":67999,"_20209":113622,"_5":13819,"_26493":113493,"_2816":113623},[],"**Certificados:** `ca.sign.certificate` y `certificate.delete`.",{"_3328":68055,"_29138":67999,"_20209":113625,"_5":13819,"_26493":113493,"_2816":113626},[],"**Perfiles:** `profile.issuance.create`, `profile.issuance.update` y `profile.issuance.delete`.",{"_3328":68056,"_29138":67999,"_20209":113628,"_5":13819,"_26493":113493,"_2816":113629},[],"**Enrolamiento:** `dms.create`, `dms.update`, `dms.enroll` y `dms.reenroll`.",{"_3328":68057,"_29138":67999,"_20209":113631,"_5":13819,"_26493":113493,"_2816":113632},[],"**Dispositivos:** `device.create`, `device.identity.update` y `device.status.update`.",{"_3328":68058,"_29138":67999,"_20209":113634,"_5":13819,"_26493":113493,"_2816":113635},[],"**Validación:** `va.role.crl.create`.",{"_3328":68059,"_29138":67999,"_20209":113637,"_5":13819,"_26493":113493,"_2816":113638},[],"**Claves:** `kms.create`, `kms.import`, `kms.sign` y `kms.delete`.",{"_3328":68060,"_29138":67999,"_20209":113640,"_5":13819,"_26493":113493,"_2816":113641},[],"Utiliza el catálogo que muestra la consola como fuente para los tipos disponibles en la versión que tienes desplegada.",{"_3328":68061,"_29138":68061,"_5":14177,"_2816":113643,"_29461":113644,"_20209":113645,"_26493":68061},"Registros de auditoría",[47397,112910,112911],[],{"_3328":68062,"_29138":68061,"_20209":113647,"_5":13819,"_26493":68061,"_2816":113648},[],"Entiende qué eventos de auditoría genera Lamassu y cómo convertirlos en una pista durable.",{"_3328":68063,"_29138":68061,"_5":29458,"_20209":113650,"_26493":113651,"_2816":113652},[],"/docs/es/platform/administration/audit-logs#qué-contiene-un-evento","Qué contiene un evento",{"_3328":68064,"_29138":68061,"_5":29458,"_20209":113654,"_26493":113655,"_2816":113656},[],"/docs/es/platform/administration/audit-logs#cobertura","Cobertura",{"_3328":68065,"_29138":68061,"_5":29458,"_20209":113658,"_26493":113659,"_2816":113660},[],"/docs/es/platform/administration/audit-logs#publicación-y-persistencia","Publicación y persistencia",{"_3328":68066,"_29138":68061,"_5":29458,"_20209":113662,"_26493":113663,"_2816":113664},[],"/docs/es/platform/administration/audit-logs#datos-sensibles","Datos sensibles",{"_3328":68067,"_29138":68061,"_5":29458,"_20209":113666,"_26493":113667,"_2816":113668},[],"/docs/es/platform/administration/audit-logs#una-investigación-reproducible","Una investigación reproducible",{"_3328":68068,"_29138":68061,"_5":29458,"_20209":113670,"_26493":113671,"_2816":113672},[],"/docs/es/platform/administration/audit-logs#acota-el-intervalo","Acota el intervalo",{"_3328":68069,"_29138":68061,"_5":29458,"_20209":113674,"_26493":113675,"_2816":113676},[],"/docs/es/platform/administration/audit-logs#identifica-la-operación","Identifica la operación",{"_3328":68070,"_29138":68061,"_5":29458,"_20209":113678,"_26493":113679,"_2816":113680},[],"/docs/es/platform/administration/audit-logs#atribuye-el-principal","Atribuye el principal",{"_3328":68071,"_29138":68061,"_5":29458,"_20209":113682,"_26493":113683,"_2816":113684},[],"/docs/es/platform/administration/audit-logs#compara-intención-y-resultado","Compara intención y resultado",{"_3328":68072,"_29138":68061,"_5":29458,"_20209":113686,"_26493":113687,"_2816":113688},[],"/docs/es/platform/administration/audit-logs#sigue-el-efecto","Sigue el efecto",{"_3328":68073,"_29138":68061,"_5":29458,"_20209":113690,"_26493":113691,"_2816":113692},[],"/docs/es/platform/administration/audit-logs#verificación-periódica","Verificación periódica",{"_3328":68074,"_29138":68061,"_20209":113694,"_5":13819,"_26493":68061,"_2816":113695},[],"Lamassu instrumenta las operaciones mutables de sus servicios con eventos de auditoría. Cada evento describe la operación, los principales que coincidieron, la entrada, el resultado y si terminó con error.",{"_3328":68075,"_29138":68061,"_20209":113697,"_5":13819,"_26493":113651,"_2816":113698},[],"El cuerpo de auditoría incluye:",{"_3328":68076,"_29138":68061,"_20209":113700,"_5":13819,"_26493":113651,"_2816":113701},[],"input: datos recibidos por la operación;",{"_3328":68077,"_29138":68061,"_20209":113703,"_5":13819,"_26493":113651,"_2816":113704},[],"has\\_error: indica si el servicio devolvió un error;",{"_3328":68078,"_29138":68061,"_20209":113706,"_5":13819,"_26493":113651,"_2816":113707},[],"output: resultado producido o mensaje de error;",{"_3328":68079,"_29138":68061,"_20209":113709,"_5":13819,"_26493":113651,"_2816":113710},[],"principals: identificadores de los principales que coincidieron con la petición.",{"_3328":68080,"_29138":68061,"_20209":113712,"_5":13819,"_26493":113651,"_2816":113713},[],"Las operaciones correctas usan un tipo con prefijo audit.. Los fallos publican el tipo de operación con sufijo .error. El evento CloudEvents añade, además, fuente, identificador, fecha y tipo.",{"_3328":68081,"_29138":68061,"_20209":113715,"_5":13819,"_26493":113651,"_2816":113716},[],"Los middlewares publican el registro después de ejecutar la operación, tanto si tuvo éxito como si devolvió un error. Esto permite investigar intentos además de cambios confirmados.",{"_3328":68082,"_29138":68061,"_20209":113718,"_5":13819,"_26493":113655,"_2816":113719},[],"El backend aplica auditoría a mutaciones de:",{"_3328":68083,"_29138":68061,"_20209":113721,"_5":13819,"_26493":113655,"_2816":113722},[],"autoridades, certificados y perfiles de emisión;",{"_3328":68084,"_29138":68061,"_20209":113724,"_5":13819,"_26493":113655,"_2816":113725},[],"claves y motores KMS;",{"_3328":68085,"_29138":68061,"_20209":113727,"_5":13819,"_26493":113655,"_2816":113728},[],"dispositivos e identidades;",{"_3328":68086,"_29138":68061,"_20209":113730,"_5":13819,"_26493":113655,"_2816":113731},[],"DMS y operaciones de enrolamiento;",{"_3328":68087,"_29138":68061,"_20209":113733,"_5":13819,"_26493":113655,"_2816":113734},[],"funciones de validación y CRL;",{"_3328":68088,"_29138":68061,"_20209":113736,"_5":13819,"_26493":113655,"_2816":113737},[],"principales, políticas y concesiones de autorización.",{"_3328":68089,"_29138":68061,"_20209":113739,"_5":13819,"_26493":113655,"_2816":113740},[],"No confundas estos eventos con los eventos de dominio. Un evento de dominio comunica que un recurso cambió para que otro componente reaccione; el evento de auditoría conserva contexto de entrada, salida y principal para investigación.",{"_3328":68090,"_29138":68061,"_20209":113742,"_5":13819,"_26493":113659,"_2816":113743},[],"Los servicios publican auditoría en el bus de eventos cuando su PublisherEventBus está habilitado. El código del backend no implementa un archivo de auditoría consultable y durable por sí solo.",{"_3328":68091,"_29138":68061,"_20209":113745,"_5":13819,"_26493":113659,"_2816":113746},[],"Si necesitas retención, búsquedas, protección contra alteraciones o exportación regulatoria, conecta un consumidor que persista los eventos en el sistema aprobado por tu organización.",{"_3328":68092,"_29138":68061,"_20209":113748,"_5":13819,"_26493":113659,"_2816":113749},[],"Diseña el consumidor para:",{"_3328":68093,"_29138":68061,"_20209":113751,"_5":13819,"_26493":113659,"_2816":113752},[],"suscribirse a los tipos audit.# y también a los tipos de operación terminados en .error;",{"_3328":68094,"_29138":68061,"_20209":113754,"_5":13819,"_26493":113659,"_2816":113755},[],"conservar el CloudEvent completo sin modificar;",{"_3328":68095,"_29138":68061,"_20209":113757,"_5":13819,"_26493":113659,"_2816":113758},[],"registrar el momento de ingestión y detectar duplicados por ID;",{"_3328":68096,"_29138":68061,"_20209":113760,"_5":13819,"_26493":113659,"_2816":113761},[],"cifrar en tránsito y en reposo;",{"_3328":68097,"_29138":68061,"_20209":113763,"_5":13819,"_26493":113659,"_2816":113764},[],"limitar lectura y borrado a un rol separado del operador de PKI;",{"_3328":68098,"_29138":68061,"_20209":113766,"_5":13819,"_26493":113659,"_2816":113767},[],"aplicar una política explícita de retención y legal hold;",{"_3328":68099,"_29138":68061,"_20209":113769,"_5":13819,"_26493":113659,"_2816":113770},[],"alertar si deja de consumir o aumenta la cola pendiente.",{"_3328":68100,"_29138":68061,"_20209":113772,"_5":13819,"_26493":113663,"_2816":113773},[],"Los campos input y output pueden contener sujetos, metadatos, material público, configuración o mensajes de error. Evalúa su clasificación antes de enviarlos a una plataforma externa.",{"_3328":68101,"_29138":68061,"_20209":113775,"_5":13819,"_26493":113663,"_2816":113776},[],"No registres claves privadas, secretos de proveedores ni tokens completos en automatizaciones que rodean a Lamassu. Restringe la exportación y aplica redacción en el destino sin destruir los campos necesarios para atribución.",{"_3328":68102,"_29138":68061,"_20209":113778,"_5":13819,"_26493":113671,"_2816":113779},[],"Parte de la hora reportada y normaliza todas las fuentes a UTC.",{"_3328":68103,"_29138":68061,"_20209":113781,"_5":13819,"_26493":113675,"_2816":113782},[],"Filtra por tipo de evento, fuente de servicio e identificador del recurso.",{"_3328":68104,"_29138":68061,"_20209":113784,"_5":13819,"_26493":113679,"_2816":113785},[],"Revisa principals y correlaciónalo con el proveedor OIDC o la identidad X.509 vigente en ese momento.",{"_3328":68105,"_29138":68061,"_20209":113787,"_5":13819,"_26493":113683,"_2816":113788},[],"Contrasta input, has\\_error y output. Un intento fallido no implica que el recurso haya cambiado.",{"_3328":68106,"_29138":68061,"_20209":113790,"_5":13819,"_26493":113687,"_2816":113791},[],"Busca los eventos de dominio y registros del servicio que compartan recurso y ventana temporal. En una revocación de CA, incluye las operaciones en cascada.",{"_3328":68107,"_29138":68061,"_20209":113793,"_5":13819,"_26493":113691,"_2816":113794},[],"Genera una mutación controlada en un entorno de prueba y comprueba que:",{"_3328":68108,"_29138":68061,"_20209":113796,"_5":13819,"_26493":113691,"_2816":113797},[],"aparece un evento de auditoría correcto;",{"_3328":68109,"_29138":68061,"_20209":113799,"_5":13819,"_26493":113691,"_2816":113800},[],"el principal coincide con la identidad utilizada;",{"_3328":68110,"_29138":68061,"_20209":113802,"_5":13819,"_26493":113691,"_2816":113803},[],"el consumidor lo persiste una sola vez;",{"_3328":68111,"_29138":68061,"_20209":113805,"_5":13819,"_26493":113691,"_2816":113806},[],"puede recuperarse por recurso, actor y periodo;",{"_3328":68112,"_29138":68061,"_20209":113808,"_5":13819,"_26493":113691,"_2816":113809},[],"una interrupción del consumidor produce una alerta.",{"_3328":68113,"_29138":68061,"_20209":113811,"_5":13819,"_26493":113691,"_2816":113812},[],"Para métricas, trazas y logs técnicos del despliegue, consulta Resolución de problemas. La auditoría responde a “quién intentó cambiar qué”; la observabilidad explica cómo se comportó el sistema.",{"_3328":68114,"_29138":68114,"_5":14177,"_2816":113814,"_29461":113815,"_20209":113816,"_26493":68114},"Arquitectura de la plataforma",[47397,112910],[],{"_3328":68115,"_29138":68114,"_20209":113818,"_5":13819,"_26493":68114,"_2816":113819},[],"Componentes de Lamassu y relación entre control, claves, emisión y dispositivos.",{"_3328":68116,"_29138":68114,"_5":29458,"_20209":113821,"_26493":113822,"_2816":113823},[],"/docs/es/platform/concepts/architecture#plano-de-control","Plano de control",{"_3328":68117,"_29138":68114,"_5":29458,"_20209":113825,"_26493":113826,"_2816":113827},[],"/docs/es/platform/concepts/architecture#custodia-y-operaciones-criptográficas","Custodia y operaciones criptográficas",{"_3328":68118,"_29138":68114,"_5":29458,"_20209":113829,"_26493":113830,"_2816":113831},[],"/docs/es/platform/concepts/architecture#emisión-y-enrolamiento","Emisión y enrolamiento",{"_3328":68119,"_29138":68114,"_5":29458,"_20209":113833,"_26493":113834,"_2816":113835},[],"/docs/es/platform/concepts/architecture#estado-y-validación","Estado y validación",{"_3328":68120,"_29138":68114,"_5":29458,"_20209":113837,"_26493":113838,"_2816":113839},[],"/docs/es/platform/concepts/architecture#dependencias-de-la-plataforma","Dependencias de la plataforma",{"_3328":68121,"_29138":68114,"_20209":113841,"_5":13819,"_26493":68114,"_2816":113842},[],"Lamassu se despliega como un conjunto de servicios independientes. La separación evita que todos los componentes necesiten acceso directo a las claves privadas y permite escalar cada capacidad según la carga.",{"_3328":68122,"_29138":68114,"_20209":113844,"_5":13819,"_26493":68114,"_2816":113845},[],"Cambia al nivel bajo para ver el interior de la caja de la plataforma Lamassu (CA, KMS, DMS, Device Manager, VA, Alerts, el conector de AWS IoT, Job Manager y la consola/API), y al nivel medio para verla como una única plataforma junto a sus dependencias externas.",{"_3328":68123,"_29138":68114,"_20209":113847,"_5":13819,"_26493":113822,"_2816":113848},[],"La consola y las APIs administran autoridades, certificados, DMS, dispositivos, alertas y configuración. Los eventos de dominio permiten que conectores y automatizaciones reaccionen a los cambios sin sondear continuamente la plataforma.",{"_3328":68124,"_29138":68114,"_20209":113850,"_5":13819,"_26493":113826,"_2816":113851},[],"El KMS ofrece una interfaz común sobre motores software, PKCS#11 y proveedores cloud. El motor seleccionado conserva la clave o delega la operación criptográfica sin que los demás servicios conozcan su implementación.",{"_3328":68125,"_29138":68114,"_20209":113853,"_5":13819,"_26493":113830,"_2816":113854},[],"El servicio de CA emite certificados y mantiene la relación con su autoridad. El DMS aplica las reglas de enrolamiento y expone los flujos EST para que un dispositivo solicite o renueve una identidad.",{"_3328":68126,"_29138":68114,"_20209":113856,"_5":13819,"_26493":113834,"_2816":113857},[],"Device Manager conserva la vista operativa del dispositivo y su historial. Validation Authority publica OCSP y CRLs para que otros sistemas decidan si deben confiar en un certificado presentado.",{"_3328":68127,"_29138":68114,"_20209":113859,"_5":13819,"_26493":113838,"_2816":113860},[],"En un despliegue autogestionado, Lamassu utiliza PostgreSQL para persistencia, RabbitMQ para mensajería y un proveedor OIDC para autenticación. Consulta la arquitectura de despliegue para ver cómo se publican los servicios en Kubernetes.",{"_3328":68128,"_29138":68128,"_5":14177,"_2816":113862,"_29461":113863,"_20209":113864,"_26493":68128},"Cómo funciona Lamassu",[47397,112910],[],{"_3328":68129,"_29138":68128,"_20209":113866,"_5":13819,"_26493":68128,"_2816":113867},[],"El modelo mental de confianza, claves, certificados y dispositivos.",{"_3328":68130,"_29138":68128,"_5":29458,"_20209":113869,"_26493":113870,"_2816":113871},[],"/docs/es/platform/concepts/overview#el-modelo-en-cinco-piezas","El modelo en cinco piezas",{"_3328":68131,"_29138":68128,"_5":29458,"_20209":113873,"_26493":113874,"_2816":113875},[],"/docs/es/platform/concepts/overview#del-alta-a-la-operación","Del alta a la operación",{"_3328":68132,"_29138":68128,"_20209":113877,"_5":13819,"_26493":68128,"_2816":113878},[],"Lamassu conecta tres elementos: una **raíz de confianza**, una **política de emisión** y una **entidad que necesita demostrar su identidad**. La plataforma coordina esos elementos durante todo el ciclo de vida del certificado.",{"_3328":68133,"_29138":68128,"_20209":113880,"_5":13819,"_26493":113870,"_2816":113881},[],"**Motor criptográfico.** Genera o custodia claves y ejecuta las operaciones privadas sin exponer el material criptográfico al resto de servicios.",{"_3328":68134,"_29138":68128,"_20209":113883,"_5":13819,"_26493":113870,"_2816":113884},[],"**Autoridad de certificación (CA).** Firma certificados y establece la cadena de confianza.",{"_3328":68135,"_29138":68128,"_20209":113886,"_5":13819,"_26493":113870,"_2816":113887},[],"**Device Management Service (DMS).** Define cómo se registran, autentican y renuevan los dispositivos de una flota.",{"_3328":68136,"_29138":68128,"_20209":113889,"_5":13819,"_26493":113870,"_2816":113890},[],"**Dispositivo.** Conserva su clave privada y presenta el certificado para demostrar su identidad.",{"_3328":68137,"_29138":68128,"_20209":113892,"_5":13819,"_26493":113870,"_2816":113893},[],"**Validation Authority (VA).** Publica el estado de los certificados mediante OCSP y CRL.",{"_3328":68138,"_29138":68128,"_20209":113895,"_5":13819,"_26493":113874,"_2816":113896},[],"Un administrador configura un motor criptográfico y crea o importa una CA.",{"_3328":68139,"_29138":68128,"_20209":113898,"_5":13819,"_26493":113874,"_2816":113899},[],"Un DMS relaciona esa CA con una política de enrolamiento.",{"_3328":68140,"_29138":68128,"_20209":113901,"_5":13819,"_26493":113874,"_2816":113902},[],"El dispositivo genera una clave y solicita un certificado mediante EST, o un operador le asigna una identidad.",{"_3328":68141,"_29138":68128,"_20209":113904,"_5":13819,"_26493":113874,"_2816":113905},[],"Lamassu conserva el inventario, el historial y el estado de la identidad.",{"_3328":68142,"_29138":68128,"_20209":113907,"_5":13819,"_26493":113874,"_2816":113908},[],"Los consumidores comprueban la cadena y consultan OCSP o una CRL cuando necesitan conocer su vigencia.",{"_3328":68143,"_29138":68128,"_20209":113910,"_5":13819,"_26493":113874,"_2816":113911},[],"<Card title=\"Arquitectura\" description=\"Conoce los componentes y dónde termina la responsabilidad de cada uno.\" href=\"/docs/platform/concepts/architecture\" />",{"_3328":68144,"_29138":68128,"_20209":113913,"_5":13819,"_26493":113874,"_2816":113914},[],"<Card title=\"Ciclo de vida de una identidad\" description=\"Sigue un certificado desde el enrolamiento hasta la renovación o revocación.\" href=\"/docs/platform/pki/concepts/certificate-lifecycle\" />",{"_3328":68145,"_29138":68145,"_5":14177,"_2816":113916,"_29461":113917,"_20209":113918,"_26493":68145},"Dispositivos e identidades",[47397,112910,49873,113916],[],{"_3328":68146,"_29138":68145,"_20209":113920,"_5":13819,"_26493":68145,"_2816":113921},[],"Registra, inspecciona y retira dispositivos comprobando su identidad actual y su historial.",{"_3328":68147,"_29138":68145,"_5":29458,"_20209":113923,"_26493":113924,"_2816":113925},[],"/docs/es/platform/iot-fleets/device-management#estados-del-dispositivo","Estados del dispositivo",{"_3328":68148,"_29138":68145,"_5":29458,"_20209":113927,"_26493":113928,"_2816":113929},[],"/docs/es/platform/iot-fleets/device-management#inspecciona-un-dispositivo","Inspecciona un dispositivo",{"_3328":68149,"_29138":68145,"_5":29458,"_20209":113931,"_26493":113932,"_2816":113933},[],"/docs/es/platform/iot-fleets/device-management#registra-un-dispositivo-manualmente","Registra un dispositivo manualmente",{"_3328":68150,"_29138":68145,"_5":29458,"_20209":113935,"_26493":113936,"_2816":113937},[],"/docs/es/platform/iot-fleets/device-management#crea-el-dispositivo","Crea el dispositivo",{"_3328":68151,"_29138":68145,"_5":29458,"_20209":113939,"_26493":113940,"_2816":113941},[],"/docs/es/platform/iot-fleets/device-management#define-su-pertenencia","Define su pertenencia",{"_3328":68152,"_29138":68145,"_5":29458,"_20209":113943,"_26493":113944,"_2816":113945},[],"/docs/es/platform/iot-fleets/device-management#clasifica-el-dispositivo","Clasifica el dispositivo",{"_3328":68153,"_29138":68145,"_5":29458,"_20209":113947,"_26493":113948,"_2816":113949},[],"/docs/es/platform/iot-fleets/device-management#verifica-el-alta","Verifica el alta",{"_3328":68154,"_29138":68145,"_5":29458,"_20209":113951,"_26493":113952,"_2816":113953},[],"/docs/es/platform/iot-fleets/device-management#asigna-una-identidad-manualmente","Asigna una identidad manualmente",{"_3328":68155,"_29138":68145,"_5":29458,"_20209":113955,"_26493":113956,"_2816":113957},[],"/docs/es/platform/iot-fleets/device-management#revoca-la-identidad-actual","Revoca la identidad actual",{"_3328":68156,"_29138":68145,"_5":29458,"_20209":113959,"_26493":113960,"_2816":113961},[],"/docs/es/platform/iot-fleets/device-management#retira-un-dispositivo","Retira un dispositivo",{"_3328":68157,"_29138":68145,"_5":29458,"_20209":113963,"_26493":113964,"_2816":113965},[],"/docs/es/platform/iot-fleets/device-management#automatiza-el-enrolamiento","Automatiza el enrolamiento",{"_3328":68158,"_29138":68145,"_20209":113967,"_5":13819,"_26493":68145,"_2816":113968},[],"Esta guía se dirige al operador de una flota. Necesitas permisos sobre dispositivos, DMS y certificados para las acciones que vayas a realizar. Una flota se organiza mediante esos recursos, etiquetas y metadatos; no se crea un objeto independiente de «flota».",{"_3328":68159,"_29138":68145,"_20209":113970,"_5":13819,"_26493":68145,"_2816":113971},[],"Cada dispositivo tiene un `Device ID`, un DMS propietario (`dms_owner`) y, cuando está aprovisionado, un slot de identidad con una versión activa y versiones anteriores. En los flujos descritos, mantén el `Common Name` de la CSR y del certificado igual al `Device ID`: la vinculación utiliza ese CN para actualizar el dispositivo.",{"_3328":68160,"_29138":68145,"_20209":113973,"_5":13819,"_26493":113924,"_2816":113974},[],"Vista operativa",{"_3328":68161,"_29138":68145,"_20209":113976,"_5":13819,"_26493":113924,"_2816":113977},[],"Interpretación",{"_3328":68162,"_29138":68145,"_20209":113979,"_5":13819,"_26493":113924,"_2816":49936},[],{"_3328":68163,"_29138":68145,"_20209":113981,"_5":13819,"_26493":113924,"_2816":113982},[],"Hay registro, pero todavía no hay identidad asociada.",{"_3328":68164,"_29138":68145,"_20209":113984,"_5":13819,"_26493":113924,"_2816":49942},[],{"_3328":68165,"_29138":68145,"_20209":113986,"_5":13819,"_26493":113924,"_2816":113987},[],"El slot está activo; comprueba además las fechas, estado y usos del certificado.",{"_3328":68166,"_29138":68145,"_20209":113989,"_5":13819,"_26493":113924,"_2816":49948},[],{"_3328":68167,"_29138":68145,"_20209":113991,"_5":13819,"_26493":113924,"_2816":113992},[],"La identidad está en la ventana operativa de renovación.",{"_3328":68168,"_29138":68145,"_20209":113994,"_5":13819,"_26493":113924,"_2816":49954},[],{"_3328":68169,"_29138":68145,"_20209":113996,"_5":13819,"_26493":113924,"_2816":113997},[],"Se aproxima al vencimiento según los umbrales configurados.",{"_3328":68170,"_29138":68145,"_20209":113999,"_5":13819,"_26493":113924,"_2816":49960},[],{"_3328":68171,"_29138":68145,"_20209":114001,"_5":13819,"_26493":113924,"_2816":114002},[],"La identidad ha vencido.",{"_3328":68172,"_29138":68145,"_20209":114004,"_5":13819,"_26493":113924,"_2816":49966},[],{"_3328":68173,"_29138":68145,"_20209":114006,"_5":13819,"_26493":113924,"_2816":114007},[],"La identidad está marcada como revocada.",{"_3328":68174,"_29138":68145,"_20209":114009,"_5":13819,"_26493":113924,"_2816":49972},[],{"_3328":68175,"_29138":68145,"_20209":114011,"_5":13819,"_26493":113924,"_2816":114012},[],"El registro está retirado y no vuelve al estado operativo mediante una actualización normal.",{"_3328":68176,"_29138":68145,"_20209":114014,"_5":13819,"_26493":113924,"_2816":114015},[],"Los estados de dispositivo, slot y certificado son distintos. Los eventos y trabajos pueden actualizar la vista después de guardar el certificado; una etiqueta **Active** no prueba aceptación por un consumidor.",{"_3328":68177,"_29138":68145,"_20209":114017,"_5":13819,"_26493":113928,"_2816":114018},[],"Filtra el inventario por ID, etiquetas y estado. Abre el detalle y registra DMS propietario, versión activa y serie del certificado actual.",{"_3328":68178,"_29138":68145,"_20209":114020,"_5":13819,"_26493":113928,"_2816":114021},[],"**Certificate History** relaciona versiones anteriores y actuales. Sustituir el slot no revoca por sí solo todas las versiones anteriores.",{"_3328":68179,"_29138":68145,"_20209":114023,"_5":13819,"_26493":113928,"_2816":114024},[],"**Device Event Timeline** ayuda a reconstruir altas, aprovisionamientos, renovaciones y cambios de estado. Un cambio puede haberse guardado aunque falle la persistencia de su evento; contrasta también el registro y los certificados.",{"_3328":68180,"_29138":68145,"_20209":114026,"_5":13819,"_26493":113928,"_2816":114027},[],"Compara esos datos con la identidad instalada en el dispositivo. Un slot actualizado en Lamassu no instala archivos en el equipo remoto.",{"_3328":68181,"_29138":68145,"_20209":114029,"_5":13819,"_26493":113932,"_2816":114030},[],"Utiliza este flujo para preparar inventario o asignar una identidad desde la consola. Necesitas un DMS existente.",{"_3328":68182,"_29138":68145,"_20209":114032,"_5":13819,"_26493":113936,"_2816":114033},[],"Desde **Managed Devices**, abre el registro. Confirma que el ID no exista en otro DMS: la búsqueda por ID no está limitada a una flota.",{"_3328":68183,"_29138":68145,"_20209":114035,"_5":13819,"_26493":113940,"_2816":114036},[],"Introduce el **Device ID** y selecciona el DMS que será su propietario. La etiqueta **Registration Authority** de la consola se refiere a ese DMS.",{"_3328":68184,"_29138":68145,"_20209":114038,"_5":13819,"_26493":113944,"_2816":114039},[],"Añade icono y etiquetas de modelo, entorno o ubicación según tu inventario.",{"_3328":68185,"_29138":68145,"_20209":114041,"_5":13819,"_26493":113948,"_2816":114042},[],"Vuelve a leer el dispositivo: debe tener el DMS previsto y estar en **No Identity**. Sigue Registro manual para completar la asignación.",{"_3328":68186,"_29138":68145,"_20209":114044,"_5":13819,"_26493":113948,"_2816":114045},[],"Prerregistrar no demuestra que `/simpleenroll` vaya a admitir la solicitud. Revisa la interacción con `enable_replaceable_enrollment` en Estrategias de aprovisionamiento.",{"_3328":68187,"_29138":68145,"_20209":114047,"_5":13819,"_26493":113952,"_2816":114048},[],"Desde **No Identity**, utiliza **Assign Identity**:",{"_3328":68188,"_29138":68145,"_20209":114050,"_5":13819,"_26493":113952,"_2816":114051},[],"Elige un certificado activo, vigente y adecuado para el consumidor, con `CN` exactamente igual al `Device ID`.",{"_3328":68189,"_29138":68145,"_20209":114053,"_5":13819,"_26493":113952,"_2816":114054},[],"Si no existe, **Issue New Instead** permite iniciar una emisión con la CA prevista. Revisa primero el perfil.",{"_3328":68190,"_29138":68145,"_20209":114056,"_5":13819,"_26493":113952,"_2816":114057},[],"Confirma y vuelve a consultar serie, versión activa e historial.",{"_3328":68191,"_29138":68145,"_20209":114059,"_5":13819,"_26493":113952,"_2816":114060},[],"Instala la pareja clave/certificado y las intermedias necesarias en el dispositivo, y prueba su uso.",{"_3328":68192,"_29138":68145,"_20209":114062,"_5":13819,"_26493":113952,"_2816":114063},[],"Emitir, vincular e instalar son pasos distintos. Si falla la operación, comprueba cuáles se guardaron antes de repetirla.",{"_3328":68193,"_29138":68145,"_20209":114065,"_5":13819,"_26493":113956,"_2816":114066},[],"Localiza la serie activa en el historial y revócala con una razón apropiada. Comprueba registro, publicación OCSP/CRL y rechazo de una conexión nueva en el consumidor con la guía de certificados.",{"_3328":68194,"_29138":68145,"_20209":114068,"_5":13819,"_26493":113956,"_2816":114069},[],"La revocación no elimina el dispositivo. Tampoco habilita automáticamente una nueva inscripción: la recuperación depende de su credencial, estado y política DMS. `CertificateHold` puede reactivarse bajo las condiciones de PKI; otras razones bloquean cambios posteriores del certificado.",{"_3328":68195,"_29138":68145,"_20209":114071,"_5":13819,"_26493":113960,"_2816":114072},[],"Antes de **Decommission**, inventaría identidades activas y anteriores, conexiones y permisos del destino. Prepara su retirada en el consumidor.",{"_3328":68196,"_29138":68145,"_20209":114074,"_5":13819,"_26493":113960,"_2816":114075},[],"El backend guarda **Decommissioned** e intenta revocar el certificado de la versión activa con `CessationOfOperation` si el slot no estaba expirado o revocado. No recorre todo el historial. La revocación diferida puede fallar después de guardar la baja; verifica su resultado por serie.",{"_3328":68197,"_29138":68145,"_20209":114077,"_5":13819,"_26493":113960,"_2816":114078},[],"El estado retirado protege las actualizaciones normales del dispositivo y su slot. No constituye una garantía de que toda solicitud EST sea rechazada antes de emitir: la vinculación puede omitir un dispositivo retirado sin devolver error. Confirma que no quedan certificados o permisos utilizables y bloquea nuevas admisiones en el control correspondiente.",{"_3328":68198,"_29138":68145,"_20209":114080,"_5":13819,"_26493":113960,"_2816":114081},[],"Conserva los registros según tu política de auditoría. No reutilices un ID retirado para ocultar el cambio de equipo.",{"_3328":68199,"_29138":68145,"_20209":114083,"_5":13819,"_26493":113964,"_2816":114084},[],"<Card title=\"Enrola y conecta un dispositivo\" description=\"Obtén una identidad desde el cliente y prueba mTLS.\" href=\"/docs/platform/iot-fleets/quickstarts/enroll-device\" />",{"_3328":68200,"_29138":68145,"_20209":114086,"_5":13819,"_26493":113964,"_2816":114087},[],"<Card title=\"Renovación y recuperación\" description=\"Instala el sucesor y trata fallos sin perder el estado conocido.\" href=\"/docs/platform/iot-fleets/enrollment/renewal-and-recovery\" />",{"_3328":68201,"_29138":68201,"_5":14177,"_2816":114089,"_29461":114090,"_20209":114092,"_26493":68201},"Identidad inicial y autenticación",[47397,112910,49873,113916,114091],"Enrolamiento con PKI",[],{"_3328":68202,"_29138":68201,"_20209":114094,"_5":13819,"_26493":68201,"_2816":114095},[],"Prepara confianza del servidor y pruebas de admisión para enroll y reenroll.",{"_3328":68203,"_29138":68201,"_5":29458,"_20209":114097,"_26493":114098,"_2816":114099},[],"/docs/es/platform/iot-fleets/enrollment/bootstrap-identity#confianza-inicial-del-servidor","Confianza inicial del servidor",{"_3328":68204,"_29138":68201,"_5":29458,"_20209":114101,"_26493":114102,"_2816":114103},[],"/docs/es/platform/iot-fleets/enrollment/bootstrap-identity#credencial-bootstrap","Credencial bootstrap",{"_3328":68205,"_29138":68201,"_5":29458,"_20209":114105,"_26493":114106,"_2816":114107},[],"/docs/es/platform/iot-fleets/enrollment/bootstrap-identity#modos-por-operación","Modos por operación",{"_3328":68206,"_29138":68201,"_5":29458,"_20209":114109,"_26493":114110,"_2816":114111},[],"/docs/es/platform/iot-fleets/enrollment/bootstrap-identity#contrato-del-webhook","Contrato del webhook",{"_3328":68207,"_29138":68201,"_5":29458,"_20209":114113,"_26493":114114,"_2816":114115},[],"/docs/es/platform/iot-fleets/enrollment/bootstrap-identity#revocación-y-comprobaciones","Revocación y comprobaciones",{"_3328":68208,"_29138":68201,"_20209":114117,"_5":13819,"_26493":68201,"_2816":114118},[],"Esta guía conecta al administrador DMS con quien fabrica o integra el dispositivo. Antes de solicitar su identidad operativa, el cliente debe poder autenticar al servidor EST y demostrar que tiene derecho a solicitar el ID previsto.",{"_3328":68209,"_29138":68201,"_20209":114120,"_5":13819,"_26493":114098,"_2816":114121},[],"Instala una raíz, cadena o pin previamente verificado mediante un canal confiable: fabricación, configuración aprobada o distribución autenticada. Ese material permite verificar TLS y el nombre del servidor antes de descargar `/cacerts`.",{"_3328":68210,"_29138":68201,"_20209":114123,"_5":13819,"_26493":114098,"_2816":114124},[],"No puedes obtener tu única prueba de confianza del mismo servidor todavía no autenticado. El certificado TLS del servidor EST, el certificado bootstrap y la CA emisora de la identidad operativa pueden pertenecer a jerarquías distintas.",{"_3328":68211,"_29138":68201,"_20209":114126,"_5":13819,"_26493":114102,"_2816":114127},[],"Con `CLIENT_CERTIFICATE`, el dispositivo presenta su certificado inicial y demuestra posesión de su clave en TLS. El DMS lo valida frente a sus CAs de admisión. En el flujo examinado, el validador recibe una credencial de hoja: configura y prueba el emisor directo para el caso sencillo; enviar más intermedias desde el cliente no demuestra que lleguen al servicio.",{"_3328":68212,"_29138":68201,"_20209":114129,"_5":13819,"_26493":114102,"_2816":114130},[],"Comprueba fechas, certificado y clave correspondientes y estado de revocación antes de provisionarlos. Una credencial compartida entre equipos identifica esa credencial compartida, no a un equipo concreto.",{"_3328":68213,"_29138":68201,"_20209":114132,"_5":13819,"_26493":114102,"_2816":114133},[],"En el primer enrolamiento, la validación mTLS no compara por sí sola el CN del bootstrap con el CN solicitado en la CSR. Si necesitas que un solicitante solo pueda pedir su propio `Device ID`, añade un control que vincule credencial e ID, por ejemplo el webhook combinado, y prueba una solicitud con otro CN. En reenrolamiento con certificado sí se compara su CN con el de la CSR; las comprobaciones posteriores utilizan la identidad activa registrada.",{"_3328":68214,"_29138":68201,"_20209":114135,"_5":13819,"_26493":114106,"_2816":114136},[],"Los cuatro modos se seleccionan independientemente para enrolamiento y reenrolamiento en DMS. La credencial utilizada al renovar depende de ese bloque; no presupongas que siempre será el bootstrap o que el webhook desaparezca.",{"_3328":68215,"_29138":68201,"_20209":114138,"_5":13819,"_26493":114106,"_2816":114139},[],"Un token OIDC de administración no es un modo EST nativo. Un webhook puede interpretar una cabecera de credencial que acuerdes con él; en ese caso la autorización la realiza ese servicio. En NO\\_AUTH, enviar un token no añade autenticación al DMS.",{"_3328":68216,"_29138":68201,"_20209":114141,"_5":13819,"_26493":114110,"_2816":114142},[],"El DMS envía el contexto de la operación al servicio configurado. El método procede de la configuración; acuerda su contrato antes de seleccionar POST o PUT. La espera de autorización tiene un valor inicial de 10 segundos, sustituido por un timeout positivo configurado. El DMS verifica el certificado del receptor salvo que se active `insecure_skip_verify` en la configuración del webhook — por defecto se verifica — y no sigue redirecciones, así que la URL configurada debe ser la final. La respuesta de autorización debe ser JSON de como máximo 1 MiB. Con la autenticación de Lamassu hacia el webhook configurada sobre `http://`, la API key o el bearer token viajan en texto claro, y mTLS no tiene efecto porque no hay handshake TLS, así que el certificado de cliente nunca se presenta; prefiere `https://`. Configura esas opciones en los ajustes del webhook externo de la guía DMS.",{"_3328":68217,"_29138":68201,"_20209":114144,"_5":13819,"_26493":114110,"_2816":114145},[],"Ejemplo de cuerpo:",{"_3328":68218,"_29138":68201,"_20209":114147,"_5":13819,"_26493":114110,"_2816":114148},[],"`csr` contiene **base64 del PEM**, a diferencia del cuerpo EST, que contiene base64 del DER. `http_request` recoge URL y primeras entradas de cabeceras del contexto HTTP disponible. El campo `operation` no se envía en este cuerpo; distingue enroll y reenroll mediante la ruta y la política configurada.",{"_3328":68219,"_29138":68201,"_20209":114150,"_5":13819,"_26493":114110,"_2816":114151},[],"El webhook debe verificar la credencial, su relación con `device_cn`, DMS, operación y política de admisión. Las cabeceras transportadas no son por sí mismas evidencia de confianza. La autenticación de **Lamassu hacia el webhook** es otra relación distinta que se configura en el cliente HTTP del servidor.",{"_3328":68220,"_29138":68201,"_20209":114153,"_5":13819,"_26493":114110,"_2816":114154},[],"La continuación requiere respuesta HTTP satisfactoria y JSON:",{"_3328":68221,"_29138":68201,"_20209":114156,"_5":13819,"_26493":114110,"_2816":114157},[],"Un `204` sin cuerpo no cumple el contrato. Rechazo, error de transporte, respuesta no interpretable o timeout abortan la autorización. En modo combinado, primero se valida el certificado y después se consulta el webhook. Consulta la especificación del webhook.",{"_3328":68222,"_29138":68201,"_20209":114159,"_5":13819,"_26493":114114,"_2816":114160},[],"El DMS busca primero el certificado en Lamassu; para uno externo intenta OCSP y CRL. Si no logra comprobar revocación, los validadores pueden continuar tratándolo como no revocado. El código tampoco permite asumir que todo estado externo distinto de Good se rechace. Verifica el comportamiento requerido con tu credencial y endpoint reales; no presentes esta comprobación como una política estricta garantizada para todas las fuentes.",{"_3328":68223,"_29138":68201,"_20209":114162,"_5":13819,"_26493":114114,"_2816":114163},[],"Prueba certificado permitido, certificado incorrecto, CN ajeno, webhook denegado, timeout y reenrolamiento bajo su propia política. Conserva el resultado y programa la retirada de las credenciales bootstrap cuando corresponda. Continúa con Cliente EST.",{"_3328":68224,"_29138":68224,"_5":14177,"_2816":114165,"_29461":114166,"_20209":114167,"_26493":68224},"Configura y opera el DMS",[47397,112910,49873,113916,114091],[],{"_3328":68225,"_29138":68224,"_20209":114169,"_5":13819,"_26493":68224,"_2816":114170},[],"Define registro, autenticación por operación, emisión, renovación y confianza distribuida.",{"_3328":68226,"_29138":68224,"_5":29458,"_20209":114172,"_26493":114173,"_2816":111488},[],"/docs/es/platform/iot-fleets/enrollment/dms#antes-de-empezar",{"_3328":68227,"_29138":68224,"_5":29458,"_20209":114175,"_26493":114176,"_2816":114177},[],"/docs/es/platform/iot-fleets/enrollment/dms#configura-un-dms","Configura un DMS",{"_3328":68228,"_29138":68224,"_5":29458,"_20209":114179,"_26493":114180,"_2816":114181},[],"/docs/es/platform/iot-fleets/enrollment/dms#identifica-la-flota","Identifica la flota",{"_3328":68229,"_29138":68224,"_5":29458,"_20209":114183,"_26493":114184,"_2816":114185},[],"/docs/es/platform/iot-fleets/enrollment/dms#selecciona-la-ca-de-enrolamiento","Selecciona la CA de enrolamiento",{"_3328":68230,"_29138":68224,"_5":29458,"_20209":114187,"_26493":114188,"_2816":114189},[],"/docs/es/platform/iot-fleets/enrollment/dms#configura-est","Configura EST",{"_3328":68231,"_29138":68224,"_5":29458,"_20209":114191,"_26493":114192,"_2816":114193},[],"/docs/es/platform/iot-fleets/enrollment/dms#distribuye-la-confianza","Distribuye la confianza",{"_3328":68232,"_29138":68224,"_5":29458,"_20209":114195,"_26493":114196,"_2816":114197},[],"/docs/es/platform/iot-fleets/enrollment/dms#verifica-los-endpoints","Verifica los endpoints",{"_3328":68233,"_29138":68224,"_5":29458,"_20209":114199,"_26493":114200,"_2816":114201},[],"/docs/es/platform/iot-fleets/enrollment/dms#configuración-de-enrollment","Configuración de enrollment",{"_3328":68234,"_29138":68224,"_5":29458,"_20209":114203,"_26493":114204,"_2816":50168},[],"/docs/es/platform/iot-fleets/enrollment/dms#enrollment-device-registration",{"_3328":68235,"_29138":68224,"_5":29458,"_20209":114206,"_26493":114207,"_2816":50172},[],"/docs/es/platform/iot-fleets/enrollment/dms#enrollment-settings",{"_3328":68236,"_29138":68224,"_5":29458,"_20209":114209,"_26493":114210,"_2816":114211},[],"/docs/es/platform/iot-fleets/enrollment/dms#autenticación-por-operación","Autenticación por operación",{"_3328":68237,"_29138":68224,"_5":29458,"_20209":114213,"_26493":114214,"_2816":114215},[],"/docs/es/platform/iot-fleets/enrollment/dms#ajustes-del-webhook-externo","Ajustes del webhook externo",{"_3328":68238,"_29138":68224,"_5":29458,"_20209":114217,"_26493":114218,"_2816":114219},[],"/docs/es/platform/iot-fleets/enrollment/dms#perfil-de-emisión","Perfil de emisión",{"_3328":68239,"_29138":68224,"_5":29458,"_20209":114221,"_26493":114222,"_2816":114223},[],"/docs/es/platform/iot-fleets/enrollment/dms#configuración-de-re-enrollment","Configuración de re-enrollment",{"_3328":68240,"_29138":68224,"_5":29458,"_20209":114225,"_26493":114226,"_2816":50192},[],"/docs/es/platform/iot-fleets/enrollment/dms#serverkeygen",{"_3328":68241,"_29138":68224,"_5":29458,"_20209":114228,"_26493":114229,"_2816":114230},[],"/docs/es/platform/iot-fleets/enrollment/dms#distribución-de-confianza","Distribución de confianza",{"_3328":68242,"_29138":68224,"_5":29458,"_20209":114232,"_26493":114233,"_2816":114234},[],"/docs/es/platform/iot-fleets/enrollment/dms#opera-el-inventario-de-dms","Opera el inventario de DMS",{"_3328":68243,"_29138":68224,"_5":29458,"_20209":114236,"_26493":114237,"_2816":114238},[],"/docs/es/platform/iot-fleets/enrollment/dms#integra-los-dispositivos","Integra los dispositivos",{"_3328":68244,"_29138":68224,"_20209":114240,"_5":13819,"_26493":68224,"_2816":114241},[],"Un &#x2A;*Device Management Service (DMS)** configura la admisión y el ciclo de identidad de sus dispositivos. Actúa como autoridad de registro; la CA indicada en `Enrollment CA` firma los certificados. Esta guía se dirige a quien administra esa política.",{"_3328":68245,"_29138":68224,"_20209":114243,"_5":13819,"_26493":114173,"_2816":114244},[],"Necesitas permisos para gestionar DMS, una CA activa con clave utilizable y un perfil de emisión probado. Acuerda con el integrador ID del dispositivo, credencial inicial, consumidor y ventana de renovación. Revisa la estrategia de aprovisionamiento antes de elegir registro y sustitución.",{"_3328":68246,"_29138":68224,"_20209":114246,"_5":13819,"_26493":114173,"_2816":114247},[],"Prepara confianza del servidor EST y acceso desde el dispositivo con Despliegue. La autenticación administrativa de tu operador no sustituye la autenticación EST del dispositivo.",{"_3328":68247,"_29138":68224,"_20209":114249,"_5":13819,"_26493":114180,"_2816":114250},[],"Crea el DMS con un nombre reconocible y conserva su ID. Las URLs EST utilizan ese identificador, no el nombre visible. Cada dispositivo conserva un DMS propietario.",{"_3328":68248,"_29138":68224,"_20209":114252,"_5":13819,"_26493":114184,"_2816":114253},[],"Elige **Enrollment CA** y un perfil explícito apropiado para la identidad final. Mantén CN compatible con `Device ID`. El certificado de prueba debe permitir el uso previsto y terminar dentro de la vigencia del emisor.",{"_3328":68249,"_29138":68224,"_20209":114255,"_5":13819,"_26493":114188,"_2816":114256},[],"Selecciona registro y autenticación del primer enrolamiento. Configura por separado la autenticación de reenrolamiento, sus umbrales y la retirada del certificado anterior. Deja ServerKeyGen deshabilitado si el cliente genera su clave.",{"_3328":68250,"_29138":68224,"_20209":114258,"_5":13819,"_26493":114192,"_2816":114259},[],"Selecciona los certificados que devolverá `/cacerts`. Incluye explícitamente las intermedias y raíces necesarias, sin confundir distribución con instalación automática de confianza.",{"_3328":68251,"_29138":68224,"_20209":114261,"_5":13819,"_26493":114196,"_2816":114262},[],"Guarda y vuelve a leer la configuración. Consulta `/cacerts`, realiza un enrolamiento permitido y otro rechazado, y comprueba dispositivo, serie e historial. Crear el DMS o descargar cacerts no demuestra que autenticación y emisión funcionen.",{"_3328":68252,"_29138":68224,"_20209":114264,"_5":13819,"_26493":114204,"_2816":114265},[],"`settings.enrollment_settings.registration_mode` permite `JITP` o `PRE_REGISTRATION`. En JITP se crea el dispositivo desconocido con el CN de la CSR como ID y el DMS como propietario. El `device_provisioning_profile` aporta etiquetas, metadatos e icono a ese alta.",{"_3328":68253,"_29138":68224,"_20209":114267,"_5":13819,"_26493":114204,"_2816":114268},[],"En PRE\\_REGISTRATION, el ID debe existir previamente. En el código examinado, un dispositivo existente pasa antes por el control de sustitución, incluso si no tiene identidad. Consulta las condiciones de prerregistro antes de utilizar este modo.",{"_3328":68254,"_29138":68224,"_20209":114270,"_5":13819,"_26493":114207,"_2816":114271},[],"Campo de `settings.enrollment_settings`",{"_3328":68255,"_29138":68224,"_20209":114273,"_5":13819,"_26493":114207,"_2816":114274},[],"Decisión",{"_3328":68256,"_29138":68224,"_20209":114276,"_5":13819,"_26493":114207,"_2816":50243},[],{"_3328":68257,"_29138":68224,"_20209":114278,"_5":13819,"_26493":114207,"_2816":114279},[],"`EST_RFC7030` para estas operaciones.",{"_3328":68258,"_29138":68224,"_20209":114281,"_5":13819,"_26493":114207,"_2816":50249},[],{"_3328":68259,"_29138":68224,"_20209":114283,"_5":13819,"_26493":114207,"_2816":114284},[],"ID de la CA que firmará.",{"_3328":68260,"_29138":68224,"_20209":114286,"_5":13819,"_26493":114207,"_2816":50255},[],{"_3328":68261,"_29138":68224,"_20209":114288,"_5":13819,"_26493":114207,"_2816":114289},[],"Mantén `true` para comprobar posesión de la clave de la CSR.",{"_3328":68262,"_29138":68224,"_20209":114291,"_5":13819,"_26493":114207,"_2816":50261},[],{"_3328":68263,"_29138":68224,"_20209":114293,"_5":13819,"_26493":114207,"_2816":114294},[],"Permite `/simpleenroll` para un ID existente del mismo DMS. Puede intentar revocar el anterior incluso si falla una fase posterior; no es un cambio atómico.",{"_3328":68264,"_29138":68224,"_20209":114296,"_5":13819,"_26493":114207,"_2816":50267},[],{"_3328":68265,"_29138":68224,"_20209":114298,"_5":13819,"_26493":114207,"_2816":114299},[],"Uno de los cuatro modos de autenticación.",{"_3328":68266,"_29138":68224,"_20209":114301,"_5":13819,"_26493":114207,"_2816":114302},[],"Si el ID pertenece a otro DMS, el enrolamiento inicial se rechaza. No actives sustitución como respuesta automática a un error; el diagnóstico distingue ID repetido, propiedad y cambios parciales.",{"_3328":68267,"_29138":68224,"_20209":114304,"_5":13819,"_26493":114210,"_2816":114305},[],"Los bloques son independientes:",{"_3328":68268,"_29138":68224,"_20209":114307,"_5":13819,"_26493":114210,"_2816":114308},[],"`settings.enrollment_settings.est_rfc7030_settings` para `/simpleenroll` y `/serverkeygen`.",{"_3328":68269,"_29138":68224,"_20209":114310,"_5":13819,"_26493":114210,"_2816":114311},[],"`settings.reenrollment_settings.est_rfc7030_settings` para `/simplereenroll`.",{"_3328":68270,"_29138":68224,"_20209":114313,"_5":13819,"_26493":114210,"_2816":50285},[],{"_3328":68271,"_29138":68224,"_20209":114315,"_5":13819,"_26493":114210,"_2816":114316},[],"Control aplicado en la operación configurada",{"_3328":68272,"_29138":68224,"_20209":114318,"_5":13819,"_26493":114210,"_2816":50291},[],{"_3328":68273,"_29138":68224,"_20209":114320,"_5":13819,"_26493":114210,"_2816":114321},[],"Validación del certificado presentado.",{"_3328":68274,"_29138":68224,"_20209":114323,"_5":13819,"_26493":114210,"_2816":50297},[],{"_3328":68275,"_29138":68224,"_20209":114325,"_5":13819,"_26493":114210,"_2816":114326},[],"Autorización del webhook configurado.",{"_3328":68276,"_29138":68224,"_20209":114328,"_5":13819,"_26493":114210,"_2816":50303},[],{"_3328":68277,"_29138":68224,"_20209":114330,"_5":13819,"_26493":114210,"_2816":114331},[],"Validación del certificado y, después, aprobación del webhook.",{"_3328":68278,"_29138":68224,"_20209":114333,"_5":13819,"_26493":114210,"_2816":50309},[],{"_3328":68279,"_29138":68224,"_20209":114335,"_5":13819,"_26493":114210,"_2816":114336},[],"Sin autenticación del solicitante por el DMS.",{"_3328":68280,"_29138":68224,"_20209":114338,"_5":13819,"_26493":114210,"_2816":114339},[],"Webhook y modo combinado también se ejecutan en reenrolamiento si se configuran en su bloque. No hay una degradación implícita a NO\\_AUTH en esos casos. Un modo ausente o no reconocido falla.",{"_3328":68281,"_29138":68224,"_20209":114341,"_5":13819,"_26493":114210,"_2816":114342},[],"Para mTLS inicial, `client_certificate_settings` contiene `validation_cas`, `allow_expired` y `chain_level_validation`. El flujo examinado recibe una credencial de certificado, no garantiza transportar todas las intermedias del handshake al validador. Para el caso directo, configura como CA de validación el emisor directo del bootstrap y prueba la ruta real del Gateway.",{"_3328":68282,"_29138":68224,"_20209":114344,"_5":13819,"_26493":114210,"_2816":114345},[],"En el reenrolamiento con certificado, el validador prueba primero la CA de enrolamiento y después las CAs listadas en `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`; esas son las CAs de validación de reenrolamiento. Esa lista es opcional porque la CA de enrolamiento siempre es confiable en el reenrolamiento, y cada bloque de ajustes consulta solo su propia `validation_cas`. Las CAs presentes solo en la `validation_cas` del bloque inicial no amplían la aceptación en reenrolamiento; durante una rotación de CAs, añade la CA de emisión anterior a la lista del bloque de reenrolamiento. El validador de reenrolamiento compara la hoja TLS presentada con esas CAs; los valores `chain_level_validation` y `allow_expired` del bloque de reenrolamiento se almacenan pero no se consultan, y el vencimiento lo rige `enable_expired_renewal`.",{"_3328":68283,"_29138":68224,"_20209":114347,"_5":13819,"_26493":114210,"_2816":114348},[],"Para el webhook, configura destino, autenticación de Lamassu hacia ese servicio, método y timeout. El contrato de autenticación explica la credencial del dispositivo y el cuerpo de la llamada. `NO_AUTH` no acredita propiedad del ID solicitado.",{"_3328":68284,"_29138":68224,"_20209":114350,"_5":13819,"_26493":114214,"_2816":114351},[],"Los modos de autenticación por webhook leen `external_webhook_settings` en el mismo bloque `est_rfc7030_settings`:",{"_3328":68285,"_29138":68224,"_20209":114353,"_5":13819,"_26493":114214,"_2816":114354},[],"Campo de `external_webhook_settings`",{"_3328":68286,"_29138":68224,"_20209":114356,"_5":13819,"_26493":114214,"_2816":114274},[],{"_3328":68287,"_29138":68224,"_20209":114358,"_5":13819,"_26493":114214,"_2816":50335},[],{"_3328":68288,"_29138":68224,"_20209":114360,"_5":13819,"_26493":114214,"_2816":114361},[],"URL absoluta `http` o `https` del receptor. Debe ser la URL final; no se siguen redirecciones.",{"_3328":68289,"_29138":68224,"_20209":114363,"_5":13819,"_26493":114214,"_2816":50341},[],{"_3328":68290,"_29138":68224,"_20209":114365,"_5":13819,"_26493":114214,"_2816":114366},[],"`POST` o `PUT`; `POST` por defecto.",{"_3328":68291,"_29138":68224,"_20209":114368,"_5":13819,"_26493":114214,"_2816":50347},[],{"_3328":68292,"_29138":68224,"_20209":114370,"_5":13819,"_26493":114214,"_2816":114371},[],"Etiqueta usada en los logs del servicio.",{"_3328":68293,"_29138":68224,"_20209":114373,"_5":13819,"_26493":114214,"_2816":50353},[],{"_3328":68294,"_29138":68224,"_20209":114375,"_5":13819,"_26493":114214,"_2816":114376},[],"`noauth`, `apikey`, `jwt` o `mtls`. Un valor ausente o desconocido se comporta como `noauth`.",{"_3328":68295,"_29138":68224,"_20209":114378,"_5":13819,"_26493":114214,"_2816":50359},[],{"_3328":68296,"_29138":68224,"_20209":114380,"_5":13819,"_26493":114214,"_2816":114381},[],"Nivel de log de la llamada del webhook: `debug`, `info`, `warn` o `error`; `info` por defecto.",{"_3328":68297,"_29138":68224,"_20209":114383,"_5":13819,"_26493":114214,"_2816":50365},[],{"_3328":68298,"_29138":68224,"_20209":114385,"_5":13819,"_26493":114214,"_2816":114386},[],"Obligatorios para `apikey`: `header` y `key`. Los nombres de cabecera reservados se rechazan.",{"_3328":68299,"_29138":68224,"_20209":114388,"_5":13819,"_26493":114214,"_2816":50371},[],{"_3328":68300,"_29138":68224,"_20209":114390,"_5":13819,"_26493":114214,"_2816":114391},[],"Obligatorios para `jwt`: `oidc_client_id`, `oidc_client_secret` y un `oidc_well_known` absoluto `http` o `https`.",{"_3328":68301,"_29138":68224,"_20209":114393,"_5":13819,"_26493":114214,"_2816":50377},[],{"_3328":68302,"_29138":68224,"_20209":114395,"_5":13819,"_26493":114214,"_2816":114396},[],"Obligatorios para `mtls`: `cert_content` y `key_content` como PEM codificado en Base64, como el resto de certificados de la API; también se acepta el PEM en claro.",{"_3328":68303,"_29138":68224,"_20209":114398,"_5":13819,"_26493":114214,"_2816":50383},[],{"_3328":68304,"_29138":68224,"_20209":114400,"_5":13819,"_26493":114214,"_2816":114401},[],"Con `true`, omite la verificación del certificado del receptor. Por defecto se verifica. A diferencia de los canales de alertas, este ajuste se respeta aquí.",{"_3328":68305,"_29138":68224,"_20209":114403,"_5":13819,"_26493":114214,"_2816":50389},[],{"_3328":68306,"_29138":68224,"_20209":114405,"_5":13819,"_26493":114214,"_2816":114406},[],"Duración máxima de la llamada de autorización (por ejemplo `10s`); 10 segundos por defecto.",{"_3328":68307,"_29138":68224,"_20209":114408,"_5":13819,"_26493":114214,"_2816":114409},[],"Reglas de esa configuración:",{"_3328":68308,"_29138":68224,"_20209":114411,"_5":13819,"_26493":114214,"_2816":114412},[],"Crear o actualizar un DMS cuyo `auth_mode` de enrolamiento o reenrolamiento use el webhook valida el bloque y devuelve HTTP 400 — el cuerpo empieza por `struct validation error:` y continúa con `invalid enrollment external webhook config` o `invalid reenrollment external webhook config` — cuando la URL, el método o las opciones no son válidos. Eso incluye un par `mtls_options.cert_content`/`key_content` que no se corresponde con un certificado y una clave privada coincidentes. Las referencias a archivos (`ca_cert_file`, `mtls_options.cert_file`, `mtls_options.key_file`) siempre son inválidas: el servicio no lee archivos, así que introduce el certificado y la clave como PEM codificado en Base64 en `mtls_options.cert_content` y `key_content`, o como PEM en claro.",{"_3328":68309,"_29138":68224,"_20209":114414,"_5":13819,"_26493":114214,"_2816":114415},[],"Un `apikey_options.header` propio no puede usar nombres en los que la plataforma o el servicio receptor confían — por ejemplo `X-Principal-Id`, `X-Request-Id`, `Host`, `Content-Type` o `Forwarded` — y ningún nombre puede empezar por `X-Forwarded-`, `X-Envoy-` o `X-Lms-` (sin distinguir mayúsculas). La referencia de la API DMS documenta los esquemas `WebhookCall` y `WebhookCallHttpClient` y que las cabeceras API-key reservadas se rechazan.",{"_3328":68310,"_29138":68224,"_20209":114417,"_5":13819,"_26493":114214,"_2816":114418},[],"La clave anidada `http_client` existe solo en las configuraciones de canales de alertas; en un cuerpo de DMS se ignora. La clave de DMS es `external_webhook_settings.config`.",{"_3328":68311,"_29138":68224,"_20209":114420,"_5":13819,"_26493":114214,"_2816":114421},[],"Un cuerpo con `config.auth_mode` establecido a `apikey`, `jwt` o `mtls` debe llevar su bloque de opciones correspondiente (`apikey_options`, `jwt_options` o `mtls_options`) — y nada más. Los cuerpos con esos modos de autenticación que solo contengan `apikey`, `oidc` o `mtls` fallan la validación con 400, y `validate_server_cert` siempre se ignora: usa `insecure_skip_verify`. Solo se aceptan como `noauth` los cuerpos sin bloques de opciones, y sus credenciales se descartan.",{"_3328":68312,"_29138":68224,"_20209":114423,"_5":13819,"_26493":114214,"_2816":114424},[],"La respuesta de autorización debe ser JSON de como máximo 1 MiB; un cuerpo mayor hace fallar la llamada.",{"_3328":68313,"_29138":68224,"_20209":114426,"_5":13819,"_26493":114214,"_2816":114427},[],"Si hay credenciales configuradas, se envían sea cual sea el esquema de la URL: un webhook `http://` recibe la API key o el bearer token en claro, y mTLS no tiene efecto porque no hay handshake TLS, así que el certificado de cliente nunca se presenta. Usa preferentemente `https://` en `url`, en `oidc_well_known` y en el endpoint de token que este anuncia.",{"_3328":68314,"_29138":68224,"_20209":114429,"_5":13819,"_26493":114214,"_2816":114430},[],"La autenticación inicial y los ajustes de renovación se almacenan por separado. Si un DMS solo tiene el bloque de autenticación inicial, la renovación lo reutiliza: lee ambos bloques antes de editar. La consola expone editores independientes para la autenticación de enrolamiento y de reenrolamiento, con los mismos campos Log Level, Call Timeout, HTTP Authentication y credenciales que los canales webhook, además de un interruptor **Skip TLS Verification** (desactivado por defecto, así que la verificación permanece activa; la consola avisa cuando lo activas).",{"_3328":68315,"_29138":68224,"_20209":114432,"_5":13819,"_26493":114214,"_2816":114433},[],"Las credenciales del webhook deben almacenarse como contenido PEM. Las referencias a archivos (`ca_cert_file`, `mtls_options.cert_file`, `mtls_options.key_file`) nunca son válidas en una configuración de webhook almacenada: la entrega rechaza cualquier configuración de webhook que haga referencia a archivos, sea cual sea su modo de autenticación, por lo que todos los enroll y reenroll que llaman a ese webhook fallan hasta que el certificado y la clave se introduzcan como contenido PEM, en Base64 o plano, en `mtls_options.cert_content` y `key_content`, o se eliminen los campos de archivo si el webhook no usa mTLS. Si una configuración almacenada guarda rutas de archivos en `mtls_options.cert_content` o `key_content`, toda actualización completa de ajustes (`POST /v1/dms`, `PUT /v1/dms/:id`) falla la validación — los ajustes se sustituyen al completo, así que la configuración almacenada debe reenviarse — hasta que esos valores se sustituyan por contenido PEM o el webhook deje de usarse. Mientras tanto, la entrega de ese webhook falla en cada llamada; una actualización solo de metadatos mediante `PUT` o `PATCH` en `/v1/dms/:id/metadata` sigue funcionando. Para corregirlo en la consola, abre el DMS, sustituye cualquier valor de ruta de fichero por contenido PEM — el editor rechaza las rutas de fichero con un error en el propio campo — y guarda. Al guardar se reescribe `external_webhook_settings.config` con las claves actuales, y la consola lee tanto el PEM sin codificar como el codificado en Base64 de las configuraciones migradas, y almacena el material codificado en Base64. Si tu configuración almacenada se apoyaba antes en `validate_server_cert: false`, ahora lleva `insecure_skip_verify: true`: la verificación del certificado del receptor sigue sin realizarse hasta que pongas ese flag a `false`. Consulta 3.8.0 a 4.0.0 para las notas de actualización y la lista de verificación del operador.",{"_3328":68316,"_29138":68224,"_20209":114435,"_5":13819,"_26493":114214,"_2816":114436},[],"El conjunto de confianza del reenrolamiento vive en `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`. El campo plano `reenrollment_settings.additional_validation_cas` no forma parte de la API: los cuerpos que lo contienen se aceptan, pero su valor se ignora en silencio — los campos JSON desconocidos se descartan — y las respuestas GET no lo incluyen. Lee el DMS antes de enviar ediciones por API: un cuerpo de actualización construido con ese campo plano vacía en silencio `validation_cas`.",{"_3328":68317,"_29138":68224,"_20209":114438,"_5":13819,"_26493":114218,"_2816":114439},[],"`settings.issuance_profile_id` tiene precedencia sobre `settings.issuance_profile`; si ninguno existe, se utiliza el perfil predeterminado de la CA. Las reglas se documentan una sola vez en Perfiles. Cambiar un DMS afecta a solicitudes futuras; no modifica certificados ya firmados ni instala confianza en clientes.",{"_3328":68318,"_29138":68224,"_20209":114441,"_5":13819,"_26493":114222,"_2816":114442},[],"Campo de `settings.reenrollment_settings`",{"_3328":68319,"_29138":68224,"_20209":114444,"_5":13819,"_26493":114222,"_2816":114445},[],"Función",{"_3328":68320,"_29138":68224,"_20209":114447,"_5":13819,"_26493":114222,"_2816":50433},[],{"_3328":68321,"_29138":68224,"_20209":114449,"_5":13819,"_26493":114222,"_2816":114450},[],"La ventana abre en `NotAfter` del certificado activo menos este delta.",{"_3328":68322,"_29138":68224,"_20209":114452,"_5":13819,"_26493":114222,"_2816":50439},[],{"_3328":68323,"_29138":68224,"_20209":114454,"_5":13819,"_26493":114222,"_2816":114455},[],"Umbral operativo preventivo de monitorización.",{"_3328":68324,"_29138":68224,"_20209":114457,"_5":13819,"_26493":114222,"_2816":50445},[],{"_3328":68325,"_29138":68224,"_20209":114459,"_5":13819,"_26493":114222,"_2816":114460},[],"Umbral operativo crítico de monitorización.",{"_3328":68326,"_29138":68224,"_20209":114462,"_5":13819,"_26493":114222,"_2816":50451},[],{"_3328":68327,"_29138":68224,"_20209":114464,"_5":13819,"_26493":114222,"_2816":114465},[],"Aceptación de un certificado presentado vencido en el validador mTLS de renovación. No autoriza por sí solo otro modo ni elimina restricciones del Gateway.",{"_3328":68328,"_29138":68224,"_20209":114467,"_5":13819,"_26493":114222,"_2816":50457},[],{"_3328":68329,"_29138":68224,"_20209":114469,"_5":13819,"_26493":114222,"_2816":114470},[],"CAs de validación de reenrolamiento para la credencial mTLS de renovación, probadas después de la CA de enrolamiento; opcional, porque la CA de enrolamiento siempre es confiable. Suelen poblarse durante la rotación de CAs mientras las cohortes con certificados antiguos se renuevan.",{"_3328":68330,"_29138":68224,"_20209":114472,"_5":13819,"_26493":114222,"_2816":50463},[],{"_3328":68331,"_29138":68224,"_20209":114474,"_5":13819,"_26493":114222,"_2816":114475},[],"Si el certificado anterior está ACTIVE, intenta revocarlo con Superseded antes de vincular el sucesor.",{"_3328":68332,"_29138":68224,"_20209":114477,"_5":13819,"_26493":114222,"_2816":114478},[],"Monitorizar no renueva: el cliente debe programar la solicitud y la instalación. En modos webhook o NO\\_AUTH, la política de credencial vencida no pasa por el mismo validador mTLS; el webhook debe autorizar explícitamente la recuperación que admita. Revisa Renovación y recuperación para orden de operaciones y fallos parciales.",{"_3328":68333,"_29138":68224,"_20209":114480,"_5":13819,"_26493":114226,"_2816":114481},[],"`settings.server_keygen_settings.enabled` habilita generación software en el servidor. La consola lo expone mediante un interruptor **Enable server-side key generation** y una selección de **Key type**: `ECDSA` P-256, P-384 o P-521, o `RSA` de 2048, 3072 o 4096 bits; los valores predeterminados son P-256 para `ECDSA` y 4096 bits para `RSA`. Algoritmo y tamaño proceden de su campo `key`, que se guarda como `{type,bits}` donde P-256, P-384 y P-521 equivalen a `bits` 256, 384 y 521; `key` se omite cuando está deshabilitado. El perfil de emisión debe permitirlos. La respuesta contiene una clave PKCS#8 sin cifrar dentro de TLS, además del certificado. Consulta formato y extracción en Referencia EST.",{"_3328":68334,"_29138":68224,"_20209":114483,"_5":13819,"_26493":114229,"_2816":111852},[],{"_3328":68335,"_29138":68224,"_20209":114485,"_5":13819,"_26493":114229,"_2816":114486},[],"Qué publica",{"_3328":68336,"_29138":68224,"_20209":114488,"_5":13819,"_26493":114229,"_2816":50480},[],{"_3328":68337,"_29138":68224,"_20209":114490,"_5":13819,"_26493":114229,"_2816":114491},[],"Certificado TLS downstream disponible; puede ser una hoja, no una CA de emisión.",{"_3328":68338,"_29138":68224,"_20209":114493,"_5":13819,"_26493":114229,"_2816":50486},[],{"_3328":68339,"_29138":68224,"_20209":114495,"_5":13819,"_26493":114229,"_2816":114496},[],"Certificado de la CA emisora seleccionada.",{"_3328":68340,"_29138":68224,"_20209":114498,"_5":13819,"_26493":114229,"_2816":50492},[],{"_3328":68341,"_29138":68224,"_20209":114500,"_5":13819,"_26493":114229,"_2816":114501},[],"Certificados de las CAs elegidas explícitamente.",{"_3328":68342,"_29138":68224,"_20209":114503,"_5":13819,"_26493":114229,"_2816":114504},[],"No se añaden todos los ascendientes automáticamente. La distribución de confianza distingue raíces confiables, intermedias y confianza inicial del servidor.",{"_3328":68343,"_29138":68224,"_20209":114506,"_5":13819,"_26493":114233,"_2816":114507},[],"**Edit** cambia nombre, ajustes y metadatos. Las actualizaciones se realizan mediante la API de DMS. `PUT /v1/dms/{id}` siempre actúa sobre el DMS identificado en la ruta de la URL: el cuerpo no lleva campo `id`, y cualquier `id` o `creation_ts` que contenga se ignora silenciosamente; la autorización se evalúa contra ese mismo identificador de la ruta. El cuerpo debe incluir un `name` no vacío y un objeto `settings`; si falta alguno, la respuesta es HTTP 400 y el DMS almacenado no se modifica. `name` y `settings` se sustituyen siempre por completo, así que lee el DMS antes de enviar una edición por API para no perder campos. `metadata` es opcional: si se omite o se envía `null`, se conservan los metadatos almacenados; un objeto suministrado los sustituye por completo; `{}` los borra (una consulta GET posterior devuelve un objeto vacío, no `null`). Los cuerpos al estilo antiguo que transportan el DMS completo siguen funcionando mientras incluyan `name` y `settings`; los campos desconocidos se ignoran. La actualización rechaza un `name` vacío con HTTP 400: un DMS cuyo nombre almacenado quedó vacío por una actualización anterior debe renombrarse antes de que cualquier cliente lo vuelva a leer y reenviar, incluida la escritura de vuelta del conector de AWS IoT en modo JITP. Si el objeto no incluye la clave del conector de AWS IoT (`lamassu.io/iot/{connector_id}`), el conector ignora los eventos siguientes del DMS.",{"_3328":68344,"_29138":68224,"_20209":114509,"_5":13819,"_26493":114233,"_2816":114510},[],"**Go to DMS owned devices** limita el inventario al propietario. **Show/Edit Metadata** contiene datos operativos y de integraciones; consulta su guía antes de alterarlos. &#x2A;*EST (RFC-7030)** ayuda a localizar las URLs.",{"_3328":68345,"_29138":68224,"_20209":114512,"_5":13819,"_26493":114233,"_2816":114513},[],"**Delete** elimina el registro y la configuración del DMS; no realiza por sí solo una cascada de revocación sobre todos sus dispositivos y certificados. Migra dependencias y conserva las referencias de auditoría antes de retirarlo.",{"_3328":68346,"_29138":68224,"_20209":114515,"_5":13819,"_26493":114237,"_2816":114516},[],"Continúa con Cliente EST o el tutorial de enrolamiento y mTLS. La Referencia EST recoge formatos; Diagnóstico recoge fallos.",{"_3328":68347,"_29138":68347,"_5":14177,"_2816":114518,"_29461":114519,"_20209":114520,"_26493":68347},"Integra el cliente EST",[47397,112910,49873,113916,114091],[],{"_3328":68348,"_29138":68347,"_20209":114522,"_5":13819,"_26493":68347,"_2816":114523},[],"Prepara la confianza, envía una CSR y comprueba la identidad recibida.",{"_3328":68349,"_29138":68347,"_5":29458,"_20209":114525,"_26493":114526,"_2816":111488},[],"/docs/es/platform/iot-fleets/enrollment/est-client#antes-de-empezar",{"_3328":68350,"_29138":68347,"_5":29458,"_20209":114528,"_26493":114529,"_2816":114530},[],"/docs/es/platform/iot-fleets/enrollment/est-client#descarga-e-inspecciona-cacerts","Descarga e inspecciona cacerts",{"_3328":68351,"_29138":68347,"_5":29458,"_20209":114532,"_26493":114533,"_2816":114534},[],"/docs/es/platform/iot-fleets/enrollment/est-client#prepara-la-csr","Prepara la CSR",{"_3328":68352,"_29138":68347,"_5":29458,"_20209":114536,"_26493":114537,"_2816":114538},[],"/docs/es/platform/iot-fleets/enrollment/est-client#solicita-la-identidad","Solicita la identidad",{"_3328":68353,"_29138":68347,"_5":29458,"_20209":114540,"_26493":114541,"_2816":114542},[],"/docs/es/platform/iot-fleets/enrollment/est-client#comprueba-e-instala-el-resultado","Comprueba e instala el resultado",{"_3328":68354,"_29138":68347,"_5":29458,"_20209":114544,"_26493":114545,"_2816":114546},[],"/docs/es/platform/iot-fleets/enrollment/est-client#siguientes-pasos","Siguientes pasos",{"_3328":68355,"_29138":68347,"_20209":114548,"_5":13819,"_26493":68347,"_2816":114549},[],"Esta guía es para quien implementa el cliente del dispositivo. El administrador debe haber preparado la política DMS. Para una primera ejecución completa, sigue Enrola y conecta tu primer dispositivo.",{"_3328":68356,"_29138":68347,"_20209":114551,"_5":13819,"_26493":114526,"_2816":114552},[],"Necesitas el URL HTTPS público del DMS, la confianza del servidor obtenida por un canal aprobado, el modo de autenticación de la operación y un identificador admitido. Los ejemplos usan Bash, OpenSSL 3.x y curl con `--fail-with-body`; utiliza un directorio privado de trabajo y una versión compatible de esas herramientas.",{"_3328":68357,"_29138":68347,"_20209":114554,"_5":13819,"_26493":114526,"_2816":114555},[],"Prepara `est-trust.pem` para verificar al servidor EST, `bootstrap.crt` y `bootstrap.key` para la autenticación inicial por certificado, y `device-root.pem` como raíz aprobada del emisor de dispositivos. Los dos archivos de confianza pueden contener raíces distintas. Si usas otra autenticación, adapta las credenciales según Identidad inicial.",{"_3328":68358,"_29138":68347,"_20209":114557,"_5":13819,"_26493":114526,"_2816":114558},[],"Sustituye el host y `REPLACE_DMS_ID` por los de tu instalación. El APS del URL es el identificador del DMS, no su nombre visible.",{"_3328":68359,"_29138":68347,"_20209":114560,"_5":13819,"_26493":114529,"_2816":114561},[],"El contenido predeterminado es PKCS#7 DER codificado en Base64. No es un archivo PEM directo.",{"_3328":68360,"_29138":68347,"_20209":114563,"_5":13819,"_26493":114529,"_2816":114564},[],"Comprueba las huellas, emisores y fechas frente a la política de distribución de confianza. La respuesta puede contener una selección de CAs y el certificado TLS de Lamassu. No conviertas todo el contenido en raíces confiables ni lo utilices para autenticar la misma descarga inicial. Un HTTP 200 aquí no demuestra que la autenticación ni la emisión funcionen.",{"_3328":68361,"_29138":68347,"_20209":114566,"_5":13819,"_26493":114533,"_2816":114567},[],"El ejemplo genera una clave EC P-256 nueva y usa `est-device-001`, que debe estar libre si el DMS registra automáticamente. El `Common Name` será el identificador del dispositivo. Comprueba que el perfil permite la clave y el sujeto elegidos.",{"_3328":68362,"_29138":68347,"_20209":114569,"_5":13819,"_26493":114533,"_2816":114570},[],"Una implementación con hardware o almacén propio debe producir la CSR mediante su clave residente. `simpleenroll` envía la solicitud y conserva la clave en el cliente. Honor Extensions no autoriza todos los atributos pedidos: consulta Perfiles.",{"_3328":68363,"_29138":68347,"_20209":114572,"_5":13819,"_26493":114537,"_2816":114573},[],"Con autenticación inicial `CLIENT_CERTIFICATE`, envía la CSR DER en Base64 con `Content-Type: application/pkcs10`:",{"_3328":68364,"_29138":68347,"_20209":114575,"_5":13819,"_26493":114537,"_2816":114576},[],"Detén el proceso si curl falla. Conserva el código HTTP, cabeceras y cuerpo para el diagnóstico; una respuesta de error no se decodifica como certificado. El ejemplo Bash se detiene antes de esa conversión. Un timeout deja el resultado de la operación por comprobar en Lamassu: no repitas automáticamente una emisión.",{"_3328":68365,"_29138":68347,"_20209":114578,"_5":13819,"_26493":114541,"_2816":114579},[],"Para el caso de una raíz que emite directamente:",{"_3328":68366,"_29138":68347,"_20209":114581,"_5":13819,"_26493":114541,"_2816":114582},[],"Verifica además que el CN es el esperado, el certificado es final, los usos permiten tu aplicación y las fechas satisfacen el perfil. `cmp` debe terminar con código 0. Si hay intermedias, aporta la cadena con `-untrusted` según Validación PKI.",{"_3328":68367,"_29138":68347,"_20209":114584,"_5":13819,"_26493":114541,"_2816":114585},[],"Consulta el dispositivo: DMS propietario, número de serie actual e historial deben corresponder al resultado. Guarda la pareja clave/certificado de forma protegida e instala ambos mediante el mecanismo del dispositivo. La asociación en Lamassu no instala archivos en el cliente. Comprueba una conexión real antes de considerar terminado el proceso.",{"_3328":68368,"_29138":68347,"_20209":114587,"_5":13819,"_26493":114545,"_2816":114588},[],"Implementa renovación y recuperación y la actualización de confianza. La referencia EST recoge endpoints, formatos y ServerKeyGen; el diagnóstico ayuda a distinguir errores de transporte, admisión y persistencia.",{"_3328":68369,"_29138":68369,"_5":14177,"_2816":114590,"_29461":114591,"_20209":114592,"_26493":68369},"Referencia EST",[47397,112910,49873,113916,114091],[],{"_3328":68370,"_29138":68369,"_20209":114594,"_5":13819,"_26493":68369,"_2816":114595},[],"Consulta las rutas, formatos, autenticación y respuesta multipart de Lamassu.",{"_3328":68371,"_29138":68369,"_5":29458,"_20209":114597,"_26493":114598,"_2816":114599},[],"/docs/es/platform/iot-fleets/enrollment/est-reference#referencia-de-endpoints","Referencia de endpoints",{"_3328":68372,"_29138":68369,"_5":29458,"_20209":114601,"_26493":114602,"_2816":21954},[],"/docs/es/platform/iot-fleets/enrollment/est-reference#cacerts",{"_3328":68373,"_29138":68369,"_5":29458,"_20209":114604,"_26493":114605,"_2816":25139},[],"/docs/es/platform/iot-fleets/enrollment/est-reference#simpleenroll",{"_3328":68374,"_29138":68369,"_5":29458,"_20209":114607,"_26493":114608,"_2816":25146},[],"/docs/es/platform/iot-fleets/enrollment/est-reference#simplereenroll",{"_3328":68375,"_29138":68369,"_5":29458,"_20209":114610,"_26493":114611,"_2816":24479},[],"/docs/es/platform/iot-fleets/enrollment/est-reference#serverkeygen",{"_3328":68376,"_29138":68369,"_5":29458,"_20209":114613,"_26493":114614,"_2816":114615},[],"/docs/es/platform/iot-fleets/enrollment/est-reference#formato-de-respuesta","Formato de respuesta",{"_3328":68377,"_29138":68369,"_5":29458,"_20209":114617,"_26493":114618,"_2816":114619},[],"/docs/es/platform/iot-fleets/enrollment/est-reference#solicitud-y-extracción","Solicitud y extracción",{"_3328":68378,"_29138":68369,"_5":29458,"_20209":114621,"_26493":114622,"_2816":114623},[],"/docs/es/platform/iot-fleets/enrollment/est-reference#notas-de-compatibilidad","Notas de compatibilidad",{"_3328":68379,"_29138":68369,"_20209":114625,"_5":13819,"_26493":68369,"_2816":114626},[],"Referencia del contrato del backend examinado, basada en RFC 7030. Utiliza Cliente EST para el procedimiento y DMS para configurar la política.",{"_3328":68380,"_29138":68369,"_20209":114628,"_5":13819,"_26493":114598,"_2816":114629},[],"Ruta pública de los ejemplos: `/.well-known/est/{APS}/{operation}`. `APS` es el ID del DMS. El router admite rutas sin ese segmento, pero el controlador lo requiere; no las utilices como servicio predeterminado. La configuración del Gateway determina el host y la ruta públicos.",{"_3328":68381,"_29138":68369,"_20209":114631,"_5":13819,"_26493":114598,"_2816":112670},[],{"_3328":68382,"_29138":68369,"_20209":114633,"_5":13819,"_26493":114598,"_2816":114634},[],"Método",{"_3328":68383,"_29138":68369,"_20209":114636,"_5":13819,"_26493":114598,"_2816":114637},[],"Autenticación y condición",{"_3328":68384,"_29138":68369,"_20209":114639,"_5":13819,"_26493":114598,"_2816":50635},[],{"_3328":68385,"_29138":68369,"_20209":114641,"_5":13819,"_26493":114598,"_2816":50638},[],{"_3328":68386,"_29138":68369,"_20209":114643,"_5":13819,"_26493":114598,"_2816":114644},[],"La lectura DMS no exige credencial EST; HTTPS y controles de infraestructura siguen aplicándose.",{"_3328":68387,"_29138":68369,"_20209":114646,"_5":13819,"_26493":114598,"_2816":50644},[],{"_3328":68388,"_29138":68369,"_20209":114648,"_5":13819,"_26493":114598,"_2816":50647},[],{"_3328":68389,"_29138":68369,"_20209":114650,"_5":13819,"_26493":114598,"_2816":114651},[],"Autenticación inicial y política de registro/sustitución del DMS.",{"_3328":68390,"_29138":68369,"_20209":114653,"_5":13819,"_26493":114598,"_2816":50653},[],{"_3328":68391,"_29138":68369,"_20209":114655,"_5":13819,"_26493":114598,"_2816":50647},[],{"_3328":68392,"_29138":68369,"_20209":114657,"_5":13819,"_26493":114598,"_2816":114658},[],"Autenticación de renovación, identidad existente, sujeto, revocación y ventana.",{"_3328":68393,"_29138":68369,"_20209":114660,"_5":13819,"_26493":114598,"_2816":50661},[],{"_3328":68394,"_29138":68369,"_20209":114662,"_5":13819,"_26493":114598,"_2816":50647},[],{"_3328":68395,"_29138":68369,"_20209":114664,"_5":13819,"_26493":114598,"_2816":114665},[],"Autenticación y admisión iniciales; generación en servidor habilitada.",{"_3328":68396,"_29138":68369,"_20209":114667,"_5":13819,"_26493":114598,"_2816":114668},[],"Estas rutas no implementan `/csrattrs` ni `/fullcmc`. No hay un modo EST nativo de autenticación JWT; un webhook puede interpretar una credencial de la petición según su propio contrato.",{"_3328":68397,"_29138":68369,"_20209":114670,"_5":13819,"_26493":114602,"_2816":114671},[],"La respuesta predeterminada tiene `Content-Type: application/pkcs7-mime; smime-type=certs-only` y `Content-Transfer-Encoding: base64`. El cuerpo es PKCS#7 DER en Base64 con líneas de hasta 76 caracteres. Incluye los certificados seleccionados por el DMS, no necesariamente todos los ascendientes.",{"_3328":68398,"_29138":68369,"_20209":114673,"_5":13819,"_26493":114602,"_2816":114674},[],"`Accept: application/x-pem-file` solicita el conjunto en PEM mediante una extensión de Lamassu. Su contenido debe inspeccionarse y aprobarse antes de modificar raíces confiables.",{"_3328":68399,"_29138":68369,"_20209":114676,"_5":13819,"_26493":114605,"_2816":114677},[],"Envía una CSR PKCS#10 DER codificada en Base64, con `Content-Type: application/pkcs10`. El controlador examinado compara ese media type literalmente; evita añadir parámetros como charset. El CN identifica el dispositivo y la firma de la CSR debe verificarse mediante la política DMS.",{"_3328":68400,"_29138":68369,"_20209":114679,"_5":13819,"_26493":114605,"_2816":114680},[],"La respuesta predeterminada usa el formato PKCS#7/Base64 descrito para cacerts, pero contiene el certificado emitido; no presupongas que incluye toda su cadena. `Accept: application/x-pem-file` devuelve ese certificado en PEM. El cliente conserva la clave que firmó la CSR.",{"_3328":68401,"_29138":68369,"_20209":114682,"_5":13819,"_26493":114608,"_2816":114683},[],"Usa el mismo formato de solicitud y de certificado de respuesta. La autenticación se obtiene del bloque independiente `reenrollment_settings.est_rfc7030_settings`. Con certificado cliente, su CN debe coincidir con el CN de la CSR; también se comprueba el sujeto frente al certificado actual.",{"_3328":68402,"_29138":68369,"_20209":114685,"_5":13819,"_26493":114608,"_2816":114686},[],"En el modo mTLS, la CA de enrolamiento siempre valida la credencial de reenrolamiento; los certificados de otros emisores se aceptan solo si figuran como CAs de validación en el bloque de reenrolamiento. La comprobación de vencimiento por `enable_expired_renewal` corresponde a ese validador. El certificado actual revocado y una solicitud anterior a la ventana se rechazan. Consulta Renovación para instalación y recuperación.",{"_3328":68403,"_29138":68369,"_20209":114688,"_5":13819,"_26493":114611,"_2816":114689},[],"El servidor genera una clave software, reconstruye la CSR con esa clave y ejecuta el enrolamiento inicial. El flag debe estar habilitado y el algoritmo permitido por el perfil. La clave de esta operación no pasa a ser una clave hardware por utilizar una CA alojada en HSM.",{"_3328":68404,"_29138":68369,"_20209":114691,"_5":13819,"_26493":114611,"_2816":114692},[],"El código admite RSA y ECDSA, y el valor `bits` del ajuste de clave del DMS significa algo distinto en cada caso. En ECDSA selecciona la curva: 224, 256, 384 o 521 corresponden a P-224, P-256, P-384 y P-521, y un tamaño no reconocido produce fallback a P-256, así que elige explícitamente un tamaño compatible y comprueba la clave resultante. En RSA se usa directamente como tamaño del módulo; la consola ofrece 2048, 3072 y 4096 bits. No reutilices un ID enrolado para probar esta operación sin revisar sustitución.",{"_3328":68405,"_29138":68369,"_20209":114694,"_5":13819,"_26493":114614,"_2816":114695},[],"El cuerpo es **MIME multipart/mixed**, con boundary indicado en `Content-Type`. Tiene dos partes:",{"_3328":68406,"_29138":68369,"_20209":114697,"_5":13819,"_26493":114614,"_2816":114698},[],"Parte",{"_3328":68407,"_29138":68369,"_20209":114700,"_5":13819,"_26493":114614,"_2816":114701},[],"Contenido tras decodificar su Base64",{"_3328":68408,"_29138":68369,"_20209":114703,"_5":13819,"_26493":114614,"_2816":50705},[],{"_3328":68409,"_29138":68369,"_20209":114705,"_5":13819,"_26493":114614,"_2816":114706},[],"Clave privada PKCS#8 DER sin cifrar.",{"_3328":68410,"_29138":68369,"_20209":114708,"_5":13819,"_26493":114614,"_2816":50711},[],{"_3328":68411,"_29138":68369,"_20209":114710,"_5":13819,"_26493":114614,"_2816":114711},[],"PKCS#7 DER con el certificado emitido.",{"_3328":68412,"_29138":68369,"_20209":114713,"_5":13819,"_26493":114614,"_2816":114714},[],"El controlador también añade `Content-Transfer-Encoding: base64` en la cabecera exterior, aunque el cuerpo exterior es texto MIME. &#x2A;*No decodifiques el cuerpo completo como Base64.** Lee el boundary real y decodifica cada parte según sus cabeceras.",{"_3328":68413,"_29138":68369,"_20209":114716,"_5":13819,"_26493":114618,"_2816":114717},[],"En una sesión Bash con `set -euo pipefail` y `umask 077`, utiliza `EST_BASE` y los archivos de confianza/bootstrap de Cliente EST. Elige `est-serverkeygen-001` libre y admitido. La clave `server-request.key` solo firma la CSR de entrada; la identidad recibida utilizará la clave generada por el servidor.",{"_3328":68414,"_29138":68369,"_20209":114719,"_5":13819,"_26493":114618,"_2816":114720},[],"Guarda este extractor Python 3. Valida las dos partes antes de escribir y rechaza archivos de salida existentes:",{"_3328":68415,"_29138":68369,"_20209":114722,"_5":13819,"_26493":114618,"_2816":114723},[],"Convierte y comprueba el resultado:",{"_3328":68416,"_29138":68369,"_20209":114725,"_5":13819,"_26493":114618,"_2816":114726},[],"Inspecciona CN, serie, fechas y usos; comprueba la asociación en Lamassu antes de instalar. Protege los archivos DER y PEM que contienen la clave y elimina copias temporales según el almacenamiento del dispositivo. Consulta openssl-pkcs8 y el parser MIME de Python.",{"_3328":68417,"_29138":68369,"_20209":114728,"_5":13819,"_26493":114622,"_2816":114729},[],"No interpretes cualquier 500 como un fallo transitorio. La entrada inválida suele producir 400; rechazos y errores del servicio suelen producir 500 con un cuerpo JSON `err`. Los errores de Gateway y algunos caminos del controlador pueden tener otro formato. Conserva cabeceras y cuerpo antes de decodificar y consulta el diagnóstico.",{"_3328":68418,"_29138":68369,"_20209":114731,"_5":13819,"_26493":114622,"_2816":114732},[],"Los ejemplos utilizan openssl-pkcs7 para extraer certificados y openssl-x509 para preparar renovación. Comprueba capacidades y respuestas de tu versión antes de integrar un cliente EST genérico.",{"_3328":68419,"_29138":68419,"_5":14177,"_2816":114091,"_29461":114734,"_20209":114735,"_26493":68419},[47397,112910,49873,113916,114091],[],{"_3328":68420,"_29138":68419,"_20209":114737,"_5":13819,"_26493":68419,"_2816":114738},[],"Elige la política de admisión y conecta DMS, confianza inicial y cliente EST.",{"_3328":68421,"_29138":68419,"_5":29458,"_20209":114740,"_26493":114741,"_2816":114742},[],"/docs/es/platform/iot-fleets/enrollment/overview#el-recorrido","El recorrido",{"_3328":68422,"_29138":68419,"_5":29458,"_20209":114744,"_26493":114745,"_2816":114746},[],"/docs/es/platform/iot-fleets/enrollment/overview#para-el-administrador","Para el administrador",{"_3328":68423,"_29138":68419,"_5":29458,"_20209":114748,"_26493":114749,"_2816":114750},[],"/docs/es/platform/iot-fleets/enrollment/overview#para-el-integrador","Para el integrador",{"_3328":68424,"_29138":68419,"_5":29458,"_20209":114752,"_26493":114753,"_2816":114754},[],"/docs/es/platform/iot-fleets/enrollment/overview#versión-del-contrato","Versión del contrato",{"_3328":68425,"_29138":68419,"_20209":114756,"_5":13819,"_26493":68419,"_2816":114757},[],"Enrollment with PKI reúne el recorrido desde la admisión del dispositivo hasta la instalación y renovación de su identidad. El DMS actúa como autoridad de registro: autentica la solicitud, aplica la política de registro y pide a la CA que firme. El cliente conserva o recibe la clave, instala el resultado y lo presenta al consumidor.",{"_3328":68426,"_29138":68419,"_20209":114759,"_5":13819,"_26493":114741,"_2816":114760},[],"El administrador prepara CA, perfil de emisión y DMS.",{"_3328":68427,"_29138":68419,"_20209":114762,"_5":13819,"_26493":114741,"_2816":114763},[],"El integrador instala confianza inicial en el servidor EST y una credencial de admisión.",{"_3328":68428,"_29138":68419,"_20209":114765,"_5":13819,"_26493":114741,"_2816":114766},[],"El cliente solicita una identidad para su `Device ID` mediante EST.",{"_3328":68429,"_29138":68419,"_20209":114768,"_5":13819,"_26493":114741,"_2816":114769},[],"Se comprueban certificado, vinculación al dispositivo e instalación de la pareja clave/certificado.",{"_3328":68430,"_29138":68419,"_20209":114771,"_5":13819,"_26493":114741,"_2816":114772},[],"El consumidor valida y autoriza la identidad; el cliente programa renovación y recuperación.",{"_3328":68431,"_29138":68419,"_20209":114774,"_5":13819,"_26493":114741,"_2816":114775},[],"EST utiliza `/.well-known/est/{DMS_ID}`. Las APIs administrativas y la asignación manual siguen siendo recorridos distintos. Enrola y conecta un dispositivo completa una primera prueba con mTLS.",{"_3328":68432,"_29138":68419,"_20209":114777,"_5":13819,"_26493":114745,"_2816":114778},[],"<Card title=\"Estrategias de aprovisionamiento\" description=\"Elige registro automático, prerregistro o asignación manual.\" href=\"/docs/platform/iot-fleets/enrollment/provisioning-strategies\" />",{"_3328":68433,"_29138":68419,"_20209":114780,"_5":13819,"_26493":114745,"_2816":114781},[],"<Card title=\"Configura el DMS\" description=\"Separa admisión, autenticación por operación, perfil y distribución.\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_3328":68434,"_29138":68419,"_20209":114783,"_5":13819,"_26493":114745,"_2816":114784},[],"<Card title=\"Identidad inicial y autenticación\" description=\"Decide qué prueba permite solicitar la primera identidad.\" href=\"/docs/platform/iot-fleets/enrollment/bootstrap-identity\" />",{"_3328":68435,"_29138":68419,"_20209":114786,"_5":13819,"_26493":114745,"_2816":114787},[],"<Card title=\"Distribución de confianza\" description=\"Actualiza raíces y cadenas con un solapamiento comprobado.\" href=\"/docs/platform/iot-fleets/enrollment/trust-distribution\" />",{"_3328":68436,"_29138":68419,"_20209":114789,"_5":13819,"_26493":114749,"_2816":114790},[],"<Card title=\"Cliente EST\" description=\"Prepara la solicitud, verifica la respuesta e instala la identidad.\" href=\"/docs/platform/iot-fleets/enrollment/est-client\" />",{"_3328":68437,"_29138":68419,"_20209":114792,"_5":13819,"_26493":114749,"_2816":114793},[],"<Card title=\"Renovación y recuperación\" description=\"Genera el sucesor y trata credenciales vencidas o perdidas.\" href=\"/docs/platform/iot-fleets/enrollment/renewal-and-recovery\" />",{"_3328":68438,"_29138":68419,"_20209":114795,"_5":13819,"_26493":114749,"_2816":114796},[],"<Card title=\"Referencia EST\" description=\"Consulta rutas, formatos, autenticación y ServerKeyGen.\" href=\"/docs/platform/iot-fleets/enrollment/est-reference\" />",{"_3328":68439,"_29138":68419,"_20209":114798,"_5":13819,"_26493":114749,"_2816":114799},[],"<Card title=\"Diagnóstico\" description=\"Distingue fallos de transporte, política, emisión e instalación.\" href=\"/docs/platform/iot-fleets/enrollment/troubleshooting\" />",{"_3328":68440,"_29138":68419,"_20209":114801,"_5":13819,"_26493":114753,"_2816":114802},[],"Este bloque describe el código de `main` examinado en el commit `8f42c47157f9a36bac3ed5caa3692aebebe19c4b`. El catálogo del sitio publica `main (unstable)`; no se atribuye este comportamiento a una release estable. Antes de utilizar otra versión, comprueba su contrato, especialmente la autenticación independiente de reenrolamiento. Las comprobaciones de cliente y las pruebas contra una instancia se distinguen en el plan de revisión.",{"_3328":68441,"_29138":68419,"_20209":114804,"_5":13819,"_26493":114753,"_2816":114805},[],"La configuración del Gateway, TLS, proveedores y servicios pertenece a Despliegue. El uso de la identidad en AWS u otros destinos corresponde a Integraciones.",{"_3328":68442,"_29138":68442,"_5":14177,"_2816":114807,"_29461":114808,"_20209":114809,"_26493":68442},"Estrategias de aprovisionamiento",[47397,112910,49873,113916,114091],[],{"_3328":68443,"_29138":68442,"_20209":114811,"_5":13819,"_26493":68442,"_2816":114812},[],"Elige cómo se registra el dispositivo, quién autoriza su identidad y dónde se genera la clave.",{"_3328":68444,"_29138":68442,"_5":29458,"_20209":114814,"_26493":114815,"_2816":114816},[],"/docs/es/platform/iot-fleets/enrollment/provisioning-strategies#elige-el-registro","Elige el registro",{"_3328":68445,"_29138":68442,"_5":29458,"_20209":114818,"_26493":114819,"_2816":114820},[],"/docs/es/platform/iot-fleets/enrollment/provisioning-strategies#prerregistro-y-sustitución","Prerregistro y sustitución",{"_3328":68446,"_29138":68442,"_5":29458,"_20209":114822,"_26493":114823,"_2816":114824},[],"/docs/es/platform/iot-fleets/enrollment/provisioning-strategies#elige-la-autenticación","Elige la autenticación",{"_3328":68447,"_29138":68442,"_5":29458,"_20209":114826,"_26493":114827,"_2816":114828},[],"/docs/es/platform/iot-fleets/enrollment/provisioning-strategies#elige-la-custodia","Elige la custodia",{"_3328":68448,"_29138":68442,"_5":29458,"_20209":114830,"_26493":114831,"_2816":114832},[],"/docs/es/platform/iot-fleets/enrollment/provisioning-strategies#comprueba-la-decisión","Comprueba la decisión",{"_3328":68449,"_29138":68442,"_20209":114834,"_5":13819,"_26493":68442,"_2816":114835},[],"Esta guía ayuda al administrador de aprovisionamiento a elegir un recorrido antes de configurar el DMS. Separa tres decisiones: cuándo existe el dispositivo, cómo se autoriza la solicitud y quién genera su clave. Ninguna de ellas concede por sí sola acceso en el destino.",{"_3328":68450,"_29138":68442,"_20209":114837,"_5":13819,"_26493":114815,"_2816":114838},[],"Recorrido",{"_3328":68451,"_29138":68442,"_20209":114840,"_5":13819,"_26493":114815,"_2816":114841},[],"Cuándo existe el dispositivo",{"_3328":68452,"_29138":68442,"_20209":114843,"_5":13819,"_26493":114815,"_2816":114844},[],"Qué compruebas",{"_3328":68453,"_29138":68442,"_20209":114846,"_5":13819,"_26493":114815,"_2816":114847},[],"Asignación manual",{"_3328":68454,"_29138":68442,"_20209":114849,"_5":13819,"_26493":114815,"_2816":114850},[],"El operador lo crea antes de asociar un certificado.",{"_3328":68455,"_29138":68442,"_20209":114852,"_5":13819,"_26493":114815,"_2816":114853},[],"ID, DMS propietario, CN del certificado y serie vinculada.",{"_3328":68456,"_29138":68442,"_20209":114855,"_5":13819,"_26493":114815,"_2816":114856},[],"EST con `JITP`",{"_3328":68457,"_29138":68442,"_20209":114858,"_5":13819,"_26493":114815,"_2816":114859},[],"Se crea para un CN desconocido durante `/simpleenroll`.",{"_3328":68458,"_29138":68442,"_20209":114861,"_5":13819,"_26493":114815,"_2816":114862},[],"Credencial autorizada, ID libre, perfil, alta e identidad resultantes.",{"_3328":68459,"_29138":68442,"_20209":114864,"_5":13819,"_26493":114815,"_2816":114865},[],"EST con `PRE_REGISTRATION`",{"_3328":68460,"_29138":68442,"_20209":114867,"_5":13819,"_26493":114815,"_2816":114868},[],"Debe existir antes de `/simpleenroll`.",{"_3328":68461,"_29138":68442,"_20209":114870,"_5":13819,"_26493":114815,"_2816":114871},[],"Registro aprobado, mismo DMS y condiciones de sustitución de tu versión.",{"_3328":68462,"_29138":68442,"_20209":114873,"_5":13819,"_26493":114815,"_2816":114874},[],"`JITP` de Lamassu crea inventario e identidad en Lamassu. JITP de AWS aprovisiona un destino en AWS; son decisiones diferentes.",{"_3328":68463,"_29138":68442,"_20209":114876,"_5":13819,"_26493":114815,"_2816":114877},[],"Para una primera prueba desde el cliente, utiliza Enrola y conecta un dispositivo. Para preparar inventario sin EST, sigue Registro manual.",{"_3328":68464,"_29138":68442,"_20209":114879,"_5":13819,"_26493":114819,"_2816":114880},[],"En el código examinado, encontrar cualquier dispositivo del mismo DMS activa el control `enable_replaceable_enrollment` antes de comprobar PRE\\_REGISTRATION. Con el flag desactivado, un dispositivo prerregistrado puede recibir `forbiddenNewEnrollment` incluso estando en **No Identity**. No se presenta ese recorrido como garantizado por seleccionar únicamente PRE\\_REGISTRATION.",{"_3328":68465,"_29138":68442,"_20209":114882,"_5":13819,"_26493":114819,"_2816":114883},[],"Activar el flag permite repetir `/simpleenroll` para un ID existente. El backend programa un intento diferido de revocación del certificado anterior con `Superseded`; también puede ejecutarlo si después falla la emisión o vinculación. Si no había identidad, el intento puede fallar por falta de serie. El flag no es una transacción de sustitución ni garantiza restaurar el estado anterior.",{"_3328":68466,"_29138":68442,"_20209":114885,"_5":13819,"_26493":114819,"_2816":114886},[],"Prueba el caso exacto de tu versión antes de habilitarlo en una población. Para una identidad ya operativa y una renovación autorizada, utiliza `/simplereenroll`; para recuperar una identidad, sigue Renovación y recuperación y confirma el estado persistido antes de reintentar.",{"_3328":68467,"_29138":68442,"_20209":114888,"_5":13819,"_26493":114823,"_2816":114889},[],"Decide por separado primer enrolamiento y reenrolamiento:",{"_3328":68468,"_29138":68442,"_20209":114891,"_5":13819,"_26493":114823,"_2816":114892},[],"**Certificado cliente:** útil cuando cada equipo dispone de una credencial inicial cuya clave controla.",{"_3328":68469,"_29138":68442,"_20209":114894,"_5":13819,"_26493":114823,"_2816":114895},[],"**Webhook:** útil cuando otra autoridad conoce inventario, credenciales o derecho a solicitar un ID.",{"_3328":68470,"_29138":68442,"_20209":114897,"_5":13819,"_26493":114823,"_2816":114898},[],"**Certificado y webhook:** exige ambos controles en la operación configurada.",{"_3328":68471,"_29138":68442,"_20209":114900,"_5":13819,"_26493":114823,"_2816":114901},[],"**NO\\_AUTH:** no acredita al solicitante; solo encaja cuando el control de admisión se resuelve de forma deliberada fuera de ese DMS.",{"_3328":68472,"_29138":68442,"_20209":114903,"_5":13819,"_26493":114823,"_2816":114904},[],"Autenticar un certificado inicial no demuestra por sí solo el derecho a elegir cualquier CN en la CSR. Define esa autorización en Identidad inicial y autenticación.",{"_3328":68473,"_29138":68442,"_20209":114906,"_5":13819,"_26493":114827,"_2816":111852},[],{"_3328":68474,"_29138":68442,"_20209":114908,"_5":13819,"_26493":114827,"_2816":114909},[],"Material que atraviesa EST",{"_3328":68475,"_29138":68442,"_20209":114911,"_5":13819,"_26493":114827,"_2816":114912},[],"Clave generada por el dispositivo",{"_3328":68476,"_29138":68442,"_20209":114914,"_5":13819,"_26493":114827,"_2816":114915},[],"CSR pública y certificado; la clave permanece en el cliente.",{"_3328":68477,"_29138":68442,"_20209":114917,"_5":13819,"_26493":114827,"_2816":114918},[],"Clave ya disponible en el dispositivo",{"_3328":68478,"_29138":68442,"_20209":114920,"_5":13819,"_26493":114827,"_2816":114921},[],"CSR firmada con la clave existente y certificado nuevo.",{"_3328":68479,"_29138":68442,"_20209":114923,"_5":13819,"_26493":114827,"_2816":50192},[],{"_3328":68480,"_29138":68442,"_20209":114925,"_5":13819,"_26493":114827,"_2816":114926},[],"Clave privada PKCS#8 y certificado en una respuesta multipart protegida por TLS.",{"_3328":68481,"_29138":68442,"_20209":114928,"_5":13819,"_26493":114827,"_2816":114929},[],"Elegir ServerKeyGen no utiliza automáticamente el HSM o KMS de la CA para la clave del dispositivo. Revisa su contrato y extracción y la capacidad del dispositivo para instalar el material.",{"_3328":68482,"_29138":68442,"_20209":114931,"_5":13819,"_26493":114831,"_2816":114932},[],"Antes de extender el flujo, prueba alta permitida, credencial incorrecta, ID de otro DMS, solicitud repetida y recuperación tras un fallo. Conserva ID, serie, versión activa y error. Comprueba también aceptación y rechazo en el consumidor; un certificado emitido no implica que el destino lo conozca o permita operar.",{"_3328":68483,"_29138":68483,"_5":14177,"_2816":114934,"_29461":114935,"_20209":114936,"_26493":68483},"Renovación y recuperación",[47397,112910,49873,113916,114091],[],{"_3328":68484,"_29138":68483,"_20209":114938,"_5":13819,"_26493":68483,"_2816":114939},[],"Renueva sin perder la identidad y recupera dispositivos según su estado real.",{"_3328":68485,"_29138":68483,"_5":29458,"_20209":114941,"_26493":114942,"_2816":114943},[],"/docs/es/platform/iot-fleets/enrollment/renewal-and-recovery#prepara-la-renovación","Prepara la renovación",{"_3328":68486,"_29138":68483,"_5":29458,"_20209":114945,"_26493":114946,"_2816":114947},[],"/docs/es/platform/iot-fleets/enrollment/renewal-and-recovery#solicita-el-certificado-sucesor","Solicita el certificado sucesor",{"_3328":68487,"_29138":68483,"_5":29458,"_20209":114949,"_26493":114950,"_2816":114951},[],"/docs/es/platform/iot-fleets/enrollment/renewal-and-recovery#instala-y-comprueba-la-nueva-pareja","Instala y comprueba la nueva pareja",{"_3328":68488,"_29138":68483,"_5":29458,"_20209":114953,"_26493":114954,"_2816":114955},[],"/docs/es/platform/iot-fleets/enrollment/renewal-and-recovery#recupera-según-el-estado","Recupera según el estado",{"_3328":68489,"_29138":68483,"_5":29458,"_20209":114957,"_26493":114958,"_2816":114959},[],"/docs/es/platform/iot-fleets/enrollment/renewal-and-recovery#operación-continua","Operación continua",{"_3328":68490,"_29138":68483,"_20209":114961,"_5":13819,"_26493":68483,"_2816":114962},[],"La renovación conserva el identificador del dispositivo y solicita un certificado sucesor. Es un proceso que debe completar el cliente: comprobar la respuesta, instalar la pareja correspondiente y demostrar que el consumidor la acepta. Las alertas de Lamassu avisan; no ejecutan esos pasos.",{"_3328":68491,"_29138":68483,"_20209":114964,"_5":13819,"_26493":114942,"_2816":114965},[],"Consulta el certificado actual en Lamassu y compáralo con el instalado. Necesitas su sujeto, serie y fechas, además de la clave del cliente.",{"_3328":68492,"_29138":68483,"_20209":114967,"_5":13819,"_26493":114942,"_2816":114968},[],"Comprueba el modo de autenticación de **re-enrollment**: es independiente del inicial. En `CLIENT_CERTIFICATE`, utiliza la identidad actual, no asumas que la credencial bootstrap está admitida.",{"_3328":68493,"_29138":68483,"_20209":114970,"_5":13819,"_26493":114942,"_2816":114971},[],"Calcula el inicio de la ventana: `NotAfter` del certificado actual menos `reenrollment_delta`. Los umbrales preventivo y crítico producen estados/avisos; no amplían esa ventana.",{"_3328":68494,"_29138":68483,"_20209":114973,"_5":13819,"_26493":114942,"_2816":114974},[],"Revisa **Revoke on Re-enrollment** y la recuperación si la instalación falla. Si está habilitado, Lamassu puede revocar la identidad anterior antes de que el cliente instale la nueva.",{"_3328":68495,"_29138":68483,"_20209":114976,"_5":13819,"_26493":114946,"_2816":114977},[],"El ejemplo continúa el tutorial EST, en la misma sesión Bash con `set -euo pipefail`, `umask 077` y `EST_BASE`. Usa una nueva clave compatible con el perfil. La conversión desde el certificado conserva el sujeto y copia solo SAN cuando existe; comprueba el sujeto y los nombres solicitados antes de enviarla. El backend comprueba el sujeto frente a la identidad actual: intenta igualdad de RawSubject y después compara CN, OU, O, L, ST y C. Volver a construir únicamente el CN puede perder atributos requeridos.",{"_3328":68496,"_29138":68483,"_20209":114979,"_5":13819,"_26493":114946,"_2816":114980},[],"La petición se autentica con `device.crt` y `device.key`; la CSR contiene la clave pública nueva. Comprueba también extensiones, fechas y correspondencia de serie con el slot actual en Lamassu. No vuelvas a enviar una solicitud que falló sin consultar ese estado: la emisión, la revocación anterior y la vinculación del sucesor pueden tener resultados parciales.",{"_3328":68497,"_29138":68483,"_20209":114982,"_5":13819,"_26493":114950,"_2816":114983},[],"Conserva el resultado como `device.next.crt` y `device.next.key` hasta verificarlo. Cambia la pareja mediante una operación coordinada del almacén o configuración del dispositivo; evita exponer temporalmente un certificado con la clave de otra versión.",{"_3328":68498,"_29138":68483,"_20209":114985,"_5":13819,"_26493":114950,"_2816":114986},[],"Prueba mTLS con el consumidor y verifica que utiliza la nueva serie. Confirma el historial y el certificado actual en Lamassu. Si **Revoke on Re-enrollment** estaba deshabilitado, la identidad anterior puede seguir válida: retírala conforme a la política de PKI después de probar el sucesor y comprueba la publicación y consumo de su revocación.",{"_3328":68499,"_29138":68483,"_20209":114988,"_5":13819,"_26493":114950,"_2816":114989},[],"Si la identidad anterior ya está revocada, conservar sus archivos no permite restaurar una conexión válida. La recuperación requiere una credencial admitida y una intervención autorizada según la situación.",{"_3328":68500,"_29138":68483,"_20209":114991,"_5":13819,"_26493":114954,"_2816":114992},[],"Situación",{"_3328":68501,"_29138":68483,"_20209":114994,"_5":13819,"_26493":114954,"_2816":114995},[],"Procedimiento",{"_3328":68502,"_29138":68483,"_20209":114997,"_5":13819,"_26493":114954,"_2816":114998},[],"Certificado vigente, fuera de ventana",{"_3328":68503,"_29138":68483,"_20209":115000,"_5":13819,"_26493":114954,"_2816":115001},[],"Programa la solicitud dentro de la ventana. No recurras a `simpleenroll` para saltarla.",{"_3328":68504,"_29138":68483,"_20209":115003,"_5":13819,"_26493":114954,"_2816":115004},[],"Certificado vencido, clave disponible",{"_3328":68505,"_29138":68483,"_20209":115006,"_5":13819,"_26493":114954,"_2816":115007},[],"Con autenticación por certificado, revisa `enable_expired_renewal` y que Gateway permita presentar esa credencial. Siguen aplicándose revocación, sujeto y el resto de comprobaciones.",{"_3328":68506,"_29138":68483,"_20209":115009,"_5":13819,"_26493":114954,"_2816":115010},[],"Renovación por webhook o `NO_AUTH`",{"_3328":68507,"_29138":68483,"_20209":115012,"_5":13819,"_26493":114954,"_2816":115013},[],"La comprobación mTLS de vencimiento no se ejecuta en esos modos. Define la política de vencimiento y autorización en la admisión correspondiente; el flag no constituye una prohibición universal.",{"_3328":68508,"_29138":68483,"_20209":115015,"_5":13819,"_26493":114954,"_2816":115016},[],"Clave perdida o inaccesible",{"_3328":68509,"_29138":68483,"_20209":115018,"_5":13819,"_26493":114954,"_2816":115019},[],"No puedes probar posesión de la identidad anterior. Autoriza una nueva admisión y, si procede, sustitución controlada; revoca la identidad comprometida.",{"_3328":68510,"_29138":68483,"_20209":115021,"_5":13819,"_26493":114954,"_2816":115022},[],"Identidad actual revocada",{"_3328":68511,"_29138":68483,"_20209":115024,"_5":13819,"_26493":114954,"_2816":115025},[],"`simplereenroll` rechaza el certificado actual revocado. Investiga la razón y prepara un procedimiento de readmisión autorizado; no desactives autenticación para forzarlo.",{"_3328":68512,"_29138":68483,"_20209":115027,"_5":13819,"_26493":114954,"_2816":115028},[],"Dispositivo sin identidad",{"_3328":68513,"_29138":68483,"_20209":115030,"_5":13819,"_26493":114954,"_2816":115031},[],"Usa el enrolamiento inicial. En un registro existente, comprueba la restricción de sustitución de aprovisionamiento.",{"_3328":68514,"_29138":68483,"_20209":115033,"_5":13819,"_26493":114954,"_2816":115034},[],"Dispositivo retirado",{"_3328":68515,"_29138":68483,"_20209":115036,"_5":13819,"_26493":114954,"_2816":115037},[],"Revisa la decisión operativa antes de readmitirlo. El estado Decommissioned y la revocación de todo el historial no son equivalentes.",{"_3328":68516,"_29138":68483,"_20209":115039,"_5":13819,"_26493":114954,"_2816":115040},[],"Timeout, HTTP 500 o fallo de instalación",{"_3328":68517,"_29138":68483,"_20209":115042,"_5":13819,"_26493":114954,"_2816":115043},[],"Inspecciona dispositivo, certificados emitidos e historial antes de reintentar. Puede haberse emitido un sucesor o revocado el anterior.",{"_3328":68518,"_29138":68483,"_20209":115045,"_5":13819,"_26493":114958,"_2816":115046},[],"Programa las renovaciones con margen para desconexiones, distribución de confianza y comprobación del consumidor. Escalona solicitudes de la población y limita los reintentos dentro de la ventana; los errores de autenticación, sujeto o política requieren corregir su causa. Conserva un mecanismo de recuperación admitido y probado para las claves perdidas y las parejas que no pudieron instalarse.",{"_3328":68519,"_29138":68483,"_20209":115048,"_5":13819,"_26493":114958,"_2816":115049},[],"Continúa con Distribución de confianza, Dispositivos e identidades y Diagnóstico.",{"_3328":68520,"_29138":68520,"_5":14177,"_2816":115051,"_29461":115052,"_20209":115053,"_26493":68520},"Diagnóstico de enrolamiento",[47397,112910,49873,113916,114091],[],{"_3328":68521,"_29138":68520,"_20209":115055,"_5":13819,"_26493":68520,"_2816":115056},[],"Localiza fallos de transporte, autenticación, registro, emisión e instalación.",{"_3328":68522,"_29138":68520,"_5":29458,"_20209":115058,"_26493":115059,"_2816":115060},[],"/docs/es/platform/iot-fleets/enrollment/troubleshooting#diagnóstico-y-compatibilidad","Diagnóstico y compatibilidad",{"_3328":68523,"_29138":68520,"_5":29458,"_20209":115062,"_26493":115063,"_2816":115064},[],"/docs/es/platform/iot-fleets/enrollment/troubleshooting#códigos-de-error-y-diagnóstico","Códigos de error y diagnóstico",{"_3328":68524,"_29138":68520,"_5":29458,"_20209":115066,"_26493":115067,"_2816":114623},[],"/docs/es/platform/iot-fleets/enrollment/troubleshooting#notas-de-compatibilidad",{"_3328":68525,"_29138":68520,"_5":29458,"_20209":115069,"_26493":115070,"_2816":115071},[],"/docs/es/platform/iot-fleets/enrollment/troubleshooting#el-enrolamiento-est-falla","El enrolamiento EST falla",{"_3328":68526,"_29138":68520,"_20209":115073,"_5":13819,"_26493":68520,"_2816":115074},[],"Diagnostica una operación y un dispositivo cada vez. Anota DMS/APS, endpoint, hora, código HTTP, serie presentada y CN de la CSR. Conserva la respuesta sin incluir claves privadas ni credenciales de webhook en el informe.",{"_3328":68527,"_29138":68520,"_20209":115076,"_5":13819,"_26493":115063,"_2816":115077},[],"El controlador EST devuelve normalmente 400 al rechazar entrada y 500 cuando el servicio rechaza o falla la operación. Un 500 también puede representar una denegación de política; no implica que reintentar sea seguro. Gateway puede generar sus propios códigos y cuerpos. Revisa el cuerpo real y el resultado persistido.",{"_3328":68528,"_29138":68520,"_20209":115079,"_5":13819,"_26493":115063,"_2816":115080},[],"Síntoma o mensaje",{"_3328":68529,"_29138":68520,"_20209":115082,"_5":13819,"_26493":115063,"_2816":115083},[],"Qué revisar",{"_3328":68530,"_29138":68520,"_20209":115085,"_5":13819,"_26493":115063,"_2816":115086},[],"curl rechaza TLS, nombre o emisor",{"_3328":68531,"_29138":68520,"_20209":115088,"_5":13819,"_26493":115063,"_2816":115089},[],"URL, reloj, SAN del servidor y raíz aprobada en `est-trust.pem`. Resolver la confianza en Despliegue; no omitir la verificación.",{"_3328":68532,"_29138":68520,"_20209":115091,"_5":13819,"_26493":115063,"_2816":115092},[],"404 o APS ausente",{"_3328":68533,"_29138":68520,"_20209":115094,"_5":13819,"_26493":115063,"_2816":115095},[],"Ruta pública `/.well-known/est/{DMS_ID}/{operation}` y DMS existente. El APS no es el nombre del servicio.",{"_3328":68534,"_29138":68520,"_20209":115097,"_5":13819,"_26493":115063,"_2816":115098},[],"400, error de CSR o formato",{"_3328":68535,"_29138":68520,"_20209":115100,"_5":13819,"_26493":115063,"_2816":115101},[],"`Content-Type: application/pkcs10`, Base64 de DER, firma válida y cuerpo conservado sin doble codificación.",{"_3328":68536,"_29138":68520,"_20209":115103,"_5":13819,"_26493":115063,"_2816":115104},[],"Credencial ausente o certificado no válido",{"_3328":68537,"_29138":68520,"_20209":115106,"_5":13819,"_26493":115063,"_2816":115107},[],"Modo de la operación, CA validante, fechas, revocación y entrega de la credencial por Gateway. No confundir confianza TLS del servidor con CA de bootstrap.",{"_3328":68538,"_29138":68520,"_20209":115109,"_5":13819,"_26493":115063,"_2816":115110},[],"Webhook deniega, expira o responde sin autorización",{"_3328":68539,"_29138":68520,"_20209":115112,"_5":13819,"_26493":115063,"_2816":115113},[],"Configuración, conectividad y respuesta JSON con `authorized: true`. No hay degradación automática a `NO_AUTH`.",{"_3328":68540,"_29138":68520,"_20209":115115,"_5":13819,"_26493":115063,"_2816":51118},[],{"_3328":68541,"_29138":68520,"_20209":115117,"_5":13819,"_26493":115063,"_2816":115118},[],"El webhook respondió con una redirección. Configura la URL final absoluta `http` o `https` en la configuración del webhook; nunca se siguen redirecciones.",{"_3328":68542,"_29138":68520,"_20209":115120,"_5":13819,"_26493":115063,"_2816":51124},[],{"_3328":68543,"_29138":68520,"_20209":115122,"_5":13819,"_26493":115063,"_2816":115123},[],"El receptor devolvió más de 1 MiB de JSON. Reduce la respuesta del webhook de autorización.",{"_3328":68544,"_29138":68520,"_20209":115125,"_5":13819,"_26493":115063,"_2816":51130},[],{"_3328":68545,"_29138":68520,"_20209":115127,"_5":13819,"_26493":115063,"_2816":115128},[],"La configuración del webhook apunta a archivos (`ca_cert_file`, `mtls_options.cert_file`, `mtls_options.key_file`). Para mTLS, introduce el certificado y la clave como PEM codificado en Base64 en `cert_content` y `key_content`, o como PEM en claro; elimina cualquier otro campo de archivo, incluido `ca_cert_file`, que no tiene equivalente en línea (el certificado del receptor debe encadenar con el almacén de confianza del sistema). Consulta la guía de credenciales del webhook en DMS.",{"_3328":68546,"_29138":68520,"_20209":115130,"_5":13819,"_26493":115063,"_2816":51136},[],{"_3328":68547,"_29138":68520,"_20209":115132,"_5":13819,"_26493":115063,"_2816":115133},[],"El valor no es ni PEM codificado en Base64 ni PEM en claro: es una ruta de archivo o es Base64 de datos que no son PEM. Introduce el certificado y la clave como PEM codificado en Base64, como el resto de certificados de la API, o como PEM en claro (consulta los ajustes del webhook en DMS). El mismo mensaje nombra `mtls_options.key_content` cuando el valor no válido es la clave.",{"_3328":68548,"_29138":68520,"_20209":115135,"_5":13819,"_26493":115063,"_2816":51142},[],{"_3328":68549,"_29138":68520,"_20209":115137,"_5":13819,"_26493":115063,"_2816":115138},[],"El certificado y la clave no forman un par coincidente. Introduce ambos valores del mismo par; la comprobación se ejecuta al guardar el DMS y de nuevo en cada llamada del webhook.",{"_3328":68550,"_29138":68520,"_20209":115140,"_5":13819,"_26493":115063,"_2816":115141},[],"400 `struct validation error` al crear o actualizar un DMS",{"_3328":68551,"_29138":68520,"_20209":115143,"_5":13819,"_26493":115063,"_2816":115144},[],"La configuración del webhook de la operación que lo usa no es válida. Revisa `external_webhook_settings` en DMS.",{"_3328":68552,"_29138":68520,"_20209":115146,"_5":13819,"_26493":115063,"_2816":115147},[],"HTTP 500 con cuerpo `err` en enroll o reenroll",{"_3328":68553,"_29138":68520,"_20209":115149,"_5":13819,"_26493":115063,"_2816":115150},[],"Los fallos del servicio llegan al cliente EST como 500 con un cuerpo de `err` más el mensaje; los errores de autorización del webhook se nombran ahí.",{"_3328":68554,"_29138":68520,"_20209":115152,"_5":13819,"_26493":115063,"_2816":51160},[],{"_3328":68555,"_29138":68520,"_20209":115154,"_5":13819,"_26493":115063,"_2816":115155},[],"PRE\\_REGISTRATION requiere la entrada de inventario previa.",{"_3328":68556,"_29138":68520,"_20209":115157,"_5":13819,"_26493":115063,"_2816":51166},[],{"_3328":68557,"_29138":68520,"_20209":115159,"_5":13819,"_26493":115063,"_2816":115160},[],"Un dispositivo ya existente exige sustitución habilitada, incluso en No Identity. Investiga antes de activar el flag.",{"_3328":68558,"_29138":68520,"_20209":115162,"_5":13819,"_26493":115063,"_2816":115163},[],"DMS propietario distinto",{"_3328":68559,"_29138":68520,"_20209":115165,"_5":13819,"_26493":115063,"_2816":115166},[],"CN/ID, inventario global y DMS dueño; no reutilices un ID de otro contexto.",{"_3328":68560,"_29138":68520,"_20209":115168,"_5":13819,"_26493":115063,"_2816":51178},[],{"_3328":68561,"_29138":68520,"_20209":115170,"_5":13819,"_26493":115063,"_2816":115171},[],"Sujeto de la CSR frente al certificado actual. Conserva sus atributos, además del CN.",{"_3328":68562,"_29138":68520,"_20209":115173,"_5":13819,"_26493":115063,"_2816":51184},[],{"_3328":68563,"_29138":68520,"_20209":115175,"_5":13819,"_26493":115063,"_2816":115176},[],"NotAfter de la identidad actual y reenrollment\\_delta. Los umbrales de alerta no cambian esa ventana.",{"_3328":68564,"_29138":68520,"_20209":115178,"_5":13819,"_26493":115063,"_2816":115179},[],"Certificado actual revocado",{"_3328":68565,"_29138":68520,"_20209":115181,"_5":13819,"_26493":115063,"_2816":115182},[],"Renovación rechazada; prepara recuperación autorizada según la causa.",{"_3328":68566,"_29138":68520,"_20209":115184,"_5":13819,"_26493":115063,"_2816":115185},[],"Error de CA, perfil o firma",{"_3328":68567,"_29138":68520,"_20209":115187,"_5":13819,"_26493":115063,"_2816":115188},[],"CA activa, clave disponible, perfil seleccionado y restricciones. Un cacerts correcto no prueba emisión.",{"_3328":68568,"_29138":68520,"_20209":115190,"_5":13819,"_26493":115063,"_2816":115191},[],"HTTP 200 sin conexión del dispositivo",{"_3328":68569,"_29138":68520,"_20209":115193,"_5":13819,"_26493":115063,"_2816":115194},[],"Pareja instalada, cadena, usos, confianza y permisos del consumidor. Comprueba también el slot e historial.",{"_3328":68570,"_29138":68520,"_20209":115196,"_5":13819,"_26493":115063,"_2816":115197},[],"Timeout o error después de emitir",{"_3328":68571,"_29138":68520,"_20209":115199,"_5":13819,"_26493":115063,"_2816":115200},[],"Certificados nuevos, slot actual y estado de la identidad anterior antes de repetir.",{"_3328":68572,"_29138":68520,"_20209":115202,"_5":13819,"_26493":115067,"_2816":115203},[],"Los ejemplos usan el contrato del backend examinado. No atribuyas automáticamente ese comportamiento a otra release. Verifica el modo de renovación guardado y el comportamiento del Gateway con certificados vencidos y con la CA inicial.",{"_3328":68573,"_29138":68520,"_20209":115205,"_5":13819,"_26493":115067,"_2816":115206},[],"La respuesta predeterminada es PKCS#7 DER en Base64; el PEM por `Accept: application/x-pem-file` es una extensión de Lamassu. ServerKeyGen devuelve multipart y requiere tratar cada parte por separado. Consulta la referencia EST.",{"_3328":68574,"_29138":68520,"_20209":115208,"_5":13819,"_26493":115070,"_2816":115209},[],"Comprueba HTTPS con la raíz aprobada y consulta cacerts para el APS correcto.",{"_3328":68575,"_29138":68520,"_20209":115211,"_5":13819,"_26493":115070,"_2816":115212},[],"Revisa el DMS guardado: protocolo, registro, autenticación de esa operación, CA, perfil y ventana.",{"_3328":68576,"_29138":68520,"_20209":115214,"_5":13819,"_26493":115070,"_2816":115215},[],"Verifica la CSR localmente y relaciona su CN con el inventario.",{"_3328":68577,"_29138":68520,"_20209":115217,"_5":13819,"_26493":115070,"_2816":115218},[],"Ejecuta una solicitud, guarda cabeceras/cuerpo y consulta el dispositivo y los certificados.",{"_3328":68578,"_29138":68520,"_20209":115220,"_5":13819,"_26493":115070,"_2816":115221},[],"Si recibes identidad, comprueba clave, sujeto, uso y conexión con el consumidor.",{"_3328":68579,"_29138":68520,"_20209":115223,"_5":13819,"_26493":115070,"_2816":115224},[],"Las comprobaciones externas de revocación del bootstrap tienen límites: ausencia de evidencia puede aceptarse, y OCSP Unknown no produce el mismo rechazo que Revoked. No presupongas una política de rechazo ante cualquier incertidumbre. Una CA intermedia en la cadena TLS tampoco demuestra que toda la cadena haya llegado al validador DMS.",{"_3328":68580,"_29138":68520,"_20209":115226,"_5":13819,"_26493":115070,"_2816":115227},[],"Para logs, red, pods o cabeceras de Gateway, continúa en Diagnóstico de Despliegue. Para identidades emitidas, revocadas o vinculadas parcialmente, utiliza Renovación y recuperación y Dispositivos e identidades.",{"_3328":68581,"_29138":68581,"_5":14177,"_2816":115229,"_29461":115230,"_20209":115231,"_26493":68581},"Distribución y actualización de confianza",[47397,112910,49873,113916,114091],[],{"_3328":68582,"_29138":68581,"_20209":115233,"_5":13819,"_26493":68581,"_2816":115234},[],"Separa raíces, intermedias y confianza TLS inicial al distribuir o migrar certificados.",{"_3328":68583,"_29138":68581,"_5":29458,"_20209":115236,"_26493":115237,"_2816":115238},[],"/docs/es/platform/iot-fleets/enrollment/trust-distribution#tres-relaciones-de-confianza","Tres relaciones de confianza",{"_3328":68584,"_29138":68581,"_5":29458,"_20209":115240,"_26493":115241,"_2816":115242},[],"/docs/es/platform/iot-fleets/enrollment/trust-distribution#qué-devuelve-cacerts","Qué devuelve cacerts",{"_3328":68585,"_29138":68581,"_5":29458,"_20209":115244,"_26493":115245,"_2816":115246},[],"/docs/es/platform/iot-fleets/enrollment/trust-distribution#instala-lo-necesario","Instala lo necesario",{"_3328":68586,"_29138":68581,"_5":29458,"_20209":115248,"_26493":115249,"_2816":115250},[],"/docs/es/platform/iot-fleets/enrollment/trust-distribution#migra-la-confianza","Migra la confianza",{"_3328":68587,"_29138":68581,"_5":29458,"_20209":115252,"_26493":115253,"_2816":115254},[],"/docs/es/platform/iot-fleets/enrollment/trust-distribution#comprueba-la-actualización","Comprueba la actualización",{"_3328":68588,"_29138":68581,"_20209":115256,"_5":13819,"_26493":68581,"_2816":115257},[],"Esta guía se dirige a quien administra la confianza de dispositivos y consumidores. Necesitas inventario de emisores, acceso a los almacenes de confianza y un canal autenticado de actualización. Distribuir certificados es distinto de decidir cuáles serán anclas confiables.",{"_3328":68589,"_29138":68581,"_20209":115259,"_5":13819,"_26493":115237,"_2816":115260},[],"Relación",{"_3328":68590,"_29138":68581,"_20209":115262,"_5":13819,"_26493":115237,"_2816":115263},[],"Material que prepara el responsable",{"_3328":68591,"_29138":68581,"_20209":115265,"_5":13819,"_26493":115237,"_2816":115266},[],"Dispositivo → servidor EST",{"_3328":68592,"_29138":68581,"_20209":115268,"_5":13819,"_26493":115237,"_2816":115269},[],"Raíz, cadena o pin previamente verificado del servidor y su nombre TLS.",{"_3328":68593,"_29138":68581,"_20209":115271,"_5":13819,"_26493":115237,"_2816":115272},[],"DMS → solicitante",{"_3328":68594,"_29138":68581,"_20209":115274,"_5":13819,"_26493":115237,"_2816":115275},[],"CAs y reglas que autorizan la credencial inicial o de renovación.",{"_3328":68595,"_29138":68581,"_20209":115277,"_5":13819,"_26493":115237,"_2816":115278},[],"Consumidor → dispositivo",{"_3328":68596,"_29138":68581,"_20209":115280,"_5":13819,"_26493":115237,"_2816":115281},[],"Raíces de la identidad operativa, intermedias, validación y permisos.",{"_3328":68597,"_29138":68581,"_20209":115283,"_5":13819,"_26493":115237,"_2816":115284},[],"Un dispositivo que obtiene un certificado no configura automáticamente ninguna de esas relaciones en terceros. Revisa el modelo de confianza.",{"_3328":68598,"_29138":68581,"_20209":115286,"_5":13819,"_26493":115241,"_2816":115287},[],"El DMS puede incluir el certificado TLS downstream disponible, las Managed CAs elegidas y la CA de enrolamiento. No incorpora todos los ascendientes por seleccionar la emisora. El conjunto puede contener hojas, raíces e intermedias, incluso más de una jerarquía durante una migración.",{"_3328":68599,"_29138":68581,"_20209":115289,"_5":13819,"_26493":115241,"_2816":115290},[],"La posición no define la cadena. Identifica cada certificado por sujeto, emisor, AKI/SKI, firma y restricciones. Descarga e inspecciona con Cliente EST.",{"_3328":68600,"_29138":68581,"_20209":115292,"_5":13819,"_26493":115245,"_2816":115293},[],"Mantén por separado la confianza inicial del servidor EST y la del consumidor de identidades.",{"_3328":68601,"_29138":68581,"_20209":115295,"_5":13819,"_26493":115245,"_2816":115296},[],"Selecciona raíces que tu política haya aprobado como anclas.",{"_3328":68602,"_29138":68581,"_20209":115298,"_5":13819,"_26493":115245,"_2816":115299},[],"Conserva intermedias para construir o presentar cadenas; no las conviertas automáticamente en raíces.",{"_3328":68603,"_29138":68581,"_20209":115301,"_5":13819,"_26493":115245,"_2816":115302},[],"Presenta hoja e intermedias requeridas en mTLS. Normalmente no necesitas enviar la raíz al interlocutor que ya confía en ella.",{"_3328":68604,"_29138":68581,"_20209":115304,"_5":13819,"_26493":115245,"_2816":115305},[],"Verifica cadena, fechas, nombres, usos y revocación desde el consumidor.",{"_3328":68605,"_29138":68581,"_20209":115307,"_5":13819,"_26493":115245,"_2816":115308},[],"No uses indiscriminadamente todo `cacerts.pem` como `-CAfile`: eso puede ampliar el conjunto de autoridades confiadas, ocultar intermedias faltantes o confiar una hoja TLS que tenía otra finalidad.",{"_3328":68606,"_29138":68581,"_20209":115310,"_5":13819,"_26493":115249,"_2816":115311},[],"Antes de cambiar Enrollment CA, inventaría equipos desconectados, bootstrap, certificados operativos y consumidores. Distribuye la nueva raíz y las intermedias necesarias; comprueba que una cohorte acepta cadenas antigua y nueva.",{"_3328":68607,"_29138":68581,"_20209":115313,"_5":13819,"_26493":115249,"_2816":115314},[],"En el DMS, separa las CAs distribuidas de las CAs de validación de reenrolamiento en `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`, utilizadas para la credencial de reenrolamiento. Esa lista es opcional porque la CA de enrolamiento siempre valida las credenciales de reenrolamiento, pero al cambiar la CA de enrolamiento, añade a ella la CA de emisión anterior para que las identidades de la CA antigua sigan reenrolándose durante el solapamiento. El validador examinado prueba la CA de enrolamiento y después esas CAs con la hoja recibida; aceptar una cadena multinivel requiere verificar cómo llega al servicio y qué emisor está configurado.",{"_3328":68608,"_29138":68581,"_20209":115316,"_5":13819,"_26493":115249,"_2816":115317},[],"Cambia emisión, renueva por grupos y compara la serie instalada con el slot activo. Retira la confianza anterior cuando ningún equipo legítimo la necesite y tu política permita cerrar el solapamiento. Sigue Jerarquía y rotación para la operación PKI.",{"_3328":68609,"_29138":68581,"_20209":115319,"_5":13819,"_26493":115253,"_2816":115320},[],"Prueba una identidad antigua permitida durante el solapamiento, una nueva, una cadena desconocida y el resultado después de retirar la confianza antigua. Conserva versión del almacén, conjunto aprobado, fecha y resultado. `/cacerts` accesible solo demuestra distribución; no demuestra instalación ni aceptación por todos los dispositivos.",{"_3328":68610,"_29138":68610,"_5":14177,"_2816":51333,"_29461":115322,"_20209":115324,"_26493":68610},[47397,112910,49873,113916,115323],"Integraciones",[],{"_3328":68611,"_29138":68610,"_20209":115326,"_5":13819,"_26493":68610,"_2816":115327},[],"El conector de Lamassu para AWS IoT Core sincroniza las identidades de los dispositivos con la plataforma AWS, gestionando el registro de CAs, el aprovisionamiento de Things y el ciclo de vida de los certificados de forma automática y orientada a eventos.",{"_3328":68612,"_29138":68610,"_5":29458,"_20209":115329,"_26493":115330,"_2816":115331},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#arquitectura-del-conector","Arquitectura del conector",{"_3328":68613,"_29138":68610,"_5":29458,"_20209":115333,"_26493":115334,"_2816":115335},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#prerrequisitos","Prerrequisitos",{"_3328":68614,"_29138":68610,"_5":29458,"_20209":115337,"_26493":115338,"_2816":115339},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#permisos-iam-necesarios","Permisos IAM necesarios",{"_3328":68615,"_29138":68610,"_5":29458,"_20209":115341,"_26493":115342,"_2816":115343},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#parámetros-de-configuración","Parámetros de configuración",{"_3328":68616,"_29138":68610,"_5":29458,"_20209":115345,"_26493":115346,"_2816":115347},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#máquina-de-estados-de-los-recursos","Máquina de estados de los recursos",{"_3328":68617,"_29138":68610,"_5":29458,"_20209":115349,"_26493":115350,"_2816":115351},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#eventos-que-gestiona-el-conector","Eventos que gestiona el conector",{"_3328":68618,"_29138":68610,"_5":29458,"_20209":115353,"_26493":115354,"_2816":115355},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#estados-del-registro-de-la-ca","Estados del registro de la CA",{"_3328":68619,"_29138":68610,"_5":29458,"_20209":115357,"_26493":115358,"_2816":115359},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#estados-del-modo-de-registro-del-dms","Estados del modo de registro del DMS",{"_3328":68620,"_29138":68610,"_5":29458,"_20209":115361,"_26493":115362,"_2816":115363},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#estados-del-certificado","Estados del certificado",{"_3328":68621,"_29138":68610,"_5":29458,"_20209":115365,"_26493":115366,"_2816":115367},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#ciclo-de-vida-del-thing","Ciclo de vida del Thing",{"_3328":68622,"_29138":68610,"_5":29458,"_20209":115369,"_26493":115370,"_2816":115371},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#registro-de-la-ca-en-aws-iot-core","Registro de la CA en AWS IoT Core",{"_3328":68623,"_29138":68610,"_5":29458,"_20209":115373,"_26493":115374,"_2816":115375},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#cómo-solicitar-el-registro","Cómo solicitar el registro",{"_3328":68624,"_29138":68610,"_5":29458,"_20209":115377,"_26493":115378,"_2816":51391},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#primary-account",{"_3328":68625,"_29138":68610,"_5":29458,"_20209":115380,"_26493":115381,"_2816":51395},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#secondary-account-sni-only",{"_3328":68626,"_29138":68610,"_5":29458,"_20209":115383,"_26493":115384,"_2816":115385},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#configuración-del-dms","Configuración del DMS",{"_3328":68627,"_29138":68610,"_5":29458,"_20209":115387,"_26493":115388,"_2816":115389},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#modo-none","Modo `none`",{"_3328":68628,"_29138":68610,"_5":29458,"_20209":115391,"_26493":115392,"_2816":115393},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#modo-auto","Modo `auto`",{"_3328":68629,"_29138":68610,"_5":29458,"_20209":115395,"_26493":115396,"_2816":115397},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#modo-jitp","Modo `jitp`",{"_3328":68630,"_29138":68610,"_5":29458,"_20209":115399,"_26493":115400,"_2816":115401},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#aprovisionamiento-de-dispositivos-modo-automático","Aprovisionamiento de dispositivos (modo automático)",{"_3328":68631,"_29138":68610,"_5":29458,"_20209":115403,"_26493":115404,"_2816":115405},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#aprovisionamiento-de-dispositivos-modo-jitp","Aprovisionamiento de dispositivos (modo JITP)",{"_3328":68632,"_29138":68610,"_5":29458,"_20209":115407,"_26493":115408,"_2816":115409},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#sincronización-del-estado-del-certificado","Sincronización del estado del certificado",{"_3328":68633,"_29138":68610,"_5":29458,"_20209":115411,"_26493":115412,"_2816":115413},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#desconexión-forzada-al-revocar","Desconexión forzada al revocar",{"_3328":68634,"_29138":68610,"_5":29458,"_20209":115415,"_26493":115416,"_2816":115417},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#device-shadow-y-automatización","Device Shadow y automatización",{"_3328":68635,"_29138":68610,"_5":29458,"_20209":115419,"_26493":115420,"_2816":115421},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#qué-escribe-el-conector-en-el-shadow","Qué escribe el conector en el shadow",{"_3328":68636,"_29138":68610,"_5":29458,"_20209":115423,"_26493":115424,"_2816":115425},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#políticas-de-aws-iot","Políticas de AWS IoT",{"_3328":68637,"_29138":68610,"_5":29458,"_20209":115427,"_26493":115428,"_2816":115429},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#solución-de-problemas","Solución de problemas",{"_3328":68638,"_29138":68610,"_20209":115431,"_5":13819,"_26493":68610,"_2816":115432},[],"La integración de Lamassu con AWS IoT Core cubre el puente entre la PKI gestionada por Lamassu y la plataforma de conectividad de AWS. Cuando un dispositivo obtiene su certificado a través del proceso de enrolamiento EST, el conector se encarga de que ese certificado y la identidad asociada sean reconocidos en AWS IoT Core sin intervención manual. El resultado es que el dispositivo puede autenticarse directamente en AWS con el mismo certificado X.509 que Lamassu emitió.",{"_3328":68639,"_29138":68610,"_20209":115434,"_5":13819,"_26493":68610,"_2816":115435},[],"Desde el punto de vista del protocolo, el dispositivo se autentica ante AWS IoT Core mediante TLS mutuo (mTLS): presenta su certificado X.509 emitido por Lamassu como certificado de cliente, y AWS IoT Core verifica la cadena de certificados hasta llegar a la CA registrada en la cuenta. Lamassu actúa como autoridad de certificación (CA); el conector se encarga de que esa CA esté registrada en AWS y de que el certificado del dispositivo sea conocido por la plataforma antes de que el dispositivo intente conectarse (en modo `auto`) o en su primera conexión (en modo JITP).",{"_3328":68640,"_29138":68610,"_20209":115437,"_5":13819,"_26493":68610,"_2816":115438},[],"Este documento está dirigido tanto al administrador PKI, que necesita configurar el conector y registrar las CAs, como al desarrollador de firmware de dispositivos, que necesita entender cómo se nombran los Things, cómo funciona el Device Shadow y qué ocurre cuando un certificado se revoca. Para el desarrollador de firmware, el dato más importante es que el **nombre del Thing en AWS (ThingName) corresponde siempre al Common Name (CN) del certificado emitido por Lamassu**, independientemente del modo de aprovisionamiento.",{"_3328":68641,"_29138":68610,"_20209":115440,"_5":13819,"_26493":115330,"_2816":115441},[],"El conector de AWS IoT Core es un proceso Go independiente, un binario o contenedor separado del núcleo de Lamassu. En un despliegue monolítico se compila por defecto (etiqueta de compilación `!noaws`) y se activa mediante `aws_iot_manager.enabled: true` en el fichero de configuración. En despliegues distribuidos, se ejecuta como un contenedor propio con acceso a los servicios de CA, DMS Manager y Device Manager de Lamassu a través de HTTP.",{"_3328":68642,"_29138":68610,"_20209":115443,"_5":13819,"_26493":115330,"_2816":115444},[],"El conector no sondea los servicios de Lamassu periódicamente. En su lugar, **se suscribe al bus de eventos interno** de Lamassu (AMQP o AWS SQS/SNS, configurable) y reacciona a los eventos que le interesan: creación o actualización de CAs, creación o actualización de DMS, vinculación de identidad de dispositivo, cambio de estado de certificado, actualización de metadatos de certificado y actualización de metadatos de dispositivo. Este modelo orientado a eventos garantiza que la sincronización con AWS sea casi inmediata y no genere carga de sondeo.",{"_3328":68643,"_29138":68610,"_20209":115446,"_5":13819,"_26493":115330,"_2816":115447},[],"Para evitar bucles infinitos, el conector ignora cualquier evento cuyo campo `source` de CloudEvent coincida con su propia URI de origen. Esto previene que las escrituras de metadatos que el propio conector realiza vuelvan a disparar el mismo flujo.",{"_3328":68644,"_29138":68610,"_20209":115449,"_5":13819,"_26493":115330,"_2816":115450},[],"Cuando se ejecutan varios conectores en paralelo, por ejemplo, para distintas cuentas de AWS, cada instancia tiene su propio `connector_id`. Todos los metadatos que el conector escribe en Lamassu se almacenan bajo la clave `lamassu.io/iot/{connector_id}`, lo que permite coexistencia sin colisiones.",{"_3328":68645,"_29138":68610,"_20209":115452,"_5":13819,"_26493":115334,"_2816":115453},[],"Antes de activar el conector es necesario disponer de una cuenta AWS con los permisos IAM adecuados y tener el conector correctamente configurado. El proceso de despliegue (Docker Compose, Kubernetes o binario) se describe en la documentación de despliegue.",{"_3328":68646,"_29138":68610,"_20209":115455,"_5":13819,"_26493":115338,"_2816":115456},[],"La identidad IAM con la que opera el conector debe tener al mínimo los siguientes permisos sobre los recursos de la cuenta destino:",{"_3328":68647,"_29138":68610,"_20209":115458,"_5":13819,"_26493":115338,"_2816":115459},[],"Acción IAM",{"_3328":68648,"_29138":68610,"_20209":115461,"_5":13819,"_26493":115338,"_2816":111858},[],{"_3328":68649,"_29138":68610,"_20209":115463,"_5":13819,"_26493":115338,"_2816":51478},[],{"_3328":68650,"_29138":68610,"_20209":115465,"_5":13819,"_26493":115338,"_2816":115466},[],"Obtener el código de verificación para el registro de CA en Primary Account",{"_3328":68651,"_29138":68610,"_20209":115468,"_5":13819,"_26493":115338,"_2816":51484},[],{"_3328":68652,"_29138":68610,"_20209":115470,"_5":13819,"_26493":115338,"_2816":115471},[],"Registrar la CA en AWS IoT",{"_3328":68653,"_29138":68610,"_20209":115473,"_5":13819,"_26493":115338,"_2816":51490},[],{"_3328":68654,"_29138":68610,"_20209":115475,"_5":13819,"_26493":115338,"_2816":115476},[],"Consultar el estado del registro de la CA",{"_3328":68655,"_29138":68610,"_20209":115478,"_5":13819,"_26493":115338,"_2816":51496},[],{"_3328":68656,"_29138":68610,"_20209":115480,"_5":13819,"_26493":115338,"_2816":115481},[],"Crear o actualizar Things en IoT Core",{"_3328":68657,"_29138":68610,"_20209":115483,"_5":13819,"_26493":115338,"_2816":51502},[],{"_3328":68658,"_29138":68610,"_20209":115485,"_5":13819,"_26493":115338,"_2816":115486},[],"Aprovisionar Things mediante plantilla",{"_3328":68659,"_29138":68610,"_20209":115488,"_5":13819,"_26493":115338,"_2816":51508},[],{"_3328":68660,"_29138":68610,"_20209":115490,"_5":13819,"_26493":115338,"_2816":115491},[],"Registrar certificados de dispositivo",{"_3328":68661,"_29138":68610,"_20209":115493,"_5":13819,"_26493":115338,"_2816":51514},[],{"_3328":68662,"_29138":68610,"_20209":115495,"_5":13819,"_26493":115338,"_2816":115496},[],"Cambiar el estado de un certificado (ACTIVE / INACTIVE / REVOKED)",{"_3328":68663,"_29138":68610,"_20209":115498,"_5":13819,"_26493":115338,"_2816":51520},[],{"_3328":68664,"_29138":68610,"_20209":115500,"_5":13819,"_26493":115338,"_2816":115501},[],"Crear y adjuntar políticas IoT",{"_3328":68665,"_29138":68610,"_20209":115503,"_5":13819,"_26493":115338,"_2816":51526},[],{"_3328":68666,"_29138":68610,"_20209":115505,"_5":13819,"_26493":115338,"_2816":115506},[],"Gestionar grupos de Things",{"_3328":68667,"_29138":68610,"_20209":115508,"_5":13819,"_26493":115338,"_2816":51532},[],{"_3328":68668,"_29138":68610,"_20209":115510,"_5":13819,"_26493":115338,"_2816":115511},[],"Crear plantillas JITP",{"_3328":68669,"_29138":68610,"_20209":115513,"_5":13819,"_26493":115338,"_2816":51538},[],{"_3328":68670,"_29138":68610,"_20209":115515,"_5":13819,"_26493":115338,"_2816":115516},[],"Leer y escribir el Device Shadow",{"_3328":68671,"_29138":68610,"_20209":115518,"_5":13819,"_26493":115338,"_2816":115519},[],"Para el mecanismo de desconexión forzada tras revocación también se requiere acceso a la API del plano de datos de AWS IoT (`iot:Connect` con SigV4 sobre WebSocket), que se negocia de forma implícita con las credenciales del conector.",{"_3328":68672,"_29138":68610,"_20209":115521,"_5":13819,"_26493":115342,"_2816":115522},[],"Parámetro",{"_3328":68673,"_29138":68610,"_20209":115524,"_5":13819,"_26493":115342,"_2816":115525},[],"Tipo",{"_3328":68674,"_29138":68610,"_20209":115527,"_5":13819,"_26493":115342,"_2816":115528},[],"Requerido",{"_3328":68675,"_29138":68610,"_20209":115530,"_5":13819,"_26493":115342,"_2816":115531},[],"Descripción",{"_3328":68676,"_29138":68610,"_20209":115533,"_5":13819,"_26493":115342,"_2816":51559},[],{"_3328":68677,"_29138":68610,"_20209":115535,"_5":13819,"_26493":115342,"_2816":24136},[],{"_3328":68678,"_29138":68610,"_20209":115537,"_5":13819,"_26493":115342,"_2816":115538},[],"Sí",{"_3328":68679,"_29138":68610,"_20209":115540,"_5":13819,"_26493":115342,"_2816":115541},[],"Identificador único de esta instancia del conector. Se usa como espacio de nombres para los metadatos: `lamassu.io/iot/{connector_id}`.",{"_3328":68680,"_29138":68610,"_20209":115543,"_5":13819,"_26493":115342,"_2816":51570},[],{"_3328":68681,"_29138":68610,"_20209":115545,"_5":13819,"_26493":115342,"_2816":24136},[],{"_3328":68682,"_29138":68610,"_20209":115547,"_5":13819,"_26493":115342,"_2816":115538},[],{"_3328":68683,"_29138":68610,"_20209":115549,"_5":13819,"_26493":115342,"_2816":115550},[],"Región AWS donde opera el conector.",{"_3328":68684,"_29138":68610,"_20209":115552,"_5":13819,"_26493":115342,"_2816":51580},[],{"_3328":68685,"_29138":68610,"_20209":115554,"_5":13819,"_26493":115342,"_2816":24136},[],{"_3328":68686,"_29138":68610,"_20209":115556,"_5":13819,"_26493":115342,"_2816":115538},[],{"_3328":68687,"_29138":68610,"_20209":115558,"_5":13819,"_26493":115342,"_2816":115559},[],"Método de autenticación: `static`, `role` o vacío (cadena de credenciales por defecto del SDK).",{"_3328":68688,"_29138":68610,"_20209":115561,"_5":13819,"_26493":115342,"_2816":51590},[],{"_3328":68689,"_29138":68610,"_20209":115563,"_5":13819,"_26493":115342,"_2816":24136},[],{"_3328":68690,"_29138":68610,"_20209":115565,"_5":13819,"_26493":115342,"_2816":115566},[],"Solo con `auth_method=static`",{"_3328":68691,"_29138":68610,"_20209":115568,"_5":13819,"_26493":115342,"_2816":115569},[],"Clave de acceso AWS.",{"_3328":68692,"_29138":68610,"_20209":115571,"_5":13819,"_26493":115342,"_2816":51601},[],{"_3328":68693,"_29138":68610,"_20209":115573,"_5":13819,"_26493":115342,"_2816":24136},[],{"_3328":68694,"_29138":68610,"_20209":115575,"_5":13819,"_26493":115342,"_2816":115566},[],{"_3328":68695,"_29138":68610,"_20209":115577,"_5":13819,"_26493":115342,"_2816":115578},[],"Clave secreta AWS.",{"_3328":68696,"_29138":68610,"_20209":115580,"_5":13819,"_26493":115342,"_2816":51611},[],{"_3328":68697,"_29138":68610,"_20209":115582,"_5":13819,"_26493":115342,"_2816":24136},[],{"_3328":68698,"_29138":68610,"_20209":115584,"_5":13819,"_26493":115342,"_2816":51616},[],{"_3328":68699,"_29138":68610,"_20209":115586,"_5":13819,"_26493":115342,"_2816":115587},[],"Token de sesión (con `auth_method=static`).",{"_3328":68700,"_29138":68610,"_20209":115589,"_5":13819,"_26493":115342,"_2816":51622},[],{"_3328":68701,"_29138":68610,"_20209":115591,"_5":13819,"_26493":115342,"_2816":24136},[],{"_3328":68702,"_29138":68610,"_20209":115593,"_5":13819,"_26493":115342,"_2816":115594},[],"Solo con `auth_method=role`",{"_3328":68703,"_29138":68610,"_20209":115596,"_5":13819,"_26493":115342,"_2816":115597},[],"ARN del rol a asumir.",{"_3328":68704,"_29138":68610,"_20209":115599,"_5":13819,"_26493":115342,"_2816":51633},[],{"_3328":68705,"_29138":68610,"_20209":115601,"_5":13819,"_26493":115342,"_2816":24136},[],{"_3328":68706,"_29138":68610,"_20209":115603,"_5":13819,"_26493":115342,"_2816":51616},[],{"_3328":68707,"_29138":68610,"_20209":115605,"_5":13819,"_26493":115342,"_2816":115606},[],"URL alternativa para todos los servicios AWS (útil con LocalStack en pruebas).",{"_3328":68708,"_29138":68610,"_20209":115608,"_5":13819,"_26493":115342,"_2816":51643},[],{"_3328":68709,"_29138":68610,"_20209":115610,"_5":13819,"_26493":115342,"_2816":16986},[],{"_3328":68710,"_29138":68610,"_20209":115612,"_5":13819,"_26493":115342,"_2816":115538},[],{"_3328":68711,"_29138":68610,"_20209":115614,"_5":13819,"_26493":115342,"_2816":115615},[],"Configuración del bus de eventos al que se suscribe el conector (AMQP o AWS SQS/SNS).",{"_3328":68712,"_29138":68610,"_20209":115617,"_5":13819,"_26493":115342,"_2816":51653},[],{"_3328":68713,"_29138":68610,"_20209":115619,"_5":13819,"_26493":115342,"_2816":24136},[],{"_3328":68714,"_29138":68610,"_20209":115621,"_5":13819,"_26493":115342,"_2816":115538},[],{"_3328":68715,"_29138":68610,"_20209":115623,"_5":13819,"_26493":115342,"_2816":115624},[],"URL HTTP del servicio DMS Manager de Lamassu.",{"_3328":68716,"_29138":68610,"_20209":115626,"_5":13819,"_26493":115342,"_2816":51663},[],{"_3328":68717,"_29138":68610,"_20209":115628,"_5":13819,"_26493":115342,"_2816":24136},[],{"_3328":68718,"_29138":68610,"_20209":115630,"_5":13819,"_26493":115342,"_2816":115538},[],{"_3328":68719,"_29138":68610,"_20209":115632,"_5":13819,"_26493":115342,"_2816":115633},[],"URL HTTP del Device Manager de Lamassu.",{"_3328":68720,"_29138":68610,"_20209":115635,"_5":13819,"_26493":115342,"_2816":51673},[],{"_3328":68721,"_29138":68610,"_20209":115637,"_5":13819,"_26493":115342,"_2816":24136},[],{"_3328":68722,"_29138":68610,"_20209":115639,"_5":13819,"_26493":115342,"_2816":115538},[],{"_3328":68723,"_29138":68610,"_20209":115641,"_5":13819,"_26493":115342,"_2816":115642},[],"URL HTTP del servicio de CA de Lamassu.",{"_3328":68724,"_29138":68610,"_20209":115644,"_5":13819,"_26493":115346,"_2816":115645},[],"El conector gestiona el lado AWS de cuatro tipos de recursos: CAs, plantillas de aprovisionamiento de DMS (JITP), certificados de dispositivo y Things. Esta sección mapea los eventos del bus que consume el conector a los recursos de AWS que toca y a las llamadas AWS que ejecuta cada transición. Los recursos de AWS se referencian con la notación `IoTCore/<recurso>`.",{"_3328":68725,"_29138":68610,"_20209":115647,"_5":13819,"_26493":115350,"_2816":115648},[],"La columna **Tipo de CloudEvent** lista el nombre del evento en el bus interno de Lamassu; la columna **Acciones IAM** lista las operaciones exactas del SDK de AWS que invoca cada flujo, para que los permisos necesarios se deriven directamente de esta tabla.",{"_3328":68726,"_29138":68610,"_20209":115650,"_5":13819,"_26493":115350,"_2816":115651},[],"Tipo de CloudEvent",{"_3328":68727,"_29138":68610,"_20209":115653,"_5":13819,"_26493":115350,"_2816":115654},[],"Recurso en Lamassu",{"_3328":68728,"_29138":68610,"_20209":115656,"_5":13819,"_26493":115350,"_2816":115657},[],"Recurso AWS",{"_3328":68729,"_29138":68610,"_20209":115659,"_5":13819,"_26493":115350,"_2816":115660},[],"Acciones IAM",{"_3328":68730,"_29138":68610,"_20209":115662,"_5":13819,"_26493":115350,"_2816":115663},[],"Llamadas AWS y efecto",{"_3328":68731,"_29138":68610,"_20209":115665,"_5":13819,"_26493":115350,"_2816":115666},[],"Dónde en esta página",{"_3328":68732,"_29138":68610,"_20209":115668,"_5":13819,"_26493":115350,"_2816":51707},[],{"_3328":68733,"_29138":68610,"_20209":115670,"_5":13819,"_26493":115350,"_2816":51710},[],{"_3328":68734,"_29138":68610,"_20209":115672,"_5":13819,"_26493":115350,"_2816":51713},[],{"_3328":68735,"_29138":68610,"_20209":115674,"_5":13819,"_26493":115350,"_2816":51716},[],{"_3328":68736,"_29138":68610,"_20209":115676,"_5":13819,"_26493":115350,"_2816":115677},[],"Carga la CA en el estado del conector; una escritura de `registration.status = REQUESTED` dispara el flujo de registro (Primary con certificado de verificación, o SNI-only) y escribe `SUCCEEDED` o `FAILED` en los metadatos de la CA.",{"_3328":68737,"_29138":68610,"_20209":115679,"_5":13819,"_26493":115350,"_2816":115355},[],{"_3328":68738,"_29138":68610,"_20209":115681,"_5":13819,"_26493":115350,"_2816":51724},[],{"_3328":68739,"_29138":68610,"_20209":115683,"_5":13819,"_26493":115350,"_2816":51727},[],{"_3328":68740,"_29138":68610,"_20209":115685,"_5":13819,"_26493":115350,"_2816":51730},[],{"_3328":68741,"_29138":68610,"_20209":115687,"_5":13819,"_26493":115350,"_2816":51733},[],{"_3328":68742,"_29138":68610,"_20209":115689,"_5":13819,"_26493":115350,"_2816":115690},[],"En modo `jitp`, intenta crear la plantilla de aprovisionamiento y la adjunta a la CA registrada. No idempotente: una edición `PUT /v1/dms/{id}` reintenta la creación y acaba en `lamassu-dlq` tras 3 reintentos. Idempotente para `none` y `auto` (solo configuración).",{"_3328":68743,"_29138":68610,"_20209":115692,"_5":13819,"_26493":115350,"_2816":115359},[],{"_3328":68744,"_29138":68610,"_20209":115694,"_5":13819,"_26493":115350,"_2816":51741},[],{"_3328":68745,"_29138":68610,"_20209":115696,"_5":13819,"_26493":115350,"_2816":115697},[],"Dispositivo",{"_3328":68746,"_29138":68610,"_20209":115699,"_5":13819,"_26493":115350,"_2816":51747},[],{"_3328":68747,"_29138":68610,"_20209":115701,"_5":13819,"_26493":115350,"_2816":51750},[],{"_3328":68748,"_29138":68610,"_20209":115703,"_5":13819,"_26493":115350,"_2816":115704},[],"En modo `auto`: crea/actualiza políticas, asegura los grupos de Things, revoca principals obsoletos y aprovisiona el Thing vía `iot:RegisterThing`. En modo `jitp`: no hay llamadas AWS; AWS ejecuta la plantilla JITP en la primera conexión.",{"_3328":68749,"_29138":68610,"_20209":115706,"_5":13819,"_26493":115350,"_2816":115367},[],{"_3328":68750,"_29138":68610,"_20209":115708,"_5":13819,"_26493":115350,"_2816":51758},[],{"_3328":68751,"_29138":68610,"_20209":115710,"_5":13819,"_26493":115350,"_2816":115711},[],"Certificado",{"_3328":68752,"_29138":68610,"_20209":115713,"_5":13819,"_26493":115350,"_2816":51764},[],{"_3328":68753,"_29138":68610,"_20209":115715,"_5":13819,"_26493":115350,"_2816":115716},[],"`iot:UpdateCertificate`, `iot:Connect` (plano de datos)",{"_3328":68754,"_29138":68610,"_20209":115718,"_5":13819,"_26493":115350,"_2816":115719},[],"Mapea el estado a AWS (`ACTIVE`, `INACTIVE`, `REVOKED`), llama a `iot:UpdateCertificate` y fuerza una desconexión MQTT al revocar.",{"_3328":68755,"_29138":68610,"_20209":115721,"_5":13819,"_26493":115350,"_2816":115363},[],{"_3328":68756,"_29138":68610,"_20209":115723,"_5":13819,"_26493":115350,"_2816":51775},[],{"_3328":68757,"_29138":68610,"_20209":115725,"_5":13819,"_26493":115350,"_2816":115726},[],"Certificado / Dispositivo",{"_3328":68758,"_29138":68610,"_20209":115728,"_5":13819,"_26493":115350,"_2816":51781},[],{"_3328":68759,"_29138":68610,"_20209":115730,"_5":13819,"_26493":115350,"_2816":47793},[],{"_3328":68760,"_29138":68610,"_20209":115732,"_5":13819,"_26493":115350,"_2816":115733},[],"Refresca el estado interno; el conector ignora los eventos cuyo campo CloudEvent `source` coincide con su propia URI para evitar bucles autodisparados.",{"_3328":68761,"_29138":68610,"_20209":115735,"_5":13819,"_26493":115350,"_2816":115417},[],{"_3328":68762,"_29138":68610,"_20209":115737,"_5":13819,"_26493":115354,"_2816":115738},[],"El flujo de registro de la CA se gobierna por el campo `registration.status` de los metadatos del conector en la CA:",{"_3328":68763,"_29138":68610,"_20209":115740,"_5":13819,"_26493":115354,"_2816":115741},[],"por el campo `registration.status` de los metadatos del conector en la CA:",{"_3328":68764,"_29138":68610,"_20209":115743,"_5":13819,"_26493":115354,"_2816":115744},[],"Transición",{"_3328":68765,"_29138":68610,"_20209":115746,"_5":13819,"_26493":115354,"_2816":115747},[],"Llamadas AWS",{"_3328":68766,"_29138":68610,"_20209":115749,"_5":13819,"_26493":115354,"_2816":115750},[],"`NoRegistrada` → `Solicitada`",{"_3328":68767,"_29138":68610,"_20209":115752,"_5":13819,"_26493":115354,"_2816":115753},[],"ninguna (solo escritura de metadatos)",{"_3328":68768,"_29138":68610,"_20209":115755,"_5":13819,"_26493":115354,"_2816":115756},[],"`Solicitada` → `Registrando`",{"_3328":68769,"_29138":68610,"_20209":115758,"_5":13819,"_26493":115354,"_2816":115759},[],"`iot:GetRegistrationCode` (solo Primary Account)",{"_3328":68770,"_29138":68610,"_20209":115761,"_5":13819,"_26493":115354,"_2816":115762},[],"`Registrando` → `Completada`",{"_3328":68771,"_29138":68610,"_20209":115764,"_5":13819,"_26493":115354,"_2816":115765},[],"`iot:RegisterCACertificate` (Primary: prueba de posesión con clave efímera; SNI-only: `CertificateMode: SNI_ONLY`)",{"_3328":68772,"_29138":68610,"_20209":115767,"_5":13819,"_26493":115354,"_2816":115768},[],"`Registrando` → `Fallida`",{"_3328":68773,"_29138":68610,"_20209":115770,"_5":13819,"_26493":115354,"_2816":115771},[],"`iot:RegisterCACertificate` fallida; el detalle del error se escribe en los metadatos de la CA",{"_3328":68774,"_29138":68610,"_20209":115773,"_5":13819,"_26493":115354,"_2816":115774},[],"`Fallida` / `Completada` → `Solicitada`",{"_3328":68775,"_29138":68610,"_20209":115776,"_5":13819,"_26493":115354,"_2816":115777},[],"ninguna (una nueva escritura `REQUESTED` reejecuta el flujo)",{"_3328":68776,"_29138":68610,"_20209":115779,"_5":13819,"_26493":115358,"_2816":115780},[],"El `registration_mode` del DMS determina qué hace el conector en el lado AWS cuando el DMS se crea o se edita por completo:",{"_3328":68777,"_29138":68610,"_20209":115782,"_5":13819,"_26493":115358,"_2816":115744},[],{"_3328":68778,"_29138":68610,"_20209":115784,"_5":13819,"_26493":115358,"_2816":115747},[],{"_3328":68779,"_29138":68610,"_20209":115786,"_5":13819,"_26493":115358,"_2816":115787},[],"`SinConfigurar` → `None` / `Auto`",{"_3328":68780,"_29138":68610,"_20209":115789,"_5":13819,"_26493":115358,"_2816":115790},[],"ninguna (solo configuración)",{"_3328":68781,"_29138":68610,"_20209":115792,"_5":13819,"_26493":115358,"_2816":51846},[],{"_3328":68782,"_29138":68610,"_20209":115794,"_5":13819,"_26493":115358,"_2816":115790},[],{"_3328":68783,"_29138":68610,"_20209":115796,"_5":13819,"_26493":115358,"_2816":115797},[],"Cualquiera → `Jitp`",{"_3328":68784,"_29138":68610,"_20209":115799,"_5":13819,"_26493":115358,"_2816":115800},[],"`iot:CreateProvisioningTemplate` (no idempotente: falla si la plantilla ya existe; tras 3 reintentos el evento acaba en `lamassu-dlq`)",{"_3328":68785,"_29138":68610,"_20209":115802,"_5":13819,"_26493":115358,"_2816":51857},[],{"_3328":68786,"_29138":68610,"_20209":115804,"_5":13819,"_26493":115358,"_2816":115805},[],"ninguna (la plantilla permanece en la cuenta AWS)",{"_3328":68787,"_29138":68610,"_20209":115807,"_5":13819,"_26493":115362,"_2816":115808},[],"Los certificados con la clave de metadatos del conector sincronizan su estado; los aprovisionados vía JITP no tienen clave de metadatos y quedan fuera de esta máquina:",{"_3328":68788,"_29138":68610,"_20209":115810,"_5":13819,"_26493":115362,"_2816":115744},[],{"_3328":68789,"_29138":68610,"_20209":115812,"_5":13819,"_26493":115362,"_2816":115747},[],{"_3328":68790,"_29138":68610,"_20209":115814,"_5":13819,"_26493":115362,"_2816":115815},[],"`NoSincronizado` → `Active`",{"_3328":68791,"_29138":68610,"_20209":115817,"_5":13819,"_26493":115362,"_2816":51514},[],{"_3328":68792,"_29138":68610,"_20209":115819,"_5":13819,"_26493":115362,"_2816":51875},[],{"_3328":68793,"_29138":68610,"_20209":115821,"_5":13819,"_26493":115362,"_2816":115822},[],"`iot:UpdateCertificate` + desconexión MQTT forzada",{"_3328":68794,"_29138":68610,"_20209":115824,"_5":13819,"_26493":115362,"_2816":51881},[],{"_3328":68795,"_29138":68610,"_20209":115826,"_5":13819,"_26493":115362,"_2816":115822},[],{"_3328":68796,"_29138":68610,"_20209":115828,"_5":13819,"_26493":115362,"_2816":51886},[],{"_3328":68797,"_29138":68610,"_20209":115830,"_5":13819,"_26493":115362,"_2816":51514},[],{"_3328":68798,"_29138":68610,"_20209":115832,"_5":13819,"_26493":115362,"_2816":51891},[],{"_3328":68799,"_29138":68610,"_20209":115834,"_5":13819,"_26493":115362,"_2816":115835},[],"ninguna (estos estados no se sincronizan con AWS)",{"_3328":68800,"_29138":68610,"_20209":115837,"_5":13819,"_26493":115366,"_2816":115838},[],"Los Things solo existen en modo `auto`; en modo `jitp` AWS crea el Thing por sí mismo cuando el dispositivo se conecta por primera vez. El nombre del Thing es siempre el CN del certificado del dispositivo:",{"_3328":68801,"_29138":68610,"_20209":115840,"_5":13819,"_26493":115366,"_2816":115744},[],{"_3328":68802,"_29138":68610,"_20209":115842,"_5":13819,"_26493":115366,"_2816":115747},[],{"_3328":68803,"_29138":68610,"_20209":115844,"_5":13819,"_26493":115366,"_2816":115845},[],"`Ausente` → `Aprovisionado`",{"_3328":68804,"_29138":68610,"_20209":115847,"_5":13819,"_26493":115366,"_2816":115848},[],"políticas creadas/actualizadas, grupos de Things asegurados, `iot:RegisterThing` (crea el Thing, registra el certificado, adjunta políticas)",{"_3328":68805,"_29138":68610,"_20209":115850,"_5":13819,"_26493":115366,"_2816":115851},[],"`Aprovisionado` → `Aprovisionado` (re-enrolamiento)",{"_3328":68806,"_29138":68610,"_20209":115853,"_5":13819,"_26493":115366,"_2816":115854},[],"principals obsoletos marcados como `REVOKED`, nueva ejecución de `iot:RegisterThing`; el nuevo ARN del certificado sustituye al anterior en los metadatos de Lamassu",{"_3328":68807,"_29138":68610,"_20209":115856,"_5":13819,"_26493":115366,"_2816":115857},[],"En modo `jitp` el conector no hace llamadas de aprovisionamiento: AWS ejecuta la plantilla JITP en la primera conexión del dispositivo y crea el Thing, registra el certificado y lo activa por su cuenta.",{"_3328":68808,"_29138":68610,"_20209":115859,"_5":13819,"_26493":115370,"_2816":115860},[],"Para que los dispositivos puedan autenticarse en AWS IoT Core con certificados emitidos por una CA de Lamassu, esa CA debe registrarse previamente en la cuenta AWS. El conector gestiona este registro de forma automática en respuesta a los eventos `EventCreateCAKey`, `EventImportCAKey` y `EventUpdateCAMetadataKey`, pero la operación **solo se dispara cuando el administrador la solicita explícitamente** mediante el campo de metadatos de la CA.",{"_3328":68809,"_29138":68610,"_20209":115862,"_5":13819,"_26493":115374,"_2816":115863},[],"El registro se desencadena estableciendo el valor `registration.status = \"REQUESTED\"` en la clave `lamassu.io/iot/{connector_id}` de los metadatos de la CA. Esto puede hacerse desde la consola de Lamassu en la sección de gestión de la CA o mediante la API.",{"_3328":68810,"_29138":68610,"_20209":115865,"_5":13819,"_26493":115374,"_2816":115866},[],"Una vez recibido el evento, el conector intenta registrar la CA en AWS y actualiza el campo `registration.status` en los metadatos de la CA con el resultado: `\"SUCCEEDED\"` si el registro fue correcto, o `\"FAILED\"` acompañado de un mensaje de error en caso contrario. El proceso es asíncrono, por lo que es necesario consultar periódicamente el estado de los metadatos hasta que la operación concluya.",{"_3328":68811,"_29138":68610,"_20209":115868,"_5":13819,"_26493":115378,"_2816":115869},[],"Cuando el parámetro `primary_account` es `true`, el conector ejecuta el flujo completo de registro con verificación de posesión de clave privada:",{"_3328":68812,"_29138":68610,"_20209":115871,"_5":13819,"_26493":115378,"_2816":115872},[],"Llama a `iot:GetRegistrationCode` para obtener el código de verificación de AWS.",{"_3328":68813,"_29138":68610,"_20209":115874,"_5":13819,"_26493":115378,"_2816":115875},[],"El conector genera internamente un par de claves RSA-2048 efímero y construye un CSR cuyo Common Name es exactamente ese código de registro. A continuación llama al servicio de firma de Lamassu para que la CA registrada emita un certificado de verificación X.509 real firmando ese CSR. La clave privada efímera se usa únicamente para este propósito y no se almacena ni se envía a AWS.",{"_3328":68814,"_29138":68610,"_20209":115877,"_5":13819,"_26493":115378,"_2816":115878},[],"Envía a AWS la CA (en PEM) y el certificado de verificación mediante `iot:RegisterCACertificate`, activando el registro con `AllowAutoRegistration: true`.",{"_3328":68815,"_29138":68610,"_20209":115880,"_5":13819,"_26493":115378,"_2816":115881},[],"Solo una cuenta puede ser propietaria de una CA en una región AWS dada. Si la CA ya está registrada con el mismo número de serie, el conector omite el paso silenciosamente.",{"_3328":68816,"_29138":68610,"_20209":115883,"_5":13819,"_26493":115378,"_2816":115884},[],"Los tags que AWS IoT Core aplica al certificado de CA registrado son `LMS.CA.ID`, `LMS.CA.SN` y `LMS.CA.CN`.",{"_3328":68817,"_29138":68610,"_20209":115886,"_5":13819,"_26493":115381,"_2816":115887},[],"Cuando `primary_account` es `false`, el conector registra la CA usando el modo `CertificateMode: SNI_ONLY`. Este modo no requiere código de verificación ni acceso a la clave privada de la CA, por lo que es la opción adecuada cuando la CA se gestiona desde otra cuenta de AWS o cuando el administrador no dispone de la clave privada. Es el método habitual para registrar la misma CA en varias cuentas de AWS simultáneamente.",{"_3328":68818,"_29138":68610,"_20209":115889,"_5":13819,"_26493":115384,"_2816":115890},[],"Cada DMS que participe en la integración con AWS IoT Core debe tener configurada la clave de metadatos `lamassu.io/iot/{connector_id}`. El campo más importante de esa configuración es `registration_mode`, que determina cómo se aprovisionan los dispositivos en AWS.",{"_3328":68819,"_29138":68610,"_20209":115892,"_5":13819,"_26493":115384,"_2816":115893},[],"Existen tres modos de registro, y la elección entre ellos depende de la estrategia de aprovisionamiento de la flota.",{"_3328":68820,"_29138":68610,"_20209":115895,"_5":13819,"_26493":115388,"_2816":115896},[],"En este modo el conector **no crea Things, grupos ni políticas** en AWS IoT Core. Se limita a sincronizar el estado de los certificados (activo, revocado, suspendido) a medida que cambian en Lamassu. Es el modo adecuado cuando el aprovisionamiento de Things en AWS se gestiona por un sistema externo y solo se necesita que Lamassu mantenga el estado de los certificados actualizado.",{"_3328":68821,"_29138":68610,"_20209":115898,"_5":13819,"_26493":115392,"_2816":115899},[],"El modo `auto` delega en Lamassu el aprovisionamiento completo del dispositivo en AWS en el momento del enrolamiento. Cuando el dispositivo completa con éxito su enrolamiento EST y Lamassu emite el evento `EventBindDeviceIdentityKey`, el conector ejecuta automáticamente la siguiente secuencia:",{"_3328":68822,"_29138":68610,"_20209":115901,"_5":13819,"_26493":115392,"_2816":115902},[],"Crea o actualiza las políticas IoT configuradas en el DMS.",{"_3328":68823,"_29138":68610,"_20209":115904,"_5":13819,"_26493":115392,"_2816":115905},[],"Crea el grupo raíz `LAMASSU` en la cuenta AWS (si no existe) y los grupos hijos configurados en el DMS como subgrupos de `LAMASSU`. Si los grupos ya existen, el error `ResourceAlreadyExistsException` se ignora, por lo que la operación es idempotente.",{"_3328":68824,"_29138":68610,"_20209":115907,"_5":13819,"_26493":115392,"_2816":115908},[],"Si el Thing ya existía en AWS IoT Core, el conector itera todos los certificados (principals) actualmente adjuntos a ese Thing y los marca como `REVOKED` en AWS, para garantizar que los certificados anteriores no puedan seguir siendo usados para autenticarse.",{"_3328":68825,"_29138":68610,"_20209":115910,"_5":13819,"_26493":115392,"_2816":115911},[],"Llama a `iot:RegisterThing` con una plantilla de aprovisionamiento de estilo CloudFormation que crea el Thing, registra el certificado del dispositivo (PEM del certificado del dispositivo y del certificado de la CA emisora) y adjunta las políticas configuradas.\nUna vez completado el aprovisionamiento, el conector almacena el ARN del certificado resultante en los metadatos del certificado de Lamassu bajo la clave `lamassu.io/iot/{connector_id}` y marca el dispositivo como `Registered: true` en Device Manager.",{"_3328":68826,"_29138":68610,"_20209":115913,"_5":13819,"_26493":115392,"_2816":115914},[],"**El nombre del Thing en AWS es el Common Name (CN) del certificado del dispositivo.** Esta convención es fundamental para el desarrollador de firmware: el valor `/CN=` que el dispositivo incluye en su CSR al enrolarse se convierte en el ThingName con el que deberá identificarse en todas las operaciones MQTT contra AWS IoT Core.",{"_3328":68827,"_29138":68610,"_20209":115916,"_5":13819,"_26493":115396,"_2816":115917},[],"El modo Just-In-Time Provisioning (JITP) delega el aprovisionamiento en AWS en lugar de hacerlo el conector directamente. Cuando el conector detecta que el DMS está en modo `jitp`, crea una plantilla de aprovisionamiento JITP en AWS IoT Core y la adjunta al certificado de CA registrado. El conector intenta crear esta plantilla cuando el DMS se crea y de nuevo en cada edición completa del DMS (`PUT /v1/dms/{id}`) - no en el momento del enrolamiento del dispositivo. El intento no es idempotente: cuando ya existe una plantilla nombrada con el ID del DMS, la llamada de creación falla, el evento se reintenta tres veces y acaba en la cola de mensajes fallidos `lamassu-dlq` (ver Solución de problemas). La plantilla se crea una sola vez; las ediciones posteriores nunca actualizan su contenido. Una actualización del DMS que omite `metadata` o envía `null` conserva los metadatos almacenados, así que la clave del conector `lamassu.io/iot/{connector_id}` sigue presente y el intento se sigue disparando. Un cuerpo que suministra un objeto `metadata` sustituye por completo los metadatos almacenados: si ese objeto no lleva la clave del conector, la clave se elimina y el conector omite silenciosamente los eventos futuros del DMS. Una vez adjuntada la plantilla, cuando un dispositivo con un certificado emitido por esa CA se conecta por primera vez a AWS IoT Core, AWS ejecuta la plantilla automáticamente: crea el Thing, registra el certificado y lo activa.",{"_3328":68828,"_29138":68610,"_20209":115919,"_5":13819,"_26493":115396,"_2816":115920},[],"El conector crea la plantilla, nombrada con el ID del DMS, una sola vez. Cada edición posterior del DMS que conserve la clave del conector intenta crearla de nuevo y falla, porque el conector no actualiza plantillas existentes. Los cambios posteriores en `jitp_config.provisioning_role_arn`, `jitp_config.enable_template` o en los grupos y políticas que la plantilla referencia deben aplicarse a mano en AWS IoT Core.",{"_3328":68829,"_29138":68610,"_20209":115922,"_5":13819,"_26493":115396,"_2816":115923},[],"El evento fallido se reintenta y termina en `lamassu-dlq`. Los grupos y las políticas se registran antes del fallo, pero se omiten la asignación de la plantilla a la CA registrada, la escritura del ARN en el DMS y la actualización de las shadows al cambiar `ManagedCAs`.",{"_3328":68830,"_29138":68610,"_20209":115925,"_5":13819,"_26493":115396,"_2816":115926},[],"El nombre del Thing en la plantilla JITP se deriva de `AWS::IoT::Certificate::CommonName`, que corresponde al CN del certificado del dispositivo - la misma convención que el modo `auto`.",{"_3328":68831,"_29138":68610,"_20209":115928,"_5":13819,"_26493":115396,"_2816":115929},[],"Este modo requiere que se configure el campo `jitp_config.provisioning_role_arn` con el ARN de un rol IAM que AWS IoT Core pueda asumir para ejecutar la plantilla. Si no se configura, el conector utiliza el valor por defecto `arn:aws:iam::{account}:role/JITPRole` y registra un aviso en el log. El administrador debe asegurarse de que ese rol existe en la cuenta y tiene los permisos necesarios antes de activar el modo JITP.",{"_3328":68832,"_29138":68610,"_20209":115931,"_5":13819,"_26493":115400,"_2816":115932},[],"Para el desarrollador de firmware, el modo `auto` es transparente: el dispositivo realiza su enrolamiento EST de la forma habitual y, como efecto secundario, queda aprovisionado en AWS IoT Core sin ningún paso adicional.",{"_3328":68833,"_29138":68610,"_20209":115934,"_5":13819,"_26493":115400,"_2816":115935},[],"El flujo completo desde el punto de vista del dispositivo es el siguiente:",{"_3328":68834,"_29138":68610,"_20209":115937,"_5":13819,"_26493":115400,"_2816":115938},[],"Una vez que el conector completa el aprovisionamiento, el dispositivo puede conectarse al endpoint AWS IoT Core de MQTT usando su clave privada y el certificado emitido por Lamassu. El ThingName con el que debe identificarse en AWS es exactamente el CN del certificado.",{"_3328":68835,"_29138":68610,"_20209":115940,"_5":13819,"_26493":115404,"_2816":115941},[],"En el modo JITP el dispositivo también realiza su enrolamiento EST de forma convencional y obtiene su certificado de Lamassu. La diferencia es que AWS IoT Core no conoce al dispositivo hasta que este intenta conectarse por primera vez.",{"_3328":68836,"_29138":68610,"_20209":115943,"_5":13819,"_26493":115404,"_2816":115944},[],"Cuando el dispositivo establece su primera conexión MQTT a AWS IoT Core presentando el certificado emitido por Lamassu, AWS detecta que el certificado pertenece a una CA registrada con una plantilla JITP, ejecuta esa plantilla y crea el Thing automáticamente. La conexión inicial puede fallar o demorarse mientras se ejecuta la plantilla; el firmware debe estar preparado para reintentar la conexión.",{"_3328":68837,"_29138":68610,"_20209":115946,"_5":13819,"_26493":115404,"_2816":115947},[],"Para que el flujo JITP funcione correctamente:",{"_3328":68838,"_29138":68610,"_20209":115949,"_5":13819,"_26493":115404,"_2816":115950},[],"La CA debe estar registrada en AWS en modo Primary Account (el modo SNI-only no admite JITP).",{"_3328":68839,"_29138":68610,"_20209":115952,"_5":13819,"_26493":115404,"_2816":115953},[],"El rol IAM configurado en `jitp_config.provisioning_role_arn` debe existir y tener permisos para crear Things, registrar certificados y adjuntar políticas en la cuenta AWS.",{"_3328":68840,"_29138":68610,"_20209":115955,"_5":13819,"_26493":115404,"_2816":115956},[],"El dispositivo debe presentar tanto su certificado como el certificado de la CA emisora en el handshake TLS con AWS IoT Core.",{"_3328":68841,"_29138":68610,"_20209":115958,"_5":13819,"_26493":115404,"_2816":115959},[],"Los certificados aprovisionados mediante JITP **no tienen asociada la clave de metadatos del conector** (`lamassu.io/iot/{connector_id}`) en Lamassu. Como consecuencia, los cambios de estado de esos certificados en Lamassu no se sincronizan automáticamente con AWS a través del mecanismo de sincronización de estado descrito en la siguiente sección.",{"_3328":68842,"_29138":68610,"_20209":115961,"_5":13819,"_26493":115408,"_2816":115962},[],"El conector escucha el evento `EventUpdateCertificateStatusKey` y, cuando un certificado que tiene la clave de metadatos del conector cambia de estado en Lamassu, replica ese cambio en AWS IoT Core. La tabla siguiente muestra la correspondencia de estados:",{"_3328":68843,"_29138":68610,"_20209":115964,"_5":13819,"_26493":115408,"_2816":115965},[],"Estado en Lamassu",{"_3328":68844,"_29138":68610,"_20209":115967,"_5":13819,"_26493":115408,"_2816":115968},[],"Razón de revocación",{"_3328":68845,"_29138":68610,"_20209":115970,"_5":13819,"_26493":115408,"_2816":115971},[],"Estado en AWS IoT Core",{"_3328":68846,"_29138":68610,"_20209":115973,"_5":13819,"_26493":115408,"_2816":52036},[],{"_3328":68847,"_29138":68610,"_20209":115975,"_5":13819,"_26493":115408,"_2816":115976},[],"Ninguna",{"_3328":68848,"_29138":68610,"_20209":115978,"_5":13819,"_26493":115408,"_2816":52042},[],{"_3328":68849,"_29138":68610,"_20209":115980,"_5":13819,"_26493":115408,"_2816":52045},[],{"_3328":68850,"_29138":68610,"_20209":115982,"_5":13819,"_26493":115408,"_2816":52048},[],{"_3328":68851,"_29138":68610,"_20209":115984,"_5":13819,"_26493":115408,"_2816":52051},[],{"_3328":68852,"_29138":68610,"_20209":115986,"_5":13819,"_26493":115408,"_2816":52045},[],{"_3328":68853,"_29138":68610,"_20209":115988,"_5":13819,"_26493":115408,"_2816":115989},[],"Cualquier otra razón",{"_3328":68854,"_29138":68610,"_20209":115991,"_5":13819,"_26493":115408,"_2816":52059},[],{"_3328":68855,"_29138":68610,"_20209":115993,"_5":13819,"_26493":115408,"_2816":115994},[],"Solo los estados `Active` y `Revoked` producen una llamada a `iot:UpdateCertificate`. Los demás estados del ciclo de vida de Lamassu (`RenewalWindow`, `AboutToExpire`, `Expired`) no se sincronizan con AWS IoT Core; el estado del certificado en AWS permanece sin cambios hasta que el estado en Lamassu sea `Active` o `Revoked`.",{"_3328":68856,"_29138":68610,"_20209":115996,"_5":13819,"_26493":115412,"_2816":115997},[],"Cuando el conector marca un certificado como `REVOKED` o `INACTIVE` en AWS, ejecuta adicionalmente una desconexión forzada del dispositivo. Para ello abre una conexión MQTT sobre WebSocket (con autenticación SigV4 con las credenciales del conector) al endpoint de datos de AWS IoT Core, usando el CN del certificado como identificador de cliente MQTT, y la cierra inmediatamente. Esto termina cualquier sesión MQTT activa que el dispositivo pueda tener en ese momento.",{"_3328":68857,"_29138":68610,"_20209":115999,"_5":13819,"_26493":115412,"_2816":116000},[],"Esta desconexión forzada se produce en el momento en que Lamassu registra el cambio de estado. Si el dispositivo vuelve a intentar conectarse tras la desconexión, AWS IoT Core rechazará la conexión porque el certificado ya figura como `REVOKED` o `INACTIVE`.",{"_3328":68858,"_29138":68610,"_20209":116002,"_5":13819,"_26493":115412,"_2816":116003},[],"Los certificados aprovisionados en modo JITP no disponen de esta sincronización automática, ya que no tienen la clave de metadatos del conector.",{"_3328":68859,"_29138":68610,"_20209":116005,"_5":13819,"_26493":115416,"_2816":116006},[],"El conector puede escribir en el Device Shadow de AWS IoT Core para enviar señales de acción al firmware del dispositivo. Esta funcionalidad se activa por DMS mediante `shadow_config.enable: true`.",{"_3328":68860,"_29138":68610,"_20209":116008,"_5":13819,"_26493":115416,"_2816":116009},[],"Si `shadow_config.shadow_name` contiene un valor, el conector usa un Named Shadow con ese nombre; en caso contrario, usa el Classic Shadow (shadow predeterminado del Thing).",{"_3328":68861,"_29138":68610,"_20209":116011,"_5":13819,"_26493":115420,"_2816":116012},[],"El conector escribe en el campo `desired.identity_actions` del documento shadow. Cada entrada contiene un timestamp Unix en milisegundos. El firmware del dispositivo debe leer este campo y actuar en consecuencia.",{"_3328":68862,"_29138":68610,"_20209":116014,"_5":13819,"_26493":115420,"_2816":116015},[],"Existen dos tipos de acciones:",{"_3328":68863,"_29138":68610,"_20209":116017,"_5":13819,"_26493":115420,"_2816":116018},[],"**`UPDATE_CERTIFICATE`**: se escribe cuando la ventana de renovación preventiva de un certificado se activa - es decir, cuando el campo `triggered` de la delta de renovación preventiva pasa de `false` a `true`. Esta acción indica al dispositivo que debe iniciar el proceso de re-enrolamiento para renovar su certificado antes de que expire.",{"_3328":68864,"_29138":68610,"_20209":116020,"_5":13819,"_26493":115420,"_2816":116021},[],"**`UPDATE_TRUST_ANCHOR_LIST`**: se escribe en todos los dispositivos de un DMS cuando la lista `ManagedCAs` del DMS cambia. Esta acción indica al dispositivo que debe actualizar su almacén de CAs de confianza.",{"_3328":68865,"_29138":68610,"_20209":116023,"_5":13819,"_26493":115420,"_2816":116024},[],"El proceso de escritura en el shadow consiste en leer el shadow actual (`iotdata:GetThingShadow`), combinar las nuevas acciones con las existentes y escribir el resultado (`iotdata:UpdateThingShadow`). Si el shadow no existe, el conector lo crea. Tras una escritura correcta, la lista de acciones pendientes en los metadatos del dispositivo en Lamassu se limpia.",{"_3328":68866,"_29138":68610,"_20209":116026,"_5":13819,"_26493":115424,"_2816":116027},[],"El conector crea y adjunta las políticas que se configuran en el DMS. Una política típica para un dispositivo que usa MQTT y Device Shadow tiene la siguiente estructura:",{"_3328":68867,"_29138":68610,"_20209":116029,"_5":13819,"_26493":115424,"_2816":116030},[],"En la política anterior, los marcadores `<AWS_REGION>` y `<AWS_ACCOUNT_ID>` deben reemplazarse por la región AWS y el identificador de cuenta de doce dígitos de la cuenta destino antes de aplicar la política. La variable `${iot:Connection.Thing.ThingName}` limita automáticamente cada permiso al Thing al que el dispositivo está conectado, siguiendo el principio de mínimo privilegio. La variable `${ShadowName}` en los ARN de shadow es un marcador que debe reemplazarse con el valor de `shadow_config.shadow_name` configurado en el DMS; si se usa el Classic Shadow, se puede simplificar eliminando el segmento `name/${ShadowName}/`. Las políticas de AWS IoT no admiten expresiones regulares con alternancia; la notación `[name/${ShadowName}/]*` representa la opcionalidad del segmento dentro de las restricciones de la sintaxis de ARN.",{"_3328":68868,"_29138":68610,"_20209":116032,"_5":13819,"_26493":115424,"_2816":116033},[],"El primer statement permite que el dispositivo se conecte usando su ThingName como identificador MQTT. El segundo autoriza la publicación en el topic MQTT genérico del Thing y en los topics del shadow, necesario para que el dispositivo pueda actualizar el estado reportado. Los dos últimos statements otorgan permisos de suscripción y recepción sobre los mismos topics, lo que permite al dispositivo recibir actualizaciones del shadow (por ejemplo, las acciones `UPDATE_CERTIFICATE` y `UPDATE_TRUST_ANCHOR_LIST` escritas por el conector).",{"_3328":68869,"_29138":68610,"_20209":116035,"_5":13819,"_26493":115428,"_2816":116036},[],"**Síntoma:** El registro de la CA permanece indefinidamente en estado `REQUESTED`.",{"_3328":68870,"_29138":68610,"_20209":116038,"_5":13819,"_26493":115428,"_2816":116039},[],"**Causa:** El conector no está en ejecución o no está suscrito al bus de eventos. También puede indicar credenciales IAM incorrectas, permisos insuficientes o que la clave de metadatos se escribió con un `connector_id` incorrecto.",{"_3328":68871,"_29138":68610,"_20209":116041,"_5":13819,"_26493":115428,"_2816":116042},[],"**Resolución:** Verificar que el proceso del conector está activo y que los logs no muestran errores de comunicación con AWS. Comprobar que el campo de metadatos se escribió bajo la clave exacta `lamassu.io/iot/{connector_id}`. Si el error persiste, el conector actualizará el estado a `FAILED` con un mensaje descriptivo en los metadatos de la CA.",{"_3328":68872,"_29138":68610,"_20209":116044,"_5":13819,"_26493":115428,"_2816":116045},[],"**Síntoma:** El estado de un certificado no se sincroniza con AWS tras una revocación.",{"_3328":68873,"_29138":68610,"_20209":116047,"_5":13819,"_26493":115428,"_2816":116048},[],"**Causa:** Lo más habitual es que el certificado fue aprovisionado en modo JITP. Los certificados JITP no tienen la clave de metadatos del conector y quedan fuera del mecanismo de sincronización de estado. Si el DMS está en modo `auto`, puede indicar que el aprovisionamiento inicial no completó correctamente y el ARN de AWS no se almacenó en los metadatos del certificado.",{"_3328":68874,"_29138":68610,"_20209":116050,"_5":13819,"_26493":115428,"_2816":116051},[],"**Resolución:** Para certificados JITP, migrar el DMS a modo `auto` y re-aprovisionar los dispositivos afectados. Para certificados en modo `auto`, verificar que el certificado tiene el ARN de AWS almacenado en sus metadatos; si no lo tiene, repetir el aprovisionamiento.",{"_3328":68875,"_29138":68610,"_20209":116053,"_5":13819,"_26493":115428,"_2816":116054},[],"**Síntoma:** La desconexión forzada no termina la sesión MQTT del dispositivo tras la revocación.",{"_3328":68876,"_29138":68610,"_20209":116056,"_5":13819,"_26493":115428,"_2816":116057},[],"**Causa:** El dispositivo usa un client ID MQTT diferente al CN del certificado. La desconexión forzada abre una conexión usando el CN como client ID; si el firmware usa otro identificador, la desconexión no afecta a esa sesión.",{"_3328":68877,"_29138":68610,"_20209":116059,"_5":13819,"_26493":115428,"_2816":116060},[],"**Resolución:** Asegurarse de que el firmware usa exactamente el CN del certificado como identificador de cliente MQTT. Ese CN coincide con el ThingName en AWS IoT Core.",{"_3328":68878,"_29138":68610,"_20209":116062,"_5":13819,"_26493":115428,"_2816":116063},[],"**Síntoma:** El dispositivo recibe `CLIENT_ID_REJECTED` al conectarse a AWS IoT Core.",{"_3328":68879,"_29138":68610,"_20209":116065,"_5":13819,"_26493":115428,"_2816":116066},[],"**Causa:** El client ID MQTT no coincide con el ThingName, que es siempre el CN del certificado emitido por Lamassu.",{"_3328":68880,"_29138":68610,"_20209":116068,"_5":13819,"_26493":115428,"_2816":116069},[],"**Resolución:** Verificar que el firmware usa exactamente el valor del campo CN incluido en el CSR de enrolamiento como identificador de cliente MQTT.",{"_3328":68881,"_29138":68610,"_20209":116071,"_5":13819,"_26493":115428,"_2816":116072},[],"**Síntoma:** La primera conexión MQTT del dispositivo en modo JITP falla o excede el tiempo de espera.",{"_3328":68882,"_29138":68610,"_20209":116074,"_5":13819,"_26493":115428,"_2816":116075},[],"**Causa:** Es el comportamiento esperado mientras AWS ejecuta la plantilla JITP en la primera conexión del dispositivo.",{"_3328":68883,"_29138":68610,"_20209":116077,"_5":13819,"_26493":115428,"_2816":116078},[],"**Resolución:** El firmware debe implementar reintentos con backoff exponencial para la primera conexión. Si el fallo persiste más allá de unos minutos, verificar que el rol IAM configurado en `jitp_config.provisioning_role_arn` existe en la cuenta y tiene permisos para crear Things, registrar certificados y adjuntar políticas.",{"_3328":68884,"_29138":68610,"_20209":116080,"_5":13819,"_26493":115428,"_2816":116081},[],"**Síntoma:** El Device Shadow no se actualiza cuando debería.",{"_3328":68885,"_29138":68610,"_20209":116083,"_5":13819,"_26493":115428,"_2816":116084},[],"**Causa:** La función de shadow está desactivada en la configuración del DMS, las credenciales del conector carecen de permisos sobre la API de datos de IoT, o el firmware lee un shadow diferente al configurado.",{"_3328":68886,"_29138":68610,"_20209":116086,"_5":13819,"_26493":115428,"_2816":116087},[],"**Resolución:** Comprobar que `shadow_config.enable` está a `true` en los metadatos del conector para el DMS correspondiente. Si se usa Named Shadow, verificar que `shadow_config.shadow_name` contiene el nombre correcto y que el firmware lee ese Named Shadow y no el Classic Shadow. Confirmar que las credenciales del conector tienen permisos `iotdata:GetThingShadow` y `iotdata:UpdateThingShadow`.",{"_3328":68887,"_29138":68610,"_20209":116089,"_5":13819,"_26493":115428,"_2816":116090},[],"**Síntoma:** Tras editar un DMS en modo `jitp`, aparecen mensajes de actualización del DMS en `lamassu-dlq`, o los cambios de configuración JITP no tienen efecto en AWS.",{"_3328":68888,"_29138":68610,"_20209":116092,"_5":13819,"_26493":115428,"_2816":116093},[],"**Causa:** Cada edición completa del DMS (`PUT /v1/dms/{id}`) dispara un nuevo intento de `CreateProvisioningTemplate` para la plantilla nombrada con el ID del DMS, y la llamada no es idempotente: cuando la plantilla ya existe, falla, el evento se reintenta tres veces y acaba en `lamassu-dlq`. Se omiten los pasos posteriores del conector.",{"_3328":68889,"_29138":68610,"_20209":116095,"_5":13819,"_26493":115428,"_2816":116096},[],"**Resolución:** Comprobar que la plantilla nombrada con el ID del DMS existe en AWS IoT Core y que el enrolamiento JITP funciona. Si se cambió la configuración JITP, aplicarla a mano en la plantilla de AWS.",{"_3328":68890,"_29138":68610,"_20209":116098,"_5":13819,"_26493":115428,"_2816":116099},[],"<Card title=\"Configurar un DMS\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_3328":68891,"_29138":68610,"_20209":116101,"_5":13819,"_26493":115428,"_2816":116102},[],"<Card title=\"Enrolamiento de dispositivos (EST)\" href=\"/docs/platform/iot-fleets/enrollment/overview\" />",{"_3328":68892,"_29138":68610,"_20209":116104,"_5":13819,"_26493":115428,"_2816":116105},[],"<Card title=\"Gestión de certificados\" href=\"/docs/platform/pki/certificates\" />",{"_3328":68893,"_29138":68893,"_5":14177,"_2816":49873,"_29461":116107,"_20209":116108,"_26493":68893},[47397,112910,49873],[],{"_3328":68894,"_29138":68893,"_20209":116110,"_5":13819,"_26493":68893,"_2816":116111},[],"Organiza los dispositivos y sus identidades, prepara el enrolamiento e integra consumidores.",{"_3328":68895,"_29138":68893,"_5":29458,"_20209":116113,"_26493":116114,"_2816":116115},[],"/docs/es/platform/iot-fleets/overview#empieza-aquí","Empieza aquí",{"_3328":68896,"_29138":68893,"_5":29458,"_20209":116117,"_26493":116118,"_2816":113916},[],"/docs/es/platform/iot-fleets/overview#dispositivos-e-identidades",{"_3328":68897,"_29138":68893,"_5":29458,"_20209":116120,"_26493":116121,"_2816":114091},[],"/docs/es/platform/iot-fleets/overview#enrolamiento-con-pki",{"_3328":68898,"_29138":68893,"_5":29458,"_20209":116123,"_26493":116124,"_2816":115323},[],"/docs/es/platform/iot-fleets/overview#integraciones",{"_3328":68899,"_29138":68893,"_5":29458,"_20209":116126,"_26493":116127,"_2816":116128},[],"/docs/es/platform/iot-fleets/overview#quién-prepara-cada-parte","Quién prepara cada parte",{"_3328":68900,"_29138":68893,"_20209":116130,"_5":13819,"_26493":68893,"_2816":116131},[],"IoT Fleets aplica la PKI al ciclo de vida de dispositivos: registro, obtención de identidad, renovación y retirada. Está dirigido a quien administra una población de dispositivos y a quien integra su cliente de enrolamiento o el sistema que los acepta.",{"_3328":68901,"_29138":68893,"_20209":116133,"_5":13819,"_26493":116114,"_2816":116134},[],"Sigue Enrola y conecta tu primer dispositivo para preparar un DMS, obtener la identidad desde el cliente y demostrar una conexión mTLS. El recorrido automático incluye confianza inicial, CSR y comprobación del resultado.",{"_3328":68902,"_29138":68893,"_20209":116136,"_5":13819,"_26493":116114,"_2816":116137},[],"Si necesitas comenzar con un certificado existente, utiliza Registra un dispositivo manualmente. Después podrás preparar el enrolamiento y la renovación del siguiente dispositivo.",{"_3328":68903,"_29138":68893,"_20209":116139,"_5":13819,"_26493":116118,"_2816":116140},[],"Recurso",{"_3328":68904,"_29138":68893,"_20209":116142,"_5":13819,"_26493":116118,"_2816":116143},[],"Qué representa",{"_3328":68905,"_29138":68893,"_20209":116145,"_5":13819,"_26493":116118,"_2816":116146},[],"**Dispositivo**",{"_3328":68906,"_29138":68893,"_20209":116148,"_5":13819,"_26493":116118,"_2816":116149},[],"Una entrada de inventario con identificador, DMS propietario y clasificación.",{"_3328":68907,"_29138":68893,"_20209":116151,"_5":13819,"_26493":116118,"_2816":116152},[],"**Identidad**",{"_3328":68908,"_29138":68893,"_20209":116154,"_5":13819,"_26493":116118,"_2816":116155},[],"La asociación del dispositivo con sus certificados: una versión activa y un historial.",{"_3328":68909,"_29138":68893,"_20209":116157,"_5":13819,"_26493":116118,"_2816":52226},[],{"_3328":68910,"_29138":68893,"_20209":116159,"_5":13819,"_26493":116118,"_2816":116160},[],"El servicio que configura admisión, enrolamiento, renovación y distribución de confianza.",{"_3328":68911,"_29138":68893,"_20209":116162,"_5":13819,"_26493":116118,"_2816":116163},[],"**Flota**",{"_3328":68912,"_29138":68893,"_20209":116165,"_5":13819,"_26493":116118,"_2816":116166},[],"La población que operas, representada mediante dispositivos, DMS, etiquetas y metadatos.",{"_3328":68913,"_29138":68893,"_20209":116168,"_5":13819,"_26493":116118,"_2816":116169},[],"Cada dispositivo tiene un DMS propietario. Puedes organizar una población mediante varios DMS cuando necesita políticas distintas, y utilizar etiquetas para clasificarla. «Flota» describe ese contexto operativo; los recursos que creas y consultas son DMS y dispositivos.",{"_3328":68914,"_29138":68893,"_20209":116171,"_5":13819,"_26493":116118,"_2816":116172},[],"La gestión de dispositivos reúne estados, historial de certificados y acciones sobre la identidad. Al renovar, debes conservar la relación con el dispositivo y comprobar qué certificado pasa a ser la identidad actual.",{"_3328":68915,"_29138":68893,"_20209":116174,"_5":13819,"_26493":116121,"_2816":116175},[],"Este bloque conecta las reglas PKI con el cliente del dispositivo. La preparación sigue este orden:",{"_3328":68916,"_29138":68893,"_20209":116177,"_5":13819,"_26493":116121,"_2816":116178},[],"**CA y perfil:** prepara el emisor y las reglas del certificado en PKI.",{"_3328":68917,"_29138":68893,"_20209":116180,"_5":13819,"_26493":116121,"_2816":116181},[],"**Política DMS:** define cómo se admite el dispositivo, cómo se autentican sus solicitudes y qué confianza se distribuye.",{"_3328":68918,"_29138":68893,"_20209":116183,"_5":13819,"_26493":116121,"_2816":116184},[],"**Cliente:** prepara la credencial inicial, la confianza del servidor y la generación o custodia de la clave.",{"_3328":68919,"_29138":68893,"_20209":116186,"_5":13819,"_26493":116121,"_2816":116187},[],"**Resultado:** solicita el certificado, instálalo y comprueba su asociación con el dispositivo.",{"_3328":68920,"_29138":68893,"_20209":116189,"_5":13819,"_26493":116121,"_2816":116190},[],"**Continuidad:** configura renovación, instalación del sucesor y recuperación según la política del DMS.",{"_3328":68921,"_29138":68893,"_20209":116192,"_5":13819,"_26493":116121,"_2816":116193},[],"<Card title=\"Configura el DMS\" description=\"Prepara la CA, la admisión, la autenticación y las reglas de renovación.\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_3328":68922,"_29138":68893,"_20209":116195,"_5":13819,"_26493":116121,"_2816":116196},[],"<Card title=\"Integra el cliente EST\" description=\"Consulta los endpoints, formatos y comprobaciones del dispositivo.\" href=\"/docs/platform/iot-fleets/enrollment/est-client\" />",{"_3328":68923,"_29138":68893,"_20209":116198,"_5":13819,"_26493":116124,"_2816":116199},[],"Una identidad emitida necesita un consumidor que confíe en su emisor, valide el certificado y conceda permisos al dispositivo. Prepara tanto la confianza del dispositivo en el servidor como la del servidor en el dispositivo.",{"_3328":68924,"_29138":68893,"_20209":116201,"_5":13819,"_26493":116124,"_2816":116202},[],"La guía de AWS IoT Core explica cómo utilizar la identidad en ese destino. El aprovisionamiento en Lamassu y el aprovisionamiento en el destino son decisiones distintas; revisa las condiciones del modo elegido antes de esperar sincronización de estados.",{"_3328":68925,"_29138":68893,"_20209":116204,"_5":13819,"_26493":116127,"_2816":116205},[],"Participante",{"_3328":68926,"_29138":68893,"_20209":116207,"_5":13819,"_26493":116127,"_2816":116208},[],"Responsabilidad",{"_3328":68927,"_29138":68893,"_20209":116210,"_5":13819,"_26493":116127,"_2816":116211},[],"Administrador PKI",{"_3328":68928,"_29138":68893,"_20209":116213,"_5":13819,"_26493":116127,"_2816":116214},[],"CA, perfil de emisión, cadena y publicación de revocación.",{"_3328":68929,"_29138":68893,"_20209":116216,"_5":13819,"_26493":116127,"_2816":116217},[],"Administrador del aprovisionamiento",{"_3328":68930,"_29138":68893,"_20209":116219,"_5":13819,"_26493":116127,"_2816":116220},[],"DMS, admisión, autenticación por operación e inventario.",{"_3328":68931,"_29138":68893,"_20209":116222,"_5":13819,"_26493":116127,"_2816":116223},[],"Integrador del dispositivo",{"_3328":68932,"_29138":68893,"_20209":116225,"_5":13819,"_26493":116127,"_2816":116226},[],"Credencial inicial, clave, cliente EST, confianza e instalación de certificados.",{"_3328":68933,"_29138":68893,"_20209":116228,"_5":13819,"_26493":116127,"_2816":116229},[],"Integrador del consumidor",{"_3328":68934,"_29138":68893,"_20209":116231,"_5":13819,"_26493":116127,"_2816":116232},[],"Emisores confiables, validación y permisos del dispositivo en el destino.",{"_3328":68935,"_29138":68893,"_20209":116234,"_5":13819,"_26493":116127,"_2816":116235},[],"Los permisos y la auditoría son compartidos con el resto de Plataforma. La instalación y la conectividad de la instancia se preparan en Despliegue.",{"_3328":68936,"_29138":68936,"_5":14177,"_2816":116237,"_29461":116238,"_20209":116240,"_26493":68936},"Enrola y conecta tu primer dispositivo",[47397,112910,49873,116239],"Primeros pasos",[],{"_3328":68937,"_29138":68936,"_20209":116242,"_5":13819,"_26493":68936,"_2816":116243},[],"Obtén una identidad por EST, verifica su asociación y úsala en una conexión mTLS.",{"_3328":68938,"_29138":68936,"_5":29458,"_20209":116245,"_26493":116246,"_2816":111488},[],"/docs/es/platform/iot-fleets/quickstarts/enroll-device#antes-de-empezar",{"_3328":68939,"_29138":68936,"_5":29458,"_20209":116248,"_26493":116249,"_2816":116250},[],"/docs/es/platform/iot-fleets/quickstarts/enroll-device#prepara-la-credencial-inicial","Prepara la credencial inicial",{"_3328":68940,"_29138":68936,"_5":29458,"_20209":116252,"_26493":116253,"_2816":116254},[],"/docs/es/platform/iot-fleets/quickstarts/enroll-device#configura-el-dms-de-evaluación","Configura el DMS de evaluación",{"_3328":68941,"_29138":68936,"_5":29458,"_20209":116256,"_26493":116257,"_2816":116258},[],"/docs/es/platform/iot-fleets/quickstarts/enroll-device#prepara-el-cliente-y-comprueba-cacerts","Prepara el cliente y comprueba cacerts",{"_3328":68942,"_29138":68936,"_5":29458,"_20209":116260,"_26493":116261,"_2816":116262},[],"/docs/es/platform/iot-fleets/quickstarts/enroll-device#enrola-el-dispositivo","Enrola el dispositivo",{"_3328":68943,"_29138":68936,"_5":29458,"_20209":116264,"_26493":116265,"_2816":116266},[],"/docs/es/platform/iot-fleets/quickstarts/enroll-device#verifica-la-identidad-obtenida","Verifica la identidad obtenida",{"_3328":68944,"_29138":68936,"_5":29458,"_20209":116268,"_26493":116269,"_2816":116270},[],"/docs/es/platform/iot-fleets/quickstarts/enroll-device#demuestra-una-conexión-mtls","Demuestra una conexión mTLS",{"_3328":68945,"_29138":68936,"_5":29458,"_20209":116272,"_26493":116273,"_2816":116274},[],"/docs/es/platform/iot-fleets/quickstarts/enroll-device#resultado-y-continuidad","Resultado y continuidad",{"_3328":68946,"_29138":68936,"_20209":116276,"_5":13819,"_26493":68936,"_2816":116277},[],"Prepararás un DMS de evaluación, enrolarás `est-device-001` desde el cliente y usarás su identidad frente a un consumidor local que exige certificado. El recorrido conecta la política del administrador con el material que realmente instala el dispositivo.",{"_3328":68947,"_29138":68936,"_20209":116279,"_5":13819,"_26493":116246,"_2816":116280},[],"Instancia Lamassu accesible por HTTPS y permisos para CAs, perfiles, DMS y lectura de dispositivos/certificados.",{"_3328":68948,"_29138":68936,"_20209":116282,"_5":13819,"_26493":116246,"_2816":116283},[],"Bash, OpenSSL 3.x, curl con `--fail-with-body` y dos terminales en tu equipo. Trabaja en un directorio nuevo con acceso restringido.",{"_3328":68949,"_29138":68936,"_20209":116285,"_5":13819,"_26493":116246,"_2816":116286},[],"Una CA raíz activa que emita directamente, con clave disponible y vigencia suficiente. Sigue Crea tu primera CA. Guarda su certificado público verificado como `device-root.pem`.",{"_3328":68950,"_29138":68936,"_20209":116288,"_5":13819,"_26493":116246,"_2816":116289},[],"El identificador global `est-device-001` libre. Este recorrido utiliza registro automático: no crees primero el dispositivo desde la consola.",{"_3328":68951,"_29138":68936,"_20209":116291,"_5":13819,"_26493":116246,"_2816":116292},[],"La raíz aprobada para el HTTPS de Lamassu en `est-trust.pem`, obtenida por un canal independiente. Puede ser distinta de la CA de dispositivos; prepara red/TLS en Despliegue.",{"_3328":68952,"_29138":68936,"_20209":116294,"_5":13819,"_26493":116249,"_2816":116295},[],"Emite un certificado final bootstrap con `CN=est-device-001`, clave propia y uso Client Authentication. Puedes seguir Emite y verifica un certificado, sustituyendo su CN y guardando el resultado como `bootstrap.crt` y `bootstrap.key`. Elige una validez que cubra esta prueba y comprueba la pareja y la cadena.",{"_3328":68953,"_29138":68936,"_20209":116297,"_5":13819,"_26493":116249,"_2816":116298},[],"Para esta evaluación aislada puede emitirlo la misma CA raíz. La identidad operativa tendrá una clave y un certificado distintos. El CN igual facilita la lectura del ejemplo; la autenticación inicial por certificado no vincula por sí sola el CN del bootstrap con el ID pedido. Revisa la admisión antes de aplicar la política a una población.",{"_3328":68954,"_29138":68936,"_20209":116300,"_5":13819,"_26493":116253,"_2816":116301},[],"Crea un perfil final explícito, compatible con EC P-256, con **Honor Subject**, CN de la CSR, **Digital Signature**, **Client Authentication** y una validez de **1 hora** dentro de la vigencia de la raíz. No habilites firma como CA. Las reglas y precedencia se explican en Perfiles.",{"_3328":68955,"_29138":68936,"_20209":116303,"_5":13819,"_26493":116253,"_2816":116304},[],"Crea el DMS `Acme EST Evaluation` con esta configuración:",{"_3328":68956,"_29138":68936,"_20209":116306,"_5":13819,"_26493":116253,"_2816":116307},[],"Ajuste",{"_3328":68957,"_29138":68936,"_20209":116309,"_5":13819,"_26493":116253,"_2816":116310},[],"Valor de evaluación",{"_3328":68958,"_29138":68936,"_20209":116312,"_5":13819,"_26493":116253,"_2816":52382},[],{"_3328":68959,"_29138":68936,"_20209":116314,"_5":13819,"_26493":116253,"_2816":116315},[],"Raíz emisora de `device-root.pem`.",{"_3328":68960,"_29138":68936,"_20209":116317,"_5":13819,"_26493":116253,"_2816":114219},[],{"_3328":68961,"_29138":68936,"_20209":116319,"_5":13819,"_26493":116253,"_2816":116320},[],"Perfil final de 1 hora que acabas de preparar.",{"_3328":68962,"_29138":68936,"_20209":116322,"_5":13819,"_26493":116253,"_2816":52393},[],{"_3328":68963,"_29138":68936,"_20209":116324,"_5":13819,"_26493":116253,"_2816":52396},[],{"_3328":68964,"_29138":68936,"_20209":116326,"_5":13819,"_26493":116253,"_2816":52399},[],{"_3328":68965,"_29138":68936,"_20209":116328,"_5":13819,"_26493":116253,"_2816":116329},[],"Habilitado.",{"_3328":68966,"_29138":68936,"_20209":116331,"_5":13819,"_26493":116253,"_2816":52405},[],{"_3328":68967,"_29138":68936,"_20209":116333,"_5":13819,"_26493":116253,"_2816":116334},[],"Deshabilitado; el ID debe ser nuevo.",{"_3328":68968,"_29138":68936,"_20209":116336,"_5":13819,"_26493":116253,"_2816":116337},[],"Autenticación inicial",{"_3328":68969,"_29138":68936,"_20209":116339,"_5":13819,"_26493":116253,"_2816":116340},[],"`CLIENT_CERTIFICATE`; Validation CAs incluye el emisor directo del bootstrap; no aceptar vencidos.",{"_3328":68970,"_29138":68936,"_20209":116342,"_5":13819,"_26493":116253,"_2816":116343},[],"Autenticación de renovación",{"_3328":68971,"_29138":68936,"_20209":116345,"_5":13819,"_26493":116253,"_2816":116346},[],"`CLIENT_CERTIFICATE`, configurada en el bloque independiente de re-enrollment.",{"_3328":68972,"_29138":68936,"_20209":116348,"_5":13819,"_26493":116253,"_2816":52423},[],{"_3328":68973,"_29138":68936,"_20209":116350,"_5":13819,"_26493":116253,"_2816":116351},[],"No se necesitan para esta emisión directa; la CA de enrolamiento siempre es confiable en el reenrolamiento / deshabilitado.",{"_3328":68974,"_29138":68936,"_20209":116353,"_5":13819,"_26493":116253,"_2816":52429},[],{"_3328":68975,"_29138":68936,"_20209":116355,"_5":13819,"_26493":116253,"_2816":116356},[],"1 hora.",{"_3328":68976,"_29138":68936,"_20209":116358,"_5":13819,"_26493":116253,"_2816":52435},[],{"_3328":68977,"_29138":68936,"_20209":116360,"_5":13819,"_26493":116253,"_2816":116361},[],"30 minutos / 10 minutos.",{"_3328":68978,"_29138":68936,"_20209":116363,"_5":13819,"_26493":116253,"_2816":52441},[],{"_3328":68979,"_29138":68936,"_20209":116365,"_5":13819,"_26493":116253,"_2816":116366},[],"Deshabilitado para probar el sucesor antes de retirar el anterior.",{"_3328":68980,"_29138":68936,"_20209":116368,"_5":13819,"_26493":116253,"_2816":50192},[],{"_3328":68981,"_29138":68936,"_20209":116370,"_5":13819,"_26493":116253,"_2816":116371},[],"Deshabilitado; la clave operativa se genera en el cliente.",{"_3328":68982,"_29138":68936,"_20209":116373,"_5":13819,"_26493":116253,"_2816":52452},[],{"_3328":68983,"_29138":68936,"_20209":116375,"_5":13819,"_26493":116253,"_2816":116376},[],"Include Enrollment CA habilitado; Include Lamassu System CA deshabilitado.",{"_3328":68984,"_29138":68936,"_20209":116378,"_5":13819,"_26493":116253,"_2816":116379},[],"La duración y ventana iguales permiten probar renovación inmediatamente. Son valores de evaluación; dimensiona producción según conectividad y tiempos de recuperación. Guarda, vuelve a leer los dos bloques de autenticación y conserva el ID del DMS. La consola expone editores independientes para la autenticación de enrolamiento y de reenrolamiento; la guía DMS describe sus campos, y también puedes comprobar el recurso mediante la API DMS.",{"_3328":68985,"_29138":68936,"_20209":116381,"_5":13819,"_26493":116257,"_2816":116382},[],"En el directorio nuevo, coloca los cuatro archivos de confianza y bootstrap. Sustituye el URL por el de tu instalación:",{"_3328":68986,"_29138":68936,"_20209":116384,"_5":13819,"_26493":116257,"_2816":116385},[],"La descarga debe ser satisfactoria y contener la raíz de enrolamiento prevista. Compara su huella con `device-root.pem`. Esta comprobación no convierte la respuesta en confianza inicial ni demuestra que puedas emitir.",{"_3328":68987,"_29138":68936,"_20209":116387,"_5":13819,"_26493":116261,"_2816":116388},[],"Genera una clave nueva y una CSR con el identificador elegido:",{"_3328":68988,"_29138":68936,"_20209":116390,"_5":13819,"_26493":116261,"_2816":116391},[],"Solicita la identidad con la credencial inicial y extrae el certificado de la respuesta predeterminada:",{"_3328":68989,"_29138":68936,"_20209":116393,"_5":13819,"_26493":116261,"_2816":116394},[],"Si curl falla, consulta Diagnóstico con el cuerpo guardado. No ejecutes la conversión ni repitas la solicitud sin consultar el inventario: un timeout o error puede seguir a una emisión persistida.",{"_3328":68990,"_29138":68936,"_20209":116396,"_5":13819,"_26493":116265,"_2816":116397},[],"Espera `device.crt: OK` y código 0 de `cmp`. Comprueba CN, serie, fechas, Digital Signature y Client Authentication. El certificado debe ser final: no declarar `CA:TRUE` ni uso Certificate Sign. Revisa que su validez corresponda al perfil de una hora.",{"_3328":68991,"_29138":68936,"_20209":116399,"_5":13819,"_26493":116265,"_2816":116400},[],"En Lamassu, abre `est-device-001`. Debe estar creado con el DMS propietario previsto, una identidad actual y el certificado recibido en su historial. Compara la serie local con la del slot; los umbrales pueden mostrar un estado de renovación en vez de un simple Active.",{"_3328":68992,"_29138":68936,"_20209":116402,"_5":13819,"_26493":116269,"_2816":116403},[],"En una segunda terminal, entra en el mismo directorio y ejecuta `umask 077`. Crea un certificado local de servidor y arranca un consumidor de prueba. Este servidor confía en `device-root.pem` y exige una identidad cliente válida:",{"_3328":68993,"_29138":68936,"_20209":116405,"_5":13819,"_26493":116269,"_2816":116406},[],"Déjalo funcionando. En la primera terminal, realiza la conexión con la identidad obtenida:",{"_3328":68994,"_29138":68936,"_20209":116408,"_5":13819,"_26493":116269,"_2816":116409},[],"Espera HTTP `200`. La confianza del cliente en este servidor local es su certificado autofirmado `consumer.crt`; el servidor verifica al dispositivo contra `device-root.pem`. El archivo HTML muestra información de diagnóstico de OpenSSL.",{"_3328":68995,"_29138":68936,"_20209":116411,"_5":13819,"_26493":116269,"_2816":116412},[],"Con el mismo servidor todavía funcionando, prueba que una solicitud sin certificado cliente se rechaza:",{"_3328":68996,"_29138":68936,"_20209":116414,"_5":13819,"_26493":116269,"_2816":116415},[],"El rechazo debe corresponder a la falta de certificado en el servidor, no a un servidor detenido. Termina el consumidor con Ctrl+C después de la prueba. Este ejercicio demuestra autenticación TLS y posesión de la clave; tu aplicación debe definir además autorización y consumo de revocación. Las opciones del servidor se describen en openssl-s\\_server.",{"_3328":68997,"_29138":68936,"_20209":116417,"_5":13819,"_26493":116273,"_2816":116418},[],"Comprobación",{"_3328":68998,"_29138":68936,"_20209":116420,"_5":13819,"_26493":116273,"_2816":116421},[],"Resultado esperado",{"_3328":68999,"_29138":68936,"_20209":116423,"_5":13819,"_26493":116273,"_2816":116424},[],"Registro",{"_3328":69000,"_29138":68936,"_20209":116426,"_5":13819,"_26493":116273,"_2816":116427},[],"ID creado automáticamente y DMS correcto.",{"_3328":69001,"_29138":68936,"_20209":116429,"_5":13819,"_26493":116273,"_2816":115711},[],{"_3328":69002,"_29138":68936,"_20209":116431,"_5":13819,"_26493":116273,"_2816":116432},[],"CN, perfil, serie y clave verificados.",{"_3328":69003,"_29138":68936,"_20209":116434,"_5":13819,"_26493":116273,"_2816":116435},[],"Inventario",{"_3328":69004,"_29138":68936,"_20209":116437,"_5":13819,"_26493":116273,"_2816":116438},[],"Serie recibida visible como identidad actual y en el historial.",{"_3328":69005,"_29138":68936,"_20209":116440,"_5":13819,"_26493":116273,"_2816":116441},[],"Consumidor",{"_3328":69006,"_29138":68936,"_20209":116443,"_5":13819,"_26493":116273,"_2816":116444},[],"mTLS responde 200 con la identidad y rechaza falta de certificado.",{"_3328":69007,"_29138":68936,"_20209":116446,"_5":13819,"_26493":116273,"_2816":116447},[],"Continúa con Renovación y recuperación para solicitar una pareja sucesora dentro de la ventana, instalarla y repetir la comprobación mTLS. El consumidor debe utilizar los archivos nuevos en esa prueba. Después de comprobar el sucesor, retira el certificado anterior según la política PKI; el ejemplo no lo revoca automáticamente.",{"_3328":69008,"_29138":68936,"_20209":116449,"_5":13819,"_26493":116273,"_2816":116450},[],"Dispositivos e identidades explica la retirada y los límites de revocación del historial. Para un destino real, prepara confianza, validación y permisos del consumidor; AWS IoT Core es una integración disponible.",{"_3328":69009,"_29138":69009,"_5":14177,"_2816":113933,"_29461":116452,"_20209":116453,"_26493":69009},[47397,112910,49873,116239],[],{"_3328":69010,"_29138":69009,"_20209":116455,"_5":13819,"_26493":69009,"_2816":116456},[],"Prepara un DMS, registra un dispositivo y asocia un certificado comprobado a su identidad.",{"_3328":69011,"_29138":69009,"_5":29458,"_20209":116458,"_26493":116459,"_2816":111488},[],"/docs/es/platform/iot-fleets/quickstarts/register-device#antes-de-empezar",{"_3328":69012,"_29138":69009,"_5":29458,"_20209":116461,"_26493":116462,"_2816":116463},[],"/docs/es/platform/iot-fleets/quickstarts/register-device#prepara-el-dms","Prepara el DMS",{"_3328":69013,"_29138":69009,"_5":29458,"_20209":116465,"_26493":116466,"_2816":116467},[],"/docs/es/platform/iot-fleets/quickstarts/register-device#registra-el-dispositivo","Registra el dispositivo",{"_3328":69014,"_29138":69009,"_5":29458,"_20209":116469,"_26493":116470,"_2816":116471},[],"/docs/es/platform/iot-fleets/quickstarts/register-device#comprueba-el-estado-inicial","Comprueba el estado inicial",{"_3328":69015,"_29138":69009,"_5":29458,"_20209":116473,"_26493":116474,"_2816":116475},[],"/docs/es/platform/iot-fleets/quickstarts/register-device#asigna-una-identidad","Asigna una identidad",{"_3328":69016,"_29138":69009,"_5":29458,"_20209":116477,"_26493":116478,"_2816":116479},[],"/docs/es/platform/iot-fleets/quickstarts/register-device#verifica-el-dispositivo","Verifica el dispositivo",{"_3328":69017,"_29138":69009,"_5":29458,"_20209":116481,"_26493":116482,"_2816":116421},[],"/docs/es/platform/iot-fleets/quickstarts/register-device#resultado-esperado",{"_3328":69018,"_29138":69009,"_5":29458,"_20209":116484,"_26493":116485,"_2816":116486},[],"/docs/es/platform/iot-fleets/quickstarts/register-device#si-el-resultado-falla","Si el resultado falla",{"_3328":69019,"_29138":69009,"_5":29458,"_20209":116488,"_26493":116489,"_2816":116490},[],"/docs/es/platform/iot-fleets/quickstarts/register-device#automatiza-el-siguiente-dispositivo","Automatiza el siguiente dispositivo",{"_3328":69020,"_29138":69009,"_20209":116492,"_5":13819,"_26493":69009,"_2816":116493},[],"Este recorrido está dirigido a quien empieza a administrar identidades de dispositivos. Registrarás `device-001` y le asignarás un certificado existente para comprobar la relación entre dispositivo, DMS e historial de identidad.",{"_3328":69021,"_29138":69009,"_20209":116495,"_5":13819,"_26493":69009,"_2816":116496},[],"La asignación modifica el inventario de Lamassu. La clave y el certificado se instalan por separado en el dispositivo; la conexión con un consumidor se comprueba en la integración de ese destino.",{"_3328":69022,"_29138":69009,"_20209":116498,"_5":13819,"_26493":116459,"_2816":116499},[],"Una instancia accesible y permisos para administrar DMS, dispositivos y la asociación de certificados.",{"_3328":69023,"_29138":69009,"_20209":116501,"_5":13819,"_26493":116459,"_2816":116502},[],"Una CA activa con clave disponible. Si todavía no existe, sigue Crea tu primera CA.",{"_3328":69024,"_29138":69009,"_20209":116504,"_5":13819,"_26493":116459,"_2816":116505},[],"Un certificado final activo de esa CA cuyo `Common Name` sea exactamente `device-001`, con su clave privada. Sigue Emite y verifica un certificado para obtener y comprobar ambos.",{"_3328":69025,"_29138":69009,"_20209":116507,"_5":13819,"_26493":116459,"_2816":116508},[],"El identificador `device-001` libre en el inventario. Si ya lo usaste, elige otro y emite el certificado con ese mismo `Common Name`.",{"_3328":69026,"_29138":69009,"_20209":116510,"_5":13819,"_26493":116462,"_2816":116511},[],"Un DMS debe existir antes de registrar el dispositivo. Si ya tienes uno adecuado, comprueba su CA y anota su identificador; si necesitas crearlo:",{"_3328":69027,"_29138":69009,"_20209":116513,"_5":13819,"_26493":116462,"_2816":116514},[],"Abre el inventario de DMS y la acción de creación. Asigna un nombre reconocible, como `Acme Evaluation DMS`.",{"_3328":69028,"_29138":69009,"_20209":116516,"_5":13819,"_26493":116462,"_2816":116517},[],"En **Enrollment CA**, selecciona la CA que emitió `device.crt`.",{"_3328":69029,"_29138":69009,"_20209":116519,"_5":13819,"_26493":116462,"_2816":116520},[],"En **Registration Mode**, selecciona `PRE_REGISTRATION` para el recorrido que comienza con un alta explícita.",{"_3328":69030,"_29138":69009,"_20209":116522,"_5":13819,"_26493":116462,"_2816":116523},[],"En la sección de autenticación, activa **Require client certificate** y deja **Call external webhook** desactivado. Bajo **Require client certificate**, añade a **Validation CAs** la CA cuyos certificados iniciales aceptarás; para esta evaluación puede ser la misma CA. Mantén habilitada **Verify CSR Signature** y deja **Enable server-side key generation** desactivado si no lo vas a utilizar.",{"_3328":69031,"_29138":69009,"_20209":116525,"_5":13819,"_26493":116462,"_2816":116526},[],"Revisa los ajustes de renovación y distribución de confianza con la guía DMS, guarda el servicio y anota su identificador.",{"_3328":69032,"_29138":69009,"_20209":116528,"_5":13819,"_26493":116462,"_2816":116529},[],"Vuelve a abrir el DMS y confirma que la CA de enrolamiento es la prevista y que el servicio aparece en el inventario.",{"_3328":69033,"_29138":69009,"_20209":116531,"_5":13819,"_26493":116462,"_2816":116532},[],"Estos ajustes preparan la política DMS. Los pasos siguientes realizan el alta y la asignación desde la consola; no envían una solicitud EST ni prueban la admisión por ese protocolo.",{"_3328":69034,"_29138":69009,"_20209":116534,"_5":13819,"_26493":116466,"_2816":116535},[],"Abre **Managed Devices** y la acción de registro. Completa:",{"_3328":69035,"_29138":69009,"_20209":116537,"_5":13819,"_26493":116466,"_2816":52617},[],{"_3328":69036,"_29138":69009,"_20209":116539,"_5":13819,"_26493":116466,"_2816":116540},[],"**Registration Authority**: el DMS que acabas de preparar; la etiqueta identifica al servicio que cumple el rol de autoridad de registro.",{"_3328":69037,"_29138":69009,"_20209":116542,"_5":13819,"_26493":116466,"_2816":116543},[],"**Icon** y **Tags**: clasificación opcional.",{"_3328":69038,"_29138":69009,"_20209":116545,"_5":13819,"_26493":116466,"_2816":116546},[],"Confirma el registro.",{"_3328":69039,"_29138":69009,"_20209":116548,"_5":13819,"_26493":116470,"_2816":116549},[],"Abre el dispositivo. Debe aparecer en **No Identity** y mostrar el DMS propietario seleccionado.",{"_3328":69040,"_29138":69009,"_20209":116551,"_5":13819,"_26493":116470,"_2816":116552},[],"El registro crea la entrada de inventario; el certificado todavía debe asociarse.",{"_3328":69041,"_29138":69009,"_20209":116554,"_5":13819,"_26493":116474,"_2816":116555},[],"Selecciona **Assign Identity** y el certificado existente con `CN=device-001`. Comprueba su número de serie, emisor y vigencia frente al certificado que verificaste en PKI.",{"_3328":69042,"_29138":69009,"_20209":116557,"_5":13819,"_26493":116474,"_2816":116558},[],"Confirma la asociación. La alternativa **Issue New Instead** se explica en Dispositivos e identidades.",{"_3328":69043,"_29138":69009,"_20209":116560,"_5":13819,"_26493":116478,"_2816":116561},[],"Comprueba que tiene una identidad activa. En **Certificate History**, verifica el número de serie asociado; en **Device Event Timeline**, localiza el evento de asignación.",{"_3328":69044,"_29138":69009,"_20209":116563,"_5":13819,"_26493":116478,"_2816":116564},[],"Conserva el identificador del dispositivo, el DMS propietario y el número de serie como referencias del resultado.",{"_3328":69045,"_29138":69009,"_20209":116566,"_5":13819,"_26493":116482,"_2816":116418},[],{"_3328":69046,"_29138":69009,"_20209":116568,"_5":13819,"_26493":116482,"_2816":116569},[],"Resultado",{"_3328":69047,"_29138":69009,"_20209":116571,"_5":13819,"_26493":116482,"_2816":115697},[],{"_3328":69048,"_29138":69009,"_20209":116573,"_5":13819,"_26493":116482,"_2816":116574},[],"`device-001` aparece en el inventario con el DMS previsto.",{"_3328":69049,"_29138":69009,"_20209":116576,"_5":13819,"_26493":116482,"_2816":116577},[],"Identidad actual",{"_3328":69050,"_29138":69009,"_20209":116579,"_5":13819,"_26493":116482,"_2816":116580},[],"El certificado asociado coincide con el que verificaste en PKI.",{"_3328":69051,"_29138":69009,"_20209":116582,"_5":13819,"_26493":116482,"_2816":116583},[],"Historial",{"_3328":69052,"_29138":69009,"_20209":116585,"_5":13819,"_26493":116482,"_2816":116586},[],"La emisión asociada aparece con su número de serie y fechas.",{"_3328":69053,"_29138":69009,"_20209":116588,"_5":13819,"_26493":116482,"_2816":116589},[],"Clave y certificado",{"_3328":69054,"_29138":69009,"_20209":116591,"_5":13819,"_26493":116482,"_2816":116592},[],"Dispones de la pareja comprobada para instalarla en el dispositivo.",{"_3328":69055,"_29138":69009,"_20209":116594,"_5":13819,"_26493":116485,"_2816":116595},[],"Si el DMS no puede seleccionarse, confirma su creación y tus permisos de lectura.",{"_3328":69056,"_29138":69009,"_20209":116597,"_5":13819,"_26493":116485,"_2816":116598},[],"Si no aparece un certificado elegible, comprueba que su `Common Name` coincide exactamente con el `Device ID`, está activo y lo emitió la CA prevista.",{"_3328":69057,"_29138":69009,"_20209":116600,"_5":13819,"_26493":116485,"_2816":116601},[],"Si falla la asignación, revisa los permisos y el diagnóstico de la operación antes de repetirla. Vuelve a consultar el dispositivo y su historial para conocer el resultado persistido.",{"_3328":69058,"_29138":69009,"_20209":116603,"_5":13819,"_26493":116485,"_2816":116604},[],"Si aparece un estado relacionado con vencimiento o renovación, comprueba las fechas del certificado y los umbrales del DMS en Dispositivos e identidades.",{"_3328":69059,"_29138":69009,"_20209":116606,"_5":13819,"_26493":116489,"_2816":116607},[],"Continúa con DMS y EST para que el dispositivo solicite y renueve sus certificados. Prepara la confianza del servidor, la credencial inicial y las políticas de cada operación antes de implementar el cliente.",{"_3328":69060,"_29138":69009,"_20209":116609,"_5":13819,"_26493":116489,"_2816":116610},[],"Para un recorrido desde el cliente hasta mTLS, sigue Enrola y conecta tu primer dispositivo con un ID nuevo.",{"_3328":69061,"_29138":69009,"_20209":116612,"_5":13819,"_26493":116489,"_2816":116613},[],"Para utilizar la identidad en AWS IoT Core, prepara también la confianza y los permisos del destino. Comprueba la conexión desde el dispositivo después de instalar la clave, el certificado y la cadena necesarios.",{"_3328":69062,"_29138":69062,"_5":14177,"_2816":116615,"_29461":116616,"_20209":116617,"_26493":69062},"Plataforma Lamassu IoT",[47397,112910],[],{"_3328":69063,"_29138":69062,"_20209":116619,"_5":13819,"_26493":69062,"_2816":116620},[],"Construye una PKI y aplica sus certificados al ciclo de vida de tus dispositivos.",{"_3328":69064,"_29138":69062,"_5":29458,"_20209":116622,"_26493":116623,"_2816":116115},[],"/docs/es/platform/overview#empieza-aquí",{"_3328":69065,"_29138":69062,"_5":29458,"_20209":116625,"_26493":116626,"_2816":116627},[],"/docs/es/platform/overview#elige-tu-recorrido","Elige tu recorrido",{"_3328":69066,"_29138":69062,"_5":29458,"_20209":116629,"_26493":116630,"_2816":116631},[],"/docs/es/platform/overview#arquitectura-de-un-vistazo","Arquitectura de un vistazo",{"_3328":69067,"_29138":69062,"_5":29458,"_20209":116633,"_26493":116634,"_2816":116635},[],"/docs/es/platform/overview#capacidades-principales","Capacidades principales",{"_3328":69068,"_29138":69062,"_5":29458,"_20209":116637,"_26493":116638,"_2816":116639},[],"/docs/es/platform/overview#construye-tu-jerarquía-de-confianza","Construye tu jerarquía de confianza",{"_3328":69069,"_29138":69062,"_5":29458,"_20209":116641,"_26493":116642,"_2816":116643},[],"/docs/es/platform/overview#protege-las-claves-criptográficas","Protege las claves criptográficas",{"_3328":69070,"_29138":69062,"_5":29458,"_20209":116645,"_26493":116646,"_2816":116647},[],"/docs/es/platform/overview#emite-y-controla-certificados","Emite y controla certificados",{"_3328":69071,"_29138":69062,"_5":29458,"_20209":116649,"_26493":116650,"_2816":116651},[],"/docs/es/platform/overview#automatiza-identidades-de-dispositivos","Automatiza identidades de dispositivos",{"_3328":69072,"_29138":69062,"_5":29458,"_20209":116653,"_26493":116654,"_2816":116655},[],"/docs/es/platform/overview#publica-el-estado-de-validación","Publica el estado de validación",{"_3328":69073,"_29138":69062,"_5":29458,"_20209":116657,"_26493":116658,"_2816":116659},[],"/docs/es/platform/overview#reacciona-a-los-eventos","Reacciona a los eventos",{"_3328":69074,"_29138":69062,"_5":29458,"_20209":116661,"_26493":116662,"_2816":116663},[],"/docs/es/platform/overview#referencia-operativa","Referencia operativa",{"_3328":69075,"_29138":69062,"_20209":116665,"_5":13819,"_26493":69062,"_2816":116666},[],"Lamassu IoT permite administrar una PKI privada y utilizarla para emitir, renovar y revocar identidades X.509 de dispositivos. La documentación de Plataforma sigue dos recorridos: **PKI**, para gestionar las autoridades y los certificados, e **IoT Fleets**, para aplicar esas identidades a una población de dispositivos.",{"_3328":69076,"_29138":69062,"_20209":116668,"_5":13819,"_26493":116623,"_2816":116669},[],"Elige el resultado que necesitas obtener:",{"_3328":69077,"_29138":69062,"_20209":116671,"_5":13819,"_26493":116623,"_2816":116672},[],"<Card title=\"Emitir y verificar un certificado\" description=\"Prepara una CA, emite una identidad X.509 y comprueba su cadena y su clave.\" href=\"/docs/platform/pki/quickstarts/overview\" />",{"_3328":69078,"_29138":69062,"_20209":116674,"_5":13819,"_26493":116623,"_2816":116675},[],"<Card title=\"Enrolar y conectar un dispositivo\" description=\"Prepara el DMS, solicita la identidad por EST y comprueba una conexión mTLS.\" href=\"/docs/platform/iot-fleets/quickstarts/enroll-device\" />",{"_3328":69079,"_29138":69062,"_20209":116677,"_5":13819,"_26493":116623,"_2816":116678},[],"Si todavía estás preparando la instancia, empieza en Despliegue. Los recorridos de Plataforma parten de una consola accesible y de permisos para realizar las operaciones.",{"_3328":69080,"_29138":69062,"_20209":116680,"_5":13819,"_26493":116626,"_2816":116681},[],"Bloque",{"_3328":69081,"_29138":69062,"_20209":116683,"_5":13819,"_26493":116626,"_2816":116684},[],"Qué gestionas",{"_3328":69082,"_29138":69062,"_20209":116686,"_5":13819,"_26493":116626,"_2816":116687},[],"Punto de entrada",{"_3328":69083,"_29138":69062,"_20209":116689,"_5":13819,"_26493":116626,"_2816":52770},[],{"_3328":69084,"_29138":69062,"_20209":116691,"_5":13819,"_26493":116626,"_2816":116692},[],"Claves, autoridades, perfiles, certificados y publicación del estado de revocación.",{"_3328":69085,"_29138":69062,"_20209":116694,"_5":13819,"_26493":116626,"_2816":116695},[],"Visión general de PKI",{"_3328":69086,"_29138":69062,"_20209":116697,"_5":13819,"_26493":116626,"_2816":52779},[],{"_3328":69087,"_29138":69062,"_20209":116699,"_5":13819,"_26493":116626,"_2816":116700},[],"Dispositivos, historial de identidad, políticas DMS, enrolamiento EST e integraciones.",{"_3328":69088,"_29138":69062,"_20209":116702,"_5":13819,"_26493":116626,"_2816":116703},[],"Visión general de IoT Fleets",{"_3328":69089,"_29138":69062,"_20209":116705,"_5":13819,"_26493":116626,"_2816":116706},[],"**Administración**",{"_3328":69090,"_29138":69062,"_20209":116708,"_5":13819,"_26493":116626,"_2816":116709},[],"Permisos de operadores, auditoría y suscripciones a eventos.",{"_3328":69091,"_29138":69062,"_20209":116711,"_5":13819,"_26493":116626,"_2816":112908},[],{"_3328":69092,"_29138":69062,"_20209":116713,"_5":13819,"_26493":116626,"_2816":116714},[],"Una CA determina quién firma y un perfil establece qué puede emitirse. El DMS aplica la política de admisión y enrolamiento. El dispositivo conserva la asociación con sus certificados, y el consumidor externo decide qué identidad acepta.",{"_3328":69093,"_29138":69062,"_20209":116716,"_5":13819,"_26493":116630,"_2816":116717},[],"El recorrido de una identidad conecta cuatro responsabilidades:",{"_3328":69094,"_29138":69062,"_20209":116719,"_5":13819,"_26493":116630,"_2816":116720},[],"El administrador PKI prepara la autoridad, su clave y las reglas de emisión.",{"_3328":69095,"_29138":69062,"_20209":116722,"_5":13819,"_26493":116630,"_2816":116723},[],"El administrador del aprovisionamiento configura el DMS y la confianza inicial.",{"_3328":69096,"_29138":69062,"_20209":116725,"_5":13819,"_26493":116630,"_2816":116726},[],"El cliente del dispositivo solicita un certificado y lo instala junto con la clave que le corresponde.",{"_3328":69097,"_29138":69062,"_20209":116728,"_5":13819,"_26493":116630,"_2816":116729},[],"El consumidor valida la identidad y aplica sus permisos de acceso.",{"_3328":69098,"_29138":69062,"_20209":116731,"_5":13819,"_26493":116630,"_2816":116732},[],"Consulta Cómo funciona Lamassu para entender los recursos y la arquitectura de la plataforma para conocer los servicios. La instalación, la exposición de red y las dependencias se explican en Despliegue.",{"_3328":69099,"_29138":69062,"_20209":116734,"_5":13819,"_26493":116638,"_2816":116735},[],"Crea o incorpora autoridades y organiza sus relaciones en PKI. La jerarquía y su rotación determinan qué cadenas deberán reconocer los consumidores.",{"_3328":69100,"_29138":69062,"_20209":116737,"_5":13819,"_26493":116642,"_2816":116738},[],"Elige el motor que custodiará las claves de las autoridades y controla quién puede utilizarlas. Consulta Claves y motores; la preparación del proveedor forma parte del despliegue.",{"_3328":69101,"_29138":69062,"_20209":116740,"_5":13819,"_26493":116646,"_2816":116741},[],"Define perfiles de emisión, firma solicitudes y consulta el inventario de certificados. El certificado emitido debe comprobarse desde el cliente que lo utilizará.",{"_3328":69102,"_29138":69062,"_20209":116743,"_5":13819,"_26493":116650,"_2816":116744},[],"Configura un DMS y utiliza EST para solicitar y renovar certificados. La preparación de la credencial inicial y la instalación del resultado pertenecen a la integración del dispositivo.",{"_3328":69103,"_29138":69062,"_20209":116746,"_5":13819,"_26493":116654,"_2816":116747},[],"Utiliza OCSP y CRL para publicar el estado de revocación. Cada consumidor debe configurar cómo consulta y aplica esa información.",{"_3328":69104,"_29138":69062,"_20209":116749,"_5":13819,"_26493":116658,"_2816":116750},[],"Consulta auditoría para investigar cambios y configura alertas y suscripciones para reaccionar a eventos del ciclo de vida.",{"_3328":69105,"_29138":69062,"_20209":116752,"_5":13819,"_26493":116662,"_2816":116208},[],{"_3328":69106,"_29138":69062,"_20209":116754,"_5":13819,"_26493":116662,"_2816":116755},[],"Qué prepara o comprueba",{"_3328":69107,"_29138":69062,"_20209":116757,"_5":13819,"_26493":116662,"_2816":116211},[],{"_3328":69108,"_29138":69062,"_20209":116759,"_5":13819,"_26493":116662,"_2816":116760},[],"Custodia de claves, jerarquía de CAs, perfiles y validación.",{"_3328":69109,"_29138":69062,"_20209":116762,"_5":13819,"_26493":116662,"_2816":116763},[],"Administrador de la flota",{"_3328":69110,"_29138":69062,"_20209":116765,"_5":13819,"_26493":116662,"_2816":116766},[],"DMS, admisión de dispositivos, política de renovación e inventario.",{"_3328":69111,"_29138":69062,"_20209":116768,"_5":13819,"_26493":116662,"_2816":116223},[],{"_3328":69112,"_29138":69062,"_20209":116770,"_5":13819,"_26493":116662,"_2816":116771},[],"Credencial inicial, confianza en el servidor, cliente EST y almacenamiento de clave y certificado.",{"_3328":69113,"_29138":69062,"_20209":116773,"_5":13819,"_26493":116662,"_2816":116229},[],{"_3328":69114,"_29138":69062,"_20209":116775,"_5":13819,"_26493":116662,"_2816":116776},[],"Confianza en los emisores, validación de certificados y permisos en el destino.",{"_3328":69115,"_29138":69062,"_20209":116778,"_5":13819,"_26493":116662,"_2816":116779},[],"Operador de infraestructura",{"_3328":69116,"_29138":69062,"_20209":116781,"_5":13819,"_26493":116662,"_2816":116782},[],"Instalación, red, disponibilidad, dependencias y diagnóstico de despliegue.",{"_3328":69117,"_29138":69062,"_20209":116784,"_5":13819,"_26493":116662,"_2816":116785},[],"La Referencia API recoge los contratos para automatizar las operaciones. Para resolver un fallo, empieza en el bloque afectado: PKI, EST o Despliegue.",{"_3328":69118,"_29138":69118,"_5":14177,"_2816":116787,"_29461":116788,"_20209":116790,"_26493":69118},"Jerarquía y rotación de CAs",[47397,112910,52871,116789],"Claves, autoridades y certificados",[],{"_3328":69119,"_29138":69118,"_20209":116792,"_5":13819,"_26493":69118,"_2816":116793},[],"Diseña autoridades raíz e intermedias y sustituye certificados o claves sin romper la confianza.",{"_3328":69120,"_29138":69118,"_5":29458,"_20209":116795,"_26493":116796,"_2816":116797},[],"/docs/es/platform/pki/ca-hierarchy-and-rotation#diseña-la-jerarquía","Diseña la jerarquía",{"_3328":69121,"_29138":69118,"_5":29458,"_20209":116799,"_26493":116800,"_2816":116801},[],"/docs/es/platform/pki/ca-hierarchy-and-rotation#reemisión-y-rotación-no-son-lo-mismo","Reemisión y rotación no son lo mismo",{"_3328":69122,"_29138":69118,"_5":29458,"_20209":116803,"_26493":116804,"_2816":116805},[],"/docs/es/platform/pki/ca-hierarchy-and-rotation#cuándo-elegir-cada-operación","Cuándo elegir cada operación",{"_3328":69123,"_29138":69118,"_5":29458,"_20209":116807,"_26493":116808,"_2816":116809},[],"/docs/es/platform/pki/ca-hierarchy-and-rotation#procedimiento-de-rotación-de-clave","Procedimiento de rotación de clave",{"_3328":69124,"_29138":69118,"_5":29458,"_20209":116811,"_26493":116812,"_2816":116813},[],"/docs/es/platform/pki/ca-hierarchy-and-rotation#inventaría-las-dependencias","Inventaría las dependencias",{"_3328":69125,"_29138":69118,"_5":29458,"_20209":116815,"_26493":116816,"_2816":116817},[],"/docs/es/platform/pki/ca-hierarchy-and-rotation#crea-la-ca-sucesora","Crea la CA sucesora",{"_3328":69126,"_29138":69118,"_5":29458,"_20209":116819,"_26493":116820,"_2816":116821},[],"/docs/es/platform/pki/ca-hierarchy-and-rotation#distribuye-la-nueva-confianza","Distribuye la nueva confianza",{"_3328":69127,"_29138":69118,"_5":29458,"_20209":116823,"_26493":116824,"_2816":116825},[],"/docs/es/platform/pki/ca-hierarchy-and-rotation#cambia-la-emisión","Cambia la emisión",{"_3328":69128,"_29138":69118,"_5":29458,"_20209":116827,"_26493":116828,"_2816":116829},[],"/docs/es/platform/pki/ca-hierarchy-and-rotation#renueva-por-lotes","Renueva por lotes",{"_3328":69129,"_29138":69118,"_5":29458,"_20209":116831,"_26493":116832,"_2816":116833},[],"/docs/es/platform/pki/ca-hierarchy-and-rotation#cierra-el-solapamiento","Cierra el solapamiento",{"_3328":69130,"_29138":69118,"_5":29458,"_20209":116835,"_26493":116836,"_2816":116837},[],"/docs/es/platform/pki/ca-hierarchy-and-rotation#revocación-en-cascada","Revocación en cascada",{"_3328":69131,"_29138":69118,"_5":29458,"_20209":116839,"_26493":116840,"_2816":116841},[],"/docs/es/platform/pki/ca-hierarchy-and-rotation#comprobaciones-después-del-cambio","Comprobaciones después del cambio",{"_3328":69132,"_29138":69118,"_20209":116843,"_5":13819,"_26493":69118,"_2816":116844},[],"La jerarquía determina el alcance de cualquier error o compromiso. Una raíz firma CAs intermedias; las intermedias emiten las identidades que usan dispositivos y servicios. Esta separación permite aislar entornos y rotar una rama sin reemplazar toda la confianza.",{"_3328":69133,"_29138":69118,"_20209":116846,"_5":13819,"_26493":69118,"_2816":116847},[],"Este procedimiento se dirige al operador PKI que sustituye una autoridad en uso. Necesitas acceso a las CAs, claves y perfiles, un inventario de dependencias y coordinación con quienes gestionan los almacenes de confianza y dispositivos. Antes de cambiar la emisión, prepara una cohorte de prueba y decide el criterio para cerrar el solapamiento.",{"_3328":69134,"_29138":69118,"_20209":116849,"_5":13819,"_26493":116796,"_2816":116850},[],"Para una instalación de producción, utiliza una raíz muy restringida y una o más intermedias operativas. Separa intermedias cuando cambie alguno de estos límites:",{"_3328":69135,"_29138":69118,"_20209":116852,"_5":13819,"_26493":116796,"_2816":116853},[],"entorno, como producción y preproducción;",{"_3328":69136,"_29138":69118,"_20209":116855,"_5":13819,"_26493":116796,"_2816":116856},[],"propietario o equipo operador;",{"_3328":69137,"_29138":69118,"_20209":116858,"_5":13819,"_26493":116796,"_2816":116859},[],"familia de dispositivos o proceso de fabricación;",{"_3328":69138,"_29138":69118,"_20209":116861,"_5":13819,"_26493":116796,"_2816":116862},[],"región o requisito regulatorio;",{"_3328":69139,"_29138":69118,"_20209":116864,"_5":13819,"_26493":116796,"_2816":116865},[],"motor criptográfico o política de clave;",{"_3328":69140,"_29138":69118,"_20209":116867,"_5":13819,"_26493":116796,"_2816":116868},[],"ventana de mantenimiento y ritmo de renovación.",{"_3328":69141,"_29138":69118,"_20209":116870,"_5":13819,"_26493":116796,"_2816":116871},[],"Evita jerarquías profundas sin una necesidad concreta. Cada nivel añade distribución de cadena, validación y otro certificado que debes renovar.",{"_3328":69142,"_29138":69118,"_20209":116873,"_5":13819,"_26493":116796,"_2816":116874},[],"Una CA hija y los certificados finales deben expirar antes que su emisor. Reserva un margen que permita distribuir otra cadena y renovar los certificados dependientes.",{"_3328":69143,"_29138":69118,"_20209":116876,"_5":13819,"_26493":116800,"_2816":116877},[],"**Reemitir una CA** crea un certificado nuevo sobre la clave existente. Lamassu genera una CSR con esa clave, autofirma si es una raíz o pide a la CA padre que firme si es subordinada. El nuevo certificado queda activo y la CA apunta a su número de serie; los certificados anterior y nuevo quedan enlazados mediante metadatos.",{"_3328":69144,"_29138":69118,"_20209":116879,"_5":13819,"_26493":116800,"_2816":116880},[],"**Rotar una CA** crea una clave y una autoridad sucesoras. Es la opción adecuada ante compromiso, cambio criptográfico, migración de motor o política de claves no exportables.",{"_3328":69145,"_29138":69118,"_20209":116882,"_5":13819,"_26493":116800,"_2816":116883},[],"Lamassu no permite reemitir una CA ya revocada ni una CA cuya fecha de expiración haya pasado. Anticípate a ambas condiciones.",{"_3328":69146,"_29138":69118,"_20209":116885,"_5":13819,"_26493":116804,"_2816":116886},[],"Reemite si la clave sigue siendo confiable y solo necesitas otro periodo de validez o un certificado actualizado.",{"_3328":69147,"_29138":69118,"_20209":116888,"_5":13819,"_26493":116804,"_2816":116889},[],"Rota la clave si existe sospecha de compromiso, cambia el algoritmo o quieres mover la custodia a otro motor.",{"_3328":69148,"_29138":69118,"_20209":116891,"_5":13819,"_26493":116804,"_2816":116892},[],"Crea una rama paralela si no puedes actualizar todos los consumidores al mismo tiempo.",{"_3328":69149,"_29138":69118,"_20209":116894,"_5":13819,"_26493":116804,"_2816":116895},[],"Revoca inmediatamente solo cuando el riesgo de mantener la CA supera el impacto de interrumpir la flota.",{"_3328":69150,"_29138":69118,"_20209":116897,"_5":13819,"_26493":116812,"_2816":116898},[],"Localiza CAs hijas, certificados emitidos, DMS, conectores y almacenes de confianza externos. Incluye dispositivos que pueden permanecer desconectados durante semanas o meses.",{"_3328":69151,"_29138":69118,"_20209":116900,"_5":13819,"_26493":116816,"_2816":116901},[],"Genera una clave nueva en el motor previsto, crea la CA y asígnale un perfil explícito. No reutilices el identificador operativo para ocultar que es una generación distinta.",{"_3328":69152,"_29138":69118,"_20209":116903,"_5":13819,"_26493":116820,"_2816":116904},[],"Añade la nueva raíz o cadena a los consumidores antes de emitir con ella. Si distribuyes mediante EST `/cacerts`, incluye explícitamente las CAs gestionadas necesarias y comprueba el contenido; no presupongas que incluir la CA emisora añade todas sus intermedias. Instala la nueva confianza en una cohorte y verifica que también sigue aceptando la identidad anterior.",{"_3328":69153,"_29138":69118,"_20209":116906,"_5":13819,"_26493":116824,"_2816":116907},[],"Actualiza la CA de enrolamiento y el perfil de los DMS. Mientras sigan renovando cohortes con certificados antiguos, añade la CA de enrolamiento anterior a las CAs de validación de re-enrolamiento (`reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`) de cada DMS: la nueva CA de enrolamiento se considera confiable automáticamente, pero la antigua era la CA de enrolamiento y no figura en ninguna lista de confianza de re-enrolamiento, así que sin esa entrada sus certificados ya no podrán renovarse. La guía DMS documenta ese ajuste.",{"_3328":69154,"_29138":69118,"_20209":116909,"_5":13819,"_26493":116828,"_2816":116910},[],"Migra una cohorte pequeña, valida mTLS, OCSP y CRL desde el consumidor y amplía progresivamente. Supervisa qué dispositivos siguen presentando la cadena antigua.",{"_3328":69155,"_29138":69118,"_20209":116912,"_5":13819,"_26493":116832,"_2816":116913},[],"Cuando ningún consumidor legítimo dependa de la autoridad anterior, retírala de la emisión, de las CAs de validación de re-enrolamiento y de las CAs distribuidas. Revócala si la política lo exige.",{"_3328":69156,"_29138":69118,"_20209":116915,"_5":13819,"_26493":116836,"_2816":116916},[],"Lamassu guarda la revocación de la CA y después intenta revocar sus CAs hijas y certificados emitidos con `CessationOfOperation`. La propagación continúa recursivamente por las hijas. No es una transacción sobre toda la jerarquía: puede haber recursos ya modificados y otros cuya actualización haya fallado.",{"_3328":69157,"_29138":69118,"_20209":116918,"_5":13819,"_26493":116836,"_2816":116919},[],"Los recursos en estado `EXPIRED` y los ya revocados por una razón definitiva no admiten otra transición de estado. Los errores por descendiente se registran; revisa el inventario y los registros aunque la operación sobre el padre haya terminado.",{"_3328":69158,"_29138":69118,"_20209":116921,"_5":13819,"_26493":116836,"_2816":116922},[],"`CertificateHold` permite reactivar el padre mientras no esté expirado, pero no restaura las hijas ni los certificados revocados definitivamente durante la cascada. Por eso suspender una CA tampoco sirve como pausa reversible de toda la rama.",{"_3328":69159,"_29138":69118,"_20209":116924,"_5":13819,"_26493":116836,"_2816":116925},[],"Antes de cerrar el cambio, contrasta el listado de dependencias inicial con los estados finales y verifica la publicación de revocación en cada emisor. No utilices la revocación como mecanismo ordinario para dejar de emitir: completa la migración y retira la CA de los flujos operativos.",{"_3328":69160,"_29138":69118,"_20209":116927,"_5":13819,"_26493":116840,"_2816":116928},[],"La cadena nueva termina en un ancla instalada por el consumidor.",{"_3328":69161,"_29138":69118,"_20209":116930,"_5":13819,"_26493":116840,"_2816":116931},[],"Los certificados nuevos contienen AKI, SKI, KU, EKU y SAN esperados.",{"_3328":69162,"_29138":69118,"_20209":116933,"_5":13819,"_26493":116840,"_2816":116934},[],"El DMS entrega la cadena correcta mediante EST `/cacerts`.",{"_3328":69163,"_29138":69118,"_20209":116936,"_5":13819,"_26493":116840,"_2816":116937},[],"El re-enrolamiento acepta la identidad antigua durante el periodo previsto.",{"_3328":69164,"_29138":69118,"_20209":116939,"_5":13819,"_26493":116840,"_2816":116940},[],"OCSP y CRL responden para las autoridades que siguen activas.",{"_3328":69165,"_29138":69118,"_20209":116942,"_5":13819,"_26493":116840,"_2816":116943},[],"No quedan DMS emitiendo accidentalmente desde la CA anterior.",{"_3328":69166,"_29138":69118,"_20209":116945,"_5":13819,"_26493":116840,"_2816":116946},[],"Consulta el Modelo de confianza para entender los conjuntos de CAs del DMS y Ciclo de vida de un certificado para los estados y efectos de revocación.",{"_3328":69167,"_29138":69167,"_5":14177,"_2816":116948,"_29461":116949,"_20209":116950,"_26493":69167},"Autoridades de certificación",[47397,112910,52871,116789],[],{"_3328":69168,"_29138":69167,"_20209":116952,"_5":13819,"_26493":69167,"_2816":116953},[],"Crea, importa y opera las autoridades que establecen la confianza de tu PKI.",{"_3328":69169,"_29138":69167,"_5":29458,"_20209":116955,"_26493":116956,"_2816":116957},[],"/docs/es/platform/pki/certificate-authorities#elige-un-flujo","Elige un flujo",{"_3328":69170,"_29138":69167,"_5":29458,"_20209":116959,"_26493":116960,"_2816":116961},[],"/docs/es/platform/pki/certificate-authorities#crea-una-autoridad-nueva","Crea una autoridad nueva",{"_3328":69171,"_29138":69167,"_5":29458,"_20209":116963,"_26493":116964,"_2816":111488},[],"/docs/es/platform/pki/certificate-authorities#antes-de-empezar",{"_3328":69172,"_29138":69167,"_5":29458,"_20209":116966,"_26493":116967,"_2816":116968},[],"/docs/es/platform/pki/certificate-authorities#abre-el-asistente","Abre el asistente",{"_3328":69173,"_29138":69167,"_5":29458,"_20209":116970,"_26493":116971,"_2816":116972},[],"/docs/es/platform/pki/certificate-authorities#configura-la-clave","Configura la clave",{"_3328":69174,"_29138":69167,"_5":29458,"_20209":116974,"_26493":116975,"_2816":116976},[],"/docs/es/platform/pki/certificate-authorities#elige-el-tipo-de-ca","Elige el tipo de CA",{"_3328":69175,"_29138":69167,"_5":29458,"_20209":116978,"_26493":116979,"_2816":116980},[],"/docs/es/platform/pki/certificate-authorities#define-la-identidad","Define la identidad",{"_3328":69176,"_29138":69167,"_5":29458,"_20209":116982,"_26493":116983,"_2816":116984},[],"/docs/es/platform/pki/certificate-authorities#configura-validez-y-usos","Configura validez y usos",{"_3328":69177,"_29138":69167,"_5":29458,"_20209":116986,"_26493":116987,"_2816":116988},[],"/docs/es/platform/pki/certificate-authorities#crea-y-verifica","Crea y verifica",{"_3328":69178,"_29138":69167,"_5":29458,"_20209":116990,"_26493":116991,"_2816":116992},[],"/docs/es/platform/pki/certificate-authorities#utiliza-una-clave-del-kms","Utiliza una clave del KMS",{"_3328":69179,"_29138":69167,"_5":29458,"_20209":116994,"_26493":116995,"_2816":116996},[],"/docs/es/platform/pki/certificate-authorities#importa-una-ca-externa","Importa una CA externa",{"_3328":69180,"_29138":69167,"_5":29458,"_20209":116998,"_26493":116999,"_2816":117000},[],"/docs/es/platform/pki/certificate-authorities#selecciona-el-motor","Selecciona el motor",{"_3328":69181,"_29138":69167,"_5":29458,"_20209":117002,"_26493":117003,"_2816":117004},[],"/docs/es/platform/pki/certificate-authorities#carga-el-material","Carga el material",{"_3328":69182,"_29138":69167,"_5":29458,"_20209":117006,"_26493":117007,"_2816":117008},[],"/docs/es/platform/pki/certificate-authorities#define-la-emisión-predeterminada","Define la emisión predeterminada",{"_3328":69183,"_29138":69167,"_5":29458,"_20209":117010,"_26493":117011,"_2816":117012},[],"/docs/es/platform/pki/certificate-authorities#verifica-la-importación","Verifica la importación",{"_3328":69184,"_29138":69167,"_5":29458,"_20209":117014,"_26493":117015,"_2816":117016},[],"/docs/es/platform/pki/certificate-authorities#inspecciona-una-autoridad","Inspecciona una autoridad",{"_3328":69185,"_29138":69167,"_5":29458,"_20209":117018,"_26493":117019,"_2816":117020},[],"/docs/es/platform/pki/certificate-authorities#emite-certificados","Emite certificados",{"_3328":69186,"_29138":69167,"_5":29458,"_20209":117022,"_26493":117023,"_2816":117024},[],"/docs/es/platform/pki/certificate-authorities#revoca-una-ca","Revoca una CA",{"_3328":69187,"_29138":69167,"_5":29458,"_20209":117026,"_26493":117027,"_2816":117028},[],"/docs/es/platform/pki/certificate-authorities#evalúa-el-impacto","Evalúa el impacto",{"_3328":69188,"_29138":69167,"_5":29458,"_20209":117030,"_26493":117031,"_2816":117032},[],"/docs/es/platform/pki/certificate-authorities#inicia-la-revocación","Inicia la revocación",{"_3328":69189,"_29138":69167,"_5":29458,"_20209":117034,"_26493":117035,"_2816":117036},[],"/docs/es/platform/pki/certificate-authorities#confirma-la-identidad","Confirma la identidad",{"_3328":69190,"_29138":69167,"_5":29458,"_20209":117038,"_26493":117039,"_2816":117040},[],"/docs/es/platform/pki/certificate-authorities#comprueba-la-publicación","Comprueba la publicación",{"_3328":69191,"_29138":69167,"_5":29458,"_20209":117042,"_26493":117043,"_2816":117044},[],"/docs/es/platform/pki/certificate-authorities#elimina-una-ca","Elimina una CA",{"_3328":69192,"_29138":69167,"_20209":117046,"_5":13819,"_26493":69167,"_2816":117047},[],"Una autoridad de certificación (CA) vincula identidades con claves públicas mediante certificados firmados. En Lamassu puedes crear una jerarquía nueva, utilizar una clave que ya está en el KMS o incorporar una CA externa.",{"_3328":69193,"_29138":69167,"_20209":117049,"_5":13819,"_26493":69167,"_2816":117050},[],"Para diseñar una cadena completa o sustituir una autoridad en producción, consulta Jerarquía y rotación de CAs. Si necesitas estandarizar qué puede firmar cada autoridad, utiliza Perfiles de certificado.",{"_3328":69194,"_29138":69167,"_20209":117052,"_5":13819,"_26493":69167,"_2816":117053},[],"Para administrar CAs necesitas permisos sobre las autoridades y las claves, un motor accesible y un perfil revisado. La CA de un consumidor externo no queda confiada por aparecer en este inventario: acuerda por separado la distribución de su raíz y cadena.",{"_3328":69195,"_29138":69167,"_20209":117055,"_5":13819,"_26493":116956,"_2816":117056},[],"**Nueva CA y nueva clave:** crea una raíz de confianza desde cero. Lamassu genera y custodia el par de claves.",{"_3328":69196,"_29138":69167,"_20209":117058,"_5":13819,"_26493":116956,"_2816":117059},[],"**Nueva CA desde KMS:** reutiliza una clave que ya está registrada en la plataforma.",{"_3328":69197,"_29138":69167,"_20209":117061,"_5":13819,"_26493":116956,"_2816":117062},[],"**Importar CA con clave privada:** incorpora una autoridad externa con la que Lamassu podrá emitir.",{"_3328":69198,"_29138":69167,"_20209":117064,"_5":13819,"_26493":116956,"_2816":117065},[],"**Importar solo el certificado:** registra material público. Si Lamassu encuentra su clave en el KMS, puede asociarla; si no la encuentra, la CA queda sin clave utilizable para emitir.",{"_3328":69199,"_29138":69167,"_20209":117067,"_5":13819,"_26493":116956,"_2816":117068},[],"¿Es tu primera vez? Sigue Crea tu primera CA para completar el recorrido mínimo.",{"_3328":69200,"_29138":69167,"_20209":117070,"_5":13819,"_26493":116964,"_2816":117071},[],"Decide si la CA será raíz o intermedia.",{"_3328":69201,"_29138":69167,"_20209":117073,"_5":13819,"_26493":116964,"_2816":117074},[],"Elige el motor que custodiará la clave.",{"_3328":69202,"_29138":69167,"_20209":117076,"_5":13819,"_26493":116964,"_2816":117077},[],"Define una validez superior a la de los certificados que emitirá.",{"_3328":69203,"_29138":69167,"_20209":117079,"_5":13819,"_26493":116964,"_2816":117080},[],"Para una CA intermedia, asegúrate de que la CA padre esté activa.",{"_3328":69204,"_29138":69167,"_20209":117082,"_5":13819,"_26493":116967,"_2816":117083},[],"En **Certification Authorities**, selecciona **Create New CA** y elige generar un par de claves nuevo.",{"_3328":69205,"_29138":69167,"_20209":117085,"_5":13819,"_26493":116971,"_2816":117086},[],"Selecciona el motor criptográfico, el algoritmo y el tamaño o curva. Lamassu admite claves RSA y EC según las capacidades del motor.",{"_3328":69206,"_29138":69167,"_20209":117088,"_5":13819,"_26493":116971,"_2816":117089},[],"Utiliza únicamente tamaños y curvas admitidos por el motor y por la política criptográfica del perfil. Consulta Claves y motores antes de reutilizar material externo.",{"_3328":69207,"_29138":69167,"_20209":117091,"_5":13819,"_26493":116975,"_2816":117092},[],"Selecciona **Root CA** para una autoridad autofirmada o **Intermediate CA** para una autoridad firmada por otra CA. En el segundo caso, elige la CA emisora.",{"_3328":69208,"_29138":69167,"_20209":117094,"_5":13819,"_26493":116979,"_2816":117095},[],"Introduce un **CA Name** único. Este nombre se convierte en el `Common Name` del certificado. Completa los campos del Distinguished Name que necesite tu política:",{"_3328":69209,"_29138":69167,"_20209":117097,"_5":13819,"_26493":116979,"_2816":117098},[],"`C`: código de país ISO 3166-1 de dos letras.",{"_3328":69210,"_29138":69167,"_20209":117100,"_5":13819,"_26493":116979,"_2816":117101},[],"`ST`: estado o provincia.",{"_3328":69211,"_29138":69167,"_20209":117103,"_5":13819,"_26493":116979,"_2816":117104},[],"`L`: localidad.",{"_3328":69212,"_29138":69167,"_20209":117106,"_5":13819,"_26493":116979,"_2816":117107},[],"`O`: organización.",{"_3328":69213,"_29138":69167,"_20209":117109,"_5":13819,"_26493":116979,"_2816":117110},[],"`OU`: unidad organizativa.",{"_3328":69214,"_29138":69167,"_20209":117112,"_5":13819,"_26493":116979,"_2816":117113},[],"El identificador interno de la CA se genera automáticamente y no se puede modificar.",{"_3328":69215,"_29138":69167,"_20209":117115,"_5":13819,"_26493":116983,"_2816":117116},[],"Define **CA Certificate Expiration** y **Default End-Entity Certificate Issuance Expiration**. Puedes expresar una duración (`5y 8w 4d`), seleccionar una fecha o utilizar la fecha máxima permitida.",{"_3328":69216,"_29138":69167,"_20209":117118,"_5":13819,"_26493":116983,"_2816":117119},[],"Revisa por separado el certificado de la propia CA y el perfil predeterminado para lo que emitirá después. Elige una política explícita de emisión; no confíes en que los valores iniciales del formulario sean adecuados para tus consumidores.",{"_3328":69217,"_29138":69167,"_20209":117121,"_5":13819,"_26493":116987,"_2816":117122},[],"Confirma el formulario y abre la CA. Comprueba estado, emisor, fechas, motor y clave asociados. Descarga el certificado: debe tener `CA:TRUE` y un uso que permita firmar certificados. Verifica la autofirma para una raíz o la cadena hasta tu raíz para una intermedia. Completa una emisión de prueba para comprobar que la clave realmente puede firmar.",{"_3328":69218,"_29138":69167,"_20209":117124,"_5":13819,"_26493":116987,"_2816":117125},[],"Planifica y verifica los vencimientos con las reglas de Perfiles. La emisión no recorta automáticamente la validez al vencimiento del emisor; deja margen para sustituir la autoridad y renovar las identidades.",{"_3328":69219,"_29138":69167,"_20209":117127,"_5":13819,"_26493":116991,"_2816":117128},[],"Selecciona &#x2A;*Create New CA (Existing Key)** cuando la clave ya esté registrada en Lamassu. El asistente pide primero la clave de soporte y después muestra la misma configuración de tipo, identidad, validez y perfil.",{"_3328":69220,"_29138":69167,"_20209":117130,"_5":13819,"_26493":116991,"_2816":117131},[],"Este flujo resulta útil cuando la clave se creó previamente en un HSM, se importó mediante BYOK o debe reutilizarse con una política de custodia concreta.",{"_3328":69221,"_29138":69167,"_20209":117133,"_5":13819,"_26493":116995,"_2816":117134},[],"Necesitas el certificado de CA en PEM, su cadena hasta una raíz conocida y, si vas a importarla, una clave privada exportable. Antes de cargar el material, verifica firma, fechas, `CA:TRUE`, usos de firma (incluido `cRLSign`, sin el cual la CA no puede publicar su CRL) y correspondencia de la clave pública. El procedimiento de verificación de claves también sirve para comparar la clave y el certificado de una CA.",{"_3328":69222,"_29138":69167,"_20209":117136,"_5":13819,"_26493":116999,"_2816":117137},[],"Comprueba el motor predeterminado de la instalación antes de importar una CA con clave. La operación de importación de CA delega la importación de la clave en ese motor; no garantiza selección de cualquier proveedor desde el formulario. Para seleccionar un motor al importar la clave por separado, utiliza el KMS.",{"_3328":69223,"_29138":69167,"_20209":117139,"_5":13819,"_26493":117003,"_2816":117140},[],"Importa el certificado y, cuando corresponda, su clave PEM. Registra las CAs de la cadena necesarias para identificar al emisor. Tener una CA en el inventario no la instala en los almacenes de confianza externos.",{"_3328":69224,"_29138":69167,"_20209":117142,"_5":13819,"_26493":117007,"_2816":117143},[],"Asocia un perfil de emisión explícito si la CA va a firmar. Comprueba sus usos y fechas según Perfiles.",{"_3328":69225,"_29138":69167,"_20209":117145,"_5":13819,"_26493":117011,"_2816":117146},[],"Revisa el tipo registrado, la clave y el motor asociados y la relación con el emisor. Una importación sin clave puede asociarse a una clave ya existente en KMS mediante el identificador de clave del certificado. Si no existe una clave utilizable, la CA sirve como material público pero no puede firmar.",{"_3328":69226,"_29138":69167,"_20209":117148,"_5":13819,"_26493":117011,"_2816":117149},[],"Para una CA emisora, completa una emisión de prueba y comprueba OCSP y CRL. El alta del registro por sí sola no demuestra disponibilidad de la clave, coherencia completa de la cadena ni publicación del estado.",{"_3328":69227,"_29138":69167,"_20209":117151,"_5":13819,"_26493":117015,"_2816":117152},[],"Abre una CA desde el inventario para consultar:",{"_3328":69228,"_29138":69167,"_20209":117154,"_5":13819,"_26493":117015,"_2816":117155},[],"Estado y periodo de validez.",{"_3328":69229,"_29138":69167,"_20209":117157,"_5":13819,"_26493":117015,"_2816":117158},[],"Certificado y cadena en formato PEM.",{"_3328":69230,"_29138":69167,"_20209":117160,"_5":13819,"_26493":117015,"_2816":117161},[],"Número de certificados activos, expirados y revocados.",{"_3328":69231,"_29138":69167,"_20209":117163,"_5":13819,"_26493":117015,"_2816":117164},[],"Certificados emitidos en **Issued Certificates**.",{"_3328":69232,"_29138":69167,"_20209":117166,"_5":13819,"_26493":117015,"_2816":117167},[],"CRL vinculada a la autoridad.",{"_3328":69233,"_29138":69167,"_20209":117169,"_5":13819,"_26493":117015,"_2816":117170},[],"Metadatos y motor criptográfico asociado.",{"_3328":69234,"_29138":69167,"_20209":117172,"_5":13819,"_26493":117015,"_2816":117173},[],"Puedes filtrar el inventario por nombre, estado y tipo de CA.",{"_3328":69235,"_29138":69167,"_20209":117175,"_5":13819,"_26493":117019,"_2816":117176},[],"Puedes iniciar una emisión desde **Issued Certificates**, desde la acción de una CA o desde el inventario global de certificados.",{"_3328":69236,"_29138":69167,"_20209":117178,"_5":13819,"_26493":117019,"_2816":117179},[],"**Generate Key & CSR in Browser** resulta útil para una operación manual o una prueba rápida. El navegador genera la clave y debes descargarla al finalizar.",{"_3328":69237,"_29138":69167,"_20209":117181,"_5":13819,"_26493":117019,"_2816":117182},[],"**Upload Existing CSR** es la opción adecuada cuando la clave debe permanecer en el sistema de destino. Lamassu recibe la solicitud, pero nunca la clave privada.",{"_3328":69238,"_29138":69167,"_20209":117184,"_5":13819,"_26493":117019,"_2816":117185},[],"Sigue Emite tu primer certificado para el flujo guiado. La gestión de certificados explica el inventario, la inspección y la revocación.",{"_3328":69239,"_29138":69167,"_20209":117187,"_5":13819,"_26493":117023,"_2816":117188},[],"Revocar una CA impide que emita y puede interrumpir toda su rama. Solo `CertificateHold` permite reactivar la propia CA si no está expirada. Sus descendientes se intentan revocar con `CessationOfOperation`; reactivar el padre no restaura esos descendientes. Sigue las condiciones de revocación en cascada.",{"_3328":69240,"_29138":69167,"_20209":117190,"_5":13819,"_26493":117027,"_2816":117191},[],"Identifica los certificados, dispositivos y consumidores que dependen de la CA. Prepara una autoridad y una cadena de sustitución cuando sea necesario.",{"_3328":69241,"_29138":69167,"_20209":117193,"_5":13819,"_26493":117031,"_2816":117194},[],"Abre la autoridad y selecciona **Revoke CA**. Elige la razón que describa el incidente, por ejemplo `KeyCompromise`, `CACompromise`, `Superseded` o `CessationOfOperation`.",{"_3328":69242,"_29138":69167,"_20209":117196,"_5":13819,"_26493":117035,"_2816":117197},[],"Escribe exactamente el nombre de la CA para habilitar **Confirm Revocation**.",{"_3328":69243,"_29138":69167,"_20209":117199,"_5":13819,"_26493":117039,"_2816":117200},[],"Comprueba **REVOKED** en la CA y revisa los descendientes uno a uno; la propagación admite fallos parciales. Verifica por separado la publicación de OCSP y CRL y el rechazo por los consumidores. Un registro revocado no garantiza que una sesión existente se cierre.",{"_3328":69244,"_29138":69167,"_20209":117202,"_5":13819,"_26493":117043,"_2816":117203},[],"La eliminación permanente solo está disponible con la CA revocada o caducada; una CA importada sin clave puede eliminarse en cualquier estado. Elimina el registro únicamente cuando la política de retención y auditoría lo permita.",{"_3328":69245,"_29138":69167,"_20209":117205,"_5":13819,"_26493":117043,"_2816":117206},[],"El rol VA de la CA se conserva. Si no queda otra CA con el mismo SKI, deja de ser editable (consulta CRL), así que ajusta antes su validez y su firmante. La clave de la CA se libera, pero el KMS la conserva mientras otros certificados la referencien.",{"_3328":69246,"_29138":69167,"_20209":117208,"_5":13819,"_26493":117043,"_2816":117209},[],"Lamassu conserva el registro del certificado de una CA eliminada. Si se importa de nuevo ese mismo certificado, la importación termina bien y reutiliza el registro: actualiza el tipo, el emisor y la clave, pero conserva el estado, así que la CA reaparece con el que tenía al eliminarse (normalmente revocada o caducada). Un certificado distinto con el mismo número de serie se rechaza con error 400, y un certificado que ya pertenece a una CA existente, con error 409. Para no heredar el estado anterior, usa un certificado con otro número de serie y comprueba el resultado tras importar. Si el certificado nuevo usa la misma clave, comparte el SKI con el rol VA retenido de la CA eliminada, cuyo firmante es el certificado antiguo: comprueba que la CRL se genera y, si no es así, asigna con `PUT` un firmante de la CA nueva (consulta CRL).",{"_3328":69247,"_29138":69247,"_5":14177,"_2816":117211,"_29461":117212,"_20209":117213,"_26493":69247},"Perfiles de certificado",[47397,112910,52871,116789],[],{"_3328":69248,"_29138":69247,"_20209":117215,"_5":13819,"_26493":69247,"_2816":117216},[],"Define políticas reutilizables para emitir certificados coherentes y limitar las claves aceptadas.",{"_3328":69249,"_29138":69247,"_5":29458,"_20209":117218,"_26493":117219,"_2816":117220},[],"/docs/es/platform/pki/certificate-profiles#qué-controla-un-perfil","Qué controla un perfil",{"_3328":69250,"_29138":69247,"_5":29458,"_20209":117222,"_26493":117223,"_2816":117224},[],"/docs/es/platform/pki/certificate-profiles#validez","Validez",{"_3328":69251,"_29138":69247,"_5":29458,"_20209":117226,"_26493":117227,"_2816":117228},[],"/docs/es/platform/pki/certificate-profiles#certificado-de-ca-o-certificado-final","Certificado de CA o certificado final",{"_3328":69252,"_29138":69247,"_5":29458,"_20209":117230,"_26493":117231,"_2816":117232},[],"/docs/es/platform/pki/certificate-profiles#key-usage-y-extended-key-usage","Key Usage y Extended Key Usage",{"_3328":69253,"_29138":69247,"_5":29458,"_20209":117234,"_26493":117235,"_2816":117236},[],"/docs/es/platform/pki/certificate-profiles#sujeto","Sujeto",{"_3328":69254,"_29138":69247,"_5":29458,"_20209":117238,"_26493":117239,"_2816":117240},[],"/docs/es/platform/pki/certificate-profiles#extensiones-de-la-csr","Extensiones de la CSR",{"_3328":69255,"_29138":69247,"_5":29458,"_20209":117242,"_26493":117243,"_2816":117244},[],"/docs/es/platform/pki/certificate-profiles#restricciones-criptográficas","Restricciones criptográficas",{"_3328":69256,"_29138":69247,"_5":29458,"_20209":117246,"_26493":117247,"_2816":117248},[],"/docs/es/platform/pki/certificate-profiles#precedencia-del-perfil","Precedencia del perfil",{"_3328":69257,"_29138":69247,"_5":29458,"_20209":117250,"_26493":117251,"_2816":117252},[],"/docs/es/platform/pki/certificate-profiles#crea-un-perfil","Crea un perfil",{"_3328":69258,"_29138":69247,"_5":29458,"_20209":117254,"_26493":117255,"_2816":117256},[],"/docs/es/platform/pki/certificate-profiles#define-un-único-propósito","Define un único propósito",{"_3328":69259,"_29138":69247,"_5":29458,"_20209":117258,"_26493":117259,"_2816":117260},[],"/docs/es/platform/pki/certificate-profiles#elige-la-validez","Elige la validez",{"_3328":69260,"_29138":69247,"_5":29458,"_20209":117262,"_26493":117263,"_2816":117264},[],"/docs/es/platform/pki/certificate-profiles#fija-usos-y-sujeto","Fija usos y sujeto",{"_3328":69261,"_29138":69247,"_5":29458,"_20209":117266,"_26493":117267,"_2816":117268},[],"/docs/es/platform/pki/certificate-profiles#restringe-las-claves","Restringe las claves",{"_3328":69262,"_29138":69247,"_5":29458,"_20209":117270,"_26493":117271,"_2816":117272},[],"/docs/es/platform/pki/certificate-profiles#asócialo-y-prueba","Asócialo y prueba",{"_3328":69263,"_29138":69247,"_5":29458,"_20209":117274,"_26493":117275,"_2816":117276},[],"/docs/es/platform/pki/certificate-profiles#ejemplos-de-diseño","Ejemplos de diseño",{"_3328":69264,"_29138":69247,"_5":29458,"_20209":117278,"_26493":117279,"_2816":117280},[],"/docs/es/platform/pki/certificate-profiles#cambios-y-eliminación","Cambios y eliminación",{"_3328":69265,"_29138":69247,"_20209":117282,"_5":13819,"_26493":69247,"_2816":117283},[],"Un perfil de emisión convierte una política de certificados en configuración reutilizable. En lugar de decidir validez, sujeto, extensiones y algoritmos en cada solicitud, defines una vez qué está permitido y asocias el perfil a una CA, un DMS o una emisión concreta.",{"_3328":69266,"_29138":69247,"_20209":117285,"_5":13819,"_26493":69247,"_2816":117286},[],"Esta guía se dirige al administrador PKI que define la política de emisión. Necesitas permisos para gestionar perfiles y asociarlos a la CA o DMS previstos, además de un consumidor de prueba con requisitos de identidad y uso conocidos.",{"_3328":69267,"_29138":69247,"_20209":117288,"_5":13819,"_26493":117223,"_2816":117289},[],"Puedes expresar la vigencia como una duración desde el momento de emisión o como una fecha final fija. Una duración funciona bien para identidades recurrentes; una fecha común sirve para hacer que todo un lote termine antes de una migración o retirada.",{"_3328":69268,"_29138":69247,"_20209":117291,"_5":13819,"_26493":117223,"_2816":117292},[],"Planifica la fecha final dentro de la vigencia de la CA emisora y deja margen para renovar. El firmador calcula la fecha desde el perfil; no recorta automáticamente la validez al vencimiento del emisor. Comprueba ambas fechas en el certificado resultante. Una fecha fija ya pasada tampoco representa una identidad utilizable.",{"_3328":69269,"_29138":69247,"_20209":117294,"_5":13819,"_26493":117227,"_2816":117295},[],"`Sign as CA` establece `IsCA` y las restricciones básicas necesarias para una autoridad. Actívalo solo en perfiles destinados a crear o reemitir CAs subordinadas.",{"_3328":69270,"_29138":69247,"_20209":117297,"_5":13819,"_26493":117231,"_2816":117298},[],"El perfil puede imponer usos como `DigitalSignature`, `KeyEncipherment`, `CertSign`, `CRLSign`, `ClientAuth`, `ServerAuth` u `OCSPSigning`.",{"_3328":69271,"_29138":69247,"_20209":117300,"_5":13819,"_26493":117231,"_2816":117301},[],"Si activas **Honor Key Usage** o **Honor Extended Key Usages**, Lamassu conserva los valores solicitados por la CSR. Si los desactivas, los sustituye por los definidos en el perfil.",{"_3328":69272,"_29138":69247,"_20209":117303,"_5":13819,"_26493":117231,"_2816":117304},[],"No habilites las opciones `Honor…` para solicitudes no confiables salvo que otro componente valide esos campos. De lo contrario, el solicitante puede elegir capacidades más amplias de las previstas.",{"_3328":69273,"_29138":69247,"_20209":117306,"_5":13819,"_26493":117235,"_2816":117307},[],"Con **Honor Subject**, el certificado conserva el sujeto de la CSR. Sin esa opción, Lamassu aplica `CN`, `O`, `OU`, `C`, `ST` y `L` del perfil. Si el perfil no define `Common Name`, se conserva el CN solicitado.",{"_3328":69274,"_29138":69247,"_20209":117309,"_5":13819,"_26493":117239,"_2816":117310},[],"Con **Honor Extensions**, Lamassu filtra las extensiones adicionales solicitadas y conserva únicamente SAN. Sin esa opción, descarta las extensiones adicionales de la CSR.",{"_3328":69275,"_29138":69247,"_20209":117312,"_5":13819,"_26493":117239,"_2816":117313},[],"Esto conserva SAN, pero no comprueba que el solicitante tenga derecho a utilizar esos DNS, IP, correos o URI. Valida esa autorización antes de emitir. Los puntos OCSP y CRL proceden de la configuración del servicio de emisión; `Honor Extensions` no copia los puntos de distribución de la CSR.",{"_3328":69276,"_29138":69247,"_20209":117315,"_5":13819,"_26493":117243,"_2816":117316},[],"La aplicación criptográfica puede:",{"_3328":69277,"_29138":69247,"_20209":117318,"_5":13819,"_26493":117243,"_2816":117319},[],"permitir o bloquear claves RSA;",{"_3328":69278,"_29138":69247,"_20209":117321,"_5":13819,"_26493":117243,"_2816":117322},[],"limitar los tamaños RSA admitidos;",{"_3328":69279,"_29138":69247,"_20209":117324,"_5":13819,"_26493":117243,"_2816":117325},[],"permitir o bloquear claves ECDSA;",{"_3328":69280,"_29138":69247,"_20209":117327,"_5":13819,"_26493":117243,"_2816":117328},[],"limitar los tamaños o curvas ECDSA admitidos.",{"_3328":69281,"_29138":69247,"_20209":117330,"_5":13819,"_26493":117243,"_2816":117331},[],"Cuando está habilitada, Lamassu comprueba la clave pública antes de crear una CA o firmar una CSR. Una clave cuyo tipo o tamaño no figure en el perfil se rechaza.",{"_3328":69282,"_29138":69247,"_20209":117333,"_5":13819,"_26493":117247,"_2816":117334},[],"La resolución depende del punto de entrada. Se selecciona un perfil completo; sus campos no se fusionan con los del perfil de la CA.",{"_3328":69283,"_29138":69247,"_20209":117336,"_5":13819,"_26493":117247,"_2816":112670},[],{"_3328":69284,"_29138":69247,"_20209":117338,"_5":13819,"_26493":117247,"_2816":117339},[],"Primera opción",{"_3328":69285,"_29138":69247,"_20209":117341,"_5":13819,"_26493":117247,"_2816":117342},[],"Segunda opción",{"_3328":69286,"_29138":69247,"_20209":117344,"_5":13819,"_26493":117247,"_2816":117345},[],"Si no hay ninguna",{"_3328":69287,"_29138":69247,"_20209":117347,"_5":13819,"_26493":117247,"_2816":117348},[],"Firma directa con una CA",{"_3328":69288,"_29138":69247,"_20209":117350,"_5":13819,"_26493":117247,"_2816":117351},[],"`issuance_profile` incluido en la solicitud",{"_3328":69289,"_29138":69247,"_20209":117353,"_5":13819,"_26493":117247,"_2816":117354},[],"`issuance_profile_id` de la solicitud",{"_3328":69290,"_29138":69247,"_20209":117356,"_5":13819,"_26493":117247,"_2816":117357},[],"Perfil predeterminado de la CA (`profile_id`).",{"_3328":69291,"_29138":69247,"_20209":117359,"_5":13819,"_26493":117247,"_2816":117360},[],"Emisión mediante DMS",{"_3328":69292,"_29138":69247,"_20209":117362,"_5":13819,"_26493":117247,"_2816":53446},[],{"_3328":69293,"_29138":69247,"_20209":117364,"_5":13819,"_26493":117247,"_2816":117365},[],"`settings.issuance_profile` incluido en el DMS",{"_3328":69294,"_29138":69247,"_20209":117367,"_5":13819,"_26493":117247,"_2816":117368},[],"Perfil predeterminado de la CA de enrolamiento.",{"_3328":69295,"_29138":69247,"_20209":117370,"_5":13819,"_26493":117247,"_2816":117371},[],"Si el identificador seleccionado no puede resolverse, la operación falla; no se sustituye silenciosamente por el perfil de la CA. Evita definir las dos opciones a la vez. Registrar qué perfil se seleccionó facilita explicar por qué el resultado difiere de la CSR.",{"_3328":69296,"_29138":69247,"_20209":117373,"_5":13819,"_26493":117247,"_2816":117374},[],"Varias flotas pueden compartir CA y mantener perfiles distintos mediante sus DMS. La autenticación del solicitante y la política de registro del dispositivo se configuran aparte en DMS.",{"_3328":69297,"_29138":69247,"_20209":117376,"_5":13819,"_26493":117255,"_2816":117377},[],"Separa, por ejemplo, dispositivos mTLS, servidores y CAs intermedias. Un perfil pequeño y específico es más fácil de revisar que uno que permita todos los usos.",{"_3328":69298,"_29138":69247,"_20209":117379,"_5":13819,"_26493":117259,"_2816":117380},[],"Alinea la duración con la capacidad real de renovación de la flota. Deja margen respecto a la expiración de la CA.",{"_3328":69299,"_29138":69247,"_20209":117382,"_5":13819,"_26493":117263,"_2816":117383},[],"Para un dispositivo que se autentica como cliente, el punto de partida habitual es `DigitalSignature` y `ClientAuth`. Añade `ServerAuth` o `KeyEncipherment` solo si el protocolo lo necesita.",{"_3328":69300,"_29138":69247,"_20209":117385,"_5":13819,"_26493":117267,"_2816":117386},[],"Habilita la aplicación criptográfica y enumera únicamente algoritmos y tamaños compatibles con tu política y tus dispositivos.",{"_3328":69301,"_29138":69247,"_20209":117388,"_5":13819,"_26493":117271,"_2816":117389},[],"Asocia el perfil a una CA o DMS y verifica la precedencia anterior. Emite una CSR con usos y SAN conocidos; inspecciona el resultado con `openssl x509 -in device.crt -noout -text`. Comprueba sujeto, SAN, KU, EKU y fechas. Para una identidad final, `Sign as CA` debe estar desactivado, no debe aparecer `CA:TRUE` ni `Certificate Sign`; si existe Basic Constraints, debe indicar `CA:FALSE`.",{"_3328":69302,"_29138":69247,"_20209":117391,"_5":13819,"_26493":117271,"_2816":117392},[],"Prueba también una clave excluida por la política: la emisión debe rechazarse. Sigue la verificación del certificado y prueba su aceptación en el consumidor previsto.",{"_3328":69303,"_29138":69247,"_20209":117394,"_5":13819,"_26493":117275,"_2816":117395},[],"**Dispositivo mTLS**\\\nCertificado final, validez corta, `DigitalSignature`, `ClientAuth`, sujeto controlado por el DMS y SAN permitido cuando identifica al dispositivo.",{"_3328":69304,"_29138":69247,"_20209":117397,"_5":13819,"_26493":117275,"_2816":117398},[],"**Servidor TLS**\\\nCertificado final, `DigitalSignature`, `ServerAuth` y SAN obligatorio con los nombres que utilizarán los clientes.",{"_3328":69305,"_29138":69247,"_20209":117400,"_5":13819,"_26493":117275,"_2816":117401},[],"**CA intermedia**\\\n`Sign as CA`, `CertSign` y `CRLSign`, validez superior a sus certificados finales y restricciones criptográficas más exigentes.",{"_3328":69306,"_29138":69247,"_20209":117403,"_5":13819,"_26493":117275,"_2816":117404},[],"Estos patrones expresan decisiones de diseño. Activar `Honor Extensions` no exige que la CSR incluya SAN ni valida sus nombres; debes hacer esa comprobación en el flujo de solicitud. El perfil tampoco instala confianza ni concede permisos en el consumidor.",{"_3328":69307,"_29138":69247,"_20209":117406,"_5":13819,"_26493":117279,"_2816":117407},[],"Actualizar un perfil afecta a emisiones futuras; no modifica certificados ya firmados. Prueba los cambios antes de aplicarlos a una CA en producción y conserva la justificación operativa.",{"_3328":69308,"_29138":69247,"_20209":117409,"_5":13819,"_26493":117279,"_2816":117410},[],"Antes de eliminar un perfil, comprueba que ninguna CA o DMS dependa de él. Si deseas sustituirlo, crea la versión nueva, actualiza las referencias y realiza una emisión de prueba antes de retirar el anterior.",{"_3328":69309,"_29138":69309,"_5":14177,"_2816":117412,"_29461":117413,"_20209":117415,"_26493":69309},"Validación de certificados",[47397,112910,52871,117414],"Validación",[],{"_3328":69310,"_29138":69309,"_20209":117417,"_5":13819,"_26493":69309,"_2816":117418},[],"Comprueba cadena, identidad, usos y revocación desde el consumidor.",{"_3328":69311,"_29138":69309,"_5":29458,"_20209":117420,"_26493":117421,"_2816":117422},[],"/docs/es/platform/pki/certificate-validation#antes-de-consultar-el-estado","Antes de consultar el estado",{"_3328":69312,"_29138":69309,"_5":29458,"_20209":117424,"_26493":117425,"_2816":117426},[],"/docs/es/platform/pki/certificate-validation#elige-un-mecanismo","Elige un mecanismo",{"_3328":69313,"_29138":69309,"_5":29458,"_20209":117428,"_26493":117429,"_2816":117430},[],"/docs/es/platform/pki/certificate-validation#comprueba-el-comportamiento-del-consumidor","Comprueba el comportamiento del consumidor",{"_3328":69314,"_29138":69309,"_20209":117432,"_5":13819,"_26493":69309,"_2816":117433},[],"Esta guía reúne las comprobaciones que necesita quien integra un consumidor de certificados. Necesitas el certificado presentado, las intermedias y las raíces que tu aplicación ha decidido confiar. Lamassu publica estado; el consumidor aplica la política de aceptación.",{"_3328":69315,"_29138":69309,"_20209":117435,"_5":13819,"_26493":117421,"_2816":117436},[],"Verifica estos criterios juntos:",{"_3328":69316,"_29138":69309,"_20209":117438,"_5":13819,"_26493":117421,"_2816":116418},[],{"_3328":69317,"_29138":69309,"_20209":117440,"_5":13819,"_26493":117421,"_2816":117441},[],"Resultado necesario",{"_3328":69318,"_29138":69309,"_20209":117443,"_5":13819,"_26493":117421,"_2816":117444},[],"Cadena y firma",{"_3328":69319,"_29138":69309,"_20209":117446,"_5":13819,"_26493":117421,"_2816":117447},[],"Cadena válida hasta una raíz instalada deliberadamente en el consumidor.",{"_3328":69320,"_29138":69309,"_20209":117449,"_5":13819,"_26493":117421,"_2816":117450},[],"Fechas",{"_3328":69321,"_29138":69309,"_20209":117452,"_5":13819,"_26493":117421,"_2816":117453},[],"Fecha actual entre `Not Before` y `Not After`, también para las CAs de la cadena.",{"_3328":69322,"_29138":69309,"_20209":117455,"_5":13819,"_26493":117421,"_2816":112580},[],{"_3328":69323,"_29138":69309,"_20209":117457,"_5":13819,"_26493":117421,"_2816":117458},[],"Nombre, SAN o identificador corresponden al interlocutor esperado.",{"_3328":69324,"_29138":69309,"_20209":117460,"_5":13819,"_26493":117421,"_2816":117461},[],"Uso",{"_3328":69325,"_29138":69309,"_20209":117463,"_5":13819,"_26493":117421,"_2816":117464},[],"KU, EKU y restricciones permiten la operación concreta.",{"_3328":69326,"_29138":69309,"_20209":117466,"_5":13819,"_26493":117421,"_2816":117467},[],"Revocación",{"_3328":69327,"_29138":69309,"_20209":117469,"_5":13819,"_26493":117421,"_2816":117470},[],"Evidencia firmada, vigente y correspondiente al emisor y certificado consultados.",{"_3328":69328,"_29138":69309,"_20209":117472,"_5":13819,"_26493":117421,"_2816":117473},[],"Autorización",{"_3328":69329,"_29138":69309,"_20209":117475,"_5":13819,"_26493":117421,"_2816":117476},[],"La aplicación permite la acción a esa identidad.",{"_3328":69330,"_29138":69309,"_20209":117478,"_5":13819,"_26493":117421,"_2816":117479},[],"El recorrido de emisión comprueba cadena y uso con OpenSSL. Esa comprobación no consulta automáticamente OCSP ni descarga una CRL. Un certificado presente en el inventario o una respuesta OCSP `Good` no sustituyen los demás criterios.",{"_3328":69331,"_29138":69309,"_20209":117481,"_5":13819,"_26493":117425,"_2816":117482},[],"Mecanismo",{"_3328":69332,"_29138":69309,"_20209":117484,"_5":13819,"_26493":117425,"_2816":117485},[],"Cuándo utilizarlo",{"_3328":69333,"_29138":69309,"_20209":117487,"_5":13819,"_26493":117425,"_2816":117488},[],"Qué debes mantener",{"_3328":69334,"_29138":69309,"_20209":117490,"_5":13819,"_26493":117425,"_2816":53574},[],{"_3328":69335,"_29138":69309,"_20209":117492,"_5":13819,"_26493":117425,"_2816":117493},[],"Consulta del estado de un certificado concreto.",{"_3328":69336,"_29138":69309,"_20209":117495,"_5":13819,"_26493":117425,"_2816":117496},[],"Acceso al respondedor, verificación de la firma y política de caché/vigencia.",{"_3328":69337,"_29138":69309,"_20209":117498,"_5":13819,"_26493":117425,"_2816":53583},[],{"_3328":69338,"_29138":69309,"_20209":117500,"_5":13819,"_26493":117425,"_2816":117501},[],"Consulta local de muchos certificados o funcionamiento offline.",{"_3328":69339,"_29138":69309,"_20209":117503,"_5":13819,"_26493":117425,"_2816":117504},[],"Descarga periódica de una lista firmada por el emisor y rechazo de listas vencidas.",{"_3328":69340,"_29138":69309,"_20209":117506,"_5":13819,"_26493":117425,"_2816":117507},[],"OCSP también puede devolver una respuesta reutilizable hasta `nextUpdate`; una CRL cambia al publicarse una versión nueva. Ninguno garantiza por sí solo que un consumidor conozca una revocación en el momento de guardarla.",{"_3328":69341,"_29138":69309,"_20209":117509,"_5":13819,"_26493":117425,"_2816":117510},[],"Si utilizas ambos, define cuándo se permite el mecanismo alternativo y qué hace el cliente si falla la descarga, la firma, la vigencia o devuelve `Unknown`. Aceptar una identidad cuando no puedes comprobar su estado debe ser una decisión explícita de tu aplicación.",{"_3328":69342,"_29138":69309,"_20209":117512,"_5":13819,"_26493":117429,"_2816":117513},[],"Acepta un certificado vigente, autorizado y con cadena conocida.",{"_3328":69343,"_29138":69309,"_20209":117515,"_5":13819,"_26493":117429,"_2816":117516},[],"Rechaza otro con raíz desconocida o uso incompatible.",{"_3328":69344,"_29138":69309,"_20209":117518,"_5":13819,"_26493":117429,"_2816":117519},[],"Revoca un certificado de prueba y verifica la respuesta OCSP o la nueva CRL.",{"_3328":69345,"_29138":69309,"_20209":117521,"_5":13819,"_26493":117429,"_2816":117522},[],"Comprueba que una conexión nueva con esa identidad se rechaza.",{"_3328":69346,"_29138":69309,"_20209":117524,"_5":13819,"_26493":117429,"_2816":117525},[],"Simula un endpoint inaccesible y evidencia vencida; observa si el resultado coincide con tu política.",{"_3328":69347,"_29138":69309,"_20209":117527,"_5":13819,"_26493":117429,"_2816":117528},[],"Conserva número de serie, emisor, razón de revocación, hora de consulta y tiempos de la evidencia. Una sesión ya abierta puede necesitar cierre o reautenticación explícita en el servicio consumidor; publicar revocación no la cierra automáticamente.",{"_3328":69348,"_29138":69309,"_20209":117530,"_5":13819,"_26493":117429,"_2816":117531},[],"Para una cadena con intermedias, valida también su estado según la política del consumidor. La CRL del emisor de una identidad final no reemplaza las comprobaciones de todas las CAs de la cadena.",{"_3328":69349,"_29138":69309,"_20209":117533,"_5":13819,"_26493":117429,"_2816":117534},[],"<Card title=\"Validación online con OCSP\" description=\"Genera una consulta y verifica firma, estado y tiempos.\" href=\"/docs/platform/pki/ocsp\" />",{"_3328":69350,"_29138":69309,"_20209":117536,"_5":13819,"_26493":117429,"_2816":117537},[],"<Card title=\"Listas de revocación\" description=\"Descarga, inspecciona y utiliza una CRL del emisor.\" href=\"/docs/platform/pki/crl\" />",{"_3328":69351,"_29138":69351,"_5":14177,"_2816":117539,"_29461":117540,"_20209":117541,"_26493":69351},"Certificados",[47397,112910,52871,116789],[],{"_3328":69352,"_29138":69351,"_20209":117543,"_5":13819,"_26493":69351,"_2816":117544},[],"Consulta, descarga y revoca los certificados emitidos por Lamassu.",{"_3328":69353,"_29138":69351,"_5":29458,"_20209":117546,"_26493":117547,"_2816":117548},[],"/docs/es/platform/pki/certificates#busca-un-certificado","Busca un certificado",{"_3328":69354,"_29138":69351,"_5":29458,"_20209":117550,"_26493":117551,"_2816":117552},[],"/docs/es/platform/pki/certificates#descarga-el-certificado","Descarga el certificado",{"_3328":69355,"_29138":69351,"_5":29458,"_20209":117554,"_26493":117555,"_2816":117556},[],"/docs/es/platform/pki/certificates#emite-desde-una-csr-existente","Emite desde una CSR existente",{"_3328":69356,"_29138":69351,"_5":29458,"_20209":117558,"_26493":117559,"_2816":117560},[],"/docs/es/platform/pki/certificates#revoca-un-certificado","Revoca un certificado",{"_3328":69357,"_29138":69351,"_5":29458,"_20209":117562,"_26493":117563,"_2816":117564},[],"/docs/es/platform/pki/certificates#abre-la-acción","Abre la acción",{"_3328":69358,"_29138":69351,"_5":29458,"_20209":117566,"_26493":117567,"_2816":117568},[],"/docs/es/platform/pki/certificates#elige-una-razón","Elige una razón",{"_3328":69359,"_29138":69351,"_5":29458,"_20209":117570,"_26493":117571,"_2816":117572},[],"/docs/es/platform/pki/certificates#confirma-y-verifica","Confirma y verifica",{"_3328":69360,"_29138":69351,"_5":29458,"_20209":117574,"_26493":117575,"_2816":117576},[],"/docs/es/platform/pki/certificates#reactiva-una-suspensión","Reactiva una suspensión",{"_3328":69361,"_29138":69351,"_5":29458,"_20209":117578,"_26493":117579,"_2816":117580},[],"/docs/es/platform/pki/certificates#continúa","Continúa",{"_3328":69362,"_29138":69351,"_20209":117582,"_5":13819,"_26493":69351,"_2816":117583},[],"Esta guía sirve al operador PKI que necesita inspeccionar o retirar una identidad ya emitida. Necesitas acceso al inventario y, para cambiar estados, permisos sobre el certificado. Abre **Certificates** para una vista global o **Issued Certificates** dentro de una CA para limitarla a ese emisor.",{"_3328":69363,"_29138":69351,"_20209":117585,"_5":13819,"_26493":117547,"_2816":117586},[],"Filtra por `Common Name`, serie, estado y autoridad emisora. Usa **Quick Inspect** para una revisión rápida o **View Details** para sujeto, SAN, usos, cadena, fechas y metadatos.",{"_3328":69364,"_29138":69351,"_20209":117588,"_5":13819,"_26493":117547,"_2816":117589},[],"Identifica el certificado por emisor y número de serie; un nombre puede corresponder a varias renovaciones. Comprueba cuál utiliza realmente el consumidor y cuál ocupa la identidad activa del dispositivo. El historial de identidades y el inventario de certificados responden preguntas distintas.",{"_3328":69365,"_29138":69351,"_20209":117591,"_5":13819,"_26493":117551,"_2816":117592},[],"Descarga el PEM e inspecciónalo:",{"_3328":69366,"_29138":69351,"_20209":117594,"_5":13819,"_26493":117551,"_2816":117595},[],"Comprueba la política de emisión, cadena y usos con el recorrido de verificación. El certificado no contiene su clave privada. Para una CSR externa, esa clave permanece donde se generó; para el flujo de navegador, conserva el archivo descargado al completar la emisión. Si has perdido la clave, planifica una identidad nueva en lugar de esperar recuperarla desde el certificado.",{"_3328":69367,"_29138":69351,"_20209":117597,"_5":13819,"_26493":117555,"_2816":117598},[],"Utiliza este flujo cuando la clave de la identidad debe permanecer en el sistema que la generó. Necesitas una CA activa con clave utilizable, una CSR PEM y un perfil apropiado.",{"_3328":69368,"_29138":69351,"_20209":117600,"_5":13819,"_26493":117555,"_2816":117601},[],"Verifica la solicitud con `openssl req -in request.csr -noout -verify -text`. Revisa sujeto, SAN y algoritmo, y autoriza la identidad solicitada.",{"_3328":69369,"_29138":69351,"_20209":117603,"_5":13819,"_26493":117555,"_2816":117604},[],"Inicia la emisión desde la CA o el inventario y selecciona **Upload Existing CSR**.",{"_3328":69370,"_29138":69351,"_20209":117606,"_5":13819,"_26493":117555,"_2816":117607},[],"Confirma la CA y el perfil que se resolverá según Perfiles; la solicitud no garantiza que todos sus campos se conserven.",{"_3328":69371,"_29138":69351,"_20209":117609,"_5":13819,"_26493":117555,"_2816":117610},[],"Descarga el certificado e inspecciona fechas, emisor, sujeto, SAN, KU y EKU. Comprueba su correspondencia con la clave privada en el sistema de origen.",{"_3328":69372,"_29138":69351,"_20209":117612,"_5":13819,"_26493":117555,"_2816":117613},[],"Instala certificado y cadena en el consumidor previsto y prueba una conexión. Emitir no registra por sí solo un dispositivo ni concede acceso en una integración.",{"_3328":69373,"_29138":69351,"_20209":117615,"_5":13819,"_26493":117555,"_2816":117616},[],"Para generar la clave en el navegador, sigue Emite tu primer certificado.",{"_3328":69374,"_29138":69351,"_20209":117618,"_5":13819,"_26493":117559,"_2816":117619},[],"Revoca cuando la clave se haya comprometido, el sujeto ya no esté autorizado o la identidad deba dejar de aceptarse antes de expirar. Antes de cambiar el estado, identifica los consumidores y prepara la sustitución necesaria.",{"_3328":69375,"_29138":69351,"_20209":117621,"_5":13819,"_26493":117563,"_2816":117622},[],"Localiza emisor y serie correctos y selecciona **Revoke Certificate**. Los registros `EXPIRED` y los revocados por una razón definitiva no admiten posteriores cambios de estado.",{"_3328":69376,"_29138":69351,"_20209":117624,"_5":13819,"_26493":117567,"_2816":117625},[],"Selecciona la razón del incidente. `CertificateHold` representa una suspensión reversible del certificado; las demás razones bloquean cambios posteriores. No uses una suspensión para tratar una clave comprometida.",{"_3328":69377,"_29138":69351,"_20209":117627,"_5":13819,"_26493":117571,"_2816":117628},[],"Guarda el cambio y vuelve a consultar el registro: exige **REVOKED**, razón y fecha. Verifica después una consulta OCSP nueva y, si utilizas CRL, su versión publicada y presencia de la serie. Finalmente, comprueba el rechazo de una conexión nueva en el consumidor.",{"_3328":69378,"_29138":69351,"_20209":117630,"_5":13819,"_26493":117571,"_2816":117631},[],"La revocación no borra el certificado, no elimina la clave ni garantiza cierre de sesiones existentes. El estado y su publicación son pasos distintos.",{"_3328":69379,"_29138":69351,"_20209":117633,"_5":13819,"_26493":117571,"_2816":117634},[],"Un certificado revocado con `CertificateHold` puede reactivarse si no está en estado `EXPIRED`. Sus fechas y la confianza del consumidor siguen siendo obligatorias.",{"_3328":69380,"_29138":69351,"_20209":117636,"_5":13819,"_26493":117575,"_2816":117637},[],"Comprueba que la razón guardada es `CertificateHold` y que la identidad todavía cumple tu política. Solicita `ACTIVE` mediante la operación de actualización de estado que exponga tu instalación; consulta la Referencia API. No supongas que cambiar permisos del consumidor cambia también el estado en Lamassu.",{"_3328":69381,"_29138":69351,"_20209":117639,"_5":13819,"_26493":117575,"_2816":117640},[],"Vuelve a consultar el registro y OCSP. Con `regenerate_on_revoke` habilitado, el evento de reactivación solicita regeneración de la CRL: verifica que la nueva lista omite la serie. Una lista anterior puede seguir marcándola como revocada hasta que el cliente renueve su copia.",{"_3328":69382,"_29138":69351,"_20209":117642,"_5":13819,"_26493":117575,"_2816":117643},[],"Esto no revierte una revocación definitiva ni la cascada iniciada al revocar una CA.",{"_3328":69383,"_29138":69351,"_20209":117645,"_5":13819,"_26493":117579,"_2816":117646},[],"<Card title=\"Validar con OCSP\" description=\"Consulta y verifica el estado firmado de un certificado.\" href=\"/docs/platform/pki/ocsp\" />",{"_3328":69384,"_29138":69351,"_20209":117648,"_5":13819,"_26493":117579,"_2816":117649},[],"<Card title=\"Distribuir una CRL\" description=\"Publica el estado para validación local.\" href=\"/docs/platform/pki/crl\" />",{"_3328":69385,"_29138":69385,"_5":14177,"_2816":117651,"_29461":117652,"_20209":117654,"_26493":69385},"Ciclo de vida de un certificado",[47397,112910,52871,117653],"Conceptos",[],{"_3328":69386,"_29138":69385,"_20209":117656,"_5":13819,"_26493":69385,"_2816":117657},[],"Emisión, uso, renovación, revocación y retirada de certificados en Lamassu.",{"_3328":69387,"_29138":69385,"_5":29458,"_20209":117659,"_26493":117660,"_2816":117661},[],"/docs/es/platform/pki/concepts/certificate-lifecycle#el-recorrido-completo","El recorrido completo",{"_3328":69388,"_29138":69385,"_5":29458,"_20209":117663,"_26493":117664,"_2816":117665},[],"/docs/es/platform/pki/concepts/certificate-lifecycle#solicitud","Solicitud",{"_3328":69389,"_29138":69385,"_5":29458,"_20209":117667,"_26493":117668,"_2816":117669},[],"/docs/es/platform/pki/concepts/certificate-lifecycle#emisión","Emisión",{"_3328":69390,"_29138":69385,"_5":29458,"_20209":117671,"_26493":117672,"_2816":117673},[],"/docs/es/platform/pki/concepts/certificate-lifecycle#uso-y-supervisión","Uso y supervisión",{"_3328":69391,"_29138":69385,"_5":29458,"_20209":117675,"_26493":117676,"_2816":117677},[],"/docs/es/platform/pki/concepts/certificate-lifecycle#renovación-o-re-enrolamiento","Renovación o re-enrolamiento",{"_3328":69392,"_29138":69385,"_5":29458,"_20209":117679,"_26493":117680,"_2816":117681},[],"/docs/es/platform/pki/concepts/certificate-lifecycle#revocación-o-retirada","Revocación o retirada",{"_3328":69393,"_29138":69385,"_5":29458,"_20209":117683,"_26493":117684,"_2816":115363},[],"/docs/es/platform/pki/concepts/certificate-lifecycle#estados-del-certificado",{"_3328":69394,"_29138":69385,"_5":29458,"_20209":117686,"_26493":117687,"_2816":117688},[],"/docs/es/platform/pki/concepts/certificate-lifecycle#renovación-y-revocación-no-son-equivalentes","Renovación y revocación no son equivalentes",{"_3328":69395,"_29138":69385,"_5":29458,"_20209":117690,"_26493":117691,"_2816":117692},[],"/docs/es/platform/pki/concepts/certificate-lifecycle#efecto-de-revocar-una-ca","Efecto de revocar una CA",{"_3328":69396,"_29138":69385,"_5":29458,"_20209":117694,"_26493":117695,"_2816":117696},[],"/docs/es/platform/pki/concepts/certificate-lifecycle#qué-debes-observar","Qué debes observar",{"_3328":69397,"_29138":69385,"_20209":117698,"_5":13819,"_26493":69385,"_2816":117699},[],"Emitir un certificado es solo el comienzo. Durante su vida útil debes comprobar su vigencia, renovarlo antes de que caduque y retirarlo cuando deje de ser fiable. Lamassu conserva el certificado, su CA emisora, su estado y, cuando pertenece a un dispositivo, la identidad a la que está vinculado.",{"_3328":69398,"_29138":69385,"_20209":117701,"_5":13819,"_26493":117664,"_2816":117702},[],"El solicitante genera una clave y una CSR. En los flujos recomendados, la clave privada permanece en el dispositivo, navegador o motor criptográfico que la creó.",{"_3328":69399,"_29138":69385,"_20209":117704,"_5":13819,"_26493":117668,"_2816":117705},[],"La CA firma la CSR. El perfil de emisión determina la validez, los usos, el sujeto, las extensiones admitidas y las restricciones criptográficas.",{"_3328":69400,"_29138":69385,"_20209":117707,"_5":13819,"_26493":117672,"_2816":117708},[],"El certificado queda en estado `ACTIVE`. Lamassu monitoriza su fecha `Not After`; el trabajo de monitorización criptográfica marca como `EXPIRED` los certificados que han vencido.",{"_3328":69401,"_29138":69385,"_20209":117710,"_5":13819,"_26493":117676,"_2816":117711},[],"Se emite un certificado nuevo antes de que caduque el anterior. En un DMS puedes abrir ventanas preventiva y crítica para que el dispositivo se re-enrole mediante EST.",{"_3328":69402,"_29138":69385,"_20209":117713,"_5":13819,"_26493":117680,"_2816":117714},[],"Si la identidad deja de ser fiable, Lamassu registra la razón y la hora de revocación. OCSP y las CRLs permiten que los consumidores conozcan ese estado.",{"_3328":69403,"_29138":69385,"_20209":117716,"_5":13819,"_26493":117684,"_2816":117717},[],"Lamassu persiste cuatro estados X.509:",{"_3328":69404,"_29138":69385,"_20209":117719,"_5":13819,"_26493":117684,"_2816":117720},[],"**`ACTIVE`**: el registro está habilitado. Comprueba además `Not Before` y `Not After`: este estado no demuestra vigencia temporal.",{"_3328":69405,"_29138":69385,"_20209":117722,"_5":13819,"_26493":117684,"_2816":117723},[],"**`EXPIRED`**: ha superado su fecha de expiración. El monitor lo detecta de forma periódica; no es un estado que deba asignarse manualmente.",{"_3328":69406,"_29138":69385,"_20209":117725,"_5":13819,"_26493":117684,"_2816":117726},[],"**`REVOKED`**: fue invalidado antes de expirar, con una razón y una marca temporal.",{"_3328":69407,"_29138":69385,"_20209":117728,"_5":13819,"_26493":117684,"_2816":117729},[],"**`INACTIVE`**: está deshabilitado sin representar una revocación definitiva.",{"_3328":69408,"_29138":69385,"_20209":117731,"_5":13819,"_26493":117684,"_2816":117732},[],"La vista del dispositivo puede añadir estados operativos como ausencia de identidad, renovación pendiente, expiración próxima o baja. Son una interpretación del estado del dispositivo y de sus certificados, no nuevos estados X.509.",{"_3328":69409,"_29138":69385,"_20209":117734,"_5":13819,"_26493":117687,"_2816":117735},[],"La **renovación** crea un certificado sucesor para una identidad que continúa siendo válida. La **revocación** comunica que el certificado actual ya no debe aceptarse. Renueva para mantener continuidad; revoca ante compromiso, retirada o un cambio que invalide la identidad.",{"_3328":69410,"_29138":69385,"_20209":117737,"_5":13819,"_26493":117687,"_2816":117738},[],"Solo `CertificateHold` permite reactivar un certificado revocado que no esté en estado `EXPIRED`. Una revocación con otra razón bloquea posteriores cambios de estado. Los registros `EXPIRED` también rechazan cambios; el consumidor debe comprobar las fechas aunque el monitor todavía no haya actualizado el estado. Certificados explica cómo comprobar revocación y reactivación.",{"_3328":69411,"_29138":69385,"_20209":117740,"_5":13819,"_26493":117687,"_2816":117741},[],"La operación **Reissue CA** genera otro certificado para la misma clave y enlaza ambos números de serie mediante metadatos. No equivale a una rotación de clave. Para cambiar la clave, crea una CA sucesora y realiza una migración con periodo de solapamiento.",{"_3328":69412,"_29138":69385,"_20209":117743,"_5":13819,"_26493":117691,"_2816":117744},[],"Revocar una CA inicia una cascada que intenta revocar sus descendientes con `CessationOfOperation`. Puede terminar con fallos parciales y no se deshace al reactivar el padre. Consulta Jerarquía y rotación para sus condiciones y comprobaciones.",{"_3328":69413,"_29138":69385,"_20209":117746,"_5":13819,"_26493":117691,"_2816":117747},[],"Antes de confirmar:",{"_3328":69414,"_29138":69385,"_20209":117749,"_5":13819,"_26493":117691,"_2816":117750},[],"Identifica DMS, dispositivos y servicios que confían en esa cadena.",{"_3328":69415,"_29138":69385,"_20209":117752,"_5":13819,"_26493":117691,"_2816":117753},[],"Distribuye la nueva cadena de confianza.",{"_3328":69416,"_29138":69385,"_20209":117755,"_5":13819,"_26493":117691,"_2816":117756},[],"Reemite las identidades necesarias.",{"_3328":69417,"_29138":69385,"_20209":117758,"_5":13819,"_26493":117691,"_2816":117759},[],"Comprueba OCSP y CRL desde un consumidor real.",{"_3328":69418,"_29138":69385,"_20209":117761,"_5":13819,"_26493":117691,"_2816":117762},[],"Revoca la CA antigua cuando ya no exista tráfico legítimo.",{"_3328":69419,"_29138":69385,"_20209":117764,"_5":13819,"_26493":117691,"_2816":117765},[],"La baja de un dispositivo pertenece al ciclo de vida de IoT Fleets. Afecta a su identidad activa; no equivale a recorrer y revocar automáticamente todos los certificados del historial. Revisa por separado las identidades anteriores y los permisos del consumidor en Gestión de dispositivos.",{"_3328":69420,"_29138":69385,"_20209":117767,"_5":13819,"_26493":117695,"_2816":117768},[],"Certificados que entran en la ventana preventiva o crítica de renovación.",{"_3328":69421,"_29138":69385,"_20209":117770,"_5":13819,"_26493":117695,"_2816":117771},[],"Errores repetidos de enrolamiento o re-enrolamiento.",{"_3328":69422,"_29138":69385,"_20209":117773,"_5":13819,"_26493":117695,"_2816":117774},[],"Cambios de estado y razones de revocación.",{"_3328":69423,"_29138":69385,"_20209":117776,"_5":13819,"_26493":117695,"_2816":117777},[],"Publicación y vigencia de OCSP y CRLs.",{"_3328":69424,"_29138":69385,"_20209":117779,"_5":13819,"_26493":117695,"_2816":117780},[],"Dependencias que todavía presentan un certificado sustituido.",{"_3328":69425,"_29138":69385,"_20209":117782,"_5":13819,"_26493":117695,"_2816":117783},[],"El historial del dispositivo relaciona sus identidades anteriores y actuales. Para cambios administrativos y errores de mutación, consulta Registros de auditoría.",{"_3328":69426,"_29138":69426,"_5":14177,"_2816":117785,"_29461":117786,"_20209":117787,"_26493":69426},"Modelo de confianza",[47397,112910,52871,117653],[],{"_3328":69427,"_29138":69426,"_20209":117789,"_5":13819,"_26493":69426,"_2816":117790},[],"Entiende dónde nace la confianza, cómo se distribuye y qué valida cada componente.",{"_3328":69428,"_29138":69426,"_5":29458,"_20209":117792,"_26493":117793,"_2816":117794},[],"/docs/es/platform/pki/concepts/trust-model#las-cuatro-decisiones-de-confianza","Las cuatro decisiones de confianza",{"_3328":69429,"_29138":69426,"_5":29458,"_20209":117796,"_26493":117797,"_2816":117798},[],"/docs/es/platform/pki/concepts/trust-model#quién-puede-emitir","Quién puede emitir",{"_3328":69430,"_29138":69426,"_5":29458,"_20209":117800,"_26493":117801,"_2816":117802},[],"/docs/es/platform/pki/concepts/trust-model#qué-puede-emitirse","Qué puede emitirse",{"_3328":69431,"_29138":69426,"_5":29458,"_20209":117804,"_26493":117805,"_2816":117806},[],"/docs/es/platform/pki/concepts/trust-model#quién-puede-solicitarlo","Quién puede solicitarlo",{"_3328":69432,"_29138":69426,"_5":29458,"_20209":117808,"_26493":117809,"_2816":117810},[],"/docs/es/platform/pki/concepts/trust-model#quién-acepta-el-resultado","Quién acepta el resultado",{"_3328":69433,"_29138":69426,"_5":29458,"_20209":117812,"_26493":117813,"_2816":117814},[],"/docs/es/platform/pki/concepts/trust-model#flujo-de-una-identidad","Flujo de una identidad",{"_3328":69434,"_29138":69426,"_5":29458,"_20209":117816,"_26493":117817,"_2816":117818},[],"/docs/es/platform/pki/concepts/trust-model#cas-de-enrolamiento-validación-y-distribución","CAs de enrolamiento, validación y distribución",{"_3328":69435,"_29138":69426,"_5":29458,"_20209":117820,"_26493":117821,"_2816":117822},[],"/docs/es/platform/pki/concepts/trust-model#validación-y-revocación","Validación y revocación",{"_3328":69436,"_29138":69426,"_5":29458,"_20209":117824,"_26493":117825,"_2816":117826},[],"/docs/es/platform/pki/concepts/trust-model#límites-de-custodia","Límites de custodia",{"_3328":69437,"_29138":69426,"_5":29458,"_20209":117828,"_26493":117829,"_2816":117830},[],"/docs/es/platform/pki/concepts/trust-model#patrón-recomendado","Patrón recomendado",{"_3328":69438,"_29138":69426,"_20209":117832,"_5":13819,"_26493":69426,"_2816":117833},[],"En Lamassu, confianza no significa simplemente que un certificado exista en el inventario. Un consumidor confía en una identidad cuando puede construir una cadena hasta una raíz que reconoce, comprobar que el certificado sirve para el uso esperado y verificar que sigue vigente.",{"_3328":69439,"_29138":69426,"_20209":117835,"_5":13819,"_26493":117797,"_2816":117836},[],"La jerarquía de CAs define qué autoridades pueden firmar. Una CA raíz establece el ancla de confianza; las CAs intermedias separan ámbitos operativos y evitan utilizar la raíz para cada emisión.",{"_3328":69440,"_29138":69426,"_20209":117838,"_5":13819,"_26493":117801,"_2816":117839},[],"Los perfiles de certificado limitan validez, sujeto, usos, extensiones y parámetros criptográficos. La posesión de una CA no sustituye a una política de emisión.",{"_3328":69441,"_29138":69426,"_20209":117841,"_5":13819,"_26493":117805,"_2816":117842},[],"El DMS actúa como punto de enrolamiento. Puede autenticar una solicitud EST con certificado cliente, webhook externo o una combinación de ambos. Las CAs configuradas para validar al solicitante no tienen por qué ser la CA que emitirá la identidad nueva.",{"_3328":69442,"_29138":69426,"_20209":117844,"_5":13819,"_26493":117809,"_2816":117845},[],"El consumidor mantiene su propio almacén de confianza. EST `/cacerts` puede distribuir el certificado TLS del servicio, la CA de enrolamiento y CAs gestionadas seleccionadas. La confianza inicial para autenticar ese servicio debe proceder de un canal ya confiable. Descarga e inspecciona el contenido: no asumas que es una cadena completa ni instales todas las entradas como raíces.",{"_3328":69443,"_29138":69426,"_20209":117847,"_5":13819,"_26493":117813,"_2816":117848},[],"El dispositivo demuestra que puede enrolarse según la política del DMS.",{"_3328":69444,"_29138":69426,"_20209":117850,"_5":13819,"_26493":117813,"_2816":117851},[],"El DMS valida la solicitud y remite la CSR a la CA de enrolamiento.",{"_3328":69445,"_29138":69426,"_20209":117853,"_5":13819,"_26493":117813,"_2816":117854},[],"En el flujo con CSR generado en el dispositivo, la CA aplica el perfil y firma sin recibir su clave privada.",{"_3328":69446,"_29138":69426,"_20209":117856,"_5":13819,"_26493":117813,"_2816":117857},[],"El dispositivo instala el certificado y la cadena que necesita.",{"_3328":69447,"_29138":69426,"_20209":117859,"_5":13819,"_26493":117813,"_2816":117860},[],"El sistema que confía en el dispositivo valida cadena, fechas, usos y estado de revocación.",{"_3328":69448,"_29138":69426,"_20209":117862,"_5":13819,"_26493":117813,"_2816":117863},[],"OIDC o X.509 identifica al operador que llama a Lamassu. El servicio de autorización decide qué acciones puede realizar. La jerarquía X.509, en cambio, determina si un certificado presentado por un dispositivo es confiable.",{"_3328":69449,"_29138":69426,"_20209":117865,"_5":13819,"_26493":117817,"_2816":117866},[],"Un DMS relaciona tres conjuntos que conviene diseñar por separado:",{"_3328":69450,"_29138":69426,"_20209":117868,"_5":13819,"_26493":117817,"_2816":117869},[],"**CA de enrolamiento:** firma las nuevas identidades.",{"_3328":69451,"_29138":69426,"_20209":117871,"_5":13819,"_26493":117817,"_2816":117872},[],"**CAs de validación:** autentican certificados cliente usados para enrolamiento o migración. En re-enrolamiento, la CA de enrolamiento siempre es confiable y Lamassu prueba después las CAs de validación configuradas en el bloque de re-enrolamiento; estas son opcionales.",{"_3328":69452,"_29138":69426,"_20209":117874,"_5":13819,"_26493":117817,"_2816":117875},[],"**CAs distribuidas:** forman el contenido que el dispositivo obtiene mediante EST `/cacerts`. Puedes incluir el certificado TLS del servicio, la CA de enrolamiento y una lista explícita de CAs gestionadas. Incluir la CA emisora no añade automáticamente todos sus ascendientes.",{"_3328":69453,"_29138":69426,"_20209":117877,"_5":13819,"_26493":117817,"_2816":117878},[],"Esta separación permite migrar una flota: aceptas temporalmente certificados de la jerarquía anterior, emites con la nueva y distribuyes ambas cadenas durante el solapamiento.",{"_3328":69454,"_29138":69426,"_20209":117880,"_5":13819,"_26493":117821,"_2816":117881},[],"Una cadena válida no garantiza por sí sola que el certificado deba aceptarse. El consumidor también debe comprobar:",{"_3328":69455,"_29138":69426,"_20209":117883,"_5":13819,"_26493":117821,"_2816":117884},[],"que la fecha actual está entre `Not Before` y `Not After`;",{"_3328":69456,"_29138":69426,"_20209":117886,"_5":13819,"_26493":117821,"_2816":117887},[],"que `Key Usage` y `Extended Key Usage` permiten la operación;",{"_3328":69457,"_29138":69426,"_20209":117889,"_5":13819,"_26493":117821,"_2816":117890},[],"que nombres, SANs y sujeto coinciden con la identidad esperada;",{"_3328":69458,"_29138":69426,"_20209":117892,"_5":13819,"_26493":117821,"_2816":117893},[],"que el certificado no aparece revocado mediante OCSP o una CRL.",{"_3328":69459,"_29138":69426,"_20209":117895,"_5":13819,"_26493":117821,"_2816":117896},[],"El estado `Good` de OCSP tampoco sustituye la comprobación de cadena, fechas, uso e identidad; Validación reúne esos criterios.",{"_3328":69460,"_29138":69426,"_20209":117898,"_5":13819,"_26493":117821,"_2816":117899},[],"Durante la autenticación mTLS de un DMS, Lamassu intenta comprobar la revocación. Si el certificado no contiene información suficiente para efectuar esa comprobación, el backend registra una advertencia y continúa tratándolo como no revocado. Diseña los perfiles y puntos de distribución para evitar esa situación en producción.",{"_3328":69461,"_29138":69426,"_20209":117901,"_5":13819,"_26493":117825,"_2816":117902},[],"El KMS conserva la referencia de la clave y delega la operación al motor configurado. Con un HSM o un KMS cloud, la clave privada puede permanecer no exportable. Eso protege la custodia, pero no impide por sí solo el uso indebido: todavía debes restringir quién puede ordenar una firma y auditar esas operaciones.",{"_3328":69462,"_29138":69426,"_20209":117904,"_5":13819,"_26493":117829,"_2816":117905},[],"Mantén la raíz fuera de las operaciones diarias o con acceso muy restringido.",{"_3328":69463,"_29138":69426,"_20209":117907,"_5":13819,"_26493":117829,"_2816":117908},[],"Emite desde CAs intermedias separadas por entorno o dominio de riesgo.",{"_3328":69464,"_29138":69426,"_20209":117910,"_5":13819,"_26493":117829,"_2816":117911},[],"Asigna perfiles explícitos a cada caso de uso.",{"_3328":69465,"_29138":69426,"_20209":117913,"_5":13819,"_26493":117829,"_2816":117914},[],"Distribuye la nueva confianza antes de comenzar una rotación.",{"_3328":69466,"_29138":69426,"_20209":117916,"_5":13819,"_26493":117829,"_2816":117917},[],"Mantén solapamiento suficiente para renovar una flota desconectada.",{"_3328":69467,"_29138":69426,"_20209":117919,"_5":13819,"_26493":117829,"_2816":117920},[],"Valida desde el sistema consumidor, no solo desde la consola de Lamassu.",{"_3328":69468,"_29138":69426,"_20209":117922,"_5":13819,"_26493":117829,"_2816":117923},[],"Continúa con Jerarquía y rotación de CAs para convertir este modelo en un procedimiento operativo.",{"_3328":69469,"_29138":69469,"_5":14177,"_2816":117925,"_29461":117926,"_20209":117927,"_26493":69469},"Listas de revocación (CRL)",[47397,112910,52871,117414],[],{"_3328":69470,"_29138":69469,"_20209":117929,"_5":13819,"_26493":69469,"_2816":117930},[],"Genera y distribuye listas firmadas para validar certificados sin conexión.",{"_3328":69471,"_29138":69469,"_5":29458,"_20209":117932,"_26493":117933,"_2816":117934},[],"/docs/es/platform/pki/crl#rol-va-y-configuración-por-ca","Rol VA y configuración por CA",{"_3328":69472,"_29138":69469,"_5":29458,"_20209":117936,"_26493":117937,"_2816":117938},[],"/docs/es/platform/pki/crl#cas-que-comparten-clave","CAs que comparten clave",{"_3328":69473,"_29138":69469,"_5":29458,"_20209":117940,"_26493":117941,"_2816":117942},[],"/docs/es/platform/pki/crl#regeneración-periódica-y-automática","Regeneración periódica y automática",{"_3328":69474,"_29138":69469,"_5":29458,"_20209":117944,"_26493":117945,"_2816":117946},[],"/docs/es/platform/pki/crl#contenido-de-la-crl","Contenido de la CRL",{"_3328":69475,"_29138":69469,"_5":29458,"_20209":117948,"_26493":117949,"_2816":117950},[],"/docs/es/platform/pki/crl#endpoint-público-de-descarga","Endpoint público de descarga",{"_3328":69476,"_29138":69469,"_5":29458,"_20209":117952,"_26493":117953,"_2816":117954},[],"/docs/es/platform/pki/crl#api-de-gestión-del-rol-va","API de gestión del rol VA",{"_3328":69477,"_29138":69469,"_5":29458,"_20209":117956,"_26493":117957,"_2816":117958},[],"/docs/es/platform/pki/crl#errores-frecuentes-del-rol-va","Errores frecuentes del rol VA",{"_3328":69478,"_29138":69469,"_5":29458,"_20209":117960,"_26493":117961,"_2816":117962},[],"/docs/es/platform/pki/crl#desde-la-interfaz","Desde la interfaz",{"_3328":69479,"_29138":69469,"_5":29458,"_20209":117964,"_26493":117965,"_2816":117966},[],"/docs/es/platform/pki/crl#referencias","Referencias",{"_3328":69480,"_29138":69469,"_20209":117968,"_5":13819,"_26493":69469,"_2816":117969},[],"Una CRL es una lista firmada de certificados revocados por un emisor. Esta guía sirve al operador que publica listas y al integrador que las utiliza localmente. Necesitas el certificado de la CA emisora, su SKI y acceso al endpoint publicado. El cliente debe mantener una copia vigente: funcionar offline no elimina la necesidad de renovar la evidencia.",{"_3328":69481,"_29138":69469,"_20209":117971,"_5":13819,"_26493":117933,"_2816":117972},[],"El rol VA guarda la configuración y los metadatos de la última lista publicada para el SKI de una CA. La generación requiere una clave emisora utilizable; no presupongas que una CA importada sin clave tiene una CRL disponible.",{"_3328":69482,"_29138":69469,"_20209":117974,"_5":13819,"_26493":117933,"_2816":117975},[],"Campo de `crl_options`",{"_3328":69483,"_29138":69469,"_20209":117977,"_5":13819,"_26493":117933,"_2816":114445},[],{"_3328":69484,"_29138":69469,"_20209":117979,"_5":13819,"_26493":117933,"_2816":117980},[],"Valor inicial del backend",{"_3328":69485,"_29138":69469,"_20209":117982,"_5":13819,"_26493":117933,"_2816":54069},[],{"_3328":69486,"_29138":69469,"_20209":117984,"_5":13819,"_26493":117933,"_2816":117985},[],"Tiempo desde `thisUpdate` hasta `nextUpdate`.",{"_3328":69487,"_29138":69469,"_20209":117987,"_5":13819,"_26493":117933,"_2816":117988},[],"7 días.",{"_3328":69488,"_29138":69469,"_20209":117990,"_5":13819,"_26493":117933,"_2816":54078},[],{"_3328":69489,"_29138":69469,"_20209":117992,"_5":13819,"_26493":117933,"_2816":117993},[],"Se guarda y se devuelve por la API, pero la VA no lo utiliza: la renovación programada no depende de él (consulta Regeneración periódica y automática).",{"_3328":69490,"_29138":69469,"_20209":117995,"_5":13819,"_26493":117933,"_2816":117996},[],"6 días y 23 horas.",{"_3328":69491,"_29138":69469,"_20209":117998,"_5":13819,"_26493":117933,"_2816":54087},[],{"_3328":69492,"_29138":69469,"_20209":118000,"_5":13819,"_26493":117933,"_2816":118001},[],"Solicitar regeneración por eventos de revocación o reactivación desde `CertificateHold`.",{"_3328":69493,"_29138":69469,"_20209":118003,"_5":13819,"_26493":117933,"_2816":54093},[],{"_3328":69494,"_29138":69469,"_20209":118005,"_5":13819,"_26493":117933,"_2816":54096},[],{"_3328":69495,"_29138":69469,"_20209":118007,"_5":13819,"_26493":117933,"_2816":118008},[],"Número de serie del certificado existente que firma la CRL.",{"_3328":69496,"_29138":69469,"_20209":118010,"_5":13819,"_26493":117933,"_2816":118011},[],"Número de serie del certificado actual de la CA.",{"_3328":69497,"_29138":69469,"_20209":118013,"_5":13819,"_26493":117933,"_2816":118014},[],"El firmante debe ser un certificado existente con el uso `cRLSign`, el mismo sujeto y la misma clave pública que la CA. Quedan incluidos los certificados anteriores a una reemisión. No se admite un firmante delegado: un certificado con el sujeto de la CA pero con otra clave se rechaza.",{"_3328":69498,"_29138":69469,"_20209":118016,"_5":13819,"_26493":117933,"_2816":118017},[],"Al reemitir una CA, el rol sigue apuntando al certificado anterior. Las CRL siguen siendo válidas porque ambos certificados comparten sujeto y clave, pero el certificado anterior no puede eliminarse mientras el rol lo use. Para retirarlo, actualiza el firmante del rol.",{"_3328":69499,"_29138":69469,"_20209":118019,"_5":13819,"_26493":117933,"_2816":118020},[],"Al eliminar una CA, su rol VA se conserva y no puede borrarse por API. Si no queda ninguna otra CA con el mismo SKI, el rol puede consultarse pero cualquier `PUT` devuelve 404, y el trabajo de renovación registra un aviso en cada ciclo porque ya no encuentra la CA. La API no ofrece salida; solo se corrige editando la base de datos. Si queda otra CA con ese SKI, el rol sigue siendo editable (consulta CAs que comparten clave). Ajusta validez y firmante antes de eliminar la CA.",{"_3328":69500,"_29138":69469,"_20209":118022,"_5":13819,"_26493":117933,"_2816":118023},[],"Una CA cuyo certificado no tiene `cRLSign` no puede generar su CRL ni editar su rol (error 400). Desde 4.0 la VA exige este uso. Comprueba antes de importar con `openssl x509 -noout -ext keyUsage` y, si falta, obtén un certificado de la misma CA y clave que lo incluya y asígnalo como firmante con `PUT`. Tras reemitir una CA, comprueba también el uso de clave del certificado nuevo: puede no conservar los usos del original.",{"_3328":69501,"_29138":69469,"_20209":118025,"_5":13819,"_26493":117933,"_2816":118026},[],"El `PUT` valida siempre el firmante, aunque la petición no lo cambie. Si el firmante guardado ya no es válido, no se puede modificar ningún campo del rol, ni siquiera la validez, hasta asignar uno válido.",{"_3328":69502,"_29138":69469,"_20209":118028,"_5":13819,"_26493":117933,"_2816":118029},[],"`latest_crl` contiene versión, inicio y fin de validez. Las versiones se conservan en el almacenamiento de objetos como PEM bajo `pki/va/crl/{subject_key_id}/{version}.crl`; el endpoint público entrega DER.",{"_3328":69503,"_29138":69469,"_20209":118031,"_5":13819,"_26493":117937,"_2816":118032},[],"La VA identifica cada CRL por el SKI de la CA, y el SKI se deriva de su clave. Dos CAs con la misma clave tienen el mismo SKI y comparten un único rol VA y una única CRL. Ocurre al crear una CA sobre una clave ya existente del KMS, o al importar una CA cuyo certificado declara un SKI en uso. Lamassu toma el SKI del certificado importado tal cual y no comprueba que corresponda a su clave pública. El rol lo crea la primera CA y las demás lo conservan.",{"_3328":69504,"_29138":69469,"_20209":118034,"_5":13819,"_26493":117937,"_2816":118035},[],"Los certificados de todas ellas apuntan a `/crl/{ski}`, pero la lista publicada tiene como emisor a la primera CA y solo incluye sus revocaciones. Un verificador compara el emisor de la CRL con el del certificado que valida (RFC 5280, §6.3.2) y rechaza la lista si no coinciden. Según su política, el certificado queda bloqueado (*hard-fail*) o se acepta aunque esté revocado (*soft-fail*). Las revocaciones de las CAs secundarias no aparecen en ninguna lista.",{"_3328":69505,"_29138":69469,"_20209":118037,"_5":13819,"_26493":117937,"_2816":118038},[],"Si la primera CA se elimina, la generación de CRL de la restante falla porque el firmante configurado ya no corresponde a una CA con ese nombre. Hasta que se actualice el firmante del rol a un certificado de la CA restante, se sigue sirviendo la última lista publicada hasta que venza (7 días por defecto).",{"_3328":69506,"_29138":69469,"_20209":118040,"_5":13819,"_26493":117937,"_2816":118041},[],"Para detectar el problema, compara el SKI de las CAs en el inventario: dos con el mismo SKI están afectadas. Para resolverlo, crea una CA con clave propia y reemite sus certificados; los ya emitidos conservan la URL antigua y no se corrigen hasta reemitirlos. Una CA importada con un SKI ya en uso no sustituye a la existente como emisora de la CRL, porque el emisor se resuelve a partir del firmante del rol. Sin embargo, sus propios certificados apuntan a esa misma URL y sus revocaciones no se publican. Hasta que Lamassu rechace estas importaciones, limita el permiso de importar CAs como control provisional; cubre solo la vía de importación. Crear una CA con &#x2A;*Create New CA (Existing Key)** sobre una clave KMS que otra CA ya usa produce la misma colisión, así que tampoco reutilices claves entre CAs. Una CRL por CA y el rechazo de importaciones cuyo SKI colisiona con el de una CA existente están planteados en lamassuiot#834, y ninguno está implementado todavía.",{"_3328":69507,"_29138":69469,"_20209":118043,"_5":13819,"_26493":117941,"_2816":118044},[],"El trabajo programado de la VA revisa todos los roles en cada ejecución y solicita otra lista cuando a `latest_crl` le queda menos validez que el intervalo entre ejecuciones. La frecuencia se configura en Helm con `services.va.job.crl.frequency` (por defecto `0 * * * *`) y admite una duración (`1h`) o una expresión cron. Una expresión cron se convierte en un intervalo constante igual al tiempo que falta para su siguiente disparo cuando arranca el servicio, así que no se alinea con el reloj. `refresh_interval` no interviene. Mantén `validity` claramente por encima del intervalo: con una validez menor, la lista se regenera en cada ciclo.",{"_3328":69508,"_29138":69469,"_20209":118046,"_5":13819,"_26493":117941,"_2816":118047},[],"Si la generación falla (por ejemplo, por un rol sin CA o un firmante inválido), el trabajo registra el aviso `something went wrong while calculating CRL for CA <ski>` y lo reintenta en el ciclo siguiente. No hay otra vía de renovación hasta corregir la causa, y la última lista publicada se sigue sirviendo hasta vencer. Todo ello depende de que el trabajo, el almacenamiento y la firma funcionen.",{"_3328":69509,"_29138":69469,"_20209":118049,"_5":13819,"_26493":117941,"_2816":118050},[],"Con `regenerate_on_revoke`, el manejador de eventos solicita una nueva CRL cuando recibe una revocación o la reactivación de un certificado desde `CertificateHold` a `ACTIVE`. Es un paso posterior al cambio de estado, con sus propios posibles errores: si falla (rol inexistente, firmante inválido), el evento se reintenta y, agotados los reintentos, pasa a la cola de eventos fallidos. Confirmar la revocación no demuestra que la CRL nueva ya esté publicada ni que todos los clientes la hayan descargado.",{"_3328":69510,"_29138":69469,"_20209":118052,"_5":13819,"_26493":117941,"_2816":118053},[],"Comprueba el número de CRL y sus tiempos antes y después del cambio. Supervisa listas vencidas y fallos de generación; los clientes deben aplicar su política cuando no disponen de evidencia vigente.",{"_3328":69511,"_29138":69469,"_20209":118055,"_5":13819,"_26493":117945,"_2816":118056},[],"Cada entrada incluye serie, fecha de revocación y razón. El generador consulta certificados en estado `REVOKED` para la CA seleccionada. Un certificado reactivado deja de aparecer al recalcular la lista; una copia descargada anteriormente conserva su contenido.",{"_3328":69512,"_29138":69469,"_20209":118058,"_5":13819,"_26493":117945,"_2816":118059},[],"La lista incluye un *Issuing Distribution Point* crítico (OID `2.5.29.28`) con las URLs de distribución configuradas. Comprueba que tu cliente interpreta esa extensión y que corresponde al ámbito de la lista. Si la rechaza, investiga el formato y el alcance; ignorar una extensión crítica no es una validación satisfactoria.",{"_3328":69513,"_29138":69469,"_20209":118061,"_5":13819,"_26493":117949,"_2816":118062},[],"El servicio VA expone `GET /crl/{subject_key_id}` sin autorización de gestión. Usa el SKI de la **CA emisora**, no el SKI del certificado final ni su número de serie. Inspecciona primero el CDP del certificado:",{"_3328":69514,"_29138":69469,"_20209":118064,"_5":13819,"_26493":117949,"_2816":118065},[],"Sustituye la URL siguiente por la del CDP y revisa la exposición en Despliegue:",{"_3328":69515,"_29138":69469,"_20209":118067,"_5":13819,"_26493":117949,"_2816":118068},[],"Necesitas OpenSSL 3.x e `issuer.pem` con el certificado del emisor directo. Exige firma válida, tiempos vigentes y emisor esperado. Para una prueba con una raíz que emite directamente:",{"_3328":69516,"_29138":69469,"_20209":118070,"_5":13819,"_26493":117949,"_2816":118071},[],"`roots.pem` contiene las raíces deliberadamente confiables. Si hay intermedias, añade `-untrusted intermediates.pem` antes del argumento `device.crt`. `-crl_check` comprueba la revocación del certificado final usando la lista local; no descarga otras listas ni demuestra el estado de toda la cadena. Para comprobarla completa, necesitas las CRL correspondientes y una política que las exija.",{"_3328":69517,"_29138":69469,"_20209":118073,"_5":13819,"_26493":117949,"_2816":118074},[],"La prueba debe aceptar un certificado permitido que no esté en la lista y rechazarlo con `certificate revoked` después de publicar y utilizar la lista que contiene su serie.",{"_3328":69518,"_29138":69469,"_20209":118076,"_5":13819,"_26493":117953,"_2816":118077},[],"Los paths siguientes son relativos al servicio VA; el prefijo público debe confirmarse en el Gateway. No son las URLs de los endpoints públicos de OCSP y CRL.",{"_3328":69519,"_29138":69469,"_20209":118079,"_5":13819,"_26493":117953,"_2816":114634},[],{"_3328":69520,"_29138":69469,"_20209":118081,"_5":13819,"_26493":117953,"_2816":118082},[],"Path relativo",{"_3328":69521,"_29138":69469,"_20209":118084,"_5":13819,"_26493":117953,"_2816":112670},[],{"_3328":69522,"_29138":69469,"_20209":118086,"_5":13819,"_26493":117953,"_2816":54178},[],{"_3328":69523,"_29138":69469,"_20209":118088,"_5":13819,"_26493":117953,"_2816":54181},[],{"_3328":69524,"_29138":69469,"_20209":118090,"_5":13819,"_26493":117953,"_2816":118091},[],"Consultar `crl_options` y `latest_crl`.",{"_3328":69525,"_29138":69469,"_20209":118093,"_5":13819,"_26493":117953,"_2816":54187},[],{"_3328":69526,"_29138":69469,"_20209":118095,"_5":13819,"_26493":117953,"_2816":54181},[],{"_3328":69527,"_29138":69469,"_20209":118097,"_5":13819,"_26493":117953,"_2816":118098},[],"Sustituir la configuración de CRL.",{"_3328":69528,"_29138":69469,"_20209":118100,"_5":13819,"_26493":117953,"_2816":118101},[],"Necesitas autenticación y permisos de lectura o actualización del rol. Consulta la Referencia API y el control de acceso de tu instalación. Lee la configuración actual antes de actualizarla y envía el objeto completo esperado por el contrato: el backend sustituye `crl_options`; no fusiona campos omitidos.",{"_3328":69529,"_29138":69469,"_20209":118103,"_5":13819,"_26493":117953,"_2816":118104},[],"Después de un cambio, comprueba la configuración guardada y la siguiente lista efectivamente publicada. Modificar el rol no prueba por sí solo regeneración ni aceptación por el cliente.",{"_3328":69530,"_29138":69469,"_20209":118106,"_5":13819,"_26493":117957,"_2816":118107},[],"Síntoma",{"_3328":69531,"_29138":69469,"_20209":118109,"_5":13819,"_26493":117957,"_2816":118110},[],"Causa",{"_3328":69532,"_29138":69469,"_20209":118112,"_5":13819,"_26493":117957,"_2816":118113},[],"Acción",{"_3328":69533,"_29138":69469,"_20209":118115,"_5":13819,"_26493":117957,"_2816":118116},[],"`PUT /v1/roles/{ca-ski}` devuelve 404 y `GET` devuelve 200.",{"_3328":69534,"_29138":69469,"_20209":118118,"_5":13819,"_26493":117957,"_2816":118119},[],"Se eliminó la CA del rol y no queda otra con el mismo SKI.",{"_3328":69535,"_29138":69469,"_20209":118121,"_5":13819,"_26493":117957,"_2816":118122},[],"No hay salida por API; requiere intervención en la base de datos. Evítalo ajustando el rol antes de eliminar la CA.",{"_3328":69536,"_29138":69469,"_20209":118124,"_5":13819,"_26493":117957,"_2816":118125},[],"`PUT` devuelve 400.",{"_3328":69537,"_29138":69469,"_20209":118127,"_5":13819,"_26493":117957,"_2816":118128},[],"El firmante no tiene `cRLSign`, o su sujeto y su clave no coinciden con ninguna CA de ese SKI (por ejemplo, tras eliminar la primera de dos CAs que comparten clave).",{"_3328":69538,"_29138":69469,"_20209":118130,"_5":13819,"_26493":117957,"_2816":118131},[],"Asigna con `PUT` el número de serie de un certificado válido de la CA restante.",{"_3328":69539,"_29138":69469,"_20209":118133,"_5":13819,"_26493":117957,"_2816":118134},[],"`PUT` devuelve 400 desde un cliente de 3.x.",{"_3328":69540,"_29138":69469,"_20209":118136,"_5":13819,"_26493":117957,"_2816":118137},[],"`crl_options.subject_key_id_signer` se sustituyó por `signer_certificate_serial_number`, que es obligatorio.",{"_3328":69541,"_29138":69469,"_20209":118139,"_5":13819,"_26493":117957,"_2816":118140},[],"Actualiza el cliente para enviar el campo nuevo.",{"_3328":69542,"_29138":69469,"_20209":118142,"_5":13819,"_26493":117957,"_2816":118143},[],"La CRL no cambia tras revocar un certificado.",{"_3328":69543,"_29138":69469,"_20209":118145,"_5":13819,"_26493":117957,"_2816":118146},[],"`regenerate_on_revoke` es `false`, o el evento falló por falta de rol o por un firmante inválido.",{"_3328":69544,"_29138":69469,"_20209":118148,"_5":13819,"_26493":117957,"_2816":118149},[],"Revisa los logs de la VA y la cola de eventos fallidos; corrige el firmante.",{"_3328":69545,"_29138":69469,"_20209":118151,"_5":13819,"_26493":117957,"_2816":118152},[],"Un verificador rechaza la CRL por el emisor.",{"_3328":69546,"_29138":69469,"_20209":118154,"_5":13819,"_26493":117957,"_2816":118155},[],"Varias CAs comparten SKI.",{"_3328":69547,"_29138":69469,"_20209":118157,"_5":13819,"_26493":117957,"_2816":118158},[],"Consulta CAs que comparten clave.",{"_3328":69548,"_29138":69469,"_20209":118160,"_5":13819,"_26493":117961,"_2816":118161},[],"La vista de la CA permite inspeccionar y descargar la lista disponible. Compara versión, emisor y tiempos con la copia descargada desde el endpoint público. Para diagnosticar una diferencia, sigue Diagnóstico PKI.",{"_3328":69549,"_29138":69469,"_20209":118163,"_5":13819,"_26493":117965,"_2816":118164},[],"RFC 5280: perfil X.509 y CRL.",{"_3328":69550,"_29138":69469,"_20209":118166,"_5":13819,"_26493":117965,"_2816":54261},[],{"_3328":69551,"_29138":69469,"_20209":118168,"_5":13819,"_26493":117965,"_2816":54264},[],{"_3328":69552,"_29138":69469,"_20209":118170,"_5":13819,"_26493":117965,"_2816":118171},[],"<Card title=\"Servicio OCSP\" href=\"/docs/platform/pki/ocsp\" />",{"_3328":69553,"_29138":69469,"_20209":118173,"_5":13819,"_26493":117965,"_2816":118174},[],"<Card title=\"Validación de certificados\" href=\"/docs/platform/pki/certificate-validation\" />",{"_3328":69554,"_29138":69554,"_5":14177,"_2816":118176,"_29461":118177,"_20209":118178,"_26493":69554},"Claves y motores criptográficos",[47397,112910,52871,116789],[],{"_3328":69555,"_29138":69554,"_20209":118180,"_5":13819,"_26493":69554,"_2816":118181},[],"Genera, importa y opera claves sin acoplar la PKI a un proveedor concreto.",{"_3328":69556,"_29138":69554,"_5":29458,"_20209":118183,"_26493":118184,"_2816":118185},[],"/docs/es/platform/pki/key-management#qué-resuelve-el-kms","Qué resuelve el KMS",{"_3328":69557,"_29138":69554,"_5":29458,"_20209":118187,"_26493":118188,"_2816":118189},[],"/docs/es/platform/pki/key-management#motores-criptográficos","Motores criptográficos",{"_3328":69558,"_29138":69554,"_5":29458,"_20209":118191,"_26493":118192,"_2816":54289},[],"/docs/es/platform/pki/key-management#file-system",{"_3328":69559,"_29138":69554,"_5":29458,"_20209":118194,"_26493":118195,"_2816":54293},[],"/docs/es/platform/pki/key-management#hashicorp-vault",{"_3328":69560,"_29138":69554,"_5":29458,"_20209":118197,"_26493":118198,"_2816":54297},[],"/docs/es/platform/pki/key-management#aws-secrets-manager",{"_3328":69561,"_29138":69554,"_5":29458,"_20209":118200,"_26493":118201,"_2816":54301},[],"/docs/es/platform/pki/key-management#aws-kms",{"_3328":69562,"_29138":69554,"_5":29458,"_20209":118203,"_26493":118204,"_2816":54305},[],"/docs/es/platform/pki/key-management#pkcs11",{"_3328":69563,"_29138":69554,"_5":29458,"_20209":118206,"_26493":118207,"_2816":54309},[],"/docs/es/platform/pki/key-management#azure-key-vault",{"_3328":69564,"_29138":69554,"_5":29458,"_20209":118209,"_26493":118210,"_2816":118211},[],"/docs/es/platform/pki/key-management#inventario-de-claves","Inventario de claves",{"_3328":69565,"_29138":69554,"_5":29458,"_20209":118213,"_26493":118214,"_2816":118215},[],"/docs/es/platform/pki/key-management#crear-o-importar-claves","Crear o importar claves",{"_3328":69566,"_29138":69554,"_5":29458,"_20209":118217,"_26493":118218,"_2816":118219},[],"/docs/es/platform/pki/key-management#generar-un-nuevo-par-de-claves","Generar un nuevo par de claves",{"_3328":69567,"_29138":69554,"_5":29458,"_20209":118221,"_26493":118222,"_2816":118223},[],"/docs/es/platform/pki/key-management#importar-un-par-existente","Importar un par existente",{"_3328":69568,"_29138":69554,"_5":29458,"_20209":118225,"_26493":118226,"_2816":118227},[],"/docs/es/platform/pki/key-management#operaciones-sobre-una-clave","Operaciones sobre una clave",{"_3328":69569,"_29138":69554,"_5":29458,"_20209":118229,"_26493":118230,"_2816":118231},[],"/docs/es/platform/pki/key-management#ver-detalles","Ver detalles",{"_3328":69570,"_29138":69554,"_5":29458,"_20209":118233,"_26493":118234,"_2816":118235},[],"/docs/es/platform/pki/key-management#firmar-y-verificar","Firmar y verificar",{"_3328":69571,"_29138":69554,"_5":29458,"_20209":118237,"_26493":118238,"_2816":54341},[],"/docs/es/platform/pki/key-management#sign",{"_3328":69572,"_29138":69554,"_5":29458,"_20209":118240,"_26493":118241,"_2816":54345},[],"/docs/es/platform/pki/key-management#verify",{"_3328":69573,"_29138":69554,"_5":29458,"_20209":118243,"_26493":118244,"_2816":118245},[],"/docs/es/platform/pki/key-management#generar-un-csr","Generar un CSR",{"_3328":69574,"_29138":69554,"_5":29458,"_20209":118247,"_26493":118248,"_2816":118249},[],"/docs/es/platform/pki/key-management#firma-local-con-pkcs11","Firma local con PKCS#11",{"_3328":69575,"_29138":69554,"_5":29458,"_20209":118251,"_26493":118252,"_2816":118253},[],"/docs/es/platform/pki/key-management#antes-de-eliminar-una-clave","Antes de eliminar una clave",{"_3328":69576,"_29138":69554,"_20209":118255,"_5":13819,"_26493":69554,"_2816":118256},[],"El servicio de Gestión de Claves Criptográficas (KMS) de Lamassu IoT centraliza la generación, importación, custodia y uso de las claves de la plataforma. Desde aquí se gestionan las claves que soportan a las CAs y al resto de operaciones de firma que dependen de la PKI.",{"_3328":69577,"_29138":69554,"_20209":118258,"_5":13819,"_26493":69554,"_2816":118259},[],"En la configuración actual, Lamassu IoT trabaja exclusivamente con claves asimétricas, como RSA y curvas elípticas. Estas claves se usan para emitir certificados X.509, firmar solicitudes y realizar operaciones de autenticación y validación dentro del sistema.",{"_3328":69578,"_29138":69554,"_20209":118261,"_5":13819,"_26493":118184,"_2816":118262},[],"El KMS unifica la gestión del ciclo de vida de las claves y evita que cada servicio tenga que integrarse directamente con un proveedor criptográfico concreto.",{"_3328":69579,"_29138":69554,"_20209":118264,"_5":13819,"_26493":118184,"_2816":118265},[],"En la práctica, permite:",{"_3328":69580,"_29138":69554,"_20209":118267,"_5":13819,"_26493":118184,"_2816":118268},[],"Generar nuevos pares de claves desde Lamassu IoT.",{"_3328":69581,"_29138":69554,"_20209":118270,"_5":13819,"_26493":118184,"_2816":118271},[],"Importar claves creadas externamente.",{"_3328":69582,"_29138":69554,"_20209":118273,"_5":13819,"_26493":118184,"_2816":118274},[],"Delegar la custodia y las operaciones criptográficas en motores externos.",{"_3328":69583,"_29138":69554,"_20209":118276,"_5":13819,"_26493":118184,"_2816":118277},[],"Reutilizar claves ya existentes para CAs, CSR y tareas de firma o verificación.",{"_3328":69584,"_29138":69554,"_20209":118279,"_5":13819,"_26493":118188,"_2816":118280},[],"Lamassu puede trabajar con distintos motores criptográficos según los requisitos del despliegue. En algunos entornos bastará con un motor software; en otros será necesario delegar la custodia en un HSM, en un servicio cloud o en una plataforma especializada.",{"_3328":69585,"_29138":69554,"_20209":118282,"_5":13819,"_26493":118188,"_2816":118283},[],"Una misma instancia puede tener varios motores configurados al mismo tiempo, incluso varias instancias del mismo tipo. Esto permite adaptar la operación a distintos niveles de seguridad, coste y requisitos regulatorios.",{"_3328":69586,"_29138":69554,"_20209":118285,"_5":13819,"_26493":118188,"_2816":118286},[],"Esta guía se dirige al operador PKI: elige y utiliza un motor ya habilitado. La instalación, credenciales, almacenamiento persistente y conectividad corresponden a Despliegue. Antes de generar una CA, comprueba el motor predeterminado, los algoritmos publicados y que una firma de prueba funciona. La disponibilidad en tu instalación depende de su versión y configuración.",{"_3328":69587,"_29138":69554,"_20209":118288,"_5":13819,"_26493":118192,"_2816":118289},[],"Genera claves software y almacena el material privado en archivos. Su custodia depende de permisos, almacenamiento y copias de seguridad de la instalación. Antes de utilizarlo para una CA operativa, acuerda cómo se recuperará la clave y cómo accederán a ella las réplicas; el registro del KMS no sustituye esos archivos.",{"_3328":69588,"_29138":69554,"_20209":118291,"_5":13819,"_26493":118195,"_2816":118292},[],"El adaptador utiliza almacenamiento KV para el material privado. No equivale a una operación de firma dentro de Vault Transit: quien pueda leer el secreto puede recuperar la clave. Revisa los permisos de lectura, disponibilidad y recuperación con el responsable de Despliegue.",{"_3328":69589,"_29138":69554,"_20209":118294,"_5":13819,"_26493":118195,"_2816":118295},[],"El adaptador se comunica con Vault a través de su endpoint HTTP(S) configurado. El certificado del servidor de Vault se verifica contra el almacén de confianza del sistema; para confiar en un Vault con certificado emitido por una CA privada, añade ese certificado de CA al `ca_cert_file` del motor (codificado en PEM). `insecure_skip_verify=true` desactiva la verificación y es un último recurso; acuerda los ajustes de transporte con el responsable de Despliegue.",{"_3328":69590,"_29138":69554,"_20209":118297,"_5":13819,"_26493":118198,"_2816":118298},[],"Ofrece persistencia cifrada en AWS con coste asociado. Protege la clave en reposo, pero un administrador autorizado puede recuperarla; no proporciona la misma resistencia a la extracción que un KMS o HSM.",{"_3328":69591,"_29138":69554,"_20209":118300,"_5":13819,"_26493":118201,"_2816":118301},[],"Delega las firmas en el servicio AWS KMS. El adaptador también contempla importación de material externo, sujeta a las capacidades y permisos del proveedor. Una clave generada fuera del servicio ya ha existido fuera de su custodia; importarla no elimina esas copias. Comprueba generación, importación y firma como operaciones distintas.",{"_3328":69592,"_29138":69554,"_20209":118303,"_5":13819,"_26493":118204,"_2816":118304},[],"Permite integrar HSMs locales, entornos aislados y servicios *Key as a Service*. La generación, persistencia y resistencia a la extracción dependen del dispositivo o proveedor concreto. Es la opción más flexible cuando la política exige custodia hardware.",{"_3328":69593,"_29138":69554,"_20209":118306,"_5":13819,"_26493":118207,"_2816":118307},[],"El backend también dispone de adaptadores para **Key Vault Keys** y **Key Vault Secrets**. El primero delega firmas al servicio de claves; el segundo conserva material privado como secretos y firma con ese material. No intercambies ambos modelos de custodia. Confirma qué adaptador está habilitado en tu instalación y prueba las operaciones necesarias.",{"_3328":69594,"_29138":69554,"_20209":118309,"_5":13819,"_26493":118207,"_2816":118310},[],"Lamassu muestra en la consola el listado de motores habilitados.",{"_3328":69595,"_29138":69554,"_20209":118312,"_5":13819,"_26493":118207,"_2816":118313},[],"Cada motor define qué algoritmos soporta, como RSA o ECC/ECDSA, y qué tamaños de clave puede generar.",{"_3328":69596,"_29138":69554,"_20209":118315,"_5":13819,"_26493":118207,"_2816":118316},[],"Revisa con el operador de Despliegue qué motor está definido como predeterminado. Ese motor se utilizará cuando un proceso necesite crear o persistir una clave y el usuario no haya seleccionado uno específico, por ejemplo al crear o importar una CA.",{"_3328":69597,"_29138":69554,"_20209":118318,"_5":13819,"_26493":118210,"_2816":118319},[],"La pantalla principal de KMS muestra el inventario completo de claves registradas en el sistema. Es la vista de referencia para revisar qué claves existen, dónde están custodiadas y con qué entidades están relacionadas.",{"_3328":69598,"_29138":69554,"_20209":118321,"_5":13819,"_26493":118210,"_2816":118322},[],"La tabla incluye los siguientes campos:",{"_3328":69599,"_29138":69554,"_20209":118324,"_5":13819,"_26493":118210,"_2816":118325},[],"**Name**: nombre descriptivo de la clave.",{"_3328":69600,"_29138":69554,"_20209":118327,"_5":13819,"_26493":118210,"_2816":118328},[],"**Type**: algoritmo y tamaño de clave, por ejemplo RSA 2048 o EC P-256.",{"_3328":69601,"_29138":69554,"_20209":118330,"_5":13819,"_26493":118210,"_2816":118331},[],"**Strength**: indicador visual de fortaleza criptográfica.",{"_3328":69602,"_29138":69554,"_20209":118333,"_5":13819,"_26493":118210,"_2816":118334},[],"**Public/Private**: indica si Lamassu gestiona el par completo o solo la clave pública.",{"_3328":69603,"_29138":69554,"_20209":118336,"_5":13819,"_26493":118210,"_2816":118337},[],"**Crypto Engine**: motor criptográfico que custodia la clave.",{"_3328":69604,"_29138":69554,"_20209":118339,"_5":13819,"_26493":118210,"_2816":118340},[],"**Aliases**: nombres alternativos asociados a la clave.",{"_3328":69605,"_29138":69554,"_20209":118342,"_5":13819,"_26493":118210,"_2816":118343},[],"**Tags**: etiquetas para clasificación y búsqueda.",{"_3328":69606,"_29138":69554,"_20209":118345,"_5":13819,"_26493":118210,"_2816":118346},[],"**Related Entities**: certificados u otras entidades vinculadas a esa clave.",{"_3328":69607,"_29138":69554,"_20209":118348,"_5":13819,"_26493":118210,"_2816":118349},[],"Desde esta vista también se accede a las acciones más habituales:",{"_3328":69608,"_29138":69554,"_20209":118351,"_5":13819,"_26493":118210,"_2816":118352},[],"**View Details** para consultar metadatos, identificadores y relaciones.",{"_3328":69609,"_29138":69554,"_20209":118354,"_5":13819,"_26493":118210,"_2816":118355},[],"**Generate CSR** para crear una solicitud PKCS#10 con la clave seleccionada.",{"_3328":69610,"_29138":69554,"_20209":118357,"_5":13819,"_26493":118210,"_2816":118358},[],"**Sign / Verify** para probar operaciones criptográficas sobre la clave.",{"_3328":69611,"_29138":69554,"_20209":118360,"_5":13819,"_26493":118210,"_2816":118361},[],"**Delete Key** para eliminar la clave del sistema.",{"_3328":69612,"_29138":69554,"_20209":118363,"_5":13819,"_26493":118214,"_2816":118364},[],"Necesitas permisos de administración de claves y un motor accesible. El perfil de emisión debe admitir el algoritmo que eliges si la clave va a utilizarse en una CA o CSR. Abre **Create New Key** y elige generación o importación.",{"_3328":69613,"_29138":69554,"_20209":118366,"_5":13819,"_26493":118218,"_2816":118367},[],"Si la clave va a nacer dentro de Lamassu, el flujo recomendado es generar un nuevo par gestionado directamente por uno de los motores configurados.",{"_3328":69614,"_29138":69554,"_20209":118369,"_5":13819,"_26493":118218,"_2816":118370},[],"En la primera pantalla del asistente, elige **Generate New Key Pair** y después define los parámetros principales:",{"_3328":69615,"_29138":69554,"_20209":118372,"_5":13819,"_26493":118218,"_2816":118373},[],"**Key Name**: nombre único y descriptivo.",{"_3328":69616,"_29138":69554,"_20209":118375,"_5":13819,"_26493":118218,"_2816":118376},[],"**Crypto Engine**: motor que custodiará la clave.",{"_3328":69617,"_29138":69554,"_20209":118378,"_5":13819,"_26493":118218,"_2816":118379},[],"**Key Type** y **Key Size**: algoritmo y tamaño o curva.",{"_3328":69618,"_29138":69554,"_20209":118381,"_5":13819,"_26493":118218,"_2816":118382},[],"**Tags**: metadatos para clasificar la clave.",{"_3328":69619,"_29138":69554,"_20209":118384,"_5":13819,"_26493":118218,"_2816":118385},[],"**Metadata**: información adicional para usos avanzados.",{"_3328":69620,"_29138":69554,"_20209":118387,"_5":13819,"_26493":118222,"_2816":118388},[],"La importación permite registrar en Lamassu una clave generada fuera de la plataforma. Es el flujo habitual en escenarios BYOK, migraciones o integración con material criptográfico que ya está en producción.",{"_3328":69621,"_29138":69554,"_20209":118390,"_5":13819,"_26493":118222,"_2816":118391},[],"Cuando tienes una clave privada exportable y el motor de destino admite su importación.",{"_3328":69622,"_29138":69554,"_20209":118393,"_5":13819,"_26493":118222,"_2816":118394},[],"Cuando se necesita migrar una PKI existente sin reemitir certificados.",{"_3328":69623,"_29138":69554,"_20209":118396,"_5":13819,"_26493":118222,"_2816":118397},[],"Cuando Lamassu debe operar con una raíz de confianza creada por un tercero.",{"_3328":69624,"_29138":69554,"_20209":118399,"_5":13819,"_26493":118222,"_2816":118400},[],"En el asistente, elige **Import Existing Key Pair** y completa los campos solicitados:",{"_3328":69625,"_29138":69554,"_20209":118402,"_5":13819,"_26493":118222,"_2816":118403},[],"**Key Name**: nombre descriptivo dentro de Lamassu IoT.",{"_3328":69626,"_29138":69554,"_20209":118405,"_5":13819,"_26493":118222,"_2816":118406},[],"**Crypto Engine**: motor que custodiará la clave importada.",{"_3328":69627,"_29138":69554,"_20209":118408,"_5":13819,"_26493":118222,"_2816":118409},[],"**Tags**: etiquetas para organización y búsqueda.",{"_3328":69628,"_29138":69554,"_20209":118411,"_5":13819,"_26493":118222,"_2816":118412},[],"**Metadata**: información adicional opcional.",{"_3328":69629,"_29138":69554,"_20209":118414,"_5":13819,"_26493":118222,"_2816":118415},[],"**Private Key (PEM)**: clave privada en formato PEM.",{"_3328":69630,"_29138":69554,"_20209":118417,"_5":13819,"_26493":118222,"_2816":118418},[],"Si la importación termina correctamente, abre el registro, comprueba motor y clave pública y realiza una firma de prueba. Una clave no exportable en un HSM no puede cargarse mediante este formulario PEM: configura el acceso al motor y comprueba cómo se registra la clave existente. Revisa dependencias y recursos que puedan haberse creado en el proveedor si una operación falla a mitad.",{"_3328":69631,"_29138":69554,"_20209":118420,"_5":13819,"_26493":118226,"_2816":118421},[],"Cada clave registrada dispone de una vista de detalle y de varias acciones operativas.",{"_3328":69632,"_29138":69554,"_20209":118423,"_5":13819,"_26493":118230,"_2816":118424},[],"La pantalla **View Details** concentra la información técnica y administrativa de la clave.",{"_3328":69633,"_29138":69554,"_20209":118426,"_5":13819,"_26493":118230,"_2816":118427},[],"En la pestaña **Overview** se muestran, entre otros, estos campos:",{"_3328":69634,"_29138":69554,"_20209":118429,"_5":13819,"_26493":118230,"_2816":118430},[],"**Key Name**: nombre descriptivo.",{"_3328":69635,"_29138":69554,"_20209":118432,"_5":13819,"_26493":118230,"_2816":118433},[],"**Key Identifier**: identificador único del sistema. Lamassu utiliza formatos de ID basados en PKCS11.",{"_3328":69636,"_29138":69554,"_20209":118435,"_5":13819,"_26493":118230,"_2816":118436},[],"**Tags**: etiquetas asociadas.",{"_3328":69637,"_29138":69554,"_20209":118438,"_5":13819,"_26493":118230,"_2816":118439},[],"**Aliases**: nombres alternativos.",{"_3328":69638,"_29138":69554,"_20209":118441,"_5":13819,"_26493":118230,"_2816":118442},[],"**Crypto Engine**: motor en el que reside la clave.",{"_3328":69639,"_29138":69554,"_20209":118444,"_5":13819,"_26493":118230,"_2816":118445},[],"**Algorithm, Key Size & Strength**: algoritmo, parámetros y nivel de fortaleza.",{"_3328":69640,"_29138":69554,"_20209":118447,"_5":13819,"_26493":118230,"_2816":118448},[],"La sección **Related Entities** muestra qué objetos de Lamassu dependen de esa clave.",{"_3328":69641,"_29138":69554,"_20209":118450,"_5":13819,"_26493":118230,"_2816":118451},[],"La pestaña **Public Key** muestra el material público en PEM. El identificador y la URI del registro sirven para localizar la clave; una URI con formato PKCS#11 no demuestra que el motor sea un HSM ni que exista un módulo local para acceder a ella.",{"_3328":69642,"_29138":69554,"_20209":118453,"_5":13819,"_26493":118234,"_2816":118454},[],"La acción **Sign / Verify** sirve para validar que la clave y el motor criptográfico funcionan correctamente.",{"_3328":69643,"_29138":69554,"_20209":118456,"_5":13819,"_26493":118234,"_2816":118457},[],"Firma un mensaje de prueba, guarda la firma y verifícala con la misma clave pública, algoritmo y codificación. Cambia después el mensaje: la verificación debe fallar. Esto comprueba una operación concreta; no certifica todas las capacidades del motor ni la cadena de una CA.",{"_3328":69644,"_29138":69554,"_20209":118459,"_5":13819,"_26493":118234,"_2816":118460},[],"Al abrirla aparecen dos áreas: **Sign** y **Verify**.",{"_3328":69645,"_29138":69554,"_20209":118462,"_5":13819,"_26493":118238,"_2816":118463},[],"Esta pestaña usa la clave privada para generar una firma digital sobre un mensaje o sobre un *digest* ya calculado.",{"_3328":69646,"_29138":69554,"_20209":118465,"_5":13819,"_26493":118238,"_2816":118466},[],"Campos principales:",{"_3328":69647,"_29138":69554,"_20209":118468,"_5":13819,"_26493":118238,"_2816":118469},[],"**Algorithm**: algoritmo de firma disponible para el tipo de clave.",{"_3328":69648,"_29138":69554,"_20209":118471,"_5":13819,"_26493":118238,"_2816":118472},[],"**Message Type**: `Raw` para datos en claro o `Digest` para un hash precalculado.",{"_3328":69649,"_29138":69554,"_20209":118474,"_5":13819,"_26493":118238,"_2816":118475},[],"**Payload Encoding**: codificación de entrada, como UTF-8, Hex o Base64.",{"_3328":69650,"_29138":69554,"_20209":118477,"_5":13819,"_26493":118238,"_2816":118478},[],"**Message**: contenido que se va a firmar.",{"_3328":69651,"_29138":69554,"_20209":118480,"_5":13819,"_26493":118238,"_2816":118481},[],"**Signature**: resultado de la operación, mostrado en hexadecimal.",{"_3328":69652,"_29138":69554,"_20209":118483,"_5":13819,"_26493":118241,"_2816":118484},[],"Esta pestaña comprueba si una firma corresponde a la clave pública asociada.",{"_3328":69653,"_29138":69554,"_20209":118486,"_5":13819,"_26493":118241,"_2816":118466},[],{"_3328":69654,"_29138":69554,"_20209":118488,"_5":13819,"_26493":118241,"_2816":118489},[],"**Algorithm**: debe coincidir con el algoritmo usado para la firma.",{"_3328":69655,"_29138":69554,"_20209":118491,"_5":13819,"_26493":118241,"_2816":118492},[],"**Message Type**: `Raw` o `Digest`.",{"_3328":69656,"_29138":69554,"_20209":118494,"_5":13819,"_26493":118241,"_2816":118495},[],"**Payload Encoding**: codificación del mensaje.",{"_3328":69657,"_29138":69554,"_20209":118497,"_5":13819,"_26493":118241,"_2816":118498},[],"**Message**: mensaje original o hash.",{"_3328":69658,"_29138":69554,"_20209":118500,"_5":13819,"_26493":118241,"_2816":118501},[],"**Signature**: firma que se desea comprobar.",{"_3328":69659,"_29138":69554,"_20209":118503,"_5":13819,"_26493":118241,"_2816":118504},[],"**Result**: indicador del resultado de la validación.",{"_3328":69660,"_29138":69554,"_20209":118506,"_5":13819,"_26493":118244,"_2816":118507},[],"La acción **Generate CSR** crea una solicitud PKCS#10 firmada con la clave privada custodiada en Lamassu, sin exponerla fuera del motor criptográfico.",{"_3328":69661,"_29138":69554,"_20209":118509,"_5":13819,"_26493":118244,"_2816":118510},[],"Este flujo es útil para:",{"_3328":69662,"_29138":69554,"_20209":118512,"_5":13819,"_26493":118244,"_2816":118513},[],"Solicitar certificados a una CA externa.",{"_3328":69663,"_29138":69554,"_20209":118515,"_5":13819,"_26493":118244,"_2816":118516},[],"Renovar una identidad manteniendo la misma clave.",{"_3328":69664,"_29138":69554,"_20209":118518,"_5":13819,"_26493":118244,"_2816":118519},[],"Al abrir el formulario se solicitan los datos del sujeto y los atributos principales del certificado:",{"_3328":69665,"_29138":69554,"_20209":118521,"_5":13819,"_26493":118244,"_2816":118522},[],"**Common Name (CN)**: nombre principal de la identidad.",{"_3328":69666,"_29138":69554,"_20209":118524,"_5":13819,"_26493":118244,"_2816":118525},[],"**Organization (O)**: organización o empresa.",{"_3328":69667,"_29138":69554,"_20209":118527,"_5":13819,"_26493":118244,"_2816":118528},[],"**Organizational Unit (OU)**: departamento o unidad.",{"_3328":69668,"_29138":69554,"_20209":118530,"_5":13819,"_26493":118244,"_2816":118531},[],"**Country (C)**: código de país de dos letras.",{"_3328":69669,"_29138":69554,"_20209":118533,"_5":13819,"_26493":118244,"_2816":118534},[],"**State / Province (ST)**: estado o provincia.",{"_3328":69670,"_29138":69554,"_20209":118536,"_5":13819,"_26493":118244,"_2816":118537},[],"**Locality (L)**: ciudad o localidad.",{"_3328":69671,"_29138":69554,"_20209":118539,"_5":13819,"_26493":118244,"_2816":118540},[],"**Email Address**: correo de contacto.",{"_3328":69672,"_29138":69554,"_20209":118542,"_5":13819,"_26493":118244,"_2816":118543},[],"**Subject Alternative Names (SANs)**: nombres o identificadores alternativos, como DNS o IP.",{"_3328":69673,"_29138":69554,"_20209":118545,"_5":13819,"_26493":118244,"_2816":118546},[],"Descarga la CSR y ejecuta `openssl req -in request.csr -noout -verify -text`. Comprueba firma, sujeto y SAN antes de enviarla. La CSR no determina por sí sola el certificado final: la política de emisión puede sustituir sus campos.",{"_3328":69674,"_29138":69554,"_20209":118548,"_5":13819,"_26493":118248,"_2816":118549},[],"Lamassu también ofrece una ayuda específica para integraciones locales mediante **Sign locally with OpenSSL & PKCS11 tools**.",{"_3328":69675,"_29138":69554,"_20209":118551,"_5":13819,"_26493":118248,"_2816":54656},[],{"_3328":69676,"_29138":69554,"_20209":118553,"_5":13819,"_26493":118252,"_2816":118554},[],"Revisa **Related Entities** y localiza CAs, certificados y procesos de validación que siguen necesitando firmas. Revocar una CA no elimina la necesidad de publicar estado durante su periodo de retención. Eliminar una clave tampoco revoca automáticamente sus certificados. Planifica sustitución y retención antes de usar **Delete Key**; el efecto de borrado en el proveedor depende del motor.",{"_3328":69677,"_29138":69677,"_5":14177,"_2816":118556,"_29461":118557,"_20209":118558,"_26493":69677},"Validación online con OCSP",[47397,112910,52871,117414],[],{"_3328":69678,"_29138":69677,"_20209":118560,"_5":13819,"_26493":69677,"_2816":118561},[],"Consulta el estado firmado y verifica la respuesta del respondedor.",{"_3328":69679,"_29138":69677,"_5":29458,"_20209":118563,"_26493":118564,"_2816":118565},[],"/docs/es/platform/pki/ocsp#cómo-funciona-el-respondedor-en-lamassu","Cómo funciona el respondedor en Lamassu",{"_3328":69680,"_29138":69677,"_5":29458,"_20209":118567,"_26493":118568,"_2816":118569},[],"/docs/es/platform/pki/ocsp#enlace-en-los-certificados-emitidos","Enlace en los certificados emitidos",{"_3328":69681,"_29138":69677,"_5":29458,"_20209":118571,"_26493":118572,"_2816":118573},[],"/docs/es/platform/pki/ocsp#endpoints-http","Endpoints HTTP",{"_3328":69682,"_29138":69677,"_5":29458,"_20209":118575,"_26493":118576,"_2816":118577},[],"/docs/es/platform/pki/ocsp#genera-y-verifica-una-consulta","Genera y verifica una consulta",{"_3328":69683,"_29138":69677,"_5":29458,"_20209":118579,"_26493":118580,"_2816":118581},[],"/docs/es/platform/pki/ocsp#comprobación-desde-la-interfaz","Comprobación desde la interfaz",{"_3328":69684,"_29138":69677,"_5":29458,"_20209":118583,"_26493":118584,"_2816":117966},[],"/docs/es/platform/pki/ocsp#referencias",{"_3328":69685,"_29138":69677,"_20209":118586,"_5":13819,"_26493":69677,"_2816":118587},[],"OCSP permite consultar el estado de un certificado y obtener una respuesta firmada. Esta guía sirve al integrador que necesita comprobar qué publica Lamassu y cómo debe verificarlo el consumidor. Para la validación completa de una identidad, sigue Validación de certificados.",{"_3328":69686,"_29138":69677,"_20209":118589,"_5":13819,"_26493":118564,"_2816":118590},[],"El respondedor obtiene el certificado por número de serie y localiza su CA emisora en el inventario. Traduce el estado persistido así:",{"_3328":69687,"_29138":69677,"_20209":118592,"_5":13819,"_26493":118564,"_2816":118593},[],"Estado del registro",{"_3328":69688,"_29138":69677,"_20209":118595,"_5":13819,"_26493":118564,"_2816":118596},[],"Respuesta firmada",{"_3328":69689,"_29138":69677,"_20209":118598,"_5":13819,"_26493":118564,"_2816":52042},[],{"_3328":69690,"_29138":69677,"_20209":118600,"_5":13819,"_26493":118564,"_2816":54706},[],{"_3328":69691,"_29138":69677,"_20209":118602,"_5":13819,"_26493":118564,"_2816":52059},[],{"_3328":69692,"_29138":69677,"_20209":118604,"_5":13819,"_26493":118564,"_2816":118605},[],"`Revoked`, con razón y fecha de revocación.",{"_3328":69693,"_29138":69677,"_20209":118607,"_5":13819,"_26493":118564,"_2816":118608},[],"Otros estados, incluidos `INACTIVE` y `EXPIRED`",{"_3328":69694,"_29138":69677,"_20209":118610,"_5":13819,"_26493":118564,"_2816":118611},[],"`Unknown` si puede obtener el certificado y su emisor.",{"_3328":69695,"_29138":69677,"_20209":118613,"_5":13819,"_26493":118564,"_2816":118614},[],"Un número de serie ausente provoca un error de búsqueda; no garantiza una respuesta firmada `Unknown`. Los errores de búsqueda o firma se devuelven como fallo HTTP. Trata ese fallo como falta de evidencia, según la política del consumidor.",{"_3328":69696,"_29138":69677,"_20209":118616,"_5":13819,"_26493":118564,"_2816":118617},[],"La propia CA emisora firma la respuesta mediante su clave asociada al KMS. No se utiliza un certificado delegado de firma OCSP. Una CA importada sin clave utilizable no puede firmar respuestas.",{"_3328":69697,"_29138":69677,"_20209":118619,"_5":13819,"_26493":118564,"_2816":118620},[],"La implementación establece `thisUpdate` aproximadamente un día antes de generar la respuesta y `nextUpdate` un día después: la ventana declarada es de unas 48 horas. Inspecciona los valores recibidos y aplica tu política de vigencia. La respuesta refleja el estado almacenado al consultarla; una copia anterior en caché no cambia al revocar.",{"_3328":69698,"_29138":69677,"_20209":118622,"_5":13819,"_26493":118568,"_2816":118623},[],"El firmador construye las URLs OCSP a partir de los dominios VA configurados y las añade a AIA. Si no hay dominios, no hay URL que añadir; un certificado importado conserva sus extensiones originales. Revisa el certificado real:",{"_3328":69699,"_29138":69677,"_20209":118625,"_5":13819,"_26493":118568,"_2816":118626},[],"Comprueba que esa URL es accesible desde el consumidor. DNS, exposición del endpoint y configuración de dominios pertenecen a Despliegue. Cambiar esa configuración no modifica certificados ya firmados.",{"_3328":69700,"_29138":69677,"_20209":118628,"_5":13819,"_26493":118572,"_2816":118629},[],"El servicio acepta:",{"_3328":69701,"_29138":69677,"_20209":118631,"_5":13819,"_26493":118572,"_2816":114634},[],{"_3328":69702,"_29138":69677,"_20209":118633,"_5":13819,"_26493":118572,"_2816":118634},[],"Ruta del servicio VA",{"_3328":69703,"_29138":69677,"_20209":118636,"_5":13819,"_26493":118572,"_2816":118637},[],"Formato",{"_3328":69704,"_29138":69677,"_20209":118639,"_5":13819,"_26493":118572,"_2816":54746},[],{"_3328":69705,"_29138":69677,"_20209":118641,"_5":13819,"_26493":118572,"_2816":54749},[],{"_3328":69706,"_29138":69677,"_20209":118643,"_5":13819,"_26493":118572,"_2816":118644},[],"Solicitud DER, `Content-Type: application/ocsp-request`.",{"_3328":69707,"_29138":69677,"_20209":118646,"_5":13819,"_26493":118572,"_2816":54178},[],{"_3328":69708,"_29138":69677,"_20209":118648,"_5":13819,"_26493":118572,"_2816":54757},[],{"_3328":69709,"_29138":69677,"_20209":118650,"_5":13819,"_26493":118572,"_2816":118651},[],"Solicitud DER codificada en Base64 URL con padding.",{"_3328":69710,"_29138":69677,"_20209":118653,"_5":13819,"_26493":118572,"_2816":118654},[],"Utiliza POST para evitar diferencias de codificación entre clientes. La respuesta correcta tiene `Content-Type: application/ocsp-response` y cuerpo DER. El prefijo público depende del Gateway; utiliza la URL publicada en el certificado y comprobada por el operador.",{"_3328":69711,"_29138":69677,"_20209":118656,"_5":13819,"_26493":118576,"_2816":118657},[],"Necesitas OpenSSL 3.x, `device.crt`, el certificado de su emisor directo `issuer.pem` y las raíces confiables del consumidor en `roots.pem`. Si el emisor es intermedio, prepara además `intermediates.pem` con las CAs intermedias.",{"_3328":69712,"_29138":69677,"_20209":118659,"_5":13819,"_26493":118576,"_2816":118660},[],"Genera la solicitud:",{"_3328":69713,"_29138":69677,"_20209":118662,"_5":13819,"_26493":118576,"_2816":118663},[],"Este ejemplo omite el nonce porque el respondedor no lo devuelve. La verificación depende de firma, correspondencia de la respuesta y tiempos; no demuestra frescura mediante un nonce.",{"_3328":69714,"_29138":69677,"_20209":118665,"_5":13819,"_26493":118576,"_2816":118666},[],"Sustituye la URL de ejemplo por el endpoint inspeccionado:",{"_3328":69715,"_29138":69677,"_20209":118668,"_5":13819,"_26493":118576,"_2816":118669},[],"Verifica el DER recibido:",{"_3328":69716,"_29138":69677,"_20209":118671,"_5":13819,"_26493":118576,"_2816":118672},[],"Si hay intermedias, añade `-verify_other intermediates.pem`. Exige verificación correcta de la respuesta y comprueba el estado correspondiente a `device.crt`, emisor, serie, `thisUpdate` y `nextUpdate`. Un resultado `Response verify OK` solo valida la respuesta: también debes observar `good`, `revoked` o `unknown`. No aceptes una identidad basándote únicamente en el código de salida del comando.",{"_3328":69717,"_29138":69677,"_20209":118674,"_5":13819,"_26493":118580,"_2816":118675},[],"**OCSP Check** permite observar lo que responde Lamassu para un certificado seleccionado. Completa la comprobación desde la red y el almacén de confianza del consumidor: la consulta de la consola no prueba su configuración de validación.",{"_3328":69718,"_29138":69677,"_20209":118677,"_5":13819,"_26493":118580,"_2816":118678},[],"Para comprobar un cambio, guarda una respuesta anterior, revoca un certificado de prueba y solicita otra. La consulta nueva debe reflejar el estado persistido; compara los tiempos para descartar reutilización de una respuesta anterior. Si falla, sigue Diagnóstico PKI.",{"_3328":69719,"_29138":69677,"_20209":118680,"_5":13819,"_26493":118584,"_2816":54790},[],{"_3328":69720,"_29138":69677,"_20209":118682,"_5":13819,"_26493":118584,"_2816":54793},[],{"_3328":69721,"_29138":69677,"_20209":118684,"_5":13819,"_26493":118584,"_2816":118685},[],"<Card title=\"Servicio CRL\" href=\"/docs/platform/pki/crl\" />",{"_3328":69722,"_29138":69677,"_20209":118687,"_5":13819,"_26493":118584,"_2816":118174},[],{"_3328":69723,"_29138":69723,"_5":14177,"_2816":52871,"_29461":118689,"_20209":118690,"_26493":69723},[47397,112910,52871],[],{"_3328":69724,"_29138":69723,"_20209":118692,"_5":13819,"_26493":69723,"_2816":118693},[],"Administra claves y autoridades, define la emisión y verifica los certificados resultantes.",{"_3328":69725,"_29138":69723,"_5":29458,"_20209":118695,"_26493":118696,"_2816":116115},[],"/docs/es/platform/pki/overview#empieza-aquí",{"_3328":69726,"_29138":69723,"_5":29458,"_20209":118698,"_26493":118699,"_2816":118700},[],"/docs/es/platform/pki/overview#qué-necesitas","Qué necesitas",{"_3328":69727,"_29138":69723,"_5":29458,"_20209":118702,"_26493":118703,"_2816":116635},[],"/docs/es/platform/pki/overview#capacidades-principales",{"_3328":69728,"_29138":69723,"_5":29458,"_20209":118705,"_26493":118706,"_2816":116639},[],"/docs/es/platform/pki/overview#construye-tu-jerarquía-de-confianza",{"_3328":69729,"_29138":69723,"_5":29458,"_20209":118708,"_26493":118709,"_2816":116643},[],"/docs/es/platform/pki/overview#protege-las-claves-criptográficas",{"_3328":69730,"_29138":69723,"_5":29458,"_20209":118711,"_26493":118712,"_2816":116647},[],"/docs/es/platform/pki/overview#emite-y-controla-certificados",{"_3328":69731,"_29138":69723,"_5":29458,"_20209":118714,"_26493":118715,"_2816":116655},[],"/docs/es/platform/pki/overview#publica-el-estado-de-validación",{"_3328":69732,"_29138":69723,"_5":29458,"_20209":118717,"_26493":118718,"_2816":118719},[],"/docs/es/platform/pki/overview#cómo-comprobar-el-resultado","Cómo comprobar el resultado",{"_3328":69733,"_29138":69723,"_5":29458,"_20209":118721,"_26493":118722,"_2816":117580},[],"/docs/es/platform/pki/overview#continúa",{"_3328":69734,"_29138":69723,"_20209":118724,"_5":13819,"_26493":69723,"_2816":118725},[],"El bloque PKI explica cómo construir y operar la confianza X.509 de Lamassu: qué autoridades emiten, qué reglas aplican y cómo se comprueban los certificados. Está dirigido al administrador PKI y a quien necesita utilizar certificados en un sistema consumidor.",{"_3328":69735,"_29138":69723,"_20209":118727,"_5":13819,"_26493":118696,"_2816":118728},[],"Sigue Primeros pasos de PKI para crear una CA, emitir un certificado de cliente y verificarlo con OpenSSL. El resultado es un certificado, su clave privada y una cadena comprobada.",{"_3328":69736,"_29138":69723,"_20209":118730,"_5":13819,"_26493":118696,"_2816":118731},[],"Puedes completar ese recorrido antes de gestionar dispositivos. Cuando necesites asociar la identidad a un inventario o automatizar su enrolamiento, continúa en IoT Fleets.",{"_3328":69737,"_29138":69723,"_20209":118733,"_5":13819,"_26493":118699,"_2816":118734},[],"Una instancia accesible y permisos para gestionar las claves, CAs y certificados que usarás.",{"_3328":69738,"_29138":69723,"_20209":118736,"_5":13819,"_26493":118699,"_2816":118737},[],"Un motor criptográfico disponible para custodiar la clave de la autoridad.",{"_3328":69739,"_29138":69723,"_20209":118739,"_5":13819,"_26493":118699,"_2816":118740},[],"El propósito del certificado: por ejemplo, autenticar un cliente mediante mTLS.",{"_3328":69740,"_29138":69723,"_20209":118742,"_5":13819,"_26493":118699,"_2816":118743},[],"Los requisitos del consumidor: emisores aceptados, algoritmos, nombres y usos permitidos.",{"_3328":69741,"_29138":69723,"_20209":118745,"_5":13819,"_26493":118699,"_2816":118746},[],"La configuración de la instancia y del proveedor criptográfico se prepara en Despliegue. La elección de jerarquía se explica en el modelo de confianza.",{"_3328":69742,"_29138":69723,"_20209":118748,"_5":13819,"_26493":118706,"_2816":118749},[],"Las autoridades firman certificados. Una raíz establece el ancla de confianza y una intermedia permite separar la emisión por entorno o propósito. La jerarquía y rotación explica cómo mantener esa confianza al sustituir una autoridad.",{"_3328":69743,"_29138":69723,"_20209":118751,"_5":13819,"_26493":118709,"_2816":118752},[],"Las claves de firma de las CAs se gestionan mediante KMS y motores criptográficos. La clave de un cliente que genera una CSR puede permanecer en ese cliente: conserva su custodia al elegir el método de emisión.",{"_3328":69744,"_29138":69723,"_20209":118754,"_5":13819,"_26493":118712,"_2816":118755},[],"Un perfil establece restricciones de sujeto, validez, usos y claves. La CA aplica la configuración de emisión y firma el certificado. En el inventario puedes inspeccionar el resultado, descargarlo y gestionar su estado.",{"_3328":69745,"_29138":69723,"_20209":118757,"_5":13819,"_26493":118715,"_2816":118758},[],"La validación reúne cadena, vigencia, usos y estado de revocación. Lamassu publica estado mediante OCSP y CRL; el consumidor configura qué emisores reconoce y cómo comprueba ese estado.",{"_3328":69746,"_29138":69723,"_20209":118760,"_5":13819,"_26493":118718,"_2816":118761},[],"Un certificado activo en la consola es una parte de la comprobación. Revisa también que:",{"_3328":69747,"_29138":69723,"_20209":118763,"_5":13819,"_26493":118718,"_2816":118764},[],"su sujeto y sus extensiones identifiquen al cliente esperado;",{"_3328":69748,"_29138":69723,"_20209":118766,"_5":13819,"_26493":118718,"_2816":118767},[],"su clave pública corresponda a la clave privada del cliente;",{"_3328":69749,"_29138":69723,"_20209":118769,"_5":13819,"_26493":118718,"_2816":118770},[],"su cadena alcance una raíz confiable para el consumidor;",{"_3328":69750,"_29138":69723,"_20209":118772,"_5":13819,"_26493":118718,"_2816":118773},[],"sus fechas y usos permitan la operación;",{"_3328":69751,"_29138":69723,"_20209":118775,"_5":13819,"_26493":118718,"_2816":118776},[],"el consumidor aplique la comprobación de revocación y su autorización.",{"_3328":69752,"_29138":69723,"_20209":118778,"_5":13819,"_26493":118718,"_2816":118779},[],"El recorrido de emisión incluye las primeras comprobaciones independientes.",{"_3328":69753,"_29138":69723,"_20209":118781,"_5":13819,"_26493":118722,"_2816":118782},[],"<Card title=\"Primeros pasos de PKI\" description=\"Crea una CA y emite y verifica un certificado de cliente.\" href=\"/docs/platform/pki/quickstarts/overview\" />",{"_3328":69754,"_29138":69723,"_20209":118784,"_5":13819,"_26493":118722,"_2816":118785},[],"<Card title=\"Aplica la PKI a dispositivos\" description=\"Asocia certificados al inventario y prepara el enrolamiento.\" href=\"/docs/platform/iot-fleets/overview\" />",{"_3328":69755,"_29138":69723,"_20209":118787,"_5":13819,"_26493":118722,"_2816":118788},[],"<Card title=\"Diagnóstico PKI\" description=\"Comprueba emisión, OCSP y CRL cuando el resultado falla.\" href=\"/docs/platform/pki/troubleshooting\" />",{"_3328":69756,"_29138":69756,"_5":14177,"_2816":118790,"_29461":118791,"_20209":118792,"_26493":69756},"Crea tu primera CA",[47397,112910,52871,116239],[],{"_3328":69757,"_29138":69756,"_20209":118794,"_5":13819,"_26493":69756,"_2816":118795},[],"Crea una raíz de evaluación y comprueba su certificado antes de emitir.",{"_3328":69758,"_29138":69756,"_5":29458,"_20209":118797,"_26493":118798,"_2816":111488},[],"/docs/es/platform/pki/quickstarts/create-certificate-authority#antes-de-empezar",{"_3328":69759,"_29138":69756,"_5":29458,"_20209":118800,"_26493":118801,"_2816":118802},[],"/docs/es/platform/pki/quickstarts/create-certificate-authority#abre-el-asistente-de-creación-toc","Abre el asistente de creación [!toc]",{"_3328":69760,"_29138":69756,"_5":29458,"_20209":118804,"_26493":118805,"_2816":118806},[],"/docs/es/platform/pki/quickstarts/create-certificate-authority#selecciona-la-clave-toc","Selecciona la clave [!toc]",{"_3328":69761,"_29138":69756,"_5":29458,"_20209":118808,"_26493":118809,"_2816":118810},[],"/docs/es/platform/pki/quickstarts/create-certificate-authority#define-la-autoridad-toc","Define la autoridad [!toc]",{"_3328":69762,"_29138":69756,"_5":29458,"_20209":118812,"_26493":118813,"_2816":118814},[],"/docs/es/platform/pki/quickstarts/create-certificate-authority#revisa-y-crea-la-ca-toc","Revisa y crea la CA [!toc]",{"_3328":69763,"_29138":69756,"_5":29458,"_20209":118816,"_26493":118817,"_2816":118818},[],"/docs/es/platform/pki/quickstarts/create-certificate-authority#verifica-el-resultado-toc","Verifica el resultado [!toc]",{"_3328":69764,"_29138":69756,"_5":29458,"_20209":118820,"_26493":118821,"_2816":118822},[],"/docs/es/platform/pki/quickstarts/create-certificate-authority#comprueba-el-certificado-de-ca","Comprueba el certificado de CA",{"_3328":69765,"_29138":69756,"_5":29458,"_20209":118824,"_26493":118825,"_2816":116486},[],"/docs/es/platform/pki/quickstarts/create-certificate-authority#si-el-resultado-falla",{"_3328":69766,"_29138":69756,"_5":29458,"_20209":118827,"_26493":118828,"_2816":111512},[],"/docs/es/platform/pki/quickstarts/create-certificate-authority#siguiente-paso",{"_3328":69767,"_29138":69756,"_20209":118830,"_5":13819,"_26493":69756,"_2816":118831},[],"Crearás una autoridad raíz con una clave nueva custodiada por un motor de Lamassu. Al terminar tendrás una CA activa y su certificado público en `ca.pem`, preparado para verificar la emisión del siguiente recorrido.",{"_3328":69768,"_29138":69756,"_20209":118833,"_5":13819,"_26493":118798,"_2816":118834},[],"Acceso a la consola y permisos para crear claves y autoridades.",{"_3328":69769,"_29138":69756,"_20209":118836,"_5":13819,"_26493":118798,"_2816":118837},[],"Un motor criptográfico disponible que admita el algoritmo elegido.",{"_3328":69770,"_29138":69756,"_20209":118839,"_5":13819,"_26493":118798,"_2816":118840},[],"OpenSSL 3.x para comprobar el certificado descargado.",{"_3328":69771,"_29138":69756,"_20209":118842,"_5":13819,"_26493":118798,"_2816":118843},[],"Utiliza una instancia de evaluación o una autoridad destinada a estas pruebas. El ejemplo crea una raíz que emite directamente; para diseñar una jerarquía operativa, consulta Jerarquía y rotación.",{"_3328":69772,"_29138":69756,"_20209":118845,"_5":13819,"_26493":118801,"_2816":118846},[],"En **Certification Authorities**, selecciona **Create New CA** y elige crear una CA con un par de claves nuevo.",{"_3328":69773,"_29138":69756,"_20209":118848,"_5":13819,"_26493":118801,"_2816":118849},[],"El flujo &#x2A;*Create New CA (Existing Key)** se explica en la guía de autoridades.",{"_3328":69774,"_29138":69756,"_20209":118851,"_5":13819,"_26493":118805,"_2816":118852},[],"Elige el motor que custodiará la clave y un algoritmo permitido por sus capacidades. Para este ejemplo puedes utilizar **EC P-384** si está disponible.",{"_3328":69775,"_29138":69756,"_20209":118854,"_5":13819,"_26493":118805,"_2816":118855},[],"La clave privada de la CA se utiliza a través del motor. En este recorrido descargarás únicamente el certificado público de la autoridad.",{"_3328":69776,"_29138":69756,"_20209":118857,"_5":13819,"_26493":118809,"_2816":118858},[],"Selecciona **Root CA** y completa:",{"_3328":69777,"_29138":69756,"_20209":118860,"_5":13819,"_26493":118809,"_2816":54972},[],{"_3328":69778,"_29138":69756,"_20209":118862,"_5":13819,"_26493":118809,"_2816":118863},[],"**Subject**: los datos de organización y país de tu evaluación.",{"_3328":69779,"_29138":69756,"_20209":118865,"_5":13819,"_26493":118809,"_2816":118866},[],"**CA Certificate Expiration**: por ejemplo, un año desde la creación.",{"_3328":69780,"_29138":69756,"_20209":118868,"_5":13819,"_26493":118809,"_2816":118869},[],"**Default End-Entity Certificate Issuance Expiration**: por ejemplo, 90 días, dentro de la vigencia de la CA.",{"_3328":69781,"_29138":69756,"_20209":118871,"_5":13819,"_26493":118809,"_2816":118872},[],"El nombre de la CA se utilizará como `Common Name`. Mantén los usos de CA necesarios para firmar certificados y CRLs.",{"_3328":69782,"_29138":69756,"_20209":118874,"_5":13819,"_26493":118813,"_2816":118875},[],"Comprueba motor, algoritmo, sujeto, tipo raíz y fechas. Confirma la creación y anota el identificador de la autoridad para reconocerla en el DMS o en la API.",{"_3328":69783,"_29138":69756,"_20209":118877,"_5":13819,"_26493":118817,"_2816":118878},[],"Abre la nueva CA. Debe aparecer activa, mostrar su certificado y permitir acceder a **Issued Certificates**.",{"_3328":69784,"_29138":69756,"_20209":118880,"_5":13819,"_26493":118817,"_2816":118881},[],"Descarga o copia el certificado PEM de la autoridad y guárdalo como `ca.pem`. Comprueba que el archivo contiene el bloque completo, incluidos `BEGIN CERTIFICATE` y `END CERTIFICATE`.",{"_3328":69785,"_29138":69756,"_20209":118883,"_5":13819,"_26493":118821,"_2816":118884},[],"Ejecuta desde el directorio donde guardaste `ca.pem`:",{"_3328":69786,"_29138":69756,"_20209":118886,"_5":13819,"_26493":118821,"_2816":118887},[],"Comprueba que sujeto y emisor corresponden a la raíz creada, las fechas incluyen el momento actual, **Basic Constraints** contiene `CA:TRUE` y **Key Usage** permite firmar certificados. El último comando debe devolver `ca.pem: OK`.",{"_3328":69787,"_29138":69756,"_20209":118889,"_5":13819,"_26493":118821,"_2816":118890},[],"Has elegido explícitamente `ca.pem` como ancla de esta prueba. Que la autofirma sea válida no instala esa confianza en otros consumidores. Consulta la referencia de openssl-verify para las opciones de comprobación.",{"_3328":69788,"_29138":69756,"_20209":118892,"_5":13819,"_26493":118825,"_2816":118893},[],"Si la creación falla, comprueba permisos, disponibilidad del motor y algoritmo seleccionado.",{"_3328":69789,"_29138":69756,"_20209":118895,"_5":13819,"_26493":118825,"_2816":118896},[],"Si OpenSSL no lee el archivo, vuelve a copiar el bloque PEM completo.",{"_3328":69790,"_29138":69756,"_20209":118898,"_5":13819,"_26493":118825,"_2816":118899},[],"Si fallan la firma o las fechas, revisa que hayas descargado el certificado de esta CA y que el reloj del equipo sea correcto.",{"_3328":69791,"_29138":69756,"_20209":118901,"_5":13819,"_26493":118825,"_2816":118902},[],"El diagnóstico PKI reúne las comprobaciones de emisión y dependencias criptográficas.",{"_3328":69792,"_29138":69756,"_20209":118904,"_5":13819,"_26493":118828,"_2816":118905},[],"Continúa con Emite y verifica un certificado, utilizando esta autoridad y `ca.pem`.",{"_3328":69793,"_29138":69793,"_5":14177,"_2816":118907,"_29461":118908,"_20209":118909,"_26493":69793},"Emite y verifica un certificado",[47397,112910,52871,116239],[],{"_3328":69794,"_29138":69793,"_20209":118911,"_5":13819,"_26493":69793,"_2816":118912},[],"Emite un certificado de cliente y comprueba contenido, cadena y correspondencia de clave.",{"_3328":69795,"_29138":69793,"_5":29458,"_20209":118914,"_26493":118915,"_2816":111488},[],"/docs/es/platform/pki/quickstarts/issue-certificate#antes-de-empezar",{"_3328":69796,"_29138":69793,"_5":29458,"_20209":118917,"_26493":118918,"_2816":118919},[],"/docs/es/platform/pki/quickstarts/issue-certificate#inicia-la-emisión","Inicia la emisión",{"_3328":69797,"_29138":69793,"_5":29458,"_20209":118921,"_26493":118922,"_2816":118923},[],"/docs/es/platform/pki/quickstarts/issue-certificate#elige-el-método","Elige el método",{"_3328":69798,"_29138":69793,"_5":29458,"_20209":118925,"_26493":118926,"_2816":118927},[],"/docs/es/platform/pki/quickstarts/issue-certificate#identifica-el-certificado","Identifica el certificado",{"_3328":69799,"_29138":69793,"_5":29458,"_20209":118929,"_26493":118930,"_2816":118931},[],"/docs/es/platform/pki/quickstarts/issue-certificate#configura-clave-y-usos","Configura clave y usos",{"_3328":69800,"_29138":69793,"_5":29458,"_20209":118933,"_26493":118934,"_2816":118935},[],"/docs/es/platform/pki/quickstarts/issue-certificate#emite-y-descarga","Emite y descarga",{"_3328":69801,"_29138":69793,"_5":29458,"_20209":118937,"_26493":118938,"_2816":118939},[],"/docs/es/platform/pki/quickstarts/issue-certificate#verifica-el-resultado","Verifica el resultado",{"_3328":69802,"_29138":69793,"_5":29458,"_20209":118941,"_26493":118942,"_2816":118943},[],"/docs/es/platform/pki/quickstarts/issue-certificate#inspecciona-contenido-y-fechas","Inspecciona contenido y fechas",{"_3328":69803,"_29138":69793,"_5":29458,"_20209":118945,"_26493":118946,"_2816":118947},[],"/docs/es/platform/pki/quickstarts/issue-certificate#verifica-la-cadena","Verifica la cadena",{"_3328":69804,"_29138":69793,"_5":29458,"_20209":118949,"_26493":118950,"_2816":118951},[],"/docs/es/platform/pki/quickstarts/issue-certificate#comprueba-que-la-clave-corresponde","Comprueba que la clave corresponde",{"_3328":69805,"_29138":69793,"_5":29458,"_20209":118953,"_26493":118954,"_2816":116486},[],"/docs/es/platform/pki/quickstarts/issue-certificate#si-el-resultado-falla",{"_3328":69806,"_29138":69793,"_5":29458,"_20209":118956,"_26493":118957,"_2816":111512},[],"/docs/es/platform/pki/quickstarts/issue-certificate#siguiente-paso",{"_3328":69807,"_29138":69793,"_20209":118959,"_5":13819,"_26493":69793,"_2816":118960},[],"Emitirás un certificado final para `device-001` mediante el flujo de generación de clave y CSR en el navegador. Al terminar conservarás `device.crt`, `device.key` y el certificado público de la raíz emisora, `ca.pem`.",{"_3328":69808,"_29138":69793,"_20209":118962,"_5":13819,"_26493":118915,"_2816":118963},[],"Una CA raíz activa con clave de firma disponible y permisos para emitir. Si todavía no existe, sigue Crea tu primera CA.",{"_3328":69809,"_29138":69793,"_20209":118965,"_5":13819,"_26493":118915,"_2816":118966},[],"Su certificado público en `ca.pem`; este ejemplo utiliza la raíz creada en el recorrido anterior.",{"_3328":69810,"_29138":69793,"_20209":118968,"_5":13819,"_26493":118915,"_2816":118969},[],"OpenSSL 3.x y un directorio de trabajo con acceso restringido.",{"_3328":69811,"_29138":69793,"_20209":118971,"_5":13819,"_26493":118915,"_2816":118972},[],"Un identificador para el cliente: aquí usaremos `device-001`.",{"_3328":69812,"_29138":69793,"_20209":118974,"_5":13819,"_26493":118915,"_2816":118975},[],"En este flujo la clave del cliente se genera en el navegador y debes descargarla al finalizar. Si la pierdes, tendrás que generar una clave y emitir otro certificado. El inventario de certificados permite descargar el certificado público, pero no recuperar esta clave.",{"_3328":69813,"_29138":69793,"_20209":118977,"_5":13819,"_26493":118918,"_2816":118978},[],"Abre la CA del recorrido anterior, entra en **Issued Certificates** y selecciona **Issue New**.",{"_3328":69814,"_29138":69793,"_20209":118980,"_5":13819,"_26493":118922,"_2816":118981},[],"Selecciona **Generate Key & CSR in Browser** para seguir este ejemplo.",{"_3328":69815,"_29138":69793,"_20209":118983,"_5":13819,"_26493":118922,"_2816":118984},[],"Si la clave debe generarse y permanecer en el sistema de destino, utiliza **Upload Existing CSR**, descrito en la guía de autoridades.",{"_3328":69816,"_29138":69793,"_20209":118986,"_5":13819,"_26493":118926,"_2816":118987},[],"Introduce `device-001` como `Common Name`. Añade los datos de sujeto requeridos por tu política y SANs si el consumidor los utiliza para identificar al cliente.",{"_3328":69817,"_29138":69793,"_20209":118989,"_5":13819,"_26493":118926,"_2816":118990},[],"Si vas a continuar con el registro manual, el `Device ID` será exactamente `device-001`.",{"_3328":69818,"_29138":69793,"_20209":118992,"_5":13819,"_26493":118930,"_2816":118993},[],"Elige un algoritmo y tamaño admitidos por el perfil; por ejemplo, ECDSA P-256 si está permitido. Para este certificado de cliente, selecciona **Digital Signature** y **Client Authentication** y emite como certificado final.",{"_3328":69819,"_29138":69793,"_20209":118995,"_5":13819,"_26493":118930,"_2816":118996},[],"Solicita, por ejemplo, 30 días de validez, siempre dentro de la vigencia de la CA. Revisa el perfil de emisión si el contenido resultante difiere de lo solicitado.",{"_3328":69820,"_29138":69793,"_20209":118998,"_5":13819,"_26493":118934,"_2816":118999},[],"Confirma la emisión. Guarda el certificado PEM como `device.crt` y la clave privada como `device.key` en el directorio preparado.",{"_3328":69821,"_29138":69793,"_20209":119001,"_5":13819,"_26493":118938,"_2816":119002},[],"Comprueba en **Issued Certificates** que el certificado aparece activo. Anota su número de serie y verifica el material descargado con las comprobaciones siguientes.",{"_3328":69822,"_29138":69793,"_20209":119004,"_5":13819,"_26493":118942,"_2816":119005},[],"Comprueba `CN=device-001`, el emisor esperado, fechas vigentes, **Digital Signature** y el uso extendido **TLS Web Client Authentication**. Debe ser un certificado final: no debe declarar `CA:TRUE` ni habilitar **Certificate Sign**. Si **Basic Constraints** está presente, debe indicar `CA:FALSE`. Si solicitaste SANs, revisa que los identificadores esperados aparezcan en el certificado.",{"_3328":69823,"_29138":69793,"_20209":119007,"_5":13819,"_26493":118946,"_2816":119008},[],"El resultado esperado es `device.crt: OK`. Esta comprobación utiliza tu raíz explícita y evalúa la cadena, las fechas y la compatibilidad con el propósito de cliente TLS. La presencia de los usos y nombres esperados se comprueba también mediante la inspección anterior.",{"_3328":69824,"_29138":69793,"_20209":119010,"_5":13819,"_26493":118946,"_2816":119011},[],"Si utilizas una CA intermedia, la raíz confiable debe estar en `ca.pem` y debes aportar las intermedias mediante `-untrusted intermediates.pem`. Esta variante se desarrolla en el modelo de confianza.",{"_3328":69825,"_29138":69793,"_20209":119013,"_5":13819,"_26493":118946,"_2816":119014},[],"El comando no consulta OCSP ni CRL. Para comprobar revocación, continúa con Validación de certificados. Consulta la referencia de openssl-verify para sus opciones.",{"_3328":69826,"_29138":69793,"_20209":119016,"_5":13819,"_26493":118950,"_2816":119017},[],"En Bash, compara los dos resúmenes de clave pública:",{"_3328":69827,"_29138":69793,"_20209":119019,"_5":13819,"_26493":118950,"_2816":119020},[],"Ambos comandos deben terminar correctamente y mostrar el mismo resumen SHA-256. Si difieren, la clave privada no corresponde al certificado seleccionado. Vuelve a localizar la pareja correcta antes de instalarla.",{"_3328":69828,"_29138":69793,"_20209":119022,"_5":13819,"_26493":118950,"_2816":119023},[],"Las opciones utilizadas se recogen en openssl-x509 y openssl-pkey.",{"_3328":69829,"_29138":69793,"_20209":119025,"_5":13819,"_26493":118954,"_2816":116569},[],{"_3328":69830,"_29138":69793,"_20209":119027,"_5":13819,"_26493":118954,"_2816":115083},[],{"_3328":69831,"_29138":69793,"_20209":119029,"_5":13819,"_26493":118954,"_2816":119030},[],"La CA rechaza la emisión",{"_3328":69832,"_29138":69793,"_20209":119032,"_5":13819,"_26493":118954,"_2816":119033},[],"Permisos, estado y clave de la CA, algoritmo y perfil.",{"_3328":69833,"_29138":69793,"_20209":119035,"_5":13819,"_26493":118954,"_2816":119036},[],"Sujeto o usos diferentes",{"_3328":69834,"_29138":69793,"_20209":119038,"_5":13819,"_26493":118954,"_2816":119039},[],"Perfil aplicado y valores solicitados.",{"_3328":69835,"_29138":69793,"_20209":119041,"_5":13819,"_26493":118954,"_2816":119042},[],"No se encuentra el emisor",{"_3328":69836,"_29138":69793,"_20209":119044,"_5":13819,"_26493":118954,"_2816":119045},[],"CA descargada y cadena intermedia necesaria.",{"_3328":69837,"_29138":69793,"_20209":119047,"_5":13819,"_26493":118954,"_2816":119048},[],"Falla la vigencia",{"_3328":69838,"_29138":69793,"_20209":119050,"_5":13819,"_26493":118954,"_2816":119051},[],"Fechas del certificado y de la CA, y reloj del equipo.",{"_3328":69839,"_29138":69793,"_20209":119053,"_5":13819,"_26493":118954,"_2816":119054},[],"Los resúmenes de clave difieren",{"_3328":69840,"_29138":69793,"_20209":119056,"_5":13819,"_26493":118954,"_2816":119057},[],"Archivos de certificado y clave de la misma emisión.",{"_3328":69841,"_29138":69793,"_20209":119059,"_5":13819,"_26493":118954,"_2816":119060},[],"Consulta Diagnóstico PKI si necesitas acotar un fallo de emisión.",{"_3328":69842,"_29138":69793,"_20209":119062,"_5":13819,"_26493":118957,"_2816":119063},[],"Has completado el recorrido PKI cuando el certificado verifica y su clave corresponde. Elige cómo utilizarlo:",{"_3328":69843,"_29138":69793,"_20209":119065,"_5":13819,"_26493":118957,"_2816":119066},[],"Gestionar certificados para inspección, estado y revocación.",{"_3328":69844,"_29138":69793,"_20209":119068,"_5":13819,"_26493":118957,"_2816":119069},[],"Registrar un dispositivo manualmente para asociar esta identidad al inventario de Lamassu.",{"_3328":69845,"_29138":69793,"_20209":119071,"_5":13819,"_26493":118957,"_2816":119072},[],"Preparar EST para que el dispositivo solicite sus siguientes identidades.",{"_3328":69846,"_29138":69793,"_20209":119074,"_5":13819,"_26493":118957,"_2816":119075},[],"La aceptación en un consumidor requiere configurar su confianza, su comprobación de revocación y los permisos concedidos a la identidad.",{"_3328":69847,"_29138":69847,"_5":14177,"_2816":119077,"_29461":119078,"_20209":119079,"_26493":69847},"Primeros pasos de PKI",[47397,112910,52871,116239],[],{"_3328":69848,"_29138":69847,"_20209":119081,"_5":13819,"_26493":69847,"_2816":119082},[],"Crea una CA, emite un certificado de cliente y comprueba su cadena y su clave.",{"_3328":69849,"_29138":69847,"_5":29458,"_20209":119084,"_26493":119085,"_2816":111488},[],"/docs/es/platform/pki/quickstarts/overview#antes-de-empezar",{"_3328":69850,"_29138":69847,"_5":29458,"_20209":119087,"_26493":119088,"_2816":119089},[],"/docs/es/platform/pki/quickstarts/overview#ruta-recomendada","Ruta recomendada",{"_3328":69851,"_29138":69847,"_5":29458,"_20209":119091,"_26493":119092,"_2816":116421},[],"/docs/es/platform/pki/quickstarts/overview#resultado-esperado",{"_3328":69852,"_29138":69847,"_5":29458,"_20209":119094,"_26493":119095,"_2816":119096},[],"/docs/es/platform/pki/quickstarts/overview#continúa-según-tu-objetivo","Continúa según tu objetivo",{"_3328":69853,"_29138":69847,"_20209":119098,"_5":13819,"_26493":69847,"_2816":119099},[],"Este recorrido está dirigido a quien empieza a administrar la PKI o necesita una primera identidad X.509 de cliente. Termina con tres archivos: el certificado de una CA raíz, un certificado final y la clave privada de ese cliente.",{"_3328":69854,"_29138":69847,"_20209":119101,"_5":13819,"_26493":119085,"_2816":119102},[],"Una instancia de Lamassu accesible desde el navegador. Si necesitas prepararla, consulta Despliegue.",{"_3328":69855,"_29138":69847,"_20209":119104,"_5":13819,"_26493":119085,"_2816":119105},[],"Permisos para gestionar claves, autoridades y emisión. Consulta Control de acceso si una operación está bloqueada.",{"_3328":69856,"_29138":69847,"_20209":119107,"_5":13819,"_26493":119085,"_2816":119108},[],"Un motor criptográfico disponible para la clave de la CA; comprueba el inventario de claves y motores.",{"_3328":69857,"_29138":69847,"_20209":119110,"_5":13819,"_26493":119085,"_2816":119111},[],"OpenSSL 3.x en el equipo desde el que verificarás los archivos.",{"_3328":69858,"_29138":69847,"_20209":119113,"_5":13819,"_26493":119085,"_2816":119114},[],"Un directorio de trabajo con acceso restringido para custodiar la clave descargada.",{"_3328":69859,"_29138":69847,"_20209":119116,"_5":13819,"_26493":119088,"_2816":119117},[],"<Card title=\"1. Crea tu primera CA\" description=\"Crea una raíz de evaluación y guarda su certificado público como ca.pem.\" href=\"/docs/platform/pki/quickstarts/create-certificate-authority\" />",{"_3328":69860,"_29138":69847,"_20209":119119,"_5":13819,"_26493":119088,"_2816":119120},[],"<Card title=\"2. Emite y verifica un certificado\" description=\"Emite para device-001 y comprueba contenido, cadena y correspondencia de clave.\" href=\"/docs/platform/pki/quickstarts/issue-certificate\" />",{"_3328":69861,"_29138":69847,"_20209":119122,"_5":13819,"_26493":119088,"_2816":119123},[],"Usaremos `Acme Evaluation Root CA` y `device-001` como nombres de ejemplo. Si los sustituyes, conserva el mismo identificador de cliente en los pasos que quieras conectar.",{"_3328":69862,"_29138":69847,"_20209":119125,"_5":13819,"_26493":119088,"_2816":119126},[],"La raíz de este recorrido firma directamente el certificado final para facilitar la evaluación. Antes de diseñar una PKI operativa, revisa el modelo de confianza y la jerarquía de CAs.",{"_3328":69863,"_29138":69847,"_20209":119128,"_5":13819,"_26493":119092,"_2816":119129},[],"Archivo o recurso",{"_3328":69864,"_29138":69847,"_20209":119131,"_5":13819,"_26493":119092,"_2816":116418},[],{"_3328":69865,"_29138":69847,"_20209":119133,"_5":13819,"_26493":119092,"_2816":119134},[],"CA raíz activa y `ca.pem`",{"_3328":69866,"_29138":69847,"_20209":119136,"_5":13819,"_26493":119092,"_2816":119137},[],"Es un certificado de CA, está vigente y su autofirma se comprueba.",{"_3328":69867,"_29138":69847,"_20209":119139,"_5":13819,"_26493":119092,"_2816":119140},[],"Certificado final y `device.crt`",{"_3328":69868,"_29138":69847,"_20209":119142,"_5":13819,"_26493":119092,"_2816":119143},[],"Identifica a `device-001`, admite autenticación de cliente y verifica hasta `ca.pem`.",{"_3328":69869,"_29138":69847,"_20209":119145,"_5":13819,"_26493":119092,"_2816":119146},[],"Clave privada `device.key`",{"_3328":69870,"_29138":69847,"_20209":119148,"_5":13819,"_26493":119092,"_2816":119149},[],"Su clave pública coincide con la incluida en `device.crt`.",{"_3328":69871,"_29138":69847,"_20209":119151,"_5":13819,"_26493":119092,"_2816":119152},[],"Estas comprobaciones validan el material emitido. La aceptación en un servicio requiere además su configuración de confianza, autorización y revocación.",{"_3328":69872,"_29138":69847,"_20209":119154,"_5":13819,"_26493":119095,"_2816":119155},[],"Para operar certificados, continúa con Certificados y Validación.",{"_3328":69873,"_29138":69847,"_20209":119157,"_5":13819,"_26493":119095,"_2816":119158},[],"Para gestionar una identidad de dispositivo en Lamassu, sigue Registro manual. Ese recorrido incluye la preparación del DMS.",{"_3328":69874,"_29138":69847,"_20209":119160,"_5":13819,"_26493":119095,"_2816":119161},[],"Para que el dispositivo solicite su certificado, prepara el DMS y el cliente EST.",{"_3328":69875,"_29138":69875,"_5":14177,"_2816":119163,"_29461":119164,"_20209":119166,"_26493":69875},"Resolución de problemas PKI",[47397,112910,52871,119165],"Resolución de problemas",[],{"_3328":69876,"_29138":69875,"_20209":119168,"_5":13819,"_26493":69875,"_2816":119169},[],"Diagnostica emisión de certificados, OCSP y CRL.",{"_3328":69877,"_29138":69875,"_5":29458,"_20209":119171,"_26493":119172,"_2816":119173},[],"/docs/es/platform/pki/troubleshooting#la-emisión-falla","La emisión falla",{"_3328":69878,"_29138":69875,"_5":29458,"_20209":119175,"_26493":119176,"_2816":119177},[],"/docs/es/platform/pki/troubleshooting#ocsp-o-crl-no-reflejan-un-cambio","OCSP o CRL no reflejan un cambio",{"_3328":69879,"_29138":69875,"_5":29458,"_20209":119179,"_26493":119180,"_2816":119181},[],"/docs/es/platform/pki/troubleshooting#la-cadena-se-valida-pero-la-conexión-falla","La cadena se valida pero la conexión falla",{"_3328":69880,"_29138":69875,"_20209":119183,"_5":13819,"_26493":69875,"_2816":119184},[],"Esta guía ayuda al operador PKI a localizar fallos de emisión y publicación de estado. Conserva versión de Lamassu, operación, CA, emisor, serie, hora y error devuelto. No incluyas claves privadas ni tokens en el diagnóstico.",{"_3328":69881,"_29138":69875,"_20209":119186,"_5":13819,"_26493":69875,"_2816":119187},[],"Para Gateway, inicio de sesión, pods, dependencias y mensajería, consulta Diagnóstico de Despliegue. Para enrolamiento de dispositivos, consulta Diagnóstico EST.",{"_3328":69882,"_29138":69875,"_20209":119189,"_5":13819,"_26493":119172,"_2816":116418},[],{"_3328":69883,"_29138":69875,"_20209":119191,"_5":13819,"_26493":119172,"_2816":115083},[],{"_3328":69884,"_29138":69875,"_20209":119193,"_5":13819,"_26493":119172,"_2816":111512},[],{"_3328":69885,"_29138":69875,"_20209":119195,"_5":13819,"_26493":119172,"_2816":51710},[],{"_3328":69886,"_29138":69875,"_20209":119197,"_5":13819,"_26493":119172,"_2816":119198},[],"Existe, está activa y sus fechas son utilizables.",{"_3328":69887,"_29138":69875,"_20209":119200,"_5":13819,"_26493":119172,"_2816":119201},[],"Autoridades.",{"_3328":69888,"_29138":69875,"_20209":119203,"_5":13819,"_26493":119172,"_2816":119204},[],"Clave",{"_3328":69889,"_29138":69875,"_20209":119206,"_5":13819,"_26493":119172,"_2816":119207},[],"El registro tiene clave privada utilizable y el motor puede firmar.",{"_3328":69890,"_29138":69875,"_20209":119209,"_5":13819,"_26493":119172,"_2816":119210},[],"Prueba **Sign / Verify** en KMS; revisa permisos y disponibilidad del proveedor.",{"_3328":69891,"_29138":69875,"_20209":119212,"_5":13819,"_26493":119172,"_2816":55326},[],{"_3328":69892,"_29138":69875,"_20209":119214,"_5":13819,"_26493":119172,"_2816":119215},[],"PEM correcto y firma verificable.",{"_3328":69893,"_29138":69875,"_20209":119217,"_5":13819,"_26493":119172,"_2816":55332},[],{"_3328":69894,"_29138":69875,"_20209":119219,"_5":13819,"_26493":119172,"_2816":119220},[],"Perfil",{"_3328":69895,"_29138":69875,"_20209":119222,"_5":13819,"_26493":119172,"_2816":119223},[],"Fuente seleccionada, ID existente, algoritmo y tamaño admitidos.",{"_3328":69896,"_29138":69875,"_20209":119225,"_5":13819,"_26493":119172,"_2816":119226},[],"Revisa la precedencia de Perfiles; CA y DMS resuelven de forma distinta.",{"_3328":69897,"_29138":69875,"_20209":119228,"_5":13819,"_26493":119172,"_2816":116569},[],{"_3328":69898,"_29138":69875,"_20209":119230,"_5":13819,"_26493":119172,"_2816":119231},[],"Sujeto, SAN, usos y fechas adecuados.",{"_3328":69899,"_29138":69875,"_20209":119233,"_5":13819,"_26493":119172,"_2816":119234},[],"Compara CSR, perfil y certificado; emitir correctamente no demuestra aceptación por el consumidor.",{"_3328":69900,"_29138":69875,"_20209":119236,"_5":13819,"_26493":119172,"_2816":119237},[],"Si el certificado emitido tiene campos inesperados, revisa `Honor Subject`, `Honor Key Usage`, `Honor Extended Key Usages` y `Honor Extensions`. Esta última solo conserva SAN, sin validar el derecho a esos nombres. La validez no se recorta automáticamente al vencimiento de la CA.",{"_3328":69901,"_29138":69875,"_20209":119239,"_5":13819,"_26493":119172,"_2816":119240},[],"Si falla la reemisión de una CA, comprueba revocación y fecha: no se admite para una CA revocada o ya vencida. Para cambiar la clave, utiliza Jerarquía y rotación.",{"_3328":69902,"_29138":69875,"_20209":119242,"_5":13819,"_26493":119176,"_2816":119243},[],"Revisa cada frontera por separado:",{"_3328":69903,"_29138":69875,"_20209":119245,"_5":13819,"_26493":119176,"_2816":119246},[],"**Registro:** vuelve a leer el certificado correcto por serie y emisor. Confirma estado, razón y hora; los registros expirados o revocados definitivamente no admiten otra transición.",{"_3328":69904,"_29138":69875,"_20209":119248,"_5":13819,"_26493":119176,"_2816":119249},[],"**Endpoint:** inspecciona AIA y CDP del certificado. Consulta esas URLs desde la red del consumidor; una ruta antigua o un emisor incorrecto puede explicar la diferencia.",{"_3328":69905,"_29138":69875,"_20209":119251,"_5":13819,"_26493":119176,"_2816":119252},[],"**OCSP:** guarda una respuesta nueva, verifica firma y tiempos y observa su estado. Un error HTTP por una serie ausente no equivale a `Good` ni garantiza un `Unknown` firmado.",{"_3328":69906,"_29138":69875,"_20209":119254,"_5":13819,"_26493":119176,"_2816":119255},[],"**CRL:** compara `latest_crl`, número y tiempos de la lista descargada. Confirma la serie en el contenido. Si no cambia, revisa `regenerate_on_revoke`, entrega del evento, trabajos, firma y almacenamiento con el operador de Despliegue.",{"_3328":69907,"_29138":69875,"_20209":119257,"_5":13819,"_26493":119176,"_2816":119258},[],"**Cliente:** comprueba caché, política ante evidencia vencida o no disponible, extensión IDP crítica y rechazo de una conexión nueva.",{"_3328":69908,"_29138":69875,"_20209":119260,"_5":13819,"_26493":119176,"_2816":119261},[],"Una reactivación desde `CertificateHold` requiere una CRL nueva para que el cliente deje de ver la suspensión. Reactivar una CA no restaura su cascada de descendientes; revisa todos los estados y los errores individuales de la operación.",{"_3328":69909,"_29138":69875,"_20209":119263,"_5":13819,"_26493":119180,"_2816":119264},[],"Comprueba la identidad esperada, SAN, KU/EKU, clave correspondiente, intermedias enviadas y permisos del consumidor. Diferencia confianza TLS en el servidor, autenticación del cliente y autorización de la acción. Sigue Validación para una prueba positiva y otras de rechazo.",{"_3328":69910,"_29138":69875,"_20209":119266,"_5":13819,"_26493":119180,"_2816":119267},[],"Cuando necesites escalar un problema, entrega los identificadores, error y evidencia pública relevante, con tiempos de consulta y versión. Esto permite distinguir un fallo de emisión, de publicación o de la aplicación consumidora.",{"_3328":69911,"_29138":69911,"_5":14177,"_2816":119269,"_29461":119270,"_20209":119272,"_26493":69911},"3.8.0 a 4.0.0",[47397,119271],"Actualizaciones",[],{"_3328":69912,"_29138":69911,"_20209":119274,"_5":13819,"_26493":69911,"_2816":119275},[],"Qué cambia en la arquitectura de 4.0.0, qué cambios rompen un despliegue 3.8.0, cómo actualizar paso a paso una release de Helm y cómo validar el resultado.",{"_3328":69913,"_29138":69911,"_5":29458,"_20209":119277,"_26493":119278,"_2816":119279},[],"/docs/es/upgrades/3-8-0-to-4-0-0#cambios-de-arquitectura","Cambios de arquitectura",{"_3328":69914,"_29138":69911,"_5":29458,"_20209":119281,"_26493":119282,"_2816":119283},[],"/docs/es/upgrades/3-8-0-to-4-0-0#una-única-base-de-datos-postgresql-con-esquemas","Una única base de datos PostgreSQL con esquemas",{"_3328":69915,"_29138":69911,"_5":29458,"_20209":119285,"_26493":119286,"_2816":119287},[],"/docs/es/upgrades/3-8-0-to-4-0-0#la-autorización-pasa-al-servicio-authz","La autorización pasa al servicio authz",{"_3328":69916,"_29138":69911,"_5":29458,"_20209":119289,"_26493":119290,"_2816":119291},[],"/docs/es/upgrades/3-8-0-to-4-0-0#los-eventos-de-dispositivo-tienen-almacenamiento-propio","Los eventos de dispositivo tienen almacenamiento propio",{"_3328":69917,"_29138":69911,"_5":29458,"_20209":119293,"_26493":119294,"_2816":119295},[],"/docs/es/upgrades/3-8-0-to-4-0-0#un-chart-de-helm-reforzado","Un chart de Helm reforzado",{"_3328":69918,"_29138":69911,"_5":29458,"_20209":119297,"_26493":119298,"_2816":119299},[],"/docs/es/upgrades/3-8-0-to-4-0-0#qué-migra-automáticamente-la-actualización","Qué migra automáticamente la actualización",{"_3328":69919,"_29138":69911,"_5":29458,"_20209":119301,"_26493":119302,"_2816":55418},[],"/docs/es/upgrades/3-8-0-to-4-0-0#breaking-changes",{"_3328":69920,"_29138":69911,"_5":29458,"_20209":119304,"_26493":119305,"_2816":119306},[],"/docs/es/upgrades/3-8-0-to-4-0-0#chart-de-helm-y-values","Chart de Helm y values",{"_3328":69921,"_29138":69911,"_5":29458,"_20209":119308,"_26493":119309,"_2816":119310},[],"/docs/es/upgrades/3-8-0-to-4-0-0#nombres-de-recursos-con-ámbito-de-release","Nombres de recursos con ámbito de release",{"_3328":69922,"_29138":69911,"_5":29458,"_20209":119312,"_26493":119313,"_2816":119314},[],"/docs/es/upgrades/3-8-0-to-4-0-0#validación-estricta-de-values","Validación estricta de values",{"_3328":69923,"_29138":69911,"_5":29458,"_20209":119316,"_26493":119317,"_2816":119318},[],"/docs/es/upgrades/3-8-0-to-4-0-0#configuración-de-autorización-obligatoria","Configuración de autorización obligatoria",{"_3328":69924,"_29138":69911,"_5":29458,"_20209":119320,"_26493":119321,"_2816":119322},[],"/docs/es/upgrades/3-8-0-to-4-0-0#retirada-de-la-validación-de-tokens-en-el-gateway","Retirada de la validación de tokens en el gateway",{"_3328":69925,"_29138":69911,"_5":29458,"_20209":119324,"_26493":119325,"_2816":119326},[],"/docs/es/upgrades/3-8-0-to-4-0-0#contenedores-sin-root","Contenedores sin root",{"_3328":69926,"_29138":69911,"_5":29458,"_20209":119328,"_26493":119329,"_2816":119330},[],"/docs/es/upgrades/3-8-0-to-4-0-0#amqp-sobre-tls","AMQP sobre TLS",{"_3328":69927,"_29138":69911,"_5":29458,"_20209":119332,"_26493":119333,"_2816":119334},[],"/docs/es/upgrades/3-8-0-to-4-0-0#values-renombrados-y-reestructurados","Values renombrados y reestructurados",{"_3328":69928,"_29138":69911,"_5":29458,"_20209":119336,"_26493":119337,"_2816":119338},[],"/docs/es/upgrades/3-8-0-to-4-0-0#datos-y-almacenamiento","Datos y almacenamiento",{"_3328":69929,"_29138":69911,"_5":29458,"_20209":119340,"_26493":119341,"_2816":119342},[],"/docs/es/upgrades/3-8-0-to-4-0-0#consolidación-en-postgresql","Consolidación en PostgreSQL",{"_3328":69930,"_29138":69911,"_5":29458,"_20209":119344,"_26493":119345,"_2816":119346},[],"/docs/es/upgrades/3-8-0-to-4-0-0#retirada-de-sqlite","Retirada de SQLite",{"_3328":69931,"_29138":69911,"_5":29458,"_20209":119348,"_26493":119349,"_2816":119350},[],"/docs/es/upgrades/3-8-0-to-4-0-0#claves-de-ca-heredadas-en-el-kms","Claves de CA heredadas en el KMS",{"_3328":69932,"_29138":69911,"_5":29458,"_20209":119352,"_26493":119353,"_2816":119354},[],"/docs/es/upgrades/3-8-0-to-4-0-0#apis-y-configuración-almacenada","APIs y configuración almacenada",{"_3328":69933,"_29138":69911,"_5":29458,"_20209":119356,"_26493":119357,"_2816":119358},[],"/docs/es/upgrades/3-8-0-to-4-0-0#webhooks-del-dms","Webhooks del DMS",{"_3328":69934,"_29138":69911,"_5":29458,"_20209":119360,"_26493":119361,"_2816":119362},[],"/docs/es/upgrades/3-8-0-to-4-0-0#conjunto-de-confianza-del-reenrolamiento","Conjunto de confianza del reenrolamiento",{"_3328":69935,"_29138":69911,"_5":29458,"_20209":119364,"_26493":119365,"_2816":119366},[],"/docs/es/upgrades/3-8-0-to-4-0-0#autenticación-de-reenrolamiento-independiente","Autenticación de reenrolamiento independiente",{"_3328":69936,"_29138":69911,"_5":29458,"_20209":119368,"_26493":119369,"_2816":119370},[],"/docs/es/upgrades/3-8-0-to-4-0-0#api-de-actualización-del-dms","API de actualización del DMS",{"_3328":69937,"_29138":69911,"_5":29458,"_20209":119372,"_26493":119373,"_2816":119374},[],"/docs/es/upgrades/3-8-0-to-4-0-0#valores-de-tipo-de-certificado","Valores de tipo de certificado",{"_3328":69938,"_29138":69911,"_5":29458,"_20209":119376,"_26493":119377,"_2816":119378},[],"/docs/es/upgrades/3-8-0-to-4-0-0#eventos-de-dispositivo","Eventos de dispositivo",{"_3328":69939,"_29138":69911,"_5":29458,"_20209":119380,"_26493":119381,"_2816":119382},[],"/docs/es/upgrades/3-8-0-to-4-0-0#guía-de-migración-con-helm","Guía de migración con Helm",{"_3328":69940,"_29138":69911,"_5":29458,"_20209":119384,"_26493":119385,"_2816":119386},[],"/docs/es/upgrades/3-8-0-to-4-0-0#paso-1-prepara","Paso 1: Prepara",{"_3328":69941,"_29138":69911,"_5":29458,"_20209":119388,"_26493":119389,"_2816":119390},[],"/docs/es/upgrades/3-8-0-to-4-0-0#paso-2-actualiza-el-archivo-de-values","Paso 2: Actualiza el archivo de values",{"_3328":69942,"_29138":69911,"_5":29458,"_20209":119392,"_26493":119393,"_2816":119394},[],"/docs/es/upgrades/3-8-0-to-4-0-0#paso-3-ejecuta-la-actualización","Paso 3: Ejecuta la actualización",{"_3328":69943,"_29138":69911,"_5":29458,"_20209":119396,"_26493":119397,"_2816":119398},[],"/docs/es/upgrades/3-8-0-to-4-0-0#paso-4-migra-los-datos-del-kms-y-la-va","Paso 4: Migra los datos del KMS y la VA",{"_3328":69944,"_29138":69911,"_5":29458,"_20209":119400,"_26493":119401,"_2816":119402},[],"/docs/es/upgrades/3-8-0-to-4-0-0#paso-5-elimina-los-values-de-migración-puntual","Paso 5: Elimina los values de migración puntual",{"_3328":69945,"_29138":69911,"_5":29458,"_20209":119404,"_26493":119405,"_2816":119406},[],"/docs/es/upgrades/3-8-0-to-4-0-0#despliegues-sin-helm","Despliegues sin Helm",{"_3328":69946,"_29138":69911,"_5":29458,"_20209":119408,"_26493":119409,"_2816":115429},[],"/docs/es/upgrades/3-8-0-to-4-0-0#solución-de-problemas",{"_3328":69947,"_29138":69911,"_5":29458,"_20209":119411,"_26493":119412,"_2816":119413},[],"/docs/es/upgrades/3-8-0-to-4-0-0#checklist-de-validación","Checklist de validación",{"_3328":69948,"_29138":69911,"_5":29458,"_20209":119415,"_26493":119416,"_2816":119417},[],"/docs/es/upgrades/3-8-0-to-4-0-0#elimina-los-volúmenes-antiguos","Elimina los volúmenes antiguos",{"_3328":69949,"_29138":69911,"_20209":119419,"_5":13819,"_26493":69911,"_2816":119420},[],"Lamassu 4.0.0 es una versión mayor. El almacenamiento se consolida en una única base de datos PostgreSQL, un nuevo servicio `authz` autoriza cada petición, el chart de Helm se refuerza y varias APIs y configuraciones almacenadas cambian de forma. La mayoría de los datos se convierten automáticamente durante la actualización, pero algunos cambios requieren acción del operador antes, durante o después.",{"_3328":69950,"_29138":69911,"_20209":119422,"_5":13819,"_26493":69911,"_2816":119423},[],"La página se organiza en cuatro partes. Léelas en orden antes de actualizar producción:",{"_3328":69951,"_29138":69911,"_20209":119425,"_5":13819,"_26493":69911,"_2816":119426},[],"Cambios de arquitectura: qué es distinto en 4.0.0 y qué migra la actualización por sí sola.",{"_3328":69952,"_29138":69911,"_20209":119428,"_5":13819,"_26493":69911,"_2816":119429},[],"Breaking changes: cada cambio que puede romper un despliegue 3.8.0, a quién afecta y qué hacer.",{"_3328":69953,"_29138":69911,"_20209":119431,"_5":13819,"_26493":69911,"_2816":119432},[],"Guía de migración con Helm: el procedimiento paso a paso para una release gestionada con Helm.",{"_3328":69954,"_29138":69911,"_20209":119434,"_5":13819,"_26493":69911,"_2816":119435},[],"Checklist de validación: cómo confirmar que la actualización ha funcionado antes de eliminar los datos antiguos.",{"_3328":69955,"_29138":69911,"_20209":119437,"_5":13819,"_26493":69911,"_2816":119438},[],"La versión 4.0.0 está próxima y los pasos de migración del backend de esta página son provisionales. Verifica cada procedimiento con los artefactos definitivos de la versión antes de actualizar producción.",{"_3328":69956,"_29138":69911,"_20209":119440,"_5":13819,"_26493":119282,"_2816":119441},[],"En 3.8.0 cada servicio tenía su propia base de datos. El backend de 4.0.0 se conecta a una única base de datos PostgreSQL llamada `pki` y aísla cada servicio en un esquema: `kms`, `ca`, `va`, `devicemanager`, `dmsmanager` y `alerts`. El servicio `authz` guarda sus principales, permisos y políticas en una base de datos `authz` separada (el monolítico de desarrollo usa en su lugar un esquema `authz` dentro de `pki`), y WFX conserva su propia base `wfx`.",{"_3328":69957,"_29138":69911,"_20209":119443,"_5":13819,"_26493":119282,"_2816":119444},[],"PostgreSQL pasa a ser el único motor de almacenamiento. Se elimina el soporte de SQLite, y los motores `couch_db` y `dynamo_db` no están registrados en 4.0.0.",{"_3328":69958,"_29138":69911,"_20209":119446,"_5":13819,"_26493":119286,"_2816":119447},[],"En 3.8.0 el API Gateway validaba los tokens: una política JWT en cada ruta privada comprobaba la firma y solo dejaba pasar los tokens con el rol de administrador. Cualquier token que superase esa comprobación tenía acceso a todas las rutas.",{"_3328":69959,"_29138":69911,"_20209":119449,"_5":13819,"_26493":119286,"_2816":119450},[],"4.0.0 elimina la política del gateway. Las rutas `/api/*` llegan directamente a los servicios, y cada servicio autoriza cada petición a través de `authz`, que valida el token contra el endpoint JWKS del proveedor de identidad y aplica políticas de grano fino, a nivel de entidad, sobre CAs, certificados, dispositivos, DMS, claves del KMS y roles de la VA. No existe un superusuario implícito: el primer administrador sale de un principal de bootstrap que configuras tú. La página de control de acceso documenta los principales, las políticas y el primer administrador.",{"_3328":69960,"_29138":69911,"_20209":119452,"_5":13819,"_26493":119290,"_2816":119453},[],"Los eventos históricos de los dispositivos pasan de la columna `devices.events` a un almacenamiento dedicado, `device_events`, con sus propios endpoints. El endpoint de eventos también puede emitirlos mediante Server-Sent Events (SSE); para difundirlos entre las instancias del servicio, cada instancia de Device Manager enlaza su propia cola AMQP duradera.",{"_3328":69961,"_29138":69911,"_20209":119455,"_5":13819,"_26493":119294,"_2816":119456},[],"La versión 4.0.0 del chart refuerza la seguridad:",{"_3328":69962,"_29138":69911,"_20209":119458,"_5":13819,"_26493":119294,"_2816":119459},[],"**Nombres de recursos con ámbito de release.** Cada recurso gestionado por el chart se llama `<release>-lamassu-<componente>` en lugar de los nombres fijos de 3.8.0 (`kms`, `va`, `ca`...). Con una release llamada `prod`, los StatefulSets pasan a ser `prod-lamassu-kms` y `prod-lamassu-va`. Los values `nameOverride` y `fullnameOverride` cambian el prefijo.",{"_3328":69963,"_29138":69911,"_20209":119461,"_5":13819,"_26493":119294,"_2816":119462},[],"**Contenedores sin root.** Todas las cargas se ejecutan con el usuario numérico `65532:65532`, con un perfil seccomp `RuntimeDefault` y sin capabilities. Los pods no montan el token de la service account por defecto, y el chart crea una ServiceAccount dedicada.",{"_3328":69964,"_29138":69911,"_20209":119464,"_5":13819,"_26493":119294,"_2816":119465},[],"**Validación estricta de values.** `values.schema.json` rechaza las claves desconocidas, así que los bloques sobrantes de 3.8.0 hacen fallar `helm lint` y `helm upgrade` en lugar de ignorarse en silencio.",{"_3328":69965,"_29138":69911,"_20209":119467,"_5":13819,"_26493":119294,"_2816":119468},[],"**Sin reglas de planificación inyectadas.** El chart ya no añade por su cuenta reglas de anti-afinidad ni de topology spread.",{"_3328":69966,"_29138":69911,"_20209":119470,"_5":13819,"_26493":119298,"_2816":119471},[],"Al actualizar una release de Helm se ejecutan varias migraciones sin intervención:",{"_3328":69967,"_29138":69911,"_20209":119473,"_5":13819,"_26493":119298,"_2816":119474},[],"Antes de que arranque ningún servicio, el job de preinstalación y preactualización del chart prepara PostgreSQL. Crea las bases `pki`, `authz` y `wfx` si no existen, crea un esquema por servicio dentro de `pki` e importa cada base de datos por servicio de 3.8.0 en su esquema. Cada importación se ejecuta en una única transacción, de modo que una importación fallida no deja un esquema a medias y un reintento del job vuelve a importar. Después, el job ejecuta las migraciones de base de datos de cada esquema, migra `authz`, precarga sus políticas y da de alta los principales de `services.authz.bootstrap`. Es idempotente y necesita un rol de PostgreSQL con permiso para crear bases de datos y esquemas, como se describe en Instalar con Helm.",{"_3328":69968,"_29138":69911,"_20209":119476,"_5":13819,"_26493":119298,"_2816":119477},[],"La configuración almacenada de los DMS se reescribe al formato de 4.0.0, y los eventos históricos de los dispositivos se transforman al nuevo almacenamiento.",{"_3328":69969,"_29138":69911,"_20209":119479,"_5":13819,"_26493":119298,"_2816":119480},[],"Si se activa `migrations.caToKms.enabled`, un hook de preactualización registra en el KMS las claves de CA heredadas.",{"_3328":69970,"_29138":69911,"_20209":119482,"_5":13819,"_26493":119298,"_2816":119483},[],"Dos cosas nunca migran solas: los datos del KMS y de la VA en volúmenes locales, que se quedan en volúmenes que los pods actualizados ya no usan, y el archivo de values, que se actualiza a mano. Los despliegues que no usan el chart de Helm también tienen que mover ellos mismos los datos de la base de datos; consulta Despliegues sin Helm.",{"_3328":69971,"_29138":69911,"_20209":119485,"_5":13819,"_26493":119302,"_2816":119486},[],"Cambio",{"_3328":69972,"_29138":69911,"_20209":119488,"_5":13819,"_26493":119302,"_2816":119489},[],"A quién afecta",{"_3328":69973,"_29138":69911,"_20209":119491,"_5":13819,"_26493":119302,"_2816":119492},[],"Gravedad",{"_3328":69974,"_29138":69911,"_20209":119494,"_5":13819,"_26493":119302,"_2816":118113},[],{"_3328":69975,"_29138":69911,"_20209":119496,"_5":13819,"_26493":119302,"_2816":119310},[],{"_3328":69976,"_29138":69911,"_20209":119498,"_5":13819,"_26493":119302,"_2816":119499},[],"Releases de Helm con motor de KMS en sistema de archivos o CRLs de la VA en almacenamiento local",{"_3328":69977,"_29138":69911,"_20209":119501,"_5":13819,"_26493":119302,"_2816":119502},[],"Alta: KMS y VA arrancan con volúmenes vacíos",{"_3328":69978,"_29138":69911,"_20209":119504,"_5":13819,"_26493":119302,"_2816":119505},[],"Copiar los datos a los volúmenes nuevos",{"_3328":69979,"_29138":69911,"_20209":119507,"_5":13819,"_26493":119302,"_2816":119314},[],{"_3328":69980,"_29138":69911,"_20209":119509,"_5":13819,"_26493":119302,"_2816":119510},[],"Todas las releases de Helm",{"_3328":69981,"_29138":69911,"_20209":119512,"_5":13819,"_26493":119302,"_2816":119513},[],"Alta: `helm upgrade` falla",{"_3328":69982,"_29138":69911,"_20209":119515,"_5":13819,"_26493":119302,"_2816":119516},[],"Eliminar o renombrar las claves heredadas",{"_3328":69983,"_29138":69911,"_20209":119518,"_5":13819,"_26493":119302,"_2816":119318},[],{"_3328":69984,"_29138":69911,"_20209":119520,"_5":13819,"_26493":119302,"_2816":119521},[],"Todos los despliegues",{"_3328":69985,"_29138":69911,"_20209":119523,"_5":13819,"_26493":119302,"_2816":119524},[],"Alta: sin principal de bootstrap no hay administrador",{"_3328":69986,"_29138":69911,"_20209":119526,"_5":13819,"_26493":119302,"_2816":119527},[],"Configurar `services.authz`",{"_3328":69987,"_29138":69911,"_20209":119529,"_5":13819,"_26493":119302,"_2816":119322},[],{"_3328":69988,"_29138":69911,"_20209":119531,"_5":13819,"_26493":119302,"_2816":119510},[],{"_3328":69989,"_29138":69911,"_20209":119533,"_5":13819,"_26493":119302,"_2816":119534},[],"Alta: `helm upgrade` falla con las claves antiguas",{"_3328":69990,"_29138":69911,"_20209":119536,"_5":13819,"_26493":119302,"_2816":119537},[],"Mover JWKS y roles a `services.authz`",{"_3328":69991,"_29138":69911,"_20209":119539,"_5":13819,"_26493":119302,"_2816":119342},[],{"_3328":69992,"_29138":69911,"_20209":119541,"_5":13819,"_26493":119302,"_2816":119542},[],"Despliegues 3.8.0 con bases de datos por servicio",{"_3328":69993,"_29138":69911,"_20209":119544,"_5":13819,"_26493":119302,"_2816":119545},[],"Alta: los servicios no encuentran datos, o una migración aborta",{"_3328":69994,"_29138":69911,"_20209":119547,"_5":13819,"_26493":119302,"_2816":119548},[],"Limpiar antes IDs de CA duplicados y `engine_id` vacíos; fuera de Helm, mover los datos a mano",{"_3328":69995,"_29138":69911,"_20209":119550,"_5":13819,"_26493":119302,"_2816":119346},[],{"_3328":69996,"_29138":69911,"_20209":119552,"_5":13819,"_26493":119302,"_2816":119553},[],"Despliegues sobre SQLite, `couch_db` o `dynamo_db`",{"_3328":69997,"_29138":69911,"_20209":119555,"_5":13819,"_26493":119302,"_2816":119556},[],"Alta: el backend ya no arranca con ellos",{"_3328":69998,"_29138":69911,"_20209":119558,"_5":13819,"_26493":119302,"_2816":119559},[],"Pasar a PostgreSQL antes de actualizar",{"_3328":69999,"_29138":69911,"_20209":119561,"_5":13819,"_26493":119302,"_2816":119562},[],"Webhooks con referencias a archivos",{"_3328":70000,"_29138":69911,"_20209":119564,"_5":13819,"_26493":119302,"_2816":119565},[],"DMS cuyo certificado o clave mTLS del webhook eran rutas de archivo",{"_3328":70001,"_29138":69911,"_20209":119567,"_5":13819,"_26493":119302,"_2816":119568},[],"Alta: los enrolamientos que llaman al webhook fallan",{"_3328":70002,"_29138":69911,"_20209":119570,"_5":13819,"_26493":119302,"_2816":119571},[],"Volver a introducir certificado y clave como PEM, o eliminar los campos de archivo",{"_3328":70003,"_29138":69911,"_20209":119573,"_5":13819,"_26493":119302,"_2816":119326},[],{"_3328":70004,"_29138":69911,"_20209":119575,"_5":13819,"_26493":119302,"_2816":119576},[],"Releases con identidades por servicio o material de claves montado",{"_3328":70005,"_29138":69911,"_20209":119578,"_5":13819,"_26493":119302,"_2816":119579},[],"Media: los servicios no pueden leer sus archivos",{"_3328":70006,"_29138":69911,"_20209":119581,"_5":13819,"_26493":119302,"_2816":119582},[],"Eliminar las sobrescrituras y corregir la propiedad de los volúmenes",{"_3328":70007,"_29138":69911,"_20209":119584,"_5":13819,"_26493":119302,"_2816":119330},[],{"_3328":70008,"_29138":69911,"_20209":119586,"_5":13819,"_26493":119302,"_2816":119587},[],"Releases que definen `amqp.tls`",{"_3328":70009,"_29138":69911,"_20209":119589,"_5":13819,"_26493":119302,"_2816":119590},[],"Media: los clientes se conectan al puerto equivocado",{"_3328":70010,"_29138":69911,"_20209":119592,"_5":13819,"_26493":119302,"_2816":119593},[],"Apuntar `amqp.port` al listener TLS, o desactivar TLS",{"_3328":70011,"_29138":69911,"_20209":119595,"_5":13819,"_26493":119302,"_2816":119350},[],{"_3328":70012,"_29138":69911,"_20209":119597,"_5":13819,"_26493":119302,"_2816":119598},[],"Instalaciones cuyas claves de CA son anteriores al KMS",{"_3328":70013,"_29138":69911,"_20209":119600,"_5":13819,"_26493":119302,"_2816":119601},[],"Media: las claves de CA quedan sin gestionar",{"_3328":70014,"_29138":69911,"_20209":119603,"_5":13819,"_26493":119302,"_2816":119604},[],"Ejecutar la migración de CA a KMS",{"_3328":70015,"_29138":69911,"_20209":119606,"_5":13819,"_26493":119302,"_2816":119607},[],"Verificación del certificado del receptor",{"_3328":70016,"_29138":69911,"_20209":119609,"_5":13819,"_26493":119302,"_2816":119610},[],"DMS cuyo webhook tenía `validate_server_cert: false`",{"_3328":70017,"_29138":69911,"_20209":119612,"_5":13819,"_26493":119302,"_2816":119613},[],"Media: las credenciales viajan a un receptor sin verificar",{"_3328":70018,"_29138":69911,"_20209":119615,"_5":13819,"_26493":119302,"_2816":119616},[],"Poner `insecure_skip_verify` a `false`",{"_3328":70019,"_29138":69911,"_20209":119618,"_5":13819,"_26493":119302,"_2816":119362},[],{"_3328":70020,"_29138":69911,"_20209":119620,"_5":13819,"_26493":119302,"_2816":119621},[],"Scripts y consolas que editan DMS por API",{"_3328":70021,"_29138":69911,"_20209":119623,"_5":13819,"_26493":119302,"_2816":119624},[],"Media: una edición con el formato antiguo vacía `validation_cas` sin avisar",{"_3328":70022,"_29138":69911,"_20209":119626,"_5":13819,"_26493":119302,"_2816":119627},[],"Leer el DMS antes de editarlo y usar el campo nuevo",{"_3328":70023,"_29138":69911,"_20209":119629,"_5":13819,"_26493":119302,"_2816":119378},[],{"_3328":70024,"_29138":69911,"_20209":119631,"_5":13819,"_26493":119302,"_2816":119632},[],"Consumidores que leen el campo `events` del dispositivo",{"_3328":70025,"_29138":69911,"_20209":119634,"_5":13819,"_26493":119302,"_2816":119635},[],"Media: el campo desaparece",{"_3328":70026,"_29138":69911,"_20209":119637,"_5":13819,"_26493":119302,"_2816":119638},[],"Usar los nuevos endpoints de eventos",{"_3328":70027,"_29138":69911,"_20209":119640,"_5":13819,"_26493":119302,"_2816":119334},[],{"_3328":70028,"_29138":69911,"_20209":119642,"_5":13819,"_26493":119302,"_2816":119643},[],"Releases que sobrescriben `toolbox`, `services.connectors`, puertos, sondas o planificación",{"_3328":70029,"_29138":69911,"_20209":119645,"_5":13819,"_26493":119302,"_2816":119646},[],"Baja a media: errores de validación o cambios de valores por defecto",{"_3328":70030,"_29138":69911,"_20209":119648,"_5":13819,"_26493":119302,"_2816":119649},[],"Actualizar el archivo de values",{"_3328":70031,"_29138":69911,"_20209":119651,"_5":13819,"_26493":119302,"_2816":119370},[],{"_3328":70032,"_29138":69911,"_20209":119653,"_5":13819,"_26493":119302,"_2816":119654},[],"Clientes que envían el ID del DMS en el cuerpo de la actualización",{"_3328":70033,"_29138":69911,"_20209":119656,"_5":13819,"_26493":119302,"_2816":119657},[],"Baja: prevalece el ID de la URL",{"_3328":70034,"_29138":69911,"_20209":119659,"_5":13819,"_26493":119302,"_2816":119660},[],"Enviar el ID en la URL",{"_3328":70035,"_29138":69911,"_20209":119662,"_5":13819,"_26493":119302,"_2816":119374},[],{"_3328":70036,"_29138":69911,"_20209":119664,"_5":13819,"_26493":119302,"_2816":119665},[],"Consumidores que comparan el `type` del certificado",{"_3328":70037,"_29138":69911,"_20209":119667,"_5":13819,"_26493":119302,"_2816":119668},[],"Baja: dos valores cambian de nombre",{"_3328":70038,"_29138":69911,"_20209":119670,"_5":13819,"_26493":119302,"_2816":119671},[],"Adaptar los consumidores",{"_3328":70039,"_29138":69911,"_20209":119673,"_5":13819,"_26493":119302,"_2816":119366},[],{"_3328":70040,"_29138":69911,"_20209":119675,"_5":13819,"_26493":119302,"_2816":119676},[],"Cualquier DMS",{"_3328":70041,"_29138":69911,"_20209":119678,"_5":13819,"_26493":119302,"_2816":119679},[],"Baja: solo informativo",{"_3328":70042,"_29138":69911,"_20209":119681,"_5":13819,"_26493":119302,"_2816":119682},[],"Revisar ambos bloques antes de editar",{"_3328":70043,"_29138":69911,"_20209":119684,"_5":13819,"_26493":119309,"_2816":119685},[],"Kubernetes deriva el nombre del PVC de un StatefulSet a partir del nombre de su pod (`<volumeClaimTemplate>-<nombre-del-pod>`). Al renombrar los StatefulSets `kms` y `va`, `helm upgrade` enlaza PVC nuevos y vacíos en lugar de los existentes. El material de claves del KMS y las CRLs de la VA no se borran —los PVC antiguos quedan huérfanos, no eliminados—, pero los pods actualizados fallan con `no such file or directory` (KMS) o `code=NotFound` (VA) hasta que copies los datos. Afecta al KMS cuando `services.kms.cryptoEngines` usa un motor `filesystem` y a la VA cuando `services.va.fileStore.type` es `local`. El resto de recursos renombrados no tienen estado y se recrean sin riesgo de pérdida de datos.",{"_3328":70044,"_29138":69911,"_20209":119687,"_5":13819,"_26493":119309,"_2816":119688},[],"El paso 4 de la guía de migración copia los datos.",{"_3328":70045,"_29138":69911,"_20209":119690,"_5":13819,"_26493":119313,"_2816":119691},[],"`values.schema.json` rechaza las claves desconocidas, así que cualquier bloque que 4.0.0 haya eliminado o renombrado —`toolbox`, `auth.oidc.apiGateway`, `auth.authorization` y otros— hace fallar directamente `helm lint` y `helm upgrade`. El paso 2 recoge todos los cambios.",{"_3328":70046,"_29138":69911,"_20209":119693,"_5":13819,"_26493":119317,"_2816":119694},[],"3.8.0 no tenía servicio de autorización, así que un archivo de values de 3.8.0 no tiene nada desde lo que migrar: hay que añadir la configuración de `services.authz` a mano. Necesita el endpoint JWKS del proveedor de identidad, las bases de datos que usa el motor de autorización y un principal de bootstrap que coincida con la forma en que el proveedor asigna el rol de administrador. Sin un principal coincidente nadie puede administrar la PKI.",{"_3328":70047,"_29138":69911,"_20209":119696,"_5":13819,"_26493":119321,"_2816":119697},[],"`auth.oidc.apiGateway.jwks`, `auth.authorization.rolesClaim` y `auth.authorization.roles.admin` se eliminan sin alias de compatibilidad, y el schema los rechaza. Su configuración pasa a `services.authz`: la URL de JWKS se convierte en `services.authz.jwkUrl`, y el claim de roles y el rol de administrador pasan a ser una regla de claims del principal de bootstrap. `auth.oidc.frontend` no cambia.",{"_3328":70048,"_29138":69911,"_20209":119699,"_5":13819,"_26493":119325,"_2816":119700},[],"Las imágenes de servicio se basan en distroless y se ejecutan con el usuario numérico `65532`; la imagen de `authz` es Ubuntu con un usuario sin root que tiene el mismo UID. Se eliminan las sobrescrituras por servicio `services.kms.securityContext.runAsGroup: 0` y `services.authz.securityContext.runAsUser`/`runAsGroup: 999`; el acceso de grupo al volumen del KMS y al socket PKCS#11 lo gestiona ahora el `fsGroup: 65532` del pod.",{"_3328":70049,"_29138":69911,"_20209":119702,"_5":13819,"_26493":119325,"_2816":119703},[],"3.8.0 no fijaba la identidad del contenedor, por lo que los archivos existentes pueden tener cualquier UID. Todo volumen con claves o CRLs debe pertenecer a `65532:65532`, o al menos ser legible (y, si hace falta, escribible) por esa identidad.",{"_3328":70050,"_29138":69911,"_20209":119705,"_5":13819,"_26493":119329,"_2816":119706},[],"En 3.8.0 `amqp.tls` no se aplicaba y los clientes del bus de eventos se conectaban siempre en texto plano. En 4.0.0, `amqp.tls: true` los pasa a AMQPS. El valor por defecto de `amqp.port` sigue siendo `5672` y no cambia al activar TLS, así que un archivo de values que ya tuviera `amqp.tls: true` debe apuntar `amqp.port` al listener TLS del broker (`amqps`, habitualmente `5671`), o poner `amqp.tls: false` para seguir en texto plano. Los clientes deben además confiar en el certificado del broker.",{"_3328":70051,"_29138":69911,"_20209":119708,"_5":13819,"_26493":119333,"_2816":119709},[],"`toolbox` pasa a llamarse `connectivityTest`, y el hook de `helm test` usa la imagen upstream `curlimages/curl` fijada por digest.",{"_3328":70052,"_29138":69911,"_20209":119711,"_5":13819,"_26493":119333,"_2816":119712},[],"`services.connectors` pasa a ser un mapa indexado por ID de conector en lugar de una lista.",{"_3328":70053,"_29138":69911,"_20209":119714,"_5":13819,"_26493":119333,"_2816":119715},[],"El valor por defecto de `services.ui.port` es `8085`, el puerto sin privilegios de la imagen sin root.",{"_3328":70054,"_29138":69911,"_20209":119717,"_5":13819,"_26493":119333,"_2816":119718},[],"El bloque compartido `probes:` se sustituye por los bloques independientes `livenessProbe`, `readinessProbe` y `startupProbe`.",{"_3328":70055,"_29138":69911,"_20209":119720,"_5":13819,"_26493":119333,"_2816":119721},[],"Con `tls.certManagerOptions.issuer` vacío, el chart crea un issuer autofirmado con ámbito de release, por ejemplo `lamassu-downstream-ca-selfsigned-issuer`. El literal heredado `downstream-ca-selfsigned-issuer` se sigue aceptando y se resuelve a ese issuer.",{"_3328":70056,"_29138":69911,"_20209":119723,"_5":13819,"_26493":119333,"_2816":119724},[],"La anti-afinidad y el topology spread deben configurarse explícitamente con `affinity` y `topologySpreadConstraints`.",{"_3328":70057,"_29138":69911,"_20209":119726,"_5":13819,"_26493":119341,"_2816":119727},[],"Cada base de datos por servicio de 3.8.0 debe acabar como un esquema de `pki`, conservando su estructura, índices, restricciones, datos e historial de migraciones. El chart de Helm lo hace automáticamente; los despliegues sin Helm lo hacen a mano (consulta Despliegues sin Helm).",{"_3328":70058,"_29138":69911,"_20209":119729,"_5":13819,"_26493":119341,"_2816":119730},[],"Dos migraciones de esquema abortan con datos que 3.8.0 permitía, así que limpia los datos antes de actualizar:",{"_3328":70059,"_29138":69911,"_20209":119732,"_5":13819,"_26493":119341,"_2816":119733},[],"La migración de CA añade una restricción UNIQUE sobre `ca_certificates.id` y aborta si existen IDs de CA duplicados. Las importaciones ya rechazan los duplicados con `409`, así que normalmente no aparecen duplicados nuevos.",{"_3328":70060,"_29138":69911,"_20209":119735,"_5":13819,"_26493":119341,"_2816":119736},[],"La migración del KMS convierte la clave primaria en `(key_id, engine_id)` y aborta con `cannot promote (key_id, engine_id) to primary key: N row(s) have no engine_id; backfill them before migrating` cuando hay filas de `kms_keys` sin `engine_id`. Rellena antes `engine_id`.",{"_3328":70061,"_29138":69911,"_20209":119738,"_5":13819,"_26493":119341,"_2816":119739},[],"Esa misma migración del KMS elimina, con un `NOTICE`, los alias iguales a un ID de clave existente, porque los identificadores se resuelven ahora como ID de clave antes que como alias. Los alias afectados se descartan, no se redirigen.",{"_3328":70062,"_29138":69911,"_20209":119741,"_5":13819,"_26493":119345,"_2816":119742},[],"Se elimina el motor de almacenamiento SQLite, y los motores `couch_db` y `dynamo_db` no están registrados en 4.0.0: sus constantes de configuración siguen existiendo, pero no seleccionan ningún motor. Los despliegues sobre cualquiera de ellos deben pasar a PostgreSQL y consolidar sus datos en los esquemas de `pki` antes de actualizar.",{"_3328":70063,"_29138":69911,"_20209":119744,"_5":13819,"_26493":119349,"_2816":119745},[],"Los certificados de CA de tipo `MANAGED` o `IMPORTED_WITH_KEY` cuyas claves privadas son anteriores al servicio KMS tienen la clave guardada solo en el motor criptográfico, bajo el `subject_key_id` del certificado, sin registro en el KMS. La herramienta `ca-to-kms-migration` los registra:",{"_3328":70064,"_29138":69911,"_20209":119747,"_5":13819,"_26493":119349,"_2816":119748},[],"El `key_id` es el `subject_key_id` del certificado (SHA-256 de la clave pública).",{"_3328":70065,"_29138":69911,"_20209":119750,"_5":13819,"_26493":119349,"_2816":119751},[],"La herramienta es idempotente: las claves que ya están en el KMS se omiten, así que puede ejecutarse varias veces.",{"_3328":70066,"_29138":69911,"_20209":119753,"_5":13819,"_26493":119349,"_2816":119754},[],"Los certificados que no pueden leerse, o que carecen de motor o de ID de clave de sujeto, se omiten con un aviso. Revisa los logs y resuelve los registros afectados.",{"_3328":70067,"_29138":69911,"_20209":119756,"_5":13819,"_26493":119349,"_2816":119757},[],"Cuando certificados de CA que comparten un `subject_key_id` declaran `engine_id` en conflicto, la herramienta marca esa clave como fallida y sale con código `1`, lo que hace fallar un hook de preactualización de Helm. Resuelve el conflicto a mano antes de volver a ejecutarla.",{"_3328":70068,"_29138":69911,"_20209":119759,"_5":13819,"_26493":119349,"_2816":119760},[],"Con Helm, activa el hook para la actualización en el paso 2; sin Helm, ejecuta la herramienta a mano.",{"_3328":70069,"_29138":69911,"_20209":119762,"_5":13819,"_26493":119357,"_2816":119763},[],"Las configuraciones de webhook almacenadas se reescriben al formato actual y sus campos se renombran:",{"_3328":70070,"_29138":69911,"_20209":119765,"_5":13819,"_26493":119357,"_2816":119766},[],"Campo en 3.8.0",{"_3328":70071,"_29138":69911,"_20209":119768,"_5":13819,"_26493":119357,"_2816":119769},[],"Campo en 4.0.0",{"_3328":70072,"_29138":69911,"_20209":119771,"_5":13819,"_26493":119357,"_2816":55888},[],{"_3328":70073,"_29138":69911,"_20209":119773,"_5":13819,"_26493":119357,"_2816":119774},[],"`insecure_skip_verify` (con el valor negado)",{"_3328":70074,"_29138":69911,"_20209":119776,"_5":13819,"_26493":119357,"_2816":55894},[],{"_3328":70075,"_29138":69911,"_20209":119778,"_5":13819,"_26493":119357,"_2816":55897},[],{"_3328":70076,"_29138":69911,"_20209":119780,"_5":13819,"_26493":119357,"_2816":55900},[],{"_3328":70077,"_29138":69911,"_20209":119782,"_5":13819,"_26493":119357,"_2816":55903},[],{"_3328":70078,"_29138":69911,"_20209":119784,"_5":13819,"_26493":119357,"_2816":55906},[],{"_3328":70079,"_29138":69911,"_20209":119786,"_5":13819,"_26493":119357,"_2816":55909},[],{"_3328":70080,"_29138":69911,"_20209":119788,"_5":13819,"_26493":119357,"_2816":119789},[],"Cuando el certificado y la clave mTLS heredados son ambos PEM, se trasladan a `mtls_options.cert_content` y `mtls_options.key_content` y no requieren acción. Hay dos casos que sí la requieren.",{"_3328":70081,"_29138":69911,"_20209":119791,"_5":13819,"_26493":119357,"_2816":119792},[],"**Webhooks con referencias a archivos.** Una configuración mixta, con el certificado en PEM y la clave como ruta de archivo, se migra a `mtls_options.cert_file` y `mtls_options.key_file`. La entrega del webhook rechaza esos campos en cada llamada, sea cual sea el modo de autenticación configurado, de modo que todos los enrolamientos y reenrolamientos que llaman a ese webhook fallan hasta corregir la configuración. Si el webhook usa mTLS, vuelve a introducir el certificado y la clave como PEM, en Base64 o en texto plano; si no lo usa, elimina los campos de archivo sobrantes. Mientras tanto, las actualizaciones de solo metadatos siguen funcionando (`PUT` o `PATCH` sobre `/v1/dms/:id/metadata`). En una variante del mismo problema, una configuración almacenada con rutas de archivo dentro de `mtls_options.cert_content` o `mtls_options.key_content` hace fallar la validación de toda actualización completa de ajustes (`POST /v1/dms` o `PUT /v1/dms/:id`); los ajustes se sustituyen al completo, así que reenvía la configuración con el certificado y la clave como PEM.",{"_3328":70082,"_29138":69911,"_20209":119794,"_5":13819,"_26493":119357,"_2816":119795},[],"**Verificación del certificado del receptor.** Una configuración con `validate_server_cert: false` pasa a `insecure_skip_verify: true`, así que la verificación del receptor sigue sin realizarse hasta que ese campo se ponga a `false`. Corrígelo en cada configuración migrada: el canal de autorización del webhook transporta la API key o el bearer token, y saltarse la verificación expone esas credenciales a un atacante con posición de red. Mantén `insecure_skip_verify: true` solo si el certificado del receptor no es verificable de forma deliberada.",{"_3328":70083,"_29138":69911,"_20209":119797,"_5":13819,"_26493":119361,"_2816":119798},[],"El campo plano `reenrollment_settings.additional_validation_cas` se traslada al campo anidado `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`:",{"_3328":70084,"_29138":69911,"_20209":119800,"_5":13819,"_26493":119361,"_2816":119801},[],"El conjunto de confianza efectivo no cambia, porque el valor anidado nunca se consultó al validar reenrolamientos. Si la lista plana estaba ausente o era nula, pasa a ser una lista vacía.",{"_3328":70085,"_29138":69911,"_20209":119803,"_5":13819,"_26493":119361,"_2816":119804},[],"Lo que cambia es el tratamiento de las peticiones por API. Los cuerpos que aún contienen `additional_validation_cas` se aceptan, pero su valor se descarta en silencio porque los campos JSON desconocidos se ignoran, y las respuestas GET ya no lo incluyen. Por tanto, un cuerpo de actualización construido con el formato antiguo vacía `validation_cas` sin ningún error. Lee siempre el DMS antes de enviar una edición y reutiliza el formato que devuelve la API.",{"_3328":70086,"_29138":69911,"_20209":119806,"_5":13819,"_26493":119365,"_2816":119807},[],"Los ajustes de autenticación del reenrolamiento se almacenan ahora de forma independiente de los de la autenticación inicial. No hay nada que migrar, pero lee ambos bloques antes de editar un DMS para no modificar uno creyendo que editas el otro. La consola expone editores independientes para ambos bloques; la guía de DMS describe sus campos, y también puedes editarlos mediante la API DMS.",{"_3328":70087,"_29138":69911,"_20209":119809,"_5":13819,"_26493":119369,"_2816":119810},[],"`PUT /v1/dms/:id` toma el ID del DMS de la URL y valida el cuerpo de la petición. Un ID en el cuerpo se ignora, así que actualiza los clientes que dependían de él.",{"_3328":70088,"_29138":69911,"_20209":119812,"_5":13819,"_26493":119373,"_2816":119813},[],"Los valores de tipo de certificado almacenados cambian de nombre: `IMPORTED` pasa a `IMPORTED_WITH_KEY` y `EXTERNAL` pasa a `IMPORTED_WITHOUT_KEY`. `MANAGED` no cambia. Adapta los consumidores que leen o comparan esos valores.",{"_3328":70089,"_29138":69911,"_20209":119815,"_5":13819,"_26493":119377,"_2816":119816},[],"El campo `events` ya no aparece en la representación del dispositivo. Apunta los consumidores a los nuevos endpoints:",{"_3328":70090,"_29138":69911,"_20209":119818,"_5":13819,"_26493":119377,"_2816":119819},[],"`GET /v1/devices/:id/events` devuelve los eventos de un dispositivo.",{"_3328":70091,"_29138":69911,"_20209":119821,"_5":13819,"_26493":119377,"_2816":119822},[],"`POST /v1/devices/:id/events` crea un evento.",{"_3328":70092,"_29138":69911,"_20209":119824,"_5":13819,"_26493":119377,"_2816":119825},[],"Cuando la cabecera `Accept` de la petición incluye `text/event-stream`, el endpoint de eventos emite por SSE con un keepalive cada 15 segundos, y responde `501` cuando SSE está deshabilitado en el despliegue. Cada instancia de Device Manager enlaza una cola AMQP duradera con el nombre de su ID de servicio, `device-manager-sse-<uuid>`. Las colas de instancias caídas o reemplazadas permanecen hasta que se eliminan, así que configura en el broker una política de expiración o limpieza.",{"_3328":70093,"_29138":69911,"_20209":119827,"_5":13819,"_26493":119381,"_2816":119828},[],"La actualización sigue un orden fijo: preparar los datos y los values, ejecutar `helm upgrade` y después copiar los datos del KMS y la VA a los volúmenes nuevos. La copia debe hacerse después de la actualización, porque los StatefulSets y PVC de destino no existen antes. Si no estás actualizando una release existente, ve directamente a Instalar con Helm.",{"_3328":70094,"_29138":69911,"_20209":119830,"_5":13819,"_26493":119385,"_2816":119831},[],"Haz una copia de seguridad verificable de PostgreSQL y programa una parada de servicio. La actualización mueve los datos de todos los servicios a `pki`.",{"_3328":70095,"_29138":69911,"_20209":119833,"_5":13819,"_26493":119385,"_2816":119834},[],"Si el despliegue usa SQLite, `couch_db` o `dynamo_db`, pásalo antes a PostgreSQL.",{"_3328":70096,"_29138":69911,"_20209":119836,"_5":13819,"_26493":119385,"_2816":119837},[],"Resuelve los IDs de CA duplicados y rellena `engine_id` en `kms_keys`, como se describe en Consolidación en PostgreSQL.",{"_3328":70097,"_29138":69911,"_20209":119839,"_5":13819,"_26493":119385,"_2816":119840},[],"Anota los nombres de tus PVC de almacenamiento local:",{"_3328":70098,"_29138":69911,"_20209":119842,"_5":13819,"_26493":119385,"_2816":119843},[],"`helm upgrade` no toca ni borra los PVC antiguos, pero tras la actualización nada los referencia. Necesitas sus nombres para copiar los datos y para limpiar más tarde.",{"_3328":70099,"_29138":69911,"_20209":119845,"_5":13819,"_26493":119389,"_2816":119846},[],"**Añade `services.authz`.** Configura el endpoint JWKS, las bases de datos y el principal de bootstrap:",{"_3328":70100,"_29138":69911,"_20209":119848,"_5":13819,"_26493":119389,"_2816":119849},[],"`jwkUrl` se consulta desde el pod de `authz`, no desde el gateway, así que un Service del namespace de la release puede referenciarse por su nombre corto. El valor por defecto apunta a un Service de Keycloak llamado `auth-keycloak`; defínelo explícitamente si tu proveedor de identidad está en otro sitio.",{"_3328":70101,"_29138":69911,"_20209":119851,"_5":13819,"_26493":119389,"_2816":119852},[],"`authz` es el almacenamiento propio del servicio de autorización para principales, permisos y políticas. `pki` es la base de datos que consulta el motor de autorización al evaluar las políticas sobre las entidades. Solo se lee el campo `database` de cada entrada; la conexión usa siempre los values globales `postgres.hostname`, `postgres.port`, `postgres.username` y `postgres.password`.",{"_3328":70102,"_29138":69911,"_20209":119854,"_5":13819,"_26493":119389,"_2816":119855},[],"Si mantuviste los roles por defecto de 3.8.0 (`realm_access.roles` y `pki-admin`), el `services.authz.bootstrap` por defecto ya coincide con ellos.",{"_3328":70103,"_29138":69911,"_20209":119857,"_5":13819,"_26493":119389,"_2816":119858},[],"**Elimina los bloques de validación de tokens del gateway.** Quita `auth.oidc.apiGateway` y `auth.authorization` una vez que su configuración esté en `services.authz`:",{"_3328":70104,"_29138":69911,"_20209":119860,"_5":13819,"_26493":119389,"_2816":119861},[],"**Renombra `toolbox` a `connectivityTest`:**",{"_3328":70105,"_29138":69911,"_20209":119863,"_5":13819,"_26493":119389,"_2816":119864},[],"**Elimina las sobrescrituras de identidad por servicio** `services.kms.securityContext.runAsGroup` y `services.authz.securityContext.runAsUser`/`runAsGroup`.",{"_3328":70106,"_29138":69911,"_20209":119866,"_5":13819,"_26493":119389,"_2816":119867},[],"**Convierte `services.connectors` en un mapa** indexado por ID de conector, con el `type` y la `image` de cada entrada:",{"_3328":70107,"_29138":69911,"_20209":119869,"_5":13819,"_26493":119389,"_2816":119870},[],"**Revisa AMQP.** Si defines `amqp.tls: true`, define también `amqp.port` con el listener TLS del broker (habitualmente `5671`), o pon `amqp.tls: false` para seguir en texto plano.",{"_3328":70108,"_29138":69911,"_20209":119872,"_5":13819,"_26493":119389,"_2816":119873},[],"**Activa la migración de CA a KMS** si tus claves de CA son anteriores al KMS:",{"_3328":70109,"_29138":69911,"_20209":119875,"_5":13819,"_26493":119389,"_2816":119876},[],"**Revisa el resto de values:** sobrescrituras que fijaban `services.ui.port` a `80`, el antiguo bloque `probes:`, el issuer de TLS, y `affinity` y `topologySpreadConstraints` explícitos donde tu clúster los necesite. Values renombrados y reestructurados describe cada uno.",{"_3328":70110,"_29138":69911,"_20209":119878,"_5":13819,"_26493":119389,"_2816":119879},[],"Ejecuta `helm lint` con los values nuevos antes de actualizar; el schema estricto informa de cualquier clave que siga siendo desconocida.",{"_3328":70111,"_29138":69911,"_20209":119881,"_5":13819,"_26493":119393,"_2816":119882},[],"Helm ejecuta los hooks de preactualización —la migración de CA a KMS si está activada y el job de base de datos— antes de aplicar ninguna carga, así que los servicios nunca arrancan contra una base de datos sin preparar. Si la validación rechaza values desconocidos, corrige el archivo y vuelve a ejecutar.",{"_3328":70112,"_29138":69911,"_20209":119884,"_5":13819,"_26493":119393,"_2816":119885},[],"Si el despliegue usa almacenamiento local en el KMS o la VA, esos pods fallan hasta que completes el paso 4, así que `--wait` no puede terminar bien: Helm espera a que estén listos, agota el tiempo, sale con error y marca la release como `failed`. Para entonces los hooks ya se han ejecutado y se han aplicado todos los manifiestos, incluidos los nuevos StatefulSets y sus PVC. Sin `--atomic`, Helm no revierte nada. Continúa con el paso 4 y después vuelve a lanzar el mismo comando `helm upgrade` para que termine y Helm registre la release como `deployed`. Los dos hooks son idempotentes, así que es seguro volver a ejecutarlos.",{"_3328":70113,"_29138":69911,"_20209":119887,"_5":13819,"_26493":119397,"_2816":119888},[],"Omite este paso si `services.kms.cryptoEngines` nunca usó un motor `filesystem` y `services.va.fileStore.type` nunca fue `local`.",{"_3328":70114,"_29138":69911,"_20209":119890,"_5":13819,"_26493":119397,"_2816":119891},[],"**Localiza los nuevos StatefulSets y PVC.** Sus nombres dependen del nombre de la release y de cualquier `nameOverride` o `fullnameOverride`; el nombre del PVC es `<volumeClaimTemplate>-<nombre del StatefulSet>-0`:",{"_3328":70115,"_29138":69911,"_20209":119893,"_5":13819,"_26493":119397,"_2816":119894},[],"Con la release `lamassu` y el nombre de chart por defecto, los nuevos PVC son `golang-engine-storage-lamassu-kms-0` y `local-crl-file-storage-lamassu-va-0`; con la release `prod` son `golang-engine-storage-prod-lamassu-kms-0` y `local-crl-file-storage-prod-lamassu-va-0`. Comprueba que existen los PVC antiguos y nuevos antes de continuar. Si `claims_ok` imprime `ABORT`, el bloque se detiene antes de listar las PVC: o falló la búsqueda de un StatefulSet, o una PVC nueva resuelve a la PVC de 3.8.0. En el segundo caso la copia se verificaría contra sí misma y la limpieza final borraría el volumen en uso. El chart siempre añade `-kms` y `-va` al nombre con ámbito de release, así que una colisión indica que las PVC no son las que esta guía espera; investiga antes de seguir. El punto 3 repite la comprobación y no crea el pod auxiliar, así que nada toca los volúmenes. La comprobación devuelve un error en lugar de llamar a `exit`, que cerraría tu shell y perdería las variables definidas hasta ahora. Si solo migras uno de los dos servicios, quita las PVC del otro de los comandos siguientes.",{"_3328":70116,"_29138":69911,"_20209":119896,"_5":13819,"_26493":119397,"_2816":119897},[],"**Anota el número de réplicas, reduce a cero los nuevos StatefulSets y espera a que terminen todos los pods que usan las PVC**, para que nada escriba en ninguno de los volúmenes mientras copias. Helm elimina los StatefulSets `kms` y `va` de 3.8.0 durante la actualización, pero sus pods `kms-0` y `va-0` pueden seguir terminando y reteniendo las PVC antiguas. Mientras sigan en marcha, el pod auxiliar no puede montar las PVC o copia un volumen en el que aún se escribe. El `wait` termina al instante para los pods que ya no existen:",{"_3328":70117,"_29138":69911,"_20209":119899,"_5":13819,"_26493":119397,"_2816":119900},[],"**Arranca un pod auxiliar efímero** que monte las cuatro PVC. Se ejecuta como root para poder cambiar la propiedad de los archivos, así que fija su imagen por digest y no montes el token de la service account:",{"_3328":70118,"_29138":69911,"_20209":119902,"_5":13819,"_26493":119397,"_2816":119903},[],"**Inspecciona antes de escribir** para no machacar datos que los pods nuevos pudieran haber escrito ya:",{"_3328":70119,"_29138":69911,"_20209":119905,"_5":13819,"_26493":119397,"_2816":119906},[],"Un resultado vacío es lo habitual: el pod propio de un StatefulSet rara vez llega a escribir nada cuando le faltan sus datos. Si la salida no está vacía, anota los archivos y confirma con el responsable del servicio que se pueden descartar antes de copiar; no superpongas los datos de 3.8.0 sobre un almacén desconocido.",{"_3328":70120,"_29138":69911,"_20209":119908,"_5":13819,"_26493":119397,"_2816":119909},[],"**Copia los datos, ajusta la propiedad y verifica la copia.** El segundo comando debe imprimir `copy verified`; cualquier salida de `diff` indica que la copia está incompleta, así que no continúes:",{"_3328":70121,"_29138":69911,"_20209":119911,"_5":13819,"_26493":119397,"_2816":119912},[],"El `chown` es obligatorio aunque los archivos antiguos ya parezcan pertenecer a un usuario sin root, porque 4.0.0 exige exactamente `65532:65532` y no recurre a lo que declare la imagen.",{"_3328":70122,"_29138":69911,"_20209":119914,"_5":13819,"_26493":119397,"_2816":119915},[],"**Elimina el auxiliar y restaura el número de réplicas anotado:**",{"_3328":70123,"_29138":69911,"_20209":119917,"_5":13819,"_26493":119397,"_2816":119918},[],"**Vuelve a lanzar el comando `helm upgrade` del paso 3.** Los pods del KMS y la VA arrancan ahora con los datos copiados, así que `--wait` termina bien y la release pasa de `failed` a `deployed`.",{"_3328":70124,"_29138":69911,"_20209":119920,"_5":13819,"_26493":119401,"_2816":119921},[],"Cuando la actualización que realizó la migración de CA a KMS termine correctamente, quita `migrations.caToKms.enabled` de tus values (su valor por defecto es `false`). El hook lee el ConfigMap heredado `kms-config` de 3.8.0 mientras existe y, cuando desaparece, recurre al ConfigMap con ámbito de release `<release>-lamassu-kms-config`.",{"_3328":70125,"_29138":69911,"_20209":119923,"_5":13819,"_26493":119401,"_2816":119924},[],"Después recorre el checklist de validación. Conserva los PVC antiguos hasta que lo superes.",{"_3328":70126,"_29138":69911,"_20209":119926,"_5":13819,"_26493":119405,"_2816":119927},[],"Sin el job de base de datos del chart, ninguna herramienta mueve datos entre bases de datos: las herramientas de migración solo aplican migraciones sobre un esquema que ya existe. Traslada tú cada base de datos por servicio a su esquema de `pki`, conservando estructura, índices, restricciones, datos e historial de migraciones, con las escrituras detenidas y una copia de seguridad verificada.",{"_3328":70127,"_29138":69911,"_20209":119929,"_5":13819,"_26493":119405,"_2816":119930},[],"Para aplicar las migraciones a mano, `goose-lamassu` debe ejecutarse contra la base `pki` con `search_path=<esquema>` en la cadena de conexión. El binario solo valida `search_path`, no el nombre de la base de datos, así que comprueba `dbname=pki` antes de ejecutarlo, y repítelo para `kms`, `ca`, `va`, `devicemanager`, `dmsmanager` y `alerts`:",{"_3328":70128,"_29138":69911,"_20209":119932,"_5":13819,"_26493":119405,"_2816":119933},[],"Ejecuta `ca-to-kms-migration` primero con `--dry-run`, que informa sin escribir en el almacenamiento del KMS, y después de forma real:",{"_3328":70129,"_29138":69911,"_20209":119935,"_5":13819,"_26493":119405,"_2816":119936},[],"Apunta la configuración `storage` de la herramienta a la base `pki`, donde los datos de CA y del KMS viven ahora en los esquemas `ca` y `kms`. Las opciones de la herramienta se describen en `backend/cmd/ca-to-kms-migration/README.md`, en el repositorio `lamassuiot`.",{"_3328":70130,"_29138":69911,"_20209":119938,"_5":13819,"_26493":119405,"_2816":119939},[],"El README de `goose-lamassu` aún muestra ejemplos por base de datos (`dbname=ca`, `dbname=kms`) y afirma que la herramienta valida el nombre de la base de datos, y el README de `ca-to-kms-migration` sigue describiendo el modelo de dos bases anterior a 4.0.0. Sigue la forma con `dbname=pki` de esta página en lugar de sus ejemplos.",{"_3328":70131,"_29138":69911,"_20209":119941,"_5":13819,"_26493":119409,"_2816":119942},[],"**Los pods del KMS o la VA fallan con `no such file or directory` o `code=NotFound` justo después de actualizar.** Los pods están enlazados a los PVC nuevos y vacíos y la migración de datos aún no se ha hecho, o se copió en el PVC equivocado. Sigue el paso 4 y comprueba que existen las cuatro PVC.",{"_3328":70132,"_29138":69911,"_20209":119944,"_5":13819,"_26493":119409,"_2816":119945},[],"**`helm upgrade --wait` agota el tiempo y `helm status` muestra la release como `failed`.** Con almacenamiento local en el KMS o la VA es lo esperado en la primera ejecución: los nuevos pods no pueden estar listos hasta que se copien sus datos. Los hooks se ejecutaron y los manifiestos y PVC se aplicaron, así que completa el paso 4 y vuelve a lanzar el mismo comando `helm upgrade`. Si otros pods tampoco están listos, revisa sus logs, porque falla algo más.",{"_3328":70133,"_29138":69911,"_20209":119947,"_5":13819,"_26493":119409,"_2816":119948},[],"**El pod auxiliar se queda en `Pending` o `ContainerCreating` y `kubectl wait` agota el tiempo.** Otro pod sigue reteniendo alguna de las PVC; en almacenamiento de bloque, `kubectl describe pod pvc-migrate-helper` muestra un `Multi-Attach error`. Comprueba con `kubectl get pods -n $NAMESPACE` que `kms-0`, `va-0` y los nuevos pods del KMS y la VA han desaparecido, y vuelve a ejecutar el wait.",{"_3328":70134,"_29138":69911,"_20209":119950,"_5":13819,"_26493":119409,"_2816":119951},[],"**`helm upgrade` falla con un error de validación por clave desconocida.** Elimina o renombra los values heredados —normalmente `toolbox`, `auth.oidc.apiGateway` o `auth.authorization`—, porque el schema estricto rechaza las claves que no conoce.",{"_3328":70135,"_29138":69911,"_20209":119953,"_5":13819,"_26493":119409,"_2816":119954},[],"**La actualización falla en el job de base de datos.** El rol de PostgreSQL no puede crear bases de datos o esquemas, o una migración de esquema abortó por IDs de CA duplicados o por valores de `engine_id` vacíos. Revisa los logs del job, corrige los permisos o los datos y vuelve a ejecutar la actualización.",{"_3328":70136,"_29138":69911,"_20209":119956,"_5":13819,"_26493":119409,"_2816":119957},[],"**La actualización falla en el hook de CA a KMS.** Hay certificados de CA que comparten un `subject_key_id` y declaran `engine_id` en conflicto. Resuelve el conflicto y vuelve a ejecutar.",{"_3328":70137,"_29138":69911,"_20209":119959,"_5":13819,"_26493":119409,"_2816":119960},[],"**Nadie puede iniciar sesión tras la actualización.** Comprueba que `services.authz.jwkUrl` es accesible desde el pod de `authz`, que `services.authz.bootstrap` coincide con un rol que tu proveedor OIDC asigna realmente y que el job de base de datos terminó.",{"_3328":70138,"_29138":69911,"_20209":119962,"_5":13819,"_26493":119412,"_2816":119963},[],"Tras la actualización, comprueba en este orden:",{"_3328":70139,"_29138":69911,"_20209":119965,"_5":13819,"_26493":119412,"_2816":119966},[],"**Bases de datos.** Cada servicio lee la base `pki` con su propio esquema, los datos de `authz` y `wfx` son accesibles y el estado de las migraciones está registrado por esquema, incluidas las migraciones del ID único de CA y de la clave compuesta del KMS.",{"_3328":70140,"_29138":69911,"_20209":119968,"_5":13819,"_26493":119412,"_2816":119969},[],"**KMS y VA arrancan sin errores.** Sus logs no muestran errores `no such file or directory` ni `code=NotFound`.",{"_3328":70141,"_29138":69911,"_20209":119971,"_5":13819,"_26493":119412,"_2816":119972},[],"**Las claves existentes del KMS funcionan.** Emite un certificado desde una CA que ya existía antes de la actualización. Ninguna de las otras comprobaciones lee una clave del KMS, así que esta es la única que demuestra que el material de claves se ha copiado.",{"_3328":70142,"_29138":69911,"_20209":119974,"_5":13819,"_26493":119412,"_2816":119975},[],"**Las CRLs existentes se sirven.** `GET /crl/<ca-ski>` sobre la VA devuelve una CRL emitida anteriormente, y se emiten CRLs nuevas.",{"_3328":70143,"_29138":69911,"_20209":119977,"_5":13819,"_26493":119412,"_2816":119978},[],"**Claves de CA heredadas.** Si se ejecutó la migración de CA a KMS, revisa su informe y sus avisos y confirma que las claves esperadas aparecen en el KMS.",{"_3328":70144,"_29138":69911,"_20209":119980,"_5":13819,"_26493":119412,"_2816":119981},[],"**Conectividad.** `helm test \"$RELEASE\" -n $NAMESPACE --logs` pasa; el hook comprueba los endpoints de salud de CA, DMS Manager, Device Manager y VA, y la respuesta de la UI.",{"_3328":70145,"_29138":69911,"_20209":119983,"_5":13819,"_26493":119412,"_2816":119984},[],"**Autorización.** Inicia sesión con el principal de bootstrap y confirma que la administración funciona, comprueba que una identidad sin permisos recibe `403` y revisa los permisos de clientes e integraciones.",{"_3328":70146,"_29138":69911,"_20209":119986,"_5":13819,"_26493":119412,"_2816":119987},[],"**AMQP.** El backend se conecta al broker con la configuración TLS esperada, y la política de limpieza de las colas de SSE está en marcha.",{"_3328":70147,"_29138":69911,"_20209":119989,"_5":13819,"_26493":119412,"_2816":119990},[],"**Eventos de dispositivo.** `GET /v1/devices/:id/events` devuelve los eventos históricos de un dispositivo que los tenía.",{"_3328":70148,"_29138":69911,"_20209":119992,"_5":13819,"_26493":119412,"_2816":119993},[],"**Webhooks sin campos de archivo.** En cada DMS que usa webhook en enrolamiento o reenrolamiento, el bloque `config` incluye `insecure_skip_verify` y el bloque de opciones esperado (`apikey_options`, `jwt_options` o `mtls_options`), con el certificado y la clave en PEM y sin `cert_file` ni `key_file`.",{"_3328":70149,"_29138":69911,"_20209":119995,"_5":13819,"_26493":119412,"_2816":119996},[],"**Verificación del receptor.** `insecure_skip_verify` es `false`, salvo que el certificado del receptor no sea verificable de forma intencionada.",{"_3328":70150,"_29138":69911,"_20209":119998,"_5":13819,"_26493":119412,"_2816":119999},[],"**Entrega de webhooks.** Un enrolamiento o reenrolamiento a través de cada webhook migrado completa su llamada de autorización.",{"_3328":70151,"_29138":69911,"_20209":120001,"_5":13819,"_26493":119412,"_2816":120002},[],"**Conjunto de confianza.** `est_rfc7030_settings.client_certificate_settings.validation_cas` contiene las CAs esperadas, en particular las de la CA antigua durante los solapamientos de rotación.",{"_3328":70152,"_29138":69911,"_20209":120004,"_5":13819,"_26493":119412,"_2816":120005},[],"**Clientes de la API.** Los scripts y consolas ya no usan el formato antiguo del DMS (`additional_validation_cas` plano, o los campos heredados `mtls`, `apikey` y `oidc`), envían las actualizaciones del DMS con el ID en la URL y comparan con los nuevos valores de `type` del certificado.",{"_3328":70153,"_29138":69911,"_20209":120007,"_5":13819,"_26493":119416,"_2816":120008},[],"Solo cuando pasen todas las comprobaciones, elimina los volúmenes huérfanos de 3.8.0 para recuperar almacenamiento. El borrado es irreversible y el volumen antiguo del KMS puede contener la última copia del material de claves de tus CA, así que antes haz un `VolumeSnapshot` o una copia de seguridad de ambos PVC antiguos y consérvala hasta que confíes en que el despliegue actualizado funciona correctamente. Son los nombres fijos de 3.8.0 que anotaste en el paso 1; antes de borrarlos, confirma que ningún pod en marcha los monta, por ejemplo con `kubectl describe pvc -n $NAMESPACE golang-engine-storage-kms-0 local-crl-file-storage-va-0`, donde `Used By` debe ser `<none>`:",{"_3328":70154,"_29138":69911,"_20209":120010,"_5":13819,"_26493":119416,"_2816":120011},[],"Las bases de datos por servicio de 3.8.0 tampoco se usan ya. Elimínalas solo cuando pasen las mismas comprobaciones y tengas verificada la copia de seguridad de PostgreSQL.",{"_3328":70155,"_29138":69911,"_20209":120013,"_5":13819,"_26493":119416,"_2816":120014},[],"<Card title=\"Instalar con Helm\" description=\"Prepara las dependencias, configura los values e instala un despliegue controlado.\" href=\"/docs/deployment/self-hosted/helm\" />",{"_3328":70156,"_29138":69911,"_20209":120016,"_5":13819,"_26493":119416,"_2816":120017},[],"<Card title=\"Control de acceso\" description=\"Principales, políticas y el primer administrador.\" href=\"/docs/platform/administration/access-control\" />",{"_3328":70157,"_29138":69911,"_20209":120019,"_5":13819,"_26493":119416,"_2816":120020},[],"<Card title=\"Configurar un DMS\" description=\"Ajustes de enrolamiento, reenrolamiento y webhooks.\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_56146":120022,"_56148":120023,"_56150":120024,"_56152":120025,"_17488":2838,"_67355":2838},"spanish",[2816,29138,5,26493],{"_2816":24136,"_29138":24136,"_5":24136,"_26493":24136},{"_2816":120026,"_29138":122825,"_5":125624,"_26493":128423},{"_4473":120027,"_56156":120028,"_5":24136},{"_13901":12816,"_14277":4008,"_14296":4537,"_12464":7333,"_14283":5792,"_19180":18501,"_13922":5748,"_13929":7296,"_28090":4697,"_28498":3221,"_28519":7172,"_28124":5532,"_33348":2926,"_28226":23970,"_28563":2856,"_33355":6251,"_33358":4423,"_33361":7179,"_33364":4926,"_28970":3373,"_33369":3848,"_33371":3112,"_29000":19418,"_14292":24145,"_33375":6884,"_33378":3113,"_33380":15424