":31774,"_1570":31897},[],"Muestra la ayuda y finaliza",{"_7897":72,"_22053":34,"_18699":31899,"_5":22186,"_15048":31774,"_1570":31900},[],"`-n`, `--non-interactive`",{"_7897":73,"_22053":34,"_18699":31902,"_5":22186,"_15048":31774,"_1570":31903},[],"`false`",{"_7897":74,"_22053":34,"_18699":31905,"_5":22186,"_15048":31774,"_1570":31906},[],"Omite prompts y genera/usa credenciales por defecto",{"_7897":75,"_22053":34,"_18699":31908,"_5":22186,"_15048":31774,"_1570":31909},[],"`-ns`, `--namespace`",{"_7897":76,"_22053":34,"_18699":31911,"_5":22186,"_15048":31774,"_1570":31912},[],"`lamassu-dev`",{"_7897":77,"_22053":34,"_18699":31914,"_5":22186,"_15048":31774,"_1570":31915},[],"Namespace Kubernetes donde se despliegan los recursos",{"_7897":78,"_22053":34,"_18699":31917,"_5":22186,"_15048":31774,"_1570":31918},[],"`-d`, `--domain`",{"_7897":79,"_22053":34,"_18699":31920,"_5":22186,"_15048":31774,"_1570":31921},[],"`dev.lamassu.io`",{"_7897":80,"_22053":34,"_18699":31923,"_5":22186,"_15048":31774,"_1570":31924},[],"Dominio usado para endpoint y certificados TLS",{"_7897":81,"_22053":34,"_18699":31926,"_5":22186,"_15048":31774,"_1570":31927},[],"`-v`, `--version`",{"_7897":82,"_22053":34,"_18699":31929,"_5":22186,"_15048":31774,"_1570":31930},[],"`latest`",{"_7897":83,"_22053":34,"_18699":31932,"_5":22186,"_15048":31774,"_1570":31933},[],"Versión del chart Helm de Lamassu",{"_7897":84,"_22053":34,"_18699":31935,"_5":22186,"_15048":31774,"_1570":31936},[],"`--https-port`",{"_7897":85,"_22053":34,"_18699":31938,"_5":22186,"_15048":31774,"_1570":31939},[],"`443`",{"_7897":86,"_22053":34,"_18699":31941,"_5":22186,"_15048":31774,"_1570":31942},[],"Puerto HTTPS del gateway",{"_7897":87,"_22053":34,"_18699":31944,"_5":22186,"_15048":31774,"_1570":31945},[],"`--http-port`",{"_7897":88,"_22053":34,"_18699":31947,"_5":22186,"_15048":31774,"_1570":31948},[],"`80`",{"_7897":89,"_22053":34,"_18699":31950,"_5":22186,"_15048":31774,"_1570":31951},[],"Puerto HTTP del gateway",{"_7897"