96,"_41502":60198,"_41504":60200,"_41506":60203,"_41508":60205,"_41510":60208,"_41512":60211,"_41514":60214,"_41516":60217,"_41518":60220,"_41520":60223,"_41522":60226,"_41524":60229,"_41526":60232,"_41528":60235,"_41530":60238,"_41532":60241,"_41534":60244,"_41536":60247,"_41538":60250,"_41540":60253,"_41542":60256,"_41544":60259,"_41546":60262,"_41548":60265,"_41551":60268,"_41553":60271,"_41555":60274,"_41557":60277,"_41559":60280,"_41561":60283,"_41563":60286,"_41565":60289,"_41567":60292,"_41569":60295,"_41571":60298,"_41573":60301,"_41575":60304,"_41577":60307,"_41580":60310,"_41582":60313,"_41584":60316,"_41586":60319,"_41588":60322,"_41590":60325,"_41592":60328,"_41594":60331,"_41596":60334,"_41598":60337,"_41600":60340,"_41602":60343,"_41604":60346,"_41606":60349,"_41608":60352,"_41610":60355,"_41612":60358,"_41614":60361,"_41616":60364,"_41618":60367,"_41620":60370,"_41622":60373,"_41624":60376,"_41626":60379,"_41628":60382,"_41630":60385,"_41632":60388,"_41634":60391,"_41636":60394,"_41638":60397,"_41640":60400,"_41642":60403,"_41645":60406,"_41647":60409,"_41649":60412,"_41651":60415},{"_3624":15,"_31165":15,"_5":15217,"_3076":50898,"_31503":50899,"_21590":50903,"_28357":15},"Deploy from AWS Marketplace",[50900,50901,50902],"Docs","Deployment","Other models",[],{"_3624":16,"_31165":15,"_21590":50905,"_5":14857,"_28357":15,"_3076":50906},[],"Run a preconfigured Lamassu IoT instance on Amazon EC2.",{"_3624":17,"_31165":15,"_5":31500,"_21590":50908,"_28357":50909,"_3076":50910},[],"/docs/deployment/aws-marketplace#before-you-begin","Before you begin",{"_3624":18,"_31165":15,"_5":31500,"_21590":50912,"_28357":50913,"_3076":50914},[],"/docs/deployment/aws-marketplace#infrastructure-requirements","Infrastructure requirements",{"_3624":19,"_31165":15,"_5":31500,"_21590":50916,"_28357":50917,"_3076":50918},[],"/docs/deployment/aws-marketplace#open-the-offer","Open the offer",{"_3624":20,"_31165":15,"_5":31500,"_21590":50920,"_28357":50921,"_3076":50922},[],"/docs/deployment/aws-marketplace#configure-the-instance","Configure the instance",{"_3624":21,"_31165":15,"_5":31500,"_21590":50924,"_28357":50925,"_3076":50926},[],"/docs/deployment/aws-marketplace#limit-network-access","Limit network access",{"_3624":22,"_31165":15,"_5":31500,"_21590":50928,"_28357":50929,"_3076":50930},[],"/docs/deployment/aws-marketplace#launch-and-verify","Launch and verify",{"_3624":23,"_31165":15,"_5":31500,"_21590":50932,"_28357":50933,"_3076":50934},[],"/docs/deployment/aws-marketplace#next-step","Next step",{"_3624":24,"_31165":15,"_21590":50936,"_5":14857,"_28357":15,"_3076":50937},[],"The AWS Marketplace offering reduces initial setup to an EC2 instance inside your account. You keep control of the network, storage and operation of the machine.",{"_3624":25,"_31165":15,"_21590":50939,"_5":14857,"_28357":50909,"_3076":50940},[],"Permissions to subscribe to AWS Marketplace products and launch EC2 instances.",{"_3624":26,"_31165":15,"_21590":50942,"_5":14857,"_28357":50909,"_3076":50943},[],"A VPC and a subnet from which administrators and devices can reach the instance.",{"_3624":27,"_31165":15,"_21590":50945,"_5":14857,"_28357":50909,"_3076":50946},[],"A security group allowing the necessary endpoints.",{"_3624":28,"_31165":15,"_21590":50948,"_5":14857,"_28357":50913,"_3076":50949},[],"**Compute:** a `t3.large` instance at minimum. Use `t3.xlarge` or higher when the load requires it.",{"_3624":29,"_31165":15,"_21590":50951,"_5":14857,"_28357":50913,"_3076":50952},[],"**Storage:** an EBS `gp3` volume of at least 50 GB, sized to your inventory and retention needs.",{"_3624":30,"_31165":15,"_21590":50954,"_5":14857,"_28357":50913,"_3076":50955},[],"**Network:** HTTPS access from the necessary consumers, restricted to trusted networks.",{"_3624":31,"_31165":15,"_21590":50957,"_5":14857,"_28357":50917,"_3076":50958},[],"Go to Lamassu IoT on AWS Marketplace and review the terms before subscribing.",{"_3624":32,"_31165":15,"_21590":50960,"_5":14857,"_28357":50921,"_3076":50961},[],"Select `t3.large` or higher, assign at least 50 GB of `gp3` storage and choose the target VPC and subnet.",{"_3624":33,"_31165":15,"_21590":50963,"_5":14857,"_28357":50925,"_3076":50964},[],"Configure the security group for ports `443`, `8443` and `9443`. Restrict the origins to the administrative and device networks that really need to connect.",{"_3624":34,"_31165":15,"_21590":50966,"_5":14857,"_28357":50929,"_3076":50967},[],"Start the instance and open the console at `https://<public-ip>`. Check you can authenticate before continuing.",{"_3624":35,"_31165":15,"_21590":50969,"_5":14857,"_28357":50933,"_3076":50970},[],"Continue with Create your first CA to validate the instance's cryptographic configuration.",{"_3624":36,"_31165":36,"_5":15217,"_3076":50972,"_31503":50973,"_21590":50974,"_28357":36},"Deploy Lamassu",[50900,50901],[],{"_3624":37,"_31165":36,"_21590":50976,"_5":14857,"_28357":36,"_3076":50977},[],"Choose the operating model that fits your infrastructure and control requirements.",{"_3624":38,"_31165":36,"_5":31500,"_21590":50979,"_28357":50980,"_3076":50981},[],"/docs/deployment/overview#choose-a-model","Choose a model",{"_3624":39,"_31165":36,"_5":31500,"_21590":50983,"_28357":50984,"_3076":50985},[],"/docs/deployment/overview#just-want-to-evaluate-the-platform","Just want to evaluate the platform?",{"_3624":40,"_31165":36,"_5":31500,"_21590":50987,"_28357":50988,"_3076":50989},[],"/docs/deployment/overview#after-deployment","After deployment",{"_3624":41,"_31165":36,"_21590":50991,"_5":14857,"_28357":36,"_3076":50992},[],"You can run Lamassu on your own Kubernetes cluster, deploy a prebuilt image from AWS Marketplace or consume the platform as a managed service.",{"_3624":42,"_31165":36,"_21590":50994,"_5":14857,"_28357":50980,"_3076":50995},[],"Model",{"_3624":43,"_31165":36,"_21590":50997,"_5":14857,"_28357":50980,"_3076":50998},[],"Recommended for",{"_3624":44,"_31165":36,"_21590":51000,"_5":14857,"_28357":50980,"_3076":51001},[],"Who operates the infrastructure",{"_3624":45,"_31165":36,"_21590":51003,"_5":14857,"_28357":50980,"_3076":51004},[],"Starting point",{"_3624":46,"_31165":36,"_21590":51006,"_5":14857,"_28357":50980,"_3076":51007},[],"Kubernetes self-managed",{"_3624":47,"_31165":36,"_21590":51009,"_5":14857,"_28357":50980,"_3076":51010},[],"Production, regulated environments and custom deployments",{"_3624":48,"_31165":36,"_21590":51012,"_5":14857,"_28357":50980,"_3076":51013},[],"Your team",{"_3624":49,"_31165":36,"_21590":51015,"_5":14857,"_28357":50980,"_3076":51016},[],"Helm or Fastlane",{"_3624":50,"_31165":36,"_21590":51018,"_5":14857,"_28357":50980,"_3076":51019},[],"AWS Marketplace",{"_3624":51,"_31165":36,"_21590":51021,"_5":14857,"_28357":50980,"_3076":51022},[],"Evaluation or a dedicated deployment inside an AWS account",{"_3624":52,"_31165":36,"_21590":51024,"_5":14857,"_28357":50980,"_3076":51013},[],{"_3624":53,"_31165":36,"_21590":51026,"_5":14857,"_28357":50980,"_3076":51027},[],"Preconfigured image on EC2",{"_3624":54,"_31165":36,"_21590":51029,"_5":14857,"_28357":50980,"_3076":51030},[],"SaaS",{"_3624":55,"_31165":36,"_21590":51032,"_5":14857,"_28357":50980,"_3076":51033},[],"Teams that want to use the platform without operating it",{"_3624":56,"_31165":36,"_21590":51035,"_5":14857,"_28357":50980,"_3076":51036},[],"Lamassu",{"_3624":57,"_31165":36,"_21590":51038,"_5":14857,"_28357":50980,"_3076":51039},[],"Managed subscription",{"_3624":58,"_31165":36,"_21590":51041,"_5":14857,"_28357":50980,"_3076":51042},[],"<Card title=\"Kubernetes self-managed\" description=\"Control network, storage, keys, dependencies and the upgrade cycle.\" href=\"/docs/deployment/self-hosted/overview\" />",{"_3624":59,"_31165":36,"_21590":51044,"_5":14857,"_28357":50980,"_3076":51045},[],"<Card title=\"AWS Marketplace\" description=\"Launch a preconfigured Lamassu instance on AWS EC2.\" href=\"/docs/deployment/aws-marketplace\" />",{"_3624":60,"_31165":36,"_21590":51047,"_5":14857,"_28357":50980,"_3076":51048},[],"<Card title=\"Lamassu SaaS\" description=\"Use an operated and updated instance as a managed service.\" href=\"/docs/deployment/saas\" />",{"_3624":61,"_31165":36,"_21590":51050,"_5":14857,"_28357":50984,"_3076":51051},[],"Use Fastlane to bring up PostgreSQL, Keycloak, RabbitMQ and Lamassu on a Kubernetes cluster through a single flow. It is intended for labs, demos and bootstrap; for production, configure dependencies and Helm values explicitly.",{"_3624":62,"_31165":36,"_21590":51053,"_5":14857,"_28357":50988,"_3076":51054},[],"Once the console is available, continue with Create your first CA. That quickstart verifies the cryptographic engine and issuance work correctly.",{"_3624":63,"_31165":63,"_5":15217,"_3076":51056,"_31503":51057,"_21590":51058,"_28357":63},"Use Lamassu as SaaS",[50900,50901,50902],[],{"_3624":64,"_31165":63,"_21590":51060,"_5":14857,"_28357":63,"_3076":51061},[],"Consume Lamassu as a managed service without operating your own infrastructure.",{"_3624":65,"_31165":63,"_5":31500,"_21590":51063,"_28357":51064,"_3076":51065},[],"/docs/deployment/saas#what-the-service-manages","What the service manages",{"_3624":66,"_31165":63,"_5":31500,"_21590":51067,"_28357":51068,"_3076":51069},[],"/docs/deployment/saas#plans","Plans",{"_3624":67,"_31165":63,"_5":31500,"_21590":51071,"_28357":51072,"_3076":51073},[],"/docs/deployment/saas#request-access","Request access",{"_3624":68,"_31165":63,"_21590":51075,"_5":14857,"_28357":63,"_3076":51076},[],"Lamassu SaaS offers the platform's capabilities in a managed environment. It is the right option when your team wants to focus on PKI and device identities, not on maintaining the infrastructure that supports them.",{"_3624":69,"_31165":63,"_21590":51078,"_5":14857,"_28357":51064,"_3076":51079},[],"Platform availability and maintenance.",{"_3624":70,"_31165":63,"_21590":51081,"_5":14857,"_28357":51064,"_3076":51082},[],"Automatic backups.",{"_3624":71,"_31165":63,"_21590":51084,"_5":14857,"_28357":51064,"_3076":51085},[],"Version upgrades.",{"_3624":72,"_31165":63,"_21590":51087,"_5":14857,"_28357":51064,"_3076":51088},[],"Technical support and SLA according to your plan.",{"_3624":73,"_31165":63,"_21590":51090,"_5":14857,"_28357":51068,"_3076":51091},[],"Plan",{"_3624":74,"_31165":63,"_21590":51093,"_5":14857,"_28357":51068,"_3076":51094},[],"Devices",{"_3624":75,"_31165":63,"_21590":51096,"_5":14857,"_28357":51068,"_3076":51097},[],"Support",{"_3624":76,"_31165":63,"_21590":51099,"_5":14857,"_28357":51068,"_3076":51100},[],"SLA",{"_3624":77,"_31165":63,"_21590":51102,"_5":14857,"_28357":51068,"_3076":51103},[],"Starter",{"_3624":78,"_31165":63,"_21590":51105,"_5":14857,"_28357":51068,"_3076":51106},[],"Up to 1,000",{"_3624":79,"_31165":63,"_21590":51108,"_5":14857,"_28357":51068,"_3076":51109},[],"Email",{"_3624":80,"_31165":63,"_21590":51111,"_5":14857,"_28357":51068,"_3076":51112},[],"99.5 %",{"_3624":81,"_31165":63,"_21590":51114,"_5":14857,"_28357":51068,"_3076":51115},[],"Professional",{"_3624":82,"_31165":63,"_21590":51117,"_5":14857,"_28357":51068,"_3076":51118},[],"Up to 10,000",{"_3624":83,"_31165":63,"_21590":51120,"_5":14857,"_28357":51068,"_3076":51121},[],"Email and chat",{"_3624":84,"_31165":63,"_21590":51123,"_5":14857,"_28357":51068,"_3076":51124},[],"99.9 %",{"_3624":85,"_31165":63,"_21590":51126,"_5":14857,"_28357":51068,"_3076":51127},[],"Enterprise",{"_3624":86,"_31165":63,"_21590":51129,"_5":14857,"_28357":51068,"_3076":51130},[],"Unlimited",{"_3624":87,"_31165":63,"_21590":51132,"_5":14857,"_28357":51068,"_3076":51133},[],"Dedicated",{"_3624":88,"_31165":63,"_21590":51135,"_5":14857,"_28357":51068,"_3076":51136},[],"99.99 %",{"_3624":89,"_31165":63,"_21590":51138,"_5":14857,"_28357":51072,"_3076":51139},[],"Contact the Lamassu team through lamassu.io to request a demo or choose a plan.",{"_3624":90,"_31165":63,"_21590":51141,"_5":14857,"_28357":51072,"_3076":51142},[],"When you receive your instance's credentials, continue with Get started.",{"_3624":91,"_31165":91,"_5":15217,"_3076":51144,"_31503":51145,"_21590":51146,"_28357":91},"Fastlane",[50900,50901,51007],[],{"_3624":92,"_31165":91,"_21590":51148,"_5":14857,"_28357":91,"_3076":51149},[],"Bootstrap a complete Lamassu evaluation or lab environment on an existing Kubernetes cluster.",{"_3624":93,"_31165":91,"_5":31500,"_21590":51151,"_28357":51152,"_3076":51153},[],"/docs/deployment/self-hosted/fastlane#deploy-with-fastlane","Deploy with Fastlane",{"_3624":94,"_31165":91,"_5":31500,"_21590":51155,"_28357":51156,"_3076":51157},[],"/docs/deployment/self-hosted/fastlane#what-fastlane-adds","What Fastlane adds",{"_3624":95,"_31165":91,"_5":31500,"_21590":51159,"_28357":51160,"_3076":50910},[],"/docs/deployment/self-hosted/fastlane#before-you-begin",{"_3624":96,"_31165":91,"_5":31500,"_21590":51162,"_28357":51163,"_3076":51164},[],"/docs/deployment/self-hosted/fastlane#quick-start","Quick start",{"_3624":97,"_31165":91,"_5":31500,"_21590":51166,"_28357":51167,"_3076":51168},[],"/docs/deployment/self-hosted/fastlane#gateway-address-selection","Gateway address selection",{"_3624":98,"_31165":91,"_5":31500,"_21590":51170,"_28357":51171,"_3076":51172},[],"/docs/deployment/self-hosted/fastlane#command-line-options","Command-line options",{"_3624":99,"_31165":91,"_5":31500,"_21590":51174,"_28357":51175,"_3076":51176},[],"/docs/deployment/self-hosted/fastlane#development-mode","Development mode",{"_3624":100,"_31165":91,"_5":31500,"_21590":51178,"_28357":51179,"_3076":51180},[],"/docs/deployment/self-hosted/fastlane#what-the-script-configures","What the script configures",{"_3624":101,"_31165":91,"_5":31500,"_21590":51182,"_28357":51183,"_3076":51184},[],"/docs/deployment/self-hosted/fastlane#tls-behavior","TLS behavior",{"_3624":102,"_31165":91,"_5":31500,"_21590":51186,"_28357":51187,"_3076":51188},[],"/docs/deployment/self-hosted/fastlane#credentials-and-generated-files","Credentials and generated files",{"_3624":103,"_31165":91,"_5":31500,"_21590":51190,"_28357":51191,"_3076":51192},[],"/docs/deployment/self-hosted/fastlane#verify-the-installation","Verify the installation",{"_3624":104,"_31165":91,"_21590":51194,"_5":14857,"_28357":51152,"_3076":51195},[],"Fastlane is the automated path for evaluations, demos, CI and small lab clusters. It installs PostgreSQL, Keycloak, RabbitMQ, Envoy Gateway and Lamassu, then configures them to work together.",{"_3624":105,"_31165":91,"_21590":51197,"_5":14857,"_28357":51152,"_3076":51198},[],"For production, use Helm so database, identity, credentials, certificates, storage and upgrades remain explicit.",{"_3624":106,"_31165":91,"_21590":51200,"_5":14857,"_28357":51156,"_3076":51201},[],"Fastlane closes some of the gaps intentionally left by the application chart:",{"_3624":107,"_31165":91,"_21590":51203,"_5":14857,"_28357":51156,"_3076":51204},[],"Fastlane installs or configures",{"_3624":108,"_31165":91,"_21590":51206,"_5":14857,"_28357":51156,"_3076":51207},[],"You still provide",{"_3624":109,"_31165":91,"_21590":51209,"_5":14857,"_28357":51156,"_3076":51210},[],"PostgreSQL, RabbitMQ and Keycloak instances for evaluation",{"_3624":110,"_31165":91,"_21590":51212,"_5":14857,"_28357":51156,"_3076":51213},[],"The Kubernetes cluster, nodes and persistent storage",{"_3624":111,"_31165":91,"_21590":51215,"_5":14857,"_28357":51156,"_3076":51216},[],"Envoy Gateway 1.8 and the `eg` `GatewayClass`",{"_3624":112,"_31165":91,"_21590":51218,"_5":14857,"_28357":51156,"_3076":51219},[],"cert-manager, external network reachability, DNS and firewall/NAT rules",{"_3624":113,"_31165":91,"_21590":51221,"_5":14857,"_28357":51156,"_3076":51222},[],"A self-signed Lamassu certificate flow, dependency credentials stored in Kubernetes Secrets (through the External Secrets Operator) and an initial user",{"_3624":114,"_31165":91,"_21590":51224,"_5":14857,"_28357":51156,"_3076":51225},[],"Client trust for the self-signed CA, or a trusted certificate passed to the script",{"_3624":115,"_31165":91,"_21590":51227,"_5":14857,"_28357":51156,"_3076":51228},[],"Optional observability and lab HSM components",{"_3624":116,"_31165":91,"_21590":51230,"_5":14857,"_28357":51156,"_3076":51231},[],"Production monitoring retention, backups, HA and a production HSM/key service",{"_3624":117,"_31165":91,"_21590":51233,"_5":14857,"_28357":51156,"_3076":51234},[],"Fastlane does not turn the resulting stack into a production service: it does not create the cluster, public DNS, firewall rules, backups, high availability or a trusted public certificate.",{"_3624":118,"_31165":91,"_21590":51236,"_5":14857,"_28357":51160,"_3076":51237},[],"You need:",{"_3624":119,"_31165":91,"_21590":51239,"_5":14857,"_28357":51160,"_3076":51240},[],"an existing Kubernetes cluster",{"_3624":120,"_31165":91,"_21590":51242,"_5":14857,"_28357":51160,"_3076":51243},[],"`kubectl` and Helm, or the MicroK8s CLI",{"_3624":121,"_31165":91,"_21590":51245,"_5":14857,"_28357":51160,"_3076":51246},[],"`yq`",{"_3624":122,"_31165":91,"_21590":51248,"_5":14857,"_28357":51160,"_3076":24402},[],{"_3624":123,"_31165":91,"_21590":51250,"_5":14857,"_28357":51160,"_3076":51251},[],"`jq` only when using `--sample-data` or `--development`",{"_3624":124,"_31165":91,"_21590":51253,"_5":14857,"_28357":51160,"_3076":51254},[],"`ssh-keygen` only when using `--with-hsm`",{"_3624":125,"_31165":91,"_21590":51256,"_5":14857,"_28357":51160,"_3076":51257},[],"free external ports 80 and 443 on a single-node K3s host",{"_3624":126,"_31165":91,"_21590":51259,"_5":14857,"_28357":51160,"_3076":51260},[],"Fastlane detects MicroK8s, K3s, kind or a standard kubeconfig. Use `--context` when the intended cluster is not the current context.",{"_3624":127,"_31165":91,"_21590":51262,"_5":14857,"_28357":51160,"_3076":51263},[],"Fastlane installs several components and creates credentials. Check `kubectl config current-context` or pass `--context` before running it.",{"_3624":128,"_31165":91,"_21590":51265,"_5":14857,"_28357":51163,"_3076":51266},[],"Run the script from a clone of the Helm repository:",{"_3624":129,"_31165":91,"_21590":51268,"_5":14857,"_28357":51163,"_3076":51269},[],"Create a DNS record for the chosen domain before testing from another machine. For a small VM, point it at the VM or load-balancer address that actually receives ports 80 and 443.",{"_3624":130,"_31165":91,"_21590":51271,"_5":14857,"_28357":51167,"_3076":51272},[],"By default, Fastlane runs `hostname -I` and writes the returned addresses to `gateway.addresses` and to the self-signed certificate's IP SANs.",{"_3624":131,"_31165":91,"_21590":51274,"_5":14857,"_28357":51167,"_3076":51275},[],"On a single-homed lab VM this can select the expected node address. On hosts with Docker, VPN, WireGuard or several interfaces it can also select addresses clients cannot reach. Override the result explicitly:",{"_3624":132,"_31165":91,"_21590":51277,"_5":14857,"_28357":51167,"_3076":51278},[],"The value must be an address handled on the Kubernetes side of the traffic path. If a public EC2 address forwards through WireGuard to the cluster, pass the reachable cluster/VM address, not the EC2 public address.",{"_3624":133,"_31165":91,"_21590":51280,"_5":14857,"_28357":51167,"_3076":51281},[],"See Expose the Gateway for K3s port conflicts, VIPs, external NAT and multi-Gateway designs.",{"_3624":134,"_31165":91,"_21590":51283,"_5":14857,"_28357":51171,"_3076":51284},[],"Option",{"_3624":135,"_31165":91,"_21590":51286,"_5":14857,"_28357":51171,"_3076":51287},[],"Default",{"_3624":136,"_31165":91,"_21590":51289,"_5":14857,"_28357":51171,"_3076":51290},[],"Purpose",{"_3624":137,"_31165":91,"_21590":51292,"_5":14857,"_28357":51171,"_3076":51293},[],"`-h`, `--help`",{"_3624":138,"_31165":91,"_21590":51295,"_5":14857,"_28357":51171,"_3076":51296},[],"—",{"_3624":139,"_31165":91,"_21590":51298,"_5":14857,"_28357":51171,"_3076":51299},[],"Show help",{"_3624":140,"_31165":91,"_21590":51301,"_5":14857,"_28357":51171,"_3076":51302},[],"`-c`, `--context`",{"_3624":141,"_31165":91,"_21590":51304,"_5":14857,"_28357":51171,"_3076":51305},[],"current context",{"_3624":142,"_31165":91,"_21590":51307,"_5":14857,"_28357":51171,"_3076":51308},[],"Select the kubeconfig context for kubectl and Helm",{"_3624":143,"_31165":91,"_21590":51310,"_5":14857,"_28357":51171,"_3076":51311},[],"`-n`, `--non-interactive`",{"_3624":144,"_31165":91,"_21590":51313,"_5":14857,"_28357":51171,"_3076":6790},[],{"_3624":145,"_31165":91,"_21590":51315,"_5":14857,"_28357":51171,"_3076":51316},[],"Skip prompts and generate dependency credentials",{"_3624":146,"_31165":91,"_21590":51318,"_5":14857,"_28357":51171,"_3076":51319},[],"`-ns`, `--namespace`",{"_3624":147,"_31165":91,"_21590":51321,"_5":14857,"_28357":51171,"_3076":51322},[],"`lamassu-dev`",{"_3624":148,"_31165":91,"_21590":51324,"_5":14857,"_28357":51171,"_3076":51325},[],"Namespace for the installation",{"_3624":149,"_31165":91,"_21590":51327,"_5":14857,"_28357":51171,"_3076":51328},[],"`-d`, `--domain`",{"_3624":150,"_31165":91,"_21590":51330,"_5":14857,"_28357":51171,"_3076":51331},[],"`dev.lamassu.io`",{"_3624":151,"_31165":91,"_21590":51333,"_5":14857,"_28357":51171,"_3076":51334},[],"Domain used by the UI, OIDC and certificate",{"_3624":152,"_31165":91,"_21590":51336,"_5":14857,"_28357":51171,"_3076":51337},[],"`-v`, `--version`",{"_3624":153,"_31165":91,"_21590":51339,"_5":14857,"_28357":51171,"_3076":15569},[],{"_3624":154,"_31165":91,"_21590":51341,"_5":14857,"_28357":51171,"_3076":51342},[],"Lamassu chart version",{"_3624":155,"_31165":91,"_21590":51344,"_5":14857,"_28357":51171,"_3076":51345},[],"`--https-port`",{"_3624":156,"_31165":91,"_21590":51347,"_5":14857,"_28357":51171,"_3076":51348},[],"`443`",{"_3624":157,"_31165":91,"_21590":51350,"_5":14857,"_28357":51171,"_3076":51351},[],"Gateway HTTPS listener port",{"_3624":158,"_31165":91,"_21590":51353,"_5":14857,"_28357":51171,"_3076":51354},[],"`--http-port`",{"_3624":159,"_31165":91,"_21590":51356,"_5":14857,"_28357":51171,"_3076":51357},[],"`80`",{"_3624":160,"_31165":91,"_21590":51359,"_5":14857,"_28357":51171,"_3076":51360},[],"Gateway HTTP listener port",{"_3624":161,"_31165":91,"_21590":51362,"_5":14857,"_28357":51171,"_3076":51363},[],"`--tls-crt`",{"_3624":162,"_31165":91,"_21590":51365,"_5":14857,"_28357":51171,"_3076":51296},[],{"_3624":163,"_31165":91,"_21590":51367,"_5":14857,"_28357":51171,"_3076":51368},[],"PEM certificate for downstream TLS",{"_3624":164,"_31165":91,"_21590":51370,"_5":14857,"_28357":51171,"_3076":51371},[],"`--tls-key`",{"_3624":165,"_31165":91,"_21590":51373,"_5":14857,"_28357":51171,"_3076":51296},[],{"_3624":166,"_31165":91,"_21590":51375,"_5":14857,"_28357":51171,"_3076":51376},[],"PEM private key for downstream TLS",{"_3624":167,"_31165":91,"_21590":51378,"_5":14857,"_28357":51171,"_3076":51379},[],"`-l`, `--local-chart-path`",{"_3624":168,"_31165":91,"_21590":51381,"_5":14857,"_28357":51171,"_3076":51382},[],"repository chart",{"_3624":169,"_31165":91,"_21590":51384,"_5":14857,"_28357":51171,"_3076":51385},[],"Use an unpacked local Lamassu chart",{"_3624":170,"_31165":91,"_21590":51387,"_5":14857,"_28357":51171,"_3076":51388},[],"`-ip`, `--gateway-ip`",{"_3624":171,"_31165":91,"_21590":51390,"_5":14857,"_28357":51171,"_3076":9075},[],{"_3624":172,"_31165":91,"_21590":51392,"_5":14857,"_28357":51171,"_3076":51393},[],"Override the address written to `gateway.addresses`",{"_3624":173,"_31165":91,"_21590":51395,"_5":14857,"_28357":51171,"_3076":51396},[],"`--otel`",{"_3624":174,"_31165":91,"_21590":51398,"_5":14857,"_28357":51171,"_3076":6790},[],{"_3624":175,"_31165":91,"_21590":51400,"_5":14857,"_28357":51171,"_3076":51401},[],"Install Victoria Logs, VictoriaTraces, Jaeger and an OpenTelemetry Collector",{"_3624":176,"_31165":91,"_21590":51403,"_5":14857,"_28357":51171,"_3076":51404},[],"`--development`",{"_3624":177,"_31165":91,"_21590":51406,"_5":14857,"_28357":51171,"_3076":6790},[],{"_3624":178,"_31165":91,"_21590":51408,"_5":14857,"_28357":51171,"_3076":51409},[],"Development mode: fully provisions the Keycloak `lamassu` user (fixed `lamassu`/`lamassu` password, no first-login steps) and lets the `frontend` client accept any redirect URI or web origin. Not for production",{"_3624":179,"_31165":91,"_21590":51411,"_5":14857,"_28357":51171,"_3076":51412},[],"`--sample-data`",{"_3624":180,"_31165":91,"_21590":51414,"_5":14857,"_28357":51171,"_3076":6790},[],{"_3624":181,"_31165":91,"_21590":51416,"_5":14857,"_28357":51171,"_3076":51417},[],"Create sample CAs, profiles, certificates, DMS data and devices",{"_3624":182,"_31165":91,"_21590":51419,"_5":14857,"_28357":51171,"_3076":51420},[],"`--with-hsm`",{"_3624":183,"_31165":91,"_21590":51422,"_5":14857,"_28357":51171,"_3076":6790},[],{"_3624":184,"_31165":91,"_21590":51424,"_5":14857,"_28357":51171,"_3076":51425},[],"Install lab HSM components and configure KMS for PKCS#11",{"_3624":185,"_31165":91,"_21590":51427,"_5":14857,"_28357":51171,"_3076":51428},[],"`--softhsm-chart-path`",{"_3624":186,"_31165":91,"_21590":51430,"_5":14857,"_28357":51171,"_3076":51431},[],"`./charts/softhsm`",{"_3624":187,"_31165":91,"_21590":51433,"_5":14857,"_28357":51171,"_3076":51434},[],"Use a different local SoftHSM chart",{"_3624":188,"_31165":91,"_21590":51436,"_5":14857,"_28357":51171,"_3076":51437},[],"Fastlane does not provide an offline mode. Use the manual Helm workflow and a prepared registry/chart mirror for disconnected environments.",{"_3624":189,"_31165":91,"_21590":51439,"_5":14857,"_28357":51175,"_3076":51440},[],"`--development` adjusts the Keycloak `lamassu` realm generated by Fastlane for a disposable evaluation environment:",{"_3624":190,"_31165":91,"_21590":51442,"_5":14857,"_28357":51175,"_3076":51443},[],"the `lamassu` user is fully provisioned (first name Lamassu, last name Admin, email `lamassu@lamassu.io`, verified): there are no profile setup or password change steps on first login",{"_3624":191,"_31165":91,"_21590":51445,"_5":14857,"_28357":51175,"_3076":51446},[],"the well-known `lamassu`/`lamassu` password is fixed and permanent: it is never rotated and grants the `pki-admin` role, including non-interactive tokens through the `frontend` client",{"_3624":192,"_31165":91,"_21590":51448,"_5":14857,"_28357":51175,"_3076":51449},[],"the `frontend` client accepts any redirect URI and any web origin (`*`) instead of the original `/*` patterns",{"_3624":193,"_31165":91,"_21590":51451,"_5":14857,"_28357":51175,"_3076":51452},[],"With `--development`, the fixed `lamassu`/`lamassu` password grants `pki-admin` access to anyone who can reach the installation. Never use it on anything exposed beyond a development machine or a network-reachable host.",{"_3624":194,"_31165":91,"_21590":51454,"_5":14857,"_28357":51175,"_3076":51455},[],"`--development` applies when the `lamassu` realm is first imported. It does not modify an existing cluster. It can be combined with `--sample-data`: the development transform runs first, then sample data is added to the same realm configuration.",{"_3624":195,"_31165":91,"_21590":51457,"_5":14857,"_28357":51179,"_3076":51458},[],"Fastlane:",{"_3624":196,"_31165":91,"_21590":51460,"_5":14857,"_28357":51179,"_3076":51461},[],"validates local tools and the selected cluster",{"_3624":197,"_31165":91,"_21590":51463,"_5":14857,"_28357":51179,"_3076":51464},[],"installs or upgrades Envoy Gateway 1.8 and creates the `eg` `GatewayClass`",{"_3624":198,"_31165":91,"_21590":51466,"_5":14857,"_28357":51179,"_3076":51467},[],"creates the namespace",{"_3624":199,"_31165":91,"_21590":51469,"_5":14857,"_28357":51179,"_3076":51470},[],"installs the External Secrets Operator and creates the PostgreSQL, RabbitMQ and Keycloak administrator credentials as Secrets through a Fake `ClusterSecretStore`",{"_3624":200,"_31165":91,"_21590":51472,"_5":14857,"_28357":51179,"_3076":51473},[],"installs PostgreSQL and creates the required databases",{"_3624":201,"_31165":91,"_21590":51475,"_5":14857,"_28357":51179,"_3076":51476},[],"installs Keycloak and creates the `lamassu` realm, frontend client, admin role and initial user",{"_3624":202,"_31165":91,"_21590":51478,"_5":14857,"_28357":51179,"_3076":51479},[],"installs RabbitMQ",{"_3624":203,"_31165":91,"_21590":51481,"_5":14857,"_28357":51179,"_3076":51482},[],"optionally installs observability and lab HSM components",{"_3624":204,"_31165":91,"_21590":51484,"_5":14857,"_28357":51179,"_3076":51485},[],"generates `lamassu.yaml`, which references the Secrets instead of inline credentials, and installs the Lamassu chart",{"_3624":205,"_31165":91,"_21590":51487,"_5":14857,"_28357":51179,"_3076":51488},[],"optionally loads sample data",{"_3624":206,"_31165":91,"_21590":51490,"_5":14857,"_28357":51179,"_3076":51491},[],"The generated configuration exposes Keycloak at `/auth` through the same Gateway and bootstraps the initial `lamassu` user as a Lamassu super administrator.",{"_3624":207,"_31165":91,"_21590":51493,"_5":14857,"_28357":51183,"_3076":51494},[],"With both `--tls-crt` and `--tls-key`, Fastlane creates the `downstream-provided-crt` Secret and configures `tls.type: external`.",{"_3624":208,"_31165":91,"_21590":51496,"_5":14857,"_28357":51183,"_3076":51497},[],"Without them, it configures cert-manager with a self-signed issuer. This is suitable for a lab but will not be trusted by clients until you distribute the CA. Use Helm when you need a corporate Issuer, public ACME issuer or an existing Secret managed by another system.",{"_3624":209,"_31165":91,"_21590":51499,"_5":14857,"_28357":51187,"_3076":51500},[],"Non-interactive mode generates random PostgreSQL, RabbitMQ and Keycloak administrator passwords and stores them in Kubernetes Secrets through the External Secrets Operator's Fake `ClusterSecretStore`. Fastlane writes `lamassu.yaml` in the current directory referencing those Secrets — the values file no longer contains the credentials.",{"_3624":210,"_31165":91,"_21590":51502,"_5":14857,"_28357":51187,"_3076":51503},[],"The Keycloak administrator password is not printed by the script. Retrieve it from the Secret when needed:",{"_3624":211,"_31165":91,"_21590":51505,"_5":14857,"_28357":51187,"_3076":51506},[],"The initial Lamassu login is `lamassu` / `lamassu` and requires a password change on first use, unless `--development` was used: in that case the password stays fixed and permanent.",{"_3624":212,"_31165":91,"_21590":51508,"_5":14857,"_28357":51187,"_3076":51509},[],"The Fake `ClusterSecretStore` stores the credentials in plain text and is for lab use only: replace it with a real ESO provider for anything beyond a throwaway environment. Protect the generated values file, record the generated credentials in an appropriate secret store and do not reuse the evaluation identity setup in production.",{"_3624":213,"_31165":91,"_21590":51511,"_5":14857,"_28357":51191,"_3076":51512},[],"Then open `https://pki.example.com` and sign in with the initial user. If the Gateway is programmed but the URL is unreachable, follow the checks in Expose the Gateway.",{"_3624":214,"_31165":214,"_5":15217,"_3076":51514,"_31503":51515,"_21590":51516,"_28357":214},"Install with Helm",[50900,50901,51007],[],{"_3624":215,"_31165":214,"_21590":51518,"_5":14857,"_28357":214,"_3076":51519},[],"Prepare dependencies, configure the Lamassu chart and verify a controlled Kubernetes deployment.",{"_3624":216,"_31165":214,"_5":31500,"_21590":51521,"_28357":51522,"_3076":51523},[],"/docs/deployment/self-hosted/helm#install-lamassu-with-helm","Install Lamassu with Helm",{"_3624":217,"_31165":214,"_5":31500,"_21590":51525,"_28357":51526,"_3076":50910},[],"/docs/deployment/self-hosted/helm#before-you-begin",{"_3624":218,"_31165":214,"_5":31500,"_21590":51528,"_28357":51529,"_3076":51530},[],"/docs/deployment/self-hosted/helm#1-install-the-gateway-prerequisites","1\\. Install the Gateway prerequisites",{"_3624":219,"_31165":214,"_5":31500,"_21590":51532,"_28357":51533,"_3076":51534},[],"/docs/deployment/self-hosted/helm#2-create-a-values-file","2\\. Create a values file",{"_3624":220,"_31165":214,"_5":31500,"_21590":51536,"_28357":51537,"_3076":51538},[],"/docs/deployment/self-hosted/helm#credentials-in-kubernetes-secrets","Credentials in Kubernetes Secrets",{"_3624":221,"_31165":214,"_5":31500,"_21590":51540,"_28357":51541,"_3076":51542},[],"/docs/deployment/self-hosted/helm#tls-with-an-existing-secret","TLS with an existing Secret",{"_3624":222,"_31165":214,"_5":31500,"_21590":51544,"_28357":51545,"_3076":51546},[],"/docs/deployment/self-hosted/helm#amqp-tls-amqps","AMQP TLS (AMQPS)",{"_3624":223,"_31165":214,"_5":31500,"_21590":51548,"_28357":51549,"_3076":51550},[],"/docs/deployment/self-hosted/helm#provision-the-first-administrator","Provision the first administrator",{"_3624":224,"_31165":214,"_5":31500,"_21590":51552,"_28357":51553,"_3076":51554},[],"/docs/deployment/self-hosted/helm#3-install-lamassu","3\\. Install Lamassu",{"_3624":225,"_31165":214,"_5":31500,"_21590":51556,"_28357":51557,"_3076":51558},[],"/docs/deployment/self-hosted/helm#4-verify-the-deployment","4\\. Verify the deployment",{"_3624":226,"_31165":214,"_5":31500,"_21590":51560,"_28357":51561,"_3076":51562},[],"/docs/deployment/self-hosted/helm#upgrading-lamassu","Upgrading Lamassu",{"_3624":227,"_31165":214,"_5":31500,"_21590":51564,"_28357":51565,"_3076":51566},[],"/docs/deployment/self-hosted/helm#production-decisions","Production decisions",{"_3624":228,"_31165":214,"_21590":51568,"_5":14857,"_28357":51522,"_3076":51569},[],"Use the Helm workflow when you need explicit control over identity, databases, messaging, certificates, storage and upgrades. For an evaluation environment where the script can make those choices for you, use Fastlane.",{"_3624":229,"_31165":214,"_21590":51571,"_5":14857,"_28357":51526,"_3076":51572},[],"Prepare the platform services that are deliberately outside the Lamassu chart:",{"_3624":230,"_31165":214,"_21590":51574,"_5":14857,"_28357":51526,"_3076":51575},[],"a Kubernetes 1.24+ cluster and Helm 3.2+",{"_3624":231,"_31165":214,"_21590":51577,"_5":14857,"_28357":51526,"_3076":51578},[],"a reachable PostgreSQL server and a role allowed to create databases and schemas",{"_3624":232,"_31165":214,"_21590":51580,"_5":14857,"_28357":51526,"_3076":51581},[],"a reachable RabbitMQ broker and credentials",{"_3624":233,"_31165":214,"_21590":51583,"_5":14857,"_28357":51526,"_3076":51584},[],"Kubernetes Secrets in the release namespace holding the PostgreSQL and RabbitMQ credentials (and SMTP credentials when SMTP authentication is required) — the chart reads credentials from Secrets and rejects inline values (see Credentials in Kubernetes Secrets)",{"_3624":234,"_31165":214,"_21590":51586,"_5":14857,"_28357":51526,"_3076":51587},[],"an OIDC provider, normally Keycloak, with a realm/tenant and client for Lamassu",{"_3624":235,"_31165":214,"_21590":51589,"_5":14857,"_28357":51526,"_3076":51590},[],"Envoy Gateway 1.8+ and a `GatewayClass`",{"_3624":236,"_31165":214,"_21590":51592,"_5":14857,"_28357":51526,"_3076":51593},[],"cert-manager 1.14+ (only for the default `tls.type: certManager` mode); for trusted TLS, either a trusted issuer or a Kubernetes TLS Secret",{"_3624":237,"_31165":214,"_21590":51595,"_5":14857,"_28357":51526,"_3076":51596},[],"a StorageClass and an external traffic design",{"_3624":238,"_31165":214,"_21590":51598,"_5":14857,"_28357":51526,"_3076":51599},[],"The chart defaults to a `GatewayClass` named `eg`. Change `gateway.className` if your platform team uses another name.",{"_3624":239,"_31165":214,"_21590":51601,"_5":14857,"_28357":51526,"_3076":51602},[],"You provide the PostgreSQL server. The chart's pre-install job connects with the supplied credentials, creates the required `pki`, `authz` and `wfx` databases and service schemas, runs migrations, and applies `services.authz.bootstrap`.",{"_3624":240,"_31165":214,"_21590":51604,"_5":14857,"_28357":51526,"_3076":51605},[],"The chart has no Helm dependencies that install PostgreSQL, RabbitMQ, an OIDC provider, Envoy Gateway or cert-manager.",{"_3624":241,"_31165":214,"_21590":51607,"_5":14857,"_28357":51529,"_3076":51608},[],"Install or upgrade the Envoy Gateway CRDs before its controller. The commands below match the version used by the Lamassu Helm repository:",{"_3624":242,"_31165":214,"_21590":51610,"_5":14857,"_28357":51529,"_3076":51611},[],"Create the default `GatewayClass` if it does not already exist. Save this manifest as `gateway-class.yaml`:",{"_3624":243,"_31165":214,"_21590":51613,"_5":14857,"_28357":51529,"_3076":51614},[],"Install cert-manager separately before Lamassu, but only for the default `tls.type: certManager` mode. In that mode the chart renders its self-signed Issuer and CA Certificate resources regardless of whether `tls.certManagerOptions.clusterIssuer` is set, so cert-manager stays a prerequisite. With `tls.type: external`, the chart renders no cert-manager resources and the Gateway terminates TLS with an existing Secret you provide instead.",{"_3624":244,"_31165":214,"_21590":51616,"_5":14857,"_28357":51533,"_3076":51617},[],"Start with the chart defaults and override the environment-specific values. This example assumes PostgreSQL, RabbitMQ and Keycloak are reachable through Kubernetes DNS, and exposes Keycloak at `/auth` through the shared Lamassu Gateway:",{"_3624":245,"_31165":214,"_21590":51619,"_5":14857,"_28357":51533,"_3076":51620},[],"Do not add `gateway.addresses` by default. Leave address assignment to the load-balancer implementation unless your network design requires a specific Kubernetes-side VIP. The public IP of an upstream NAT gateway or reverse proxy does not belong in this value.",{"_3624":246,"_31165":214,"_21590":51622,"_5":14857,"_28357":51533,"_3076":51623},[],"If Keycloak is external and already has its own reachable URL, point the OIDC settings at it and omit the `/auth` entry from `gateway.extraRouting`.",{"_3624":247,"_31165":214,"_21590":51625,"_5":14857,"_28357":51533,"_3076":51626},[],"If your values file still carries the legacy gateway JWT validation settings — `auth.oidc.apiGateway.jwks`, `auth.authorization.rolesClaim` or `auth.authorization.roles.admin` — remove them. The migration guide `charts/lamassu/CHANGELOG/3.8.0->4.0.0.md` documents their removal with no compatibility aliases, and `values.schema.json` rejects the leftover blocks instead of silently ignoring them. The replacements are `services.authz.jwkUrl` and `services.authz.bootstrap`, already shown in the example above.",{"_3624":248,"_31165":214,"_21590":51628,"_5":14857,"_28357":51537,"_3076":51629},[],"The chart reads the PostgreSQL, AMQP and SMTP credentials from Kubernetes Secrets in the release namespace. Reference them with `existingSecret` plus the `usernameKey` and `passwordKey` data keys; inline `username` and `password` values are removed and rejected by `values.schema.json`.",{"_3624":249,"_31165":214,"_21590":51631,"_5":14857,"_28357":51537,"_3076":51632},[],"The Secrets must exist before you install or upgrade: the pre-install and pre-upgrade migration job connects to PostgreSQL with the PostgreSQL Secret, and the service containers read the AMQP and SMTP credentials when they start.",{"_3624":250,"_31165":214,"_21590":51634,"_5":14857,"_28357":51537,"_3076":51635},[],"`postgres.existingSecret` (default `lamassu-postgres`) and `amqp.existingSecret` (default `lamassu-amqp`) are always required.",{"_3624":251,"_31165":214,"_21590":51637,"_5":14857,"_28357":51537,"_3076":51638},[],"`services.alerts.smtp_server.existingSecret` is empty by default, which means SMTP without authentication. Set it, together with its key names, only when your SMTP server requires authentication.",{"_3624":252,"_31165":214,"_21590":51640,"_5":14857,"_28357":51537,"_3076":51641},[],"Each `services.authz.credentials` entry names its `database` and uses the global PostgreSQL Secret — `postgres.existingSecret` with its configured key names — unless the entry sets its own `existingSecret`.",{"_3624":253,"_31165":214,"_21590":51643,"_5":14857,"_28357":51537,"_3076":51644},[],"Changing a Secret's contents does not roll the pods that consume it: the services read the credentials when they start. Restart the affected pods after rotating a credential.",{"_3624":254,"_31165":214,"_21590":51646,"_5":14857,"_28357":51537,"_3076":51647},[],"For production, manage the Secrets with the External Secrets Operator (ESO), which the chart does not install. The `charts/lamassu/README.md` in the Helm repository documents a complete working example in its *Secret management* section: installing external-secrets 0.20.2, a test `ClusterSecretStore`, the `ExternalSecret` resources and the wait before installing the chart. Its Fake provider is for testing only — replace it with your provider's configuration for anything beyond a throwaway environment; AWS Secrets Manager, Vault, Azure Key Vault, GCP Secret Manager and other providers are documented at external-secrets.io.",{"_3624":255,"_31165":214,"_21590":51649,"_5":14857,"_28357":51537,"_3076":51650},[],"Only these credentials moved into Secrets: other values, such as connector and crypto-engine settings, are still configured through the values file.",{"_3624":256,"_31165":214,"_21590":51652,"_5":14857,"_28357":51541,"_3076":51653},[],"Create a Secret containing `tls.crt` and `tls.key`, then reference it. The Secret must already exist before installing: in `external` mode the chart renders no cert-manager resources and never creates this Secret.",{"_3624":257,"_31165":214,"_21590":51655,"_5":14857,"_28357":51545,"_3076":51656},[],"`amqp.tls: true` selects AMQPS in every event-bus configuration block. The default port stays `5672` and does not change automatically when TLS is enabled, so set `amqp.port` to the broker's TLS listener, commonly `5671`.",{"_3624":258,"_31165":214,"_21590":51658,"_5":14857,"_28357":51545,"_3076":51659},[],"With no CA Secret configured, the event-bus clients use the system-trusted CAs. To trust a private CA, create a Secret in the release namespace containing the CA certificate in PEM format and set `amqp.ca.secretName` (and `amqp.ca.certificateKey` if the data key is not `ca.crt`).",{"_3624":259,"_31165":214,"_21590":51661,"_5":14857,"_28357":51545,"_3076":51662},[],"For brokers that require mutual TLS, create a Secret containing the client certificate and private key and set `amqp.client.secretName` (with `amqp.client.certificateKey` and `amqp.client.privateKeyKey` if the data keys are not `tls.crt` and `tls.key`).",{"_3624":260,"_31165":214,"_21590":51664,"_5":14857,"_28357":51545,"_3076":51665},[],"The chart mounts configured Secrets read-only into every AMQP-consuming workload: the CA certificate under `/etc/lamassu/amqp/ca` and the client certificate and key under `/etc/lamassu/amqp/client`. The mounted file names are always `ca.crt`, `tls.crt` and `tls.key` — the `certificateKey` and `privateKeyKey` values rename only the Secret data keys, never the on-disk paths. The client private key is mounted with restrictive permissions (`defaultMode: 0440`; the CA volume uses `0444`), which works because the chart adds `fsGroup` to the pod security context when `amqp.client.secretName` is set — the chart's default pod security context already sets `fsGroup: 65532` for every service pod, so this top-up applies only when an explicit `podSecurityContext` without `fsGroup` was overridden and an AMQP client Secret is configured — and it uses the container `runAsGroup` (default `65532`) when `fsGroup` is not already set.",{"_3624":261,"_31165":214,"_21590":51667,"_5":14857,"_28357":51545,"_3076":51668},[],"Both Secret options require `amqp.tls: true`: `values.schema.json` rejects a non-empty `secretName` when `tls` is false, rejects unknown keys and rejects data-key names outside `^[A-Za-z0-9._-]+$`. The referenced Secret must exist in the release namespace or the consuming pods fail to start.",{"_3624":262,"_31165":214,"_21590":51670,"_5":14857,"_28357":51545,"_3076":51671},[],"The AMQP client loads certificates at startup, so restart the consuming pods after updating either Secret. Changing any `amqp` value rolls the consuming pods through the `checksum/config` annotation, but a change to Secret content alone does not trigger a rollout.",{"_3624":263,"_31165":214,"_21590":51673,"_5":14857,"_28357":51545,"_3076":51674},[],"Per the migration guide `charts/lamassu/CHANGELOG/3.8.0->4.0.0.md`: in 3.8.0 `amqp.tls` was not applied and event-bus clients used plaintext AMQP; from 4.0.0, `amqp.tls: true` switches them to AMQPS. Set `amqp.port` to the broker TLS listener before upgrading, or set `amqp.tls: false` to keep plaintext AMQP. `amqp.tls: false` sends the broker credentials and all event-bus traffic in cleartext.",{"_3624":264,"_31165":214,"_21590":51676,"_5":14857,"_28357":51549,"_3076":51677},[],"There is no implicit superuser. Create the role or group expected by `services.authz.bootstrap` in the OIDC provider and assign it to at least one administrator before exposing Lamassu.",{"_3624":265,"_31165":214,"_21590":51679,"_5":14857,"_28357":51549,"_3076":51680},[],"The pre-install and pre-upgrade job applies the bootstrap idempotently: existing principals are preserved and missing grants are added.",{"_3624":266,"_31165":214,"_21590":51682,"_5":14857,"_28357":51549,"_3076":51683},[],"Test both an authorized identity and a denied identity. If no token matches an active bootstrap principal, nobody can administer the PKI.",{"_3624":267,"_31165":214,"_21590":51685,"_5":14857,"_28357":51549,"_3076":51686},[],"See Access control for the principal and policy model.",{"_3624":268,"_31165":214,"_21590":51688,"_5":14857,"_28357":51553,"_3076":51689},[],"To install a local checkout instead:",{"_3624":269,"_31165":214,"_21590":51691,"_5":14857,"_28357":51557,"_3076":51692},[],"The Gateway should report `PROGRAMMED=True`. If it is programmed but has no usable address, continue with Expose the Gateway.",{"_3624":270,"_31165":214,"_21590":51694,"_5":14857,"_28357":51557,"_3076":51695},[],"The Helm test checks the CA, DMS Manager, Device Manager and VA health endpoints and verifies the UI response.",{"_3624":271,"_31165":214,"_21590":51697,"_5":14857,"_28357":51561,"_3076":51698},[],"Version-specific upgrade steps live in `charts/lamassu/CHANGELOG/` in the Helm repository. The chart also ships an optional pre-upgrade Job that migrates existing CA private keys into the KMS engine configured for the release. It is off by default (`migrations.caToKms.enabled: false`) and is only needed when upgrading from a version prior to 3.7.0.",{"_3624":272,"_31165":214,"_21590":51700,"_5":14857,"_28357":51561,"_3076":51701},[],"While the flag is enabled, every `helm upgrade` creates the `<chart fullname>-ca-to-kms-migration` Job (`lamassu-ca-to-kms-migration` for release `lamassu`); a fresh install does not create it. Its hook weight is `-10`, so it runs before the other pre-upgrade hooks: the authorization bootstrap configuration (weight `-4`) and the database-migration Job (weight `-3`).",{"_3624":273,"_31165":214,"_21590":51703,"_5":14857,"_28357":51561,"_3076":51704},[],"The Job consumes the same KMS service configuration the chart renders into the KMS ConfigMap, including the engines from `services.kms.cryptoEngines`, and runs the migration tool defined in `migrations.caToKms.image`. It mounts that configuration read-only at `/etc/lamassuiot/config.yml` from the ConfigMap key `config`, so configure the destination engine in your values before the upgrade that performs the migration.",{"_3624":274,"_31165":214,"_21590":51706,"_5":14857,"_28357":51561,"_3076":51707},[],"The Job resolves its configuration through a projected volume with two optional sources: the release-scoped `<chart fullname>-kms-config` (`lamassu-kms-config` for release `lamassu`, `prod-lamassu-kms-config` for release `prod`) and the legacy unscoped `kms-config` created by chart versions before release-scoped naming. The legacy configuration remains authoritative while it is still present, and the release-scoped one is used once the legacy one is gone. Both sources are optional, so a missing ConfigMap never leaves the upgrade pod in `ContainerCreating`.",{"_3624":275,"_31165":214,"_21590":51709,"_5":14857,"_28357":51561,"_3076":51710},[],"Keep `migrations.caToKms.enabled: true` for the upgrade that performs the migration, then remove the flag from your values once the migration completes; it defaults to `false`.",{"_3624":276,"_31165":214,"_21590":51712,"_5":14857,"_28357":51565,"_3076":51713},[],"Before going live, review:",{"_3624":277,"_31165":214,"_21590":51715,"_5":14857,"_28357":51565,"_3076":51716},[],"backup and recovery for PostgreSQL and persistent volumes",{"_3624":278,"_31165":214,"_21590":51718,"_5":14857,"_28357":51565,"_3076":51719},[],"a production KMS engine; the default filesystem engine is not an HA design",{"_3624":279,"_31165":214,"_21590":51721,"_5":14857,"_28357":51565,"_3076":51722},[],"shared VA storage before increasing VA replicas",{"_3624":280,"_31165":214,"_21590":51724,"_5":14857,"_28357":51565,"_3076":51725},[],"managed OIDC roles and removal of evaluation credentials",{"_3624":281,"_31165":214,"_21590":51727,"_5":14857,"_28357":51565,"_3076":51728},[],"a trusted TLS issuer or externally managed certificate",{"_3624":282,"_31165":214,"_21590":51730,"_5":14857,"_28357":51565,"_3076":51731},[],"resource requests, replicas, autoscaling, disruption budgets and placement",{"_3624":283,"_31165":214,"_21590":51733,"_5":14857,"_28357":51565,"_3076":51734},[],"SMTP, observability and alert delivery",{"_3624":284,"_31165":214,"_21590":51736,"_5":14857,"_28357":51565,"_3076":51737},[],"the version upgrade guides and migration notes in `charts/lamassu/CHANGELOG/` before every upgrade, including the optional CA-to-KMS migration hook described above",{"_3624":285,"_31165":214,"_21590":51739,"_5":14857,"_28357":51565,"_3076":51740},[],"The complete values reference is maintained in `charts/lamassu/VALUES.md` in the Helm repository.",{"_3624":286,"_31165":286,"_5":15217,"_3076":51742,"_31503":51743,"_21590":51744,"_28357":286},"Expose the Gateway",[50900,50901,51007],[],{"_3624":287,"_31165":286,"_21590":51746,"_5":14857,"_28357":286,"_3076":51747},[],"Choose how clients reach Lamassu, when to set gateway.addresses and how to design multiple Gateways.",{"_3624":288,"_31165":286,"_5":31500,"_21590":51749,"_28357":51750,"_3076":51751},[],"/docs/deployment/self-hosted/networking#expose-the-lamassu-gateway","Expose the Lamassu Gateway",{"_3624":289,"_31165":286,"_5":31500,"_21590":51753,"_28357":51754,"_3076":51755},[],"/docs/deployment/self-hosted/networking#do-you-need-gatewayaddresses","Do you need `gateway.addresses`?",{"_3624":290,"_31165":286,"_5":31500,"_21590":51757,"_28357":51758,"_3076":51759},[],"/docs/deployment/self-hosted/networking#recommended-single-node-design","Recommended single-node design",{"_3624":291,"_31165":286,"_5":31500,"_21590":51761,"_28357":51762,"_3076":51763},[],"/docs/deployment/self-hosted/networking#k3s","K3s",{"_3624":292,"_31165":286,"_5":31500,"_21590":51765,"_28357":51766,"_3076":51767},[],"/docs/deployment/self-hosted/networking#bare-metal-with-metallb-or-kube-vip","Bare metal with MetalLB or kube-vip",{"_3624":293,"_31165":286,"_5":31500,"_21590":51769,"_28357":51770,"_3076":51771},[],"/docs/deployment/self-hosted/networking#external-reverse-proxy-nat-or-vpn","External reverse proxy, NAT or VPN",{"_3624":294,"_31165":286,"_5":31500,"_21590":51773,"_28357":51774,"_3076":51775},[],"/docs/deployment/self-hosted/networking#what-if-you-need-three-gateways","What if you need three Gateways?",{"_3624":295,"_31165":286,"_5":31500,"_21590":51777,"_28357":51778,"_3076":51779},[],"/docs/deployment/self-hosted/networking#client-certificates-and-identity-headers","Client certificates and identity headers",{"_3624":296,"_31165":286,"_5":31500,"_21590":51781,"_28357":51782,"_3076":51783},[],"/docs/deployment/self-hosted/networking#decision-guide","Decision guide",{"_3624":297,"_31165":286,"_5":31500,"_21590":51785,"_28357":51786,"_3076":51787},[],"/docs/deployment/self-hosted/networking#egress-proxy","Egress proxy",{"_3624":298,"_31165":286,"_5":31500,"_21590":51789,"_28357":51790,"_3076":51791},[],"/docs/deployment/self-hosted/networking#verify-the-traffic-path","Verify the traffic path",{"_3624":299,"_31165":286,"_21590":51793,"_5":14857,"_28357":51750,"_3076":51794},[],"The Lamassu chart creates one shared Gateway with HTTP and HTTPS listeners. Envoy Gateway normally creates a dedicated proxy deployment and a `LoadBalancer` Service for it.",{"_3624":300,"_31165":286,"_21590":51796,"_5":14857,"_28357":51750,"_3076":51797},[],"External reachability is the result of the whole path. A `Gateway` resource alone does not configure your router, firewall, DNS, cloud load balancer or upstream NAT.",{"_3624":301,"_31165":286,"_21590":51799,"_5":14857,"_28357":51754,"_3076":51800},[],"Usually, no. If you omit it, the Gateway controller and the cluster load-balancer implementation can assign an address and report it in `Gateway.status.addresses` and the generated Service status.",{"_3624":302,"_31165":286,"_21590":51802,"_5":14857,"_28357":51754,"_3076":51803},[],"Set it only when:",{"_3624":303,"_31165":286,"_21590":51805,"_5":14857,"_28357":51754,"_3076":51806},[],"your cloud or bare-metal load balancer supports requesting a specific address",{"_3624":304,"_31165":286,"_21590":51808,"_5":14857,"_28357":51754,"_3076":51809},[],"that address is allocated to this Gateway",{"_3624":305,"_31165":286,"_21590":51811,"_5":14857,"_28357":51754,"_3076":51812},[],"the surrounding network already routes traffic for it to the cluster",{"_3624":306,"_31165":286,"_21590":51814,"_5":14857,"_28357":51754,"_3076":51815},[],"This requests `192.168.1.50`; it does not claim the IP on your LAN or make it reachable.",{"_3624":307,"_31165":286,"_21590":51817,"_5":14857,"_28357":51754,"_3076":51818},[],"Keep these two settings separate:",{"_3624":308,"_31165":286,"_21590":51820,"_5":14857,"_28357":51754,"_3076":51821},[],"`gateway.addresses` requests an address for the Gateway.",{"_3624":309,"_31165":286,"_21590":51823,"_5":14857,"_28357":51754,"_3076":51824},[],"`tls.certManagerOptions.certSpec.addresses` adds IP subject alternative names to the TLS certificate.",{"_3624":310,"_31165":286,"_21590":51826,"_5":14857,"_28357":51754,"_3076":51827},[],"If users connect by DNS name, put that name in `tls.certManagerOptions.certSpec.hostnames`. Do not copy an upstream proxy's public IP into `gateway.addresses`.",{"_3624":311,"_31165":286,"_21590":51829,"_5":14857,"_28357":51758,"_3076":51830},[],"For a small VM running K3s or MicroK8s, use one external Lamassu Gateway and route every Lamassu endpoint through it:",{"_3624":312,"_31165":286,"_21590":51832,"_5":14857,"_28357":51758,"_3076":51833},[],"This design uses one IP, one TLS entry point and one pair of ports. The chart already creates the required routes.",{"_3624":313,"_31165":286,"_21590":51835,"_5":14857,"_28357":51762,"_3076":51836},[],"K3s ServiceLB implements each `LoadBalancer` Service with pods that reserve the Service ports on the node. On a single node, only one Service can therefore own port 80 and one can own port 443. The default K3s Traefik Service may already hold both ports.",{"_3624":314,"_31165":286,"_21590":51838,"_5":14857,"_28357":51762,"_3076":51839},[],"For the recommended design:",{"_3624":315,"_31165":286,"_21590":51841,"_5":14857,"_28357":51762,"_3076":51842},[],"Use only one externally exposed Lamassu Gateway.",{"_3624":316,"_31165":286,"_21590":51844,"_5":14857,"_28357":51762,"_3076":51845},[],"Ensure ports 80 and 443 are free. Disable or reconfigure Traefik if it is not part of your traffic path.",{"_3624":317,"_31165":286,"_21590":51847,"_5":14857,"_28357":51762,"_3076":51848},[],"Allow those ports through the VM firewall and any upstream security group.",{"_3624":318,"_31165":286,"_21590":51850,"_5":14857,"_28357":51762,"_3076":51851},[],"Point DNS at the VM's reachable address.",{"_3624":319,"_31165":286,"_21590":51853,"_5":14857,"_28357":51762,"_3076":51854},[],"See the K3s ServiceLB documentation for its host-port behavior and how to replace it with another load-balancer implementation.",{"_3624":320,"_31165":286,"_21590":51856,"_5":14857,"_28357":51766,"_3076":51857},[],"Allocate a VIP from an address pool reachable on your LAN. You may request that VIP with `gateway.addresses` if the selected implementation supports it. Confirm the assigned address in status rather than assuming the request succeeded.",{"_3624":321,"_31165":286,"_21590":51859,"_5":14857,"_28357":51770,"_3076":51860},[],"An external public address can forward TCP 80 and 443 to the VM or to a Kubernetes-side VIP:",{"_3624":322,"_31165":286,"_21590":51862,"_5":14857,"_28357":51770,"_3076":51863},[],"The public IP belongs to the external device. Leave `gateway.addresses` unset or set it to the actual Kubernetes-side address, never to an address that the cluster cannot bind.",{"_3624":323,"_31165":286,"_21590":51865,"_5":14857,"_28357":51774,"_3076":51866},[],"First decide whether you need three independent data planes or only three hostnames.",{"_3624":324,"_31165":286,"_21590":51868,"_5":14857,"_28357":51774,"_3076":51869},[],"Requirement",{"_3624":325,"_31165":286,"_21590":51871,"_5":14857,"_28357":51774,"_3076":51872},[],"Recommended design",{"_3624":326,"_31165":286,"_21590":51874,"_5":14857,"_28357":51774,"_3076":51875},[],"Consequence",{"_3624":327,"_31165":286,"_21590":51877,"_5":14857,"_28357":51774,"_3076":51878},[],"Several Lamassu URLs or services",{"_3624":328,"_31165":286,"_21590":51880,"_5":14857,"_28357":51774,"_3076":51881},[],"One Gateway with multiple routes",{"_3624":329,"_31165":286,"_21590":51883,"_5":14857,"_28357":51774,"_3076":51884},[],"One IP and one proxy fleet; this is the chart default",{"_3624":330,"_31165":286,"_21590":51886,"_5":14857,"_28357":51774,"_3076":51887},[],"Independent Gateways and separate external IPs",{"_3624":331,"_31165":286,"_21590":51889,"_5":14857,"_28357":51774,"_3076":51890},[],"One VIP per Gateway",{"_3624":332,"_31165":286,"_21590":51892,"_5":14857,"_28357":51774,"_3076":51893},[],"All Gateways can use 80/443; requires a load balancer with an address pool",{"_3624":333,"_31165":286,"_21590":51895,"_5":14857,"_28357":51774,"_3076":51896},[],"Independent Gateways on one node and one IP",{"_3624":334,"_31165":286,"_21590":51898,"_5":14857,"_28357":51774,"_3076":51899},[],"Use different external ports",{"_3624":335,"_31165":286,"_21590":51901,"_5":14857,"_28357":51774,"_3076":51902},[],"Clients must include non-standard ports",{"_3624":336,"_31165":286,"_21590":51904,"_5":14857,"_28357":51774,"_3076":51905},[],"Separate TLS/mTLS termination behind one IP",{"_3624":337,"_31165":286,"_21590":51907,"_5":14857,"_28357":51774,"_3076":51908},[],"Front-door SNI routing to internal Gateways",{"_3624":338,"_31165":286,"_21590":51910,"_5":14857,"_28357":51774,"_3076":51911},[],"Advanced design; the front door uses TLS passthrough and each internal Gateway terminates its own TLS",{"_3624":339,"_31165":286,"_21590":51913,"_5":14857,"_28357":51774,"_3076":51914},[],"Separate Gateway resources but shared proxy infrastructure",{"_3624":340,"_31165":286,"_21590":51916,"_5":14857,"_28357":51774,"_3076":51917},[],"Envoy merged-Gateway mode",{"_3624":341,"_31165":286,"_21590":51919,"_5":14857,"_28357":51774,"_3076":51920},[],"Logical separation only; listeners must have unique port, protocol and hostname tuples",{"_3624":342,"_31165":286,"_21590":51922,"_5":14857,"_28357":51774,"_3076":51923},[],"Three independent `LoadBalancer` Services cannot all reserve the same node ports 80 and 443 through K3s ServiceLB. Use one shared Gateway, allocate distinct VIPs with another load-balancer implementation, or use different ports.",{"_3624":343,"_31165":286,"_21590":51925,"_5":14857,"_28357":51774,"_3076":51926},[],"Envoy Gateway normally provisions a proxy fleet per `Gateway`. Its merged-Gateway mode can share one fleet and address, but it is not a drop-in switch for multiple Lamassu releases: the generated Lamassu listeners use the same ports and protocols without distinct hostnames, so they conflict unless you deliberately customize the listener design.",{"_3624":344,"_31165":286,"_21590":51928,"_5":14857,"_28357":51774,"_3076":51929},[],"Use a front-door SNI design only when the internal Gateways must retain independent TLS or mTLS policy:",{"_3624":345,"_31165":286,"_21590":51931,"_5":14857,"_28357":51774,"_3076":51932},[],"This requires distinct SNI hostnames and cluster networking outside the Lamassu chart.",{"_3624":346,"_31165":286,"_21590":51934,"_5":14857,"_28357":51778,"_3076":51935},[],"The chart renders a `ClientTrafficPolicy` named `enable-mtls` on its shared Gateway automatically; no Helm value enables or disables it. TLS termination accepts requests with or without a client certificate: devices may present one, but they are not required to. Before forwarding a request, the Gateway removes identity and certificate headers that a client could otherwise supply itself: `X-Principal-Id`, `X-Lms-Source`, `X-Forwarded-Client-Cert`, `X-Forwarded-Cert`, `X-Forwarded-Tls-Client-Cert` (the Traefik spelling), `Ssl-Client-Cert` and `X-Amzn-Mtls-Clientcert`. The Traefik spelling is included because backends that accept `X-Forwarded-Tls-Client-Cert` directly would otherwise receive certificate identity data supplied by the client itself, without a client certificate having been presented. After stripping, Envoy adds its own `X-Forwarded-Client-Cert` carrying the presented certificate and its chain, so services that read certificate identity receive only gateway-generated values. No Helm value changes the list of stripped headers. The Access control page describes how `authz` uses this protection to keep `X-Principal-ID` out of reach of clients.",{"_3624":347,"_31165":286,"_21590":51937,"_5":14857,"_28357":51782,"_3076":51938},[],"If one Gateway can own TLS and routing, use the chart default.",{"_3624":348,"_31165":286,"_21590":51940,"_5":14857,"_28357":51782,"_3076":51941},[],"If Gateways need independent policy and you can allocate IPs, use one VIP per Gateway.",{"_3624":349,"_31165":286,"_21590":51943,"_5":14857,"_28357":51782,"_3076":51944},[],"If only the Kubernetes resources need separation, evaluate merged-Gateway mode and make every listener tuple unique.",{"_3624":350,"_31165":286,"_21590":51946,"_5":14857,"_28357":51782,"_3076":51947},[],"If data planes and TLS termination must stay independent behind one IP, add a front-door SNI passthrough layer.",{"_3624":351,"_31165":286,"_21590":51949,"_5":14857,"_28357":51782,"_3076":51950},[],"If none of those are possible, use different external ports or change the external network design.",{"_3624":352,"_31165":286,"_21590":51952,"_5":14857,"_28357":51786,"_3076":51953},[],"Internal Lamassu clients — the Vault engine connection, service-to-service calls and webhook deliveries — honor the `HTTP_PROXY`, `HTTPS_PROXY` and `NO_PROXY` environment variables. The exception is the authorization-engine connector: it uses its own transport and does not consult these proxy variables. If your deployment routes egress through a proxy, list in-cluster service names in `NO_PROXY` (for example `.svc,.cluster.local`) so internal traffic stays inside the cluster. Loopback traffic is never sent through a proxy.",{"_3624":353,"_31165":286,"_21590":51955,"_5":14857,"_28357":51786,"_3076":51956},[],"The default transport of these clients bounds the dial timeout (30 seconds), the TLS handshake (10 seconds) and idle connection reuse (90 seconds) so an unreachable dependency fails fast instead of hanging; these values are Go transport defaults, not Lamassu settings. HTTP/2 is negotiated when the peer supports it. The authorization-engine connector keeps its own transport without these dial and handshake timeouts; only its overall 30-second request timeout bounds each call.",{"_3624":354,"_31165":286,"_21590":51958,"_5":14857,"_28357":51790,"_3076":51959},[],"Check, in order:",{"_3624":355,"_31165":286,"_21590":51961,"_5":14857,"_28357":51790,"_3076":51962},[],"`Gateway` has `Accepted=True` and `Programmed=True`.",{"_3624":356,"_31165":286,"_21590":51964,"_5":14857,"_28357":51790,"_3076":51965},[],"Its status contains the expected address.",{"_3624":357,"_31165":286,"_21590":51967,"_5":14857,"_28357":51790,"_3076":51968},[],"The generated `LoadBalancer` Service has a usable external address.",{"_3624":358,"_31165":286,"_21590":51970,"_5":14857,"_28357":51790,"_3076":51971},[],"Port 443 reaches that address from the client network.",{"_3624":359,"_31165":286,"_21590":51973,"_5":14857,"_28357":51790,"_3076":51974},[],"DNS resolves to the externally reachable endpoint.",{"_3624":360,"_31165":286,"_21590":51976,"_5":14857,"_28357":51790,"_3076":51977},[],"The certificate contains the DNS name or IP used by the client.",{"_3624":361,"_31165":286,"_21590":51979,"_5":14857,"_28357":51790,"_3076":51980},[],"The Gateway API treats addresses as desired state that a controller may assign or reject; see the Gateway API overview for the resource model.",{"_3624":362,"_31165":362,"_5":15217,"_3076":51007,"_31503":51982,"_21590":51983,"_28357":362},[50900,50901,51007],[],{"_3624":363,"_31165":362,"_21590":51985,"_5":14857,"_28357":362,"_3076":51986},[],"Choose an installation workflow and network architecture for Lamassu on your Kubernetes cluster.",{"_3624":364,"_31165":362,"_5":31500,"_21590":51988,"_28357":51989,"_3076":51990},[],"/docs/deployment/self-hosted/overview#self-managed-kubernetes-deployment","Self-managed Kubernetes deployment",{"_3624":365,"_31165":362,"_5":31500,"_21590":51992,"_28357":51993,"_3076":51994},[],"/docs/deployment/self-hosted/overview#choose-an-installation-workflow","Choose an installation workflow",{"_3624":366,"_31165":362,"_5":31500,"_21590":51996,"_28357":51997,"_3076":51998},[],"/docs/deployment/self-hosted/overview#what-the-lamassu-chart-provides","What the Lamassu chart provides",{"_3624":367,"_31165":362,"_5":31500,"_21590":52000,"_28357":52001,"_3076":52002},[],"/docs/deployment/self-hosted/overview#how-the-deployment-fits-together","How the deployment fits together",{"_3624":368,"_31165":362,"_5":31500,"_21590":52004,"_28357":52005,"_3076":52006},[],"/docs/deployment/self-hosted/overview#platform-requirements","Platform requirements",{"_3624":369,"_31165":362,"_5":31500,"_21590":52008,"_28357":52009,"_3076":52010},[],"/docs/deployment/self-hosted/overview#choose-the-next-page","Choose the next page",{"_3624":370,"_31165":362,"_21590":52012,"_5":14857,"_28357":51989,"_3076":52013},[],"Run Lamassu in a Kubernetes cluster operated by your team. The Helm chart deploys the Lamassu services and their routing resources; you provide the cluster, persistent storage, identity provider, PostgreSQL, RabbitMQ and the network path used by clients.",{"_3624":371,"_31165":362,"_21590":52015,"_5":14857,"_28357":51993,"_3076":52016},[],"Workflow",{"_3624":372,"_31165":362,"_21590":52018,"_5":14857,"_28357":51993,"_3076":52019},[],"Use it for",{"_3624":373,"_31165":362,"_21590":52021,"_5":14857,"_28357":51993,"_3076":52022},[],"What it installs",{"_3624":374,"_31165":362,"_21590":52024,"_5":14857,"_28357":51993,"_3076":52025},[],"Helm",{"_3624":375,"_31165":362,"_21590":52027,"_5":14857,"_28357":51993,"_3076":52028},[],"Production and controlled environments",{"_3624":376,"_31165":362,"_21590":52030,"_5":14857,"_28357":51993,"_3076":52031},[],"Lamassu services and Gateway API resources",{"_3624":377,"_31165":362,"_21590":52033,"_5":14857,"_28357":51993,"_3076":51144},[],{"_3624":378,"_31165":362,"_21590":52035,"_5":14857,"_28357":51993,"_3076":52036},[],"Evaluation, demos, CI and small lab clusters",{"_3624":379,"_31165":362,"_21590":52038,"_5":14857,"_28357":51993,"_3076":52039},[],"PostgreSQL, Keycloak, RabbitMQ, Envoy Gateway and Lamassu",{"_3624":380,"_31165":362,"_21590":52041,"_5":14857,"_28357":51997,"_3076":52042},[],"The Lamassu chart is an **application chart**, not a cluster bootstrap chart. It creates the Kubernetes resources that run and configure Lamassu, but it expects the platform services those resources depend on to exist.",{"_3624":381,"_31165":362,"_21590":52044,"_5":14857,"_28357":51997,"_3076":52045},[],"Area",{"_3624":382,"_31165":362,"_21590":52047,"_5":14857,"_28357":51997,"_3076":52048},[],"The Lamassu chart provides",{"_3624":383,"_31165":362,"_21590":52050,"_5":14857,"_28357":51997,"_3076":52051},[],"You provide",{"_3624":384,"_31165":362,"_21590":52053,"_5":14857,"_28357":51997,"_3076":52054},[],"Lamassu applications",{"_3624":385,"_31165":362,"_21590":52056,"_5":14857,"_28357":51997,"_3076":52057},[],"Deployments and StatefulSets for the UI and APIs, internal Services, ConfigMaps, a ServiceAccount, and optional HPAs and PDBs",{"_3624":386,"_31165":362,"_21590":52059,"_5":14857,"_28357":51997,"_3076":52060},[],"A working Kubernetes cluster, compute capacity and access to the container images",{"_3624":387,"_31165":362,"_21590":52062,"_5":14857,"_28357":51997,"_3076":52063},[],"PostgreSQL data",{"_3624":388,"_31165":362,"_21590":52065,"_5":14857,"_28357":51997,"_3076":52066},[],"A pre-install/pre-upgrade job that creates the required databases and schemas, runs migrations and applies the authorization bootstrap",{"_3624":389,"_31165":362,"_21590":52068,"_5":14857,"_28357":51997,"_3076":52069},[],"A reachable PostgreSQL server, credentials allowed to create databases and schemas, and backup/HA operations",{"_3624":390,"_31165":362,"_21590":52071,"_5":14857,"_28357":51997,"_3076":52072},[],"Messaging",{"_3624":391,"_31165":362,"_21590":52074,"_5":14857,"_28357":51997,"_3076":52075},[],"RabbitMQ connection configuration for the Lamassu services; the connection can use AMQPS, with an optional private CA and an optional client certificate, both set through chart values",{"_3624":392,"_31165":362,"_21590":52077,"_5":14857,"_28357":51997,"_3076":52078},[],"A reachable RabbitMQ broker, credentials and its lifecycle",{"_3624":393,"_31165":362,"_21590":52080,"_5":14857,"_28357":51997,"_3076":52081},[],"Identity",{"_3624":394,"_31165":362,"_21590":52083,"_5":14857,"_28357":51997,"_3076":52084},[],"OIDC/JWT and external-authorization configuration, plus initial Lamassu authorization principals",{"_3624":395,"_31165":362,"_21590":52086,"_5":14857,"_28357":51997,"_3076":52087},[],"An OIDC provider, realm/tenant, client, users, groups and roles",{"_3624":396,"_31165":362,"_21590":52089,"_5":14857,"_28357":51997,"_3076":52090},[],"External routing",{"_3624":397,"_31165":362,"_21590":52092,"_5":14857,"_28357":51997,"_3076":52093},[],"One `Gateway`, `HTTPRoute` resources, an `EnvoyProxy` configuration and Envoy security policies",{"_3624":398,"_31165":362,"_21590":52095,"_5":14857,"_28357":51997,"_3076":52096},[],"Gateway API and Envoy CRDs, the Envoy Gateway controller, a `GatewayClass`, a load-balancer implementation and the external network path",{"_3624":399,"_31165":362,"_21590":52098,"_5":14857,"_28357":51997,"_3076":52099},[],"TLS",{"_3624":400,"_31165":362,"_21590":52101,"_5":14857,"_28357":51997,"_3076":52102},[],"In the default `tls.type: certManager` mode, cert-manager `Issuer` and CA `Certificate` resources and a chart-managed downstream `Certificate`; in the `tls.type: external` mode, a reference to your TLS Secret",{"_3624":401,"_31165":362,"_21590":52104,"_5":14857,"_28357":51997,"_3076":52105},[],"cert-manager only for the default `tls.type: certManager` mode; for trusted TLS, a trusted issuer or a populated TLS Secret",{"_3624":402,"_31165":362,"_21590":52107,"_5":14857,"_28357":51997,"_3076":52108},[],"Persistent application data",{"_3624":403,"_31165":362,"_21590":52110,"_5":14857,"_28357":51997,"_3076":52111},[],"PersistentVolumeClaims required by the default local KMS and VA storage",{"_3624":404,"_31165":362,"_21590":52113,"_5":14857,"_28357":51997,"_3076":52114},[],"A StorageClass, physical storage, backups and a shared/external backend when scaling requires one",{"_3624":405,"_31165":362,"_21590":52116,"_5":14857,"_28357":51997,"_3076":52117},[],"Optional integrations",{"_3624":406,"_31165":362,"_21590":52119,"_5":14857,"_28357":51997,"_3076":52120},[],"Configuration hooks for observability, AWS connectors and PKCS#11/HSM connectivity",{"_3624":407,"_31165":362,"_21590":52122,"_5":14857,"_28357":51997,"_3076":52123},[],"The observability backends, cloud credentials and production HSM or external key service",{"_3624":408,"_31165":362,"_21590":52125,"_5":14857,"_28357":51997,"_3076":52126},[],"The chart creates Lamassu's `Gateway` and routes. It does not install the Envoy Gateway controller or make the generated `LoadBalancer` Service reachable from your network.",{"_3624":409,"_31165":362,"_21590":52128,"_5":14857,"_28357":51997,"_3076":52129},[],"Use one Lamassu Gateway on ports 80 and 443 and let its HTTPRoutes dispatch traffic to every Lamassu service. Give that Gateway one externally reachable endpoint through the cluster load balancer, or forward traffic to it from an external proxy or NAT device. You do not need one Gateway per service.",{"_3624":410,"_31165":362,"_21590":52131,"_5":14857,"_28357":52001,"_3076":52132},[],"The chart creates one shared `Gateway` per Helm release. All chart-managed `HTTPRoute` resources attach to it. Envoy Gateway provisions the proxy data plane and a Kubernetes `LoadBalancer` Service for that Gateway.",{"_3624":411,"_31165":362,"_21590":52134,"_5":14857,"_28357":52001,"_3076":52135},[],"The `gateway.addresses` value is only an address request to the Gateway controller. It does not make an IP routable, open a firewall, configure DNS or create NAT. See Expose the Gateway before setting it.",{"_3624":412,"_31165":362,"_21590":52137,"_5":14857,"_28357":52005,"_3076":52138},[],"Kubernetes 1.24 or newer",{"_3624":413,"_31165":362,"_21590":52140,"_5":14857,"_28357":52005,"_3076":52141},[],"Helm 3.2 or newer",{"_3624":414,"_31165":362,"_21590":52143,"_5":14857,"_28357":52005,"_3076":52144},[],"Envoy Gateway 1.8 or newer and a `GatewayClass`",{"_3624":415,"_31165":362,"_21590":52146,"_5":14857,"_28357":52005,"_3076":52147},[],"cert-manager 1.14 or newer; required only for the default `tls.type: certManager` TLS mode, not for `tls.type: external`",{"_3624":416,"_31165":362,"_21590":52149,"_5":14857,"_28357":52005,"_3076":52150},[],"persistent storage suitable for the selected PostgreSQL, RabbitMQ, VA and KMS configuration",{"_3624":417,"_31165":362,"_21590":52152,"_5":14857,"_28357":52005,"_3076":52153},[],"a load-balancer implementation or another deliberate path from clients to the Gateway",{"_3624":418,"_31165":362,"_21590":52155,"_5":14857,"_28357":52005,"_3076":52156},[],"KMS deployments using the native PKCS#11 sidecar require Kubernetes 1.29 or newer. Prebuilt Lamassu container images are published for `linux/amd64` and `linux/arm64`, and the KMS PKCS#11 client module (`p11-kit-client.so`) is installed at the target architecture's Debian library path: `/usr/lib/x86_64-linux-gnu/pkcs11/p11-kit-client.so` on amd64 and `/usr/lib/aarch64-linux-gnu/pkcs11/p11-kit-client.so` on arm64. The x86\\_64 path is retained as a compatibility alias for existing configurations.",{"_3624":419,"_31165":362,"_21590":52158,"_5":14857,"_28357":52009,"_3076":52159},[],"<Card title=\"Install with Helm\" description=\"Prepare dependencies, configure values, install and verify a controlled deployment.\" href=\"/docs/deployment/self-hosted/helm\" />",{"_3624":420,"_31165":362,"_21590":52161,"_5":14857,"_28357":52009,"_3076":52162},[],"<Card title=\"Upgrade from 3.8.0\" description=\"Upgrade an existing Helm release to 4.0.0: architecture changes, breaking changes, migration steps and validation.\" href=\"/docs/upgrades/3-8-0-to-4-0-0\" />",{"_3624":421,"_31165":362,"_21590":52164,"_5":14857,"_28357":52009,"_3076":52165},[],"<Card title=\"Expose the Gateway\" description=\"Choose an external traffic design, understand gateway.addresses and handle multiple Gateways.\" href=\"/docs/deployment/self-hosted/networking\" />",{"_3624":422,"_31165":362,"_21590":52167,"_5":14857,"_28357":52009,"_3076":52168},[],"<Card title=\"Use Fastlane\" description=\"Bootstrap a complete evaluation or lab environment with one script.\" href=\"/docs/deployment/self-hosted/fastlane\" />",{"_3624":423,"_31165":423,"_5":15217,"_3076":52170,"_31503":52171,"_21590":52173,"_28357":423},"Deployment troubleshooting",[50900,50901,52172],"Operations",[],{"_3624":424,"_31165":423,"_21590":52175,"_5":14857,"_28357":423,"_3076":52176},[],"Diagnose access, service health and infrastructure dependencies.",{"_3624":425,"_31165":423,"_5":31500,"_21590":52178,"_28357":52179,"_3076":52180},[],"/docs/deployment/troubleshooting#diagnostic-sequence","Diagnostic sequence",{"_3624":426,"_31165":423,"_5":31500,"_21590":52182,"_28357":52183,"_3076":52184},[],"/docs/deployment/troubleshooting#reproduce-a-single-operation","Reproduce a single operation",{"_3624":427,"_31165":423,"_5":31500,"_21590":52186,"_28357":52187,"_3076":52188},[],"/docs/deployment/troubleshooting#separate-client-gateway-and-service","Separate client, Gateway and service",{"_3624":428,"_31165":423,"_5":31500,"_21590":52190,"_28357":52191,"_3076":52192},[],"/docs/deployment/troubleshooting#review-kubernetes-status","Review Kubernetes status",{"_3624":429,"_31165":423,"_5":31500,"_21590":52194,"_28357":52195,"_3076":52196},[],"/docs/deployment/troubleshooting#query-the-affected-service","Query the affected service",{"_3624":430,"_31165":423,"_5":31500,"_21590":52198,"_28357":52199,"_3076":52200},[],"/docs/deployment/troubleshooting#validate-the-result-from-outside","Validate the result from outside",{"_3624":431,"_31165":423,"_5":31500,"_21590":52202,"_28357":52203,"_3076":52204},[],"/docs/deployment/troubleshooting#minimal-evidence-collection","Minimal evidence collection",{"_3624":432,"_31165":423,"_5":31500,"_21590":52206,"_28357":52207,"_3076":52208},[],"/docs/deployment/troubleshooting#i-cannot-sign-in","I cannot sign in",{"_3624":433,"_31165":423,"_5":31500,"_21590":52210,"_28357":52211,"_3076":52212},[],"/docs/deployment/troubleshooting#everything-returns-403-or-5xx","Everything returns 403 or 5xx",{"_3624":434,"_31165":423,"_5":31500,"_21590":52214,"_28357":52215,"_3076":52216},[],"/docs/deployment/troubleshooting#api-500-errors","API 500 errors",{"_3624":435,"_31165":423,"_5":31500,"_21590":52218,"_28357":52219,"_3076":52220},[],"/docs/deployment/troubleshooting#a-pod-is-not-ready","A pod is not Ready",{"_3624":436,"_31165":423,"_5":31500,"_21590":52222,"_28357":52223,"_3076":52224},[],"/docs/deployment/troubleshooting#events-are-not-arriving","Events are not arriving",{"_3624":437,"_31165":423,"_5":31500,"_21590":52226,"_28357":52227,"_3076":52228},[],"/docs/deployment/troubleshooting#observability","Observability",{"_3624":438,"_31165":423,"_21590":52230,"_5":14857,"_28357":423,"_3076":52231},[],"Start by locating the failing layer. A Gateway response and an unready pod require different evidence. For rejected issuance or validation results, see PKI troubleshooting; for enrollment, see EST diagnostics.",{"_3624":439,"_31165":423,"_21590":52233,"_5":14857,"_28357":52183,"_3076":52234},[],"Note the time in UTC, user or principal, resource, endpoint and result. Avoid repeating a destructive action such as revocation or deletion.",{"_3624":440,"_31165":423,"_21590":52236,"_5":14857,"_28357":52187,"_3076":52237},[],"Check the HTTP status. A 401 points to authentication; a 403, to authorization; a 404, to route or resource; a 5xx, to the service or a dependency.",{"_3624":441,"_31165":423,"_21590":52239,"_5":14857,"_28357":52191,"_3076":52240},[],"Locate unready pods, restarts, recent events and the state of the release.",{"_3624":442,"_31165":423,"_21590":52242,"_5":14857,"_28357":52195,"_3076":52243},[],"Review its /health endpoint and its logs in the same time window. Then follow the indicated dependency: PostgreSQL, RabbitMQ, the OIDC provider or the cryptographic engine.",{"_3624":443,"_31165":423,"_21590":52245,"_5":14857,"_28357":52199,"_3076":52246},[],"For PKI, check the certificate, the chain, OCSP or CRL with the same type of client production uses.",{"_3624":444,"_31165":423,"_21590":52248,"_5":14857,"_28357":52203,"_3076":52249},[],"Replace the placeholders with your real release, namespace and deployment.",{"_3624":445,"_31165":423,"_21590":52251,"_5":14857,"_28357":52203,"_3076":52252},[],"Also run the chart's connectivity test:",{"_3624":446,"_31165":423,"_21590":52254,"_5":14857,"_28357":52203,"_3076":52255},[],"The test checks the health of CA, DMS Manager, Device Manager and VA, and verifies that the UI returns HTML. A passing test confirms basic connectivity, not a full issuance flow.",{"_3624":447,"_31165":423,"_21590":52257,"_5":14857,"_28357":52203,"_3076":52258},[],"The chart's services expose startup, readiness and liveness probes over /health. A pod can be running but receive no traffic if the readiness probe fails.",{"_3624":448,"_31165":423,"_21590":52260,"_5":14857,"_28357":52207,"_3076":52261},[],"If you receive a 401:",{"_3624":449,"_31165":423,"_21590":52263,"_5":14857,"_28357":52207,"_3076":52264},[],"check that the UI's OIDC authority is reachable from the browser;",{"_3624":450,"_31165":423,"_21590":52266,"_5":14857,"_28357":52207,"_3076":52267},[],"verify issuer, audience and expiration of the token;",{"_3624":451,"_31165":423,"_21590":52269,"_5":14857,"_28357":52207,"_3076":52270},[],"confirm the Gateway can fetch the keys from the JWKS URI;",{"_3624":452,"_31165":423,"_21590":52272,"_5":14857,"_28357":52207,"_3076":52273},[],"check that the provider's public and internal routes point to the same realm.",{"_3624":453,"_31165":423,"_21590":52275,"_5":14857,"_28357":52207,"_3076":52276},[],"If login succeeds but the APIs return 403:",{"_3624":454,"_31165":423,"_21590":52278,"_5":14857,"_28357":52207,"_3076":52279},[],"inspect the token's real claims;",{"_3624":455,"_31165":423,"_21590":52281,"_5":14857,"_28357":52207,"_3076":52282},[],"confirm they match an active principal;",{"_3624":456,"_31165":423,"_21590":52284,"_5":14857,"_28357":52207,"_3076":52285},[],"review the policies granted to that principal;",{"_3624":457,"_31165":423,"_21590":52287,"_5":14857,"_28357":52207,"_3076":52288},[],"verify that authz reaches PostgreSQL and its JWKS.",{"_3624":458,"_31165":423,"_21590":52290,"_5":14857,"_28357":52207,"_3076":52291},[],"On a fresh installation, confirm the migration Job finished. That Job creates schemas, migrates authz, preloads policies and provisions the principals defined in services.authz.bootstrap.",{"_3624":459,"_31165":423,"_21590":52293,"_5":14857,"_28357":52211,"_3076":52294},[],"External authorization fails closed by default. If authz is unavailable, protected routes are blocked.",{"_3624":460,"_31165":423,"_21590":52296,"_5":14857,"_28357":52211,"_3076":52297},[],"Locate the authz pod and Service.",{"_3624":461,"_31165":423,"_21590":52299,"_5":14857,"_28357":52211,"_3076":52300},[],"Check /health, logs and its database connection.",{"_3624":462,"_31165":423,"_21590":52302,"_5":14857,"_28357":52211,"_3076":52303},[],"Verify the DNS and port configured in externalAuthorization.",{"_3624":463,"_31165":423,"_21590":52305,"_5":14857,"_28357":52211,"_3076":52306},[],"Check the check route is /v1/ext\\_authz/check.",{"_3624":464,"_31165":423,"_21590":52308,"_5":14857,"_28357":52211,"_3076":52309},[],"Do not switch to failOpen: true as a permanent workaround: it would allow traffic without authorization during the outage.",{"_3624":465,"_31165":423,"_21590":52311,"_5":14857,"_28357":52215,"_3076":52312},[],"A 500 indicates an internal failure, such as an unavailable database. The `{\"err\": ...}` body currently includes the text of the internal error, which can contain schema, table and constraint names and, on connection failures, the database host and user (not the password). Find the cause in the service log using the request time, and do not forward the body to third parties or show it to end users. This is a known information-disclosure defect: generic messages are planned for 500 responses, keeping the detail only in the service log (tracked in lamassuiot#814). The authorization connector also returns the internal error, in the `details.error` field. Some request errors, such as a key size the engine does not support, are also returned as 500.",{"_3624":466,"_31165":423,"_21590":52314,"_5":14857,"_28357":52219,"_3076":52315},[],"Review kubectl describe pod first. Common causes are:",{"_3624":467,"_31165":423,"_21590":52317,"_5":14857,"_28357":52219,"_3076":52318},[],"wrong credentials or DNS for PostgreSQL or RabbitMQ;",{"_3624":468,"_31165":423,"_21590":52320,"_5":14857,"_28357":52219,"_3076":52321},[],"a missing AMQP CA or client certificate Secret referenced by `amqp.ca.secretName` or `amqp.client.secretName`;",{"_3624":469,"_31165":423,"_21590":52323,"_5":14857,"_28357":52219,"_3076":52324},[],"unbound persistent volume;",{"_3624":470,"_31165":423,"_21590":52326,"_5":14857,"_28357":52219,"_3076":52327},[],"inaccessible image or incorrect pull policy;",{"_3624":471,"_31165":423,"_21590":52329,"_5":14857,"_28357":52219,"_3076":52330},[],"invalid cryptographic engine configuration;",{"_3624":472,"_31165":423,"_21590":52332,"_5":14857,"_28357":52219,"_3076":52333},[],"CPU or memory limits set too low;",{"_3624":473,"_31165":423,"_21590":52335,"_5":14857,"_28357":52219,"_3076":52336},[],"an incomplete prior migration.",{"_3624":474,"_31165":423,"_21590":52338,"_5":14857,"_28357":52219,"_3076":52339},[],"Generic values request 100 mCPU and 128 MiB and limit to 500 mCPU and 512 MiB. Tune per service when you see OOMKills, throttling or slow startups.",{"_3624":475,"_31165":423,"_21590":52341,"_5":14857,"_28357":52219,"_3076":52342},[],"Filesystem-based KMS engines and VA local storage use exclusive-access volumes. Keep a single replica or migrate to shared backends before enabling autoscaling.",{"_3624":476,"_31165":423,"_21590":52344,"_5":14857,"_28357":52219,"_3076":52345},[],"Internal calls now fail fast instead of hanging for the clients covered by Egress proxy: connection attempts time out after 30 seconds and TLS handshakes after 10 seconds. The authorization-engine connector keeps its own transport without these dial and handshake timeouts; only its overall 30-second request timeout bounds each call. If an egress proxy handles the cluster's outbound traffic, check the pod's `HTTP_PROXY`, `HTTPS_PROXY` and `NO_PROXY` environment variables and list in-cluster service names in `NO_PROXY`.",{"_3624":477,"_31165":423,"_21590":52347,"_5":14857,"_28357":52223,"_3076":52348},[],"Domain and audit events depend on the bus publisher:",{"_3624":478,"_31165":423,"_21590":52350,"_5":14857,"_28357":52223,"_3076":52351},[],"verify it is enabled in the emitting service;",{"_3624":479,"_31165":423,"_21590":52353,"_5":14857,"_28357":52223,"_3076":52354},[],"check AMQP connectivity and credentials;",{"_3624":480,"_31165":423,"_21590":52356,"_5":14857,"_28357":52223,"_3076":52357},[],"review exchange, routing key, queues and consumers;",{"_3624":481,"_31165":423,"_21590":52359,"_5":14857,"_28357":52223,"_3076":52360},[],"inspect dead-letter queues;",{"_3624":482,"_31165":423,"_21590":52362,"_5":14857,"_28357":52223,"_3076":52363},[],"alert on orphan durable queues and backlog growth.",{"_3624":483,"_31165":423,"_21590":52365,"_5":14857,"_28357":52223,"_3076":52366},[],"If `amqp.tls` is enabled, verify the TLS side as well:",{"_3624":484,"_31165":423,"_21590":52368,"_5":14857,"_28357":52223,"_3076":52369},[],"confirm the broker listener speaks AMQPS on the configured port — the default port stays `5672` and does not follow TLS automatically;",{"_3624":485,"_31165":423,"_21590":52371,"_5":14857,"_28357":52223,"_3076":52372},[],"if you set `amqp.ca.secretName`, confirm the Secret exists in the release namespace and its data key matches `amqp.ca.certificateKey` (default `ca.crt`); if `amqp.ca.secretName` is not set, the clients trust the system CAs;",{"_3624":486,"_31165":423,"_21590":52374,"_5":14857,"_28357":52223,"_3076":52375},[],"remember that a missing referenced Secret prevents the consuming pods from starting;",{"_3624":487,"_31165":423,"_21590":52377,"_5":14857,"_28357":52223,"_3076":52378},[],"after updating the CA or client certificate Secret, restart the consuming pods: the AMQP client loads certificates at startup.",{"_3624":488,"_31165":423,"_21590":52380,"_5":14857,"_28357":52223,"_3076":52381},[],"See AMQP TLS (AMQPS) for the full configuration.",{"_3624":489,"_31165":423,"_21590":52383,"_5":14857,"_28357":52223,"_3076":52384},[],"A consumer outage does not always prevent the main operation from completing. That is why you must monitor RabbitMQ and independently verify the persistence of audit logs.",{"_3624":490,"_31165":423,"_21590":52386,"_5":14857,"_28357":52227,"_3076":52387},[],"The chart can enable OpenTelemetry instrumentation for the services that support it, including authz; it does not configure OpenTelemetry for AWS Connector, wfx or the UI. Traces are exported over OTLP HTTP and logs can be directed to a compatible endpoint, such as VictoriaLogs. Use a correlation identifier and the same time window to join Gateway, service and dependency.",{"_3624":491,"_31165":423,"_21590":52389,"_5":14857,"_28357":52227,"_3076":52390},[],"Before closing an incident, record:",{"_3624":492,"_31165":423,"_21590":52392,"_5":14857,"_28357":52227,"_3076":52393},[],"the confirmed cause;",{"_3624":493,"_31165":423,"_21590":52395,"_5":14857,"_28357":52227,"_3076":52396},[],"the time scope and affected resources;",{"_3624":494,"_31165":423,"_21590":52398,"_5":14857,"_28357":52227,"_3076":52399},[],"the commands or queries used;",{"_3624":495,"_31165":423,"_21590":52401,"_5":14857,"_28357":52227,"_3076":52402},[],"the applied change and how to revert it;",{"_3624":496,"_31165":423,"_21590":52404,"_5":14857,"_28357":52227,"_3076":52405},[],"validation from a consumer;",{"_3624":497,"_31165":423,"_21590":52407,"_5":14857,"_28357":52227,"_3076":52408},[],"the preventive action and its owner.",{"_3624":498,"_31165":498,"_5":15217,"_3076":52410,"_31503":52411,"_21590":52415,"_28357":498},"Data model",[50900,52412,52413,52414],"Platform","Administration","Access control",[],{"_3624":499,"_31165":498,"_21590":52417,"_5":14857,"_28357":498,"_3076":52418},[],"Entities and relationships from the pki.json schema that authz uses to evaluate access policies.",{"_3624":500,"_31165":498,"_5":31500,"_21590":52420,"_28357":52421,"_3076":52422},[],"/docs/platform/administration/access-control/data-model#schema-relationships","Schema relationships",{"_3624":501,"_31165":498,"_5":31500,"_21590":52424,"_28357":52425,"_3076":52426},[],"/docs/platform/administration/access-control/data-model#schema-entities","Schema entities",{"_3624":502,"_31165":498,"_21590":52428,"_5":14857,"_28357":498,"_3076":52429},[],"The `connectors/authz/pki.json` schema defines the entities in the `pki` authorization namespace. A policy identifies a resource type through `namespace: pki`, `schema_name` and `entity_type`. For example, `ca.certificate` identifies the `certificate` entity type in the `ca` schema.",{"_3624":503,"_31165":498,"_21590":52431,"_5":14857,"_28357":52421,"_3076":52432},[],"Each arrow starts at the entity that declares the relationship and points to its `target_entity`. The value of `foreign_key`, the source column, appears below the label. In `pki.json`, each relationship's `name` matches that column. Select the diagram to enlarge it and scroll through it.",{"_3624":504,"_31165":498,"_21590":52434,"_5":14857,"_28357":52421,"_3076":52435},[],"A policy can propagate actions from the referenced entity to the one that declares the relationship. For example, to grant read access to a DMS's devices, a rule starts from `dmsmanager.dms`, targets `devicemanager.device` and specifies `via: dms_owner`.",{"_3624":505,"_31165":498,"_21590":52437,"_5":14857,"_28357":52421,"_3076":52438},[],"When filtering inherited access, `authz` matches the `foreign_key` column against the first `primary_key` column of the referenced entity. For example, it matches `subject_common_name` to `device.id`, `issuer_meta_serial_number` to `ca_certificate.id` and the links to `kms_key` to `kms_key.key_id`.",{"_3624":506,"_31165":498,"_21590":52440,"_5":14857,"_28357":52425,"_3076":52441},[],"Entity (`schema_name.entity_type`)",{"_3624":507,"_31165":498,"_21590":52443,"_5":14857,"_28357":52425,"_3076":52444},[],"Table (`table_name`)",{"_3624":508,"_31165":498,"_21590":52446,"_5":14857,"_28357":52425,"_3076":52447},[],"Key (`primary_key`)",{"_3624":509,"_31165":498,"_21590":52449,"_5":14857,"_28357":52425,"_3076":52450},[],"`alerts.event`",{"_3624":510,"_31165":498,"_21590":52452,"_5":14857,"_28357":52425,"_3076":52453},[],"`events`",{"_3624":511,"_31165":498,"_21590":52455,"_5":14857,"_28357":52425,"_3076":52456},[],"`event_type`",{"_3624":512,"_31165":498,"_21590":52458,"_5":14857,"_28357":52425,"_3076":52459},[],"`alerts.subscription`",{"_3624":513,"_31165":498,"_21590":52461,"_5":14857,"_28357":52425,"_3076":52462},[],"`subscriptions`",{"_3624":514,"_31165":498,"_21590":52464,"_5":14857,"_28357":52425,"_3076":52465},[],"`id`",{"_3624":515,"_31165":498,"_21590":52467,"_5":14857,"_28357":52425,"_3076":52468},[],"`ca.ca_certificate`",{"_3624":516,"_31165":498,"_21590":52470,"_5":14857,"_28357":52425,"_3076":52471},[],"`ca_certificates`",{"_3624":517,"_31165":498,"_21590":52473,"_5":14857,"_28357":52425,"_3076":52465},[],{"_3624":518,"_31165":498,"_21590":52475,"_5":14857,"_28357":52425,"_3076":52476},[],"`ca.certificate`",{"_3624":519,"_31165":498,"_21590":52478,"_5":14857,"_28357":52425,"_3076":52479},[],"`certificates`",{"_3624":520,"_31165":498,"_21590":52481,"_5":14857,"_28357":52425,"_3076":52482},[],"`serial_number`",{"_3624":521,"_31165":498,"_21590":52484,"_5":14857,"_28357":52425,"_3076":52485},[],"`ca.issuance_profile`",{"_3624":522,"_31165":498,"_21590":52487,"_5":14857,"_28357":52425,"_3076":52488},[],"`issuance_profiles`",{"_3624":523,"_31165":498,"_21590":52490,"_5":14857,"_28357":52425,"_3076":52465},[],{"_3624":524,"_31165":498,"_21590":52492,"_5":14857,"_28357":52425,"_3076":52493},[],"`devicemanager.device_group`",{"_3624":525,"_31165":498,"_21590":52495,"_5":14857,"_28357":52425,"_3076":52496},[],"`device_groups`",{"_3624":526,"_31165":498,"_21590":52498,"_5":14857,"_28357":52425,"_3076":52465},[],{"_3624":527,"_31165":498,"_21590":52500,"_5":14857,"_28357":52425,"_3076":52501},[],"`devicemanager.device`",{"_3624":528,"_31165":498,"_21590":52503,"_5":14857,"_28357":52425,"_3076":52504},[],"`devices`",{"_3624":529,"_31165":498,"_21590":52506,"_5":14857,"_28357":52425,"_3076":52465},[],{"_3624":530,"_31165":498,"_21590":52508,"_5":14857,"_28357":52425,"_3076":52509},[],"`dmsmanager.dms`",{"_3624":531,"_31165":498,"_21590":52511,"_5":14857,"_28357":52425,"_3076":52512},[],"`dms`",{"_3624":532,"_31165":498,"_21590":52514,"_5":14857,"_28357":52425,"_3076":52465},[],{"_3624":533,"_31165":498,"_21590":52516,"_5":14857,"_28357":52425,"_3076":52517},[],"`kms.kms_key`",{"_3624":534,"_31165":498,"_21590":52519,"_5":14857,"_28357":52425,"_3076":52520},[],"`kms_keys`",{"_3624":535,"_31165":498,"_21590":52522,"_5":14857,"_28357":52425,"_3076":52523},[],"`key_id`, `engine_id`",{"_3624":536,"_31165":498,"_21590":52525,"_5":14857,"_28357":52425,"_3076":52526},[],"`va.crl_settings`",{"_3624":537,"_31165":498,"_21590":52528,"_5":14857,"_28357":52425,"_3076":52529},[],"`crl_settings`",{"_3624":538,"_31165":498,"_21590":52531,"_5":14857,"_28357":52425,"_3076":52532},[],"`ca_id`",{"_3624":539,"_31165":498,"_21590":52534,"_5":14857,"_28357":52425,"_3076":52535},[],"Events, subscriptions and device groups have their own actions and filters. Their `relations` lists are empty and they have zero incoming references in the schema. For `ca.certificate`, `view_tables` also lists `certificates_view`.",{"_3624":540,"_31165":498,"_21590":52537,"_5":14857,"_28357":52425,"_3076":52538},[],"Each entity declares instance-level operations in `atomic_actions`, operations that require no resource ID in `global_actions`, and the columns and types accepted by `column_filters` in `filterable`.",{"_3624":541,"_31165":498,"_21590":52540,"_5":14857,"_28357":52425,"_3076":52541},[],"<Card title=\"Access inherited through relations\" href=\"/docs/platform/administration/access-control#access-inherited-through-relations\" />",{"_3624":542,"_31165":542,"_5":15217,"_3076":52543,"_31503":52544,"_21590":52545,"_28357":542},"Access control overview",[50900,52412,52413,52414],[],{"_3624":543,"_31165":542,"_21590":52547,"_5":14857,"_28357":542,"_3076":52548},[],"Design who can access Lamassu through principals, policies, resource permissions and HTTP route authorization.",{"_3624":544,"_31165":542,"_5":31500,"_21590":52550,"_28357":52551,"_3076":52552},[],"/docs/platform/administration/access-control#essential-concepts","Essential concepts",{"_3624":545,"_31165":542,"_5":31500,"_21590":52554,"_28357":52555,"_3076":52556},[],"/docs/platform/administration/access-control#two-decision-systems","Two decision systems",{"_3624":546,"_31165":542,"_5":31500,"_21590":52558,"_28357":52559,"_3076":52560},[],"/docs/platform/administration/access-control#integrated-or-external-http-services","Integrated or external HTTP services",{"_3624":547,"_31165":542,"_5":31500,"_21590":52562,"_28357":52563,"_3076":52564},[],"/docs/platform/administration/access-control#authentication-only-routes-and-unmapped-paths","Authentication-only routes and unmapped paths",{"_3624":548,"_31165":542,"_5":31500,"_21590":52566,"_28357":52567,"_3076":52568},[],"/docs/platform/administration/access-control#services-developed-by-lamassu","Services developed by Lamassu",{"_3624":549,"_31165":542,"_5":31500,"_21590":52570,"_28357":52571,"_3076":52572},[],"/docs/platform/administration/access-control#how-the-two-paths-relate","How the two paths relate",{"_3624":550,"_31165":542,"_5":31500,"_21590":52574,"_28357":52575,"_3076":52576},[],"/docs/platform/administration/access-control#oidc-principals","OIDC principals",{"_3624":551,"_31165":542,"_5":31500,"_21590":52578,"_28357":52579,"_3076":52580},[],"/docs/platform/administration/access-control#x509-principals","X.509 principals",{"_3624":552,"_31165":542,"_5":31500,"_21590":52582,"_28357":52583,"_3076":52584},[],"/docs/platform/administration/access-control#when-several-principals-match","When several principals match",{"_3624":553,"_31165":542,"_5":31500,"_21590":52586,"_28357":52587,"_3076":52588},[],"/docs/platform/administration/access-control#how-policies-express-access","How policies express access",{"_3624":554,"_31165":542,"_5":31500,"_21590":52590,"_28357":52591,"_3076":52592},[],"/docs/platform/administration/access-control#global-and-direct-access","Global and direct access",{"_3624":555,"_31165":542,"_5":31500,"_21590":52594,"_28357":52595,"_3076":52596},[],"/docs/platform/administration/access-control#access-inherited-through-relations","Access inherited through relations",{"_3624":556,"_31165":542,"_5":31500,"_21590":52598,"_28357":52599,"_3076":52600},[],"/docs/platform/administration/access-control#attribute-filtered-access","Attribute-filtered access",{"_3624":557,"_31165":542,"_5":31500,"_21590":52602,"_28357":52603,"_3076":52604},[],"/docs/platform/administration/access-control#http-rules","HTTP rules",{"_3624":558,"_31165":542,"_5":31500,"_21590":52606,"_28357":52607,"_3076":52608},[],"/docs/platform/administration/access-control#included-policies","Included policies",{"_3624":559,"_31165":542,"_5":31500,"_21590":52610,"_28357":52611,"_3076":51550},[],"/docs/platform/administration/access-control#provision-the-first-administrator",{"_3624":560,"_31165":542,"_5":31500,"_21590":52613,"_28357":52614,"_3076":52615},[],"/docs/platform/administration/access-control#prepare-the-identity-provider","Prepare the identity provider",{"_3624":561,"_31165":542,"_5":31500,"_21590":52617,"_28357":52618,"_3076":52619},[],"/docs/platform/administration/access-control#configure-token-validation","Configure token validation",{"_3624":562,"_31165":542,"_5":31500,"_21590":52621,"_28357":52622,"_3076":52623},[],"/docs/platform/administration/access-control#install-and-verify-administrative-access","Install and verify administrative access",{"_3624":563,"_31165":542,"_5":31500,"_21590":52625,"_28357":52626,"_3076":52627},[],"/docs/platform/administration/access-control#test-an-unprivileged-identity","Test an unprivileged identity",{"_3624":564,"_31165":542,"_5":31500,"_21590":52629,"_28357":52630,"_3076":52631},[],"/docs/platform/administration/access-control#reduce-use-of-the-bootstrap-administrator","Reduce use of the bootstrap administrator",{"_3624":565,"_31165":542,"_5":31500,"_21590":52633,"_28357":52634,"_3076":52635},[],"/docs/platform/administration/access-control#fastlane-bootstrap","Fastlane bootstrap",{"_3624":566,"_31165":542,"_5":31500,"_21590":52637,"_28357":52638,"_3076":52639},[],"/docs/platform/administration/access-control#design-least-privilege-roles","Design least-privilege roles",{"_3624":567,"_31165":542,"_5":31500,"_21590":52641,"_28357":52642,"_3076":52643},[],"/docs/platform/administration/access-control#changes-and-access-revocation","Changes and access revocation",{"_3624":568,"_31165":542,"_5":31500,"_21590":52645,"_28357":52646,"_3076":52647},[],"/docs/platform/administration/access-control#operational-checklist","Operational checklist",{"_3624":569,"_31165":542,"_5":31500,"_21590":52649,"_28357":52650,"_3076":52651},[],"/docs/platform/administration/access-control#diagnostics","Diagnostics",{"_3624":570,"_31165":542,"_5":31500,"_21590":52653,"_28357":52654,"_3076":52655},[],"/docs/platform/administration/access-control#the-response-is-401","The response is 401",{"_3624":571,"_31165":542,"_5":31500,"_21590":52657,"_28357":52658,"_3076":52659},[],"/docs/platform/administration/access-control#the-response-is-403","The response is 403",{"_3624":572,"_31165":542,"_5":31500,"_21590":52661,"_28357":52662,"_3076":52663},[],"/docs/platform/administration/access-control#everything-returns-403","Everything returns 403",{"_3624":573,"_31165":542,"_5":31500,"_21590":52665,"_28357":52666,"_3076":52667},[],"/docs/platform/administration/access-control#access-appears-without-a-policy-grant","Access appears without a policy grant",{"_3624":574,"_31165":542,"_5":31500,"_21590":52669,"_28357":52670,"_3076":52671},[],"/docs/platform/administration/access-control#everything-fails-when-authz-is-unavailable","Everything fails when authz is unavailable",{"_3624":575,"_31165":542,"_21590":52673,"_5":14857,"_28357":542,"_3076":52674},[],"Lamassu access control turns an authenticated identity into concrete permissions. The OIDC provider or the client certificate proves **who** makes a request; the `authz` service decides **what that identity can do** and **over which resources**.",{"_3624":576,"_31165":542,"_21590":52676,"_5":14857,"_28357":542,"_3076":52677},[],"Lamassu does not assign permissions directly to users. The full chain is:",{"_3624":577,"_31165":542,"_21590":52679,"_5":14857,"_28357":542,"_3076":52680},[],"This model lets you represent people, identity-provider groups, service accounts and devices without coupling authorization to a specific provider.",{"_3624":578,"_31165":542,"_21590":52682,"_5":14857,"_28357":52551,"_3076":52683},[],"A **principal** connects a credential to Lamassu. It defines how to recognize an OIDC or X.509 identity and can be active or disabled.",{"_3624":579,"_31165":542,"_21590":52685,"_5":14857,"_28357":52551,"_3076":52686},[],"A **policy** groups reusable permissions. It can be granted to several principals and can contain rules about Lamassu entities, rules about HTTP routes or both.",{"_3624":580,"_31165":542,"_21590":52688,"_5":14857,"_28357":52551,"_3076":52689},[],"An **entity rule** grants actions over resources such as certification authorities, certificates, issuance profiles, devices, DMSs, keys or alert subscriptions. It can cover all resources of a type or be limited by identifier, relation or attribute.",{"_3624":581,"_31165":542,"_21590":52691,"_5":14857,"_28357":52551,"_3076":52692},[],"An **HTTP rule** grants actions associated with API routes. It is the mechanism the Gateway uses to decide whether a request may cross the perimeter.",{"_3624":582,"_31165":542,"_21590":52694,"_5":14857,"_28357":52551,"_3076":52695},[],"A **grant** is the association between a principal and a policy. Removing the grant removes all permissions contributed by that policy, without modifying it for other principals.",{"_3624":583,"_31165":542,"_21590":52697,"_5":14857,"_28357":52551,"_3076":52698},[],"A valid JWT or a valid client certificate does not grant access by itself. The credential must match at least one active principal and, unless the HTTP schema exempts the route, one of its policies must allow the requested operation. See *Authentication-only routes and unmapped paths* for those exemptions.",{"_3624":584,"_31165":542,"_21590":52700,"_5":14857,"_28357":52555,"_3076":52701},[],"Lamassu uses two authorization paths depending on who implements the protected service. They share principals, policies and grants, but they do not interpret the rules the same way.",{"_3624":585,"_31165":542,"_21590":52703,"_5":14857,"_28357":52555,"_3076":52704},[],"An external service can be protected without knowing Lamassu's internal authorization model. A service developed by Lamassu embeds the authorization engine and can decide on concrete resources and filter its queries.",{"_3624":586,"_31165":542,"_21590":52706,"_5":14857,"_28357":52559,"_3076":52707},[],"This path protects APIs that join the platform through the Gateway but do not natively implement Lamassu's authorization SDK. Job Manager is the current example. The same pattern allows integrating other HTTP services as long as their routes are described in an `authz` HTTP schema.",{"_3624":587,"_31165":542,"_21590":52709,"_5":14857,"_28357":52559,"_3076":52710},[],"The decision is made **before forwarding the request to the service**:",{"_3624":588,"_31165":542,"_21590":52712,"_5":14857,"_28357":52559,"_3076":52713},[],"Envoy Gateway authenticates the request, usually validating a JWT against the OIDC provider's JWKS.",{"_3624":589,"_31165":542,"_21590":52715,"_5":14857,"_28357":52559,"_3076":52716},[],"For a protected route, Envoy sends the method, URL, headers and required data to `/v1/ext_authz/check`.",{"_3624":590,"_31165":542,"_21590":52718,"_5":14857,"_28357":52559,"_3076":52719},[],"`authz` extracts the credential and resolves all active principals matching it.",{"_3624":591,"_31165":542,"_21590":52721,"_5":14857,"_28357":52559,"_3076":52722},[],"It separately loads the policies granted to each principal.",{"_3624":592,"_31165":542,"_21590":52724,"_5":14857,"_28357":52559,"_3076":52725},[],"The HTTP schema translates the method and route combination into a logical action, such as `nbi-job-read` or `nbi-workflow-create`.",{"_3624":593,"_31165":542,"_21590":52727,"_5":14857,"_28357":52559,"_3076":52728},[],"`authz` looks for an HTTP rule granting that action.",{"_3624":594,"_31165":542,"_21590":52730,"_5":14857,"_28357":52559,"_3076":52731},[],"If the route declares constraints, it compares request data with the normalized attributes of the same principal contributing the policy; the policy's own `param_constraints` also pin the granted action to literal request values.",{"_3624":595,"_31165":542,"_21590":52733,"_5":14857,"_28357":52559,"_3076":52734},[],"A satisfying result lets Envoy forward the request; any other response blocks it at the Gateway.",{"_3624":596,"_31165":542,"_21590":52736,"_5":14857,"_28357":52559,"_3076":52737},[],"When it allows access, `authz` returns the selected principal in the `X-Principal-ID` response header. The Gateway can propagate that header to the service to preserve the identity context. Clients cannot forge this header: the Gateway removes client-supplied `X-Principal-Id` (and the other forwarded identity and certificate headers) before forwarding, so only `authz` can set it. See Expose the Gateway for the full list of stripped headers.",{"_3624":597,"_31165":542,"_21590":52739,"_5":14857,"_28357":52559,"_3076":52740},[],"HTTP rules primarily answer &#x2A;*\"can this identity call this API operation?\"**. On their own they do not produce filters over the external service's database. To limit a route to a specific device, tenant or client, either the schema declares a constraint relating a request value to a normalized attribute of the principal, or the policy pins the request value to a literal with `param_constraints`. The first scopes each identity to its own resources through a single grant; the second restricts a grant to a fixed value regardless of who holds it.",{"_3624":598,"_31165":542,"_21590":52742,"_5":14857,"_28357":52563,"_3076":52743},[],"Two schema-level settings cover endpoints that policies do not mention:",{"_3624":599,"_31165":542,"_21590":52745,"_5":14857,"_28357":52563,"_3076":52746},[],"**`skip_authz: true` on a route** allows any identity that matches an active principal to reach it, even one with no granted policies. Use it for paths such as `/openapi.json` or `/health` that every authenticated caller should be able to access. The request still has to authenticate successfully: a credential that fails validation or matches no active principal is rejected before this setting is considered. A `skip_authz` route cannot declare constraints, and it wins over any other schema's route or default action for the same request.",{"_3624":600,"_31165":542,"_21590":52748,"_5":14857,"_28357":52563,"_3076":52749},[],"**`default_action` with `base_paths`** decides what happens when a request falls under a path prefix the schema owns but no explicit route matches. `deny` — the value the Job Manager schema ships with — turns the implicit denial of unmapped paths into an explicit, auditable statement; `allow` opens unmapped endpoints under that prefix to any identity that matches an active principal.",{"_3624":601,"_31165":542,"_21590":52751,"_5":14857,"_28357":52563,"_3076":52752},[],"These are decisions of the schema, not of a policy: `skip_authz` removes the grant check for that route, even when another schema maps the same request to an action that requires a grant, and `default_action` only covers requests that no explicit route in any schema matches. Keep three rules in mind:",{"_3624":602,"_31165":542,"_21590":52754,"_5":14857,"_28357":52563,"_3076":52755},[],"`default_action` requires at least one `base_paths` entry, and base paths are absolute paths such as `/api/wfx/nbi/v1`.",{"_3624":603,"_31165":542,"_21590":52757,"_5":14857,"_28357":52563,"_3076":52758},[],"An explicit route in any schema takes precedence: the fallback only decides requests that no schema's routes cover. When the prefixes of two schemas overlap, the longest matching prefix decides.",{"_3624":604,"_31165":542,"_21590":52760,"_5":14857,"_28357":52563,"_3076":52761},[],"Two schemas cannot claim the same base path with different default actions; the conflicting schema fails to load.",{"_3624":605,"_31165":542,"_21590":52763,"_5":14857,"_28357":52563,"_3076":52764},[],"A `skip_authz` route and a `default_action: \"allow\"` prefix grant access without consulting any policy. Every identity that matches an active principal can reach what they open, including identities with no granted policies. A `skip_authz` route in one schema also opens a request that another schema maps to a grant-protected action. Review these settings whenever you add or upgrade an integrated service.",{"_3624":606,"_31165":542,"_21590":52766,"_5":14857,"_28357":52563,"_3076":52767},[],"A schema can also make an individual route accept the credential from the URL. **`query_token: true` on a route** makes it accept the OIDC access token from the `access_token` query parameter, but only when the request carries neither an `Authorization: Bearer` header nor a client-certificate header: a credential in a header always wins. The token is validated and authorized exactly like a Bearer token, so the route's action still requires a policy grant, and routes that do not opt in never read the query parameter. The dashboard's experimental browser terminal uses this mechanism, because the WebSocket connection its browser client opens cannot set request headers.",{"_3624":607,"_31165":542,"_21590":52769,"_5":14857,"_28357":52563,"_3076":52770},[],"Query strings are often recorded. `authz` replaces the `access_token` value with `REDACTED` in its own decision logs, but other logs that capture the URL — the Gateway access log, service request logs, tracing — are not redacted. Keep `query_token` for WebSocket routes and short-lived tokens.",{"_3624":608,"_31165":542,"_21590":52772,"_5":14857,"_28357":52567,"_3076":52773},[],"Lamassu's native services embed authorization in their middleware and know the entities they operate on: certificates, CAs, issuance profiles, keys, devices, DMSs or subscriptions, among others.",{"_3624":609,"_31165":542,"_21590":52775,"_5":14857,"_28357":52567,"_3076":52776},[],"The decision is made with the domain operation context:",{"_3624":610,"_31165":542,"_21590":52778,"_5":14857,"_28357":52567,"_3076":52779},[],"The middleware extracts the credential and resolves the matching principals.",{"_3624":611,"_31165":542,"_21590":52781,"_5":14857,"_28357":52567,"_3076":52782},[],"The endpoint identifies the action, the entity type and, when applicable, the key of the requested resource.",{"_3624":612,"_31165":542,"_21590":52784,"_5":14857,"_28357":52567,"_3076":52785},[],"`authz` gathers the entity rules of the granted policies.",{"_3624":613,"_31165":542,"_21590":52787,"_5":14857,"_28357":52567,"_3076":52788},[],"The engine evaluates direct grants, attribute filters and relations with other entities.",{"_3624":614,"_31165":542,"_21590":52790,"_5":14857,"_28357":52567,"_3076":52791},[],"For an individual operation, it checks that the concrete resource satisfies the computed scope.",{"_3624":615,"_31165":542,"_21590":52793,"_5":14857,"_28357":52567,"_3076":52794},[],"For a listing, it generates a SQL filter that the service adds to its own query.",{"_3624":616,"_31165":542,"_21590":52796,"_5":14857,"_28357":52567,"_3076":52797},[],"Here the engine answers &#x2A;*\"can this identity perform this action on this concrete resource?\"**.",{"_3624":617,"_31165":542,"_21590":52799,"_5":14857,"_28357":52567,"_3076":52800},[],"Actions fall into two groups:",{"_3624":618,"_31165":542,"_21590":52802,"_5":14857,"_28357":52567,"_3076":52803},[],"**Global actions** do not need a resource identifier. `create`, `import` or access to a console section are common examples.",{"_3624":619,"_31165":542,"_21590":52805,"_5":14857,"_28357":52567,"_3076":52806},[],"**Atomic actions** are evaluated on a concrete instance. For certificates these include `read`, `metadata-update`, `status-update` and `delete`; for a CA there are also `sign`, `reissue` and other lifecycle operations.",{"_3624":620,"_31165":542,"_21590":52808,"_5":14857,"_28357":52567,"_3076":52809},[],"Filtering inside the service prevents leaks in listings: unauthorized resources are excluded from the SQL query instead of being fetched and hidden later in the interface.",{"_3624":621,"_31165":542,"_21590":52811,"_5":14857,"_28357":52571,"_3076":52812},[],"They are not two equivalent controls applied twice. HTTP rules protect the perimeter of an integrated service; entity rules express permissions over the data model of the native services.",{"_3624":622,"_31165":542,"_21590":52814,"_5":14857,"_28357":52571,"_3076":52815},[],"A policy can contain both rule types when an identity needs to operate Lamassu resources and also call an integrated API. Granting an entity rule does not automatically grant an HTTP action, nor does an HTTP rule create access over an entity.",{"_3624":623,"_31165":542,"_21590":52817,"_5":14857,"_28357":52571,"_3076":52818},[],"If no combination of principal, policy and rule allows the operation, Lamassu denies it, unless the HTTP schema declares `skip_authz` on the route or `default_action: allow` on a base path that covers it (see *Authentication-only routes and unmapped paths*). Additionally, `auth.externalAuthorization.failOpen` is `false` by default: if `authz` is unavailable, the Gateway blocks protected routes.",{"_3624":624,"_31165":542,"_21590":52820,"_5":14857,"_28357":52575,"_3076":52821},[],"An OIDC principal matches the claims of a validated JWT. It is appropriate for human users, corporate groups, IdP roles and service accounts that obtain tokens.",{"_3624":625,"_31165":542,"_21590":52823,"_5":14857,"_28357":52575,"_3076":52824},[],"The following principal represents any identity holding the `pki-operators` role in Keycloak:",{"_3624":626,"_31165":542,"_21590":52826,"_5":14857,"_28357":52575,"_3076":52827},[],"Claim paths can be nested, such as `realm_access.roles`. Within a single principal, **all** conditions must hold. This lets you require, for example, a group and an organizational audience at the same time.",{"_3624":627,"_31165":542,"_21590":52829,"_5":14857,"_28357":52575,"_3076":52830},[],"The implemented operators are:",{"_3624":628,"_31165":542,"_21590":52832,"_5":14857,"_28357":52575,"_3076":52833},[],"`equals`, for exact equality;",{"_3624":629,"_31165":542,"_21590":52835,"_5":14857,"_28357":52575,"_3076":52836},[],"`contains`, to check membership in a list or the presence of text in a scalar value.",{"_3624":630,"_31165":542,"_21590":52838,"_5":14857,"_28357":52575,"_3076":52839},[],"Design matching with stable attributes. For people, it is usually better to bind permissions to centrally managed groups or roles than to the email or username. For a service account, a stable `sub` keeps its permissions from mixing with a human operator's.",{"_3624":631,"_31165":542,"_21590":52841,"_5":14857,"_28357":52575,"_3076":52842},[],"Although the model recognizes the operator name `matches`, the current implementation does not evaluate regular expressions and the condition never matches. Use `equals` or `contains`.",{"_3624":632,"_31165":542,"_21590":52844,"_5":14857,"_28357":52579,"_3076":52845},[],"An X.509 principal lets you recognize a workload or a device by its client certificate. Lamassu checks the certificate signature against the configured CA and, depending on the mode, also its serial number or Common Name.",{"_3624":633,"_31165":542,"_21590":52847,"_5":14857,"_28357":52579,"_3076":52848},[],"The available modes are:",{"_3624":634,"_31165":542,"_21590":52850,"_5":14857,"_28357":52579,"_3076":52851},[],"`serial_and_ca`: an exact certificate, identified by serial number and CA;",{"_3624":635,"_31165":542,"_21590":52853,"_5":14857,"_28357":52579,"_3076":52854},[],"`cn_and_ca`: an exact or wildcard Common Name and a specific CA;",{"_3624":636,"_31165":542,"_21590":52856,"_5":14857,"_28357":52579,"_3076":52857},[],"`any_from_ca`: any certificate issued directly by the given CA.",{"_3624":637,"_31165":542,"_21590":52859,"_5":14857,"_28357":52579,"_3076":52860},[],"This example recognizes certificates whose CN starts with `factory-a-` and that are signed by the configured CA:",{"_3624":638,"_31165":542,"_21590":52862,"_5":14857,"_28357":52579,"_3076":52863},[],"`ca_trust.identity_type` accepts `fingerprint` or `authority_key_id`. In both cases you must provide the CA certificate in `ca_trust.pem`; Lamassu verifies both the signature and the expected identity of the CA.",{"_3624":639,"_31165":542,"_21590":52865,"_5":14857,"_28357":52579,"_3076":52866},[],"Use `any_from_ca` only when every identity issued by that CA should share the same permissions. If a CA issues certificates for different populations, separate access by serial or CN, or use different issuing CAs.",{"_3624":640,"_31165":542,"_21590":52868,"_5":14857,"_28357":52583,"_3076":52869},[],"A single credential can match more than one principal. It is common for a user to match a principal of their team and another of their operational function.",{"_3624":641,"_31165":542,"_21590":52871,"_5":14857,"_28357":52583,"_3076":52872},[],"For entity permissions, Lamassu combines permissions with OR logic: it is enough that one policy of one of the principals allows the action. Listings contain the union of the resources visible to all of them.",{"_3624":642,"_31165":542,"_21590":52874,"_5":14857,"_28357":52583,"_3076":52875},[],"HTTP routes with constraints are stricter. The same principal contributing the policy must also satisfy the attributes required by the route. Lamassu does not combine one principal's policy with an attribute belonging to another.",{"_3624":643,"_31165":542,"_21590":52877,"_5":14857,"_28357":52583,"_3076":52878},[],"For this reason, adding a matching principal can only broaden access. Before creating overlapping rules, review the full set of policies a real identity will receive.",{"_3624":644,"_31165":542,"_21590":52880,"_5":14857,"_28357":52591,"_3076":52881},[],"A rule identifies the domain (`namespace`), the data schema (`schema_name`) and the entity type (`entity_type`). `actions` lists the allowed operations.",{"_3624":645,"_31165":542,"_21590":52883,"_5":14857,"_28357":52591,"_3076":52884},[],"`direct_grants` limits the rule to concrete identifiers. The value `*` covers all instances of the type. A superadministrator policy uses wildcards in schema, entity, actions and grants; a least-privilege policy should avoid them whenever possible.",{"_3624":646,"_31165":542,"_21590":52886,"_5":14857,"_28357":52595,"_3076":52887},[],"Rules can follow relations declared between entities. For example, the schema knows the relation of a certificate to its issuing CA, of a device to its DMS and of a certificate to the KMS key that stores its private key, so a grant on the key also covers the certificates that use it. A policy can grant access to a parent resource and propagate selected actions to its related resources.",{"_3624":647,"_31165":542,"_21590":52889,"_5":14857,"_28357":52595,"_3076":52890},[],"This lets you express models like \"can operate the devices of this DMS\" without maintaining an individual list of every device. When a resource is added under that relation, it inherits the scope planned by the policy.",{"_3624":648,"_31165":542,"_21590":52892,"_5":14857,"_28357":52595,"_3076":52893},[],"The data model shows how the resources used in entity rules are connected.",{"_3624":649,"_31165":542,"_21590":52895,"_5":14857,"_28357":52595,"_3076":52896},[],"A rule can only follow relations that the data schema declares between its two entities. You can reference the relation by its name or by its foreign-key column — both spellings are equivalent, and it is the schema that decides which column the query uses. When you save a policy, `authz` checks every relation against the loaded schemas: one that no schema declares, or one pointing at an entity that is not loaded, is rejected at that moment.",{"_3624":650,"_31165":542,"_21590":52898,"_5":14857,"_28357":52595,"_3076":52899},[],"Policies stored before this validation may still carry relations the schemas do not declare. Such a relation grants nothing: `authz` logs a warning, `skipping relation that grants nothing`, naming the policy and the relation, and continues evaluating the rest of the policy. The reference is always resolved against the schema before any query is built, so an undeclared relation can never alter it. If inherited access narrows after an upgrade, check the `authz` logs for this warning and correct the relation of the affected policy.",{"_3624":651,"_31165":542,"_21590":52901,"_5":14857,"_28357":52599,"_3076":52902},[],"`column_filters` applies conditions to columns the schema has declared filterable. All filters of the same rule are combined with AND.",{"_3624":652,"_31165":542,"_21590":52904,"_5":14857,"_28357":52599,"_3076":52905},[],"For example, this rule allows reading active certificates issued by a specific CA:",{"_3624":653,"_31165":542,"_21590":52907,"_5":14857,"_28357":52599,"_3076":52908},[],"The available operators are `eq`, `neq`, `gt`, `gte`, `lt`, `lte`, `in` and `like`. Use comparisons consistent with the column type: `like` for text, ordering comparisons for numbers or dates and `in` when there is a collection of accepted values.",{"_3624":654,"_31165":542,"_21590":52910,"_5":14857,"_28357":52603,"_3076":52911},[],"HTTP rules do not point directly at tables. They reference a route schema and grant its logical actions. Job Manager's policies are an example: they distinguish reading, creating, updating and deleting workflows or jobs.",{"_3624":655,"_31165":542,"_21590":52913,"_5":14857,"_28357":52603,"_3076":52914},[],"Some routes also compare a request value — taken from the path, query, header or JSON body — with a normalized attribute of the principal. This way you can verify that a device only queries jobs addressed to its own `client_id`.",{"_3624":656,"_31165":542,"_21590":52916,"_5":14857,"_28357":52603,"_3076":52917},[],"Normalized attributes decouple the policy from the authentication mechanism. `subject_attribute_mappings` can derive, for example, `device_id` from `oidc.claim.device_id` or from `x509.subject.cn`. The rule consumes `device_id` in both cases.",{"_3624":657,"_31165":542,"_21590":52919,"_5":14857,"_28357":52603,"_3076":52920},[],"An HTTP rule can also pin a granted action to a literal value carried by the request itself through `param_constraints`. It extracts the value with the same sources as route constraints — `path_regex_group`, `query`, `header` or `json_body` — but compares it against an `equals` literal written into the policy rather than against a subject attribute. The grant then depends only on the request, not on who holds the policy:",{"_3624":658,"_31165":542,"_21590":52922,"_5":14857,"_28357":52603,"_3076":52923},[],"Combined with a schema route such as `^/api/mysvc/system/([^/]+)/info$`, this grants `GET /api/mysvc/system/1/info` and denies the same call for system `2`, regardless of the principal's attributes. The same mechanism pins query parameters, headers or JSON body fields, for example `{ \"source\": \"query\", \"name\": \"tenant_id\" }` with `\"equals\": \"1\"` to accept only requests carrying `?tenant_id=1`.",{"_3624":659,"_31165":542,"_21590":52925,"_5":14857,"_28357":52603,"_3076":52926},[],"Note that:",{"_3624":660,"_31165":542,"_21590":52928,"_5":14857,"_28357":52603,"_3076":52929},[],"`action` must be one of the actions granted by the rule; `equals` is required; `path_regex_group` needs an `index` greater than zero, `query` and `header` need a `name`, and `json_body` needs a `path` such as `$.tenant_id`.",{"_3624":661,"_31165":542,"_21590":52931,"_5":14857,"_28357":52603,"_3076":52932},[],"`param_constraints` are not cross-checked against the schema when the policy is loaded. A reference the route cannot satisfy — for instance a `path_regex_group` on a route without capture groups — simply never matches, and the request is denied.",{"_3624":662,"_31165":542,"_21590":52934,"_5":14857,"_28357":52603,"_3076":52935},[],"Several `param_constraints` for the same action combine with AND. A rule without them keeps the usual behavior: the action is granted wherever the route matches and the subject constraints pass.",{"_3624":663,"_31165":542,"_21590":52937,"_5":14857,"_28357":52607,"_3076":52938},[],"The `authz` preload installs reusable policies for the main domains. Among them are:",{"_3624":664,"_31165":542,"_21590":52940,"_5":14857,"_28357":52607,"_3076":52941},[],"full and read-only access to certificates and authorities;",{"_3624":665,"_31165":542,"_21590":52943,"_5":14857,"_28357":52607,"_3076":52944},[],"full and read-only access to the KMS;",{"_3624":666,"_31165":542,"_21590":52946,"_5":14857,"_28357":52607,"_3076":52947},[],"full and read-only access to Device Manager, DMS Manager, Validation Authority and alerts;",{"_3624":667,"_31165":542,"_21590":52949,"_5":14857,"_28357":52607,"_3076":52950},[],"an `Auditor` policy with PKI read access and authorization visibility;",{"_3624":668,"_31165":542,"_21590":52952,"_5":14857,"_28357":52607,"_3076":52953},[],"console access;",{"_3624":669,"_31165":542,"_21590":52955,"_5":14857,"_28357":52607,"_3076":52956},[],"administration and observation policies for the Job Manager NBI and SBI APIs;",{"_3624":670,"_31165":542,"_21590":52958,"_5":14857,"_28357":52607,"_3076":52959},[],"access to the dashboard's experimental terminal (Terminal Network);",{"_3624":671,"_31165":542,"_21590":52961,"_5":14857,"_28357":52607,"_3076":52962},[],"`SUPER ADMIN`, which grants all actions over the `authz` and `pki` domains.",{"_3624":672,"_31165":542,"_21590":52964,"_5":14857,"_28357":52607,"_3076":52965},[],"Start with these policies before creating others. If none reflects the boundary you need, create a specific, small policy instead of copying `SUPER ADMIN` and informally removing permissions.",{"_3624":673,"_31165":542,"_21590":52967,"_5":14857,"_28357":52607,"_3076":52968},[],"The Terminal Network policy is created by the `authz` preload the next time `authz` starts after the upgrade. Preloaded policies are system policies — their ids begin with `lamassu.` — and cannot be edited through the API.",{"_3624":674,"_31165":542,"_21590":52970,"_5":14857,"_28357":52611,"_3076":52971},[],"An installation without a principal matching your identity is left with nobody able to administer authorization. Configure the IdP and the bootstrap before exposing the platform.",{"_3624":675,"_31165":542,"_21590":52973,"_5":14857,"_28357":52611,"_3076":52974},[],"The chart includes a bootstrap principal that looks for the OIDC role `pki-admin` in `realm_access.roles`. It grants it `SUPER ADMIN` and, when Job Manager is enabled, the administrative policy of its NBI API.",{"_3624":676,"_31165":542,"_21590":52976,"_5":14857,"_28357":52611,"_3076":52977},[],"The pre-install and pre-upgrade Helm Job runs the `authz` migrations, preloads the policies and creates the bootstrap principals before the services start. If the principal already exists, it does not replace it: it only adds the configured grants that are still missing. You can keep the entry in `values.yaml` across upgrades.",{"_3624":677,"_31165":542,"_21590":52979,"_5":14857,"_28357":52614,"_3076":52980},[],"Create the role or group you will use to administer Lamassu. Assign it to at least two controlled human identities. If your provider does not use `realm_access.roles`, adapt the claim path in both the frontend and `auth_config.claims`.",{"_3624":678,"_31165":542,"_21590":52982,"_5":14857,"_28357":52618,"_3076":52983},[],"`authz` validates every token against `services.authz.jwkUrl`, which is fetched from the `authz` pod. The Gateway does not validate tokens itself: Lamassu services authorize each request through `authz`, and routes labeled `auth=external`, such as the Job Manager ones, are checked by the Gateway through `authz` when `auth.externalAuthorization` is enabled. The endpoint must serve the keys of the issuer configured in `auth.oidc.frontend.authority`.",{"_3624":679,"_31165":542,"_21590":52985,"_5":14857,"_28357":52618,"_3076":52986},[],"Releases upgraded from 3.8.0 must remove `auth.oidc.apiGateway` and `auth.authorization`, which the 4.0.0 chart rejects. See 3.8.0 to 4.0.0.",{"_3624":680,"_31165":542,"_21590":52988,"_5":14857,"_28357":52622,"_3076":52989},[],"Sign in with an identity holding `pki-admin`. Confirm it can access authorization administration and perform a non-destructive read operation.",{"_3624":681,"_31165":542,"_21590":52991,"_5":14857,"_28357":52626,"_3076":52992},[],"Use a second user without the role and confirm the same operation is denied. This test catches misread claims, overly broad policies and accidental `failOpen` configurations.",{"_3624":682,"_31165":542,"_21590":52994,"_5":14857,"_28357":52630,"_3076":52995},[],"Create operational principals with narrower policies. Reserve `pki-admin` for authorization administration and recovery, not for daily work.",{"_3624":683,"_31165":542,"_21590":52997,"_5":14857,"_28357":52634,"_3076":52998},[],"Fastlane installs a Keycloak realm for the lab and creates the user `lamassu` with the temporary password `lamassu`, the role `pki-admin` and a mandatory password change. Its bootstrap principal matches through `preferred_username=lamassu`.",{"_3624":684,"_31165":542,"_21590":53000,"_5":14857,"_28357":52634,"_3076":53001},[],"Change the password on first login. Do not reuse the Fastlane user, password or IdP as a production design.",{"_3624":685,"_31165":542,"_21590":53003,"_5":14857,"_28357":52638,"_3076":53004},[],"Avoid reproducing your company's internal structure with dozens of nearly identical policies. Start from the responsibilities that actually need access:",{"_3624":686,"_31165":542,"_21590":53006,"_5":14857,"_28357":52638,"_3076":53007},[],"**Authorization administration**: manages principals, policies and grants. It should belong to a small, separate group.",{"_3624":687,"_31165":542,"_21590":53009,"_5":14857,"_28357":52638,"_3076":53010},[],"**PKI operation**: administers CAs, profiles and certificates, but not necessarily who gets access.",{"_3624":688,"_31165":542,"_21590":53012,"_5":14857,"_28357":52638,"_3076":53013},[],"**Device registration**: operates devices and DMSs without receiving permissions over keys or authorization configuration.",{"_3624":689,"_31165":542,"_21590":53015,"_5":14857,"_28357":52638,"_3076":53016},[],"**Audit**: reviews configuration and activity without creating, modifying, signing, revoking or deleting.",{"_3624":690,"_31165":542,"_21590":53018,"_5":14857,"_28357":52638,"_3076":53019},[],"**Automation**: uses a technical account or a separate certificate, with permissions limited to the flow and resources it controls.",{"_3624":691,"_31165":542,"_21590":53021,"_5":14857,"_28357":52638,"_3076":53022},[],"For each role, separate \"view\" from \"change\", limit resources through grants, relations or attributes and avoid `*` unless the role must automatically cover future actions.",{"_3624":692,"_31165":542,"_21590":53024,"_5":14857,"_28357":52638,"_3076":53025},[],"A rule with `actions: [\"*\"]` expands to every action defined by the schema. When a new version adds an action, a wildcard policy may start granting it. Review these policies on every upgrade.",{"_3624":693,"_31165":542,"_21590":53027,"_5":14857,"_28357":52642,"_3076":53028},[],"To revoke access immediately, disable the principal or revoke its grants. Disabling a principal keeps its configuration and associations for investigation or restoration, but it stops taking part in matching.",{"_3624":694,"_31165":542,"_21590":53030,"_5":14857,"_28357":52642,"_3076":53031},[],"Deleting a role or group in the IdP prevents new tokens from containing the claim, but an already-issued token may remain valid until it expires. If removal is urgent, combine the IdP change with disabling the principal in Lamassu and revoking sessions or tokens at the provider.",{"_3624":695,"_31165":542,"_21590":53033,"_5":14857,"_28357":52642,"_3076":53034},[],"When you edit a shared policy, remember the change affects all its principals. To test a new scope, create a separate policy, grant it to a test identity and validate allowed and denied operations before replacing the old one.",{"_3624":696,"_31165":542,"_21590":53036,"_5":14857,"_28357":52646,"_3076":53037},[],"Keep `failOpen: false` unless a documented risk assessment justifies otherwise.",{"_3624":697,"_31165":542,"_21590":53039,"_5":14857,"_28357":52646,"_3076":53040},[],"Use groups or stable roles for people and independent identities for automations.",{"_3624":698,"_31165":542,"_21590":53042,"_5":14857,"_28357":52646,"_3076":53043},[],"Keep at least two recovery administrators and test their access periodically.",{"_3624":699,"_31165":542,"_21590":53045,"_5":14857,"_28357":52646,"_3076":53046},[],"Review active principals, their matches and their grants after IdP changes.",{"_3624":700,"_31165":542,"_21590":53048,"_5":14857,"_28357":52646,"_3076":53049},[],"Search for wildcards in policies before upgrading Lamassu.",{"_3624":701,"_31165":542,"_21590":53051,"_5":14857,"_28357":52646,"_3076":53052},[],"Review `skip_authz` routes and `default_action` settings in HTTP schemas when integrating or upgrading a service.",{"_3624":702,"_31165":542,"_21590":53054,"_5":14857,"_28357":52646,"_3076":53055},[],"Always test one allowed and one denied operation for each role.",{"_3624":703,"_31165":542,"_21590":53057,"_5":14857,"_28357":52646,"_3076":53058},[],"Correlate changes to principals, policies and grants with the audit logs.",{"_3624":704,"_31165":542,"_21590":53060,"_5":14857,"_28357":52654,"_3076":53061},[],"Authentication failed before permissions were evaluated. Check the JWT signature and expiration, issuer, audience and the availability of the JWKS configured in the Gateway. For X.509, check that the client certificate reaches the point that extracts the credential.",{"_3624":705,"_31165":542,"_21590":53063,"_5":14857,"_28357":52658,"_3076":53064},[],"The credential could be processed but did not produce a positive authorization. Review in this order:",{"_3624":706,"_31165":542,"_21590":53066,"_5":14857,"_28357":52658,"_3076":53067},[],"that an active principal of the correct type exists;",{"_3624":707,"_31165":542,"_21590":53069,"_5":14857,"_28357":52658,"_3076":53070},[],"that the claim paths and values match the real token exactly;",{"_3624":708,"_31165":542,"_21590":53072,"_5":14857,"_28357":52658,"_3076":53073},[],"that all of the principal's conditions hold;",{"_3624":709,"_31165":542,"_21590":53075,"_5":14857,"_28357":52658,"_3076":53076},[],"that the principal has the expected policy granted;",{"_3624":710,"_31165":542,"_21590":53078,"_5":14857,"_28357":52658,"_3076":53079},[],"that the policy includes the action and the requested resource type or route;",{"_3624":711,"_31165":542,"_21590":53081,"_5":14857,"_28357":52658,"_3076":53082},[],"that the identifier, relation, column filter or HTTP constraint includes the real resource.",{"_3624":712,"_31165":542,"_21590":53084,"_5":14857,"_28357":52658,"_3076":53085},[],"In the `authz` logs, an external endpoint decision includes `allowed`, `reason`, `matched_principals`, `evaluated_policy_ids`, `matched_policy_id` and the status code. These fields let you separate a matching failure from a permissions failure. With OpenTelemetry tracing enabled, a request that reaches the policy engine produces an `engine.CheckHTTPRequest` span whose attributes record `authz.allowed`, the matched policy and the matched principal. Correlation with the Gateway trace requires trace context to be propagated to authz.",{"_3624":713,"_31165":542,"_21590":53087,"_5":14857,"_28357":52658,"_3076":53088},[],"If a policy that relied on inherited access stopped granting it after an upgrade, look in the `authz` logs for `skipping relation that grants nothing`: the warning names the policy and the relation the schemas no longer declare. Correct that policy's relation so it matches the current schemas.",{"_3624":714,"_31165":542,"_21590":53090,"_5":14857,"_28357":52662,"_3076":53091},[],"Check that the bootstrap principal was created and that the policies were preloaded by the migration Job. Also verify that `services.authz.jwkUrl` is reachable from the `authz` pod; do not assume that a URL accessible from the browser also works inside the cluster.",{"_3624":715,"_31165":542,"_21590":53093,"_5":14857,"_28357":52666,"_3076":53094},[],"The path may be covered by a schema-level decision rather than by a policy: routes marked `skip_authz` allow any identity that matches an active principal, and a request under a `base_paths` prefix whose schema sets `default_action: allow` is likewise allowed without consulting policies. Confirm which of the two applies before looking for missing or misassigned grants.",{"_3624":716,"_31165":542,"_21590":53096,"_5":14857,"_28357":52670,"_3076":53097},[],"This is the expected behavior with `failOpen: false`. Restore the service, its PostgreSQL connection and its JWKS connectivity. Do not temporarily switch to `failOpen: true` without accepting that protected routes could become accessible without an authorization decision.",{"_3624":717,"_31165":542,"_21590":53099,"_5":14857,"_28357":52670,"_3076":53100},[],"Continue with Audit logs to investigate configuration changes or with Troubleshooting to diagnose the deployment.",{"_3624":718,"_31165":718,"_5":15217,"_3076":53102,"_31503":53103,"_21590":53104,"_28357":718},"Alerts and subscriptions",[50900,52412,52413],[],{"_3624":719,"_31165":718,"_21590":53106,"_5":14857,"_28357":718,"_3076":53107},[],"Send PKI events to people and external systems.",{"_3624":720,"_31165":718,"_5":31500,"_21590":53109,"_28357":53110,"_3076":53111},[],"/docs/platform/administration/alerts#how-it-works","How it works",{"_3624":721,"_31165":718,"_5":31500,"_21590":53113,"_28357":53114,"_3076":53115},[],"/docs/platform/administration/alerts#available-channels","Available channels",{"_3624":722,"_31165":718,"_5":31500,"_21590":53117,"_28357":53118,"_3076":53119},[],"/docs/platform/administration/alerts#create-a-subscription","Create a subscription",{"_3624":723,"_31165":718,"_5":31500,"_21590":53121,"_28357":53122,"_3076":53123},[],"/docs/platform/administration/alerts#choose-the-event","Choose the event",{"_3624":724,"_31165":718,"_5":31500,"_21590":53125,"_28357":53126,"_3076":53127},[],"/docs/platform/administration/alerts#configure-the-destination","Configure the destination",{"_3624":725,"_31165":718,"_5":31500,"_21590":53129,"_28357":53130,"_3076":53131},[],"/docs/platform/administration/alerts#limit-the-notifications","Limit the notifications",{"_3624":726,"_31165":718,"_5":31500,"_21590":53133,"_28357":53134,"_3076":53135},[],"/docs/platform/administration/alerts#review-and-activate","Review and activate",{"_3624":727,"_31165":718,"_5":31500,"_21590":53137,"_28357":53138,"_3076":53139},[],"/docs/platform/administration/alerts#configure-the-webhook-http-client","Configure the webhook HTTP client",{"_3624":728,"_31165":718,"_5":31500,"_21590":53141,"_28357":53142,"_3076":53143},[],"/docs/platform/administration/alerts#webhook-delivery-rules","Webhook delivery rules",{"_3624":729,"_31165":718,"_5":31500,"_21590":53145,"_28357":53146,"_3076":53147},[],"/docs/platform/administration/alerts#manage-a-subscription","Manage a subscription",{"_3624":730,"_31165":718,"_5":31500,"_21590":53149,"_28357":53150,"_3076":53151},[],"/docs/platform/administration/alerts#event-families","Event families",{"_3624":731,"_31165":718,"_21590":53153,"_5":14857,"_28357":718,"_3076":53154},[],"Subscriptions turn Lamassu events into actionable notifications. You can alert a team, feed an incident system or trigger an automation when a CA, certificate or device changes.",{"_3624":732,"_31165":718,"_21590":53156,"_5":14857,"_28357":53110,"_3076":53157},[],"A service publishes a domain event.",{"_3624":733,"_31165":718,"_21590":53159,"_5":14857,"_28357":53110,"_3076":53160},[],"Lamassu evaluates the subscriptions associated with that event type.",{"_3624":734,"_31165":718,"_21590":53162,"_5":14857,"_28357":53110,"_3076":53163},[],"Each subscription's filter decides whether it should be notified.",{"_3624":735,"_31165":718,"_21590":53165,"_5":14857,"_28357":53110,"_3076":53166},[],"Lamassu delivers the event to the configured channel.",{"_3624":736,"_31165":718,"_21590":53168,"_5":14857,"_28357":53110,"_3076":53169},[],"The event inventory shows when each type was last observed, how many times it has occurred and how many subscriptions it has. You can expand an event to inspect an example of its JSON payload before creating the filter.",{"_3624":737,"_31165":718,"_21590":53171,"_5":14857,"_28357":53114,"_3076":53172},[],"**Email** sends alerts to a person or an operational list. It only requires the destination address. Event content is rendered as HTML-escaped text, never as markup.",{"_3624":738,"_31165":718,"_21590":53174,"_5":14857,"_28357":53114,"_3076":53175},[],"**Microsoft Teams** posts the notification to a channel through its webhook URL.",{"_3624":739,"_31165":718,"_21590":53177,"_5":14857,"_28357":53114,"_3076":53178},[],"**Webhook** delivers the event to an automation, SIEM or incident system via `POST` or `PUT`.",{"_3624":740,"_31165":718,"_21590":53180,"_5":14857,"_28357":53114,"_3076":53181},[],"The Microsoft Teams and Webhook channels accept an optional `http_client` block that authenticates the call to the receiver. `auth_mode` selects `noauth` (the default), `apikey`, `jwt` or `mtls`; each mode requires its own options:",{"_3624":741,"_31165":718,"_21590":53183,"_5":14857,"_28357":53114,"_3076":53184},[],"`apikey_options` requires `header` and `key`.",{"_3624":742,"_31165":718,"_21590":53186,"_5":14857,"_28357":53114,"_3076":53187},[],"`jwt_options` requires `oidc_client_id`, `oidc_client_secret` and an absolute `http` or `https` `oidc_well_known`.",{"_3624":743,"_31165":718,"_21590":53189,"_5":14857,"_28357":53114,"_3076":53190},[],"`mtls_options` requires `cert_content` and `key_content` as Base64-encoded PEM, like certificates elsewhere in the API; plain PEM is also accepted. Values that reference files on the server are rejected, and the pair must decode to a matching certificate and private key.",{"_3624":744,"_31165":718,"_21590":53192,"_5":14857,"_28357":53114,"_3076":53193},[],"The alerts API reference documents the full `http_client` schema.",{"_3624":745,"_31165":718,"_21590":53195,"_5":14857,"_28357":53122,"_3076":53196},[],"Open **Alerts**, locate the event type and select **Subscribe**. Review the latest JSON example to identify the fields you will need to filter on.",{"_3624":746,"_31165":718,"_21590":53198,"_5":14857,"_28357":53126,"_3076":53199},[],"Select Email, Microsoft Teams or Webhook and enter the channel details.",{"_3624":747,"_31165":718,"_21590":53201,"_5":14857,"_28357":53130,"_3076":53202},[],"Add a filter if you don't want to receive every instance of the event.",{"_3624":748,"_31165":718,"_21590":53204,"_5":14857,"_28357":53130,"_3076":53205},[],"**None** notifies all instances of the event.",{"_3624":749,"_31165":718,"_21590":53207,"_5":14857,"_28357":53130,"_3076":53208},[],"**JSON Path** evaluates one or more specific fields.",{"_3624":750,"_31165":718,"_21590":53210,"_5":14857,"_28357":53130,"_3076":53211},[],"**JSON Schema** accepts only payloads with a particular structure.",{"_3624":751,"_31165":718,"_21590":53213,"_5":14857,"_28357":53130,"_3076":53214},[],"**JavaScript** lets you express custom logic. Each filter runs for at most 100 milliseconds; a filter that exceeds this limit fails the condition and the notification is skipped with the error `javascript filter execution timed out`.",{"_3624":752,"_31165":718,"_21590":53216,"_5":14857,"_28357":53130,"_3076":53217},[],"For example, `function (event) { return event.data.status == \"NO_IDENTITY\"; }` limits a subscription to devices without an identity.",{"_3624":753,"_31165":718,"_21590":53219,"_5":14857,"_28357":53130,"_3076":53220},[],"The console evaluates the filter against the JSON shown in the **Input Event** editor, which is prefilled with the latest event, and reports whether it matches. For JSON Path and JavaScript filters, it shows **The filter matches this Cloud Event** or **The filter does not match this Cloud Event**. JSON Path expressions are evaluated against the full Cloud Event, so the default `$.data` selects the event's `data` field, and the expression must start with `$`.",{"_3624":754,"_31165":718,"_21590":53222,"_5":14857,"_28357":53134,"_3076":53223},[],"Check the event, channel and filter in the summary. Select **Confirm Subscription** to start delivery.",{"_3624":755,"_31165":718,"_21590":53225,"_5":14857,"_28357":53138,"_3076":53226},[],"The Webhook and Microsoft Teams channels show this configuration in the subscribe form, at the channel step, and again when editing a subscription; Email does not use it. The fields map to the optional `http_client` block described above:",{"_3624":756,"_31165":718,"_21590":53228,"_5":14857,"_28357":53138,"_3076":53229},[],"**Log Level** selects `debug`, `info`, `warn` or `error`; `info` is the default.",{"_3624":757,"_31165":718,"_21590":53231,"_5":14857,"_28357":53138,"_3076":53232},[],"**Call Timeout** defaults to 10 seconds. The console rejects a value above 30 seconds with `Webhook timeout must be at most 30s.`; the API clamps the same value to the cap instead (see Calls are bounded).",{"_3624":758,"_31165":718,"_21590":53234,"_5":14857,"_28357":53138,"_3076":53235},[],"There is no TLS-verification switch for these channels, because the service always verifies the receiver certificate (see TLS is always verified).",{"_3624":759,"_31165":718,"_21590":53237,"_5":14857,"_28357":53138,"_3076":53238},[],"**HTTP Authentication** selects `No Authentication` (the default), `API Key` (API key value and Header Name, `X-API-Key` by default), `OIDC Client Credentials` (Client ID, Client Secret and Well-Known URL) or `Mutual TLS` (Client Certificate and Client Private Key pasted as PEM). A stored private key stays hidden until you select **Show**.",{"_3624":760,"_31165":718,"_21590":53240,"_5":14857,"_28357":53138,"_3076":53241},[],"A `http://` URL shows the console warning `Unencrypted HTTP connection` (see the Credentials over http\\:// callout below).",{"_3624":761,"_31165":718,"_21590":53243,"_5":14857,"_28357":53138,"_3076":53244},[],"The form validates inline against the same delivery rules: the webhook URL and the OIDC Well-Known URL must be absolute `http` or `https` URLs, an API-key header may not use a reserved name, and the mTLS certificate and key must be PEM content, not file paths.",{"_3624":762,"_31165":718,"_21590":53246,"_5":14857,"_28357":53138,"_3076":53247},[],"The summary in the Confirm step shows the authentication as `None`, `OIDC client credentials`, `API key` or `Mutual TLS`. The subscription details show the authentication, the API key header name (never the value), the OIDC issuer URL, mTLS as `Configured` and a fixed `TLS verification: Verified` row. The API key, client secret and private key are not shown in the subscription details.",{"_3624":763,"_31165":718,"_21590":53249,"_5":14857,"_28357":53142,"_3076":53250},[],"Notifications delivered through the Microsoft Teams and Webhook channels follow a fixed HTTP policy:",{"_3624":764,"_31165":718,"_21590":53252,"_5":14857,"_28357":53142,"_3076":53253},[],"**TLS is always verified.** The receiver certificate is checked against the system trust store. `insecure_skip_verify` is enforced as `false` — including when it is set to `true` — so self-signed or otherwise untrusted receivers fail delivery.",{"_3624":765,"_31165":718,"_21590":53255,"_5":14857,"_28357":53142,"_3076":53256},[],"**Redirects are not followed.** A `3xx` response fails with `unexpected status code: <n>: redirects are not followed`. Configure `webhook_url` with the final absolute `http` or `https` URL: an `http://` address that an ingress redirects to `https://` stops working.",{"_3624":766,"_31165":718,"_21590":53258,"_5":14857,"_28357":53142,"_3076":53259},[],"**Calls are bounded.** A call defaults to a 10 second timeout; a configured `call_timeout` is capped at 30 seconds. Values above the cap are clamped, not rejected.",{"_3624":767,"_31165":718,"_21590":53261,"_5":14857,"_28357":53142,"_3076":53262},[],"**The response body is ignored.** Delivery checks the status code only, so the receiver may answer with any body.",{"_3624":768,"_31165":718,"_21590":53264,"_5":14857,"_28357":53142,"_3076":53265},[],"**API-key headers are restricted.** A custom `apikey_options.header` may not use names that the platform or receiving services trust — for example `X-Principal-Id`, `X-Request-Id`, `Host`, `Content-Type` or `Forwarded` — and no name may start with `X-Forwarded-`, `X-Envoy-` or `X-Lms-`. Comparisons are case-insensitive.",{"_3624":769,"_31165":718,"_21590":53267,"_5":14857,"_28357":53142,"_3076":53268},[],"**Invalid configurations are rejected at subscribe time.** A channel configuration that would fail on every delivery returns HTTP 400 with a body that starts with `struct validation error:`, and the subscription is not created.",{"_3624":770,"_31165":718,"_21590":53270,"_5":14857,"_28357":53142,"_3076":53271},[],"Credentials are sent regardless of the URL scheme. With an `http://` `webhook_url`, the API key or bearer token travels in cleartext and mTLS has no effect. Prefer `https://` for `webhook_url`, `oidc_well_known` and the token endpoint it advertises.",{"_3624":771,"_31165":718,"_21590":53273,"_5":14857,"_28357":53146,"_3076":53274},[],"Open an existing subscription to review its destination and filter, modify the configuration or select **Unsubscribe**. Remove subscriptions that no longer have an operational owner to avoid ignored deliveries or stale endpoints.",{"_3624":772,"_31165":718,"_21590":53276,"_5":14857,"_28357":53146,"_3076":53277},[],"Subscriptions created with older console versions may store the webhook target under `url` and `method` instead of `webhook_url` and `webhook_method`. The service delivers only through `webhook_url` and `webhook_method`, so such a subscription does not deliver even though the subscription details show the stored target. Open the subscription and save it again: the edit form prefills the stored target, and saving rewrites the channel configuration in the current layout.",{"_3624":773,"_31165":718,"_21590":53279,"_5":14857,"_28357":53150,"_3076":53280},[],"**Authorities:** `ca.create`, `ca.import`, `ca.reissue` and `ca.delete`.",{"_3624":774,"_31165":718,"_21590":53282,"_5":14857,"_28357":53150,"_3076":53283},[],"**Certificates:** `ca.sign.certificate` and `certificate.delete`.",{"_3624":775,"_31165":718,"_21590":53285,"_5":14857,"_28357":53150,"_3076":53286},[],"**Profiles:** `profile.issuance.create`, `profile.issuance.update` and `profile.issuance.delete`.",{"_3624":776,"_31165":718,"_21590":53288,"_5":14857,"_28357":53150,"_3076":53289},[],"**Enrollment:** `dms.create`, `dms.update`, `dms.enroll` and `dms.reenroll`.",{"_3624":777,"_31165":718,"_21590":53291,"_5":14857,"_28357":53150,"_3076":53292},[],"**Devices:** `device.create`, `device.identity.update` and `device.status.update`.",{"_3624":778,"_31165":718,"_21590":53294,"_5":14857,"_28357":53150,"_3076":53295},[],"**Validation:** `va.role.crl.create`, `va.crl-settings.init`, `va.crl-settings.update`, `va.crl-settings.finalize`, `va.crl-settings.archive` and `va.crl-settings.delete`.",{"_3624":779,"_31165":718,"_21590":53297,"_5":14857,"_28357":53150,"_3076":53298},[],"**Keys:** `kms.create`, `kms.import`, `kms.sign` and `kms.delete`.",{"_3624":780,"_31165":718,"_21590":53300,"_5":14857,"_28357":53150,"_3076":53301},[],"Use the catalog shown in the console as the source for the types available in your deployed version.",{"_3624":781,"_31165":718,"_21590":53303,"_5":14857,"_28357":53150,"_3076":53304},[],"Since 4.0.0, `va.crl-settings.init` and `va.crl-settings.update` carry the CRL settings of a CA (`ca_id`) and replace `va.role.crl.init` and `va.role.update`. The upgrade migration renames the types of existing subscriptions automatically, but it does not rewrite their conditions: review filters that read the old payload or the old `crl/<ski>` subject, including filters for `va.role.crl.create` (see 3.8.0 to 4.0.0).",{"_3624":782,"_31165":718,"_21590":53306,"_5":14857,"_28357":53150,"_3076":53307},[],"The VA also publishes `va.crl-settings.finalize` when a CA is revoked permanently or expires, `va.crl-settings.archive` when the CA is deleted, and `va.crl-settings.delete` when archived settings are removed.",{"_3624":783,"_31165":783,"_5":15217,"_3076":53309,"_31503":53310,"_21590":53311,"_28357":783},"Audit logs",[50900,52412,52413],[],{"_3624":784,"_31165":783,"_21590":53313,"_5":14857,"_28357":783,"_3076":53314},[],"Understand which audit events Lamassu generates and how to turn them into a durable trail.",{"_3624":785,"_31165":783,"_5":31500,"_21590":53316,"_28357":53317,"_3076":53318},[],"/docs/platform/administration/audit-logs#what-an-event-contains","What an event contains",{"_3624":786,"_31165":783,"_5":31500,"_21590":53320,"_28357":53321,"_3076":53322},[],"/docs/platform/administration/audit-logs#coverage","Coverage",{"_3624":787,"_31165":783,"_5":31500,"_21590":53324,"_28357":53325,"_3076":53326},[],"/docs/platform/administration/audit-logs#publication-and-persistence","Publication and persistence",{"_3624":788,"_31165":783,"_5":31500,"_21590":53328,"_28357":53329,"_3076":53330},[],"/docs/platform/administration/audit-logs#sensitive-data","Sensitive data",{"_3624":789,"_31165":783,"_5":31500,"_21590":53332,"_28357":53333,"_3076":53334},[],"/docs/platform/administration/audit-logs#a-reproducible-investigation","A reproducible investigation",{"_3624":790,"_31165":783,"_5":31500,"_21590":53336,"_28357":53337,"_3076":53338},[],"/docs/platform/administration/audit-logs#bound-the-interval","Bound the interval",{"_3624":791,"_31165":783,"_5":31500,"_21590":53340,"_28357":53341,"_3076":53342},[],"/docs/platform/administration/audit-logs#identify-the-operation","Identify the operation",{"_3624":792,"_31165":783,"_5":31500,"_21590":53344,"_28357":53345,"_3076":53346},[],"/docs/platform/administration/audit-logs#attribute-the-principal","Attribute the principal",{"_3624":793,"_31165":783,"_5":31500,"_21590":53348,"_28357":53349,"_3076":53350},[],"/docs/platform/administration/audit-logs#compare-intent-and-result","Compare intent and result",{"_3624":794,"_31165":783,"_5":31500,"_21590":53352,"_28357":53353,"_3076":53354},[],"/docs/platform/administration/audit-logs#follow-the-effect","Follow the effect",{"_3624":795,"_31165":783,"_5":31500,"_21590":53356,"_28357":53357,"_3076":53358},[],"/docs/platform/administration/audit-logs#periodic-verification","Periodic verification",{"_3624":796,"_31165":783,"_21590":53360,"_5":14857,"_28357":783,"_3076":53361},[],"Lamassu instruments the mutable operations of its services with audit events. Each event describes the operation, the principals that matched, the input, the result and whether it ended in error.",{"_3624":797,"_31165":783,"_21590":53363,"_5":14857,"_28357":53317,"_3076":53364},[],"The audit body includes:",{"_3624":798,"_31165":783,"_21590":53366,"_5":14857,"_28357":53317,"_3076":53367},[],"input: data received by the operation;",{"_3624":799,"_31165":783,"_21590":53369,"_5":14857,"_28357":53317,"_3076":53370},[],"has\\_error: whether the service returned an error;",{"_3624":800,"_31165":783,"_21590":53372,"_5":14857,"_28357":53317,"_3076":53373},[],"output: produced result or error message;",{"_3624":801,"_31165":783,"_21590":53375,"_5":14857,"_28357":53317,"_3076":53376},[],"principals: identifiers of the principals that matched the request.",{"_3624":802,"_31165":783,"_21590":53378,"_5":14857,"_28357":53317,"_3076":53379},[],"Successful operations use a type prefixed with audit.. Failures publish the operation type suffixed with .error. The CloudEvents event additionally adds source, identifier, date and type.",{"_3624":803,"_31165":783,"_21590":53381,"_5":14857,"_28357":53317,"_3076":53382},[],"The middlewares publish the record after executing the operation, whether it succeeded or returned an error. This lets you investigate attempts as well as confirmed changes.",{"_3624":804,"_31165":783,"_21590":53384,"_5":14857,"_28357":53321,"_3076":53385},[],"The backend applies auditing to mutations of:",{"_3624":805,"_31165":783,"_21590":53387,"_5":14857,"_28357":53321,"_3076":53388},[],"authorities, certificates and issuance profiles;",{"_3624":806,"_31165":783,"_21590":53390,"_5":14857,"_28357":53321,"_3076":53391},[],"keys and KMS engines;",{"_3624":807,"_31165":783,"_21590":53393,"_5":14857,"_28357":53321,"_3076":53394},[],"devices and identities;",{"_3624":808,"_31165":783,"_21590":53396,"_5":14857,"_28357":53321,"_3076":53397},[],"DMSs and enrollment operations;",{"_3624":809,"_31165":783,"_21590":53399,"_5":14857,"_28357":53321,"_3076":53400},[],"validation functions and CRL;",{"_3624":810,"_31165":783,"_21590":53402,"_5":14857,"_28357":53321,"_3076":53403},[],"principals, policies and authorization grants.",{"_3624":811,"_31165":783,"_21590":53405,"_5":14857,"_28357":53321,"_3076":53406},[],"Do not confuse these events with domain events. A domain event announces that a resource changed so another component can react; the audit event keeps input, output and principal context for investigation.",{"_3624":812,"_31165":783,"_21590":53408,"_5":14857,"_28357":53325,"_3076":53409},[],"Services publish audit records to the event bus when their PublisherEventBus is enabled. The backend code does not, by itself, implement a queryable, durable audit file.",{"_3624":813,"_31165":783,"_21590":53411,"_5":14857,"_28357":53325,"_3076":53412},[],"If you need retention, search, tamper protection or regulatory export, connect a consumer that persists the events into the system approved by your organization.",{"_3624":814,"_31165":783,"_21590":53414,"_5":14857,"_28357":53325,"_3076":53415},[],"Design the consumer to:",{"_3624":815,"_31165":783,"_21590":53417,"_5":14857,"_28357":53325,"_3076":53418},[],"subscribe to the audit.# types and also to operation types ending in .error;",{"_3624":816,"_31165":783,"_21590":53420,"_5":14857,"_28357":53325,"_3076":53421},[],"keep the complete CloudEvent unmodified;",{"_3624":817,"_31165":783,"_21590":53423,"_5":14857,"_28357":53325,"_3076":53424},[],"record the ingestion time and detect duplicates by ID;",{"_3624":818,"_31165":783,"_21590":53426,"_5":14857,"_28357":53325,"_3076":53427},[],"encrypt in transit and at rest;",{"_3624":819,"_31165":783,"_21590":53429,"_5":14857,"_28357":53325,"_3076":53430},[],"restrict reading and deletion to a role separate from the PKI operator;",{"_3624":820,"_31165":783,"_21590":53432,"_5":14857,"_28357":53325,"_3076":53433},[],"apply an explicit retention and legal hold policy;",{"_3624":821,"_31165":783,"_21590":53435,"_5":14857,"_28357":53325,"_3076":53436},[],"alert if it stops consuming or the pending queue grows.",{"_3624":822,"_31165":783,"_21590":53438,"_5":14857,"_28357":53329,"_3076":53439},[],"The input and output fields can contain subjects, metadata, public material, configuration or error messages. Evaluate their classification before sending them to an external platform.",{"_3624":823,"_31165":783,"_21590":53441,"_5":14857,"_28357":53329,"_3076":53442},[],"Do not log private keys, provider secrets or full tokens in automations around Lamassu. Restrict export and apply redaction at the destination without destroying the fields needed for attribution.",{"_3624":824,"_31165":783,"_21590":53444,"_5":14857,"_28357":53337,"_3076":53445},[],"Start from the reported time and normalize every source to UTC.",{"_3624":825,"_31165":783,"_21590":53447,"_5":14857,"_28357":53341,"_3076":53448},[],"Filter by event type, service source and resource identifier.",{"_3624":826,"_31165":783,"_21590":53450,"_5":14857,"_28357":53345,"_3076":53451},[],"Review principals and correlate them with the OIDC provider or the X.509 identity valid at that moment.",{"_3624":827,"_31165":783,"_21590":53453,"_5":14857,"_28357":53349,"_3076":53454},[],"Contrast input, has\\_error and output. A failed attempt does not mean the resource changed.",{"_3624":828,"_31165":783,"_21590":53456,"_5":14857,"_28357":53353,"_3076":53457},[],"Look for the domain events and service records that share resource and time window. In a CA revocation, include the cascading operations.",{"_3624":829,"_31165":783,"_21590":53459,"_5":14857,"_28357":53357,"_3076":53460},[],"Generate a controlled mutation in a test environment and check that:",{"_3624":830,"_31165":783,"_21590":53462,"_5":14857,"_28357":53357,"_3076":53463},[],"a successful audit event appears;",{"_3624":831,"_31165":783,"_21590":53465,"_5":14857,"_28357":53357,"_3076":53466},[],"the principal matches the identity used;",{"_3624":832,"_31165":783,"_21590":53468,"_5":14857,"_28357":53357,"_3076":53469},[],"the consumer persists it exactly once;",{"_3624":833,"_31165":783,"_21590":53471,"_5":14857,"_28357":53357,"_3076":53472},[],"it can be retrieved by resource, actor and period;",{"_3624":834,"_31165":783,"_21590":53474,"_5":14857,"_28357":53357,"_3076":53475},[],"a consumer outage raises an alert.",{"_3624":835,"_31165":783,"_21590":53477,"_5":14857,"_28357":53357,"_3076":53478},[],"For metrics, traces and technical logs of the deployment, see Troubleshooting. Audit answers \"who tried to change what\"; observability explains how the system behaved.",{"_3624":836,"_31165":836,"_5":15217,"_3076":53480,"_31503":53481,"_21590":53482,"_28357":836},"Platform architecture",[50900,52412],[],{"_3624":837,"_31165":836,"_21590":53484,"_5":14857,"_28357":836,"_3076":53485},[],"Lamassu components and how control, keys, issuance and devices relate.",{"_3624":838,"_31165":836,"_5":31500,"_21590":53487,"_28357":53488,"_3076":53489},[],"/docs/platform/concepts/architecture#control-plane","Control plane",{"_3624":839,"_31165":836,"_5":31500,"_21590":53491,"_28357":53492,"_3076":53493},[],"/docs/platform/concepts/architecture#key-custody-and-cryptographic-operations","Key custody and cryptographic operations",{"_3624":840,"_31165":836,"_5":31500,"_21590":53495,"_28357":53496,"_3076":53497},[],"/docs/platform/concepts/architecture#issuance-and-enrollment","Issuance and enrollment",{"_3624":841,"_31165":836,"_5":31500,"_21590":53499,"_28357":53500,"_3076":53501},[],"/docs/platform/concepts/architecture#status-and-validation","Status and validation",{"_3624":842,"_31165":836,"_5":31500,"_21590":53503,"_28357":53504,"_3076":53505},[],"/docs/platform/concepts/architecture#platform-dependencies","Platform dependencies",{"_3624":843,"_31165":836,"_21590":53507,"_5":14857,"_28357":836,"_3076":53508},[],"Lamassu deploys as a set of independent services. This separation keeps every component from needing direct access to private keys and lets each capability scale according to load.",{"_3624":844,"_31165":836,"_21590":53510,"_5":14857,"_28357":836,"_3076":53511},[],"Switch to the low level to see the internals of the Lamassu platform box (CA, KMS, DMS, Device Manager, VA, Alerts, AWS IoT connector, Job Manager and the console/API), and to medium to see it as a single platform alongside its external dependencies.",{"_3624":845,"_31165":836,"_21590":53513,"_5":14857,"_28357":53488,"_3076":53514},[],"The console and the APIs manage authorities, certificates, DMSs, devices, alerts and configuration. Domain events allow connectors and automations to react to changes without continuously polling the platform.",{"_3624":846,"_31165":836,"_21590":53516,"_5":14857,"_28357":53492,"_3076":53517},[],"The KMS offers a common interface over software engines, PKCS#11 and cloud providers. The selected engine keeps the key or delegates the cryptographic operation without the other services knowing its implementation.",{"_3624":847,"_31165":836,"_21590":53519,"_5":14857,"_28357":53496,"_3076":53520},[],"The CA service issues certificates and maintains the relationship with its authority. The DMS applies the enrollment rules and exposes the EST flows so a device can request or renew an identity.",{"_3624":848,"_31165":836,"_21590":53522,"_5":14857,"_28357":53500,"_3076":53523},[],"Device Manager keeps the operational view of the device and its history. The Validation Authority publishes OCSP and CRLs so other systems can decide whether to trust a presented certificate.",{"_3624":849,"_31165":836,"_21590":53525,"_5":14857,"_28357":53504,"_3076":53526},[],"In a self-managed deployment, Lamassu uses PostgreSQL for persistence, RabbitMQ for messaging and an OIDC provider for authentication. See the deployment architecture for how the services are published on Kubernetes.",{"_3624":850,"_31165":850,"_5":15217,"_3076":53528,"_31503":53529,"_21590":53530,"_28357":850},"How Lamassu works",[50900,52412],[],{"_3624":851,"_31165":850,"_21590":53532,"_5":14857,"_28357":850,"_3076":53533},[],"The mental model of trust, keys, certificates and devices.",{"_3624":852,"_31165":850,"_5":31500,"_21590":53535,"_28357":53536,"_3076":53537},[],"/docs/platform/concepts/overview#the-model-in-five-pieces","The model in five pieces",{"_3624":853,"_31165":850,"_5":31500,"_21590":53539,"_28357":53540,"_3076":53541},[],"/docs/platform/concepts/overview#from-onboarding-to-operation","From onboarding to operation",{"_3624":854,"_31165":850,"_21590":53543,"_5":14857,"_28357":850,"_3076":53544},[],"Lamassu connects three elements: a **root of trust**, an **issuance policy** and an **entity that needs to prove its identity**. The platform coordinates these elements throughout the certificate lifecycle.",{"_3624":855,"_31165":850,"_21590":53546,"_5":14857,"_28357":53536,"_3076":53547},[],"**Cryptographic engine.** Generates or safeguards keys and executes private-key operations without exposing key material to the rest of the services.",{"_3624":856,"_31165":850,"_21590":53549,"_5":14857,"_28357":53536,"_3076":53550},[],"**Certification Authority (CA).** Signs certificates and establishes the chain of trust.",{"_3624":857,"_31165":850,"_21590":53552,"_5":14857,"_28357":53536,"_3076":53553},[],"**Device Management Service (DMS).** Defines how the devices of a fleet are registered, authenticated and renewed.",{"_3624":858,"_31165":850,"_21590":53555,"_5":14857,"_28357":53536,"_3076":53556},[],"**Device.** Keeps its private key and presents the certificate to prove its identity.",{"_3624":859,"_31165":850,"_21590":53558,"_5":14857,"_28357":53536,"_3076":53559},[],"**Validation Authority (VA).** Publishes the status of certificates through OCSP and CRL.",{"_3624":860,"_31165":850,"_21590":53561,"_5":14857,"_28357":53540,"_3076":53562},[],"An administrator configures a cryptographic engine and creates or imports a CA.",{"_3624":861,"_31165":850,"_21590":53564,"_5":14857,"_28357":53540,"_3076":53565},[],"A DMS relates that CA to an enrollment policy.",{"_3624":862,"_31165":850,"_21590":53567,"_5":14857,"_28357":53540,"_3076":53568},[],"The device generates a key and requests a certificate through EST, or an operator assigns it an identity.",{"_3624":863,"_31165":850,"_21590":53570,"_5":14857,"_28357":53540,"_3076":53571},[],"Lamassu keeps the inventory, history and status of the identity.",{"_3624":864,"_31165":850,"_21590":53573,"_5":14857,"_28357":53540,"_3076":53574},[],"Consumers check the chain and query OCSP or a CRL when they need to know whether it is still valid.",{"_3624":865,"_31165":850,"_21590":53576,"_5":14857,"_28357":53540,"_3076":53577},[],"<Card title=\"Architecture\" description=\"Get to know the components and where each one's responsibility ends.\" href=\"/docs/platform/concepts/architecture\" />",{"_3624":866,"_31165":850,"_21590":53579,"_5":14857,"_28357":53540,"_3076":53580},[],"<Card title=\"Identity lifecycle\" description=\"Follow a certificate from enrollment to renewal or revocation.\" href=\"/docs/platform/pki/concepts/certificate-lifecycle\" />",{"_3624":867,"_31165":867,"_5":15217,"_3076":53582,"_31503":53583,"_21590":53585,"_28357":867},"Devices and identities",[50900,52412,53584,53582],"IoT Fleets",[],{"_3624":868,"_31165":867,"_21590":53587,"_5":14857,"_28357":867,"_3076":53588},[],"Register, inspect and retire devices while checking their current identity and history.",{"_3624":869,"_31165":867,"_5":31500,"_21590":53590,"_28357":53591,"_3076":53592},[],"/docs/platform/iot-fleets/device-management#device-states","Device states",{"_3624":870,"_31165":867,"_5":31500,"_21590":53594,"_28357":53595,"_3076":53596},[],"/docs/platform/iot-fleets/device-management#inspect-a-device","Inspect a device",{"_3624":871,"_31165":867,"_5":31500,"_21590":53598,"_28357":53599,"_3076":53600},[],"/docs/platform/iot-fleets/device-management#register-a-device-manually","Register a device manually",{"_3624":872,"_31165":867,"_5":31500,"_21590":53602,"_28357":53603,"_3076":53604},[],"/docs/platform/iot-fleets/device-management#create-the-device","Create the device",{"_3624":873,"_31165":867,"_5":31500,"_21590":53606,"_28357":53607,"_3076":53608},[],"/docs/platform/iot-fleets/device-management#define-its-membership","Define its membership",{"_3624":874,"_31165":867,"_5":31500,"_21590":53610,"_28357":53611,"_3076":53612},[],"/docs/platform/iot-fleets/device-management#classify-the-device","Classify the device",{"_3624":875,"_31165":867,"_5":31500,"_21590":53614,"_28357":53615,"_3076":53616},[],"/docs/platform/iot-fleets/device-management#verify-the-registration","Verify the registration",{"_3624":876,"_31165":867,"_5":31500,"_21590":53618,"_28357":53619,"_3076":53620},[],"/docs/platform/iot-fleets/device-management#assign-an-identity-manually","Assign an identity manually",{"_3624":877,"_31165":867,"_5":31500,"_21590":53622,"_28357":53623,"_3076":53624},[],"/docs/platform/iot-fleets/device-management#revoke-the-current-identity","Revoke the current identity",{"_3624":878,"_31165":867,"_5":31500,"_21590":53626,"_28357":53627,"_3076":53628},[],"/docs/platform/iot-fleets/device-management#decommission-a-device","Decommission a device",{"_3624":879,"_31165":867,"_5":31500,"_21590":53630,"_28357":53631,"_3076":53632},[],"/docs/platform/iot-fleets/device-management#automate-enrollment","Automate enrollment",{"_3624":880,"_31165":867,"_21590":53634,"_5":14857,"_28357":867,"_3076":53635},[],"This guide is for a fleet operator. You need device, DMS and certificate permissions for the intended actions. A fleet is organized through these resources, tags and metadata; there is no separate “fleet” object to create.",{"_3624":881,"_31165":867,"_21590":53637,"_5":14857,"_28357":867,"_3076":53638},[],"Each device has a `Device ID`, one owning DMS (`dms_owner`) and, once provisioned, an identity slot with an active version and previous versions. In these flows, keep the CSR and certificate `Common Name` equal to `Device ID`: binding uses that CN to update the device.",{"_3624":882,"_31165":867,"_21590":53640,"_5":14857,"_28357":53591,"_3076":53641},[],"Operational view",{"_3624":883,"_31165":867,"_21590":53643,"_5":14857,"_28357":53591,"_3076":53644},[],"Meaning",{"_3624":884,"_31165":867,"_21590":53646,"_5":14857,"_28357":53591,"_3076":53647},[],"**No Identity**",{"_3624":885,"_31165":867,"_21590":53649,"_5":14857,"_28357":53591,"_3076":53650},[],"A record exists without an associated identity.",{"_3624":886,"_31165":867,"_21590":53652,"_5":14857,"_28357":53591,"_3076":53653},[],"**Active**",{"_3624":887,"_31165":867,"_21590":53655,"_5":14857,"_28357":53591,"_3076":53656},[],"The slot is active; also check certificate dates, status and usages.",{"_3624":888,"_31165":867,"_21590":53658,"_5":14857,"_28357":53591,"_3076":53659},[],"**Renewal Pending**",{"_3624":889,"_31165":867,"_21590":53661,"_5":14857,"_28357":53591,"_3076":53662},[],"The identity is in the operational renewal window.",{"_3624":890,"_31165":867,"_21590":53664,"_5":14857,"_28357":53591,"_3076":53665},[],"**Expiring Soon**",{"_3624":891,"_31165":867,"_21590":53667,"_5":14857,"_28357":53591,"_3076":53668},[],"Expiration is approaching according to configured thresholds.",{"_3624":892,"_31165":867,"_21590":53670,"_5":14857,"_28357":53591,"_3076":53671},[],"**Expired**",{"_3624":893,"_31165":867,"_21590":53673,"_5":14857,"_28357":53591,"_3076":53674},[],"The identity has expired.",{"_3624":894,"_31165":867,"_21590":53676,"_5":14857,"_28357":53591,"_3076":53677},[],"**Revoked**",{"_3624":895,"_31165":867,"_21590":53679,"_5":14857,"_28357":53591,"_3076":53680},[],"The identity is marked revoked. A hold cascaded from its CA shows here and is lifted when that CA is released.",{"_3624":896,"_31165":867,"_21590":53682,"_5":14857,"_28357":53591,"_3076":53683},[],"**Decommissioned**",{"_3624":897,"_31165":867,"_21590":53685,"_5":14857,"_28357":53591,"_3076":53686},[],"The record is retired and ordinary updates do not restore operation.",{"_3624":898,"_31165":867,"_21590":53688,"_5":14857,"_28357":53591,"_3076":53689},[],"Device, slot and certificate states are distinct. Events and jobs can update the view after saving a certificate; an **Active** label does not establish consumer acceptance.",{"_3624":899,"_31165":867,"_21590":53691,"_5":14857,"_28357":53595,"_3076":53692},[],"Filter the inventory by ID, tags and status. Open details and record the owning DMS, active version and current certificate serial.",{"_3624":900,"_31165":867,"_21590":53694,"_5":14857,"_28357":53595,"_3076":53695},[],"**Certificate History** relates previous and current versions. Replacing the slot does not by itself revoke every previous version.",{"_3624":901,"_31165":867,"_21590":53697,"_5":14857,"_28357":53595,"_3076":53698},[],"**Device Event Timeline** helps reconstruct registration, provisioning, renewal and status changes. A change may be saved even if event persistence fails; also inspect the record and certificates.",{"_3624":902,"_31165":867,"_21590":53700,"_5":14857,"_28357":53595,"_3076":53701},[],"Compare these values with the identity installed on the device. Updating a Lamassu slot does not install files on the remote equipment.",{"_3624":903,"_31165":867,"_21590":53703,"_5":14857,"_28357":53599,"_3076":53704},[],"Use this flow to prepare inventory or assign an identity through the console. You need an existing DMS.",{"_3624":904,"_31165":867,"_21590":53706,"_5":14857,"_28357":53603,"_3076":53707},[],"Open registration in **Managed Devices**. Confirm the ID does not already exist in another DMS: ID lookup is not restricted to a fleet.",{"_3624":905,"_31165":867,"_21590":53709,"_5":14857,"_28357":53607,"_3076":53710},[],"Enter **Device ID** and select its owning DMS. The console’s **Registration Authority** label refers to that DMS.",{"_3624":906,"_31165":867,"_21590":53712,"_5":14857,"_28357":53611,"_3076":53713},[],"Add model, environment or location tags and an icon according to your inventory.",{"_3624":907,"_31165":867,"_21590":53715,"_5":14857,"_28357":53615,"_3076":53716},[],"Read the device again: require the intended DMS and **No Identity**. Follow Manual registration to complete assignment.",{"_3624":908,"_31165":867,"_21590":53718,"_5":14857,"_28357":53615,"_3076":53719},[],"Preregistration does not establish that `/simpleenroll` will admit the request. Review its interaction with `enable_replaceable_enrollment` in Provisioning strategies.",{"_3624":909,"_31165":867,"_21590":53721,"_5":14857,"_28357":53619,"_3076":53722},[],"From **No Identity**, use **Assign Identity**:",{"_3624":910,"_31165":867,"_21590":53724,"_5":14857,"_28357":53619,"_3076":53725},[],"Select an active, current certificate suitable for the consumer, with `CN` exactly equal to `Device ID`.",{"_3624":911,"_31165":867,"_21590":53727,"_5":14857,"_28357":53619,"_3076":53728},[],"If unavailable, **Issue New Instead** starts issuance using the intended CA. Review the profile first.",{"_3624":912,"_31165":867,"_21590":53730,"_5":14857,"_28357":53619,"_3076":53731},[],"Confirm and read the serial, active version and history again.",{"_3624":913,"_31165":867,"_21590":53733,"_5":14857,"_28357":53619,"_3076":53734},[],"Install the key/certificate pair and required intermediates on the device and test usage.",{"_3624":914,"_31165":867,"_21590":53736,"_5":14857,"_28357":53619,"_3076":53737},[],"Issuing, binding and installing are separate steps. If an operation fails, check which steps persisted before repeating it.",{"_3624":915,"_31165":867,"_21590":53739,"_5":14857,"_28357":53623,"_3076":53740},[],"Locate the active serial in history and revoke it with an appropriate reason. Verify the record, OCSP/CRL publication and rejection of a new consumer connection using the certificate guide.",{"_3624":916,"_31165":867,"_21590":53742,"_5":14857,"_28357":53623,"_3076":53743},[],"Revocation does not remove the device. It does not automatically enable another enrollment either: recovery depends on its credential, status and DMS policy. `CertificateHold` can be reactivated under PKI conditions; other reasons block subsequent certificate changes.",{"_3624":917,"_31165":867,"_21590":53745,"_5":14857,"_28357":53623,"_3076":53746},[],"A certificate suspended by a CA hold cascade shows as **Revoked** and returns to active when the holding CA is released. If its certificate expired during the hold, the monitoring job marks it as expired again after the release. If you revoke a held identity yourself, that revocation is permanent.",{"_3624":918,"_31165":867,"_21590":53748,"_5":14857,"_28357":53627,"_3076":53749},[],"Before **Decommission**, inventory active and previous identities, connections and destination permissions. Prepare retirement in the consumer.",{"_3624":919,"_31165":867,"_21590":53751,"_5":14857,"_28357":53627,"_3076":53752},[],"The backend saves **Decommissioned** and attempts to revoke the active version’s certificate with `CessationOfOperation` if the slot was not expired or revoked. It does not traverse all history. Deferred revocation can fail after retirement is saved; check the result by serial.",{"_3624":920,"_31165":867,"_21590":53754,"_5":14857,"_28357":53627,"_3076":53755},[],"Retired status protects ordinary device and slot updates. It does not guarantee that every EST request is rejected before issuance: binding can skip a retired device without returning an error. Check for remaining usable certificates or permissions and block new admission in the relevant control.",{"_3624":921,"_31165":867,"_21590":53757,"_5":14857,"_28357":53627,"_3076":53758},[],"Retain records according to audit policy. Do not reuse a retired ID to hide an equipment change.",{"_3624":922,"_31165":867,"_21590":53760,"_5":14857,"_28357":53631,"_3076":53761},[],"<Card title=\"Enroll and connect a device\" description=\"Obtain an identity from the client and test mTLS.\" href=\"/docs/platform/iot-fleets/quickstarts/enroll-device\" />",{"_3624":923,"_31165":867,"_21590":53763,"_5":14857,"_28357":53631,"_3076":53764},[],"<Card title=\"Renewal and recovery\" description=\"Install the successor and handle failures without losing known state.\" href=\"/docs/platform/iot-fleets/enrollment/renewal-and-recovery\" />",{"_3624":924,"_31165":924,"_5":15217,"_3076":53766,"_31503":53767,"_21590":53769,"_28357":924},"Bootstrap identity and authentication",[50900,52412,53584,53582,53768],"Enrollment with PKI",[],{"_3624":925,"_31165":924,"_21590":53771,"_5":14857,"_28357":924,"_3076":53772},[],"Prepare server trust and admission proofs for enroll and reenroll.",{"_3624":926,"_31165":924,"_5":31500,"_21590":53774,"_28357":53775,"_3076":53776},[],"/docs/platform/iot-fleets/enrollment/bootstrap-identity#initial-server-trust","Initial server trust",{"_3624":927,"_31165":924,"_5":31500,"_21590":53778,"_28357":53779,"_3076":53780},[],"/docs/platform/iot-fleets/enrollment/bootstrap-identity#bootstrap-credential","Bootstrap credential",{"_3624":928,"_31165":924,"_5":31500,"_21590":53782,"_28357":53783,"_3076":53784},[],"/docs/platform/iot-fleets/enrollment/bootstrap-identity#modes-per-operation","Modes per operation",{"_3624":929,"_31165":924,"_5":31500,"_21590":53786,"_28357":53787,"_3076":53788},[],"/docs/platform/iot-fleets/enrollment/bootstrap-identity#webhook-contract","Webhook contract",{"_3624":930,"_31165":924,"_5":31500,"_21590":53790,"_28357":53791,"_3076":53792},[],"/docs/platform/iot-fleets/enrollment/bootstrap-identity#revocation-and-checks","Revocation and checks",{"_3624":931,"_31165":924,"_21590":53794,"_5":14857,"_28357":924,"_3076":53795},[],"This guide connects the DMS administrator with device manufacturing and integration. Before requesting an operational identity, the client must authenticate the EST server and establish entitlement to request the intended ID.",{"_3624":932,"_31165":924,"_21590":53797,"_5":14857,"_28357":53775,"_3076":53798},[],"Install a previously verified root, chain or pin through a trusted channel: manufacturing, approved configuration or authenticated distribution. It enables TLS and server-name verification before downloading `/cacerts`.",{"_3624":933,"_31165":924,"_21590":53800,"_5":14857,"_28357":53775,"_3076":53801},[],"Your only trust proof cannot come from the same unauthenticated server. The EST server TLS certificate, bootstrap certificate and operational identity issuer may belong to different hierarchies.",{"_3624":934,"_31165":924,"_21590":53803,"_5":14857,"_28357":53779,"_3076":53804},[],"With `CLIENT_CERTIFICATE`, the device presents its initial certificate and proves key possession through TLS. The DMS validates it against admission CAs. The validator receives one leaf credential: configure and test the direct issuer for the simple case; sending more intermediates does not establish delivery to the service.",{"_3624":935,"_31165":924,"_21590":53806,"_5":14857,"_28357":53779,"_3076":53807},[],"Check dates, matching certificate/key and revocation before provisioning. A credential shared across equipment identifies that shared credential, not an individual device.",{"_3624":936,"_31165":924,"_21590":53809,"_5":14857,"_28357":53779,"_3076":53810},[],"Initial mTLS validation does not by itself compare bootstrap CN with the requested CSR CN. If a requester should only request its own `Device ID`, add a control binding credential to ID, such as the combined webhook, and test a request with another CN. Certificate re-enrollment does compare its CN to the CSR; subsequent checks use the registered active identity.",{"_3624":937,"_31165":924,"_21590":53812,"_5":14857,"_28357":53783,"_3076":53813},[],"Select the four modes independently for enrollment and re-enrollment in DMS. Renewal credentials depend on that block; do not assume the bootstrap is always used or the webhook disappears.",{"_3624":938,"_31165":924,"_21590":53815,"_5":14857,"_28357":53783,"_3076":53816},[],"An administrative OIDC token is not a native EST mode. A webhook may interpret an agreed credential header; that service then performs authorization. In NO\\_AUTH, sending a token does not add DMS authentication.",{"_3624":939,"_31165":924,"_21590":53818,"_5":14857,"_28357":53787,"_3076":53819},[],"The DMS sends operation context to the configured service. Method comes from configuration; agree the contract before selecting POST or PUT. Authorization wait defaults to 10 seconds, replaced by a configured positive timeout. The DMS verifies the receiver certificate unless `insecure_skip_verify` is enabled in the webhook config — verification is on by default — and does not follow redirects, so the configured URL must be the final one. The authorization response must be JSON of at most 1 MiB. With Lamassu-to-webhook authentication configured over `http://`, the API key or bearer token travels in cleartext, and mTLS has no effect because no TLS handshake takes place, so the client certificate is never presented; prefer `https://`. Configure those options in the webhook settings of the DMS guide.",{"_3624":940,"_31165":924,"_21590":53821,"_5":14857,"_28357":53787,"_3076":53822},[],"Example body:",{"_3624":941,"_31165":924,"_21590":53824,"_5":14857,"_28357":53787,"_3076":53825},[],"`csr` is **base64 of PEM**, unlike the EST body, which is base64 of DER. `http_request` contains URL and first header entries from available HTTP context. This body does not include an `operation` field; distinguish enroll and reenroll through the path and configured policy.",{"_3624":942,"_31165":924,"_21590":53827,"_5":14857,"_28357":53787,"_3076":53828},[],"The webhook should verify credential, its relationship to `device_cn`, DMS, operation and admission policy. Forwarded headers are not themselves trusted evidence. **Lamassu-to-webhook authentication** is a separate relationship configured in the server’s HTTP client.",{"_3624":943,"_31165":924,"_21590":53830,"_5":14857,"_28357":53787,"_3076":53831},[],"Continuation requires a successful HTTP response and JSON:",{"_3624":944,"_31165":924,"_21590":53833,"_5":14857,"_28357":53787,"_3076":53834},[],"A bodyless `204` does not satisfy the contract. Denial, transport error, uninterpretable response or timeout abort authorization. Combined mode validates the certificate first, then queries the webhook. See the webhook specification.",{"_3624":945,"_31165":924,"_21590":53836,"_5":14857,"_28357":53791,"_3076":53837},[],"The DMS first looks up the presented certificate in Lamassu; certificates it issued and manages are checked against their stored status. External certificates are checked through their OCSP servers and then their CRL distribution points. By default, unverifiable revocation is a rejection, not an acceptance: a certificate that is not managed by Lamassu and lists no OCSP or CRL endpoint is rejected unless `allow_unverifiable_revocation` is set in that operation's block (see Authentication per operation).",{"_3624":946,"_31165":924,"_21590":53839,"_5":14857,"_28357":53791,"_3076":53840},[],"A certificate that does list endpoints is held to a stricter standard, with or without the option: unreachable endpoints, stale or invalid evidence, or an inconclusive (unknown) status reject the certificate. The evidence must be fresh — `thisUpdate` not in the future, `nextUpdate` not passed, and an answer without `nextUpdate` accepted only while it is less than about 24 hours old — and OCSP responses must be signed by the certificate's issuer itself or by a delegated responder that carries the `id-kp-OCSPSigning` EKU and is within its validity. A revoked verdict is honored regardless of its age. Each OCSP or CRL request has a 10-second timeout.",{"_3624":947,"_31165":924,"_21590":53842,"_5":14857,"_28357":53791,"_3076":53843},[],"One caveat remains: a signed Good OCSP response or CRL captured before a revocation keeps validating until its `nextUpdate` (up to about 24 hours without `nextUpdate`). Revocation propagates to devices at the pace the responders publish evidence, not at the moment of revocation.",{"_3624":948,"_31165":924,"_21590":53845,"_5":14857,"_28357":53791,"_3076":53846},[],"Test an allowed certificate, an incorrect one, another CN, webhook denial, timeout and re-enrollment under its own policy. Keep results and schedule bootstrap credential retirement where appropriate. Continue with EST client.",{"_3624":949,"_31165":949,"_5":15217,"_3076":53848,"_31503":53849,"_21590":53850,"_28357":949},"Configure and operate the DMS",[50900,52412,53584,53582,53768],[],{"_3624":950,"_31165":949,"_21590":53852,"_5":14857,"_28357":949,"_3076":53853},[],"Define registration, authentication per operation, issuance, renewal and distributed trust.",{"_3624":951,"_31165":949,"_5":31500,"_21590":53855,"_28357":53856,"_3076":50910},[],"/docs/platform/iot-fleets/enrollment/dms#before-you-begin",{"_3624":952,"_31165":949,"_5":31500,"_21590":53858,"_28357":53859,"_3076":53860},[],"/docs/platform/iot-fleets/enrollment/dms#configure-a-dms","Configure a DMS",{"_3624":953,"_31165":949,"_5":31500,"_21590":53862,"_28357":53863,"_3076":53864},[],"/docs/platform/iot-fleets/enrollment/dms#identify-the-fleet","Identify the fleet",{"_3624":954,"_31165":949,"_5":31500,"_21590":53866,"_28357":53867,"_3076":53868},[],"/docs/platform/iot-fleets/enrollment/dms#select-the-enrollment-ca","Select the enrollment CA",{"_3624":955,"_31165":949,"_5":31500,"_21590":53870,"_28357":53871,"_3076":53872},[],"/docs/platform/iot-fleets/enrollment/dms#configure-est","Configure EST",{"_3624":956,"_31165":949,"_5":31500,"_21590":53874,"_28357":53875,"_3076":53876},[],"/docs/platform/iot-fleets/enrollment/dms#distribute-trust","Distribute trust",{"_3624":957,"_31165":949,"_5":31500,"_21590":53878,"_28357":53879,"_3076":53880},[],"/docs/platform/iot-fleets/enrollment/dms#verify-the-endpoints","Verify the endpoints",{"_3624":958,"_31165":949,"_5":31500,"_21590":53882,"_28357":53883,"_3076":53884},[],"/docs/platform/iot-fleets/enrollment/dms#enrollment-configuration","Enrollment configuration",{"_3624":959,"_31165":949,"_5":31500,"_21590":53886,"_28357":53887,"_3076":53888},[],"/docs/platform/iot-fleets/enrollment/dms#enrollment-device-registration","Enrollment Device Registration",{"_3624":960,"_31165":949,"_5":31500,"_21590":53890,"_28357":53891,"_3076":53892},[],"/docs/platform/iot-fleets/enrollment/dms#enrollment-settings","Enrollment Settings",{"_3624":961,"_31165":949,"_5":31500,"_21590":53894,"_28357":53895,"_3076":53896},[],"/docs/platform/iot-fleets/enrollment/dms#authentication-per-operation","Authentication per operation",{"_3624":962,"_31165":949,"_5":31500,"_21590":53898,"_28357":53899,"_3076":53900},[],"/docs/platform/iot-fleets/enrollment/dms#external-webhook-settings","External webhook settings",{"_3624":963,"_31165":949,"_5":31500,"_21590":53902,"_28357":53903,"_3076":53904},[],"/docs/platform/iot-fleets/enrollment/dms#issuance-profile","Issuance profile",{"_3624":964,"_31165":949,"_5":31500,"_21590":53906,"_28357":53907,"_3076":53908},[],"/docs/platform/iot-fleets/enrollment/dms#re-enrollment-configuration","Re-enrollment configuration",{"_3624":965,"_31165":949,"_5":31500,"_21590":53910,"_28357":53911,"_3076":53912},[],"/docs/platform/iot-fleets/enrollment/dms#serverkeygen","ServerKeyGen",{"_3624":966,"_31165":949,"_5":31500,"_21590":53914,"_28357":53915,"_3076":53916},[],"/docs/platform/iot-fleets/enrollment/dms#trust-distribution","Trust distribution",{"_3624":967,"_31165":949,"_5":31500,"_21590":53918,"_28357":53919,"_3076":53920},[],"/docs/platform/iot-fleets/enrollment/dms#operate-the-dms-inventory","Operate the DMS inventory",{"_3624":968,"_31165":949,"_5":31500,"_21590":53922,"_28357":53923,"_3076":53924},[],"/docs/platform/iot-fleets/enrollment/dms#integrate-the-devices","Integrate the devices",{"_3624":969,"_31165":949,"_21590":53926,"_5":14857,"_28357":949,"_3076":53927},[],"A &#x2A;*Device Management Service (DMS)** configures admission and identity lifecycle for its devices. It acts as a registration authority; the CA selected in `Enrollment CA` signs certificates. This guide is for the policy administrator.",{"_3624":970,"_31165":949,"_21590":53929,"_5":14857,"_28357":53856,"_3076":53930},[],"You need DMS management permissions, an active CA with a usable key and a tested issuance profile. Agree device ID, initial credential, consumer and renewal window with the integrator. Review Provisioning strategies before choosing registration and replacement.",{"_3624":971,"_31165":949,"_21590":53932,"_5":14857,"_28357":53856,"_3076":53933},[],"Prepare EST server trust and device connectivity through Deployment. Your operator’s administrative authentication does not replace device EST authentication.",{"_3624":972,"_31165":949,"_21590":53935,"_5":14857,"_28357":53863,"_3076":53936},[],"Create the DMS with a recognizable name and retain its ID. EST URLs use this identifier, not the display name. Each device retains one owning DMS.",{"_3624":973,"_31165":949,"_21590":53938,"_5":14857,"_28357":53867,"_3076":53939},[],"Choose **Enrollment CA** and an explicit profile appropriate for the end-entity identity. Keep CN compatible with `Device ID`. The test certificate should allow its intended purpose and expire within issuer validity.",{"_3624":974,"_31165":949,"_21590":53941,"_5":14857,"_28357":53871,"_3076":53942},[],"Select initial enrollment registration and authentication. Separately configure re-enrollment authentication, thresholds and previous certificate retirement. Leave ServerKeyGen disabled if the client generates its key.",{"_3624":975,"_31165":949,"_21590":53944,"_5":14857,"_28357":53875,"_3076":53945},[],"Select certificates returned by `/cacerts`. Explicitly include required intermediates and roots, keeping distribution distinct from automatic trust installation.",{"_3624":976,"_31165":949,"_21590":53947,"_5":14857,"_28357":53879,"_3076":53948},[],"Save and read configuration again. Query `/cacerts`, perform an allowed and a rejected enrollment, and inspect device, serial and history. Creating the DMS or downloading cacerts does not establish working authentication and issuance.",{"_3624":977,"_31165":949,"_21590":53950,"_5":14857,"_28357":53887,"_3076":53951},[],"`settings.enrollment_settings.registration_mode` accepts `JITP` or `PRE_REGISTRATION`. JITP creates an unknown device with the CSR CN as ID and the DMS as owner. `device_provisioning_profile` supplies tags, metadata and icon for that registration.",{"_3624":978,"_31165":949,"_21590":53953,"_5":14857,"_28357":53887,"_3076":53954},[],"PRE\\_REGISTRATION requires an existing ID. An existing device encounters replacement checks first, even without an identity. Review preregistration conditions before using this mode.",{"_3624":979,"_31165":949,"_21590":53956,"_5":14857,"_28357":53891,"_3076":53957},[],"`settings.enrollment_settings` field",{"_3624":980,"_31165":949,"_21590":53959,"_5":14857,"_28357":53891,"_3076":53960},[],"Decision",{"_3624":981,"_31165":949,"_21590":53962,"_5":14857,"_28357":53891,"_3076":53963},[],"`protocol`",{"_3624":982,"_31165":949,"_21590":53965,"_5":14857,"_28357":53891,"_3076":53966},[],"`EST_RFC7030` for these operations.",{"_3624":983,"_31165":949,"_21590":53968,"_5":14857,"_28357":53891,"_3076":53969},[],"`enrollment_ca`",{"_3624":984,"_31165":949,"_21590":53971,"_5":14857,"_28357":53891,"_3076":53972},[],"ID of the signing CA.",{"_3624":985,"_31165":949,"_21590":53974,"_5":14857,"_28357":53891,"_3076":53975},[],"`verify_csr_signature`",{"_3624":986,"_31165":949,"_21590":53977,"_5":14857,"_28357":53891,"_3076":53978},[],"Keep `true` to verify CSR key possession.",{"_3624":987,"_31165":949,"_21590":53980,"_5":14857,"_28357":53891,"_3076":53981},[],"`enable_replaceable_enrollment`",{"_3624":988,"_31165":949,"_21590":53983,"_5":14857,"_28357":53891,"_3076":53984},[],"Allows `/simpleenroll` for an existing ID in the same DMS. It can attempt previous certificate revocation even if a later phase fails; this is not atomic.",{"_3624":989,"_31165":949,"_21590":53986,"_5":14857,"_28357":53891,"_3076":53987},[],"`est_rfc7030_settings.auth_mode`",{"_3624":990,"_31165":949,"_21590":53989,"_5":14857,"_28357":53891,"_3076":53990},[],"One of the four authentication modes.",{"_3624":991,"_31165":949,"_21590":53992,"_5":14857,"_28357":53891,"_3076":53993},[],"Initial enrollment rejects an ID owned by another DMS. Do not automatically enable replacement in response to an error; Troubleshooting distinguishes repeated IDs, ownership and partial changes.",{"_3624":992,"_31165":949,"_21590":53995,"_5":14857,"_28357":53895,"_3076":53996},[],"The blocks are independent:",{"_3624":993,"_31165":949,"_21590":53998,"_5":14857,"_28357":53895,"_3076":53999},[],"`settings.enrollment_settings.est_rfc7030_settings` for `/simpleenroll` and `/serverkeygen`.",{"_3624":994,"_31165":949,"_21590":54001,"_5":14857,"_28357":53895,"_3076":54002},[],"`settings.reenrollment_settings.est_rfc7030_settings` for `/simplereenroll`.",{"_3624":995,"_31165":949,"_21590":54004,"_5":14857,"_28357":53895,"_3076":54005},[],"`auth_mode`",{"_3624":996,"_31165":949,"_21590":54007,"_5":14857,"_28357":53895,"_3076":54008},[],"Control applied in the configured operation",{"_3624":997,"_31165":949,"_21590":54010,"_5":14857,"_28357":53895,"_3076":54011},[],"`CLIENT_CERTIFICATE`",{"_3624":998,"_31165":949,"_21590":54013,"_5":14857,"_28357":53895,"_3076":54014},[],"Presented certificate validation.",{"_3624":999,"_31165":949,"_21590":54016,"_5":14857,"_28357":53895,"_3076":54017},[],"`EXTERNAL_WEBHOOK`",{"_3624":1000,"_31165":949,"_21590":54019,"_5":14857,"_28357":53895,"_3076":54020},[],"Configured webhook authorization.",{"_3624":1001,"_31165":949,"_21590":54022,"_5":14857,"_28357":53895,"_3076":54023},[],"`CLIENT_CERTIFICATE_AND_EXTERNAL_WEBHOOK`",{"_3624":1002,"_31165":949,"_21590":54025,"_5":14857,"_28357":53895,"_3076":54026},[],"Certificate validation followed by webhook approval.",{"_3624":1003,"_31165":949,"_21590":54028,"_5":14857,"_28357":53895,"_3076":54029},[],"`NO_AUTH`",{"_3624":1004,"_31165":949,"_21590":54031,"_5":14857,"_28357":53895,"_3076":54032},[],"No DMS requester authentication.",{"_3624":1005,"_31165":949,"_21590":54034,"_5":14857,"_28357":53895,"_3076":54035},[],"Webhook and combined modes also execute during re-enrollment when configured in its block. They do not implicitly degrade to NO\\_AUTH. An absent or unrecognized mode fails.",{"_3624":1006,"_31165":949,"_21590":54037,"_5":14857,"_28357":53895,"_3076":54038},[],"For initial mTLS, `client_certificate_settings` contains `validation_cas`, `allow_expired`, `chain_level_validation` and `allow_unverifiable_revocation`. The validator receives one certificate credential; the flow does not guarantee forwarding every handshake intermediate to it. For a direct case, configure the bootstrap’s direct issuer as validation CA and test the actual Gateway path.",{"_3624":1007,"_31165":949,"_21590":54040,"_5":14857,"_28357":53895,"_3076":54041},[],"Revocation is checked for every presented certificate. In initial enrollment the client certificate **and** every intermediate CA between it and the validation CA are checked, each against its issuer; extra certificates the device sends in the handshake are ignored. A validation CA that is revoked in Lamassu rejects the operation: the first validation CA that validates the certificate is used, and a revoked one is not replaced by the remaining validation CAs. Certificates issued and managed by Lamassu are checked against their stored status. External certificates are checked through their OCSP and CRL endpoints, and the operation fails closed when revocation cannot be verified: only `allow_unverifiable_revocation` — `false` by default in both blocks — relaxes the case of an external certificate that lists no endpoint at all. Endpoints that exist but are unreachable, return stale or invalid evidence, or report an inconclusive status are always rejected, whatever the option says. The details and the evidence the endpoints must present are in Revocation and checks.",{"_3624":1008,"_31165":949,"_21590":54043,"_5":14857,"_28357":53895,"_3076":54044},[],"For certificate re-enrollment, the validator tries the enrollment CA first and then the CAs listed in `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`; those are the re-enrollment validation CAs. That list is optional because the enrollment CA is always trusted for re-enrollment, and each settings block consults only its own `validation_cas`. CAs listed only in the initial block's `validation_cas` do not extend re-enrollment acceptance; during a CA rotation, add the old issuance CA to the re-enrollment block's list. The re-enrollment validator compares the presented TLS leaf against those CAs; the re-enrollment block's `chain_level_validation` and `allow_expired` values are stored but not consulted, and expiry is governed by `enable_expired_renewal`. Re-enrollment checks revocation of the client certificate only; that check is governed by the re-enrollment block's own `allow_unverifiable_revocation`.",{"_3624":1009,"_31165":949,"_21590":54046,"_5":14857,"_28357":53895,"_3076":54047},[],"For a webhook, configure destination, Lamassu-to-service authentication, method and timeout. The authentication contract explains the device credential and request body. `NO_AUTH` does not establish ownership of the requested ID.",{"_3624":1010,"_31165":949,"_21590":54049,"_5":14857,"_28357":53899,"_3076":54050},[],"The webhook authentication modes read `external_webhook_settings` in the same `est_rfc7030_settings` block:",{"_3624":1011,"_31165":949,"_21590":54052,"_5":14857,"_28357":53899,"_3076":54053},[],"`external_webhook_settings` field",{"_3624":1012,"_31165":949,"_21590":54055,"_5":14857,"_28357":53899,"_3076":53960},[],{"_3624":1013,"_31165":949,"_21590":54057,"_5":14857,"_28357":53899,"_3076":54058},[],"`url`",{"_3624":1014,"_31165":949,"_21590":54060,"_5":14857,"_28357":53899,"_3076":54061},[],"Absolute `http` or `https` URL of the receiver. It must be the final URL; redirects are not followed.",{"_3624":1015,"_31165":949,"_21590":54063,"_5":14857,"_28357":53899,"_3076":54064},[],"`method`",{"_3624":1016,"_31165":949,"_21590":54066,"_5":14857,"_28357":53899,"_3076":54067},[],"`POST` or `PUT`; `POST` by default.",{"_3624":1017,"_31165":949,"_21590":54069,"_5":14857,"_28357":53899,"_3076":54070},[],"`name`",{"_3624":1018,"_31165":949,"_21590":54072,"_5":14857,"_28357":53899,"_3076":54073},[],"Label used in service logs.",{"_3624":1019,"_31165":949,"_21590":54075,"_5":14857,"_28357":53899,"_3076":54076},[],"`config.auth_mode`",{"_3624":1020,"_31165":949,"_21590":54078,"_5":14857,"_28357":53899,"_3076":54079},[],"`noauth`, `apikey`, `jwt` or `mtls`. An absent or unknown value behaves as `noauth`.",{"_3624":1021,"_31165":949,"_21590":54081,"_5":14857,"_28357":53899,"_3076":54082},[],"`config.log_level`",{"_3624":1022,"_31165":949,"_21590":54084,"_5":14857,"_28357":53899,"_3076":54085},[],"Log level of the webhook call: `debug`, `info`, `warn` or `error`; `info` by default.",{"_3624":1023,"_31165":949,"_21590":54087,"_5":14857,"_28357":53899,"_3076":54088},[],"`config.apikey_options`",{"_3624":1024,"_31165":949,"_21590":54090,"_5":14857,"_28357":53899,"_3076":54091},[],"Required for `apikey`: `header` and `key`. Reserved header names are rejected.",{"_3624":1025,"_31165":949,"_21590":54093,"_5":14857,"_28357":53899,"_3076":54094},[],"`config.jwt_options`",{"_3624":1026,"_31165":949,"_21590":54096,"_5":14857,"_28357":53899,"_3076":54097},[],"Required for `jwt`: `oidc_client_id`, `oidc_client_secret` and an absolute `http` or `https` `oidc_well_known`.",{"_3624":1027,"_31165":949,"_21590":54099,"_5":14857,"_28357":53899,"_3076":54100},[],"`config.mtls_options`",{"_3624":1028,"_31165":949,"_21590":54102,"_5":14857,"_28357":53899,"_3076":54103},[],"Required for `mtls`: `cert_content` and `key_content` as Base64-encoded PEM, like certificates elsewhere in the API; plain PEM is also accepted.",{"_3624":1029,"_31165":949,"_21590":54105,"_5":14857,"_28357":53899,"_3076":54106},[],"`config.insecure_skip_verify`",{"_3624":1030,"_31165":949,"_21590":54108,"_5":14857,"_28357":53899,"_3076":54109},[],"Skips verification of the receiver certificate when `true`. Verification is on by default. Unlike alert channels, this flag is honored here.",{"_3624":1031,"_31165":949,"_21590":54111,"_5":14857,"_28357":53899,"_3076":54112},[],"`config.call_timeout`",{"_3624":1032,"_31165":949,"_21590":54114,"_5":14857,"_28357":53899,"_3076":54115},[],"Maximum duration of the authorization call (for example `10s`); 10 seconds by default.",{"_3624":1033,"_31165":949,"_21590":54117,"_5":14857,"_28357":53899,"_3076":54118},[],"Rules for that configuration:",{"_3624":1034,"_31165":949,"_21590":54120,"_5":14857,"_28357":53899,"_3076":54121},[],"Creating or updating a DMS whose enrollment or reenrollment `auth_mode` uses the webhook validates the block and returns HTTP 400 — the body starts with `struct validation error:` and continues with `invalid enrollment external webhook config` or `invalid reenrollment external webhook config` — when the URL, method or options are invalid. That includes an `mtls_options.cert_content`/`key_content` pair that does not decode to a matching certificate and private key. File references (`ca_cert_file`, `mtls_options.cert_file`, `mtls_options.key_file`) are always invalid: the service does not read files, so enter the certificate and key as Base64-encoded PEM in `mtls_options.cert_content` and `key_content`, or as plain PEM.",{"_3624":1035,"_31165":949,"_21590":54123,"_5":14857,"_28357":53899,"_3076":54124},[],"A custom `apikey_options.header` may not use names that the platform or the receiving service trusts — for example `X-Principal-Id`, `X-Request-Id`, `Host`, `Content-Type` or `Forwarded` — and no name may start with `X-Forwarded-`, `X-Envoy-` or `X-Lms-` (case-insensitive). The DMS API reference documents the `WebhookCall` and `WebhookCallHttpClient` schemas and that reserved API-key headers are rejected.",{"_3624":1036,"_31165":949,"_21590":54126,"_5":14857,"_28357":53899,"_3076":54127},[],"The nested `http_client` key exists only in alert channel configurations; in a DMS body it is ignored. The DMS key is `external_webhook_settings.config`.",{"_3624":1037,"_31165":949,"_21590":54129,"_5":14857,"_28357":53899,"_3076":54130},[],"A body with `config.auth_mode` set to `apikey`, `jwt` or `mtls` must carry its corresponding option block (`apikey_options`, `jwt_options` or `mtls_options`) — and nothing else. Bodies with those auth modes carrying only `apikey`, `oidc` or `mtls` fail validation with 400, and `validate_server_cert` is always ignored: use `insecure_skip_verify`. Only bodies without option blocks are accepted as `noauth`, and their credentials are dropped.",{"_3624":1038,"_31165":949,"_21590":54132,"_5":14857,"_28357":53899,"_3076":54133},[],"The authorization response must be JSON of at most 1 MiB; a larger body fails the call.",{"_3624":1039,"_31165":949,"_21590":54135,"_5":14857,"_28357":53899,"_3076":54136},[],"With credentials configured, they are sent regardless of the URL scheme: an `http://` webhook receives the API key or bearer token in cleartext, and mTLS has no effect because no TLS handshake takes place, so the client certificate is never presented. Prefer `https://` for `url`, `oidc_well_known` and the token endpoint it advertises.",{"_3624":1040,"_31165":949,"_21590":54138,"_5":14857,"_28357":53899,"_3076":54139},[],"Initial authentication and renewal settings are stored independently. If a DMS only has the initial authentication block, renewal reuses it: read both blocks before editing. The console exposes independent editors for the enrollment and re-enrollment authentication, with the same Log Level, Call Timeout, HTTP Authentication and credential fields as the webhook channels, plus a **Skip TLS Verification** switch (off by default, so verification stays on; the console warns when you enable it).",{"_3624":1041,"_31165":949,"_21590":54141,"_5":14857,"_28357":53899,"_3076":54142},[],"Webhook credentials must be stored as PEM content. File references (`ca_cert_file`, `mtls_options.cert_file`, `mtls_options.key_file`) are never valid in a stored webhook config: delivery rejects any webhook config that references files, whatever its auth mode, so every enroll and reenroll that calls that webhook fails until the certificate and key are entered as Base64-encoded or plain PEM in `mtls_options.cert_content` and `key_content`, or the file fields are removed if the webhook does not use mTLS. If a stored config holds file paths in `mtls_options.cert_content` or `key_content`, every full settings update (`POST /v1/dms`, `PUT /v1/dms/:id`) fails validation — settings are replaced wholesale, so the stored config must be resent — until the values are replaced by PEM content or the webhook stops being used. Meanwhile, delivery of that webhook fails on every call; a metadata-only update through `PUT` or `PATCH` on `/v1/dms/:id/metadata` still succeeds. To fix it in the console, open the DMS, replace any file-path value with PEM content — the editor rejects file paths with an inline field error — and save. Saving rewrites `external_webhook_settings.config` with the current keys, and the console reads both plain and Base64-encoded PEM from migrated configurations and stores the material Base64-encoded. If your stored config previously relied on `validate_server_cert: false`, it now carries `insecure_skip_verify: true`: receiver-certificate verification stays skipped until you set that flag to `false`. See 3.8.0 to 4.0.0 for the upgrade notes and the operator checklist.",{"_3624":1042,"_31165":949,"_21590":54144,"_5":14857,"_28357":53899,"_3076":54145},[],"The re-enrollment trust set lives in `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`. The flat field `reenrollment_settings.additional_validation_cas` is not part of the API: bodies that carry it are accepted but the value is silently ignored — unknown JSON fields are dropped — and GET responses do not include it. Read the DMS before sending API edits: an update body built with that flat field silently empties `validation_cas`.",{"_3624":1043,"_31165":949,"_21590":54147,"_5":14857,"_28357":53903,"_3076":54148},[],"`settings.issuance_profile_id` takes precedence over `settings.issuance_profile`; without either, the CA default profile is used. The resolved profile — including the CA default used as fallback when the DMS defines none — must define an end-entity certificate: a `Sign as CA` profile is rejected at enrollment and re-enrollment time. Rules are documented once in Profiles. DMS changes affect future requests; they do not modify signed certificates or install client trust.",{"_3624":1044,"_31165":949,"_21590":54150,"_5":14857,"_28357":53907,"_3076":54151},[],"`settings.reenrollment_settings` field",{"_3624":1045,"_31165":949,"_21590":54153,"_5":14857,"_28357":53907,"_3076":51290},[],{"_3624":1046,"_31165":949,"_21590":54155,"_5":14857,"_28357":53907,"_3076":54156},[],"`reenrollment_delta`",{"_3624":1047,"_31165":949,"_21590":54158,"_5":14857,"_28357":53907,"_3076":54159},[],"Opens the window at the active certificate’s `NotAfter` minus this delta.",{"_3624":1048,"_31165":949,"_21590":54161,"_5":14857,"_28357":53907,"_3076":54162},[],"`preventive_delta`",{"_3624":1049,"_31165":949,"_21590":54164,"_5":14857,"_28357":53907,"_3076":54165},[],"Preventive operational monitoring threshold.",{"_3624":1050,"_31165":949,"_21590":54167,"_5":14857,"_28357":53907,"_3076":54168},[],"`critical_delta`",{"_3624":1051,"_31165":949,"_21590":54170,"_5":14857,"_28357":53907,"_3076":54171},[],"Critical operational monitoring threshold.",{"_3624":1052,"_31165":949,"_21590":54173,"_5":14857,"_28357":53907,"_3076":54174},[],"`enable_expired_renewal`",{"_3624":1053,"_31165":949,"_21590":54176,"_5":14857,"_28357":53907,"_3076":54177},[],"Accepts an expired presented certificate in the renewal mTLS validator. Does not authorize another mode or remove Gateway constraints by itself.",{"_3624":1054,"_31165":949,"_21590":54179,"_5":14857,"_28357":53907,"_3076":54180},[],"`est_rfc7030_settings.client_certificate_settings.validation_cas`",{"_3624":1055,"_31165":949,"_21590":54182,"_5":14857,"_28357":53907,"_3076":54183},[],"Re-enrollment validation CAs for the renewal mTLS credential, tried after the enrollment CA; optional, because the enrollment CA is always trusted. Typically populated during CA rotation while old-CA cohorts renew.",{"_3624":1056,"_31165":949,"_21590":54185,"_5":14857,"_28357":53907,"_3076":54186},[],"`revoke_on_reenrollment`",{"_3624":1057,"_31165":949,"_21590":54188,"_5":14857,"_28357":53907,"_3076":54189},[],"If the previous certificate is ACTIVE, attempts Superseded revocation before binding its successor.",{"_3624":1058,"_31165":949,"_21590":54191,"_5":14857,"_28357":53907,"_3076":54192},[],"Monitoring does not renew: the client must schedule the request and installation. Webhook and NO\\_AUTH modes do not use the same mTLS expired-credential validator; the webhook must explicitly authorize permitted recovery. Review Renewal and recovery for operation order and partial failures.",{"_3624":1059,"_31165":949,"_21590":54194,"_5":14857,"_28357":53911,"_3076":54195},[],"`settings.server_keygen_settings.enabled` enables software key generation on the server. The console exposes it through an **Enable server-side key generation** switch and a **Key type** selection: `ECDSA` P-256, P-384 or P-521, or `RSA` with 2048, 3072 or 4096 bits; the defaults are P-256 for `ECDSA` and 4096 bit for `RSA`. Algorithm and size come from its `key` field, stored as `{type,bits}` where P-256, P-384 and P-521 map to `bits` 256, 384 and 521; `key` is omitted when disabled. The profile must permit them. The response contains an unencrypted PKCS#8 key inside TLS alongside the certificate. See format and extraction in EST reference.",{"_3624":1060,"_31165":949,"_21590":54197,"_5":14857,"_28357":53915,"_3076":51284},[],{"_3624":1061,"_31165":949,"_21590":54199,"_5":14857,"_28357":53915,"_3076":54200},[],"Published material",{"_3624":1062,"_31165":949,"_21590":54202,"_5":14857,"_28357":53915,"_3076":54203},[],"**Include Lamassu System CA**",{"_3624":1063,"_31165":949,"_21590":54205,"_5":14857,"_28357":53915,"_3076":54206},[],"Available downstream TLS certificate; it can be a leaf, not an issuing CA.",{"_3624":1064,"_31165":949,"_21590":54208,"_5":14857,"_28357":53915,"_3076":54209},[],"**Include Enrollment CA**",{"_3624":1065,"_31165":949,"_21590":54211,"_5":14857,"_28357":53915,"_3076":54212},[],"Selected issuing CA certificate.",{"_3624":1066,"_31165":949,"_21590":54214,"_5":14857,"_28357":53915,"_3076":54215},[],"**Managed CAs**",{"_3624":1067,"_31165":949,"_21590":54217,"_5":14857,"_28357":53915,"_3076":54218},[],"Explicitly selected CA certificates.",{"_3624":1068,"_31165":949,"_21590":54220,"_5":14857,"_28357":53915,"_3076":54221},[],"All ancestors are not added automatically. Trust distribution distinguishes trusted roots, intermediates and initial server trust.",{"_3624":1069,"_31165":949,"_21590":54223,"_5":14857,"_28357":53919,"_3076":54224},[],"**Edit** changes name, settings and metadata. Updates go through the DMS API. `PUT /v1/dms/{id}` always targets the DMS identified by the URL path: the body carries no `id` field, and any `id` or `creation_ts` in it is silently ignored — authorization is evaluated against the same URL identifier. The body must include a non-empty `name` and a `settings` object; missing either returns HTTP 400 and leaves the stored DMS unchanged. `name` and `settings` are always full replacements, so read the DMS before sending API edits to avoid losing fields. `metadata` is optional: omitting it or sending `null` keeps the stored metadata, a supplied object replaces it entirely, and `{}` clears it (a later GET returns an empty object, not `null`). Old-style bodies that carry the full DMS object keep working while they include `name` and `settings`; unknown fields are ignored. Updates reject an empty `name` with HTTP 400: a DMS whose stored name was zeroed by an earlier update must be renamed before any client round-trips it — the AWS IoT connector’s JITP writeback included. If the object does not include the AWS IoT connector key (`lamassu.io/iot/{connector_id}`), the connector ignores the DMS's later events.",{"_3624":1070,"_31165":949,"_21590":54226,"_5":14857,"_28357":53919,"_3076":54227},[],"**Go to DMS owned devices** restricts inventory by owner. **Show/Edit Metadata** contains operational and integration data; consult the integration guide before changing it. &#x2A;*EST (RFC-7030)** helps locate URLs.",{"_3624":1071,"_31165":949,"_21590":54229,"_5":14857,"_28357":53919,"_3076":54230},[],"**Delete** removes the DMS record and configuration; it does not itself cascade revocation across every device and certificate. Migrate dependencies and retain audit references before retirement.",{"_3624":1072,"_31165":949,"_21590":54232,"_5":14857,"_28357":53923,"_3076":54233},[],"Continue with EST client or the enrollment and mTLS tutorial. EST reference covers formats; Troubleshooting covers failures.",{"_3624":1073,"_31165":1073,"_5":15217,"_3076":54235,"_31503":54236,"_21590":54237,"_28357":1073},"Integrate the EST client",[50900,52412,53584,53582,53768],[],{"_3624":1074,"_31165":1073,"_21590":54239,"_5":14857,"_28357":1073,"_3076":54240},[],"Prepare trust, send a CSR and check the identity you receive.",{"_3624":1075,"_31165":1073,"_5":31500,"_21590":54242,"_28357":54243,"_3076":50910},[],"/docs/platform/iot-fleets/enrollment/est-client#before-you-begin",{"_3624":1076,"_31165":1073,"_5":31500,"_21590":54245,"_28357":54246,"_3076":54247},[],"/docs/platform/iot-fleets/enrollment/est-client#download-and-inspect-cacerts","Download and inspect cacerts",{"_3624":1077,"_31165":1073,"_5":31500,"_21590":54249,"_28357":54250,"_3076":54251},[],"/docs/platform/iot-fleets/enrollment/est-client#prepare-the-csr","Prepare the CSR",{"_3624":1078,"_31165":1073,"_5":31500,"_21590":54253,"_28357":54254,"_3076":54255},[],"/docs/platform/iot-fleets/enrollment/est-client#request-the-identity","Request the identity",{"_3624":1079,"_31165":1073,"_5":31500,"_21590":54257,"_28357":54258,"_3076":54259},[],"/docs/platform/iot-fleets/enrollment/est-client#check-and-install-the-result","Check and install the result",{"_3624":1080,"_31165":1073,"_5":31500,"_21590":54261,"_28357":54262,"_3076":54263},[],"/docs/platform/iot-fleets/enrollment/est-client#next-steps","Next steps",{"_3624":1081,"_31165":1073,"_21590":54265,"_5":14857,"_28357":1073,"_3076":54266},[],"This guide is for those implementing the device client. The administrator must have prepared the DMS policy. For a complete first run, follow Enroll and connect your first device.",{"_3624":1082,"_31165":1073,"_21590":54268,"_5":14857,"_28357":54243,"_3076":54269},[],"You need the public HTTPS DMS URL, server trust obtained through an approved channel, the operation's authentication mode and an admitted identifier. The examples use Bash, OpenSSL 3.x and curl with `--fail-with-body`; use a private working directory and compatible versions of these tools.",{"_3624":1083,"_31165":1073,"_21590":54271,"_5":14857,"_28357":54243,"_3076":54272},[],"Prepare `est-trust.pem` to verify the EST server, `bootstrap.crt` and `bootstrap.key` for initial certificate authentication, and `device-root.pem` as the approved root of the device issuer. The two trust files can contain different roots. For another authentication mode, adapt the credentials according to Bootstrap identity.",{"_3624":1084,"_31165":1073,"_21590":54274,"_5":14857,"_28357":54243,"_3076":54275},[],"Replace the host and `REPLACE_DMS_ID` with those of your installation. The URL's APS is the DMS identifier, not its display name.",{"_3624":1085,"_31165":1073,"_21590":54277,"_5":14857,"_28357":54246,"_3076":54278},[],"The default content is Base64-encoded DER PKCS#7. It is not a direct PEM file.",{"_3624":1086,"_31165":1073,"_21590":54280,"_5":14857,"_28357":54246,"_3076":54281},[],"Check fingerprints, issuers and dates against the trust distribution policy. The response can contain a selection of CAs and Lamassu's TLS certificate. Do not turn the entire bundle into trusted roots or use it to authenticate its own initial download. HTTP 200 here does not prove that authentication or issuance works.",{"_3624":1087,"_31165":1073,"_21590":54283,"_5":14857,"_28357":54250,"_3076":54284},[],"The example generates a new EC P-256 key and uses `est-device-001`, which must be available if the DMS registers automatically. The `Common Name` becomes the device identifier. Check that the profile permits the selected key and subject.",{"_3624":1088,"_31165":1073,"_21590":54286,"_5":14857,"_28357":54250,"_3076":54287},[],"An implementation using hardware or its own store must produce the CSR through its resident key. `simpleenroll` sends the request and retains the key in the client. Honor Extensions does not authorize every requested attribute: see Profiles.",{"_3624":1089,"_31165":1073,"_21590":54289,"_5":14857,"_28357":54254,"_3076":54290},[],"With initial `CLIENT_CERTIFICATE` authentication, send the Base64-encoded DER CSR using `Content-Type: application/pkcs10`:",{"_3624":1090,"_31165":1073,"_21590":54292,"_5":14857,"_28357":54254,"_3076":54293},[],"Stop if curl fails. Retain the HTTP code, headers and body for diagnosis; an error response is not decoded as a certificate. The Bash example stops before that conversion. A timeout leaves the operation's result to be checked in Lamassu: do not automatically repeat issuance.",{"_3624":1091,"_31165":1073,"_21590":54295,"_5":14857,"_28357":54258,"_3076":54296},[],"For a root that issues directly:",{"_3624":1092,"_31165":1073,"_21590":54298,"_5":14857,"_28357":54258,"_3076":54299},[],"Also verify that the CN is correct, the certificate is a leaf, its uses permit your application and its dates satisfy the profile. `cmp` must exit with code 0. With intermediates, provide the chain through `-untrusted` as described in PKI validation.",{"_3624":1093,"_31165":1073,"_21590":54301,"_5":14857,"_28357":54258,"_3076":54302},[],"Query the device: the owning DMS, current serial number and history must match the result. Protect the key/certificate pair and install both using the device's mechanism. Association in Lamassu does not install files in the client. Check a real connection before considering the process complete.",{"_3624":1094,"_31165":1073,"_21590":54304,"_5":14857,"_28357":54262,"_3076":54305},[],"Implement renewal and recovery and trust updates. The EST reference covers endpoints, formats and ServerKeyGen; troubleshooting helps distinguish transport, admission and persistence failures.",{"_3624":1095,"_31165":1095,"_5":15217,"_3076":54307,"_31503":54308,"_21590":54309,"_28357":1095},"EST reference",[50900,52412,53584,53582,53768],[],{"_3624":1096,"_31165":1095,"_21590":54311,"_5":14857,"_28357":1095,"_3076":54312},[],"Look up Lamassu routes, formats, authentication and multipart responses.",{"_3624":1097,"_31165":1095,"_5":31500,"_21590":54314,"_28357":54315,"_3076":54316},[],"/docs/platform/iot-fleets/enrollment/est-reference#endpoint-reference","Endpoint reference",{"_3624":1098,"_31165":1095,"_5":31500,"_21590":54318,"_28357":54319,"_3076":23392},[],"/docs/platform/iot-fleets/enrollment/est-reference#cacerts",{"_3624":1099,"_31165":1095,"_5":31500,"_21590":54321,"_28357":54322,"_3076":26907},[],"/docs/platform/iot-fleets/enrollment/est-reference#simpleenroll",{"_3624":1100,"_31165":1095,"_5":31500,"_21590":54324,"_28357":54325,"_3076":26914},[],"/docs/platform/iot-fleets/enrollment/est-reference#simplereenroll",{"_3624":1101,"_31165":1095,"_5":31500,"_21590":54327,"_28357":54328,"_3076":26176},[],"/docs/platform/iot-fleets/enrollment/est-reference#serverkeygen",{"_3624":1102,"_31165":1095,"_5":31500,"_21590":54330,"_28357":54331,"_3076":54332},[],"/docs/platform/iot-fleets/enrollment/est-reference#response-format","Response format",{"_3624":1103,"_31165":1095,"_5":31500,"_21590":54334,"_28357":54335,"_3076":54336},[],"/docs/platform/iot-fleets/enrollment/est-reference#request-and-extraction","Request and extraction",{"_3624":1104,"_31165":1095,"_5":31500,"_21590":54338,"_28357":54339,"_3076":54340},[],"/docs/platform/iot-fleets/enrollment/est-reference#compatibility-notes","Compatibility notes",{"_3624":1105,"_31165":1095,"_21590":54342,"_5":14857,"_28357":1095,"_3076":54343},[],"Reference for the Lamassu EST service, based on RFC 7030. Use EST client for the procedure and DMS to configure policy.",{"_3624":1106,"_31165":1095,"_21590":54345,"_5":14857,"_28357":54315,"_3076":54346},[],"Public route in the examples: `/.well-known/est/{APS}/{operation}`. `APS` is the DMS ID. The router admits routes without that segment, but the controller requires it; do not use them as a default service. Gateway configuration determines the public host and route.",{"_3624":1107,"_31165":1095,"_21590":54348,"_5":14857,"_28357":54315,"_3076":54349},[],"Operation",{"_3624":1108,"_31165":1095,"_21590":54351,"_5":14857,"_28357":54315,"_3076":54352},[],"Method",{"_3624":1109,"_31165":1095,"_21590":54354,"_5":14857,"_28357":54315,"_3076":54355},[],"Authentication and condition",{"_3624":1110,"_31165":1095,"_21590":54357,"_5":14857,"_28357":54315,"_3076":54358},[],"`/cacerts`",{"_3624":1111,"_31165":1095,"_21590":54360,"_5":14857,"_28357":54315,"_3076":54361},[],"GET",{"_3624":1112,"_31165":1095,"_21590":54363,"_5":14857,"_28357":54315,"_3076":54364},[],"DMS reading does not require an EST credential; HTTPS and infrastructure controls still apply.",{"_3624":1113,"_31165":1095,"_21590":54366,"_5":14857,"_28357":54315,"_3076":54367},[],"`/simpleenroll`",{"_3624":1114,"_31165":1095,"_21590":54369,"_5":14857,"_28357":54315,"_3076":54370},[],"POST",{"_3624":1115,"_31165":1095,"_21590":54372,"_5":14857,"_28357":54315,"_3076":54373},[],"Initial authentication and DMS registration/replacement policy.",{"_3624":1116,"_31165":1095,"_21590":54375,"_5":14857,"_28357":54315,"_3076":54376},[],"`/simplereenroll`",{"_3624":1117,"_31165":1095,"_21590":54378,"_5":14857,"_28357":54315,"_3076":54370},[],{"_3624":1118,"_31165":1095,"_21590":54380,"_5":14857,"_28357":54315,"_3076":54381},[],"Renewal authentication, existing identity, subject, revocation and window.",{"_3624":1119,"_31165":1095,"_21590":54383,"_5":14857,"_28357":54315,"_3076":54384},[],"`/serverkeygen`",{"_3624":1120,"_31165":1095,"_21590":54386,"_5":14857,"_28357":54315,"_3076":54370},[],{"_3624":1121,"_31165":1095,"_21590":54388,"_5":14857,"_28357":54315,"_3076":54389},[],"Initial authentication and admission; server generation enabled.",{"_3624":1122,"_31165":1095,"_21590":54391,"_5":14857,"_28357":54315,"_3076":54392},[],"These routes do not implement `/csrattrs` or `/fullcmc`. There is no native JWT EST authentication mode; a webhook can interpret a request credential according to its own contract.",{"_3624":1123,"_31165":1095,"_21590":54394,"_5":14857,"_28357":54319,"_3076":54395},[],"The default response has `Content-Type: application/pkcs7-mime; smime-type=certs-only` and `Content-Transfer-Encoding: base64`. The body is Base64-encoded DER PKCS#7 with lines of up to 76 characters. It includes the certificates selected by the DMS, not necessarily every ancestor.",{"_3624":1124,"_31165":1095,"_21590":54397,"_5":14857,"_28357":54319,"_3076":54398},[],"`Accept: application/x-pem-file` requests the bundle in PEM through a Lamassu extension. Inspect and approve its contents before modifying trusted roots.",{"_3624":1125,"_31165":1095,"_21590":54400,"_5":14857,"_28357":54322,"_3076":54401},[],"Send a Base64-encoded DER PKCS#10 CSR with `Content-Type: application/pkcs10`. The controller compares that media type literally; avoid adding parameters such as charset. The CN identifies the device and the CSR signature must be verified through DMS policy.",{"_3624":1126,"_31165":1095,"_21590":54403,"_5":14857,"_28357":54322,"_3076":54404},[],"The default response uses the PKCS#7/Base64 format described for cacerts, but contains the issued certificate; do not assume it includes its entire chain. `Accept: application/x-pem-file` returns that certificate in PEM. The client retains the key that signed the CSR.",{"_3624":1127,"_31165":1095,"_21590":54406,"_5":14857,"_28357":54325,"_3076":54407},[],"Use the same request and certificate response formats. Authentication comes from the independent `reenrollment_settings.est_rfc7030_settings` block. With a client certificate, its CN must match the CSR CN; the subject is also checked against the current certificate.",{"_3624":1128,"_31165":1095,"_21590":54409,"_5":14857,"_28357":54325,"_3076":54410},[],"In mTLS mode, the enrollment CA always validates the re-enrollment credential; certificates from other issuers are accepted only if they are listed as validation CAs in the re-enrollment block. The expiry check through `enable_expired_renewal` belongs to that validator. A revoked current certificate and a request before the window are rejected. With default settings, a client certificate whose revocation cannot be verified is also rejected; the DMS guide describes `allow_unverifiable_revocation`. See Renewal for installation and recovery.",{"_3624":1129,"_31165":1095,"_21590":54412,"_5":14857,"_28357":54328,"_3076":54413},[],"The server generates a software key, rebuilds the CSR with that key and performs initial enrollment. The flag must be enabled and the algorithm permitted by the profile. This operation's key does not become a hardware key because the CA is hosted in an HSM.",{"_3624":1130,"_31165":1095,"_21590":54415,"_5":14857,"_28357":54328,"_3076":54416},[],"The code supports RSA and ECDSA, and the `bits` value of the DMS key setting means something different for each. For ECDSA it selects the curve: 224, 256, 384 or 521 map to P-224, P-256, P-384 and P-521, and an unrecognized size falls back to P-256, so explicitly select a compatible size and check the resulting key. For RSA it is used directly as the modulus size; the console offers 2048, 3072 and 4096 bits. Do not reuse an enrolled ID to test this operation without reviewing replacement.",{"_3624":1131,"_31165":1095,"_21590":54418,"_5":14857,"_28357":54331,"_3076":54419},[],"The body is **MIME multipart/mixed**, with the boundary specified in `Content-Type`. It contains two parts:",{"_3624":1132,"_31165":1095,"_21590":54421,"_5":14857,"_28357":54331,"_3076":54422},[],"Part",{"_3624":1133,"_31165":1095,"_21590":54424,"_5":14857,"_28357":54331,"_3076":54425},[],"Content after decoding its Base64",{"_3624":1134,"_31165":1095,"_21590":54427,"_5":14857,"_28357":54331,"_3076":54428},[],"`application/pkcs8`",{"_3624":1135,"_31165":1095,"_21590":54430,"_5":14857,"_28357":54331,"_3076":54431},[],"Unencrypted DER PKCS#8 private key.",{"_3624":1136,"_31165":1095,"_21590":54433,"_5":14857,"_28357":54331,"_3076":54434},[],"`application/pkcs7-mime; smime-type=certs-only`",{"_3624":1137,"_31165":1095,"_21590":54436,"_5":14857,"_28357":54331,"_3076":54437},[],"DER PKCS#7 containing the issued certificate.",{"_3624":1138,"_31165":1095,"_21590":54439,"_5":14857,"_28357":54331,"_3076":54440},[],"The controller also adds `Content-Transfer-Encoding: base64` to the outer header, although the outer body is MIME text. &#x2A;*Do not Base64-decode the entire body.** Read the actual boundary and decode each part according to its headers.",{"_3624":1139,"_31165":1095,"_21590":54442,"_5":14857,"_28357":54335,"_3076":54443},[],"In a Bash session with `set -euo pipefail` and `umask 077`, use `EST_BASE` and the trust/bootstrap files from EST client. Select an available and admitted `est-serverkeygen-001`. The `server-request.key` only signs the input CSR; the received identity uses the server-generated key.",{"_3624":1140,"_31165":1095,"_21590":54445,"_5":14857,"_28357":54335,"_3076":54446},[],"Save this Python 3 extractor. It validates both parts before writing and rejects existing output files:",{"_3624":1141,"_31165":1095,"_21590":54448,"_5":14857,"_28357":54335,"_3076":54449},[],"Convert and check the result:",{"_3624":1142,"_31165":1095,"_21590":54451,"_5":14857,"_28357":54335,"_3076":54452},[],"Inspect the CN, serial, dates and uses; check association in Lamassu before installing. Protect the DER and PEM files containing the key and remove temporary copies according to the device's storage mechanism. See openssl-pkcs8 and the Python MIME parser.",{"_3624":1143,"_31165":1095,"_21590":54454,"_5":14857,"_28357":54339,"_3076":54455},[],"Do not interpret every 500 as a transient failure. Invalid input typically produces 400; service denials and errors typically produce 500 with a JSON `err` body. Gateway errors and some controller paths can have another format. Retain headers and body before decoding and see troubleshooting.",{"_3624":1144,"_31165":1095,"_21590":54457,"_5":14857,"_28357":54339,"_3076":54458},[],"The examples use openssl-pkcs7 to extract certificates and openssl-x509 to prepare renewal. Check your version's capabilities and responses before integrating a generic EST client.",{"_3624":1145,"_31165":1145,"_5":15217,"_3076":53768,"_31503":54460,"_21590":54461,"_28357":1145},[50900,52412,53584,53582,53768],[],{"_3624":1146,"_31165":1145,"_21590":54463,"_5":14857,"_28357":1145,"_3076":54464},[],"Choose admission policy and connect DMS, initial trust and the EST client.",{"_3624":1147,"_31165":1145,"_5":31500,"_21590":54466,"_28357":54467,"_3076":54468},[],"/docs/platform/iot-fleets/enrollment/overview#the-journey","The journey",{"_3624":1148,"_31165":1145,"_5":31500,"_21590":54470,"_28357":54471,"_3076":54472},[],"/docs/platform/iot-fleets/enrollment/overview#for-the-administrator","For the administrator",{"_3624":1149,"_31165":1145,"_5":31500,"_21590":54474,"_28357":54475,"_3076":54476},[],"/docs/platform/iot-fleets/enrollment/overview#for-the-integrator","For the integrator",{"_3624":1150,"_31165":1145,"_21590":54478,"_5":14857,"_28357":1145,"_3076":54479},[],"Enrollment with PKI covers the path from device admission to identity installation and renewal. The DMS acts as a registration authority: it authenticates the request, applies registration policy and asks the CA to sign. The client keeps or receives the key, installs the result and presents it to the consumer.",{"_3624":1151,"_31165":1145,"_21590":54481,"_5":14857,"_28357":54467,"_3076":54482},[],"The administrator prepares the CA, issuance profile and DMS.",{"_3624":1152,"_31165":1145,"_21590":54484,"_5":14857,"_28357":54467,"_3076":54485},[],"The integrator installs initial EST server trust and an admission credential.",{"_3624":1153,"_31165":1145,"_21590":54487,"_5":14857,"_28357":54467,"_3076":54488},[],"The client requests an identity for its `Device ID` through EST.",{"_3624":1154,"_31165":1145,"_21590":54490,"_5":14857,"_28357":54467,"_3076":54491},[],"Certificate, device binding and key/certificate installation are checked.",{"_3624":1155,"_31165":1145,"_21590":54493,"_5":14857,"_28357":54467,"_3076":54494},[],"The consumer validates and authorizes the identity; the client schedules renewal and recovery.",{"_3624":1156,"_31165":1145,"_21590":54496,"_5":14857,"_28357":54467,"_3076":54497},[],"EST uses `/.well-known/est/{DMS_ID}`. Administrative APIs and manual assignment remain separate paths. Enroll and connect a device completes an initial mTLS test.",{"_3624":1157,"_31165":1145,"_21590":54499,"_5":14857,"_28357":54471,"_3076":54500},[],"<Card title=\"Provisioning strategies\" description=\"Choose automatic registration, preregistration or manual assignment.\" href=\"/docs/platform/iot-fleets/enrollment/provisioning-strategies\" />",{"_3624":1158,"_31165":1145,"_21590":54502,"_5":14857,"_28357":54471,"_3076":54503},[],"<Card title=\"Configure the DMS\" description=\"Separate admission, authentication per operation, profiles and distribution.\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_3624":1159,"_31165":1145,"_21590":54505,"_5":14857,"_28357":54471,"_3076":54506},[],"<Card title=\"Bootstrap identity and authentication\" description=\"Decide which proof allows requesting the first identity.\" href=\"/docs/platform/iot-fleets/enrollment/bootstrap-identity\" />",{"_3624":1160,"_31165":1145,"_21590":54508,"_5":14857,"_28357":54471,"_3076":54509},[],"<Card title=\"Trust distribution\" description=\"Update roots and chains with verified overlap.\" href=\"/docs/platform/iot-fleets/enrollment/trust-distribution\" />",{"_3624":1161,"_31165":1145,"_21590":54511,"_5":14857,"_28357":54475,"_3076":54512},[],"<Card title=\"EST client\" description=\"Prepare the request, verify the response and install the identity.\" href=\"/docs/platform/iot-fleets/enrollment/est-client\" />",{"_3624":1162,"_31165":1145,"_21590":54514,"_5":14857,"_28357":54475,"_3076":54515},[],"<Card title=\"Renewal and recovery\" description=\"Generate the successor and handle expired or lost credentials.\" href=\"/docs/platform/iot-fleets/enrollment/renewal-and-recovery\" />",{"_3624":1163,"_31165":1145,"_21590":54517,"_5":14857,"_28357":54475,"_3076":54518},[],"<Card title=\"EST reference\" description=\"Look up paths, formats, authentication and ServerKeyGen.\" href=\"/docs/platform/iot-fleets/enrollment/est-reference\" />",{"_3624":1164,"_31165":1145,"_21590":54520,"_5":14857,"_28357":54475,"_3076":54521},[],"<Card title=\"Troubleshooting\" description=\"Distinguish transport, policy, issuance and installation failures.\" href=\"/docs/platform/iot-fleets/enrollment/troubleshooting\" />",{"_3624":1165,"_31165":1145,"_21590":54523,"_5":14857,"_28357":54475,"_3076":54524},[],"Gateway, TLS, provider and service configuration belongs to Deployment. Identity use in AWS or other destinations belongs to Integrations.",{"_3624":1166,"_31165":1166,"_5":15217,"_3076":54526,"_31503":54527,"_21590":54528,"_28357":1166},"Provisioning strategies",[50900,52412,53584,53582,53768],[],{"_3624":1167,"_31165":1166,"_21590":54530,"_5":14857,"_28357":1166,"_3076":54531},[],"Choose device registration, identity authorization and key generation.",{"_3624":1168,"_31165":1166,"_5":31500,"_21590":54533,"_28357":54534,"_3076":54535},[],"/docs/platform/iot-fleets/enrollment/provisioning-strategies#choose-registration","Choose registration",{"_3624":1169,"_31165":1166,"_5":31500,"_21590":54537,"_28357":54538,"_3076":54539},[],"/docs/platform/iot-fleets/enrollment/provisioning-strategies#preregistration-and-replacement","Preregistration and replacement",{"_3624":1170,"_31165":1166,"_5":31500,"_21590":54541,"_28357":54542,"_3076":54543},[],"/docs/platform/iot-fleets/enrollment/provisioning-strategies#choose-authentication","Choose authentication",{"_3624":1171,"_31165":1166,"_5":31500,"_21590":54545,"_28357":54546,"_3076":54547},[],"/docs/platform/iot-fleets/enrollment/provisioning-strategies#choose-custody","Choose custody",{"_3624":1172,"_31165":1166,"_5":31500,"_21590":54549,"_28357":54550,"_3076":54551},[],"/docs/platform/iot-fleets/enrollment/provisioning-strategies#check-the-decision","Check the decision",{"_3624":1173,"_31165":1166,"_21590":54553,"_5":14857,"_28357":1166,"_3076":54554},[],"This guide helps the provisioning administrator choose a path before configuring the DMS. Separate three decisions: when the device exists, how its request is authorized and who generates its key. None grants destination access by itself.",{"_3624":1174,"_31165":1166,"_21590":54556,"_5":14857,"_28357":54534,"_3076":54557},[],"Path",{"_3624":1175,"_31165":1166,"_21590":54559,"_5":14857,"_28357":54534,"_3076":54560},[],"When the device exists",{"_3624":1176,"_31165":1166,"_21590":54562,"_5":14857,"_28357":54534,"_3076":54563},[],"What to check",{"_3624":1177,"_31165":1166,"_21590":54565,"_5":14857,"_28357":54534,"_3076":54566},[],"Manual assignment",{"_3624":1178,"_31165":1166,"_21590":54568,"_5":14857,"_28357":54534,"_3076":54569},[],"An operator creates it before associating a certificate.",{"_3624":1179,"_31165":1166,"_21590":54571,"_5":14857,"_28357":54534,"_3076":54572},[],"ID, owning DMS, certificate CN and bound serial.",{"_3624":1180,"_31165":1166,"_21590":54574,"_5":14857,"_28357":54534,"_3076":54575},[],"EST with `JITP`",{"_3624":1181,"_31165":1166,"_21590":54577,"_5":14857,"_28357":54534,"_3076":54578},[],"Created for an unknown CN during `/simpleenroll`.",{"_3624":1182,"_31165":1166,"_21590":54580,"_5":14857,"_28357":54534,"_3076":54581},[],"Authorized credential, unused ID, profile, resulting registration and identity.",{"_3624":1183,"_31165":1166,"_21590":54583,"_5":14857,"_28357":54534,"_3076":54584},[],"EST with `PRE_REGISTRATION`",{"_3624":1184,"_31165":1166,"_21590":54586,"_5":14857,"_28357":54534,"_3076":54587},[],"Must exist before `/simpleenroll`.",{"_3624":1185,"_31165":1166,"_21590":54589,"_5":14857,"_28357":54534,"_3076":54590},[],"Approved record, same DMS and replacement conditions for your version.",{"_3624":1186,"_31165":1166,"_21590":54592,"_5":14857,"_28357":54534,"_3076":54593},[],"Lamassu `JITP` creates inventory and identity in Lamassu. AWS JITP provisions a destination in AWS; these are separate decisions.",{"_3624":1187,"_31165":1166,"_21590":54595,"_5":14857,"_28357":54534,"_3076":54596},[],"For an initial client test, use Enroll and connect a device. To prepare inventory without EST, follow Manual registration.",{"_3624":1188,"_31165":1166,"_21590":54598,"_5":14857,"_28357":54538,"_3076":54599},[],"Finding any device owned by the same DMS triggers the `enable_replaceable_enrollment` check before PRE\\_REGISTRATION. With the flag disabled, a preregistered device can receive `forbiddenNewEnrollment` even in **No Identity**. Selecting PRE\\_REGISTRATION alone therefore does not establish a working path.",{"_3624":1189,"_31165":1166,"_21590":54601,"_5":14857,"_28357":54538,"_3076":54602},[],"Enabling the flag permits repeated `/simpleenroll` for an existing ID. The backend schedules a deferred attempt to revoke the previous certificate with `Superseded`; it can also run if later issuance or binding fails. Without an identity, that attempt can fail because no serial exists. The flag does not provide a replacement transaction or guarantee restoration of previous state.",{"_3624":1190,"_31165":1166,"_21590":54604,"_5":14857,"_28357":54538,"_3076":54605},[],"Test the exact case on your version before enabling it for a population. For an operational identity with authorized renewal, use `/simplereenroll`; for recovery, follow Renewal and recovery and check persisted state before retrying.",{"_3624":1191,"_31165":1166,"_21590":54607,"_5":14857,"_28357":54542,"_3076":54608},[],"Decide initial enrollment and re-enrollment separately:",{"_3624":1192,"_31165":1166,"_21590":54610,"_5":14857,"_28357":54542,"_3076":54611},[],"**Client certificate:** useful when each device has an initial credential whose key it controls.",{"_3624":1193,"_31165":1166,"_21590":54613,"_5":14857,"_28357":54542,"_3076":54614},[],"**Webhook:** useful when another authority knows inventory, credentials or entitlement to a requested ID.",{"_3624":1194,"_31165":1166,"_21590":54616,"_5":14857,"_28357":54542,"_3076":54617},[],"**Certificate and webhook:** requires both controls in the configured operation.",{"_3624":1195,"_31165":1166,"_21590":54619,"_5":14857,"_28357":54542,"_3076":54620},[],"**NO\\_AUTH:** does not establish requester identity; appropriate only when admission is deliberately controlled outside that DMS.",{"_3624":1196,"_31165":1166,"_21590":54622,"_5":14857,"_28357":54542,"_3076":54623},[],"Authenticating an initial certificate does not itself establish entitlement to choose any CSR CN. Define that authorization in Bootstrap identity and authentication.",{"_3624":1197,"_31165":1166,"_21590":54625,"_5":14857,"_28357":54546,"_3076":51284},[],{"_3624":1198,"_31165":1166,"_21590":54627,"_5":14857,"_28357":54546,"_3076":54628},[],"Material crossing EST",{"_3624":1199,"_31165":1166,"_21590":54630,"_5":14857,"_28357":54546,"_3076":54631},[],"Device-generated key",{"_3624":1200,"_31165":1166,"_21590":54633,"_5":14857,"_28357":54546,"_3076":54634},[],"Public CSR and certificate; the key stays on the client.",{"_3624":1201,"_31165":1166,"_21590":54636,"_5":14857,"_28357":54546,"_3076":54637},[],"Existing device key",{"_3624":1202,"_31165":1166,"_21590":54639,"_5":14857,"_28357":54546,"_3076":54640},[],"CSR signed with that key and a new certificate.",{"_3624":1203,"_31165":1166,"_21590":54642,"_5":14857,"_28357":54546,"_3076":53912},[],{"_3624":1204,"_31165":1166,"_21590":54644,"_5":14857,"_28357":54546,"_3076":54645},[],"Private PKCS#8 key and certificate in a TLS-protected multipart response.",{"_3624":1205,"_31165":1166,"_21590":54647,"_5":14857,"_28357":54546,"_3076":54648},[],"ServerKeyGen does not automatically use the CA’s HSM or KMS for the device key. Review its contract and extraction and the device’s ability to install the material.",{"_3624":1206,"_31165":1166,"_21590":54650,"_5":14857,"_28357":54550,"_3076":54651},[],"Before expanding the flow, test allowed registration, incorrect credentials, an ID owned by another DMS, repeated requests and recovery after failure. Keep ID, serial, active version and error. Also test consumer acceptance and rejection; issuance does not imply destination registration or permission to operate.",{"_3624":1207,"_31165":1207,"_5":15217,"_3076":54653,"_31503":54654,"_21590":54655,"_28357":1207},"Renewal and recovery",[50900,52412,53584,53582,53768],[],{"_3624":1208,"_31165":1207,"_21590":54657,"_5":14857,"_28357":1207,"_3076":54658},[],"Renew without losing the identity and recover devices according to their actual state.",{"_3624":1209,"_31165":1207,"_5":31500,"_21590":54660,"_28357":54661,"_3076":54662},[],"/docs/platform/iot-fleets/enrollment/renewal-and-recovery#prepare-renewal","Prepare renewal",{"_3624":1210,"_31165":1207,"_5":31500,"_21590":54664,"_28357":54665,"_3076":54666},[],"/docs/platform/iot-fleets/enrollment/renewal-and-recovery#request-the-successor-certificate","Request the successor certificate",{"_3624":1211,"_31165":1207,"_5":31500,"_21590":54668,"_28357":54669,"_3076":54670},[],"/docs/platform/iot-fleets/enrollment/renewal-and-recovery#install-and-check-the-new-pair","Install and check the new pair",{"_3624":1212,"_31165":1207,"_5":31500,"_21590":54672,"_28357":54673,"_3076":54674},[],"/docs/platform/iot-fleets/enrollment/renewal-and-recovery#recover-according-to-state","Recover according to state",{"_3624":1213,"_31165":1207,"_5":31500,"_21590":54676,"_28357":54677,"_3076":54678},[],"/docs/platform/iot-fleets/enrollment/renewal-and-recovery#continuous-operation","Continuous operation",{"_3624":1214,"_31165":1207,"_21590":54680,"_5":14857,"_28357":1207,"_3076":54681},[],"Renewal retains the device identifier and requests a successor certificate. The client must complete the process: check the response, install the matching pair and demonstrate that the consumer accepts it. Lamassu alerts notify you; they do not perform those steps.",{"_3624":1215,"_31165":1207,"_21590":54683,"_5":14857,"_28357":54661,"_3076":54684},[],"Query the current certificate in Lamassu and compare it with the installed certificate. You need its subject, serial and dates, as well as the client key.",{"_3624":1216,"_31165":1207,"_21590":54686,"_5":14857,"_28357":54661,"_3076":54687},[],"Check the **re-enrollment** authentication mode: it is independent of initial authentication. With `CLIENT_CERTIFICATE`, use the current identity; do not assume the bootstrap credential is admitted.",{"_3624":1217,"_31165":1207,"_21590":54689,"_5":14857,"_28357":54661,"_3076":54690},[],"Calculate the window's start: the current certificate's `NotAfter` minus `reenrollment_delta`. Preventive and critical thresholds produce states/notifications; they do not extend that window.",{"_3624":1218,"_31165":1207,"_21590":54692,"_5":14857,"_28357":54661,"_3076":54693},[],"Review **Revoke on Re-enrollment** and recovery if installation fails. When enabled, Lamassu can revoke the previous identity before the client installs the new one.",{"_3624":1219,"_31165":1207,"_21590":54695,"_5":14857,"_28357":54665,"_3076":54696},[],"The example continues the EST tutorial, in the same Bash session with `set -euo pipefail`, `umask 077` and `EST_BASE`. Use a new key compatible with the profile. Conversion from the certificate preserves the subject and copies only SAN when present; check the subject and requested names before sending it. The backend checks the subject against the current identity: it attempts RawSubject equality and then compares CN, OU, O, L, ST and C. Rebuilding only the CN can lose required attributes.",{"_3624":1220,"_31165":1207,"_21590":54698,"_5":14857,"_28357":54665,"_3076":54699},[],"The request authenticates with `device.crt` and `device.key`; the CSR contains the new public key. Also check extensions, dates and correspondence of the serial with the current slot in Lamassu. Do not resubmit a failed request without querying that state: issuance, previous revocation and successor binding can have partial results.",{"_3624":1221,"_31165":1207,"_21590":54701,"_5":14857,"_28357":54669,"_3076":54702},[],"Keep the result as `device.next.crt` and `device.next.key` until verified. Switch the pair through a coordinated operation in the device store or configuration; avoid temporarily exposing a certificate with another version's key.",{"_3624":1222,"_31165":1207,"_21590":54704,"_5":14857,"_28357":54669,"_3076":54705},[],"Test mTLS with the consumer and verify that it uses the new serial. Confirm the history and current certificate in Lamassu. If **Revoke on Re-enrollment** was disabled, the previous identity can remain valid: retire it according to PKI policy after testing the successor, and check revocation publication and consumption.",{"_3624":1223,"_31165":1207,"_21590":54707,"_5":14857,"_28357":54669,"_3076":54708},[],"If the previous identity is already revoked, retaining its files does not restore a valid connection. Recovery requires an admitted credential and authorized intervention according to the situation.",{"_3624":1224,"_31165":1207,"_21590":54710,"_5":14857,"_28357":54673,"_3076":54711},[],"Situation",{"_3624":1225,"_31165":1207,"_21590":54713,"_5":14857,"_28357":54673,"_3076":54714},[],"Procedure",{"_3624":1226,"_31165":1207,"_21590":54716,"_5":14857,"_28357":54673,"_3076":54717},[],"Valid certificate, outside the window",{"_3624":1227,"_31165":1207,"_21590":54719,"_5":14857,"_28357":54673,"_3076":54720},[],"Schedule the request within the window. Do not use `simpleenroll` to bypass it.",{"_3624":1228,"_31165":1207,"_21590":54722,"_5":14857,"_28357":54673,"_3076":54723},[],"Expired certificate, key available",{"_3624":1229,"_31165":1207,"_21590":54725,"_5":14857,"_28357":54673,"_3076":54726},[],"With certificate authentication, review `enable_expired_renewal` and whether Gateway permits presenting that credential. Revocation, subject and the remaining checks still apply.",{"_3624":1230,"_31165":1207,"_21590":54728,"_5":14857,"_28357":54673,"_3076":54729},[],"Renewal through webhook or `NO_AUTH`",{"_3624":1231,"_31165":1207,"_21590":54731,"_5":14857,"_28357":54673,"_3076":54732},[],"The mTLS expiry check does not run in these modes. Define expiry and authorization policy in the corresponding admission process; the flag is not a universal prohibition.",{"_3624":1232,"_31165":1207,"_21590":54734,"_5":14857,"_28357":54673,"_3076":54735},[],"Lost or inaccessible key",{"_3624":1233,"_31165":1207,"_21590":54737,"_5":14857,"_28357":54673,"_3076":54738},[],"You cannot prove possession of the previous identity. Authorize new admission and, if appropriate, controlled replacement; revoke the compromised identity.",{"_3624":1234,"_31165":1207,"_21590":54740,"_5":14857,"_28357":54673,"_3076":54741},[],"Current identity revoked",{"_3624":1235,"_31165":1207,"_21590":54743,"_5":14857,"_28357":54673,"_3076":54744},[],"`simplereenroll` rejects the revoked current certificate. Investigate the reason and prepare an authorized readmission procedure; do not disable authentication to force it.",{"_3624":1236,"_31165":1207,"_21590":54746,"_5":14857,"_28357":54673,"_3076":54747},[],"Device without an identity",{"_3624":1237,"_31165":1207,"_21590":54749,"_5":14857,"_28357":54673,"_3076":54750},[],"Use initial enrollment. For an existing entry, check the replacement restriction in provisioning.",{"_3624":1238,"_31165":1207,"_21590":54752,"_5":14857,"_28357":54673,"_3076":54753},[],"Retired device",{"_3624":1239,"_31165":1207,"_21590":54755,"_5":14857,"_28357":54673,"_3076":54756},[],"Review the operational decision before readmission. Decommissioned state and revocation of the entire history are not equivalent.",{"_3624":1240,"_31165":1207,"_21590":54758,"_5":14857,"_28357":54673,"_3076":54759},[],"Timeout, HTTP 500 or installation failure",{"_3624":1241,"_31165":1207,"_21590":54761,"_5":14857,"_28357":54673,"_3076":54762},[],"Inspect the device, issued certificates and history before retrying. A successor may have been issued or the previous identity revoked.",{"_3624":1242,"_31165":1207,"_21590":54764,"_5":14857,"_28357":54677,"_3076":54765},[],"Schedule renewal with time for disconnections, trust distribution and consumer checks. Stagger requests across the population and bound retries within the window; authentication, subject and policy errors require correcting their cause. Maintain an admitted and tested recovery mechanism for lost keys and pairs that could not be installed.",{"_3624":1243,"_31165":1207,"_21590":54767,"_5":14857,"_28357":54677,"_3076":54768},[],"Continue with Trust distribution, Devices and identities and Troubleshooting.",{"_3624":1244,"_31165":1244,"_5":15217,"_3076":54770,"_31503":54771,"_21590":54772,"_28357":1244},"Enrollment troubleshooting",[50900,52412,53584,53582,53768],[],{"_3624":1245,"_31165":1244,"_21590":54774,"_5":14857,"_28357":1244,"_3076":54775},[],"Locate transport, authentication, registration, issuance and installation failures.",{"_3624":1246,"_31165":1244,"_5":31500,"_21590":54777,"_28357":54778,"_3076":54779},[],"/docs/platform/iot-fleets/enrollment/troubleshooting#diagnostics-and-compatibility","Diagnostics and compatibility",{"_3624":1247,"_31165":1244,"_5":31500,"_21590":54781,"_28357":54782,"_3076":54783},[],"/docs/platform/iot-fleets/enrollment/troubleshooting#error-codes-and-diagnostics","Error codes and diagnostics",{"_3624":1248,"_31165":1244,"_5":31500,"_21590":54785,"_28357":54786,"_3076":54340},[],"/docs/platform/iot-fleets/enrollment/troubleshooting#compatibility-notes",{"_3624":1249,"_31165":1244,"_5":31500,"_21590":54788,"_28357":54789,"_3076":54790},[],"/docs/platform/iot-fleets/enrollment/troubleshooting#est-enrollment-fails","EST enrollment fails",{"_3624":1250,"_31165":1244,"_21590":54792,"_5":14857,"_28357":1244,"_3076":54793},[],"Diagnose one operation and device at a time. Record the DMS/APS, endpoint, time, HTTP code, presented serial and CSR CN. Retain the response without including private keys or webhook credentials in the report.",{"_3624":1251,"_31165":1244,"_21590":54795,"_5":14857,"_28357":54782,"_3076":54796},[],"The EST controller normally returns 400 when rejecting input and 500 when the service rejects or fails the operation. A 500 can also represent a policy denial; it does not mean retrying is safe. Gateway can produce its own codes and bodies. Examine the actual body and persisted result.",{"_3624":1252,"_31165":1244,"_21590":54798,"_5":14857,"_28357":54782,"_3076":54799},[],"Symptom or message",{"_3624":1253,"_31165":1244,"_21590":54801,"_5":14857,"_28357":54782,"_3076":54563},[],{"_3624":1254,"_31165":1244,"_21590":54803,"_5":14857,"_28357":54782,"_3076":54804},[],"curl rejects TLS, name or issuer",{"_3624":1255,"_31165":1244,"_21590":54806,"_5":14857,"_28357":54782,"_3076":54807},[],"URL, clock, server SAN and approved root in `est-trust.pem`. Resolve trust in Deployment; do not skip verification.",{"_3624":1256,"_31165":1244,"_21590":54809,"_5":14857,"_28357":54782,"_3076":54810},[],"404 or missing APS",{"_3624":1257,"_31165":1244,"_21590":54812,"_5":14857,"_28357":54782,"_3076":54813},[],"Public route `/.well-known/est/{DMS_ID}/{operation}` and existing DMS. APS is not the service name.",{"_3624":1258,"_31165":1244,"_21590":54815,"_5":14857,"_28357":54782,"_3076":54816},[],"400, CSR or format error",{"_3624":1259,"_31165":1244,"_21590":54818,"_5":14857,"_28357":54782,"_3076":54819},[],"`Content-Type: application/pkcs10`, Base64 of DER, valid signature and a body preserved without double encoding.",{"_3624":1260,"_31165":1244,"_21590":54821,"_5":14857,"_28357":54782,"_3076":54822},[],"Missing credential or invalid certificate",{"_3624":1261,"_31165":1244,"_21590":54824,"_5":14857,"_28357":54782,"_3076":54825},[],"Operation mode, validating CA, dates, revocation and credential delivery by Gateway. Do not confuse server TLS trust with the bootstrap CA.",{"_3624":1262,"_31165":1244,"_21590":54827,"_5":14857,"_28357":54782,"_3076":54828},[],"Enroll or re-enroll rejects a certificate for unverifiable revocation",{"_3624":1263,"_31165":1244,"_21590":54830,"_5":14857,"_28357":54782,"_3076":54831},[],"Whether the certificate is managed by Lamassu, whether its OCSP/CRL endpoints are configured and reachable from the service, and whether `allow_unverifiable_revocation` is set for that operation's block. See DMS and Revocation and checks.",{"_3624":1264,"_31165":1244,"_21590":54833,"_5":14857,"_28357":54782,"_3076":54834},[],"Webhook denies, times out or responds without authorization",{"_3624":1265,"_31165":1244,"_21590":54836,"_5":14857,"_28357":54782,"_3076":54837},[],"Configuration, connectivity and JSON response with `authorized: true`. There is no automatic fallback to `NO_AUTH`.",{"_3624":1266,"_31165":1244,"_21590":54839,"_5":14857,"_28357":54782,"_3076":54840},[],"`unexpected status code: <n>: redirects are not followed`",{"_3624":1267,"_31165":1244,"_21590":54842,"_5":14857,"_28357":54782,"_3076":54843},[],"The webhook answered with a redirect. Configure the final absolute `http` or `https` URL in the webhook config; redirects are never followed.",{"_3624":1268,"_31165":1244,"_21590":54845,"_5":14857,"_28357":54782,"_3076":54846},[],"`webhook response exceeds 1048576 bytes`",{"_3624":1269,"_31165":1244,"_21590":54848,"_5":14857,"_28357":54782,"_3076":54849},[],"The receiver returned more than 1 MiB of JSON. Reduce the response of the authorization webhook.",{"_3624":1270,"_31165":1244,"_21590":54851,"_5":14857,"_28357":54782,"_3076":54852},[],"`webhook config must not reference files`",{"_3624":1271,"_31165":1244,"_21590":54854,"_5":14857,"_28357":54782,"_3076":54855},[],"The webhook config points to files (`ca_cert_file`, `mtls_options.cert_file`, `mtls_options.key_file`). For mTLS, enter the certificate and key as Base64-encoded PEM in `cert_content` and `key_content`, or as plain PEM; remove any other file field, including `ca_cert_file`, which has no inline equivalent (the receiver certificate must chain to the system trust store). See the webhook credentials guidance in DMS.",{"_3624":1272,"_31165":1244,"_21590":54857,"_5":14857,"_28357":54782,"_3076":54858},[],"`mtls_options.cert_content must be base64-encoded PEM`",{"_3624":1273,"_31165":1244,"_21590":54860,"_5":14857,"_28357":54782,"_3076":54861},[],"The value is neither Base64-encoded PEM nor plain PEM: it is a file path or Base64 of non-PEM data. Enter the certificate and key as Base64-encoded PEM, like certificates elsewhere in the API, or as plain PEM (see the webhook settings in DMS). The same message names `mtls_options.key_content` when the key is the offending value.",{"_3624":1274,"_31165":1244,"_21590":54863,"_5":14857,"_28357":54782,"_3076":54864},[],"`webhook mTLS certificate and key are invalid: …`",{"_3624":1275,"_31165":1244,"_21590":54866,"_5":14857,"_28357":54782,"_3076":54867},[],"The certificate and key do not form a matching pair. Enter both values from the same pair; the check runs when the DMS is saved and again on every webhook call.",{"_3624":1276,"_31165":1244,"_21590":54869,"_5":14857,"_28357":54782,"_3076":54870},[],"400 `struct validation error` creating or updating a DMS",{"_3624":1277,"_31165":1244,"_21590":54872,"_5":14857,"_28357":54782,"_3076":54873},[],"The webhook config of the operation that uses it is invalid. Review `external_webhook_settings` in DMS.",{"_3624":1278,"_31165":1244,"_21590":54875,"_5":14857,"_28357":54782,"_3076":54876},[],"HTTP 500 with an `err` body on enroll or reenroll",{"_3624":1279,"_31165":1244,"_21590":54878,"_5":14857,"_28357":54782,"_3076":54879},[],"Service failures reach the EST client as 500 with a body of `err` plus the message; webhook authorization errors are named there.",{"_3624":1280,"_31165":1244,"_21590":54881,"_5":14857,"_28357":54782,"_3076":54882},[],"`device not preregistered`",{"_3624":1281,"_31165":1244,"_21590":54884,"_5":14857,"_28357":54782,"_3076":54885},[],"PRE\\_REGISTRATION requires an existing inventory entry.",{"_3624":1282,"_31165":1244,"_21590":54887,"_5":14857,"_28357":54782,"_3076":54888},[],"`forbiddenNewEnrollment`",{"_3624":1283,"_31165":1244,"_21590":54890,"_5":14857,"_28357":54782,"_3076":54891},[],"An existing device requires replacement to be enabled, even in No Identity. Investigate before enabling the flag.",{"_3624":1284,"_31165":1244,"_21590":54893,"_5":14857,"_28357":54782,"_3076":54894},[],"Different owning DMS",{"_3624":1285,"_31165":1244,"_21590":54896,"_5":14857,"_28357":54782,"_3076":54897},[],"CN/ID, global inventory and owning DMS; do not reuse an ID from another context.",{"_3624":1286,"_31165":1244,"_21590":54899,"_5":14857,"_28357":54782,"_3076":54900},[],"`invalid RawSubject bytes`",{"_3624":1287,"_31165":1244,"_21590":54902,"_5":14857,"_28357":54782,"_3076":54903},[],"CSR subject versus the current certificate. Preserve its attributes as well as its CN.",{"_3624":1288,"_31165":1244,"_21590":54905,"_5":14857,"_28357":54782,"_3076":54906},[],"`invalid reenroll window`",{"_3624":1289,"_31165":1244,"_21590":54908,"_5":14857,"_28357":54782,"_3076":54909},[],"Current identity's NotAfter and reenrollment\\_delta. Alert thresholds do not change that window.",{"_3624":1290,"_31165":1244,"_21590":54911,"_5":14857,"_28357":54782,"_3076":54912},[],"Current certificate revoked",{"_3624":1291,"_31165":1244,"_21590":54914,"_5":14857,"_28357":54782,"_3076":54915},[],"Renewal rejected; prepare authorized recovery according to the cause.",{"_3624":1292,"_31165":1244,"_21590":54917,"_5":14857,"_28357":54782,"_3076":54918},[],"CA, profile or signing error",{"_3624":1293,"_31165":1244,"_21590":54920,"_5":14857,"_28357":54782,"_3076":54921},[],"Active CA, available key, selected profile and restrictions. Successful cacerts does not prove issuance.",{"_3624":1294,"_31165":1244,"_21590":54923,"_5":14857,"_28357":54782,"_3076":54924},[],"HTTP 200 without a device connection",{"_3624":1295,"_31165":1244,"_21590":54926,"_5":14857,"_28357":54782,"_3076":54927},[],"Installed pair, chain, uses, consumer trust and permissions. Also check the slot and history.",{"_3624":1296,"_31165":1244,"_21590":54929,"_5":14857,"_28357":54782,"_3076":54930},[],"Timeout or error after issuance",{"_3624":1297,"_31165":1244,"_21590":54932,"_5":14857,"_28357":54782,"_3076":54933},[],"New certificates, current slot and previous identity's state before retrying.",{"_3624":1298,"_31165":1244,"_21590":54935,"_5":14857,"_28357":54786,"_3076":54936},[],"Check the saved renewal mode and Gateway behavior with expired certificates and the bootstrap CA.",{"_3624":1299,"_31165":1244,"_21590":54938,"_5":14857,"_28357":54786,"_3076":54939},[],"The default response is Base64-encoded DER PKCS#7; PEM through `Accept: application/x-pem-file` is a Lamassu extension. ServerKeyGen returns multipart and requires handling each part separately. See the EST reference.",{"_3624":1300,"_31165":1244,"_21590":54941,"_5":14857,"_28357":54789,"_3076":54942},[],"Check HTTPS with the approved root and query cacerts for the correct APS.",{"_3624":1301,"_31165":1244,"_21590":54944,"_5":14857,"_28357":54789,"_3076":54945},[],"Review the saved DMS: protocol, registration, authentication for that operation, CA, profile and window.",{"_3624":1302,"_31165":1244,"_21590":54947,"_5":14857,"_28357":54789,"_3076":54948},[],"Verify the CSR locally and relate its CN to the inventory.",{"_3624":1303,"_31165":1244,"_21590":54950,"_5":14857,"_28357":54789,"_3076":54951},[],"Make one request, save headers/body and query the device and certificates.",{"_3624":1304,"_31165":1244,"_21590":54953,"_5":14857,"_28357":54789,"_3076":54954},[],"If you receive an identity, check the key, subject, use and connection with the consumer.",{"_3624":1305,"_31165":1244,"_21590":54956,"_5":14857,"_28357":54789,"_3076":54957},[],"External bootstrap revocation checks fail closed: a certificate whose revocation cannot be verified — including an OCSP Unknown status — is rejected by default. Only `allow_unverifiable_revocation` in that operation's block (see DMS) relaxes it, and only for certificates that carry no OCSP/CRL endpoint at all; unreachable, stale or inconclusive endpoints are rejected whatever the option says. See Revocation and checks. An intermediate CA in the TLS chain does not prove that the entire chain reached the DMS validator either.",{"_3624":1306,"_31165":1244,"_21590":54959,"_5":14857,"_28357":54789,"_3076":54960},[],"For logs, networking, pods or Gateway headers, continue in Deployment troubleshooting. For identities issued, revoked or bound partially, use Renewal and recovery and Devices and identities.",{"_3624":1307,"_31165":1307,"_5":15217,"_3076":54962,"_31503":54963,"_21590":54964,"_28357":1307},"Trust distribution and updates",[50900,52412,53584,53582,53768],[],{"_3624":1308,"_31165":1307,"_21590":54966,"_5":14857,"_28357":1307,"_3076":54967},[],"Separate roots, intermediates and initial TLS trust when distributing or migrating certificates.",{"_3624":1309,"_31165":1307,"_5":31500,"_21590":54969,"_28357":54970,"_3076":54971},[],"/docs/platform/iot-fleets/enrollment/trust-distribution#three-trust-relationships","Three trust relationships",{"_3624":1310,"_31165":1307,"_5":31500,"_21590":54973,"_28357":54974,"_3076":54975},[],"/docs/platform/iot-fleets/enrollment/trust-distribution#what-cacerts-returns","What cacerts returns",{"_3624":1311,"_31165":1307,"_5":31500,"_21590":54977,"_28357":54978,"_3076":54979},[],"/docs/platform/iot-fleets/enrollment/trust-distribution#install-the-required-material","Install the required material",{"_3624":1312,"_31165":1307,"_5":31500,"_21590":54981,"_28357":54982,"_3076":54983},[],"/docs/platform/iot-fleets/enrollment/trust-distribution#migrate-trust","Migrate trust",{"_3624":1313,"_31165":1307,"_5":31500,"_21590":54985,"_28357":54986,"_3076":54987},[],"/docs/platform/iot-fleets/enrollment/trust-distribution#check-the-update","Check the update",{"_3624":1314,"_31165":1307,"_21590":54989,"_5":14857,"_28357":1307,"_3076":54990},[],"This guide is for device and consumer trust administrators. You need issuer inventory, trust-store access and an authenticated update channel. Distributing certificates is separate from choosing trusted anchors.",{"_3624":1315,"_31165":1307,"_21590":54992,"_5":14857,"_28357":54970,"_3076":54993},[],"Relationship",{"_3624":1316,"_31165":1307,"_21590":54995,"_5":14857,"_28357":54970,"_3076":54996},[],"Material prepared by its owner",{"_3624":1317,"_31165":1307,"_21590":54998,"_5":14857,"_28357":54970,"_3076":54999},[],"Device → EST server",{"_3624":1318,"_31165":1307,"_21590":55001,"_5":14857,"_28357":54970,"_3076":55002},[],"Previously verified server root, chain or pin and TLS name.",{"_3624":1319,"_31165":1307,"_21590":55004,"_5":14857,"_28357":54970,"_3076":55005},[],"DMS → requester",{"_3624":1320,"_31165":1307,"_21590":55007,"_5":14857,"_28357":54970,"_3076":55008},[],"CAs and rules authorizing initial or renewal credentials.",{"_3624":1321,"_31165":1307,"_21590":55010,"_5":14857,"_28357":54970,"_3076":55011},[],"Consumer → device",{"_3624":1322,"_31165":1307,"_21590":55013,"_5":14857,"_28357":54970,"_3076":55014},[],"Operational identity roots, intermediates, validation and permissions.",{"_3624":1323,"_31165":1307,"_21590":55016,"_5":14857,"_28357":54970,"_3076":55017},[],"Obtaining a certificate does not automatically configure these relationships in third parties. Review the Trust model.",{"_3624":1324,"_31165":1307,"_21590":55019,"_5":14857,"_28357":54974,"_3076":55020},[],"The DMS may include the available downstream TLS certificate, selected Managed CAs and enrollment CA. Selecting the issuer does not include every ancestor. The set may contain leaves, roots and intermediates, including multiple hierarchies during migration.",{"_3624":1325,"_31165":1307,"_21590":55022,"_5":14857,"_28357":54974,"_3076":55023},[],"Position does not define the chain. Identify certificates by subject, issuer, AKI/SKI, signature and constraints. Download and inspect using EST client.",{"_3624":1326,"_31165":1307,"_21590":55025,"_5":14857,"_28357":54978,"_3076":55026},[],"Keep initial EST server trust separate from identity consumer trust.",{"_3624":1327,"_31165":1307,"_21590":55028,"_5":14857,"_28357":54978,"_3076":55029},[],"Select policy-approved roots as anchors.",{"_3624":1328,"_31165":1307,"_21590":55031,"_5":14857,"_28357":54978,"_3076":55032},[],"Retain intermediates for chain building or presentation; do not automatically turn them into roots.",{"_3624":1329,"_31165":1307,"_21590":55034,"_5":14857,"_28357":54978,"_3076":55035},[],"Present the leaf and required intermediates in mTLS. Normally the peer already trusts its root and does not need it sent.",{"_3624":1330,"_31165":1307,"_21590":55037,"_5":14857,"_28357":54978,"_3076":55038},[],"Verify chain, dates, names, usages and revocation from the consumer.",{"_3624":1331,"_31165":1307,"_21590":55040,"_5":14857,"_28357":54978,"_3076":55041},[],"Do not indiscriminately use all of `cacerts.pem` as `-CAfile`: this can expand trusted authorities, hide missing intermediates or trust a TLS leaf intended for another purpose.",{"_3624":1332,"_31165":1307,"_21590":55043,"_5":14857,"_28357":54982,"_3076":55044},[],"Before changing Enrollment CA, inventory disconnected equipment, bootstrap and operational certificates, and consumers. Distribute the new root and required intermediates; check that a cohort accepts both old and new chains.",{"_3624":1333,"_31165":1307,"_21590":55046,"_5":14857,"_28357":54982,"_3076":55047},[],"In the DMS, separate distributed CAs from the re-enrollment validation CAs at `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`, used for re-enrollment credentials. That list is optional because the enrollment CA always validates re-enrollment credentials, but when switching the enrollment CA, add the previous issuance CA to it so old-CA identities keep re-enrolling during overlap. The validator tries the enrollment CA followed by those CAs against the received leaf; accepting a multilevel chain requires checking what reaches the service and which issuer is configured.",{"_3624":1334,"_31165":1307,"_21590":55049,"_5":14857,"_28357":54982,"_3076":55050},[],"Switch issuance, renew in cohorts and compare the installed serial with the active slot. Remove previous trust once no legitimate equipment needs it and policy permits ending overlap. Follow Hierarchy and rotation for the PKI operation.",{"_3624":1335,"_31165":1307,"_21590":55052,"_5":14857,"_28357":54986,"_3076":55053},[],"Test an old identity allowed during overlap, a new one, an unknown chain and the result after removing old trust. Keep trust-store version, approved set, date and result. Reachable `/cacerts` establishes distribution only; it does not establish installation or acceptance across every device.",{"_3624":1336,"_31165":1336,"_5":15217,"_3076":55055,"_31503":55056,"_21590":55058,"_28357":1336},"AWS IoT Core",[50900,52412,53584,53582,55057],"Integrations",[],{"_3624":1337,"_31165":1336,"_21590":55060,"_5":14857,"_28357":1336,"_3076":55061},[],"Lamassu's connector for AWS IoT Core syncs device identities with the AWS platform, handling CA registration, Thing provisioning and certificate lifecycle automatically and event-driven.",{"_3624":1338,"_31165":1336,"_5":31500,"_21590":55063,"_28357":55064,"_3076":55065},[],"/docs/platform/iot-fleets/integrations/aws-iot-core#connector-architecture","Connector architecture",{"_3624":1339,"_31165":1336,"_5":31500,"_21590":55067,"_28357":55068,"_3076":55069},[],"/docs/platform/iot-fleets/integrations/aws-iot-core#prerequisites","Prerequisites",{"_3624":1340,"_31165":1336,"_5":31500,"_21590":55071,"_28357":55072,"_3076":55073},[],"/docs/platform/iot-fleets/integrations/aws-iot-core#required-iam-permissions","Required IAM permissions",{"_3624":1341,"_31165":1336,"_5":31500,"_21590":55075,"_28357":55076,"_3076":55077},[],"/docs/platform/iot-fleets/integrations/aws-iot-core#configuration-parameters","Configuration parameters",{"_3624":1342,"_31165":1336,"_5":31500,"_21590":55079,"_28357":55080,"_3076":55081},[],"/docs/platform/iot-fleets/integrations/aws-iot-core#events-and-aws-resources","Events and AWS resources",{"_3624":1343,"_31165":1336,"_5":31500,"_21590":55083,"_28357":55084,"_3076":55085},[],"/docs/platform/iot-fleets/integrations/aws-iot-core#ca-registration-in-aws-iot-core","CA registration in AWS IoT Core",{"_3624":1344,"_31165":1336,"_5":31500,"_21590":55087,"_28357":55088,"_3076":55089},[],"/docs/platform/iot-fleets/integrations/aws-iot-core#how-to-request-registration","How to request registration",{"_3624":1345,"_31165":1336,"_5":31500,"_21590":55091,"_28357":55092,"_3076":55093},[],"/docs/platform/iot-fleets/integrations/aws-iot-core#ca-registration-states","CA registration states",{"_3624":1346,"_31165":1336,"_5":31500,"_21590":55095,"_28357":55096,"_3076":55097},[],"/docs/platform/iot-fleets/integrations/aws-iot-core#primary-account","Primary Account",{"_3624":1347,"_31165":1336,"_5":31500,"_21590":55099,"_28357":55100,"_3076":55101},[],"/docs/platform/iot-fleets/integrations/aws-iot-core#secondary-account-sni-only","Secondary Account (SNI-only)",{"_3624":1348,"_31165":1336,"_5":31500,"_21590":55103,"_28357":55104,"_3076":55105},[],"/docs/platform/iot-fleets/integrations/aws-iot-core#dms-configuration","DMS configuration",{"_3624":1349,"_31165":1336,"_5":31500,"_21590":55107,"_28357":55108,"_3076":55109},[],"/docs/platform/iot-fleets/integrations/aws-iot-core#none-mode","`none` mode",{"_3624":1350,"_31165":1336,"_5":31500,"_21590":55111,"_28357":55112,"_3076":55113},[],"/docs/platform/iot-fleets/integrations/aws-iot-core#auto-mode","`auto` mode",{"_3624":1351,"_31165":1336,"_5":31500,"_21590":55115,"_28357":55116,"_3076":55117},[],"/docs/platform/iot-fleets/integrations/aws-iot-core#jitp-mode","`jitp` mode",{"_3624":1352,"_31165":1336,"_5":31500,"_21590":55119,"_28357":55120,"_3076":55121},[],"/docs/platform/iot-fleets/integrations/aws-iot-core#dms-registration-mode-states","DMS registration-mode states",{"_3624":1353,"_31165":1336,"_5":31500,"_21590":55123,"_28357":55124,"_3076":55125},[],"/docs/platform/iot-fleets/integrations/aws-iot-core#device-provisioning-automatic-mode","Device provisioning (automatic mode)",{"_3624":1354,"_31165":1336,"_5":31500,"_21590":55127,"_28357":55128,"_3076":55129},[],"/docs/platform/iot-fleets/integrations/aws-iot-core#thing-lifecycle","Thing lifecycle",{"_3624":1355,"_31165":1336,"_5":31500,"_21590":55131,"_28357":55132,"_3076":55133},[],"/docs/platform/iot-fleets/integrations/aws-iot-core#device-provisioning-jitp-mode","Device provisioning (JITP mode)",{"_3624":1356,"_31165":1336,"_5":31500,"_21590":55135,"_28357":55136,"_3076":55137},[],"/docs/platform/iot-fleets/integrations/aws-iot-core#certificate-status-synchronization","Certificate status synchronization",{"_3624":1357,"_31165":1336,"_5":31500,"_21590":55139,"_28357":55140,"_3076":55141},[],"/docs/platform/iot-fleets/integrations/aws-iot-core#certificate-status-states","Certificate status states",{"_3624":1358,"_31165":1336,"_5":31500,"_21590":55143,"_28357":55144,"_3076":55145},[],"/docs/platform/iot-fleets/integrations/aws-iot-core#forced-disconnect-on-revocation","Forced disconnect on revocation",{"_3624":1359,"_31165":1336,"_5":31500,"_21590":55147,"_28357":55148,"_3076":55149},[],"/docs/platform/iot-fleets/integrations/aws-iot-core#device-shadow-and-automation","Device Shadow and automation",{"_3624":1360,"_31165":1336,"_5":31500,"_21590":55151,"_28357":55152,"_3076":55153},[],"/docs/platform/iot-fleets/integrations/aws-iot-core#what-the-connector-writes-to-the-shadow","What the connector writes to the shadow",{"_3624":1361,"_31165":1336,"_5":31500,"_21590":55155,"_28357":55156,"_3076":55157},[],"/docs/platform/iot-fleets/integrations/aws-iot-core#aws-iot-policies","AWS IoT policies",{"_3624":1362,"_31165":1336,"_5":31500,"_21590":55159,"_28357":55160,"_3076":55161},[],"/docs/platform/iot-fleets/integrations/aws-iot-core#troubleshooting","Troubleshooting",{"_3624":1363,"_31165":1336,"_21590":55163,"_5":14857,"_28357":1336,"_3076":55164},[],"Lamassu's integration with AWS IoT Core bridges the PKI managed by Lamassu and AWS's connectivity platform. When a device obtains its certificate through the EST enrollment process, the connector ensures that certificate and its associated identity are recognized in AWS IoT Core without manual intervention. The result is that the device can authenticate directly to AWS with the same X.509 certificate Lamassu issued.",{"_3624":1364,"_31165":1336,"_21590":55166,"_5":14857,"_28357":1336,"_3076":55167},[],"From a protocol standpoint, the device authenticates to AWS IoT Core via mutual TLS (mTLS): it presents its Lamassu-issued X.509 certificate as the client certificate, and AWS IoT Core verifies the certificate chain up to the CA registered in the account. Lamassu acts as the certification authority (CA); the connector ensures that CA is registered in AWS and that the device's certificate is known to the platform before the device attempts to connect (in `auto` mode) or on its first connection (in JITP mode).",{"_3624":1365,"_31165":1336,"_21590":55169,"_5":14857,"_28357":1336,"_3076":55170},[],"This document is aimed both at the PKI administrator, who needs to configure the connector and register CAs, and at the device firmware developer, who needs to understand how Things are named, how the Device Shadow works and what happens when a certificate is revoked. For the firmware developer, the most important fact is that **the AWS Thing name (ThingName) always corresponds to the Common Name (CN) of the certificate issued by Lamassu**, regardless of the provisioning mode.",{"_3624":1366,"_31165":1336,"_21590":55172,"_5":14857,"_28357":55064,"_3076":55173},[],"The AWS IoT Core connector is an independent Go process, a binary or container separate from Lamassu's core. In a monolithic deployment it is compiled by default (build tag `!noaws`) and activated with `aws_iot_manager.enabled: true` in the configuration file. In distributed deployments, it runs as its own container with access to Lamassu's CA, DMS Manager and Device Manager services over HTTP.",{"_3624":1367,"_31165":1336,"_21590":55175,"_5":14857,"_28357":55064,"_3076":55176},[],"The connector does not poll Lamassu's services periodically. Instead, it **subscribes to Lamassu's internal event bus** (AMQP or AWS SQS/SNS, configurable) and reacts to the events it cares about: CA creation or update, DMS creation or update, device identity binding, certificate status change, certificate metadata update and device metadata update. This event-driven model ensures synchronization with AWS is nearly immediate and produces no polling load.",{"_3624":1368,"_31165":1336,"_21590":55178,"_5":14857,"_28357":55064,"_3076":55179},[],"To avoid infinite loops, the connector ignores any event whose CloudEvent `source` field matches its own origin URI. This prevents the metadata writes the connector itself performs from re-triggering the same flow.",{"_3624":1369,"_31165":1336,"_21590":55181,"_5":14857,"_28357":55064,"_3076":55182},[],"When several connectors run in parallel, for example for different AWS accounts, each instance has its own `connector_id`. All metadata the connector writes to Lamassu is stored under the key `lamassu.io/iot/{connector_id}`, allowing coexistence without collisions.",{"_3624":1370,"_31165":1336,"_21590":55184,"_5":14857,"_28357":55068,"_3076":55185},[],"Before enabling the connector you need an AWS account with the proper IAM permissions and the connector correctly configured. The deployment process (Docker Compose, Kubernetes or binary) is described in the deployment documentation.",{"_3624":1371,"_31165":1336,"_21590":55187,"_5":14857,"_28357":55072,"_3076":55188},[],"The IAM identity operating the connector needs at minimum the following permissions on the target account's resources:",{"_3624":1372,"_31165":1336,"_21590":55190,"_5":14857,"_28357":55072,"_3076":55191},[],"IAM action",{"_3624":1373,"_31165":1336,"_21590":55193,"_5":14857,"_28357":55072,"_3076":51290},[],{"_3624":1374,"_31165":1336,"_21590":55195,"_5":14857,"_28357":55072,"_3076":55196},[],"`iot:GetRegistrationCode`",{"_3624":1375,"_31165":1336,"_21590":55198,"_5":14857,"_28357":55072,"_3076":55199},[],"Obtain the verification code for CA registration in the Primary Account",{"_3624":1376,"_31165":1336,"_21590":55201,"_5":14857,"_28357":55072,"_3076":55202},[],"`iot:RegisterCACertificate`",{"_3624":1377,"_31165":1336,"_21590":55204,"_5":14857,"_28357":55072,"_3076":55205},[],"Register the CA in AWS IoT",{"_3624":1378,"_31165":1336,"_21590":55207,"_5":14857,"_28357":55072,"_3076":55208},[],"`iot:DescribeCACertificate`",{"_3624":1379,"_31165":1336,"_21590":55210,"_5":14857,"_28357":55072,"_3076":55211},[],"Check the CA registration status",{"_3624":1380,"_31165":1336,"_21590":55213,"_5":14857,"_28357":55072,"_3076":55214},[],"`iot:CreateThing` / `iot:UpdateThing`",{"_3624":1381,"_31165":1336,"_21590":55216,"_5":14857,"_28357":55072,"_3076":55217},[],"Create or update Things in IoT Core",{"_3624":1382,"_31165":1336,"_21590":55219,"_5":14857,"_28357":55072,"_3076":55220},[],"`iot:RegisterThing`",{"_3624":1383,"_31165":1336,"_21590":55222,"_5":14857,"_28357":55072,"_3076":55223},[],"Provision Things through a template",{"_3624":1384,"_31165":1336,"_21590":55225,"_5":14857,"_28357":55072,"_3076":55226},[],"`iot:RegisterCertificate`",{"_3624":1385,"_31165":1336,"_21590":55228,"_5":14857,"_28357":55072,"_3076":55229},[],"Register device certificates",{"_3624":1386,"_31165":1336,"_21590":55231,"_5":14857,"_28357":55072,"_3076":55232},[],"`iot:UpdateCertificate`",{"_3624":1387,"_31165":1336,"_21590":55234,"_5":14857,"_28357":55072,"_3076":55235},[],"Change a certificate's status (ACTIVE / INACTIVE / REVOKED)",{"_3624":1388,"_31165":1336,"_21590":55237,"_5":14857,"_28357":55072,"_3076":55238},[],"`iot:CreatePolicy` / `iot:AttachPolicy`",{"_3624":1389,"_31165":1336,"_21590":55240,"_5":14857,"_28357":55072,"_3076":55241},[],"Create and attach IoT policies",{"_3624":1390,"_31165":1336,"_21590":55243,"_5":14857,"_28357":55072,"_3076":55244},[],"`iot:CreateThingGroup` / `iot:AddThingToThingGroup`",{"_3624":1391,"_31165":1336,"_21590":55246,"_5":14857,"_28357":55072,"_3076":55247},[],"Manage Thing groups",{"_3624":1392,"_31165":1336,"_21590":55249,"_5":14857,"_28357":55072,"_3076":55250},[],"`iot:CreateProvisioningTemplate`",{"_3624":1393,"_31165":1336,"_21590":55252,"_5":14857,"_28357":55072,"_3076":55253},[],"Create JITP templates",{"_3624":1394,"_31165":1336,"_21590":55255,"_5":14857,"_28357":55072,"_3076":55256},[],"`iotdata:GetThingShadow` / `iotdata:UpdateThingShadow`",{"_3624":1395,"_31165":1336,"_21590":55258,"_5":14857,"_28357":55072,"_3076":55259},[],"Read and write the Device Shadow",{"_3624":1396,"_31165":1336,"_21590":55261,"_5":14857,"_28357":55072,"_3076":55262},[],"The forced-disconnect mechanism after revocation also requires access to the AWS IoT data plane API (`iot:Connect` with SigV4 over WebSocket), negotiated implicitly with the connector's credentials.",{"_3624":1397,"_31165":1336,"_21590":55264,"_5":14857,"_28357":55076,"_3076":55265},[],"Parameter",{"_3624":1398,"_31165":1336,"_21590":55267,"_5":14857,"_28357":55076,"_3076":55268},[],"Type",{"_3624":1399,"_31165":1336,"_21590":55270,"_5":14857,"_28357":55076,"_3076":55271},[],"Required",{"_3624":1400,"_31165":1336,"_21590":55273,"_5":14857,"_28357":55076,"_3076":55274},[],"Description",{"_3624":1401,"_31165":1336,"_21590":55276,"_5":14857,"_28357":55076,"_3076":55277},[],"`connector_id`",{"_3624":1402,"_31165":1336,"_21590":55279,"_5":14857,"_28357":55076,"_3076":25776},[],{"_3624":1403,"_31165":1336,"_21590":55281,"_5":14857,"_28357":55076,"_3076":55282},[],"Yes",{"_3624":1404,"_31165":1336,"_21590":55284,"_5":14857,"_28357":55076,"_3076":55285},[],"Unique identifier of this connector instance. Used as the metadata namespace: `lamassu.io/iot/{connector_id}`.",{"_3624":1405,"_31165":1336,"_21590":55287,"_5":14857,"_28357":55076,"_3076":55288},[],"`aws_config.region`",{"_3624":1406,"_31165":1336,"_21590":55290,"_5":14857,"_28357":55076,"_3076":25776},[],{"_3624":1407,"_31165":1336,"_21590":55292,"_5":14857,"_28357":55076,"_3076":55282},[],{"_3624":1408,"_31165":1336,"_21590":55294,"_5":14857,"_28357":55076,"_3076":55295},[],"AWS region where the connector operates.",{"_3624":1409,"_31165":1336,"_21590":55297,"_5":14857,"_28357":55076,"_3076":55298},[],"`aws_config.auth_method`",{"_3624":1410,"_31165":1336,"_21590":55300,"_5":14857,"_28357":55076,"_3076":25776},[],{"_3624":1411,"_31165":1336,"_21590":55302,"_5":14857,"_28357":55076,"_3076":55282},[],{"_3624":1412,"_31165":1336,"_21590":55304,"_5":14857,"_28357":55076,"_3076":55305},[],"Authentication method: `static`, `role` or empty (SDK default credential chain).",{"_3624":1413,"_31165":1336,"_21590":55307,"_5":14857,"_28357":55076,"_3076":55308},[],"`aws_config.access_key_id`",{"_3624":1414,"_31165":1336,"_21590":55310,"_5":14857,"_28357":55076,"_3076":25776},[],{"_3624":1415,"_31165":1336,"_21590":55312,"_5":14857,"_28357":55076,"_3076":55313},[],"Only with `auth_method=static`",{"_3624":1416,"_31165":1336,"_21590":55315,"_5":14857,"_28357":55076,"_3076":55316},[],"AWS access key.",{"_3624":1417,"_31165":1336,"_21590":55318,"_5":14857,"_28357":55076,"_3076":55319},[],"`aws_config.secret_access_key`",{"_3624":1418,"_31165":1336,"_21590":55321,"_5":14857,"_28357":55076,"_3076":25776},[],{"_3624":1419,"_31165":1336,"_21590":55323,"_5":14857,"_28357":55076,"_3076":55313},[],{"_3624":1420,"_31165":1336,"_21590":55325,"_5":14857,"_28357":55076,"_3076":55326},[],"AWS secret key.",{"_3624":1421,"_31165":1336,"_21590":55328,"_5":14857,"_28357":55076,"_3076":55329},[],"`aws_config.session_token`",{"_3624":1422,"_31165":1336,"_21590":55331,"_5":14857,"_28357":55076,"_3076":25776},[],{"_3624":1423,"_31165":1336,"_21590":55333,"_5":14857,"_28357":55076,"_3076":55334},[],"No",{"_3624":1424,"_31165":1336,"_21590":55336,"_5":14857,"_28357":55076,"_3076":55337},[],"Session token (with `auth_method=static`).",{"_3624":1425,"_31165":1336,"_21590":55339,"_5":14857,"_28357":55076,"_3076":55340},[],"`aws_config.role_arn`",{"_3624":1426,"_31165":1336,"_21590":55342,"_5":14857,"_28357":55076,"_3076":25776},[],{"_3624":1427,"_31165":1336,"_21590":55344,"_5":14857,"_28357":55076,"_3076":55345},[],"Only with `auth_method=role`",{"_3624":1428,"_31165":1336,"_21590":55347,"_5":14857,"_28357":55076,"_3076":55348},[],"ARN of the role to assume.",{"_3624":1429,"_31165":1336,"_21590":55350,"_5":14857,"_28357":55076,"_3076":55351},[],"`aws_config.endpoint_url`",{"_3624":1430,"_31165":1336,"_21590":55353,"_5":14857,"_28357":55076,"_3076":25776},[],{"_3624":1431,"_31165":1336,"_21590":55355,"_5":14857,"_28357":55076,"_3076":55334},[],{"_3624":1432,"_31165":1336,"_21590":55357,"_5":14857,"_28357":55076,"_3076":55358},[],"Alternative URL for all AWS services (useful with LocalStack in tests).",{"_3624":1433,"_31165":1336,"_21590":55360,"_5":14857,"_28357":55076,"_3076":55361},[],"`subscriber_event_bus`",{"_3624":1434,"_31165":1336,"_21590":55363,"_5":14857,"_28357":55076,"_3076":18203},[],{"_3624":1435,"_31165":1336,"_21590":55365,"_5":14857,"_28357":55076,"_3076":55282},[],{"_3624":1436,"_31165":1336,"_21590":55367,"_5":14857,"_28357":55076,"_3076":55368},[],"Configuration of the event bus the connector subscribes to (AMQP or AWS SQS/SNS).",{"_3624":1437,"_31165":1336,"_21590":55370,"_5":14857,"_28357":55076,"_3076":55371},[],"`dms_manager_client`",{"_3624":1438,"_31165":1336,"_21590":55373,"_5":14857,"_28357":55076,"_3076":25776},[],{"_3624":1439,"_31165":1336,"_21590":55375,"_5":14857,"_28357":55076,"_3076":55282},[],{"_3624":1440,"_31165":1336,"_21590":55377,"_5":14857,"_28357":55076,"_3076":55378},[],"HTTP URL of Lamassu's DMS Manager service.",{"_3624":1441,"_31165":1336,"_21590":55380,"_5":14857,"_28357":55076,"_3076":55381},[],"`device_manager_client`",{"_3624":1442,"_31165":1336,"_21590":55383,"_5":14857,"_28357":55076,"_3076":25776},[],{"_3624":1443,"_31165":1336,"_21590":55385,"_5":14857,"_28357":55076,"_3076":55282},[],{"_3624":1444,"_31165":1336,"_21590":55387,"_5":14857,"_28357":55076,"_3076":55388},[],"HTTP URL of Lamassu's Device Manager.",{"_3624":1445,"_31165":1336,"_21590":55390,"_5":14857,"_28357":55076,"_3076":55391},[],"`ca_client`",{"_3624":1446,"_31165":1336,"_21590":55393,"_5":14857,"_28357":55076,"_3076":25776},[],{"_3624":1447,"_31165":1336,"_21590":55395,"_5":14857,"_28357":55076,"_3076":55282},[],{"_3624":1448,"_31165":1336,"_21590":55397,"_5":14857,"_28357":55076,"_3076":55398},[],"HTTP URL of Lamassu's CA service.",{"_3624":1449,"_31165":1336,"_21590":55400,"_5":14857,"_28357":55080,"_3076":55401},[],"The connector owns the AWS side of four resource types — CAs, DMS provisioning templates (JITP), device certificates and Things. This section maps the bus events the connector consumes to the AWS resources they touch and to the AWS calls each flow performs. The state machine of each resource lives next to its detailed explanation; the last column links to it. AWS resources are referenced with the notation `IoTCore/<resource>`.",{"_3624":1450,"_31165":1336,"_21590":55403,"_5":14857,"_28357":55080,"_3076":55404},[],"The **CloudEvent type** column lists the event name on Lamassu's internal event bus; the **IAM actions** column lists the exact AWS SDK operations each flow invokes, so the required permissions can be derived directly from this table.",{"_3624":1451,"_31165":1336,"_21590":55406,"_5":14857,"_28357":55080,"_3076":55407},[],"CloudEvent type",{"_3624":1452,"_31165":1336,"_21590":55409,"_5":14857,"_28357":55080,"_3076":55410},[],"Lamassu resource",{"_3624":1453,"_31165":1336,"_21590":55412,"_5":14857,"_28357":55080,"_3076":55413},[],"AWS Resource",{"_3624":1454,"_31165":1336,"_21590":55415,"_5":14857,"_28357":55080,"_3076":55416},[],"IAM actions",{"_3624":1455,"_31165":1336,"_21590":55418,"_5":14857,"_28357":55080,"_3076":55419},[],"AWS calls and effect",{"_3624":1456,"_31165":1336,"_21590":55421,"_5":14857,"_28357":55080,"_3076":55422},[],"Where in this page",{"_3624":1457,"_31165":1336,"_21590":55424,"_5":14857,"_28357":55080,"_3076":55425},[],"`EventCreateCAKey` / `EventImportCAKey` / `EventUpdateCAMetadataKey`",{"_3624":1458,"_31165":1336,"_21590":55427,"_5":14857,"_28357":55080,"_3076":55428},[],"CA",{"_3624":1459,"_31165":1336,"_21590":55430,"_5":14857,"_28357":55080,"_3076":55431},[],"`IoTCore/CACertificate`",{"_3624":1460,"_31165":1336,"_21590":55433,"_5":14857,"_28357":55080,"_3076":55434},[],"`iot:GetRegistrationCode`, `iot:RegisterCACertificate`, `iot:DescribeCACertificate`, `iot:ListCACertificates`",{"_3624":1461,"_31165":1336,"_21590":55436,"_5":14857,"_28357":55080,"_3076":55437},[],"Loads the CA into connector state; a `registration.status = REQUESTED` write fires the registration flow (Primary with verification certificate, or SNI-only) and writes `SUCCEEDED` or `FAILED` back to the CA's metadata.",{"_3624":1462,"_31165":1336,"_21590":55439,"_5":14857,"_28357":55080,"_3076":55093},[],{"_3624":1463,"_31165":1336,"_21590":55441,"_5":14857,"_28357":55080,"_3076":55442},[],"`EventCreateDMSKey` / `EventUpdateDMSKey`",{"_3624":1464,"_31165":1336,"_21590":55444,"_5":14857,"_28357":55080,"_3076":55445},[],"DMS",{"_3624":1465,"_31165":1336,"_21590":55447,"_5":14857,"_28357":55080,"_3076":55448},[],"`IoTCore/ProvisioningTemplate`",{"_3624":1466,"_31165":1336,"_21590":55450,"_5":14857,"_28357":55080,"_3076":55451},[],"`iot:CreateProvisioningTemplate`, `iot:UpdateCACertificate`",{"_3624":1467,"_31165":1336,"_21590":55453,"_5":14857,"_28357":55080,"_3076":55454},[],"In `jitp` mode, attempts to create the provisioning template and attaches it to the registered CA. Non-idempotent: a `PUT /v1/dms/{id}` edit retries the creation and lands in `lamassu-dlq` after 3 retries. Idempotent for `none` and `auto` (configuration only).",{"_3624":1468,"_31165":1336,"_21590":55456,"_5":14857,"_28357":55080,"_3076":55121},[],{"_3624":1469,"_31165":1336,"_21590":55458,"_5":14857,"_28357":55080,"_3076":55459},[],"`EventBindDeviceIdentityKey`",{"_3624":1470,"_31165":1336,"_21590":55461,"_5":14857,"_28357":55080,"_3076":55462},[],"Device",{"_3624":1471,"_31165":1336,"_21590":55464,"_5":14857,"_28357":55080,"_3076":55465},[],"`IoTCore/Policy`, `IoTCore/ThingGroup`, `IoTCore/Thing`",{"_3624":1472,"_31165":1336,"_21590":55467,"_5":14857,"_28357":55080,"_3076":55468},[],"`iot:CreatePolicy` / `iot:DeletePolicyVersion`, `iot:GetPolicy` / `iot:ListPolicyVersions`, `iot:CreateThingGroup`, `iot:DescribeThing` / `iot:ListThingPrincipals`, `iot:RegisterThing`",{"_3624":1473,"_31165":1336,"_21590":55470,"_5":14857,"_28357":55080,"_3076":55471},[],"In `auto` mode: creates/updates policies, ensures Thing groups, revokes stale principals and provisions the Thing via `iot:RegisterThing`. In `jitp` mode: no AWS calls; AWS runs the JITP template on first connection.",{"_3624":1474,"_31165":1336,"_21590":55473,"_5":14857,"_28357":55080,"_3076":55129},[],{"_3624":1475,"_31165":1336,"_21590":55475,"_5":14857,"_28357":55080,"_3076":55476},[],"`EventUpdateCertificateStatusKey`",{"_3624":1476,"_31165":1336,"_21590":55478,"_5":14857,"_28357":55080,"_3076":55479},[],"Certificate",{"_3624":1477,"_31165":1336,"_21590":55481,"_5":14857,"_28357":55080,"_3076":55482},[],"`IoTCore/Certificate`",{"_3624":1478,"_31165":1336,"_21590":55484,"_5":14857,"_28357":55080,"_3076":55485},[],"`iot:UpdateCertificate`, `iot:Connect` (data plane)",{"_3624":1479,"_31165":1336,"_21590":55487,"_5":14857,"_28357":55080,"_3076":55488},[],"Maps status to AWS (`ACTIVE`, `INACTIVE`, `REVOKED`), calls `iot:UpdateCertificate` and forces an MQTT disconnect on revoke.",{"_3624":1480,"_31165":1336,"_21590":55490,"_5":14857,"_28357":55080,"_3076":55141},[],{"_3624":1481,"_31165":1336,"_21590":55492,"_5":14857,"_28357":55080,"_3076":55493},[],"`EventUpdateCertificateMetadataKey` / `EventUpdateDeviceMetadataKey`",{"_3624":1482,"_31165":1336,"_21590":55495,"_5":14857,"_28357":55080,"_3076":55496},[],"Certificate / Device",{"_3624":1483,"_31165":1336,"_21590":55498,"_5":14857,"_28357":55080,"_3076":55499},[],"`IoTCore/Certificate`, `IoTCore/Thing`",{"_3624":1484,"_31165":1336,"_21590":55501,"_5":14857,"_28357":55080,"_3076":51296},[],{"_3624":1485,"_31165":1336,"_21590":55503,"_5":14857,"_28357":55080,"_3076":55504},[],"Refreshes internal state; the connector ignores events whose CloudEvent `source` matches its own URI to avoid self-triggered loops.",{"_3624":1486,"_31165":1336,"_21590":55506,"_5":14857,"_28357":55080,"_3076":55149},[],{"_3624":1487,"_31165":1336,"_21590":55508,"_5":14857,"_28357":55084,"_3076":55509},[],"For devices to authenticate to AWS IoT Core with certificates issued by a Lamassu CA, that CA must first be registered in the AWS account. The connector handles this registration automatically in response to the `EventCreateCAKey`, `EventImportCAKey` and `EventUpdateCAMetadataKey` events, but the operation **only fires when the administrator explicitly requests it** through the CA metadata field.",{"_3624":1488,"_31165":1336,"_21590":55511,"_5":14857,"_28357":55088,"_3076":55512},[],"Registration is triggered by setting `registration.status = \"REQUESTED\"` on the `lamassu.io/iot/{connector_id}` key of the CA's metadata. This can be done from the Lamassu console in the CA management section or through the API.",{"_3624":1489,"_31165":1336,"_21590":55514,"_5":14857,"_28357":55088,"_3076":55515},[],"Once the event is received, the connector attempts to register the CA in AWS and updates the `registration.status` field in the CA's metadata with the result: `\"SUCCEEDED\"` if registration was successful, or `\"FAILED\"` with an error message otherwise. The process is asynchronous, so you must periodically check the metadata status until the operation completes.",{"_3624":1490,"_31165":1336,"_21590":55517,"_5":14857,"_28357":55092,"_3076":55518},[],"The CA registration flow is driven by the `registration.status` field of the CA's connector metadata:",{"_3624":1491,"_31165":1336,"_21590":55520,"_5":14857,"_28357":55092,"_3076":55521},[],"Transition",{"_3624":1492,"_31165":1336,"_21590":55523,"_5":14857,"_28357":55092,"_3076":55524},[],"AWS calls",{"_3624":1493,"_31165":1336,"_21590":55526,"_5":14857,"_28357":55092,"_3076":55527},[],"`NotRegistered` → `Requested`",{"_3624":1494,"_31165":1336,"_21590":55529,"_5":14857,"_28357":55092,"_3076":55530},[],"none (metadata write only)",{"_3624":1495,"_31165":1336,"_21590":55532,"_5":14857,"_28357":55092,"_3076":55533},[],"`Requested` → `Registering`",{"_3624":1496,"_31165":1336,"_21590":55535,"_5":14857,"_28357":55092,"_3076":55536},[],"`iot:GetRegistrationCode` (Primary Account only)",{"_3624":1497,"_31165":1336,"_21590":55538,"_5":14857,"_28357":55092,"_3076":55539},[],"`Registering` → `Succeeded`",{"_3624":1498,"_31165":1336,"_21590":55541,"_5":14857,"_28357":55092,"_3076":55542},[],"`iot:RegisterCACertificate` (Primary: proof-of-possession with an ephemeral key; SNI-only: `CertificateMode: SNI_ONLY`)",{"_3624":1499,"_31165":1336,"_21590":55544,"_5":14857,"_28357":55092,"_3076":55545},[],"`Registering` → `Failed`",{"_3624":1500,"_31165":1336,"_21590":55547,"_5":14857,"_28357":55092,"_3076":55548},[],"failed `iot:RegisterCACertificate`; the error detail is written to the CA's metadata",{"_3624":1501,"_31165":1336,"_21590":55550,"_5":14857,"_28357":55092,"_3076":55551},[],"`Failed` / `Succeeded` → `Requested`",{"_3624":1502,"_31165":1336,"_21590":55553,"_5":14857,"_28357":55092,"_3076":55554},[],"none (a new `REQUESTED` write re-runs the flow)",{"_3624":1503,"_31165":1336,"_21590":55556,"_5":14857,"_28357":55096,"_3076":55557},[],"When the `primary_account` parameter is `true`, the connector runs the full registration flow with proof-of-possession of the private key:",{"_3624":1504,"_31165":1336,"_21590":55559,"_5":14857,"_28357":55096,"_3076":55560},[],"It calls `iot:GetRegistrationCode` to obtain AWS's verification code.",{"_3624":1505,"_31165":1336,"_21590":55562,"_5":14857,"_28357":55096,"_3076":55563},[],"The connector internally generates an ephemeral RSA-2048 key pair and builds a CSR whose Common Name is exactly that registration code. It then calls Lamassu's signing service so the registered CA issues a real X.509 verification certificate signing that CSR. The ephemeral private key is used only for this purpose and is neither stored nor sent to AWS.",{"_3624":1506,"_31165":1336,"_21590":55565,"_5":14857,"_28357":55096,"_3076":55566},[],"It sends the CA (in PEM) and the verification certificate to AWS via `iot:RegisterCACertificate`, enabling registration with `AllowAutoRegistration: true`.",{"_3624":1507,"_31165":1336,"_21590":55568,"_5":14857,"_28357":55096,"_3076":55569},[],"Only one account can own a CA in a given AWS region. If the CA is already registered with the same serial number, the connector silently skips the step.",{"_3624":1508,"_31165":1336,"_21590":55571,"_5":14857,"_28357":55096,"_3076":55572},[],"The tags AWS IoT Core applies to the registered CA certificate are `LMS.CA.ID`, `LMS.CA.SN` and `LMS.CA.CN`.",{"_3624":1509,"_31165":1336,"_21590":55574,"_5":14857,"_28357":55100,"_3076":55575},[],"When `primary_account` is `false`, the connector registers the CA using `CertificateMode: SNI_ONLY`. This mode requires no verification code or access to the CA's private key, so it is the right choice when the CA is managed from another AWS account or when the administrator does not hold the private key. It is the usual method to register the same CA in several AWS accounts simultaneously.",{"_3624":1510,"_31165":1336,"_21590":55577,"_5":14857,"_28357":55104,"_3076":55578},[],"Each DMS participating in the AWS IoT Core integration must have the metadata key `lamassu.io/iot/{connector_id}` configured. The most important field of that configuration is `registration_mode`, which determines how devices are provisioned in AWS.",{"_3624":1511,"_31165":1336,"_21590":55580,"_5":14857,"_28357":55104,"_3076":55581},[],"There are three registration modes, and the choice among them depends on the fleet's provisioning strategy.",{"_3624":1512,"_31165":1336,"_21590":55583,"_5":14857,"_28357":55108,"_3076":55584},[],"In this mode the connector **creates no Things, groups or policies** in AWS IoT Core. It only syncs certificate status (active, revoked, suspended) as it changes in Lamassu. It is the right mode when Thing provisioning in AWS is managed by an external system and Lamassu only needs to keep certificate status up to date.",{"_3624":1513,"_31165":1336,"_21590":55586,"_5":14857,"_28357":55112,"_3076":55587},[],"`auto` mode delegates full device provisioning in AWS to Lamassu at enrollment time. When the device successfully completes its EST enrollment and Lamassu emits the `EventBindDeviceIdentityKey` event, the connector automatically executes the following sequence:",{"_3624":1514,"_31165":1336,"_21590":55589,"_5":14857,"_28357":55112,"_3076":55590},[],"Creates or updates the IoT policies configured in the DMS.",{"_3624":1515,"_31165":1336,"_21590":55592,"_5":14857,"_28357":55112,"_3076":55593},[],"Creates the root group `LAMASSU` in the AWS account (if it does not exist) and the child groups configured in the DMS as subgroups of `LAMASSU`. If the groups already exist, the `ResourceAlreadyExistsException` error is ignored, making the operation idempotent.",{"_3624":1516,"_31165":1336,"_21590":55595,"_5":14857,"_28357":55112,"_3076":55596},[],"If the Thing already existed in AWS IoT Core, the connector iterates all certificates (principals) currently attached to that Thing and marks them as `REVOKED` in AWS, ensuring previous certificates cannot keep being used to authenticate.",{"_3624":1517,"_31165":1336,"_21590":55598,"_5":14857,"_28357":55112,"_3076":55599},[],"Calls `iot:RegisterThing` with a CloudFormation-style provisioning template that creates the Thing, registers the device's certificate (PEM of the device certificate and of the issuing CA certificate) and attaches the configured policies.",{"_3624":1518,"_31165":1336,"_21590":55601,"_5":14857,"_28357":55112,"_3076":55602},[],"Once provisioning completes, the connector stores the resulting certificate's ARN in the Lamassu certificate's metadata under the key `lamassu.io/iot/{connector_id}` and marks the device as `Registered: true` in Device Manager.",{"_3624":1519,"_31165":1336,"_21590":55604,"_5":14857,"_28357":55112,"_3076":55605},[],"**The Thing name in AWS is the Common Name (CN) of the device's certificate.** This convention is fundamental for the firmware developer: the `/CN=` value the device includes in its CSR when enrolling becomes the ThingName it must identify itself with in all MQTT operations against AWS IoT Core.",{"_3624":1520,"_31165":1336,"_21590":55607,"_5":14857,"_28357":55116,"_3076":55608},[],"Just-In-Time Provisioning (JITP) mode delegates provisioning to AWS instead of the connector doing it directly. When the connector detects the DMS is in `jitp` mode, it creates a JITP provisioning template in AWS IoT Core and attaches it to the registered CA certificate. The connector attempts to create this template when the DMS is created and again on every full DMS edit (`PUT /v1/dms/{id}`) — not at device enrollment time. The attempt is not idempotent: when a template named after the DMS ID already exists, the creation call fails, the event is retried three times and finally lands in the `lamassu-dlq` poison queue (see Troubleshooting). The template is created once; later DMS edits never update its content. A DMS update that omits `metadata` or sends `null` keeps the stored metadata, so the connector key `lamassu.io/iot/{connector_id}` remains present and the attempt is still triggered. A body that supplies a `metadata` object replaces the stored metadata entirely: if that object does not carry the connector key, the key is dropped and the connector silently skips the DMS's future events. Once the template is attached, when a device with a certificate issued by that CA connects to AWS IoT Core for the first time, AWS executes the template automatically: it creates the Thing, registers the certificate and activates it.",{"_3624":1521,"_31165":1336,"_21590":55610,"_5":14857,"_28357":55116,"_3076":55611},[],"The connector creates the template, named after the DMS ID, only once. Each later edit of the DMS that keeps the connector key tries to create it again and fails, because the connector does not update existing templates. Later changes to `jitp_config.provisioning_role_arn`, `jitp_config.enable_template` or to the groups and policies the template references must be applied by hand in AWS IoT Core.",{"_3624":1522,"_31165":1336,"_21590":55613,"_5":14857,"_28357":55116,"_3076":55614},[],"The failed event is retried and ends in `lamassu-dlq`. Groups and policies are registered before the failure, but the assignment of the template to the registered CA, the write-back of the ARN to the DMS and the shadow update when `ManagedCAs` changes are skipped.",{"_3624":1523,"_31165":1336,"_21590":55616,"_5":14857,"_28357":55116,"_3076":55617},[],"The Thing name in the JITP template is derived from `AWS::IoT::Certificate::CommonName`, which corresponds to the device certificate's CN — the same convention as `auto` mode.",{"_3624":1524,"_31165":1336,"_21590":55619,"_5":14857,"_28357":55116,"_3076":55620},[],"This mode requires the `jitp_config.provisioning_role_arn` field to be configured with the ARN of an IAM role AWS IoT Core can assume to execute the template. If not configured, the connector uses the default `arn:aws:iam::{account}:role/JITPRole` and logs a warning. The administrator must ensure that role exists in the account and has the necessary permissions before enabling JITP mode.",{"_3624":1525,"_31165":1336,"_21590":55622,"_5":14857,"_28357":55120,"_3076":55623},[],"The DMS's `registration_mode` determines what the connector does on the AWS side when the DMS is created or fully edited:",{"_3624":1526,"_31165":1336,"_21590":55625,"_5":14857,"_28357":55120,"_3076":55521},[],{"_3624":1527,"_31165":1336,"_21590":55627,"_5":14857,"_28357":55120,"_3076":55524},[],{"_3624":1528,"_31165":1336,"_21590":55629,"_5":14857,"_28357":55120,"_3076":55630},[],"`Unconfigured` → `None` / `Auto`",{"_3624":1529,"_31165":1336,"_21590":55632,"_5":14857,"_28357":55120,"_3076":55633},[],"none (configuration only)",{"_3624":1530,"_31165":1336,"_21590":55635,"_5":14857,"_28357":55120,"_3076":55636},[],"`None` ↔ `Auto`",{"_3624":1531,"_31165":1336,"_21590":55638,"_5":14857,"_28357":55120,"_3076":55633},[],{"_3624":1532,"_31165":1336,"_21590":55640,"_5":14857,"_28357":55120,"_3076":55641},[],"Any → `Jitp`",{"_3624":1533,"_31165":1336,"_21590":55643,"_5":14857,"_28357":55120,"_3076":55644},[],"`iot:CreateProvisioningTemplate` (non-idempotent: it fails when the template already exists; after 3 retries the event lands in `lamassu-dlq`)",{"_3624":1534,"_31165":1336,"_21590":55646,"_5":14857,"_28357":55120,"_3076":55647},[],"`Jitp` → `None` / `Auto`",{"_3624":1535,"_31165":1336,"_21590":55649,"_5":14857,"_28357":55120,"_3076":55650},[],"none (the template stays in the AWS account)",{"_3624":1536,"_31165":1336,"_21590":55652,"_5":14857,"_28357":55124,"_3076":55653},[],"For the firmware developer, `auto` mode is transparent: the device performs its EST enrollment as usual and, as a side effect, it is provisioned in AWS IoT Core with no additional step.",{"_3624":1537,"_31165":1336,"_21590":55655,"_5":14857,"_28357":55124,"_3076":55656},[],"The full flow from the device's perspective is:",{"_3624":1538,"_31165":1336,"_21590":55658,"_5":14857,"_28357":55124,"_3076":55659},[],"Once the connector completes provisioning, the device can connect to the AWS IoT Core MQTT endpoint using its private key and the certificate issued by Lamassu. The ThingName it must identify itself with in AWS is exactly the certificate's CN.",{"_3624":1539,"_31165":1336,"_21590":55661,"_5":14857,"_28357":55128,"_3076":55662},[],"Things only exist under `auto` mode; in `jitp` mode AWS creates the Thing itself when the device first connects. The Thing name is always the device certificate's CN:",{"_3624":1540,"_31165":1336,"_21590":55664,"_5":14857,"_28357":55128,"_3076":55521},[],{"_3624":1541,"_31165":1336,"_21590":55666,"_5":14857,"_28357":55128,"_3076":55524},[],{"_3624":1542,"_31165":1336,"_21590":55668,"_5":14857,"_28357":55128,"_3076":55669},[],"`Absent` → `Provisioned`",{"_3624":1543,"_31165":1336,"_21590":55671,"_5":14857,"_28357":55128,"_3076":55672},[],"policies created/updated, Thing groups ensured, `iot:RegisterThing` (creates the Thing, registers the certificate, attaches policies)",{"_3624":1544,"_31165":1336,"_21590":55674,"_5":14857,"_28357":55128,"_3076":55675},[],"`Provisioned` → `Provisioned` (re-enrollment)",{"_3624":1545,"_31165":1336,"_21590":55677,"_5":14857,"_28357":55128,"_3076":55678},[],"stale principals marked `REVOKED`, new `iot:RegisterThing` run; the new certificate ARN replaces the old one in Lamassu metadata",{"_3624":1546,"_31165":1336,"_21590":55680,"_5":14857,"_28357":55128,"_3076":55681},[],"In `jitp` mode the connector makes no provisioning calls: AWS executes the JITP template on the device's first connection and creates the Thing, registers the certificate and activates it on its own.",{"_3624":1547,"_31165":1336,"_21590":55683,"_5":14857,"_28357":55132,"_3076":55684},[],"In JITP mode the device also performs its EST enrollment conventionally and obtains its certificate from Lamassu. The difference is that AWS IoT Core does not know the device until it attempts its first connection.",{"_3624":1548,"_31165":1336,"_21590":55686,"_5":14857,"_28357":55132,"_3076":55687},[],"When the device establishes its first MQTT connection to AWS IoT Core presenting the Lamassu-issued certificate, AWS detects that the certificate belongs to a CA registered with a JITP template, executes that template and creates the Thing automatically. The initial connection may fail or be delayed while the template runs; firmware must be prepared to retry the connection.",{"_3624":1549,"_31165":1336,"_21590":55689,"_5":14857,"_28357":55132,"_3076":55690},[],"For the JITP flow to work correctly:",{"_3624":1550,"_31165":1336,"_21590":55692,"_5":14857,"_28357":55132,"_3076":55693},[],"The CA must be registered in AWS in Primary Account mode (SNI-only mode does not support JITP).",{"_3624":1551,"_31165":1336,"_21590":55695,"_5":14857,"_28357":55132,"_3076":55696},[],"The IAM role configured in `jitp_config.provisioning_role_arn` must exist and have permissions to create Things, register certificates and attach policies in the AWS account.",{"_3624":1552,"_31165":1336,"_21590":55698,"_5":14857,"_28357":55132,"_3076":55699},[],"The device must present both its certificate and the issuing CA's certificate in the TLS handshake with AWS IoT Core.",{"_3624":1553,"_31165":1336,"_21590":55701,"_5":14857,"_28357":55132,"_3076":55702},[],"Certificates provisioned via JITP **do not have the connector's metadata key** (`lamassu.io/iot/{connector_id}`) in Lamassu. As a consequence, status changes of those certificates in Lamassu are not automatically synced to AWS through the state synchronization mechanism described in the next section.",{"_3624":1554,"_31165":1336,"_21590":55704,"_5":14857,"_28357":55136,"_3076":55705},[],"The connector listens for the `EventUpdateCertificateStatusKey` event and, when a certificate holding the connector's metadata key changes status in Lamassu, replicates that change in AWS IoT Core. The following table shows the status mapping:",{"_3624":1555,"_31165":1336,"_21590":55707,"_5":14857,"_28357":55136,"_3076":55708},[],"Status in Lamassu",{"_3624":1556,"_31165":1336,"_21590":55710,"_5":14857,"_28357":55136,"_3076":55711},[],"Revocation reason",{"_3624":1557,"_31165":1336,"_21590":55713,"_5":14857,"_28357":55136,"_3076":55714},[],"Status in AWS IoT Core",{"_3624":1558,"_31165":1336,"_21590":55716,"_5":14857,"_28357":55136,"_3076":55717},[],"`Active`",{"_3624":1559,"_31165":1336,"_21590":55719,"_5":14857,"_28357":55136,"_3076":55720},[],"None",{"_3624":1560,"_31165":1336,"_21590":55722,"_5":14857,"_28357":55136,"_3076":55723},[],"`ACTIVE`",{"_3624":1561,"_31165":1336,"_21590":55725,"_5":14857,"_28357":55136,"_3076":55726},[],"`Revoked`",{"_3624":1562,"_31165":1336,"_21590":55728,"_5":14857,"_28357":55136,"_3076":55729},[],"`certificateHold`",{"_3624":1563,"_31165":1336,"_21590":55731,"_5":14857,"_28357":55136,"_3076":55732},[],"`INACTIVE`",{"_3624":1564,"_31165":1336,"_21590":55734,"_5":14857,"_28357":55136,"_3076":55726},[],{"_3624":1565,"_31165":1336,"_21590":55736,"_5":14857,"_28357":55136,"_3076":55737},[],"Any other reason",{"_3624":1566,"_31165":1336,"_21590":55739,"_5":14857,"_28357":55136,"_3076":55740},[],"`REVOKED`",{"_3624":1567,"_31165":1336,"_21590":55742,"_5":14857,"_28357":55136,"_3076":55743},[],"Only the `Active` and `Revoked` states produce a call to `iot:UpdateCertificate`. The other lifecycle states of Lamassu (`RenewalWindow`, `AboutToExpire`, `Expired`) are not synced to AWS IoT Core; the certificate status in AWS remains unchanged until the status in Lamassu becomes `Active` or `Revoked`.",{"_3624":1568,"_31165":1336,"_21590":55745,"_5":14857,"_28357":55140,"_3076":55746},[],"Certificates holding the connector's metadata key sync their status; certificates provisioned via JITP have no metadata key and stay out of this machine:",{"_3624":1569,"_31165":1336,"_21590":55748,"_5":14857,"_28357":55140,"_3076":55521},[],{"_3624":1570,"_31165":1336,"_21590":55750,"_5":14857,"_28357":55140,"_3076":55524},[],{"_3624":1571,"_31165":1336,"_21590":55752,"_5":14857,"_28357":55140,"_3076":55753},[],"`NotSynced` → `Active`",{"_3624":1572,"_31165":1336,"_21590":55755,"_5":14857,"_28357":55140,"_3076":55232},[],{"_3624":1573,"_31165":1336,"_21590":55757,"_5":14857,"_28357":55140,"_3076":55758},[],"`Active` → `Inactive`",{"_3624":1574,"_31165":1336,"_21590":55760,"_5":14857,"_28357":55140,"_3076":55761},[],"`iot:UpdateCertificate` + forced MQTT disconnect",{"_3624":1575,"_31165":1336,"_21590":55763,"_5":14857,"_28357":55140,"_3076":55764},[],"`Active` → `Revoked`",{"_3624":1576,"_31165":1336,"_21590":55766,"_5":14857,"_28357":55140,"_3076":55761},[],{"_3624":1577,"_31165":1336,"_21590":55768,"_5":14857,"_28357":55140,"_3076":55769},[],"`Inactive` / `Revoked` → `Active`",{"_3624":1578,"_31165":1336,"_21590":55771,"_5":14857,"_28357":55140,"_3076":55232},[],{"_3624":1579,"_31165":1336,"_21590":55773,"_5":14857,"_28357":55140,"_3076":55774},[],"`RenewalWindow` / `AboutToExpire` / `Expired`",{"_3624":1580,"_31165":1336,"_21590":55776,"_5":14857,"_28357":55140,"_3076":55777},[],"none (these states are not synced to AWS)",{"_3624":1581,"_31165":1336,"_21590":55779,"_5":14857,"_28357":55144,"_3076":55780},[],"When the connector marks a certificate as `REVOKED` or `INACTIVE` in AWS, it additionally performs a forced disconnect of the device. To do so it opens an MQTT connection over WebSocket (with SigV4 authentication using the connector's credentials) to the AWS IoT Core data endpoint, using the certificate's CN as the MQTT client identifier, and closes it immediately. This terminates any active MQTT session the device may have at that moment.",{"_3624":1582,"_31165":1336,"_21590":55782,"_5":14857,"_28357":55144,"_3076":55783},[],"This forced disconnect happens at the moment Lamassu records the status change. If the device tries to reconnect after the disconnect, AWS IoT Core will reject the connection because the certificate is already listed as `REVOKED` or `INACTIVE`.",{"_3624":1583,"_31165":1336,"_21590":55785,"_5":14857,"_28357":55144,"_3076":55786},[],"Certificates provisioned in JITP mode do not have this automatic sync, since they lack the connector's metadata key.",{"_3624":1584,"_31165":1336,"_21590":55788,"_5":14857,"_28357":55148,"_3076":55789},[],"The connector can write to the AWS IoT Core Device Shadow to send action signals to the device firmware. This feature is enabled per DMS with `shadow_config.enable: true`.",{"_3624":1585,"_31165":1336,"_21590":55791,"_5":14857,"_28357":55148,"_3076":55792},[],"If `shadow_config.shadow_name` holds a value, the connector uses a Named Shadow with that name; otherwise it uses the Classic Shadow (the Thing's default shadow).",{"_3624":1586,"_31165":1336,"_21590":55794,"_5":14857,"_28357":55152,"_3076":55795},[],"The connector writes to the `desired.identity_actions` field of the shadow document. Each entry contains a Unix timestamp in milliseconds. The device firmware must read this field and act accordingly.",{"_3624":1587,"_31165":1336,"_21590":55797,"_5":14857,"_28357":55152,"_3076":55798},[],"There are two action types:",{"_3624":1588,"_31165":1336,"_21590":55800,"_5":14857,"_28357":55152,"_3076":55801},[],"**`UPDATE_CERTIFICATE`**: written when a certificate's preventive renewal window activates — that is, when the `triggered` field of the preventive renewal delta flips from `false` to `true`. This action tells the device it must start the re-enrollment process to renew its certificate before it expires.",{"_3624":1589,"_31165":1336,"_21590":55803,"_5":14857,"_28357":55152,"_3076":55804},[],"**`UPDATE_TRUST_ANCHOR_LIST`**: written to all devices of a DMS when the DMS's `ManagedCAs` list changes. This action tells the device it must update its trusted CA store.",{"_3624":1590,"_31165":1336,"_21590":55806,"_5":14857,"_28357":55152,"_3076":55807},[],"The shadow write process consists of reading the current shadow (`iotdata:GetThingShadow`), merging the new actions with the existing ones and writing the result (`iotdata:UpdateThingShadow`). If the shadow does not exist, the connector creates it. After a successful write, the list of pending actions in the device's metadata in Lamassu is cleared.",{"_3624":1591,"_31165":1336,"_21590":55809,"_5":14857,"_28357":55156,"_3076":55810},[],"The connector creates and attaches the policies configured in the DMS. A typical policy for a device using MQTT and the Device Shadow has this structure:",{"_3624":1592,"_31165":1336,"_21590":55812,"_5":14857,"_28357":55156,"_3076":55813},[],"In the policy above, the `<AWS_REGION>` and `<AWS_ACCOUNT_ID>` placeholders must be replaced with the AWS region and the twelve-digit account identifier of the target account before applying the policy. The `${iot:Connection.Thing.ThingName}` variable automatically limits each permission to the Thing the device is connected as, following the principle of least privilege. The `${ShadowName}` variable in the shadow ARNs is a placeholder that must be replaced with the `shadow_config.shadow_name` value configured in the DMS; if the Classic Shadow is used, it can be simplified by removing the `name/${ShadowName}/` segment. AWS IoT policies do not support regex alternation; the `[name/${ShadowName}/]*` notation represents the optionality of that segment within ARN syntax constraints.",{"_3624":1593,"_31165":1336,"_21590":55815,"_5":14857,"_28357":55156,"_3076":55816},[],"The first statement lets the device connect using its ThingName as the MQTT identifier. The second authorizes publishing to the Thing's generic MQTT topic and to the shadow topics, needed so the device can update its reported state. The last two statements grant subscribe and receive permissions over the same topics, letting the device receive shadow updates (for example, the `UPDATE_CERTIFICATE` and `UPDATE_TRUST_ANCHOR_LIST` actions written by the connector).",{"_3624":1594,"_31165":1336,"_21590":55818,"_5":14857,"_28357":55160,"_3076":55819},[],"**Symptom:** The CA registration stays in `REQUESTED` indefinitely.",{"_3624":1595,"_31165":1336,"_21590":55821,"_5":14857,"_28357":55160,"_3076":55822},[],"**Cause:** The connector is not running or is not subscribed to the event bus. It can also indicate incorrect IAM credentials, insufficient permissions or that the metadata key was written with a wrong `connector_id`.",{"_3624":1596,"_31165":1336,"_21590":55824,"_5":14857,"_28357":55160,"_3076":55825},[],"**Resolution:** Verify the connector process is active and the logs show no AWS communication errors. Check the metadata field was written under the exact key `lamassu.io/iot/{connector_id}`. If the error persists, the connector will update the status to `FAILED` with a descriptive message in the CA metadata.",{"_3624":1597,"_31165":1336,"_21590":55827,"_5":14857,"_28357":55160,"_3076":55828},[],"**Symptom:** A certificate's status is not synced to AWS after a revocation.",{"_3624":1598,"_31165":1336,"_21590":55830,"_5":14857,"_28357":55160,"_3076":55831},[],"**Cause:** Most commonly the certificate was provisioned in JITP mode. JITP certificates lack the connector's metadata key and are outside the state synchronization mechanism. If the DMS is in `auto` mode, it may indicate the initial provisioning did not complete correctly and the AWS ARN was not stored in the certificate metadata.",{"_3624":1599,"_31165":1336,"_21590":55833,"_5":14857,"_28357":55160,"_3076":55834},[],"**Resolution:** For JITP certificates, migrate the DMS to `auto` mode and re-provision the affected devices. For `auto` mode certificates, verify the certificate has the AWS ARN stored in its metadata; if not, repeat the provisioning.",{"_3624":1600,"_31165":1336,"_21590":55836,"_5":14857,"_28357":55160,"_3076":55837},[],"**Symptom:** The forced disconnect does not terminate the device's MQTT session after revocation.",{"_3624":1601,"_31165":1336,"_21590":55839,"_5":14857,"_28357":55160,"_3076":55840},[],"**Cause:** The device uses an MQTT client ID different from the certificate's CN. The forced disconnect opens a connection using the CN as client ID; if the firmware uses another identifier, the disconnect does not affect that session.",{"_3624":1602,"_31165":1336,"_21590":55842,"_5":14857,"_28357":55160,"_3076":55843},[],"**Resolution:** Make sure the firmware uses exactly the certificate's CN as the MQTT client identifier. That CN matches the ThingName in AWS IoT Core.",{"_3624":1603,"_31165":1336,"_21590":55845,"_5":14857,"_28357":55160,"_3076":55846},[],"**Symptom:** The device receives `CLIENT_ID_REJECTED` when connecting to AWS IoT Core.",{"_3624":1604,"_31165":1336,"_21590":55848,"_5":14857,"_28357":55160,"_3076":55849},[],"**Cause:** The MQTT client ID does not match the ThingName, which is always the CN of the certificate issued by Lamassu.",{"_3624":1605,"_31165":1336,"_21590":55851,"_5":14857,"_28357":55160,"_3076":55852},[],"**Resolution:** Verify the firmware uses exactly the value of the CN field included in the enrollment CSR as the MQTT client identifier.",{"_3624":1606,"_31165":1336,"_21590":55854,"_5":14857,"_28357":55160,"_3076":55855},[],"**Symptom:** The device's first MQTT connection in JITP mode fails or times out.",{"_3624":1607,"_31165":1336,"_21590":55857,"_5":14857,"_28357":55160,"_3076":55858},[],"**Cause:** This is expected behavior while AWS executes the JITP template on the device's first connection.",{"_3624":1608,"_31165":1336,"_21590":55860,"_5":14857,"_28357":55160,"_3076":55861},[],"**Resolution:** Firmware must implement retries with exponential backoff for the first connection. If the failure persists beyond a few minutes, verify the IAM role configured in `jitp_config.provisioning_role_arn` exists in the account and has permissions to create Things, register certificates and attach policies.",{"_3624":1609,"_31165":1336,"_21590":55863,"_5":14857,"_28357":55160,"_3076":55864},[],"**Symptom:** The Device Shadow is not updated when it should be.",{"_3624":1610,"_31165":1336,"_21590":55866,"_5":14857,"_28357":55160,"_3076":55867},[],"**Cause:** The shadow feature is disabled in the DMS configuration, the connector's credentials lack IoT data-plane permissions, or the firmware reads a different shadow than the configured one.",{"_3624":1611,"_31165":1336,"_21590":55869,"_5":14857,"_28357":55160,"_3076":55870},[],"**Resolution:** Check that `shadow_config.enable` is `true` in the connector metadata for the corresponding DMS. If a Named Shadow is used, verify `shadow_config.shadow_name` holds the correct name and that the firmware reads that Named Shadow and not the Classic Shadow. Confirm the connector's credentials have `iotdata:GetThingShadow` and `iotdata:UpdateThingShadow` permissions.",{"_3624":1612,"_31165":1336,"_21590":55872,"_5":14857,"_28357":55160,"_3076":55873},[],"**Symptom:** After editing a DMS in `jitp` mode, DMS update messages appear in `lamassu-dlq`, or JITP configuration changes have no effect in AWS.",{"_3624":1613,"_31165":1336,"_21590":55875,"_5":14857,"_28357":55160,"_3076":55876},[],"**Cause:** Every full DMS edit (`PUT /v1/dms/{id}`) triggers a `CreateProvisioningTemplate` attempt for the template named after the DMS ID, and the call is not idempotent: when the template already exists, it fails, the event is retried three times and finally lands in `lamassu-dlq`. The connector’s later steps are skipped.",{"_3624":1614,"_31165":1336,"_21590":55878,"_5":14857,"_28357":55160,"_3076":55879},[],"**Resolution:** Check that the template named with the DMS ID exists in AWS IoT Core and that JITP enrollment works. If the JITP configuration was changed, apply it by hand to the AWS template.",{"_3624":1615,"_31165":1336,"_21590":55881,"_5":14857,"_28357":55160,"_3076":55882},[],"<Card title=\"Configure a DMS\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_3624":1616,"_31165":1336,"_21590":55884,"_5":14857,"_28357":55160,"_3076":55885},[],"<Card title=\"Device enrollment (EST)\" href=\"/docs/platform/iot-fleets/enrollment/overview\" />",{"_3624":1617,"_31165":1336,"_21590":55887,"_5":14857,"_28357":55160,"_3076":55888},[],"<Card title=\"Certificate management\" href=\"/docs/platform/pki/certificates\" />",{"_3624":1618,"_31165":1618,"_5":15217,"_3076":53584,"_31503":55890,"_21590":55891,"_28357":1618},[50900,52412,53584],[],{"_3624":1619,"_31165":1618,"_21590":55893,"_5":14857,"_28357":1618,"_3076":55894},[],"Organize devices and their identities, prepare enrollment and integrate consumers.",{"_3624":1620,"_31165":1618,"_5":31500,"_21590":55896,"_28357":55897,"_3076":55898},[],"/docs/platform/iot-fleets/overview#start-here","Start here",{"_3624":1621,"_31165":1618,"_5":31500,"_21590":55900,"_28357":55901,"_3076":53582},[],"/docs/platform/iot-fleets/overview#devices-and-identities",{"_3624":1622,"_31165":1618,"_5":31500,"_21590":55903,"_28357":55904,"_3076":53768},[],"/docs/platform/iot-fleets/overview#enrollment-with-pki",{"_3624":1623,"_31165":1618,"_5":31500,"_21590":55906,"_28357":55907,"_3076":55057},[],"/docs/platform/iot-fleets/overview#integrations",{"_3624":1624,"_31165":1618,"_5":31500,"_21590":55909,"_28357":55910,"_3076":55911},[],"/docs/platform/iot-fleets/overview#who-prepares-each-part","Who prepares each part",{"_3624":1625,"_31165":1618,"_21590":55913,"_5":14857,"_28357":1618,"_3076":55914},[],"IoT Fleets applies PKI to the device lifecycle: registration, obtaining an identity, renewal and retirement. It is intended for those who administer a device population and those who integrate its enrollment client or the system that accepts it.",{"_3624":1626,"_31165":1618,"_21590":55916,"_5":14857,"_28357":55897,"_3076":55917},[],"Follow Enroll and connect your first device to prepare a DMS, obtain the identity from the client and demonstrate an mTLS connection. The automatic path includes initial trust, a CSR and result checks.",{"_3624":1627,"_31165":1618,"_21590":55919,"_5":14857,"_28357":55897,"_3076":55920},[],"To start with an existing certificate, use Register a device manually. You can then prepare enrollment and renewal for the next device.",{"_3624":1628,"_31165":1618,"_21590":55922,"_5":14857,"_28357":55901,"_3076":55923},[],"Resource",{"_3624":1629,"_31165":1618,"_21590":55925,"_5":14857,"_28357":55901,"_3076":55926},[],"What it represents",{"_3624":1630,"_31165":1618,"_21590":55928,"_5":14857,"_28357":55901,"_3076":55929},[],"**Device**",{"_3624":1631,"_31165":1618,"_21590":55931,"_5":14857,"_28357":55901,"_3076":55932},[],"An inventory entry with an identifier, owning DMS and classification.",{"_3624":1632,"_31165":1618,"_21590":55934,"_5":14857,"_28357":55901,"_3076":55935},[],"**Identity**",{"_3624":1633,"_31165":1618,"_21590":55937,"_5":14857,"_28357":55901,"_3076":55938},[],"The device's association with its certificates: an active version and a history.",{"_3624":1634,"_31165":1618,"_21590":55940,"_5":14857,"_28357":55901,"_3076":55941},[],"**DMS**",{"_3624":1635,"_31165":1618,"_21590":55943,"_5":14857,"_28357":55901,"_3076":55944},[],"The service that configures admission, enrollment, renewal and trust distribution.",{"_3624":1636,"_31165":1618,"_21590":55946,"_5":14857,"_28357":55901,"_3076":55947},[],"**Fleet**",{"_3624":1637,"_31165":1618,"_21590":55949,"_5":14857,"_28357":55901,"_3076":55950},[],"The population you operate, represented through devices, DMSs, tags and metadata.",{"_3624":1638,"_31165":1618,"_21590":55952,"_5":14857,"_28357":55901,"_3076":55953},[],"Each device has an owning DMS. You can organize a population through several DMSs when it needs different policies, and use tags to classify it. “Fleet” describes that operational context; the resources you create and query are DMSs and devices.",{"_3624":1639,"_31165":1618,"_21590":55955,"_5":14857,"_28357":55901,"_3076":55956},[],"Device management covers states, certificate history and identity actions. During renewal, retain the relationship with the device and check which certificate becomes the current identity.",{"_3624":1640,"_31165":1618,"_21590":55958,"_5":14857,"_28357":55904,"_3076":55959},[],"This section connects PKI rules to the device client. Preparation follows this order:",{"_3624":1641,"_31165":1618,"_21590":55961,"_5":14857,"_28357":55904,"_3076":55962},[],"**CA and profile:** prepare the issuer and certificate rules in PKI.",{"_3624":1642,"_31165":1618,"_21590":55964,"_5":14857,"_28357":55904,"_3076":55965},[],"**DMS policy:** define how the device is admitted, how requests authenticate and which trust is distributed.",{"_3624":1643,"_31165":1618,"_21590":55967,"_5":14857,"_28357":55904,"_3076":55968},[],"**Client:** prepare the initial credential, server trust, and key generation or custody.",{"_3624":1644,"_31165":1618,"_21590":55970,"_5":14857,"_28357":55904,"_3076":55971},[],"**Result:** request the certificate, install it and check its association with the device.",{"_3624":1645,"_31165":1618,"_21590":55973,"_5":14857,"_28357":55904,"_3076":55974},[],"**Continuity:** configure renewal, successor installation and recovery according to DMS policy.",{"_3624":1646,"_31165":1618,"_21590":55976,"_5":14857,"_28357":55904,"_3076":55977},[],"<Card title=\"Configure the DMS\" description=\"Prepare the CA, admission, authentication and renewal rules.\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_3624":1647,"_31165":1618,"_21590":55979,"_5":14857,"_28357":55904,"_3076":55980},[],"<Card title=\"Integrate the EST client\" description=\"Review the device endpoints, formats and checks.\" href=\"/docs/platform/iot-fleets/enrollment/est-client\" />",{"_3624":1648,"_31165":1618,"_21590":55982,"_5":14857,"_28357":55907,"_3076":55983},[],"An issued identity needs a consumer that trusts its issuer, validates the certificate and grants the device permissions. Prepare both the device's trust in the server and the server's trust in the device.",{"_3624":1649,"_31165":1618,"_21590":55985,"_5":14857,"_28357":55907,"_3076":55986},[],"The AWS IoT Core guide explains how to use the identity in that destination. Provisioning in Lamassu and provisioning in the destination are separate decisions; review the conditions of the chosen mode before expecting state synchronization.",{"_3624":1650,"_31165":1618,"_21590":55988,"_5":14857,"_28357":55910,"_3076":55989},[],"Participant",{"_3624":1651,"_31165":1618,"_21590":55991,"_5":14857,"_28357":55910,"_3076":55992},[],"Responsibility",{"_3624":1652,"_31165":1618,"_21590":55994,"_5":14857,"_28357":55910,"_3076":55995},[],"PKI administrator",{"_3624":1653,"_31165":1618,"_21590":55997,"_5":14857,"_28357":55910,"_3076":55998},[],"CA, issuance profile, chain and revocation publication.",{"_3624":1654,"_31165":1618,"_21590":56000,"_5":14857,"_28357":55910,"_3076":56001},[],"Provisioning administrator",{"_3624":1655,"_31165":1618,"_21590":56003,"_5":14857,"_28357":55910,"_3076":56004},[],"DMS, admission, authentication per operation and inventory.",{"_3624":1656,"_31165":1618,"_21590":56006,"_5":14857,"_28357":55910,"_3076":56007},[],"Device integrator",{"_3624":1657,"_31165":1618,"_21590":56009,"_5":14857,"_28357":55910,"_3076":56010},[],"Initial credential, key, EST client, trust and certificate installation.",{"_3624":1658,"_31165":1618,"_21590":56012,"_5":14857,"_28357":55910,"_3076":56013},[],"Consumer integrator",{"_3624":1659,"_31165":1618,"_21590":56015,"_5":14857,"_28357":55910,"_3076":56016},[],"Trusted issuers, validation and device permissions in the destination.",{"_3624":1660,"_31165":1618,"_21590":56018,"_5":14857,"_28357":55910,"_3076":56019},[],"Permissions and audit are shared with the rest of Platform. Prepare installation and instance connectivity in Deployment.",{"_3624":1661,"_31165":1661,"_5":15217,"_3076":56021,"_31503":56022,"_21590":56024,"_28357":1661},"Enroll and connect your first device",[50900,52412,53584,56023],"Getting started",[],{"_3624":1662,"_31165":1661,"_21590":56026,"_5":14857,"_28357":1661,"_3076":56027},[],"Obtain an identity through EST, verify its association and use it in an mTLS connection.",{"_3624":1663,"_31165":1661,"_5":31500,"_21590":56029,"_28357":56030,"_3076":50910},[],"/docs/platform/iot-fleets/quickstarts/enroll-device#before-you-begin",{"_3624":1664,"_31165":1661,"_5":31500,"_21590":56032,"_28357":56033,"_3076":56034},[],"/docs/platform/iot-fleets/quickstarts/enroll-device#prepare-the-bootstrap-credential","Prepare the bootstrap credential",{"_3624":1665,"_31165":1661,"_5":31500,"_21590":56036,"_28357":56037,"_3076":56038},[],"/docs/platform/iot-fleets/quickstarts/enroll-device#configure-the-evaluation-dms","Configure the evaluation DMS",{"_3624":1666,"_31165":1661,"_5":31500,"_21590":56040,"_28357":56041,"_3076":56042},[],"/docs/platform/iot-fleets/quickstarts/enroll-device#prepare-the-client-and-check-cacerts","Prepare the client and check cacerts",{"_3624":1667,"_31165":1661,"_5":31500,"_21590":56044,"_28357":56045,"_3076":56046},[],"/docs/platform/iot-fleets/quickstarts/enroll-device#enroll-the-device","Enroll the device",{"_3624":1668,"_31165":1661,"_5":31500,"_21590":56048,"_28357":56049,"_3076":56050},[],"/docs/platform/iot-fleets/quickstarts/enroll-device#verify-the-obtained-identity","Verify the obtained identity",{"_3624":1669,"_31165":1661,"_5":31500,"_21590":56052,"_28357":56053,"_3076":56054},[],"/docs/platform/iot-fleets/quickstarts/enroll-device#demonstrate-an-mtls-connection","Demonstrate an mTLS connection",{"_3624":1670,"_31165":1661,"_5":31500,"_21590":56056,"_28357":56057,"_3076":56058},[],"/docs/platform/iot-fleets/quickstarts/enroll-device#result-and-continuity","Result and continuity",{"_3624":1671,"_31165":1661,"_21590":56060,"_5":14857,"_28357":1661,"_3076":56061},[],"Prepare an evaluation DMS, enroll `est-device-001` from the client and use its identity with a local consumer that requires a certificate. The path connects administrator policy to the material the device actually installs.",{"_3624":1672,"_31165":1661,"_21590":56063,"_5":14857,"_28357":56030,"_3076":56064},[],"A Lamassu instance accessible through HTTPS and permissions for CAs, profiles, DMSs and reading devices/certificates.",{"_3624":1673,"_31165":1661,"_21590":56066,"_5":14857,"_28357":56030,"_3076":56067},[],"Bash, OpenSSL 3.x, curl with `--fail-with-body` and two terminals on your computer. Work in a new directory with restricted access.",{"_3624":1674,"_31165":1661,"_21590":56069,"_5":14857,"_28357":56030,"_3076":56070},[],"An active root CA that issues directly, with an available key and sufficient validity. Follow Create your first CA. Save its verified public certificate as `device-root.pem`.",{"_3624":1675,"_31165":1661,"_21590":56072,"_5":14857,"_28357":56030,"_3076":56073},[],"Available global identifier `est-device-001`. This path uses automatic registration: do not create the device in the console first.",{"_3624":1676,"_31165":1661,"_21590":56075,"_5":14857,"_28357":56030,"_3076":56076},[],"The approved root for Lamassu HTTPS in `est-trust.pem`, obtained through an independent channel. It can differ from the device CA; prepare networking/TLS in Deployment.",{"_3624":1677,"_31165":1661,"_21590":56078,"_5":14857,"_28357":56033,"_3076":56079},[],"Issue a bootstrap leaf certificate with `CN=est-device-001`, its own key and Client Authentication use. Follow Issue and verify a certificate, changing its CN and saving the result as `bootstrap.crt` and `bootstrap.key`. Choose validity that covers this test and check the pair and chain.",{"_3624":1678,"_31165":1661,"_21590":56081,"_5":14857,"_28357":56033,"_3076":56082},[],"The same root CA can issue it for this isolated evaluation. The operational identity will have a different key and certificate. The matching CN makes the example easier to read; initial certificate authentication does not itself bind the bootstrap CN to the requested ID. Review admission before applying the policy to a population.",{"_3624":1679,"_31165":1661,"_21590":56084,"_5":14857,"_28357":56037,"_3076":56085},[],"Create an explicit leaf profile compatible with EC P-256, with **Honor Subject**, CN from the CSR, **Digital Signature**, **Client Authentication** and **1 hour** validity within the root's validity. Do not enable CA signing. Rules and precedence are explained in Profiles.",{"_3624":1680,"_31165":1661,"_21590":56087,"_5":14857,"_28357":56037,"_3076":56088},[],"Create the `Acme EST Evaluation` DMS with this configuration:",{"_3624":1681,"_31165":1661,"_21590":56090,"_5":14857,"_28357":56037,"_3076":56091},[],"Setting",{"_3624":1682,"_31165":1661,"_21590":56093,"_5":14857,"_28357":56037,"_3076":56094},[],"Evaluation value",{"_3624":1683,"_31165":1661,"_21590":56096,"_5":14857,"_28357":56037,"_3076":56097},[],"Enrollment CA",{"_3624":1684,"_31165":1661,"_21590":56099,"_5":14857,"_28357":56037,"_3076":56100},[],"Issuing root from `device-root.pem`.",{"_3624":1685,"_31165":1661,"_21590":56102,"_5":14857,"_28357":56037,"_3076":53904},[],{"_3624":1686,"_31165":1661,"_21590":56104,"_5":14857,"_28357":56037,"_3076":56105},[],"The 1-hour leaf profile you just prepared.",{"_3624":1687,"_31165":1661,"_21590":56107,"_5":14857,"_28357":56037,"_3076":56108},[],"Protocol / Registration Mode",{"_3624":1688,"_31165":1661,"_21590":56110,"_5":14857,"_28357":56037,"_3076":56111},[],"`EST_RFC7030` / `JITP`.",{"_3624":1689,"_31165":1661,"_21590":56113,"_5":14857,"_28357":56037,"_3076":56114},[],"Verify CSR Signature",{"_3624":1690,"_31165":1661,"_21590":56116,"_5":14857,"_28357":56037,"_3076":56117},[],"Enabled.",{"_3624":1691,"_31165":1661,"_21590":56119,"_5":14857,"_28357":56037,"_3076":56120},[],"Enable Replaceable Enrollment",{"_3624":1692,"_31165":1661,"_21590":56122,"_5":14857,"_28357":56037,"_3076":56123},[],"Disabled; the ID must be new.",{"_3624":1693,"_31165":1661,"_21590":56125,"_5":14857,"_28357":56037,"_3076":56126},[],"Initial authentication",{"_3624":1694,"_31165":1661,"_21590":56128,"_5":14857,"_28357":56037,"_3076":56129},[],"`CLIENT_CERTIFICATE`; Validation CAs includes the direct bootstrap issuer; no expired certificates.",{"_3624":1695,"_31165":1661,"_21590":56131,"_5":14857,"_28357":56037,"_3076":56132},[],"Renewal authentication",{"_3624":1696,"_31165":1661,"_21590":56134,"_5":14857,"_28357":56037,"_3076":56135},[],"`CLIENT_CERTIFICATE`, configured in the independent re-enrollment block.",{"_3624":1697,"_31165":1661,"_21590":56137,"_5":14857,"_28357":56037,"_3076":56138},[],"Re-enrollment Validation CAs / Enable Expired Renewal",{"_3624":1698,"_31165":1661,"_21590":56140,"_5":14857,"_28357":56037,"_3076":56141},[],"Not needed for this direct issuance; the Enrollment CA is always trusted for re-enrollment / disabled.",{"_3624":1699,"_31165":1661,"_21590":56143,"_5":14857,"_28357":56037,"_3076":56144},[],"Re-enrollment Delta",{"_3624":1700,"_31165":1661,"_21590":56146,"_5":14857,"_28357":56037,"_3076":56147},[],"1 hour.",{"_3624":1701,"_31165":1661,"_21590":56149,"_5":14857,"_28357":56037,"_3076":56150},[],"Preventive / Critical Delta",{"_3624":1702,"_31165":1661,"_21590":56152,"_5":14857,"_28357":56037,"_3076":56153},[],"30 minutes / 10 minutes.",{"_3624":1703,"_31165":1661,"_21590":56155,"_5":14857,"_28357":56037,"_3076":56156},[],"Revoke on Re-enrollment",{"_3624":1704,"_31165":1661,"_21590":56158,"_5":14857,"_28357":56037,"_3076":56159},[],"Disabled to test the successor before retiring the previous identity.",{"_3624":1705,"_31165":1661,"_21590":56161,"_5":14857,"_28357":56037,"_3076":53912},[],{"_3624":1706,"_31165":1661,"_21590":56163,"_5":14857,"_28357":56037,"_3076":56164},[],"Disabled; the operational key is generated in the client.",{"_3624":1707,"_31165":1661,"_21590":56166,"_5":14857,"_28357":56037,"_3076":56167},[],"CA Distribution",{"_3624":1708,"_31165":1661,"_21590":56169,"_5":14857,"_28357":56037,"_3076":56170},[],"Include Enrollment CA enabled; Include Lamassu System CA disabled.",{"_3624":1709,"_31165":1661,"_21590":56172,"_5":14857,"_28357":56037,"_3076":56173},[],"Equal duration and window allow immediate renewal testing. These are evaluation values; size production settings according to connectivity and recovery times. Save, reread both authentication blocks and retain the DMS ID. The console exposes independent editors for the enrollment and re-enrollment authentication; the DMS guide describes their fields, and you can also check the resource through the DMS API.",{"_3624":1710,"_31165":1661,"_21590":56175,"_5":14857,"_28357":56041,"_3076":56176},[],"Place the four trust and bootstrap files in the new directory. Replace the URL with your installation's URL:",{"_3624":1711,"_31165":1661,"_21590":56178,"_5":14857,"_28357":56041,"_3076":56179},[],"The download must succeed and contain the expected enrollment root. Compare its fingerprint with `device-root.pem`. This check does not turn the response into initial trust or prove that you can issue.",{"_3624":1712,"_31165":1661,"_21590":56181,"_5":14857,"_28357":56045,"_3076":56182},[],"Generate a new key and CSR with the selected identifier:",{"_3624":1713,"_31165":1661,"_21590":56184,"_5":14857,"_28357":56045,"_3076":56185},[],"Request the identity with the bootstrap credential and extract the certificate from the default response:",{"_3624":1714,"_31165":1661,"_21590":56187,"_5":14857,"_28357":56045,"_3076":56188},[],"If curl fails, use Troubleshooting with the saved body. Do not convert it or repeat the request without querying inventory: a timeout or error can follow persisted issuance.",{"_3624":1715,"_31165":1661,"_21590":56190,"_5":14857,"_28357":56049,"_3076":56191},[],"Expect `device.crt: OK` and exit code 0 from `cmp`. Check the CN, serial, dates, Digital Signature and Client Authentication. The certificate must be a leaf: it must not declare `CA:TRUE` or Certificate Sign use. Check that its validity matches the one-hour profile.",{"_3624":1716,"_31165":1661,"_21590":56193,"_5":14857,"_28357":56049,"_3076":56194},[],"In Lamassu, open `est-device-001`. It must be created with the intended owning DMS, a current identity and the received certificate in its history. Compare the local serial with the slot; thresholds can show a renewal state rather than simply Active.",{"_3624":1717,"_31165":1661,"_21590":56196,"_5":14857,"_28357":56053,"_3076":56197},[],"In a second terminal, enter the same directory and run `umask 077`. Create a local server certificate and start a test consumer. This server trusts `device-root.pem` and requires a valid client identity:",{"_3624":1718,"_31165":1661,"_21590":56199,"_5":14857,"_28357":56053,"_3076":56200},[],"Leave it running. In the first terminal, connect using the obtained identity:",{"_3624":1719,"_31165":1661,"_21590":56202,"_5":14857,"_28357":56053,"_3076":56203},[],"Expect HTTP `200`. The client's trust in this local server is its self-signed `consumer.crt`; the server verifies the device against `device-root.pem`. The HTML file displays OpenSSL diagnostic information.",{"_3624":1720,"_31165":1661,"_21590":56205,"_5":14857,"_28357":56053,"_3076":56206},[],"With the same server still running, test that a request without a client certificate is rejected:",{"_3624":1721,"_31165":1661,"_21590":56208,"_5":14857,"_28357":56053,"_3076":56209},[],"Rejection must correspond to a missing certificate at the server, not a stopped server. Stop the consumer with Ctrl+C after the test. This exercise demonstrates TLS authentication and key possession; your application must also define authorization and revocation consumption. Server options are described in openssl-s\\_server.",{"_3624":1722,"_31165":1661,"_21590":56211,"_5":14857,"_28357":56057,"_3076":56212},[],"Check",{"_3624":1723,"_31165":1661,"_21590":56214,"_5":14857,"_28357":56057,"_3076":56215},[],"Expected result",{"_3624":1724,"_31165":1661,"_21590":56217,"_5":14857,"_28357":56057,"_3076":56218},[],"Registration",{"_3624":1725,"_31165":1661,"_21590":56220,"_5":14857,"_28357":56057,"_3076":56221},[],"ID created automatically and correct DMS.",{"_3624":1726,"_31165":1661,"_21590":56223,"_5":14857,"_28357":56057,"_3076":55479},[],{"_3624":1727,"_31165":1661,"_21590":56225,"_5":14857,"_28357":56057,"_3076":56226},[],"CN, profile, serial and key verified.",{"_3624":1728,"_31165":1661,"_21590":56228,"_5":14857,"_28357":56057,"_3076":56229},[],"Inventory",{"_3624":1729,"_31165":1661,"_21590":56231,"_5":14857,"_28357":56057,"_3076":56232},[],"Received serial visible as the current identity and in history.",{"_3624":1730,"_31165":1661,"_21590":56234,"_5":14857,"_28357":56057,"_3076":56235},[],"Consumer",{"_3624":1731,"_31165":1661,"_21590":56237,"_5":14857,"_28357":56057,"_3076":56238},[],"mTLS responds 200 with the identity and rejects a missing certificate.",{"_3624":1732,"_31165":1661,"_21590":56240,"_5":14857,"_28357":56057,"_3076":56241},[],"Continue with Renewal and recovery to request a successor pair within the window, install it and repeat the mTLS check. The consumer must use the new files in that test. After checking the successor, retire the previous certificate according to PKI policy; the example does not revoke it automatically.",{"_3624":1733,"_31165":1661,"_21590":56243,"_5":14857,"_28357":56057,"_3076":56244},[],"Devices and identities explains retirement and the limits of historical revocation. For a real destination, prepare consumer trust, validation and permissions; AWS IoT Core is an available integration.",{"_3624":1734,"_31165":1734,"_5":15217,"_3076":53600,"_31503":56246,"_21590":56247,"_28357":1734},[50900,52412,53584,56023],[],{"_3624":1735,"_31165":1734,"_21590":56249,"_5":14857,"_28357":1734,"_3076":56250},[],"Prepare a DMS, register a device and associate a verified certificate with its identity.",{"_3624":1736,"_31165":1734,"_5":31500,"_21590":56252,"_28357":56253,"_3076":50910},[],"/docs/platform/iot-fleets/quickstarts/register-device#before-you-begin",{"_3624":1737,"_31165":1734,"_5":31500,"_21590":56255,"_28357":56256,"_3076":56257},[],"/docs/platform/iot-fleets/quickstarts/register-device#prepare-the-dms","Prepare the DMS",{"_3624":1738,"_31165":1734,"_5":31500,"_21590":56259,"_28357":56260,"_3076":56261},[],"/docs/platform/iot-fleets/quickstarts/register-device#register-the-device","Register the device",{"_3624":1739,"_31165":1734,"_5":31500,"_21590":56263,"_28357":56264,"_3076":56265},[],"/docs/platform/iot-fleets/quickstarts/register-device#check-the-initial-status","Check the initial status",{"_3624":1740,"_31165":1734,"_5":31500,"_21590":56267,"_28357":56268,"_3076":56269},[],"/docs/platform/iot-fleets/quickstarts/register-device#assign-an-identity","Assign an identity",{"_3624":1741,"_31165":1734,"_5":31500,"_21590":56271,"_28357":56272,"_3076":56273},[],"/docs/platform/iot-fleets/quickstarts/register-device#verify-the-device","Verify the device",{"_3624":1742,"_31165":1734,"_5":31500,"_21590":56275,"_28357":56276,"_3076":56215},[],"/docs/platform/iot-fleets/quickstarts/register-device#expected-result",{"_3624":1743,"_31165":1734,"_5":31500,"_21590":56278,"_28357":56279,"_3076":56280},[],"/docs/platform/iot-fleets/quickstarts/register-device#if-the-result-fails","If the result fails",{"_3624":1744,"_31165":1734,"_5":31500,"_21590":56282,"_28357":56283,"_3076":56284},[],"/docs/platform/iot-fleets/quickstarts/register-device#automate-the-next-device","Automate the next device",{"_3624":1745,"_31165":1734,"_21590":56286,"_5":14857,"_28357":1734,"_3076":56287},[],"This path is intended for those starting to administer device identities. You will register `device-001` and assign an existing certificate to check the relationship between device, DMS and identity history.",{"_3624":1746,"_31165":1734,"_21590":56289,"_5":14857,"_28357":1734,"_3076":56290},[],"Assignment updates Lamassu's inventory. Install the key and certificate separately on the device; check the connection to a consumer in that destination's integration.",{"_3624":1747,"_31165":1734,"_21590":56292,"_5":14857,"_28357":56253,"_3076":56293},[],"An accessible instance and permission to administer DMSs, devices and certificate associations.",{"_3624":1748,"_31165":1734,"_21590":56295,"_5":14857,"_28357":56253,"_3076":56296},[],"An active CA with an available key. If one does not exist yet, follow Create your first CA.",{"_3624":1749,"_31165":1734,"_21590":56298,"_5":14857,"_28357":56253,"_3076":56299},[],"An active end-entity certificate from that CA whose `Common Name` is exactly `device-001`, together with its private key. Follow Issue and verify a certificate to obtain and check both.",{"_3624":1750,"_31165":1734,"_21590":56301,"_5":14857,"_28357":56253,"_3076":56302},[],"The identifier `device-001` available in the inventory. If you already used it, choose another and issue the certificate with that same `Common Name`.",{"_3624":1751,"_31165":1734,"_21590":56304,"_5":14857,"_28357":56256,"_3076":56305},[],"A DMS must exist before registering the device. If you already have a suitable one, check its CA and note its identifier; to create one:",{"_3624":1752,"_31165":1734,"_21590":56307,"_5":14857,"_28357":56256,"_3076":56308},[],"Open the DMS inventory and its creation action. Assign a recognizable name, such as `Acme Evaluation DMS`.",{"_3624":1753,"_31165":1734,"_21590":56310,"_5":14857,"_28357":56256,"_3076":56311},[],"In **Enrollment CA**, select the CA that issued `device.crt`.",{"_3624":1754,"_31165":1734,"_21590":56313,"_5":14857,"_28357":56256,"_3076":56314},[],"In **Registration Mode**, select `PRE_REGISTRATION` for the path that starts with explicit registration.",{"_3624":1755,"_31165":1734,"_21590":56316,"_5":14857,"_28357":56256,"_3076":56317},[],"In the authentication section, enable **Require client certificate** and leave **Call external webhook** off. Under **Require client certificate**, add the CA whose initial certificates you will accept to **Validation CAs**; for this evaluation, it can be the same CA. Keep **Verify CSR Signature** enabled and leave **Enable server-side key generation** off if you will not use it.",{"_3624":1756,"_31165":1734,"_21590":56319,"_5":14857,"_28357":56256,"_3076":56320},[],"Review renewal and trust distribution settings with the DMS guide, save the service and note its identifier.",{"_3624":1757,"_31165":1734,"_21590":56322,"_5":14857,"_28357":56256,"_3076":56323},[],"Reopen the DMS and confirm that the enrollment CA is the expected one and the service appears in inventory.",{"_3624":1758,"_31165":1734,"_21590":56325,"_5":14857,"_28357":56256,"_3076":56326},[],"These settings prepare DMS policy. The next steps register and assign through the console; they do not send an EST request or test admission through that protocol.",{"_3624":1759,"_31165":1734,"_21590":56328,"_5":14857,"_28357":56260,"_3076":56329},[],"Open **Managed Devices** and the registration action. Complete:",{"_3624":1760,"_31165":1734,"_21590":56331,"_5":14857,"_28357":56260,"_3076":56332},[],"**Device ID**: `device-001`.",{"_3624":1761,"_31165":1734,"_21590":56334,"_5":14857,"_28357":56260,"_3076":56335},[],"**Registration Authority**: the DMS you just prepared; this label identifies the service fulfilling the registration authority role.",{"_3624":1762,"_31165":1734,"_21590":56337,"_5":14857,"_28357":56260,"_3076":56338},[],"**Icon** and **Tags**: optional classification.",{"_3624":1763,"_31165":1734,"_21590":56340,"_5":14857,"_28357":56260,"_3076":56341},[],"Confirm registration.",{"_3624":1764,"_31165":1734,"_21590":56343,"_5":14857,"_28357":56264,"_3076":56344},[],"Open the device. It should appear in **No Identity** and show the selected owning DMS.",{"_3624":1765,"_31165":1734,"_21590":56346,"_5":14857,"_28357":56264,"_3076":56347},[],"Registration creates the inventory entry; the certificate must still be associated.",{"_3624":1766,"_31165":1734,"_21590":56349,"_5":14857,"_28357":56268,"_3076":56350},[],"Select **Assign Identity** and the existing certificate with `CN=device-001`. Check its serial number, issuer and validity against the certificate you verified in PKI.",{"_3624":1767,"_31165":1734,"_21590":56352,"_5":14857,"_28357":56268,"_3076":56353},[],"Confirm the association. The **Issue New Instead** alternative is explained in Devices and identities.",{"_3624":1768,"_31165":1734,"_21590":56355,"_5":14857,"_28357":56272,"_3076":56356},[],"Check that it has an active identity. In **Certificate History**, verify the associated serial number; in **Device Event Timeline**, find the assignment event.",{"_3624":1769,"_31165":1734,"_21590":56358,"_5":14857,"_28357":56272,"_3076":56359},[],"Keep the device identifier, owning DMS and serial number as references for the result.",{"_3624":1770,"_31165":1734,"_21590":56361,"_5":14857,"_28357":56276,"_3076":56212},[],{"_3624":1771,"_31165":1734,"_21590":56363,"_5":14857,"_28357":56276,"_3076":56364},[],"Result",{"_3624":1772,"_31165":1734,"_21590":56366,"_5":14857,"_28357":56276,"_3076":55462},[],{"_3624":1773,"_31165":1734,"_21590":56368,"_5":14857,"_28357":56276,"_3076":56369},[],"`device-001` appears in inventory with the expected DMS.",{"_3624":1774,"_31165":1734,"_21590":56371,"_5":14857,"_28357":56276,"_3076":56372},[],"Current identity",{"_3624":1775,"_31165":1734,"_21590":56374,"_5":14857,"_28357":56276,"_3076":56375},[],"The associated certificate matches the one you verified in PKI.",{"_3624":1776,"_31165":1734,"_21590":56377,"_5":14857,"_28357":56276,"_3076":56378},[],"History",{"_3624":1777,"_31165":1734,"_21590":56380,"_5":14857,"_28357":56276,"_3076":56381},[],"The associated issuance appears with its serial number and dates.",{"_3624":1778,"_31165":1734,"_21590":56383,"_5":14857,"_28357":56276,"_3076":56384},[],"Key and certificate",{"_3624":1779,"_31165":1734,"_21590":56386,"_5":14857,"_28357":56276,"_3076":56387},[],"You have the verified pair ready to install on the device.",{"_3624":1780,"_31165":1734,"_21590":56389,"_5":14857,"_28357":56279,"_3076":56390},[],"If you cannot select the DMS, confirm its creation and your read permissions.",{"_3624":1781,"_31165":1734,"_21590":56392,"_5":14857,"_28357":56279,"_3076":56393},[],"If no eligible certificate appears, check that its `Common Name` matches the `Device ID` exactly, it is active and it was issued by the expected CA.",{"_3624":1782,"_31165":1734,"_21590":56395,"_5":14857,"_28357":56279,"_3076":56396},[],"If assignment fails, review permissions and operation diagnostics before repeating it. Query the device and its history again to find the persisted result.",{"_3624":1783,"_31165":1734,"_21590":56398,"_5":14857,"_28357":56279,"_3076":56399},[],"If an expiration or renewal state appears, check certificate dates and DMS thresholds in Devices and identities.",{"_3624":1784,"_31165":1734,"_21590":56401,"_5":14857,"_28357":56283,"_3076":56402},[],"Continue with DMS and EST for the device to request and renew certificates. Prepare server trust, the initial credential and policies for each operation before implementing the client.",{"_3624":1785,"_31165":1734,"_21590":56404,"_5":14857,"_28357":56283,"_3076":56405},[],"For a path from the client through mTLS, follow Enroll and connect your first device with a new ID.",{"_3624":1786,"_31165":1734,"_21590":56407,"_5":14857,"_28357":56283,"_3076":56408},[],"To use the identity in AWS IoT Core, also prepare trust and permissions in the destination. Check the connection from the device after installing the required key, certificate and chain.",{"_3624":1787,"_31165":1787,"_5":15217,"_3076":56410,"_31503":56411,"_21590":56412,"_28357":1787},"Lamassu IoT Platform",[50900,52412],[],{"_3624":1788,"_31165":1787,"_21590":56414,"_5":14857,"_28357":1787,"_3076":56415},[],"Build a PKI and apply its certificates to your devices' lifecycle.",{"_3624":1789,"_31165":1787,"_5":31500,"_21590":56417,"_28357":56418,"_3076":55898},[],"/docs/platform/overview#start-here",{"_3624":1790,"_31165":1787,"_5":31500,"_21590":56420,"_28357":56421,"_3076":56422},[],"/docs/platform/overview#choose-your-path","Choose your path",{"_3624":1791,"_31165":1787,"_5":31500,"_21590":56424,"_28357":56425,"_3076":56426},[],"/docs/platform/overview#architecture-at-a-glance","Architecture at a glance",{"_3624":1792,"_31165":1787,"_5":31500,"_21590":56428,"_28357":56429,"_3076":56430},[],"/docs/platform/overview#core-capabilities","Core capabilities",{"_3624":1793,"_31165":1787,"_5":31500,"_21590":56432,"_28357":56433,"_3076":56434},[],"/docs/platform/overview#build-your-trust-hierarchy","Build your trust hierarchy",{"_3624":1794,"_31165":1787,"_5":31500,"_21590":56436,"_28357":56437,"_3076":56438},[],"/docs/platform/overview#protect-cryptographic-keys","Protect cryptographic keys",{"_3624":1795,"_31165":1787,"_5":31500,"_21590":56440,"_28357":56441,"_3076":56442},[],"/docs/platform/overview#issue-and-control-certificates","Issue and control certificates",{"_3624":1796,"_31165":1787,"_5":31500,"_21590":56444,"_28357":56445,"_3076":56446},[],"/docs/platform/overview#automate-device-identities","Automate device identities",{"_3624":1797,"_31165":1787,"_5":31500,"_21590":56448,"_28357":56449,"_3076":56450},[],"/docs/platform/overview#publish-validation-status","Publish validation status",{"_3624":1798,"_31165":1787,"_5":31500,"_21590":56452,"_28357":56453,"_3076":56454},[],"/docs/platform/overview#react-to-events","React to events",{"_3624":1799,"_31165":1787,"_5":31500,"_21590":56456,"_28357":56457,"_3076":56458},[],"/docs/platform/overview#operational-reference","Operational reference",{"_3624":1800,"_31165":1787,"_21590":56460,"_5":14857,"_28357":1787,"_3076":56461},[],"Lamassu IoT lets you administer a private PKI and use it to issue, renew and revoke X.509 device identities. The Platform documentation follows two paths: **PKI**, for authorities and certificates, and **IoT Fleets**, for applying those identities to a device population.",{"_3624":1801,"_31165":1787,"_21590":56463,"_5":14857,"_28357":56418,"_3076":56464},[],"Choose the result you need:",{"_3624":1802,"_31165":1787,"_21590":56466,"_5":14857,"_28357":56418,"_3076":56467},[],"<Card title=\"Issue and verify a certificate\" description=\"Prepare a CA, issue an X.509 identity and check its chain and key.\" href=\"/docs/platform/pki/quickstarts/overview\" />",{"_3624":1803,"_31165":1787,"_21590":56469,"_5":14857,"_28357":56418,"_3076":56470},[],"<Card title=\"Enroll and connect a device\" description=\"Prepare the DMS, request an identity through EST and check an mTLS connection.\" href=\"/docs/platform/iot-fleets/quickstarts/enroll-device\" />",{"_3624":1804,"_31165":1787,"_21590":56472,"_5":14857,"_28357":56418,"_3076":56473},[],"If you are still preparing the instance, start in Deployment. The Platform paths assume an accessible console and permission to perform the operations.",{"_3624":1805,"_31165":1787,"_21590":56475,"_5":14857,"_28357":56421,"_3076":56476},[],"Section",{"_3624":1806,"_31165":1787,"_21590":56478,"_5":14857,"_28357":56421,"_3076":56479},[],"What you manage",{"_3624":1807,"_31165":1787,"_21590":56481,"_5":14857,"_28357":56421,"_3076":56482},[],"Entry point",{"_3624":1808,"_31165":1787,"_21590":56484,"_5":14857,"_28357":56421,"_3076":56485},[],"**PKI**",{"_3624":1809,"_31165":1787,"_21590":56487,"_5":14857,"_28357":56421,"_3076":56488},[],"Keys, authorities, profiles, certificates and publication of revocation status.",{"_3624":1810,"_31165":1787,"_21590":56490,"_5":14857,"_28357":56421,"_3076":56491},[],"PKI overview",{"_3624":1811,"_31165":1787,"_21590":56493,"_5":14857,"_28357":56421,"_3076":56494},[],"**IoT Fleets**",{"_3624":1812,"_31165":1787,"_21590":56496,"_5":14857,"_28357":56421,"_3076":56497},[],"Devices, identity history, DMS policies, EST enrollment and integrations.",{"_3624":1813,"_31165":1787,"_21590":56499,"_5":14857,"_28357":56421,"_3076":56500},[],"IoT Fleets overview",{"_3624":1814,"_31165":1787,"_21590":56502,"_5":14857,"_28357":56421,"_3076":56503},[],"**Administration**",{"_3624":1815,"_31165":1787,"_21590":56505,"_5":14857,"_28357":56421,"_3076":56506},[],"Operator permissions, audit and event subscriptions.",{"_3624":1816,"_31165":1787,"_21590":56508,"_5":14857,"_28357":56421,"_3076":52414},[],{"_3624":1817,"_31165":1787,"_21590":56510,"_5":14857,"_28357":56421,"_3076":56511},[],"A CA determines who signs, and a profile defines what can be issued. The DMS applies admission and enrollment policy. The device retains its association with certificates, and the external consumer decides which identity it accepts.",{"_3624":1818,"_31165":1787,"_21590":56513,"_5":14857,"_28357":56425,"_3076":56514},[],"An identity's journey connects four responsibilities:",{"_3624":1819,"_31165":1787,"_21590":56516,"_5":14857,"_28357":56425,"_3076":56517},[],"The PKI administrator prepares the authority, its key and issuance rules.",{"_3624":1820,"_31165":1787,"_21590":56519,"_5":14857,"_28357":56425,"_3076":56520},[],"The provisioning administrator configures the DMS and initial trust.",{"_3624":1821,"_31165":1787,"_21590":56522,"_5":14857,"_28357":56425,"_3076":56523},[],"The device client requests a certificate and installs it with the matching key.",{"_3624":1822,"_31165":1787,"_21590":56525,"_5":14857,"_28357":56425,"_3076":56526},[],"The consumer validates the identity and applies its access permissions.",{"_3624":1823,"_31165":1787,"_21590":56528,"_5":14857,"_28357":56425,"_3076":56529},[],"See How Lamassu works to understand the resources and platform architecture for the services. Installation, network exposure and dependencies are explained in Deployment.",{"_3624":1824,"_31165":1787,"_21590":56531,"_5":14857,"_28357":56433,"_3076":56532},[],"Create or incorporate authorities and organize their relationships in PKI. The hierarchy and its rotation determine which chains consumers must recognize.",{"_3624":1825,"_31165":1787,"_21590":56534,"_5":14857,"_28357":56437,"_3076":56535},[],"Choose the engine that keeps authority keys and control who can use them. See Keys and engines; provider setup belongs to deployment.",{"_3624":1826,"_31165":1787,"_21590":56537,"_5":14857,"_28357":56441,"_3076":56538},[],"Define issuance profiles, sign requests and review the certificate inventory. Check the issued certificate from the client that will use it.",{"_3624":1827,"_31165":1787,"_21590":56540,"_5":14857,"_28357":56445,"_3076":56541},[],"Configure a DMS and use EST to request and renew certificates. Preparing the initial credential and installing the result belong to device integration.",{"_3624":1828,"_31165":1787,"_21590":56543,"_5":14857,"_28357":56449,"_3076":56544},[],"Use OCSP and CRL to publish revocation status. Each consumer must configure how it retrieves and applies that information.",{"_3624":1829,"_31165":1787,"_21590":56546,"_5":14857,"_28357":56453,"_3076":56547},[],"Use audit logs to investigate changes and configure alerts and subscriptions to react to lifecycle events.",{"_3624":1830,"_31165":1787,"_21590":56549,"_5":14857,"_28357":56457,"_3076":55992},[],{"_3624":1831,"_31165":1787,"_21590":56551,"_5":14857,"_28357":56457,"_3076":56552},[],"What it prepares or checks",{"_3624":1832,"_31165":1787,"_21590":56554,"_5":14857,"_28357":56457,"_3076":55995},[],{"_3624":1833,"_31165":1787,"_21590":56556,"_5":14857,"_28357":56457,"_3076":56557},[],"Key custody, CA hierarchy, profiles and validation.",{"_3624":1834,"_31165":1787,"_21590":56559,"_5":14857,"_28357":56457,"_3076":56560},[],"Fleet administrator",{"_3624":1835,"_31165":1787,"_21590":56562,"_5":14857,"_28357":56457,"_3076":56563},[],"DMS, device admission, renewal policy and inventory.",{"_3624":1836,"_31165":1787,"_21590":56565,"_5":14857,"_28357":56457,"_3076":56007},[],{"_3624":1837,"_31165":1787,"_21590":56567,"_5":14857,"_28357":56457,"_3076":56568},[],"Initial credential, server trust, EST client, and key and certificate storage.",{"_3624":1838,"_31165":1787,"_21590":56570,"_5":14857,"_28357":56457,"_3076":56013},[],{"_3624":1839,"_31165":1787,"_21590":56572,"_5":14857,"_28357":56457,"_3076":56573},[],"Issuer trust, certificate validation and permissions in the destination.",{"_3624":1840,"_31165":1787,"_21590":56575,"_5":14857,"_28357":56457,"_3076":56576},[],"Infrastructure operator",{"_3624":1841,"_31165":1787,"_21590":56578,"_5":14857,"_28357":56457,"_3076":56579},[],"Installation, network, availability, dependencies and deployment diagnosis.",{"_3624":1842,"_31165":1787,"_21590":56581,"_5":14857,"_28357":56457,"_3076":56582},[],"The API reference contains contracts for automating operations. To investigate a failure, start in the affected section: PKI, EST or Deployment.",{"_3624":1843,"_31165":1843,"_5":15217,"_3076":56584,"_31503":56585,"_21590":56588,"_28357":1843},"CA hierarchy and rotation",[50900,52412,56586,56587],"PKI","Keys, authorities and certificates",[],{"_3624":1844,"_31165":1843,"_21590":56590,"_5":14857,"_28357":1843,"_3076":56591},[],"Design root and intermediate authorities and replace certificates or keys without breaking trust.",{"_3624":1845,"_31165":1843,"_5":31500,"_21590":56593,"_28357":56594,"_3076":56595},[],"/docs/platform/pki/ca-hierarchy-and-rotation#design-the-hierarchy","Design the hierarchy",{"_3624":1846,"_31165":1843,"_5":31500,"_21590":56597,"_28357":56598,"_3076":56599},[],"/docs/platform/pki/ca-hierarchy-and-rotation#reissuance-and-rotation-are-not-the-same","Reissuance and rotation are not the same",{"_3624":1847,"_31165":1843,"_5":31500,"_21590":56601,"_28357":56602,"_3076":56603},[],"/docs/platform/pki/ca-hierarchy-and-rotation#when-to-choose-each-operation","When to choose each operation",{"_3624":1848,"_31165":1843,"_5":31500,"_21590":56605,"_28357":56606,"_3076":56607},[],"/docs/platform/pki/ca-hierarchy-and-rotation#key-rotation-procedure","Key rotation procedure",{"_3624":1849,"_31165":1843,"_5":31500,"_21590":56609,"_28357":56610,"_3076":56611},[],"/docs/platform/pki/ca-hierarchy-and-rotation#inventory-the-dependencies","Inventory the dependencies",{"_3624":1850,"_31165":1843,"_5":31500,"_21590":56613,"_28357":56614,"_3076":56615},[],"/docs/platform/pki/ca-hierarchy-and-rotation#create-the-successor-ca","Create the successor CA",{"_3624":1851,"_31165":1843,"_5":31500,"_21590":56617,"_28357":56618,"_3076":56619},[],"/docs/platform/pki/ca-hierarchy-and-rotation#distribute-the-new-trust","Distribute the new trust",{"_3624":1852,"_31165":1843,"_5":31500,"_21590":56621,"_28357":56622,"_3076":56623},[],"/docs/platform/pki/ca-hierarchy-and-rotation#switch-issuance","Switch issuance",{"_3624":1853,"_31165":1843,"_5":31500,"_21590":56625,"_28357":56626,"_3076":56627},[],"/docs/platform/pki/ca-hierarchy-and-rotation#renew-in-batches","Renew in batches",{"_3624":1854,"_31165":1843,"_5":31500,"_21590":56629,"_28357":56630,"_3076":56631},[],"/docs/platform/pki/ca-hierarchy-and-rotation#close-the-overlap","Close the overlap",{"_3624":1855,"_31165":1843,"_5":31500,"_21590":56633,"_28357":56634,"_3076":56635},[],"/docs/platform/pki/ca-hierarchy-and-rotation#cascading-revocation","Cascading revocation",{"_3624":1856,"_31165":1843,"_5":31500,"_21590":56637,"_28357":56638,"_3076":56639},[],"/docs/platform/pki/ca-hierarchy-and-rotation#checks-after-the-change","Checks after the change",{"_3624":1857,"_31165":1843,"_21590":56641,"_5":14857,"_28357":1843,"_3076":56642},[],"The hierarchy determines the blast radius of any error or compromise. A root signs intermediate CAs; intermediates issue the identities used by devices and services. This separation lets you isolate environments and rotate a branch without replacing all trust.",{"_3624":1858,"_31165":1843,"_21590":56644,"_5":14857,"_28357":1843,"_3076":56645},[],"This procedure is for the PKI operator replacing an authority in use. You need access to CAs, keys and profiles, a dependency inventory and coordination with trust-store and device owners. Before switching issuance, prepare a test cohort and decide the criterion for ending overlap.",{"_3624":1859,"_31165":1843,"_21590":56647,"_5":14857,"_28357":56594,"_3076":56648},[],"For a production installation, use a very restricted root and one or more operational intermediates. Separate intermediates when any of these boundaries change:",{"_3624":1860,"_31165":1843,"_21590":56650,"_5":14857,"_28357":56594,"_3076":56651},[],"environment, such as production and preproduction;",{"_3624":1861,"_31165":1843,"_21590":56653,"_5":14857,"_28357":56594,"_3076":56654},[],"owner or operating team;",{"_3624":1862,"_31165":1843,"_21590":56656,"_5":14857,"_28357":56594,"_3076":56657},[],"device family or manufacturing process;",{"_3624":1863,"_31165":1843,"_21590":56659,"_5":14857,"_28357":56594,"_3076":56660},[],"region or regulatory requirement;",{"_3624":1864,"_31165":1843,"_21590":56662,"_5":14857,"_28357":56594,"_3076":56663},[],"cryptographic engine or key policy;",{"_3624":1865,"_31165":1843,"_21590":56665,"_5":14857,"_28357":56594,"_3076":56666},[],"maintenance window and renewal cadence.",{"_3624":1866,"_31165":1843,"_21590":56668,"_5":14857,"_28357":56594,"_3076":56669},[],"Avoid deep hierarchies without a concrete need. Each level adds chain distribution, validation and one more certificate you must renew.",{"_3624":1867,"_31165":1843,"_21590":56671,"_5":14857,"_28357":56594,"_3076":56672},[],"A child CA and its end-entity certificates must expire before their issuer. Reserve a margin that allows distributing another chain and renewing dependent certificates.",{"_3624":1868,"_31165":1843,"_21590":56674,"_5":14857,"_28357":56598,"_3076":56675},[],"**Reissuing a CA** creates a new certificate over the existing key. Lamassu generates a CSR with that key, self-signs it if it is a root or asks the parent CA to sign it if it is subordinate. The new certificate becomes active and the CA points to its serial number; the old and new certificates are linked through metadata.",{"_3624":1869,"_31165":1843,"_21590":56677,"_5":14857,"_28357":56598,"_3076":56678},[],"If the CRL settings of the CA are signed by the superseded CA certificate, reissuing moves the signer to the new certificate — provided it carries `cRLSign` — and republishes the CRL. Otherwise, and for settings signed by a different certificate, the signer is kept, so check the new certificate’s key usage after reissuing. A CA with no CRL settings — for example, one imported without its key or without `cRLSign` — has them initialized by the reissue when the new certificate carries `cRLSign`; otherwise it keeps none. See the CRL guide.",{"_3624":1870,"_31165":1843,"_21590":56680,"_5":14857,"_28357":56598,"_3076":56681},[],"**Rotating a CA** creates a successor key and authority. It is the right choice in the face of compromise, a cryptographic change, an engine migration or non-exportable key policies.",{"_3624":1871,"_31165":1843,"_21590":56683,"_5":14857,"_28357":56598,"_3076":56684},[],"Lamassu does not allow reissuing an already-revoked CA or a CA whose expiration date has passed. A subordinate CA is signed by its parent, so the parent must also be `ACTIVE` and inside its validity period; otherwise the reissue fails with `400`. Plan ahead for these conditions.",{"_3624":1872,"_31165":1843,"_21590":56686,"_5":14857,"_28357":56602,"_3076":56687},[],"Reissue if the key is still trustworthy and you only need another validity period or an updated certificate.",{"_3624":1873,"_31165":1843,"_21590":56689,"_5":14857,"_28357":56602,"_3076":56690},[],"Rotate the key if compromise is suspected, the algorithm changes or you want to move custody to another engine.",{"_3624":1874,"_31165":1843,"_21590":56692,"_5":14857,"_28357":56602,"_3076":56693},[],"Create a parallel branch if you cannot update all consumers at the same time.",{"_3624":1875,"_31165":1843,"_21590":56695,"_5":14857,"_28357":56602,"_3076":56696},[],"Revoke immediately only when the risk of keeping the CA outweighs the impact of interrupting the fleet.",{"_3624":1876,"_31165":1843,"_21590":56698,"_5":14857,"_28357":56610,"_3076":56699},[],"Locate child CAs, issued certificates, DMSs, connectors and external trust stores. Include devices that may stay offline for weeks or months.",{"_3624":1877,"_31165":1843,"_21590":56701,"_5":14857,"_28357":56614,"_3076":56702},[],"Generate a new key in the planned engine, create the CA and assign it an explicit profile. Do not reuse the operational identifier to hide that it is a different generation.",{"_3624":1878,"_31165":1843,"_21590":56704,"_5":14857,"_28357":56618,"_3076":56705},[],"Add the new root or chain to consumers before issuing with it. If distributing through EST `/cacerts`, explicitly include the required managed CAs and inspect the content; including the issuer does not automatically include every intermediate. Install the new trust in a cohort and verify that it still accepts the previous identity.",{"_3624":1879,"_31165":1843,"_21590":56707,"_5":14857,"_28357":56622,"_3076":56708},[],"Update the enrollment CA and profile of the DMSs. While old-CA cohorts still renew, add the previous enrollment CA to each DMS's re-enrollment validation CAs (`reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`): the new enrollment CA is trusted automatically, but the old one was the enrollment CA and appears in no re-enrollment trust list, so without that entry its certificates can no longer renew. The DMS guide documents the setting.",{"_3624":1880,"_31165":1843,"_21590":56710,"_5":14857,"_28357":56626,"_3076":56711},[],"Migrate a small cohort, validate mTLS, OCSP and CRL from the consumer and expand progressively. Monitor which devices still present the old chain.",{"_3624":1881,"_31165":1843,"_21590":56713,"_5":14857,"_28357":56630,"_3076":56714},[],"Once no legitimate consumer depends on the previous authority, remove it from issuance, from the re-enrollment validation CAs and from the distributed CAs. Revoke it if policy requires it.",{"_3624":1882,"_31165":1843,"_21590":56716,"_5":14857,"_28357":56634,"_3076":56717},[],"Lamassu saves the CA’s revocation, then applies the same revocation to child CAs and issued certificates. Propagation continues recursively through child CAs. This is not a transaction over the whole hierarchy: some resources may have changed while other updates failed.",{"_3624":1883,"_31165":1843,"_21590":56719,"_5":14857,"_28357":56634,"_3076":56720},[],"Resources in `EXPIRED` state and resources already revoked for a final reason reject further status transitions. Per-descendant failures are logged; review the inventory and logs even when the parent operation completes.",{"_3624":1884,"_31165":1843,"_21590":56722,"_5":14857,"_28357":56634,"_3076":56723},[],"`CertificateHold` is the reversible exception. Holding a CA suspends its active sub-CAs and issued certificates with `CertificateHold` and marks them as suspended by that CA. Releasing the CA — to `ACTIVE` or to any other non-revoked status such as `EXPIRED` — reactivates exactly the descendants still on hold that carry that mark. Holds placed manually before or after the cascade are left untouched, and any later status change of a descendant clears the mark. Revoking a held CA with any other reason remains permanent: descendants are revoked with `CessationOfOperation` and cannot be restored.",{"_3624":1885,"_31165":1843,"_21590":56725,"_5":14857,"_28357":56634,"_3076":56726},[],"Before closing the change, compare the original dependency inventory with final states and verify revocation publication for each issuer. Do not use revocation as the ordinary mechanism to stop issuance: complete migration and remove the CA from operational flows.",{"_3624":1886,"_31165":1843,"_21590":56728,"_5":14857,"_28357":56638,"_3076":56729},[],"The new chain ends in an anchor installed by the consumer.",{"_3624":1887,"_31165":1843,"_21590":56731,"_5":14857,"_28357":56638,"_3076":56732},[],"New certificates contain the expected AKI, SKI, KU, EKU and SAN.",{"_3624":1888,"_31165":1843,"_21590":56734,"_5":14857,"_28357":56638,"_3076":56735},[],"The DMS delivers the correct chain through EST `/cacerts`.",{"_3624":1889,"_31165":1843,"_21590":56737,"_5":14857,"_28357":56638,"_3076":56738},[],"Re-enrollment accepts the old identity during the planned period.",{"_3624":1890,"_31165":1843,"_21590":56740,"_5":14857,"_28357":56638,"_3076":56741},[],"OCSP and CRL respond for the authorities that remain active.",{"_3624":1891,"_31165":1843,"_21590":56743,"_5":14857,"_28357":56638,"_3076":56744},[],"No DMS is left accidentally issuing from the old CA.",{"_3624":1892,"_31165":1843,"_21590":56746,"_5":14857,"_28357":56638,"_3076":56747},[],"See the Trust model to understand the DMS's CA sets and Certificate lifecycle for states and revocation effects.",{"_3624":1893,"_31165":1893,"_5":15217,"_3076":56749,"_31503":56750,"_21590":56751,"_28357":1893},"Certification authorities",[50900,52412,56586,56587],[],{"_3624":1894,"_31165":1893,"_21590":56753,"_5":14857,"_28357":1893,"_3076":56754},[],"Create, import and operate the authorities that establish your PKI's trust.",{"_3624":1895,"_31165":1893,"_5":31500,"_21590":56756,"_28357":56757,"_3076":56758},[],"/docs/platform/pki/certificate-authorities#choose-a-flow","Choose a flow",{"_3624":1896,"_31165":1893,"_5":31500,"_21590":56760,"_28357":56761,"_3076":56762},[],"/docs/platform/pki/certificate-authorities#create-a-new-authority","Create a new authority",{"_3624":1897,"_31165":1893,"_5":31500,"_21590":56764,"_28357":56765,"_3076":50910},[],"/docs/platform/pki/certificate-authorities#before-you-begin",{"_3624":1898,"_31165":1893,"_5":31500,"_21590":56767,"_28357":56768,"_3076":56769},[],"/docs/platform/pki/certificate-authorities#open-the-wizard","Open the wizard",{"_3624":1899,"_31165":1893,"_5":31500,"_21590":56771,"_28357":56772,"_3076":56773},[],"/docs/platform/pki/certificate-authorities#configure-the-key","Configure the key",{"_3624":1900,"_31165":1893,"_5":31500,"_21590":56775,"_28357":56776,"_3076":56777},[],"/docs/platform/pki/certificate-authorities#choose-the-ca-type","Choose the CA type",{"_3624":1901,"_31165":1893,"_5":31500,"_21590":56779,"_28357":56780,"_3076":56781},[],"/docs/platform/pki/certificate-authorities#define-the-identity","Define the identity",{"_3624":1902,"_31165":1893,"_5":31500,"_21590":56783,"_28357":56784,"_3076":56785},[],"/docs/platform/pki/certificate-authorities#configure-validity-and-uses","Configure validity and uses",{"_3624":1903,"_31165":1893,"_5":31500,"_21590":56787,"_28357":56788,"_3076":56789},[],"/docs/platform/pki/certificate-authorities#create-and-verify","Create and verify",{"_3624":1904,"_31165":1893,"_5":31500,"_21590":56791,"_28357":56792,"_3076":56793},[],"/docs/platform/pki/certificate-authorities#use-a-key-from-the-kms","Use a key from the KMS",{"_3624":1905,"_31165":1893,"_5":31500,"_21590":56795,"_28357":56796,"_3076":56797},[],"/docs/platform/pki/certificate-authorities#import-an-external-ca","Import an external CA",{"_3624":1906,"_31165":1893,"_5":31500,"_21590":56799,"_28357":56800,"_3076":56801},[],"/docs/platform/pki/certificate-authorities#select-the-engine","Select the engine",{"_3624":1907,"_31165":1893,"_5":31500,"_21590":56803,"_28357":56804,"_3076":56805},[],"/docs/platform/pki/certificate-authorities#load-the-material","Load the material",{"_3624":1908,"_31165":1893,"_5":31500,"_21590":56807,"_28357":56808,"_3076":56809},[],"/docs/platform/pki/certificate-authorities#define-the-default-issuance","Define the default issuance",{"_3624":1909,"_31165":1893,"_5":31500,"_21590":56811,"_28357":56812,"_3076":56813},[],"/docs/platform/pki/certificate-authorities#verify-the-import","Verify the import",{"_3624":1910,"_31165":1893,"_5":31500,"_21590":56815,"_28357":56816,"_3076":56817},[],"/docs/platform/pki/certificate-authorities#inspect-an-authority","Inspect an authority",{"_3624":1911,"_31165":1893,"_5":31500,"_21590":56819,"_28357":56820,"_3076":56821},[],"/docs/platform/pki/certificate-authorities#issue-certificates","Issue certificates",{"_3624":1912,"_31165":1893,"_5":31500,"_21590":56823,"_28357":56824,"_3076":56825},[],"/docs/platform/pki/certificate-authorities#revoke-a-ca","Revoke a CA",{"_3624":1913,"_31165":1893,"_5":31500,"_21590":56827,"_28357":56828,"_3076":56829},[],"/docs/platform/pki/certificate-authorities#assess-the-impact","Assess the impact",{"_3624":1914,"_31165":1893,"_5":31500,"_21590":56831,"_28357":56832,"_3076":56833},[],"/docs/platform/pki/certificate-authorities#start-the-revocation","Start the revocation",{"_3624":1915,"_31165":1893,"_5":31500,"_21590":56835,"_28357":56836,"_3076":56837},[],"/docs/platform/pki/certificate-authorities#confirm-the-identity","Confirm the identity",{"_3624":1916,"_31165":1893,"_5":31500,"_21590":56839,"_28357":56840,"_3076":56841},[],"/docs/platform/pki/certificate-authorities#check-the-publication","Check the publication",{"_3624":1917,"_31165":1893,"_5":31500,"_21590":56843,"_28357":56844,"_3076":56845},[],"/docs/platform/pki/certificate-authorities#delete-a-ca","Delete a CA",{"_3624":1918,"_31165":1893,"_21590":56847,"_5":14857,"_28357":1893,"_3076":56848},[],"A certification authority (CA) binds identities to public keys through signed certificates. In Lamassu you can create a new hierarchy, use a key already in the KMS or incorporate an external CA.",{"_3624":1919,"_31165":1893,"_21590":56850,"_5":14857,"_28357":1893,"_3076":56851},[],"To design a full chain or replace an authority in production, see CA hierarchy and rotation. If you need to standardize what each authority can sign, use Certificate profiles.",{"_3624":1920,"_31165":1893,"_21590":56853,"_5":14857,"_28357":1893,"_3076":56854},[],"To administer CAs, you need authority and key permissions, a reachable engine and a reviewed profile. An external consumer does not trust a CA merely because it appears in this inventory: agree root and chain distribution separately.",{"_3624":1921,"_31165":1893,"_21590":56856,"_5":14857,"_28357":56757,"_3076":56857},[],"**New CA with a new key:** create a root of trust from scratch. Lamassu generates and keeps the key pair.",{"_3624":1922,"_31165":1893,"_21590":56859,"_5":14857,"_28357":56757,"_3076":56860},[],"**New CA from the KMS:** reuse a key already registered in the platform.",{"_3624":1923,"_31165":1893,"_21590":56862,"_5":14857,"_28357":56757,"_3076":56863},[],"**Import a CA with its private key:** incorporate an external authority that Lamassu can issue with.",{"_3624":1924,"_31165":1893,"_21590":56865,"_5":14857,"_28357":56757,"_3076":56866},[],"**Import only the certificate:** register public material. If Lamassu finds its key in the KMS, it can associate it; otherwise, the CA has no usable key for issuance.",{"_3624":1925,"_31165":1893,"_21590":56868,"_5":14857,"_28357":56757,"_3076":56869},[],"First time here? Follow Create your first CA to complete the minimal journey.",{"_3624":1926,"_31165":1893,"_21590":56871,"_5":14857,"_28357":56765,"_3076":56872},[],"Decide whether the CA will be a root or an intermediate.",{"_3624":1927,"_31165":1893,"_21590":56874,"_5":14857,"_28357":56765,"_3076":56875},[],"Choose the engine that will keep the key.",{"_3624":1928,"_31165":1893,"_21590":56877,"_5":14857,"_28357":56765,"_3076":56878},[],"Define a validity longer than that of the certificates it will issue.",{"_3624":1929,"_31165":1893,"_21590":56880,"_5":14857,"_28357":56765,"_3076":56881},[],"For an intermediate CA, make sure the parent CA is active.",{"_3624":1930,"_31165":1893,"_21590":56883,"_5":14857,"_28357":56768,"_3076":56884},[],"In **Certification Authorities**, select **Create New CA** and choose to generate a new key pair.",{"_3624":1931,"_31165":1893,"_21590":56886,"_5":14857,"_28357":56772,"_3076":56887},[],"Select the cryptographic engine, the algorithm and the size or curve. Lamassu supports RSA and EC keys according to the engine's capabilities.",{"_3624":1932,"_31165":1893,"_21590":56889,"_5":14857,"_28357":56772,"_3076":56890},[],"Use only sizes and curves supported by the engine and the profile’s cryptographic policy. Read Keys and engines before reusing external material.",{"_3624":1933,"_31165":1893,"_21590":56892,"_5":14857,"_28357":56776,"_3076":56893},[],"Select **Root CA** for a self-signed authority or **Intermediate CA** for an authority signed by another CA. In the latter case, choose the issuing CA.",{"_3624":1934,"_31165":1893,"_21590":56895,"_5":14857,"_28357":56780,"_3076":56896},[],"Enter a unique **CA Name**. This name becomes the certificate's `Common Name`. Complete the Distinguished Name fields your policy requires:",{"_3624":1935,"_31165":1893,"_21590":56898,"_5":14857,"_28357":56780,"_3076":56899},[],"`C`: two-letter ISO 3166-1 country code.",{"_3624":1936,"_31165":1893,"_21590":56901,"_5":14857,"_28357":56780,"_3076":56902},[],"`ST`: state or province.",{"_3624":1937,"_31165":1893,"_21590":56904,"_5":14857,"_28357":56780,"_3076":56905},[],"`L`: locality.",{"_3624":1938,"_31165":1893,"_21590":56907,"_5":14857,"_28357":56780,"_3076":56908},[],"`O`: organization.",{"_3624":1939,"_31165":1893,"_21590":56910,"_5":14857,"_28357":56780,"_3076":56911},[],"`OU`: organizational unit.",{"_3624":1940,"_31165":1893,"_21590":56913,"_5":14857,"_28357":56780,"_3076":56914},[],"The CA's internal identifier is generated automatically and cannot be changed.",{"_3624":1941,"_31165":1893,"_21590":56916,"_5":14857,"_28357":56784,"_3076":56917},[],"Define **CA Certificate Expiration** and **Default End-Entity Certificate Issuance Expiration**. You can express a duration (`5y 8w 4d`), pick a date or use the maximum allowed date.",{"_3624":1942,"_31165":1893,"_21590":56919,"_5":14857,"_28357":56784,"_3076":56920},[],"Review the CA’s own certificate separately from the default profile for certificates it will issue later. Choose an explicit issuance policy; do not assume the form’s initial values suit your consumers.",{"_3624":1943,"_31165":1893,"_21590":56922,"_5":14857,"_28357":56788,"_3076":56923},[],"Confirm the form and open the CA. Check status, issuer, dates, associated engine and key. Download the certificate: it should contain `CA:TRUE` and a usage permitting certificate signing. Verify the self-signature for a root or the chain to your root for an intermediate. Complete a test issuance to check that the key can actually sign.",{"_3624":1944,"_31165":1893,"_21590":56925,"_5":14857,"_28357":56788,"_3076":56926},[],"Plan and verify expiration using the Profiles rules. Issuance does not automatically clamp validity to the issuer’s expiration; leave time to replace the authority and renew identities.",{"_3624":1945,"_31165":1893,"_21590":56928,"_5":14857,"_28357":56792,"_3076":56929},[],"Select &#x2A;*Create New CA (Existing Key)** when the key is already registered in Lamassu. The wizard first asks for the backing key and then shows the same configuration of type, identity, validity and profile.",{"_3624":1946,"_31165":1893,"_21590":56931,"_5":14857,"_28357":56792,"_3076":56932},[],"This flow is useful when the key was previously created in an HSM, imported through BYOK or must be reused under a specific custody policy.",{"_3624":1947,"_31165":1893,"_21590":56934,"_5":14857,"_28357":56796,"_3076":56935},[],"You need the CA certificate in PEM, its chain to a known root and, when importing it, an exportable private key. Before uploading material, verify signature, dates, `CA:TRUE`, signing usages (including `cRLSign`, without which the CA cannot publish its CRL) and public-key correspondence. The key verification procedure also compares a CA key and certificate.",{"_3624":1948,"_31165":1893,"_21590":56937,"_5":14857,"_28357":56796,"_3076":56938},[],"The backend rejects an import whose certificate lacks the CA basic constraint (`basicConstraints cA flag is not set`), whose serial number matches a stored certificate with different contents, or whose identical certificate already belongs to an existing CA. A deleted CA's certificate record is kept and can be reused when re-importing the same certificate, including its previous status. Re-importing a different certificate with that serial number is rejected; check the certificate and status after re-importing.",{"_3624":1949,"_31165":1893,"_21590":56940,"_5":14857,"_28357":56796,"_3076":56941},[],"Deleting a CA releases the key references of its own current certificate and linked reissued certificates, while keeping those records for its issuer's CRL and OCSP. It then attempts to delete the key; the KMS keeps it if other certificates still reference it, such as another CA sharing the key. Revoking certificates issued by the deleted CA does not release their own key references.",{"_3624":1950,"_31165":1893,"_21590":56943,"_5":14857,"_28357":56800,"_3076":56944},[],"Check the installation’s default engine before importing a CA with a key. CA import delegates key import to that engine; it does not guarantee arbitrary provider selection from the form. To select an engine while importing the key separately, use the KMS.",{"_3624":1951,"_31165":1893,"_21590":56946,"_5":14857,"_28357":56804,"_3076":56947},[],"Import the certificate and, when applicable, its PEM key. Register the CAs needed to identify the issuer. Registering a CA does not install it in external trust stores.",{"_3624":1952,"_31165":1893,"_21590":56949,"_5":14857,"_28357":56804,"_3076":56950},[],"The backend validates before importing any key: a duplicate CA ID and a certificate that is not a CA (missing `basicConstraints` `cA=TRUE`) are rejected, the latter with `400` `certificate is not a CA: basicConstraints cA flag is not set`. If a failure occurs after the key was imported, the key is kept in the KMS and a warning tells you to delete it manually.",{"_3624":1953,"_31165":1893,"_21590":56952,"_5":14857,"_28357":56808,"_3076":56953},[],"Associate an explicit issuance profile if the CA will sign. Check usages and dates using Profiles.",{"_3624":1954,"_31165":1893,"_21590":56955,"_5":14857,"_28357":56812,"_3076":56956},[],"Review the registered type, associated key and engine, and issuer relationship. Certificate-only import may associate an existing KMS key using the certificate’s key identifier. Without a usable key, the CA is public material and cannot sign.",{"_3624":1955,"_31165":1893,"_21590":56958,"_5":14857,"_28357":56812,"_3076":56959},[],"An imported CA whose key is in the KMS and whose certificate carries `cRLSign` receives its CRL settings and first CRL automatically; without a key in the KMS or without `cRLSign` it receives none, and this is not an import error (see CRL).",{"_3624":1956,"_31165":1893,"_21590":56961,"_5":14857,"_28357":56812,"_3076":56962},[],"For an issuing CA, complete a test issuance and check OCSP and CRL. Creating the record alone does not establish key availability, complete chain consistency or status publication.",{"_3624":1957,"_31165":1893,"_21590":56964,"_5":14857,"_28357":56816,"_3076":56965},[],"Open a CA from the inventory to review:",{"_3624":1958,"_31165":1893,"_21590":56967,"_5":14857,"_28357":56816,"_3076":56968},[],"Status and validity period.",{"_3624":1959,"_31165":1893,"_21590":56970,"_5":14857,"_28357":56816,"_3076":56971},[],"Certificate and chain in PEM format.",{"_3624":1960,"_31165":1893,"_21590":56973,"_5":14857,"_28357":56816,"_3076":56974},[],"Number of active, expired and revoked certificates.",{"_3624":1961,"_31165":1893,"_21590":56976,"_5":14857,"_28357":56816,"_3076":56977},[],"Certificates issued in **Issued Certificates**.",{"_3624":1962,"_31165":1893,"_21590":56979,"_5":14857,"_28357":56816,"_3076":56980},[],"The CRL linked to the authority.",{"_3624":1963,"_31165":1893,"_21590":56982,"_5":14857,"_28357":56816,"_3076":56983},[],"Metadata and the associated cryptographic engine.",{"_3624":1964,"_31165":1893,"_21590":56985,"_5":14857,"_28357":56816,"_3076":56986},[],"You can filter the inventory by name, status and CA type.",{"_3624":1965,"_31165":1893,"_21590":56988,"_5":14857,"_28357":56820,"_3076":56989},[],"You can start an issuance from **Issued Certificates**, from a CA's action menu or from the global certificate inventory.",{"_3624":1966,"_31165":1893,"_21590":56991,"_5":14857,"_28357":56820,"_3076":56992},[],"**Generate Key & CSR in Browser** is useful for a manual operation or a quick test. The browser generates the key and you must download it at the end.",{"_3624":1967,"_31165":1893,"_21590":56994,"_5":14857,"_28357":56820,"_3076":56995},[],"**Upload Existing CSR** is the right option when the key must remain on the target system. Lamassu receives the request but never the private key.",{"_3624":1968,"_31165":1893,"_21590":56997,"_5":14857,"_28357":56820,"_3076":56998},[],"Follow Issue your first certificate for the guided flow. Certificate management explains the inventory, inspection and revocation.",{"_3624":1969,"_31165":1893,"_21590":57000,"_5":14857,"_28357":56820,"_3076":57001},[],"A CA key signs certificates only. The CA API has no endpoint to sign or verify arbitrary data. To sign and verify a message with a key, use the KMS operations described in Key management, subject to their own permissions.",{"_3624":1970,"_31165":1893,"_21590":57003,"_5":14857,"_28357":56820,"_3076":57004},[],"A CA signs only while its status is `ACTIVE` and the current time falls inside the validity period of its certificate. Lamassu checks both, because the stored status can lag behind the dates until the expiration monitor runs. Otherwise the request fails with `400` and the message `CA Status inconsistent`, before the KMS is called. The same check applies when the CA signs the certificate of a subordinate CA, including when you create or reissue it.",{"_3624":1971,"_31165":1893,"_21590":57006,"_5":14857,"_28357":56824,"_3076":57007},[],"Revoking a CA prevents issuance and may interrupt its entire branch. With `CertificateHold` the cascade is reversible: descendants are suspended on hold and are restored when you release the CA. Any other revocation reason revokes descendants permanently with `CessationOfOperation`. Follow the cascading revocation conditions.",{"_3624":1972,"_31165":1893,"_21590":57009,"_5":14857,"_28357":56828,"_3076":57010},[],"Identify the certificates, devices and consumers that depend on the CA. Prepare a replacement authority and chain when necessary.",{"_3624":1973,"_31165":1893,"_21590":57012,"_5":14857,"_28357":56832,"_3076":57013},[],"Open the authority and select **Revoke CA**. Choose the reason that describes the incident, for example `KeyCompromise`, `CACompromise`, `Superseded` or `CessationOfOperation`.",{"_3624":1974,"_31165":1893,"_21590":57015,"_5":14857,"_28357":56836,"_3076":57016},[],"Type the CA's name exactly to enable **Confirm Revocation**.",{"_3624":1975,"_31165":1893,"_21590":57018,"_5":14857,"_28357":56840,"_3076":57019},[],"Check **REVOKED** on the CA and review descendants individually; propagation permits partial failures. Independently verify OCSP and CRL publication and consumer rejection. A revoked record does not guarantee that an existing session closes.",{"_3624":1976,"_31165":1893,"_21590":57021,"_5":14857,"_28357":56844,"_3076":57022},[],"Permanent deletion is only available with the CA revoked or expired; a CA imported without a key can be deleted in any state. Delete the record only when your retention and audit policy allows it.",{"_3624":1977,"_31165":1893,"_21590":57024,"_5":14857,"_28357":56844,"_3076":57025},[],"The CA’s CRL settings are kept. A deletion is refused with a `409` error while they are still `ACTIVE`: the VA must first publish the CA’s final CRL, which can take up to about an hour after revocation with the default job schedule, so retry after the final CRL is published. An expired CA is finalized without a final CRL, and a CA on hold (`CertificateHold`) is refused with a message asking you to revoke it permanently first. The deletion is also refused with a `409` when the CA’s key signs the CRLs of another CA: the error names that CA, so change its CRL signer, or delete or revoke it, before deleting this one. The CA and all its descendants are checked before anything is deleted; nothing changes if any of them cannot be deleted.",{"_3624":1978,"_31165":1893,"_21590":57027,"_5":14857,"_28357":56844,"_3076":57028},[],"After the deletion, the settings are archived and the last CRL keeps being served but is never regenerated; you can remove them once no certificate issued by the CA still needs revocation evidence, using `DELETE /v1/crl-settings/{ca-id}` or the console's **Verification Authorities** page. Deleting them stops the CRL from being served and cannot be undone. Adjust the validity and signer before revoking or deleting the CA (see CRL). The CA’s key is released, but the KMS keeps it while other certificates still reference it.",{"_3624":1979,"_31165":1893,"_21590":57030,"_5":14857,"_28357":56844,"_3076":57031},[],"Lamassu keeps the certificate record of a deleted CA. If that same certificate is imported again, the import succeeds and reuses the record: it updates the type, issuer and key but keeps the status, so the CA reappears in the state it had when deleted (normally revoked or expired). A different certificate with the same serial number is rejected with a 400 error, and a certificate that already belongs to an existing CA with a 409 error. To avoid inheriting the previous status, use a certificate with a different serial number and check the result after importing. The reimported CA is registered under a new, backend-generated CA ID and does not inherit the CRL settings of the deleted CA: until those settings are deleted, those keep serving their last CRL at the CA ID URL, and at `/crl/<ski>` — the URL that certificates issued before the 4.0.0 upgrade carry — when the settings were migrated by that upgrade; when they are archived, they can no longer be edited (see CRL).",{"_3624":1980,"_31165":1980,"_5":15217,"_3076":57033,"_31503":57034,"_21590":57035,"_28357":1980},"Certificate profiles",[50900,52412,56586,56587],[],{"_3624":1981,"_31165":1980,"_21590":57037,"_5":14857,"_28357":1980,"_3076":57038},[],"Define reusable policies to issue consistent certificates and constrain accepted keys.",{"_3624":1982,"_31165":1980,"_5":31500,"_21590":57040,"_28357":57041,"_3076":57042},[],"/docs/platform/pki/certificate-profiles#what-a-profile-controls","What a profile controls",{"_3624":1983,"_31165":1980,"_5":31500,"_21590":57044,"_28357":57045,"_3076":57046},[],"/docs/platform/pki/certificate-profiles#validity","Validity",{"_3624":1984,"_31165":1980,"_5":31500,"_21590":57048,"_28357":57049,"_3076":57050},[],"/docs/platform/pki/certificate-profiles#ca-certificate-or-end-entity-certificate","CA certificate or end-entity certificate",{"_3624":1985,"_31165":1980,"_5":31500,"_21590":57052,"_28357":57053,"_3076":57054},[],"/docs/platform/pki/certificate-profiles#key-usage-and-extended-key-usage","Key Usage and Extended Key Usage",{"_3624":1986,"_31165":1980,"_5":31500,"_21590":57056,"_28357":57057,"_3076":57058},[],"/docs/platform/pki/certificate-profiles#subject","Subject",{"_3624":1987,"_31165":1980,"_5":31500,"_21590":57060,"_28357":57061,"_3076":57062},[],"/docs/platform/pki/certificate-profiles#csr-extensions","CSR extensions",{"_3624":1988,"_31165":1980,"_5":31500,"_21590":57064,"_28357":57065,"_3076":57066},[],"/docs/platform/pki/certificate-profiles#cryptographic-constraints","Cryptographic constraints",{"_3624":1989,"_31165":1980,"_5":31500,"_21590":57068,"_28357":57069,"_3076":57070},[],"/docs/platform/pki/certificate-profiles#profile-precedence","Profile precedence",{"_3624":1990,"_31165":1980,"_5":31500,"_21590":57072,"_28357":57073,"_3076":57074},[],"/docs/platform/pki/certificate-profiles#create-a-profile","Create a profile",{"_3624":1991,"_31165":1980,"_5":31500,"_21590":57076,"_28357":57077,"_3076":57078},[],"/docs/platform/pki/certificate-profiles#define-a-single-purpose","Define a single purpose",{"_3624":1992,"_31165":1980,"_5":31500,"_21590":57080,"_28357":57081,"_3076":57082},[],"/docs/platform/pki/certificate-profiles#choose-the-validity","Choose the validity",{"_3624":1993,"_31165":1980,"_5":31500,"_21590":57084,"_28357":57085,"_3076":57086},[],"/docs/platform/pki/certificate-profiles#fix-usages-and-subject","Fix usages and subject",{"_3624":1994,"_31165":1980,"_5":31500,"_21590":57088,"_28357":57089,"_3076":57090},[],"/docs/platform/pki/certificate-profiles#constrain-the-keys","Constrain the keys",{"_3624":1995,"_31165":1980,"_5":31500,"_21590":57092,"_28357":57093,"_3076":57094},[],"/docs/platform/pki/certificate-profiles#attach-it-and-test","Attach it and test",{"_3624":1996,"_31165":1980,"_5":31500,"_21590":57096,"_28357":57097,"_3076":57098},[],"/docs/platform/pki/certificate-profiles#design-examples","Design examples",{"_3624":1997,"_31165":1980,"_5":31500,"_21590":57100,"_28357":57101,"_3076":57102},[],"/docs/platform/pki/certificate-profiles#changes-and-deletion","Changes and deletion",{"_3624":1998,"_31165":1980,"_21590":57104,"_5":14857,"_28357":1980,"_3076":57105},[],"An issuance profile turns a certificate policy into reusable configuration. Instead of deciding validity, subject, extensions and algorithms on every request, you define once what is allowed and attach the profile to a CA, a DMS or a specific issuance.",{"_3624":1999,"_31165":1980,"_21590":57107,"_5":14857,"_28357":1980,"_3076":57108},[],"This guide is for the PKI administrator defining issuance policy. You need permissions to manage profiles and associate them with the intended CA or DMS, plus a test consumer with known identity and purpose requirements.",{"_3624":2000,"_31165":1980,"_21590":57110,"_5":14857,"_28357":57045,"_3076":57111},[],"You can express the lifetime as a duration from the moment of issuance or as a fixed end date. A duration works well for recurring identities; a common date is useful to make a whole batch end before a migration or retirement.",{"_3624":2001,"_31165":1980,"_21590":57113,"_5":14857,"_28357":57045,"_3076":57114},[],"Plan the end date within the issuing CA’s validity and leave a renewal margin. The signer calculates the date from the profile; it does not automatically clamp validity to the issuer’s expiration. Check both dates in the resulting certificate. A fixed date in the past does not produce a usable identity either.",{"_3624":2002,"_31165":1980,"_21590":57116,"_5":14857,"_28357":57049,"_3076":57117},[],"`Sign as CA` sets `IsCA` and the basic constraints needed for an authority. Lamassu enforces this: a profile with `Sign as CA` is consumed only when creating or reissuing a CA. Any signing request that resolves to such a profile is rejected — direct signing with a CA, including certificate issuance requests on it, and DMS enrollment or re-enrollment. Nothing validates the profile when it is saved: if a CA's default profile or a DMS profile has `Sign as CA` enabled, the problem appears on the first signing request that resolves to it — for a DMS profile, when a device tries to enroll or re-enroll — and renewal stays blocked until the profile is changed.",{"_3624":2003,"_31165":1980,"_21590":57119,"_5":14857,"_28357":57053,"_3076":57120},[],"The profile can enforce usages such as `DigitalSignature`, `KeyEncipherment`, `CertSign`, `CRLSign`, `ClientAuth`, `ServerAuth` or `OCSPSigning`.",{"_3624":2004,"_31165":1980,"_21590":57122,"_5":14857,"_28357":57053,"_3076":57123},[],"If you enable **Honor Key Usage** or **Honor Extended Key Usages**, Lamassu keeps the values requested by the CSR. If you disable them, it replaces them with the ones defined in the profile.",{"_3624":2005,"_31165":1980,"_21590":57125,"_5":14857,"_28357":57053,"_3076":57126},[],"Do not enable the `Honor…` options for untrusted requests unless another component validates those fields. Otherwise, the requester may choose broader capabilities than intended.",{"_3624":2006,"_31165":1980,"_21590":57128,"_5":14857,"_28357":57057,"_3076":57129},[],"With **Honor Subject**, the certificate keeps the subject of the CSR. Without that option, Lamassu applies the profile's `CN`, `O`, `OU`, `C`, `ST` and `L`. If the profile does not define a `Common Name`, the requested CN is kept.",{"_3624":2007,"_31165":1980,"_21590":57131,"_5":14857,"_28357":57061,"_3076":57132},[],"With **Honor Extensions**, Lamassu filters the additional requested extensions and keeps only SAN. Without that option, it discards the CSR's additional extensions.",{"_3624":2008,"_31165":1980,"_21590":57134,"_5":14857,"_28357":57061,"_3076":57135},[],"This preserves SAN, but does not establish that the requester is entitled to those DNS names, IP addresses, emails or URIs. Validate that authorization before issuing. OCSP and CRL locations come from the issuance service configuration; `Honor Extensions` does not copy CSR distribution points.",{"_3624":2009,"_31165":1980,"_21590":57137,"_5":14857,"_28357":57065,"_3076":57138},[],"The cryptographic enforcement can:",{"_3624":2010,"_31165":1980,"_21590":57140,"_5":14857,"_28357":57065,"_3076":57141},[],"allow or block RSA keys;",{"_3624":2011,"_31165":1980,"_21590":57143,"_5":14857,"_28357":57065,"_3076":57144},[],"limit the supported RSA sizes;",{"_3624":2012,"_31165":1980,"_21590":57146,"_5":14857,"_28357":57065,"_3076":57147},[],"allow or block ECDSA keys;",{"_3624":2013,"_31165":1980,"_21590":57149,"_5":14857,"_28357":57065,"_3076":57150},[],"limit the supported ECDSA sizes or curves.",{"_3624":2014,"_31165":1980,"_21590":57152,"_5":14857,"_28357":57065,"_3076":57153},[],"When it is enabled, Lamassu checks the public key before creating a CA or signing a CSR. A key whose type or size is not listed in the profile is rejected.",{"_3624":2015,"_31165":1980,"_21590":57155,"_5":14857,"_28357":57069,"_3076":57156},[],"Resolution depends on the entry point. One complete profile is selected; its fields are not merged with the CA’s profile.",{"_3624":2016,"_31165":1980,"_21590":57158,"_5":14857,"_28357":57069,"_3076":54349},[],{"_3624":2017,"_31165":1980,"_21590":57160,"_5":14857,"_28357":57069,"_3076":57161},[],"First choice",{"_3624":2018,"_31165":1980,"_21590":57163,"_5":14857,"_28357":57069,"_3076":57164},[],"Second choice",{"_3624":2019,"_31165":1980,"_21590":57166,"_5":14857,"_28357":57069,"_3076":57167},[],"If neither is supplied",{"_3624":2020,"_31165":1980,"_21590":57169,"_5":14857,"_28357":57069,"_3076":57170},[],"Direct signing with a CA",{"_3624":2021,"_31165":1980,"_21590":57172,"_5":14857,"_28357":57069,"_3076":57173},[],"`issuance_profile` embedded in the request",{"_3624":2022,"_31165":1980,"_21590":57175,"_5":14857,"_28357":57069,"_3076":57176},[],"Request `issuance_profile_id`",{"_3624":2023,"_31165":1980,"_21590":57178,"_5":14857,"_28357":57069,"_3076":57179},[],"CA default profile (`profile_id`).",{"_3624":2024,"_31165":1980,"_21590":57181,"_5":14857,"_28357":57069,"_3076":57182},[],"Issuance through a DMS",{"_3624":2025,"_31165":1980,"_21590":57184,"_5":14857,"_28357":57069,"_3076":57185},[],"`settings.issuance_profile_id`",{"_3624":2026,"_31165":1980,"_21590":57187,"_5":14857,"_28357":57069,"_3076":57188},[],"`settings.issuance_profile` embedded in the DMS",{"_3624":2027,"_31165":1980,"_21590":57190,"_5":14857,"_28357":57069,"_3076":57191},[],"Enrollment CA default profile.",{"_3624":2028,"_31165":1980,"_21590":57193,"_5":14857,"_28357":57069,"_3076":57194},[],"If the selected identifier cannot be resolved, the operation fails; it does not silently fall back to the CA’s profile. Avoid setting both options at once. Recording which profile was selected helps explain why a certificate differs from its CSR.",{"_3624":2029,"_31165":1980,"_21590":57196,"_5":14857,"_28357":57069,"_3076":57197},[],"Several fleets can share a CA while keeping different profiles through their DMSs. Requester authentication and device registration policy are configured separately in DMS.",{"_3624":2030,"_31165":1980,"_21590":57199,"_5":14857,"_28357":57077,"_3076":57200},[],"Separate, for example, mTLS devices, servers and intermediate CAs. A small, specific profile is easier to review than one that allows every use.",{"_3624":2031,"_31165":1980,"_21590":57202,"_5":14857,"_28357":57081,"_3076":57203},[],"Align the duration with the fleet's real renewal capacity. Leave margin against the CA's expiration.",{"_3624":2032,"_31165":1980,"_21590":57205,"_5":14857,"_28357":57085,"_3076":57206},[],"For a device that authenticates as a client, the usual starting point is `DigitalSignature` and `ClientAuth`. Add `ServerAuth` or `KeyEncipherment` only if the protocol needs it.",{"_3624":2033,"_31165":1980,"_21590":57208,"_5":14857,"_28357":57089,"_3076":57209},[],"Enable cryptographic enforcement and list only algorithms and sizes compatible with your policy and your devices.",{"_3624":2034,"_31165":1980,"_21590":57211,"_5":14857,"_28357":57093,"_3076":57212},[],"Attach the profile to a CA or DMS and check the precedence above. Issue a CSR with known usages and SAN; inspect the result with `openssl x509 -in device.crt -noout -text`. Check subject, SAN, KU, EKU and dates. For an end-entity identity, disable `Sign as CA`, require no `CA:TRUE` or `Certificate Sign`, and require `CA:FALSE` if Basic Constraints is present.",{"_3624":2035,"_31165":1980,"_21590":57214,"_5":14857,"_28357":57093,"_3076":57215},[],"Also try a key excluded by policy: issuance should fail. Follow the certificate verification and test acceptance in the intended consumer.",{"_3624":2036,"_31165":1980,"_21590":57217,"_5":14857,"_28357":57097,"_3076":57218},[],"**mTLS device**\\\nEnd-entity certificate, short validity, `DigitalSignature`, `ClientAuth`, subject controlled by the DMS and SAN allowed when it identifies the device.",{"_3624":2037,"_31165":1980,"_21590":57220,"_5":14857,"_28357":57097,"_3076":57221},[],"**TLS server**\\\nEnd-entity certificate, `DigitalSignature`, `ServerAuth` and mandatory SAN with the names clients will use.",{"_3624":2038,"_31165":1980,"_21590":57223,"_5":14857,"_28357":57097,"_3076":57224},[],"**Intermediate CA**\\\n`Sign as CA`, `CertSign` and `CRLSign`, validity longer than its end-entity certificates and stricter cryptographic constraints.",{"_3624":2039,"_31165":1980,"_21590":57226,"_5":14857,"_28357":57097,"_3076":57227},[],"These patterns express design decisions. Enabling `Honor Extensions` does not require a CSR to contain SAN or validate its names; enforce that in the request workflow. A profile does not install trust or grant permissions in the consumer.",{"_3624":2040,"_31165":1980,"_21590":57229,"_5":14857,"_28357":57101,"_3076":57230},[],"Updating a profile affects future issuances; it does not modify already-signed certificates. Test changes before applying them to a CA in production and keep the operational justification.",{"_3624":2041,"_31165":1980,"_21590":57232,"_5":14857,"_28357":57101,"_3076":57233},[],"Before deleting a profile, check that no CA or DMS depends on it. If you want to replace it, create the new version, update the references and perform a test issuance before retiring the old one.",{"_3624":2042,"_31165":2042,"_5":15217,"_3076":57235,"_31503":57236,"_21590":57238,"_28357":2042},"Certificate validation",[50900,52412,56586,57237],"Validation",[],{"_3624":2043,"_31165":2042,"_21590":57240,"_5":14857,"_28357":2042,"_3076":57241},[],"Check chain, identity, purpose and revocation from the consumer.",{"_3624":2044,"_31165":2042,"_5":31500,"_21590":57243,"_28357":57244,"_3076":57245},[],"/docs/platform/pki/certificate-validation#before-querying-status","Before querying status",{"_3624":2045,"_31165":2042,"_5":31500,"_21590":57247,"_28357":57248,"_3076":57249},[],"/docs/platform/pki/certificate-validation#choose-a-mechanism","Choose a mechanism",{"_3624":2046,"_31165":2042,"_5":31500,"_21590":57251,"_28357":57252,"_3076":57253},[],"/docs/platform/pki/certificate-validation#check-consumer-behavior","Check consumer behavior",{"_3624":2047,"_31165":2042,"_21590":57255,"_5":14857,"_28357":2042,"_3076":57256},[],"This guide brings together the checks needed when integrating a certificate consumer. You need the presented certificate, intermediates and roots that your application has deliberately chosen to trust. Lamassu publishes status; the consumer applies acceptance policy.",{"_3624":2048,"_31165":2042,"_21590":57258,"_5":14857,"_28357":57244,"_3076":57259},[],"Verify these criteria together:",{"_3624":2049,"_31165":2042,"_21590":57261,"_5":14857,"_28357":57244,"_3076":56212},[],{"_3624":2050,"_31165":2042,"_21590":57263,"_5":14857,"_28357":57244,"_3076":57264},[],"Required result",{"_3624":2051,"_31165":2042,"_21590":57266,"_5":14857,"_28357":57244,"_3076":57267},[],"Chain and signature",{"_3624":2052,"_31165":2042,"_21590":57269,"_5":14857,"_28357":57244,"_3076":57270},[],"Valid chain to a root deliberately installed in the consumer.",{"_3624":2053,"_31165":2042,"_21590":57272,"_5":14857,"_28357":57244,"_3076":57273},[],"Dates",{"_3624":2054,"_31165":2042,"_21590":57275,"_5":14857,"_28357":57244,"_3076":57276},[],"Current time between `Not Before` and `Not After`, including the CAs in the chain.",{"_3624":2055,"_31165":2042,"_21590":57278,"_5":14857,"_28357":57244,"_3076":52081},[],{"_3624":2056,"_31165":2042,"_21590":57280,"_5":14857,"_28357":57244,"_3076":57281},[],"Name, SAN or identifier matches the expected peer.",{"_3624":2057,"_31165":2042,"_21590":57283,"_5":14857,"_28357":57244,"_3076":51290},[],{"_3624":2058,"_31165":2042,"_21590":57285,"_5":14857,"_28357":57244,"_3076":57286},[],"KU, EKU and constraints permit the specific operation.",{"_3624":2059,"_31165":2042,"_21590":57288,"_5":14857,"_28357":57244,"_3076":57289},[],"Revocation",{"_3624":2060,"_31165":2042,"_21590":57291,"_5":14857,"_28357":57244,"_3076":57292},[],"Signed, current evidence corresponding to the queried issuer and certificate.",{"_3624":2061,"_31165":2042,"_21590":57294,"_5":14857,"_28357":57244,"_3076":57295},[],"Authorization",{"_3624":2062,"_31165":2042,"_21590":57297,"_5":14857,"_28357":57244,"_3076":57298},[],"The application permits that identity to perform the action.",{"_3624":2063,"_31165":2042,"_21590":57300,"_5":14857,"_28357":57244,"_3076":57301},[],"The issuance walkthrough checks chain and purpose with OpenSSL. That check does not automatically query OCSP or download a CRL. Inventory presence or an OCSP `Good` response does not replace the other criteria.",{"_3624":2064,"_31165":2042,"_21590":57303,"_5":14857,"_28357":57248,"_3076":57304},[],"Mechanism",{"_3624":2065,"_31165":2042,"_21590":57306,"_5":14857,"_28357":57248,"_3076":57307},[],"When to use it",{"_3624":2066,"_31165":2042,"_21590":57309,"_5":14857,"_28357":57248,"_3076":57310},[],"What you must maintain",{"_3624":2067,"_31165":2042,"_21590":57312,"_5":14857,"_28357":57248,"_3076":57313},[],"OCSP",{"_3624":2068,"_31165":2042,"_21590":57315,"_5":14857,"_28357":57248,"_3076":57316},[],"Status query for a specific certificate.",{"_3624":2069,"_31165":2042,"_21590":57318,"_5":14857,"_28357":57248,"_3076":57319},[],"Responder access, signature verification and cache/freshness policy.",{"_3624":2070,"_31165":2042,"_21590":57321,"_5":14857,"_28357":57248,"_3076":57322},[],"CRL",{"_3624":2071,"_31165":2042,"_21590":57324,"_5":14857,"_28357":57248,"_3076":57325},[],"Local checks for many certificates or offline operation.",{"_3624":2072,"_31165":2042,"_21590":57327,"_5":14857,"_28357":57248,"_3076":57328},[],"Periodic download of an issuer-signed list and rejection of expired lists.",{"_3624":2073,"_31165":2042,"_21590":57330,"_5":14857,"_28357":57248,"_3076":57331},[],"OCSP can also return a response reusable until `nextUpdate`; a CRL changes when a new version is published. Neither mechanism alone guarantees that a consumer learns a revocation at the moment it is saved.",{"_3624":2074,"_31165":2042,"_21590":57333,"_5":14857,"_28357":57248,"_3076":57334},[],"If using both, define when fallback is allowed and what the client does when retrieval, signature or freshness checks fail, or the result is `Unknown`. Accepting an identity when its status cannot be checked must be an explicit application decision.",{"_3624":2075,"_31165":2042,"_21590":57336,"_5":14857,"_28357":57252,"_3076":57337},[],"Accept a current, authorized certificate with a known chain.",{"_3624":2076,"_31165":2042,"_21590":57339,"_5":14857,"_28357":57252,"_3076":57340},[],"Reject another certificate with an unknown root or incompatible purpose.",{"_3624":2077,"_31165":2042,"_21590":57342,"_5":14857,"_28357":57252,"_3076":57343},[],"Revoke a test certificate and verify the OCSP response or new CRL.",{"_3624":2078,"_31165":2042,"_21590":57345,"_5":14857,"_28357":57252,"_3076":57346},[],"Check that a new connection with that identity is rejected.",{"_3624":2079,"_31165":2042,"_21590":57348,"_5":14857,"_28357":57252,"_3076":57349},[],"Simulate an unreachable endpoint and expired evidence; observe whether the result matches policy.",{"_3624":2080,"_31165":2042,"_21590":57351,"_5":14857,"_28357":57252,"_3076":57352},[],"Keep the serial number, issuer, revocation reason, query time and evidence timestamps. An existing session may need explicit closure or reauthentication in the consumer; publishing revocation does not automatically close it.",{"_3624":2081,"_31165":2042,"_21590":57354,"_5":14857,"_28357":57252,"_3076":57355},[],"For a chain with intermediates, validate their status according to consumer policy as well. An end-entity issuer’s CRL does not replace checks on every CA in the chain.",{"_3624":2082,"_31165":2042,"_21590":57357,"_5":14857,"_28357":57252,"_3076":57358},[],"<Card title=\"Online validation with OCSP\" description=\"Generate a query and verify signature, status and timestamps.\" href=\"/docs/platform/pki/ocsp\" />",{"_3624":2083,"_31165":2042,"_21590":57360,"_5":14857,"_28357":57252,"_3076":57361},[],"<Card title=\"Revocation lists\" description=\"Download, inspect and use an issuer’s CRL.\" href=\"/docs/platform/pki/crl\" />",{"_3624":2084,"_31165":2084,"_5":15217,"_3076":57363,"_31503":57364,"_21590":57365,"_28357":2084},"Certificates",[50900,52412,56586,56587],[],{"_3624":2085,"_31165":2084,"_21590":57367,"_5":14857,"_28357":2084,"_3076":57368},[],"Inspect, download and revoke the certificates issued by Lamassu.",{"_3624":2086,"_31165":2084,"_5":31500,"_21590":57370,"_28357":57371,"_3076":57372},[],"/docs/platform/pki/certificates#find-a-certificate","Find a certificate",{"_3624":2087,"_31165":2084,"_5":31500,"_21590":57374,"_28357":57375,"_3076":57376},[],"/docs/platform/pki/certificates#download-the-certificate","Download the certificate",{"_3624":2088,"_31165":2084,"_5":31500,"_21590":57378,"_28357":57379,"_3076":57380},[],"/docs/platform/pki/certificates#issue-from-an-existing-csr","Issue from an existing CSR",{"_3624":2089,"_31165":2084,"_5":31500,"_21590":57382,"_28357":57383,"_3076":57384},[],"/docs/platform/pki/certificates#revoke-a-certificate","Revoke a certificate",{"_3624":2090,"_31165":2084,"_5":31500,"_21590":57386,"_28357":57387,"_3076":57388},[],"/docs/platform/pki/certificates#open-the-action","Open the action",{"_3624":2091,"_31165":2084,"_5":31500,"_21590":57390,"_28357":57391,"_3076":57392},[],"/docs/platform/pki/certificates#choose-a-reason","Choose a reason",{"_3624":2092,"_31165":2084,"_5":31500,"_21590":57394,"_28357":57395,"_3076":57396},[],"/docs/platform/pki/certificates#confirm-and-verify","Confirm and verify",{"_3624":2093,"_31165":2084,"_5":31500,"_21590":57398,"_28357":57399,"_3076":57400},[],"/docs/platform/pki/certificates#reactivate-a-hold","Reactivate a hold",{"_3624":2094,"_31165":2084,"_5":31500,"_21590":57402,"_28357":57403,"_3076":57404},[],"/docs/platform/pki/certificates#continue","Continue",{"_3624":2095,"_31165":2084,"_21590":57406,"_5":14857,"_28357":2084,"_3076":57407},[],"This guide is for a PKI operator inspecting or retiring an issued identity. You need inventory access and, to change states, permissions on the certificate. Open **Certificates** for a global view or **Issued Certificates** within a CA to restrict it to that issuer.",{"_3624":2096,"_31165":2084,"_21590":57409,"_5":14857,"_28357":57371,"_3076":57410},[],"Filter by `Common Name`, serial, status and issuer. A certificate does not contain its private key, so the private-key surfaces answer which certificates have their key held in Lamassu’s KMS:",{"_3624":2097,"_31165":2084,"_21590":57412,"_5":14857,"_28357":57371,"_3076":57413},[],"The advanced **Private Key** filter, available on the Certificates page and on a CA’s **Issued Certificates** tab, narrows the list to **All Certificates**, **With Private Key** or **Without Private Key**.",{"_3624":2098,"_31165":2084,"_21590":57415,"_5":14857,"_28357":57371,"_3076":57416},[],"The sortable **Private Key** column — shown by default, hidden on narrow screens — marks a key held in the KMS with a green check mark and otherwise shows `-`.",{"_3624":2099,"_31165":2084,"_21590":57418,"_5":14857,"_28357":57371,"_3076":57419},[],"In certificate details, the **Information** tab shows a **Private Key** row in the **Key & Signature** section. When the certificate reports a private key and its KMS engine and key IDs are available, the row links to the key (tooltip: **Open private key in KMS**). Otherwise, it shows **Present** if the certificate reports a private key, or **Not available** if it does not. This does not establish whether a key exists outside Lamassu.",{"_3624":2100,"_31165":2084,"_21590":57421,"_5":14857,"_28357":57371,"_3076":57422},[],"Use **Quick Inspect** for a quick review or **View Details** for subject, SAN, usages, chain, dates and metadata.",{"_3624":2101,"_31165":2084,"_21590":57424,"_5":14857,"_28357":57371,"_3076":57425},[],"Certificate records expose `key_id` (the KMS key that holds the private key, empty when the KMS does not hold it) and `has_private_key` (derived at read time from the KMS). Certificate and CA listings accept a `has_private_key` filter, which is useful, for example, to check the result of the CA-to-KMS migration of the 4.0.0 upgrade.",{"_3624":2102,"_31165":2084,"_21590":57427,"_5":14857,"_28357":57371,"_3076":57428},[],"Identify a certificate by issuer and serial; a name can correspond to several renewals. Check which certificate the consumer actually uses and which occupies the device’s active identity. Identity history and the certificate inventory answer different questions.",{"_3624":2103,"_31165":2084,"_21590":57430,"_5":14857,"_28357":57375,"_3076":57431},[],"Download the PEM and inspect it:",{"_3624":2104,"_31165":2084,"_21590":57433,"_5":14857,"_28357":57375,"_3076":57434},[],"Check issuance policy, chain and usages with the verification walkthrough. A certificate does not contain its private key. For an external CSR, the key remains where it was generated; for the browser flow, retain the file downloaded upon issuance. If the key is lost, plan a new identity rather than expecting recovery from the certificate.",{"_3624":2105,"_31165":2084,"_21590":57436,"_5":14857,"_28357":57379,"_3076":57437},[],"Use this flow when the identity’s key must remain on the system that generated it. You need an active CA with a usable key, a PEM CSR and a suitable profile.",{"_3624":2106,"_31165":2084,"_21590":57439,"_5":14857,"_28357":57379,"_3076":57440},[],"Verify the request with `openssl req -in request.csr -noout -verify -text`. Review subject, SAN and algorithm, and authorize the requested identity.",{"_3624":2107,"_31165":2084,"_21590":57442,"_5":14857,"_28357":57379,"_3076":57443},[],"Start issuance from the CA or inventory and select **Upload Existing CSR**.",{"_3624":2108,"_31165":2084,"_21590":57445,"_5":14857,"_28357":57379,"_3076":57446},[],"Confirm the CA and profile resolved according to Profiles; the request does not guarantee that every field is retained.",{"_3624":2109,"_31165":2084,"_21590":57448,"_5":14857,"_28357":57379,"_3076":57449},[],"Download the certificate and inspect dates, issuer, subject, SAN, KU and EKU. Check correspondence with the private key on the originating system.",{"_3624":2110,"_31165":2084,"_21590":57451,"_5":14857,"_28357":57379,"_3076":57452},[],"Install certificate and chain in the intended consumer and test a connection. Issuance alone does not register a device or grant access in an integration.",{"_3624":2111,"_31165":2084,"_21590":57454,"_5":14857,"_28357":57379,"_3076":57455},[],"For browser key generation, follow Issue your first certificate.",{"_3624":2112,"_31165":2084,"_21590":57457,"_5":14857,"_28357":57383,"_3076":57458},[],"Revoke when the key is compromised, the subject is no longer authorized or the identity must stop being accepted before expiration. Before changing status, identify consumers and prepare any required replacement.",{"_3624":2113,"_31165":2084,"_21590":57460,"_5":14857,"_28357":57387,"_3076":57461},[],"Locate the correct issuer and serial and select **Revoke Certificate**. `EXPIRED` records and records revoked for a final reason reject subsequent status changes.",{"_3624":2114,"_31165":2084,"_21590":57463,"_5":14857,"_28357":57391,"_3076":57464},[],"Select the incident reason. `CertificateHold` represents a reversible certificate suspension; other reasons block later changes. Do not use a suspension to address a compromised key.",{"_3624":2115,"_31165":2084,"_21590":57466,"_5":14857,"_28357":57395,"_3076":57467},[],"Save the change and read the record again: require **REVOKED**, reason and timestamp. Then verify a fresh OCSP query and, if using CRL, its published version and the serial’s presence. Finally check rejection of a new connection in the consumer.",{"_3624":2116,"_31165":2084,"_21590":57469,"_5":14857,"_28357":57395,"_3076":57470},[],"Revocation does not erase the certificate, delete the key or guarantee closure of existing sessions. Status and publication are separate steps.",{"_3624":2117,"_31165":2084,"_21590":57472,"_5":14857,"_28357":57395,"_3076":57473},[],"A certificate revoked with `CertificateHold` can be reactivated if it is not in `EXPIRED` state. Its dates and consumer trust remain mandatory.",{"_3624":2118,"_31165":2084,"_21590":57475,"_5":14857,"_28357":57399,"_3076":57476},[],"Check that the saved reason is `CertificateHold` and the identity still satisfies policy. Request `ACTIVE` through the status update operation exposed by your installation; consult the API reference. Do not assume changing consumer permissions also changes status in Lamassu.",{"_3624":2119,"_31165":2084,"_21590":57478,"_5":14857,"_28357":57399,"_3076":57479},[],"Read the record and query OCSP again. With `regenerate_on_revoke` enabled, the reactivation event requests CRL regeneration: check that the new list omits the serial. An earlier list can still mark it revoked until the client refreshes its copy.",{"_3624":2120,"_31165":2084,"_21590":57481,"_5":14857,"_28357":57399,"_3076":57482},[],"This does not undo permanent revocation or the cascade of a CA revoked for good; the hold cascaded by a CA is lifted by releasing that CA.",{"_3624":2121,"_31165":2084,"_21590":57484,"_5":14857,"_28357":57403,"_3076":57485},[],"<Card title=\"Validate with OCSP\" description=\"Query and verify a certificate’s signed status.\" href=\"/docs/platform/pki/ocsp\" />",{"_3624":2122,"_31165":2084,"_21590":57487,"_5":14857,"_28357":57403,"_3076":57488},[],"<Card title=\"Distribute a CRL\" description=\"Publish status for local validation.\" href=\"/docs/platform/pki/crl\" />",{"_3624":2123,"_31165":2123,"_5":15217,"_3076":57490,"_31503":57491,"_21590":57493,"_28357":2123},"Certificate lifecycle",[50900,52412,56586,57492],"Concepts",[],{"_3624":2124,"_31165":2123,"_21590":57495,"_5":14857,"_28357":2123,"_3076":57496},[],"Issuance, use, renewal, revocation and retirement of certificates in Lamassu.",{"_3624":2125,"_31165":2123,"_5":31500,"_21590":57498,"_28357":57499,"_3076":57500},[],"/docs/platform/pki/concepts/certificate-lifecycle#the-full-journey","The full journey",{"_3624":2126,"_31165":2123,"_5":31500,"_21590":57502,"_28357":57503,"_3076":57504},[],"/docs/platform/pki/concepts/certificate-lifecycle#request","Request",{"_3624":2127,"_31165":2123,"_5":31500,"_21590":57506,"_28357":57507,"_3076":57508},[],"/docs/platform/pki/concepts/certificate-lifecycle#issuance","Issuance",{"_3624":2128,"_31165":2123,"_5":31500,"_21590":57510,"_28357":57511,"_3076":57512},[],"/docs/platform/pki/concepts/certificate-lifecycle#use-and-monitoring","Use and monitoring",{"_3624":2129,"_31165":2123,"_5":31500,"_21590":57514,"_28357":57515,"_3076":57516},[],"/docs/platform/pki/concepts/certificate-lifecycle#renewal-or-re-enrollment","Renewal or re-enrollment",{"_3624":2130,"_31165":2123,"_5":31500,"_21590":57518,"_28357":57519,"_3076":57520},[],"/docs/platform/pki/concepts/certificate-lifecycle#revocation-or-retirement","Revocation or retirement",{"_3624":2131,"_31165":2123,"_5":31500,"_21590":57522,"_28357":57523,"_3076":57524},[],"/docs/platform/pki/concepts/certificate-lifecycle#certificate-states","Certificate states",{"_3624":2132,"_31165":2123,"_5":31500,"_21590":57526,"_28357":57527,"_3076":57528},[],"/docs/platform/pki/concepts/certificate-lifecycle#renewal-and-revocation-are-not-equivalent","Renewal and revocation are not equivalent",{"_3624":2133,"_31165":2123,"_5":31500,"_21590":57530,"_28357":57531,"_3076":57532},[],"/docs/platform/pki/concepts/certificate-lifecycle#effect-of-revoking-a-ca","Effect of revoking a CA",{"_3624":2134,"_31165":2123,"_5":31500,"_21590":57534,"_28357":57535,"_3076":57536},[],"/docs/platform/pki/concepts/certificate-lifecycle#what-you-should-watch","What you should watch",{"_3624":2135,"_31165":2123,"_21590":57538,"_5":14857,"_28357":2123,"_3076":57539},[],"Issuing a certificate is only the beginning. During its useful life you must check its validity, renew it before it expires and retire it when it stops being trustworthy. Lamassu keeps the certificate, its issuing CA, its status and, when it belongs to a device, the identity it is linked to.",{"_3624":2136,"_31165":2123,"_21590":57541,"_5":14857,"_28357":57503,"_3076":57542},[],"The requester generates a key and a CSR. In the recommended flows, the private key stays in the device, browser or cryptographic engine that created it.",{"_3624":2137,"_31165":2123,"_21590":57544,"_5":14857,"_28357":57507,"_3076":57545},[],"The CA signs the CSR. The issuance profile determines the validity, uses, subject, allowed extensions and cryptographic constraints.",{"_3624":2138,"_31165":2123,"_21590":57547,"_5":14857,"_28357":57511,"_3076":57548},[],"The certificate enters the `ACTIVE` state. Lamassu monitors its `Not After` date; the cryptographic monitoring job marks certificates that have expired as `EXPIRED`.",{"_3624":2139,"_31165":2123,"_21590":57550,"_5":14857,"_28357":57515,"_3076":57551},[],"A new certificate is issued before the previous one expires. In a DMS you can open preventive and critical windows so the device re-enrolls through EST.",{"_3624":2140,"_31165":2123,"_21590":57553,"_5":14857,"_28357":57519,"_3076":57554},[],"If the identity stops being trustworthy, Lamassu records the reason and time of revocation. OCSP and CRLs let consumers learn that status.",{"_3624":2141,"_31165":2123,"_21590":57556,"_5":14857,"_28357":57523,"_3076":57557},[],"Lamassu persists four X.509 states:",{"_3624":2142,"_31165":2123,"_21590":57559,"_5":14857,"_28357":57523,"_3076":57560},[],"**`ACTIVE`**: the record is enabled. Also check `Not Before` and `Not After`: this state does not establish time validity.",{"_3624":2143,"_31165":2123,"_21590":57562,"_5":14857,"_28357":57523,"_3076":57563},[],"**`EXPIRED`**: it has passed its expiration date. The monitor detects this periodically; it is not a state that should be assigned manually.",{"_3624":2144,"_31165":2123,"_21590":57565,"_5":14857,"_28357":57523,"_3076":57566},[],"**`REVOKED`**: it was invalidated before expiring, with a reason and a timestamp.",{"_3624":2145,"_31165":2123,"_21590":57568,"_5":14857,"_28357":57523,"_3076":57569},[],"**`INACTIVE`**: it is disabled without representing a definitive revocation.",{"_3624":2146,"_31165":2123,"_21590":57571,"_5":14857,"_28357":57523,"_3076":57572},[],"The device view may add operational states such as missing identity, pending renewal, expiring soon or decommissioned. These are an interpretation of the device's status and its certificates, not new X.509 states.",{"_3624":2147,"_31165":2123,"_21590":57574,"_5":14857,"_28357":57527,"_3076":57575},[],"**Renewal** creates a successor certificate for an identity that remains valid. **Revocation** communicates that the current certificate must no longer be accepted. Renew to maintain continuity; revoke in response to compromise, retirement or a change that invalidates the identity.",{"_3624":2148,"_31165":2123,"_21590":57577,"_5":14857,"_28357":57527,"_3076":57578},[],"Only `CertificateHold` allows reactivating a revoked certificate that is not in `EXPIRED` state. Revocation for another reason blocks subsequent status changes. `EXPIRED` records also reject changes; the consumer must check dates even before the monitor updates the state. Certificates explains how to verify revocation and reactivation.",{"_3624":2149,"_31165":2123,"_21590":57580,"_5":14857,"_28357":57527,"_3076":57581},[],"The **Reissue CA** operation generates another certificate for the same key and links both serial numbers through metadata. It is not a key rotation. To change the key, create a successor CA and perform a migration with an overlapping period.",{"_3624":2150,"_31165":2123,"_21590":57583,"_5":14857,"_28357":57531,"_3076":57584},[],"Revoking a CA starts a cascade that attempts to revoke descendants. A `CertificateHold` cascade suspends them reversibly: releasing the CA restores those still on hold. Any other revocation reason revokes descendants permanently with `CessationOfOperation`. Read Hierarchy and rotation for conditions and checks.",{"_3624":2151,"_31165":2123,"_21590":57586,"_5":14857,"_28357":57531,"_3076":57587},[],"Before confirming:",{"_3624":2152,"_31165":2123,"_21590":57589,"_5":14857,"_28357":57531,"_3076":57590},[],"Identify DMSs, devices and services that trust that chain.",{"_3624":2153,"_31165":2123,"_21590":57592,"_5":14857,"_28357":57531,"_3076":57593},[],"Distribute the new chain of trust.",{"_3624":2154,"_31165":2123,"_21590":57595,"_5":14857,"_28357":57531,"_3076":57596},[],"Reissue the necessary identities.",{"_3624":2155,"_31165":2123,"_21590":57598,"_5":14857,"_28357":57531,"_3076":57599},[],"Check OCSP and CRL from a real consumer.",{"_3624":2156,"_31165":2123,"_21590":57601,"_5":14857,"_28357":57531,"_3076":57602},[],"Revoke the old CA once no legitimate traffic remains.",{"_3624":2157,"_31165":2123,"_21590":57604,"_5":14857,"_28357":57531,"_3076":57605},[],"Device retirement belongs to the IoT Fleets lifecycle. It affects the active identity; it does not automatically traverse and revoke every historical certificate. Review previous identities and consumer permissions separately in Device management.",{"_3624":2158,"_31165":2123,"_21590":57607,"_5":14857,"_28357":57535,"_3076":57608},[],"Certificates entering the preventive or critical renewal window.",{"_3624":2159,"_31165":2123,"_21590":57610,"_5":14857,"_28357":57535,"_3076":57611},[],"Repeated enrollment or re-enrollment failures.",{"_3624":2160,"_31165":2123,"_21590":57613,"_5":14857,"_28357":57535,"_3076":57614},[],"Status changes and revocation reasons.",{"_3624":2161,"_31165":2123,"_21590":57616,"_5":14857,"_28357":57535,"_3076":57617},[],"OCSP and CRL publication and validity.",{"_3624":2162,"_31165":2123,"_21590":57619,"_5":14857,"_28357":57535,"_3076":57620},[],"Dependencies still presenting a replaced certificate.",{"_3624":2163,"_31165":2123,"_21590":57622,"_5":14857,"_28357":57535,"_3076":57623},[],"The device history relates its previous and current identities. For administrative changes and mutation errors, see Audit logs.",{"_3624":2164,"_31165":2164,"_5":15217,"_3076":57625,"_31503":57626,"_21590":57627,"_28357":2164},"Trust model",[50900,52412,56586,57492],[],{"_3624":2165,"_31165":2164,"_21590":57629,"_5":14857,"_28357":2164,"_3076":57630},[],"Understand where trust originates, how it is distributed and what each component validates.",{"_3624":2166,"_31165":2164,"_5":31500,"_21590":57632,"_28357":57633,"_3076":57634},[],"/docs/platform/pki/concepts/trust-model#the-four-trust-decisions","The four trust decisions",{"_3624":2167,"_31165":2164,"_5":31500,"_21590":57636,"_28357":57637,"_3076":57638},[],"/docs/platform/pki/concepts/trust-model#who-can-issue","Who can issue",{"_3624":2168,"_31165":2164,"_5":31500,"_21590":57640,"_28357":57641,"_3076":57642},[],"/docs/platform/pki/concepts/trust-model#what-can-be-issued","What can be issued",{"_3624":2169,"_31165":2164,"_5":31500,"_21590":57644,"_28357":57645,"_3076":57646},[],"/docs/platform/pki/concepts/trust-model#who-can-request-it","Who can request it",{"_3624":2170,"_31165":2164,"_5":31500,"_21590":57648,"_28357":57649,"_3076":57650},[],"/docs/platform/pki/concepts/trust-model#who-accepts-the-result","Who accepts the result",{"_3624":2171,"_31165":2164,"_5":31500,"_21590":57652,"_28357":57653,"_3076":57654},[],"/docs/platform/pki/concepts/trust-model#identity-flow","Identity flow",{"_3624":2172,"_31165":2164,"_5":31500,"_21590":57656,"_28357":57657,"_3076":57658},[],"/docs/platform/pki/concepts/trust-model#enrollment-validation-and-distribution-cas","Enrollment, validation and distribution CAs",{"_3624":2173,"_31165":2164,"_5":31500,"_21590":57660,"_28357":57661,"_3076":57662},[],"/docs/platform/pki/concepts/trust-model#validation-and-revocation","Validation and revocation",{"_3624":2174,"_31165":2164,"_5":31500,"_21590":57664,"_28357":57665,"_3076":57666},[],"/docs/platform/pki/concepts/trust-model#custody-limits","Custody limits",{"_3624":2175,"_31165":2164,"_5":31500,"_21590":57668,"_28357":57669,"_3076":57670},[],"/docs/platform/pki/concepts/trust-model#recommended-pattern","Recommended pattern",{"_3624":2176,"_31165":2164,"_21590":57672,"_5":14857,"_28357":2164,"_3076":57673},[],"In Lamassu, trust does not simply mean that a certificate exists in the inventory. A consumer trusts an identity when it can build a chain to a root it recognizes, check that the certificate is fit for the intended use and verify that it is still valid.",{"_3624":2177,"_31165":2164,"_21590":57675,"_5":14857,"_28357":57637,"_3076":57676},[],"The CA hierarchy defines which authorities can sign. A root CA establishes the anchor of trust; intermediate CAs separate operating domains and avoid using the root for every issuance.",{"_3624":2178,"_31165":2164,"_21590":57678,"_5":14857,"_28357":57641,"_3076":57679},[],"Certificate profiles limit validity, subject, uses, extensions and cryptographic parameters. Possessing a CA does not replace an issuance policy.",{"_3624":2179,"_31165":2164,"_21590":57681,"_5":14857,"_28357":57645,"_3076":57682},[],"The DMS acts as the enrollment point. It can authenticate an EST request with a client certificate, an external webhook or a combination of both. CAs configured to validate the requester do not have to be the CA that will issue the new identity.",{"_3624":2180,"_31165":2164,"_21590":57684,"_5":14857,"_28357":57649,"_3076":57685},[],"The consumer keeps its own trust store. EST `/cacerts` can distribute the service TLS certificate, the enrollment CA and selected managed CAs. Initial trust for authenticating that service must come from an already trusted channel. Download and inspect the contents: do not assume they form a complete chain or install every entry as a root.",{"_3624":2181,"_31165":2164,"_21590":57687,"_5":14857,"_28357":57653,"_3076":57688},[],"The device proves it can enroll according to the DMS policy.",{"_3624":2182,"_31165":2164,"_21590":57690,"_5":14857,"_28357":57653,"_3076":57691},[],"The DMS validates the request and forwards the CSR to the enrollment CA.",{"_3624":2183,"_31165":2164,"_21590":57693,"_5":14857,"_28357":57653,"_3076":57694},[],"In the device-generated CSR flow, the CA applies the profile and signs without receiving the device’s private key.",{"_3624":2184,"_31165":2164,"_21590":57696,"_5":14857,"_28357":57653,"_3076":57697},[],"The device installs the certificate and the chain it needs.",{"_3624":2185,"_31165":2164,"_21590":57699,"_5":14857,"_28357":57653,"_3076":57700},[],"The system that trusts the device validates the chain, dates, uses and revocation status.",{"_3624":2186,"_31165":2164,"_21590":57702,"_5":14857,"_28357":57653,"_3076":57703},[],"OIDC or X.509 identifies the operator calling Lamassu. The authorization service decides which actions it may perform. The X.509 hierarchy, on the other hand, determines whether a certificate presented by a device is trustworthy.",{"_3624":2187,"_31165":2164,"_21590":57705,"_5":14857,"_28357":57657,"_3076":57706},[],"A DMS relates three sets that are worth designing separately:",{"_3624":2188,"_31165":2164,"_21590":57708,"_5":14857,"_28357":57657,"_3076":57709},[],"**Enrollment CA:** signs the new identities.",{"_3624":2189,"_31165":2164,"_21590":57711,"_5":14857,"_28357":57657,"_3076":57712},[],"**Validation CAs:** authenticate the client certificates used for enrollment or migration. During re-enrollment, the enrollment CA is always trusted and Lamassu then tries the validation CAs configured in the re-enrollment block; those are optional.",{"_3624":2190,"_31165":2164,"_21590":57714,"_5":14857,"_28357":57657,"_3076":57715},[],"**Distributed CAs:** form the content the device obtains through EST `/cacerts`. You can include the service TLS certificate, the enrollment CA and an explicit list of managed CAs. Including the issuer does not automatically add all its ancestors.",{"_3624":2191,"_31165":2164,"_21590":57717,"_5":14857,"_28357":57657,"_3076":57718},[],"This separation makes it possible to migrate a fleet: you temporarily accept certificates from the old hierarchy, issue with the new one and distribute both chains during the overlap.",{"_3624":2192,"_31165":2164,"_21590":57720,"_5":14857,"_28357":57661,"_3076":57721},[],"A valid chain does not by itself guarantee that a certificate should be accepted. The consumer must also check:",{"_3624":2193,"_31165":2164,"_21590":57723,"_5":14857,"_28357":57661,"_3076":57724},[],"that the current date is between `Not Before` and `Not After`;",{"_3624":2194,"_31165":2164,"_21590":57726,"_5":14857,"_28357":57661,"_3076":57727},[],"that `Key Usage` and `Extended Key Usage` allow the operation;",{"_3624":2195,"_31165":2164,"_21590":57729,"_5":14857,"_28357":57661,"_3076":57730},[],"that names, SANs and subject match the expected identity;",{"_3624":2196,"_31165":2164,"_21590":57732,"_5":14857,"_28357":57661,"_3076":57733},[],"that the certificate does not appear revoked in OCSP or a CRL.",{"_3624":2197,"_31165":2164,"_21590":57735,"_5":14857,"_28357":57661,"_3076":57736},[],"An OCSP `Good` status does not replace chain, date, usage and identity checks either; Validation brings those criteria together.",{"_3624":2198,"_31165":2164,"_21590":57738,"_5":14857,"_28357":57661,"_3076":57739},[],"During the mTLS authentication of a DMS, Lamassu checks revocation and fails closed: a certificate whose revocation cannot be verified is rejected by default. The `allow_unverifiable_revocation` option of the DMS (see DMS) is the opt-out, and it only relaxes certificates that carry no OCSP/CRL endpoint at all. Design your profiles and distribution points so that the check succeeds.",{"_3624":2199,"_31165":2164,"_21590":57741,"_5":14857,"_28357":57665,"_3076":57742},[],"The KMS keeps the reference to the key and delegates the operation to the configured engine. With an HSM or a cloud KMS, the private key can remain non-exportable. That protects custody, but it does not by itself prevent misuse: you still must restrict who can request a signature and audit those operations.",{"_3624":2200,"_31165":2164,"_21590":57744,"_5":14857,"_28357":57669,"_3076":57745},[],"Keep the root out of daily operations, or with very restricted access.",{"_3624":2201,"_31165":2164,"_21590":57747,"_5":14857,"_28357":57669,"_3076":57748},[],"Issue from intermediate CAs separated by environment or risk domain.",{"_3624":2202,"_31165":2164,"_21590":57750,"_5":14857,"_28357":57669,"_3076":57751},[],"Assign explicit profiles to every use case.",{"_3624":2203,"_31165":2164,"_21590":57753,"_5":14857,"_28357":57669,"_3076":57754},[],"Distribute the new trust before starting a rotation.",{"_3624":2204,"_31165":2164,"_21590":57756,"_5":14857,"_28357":57669,"_3076":57757},[],"Keep enough overlap to renew a disconnected fleet.",{"_3624":2205,"_31165":2164,"_21590":57759,"_5":14857,"_28357":57669,"_3076":57760},[],"Validate from the consuming system, not only from the Lamassu console.",{"_3624":2206,"_31165":2164,"_21590":57762,"_5":14857,"_28357":57669,"_3076":57763},[],"Continue with CA hierarchy and rotation to turn this model into an operating procedure.",{"_3624":2207,"_31165":2207,"_5":15217,"_3076":57765,"_31503":57766,"_21590":57767,"_28357":2207},"Revocation lists (CRL)",[50900,52412,56586,57237],[],{"_3624":2208,"_31165":2207,"_21590":57769,"_5":14857,"_28357":2207,"_3076":57770},[],"Generate and distribute signed lists to validate certificates offline.",{"_3624":2209,"_31165":2207,"_5":31500,"_21590":57772,"_28357":57773,"_3076":57774},[],"/docs/platform/pki/crl#crl-settings","CRL settings",{"_3624":2210,"_31165":2207,"_5":31500,"_21590":57776,"_28357":57777,"_3076":57778},[],"/docs/platform/pki/crl#cas-that-share-a-key","CAs that share a key",{"_3624":2211,"_31165":2207,"_5":31500,"_21590":57780,"_28357":57781,"_3076":57782},[],"/docs/platform/pki/crl#periodic-and-automatic-regeneration","Periodic and automatic regeneration",{"_3624":2212,"_31165":2207,"_5":31500,"_21590":57784,"_28357":57785,"_3076":57786},[],"/docs/platform/pki/crl#crl-contents","CRL contents",{"_3624":2213,"_31165":2207,"_5":31500,"_21590":57788,"_28357":57789,"_3076":57790},[],"/docs/platform/pki/crl#public-download-endpoint","Public download endpoint",{"_3624":2214,"_31165":2207,"_5":31500,"_21590":57792,"_28357":57793,"_3076":57794},[],"/docs/platform/pki/crl#crl-settings-api","CRL settings API",{"_3624":2215,"_31165":2207,"_5":31500,"_21590":57796,"_28357":57797,"_3076":57798},[],"/docs/platform/pki/crl#common-crl-settings-errors","Common CRL settings errors",{"_3624":2216,"_31165":2207,"_5":31500,"_21590":57800,"_28357":57801,"_3076":57802},[],"/docs/platform/pki/crl#references","References",{"_3624":2217,"_31165":2207,"_21590":57804,"_5":14857,"_28357":2207,"_3076":57805},[],"A CRL is an issuer-signed list of revoked certificates. This guide is for an operator publishing lists and an integrator using them locally. You need the issuing CA certificate, its CA ID and access to the published endpoint. The client must maintain a current copy: offline operation still requires refreshing evidence.",{"_3624":2218,"_31165":2207,"_21590":57807,"_5":14857,"_28357":57773,"_3076":57808},[],"The CRL settings of a CA store the configuration and metadata of its latest published list. Each CA has its own settings, keyed by its CA ID — even when two CAs share a key: they share the SKI, not the CRL. The VA creates them when a CA is created; when a CA is imported whose key is in the KMS — either imported with the private key or already held by the KMS — and whose certificate carries `cRLSign`: such a CA publishes its first CRL immediately, like a created one; and when a CA without settings is reissued with a certificate that can sign CRLs. An imported CA whose key is not in the KMS, or whose certificate lacks `cRLSign`, receives no settings: the import succeeds without error, and the CA's CRL endpoints report the settings as missing. Settings are never created retroactively: a CA that has none keeps none until it is reissued. Generation requires a usable issuer key; do not assume an imported CA without a key has an available CRL.",{"_3624":2219,"_31165":2207,"_21590":57810,"_5":14857,"_28357":57773,"_3076":57811},[],"Field",{"_3624":2220,"_31165":2207,"_21590":57813,"_5":14857,"_28357":57773,"_3076":51290},[],{"_3624":2221,"_31165":2207,"_21590":57815,"_5":14857,"_28357":57773,"_3076":52532},[],{"_3624":2222,"_31165":2207,"_21590":57817,"_5":14857,"_28357":57773,"_3076":57818},[],"ID of the CA the settings belong to.",{"_3624":2223,"_31165":2207,"_21590":57820,"_5":14857,"_28357":57773,"_3076":57821},[],"`status`",{"_3624":2224,"_31165":2207,"_21590":57823,"_5":14857,"_28357":57773,"_3076":57824},[],"Lifecycle of the settings. `ACTIVE` ones generate CRLs. `FINAL` ones belong to a CA revoked permanently or expired: the first publishes one final CRL, valid until the CA's current certificate expires, and the second is turned `FINAL` without one. `ARCHIVED` ones belong to a deleted CA: their last CRL is still served, but never regenerated.",{"_3624":2225,"_31165":2207,"_21590":57826,"_5":14857,"_28357":57773,"_3076":57827},[],"`legacy_ski`",{"_3624":2226,"_31165":2207,"_21590":57829,"_5":14857,"_28357":57773,"_3076":57830},[],"Read-only. SKI the settings were keyed by before the 4.0.0 migration; only migrated settings have it, and `/crl/<ski>` keeps resolving to them.",{"_3624":2227,"_31165":2207,"_21590":57832,"_5":14857,"_28357":57773,"_3076":57833},[],"`latest_crl`",{"_3624":2228,"_31165":2207,"_21590":57835,"_5":14857,"_28357":57773,"_3076":57836},[],"Version, validity start and end of the last published list. Read-only.",{"_3624":2229,"_31165":2207,"_21590":57838,"_5":14857,"_28357":57773,"_3076":57839},[],"`crl_options` field",{"_3624":2230,"_31165":2207,"_21590":57841,"_5":14857,"_28357":57773,"_3076":51290},[],{"_3624":2231,"_31165":2207,"_21590":57843,"_5":14857,"_28357":57773,"_3076":57844},[],"Initial value",{"_3624":2232,"_31165":2207,"_21590":57846,"_5":14857,"_28357":57773,"_3076":57847},[],"`validity`",{"_3624":2233,"_31165":2207,"_21590":57849,"_5":14857,"_28357":57773,"_3076":57850},[],"Time from `thisUpdate` to `nextUpdate`.",{"_3624":2234,"_31165":2207,"_21590":57852,"_5":14857,"_28357":57773,"_3076":57853},[],"7 days.",{"_3624":2235,"_31165":2207,"_21590":57855,"_5":14857,"_28357":57773,"_3076":57856},[],"`refresh_interval`",{"_3624":2236,"_31165":2207,"_21590":57858,"_5":14857,"_28357":57773,"_3076":57859},[],"Time since the issuance of the latest published CRL that triggers scheduled renewal; `0` disables only this trigger. The effective granularity is bounded by the job frequency (see Periodic and automatic regeneration).",{"_3624":2237,"_31165":2207,"_21590":57861,"_5":14857,"_28357":57773,"_3076":57862},[],"6 days and 23 hours.",{"_3624":2238,"_31165":2207,"_21590":57864,"_5":14857,"_28357":57773,"_3076":57865},[],"`regenerate_on_revoke`",{"_3624":2239,"_31165":2207,"_21590":57867,"_5":14857,"_28357":57773,"_3076":57868},[],"Request regeneration on revocation or reactivation from `CertificateHold` events.",{"_3624":2240,"_31165":2207,"_21590":57870,"_5":14857,"_28357":57773,"_3076":57871},[],"`true`.",{"_3624":2241,"_31165":2207,"_21590":57873,"_5":14857,"_28357":57773,"_3076":57874},[],"`signer_serial_number`",{"_3624":2242,"_31165":2207,"_21590":57876,"_5":14857,"_28357":57773,"_3076":57877},[],"Serial number of the existing certificate that signs the CRL.",{"_3624":2243,"_31165":2207,"_21590":57879,"_5":14857,"_28357":57773,"_3076":57880},[],"Serial number of the CA’s current certificate.",{"_3624":2244,"_31165":2207,"_21590":57882,"_5":14857,"_28357":57773,"_3076":57883},[],"The signer must be an existing certificate with the `cRLSign` key usage and the same subject and public key as the CA. Certificates from before a reissue qualify. A delegated signer is not supported: a certificate with the CA’s subject but a different key is rejected.",{"_3624":2245,"_31165":2207,"_21590":57885,"_5":14857,"_28357":57773,"_3076":57886},[],"When a CA is reissued and the signer is the superseded CA certificate, the VA moves the signer to the new certificate — provided it carries `cRLSign` — and republishes the CRL. If the new certificate lacks `cRLSign`, the VA keeps the previous signer and logs a warning. If the signer is any other certificate with the CA’s subject and key, it is deliberately left unchanged; the previous certificate then cannot be deleted while the settings use it (the API returns `409` `certificate is in use`), and to retire it you update the signer with `PUT`.",{"_3624":2246,"_31165":2207,"_21590":57888,"_5":14857,"_28357":57773,"_3076":57889},[],"The CRL lifecycle decisions — when publication stops and when the final CRL expires — use only the CA's current certificate. If a reissued certificate expires earlier than an older certificate that is still valid, CRL publication can stop, or the final CRL can expire, while the older certificate is still valid. This is an accepted limitation of the current behavior.",{"_3624":2247,"_31165":2207,"_21590":57891,"_5":14857,"_28357":57773,"_3076":57892},[],"A CA whose signer lacks `cRLSign` cannot generate its CRL, and an update that selects a signer without `cRLSign` is rejected (400 error). Since 4.0 the VA requires this usage. Check before importing with `openssl x509 -noout -ext keyUsage` and, if it is missing, obtain a certificate for the same CA and key that includes it and update the settings to use it as the signer. A CA that has no settings at all — for example, one imported without `cRLSign` — has nothing to update: the only way to obtain them is to reissue the CA with a certificate that carries `cRLSign`. After reissuing a CA, also check the key usage of the new certificate: it may not keep the original’s usages, and without `cRLSign` the settings keep their previous signer.",{"_3624":2248,"_31165":2207,"_21590":57894,"_5":14857,"_28357":57773,"_3076":57895},[],"Deleting a CA keeps its CRL settings; they remain until you delete the archived ones through the API or from the console's Verification Authorities page (see CRL settings API). What happens to them depends on how the CA ended:",{"_3624":2249,"_31165":2207,"_21590":57897,"_5":14857,"_28357":57773,"_3076":57898},[],"The 4.0.0 upgrade migration archives the settings of the CAs that had been deleted before the upgrade. Their `status` is `ARCHIVED` and their `ca_id` is `legacy-<ski>`: the last CRL keeps being served, but it is never regenerated, any `PUT` returns 409, and there is no API way back to `ACTIVE`.",{"_3624":2250,"_31165":2207,"_21590":57900,"_5":14857,"_28357":57773,"_3076":57901},[],"Revoking a CA permanently or letting it expire finalizes its settings: their `status` becomes `FINAL`, any `PUT` returns 409, and no new CRL is generated. A permanently revoked CA publishes one final CRL, valid until the CA's current certificate expires; an expired CA gets none. Deleting the CA afterwards archives its settings, which then behave like the archived ones of the migration.",{"_3624":2251,"_31165":2207,"_21590":57903,"_5":14857,"_28357":57773,"_3076":57904},[],"The settings can no longer be edited while their `status` is not `ACTIVE`. Adjust validity and signer before revoking or deleting a CA.",{"_3624":2252,"_31165":2207,"_21590":57906,"_5":14857,"_28357":57773,"_3076":57907},[],"`PUT` validates the signer only when the request changes it. If the stored signer is no longer valid, the other options can still be edited, but the CRL cannot be regenerated until a valid signer is set.",{"_3624":2253,"_31165":2207,"_21590":57909,"_5":14857,"_28357":57773,"_3076":57910},[],"Sharing a key between CAs is a migration blocker: the 4.0.0 upgrade aborts while an SKI belongs to more than one CA. See CAs that share a key.",{"_3624":2254,"_31165":2207,"_21590":57912,"_5":14857,"_28357":57773,"_3076":57913},[],"CRL versions are kept as PEM in object storage at `pki/va/crl/<ca-id>/<version>.crl`; the public endpoint returns DER. CRLs published before the 4.0.0 upgrade remain at `pki/va/crl/<ski>/<version>.crl` and keep being served.",{"_3624":2255,"_31165":2207,"_21590":57915,"_5":14857,"_28357":57777,"_3076":57916},[],"Since 4.0.0, each CA publishes its own CRL even when its key is shared: two CAs with the same key have the same SKI, but each has its own CRL settings and its own list, signed by a certificate with that CA’s identity.",{"_3624":2256,"_31165":2207,"_21590":57918,"_5":14857,"_28357":57777,"_3076":57919},[],"Certificates issued from now on carry `/crl/<ca-id>` distribution points, so each CA’s certificates resolve to its own list. Certificates issued before the upgrade keep their `/crl/<ski>` distribution points: that URL keeps resolving to the settings the upgrade migrated, and always serves the list of the CA that owned that SKI when the upgrade ran. It is never rebound to a CA created later with the same key. After regeneration, the migrated list includes both URLs in its *Issuing Distribution Point* (OID `2.5.29.28`), so a verifier that compares the IDP with the CDP of the certificate accepts either form. Until the VA scheduled CRL job successfully regenerates it, the pre-upgrade list contains only the legacy `/crl/<ski>` IDP; IDP-checking verifiers cannot validate newly issued certificates with `/crl/<ca-id>` CDPs. The first run can take up to about an hour with the default schedule, and failures can extend the window.",{"_3624":2257,"_31165":2207,"_21590":57921,"_5":14857,"_28357":57777,"_3076":57922},[],"Sharing an SKI between CAs blocks the upgrade: the migration aborts and names the SKIs. To detect the problem before upgrading, compare the SKI of the CAs in the inventory: two with the same SKI are affected. To fix it, create a CA with its own key and reissue its certificates; those already issued keep the old URL and are not corrected until reissued.",{"_3624":2258,"_31165":2207,"_21590":57924,"_5":14857,"_28357":57777,"_3076":57925},[],"Lamassu takes the SKI of an imported certificate as-is and does not check that it corresponds to its public key. Until Lamassu rejects imports whose SKI collides with an existing CA — proposed in lamassuiot#834, together with the per-CA CRL that 4.0.0 implements — restrict the permission to import CAs as an interim control; it covers only the import path. Creating a CA with &#x2A;*Create New CA (Existing Key)** on a KMS key another CA already uses produces the same SKI collision, so avoid reusing keys across CAs.",{"_3624":2259,"_31165":2207,"_21590":57927,"_5":14857,"_28357":57781,"_3076":57928},[],"The VA scheduled job checks the CRL settings of every CA on each run and requests a new list when either of these conditions is met:",{"_3624":2260,"_31165":2207,"_21590":57930,"_5":14857,"_28357":57781,"_3076":57931},[],"**The list is about to expire:** the remaining validity of `latest_crl` is less than the interval between job runs. This condition always applies and cannot be disabled.",{"_3624":2261,"_31165":2207,"_21590":57933,"_5":14857,"_28357":57781,"_3076":57934},[],"**The refresh interval has elapsed:** the time since the issuance of the latest published CRL reaches `refresh_interval`. Setting `refresh_interval` to `0` disables only this condition; the list is still regenerated when it is about to expire.",{"_3624":2262,"_31165":2207,"_21590":57936,"_5":14857,"_28357":57781,"_3076":57937},[],"Setting `refresh_interval` to `0` therefore does not freeze regeneration. With the default 7-day validity and an hourly job, a CRL is renewed up to an hour before it expires even if `refresh_interval` is `0`. Because the job runs on its own schedule, `refresh_interval` is honored only as precisely as the job frequency allows.",{"_3624":2263,"_31165":2207,"_21590":57939,"_5":14857,"_28357":57781,"_3076":57940},[],"The job frequency is set in Helm with `services.va.job.crl.frequency` (default `0 * * * *`) and accepts a duration (`1h`) or a cron expression. A cron expression is converted into a constant interval equal to the time left until its next firing when the service starts, so it is not aligned with the clock. Keep `validity` well above that interval: with a shorter validity, the list is regenerated on every cycle.",{"_3624":2264,"_31165":2207,"_21590":57942,"_5":14857,"_28357":57781,"_3076":57943},[],"If generation fails (for example, because the CA cannot be resolved or the signer is invalid), the job logs the warning `something went wrong while calculating CRL for CA <ca-id>` and retries on the next cycle. There is no other renewal path until the cause is fixed, and the last published list keeps being served until it expires. All of this depends on working jobs, storage and signing.",{"_3624":2265,"_31165":2207,"_21590":57945,"_5":14857,"_28357":57781,"_3076":57946},[],"Settings whose `status` is not `ACTIVE` — `FINAL` or `ARCHIVED` — are skipped: nothing regenerates their CRL.",{"_3624":2266,"_31165":2207,"_21590":57948,"_5":14857,"_28357":57781,"_3076":57949},[],"With `regenerate_on_revoke`, the event handler requests a new CRL upon revocation or reactivation from `CertificateHold` to `ACTIVE`. This happens after the status change and has its own failure paths: if generation fails (for example, because of an invalid signer), the event is retried and, once retries are exhausted, moves to the failed-events queue. If the issuing CA has no CRL settings, there is no CRL to regenerate: the event is acknowledged without retry, the VA logs a warning, and nothing appears in the failed-events queue. Confirming revocation does not establish that the new CRL is already published or that all clients have downloaded it.",{"_3624":2267,"_31165":2207,"_21590":57951,"_5":14857,"_28357":57781,"_3076":57952},[],"Compare CRL numbers and timestamps before and after a change. Monitor expired lists and generation failures; clients must apply policy when current evidence is unavailable.",{"_3624":2268,"_31165":2207,"_21590":57954,"_5":14857,"_28357":57785,"_3076":57955},[],"Each entry contains serial number, revocation time and reason. The generator queries certificates in `REVOKED` state for the selected CA. A reactivated certificate disappears when the list is recalculated; an earlier downloaded copy retains its contents.",{"_3624":2269,"_31165":2207,"_21590":57957,"_5":14857,"_28357":57785,"_3076":57958},[],"The list contains a critical *Issuing Distribution Point* (OID `2.5.29.28`) with configured distribution URLs. Check that your client interprets this extension and that it matches the list’s scope. If rejected, investigate format and scope; ignoring a critical extension is not successful validation.",{"_3624":2270,"_31165":2207,"_21590":57960,"_5":14857,"_28357":57789,"_3076":57961},[],"The VA service exposes `GET /crl/{id}` without management authorization. Use the **issuing CA’s** ID, not the end-entity certificate’s ID or serial. Certificates issued before the 4.0.0 upgrade carry `/crl/<ski>` URLs with the SKI of the CA key; that form keeps resolving. First inspect the certificate’s CDP:",{"_3624":2271,"_31165":2207,"_21590":57963,"_5":14857,"_28357":57789,"_3076":57964},[],"Replace the following URL with the CDP URL and review exposure in Deployment:",{"_3624":2272,"_31165":2207,"_21590":57966,"_5":14857,"_28357":57789,"_3076":57967},[],"You need OpenSSL 3.x and `issuer.pem` containing the direct issuer’s certificate. An accepted signer certificate has the same subject and public key as the CA, so this signature check also works when the settings point to an earlier certificate for that CA and key. Require a valid signature, current timestamps and the expected issuer. For a root that issues directly:",{"_3624":2273,"_31165":2207,"_21590":57969,"_5":14857,"_28357":57789,"_3076":57970},[],"`roots.pem` contains deliberately trusted roots. For intermediates, add `-untrusted intermediates.pem` before the `device.crt` argument. `-crl_check` checks the end-entity certificate’s revocation against the local list; it does not download other lists or establish the status of the whole chain. A complete chain check needs the corresponding CRLs and a policy requiring them.",{"_3624":2274,"_31165":2207,"_21590":57972,"_5":14857,"_28357":57789,"_3076":57973},[],"The test should accept an allowed certificate absent from the list and reject it with `certificate revoked` after publishing and using the list containing its serial.",{"_3624":2275,"_31165":2207,"_21590":57975,"_5":14857,"_28357":57793,"_3076":57976},[],"The following paths are relative to the VA service; confirm the public prefix in the Gateway. They are not the URLs of the public OCSP and CRL endpoints.",{"_3624":2276,"_31165":2207,"_21590":57978,"_5":14857,"_28357":57793,"_3076":54352},[],{"_3624":2277,"_31165":2207,"_21590":57980,"_5":14857,"_28357":57793,"_3076":57981},[],"Relative path",{"_3624":2278,"_31165":2207,"_21590":57983,"_5":14857,"_28357":57793,"_3076":54349},[],{"_3624":2279,"_31165":2207,"_21590":57985,"_5":14857,"_28357":57793,"_3076":57986},[],"`GET`",{"_3624":2280,"_31165":2207,"_21590":57988,"_5":14857,"_28357":57793,"_3076":57989},[],"`/v1/crl-settings`",{"_3624":2281,"_31165":2207,"_21590":57991,"_5":14857,"_28357":57793,"_3076":57992},[],"List the CRL settings; filterable at least by `ca_id`, `status` and `legacy_ski`.",{"_3624":2282,"_31165":2207,"_21590":57994,"_5":14857,"_28357":57793,"_3076":57986},[],{"_3624":2283,"_31165":2207,"_21590":57996,"_5":14857,"_28357":57793,"_3076":57997},[],"`/v1/crl-settings/{ca-id}`",{"_3624":2284,"_31165":2207,"_21590":57999,"_5":14857,"_28357":57793,"_3076":58000},[],"Read the `crl_options` and `latest_crl` of a CA.",{"_3624":2285,"_31165":2207,"_21590":58002,"_5":14857,"_28357":57793,"_3076":58003},[],"`PUT`",{"_3624":2286,"_31165":2207,"_21590":58005,"_5":14857,"_28357":57793,"_3076":57997},[],{"_3624":2287,"_31165":2207,"_21590":58007,"_5":14857,"_28357":57793,"_3076":58008},[],"Replace the CRL configuration of a CA.",{"_3624":2288,"_31165":2207,"_21590":58010,"_5":14857,"_28357":57793,"_3076":58011},[],"`DELETE`",{"_3624":2289,"_31165":2207,"_21590":58013,"_5":14857,"_28357":57793,"_3076":57997},[],{"_3624":2290,"_31165":2207,"_21590":58015,"_5":14857,"_28357":57793,"_3076":58016},[],"Remove the archived CRL settings of a CA.",{"_3624":2291,"_31165":2207,"_21590":58018,"_5":14857,"_28357":57793,"_3076":58019},[],"You need authentication and CRL settings read, update or delete permissions. Consult your installation’s API reference and Access control. Read current configuration before updating and send the full object expected by the contract — `refresh_interval`, `validity`, `signer_serial_number` and `regenerate_on_revoke`: the backend replaces all four; it does not merge omitted fields. `status`, `legacy_ski` and `latest_crl` are read-only. A `PUT` returns 409 when the settings are not `ACTIVE`, validates the signer only when it changes, and does not regenerate the CRL.",{"_3624":2292,"_31165":2207,"_21590":58021,"_5":14857,"_28357":57793,"_3076":58022},[],"Archived settings, whose CA no longer exists, can be removed with `DELETE`: the call returns 204 on success, 404 when the CA has no settings and 409 while the settings are not yet archived. After the deletion, the public `/crl/{id}` endpoint and any legacy `/crl/<ski>` endpoint stop serving the CA’s list, although the published CRL files remain in the bucket. Keep the archived settings while any certificate issued by the CA may still need revocation evidence: `DELETE` stops serving the list immediately, regardless of `latest_crl` validity. The action cannot be undone.",{"_3624":2293,"_31165":2207,"_21590":58024,"_5":14857,"_28357":57793,"_3076":58025},[],"After a change, check saved configuration and the next list actually published. Updating the settings alone does not establish regeneration or client acceptance.",{"_3624":2294,"_31165":2207,"_21590":58027,"_5":14857,"_28357":57797,"_3076":58028},[],"Symptom",{"_3624":2295,"_31165":2207,"_21590":58030,"_5":14857,"_28357":57797,"_3076":58031},[],"Cause",{"_3624":2296,"_31165":2207,"_21590":58033,"_5":14857,"_28357":57797,"_3076":58034},[],"Action",{"_3624":2297,"_31165":2207,"_21590":58036,"_5":14857,"_28357":57797,"_3076":58037},[],"`PUT /v1/crl-settings/{ca-id}` returns 409.",{"_3624":2298,"_31165":2207,"_21590":58039,"_5":14857,"_28357":57797,"_3076":58040},[],"The settings are not `ACTIVE`: revoking the CA permanently or letting it expire finalized them, or the migration archived them because their CA was deleted before the upgrade.",{"_3624":2299,"_31165":2207,"_21590":58042,"_5":14857,"_28357":57797,"_3076":58043},[],"There is no API way back to `ACTIVE`. The last CRL keeps being served.",{"_3624":2300,"_31165":2207,"_21590":58045,"_5":14857,"_28357":57797,"_3076":58046},[],"`DELETE /v1/crl-settings/{ca-id}` returns 409.",{"_3624":2301,"_31165":2207,"_21590":58048,"_5":14857,"_28357":57797,"_3076":58049},[],"The settings are not yet `ARCHIVED`: the CA has not been deleted.",{"_3624":2302,"_31165":2207,"_21590":58051,"_5":14857,"_28357":57797,"_3076":58052},[],"Delete the CA first; deleting it archives its settings.",{"_3624":2303,"_31165":2207,"_21590":58054,"_5":14857,"_28357":57797,"_3076":58055},[],"`PUT` returns 400.",{"_3624":2304,"_31165":2207,"_21590":58057,"_5":14857,"_28357":57797,"_3076":58058},[],"The new signer lacks `cRLSign`, or its subject and public key do not match the CA.",{"_3624":2305,"_31165":2207,"_21590":58060,"_5":14857,"_28357":57797,"_3076":58061},[],"Set the serial number of a valid certificate of that CA.",{"_3624":2306,"_31165":2207,"_21590":58063,"_5":14857,"_28357":57797,"_3076":58064},[],"`PUT` returns 404.",{"_3624":2307,"_31165":2207,"_21590":58066,"_5":14857,"_28357":57797,"_3076":58067},[],"The CA or the new signer certificate does not exist, or the CA has no CRL settings, for example because it was imported without its key or its certificate lacks `cRLSign`.",{"_3624":2308,"_31165":2207,"_21590":58069,"_5":14857,"_28357":57797,"_3076":58070},[],"Check the CA ID and the signer serial number.",{"_3624":2309,"_31165":2207,"_21590":58072,"_5":14857,"_28357":57797,"_3076":58073},[],"`PUT` returns 400 from a 3.x client.",{"_3624":2310,"_31165":2207,"_21590":58075,"_5":14857,"_28357":57797,"_3076":58076},[],"`crl_options.subject_key_id_signer` was replaced by `crl_options.signer_serial_number`, which is required.",{"_3624":2311,"_31165":2207,"_21590":58078,"_5":14857,"_28357":57797,"_3076":58079},[],"Update the client to send the new field.",{"_3624":2312,"_31165":2207,"_21590":58081,"_5":14857,"_28357":57797,"_3076":58082},[],"The CRL does not change after revoking a certificate.",{"_3624":2313,"_31165":2207,"_21590":58084,"_5":14857,"_28357":57797,"_3076":58085},[],"`regenerate_on_revoke` is `false`, the issuing CA has no CRL settings, or generation failed because of an invalid signer.",{"_3624":2314,"_31165":2207,"_21590":58087,"_5":14857,"_28357":57797,"_3076":58088},[],"Check the VA logs. Missing settings only produce a warning (no retry, no failed-events entry); an invalid signer also leaves the event in the failed-events queue, so fix the signer.",{"_3624":2315,"_31165":2207,"_21590":58090,"_5":14857,"_28357":57797,"_3076":58091},[],"A verifier rejects the CRL because of the issuer.",{"_3624":2316,"_31165":2207,"_21590":58093,"_5":14857,"_28357":57797,"_3076":58094},[],"The list was fetched through a legacy `/crl/<ski>` URL and belongs to the CA that owned that SKI when the upgrade ran.",{"_3624":2317,"_31165":2207,"_21590":58096,"_5":14857,"_28357":57797,"_3076":58097},[],"Use the CDP of the certificate being validated: certificates issued in 4.0.0 carry `/crl/<ca-id>` URLs.",{"_3624":2318,"_31165":2207,"_21590":58099,"_5":14857,"_28357":57801,"_3076":58100},[],"RFC 5280: X.509 and CRL profile.",{"_3624":2319,"_31165":2207,"_21590":58102,"_5":14857,"_28357":57801,"_3076":58103},[],"OpenSSL: openssl-crl.",{"_3624":2320,"_31165":2207,"_21590":58105,"_5":14857,"_28357":57801,"_3076":58106},[],"OpenSSL: openssl-verify.",{"_3624":2321,"_31165":2207,"_21590":58108,"_5":14857,"_28357":57801,"_3076":58109},[],"<Card title=\"OCSP service\" href=\"/docs/platform/pki/ocsp\" />",{"_3624":2322,"_31165":2207,"_21590":58111,"_5":14857,"_28357":57801,"_3076":58112},[],"<Card title=\"Certificate validation\" href=\"/docs/platform/pki/certificate-validation\" />",{"_3624":2323,"_31165":2323,"_5":15217,"_3076":58114,"_31503":58115,"_21590":58116,"_28357":2323},"Keys and cryptographic engines",[50900,52412,56586,56587],[],{"_3624":2324,"_31165":2323,"_21590":58118,"_5":14857,"_28357":2323,"_3076":58119},[],"Generate, import and operate keys without coupling the PKI to a specific provider.",{"_3624":2325,"_31165":2323,"_5":31500,"_21590":58121,"_28357":58122,"_3076":58123},[],"/docs/platform/pki/key-management#what-the-kms-solves","What the KMS solves",{"_3624":2326,"_31165":2323,"_5":31500,"_21590":58125,"_28357":58126,"_3076":58127},[],"/docs/platform/pki/key-management#cryptographic-engines","Cryptographic engines",{"_3624":2327,"_31165":2323,"_5":31500,"_21590":58129,"_28357":58130,"_3076":58131},[],"/docs/platform/pki/key-management#file-system","File System",{"_3624":2328,"_31165":2323,"_5":31500,"_21590":58133,"_28357":58134,"_3076":58135},[],"/docs/platform/pki/key-management#hashicorp-vault","HashiCorp Vault",{"_3624":2329,"_31165":2323,"_5":31500,"_21590":58137,"_28357":58138,"_3076":58139},[],"/docs/platform/pki/key-management#aws-secrets-manager","AWS Secrets Manager",{"_3624":2330,"_31165":2323,"_5":31500,"_21590":58141,"_28357":58142,"_3076":58143},[],"/docs/platform/pki/key-management#aws-kms","AWS KMS",{"_3624":2331,"_31165":2323,"_5":31500,"_21590":58145,"_28357":58146,"_3076":58147},[],"/docs/platform/pki/key-management#pkcs11","PKCS#11",{"_3624":2332,"_31165":2323,"_5":31500,"_21590":58149,"_28357":58150,"_3076":58151},[],"/docs/platform/pki/key-management#azure-key-vault","Azure Key Vault",{"_3624":2333,"_31165":2323,"_5":31500,"_21590":58153,"_28357":58154,"_3076":58155},[],"/docs/platform/pki/key-management#key-inventory","Key inventory",{"_3624":2334,"_31165":2323,"_5":31500,"_21590":58157,"_28357":58158,"_3076":58159},[],"/docs/platform/pki/key-management#create-or-import-keys","Create or import keys",{"_3624":2335,"_31165":2323,"_5":31500,"_21590":58161,"_28357":58162,"_3076":58163},[],"/docs/platform/pki/key-management#generate-a-new-key-pair","Generate a new key pair",{"_3624":2336,"_31165":2323,"_5":31500,"_21590":58165,"_28357":58166,"_3076":58167},[],"/docs/platform/pki/key-management#import-an-existing-pair","Import an existing pair",{"_3624":2337,"_31165":2323,"_5":31500,"_21590":58169,"_28357":58170,"_3076":58171},[],"/docs/platform/pki/key-management#operations-on-a-key","Operations on a key",{"_3624":2338,"_31165":2323,"_5":31500,"_21590":58173,"_28357":58174,"_3076":58175},[],"/docs/platform/pki/key-management#view-details","View details",{"_3624":2339,"_31165":2323,"_5":31500,"_21590":58177,"_28357":58178,"_3076":58179},[],"/docs/platform/pki/key-management#sign-and-verify","Sign and verify",{"_3624":2340,"_31165":2323,"_5":31500,"_21590":58181,"_28357":58182,"_3076":58183},[],"/docs/platform/pki/key-management#sign","Sign",{"_3624":2341,"_31165":2323,"_5":31500,"_21590":58185,"_28357":58186,"_3076":58187},[],"/docs/platform/pki/key-management#verify","Verify",{"_3624":2342,"_31165":2323,"_5":31500,"_21590":58189,"_28357":58190,"_3076":58191},[],"/docs/platform/pki/key-management#generate-a-csr","Generate a CSR",{"_3624":2343,"_31165":2323,"_5":31500,"_21590":58193,"_28357":58194,"_3076":58195},[],"/docs/platform/pki/key-management#sign-locally-with-pkcs11","Sign locally with PKCS#11",{"_3624":2344,"_31165":2323,"_5":31500,"_21590":58197,"_28357":58198,"_3076":58199},[],"/docs/platform/pki/key-management#before-deleting-a-key","Before deleting a key",{"_3624":2345,"_31165":2323,"_21590":58201,"_5":14857,"_28357":2323,"_3076":58202},[],"The Cryptographic Key Management Service (KMS) of Lamassu IoT centralizes the generation, import, custody and use of the platform's keys. This is where you manage the keys that support the CAs and the rest of the signing operations that depend on the PKI.",{"_3624":2346,"_31165":2323,"_21590":58204,"_5":14857,"_28357":2323,"_3076":58205},[],"In the current configuration, Lamassu IoT works exclusively with asymmetric keys, such as RSA and elliptic curves. These keys are used to issue X.509 certificates, sign requests and perform authentication and validation operations within the system.",{"_3624":2347,"_31165":2323,"_21590":58207,"_5":14857,"_28357":58122,"_3076":58208},[],"The KMS unifies key lifecycle management and prevents every service from having to integrate directly with a specific cryptographic provider.",{"_3624":2348,"_31165":2323,"_21590":58210,"_5":14857,"_28357":58122,"_3076":58211},[],"In practice, it lets you:",{"_3624":2349,"_31165":2323,"_21590":58213,"_5":14857,"_28357":58122,"_3076":58214},[],"Generate new key pairs from Lamassu IoT.",{"_3624":2350,"_31165":2323,"_21590":58216,"_5":14857,"_28357":58122,"_3076":58217},[],"Import keys created externally.",{"_3624":2351,"_31165":2323,"_21590":58219,"_5":14857,"_28357":58122,"_3076":58220},[],"Delegate custody and cryptographic operations to external engines.",{"_3624":2352,"_31165":2323,"_21590":58222,"_5":14857,"_28357":58122,"_3076":58223},[],"Reuse existing keys for CAs, CSRs and signing or verification tasks.",{"_3624":2353,"_31165":2323,"_21590":58225,"_5":14857,"_28357":58126,"_3076":58226},[],"Lamassu can work with different cryptographic engines depending on deployment requirements. In some environments a software engine is enough; in others custody must be delegated to an HSM, a cloud service or a specialized platform.",{"_3624":2354,"_31165":2323,"_21590":58228,"_5":14857,"_28357":58126,"_3076":58229},[],"A single instance can have several engines configured at the same time, including multiple instances of the same type. This lets you adapt operations to different security, cost and regulatory requirements.",{"_3624":2355,"_31165":2323,"_21590":58231,"_5":14857,"_28357":58126,"_3076":58232},[],"This guide is for the PKI operator: select and use an already enabled engine. Installation, credentials, persistent storage and connectivity belong to Deployment. Before generating a CA, check the default engine, advertised algorithms and a test signature. Availability in your installation depends on its version and configuration.",{"_3624":2356,"_31165":2323,"_21590":58234,"_5":14857,"_28357":58130,"_3076":58235},[],"Generates software keys and stores private material in files. Custody depends on installation permissions, storage and backups. Before using it for an operational CA, agree how the key will be recovered and how replicas will access it; the KMS record does not replace those files.",{"_3624":2357,"_31165":2323,"_21590":58237,"_5":14857,"_28357":58134,"_3076":58238},[],"The adapter uses KV storage for private material. This is not signing within Vault Transit: someone able to read the secret can recover the key. Review read permissions, availability and recovery with the deployment owner.",{"_3624":2358,"_31165":2323,"_21590":58240,"_5":14857,"_28357":58134,"_3076":58241},[],"The adapter reaches Vault over its configured HTTP(S) endpoint. The Vault server certificate is verified against the system trust store; a Vault signed by a private CA is trusted by adding its CA certificate to the engine's `ca_cert_file` (PEM-encoded). `insecure_skip_verify=true` disables verification and is a last resort; agree the transport settings with the deployment owner.",{"_3624":2359,"_31165":2323,"_21590":58243,"_5":14857,"_28357":58138,"_3076":58244},[],"Offers encrypted persistence in AWS at a cost. It protects the key at rest, but an authorized administrator can recover it; it does not provide the same extraction resistance as a KMS or HSM.",{"_3624":2360,"_31165":2323,"_21590":58246,"_5":14857,"_28357":58142,"_3076":58247},[],"Delegates signing to AWS KMS. The adapter also implements external material import, subject to provider capabilities and permissions. A key generated outside the service has already existed outside its custody; importing it does not remove those copies. Check generation, import and signing as separate operations.",{"_3624":2361,"_31165":2323,"_21590":58249,"_5":14857,"_28357":58146,"_3076":58250},[],"Allows integrating local HSMs, isolated environments and *Key as a Service* offerings. Generation, persistence and extraction resistance depend on the specific device or provider. It is the most flexible option when policy requires hardware custody.",{"_3624":2362,"_31165":2323,"_21590":58252,"_5":14857,"_28357":58150,"_3076":58253},[],"The backend also provides adapters for **Key Vault Keys** and **Key Vault Secrets**. The former delegates signing to the key service; the latter stores private material as secrets and signs using that material. These are different custody models. Confirm which adapter is enabled in your installation and test the required operations.",{"_3624":2363,"_31165":2323,"_21590":58255,"_5":14857,"_28357":58150,"_3076":58256},[],"Lamassu shows the enabled engines in the console.",{"_3624":2364,"_31165":2323,"_21590":58258,"_5":14857,"_28357":58150,"_3076":58259},[],"Each engine defines which algorithms it supports, such as RSA or ECC/ECDSA, and which key sizes it can generate.",{"_3624":2365,"_31165":2323,"_21590":58261,"_5":14857,"_28357":58150,"_3076":58262},[],"Confirm with the deployment operator which engine is configured as the default. That engine will be used when a process needs to create or persist a key and the user has not selected a specific one, for example when creating or importing a CA.",{"_3624":2366,"_31165":2323,"_21590":58264,"_5":14857,"_28357":58154,"_3076":58265},[],"The main KMS screen shows the complete inventory of keys registered in the system. It is the reference view for reviewing which keys exist, where they are kept and which entities they relate to.",{"_3624":2367,"_31165":2323,"_21590":58267,"_5":14857,"_28357":58154,"_3076":58268},[],"The table includes the following fields:",{"_3624":2368,"_31165":2323,"_21590":58270,"_5":14857,"_28357":58154,"_3076":58271},[],"**Name**: descriptive name of the key.",{"_3624":2369,"_31165":2323,"_21590":58273,"_5":14857,"_28357":58154,"_3076":58274},[],"**Type**: algorithm and key size, for example RSA 2048 or EC P-256.",{"_3624":2370,"_31165":2323,"_21590":58276,"_5":14857,"_28357":58154,"_3076":58277},[],"**Strength**: visual indicator of cryptographic strength.",{"_3624":2371,"_31165":2323,"_21590":58279,"_5":14857,"_28357":58154,"_3076":58280},[],"**Public/Private**: whether Lamassu manages the full pair or only the public key.",{"_3624":2372,"_31165":2323,"_21590":58282,"_5":14857,"_28357":58154,"_3076":58283},[],"**Crypto Engine**: cryptographic engine keeping the key.",{"_3624":2373,"_31165":2323,"_21590":58285,"_5":14857,"_28357":58154,"_3076":58286},[],"**Aliases**: alternative names associated with the key.",{"_3624":2374,"_31165":2323,"_21590":58288,"_5":14857,"_28357":58154,"_3076":58289},[],"**Tags**: labels for classification and search.",{"_3624":2375,"_31165":2323,"_21590":58291,"_5":14857,"_28357":58154,"_3076":58292},[],"**Related Entities**: certificates or other entities linked to that key.",{"_3624":2376,"_31165":2323,"_21590":58294,"_5":14857,"_28357":58154,"_3076":58295},[],"From this view you also reach the most common actions:",{"_3624":2377,"_31165":2323,"_21590":58297,"_5":14857,"_28357":58154,"_3076":58298},[],"**View Details** to inspect metadata, identifiers and relationships.",{"_3624":2378,"_31165":2323,"_21590":58300,"_5":14857,"_28357":58154,"_3076":58301},[],"**Generate CSR** to create a PKCS#10 request with the selected key.",{"_3624":2379,"_31165":2323,"_21590":58303,"_5":14857,"_28357":58154,"_3076":58304},[],"**Sign / Verify** to test cryptographic operations on the key.",{"_3624":2380,"_31165":2323,"_21590":58306,"_5":14857,"_28357":58154,"_3076":58307},[],"**Delete Key** to remove the key from the system.",{"_3624":2381,"_31165":2323,"_21590":58309,"_5":14857,"_28357":58158,"_3076":58310},[],"You need key administration permissions and a reachable engine. The issuance profile must allow the chosen algorithm if the key will be used in a CA or CSR. Open **Create New Key** and choose generation or import.",{"_3624":2382,"_31165":2323,"_21590":58312,"_5":14857,"_28357":58162,"_3076":58313},[],"If the key will be born inside Lamassu, the recommended flow is to generate a new pair managed directly by one of the configured engines.",{"_3624":2383,"_31165":2323,"_21590":58315,"_5":14857,"_28357":58162,"_3076":58316},[],"On the wizard's first screen, choose **Generate New Key Pair** and then define the main parameters:",{"_3624":2384,"_31165":2323,"_21590":58318,"_5":14857,"_28357":58162,"_3076":58319},[],"**Key Name**: unique and descriptive name.",{"_3624":2385,"_31165":2323,"_21590":58321,"_5":14857,"_28357":58162,"_3076":58322},[],"**Crypto Engine**: engine that will keep the key.",{"_3624":2386,"_31165":2323,"_21590":58324,"_5":14857,"_28357":58162,"_3076":58325},[],"**Key Type** and **Key Size**: algorithm and size or curve.",{"_3624":2387,"_31165":2323,"_21590":58327,"_5":14857,"_28357":58162,"_3076":58328},[],"**Tags**: metadata to classify the key.",{"_3624":2388,"_31165":2323,"_21590":58330,"_5":14857,"_28357":58162,"_3076":58331},[],"**Metadata**: additional information for advanced uses.",{"_3624":2389,"_31165":2323,"_21590":58333,"_5":14857,"_28357":58166,"_3076":58334},[],"Importing lets you register in Lamassu a key generated outside the platform. It is the usual flow in BYOK scenarios, migrations or integration with cryptographic material already in production.",{"_3624":2390,"_31165":2323,"_21590":58336,"_5":14857,"_28357":58166,"_3076":58337},[],"When you have an exportable private key and the destination engine supports import.",{"_3624":2391,"_31165":2323,"_21590":58339,"_5":14857,"_28357":58166,"_3076":58340},[],"When an existing PKI needs to be migrated without reissuing certificates.",{"_3624":2392,"_31165":2323,"_21590":58342,"_5":14857,"_28357":58166,"_3076":58343},[],"When Lamassu must operate with a root of trust created by a third party.",{"_3624":2393,"_31165":2323,"_21590":58345,"_5":14857,"_28357":58166,"_3076":58346},[],"In the wizard, choose **Import Existing Key Pair** and complete the requested fields:",{"_3624":2394,"_31165":2323,"_21590":58348,"_5":14857,"_28357":58166,"_3076":58349},[],"**Key Name**: descriptive name within Lamassu IoT.",{"_3624":2395,"_31165":2323,"_21590":58351,"_5":14857,"_28357":58166,"_3076":58352},[],"**Crypto Engine**: engine that will keep the imported key.",{"_3624":2396,"_31165":2323,"_21590":58354,"_5":14857,"_28357":58166,"_3076":58355},[],"**Tags**: labels for organization and search.",{"_3624":2397,"_31165":2323,"_21590":58357,"_5":14857,"_28357":58166,"_3076":58358},[],"**Metadata**: additional optional information.",{"_3624":2398,"_31165":2323,"_21590":58360,"_5":14857,"_28357":58166,"_3076":58361},[],"**Private Key (PEM)**: private key in PEM format.",{"_3624":2399,"_31165":2323,"_21590":58363,"_5":14857,"_28357":58166,"_3076":58364},[],"After a successful import, open the record, check the engine and public key, and perform a test signature. A non-exportable HSM key cannot be uploaded through this PEM form: configure engine access and check how the existing key is registered. Review dependencies and any provider resources already created if an operation fails partway through.",{"_3624":2400,"_31165":2323,"_21590":58366,"_5":14857,"_28357":58170,"_3076":58367},[],"Each registered key has a detail view and several operational actions.",{"_3624":2401,"_31165":2323,"_21590":58369,"_5":14857,"_28357":58174,"_3076":58370},[],"The **View Details** screen concentrates the technical and administrative information of the key.",{"_3624":2402,"_31165":2323,"_21590":58372,"_5":14857,"_28357":58174,"_3076":58373},[],"The **Overview** tab shows, among others, these fields:",{"_3624":2403,"_31165":2323,"_21590":58375,"_5":14857,"_28357":58174,"_3076":58376},[],"**Key Name**: descriptive name.",{"_3624":2404,"_31165":2323,"_21590":58378,"_5":14857,"_28357":58174,"_3076":58379},[],"**Key Identifier**: unique system identifier. Lamassu uses PKCS11-based ID formats.",{"_3624":2405,"_31165":2323,"_21590":58381,"_5":14857,"_28357":58174,"_3076":58382},[],"**Tags**: associated labels.",{"_3624":2406,"_31165":2323,"_21590":58384,"_5":14857,"_28357":58174,"_3076":58385},[],"**Aliases**: alternative names.",{"_3624":2407,"_31165":2323,"_21590":58387,"_5":14857,"_28357":58174,"_3076":58388},[],"**Crypto Engine**: engine where the key resides.",{"_3624":2408,"_31165":2323,"_21590":58390,"_5":14857,"_28357":58174,"_3076":58391},[],"**Algorithm, Key Size & Strength**: algorithm, parameters and strength level.",{"_3624":2409,"_31165":2323,"_21590":58393,"_5":14857,"_28357":58174,"_3076":58394},[],"The **Related Entities** section shows which Lamassu objects depend on that key.",{"_3624":2410,"_31165":2323,"_21590":58396,"_5":14857,"_28357":58174,"_3076":58397},[],"The **Public Key** tab shows public material in PEM. The record’s identifier and URI locate the key; a PKCS#11-formatted URI does not establish that the engine is an HSM or that a local module can access it.",{"_3624":2411,"_31165":2323,"_21590":58399,"_5":14857,"_28357":58178,"_3076":58400},[],"The **Sign / Verify** action validates that the key and the cryptographic engine work correctly.",{"_3624":2412,"_31165":2323,"_21590":58402,"_5":14857,"_28357":58178,"_3076":58403},[],"Sign a test message, save the signature and verify it using the same public key, algorithm and encoding. Then change the message: verification should fail. This tests one operation; it does not establish every engine capability or a CA’s chain.",{"_3624":2413,"_31165":2323,"_21590":58405,"_5":14857,"_28357":58178,"_3076":58406},[],"When you open it, two areas appear: **Sign** and **Verify**.",{"_3624":2414,"_31165":2323,"_21590":58408,"_5":14857,"_28357":58182,"_3076":58409},[],"This tab uses the private key to generate a digital signature over a message or an already computed *digest*.",{"_3624":2415,"_31165":2323,"_21590":58411,"_5":14857,"_28357":58182,"_3076":58412},[],"Main fields:",{"_3624":2416,"_31165":2323,"_21590":58414,"_5":14857,"_28357":58182,"_3076":58415},[],"**Algorithm**: signing algorithm available for the key type.",{"_3624":2417,"_31165":2323,"_21590":58417,"_5":14857,"_28357":58182,"_3076":58418},[],"**Message Type**: `Raw` for clear data or `Digest` for a precomputed hash.",{"_3624":2418,"_31165":2323,"_21590":58420,"_5":14857,"_28357":58182,"_3076":58421},[],"**Payload Encoding**: input encoding, such as UTF-8, Hex or Base64.",{"_3624":2419,"_31165":2323,"_21590":58423,"_5":14857,"_28357":58182,"_3076":58424},[],"**Message**: content to sign.",{"_3624":2420,"_31165":2323,"_21590":58426,"_5":14857,"_28357":58182,"_3076":58427},[],"**Signature**: result of the operation, shown in hexadecimal.",{"_3624":2421,"_31165":2323,"_21590":58429,"_5":14857,"_28357":58186,"_3076":58430},[],"This tab checks whether a signature corresponds to the associated public key.",{"_3624":2422,"_31165":2323,"_21590":58432,"_5":14857,"_28357":58186,"_3076":58412},[],{"_3624":2423,"_31165":2323,"_21590":58434,"_5":14857,"_28357":58186,"_3076":58435},[],"**Algorithm**: must match the algorithm used for the signature.",{"_3624":2424,"_31165":2323,"_21590":58437,"_5":14857,"_28357":58186,"_3076":58438},[],"**Message Type**: `Raw` or `Digest`.",{"_3624":2425,"_31165":2323,"_21590":58440,"_5":14857,"_28357":58186,"_3076":58441},[],"**Payload Encoding**: encoding of the message.",{"_3624":2426,"_31165":2323,"_21590":58443,"_5":14857,"_28357":58186,"_3076":58444},[],"**Message**: original message or hash.",{"_3624":2427,"_31165":2323,"_21590":58446,"_5":14857,"_28357":58186,"_3076":58447},[],"**Signature**: signature to check.",{"_3624":2428,"_31165":2323,"_21590":58449,"_5":14857,"_28357":58186,"_3076":58450},[],"**Result**: indicator of the validation result.",{"_3624":2429,"_31165":2323,"_21590":58452,"_5":14857,"_28357":58190,"_3076":58453},[],"The **Generate CSR** action creates a PKCS#10 request signed with the private key kept in Lamassu, without exposing it outside the cryptographic engine.",{"_3624":2430,"_31165":2323,"_21590":58455,"_5":14857,"_28357":58190,"_3076":58456},[],"This flow is useful for:",{"_3624":2431,"_31165":2323,"_21590":58458,"_5":14857,"_28357":58190,"_3076":58459},[],"Requesting certificates from an external CA.",{"_3624":2432,"_31165":2323,"_21590":58461,"_5":14857,"_28357":58190,"_3076":58462},[],"Renewing an identity while keeping the same key.",{"_3624":2433,"_31165":2323,"_21590":58464,"_5":14857,"_28357":58190,"_3076":58465},[],"When you open the form, it asks for the subject data and the main certificate attributes:",{"_3624":2434,"_31165":2323,"_21590":58467,"_5":14857,"_28357":58190,"_3076":58468},[],"**Common Name (CN)**: main name of the identity.",{"_3624":2435,"_31165":2323,"_21590":58470,"_5":14857,"_28357":58190,"_3076":58471},[],"**Organization (O)**: organization or company.",{"_3624":2436,"_31165":2323,"_21590":58473,"_5":14857,"_28357":58190,"_3076":58474},[],"**Organizational Unit (OU)**: department or unit.",{"_3624":2437,"_31165":2323,"_21590":58476,"_5":14857,"_28357":58190,"_3076":58477},[],"**Country (C)**: two-letter country code.",{"_3624":2438,"_31165":2323,"_21590":58479,"_5":14857,"_28357":58190,"_3076":58480},[],"**State / Province (ST)**: state or province.",{"_3624":2439,"_31165":2323,"_21590":58482,"_5":14857,"_28357":58190,"_3076":58483},[],"**Locality (L)**: city or locality.",{"_3624":2440,"_31165":2323,"_21590":58485,"_5":14857,"_28357":58190,"_3076":58486},[],"**Email Address**: contact email.",{"_3624":2441,"_31165":2323,"_21590":58488,"_5":14857,"_28357":58190,"_3076":58489},[],"**Subject Alternative Names (SANs)**: alternative names or identifiers, such as DNS or IP.",{"_3624":2442,"_31165":2323,"_21590":58491,"_5":14857,"_28357":58190,"_3076":58492},[],"Download the CSR and run `openssl req -in request.csr -noout -verify -text`. Check signature, subject and SAN before sending it. A CSR does not determine the final certificate by itself: issuance policy can replace its fields.",{"_3624":2443,"_31165":2323,"_21590":58494,"_5":14857,"_28357":58194,"_3076":58495},[],"Lamassu also offers specific help for local integrations through **Sign locally with OpenSSL & PKCS11 tools**.",{"_3624":2444,"_31165":2323,"_21590":58497,"_5":14857,"_28357":58194,"_3076":58498},[],"It requires the module, token and permissions of the corresponding provider. Check that the Lamassu identifier matches the object accessible from that module. Module configuration belongs to the client environment or Deployment.",{"_3624":2445,"_31165":2323,"_21590":58500,"_5":14857,"_28357":58198,"_3076":58501},[],"Review **Related Entities** and locate CAs, certificates and validation processes that still need signatures. Revoking a CA does not remove the need to publish status during its retention period. Deleting a key does not automatically revoke its certificates either. Plan replacement and retention before using **Delete Key**; provider deletion behavior depends on the engine.",{"_3624":2446,"_31165":2323,"_21590":58503,"_5":14857,"_28357":58198,"_3076":58504},[],"The KMS refuses to delete a key that certificates still reference, with `409` `key is in use`. Revoking a certificate or letting it expire does not release its key reference. Deleting a CA releases the references from its own current certificate and linked reissued certificates, which stay in place to back the CRL and OCSP, and then attempts to delete the key. If other certificates still reference the key, such as another CA sharing it, the KMS keeps it. The certificates the CA issued keep their own key references, even when revoked. The API lets you delete such a certificate only once its issuer CA no longer exists, and deleting it removes it from the CRL and OCSP responses, so keep revoked certificates for their retention period and delete only expired or superseded ones. The KMS also refuses to delete a key that signs the CRL of a CA whose CRL settings are still `ACTIVE`, with the same `409` `key is in use`; that reference is released when the settings are finalized, after the CA is revoked permanently or expires (see CRL). Legacy references retained by the upgrade migration are described in the upgrade guide.",{"_3624":2447,"_31165":2447,"_5":15217,"_3076":58506,"_31503":58507,"_21590":58508,"_28357":2447},"Online validation with OCSP",[50900,52412,56586,57237],[],{"_3624":2448,"_31165":2447,"_21590":58510,"_5":14857,"_28357":2447,"_3076":58511},[],"Query signed status and verify the responder’s response.",{"_3624":2449,"_31165":2447,"_5":31500,"_21590":58513,"_28357":58514,"_3076":58515},[],"/docs/platform/pki/ocsp#how-the-responder-works-in-lamassu","How the responder works in Lamassu",{"_3624":2450,"_31165":2447,"_5":31500,"_21590":58517,"_28357":58518,"_3076":58519},[],"/docs/platform/pki/ocsp#embedding-in-issued-certificates","Embedding in issued certificates",{"_3624":2451,"_31165":2447,"_5":31500,"_21590":58521,"_28357":58522,"_3076":58523},[],"/docs/platform/pki/ocsp#http-endpoints","HTTP endpoints",{"_3624":2452,"_31165":2447,"_5":31500,"_21590":58525,"_28357":58526,"_3076":58527},[],"/docs/platform/pki/ocsp#generate-and-verify-a-query","Generate and verify a query",{"_3624":2453,"_31165":2447,"_5":31500,"_21590":58529,"_28357":58530,"_3076":58531},[],"/docs/platform/pki/ocsp#check-from-the-interface","Check from the interface",{"_3624":2454,"_31165":2447,"_5":31500,"_21590":58533,"_28357":58534,"_3076":57802},[],"/docs/platform/pki/ocsp#references",{"_3624":2455,"_31165":2447,"_21590":58536,"_5":14857,"_28357":2447,"_3076":58537},[],"OCSP queries a certificate’s status and returns a signed response. This guide is for an integrator checking what Lamassu publishes and how the consumer must verify it. For complete identity validation, follow Certificate validation.",{"_3624":2456,"_31165":2447,"_21590":58539,"_5":14857,"_28357":58514,"_3076":58540},[],"The responder retrieves the certificate by serial number and locates its issuing CA in the inventory. It translates persisted status as follows:",{"_3624":2457,"_31165":2447,"_21590":58542,"_5":14857,"_28357":58514,"_3076":58543},[],"Record status",{"_3624":2458,"_31165":2447,"_21590":58545,"_5":14857,"_28357":58514,"_3076":58546},[],"Signed response",{"_3624":2459,"_31165":2447,"_21590":58548,"_5":14857,"_28357":58514,"_3076":55723},[],{"_3624":2460,"_31165":2447,"_21590":58550,"_5":14857,"_28357":58514,"_3076":58551},[],"`Good`.",{"_3624":2461,"_31165":2447,"_21590":58553,"_5":14857,"_28357":58514,"_3076":55740},[],{"_3624":2462,"_31165":2447,"_21590":58555,"_5":14857,"_28357":58514,"_3076":58556},[],"`Revoked`, with revocation reason and timestamp.",{"_3624":2463,"_31165":2447,"_21590":58558,"_5":14857,"_28357":58514,"_3076":58559},[],"Other states, including `INACTIVE` and `EXPIRED`",{"_3624":2464,"_31165":2447,"_21590":58561,"_5":14857,"_28357":58514,"_3076":58562},[],"`Unknown` if the certificate and issuer can be retrieved.",{"_3624":2465,"_31165":2447,"_21590":58564,"_5":14857,"_28357":58514,"_3076":58565},[],"An absent serial number causes a lookup error; it does not guarantee a signed `Unknown` response. Lookup or signing errors produce an HTTP failure. Treat that as unavailable evidence according to consumer policy.",{"_3624":2466,"_31165":2447,"_21590":58567,"_5":14857,"_28357":58514,"_3076":58568},[],"The issuing CA itself signs the response through its KMS-associated key. A delegated OCSP signing certificate is not used. An imported CA without a usable key cannot sign responses.",{"_3624":2467,"_31165":2447,"_21590":58570,"_5":14857,"_28357":58514,"_3076":58571},[],"The implementation sets `thisUpdate` approximately one day before response generation and `nextUpdate` one day after: the declared window is about 48 hours. Inspect received values and apply your freshness policy. The response reflects stored status when queried; a previously cached copy does not change upon revocation.",{"_3624":2468,"_31165":2447,"_21590":58573,"_5":14857,"_28357":58518,"_3076":58574},[],"The signer constructs OCSP URLs from configured VA domains and adds them to AIA. Without domains, there is no URL to add; an imported certificate retains its original extensions. Inspect the actual certificate:",{"_3624":2469,"_31165":2447,"_21590":58576,"_5":14857,"_28357":58518,"_3076":58577},[],"Check that the consumer can reach this URL. DNS, endpoint exposure and domain configuration belong to Deployment. Changing configuration does not modify already signed certificates.",{"_3624":2470,"_31165":2447,"_21590":58579,"_5":14857,"_28357":58522,"_3076":58580},[],"The service accepts:",{"_3624":2471,"_31165":2447,"_21590":58582,"_5":14857,"_28357":58522,"_3076":54352},[],{"_3624":2472,"_31165":2447,"_21590":58584,"_5":14857,"_28357":58522,"_3076":58585},[],"VA service path",{"_3624":2473,"_31165":2447,"_21590":58587,"_5":14857,"_28357":58522,"_3076":58588},[],"Format",{"_3624":2474,"_31165":2447,"_21590":58590,"_5":14857,"_28357":58522,"_3076":58591},[],"`POST`",{"_3624":2475,"_31165":2447,"_21590":58593,"_5":14857,"_28357":58522,"_3076":58594},[],"`/ocsp`",{"_3624":2476,"_31165":2447,"_21590":58596,"_5":14857,"_28357":58522,"_3076":58597},[],"DER request, `Content-Type: application/ocsp-request`.",{"_3624":2477,"_31165":2447,"_21590":58599,"_5":14857,"_28357":58522,"_3076":57986},[],{"_3624":2478,"_31165":2447,"_21590":58601,"_5":14857,"_28357":58522,"_3076":58602},[],"`/ocsp/{ocsp_request}`",{"_3624":2479,"_31165":2447,"_21590":58604,"_5":14857,"_28357":58522,"_3076":58605},[],"DER request encoded using padded URL Base64.",{"_3624":2480,"_31165":2447,"_21590":58607,"_5":14857,"_28357":58522,"_3076":58608},[],"Use POST to avoid client encoding differences. A successful response has `Content-Type: application/ocsp-response` and a DER body. The public prefix depends on the Gateway; use the URL published in the certificate and checked by the operator.",{"_3624":2481,"_31165":2447,"_21590":58610,"_5":14857,"_28357":58526,"_3076":58611},[],"You need OpenSSL 3.x, `device.crt`, its direct issuer’s certificate `issuer.pem` and the consumer’s trusted roots in `roots.pem`. For an intermediate issuer, also prepare `intermediates.pem` containing the intermediate CAs.",{"_3624":2482,"_31165":2447,"_21590":58613,"_5":14857,"_28357":58526,"_3076":58614},[],"Generate the request:",{"_3624":2483,"_31165":2447,"_21590":58616,"_5":14857,"_28357":58526,"_3076":58617},[],"This example omits the nonce because the responder does not echo it. Verification relies on signature, response correspondence and timestamps; it does not demonstrate freshness through a nonce.",{"_3624":2484,"_31165":2447,"_21590":58619,"_5":14857,"_28357":58526,"_3076":58620},[],"Replace the example URL with the inspected endpoint:",{"_3624":2485,"_31165":2447,"_21590":58622,"_5":14857,"_28357":58526,"_3076":58623},[],"Verify the returned DER:",{"_3624":2486,"_31165":2447,"_21590":58625,"_5":14857,"_28357":58526,"_3076":58626},[],"For intermediates, add `-verify_other intermediates.pem`. Require successful response verification and inspect the status corresponding to `device.crt`, issuer, serial, `thisUpdate` and `nextUpdate`. `Response verify OK` validates the response only: also observe `good`, `revoked` or `unknown`. Do not accept an identity based only on the command’s exit code.",{"_3624":2487,"_31165":2447,"_21590":58628,"_5":14857,"_28357":58530,"_3076":58629},[],"**OCSP Check** shows what Lamassu returns for a selected certificate. Complete the check from the consumer’s network and trust store: a console query does not establish its validation configuration.",{"_3624":2488,"_31165":2447,"_21590":58631,"_5":14857,"_28357":58530,"_3076":58632},[],"To check a change, save an earlier response, revoke a test certificate and request another response. The new query should reflect persisted status; compare timestamps to rule out reuse of an earlier response. If it fails, follow PKI troubleshooting.",{"_3624":2489,"_31165":2447,"_21590":58634,"_5":14857,"_28357":58534,"_3076":58635},[],"RFC 6960: OCSP.",{"_3624":2490,"_31165":2447,"_21590":58637,"_5":14857,"_28357":58534,"_3076":58638},[],"OpenSSL: openssl-ocsp.",{"_3624":2491,"_31165":2447,"_21590":58640,"_5":14857,"_28357":58534,"_3076":58641},[],"<Card title=\"CRL service\" href=\"/docs/platform/pki/crl\" />",{"_3624":2492,"_31165":2447,"_21590":58643,"_5":14857,"_28357":58534,"_3076":58112},[],{"_3624":2493,"_31165":2493,"_5":15217,"_3076":56586,"_31503":58645,"_21590":58646,"_28357":2493},[50900,52412,56586],[],{"_3624":2494,"_31165":2493,"_21590":58648,"_5":14857,"_28357":2493,"_3076":58649},[],"Administer keys and authorities, define issuance and verify the resulting certificates.",{"_3624":2495,"_31165":2493,"_5":31500,"_21590":58651,"_28357":58652,"_3076":55898},[],"/docs/platform/pki/overview#start-here",{"_3624":2496,"_31165":2493,"_5":31500,"_21590":58654,"_28357":58655,"_3076":58656},[],"/docs/platform/pki/overview#what-you-need","What you need",{"_3624":2497,"_31165":2493,"_5":31500,"_21590":58658,"_28357":58659,"_3076":56430},[],"/docs/platform/pki/overview#core-capabilities",{"_3624":2498,"_31165":2493,"_5":31500,"_21590":58661,"_28357":58662,"_3076":56434},[],"/docs/platform/pki/overview#build-your-trust-hierarchy",{"_3624":2499,"_31165":2493,"_5":31500,"_21590":58664,"_28357":58665,"_3076":56438},[],"/docs/platform/pki/overview#protect-cryptographic-keys",{"_3624":2500,"_31165":2493,"_5":31500,"_21590":58667,"_28357":58668,"_3076":56442},[],"/docs/platform/pki/overview#issue-and-control-certificates",{"_3624":2501,"_31165":2493,"_5":31500,"_21590":58670,"_28357":58671,"_3076":56450},[],"/docs/platform/pki/overview#publish-validation-status",{"_3624":2502,"_31165":2493,"_5":31500,"_21590":58673,"_28357":58674,"_3076":58675},[],"/docs/platform/pki/overview#how-to-check-the-result","How to check the result",{"_3624":2503,"_31165":2493,"_5":31500,"_21590":58677,"_28357":58678,"_3076":57404},[],"/docs/platform/pki/overview#continue",{"_3624":2504,"_31165":2493,"_21590":58680,"_5":14857,"_28357":2493,"_3076":58681},[],"The PKI section explains how to build and operate X.509 trust in Lamassu: which authorities issue, which rules apply and how to check certificates. It is intended for PKI administrators and anyone who needs to use certificates in a consuming system.",{"_3624":2505,"_31165":2493,"_21590":58683,"_5":14857,"_28357":58652,"_3076":58684},[],"Follow PKI getting started to create a CA, issue a client certificate and verify it with OpenSSL. The result is a certificate, its private key and a verified chain.",{"_3624":2506,"_31165":2493,"_21590":58686,"_5":14857,"_28357":58652,"_3076":58687},[],"You can complete that path before managing devices. When you need to associate the identity with an inventory or automate its enrollment, continue in IoT Fleets.",{"_3624":2507,"_31165":2493,"_21590":58689,"_5":14857,"_28357":58655,"_3076":58690},[],"An accessible instance and permission to manage the keys, CAs and certificates you will use.",{"_3624":2508,"_31165":2493,"_21590":58692,"_5":14857,"_28357":58655,"_3076":58693},[],"An available cryptographic engine to keep the authority's key.",{"_3624":2509,"_31165":2493,"_21590":58695,"_5":14857,"_28357":58655,"_3076":58696},[],"The certificate's purpose, such as authenticating a client through mTLS.",{"_3624":2510,"_31165":2493,"_21590":58698,"_5":14857,"_28357":58655,"_3076":58699},[],"Consumer requirements: accepted issuers, algorithms, names and permitted usages.",{"_3624":2511,"_31165":2493,"_21590":58701,"_5":14857,"_28357":58655,"_3076":58702},[],"Prepare the instance and cryptographic provider in Deployment. The trust model explains hierarchy choices.",{"_3624":2512,"_31165":2493,"_21590":58704,"_5":14857,"_28357":58662,"_3076":58705},[],"Authorities sign certificates. A root establishes the trust anchor, and an intermediate separates issuance by environment or purpose. Hierarchy and rotation explains how to maintain trust when replacing an authority.",{"_3624":2513,"_31165":2493,"_21590":58707,"_5":14857,"_28357":58665,"_3076":58708},[],"CA signing keys are managed through KMS and cryptographic engines. A client that generates a CSR can keep its own key: preserve that custody when choosing the issuance method.",{"_3624":2514,"_31165":2493,"_21590":58710,"_5":14857,"_28357":58668,"_3076":58711},[],"A profile establishes subject, validity, usage and key restrictions. The CA applies issuance configuration and signs the certificate. In the inventory, you can inspect the result, download it and manage its status.",{"_3624":2515,"_31165":2493,"_21590":58713,"_5":14857,"_28357":58671,"_3076":58714},[],"Validation covers the chain, validity, usages and revocation status. Lamassu publishes status through OCSP and CRL; the consumer configures which issuers it recognizes and how it checks that status.",{"_3624":2516,"_31165":2493,"_21590":58716,"_5":14857,"_28357":58674,"_3076":58717},[],"An active certificate in the console is one part of the check. Also verify that:",{"_3624":2517,"_31165":2493,"_21590":58719,"_5":14857,"_28357":58674,"_3076":58720},[],"its subject and extensions identify the expected client;",{"_3624":2518,"_31165":2493,"_21590":58722,"_5":14857,"_28357":58674,"_3076":58723},[],"its public key matches the client's private key;",{"_3624":2519,"_31165":2493,"_21590":58725,"_5":14857,"_28357":58674,"_3076":58726},[],"its chain reaches a root trusted by the consumer;",{"_3624":2520,"_31165":2493,"_21590":58728,"_5":14857,"_28357":58674,"_3076":58729},[],"its dates and usages allow the operation;",{"_3624":2521,"_31165":2493,"_21590":58731,"_5":14857,"_28357":58674,"_3076":58732},[],"the consumer applies revocation checks and authorization.",{"_3624":2522,"_31165":2493,"_21590":58734,"_5":14857,"_28357":58674,"_3076":58735},[],"The issuance path includes the first independent checks.",{"_3624":2523,"_31165":2493,"_21590":58737,"_5":14857,"_28357":58678,"_3076":58738},[],"<Card title=\"PKI getting started\" description=\"Create a CA, then issue and verify a client certificate.\" href=\"/docs/platform/pki/quickstarts/overview\" />",{"_3624":2524,"_31165":2493,"_21590":58740,"_5":14857,"_28357":58678,"_3076":58741},[],"<Card title=\"Apply PKI to devices\" description=\"Associate certificates with inventory and prepare enrollment.\" href=\"/docs/platform/iot-fleets/overview\" />",{"_3624":2525,"_31165":2493,"_21590":58743,"_5":14857,"_28357":58678,"_3076":58744},[],"<Card title=\"PKI diagnostics\" description=\"Check issuance, OCSP and CRL when the result fails.\" href=\"/docs/platform/pki/troubleshooting\" />",{"_3624":2526,"_31165":2526,"_5":15217,"_3076":58746,"_31503":58747,"_21590":58748,"_28357":2526},"Create your first CA",[50900,52412,56586,56023],[],{"_3624":2527,"_31165":2526,"_21590":58750,"_5":14857,"_28357":2526,"_3076":58751},[],"Create an evaluation root and check its certificate before issuing.",{"_3624":2528,"_31165":2526,"_5":31500,"_21590":58753,"_28357":58754,"_3076":50910},[],"/docs/platform/pki/quickstarts/create-certificate-authority#before-you-begin",{"_3624":2529,"_31165":2526,"_5":31500,"_21590":58756,"_28357":58757,"_3076":58758},[],"/docs/platform/pki/quickstarts/create-certificate-authority#open-the-creation-wizard-toc","Open the creation wizard [!toc]",{"_3624":2530,"_31165":2526,"_5":31500,"_21590":58760,"_28357":58761,"_3076":58762},[],"/docs/platform/pki/quickstarts/create-certificate-authority#select-the-key-toc","Select the key [!toc]",{"_3624":2531,"_31165":2526,"_5":31500,"_21590":58764,"_28357":58765,"_3076":58766},[],"/docs/platform/pki/quickstarts/create-certificate-authority#define-the-authority-toc","Define the authority [!toc]",{"_3624":2532,"_31165":2526,"_5":31500,"_21590":58768,"_28357":58769,"_3076":58770},[],"/docs/platform/pki/quickstarts/create-certificate-authority#review-and-create-the-ca-toc","Review and create the CA [!toc]",{"_3624":2533,"_31165":2526,"_5":31500,"_21590":58772,"_28357":58773,"_3076":58774},[],"/docs/platform/pki/quickstarts/create-certificate-authority#verify-the-result-toc","Verify the result [!toc]",{"_3624":2534,"_31165":2526,"_5":31500,"_21590":58776,"_28357":58777,"_3076":58778},[],"/docs/platform/pki/quickstarts/create-certificate-authority#check-the-ca-certificate","Check the CA certificate",{"_3624":2535,"_31165":2526,"_5":31500,"_21590":58780,"_28357":58781,"_3076":56280},[],"/docs/platform/pki/quickstarts/create-certificate-authority#if-the-result-fails",{"_3624":2536,"_31165":2526,"_5":31500,"_21590":58783,"_28357":58784,"_3076":50934},[],"/docs/platform/pki/quickstarts/create-certificate-authority#next-step",{"_3624":2537,"_31165":2526,"_21590":58786,"_5":14857,"_28357":2526,"_3076":58787},[],"You will create a root authority with a new key kept by a Lamassu engine. The result is an active CA and its public certificate in `ca.pem`, ready to verify issuance in the next path.",{"_3624":2538,"_31165":2526,"_21590":58789,"_5":14857,"_28357":58754,"_3076":58790},[],"Console access and permission to create keys and authorities.",{"_3624":2539,"_31165":2526,"_21590":58792,"_5":14857,"_28357":58754,"_3076":58793},[],"An available cryptographic engine that supports the chosen algorithm.",{"_3624":2540,"_31165":2526,"_21590":58795,"_5":14857,"_28357":58754,"_3076":58796},[],"OpenSSL 3.x to check the downloaded certificate.",{"_3624":2541,"_31165":2526,"_21590":58798,"_5":14857,"_28357":58754,"_3076":58799},[],"Use an evaluation instance or an authority intended for these tests. The example creates a root that issues directly; to design an operational hierarchy, see Hierarchy and rotation.",{"_3624":2542,"_31165":2526,"_21590":58801,"_5":14857,"_28357":58757,"_3076":58802},[],"In **Certification Authorities**, select **Create New CA** and choose to create a CA with a new key pair.",{"_3624":2543,"_31165":2526,"_21590":58804,"_5":14857,"_28357":58757,"_3076":58805},[],"The &#x2A;*Create New CA (Existing Key)** flow is explained in the authorities guide.",{"_3624":2544,"_31165":2526,"_21590":58807,"_5":14857,"_28357":58761,"_3076":58808},[],"Choose the engine that will keep the key and an algorithm its capabilities allow. For this example, you can use **EC P-384** if available.",{"_3624":2545,"_31165":2526,"_21590":58810,"_5":14857,"_28357":58761,"_3076":58811},[],"The CA private key is used through the engine. In this path, you will download only the authority's public certificate.",{"_3624":2546,"_31165":2526,"_21590":58813,"_5":14857,"_28357":58765,"_3076":58814},[],"Select **Root CA** and complete:",{"_3624":2547,"_31165":2526,"_21590":58816,"_5":14857,"_28357":58765,"_3076":58817},[],"**CA Name**: `Acme Evaluation Root CA`.",{"_3624":2548,"_31165":2526,"_21590":58819,"_5":14857,"_28357":58765,"_3076":58820},[],"**Subject**: organization and country details for your evaluation.",{"_3624":2549,"_31165":2526,"_21590":58822,"_5":14857,"_28357":58765,"_3076":58823},[],"**CA Certificate Expiration**: for example, one year from creation.",{"_3624":2550,"_31165":2526,"_21590":58825,"_5":14857,"_28357":58765,"_3076":58826},[],"**Default End-Entity Certificate Issuance Expiration**: for example, 90 days, within the CA's lifetime.",{"_3624":2551,"_31165":2526,"_21590":58828,"_5":14857,"_28357":58765,"_3076":58829},[],"The CA name becomes its `Common Name`. Keep the CA usages needed to sign certificates and CRLs.",{"_3624":2552,"_31165":2526,"_21590":58831,"_5":14857,"_28357":58769,"_3076":58832},[],"Check the engine, algorithm, subject, root type and dates. Confirm creation and note the authority identifier so you can recognize it in the DMS or API.",{"_3624":2553,"_31165":2526,"_21590":58834,"_5":14857,"_28357":58773,"_3076":58835},[],"Open the new CA. It should appear active, show its certificate and allow access to **Issued Certificates**.",{"_3624":2554,"_31165":2526,"_21590":58837,"_5":14857,"_28357":58773,"_3076":58838},[],"Download or copy the authority's PEM certificate and save it as `ca.pem`. Check that the file contains the complete block, including `BEGIN CERTIFICATE` and `END CERTIFICATE`.",{"_3624":2555,"_31165":2526,"_21590":58840,"_5":14857,"_28357":58777,"_3076":58841},[],"Run from the directory where you saved `ca.pem`:",{"_3624":2556,"_31165":2526,"_21590":58843,"_5":14857,"_28357":58777,"_3076":58844},[],"Check that the subject and issuer match the root you created, the dates include the current time, **Basic Constraints** contains `CA:TRUE` and **Key Usage** allows certificate signing. The last command should return `ca.pem: OK`.",{"_3624":2557,"_31165":2526,"_21590":58846,"_5":14857,"_28357":58777,"_3076":58847},[],"You explicitly selected `ca.pem` as the trust anchor for this test. A valid self-signature does not install that trust in other consumers. See the openssl-verify reference for verification options.",{"_3624":2558,"_31165":2526,"_21590":58849,"_5":14857,"_28357":58781,"_3076":58850},[],"If creation fails, check permissions, engine availability and the selected algorithm.",{"_3624":2559,"_31165":2526,"_21590":58852,"_5":14857,"_28357":58781,"_3076":58853},[],"If OpenSSL cannot read the file, copy the complete PEM block again.",{"_3624":2560,"_31165":2526,"_21590":58855,"_5":14857,"_28357":58781,"_3076":58856},[],"If signature or date checks fail, check that you downloaded this CA's certificate and that your computer's clock is correct.",{"_3624":2561,"_31165":2526,"_21590":58858,"_5":14857,"_28357":58781,"_3076":58859},[],"PKI diagnostics covers issuance checks and cryptographic dependencies.",{"_3624":2562,"_31165":2526,"_21590":58861,"_5":14857,"_28357":58784,"_3076":58862},[],"Continue with Issue and verify a certificate, using this authority and `ca.pem`.",{"_3624":2563,"_31165":2563,"_5":15217,"_3076":58864,"_31503":58865,"_21590":58866,"_28357":2563},"Issue and verify a certificate",[50900,52412,56586,56023],[],{"_3624":2564,"_31165":2563,"_21590":58868,"_5":14857,"_28357":2563,"_3076":58869},[],"Issue a client certificate and check content, chain and key correspondence.",{"_3624":2565,"_31165":2563,"_5":31500,"_21590":58871,"_28357":58872,"_3076":50910},[],"/docs/platform/pki/quickstarts/issue-certificate#before-you-begin",{"_3624":2566,"_31165":2563,"_5":31500,"_21590":58874,"_28357":58875,"_3076":58876},[],"/docs/platform/pki/quickstarts/issue-certificate#start-the-issuance","Start the issuance",{"_3624":2567,"_31165":2563,"_5":31500,"_21590":58878,"_28357":58879,"_3076":58880},[],"/docs/platform/pki/quickstarts/issue-certificate#choose-the-method","Choose the method",{"_3624":2568,"_31165":2563,"_5":31500,"_21590":58882,"_28357":58883,"_3076":58884},[],"/docs/platform/pki/quickstarts/issue-certificate#identify-the-certificate","Identify the certificate",{"_3624":2569,"_31165":2563,"_5":31500,"_21590":58886,"_28357":58887,"_3076":58888},[],"/docs/platform/pki/quickstarts/issue-certificate#configure-key-and-uses","Configure key and uses",{"_3624":2570,"_31165":2563,"_5":31500,"_21590":58890,"_28357":58891,"_3076":58892},[],"/docs/platform/pki/quickstarts/issue-certificate#issue-and-download","Issue and download",{"_3624":2571,"_31165":2563,"_5":31500,"_21590":58894,"_28357":58895,"_3076":58896},[],"/docs/platform/pki/quickstarts/issue-certificate#verify-the-result","Verify the result",{"_3624":2572,"_31165":2563,"_5":31500,"_21590":58898,"_28357":58899,"_3076":58900},[],"/docs/platform/pki/quickstarts/issue-certificate#inspect-content-and-dates","Inspect content and dates",{"_3624":2573,"_31165":2563,"_5":31500,"_21590":58902,"_28357":58903,"_3076":58904},[],"/docs/platform/pki/quickstarts/issue-certificate#verify-the-chain","Verify the chain",{"_3624":2574,"_31165":2563,"_5":31500,"_21590":58906,"_28357":58907,"_3076":58908},[],"/docs/platform/pki/quickstarts/issue-certificate#check-that-the-key-matches","Check that the key matches",{"_3624":2575,"_31165":2563,"_5":31500,"_21590":58910,"_28357":58911,"_3076":56280},[],"/docs/platform/pki/quickstarts/issue-certificate#if-the-result-fails",{"_3624":2576,"_31165":2563,"_5":31500,"_21590":58913,"_28357":58914,"_3076":50934},[],"/docs/platform/pki/quickstarts/issue-certificate#next-step",{"_3624":2577,"_31165":2563,"_21590":58916,"_5":14857,"_28357":2563,"_3076":58917},[],"You will issue an end-entity certificate for `device-001` using browser key and CSR generation. The result is `device.crt`, `device.key` and the issuing root's public certificate, `ca.pem`.",{"_3624":2578,"_31165":2563,"_21590":58919,"_5":14857,"_28357":58872,"_3076":58920},[],"An active root CA with an available signing key and permission to issue. If one does not exist yet, follow Create your first CA.",{"_3624":2579,"_31165":2563,"_21590":58922,"_5":14857,"_28357":58872,"_3076":58923},[],"Its public certificate in `ca.pem`; this example uses the root created in the previous path.",{"_3624":2580,"_31165":2563,"_21590":58925,"_5":14857,"_28357":58872,"_3076":58926},[],"OpenSSL 3.x and a working directory with restricted access.",{"_3624":2581,"_31165":2563,"_21590":58928,"_5":14857,"_28357":58872,"_3076":58929},[],"A client identifier: here we use `device-001`.",{"_3624":2582,"_31165":2563,"_21590":58931,"_5":14857,"_28357":58872,"_3076":58932},[],"In this flow, the client's key is generated in the browser and must be downloaded when issuance finishes. If you lose it, you must generate a key and issue another certificate. The certificate inventory lets you download the public certificate, but cannot recover this key.",{"_3624":2583,"_31165":2563,"_21590":58934,"_5":14857,"_28357":58875,"_3076":58935},[],"Open the CA from the previous path, go to **Issued Certificates** and select **Issue New**.",{"_3624":2584,"_31165":2563,"_21590":58937,"_5":14857,"_28357":58879,"_3076":58938},[],"Select **Generate Key & CSR in Browser** to follow this example.",{"_3624":2585,"_31165":2563,"_21590":58940,"_5":14857,"_28357":58879,"_3076":58941},[],"If the key must be generated and kept on the destination system, use **Upload Existing CSR**, described in the authorities guide.",{"_3624":2586,"_31165":2563,"_21590":58943,"_5":14857,"_28357":58883,"_3076":58944},[],"Enter `device-001` as the `Common Name`. Add subject details required by your policy and SANs if the consumer uses them to identify the client.",{"_3624":2587,"_31165":2563,"_21590":58946,"_5":14857,"_28357":58883,"_3076":58947},[],"If you continue with manual registration, the `Device ID` will be exactly `device-001`.",{"_3624":2588,"_31165":2563,"_21590":58949,"_5":14857,"_28357":58887,"_3076":58950},[],"Choose an algorithm and size allowed by the profile; for example, ECDSA P-256 if permitted. For this client certificate, select **Digital Signature** and **Client Authentication**, and issue it as an end-entity certificate.",{"_3624":2589,"_31165":2563,"_21590":58952,"_5":14857,"_28357":58887,"_3076":58953},[],"Request, for example, 30 days of validity, always within the CA's lifetime. Review the issuance profile if the resulting content differs from the request.",{"_3624":2590,"_31165":2563,"_21590":58955,"_5":14857,"_28357":58891,"_3076":58956},[],"Confirm issuance. Save the PEM certificate as `device.crt` and the private key as `device.key` in your prepared directory.",{"_3624":2591,"_31165":2563,"_21590":58958,"_5":14857,"_28357":58895,"_3076":58959},[],"Check in **Issued Certificates** that the certificate appears active. Note its serial number and verify the downloaded material using the checks below.",{"_3624":2592,"_31165":2563,"_21590":58961,"_5":14857,"_28357":58899,"_3076":58962},[],"Check `CN=device-001`, the expected issuer, current validity, **Digital Signature** and the extended usage **TLS Web Client Authentication**. It must be an end-entity certificate: it must not declare `CA:TRUE` or enable **Certificate Sign**. If **Basic Constraints** is present, it must indicate `CA:FALSE`. If you requested SANs, check that the expected identifiers appear in the certificate.",{"_3624":2593,"_31165":2563,"_21590":58964,"_5":14857,"_28357":58903,"_3076":58965},[],"The expected result is `device.crt: OK`. This check uses your explicit root and evaluates the chain, dates and compatibility with the TLS client purpose. Also check for the expected usages and names through the inspection above.",{"_3624":2594,"_31165":2563,"_21590":58967,"_5":14857,"_28357":58903,"_3076":58968},[],"If you use an intermediate CA, the trusted root must be in `ca.pem` and you must supply the intermediates with `-untrusted intermediates.pem`. This variant is covered in the trust model.",{"_3624":2595,"_31165":2563,"_21590":58970,"_5":14857,"_28357":58903,"_3076":58971},[],"The command does not query OCSP or CRL. For revocation checks, continue with Certificate validation. See the openssl-verify reference for its options.",{"_3624":2596,"_31165":2563,"_21590":58973,"_5":14857,"_28357":58907,"_3076":58974},[],"In Bash, compare the two public-key digests:",{"_3624":2597,"_31165":2563,"_21590":58976,"_5":14857,"_28357":58907,"_3076":58977},[],"Both commands must finish successfully and show the same SHA-256 digest. If they differ, the private key does not match the selected certificate. Find the correct pair before installing it.",{"_3624":2598,"_31165":2563,"_21590":58979,"_5":14857,"_28357":58907,"_3076":58980},[],"The options used are documented in openssl-x509 and openssl-pkey.",{"_3624":2599,"_31165":2563,"_21590":58982,"_5":14857,"_28357":58911,"_3076":56364},[],{"_3624":2600,"_31165":2563,"_21590":58984,"_5":14857,"_28357":58911,"_3076":58985},[],"What to review",{"_3624":2601,"_31165":2563,"_21590":58987,"_5":14857,"_28357":58911,"_3076":58988},[],"The CA rejects issuance",{"_3624":2602,"_31165":2563,"_21590":58990,"_5":14857,"_28357":58911,"_3076":58991},[],"Permissions, CA state and key, algorithm and profile.",{"_3624":2603,"_31165":2563,"_21590":58993,"_5":14857,"_28357":58911,"_3076":58994},[],"Different subject or usages",{"_3624":2604,"_31165":2563,"_21590":58996,"_5":14857,"_28357":58911,"_3076":58997},[],"Applied profile and requested values.",{"_3624":2605,"_31165":2563,"_21590":58999,"_5":14857,"_28357":58911,"_3076":59000},[],"Issuer cannot be found",{"_3624":2606,"_31165":2563,"_21590":59002,"_5":14857,"_28357":58911,"_3076":59003},[],"Downloaded CA and required intermediate chain.",{"_3624":2607,"_31165":2563,"_21590":59005,"_5":14857,"_28357":58911,"_3076":59006},[],"Validity fails",{"_3624":2608,"_31165":2563,"_21590":59008,"_5":14857,"_28357":58911,"_3076":59009},[],"Certificate and CA dates, and the computer's clock.",{"_3624":2609,"_31165":2563,"_21590":59011,"_5":14857,"_28357":58911,"_3076":59012},[],"Public-key digests differ",{"_3624":2610,"_31165":2563,"_21590":59014,"_5":14857,"_28357":58911,"_3076":59015},[],"Certificate and key files from the same issuance.",{"_3624":2611,"_31165":2563,"_21590":59017,"_5":14857,"_28357":58911,"_3076":59018},[],"See PKI diagnostics to narrow an issuance failure.",{"_3624":2612,"_31165":2563,"_21590":59020,"_5":14857,"_28357":58914,"_3076":59021},[],"You have completed the PKI path when the certificate verifies and the key matches. Choose how to use it:",{"_3624":2613,"_31165":2563,"_21590":59023,"_5":14857,"_28357":58914,"_3076":59024},[],"Manage certificates for inspection, status and revocation.",{"_3624":2614,"_31165":2563,"_21590":59026,"_5":14857,"_28357":58914,"_3076":59027},[],"Register a device manually to associate this identity with Lamassu's inventory.",{"_3624":2615,"_31165":2563,"_21590":59029,"_5":14857,"_28357":58914,"_3076":59030},[],"Prepare EST for the device to request its next identities.",{"_3624":2616,"_31165":2563,"_21590":59032,"_5":14857,"_28357":58914,"_3076":59033},[],"Acceptance by a consumer requires configuring its trust, revocation checks and permissions granted to the identity.",{"_3624":2617,"_31165":2617,"_5":15217,"_3076":59035,"_31503":59036,"_21590":59037,"_28357":2617},"PKI getting started",[50900,52412,56586,56023],[],{"_3624":2618,"_31165":2617,"_21590":59039,"_5":14857,"_28357":2617,"_3076":59040},[],"Create a CA, issue a client certificate and check its chain and key.",{"_3624":2619,"_31165":2617,"_5":31500,"_21590":59042,"_28357":59043,"_3076":50910},[],"/docs/platform/pki/quickstarts/overview#before-you-begin",{"_3624":2620,"_31165":2617,"_5":31500,"_21590":59045,"_28357":59046,"_3076":59047},[],"/docs/platform/pki/quickstarts/overview#recommended-path","Recommended path",{"_3624":2621,"_31165":2617,"_5":31500,"_21590":59049,"_28357":59050,"_3076":56215},[],"/docs/platform/pki/quickstarts/overview#expected-result",{"_3624":2622,"_31165":2617,"_5":31500,"_21590":59052,"_28357":59053,"_3076":59054},[],"/docs/platform/pki/quickstarts/overview#continue-according-to-your-goal","Continue according to your goal",{"_3624":2623,"_31165":2617,"_21590":59056,"_5":14857,"_28357":2617,"_3076":59057},[],"This path is intended for those starting to administer PKI or needing a first X.509 client identity. It ends with three files: a root CA certificate, an end-entity certificate and the client's private key.",{"_3624":2624,"_31165":2617,"_21590":59059,"_5":14857,"_28357":59043,"_3076":59060},[],"A Lamassu instance accessible from your browser. To prepare one, see Deployment.",{"_3624":2625,"_31165":2617,"_21590":59062,"_5":14857,"_28357":59043,"_3076":59063},[],"Permission to manage keys, authorities and issuance. See Access control if an operation is blocked.",{"_3624":2626,"_31165":2617,"_21590":59065,"_5":14857,"_28357":59043,"_3076":59066},[],"An available cryptographic engine for the CA key; check the keys and engines inventory.",{"_3624":2627,"_31165":2617,"_21590":59068,"_5":14857,"_28357":59043,"_3076":59069},[],"OpenSSL 3.x on the computer where you will verify the files.",{"_3624":2628,"_31165":2617,"_21590":59071,"_5":14857,"_28357":59043,"_3076":59072},[],"A working directory with restricted access for the downloaded key.",{"_3624":2629,"_31165":2617,"_21590":59074,"_5":14857,"_28357":59046,"_3076":59075},[],"<Card title=\"1. Create your first CA\" description=\"Create an evaluation root and save its public certificate as ca.pem.\" href=\"/docs/platform/pki/quickstarts/create-certificate-authority\" />",{"_3624":2630,"_31165":2617,"_21590":59077,"_5":14857,"_28357":59046,"_3076":59078},[],"<Card title=\"2. Issue and verify a certificate\" description=\"Issue for device-001 and check content, chain and key correspondence.\" href=\"/docs/platform/pki/quickstarts/issue-certificate\" />",{"_3624":2631,"_31165":2617,"_21590":59080,"_5":14857,"_28357":59046,"_3076":59081},[],"We use `Acme Evaluation Root CA` and `device-001` as example names. If you replace them, keep the same client identifier in the steps you want to connect.",{"_3624":2632,"_31165":2617,"_21590":59083,"_5":14857,"_28357":59046,"_3076":59084},[],"The root in this path signs the end-entity certificate directly to simplify evaluation. Before designing an operational PKI, review the trust model and CA hierarchy.",{"_3624":2633,"_31165":2617,"_21590":59086,"_5":14857,"_28357":59050,"_3076":59087},[],"File or resource",{"_3624":2634,"_31165":2617,"_21590":59089,"_5":14857,"_28357":59050,"_3076":56212},[],{"_3624":2635,"_31165":2617,"_21590":59091,"_5":14857,"_28357":59050,"_3076":59092},[],"Active root CA and `ca.pem`",{"_3624":2636,"_31165":2617,"_21590":59094,"_5":14857,"_28357":59050,"_3076":59095},[],"It is a CA certificate, is currently valid and its self-signature verifies.",{"_3624":2637,"_31165":2617,"_21590":59097,"_5":14857,"_28357":59050,"_3076":59098},[],"End-entity certificate and `device.crt`",{"_3624":2638,"_31165":2617,"_21590":59100,"_5":14857,"_28357":59050,"_3076":59101},[],"It identifies `device-001`, supports client authentication and verifies against `ca.pem`.",{"_3624":2639,"_31165":2617,"_21590":59103,"_5":14857,"_28357":59050,"_3076":59104},[],"Private key `device.key`",{"_3624":2640,"_31165":2617,"_21590":59106,"_5":14857,"_28357":59050,"_3076":59107},[],"Its public key matches the one included in `device.crt`.",{"_3624":2641,"_31165":2617,"_21590":59109,"_5":14857,"_28357":59050,"_3076":59110},[],"These checks validate the issued material. Acceptance by a service also requires its trust, authorization and revocation configuration.",{"_3624":2642,"_31165":2617,"_21590":59112,"_5":14857,"_28357":59053,"_3076":59113},[],"To operate certificates, continue with Certificates and Validation.",{"_3624":2643,"_31165":2617,"_21590":59115,"_5":14857,"_28357":59053,"_3076":59116},[],"To manage a device identity in Lamassu, follow Manual registration. That path includes DMS preparation.",{"_3624":2644,"_31165":2617,"_21590":59118,"_5":14857,"_28357":59053,"_3076":59119},[],"For the device to request its certificate, prepare the DMS and EST client.",{"_3624":2645,"_31165":2645,"_5":15217,"_3076":59121,"_31503":59122,"_21590":59123,"_28357":2645},"PKI troubleshooting",[50900,52412,56586,55161],[],{"_3624":2646,"_31165":2645,"_21590":59125,"_5":14857,"_28357":2645,"_3076":59126},[],"Diagnose certificate issuance, OCSP and CRL.",{"_3624":2647,"_31165":2645,"_5":31500,"_21590":59128,"_28357":59129,"_3076":59130},[],"/docs/platform/pki/troubleshooting#issuance-fails","Issuance fails",{"_3624":2648,"_31165":2645,"_5":31500,"_21590":59132,"_28357":59133,"_3076":59134},[],"/docs/platform/pki/troubleshooting#ocsp-or-crl-do-not-reflect-a-change","OCSP or CRL do not reflect a change",{"_3624":2649,"_31165":2645,"_5":31500,"_21590":59136,"_28357":59137,"_3076":59138},[],"/docs/platform/pki/troubleshooting#the-chain-validates-but-the-connection-fails","The chain validates but the connection fails",{"_3624":2650,"_31165":2645,"_21590":59140,"_5":14857,"_28357":2645,"_3076":59141},[],"This guide helps a PKI operator locate issuance and status publication failures. Keep the Lamassu version, operation, CA, issuer, serial, time and returned error. Do not include private keys or tokens in diagnostics.",{"_3624":2651,"_31165":2645,"_21590":59143,"_5":14857,"_28357":2645,"_3076":59144},[],"For Gateway, sign-in, pods, dependencies and messaging, see Deployment troubleshooting. For device enrollment, see EST diagnostics.",{"_3624":2652,"_31165":2645,"_21590":59146,"_5":14857,"_28357":59129,"_3076":56212},[],{"_3624":2653,"_31165":2645,"_21590":59148,"_5":14857,"_28357":59129,"_3076":59149},[],"What to inspect",{"_3624":2654,"_31165":2645,"_21590":59151,"_5":14857,"_28357":59129,"_3076":50934},[],{"_3624":2655,"_31165":2645,"_21590":59153,"_5":14857,"_28357":59129,"_3076":55428},[],{"_3624":2656,"_31165":2645,"_21590":59155,"_5":14857,"_28357":59129,"_3076":59156},[],"Exists, is active and has usable dates.",{"_3624":2657,"_31165":2645,"_21590":59158,"_5":14857,"_28357":59129,"_3076":59159},[],"Authorities.",{"_3624":2658,"_31165":2645,"_21590":59161,"_5":14857,"_28357":59129,"_3076":59162},[],"Key",{"_3624":2659,"_31165":2645,"_21590":59164,"_5":14857,"_28357":59129,"_3076":59165},[],"The record has a usable private key and the engine can sign.",{"_3624":2660,"_31165":2645,"_21590":59167,"_5":14857,"_28357":59129,"_3076":59168},[],"Try **Sign / Verify** in KMS; check provider permissions and availability.",{"_3624":2661,"_31165":2645,"_21590":59170,"_5":14857,"_28357":59129,"_3076":59171},[],"CSR",{"_3624":2662,"_31165":2645,"_21590":59173,"_5":14857,"_28357":59129,"_3076":59174},[],"Correct PEM and verifiable signature.",{"_3624":2663,"_31165":2645,"_21590":59176,"_5":14857,"_28357":59129,"_3076":59177},[],"`openssl req -in request.csr -noout -verify -text`.",{"_3624":2664,"_31165":2645,"_21590":59179,"_5":14857,"_28357":59129,"_3076":59180},[],"Profile",{"_3624":2665,"_31165":2645,"_21590":59182,"_5":14857,"_28357":59129,"_3076":59183},[],"Selected source, existing ID, allowed algorithm and size.",{"_3624":2666,"_31165":2645,"_21590":59185,"_5":14857,"_28357":59129,"_3076":59186},[],"Check Profiles precedence; CA and DMS resolve differently.",{"_3624":2667,"_31165":2645,"_21590":59188,"_5":14857,"_28357":59129,"_3076":56364},[],{"_3624":2668,"_31165":2645,"_21590":59190,"_5":14857,"_28357":59129,"_3076":59191},[],"Appropriate subject, SAN, usages and dates.",{"_3624":2669,"_31165":2645,"_21590":59193,"_5":14857,"_28357":59129,"_3076":59194},[],"Compare CSR, profile and certificate; successful issuance does not establish consumer acceptance.",{"_3624":2670,"_31165":2645,"_21590":59196,"_5":14857,"_28357":59129,"_3076":59197},[],"For unexpected certificate fields, review `Honor Subject`, `Honor Key Usage`, `Honor Extended Key Usages` and `Honor Extensions`. The latter preserves SAN only, without validating entitlement to those names. Validity is not automatically clamped to CA expiration.",{"_3624":2671,"_31165":2645,"_21590":59199,"_5":14857,"_28357":59129,"_3076":59200},[],"If issuance fails with `400` and `CA Status inconsistent`, the issuing CA is not `ACTIVE` or is outside the validity period of its certificate. The stored status can lag behind the dates until the expiration monitor runs, so check the dates too. Reissue the CA while it is still valid, or issue from another CA.",{"_3624":2672,"_31165":2645,"_21590":59202,"_5":14857,"_28357":59129,"_3076":59203},[],"For CA reissuance failures, check revocation and date: reissuance is not supported for a revoked or already expired CA. For a subordinate CA, also check the status and dates of its parent. To change its key, use Hierarchy and rotation.",{"_3624":2673,"_31165":2645,"_21590":59205,"_5":14857,"_28357":59133,"_3076":59206},[],"Check each boundary independently:",{"_3624":2674,"_31165":2645,"_21590":59208,"_5":14857,"_28357":59133,"_3076":59209},[],"**Record:** read the correct certificate again by serial and issuer. Confirm status, reason and time; expired or permanently revoked records reject further transitions.",{"_3624":2675,"_31165":2645,"_21590":59211,"_5":14857,"_28357":59133,"_3076":59212},[],"**Endpoint:** inspect AIA and CDP. Query those URLs from the consumer’s network; an old route or incorrect issuer can explain a discrepancy.",{"_3624":2676,"_31165":2645,"_21590":59214,"_5":14857,"_28357":59133,"_3076":59215},[],"**OCSP:** save a fresh response, verify signature and timestamps, and observe status. An HTTP error for an absent serial does not mean `Good` or guarantee a signed `Unknown`.",{"_3624":2677,"_31165":2645,"_21590":59217,"_5":14857,"_28357":59133,"_3076":59218},[],"**CRL:** compare `latest_crl`, number and timestamps with the downloaded list. Check the serial in its contents. If unchanged, review `regenerate_on_revoke`, event delivery, jobs, signing and storage with the deployment operator.",{"_3624":2678,"_31165":2645,"_21590":59220,"_5":14857,"_28357":59133,"_3076":59221},[],"**Client:** check cache, policy for expired or unavailable evidence, critical IDP extension and rejection of a new connection.",{"_3624":2679,"_31165":2645,"_21590":59223,"_5":14857,"_28357":59133,"_3076":59224},[],"Reactivation from `CertificateHold` needs a new CRL for the client to stop seeing the hold. A hold cascaded from a CA is lifted by releasing that CA; a cascade from a CA revoked for good is not. Inspect every status and individual operation failure.",{"_3624":2680,"_31165":2645,"_21590":59226,"_5":14857,"_28357":59137,"_3076":59227},[],"Check expected identity, SAN, KU/EKU, matching key, presented intermediates and consumer permissions. Distinguish server TLS trust, client authentication and action authorization. Follow Validation for positive and rejection tests.",{"_3624":2681,"_31165":2645,"_21590":59229,"_5":14857,"_28357":59137,"_3076":59230},[],"When escalating a problem, provide identifiers, error and relevant public evidence, including query timestamps and version. This distinguishes issuance, publication and consumer application failures.",{"_3624":2682,"_31165":2682,"_5":15217,"_3076":59232,"_31503":59233,"_21590":59234,"_28357":2682},"Security",[50900],[],{"_3624":2683,"_31165":2682,"_21590":59236,"_5":14857,"_28357":2682,"_3076":59237},[],"How to report a security vulnerability in Lamassu privately, what to include in a report and which releases receive security fixes.",{"_3624":2684,"_31165":2682,"_5":31500,"_21590":59239,"_28357":59240,"_3076":59241},[],"/docs/security#report-a-vulnerability","Report a vulnerability",{"_3624":2685,"_31165":2682,"_5":31500,"_21590":59243,"_28357":59244,"_3076":59245},[],"/docs/security#what-to-include-in-a-report","What to include in a report",{"_3624":2686,"_31165":2682,"_5":31500,"_21590":59247,"_28357":59248,"_3076":59249},[],"/docs/security#supported-versions","Supported versions",{"_3624":2687,"_31165":2682,"_5":31500,"_21590":59251,"_28357":59252,"_3076":59253},[],"/docs/security#responsible-disclosure","Responsible disclosure",{"_3624":2688,"_31165":2682,"_21590":59255,"_5":14857,"_28357":2682,"_3076":59256},[],"Found a security vulnerability in lamassuiot, lamassu-dashboard, or lamassu-helm? This page explains how to report it privately, what to include in your report and which releases receive security fixes.",{"_3624":2689,"_31165":2682,"_21590":59258,"_5":14857,"_28357":59240,"_3076":59259},[],"Do not report security vulnerabilities through public GitHub issues, discussions, or pull requests. Public reports disclose the problem before maintainers can fix it.",{"_3624":2690,"_31165":2682,"_21590":59261,"_5":14857,"_28357":59240,"_3076":59262},[],"Instead, report privately using GitHub Security Advisories for the affected repository:",{"_3624":2691,"_31165":2682,"_21590":59264,"_5":14857,"_28357":59240,"_3076":15496},[],{"_3624":2692,"_31165":2682,"_21590":59266,"_5":14857,"_28357":59240,"_3076":15425},[],{"_3624":2693,"_31165":2682,"_21590":59268,"_5":14857,"_28357":59240,"_3076":15483},[],{"_3624":2694,"_31165":2682,"_21590":59270,"_5":14857,"_28357":59240,"_3076":59271},[],"This lets maintainers assess and address the issue before it is publicly disclosed.",{"_3624":2695,"_31165":2682,"_21590":59273,"_5":14857,"_28357":59240,"_3076":59274},[],"If private vulnerability reporting is not enabled for that repository, report the vulnerability privately to lamassuiot\\@lksnext.com before disclosing any details publicly.",{"_3624":2696,"_31165":2682,"_21590":59276,"_5":14857,"_28357":59244,"_3076":59277},[],"Describe the vulnerability, its potential impact, and steps to reproduce it using non-sensitive, redacted examples.",{"_3624":2697,"_31165":2682,"_21590":59279,"_5":14857,"_28357":59244,"_3076":59280},[],"Do not include in the report:",{"_3624":2698,"_31165":2682,"_21590":59282,"_5":14857,"_28357":59244,"_3076":59283},[],"Credentials, tokens, or private keys",{"_3624":2699,"_31165":2682,"_21590":59285,"_5":14857,"_28357":59244,"_3076":59286},[],"Customer data or customer-identifiable information",{"_3624":2700,"_31165":2682,"_21590":59288,"_5":14857,"_28357":59244,"_3076":59289},[],"Confidential architecture or internal infrastructure details",{"_3624":2701,"_31165":2682,"_21590":59291,"_5":14857,"_28357":59248,"_3076":59292},[],"Only the latest stable release receives security support. Support for a stable release ends when the next stable release is published. Older releases and pre-releases are not supported.",{"_3624":2702,"_31165":2682,"_21590":59294,"_5":14857,"_28357":59248,"_3076":59295},[],"For upgrade guidance, see Upgrades.",{"_3624":2703,"_31165":2682,"_21590":59297,"_5":14857,"_28357":59252,"_3076":59298},[],"Give maintainers reasonable time to investigate and address a reported vulnerability before any public disclosure.",{"_3624":2704,"_31165":2682,"_21590":59300,"_5":14857,"_28357":59252,"_3076":59301},[],"Avoid privacy violations, data destruction, and service disruption while researching a vulnerability.",{"_3624":2705,"_31165":2682,"_21590":59303,"_5":14857,"_28357":59252,"_3076":59304},[],"Only interact with accounts or data you own, or for which you have explicit permission.",{"_3624":2706,"_31165":2682,"_21590":59306,"_5":14857,"_28357":59252,"_3076":59307},[],"Maintainers acknowledge reports in a timely manner and keep you informed of remediation progress.",{"_3624":2707,"_31165":2682,"_21590":59309,"_5":14857,"_28357":59252,"_3076":59310},[],"This policy covers the source code, configuration, and CI/CD workflows of the lamassuiot, lamassu-dashboard, and lamassu-helm repositories.",{"_3624":2708,"_31165":2708,"_5":15217,"_3076":59312,"_31503":59313,"_21590":59315,"_28357":2708},"3.8.0 to 4.0.0",[50900,59314],"Upgrades",[],{"_3624":2709,"_31165":2708,"_21590":59317,"_5":14857,"_28357":2708,"_3076":59318},[],"What changes in the 4.0.0 architecture, which changes break a 3.8.0 deployment, how to upgrade a Helm release step by step and how to validate the result.",{"_3624":2710,"_31165":2708,"_5":31500,"_21590":59320,"_28357":59321,"_3076":59322},[],"/docs/upgrades/3-8-0-to-4-0-0#architecture-changes","Architecture changes",{"_3624":2711,"_31165":2708,"_5":31500,"_21590":59324,"_28357":59325,"_3076":59326},[],"/docs/upgrades/3-8-0-to-4-0-0#one-postgresql-database-with-schemas","One PostgreSQL database with schemas",{"_3624":2712,"_31165":2708,"_5":31500,"_21590":59328,"_28357":59329,"_3076":59330},[],"/docs/upgrades/3-8-0-to-4-0-0#authorization-moves-into-the-authz-service","Authorization moves into the authz service",{"_3624":2713,"_31165":2708,"_5":31500,"_21590":59332,"_28357":59333,"_3076":59334},[],"/docs/upgrades/3-8-0-to-4-0-0#device-events-get-their-own-store","Device events get their own store",{"_3624":2714,"_31165":2708,"_5":31500,"_21590":59336,"_28357":59337,"_3076":59338},[],"/docs/upgrades/3-8-0-to-4-0-0#a-hardened-helm-chart","A hardened Helm chart",{"_3624":2715,"_31165":2708,"_5":31500,"_21590":59340,"_28357":59341,"_3076":59342},[],"/docs/upgrades/3-8-0-to-4-0-0#what-the-upgrade-migrates-automatically","What the upgrade migrates automatically",{"_3624":2716,"_31165":2708,"_5":31500,"_21590":59344,"_28357":59345,"_3076":59346},[],"/docs/upgrades/3-8-0-to-4-0-0#breaking-changes","Breaking changes",{"_3624":2717,"_31165":2708,"_5":31500,"_21590":59348,"_28357":59349,"_3076":59350},[],"/docs/upgrades/3-8-0-to-4-0-0#helm-chart-and-values","Helm chart and values",{"_3624":2718,"_31165":2708,"_5":31500,"_21590":59352,"_28357":59353,"_3076":59354},[],"/docs/upgrades/3-8-0-to-4-0-0#release-scoped-resource-names","Release-scoped resource names",{"_3624":2719,"_31165":2708,"_5":31500,"_21590":59356,"_28357":59357,"_3076":59358},[],"/docs/upgrades/3-8-0-to-4-0-0#strict-values-validation","Strict values validation",{"_3624":2720,"_31165":2708,"_5":31500,"_21590":59360,"_28357":59361,"_3076":51538},[],"/docs/upgrades/3-8-0-to-4-0-0#credentials-in-kubernetes-secrets",{"_3624":2721,"_31165":2708,"_5":31500,"_21590":59363,"_28357":59364,"_3076":59365},[],"/docs/upgrades/3-8-0-to-4-0-0#required-authorization-configuration","Required authorization configuration",{"_3624":2722,"_31165":2708,"_5":31500,"_21590":59367,"_28357":59368,"_3076":59369},[],"/docs/upgrades/3-8-0-to-4-0-0#gateway-token-validation-removed","Gateway token validation removed",{"_3624":2723,"_31165":2708,"_5":31500,"_21590":59371,"_28357":59372,"_3076":59373},[],"/docs/upgrades/3-8-0-to-4-0-0#non-root-containers","Non-root containers",{"_3624":2724,"_31165":2708,"_5":31500,"_21590":59375,"_28357":59376,"_3076":59377},[],"/docs/upgrades/3-8-0-to-4-0-0#amqp-over-tls","AMQP over TLS",{"_3624":2725,"_31165":2708,"_5":31500,"_21590":59379,"_28357":59380,"_3076":59381},[],"/docs/upgrades/3-8-0-to-4-0-0#renamed-and-reshaped-values","Renamed and reshaped values",{"_3624":2726,"_31165":2708,"_5":31500,"_21590":59383,"_28357":59384,"_3076":59385},[],"/docs/upgrades/3-8-0-to-4-0-0#data-and-storage","Data and storage",{"_3624":2727,"_31165":2708,"_5":31500,"_21590":59387,"_28357":59388,"_3076":59389},[],"/docs/upgrades/3-8-0-to-4-0-0#postgresql-consolidation","PostgreSQL consolidation",{"_3624":2728,"_31165":2708,"_5":31500,"_21590":59391,"_28357":59392,"_3076":59393},[],"/docs/upgrades/3-8-0-to-4-0-0#sqlite-storage-removed","SQLite storage removed",{"_3624":2729,"_31165":2708,"_5":31500,"_21590":59395,"_28357":59396,"_3076":59397},[],"/docs/upgrades/3-8-0-to-4-0-0#legacy-ca-keys-in-the-kms","Legacy CA keys in the KMS",{"_3624":2730,"_31165":2708,"_5":31500,"_21590":59399,"_28357":59400,"_3076":59401},[],"/docs/upgrades/3-8-0-to-4-0-0#references-between-certificates-keys-and-crl-settings","References between certificates, keys and CRL settings",{"_3624":2731,"_31165":2708,"_5":31500,"_21590":59403,"_28357":59404,"_3076":59405},[],"/docs/upgrades/3-8-0-to-4-0-0#apis-and-stored-configuration","APIs and stored configuration",{"_3624":2732,"_31165":2708,"_5":31500,"_21590":59407,"_28357":59408,"_3076":59409},[],"/docs/upgrades/3-8-0-to-4-0-0#dms-webhooks","DMS webhooks",{"_3624":2733,"_31165":2708,"_5":31500,"_21590":59411,"_28357":59412,"_3076":59413},[],"/docs/upgrades/3-8-0-to-4-0-0#re-enrollment-trust-set","Re-enrollment trust set",{"_3624":2734,"_31165":2708,"_5":31500,"_21590":59415,"_28357":59416,"_3076":59417},[],"/docs/upgrades/3-8-0-to-4-0-0#fail-closed-revocation-checks","Fail-closed revocation checks",{"_3624":2735,"_31165":2708,"_5":31500,"_21590":59419,"_28357":59420,"_3076":59421},[],"/docs/upgrades/3-8-0-to-4-0-0#independent-re-enrollment-authentication","Independent re-enrollment authentication",{"_3624":2736,"_31165":2708,"_5":31500,"_21590":59423,"_28357":59424,"_3076":59425},[],"/docs/upgrades/3-8-0-to-4-0-0#dms-update-api","DMS update API",{"_3624":2737,"_31165":2708,"_5":31500,"_21590":59427,"_28357":59428,"_3076":59429},[],"/docs/upgrades/3-8-0-to-4-0-0#certificate-type-values","Certificate type values",{"_3624":2738,"_31165":2708,"_5":31500,"_21590":59431,"_28357":59432,"_3076":59433},[],"/docs/upgrades/3-8-0-to-4-0-0#device-events","Device events",{"_3624":2739,"_31165":2708,"_5":31500,"_21590":59435,"_28357":59436,"_3076":59437},[],"/docs/upgrades/3-8-0-to-4-0-0#crl-signer-field","CRL signer field",{"_3624":2740,"_31165":2708,"_5":31500,"_21590":59439,"_28357":59440,"_3076":59441},[],"/docs/upgrades/3-8-0-to-4-0-0#crl-settings-keyed-by-ca-id","CRL settings keyed by CA ID",{"_3624":2741,"_31165":2708,"_5":31500,"_21590":59443,"_28357":59444,"_3076":59445},[],"/docs/upgrades/3-8-0-to-4-0-0#renamed-va-events","Renamed VA events",{"_3624":2742,"_31165":2708,"_5":31500,"_21590":59447,"_28357":59448,"_3076":59449},[],"/docs/upgrades/3-8-0-to-4-0-0#ca-signature-endpoints-removed","CA signature endpoints removed",{"_3624":2743,"_31165":2708,"_5":31500,"_21590":59451,"_28357":59452,"_3076":59453},[],"/docs/upgrades/3-8-0-to-4-0-0#ca-ids-are-always-assigned-by-the-backend","CA IDs are always assigned by the backend",{"_3624":2744,"_31165":2708,"_5":31500,"_21590":59455,"_28357":59456,"_3076":59449},[],"/docs/upgrades/3-8-0-to-4-0-0#ca-signature-endpoints-removed-1",{"_3624":2745,"_31165":2708,"_5":31500,"_21590":59458,"_28357":59459,"_3076":59460},[],"/docs/upgrades/3-8-0-to-4-0-0#va-crl-signer","VA CRL signer",{"_3624":2746,"_31165":2708,"_5":31500,"_21590":59462,"_28357":59463,"_3076":59464},[],"/docs/upgrades/3-8-0-to-4-0-0#helm-migration-guide","Helm migration guide",{"_3624":2747,"_31165":2708,"_5":31500,"_21590":59466,"_28357":59467,"_3076":59468},[],"/docs/upgrades/3-8-0-to-4-0-0#step-1-prepare","Step 1: Prepare",{"_3624":2748,"_31165":2708,"_5":31500,"_21590":59470,"_28357":59471,"_3076":59472},[],"/docs/upgrades/3-8-0-to-4-0-0#pre-upgrade-check","Pre-upgrade check",{"_3624":2749,"_31165":2708,"_5":31500,"_21590":59474,"_28357":59475,"_3076":59476},[],"/docs/upgrades/3-8-0-to-4-0-0#step-2-update-the-values-file","Step 2: Update the values file",{"_3624":2750,"_31165":2708,"_5":31500,"_21590":59478,"_28357":59479,"_3076":59480},[],"/docs/upgrades/3-8-0-to-4-0-0#step-3-run-the-upgrade","Step 3: Run the upgrade",{"_3624":2751,"_31165":2708,"_5":31500,"_21590":59482,"_28357":59483,"_3076":59484},[],"/docs/upgrades/3-8-0-to-4-0-0#step-4-migrate-the-kms-and-va-data","Step 4: Migrate the KMS and VA data",{"_3624":2752,"_31165":2708,"_5":31500,"_21590":59486,"_28357":59487,"_3076":59488},[],"/docs/upgrades/3-8-0-to-4-0-0#step-5-remove-the-one-off-migration-values","Step 5: Remove the one-off migration values",{"_3624":2753,"_31165":2708,"_5":31500,"_21590":59490,"_28357":59491,"_3076":59492},[],"/docs/upgrades/3-8-0-to-4-0-0#deployments-without-helm","Deployments without Helm",{"_3624":2754,"_31165":2708,"_5":31500,"_21590":59494,"_28357":59495,"_3076":55161},[],"/docs/upgrades/3-8-0-to-4-0-0#troubleshooting",{"_3624":2755,"_31165":2708,"_5":31500,"_21590":59497,"_28357":59498,"_3076":59499},[],"/docs/upgrades/3-8-0-to-4-0-0#validation-checklist","Validation checklist",{"_3624":2756,"_31165":2708,"_5":31500,"_21590":59501,"_28357":59502,"_3076":59503},[],"/docs/upgrades/3-8-0-to-4-0-0#delete-the-old-volumes","Delete the old volumes",{"_3624":2757,"_31165":2708,"_21590":59505,"_5":14857,"_28357":2708,"_3076":59506},[],"Lamassu 4.0.0 is a major release. Storage consolidates into a single PostgreSQL database, a new `authz` service authorizes every request, the Helm chart is hardened, and several APIs and stored configurations change shape. Most data converts automatically during the upgrade, but some changes need operator action before, during or after it.",{"_3624":2758,"_31165":2708,"_21590":59508,"_5":14857,"_28357":2708,"_3076":59509},[],"This page is organized in four parts. Read them in order before you upgrade production:",{"_3624":2759,"_31165":2708,"_21590":59511,"_5":14857,"_28357":2708,"_3076":59512},[],"Architecture changes: what is different in 4.0.0 and what the upgrade migrates on its own.",{"_3624":2760,"_31165":2708,"_21590":59514,"_5":14857,"_28357":2708,"_3076":59515},[],"Breaking changes: every change that can break a 3.8.0 deployment, who it affects and what to do.",{"_3624":2761,"_31165":2708,"_21590":59517,"_5":14857,"_28357":2708,"_3076":59518},[],"Helm migration guide: the step-by-step procedure for a Helm-managed release.",{"_3624":2762,"_31165":2708,"_21590":59520,"_5":14857,"_28357":2708,"_3076":59521},[],"Validation checklist: how to confirm the upgrade worked before you remove the old data.",{"_3624":2763,"_31165":2708,"_21590":59523,"_5":14857,"_28357":2708,"_3076":59524},[],"The 4.0.0 release is upcoming and the backend migration steps on this page are provisional. Verify each procedure against the final release artifacts before upgrading production.",{"_3624":2764,"_31165":2708,"_21590":59526,"_5":14857,"_28357":59325,"_3076":59527},[],"3.8.0 gave each service its own database. The 4.0.0 backend connects to a single PostgreSQL database named `pki` and isolates each service in a schema: `kms`, `ca`, `va`, `devicemanager`, `dmsmanager` and `alerts`. The `authz` service keeps its principals, grants and policies in a separate `authz` database (the development monolith uses an `authz` schema inside `pki` instead), and WFX keeps its own `wfx` database.",{"_3624":2765,"_31165":2708,"_21590":59529,"_5":14857,"_28357":59325,"_3076":59530},[],"PostgreSQL is now the only storage engine. SQLite support is removed, and the `couch_db` and `dynamo_db` engines are not registered in 4.0.0.",{"_3624":2766,"_31165":2708,"_21590":59532,"_5":14857,"_28357":59329,"_3076":59533},[],"In 3.8.0 the API Gateway validated tokens: a JWT policy on every private route checked the signature and only let through tokens that carried the administrator role. Every route was open to any token that passed that check.",{"_3624":2767,"_31165":2708,"_21590":59535,"_5":14857,"_28357":59329,"_3076":59536},[],"4.0.0 removes the gateway policy. The `/api/*` routes reach the services directly, and each service authorizes every request through `authz`, which validates the token against the identity provider's JWKS endpoint and applies fine-grained, entity-level policies to CAs, certificates, devices, DMSs, KMS keys and CRL settings. There is no implicit superuser: the first administrator comes from a bootstrap principal that you configure. The access control page documents principals, policies and the first administrator.",{"_3624":2768,"_31165":2708,"_21590":59538,"_5":14857,"_28357":59333,"_3076":59539},[],"Historical device events move from the `devices.events` column to a dedicated `device_events` store with their own endpoints. The events endpoint can also stream events over Server-Sent Events (SSE); to fan events out across service instances, each Device Manager instance binds its own durable AMQP queue.",{"_3624":2769,"_31165":2708,"_21590":59541,"_5":14857,"_28357":59337,"_3076":59542},[],"Version 4.0.0 of the chart is a security-hardening release:",{"_3624":2770,"_31165":2708,"_21590":59544,"_5":14857,"_28357":59337,"_3076":59545},[],"**Release-scoped resource names.** Every chart-managed resource is named `<release>-lamassu-<component>` instead of the fixed names used in 3.8.0 (`kms`, `va`, `ca`, ...). With a release named `prod` the StatefulSets become `prod-lamassu-kms` and `prod-lamassu-va`. The `nameOverride` and `fullnameOverride` values change the prefix.",{"_3624":2771,"_31165":2708,"_21590":59547,"_5":14857,"_28357":59337,"_3076":59548},[],"**Non-root containers.** Every workload runs as the numeric user `65532:65532` with a `RuntimeDefault` seccomp profile and dropped capabilities. Pods do not mount the service-account token by default, and the chart creates a dedicated ServiceAccount.",{"_3624":2772,"_31165":2708,"_21590":59550,"_5":14857,"_28357":59337,"_3076":59551},[],"**Strict values validation.** `values.schema.json` rejects unknown keys, so leftover 3.8.0 blocks fail `helm lint` and `helm upgrade` instead of being silently ignored.",{"_3624":2773,"_31165":2708,"_21590":59553,"_5":14857,"_28357":59337,"_3076":59554},[],"**No injected scheduling rules.** The chart no longer adds pod anti-affinity or topology spread constraints on its own.",{"_3624":2774,"_31165":2708,"_21590":59556,"_5":14857,"_28357":59341,"_3076":59557},[],"Several migrations run without intervention when you upgrade a Helm release:",{"_3624":2775,"_31165":2708,"_21590":59559,"_5":14857,"_28357":59341,"_3076":59560},[],"Before any service starts, the chart's pre-install/pre-upgrade job prepares PostgreSQL. It creates the `pki`, `authz` and `wfx` databases when they do not exist, creates one schema per service inside `pki`, and imports each 3.8.0 per-service database into its schema. Each import runs as a single transaction, so a failed import leaves no partial schema and a retried job imports again. The job then runs the database migrations for every schema, migrates `authz`, preloads its policies and seeds the `services.authz.bootstrap` principals. It is idempotent and requires a PostgreSQL role allowed to create databases and schemas, as described in Install with Helm.",{"_3624":2776,"_31165":2708,"_21590":59562,"_5":14857,"_28357":59341,"_3076":59563},[],"Stored DMS configuration is rewritten to the 4.0.0 layout, and historical device events are transformed into the new store.",{"_3624":2777,"_31165":2708,"_21590":59565,"_5":14857,"_28357":59341,"_3076":59566},[],"The KMS migration removes the stale `lamassu.io/kms/binded-resources` key metadata, and the VA migration resolves each role's CRL signer (see VA CRL signer).",{"_3624":2778,"_31165":2708,"_21590":59568,"_5":14857,"_28357":59341,"_3076":59569},[],"When `migrations.caToKms.enabled` is set, a pre-upgrade hook registers legacy CA keys in the KMS.",{"_3624":2779,"_31165":2708,"_21590":59571,"_5":14857,"_28357":59341,"_3076":59572},[],"Two things never migrate on their own: the KMS and VA data on local volumes, which stays on volumes the upgraded pods no longer use, and the values file, which you update by hand. Deployments that do not use the Helm chart also have to move their database data themselves; see Deployments without Helm.",{"_3624":2780,"_31165":2708,"_21590":59574,"_5":14857,"_28357":59345,"_3076":59575},[],"Change",{"_3624":2781,"_31165":2708,"_21590":59577,"_5":14857,"_28357":59345,"_3076":59578},[],"Who is affected",{"_3624":2782,"_31165":2708,"_21590":59580,"_5":14857,"_28357":59345,"_3076":59581},[],"Severity",{"_3624":2783,"_31165":2708,"_21590":59583,"_5":14857,"_28357":59345,"_3076":58034},[],{"_3624":2784,"_31165":2708,"_21590":59585,"_5":14857,"_28357":59345,"_3076":59354},[],{"_3624":2785,"_31165":2708,"_21590":59587,"_5":14857,"_28357":59345,"_3076":59588},[],"Helm releases with a filesystem KMS engine or local VA CRL storage",{"_3624":2786,"_31165":2708,"_21590":59590,"_5":14857,"_28357":59345,"_3076":59591},[],"High: KMS and VA start on empty volumes",{"_3624":2787,"_31165":2708,"_21590":59593,"_5":14857,"_28357":59345,"_3076":59594},[],"Copy the data into the new volumes",{"_3624":2788,"_31165":2708,"_21590":59596,"_5":14857,"_28357":59345,"_3076":59358},[],{"_3624":2789,"_31165":2708,"_21590":59598,"_5":14857,"_28357":59345,"_3076":59599},[],"Every Helm release",{"_3624":2790,"_31165":2708,"_21590":59601,"_5":14857,"_28357":59345,"_3076":59602},[],"High: `helm upgrade` fails",{"_3624":2791,"_31165":2708,"_21590":59604,"_5":14857,"_28357":59345,"_3076":59605},[],"Remove or rename legacy keys",{"_3624":2792,"_31165":2708,"_21590":59607,"_5":14857,"_28357":59345,"_3076":51538},[],{"_3624":2793,"_31165":2708,"_21590":59609,"_5":14857,"_28357":59345,"_3076":59599},[],{"_3624":2794,"_31165":2708,"_21590":59611,"_5":14857,"_28357":59345,"_3076":59612},[],"High: `helm upgrade` fails on inline credentials",{"_3624":2795,"_31165":2708,"_21590":59614,"_5":14857,"_28357":59345,"_3076":59615},[],"Create the Secrets first; see Step 2",{"_3624":2796,"_31165":2708,"_21590":59617,"_5":14857,"_28357":59345,"_3076":59365},[],{"_3624":2797,"_31165":2708,"_21590":59619,"_5":14857,"_28357":59345,"_3076":59620},[],"Every deployment",{"_3624":2798,"_31165":2708,"_21590":59622,"_5":14857,"_28357":59345,"_3076":59623},[],"High: without a bootstrap principal there is no administrator",{"_3624":2799,"_31165":2708,"_21590":59625,"_5":14857,"_28357":59345,"_3076":59626},[],"Configure `services.authz`",{"_3624":2800,"_31165":2708,"_21590":59628,"_5":14857,"_28357":59345,"_3076":59369},[],{"_3624":2801,"_31165":2708,"_21590":59630,"_5":14857,"_28357":59345,"_3076":59599},[],{"_3624":2802,"_31165":2708,"_21590":59632,"_5":14857,"_28357":59345,"_3076":59633},[],"High: `helm upgrade` fails on the old keys",{"_3624":2803,"_31165":2708,"_21590":59635,"_5":14857,"_28357":59345,"_3076":59636},[],"Move JWKS and roles into `services.authz`",{"_3624":2804,"_31165":2708,"_21590":59638,"_5":14857,"_28357":59345,"_3076":59389},[],{"_3624":2805,"_31165":2708,"_21590":59640,"_5":14857,"_28357":59345,"_3076":59641},[],"3.8.0 deployments with per-service databases",{"_3624":2806,"_31165":2708,"_21590":59643,"_5":14857,"_28357":59345,"_3076":59644},[],"High: services find no data, or a migration aborts",{"_3624":2807,"_31165":2708,"_21590":59646,"_5":14857,"_28357":59345,"_3076":59647},[],"Clean duplicate CA IDs and empty `engine_id` values first; move data manually outside Helm",{"_3624":2808,"_31165":2708,"_21590":59649,"_5":14857,"_28357":59345,"_3076":59393},[],{"_3624":2809,"_31165":2708,"_21590":59651,"_5":14857,"_28357":59345,"_3076":59652},[],"Deployments on SQLite, `couch_db` or `dynamo_db`",{"_3624":2810,"_31165":2708,"_21590":59654,"_5":14857,"_28357":59345,"_3076":59655},[],"High: the backend no longer starts with them",{"_3624":2811,"_31165":2708,"_21590":59657,"_5":14857,"_28357":59345,"_3076":59658},[],"Move to PostgreSQL before upgrading",{"_3624":2812,"_31165":2708,"_21590":59660,"_5":14857,"_28357":59345,"_3076":59441},[],{"_3624":2813,"_31165":2708,"_21590":59662,"_5":14857,"_28357":59345,"_3076":59663},[],"Every deployment; API clients, custom policies and alert subscriptions are also affected",{"_3624":2814,"_31165":2708,"_21590":59665,"_5":14857,"_28357":59345,"_3076":59666},[],"High: the `/v1/roles` routes are removed and the migration is irreversible",{"_3624":2815,"_31165":2708,"_21590":59668,"_5":14857,"_28357":59345,"_3076":59669},[],"Fix the data the migration aborts on, and back up the database and the CRL bucket",{"_3624":2816,"_31165":2708,"_21590":59671,"_5":14857,"_28357":59345,"_3076":59672},[],"Webhooks with file references",{"_3624":2817,"_31165":2708,"_21590":59674,"_5":14857,"_28357":59345,"_3076":59675},[],"DMSs whose webhook mTLS certificate or key were file paths",{"_3624":2818,"_31165":2708,"_21590":59677,"_5":14857,"_28357":59345,"_3076":59678},[],"High: enrollments calling the webhook fail",{"_3624":2819,"_31165":2708,"_21590":59680,"_5":14857,"_28357":59345,"_3076":59681},[],"Re-enter certificate and key as PEM, or remove the file fields",{"_3624":2820,"_31165":2708,"_21590":59683,"_5":14857,"_28357":59345,"_3076":59373},[],{"_3624":2821,"_31165":2708,"_21590":59685,"_5":14857,"_28357":59345,"_3076":59686},[],"Releases with per-service identity overrides or mounted key material",{"_3624":2822,"_31165":2708,"_21590":59688,"_5":14857,"_28357":59345,"_3076":59689},[],"Medium: services cannot read their files",{"_3624":2823,"_31165":2708,"_21590":59691,"_5":14857,"_28357":59345,"_3076":59692},[],"Remove the overrides and fix volume ownership",{"_3624":2824,"_31165":2708,"_21590":59694,"_5":14857,"_28357":59345,"_3076":59377},[],{"_3624":2825,"_31165":2708,"_21590":59696,"_5":14857,"_28357":59345,"_3076":59697},[],"Releases that set `amqp.tls`",{"_3624":2826,"_31165":2708,"_21590":59699,"_5":14857,"_28357":59345,"_3076":59700},[],"Medium: clients connect to the wrong port",{"_3624":2827,"_31165":2708,"_21590":59702,"_5":14857,"_28357":59345,"_3076":59703},[],"Point `amqp.port` at the TLS listener, or disable TLS",{"_3624":2828,"_31165":2708,"_21590":59705,"_5":14857,"_28357":59345,"_3076":59397},[],{"_3624":2829,"_31165":2708,"_21590":59707,"_5":14857,"_28357":59345,"_3076":59708},[],"Installations whose CA keys predate the KMS",{"_3624":2830,"_31165":2708,"_21590":59710,"_5":14857,"_28357":59345,"_3076":59711},[],"Medium: CA keys stay unmanaged",{"_3624":2831,"_31165":2708,"_21590":59713,"_5":14857,"_28357":59345,"_3076":59714},[],"Run the CA-to-KMS migration",{"_3624":2832,"_31165":2708,"_21590":59716,"_5":14857,"_28357":59345,"_3076":59717},[],"Receiver certificate verification",{"_3624":2833,"_31165":2708,"_21590":59719,"_5":14857,"_28357":59345,"_3076":59720},[],"DMSs whose webhook had `validate_server_cert: false`",{"_3624":2834,"_31165":2708,"_21590":59722,"_5":14857,"_28357":59345,"_3076":59723},[],"Medium: credentials go to an unverified receiver",{"_3624":2835,"_31165":2708,"_21590":59725,"_5":14857,"_28357":59345,"_3076":59726},[],"Set `insecure_skip_verify` to `false`",{"_3624":2836,"_31165":2708,"_21590":59728,"_5":14857,"_28357":59345,"_3076":59413},[],{"_3624":2837,"_31165":2708,"_21590":59730,"_5":14857,"_28357":59345,"_3076":59731},[],"Scripts and consoles that edit DMSs through the API",{"_3624":2838,"_31165":2708,"_21590":59733,"_5":14857,"_28357":59345,"_3076":59734},[],"Medium: an old-layout edit silently empties `validation_cas`",{"_3624":2839,"_31165":2708,"_21590":59736,"_5":14857,"_28357":59345,"_3076":59737},[],"Read the DMS before editing and use the new field",{"_3624":2840,"_31165":2708,"_21590":59739,"_5":14857,"_28357":59345,"_3076":59417},[],{"_3624":2841,"_31165":2708,"_21590":59741,"_5":14857,"_28357":59345,"_3076":59742},[],"Every deployment with devices presenting certificates not managed by Lamassu",{"_3624":2842,"_31165":2708,"_21590":59744,"_5":14857,"_28357":59345,"_3076":59745},[],"Medium: enrollment or re-enrollment of those devices fails",{"_3624":2843,"_31165":2708,"_21590":59747,"_5":14857,"_28357":59345,"_3076":59748},[],"Set `allow_unverifiable_revocation` to `true` in the affected DMS blocks, or make sure the certificates carry reachable OCSP/CRL distribution points",{"_3624":2844,"_31165":2708,"_21590":59750,"_5":14857,"_28357":59345,"_3076":59437},[],{"_3624":2845,"_31165":2708,"_21590":59752,"_5":14857,"_28357":59345,"_3076":59753},[],"Clients that create or update CRL settings through the API",{"_3624":2846,"_31165":2708,"_21590":59755,"_5":14857,"_28357":59345,"_3076":59756},[],"Medium: requests with the old field return an error",{"_3624":2847,"_31165":2708,"_21590":59758,"_5":14857,"_28357":59345,"_3076":59759},[],"Replace `crl_options.subject_key_id_signer` with the required `crl_options.signer_serial_number`",{"_3624":2848,"_31165":2708,"_21590":59761,"_5":14857,"_28357":59345,"_3076":59445},[],{"_3624":2849,"_31165":2708,"_21590":59763,"_5":14857,"_28357":59345,"_3076":59764},[],"Alert subscriptions and consumers of the VA events",{"_3624":2850,"_31165":2708,"_21590":59766,"_5":14857,"_28357":59345,"_3076":59767},[],"Medium: subscription types are renamed automatically, their conditions are not",{"_3624":2851,"_31165":2708,"_21590":59769,"_5":14857,"_28357":59345,"_3076":59770},[],"Review conditions filtering on the old event payload or subject",{"_3624":2852,"_31165":2708,"_21590":59772,"_5":14857,"_28357":59345,"_3076":59449},[],{"_3624":2853,"_31165":2708,"_21590":59774,"_5":14857,"_28357":59345,"_3076":59775},[],"Clients that sign or verify arbitrary data through the CA API or the Go SDK, and alert subscriptions on the `ca.sign.signature` event",{"_3624":2854,"_31165":2708,"_21590":59777,"_5":14857,"_28357":59345,"_3076":59778},[],"Medium: the endpoints, the SDK methods and the event no longer exist",{"_3624":2855,"_31165":2708,"_21590":59780,"_5":14857,"_28357":59345,"_3076":59781},[],"Sign and verify with KMS keys instead; remove subscriptions on the event",{"_3624":2856,"_31165":2708,"_21590":59783,"_5":14857,"_28357":59345,"_3076":59433},[],{"_3624":2857,"_31165":2708,"_21590":59785,"_5":14857,"_28357":59345,"_3076":59786},[],"Consumers that read the device `events` field",{"_3624":2858,"_31165":2708,"_21590":59788,"_5":14857,"_28357":59345,"_3076":59789},[],"Medium: the field disappears",{"_3624":2859,"_31165":2708,"_21590":59791,"_5":14857,"_28357":59345,"_3076":59792},[],"Use the new event endpoints",{"_3624":2860,"_31165":2708,"_21590":59794,"_5":14857,"_28357":59345,"_3076":59460},[],{"_3624":2861,"_31165":2708,"_21590":59796,"_5":14857,"_28357":59345,"_3076":59797},[],"Deployments with VA roles whose signer cannot be resolved uniquely",{"_3624":2862,"_31165":2708,"_21590":59799,"_5":14857,"_28357":59345,"_3076":59800},[],"Medium: the VA migration aborts",{"_3624":2863,"_31165":2708,"_21590":59802,"_5":14857,"_28357":59345,"_3076":59803},[],"Fix the affected roles before upgrading",{"_3624":2864,"_31165":2708,"_21590":59805,"_5":14857,"_28357":59345,"_3076":59381},[],{"_3624":2865,"_31165":2708,"_21590":59807,"_5":14857,"_28357":59345,"_3076":59808},[],"Releases that override `toolbox`, `services.connectors`, ports, probes or scheduling",{"_3624":2866,"_31165":2708,"_21590":59810,"_5":14857,"_28357":59345,"_3076":59811},[],"Low to medium: validation errors or changed defaults",{"_3624":2867,"_31165":2708,"_21590":59813,"_5":14857,"_28357":59345,"_3076":59814},[],"Update the values file",{"_3624":2868,"_31165":2708,"_21590":59816,"_5":14857,"_28357":59345,"_3076":59425},[],{"_3624":2869,"_31165":2708,"_21590":59818,"_5":14857,"_28357":59345,"_3076":59819},[],"Clients that send the DMS ID in the update body",{"_3624":2870,"_31165":2708,"_21590":59821,"_5":14857,"_28357":59345,"_3076":59822},[],"Low: the ID in the URL wins",{"_3624":2871,"_31165":2708,"_21590":59824,"_5":14857,"_28357":59345,"_3076":59825},[],"Send the ID in the URL",{"_3624":2872,"_31165":2708,"_21590":59827,"_5":14857,"_28357":59345,"_3076":59453},[],{"_3624":2873,"_31165":2708,"_21590":59829,"_5":14857,"_28357":59345,"_3076":59830},[],"Clients that send an `id` when creating or importing CAs",{"_3624":2874,"_31165":2708,"_21590":59832,"_5":14857,"_28357":59345,"_3076":59833},[],"Low: the ID in the body is ignored, and the field is removed",{"_3624":2875,"_31165":2708,"_21590":59835,"_5":14857,"_28357":59345,"_3076":59836},[],"Let the backend assign the ID and use the returned one",{"_3624":2876,"_31165":2708,"_21590":59838,"_5":14857,"_28357":59345,"_3076":59449},[],{"_3624":2877,"_31165":2708,"_21590":59840,"_5":14857,"_28357":59345,"_3076":59841},[],"API and SDK clients that call `/v1/cas/{id}/signature/sign` or `/verify`, and alert subscriptions on `ca.sign.signature`",{"_3624":2878,"_31165":2708,"_21590":59843,"_5":14857,"_28357":59345,"_3076":59844},[],"Medium: the calls return `404` and the subscriptions never fire",{"_3624":2879,"_31165":2708,"_21590":59846,"_5":14857,"_28357":59345,"_3076":59847},[],"Use the KMS `sign` and `verify` operations",{"_3624":2880,"_31165":2708,"_21590":59849,"_5":14857,"_28357":59345,"_3076":59429},[],{"_3624":2881,"_31165":2708,"_21590":59851,"_5":14857,"_28357":59345,"_3076":59852},[],"Consumers that match on certificate `type`",{"_3624":2882,"_31165":2708,"_21590":59854,"_5":14857,"_28357":59345,"_3076":59855},[],"Low: two values are renamed",{"_3624":2883,"_31165":2708,"_21590":59857,"_5":14857,"_28357":59345,"_3076":59858},[],"Adapt consumers",{"_3624":2884,"_31165":2708,"_21590":59860,"_5":14857,"_28357":59345,"_3076":59421},[],{"_3624":2885,"_31165":2708,"_21590":59862,"_5":14857,"_28357":59345,"_3076":59863},[],"Any DMS",{"_3624":2886,"_31165":2708,"_21590":59865,"_5":14857,"_28357":59345,"_3076":59866},[],"Low: informational",{"_3624":2887,"_31165":2708,"_21590":59868,"_5":14857,"_28357":59345,"_3076":59869},[],"Read both blocks before editing",{"_3624":2888,"_31165":2708,"_21590":59871,"_5":14857,"_28357":59353,"_3076":59872},[],"Kubernetes derives a StatefulSet's PVC name from its pod name (`<volumeClaimTemplate>-<pod-name>`). Renaming the `kms` and `va` StatefulSets means `helm upgrade` binds brand-new, empty PVCs instead of the existing ones. The KMS key material and VA CRLs are not deleted — the old PVCs are orphaned, not removed — but the upgraded pods fail with `no such file or directory` (KMS) or `code=NotFound` (VA) until you copy the data across. This affects KMS when `services.kms.cryptoEngines` uses a `filesystem` engine and VA when `services.va.fileStore.type` is `local`. Every other renamed resource is stateless and is recreated without data-loss risk.",{"_3624":2889,"_31165":2708,"_21590":59874,"_5":14857,"_28357":59353,"_3076":59875},[],"Step 4 of the migration guide copies the data.",{"_3624":2890,"_31165":2708,"_21590":59877,"_5":14857,"_28357":59357,"_3076":59878},[],"`values.schema.json` rejects unknown keys, so every block that 4.0.0 removed or renamed — `toolbox`, `auth.oidc.apiGateway`, `auth.authorization` and others — fails `helm lint` and `helm upgrade` outright. Step 2 lists every change.",{"_3624":2891,"_31165":2708,"_21590":59880,"_5":14857,"_28357":59361,"_3076":59881},[],"In 4.0.0 the chart reads PostgreSQL, AMQP and SMTP credentials from Kubernetes Secrets in the release namespace instead of inline values: `postgres.existingSecret`, `amqp.existingSecret` and — when SMTP authentication is configured — `services.alerts.smtp_server.existingSecret`, each with `usernameKey` and `passwordKey` naming the Secret data keys. The inline `postgres.username`/`postgres.password` and `amqp.username`/`amqp.password` values are removed and rejected by `values.schema.json`, so a 3.8.0 values file fails `helm lint` and `helm upgrade` until the credentials move into Secrets.",{"_3624":2892,"_31165":2708,"_21590":59883,"_5":14857,"_28357":59361,"_3076":59884},[],"The Secrets must exist before `helm upgrade` runs: the pre-upgrade database job connects to PostgreSQL with them. Step 2 creates them through the External Secrets Operator.",{"_3624":2893,"_31165":2708,"_21590":59886,"_5":14857,"_28357":59364,"_3076":59887},[],"3.8.0 had no authorization service, so a 3.8.0 values file has nothing to migrate from: you must add the `services.authz` configuration yourself. It needs the JWKS endpoint of your identity provider, the database mappings the authorization engine uses, and a bootstrap principal that matches how your provider assigns the administrator role. Without a matching principal nobody can administer the PKI.",{"_3624":2894,"_31165":2708,"_21590":59889,"_5":14857,"_28357":59368,"_3076":59890},[],"`auth.oidc.apiGateway.jwks`, `auth.authorization.rolesClaim` and `auth.authorization.roles.admin` are removed with no compatibility aliases, and the schema rejects them. Their settings move into `services.authz`: the JWKS URL becomes `services.authz.jwkUrl`, and the role claim and administrator role become a claim rule of the bootstrap principal. `auth.oidc.frontend` is unchanged.",{"_3624":2895,"_31165":2708,"_21590":59892,"_5":14857,"_28357":59372,"_3076":59893},[],"Service images run on a distroless base as the numeric user `65532`; the `authz` image is Ubuntu with a non-root user that has the same UID. The per-service overrides `services.kms.securityContext.runAsGroup: 0` and `services.authz.securityContext.runAsUser`/`runAsGroup: 999` are removed; group access to the KMS volume and PKCS#11 socket is now handled by the pod-level `fsGroup: 65532`.",{"_3624":2896,"_31165":2708,"_21590":59895,"_5":14857,"_28357":59372,"_3076":59896},[],"3.8.0 did not pin a container identity, so existing files can carry any UID. Any volume that holds keys or CRLs must be owned by `65532:65532`, or at least readable (and, where needed, writable) by that identity.",{"_3624":2897,"_31165":2708,"_21590":59898,"_5":14857,"_28357":59372,"_3076":59899},[],"Pods now carry a pod-level `fsGroup: 65532` with `fsGroupChangePolicy: OnRootMismatch`, which skips recursive ownership changes when the volume root already has the expected group. If your backup helpers or jobs run with a different GID, verify they can still access the volumes they need.",{"_3624":2898,"_31165":2708,"_21590":59901,"_5":14857,"_28357":59376,"_3076":59902},[],"In 3.8.0 `amqp.tls` was not applied and event-bus clients always connected over plaintext. In 4.0.0 `amqp.tls: true` switches them to AMQPS. The default `amqp.port` stays `5672` and does not change when TLS is enabled, so a values file that already set `amqp.tls: true` must point `amqp.port` at the broker's TLS listener (`amqps`, commonly `5671`), or set `amqp.tls: false` to keep plaintext. Clients must also trust the broker's certificate.",{"_3624":2899,"_31165":2708,"_21590":59904,"_5":14857,"_28357":59380,"_3076":59905},[],"`toolbox` is renamed to `connectivityTest`, and the `helm test` hook uses the upstream `curlimages/curl` image pinned by digest.",{"_3624":2900,"_31165":2708,"_21590":59907,"_5":14857,"_28357":59380,"_3076":59908},[],"`services.connectors` is a map keyed by connector ID instead of a list.",{"_3624":2901,"_31165":2708,"_21590":59910,"_5":14857,"_28357":59380,"_3076":59911},[],"The `services.ui.port` default is `8085`, the unprivileged port of the rootless image.",{"_3624":2902,"_31165":2708,"_21590":59913,"_5":14857,"_28357":59380,"_3076":59914},[],"The shared `probes:` block is replaced by independent `livenessProbe`, `readinessProbe` and `startupProbe` blocks.",{"_3624":2903,"_31165":2708,"_21590":59916,"_5":14857,"_28357":59380,"_3076":59917},[],"With `tls.certManagerOptions.issuer` empty, the chart creates a release-scoped self-signed issuer, for example `lamassu-downstream-ca-selfsigned-issuer`. The legacy literal `downstream-ca-selfsigned-issuer` is still accepted and resolves to it.",{"_3624":2904,"_31165":2708,"_21590":59919,"_5":14857,"_28357":59380,"_3076":59920},[],"Anti-affinity and topology spread must be configured explicitly through `affinity` and `topologySpreadConstraints`.",{"_3624":2905,"_31165":2708,"_21590":59922,"_5":14857,"_28357":59388,"_3076":59923},[],"Every 3.8.0 per-service database must end up as a schema of `pki`, keeping its structure, indexes, constraints, data and migration history. The Helm chart does this automatically; deployments without Helm do it by hand (see Deployments without Helm).",{"_3624":2906,"_31165":2708,"_21590":59925,"_5":14857,"_28357":59388,"_3076":59926},[],"Two schema migrations abort on data that 3.8.0 allowed, so clean the data before upgrading:",{"_3624":2907,"_31165":2708,"_21590":59928,"_5":14857,"_28357":59388,"_3076":59929},[],"The CA migration adds a UNIQUE constraint on `ca_certificates.id` and aborts if duplicate CA IDs exist. Imports already reject duplicates with `409`, so new ones cannot normally appear.",{"_3624":2908,"_31165":2708,"_21590":59931,"_5":14857,"_28357":59388,"_3076":59932},[],"The KMS migration promotes the primary key to `(key_id, engine_id)` and aborts with `cannot promote (key_id, engine_id) to primary key: N row(s) have no engine_id; backfill them before migrating` when `kms_keys` rows lack `engine_id`. Backfill `engine_id` first.",{"_3624":2909,"_31165":2708,"_21590":59934,"_5":14857,"_28357":59388,"_3076":59935},[],"The same KMS migration deletes, with a `NOTICE`, aliases that equal an existing key ID, because identifiers now resolve as a key ID before an alias. Affected aliases are dropped, not redirected.",{"_3624":2910,"_31165":2708,"_21590":59937,"_5":14857,"_28357":59392,"_3076":59938},[],"The SQLite storage engine is removed, and the `couch_db` and `dynamo_db` engines are not registered in 4.0.0: their configuration constants remain, but they select no engine. Deployments on any of them must move to PostgreSQL and consolidate their data into the `pki` schemas before upgrading.",{"_3624":2911,"_31165":2708,"_21590":59940,"_5":14857,"_28357":59396,"_3076":59941},[],"CA certificates of type `MANAGED` or `IMPORTED_WITH_KEY` whose private keys predate the KMS service have the key stored only in the crypto engine, under the certificate's `subject_key_id`, with no KMS record. The `ca-to-kms-migration` tool registers them:",{"_3624":2912,"_31165":2708,"_21590":59943,"_5":14857,"_28357":59396,"_3076":59944},[],"The `key_id` is the certificate's `subject_key_id`; it matches the SHA-256 digest of the public key only when the SKI was computed that way.",{"_3624":2913,"_31165":2708,"_21590":59946,"_5":14857,"_28357":59396,"_3076":59947},[],"The tool is idempotent: keys already in the KMS are skipped, so it can be run several times.",{"_3624":2914,"_31165":2708,"_21590":59949,"_5":14857,"_28357":59396,"_3076":59950},[],"Certificates that cannot be read, or lack an engine or a subject key ID, are skipped with a warning. Review the logs and resolve the affected records.",{"_3624":2915,"_31165":2708,"_21590":59952,"_5":14857,"_28357":59396,"_3076":59953},[],"When CA certificates sharing a `subject_key_id` declare conflicting `engine_id`s, the tool fails that key and exits with code `1`, which fails a Helm pre-upgrade hook. Resolve the conflict manually before rerunning.",{"_3624":2916,"_31165":2708,"_21590":59955,"_5":14857,"_28357":59396,"_3076":59956},[],"Once the keys are registered, certificates reference them in the database and the KMS refuses to delete a key that a certificate still uses (`409` `key is in use`). Deleting a certificate record removes it from the CRL and OCSP, so read Before deleting a key before freeing a key.",{"_3624":2917,"_31165":2708,"_21590":59958,"_5":14857,"_28357":59396,"_3076":59959},[],"Optionally, installations with imported CAs from before 3.7 can start the KMS once with `crypto_engines.migrate_keys_format: true`: the KMS renames those SKI-named legacy keys to the SHA-256 digest of their public key (the old name is kept as an alias, and the certificate references follow automatically). Run it once and disable the option again; running it again is safe.",{"_3624":2918,"_31165":2708,"_21590":59961,"_5":14857,"_28357":59396,"_3076":59962},[],"With Helm, enable the hook for the upgrade in step 2; without Helm, run the tool by hand.",{"_3624":2919,"_31165":2708,"_21590":59964,"_5":14857,"_28357":59400,"_3076":59965},[],"Certificates now reference their KMS key, and CRL settings reference their signer certificate, so a key or certificate in use cannot be deleted. The KMS migration drops the legacy `lamassu.io/kms/binded-resources` key metadata. Before 4.0.0, deleting a CA could remove its key while leaving key references in its retained certificate records. The CA migration registers those missing keys in the KMS with only their public key to satisfy the retained references. These entries cannot be deleted while the retained certificates reference them; they do not restore the private key. In 4.0.0, deleting a CA releases the references from its own current certificate and linked reissued certificates before attempting to delete the key; other certificates that still reference it prevent deletion.",{"_3624":2920,"_31165":2708,"_21590":59967,"_5":14857,"_28357":59408,"_3076":59968},[],"Stored webhook configs are rewritten to the current layout and their fields renamed:",{"_3624":2921,"_31165":2708,"_21590":59970,"_5":14857,"_28357":59408,"_3076":59971},[],"Field in 3.8.0",{"_3624":2922,"_31165":2708,"_21590":59973,"_5":14857,"_28357":59408,"_3076":59974},[],"Field in 4.0.0",{"_3624":2923,"_31165":2708,"_21590":59976,"_5":14857,"_28357":59408,"_3076":59977},[],"`validate_server_cert`",{"_3624":2924,"_31165":2708,"_21590":59979,"_5":14857,"_28357":59408,"_3076":59980},[],"`insecure_skip_verify` (value negated)",{"_3624":2925,"_31165":2708,"_21590":59982,"_5":14857,"_28357":59408,"_3076":59983},[],"`oidc`",{"_3624":2926,"_31165":2708,"_21590":59985,"_5":14857,"_28357":59408,"_3076":59986},[],"`jwt_options`",{"_3624":2927,"_31165":2708,"_21590":59988,"_5":14857,"_28357":59408,"_3076":59989},[],"`apikey`",{"_3624":2928,"_31165":2708,"_21590":59991,"_5":14857,"_28357":59408,"_3076":59992},[],"`apikey_options`",{"_3624":2929,"_31165":2708,"_21590":59994,"_5":14857,"_28357":59408,"_3076":59995},[],"`mtls`",{"_3624":2930,"_31165":2708,"_21590":59997,"_5":14857,"_28357":59408,"_3076":59998},[],"`mtls_options`",{"_3624":2931,"_31165":2708,"_21590":60000,"_5":14857,"_28357":59408,"_3076":60001},[],"When the legacy mTLS certificate and key are both PEM, they move into `mtls_options.cert_content` and `mtls_options.key_content` and need no action. Two cases do need it.",{"_3624":2932,"_31165":2708,"_21590":60003,"_5":14857,"_28357":59408,"_3076":60004},[],"**Webhooks with file references.** A mixed config, with a PEM certificate and a file-path key, is migrated to `mtls_options.cert_file` and `mtls_options.key_file`. Webhook delivery rejects those fields on every call, whatever the configured authentication mode, so every enroll and re-enroll that calls that webhook fails until the config is fixed. If the webhook uses mTLS, re-enter the certificate and key as Base64-encoded or plain PEM; if it does not, remove the leftover file fields. Metadata-only updates keep working in the meantime (`PUT` or `PATCH` on `/v1/dms/:id/metadata`). In a variant of the same problem, a stored config with file paths inside `mtls_options.cert_content` or `mtls_options.key_content` makes every full settings update (`POST /v1/dms` or `PUT /v1/dms/:id`) fail validation; settings are replaced wholesale, so resend the config with the certificate and key as PEM.",{"_3624":2933,"_31165":2708,"_21590":60006,"_5":14857,"_28357":59408,"_3076":60007},[],"**Receiver certificate verification.** A config with `validate_server_cert: false` becomes `insecure_skip_verify: true`, so receiver verification stays skipped until that field is set to `false`. Correct it on every migrated config: the webhook authorization channel carries the API key or bearer token, and skipping verification exposes those credentials to a network-positioned attacker. Keep `insecure_skip_verify: true` only when the receiver certificate is deliberately unverifiable.",{"_3624":2934,"_31165":2708,"_21590":60009,"_5":14857,"_28357":59412,"_3076":60010},[],"The flat field `reenrollment_settings.additional_validation_cas` moves into the nested field `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`:",{"_3624":2935,"_31165":2708,"_21590":60012,"_5":14857,"_28357":59412,"_3076":60013},[],"The effective trust set does not change, because the nested value was never consulted when validating re-enrollments. If the flat list was missing or null, it becomes an empty list.",{"_3624":2936,"_31165":2708,"_21590":60015,"_5":14857,"_28357":59412,"_3076":60016},[],"What changes is how API requests are handled. Bodies that still carry `additional_validation_cas` are accepted, but the value is silently dropped because unknown JSON fields are ignored, and GET responses no longer include it. An update body built from the old layout therefore empties `validation_cas` without any error. Always read the DMS before sending an edit and reuse the layout the API returns.",{"_3624":2937,"_31165":2708,"_21590":60018,"_5":14857,"_28357":59416,"_3076":60019},[],"Enrollment and re-enrollment now verify the revocation of the presented certificates and fail closed when it cannot be verified. There is no migration: every pre-existing DMS has the new `allow_unverifiable_revocation` option at its default `false`, so a certificate that is not managed by Lamassu and carries no OCSP or CRL distribution points is rejected until the option is set to `true` in the affected block, independently for the enrollment and the re-enrollment block.",{"_3624":2938,"_31165":2708,"_21590":60021,"_5":14857,"_28357":59416,"_3076":60022},[],"Certificates that do carry endpoints are still strictly checked: unreachable endpoints, stale or inconclusive answers reject the certificate even when `allow_unverifiable_revocation` is enabled, and certificates managed by Lamassu are unaffected because their stored status is used. A validation CA revoked in Lamassu also rejects the operation, without falling back to the remaining validation CAs. See the DMS guide and Revocation and checks.",{"_3624":2939,"_31165":2708,"_21590":60024,"_5":14857,"_28357":59420,"_3076":60025},[],"Re-enrollment authentication settings are now stored independently from initial authentication. Nothing needs migrating, but read both blocks before editing a DMS so that you do not modify one while believing you are editing the other. The console exposes independent editors for both blocks; the DMS guide describes their fields, and you can also edit them through the DMS API.",{"_3624":2940,"_31165":2708,"_21590":60027,"_5":14857,"_28357":59424,"_3076":60028},[],"`PUT /v1/dms/:id` takes the DMS ID from the URL and validates the request body. An ID in the body is ignored, so update clients that relied on it.",{"_3624":2941,"_31165":2708,"_21590":60030,"_5":14857,"_28357":59428,"_3076":60031},[],"Stored certificate type values are renamed: `IMPORTED` becomes `IMPORTED_WITH_KEY` and `EXTERNAL` becomes `IMPORTED_WITHOUT_KEY`. `MANAGED` is unchanged. Adapt consumers that read or match on those values.",{"_3624":2942,"_31165":2708,"_21590":60033,"_5":14857,"_28357":59432,"_3076":60034},[],"The `events` field no longer appears in the device representation. Point consumers at the new endpoints:",{"_3624":2943,"_31165":2708,"_21590":60036,"_5":14857,"_28357":59432,"_3076":60037},[],"`GET /v1/devices/:id/events` returns a device's events.",{"_3624":2944,"_31165":2708,"_21590":60039,"_5":14857,"_28357":59432,"_3076":60040},[],"`POST /v1/devices/:id/events` creates an event.",{"_3624":2945,"_31165":2708,"_21590":60042,"_5":14857,"_28357":59432,"_3076":60043},[],"When the request `Accept` header includes `text/event-stream`, the events endpoint streams over SSE with a keepalive every 15 seconds, and returns `501` when SSE is disabled in the deployment. Each Device Manager instance binds a durable AMQP queue named after its service ID, `device-manager-sse-<uuid>`. Queues from crashed or replaced instances linger until removed, so configure an expiration or cleanup policy on the broker.",{"_3624":2946,"_31165":2708,"_21590":60045,"_5":14857,"_28357":59436,"_3076":60046},[],"`crl_options.subject_key_id_signer` is replaced by the required `crl_options.signer_serial_number`, the serial number of the existing certificate that signs the CRL. A new CA's initial value is the serial number of its current certificate. Requests that still carry `subject_key_id_signer` return an error. The authorization entity that holds these settings is also renamed; see CRL settings keyed by CA ID.",{"_3624":2947,"_31165":2708,"_21590":60048,"_5":14857,"_28357":59440,"_3076":60049},[],"In 3.8.0 the VA keyed each CRL by the CA's SKI, and `GET`/`PUT /v1/roles/{ca-ski}` read and updated it. In 4.0.0 the CRL settings of a CA are keyed by its CA ID, and every CA has its own, even when two CAs share a key:",{"_3624":2948,"_31165":2708,"_21590":60051,"_5":14857,"_28357":59440,"_3076":60052},[],"Route",{"_3624":2949,"_31165":2708,"_21590":60054,"_5":14857,"_28357":59440,"_3076":54349},[],{"_3624":2950,"_31165":2708,"_21590":60056,"_5":14857,"_28357":59440,"_3076":60057},[],"`GET /v1/crl-settings`",{"_3624":2951,"_31165":2708,"_21590":60059,"_5":14857,"_28357":59440,"_3076":60060},[],"Lists the CRL settings; filterable at least by `ca_id`, `status` and `legacy_ski`.",{"_3624":2952,"_31165":2708,"_21590":60062,"_5":14857,"_28357":59440,"_3076":60063},[],"`GET /v1/crl-settings/{ca-id}`",{"_3624":2953,"_31165":2708,"_21590":60065,"_5":14857,"_28357":59440,"_3076":60066},[],"Reads the settings of a CA.",{"_3624":2954,"_31165":2708,"_21590":60068,"_5":14857,"_28357":59440,"_3076":60069},[],"`PUT /v1/crl-settings/{ca-id}`",{"_3624":2955,"_31165":2708,"_21590":60071,"_5":14857,"_28357":59440,"_3076":60072},[],"Replaces `crl_options`.",{"_3624":2956,"_31165":2708,"_21590":60074,"_5":14857,"_28357":59440,"_3076":60075},[],"`DELETE /v1/crl-settings/{ca-id}`",{"_3624":2957,"_31165":2708,"_21590":60077,"_5":14857,"_28357":59440,"_3076":60078},[],"Removes the archived settings of a CA.",{"_3624":2958,"_31165":2708,"_21590":60080,"_5":14857,"_28357":59440,"_3076":60081},[],"The options keep their meaning and their defaults: 7 days of `validity`, 6 days and 23 hours of `refresh_interval`, and `regenerate_on_revoke` `true`. `status` (`ACTIVE`, `FINAL` or `ARCHIVED`), `legacy_ski` and `latest_crl` are read-only. A `PUT` validates the signer only when it changes, does not regenerate the CRL, and returns `409` when the settings are not `ACTIVE`.",{"_3624":2959,"_31165":2708,"_21590":60083,"_5":14857,"_28357":59440,"_3076":60084},[],"The public endpoint `GET /crl/{id}` takes the CA ID — the form the CDPs of newly issued certificates use — and keeps resolving the SKI form of certificates issued before the upgrade. Certificates issued before the upgrade keep their `/crl/<ski>` distribution points; newly issued ones carry `/crl/<ca-id>`, and both resolve to the same settings. The VA scheduled CRL job requests a new list on its first run, and the new list includes both URLs in its *Issuing Distribution Point*. Until it succeeds, the old list has only the legacy `/crl/<ski>` IDP: verifiers that compare it with the CDP of newly issued certificates cannot validate those certificates. The default schedule can delay the first run by up to about an hour; failures can extend the window.",{"_3624":2960,"_31165":2708,"_21590":60086,"_5":14857,"_28357":59440,"_3076":60087},[],"The migration that turns VA roles into CRL settings cannot be rolled back: its rollback does nothing. CRLs generated after the upgrade are stored under the CA ID, where 3.8.0 does not look for them, and the archived settings of CAs deleted before the upgrade have no signer to go back to. Returning to 3.8.0 requires restoring both the database and the CRL bucket — the object storage that holds the published lists — from the backups taken before the upgrade.",{"_3624":2961,"_31165":2708,"_21590":60089,"_5":14857,"_28357":59440,"_3076":60090},[],"The migration aborts, and the upgrade fails, on five kinds of data:",{"_3624":2962,"_31165":2708,"_21590":60092,"_5":14857,"_28357":59440,"_3076":60093},[],"CA IDs containing `/`: they cannot be used in CRL URLs. Recreate those CAs with a different ID.",{"_3624":2963,"_31165":2708,"_21590":60095,"_5":14857,"_28357":59440,"_3076":60096},[],"An SKI shared by more than one CA: the error names the SKIs and asks you to recreate all but one of them on a different key.",{"_3624":2964,"_31165":2708,"_21590":60098,"_5":14857,"_28357":59440,"_3076":60099},[],"A VA role whose signer certificate has no key: point the role to a signer with a key, or fix the key reference of the certificate, before upgrading.",{"_3624":2965,"_31165":2708,"_21590":60101,"_5":14857,"_28357":59440,"_3076":60102},[],"A CA whose ID equals the `legacy-<ski>` ID the migration reserves for the archived settings of another role whose CA was deleted: recreate that CA with a different ID.",{"_3624":2966,"_31165":2708,"_21590":60104,"_5":14857,"_28357":59440,"_3076":60105},[],"A CA ID equal to the SKI of another VA role: their CRL URLs would be ambiguous.",{"_3624":2967,"_31165":2708,"_21590":60107,"_5":14857,"_28357":59440,"_3076":60108},[],"The settings of a CA deleted before the upgrade are migrated as `ARCHIVED`, with a `legacy-<ski>` ID and no signer: their last CRL is still served, but never regenerated, and `PUT` returns `409`. There is no API way back to `ACTIVE`. The CRL guide describes the full behavior.",{"_3624":2968,"_31165":2708,"_21590":60110,"_5":14857,"_28357":59440,"_3076":60111},[],"**Custom authorization policies.** The entity `va_role` is renamed to `crl_settings`, with `ca_id` as its primary key and `signer_serial_number` as its relation to certificates. Update policies referencing the old entity. The entity gains the `delete` atomic action, a `signer_key_id` relation to KMS keys, and the filterable columns `signer_engine_id` and `signer_key_id`; grant the new action to whoever may delete archived CRL settings. Replace the 3.8.0 signer filter `crl_subject_key_id_signer` (or `crl_signer_certificate_serial_number` if used by an intermediate version) with `signer_serial_number`. Replace SKI filter values with the corresponding certificate serial numbers; renaming the filter alone is insufficient.",{"_3624":2969,"_31165":2708,"_21590":60113,"_5":14857,"_28357":59444,"_3076":60114},[],"`va.role.update` becomes `va.crl-settings.update` and `va.role.crl.init` becomes `va.crl-settings.init`; `va.role.crl.create` keeps its name and its payload. Every subject changes from `crl/<ski>` to `crl/<ca-id>`, and the payload of the renamed events changes from the old VA role to the CRL settings of the CA, with `ca_id` instead of `ca_ski`. The alerts migration renames the event types of existing subscriptions automatically, but it does not rewrite their conditions — JSON Path, JSON Schema or JavaScript: review conditions that filter on the old payload or on the old `crl/<ski>` subject, including those for `va.role.crl.create`. Direct event-bus consumers and audit searches must adopt the new names and payload themselves.",{"_3624":2970,"_31165":2708,"_21590":60116,"_5":14857,"_28357":59448,"_3076":60117},[],"`POST /v1/cas/{id}/signature/sign` and `POST /v1/cas/{id}/signature/verify` no longer exist: the CA service no longer signs or verifies arbitrary data, so a CA's private key only signs certificates. The Go SDK's `CAService.SignatureSign` and `CAService.SignatureVerify` methods are removed too, and the `ca.sign.signature` event is no longer published, so alert subscriptions and event-bus consumers that rely on it never fire again — remove those subscriptions and point consumers elsewhere. Sign and verify arbitrary data with a KMS key instead, through `POST /api/kms/v1/keys/{id}/sign` and `POST /api/kms/v1/keys/{id}/verify` (the Go SDK's `KMSService.SignMessage` and `KMSService.VerifySignature`); the console equivalent is described in Sign and verify. A CA is also only accepted for signing when its validity window includes the current time, even if its stored status still reads `ACTIVE`.",{"_3624":2971,"_31165":2708,"_21590":60119,"_5":14857,"_28357":59452,"_3076":60120},[],"Creating or importing a CA registers it under a backend-generated UUID. Any `id` sent in the request body is ignored, and the field is removed from the create and import bodies. Scripts that supplied their own IDs and addressed CAs by them must read the ID the backend returns instead.",{"_3624":2972,"_31165":2708,"_21590":60122,"_5":14857,"_28357":59456,"_3076":60123},[],"A CA key now signs only certificates. 3.8.0 let a client sign arbitrary data with a CA key through `POST /v1/cas/{id}/signature/sign` and check the result with `POST /v1/cas/{id}/signature/verify`. 4.0.0 removes both endpoints, the matching `SignatureSign` and `SignatureVerify` methods of the Go SDK `CAService`, and the `ca.sign.signature` event. An alert subscription on that event no longer fires: delete it or move it to another event.",{"_3624":2973,"_31165":2708,"_21590":60125,"_5":14857,"_28357":59456,"_3076":60126},[],"To sign and verify data, use the KMS operations `POST /v1/keys/{id}/sign` and `POST /v1/keys/{id}/verify`, which have their own authorization. Signing a certificate with a CA that is not `ACTIVE` or whose validity period does not include the current time now fails with `400`, even if the stored status has not yet changed to `EXPIRED`: see Certificate authorities.",{"_3624":2974,"_31165":2708,"_21590":60128,"_5":14857,"_28357":59459,"_3076":60129},[],"The VA migration resolves each role's signer from its stored SKI. It first looks for CA certificates with that SKI; if several match, it selects the oldest CA and logs a warning. If no CA certificate matches, it looks among all certificates with that SKI. The migration aborts with `cannot resolve signer certificate for VA role <ca-ski>, SKI <ski>` if that fallback finds zero or multiple candidates. Fix affected roles before upgrading.",{"_3624":2975,"_31165":2708,"_21590":60131,"_5":14857,"_28357":59463,"_3076":60132},[],"The upgrade runs in a fixed order: prepare the data and values, run `helm upgrade`, then copy the KMS and VA data into the new volumes. The copy must run after the upgrade, because the destination StatefulSets and PVCs do not exist before it. If you are not upgrading an existing release, go straight to Install with Helm.",{"_3624":2976,"_31165":2708,"_21590":60134,"_5":14857,"_28357":59467,"_3076":60135},[],"Take a verifiable backup of PostgreSQL and of the CRL object storage — the VA bucket, or the local volume that holds the CRLs — and schedule downtime. The upgrade moves every service's data into `pki`, and the VA migration is irreversible: returning to 3.8.0 needs both backups (see CRL settings keyed by CA ID).",{"_3624":2977,"_31165":2708,"_21590":60137,"_5":14857,"_28357":59467,"_3076":60138},[],"If the deployment runs on SQLite, `couch_db` or `dynamo_db`, move it to PostgreSQL first.",{"_3624":2978,"_31165":2708,"_21590":60140,"_5":14857,"_28357":59467,"_3076":60141},[],"Resolve duplicate CA IDs and backfill `engine_id` in `kms_keys`, as described in PostgreSQL consolidation.",{"_3624":2979,"_31165":2708,"_21590":60143,"_5":14857,"_28357":59467,"_3076":60144},[],"Optionally, run the pre-upgrade check against the consolidated 3.8.0 data before applying the migrations.",{"_3624":2980,"_31165":2708,"_21590":60146,"_5":14857,"_28357":59467,"_3076":60147},[],"Record the names of your local-storage PVCs:",{"_3624":2981,"_31165":2708,"_21590":60149,"_5":14857,"_28357":59467,"_3076":60150},[],"`helm upgrade` does not touch or delete the old PVCs, but nothing references them after the upgrade. You need their names to copy the data and to clean up later.",{"_3624":2982,"_31165":2708,"_21590":60152,"_5":14857,"_28357":59471,"_3076":60153},[],"The 4.0.0 database migrations refuse data they cannot migrate safely: they abort and name the offending objects. The `upgrade-check` tool reports all of those problems before the upgrade, in one run, with the same wording the migration would use. It is read-only: it never writes database rows or keys.",{"_3624":2983,"_31165":2708,"_21590":60155,"_5":14857,"_28357":59471,"_3076":60156},[],"Image: `ghcr.io/lamassuiot/lamassu-upgrade-check`. Configure it with a KMS-style YAML file passed through `LAMASSU_CONFIG_FILE`; only the `postgres` storage provider is supported.",{"_3624":2984,"_31165":2708,"_21590":60158,"_5":14857,"_28357":59471,"_3076":60159},[],"Run it on the 3.8.0 data after it has been consolidated into the `pki` schemas, and before any 4.0.0 migration runs or any 4.0.0 service starts.",{"_3624":2985,"_31165":2708,"_21590":60161,"_5":14857,"_28357":59471,"_3076":60162},[],"Exit codes: `0` means no problems were found, `1` means at least one problem was found, and `2` means the command could not run (bad configuration, unreachable database, or a database that is not a 3.8.0 one), or a check could not run.",{"_3624":2986,"_31165":2708,"_21590":60164,"_5":14857,"_28357":59471,"_3076":60165},[],"It covers the VA migrations only: an all-clear does not prove that the CA and KMS migration guards pass, so it does not replace the duplicate CA ID and `engine_id` checks described in PostgreSQL consolidation.",{"_3624":2987,"_31165":2708,"_21590":60167,"_5":14857,"_28357":59475,"_3076":60168},[],"**Create the credential Secrets.** The 4.0.0 chart reads PostgreSQL, AMQP and SMTP credentials from Kubernetes Secrets, and the pre-upgrade database job needs them before the upgrade runs. Copy the 3.8.0 credentials into your secret-management provider and create the Secrets with the External Secrets Operator (ESO), which the chart does not install:",{"_3624":2988,"_31165":2708,"_21590":60170,"_5":14857,"_28357":59475,"_3076":60171},[],"Configure ESO and its provider (`SecretStore` or `ClusterSecretStore`).",{"_3624":2989,"_31165":2708,"_21590":60173,"_5":14857,"_28357":59475,"_3076":60174},[],"Create an `ExternalSecret` for each credential set you use. Its target Secret must live in the release namespace, be named after the corresponding `existingSecret` value, and contain these keys:",{"_3624":2990,"_31165":2708,"_21590":60176,"_5":14857,"_28357":59475,"_3076":60177},[],"Secret (`existingSecret`)",{"_3624":2991,"_31165":2708,"_21590":60179,"_5":14857,"_28357":59475,"_3076":60180},[],"Required data keys",{"_3624":2992,"_31165":2708,"_21590":60182,"_5":14857,"_28357":59475,"_3076":60183},[],"When",{"_3624":2993,"_31165":2708,"_21590":60185,"_5":14857,"_28357":59475,"_3076":60186},[],"`lamassu-postgres` (default of `postgres.existingSecret`)",{"_3624":2994,"_31165":2708,"_21590":60188,"_5":14857,"_28357":59475,"_3076":60189},[],"`username`, `password`",{"_3624":2995,"_31165":2708,"_21590":60191,"_5":14857,"_28357":59475,"_3076":60192},[],"Always",{"_3624":2996,"_31165":2708,"_21590":60194,"_5":14857,"_28357":59475,"_3076":60195},[],"`lamassu-amqp` (default of `amqp.existingSecret`)",{"_3624":2997,"_31165":2708,"_21590":60197,"_5":14857,"_28357":59475,"_3076":60189},[],{"_3624":2998,"_31165":2708,"_21590":60199,"_5":14857,"_28357":59475,"_3076":60192},[],{"_3624":2999,"_31165":2708,"_21590":60201,"_5":14857,"_28357":59475,"_3076":60202},[],"`services.alerts.smtp_server.existingSecret`",{"_3624":3000,"_31165":2708,"_21590":60204,"_5":14857,"_28357":59475,"_3076":60189},[],{"_3624":3001,"_31165":2708,"_21590":60206,"_5":14857,"_28357":59475,"_3076":60207},[],"Only when SMTP authentication is enabled",{"_3624":3002,"_31165":2708,"_21590":60209,"_5":14857,"_28357":59475,"_3076":60210},[],"Wait for every `ExternalSecret` to be Ready and verify the generated Secrets before running the upgrade.",{"_3624":3003,"_31165":2708,"_21590":60212,"_5":14857,"_28357":59475,"_3076":60213},[],"Do not change the database or broker passwords as part of this migration: ESO synchronizes credentials into Secrets, but it does not update the users configured on the PostgreSQL server or the broker. Removing credentials from the values file does not undo past exposure — if they were ever committed to Git, rotate them after the migration is complete.",{"_3624":3004,"_31165":2708,"_21590":60215,"_5":14857,"_28357":59475,"_3076":60216},[],"The `charts/lamassu/README.md` in the Helm repository documents a full worked example in its *Secret management* section: installing external-secrets 0.20.2, a test Fake `ClusterSecretStore`, the `ExternalSecret` resources and the wait for synchronization. Its Fake provider is for testing only; for production, replace it with your provider's configuration.",{"_3624":3005,"_31165":2708,"_21590":60218,"_5":14857,"_28357":59475,"_3076":60219},[],"**Add `services.authz`.** Configure the JWKS endpoint, the database mappings and the bootstrap principal:",{"_3624":3006,"_31165":2708,"_21590":60221,"_5":14857,"_28357":59475,"_3076":60222},[],"`jwkUrl` is fetched from the `authz` pod, not from the gateway, so a Service in the release namespace can be referenced by its short name. The default points at a Keycloak Service named `auth-keycloak`; set it explicitly if your identity provider lives anywhere else.",{"_3624":3007,"_31165":2708,"_21590":60224,"_5":14857,"_28357":59475,"_3076":60225},[],"`authz` is the authorization service's own storage for principals, grants and policies. `pki` is the database the authorization engine queries when it evaluates policies against entities. Only the `database` field of each entry is required; per-schema `hostname` and `port` values remain accepted but are ignored — the connection always uses the global `postgres.hostname` and `postgres.port` with the global PostgreSQL credential Secret, `postgres.existingSecret` with its configured key names, unless the entry sets its own `existingSecret` (with optional `usernameKey` and `passwordKey`).",{"_3624":3008,"_31165":2708,"_21590":60227,"_5":14857,"_28357":59475,"_3076":60228},[],"If you kept the 3.8.0 role defaults (`realm_access.roles` and `pki-admin`), the default `services.authz.bootstrap` already matches them.",{"_3624":3009,"_31165":2708,"_21590":60230,"_5":14857,"_28357":59475,"_3076":60231},[],"**Delete the gateway token validation blocks.** Remove `auth.oidc.apiGateway` and `auth.authorization` once their settings are in `services.authz`:",{"_3624":3010,"_31165":2708,"_21590":60233,"_5":14857,"_28357":59475,"_3076":60234},[],"**Rename `toolbox` to `connectivityTest`:**",{"_3624":3011,"_31165":2708,"_21590":60236,"_5":14857,"_28357":59475,"_3076":60237},[],"**Remove the per-service identity overrides** `services.kms.securityContext.runAsGroup` and `services.authz.securityContext.runAsUser`/`runAsGroup`.",{"_3624":3012,"_31165":2708,"_21590":60239,"_5":14857,"_28357":59475,"_3076":60240},[],"**Convert `services.connectors` to a map** keyed by connector ID, each entry with its `type` and `image`:",{"_3624":3013,"_31165":2708,"_21590":60242,"_5":14857,"_28357":59475,"_3076":60243},[],"**Check AMQP.** If you set `amqp.tls: true`, also set `amqp.port` to the broker's TLS listener (commonly `5671`), or set `amqp.tls: false` to stay on plaintext.",{"_3624":3014,"_31165":2708,"_21590":60245,"_5":14857,"_28357":59475,"_3076":60246},[],"**Enable the CA-to-KMS migration** if your CA keys predate the KMS:",{"_3624":3015,"_31165":2708,"_21590":60248,"_5":14857,"_28357":59475,"_3076":60249},[],"**Review the remaining values:** overrides that pinned `services.ui.port` to `80`, the old `probes:` block, the TLS issuer, and explicit `affinity` and `topologySpreadConstraints` where your cluster needs them. Renamed and reshaped values describes each one.",{"_3624":3016,"_31165":2708,"_21590":60251,"_5":14857,"_28357":59475,"_3076":60252},[],"Run `helm lint` with the new values before upgrading; the strict schema reports any key that is still unknown. Before running Step 3, confirm every credential `ExternalSecret` is Ready and the generated Secrets contain the expected keys.",{"_3624":3017,"_31165":2708,"_21590":60254,"_5":14857,"_28357":59479,"_3076":60255},[],"Helm runs the pre-upgrade hooks — the CA-to-KMS migration when enabled, and the database job — before applying any workload, so services never start against an unprepared database. If validation rejects unknown values, fix the values file and re-run.",{"_3624":3018,"_31165":2708,"_21590":60257,"_5":14857,"_28357":59479,"_3076":60258},[],"If the deployment uses local KMS or VA storage, those pods fail until you complete step 4, so `--wait` cannot succeed: Helm waits for them to become ready, times out, exits with an error and marks the release `failed`. The hooks have already run by then, and every manifest, including the new StatefulSets and their PVCs, has been applied. Helm does not roll anything back without `--atomic`. Continue with step 4, then re-run the same `helm upgrade` command so it completes and Helm records the release as `deployed`. Both hooks are idempotent, so they are safe to run again.",{"_3624":3019,"_31165":2708,"_21590":60260,"_5":14857,"_28357":59483,"_3076":60261},[],"Skip this step when `services.kms.cryptoEngines` never used a `filesystem` engine and `services.va.fileStore.type` was never `local`.",{"_3624":3020,"_31165":2708,"_21590":60263,"_5":14857,"_28357":59483,"_3076":60264},[],"**Find the new StatefulSets and PVCs.** Their names depend on the release name and any `nameOverride` or `fullnameOverride`; the PVC name is `<volumeClaimTemplate>-<StatefulSet name>-0`:",{"_3624":3021,"_31165":2708,"_21590":60266,"_5":14857,"_28357":59483,"_3076":60267},[],"With release `lamassu` and the default chart name, the new PVCs are `golang-engine-storage-lamassu-kms-0` and `local-crl-file-storage-lamassu-va-0`; with release `prod` they are `golang-engine-storage-prod-lamassu-kms-0` and `local-crl-file-storage-prod-lamassu-va-0`. Confirm both old and new PVCs exist before continuing. If `claims_ok` prints `ABORT`, the block stops before listing the claims: either a StatefulSet lookup failed, or a new claim resolves to the 3.8.0 claim. In the second case the copy would verify against itself and the final cleanup would delete the live volume. The chart always appends `-kms` and `-va` to the release-scoped name, so a collision means the claims are not what this guide expects; investigate before going on. Item 3 runs the same check and refuses to create the helper pod, so nothing touches the volumes. The check returns instead of calling `exit`, which would close your shell and lose the variables set so far. If you only migrate one of the two services, drop the other one's claims from the commands that follow.",{"_3624":3022,"_31165":2708,"_21590":60269,"_5":14857,"_28357":59483,"_3076":60270},[],"**Record the replica counts, scale the new StatefulSets down and wait for every pod that uses the claims to exit**, so nothing writes to either volume while you copy. Helm removes the 3.8.0 `kms` and `va` StatefulSets during the upgrade, but their pods `kms-0` and `va-0` can still be terminating and holding the old claims. While they run, the helper pod either cannot attach the claims or copies a volume that is still being written. The `wait` returns at once for pods that are already gone:",{"_3624":3023,"_31165":2708,"_21590":60272,"_5":14857,"_28357":59483,"_3076":60273},[],"**Run a short-lived helper pod** that mounts all four claims. It runs as root so it can change file ownership, so pin its image by digest and do not mount the service-account token:",{"_3624":3024,"_31165":2708,"_21590":60275,"_5":14857,"_28357":59483,"_3076":60276},[],"**Inspect before writing** so you do not clobber data the new pods may already have written:",{"_3624":3025,"_31165":2708,"_21590":60278,"_5":14857,"_28357":59483,"_3076":60279},[],"An empty result is the common case: a StatefulSet's own pod rarely gets far enough to write anything when its dependent data is missing. If the output is not empty, record the files and confirm with the service owner that they are disposable before you run the copy; do not overlay the 3.8.0 data onto an unknown store.",{"_3624":3026,"_31165":2708,"_21590":60281,"_5":14857,"_28357":59483,"_3076":60282},[],"**Copy the data, align ownership and verify the copy.** The second command must print `copy verified`; any `diff` output means the copy is incomplete, so do not continue:",{"_3624":3027,"_31165":2708,"_21590":60284,"_5":14857,"_28357":59483,"_3076":60285},[],"The `chown` is required even if the old files already look non-root-owned, because 4.0.0 requires exactly `65532:65532` and does not fall back to whatever the image declares.",{"_3624":3028,"_31165":2708,"_21590":60287,"_5":14857,"_28357":59483,"_3076":60288},[],"**Remove the helper and restore the recorded replica counts:**",{"_3624":3029,"_31165":2708,"_21590":60290,"_5":14857,"_28357":59483,"_3076":60291},[],"**Re-run the step 3 `helm upgrade` command.** The KMS and VA pods now start against the copied data, so `--wait` succeeds and the release moves from `failed` to `deployed`.",{"_3624":3030,"_31165":2708,"_21590":60293,"_5":14857,"_28357":59487,"_3076":60294},[],"After the upgrade that performed the CA-to-KMS migration succeeds, remove `migrations.caToKms.enabled` from your values (it defaults to `false`). The hook reads the legacy 3.8.0 `kms-config` ConfigMap while it still exists and falls back to the release-scoped `<release>-lamassu-kms-config` once it is gone.",{"_3624":3031,"_31165":2708,"_21590":60296,"_5":14857,"_28357":59487,"_3076":60297},[],"Then go through the validation checklist. Keep the old PVCs until it passes.",{"_3624":3032,"_31165":2708,"_21590":60299,"_5":14857,"_28357":59491,"_3076":60300},[],"Without the chart's database job, no tool moves data between databases: the migration tooling only applies migrations to a schema that already exists. Move each per-service database into its `pki` schema yourself, preserving structure, indexes, constraints, data and migration history, with writes stopped and a verified backup in hand.",{"_3624":3033,"_31165":2708,"_21590":60302,"_5":14857,"_28357":59491,"_3076":60303},[],"Run the migrations in the required order, one schema at a time: `kms` first, then the `ca-to-kms-migration` tool (needed only for legacy deployments whose CA keys are named by SKI), then `ca`, then `va`. The `devicemanager`, `dmsmanager` and `alerts` schemas are independent and can be migrated in any order. With Helm, the chart's pre-install job applies the schemas in the correct order automatically.",{"_3624":3034,"_31165":2708,"_21590":60305,"_5":14857,"_28357":59491,"_3076":60306},[],"If `kms` has not been migrated, the `ca` migration fails with `kms schema not found: migrate the kms schema before the ca schema`. The `va` migration requires `ca` and `kms` to be migrated first: it fails with `ca schema not found: migrate the ca schema before the va schema` or `kms schema not found: migrate the kms schema before the va schema` if one of them is missing.",{"_3624":3035,"_31165":2708,"_21590":60308,"_5":14857,"_28357":59491,"_3076":60309},[],"The schemas reference each other, so the PostgreSQL role running the migrations needs cross-schema privileges: the `ca` schema needs `USAGE` on `kms` plus `SELECT`, `REFERENCES` and `INSERT` on `kms.kms_keys`, and the `va` schema needs `USAGE` on `ca` plus `SELECT` and `REFERENCES` on `ca.certificates`, `SELECT` on `ca.ca_certificates`, and `USAGE` on `kms` plus `SELECT` and `REFERENCES` on `kms.kms_keys`. Without them the migration aborts; grant the missing privileges and rerun the failed schema. After migrating `ca`, if the CA service runs as a different user than the migration user, grant it `SELECT` on `ca.certificates_view` (`GRANT SELECT ON ca.certificates_view TO service_user`). Without this grant, certificate and CA reads fail with `permission denied for table certificates_view`. After migrating `va`, if the CA service runs as a different user, grant it `USAGE` on the `va` schema and `SELECT` on `va.crl_settings` (`GRANT USAGE ON SCHEMA va TO service_user; GRANT SELECT ON va.crl_settings TO service_user`): the CA service reads `va.crl_settings` when it deletes a CA, and without these grants every deletion of a CA that has a crypto engine fails with `permission denied for schema va` (or `for table crl_settings`).",{"_3624":3036,"_31165":2708,"_21590":60311,"_5":14857,"_28357":59491,"_3076":60312},[],"To apply migrations by hand, `goose-lamassu` must run against the `pki` database with `search_path=<schema>` in the connection string. The binary validates only `search_path`, not the database name, so check `dbname=pki` before running it, and repeat for `kms`, `ca`, `va`, `devicemanager`, `dmsmanager` and `alerts`:",{"_3624":3037,"_31165":2708,"_21590":60314,"_5":14857,"_28357":59491,"_3076":60315},[],"Run `ca-to-kms-migration` first with `--dry-run`, which reports without writing to KMS storage, and then for real:",{"_3624":3038,"_31165":2708,"_21590":60317,"_5":14857,"_28357":59491,"_3076":60318},[],"Point the tool's `storage` configuration at the `pki` database, where the CA and KMS data now live in the `ca` and `kms` schemas. The tool's options are described in `backend/cmd/ca-to-kms-migration/README.md` in the `lamassuiot` repository.",{"_3624":3039,"_31165":2708,"_21590":60320,"_5":14857,"_28357":59491,"_3076":60321},[],"Both tools' READMEs document the 4.0.0 `pki` layout and match this page: `goose-lamassu` uses `dbname=pki` examples and does not validate the database name, and the `ca-to-kms-migration` README describes the single `pki` database and the migration order.",{"_3624":3040,"_31165":2708,"_21590":60323,"_5":14857,"_28357":59495,"_3076":60324},[],"**KMS or VA pods crash with `no such file or directory` or `code=NotFound` right after the upgrade.** The pods are bound to the new, empty PVCs and the data migration has not run yet, or was copied into the wrong PVC. Follow step 4 and check that all four claims exist.",{"_3624":3041,"_31165":2708,"_21590":60326,"_5":14857,"_28357":59495,"_3076":60327},[],"**`helm upgrade --wait` times out and `helm status` reports the release as `failed`.** With local KMS or VA storage this is expected on the first run: the new pods cannot become ready before their data is copied. The hooks ran and the manifests and PVCs were applied, so complete step 4 and re-run the same `helm upgrade` command. If other pods are also not ready, check their logs, because something else is wrong.",{"_3624":3042,"_31165":2708,"_21590":60329,"_5":14857,"_28357":59495,"_3076":60330},[],"**The helper pod stays `Pending` or `ContainerCreating` and `kubectl wait` times out.** Another pod still holds one of the claims; on block storage `kubectl describe pod pvc-migrate-helper` shows a `Multi-Attach error`. Check with `kubectl get pods -n $NAMESPACE` that `kms-0`, `va-0` and the new KMS and VA pods are gone, then re-run the wait.",{"_3624":3043,"_31165":2708,"_21590":60332,"_5":14857,"_28357":59495,"_3076":60333},[],"**`helm upgrade` fails with an unknown-key validation error.** Remove or rename the legacy values — typically `toolbox`, `auth.oidc.apiGateway` or `auth.authorization` — because the strict schema rejects keys it does not know.",{"_3624":3044,"_31165":2708,"_21590":60335,"_5":14857,"_28357":59495,"_3076":60336},[],"**The upgrade fails at the database job.** The PostgreSQL role cannot create databases or schemas, or a schema migration aborted: on duplicate CA IDs or missing `engine_id` values, or in the VA schema on a CA ID containing `/`, an SKI shared by more than one CA (the error asks you to recreate all but one of them on a different key), a role whose signer certificate has no key, a CA ID reserved for the archived settings of another role, or a CA ID equal to another role's SKI. The abort message names the offending objects; fix them and re-run the upgrade.",{"_3624":3045,"_31165":2708,"_21590":60338,"_5":14857,"_28357":59495,"_3076":60339},[],"**The upgrade fails at the CA-to-KMS hook.** CA certificates that share a `subject_key_id` declare conflicting `engine_id`s. Resolve the conflict and re-run.",{"_3624":3046,"_31165":2708,"_21590":60341,"_5":14857,"_28357":59495,"_3076":60342},[],"**Nobody can log in after the upgrade.** Check that `services.authz.jwkUrl` is reachable from the `authz` pod, that `services.authz.bootstrap` matches a role your OIDC provider actually assigns, and that the database job completed.",{"_3624":3047,"_31165":2708,"_21590":60344,"_5":14857,"_28357":59495,"_3076":60345},[],"**A migration aborts with `kms schema not found`.** The schemas must be migrated in order: run the `kms` schema migration before the `ca` and `va` schema migrations.",{"_3624":3048,"_31165":2708,"_21590":60347,"_5":14857,"_28357":59495,"_3076":60348},[],"**A migration aborts with `ca schema not found`.** Run the `ca` schema migration before the `va` schema migration.",{"_3624":3049,"_31165":2708,"_21590":60350,"_5":14857,"_28357":59495,"_3076":60351},[],"**The VA migration fails with `cannot resolve signer certificate for VA role ... N candidates`.** The migration cannot uniquely identify a signer certificate from the SKI stored on the role. Review the SKI and candidate certificates reported in the error; correct the pre-migration data with a verified backup and rerun the migration. The new `signer_serial_number` field is created during that migration, so it cannot be set through the VA API while the migration is failing.",{"_3624":3050,"_31165":2708,"_21590":60353,"_5":14857,"_28357":59495,"_3076":60354},[],"**A migration or service fails with `permission denied for table ...` or `permission denied for schema ...`.** The PostgreSQL role is missing the cross-schema privileges listed in Deployments without Helm; this includes `certificates_view` when the post-migration `GRANT SELECT` was skipped, and `permission denied for schema va` (or `for table crl_settings`) when deleting a CA without the `va` grants. Grant the missing privileges and re-run.",{"_3624":3051,"_31165":2708,"_21590":60356,"_5":14857,"_28357":59498,"_3076":60357},[],"After the upgrade, check in this order:",{"_3624":3052,"_31165":2708,"_21590":60359,"_5":14857,"_28357":59498,"_3076":60360},[],"**Databases.** Each service reads the `pki` database with its own schema, `authz` and `wfx` data are reachable, and the migration status is registered per schema, including the CA unique-ID and KMS composite-key migrations and the foreign-key migrations that run per schema in the required order.",{"_3624":3053,"_31165":2708,"_21590":60362,"_5":14857,"_28357":59498,"_3076":60363},[],"**KMS and VA start cleanly.** Their logs show no `no such file or directory` or `code=NotFound` errors.",{"_3624":3054,"_31165":2708,"_21590":60365,"_5":14857,"_28357":59498,"_3076":60366},[],"**Existing KMS keys work.** Issue a certificate from a CA that existed before the upgrade. None of the other checks reads a KMS key, so this is the only one that proves the key material was copied.",{"_3624":3055,"_31165":2708,"_21590":60368,"_5":14857,"_28357":59498,"_3076":60369},[],"**Existing CRLs are served.** `GET /crl/<ca-id>` on VA returns a previously issued CRL, and `GET /crl/<ca-ski>` with the legacy SKI of a certificate issued before the upgrade also resolves. The VA scheduled CRL job has issued a new list under the CA ID with both URLs in its IDP; check its logs if regeneration has not succeeded.",{"_3624":3056,"_31165":2708,"_21590":60371,"_5":14857,"_28357":59498,"_3076":60372},[],"**Renamed VA events.** Alert subscriptions to `va.role.update` and `va.role.crl.init` now subscribe to `va.crl-settings.update` and `va.crl-settings.init`, and conditions for all VA events, including `va.role.crl.create`, have been reviewed against the new payload (`ca_id` instead of `ca_ski`) and subject (`crl/<ca-id>` instead of `crl/<ski>`). Direct consumers and audit searches use the new event names.",{"_3624":3057,"_31165":2708,"_21590":60374,"_5":14857,"_28357":59498,"_3076":60375},[],"**Legacy CA keys.** If the CA-to-KMS migration ran, review its report and warnings and confirm the expected keys appear in the KMS. Migrated CA certificates now report `key_id` and `has_private_key`, which you can use to confirm the registration.",{"_3624":3058,"_31165":2708,"_21590":60377,"_5":14857,"_28357":59498,"_3076":60378},[],"**Connectivity.** `helm test \"$RELEASE\" -n $NAMESPACE --logs` passes; the hook checks the CA, DMS Manager, Device Manager and VA health endpoints and the UI response.",{"_3624":3059,"_31165":2708,"_21590":60380,"_5":14857,"_28357":59498,"_3076":60381},[],"**Authorization.** Sign in as the bootstrap principal and confirm administration works, check that an identity without permissions receives `403`, and review client and integration permissions.",{"_3624":3060,"_31165":2708,"_21590":60383,"_5":14857,"_28357":59498,"_3076":60384},[],"**AMQP.** The backend connects to the broker with the expected TLS settings, and the cleanup policy for SSE queues is in place.",{"_3624":3061,"_31165":2708,"_21590":60386,"_5":14857,"_28357":59498,"_3076":60387},[],"**Device events.** `GET /v1/devices/:id/events` returns the historical events of a device that had them.",{"_3624":3062,"_31165":2708,"_21590":60389,"_5":14857,"_28357":59498,"_3076":60390},[],"**Webhooks without file fields.** For each DMS that uses a webhook for enrollment or re-enrollment, the `config` block carries `insecure_skip_verify` and the expected option block (`apikey_options`, `jwt_options` or `mtls_options`), with the certificate and key as PEM and no `cert_file` or `key_file`.",{"_3624":3063,"_31165":2708,"_21590":60392,"_5":14857,"_28357":59498,"_3076":60393},[],"**Receiver verification.** `insecure_skip_verify` is `false`, unless the receiver certificate is intentionally unverified.",{"_3624":3064,"_31165":2708,"_21590":60395,"_5":14857,"_28357":59498,"_3076":60396},[],"**Webhook delivery.** One enroll or re-enroll through each migrated webhook completes its authorization call.",{"_3624":3065,"_31165":2708,"_21590":60398,"_5":14857,"_28357":59498,"_3076":60399},[],"**Trust set.** `est_rfc7030_settings.client_certificate_settings.validation_cas` holds the expected CAs, in particular those of the old CA during rotation overlaps.",{"_3624":3066,"_31165":2708,"_21590":60401,"_5":14857,"_28357":59498,"_3076":60402},[],"**API clients.** Scripts and consoles no longer use the old DMS layout (flat `additional_validation_cas`, or the legacy `mtls`, `apikey` and `oidc` fields), send DMS updates with the ID in the URL, and match on the new certificate `type` values.",{"_3624":3067,"_31165":2708,"_21590":60404,"_5":14857,"_28357":59502,"_3076":60405},[],"Only once every check passes, delete the orphaned 3.8.0 volumes to reclaim storage. The delete is irreversible and the old KMS volume may hold the last copy of your CA key material, so take a `VolumeSnapshot` or a backup of both old PVCs first and keep it until you are confident the upgraded deployment is healthy. These are the fixed 3.8.0 names recorded in step 1; before deleting, confirm that neither is mounted by a running pod, for example with `kubectl describe pvc -n $NAMESPACE golang-engine-storage-kms-0 local-crl-file-storage-va-0`, where `Used By` must be `<none>`:",{"_3624":3068,"_31165":2708,"_21590":60407,"_5":14857,"_28357":59502,"_3076":60408},[],"The 3.8.0 per-service databases are no longer used either. Drop them only after the same checks pass and your PostgreSQL backup is verified.",{"_3624":3069,"_31165":2708,"_21590":60410,"_5":14857,"_28357":59502,"_3076":60411},[],"<Card title=\"Install with Helm\" description=\"Prepare dependencies, configure values and install a controlled deployment.\" href=\"/docs/deployment/self-hosted/helm\" />",{"_3624":3070,"_31165":2708,"_21590":60413,"_5":14857,"_28357":59502,"_3076":60414},[],"<Card title=\"Access control\" description=\"Principals, policies and the first administrator.\" href=\"/docs/platform/administration/access-control\" />",{"_3624":3071,"_31165":2708,"_21590":60416,"_5":14857,"_28357":59502,"_3076":60417},[],"<Card title=\"Configure a DMS\" description=\"Enrollment, re-enrollment and webhook settings.\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />","sorting",{"_60420":60421,"_60422":60423,"_60424":60425,"_60426":60427,"_18727":3111,"_72669":3111},"language","english","sortableProperties",[3076,31165,5,28357],"sortablePropertiesWithTypes",{"_3076":25776,"_31165":25776,"_5":25776,"_28357":25776},"sorts",{"_3076":60428,"_31165":63489,"_5":66549,"_28357":69609},{"_4825":60429,"_60430":60431,"_5":25776},{"_14938":4460,"_15317":7946,"_15336":3549,"_30165":20061,"_15323":7252,"_20502":4155,"_14959":7908,"_14966":7487,"_30107":7918,"_30515":5036,"_30542":3576,"_30141":4982,"_35538":4367,"_30244":7810,"_30586":5121,"_35545":30757,"_35548":7340,"_35551":6232,"_35554":4781,"_30988":9815,"_35559":3372,"_35561":4230,"_31023":19443,"_15332":13908,"_35565":5357,"_35568":4539,"_35570":6434,"_30570":5363,"_31008":3504,"_31036":5179,"_35575":8215,"_35577":3480,"_35579":7932,"_30255":3177,"_35582":7341,"_35584":20800,"_35586":15767,"_35588":3805,"_35590":5029,"_30178":20809,"_35593":12247,"_35595":14814,"_30172":3491,"_30607":7480,"_35599":4377,"_35601":7767,"_35604":5151,"_30218":4577,"_35608":5175,"_30098":16828,"_35611":4962,"_30146":4461,"_35614":12462,"_35616":7905,"_35619":23490,"_15326":10447,"_35622":7310,"_35624":4730,"_35627":20064,"_35629":6203,"_35631":18358,"_35633":6749,"_35635":15375,"_20505":16091,"_35638":5644,"_35640":4378,"_30119