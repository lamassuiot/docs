64":15},"Deploy from AWS Marketplace",[50730,50731,50732],"Docs","Deployment","Other models",[],{"_3604":16,"_31083":15,"_21524":50735,"_5":14790,"_28264":15,"_3060":50736},[],"Run a preconfigured Lamassu IoT instance on Amazon EC2.",{"_3604":17,"_31083":15,"_5":31418,"_21524":50738,"_28264":50739,"_3060":50740},[],"/docs/deployment/aws-marketplace#before-you-begin","Before you begin",{"_3604":18,"_31083":15,"_5":31418,"_21524":50742,"_28264":50743,"_3060":50744},[],"/docs/deployment/aws-marketplace#infrastructure-requirements","Infrastructure requirements",{"_3604":19,"_31083":15,"_5":31418,"_21524":50746,"_28264":50747,"_3060":50748},[],"/docs/deployment/aws-marketplace#open-the-offer","Open the offer",{"_3604":20,"_31083":15,"_5":31418,"_21524":50750,"_28264":50751,"_3060":50752},[],"/docs/deployment/aws-marketplace#configure-the-instance","Configure the instance",{"_3604":21,"_31083":15,"_5":31418,"_21524":50754,"_28264":50755,"_3060":50756},[],"/docs/deployment/aws-marketplace#limit-network-access","Limit network access",{"_3604":22,"_31083":15,"_5":31418,"_21524":50758,"_28264":50759,"_3060":50760},[],"/docs/deployment/aws-marketplace#launch-and-verify","Launch and verify",{"_3604":23,"_31083":15,"_5":31418,"_21524":50762,"_28264":50763,"_3060":50764},[],"/docs/deployment/aws-marketplace#next-step","Next step",{"_3604":24,"_31083":15,"_21524":50766,"_5":14790,"_28264":15,"_3060":50767},[],"The AWS Marketplace offering reduces initial setup to an EC2 instance inside your account. You keep control of the network, storage and operation of the machine.",{"_3604":25,"_31083":15,"_21524":50769,"_5":14790,"_28264":50739,"_3060":50770},[],"Permissions to subscribe to AWS Marketplace products and launch EC2 instances.",{"_3604":26,"_31083":15,"_21524":50772,"_5":14790,"_28264":50739,"_3060":50773},[],"A VPC and a subnet from which administrators and devices can reach the instance.",{"_3604":27,"_31083":15,"_21524":50775,"_5":14790,"_28264":50739,"_3060":50776},[],"A security group allowing the necessary endpoints.",{"_3604":28,"_31083":15,"_21524":50778,"_5":14790,"_28264":50743,"_3060":50779},[],"**Compute:** a `t3.large` instance at minimum. Use `t3.xlarge` or higher when the load requires it.",{"_3604":29,"_31083":15,"_21524":50781,"_5":14790,"_28264":50743,"_3060":50782},[],"**Storage:** an EBS `gp3` volume of at least 50 GB, sized to your inventory and retention needs.",{"_3604":30,"_31083":15,"_21524":50784,"_5":14790,"_28264":50743,"_3060":50785},[],"**Network:** HTTPS access from the necessary consumers, restricted to trusted networks.",{"_3604":31,"_31083":15,"_21524":50787,"_5":14790,"_28264":50747,"_3060":50788},[],"Go to Lamassu IoT on AWS Marketplace and review the terms before subscribing.",{"_3604":32,"_31083":15,"_21524":50790,"_5":14790,"_28264":50751,"_3060":50791},[],"Select `t3.large` or higher, assign at least 50 GB of `gp3` storage and choose the target VPC and subnet.",{"_3604":33,"_31083":15,"_21524":50793,"_5":14790,"_28264":50755,"_3060":50794},[],"Configure the security group for ports `443`, `8443` and `9443`. Restrict the origins to the administrative and device networks that really need to connect.",{"_3604":34,"_31083":15,"_21524":50796,"_5":14790,"_28264":50759,"_3060":50797},[],"Start the instance and open the console at `https://<public-ip>`. Check you can authenticate before continuing.",{"_3604":35,"_31083":15,"_21524":50799,"_5":14790,"_28264":50763,"_3060":50800},[],"Continue with Create your first CA to validate the instance's cryptographic configuration.",{"_3604":36,"_31083":36,"_5":15155,"_3060":50802,"_31421":50803,"_21524":50804,"_28264":36},"Deploy Lamassu",[50730,50731],[],{"_3604":37,"_31083":36,"_21524":50806,"_5":14790,"_28264":36,"_3060":50807},[],"Choose the operating model that fits your infrastructure and control requirements.",{"_3604":38,"_31083":36,"_5":31418,"_21524":50809,"_28264":50810,"_3060":50811},[],"/docs/deployment/overview#choose-a-model","Choose a model",{"_3604":39,"_31083":36,"_5":31418,"_21524":50813,"_28264":50814,"_3060":50815},[],"/docs/deployment/overview#just-want-to-evaluate-the-platform","Just want to evaluate the platform?",{"_3604":40,"_31083":36,"_5":31418,"_21524":50817,"_28264":50818,"_3060":50819},[],"/docs/deployment/overview#after-deployment","After deployment",{"_3604":41,"_31083":36,"_21524":50821,"_5":14790,"_28264":36,"_3060":50822},[],"You can run Lamassu on your own Kubernetes cluster, deploy a prebuilt image from AWS Marketplace or consume the platform as a managed service.",{"_3604":42,"_31083":36,"_21524":50824,"_5":14790,"_28264":50810,"_3060":50825},[],"Model",{"_3604":43,"_31083":36,"_21524":50827,"_5":14790,"_28264":50810,"_3060":50828},[],"Recommended for",{"_3604":44,"_31083":36,"_21524":50830,"_5":14790,"_28264":50810,"_3060":50831},[],"Who operates the infrastructure",{"_3604":45,"_31083":36,"_21524":50833,"_5":14790,"_28264":50810,"_3060":50834},[],"Starting point",{"_3604":46,"_31083":36,"_21524":50836,"_5":14790,"_28264":50810,"_3060":50837},[],"Kubernetes self-managed",{"_3604":47,"_31083":36,"_21524":50839,"_5":14790,"_28264":50810,"_3060":50840},[],"Production, regulated environments and custom deployments",{"_3604":48,"_31083":36,"_21524":50842,"_5":14790,"_28264":50810,"_3060":50843},[],"Your team",{"_3604":49,"_31083":36,"_21524":50845,"_5":14790,"_28264":50810,"_3060":50846},[],"Helm or Fastlane",{"_3604":50,"_31083":36,"_21524":50848,"_5":14790,"_28264":50810,"_3060":50849},[],"AWS Marketplace",{"_3604":51,"_31083":36,"_21524":50851,"_5":14790,"_28264":50810,"_3060":50852},[],"Evaluation or a dedicated deployment inside an AWS account",{"_3604":52,"_31083":36,"_21524":50854,"_5":14790,"_28264":50810,"_3060":50843},[],{"_3604":53,"_31083":36,"_21524":50856,"_5":14790,"_28264":50810,"_3060":50857},[],"Preconfigured image on EC2",{"_3604":54,"_31083":36,"_21524":50859,"_5":14790,"_28264":50810,"_3060":50860},[],"SaaS",{"_3604":55,"_31083":36,"_21524":50862,"_5":14790,"_28264":50810,"_3060":50863},[],"Teams that want to use the platform without operating it",{"_3604":56,"_31083":36,"_21524":50865,"_5":14790,"_28264":50810,"_3060":50866},[],"Lamassu",{"_3604":57,"_31083":36,"_21524":50868,"_5":14790,"_28264":50810,"_3060":50869},[],"Managed subscription",{"_3604":58,"_31083":36,"_21524":50871,"_5":14790,"_28264":50810,"_3060":50872},[],"<Card title=\"Kubernetes self-managed\" description=\"Control network, storage, keys, dependencies and the upgrade cycle.\" href=\"/docs/deployment/self-hosted/overview\" />",{"_3604":59,"_31083":36,"_21524":50874,"_5":14790,"_28264":50810,"_3060":50875},[],"<Card title=\"AWS Marketplace\" description=\"Launch a preconfigured Lamassu instance on AWS EC2.\" href=\"/docs/deployment/aws-marketplace\" />",{"_3604":60,"_31083":36,"_21524":50877,"_5":14790,"_28264":50810,"_3060":50878},[],"<Card title=\"Lamassu SaaS\" description=\"Use an operated and updated instance as a managed service.\" href=\"/docs/deployment/saas\" />",{"_3604":61,"_31083":36,"_21524":50880,"_5":14790,"_28264":50814,"_3060":50881},[],"Use Fastlane to bring up PostgreSQL, Keycloak, RabbitMQ and Lamassu on a Kubernetes cluster through a single flow. It is intended for labs, demos and bootstrap; for production, configure dependencies and Helm values explicitly.",{"_3604":62,"_31083":36,"_21524":50883,"_5":14790,"_28264":50818,"_3060":50884},[],"Once the console is available, continue with Create your first CA. That quickstart verifies the cryptographic engine and issuance work correctly.",{"_3604":63,"_31083":63,"_5":15155,"_3060":50886,"_31421":50887,"_21524":50888,"_28264":63},"Use Lamassu as SaaS",[50730,50731,50732],[],{"_3604":64,"_31083":63,"_21524":50890,"_5":14790,"_28264":63,"_3060":50891},[],"Consume Lamassu as a managed service without operating your own infrastructure.",{"_3604":65,"_31083":63,"_5":31418,"_21524":50893,"_28264":50894,"_3060":50895},[],"/docs/deployment/saas#what-the-service-manages","What the service manages",{"_3604":66,"_31083":63,"_5":31418,"_21524":50897,"_28264":50898,"_3060":50899},[],"/docs/deployment/saas#plans","Plans",{"_3604":67,"_31083":63,"_5":31418,"_21524":50901,"_28264":50902,"_3060":50903},[],"/docs/deployment/saas#request-access","Request access",{"_3604":68,"_31083":63,"_21524":50905,"_5":14790,"_28264":63,"_3060":50906},[],"Lamassu SaaS offers the platform's capabilities in a managed environment. It is the right option when your team wants to focus on PKI and device identities, not on maintaining the infrastructure that supports them.",{"_3604":69,"_31083":63,"_21524":50908,"_5":14790,"_28264":50894,"_3060":50909},[],"Platform availability and maintenance.",{"_3604":70,"_31083":63,"_21524":50911,"_5":14790,"_28264":50894,"_3060":50912},[],"Automatic backups.",{"_3604":71,"_31083":63,"_21524":50914,"_5":14790,"_28264":50894,"_3060":50915},[],"Version upgrades.",{"_3604":72,"_31083":63,"_21524":50917,"_5":14790,"_28264":50894,"_3060":50918},[],"Technical support and SLA according to your plan.",{"_3604":73,"_31083":63,"_21524":50920,"_5":14790,"_28264":50898,"_3060":50921},[],"Plan",{"_3604":74,"_31083":63,"_21524":50923,"_5":14790,"_28264":50898,"_3060":50924},[],"Devices",{"_3604":75,"_31083":63,"_21524":50926,"_5":14790,"_28264":50898,"_3060":50927},[],"Support",{"_3604":76,"_31083":63,"_21524":50929,"_5":14790,"_28264":50898,"_3060":50930},[],"SLA",{"_3604":77,"_31083":63,"_21524":50932,"_5":14790,"_28264":50898,"_3060":50933},[],"Starter",{"_3604":78,"_31083":63,"_21524":50935,"_5":14790,"_28264":50898,"_3060":50936},[],"Up to 1,000",{"_3604":79,"_31083":63,"_21524":50938,"_5":14790,"_28264":50898,"_3060":50939},[],"Email",{"_3604":80,"_31083":63,"_21524":50941,"_5":14790,"_28264":50898,"_3060":50942},[],"99.5 %",{"_3604":81,"_31083":63,"_21524":50944,"_5":14790,"_28264":50898,"_3060":50945},[],"Professional",{"_3604":82,"_31083":63,"_21524":50947,"_5":14790,"_28264":50898,"_3060":50948},[],"Up to 10,000",{"_3604":83,"_31083":63,"_21524":50950,"_5":14790,"_28264":50898,"_3060":50951},[],"Email and chat",{"_3604":84,"_31083":63,"_21524":50953,"_5":14790,"_28264":50898,"_3060":50954},[],"99.9 %",{"_3604":85,"_31083":63,"_21524":50956,"_5":14790,"_28264":50898,"_3060":50957},[],"Enterprise",{"_3604":86,"_31083":63,"_21524":50959,"_5":14790,"_28264":50898,"_3060":50960},[],"Unlimited",{"_3604":87,"_31083":63,"_21524":50962,"_5":14790,"_28264":50898,"_3060":50963},[],"Dedicated",{"_3604":88,"_31083":63,"_21524":50965,"_5":14790,"_28264":50898,"_3060":50966},[],"99.99 %",{"_3604":89,"_31083":63,"_21524":50968,"_5":14790,"_28264":50902,"_3060":50969},[],"Contact the Lamassu team through lamassu.io to request a demo or choose a plan.",{"_3604":90,"_31083":63,"_21524":50971,"_5":14790,"_28264":50902,"_3060":50972},[],"When you receive your instance's credentials, continue with Get started.",{"_3604":91,"_31083":91,"_5":15155,"_3060":50974,"_31421":50975,"_21524":50976,"_28264":91},"Fastlane",[50730,50731,50837],[],{"_3604":92,"_31083":91,"_21524":50978,"_5":14790,"_28264":91,"_3060":50979},[],"Bootstrap a complete Lamassu evaluation or lab environment on an existing Kubernetes cluster.",{"_3604":93,"_31083":91,"_5":31418,"_21524":50981,"_28264":50982,"_3060":50983},[],"/docs/deployment/self-hosted/fastlane#deploy-with-fastlane","Deploy with Fastlane",{"_3604":94,"_31083":91,"_5":31418,"_21524":50985,"_28264":50986,"_3060":50987},[],"/docs/deployment/self-hosted/fastlane#what-fastlane-adds","What Fastlane adds",{"_3604":95,"_31083":91,"_5":31418,"_21524":50989,"_28264":50990,"_3060":50740},[],"/docs/deployment/self-hosted/fastlane#before-you-begin",{"_3604":96,"_31083":91,"_5":31418,"_21524":50992,"_28264":50993,"_3060":50994},[],"/docs/deployment/self-hosted/fastlane#quick-start","Quick start",{"_3604":97,"_31083":91,"_5":31418,"_21524":50996,"_28264":50997,"_3060":50998},[],"/docs/deployment/self-hosted/fastlane#gateway-address-selection","Gateway address selection",{"_3604":98,"_31083":91,"_5":31418,"_21524":51000,"_28264":51001,"_3060":51002},[],"/docs/deployment/self-hosted/fastlane#command-line-options","Command-line options",{"_3604":99,"_31083":91,"_5":31418,"_21524":51004,"_28264":51005,"_3060":51006},[],"/docs/deployment/self-hosted/fastlane#development-mode","Development mode",{"_3604":100,"_31083":91,"_5":31418,"_21524":51008,"_28264":51009,"_3060":51010},[],"/docs/deployment/self-hosted/fastlane#what-the-script-configures","What the script configures",{"_3604":101,"_31083":91,"_5":31418,"_21524":51012,"_28264":51013,"_3060":51014},[],"/docs/deployment/self-hosted/fastlane#tls-behavior","TLS behavior",{"_3604":102,"_31083":91,"_5":31418,"_21524":51016,"_28264":51017,"_3060":51018},[],"/docs/deployment/self-hosted/fastlane#credentials-and-generated-files","Credentials and generated files",{"_3604":103,"_31083":91,"_5":31418,"_21524":51020,"_28264":51021,"_3060":51022},[],"/docs/deployment/self-hosted/fastlane#verify-the-installation","Verify the installation",{"_3604":104,"_31083":91,"_21524":51024,"_5":14790,"_28264":50982,"_3060":51025},[],"Fastlane is the automated path for evaluations, demos, CI and small lab clusters. It installs PostgreSQL, Keycloak, RabbitMQ, Envoy Gateway and Lamassu, then configures them to work together.",{"_3604":105,"_31083":91,"_21524":51027,"_5":14790,"_28264":50982,"_3060":51028},[],"For production, use Helm so database, identity, credentials, certificates, storage and upgrades remain explicit.",{"_3604":106,"_31083":91,"_21524":51030,"_5":14790,"_28264":50986,"_3060":51031},[],"Fastlane closes some of the gaps intentionally left by the application chart:",{"_3604":107,"_31083":91,"_21524":51033,"_5":14790,"_28264":50986,"_3060":51034},[],"Fastlane installs or configures",{"_3604":108,"_31083":91,"_21524":51036,"_5":14790,"_28264":50986,"_3060":51037},[],"You still provide",{"_3604":109,"_31083":91,"_21524":51039,"_5":14790,"_28264":50986,"_3060":51040},[],"PostgreSQL, RabbitMQ and Keycloak instances for evaluation",{"_3604":110,"_31083":91,"_21524":51042,"_5":14790,"_28264":50986,"_3060":51043},[],"The Kubernetes cluster, nodes and persistent storage",{"_3604":111,"_31083":91,"_21524":51045,"_5":14790,"_28264":50986,"_3060":51046},[],"Envoy Gateway 1.8 and the `eg` `GatewayClass`",{"_3604":112,"_31083":91,"_21524":51048,"_5":14790,"_28264":50986,"_3060":51049},[],"cert-manager, external network reachability, DNS and firewall/NAT rules",{"_3604":113,"_31083":91,"_21524":51051,"_5":14790,"_28264":50986,"_3060":51052},[],"A self-signed Lamassu certificate flow, dependency credentials stored in Kubernetes Secrets (through the External Secrets Operator) and an initial user",{"_3604":114,"_31083":91,"_21524":51054,"_5":14790,"_28264":50986,"_3060":51055},[],"Client trust for the self-signed CA, or a trusted certificate passed to the script",{"_3604":115,"_31083":91,"_21524":51057,"_5":14790,"_28264":50986,"_3060":51058},[],"Optional observability and lab HSM components",{"_3604":116,"_31083":91,"_21524":51060,"_5":14790,"_28264":50986,"_3060":51061},[],"Production monitoring retention, backups, HA and a production HSM/key service",{"_3604":117,"_31083":91,"_21524":51063,"_5":14790,"_28264":50986,"_3060":51064},[],"Fastlane does not turn the resulting stack into a production service: it does not create the cluster, public DNS, firewall rules, backups, high availability or a trusted public certificate.",{"_3604":118,"_31083":91,"_21524":51066,"_5":14790,"_28264":50990,"_3060":51067},[],"You need:",{"_3604":119,"_31083":91,"_21524":51069,"_5":14790,"_28264":50990,"_3060":51070},[],"an existing Kubernetes cluster",{"_3604":120,"_31083":91,"_21524":51072,"_5":14790,"_28264":50990,"_3060":51073},[],"`kubectl` and Helm, or the MicroK8s CLI",{"_3604":121,"_31083":91,"_21524":51075,"_5":14790,"_28264":50990,"_3060":51076},[],"`yq`",{"_3604":122,"_31083":91,"_21524":51078,"_5":14790,"_28264":50990,"_3060":24330},[],{"_3604":123,"_31083":91,"_21524":51080,"_5":14790,"_28264":50990,"_3060":51081},[],"`jq` only when using `--sample-data` or `--development`",{"_3604":124,"_31083":91,"_21524":51083,"_5":14790,"_28264":50990,"_3060":51084},[],"`ssh-keygen` only when using `--with-hsm`",{"_3604":125,"_31083":91,"_21524":51086,"_5":14790,"_28264":50990,"_3060":51087},[],"free external ports 80 and 443 on a single-node K3s host",{"_3604":126,"_31083":91,"_21524":51089,"_5":14790,"_28264":50990,"_3060":51090},[],"Fastlane detects MicroK8s, K3s, kind or a standard kubeconfig. Use `--context` when the intended cluster is not the current context.",{"_3604":127,"_31083":91,"_21524":51092,"_5":14790,"_28264":50990,"_3060":51093},[],"Fastlane installs several components and creates credentials. Check `kubectl config current-context` or pass `--context` before running it.",{"_3604":128,"_31083":91,"_21524":51095,"_5":14790,"_28264":50993,"_3060":51096},[],"Run the script from a clone of the Helm repository:",{"_3604":129,"_31083":91,"_21524":51098,"_5":14790,"_28264":50993,"_3060":51099},[],"Create a DNS record for the chosen domain before testing from another machine. For a small VM, point it at the VM or load-balancer address that actually receives ports 80 and 443.",{"_3604":130,"_31083":91,"_21524":51101,"_5":14790,"_28264":50997,"_3060":51102},[],"By default, Fastlane runs `hostname -I` and writes the returned addresses to `gateway.addresses` and to the self-signed certificate's IP SANs.",{"_3604":131,"_31083":91,"_21524":51104,"_5":14790,"_28264":50997,"_3060":51105},[],"On a single-homed lab VM this can select the expected node address. On hosts with Docker, VPN, WireGuard or several interfaces it can also select addresses clients cannot reach. Override the result explicitly:",{"_3604":132,"_31083":91,"_21524":51107,"_5":14790,"_28264":50997,"_3060":51108},[],"The value must be an address handled on the Kubernetes side of the traffic path. If a public EC2 address forwards through WireGuard to the cluster, pass the reachable cluster/VM address, not the EC2 public address.",{"_3604":133,"_31083":91,"_21524":51110,"_5":14790,"_28264":50997,"_3060":51111},[],"See Expose the Gateway for K3s port conflicts, VIPs, external NAT and multi-Gateway designs.",{"_3604":134,"_31083":91,"_21524":51113,"_5":14790,"_28264":51001,"_3060":51114},[],"Option",{"_3604":135,"_31083":91,"_21524":51116,"_5":14790,"_28264":51001,"_3060":51117},[],"Default",{"_3604":136,"_31083":91,"_21524":51119,"_5":14790,"_28264":51001,"_3060":51120},[],"Purpose",{"_3604":137,"_31083":91,"_21524":51122,"_5":14790,"_28264":51001,"_3060":51123},[],"`-h`, `--help`",{"_3604":138,"_31083":91,"_21524":51125,"_5":14790,"_28264":51001,"_3060":51126},[],"—",{"_3604":139,"_31083":91,"_21524":51128,"_5":14790,"_28264":51001,"_3060":51129},[],"Show help",{"_3604":140,"_31083":91,"_21524":51131,"_5":14790,"_28264":51001,"_3060":51132},[],"`-c`, `--context`",{"_3604":141,"_31083":91,"_21524":51134,"_5":14790,"_28264":51001,"_3060":51135},[],"current context",{"_3604":142,"_31083":91,"_21524":51137,"_5":14790,"_28264":51001,"_3060":51138},[],"Select the kubeconfig context for kubectl and Helm",{"_3604":143,"_31083":91,"_21524":51140,"_5":14790,"_28264":51001,"_3060":51141},[],"`-n`, `--non-interactive`",{"_3604":144,"_31083":91,"_21524":51143,"_5":14790,"_28264":51001,"_3060":6764},[],{"_3604":145,"_31083":91,"_21524":51145,"_5":14790,"_28264":51001,"_3060":51146},[],"Skip prompts and generate dependency credentials",{"_3604":146,"_31083":91,"_21524":51148,"_5":14790,"_28264":51001,"_3060":51149},[],"`-ns`, `--namespace`",{"_3604":147,"_31083":91,"_21524":51151,"_5":14790,"_28264":51001,"_3060":51152},[],"`lamassu-dev`",{"_3604":148,"_31083":91,"_21524":51154,"_5":14790,"_28264":51001,"_3060":51155},[],"Namespace for the installation",{"_3604":149,"_31083":91,"_21524":51157,"_5":14790,"_28264":51001,"_3060":51158},[],"`-d`, `--domain`",{"_3604":150,"_31083":91,"_21524":51160,"_5":14790,"_28264":51001,"_3060":51161},[],"`dev.lamassu.io`",{"_3604":151,"_31083":91,"_21524":51163,"_5":14790,"_28264":51001,"_3060":51164},[],"Domain used by the UI, OIDC and certificate",{"_3604":152,"_31083":91,"_21524":51166,"_5":14790,"_28264":51001,"_3060":51167},[],"`-v`, `--version`",{"_3604":153,"_31083":91,"_21524":51169,"_5":14790,"_28264":51001,"_3060":15502},[],{"_3604":154,"_31083":91,"_21524":51171,"_5":14790,"_28264":51001,"_3060":51172},[],"Lamassu chart version",{"_3604":155,"_31083":91,"_21524":51174,"_5":14790,"_28264":51001,"_3060":51175},[],"`--https-port`",{"_3604":156,"_31083":91,"_21524":51177,"_5":14790,"_28264":51001,"_3060":51178},[],"`443`",{"_3604":157,"_31083":91,"_21524":51180,"_5":14790,"_28264":51001,"_3060":51181},[],"Gateway HTTPS listener port",{"_3604":158,"_31083":91,"_21524":51183,"_5":14790,"_28264":51001,"_3060":51184},[],"`--http-port`",{"_3604":159,"_31083":91,"_21524":51186,"_5":14790,"_28264":51001,"_3060":51187},[],"`80`",{"_3604":160,"_31083":91,"_21524":51189,"_5":14790,"_28264":51001,"_3060":51190},[],"Gateway HTTP listener port",{"_3604":161,"_31083":91,"_21524":51192,"_5":14790,"_28264":51001,"_3060":51193},[],"`--tls-crt`",{"_3604":162,"_31083":91,"_21524":51195,"_5":14790,"_28264":51001,"_3060":51126},[],{"_3604":163,"_31083":91,"_21524":51197,"_5":14790,"_28264":51001,"_3060":51198},[],"PEM certificate for downstream TLS",{"_3604":164,"_31083":91,"_21524":51200,"_5":14790,"_28264":51001,"_3060":51201},[],"`--tls-key`",{"_3604":165,"_31083":91,"_21524":51203,"_5":14790,"_28264":51001,"_3060":51126},[],{"_3604":166,"_31083":91,"_21524":51205,"_5":14790,"_28264":51001,"_3060":51206},[],"PEM private key for downstream TLS",{"_3604":167,"_31083":91,"_21524":51208,"_5":14790,"_28264":51001,"_3060":51209},[],"`-l`, `--local-chart-path`",{"_3604":168,"_31083":91,"_21524":51211,"_5":14790,"_28264":51001,"_3060":51212},[],"repository chart",{"_3604":169,"_31083":91,"_21524":51214,"_5":14790,"_28264":51001,"_3060":51215},[],"Use an unpacked local Lamassu chart",{"_3604":170,"_31083":91,"_21524":51217,"_5":14790,"_28264":51001,"_3060":51218},[],"`-ip`, `--gateway-ip`",{"_3604":171,"_31083":91,"_21524":51220,"_5":14790,"_28264":51001,"_3060":9027},[],{"_3604":172,"_31083":91,"_21524":51222,"_5":14790,"_28264":51001,"_3060":51223},[],"Override the address written to `gateway.addresses`",{"_3604":173,"_31083":91,"_21524":51225,"_5":14790,"_28264":51001,"_3060":51226},[],"`--otel`",{"_3604":174,"_31083":91,"_21524":51228,"_5":14790,"_28264":51001,"_3060":6764},[],{"_3604":175,"_31083":91,"_21524":51230,"_5":14790,"_28264":51001,"_3060":51231},[],"Install Victoria Logs, VictoriaTraces, Jaeger and an OpenTelemetry Collector",{"_3604":176,"_31083":91,"_21524":51233,"_5":14790,"_28264":51001,"_3060":51234},[],"`--development`",{"_3604":177,"_31083":91,"_21524":51236,"_5":14790,"_28264":51001,"_3060":6764},[],{"_3604":178,"_31083":91,"_21524":51238,"_5":14790,"_28264":51001,"_3060":51239},[],"Development mode: fully provisions the Keycloak `lamassu` user (fixed `lamassu`/`lamassu` password, no first-login steps) and lets the `frontend` client accept any redirect URI or web origin. Not for production",{"_3604":179,"_31083":91,"_21524":51241,"_5":14790,"_28264":51001,"_3060":51242},[],"`--sample-data`",{"_3604":180,"_31083":91,"_21524":51244,"_5":14790,"_28264":51001,"_3060":6764},[],{"_3604":181,"_31083":91,"_21524":51246,"_5":14790,"_28264":51001,"_3060":51247},[],"Create sample CAs, profiles, certificates, DMS data and devices",{"_3604":182,"_31083":91,"_21524":51249,"_5":14790,"_28264":51001,"_3060":51250},[],"`--with-hsm`",{"_3604":183,"_31083":91,"_21524":51252,"_5":14790,"_28264":51001,"_3060":6764},[],{"_3604":184,"_31083":91,"_21524":51254,"_5":14790,"_28264":51001,"_3060":51255},[],"Install lab HSM components and configure KMS for PKCS#11",{"_3604":185,"_31083":91,"_21524":51257,"_5":14790,"_28264":51001,"_3060":51258},[],"`--softhsm-chart-path`",{"_3604":186,"_31083":91,"_21524":51260,"_5":14790,"_28264":51001,"_3060":51261},[],"`./charts/softhsm`",{"_3604":187,"_31083":91,"_21524":51263,"_5":14790,"_28264":51001,"_3060":51264},[],"Use a different local SoftHSM chart",{"_3604":188,"_31083":91,"_21524":51266,"_5":14790,"_28264":51001,"_3060":51267},[],"Fastlane does not provide an offline mode. Use the manual Helm workflow and a prepared registry/chart mirror for disconnected environments.",{"_3604":189,"_31083":91,"_21524":51269,"_5":14790,"_28264":51005,"_3060":51270},[],"`--development` adjusts the Keycloak `lamassu` realm generated by Fastlane for a disposable evaluation environment:",{"_3604":190,"_31083":91,"_21524":51272,"_5":14790,"_28264":51005,"_3060":51273},[],"the `lamassu` user is fully provisioned (first name Lamassu, last name Admin, email `lamassu@lamassu.io`, verified): there are no profile setup or password change steps on first login",{"_3604":191,"_31083":91,"_21524":51275,"_5":14790,"_28264":51005,"_3060":51276},[],"the well-known `lamassu`/`lamassu` password is fixed and permanent: it is never rotated and grants the `pki-admin` role, including non-interactive tokens through the `frontend` client",{"_3604":192,"_31083":91,"_21524":51278,"_5":14790,"_28264":51005,"_3060":51279},[],"the `frontend` client accepts any redirect URI and any web origin (`*`) instead of the original `/*` patterns",{"_3604":193,"_31083":91,"_21524":51281,"_5":14790,"_28264":51005,"_3060":51282},[],"With `--development`, the fixed `lamassu`/`lamassu` password grants `pki-admin` access to anyone who can reach the installation. Never use it on anything exposed beyond a development machine or a network-reachable host.",{"_3604":194,"_31083":91,"_21524":51284,"_5":14790,"_28264":51005,"_3060":51285},[],"`--development` applies when the `lamassu` realm is first imported. It does not modify an existing cluster. It can be combined with `--sample-data`: the development transform runs first, then sample data is added to the same realm configuration.",{"_3604":195,"_31083":91,"_21524":51287,"_5":14790,"_28264":51009,"_3060":51288},[],"Fastlane:",{"_3604":196,"_31083":91,"_21524":51290,"_5":14790,"_28264":51009,"_3060":51291},[],"validates local tools and the selected cluster",{"_3604":197,"_31083":91,"_21524":51293,"_5":14790,"_28264":51009,"_3060":51294},[],"installs or upgrades Envoy Gateway 1.8 and creates the `eg` `GatewayClass`",{"_3604":198,"_31083":91,"_21524":51296,"_5":14790,"_28264":51009,"_3060":51297},[],"creates the namespace",{"_3604":199,"_31083":91,"_21524":51299,"_5":14790,"_28264":51009,"_3060":51300},[],"installs the External Secrets Operator and creates the PostgreSQL, RabbitMQ and Keycloak administrator credentials as Secrets through a Fake `ClusterSecretStore`",{"_3604":200,"_31083":91,"_21524":51302,"_5":14790,"_28264":51009,"_3060":51303},[],"installs PostgreSQL and creates the required databases",{"_3604":201,"_31083":91,"_21524":51305,"_5":14790,"_28264":51009,"_3060":51306},[],"installs Keycloak and creates the `lamassu` realm, frontend client, admin role and initial user",{"_3604":202,"_31083":91,"_21524":51308,"_5":14790,"_28264":51009,"_3060":51309},[],"installs RabbitMQ",{"_3604":203,"_31083":91,"_21524":51311,"_5":14790,"_28264":51009,"_3060":51312},[],"optionally installs observability and lab HSM components",{"_3604":204,"_31083":91,"_21524":51314,"_5":14790,"_28264":51009,"_3060":51315},[],"generates `lamassu.yaml`, which references the Secrets instead of inline credentials, and installs the Lamassu chart",{"_3604":205,"_31083":91,"_21524":51317,"_5":14790,"_28264":51009,"_3060":51318},[],"optionally loads sample data",{"_3604":206,"_31083":91,"_21524":51320,"_5":14790,"_28264":51009,"_3060":51321},[],"The generated configuration exposes Keycloak at `/auth` through the same Gateway and bootstraps the initial `lamassu` user as a Lamassu super administrator.",{"_3604":207,"_31083":91,"_21524":51323,"_5":14790,"_28264":51013,"_3060":51324},[],"With both `--tls-crt` and `--tls-key`, Fastlane creates the `downstream-provided-crt` Secret and configures `tls.type: external`.",{"_3604":208,"_31083":91,"_21524":51326,"_5":14790,"_28264":51013,"_3060":51327},[],"Without them, it configures cert-manager with a self-signed issuer. This is suitable for a lab but will not be trusted by clients until you distribute the CA. Use Helm when you need a corporate Issuer, public ACME issuer or an existing Secret managed by another system.",{"_3604":209,"_31083":91,"_21524":51329,"_5":14790,"_28264":51017,"_3060":51330},[],"Non-interactive mode generates random PostgreSQL, RabbitMQ and Keycloak administrator passwords and stores them in Kubernetes Secrets through the External Secrets Operator's Fake `ClusterSecretStore`. Fastlane writes `lamassu.yaml` in the current directory referencing those Secrets — the values file no longer contains the credentials.",{"_3604":210,"_31083":91,"_21524":51332,"_5":14790,"_28264":51017,"_3060":51333},[],"The Keycloak administrator password is not printed by the script. Retrieve it from the Secret when needed:",{"_3604":211,"_31083":91,"_21524":51335,"_5":14790,"_28264":51017,"_3060":51336},[],"The initial Lamassu login is `lamassu` / `lamassu` and requires a password change on first use, unless `--development` was used: in that case the password stays fixed and permanent.",{"_3604":212,"_31083":91,"_21524":51338,"_5":14790,"_28264":51017,"_3060":51339},[],"The Fake `ClusterSecretStore` stores the credentials in plain text and is for lab use only: replace it with a real ESO provider for anything beyond a throwaway environment. Protect the generated values file, record the generated credentials in an appropriate secret store and do not reuse the evaluation identity setup in production.",{"_3604":213,"_31083":91,"_21524":51341,"_5":14790,"_28264":51021,"_3060":51342},[],"Then open `https://pki.example.com` and sign in with the initial user. If the Gateway is programmed but the URL is unreachable, follow the checks in Expose the Gateway.",{"_3604":214,"_31083":214,"_5":15155,"_3060":51344,"_31421":51345,"_21524":51346,"_28264":214},"Install with Helm",[50730,50731,50837],[],{"_3604":215,"_31083":214,"_21524":51348,"_5":14790,"_28264":214,"_3060":51349},[],"Prepare dependencies, configure the Lamassu chart and verify a controlled Kubernetes deployment.",{"_3604":216,"_31083":214,"_5":31418,"_21524":51351,"_28264":51352,"_3060":51353},[],"/docs/deployment/self-hosted/helm#install-lamassu-with-helm","Install Lamassu with Helm",{"_3604":217,"_31083":214,"_5":31418,"_21524":51355,"_28264":51356,"_3060":50740},[],"/docs/deployment/self-hosted/helm#before-you-begin",{"_3604":218,"_31083":214,"_5":31418,"_21524":51358,"_28264":51359,"_3060":51360},[],"/docs/deployment/self-hosted/helm#1-install-the-gateway-prerequisites","1\\. Install the Gateway prerequisites",{"_3604":219,"_31083":214,"_5":31418,"_21524":51362,"_28264":51363,"_3060":51364},[],"/docs/deployment/self-hosted/helm#2-create-a-values-file","2\\. Create a values file",{"_3604":220,"_31083":214,"_5":31418,"_21524":51366,"_28264":51367,"_3060":51368},[],"/docs/deployment/self-hosted/helm#credentials-in-kubernetes-secrets","Credentials in Kubernetes Secrets",{"_3604":221,"_31083":214,"_5":31418,"_21524":51370,"_28264":51371,"_3060":51372},[],"/docs/deployment/self-hosted/helm#tls-with-an-existing-secret","TLS with an existing Secret",{"_3604":222,"_31083":214,"_5":31418,"_21524":51374,"_28264":51375,"_3060":51376},[],"/docs/deployment/self-hosted/helm#amqp-tls-amqps","AMQP TLS (AMQPS)",{"_3604":223,"_31083":214,"_5":31418,"_21524":51378,"_28264":51379,"_3060":51380},[],"/docs/deployment/self-hosted/helm#provision-the-first-administrator","Provision the first administrator",{"_3604":224,"_31083":214,"_5":31418,"_21524":51382,"_28264":51383,"_3060":51384},[],"/docs/deployment/self-hosted/helm#3-install-lamassu","3\\. Install Lamassu",{"_3604":225,"_31083":214,"_5":31418,"_21524":51386,"_28264":51387,"_3060":51388},[],"/docs/deployment/self-hosted/helm#4-verify-the-deployment","4\\. Verify the deployment",{"_3604":226,"_31083":214,"_5":31418,"_21524":51390,"_28264":51391,"_3060":51392},[],"/docs/deployment/self-hosted/helm#upgrading-lamassu","Upgrading Lamassu",{"_3604":227,"_31083":214,"_5":31418,"_21524":51394,"_28264":51395,"_3060":51396},[],"/docs/deployment/self-hosted/helm#production-decisions","Production decisions",{"_3604":228,"_31083":214,"_21524":51398,"_5":14790,"_28264":51352,"_3060":51399},[],"Use the Helm workflow when you need explicit control over identity, databases, messaging, certificates, storage and upgrades. For an evaluation environment where the script can make those choices for you, use Fastlane.",{"_3604":229,"_31083":214,"_21524":51401,"_5":14790,"_28264":51356,"_3060":51402},[],"Prepare the platform services that are deliberately outside the Lamassu chart:",{"_3604":230,"_31083":214,"_21524":51404,"_5":14790,"_28264":51356,"_3060":51405},[],"a Kubernetes 1.24+ cluster and Helm 3.2+",{"_3604":231,"_31083":214,"_21524":51407,"_5":14790,"_28264":51356,"_3060":51408},[],"a reachable PostgreSQL server and a role allowed to create databases and schemas",{"_3604":232,"_31083":214,"_21524":51410,"_5":14790,"_28264":51356,"_3060":51411},[],"a reachable RabbitMQ broker and credentials",{"_3604":233,"_31083":214,"_21524":51413,"_5":14790,"_28264":51356,"_3060":51414},[],"Kubernetes Secrets in the release namespace holding the PostgreSQL and RabbitMQ credentials (and SMTP credentials when SMTP authentication is required) — the chart reads credentials from Secrets and rejects inline values (see Credentials in Kubernetes Secrets)",{"_3604":234,"_31083":214,"_21524":51416,"_5":14790,"_28264":51356,"_3060":51417},[],"an OIDC provider, normally Keycloak, with a realm/tenant and client for Lamassu",{"_3604":235,"_31083":214,"_21524":51419,"_5":14790,"_28264":51356,"_3060":51420},[],"Envoy Gateway 1.8+ and a `GatewayClass`",{"_3604":236,"_31083":214,"_21524":51422,"_5":14790,"_28264":51356,"_3060":51423},[],"cert-manager 1.14+ (only for the default `tls.type: certManager` mode); for trusted TLS, either a trusted issuer or a Kubernetes TLS Secret",{"_3604":237,"_31083":214,"_21524":51425,"_5":14790,"_28264":51356,"_3060":51426},[],"a StorageClass and an external traffic design",{"_3604":238,"_31083":214,"_21524":51428,"_5":14790,"_28264":51356,"_3060":51429},[],"The chart defaults to a `GatewayClass` named `eg`. Change `gateway.className` if your platform team uses another name.",{"_3604":239,"_31083":214,"_21524":51431,"_5":14790,"_28264":51356,"_3060":51432},[],"You provide the PostgreSQL server. The chart's pre-install job connects with the supplied credentials, creates the required `pki`, `authz` and `wfx` databases and service schemas, runs migrations, and applies `services.authz.bootstrap`.",{"_3604":240,"_31083":214,"_21524":51434,"_5":14790,"_28264":51356,"_3060":51435},[],"The chart has no Helm dependencies that install PostgreSQL, RabbitMQ, an OIDC provider, Envoy Gateway or cert-manager.",{"_3604":241,"_31083":214,"_21524":51437,"_5":14790,"_28264":51359,"_3060":51438},[],"Install or upgrade the Envoy Gateway CRDs before its controller. The commands below match the version used by the Lamassu Helm repository:",{"_3604":242,"_31083":214,"_21524":51440,"_5":14790,"_28264":51359,"_3060":51441},[],"Create the default `GatewayClass` if it does not already exist. Save this manifest as `gateway-class.yaml`:",{"_3604":243,"_31083":214,"_21524":51443,"_5":14790,"_28264":51359,"_3060":51444},[],"Install cert-manager separately before Lamassu, but only for the default `tls.type: certManager` mode. In that mode the chart renders its self-signed Issuer and CA Certificate resources regardless of whether `tls.certManagerOptions.clusterIssuer` is set, so cert-manager stays a prerequisite. With `tls.type: external`, the chart renders no cert-manager resources and the Gateway terminates TLS with an existing Secret you provide instead.",{"_3604":244,"_31083":214,"_21524":51446,"_5":14790,"_28264":51363,"_3060":51447},[],"Start with the chart defaults and override the environment-specific values. This example assumes PostgreSQL, RabbitMQ and Keycloak are reachable through Kubernetes DNS, and exposes Keycloak at `/auth` through the shared Lamassu Gateway:",{"_3604":245,"_31083":214,"_21524":51449,"_5":14790,"_28264":51363,"_3060":51450},[],"Do not add `gateway.addresses` by default. Leave address assignment to the load-balancer implementation unless your network design requires a specific Kubernetes-side VIP. The public IP of an upstream NAT gateway or reverse proxy does not belong in this value.",{"_3604":246,"_31083":214,"_21524":51452,"_5":14790,"_28264":51363,"_3060":51453},[],"If Keycloak is external and already has its own reachable URL, point the OIDC settings at it and omit the `/auth` entry from `gateway.extraRouting`.",{"_3604":247,"_31083":214,"_21524":51455,"_5":14790,"_28264":51363,"_3060":51456},[],"If your values file still carries the legacy gateway JWT validation settings — `auth.oidc.apiGateway.jwks`, `auth.authorization.rolesClaim` or `auth.authorization.roles.admin` — remove them. The migration guide `charts/lamassu/CHANGELOG/3.8.0->4.0.0.md` documents their removal with no compatibility aliases, and `values.schema.json` rejects the leftover blocks instead of silently ignoring them. The replacements are `services.authz.jwkUrl` and `services.authz.bootstrap`, already shown in the example above.",{"_3604":248,"_31083":214,"_21524":51458,"_5":14790,"_28264":51367,"_3060":51459},[],"The chart reads the PostgreSQL, AMQP and SMTP credentials from Kubernetes Secrets in the release namespace. Reference them with `existingSecret` plus the `usernameKey` and `passwordKey` data keys; inline `username` and `password` values are removed and rejected by `values.schema.json`.",{"_3604":249,"_31083":214,"_21524":51461,"_5":14790,"_28264":51367,"_3060":51462},[],"The Secrets must exist before you install or upgrade: the pre-install and pre-upgrade migration job connects to PostgreSQL with the PostgreSQL Secret, and the service containers read the AMQP and SMTP credentials when they start.",{"_3604":250,"_31083":214,"_21524":51464,"_5":14790,"_28264":51367,"_3060":51465},[],"`postgres.existingSecret` (default `lamassu-postgres`) and `amqp.existingSecret` (default `lamassu-amqp`) are always required.",{"_3604":251,"_31083":214,"_21524":51467,"_5":14790,"_28264":51367,"_3060":51468},[],"`services.alerts.smtp_server.existingSecret` is empty by default, which means SMTP without authentication. Set it, together with its key names, only when your SMTP server requires authentication.",{"_3604":252,"_31083":214,"_21524":51470,"_5":14790,"_28264":51367,"_3060":51471},[],"Each `services.authz.credentials` entry names its `database` and uses the global PostgreSQL Secret — `postgres.existingSecret` with its configured key names — unless the entry sets its own `existingSecret`.",{"_3604":253,"_31083":214,"_21524":51473,"_5":14790,"_28264":51367,"_3060":51474},[],"Changing a Secret's contents does not roll the pods that consume it: the services read the credentials when they start. Restart the affected pods after rotating a credential.",{"_3604":254,"_31083":214,"_21524":51476,"_5":14790,"_28264":51367,"_3060":51477},[],"For production, manage the Secrets with the External Secrets Operator (ESO), which the chart does not install. The `charts/lamassu/README.md` in the Helm repository documents a complete working example in its *Secret management* section: installing external-secrets 0.20.2, a test `ClusterSecretStore`, the `ExternalSecret` resources and the wait before installing the chart. Its Fake provider is for testing only — replace it with your provider's configuration for anything beyond a throwaway environment; AWS Secrets Manager, Vault, Azure Key Vault, GCP Secret Manager and other providers are documented at external-secrets.io.",{"_3604":255,"_31083":214,"_21524":51479,"_5":14790,"_28264":51367,"_3060":51480},[],"Only these credentials moved into Secrets: other values, such as connector and crypto-engine settings, are still configured through the values file.",{"_3604":256,"_31083":214,"_21524":51482,"_5":14790,"_28264":51371,"_3060":51483},[],"Create a Secret containing `tls.crt` and `tls.key`, then reference it. The Secret must already exist before installing: in `external` mode the chart renders no cert-manager resources and never creates this Secret.",{"_3604":257,"_31083":214,"_21524":51485,"_5":14790,"_28264":51375,"_3060":51486},[],"`amqp.tls: true` selects AMQPS in every event-bus configuration block. The default port stays `5672` and does not change automatically when TLS is enabled, so set `amqp.port` to the broker's TLS listener, commonly `5671`.",{"_3604":258,"_31083":214,"_21524":51488,"_5":14790,"_28264":51375,"_3060":51489},[],"With no CA Secret configured, the event-bus clients use the system-trusted CAs. To trust a private CA, create a Secret in the release namespace containing the CA certificate in PEM format and set `amqp.ca.secretName` (and `amqp.ca.certificateKey` if the data key is not `ca.crt`).",{"_3604":259,"_31083":214,"_21524":51491,"_5":14790,"_28264":51375,"_3060":51492},[],"For brokers that require mutual TLS, create a Secret containing the client certificate and private key and set `amqp.client.secretName` (with `amqp.client.certificateKey` and `amqp.client.privateKeyKey` if the data keys are not `tls.crt` and `tls.key`).",{"_3604":260,"_31083":214,"_21524":51494,"_5":14790,"_28264":51375,"_3060":51495},[],"The chart mounts configured Secrets read-only into every AMQP-consuming workload: the CA certificate under `/etc/lamassu/amqp/ca` and the client certificate and key under `/etc/lamassu/amqp/client`. The mounted file names are always `ca.crt`, `tls.crt` and `tls.key` — the `certificateKey` and `privateKeyKey` values rename only the Secret data keys, never the on-disk paths. The client private key is mounted with restrictive permissions (`defaultMode: 0440`; the CA volume uses `0444`), which works because the chart adds `fsGroup` to the pod security context when `amqp.client.secretName` is set — the chart's default pod security context already sets `fsGroup: 65532` for every service pod, so this top-up applies only when an explicit `podSecurityContext` without `fsGroup` was overridden and an AMQP client Secret is configured — and it uses the container `runAsGroup` (default `65532`) when `fsGroup` is not already set.",{"_3604":261,"_31083":214,"_21524":51497,"_5":14790,"_28264":51375,"_3060":51498},[],"Both Secret options require `amqp.tls: true`: `values.schema.json` rejects a non-empty `secretName` when `tls` is false, rejects unknown keys and rejects data-key names outside `^[A-Za-z0-9._-]+$`. The referenced Secret must exist in the release namespace or the consuming pods fail to start.",{"_3604":262,"_31083":214,"_21524":51500,"_5":14790,"_28264":51375,"_3060":51501},[],"The AMQP client loads certificates at startup, so restart the consuming pods after updating either Secret. Changing any `amqp` value rolls the consuming pods through the `checksum/config` annotation, but a change to Secret content alone does not trigger a rollout.",{"_3604":263,"_31083":214,"_21524":51503,"_5":14790,"_28264":51375,"_3060":51504},[],"Per the migration guide `charts/lamassu/CHANGELOG/3.8.0->4.0.0.md`: in 3.8.0 `amqp.tls` was not applied and event-bus clients used plaintext AMQP; from 4.0.0, `amqp.tls: true` switches them to AMQPS. Set `amqp.port` to the broker TLS listener before upgrading, or set `amqp.tls: false` to keep plaintext AMQP. `amqp.tls: false` sends the broker credentials and all event-bus traffic in cleartext.",{"_3604":264,"_31083":214,"_21524":51506,"_5":14790,"_28264":51379,"_3060":51507},[],"There is no implicit superuser. Create the role or group expected by `services.authz.bootstrap` in the OIDC provider and assign it to at least one administrator before exposing Lamassu.",{"_3604":265,"_31083":214,"_21524":51509,"_5":14790,"_28264":51379,"_3060":51510},[],"The pre-install and pre-upgrade job applies the bootstrap idempotently: existing principals are preserved and missing grants are added.",{"_3604":266,"_31083":214,"_21524":51512,"_5":14790,"_28264":51379,"_3060":51513},[],"Test both an authorized identity and a denied identity. If no token matches an active bootstrap principal, nobody can administer the PKI.",{"_3604":267,"_31083":214,"_21524":51515,"_5":14790,"_28264":51379,"_3060":51516},[],"See Access control for the principal and policy model.",{"_3604":268,"_31083":214,"_21524":51518,"_5":14790,"_28264":51383,"_3060":51519},[],"To install a local checkout instead:",{"_3604":269,"_31083":214,"_21524":51521,"_5":14790,"_28264":51387,"_3060":51522},[],"The Gateway should report `PROGRAMMED=True`. If it is programmed but has no usable address, continue with Expose the Gateway.",{"_3604":270,"_31083":214,"_21524":51524,"_5":14790,"_28264":51387,"_3060":51525},[],"The Helm test checks the CA, DMS Manager, Device Manager and VA health endpoints and verifies the UI response.",{"_3604":271,"_31083":214,"_21524":51527,"_5":14790,"_28264":51391,"_3060":51528},[],"Version-specific upgrade steps live in `charts/lamassu/CHANGELOG/` in the Helm repository. The chart also ships an optional pre-upgrade Job that migrates existing CA private keys into the KMS engine configured for the release. It is off by default (`migrations.caToKms.enabled: false`) and is only needed when upgrading from a version prior to 3.7.0.",{"_3604":272,"_31083":214,"_21524":51530,"_5":14790,"_28264":51391,"_3060":51531},[],"While the flag is enabled, every `helm upgrade` creates the `<chart fullname>-ca-to-kms-migration` Job (`lamassu-ca-to-kms-migration` for release `lamassu`); a fresh install does not create it. Its hook weight is `-10`, so it runs before the other pre-upgrade hooks: the authorization bootstrap configuration (weight `-4`) and the database-migration Job (weight `-3`).",{"_3604":273,"_31083":214,"_21524":51533,"_5":14790,"_28264":51391,"_3060":51534},[],"The Job consumes the same KMS service configuration the chart renders into the KMS ConfigMap, including the engines from `services.kms.cryptoEngines`, and runs the migration tool defined in `migrations.caToKms.image`. It mounts that configuration read-only at `/etc/lamassuiot/config.yml` from the ConfigMap key `config`, so configure the destination engine in your values before the upgrade that performs the migration.",{"_3604":274,"_31083":214,"_21524":51536,"_5":14790,"_28264":51391,"_3060":51537},[],"The Job resolves its configuration through a projected volume with two optional sources: the release-scoped `<chart fullname>-kms-config` (`lamassu-kms-config` for release `lamassu`, `prod-lamassu-kms-config` for release `prod`) and the legacy unscoped `kms-config` created by chart versions before release-scoped naming. The legacy configuration remains authoritative while it is still present, and the release-scoped one is used once the legacy one is gone. Both sources are optional, so a missing ConfigMap never leaves the upgrade pod in `ContainerCreating`.",{"_3604":275,"_31083":214,"_21524":51539,"_5":14790,"_28264":51391,"_3060":51540},[],"Keep `migrations.caToKms.enabled: true` for the upgrade that performs the migration, then remove the flag from your values once the migration completes; it defaults to `false`.",{"_3604":276,"_31083":214,"_21524":51542,"_5":14790,"_28264":51395,"_3060":51543},[],"Before going live, review:",{"_3604":277,"_31083":214,"_21524":51545,"_5":14790,"_28264":51395,"_3060":51546},[],"backup and recovery for PostgreSQL and persistent volumes",{"_3604":278,"_31083":214,"_21524":51548,"_5":14790,"_28264":51395,"_3060":51549},[],"a production KMS engine; the default filesystem engine is not an HA design",{"_3604":279,"_31083":214,"_21524":51551,"_5":14790,"_28264":51395,"_3060":51552},[],"shared VA storage before increasing VA replicas",{"_3604":280,"_31083":214,"_21524":51554,"_5":14790,"_28264":51395,"_3060":51555},[],"managed OIDC roles and removal of evaluation credentials",{"_3604":281,"_31083":214,"_21524":51557,"_5":14790,"_28264":51395,"_3060":51558},[],"a trusted TLS issuer or externally managed certificate",{"_3604":282,"_31083":214,"_21524":51560,"_5":14790,"_28264":51395,"_3060":51561},[],"resource requests, replicas, autoscaling, disruption budgets and placement",{"_3604":283,"_31083":214,"_21524":51563,"_5":14790,"_28264":51395,"_3060":51564},[],"SMTP, observability and alert delivery",{"_3604":284,"_31083":214,"_21524":51566,"_5":14790,"_28264":51395,"_3060":51567},[],"the version upgrade guides and migration notes in `charts/lamassu/CHANGELOG/` before every upgrade, including the optional CA-to-KMS migration hook described above",{"_3604":285,"_31083":214,"_21524":51569,"_5":14790,"_28264":51395,"_3060":51570},[],"The complete values reference is maintained in `charts/lamassu/VALUES.md` in the Helm repository.",{"_3604":286,"_31083":286,"_5":15155,"_3060":51572,"_31421":51573,"_21524":51574,"_28264":286},"Expose the Gateway",[50730,50731,50837],[],{"_3604":287,"_31083":286,"_21524":51576,"_5":14790,"_28264":286,"_3060":51577},[],"Choose how clients reach Lamassu, when to set gateway.addresses and how to design multiple Gateways.",{"_3604":288,"_31083":286,"_5":31418,"_21524":51579,"_28264":51580,"_3060":51581},[],"/docs/deployment/self-hosted/networking#expose-the-lamassu-gateway","Expose the Lamassu Gateway",{"_3604":289,"_31083":286,"_5":31418,"_21524":51583,"_28264":51584,"_3060":51585},[],"/docs/deployment/self-hosted/networking#do-you-need-gatewayaddresses","Do you need `gateway.addresses`?",{"_3604":290,"_31083":286,"_5":31418,"_21524":51587,"_28264":51588,"_3060":51589},[],"/docs/deployment/self-hosted/networking#recommended-single-node-design","Recommended single-node design",{"_3604":291,"_31083":286,"_5":31418,"_21524":51591,"_28264":51592,"_3060":51593},[],"/docs/deployment/self-hosted/networking#k3s","K3s",{"_3604":292,"_31083":286,"_5":31418,"_21524":51595,"_28264":51596,"_3060":51597},[],"/docs/deployment/self-hosted/networking#bare-metal-with-metallb-or-kube-vip","Bare metal with MetalLB or kube-vip",{"_3604":293,"_31083":286,"_5":31418,"_21524":51599,"_28264":51600,"_3060":51601},[],"/docs/deployment/self-hosted/networking#external-reverse-proxy-nat-or-vpn","External reverse proxy, NAT or VPN",{"_3604":294,"_31083":286,"_5":31418,"_21524":51603,"_28264":51604,"_3060":51605},[],"/docs/deployment/self-hosted/networking#what-if-you-need-three-gateways","What if you need three Gateways?",{"_3604":295,"_31083":286,"_5":31418,"_21524":51607,"_28264":51608,"_3060":51609},[],"/docs/deployment/self-hosted/networking#client-certificates-and-identity-headers","Client certificates and identity headers",{"_3604":296,"_31083":286,"_5":31418,"_21524":51611,"_28264":51612,"_3060":51613},[],"/docs/deployment/self-hosted/networking#decision-guide","Decision guide",{"_3604":297,"_31083":286,"_5":31418,"_21524":51615,"_28264":51616,"_3060":51617},[],"/docs/deployment/self-hosted/networking#egress-proxy","Egress proxy",{"_3604":298,"_31083":286,"_5":31418,"_21524":51619,"_28264":51620,"_3060":51621},[],"/docs/deployment/self-hosted/networking#verify-the-traffic-path","Verify the traffic path",{"_3604":299,"_31083":286,"_21524":51623,"_5":14790,"_28264":51580,"_3060":51624},[],"The Lamassu chart creates one shared Gateway with HTTP and HTTPS listeners. Envoy Gateway normally creates a dedicated proxy deployment and a `LoadBalancer` Service for it.",{"_3604":300,"_31083":286,"_21524":51626,"_5":14790,"_28264":51580,"_3060":51627},[],"External reachability is the result of the whole path. A `Gateway` resource alone does not configure your router, firewall, DNS, cloud load balancer or upstream NAT.",{"_3604":301,"_31083":286,"_21524":51629,"_5":14790,"_28264":51584,"_3060":51630},[],"Usually, no. If you omit it, the Gateway controller and the cluster load-balancer implementation can assign an address and report it in `Gateway.status.addresses` and the generated Service status.",{"_3604":302,"_31083":286,"_21524":51632,"_5":14790,"_28264":51584,"_3060":51633},[],"Set it only when:",{"_3604":303,"_31083":286,"_21524":51635,"_5":14790,"_28264":51584,"_3060":51636},[],"your cloud or bare-metal load balancer supports requesting a specific address",{"_3604":304,"_31083":286,"_21524":51638,"_5":14790,"_28264":51584,"_3060":51639},[],"that address is allocated to this Gateway",{"_3604":305,"_31083":286,"_21524":51641,"_5":14790,"_28264":51584,"_3060":51642},[],"the surrounding network already routes traffic for it to the cluster",{"_3604":306,"_31083":286,"_21524":51644,"_5":14790,"_28264":51584,"_3060":51645},[],"This requests `192.168.1.50`; it does not claim the IP on your LAN or make it reachable.",{"_3604":307,"_31083":286,"_21524":51647,"_5":14790,"_28264":51584,"_3060":51648},[],"Keep these two settings separate:",{"_3604":308,"_31083":286,"_21524":51650,"_5":14790,"_28264":51584,"_3060":51651},[],"`gateway.addresses` requests an address for the Gateway.",{"_3604":309,"_31083":286,"_21524":51653,"_5":14790,"_28264":51584,"_3060":51654},[],"`tls.certManagerOptions.certSpec.addresses` adds IP subject alternative names to the TLS certificate.",{"_3604":310,"_31083":286,"_21524":51656,"_5":14790,"_28264":51584,"_3060":51657},[],"If users connect by DNS name, put that name in `tls.certManagerOptions.certSpec.hostnames`. Do not copy an upstream proxy's public IP into `gateway.addresses`.",{"_3604":311,"_31083":286,"_21524":51659,"_5":14790,"_28264":51588,"_3060":51660},[],"For a small VM running K3s or MicroK8s, use one external Lamassu Gateway and route every Lamassu endpoint through it:",{"_3604":312,"_31083":286,"_21524":51662,"_5":14790,"_28264":51588,"_3060":51663},[],"This design uses one IP, one TLS entry point and one pair of ports. The chart already creates the required routes.",{"_3604":313,"_31083":286,"_21524":51665,"_5":14790,"_28264":51592,"_3060":51666},[],"K3s ServiceLB implements each `LoadBalancer` Service with pods that reserve the Service ports on the node. On a single node, only one Service can therefore own port 80 and one can own port 443. The default K3s Traefik Service may already hold both ports.",{"_3604":314,"_31083":286,"_21524":51668,"_5":14790,"_28264":51592,"_3060":51669},[],"For the recommended design:",{"_3604":315,"_31083":286,"_21524":51671,"_5":14790,"_28264":51592,"_3060":51672},[],"Use only one externally exposed Lamassu Gateway.",{"_3604":316,"_31083":286,"_21524":51674,"_5":14790,"_28264":51592,"_3060":51675},[],"Ensure ports 80 and 443 are free. Disable or reconfigure Traefik if it is not part of your traffic path.",{"_3604":317,"_31083":286,"_21524":51677,"_5":14790,"_28264":51592,"_3060":51678},[],"Allow those ports through the VM firewall and any upstream security group.",{"_3604":318,"_31083":286,"_21524":51680,"_5":14790,"_28264":51592,"_3060":51681},[],"Point DNS at the VM's reachable address.",{"_3604":319,"_31083":286,"_21524":51683,"_5":14790,"_28264":51592,"_3060":51684},[],"See the K3s ServiceLB documentation for its host-port behavior and how to replace it with another load-balancer implementation.",{"_3604":320,"_31083":286,"_21524":51686,"_5":14790,"_28264":51596,"_3060":51687},[],"Allocate a VIP from an address pool reachable on your LAN. You may request that VIP with `gateway.addresses` if the selected implementation supports it. Confirm the assigned address in status rather than assuming the request succeeded.",{"_3604":321,"_31083":286,"_21524":51689,"_5":14790,"_28264":51600,"_3060":51690},[],"An external public address can forward TCP 80 and 443 to the VM or to a Kubernetes-side VIP:",{"_3604":322,"_31083":286,"_21524":51692,"_5":14790,"_28264":51600,"_3060":51693},[],"The public IP belongs to the external device. Leave `gateway.addresses` unset or set it to the actual Kubernetes-side address, never to an address that the cluster cannot bind.",{"_3604":323,"_31083":286,"_21524":51695,"_5":14790,"_28264":51604,"_3060":51696},[],"First decide whether you need three independent data planes or only three hostnames.",{"_3604":324,"_31083":286,"_21524":51698,"_5":14790,"_28264":51604,"_3060":51699},[],"Requirement",{"_3604":325,"_31083":286,"_21524":51701,"_5":14790,"_28264":51604,"_3060":51702},[],"Recommended design",{"_3604":326,"_31083":286,"_21524":51704,"_5":14790,"_28264":51604,"_3060":51705},[],"Consequence",{"_3604":327,"_31083":286,"_21524":51707,"_5":14790,"_28264":51604,"_3060":51708},[],"Several Lamassu URLs or services",{"_3604":328,"_31083":286,"_21524":51710,"_5":14790,"_28264":51604,"_3060":51711},[],"One Gateway with multiple routes",{"_3604":329,"_31083":286,"_21524":51713,"_5":14790,"_28264":51604,"_3060":51714},[],"One IP and one proxy fleet; this is the chart default",{"_3604":330,"_31083":286,"_21524":51716,"_5":14790,"_28264":51604,"_3060":51717},[],"Independent Gateways and separate external IPs",{"_3604":331,"_31083":286,"_21524":51719,"_5":14790,"_28264":51604,"_3060":51720},[],"One VIP per Gateway",{"_3604":332,"_31083":286,"_21524":51722,"_5":14790,"_28264":51604,"_3060":51723},[],"All Gateways can use 80/443; requires a load balancer with an address pool",{"_3604":333,"_31083":286,"_21524":51725,"_5":14790,"_28264":51604,"_3060":51726},[],"Independent Gateways on one node and one IP",{"_3604":334,"_31083":286,"_21524":51728,"_5":14790,"_28264":51604,"_3060":51729},[],"Use different external ports",{"_3604":335,"_31083":286,"_21524":51731,"_5":14790,"_28264":51604,"_3060":51732},[],"Clients must include non-standard ports",{"_3604":336,"_31083":286,"_21524":51734,"_5":14790,"_28264":51604,"_3060":51735},[],"Separate TLS/mTLS termination behind one IP",{"_3604":337,"_31083":286,"_21524":51737,"_5":14790,"_28264":51604,"_3060":51738},[],"Front-door SNI routing to internal Gateways",{"_3604":338,"_31083":286,"_21524":51740,"_5":14790,"_28264":51604,"_3060":51741},[],"Advanced design; the front door uses TLS passthrough and each internal Gateway terminates its own TLS",{"_3604":339,"_31083":286,"_21524":51743,"_5":14790,"_28264":51604,"_3060":51744},[],"Separate Gateway resources but shared proxy infrastructure",{"_3604":340,"_31083":286,"_21524":51746,"_5":14790,"_28264":51604,"_3060":51747},[],"Envoy merged-Gateway mode",{"_3604":341,"_31083":286,"_21524":51749,"_5":14790,"_28264":51604,"_3060":51750},[],"Logical separation only; listeners must have unique port, protocol and hostname tuples",{"_3604":342,"_31083":286,"_21524":51752,"_5":14790,"_28264":51604,"_3060":51753},[],"Three independent `LoadBalancer` Services cannot all reserve the same node ports 80 and 443 through K3s ServiceLB. Use one shared Gateway, allocate distinct VIPs with another load-balancer implementation, or use different ports.",{"_3604":343,"_31083":286,"_21524":51755,"_5":14790,"_28264":51604,"_3060":51756},[],"Envoy Gateway normally provisions a proxy fleet per `Gateway`. Its merged-Gateway mode can share one fleet and address, but it is not a drop-in switch for multiple Lamassu releases: the generated Lamassu listeners use the same ports and protocols without distinct hostnames, so they conflict unless you deliberately customize the listener design.",{"_3604":344,"_31083":286,"_21524":51758,"_5":14790,"_28264":51604,"_3060":51759},[],"Use a front-door SNI design only when the internal Gateways must retain independent TLS or mTLS policy:",{"_3604":345,"_31083":286,"_21524":51761,"_5":14790,"_28264":51604,"_3060":51762},[],"This requires distinct SNI hostnames and cluster networking outside the Lamassu chart.",{"_3604":346,"_31083":286,"_21524":51764,"_5":14790,"_28264":51608,"_3060":51765},[],"The chart renders a `ClientTrafficPolicy` named `enable-mtls` on its shared Gateway automatically; no Helm value enables or disables it. TLS termination accepts requests with or without a client certificate: devices may present one, but they are not required to. Before forwarding a request, the Gateway removes identity and certificate headers that a client could otherwise supply itself: `X-Principal-Id`, `X-Lms-Source`, `X-Forwarded-Client-Cert`, `X-Forwarded-Cert`, `X-Forwarded-Tls-Client-Cert` (the Traefik spelling), `Ssl-Client-Cert` and `X-Amzn-Mtls-Clientcert`. The Traefik spelling is included because backends that accept `X-Forwarded-Tls-Client-Cert` directly would otherwise receive certificate identity data supplied by the client itself, without a client certificate having been presented. After stripping, Envoy adds its own `X-Forwarded-Client-Cert` carrying the presented certificate and its chain, so services that read certificate identity receive only gateway-generated values. No Helm value changes the list of stripped headers. The Access control page describes how `authz` uses this protection to keep `X-Principal-ID` out of reach of clients.",{"_3604":347,"_31083":286,"_21524":51767,"_5":14790,"_28264":51612,"_3060":51768},[],"If one Gateway can own TLS and routing, use the chart default.",{"_3604":348,"_31083":286,"_21524":51770,"_5":14790,"_28264":51612,"_3060":51771},[],"If Gateways need independent policy and you can allocate IPs, use one VIP per Gateway.",{"_3604":349,"_31083":286,"_21524":51773,"_5":14790,"_28264":51612,"_3060":51774},[],"If only the Kubernetes resources need separation, evaluate merged-Gateway mode and make every listener tuple unique.",{"_3604":350,"_31083":286,"_21524":51776,"_5":14790,"_28264":51612,"_3060":51777},[],"If data planes and TLS termination must stay independent behind one IP, add a front-door SNI passthrough layer.",{"_3604":351,"_31083":286,"_21524":51779,"_5":14790,"_28264":51612,"_3060":51780},[],"If none of those are possible, use different external ports or change the external network design.",{"_3604":352,"_31083":286,"_21524":51782,"_5":14790,"_28264":51616,"_3060":51783},[],"Internal Lamassu clients — the Vault engine connection, service-to-service calls and webhook deliveries — honor the `HTTP_PROXY`, `HTTPS_PROXY` and `NO_PROXY` environment variables. The exception is the authorization-engine connector: it uses its own transport and does not consult these proxy variables. If your deployment routes egress through a proxy, list in-cluster service names in `NO_PROXY` (for example `.svc,.cluster.local`) so internal traffic stays inside the cluster. Loopback traffic is never sent through a proxy.",{"_3604":353,"_31083":286,"_21524":51785,"_5":14790,"_28264":51616,"_3060":51786},[],"The default transport of these clients bounds the dial timeout (30 seconds), the TLS handshake (10 seconds) and idle connection reuse (90 seconds) so an unreachable dependency fails fast instead of hanging; these values are Go transport defaults, not Lamassu settings. HTTP/2 is negotiated when the peer supports it. The authorization-engine connector keeps its own transport without these dial and handshake timeouts; only its overall 30-second request timeout bounds each call.",{"_3604":354,"_31083":286,"_21524":51788,"_5":14790,"_28264":51620,"_3060":51789},[],"Check, in order:",{"_3604":355,"_31083":286,"_21524":51791,"_5":14790,"_28264":51620,"_3060":51792},[],"`Gateway` has `Accepted=True` and `Programmed=True`.",{"_3604":356,"_31083":286,"_21524":51794,"_5":14790,"_28264":51620,"_3060":51795},[],"Its status contains the expected address.",{"_3604":357,"_31083":286,"_21524":51797,"_5":14790,"_28264":51620,"_3060":51798},[],"The generated `LoadBalancer` Service has a usable external address.",{"_3604":358,"_31083":286,"_21524":51800,"_5":14790,"_28264":51620,"_3060":51801},[],"Port 443 reaches that address from the client network.",{"_3604":359,"_31083":286,"_21524":51803,"_5":14790,"_28264":51620,"_3060":51804},[],"DNS resolves to the externally reachable endpoint.",{"_3604":360,"_31083":286,"_21524":51806,"_5":14790,"_28264":51620,"_3060":51807},[],"The certificate contains the DNS name or IP used by the client.",{"_3604":361,"_31083":286,"_21524":51809,"_5":14790,"_28264":51620,"_3060":51810},[],"The Gateway API treats addresses as desired state that a controller may assign or reject; see the Gateway API overview for the resource model.",{"_3604":362,"_31083":362,"_5":15155,"_3060":50837,"_31421":51812,"_21524":51813,"_28264":362},[50730,50731,50837],[],{"_3604":363,"_31083":362,"_21524":51815,"_5":14790,"_28264":362,"_3060":51816},[],"Choose an installation workflow and network architecture for Lamassu on your Kubernetes cluster.",{"_3604":364,"_31083":362,"_5":31418,"_21524":51818,"_28264":51819,"_3060":51820},[],"/docs/deployment/self-hosted/overview#self-managed-kubernetes-deployment","Self-managed Kubernetes deployment",{"_3604":365,"_31083":362,"_5":31418,"_21524":51822,"_28264":51823,"_3060":51824},[],"/docs/deployment/self-hosted/overview#choose-an-installation-workflow","Choose an installation workflow",{"_3604":366,"_31083":362,"_5":31418,"_21524":51826,"_28264":51827,"_3060":51828},[],"/docs/deployment/self-hosted/overview#what-the-lamassu-chart-provides","What the Lamassu chart provides",{"_3604":367,"_31083":362,"_5":31418,"_21524":51830,"_28264":51831,"_3060":51832},[],"/docs/deployment/self-hosted/overview#how-the-deployment-fits-together","How the deployment fits together",{"_3604":368,"_31083":362,"_5":31418,"_21524":51834,"_28264":51835,"_3060":51836},[],"/docs/deployment/self-hosted/overview#platform-requirements","Platform requirements",{"_3604":369,"_31083":362,"_5":31418,"_21524":51838,"_28264":51839,"_3060":51840},[],"/docs/deployment/self-hosted/overview#choose-the-next-page","Choose the next page",{"_3604":370,"_31083":362,"_21524":51842,"_5":14790,"_28264":51819,"_3060":51843},[],"Run Lamassu in a Kubernetes cluster operated by your team. The Helm chart deploys the Lamassu services and their routing resources; you provide the cluster, persistent storage, identity provider, PostgreSQL, RabbitMQ and the network path used by clients.",{"_3604":371,"_31083":362,"_21524":51845,"_5":14790,"_28264":51823,"_3060":51846},[],"Workflow",{"_3604":372,"_31083":362,"_21524":51848,"_5":14790,"_28264":51823,"_3060":51849},[],"Use it for",{"_3604":373,"_31083":362,"_21524":51851,"_5":14790,"_28264":51823,"_3060":51852},[],"What it installs",{"_3604":374,"_31083":362,"_21524":51854,"_5":14790,"_28264":51823,"_3060":51855},[],"Helm",{"_3604":375,"_31083":362,"_21524":51857,"_5":14790,"_28264":51823,"_3060":51858},[],"Production and controlled environments",{"_3604":376,"_31083":362,"_21524":51860,"_5":14790,"_28264":51823,"_3060":51861},[],"Lamassu services and Gateway API resources",{"_3604":377,"_31083":362,"_21524":51863,"_5":14790,"_28264":51823,"_3060":50974},[],{"_3604":378,"_31083":362,"_21524":51865,"_5":14790,"_28264":51823,"_3060":51866},[],"Evaluation, demos, CI and small lab clusters",{"_3604":379,"_31083":362,"_21524":51868,"_5":14790,"_28264":51823,"_3060":51869},[],"PostgreSQL, Keycloak, RabbitMQ, Envoy Gateway and Lamassu",{"_3604":380,"_31083":362,"_21524":51871,"_5":14790,"_28264":51827,"_3060":51872},[],"The Lamassu chart is an **application chart**, not a cluster bootstrap chart. It creates the Kubernetes resources that run and configure Lamassu, but it expects the platform services those resources depend on to exist.",{"_3604":381,"_31083":362,"_21524":51874,"_5":14790,"_28264":51827,"_3060":51875},[],"Area",{"_3604":382,"_31083":362,"_21524":51877,"_5":14790,"_28264":51827,"_3060":51878},[],"The Lamassu chart provides",{"_3604":383,"_31083":362,"_21524":51880,"_5":14790,"_28264":51827,"_3060":51881},[],"You provide",{"_3604":384,"_31083":362,"_21524":51883,"_5":14790,"_28264":51827,"_3060":51884},[],"Lamassu applications",{"_3604":385,"_31083":362,"_21524":51886,"_5":14790,"_28264":51827,"_3060":51887},[],"Deployments and StatefulSets for the UI and APIs, internal Services, ConfigMaps, a ServiceAccount, and optional HPAs and PDBs",{"_3604":386,"_31083":362,"_21524":51889,"_5":14790,"_28264":51827,"_3060":51890},[],"A working Kubernetes cluster, compute capacity and access to the container images",{"_3604":387,"_31083":362,"_21524":51892,"_5":14790,"_28264":51827,"_3060":51893},[],"PostgreSQL data",{"_3604":388,"_31083":362,"_21524":51895,"_5":14790,"_28264":51827,"_3060":51896},[],"A pre-install/pre-upgrade job that creates the required databases and schemas, runs migrations and applies the authorization bootstrap",{"_3604":389,"_31083":362,"_21524":51898,"_5":14790,"_28264":51827,"_3060":51899},[],"A reachable PostgreSQL server, credentials allowed to create databases and schemas, and backup/HA operations",{"_3604":390,"_31083":362,"_21524":51901,"_5":14790,"_28264":51827,"_3060":51902},[],"Messaging",{"_3604":391,"_31083":362,"_21524":51904,"_5":14790,"_28264":51827,"_3060":51905},[],"RabbitMQ connection configuration for the Lamassu services; the connection can use AMQPS, with an optional private CA and an optional client certificate, both set through chart values",{"_3604":392,"_31083":362,"_21524":51907,"_5":14790,"_28264":51827,"_3060":51908},[],"A reachable RabbitMQ broker, credentials and its lifecycle",{"_3604":393,"_31083":362,"_21524":51910,"_5":14790,"_28264":51827,"_3060":51911},[],"Identity",{"_3604":394,"_31083":362,"_21524":51913,"_5":14790,"_28264":51827,"_3060":51914},[],"OIDC/JWT and external-authorization configuration, plus initial Lamassu authorization principals",{"_3604":395,"_31083":362,"_21524":51916,"_5":14790,"_28264":51827,"_3060":51917},[],"An OIDC provider, realm/tenant, client, users, groups and roles",{"_3604":396,"_31083":362,"_21524":51919,"_5":14790,"_28264":51827,"_3060":51920},[],"External routing",{"_3604":397,"_31083":362,"_21524":51922,"_5":14790,"_28264":51827,"_3060":51923},[],"One `Gateway`, `HTTPRoute` resources, an `EnvoyProxy` configuration and Envoy security policies",{"_3604":398,"_31083":362,"_21524":51925,"_5":14790,"_28264":51827,"_3060":51926},[],"Gateway API and Envoy CRDs, the Envoy Gateway controller, a `GatewayClass`, a load-balancer implementation and the external network path",{"_3604":399,"_31083":362,"_21524":51928,"_5":14790,"_28264":51827,"_3060":51929},[],"TLS",{"_3604":400,"_31083":362,"_21524":51931,"_5":14790,"_28264":51827,"_3060":51932},[],"In the default `tls.type: certManager` mode, cert-manager `Issuer` and CA `Certificate` resources and a chart-managed downstream `Certificate`; in the `tls.type: external` mode, a reference to your TLS Secret",{"_3604":401,"_31083":362,"_21524":51934,"_5":14790,"_28264":51827,"_3060":51935},[],"cert-manager only for the default `tls.type: certManager` mode; for trusted TLS, a trusted issuer or a populated TLS Secret",{"_3604":402,"_31083":362,"_21524":51937,"_5":14790,"_28264":51827,"_3060":51938},[],"Persistent application data",{"_3604":403,"_31083":362,"_21524":51940,"_5":14790,"_28264":51827,"_3060":51941},[],"PersistentVolumeClaims required by the default local KMS and VA storage",{"_3604":404,"_31083":362,"_21524":51943,"_5":14790,"_28264":51827,"_3060":51944},[],"A StorageClass, physical storage, backups and a shared/external backend when scaling requires one",{"_3604":405,"_31083":362,"_21524":51946,"_5":14790,"_28264":51827,"_3060":51947},[],"Optional integrations",{"_3604":406,"_31083":362,"_21524":51949,"_5":14790,"_28264":51827,"_3060":51950},[],"Configuration hooks for observability, AWS connectors and PKCS#11/HSM connectivity",{"_3604":407,"_31083":362,"_21524":51952,"_5":14790,"_28264":51827,"_3060":51953},[],"The observability backends, cloud credentials and production HSM or external key service",{"_3604":408,"_31083":362,"_21524":51955,"_5":14790,"_28264":51827,"_3060":51956},[],"The chart creates Lamassu's `Gateway` and routes. It does not install the Envoy Gateway controller or make the generated `LoadBalancer` Service reachable from your network.",{"_3604":409,"_31083":362,"_21524":51958,"_5":14790,"_28264":51827,"_3060":51959},[],"Use one Lamassu Gateway on ports 80 and 443 and let its HTTPRoutes dispatch traffic to every Lamassu service. Give that Gateway one externally reachable endpoint through the cluster load balancer, or forward traffic to it from an external proxy or NAT device. You do not need one Gateway per service.",{"_3604":410,"_31083":362,"_21524":51961,"_5":14790,"_28264":51831,"_3060":51962},[],"The chart creates one shared `Gateway` per Helm release. All chart-managed `HTTPRoute` resources attach to it. Envoy Gateway provisions the proxy data plane and a Kubernetes `LoadBalancer` Service for that Gateway.",{"_3604":411,"_31083":362,"_21524":51964,"_5":14790,"_28264":51831,"_3060":51965},[],"The `gateway.addresses` value is only an address request to the Gateway controller. It does not make an IP routable, open a firewall, configure DNS or create NAT. See Expose the Gateway before setting it.",{"_3604":412,"_31083":362,"_21524":51967,"_5":14790,"_28264":51835,"_3060":51968},[],"Kubernetes 1.24 or newer",{"_3604":413,"_31083":362,"_21524":51970,"_5":14790,"_28264":51835,"_3060":51971},[],"Helm 3.2 or newer",{"_3604":414,"_31083":362,"_21524":51973,"_5":14790,"_28264":51835,"_3060":51974},[],"Envoy Gateway 1.8 or newer and a `GatewayClass`",{"_3604":415,"_31083":362,"_21524":51976,"_5":14790,"_28264":51835,"_3060":51977},[],"cert-manager 1.14 or newer; required only for the default `tls.type: certManager` TLS mode, not for `tls.type: external`",{"_3604":416,"_31083":362,"_21524":51979,"_5":14790,"_28264":51835,"_3060":51980},[],"persistent storage suitable for the selected PostgreSQL, RabbitMQ, VA and KMS configuration",{"_3604":417,"_31083":362,"_21524":51982,"_5":14790,"_28264":51835,"_3060":51983},[],"a load-balancer implementation or another deliberate path from clients to the Gateway",{"_3604":418,"_31083":362,"_21524":51985,"_5":14790,"_28264":51835,"_3060":51986},[],"KMS deployments using the native PKCS#11 sidecar require Kubernetes 1.29 or newer. Prebuilt Lamassu container images are published for `linux/amd64` and `linux/arm64`, and the KMS PKCS#11 client module (`p11-kit-client.so`) is installed at the target architecture's Debian library path: `/usr/lib/x86_64-linux-gnu/pkcs11/p11-kit-client.so` on amd64 and `/usr/lib/aarch64-linux-gnu/pkcs11/p11-kit-client.so` on arm64. The x86\\_64 path is retained as a compatibility alias for existing configurations.",{"_3604":419,"_31083":362,"_21524":51988,"_5":14790,"_28264":51839,"_3060":51989},[],"<Card title=\"Install with Helm\" description=\"Prepare dependencies, configure values, install and verify a controlled deployment.\" href=\"/docs/deployment/self-hosted/helm\" />",{"_3604":420,"_31083":362,"_21524":51991,"_5":14790,"_28264":51839,"_3060":51992},[],"<Card title=\"Upgrade from 3.8.0\" description=\"Upgrade an existing Helm release to 4.0.0: architecture changes, breaking changes, migration steps and validation.\" href=\"/docs/upgrades/3-8-0-to-4-0-0\" />",{"_3604":421,"_31083":362,"_21524":51994,"_5":14790,"_28264":51839,"_3060":51995},[],"<Card title=\"Expose the Gateway\" description=\"Choose an external traffic design, understand gateway.addresses and handle multiple Gateways.\" href=\"/docs/deployment/self-hosted/networking\" />",{"_3604":422,"_31083":362,"_21524":51997,"_5":14790,"_28264":51839,"_3060":51998},[],"<Card title=\"Use Fastlane\" description=\"Bootstrap a complete evaluation or lab environment with one script.\" href=\"/docs/deployment/self-hosted/fastlane\" />",{"_3604":423,"_31083":423,"_5":15155,"_3060":52000,"_31421":52001,"_21524":52003,"_28264":423},"Deployment troubleshooting",[50730,50731,52002],"Operations",[],{"_3604":424,"_31083":423,"_21524":52005,"_5":14790,"_28264":423,"_3060":52006},[],"Diagnose access, service health and infrastructure dependencies.",{"_3604":425,"_31083":423,"_5":31418,"_21524":52008,"_28264":52009,"_3060":52010},[],"/docs/deployment/troubleshooting#diagnostic-sequence","Diagnostic sequence",{"_3604":426,"_31083":423,"_5":31418,"_21524":52012,"_28264":52013,"_3060":52014},[],"/docs/deployment/troubleshooting#reproduce-a-single-operation","Reproduce a single operation",{"_3604":427,"_31083":423,"_5":31418,"_21524":52016,"_28264":52017,"_3060":52018},[],"/docs/deployment/troubleshooting#separate-client-gateway-and-service","Separate client, Gateway and service",{"_3604":428,"_31083":423,"_5":31418,"_21524":52020,"_28264":52021,"_3060":52022},[],"/docs/deployment/troubleshooting#review-kubernetes-status","Review Kubernetes status",{"_3604":429,"_31083":423,"_5":31418,"_21524":52024,"_28264":52025,"_3060":52026},[],"/docs/deployment/troubleshooting#query-the-affected-service","Query the affected service",{"_3604":430,"_31083":423,"_5":31418,"_21524":52028,"_28264":52029,"_3060":52030},[],"/docs/deployment/troubleshooting#validate-the-result-from-outside","Validate the result from outside",{"_3604":431,"_31083":423,"_5":31418,"_21524":52032,"_28264":52033,"_3060":52034},[],"/docs/deployment/troubleshooting#minimal-evidence-collection","Minimal evidence collection",{"_3604":432,"_31083":423,"_5":31418,"_21524":52036,"_28264":52037,"_3060":52038},[],"/docs/deployment/troubleshooting#i-cannot-sign-in","I cannot sign in",{"_3604":433,"_31083":423,"_5":31418,"_21524":52040,"_28264":52041,"_3060":52042},[],"/docs/deployment/troubleshooting#everything-returns-403-or-5xx","Everything returns 403 or 5xx",{"_3604":434,"_31083":423,"_5":31418,"_21524":52044,"_28264":52045,"_3060":52046},[],"/docs/deployment/troubleshooting#api-500-errors","API 500 errors",{"_3604":435,"_31083":423,"_5":31418,"_21524":52048,"_28264":52049,"_3060":52050},[],"/docs/deployment/troubleshooting#a-pod-is-not-ready","A pod is not Ready",{"_3604":436,"_31083":423,"_5":31418,"_21524":52052,"_28264":52053,"_3060":52054},[],"/docs/deployment/troubleshooting#events-are-not-arriving","Events are not arriving",{"_3604":437,"_31083":423,"_5":31418,"_21524":52056,"_28264":52057,"_3060":52058},[],"/docs/deployment/troubleshooting#observability","Observability",{"_3604":438,"_31083":423,"_21524":52060,"_5":14790,"_28264":423,"_3060":52061},[],"Start by locating the failing layer. A Gateway response and an unready pod require different evidence. For rejected issuance or validation results, see PKI troubleshooting; for enrollment, see EST diagnostics.",{"_3604":439,"_31083":423,"_21524":52063,"_5":14790,"_28264":52013,"_3060":52064},[],"Note the time in UTC, user or principal, resource, endpoint and result. Avoid repeating a destructive action such as revocation or deletion.",{"_3604":440,"_31083":423,"_21524":52066,"_5":14790,"_28264":52017,"_3060":52067},[],"Check the HTTP status. A 401 points to authentication; a 403, to authorization; a 404, to route or resource; a 5xx, to the service or a dependency.",{"_3604":441,"_31083":423,"_21524":52069,"_5":14790,"_28264":52021,"_3060":52070},[],"Locate unready pods, restarts, recent events and the state of the release.",{"_3604":442,"_31083":423,"_21524":52072,"_5":14790,"_28264":52025,"_3060":52073},[],"Review its /health endpoint and its logs in the same time window. Then follow the indicated dependency: PostgreSQL, RabbitMQ, the OIDC provider or the cryptographic engine.",{"_3604":443,"_31083":423,"_21524":52075,"_5":14790,"_28264":52029,"_3060":52076},[],"For PKI, check the certificate, the chain, OCSP or CRL with the same type of client production uses.",{"_3604":444,"_31083":423,"_21524":52078,"_5":14790,"_28264":52033,"_3060":52079},[],"Replace the placeholders with your real release, namespace and deployment.",{"_3604":445,"_31083":423,"_21524":52081,"_5":14790,"_28264":52033,"_3060":52082},[],"Also run the chart's connectivity test:",{"_3604":446,"_31083":423,"_21524":52084,"_5":14790,"_28264":52033,"_3060":52085},[],"The test checks the health of CA, DMS Manager, Device Manager and VA, and verifies that the UI returns HTML. A passing test confirms basic connectivity, not a full issuance flow.",{"_3604":447,"_31083":423,"_21524":52087,"_5":14790,"_28264":52033,"_3060":52088},[],"The chart's services expose startup, readiness and liveness probes over /health. A pod can be running but receive no traffic if the readiness probe fails.",{"_3604":448,"_31083":423,"_21524":52090,"_5":14790,"_28264":52037,"_3060":52091},[],"If you receive a 401:",{"_3604":449,"_31083":423,"_21524":52093,"_5":14790,"_28264":52037,"_3060":52094},[],"check that the UI's OIDC authority is reachable from the browser;",{"_3604":450,"_31083":423,"_21524":52096,"_5":14790,"_28264":52037,"_3060":52097},[],"verify issuer, audience and expiration of the token;",{"_3604":451,"_31083":423,"_21524":52099,"_5":14790,"_28264":52037,"_3060":52100},[],"confirm the Gateway can fetch the keys from the JWKS URI;",{"_3604":452,"_31083":423,"_21524":52102,"_5":14790,"_28264":52037,"_3060":52103},[],"check that the provider's public and internal routes point to the same realm.",{"_3604":453,"_31083":423,"_21524":52105,"_5":14790,"_28264":52037,"_3060":52106},[],"If login succeeds but the APIs return 403:",{"_3604":454,"_31083":423,"_21524":52108,"_5":14790,"_28264":52037,"_3060":52109},[],"inspect the token's real claims;",{"_3604":455,"_31083":423,"_21524":52111,"_5":14790,"_28264":52037,"_3060":52112},[],"confirm they match an active principal;",{"_3604":456,"_31083":423,"_21524":52114,"_5":14790,"_28264":52037,"_3060":52115},[],"review the policies granted to that principal;",{"_3604":457,"_31083":423,"_21524":52117,"_5":14790,"_28264":52037,"_3060":52118},[],"verify that authz reaches PostgreSQL and its JWKS.",{"_3604":458,"_31083":423,"_21524":52120,"_5":14790,"_28264":52037,"_3060":52121},[],"On a fresh installation, confirm the migration Job finished. That Job creates schemas, migrates authz, preloads policies and provisions the principals defined in services.authz.bootstrap.",{"_3604":459,"_31083":423,"_21524":52123,"_5":14790,"_28264":52041,"_3060":52124},[],"External authorization fails closed by default. If authz is unavailable, protected routes are blocked.",{"_3604":460,"_31083":423,"_21524":52126,"_5":14790,"_28264":52041,"_3060":52127},[],"Locate the authz pod and Service.",{"_3604":461,"_31083":423,"_21524":52129,"_5":14790,"_28264":52041,"_3060":52130},[],"Check /health, logs and its database connection.",{"_3604":462,"_31083":423,"_21524":52132,"_5":14790,"_28264":52041,"_3060":52133},[],"Verify the DNS and port configured in externalAuthorization.",{"_3604":463,"_31083":423,"_21524":52135,"_5":14790,"_28264":52041,"_3060":52136},[],"Check the check route is /v1/ext\\_authz/check.",{"_3604":464,"_31083":423,"_21524":52138,"_5":14790,"_28264":52041,"_3060":52139},[],"Do not switch to failOpen: true as a permanent workaround: it would allow traffic without authorization during the outage.",{"_3604":465,"_31083":423,"_21524":52141,"_5":14790,"_28264":52045,"_3060":52142},[],"A 500 indicates an internal failure, such as an unavailable database. The `{\"err\": ...}` body currently includes the text of the internal error, which can contain schema, table and constraint names and, on connection failures, the database host and user (not the password). Find the cause in the service log using the request time, and do not forward the body to third parties or show it to end users. This is a known information-disclosure defect: generic messages are planned for 500 responses, keeping the detail only in the service log (tracked in lamassuiot#814). The authorization connector also returns the internal error, in the `details.error` field. Some request errors, such as a key size the engine does not support, are also returned as 500.",{"_3604":466,"_31083":423,"_21524":52144,"_5":14790,"_28264":52049,"_3060":52145},[],"Review kubectl describe pod first. Common causes are:",{"_3604":467,"_31083":423,"_21524":52147,"_5":14790,"_28264":52049,"_3060":52148},[],"wrong credentials or DNS for PostgreSQL or RabbitMQ;",{"_3604":468,"_31083":423,"_21524":52150,"_5":14790,"_28264":52049,"_3060":52151},[],"a missing AMQP CA or client certificate Secret referenced by `amqp.ca.secretName` or `amqp.client.secretName`;",{"_3604":469,"_31083":423,"_21524":52153,"_5":14790,"_28264":52049,"_3060":52154},[],"unbound persistent volume;",{"_3604":470,"_31083":423,"_21524":52156,"_5":14790,"_28264":52049,"_3060":52157},[],"inaccessible image or incorrect pull policy;",{"_3604":471,"_31083":423,"_21524":52159,"_5":14790,"_28264":52049,"_3060":52160},[],"invalid cryptographic engine configuration;",{"_3604":472,"_31083":423,"_21524":52162,"_5":14790,"_28264":52049,"_3060":52163},[],"CPU or memory limits set too low;",{"_3604":473,"_31083":423,"_21524":52165,"_5":14790,"_28264":52049,"_3060":52166},[],"an incomplete prior migration.",{"_3604":474,"_31083":423,"_21524":52168,"_5":14790,"_28264":52049,"_3060":52169},[],"Generic values request 100 mCPU and 128 MiB and limit to 500 mCPU and 512 MiB. Tune per service when you see OOMKills, throttling or slow startups.",{"_3604":475,"_31083":423,"_21524":52171,"_5":14790,"_28264":52049,"_3060":52172},[],"Filesystem-based KMS engines and VA local storage use exclusive-access volumes. Keep a single replica or migrate to shared backends before enabling autoscaling.",{"_3604":476,"_31083":423,"_21524":52174,"_5":14790,"_28264":52049,"_3060":52175},[],"Internal calls now fail fast instead of hanging for the clients covered by Egress proxy: connection attempts time out after 30 seconds and TLS handshakes after 10 seconds. The authorization-engine connector keeps its own transport without these dial and handshake timeouts; only its overall 30-second request timeout bounds each call. If an egress proxy handles the cluster's outbound traffic, check the pod's `HTTP_PROXY`, `HTTPS_PROXY` and `NO_PROXY` environment variables and list in-cluster service names in `NO_PROXY`.",{"_3604":477,"_31083":423,"_21524":52177,"_5":14790,"_28264":52053,"_3060":52178},[],"Domain and audit events depend on the bus publisher:",{"_3604":478,"_31083":423,"_21524":52180,"_5":14790,"_28264":52053,"_3060":52181},[],"verify it is enabled in the emitting service;",{"_3604":479,"_31083":423,"_21524":52183,"_5":14790,"_28264":52053,"_3060":52184},[],"check AMQP connectivity and credentials;",{"_3604":480,"_31083":423,"_21524":52186,"_5":14790,"_28264":52053,"_3060":52187},[],"review exchange, routing key, queues and consumers;",{"_3604":481,"_31083":423,"_21524":52189,"_5":14790,"_28264":52053,"_3060":52190},[],"inspect dead-letter queues;",{"_3604":482,"_31083":423,"_21524":52192,"_5":14790,"_28264":52053,"_3060":52193},[],"alert on orphan durable queues and backlog growth.",{"_3604":483,"_31083":423,"_21524":52195,"_5":14790,"_28264":52053,"_3060":52196},[],"If `amqp.tls` is enabled, verify the TLS side as well:",{"_3604":484,"_31083":423,"_21524":52198,"_5":14790,"_28264":52053,"_3060":52199},[],"confirm the broker listener speaks AMQPS on the configured port — the default port stays `5672` and does not follow TLS automatically;",{"_3604":485,"_31083":423,"_21524":52201,"_5":14790,"_28264":52053,"_3060":52202},[],"if you set `amqp.ca.secretName`, confirm the Secret exists in the release namespace and its data key matches `amqp.ca.certificateKey` (default `ca.crt`); if `amqp.ca.secretName` is not set, the clients trust the system CAs;",{"_3604":486,"_31083":423,"_21524":52204,"_5":14790,"_28264":52053,"_3060":52205},[],"remember that a missing referenced Secret prevents the consuming pods from starting;",{"_3604":487,"_31083":423,"_21524":52207,"_5":14790,"_28264":52053,"_3060":52208},[],"after updating the CA or client certificate Secret, restart the consuming pods: the AMQP client loads certificates at startup.",{"_3604":488,"_31083":423,"_21524":52210,"_5":14790,"_28264":52053,"_3060":52211},[],"See AMQP TLS (AMQPS) for the full configuration.",{"_3604":489,"_31083":423,"_21524":52213,"_5":14790,"_28264":52053,"_3060":52214},[],"A consumer outage does not always prevent the main operation from completing. That is why you must monitor RabbitMQ and independently verify the persistence of audit logs.",{"_3604":490,"_31083":423,"_21524":52216,"_5":14790,"_28264":52057,"_3060":52217},[],"The chart can enable OpenTelemetry instrumentation for the services that support it, including authz; it does not configure OpenTelemetry for AWS Connector, wfx or the UI. Traces are exported over OTLP HTTP and logs can be directed to a compatible endpoint, such as VictoriaLogs. Use a correlation identifier and the same time window to join Gateway, service and dependency.",{"_3604":491,"_31083":423,"_21524":52219,"_5":14790,"_28264":52057,"_3060":52220},[],"Before closing an incident, record:",{"_3604":492,"_31083":423,"_21524":52222,"_5":14790,"_28264":52057,"_3060":52223},[],"the confirmed cause;",{"_3604":493,"_31083":423,"_21524":52225,"_5":14790,"_28264":52057,"_3060":52226},[],"the time scope and affected resources;",{"_3604":494,"_31083":423,"_21524":52228,"_5":14790,"_28264":52057,"_3060":52229},[],"the commands or queries used;",{"_3604":495,"_31083":423,"_21524":52231,"_5":14790,"_28264":52057,"_3060":52232},[],"the applied change and how to revert it;",{"_3604":496,"_31083":423,"_21524":52234,"_5":14790,"_28264":52057,"_3060":52235},[],"validation from a consumer;",{"_3604":497,"_31083":423,"_21524":52237,"_5":14790,"_28264":52057,"_3060":52238},[],"the preventive action and its owner.",{"_3604":498,"_31083":498,"_5":15155,"_3060":52240,"_31421":52241,"_21524":52245,"_28264":498},"Data model",[50730,52242,52243,52244],"Platform","Administration","Access control",[],{"_3604":499,"_31083":498,"_21524":52247,"_5":14790,"_28264":498,"_3060":52248},[],"Entities and relationships from the pki.json schema that authz uses to evaluate access policies.",{"_3604":500,"_31083":498,"_5":31418,"_21524":52250,"_28264":52251,"_3060":52252},[],"/docs/platform/administration/access-control/data-model#schema-relationships","Schema relationships",{"_3604":501,"_31083":498,"_5":31418,"_21524":52254,"_28264":52255,"_3060":52256},[],"/docs/platform/administration/access-control/data-model#schema-entities","Schema entities",{"_3604":502,"_31083":498,"_21524":52258,"_5":14790,"_28264":498,"_3060":52259},[],"The `connectors/authz/pki.json` schema defines the entities in the `pki` authorization namespace. A policy identifies a resource type through `namespace: pki`, `schema_name` and `entity_type`. For example, `ca.certificate` identifies the `certificate` entity type in the `ca` schema.",{"_3604":503,"_31083":498,"_21524":52261,"_5":14790,"_28264":52251,"_3060":52262},[],"Each arrow starts at the entity that declares the relationship and points to its `target_entity`. The value of `foreign_key`, the source column, appears below the label. In `pki.json`, each relationship's `name` matches that column. Select the diagram to enlarge it and scroll through it.",{"_3604":504,"_31083":498,"_21524":52264,"_5":14790,"_28264":52251,"_3060":52265},[],"A policy can propagate actions from the referenced entity to the one that declares the relationship. For example, to grant read access to a DMS's devices, a rule starts from `dmsmanager.dms`, targets `devicemanager.device` and specifies `via: dms_owner`.",{"_3604":505,"_31083":498,"_21524":52267,"_5":14790,"_28264":52251,"_3060":52268},[],"When filtering inherited access, `authz` matches the `foreign_key` column against the first `primary_key` column of the referenced entity. For example, it matches `subject_common_name` to `device.id`, `issuer_meta_serial_number` to `ca_certificate.id` and the links to `kms_key` to `kms_key.key_id`.",{"_3604":506,"_31083":498,"_21524":52270,"_5":14790,"_28264":52255,"_3060":52271},[],"Entity (`schema_name.entity_type`)",{"_3604":507,"_31083":498,"_21524":52273,"_5":14790,"_28264":52255,"_3060":52274},[],"Table (`table_name`)",{"_3604":508,"_31083":498,"_21524":52276,"_5":14790,"_28264":52255,"_3060":52277},[],"Key (`primary_key`)",{"_3604":509,"_31083":498,"_21524":52279,"_5":14790,"_28264":52255,"_3060":52280},[],"`alerts.event`",{"_3604":510,"_31083":498,"_21524":52282,"_5":14790,"_28264":52255,"_3060":52283},[],"`events`",{"_3604":511,"_31083":498,"_21524":52285,"_5":14790,"_28264":52255,"_3060":52286},[],"`event_type`",{"_3604":512,"_31083":498,"_21524":52288,"_5":14790,"_28264":52255,"_3060":52289},[],"`alerts.subscription`",{"_3604":513,"_31083":498,"_21524":52291,"_5":14790,"_28264":52255,"_3060":52292},[],"`subscriptions`",{"_3604":514,"_31083":498,"_21524":52294,"_5":14790,"_28264":52255,"_3060":52295},[],"`id`",{"_3604":515,"_31083":498,"_21524":52297,"_5":14790,"_28264":52255,"_3060":52298},[],"`ca.ca_certificate`",{"_3604":516,"_31083":498,"_21524":52300,"_5":14790,"_28264":52255,"_3060":52301},[],"`ca_certificates`",{"_3604":517,"_31083":498,"_21524":52303,"_5":14790,"_28264":52255,"_3060":52295},[],{"_3604":518,"_31083":498,"_21524":52305,"_5":14790,"_28264":52255,"_3060":52306},[],"`ca.certificate`",{"_3604":519,"_31083":498,"_21524":52308,"_5":14790,"_28264":52255,"_3060":52309},[],"`certificates`",{"_3604":520,"_31083":498,"_21524":52311,"_5":14790,"_28264":52255,"_3060":52312},[],"`serial_number`",{"_3604":521,"_31083":498,"_21524":52314,"_5":14790,"_28264":52255,"_3060":52315},[],"`ca.issuance_profile`",{"_3604":522,"_31083":498,"_21524":52317,"_5":14790,"_28264":52255,"_3060":52318},[],"`issuance_profiles`",{"_3604":523,"_31083":498,"_21524":52320,"_5":14790,"_28264":52255,"_3060":52295},[],{"_3604":524,"_31083":498,"_21524":52322,"_5":14790,"_28264":52255,"_3060":52323},[],"`devicemanager.device_group`",{"_3604":525,"_31083":498,"_21524":52325,"_5":14790,"_28264":52255,"_3060":52326},[],"`device_groups`",{"_3604":526,"_31083":498,"_21524":52328,"_5":14790,"_28264":52255,"_3060":52295},[],{"_3604":527,"_31083":498,"_21524":52330,"_5":14790,"_28264":52255,"_3060":52331},[],"`devicemanager.device`",{"_3604":528,"_31083":498,"_21524":52333,"_5":14790,"_28264":52255,"_3060":52334},[],"`devices`",{"_3604":529,"_31083":498,"_21524":52336,"_5":14790,"_28264":52255,"_3060":52295},[],{"_3604":530,"_31083":498,"_21524":52338,"_5":14790,"_28264":52255,"_3060":52339},[],"`dmsmanager.dms`",{"_3604":531,"_31083":498,"_21524":52341,"_5":14790,"_28264":52255,"_3060":52342},[],"`dms`",{"_3604":532,"_31083":498,"_21524":52344,"_5":14790,"_28264":52255,"_3060":52295},[],{"_3604":533,"_31083":498,"_21524":52346,"_5":14790,"_28264":52255,"_3060":52347},[],"`kms.kms_key`",{"_3604":534,"_31083":498,"_21524":52349,"_5":14790,"_28264":52255,"_3060":52350},[],"`kms_keys`",{"_3604":535,"_31083":498,"_21524":52352,"_5":14790,"_28264":52255,"_3060":52353},[],"`key_id`, `engine_id`",{"_3604":536,"_31083":498,"_21524":52355,"_5":14790,"_28264":52255,"_3060":52356},[],"`va.crl_settings`",{"_3604":537,"_31083":498,"_21524":52358,"_5":14790,"_28264":52255,"_3060":52359},[],"`crl_settings`",{"_3604":538,"_31083":498,"_21524":52361,"_5":14790,"_28264":52255,"_3060":52362},[],"`ca_id`",{"_3604":539,"_31083":498,"_21524":52364,"_5":14790,"_28264":52255,"_3060":52365},[],"Events, subscriptions and device groups have their own actions and filters. Their `relations` lists are empty and they have zero incoming references in the schema. For `ca.certificate`, `view_tables` also lists `certificates_view`.",{"_3604":540,"_31083":498,"_21524":52367,"_5":14790,"_28264":52255,"_3060":52368},[],"Each entity declares instance-level operations in `atomic_actions`, operations that require no resource ID in `global_actions`, and the columns and types accepted by `column_filters` in `filterable`.",{"_3604":541,"_31083":498,"_21524":52370,"_5":14790,"_28264":52255,"_3060":52371},[],"<Card title=\"Access inherited through relations\" href=\"/docs/platform/administration/access-control#access-inherited-through-relations\" />",{"_3604":542,"_31083":542,"_5":15155,"_3060":52373,"_31421":52374,"_21524":52375,"_28264":542},"Access control overview",[50730,52242,52243,52244],[],{"_3604":543,"_31083":542,"_21524":52377,"_5":14790,"_28264":542,"_3060":52378},[],"Design who can access Lamassu through principals, policies, resource permissions and HTTP route authorization.",{"_3604":544,"_31083":542,"_5":31418,"_21524":52380,"_28264":52381,"_3060":52382},[],"/docs/platform/administration/access-control#essential-concepts","Essential concepts",{"_3604":545,"_31083":542,"_5":31418,"_21524":52384,"_28264":52385,"_3060":52386},[],"/docs/platform/administration/access-control#two-decision-systems","Two decision systems",{"_3604":546,"_31083":542,"_5":31418,"_21524":52388,"_28264":52389,"_3060":52390},[],"/docs/platform/administration/access-control#integrated-or-external-http-services","Integrated or external HTTP services",{"_3604":547,"_31083":542,"_5":31418,"_21524":52392,"_28264":52393,"_3060":52394},[],"/docs/platform/administration/access-control#authentication-only-routes-and-unmapped-paths","Authentication-only routes and unmapped paths",{"_3604":548,"_31083":542,"_5":31418,"_21524":52396,"_28264":52397,"_3060":52398},[],"/docs/platform/administration/access-control#services-developed-by-lamassu","Services developed by Lamassu",{"_3604":549,"_31083":542,"_5":31418,"_21524":52400,"_28264":52401,"_3060":52402},[],"/docs/platform/administration/access-control#how-the-two-paths-relate","How the two paths relate",{"_3604":550,"_31083":542,"_5":31418,"_21524":52404,"_28264":52405,"_3060":52406},[],"/docs/platform/administration/access-control#oidc-principals","OIDC principals",{"_3604":551,"_31083":542,"_5":31418,"_21524":52408,"_28264":52409,"_3060":52410},[],"/docs/platform/administration/access-control#x509-principals","X.509 principals",{"_3604":552,"_31083":542,"_5":31418,"_21524":52412,"_28264":52413,"_3060":52414},[],"/docs/platform/administration/access-control#when-several-principals-match","When several principals match",{"_3604":553,"_31083":542,"_5":31418,"_21524":52416,"_28264":52417,"_3060":52418},[],"/docs/platform/administration/access-control#how-policies-express-access","How policies express access",{"_3604":554,"_31083":542,"_5":31418,"_21524":52420,"_28264":52421,"_3060":52422},[],"/docs/platform/administration/access-control#global-and-direct-access","Global and direct access",{"_3604":555,"_31083":542,"_5":31418,"_21524":52424,"_28264":52425,"_3060":52426},[],"/docs/platform/administration/access-control#access-inherited-through-relations","Access inherited through relations",{"_3604":556,"_31083":542,"_5":31418,"_21524":52428,"_28264":52429,"_3060":52430},[],"/docs/platform/administration/access-control#attribute-filtered-access","Attribute-filtered access",{"_3604":557,"_31083":542,"_5":31418,"_21524":52432,"_28264":52433,"_3060":52434},[],"/docs/platform/administration/access-control#http-rules","HTTP rules",{"_3604":558,"_31083":542,"_5":31418,"_21524":52436,"_28264":52437,"_3060":52438},[],"/docs/platform/administration/access-control#included-policies","Included policies",{"_3604":559,"_31083":542,"_5":31418,"_21524":52440,"_28264":52441,"_3060":51380},[],"/docs/platform/administration/access-control#provision-the-first-administrator",{"_3604":560,"_31083":542,"_5":31418,"_21524":52443,"_28264":52444,"_3060":52445},[],"/docs/platform/administration/access-control#prepare-the-identity-provider","Prepare the identity provider",{"_3604":561,"_31083":542,"_5":31418,"_21524":52447,"_28264":52448,"_3060":52449},[],"/docs/platform/administration/access-control#configure-token-validation","Configure token validation",{"_3604":562,"_31083":542,"_5":31418,"_21524":52451,"_28264":52452,"_3060":52453},[],"/docs/platform/administration/access-control#install-and-verify-administrative-access","Install and verify administrative access",{"_3604":563,"_31083":542,"_5":31418,"_21524":52455,"_28264":52456,"_3060":52457},[],"/docs/platform/administration/access-control#test-an-unprivileged-identity","Test an unprivileged identity",{"_3604":564,"_31083":542,"_5":31418,"_21524":52459,"_28264":52460,"_3060":52461},[],"/docs/platform/administration/access-control#reduce-use-of-the-bootstrap-administrator","Reduce use of the bootstrap administrator",{"_3604":565,"_31083":542,"_5":31418,"_21524":52463,"_28264":52464,"_3060":52465},[],"/docs/platform/administration/access-control#fastlane-bootstrap","Fastlane bootstrap",{"_3604":566,"_31083":542,"_5":31418,"_21524":52467,"_28264":52468,"_3060":52469},[],"/docs/platform/administration/access-control#design-least-privilege-roles","Design least-privilege roles",{"_3604":567,"_31083":542,"_5":31418,"_21524":52471,"_28264":52472,"_3060":52473},[],"/docs/platform/administration/access-control#changes-and-access-revocation","Changes and access revocation",{"_3604":568,"_31083":542,"_5":31418,"_21524":52475,"_28264":52476,"_3060":52477},[],"/docs/platform/administration/access-control#operational-checklist","Operational checklist",{"_3604":569,"_31083":542,"_5":31418,"_21524":52479,"_28264":52480,"_3060":52481},[],"/docs/platform/administration/access-control#diagnostics","Diagnostics",{"_3604":570,"_31083":542,"_5":31418,"_21524":52483,"_28264":52484,"_3060":52485},[],"/docs/platform/administration/access-control#the-response-is-401","The response is 401",{"_3604":571,"_31083":542,"_5":31418,"_21524":52487,"_28264":52488,"_3060":52489},[],"/docs/platform/administration/access-control#the-response-is-403","The response is 403",{"_3604":572,"_31083":542,"_5":31418,"_21524":52491,"_28264":52492,"_3060":52493},[],"/docs/platform/administration/access-control#everything-returns-403","Everything returns 403",{"_3604":573,"_31083":542,"_5":31418,"_21524":52495,"_28264":52496,"_3060":52497},[],"/docs/platform/administration/access-control#access-appears-without-a-policy-grant","Access appears without a policy grant",{"_3604":574,"_31083":542,"_5":31418,"_21524":52499,"_28264":52500,"_3060":52501},[],"/docs/platform/administration/access-control#everything-fails-when-authz-is-unavailable","Everything fails when authz is unavailable",{"_3604":575,"_31083":542,"_21524":52503,"_5":14790,"_28264":542,"_3060":52504},[],"Lamassu access control turns an authenticated identity into concrete permissions. The OIDC provider or the client certificate proves **who** makes a request; the `authz` service decides **what that identity can do** and **over which resources**.",{"_3604":576,"_31083":542,"_21524":52506,"_5":14790,"_28264":542,"_3060":52507},[],"Lamassu does not assign permissions directly to users. The full chain is:",{"_3604":577,"_31083":542,"_21524":52509,"_5":14790,"_28264":542,"_3060":52510},[],"This model lets you represent people, identity-provider groups, service accounts and devices without coupling authorization to a specific provider.",{"_3604":578,"_31083":542,"_21524":52512,"_5":14790,"_28264":52381,"_3060":52513},[],"A **principal** connects a credential to Lamassu. It defines how to recognize an OIDC or X.509 identity and can be active or disabled.",{"_3604":579,"_31083":542,"_21524":52515,"_5":14790,"_28264":52381,"_3060":52516},[],"A **policy** groups reusable permissions. It can be granted to several principals and can contain rules about Lamassu entities, rules about HTTP routes or both.",{"_3604":580,"_31083":542,"_21524":52518,"_5":14790,"_28264":52381,"_3060":52519},[],"An **entity rule** grants actions over resources such as certification authorities, certificates, issuance profiles, devices, DMSs, keys or alert subscriptions. It can cover all resources of a type or be limited by identifier, relation or attribute.",{"_3604":581,"_31083":542,"_21524":52521,"_5":14790,"_28264":52381,"_3060":52522},[],"An **HTTP rule** grants actions associated with API routes. It is the mechanism the Gateway uses to decide whether a request may cross the perimeter.",{"_3604":582,"_31083":542,"_21524":52524,"_5":14790,"_28264":52381,"_3060":52525},[],"A **grant** is the association between a principal and a policy. Removing the grant removes all permissions contributed by that policy, without modifying it for other principals.",{"_3604":583,"_31083":542,"_21524":52527,"_5":14790,"_28264":52381,"_3060":52528},[],"A valid JWT or a valid client certificate does not grant access by itself. The credential must match at least one active principal and, unless the HTTP schema exempts the route, one of its policies must allow the requested operation. See *Authentication-only routes and unmapped paths* for those exemptions.",{"_3604":584,"_31083":542,"_21524":52530,"_5":14790,"_28264":52385,"_3060":52531},[],"Lamassu uses two authorization paths depending on who implements the protected service. They share principals, policies and grants, but they do not interpret the rules the same way.",{"_3604":585,"_31083":542,"_21524":52533,"_5":14790,"_28264":52385,"_3060":52534},[],"An external service can be protected without knowing Lamassu's internal authorization model. A service developed by Lamassu embeds the authorization engine and can decide on concrete resources and filter its queries.",{"_3604":586,"_31083":542,"_21524":52536,"_5":14790,"_28264":52389,"_3060":52537},[],"This path protects APIs that join the platform through the Gateway but do not natively implement Lamassu's authorization SDK. Job Manager is the current example. The same pattern allows integrating other HTTP services as long as their routes are described in an `authz` HTTP schema.",{"_3604":587,"_31083":542,"_21524":52539,"_5":14790,"_28264":52389,"_3060":52540},[],"The decision is made **before forwarding the request to the service**:",{"_3604":588,"_31083":542,"_21524":52542,"_5":14790,"_28264":52389,"_3060":52543},[],"Envoy Gateway authenticates the request, usually validating a JWT against the OIDC provider's JWKS.",{"_3604":589,"_31083":542,"_21524":52545,"_5":14790,"_28264":52389,"_3060":52546},[],"For a protected route, Envoy sends the method, URL, headers and required data to `/v1/ext_authz/check`.",{"_3604":590,"_31083":542,"_21524":52548,"_5":14790,"_28264":52389,"_3060":52549},[],"`authz` extracts the credential and resolves all active principals matching it.",{"_3604":591,"_31083":542,"_21524":52551,"_5":14790,"_28264":52389,"_3060":52552},[],"It separately loads the policies granted to each principal.",{"_3604":592,"_31083":542,"_21524":52554,"_5":14790,"_28264":52389,"_3060":52555},[],"The HTTP schema translates the method and route combination into a logical action, such as `nbi-job-read` or `nbi-workflow-create`.",{"_3604":593,"_31083":542,"_21524":52557,"_5":14790,"_28264":52389,"_3060":52558},[],"`authz` looks for an HTTP rule granting that action.",{"_3604":594,"_31083":542,"_21524":52560,"_5":14790,"_28264":52389,"_3060":52561},[],"If the route declares constraints, it compares request data with the normalized attributes of the same principal contributing the policy; the policy's own `param_constraints` also pin the granted action to literal request values.",{"_3604":595,"_31083":542,"_21524":52563,"_5":14790,"_28264":52389,"_3060":52564},[],"A satisfying result lets Envoy forward the request; any other response blocks it at the Gateway.",{"_3604":596,"_31083":542,"_21524":52566,"_5":14790,"_28264":52389,"_3060":52567},[],"When it allows access, `authz` returns the selected principal in the `X-Principal-ID` response header. The Gateway can propagate that header to the service to preserve the identity context. Clients cannot forge this header: the Gateway removes client-supplied `X-Principal-Id` (and the other forwarded identity and certificate headers) before forwarding, so only `authz` can set it. See Expose the Gateway for the full list of stripped headers.",{"_3604":597,"_31083":542,"_21524":52569,"_5":14790,"_28264":52389,"_3060":52570},[],"HTTP rules primarily answer &#x2A;*\"can this identity call this API operation?\"**. On their own they do not produce filters over the external service's database. To limit a route to a specific device, tenant or client, either the schema declares a constraint relating a request value to a normalized attribute of the principal, or the policy pins the request value to a literal with `param_constraints`. The first scopes each identity to its own resources through a single grant; the second restricts a grant to a fixed value regardless of who holds it.",{"_3604":598,"_31083":542,"_21524":52572,"_5":14790,"_28264":52393,"_3060":52573},[],"Two schema-level settings cover endpoints that policies do not mention:",{"_3604":599,"_31083":542,"_21524":52575,"_5":14790,"_28264":52393,"_3060":52576},[],"**`skip_authz: true` on a route** allows any identity that matches an active principal to reach it, even one with no granted policies. Use it for paths such as `/openapi.json` or `/health` that every authenticated caller should be able to access. The request still has to authenticate successfully: a credential that fails validation or matches no active principal is rejected before this setting is considered. A `skip_authz` route cannot declare constraints, and it wins over any other schema's route or default action for the same request.",{"_3604":600,"_31083":542,"_21524":52578,"_5":14790,"_28264":52393,"_3060":52579},[],"**`default_action` with `base_paths`** decides what happens when a request falls under a path prefix the schema owns but no explicit route matches. `deny` — the value the Job Manager schema ships with — turns the implicit denial of unmapped paths into an explicit, auditable statement; `allow` opens unmapped endpoints under that prefix to any identity that matches an active principal.",{"_3604":601,"_31083":542,"_21524":52581,"_5":14790,"_28264":52393,"_3060":52582},[],"These are decisions of the schema, not of a policy: `skip_authz` removes the grant check for that route, even when another schema maps the same request to an action that requires a grant, and `default_action` only covers requests that no explicit route in any schema matches. Keep three rules in mind:",{"_3604":602,"_31083":542,"_21524":52584,"_5":14790,"_28264":52393,"_3060":52585},[],"`default_action` requires at least one `base_paths` entry, and base paths are absolute paths such as `/api/wfx/nbi/v1`.",{"_3604":603,"_31083":542,"_21524":52587,"_5":14790,"_28264":52393,"_3060":52588},[],"An explicit route in any schema takes precedence: the fallback only decides requests that no schema's routes cover. When the prefixes of two schemas overlap, the longest matching prefix decides.",{"_3604":604,"_31083":542,"_21524":52590,"_5":14790,"_28264":52393,"_3060":52591},[],"Two schemas cannot claim the same base path with different default actions; the conflicting schema fails to load.",{"_3604":605,"_31083":542,"_21524":52593,"_5":14790,"_28264":52393,"_3060":52594},[],"A `skip_authz` route and a `default_action: \"allow\"` prefix grant access without consulting any policy. Every identity that matches an active principal can reach what they open, including identities with no granted policies. A `skip_authz` route in one schema also opens a request that another schema maps to a grant-protected action. Review these settings whenever you add or upgrade an integrated service.",{"_3604":606,"_31083":542,"_21524":52596,"_5":14790,"_28264":52393,"_3060":52597},[],"A schema can also make an individual route accept the credential from the URL. **`query_token: true` on a route** makes it accept the OIDC access token from the `access_token` query parameter, but only when the request carries neither an `Authorization: Bearer` header nor a client-certificate header: a credential in a header always wins. The token is validated and authorized exactly like a Bearer token, so the route's action still requires a policy grant, and routes that do not opt in never read the query parameter. The dashboard's experimental browser terminal uses this mechanism, because the WebSocket connection its browser client opens cannot set request headers.",{"_3604":607,"_31083":542,"_21524":52599,"_5":14790,"_28264":52393,"_3060":52600},[],"Query strings are often recorded. `authz` replaces the `access_token` value with `REDACTED` in its own decision logs, but other logs that capture the URL — the Gateway access log, service request logs, tracing — are not redacted. Keep `query_token` for WebSocket routes and short-lived tokens.",{"_3604":608,"_31083":542,"_21524":52602,"_5":14790,"_28264":52397,"_3060":52603},[],"Lamassu's native services embed authorization in their middleware and know the entities they operate on: certificates, CAs, issuance profiles, keys, devices, DMSs or subscriptions, among others.",{"_3604":609,"_31083":542,"_21524":52605,"_5":14790,"_28264":52397,"_3060":52606},[],"The decision is made with the domain operation context:",{"_3604":610,"_31083":542,"_21524":52608,"_5":14790,"_28264":52397,"_3060":52609},[],"The middleware extracts the credential and resolves the matching principals.",{"_3604":611,"_31083":542,"_21524":52611,"_5":14790,"_28264":52397,"_3060":52612},[],"The endpoint identifies the action, the entity type and, when applicable, the key of the requested resource.",{"_3604":612,"_31083":542,"_21524":52614,"_5":14790,"_28264":52397,"_3060":52615},[],"`authz` gathers the entity rules of the granted policies.",{"_3604":613,"_31083":542,"_21524":52617,"_5":14790,"_28264":52397,"_3060":52618},[],"The engine evaluates direct grants, attribute filters and relations with other entities.",{"_3604":614,"_31083":542,"_21524":52620,"_5":14790,"_28264":52397,"_3060":52621},[],"For an individual operation, it checks that the concrete resource satisfies the computed scope.",{"_3604":615,"_31083":542,"_21524":52623,"_5":14790,"_28264":52397,"_3060":52624},[],"For a listing, it generates a SQL filter that the service adds to its own query.",{"_3604":616,"_31083":542,"_21524":52626,"_5":14790,"_28264":52397,"_3060":52627},[],"Here the engine answers &#x2A;*\"can this identity perform this action on this concrete resource?\"**.",{"_3604":617,"_31083":542,"_21524":52629,"_5":14790,"_28264":52397,"_3060":52630},[],"Actions fall into two groups:",{"_3604":618,"_31083":542,"_21524":52632,"_5":14790,"_28264":52397,"_3060":52633},[],"**Global actions** do not need a resource identifier. `create`, `import` or access to a console section are common examples.",{"_3604":619,"_31083":542,"_21524":52635,"_5":14790,"_28264":52397,"_3060":52636},[],"**Atomic actions** are evaluated on a concrete instance. For certificates these include `read`, `metadata-update`, `status-update` and `delete`; for a CA there are also `sign`, `reissue` and other lifecycle operations.",{"_3604":620,"_31083":542,"_21524":52638,"_5":14790,"_28264":52397,"_3060":52639},[],"Filtering inside the service prevents leaks in listings: unauthorized resources are excluded from the SQL query instead of being fetched and hidden later in the interface.",{"_3604":621,"_31083":542,"_21524":52641,"_5":14790,"_28264":52401,"_3060":52642},[],"They are not two equivalent controls applied twice. HTTP rules protect the perimeter of an integrated service; entity rules express permissions over the data model of the native services.",{"_3604":622,"_31083":542,"_21524":52644,"_5":14790,"_28264":52401,"_3060":52645},[],"A policy can contain both rule types when an identity needs to operate Lamassu resources and also call an integrated API. Granting an entity rule does not automatically grant an HTTP action, nor does an HTTP rule create access over an entity.",{"_3604":623,"_31083":542,"_21524":52647,"_5":14790,"_28264":52401,"_3060":52648},[],"If no combination of principal, policy and rule allows the operation, Lamassu denies it, unless the HTTP schema declares `skip_authz` on the route or `default_action: allow` on a base path that covers it (see *Authentication-only routes and unmapped paths*). Additionally, `auth.externalAuthorization.failOpen` is `false` by default: if `authz` is unavailable, the Gateway blocks protected routes.",{"_3604":624,"_31083":542,"_21524":52650,"_5":14790,"_28264":52405,"_3060":52651},[],"An OIDC principal matches the claims of a validated JWT. It is appropriate for human users, corporate groups, IdP roles and service accounts that obtain tokens.",{"_3604":625,"_31083":542,"_21524":52653,"_5":14790,"_28264":52405,"_3060":52654},[],"The following principal represents any identity holding the `pki-operators` role in Keycloak:",{"_3604":626,"_31083":542,"_21524":52656,"_5":14790,"_28264":52405,"_3060":52657},[],"Claim paths can be nested, such as `realm_access.roles`. Within a single principal, **all** conditions must hold. This lets you require, for example, a group and an organizational audience at the same time.",{"_3604":627,"_31083":542,"_21524":52659,"_5":14790,"_28264":52405,"_3060":52660},[],"The implemented operators are:",{"_3604":628,"_31083":542,"_21524":52662,"_5":14790,"_28264":52405,"_3060":52663},[],"`equals`, for exact equality;",{"_3604":629,"_31083":542,"_21524":52665,"_5":14790,"_28264":52405,"_3060":52666},[],"`contains`, to check membership in a list or the presence of text in a scalar value.",{"_3604":630,"_31083":542,"_21524":52668,"_5":14790,"_28264":52405,"_3060":52669},[],"Design matching with stable attributes. For people, it is usually better to bind permissions to centrally managed groups or roles than to the email or username. For a service account, a stable `sub` keeps its permissions from mixing with a human operator's.",{"_3604":631,"_31083":542,"_21524":52671,"_5":14790,"_28264":52405,"_3060":52672},[],"Although the model recognizes the operator name `matches`, the current implementation does not evaluate regular expressions and the condition never matches. Use `equals` or `contains`.",{"_3604":632,"_31083":542,"_21524":52674,"_5":14790,"_28264":52409,"_3060":52675},[],"An X.509 principal lets you recognize a workload or a device by its client certificate. Lamassu checks the certificate signature against the configured CA and, depending on the mode, also its serial number or Common Name.",{"_3604":633,"_31083":542,"_21524":52677,"_5":14790,"_28264":52409,"_3060":52678},[],"The available modes are:",{"_3604":634,"_31083":542,"_21524":52680,"_5":14790,"_28264":52409,"_3060":52681},[],"`serial_and_ca`: an exact certificate, identified by serial number and CA;",{"_3604":635,"_31083":542,"_21524":52683,"_5":14790,"_28264":52409,"_3060":52684},[],"`cn_and_ca`: an exact or wildcard Common Name and a specific CA;",{"_3604":636,"_31083":542,"_21524":52686,"_5":14790,"_28264":52409,"_3060":52687},[],"`any_from_ca`: any certificate issued directly by the given CA.",{"_3604":637,"_31083":542,"_21524":52689,"_5":14790,"_28264":52409,"_3060":52690},[],"This example recognizes certificates whose CN starts with `factory-a-` and that are signed by the configured CA:",{"_3604":638,"_31083":542,"_21524":52692,"_5":14790,"_28264":52409,"_3060":52693},[],"`ca_trust.identity_type` accepts `fingerprint` or `authority_key_id`. In both cases you must provide the CA certificate in `ca_trust.pem`; Lamassu verifies both the signature and the expected identity of the CA.",{"_3604":639,"_31083":542,"_21524":52695,"_5":14790,"_28264":52409,"_3060":52696},[],"Use `any_from_ca` only when every identity issued by that CA should share the same permissions. If a CA issues certificates for different populations, separate access by serial or CN, or use different issuing CAs.",{"_3604":640,"_31083":542,"_21524":52698,"_5":14790,"_28264":52413,"_3060":52699},[],"A single credential can match more than one principal. It is common for a user to match a principal of their team and another of their operational function.",{"_3604":641,"_31083":542,"_21524":52701,"_5":14790,"_28264":52413,"_3060":52702},[],"For entity permissions, Lamassu combines permissions with OR logic: it is enough that one policy of one of the principals allows the action. Listings contain the union of the resources visible to all of them.",{"_3604":642,"_31083":542,"_21524":52704,"_5":14790,"_28264":52413,"_3060":52705},[],"HTTP routes with constraints are stricter. The same principal contributing the policy must also satisfy the attributes required by the route. Lamassu does not combine one principal's policy with an attribute belonging to another.",{"_3604":643,"_31083":542,"_21524":52707,"_5":14790,"_28264":52413,"_3060":52708},[],"For this reason, adding a matching principal can only broaden access. Before creating overlapping rules, review the full set of policies a real identity will receive.",{"_3604":644,"_31083":542,"_21524":52710,"_5":14790,"_28264":52421,"_3060":52711},[],"A rule identifies the domain (`namespace`), the data schema (`schema_name`) and the entity type (`entity_type`). `actions` lists the allowed operations.",{"_3604":645,"_31083":542,"_21524":52713,"_5":14790,"_28264":52421,"_3060":52714},[],"`direct_grants` limits the rule to concrete identifiers. The value `*` covers all instances of the type. A superadministrator policy uses wildcards in schema, entity, actions and grants; a least-privilege policy should avoid them whenever possible.",{"_3604":646,"_31083":542,"_21524":52716,"_5":14790,"_28264":52425,"_3060":52717},[],"Rules can follow relations declared between entities. For example, the schema knows the relation of a certificate to its issuing CA, of a device to its DMS and of a certificate to the KMS key that stores its private key, so a grant on the key also covers the certificates that use it. A policy can grant access to a parent resource and propagate selected actions to its related resources.",{"_3604":647,"_31083":542,"_21524":52719,"_5":14790,"_28264":52425,"_3060":52720},[],"This lets you express models like \"can operate the devices of this DMS\" without maintaining an individual list of every device. When a resource is added under that relation, it inherits the scope planned by the policy.",{"_3604":648,"_31083":542,"_21524":52722,"_5":14790,"_28264":52425,"_3060":52723},[],"The data model shows how the resources used in entity rules are connected.",{"_3604":649,"_31083":542,"_21524":52725,"_5":14790,"_28264":52425,"_3060":52726},[],"A rule can only follow relations that the data schema declares between its two entities. You can reference the relation by its name or by its foreign-key column — both spellings are equivalent, and it is the schema that decides which column the query uses. When you save a policy, `authz` checks every relation against the loaded schemas: one that no schema declares, or one pointing at an entity that is not loaded, is rejected at that moment.",{"_3604":650,"_31083":542,"_21524":52728,"_5":14790,"_28264":52425,"_3060":52729},[],"Policies stored before this validation may still carry relations the schemas do not declare. Such a relation grants nothing: `authz` logs a warning, `skipping relation that grants nothing`, naming the policy and the relation, and continues evaluating the rest of the policy. The reference is always resolved against the schema before any query is built, so an undeclared relation can never alter it. If inherited access narrows after an upgrade, check the `authz` logs for this warning and correct the relation of the affected policy.",{"_3604":651,"_31083":542,"_21524":52731,"_5":14790,"_28264":52429,"_3060":52732},[],"`column_filters` applies conditions to columns the schema has declared filterable. All filters of the same rule are combined with AND.",{"_3604":652,"_31083":542,"_21524":52734,"_5":14790,"_28264":52429,"_3060":52735},[],"For example, this rule allows reading active certificates issued by a specific CA:",{"_3604":653,"_31083":542,"_21524":52737,"_5":14790,"_28264":52429,"_3060":52738},[],"The available operators are `eq`, `neq`, `gt`, `gte`, `lt`, `lte`, `in` and `like`. Use comparisons consistent with the column type: `like` for text, ordering comparisons for numbers or dates and `in` when there is a collection of accepted values.",{"_3604":654,"_31083":542,"_21524":52740,"_5":14790,"_28264":52433,"_3060":52741},[],"HTTP rules do not point directly at tables. They reference a route schema and grant its logical actions. Job Manager's policies are an example: they distinguish reading, creating, updating and deleting workflows or jobs.",{"_3604":655,"_31083":542,"_21524":52743,"_5":14790,"_28264":52433,"_3060":52744},[],"Some routes also compare a request value — taken from the path, query, header or JSON body — with a normalized attribute of the principal. This way you can verify that a device only queries jobs addressed to its own `client_id`.",{"_3604":656,"_31083":542,"_21524":52746,"_5":14790,"_28264":52433,"_3060":52747},[],"Normalized attributes decouple the policy from the authentication mechanism. `subject_attribute_mappings` can derive, for example, `device_id` from `oidc.claim.device_id` or from `x509.subject.cn`. The rule consumes `device_id` in both cases.",{"_3604":657,"_31083":542,"_21524":52749,"_5":14790,"_28264":52433,"_3060":52750},[],"An HTTP rule can also pin a granted action to a literal value carried by the request itself through `param_constraints`. It extracts the value with the same sources as route constraints — `path_regex_group`, `query`, `header` or `json_body` — but compares it against an `equals` literal written into the policy rather than against a subject attribute. The grant then depends only on the request, not on who holds the policy:",{"_3604":658,"_31083":542,"_21524":52752,"_5":14790,"_28264":52433,"_3060":52753},[],"Combined with a schema route such as `^/api/mysvc/system/([^/]+)/info$`, this grants `GET /api/mysvc/system/1/info` and denies the same call for system `2`, regardless of the principal's attributes. The same mechanism pins query parameters, headers or JSON body fields, for example `{ \"source\": \"query\", \"name\": \"tenant_id\" }` with `\"equals\": \"1\"` to accept only requests carrying `?tenant_id=1`.",{"_3604":659,"_31083":542,"_21524":52755,"_5":14790,"_28264":52433,"_3060":52756},[],"Note that:",{"_3604":660,"_31083":542,"_21524":52758,"_5":14790,"_28264":52433,"_3060":52759},[],"`action` must be one of the actions granted by the rule; `equals` is required; `path_regex_group` needs an `index` greater than zero, `query` and `header` need a `name`, and `json_body` needs a `path` such as `$.tenant_id`.",{"_3604":661,"_31083":542,"_21524":52761,"_5":14790,"_28264":52433,"_3060":52762},[],"`param_constraints` are not cross-checked against the schema when the policy is loaded. A reference the route cannot satisfy — for instance a `path_regex_group` on a route without capture groups — simply never matches, and the request is denied.",{"_3604":662,"_31083":542,"_21524":52764,"_5":14790,"_28264":52433,"_3060":52765},[],"Several `param_constraints` for the same action combine with AND. A rule without them keeps the usual behavior: the action is granted wherever the route matches and the subject constraints pass.",{"_3604":663,"_31083":542,"_21524":52767,"_5":14790,"_28264":52437,"_3060":52768},[],"The `authz` preload installs reusable policies for the main domains. Among them are:",{"_3604":664,"_31083":542,"_21524":52770,"_5":14790,"_28264":52437,"_3060":52771},[],"full and read-only access to certificates and authorities;",{"_3604":665,"_31083":542,"_21524":52773,"_5":14790,"_28264":52437,"_3060":52774},[],"full and read-only access to the KMS;",{"_3604":666,"_31083":542,"_21524":52776,"_5":14790,"_28264":52437,"_3060":52777},[],"full and read-only access to Device Manager, DMS Manager, Validation Authority and alerts;",{"_3604":667,"_31083":542,"_21524":52779,"_5":14790,"_28264":52437,"_3060":52780},[],"an `Auditor` policy with PKI read access and authorization visibility;",{"_3604":668,"_31083":542,"_21524":52782,"_5":14790,"_28264":52437,"_3060":52783},[],"console access;",{"_3604":669,"_31083":542,"_21524":52785,"_5":14790,"_28264":52437,"_3060":52786},[],"administration and observation policies for the Job Manager NBI and SBI APIs;",{"_3604":670,"_31083":542,"_21524":52788,"_5":14790,"_28264":52437,"_3060":52789},[],"access to the dashboard's experimental terminal (Terminal Network);",{"_3604":671,"_31083":542,"_21524":52791,"_5":14790,"_28264":52437,"_3060":52792},[],"`SUPER ADMIN`, which grants all actions over the `authz` and `pki` domains.",{"_3604":672,"_31083":542,"_21524":52794,"_5":14790,"_28264":52437,"_3060":52795},[],"Start with these policies before creating others. If none reflects the boundary you need, create a specific, small policy instead of copying `SUPER ADMIN` and informally removing permissions.",{"_3604":673,"_31083":542,"_21524":52797,"_5":14790,"_28264":52437,"_3060":52798},[],"The Terminal Network policy is created by the `authz` preload the next time `authz` starts after the upgrade. Preloaded policies are system policies — their ids begin with `lamassu.` — and cannot be edited through the API.",{"_3604":674,"_31083":542,"_21524":52800,"_5":14790,"_28264":52441,"_3060":52801},[],"An installation without a principal matching your identity is left with nobody able to administer authorization. Configure the IdP and the bootstrap before exposing the platform.",{"_3604":675,"_31083":542,"_21524":52803,"_5":14790,"_28264":52441,"_3060":52804},[],"The chart includes a bootstrap principal that looks for the OIDC role `pki-admin` in `realm_access.roles`. It grants it `SUPER ADMIN` and, when Job Manager is enabled, the administrative policy of its NBI API.",{"_3604":676,"_31083":542,"_21524":52806,"_5":14790,"_28264":52441,"_3060":52807},[],"The pre-install and pre-upgrade Helm Job runs the `authz` migrations, preloads the policies and creates the bootstrap principals before the services start. If the principal already exists, it does not replace it: it only adds the configured grants that are still missing. You can keep the entry in `values.yaml` across upgrades.",{"_3604":677,"_31083":542,"_21524":52809,"_5":14790,"_28264":52444,"_3060":52810},[],"Create the role or group you will use to administer Lamassu. Assign it to at least two controlled human identities. If your provider does not use `realm_access.roles`, adapt the claim path in both the frontend and `auth_config.claims`.",{"_3604":678,"_31083":542,"_21524":52812,"_5":14790,"_28264":52448,"_3060":52813},[],"`authz` validates every token against `services.authz.jwkUrl`, which is fetched from the `authz` pod. The Gateway does not validate tokens itself: Lamassu services authorize each request through `authz`, and routes labeled `auth=external`, such as the Job Manager ones, are checked by the Gateway through `authz` when `auth.externalAuthorization` is enabled. The endpoint must serve the keys of the issuer configured in `auth.oidc.frontend.authority`.",{"_3604":679,"_31083":542,"_21524":52815,"_5":14790,"_28264":52448,"_3060":52816},[],"Releases upgraded from 3.8.0 must remove `auth.oidc.apiGateway` and `auth.authorization`, which the 4.0.0 chart rejects. See 3.8.0 to 4.0.0.",{"_3604":680,"_31083":542,"_21524":52818,"_5":14790,"_28264":52452,"_3060":52819},[],"Sign in with an identity holding `pki-admin`. Confirm it can access authorization administration and perform a non-destructive read operation.",{"_3604":681,"_31083":542,"_21524":52821,"_5":14790,"_28264":52456,"_3060":52822},[],"Use a second user without the role and confirm the same operation is denied. This test catches misread claims, overly broad policies and accidental `failOpen` configurations.",{"_3604":682,"_31083":542,"_21524":52824,"_5":14790,"_28264":52460,"_3060":52825},[],"Create operational principals with narrower policies. Reserve `pki-admin` for authorization administration and recovery, not for daily work.",{"_3604":683,"_31083":542,"_21524":52827,"_5":14790,"_28264":52464,"_3060":52828},[],"Fastlane installs a Keycloak realm for the lab and creates the user `lamassu` with the temporary password `lamassu`, the role `pki-admin` and a mandatory password change. Its bootstrap principal matches through `preferred_username=lamassu`.",{"_3604":684,"_31083":542,"_21524":52830,"_5":14790,"_28264":52464,"_3060":52831},[],"Change the password on first login. Do not reuse the Fastlane user, password or IdP as a production design.",{"_3604":685,"_31083":542,"_21524":52833,"_5":14790,"_28264":52468,"_3060":52834},[],"Avoid reproducing your company's internal structure with dozens of nearly identical policies. Start from the responsibilities that actually need access:",{"_3604":686,"_31083":542,"_21524":52836,"_5":14790,"_28264":52468,"_3060":52837},[],"**Authorization administration**: manages principals, policies and grants. It should belong to a small, separate group.",{"_3604":687,"_31083":542,"_21524":52839,"_5":14790,"_28264":52468,"_3060":52840},[],"**PKI operation**: administers CAs, profiles and certificates, but not necessarily who gets access.",{"_3604":688,"_31083":542,"_21524":52842,"_5":14790,"_28264":52468,"_3060":52843},[],"**Device registration**: operates devices and DMSs without receiving permissions over keys or authorization configuration.",{"_3604":689,"_31083":542,"_21524":52845,"_5":14790,"_28264":52468,"_3060":52846},[],"**Audit**: reviews configuration and activity without creating, modifying, signing, revoking or deleting.",{"_3604":690,"_31083":542,"_21524":52848,"_5":14790,"_28264":52468,"_3060":52849},[],"**Automation**: uses a technical account or a separate certificate, with permissions limited to the flow and resources it controls.",{"_3604":691,"_31083":542,"_21524":52851,"_5":14790,"_28264":52468,"_3060":52852},[],"For each role, separate \"view\" from \"change\", limit resources through grants, relations or attributes and avoid `*` unless the role must automatically cover future actions.",{"_3604":692,"_31083":542,"_21524":52854,"_5":14790,"_28264":52468,"_3060":52855},[],"A rule with `actions: [\"*\"]` expands to every action defined by the schema. When a new version adds an action, a wildcard policy may start granting it. Review these policies on every upgrade.",{"_3604":693,"_31083":542,"_21524":52857,"_5":14790,"_28264":52472,"_3060":52858},[],"To revoke access immediately, disable the principal or revoke its grants. Disabling a principal keeps its configuration and associations for investigation or restoration, but it stops taking part in matching.",{"_3604":694,"_31083":542,"_21524":52860,"_5":14790,"_28264":52472,"_3060":52861},[],"Deleting a role or group in the IdP prevents new tokens from containing the claim, but an already-issued token may remain valid until it expires. If removal is urgent, combine the IdP change with disabling the principal in Lamassu and revoking sessions or tokens at the provider.",{"_3604":695,"_31083":542,"_21524":52863,"_5":14790,"_28264":52472,"_3060":52864},[],"When you edit a shared policy, remember the change affects all its principals. To test a new scope, create a separate policy, grant it to a test identity and validate allowed and denied operations before replacing the old one.",{"_3604":696,"_31083":542,"_21524":52866,"_5":14790,"_28264":52476,"_3060":52867},[],"Keep `failOpen: false` unless a documented risk assessment justifies otherwise.",{"_3604":697,"_31083":542,"_21524":52869,"_5":14790,"_28264":52476,"_3060":52870},[],"Use groups or stable roles for people and independent identities for automations.",{"_3604":698,"_31083":542,"_21524":52872,"_5":14790,"_28264":52476,"_3060":52873},[],"Keep at least two recovery administrators and test their access periodically.",{"_3604":699,"_31083":542,"_21524":52875,"_5":14790,"_28264":52476,"_3060":52876},[],"Review active principals, their matches and their grants after IdP changes.",{"_3604":700,"_31083":542,"_21524":52878,"_5":14790,"_28264":52476,"_3060":52879},[],"Search for wildcards in policies before upgrading Lamassu.",{"_3604":701,"_31083":542,"_21524":52881,"_5":14790,"_28264":52476,"_3060":52882},[],"Review `skip_authz` routes and `default_action` settings in HTTP schemas when integrating or upgrading a service.",{"_3604":702,"_31083":542,"_21524":52884,"_5":14790,"_28264":52476,"_3060":52885},[],"Always test one allowed and one denied operation for each role.",{"_3604":703,"_31083":542,"_21524":52887,"_5":14790,"_28264":52476,"_3060":52888},[],"Correlate changes to principals, policies and grants with the audit logs.",{"_3604":704,"_31083":542,"_21524":52890,"_5":14790,"_28264":52484,"_3060":52891},[],"Authentication failed before permissions were evaluated. Check the JWT signature and expiration, issuer, audience and the availability of the JWKS configured in the Gateway. For X.509, check that the client certificate reaches the point that extracts the credential.",{"_3604":705,"_31083":542,"_21524":52893,"_5":14790,"_28264":52488,"_3060":52894},[],"The credential could be processed but did not produce a positive authorization. Review in this order:",{"_3604":706,"_31083":542,"_21524":52896,"_5":14790,"_28264":52488,"_3060":52897},[],"that an active principal of the correct type exists;",{"_3604":707,"_31083":542,"_21524":52899,"_5":14790,"_28264":52488,"_3060":52900},[],"that the claim paths and values match the real token exactly;",{"_3604":708,"_31083":542,"_21524":52902,"_5":14790,"_28264":52488,"_3060":52903},[],"that all of the principal's conditions hold;",{"_3604":709,"_31083":542,"_21524":52905,"_5":14790,"_28264":52488,"_3060":52906},[],"that the principal has the expected policy granted;",{"_3604":710,"_31083":542,"_21524":52908,"_5":14790,"_28264":52488,"_3060":52909},[],"that the policy includes the action and the requested resource type or route;",{"_3604":711,"_31083":542,"_21524":52911,"_5":14790,"_28264":52488,"_3060":52912},[],"that the identifier, relation, column filter or HTTP constraint includes the real resource.",{"_3604":712,"_31083":542,"_21524":52914,"_5":14790,"_28264":52488,"_3060":52915},[],"In the `authz` logs, an external endpoint decision includes `allowed`, `reason`, `matched_principals`, `evaluated_policy_ids`, `matched_policy_id` and the status code. These fields let you separate a matching failure from a permissions failure. With OpenTelemetry tracing enabled, a request that reaches the policy engine produces an `engine.CheckHTTPRequest` span whose attributes record `authz.allowed`, the matched policy and the matched principal. Correlation with the Gateway trace requires trace context to be propagated to authz.",{"_3604":713,"_31083":542,"_21524":52917,"_5":14790,"_28264":52488,"_3060":52918},[],"If a policy that relied on inherited access stopped granting it after an upgrade, look in the `authz` logs for `skipping relation that grants nothing`: the warning names the policy and the relation the schemas no longer declare. Correct that policy's relation so it matches the current schemas.",{"_3604":714,"_31083":542,"_21524":52920,"_5":14790,"_28264":52492,"_3060":52921},[],"Check that the bootstrap principal was created and that the policies were preloaded by the migration Job. Also verify that `services.authz.jwkUrl` is reachable from the `authz` pod; do not assume that a URL accessible from the browser also works inside the cluster.",{"_3604":715,"_31083":542,"_21524":52923,"_5":14790,"_28264":52496,"_3060":52924},[],"The path may be covered by a schema-level decision rather than by a policy: routes marked `skip_authz` allow any identity that matches an active principal, and a request under a `base_paths` prefix whose schema sets `default_action: allow` is likewise allowed without consulting policies. Confirm which of the two applies before looking for missing or misassigned grants.",{"_3604":716,"_31083":542,"_21524":52926,"_5":14790,"_28264":52500,"_3060":52927},[],"This is the expected behavior with `failOpen: false`. Restore the service, its PostgreSQL connection and its JWKS connectivity. Do not temporarily switch to `failOpen: true` without accepting that protected routes could become accessible without an authorization decision.",{"_3604":717,"_31083":542,"_21524":52929,"_5":14790,"_28264":52500,"_3060":52930},[],"Continue with Audit logs to investigate configuration changes or with Troubleshooting to diagnose the deployment.",{"_3604":718,"_31083":718,"_5":15155,"_3060":52932,"_31421":52933,"_21524":52934,"_28264":718},"Alerts and subscriptions",[50730,52242,52243],[],{"_3604":719,"_31083":718,"_21524":52936,"_5":14790,"_28264":718,"_3060":52937},[],"Send PKI events to people and external systems.",{"_3604":720,"_31083":718,"_5":31418,"_21524":52939,"_28264":52940,"_3060":52941},[],"/docs/platform/administration/alerts#how-it-works","How it works",{"_3604":721,"_31083":718,"_5":31418,"_21524":52943,"_28264":52944,"_3060":52945},[],"/docs/platform/administration/alerts#available-channels","Available channels",{"_3604":722,"_31083":718,"_5":31418,"_21524":52947,"_28264":52948,"_3060":52949},[],"/docs/platform/administration/alerts#create-a-subscription","Create a subscription",{"_3604":723,"_31083":718,"_5":31418,"_21524":52951,"_28264":52952,"_3060":52953},[],"/docs/platform/administration/alerts#choose-the-event","Choose the event",{"_3604":724,"_31083":718,"_5":31418,"_21524":52955,"_28264":52956,"_3060":52957},[],"/docs/platform/administration/alerts#configure-the-destination","Configure the destination",{"_3604":725,"_31083":718,"_5":31418,"_21524":52959,"_28264":52960,"_3060":52961},[],"/docs/platform/administration/alerts#limit-the-notifications","Limit the notifications",{"_3604":726,"_31083":718,"_5":31418,"_21524":52963,"_28264":52964,"_3060":52965},[],"/docs/platform/administration/alerts#review-and-activate","Review and activate",{"_3604":727,"_31083":718,"_5":31418,"_21524":52967,"_28264":52968,"_3060":52969},[],"/docs/platform/administration/alerts#configure-the-webhook-http-client","Configure the webhook HTTP client",{"_3604":728,"_31083":718,"_5":31418,"_21524":52971,"_28264":52972,"_3060":52973},[],"/docs/platform/administration/alerts#webhook-delivery-rules","Webhook delivery rules",{"_3604":729,"_31083":718,"_5":31418,"_21524":52975,"_28264":52976,"_3060":52977},[],"/docs/platform/administration/alerts#manage-a-subscription","Manage a subscription",{"_3604":730,"_31083":718,"_5":31418,"_21524":52979,"_28264":52980,"_3060":52981},[],"/docs/platform/administration/alerts#event-families","Event families",{"_3604":731,"_31083":718,"_21524":52983,"_5":14790,"_28264":718,"_3060":52984},[],"Subscriptions turn Lamassu events into actionable notifications. You can alert a team, feed an incident system or trigger an automation when a CA, certificate or device changes.",{"_3604":732,"_31083":718,"_21524":52986,"_5":14790,"_28264":52940,"_3060":52987},[],"A service publishes a domain event.",{"_3604":733,"_31083":718,"_21524":52989,"_5":14790,"_28264":52940,"_3060":52990},[],"Lamassu evaluates the subscriptions associated with that event type.",{"_3604":734,"_31083":718,"_21524":52992,"_5":14790,"_28264":52940,"_3060":52993},[],"Each subscription's filter decides whether it should be notified.",{"_3604":735,"_31083":718,"_21524":52995,"_5":14790,"_28264":52940,"_3060":52996},[],"Lamassu delivers the event to the configured channel.",{"_3604":736,"_31083":718,"_21524":52998,"_5":14790,"_28264":52940,"_3060":52999},[],"The event inventory shows when each type was last observed, how many times it has occurred and how many subscriptions it has. You can expand an event to inspect an example of its JSON payload before creating the filter.",{"_3604":737,"_31083":718,"_21524":53001,"_5":14790,"_28264":52944,"_3060":53002},[],"**Email** sends alerts to a person or an operational list. It only requires the destination address. Event content is rendered as HTML-escaped text, never as markup.",{"_3604":738,"_31083":718,"_21524":53004,"_5":14790,"_28264":52944,"_3060":53005},[],"**Microsoft Teams** posts the notification to a channel through its webhook URL.",{"_3604":739,"_31083":718,"_21524":53007,"_5":14790,"_28264":52944,"_3060":53008},[],"**Webhook** delivers the event to an automation, SIEM or incident system via `POST` or `PUT`.",{"_3604":740,"_31083":718,"_21524":53010,"_5":14790,"_28264":52944,"_3060":53011},[],"The Microsoft Teams and Webhook channels accept an optional `http_client` block that authenticates the call to the receiver. `auth_mode` selects `noauth` (the default), `apikey`, `jwt` or `mtls`; each mode requires its own options:",{"_3604":741,"_31083":718,"_21524":53013,"_5":14790,"_28264":52944,"_3060":53014},[],"`apikey_options` requires `header` and `key`.",{"_3604":742,"_31083":718,"_21524":53016,"_5":14790,"_28264":52944,"_3060":53017},[],"`jwt_options` requires `oidc_client_id`, `oidc_client_secret` and an absolute `http` or `https` `oidc_well_known`.",{"_3604":743,"_31083":718,"_21524":53019,"_5":14790,"_28264":52944,"_3060":53020},[],"`mtls_options` requires `cert_content` and `key_content` as Base64-encoded PEM, like certificates elsewhere in the API; plain PEM is also accepted. Values that reference files on the server are rejected, and the pair must decode to a matching certificate and private key.",{"_3604":744,"_31083":718,"_21524":53022,"_5":14790,"_28264":52944,"_3060":53023},[],"The alerts API reference documents the full `http_client` schema.",{"_3604":745,"_31083":718,"_21524":53025,"_5":14790,"_28264":52952,"_3060":53026},[],"Open **Alerts**, locate the event type and select **Subscribe**. Review the latest JSON example to identify the fields you will need to filter on.",{"_3604":746,"_31083":718,"_21524":53028,"_5":14790,"_28264":52956,"_3060":53029},[],"Select Email, Microsoft Teams or Webhook and enter the channel details.",{"_3604":747,"_31083":718,"_21524":53031,"_5":14790,"_28264":52960,"_3060":53032},[],"Add a filter if you don't want to receive every instance of the event.",{"_3604":748,"_31083":718,"_21524":53034,"_5":14790,"_28264":52960,"_3060":53035},[],"**None** notifies all instances of the event.",{"_3604":749,"_31083":718,"_21524":53037,"_5":14790,"_28264":52960,"_3060":53038},[],"**JSON Path** evaluates one or more specific fields.",{"_3604":750,"_31083":718,"_21524":53040,"_5":14790,"_28264":52960,"_3060":53041},[],"**JSON Schema** accepts only payloads with a particular structure.",{"_3604":751,"_31083":718,"_21524":53043,"_5":14790,"_28264":52960,"_3060":53044},[],"**JavaScript** lets you express custom logic. Each filter runs for at most 100 milliseconds; a filter that exceeds this limit fails the condition and the notification is skipped with the error `javascript filter execution timed out`.",{"_3604":752,"_31083":718,"_21524":53046,"_5":14790,"_28264":52960,"_3060":53047},[],"For example, `function (event) { return event.data.status == \"NO_IDENTITY\"; }` limits a subscription to devices without an identity.",{"_3604":753,"_31083":718,"_21524":53049,"_5":14790,"_28264":52960,"_3060":53050},[],"The console evaluates the filter against the JSON shown in the **Input Event** editor, which is prefilled with the latest event, and reports whether it matches. For JSON Path and JavaScript filters, it shows **The filter matches this Cloud Event** or **The filter does not match this Cloud Event**. JSON Path expressions are evaluated against the full Cloud Event, so the default `$.data` selects the event's `data` field, and the expression must start with `$`.",{"_3604":754,"_31083":718,"_21524":53052,"_5":14790,"_28264":52964,"_3060":53053},[],"Check the event, channel and filter in the summary. Select **Confirm Subscription** to start delivery.",{"_3604":755,"_31083":718,"_21524":53055,"_5":14790,"_28264":52968,"_3060":53056},[],"The Webhook and Microsoft Teams channels show this configuration in the subscribe form, at the channel step, and again when editing a subscription; Email does not use it. The fields map to the optional `http_client` block described above:",{"_3604":756,"_31083":718,"_21524":53058,"_5":14790,"_28264":52968,"_3060":53059},[],"**Log Level** selects `debug`, `info`, `warn` or `error`; `info` is the default.",{"_3604":757,"_31083":718,"_21524":53061,"_5":14790,"_28264":52968,"_3060":53062},[],"**Call Timeout** defaults to 10 seconds. The console rejects a value above 30 seconds with `Webhook timeout must be at most 30s.`; the API clamps the same value to the cap instead (see Calls are bounded).",{"_3604":758,"_31083":718,"_21524":53064,"_5":14790,"_28264":52968,"_3060":53065},[],"There is no TLS-verification switch for these channels, because the service always verifies the receiver certificate (see TLS is always verified).",{"_3604":759,"_31083":718,"_21524":53067,"_5":14790,"_28264":52968,"_3060":53068},[],"**HTTP Authentication** selects `No Authentication` (the default), `API Key` (API key value and Header Name, `X-API-Key` by default), `OIDC Client Credentials` (Client ID, Client Secret and Well-Known URL) or `Mutual TLS` (Client Certificate and Client Private Key pasted as PEM). A stored private key stays hidden until you select **Show**.",{"_3604":760,"_31083":718,"_21524":53070,"_5":14790,"_28264":52968,"_3060":53071},[],"A `http://` URL shows the console warning `Unencrypted HTTP connection` (see the Credentials over http\\:// callout below).",{"_3604":761,"_31083":718,"_21524":53073,"_5":14790,"_28264":52968,"_3060":53074},[],"The form validates inline against the same delivery rules: the webhook URL and the OIDC Well-Known URL must be absolute `http` or `https` URLs, an API-key header may not use a reserved name, and the mTLS certificate and key must be PEM content, not file paths.",{"_3604":762,"_31083":718,"_21524":53076,"_5":14790,"_28264":52968,"_3060":53077},[],"The summary in the Confirm step shows the authentication as `None`, `OIDC client credentials`, `API key` or `Mutual TLS`. The subscription details show the authentication, the API key header name (never the value), the OIDC issuer URL, mTLS as `Configured` and a fixed `TLS verification: Verified` row. The API key, client secret and private key are not shown in the subscription details.",{"_3604":763,"_31083":718,"_21524":53079,"_5":14790,"_28264":52972,"_3060":53080},[],"Notifications delivered through the Microsoft Teams and Webhook channels follow a fixed HTTP policy:",{"_3604":764,"_31083":718,"_21524":53082,"_5":14790,"_28264":52972,"_3060":53083},[],"**TLS is always verified.** The receiver certificate is checked against the system trust store. `insecure_skip_verify` is enforced as `false` — including when it is set to `true` — so self-signed or otherwise untrusted receivers fail delivery.",{"_3604":765,"_31083":718,"_21524":53085,"_5":14790,"_28264":52972,"_3060":53086},[],"**Redirects are not followed.** A `3xx` response fails with `unexpected status code: <n>: redirects are not followed`. Configure `webhook_url` with the final absolute `http` or `https` URL: an `http://` address that an ingress redirects to `https://` stops working.",{"_3604":766,"_31083":718,"_21524":53088,"_5":14790,"_28264":52972,"_3060":53089},[],"**Calls are bounded.** A call defaults to a 10 second timeout; a configured `call_timeout` is capped at 30 seconds. Values above the cap are clamped, not rejected.",{"_3604":767,"_31083":718,"_21524":53091,"_5":14790,"_28264":52972,"_3060":53092},[],"**The response body is ignored.** Delivery checks the status code only, so the receiver may answer with any body.",{"_3604":768,"_31083":718,"_21524":53094,"_5":14790,"_28264":52972,"_3060":53095},[],"**API-key headers are restricted.** A custom `apikey_options.header` may not use names that the platform or receiving services trust — for example `X-Principal-Id`, `X-Request-Id`, `Host`, `Content-Type` or `Forwarded` — and no name may start with `X-Forwarded-`, `X-Envoy-` or `X-Lms-`. Comparisons are case-insensitive.",{"_3604":769,"_31083":718,"_21524":53097,"_5":14790,"_28264":52972,"_3060":53098},[],"**Invalid configurations are rejected at subscribe time.** A channel configuration that would fail on every delivery returns HTTP 400 with a body that starts with `struct validation error:`, and the subscription is not created.",{"_3604":770,"_31083":718,"_21524":53100,"_5":14790,"_28264":52972,"_3060":53101},[],"Credentials are sent regardless of the URL scheme. With an `http://` `webhook_url`, the API key or bearer token travels in cleartext and mTLS has no effect. Prefer `https://` for `webhook_url`, `oidc_well_known` and the token endpoint it advertises.",{"_3604":771,"_31083":718,"_21524":53103,"_5":14790,"_28264":52976,"_3060":53104},[],"Open an existing subscription to review its destination and filter, modify the configuration or select **Unsubscribe**. Remove subscriptions that no longer have an operational owner to avoid ignored deliveries or stale endpoints.",{"_3604":772,"_31083":718,"_21524":53106,"_5":14790,"_28264":52976,"_3060":53107},[],"Subscriptions created with older console versions may store the webhook target under `url` and `method` instead of `webhook_url` and `webhook_method`. The service delivers only through `webhook_url` and `webhook_method`, so such a subscription does not deliver even though the subscription details show the stored target. Open the subscription and save it again: the edit form prefills the stored target, and saving rewrites the channel configuration in the current layout.",{"_3604":773,"_31083":718,"_21524":53109,"_5":14790,"_28264":52980,"_3060":53110},[],"**Authorities:** `ca.create`, `ca.import`, `ca.reissue` and `ca.delete`.",{"_3604":774,"_31083":718,"_21524":53112,"_5":14790,"_28264":52980,"_3060":53113},[],"**Certificates:** `ca.sign.certificate` and `certificate.delete`.",{"_3604":775,"_31083":718,"_21524":53115,"_5":14790,"_28264":52980,"_3060":53116},[],"**Profiles:** `profile.issuance.create`, `profile.issuance.update` and `profile.issuance.delete`.",{"_3604":776,"_31083":718,"_21524":53118,"_5":14790,"_28264":52980,"_3060":53119},[],"**Enrollment:** `dms.create`, `dms.update`, `dms.enroll` and `dms.reenroll`.",{"_3604":777,"_31083":718,"_21524":53121,"_5":14790,"_28264":52980,"_3060":53122},[],"**Devices:** `device.create`, `device.identity.update` and `device.status.update`.",{"_3604":778,"_31083":718,"_21524":53124,"_5":14790,"_28264":52980,"_3060":53125},[],"**Validation:** `va.role.crl.create`, `va.crl-settings.init`, `va.crl-settings.update`, `va.crl-settings.finalize`, `va.crl-settings.archive` and `va.crl-settings.delete`.",{"_3604":779,"_31083":718,"_21524":53127,"_5":14790,"_28264":52980,"_3060":53128},[],"**Keys:** `kms.create`, `kms.import`, `kms.sign` and `kms.delete`.",{"_3604":780,"_31083":718,"_21524":53130,"_5":14790,"_28264":52980,"_3060":53131},[],"Use the catalog shown in the console as the source for the types available in your deployed version.",{"_3604":781,"_31083":718,"_21524":53133,"_5":14790,"_28264":52980,"_3060":53134},[],"Since 4.0.0, `va.crl-settings.init` and `va.crl-settings.update` carry the CRL settings of a CA (`ca_id`) and replace `va.role.crl.init` and `va.role.update`. The upgrade migration renames the types of existing subscriptions automatically, but it does not rewrite their conditions: review filters that read the old payload or the old `crl/<ski>` subject, including filters for `va.role.crl.create` (see 3.8.0 to 4.0.0).",{"_3604":782,"_31083":718,"_21524":53136,"_5":14790,"_28264":52980,"_3060":53137},[],"The VA also publishes `va.crl-settings.finalize` when a CA is revoked permanently or expires, `va.crl-settings.archive` when the CA is deleted, and `va.crl-settings.delete` when archived settings are removed.",{"_3604":783,"_31083":783,"_5":15155,"_3060":53139,"_31421":53140,"_21524":53141,"_28264":783},"Audit logs",[50730,52242,52243],[],{"_3604":784,"_31083":783,"_21524":53143,"_5":14790,"_28264":783,"_3060":53144},[],"Understand which audit events Lamassu generates and how to turn them into a durable trail.",{"_3604":785,"_31083":783,"_5":31418,"_21524":53146,"_28264":53147,"_3060":53148},[],"/docs/platform/administration/audit-logs#what-an-event-contains","What an event contains",{"_3604":786,"_31083":783,"_5":31418,"_21524":53150,"_28264":53151,"_3060":53152},[],"/docs/platform/administration/audit-logs#coverage","Coverage",{"_3604":787,"_31083":783,"_5":31418,"_21524":53154,"_28264":53155,"_3060":53156},[],"/docs/platform/administration/audit-logs#publication-and-persistence","Publication and persistence",{"_3604":788,"_31083":783,"_5":31418,"_21524":53158,"_28264":53159,"_3060":53160},[],"/docs/platform/administration/audit-logs#sensitive-data","Sensitive data",{"_3604":789,"_31083":783,"_5":31418,"_21524":53162,"_28264":53163,"_3060":53164},[],"/docs/platform/administration/audit-logs#a-reproducible-investigation","A reproducible investigation",{"_3604":790,"_31083":783,"_5":31418,"_21524":53166,"_28264":53167,"_3060":53168},[],"/docs/platform/administration/audit-logs#bound-the-interval","Bound the interval",{"_3604":791,"_31083":783,"_5":31418,"_21524":53170,"_28264":53171,"_3060":53172},[],"/docs/platform/administration/audit-logs#identify-the-operation","Identify the operation",{"_3604":792,"_31083":783,"_5":31418,"_21524":53174,"_28264":53175,"_3060":53176},[],"/docs/platform/administration/audit-logs#attribute-the-principal","Attribute the principal",{"_3604":793,"_31083":783,"_5":31418,"_21524":53178,"_28264":53179,"_3060":53180},[],"/docs/platform/administration/audit-logs#compare-intent-and-result","Compare intent and result",{"_3604":794,"_31083":783,"_5":31418,"_21524":53182,"_28264":53183,"_3060":53184},[],"/docs/platform/administration/audit-logs#follow-the-effect","Follow the effect",{"_3604":795,"_31083":783,"_5":31418,"_21524":53186,"_28264":53187,"_3060":53188},[],"/docs/platform/administration/audit-logs#periodic-verification","Periodic verification",{"_3604":796,"_31083":783,"_21524":53190,"_5":14790,"_28264":783,"_3060":53191},[],"Lamassu instruments the mutable operations of its services with audit events. Each event describes the operation, the principals that matched, the input, the result and whether it ended in error.",{"_3604":797,"_31083":783,"_21524":53193,"_5":14790,"_28264":53147,"_3060":53194},[],"The audit body includes:",{"_3604":798,"_31083":783,"_21524":53196,"_5":14790,"_28264":53147,"_3060":53197},[],"input: data received by the operation;",{"_3604":799,"_31083":783,"_21524":53199,"_5":14790,"_28264":53147,"_3060":53200},[],"has\\_error: whether the service returned an error;",{"_3604":800,"_31083":783,"_21524":53202,"_5":14790,"_28264":53147,"_3060":53203},[],"output: produced result or error message;",{"_3604":801,"_31083":783,"_21524":53205,"_5":14790,"_28264":53147,"_3060":53206},[],"principals: identifiers of the principals that matched the request.",{"_3604":802,"_31083":783,"_21524":53208,"_5":14790,"_28264":53147,"_3060":53209},[],"Successful operations use a type prefixed with audit.. Failures publish the operation type suffixed with .error. The CloudEvents event additionally adds source, identifier, date and type.",{"_3604":803,"_31083":783,"_21524":53211,"_5":14790,"_28264":53147,"_3060":53212},[],"The middlewares publish the record after executing the operation, whether it succeeded or returned an error. This lets you investigate attempts as well as confirmed changes.",{"_3604":804,"_31083":783,"_21524":53214,"_5":14790,"_28264":53151,"_3060":53215},[],"The backend applies auditing to mutations of:",{"_3604":805,"_31083":783,"_21524":53217,"_5":14790,"_28264":53151,"_3060":53218},[],"authorities, certificates and issuance profiles;",{"_3604":806,"_31083":783,"_21524":53220,"_5":14790,"_28264":53151,"_3060":53221},[],"keys and KMS engines;",{"_3604":807,"_31083":783,"_21524":53223,"_5":14790,"_28264":53151,"_3060":53224},[],"devices and identities;",{"_3604":808,"_31083":783,"_21524":53226,"_5":14790,"_28264":53151,"_3060":53227},[],"DMSs and enrollment operations;",{"_3604":809,"_31083":783,"_21524":53229,"_5":14790,"_28264":53151,"_3060":53230},[],"validation functions and CRL;",{"_3604":810,"_31083":783,"_21524":53232,"_5":14790,"_28264":53151,"_3060":53233},[],"principals, policies and authorization grants.",{"_3604":811,"_31083":783,"_21524":53235,"_5":14790,"_28264":53151,"_3060":53236},[],"Do not confuse these events with domain events. A domain event announces that a resource changed so another component can react; the audit event keeps input, output and principal context for investigation.",{"_3604":812,"_31083":783,"_21524":53238,"_5":14790,"_28264":53155,"_3060":53239},[],"Services publish audit records to the event bus when their PublisherEventBus is enabled. The backend code does not, by itself, implement a queryable, durable audit file.",{"_3604":813,"_31083":783,"_21524":53241,"_5":14790,"_28264":53155,"_3060":53242},[],"If you need retention, search, tamper protection or regulatory export, connect a consumer that persists the events into the system approved by your organization.",{"_3604":814,"_31083":783,"_21524":53244,"_5":14790,"_28264":53155,"_3060":53245},[],"Design the consumer to:",{"_3604":815,"_31083":783,"_21524":53247,"_5":14790,"_28264":53155,"_3060":53248},[],"subscribe to the audit.# types and also to operation types ending in .error;",{"_3604":816,"_31083":783,"_21524":53250,"_5":14790,"_28264":53155,"_3060":53251},[],"keep the complete CloudEvent unmodified;",{"_3604":817,"_31083":783,"_21524":53253,"_5":14790,"_28264":53155,"_3060":53254},[],"record the ingestion time and detect duplicates by ID;",{"_3604":818,"_31083":783,"_21524":53256,"_5":14790,"_28264":53155,"_3060":53257},[],"encrypt in transit and at rest;",{"_3604":819,"_31083":783,"_21524":53259,"_5":14790,"_28264":53155,"_3060":53260},[],"restrict reading and deletion to a role separate from the PKI operator;",{"_3604":820,"_31083":783,"_21524":53262,"_5":14790,"_28264":53155,"_3060":53263},[],"apply an explicit retention and legal hold policy;",{"_3604":821,"_31083":783,"_21524":53265,"_5":14790,"_28264":53155,"_3060":53266},[],"alert if it stops consuming or the pending queue grows.",{"_3604":822,"_31083":783,"_21524":53268,"_5":14790,"_28264":53159,"_3060":53269},[],"The input and output fields can contain subjects, metadata, public material, configuration or error messages. Evaluate their classification before sending them to an external platform.",{"_3604":823,"_31083":783,"_21524":53271,"_5":14790,"_28264":53159,"_3060":53272},[],"Do not log private keys, provider secrets or full tokens in automations around Lamassu. Restrict export and apply redaction at the destination without destroying the fields needed for attribution.",{"_3604":824,"_31083":783,"_21524":53274,"_5":14790,"_28264":53167,"_3060":53275},[],"Start from the reported time and normalize every source to UTC.",{"_3604":825,"_31083":783,"_21524":53277,"_5":14790,"_28264":53171,"_3060":53278},[],"Filter by event type, service source and resource identifier.",{"_3604":826,"_31083":783,"_21524":53280,"_5":14790,"_28264":53175,"_3060":53281},[],"Review principals and correlate them with the OIDC provider or the X.509 identity valid at that moment.",{"_3604":827,"_31083":783,"_21524":53283,"_5":14790,"_28264":53179,"_3060":53284},[],"Contrast input, has\\_error and output. A failed attempt does not mean the resource changed.",{"_3604":828,"_31083":783,"_21524":53286,"_5":14790,"_28264":53183,"_3060":53287},[],"Look for the domain events and service records that share resource and time window. In a CA revocation, include the cascading operations.",{"_3604":829,"_31083":783,"_21524":53289,"_5":14790,"_28264":53187,"_3060":53290},[],"Generate a controlled mutation in a test environment and check that:",{"_3604":830,"_31083":783,"_21524":53292,"_5":14790,"_28264":53187,"_3060":53293},[],"a successful audit event appears;",{"_3604":831,"_31083":783,"_21524":53295,"_5":14790,"_28264":53187,"_3060":53296},[],"the principal matches the identity used;",{"_3604":832,"_31083":783,"_21524":53298,"_5":14790,"_28264":53187,"_3060":53299},[],"the consumer persists it exactly once;",{"_3604":833,"_31083":783,"_21524":53301,"_5":14790,"_28264":53187,"_3060":53302},[],"it can be retrieved by resource, actor and period;",{"_3604":834,"_31083":783,"_21524":53304,"_5":14790,"_28264":53187,"_3060":53305},[],"a consumer outage raises an alert.",{"_3604":835,"_31083":783,"_21524":53307,"_5":14790,"_28264":53187,"_3060":53308},[],"For metrics, traces and technical logs of the deployment, see Troubleshooting. Audit answers \"who tried to change what\"; observability explains how the system behaved.",{"_3604":836,"_31083":836,"_5":15155,"_3060":53310,"_31421":53311,"_21524":53312,"_28264":836},"Platform architecture",[50730,52242],[],{"_3604":837,"_31083":836,"_21524":53314,"_5":14790,"_28264":836,"_3060":53315},[],"Lamassu components and how control, keys, issuance and devices relate.",{"_3604":838,"_31083":836,"_5":31418,"_21524":53317,"_28264":53318,"_3060":53319},[],"/docs/platform/concepts/architecture#control-plane","Control plane",{"_3604":839,"_31083":836,"_5":31418,"_21524":53321,"_28264":53322,"_3060":53323},[],"/docs/platform/concepts/architecture#key-custody-and-cryptographic-operations","Key custody and cryptographic operations",{"_3604":840,"_31083":836,"_5":31418,"_21524":53325,"_28264":53326,"_3060":53327},[],"/docs/platform/concepts/architecture#issuance-and-enrollment","Issuance and enrollment",{"_3604":841,"_31083":836,"_5":31418,"_21524":53329,"_28264":53330,"_3060":53331},[],"/docs/platform/concepts/architecture#status-and-validation","Status and validation",{"_3604":842,"_31083":836,"_5":31418,"_21524":53333,"_28264":53334,"_3060":53335},[],"/docs/platform/concepts/architecture#platform-dependencies","Platform dependencies",{"_3604":843,"_31083":836,"_21524":53337,"_5":14790,"_28264":836,"_3060":53338},[],"Lamassu deploys as a set of independent services. This separation keeps every component from needing direct access to private keys and lets each capability scale according to load.",{"_3604":844,"_31083":836,"_21524":53340,"_5":14790,"_28264":836,"_3060":53341},[],"Switch to the low level to see the internals of the Lamassu platform box (CA, KMS, DMS, Device Manager, VA, Alerts, AWS IoT connector, Job Manager and the console/API), and to medium to see it as a single platform alongside its external dependencies.",{"_3604":845,"_31083":836,"_21524":53343,"_5":14790,"_28264":53318,"_3060":53344},[],"The console and the APIs manage authorities, certificates, DMSs, devices, alerts and configuration. Domain events allow connectors and automations to react to changes without continuously polling the platform.",{"_3604":846,"_31083":836,"_21524":53346,"_5":14790,"_28264":53322,"_3060":53347},[],"The KMS offers a common interface over software engines, PKCS#11 and cloud providers. The selected engine keeps the key or delegates the cryptographic operation without the other services knowing its implementation.",{"_3604":847,"_31083":836,"_21524":53349,"_5":14790,"_28264":53326,"_3060":53350},[],"The CA service issues certificates and maintains the relationship with its authority. The DMS applies the enrollment rules and exposes the EST flows so a device can request or renew an identity.",{"_3604":848,"_31083":836,"_21524":53352,"_5":14790,"_28264":53330,"_3060":53353},[],"Device Manager keeps the operational view of the device and its history. The Validation Authority publishes OCSP and CRLs so other systems can decide whether to trust a presented certificate.",{"_3604":849,"_31083":836,"_21524":53355,"_5":14790,"_28264":53334,"_3060":53356},[],"In a self-managed deployment, Lamassu uses PostgreSQL for persistence, RabbitMQ for messaging and an OIDC provider for authentication. See the deployment architecture for how the services are published on Kubernetes.",{"_3604":850,"_31083":850,"_5":15155,"_3060":53358,"_31421":53359,"_21524":53360,"_28264":850},"How Lamassu works",[50730,52242],[],{"_3604":851,"_31083":850,"_21524":53362,"_5":14790,"_28264":850,"_3060":53363},[],"The mental model of trust, keys, certificates and devices.",{"_3604":852,"_31083":850,"_5":31418,"_21524":53365,"_28264":53366,"_3060":53367},[],"/docs/platform/concepts/overview#the-model-in-five-pieces","The model in five pieces",{"_3604":853,"_31083":850,"_5":31418,"_21524":53369,"_28264":53370,"_3060":53371},[],"/docs/platform/concepts/overview#from-onboarding-to-operation","From onboarding to operation",{"_3604":854,"_31083":850,"_21524":53373,"_5":14790,"_28264":850,"_3060":53374},[],"Lamassu connects three elements: a **root of trust**, an **issuance policy** and an **entity that needs to prove its identity**. The platform coordinates these elements throughout the certificate lifecycle.",{"_3604":855,"_31083":850,"_21524":53376,"_5":14790,"_28264":53366,"_3060":53377},[],"**Cryptographic engine.** Generates or safeguards keys and executes private-key operations without exposing key material to the rest of the services.",{"_3604":856,"_31083":850,"_21524":53379,"_5":14790,"_28264":53366,"_3060":53380},[],"**Certification Authority (CA).** Signs certificates and establishes the chain of trust.",{"_3604":857,"_31083":850,"_21524":53382,"_5":14790,"_28264":53366,"_3060":53383},[],"**Device Management Service (DMS).** Defines how the devices of a fleet are registered, authenticated and renewed.",{"_3604":858,"_31083":850,"_21524":53385,"_5":14790,"_28264":53366,"_3060":53386},[],"**Device.** Keeps its private key and presents the certificate to prove its identity.",{"_3604":859,"_31083":850,"_21524":53388,"_5":14790,"_28264":53366,"_3060":53389},[],"**Validation Authority (VA).** Publishes the status of certificates through OCSP and CRL.",{"_3604":860,"_31083":850,"_21524":53391,"_5":14790,"_28264":53370,"_3060":53392},[],"An administrator configures a cryptographic engine and creates or imports a CA.",{"_3604":861,"_31083":850,"_21524":53394,"_5":14790,"_28264":53370,"_3060":53395},[],"A DMS relates that CA to an enrollment policy.",{"_3604":862,"_31083":850,"_21524":53397,"_5":14790,"_28264":53370,"_3060":53398},[],"The device generates a key and requests a certificate through EST, or an operator assigns it an identity.",{"_3604":863,"_31083":850,"_21524":53400,"_5":14790,"_28264":53370,"_3060":53401},[],"Lamassu keeps the inventory, history and status of the identity.",{"_3604":864,"_31083":850,"_21524":53403,"_5":14790,"_28264":53370,"_3060":53404},[],"Consumers check the chain and query OCSP or a CRL when they need to know whether it is still valid.",{"_3604":865,"_31083":850,"_21524":53406,"_5":14790,"_28264":53370,"_3060":53407},[],"<Card title=\"Architecture\" description=\"Get to know the components and where each one's responsibility ends.\" href=\"/docs/platform/concepts/architecture\" />",{"_3604":866,"_31083":850,"_21524":53409,"_5":14790,"_28264":53370,"_3060":53410},[],"<Card title=\"Identity lifecycle\" description=\"Follow a certificate from enrollment to renewal or revocation.\" href=\"/docs/platform/pki/concepts/certificate-lifecycle\" />",{"_3604":867,"_31083":867,"_5":15155,"_3060":53412,"_31421":53413,"_21524":53415,"_28264":867},"Devices and identities",[50730,52242,53414,53412],"IoT Fleets",[],{"_3604":868,"_31083":867,"_21524":53417,"_5":14790,"_28264":867,"_3060":53418},[],"Register, inspect and retire devices while checking their current identity and history.",{"_3604":869,"_31083":867,"_5":31418,"_21524":53420,"_28264":53421,"_3060":53422},[],"/docs/platform/iot-fleets/device-management#device-states","Device states",{"_3604":870,"_31083":867,"_5":31418,"_21524":53424,"_28264":53425,"_3060":53426},[],"/docs/platform/iot-fleets/device-management#inspect-a-device","Inspect a device",{"_3604":871,"_31083":867,"_5":31418,"_21524":53428,"_28264":53429,"_3060":53430},[],"/docs/platform/iot-fleets/device-management#register-a-device-manually","Register a device manually",{"_3604":872,"_31083":867,"_5":31418,"_21524":53432,"_28264":53433,"_3060":53434},[],"/docs/platform/iot-fleets/device-management#create-the-device","Create the device",{"_3604":873,"_31083":867,"_5":31418,"_21524":53436,"_28264":53437,"_3060":53438},[],"/docs/platform/iot-fleets/device-management#define-its-membership","Define its membership",{"_3604":874,"_31083":867,"_5":31418,"_21524":53440,"_28264":53441,"_3060":53442},[],"/docs/platform/iot-fleets/device-management#classify-the-device","Classify the device",{"_3604":875,"_31083":867,"_5":31418,"_21524":53444,"_28264":53445,"_3060":53446},[],"/docs/platform/iot-fleets/device-management#verify-the-registration","Verify the registration",{"_3604":876,"_31083":867,"_5":31418,"_21524":53448,"_28264":53449,"_3060":53450},[],"/docs/platform/iot-fleets/device-management#assign-an-identity-manually","Assign an identity manually",{"_3604":877,"_31083":867,"_5":31418,"_21524":53452,"_28264":53453,"_3060":53454},[],"/docs/platform/iot-fleets/device-management#revoke-the-current-identity","Revoke the current identity",{"_3604":878,"_31083":867,"_5":31418,"_21524":53456,"_28264":53457,"_3060":53458},[],"/docs/platform/iot-fleets/device-management#decommission-a-device","Decommission a device",{"_3604":879,"_31083":867,"_5":31418,"_21524":53460,"_28264":53461,"_3060":53462},[],"/docs/platform/iot-fleets/device-management#automate-enrollment","Automate enrollment",{"_3604":880,"_31083":867,"_21524":53464,"_5":14790,"_28264":867,"_3060":53465},[],"This guide is for a fleet operator. You need device, DMS and certificate permissions for the intended actions. A fleet is organized through these resources, tags and metadata; there is no separate “fleet” object to create.",{"_3604":881,"_31083":867,"_21524":53467,"_5":14790,"_28264":867,"_3060":53468},[],"Each device has a `Device ID`, one owning DMS (`dms_owner`) and, once provisioned, an identity slot with an active version and previous versions. In these flows, keep the CSR and certificate `Common Name` equal to `Device ID`: binding uses that CN to update the device.",{"_3604":882,"_31083":867,"_21524":53470,"_5":14790,"_28264":53421,"_3060":53471},[],"Operational view",{"_3604":883,"_31083":867,"_21524":53473,"_5":14790,"_28264":53421,"_3060":53474},[],"Meaning",{"_3604":884,"_31083":867,"_21524":53476,"_5":14790,"_28264":53421,"_3060":53477},[],"**No Identity**",{"_3604":885,"_31083":867,"_21524":53479,"_5":14790,"_28264":53421,"_3060":53480},[],"A record exists without an associated identity.",{"_3604":886,"_31083":867,"_21524":53482,"_5":14790,"_28264":53421,"_3060":53483},[],"**Active**",{"_3604":887,"_31083":867,"_21524":53485,"_5":14790,"_28264":53421,"_3060":53486},[],"The slot is active; also check certificate dates, status and usages.",{"_3604":888,"_31083":867,"_21524":53488,"_5":14790,"_28264":53421,"_3060":53489},[],"**Renewal Pending**",{"_3604":889,"_31083":867,"_21524":53491,"_5":14790,"_28264":53421,"_3060":53492},[],"The identity is in the operational renewal window.",{"_3604":890,"_31083":867,"_21524":53494,"_5":14790,"_28264":53421,"_3060":53495},[],"**Expiring Soon**",{"_3604":891,"_31083":867,"_21524":53497,"_5":14790,"_28264":53421,"_3060":53498},[],"Expiration is approaching according to configured thresholds.",{"_3604":892,"_31083":867,"_21524":53500,"_5":14790,"_28264":53421,"_3060":53501},[],"**Expired**",{"_3604":893,"_31083":867,"_21524":53503,"_5":14790,"_28264":53421,"_3060":53504},[],"The identity has expired.",{"_3604":894,"_31083":867,"_21524":53506,"_5":14790,"_28264":53421,"_3060":53507},[],"**Revoked**",{"_3604":895,"_31083":867,"_21524":53509,"_5":14790,"_28264":53421,"_3060":53510},[],"The identity is marked revoked. A hold cascaded from its CA shows here and is lifted when that CA is released.",{"_3604":896,"_31083":867,"_21524":53512,"_5":14790,"_28264":53421,"_3060":53513},[],"**Decommissioned**",{"_3604":897,"_31083":867,"_21524":53515,"_5":14790,"_28264":53421,"_3060":53516},[],"The record is retired and ordinary updates do not restore operation.",{"_3604":898,"_31083":867,"_21524":53518,"_5":14790,"_28264":53421,"_3060":53519},[],"Device, slot and certificate states are distinct. Events and jobs can update the view after saving a certificate; an **Active** label does not establish consumer acceptance.",{"_3604":899,"_31083":867,"_21524":53521,"_5":14790,"_28264":53425,"_3060":53522},[],"Filter the inventory by ID, tags and status. Open details and record the owning DMS, active version and current certificate serial.",{"_3604":900,"_31083":867,"_21524":53524,"_5":14790,"_28264":53425,"_3060":53525},[],"**Certificate History** relates previous and current versions. Replacing the slot does not by itself revoke every previous version.",{"_3604":901,"_31083":867,"_21524":53527,"_5":14790,"_28264":53425,"_3060":53528},[],"**Device Event Timeline** helps reconstruct registration, provisioning, renewal and status changes. A change may be saved even if event persistence fails; also inspect the record and certificates.",{"_3604":902,"_31083":867,"_21524":53530,"_5":14790,"_28264":53425,"_3060":53531},[],"Compare these values with the identity installed on the device. Updating a Lamassu slot does not install files on the remote equipment.",{"_3604":903,"_31083":867,"_21524":53533,"_5":14790,"_28264":53429,"_3060":53534},[],"Use this flow to prepare inventory or assign an identity through the console. You need an existing DMS.",{"_3604":904,"_31083":867,"_21524":53536,"_5":14790,"_28264":53433,"_3060":53537},[],"Open registration in **Managed Devices**. Confirm the ID does not already exist in another DMS: ID lookup is not restricted to a fleet.",{"_3604":905,"_31083":867,"_21524":53539,"_5":14790,"_28264":53437,"_3060":53540},[],"Enter **Device ID** and select its owning DMS. The console’s **Registration Authority** label refers to that DMS.",{"_3604":906,"_31083":867,"_21524":53542,"_5":14790,"_28264":53441,"_3060":53543},[],"Add model, environment or location tags and an icon according to your inventory.",{"_3604":907,"_31083":867,"_21524":53545,"_5":14790,"_28264":53445,"_3060":53546},[],"Read the device again: require the intended DMS and **No Identity**. Follow Manual registration to complete assignment.",{"_3604":908,"_31083":867,"_21524":53548,"_5":14790,"_28264":53445,"_3060":53549},[],"Preregistration does not establish that `/simpleenroll` will admit the request. Review its interaction with `enable_replaceable_enrollment` in Provisioning strategies.",{"_3604":909,"_31083":867,"_21524":53551,"_5":14790,"_28264":53449,"_3060":53552},[],"From **No Identity**, use **Assign Identity**:",{"_3604":910,"_31083":867,"_21524":53554,"_5":14790,"_28264":53449,"_3060":53555},[],"Select an active, current certificate suitable for the consumer, with `CN` exactly equal to `Device ID`.",{"_3604":911,"_31083":867,"_21524":53557,"_5":14790,"_28264":53449,"_3060":53558},[],"If unavailable, **Issue New Instead** starts issuance using the intended CA. Review the profile first.",{"_3604":912,"_31083":867,"_21524":53560,"_5":14790,"_28264":53449,"_3060":53561},[],"Confirm and read the serial, active version and history again.",{"_3604":913,"_31083":867,"_21524":53563,"_5":14790,"_28264":53449,"_3060":53564},[],"Install the key/certificate pair and required intermediates on the device and test usage.",{"_3604":914,"_31083":867,"_21524":53566,"_5":14790,"_28264":53449,"_3060":53567},[],"Issuing, binding and installing are separate steps. If an operation fails, check which steps persisted before repeating it.",{"_3604":915,"_31083":867,"_21524":53569,"_5":14790,"_28264":53453,"_3060":53570},[],"Locate the active serial in history and revoke it with an appropriate reason. Verify the record, OCSP/CRL publication and rejection of a new consumer connection using the certificate guide.",{"_3604":916,"_31083":867,"_21524":53572,"_5":14790,"_28264":53453,"_3060":53573},[],"Revocation does not remove the device. It does not automatically enable another enrollment either: recovery depends on its credential, status and DMS policy. `CertificateHold` can be reactivated under PKI conditions; other reasons block subsequent certificate changes.",{"_3604":917,"_31083":867,"_21524":53575,"_5":14790,"_28264":53453,"_3060":53576},[],"A certificate suspended by a CA hold cascade shows as **Revoked** and returns to active when the holding CA is released. If its certificate expired during the hold, the monitoring job marks it as expired again after the release. If you revoke a held identity yourself, that revocation is permanent.",{"_3604":918,"_31083":867,"_21524":53578,"_5":14790,"_28264":53457,"_3060":53579},[],"Before **Decommission**, inventory active and previous identities, connections and destination permissions. Prepare retirement in the consumer.",{"_3604":919,"_31083":867,"_21524":53581,"_5":14790,"_28264":53457,"_3060":53582},[],"The backend saves **Decommissioned** and attempts to revoke the active version’s certificate with `CessationOfOperation` if the slot was not expired or revoked. It does not traverse all history. Deferred revocation can fail after retirement is saved; check the result by serial.",{"_3604":920,"_31083":867,"_21524":53584,"_5":14790,"_28264":53457,"_3060":53585},[],"Retired status protects ordinary device and slot updates. It does not guarantee that every EST request is rejected before issuance: binding can skip a retired device without returning an error. Check for remaining usable certificates or permissions and block new admission in the relevant control.",{"_3604":921,"_31083":867,"_21524":53587,"_5":14790,"_28264":53457,"_3060":53588},[],"Retain records according to audit policy. Do not reuse a retired ID to hide an equipment change.",{"_3604":922,"_31083":867,"_21524":53590,"_5":14790,"_28264":53461,"_3060":53591},[],"<Card title=\"Enroll and connect a device\" description=\"Obtain an identity from the client and test mTLS.\" href=\"/docs/platform/iot-fleets/quickstarts/enroll-device\" />",{"_3604":923,"_31083":867,"_21524":53593,"_5":14790,"_28264":53461,"_3060":53594},[],"<Card title=\"Renewal and recovery\" description=\"Install the successor and handle failures without losing known state.\" href=\"/docs/platform/iot-fleets/enrollment/renewal-and-recovery\" />",{"_3604":924,"_31083":924,"_5":15155,"_3060":53596,"_31421":53597,"_21524":53599,"_28264":924},"Bootstrap identity and authentication",[50730,52242,53414,53412,53598],"Enrollment with PKI",[],{"_3604":925,"_31083":924,"_21524":53601,"_5":14790,"_28264":924,"_3060":53602},[],"Prepare server trust and admission proofs for enroll and reenroll.",{"_3604":926,"_31083":924,"_5":31418,"_21524":53604,"_28264":53605,"_3060":53606},[],"/docs/platform/iot-fleets/enrollment/bootstrap-identity#initial-server-trust","Initial server trust",{"_3604":927,"_31083":924,"_5":31418,"_21524":53608,"_28264":53609,"_3060":53610},[],"/docs/platform/iot-fleets/enrollment/bootstrap-identity#bootstrap-credential","Bootstrap credential",{"_3604":928,"_31083":924,"_5":31418,"_21524":53612,"_28264":53613,"_3060":53614},[],"/docs/platform/iot-fleets/enrollment/bootstrap-identity#modes-per-operation","Modes per operation",{"_3604":929,"_31083":924,"_5":31418,"_21524":53616,"_28264":53617,"_3060":53618},[],"/docs/platform/iot-fleets/enrollment/bootstrap-identity#webhook-contract","Webhook contract",{"_3604":930,"_31083":924,"_5":31418,"_21524":53620,"_28264":53621,"_3060":53622},[],"/docs/platform/iot-fleets/enrollment/bootstrap-identity#revocation-and-checks","Revocation and checks",{"_3604":931,"_31083":924,"_21524":53624,"_5":14790,"_28264":924,"_3060":53625},[],"This guide connects the DMS administrator with device manufacturing and integration. Before requesting an operational identity, the client must authenticate the EST server and establish entitlement to request the intended ID.",{"_3604":932,"_31083":924,"_21524":53627,"_5":14790,"_28264":53605,"_3060":53628},[],"Install a previously verified root, chain or pin through a trusted channel: manufacturing, approved configuration or authenticated distribution. It enables TLS and server-name verification before downloading `/cacerts`.",{"_3604":933,"_31083":924,"_21524":53630,"_5":14790,"_28264":53605,"_3060":53631},[],"Your only trust proof cannot come from the same unauthenticated server. The EST server TLS certificate, bootstrap certificate and operational identity issuer may belong to different hierarchies.",{"_3604":934,"_31083":924,"_21524":53633,"_5":14790,"_28264":53609,"_3060":53634},[],"With `CLIENT_CERTIFICATE`, the device presents its initial certificate and proves key possession through TLS. The DMS validates it against admission CAs. In the inspected flow, the validator receives one leaf credential: configure and test the direct issuer for the simple case; sending more intermediates does not establish delivery to the service.",{"_3604":935,"_31083":924,"_21524":53636,"_5":14790,"_28264":53609,"_3060":53637},[],"Check dates, matching certificate/key and revocation before provisioning. A credential shared across equipment identifies that shared credential, not an individual device.",{"_3604":936,"_31083":924,"_21524":53639,"_5":14790,"_28264":53609,"_3060":53640},[],"Initial mTLS validation does not by itself compare bootstrap CN with the requested CSR CN. If a requester should only request its own `Device ID`, add a control binding credential to ID, such as the combined webhook, and test a request with another CN. Certificate re-enrollment does compare its CN to the CSR; subsequent checks use the registered active identity.",{"_3604":937,"_31083":924,"_21524":53642,"_5":14790,"_28264":53613,"_3060":53643},[],"Select the four modes independently for enrollment and re-enrollment in DMS. Renewal credentials depend on that block; do not assume the bootstrap is always used or the webhook disappears.",{"_3604":938,"_31083":924,"_21524":53645,"_5":14790,"_28264":53613,"_3060":53646},[],"An administrative OIDC token is not a native EST mode. A webhook may interpret an agreed credential header; that service then performs authorization. In NO\\_AUTH, sending a token does not add DMS authentication.",{"_3604":939,"_31083":924,"_21524":53648,"_5":14790,"_28264":53617,"_3060":53649},[],"The DMS sends operation context to the configured service. Method comes from configuration; agree the contract before selecting POST or PUT. Authorization wait defaults to 10 seconds, replaced by a configured positive timeout. The DMS verifies the receiver certificate unless `insecure_skip_verify` is enabled in the webhook config — verification is on by default — and does not follow redirects, so the configured URL must be the final one. The authorization response must be JSON of at most 1 MiB. With Lamassu-to-webhook authentication configured over `http://`, the API key or bearer token travels in cleartext, and mTLS has no effect because no TLS handshake takes place, so the client certificate is never presented; prefer `https://`. Configure those options in the webhook settings of the DMS guide.",{"_3604":940,"_31083":924,"_21524":53651,"_5":14790,"_28264":53617,"_3060":53652},[],"Example body:",{"_3604":941,"_31083":924,"_21524":53654,"_5":14790,"_28264":53617,"_3060":53655},[],"`csr` is **base64 of PEM**, unlike the EST body, which is base64 of DER. `http_request` contains URL and first header entries from available HTTP context. This body does not include an `operation` field; distinguish enroll and reenroll through the path and configured policy.",{"_3604":942,"_31083":924,"_21524":53657,"_5":14790,"_28264":53617,"_3060":53658},[],"The webhook should verify credential, its relationship to `device_cn`, DMS, operation and admission policy. Forwarded headers are not themselves trusted evidence. **Lamassu-to-webhook authentication** is a separate relationship configured in the server’s HTTP client.",{"_3604":943,"_31083":924,"_21524":53660,"_5":14790,"_28264":53617,"_3060":53661},[],"Continuation requires a successful HTTP response and JSON:",{"_3604":944,"_31083":924,"_21524":53663,"_5":14790,"_28264":53617,"_3060":53664},[],"A bodyless `204` does not satisfy the contract. Denial, transport error, uninterpretable response or timeout abort authorization. Combined mode validates the certificate first, then queries the webhook. See the webhook specification.",{"_3604":945,"_31083":924,"_21524":53666,"_5":14790,"_28264":53621,"_3060":53667},[],"The DMS first looks up the certificate in Lamassu; for external certificates it attempts OCSP and CRL. If revocation cannot be checked, validators can continue treating it as not revoked. The code also does not establish rejection of every external status other than Good. Test required behavior with your actual credential and endpoint; do not present this as guaranteed strict enforcement across every source.",{"_3604":946,"_31083":924,"_21524":53669,"_5":14790,"_28264":53621,"_3060":53670},[],"Test an allowed certificate, an incorrect one, another CN, webhook denial, timeout and re-enrollment under its own policy. Keep results and schedule bootstrap credential retirement where appropriate. Continue with EST client.",{"_3604":947,"_31083":947,"_5":15155,"_3060":53672,"_31421":53673,"_21524":53674,"_28264":947},"Configure and operate the DMS",[50730,52242,53414,53412,53598],[],{"_3604":948,"_31083":947,"_21524":53676,"_5":14790,"_28264":947,"_3060":53677},[],"Define registration, authentication per operation, issuance, renewal and distributed trust.",{"_3604":949,"_31083":947,"_5":31418,"_21524":53679,"_28264":53680,"_3060":50740},[],"/docs/platform/iot-fleets/enrollment/dms#before-you-begin",{"_3604":950,"_31083":947,"_5":31418,"_21524":53682,"_28264":53683,"_3060":53684},[],"/docs/platform/iot-fleets/enrollment/dms#configure-a-dms","Configure a DMS",{"_3604":951,"_31083":947,"_5":31418,"_21524":53686,"_28264":53687,"_3060":53688},[],"/docs/platform/iot-fleets/enrollment/dms#identify-the-fleet","Identify the fleet",{"_3604":952,"_31083":947,"_5":31418,"_21524":53690,"_28264":53691,"_3060":53692},[],"/docs/platform/iot-fleets/enrollment/dms#select-the-enrollment-ca","Select the enrollment CA",{"_3604":953,"_31083":947,"_5":31418,"_21524":53694,"_28264":53695,"_3060":53696},[],"/docs/platform/iot-fleets/enrollment/dms#configure-est","Configure EST",{"_3604":954,"_31083":947,"_5":31418,"_21524":53698,"_28264":53699,"_3060":53700},[],"/docs/platform/iot-fleets/enrollment/dms#distribute-trust","Distribute trust",{"_3604":955,"_31083":947,"_5":31418,"_21524":53702,"_28264":53703,"_3060":53704},[],"/docs/platform/iot-fleets/enrollment/dms#verify-the-endpoints","Verify the endpoints",{"_3604":956,"_31083":947,"_5":31418,"_21524":53706,"_28264":53707,"_3060":53708},[],"/docs/platform/iot-fleets/enrollment/dms#enrollment-configuration","Enrollment configuration",{"_3604":957,"_31083":947,"_5":31418,"_21524":53710,"_28264":53711,"_3060":53712},[],"/docs/platform/iot-fleets/enrollment/dms#enrollment-device-registration","Enrollment Device Registration",{"_3604":958,"_31083":947,"_5":31418,"_21524":53714,"_28264":53715,"_3060":53716},[],"/docs/platform/iot-fleets/enrollment/dms#enrollment-settings","Enrollment Settings",{"_3604":959,"_31083":947,"_5":31418,"_21524":53718,"_28264":53719,"_3060":53720},[],"/docs/platform/iot-fleets/enrollment/dms#authentication-per-operation","Authentication per operation",{"_3604":960,"_31083":947,"_5":31418,"_21524":53722,"_28264":53723,"_3060":53724},[],"/docs/platform/iot-fleets/enrollment/dms#external-webhook-settings","External webhook settings",{"_3604":961,"_31083":947,"_5":31418,"_21524":53726,"_28264":53727,"_3060":53728},[],"/docs/platform/iot-fleets/enrollment/dms#issuance-profile","Issuance profile",{"_3604":962,"_31083":947,"_5":31418,"_21524":53730,"_28264":53731,"_3060":53732},[],"/docs/platform/iot-fleets/enrollment/dms#re-enrollment-configuration","Re-enrollment configuration",{"_3604":963,"_31083":947,"_5":31418,"_21524":53734,"_28264":53735,"_3060":53736},[],"/docs/platform/iot-fleets/enrollment/dms#serverkeygen","ServerKeyGen",{"_3604":964,"_31083":947,"_5":31418,"_21524":53738,"_28264":53739,"_3060":53740},[],"/docs/platform/iot-fleets/enrollment/dms#trust-distribution","Trust distribution",{"_3604":965,"_31083":947,"_5":31418,"_21524":53742,"_28264":53743,"_3060":53744},[],"/docs/platform/iot-fleets/enrollment/dms#operate-the-dms-inventory","Operate the DMS inventory",{"_3604":966,"_31083":947,"_5":31418,"_21524":53746,"_28264":53747,"_3060":53748},[],"/docs/platform/iot-fleets/enrollment/dms#integrate-the-devices","Integrate the devices",{"_3604":967,"_31083":947,"_21524":53750,"_5":14790,"_28264":947,"_3060":53751},[],"A &#x2A;*Device Management Service (DMS)** configures admission and identity lifecycle for its devices. It acts as a registration authority; the CA selected in `Enrollment CA` signs certificates. This guide is for the policy administrator.",{"_3604":968,"_31083":947,"_21524":53753,"_5":14790,"_28264":53680,"_3060":53754},[],"You need DMS management permissions, an active CA with a usable key and a tested issuance profile. Agree device ID, initial credential, consumer and renewal window with the integrator. Review Provisioning strategies before choosing registration and replacement.",{"_3604":969,"_31083":947,"_21524":53756,"_5":14790,"_28264":53680,"_3060":53757},[],"Prepare EST server trust and device connectivity through Deployment. Your operator’s administrative authentication does not replace device EST authentication.",{"_3604":970,"_31083":947,"_21524":53759,"_5":14790,"_28264":53687,"_3060":53760},[],"Create the DMS with a recognizable name and retain its ID. EST URLs use this identifier, not the display name. Each device retains one owning DMS.",{"_3604":971,"_31083":947,"_21524":53762,"_5":14790,"_28264":53691,"_3060":53763},[],"Choose **Enrollment CA** and an explicit profile appropriate for the end-entity identity. Keep CN compatible with `Device ID`. The test certificate should allow its intended purpose and expire within issuer validity.",{"_3604":972,"_31083":947,"_21524":53765,"_5":14790,"_28264":53695,"_3060":53766},[],"Select initial enrollment registration and authentication. Separately configure re-enrollment authentication, thresholds and previous certificate retirement. Leave ServerKeyGen disabled if the client generates its key.",{"_3604":973,"_31083":947,"_21524":53768,"_5":14790,"_28264":53699,"_3060":53769},[],"Select certificates returned by `/cacerts`. Explicitly include required intermediates and roots, keeping distribution distinct from automatic trust installation.",{"_3604":974,"_31083":947,"_21524":53771,"_5":14790,"_28264":53703,"_3060":53772},[],"Save and read configuration again. Query `/cacerts`, perform an allowed and a rejected enrollment, and inspect device, serial and history. Creating the DMS or downloading cacerts does not establish working authentication and issuance.",{"_3604":975,"_31083":947,"_21524":53774,"_5":14790,"_28264":53711,"_3060":53775},[],"`settings.enrollment_settings.registration_mode` accepts `JITP` or `PRE_REGISTRATION`. JITP creates an unknown device with the CSR CN as ID and the DMS as owner. `device_provisioning_profile` supplies tags, metadata and icon for that registration.",{"_3604":976,"_31083":947,"_21524":53777,"_5":14790,"_28264":53711,"_3060":53778},[],"PRE\\_REGISTRATION requires an existing ID. In the inspected code, an existing device encounters replacement checks first, even without an identity. Review preregistration conditions before using this mode.",{"_3604":977,"_31083":947,"_21524":53780,"_5":14790,"_28264":53715,"_3060":53781},[],"`settings.enrollment_settings` field",{"_3604":978,"_31083":947,"_21524":53783,"_5":14790,"_28264":53715,"_3060":53784},[],"Decision",{"_3604":979,"_31083":947,"_21524":53786,"_5":14790,"_28264":53715,"_3060":53787},[],"`protocol`",{"_3604":980,"_31083":947,"_21524":53789,"_5":14790,"_28264":53715,"_3060":53790},[],"`EST_RFC7030` for these operations.",{"_3604":981,"_31083":947,"_21524":53792,"_5":14790,"_28264":53715,"_3060":53793},[],"`enrollment_ca`",{"_3604":982,"_31083":947,"_21524":53795,"_5":14790,"_28264":53715,"_3060":53796},[],"ID of the signing CA.",{"_3604":983,"_31083":947,"_21524":53798,"_5":14790,"_28264":53715,"_3060":53799},[],"`verify_csr_signature`",{"_3604":984,"_31083":947,"_21524":53801,"_5":14790,"_28264":53715,"_3060":53802},[],"Keep `true` to verify CSR key possession.",{"_3604":985,"_31083":947,"_21524":53804,"_5":14790,"_28264":53715,"_3060":53805},[],"`enable_replaceable_enrollment`",{"_3604":986,"_31083":947,"_21524":53807,"_5":14790,"_28264":53715,"_3060":53808},[],"Allows `/simpleenroll` for an existing ID in the same DMS. It can attempt previous certificate revocation even if a later phase fails; this is not atomic.",{"_3604":987,"_31083":947,"_21524":53810,"_5":14790,"_28264":53715,"_3060":53811},[],"`est_rfc7030_settings.auth_mode`",{"_3604":988,"_31083":947,"_21524":53813,"_5":14790,"_28264":53715,"_3060":53814},[],"One of the four authentication modes.",{"_3604":989,"_31083":947,"_21524":53816,"_5":14790,"_28264":53715,"_3060":53817},[],"Initial enrollment rejects an ID owned by another DMS. Do not automatically enable replacement in response to an error; Troubleshooting distinguishes repeated IDs, ownership and partial changes.",{"_3604":990,"_31083":947,"_21524":53819,"_5":14790,"_28264":53719,"_3060":53820},[],"The blocks are independent:",{"_3604":991,"_31083":947,"_21524":53822,"_5":14790,"_28264":53719,"_3060":53823},[],"`settings.enrollment_settings.est_rfc7030_settings` for `/simpleenroll` and `/serverkeygen`.",{"_3604":992,"_31083":947,"_21524":53825,"_5":14790,"_28264":53719,"_3060":53826},[],"`settings.reenrollment_settings.est_rfc7030_settings` for `/simplereenroll`.",{"_3604":993,"_31083":947,"_21524":53828,"_5":14790,"_28264":53719,"_3060":53829},[],"`auth_mode`",{"_3604":994,"_31083":947,"_21524":53831,"_5":14790,"_28264":53719,"_3060":53832},[],"Control applied in the configured operation",{"_3604":995,"_31083":947,"_21524":53834,"_5":14790,"_28264":53719,"_3060":53835},[],"`CLIENT_CERTIFICATE`",{"_3604":996,"_31083":947,"_21524":53837,"_5":14790,"_28264":53719,"_3060":53838},[],"Presented certificate validation.",{"_3604":997,"_31083":947,"_21524":53840,"_5":14790,"_28264":53719,"_3060":53841},[],"`EXTERNAL_WEBHOOK`",{"_3604":998,"_31083":947,"_21524":53843,"_5":14790,"_28264":53719,"_3060":53844},[],"Configured webhook authorization.",{"_3604":999,"_31083":947,"_21524":53846,"_5":14790,"_28264":53719,"_3060":53847},[],"`CLIENT_CERTIFICATE_AND_EXTERNAL_WEBHOOK`",{"_3604":1000,"_31083":947,"_21524":53849,"_5":14790,"_28264":53719,"_3060":53850},[],"Certificate validation followed by webhook approval.",{"_3604":1001,"_31083":947,"_21524":53852,"_5":14790,"_28264":53719,"_3060":53853},[],"`NO_AUTH`",{"_3604":1002,"_31083":947,"_21524":53855,"_5":14790,"_28264":53719,"_3060":53856},[],"No DMS requester authentication.",{"_3604":1003,"_31083":947,"_21524":53858,"_5":14790,"_28264":53719,"_3060":53859},[],"Webhook and combined modes also execute during re-enrollment when configured in its block. They do not implicitly degrade to NO\\_AUTH. An absent or unrecognized mode fails.",{"_3604":1004,"_31083":947,"_21524":53861,"_5":14790,"_28264":53719,"_3060":53862},[],"For initial mTLS, `client_certificate_settings` contains `validation_cas`, `allow_expired` and `chain_level_validation`. The inspected flow receives one certificate credential; it does not guarantee forwarding every handshake intermediate to the validator. For a direct case, configure the bootstrap’s direct issuer as validation CA and test the actual Gateway path.",{"_3604":1005,"_31083":947,"_21524":53864,"_5":14790,"_28264":53719,"_3060":53865},[],"For certificate re-enrollment, the validator tries the enrollment CA first and then the CAs listed in `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`; those are the re-enrollment validation CAs. That list is optional because the enrollment CA is always trusted for re-enrollment, and each settings block consults only its own `validation_cas`. CAs listed only in the initial block's `validation_cas` do not extend re-enrollment acceptance; during a CA rotation, add the old issuance CA to the re-enrollment block's list. The re-enrollment validator compares the presented TLS leaf against those CAs; the re-enrollment block's `chain_level_validation` and `allow_expired` values are stored but not consulted, and expiry is governed by `enable_expired_renewal`.",{"_3604":1006,"_31083":947,"_21524":53867,"_5":14790,"_28264":53719,"_3060":53868},[],"For a webhook, configure destination, Lamassu-to-service authentication, method and timeout. The authentication contract explains the device credential and request body. `NO_AUTH` does not establish ownership of the requested ID.",{"_3604":1007,"_31083":947,"_21524":53870,"_5":14790,"_28264":53723,"_3060":53871},[],"The webhook authentication modes read `external_webhook_settings` in the same `est_rfc7030_settings` block:",{"_3604":1008,"_31083":947,"_21524":53873,"_5":14790,"_28264":53723,"_3060":53874},[],"`external_webhook_settings` field",{"_3604":1009,"_31083":947,"_21524":53876,"_5":14790,"_28264":53723,"_3060":53784},[],{"_3604":1010,"_31083":947,"_21524":53878,"_5":14790,"_28264":53723,"_3060":53879},[],"`url`",{"_3604":1011,"_31083":947,"_21524":53881,"_5":14790,"_28264":53723,"_3060":53882},[],"Absolute `http` or `https` URL of the receiver. It must be the final URL; redirects are not followed.",{"_3604":1012,"_31083":947,"_21524":53884,"_5":14790,"_28264":53723,"_3060":53885},[],"`method`",{"_3604":1013,"_31083":947,"_21524":53887,"_5":14790,"_28264":53723,"_3060":53888},[],"`POST` or `PUT`; `POST` by default.",{"_3604":1014,"_31083":947,"_21524":53890,"_5":14790,"_28264":53723,"_3060":53891},[],"`name`",{"_3604":1015,"_31083":947,"_21524":53893,"_5":14790,"_28264":53723,"_3060":53894},[],"Label used in service logs.",{"_3604":1016,"_31083":947,"_21524":53896,"_5":14790,"_28264":53723,"_3060":53897},[],"`config.auth_mode`",{"_3604":1017,"_31083":947,"_21524":53899,"_5":14790,"_28264":53723,"_3060":53900},[],"`noauth`, `apikey`, `jwt` or `mtls`. An absent or unknown value behaves as `noauth`.",{"_3604":1018,"_31083":947,"_21524":53902,"_5":14790,"_28264":53723,"_3060":53903},[],"`config.log_level`",{"_3604":1019,"_31083":947,"_21524":53905,"_5":14790,"_28264":53723,"_3060":53906},[],"Log level of the webhook call: `debug`, `info`, `warn` or `error`; `info` by default.",{"_3604":1020,"_31083":947,"_21524":53908,"_5":14790,"_28264":53723,"_3060":53909},[],"`config.apikey_options`",{"_3604":1021,"_31083":947,"_21524":53911,"_5":14790,"_28264":53723,"_3060":53912},[],"Required for `apikey`: `header` and `key`. Reserved header names are rejected.",{"_3604":1022,"_31083":947,"_21524":53914,"_5":14790,"_28264":53723,"_3060":53915},[],"`config.jwt_options`",{"_3604":1023,"_31083":947,"_21524":53917,"_5":14790,"_28264":53723,"_3060":53918},[],"Required for `jwt`: `oidc_client_id`, `oidc_client_secret` and an absolute `http` or `https` `oidc_well_known`.",{"_3604":1024,"_31083":947,"_21524":53920,"_5":14790,"_28264":53723,"_3060":53921},[],"`config.mtls_options`",{"_3604":1025,"_31083":947,"_21524":53923,"_5":14790,"_28264":53723,"_3060":53924},[],"Required for `mtls`: `cert_content` and `key_content` as Base64-encoded PEM, like certificates elsewhere in the API; plain PEM is also accepted.",{"_3604":1026,"_31083":947,"_21524":53926,"_5":14790,"_28264":53723,"_3060":53927},[],"`config.insecure_skip_verify`",{"_3604":1027,"_31083":947,"_21524":53929,"_5":14790,"_28264":53723,"_3060":53930},[],"Skips verification of the receiver certificate when `true`. Verification is on by default. Unlike alert channels, this flag is honored here.",{"_3604":1028,"_31083":947,"_21524":53932,"_5":14790,"_28264":53723,"_3060":53933},[],"`config.call_timeout`",{"_3604":1029,"_31083":947,"_21524":53935,"_5":14790,"_28264":53723,"_3060":53936},[],"Maximum duration of the authorization call (for example `10s`); 10 seconds by default.",{"_3604":1030,"_31083":947,"_21524":53938,"_5":14790,"_28264":53723,"_3060":53939},[],"Rules for that configuration:",{"_3604":1031,"_31083":947,"_21524":53941,"_5":14790,"_28264":53723,"_3060":53942},[],"Creating or updating a DMS whose enrollment or reenrollment `auth_mode` uses the webhook validates the block and returns HTTP 400 — the body starts with `struct validation error:` and continues with `invalid enrollment external webhook config` or `invalid reenrollment external webhook config` — when the URL, method or options are invalid. That includes an `mtls_options.cert_content`/`key_content` pair that does not decode to a matching certificate and private key. File references (`ca_cert_file`, `mtls_options.cert_file`, `mtls_options.key_file`) are always invalid: the service does not read files, so enter the certificate and key as Base64-encoded PEM in `mtls_options.cert_content` and `key_content`, or as plain PEM.",{"_3604":1032,"_31083":947,"_21524":53944,"_5":14790,"_28264":53723,"_3060":53945},[],"A custom `apikey_options.header` may not use names that the platform or the receiving service trusts — for example `X-Principal-Id`, `X-Request-Id`, `Host`, `Content-Type` or `Forwarded` — and no name may start with `X-Forwarded-`, `X-Envoy-` or `X-Lms-` (case-insensitive). The DMS API reference documents the `WebhookCall` and `WebhookCallHttpClient` schemas and that reserved API-key headers are rejected.",{"_3604":1033,"_31083":947,"_21524":53947,"_5":14790,"_28264":53723,"_3060":53948},[],"The nested `http_client` key exists only in alert channel configurations; in a DMS body it is ignored. The DMS key is `external_webhook_settings.config`.",{"_3604":1034,"_31083":947,"_21524":53950,"_5":14790,"_28264":53723,"_3060":53951},[],"A body with `config.auth_mode` set to `apikey`, `jwt` or `mtls` must carry its corresponding option block (`apikey_options`, `jwt_options` or `mtls_options`) — and nothing else. Bodies with those auth modes carrying only `apikey`, `oidc` or `mtls` fail validation with 400, and `validate_server_cert` is always ignored: use `insecure_skip_verify`. Only bodies without option blocks are accepted as `noauth`, and their credentials are dropped.",{"_3604":1035,"_31083":947,"_21524":53953,"_5":14790,"_28264":53723,"_3060":53954},[],"The authorization response must be JSON of at most 1 MiB; a larger body fails the call.",{"_3604":1036,"_31083":947,"_21524":53956,"_5":14790,"_28264":53723,"_3060":53957},[],"With credentials configured, they are sent regardless of the URL scheme: an `http://` webhook receives the API key or bearer token in cleartext, and mTLS has no effect because no TLS handshake takes place, so the client certificate is never presented. Prefer `https://` for `url`, `oidc_well_known` and the token endpoint it advertises.",{"_3604":1037,"_31083":947,"_21524":53959,"_5":14790,"_28264":53723,"_3060":53960},[],"Initial authentication and renewal settings are stored independently. If a DMS only has the initial authentication block, renewal reuses it: read both blocks before editing. The console exposes independent editors for the enrollment and re-enrollment authentication, with the same Log Level, Call Timeout, HTTP Authentication and credential fields as the webhook channels, plus a **Skip TLS Verification** switch (off by default, so verification stays on; the console warns when you enable it).",{"_3604":1038,"_31083":947,"_21524":53962,"_5":14790,"_28264":53723,"_3060":53963},[],"Webhook credentials must be stored as PEM content. File references (`ca_cert_file`, `mtls_options.cert_file`, `mtls_options.key_file`) are never valid in a stored webhook config: delivery rejects any webhook config that references files, whatever its auth mode, so every enroll and reenroll that calls that webhook fails until the certificate and key are entered as Base64-encoded or plain PEM in `mtls_options.cert_content` and `key_content`, or the file fields are removed if the webhook does not use mTLS. If a stored config holds file paths in `mtls_options.cert_content` or `key_content`, every full settings update (`POST /v1/dms`, `PUT /v1/dms/:id`) fails validation — settings are replaced wholesale, so the stored config must be resent — until the values are replaced by PEM content or the webhook stops being used. Meanwhile, delivery of that webhook fails on every call; a metadata-only update through `PUT` or `PATCH` on `/v1/dms/:id/metadata` still succeeds. To fix it in the console, open the DMS, replace any file-path value with PEM content — the editor rejects file paths with an inline field error — and save. Saving rewrites `external_webhook_settings.config` with the current keys, and the console reads both plain and Base64-encoded PEM from migrated configurations and stores the material Base64-encoded. If your stored config previously relied on `validate_server_cert: false`, it now carries `insecure_skip_verify: true`: receiver-certificate verification stays skipped until you set that flag to `false`. See 3.8.0 to 4.0.0 for the upgrade notes and the operator checklist.",{"_3604":1039,"_31083":947,"_21524":53965,"_5":14790,"_28264":53723,"_3060":53966},[],"The re-enrollment trust set lives in `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`. The flat field `reenrollment_settings.additional_validation_cas` is not part of the API: bodies that carry it are accepted but the value is silently ignored — unknown JSON fields are dropped — and GET responses do not include it. Read the DMS before sending API edits: an update body built with that flat field silently empties `validation_cas`.",{"_3604":1040,"_31083":947,"_21524":53968,"_5":14790,"_28264":53727,"_3060":53969},[],"`settings.issuance_profile_id` takes precedence over `settings.issuance_profile`; without either, the CA default profile is used. The resolved profile — including the CA default used as fallback when the DMS defines none — must define an end-entity certificate: a `Sign as CA` profile is rejected at enrollment and re-enrollment time. Rules are documented once in Profiles. DMS changes affect future requests; they do not modify signed certificates or install client trust.",{"_3604":1041,"_31083":947,"_21524":53971,"_5":14790,"_28264":53731,"_3060":53972},[],"`settings.reenrollment_settings` field",{"_3604":1042,"_31083":947,"_21524":53974,"_5":14790,"_28264":53731,"_3060":51120},[],{"_3604":1043,"_31083":947,"_21524":53976,"_5":14790,"_28264":53731,"_3060":53977},[],"`reenrollment_delta`",{"_3604":1044,"_31083":947,"_21524":53979,"_5":14790,"_28264":53731,"_3060":53980},[],"Opens the window at the active certificate’s `NotAfter` minus this delta.",{"_3604":1045,"_31083":947,"_21524":53982,"_5":14790,"_28264":53731,"_3060":53983},[],"`preventive_delta`",{"_3604":1046,"_31083":947,"_21524":53985,"_5":14790,"_28264":53731,"_3060":53986},[],"Preventive operational monitoring threshold.",{"_3604":1047,"_31083":947,"_21524":53988,"_5":14790,"_28264":53731,"_3060":53989},[],"`critical_delta`",{"_3604":1048,"_31083":947,"_21524":53991,"_5":14790,"_28264":53731,"_3060":53992},[],"Critical operational monitoring threshold.",{"_3604":1049,"_31083":947,"_21524":53994,"_5":14790,"_28264":53731,"_3060":53995},[],"`enable_expired_renewal`",{"_3604":1050,"_31083":947,"_21524":53997,"_5":14790,"_28264":53731,"_3060":53998},[],"Accepts an expired presented certificate in the renewal mTLS validator. Does not authorize another mode or remove Gateway constraints by itself.",{"_3604":1051,"_31083":947,"_21524":54000,"_5":14790,"_28264":53731,"_3060":54001},[],"`est_rfc7030_settings.client_certificate_settings.validation_cas`",{"_3604":1052,"_31083":947,"_21524":54003,"_5":14790,"_28264":53731,"_3060":54004},[],"Re-enrollment validation CAs for the renewal mTLS credential, tried after the enrollment CA; optional, because the enrollment CA is always trusted. Typically populated during CA rotation while old-CA cohorts renew.",{"_3604":1053,"_31083":947,"_21524":54006,"_5":14790,"_28264":53731,"_3060":54007},[],"`revoke_on_reenrollment`",{"_3604":1054,"_31083":947,"_21524":54009,"_5":14790,"_28264":53731,"_3060":54010},[],"If the previous certificate is ACTIVE, attempts Superseded revocation before binding its successor.",{"_3604":1055,"_31083":947,"_21524":54012,"_5":14790,"_28264":53731,"_3060":54013},[],"Monitoring does not renew: the client must schedule the request and installation. Webhook and NO\\_AUTH modes do not use the same mTLS expired-credential validator; the webhook must explicitly authorize permitted recovery. Review Renewal and recovery for operation order and partial failures.",{"_3604":1056,"_31083":947,"_21524":54015,"_5":14790,"_28264":53735,"_3060":54016},[],"`settings.server_keygen_settings.enabled` enables software key generation on the server. The console exposes it through an **Enable server-side key generation** switch and a **Key type** selection: `ECDSA` P-256, P-384 or P-521, or `RSA` with 2048, 3072 or 4096 bits; the defaults are P-256 for `ECDSA` and 4096 bit for `RSA`. Algorithm and size come from its `key` field, stored as `{type,bits}` where P-256, P-384 and P-521 map to `bits` 256, 384 and 521; `key` is omitted when disabled. The profile must permit them. The response contains an unencrypted PKCS#8 key inside TLS alongside the certificate. See format and extraction in EST reference.",{"_3604":1057,"_31083":947,"_21524":54018,"_5":14790,"_28264":53739,"_3060":51114},[],{"_3604":1058,"_31083":947,"_21524":54020,"_5":14790,"_28264":53739,"_3060":54021},[],"Published material",{"_3604":1059,"_31083":947,"_21524":54023,"_5":14790,"_28264":53739,"_3060":54024},[],"**Include Lamassu System CA**",{"_3604":1060,"_31083":947,"_21524":54026,"_5":14790,"_28264":53739,"_3060":54027},[],"Available downstream TLS certificate; it can be a leaf, not an issuing CA.",{"_3604":1061,"_31083":947,"_21524":54029,"_5":14790,"_28264":53739,"_3060":54030},[],"**Include Enrollment CA**",{"_3604":1062,"_31083":947,"_21524":54032,"_5":14790,"_28264":53739,"_3060":54033},[],"Selected issuing CA certificate.",{"_3604":1063,"_31083":947,"_21524":54035,"_5":14790,"_28264":53739,"_3060":54036},[],"**Managed CAs**",{"_3604":1064,"_31083":947,"_21524":54038,"_5":14790,"_28264":53739,"_3060":54039},[],"Explicitly selected CA certificates.",{"_3604":1065,"_31083":947,"_21524":54041,"_5":14790,"_28264":53739,"_3060":54042},[],"All ancestors are not added automatically. Trust distribution distinguishes trusted roots, intermediates and initial server trust.",{"_3604":1066,"_31083":947,"_21524":54044,"_5":14790,"_28264":53743,"_3060":54045},[],"**Edit** changes name, settings and metadata. Updates go through the DMS API. `PUT /v1/dms/{id}` always targets the DMS identified by the URL path: the body carries no `id` field, and any `id` or `creation_ts` in it is silently ignored — authorization is evaluated against the same URL identifier. The body must include a non-empty `name` and a `settings` object; missing either returns HTTP 400 and leaves the stored DMS unchanged. `name` and `settings` are always full replacements, so read the DMS before sending API edits to avoid losing fields. `metadata` is optional: omitting it or sending `null` keeps the stored metadata, a supplied object replaces it entirely, and `{}` clears it (a later GET returns an empty object, not `null`). Old-style bodies that carry the full DMS object keep working while they include `name` and `settings`; unknown fields are ignored. Updates reject an empty `name` with HTTP 400: a DMS whose stored name was zeroed by an earlier update must be renamed before any client round-trips it — the AWS IoT connector’s JITP writeback included. If the object does not include the AWS IoT connector key (`lamassu.io/iot/{connector_id}`), the connector ignores the DMS's later events.",{"_3604":1067,"_31083":947,"_21524":54047,"_5":14790,"_28264":53743,"_3060":54048},[],"**Go to DMS owned devices** restricts inventory by owner. **Show/Edit Metadata** contains operational and integration data; consult the integration guide before changing it. &#x2A;*EST (RFC-7030)** helps locate URLs.",{"_3604":1068,"_31083":947,"_21524":54050,"_5":14790,"_28264":53743,"_3060":54051},[],"**Delete** removes the DMS record and configuration; it does not itself cascade revocation across every device and certificate. Migrate dependencies and retain audit references before retirement.",{"_3604":1069,"_31083":947,"_21524":54053,"_5":14790,"_28264":53747,"_3060":54054},[],"Continue with EST client or the enrollment and mTLS tutorial. EST reference covers formats; Troubleshooting covers failures.",{"_3604":1070,"_31083":1070,"_5":15155,"_3060":54056,"_31421":54057,"_21524":54058,"_28264":1070},"Integrate the EST client",[50730,52242,53414,53412,53598],[],{"_3604":1071,"_31083":1070,"_21524":54060,"_5":14790,"_28264":1070,"_3060":54061},[],"Prepare trust, send a CSR and check the identity you receive.",{"_3604":1072,"_31083":1070,"_5":31418,"_21524":54063,"_28264":54064,"_3060":50740},[],"/docs/platform/iot-fleets/enrollment/est-client#before-you-begin",{"_3604":1073,"_31083":1070,"_5":31418,"_21524":54066,"_28264":54067,"_3060":54068},[],"/docs/platform/iot-fleets/enrollment/est-client#download-and-inspect-cacerts","Download and inspect cacerts",{"_3604":1074,"_31083":1070,"_5":31418,"_21524":54070,"_28264":54071,"_3060":54072},[],"/docs/platform/iot-fleets/enrollment/est-client#prepare-the-csr","Prepare the CSR",{"_3604":1075,"_31083":1070,"_5":31418,"_21524":54074,"_28264":54075,"_3060":54076},[],"/docs/platform/iot-fleets/enrollment/est-client#request-the-identity","Request the identity",{"_3604":1076,"_31083":1070,"_5":31418,"_21524":54078,"_28264":54079,"_3060":54080},[],"/docs/platform/iot-fleets/enrollment/est-client#check-and-install-the-result","Check and install the result",{"_3604":1077,"_31083":1070,"_5":31418,"_21524":54082,"_28264":54083,"_3060":54084},[],"/docs/platform/iot-fleets/enrollment/est-client#next-steps","Next steps",{"_3604":1078,"_31083":1070,"_21524":54086,"_5":14790,"_28264":1070,"_3060":54087},[],"This guide is for those implementing the device client. The administrator must have prepared the DMS policy. For a complete first run, follow Enroll and connect your first device.",{"_3604":1079,"_31083":1070,"_21524":54089,"_5":14790,"_28264":54064,"_3060":54090},[],"You need the public HTTPS DMS URL, server trust obtained through an approved channel, the operation's authentication mode and an admitted identifier. The examples use Bash, OpenSSL 3.x and curl with `--fail-with-body`; use a private working directory and compatible versions of these tools.",{"_3604":1080,"_31083":1070,"_21524":54092,"_5":14790,"_28264":54064,"_3060":54093},[],"Prepare `est-trust.pem` to verify the EST server, `bootstrap.crt` and `bootstrap.key` for initial certificate authentication, and `device-root.pem` as the approved root of the device issuer. The two trust files can contain different roots. For another authentication mode, adapt the credentials according to Bootstrap identity.",{"_3604":1081,"_31083":1070,"_21524":54095,"_5":14790,"_28264":54064,"_3060":54096},[],"Replace the host and `REPLACE_DMS_ID` with those of your installation. The URL's APS is the DMS identifier, not its display name.",{"_3604":1082,"_31083":1070,"_21524":54098,"_5":14790,"_28264":54067,"_3060":54099},[],"The default content is Base64-encoded DER PKCS#7. It is not a direct PEM file.",{"_3604":1083,"_31083":1070,"_21524":54101,"_5":14790,"_28264":54067,"_3060":54102},[],"Check fingerprints, issuers and dates against the trust distribution policy. The response can contain a selection of CAs and Lamassu's TLS certificate. Do not turn the entire bundle into trusted roots or use it to authenticate its own initial download. HTTP 200 here does not prove that authentication or issuance works.",{"_3604":1084,"_31083":1070,"_21524":54104,"_5":14790,"_28264":54071,"_3060":54105},[],"The example generates a new EC P-256 key and uses `est-device-001`, which must be available if the DMS registers automatically. The `Common Name` becomes the device identifier. Check that the profile permits the selected key and subject.",{"_3604":1085,"_31083":1070,"_21524":54107,"_5":14790,"_28264":54071,"_3060":54108},[],"An implementation using hardware or its own store must produce the CSR through its resident key. `simpleenroll` sends the request and retains the key in the client. Honor Extensions does not authorize every requested attribute: see Profiles.",{"_3604":1086,"_31083":1070,"_21524":54110,"_5":14790,"_28264":54075,"_3060":54111},[],"With initial `CLIENT_CERTIFICATE` authentication, send the Base64-encoded DER CSR using `Content-Type: application/pkcs10`:",{"_3604":1087,"_31083":1070,"_21524":54113,"_5":14790,"_28264":54075,"_3060":54114},[],"Stop if curl fails. Retain the HTTP code, headers and body for diagnosis; an error response is not decoded as a certificate. The Bash example stops before that conversion. A timeout leaves the operation's result to be checked in Lamassu: do not automatically repeat issuance.",{"_3604":1088,"_31083":1070,"_21524":54116,"_5":14790,"_28264":54079,"_3060":54117},[],"For a root that issues directly:",{"_3604":1089,"_31083":1070,"_21524":54119,"_5":14790,"_28264":54079,"_3060":54120},[],"Also verify that the CN is correct, the certificate is a leaf, its uses permit your application and its dates satisfy the profile. `cmp` must exit with code 0. With intermediates, provide the chain through `-untrusted` as described in PKI validation.",{"_3604":1090,"_31083":1070,"_21524":54122,"_5":14790,"_28264":54079,"_3060":54123},[],"Query the device: the owning DMS, current serial number and history must match the result. Protect the key/certificate pair and install both using the device's mechanism. Association in Lamassu does not install files in the client. Check a real connection before considering the process complete.",{"_3604":1091,"_31083":1070,"_21524":54125,"_5":14790,"_28264":54083,"_3060":54126},[],"Implement renewal and recovery and trust updates. The EST reference covers endpoints, formats and ServerKeyGen; troubleshooting helps distinguish transport, admission and persistence failures.",{"_3604":1092,"_31083":1092,"_5":15155,"_3060":54128,"_31421":54129,"_21524":54130,"_28264":1092},"EST reference",[50730,52242,53414,53412,53598],[],{"_3604":1093,"_31083":1092,"_21524":54132,"_5":14790,"_28264":1092,"_3060":54133},[],"Look up Lamassu routes, formats, authentication and multipart responses.",{"_3604":1094,"_31083":1092,"_5":31418,"_21524":54135,"_28264":54136,"_3060":54137},[],"/docs/platform/iot-fleets/enrollment/est-reference#endpoint-reference","Endpoint reference",{"_3604":1095,"_31083":1092,"_5":31418,"_21524":54139,"_28264":54140,"_3060":23326},[],"/docs/platform/iot-fleets/enrollment/est-reference#cacerts",{"_3604":1096,"_31083":1092,"_5":31418,"_21524":54142,"_28264":54143,"_3060":26820},[],"/docs/platform/iot-fleets/enrollment/est-reference#simpleenroll",{"_3604":1097,"_31083":1092,"_5":31418,"_21524":54145,"_28264":54146,"_3060":26827},[],"/docs/platform/iot-fleets/enrollment/est-reference#simplereenroll",{"_3604":1098,"_31083":1092,"_5":31418,"_21524":54148,"_28264":54149,"_3060":26089},[],"/docs/platform/iot-fleets/enrollment/est-reference#serverkeygen",{"_3604":1099,"_31083":1092,"_5":31418,"_21524":54151,"_28264":54152,"_3060":54153},[],"/docs/platform/iot-fleets/enrollment/est-reference#response-format","Response format",{"_3604":1100,"_31083":1092,"_5":31418,"_21524":54155,"_28264":54156,"_3060":54157},[],"/docs/platform/iot-fleets/enrollment/est-reference#request-and-extraction","Request and extraction",{"_3604":1101,"_31083":1092,"_5":31418,"_21524":54159,"_28264":54160,"_3060":54161},[],"/docs/platform/iot-fleets/enrollment/est-reference#compatibility-notes","Compatibility notes",{"_3604":1102,"_31083":1092,"_21524":54163,"_5":14790,"_28264":1092,"_3060":54164},[],"Reference for the examined backend, based on RFC 7030. Use EST client for the procedure and DMS to configure policy.",{"_3604":1103,"_31083":1092,"_21524":54166,"_5":14790,"_28264":54136,"_3060":54167},[],"Public route in the examples: `/.well-known/est/{APS}/{operation}`. `APS` is the DMS ID. The router admits routes without that segment, but the controller requires it; do not use them as a default service. Gateway configuration determines the public host and route.",{"_3604":1104,"_31083":1092,"_21524":54169,"_5":14790,"_28264":54136,"_3060":54170},[],"Operation",{"_3604":1105,"_31083":1092,"_21524":54172,"_5":14790,"_28264":54136,"_3060":54173},[],"Method",{"_3604":1106,"_31083":1092,"_21524":54175,"_5":14790,"_28264":54136,"_3060":54176},[],"Authentication and condition",{"_3604":1107,"_31083":1092,"_21524":54178,"_5":14790,"_28264":54136,"_3060":54179},[],"`/cacerts`",{"_3604":1108,"_31083":1092,"_21524":54181,"_5":14790,"_28264":54136,"_3060":54182},[],"GET",{"_3604":1109,"_31083":1092,"_21524":54184,"_5":14790,"_28264":54136,"_3060":54185},[],"DMS reading does not require an EST credential; HTTPS and infrastructure controls still apply.",{"_3604":1110,"_31083":1092,"_21524":54187,"_5":14790,"_28264":54136,"_3060":54188},[],"`/simpleenroll`",{"_3604":1111,"_31083":1092,"_21524":54190,"_5":14790,"_28264":54136,"_3060":54191},[],"POST",{"_3604":1112,"_31083":1092,"_21524":54193,"_5":14790,"_28264":54136,"_3060":54194},[],"Initial authentication and DMS registration/replacement policy.",{"_3604":1113,"_31083":1092,"_21524":54196,"_5":14790,"_28264":54136,"_3060":54197},[],"`/simplereenroll`",{"_3604":1114,"_31083":1092,"_21524":54199,"_5":14790,"_28264":54136,"_3060":54191},[],{"_3604":1115,"_31083":1092,"_21524":54201,"_5":14790,"_28264":54136,"_3060":54202},[],"Renewal authentication, existing identity, subject, revocation and window.",{"_3604":1116,"_31083":1092,"_21524":54204,"_5":14790,"_28264":54136,"_3060":54205},[],"`/serverkeygen`",{"_3604":1117,"_31083":1092,"_21524":54207,"_5":14790,"_28264":54136,"_3060":54191},[],{"_3604":1118,"_31083":1092,"_21524":54209,"_5":14790,"_28264":54136,"_3060":54210},[],"Initial authentication and admission; server generation enabled.",{"_3604":1119,"_31083":1092,"_21524":54212,"_5":14790,"_28264":54136,"_3060":54213},[],"These routes do not implement `/csrattrs` or `/fullcmc`. There is no native JWT EST authentication mode; a webhook can interpret a request credential according to its own contract.",{"_3604":1120,"_31083":1092,"_21524":54215,"_5":14790,"_28264":54140,"_3060":54216},[],"The default response has `Content-Type: application/pkcs7-mime; smime-type=certs-only` and `Content-Transfer-Encoding: base64`. The body is Base64-encoded DER PKCS#7 with lines of up to 76 characters. It includes the certificates selected by the DMS, not necessarily every ancestor.",{"_3604":1121,"_31083":1092,"_21524":54218,"_5":14790,"_28264":54140,"_3060":54219},[],"`Accept: application/x-pem-file` requests the bundle in PEM through a Lamassu extension. Inspect and approve its contents before modifying trusted roots.",{"_3604":1122,"_31083":1092,"_21524":54221,"_5":14790,"_28264":54143,"_3060":54222},[],"Send a Base64-encoded DER PKCS#10 CSR with `Content-Type: application/pkcs10`. The examined controller compares that media type literally; avoid adding parameters such as charset. The CN identifies the device and the CSR signature must be verified through DMS policy.",{"_3604":1123,"_31083":1092,"_21524":54224,"_5":14790,"_28264":54143,"_3060":54225},[],"The default response uses the PKCS#7/Base64 format described for cacerts, but contains the issued certificate; do not assume it includes its entire chain. `Accept: application/x-pem-file` returns that certificate in PEM. The client retains the key that signed the CSR.",{"_3604":1124,"_31083":1092,"_21524":54227,"_5":14790,"_28264":54146,"_3060":54228},[],"Use the same request and certificate response formats. Authentication comes from the independent `reenrollment_settings.est_rfc7030_settings` block. With a client certificate, its CN must match the CSR CN; the subject is also checked against the current certificate.",{"_3604":1125,"_31083":1092,"_21524":54230,"_5":14790,"_28264":54146,"_3060":54231},[],"In mTLS mode, the enrollment CA always validates the re-enrollment credential; certificates from other issuers are accepted only if they are listed as validation CAs in the re-enrollment block. The expiry check through `enable_expired_renewal` belongs to that validator. A revoked current certificate and a request before the window are rejected. See Renewal for installation and recovery.",{"_3604":1126,"_31083":1092,"_21524":54233,"_5":14790,"_28264":54149,"_3060":54234},[],"The server generates a software key, rebuilds the CSR with that key and performs initial enrollment. The flag must be enabled and the algorithm permitted by the profile. This operation's key does not become a hardware key because the CA is hosted in an HSM.",{"_3604":1127,"_31083":1092,"_21524":54236,"_5":14790,"_28264":54149,"_3060":54237},[],"The code supports RSA and ECDSA, and the `bits` value of the DMS key setting means something different for each. For ECDSA it selects the curve: 224, 256, 384 or 521 map to P-224, P-256, P-384 and P-521, and an unrecognized size falls back to P-256, so explicitly select a compatible size and check the resulting key. For RSA it is used directly as the modulus size; the console offers 2048, 3072 and 4096 bits. Do not reuse an enrolled ID to test this operation without reviewing replacement.",{"_3604":1128,"_31083":1092,"_21524":54239,"_5":14790,"_28264":54152,"_3060":54240},[],"The body is **MIME multipart/mixed**, with the boundary specified in `Content-Type`. It contains two parts:",{"_3604":1129,"_31083":1092,"_21524":54242,"_5":14790,"_28264":54152,"_3060":54243},[],"Part",{"_3604":1130,"_31083":1092,"_21524":54245,"_5":14790,"_28264":54152,"_3060":54246},[],"Content after decoding its Base64",{"_3604":1131,"_31083":1092,"_21524":54248,"_5":14790,"_28264":54152,"_3060":54249},[],"`application/pkcs8`",{"_3604":1132,"_31083":1092,"_21524":54251,"_5":14790,"_28264":54152,"_3060":54252},[],"Unencrypted DER PKCS#8 private key.",{"_3604":1133,"_31083":1092,"_21524":54254,"_5":14790,"_28264":54152,"_3060":54255},[],"`application/pkcs7-mime; smime-type=certs-only`",{"_3604":1134,"_31083":1092,"_21524":54257,"_5":14790,"_28264":54152,"_3060":54258},[],"DER PKCS#7 containing the issued certificate.",{"_3604":1135,"_31083":1092,"_21524":54260,"_5":14790,"_28264":54152,"_3060":54261},[],"The controller also adds `Content-Transfer-Encoding: base64` to the outer header, although the outer body is MIME text. &#x2A;*Do not Base64-decode the entire body.** Read the actual boundary and decode each part according to its headers.",{"_3604":1136,"_31083":1092,"_21524":54263,"_5":14790,"_28264":54156,"_3060":54264},[],"In a Bash session with `set -euo pipefail` and `umask 077`, use `EST_BASE` and the trust/bootstrap files from EST client. Select an available and admitted `est-serverkeygen-001`. The `server-request.key` only signs the input CSR; the received identity uses the server-generated key.",{"_3604":1137,"_31083":1092,"_21524":54266,"_5":14790,"_28264":54156,"_3060":54267},[],"Save this Python 3 extractor. It validates both parts before writing and rejects existing output files:",{"_3604":1138,"_31083":1092,"_21524":54269,"_5":14790,"_28264":54156,"_3060":54270},[],"Convert and check the result:",{"_3604":1139,"_31083":1092,"_21524":54272,"_5":14790,"_28264":54156,"_3060":54273},[],"Inspect the CN, serial, dates and uses; check association in Lamassu before installing. Protect the DER and PEM files containing the key and remove temporary copies according to the device's storage mechanism. See openssl-pkcs8 and the Python MIME parser.",{"_3604":1140,"_31083":1092,"_21524":54275,"_5":14790,"_28264":54160,"_3060":54276},[],"Do not interpret every 500 as a transient failure. Invalid input typically produces 400; service denials and errors typically produce 500 with a JSON `err` body. Gateway errors and some controller paths can have another format. Retain headers and body before decoding and see troubleshooting.",{"_3604":1141,"_31083":1092,"_21524":54278,"_5":14790,"_28264":54160,"_3060":54279},[],"The examples use openssl-pkcs7 to extract certificates and openssl-x509 to prepare renewal. Check your version's capabilities and responses before integrating a generic EST client.",{"_3604":1142,"_31083":1142,"_5":15155,"_3060":53598,"_31421":54281,"_21524":54282,"_28264":1142},[50730,52242,53414,53412,53598],[],{"_3604":1143,"_31083":1142,"_21524":54284,"_5":14790,"_28264":1142,"_3060":54285},[],"Choose admission policy and connect DMS, initial trust and the EST client.",{"_3604":1144,"_31083":1142,"_5":31418,"_21524":54287,"_28264":54288,"_3060":54289},[],"/docs/platform/iot-fleets/enrollment/overview#the-journey","The journey",{"_3604":1145,"_31083":1142,"_5":31418,"_21524":54291,"_28264":54292,"_3060":54293},[],"/docs/platform/iot-fleets/enrollment/overview#for-the-administrator","For the administrator",{"_3604":1146,"_31083":1142,"_5":31418,"_21524":54295,"_28264":54296,"_3060":54297},[],"/docs/platform/iot-fleets/enrollment/overview#for-the-integrator","For the integrator",{"_3604":1147,"_31083":1142,"_5":31418,"_21524":54299,"_28264":54300,"_3060":54301},[],"/docs/platform/iot-fleets/enrollment/overview#contract-version","Contract version",{"_3604":1148,"_31083":1142,"_21524":54303,"_5":14790,"_28264":1142,"_3060":54304},[],"Enrollment with PKI covers the path from device admission to identity installation and renewal. The DMS acts as a registration authority: it authenticates the request, applies registration policy and asks the CA to sign. The client keeps or receives the key, installs the result and presents it to the consumer.",{"_3604":1149,"_31083":1142,"_21524":54306,"_5":14790,"_28264":54288,"_3060":54307},[],"The administrator prepares the CA, issuance profile and DMS.",{"_3604":1150,"_31083":1142,"_21524":54309,"_5":14790,"_28264":54288,"_3060":54310},[],"The integrator installs initial EST server trust and an admission credential.",{"_3604":1151,"_31083":1142,"_21524":54312,"_5":14790,"_28264":54288,"_3060":54313},[],"The client requests an identity for its `Device ID` through EST.",{"_3604":1152,"_31083":1142,"_21524":54315,"_5":14790,"_28264":54288,"_3060":54316},[],"Certificate, device binding and key/certificate installation are checked.",{"_3604":1153,"_31083":1142,"_21524":54318,"_5":14790,"_28264":54288,"_3060":54319},[],"The consumer validates and authorizes the identity; the client schedules renewal and recovery.",{"_3604":1154,"_31083":1142,"_21524":54321,"_5":14790,"_28264":54288,"_3060":54322},[],"EST uses `/.well-known/est/{DMS_ID}`. Administrative APIs and manual assignment remain separate paths. Enroll and connect a device completes an initial mTLS test.",{"_3604":1155,"_31083":1142,"_21524":54324,"_5":14790,"_28264":54292,"_3060":54325},[],"<Card title=\"Provisioning strategies\" description=\"Choose automatic registration, preregistration or manual assignment.\" href=\"/docs/platform/iot-fleets/enrollment/provisioning-strategies\" />",{"_3604":1156,"_31083":1142,"_21524":54327,"_5":14790,"_28264":54292,"_3060":54328},[],"<Card title=\"Configure the DMS\" description=\"Separate admission, authentication per operation, profiles and distribution.\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_3604":1157,"_31083":1142,"_21524":54330,"_5":14790,"_28264":54292,"_3060":54331},[],"<Card title=\"Bootstrap identity and authentication\" description=\"Decide which proof allows requesting the first identity.\" href=\"/docs/platform/iot-fleets/enrollment/bootstrap-identity\" />",{"_3604":1158,"_31083":1142,"_21524":54333,"_5":14790,"_28264":54292,"_3060":54334},[],"<Card title=\"Trust distribution\" description=\"Update roots and chains with verified overlap.\" href=\"/docs/platform/iot-fleets/enrollment/trust-distribution\" />",{"_3604":1159,"_31083":1142,"_21524":54336,"_5":14790,"_28264":54296,"_3060":54337},[],"<Card title=\"EST client\" description=\"Prepare the request, verify the response and install the identity.\" href=\"/docs/platform/iot-fleets/enrollment/est-client\" />",{"_3604":1160,"_31083":1142,"_21524":54339,"_5":14790,"_28264":54296,"_3060":54340},[],"<Card title=\"Renewal and recovery\" description=\"Generate the successor and handle expired or lost credentials.\" href=\"/docs/platform/iot-fleets/enrollment/renewal-and-recovery\" />",{"_3604":1161,"_31083":1142,"_21524":54342,"_5":14790,"_28264":54296,"_3060":54343},[],"<Card title=\"EST reference\" description=\"Look up paths, formats, authentication and ServerKeyGen.\" href=\"/docs/platform/iot-fleets/enrollment/est-reference\" />",{"_3604":1162,"_31083":1142,"_21524":54345,"_5":14790,"_28264":54296,"_3060":54346},[],"<Card title=\"Troubleshooting\" description=\"Distinguish transport, policy, issuance and installation failures.\" href=\"/docs/platform/iot-fleets/enrollment/troubleshooting\" />",{"_3604":1163,"_31083":1142,"_21524":54348,"_5":14790,"_28264":54300,"_3060":54349},[],"This block describes `main` code inspected at commit `8f42c47157f9a36bac3ed5caa3692aebebe19c4b`. The site catalog publishes `main (unstable)`; this behavior is not attributed to a stable release. Before using another version, check its contract, particularly independent re-enrollment authentication. Client checks and live-instance tests are distinguished in the revision plan.",{"_3604":1164,"_31083":1142,"_21524":54351,"_5":14790,"_28264":54300,"_3060":54352},[],"Gateway, TLS, provider and service configuration belongs to Deployment. Identity use in AWS or other destinations belongs to Integrations.",{"_3604":1165,"_31083":1165,"_5":15155,"_3060":54354,"_31421":54355,"_21524":54356,"_28264":1165},"Provisioning strategies",[50730,52242,53414,53412,53598],[],{"_3604":1166,"_31083":1165,"_21524":54358,"_5":14790,"_28264":1165,"_3060":54359},[],"Choose device registration, identity authorization and key generation.",{"_3604":1167,"_31083":1165,"_5":31418,"_21524":54361,"_28264":54362,"_3060":54363},[],"/docs/platform/iot-fleets/enrollment/provisioning-strategies#choose-registration","Choose registration",{"_3604":1168,"_31083":1165,"_5":31418,"_21524":54365,"_28264":54366,"_3060":54367},[],"/docs/platform/iot-fleets/enrollment/provisioning-strategies#preregistration-and-replacement","Preregistration and replacement",{"_3604":1169,"_31083":1165,"_5":31418,"_21524":54369,"_28264":54370,"_3060":54371},[],"/docs/platform/iot-fleets/enrollment/provisioning-strategies#choose-authentication","Choose authentication",{"_3604":1170,"_31083":1165,"_5":31418,"_21524":54373,"_28264":54374,"_3060":54375},[],"/docs/platform/iot-fleets/enrollment/provisioning-strategies#choose-custody","Choose custody",{"_3604":1171,"_31083":1165,"_5":31418,"_21524":54377,"_28264":54378,"_3060":54379},[],"/docs/platform/iot-fleets/enrollment/provisioning-strategies#check-the-decision","Check the decision",{"_3604":1172,"_31083":1165,"_21524":54381,"_5":14790,"_28264":1165,"_3060":54382},[],"This guide helps the provisioning administrator choose a path before configuring the DMS. Separate three decisions: when the device exists, how its request is authorized and who generates its key. None grants destination access by itself.",{"_3604":1173,"_31083":1165,"_21524":54384,"_5":14790,"_28264":54362,"_3060":54385},[],"Path",{"_3604":1174,"_31083":1165,"_21524":54387,"_5":14790,"_28264":54362,"_3060":54388},[],"When the device exists",{"_3604":1175,"_31083":1165,"_21524":54390,"_5":14790,"_28264":54362,"_3060":54391},[],"What to check",{"_3604":1176,"_31083":1165,"_21524":54393,"_5":14790,"_28264":54362,"_3060":54394},[],"Manual assignment",{"_3604":1177,"_31083":1165,"_21524":54396,"_5":14790,"_28264":54362,"_3060":54397},[],"An operator creates it before associating a certificate.",{"_3604":1178,"_31083":1165,"_21524":54399,"_5":14790,"_28264":54362,"_3060":54400},[],"ID, owning DMS, certificate CN and bound serial.",{"_3604":1179,"_31083":1165,"_21524":54402,"_5":14790,"_28264":54362,"_3060":54403},[],"EST with `JITP`",{"_3604":1180,"_31083":1165,"_21524":54405,"_5":14790,"_28264":54362,"_3060":54406},[],"Created for an unknown CN during `/simpleenroll`.",{"_3604":1181,"_31083":1165,"_21524":54408,"_5":14790,"_28264":54362,"_3060":54409},[],"Authorized credential, unused ID, profile, resulting registration and identity.",{"_3604":1182,"_31083":1165,"_21524":54411,"_5":14790,"_28264":54362,"_3060":54412},[],"EST with `PRE_REGISTRATION`",{"_3604":1183,"_31083":1165,"_21524":54414,"_5":14790,"_28264":54362,"_3060":54415},[],"Must exist before `/simpleenroll`.",{"_3604":1184,"_31083":1165,"_21524":54417,"_5":14790,"_28264":54362,"_3060":54418},[],"Approved record, same DMS and replacement conditions for your version.",{"_3604":1185,"_31083":1165,"_21524":54420,"_5":14790,"_28264":54362,"_3060":54421},[],"Lamassu `JITP` creates inventory and identity in Lamassu. AWS JITP provisions a destination in AWS; these are separate decisions.",{"_3604":1186,"_31083":1165,"_21524":54423,"_5":14790,"_28264":54362,"_3060":54424},[],"For an initial client test, use Enroll and connect a device. To prepare inventory without EST, follow Manual registration.",{"_3604":1187,"_31083":1165,"_21524":54426,"_5":14790,"_28264":54366,"_3060":54427},[],"In the inspected code, finding any device owned by the same DMS triggers the `enable_replaceable_enrollment` check before PRE\\_REGISTRATION. With the flag disabled, a preregistered device can receive `forbiddenNewEnrollment` even in **No Identity**. Selecting PRE\\_REGISTRATION alone therefore does not establish a working path.",{"_3604":1188,"_31083":1165,"_21524":54429,"_5":14790,"_28264":54366,"_3060":54430},[],"Enabling the flag permits repeated `/simpleenroll` for an existing ID. The backend schedules a deferred attempt to revoke the previous certificate with `Superseded`; it can also run if later issuance or binding fails. Without an identity, that attempt can fail because no serial exists. The flag does not provide a replacement transaction or guarantee restoration of previous state.",{"_3604":1189,"_31083":1165,"_21524":54432,"_5":14790,"_28264":54366,"_3060":54433},[],"Test the exact case on your version before enabling it for a population. For an operational identity with authorized renewal, use `/simplereenroll`; for recovery, follow Renewal and recovery and check persisted state before retrying.",{"_3604":1190,"_31083":1165,"_21524":54435,"_5":14790,"_28264":54370,"_3060":54436},[],"Decide initial enrollment and re-enrollment separately:",{"_3604":1191,"_31083":1165,"_21524":54438,"_5":14790,"_28264":54370,"_3060":54439},[],"**Client certificate:** useful when each device has an initial credential whose key it controls.",{"_3604":1192,"_31083":1165,"_21524":54441,"_5":14790,"_28264":54370,"_3060":54442},[],"**Webhook:** useful when another authority knows inventory, credentials or entitlement to a requested ID.",{"_3604":1193,"_31083":1165,"_21524":54444,"_5":14790,"_28264":54370,"_3060":54445},[],"**Certificate and webhook:** requires both controls in the configured operation.",{"_3604":1194,"_31083":1165,"_21524":54447,"_5":14790,"_28264":54370,"_3060":54448},[],"**NO\\_AUTH:** does not establish requester identity; appropriate only when admission is deliberately controlled outside that DMS.",{"_3604":1195,"_31083":1165,"_21524":54450,"_5":14790,"_28264":54370,"_3060":54451},[],"Authenticating an initial certificate does not itself establish entitlement to choose any CSR CN. Define that authorization in Bootstrap identity and authentication.",{"_3604":1196,"_31083":1165,"_21524":54453,"_5":14790,"_28264":54374,"_3060":51114},[],{"_3604":1197,"_31083":1165,"_21524":54455,"_5":14790,"_28264":54374,"_3060":54456},[],"Material crossing EST",{"_3604":1198,"_31083":1165,"_21524":54458,"_5":14790,"_28264":54374,"_3060":54459},[],"Device-generated key",{"_3604":1199,"_31083":1165,"_21524":54461,"_5":14790,"_28264":54374,"_3060":54462},[],"Public CSR and certificate; the key stays on the client.",{"_3604":1200,"_31083":1165,"_21524":54464,"_5":14790,"_28264":54374,"_3060":54465},[],"Existing device key",{"_3604":1201,"_31083":1165,"_21524":54467,"_5":14790,"_28264":54374,"_3060":54468},[],"CSR signed with that key and a new certificate.",{"_3604":1202,"_31083":1165,"_21524":54470,"_5":14790,"_28264":54374,"_3060":53736},[],{"_3604":1203,"_31083":1165,"_21524":54472,"_5":14790,"_28264":54374,"_3060":54473},[],"Private PKCS#8 key and certificate in a TLS-protected multipart response.",{"_3604":1204,"_31083":1165,"_21524":54475,"_5":14790,"_28264":54374,"_3060":54476},[],"ServerKeyGen does not automatically use the CA’s HSM or KMS for the device key. Review its contract and extraction and the device’s ability to install the material.",{"_3604":1205,"_31083":1165,"_21524":54478,"_5":14790,"_28264":54378,"_3060":54479},[],"Before expanding the flow, test allowed registration, incorrect credentials, an ID owned by another DMS, repeated requests and recovery after failure. Keep ID, serial, active version and error. Also test consumer acceptance and rejection; issuance does not imply destination registration or permission to operate.",{"_3604":1206,"_31083":1206,"_5":15155,"_3060":54481,"_31421":54482,"_21524":54483,"_28264":1206},"Renewal and recovery",[50730,52242,53414,53412,53598],[],{"_3604":1207,"_31083":1206,"_21524":54485,"_5":14790,"_28264":1206,"_3060":54486},[],"Renew without losing the identity and recover devices according to their actual state.",{"_3604":1208,"_31083":1206,"_5":31418,"_21524":54488,"_28264":54489,"_3060":54490},[],"/docs/platform/iot-fleets/enrollment/renewal-and-recovery#prepare-renewal","Prepare renewal",{"_3604":1209,"_31083":1206,"_5":31418,"_21524":54492,"_28264":54493,"_3060":54494},[],"/docs/platform/iot-fleets/enrollment/renewal-and-recovery#request-the-successor-certificate","Request the successor certificate",{"_3604":1210,"_31083":1206,"_5":31418,"_21524":54496,"_28264":54497,"_3060":54498},[],"/docs/platform/iot-fleets/enrollment/renewal-and-recovery#install-and-check-the-new-pair","Install and check the new pair",{"_3604":1211,"_31083":1206,"_5":31418,"_21524":54500,"_28264":54501,"_3060":54502},[],"/docs/platform/iot-fleets/enrollment/renewal-and-recovery#recover-according-to-state","Recover according to state",{"_3604":1212,"_31083":1206,"_5":31418,"_21524":54504,"_28264":54505,"_3060":54506},[],"/docs/platform/iot-fleets/enrollment/renewal-and-recovery#continuous-operation","Continuous operation",{"_3604":1213,"_31083":1206,"_21524":54508,"_5":14790,"_28264":1206,"_3060":54509},[],"Renewal retains the device identifier and requests a successor certificate. The client must complete the process: check the response, install the matching pair and demonstrate that the consumer accepts it. Lamassu alerts notify you; they do not perform those steps.",{"_3604":1214,"_31083":1206,"_21524":54511,"_5":14790,"_28264":54489,"_3060":54512},[],"Query the current certificate in Lamassu and compare it with the installed certificate. You need its subject, serial and dates, as well as the client key.",{"_3604":1215,"_31083":1206,"_21524":54514,"_5":14790,"_28264":54489,"_3060":54515},[],"Check the **re-enrollment** authentication mode: it is independent of initial authentication. With `CLIENT_CERTIFICATE`, use the current identity; do not assume the bootstrap credential is admitted.",{"_3604":1216,"_31083":1206,"_21524":54517,"_5":14790,"_28264":54489,"_3060":54518},[],"Calculate the window's start: the current certificate's `NotAfter` minus `reenrollment_delta`. Preventive and critical thresholds produce states/notifications; they do not extend that window.",{"_3604":1217,"_31083":1206,"_21524":54520,"_5":14790,"_28264":54489,"_3060":54521},[],"Review **Revoke on Re-enrollment** and recovery if installation fails. When enabled, Lamassu can revoke the previous identity before the client installs the new one.",{"_3604":1218,"_31083":1206,"_21524":54523,"_5":14790,"_28264":54493,"_3060":54524},[],"The example continues the EST tutorial, in the same Bash session with `set -euo pipefail`, `umask 077` and `EST_BASE`. Use a new key compatible with the profile. Conversion from the certificate preserves the subject and copies only SAN when present; check the subject and requested names before sending it. The backend checks the subject against the current identity: it attempts RawSubject equality and then compares CN, OU, O, L, ST and C. Rebuilding only the CN can lose required attributes.",{"_3604":1219,"_31083":1206,"_21524":54526,"_5":14790,"_28264":54493,"_3060":54527},[],"The request authenticates with `device.crt` and `device.key`; the CSR contains the new public key. Also check extensions, dates and correspondence of the serial with the current slot in Lamassu. Do not resubmit a failed request without querying that state: issuance, previous revocation and successor binding can have partial results.",{"_3604":1220,"_31083":1206,"_21524":54529,"_5":14790,"_28264":54497,"_3060":54530},[],"Keep the result as `device.next.crt` and `device.next.key` until verified. Switch the pair through a coordinated operation in the device store or configuration; avoid temporarily exposing a certificate with another version's key.",{"_3604":1221,"_31083":1206,"_21524":54532,"_5":14790,"_28264":54497,"_3060":54533},[],"Test mTLS with the consumer and verify that it uses the new serial. Confirm the history and current certificate in Lamassu. If **Revoke on Re-enrollment** was disabled, the previous identity can remain valid: retire it according to PKI policy after testing the successor, and check revocation publication and consumption.",{"_3604":1222,"_31083":1206,"_21524":54535,"_5":14790,"_28264":54497,"_3060":54536},[],"If the previous identity is already revoked, retaining its files does not restore a valid connection. Recovery requires an admitted credential and authorized intervention according to the situation.",{"_3604":1223,"_31083":1206,"_21524":54538,"_5":14790,"_28264":54501,"_3060":54539},[],"Situation",{"_3604":1224,"_31083":1206,"_21524":54541,"_5":14790,"_28264":54501,"_3060":54542},[],"Procedure",{"_3604":1225,"_31083":1206,"_21524":54544,"_5":14790,"_28264":54501,"_3060":54545},[],"Valid certificate, outside the window",{"_3604":1226,"_31083":1206,"_21524":54547,"_5":14790,"_28264":54501,"_3060":54548},[],"Schedule the request within the window. Do not use `simpleenroll` to bypass it.",{"_3604":1227,"_31083":1206,"_21524":54550,"_5":14790,"_28264":54501,"_3060":54551},[],"Expired certificate, key available",{"_3604":1228,"_31083":1206,"_21524":54553,"_5":14790,"_28264":54501,"_3060":54554},[],"With certificate authentication, review `enable_expired_renewal` and whether Gateway permits presenting that credential. Revocation, subject and the remaining checks still apply.",{"_3604":1229,"_31083":1206,"_21524":54556,"_5":14790,"_28264":54501,"_3060":54557},[],"Renewal through webhook or `NO_AUTH`",{"_3604":1230,"_31083":1206,"_21524":54559,"_5":14790,"_28264":54501,"_3060":54560},[],"The mTLS expiry check does not run in these modes. Define expiry and authorization policy in the corresponding admission process; the flag is not a universal prohibition.",{"_3604":1231,"_31083":1206,"_21524":54562,"_5":14790,"_28264":54501,"_3060":54563},[],"Lost or inaccessible key",{"_3604":1232,"_31083":1206,"_21524":54565,"_5":14790,"_28264":54501,"_3060":54566},[],"You cannot prove possession of the previous identity. Authorize new admission and, if appropriate, controlled replacement; revoke the compromised identity.",{"_3604":1233,"_31083":1206,"_21524":54568,"_5":14790,"_28264":54501,"_3060":54569},[],"Current identity revoked",{"_3604":1234,"_31083":1206,"_21524":54571,"_5":14790,"_28264":54501,"_3060":54572},[],"`simplereenroll` rejects the revoked current certificate. Investigate the reason and prepare an authorized readmission procedure; do not disable authentication to force it.",{"_3604":1235,"_31083":1206,"_21524":54574,"_5":14790,"_28264":54501,"_3060":54575},[],"Device without an identity",{"_3604":1236,"_31083":1206,"_21524":54577,"_5":14790,"_28264":54501,"_3060":54578},[],"Use initial enrollment. For an existing entry, check the replacement restriction in provisioning.",{"_3604":1237,"_31083":1206,"_21524":54580,"_5":14790,"_28264":54501,"_3060":54581},[],"Retired device",{"_3604":1238,"_31083":1206,"_21524":54583,"_5":14790,"_28264":54501,"_3060":54584},[],"Review the operational decision before readmission. Decommissioned state and revocation of the entire history are not equivalent.",{"_3604":1239,"_31083":1206,"_21524":54586,"_5":14790,"_28264":54501,"_3060":54587},[],"Timeout, HTTP 500 or installation failure",{"_3604":1240,"_31083":1206,"_21524":54589,"_5":14790,"_28264":54501,"_3060":54590},[],"Inspect the device, issued certificates and history before retrying. A successor may have been issued or the previous identity revoked.",{"_3604":1241,"_31083":1206,"_21524":54592,"_5":14790,"_28264":54505,"_3060":54593},[],"Schedule renewal with time for disconnections, trust distribution and consumer checks. Stagger requests across the population and bound retries within the window; authentication, subject and policy errors require correcting their cause. Maintain an admitted and tested recovery mechanism for lost keys and pairs that could not be installed.",{"_3604":1242,"_31083":1206,"_21524":54595,"_5":14790,"_28264":54505,"_3060":54596},[],"Continue with Trust distribution, Devices and identities and Troubleshooting.",{"_3604":1243,"_31083":1243,"_5":15155,"_3060":54598,"_31421":54599,"_21524":54600,"_28264":1243},"Enrollment troubleshooting",[50730,52242,53414,53412,53598],[],{"_3604":1244,"_31083":1243,"_21524":54602,"_5":14790,"_28264":1243,"_3060":54603},[],"Locate transport, authentication, registration, issuance and installation failures.",{"_3604":1245,"_31083":1243,"_5":31418,"_21524":54605,"_28264":54606,"_3060":54607},[],"/docs/platform/iot-fleets/enrollment/troubleshooting#diagnostics-and-compatibility","Diagnostics and compatibility",{"_3604":1246,"_31083":1243,"_5":31418,"_21524":54609,"_28264":54610,"_3060":54611},[],"/docs/platform/iot-fleets/enrollment/troubleshooting#error-codes-and-diagnostics","Error codes and diagnostics",{"_3604":1247,"_31083":1243,"_5":31418,"_21524":54613,"_28264":54614,"_3060":54161},[],"/docs/platform/iot-fleets/enrollment/troubleshooting#compatibility-notes",{"_3604":1248,"_31083":1243,"_5":31418,"_21524":54616,"_28264":54617,"_3060":54618},[],"/docs/platform/iot-fleets/enrollment/troubleshooting#est-enrollment-fails","EST enrollment fails",{"_3604":1249,"_31083":1243,"_21524":54620,"_5":14790,"_28264":1243,"_3060":54621},[],"Diagnose one operation and device at a time. Record the DMS/APS, endpoint, time, HTTP code, presented serial and CSR CN. Retain the response without including private keys or webhook credentials in the report.",{"_3604":1250,"_31083":1243,"_21524":54623,"_5":14790,"_28264":54610,"_3060":54624},[],"The EST controller normally returns 400 when rejecting input and 500 when the service rejects or fails the operation. A 500 can also represent a policy denial; it does not mean retrying is safe. Gateway can produce its own codes and bodies. Examine the actual body and persisted result.",{"_3604":1251,"_31083":1243,"_21524":54626,"_5":14790,"_28264":54610,"_3060":54627},[],"Symptom or message",{"_3604":1252,"_31083":1243,"_21524":54629,"_5":14790,"_28264":54610,"_3060":54391},[],{"_3604":1253,"_31083":1243,"_21524":54631,"_5":14790,"_28264":54610,"_3060":54632},[],"curl rejects TLS, name or issuer",{"_3604":1254,"_31083":1243,"_21524":54634,"_5":14790,"_28264":54610,"_3060":54635},[],"URL, clock, server SAN and approved root in `est-trust.pem`. Resolve trust in Deployment; do not skip verification.",{"_3604":1255,"_31083":1243,"_21524":54637,"_5":14790,"_28264":54610,"_3060":54638},[],"404 or missing APS",{"_3604":1256,"_31083":1243,"_21524":54640,"_5":14790,"_28264":54610,"_3060":54641},[],"Public route `/.well-known/est/{DMS_ID}/{operation}` and existing DMS. APS is not the service name.",{"_3604":1257,"_31083":1243,"_21524":54643,"_5":14790,"_28264":54610,"_3060":54644},[],"400, CSR or format error",{"_3604":1258,"_31083":1243,"_21524":54646,"_5":14790,"_28264":54610,"_3060":54647},[],"`Content-Type: application/pkcs10`, Base64 of DER, valid signature and a body preserved without double encoding.",{"_3604":1259,"_31083":1243,"_21524":54649,"_5":14790,"_28264":54610,"_3060":54650},[],"Missing credential or invalid certificate",{"_3604":1260,"_31083":1243,"_21524":54652,"_5":14790,"_28264":54610,"_3060":54653},[],"Operation mode, validating CA, dates, revocation and credential delivery by Gateway. Do not confuse server TLS trust with the bootstrap CA.",{"_3604":1261,"_31083":1243,"_21524":54655,"_5":14790,"_28264":54610,"_3060":54656},[],"Webhook denies, times out or responds without authorization",{"_3604":1262,"_31083":1243,"_21524":54658,"_5":14790,"_28264":54610,"_3060":54659},[],"Configuration, connectivity and JSON response with `authorized: true`. There is no automatic fallback to `NO_AUTH`.",{"_3604":1263,"_31083":1243,"_21524":54661,"_5":14790,"_28264":54610,"_3060":54662},[],"`unexpected status code: <n>: redirects are not followed`",{"_3604":1264,"_31083":1243,"_21524":54664,"_5":14790,"_28264":54610,"_3060":54665},[],"The webhook answered with a redirect. Configure the final absolute `http` or `https` URL in the webhook config; redirects are never followed.",{"_3604":1265,"_31083":1243,"_21524":54667,"_5":14790,"_28264":54610,"_3060":54668},[],"`webhook response exceeds 1048576 bytes`",{"_3604":1266,"_31083":1243,"_21524":54670,"_5":14790,"_28264":54610,"_3060":54671},[],"The receiver returned more than 1 MiB of JSON. Reduce the response of the authorization webhook.",{"_3604":1267,"_31083":1243,"_21524":54673,"_5":14790,"_28264":54610,"_3060":54674},[],"`webhook config must not reference files`",{"_3604":1268,"_31083":1243,"_21524":54676,"_5":14790,"_28264":54610,"_3060":54677},[],"The webhook config points to files (`ca_cert_file`, `mtls_options.cert_file`, `mtls_options.key_file`). For mTLS, enter the certificate and key as Base64-encoded PEM in `cert_content` and `key_content`, or as plain PEM; remove any other file field, including `ca_cert_file`, which has no inline equivalent (the receiver certificate must chain to the system trust store). See the webhook credentials guidance in DMS.",{"_3604":1269,"_31083":1243,"_21524":54679,"_5":14790,"_28264":54610,"_3060":54680},[],"`mtls_options.cert_content must be base64-encoded PEM`",{"_3604":1270,"_31083":1243,"_21524":54682,"_5":14790,"_28264":54610,"_3060":54683},[],"The value is neither Base64-encoded PEM nor plain PEM: it is a file path or Base64 of non-PEM data. Enter the certificate and key as Base64-encoded PEM, like certificates elsewhere in the API, or as plain PEM (see the webhook settings in DMS). The same message names `mtls_options.key_content` when the key is the offending value.",{"_3604":1271,"_31083":1243,"_21524":54685,"_5":14790,"_28264":54610,"_3060":54686},[],"`webhook mTLS certificate and key are invalid: …`",{"_3604":1272,"_31083":1243,"_21524":54688,"_5":14790,"_28264":54610,"_3060":54689},[],"The certificate and key do not form a matching pair. Enter both values from the same pair; the check runs when the DMS is saved and again on every webhook call.",{"_3604":1273,"_31083":1243,"_21524":54691,"_5":14790,"_28264":54610,"_3060":54692},[],"400 `struct validation error` creating or updating a DMS",{"_3604":1274,"_31083":1243,"_21524":54694,"_5":14790,"_28264":54610,"_3060":54695},[],"The webhook config of the operation that uses it is invalid. Review `external_webhook_settings` in DMS.",{"_3604":1275,"_31083":1243,"_21524":54697,"_5":14790,"_28264":54610,"_3060":54698},[],"HTTP 500 with an `err` body on enroll or reenroll",{"_3604":1276,"_31083":1243,"_21524":54700,"_5":14790,"_28264":54610,"_3060":54701},[],"Service failures reach the EST client as 500 with a body of `err` plus the message; webhook authorization errors are named there.",{"_3604":1277,"_31083":1243,"_21524":54703,"_5":14790,"_28264":54610,"_3060":54704},[],"`device not preregistered`",{"_3604":1278,"_31083":1243,"_21524":54706,"_5":14790,"_28264":54610,"_3060":54707},[],"PRE\\_REGISTRATION requires an existing inventory entry.",{"_3604":1279,"_31083":1243,"_21524":54709,"_5":14790,"_28264":54610,"_3060":54710},[],"`forbiddenNewEnrollment`",{"_3604":1280,"_31083":1243,"_21524":54712,"_5":14790,"_28264":54610,"_3060":54713},[],"An existing device requires replacement to be enabled, even in No Identity. Investigate before enabling the flag.",{"_3604":1281,"_31083":1243,"_21524":54715,"_5":14790,"_28264":54610,"_3060":54716},[],"Different owning DMS",{"_3604":1282,"_31083":1243,"_21524":54718,"_5":14790,"_28264":54610,"_3060":54719},[],"CN/ID, global inventory and owning DMS; do not reuse an ID from another context.",{"_3604":1283,"_31083":1243,"_21524":54721,"_5":14790,"_28264":54610,"_3060":54722},[],"`invalid RawSubject bytes`",{"_3604":1284,"_31083":1243,"_21524":54724,"_5":14790,"_28264":54610,"_3060":54725},[],"CSR subject versus the current certificate. Preserve its attributes as well as its CN.",{"_3604":1285,"_31083":1243,"_21524":54727,"_5":14790,"_28264":54610,"_3060":54728},[],"`invalid reenroll window`",{"_3604":1286,"_31083":1243,"_21524":54730,"_5":14790,"_28264":54610,"_3060":54731},[],"Current identity's NotAfter and reenrollment\\_delta. Alert thresholds do not change that window.",{"_3604":1287,"_31083":1243,"_21524":54733,"_5":14790,"_28264":54610,"_3060":54734},[],"Current certificate revoked",{"_3604":1288,"_31083":1243,"_21524":54736,"_5":14790,"_28264":54610,"_3060":54737},[],"Renewal rejected; prepare authorized recovery according to the cause.",{"_3604":1289,"_31083":1243,"_21524":54739,"_5":14790,"_28264":54610,"_3060":54740},[],"CA, profile or signing error",{"_3604":1290,"_31083":1243,"_21524":54742,"_5":14790,"_28264":54610,"_3060":54743},[],"Active CA, available key, selected profile and restrictions. Successful cacerts does not prove issuance.",{"_3604":1291,"_31083":1243,"_21524":54745,"_5":14790,"_28264":54610,"_3060":54746},[],"HTTP 200 without a device connection",{"_3604":1292,"_31083":1243,"_21524":54748,"_5":14790,"_28264":54610,"_3060":54749},[],"Installed pair, chain, uses, consumer trust and permissions. Also check the slot and history.",{"_3604":1293,"_31083":1243,"_21524":54751,"_5":14790,"_28264":54610,"_3060":54752},[],"Timeout or error after issuance",{"_3604":1294,"_31083":1243,"_21524":54754,"_5":14790,"_28264":54610,"_3060":54755},[],"New certificates, current slot and previous identity's state before retrying.",{"_3604":1295,"_31083":1243,"_21524":54757,"_5":14790,"_28264":54614,"_3060":54758},[],"The examples use the contract of the examined backend. Do not automatically attribute that behavior to another release. Check the saved renewal mode and Gateway behavior with expired certificates and the bootstrap CA.",{"_3604":1296,"_31083":1243,"_21524":54760,"_5":14790,"_28264":54614,"_3060":54761},[],"The default response is Base64-encoded DER PKCS#7; PEM through `Accept: application/x-pem-file` is a Lamassu extension. ServerKeyGen returns multipart and requires handling each part separately. See the EST reference.",{"_3604":1297,"_31083":1243,"_21524":54763,"_5":14790,"_28264":54617,"_3060":54764},[],"Check HTTPS with the approved root and query cacerts for the correct APS.",{"_3604":1298,"_31083":1243,"_21524":54766,"_5":14790,"_28264":54617,"_3060":54767},[],"Review the saved DMS: protocol, registration, authentication for that operation, CA, profile and window.",{"_3604":1299,"_31083":1243,"_21524":54769,"_5":14790,"_28264":54617,"_3060":54770},[],"Verify the CSR locally and relate its CN to the inventory.",{"_3604":1300,"_31083":1243,"_21524":54772,"_5":14790,"_28264":54617,"_3060":54773},[],"Make one request, save headers/body and query the device and certificates.",{"_3604":1301,"_31083":1243,"_21524":54775,"_5":14790,"_28264":54617,"_3060":54776},[],"If you receive an identity, check the key, subject, use and connection with the consumer.",{"_3604":1302,"_31083":1243,"_21524":54778,"_5":14790,"_28264":54617,"_3060":54779},[],"External bootstrap revocation checks have limitations: absence of evidence can be accepted, and OCSP Unknown does not cause the same rejection as Revoked. Do not assume a policy that rejects every uncertainty. An intermediate CA in the TLS chain does not prove that the entire chain reached the DMS validator either.",{"_3604":1303,"_31083":1243,"_21524":54781,"_5":14790,"_28264":54617,"_3060":54782},[],"For logs, networking, pods or Gateway headers, continue in Deployment troubleshooting. For identities issued, revoked or bound partially, use Renewal and recovery and Devices and identities.",{"_3604":1304,"_31083":1304,"_5":15155,"_3060":54784,"_31421":54785,"_21524":54786,"_28264":1304},"Trust distribution and updates",[50730,52242,53414,53412,53598],[],{"_3604":1305,"_31083":1304,"_21524":54788,"_5":14790,"_28264":1304,"_3060":54789},[],"Separate roots, intermediates and initial TLS trust when distributing or migrating certificates.",{"_3604":1306,"_31083":1304,"_5":31418,"_21524":54791,"_28264":54792,"_3060":54793},[],"/docs/platform/iot-fleets/enrollment/trust-distribution#three-trust-relationships","Three trust relationships",{"_3604":1307,"_31083":1304,"_5":31418,"_21524":54795,"_28264":54796,"_3060":54797},[],"/docs/platform/iot-fleets/enrollment/trust-distribution#what-cacerts-returns","What cacerts returns",{"_3604":1308,"_31083":1304,"_5":31418,"_21524":54799,"_28264":54800,"_3060":54801},[],"/docs/platform/iot-fleets/enrollment/trust-distribution#install-the-required-material","Install the required material",{"_3604":1309,"_31083":1304,"_5":31418,"_21524":54803,"_28264":54804,"_3060":54805},[],"/docs/platform/iot-fleets/enrollment/trust-distribution#migrate-trust","Migrate trust",{"_3604":1310,"_31083":1304,"_5":31418,"_21524":54807,"_28264":54808,"_3060":54809},[],"/docs/platform/iot-fleets/enrollment/trust-distribution#check-the-update","Check the update",{"_3604":1311,"_31083":1304,"_21524":54811,"_5":14790,"_28264":1304,"_3060":54812},[],"This guide is for device and consumer trust administrators. You need issuer inventory, trust-store access and an authenticated update channel. Distributing certificates is separate from choosing trusted anchors.",{"_3604":1312,"_31083":1304,"_21524":54814,"_5":14790,"_28264":54792,"_3060":54815},[],"Relationship",{"_3604":1313,"_31083":1304,"_21524":54817,"_5":14790,"_28264":54792,"_3060":54818},[],"Material prepared by its owner",{"_3604":1314,"_31083":1304,"_21524":54820,"_5":14790,"_28264":54792,"_3060":54821},[],"Device → EST server",{"_3604":1315,"_31083":1304,"_21524":54823,"_5":14790,"_28264":54792,"_3060":54824},[],"Previously verified server root, chain or pin and TLS name.",{"_3604":1316,"_31083":1304,"_21524":54826,"_5":14790,"_28264":54792,"_3060":54827},[],"DMS → requester",{"_3604":1317,"_31083":1304,"_21524":54829,"_5":14790,"_28264":54792,"_3060":54830},[],"CAs and rules authorizing initial or renewal credentials.",{"_3604":1318,"_31083":1304,"_21524":54832,"_5":14790,"_28264":54792,"_3060":54833},[],"Consumer → device",{"_3604":1319,"_31083":1304,"_21524":54835,"_5":14790,"_28264":54792,"_3060":54836},[],"Operational identity roots, intermediates, validation and permissions.",{"_3604":1320,"_31083":1304,"_21524":54838,"_5":14790,"_28264":54792,"_3060":54839},[],"Obtaining a certificate does not automatically configure these relationships in third parties. Review the Trust model.",{"_3604":1321,"_31083":1304,"_21524":54841,"_5":14790,"_28264":54796,"_3060":54842},[],"The DMS may include the available downstream TLS certificate, selected Managed CAs and enrollment CA. Selecting the issuer does not include every ancestor. The set may contain leaves, roots and intermediates, including multiple hierarchies during migration.",{"_3604":1322,"_31083":1304,"_21524":54844,"_5":14790,"_28264":54796,"_3060":54845},[],"Position does not define the chain. Identify certificates by subject, issuer, AKI/SKI, signature and constraints. Download and inspect using EST client.",{"_3604":1323,"_31083":1304,"_21524":54847,"_5":14790,"_28264":54800,"_3060":54848},[],"Keep initial EST server trust separate from identity consumer trust.",{"_3604":1324,"_31083":1304,"_21524":54850,"_5":14790,"_28264":54800,"_3060":54851},[],"Select policy-approved roots as anchors.",{"_3604":1325,"_31083":1304,"_21524":54853,"_5":14790,"_28264":54800,"_3060":54854},[],"Retain intermediates for chain building or presentation; do not automatically turn them into roots.",{"_3604":1326,"_31083":1304,"_21524":54856,"_5":14790,"_28264":54800,"_3060":54857},[],"Present the leaf and required intermediates in mTLS. Normally the peer already trusts its root and does not need it sent.",{"_3604":1327,"_31083":1304,"_21524":54859,"_5":14790,"_28264":54800,"_3060":54860},[],"Verify chain, dates, names, usages and revocation from the consumer.",{"_3604":1328,"_31083":1304,"_21524":54862,"_5":14790,"_28264":54800,"_3060":54863},[],"Do not indiscriminately use all of `cacerts.pem` as `-CAfile`: this can expand trusted authorities, hide missing intermediates or trust a TLS leaf intended for another purpose.",{"_3604":1329,"_31083":1304,"_21524":54865,"_5":14790,"_28264":54804,"_3060":54866},[],"Before changing Enrollment CA, inventory disconnected equipment, bootstrap and operational certificates, and consumers. Distribute the new root and required intermediates; check that a cohort accepts both old and new chains.",{"_3604":1330,"_31083":1304,"_21524":54868,"_5":14790,"_28264":54804,"_3060":54869},[],"In the DMS, separate distributed CAs from the re-enrollment validation CAs at `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`, used for re-enrollment credentials. That list is optional because the enrollment CA always validates re-enrollment credentials, but when switching the enrollment CA, add the previous issuance CA to it so old-CA identities keep re-enrolling during overlap. The inspected validator tries the enrollment CA followed by those CAs against the received leaf; accepting a multilevel chain requires checking what reaches the service and which issuer is configured.",{"_3604":1331,"_31083":1304,"_21524":54871,"_5":14790,"_28264":54804,"_3060":54872},[],"Switch issuance, renew in cohorts and compare the installed serial with the active slot. Remove previous trust once no legitimate equipment needs it and policy permits ending overlap. Follow Hierarchy and rotation for the PKI operation.",{"_3604":1332,"_31083":1304,"_21524":54874,"_5":14790,"_28264":54808,"_3060":54875},[],"Test an old identity allowed during overlap, a new one, an unknown chain and the result after removing old trust. Keep trust-store version, approved set, date and result. Reachable `/cacerts` establishes distribution only; it does not establish installation or acceptance across every device.",{"_3604":1333,"_31083":1333,"_5":15155,"_3060":54877,"_31421":54878,"_21524":54880,"_28264":1333},"AWS IoT Core",[50730,52242,53414,53412,54879],"Integrations",[],{"_3604":1334,"_31083":1333,"_21524":54882,"_5":14790,"_28264":1333,"_3060":54883},[],"Lamassu's connector for AWS IoT Core syncs device identities with the AWS platform, handling CA registration, Thing provisioning and certificate lifecycle automatically and event-driven.",{"_3604":1335,"_31083":1333,"_5":31418,"_21524":54885,"_28264":54886,"_3060":54887},[],"/docs/platform/iot-fleets/integrations/aws-iot-core#connector-architecture","Connector architecture",{"_3604":1336,"_31083":1333,"_5":31418,"_21524":54889,"_28264":54890,"_3060":54891},[],"/docs/platform/iot-fleets/integrations/aws-iot-core#prerequisites","Prerequisites",{"_3604":1337,"_31083":1333,"_5":31418,"_21524":54893,"_28264":54894,"_3060":54895},[],"/docs/platform/iot-fleets/integrations/aws-iot-core#required-iam-permissions","Required IAM permissions",{"_3604":1338,"_31083":1333,"_5":31418,"_21524":54897,"_28264":54898,"_3060":54899},[],"/docs/platform/iot-fleets/integrations/aws-iot-core#configuration-parameters","Configuration parameters",{"_3604":1339,"_31083":1333,"_5":31418,"_21524":54901,"_28264":54902,"_3060":54903},[],"/docs/platform/iot-fleets/integrations/aws-iot-core#events-and-aws-resources","Events and AWS resources",{"_3604":1340,"_31083":1333,"_5":31418,"_21524":54905,"_28264":54906,"_3060":54907},[],"/docs/platform/iot-fleets/integrations/aws-iot-core#ca-registration-in-aws-iot-core","CA registration in AWS IoT Core",{"_3604":1341,"_31083":1333,"_5":31418,"_21524":54909,"_28264":54910,"_3060":54911},[],"/docs/platform/iot-fleets/integrations/aws-iot-core#how-to-request-registration","How to request registration",{"_3604":1342,"_31083":1333,"_5":31418,"_21524":54913,"_28264":54914,"_3060":54915},[],"/docs/platform/iot-fleets/integrations/aws-iot-core#ca-registration-states","CA registration states",{"_3604":1343,"_31083":1333,"_5":31418,"_21524":54917,"_28264":54918,"_3060":54919},[],"/docs/platform/iot-fleets/integrations/aws-iot-core#primary-account","Primary Account",{"_3604":1344,"_31083":1333,"_5":31418,"_21524":54921,"_28264":54922,"_3060":54923},[],"/docs/platform/iot-fleets/integrations/aws-iot-core#secondary-account-sni-only","Secondary Account (SNI-only)",{"_3604":1345,"_31083":1333,"_5":31418,"_21524":54925,"_28264":54926,"_3060":54927},[],"/docs/platform/iot-fleets/integrations/aws-iot-core#dms-configuration","DMS configuration",{"_3604":1346,"_31083":1333,"_5":31418,"_21524":54929,"_28264":54930,"_3060":54931},[],"/docs/platform/iot-fleets/integrations/aws-iot-core#none-mode","`none` mode",{"_3604":1347,"_31083":1333,"_5":31418,"_21524":54933,"_28264":54934,"_3060":54935},[],"/docs/platform/iot-fleets/integrations/aws-iot-core#auto-mode","`auto` mode",{"_3604":1348,"_31083":1333,"_5":31418,"_21524":54937,"_28264":54938,"_3060":54939},[],"/docs/platform/iot-fleets/integrations/aws-iot-core#jitp-mode","`jitp` mode",{"_3604":1349,"_31083":1333,"_5":31418,"_21524":54941,"_28264":54942,"_3060":54943},[],"/docs/platform/iot-fleets/integrations/aws-iot-core#dms-registration-mode-states","DMS registration-mode states",{"_3604":1350,"_31083":1333,"_5":31418,"_21524":54945,"_28264":54946,"_3060":54947},[],"/docs/platform/iot-fleets/integrations/aws-iot-core#device-provisioning-automatic-mode","Device provisioning (automatic mode)",{"_3604":1351,"_31083":1333,"_5":31418,"_21524":54949,"_28264":54950,"_3060":54951},[],"/docs/platform/iot-fleets/integrations/aws-iot-core#thing-lifecycle","Thing lifecycle",{"_3604":1352,"_31083":1333,"_5":31418,"_21524":54953,"_28264":54954,"_3060":54955},[],"/docs/platform/iot-fleets/integrations/aws-iot-core#device-provisioning-jitp-mode","Device provisioning (JITP mode)",{"_3604":1353,"_31083":1333,"_5":31418,"_21524":54957,"_28264":54958,"_3060":54959},[],"/docs/platform/iot-fleets/integrations/aws-iot-core#certificate-status-synchronization","Certificate status synchronization",{"_3604":1354,"_31083":1333,"_5":31418,"_21524":54961,"_28264":54962,"_3060":54963},[],"/docs/platform/iot-fleets/integrations/aws-iot-core#certificate-status-states","Certificate status states",{"_3604":1355,"_31083":1333,"_5":31418,"_21524":54965,"_28264":54966,"_3060":54967},[],"/docs/platform/iot-fleets/integrations/aws-iot-core#forced-disconnect-on-revocation","Forced disconnect on revocation",{"_3604":1356,"_31083":1333,"_5":31418,"_21524":54969,"_28264":54970,"_3060":54971},[],"/docs/platform/iot-fleets/integrations/aws-iot-core#device-shadow-and-automation","Device Shadow and automation",{"_3604":1357,"_31083":1333,"_5":31418,"_21524":54973,"_28264":54974,"_3060":54975},[],"/docs/platform/iot-fleets/integrations/aws-iot-core#what-the-connector-writes-to-the-shadow","What the connector writes to the shadow",{"_3604":1358,"_31083":1333,"_5":31418,"_21524":54977,"_28264":54978,"_3060":54979},[],"/docs/platform/iot-fleets/integrations/aws-iot-core#aws-iot-policies","AWS IoT policies",{"_3604":1359,"_31083":1333,"_5":31418,"_21524":54981,"_28264":54982,"_3060":54983},[],"/docs/platform/iot-fleets/integrations/aws-iot-core#troubleshooting","Troubleshooting",{"_3604":1360,"_31083":1333,"_21524":54985,"_5":14790,"_28264":1333,"_3060":54986},[],"Lamassu's integration with AWS IoT Core bridges the PKI managed by Lamassu and AWS's connectivity platform. When a device obtains its certificate through the EST enrollment process, the connector ensures that certificate and its associated identity are recognized in AWS IoT Core without manual intervention. The result is that the device can authenticate directly to AWS with the same X.509 certificate Lamassu issued.",{"_3604":1361,"_31083":1333,"_21524":54988,"_5":14790,"_28264":1333,"_3060":54989},[],"From a protocol standpoint, the device authenticates to AWS IoT Core via mutual TLS (mTLS): it presents its Lamassu-issued X.509 certificate as the client certificate, and AWS IoT Core verifies the certificate chain up to the CA registered in the account. Lamassu acts as the certification authority (CA); the connector ensures that CA is registered in AWS and that the device's certificate is known to the platform before the device attempts to connect (in `auto` mode) or on its first connection (in JITP mode).",{"_3604":1362,"_31083":1333,"_21524":54991,"_5":14790,"_28264":1333,"_3060":54992},[],"This document is aimed both at the PKI administrator, who needs to configure the connector and register CAs, and at the device firmware developer, who needs to understand how Things are named, how the Device Shadow works and what happens when a certificate is revoked. For the firmware developer, the most important fact is that **the AWS Thing name (ThingName) always corresponds to the Common Name (CN) of the certificate issued by Lamassu**, regardless of the provisioning mode.",{"_3604":1363,"_31083":1333,"_21524":54994,"_5":14790,"_28264":54886,"_3060":54995},[],"The AWS IoT Core connector is an independent Go process, a binary or container separate from Lamassu's core. In a monolithic deployment it is compiled by default (build tag `!noaws`) and activated with `aws_iot_manager.enabled: true` in the configuration file. In distributed deployments, it runs as its own container with access to Lamassu's CA, DMS Manager and Device Manager services over HTTP.",{"_3604":1364,"_31083":1333,"_21524":54997,"_5":14790,"_28264":54886,"_3060":54998},[],"The connector does not poll Lamassu's services periodically. Instead, it **subscribes to Lamassu's internal event bus** (AMQP or AWS SQS/SNS, configurable) and reacts to the events it cares about: CA creation or update, DMS creation or update, device identity binding, certificate status change, certificate metadata update and device metadata update. This event-driven model ensures synchronization with AWS is nearly immediate and produces no polling load.",{"_3604":1365,"_31083":1333,"_21524":55000,"_5":14790,"_28264":54886,"_3060":55001},[],"To avoid infinite loops, the connector ignores any event whose CloudEvent `source` field matches its own origin URI. This prevents the metadata writes the connector itself performs from re-triggering the same flow.",{"_3604":1366,"_31083":1333,"_21524":55003,"_5":14790,"_28264":54886,"_3060":55004},[],"When several connectors run in parallel, for example for different AWS accounts, each instance has its own `connector_id`. All metadata the connector writes to Lamassu is stored under the key `lamassu.io/iot/{connector_id}`, allowing coexistence without collisions.",{"_3604":1367,"_31083":1333,"_21524":55006,"_5":14790,"_28264":54890,"_3060":55007},[],"Before enabling the connector you need an AWS account with the proper IAM permissions and the connector correctly configured. The deployment process (Docker Compose, Kubernetes or binary) is described in the deployment documentation.",{"_3604":1368,"_31083":1333,"_21524":55009,"_5":14790,"_28264":54894,"_3060":55010},[],"The IAM identity operating the connector needs at minimum the following permissions on the target account's resources:",{"_3604":1369,"_31083":1333,"_21524":55012,"_5":14790,"_28264":54894,"_3060":55013},[],"IAM action",{"_3604":1370,"_31083":1333,"_21524":55015,"_5":14790,"_28264":54894,"_3060":51120},[],{"_3604":1371,"_31083":1333,"_21524":55017,"_5":14790,"_28264":54894,"_3060":55018},[],"`iot:GetRegistrationCode`",{"_3604":1372,"_31083":1333,"_21524":55020,"_5":14790,"_28264":54894,"_3060":55021},[],"Obtain the verification code for CA registration in the Primary Account",{"_3604":1373,"_31083":1333,"_21524":55023,"_5":14790,"_28264":54894,"_3060":55024},[],"`iot:RegisterCACertificate`",{"_3604":1374,"_31083":1333,"_21524":55026,"_5":14790,"_28264":54894,"_3060":55027},[],"Register the CA in AWS IoT",{"_3604":1375,"_31083":1333,"_21524":55029,"_5":14790,"_28264":54894,"_3060":55030},[],"`iot:DescribeCACertificate`",{"_3604":1376,"_31083":1333,"_21524":55032,"_5":14790,"_28264":54894,"_3060":55033},[],"Check the CA registration status",{"_3604":1377,"_31083":1333,"_21524":55035,"_5":14790,"_28264":54894,"_3060":55036},[],"`iot:CreateThing` / `iot:UpdateThing`",{"_3604":1378,"_31083":1333,"_21524":55038,"_5":14790,"_28264":54894,"_3060":55039},[],"Create or update Things in IoT Core",{"_3604":1379,"_31083":1333,"_21524":55041,"_5":14790,"_28264":54894,"_3060":55042},[],"`iot:RegisterThing`",{"_3604":1380,"_31083":1333,"_21524":55044,"_5":14790,"_28264":54894,"_3060":55045},[],"Provision Things through a template",{"_3604":1381,"_31083":1333,"_21524":55047,"_5":14790,"_28264":54894,"_3060":55048},[],"`iot:RegisterCertificate`",{"_3604":1382,"_31083":1333,"_21524":55050,"_5":14790,"_28264":54894,"_3060":55051},[],"Register device certificates",{"_3604":1383,"_31083":1333,"_21524":55053,"_5":14790,"_28264":54894,"_3060":55054},[],"`iot:UpdateCertificate`",{"_3604":1384,"_31083":1333,"_21524":55056,"_5":14790,"_28264":54894,"_3060":55057},[],"Change a certificate's status (ACTIVE / INACTIVE / REVOKED)",{"_3604":1385,"_31083":1333,"_21524":55059,"_5":14790,"_28264":54894,"_3060":55060},[],"`iot:CreatePolicy` / `iot:AttachPolicy`",{"_3604":1386,"_31083":1333,"_21524":55062,"_5":14790,"_28264":54894,"_3060":55063},[],"Create and attach IoT policies",{"_3604":1387,"_31083":1333,"_21524":55065,"_5":14790,"_28264":54894,"_3060":55066},[],"`iot:CreateThingGroup` / `iot:AddThingToThingGroup`",{"_3604":1388,"_31083":1333,"_21524":55068,"_5":14790,"_28264":54894,"_3060":55069},[],"Manage Thing groups",{"_3604":1389,"_31083":1333,"_21524":55071,"_5":14790,"_28264":54894,"_3060":55072},[],"`iot:CreateProvisioningTemplate`",{"_3604":1390,"_31083":1333,"_21524":55074,"_5":14790,"_28264":54894,"_3060":55075},[],"Create JITP templates",{"_3604":1391,"_31083":1333,"_21524":55077,"_5":14790,"_28264":54894,"_3060":55078},[],"`iotdata:GetThingShadow` / `iotdata:UpdateThingShadow`",{"_3604":1392,"_31083":1333,"_21524":55080,"_5":14790,"_28264":54894,"_3060":55081},[],"Read and write the Device Shadow",{"_3604":1393,"_31083":1333,"_21524":55083,"_5":14790,"_28264":54894,"_3060":55084},[],"The forced-disconnect mechanism after revocation also requires access to the AWS IoT data plane API (`iot:Connect` with SigV4 over WebSocket), negotiated implicitly with the connector's credentials.",{"_3604":1394,"_31083":1333,"_21524":55086,"_5":14790,"_28264":54898,"_3060":55087},[],"Parameter",{"_3604":1395,"_31083":1333,"_21524":55089,"_5":14790,"_28264":54898,"_3060":55090},[],"Type",{"_3604":1396,"_31083":1333,"_21524":55092,"_5":14790,"_28264":54898,"_3060":55093},[],"Required",{"_3604":1397,"_31083":1333,"_21524":55095,"_5":14790,"_28264":54898,"_3060":55096},[],"Description",{"_3604":1398,"_31083":1333,"_21524":55098,"_5":14790,"_28264":54898,"_3060":55099},[],"`connector_id`",{"_3604":1399,"_31083":1333,"_21524":55101,"_5":14790,"_28264":54898,"_3060":25699},[],{"_3604":1400,"_31083":1333,"_21524":55103,"_5":14790,"_28264":54898,"_3060":55104},[],"Yes",{"_3604":1401,"_31083":1333,"_21524":55106,"_5":14790,"_28264":54898,"_3060":55107},[],"Unique identifier of this connector instance. Used as the metadata namespace: `lamassu.io/iot/{connector_id}`.",{"_3604":1402,"_31083":1333,"_21524":55109,"_5":14790,"_28264":54898,"_3060":55110},[],"`aws_config.region`",{"_3604":1403,"_31083":1333,"_21524":55112,"_5":14790,"_28264":54898,"_3060":25699},[],{"_3604":1404,"_31083":1333,"_21524":55114,"_5":14790,"_28264":54898,"_3060":55104},[],{"_3604":1405,"_31083":1333,"_21524":55116,"_5":14790,"_28264":54898,"_3060":55117},[],"AWS region where the connector operates.",{"_3604":1406,"_31083":1333,"_21524":55119,"_5":14790,"_28264":54898,"_3060":55120},[],"`aws_config.auth_method`",{"_3604":1407,"_31083":1333,"_21524":55122,"_5":14790,"_28264":54898,"_3060":25699},[],{"_3604":1408,"_31083":1333,"_21524":55124,"_5":14790,"_28264":54898,"_3060":55104},[],{"_3604":1409,"_31083":1333,"_21524":55126,"_5":14790,"_28264":54898,"_3060":55127},[],"Authentication method: `static`, `role` or empty (SDK default credential chain).",{"_3604":1410,"_31083":1333,"_21524":55129,"_5":14790,"_28264":54898,"_3060":55130},[],"`aws_config.access_key_id`",{"_3604":1411,"_31083":1333,"_21524":55132,"_5":14790,"_28264":54898,"_3060":25699},[],{"_3604":1412,"_31083":1333,"_21524":55134,"_5":14790,"_28264":54898,"_3060":55135},[],"Only with `auth_method=static`",{"_3604":1413,"_31083":1333,"_21524":55137,"_5":14790,"_28264":54898,"_3060":55138},[],"AWS access key.",{"_3604":1414,"_31083":1333,"_21524":55140,"_5":14790,"_28264":54898,"_3060":55141},[],"`aws_config.secret_access_key`",{"_3604":1415,"_31083":1333,"_21524":55143,"_5":14790,"_28264":54898,"_3060":25699},[],{"_3604":1416,"_31083":1333,"_21524":55145,"_5":14790,"_28264":54898,"_3060":55135},[],{"_3604":1417,"_31083":1333,"_21524":55147,"_5":14790,"_28264":54898,"_3060":55148},[],"AWS secret key.",{"_3604":1418,"_31083":1333,"_21524":55150,"_5":14790,"_28264":54898,"_3060":55151},[],"`aws_config.session_token`",{"_3604":1419,"_31083":1333,"_21524":55153,"_5":14790,"_28264":54898,"_3060":25699},[],{"_3604":1420,"_31083":1333,"_21524":55155,"_5":14790,"_28264":54898,"_3060":55156},[],"No",{"_3604":1421,"_31083":1333,"_21524":55158,"_5":14790,"_28264":54898,"_3060":55159},[],"Session token (with `auth_method=static`).",{"_3604":1422,"_31083":1333,"_21524":55161,"_5":14790,"_28264":54898,"_3060":55162},[],"`aws_config.role_arn`",{"_3604":1423,"_31083":1333,"_21524":55164,"_5":14790,"_28264":54898,"_3060":25699},[],{"_3604":1424,"_31083":1333,"_21524":55166,"_5":14790,"_28264":54898,"_3060":55167},[],"Only with `auth_method=role`",{"_3604":1425,"_31083":1333,"_21524":55169,"_5":14790,"_28264":54898,"_3060":55170},[],"ARN of the role to assume.",{"_3604":1426,"_31083":1333,"_21524":55172,"_5":14790,"_28264":54898,"_3060":55173},[],"`aws_config.endpoint_url`",{"_3604":1427,"_31083":1333,"_21524":55175,"_5":14790,"_28264":54898,"_3060":25699},[],{"_3604":1428,"_31083":1333,"_21524":55177,"_5":14790,"_28264":54898,"_3060":55156},[],{"_3604":1429,"_31083":1333,"_21524":55179,"_5":14790,"_28264":54898,"_3060":55180},[],"Alternative URL for all AWS services (useful with LocalStack in tests).",{"_3604":1430,"_31083":1333,"_21524":55182,"_5":14790,"_28264":54898,"_3060":55183},[],"`subscriber_event_bus`",{"_3604":1431,"_31083":1333,"_21524":55185,"_5":14790,"_28264":54898,"_3060":18125},[],{"_3604":1432,"_31083":1333,"_21524":55187,"_5":14790,"_28264":54898,"_3060":55104},[],{"_3604":1433,"_31083":1333,"_21524":55189,"_5":14790,"_28264":54898,"_3060":55190},[],"Configuration of the event bus the connector subscribes to (AMQP or AWS SQS/SNS).",{"_3604":1434,"_31083":1333,"_21524":55192,"_5":14790,"_28264":54898,"_3060":55193},[],"`dms_manager_client`",{"_3604":1435,"_31083":1333,"_21524":55195,"_5":14790,"_28264":54898,"_3060":25699},[],{"_3604":1436,"_31083":1333,"_21524":55197,"_5":14790,"_28264":54898,"_3060":55104},[],{"_3604":1437,"_31083":1333,"_21524":55199,"_5":14790,"_28264":54898,"_3060":55200},[],"HTTP URL of Lamassu's DMS Manager service.",{"_3604":1438,"_31083":1333,"_21524":55202,"_5":14790,"_28264":54898,"_3060":55203},[],"`device_manager_client`",{"_3604":1439,"_31083":1333,"_21524":55205,"_5":14790,"_28264":54898,"_3060":25699},[],{"_3604":1440,"_31083":1333,"_21524":55207,"_5":14790,"_28264":54898,"_3060":55104},[],{"_3604":1441,"_31083":1333,"_21524":55209,"_5":14790,"_28264":54898,"_3060":55210},[],"HTTP URL of Lamassu's Device Manager.",{"_3604":1442,"_31083":1333,"_21524":55212,"_5":14790,"_28264":54898,"_3060":55213},[],"`ca_client`",{"_3604":1443,"_31083":1333,"_21524":55215,"_5":14790,"_28264":54898,"_3060":25699},[],{"_3604":1444,"_31083":1333,"_21524":55217,"_5":14790,"_28264":54898,"_3060":55104},[],{"_3604":1445,"_31083":1333,"_21524":55219,"_5":14790,"_28264":54898,"_3060":55220},[],"HTTP URL of Lamassu's CA service.",{"_3604":1446,"_31083":1333,"_21524":55222,"_5":14790,"_28264":54902,"_3060":55223},[],"The connector owns the AWS side of four resource types — CAs, DMS provisioning templates (JITP), device certificates and Things. This section maps the bus events the connector consumes to the AWS resources they touch and to the AWS calls each flow performs. The state machine of each resource lives next to its detailed explanation; the last column links to it. AWS resources are referenced with the notation `IoTCore/<resource>`.",{"_3604":1447,"_31083":1333,"_21524":55225,"_5":14790,"_28264":54902,"_3060":55226},[],"The **CloudEvent type** column lists the event name on Lamassu's internal event bus; the **IAM actions** column lists the exact AWS SDK operations each flow invokes, so the required permissions can be derived directly from this table.",{"_3604":1448,"_31083":1333,"_21524":55228,"_5":14790,"_28264":54902,"_3060":55229},[],"CloudEvent type",{"_3604":1449,"_31083":1333,"_21524":55231,"_5":14790,"_28264":54902,"_3060":55232},[],"Lamassu resource",{"_3604":1450,"_31083":1333,"_21524":55234,"_5":14790,"_28264":54902,"_3060":55235},[],"AWS Resource",{"_3604":1451,"_31083":1333,"_21524":55237,"_5":14790,"_28264":54902,"_3060":55238},[],"IAM actions",{"_3604":1452,"_31083":1333,"_21524":55240,"_5":14790,"_28264":54902,"_3060":55241},[],"AWS calls and effect",{"_3604":1453,"_31083":1333,"_21524":55243,"_5":14790,"_28264":54902,"_3060":55244},[],"Where in this page",{"_3604":1454,"_31083":1333,"_21524":55246,"_5":14790,"_28264":54902,"_3060":55247},[],"`EventCreateCAKey` / `EventImportCAKey` / `EventUpdateCAMetadataKey`",{"_3604":1455,"_31083":1333,"_21524":55249,"_5":14790,"_28264":54902,"_3060":55250},[],"CA",{"_3604":1456,"_31083":1333,"_21524":55252,"_5":14790,"_28264":54902,"_3060":55253},[],"`IoTCore/CACertificate`",{"_3604":1457,"_31083":1333,"_21524":55255,"_5":14790,"_28264":54902,"_3060":55256},[],"`iot:GetRegistrationCode`, `iot:RegisterCACertificate`, `iot:DescribeCACertificate`, `iot:ListCACertificates`",{"_3604":1458,"_31083":1333,"_21524":55258,"_5":14790,"_28264":54902,"_3060":55259},[],"Loads the CA into connector state; a `registration.status = REQUESTED` write fires the registration flow (Primary with verification certificate, or SNI-only) and writes `SUCCEEDED` or `FAILED` back to the CA's metadata.",{"_3604":1459,"_31083":1333,"_21524":55261,"_5":14790,"_28264":54902,"_3060":54915},[],{"_3604":1460,"_31083":1333,"_21524":55263,"_5":14790,"_28264":54902,"_3060":55264},[],"`EventCreateDMSKey` / `EventUpdateDMSKey`",{"_3604":1461,"_31083":1333,"_21524":55266,"_5":14790,"_28264":54902,"_3060":55267},[],"DMS",{"_3604":1462,"_31083":1333,"_21524":55269,"_5":14790,"_28264":54902,"_3060":55270},[],"`IoTCore/ProvisioningTemplate`",{"_3604":1463,"_31083":1333,"_21524":55272,"_5":14790,"_28264":54902,"_3060":55273},[],"`iot:CreateProvisioningTemplate`, `iot:UpdateCACertificate`",{"_3604":1464,"_31083":1333,"_21524":55275,"_5":14790,"_28264":54902,"_3060":55276},[],"In `jitp` mode, attempts to create the provisioning template and attaches it to the registered CA. Non-idempotent: a `PUT /v1/dms/{id}` edit retries the creation and lands in `lamassu-dlq` after 3 retries. Idempotent for `none` and `auto` (configuration only).",{"_3604":1465,"_31083":1333,"_21524":55278,"_5":14790,"_28264":54902,"_3060":54943},[],{"_3604":1466,"_31083":1333,"_21524":55280,"_5":14790,"_28264":54902,"_3060":55281},[],"`EventBindDeviceIdentityKey`",{"_3604":1467,"_31083":1333,"_21524":55283,"_5":14790,"_28264":54902,"_3060":55284},[],"Device",{"_3604":1468,"_31083":1333,"_21524":55286,"_5":14790,"_28264":54902,"_3060":55287},[],"`IoTCore/Policy`, `IoTCore/ThingGroup`, `IoTCore/Thing`",{"_3604":1469,"_31083":1333,"_21524":55289,"_5":14790,"_28264":54902,"_3060":55290},[],"`iot:CreatePolicy` / `iot:DeletePolicyVersion`, `iot:GetPolicy` / `iot:ListPolicyVersions`, `iot:CreateThingGroup`, `iot:DescribeThing` / `iot:ListThingPrincipals`, `iot:RegisterThing`",{"_3604":1470,"_31083":1333,"_21524":55292,"_5":14790,"_28264":54902,"_3060":55293},[],"In `auto` mode: creates/updates policies, ensures Thing groups, revokes stale principals and provisions the Thing via `iot:RegisterThing`. In `jitp` mode: no AWS calls; AWS runs the JITP template on first connection.",{"_3604":1471,"_31083":1333,"_21524":55295,"_5":14790,"_28264":54902,"_3060":54951},[],{"_3604":1472,"_31083":1333,"_21524":55297,"_5":14790,"_28264":54902,"_3060":55298},[],"`EventUpdateCertificateStatusKey`",{"_3604":1473,"_31083":1333,"_21524":55300,"_5":14790,"_28264":54902,"_3060":55301},[],"Certificate",{"_3604":1474,"_31083":1333,"_21524":55303,"_5":14790,"_28264":54902,"_3060":55304},[],"`IoTCore/Certificate`",{"_3604":1475,"_31083":1333,"_21524":55306,"_5":14790,"_28264":54902,"_3060":55307},[],"`iot:UpdateCertificate`, `iot:Connect` (data plane)",{"_3604":1476,"_31083":1333,"_21524":55309,"_5":14790,"_28264":54902,"_3060":55310},[],"Maps status to AWS (`ACTIVE`, `INACTIVE`, `REVOKED`), calls `iot:UpdateCertificate` and forces an MQTT disconnect on revoke.",{"_3604":1477,"_31083":1333,"_21524":55312,"_5":14790,"_28264":54902,"_3060":54963},[],{"_3604":1478,"_31083":1333,"_21524":55314,"_5":14790,"_28264":54902,"_3060":55315},[],"`EventUpdateCertificateMetadataKey` / `EventUpdateDeviceMetadataKey`",{"_3604":1479,"_31083":1333,"_21524":55317,"_5":14790,"_28264":54902,"_3060":55318},[],"Certificate / Device",{"_3604":1480,"_31083":1333,"_21524":55320,"_5":14790,"_28264":54902,"_3060":55321},[],"`IoTCore/Certificate`, `IoTCore/Thing`",{"_3604":1481,"_31083":1333,"_21524":55323,"_5":14790,"_28264":54902,"_3060":51126},[],{"_3604":1482,"_31083":1333,"_21524":55325,"_5":14790,"_28264":54902,"_3060":55326},[],"Refreshes internal state; the connector ignores events whose CloudEvent `source` matches its own URI to avoid self-triggered loops.",{"_3604":1483,"_31083":1333,"_21524":55328,"_5":14790,"_28264":54902,"_3060":54971},[],{"_3604":1484,"_31083":1333,"_21524":55330,"_5":14790,"_28264":54906,"_3060":55331},[],"For devices to authenticate to AWS IoT Core with certificates issued by a Lamassu CA, that CA must first be registered in the AWS account. The connector handles this registration automatically in response to the `EventCreateCAKey`, `EventImportCAKey` and `EventUpdateCAMetadataKey` events, but the operation **only fires when the administrator explicitly requests it** through the CA metadata field.",{"_3604":1485,"_31083":1333,"_21524":55333,"_5":14790,"_28264":54910,"_3060":55334},[],"Registration is triggered by setting `registration.status = \"REQUESTED\"` on the `lamassu.io/iot/{connector_id}` key of the CA's metadata. This can be done from the Lamassu console in the CA management section or through the API.",{"_3604":1486,"_31083":1333,"_21524":55336,"_5":14790,"_28264":54910,"_3060":55337},[],"Once the event is received, the connector attempts to register the CA in AWS and updates the `registration.status` field in the CA's metadata with the result: `\"SUCCEEDED\"` if registration was successful, or `\"FAILED\"` with an error message otherwise. The process is asynchronous, so you must periodically check the metadata status until the operation completes.",{"_3604":1487,"_31083":1333,"_21524":55339,"_5":14790,"_28264":54914,"_3060":55340},[],"The CA registration flow is driven by the `registration.status` field of the CA's connector metadata:",{"_3604":1488,"_31083":1333,"_21524":55342,"_5":14790,"_28264":54914,"_3060":55343},[],"Transition",{"_3604":1489,"_31083":1333,"_21524":55345,"_5":14790,"_28264":54914,"_3060":55346},[],"AWS calls",{"_3604":1490,"_31083":1333,"_21524":55348,"_5":14790,"_28264":54914,"_3060":55349},[],"`NotRegistered` → `Requested`",{"_3604":1491,"_31083":1333,"_21524":55351,"_5":14790,"_28264":54914,"_3060":55352},[],"none (metadata write only)",{"_3604":1492,"_31083":1333,"_21524":55354,"_5":14790,"_28264":54914,"_3060":55355},[],"`Requested` → `Registering`",{"_3604":1493,"_31083":1333,"_21524":55357,"_5":14790,"_28264":54914,"_3060":55358},[],"`iot:GetRegistrationCode` (Primary Account only)",{"_3604":1494,"_31083":1333,"_21524":55360,"_5":14790,"_28264":54914,"_3060":55361},[],"`Registering` → `Succeeded`",{"_3604":1495,"_31083":1333,"_21524":55363,"_5":14790,"_28264":54914,"_3060":55364},[],"`iot:RegisterCACertificate` (Primary: proof-of-possession with an ephemeral key; SNI-only: `CertificateMode: SNI_ONLY`)",{"_3604":1496,"_31083":1333,"_21524":55366,"_5":14790,"_28264":54914,"_3060":55367},[],"`Registering` → `Failed`",{"_3604":1497,"_31083":1333,"_21524":55369,"_5":14790,"_28264":54914,"_3060":55370},[],"failed `iot:RegisterCACertificate`; the error detail is written to the CA's metadata",{"_3604":1498,"_31083":1333,"_21524":55372,"_5":14790,"_28264":54914,"_3060":55373},[],"`Failed` / `Succeeded` → `Requested`",{"_3604":1499,"_31083":1333,"_21524":55375,"_5":14790,"_28264":54914,"_3060":55376},[],"none (a new `REQUESTED` write re-runs the flow)",{"_3604":1500,"_31083":1333,"_21524":55378,"_5":14790,"_28264":54918,"_3060":55379},[],"When the `primary_account` parameter is `true`, the connector runs the full registration flow with proof-of-possession of the private key:",{"_3604":1501,"_31083":1333,"_21524":55381,"_5":14790,"_28264":54918,"_3060":55382},[],"It calls `iot:GetRegistrationCode` to obtain AWS's verification code.",{"_3604":1502,"_31083":1333,"_21524":55384,"_5":14790,"_28264":54918,"_3060":55385},[],"The connector internally generates an ephemeral RSA-2048 key pair and builds a CSR whose Common Name is exactly that registration code. It then calls Lamassu's signing service so the registered CA issues a real X.509 verification certificate signing that CSR. The ephemeral private key is used only for this purpose and is neither stored nor sent to AWS.",{"_3604":1503,"_31083":1333,"_21524":55387,"_5":14790,"_28264":54918,"_3060":55388},[],"It sends the CA (in PEM) and the verification certificate to AWS via `iot:RegisterCACertificate`, enabling registration with `AllowAutoRegistration: true`.",{"_3604":1504,"_31083":1333,"_21524":55390,"_5":14790,"_28264":54918,"_3060":55391},[],"Only one account can own a CA in a given AWS region. If the CA is already registered with the same serial number, the connector silently skips the step.",{"_3604":1505,"_31083":1333,"_21524":55393,"_5":14790,"_28264":54918,"_3060":55394},[],"The tags AWS IoT Core applies to the registered CA certificate are `LMS.CA.ID`, `LMS.CA.SN` and `LMS.CA.CN`.",{"_3604":1506,"_31083":1333,"_21524":55396,"_5":14790,"_28264":54922,"_3060":55397},[],"When `primary_account` is `false`, the connector registers the CA using `CertificateMode: SNI_ONLY`. This mode requires no verification code or access to the CA's private key, so it is the right choice when the CA is managed from another AWS account or when the administrator does not hold the private key. It is the usual method to register the same CA in several AWS accounts simultaneously.",{"_3604":1507,"_31083":1333,"_21524":55399,"_5":14790,"_28264":54926,"_3060":55400},[],"Each DMS participating in the AWS IoT Core integration must have the metadata key `lamassu.io/iot/{connector_id}` configured. The most important field of that configuration is `registration_mode`, which determines how devices are provisioned in AWS.",{"_3604":1508,"_31083":1333,"_21524":55402,"_5":14790,"_28264":54926,"_3060":55403},[],"There are three registration modes, and the choice among them depends on the fleet's provisioning strategy.",{"_3604":1509,"_31083":1333,"_21524":55405,"_5":14790,"_28264":54930,"_3060":55406},[],"In this mode the connector **creates no Things, groups or policies** in AWS IoT Core. It only syncs certificate status (active, revoked, suspended) as it changes in Lamassu. It is the right mode when Thing provisioning in AWS is managed by an external system and Lamassu only needs to keep certificate status up to date.",{"_3604":1510,"_31083":1333,"_21524":55408,"_5":14790,"_28264":54934,"_3060":55409},[],"`auto` mode delegates full device provisioning in AWS to Lamassu at enrollment time. When the device successfully completes its EST enrollment and Lamassu emits the `EventBindDeviceIdentityKey` event, the connector automatically executes the following sequence:",{"_3604":1511,"_31083":1333,"_21524":55411,"_5":14790,"_28264":54934,"_3060":55412},[],"Creates or updates the IoT policies configured in the DMS.",{"_3604":1512,"_31083":1333,"_21524":55414,"_5":14790,"_28264":54934,"_3060":55415},[],"Creates the root group `LAMASSU` in the AWS account (if it does not exist) and the child groups configured in the DMS as subgroups of `LAMASSU`. If the groups already exist, the `ResourceAlreadyExistsException` error is ignored, making the operation idempotent.",{"_3604":1513,"_31083":1333,"_21524":55417,"_5":14790,"_28264":54934,"_3060":55418},[],"If the Thing already existed in AWS IoT Core, the connector iterates all certificates (principals) currently attached to that Thing and marks them as `REVOKED` in AWS, ensuring previous certificates cannot keep being used to authenticate.",{"_3604":1514,"_31083":1333,"_21524":55420,"_5":14790,"_28264":54934,"_3060":55421},[],"Calls `iot:RegisterThing` with a CloudFormation-style provisioning template that creates the Thing, registers the device's certificate (PEM of the device certificate and of the issuing CA certificate) and attaches the configured policies.",{"_3604":1515,"_31083":1333,"_21524":55423,"_5":14790,"_28264":54934,"_3060":55424},[],"Once provisioning completes, the connector stores the resulting certificate's ARN in the Lamassu certificate's metadata under the key `lamassu.io/iot/{connector_id}` and marks the device as `Registered: true` in Device Manager.",{"_3604":1516,"_31083":1333,"_21524":55426,"_5":14790,"_28264":54934,"_3060":55427},[],"**The Thing name in AWS is the Common Name (CN) of the device's certificate.** This convention is fundamental for the firmware developer: the `/CN=` value the device includes in its CSR when enrolling becomes the ThingName it must identify itself with in all MQTT operations against AWS IoT Core.",{"_3604":1517,"_31083":1333,"_21524":55429,"_5":14790,"_28264":54938,"_3060":55430},[],"Just-In-Time Provisioning (JITP) mode delegates provisioning to AWS instead of the connector doing it directly. When the connector detects the DMS is in `jitp` mode, it creates a JITP provisioning template in AWS IoT Core and attaches it to the registered CA certificate. The connector attempts to create this template when the DMS is created and again on every full DMS edit (`PUT /v1/dms/{id}`) — not at device enrollment time. The attempt is not idempotent: when a template named after the DMS ID already exists, the creation call fails, the event is retried three times and finally lands in the `lamassu-dlq` poison queue (see Troubleshooting). The template is created once; later DMS edits never update its content. A DMS update that omits `metadata` or sends `null` keeps the stored metadata, so the connector key `lamassu.io/iot/{connector_id}` remains present and the attempt is still triggered. A body that supplies a `metadata` object replaces the stored metadata entirely: if that object does not carry the connector key, the key is dropped and the connector silently skips the DMS's future events. Once the template is attached, when a device with a certificate issued by that CA connects to AWS IoT Core for the first time, AWS executes the template automatically: it creates the Thing, registers the certificate and activates it.",{"_3604":1518,"_31083":1333,"_21524":55432,"_5":14790,"_28264":54938,"_3060":55433},[],"The connector creates the template, named after the DMS ID, only once. Each later edit of the DMS that keeps the connector key tries to create it again and fails, because the connector does not update existing templates. Later changes to `jitp_config.provisioning_role_arn`, `jitp_config.enable_template` or to the groups and policies the template references must be applied by hand in AWS IoT Core.",{"_3604":1519,"_31083":1333,"_21524":55435,"_5":14790,"_28264":54938,"_3060":55436},[],"The failed event is retried and ends in `lamassu-dlq`. Groups and policies are registered before the failure, but the assignment of the template to the registered CA, the write-back of the ARN to the DMS and the shadow update when `ManagedCAs` changes are skipped.",{"_3604":1520,"_31083":1333,"_21524":55438,"_5":14790,"_28264":54938,"_3060":55439},[],"The Thing name in the JITP template is derived from `AWS::IoT::Certificate::CommonName`, which corresponds to the device certificate's CN — the same convention as `auto` mode.",{"_3604":1521,"_31083":1333,"_21524":55441,"_5":14790,"_28264":54938,"_3060":55442},[],"This mode requires the `jitp_config.provisioning_role_arn` field to be configured with the ARN of an IAM role AWS IoT Core can assume to execute the template. If not configured, the connector uses the default `arn:aws:iam::{account}:role/JITPRole` and logs a warning. The administrator must ensure that role exists in the account and has the necessary permissions before enabling JITP mode.",{"_3604":1522,"_31083":1333,"_21524":55444,"_5":14790,"_28264":54942,"_3060":55445},[],"The DMS's `registration_mode` determines what the connector does on the AWS side when the DMS is created or fully edited:",{"_3604":1523,"_31083":1333,"_21524":55447,"_5":14790,"_28264":54942,"_3060":55343},[],{"_3604":1524,"_31083":1333,"_21524":55449,"_5":14790,"_28264":54942,"_3060":55346},[],{"_3604":1525,"_31083":1333,"_21524":55451,"_5":14790,"_28264":54942,"_3060":55452},[],"`Unconfigured` → `None` / `Auto`",{"_3604":1526,"_31083":1333,"_21524":55454,"_5":14790,"_28264":54942,"_3060":55455},[],"none (configuration only)",{"_3604":1527,"_31083":1333,"_21524":55457,"_5":14790,"_28264":54942,"_3060":55458},[],"`None` ↔ `Auto`",{"_3604":1528,"_31083":1333,"_21524":55460,"_5":14790,"_28264":54942,"_3060":55455},[],{"_3604":1529,"_31083":1333,"_21524":55462,"_5":14790,"_28264":54942,"_3060":55463},[],"Any → `Jitp`",{"_3604":1530,"_31083":1333,"_21524":55465,"_5":14790,"_28264":54942,"_3060":55466},[],"`iot:CreateProvisioningTemplate` (non-idempotent: it fails when the template already exists; after 3 retries the event lands in `lamassu-dlq`)",{"_3604":1531,"_31083":1333,"_21524":55468,"_5":14790,"_28264":54942,"_3060":55469},[],"`Jitp` → `None` / `Auto`",{"_3604":1532,"_31083":1333,"_21524":55471,"_5":14790,"_28264":54942,"_3060":55472},[],"none (the template stays in the AWS account)",{"_3604":1533,"_31083":1333,"_21524":55474,"_5":14790,"_28264":54946,"_3060":55475},[],"For the firmware developer, `auto` mode is transparent: the device performs its EST enrollment as usual and, as a side effect, it is provisioned in AWS IoT Core with no additional step.",{"_3604":1534,"_31083":1333,"_21524":55477,"_5":14790,"_28264":54946,"_3060":55478},[],"The full flow from the device's perspective is:",{"_3604":1535,"_31083":1333,"_21524":55480,"_5":14790,"_28264":54946,"_3060":55481},[],"Once the connector completes provisioning, the device can connect to the AWS IoT Core MQTT endpoint using its private key and the certificate issued by Lamassu. The ThingName it must identify itself with in AWS is exactly the certificate's CN.",{"_3604":1536,"_31083":1333,"_21524":55483,"_5":14790,"_28264":54950,"_3060":55484},[],"Things only exist under `auto` mode; in `jitp` mode AWS creates the Thing itself when the device first connects. The Thing name is always the device certificate's CN:",{"_3604":1537,"_31083":1333,"_21524":55486,"_5":14790,"_28264":54950,"_3060":55343},[],{"_3604":1538,"_31083":1333,"_21524":55488,"_5":14790,"_28264":54950,"_3060":55346},[],{"_3604":1539,"_31083":1333,"_21524":55490,"_5":14790,"_28264":54950,"_3060":55491},[],"`Absent` → `Provisioned`",{"_3604":1540,"_31083":1333,"_21524":55493,"_5":14790,"_28264":54950,"_3060":55494},[],"policies created/updated, Thing groups ensured, `iot:RegisterThing` (creates the Thing, registers the certificate, attaches policies)",{"_3604":1541,"_31083":1333,"_21524":55496,"_5":14790,"_28264":54950,"_3060":55497},[],"`Provisioned` → `Provisioned` (re-enrollment)",{"_3604":1542,"_31083":1333,"_21524":55499,"_5":14790,"_28264":54950,"_3060":55500},[],"stale principals marked `REVOKED`, new `iot:RegisterThing` run; the new certificate ARN replaces the old one in Lamassu metadata",{"_3604":1543,"_31083":1333,"_21524":55502,"_5":14790,"_28264":54950,"_3060":55503},[],"In `jitp` mode the connector makes no provisioning calls: AWS executes the JITP template on the device's first connection and creates the Thing, registers the certificate and activates it on its own.",{"_3604":1544,"_31083":1333,"_21524":55505,"_5":14790,"_28264":54954,"_3060":55506},[],"In JITP mode the device also performs its EST enrollment conventionally and obtains its certificate from Lamassu. The difference is that AWS IoT Core does not know the device until it attempts its first connection.",{"_3604":1545,"_31083":1333,"_21524":55508,"_5":14790,"_28264":54954,"_3060":55509},[],"When the device establishes its first MQTT connection to AWS IoT Core presenting the Lamassu-issued certificate, AWS detects that the certificate belongs to a CA registered with a JITP template, executes that template and creates the Thing automatically. The initial connection may fail or be delayed while the template runs; firmware must be prepared to retry the connection.",{"_3604":1546,"_31083":1333,"_21524":55511,"_5":14790,"_28264":54954,"_3060":55512},[],"For the JITP flow to work correctly:",{"_3604":1547,"_31083":1333,"_21524":55514,"_5":14790,"_28264":54954,"_3060":55515},[],"The CA must be registered in AWS in Primary Account mode (SNI-only mode does not support JITP).",{"_3604":1548,"_31083":1333,"_21524":55517,"_5":14790,"_28264":54954,"_3060":55518},[],"The IAM role configured in `jitp_config.provisioning_role_arn` must exist and have permissions to create Things, register certificates and attach policies in the AWS account.",{"_3604":1549,"_31083":1333,"_21524":55520,"_5":14790,"_28264":54954,"_3060":55521},[],"The device must present both its certificate and the issuing CA's certificate in the TLS handshake with AWS IoT Core.",{"_3604":1550,"_31083":1333,"_21524":55523,"_5":14790,"_28264":54954,"_3060":55524},[],"Certificates provisioned via JITP **do not have the connector's metadata key** (`lamassu.io/iot/{connector_id}`) in Lamassu. As a consequence, status changes of those certificates in Lamassu are not automatically synced to AWS through the state synchronization mechanism described in the next section.",{"_3604":1551,"_31083":1333,"_21524":55526,"_5":14790,"_28264":54958,"_3060":55527},[],"The connector listens for the `EventUpdateCertificateStatusKey` event and, when a certificate holding the connector's metadata key changes status in Lamassu, replicates that change in AWS IoT Core. The following table shows the status mapping:",{"_3604":1552,"_31083":1333,"_21524":55529,"_5":14790,"_28264":54958,"_3060":55530},[],"Status in Lamassu",{"_3604":1553,"_31083":1333,"_21524":55532,"_5":14790,"_28264":54958,"_3060":55533},[],"Revocation reason",{"_3604":1554,"_31083":1333,"_21524":55535,"_5":14790,"_28264":54958,"_3060":55536},[],"Status in AWS IoT Core",{"_3604":1555,"_31083":1333,"_21524":55538,"_5":14790,"_28264":54958,"_3060":55539},[],"`Active`",{"_3604":1556,"_31083":1333,"_21524":55541,"_5":14790,"_28264":54958,"_3060":55542},[],"None",{"_3604":1557,"_31083":1333,"_21524":55544,"_5":14790,"_28264":54958,"_3060":55545},[],"`ACTIVE`",{"_3604":1558,"_31083":1333,"_21524":55547,"_5":14790,"_28264":54958,"_3060":55548},[],"`Revoked`",{"_3604":1559,"_31083":1333,"_21524":55550,"_5":14790,"_28264":54958,"_3060":55551},[],"`certificateHold`",{"_3604":1560,"_31083":1333,"_21524":55553,"_5":14790,"_28264":54958,"_3060":55554},[],"`INACTIVE`",{"_3604":1561,"_31083":1333,"_21524":55556,"_5":14790,"_28264":54958,"_3060":55548},[],{"_3604":1562,"_31083":1333,"_21524":55558,"_5":14790,"_28264":54958,"_3060":55559},[],"Any other reason",{"_3604":1563,"_31083":1333,"_21524":55561,"_5":14790,"_28264":54958,"_3060":55562},[],"`REVOKED`",{"_3604":1564,"_31083":1333,"_21524":55564,"_5":14790,"_28264":54958,"_3060":55565},[],"Only the `Active` and `Revoked` states produce a call to `iot:UpdateCertificate`. The other lifecycle states of Lamassu (`RenewalWindow`, `AboutToExpire`, `Expired`) are not synced to AWS IoT Core; the certificate status in AWS remains unchanged until the status in Lamassu becomes `Active` or `Revoked`.",{"_3604":1565,"_31083":1333,"_21524":55567,"_5":14790,"_28264":54962,"_3060":55568},[],"Certificates holding the connector's metadata key sync their status; certificates provisioned via JITP have no metadata key and stay out of this machine:",{"_3604":1566,"_31083":1333,"_21524":55570,"_5":14790,"_28264":54962,"_3060":55343},[],{"_3604":1567,"_31083":1333,"_21524":55572,"_5":14790,"_28264":54962,"_3060":55346},[],{"_3604":1568,"_31083":1333,"_21524":55574,"_5":14790,"_28264":54962,"_3060":55575},[],"`NotSynced` → `Active`",{"_3604":1569,"_31083":1333,"_21524":55577,"_5":14790,"_28264":54962,"_3060":55054},[],{"_3604":1570,"_31083":1333,"_21524":55579,"_5":14790,"_28264":54962,"_3060":55580},[],"`Active` → `Inactive`",{"_3604":1571,"_31083":1333,"_21524":55582,"_5":14790,"_28264":54962,"_3060":55583},[],"`iot:UpdateCertificate` + forced MQTT disconnect",{"_3604":1572,"_31083":1333,"_21524":55585,"_5":14790,"_28264":54962,"_3060":55586},[],"`Active` → `Revoked`",{"_3604":1573,"_31083":1333,"_21524":55588,"_5":14790,"_28264":54962,"_3060":55583},[],{"_3604":1574,"_31083":1333,"_21524":55590,"_5":14790,"_28264":54962,"_3060":55591},[],"`Inactive` / `Revoked` → `Active`",{"_3604":1575,"_31083":1333,"_21524":55593,"_5":14790,"_28264":54962,"_3060":55054},[],{"_3604":1576,"_31083":1333,"_21524":55595,"_5":14790,"_28264":54962,"_3060":55596},[],"`RenewalWindow` / `AboutToExpire` / `Expired`",{"_3604":1577,"_31083":1333,"_21524":55598,"_5":14790,"_28264":54962,"_3060":55599},[],"none (these states are not synced to AWS)",{"_3604":1578,"_31083":1333,"_21524":55601,"_5":14790,"_28264":54966,"_3060":55602},[],"When the connector marks a certificate as `REVOKED` or `INACTIVE` in AWS, it additionally performs a forced disconnect of the device. To do so it opens an MQTT connection over WebSocket (with SigV4 authentication using the connector's credentials) to the AWS IoT Core data endpoint, using the certificate's CN as the MQTT client identifier, and closes it immediately. This terminates any active MQTT session the device may have at that moment.",{"_3604":1579,"_31083":1333,"_21524":55604,"_5":14790,"_28264":54966,"_3060":55605},[],"This forced disconnect happens at the moment Lamassu records the status change. If the device tries to reconnect after the disconnect, AWS IoT Core will reject the connection because the certificate is already listed as `REVOKED` or `INACTIVE`.",{"_3604":1580,"_31083":1333,"_21524":55607,"_5":14790,"_28264":54966,"_3060":55608},[],"Certificates provisioned in JITP mode do not have this automatic sync, since they lack the connector's metadata key.",{"_3604":1581,"_31083":1333,"_21524":55610,"_5":14790,"_28264":54970,"_3060":55611},[],"The connector can write to the AWS IoT Core Device Shadow to send action signals to the device firmware. This feature is enabled per DMS with `shadow_config.enable: true`.",{"_3604":1582,"_31083":1333,"_21524":55613,"_5":14790,"_28264":54970,"_3060":55614},[],"If `shadow_config.shadow_name` holds a value, the connector uses a Named Shadow with that name; otherwise it uses the Classic Shadow (the Thing's default shadow).",{"_3604":1583,"_31083":1333,"_21524":55616,"_5":14790,"_28264":54974,"_3060":55617},[],"The connector writes to the `desired.identity_actions` field of the shadow document. Each entry contains a Unix timestamp in milliseconds. The device firmware must read this field and act accordingly.",{"_3604":1584,"_31083":1333,"_21524":55619,"_5":14790,"_28264":54974,"_3060":55620},[],"There are two action types:",{"_3604":1585,"_31083":1333,"_21524":55622,"_5":14790,"_28264":54974,"_3060":55623},[],"**`UPDATE_CERTIFICATE`**: written when a certificate's preventive renewal window activates — that is, when the `triggered` field of the preventive renewal delta flips from `false` to `true`. This action tells the device it must start the re-enrollment process to renew its certificate before it expires.",{"_3604":1586,"_31083":1333,"_21524":55625,"_5":14790,"_28264":54974,"_3060":55626},[],"**`UPDATE_TRUST_ANCHOR_LIST`**: written to all devices of a DMS when the DMS's `ManagedCAs` list changes. This action tells the device it must update its trusted CA store.",{"_3604":1587,"_31083":1333,"_21524":55628,"_5":14790,"_28264":54974,"_3060":55629},[],"The shadow write process consists of reading the current shadow (`iotdata:GetThingShadow`), merging the new actions with the existing ones and writing the result (`iotdata:UpdateThingShadow`). If the shadow does not exist, the connector creates it. After a successful write, the list of pending actions in the device's metadata in Lamassu is cleared.",{"_3604":1588,"_31083":1333,"_21524":55631,"_5":14790,"_28264":54978,"_3060":55632},[],"The connector creates and attaches the policies configured in the DMS. A typical policy for a device using MQTT and the Device Shadow has this structure:",{"_3604":1589,"_31083":1333,"_21524":55634,"_5":14790,"_28264":54978,"_3060":55635},[],"In the policy above, the `<AWS_REGION>` and `<AWS_ACCOUNT_ID>` placeholders must be replaced with the AWS region and the twelve-digit account identifier of the target account before applying the policy. The `${iot:Connection.Thing.ThingName}` variable automatically limits each permission to the Thing the device is connected as, following the principle of least privilege. The `${ShadowName}` variable in the shadow ARNs is a placeholder that must be replaced with the `shadow_config.shadow_name` value configured in the DMS; if the Classic Shadow is used, it can be simplified by removing the `name/${ShadowName}/` segment. AWS IoT policies do not support regex alternation; the `[name/${ShadowName}/]*` notation represents the optionality of that segment within ARN syntax constraints.",{"_3604":1590,"_31083":1333,"_21524":55637,"_5":14790,"_28264":54978,"_3060":55638},[],"The first statement lets the device connect using its ThingName as the MQTT identifier. The second authorizes publishing to the Thing's generic MQTT topic and to the shadow topics, needed so the device can update its reported state. The last two statements grant subscribe and receive permissions over the same topics, letting the device receive shadow updates (for example, the `UPDATE_CERTIFICATE` and `UPDATE_TRUST_ANCHOR_LIST` actions written by the connector).",{"_3604":1591,"_31083":1333,"_21524":55640,"_5":14790,"_28264":54982,"_3060":55641},[],"**Symptom:** The CA registration stays in `REQUESTED` indefinitely.",{"_3604":1592,"_31083":1333,"_21524":55643,"_5":14790,"_28264":54982,"_3060":55644},[],"**Cause:** The connector is not running or is not subscribed to the event bus. It can also indicate incorrect IAM credentials, insufficient permissions or that the metadata key was written with a wrong `connector_id`.",{"_3604":1593,"_31083":1333,"_21524":55646,"_5":14790,"_28264":54982,"_3060":55647},[],"**Resolution:** Verify the connector process is active and the logs show no AWS communication errors. Check the metadata field was written under the exact key `lamassu.io/iot/{connector_id}`. If the error persists, the connector will update the status to `FAILED` with a descriptive message in the CA metadata.",{"_3604":1594,"_31083":1333,"_21524":55649,"_5":14790,"_28264":54982,"_3060":55650},[],"**Symptom:** A certificate's status is not synced to AWS after a revocation.",{"_3604":1595,"_31083":1333,"_21524":55652,"_5":14790,"_28264":54982,"_3060":55653},[],"**Cause:** Most commonly the certificate was provisioned in JITP mode. JITP certificates lack the connector's metadata key and are outside the state synchronization mechanism. If the DMS is in `auto` mode, it may indicate the initial provisioning did not complete correctly and the AWS ARN was not stored in the certificate metadata.",{"_3604":1596,"_31083":1333,"_21524":55655,"_5":14790,"_28264":54982,"_3060":55656},[],"**Resolution:** For JITP certificates, migrate the DMS to `auto` mode and re-provision the affected devices. For `auto` mode certificates, verify the certificate has the AWS ARN stored in its metadata; if not, repeat the provisioning.",{"_3604":1597,"_31083":1333,"_21524":55658,"_5":14790,"_28264":54982,"_3060":55659},[],"**Symptom:** The forced disconnect does not terminate the device's MQTT session after revocation.",{"_3604":1598,"_31083":1333,"_21524":55661,"_5":14790,"_28264":54982,"_3060":55662},[],"**Cause:** The device uses an MQTT client ID different from the certificate's CN. The forced disconnect opens a connection using the CN as client ID; if the firmware uses another identifier, the disconnect does not affect that session.",{"_3604":1599,"_31083":1333,"_21524":55664,"_5":14790,"_28264":54982,"_3060":55665},[],"**Resolution:** Make sure the firmware uses exactly the certificate's CN as the MQTT client identifier. That CN matches the ThingName in AWS IoT Core.",{"_3604":1600,"_31083":1333,"_21524":55667,"_5":14790,"_28264":54982,"_3060":55668},[],"**Symptom:** The device receives `CLIENT_ID_REJECTED` when connecting to AWS IoT Core.",{"_3604":1601,"_31083":1333,"_21524":55670,"_5":14790,"_28264":54982,"_3060":55671},[],"**Cause:** The MQTT client ID does not match the ThingName, which is always the CN of the certificate issued by Lamassu.",{"_3604":1602,"_31083":1333,"_21524":55673,"_5":14790,"_28264":54982,"_3060":55674},[],"**Resolution:** Verify the firmware uses exactly the value of the CN field included in the enrollment CSR as the MQTT client identifier.",{"_3604":1603,"_31083":1333,"_21524":55676,"_5":14790,"_28264":54982,"_3060":55677},[],"**Symptom:** The device's first MQTT connection in JITP mode fails or times out.",{"_3604":1604,"_31083":1333,"_21524":55679,"_5":14790,"_28264":54982,"_3060":55680},[],"**Cause:** This is expected behavior while AWS executes the JITP template on the device's first connection.",{"_3604":1605,"_31083":1333,"_21524":55682,"_5":14790,"_28264":54982,"_3060":55683},[],"**Resolution:** Firmware must implement retries with exponential backoff for the first connection. If the failure persists beyond a few minutes, verify the IAM role configured in `jitp_config.provisioning_role_arn` exists in the account and has permissions to create Things, register certificates and attach policies.",{"_3604":1606,"_31083":1333,"_21524":55685,"_5":14790,"_28264":54982,"_3060":55686},[],"**Symptom:** The Device Shadow is not updated when it should be.",{"_3604":1607,"_31083":1333,"_21524":55688,"_5":14790,"_28264":54982,"_3060":55689},[],"**Cause:** The shadow feature is disabled in the DMS configuration, the connector's credentials lack IoT data-plane permissions, or the firmware reads a different shadow than the configured one.",{"_3604":1608,"_31083":1333,"_21524":55691,"_5":14790,"_28264":54982,"_3060":55692},[],"**Resolution:** Check that `shadow_config.enable` is `true` in the connector metadata for the corresponding DMS. If a Named Shadow is used, verify `shadow_config.shadow_name` holds the correct name and that the firmware reads that Named Shadow and not the Classic Shadow. Confirm the connector's credentials have `iotdata:GetThingShadow` and `iotdata:UpdateThingShadow` permissions.",{"_3604":1609,"_31083":1333,"_21524":55694,"_5":14790,"_28264":54982,"_3060":55695},[],"**Symptom:** After editing a DMS in `jitp` mode, DMS update messages appear in `lamassu-dlq`, or JITP configuration changes have no effect in AWS.",{"_3604":1610,"_31083":1333,"_21524":55697,"_5":14790,"_28264":54982,"_3060":55698},[],"**Cause:** Every full DMS edit (`PUT /v1/dms/{id}`) triggers a `CreateProvisioningTemplate` attempt for the template named after the DMS ID, and the call is not idempotent: when the template already exists, it fails, the event is retried three times and finally lands in `lamassu-dlq`. The connector’s later steps are skipped.",{"_3604":1611,"_31083":1333,"_21524":55700,"_5":14790,"_28264":54982,"_3060":55701},[],"**Resolution:** Check that the template named with the DMS ID exists in AWS IoT Core and that JITP enrollment works. If the JITP configuration was changed, apply it by hand to the AWS template.",{"_3604":1612,"_31083":1333,"_21524":55703,"_5":14790,"_28264":54982,"_3060":55704},[],"<Card title=\"Configure a DMS\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_3604":1613,"_31083":1333,"_21524":55706,"_5":14790,"_28264":54982,"_3060":55707},[],"<Card title=\"Device enrollment (EST)\" href=\"/docs/platform/iot-fleets/enrollment/overview\" />",{"_3604":1614,"_31083":1333,"_21524":55709,"_5":14790,"_28264":54982,"_3060":55710},[],"<Card title=\"Certificate management\" href=\"/docs/platform/pki/certificates\" />",{"_3604":1615,"_31083":1615,"_5":15155,"_3060":53414,"_31421":55712,"_21524":55713,"_28264":1615},[50730,52242,53414],[],{"_3604":1616,"_31083":1615,"_21524":55715,"_5":14790,"_28264":1615,"_3060":55716},[],"Organize devices and their identities, prepare enrollment and integrate consumers.",{"_3604":1617,"_31083":1615,"_5":31418,"_21524":55718,"_28264":55719,"_3060":55720},[],"/docs/platform/iot-fleets/overview#start-here","Start here",{"_3604":1618,"_31083":1615,"_5":31418,"_21524":55722,"_28264":55723,"_3060":53412},[],"/docs/platform/iot-fleets/overview#devices-and-identities",{"_3604":1619,"_31083":1615,"_5":31418,"_21524":55725,"_28264":55726,"_3060":53598},[],"/docs/platform/iot-fleets/overview#enrollment-with-pki",{"_3604":1620,"_31083":1615,"_5":31418,"_21524":55728,"_28264":55729,"_3060":54879},[],"/docs/platform/iot-fleets/overview#integrations",{"_3604":1621,"_31083":1615,"_5":31418,"_21524":55731,"_28264":55732,"_3060":55733},[],"/docs/platform/iot-fleets/overview#who-prepares-each-part","Who prepares each part",{"_3604":1622,"_31083":1615,"_21524":55735,"_5":14790,"_28264":1615,"_3060":55736},[],"IoT Fleets applies PKI to the device lifecycle: registration, obtaining an identity, renewal and retirement. It is intended for those who administer a device population and those who integrate its enrollment client or the system that accepts it.",{"_3604":1623,"_31083":1615,"_21524":55738,"_5":14790,"_28264":55719,"_3060":55739},[],"Follow Enroll and connect your first device to prepare a DMS, obtain the identity from the client and demonstrate an mTLS connection. The automatic path includes initial trust, a CSR and result checks.",{"_3604":1624,"_31083":1615,"_21524":55741,"_5":14790,"_28264":55719,"_3060":55742},[],"To start with an existing certificate, use Register a device manually. You can then prepare enrollment and renewal for the next device.",{"_3604":1625,"_31083":1615,"_21524":55744,"_5":14790,"_28264":55723,"_3060":55745},[],"Resource",{"_3604":1626,"_31083":1615,"_21524":55747,"_5":14790,"_28264":55723,"_3060":55748},[],"What it represents",{"_3604":1627,"_31083":1615,"_21524":55750,"_5":14790,"_28264":55723,"_3060":55751},[],"**Device**",{"_3604":1628,"_31083":1615,"_21524":55753,"_5":14790,"_28264":55723,"_3060":55754},[],"An inventory entry with an identifier, owning DMS and classification.",{"_3604":1629,"_31083":1615,"_21524":55756,"_5":14790,"_28264":55723,"_3060":55757},[],"**Identity**",{"_3604":1630,"_31083":1615,"_21524":55759,"_5":14790,"_28264":55723,"_3060":55760},[],"The device's association with its certificates: an active version and a history.",{"_3604":1631,"_31083":1615,"_21524":55762,"_5":14790,"_28264":55723,"_3060":55763},[],"**DMS**",{"_3604":1632,"_31083":1615,"_21524":55765,"_5":14790,"_28264":55723,"_3060":55766},[],"The service that configures admission, enrollment, renewal and trust distribution.",{"_3604":1633,"_31083":1615,"_21524":55768,"_5":14790,"_28264":55723,"_3060":55769},[],"**Fleet**",{"_3604":1634,"_31083":1615,"_21524":55771,"_5":14790,"_28264":55723,"_3060":55772},[],"The population you operate, represented through devices, DMSs, tags and metadata.",{"_3604":1635,"_31083":1615,"_21524":55774,"_5":14790,"_28264":55723,"_3060":55775},[],"Each device has an owning DMS. You can organize a population through several DMSs when it needs different policies, and use tags to classify it. “Fleet” describes that operational context; the resources you create and query are DMSs and devices.",{"_3604":1636,"_31083":1615,"_21524":55777,"_5":14790,"_28264":55723,"_3060":55778},[],"Device management covers states, certificate history and identity actions. During renewal, retain the relationship with the device and check which certificate becomes the current identity.",{"_3604":1637,"_31083":1615,"_21524":55780,"_5":14790,"_28264":55726,"_3060":55781},[],"This section connects PKI rules to the device client. Preparation follows this order:",{"_3604":1638,"_31083":1615,"_21524":55783,"_5":14790,"_28264":55726,"_3060":55784},[],"**CA and profile:** prepare the issuer and certificate rules in PKI.",{"_3604":1639,"_31083":1615,"_21524":55786,"_5":14790,"_28264":55726,"_3060":55787},[],"**DMS policy:** define how the device is admitted, how requests authenticate and which trust is distributed.",{"_3604":1640,"_31083":1615,"_21524":55789,"_5":14790,"_28264":55726,"_3060":55790},[],"**Client:** prepare the initial credential, server trust, and key generation or custody.",{"_3604":1641,"_31083":1615,"_21524":55792,"_5":14790,"_28264":55726,"_3060":55793},[],"**Result:** request the certificate, install it and check its association with the device.",{"_3604":1642,"_31083":1615,"_21524":55795,"_5":14790,"_28264":55726,"_3060":55796},[],"**Continuity:** configure renewal, successor installation and recovery according to DMS policy.",{"_3604":1643,"_31083":1615,"_21524":55798,"_5":14790,"_28264":55726,"_3060":55799},[],"<Card title=\"Configure the DMS\" description=\"Prepare the CA, admission, authentication and renewal rules.\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_3604":1644,"_31083":1615,"_21524":55801,"_5":14790,"_28264":55726,"_3060":55802},[],"<Card title=\"Integrate the EST client\" description=\"Review the device endpoints, formats and checks.\" href=\"/docs/platform/iot-fleets/enrollment/est-client\" />",{"_3604":1645,"_31083":1615,"_21524":55804,"_5":14790,"_28264":55729,"_3060":55805},[],"An issued identity needs a consumer that trusts its issuer, validates the certificate and grants the device permissions. Prepare both the device's trust in the server and the server's trust in the device.",{"_3604":1646,"_31083":1615,"_21524":55807,"_5":14790,"_28264":55729,"_3060":55808},[],"The AWS IoT Core guide explains how to use the identity in that destination. Provisioning in Lamassu and provisioning in the destination are separate decisions; review the conditions of the chosen mode before expecting state synchronization.",{"_3604":1647,"_31083":1615,"_21524":55810,"_5":14790,"_28264":55732,"_3060":55811},[],"Participant",{"_3604":1648,"_31083":1615,"_21524":55813,"_5":14790,"_28264":55732,"_3060":55814},[],"Responsibility",{"_3604":1649,"_31083":1615,"_21524":55816,"_5":14790,"_28264":55732,"_3060":55817},[],"PKI administrator",{"_3604":1650,"_31083":1615,"_21524":55819,"_5":14790,"_28264":55732,"_3060":55820},[],"CA, issuance profile, chain and revocation publication.",{"_3604":1651,"_31083":1615,"_21524":55822,"_5":14790,"_28264":55732,"_3060":55823},[],"Provisioning administrator",{"_3604":1652,"_31083":1615,"_21524":55825,"_5":14790,"_28264":55732,"_3060":55826},[],"DMS, admission, authentication per operation and inventory.",{"_3604":1653,"_31083":1615,"_21524":55828,"_5":14790,"_28264":55732,"_3060":55829},[],"Device integrator",{"_3604":1654,"_31083":1615,"_21524":55831,"_5":14790,"_28264":55732,"_3060":55832},[],"Initial credential, key, EST client, trust and certificate installation.",{"_3604":1655,"_31083":1615,"_21524":55834,"_5":14790,"_28264":55732,"_3060":55835},[],"Consumer integrator",{"_3604":1656,"_31083":1615,"_21524":55837,"_5":14790,"_28264":55732,"_3060":55838},[],"Trusted issuers, validation and device permissions in the destination.",{"_3604":1657,"_31083":1615,"_21524":55840,"_5":14790,"_28264":55732,"_3060":55841},[],"Permissions and audit are shared with the rest of Platform. Prepare installation and instance connectivity in Deployment.",{"_3604":1658,"_31083":1658,"_5":15155,"_3060":55843,"_31421":55844,"_21524":55846,"_28264":1658},"Enroll and connect your first device",[50730,52242,53414,55845],"Getting started",[],{"_3604":1659,"_31083":1658,"_21524":55848,"_5":14790,"_28264":1658,"_3060":55849},[],"Obtain an identity through EST, verify its association and use it in an mTLS connection.",{"_3604":1660,"_31083":1658,"_5":31418,"_21524":55851,"_28264":55852,"_3060":50740},[],"/docs/platform/iot-fleets/quickstarts/enroll-device#before-you-begin",{"_3604":1661,"_31083":1658,"_5":31418,"_21524":55854,"_28264":55855,"_3060":55856},[],"/docs/platform/iot-fleets/quickstarts/enroll-device#prepare-the-bootstrap-credential","Prepare the bootstrap credential",{"_3604":1662,"_31083":1658,"_5":31418,"_21524":55858,"_28264":55859,"_3060":55860},[],"/docs/platform/iot-fleets/quickstarts/enroll-device#configure-the-evaluation-dms","Configure the evaluation DMS",{"_3604":1663,"_31083":1658,"_5":31418,"_21524":55862,"_28264":55863,"_3060":55864},[],"/docs/platform/iot-fleets/quickstarts/enroll-device#prepare-the-client-and-check-cacerts","Prepare the client and check cacerts",{"_3604":1664,"_31083":1658,"_5":31418,"_21524":55866,"_28264":55867,"_3060":55868},[],"/docs/platform/iot-fleets/quickstarts/enroll-device#enroll-the-device","Enroll the device",{"_3604":1665,"_31083":1658,"_5":31418,"_21524":55870,"_28264":55871,"_3060":55872},[],"/docs/platform/iot-fleets/quickstarts/enroll-device#verify-the-obtained-identity","Verify the obtained identity",{"_3604":1666,"_31083":1658,"_5":31418,"_21524":55874,"_28264":55875,"_3060":55876},[],"/docs/platform/iot-fleets/quickstarts/enroll-device#demonstrate-an-mtls-connection","Demonstrate an mTLS connection",{"_3604":1667,"_31083":1658,"_5":31418,"_21524":55878,"_28264":55879,"_3060":55880},[],"/docs/platform/iot-fleets/quickstarts/enroll-device#result-and-continuity","Result and continuity",{"_3604":1668,"_31083":1658,"_21524":55882,"_5":14790,"_28264":1658,"_3060":55883},[],"Prepare an evaluation DMS, enroll `est-device-001` from the client and use its identity with a local consumer that requires a certificate. The path connects administrator policy to the material the device actually installs.",{"_3604":1669,"_31083":1658,"_21524":55885,"_5":14790,"_28264":55852,"_3060":55886},[],"A Lamassu instance accessible through HTTPS and permissions for CAs, profiles, DMSs and reading devices/certificates.",{"_3604":1670,"_31083":1658,"_21524":55888,"_5":14790,"_28264":55852,"_3060":55889},[],"Bash, OpenSSL 3.x, curl with `--fail-with-body` and two terminals on your computer. Work in a new directory with restricted access.",{"_3604":1671,"_31083":1658,"_21524":55891,"_5":14790,"_28264":55852,"_3060":55892},[],"An active root CA that issues directly, with an available key and sufficient validity. Follow Create your first CA. Save its verified public certificate as `device-root.pem`.",{"_3604":1672,"_31083":1658,"_21524":55894,"_5":14790,"_28264":55852,"_3060":55895},[],"Available global identifier `est-device-001`. This path uses automatic registration: do not create the device in the console first.",{"_3604":1673,"_31083":1658,"_21524":55897,"_5":14790,"_28264":55852,"_3060":55898},[],"The approved root for Lamassu HTTPS in `est-trust.pem`, obtained through an independent channel. It can differ from the device CA; prepare networking/TLS in Deployment.",{"_3604":1674,"_31083":1658,"_21524":55900,"_5":14790,"_28264":55855,"_3060":55901},[],"Issue a bootstrap leaf certificate with `CN=est-device-001`, its own key and Client Authentication use. Follow Issue and verify a certificate, changing its CN and saving the result as `bootstrap.crt` and `bootstrap.key`. Choose validity that covers this test and check the pair and chain.",{"_3604":1675,"_31083":1658,"_21524":55903,"_5":14790,"_28264":55855,"_3060":55904},[],"The same root CA can issue it for this isolated evaluation. The operational identity will have a different key and certificate. The matching CN makes the example easier to read; initial certificate authentication does not itself bind the bootstrap CN to the requested ID. Review admission before applying the policy to a population.",{"_3604":1676,"_31083":1658,"_21524":55906,"_5":14790,"_28264":55859,"_3060":55907},[],"Create an explicit leaf profile compatible with EC P-256, with **Honor Subject**, CN from the CSR, **Digital Signature**, **Client Authentication** and **1 hour** validity within the root's validity. Do not enable CA signing. Rules and precedence are explained in Profiles.",{"_3604":1677,"_31083":1658,"_21524":55909,"_5":14790,"_28264":55859,"_3060":55910},[],"Create the `Acme EST Evaluation` DMS with this configuration:",{"_3604":1678,"_31083":1658,"_21524":55912,"_5":14790,"_28264":55859,"_3060":55913},[],"Setting",{"_3604":1679,"_31083":1658,"_21524":55915,"_5":14790,"_28264":55859,"_3060":55916},[],"Evaluation value",{"_3604":1680,"_31083":1658,"_21524":55918,"_5":14790,"_28264":55859,"_3060":55919},[],"Enrollment CA",{"_3604":1681,"_31083":1658,"_21524":55921,"_5":14790,"_28264":55859,"_3060":55922},[],"Issuing root from `device-root.pem`.",{"_3604":1682,"_31083":1658,"_21524":55924,"_5":14790,"_28264":55859,"_3060":53728},[],{"_3604":1683,"_31083":1658,"_21524":55926,"_5":14790,"_28264":55859,"_3060":55927},[],"The 1-hour leaf profile you just prepared.",{"_3604":1684,"_31083":1658,"_21524":55929,"_5":14790,"_28264":55859,"_3060":55930},[],"Protocol / Registration Mode",{"_3604":1685,"_31083":1658,"_21524":55932,"_5":14790,"_28264":55859,"_3060":55933},[],"`EST_RFC7030` / `JITP`.",{"_3604":1686,"_31083":1658,"_21524":55935,"_5":14790,"_28264":55859,"_3060":55936},[],"Verify CSR Signature",{"_3604":1687,"_31083":1658,"_21524":55938,"_5":14790,"_28264":55859,"_3060":55939},[],"Enabled.",{"_3604":1688,"_31083":1658,"_21524":55941,"_5":14790,"_28264":55859,"_3060":55942},[],"Enable Replaceable Enrollment",{"_3604":1689,"_31083":1658,"_21524":55944,"_5":14790,"_28264":55859,"_3060":55945},[],"Disabled; the ID must be new.",{"_3604":1690,"_31083":1658,"_21524":55947,"_5":14790,"_28264":55859,"_3060":55948},[],"Initial authentication",{"_3604":1691,"_31083":1658,"_21524":55950,"_5":14790,"_28264":55859,"_3060":55951},[],"`CLIENT_CERTIFICATE`; Validation CAs includes the direct bootstrap issuer; no expired certificates.",{"_3604":1692,"_31083":1658,"_21524":55953,"_5":14790,"_28264":55859,"_3060":55954},[],"Renewal authentication",{"_3604":1693,"_31083":1658,"_21524":55956,"_5":14790,"_28264":55859,"_3060":55957},[],"`CLIENT_CERTIFICATE`, configured in the independent re-enrollment block.",{"_3604":1694,"_31083":1658,"_21524":55959,"_5":14790,"_28264":55859,"_3060":55960},[],"Re-enrollment Validation CAs / Enable Expired Renewal",{"_3604":1695,"_31083":1658,"_21524":55962,"_5":14790,"_28264":55859,"_3060":55963},[],"Not needed for this direct issuance; the Enrollment CA is always trusted for re-enrollment / disabled.",{"_3604":1696,"_31083":1658,"_21524":55965,"_5":14790,"_28264":55859,"_3060":55966},[],"Re-enrollment Delta",{"_3604":1697,"_31083":1658,"_21524":55968,"_5":14790,"_28264":55859,"_3060":55969},[],"1 hour.",{"_3604":1698,"_31083":1658,"_21524":55971,"_5":14790,"_28264":55859,"_3060":55972},[],"Preventive / Critical Delta",{"_3604":1699,"_31083":1658,"_21524":55974,"_5":14790,"_28264":55859,"_3060":55975},[],"30 minutes / 10 minutes.",{"_3604":1700,"_31083":1658,"_21524":55977,"_5":14790,"_28264":55859,"_3060":55978},[],"Revoke on Re-enrollment",{"_3604":1701,"_31083":1658,"_21524":55980,"_5":14790,"_28264":55859,"_3060":55981},[],"Disabled to test the successor before retiring the previous identity.",{"_3604":1702,"_31083":1658,"_21524":55983,"_5":14790,"_28264":55859,"_3060":53736},[],{"_3604":1703,"_31083":1658,"_21524":55985,"_5":14790,"_28264":55859,"_3060":55986},[],"Disabled; the operational key is generated in the client.",{"_3604":1704,"_31083":1658,"_21524":55988,"_5":14790,"_28264":55859,"_3060":55989},[],"CA Distribution",{"_3604":1705,"_31083":1658,"_21524":55991,"_5":14790,"_28264":55859,"_3060":55992},[],"Include Enrollment CA enabled; Include Lamassu System CA disabled.",{"_3604":1706,"_31083":1658,"_21524":55994,"_5":14790,"_28264":55859,"_3060":55995},[],"Equal duration and window allow immediate renewal testing. These are evaluation values; size production settings according to connectivity and recovery times. Save, reread both authentication blocks and retain the DMS ID. The console exposes independent editors for the enrollment and re-enrollment authentication; the DMS guide describes their fields, and you can also check the resource through the DMS API.",{"_3604":1707,"_31083":1658,"_21524":55997,"_5":14790,"_28264":55863,"_3060":55998},[],"Place the four trust and bootstrap files in the new directory. Replace the URL with your installation's URL:",{"_3604":1708,"_31083":1658,"_21524":56000,"_5":14790,"_28264":55863,"_3060":56001},[],"The download must succeed and contain the expected enrollment root. Compare its fingerprint with `device-root.pem`. This check does not turn the response into initial trust or prove that you can issue.",{"_3604":1709,"_31083":1658,"_21524":56003,"_5":14790,"_28264":55867,"_3060":56004},[],"Generate a new key and CSR with the selected identifier:",{"_3604":1710,"_31083":1658,"_21524":56006,"_5":14790,"_28264":55867,"_3060":56007},[],"Request the identity with the bootstrap credential and extract the certificate from the default response:",{"_3604":1711,"_31083":1658,"_21524":56009,"_5":14790,"_28264":55867,"_3060":56010},[],"If curl fails, use Troubleshooting with the saved body. Do not convert it or repeat the request without querying inventory: a timeout or error can follow persisted issuance.",{"_3604":1712,"_31083":1658,"_21524":56012,"_5":14790,"_28264":55871,"_3060":56013},[],"Expect `device.crt: OK` and exit code 0 from `cmp`. Check the CN, serial, dates, Digital Signature and Client Authentication. The certificate must be a leaf: it must not declare `CA:TRUE` or Certificate Sign use. Check that its validity matches the one-hour profile.",{"_3604":1713,"_31083":1658,"_21524":56015,"_5":14790,"_28264":55871,"_3060":56016},[],"In Lamassu, open `est-device-001`. It must be created with the intended owning DMS, a current identity and the received certificate in its history. Compare the local serial with the slot; thresholds can show a renewal state rather than simply Active.",{"_3604":1714,"_31083":1658,"_21524":56018,"_5":14790,"_28264":55875,"_3060":56019},[],"In a second terminal, enter the same directory and run `umask 077`. Create a local server certificate and start a test consumer. This server trusts `device-root.pem` and requires a valid client identity:",{"_3604":1715,"_31083":1658,"_21524":56021,"_5":14790,"_28264":55875,"_3060":56022},[],"Leave it running. In the first terminal, connect using the obtained identity:",{"_3604":1716,"_31083":1658,"_21524":56024,"_5":14790,"_28264":55875,"_3060":56025},[],"Expect HTTP `200`. The client's trust in this local server is its self-signed `consumer.crt`; the server verifies the device against `device-root.pem`. The HTML file displays OpenSSL diagnostic information.",{"_3604":1717,"_31083":1658,"_21524":56027,"_5":14790,"_28264":55875,"_3060":56028},[],"With the same server still running, test that a request without a client certificate is rejected:",{"_3604":1718,"_31083":1658,"_21524":56030,"_5":14790,"_28264":55875,"_3060":56031},[],"Rejection must correspond to a missing certificate at the server, not a stopped server. Stop the consumer with Ctrl+C after the test. This exercise demonstrates TLS authentication and key possession; your application must also define authorization and revocation consumption. Server options are described in openssl-s\\_server.",{"_3604":1719,"_31083":1658,"_21524":56033,"_5":14790,"_28264":55879,"_3060":56034},[],"Check",{"_3604":1720,"_31083":1658,"_21524":56036,"_5":14790,"_28264":55879,"_3060":56037},[],"Expected result",{"_3604":1721,"_31083":1658,"_21524":56039,"_5":14790,"_28264":55879,"_3060":56040},[],"Registration",{"_3604":1722,"_31083":1658,"_21524":56042,"_5":14790,"_28264":55879,"_3060":56043},[],"ID created automatically and correct DMS.",{"_3604":1723,"_31083":1658,"_21524":56045,"_5":14790,"_28264":55879,"_3060":55301},[],{"_3604":1724,"_31083":1658,"_21524":56047,"_5":14790,"_28264":55879,"_3060":56048},[],"CN, profile, serial and key verified.",{"_3604":1725,"_31083":1658,"_21524":56050,"_5":14790,"_28264":55879,"_3060":56051},[],"Inventory",{"_3604":1726,"_31083":1658,"_21524":56053,"_5":14790,"_28264":55879,"_3060":56054},[],"Received serial visible as the current identity and in history.",{"_3604":1727,"_31083":1658,"_21524":56056,"_5":14790,"_28264":55879,"_3060":56057},[],"Consumer",{"_3604":1728,"_31083":1658,"_21524":56059,"_5":14790,"_28264":55879,"_3060":56060},[],"mTLS responds 200 with the identity and rejects a missing certificate.",{"_3604":1729,"_31083":1658,"_21524":56062,"_5":14790,"_28264":55879,"_3060":56063},[],"Continue with Renewal and recovery to request a successor pair within the window, install it and repeat the mTLS check. The consumer must use the new files in that test. After checking the successor, retire the previous certificate according to PKI policy; the example does not revoke it automatically.",{"_3604":1730,"_31083":1658,"_21524":56065,"_5":14790,"_28264":55879,"_3060":56066},[],"Devices and identities explains retirement and the limits of historical revocation. For a real destination, prepare consumer trust, validation and permissions; AWS IoT Core is an available integration.",{"_3604":1731,"_31083":1731,"_5":15155,"_3060":53430,"_31421":56068,"_21524":56069,"_28264":1731},[50730,52242,53414,55845],[],{"_3604":1732,"_31083":1731,"_21524":56071,"_5":14790,"_28264":1731,"_3060":56072},[],"Prepare a DMS, register a device and associate a verified certificate with its identity.",{"_3604":1733,"_31083":1731,"_5":31418,"_21524":56074,"_28264":56075,"_3060":50740},[],"/docs/platform/iot-fleets/quickstarts/register-device#before-you-begin",{"_3604":1734,"_31083":1731,"_5":31418,"_21524":56077,"_28264":56078,"_3060":56079},[],"/docs/platform/iot-fleets/quickstarts/register-device#prepare-the-dms","Prepare the DMS",{"_3604":1735,"_31083":1731,"_5":31418,"_21524":56081,"_28264":56082,"_3060":56083},[],"/docs/platform/iot-fleets/quickstarts/register-device#register-the-device","Register the device",{"_3604":1736,"_31083":1731,"_5":31418,"_21524":56085,"_28264":56086,"_3060":56087},[],"/docs/platform/iot-fleets/quickstarts/register-device#check-the-initial-status","Check the initial status",{"_3604":1737,"_31083":1731,"_5":31418,"_21524":56089,"_28264":56090,"_3060":56091},[],"/docs/platform/iot-fleets/quickstarts/register-device#assign-an-identity","Assign an identity",{"_3604":1738,"_31083":1731,"_5":31418,"_21524":56093,"_28264":56094,"_3060":56095},[],"/docs/platform/iot-fleets/quickstarts/register-device#verify-the-device","Verify the device",{"_3604":1739,"_31083":1731,"_5":31418,"_21524":56097,"_28264":56098,"_3060":56037},[],"/docs/platform/iot-fleets/quickstarts/register-device#expected-result",{"_3604":1740,"_31083":1731,"_5":31418,"_21524":56100,"_28264":56101,"_3060":56102},[],"/docs/platform/iot-fleets/quickstarts/register-device#if-the-result-fails","If the result fails",{"_3604":1741,"_31083":1731,"_5":31418,"_21524":56104,"_28264":56105,"_3060":56106},[],"/docs/platform/iot-fleets/quickstarts/register-device#automate-the-next-device","Automate the next device",{"_3604":1742,"_31083":1731,"_21524":56108,"_5":14790,"_28264":1731,"_3060":56109},[],"This path is intended for those starting to administer device identities. You will register `device-001` and assign an existing certificate to check the relationship between device, DMS and identity history.",{"_3604":1743,"_31083":1731,"_21524":56111,"_5":14790,"_28264":1731,"_3060":56112},[],"Assignment updates Lamassu's inventory. Install the key and certificate separately on the device; check the connection to a consumer in that destination's integration.",{"_3604":1744,"_31083":1731,"_21524":56114,"_5":14790,"_28264":56075,"_3060":56115},[],"An accessible instance and permission to administer DMSs, devices and certificate associations.",{"_3604":1745,"_31083":1731,"_21524":56117,"_5":14790,"_28264":56075,"_3060":56118},[],"An active CA with an available key. If one does not exist yet, follow Create your first CA.",{"_3604":1746,"_31083":1731,"_21524":56120,"_5":14790,"_28264":56075,"_3060":56121},[],"An active end-entity certificate from that CA whose `Common Name` is exactly `device-001`, together with its private key. Follow Issue and verify a certificate to obtain and check both.",{"_3604":1747,"_31083":1731,"_21524":56123,"_5":14790,"_28264":56075,"_3060":56124},[],"The identifier `device-001` available in the inventory. If you already used it, choose another and issue the certificate with that same `Common Name`.",{"_3604":1748,"_31083":1731,"_21524":56126,"_5":14790,"_28264":56078,"_3060":56127},[],"A DMS must exist before registering the device. If you already have a suitable one, check its CA and note its identifier; to create one:",{"_3604":1749,"_31083":1731,"_21524":56129,"_5":14790,"_28264":56078,"_3060":56130},[],"Open the DMS inventory and its creation action. Assign a recognizable name, such as `Acme Evaluation DMS`.",{"_3604":1750,"_31083":1731,"_21524":56132,"_5":14790,"_28264":56078,"_3060":56133},[],"In **Enrollment CA**, select the CA that issued `device.crt`.",{"_3604":1751,"_31083":1731,"_21524":56135,"_5":14790,"_28264":56078,"_3060":56136},[],"In **Registration Mode**, select `PRE_REGISTRATION` for the path that starts with explicit registration.",{"_3604":1752,"_31083":1731,"_21524":56138,"_5":14790,"_28264":56078,"_3060":56139},[],"In the authentication section, enable **Require client certificate** and leave **Call external webhook** off. Under **Require client certificate**, add the CA whose initial certificates you will accept to **Validation CAs**; for this evaluation, it can be the same CA. Keep **Verify CSR Signature** enabled and leave **Enable server-side key generation** off if you will not use it.",{"_3604":1753,"_31083":1731,"_21524":56141,"_5":14790,"_28264":56078,"_3060":56142},[],"Review renewal and trust distribution settings with the DMS guide, save the service and note its identifier.",{"_3604":1754,"_31083":1731,"_21524":56144,"_5":14790,"_28264":56078,"_3060":56145},[],"Reopen the DMS and confirm that the enrollment CA is the expected one and the service appears in inventory.",{"_3604":1755,"_31083":1731,"_21524":56147,"_5":14790,"_28264":56078,"_3060":56148},[],"These settings prepare DMS policy. The next steps register and assign through the console; they do not send an EST request or test admission through that protocol.",{"_3604":1756,"_31083":1731,"_21524":56150,"_5":14790,"_28264":56082,"_3060":56151},[],"Open **Managed Devices** and the registration action. Complete:",{"_3604":1757,"_31083":1731,"_21524":56153,"_5":14790,"_28264":56082,"_3060":56154},[],"**Device ID**: `device-001`.",{"_3604":1758,"_31083":1731,"_21524":56156,"_5":14790,"_28264":56082,"_3060":56157},[],"**Registration Authority**: the DMS you just prepared; this label identifies the service fulfilling the registration authority role.",{"_3604":1759,"_31083":1731,"_21524":56159,"_5":14790,"_28264":56082,"_3060":56160},[],"**Icon** and **Tags**: optional classification.",{"_3604":1760,"_31083":1731,"_21524":56162,"_5":14790,"_28264":56082,"_3060":56163},[],"Confirm registration.",{"_3604":1761,"_31083":1731,"_21524":56165,"_5":14790,"_28264":56086,"_3060":56166},[],"Open the device. It should appear in **No Identity** and show the selected owning DMS.",{"_3604":1762,"_31083":1731,"_21524":56168,"_5":14790,"_28264":56086,"_3060":56169},[],"Registration creates the inventory entry; the certificate must still be associated.",{"_3604":1763,"_31083":1731,"_21524":56171,"_5":14790,"_28264":56090,"_3060":56172},[],"Select **Assign Identity** and the existing certificate with `CN=device-001`. Check its serial number, issuer and validity against the certificate you verified in PKI.",{"_3604":1764,"_31083":1731,"_21524":56174,"_5":14790,"_28264":56090,"_3060":56175},[],"Confirm the association. The **Issue New Instead** alternative is explained in Devices and identities.",{"_3604":1765,"_31083":1731,"_21524":56177,"_5":14790,"_28264":56094,"_3060":56178},[],"Check that it has an active identity. In **Certificate History**, verify the associated serial number; in **Device Event Timeline**, find the assignment event.",{"_3604":1766,"_31083":1731,"_21524":56180,"_5":14790,"_28264":56094,"_3060":56181},[],"Keep the device identifier, owning DMS and serial number as references for the result.",{"_3604":1767,"_31083":1731,"_21524":56183,"_5":14790,"_28264":56098,"_3060":56034},[],{"_3604":1768,"_31083":1731,"_21524":56185,"_5":14790,"_28264":56098,"_3060":56186},[],"Result",{"_3604":1769,"_31083":1731,"_21524":56188,"_5":14790,"_28264":56098,"_3060":55284},[],{"_3604":1770,"_31083":1731,"_21524":56190,"_5":14790,"_28264":56098,"_3060":56191},[],"`device-001` appears in inventory with the expected DMS.",{"_3604":1771,"_31083":1731,"_21524":56193,"_5":14790,"_28264":56098,"_3060":56194},[],"Current identity",{"_3604":1772,"_31083":1731,"_21524":56196,"_5":14790,"_28264":56098,"_3060":56197},[],"The associated certificate matches the one you verified in PKI.",{"_3604":1773,"_31083":1731,"_21524":56199,"_5":14790,"_28264":56098,"_3060":56200},[],"History",{"_3604":1774,"_31083":1731,"_21524":56202,"_5":14790,"_28264":56098,"_3060":56203},[],"The associated issuance appears with its serial number and dates.",{"_3604":1775,"_31083":1731,"_21524":56205,"_5":14790,"_28264":56098,"_3060":56206},[],"Key and certificate",{"_3604":1776,"_31083":1731,"_21524":56208,"_5":14790,"_28264":56098,"_3060":56209},[],"You have the verified pair ready to install on the device.",{"_3604":1777,"_31083":1731,"_21524":56211,"_5":14790,"_28264":56101,"_3060":56212},[],"If you cannot select the DMS, confirm its creation and your read permissions.",{"_3604":1778,"_31083":1731,"_21524":56214,"_5":14790,"_28264":56101,"_3060":56215},[],"If no eligible certificate appears, check that its `Common Name` matches the `Device ID` exactly, it is active and it was issued by the expected CA.",{"_3604":1779,"_31083":1731,"_21524":56217,"_5":14790,"_28264":56101,"_3060":56218},[],"If assignment fails, review permissions and operation diagnostics before repeating it. Query the device and its history again to find the persisted result.",{"_3604":1780,"_31083":1731,"_21524":56220,"_5":14790,"_28264":56101,"_3060":56221},[],"If an expiration or renewal state appears, check certificate dates and DMS thresholds in Devices and identities.",{"_3604":1781,"_31083":1731,"_21524":56223,"_5":14790,"_28264":56105,"_3060":56224},[],"Continue with DMS and EST for the device to request and renew certificates. Prepare server trust, the initial credential and policies for each operation before implementing the client.",{"_3604":1782,"_31083":1731,"_21524":56226,"_5":14790,"_28264":56105,"_3060":56227},[],"For a path from the client through mTLS, follow Enroll and connect your first device with a new ID.",{"_3604":1783,"_31083":1731,"_21524":56229,"_5":14790,"_28264":56105,"_3060":56230},[],"To use the identity in AWS IoT Core, also prepare trust and permissions in the destination. Check the connection from the device after installing the required key, certificate and chain.",{"_3604":1784,"_31083":1784,"_5":15155,"_3060":56232,"_31421":56233,"_21524":56234,"_28264":1784},"Lamassu IoT Platform",[50730,52242],[],{"_3604":1785,"_31083":1784,"_21524":56236,"_5":14790,"_28264":1784,"_3060":56237},[],"Build a PKI and apply its certificates to your devices' lifecycle.",{"_3604":1786,"_31083":1784,"_5":31418,"_21524":56239,"_28264":56240,"_3060":55720},[],"/docs/platform/overview#start-here",{"_3604":1787,"_31083":1784,"_5":31418,"_21524":56242,"_28264":56243,"_3060":56244},[],"/docs/platform/overview#choose-your-path","Choose your path",{"_3604":1788,"_31083":1784,"_5":31418,"_21524":56246,"_28264":56247,"_3060":56248},[],"/docs/platform/overview#architecture-at-a-glance","Architecture at a glance",{"_3604":1789,"_31083":1784,"_5":31418,"_21524":56250,"_28264":56251,"_3060":56252},[],"/docs/platform/overview#core-capabilities","Core capabilities",{"_3604":1790,"_31083":1784,"_5":31418,"_21524":56254,"_28264":56255,"_3060":56256},[],"/docs/platform/overview#build-your-trust-hierarchy","Build your trust hierarchy",{"_3604":1791,"_31083":1784,"_5":31418,"_21524":56258,"_28264":56259,"_3060":56260},[],"/docs/platform/overview#protect-cryptographic-keys","Protect cryptographic keys",{"_3604":1792,"_31083":1784,"_5":31418,"_21524":56262,"_28264":56263,"_3060":56264},[],"/docs/platform/overview#issue-and-control-certificates","Issue and control certificates",{"_3604":1793,"_31083":1784,"_5":31418,"_21524":56266,"_28264":56267,"_3060":56268},[],"/docs/platform/overview#automate-device-identities","Automate device identities",{"_3604":1794,"_31083":1784,"_5":31418,"_21524":56270,"_28264":56271,"_3060":56272},[],"/docs/platform/overview#publish-validation-status","Publish validation status",{"_3604":1795,"_31083":1784,"_5":31418,"_21524":56274,"_28264":56275,"_3060":56276},[],"/docs/platform/overview#react-to-events","React to events",{"_3604":1796,"_31083":1784,"_5":31418,"_21524":56278,"_28264":56279,"_3060":56280},[],"/docs/platform/overview#operational-reference","Operational reference",{"_3604":1797,"_31083":1784,"_21524":56282,"_5":14790,"_28264":1784,"_3060":56283},[],"Lamassu IoT lets you administer a private PKI and use it to issue, renew and revoke X.509 device identities. The Platform documentation follows two paths: **PKI**, for authorities and certificates, and **IoT Fleets**, for applying those identities to a device population.",{"_3604":1798,"_31083":1784,"_21524":56285,"_5":14790,"_28264":56240,"_3060":56286},[],"Choose the result you need:",{"_3604":1799,"_31083":1784,"_21524":56288,"_5":14790,"_28264":56240,"_3060":56289},[],"<Card title=\"Issue and verify a certificate\" description=\"Prepare a CA, issue an X.509 identity and check its chain and key.\" href=\"/docs/platform/pki/quickstarts/overview\" />",{"_3604":1800,"_31083":1784,"_21524":56291,"_5":14790,"_28264":56240,"_3060":56292},[],"<Card title=\"Enroll and connect a device\" description=\"Prepare the DMS, request an identity through EST and check an mTLS connection.\" href=\"/docs/platform/iot-fleets/quickstarts/enroll-device\" />",{"_3604":1801,"_31083":1784,"_21524":56294,"_5":14790,"_28264":56240,"_3060":56295},[],"If you are still preparing the instance, start in Deployment. The Platform paths assume an accessible console and permission to perform the operations.",{"_3604":1802,"_31083":1784,"_21524":56297,"_5":14790,"_28264":56243,"_3060":56298},[],"Section",{"_3604":1803,"_31083":1784,"_21524":56300,"_5":14790,"_28264":56243,"_3060":56301},[],"What you manage",{"_3604":1804,"_31083":1784,"_21524":56303,"_5":14790,"_28264":56243,"_3060":56304},[],"Entry point",{"_3604":1805,"_31083":1784,"_21524":56306,"_5":14790,"_28264":56243,"_3060":56307},[],"**PKI**",{"_3604":1806,"_31083":1784,"_21524":56309,"_5":14790,"_28264":56243,"_3060":56310},[],"Keys, authorities, profiles, certificates and publication of revocation status.",{"_3604":1807,"_31083":1784,"_21524":56312,"_5":14790,"_28264":56243,"_3060":56313},[],"PKI overview",{"_3604":1808,"_31083":1784,"_21524":56315,"_5":14790,"_28264":56243,"_3060":56316},[],"**IoT Fleets**",{"_3604":1809,"_31083":1784,"_21524":56318,"_5":14790,"_28264":56243,"_3060":56319},[],"Devices, identity history, DMS policies, EST enrollment and integrations.",{"_3604":1810,"_31083":1784,"_21524":56321,"_5":14790,"_28264":56243,"_3060":56322},[],"IoT Fleets overview",{"_3604":1811,"_31083":1784,"_21524":56324,"_5":14790,"_28264":56243,"_3060":56325},[],"**Administration**",{"_3604":1812,"_31083":1784,"_21524":56327,"_5":14790,"_28264":56243,"_3060":56328},[],"Operator permissions, audit and event subscriptions.",{"_3604":1813,"_31083":1784,"_21524":56330,"_5":14790,"_28264":56243,"_3060":52244},[],{"_3604":1814,"_31083":1784,"_21524":56332,"_5":14790,"_28264":56243,"_3060":56333},[],"A CA determines who signs, and a profile defines what can be issued. The DMS applies admission and enrollment policy. The device retains its association with certificates, and the external consumer decides which identity it accepts.",{"_3604":1815,"_31083":1784,"_21524":56335,"_5":14790,"_28264":56247,"_3060":56336},[],"An identity's journey connects four responsibilities:",{"_3604":1816,"_31083":1784,"_21524":56338,"_5":14790,"_28264":56247,"_3060":56339},[],"The PKI administrator prepares the authority, its key and issuance rules.",{"_3604":1817,"_31083":1784,"_21524":56341,"_5":14790,"_28264":56247,"_3060":56342},[],"The provisioning administrator configures the DMS and initial trust.",{"_3604":1818,"_31083":1784,"_21524":56344,"_5":14790,"_28264":56247,"_3060":56345},[],"The device client requests a certificate and installs it with the matching key.",{"_3604":1819,"_31083":1784,"_21524":56347,"_5":14790,"_28264":56247,"_3060":56348},[],"The consumer validates the identity and applies its access permissions.",{"_3604":1820,"_31083":1784,"_21524":56350,"_5":14790,"_28264":56247,"_3060":56351},[],"See How Lamassu works to understand the resources and platform architecture for the services. Installation, network exposure and dependencies are explained in Deployment.",{"_3604":1821,"_31083":1784,"_21524":56353,"_5":14790,"_28264":56255,"_3060":56354},[],"Create or incorporate authorities and organize their relationships in PKI. The hierarchy and its rotation determine which chains consumers must recognize.",{"_3604":1822,"_31083":1784,"_21524":56356,"_5":14790,"_28264":56259,"_3060":56357},[],"Choose the engine that keeps authority keys and control who can use them. See Keys and engines; provider setup belongs to deployment.",{"_3604":1823,"_31083":1784,"_21524":56359,"_5":14790,"_28264":56263,"_3060":56360},[],"Define issuance profiles, sign requests and review the certificate inventory. Check the issued certificate from the client that will use it.",{"_3604":1824,"_31083":1784,"_21524":56362,"_5":14790,"_28264":56267,"_3060":56363},[],"Configure a DMS and use EST to request and renew certificates. Preparing the initial credential and installing the result belong to device integration.",{"_3604":1825,"_31083":1784,"_21524":56365,"_5":14790,"_28264":56271,"_3060":56366},[],"Use OCSP and CRL to publish revocation status. Each consumer must configure how it retrieves and applies that information.",{"_3604":1826,"_31083":1784,"_21524":56368,"_5":14790,"_28264":56275,"_3060":56369},[],"Use audit logs to investigate changes and configure alerts and subscriptions to react to lifecycle events.",{"_3604":1827,"_31083":1784,"_21524":56371,"_5":14790,"_28264":56279,"_3060":55814},[],{"_3604":1828,"_31083":1784,"_21524":56373,"_5":14790,"_28264":56279,"_3060":56374},[],"What it prepares or checks",{"_3604":1829,"_31083":1784,"_21524":56376,"_5":14790,"_28264":56279,"_3060":55817},[],{"_3604":1830,"_31083":1784,"_21524":56378,"_5":14790,"_28264":56279,"_3060":56379},[],"Key custody, CA hierarchy, profiles and validation.",{"_3604":1831,"_31083":1784,"_21524":56381,"_5":14790,"_28264":56279,"_3060":56382},[],"Fleet administrator",{"_3604":1832,"_31083":1784,"_21524":56384,"_5":14790,"_28264":56279,"_3060":56385},[],"DMS, device admission, renewal policy and inventory.",{"_3604":1833,"_31083":1784,"_21524":56387,"_5":14790,"_28264":56279,"_3060":55829},[],{"_3604":1834,"_31083":1784,"_21524":56389,"_5":14790,"_28264":56279,"_3060":56390},[],"Initial credential, server trust, EST client, and key and certificate storage.",{"_3604":1835,"_31083":1784,"_21524":56392,"_5":14790,"_28264":56279,"_3060":55835},[],{"_3604":1836,"_31083":1784,"_21524":56394,"_5":14790,"_28264":56279,"_3060":56395},[],"Issuer trust, certificate validation and permissions in the destination.",{"_3604":1837,"_31083":1784,"_21524":56397,"_5":14790,"_28264":56279,"_3060":56398},[],"Infrastructure operator",{"_3604":1838,"_31083":1784,"_21524":56400,"_5":14790,"_28264":56279,"_3060":56401},[],"Installation, network, availability, dependencies and deployment diagnosis.",{"_3604":1839,"_31083":1784,"_21524":56403,"_5":14790,"_28264":56279,"_3060":56404},[],"The API reference contains contracts for automating operations. To investigate a failure, start in the affected section: PKI, EST or Deployment.",{"_3604":1840,"_31083":1840,"_5":15155,"_3060":56406,"_31421":56407,"_21524":56410,"_28264":1840},"CA hierarchy and rotation",[50730,52242,56408,56409],"PKI","Keys, authorities and certificates",[],{"_3604":1841,"_31083":1840,"_21524":56412,"_5":14790,"_28264":1840,"_3060":56413},[],"Design root and intermediate authorities and replace certificates or keys without breaking trust.",{"_3604":1842,"_31083":1840,"_5":31418,"_21524":56415,"_28264":56416,"_3060":56417},[],"/docs/platform/pki/ca-hierarchy-and-rotation#design-the-hierarchy","Design the hierarchy",{"_3604":1843,"_31083":1840,"_5":31418,"_21524":56419,"_28264":56420,"_3060":56421},[],"/docs/platform/pki/ca-hierarchy-and-rotation#reissuance-and-rotation-are-not-the-same","Reissuance and rotation are not the same",{"_3604":1844,"_31083":1840,"_5":31418,"_21524":56423,"_28264":56424,"_3060":56425},[],"/docs/platform/pki/ca-hierarchy-and-rotation#when-to-choose-each-operation","When to choose each operation",{"_3604":1845,"_31083":1840,"_5":31418,"_21524":56427,"_28264":56428,"_3060":56429},[],"/docs/platform/pki/ca-hierarchy-and-rotation#key-rotation-procedure","Key rotation procedure",{"_3604":1846,"_31083":1840,"_5":31418,"_21524":56431,"_28264":56432,"_3060":56433},[],"/docs/platform/pki/ca-hierarchy-and-rotation#inventory-the-dependencies","Inventory the dependencies",{"_3604":1847,"_31083":1840,"_5":31418,"_21524":56435,"_28264":56436,"_3060":56437},[],"/docs/platform/pki/ca-hierarchy-and-rotation#create-the-successor-ca","Create the successor CA",{"_3604":1848,"_31083":1840,"_5":31418,"_21524":56439,"_28264":56440,"_3060":56441},[],"/docs/platform/pki/ca-hierarchy-and-rotation#distribute-the-new-trust","Distribute the new trust",{"_3604":1849,"_31083":1840,"_5":31418,"_21524":56443,"_28264":56444,"_3060":56445},[],"/docs/platform/pki/ca-hierarchy-and-rotation#switch-issuance","Switch issuance",{"_3604":1850,"_31083":1840,"_5":31418,"_21524":56447,"_28264":56448,"_3060":56449},[],"/docs/platform/pki/ca-hierarchy-and-rotation#renew-in-batches","Renew in batches",{"_3604":1851,"_31083":1840,"_5":31418,"_21524":56451,"_28264":56452,"_3060":56453},[],"/docs/platform/pki/ca-hierarchy-and-rotation#close-the-overlap","Close the overlap",{"_3604":1852,"_31083":1840,"_5":31418,"_21524":56455,"_28264":56456,"_3060":56457},[],"/docs/platform/pki/ca-hierarchy-and-rotation#cascading-revocation","Cascading revocation",{"_3604":1853,"_31083":1840,"_5":31418,"_21524":56459,"_28264":56460,"_3060":56461},[],"/docs/platform/pki/ca-hierarchy-and-rotation#checks-after-the-change","Checks after the change",{"_3604":1854,"_31083":1840,"_21524":56463,"_5":14790,"_28264":1840,"_3060":56464},[],"The hierarchy determines the blast radius of any error or compromise. A root signs intermediate CAs; intermediates issue the identities used by devices and services. This separation lets you isolate environments and rotate a branch without replacing all trust.",{"_3604":1855,"_31083":1840,"_21524":56466,"_5":14790,"_28264":1840,"_3060":56467},[],"This procedure is for the PKI operator replacing an authority in use. You need access to CAs, keys and profiles, a dependency inventory and coordination with trust-store and device owners. Before switching issuance, prepare a test cohort and decide the criterion for ending overlap.",{"_3604":1856,"_31083":1840,"_21524":56469,"_5":14790,"_28264":56416,"_3060":56470},[],"For a production installation, use a very restricted root and one or more operational intermediates. Separate intermediates when any of these boundaries change:",{"_3604":1857,"_31083":1840,"_21524":56472,"_5":14790,"_28264":56416,"_3060":56473},[],"environment, such as production and preproduction;",{"_3604":1858,"_31083":1840,"_21524":56475,"_5":14790,"_28264":56416,"_3060":56476},[],"owner or operating team;",{"_3604":1859,"_31083":1840,"_21524":56478,"_5":14790,"_28264":56416,"_3060":56479},[],"device family or manufacturing process;",{"_3604":1860,"_31083":1840,"_21524":56481,"_5":14790,"_28264":56416,"_3060":56482},[],"region or regulatory requirement;",{"_3604":1861,"_31083":1840,"_21524":56484,"_5":14790,"_28264":56416,"_3060":56485},[],"cryptographic engine or key policy;",{"_3604":1862,"_31083":1840,"_21524":56487,"_5":14790,"_28264":56416,"_3060":56488},[],"maintenance window and renewal cadence.",{"_3604":1863,"_31083":1840,"_21524":56490,"_5":14790,"_28264":56416,"_3060":56491},[],"Avoid deep hierarchies without a concrete need. Each level adds chain distribution, validation and one more certificate you must renew.",{"_3604":1864,"_31083":1840,"_21524":56493,"_5":14790,"_28264":56416,"_3060":56494},[],"A child CA and its end-entity certificates must expire before their issuer. Reserve a margin that allows distributing another chain and renewing dependent certificates.",{"_3604":1865,"_31083":1840,"_21524":56496,"_5":14790,"_28264":56420,"_3060":56497},[],"**Reissuing a CA** creates a new certificate over the existing key. Lamassu generates a CSR with that key, self-signs it if it is a root or asks the parent CA to sign it if it is subordinate. The new certificate becomes active and the CA points to its serial number; the old and new certificates are linked through metadata.",{"_3604":1866,"_31083":1840,"_21524":56499,"_5":14790,"_28264":56420,"_3060":56500},[],"If the CRL settings of the CA are signed by the superseded CA certificate, reissuing moves the signer to the new certificate — provided it carries `cRLSign` — and republishes the CRL. Otherwise, and for settings signed by a different certificate, the signer is kept, so check the new certificate’s key usage after reissuing. A CA with no CRL settings — for example, one imported without its key or without `cRLSign` — has them initialized by the reissue when the new certificate carries `cRLSign`; otherwise it keeps none. See the CRL guide.",{"_3604":1867,"_31083":1840,"_21524":56502,"_5":14790,"_28264":56420,"_3060":56503},[],"**Rotating a CA** creates a successor key and authority. It is the right choice in the face of compromise, a cryptographic change, an engine migration or non-exportable key policies.",{"_3604":1868,"_31083":1840,"_21524":56505,"_5":14790,"_28264":56420,"_3060":56506},[],"Lamassu does not allow reissuing an already-revoked CA or a CA whose expiration date has passed. A subordinate CA is signed by its parent, so the parent must also be `ACTIVE` and inside its validity period; otherwise the reissue fails with `400`. Plan ahead for these conditions.",{"_3604":1869,"_31083":1840,"_21524":56508,"_5":14790,"_28264":56424,"_3060":56509},[],"Reissue if the key is still trustworthy and you only need another validity period or an updated certificate.",{"_3604":1870,"_31083":1840,"_21524":56511,"_5":14790,"_28264":56424,"_3060":56512},[],"Rotate the key if compromise is suspected, the algorithm changes or you want to move custody to another engine.",{"_3604":1871,"_31083":1840,"_21524":56514,"_5":14790,"_28264":56424,"_3060":56515},[],"Create a parallel branch if you cannot update all consumers at the same time.",{"_3604":1872,"_31083":1840,"_21524":56517,"_5":14790,"_28264":56424,"_3060":56518},[],"Revoke immediately only when the risk of keeping the CA outweighs the impact of interrupting the fleet.",{"_3604":1873,"_31083":1840,"_21524":56520,"_5":14790,"_28264":56432,"_3060":56521},[],"Locate child CAs, issued certificates, DMSs, connectors and external trust stores. Include devices that may stay offline for weeks or months.",{"_3604":1874,"_31083":1840,"_21524":56523,"_5":14790,"_28264":56436,"_3060":56524},[],"Generate a new key in the planned engine, create the CA and assign it an explicit profile. Do not reuse the operational identifier to hide that it is a different generation.",{"_3604":1875,"_31083":1840,"_21524":56526,"_5":14790,"_28264":56440,"_3060":56527},[],"Add the new root or chain to consumers before issuing with it. If distributing through EST `/cacerts`, explicitly include the required managed CAs and inspect the content; including the issuer does not automatically include every intermediate. Install the new trust in a cohort and verify that it still accepts the previous identity.",{"_3604":1876,"_31083":1840,"_21524":56529,"_5":14790,"_28264":56444,"_3060":56530},[],"Update the enrollment CA and profile of the DMSs. While old-CA cohorts still renew, add the previous enrollment CA to each DMS's re-enrollment validation CAs (`reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`): the new enrollment CA is trusted automatically, but the old one was the enrollment CA and appears in no re-enrollment trust list, so without that entry its certificates can no longer renew. The DMS guide documents the setting.",{"_3604":1877,"_31083":1840,"_21524":56532,"_5":14790,"_28264":56448,"_3060":56533},[],"Migrate a small cohort, validate mTLS, OCSP and CRL from the consumer and expand progressively. Monitor which devices still present the old chain.",{"_3604":1878,"_31083":1840,"_21524":56535,"_5":14790,"_28264":56452,"_3060":56536},[],"Once no legitimate consumer depends on the previous authority, remove it from issuance, from the re-enrollment validation CAs and from the distributed CAs. Revoke it if policy requires it.",{"_3604":1879,"_31083":1840,"_21524":56538,"_5":14790,"_28264":56456,"_3060":56539},[],"Lamassu saves the CA’s revocation, then applies the same revocation to child CAs and issued certificates. Propagation continues recursively through child CAs. This is not a transaction over the whole hierarchy: some resources may have changed while other updates failed.",{"_3604":1880,"_31083":1840,"_21524":56541,"_5":14790,"_28264":56456,"_3060":56542},[],"Resources in `EXPIRED` state and resources already revoked for a final reason reject further status transitions. Per-descendant failures are logged; review the inventory and logs even when the parent operation completes.",{"_3604":1881,"_31083":1840,"_21524":56544,"_5":14790,"_28264":56456,"_3060":56545},[],"`CertificateHold` is the reversible exception. Holding a CA suspends its active sub-CAs and issued certificates with `CertificateHold` and marks them as suspended by that CA. Releasing the CA — to `ACTIVE` or to any other non-revoked status such as `EXPIRED` — reactivates exactly the descendants still on hold that carry that mark. Holds placed manually before or after the cascade are left untouched, and any later status change of a descendant clears the mark. Revoking a held CA with any other reason remains permanent: descendants are revoked with `CessationOfOperation` and cannot be restored.",{"_3604":1882,"_31083":1840,"_21524":56547,"_5":14790,"_28264":56456,"_3060":56548},[],"Before closing the change, compare the original dependency inventory with final states and verify revocation publication for each issuer. Do not use revocation as the ordinary mechanism to stop issuance: complete migration and remove the CA from operational flows.",{"_3604":1883,"_31083":1840,"_21524":56550,"_5":14790,"_28264":56460,"_3060":56551},[],"The new chain ends in an anchor installed by the consumer.",{"_3604":1884,"_31083":1840,"_21524":56553,"_5":14790,"_28264":56460,"_3060":56554},[],"New certificates contain the expected AKI, SKI, KU, EKU and SAN.",{"_3604":1885,"_31083":1840,"_21524":56556,"_5":14790,"_28264":56460,"_3060":56557},[],"The DMS delivers the correct chain through EST `/cacerts`.",{"_3604":1886,"_31083":1840,"_21524":56559,"_5":14790,"_28264":56460,"_3060":56560},[],"Re-enrollment accepts the old identity during the planned period.",{"_3604":1887,"_31083":1840,"_21524":56562,"_5":14790,"_28264":56460,"_3060":56563},[],"OCSP and CRL respond for the authorities that remain active.",{"_3604":1888,"_31083":1840,"_21524":56565,"_5":14790,"_28264":56460,"_3060":56566},[],"No DMS is left accidentally issuing from the old CA.",{"_3604":1889,"_31083":1840,"_21524":56568,"_5":14790,"_28264":56460,"_3060":56569},[],"See the Trust model to understand the DMS's CA sets and Certificate lifecycle for states and revocation effects.",{"_3604":1890,"_31083":1890,"_5":15155,"_3060":56571,"_31421":56572,"_21524":56573,"_28264":1890},"Certification authorities",[50730,52242,56408,56409],[],{"_3604":1891,"_31083":1890,"_21524":56575,"_5":14790,"_28264":1890,"_3060":56576},[],"Create, import and operate the authorities that establish your PKI's trust.",{"_3604":1892,"_31083":1890,"_5":31418,"_21524":56578,"_28264":56579,"_3060":56580},[],"/docs/platform/pki/certificate-authorities#choose-a-flow","Choose a flow",{"_3604":1893,"_31083":1890,"_5":31418,"_21524":56582,"_28264":56583,"_3060":56584},[],"/docs/platform/pki/certificate-authorities#create-a-new-authority","Create a new authority",{"_3604":1894,"_31083":1890,"_5":31418,"_21524":56586,"_28264":56587,"_3060":50740},[],"/docs/platform/pki/certificate-authorities#before-you-begin",{"_3604":1895,"_31083":1890,"_5":31418,"_21524":56589,"_28264":56590,"_3060":56591},[],"/docs/platform/pki/certificate-authorities#open-the-wizard","Open the wizard",{"_3604":1896,"_31083":1890,"_5":31418,"_21524":56593,"_28264":56594,"_3060":56595},[],"/docs/platform/pki/certificate-authorities#configure-the-key","Configure the key",{"_3604":1897,"_31083":1890,"_5":31418,"_21524":56597,"_28264":56598,"_3060":56599},[],"/docs/platform/pki/certificate-authorities#choose-the-ca-type","Choose the CA type",{"_3604":1898,"_31083":1890,"_5":31418,"_21524":56601,"_28264":56602,"_3060":56603},[],"/docs/platform/pki/certificate-authorities#define-the-identity","Define the identity",{"_3604":1899,"_31083":1890,"_5":31418,"_21524":56605,"_28264":56606,"_3060":56607},[],"/docs/platform/pki/certificate-authorities#configure-validity-and-uses","Configure validity and uses",{"_3604":1900,"_31083":1890,"_5":31418,"_21524":56609,"_28264":56610,"_3060":56611},[],"/docs/platform/pki/certificate-authorities#create-and-verify","Create and verify",{"_3604":1901,"_31083":1890,"_5":31418,"_21524":56613,"_28264":56614,"_3060":56615},[],"/docs/platform/pki/certificate-authorities#use-a-key-from-the-kms","Use a key from the KMS",{"_3604":1902,"_31083":1890,"_5":31418,"_21524":56617,"_28264":56618,"_3060":56619},[],"/docs/platform/pki/certificate-authorities#import-an-external-ca","Import an external CA",{"_3604":1903,"_31083":1890,"_5":31418,"_21524":56621,"_28264":56622,"_3060":56623},[],"/docs/platform/pki/certificate-authorities#select-the-engine","Select the engine",{"_3604":1904,"_31083":1890,"_5":31418,"_21524":56625,"_28264":56626,"_3060":56627},[],"/docs/platform/pki/certificate-authorities#load-the-material","Load the material",{"_3604":1905,"_31083":1890,"_5":31418,"_21524":56629,"_28264":56630,"_3060":56631},[],"/docs/platform/pki/certificate-authorities#define-the-default-issuance","Define the default issuance",{"_3604":1906,"_31083":1890,"_5":31418,"_21524":56633,"_28264":56634,"_3060":56635},[],"/docs/platform/pki/certificate-authorities#verify-the-import","Verify the import",{"_3604":1907,"_31083":1890,"_5":31418,"_21524":56637,"_28264":56638,"_3060":56639},[],"/docs/platform/pki/certificate-authorities#inspect-an-authority","Inspect an authority",{"_3604":1908,"_31083":1890,"_5":31418,"_21524":56641,"_28264":56642,"_3060":56643},[],"/docs/platform/pki/certificate-authorities#issue-certificates","Issue certificates",{"_3604":1909,"_31083":1890,"_5":31418,"_21524":56645,"_28264":56646,"_3060":56647},[],"/docs/platform/pki/certificate-authorities#revoke-a-ca","Revoke a CA",{"_3604":1910,"_31083":1890,"_5":31418,"_21524":56649,"_28264":56650,"_3060":56651},[],"/docs/platform/pki/certificate-authorities#assess-the-impact","Assess the impact",{"_3604":1911,"_31083":1890,"_5":31418,"_21524":56653,"_28264":56654,"_3060":56655},[],"/docs/platform/pki/certificate-authorities#start-the-revocation","Start the revocation",{"_3604":1912,"_31083":1890,"_5":31418,"_21524":56657,"_28264":56658,"_3060":56659},[],"/docs/platform/pki/certificate-authorities#confirm-the-identity","Confirm the identity",{"_3604":1913,"_31083":1890,"_5":31418,"_21524":56661,"_28264":56662,"_3060":56663},[],"/docs/platform/pki/certificate-authorities#check-the-publication","Check the publication",{"_3604":1914,"_31083":1890,"_5":31418,"_21524":56665,"_28264":56666,"_3060":56667},[],"/docs/platform/pki/certificate-authorities#delete-a-ca","Delete a CA",{"_3604":1915,"_31083":1890,"_21524":56669,"_5":14790,"_28264":1890,"_3060":56670},[],"A certification authority (CA) binds identities to public keys through signed certificates. In Lamassu you can create a new hierarchy, use a key already in the KMS or incorporate an external CA.",{"_3604":1916,"_31083":1890,"_21524":56672,"_5":14790,"_28264":1890,"_3060":56673},[],"To design a full chain or replace an authority in production, see CA hierarchy and rotation. If you need to standardize what each authority can sign, use Certificate profiles.",{"_3604":1917,"_31083":1890,"_21524":56675,"_5":14790,"_28264":1890,"_3060":56676},[],"To administer CAs, you need authority and key permissions, a reachable engine and a reviewed profile. An external consumer does not trust a CA merely because it appears in this inventory: agree root and chain distribution separately.",{"_3604":1918,"_31083":1890,"_21524":56678,"_5":14790,"_28264":56579,"_3060":56679},[],"**New CA with a new key:** create a root of trust from scratch. Lamassu generates and keeps the key pair.",{"_3604":1919,"_31083":1890,"_21524":56681,"_5":14790,"_28264":56579,"_3060":56682},[],"**New CA from the KMS:** reuse a key already registered in the platform.",{"_3604":1920,"_31083":1890,"_21524":56684,"_5":14790,"_28264":56579,"_3060":56685},[],"**Import a CA with its private key:** incorporate an external authority that Lamassu can issue with.",{"_3604":1921,"_31083":1890,"_21524":56687,"_5":14790,"_28264":56579,"_3060":56688},[],"**Import only the certificate:** register public material. If Lamassu finds its key in the KMS, it can associate it; otherwise, the CA has no usable key for issuance.",{"_3604":1922,"_31083":1890,"_21524":56690,"_5":14790,"_28264":56579,"_3060":56691},[],"First time here? Follow Create your first CA to complete the minimal journey.",{"_3604":1923,"_31083":1890,"_21524":56693,"_5":14790,"_28264":56587,"_3060":56694},[],"Decide whether the CA will be a root or an intermediate.",{"_3604":1924,"_31083":1890,"_21524":56696,"_5":14790,"_28264":56587,"_3060":56697},[],"Choose the engine that will keep the key.",{"_3604":1925,"_31083":1890,"_21524":56699,"_5":14790,"_28264":56587,"_3060":56700},[],"Define a validity longer than that of the certificates it will issue.",{"_3604":1926,"_31083":1890,"_21524":56702,"_5":14790,"_28264":56587,"_3060":56703},[],"For an intermediate CA, make sure the parent CA is active.",{"_3604":1927,"_31083":1890,"_21524":56705,"_5":14790,"_28264":56590,"_3060":56706},[],"In **Certification Authorities**, select **Create New CA** and choose to generate a new key pair.",{"_3604":1928,"_31083":1890,"_21524":56708,"_5":14790,"_28264":56594,"_3060":56709},[],"Select the cryptographic engine, the algorithm and the size or curve. Lamassu supports RSA and EC keys according to the engine's capabilities.",{"_3604":1929,"_31083":1890,"_21524":56711,"_5":14790,"_28264":56594,"_3060":56712},[],"Use only sizes and curves supported by the engine and the profile’s cryptographic policy. Read Keys and engines before reusing external material.",{"_3604":1930,"_31083":1890,"_21524":56714,"_5":14790,"_28264":56598,"_3060":56715},[],"Select **Root CA** for a self-signed authority or **Intermediate CA** for an authority signed by another CA. In the latter case, choose the issuing CA.",{"_3604":1931,"_31083":1890,"_21524":56717,"_5":14790,"_28264":56602,"_3060":56718},[],"Enter a unique **CA Name**. This name becomes the certificate's `Common Name`. Complete the Distinguished Name fields your policy requires:",{"_3604":1932,"_31083":1890,"_21524":56720,"_5":14790,"_28264":56602,"_3060":56721},[],"`C`: two-letter ISO 3166-1 country code.",{"_3604":1933,"_31083":1890,"_21524":56723,"_5":14790,"_28264":56602,"_3060":56724},[],"`ST`: state or province.",{"_3604":1934,"_31083":1890,"_21524":56726,"_5":14790,"_28264":56602,"_3060":56727},[],"`L`: locality.",{"_3604":1935,"_31083":1890,"_21524":56729,"_5":14790,"_28264":56602,"_3060":56730},[],"`O`: organization.",{"_3604":1936,"_31083":1890,"_21524":56732,"_5":14790,"_28264":56602,"_3060":56733},[],"`OU`: organizational unit.",{"_3604":1937,"_31083":1890,"_21524":56735,"_5":14790,"_28264":56602,"_3060":56736},[],"The CA's internal identifier is generated automatically and cannot be changed.",{"_3604":1938,"_31083":1890,"_21524":56738,"_5":14790,"_28264":56606,"_3060":56739},[],"Define **CA Certificate Expiration** and **Default End-Entity Certificate Issuance Expiration**. You can express a duration (`5y 8w 4d`), pick a date or use the maximum allowed date.",{"_3604":1939,"_31083":1890,"_21524":56741,"_5":14790,"_28264":56606,"_3060":56742},[],"Review the CA’s own certificate separately from the default profile for certificates it will issue later. Choose an explicit issuance policy; do not assume the form’s initial values suit your consumers.",{"_3604":1940,"_31083":1890,"_21524":56744,"_5":14790,"_28264":56610,"_3060":56745},[],"Confirm the form and open the CA. Check status, issuer, dates, associated engine and key. Download the certificate: it should contain `CA:TRUE` and a usage permitting certificate signing. Verify the self-signature for a root or the chain to your root for an intermediate. Complete a test issuance to check that the key can actually sign.",{"_3604":1941,"_31083":1890,"_21524":56747,"_5":14790,"_28264":56610,"_3060":56748},[],"Plan and verify expiration using the Profiles rules. Issuance does not automatically clamp validity to the issuer’s expiration; leave time to replace the authority and renew identities.",{"_3604":1942,"_31083":1890,"_21524":56750,"_5":14790,"_28264":56614,"_3060":56751},[],"Select &#x2A;*Create New CA (Existing Key)** when the key is already registered in Lamassu. The wizard first asks for the backing key and then shows the same configuration of type, identity, validity and profile.",{"_3604":1943,"_31083":1890,"_21524":56753,"_5":14790,"_28264":56614,"_3060":56754},[],"This flow is useful when the key was previously created in an HSM, imported through BYOK or must be reused under a specific custody policy.",{"_3604":1944,"_31083":1890,"_21524":56756,"_5":14790,"_28264":56618,"_3060":56757},[],"You need the CA certificate in PEM, its chain to a known root and, when importing it, an exportable private key. Before uploading material, verify signature, dates, `CA:TRUE`, signing usages (including `cRLSign`, without which the CA cannot publish its CRL) and public-key correspondence. The key verification procedure also compares a CA key and certificate.",{"_3604":1945,"_31083":1890,"_21524":56759,"_5":14790,"_28264":56618,"_3060":56760},[],"The backend rejects an import whose certificate lacks the CA basic constraint (`basicConstraints cA flag is not set`), whose serial number matches a stored certificate with different contents, or whose identical certificate already belongs to an existing CA. A deleted CA's certificate record is kept and can be reused when re-importing the same certificate, including its previous status. Re-importing a different certificate with that serial number is rejected; check the certificate and status after re-importing.",{"_3604":1946,"_31083":1890,"_21524":56762,"_5":14790,"_28264":56618,"_3060":56763},[],"Deleting a CA releases the key references of its own current certificate and linked reissued certificates, while keeping those records for its issuer's CRL and OCSP. It then attempts to delete the key; the KMS keeps it if other certificates still reference it, such as another CA sharing the key. Revoking certificates issued by the deleted CA does not release their own key references.",{"_3604":1947,"_31083":1890,"_21524":56765,"_5":14790,"_28264":56622,"_3060":56766},[],"Check the installation’s default engine before importing a CA with a key. CA import delegates key import to that engine; it does not guarantee arbitrary provider selection from the form. To select an engine while importing the key separately, use the KMS.",{"_3604":1948,"_31083":1890,"_21524":56768,"_5":14790,"_28264":56626,"_3060":56769},[],"Import the certificate and, when applicable, its PEM key. Register the CAs needed to identify the issuer. Registering a CA does not install it in external trust stores.",{"_3604":1949,"_31083":1890,"_21524":56771,"_5":14790,"_28264":56626,"_3060":56772},[],"The backend validates before importing any key: a duplicate CA ID and a certificate that is not a CA (missing `basicConstraints` `cA=TRUE`) are rejected, the latter with `400` `certificate is not a CA: basicConstraints cA flag is not set`. If a failure occurs after the key was imported, the key is kept in the KMS and a warning tells you to delete it manually.",{"_3604":1950,"_31083":1890,"_21524":56774,"_5":14790,"_28264":56630,"_3060":56775},[],"Associate an explicit issuance profile if the CA will sign. Check usages and dates using Profiles.",{"_3604":1951,"_31083":1890,"_21524":56777,"_5":14790,"_28264":56634,"_3060":56778},[],"Review the registered type, associated key and engine, and issuer relationship. Certificate-only import may associate an existing KMS key using the certificate’s key identifier. Without a usable key, the CA is public material and cannot sign.",{"_3604":1952,"_31083":1890,"_21524":56780,"_5":14790,"_28264":56634,"_3060":56781},[],"An imported CA whose key is in the KMS and whose certificate carries `cRLSign` receives its CRL settings and first CRL automatically; without a key in the KMS or without `cRLSign` it receives none, and this is not an import error (see CRL).",{"_3604":1953,"_31083":1890,"_21524":56783,"_5":14790,"_28264":56634,"_3060":56784},[],"For an issuing CA, complete a test issuance and check OCSP and CRL. Creating the record alone does not establish key availability, complete chain consistency or status publication.",{"_3604":1954,"_31083":1890,"_21524":56786,"_5":14790,"_28264":56638,"_3060":56787},[],"Open a CA from the inventory to review:",{"_3604":1955,"_31083":1890,"_21524":56789,"_5":14790,"_28264":56638,"_3060":56790},[],"Status and validity period.",{"_3604":1956,"_31083":1890,"_21524":56792,"_5":14790,"_28264":56638,"_3060":56793},[],"Certificate and chain in PEM format.",{"_3604":1957,"_31083":1890,"_21524":56795,"_5":14790,"_28264":56638,"_3060":56796},[],"Number of active, expired and revoked certificates.",{"_3604":1958,"_31083":1890,"_21524":56798,"_5":14790,"_28264":56638,"_3060":56799},[],"Certificates issued in **Issued Certificates**.",{"_3604":1959,"_31083":1890,"_21524":56801,"_5":14790,"_28264":56638,"_3060":56802},[],"The CRL linked to the authority.",{"_3604":1960,"_31083":1890,"_21524":56804,"_5":14790,"_28264":56638,"_3060":56805},[],"Metadata and the associated cryptographic engine.",{"_3604":1961,"_31083":1890,"_21524":56807,"_5":14790,"_28264":56638,"_3060":56808},[],"You can filter the inventory by name, status and CA type.",{"_3604":1962,"_31083":1890,"_21524":56810,"_5":14790,"_28264":56642,"_3060":56811},[],"You can start an issuance from **Issued Certificates**, from a CA's action menu or from the global certificate inventory.",{"_3604":1963,"_31083":1890,"_21524":56813,"_5":14790,"_28264":56642,"_3060":56814},[],"**Generate Key & CSR in Browser** is useful for a manual operation or a quick test. The browser generates the key and you must download it at the end.",{"_3604":1964,"_31083":1890,"_21524":56816,"_5":14790,"_28264":56642,"_3060":56817},[],"**Upload Existing CSR** is the right option when the key must remain on the target system. Lamassu receives the request but never the private key.",{"_3604":1965,"_31083":1890,"_21524":56819,"_5":14790,"_28264":56642,"_3060":56820},[],"Follow Issue your first certificate for the guided flow. Certificate management explains the inventory, inspection and revocation.",{"_3604":1966,"_31083":1890,"_21524":56822,"_5":14790,"_28264":56642,"_3060":56823},[],"A CA key signs certificates only. The CA API has no endpoint to sign or verify arbitrary data. To sign and verify a message with a key, use the KMS operations described in Key management, subject to their own permissions.",{"_3604":1967,"_31083":1890,"_21524":56825,"_5":14790,"_28264":56642,"_3060":56826},[],"A CA signs only while its status is `ACTIVE` and the current time falls inside the validity period of its certificate. Lamassu checks both, because the stored status can lag behind the dates until the expiration monitor runs. Otherwise the request fails with `400` and the message `CA Status inconsistent`, before the KMS is called. The same check applies when the CA signs the certificate of a subordinate CA, including when you create or reissue it.",{"_3604":1968,"_31083":1890,"_21524":56828,"_5":14790,"_28264":56646,"_3060":56829},[],"Revoking a CA prevents issuance and may interrupt its entire branch. With `CertificateHold` the cascade is reversible: descendants are suspended on hold and are restored when you release the CA. Any other revocation reason revokes descendants permanently with `CessationOfOperation`. Follow the cascading revocation conditions.",{"_3604":1969,"_31083":1890,"_21524":56831,"_5":14790,"_28264":56650,"_3060":56832},[],"Identify the certificates, devices and consumers that depend on the CA. Prepare a replacement authority and chain when necessary.",{"_3604":1970,"_31083":1890,"_21524":56834,"_5":14790,"_28264":56654,"_3060":56835},[],"Open the authority and select **Revoke CA**. Choose the reason that describes the incident, for example `KeyCompromise`, `CACompromise`, `Superseded` or `CessationOfOperation`.",{"_3604":1971,"_31083":1890,"_21524":56837,"_5":14790,"_28264":56658,"_3060":56838},[],"Type the CA's name exactly to enable **Confirm Revocation**.",{"_3604":1972,"_31083":1890,"_21524":56840,"_5":14790,"_28264":56662,"_3060":56841},[],"Check **REVOKED** on the CA and review descendants individually; propagation permits partial failures. Independently verify OCSP and CRL publication and consumer rejection. A revoked record does not guarantee that an existing session closes.",{"_3604":1973,"_31083":1890,"_21524":56843,"_5":14790,"_28264":56666,"_3060":56844},[],"Permanent deletion is only available with the CA revoked or expired; a CA imported without a key can be deleted in any state. Delete the record only when your retention and audit policy allows it.",{"_3604":1974,"_31083":1890,"_21524":56846,"_5":14790,"_28264":56666,"_3060":56847},[],"The CA’s CRL settings are kept. A deletion is refused with a `409` error while they are still `ACTIVE`: the VA must first publish the CA’s final CRL, which can take up to about an hour after revocation with the default job schedule, so retry after the final CRL is published. An expired CA is finalized without a final CRL, and a CA on hold (`CertificateHold`) is refused with a message asking you to revoke it permanently first. The deletion is also refused with a `409` when the CA’s key signs the CRLs of another CA: the error names that CA, so change its CRL signer, or delete or revoke it, before deleting this one. The CA and all its descendants are checked before anything is deleted; nothing changes if any of them cannot be deleted.",{"_3604":1975,"_31083":1890,"_21524":56849,"_5":14790,"_28264":56666,"_3060":56850},[],"After the deletion, the settings are archived and the last CRL keeps being served but is never regenerated; you can remove them once no certificate issued by the CA still needs revocation evidence, using `DELETE /v1/crl-settings/{ca-id}` or the console's **Verification Authorities** page. Deleting them stops the CRL from being served and cannot be undone. Adjust the validity and signer before revoking or deleting the CA (see CRL). The CA’s key is released, but the KMS keeps it while other certificates still reference it.",{"_3604":1976,"_31083":1890,"_21524":56852,"_5":14790,"_28264":56666,"_3060":56853},[],"Lamassu keeps the certificate record of a deleted CA. If that same certificate is imported again, the import succeeds and reuses the record: it updates the type, issuer and key but keeps the status, so the CA reappears in the state it had when deleted (normally revoked or expired). A different certificate with the same serial number is rejected with a 400 error, and a certificate that already belongs to an existing CA with a 409 error. To avoid inheriting the previous status, use a certificate with a different serial number and check the result after importing. The reimported CA is registered under a new, backend-generated CA ID and does not inherit the CRL settings of the deleted CA: until those settings are deleted, those keep serving their last CRL at the CA ID URL, and at `/crl/<ski>` — the URL that certificates issued before the 4.0.0 upgrade carry — when the settings were migrated by that upgrade; when they are archived, they can no longer be edited (see CRL).",{"_3604":1977,"_31083":1977,"_5":15155,"_3060":56855,"_31421":56856,"_21524":56857,"_28264":1977},"Certificate profiles",[50730,52242,56408,56409],[],{"_3604":1978,"_31083":1977,"_21524":56859,"_5":14790,"_28264":1977,"_3060":56860},[],"Define reusable policies to issue consistent certificates and constrain accepted keys.",{"_3604":1979,"_31083":1977,"_5":31418,"_21524":56862,"_28264":56863,"_3060":56864},[],"/docs/platform/pki/certificate-profiles#what-a-profile-controls","What a profile controls",{"_3604":1980,"_31083":1977,"_5":31418,"_21524":56866,"_28264":56867,"_3060":56868},[],"/docs/platform/pki/certificate-profiles#validity","Validity",{"_3604":1981,"_31083":1977,"_5":31418,"_21524":56870,"_28264":56871,"_3060":56872},[],"/docs/platform/pki/certificate-profiles#ca-certificate-or-end-entity-certificate","CA certificate or end-entity certificate",{"_3604":1982,"_31083":1977,"_5":31418,"_21524":56874,"_28264":56875,"_3060":56876},[],"/docs/platform/pki/certificate-profiles#key-usage-and-extended-key-usage","Key Usage and Extended Key Usage",{"_3604":1983,"_31083":1977,"_5":31418,"_21524":56878,"_28264":56879,"_3060":56880},[],"/docs/platform/pki/certificate-profiles#subject","Subject",{"_3604":1984,"_31083":1977,"_5":31418,"_21524":56882,"_28264":56883,"_3060":56884},[],"/docs/platform/pki/certificate-profiles#csr-extensions","CSR extensions",{"_3604":1985,"_31083":1977,"_5":31418,"_21524":56886,"_28264":56887,"_3060":56888},[],"/docs/platform/pki/certificate-profiles#cryptographic-constraints","Cryptographic constraints",{"_3604":1986,"_31083":1977,"_5":31418,"_21524":56890,"_28264":56891,"_3060":56892},[],"/docs/platform/pki/certificate-profiles#profile-precedence","Profile precedence",{"_3604":1987,"_31083":1977,"_5":31418,"_21524":56894,"_28264":56895,"_3060":56896},[],"/docs/platform/pki/certificate-profiles#create-a-profile","Create a profile",{"_3604":1988,"_31083":1977,"_5":31418,"_21524":56898,"_28264":56899,"_3060":56900},[],"/docs/platform/pki/certificate-profiles#define-a-single-purpose","Define a single purpose",{"_3604":1989,"_31083":1977,"_5":31418,"_21524":56902,"_28264":56903,"_3060":56904},[],"/docs/platform/pki/certificate-profiles#choose-the-validity","Choose the validity",{"_3604":1990,"_31083":1977,"_5":31418,"_21524":56906,"_28264":56907,"_3060":56908},[],"/docs/platform/pki/certificate-profiles#fix-usages-and-subject","Fix usages and subject",{"_3604":1991,"_31083":1977,"_5":31418,"_21524":56910,"_28264":56911,"_3060":56912},[],"/docs/platform/pki/certificate-profiles#constrain-the-keys","Constrain the keys",{"_3604":1992,"_31083":1977,"_5":31418,"_21524":56914,"_28264":56915,"_3060":56916},[],"/docs/platform/pki/certificate-profiles#attach-it-and-test","Attach it and test",{"_3604":1993,"_31083":1977,"_5":31418,"_21524":56918,"_28264":56919,"_3060":56920},[],"/docs/platform/pki/certificate-profiles#design-examples","Design examples",{"_3604":1994,"_31083":1977,"_5":31418,"_21524":56922,"_28264":56923,"_3060":56924},[],"/docs/platform/pki/certificate-profiles#changes-and-deletion","Changes and deletion",{"_3604":1995,"_31083":1977,"_21524":56926,"_5":14790,"_28264":1977,"_3060":56927},[],"An issuance profile turns a certificate policy into reusable configuration. Instead of deciding validity, subject, extensions and algorithms on every request, you define once what is allowed and attach the profile to a CA, a DMS or a specific issuance.",{"_3604":1996,"_31083":1977,"_21524":56929,"_5":14790,"_28264":1977,"_3060":56930},[],"This guide is for the PKI administrator defining issuance policy. You need permissions to manage profiles and associate them with the intended CA or DMS, plus a test consumer with known identity and purpose requirements.",{"_3604":1997,"_31083":1977,"_21524":56932,"_5":14790,"_28264":56867,"_3060":56933},[],"You can express the lifetime as a duration from the moment of issuance or as a fixed end date. A duration works well for recurring identities; a common date is useful to make a whole batch end before a migration or retirement.",{"_3604":1998,"_31083":1977,"_21524":56935,"_5":14790,"_28264":56867,"_3060":56936},[],"Plan the end date within the issuing CA’s validity and leave a renewal margin. The signer calculates the date from the profile; it does not automatically clamp validity to the issuer’s expiration. Check both dates in the resulting certificate. A fixed date in the past does not produce a usable identity either.",{"_3604":1999,"_31083":1977,"_21524":56938,"_5":14790,"_28264":56871,"_3060":56939},[],"`Sign as CA` sets `IsCA` and the basic constraints needed for an authority. Lamassu enforces this: a profile with `Sign as CA` is consumed only when creating or reissuing a CA. Any signing request that resolves to such a profile is rejected — direct signing with a CA, including certificate issuance requests on it, and DMS enrollment or re-enrollment. Nothing validates the profile when it is saved: if a CA's default profile or a DMS profile has `Sign as CA` enabled, the problem appears on the first signing request that resolves to it — for a DMS profile, when a device tries to enroll or re-enroll — and renewal stays blocked until the profile is changed.",{"_3604":2000,"_31083":1977,"_21524":56941,"_5":14790,"_28264":56875,"_3060":56942},[],"The profile can enforce usages such as `DigitalSignature`, `KeyEncipherment`, `CertSign`, `CRLSign`, `ClientAuth`, `ServerAuth` or `OCSPSigning`.",{"_3604":2001,"_31083":1977,"_21524":56944,"_5":14790,"_28264":56875,"_3060":56945},[],"If you enable **Honor Key Usage** or **Honor Extended Key Usages**, Lamassu keeps the values requested by the CSR. If you disable them, it replaces them with the ones defined in the profile.",{"_3604":2002,"_31083":1977,"_21524":56947,"_5":14790,"_28264":56875,"_3060":56948},[],"Do not enable the `Honor…` options for untrusted requests unless another component validates those fields. Otherwise, the requester may choose broader capabilities than intended.",{"_3604":2003,"_31083":1977,"_21524":56950,"_5":14790,"_28264":56879,"_3060":56951},[],"With **Honor Subject**, the certificate keeps the subject of the CSR. Without that option, Lamassu applies the profile's `CN`, `O`, `OU`, `C`, `ST` and `L`. If the profile does not define a `Common Name`, the requested CN is kept.",{"_3604":2004,"_31083":1977,"_21524":56953,"_5":14790,"_28264":56883,"_3060":56954},[],"With **Honor Extensions**, Lamassu filters the additional requested extensions and keeps only SAN. Without that option, it discards the CSR's additional extensions.",{"_3604":2005,"_31083":1977,"_21524":56956,"_5":14790,"_28264":56883,"_3060":56957},[],"This preserves SAN, but does not establish that the requester is entitled to those DNS names, IP addresses, emails or URIs. Validate that authorization before issuing. OCSP and CRL locations come from the issuance service configuration; `Honor Extensions` does not copy CSR distribution points.",{"_3604":2006,"_31083":1977,"_21524":56959,"_5":14790,"_28264":56887,"_3060":56960},[],"The cryptographic enforcement can:",{"_3604":2007,"_31083":1977,"_21524":56962,"_5":14790,"_28264":56887,"_3060":56963},[],"allow or block RSA keys;",{"_3604":2008,"_31083":1977,"_21524":56965,"_5":14790,"_28264":56887,"_3060":56966},[],"limit the supported RSA sizes;",{"_3604":2009,"_31083":1977,"_21524":56968,"_5":14790,"_28264":56887,"_3060":56969},[],"allow or block ECDSA keys;",{"_3604":2010,"_31083":1977,"_21524":56971,"_5":14790,"_28264":56887,"_3060":56972},[],"limit the supported ECDSA sizes or curves.",{"_3604":2011,"_31083":1977,"_21524":56974,"_5":14790,"_28264":56887,"_3060":56975},[],"When it is enabled, Lamassu checks the public key before creating a CA or signing a CSR. A key whose type or size is not listed in the profile is rejected.",{"_3604":2012,"_31083":1977,"_21524":56977,"_5":14790,"_28264":56891,"_3060":56978},[],"Resolution depends on the entry point. One complete profile is selected; its fields are not merged with the CA’s profile.",{"_3604":2013,"_31083":1977,"_21524":56980,"_5":14790,"_28264":56891,"_3060":54170},[],{"_3604":2014,"_31083":1977,"_21524":56982,"_5":14790,"_28264":56891,"_3060":56983},[],"First choice",{"_3604":2015,"_31083":1977,"_21524":56985,"_5":14790,"_28264":56891,"_3060":56986},[],"Second choice",{"_3604":2016,"_31083":1977,"_21524":56988,"_5":14790,"_28264":56891,"_3060":56989},[],"If neither is supplied",{"_3604":2017,"_31083":1977,"_21524":56991,"_5":14790,"_28264":56891,"_3060":56992},[],"Direct signing with a CA",{"_3604":2018,"_31083":1977,"_21524":56994,"_5":14790,"_28264":56891,"_3060":56995},[],"`issuance_profile` embedded in the request",{"_3604":2019,"_31083":1977,"_21524":56997,"_5":14790,"_28264":56891,"_3060":56998},[],"Request `issuance_profile_id`",{"_3604":2020,"_31083":1977,"_21524":57000,"_5":14790,"_28264":56891,"_3060":57001},[],"CA default profile (`profile_id`).",{"_3604":2021,"_31083":1977,"_21524":57003,"_5":14790,"_28264":56891,"_3060":57004},[],"Issuance through a DMS",{"_3604":2022,"_31083":1977,"_21524":57006,"_5":14790,"_28264":56891,"_3060":57007},[],"`settings.issuance_profile_id`",{"_3604":2023,"_31083":1977,"_21524":57009,"_5":14790,"_28264":56891,"_3060":57010},[],"`settings.issuance_profile` embedded in the DMS",{"_3604":2024,"_31083":1977,"_21524":57012,"_5":14790,"_28264":56891,"_3060":57013},[],"Enrollment CA default profile.",{"_3604":2025,"_31083":1977,"_21524":57015,"_5":14790,"_28264":56891,"_3060":57016},[],"If the selected identifier cannot be resolved, the operation fails; it does not silently fall back to the CA’s profile. Avoid setting both options at once. Recording which profile was selected helps explain why a certificate differs from its CSR.",{"_3604":2026,"_31083":1977,"_21524":57018,"_5":14790,"_28264":56891,"_3060":57019},[],"Several fleets can share a CA while keeping different profiles through their DMSs. Requester authentication and device registration policy are configured separately in DMS.",{"_3604":2027,"_31083":1977,"_21524":57021,"_5":14790,"_28264":56899,"_3060":57022},[],"Separate, for example, mTLS devices, servers and intermediate CAs. A small, specific profile is easier to review than one that allows every use.",{"_3604":2028,"_31083":1977,"_21524":57024,"_5":14790,"_28264":56903,"_3060":57025},[],"Align the duration with the fleet's real renewal capacity. Leave margin against the CA's expiration.",{"_3604":2029,"_31083":1977,"_21524":57027,"_5":14790,"_28264":56907,"_3060":57028},[],"For a device that authenticates as a client, the usual starting point is `DigitalSignature` and `ClientAuth`. Add `ServerAuth` or `KeyEncipherment` only if the protocol needs it.",{"_3604":2030,"_31083":1977,"_21524":57030,"_5":14790,"_28264":56911,"_3060":57031},[],"Enable cryptographic enforcement and list only algorithms and sizes compatible with your policy and your devices.",{"_3604":2031,"_31083":1977,"_21524":57033,"_5":14790,"_28264":56915,"_3060":57034},[],"Attach the profile to a CA or DMS and check the precedence above. Issue a CSR with known usages and SAN; inspect the result with `openssl x509 -in device.crt -noout -text`. Check subject, SAN, KU, EKU and dates. For an end-entity identity, disable `Sign as CA`, require no `CA:TRUE` or `Certificate Sign`, and require `CA:FALSE` if Basic Constraints is present.",{"_3604":2032,"_31083":1977,"_21524":57036,"_5":14790,"_28264":56915,"_3060":57037},[],"Also try a key excluded by policy: issuance should fail. Follow the certificate verification and test acceptance in the intended consumer.",{"_3604":2033,"_31083":1977,"_21524":57039,"_5":14790,"_28264":56919,"_3060":57040},[],"**mTLS device**\\\nEnd-entity certificate, short validity, `DigitalSignature`, `ClientAuth`, subject controlled by the DMS and SAN allowed when it identifies the device.",{"_3604":2034,"_31083":1977,"_21524":57042,"_5":14790,"_28264":56919,"_3060":57043},[],"**TLS server**\\\nEnd-entity certificate, `DigitalSignature`, `ServerAuth` and mandatory SAN with the names clients will use.",{"_3604":2035,"_31083":1977,"_21524":57045,"_5":14790,"_28264":56919,"_3060":57046},[],"**Intermediate CA**\\\n`Sign as CA`, `CertSign` and `CRLSign`, validity longer than its end-entity certificates and stricter cryptographic constraints.",{"_3604":2036,"_31083":1977,"_21524":57048,"_5":14790,"_28264":56919,"_3060":57049},[],"These patterns express design decisions. Enabling `Honor Extensions` does not require a CSR to contain SAN or validate its names; enforce that in the request workflow. A profile does not install trust or grant permissions in the consumer.",{"_3604":2037,"_31083":1977,"_21524":57051,"_5":14790,"_28264":56923,"_3060":57052},[],"Updating a profile affects future issuances; it does not modify already-signed certificates. Test changes before applying them to a CA in production and keep the operational justification.",{"_3604":2038,"_31083":1977,"_21524":57054,"_5":14790,"_28264":56923,"_3060":57055},[],"Before deleting a profile, check that no CA or DMS depends on it. If you want to replace it, create the new version, update the references and perform a test issuance before retiring the old one.",{"_3604":2039,"_31083":2039,"_5":15155,"_3060":57057,"_31421":57058,"_21524":57060,"_28264":2039},"Certificate validation",[50730,52242,56408,57059],"Validation",[],{"_3604":2040,"_31083":2039,"_21524":57062,"_5":14790,"_28264":2039,"_3060":57063},[],"Check chain, identity, purpose and revocation from the consumer.",{"_3604":2041,"_31083":2039,"_5":31418,"_21524":57065,"_28264":57066,"_3060":57067},[],"/docs/platform/pki/certificate-validation#before-querying-status","Before querying status",{"_3604":2042,"_31083":2039,"_5":31418,"_21524":57069,"_28264":57070,"_3060":57071},[],"/docs/platform/pki/certificate-validation#choose-a-mechanism","Choose a mechanism",{"_3604":2043,"_31083":2039,"_5":31418,"_21524":57073,"_28264":57074,"_3060":57075},[],"/docs/platform/pki/certificate-validation#check-consumer-behavior","Check consumer behavior",{"_3604":2044,"_31083":2039,"_21524":57077,"_5":14790,"_28264":2039,"_3060":57078},[],"This guide brings together the checks needed when integrating a certificate consumer. You need the presented certificate, intermediates and roots that your application has deliberately chosen to trust. Lamassu publishes status; the consumer applies acceptance policy.",{"_3604":2045,"_31083":2039,"_21524":57080,"_5":14790,"_28264":57066,"_3060":57081},[],"Verify these criteria together:",{"_3604":2046,"_31083":2039,"_21524":57083,"_5":14790,"_28264":57066,"_3060":56034},[],{"_3604":2047,"_31083":2039,"_21524":57085,"_5":14790,"_28264":57066,"_3060":57086},[],"Required result",{"_3604":2048,"_31083":2039,"_21524":57088,"_5":14790,"_28264":57066,"_3060":57089},[],"Chain and signature",{"_3604":2049,"_31083":2039,"_21524":57091,"_5":14790,"_28264":57066,"_3060":57092},[],"Valid chain to a root deliberately installed in the consumer.",{"_3604":2050,"_31083":2039,"_21524":57094,"_5":14790,"_28264":57066,"_3060":57095},[],"Dates",{"_3604":2051,"_31083":2039,"_21524":57097,"_5":14790,"_28264":57066,"_3060":57098},[],"Current time between `Not Before` and `Not After`, including the CAs in the chain.",{"_3604":2052,"_31083":2039,"_21524":57100,"_5":14790,"_28264":57066,"_3060":51911},[],{"_3604":2053,"_31083":2039,"_21524":57102,"_5":14790,"_28264":57066,"_3060":57103},[],"Name, SAN or identifier matches the expected peer.",{"_3604":2054,"_31083":2039,"_21524":57105,"_5":14790,"_28264":57066,"_3060":51120},[],{"_3604":2055,"_31083":2039,"_21524":57107,"_5":14790,"_28264":57066,"_3060":57108},[],"KU, EKU and constraints permit the specific operation.",{"_3604":2056,"_31083":2039,"_21524":57110,"_5":14790,"_28264":57066,"_3060":57111},[],"Revocation",{"_3604":2057,"_31083":2039,"_21524":57113,"_5":14790,"_28264":57066,"_3060":57114},[],"Signed, current evidence corresponding to the queried issuer and certificate.",{"_3604":2058,"_31083":2039,"_21524":57116,"_5":14790,"_28264":57066,"_3060":57117},[],"Authorization",{"_3604":2059,"_31083":2039,"_21524":57119,"_5":14790,"_28264":57066,"_3060":57120},[],"The application permits that identity to perform the action.",{"_3604":2060,"_31083":2039,"_21524":57122,"_5":14790,"_28264":57066,"_3060":57123},[],"The issuance walkthrough checks chain and purpose with OpenSSL. That check does not automatically query OCSP or download a CRL. Inventory presence or an OCSP `Good` response does not replace the other criteria.",{"_3604":2061,"_31083":2039,"_21524":57125,"_5":14790,"_28264":57070,"_3060":57126},[],"Mechanism",{"_3604":2062,"_31083":2039,"_21524":57128,"_5":14790,"_28264":57070,"_3060":57129},[],"When to use it",{"_3604":2063,"_31083":2039,"_21524":57131,"_5":14790,"_28264":57070,"_3060":57132},[],"What you must maintain",{"_3604":2064,"_31083":2039,"_21524":57134,"_5":14790,"_28264":57070,"_3060":57135},[],"OCSP",{"_3604":2065,"_31083":2039,"_21524":57137,"_5":14790,"_28264":57070,"_3060":57138},[],"Status query for a specific certificate.",{"_3604":2066,"_31083":2039,"_21524":57140,"_5":14790,"_28264":57070,"_3060":57141},[],"Responder access, signature verification and cache/freshness policy.",{"_3604":2067,"_31083":2039,"_21524":57143,"_5":14790,"_28264":57070,"_3060":57144},[],"CRL",{"_3604":2068,"_31083":2039,"_21524":57146,"_5":14790,"_28264":57070,"_3060":57147},[],"Local checks for many certificates or offline operation.",{"_3604":2069,"_31083":2039,"_21524":57149,"_5":14790,"_28264":57070,"_3060":57150},[],"Periodic download of an issuer-signed list and rejection of expired lists.",{"_3604":2070,"_31083":2039,"_21524":57152,"_5":14790,"_28264":57070,"_3060":57153},[],"OCSP can also return a response reusable until `nextUpdate`; a CRL changes when a new version is published. Neither mechanism alone guarantees that a consumer learns a revocation at the moment it is saved.",{"_3604":2071,"_31083":2039,"_21524":57155,"_5":14790,"_28264":57070,"_3060":57156},[],"If using both, define when fallback is allowed and what the client does when retrieval, signature or freshness checks fail, or the result is `Unknown`. Accepting an identity when its status cannot be checked must be an explicit application decision.",{"_3604":2072,"_31083":2039,"_21524":57158,"_5":14790,"_28264":57074,"_3060":57159},[],"Accept a current, authorized certificate with a known chain.",{"_3604":2073,"_31083":2039,"_21524":57161,"_5":14790,"_28264":57074,"_3060":57162},[],"Reject another certificate with an unknown root or incompatible purpose.",{"_3604":2074,"_31083":2039,"_21524":57164,"_5":14790,"_28264":57074,"_3060":57165},[],"Revoke a test certificate and verify the OCSP response or new CRL.",{"_3604":2075,"_31083":2039,"_21524":57167,"_5":14790,"_28264":57074,"_3060":57168},[],"Check that a new connection with that identity is rejected.",{"_3604":2076,"_31083":2039,"_21524":57170,"_5":14790,"_28264":57074,"_3060":57171},[],"Simulate an unreachable endpoint and expired evidence; observe whether the result matches policy.",{"_3604":2077,"_31083":2039,"_21524":57173,"_5":14790,"_28264":57074,"_3060":57174},[],"Keep the serial number, issuer, revocation reason, query time and evidence timestamps. An existing session may need explicit closure or reauthentication in the consumer; publishing revocation does not automatically close it.",{"_3604":2078,"_31083":2039,"_21524":57176,"_5":14790,"_28264":57074,"_3060":57177},[],"For a chain with intermediates, validate their status according to consumer policy as well. An end-entity issuer’s CRL does not replace checks on every CA in the chain.",{"_3604":2079,"_31083":2039,"_21524":57179,"_5":14790,"_28264":57074,"_3060":57180},[],"<Card title=\"Online validation with OCSP\" description=\"Generate a query and verify signature, status and timestamps.\" href=\"/docs/platform/pki/ocsp\" />",{"_3604":2080,"_31083":2039,"_21524":57182,"_5":14790,"_28264":57074,"_3060":57183},[],"<Card title=\"Revocation lists\" description=\"Download, inspect and use an issuer’s CRL.\" href=\"/docs/platform/pki/crl\" />",{"_3604":2081,"_31083":2081,"_5":15155,"_3060":57185,"_31421":57186,"_21524":57187,"_28264":2081},"Certificates",[50730,52242,56408,56409],[],{"_3604":2082,"_31083":2081,"_21524":57189,"_5":14790,"_28264":2081,"_3060":57190},[],"Inspect, download and revoke the certificates issued by Lamassu.",{"_3604":2083,"_31083":2081,"_5":31418,"_21524":57192,"_28264":57193,"_3060":57194},[],"/docs/platform/pki/certificates#find-a-certificate","Find a certificate",{"_3604":2084,"_31083":2081,"_5":31418,"_21524":57196,"_28264":57197,"_3060":57198},[],"/docs/platform/pki/certificates#download-the-certificate","Download the certificate",{"_3604":2085,"_31083":2081,"_5":31418,"_21524":57200,"_28264":57201,"_3060":57202},[],"/docs/platform/pki/certificates#issue-from-an-existing-csr","Issue from an existing CSR",{"_3604":2086,"_31083":2081,"_5":31418,"_21524":57204,"_28264":57205,"_3060":57206},[],"/docs/platform/pki/certificates#revoke-a-certificate","Revoke a certificate",{"_3604":2087,"_31083":2081,"_5":31418,"_21524":57208,"_28264":57209,"_3060":57210},[],"/docs/platform/pki/certificates#open-the-action","Open the action",{"_3604":2088,"_31083":2081,"_5":31418,"_21524":57212,"_28264":57213,"_3060":57214},[],"/docs/platform/pki/certificates#choose-a-reason","Choose a reason",{"_3604":2089,"_31083":2081,"_5":31418,"_21524":57216,"_28264":57217,"_3060":57218},[],"/docs/platform/pki/certificates#confirm-and-verify","Confirm and verify",{"_3604":2090,"_31083":2081,"_5":31418,"_21524":57220,"_28264":57221,"_3060":57222},[],"/docs/platform/pki/certificates#reactivate-a-hold","Reactivate a hold",{"_3604":2091,"_31083":2081,"_5":31418,"_21524":57224,"_28264":57225,"_3060":57226},[],"/docs/platform/pki/certificates#continue","Continue",{"_3604":2092,"_31083":2081,"_21524":57228,"_5":14790,"_28264":2081,"_3060":57229},[],"This guide is for a PKI operator inspecting or retiring an issued identity. You need inventory access and, to change states, permissions on the certificate. Open **Certificates** for a global view or **Issued Certificates** within a CA to restrict it to that issuer.",{"_3604":2093,"_31083":2081,"_21524":57231,"_5":14790,"_28264":57193,"_3060":57232},[],"Filter by `Common Name`, serial, status and issuer. A certificate does not contain its private key, so the private-key surfaces answer which certificates have their key held in Lamassu’s KMS:",{"_3604":2094,"_31083":2081,"_21524":57234,"_5":14790,"_28264":57193,"_3060":57235},[],"The advanced **Private Key** filter, available on the Certificates page and on a CA’s **Issued Certificates** tab, narrows the list to **All Certificates**, **With Private Key** or **Without Private Key**.",{"_3604":2095,"_31083":2081,"_21524":57237,"_5":14790,"_28264":57193,"_3060":57238},[],"The sortable **Private Key** column — shown by default, hidden on narrow screens — marks a key held in the KMS with a green check mark and otherwise shows `-`.",{"_3604":2096,"_31083":2081,"_21524":57240,"_5":14790,"_28264":57193,"_3060":57241},[],"In certificate details, the **Information** tab shows a **Private Key** row in the **Key & Signature** section. When the certificate reports a private key and its KMS engine and key IDs are available, the row links to the key (tooltip: **Open private key in KMS**). Otherwise, it shows **Present** if the certificate reports a private key, or **Not available** if it does not. This does not establish whether a key exists outside Lamassu.",{"_3604":2097,"_31083":2081,"_21524":57243,"_5":14790,"_28264":57193,"_3060":57244},[],"Use **Quick Inspect** for a quick review or **View Details** for subject, SAN, usages, chain, dates and metadata.",{"_3604":2098,"_31083":2081,"_21524":57246,"_5":14790,"_28264":57193,"_3060":57247},[],"Certificate records expose `key_id` (the KMS key that holds the private key, empty when the KMS does not hold it) and `has_private_key` (derived at read time from the KMS). Certificate and CA listings accept a `has_private_key` filter, which is useful, for example, to check the result of the CA-to-KMS migration of the 4.0.0 upgrade.",{"_3604":2099,"_31083":2081,"_21524":57249,"_5":14790,"_28264":57193,"_3060":57250},[],"Identify a certificate by issuer and serial; a name can correspond to several renewals. Check which certificate the consumer actually uses and which occupies the device’s active identity. Identity history and the certificate inventory answer different questions.",{"_3604":2100,"_31083":2081,"_21524":57252,"_5":14790,"_28264":57197,"_3060":57253},[],"Download the PEM and inspect it:",{"_3604":2101,"_31083":2081,"_21524":57255,"_5":14790,"_28264":57197,"_3060":57256},[],"Check issuance policy, chain and usages with the verification walkthrough. A certificate does not contain its private key. For an external CSR, the key remains where it was generated; for the browser flow, retain the file downloaded upon issuance. If the key is lost, plan a new identity rather than expecting recovery from the certificate.",{"_3604":2102,"_31083":2081,"_21524":57258,"_5":14790,"_28264":57201,"_3060":57259},[],"Use this flow when the identity’s key must remain on the system that generated it. You need an active CA with a usable key, a PEM CSR and a suitable profile.",{"_3604":2103,"_31083":2081,"_21524":57261,"_5":14790,"_28264":57201,"_3060":57262},[],"Verify the request with `openssl req -in request.csr -noout -verify -text`. Review subject, SAN and algorithm, and authorize the requested identity.",{"_3604":2104,"_31083":2081,"_21524":57264,"_5":14790,"_28264":57201,"_3060":57265},[],"Start issuance from the CA or inventory and select **Upload Existing CSR**.",{"_3604":2105,"_31083":2081,"_21524":57267,"_5":14790,"_28264":57201,"_3060":57268},[],"Confirm the CA and profile resolved according to Profiles; the request does not guarantee that every field is retained.",{"_3604":2106,"_31083":2081,"_21524":57270,"_5":14790,"_28264":57201,"_3060":57271},[],"Download the certificate and inspect dates, issuer, subject, SAN, KU and EKU. Check correspondence with the private key on the originating system.",{"_3604":2107,"_31083":2081,"_21524":57273,"_5":14790,"_28264":57201,"_3060":57274},[],"Install certificate and chain in the intended consumer and test a connection. Issuance alone does not register a device or grant access in an integration.",{"_3604":2108,"_31083":2081,"_21524":57276,"_5":14790,"_28264":57201,"_3060":57277},[],"For browser key generation, follow Issue your first certificate.",{"_3604":2109,"_31083":2081,"_21524":57279,"_5":14790,"_28264":57205,"_3060":57280},[],"Revoke when the key is compromised, the subject is no longer authorized or the identity must stop being accepted before expiration. Before changing status, identify consumers and prepare any required replacement.",{"_3604":2110,"_31083":2081,"_21524":57282,"_5":14790,"_28264":57209,"_3060":57283},[],"Locate the correct issuer and serial and select **Revoke Certificate**. `EXPIRED` records and records revoked for a final reason reject subsequent status changes.",{"_3604":2111,"_31083":2081,"_21524":57285,"_5":14790,"_28264":57213,"_3060":57286},[],"Select the incident reason. `CertificateHold` represents a reversible certificate suspension; other reasons block later changes. Do not use a suspension to address a compromised key.",{"_3604":2112,"_31083":2081,"_21524":57288,"_5":14790,"_28264":57217,"_3060":57289},[],"Save the change and read the record again: require **REVOKED**, reason and timestamp. Then verify a fresh OCSP query and, if using CRL, its published version and the serial’s presence. Finally check rejection of a new connection in the consumer.",{"_3604":2113,"_31083":2081,"_21524":57291,"_5":14790,"_28264":57217,"_3060":57292},[],"Revocation does not erase the certificate, delete the key or guarantee closure of existing sessions. Status and publication are separate steps.",{"_3604":2114,"_31083":2081,"_21524":57294,"_5":14790,"_28264":57217,"_3060":57295},[],"A certificate revoked with `CertificateHold` can be reactivated if it is not in `EXPIRED` state. Its dates and consumer trust remain mandatory.",{"_3604":2115,"_31083":2081,"_21524":57297,"_5":14790,"_28264":57221,"_3060":57298},[],"Check that the saved reason is `CertificateHold` and the identity still satisfies policy. Request `ACTIVE` through the status update operation exposed by your installation; consult the API reference. Do not assume changing consumer permissions also changes status in Lamassu.",{"_3604":2116,"_31083":2081,"_21524":57300,"_5":14790,"_28264":57221,"_3060":57301},[],"Read the record and query OCSP again. With `regenerate_on_revoke` enabled, the reactivation event requests CRL regeneration: check that the new list omits the serial. An earlier list can still mark it revoked until the client refreshes its copy.",{"_3604":2117,"_31083":2081,"_21524":57303,"_5":14790,"_28264":57221,"_3060":57304},[],"This does not undo permanent revocation or the cascade of a CA revoked for good; the hold cascaded by a CA is lifted by releasing that CA.",{"_3604":2118,"_31083":2081,"_21524":57306,"_5":14790,"_28264":57225,"_3060":57307},[],"<Card title=\"Validate with OCSP\" description=\"Query and verify a certificate’s signed status.\" href=\"/docs/platform/pki/ocsp\" />",{"_3604":2119,"_31083":2081,"_21524":57309,"_5":14790,"_28264":57225,"_3060":57310},[],"<Card title=\"Distribute a CRL\" description=\"Publish status for local validation.\" href=\"/docs/platform/pki/crl\" />",{"_3604":2120,"_31083":2120,"_5":15155,"_3060":57312,"_31421":57313,"_21524":57315,"_28264":2120},"Certificate lifecycle",[50730,52242,56408,57314],"Concepts",[],{"_3604":2121,"_31083":2120,"_21524":57317,"_5":14790,"_28264":2120,"_3060":57318},[],"Issuance, use, renewal, revocation and retirement of certificates in Lamassu.",{"_3604":2122,"_31083":2120,"_5":31418,"_21524":57320,"_28264":57321,"_3060":57322},[],"/docs/platform/pki/concepts/certificate-lifecycle#the-full-journey","The full journey",{"_3604":2123,"_31083":2120,"_5":31418,"_21524":57324,"_28264":57325,"_3060":57326},[],"/docs/platform/pki/concepts/certificate-lifecycle#request","Request",{"_3604":2124,"_31083":2120,"_5":31418,"_21524":57328,"_28264":57329,"_3060":57330},[],"/docs/platform/pki/concepts/certificate-lifecycle#issuance","Issuance",{"_3604":2125,"_31083":2120,"_5":31418,"_21524":57332,"_28264":57333,"_3060":57334},[],"/docs/platform/pki/concepts/certificate-lifecycle#use-and-monitoring","Use and monitoring",{"_3604":2126,"_31083":2120,"_5":31418,"_21524":57336,"_28264":57337,"_3060":57338},[],"/docs/platform/pki/concepts/certificate-lifecycle#renewal-or-re-enrollment","Renewal or re-enrollment",{"_3604":2127,"_31083":2120,"_5":31418,"_21524":57340,"_28264":57341,"_3060":57342},[],"/docs/platform/pki/concepts/certificate-lifecycle#revocation-or-retirement","Revocation or retirement",{"_3604":2128,"_31083":2120,"_5":31418,"_21524":57344,"_28264":57345,"_3060":57346},[],"/docs/platform/pki/concepts/certificate-lifecycle#certificate-states","Certificate states",{"_3604":2129,"_31083":2120,"_5":31418,"_21524":57348,"_28264":57349,"_3060":57350},[],"/docs/platform/pki/concepts/certificate-lifecycle#renewal-and-revocation-are-not-equivalent","Renewal and revocation are not equivalent",{"_3604":2130,"_31083":2120,"_5":31418,"_21524":57352,"_28264":57353,"_3060":57354},[],"/docs/platform/pki/concepts/certificate-lifecycle#effect-of-revoking-a-ca","Effect of revoking a CA",{"_3604":2131,"_31083":2120,"_5":31418,"_21524":57356,"_28264":57357,"_3060":57358},[],"/docs/platform/pki/concepts/certificate-lifecycle#what-you-should-watch","What you should watch",{"_3604":2132,"_31083":2120,"_21524":57360,"_5":14790,"_28264":2120,"_3060":57361},[],"Issuing a certificate is only the beginning. During its useful life you must check its validity, renew it before it expires and retire it when it stops being trustworthy. Lamassu keeps the certificate, its issuing CA, its status and, when it belongs to a device, the identity it is linked to.",{"_3604":2133,"_31083":2120,"_21524":57363,"_5":14790,"_28264":57325,"_3060":57364},[],"The requester generates a key and a CSR. In the recommended flows, the private key stays in the device, browser or cryptographic engine that created it.",{"_3604":2134,"_31083":2120,"_21524":57366,"_5":14790,"_28264":57329,"_3060":57367},[],"The CA signs the CSR. The issuance profile determines the validity, uses, subject, allowed extensions and cryptographic constraints.",{"_3604":2135,"_31083":2120,"_21524":57369,"_5":14790,"_28264":57333,"_3060":57370},[],"The certificate enters the `ACTIVE` state. Lamassu monitors its `Not After` date; the cryptographic monitoring job marks certificates that have expired as `EXPIRED`.",{"_3604":2136,"_31083":2120,"_21524":57372,"_5":14790,"_28264":57337,"_3060":57373},[],"A new certificate is issued before the previous one expires. In a DMS you can open preventive and critical windows so the device re-enrolls through EST.",{"_3604":2137,"_31083":2120,"_21524":57375,"_5":14790,"_28264":57341,"_3060":57376},[],"If the identity stops being trustworthy, Lamassu records the reason and time of revocation. OCSP and CRLs let consumers learn that status.",{"_3604":2138,"_31083":2120,"_21524":57378,"_5":14790,"_28264":57345,"_3060":57379},[],"Lamassu persists four X.509 states:",{"_3604":2139,"_31083":2120,"_21524":57381,"_5":14790,"_28264":57345,"_3060":57382},[],"**`ACTIVE`**: the record is enabled. Also check `Not Before` and `Not After`: this state does not establish time validity.",{"_3604":2140,"_31083":2120,"_21524":57384,"_5":14790,"_28264":57345,"_3060":57385},[],"**`EXPIRED`**: it has passed its expiration date. The monitor detects this periodically; it is not a state that should be assigned manually.",{"_3604":2141,"_31083":2120,"_21524":57387,"_5":14790,"_28264":57345,"_3060":57388},[],"**`REVOKED`**: it was invalidated before expiring, with a reason and a timestamp.",{"_3604":2142,"_31083":2120,"_21524":57390,"_5":14790,"_28264":57345,"_3060":57391},[],"**`INACTIVE`**: it is disabled without representing a definitive revocation.",{"_3604":2143,"_31083":2120,"_21524":57393,"_5":14790,"_28264":57345,"_3060":57394},[],"The device view may add operational states such as missing identity, pending renewal, expiring soon or decommissioned. These are an interpretation of the device's status and its certificates, not new X.509 states.",{"_3604":2144,"_31083":2120,"_21524":57396,"_5":14790,"_28264":57349,"_3060":57397},[],"**Renewal** creates a successor certificate for an identity that remains valid. **Revocation** communicates that the current certificate must no longer be accepted. Renew to maintain continuity; revoke in response to compromise, retirement or a change that invalidates the identity.",{"_3604":2145,"_31083":2120,"_21524":57399,"_5":14790,"_28264":57349,"_3060":57400},[],"Only `CertificateHold` allows reactivating a revoked certificate that is not in `EXPIRED` state. Revocation for another reason blocks subsequent status changes. `EXPIRED` records also reject changes; the consumer must check dates even before the monitor updates the state. Certificates explains how to verify revocation and reactivation.",{"_3604":2146,"_31083":2120,"_21524":57402,"_5":14790,"_28264":57349,"_3060":57403},[],"The **Reissue CA** operation generates another certificate for the same key and links both serial numbers through metadata. It is not a key rotation. To change the key, create a successor CA and perform a migration with an overlapping period.",{"_3604":2147,"_31083":2120,"_21524":57405,"_5":14790,"_28264":57353,"_3060":57406},[],"Revoking a CA starts a cascade that attempts to revoke descendants. A `CertificateHold` cascade suspends them reversibly: releasing the CA restores those still on hold. Any other revocation reason revokes descendants permanently with `CessationOfOperation`. Read Hierarchy and rotation for conditions and checks.",{"_3604":2148,"_31083":2120,"_21524":57408,"_5":14790,"_28264":57353,"_3060":57409},[],"Before confirming:",{"_3604":2149,"_31083":2120,"_21524":57411,"_5":14790,"_28264":57353,"_3060":57412},[],"Identify DMSs, devices and services that trust that chain.",{"_3604":2150,"_31083":2120,"_21524":57414,"_5":14790,"_28264":57353,"_3060":57415},[],"Distribute the new chain of trust.",{"_3604":2151,"_31083":2120,"_21524":57417,"_5":14790,"_28264":57353,"_3060":57418},[],"Reissue the necessary identities.",{"_3604":2152,"_31083":2120,"_21524":57420,"_5":14790,"_28264":57353,"_3060":57421},[],"Check OCSP and CRL from a real consumer.",{"_3604":2153,"_31083":2120,"_21524":57423,"_5":14790,"_28264":57353,"_3060":57424},[],"Revoke the old CA once no legitimate traffic remains.",{"_3604":2154,"_31083":2120,"_21524":57426,"_5":14790,"_28264":57353,"_3060":57427},[],"Device retirement belongs to the IoT Fleets lifecycle. It affects the active identity; it does not automatically traverse and revoke every historical certificate. Review previous identities and consumer permissions separately in Device management.",{"_3604":2155,"_31083":2120,"_21524":57429,"_5":14790,"_28264":57357,"_3060":57430},[],"Certificates entering the preventive or critical renewal window.",{"_3604":2156,"_31083":2120,"_21524":57432,"_5":14790,"_28264":57357,"_3060":57433},[],"Repeated enrollment or re-enrollment failures.",{"_3604":2157,"_31083":2120,"_21524":57435,"_5":14790,"_28264":57357,"_3060":57436},[],"Status changes and revocation reasons.",{"_3604":2158,"_31083":2120,"_21524":57438,"_5":14790,"_28264":57357,"_3060":57439},[],"OCSP and CRL publication and validity.",{"_3604":2159,"_31083":2120,"_21524":57441,"_5":14790,"_28264":57357,"_3060":57442},[],"Dependencies still presenting a replaced certificate.",{"_3604":2160,"_31083":2120,"_21524":57444,"_5":14790,"_28264":57357,"_3060":57445},[],"The device history relates its previous and current identities. For administrative changes and mutation errors, see Audit logs.",{"_3604":2161,"_31083":2161,"_5":15155,"_3060":57447,"_31421":57448,"_21524":57449,"_28264":2161},"Trust model",[50730,52242,56408,57314],[],{"_3604":2162,"_31083":2161,"_21524":57451,"_5":14790,"_28264":2161,"_3060":57452},[],"Understand where trust originates, how it is distributed and what each component validates.",{"_3604":2163,"_31083":2161,"_5":31418,"_21524":57454,"_28264":57455,"_3060":57456},[],"/docs/platform/pki/concepts/trust-model#the-four-trust-decisions","The four trust decisions",{"_3604":2164,"_31083":2161,"_5":31418,"_21524":57458,"_28264":57459,"_3060":57460},[],"/docs/platform/pki/concepts/trust-model#who-can-issue","Who can issue",{"_3604":2165,"_31083":2161,"_5":31418,"_21524":57462,"_28264":57463,"_3060":57464},[],"/docs/platform/pki/concepts/trust-model#what-can-be-issued","What can be issued",{"_3604":2166,"_31083":2161,"_5":31418,"_21524":57466,"_28264":57467,"_3060":57468},[],"/docs/platform/pki/concepts/trust-model#who-can-request-it","Who can request it",{"_3604":2167,"_31083":2161,"_5":31418,"_21524":57470,"_28264":57471,"_3060":57472},[],"/docs/platform/pki/concepts/trust-model#who-accepts-the-result","Who accepts the result",{"_3604":2168,"_31083":2161,"_5":31418,"_21524":57474,"_28264":57475,"_3060":57476},[],"/docs/platform/pki/concepts/trust-model#identity-flow","Identity flow",{"_3604":2169,"_31083":2161,"_5":31418,"_21524":57478,"_28264":57479,"_3060":57480},[],"/docs/platform/pki/concepts/trust-model#enrollment-validation-and-distribution-cas","Enrollment, validation and distribution CAs",{"_3604":2170,"_31083":2161,"_5":31418,"_21524":57482,"_28264":57483,"_3060":57484},[],"/docs/platform/pki/concepts/trust-model#validation-and-revocation","Validation and revocation",{"_3604":2171,"_31083":2161,"_5":31418,"_21524":57486,"_28264":57487,"_3060":57488},[],"/docs/platform/pki/concepts/trust-model#custody-limits","Custody limits",{"_3604":2172,"_31083":2161,"_5":31418,"_21524":57490,"_28264":57491,"_3060":57492},[],"/docs/platform/pki/concepts/trust-model#recommended-pattern","Recommended pattern",{"_3604":2173,"_31083":2161,"_21524":57494,"_5":14790,"_28264":2161,"_3060":57495},[],"In Lamassu, trust does not simply mean that a certificate exists in the inventory. A consumer trusts an identity when it can build a chain to a root it recognizes, check that the certificate is fit for the intended use and verify that it is still valid.",{"_3604":2174,"_31083":2161,"_21524":57497,"_5":14790,"_28264":57459,"_3060":57498},[],"The CA hierarchy defines which authorities can sign. A root CA establishes the anchor of trust; intermediate CAs separate operating domains and avoid using the root for every issuance.",{"_3604":2175,"_31083":2161,"_21524":57500,"_5":14790,"_28264":57463,"_3060":57501},[],"Certificate profiles limit validity, subject, uses, extensions and cryptographic parameters. Possessing a CA does not replace an issuance policy.",{"_3604":2176,"_31083":2161,"_21524":57503,"_5":14790,"_28264":57467,"_3060":57504},[],"The DMS acts as the enrollment point. It can authenticate an EST request with a client certificate, an external webhook or a combination of both. CAs configured to validate the requester do not have to be the CA that will issue the new identity.",{"_3604":2177,"_31083":2161,"_21524":57506,"_5":14790,"_28264":57471,"_3060":57507},[],"The consumer keeps its own trust store. EST `/cacerts` can distribute the service TLS certificate, the enrollment CA and selected managed CAs. Initial trust for authenticating that service must come from an already trusted channel. Download and inspect the contents: do not assume they form a complete chain or install every entry as a root.",{"_3604":2178,"_31083":2161,"_21524":57509,"_5":14790,"_28264":57475,"_3060":57510},[],"The device proves it can enroll according to the DMS policy.",{"_3604":2179,"_31083":2161,"_21524":57512,"_5":14790,"_28264":57475,"_3060":57513},[],"The DMS validates the request and forwards the CSR to the enrollment CA.",{"_3604":2180,"_31083":2161,"_21524":57515,"_5":14790,"_28264":57475,"_3060":57516},[],"In the device-generated CSR flow, the CA applies the profile and signs without receiving the device’s private key.",{"_3604":2181,"_31083":2161,"_21524":57518,"_5":14790,"_28264":57475,"_3060":57519},[],"The device installs the certificate and the chain it needs.",{"_3604":2182,"_31083":2161,"_21524":57521,"_5":14790,"_28264":57475,"_3060":57522},[],"The system that trusts the device validates the chain, dates, uses and revocation status.",{"_3604":2183,"_31083":2161,"_21524":57524,"_5":14790,"_28264":57475,"_3060":57525},[],"OIDC or X.509 identifies the operator calling Lamassu. The authorization service decides which actions it may perform. The X.509 hierarchy, on the other hand, determines whether a certificate presented by a device is trustworthy.",{"_3604":2184,"_31083":2161,"_21524":57527,"_5":14790,"_28264":57479,"_3060":57528},[],"A DMS relates three sets that are worth designing separately:",{"_3604":2185,"_31083":2161,"_21524":57530,"_5":14790,"_28264":57479,"_3060":57531},[],"**Enrollment CA:** signs the new identities.",{"_3604":2186,"_31083":2161,"_21524":57533,"_5":14790,"_28264":57479,"_3060":57534},[],"**Validation CAs:** authenticate the client certificates used for enrollment or migration. During re-enrollment, the enrollment CA is always trusted and Lamassu then tries the validation CAs configured in the re-enrollment block; those are optional.",{"_3604":2187,"_31083":2161,"_21524":57536,"_5":14790,"_28264":57479,"_3060":57537},[],"**Distributed CAs:** form the content the device obtains through EST `/cacerts`. You can include the service TLS certificate, the enrollment CA and an explicit list of managed CAs. Including the issuer does not automatically add all its ancestors.",{"_3604":2188,"_31083":2161,"_21524":57539,"_5":14790,"_28264":57479,"_3060":57540},[],"This separation makes it possible to migrate a fleet: you temporarily accept certificates from the old hierarchy, issue with the new one and distribute both chains during the overlap.",{"_3604":2189,"_31083":2161,"_21524":57542,"_5":14790,"_28264":57483,"_3060":57543},[],"A valid chain does not by itself guarantee that a certificate should be accepted. The consumer must also check:",{"_3604":2190,"_31083":2161,"_21524":57545,"_5":14790,"_28264":57483,"_3060":57546},[],"that the current date is between `Not Before` and `Not After`;",{"_3604":2191,"_31083":2161,"_21524":57548,"_5":14790,"_28264":57483,"_3060":57549},[],"that `Key Usage` and `Extended Key Usage` allow the operation;",{"_3604":2192,"_31083":2161,"_21524":57551,"_5":14790,"_28264":57483,"_3060":57552},[],"that names, SANs and subject match the expected identity;",{"_3604":2193,"_31083":2161,"_21524":57554,"_5":14790,"_28264":57483,"_3060":57555},[],"that the certificate does not appear revoked in OCSP or a CRL.",{"_3604":2194,"_31083":2161,"_21524":57557,"_5":14790,"_28264":57483,"_3060":57558},[],"An OCSP `Good` status does not replace chain, date, usage and identity checks either; Validation brings those criteria together.",{"_3604":2195,"_31083":2161,"_21524":57560,"_5":14790,"_28264":57483,"_3060":57561},[],"During the mTLS authentication of a DMS, Lamassu attempts to check revocation. If the certificate does not contain enough information to perform that check, the backend logs a warning and continues treating it as not revoked. Design your profiles and distribution points to avoid that situation in production.",{"_3604":2196,"_31083":2161,"_21524":57563,"_5":14790,"_28264":57487,"_3060":57564},[],"The KMS keeps the reference to the key and delegates the operation to the configured engine. With an HSM or a cloud KMS, the private key can remain non-exportable. That protects custody, but it does not by itself prevent misuse: you still must restrict who can request a signature and audit those operations.",{"_3604":2197,"_31083":2161,"_21524":57566,"_5":14790,"_28264":57491,"_3060":57567},[],"Keep the root out of daily operations, or with very restricted access.",{"_3604":2198,"_31083":2161,"_21524":57569,"_5":14790,"_28264":57491,"_3060":57570},[],"Issue from intermediate CAs separated by environment or risk domain.",{"_3604":2199,"_31083":2161,"_21524":57572,"_5":14790,"_28264":57491,"_3060":57573},[],"Assign explicit profiles to every use case.",{"_3604":2200,"_31083":2161,"_21524":57575,"_5":14790,"_28264":57491,"_3060":57576},[],"Distribute the new trust before starting a rotation.",{"_3604":2201,"_31083":2161,"_21524":57578,"_5":14790,"_28264":57491,"_3060":57579},[],"Keep enough overlap to renew a disconnected fleet.",{"_3604":2202,"_31083":2161,"_21524":57581,"_5":14790,"_28264":57491,"_3060":57582},[],"Validate from the consuming system, not only from the Lamassu console.",{"_3604":2203,"_31083":2161,"_21524":57584,"_5":14790,"_28264":57491,"_3060":57585},[],"Continue with CA hierarchy and rotation to turn this model into an operating procedure.",{"_3604":2204,"_31083":2204,"_5":15155,"_3060":57587,"_31421":57588,"_21524":57589,"_28264":2204},"Revocation lists (CRL)",[50730,52242,56408,57059],[],{"_3604":2205,"_31083":2204,"_21524":57591,"_5":14790,"_28264":2204,"_3060":57592},[],"Generate and distribute signed lists to validate certificates offline.",{"_3604":2206,"_31083":2204,"_5":31418,"_21524":57594,"_28264":57595,"_3060":57596},[],"/docs/platform/pki/crl#crl-settings","CRL settings",{"_3604":2207,"_31083":2204,"_5":31418,"_21524":57598,"_28264":57599,"_3060":57600},[],"/docs/platform/pki/crl#cas-that-share-a-key","CAs that share a key",{"_3604":2208,"_31083":2204,"_5":31418,"_21524":57602,"_28264":57603,"_3060":57604},[],"/docs/platform/pki/crl#periodic-and-automatic-regeneration","Periodic and automatic regeneration",{"_3604":2209,"_31083":2204,"_5":31418,"_21524":57606,"_28264":57607,"_3060":57608},[],"/docs/platform/pki/crl#crl-contents","CRL contents",{"_3604":2210,"_31083":2204,"_5":31418,"_21524":57610,"_28264":57611,"_3060":57612},[],"/docs/platform/pki/crl#public-download-endpoint","Public download endpoint",{"_3604":2211,"_31083":2204,"_5":31418,"_21524":57614,"_28264":57615,"_3060":57616},[],"/docs/platform/pki/crl#crl-settings-api","CRL settings API",{"_3604":2212,"_31083":2204,"_5":31418,"_21524":57618,"_28264":57619,"_3060":57620},[],"/docs/platform/pki/crl#common-crl-settings-errors","Common CRL settings errors",{"_3604":2213,"_31083":2204,"_5":31418,"_21524":57622,"_28264":57623,"_3060":57624},[],"/docs/platform/pki/crl#references","References",{"_3604":2214,"_31083":2204,"_21524":57626,"_5":14790,"_28264":2204,"_3060":57627},[],"A CRL is an issuer-signed list of revoked certificates. This guide is for an operator publishing lists and an integrator using them locally. You need the issuing CA certificate, its CA ID and access to the published endpoint. The client must maintain a current copy: offline operation still requires refreshing evidence.",{"_3604":2215,"_31083":2204,"_21524":57629,"_5":14790,"_28264":57595,"_3060":57630},[],"The CRL settings of a CA store the configuration and metadata of its latest published list. Each CA has its own settings, keyed by its CA ID — even when two CAs share a key: they share the SKI, not the CRL. The VA creates them when a CA is created; when a CA is imported whose key is in the KMS — either imported with the private key or already held by the KMS — and whose certificate carries `cRLSign`: such a CA publishes its first CRL immediately, like a created one; and when a CA without settings is reissued with a certificate that can sign CRLs. An imported CA whose key is not in the KMS, or whose certificate lacks `cRLSign`, receives no settings: the import succeeds without error, and the CA's CRL endpoints report the settings as missing. Settings are never created retroactively: a CA that has none keeps none until it is reissued. Generation requires a usable issuer key; do not assume an imported CA without a key has an available CRL.",{"_3604":2216,"_31083":2204,"_21524":57632,"_5":14790,"_28264":57595,"_3060":57633},[],"Field",{"_3604":2217,"_31083":2204,"_21524":57635,"_5":14790,"_28264":57595,"_3060":51120},[],{"_3604":2218,"_31083":2204,"_21524":57637,"_5":14790,"_28264":57595,"_3060":52362},[],{"_3604":2219,"_31083":2204,"_21524":57639,"_5":14790,"_28264":57595,"_3060":57640},[],"ID of the CA the settings belong to.",{"_3604":2220,"_31083":2204,"_21524":57642,"_5":14790,"_28264":57595,"_3060":57643},[],"`status`",{"_3604":2221,"_31083":2204,"_21524":57645,"_5":14790,"_28264":57595,"_3060":57646},[],"Lifecycle of the settings. `ACTIVE` ones generate CRLs. `FINAL` ones belong to a CA revoked permanently or expired: the first publishes one final CRL, valid until the CA's current certificate expires, and the second is turned `FINAL` without one. `ARCHIVED` ones belong to a deleted CA: their last CRL is still served, but never regenerated.",{"_3604":2222,"_31083":2204,"_21524":57648,"_5":14790,"_28264":57595,"_3060":57649},[],"`legacy_ski`",{"_3604":2223,"_31083":2204,"_21524":57651,"_5":14790,"_28264":57595,"_3060":57652},[],"Read-only. SKI the settings were keyed by before the 4.0.0 migration; only migrated settings have it, and `/crl/<ski>` keeps resolving to them.",{"_3604":2224,"_31083":2204,"_21524":57654,"_5":14790,"_28264":57595,"_3060":57655},[],"`latest_crl`",{"_3604":2225,"_31083":2204,"_21524":57657,"_5":14790,"_28264":57595,"_3060":57658},[],"Version, validity start and end of the last published list. Read-only.",{"_3604":2226,"_31083":2204,"_21524":57660,"_5":14790,"_28264":57595,"_3060":57661},[],"`crl_options` field",{"_3604":2227,"_31083":2204,"_21524":57663,"_5":14790,"_28264":57595,"_3060":51120},[],{"_3604":2228,"_31083":2204,"_21524":57665,"_5":14790,"_28264":57595,"_3060":57666},[],"Initial value",{"_3604":2229,"_31083":2204,"_21524":57668,"_5":14790,"_28264":57595,"_3060":57669},[],"`validity`",{"_3604":2230,"_31083":2204,"_21524":57671,"_5":14790,"_28264":57595,"_3060":57672},[],"Time from `thisUpdate` to `nextUpdate`.",{"_3604":2231,"_31083":2204,"_21524":57674,"_5":14790,"_28264":57595,"_3060":57675},[],"7 days.",{"_3604":2232,"_31083":2204,"_21524":57677,"_5":14790,"_28264":57595,"_3060":57678},[],"`refresh_interval`",{"_3604":2233,"_31083":2204,"_21524":57680,"_5":14790,"_28264":57595,"_3060":57681},[],"Time since the issuance of the latest published CRL that triggers scheduled renewal; `0` disables only this trigger. The effective granularity is bounded by the job frequency (see Periodic and automatic regeneration).",{"_3604":2234,"_31083":2204,"_21524":57683,"_5":14790,"_28264":57595,"_3060":57684},[],"6 days and 23 hours.",{"_3604":2235,"_31083":2204,"_21524":57686,"_5":14790,"_28264":57595,"_3060":57687},[],"`regenerate_on_revoke`",{"_3604":2236,"_31083":2204,"_21524":57689,"_5":14790,"_28264":57595,"_3060":57690},[],"Request regeneration on revocation or reactivation from `CertificateHold` events.",{"_3604":2237,"_31083":2204,"_21524":57692,"_5":14790,"_28264":57595,"_3060":57693},[],"`true`.",{"_3604":2238,"_31083":2204,"_21524":57695,"_5":14790,"_28264":57595,"_3060":57696},[],"`signer_serial_number`",{"_3604":2239,"_31083":2204,"_21524":57698,"_5":14790,"_28264":57595,"_3060":57699},[],"Serial number of the existing certificate that signs the CRL.",{"_3604":2240,"_31083":2204,"_21524":57701,"_5":14790,"_28264":57595,"_3060":57702},[],"Serial number of the CA’s current certificate.",{"_3604":2241,"_31083":2204,"_21524":57704,"_5":14790,"_28264":57595,"_3060":57705},[],"The signer must be an existing certificate with the `cRLSign` key usage and the same subject and public key as the CA. Certificates from before a reissue qualify. A delegated signer is not supported: a certificate with the CA’s subject but a different key is rejected.",{"_3604":2242,"_31083":2204,"_21524":57707,"_5":14790,"_28264":57595,"_3060":57708},[],"When a CA is reissued and the signer is the superseded CA certificate, the VA moves the signer to the new certificate — provided it carries `cRLSign` — and republishes the CRL. If the new certificate lacks `cRLSign`, the VA keeps the previous signer and logs a warning. If the signer is any other certificate with the CA’s subject and key, it is deliberately left unchanged; the previous certificate then cannot be deleted while the settings use it (the API returns `409` `certificate is in use`), and to retire it you update the signer with `PUT`.",{"_3604":2243,"_31083":2204,"_21524":57710,"_5":14790,"_28264":57595,"_3060":57711},[],"The CRL lifecycle decisions — when publication stops and when the final CRL expires — use only the CA's current certificate. If a reissued certificate expires earlier than an older certificate that is still valid, CRL publication can stop, or the final CRL can expire, while the older certificate is still valid. This is an accepted limitation of the current behavior.",{"_3604":2244,"_31083":2204,"_21524":57713,"_5":14790,"_28264":57595,"_3060":57714},[],"A CA whose signer lacks `cRLSign` cannot generate its CRL, and an update that selects a signer without `cRLSign` is rejected (400 error). Since 4.0 the VA requires this usage. Check before importing with `openssl x509 -noout -ext keyUsage` and, if it is missing, obtain a certificate for the same CA and key that includes it and update the settings to use it as the signer. A CA that has no settings at all — for example, one imported without `cRLSign` — has nothing to update: the only way to obtain them is to reissue the CA with a certificate that carries `cRLSign`. After reissuing a CA, also check the key usage of the new certificate: it may not keep the original’s usages, and without `cRLSign` the settings keep their previous signer.",{"_3604":2245,"_31083":2204,"_21524":57716,"_5":14790,"_28264":57595,"_3060":57717},[],"Deleting a CA keeps its CRL settings; they remain until you delete the archived ones through the API or from the console's Verification Authorities page (see CRL settings API). What happens to them depends on how the CA ended:",{"_3604":2246,"_31083":2204,"_21524":57719,"_5":14790,"_28264":57595,"_3060":57720},[],"The 4.0.0 upgrade migration archives the settings of the CAs that had been deleted before the upgrade. Their `status` is `ARCHIVED` and their `ca_id` is `legacy-<ski>`: the last CRL keeps being served, but it is never regenerated, any `PUT` returns 409, and there is no API way back to `ACTIVE`.",{"_3604":2247,"_31083":2204,"_21524":57722,"_5":14790,"_28264":57595,"_3060":57723},[],"Revoking a CA permanently or letting it expire finalizes its settings: their `status` becomes `FINAL`, any `PUT` returns 409, and no new CRL is generated. A permanently revoked CA publishes one final CRL, valid until the CA's current certificate expires; an expired CA gets none. Deleting the CA afterwards archives its settings, which then behave like the archived ones of the migration.",{"_3604":2248,"_31083":2204,"_21524":57725,"_5":14790,"_28264":57595,"_3060":57726},[],"The settings can no longer be edited while their `status` is not `ACTIVE`. Adjust validity and signer before revoking or deleting a CA.",{"_3604":2249,"_31083":2204,"_21524":57728,"_5":14790,"_28264":57595,"_3060":57729},[],"`PUT` validates the signer only when the request changes it. If the stored signer is no longer valid, the other options can still be edited, but the CRL cannot be regenerated until a valid signer is set.",{"_3604":2250,"_31083":2204,"_21524":57731,"_5":14790,"_28264":57595,"_3060":57732},[],"Sharing a key between CAs is a migration blocker: the 4.0.0 upgrade aborts while an SKI belongs to more than one CA. See CAs that share a key.",{"_3604":2251,"_31083":2204,"_21524":57734,"_5":14790,"_28264":57595,"_3060":57735},[],"CRL versions are kept as PEM in object storage at `pki/va/crl/<ca-id>/<version>.crl`; the public endpoint returns DER. CRLs published before the 4.0.0 upgrade remain at `pki/va/crl/<ski>/<version>.crl` and keep being served.",{"_3604":2252,"_31083":2204,"_21524":57737,"_5":14790,"_28264":57599,"_3060":57738},[],"Since 4.0.0, each CA publishes its own CRL even when its key is shared: two CAs with the same key have the same SKI, but each has its own CRL settings and its own list, signed by a certificate with that CA’s identity.",{"_3604":2253,"_31083":2204,"_21524":57740,"_5":14790,"_28264":57599,"_3060":57741},[],"Certificates issued from now on carry `/crl/<ca-id>` distribution points, so each CA’s certificates resolve to its own list. Certificates issued before the upgrade keep their `/crl/<ski>` distribution points: that URL keeps resolving to the settings the upgrade migrated, and always serves the list of the CA that owned that SKI when the upgrade ran. It is never rebound to a CA created later with the same key. After regeneration, the migrated list includes both URLs in its *Issuing Distribution Point* (OID `2.5.29.28`), so a verifier that compares the IDP with the CDP of the certificate accepts either form. Until the VA scheduled CRL job successfully regenerates it, the pre-upgrade list contains only the legacy `/crl/<ski>` IDP; IDP-checking verifiers cannot validate newly issued certificates with `/crl/<ca-id>` CDPs. The first run can take up to about an hour with the default schedule, and failures can extend the window.",{"_3604":2254,"_31083":2204,"_21524":57743,"_5":14790,"_28264":57599,"_3060":57744},[],"Sharing an SKI between CAs blocks the upgrade: the migration aborts and names the SKIs. To detect the problem before upgrading, compare the SKI of the CAs in the inventory: two with the same SKI are affected. To fix it, create a CA with its own key and reissue its certificates; those already issued keep the old URL and are not corrected until reissued.",{"_3604":2255,"_31083":2204,"_21524":57746,"_5":14790,"_28264":57599,"_3060":57747},[],"Lamassu takes the SKI of an imported certificate as-is and does not check that it corresponds to its public key. Until Lamassu rejects imports whose SKI collides with an existing CA — proposed in lamassuiot#834, together with the per-CA CRL that 4.0.0 implements — restrict the permission to import CAs as an interim control; it covers only the import path. Creating a CA with &#x2A;*Create New CA (Existing Key)** on a KMS key another CA already uses produces the same SKI collision, so avoid reusing keys across CAs.",{"_3604":2256,"_31083":2204,"_21524":57749,"_5":14790,"_28264":57603,"_3060":57750},[],"The VA scheduled job checks the CRL settings of every CA on each run and requests a new list when either of these conditions is met:",{"_3604":2257,"_31083":2204,"_21524":57752,"_5":14790,"_28264":57603,"_3060":57753},[],"**The list is about to expire:** the remaining validity of `latest_crl` is less than the interval between job runs. This condition always applies and cannot be disabled.",{"_3604":2258,"_31083":2204,"_21524":57755,"_5":14790,"_28264":57603,"_3060":57756},[],"**The refresh interval has elapsed:** the time since the issuance of the latest published CRL reaches `refresh_interval`. Setting `refresh_interval` to `0` disables only this condition; the list is still regenerated when it is about to expire.",{"_3604":2259,"_31083":2204,"_21524":57758,"_5":14790,"_28264":57603,"_3060":57759},[],"Setting `refresh_interval` to `0` therefore does not freeze regeneration. With the default 7-day validity and an hourly job, a CRL is renewed up to an hour before it expires even if `refresh_interval` is `0`. Because the job runs on its own schedule, `refresh_interval` is honored only as precisely as the job frequency allows.",{"_3604":2260,"_31083":2204,"_21524":57761,"_5":14790,"_28264":57603,"_3060":57762},[],"The job frequency is set in Helm with `services.va.job.crl.frequency` (default `0 * * * *`) and accepts a duration (`1h`) or a cron expression. A cron expression is converted into a constant interval equal to the time left until its next firing when the service starts, so it is not aligned with the clock. Keep `validity` well above that interval: with a shorter validity, the list is regenerated on every cycle.",{"_3604":2261,"_31083":2204,"_21524":57764,"_5":14790,"_28264":57603,"_3060":57765},[],"If generation fails (for example, because the CA cannot be resolved or the signer is invalid), the job logs the warning `something went wrong while calculating CRL for CA <ca-id>` and retries on the next cycle. There is no other renewal path until the cause is fixed, and the last published list keeps being served until it expires. All of this depends on working jobs, storage and signing.",{"_3604":2262,"_31083":2204,"_21524":57767,"_5":14790,"_28264":57603,"_3060":57768},[],"Settings whose `status` is not `ACTIVE` — `FINAL` or `ARCHIVED` — are skipped: nothing regenerates their CRL.",{"_3604":2263,"_31083":2204,"_21524":57770,"_5":14790,"_28264":57603,"_3060":57771},[],"With `regenerate_on_revoke`, the event handler requests a new CRL upon revocation or reactivation from `CertificateHold` to `ACTIVE`. This happens after the status change and has its own failure paths: if generation fails (for example, because of an invalid signer), the event is retried and, once retries are exhausted, moves to the failed-events queue. If the issuing CA has no CRL settings, there is no CRL to regenerate: the event is acknowledged without retry, the VA logs a warning, and nothing appears in the failed-events queue. Confirming revocation does not establish that the new CRL is already published or that all clients have downloaded it.",{"_3604":2264,"_31083":2204,"_21524":57773,"_5":14790,"_28264":57603,"_3060":57774},[],"Compare CRL numbers and timestamps before and after a change. Monitor expired lists and generation failures; clients must apply policy when current evidence is unavailable.",{"_3604":2265,"_31083":2204,"_21524":57776,"_5":14790,"_28264":57607,"_3060":57777},[],"Each entry contains serial number, revocation time and reason. The generator queries certificates in `REVOKED` state for the selected CA. A reactivated certificate disappears when the list is recalculated; an earlier downloaded copy retains its contents.",{"_3604":2266,"_31083":2204,"_21524":57779,"_5":14790,"_28264":57607,"_3060":57780},[],"The list contains a critical *Issuing Distribution Point* (OID `2.5.29.28`) with configured distribution URLs. Check that your client interprets this extension and that it matches the list’s scope. If rejected, investigate format and scope; ignoring a critical extension is not successful validation.",{"_3604":2267,"_31083":2204,"_21524":57782,"_5":14790,"_28264":57611,"_3060":57783},[],"The VA service exposes `GET /crl/{id}` without management authorization. Use the **issuing CA’s** ID, not the end-entity certificate’s ID or serial. Certificates issued before the 4.0.0 upgrade carry `/crl/<ski>` URLs with the SKI of the CA key; that form keeps resolving. First inspect the certificate’s CDP:",{"_3604":2268,"_31083":2204,"_21524":57785,"_5":14790,"_28264":57611,"_3060":57786},[],"Replace the following URL with the CDP URL and review exposure in Deployment:",{"_3604":2269,"_31083":2204,"_21524":57788,"_5":14790,"_28264":57611,"_3060":57789},[],"You need OpenSSL 3.x and `issuer.pem` containing the direct issuer’s certificate. An accepted signer certificate has the same subject and public key as the CA, so this signature check also works when the settings point to an earlier certificate for that CA and key. Require a valid signature, current timestamps and the expected issuer. For a root that issues directly:",{"_3604":2270,"_31083":2204,"_21524":57791,"_5":14790,"_28264":57611,"_3060":57792},[],"`roots.pem` contains deliberately trusted roots. For intermediates, add `-untrusted intermediates.pem` before the `device.crt` argument. `-crl_check` checks the end-entity certificate’s revocation against the local list; it does not download other lists or establish the status of the whole chain. A complete chain check needs the corresponding CRLs and a policy requiring them.",{"_3604":2271,"_31083":2204,"_21524":57794,"_5":14790,"_28264":57611,"_3060":57795},[],"The test should accept an allowed certificate absent from the list and reject it with `certificate revoked` after publishing and using the list containing its serial.",{"_3604":2272,"_31083":2204,"_21524":57797,"_5":14790,"_28264":57615,"_3060":57798},[],"The following paths are relative to the VA service; confirm the public prefix in the Gateway. They are not the URLs of the public OCSP and CRL endpoints.",{"_3604":2273,"_31083":2204,"_21524":57800,"_5":14790,"_28264":57615,"_3060":54173},[],{"_3604":2274,"_31083":2204,"_21524":57802,"_5":14790,"_28264":57615,"_3060":57803},[],"Relative path",{"_3604":2275,"_31083":2204,"_21524":57805,"_5":14790,"_28264":57615,"_3060":54170},[],{"_3604":2276,"_31083":2204,"_21524":57807,"_5":14790,"_28264":57615,"_3060":57808},[],"`GET`",{"_3604":2277,"_31083":2204,"_21524":57810,"_5":14790,"_28264":57615,"_3060":57811},[],"`/v1/crl-settings`",{"_3604":2278,"_31083":2204,"_21524":57813,"_5":14790,"_28264":57615,"_3060":57814},[],"List the CRL settings; filterable at least by `ca_id`, `status` and `legacy_ski`.",{"_3604":2279,"_31083":2204,"_21524":57816,"_5":14790,"_28264":57615,"_3060":57808},[],{"_3604":2280,"_31083":2204,"_21524":57818,"_5":14790,"_28264":57615,"_3060":57819},[],"`/v1/crl-settings/{ca-id}`",{"_3604":2281,"_31083":2204,"_21524":57821,"_5":14790,"_28264":57615,"_3060":57822},[],"Read the `crl_options` and `latest_crl` of a CA.",{"_3604":2282,"_31083":2204,"_21524":57824,"_5":14790,"_28264":57615,"_3060":57825},[],"`PUT`",{"_3604":2283,"_31083":2204,"_21524":57827,"_5":14790,"_28264":57615,"_3060":57819},[],{"_3604":2284,"_31083":2204,"_21524":57829,"_5":14790,"_28264":57615,"_3060":57830},[],"Replace the CRL configuration of a CA.",{"_3604":2285,"_31083":2204,"_21524":57832,"_5":14790,"_28264":57615,"_3060":57833},[],"`DELETE`",{"_3604":2286,"_31083":2204,"_21524":57835,"_5":14790,"_28264":57615,"_3060":57819},[],{"_3604":2287,"_31083":2204,"_21524":57837,"_5":14790,"_28264":57615,"_3060":57838},[],"Remove the archived CRL settings of a CA.",{"_3604":2288,"_31083":2204,"_21524":57840,"_5":14790,"_28264":57615,"_3060":57841},[],"You need authentication and CRL settings read, update or delete permissions. Consult your installation’s API reference and Access control. Read current configuration before updating and send the full object expected by the contract — `refresh_interval`, `validity`, `signer_serial_number` and `regenerate_on_revoke`: the backend replaces all four; it does not merge omitted fields. `status`, `legacy_ski` and `latest_crl` are read-only. A `PUT` returns 409 when the settings are not `ACTIVE`, validates the signer only when it changes, and does not regenerate the CRL.",{"_3604":2289,"_31083":2204,"_21524":57843,"_5":14790,"_28264":57615,"_3060":57844},[],"Archived settings, whose CA no longer exists, can be removed with `DELETE`: the call returns 204 on success, 404 when the CA has no settings and 409 while the settings are not yet archived. After the deletion, the public `/crl/{id}` endpoint and any legacy `/crl/<ski>` endpoint stop serving the CA’s list, although the published CRL files remain in the bucket. Keep the archived settings while any certificate issued by the CA may still need revocation evidence: `DELETE` stops serving the list immediately, regardless of `latest_crl` validity. The action cannot be undone.",{"_3604":2290,"_31083":2204,"_21524":57846,"_5":14790,"_28264":57615,"_3060":57847},[],"After a change, check saved configuration and the next list actually published. Updating the settings alone does not establish regeneration or client acceptance.",{"_3604":2291,"_31083":2204,"_21524":57849,"_5":14790,"_28264":57619,"_3060":57850},[],"Symptom",{"_3604":2292,"_31083":2204,"_21524":57852,"_5":14790,"_28264":57619,"_3060":57853},[],"Cause",{"_3604":2293,"_31083":2204,"_21524":57855,"_5":14790,"_28264":57619,"_3060":57856},[],"Action",{"_3604":2294,"_31083":2204,"_21524":57858,"_5":14790,"_28264":57619,"_3060":57859},[],"`PUT /v1/crl-settings/{ca-id}` returns 409.",{"_3604":2295,"_31083":2204,"_21524":57861,"_5":14790,"_28264":57619,"_3060":57862},[],"The settings are not `ACTIVE`: revoking the CA permanently or letting it expire finalized them, or the migration archived them because their CA was deleted before the upgrade.",{"_3604":2296,"_31083":2204,"_21524":57864,"_5":14790,"_28264":57619,"_3060":57865},[],"There is no API way back to `ACTIVE`. The last CRL keeps being served.",{"_3604":2297,"_31083":2204,"_21524":57867,"_5":14790,"_28264":57619,"_3060":57868},[],"`DELETE /v1/crl-settings/{ca-id}` returns 409.",{"_3604":2298,"_31083":2204,"_21524":57870,"_5":14790,"_28264":57619,"_3060":57871},[],"The settings are not yet `ARCHIVED`: the CA has not been deleted.",{"_3604":2299,"_31083":2204,"_21524":57873,"_5":14790,"_28264":57619,"_3060":57874},[],"Delete the CA first; deleting it archives its settings.",{"_3604":2300,"_31083":2204,"_21524":57876,"_5":14790,"_28264":57619,"_3060":57877},[],"`PUT` returns 400.",{"_3604":2301,"_31083":2204,"_21524":57879,"_5":14790,"_28264":57619,"_3060":57880},[],"The new signer lacks `cRLSign`, or its subject and public key do not match the CA.",{"_3604":2302,"_31083":2204,"_21524":57882,"_5":14790,"_28264":57619,"_3060":57883},[],"Set the serial number of a valid certificate of that CA.",{"_3604":2303,"_31083":2204,"_21524":57885,"_5":14790,"_28264":57619,"_3060":57886},[],"`PUT` returns 404.",{"_3604":2304,"_31083":2204,"_21524":57888,"_5":14790,"_28264":57619,"_3060":57889},[],"The CA or the new signer certificate does not exist, or the CA has no CRL settings, for example because it was imported without its key or its certificate lacks `cRLSign`.",{"_3604":2305,"_31083":2204,"_21524":57891,"_5":14790,"_28264":57619,"_3060":57892},[],"Check the CA ID and the signer serial number.",{"_3604":2306,"_31083":2204,"_21524":57894,"_5":14790,"_28264":57619,"_3060":57895},[],"`PUT` returns 400 from a 3.x client.",{"_3604":2307,"_31083":2204,"_21524":57897,"_5":14790,"_28264":57619,"_3060":57898},[],"`crl_options.subject_key_id_signer` was replaced by `crl_options.signer_serial_number`, which is required.",{"_3604":2308,"_31083":2204,"_21524":57900,"_5":14790,"_28264":57619,"_3060":57901},[],"Update the client to send the new field.",{"_3604":2309,"_31083":2204,"_21524":57903,"_5":14790,"_28264":57619,"_3060":57904},[],"The CRL does not change after revoking a certificate.",{"_3604":2310,"_31083":2204,"_21524":57906,"_5":14790,"_28264":57619,"_3060":57907},[],"`regenerate_on_revoke` is `false`, the issuing CA has no CRL settings, or generation failed because of an invalid signer.",{"_3604":2311,"_31083":2204,"_21524":57909,"_5":14790,"_28264":57619,"_3060":57910},[],"Check the VA logs. Missing settings only produce a warning (no retry, no failed-events entry); an invalid signer also leaves the event in the failed-events queue, so fix the signer.",{"_3604":2312,"_31083":2204,"_21524":57912,"_5":14790,"_28264":57619,"_3060":57913},[],"A verifier rejects the CRL because of the issuer.",{"_3604":2313,"_31083":2204,"_21524":57915,"_5":14790,"_28264":57619,"_3060":57916},[],"The list was fetched through a legacy `/crl/<ski>` URL and belongs to the CA that owned that SKI when the upgrade ran.",{"_3604":2314,"_31083":2204,"_21524":57918,"_5":14790,"_28264":57619,"_3060":57919},[],"Use the CDP of the certificate being validated: certificates issued in 4.0.0 carry `/crl/<ca-id>` URLs.",{"_3604":2315,"_31083":2204,"_21524":57921,"_5":14790,"_28264":57623,"_3060":57922},[],"RFC 5280: X.509 and CRL profile.",{"_3604":2316,"_31083":2204,"_21524":57924,"_5":14790,"_28264":57623,"_3060":57925},[],"OpenSSL: openssl-crl.",{"_3604":2317,"_31083":2204,"_21524":57927,"_5":14790,"_28264":57623,"_3060":57928},[],"OpenSSL: openssl-verify.",{"_3604":2318,"_31083":2204,"_21524":57930,"_5":14790,"_28264":57623,"_3060":57931},[],"<Card title=\"OCSP service\" href=\"/docs/platform/pki/ocsp\" />",{"_3604":2319,"_31083":2204,"_21524":57933,"_5":14790,"_28264":57623,"_3060":57934},[],"<Card title=\"Certificate validation\" href=\"/docs/platform/pki/certificate-validation\" />",{"_3604":2320,"_31083":2320,"_5":15155,"_3060":57936,"_31421":57937,"_21524":57938,"_28264":2320},"Keys and cryptographic engines",[50730,52242,56408,56409],[],{"_3604":2321,"_31083":2320,"_21524":57940,"_5":14790,"_28264":2320,"_3060":57941},[],"Generate, import and operate keys without coupling the PKI to a specific provider.",{"_3604":2322,"_31083":2320,"_5":31418,"_21524":57943,"_28264":57944,"_3060":57945},[],"/docs/platform/pki/key-management#what-the-kms-solves","What the KMS solves",{"_3604":2323,"_31083":2320,"_5":31418,"_21524":57947,"_28264":57948,"_3060":57949},[],"/docs/platform/pki/key-management#cryptographic-engines","Cryptographic engines",{"_3604":2324,"_31083":2320,"_5":31418,"_21524":57951,"_28264":57952,"_3060":57953},[],"/docs/platform/pki/key-management#file-system","File System",{"_3604":2325,"_31083":2320,"_5":31418,"_21524":57955,"_28264":57956,"_3060":57957},[],"/docs/platform/pki/key-management#hashicorp-vault","HashiCorp Vault",{"_3604":2326,"_31083":2320,"_5":31418,"_21524":57959,"_28264":57960,"_3060":57961},[],"/docs/platform/pki/key-management#aws-secrets-manager","AWS Secrets Manager",{"_3604":2327,"_31083":2320,"_5":31418,"_21524":57963,"_28264":57964,"_3060":57965},[],"/docs/platform/pki/key-management#aws-kms","AWS KMS",{"_3604":2328,"_31083":2320,"_5":31418,"_21524":57967,"_28264":57968,"_3060":57969},[],"/docs/platform/pki/key-management#pkcs11","PKCS#11",{"_3604":2329,"_31083":2320,"_5":31418,"_21524":57971,"_28264":57972,"_3060":57973},[],"/docs/platform/pki/key-management#azure-key-vault","Azure Key Vault",{"_3604":2330,"_31083":2320,"_5":31418,"_21524":57975,"_28264":57976,"_3060":57977},[],"/docs/platform/pki/key-management#key-inventory","Key inventory",{"_3604":2331,"_31083":2320,"_5":31418,"_21524":57979,"_28264":57980,"_3060":57981},[],"/docs/platform/pki/key-management#create-or-import-keys","Create or import keys",{"_3604":2332,"_31083":2320,"_5":31418,"_21524":57983,"_28264":57984,"_3060":57985},[],"/docs/platform/pki/key-management#generate-a-new-key-pair","Generate a new key pair",{"_3604":2333,"_31083":2320,"_5":31418,"_21524":57987,"_28264":57988,"_3060":57989},[],"/docs/platform/pki/key-management#import-an-existing-pair","Import an existing pair",{"_3604":2334,"_31083":2320,"_5":31418,"_21524":57991,"_28264":57992,"_3060":57993},[],"/docs/platform/pki/key-management#operations-on-a-key","Operations on a key",{"_3604":2335,"_31083":2320,"_5":31418,"_21524":57995,"_28264":57996,"_3060":57997},[],"/docs/platform/pki/key-management#view-details","View details",{"_3604":2336,"_31083":2320,"_5":31418,"_21524":57999,"_28264":58000,"_3060":58001},[],"/docs/platform/pki/key-management#sign-and-verify","Sign and verify",{"_3604":2337,"_31083":2320,"_5":31418,"_21524":58003,"_28264":58004,"_3060":58005},[],"/docs/platform/pki/key-management#sign","Sign",{"_3604":2338,"_31083":2320,"_5":31418,"_21524":58007,"_28264":58008,"_3060":58009},[],"/docs/platform/pki/key-management#verify","Verify",{"_3604":2339,"_31083":2320,"_5":31418,"_21524":58011,"_28264":58012,"_3060":58013},[],"/docs/platform/pki/key-management#generate-a-csr","Generate a CSR",{"_3604":2340,"_31083":2320,"_5":31418,"_21524":58015,"_28264":58016,"_3060":58017},[],"/docs/platform/pki/key-management#sign-locally-with-pkcs11","Sign locally with PKCS#11",{"_3604":2341,"_31083":2320,"_5":31418,"_21524":58019,"_28264":58020,"_3060":58021},[],"/docs/platform/pki/key-management#before-deleting-a-key","Before deleting a key",{"_3604":2342,"_31083":2320,"_21524":58023,"_5":14790,"_28264":2320,"_3060":58024},[],"The Cryptographic Key Management Service (KMS) of Lamassu IoT centralizes the generation, import, custody and use of the platform's keys. This is where you manage the keys that support the CAs and the rest of the signing operations that depend on the PKI.",{"_3604":2343,"_31083":2320,"_21524":58026,"_5":14790,"_28264":2320,"_3060":58027},[],"In the current configuration, Lamassu IoT works exclusively with asymmetric keys, such as RSA and elliptic curves. These keys are used to issue X.509 certificates, sign requests and perform authentication and validation operations within the system.",{"_3604":2344,"_31083":2320,"_21524":58029,"_5":14790,"_28264":57944,"_3060":58030},[],"The KMS unifies key lifecycle management and prevents every service from having to integrate directly with a specific cryptographic provider.",{"_3604":2345,"_31083":2320,"_21524":58032,"_5":14790,"_28264":57944,"_3060":58033},[],"In practice, it lets you:",{"_3604":2346,"_31083":2320,"_21524":58035,"_5":14790,"_28264":57944,"_3060":58036},[],"Generate new key pairs from Lamassu IoT.",{"_3604":2347,"_31083":2320,"_21524":58038,"_5":14790,"_28264":57944,"_3060":58039},[],"Import keys created externally.",{"_3604":2348,"_31083":2320,"_21524":58041,"_5":14790,"_28264":57944,"_3060":58042},[],"Delegate custody and cryptographic operations to external engines.",{"_3604":2349,"_31083":2320,"_21524":58044,"_5":14790,"_28264":57944,"_3060":58045},[],"Reuse existing keys for CAs, CSRs and signing or verification tasks.",{"_3604":2350,"_31083":2320,"_21524":58047,"_5":14790,"_28264":57948,"_3060":58048},[],"Lamassu can work with different cryptographic engines depending on deployment requirements. In some environments a software engine is enough; in others custody must be delegated to an HSM, a cloud service or a specialized platform.",{"_3604":2351,"_31083":2320,"_21524":58050,"_5":14790,"_28264":57948,"_3060":58051},[],"A single instance can have several engines configured at the same time, including multiple instances of the same type. This lets you adapt operations to different security, cost and regulatory requirements.",{"_3604":2352,"_31083":2320,"_21524":58053,"_5":14790,"_28264":57948,"_3060":58054},[],"This guide is for the PKI operator: select and use an already enabled engine. Installation, credentials, persistent storage and connectivity belong to Deployment. Before generating a CA, check the default engine, advertised algorithms and a test signature. Availability in your installation depends on its version and configuration.",{"_3604":2353,"_31083":2320,"_21524":58056,"_5":14790,"_28264":57952,"_3060":58057},[],"Generates software keys and stores private material in files. Custody depends on installation permissions, storage and backups. Before using it for an operational CA, agree how the key will be recovered and how replicas will access it; the KMS record does not replace those files.",{"_3604":2354,"_31083":2320,"_21524":58059,"_5":14790,"_28264":57956,"_3060":58060},[],"The adapter uses KV storage for private material. This is not signing within Vault Transit: someone able to read the secret can recover the key. Review read permissions, availability and recovery with the deployment owner.",{"_3604":2355,"_31083":2320,"_21524":58062,"_5":14790,"_28264":57956,"_3060":58063},[],"The adapter reaches Vault over its configured HTTP(S) endpoint. The Vault server certificate is verified against the system trust store; a Vault signed by a private CA is trusted by adding its CA certificate to the engine's `ca_cert_file` (PEM-encoded). `insecure_skip_verify=true` disables verification and is a last resort; agree the transport settings with the deployment owner.",{"_3604":2356,"_31083":2320,"_21524":58065,"_5":14790,"_28264":57960,"_3060":58066},[],"Offers encrypted persistence in AWS at a cost. It protects the key at rest, but an authorized administrator can recover it; it does not provide the same extraction resistance as a KMS or HSM.",{"_3604":2357,"_31083":2320,"_21524":58068,"_5":14790,"_28264":57964,"_3060":58069},[],"Delegates signing to AWS KMS. The adapter also implements external material import, subject to provider capabilities and permissions. A key generated outside the service has already existed outside its custody; importing it does not remove those copies. Check generation, import and signing as separate operations.",{"_3604":2358,"_31083":2320,"_21524":58071,"_5":14790,"_28264":57968,"_3060":58072},[],"Allows integrating local HSMs, isolated environments and *Key as a Service* offerings. Generation, persistence and extraction resistance depend on the specific device or provider. It is the most flexible option when policy requires hardware custody.",{"_3604":2359,"_31083":2320,"_21524":58074,"_5":14790,"_28264":57972,"_3060":58075},[],"The backend also provides adapters for **Key Vault Keys** and **Key Vault Secrets**. The former delegates signing to the key service; the latter stores private material as secrets and signs using that material. These are different custody models. Confirm which adapter is enabled in your installation and test the required operations.",{"_3604":2360,"_31083":2320,"_21524":58077,"_5":14790,"_28264":57972,"_3060":58078},[],"Lamassu shows the enabled engines in the console.",{"_3604":2361,"_31083":2320,"_21524":58080,"_5":14790,"_28264":57972,"_3060":58081},[],"Each engine defines which algorithms it supports, such as RSA or ECC/ECDSA, and which key sizes it can generate.",{"_3604":2362,"_31083":2320,"_21524":58083,"_5":14790,"_28264":57972,"_3060":58084},[],"Confirm with the deployment operator which engine is configured as the default. That engine will be used when a process needs to create or persist a key and the user has not selected a specific one, for example when creating or importing a CA.",{"_3604":2363,"_31083":2320,"_21524":58086,"_5":14790,"_28264":57976,"_3060":58087},[],"The main KMS screen shows the complete inventory of keys registered in the system. It is the reference view for reviewing which keys exist, where they are kept and which entities they relate to.",{"_3604":2364,"_31083":2320,"_21524":58089,"_5":14790,"_28264":57976,"_3060":58090},[],"The table includes the following fields:",{"_3604":2365,"_31083":2320,"_21524":58092,"_5":14790,"_28264":57976,"_3060":58093},[],"**Name**: descriptive name of the key.",{"_3604":2366,"_31083":2320,"_21524":58095,"_5":14790,"_28264":57976,"_3060":58096},[],"**Type**: algorithm and key size, for example RSA 2048 or EC P-256.",{"_3604":2367,"_31083":2320,"_21524":58098,"_5":14790,"_28264":57976,"_3060":58099},[],"**Strength**: visual indicator of cryptographic strength.",{"_3604":2368,"_31083":2320,"_21524":58101,"_5":14790,"_28264":57976,"_3060":58102},[],"**Public/Private**: whether Lamassu manages the full pair or only the public key.",{"_3604":2369,"_31083":2320,"_21524":58104,"_5":14790,"_28264":57976,"_3060":58105},[],"**Crypto Engine**: cryptographic engine keeping the key.",{"_3604":2370,"_31083":2320,"_21524":58107,"_5":14790,"_28264":57976,"_3060":58108},[],"**Aliases**: alternative names associated with the key.",{"_3604":2371,"_31083":2320,"_21524":58110,"_5":14790,"_28264":57976,"_3060":58111},[],"**Tags**: labels for classification and search.",{"_3604":2372,"_31083":2320,"_21524":58113,"_5":14790,"_28264":57976,"_3060":58114},[],"**Related Entities**: certificates or other entities linked to that key.",{"_3604":2373,"_31083":2320,"_21524":58116,"_5":14790,"_28264":57976,"_3060":58117},[],"From this view you also reach the most common actions:",{"_3604":2374,"_31083":2320,"_21524":58119,"_5":14790,"_28264":57976,"_3060":58120},[],"**View Details** to inspect metadata, identifiers and relationships.",{"_3604":2375,"_31083":2320,"_21524":58122,"_5":14790,"_28264":57976,"_3060":58123},[],"**Generate CSR** to create a PKCS#10 request with the selected key.",{"_3604":2376,"_31083":2320,"_21524":58125,"_5":14790,"_28264":57976,"_3060":58126},[],"**Sign / Verify** to test cryptographic operations on the key.",{"_3604":2377,"_31083":2320,"_21524":58128,"_5":14790,"_28264":57976,"_3060":58129},[],"**Delete Key** to remove the key from the system.",{"_3604":2378,"_31083":2320,"_21524":58131,"_5":14790,"_28264":57980,"_3060":58132},[],"You need key administration permissions and a reachable engine. The issuance profile must allow the chosen algorithm if the key will be used in a CA or CSR. Open **Create New Key** and choose generation or import.",{"_3604":2379,"_31083":2320,"_21524":58134,"_5":14790,"_28264":57984,"_3060":58135},[],"If the key will be born inside Lamassu, the recommended flow is to generate a new pair managed directly by one of the configured engines.",{"_3604":2380,"_31083":2320,"_21524":58137,"_5":14790,"_28264":57984,"_3060":58138},[],"On the wizard's first screen, choose **Generate New Key Pair** and then define the main parameters:",{"_3604":2381,"_31083":2320,"_21524":58140,"_5":14790,"_28264":57984,"_3060":58141},[],"**Key Name**: unique and descriptive name.",{"_3604":2382,"_31083":2320,"_21524":58143,"_5":14790,"_28264":57984,"_3060":58144},[],"**Crypto Engine**: engine that will keep the key.",{"_3604":2383,"_31083":2320,"_21524":58146,"_5":14790,"_28264":57984,"_3060":58147},[],"**Key Type** and **Key Size**: algorithm and size or curve.",{"_3604":2384,"_31083":2320,"_21524":58149,"_5":14790,"_28264":57984,"_3060":58150},[],"**Tags**: metadata to classify the key.",{"_3604":2385,"_31083":2320,"_21524":58152,"_5":14790,"_28264":57984,"_3060":58153},[],"**Metadata**: additional information for advanced uses.",{"_3604":2386,"_31083":2320,"_21524":58155,"_5":14790,"_28264":57988,"_3060":58156},[],"Importing lets you register in Lamassu a key generated outside the platform. It is the usual flow in BYOK scenarios, migrations or integration with cryptographic material already in production.",{"_3604":2387,"_31083":2320,"_21524":58158,"_5":14790,"_28264":57988,"_3060":58159},[],"When you have an exportable private key and the destination engine supports import.",{"_3604":2388,"_31083":2320,"_21524":58161,"_5":14790,"_28264":57988,"_3060":58162},[],"When an existing PKI needs to be migrated without reissuing certificates.",{"_3604":2389,"_31083":2320,"_21524":58164,"_5":14790,"_28264":57988,"_3060":58165},[],"When Lamassu must operate with a root of trust created by a third party.",{"_3604":2390,"_31083":2320,"_21524":58167,"_5":14790,"_28264":57988,"_3060":58168},[],"In the wizard, choose **Import Existing Key Pair** and complete the requested fields:",{"_3604":2391,"_31083":2320,"_21524":58170,"_5":14790,"_28264":57988,"_3060":58171},[],"**Key Name**: descriptive name within Lamassu IoT.",{"_3604":2392,"_31083":2320,"_21524":58173,"_5":14790,"_28264":57988,"_3060":58174},[],"**Crypto Engine**: engine that will keep the imported key.",{"_3604":2393,"_31083":2320,"_21524":58176,"_5":14790,"_28264":57988,"_3060":58177},[],"**Tags**: labels for organization and search.",{"_3604":2394,"_31083":2320,"_21524":58179,"_5":14790,"_28264":57988,"_3060":58180},[],"**Metadata**: additional optional information.",{"_3604":2395,"_31083":2320,"_21524":58182,"_5":14790,"_28264":57988,"_3060":58183},[],"**Private Key (PEM)**: private key in PEM format.",{"_3604":2396,"_31083":2320,"_21524":58185,"_5":14790,"_28264":57988,"_3060":58186},[],"After a successful import, open the record, check the engine and public key, and perform a test signature. A non-exportable HSM key cannot be uploaded through this PEM form: configure engine access and check how the existing key is registered. Review dependencies and any provider resources already created if an operation fails partway through.",{"_3604":2397,"_31083":2320,"_21524":58188,"_5":14790,"_28264":57992,"_3060":58189},[],"Each registered key has a detail view and several operational actions.",{"_3604":2398,"_31083":2320,"_21524":58191,"_5":14790,"_28264":57996,"_3060":58192},[],"The **View Details** screen concentrates the technical and administrative information of the key.",{"_3604":2399,"_31083":2320,"_21524":58194,"_5":14790,"_28264":57996,"_3060":58195},[],"The **Overview** tab shows, among others, these fields:",{"_3604":2400,"_31083":2320,"_21524":58197,"_5":14790,"_28264":57996,"_3060":58198},[],"**Key Name**: descriptive name.",{"_3604":2401,"_31083":2320,"_21524":58200,"_5":14790,"_28264":57996,"_3060":58201},[],"**Key Identifier**: unique system identifier. Lamassu uses PKCS11-based ID formats.",{"_3604":2402,"_31083":2320,"_21524":58203,"_5":14790,"_28264":57996,"_3060":58204},[],"**Tags**: associated labels.",{"_3604":2403,"_31083":2320,"_21524":58206,"_5":14790,"_28264":57996,"_3060":58207},[],"**Aliases**: alternative names.",{"_3604":2404,"_31083":2320,"_21524":58209,"_5":14790,"_28264":57996,"_3060":58210},[],"**Crypto Engine**: engine where the key resides.",{"_3604":2405,"_31083":2320,"_21524":58212,"_5":14790,"_28264":57996,"_3060":58213},[],"**Algorithm, Key Size & Strength**: algorithm, parameters and strength level.",{"_3604":2406,"_31083":2320,"_21524":58215,"_5":14790,"_28264":57996,"_3060":58216},[],"The **Related Entities** section shows which Lamassu objects depend on that key.",{"_3604":2407,"_31083":2320,"_21524":58218,"_5":14790,"_28264":57996,"_3060":58219},[],"The **Public Key** tab shows public material in PEM. The record’s identifier and URI locate the key; a PKCS#11-formatted URI does not establish that the engine is an HSM or that a local module can access it.",{"_3604":2408,"_31083":2320,"_21524":58221,"_5":14790,"_28264":58000,"_3060":58222},[],"The **Sign / Verify** action validates that the key and the cryptographic engine work correctly.",{"_3604":2409,"_31083":2320,"_21524":58224,"_5":14790,"_28264":58000,"_3060":58225},[],"Sign a test message, save the signature and verify it using the same public key, algorithm and encoding. Then change the message: verification should fail. This tests one operation; it does not establish every engine capability or a CA’s chain.",{"_3604":2410,"_31083":2320,"_21524":58227,"_5":14790,"_28264":58000,"_3060":58228},[],"When you open it, two areas appear: **Sign** and **Verify**.",{"_3604":2411,"_31083":2320,"_21524":58230,"_5":14790,"_28264":58004,"_3060":58231},[],"This tab uses the private key to generate a digital signature over a message or an already computed *digest*.",{"_3604":2412,"_31083":2320,"_21524":58233,"_5":14790,"_28264":58004,"_3060":58234},[],"Main fields:",{"_3604":2413,"_31083":2320,"_21524":58236,"_5":14790,"_28264":58004,"_3060":58237},[],"**Algorithm**: signing algorithm available for the key type.",{"_3604":2414,"_31083":2320,"_21524":58239,"_5":14790,"_28264":58004,"_3060":58240},[],"**Message Type**: `Raw` for clear data or `Digest` for a precomputed hash.",{"_3604":2415,"_31083":2320,"_21524":58242,"_5":14790,"_28264":58004,"_3060":58243},[],"**Payload Encoding**: input encoding, such as UTF-8, Hex or Base64.",{"_3604":2416,"_31083":2320,"_21524":58245,"_5":14790,"_28264":58004,"_3060":58246},[],"**Message**: content to sign.",{"_3604":2417,"_31083":2320,"_21524":58248,"_5":14790,"_28264":58004,"_3060":58249},[],"**Signature**: result of the operation, shown in hexadecimal.",{"_3604":2418,"_31083":2320,"_21524":58251,"_5":14790,"_28264":58008,"_3060":58252},[],"This tab checks whether a signature corresponds to the associated public key.",{"_3604":2419,"_31083":2320,"_21524":58254,"_5":14790,"_28264":58008,"_3060":58234},[],{"_3604":2420,"_31083":2320,"_21524":58256,"_5":14790,"_28264":58008,"_3060":58257},[],"**Algorithm**: must match the algorithm used for the signature.",{"_3604":2421,"_31083":2320,"_21524":58259,"_5":14790,"_28264":58008,"_3060":58260},[],"**Message Type**: `Raw` or `Digest`.",{"_3604":2422,"_31083":2320,"_21524":58262,"_5":14790,"_28264":58008,"_3060":58263},[],"**Payload Encoding**: encoding of the message.",{"_3604":2423,"_31083":2320,"_21524":58265,"_5":14790,"_28264":58008,"_3060":58266},[],"**Message**: original message or hash.",{"_3604":2424,"_31083":2320,"_21524":58268,"_5":14790,"_28264":58008,"_3060":58269},[],"**Signature**: signature to check.",{"_3604":2425,"_31083":2320,"_21524":58271,"_5":14790,"_28264":58008,"_3060":58272},[],"**Result**: indicator of the validation result.",{"_3604":2426,"_31083":2320,"_21524":58274,"_5":14790,"_28264":58012,"_3060":58275},[],"The **Generate CSR** action creates a PKCS#10 request signed with the private key kept in Lamassu, without exposing it outside the cryptographic engine.",{"_3604":2427,"_31083":2320,"_21524":58277,"_5":14790,"_28264":58012,"_3060":58278},[],"This flow is useful for:",{"_3604":2428,"_31083":2320,"_21524":58280,"_5":14790,"_28264":58012,"_3060":58281},[],"Requesting certificates from an external CA.",{"_3604":2429,"_31083":2320,"_21524":58283,"_5":14790,"_28264":58012,"_3060":58284},[],"Renewing an identity while keeping the same key.",{"_3604":2430,"_31083":2320,"_21524":58286,"_5":14790,"_28264":58012,"_3060":58287},[],"When you open the form, it asks for the subject data and the main certificate attributes:",{"_3604":2431,"_31083":2320,"_21524":58289,"_5":14790,"_28264":58012,"_3060":58290},[],"**Common Name (CN)**: main name of the identity.",{"_3604":2432,"_31083":2320,"_21524":58292,"_5":14790,"_28264":58012,"_3060":58293},[],"**Organization (O)**: organization or company.",{"_3604":2433,"_31083":2320,"_21524":58295,"_5":14790,"_28264":58012,"_3060":58296},[],"**Organizational Unit (OU)**: department or unit.",{"_3604":2434,"_31083":2320,"_21524":58298,"_5":14790,"_28264":58012,"_3060":58299},[],"**Country (C)**: two-letter country code.",{"_3604":2435,"_31083":2320,"_21524":58301,"_5":14790,"_28264":58012,"_3060":58302},[],"**State / Province (ST)**: state or province.",{"_3604":2436,"_31083":2320,"_21524":58304,"_5":14790,"_28264":58012,"_3060":58305},[],"**Locality (L)**: city or locality.",{"_3604":2437,"_31083":2320,"_21524":58307,"_5":14790,"_28264":58012,"_3060":58308},[],"**Email Address**: contact email.",{"_3604":2438,"_31083":2320,"_21524":58310,"_5":14790,"_28264":58012,"_3060":58311},[],"**Subject Alternative Names (SANs)**: alternative names or identifiers, such as DNS or IP.",{"_3604":2439,"_31083":2320,"_21524":58313,"_5":14790,"_28264":58012,"_3060":58314},[],"Download the CSR and run `openssl req -in request.csr -noout -verify -text`. Check signature, subject and SAN before sending it. A CSR does not determine the final certificate by itself: issuance policy can replace its fields.",{"_3604":2440,"_31083":2320,"_21524":58316,"_5":14790,"_28264":58016,"_3060":58317},[],"Lamassu also offers specific help for local integrations through **Sign locally with OpenSSL & PKCS11 tools**.",{"_3604":2441,"_31083":2320,"_21524":58319,"_5":14790,"_28264":58016,"_3060":58320},[],"It requires the module, token and permissions of the corresponding provider. Check that the Lamassu identifier matches the object accessible from that module. Module configuration belongs to the client environment or Deployment.",{"_3604":2442,"_31083":2320,"_21524":58322,"_5":14790,"_28264":58020,"_3060":58323},[],"Review **Related Entities** and locate CAs, certificates and validation processes that still need signatures. Revoking a CA does not remove the need to publish status during its retention period. Deleting a key does not automatically revoke its certificates either. Plan replacement and retention before using **Delete Key**; provider deletion behavior depends on the engine.",{"_3604":2443,"_31083":2320,"_21524":58325,"_5":14790,"_28264":58020,"_3060":58326},[],"The KMS refuses to delete a key that certificates still reference, with `409` `key is in use`. Revoking a certificate or letting it expire does not release its key reference. Deleting a CA releases the references from its own current certificate and linked reissued certificates, which stay in place to back the CRL and OCSP, and then attempts to delete the key. If other certificates still reference the key, such as another CA sharing it, the KMS keeps it. The certificates the CA issued keep their own key references, even when revoked. The API lets you delete such a certificate only once its issuer CA no longer exists, and deleting it removes it from the CRL and OCSP responses, so keep revoked certificates for their retention period and delete only expired or superseded ones. The KMS also refuses to delete a key that signs the CRL of a CA whose CRL settings are still `ACTIVE`, with the same `409` `key is in use`; that reference is released when the settings are finalized, after the CA is revoked permanently or expires (see CRL). Legacy references retained by the upgrade migration are described in the upgrade guide.",{"_3604":2444,"_31083":2444,"_5":15155,"_3060":58328,"_31421":58329,"_21524":58330,"_28264":2444},"Online validation with OCSP",[50730,52242,56408,57059],[],{"_3604":2445,"_31083":2444,"_21524":58332,"_5":14790,"_28264":2444,"_3060":58333},[],"Query signed status and verify the responder’s response.",{"_3604":2446,"_31083":2444,"_5":31418,"_21524":58335,"_28264":58336,"_3060":58337},[],"/docs/platform/pki/ocsp#how-the-responder-works-in-lamassu","How the responder works in Lamassu",{"_3604":2447,"_31083":2444,"_5":31418,"_21524":58339,"_28264":58340,"_3060":58341},[],"/docs/platform/pki/ocsp#embedding-in-issued-certificates","Embedding in issued certificates",{"_3604":2448,"_31083":2444,"_5":31418,"_21524":58343,"_28264":58344,"_3060":58345},[],"/docs/platform/pki/ocsp#http-endpoints","HTTP endpoints",{"_3604":2449,"_31083":2444,"_5":31418,"_21524":58347,"_28264":58348,"_3060":58349},[],"/docs/platform/pki/ocsp#generate-and-verify-a-query","Generate and verify a query",{"_3604":2450,"_31083":2444,"_5":31418,"_21524":58351,"_28264":58352,"_3060":58353},[],"/docs/platform/pki/ocsp#check-from-the-interface","Check from the interface",{"_3604":2451,"_31083":2444,"_5":31418,"_21524":58355,"_28264":58356,"_3060":57624},[],"/docs/platform/pki/ocsp#references",{"_3604":2452,"_31083":2444,"_21524":58358,"_5":14790,"_28264":2444,"_3060":58359},[],"OCSP queries a certificate’s status and returns a signed response. This guide is for an integrator checking what Lamassu publishes and how the consumer must verify it. For complete identity validation, follow Certificate validation.",{"_3604":2453,"_31083":2444,"_21524":58361,"_5":14790,"_28264":58336,"_3060":58362},[],"The responder retrieves the certificate by serial number and locates its issuing CA in the inventory. It translates persisted status as follows:",{"_3604":2454,"_31083":2444,"_21524":58364,"_5":14790,"_28264":58336,"_3060":58365},[],"Record status",{"_3604":2455,"_31083":2444,"_21524":58367,"_5":14790,"_28264":58336,"_3060":58368},[],"Signed response",{"_3604":2456,"_31083":2444,"_21524":58370,"_5":14790,"_28264":58336,"_3060":55545},[],{"_3604":2457,"_31083":2444,"_21524":58372,"_5":14790,"_28264":58336,"_3060":58373},[],"`Good`.",{"_3604":2458,"_31083":2444,"_21524":58375,"_5":14790,"_28264":58336,"_3060":55562},[],{"_3604":2459,"_31083":2444,"_21524":58377,"_5":14790,"_28264":58336,"_3060":58378},[],"`Revoked`, with revocation reason and timestamp.",{"_3604":2460,"_31083":2444,"_21524":58380,"_5":14790,"_28264":58336,"_3060":58381},[],"Other states, including `INACTIVE` and `EXPIRED`",{"_3604":2461,"_31083":2444,"_21524":58383,"_5":14790,"_28264":58336,"_3060":58384},[],"`Unknown` if the certificate and issuer can be retrieved.",{"_3604":2462,"_31083":2444,"_21524":58386,"_5":14790,"_28264":58336,"_3060":58387},[],"An absent serial number causes a lookup error; it does not guarantee a signed `Unknown` response. Lookup or signing errors produce an HTTP failure. Treat that as unavailable evidence according to consumer policy.",{"_3604":2463,"_31083":2444,"_21524":58389,"_5":14790,"_28264":58336,"_3060":58390},[],"The issuing CA itself signs the response through its KMS-associated key. A delegated OCSP signing certificate is not used. An imported CA without a usable key cannot sign responses.",{"_3604":2464,"_31083":2444,"_21524":58392,"_5":14790,"_28264":58336,"_3060":58393},[],"The implementation sets `thisUpdate` approximately one day before response generation and `nextUpdate` one day after: the declared window is about 48 hours. Inspect received values and apply your freshness policy. The response reflects stored status when queried; a previously cached copy does not change upon revocation.",{"_3604":2465,"_31083":2444,"_21524":58395,"_5":14790,"_28264":58340,"_3060":58396},[],"The signer constructs OCSP URLs from configured VA domains and adds them to AIA. Without domains, there is no URL to add; an imported certificate retains its original extensions. Inspect the actual certificate:",{"_3604":2466,"_31083":2444,"_21524":58398,"_5":14790,"_28264":58340,"_3060":58399},[],"Check that the consumer can reach this URL. DNS, endpoint exposure and domain configuration belong to Deployment. Changing configuration does not modify already signed certificates.",{"_3604":2467,"_31083":2444,"_21524":58401,"_5":14790,"_28264":58344,"_3060":58402},[],"The service accepts:",{"_3604":2468,"_31083":2444,"_21524":58404,"_5":14790,"_28264":58344,"_3060":54173},[],{"_3604":2469,"_31083":2444,"_21524":58406,"_5":14790,"_28264":58344,"_3060":58407},[],"VA service path",{"_3604":2470,"_31083":2444,"_21524":58409,"_5":14790,"_28264":58344,"_3060":58410},[],"Format",{"_3604":2471,"_31083":2444,"_21524":58412,"_5":14790,"_28264":58344,"_3060":58413},[],"`POST`",{"_3604":2472,"_31083":2444,"_21524":58415,"_5":14790,"_28264":58344,"_3060":58416},[],"`/ocsp`",{"_3604":2473,"_31083":2444,"_21524":58418,"_5":14790,"_28264":58344,"_3060":58419},[],"DER request, `Content-Type: application/ocsp-request`.",{"_3604":2474,"_31083":2444,"_21524":58421,"_5":14790,"_28264":58344,"_3060":57808},[],{"_3604":2475,"_31083":2444,"_21524":58423,"_5":14790,"_28264":58344,"_3060":58424},[],"`/ocsp/{ocsp_request}`",{"_3604":2476,"_31083":2444,"_21524":58426,"_5":14790,"_28264":58344,"_3060":58427},[],"DER request encoded using padded URL Base64.",{"_3604":2477,"_31083":2444,"_21524":58429,"_5":14790,"_28264":58344,"_3060":58430},[],"Use POST to avoid client encoding differences. A successful response has `Content-Type: application/ocsp-response` and a DER body. The public prefix depends on the Gateway; use the URL published in the certificate and checked by the operator.",{"_3604":2478,"_31083":2444,"_21524":58432,"_5":14790,"_28264":58348,"_3060":58433},[],"You need OpenSSL 3.x, `device.crt`, its direct issuer’s certificate `issuer.pem` and the consumer’s trusted roots in `roots.pem`. For an intermediate issuer, also prepare `intermediates.pem` containing the intermediate CAs.",{"_3604":2479,"_31083":2444,"_21524":58435,"_5":14790,"_28264":58348,"_3060":58436},[],"Generate the request:",{"_3604":2480,"_31083":2444,"_21524":58438,"_5":14790,"_28264":58348,"_3060":58439},[],"This example omits the nonce because the responder does not echo it. Verification relies on signature, response correspondence and timestamps; it does not demonstrate freshness through a nonce.",{"_3604":2481,"_31083":2444,"_21524":58441,"_5":14790,"_28264":58348,"_3060":58442},[],"Replace the example URL with the inspected endpoint:",{"_3604":2482,"_31083":2444,"_21524":58444,"_5":14790,"_28264":58348,"_3060":58445},[],"Verify the returned DER:",{"_3604":2483,"_31083":2444,"_21524":58447,"_5":14790,"_28264":58348,"_3060":58448},[],"For intermediates, add `-verify_other intermediates.pem`. Require successful response verification and inspect the status corresponding to `device.crt`, issuer, serial, `thisUpdate` and `nextUpdate`. `Response verify OK` validates the response only: also observe `good`, `revoked` or `unknown`. Do not accept an identity based only on the command’s exit code.",{"_3604":2484,"_31083":2444,"_21524":58450,"_5":14790,"_28264":58352,"_3060":58451},[],"**OCSP Check** shows what Lamassu returns for a selected certificate. Complete the check from the consumer’s network and trust store: a console query does not establish its validation configuration.",{"_3604":2485,"_31083":2444,"_21524":58453,"_5":14790,"_28264":58352,"_3060":58454},[],"To check a change, save an earlier response, revoke a test certificate and request another response. The new query should reflect persisted status; compare timestamps to rule out reuse of an earlier response. If it fails, follow PKI troubleshooting.",{"_3604":2486,"_31083":2444,"_21524":58456,"_5":14790,"_28264":58356,"_3060":58457},[],"RFC 6960: OCSP.",{"_3604":2487,"_31083":2444,"_21524":58459,"_5":14790,"_28264":58356,"_3060":58460},[],"OpenSSL: openssl-ocsp.",{"_3604":2488,"_31083":2444,"_21524":58462,"_5":14790,"_28264":58356,"_3060":58463},[],"<Card title=\"CRL service\" href=\"/docs/platform/pki/crl\" />",{"_3604":2489,"_31083":2444,"_21524":58465,"_5":14790,"_28264":58356,"_3060":57934},[],{"_3604":2490,"_31083":2490,"_5":15155,"_3060":56408,"_31421":58467,"_21524":58468,"_28264":2490},[50730,52242,56408],[],{"_3604":2491,"_31083":2490,"_21524":58470,"_5":14790,"_28264":2490,"_3060":58471},[],"Administer keys and authorities, define issuance and verify the resulting certificates.",{"_3604":2492,"_31083":2490,"_5":31418,"_21524":58473,"_28264":58474,"_3060":55720},[],"/docs/platform/pki/overview#start-here",{"_3604":2493,"_31083":2490,"_5":31418,"_21524":58476,"_28264":58477,"_3060":58478},[],"/docs/platform/pki/overview#what-you-need","What you need",{"_3604":2494,"_31083":2490,"_5":31418,"_21524":58480,"_28264":58481,"_3060":56252},[],"/docs/platform/pki/overview#core-capabilities",{"_3604":2495,"_31083":2490,"_5":31418,"_21524":58483,"_28264":58484,"_3060":56256},[],"/docs/platform/pki/overview#build-your-trust-hierarchy",{"_3604":2496,"_31083":2490,"_5":31418,"_21524":58486,"_28264":58487,"_3060":56260},[],"/docs/platform/pki/overview#protect-cryptographic-keys",{"_3604":2497,"_31083":2490,"_5":31418,"_21524":58489,"_28264":58490,"_3060":56264},[],"/docs/platform/pki/overview#issue-and-control-certificates",{"_3604":2498,"_31083":2490,"_5":31418,"_21524":58492,"_28264":58493,"_3060":56272},[],"/docs/platform/pki/overview#publish-validation-status",{"_3604":2499,"_31083":2490,"_5":31418,"_21524":58495,"_28264":58496,"_3060":58497},[],"/docs/platform/pki/overview#how-to-check-the-result","How to check the result",{"_3604":2500,"_31083":2490,"_5":31418,"_21524":58499,"_28264":58500,"_3060":57226},[],"/docs/platform/pki/overview#continue",{"_3604":2501,"_31083":2490,"_21524":58502,"_5":14790,"_28264":2490,"_3060":58503},[],"The PKI section explains how to build and operate X.509 trust in Lamassu: which authorities issue, which rules apply and how to check certificates. It is intended for PKI administrators and anyone who needs to use certificates in a consuming system.",{"_3604":2502,"_31083":2490,"_21524":58505,"_5":14790,"_28264":58474,"_3060":58506},[],"Follow PKI getting started to create a CA, issue a client certificate and verify it with OpenSSL. The result is a certificate, its private key and a verified chain.",{"_3604":2503,"_31083":2490,"_21524":58508,"_5":14790,"_28264":58474,"_3060":58509},[],"You can complete that path before managing devices. When you need to associate the identity with an inventory or automate its enrollment, continue in IoT Fleets.",{"_3604":2504,"_31083":2490,"_21524":58511,"_5":14790,"_28264":58477,"_3060":58512},[],"An accessible instance and permission to manage the keys, CAs and certificates you will use.",{"_3604":2505,"_31083":2490,"_21524":58514,"_5":14790,"_28264":58477,"_3060":58515},[],"An available cryptographic engine to keep the authority's key.",{"_3604":2506,"_31083":2490,"_21524":58517,"_5":14790,"_28264":58477,"_3060":58518},[],"The certificate's purpose, such as authenticating a client through mTLS.",{"_3604":2507,"_31083":2490,"_21524":58520,"_5":14790,"_28264":58477,"_3060":58521},[],"Consumer requirements: accepted issuers, algorithms, names and permitted usages.",{"_3604":2508,"_31083":2490,"_21524":58523,"_5":14790,"_28264":58477,"_3060":58524},[],"Prepare the instance and cryptographic provider in Deployment. The trust model explains hierarchy choices.",{"_3604":2509,"_31083":2490,"_21524":58526,"_5":14790,"_28264":58484,"_3060":58527},[],"Authorities sign certificates. A root establishes the trust anchor, and an intermediate separates issuance by environment or purpose. Hierarchy and rotation explains how to maintain trust when replacing an authority.",{"_3604":2510,"_31083":2490,"_21524":58529,"_5":14790,"_28264":58487,"_3060":58530},[],"CA signing keys are managed through KMS and cryptographic engines. A client that generates a CSR can keep its own key: preserve that custody when choosing the issuance method.",{"_3604":2511,"_31083":2490,"_21524":58532,"_5":14790,"_28264":58490,"_3060":58533},[],"A profile establishes subject, validity, usage and key restrictions. The CA applies issuance configuration and signs the certificate. In the inventory, you can inspect the result, download it and manage its status.",{"_3604":2512,"_31083":2490,"_21524":58535,"_5":14790,"_28264":58493,"_3060":58536},[],"Validation covers the chain, validity, usages and revocation status. Lamassu publishes status through OCSP and CRL; the consumer configures which issuers it recognizes and how it checks that status.",{"_3604":2513,"_31083":2490,"_21524":58538,"_5":14790,"_28264":58496,"_3060":58539},[],"An active certificate in the console is one part of the check. Also verify that:",{"_3604":2514,"_31083":2490,"_21524":58541,"_5":14790,"_28264":58496,"_3060":58542},[],"its subject and extensions identify the expected client;",{"_3604":2515,"_31083":2490,"_21524":58544,"_5":14790,"_28264":58496,"_3060":58545},[],"its public key matches the client's private key;",{"_3604":2516,"_31083":2490,"_21524":58547,"_5":14790,"_28264":58496,"_3060":58548},[],"its chain reaches a root trusted by the consumer;",{"_3604":2517,"_31083":2490,"_21524":58550,"_5":14790,"_28264":58496,"_3060":58551},[],"its dates and usages allow the operation;",{"_3604":2518,"_31083":2490,"_21524":58553,"_5":14790,"_28264":58496,"_3060":58554},[],"the consumer applies revocation checks and authorization.",{"_3604":2519,"_31083":2490,"_21524":58556,"_5":14790,"_28264":58496,"_3060":58557},[],"The issuance path includes the first independent checks.",{"_3604":2520,"_31083":2490,"_21524":58559,"_5":14790,"_28264":58500,"_3060":58560},[],"<Card title=\"PKI getting started\" description=\"Create a CA, then issue and verify a client certificate.\" href=\"/docs/platform/pki/quickstarts/overview\" />",{"_3604":2521,"_31083":2490,"_21524":58562,"_5":14790,"_28264":58500,"_3060":58563},[],"<Card title=\"Apply PKI to devices\" description=\"Associate certificates with inventory and prepare enrollment.\" href=\"/docs/platform/iot-fleets/overview\" />",{"_3604":2522,"_31083":2490,"_21524":58565,"_5":14790,"_28264":58500,"_3060":58566},[],"<Card title=\"PKI diagnostics\" description=\"Check issuance, OCSP and CRL when the result fails.\" href=\"/docs/platform/pki/troubleshooting\" />",{"_3604":2523,"_31083":2523,"_5":15155,"_3060":58568,"_31421":58569,"_21524":58570,"_28264":2523},"Create your first CA",[50730,52242,56408,55845],[],{"_3604":2524,"_31083":2523,"_21524":58572,"_5":14790,"_28264":2523,"_3060":58573},[],"Create an evaluation root and check its certificate before issuing.",{"_3604":2525,"_31083":2523,"_5":31418,"_21524":58575,"_28264":58576,"_3060":50740},[],"/docs/platform/pki/quickstarts/create-certificate-authority#before-you-begin",{"_3604":2526,"_31083":2523,"_5":31418,"_21524":58578,"_28264":58579,"_3060":58580},[],"/docs/platform/pki/quickstarts/create-certificate-authority#open-the-creation-wizard-toc","Open the creation wizard [!toc]",{"_3604":2527,"_31083":2523,"_5":31418,"_21524":58582,"_28264":58583,"_3060":58584},[],"/docs/platform/pki/quickstarts/create-certificate-authority#select-the-key-toc","Select the key [!toc]",{"_3604":2528,"_31083":2523,"_5":31418,"_21524":58586,"_28264":58587,"_3060":58588},[],"/docs/platform/pki/quickstarts/create-certificate-authority#define-the-authority-toc","Define the authority [!toc]",{"_3604":2529,"_31083":2523,"_5":31418,"_21524":58590,"_28264":58591,"_3060":58592},[],"/docs/platform/pki/quickstarts/create-certificate-authority#review-and-create-the-ca-toc","Review and create the CA [!toc]",{"_3604":2530,"_31083":2523,"_5":31418,"_21524":58594,"_28264":58595,"_3060":58596},[],"/docs/platform/pki/quickstarts/create-certificate-authority#verify-the-result-toc","Verify the result [!toc]",{"_3604":2531,"_31083":2523,"_5":31418,"_21524":58598,"_28264":58599,"_3060":58600},[],"/docs/platform/pki/quickstarts/create-certificate-authority#check-the-ca-certificate","Check the CA certificate",{"_3604":2532,"_31083":2523,"_5":31418,"_21524":58602,"_28264":58603,"_3060":56102},[],"/docs/platform/pki/quickstarts/create-certificate-authority#if-the-result-fails",{"_3604":2533,"_31083":2523,"_5":31418,"_21524":58605,"_28264":58606,"_3060":50764},[],"/docs/platform/pki/quickstarts/create-certificate-authority#next-step",{"_3604":2534,"_31083":2523,"_21524":58608,"_5":14790,"_28264":2523,"_3060":58609},[],"You will create a root authority with a new key kept by a Lamassu engine. The result is an active CA and its public certificate in `ca.pem`, ready to verify issuance in the next path.",{"_3604":2535,"_31083":2523,"_21524":58611,"_5":14790,"_28264":58576,"_3060":58612},[],"Console access and permission to create keys and authorities.",{"_3604":2536,"_31083":2523,"_21524":58614,"_5":14790,"_28264":58576,"_3060":58615},[],"An available cryptographic engine that supports the chosen algorithm.",{"_3604":2537,"_31083":2523,"_21524":58617,"_5":14790,"_28264":58576,"_3060":58618},[],"OpenSSL 3.x to check the downloaded certificate.",{"_3604":2538,"_31083":2523,"_21524":58620,"_5":14790,"_28264":58576,"_3060":58621},[],"Use an evaluation instance or an authority intended for these tests. The example creates a root that issues directly; to design an operational hierarchy, see Hierarchy and rotation.",{"_3604":2539,"_31083":2523,"_21524":58623,"_5":14790,"_28264":58579,"_3060":58624},[],"In **Certification Authorities**, select **Create New CA** and choose to create a CA with a new key pair.",{"_3604":2540,"_31083":2523,"_21524":58626,"_5":14790,"_28264":58579,"_3060":58627},[],"The &#x2A;*Create New CA (Existing Key)** flow is explained in the authorities guide.",{"_3604":2541,"_31083":2523,"_21524":58629,"_5":14790,"_28264":58583,"_3060":58630},[],"Choose the engine that will keep the key and an algorithm its capabilities allow. For this example, you can use **EC P-384** if available.",{"_3604":2542,"_31083":2523,"_21524":58632,"_5":14790,"_28264":58583,"_3060":58633},[],"The CA private key is used through the engine. In this path, you will download only the authority's public certificate.",{"_3604":2543,"_31083":2523,"_21524":58635,"_5":14790,"_28264":58587,"_3060":58636},[],"Select **Root CA** and complete:",{"_3604":2544,"_31083":2523,"_21524":58638,"_5":14790,"_28264":58587,"_3060":58639},[],"**CA Name**: `Acme Evaluation Root CA`.",{"_3604":2545,"_31083":2523,"_21524":58641,"_5":14790,"_28264":58587,"_3060":58642},[],"**Subject**: organization and country details for your evaluation.",{"_3604":2546,"_31083":2523,"_21524":58644,"_5":14790,"_28264":58587,"_3060":58645},[],"**CA Certificate Expiration**: for example, one year from creation.",{"_3604":2547,"_31083":2523,"_21524":58647,"_5":14790,"_28264":58587,"_3060":58648},[],"**Default End-Entity Certificate Issuance Expiration**: for example, 90 days, within the CA's lifetime.",{"_3604":2548,"_31083":2523,"_21524":58650,"_5":14790,"_28264":58587,"_3060":58651},[],"The CA name becomes its `Common Name`. Keep the CA usages needed to sign certificates and CRLs.",{"_3604":2549,"_31083":2523,"_21524":58653,"_5":14790,"_28264":58591,"_3060":58654},[],"Check the engine, algorithm, subject, root type and dates. Confirm creation and note the authority identifier so you can recognize it in the DMS or API.",{"_3604":2550,"_31083":2523,"_21524":58656,"_5":14790,"_28264":58595,"_3060":58657},[],"Open the new CA. It should appear active, show its certificate and allow access to **Issued Certificates**.",{"_3604":2551,"_31083":2523,"_21524":58659,"_5":14790,"_28264":58595,"_3060":58660},[],"Download or copy the authority's PEM certificate and save it as `ca.pem`. Check that the file contains the complete block, including `BEGIN CERTIFICATE` and `END CERTIFICATE`.",{"_3604":2552,"_31083":2523,"_21524":58662,"_5":14790,"_28264":58599,"_3060":58663},[],"Run from the directory where you saved `ca.pem`:",{"_3604":2553,"_31083":2523,"_21524":58665,"_5":14790,"_28264":58599,"_3060":58666},[],"Check that the subject and issuer match the root you created, the dates include the current time, **Basic Constraints** contains `CA:TRUE` and **Key Usage** allows certificate signing. The last command should return `ca.pem: OK`.",{"_3604":2554,"_31083":2523,"_21524":58668,"_5":14790,"_28264":58599,"_3060":58669},[],"You explicitly selected `ca.pem` as the trust anchor for this test. A valid self-signature does not install that trust in other consumers. See the openssl-verify reference for verification options.",{"_3604":2555,"_31083":2523,"_21524":58671,"_5":14790,"_28264":58603,"_3060":58672},[],"If creation fails, check permissions, engine availability and the selected algorithm.",{"_3604":2556,"_31083":2523,"_21524":58674,"_5":14790,"_28264":58603,"_3060":58675},[],"If OpenSSL cannot read the file, copy the complete PEM block again.",{"_3604":2557,"_31083":2523,"_21524":58677,"_5":14790,"_28264":58603,"_3060":58678},[],"If signature or date checks fail, check that you downloaded this CA's certificate and that your computer's clock is correct.",{"_3604":2558,"_31083":2523,"_21524":58680,"_5":14790,"_28264":58603,"_3060":58681},[],"PKI diagnostics covers issuance checks and cryptographic dependencies.",{"_3604":2559,"_31083":2523,"_21524":58683,"_5":14790,"_28264":58606,"_3060":58684},[],"Continue with Issue and verify a certificate, using this authority and `ca.pem`.",{"_3604":2560,"_31083":2560,"_5":15155,"_3060":58686,"_31421":58687,"_21524":58688,"_28264":2560},"Issue and verify a certificate",[50730,52242,56408,55845],[],{"_3604":2561,"_31083":2560,"_21524":58690,"_5":14790,"_28264":2560,"_3060":58691},[],"Issue a client certificate and check content, chain and key correspondence.",{"_3604":2562,"_31083":2560,"_5":31418,"_21524":58693,"_28264":58694,"_3060":50740},[],"/docs/platform/pki/quickstarts/issue-certificate#before-you-begin",{"_3604":2563,"_31083":2560,"_5":31418,"_21524":58696,"_28264":58697,"_3060":58698},[],"/docs/platform/pki/quickstarts/issue-certificate#start-the-issuance","Start the issuance",{"_3604":2564,"_31083":2560,"_5":31418,"_21524":58700,"_28264":58701,"_3060":58702},[],"/docs/platform/pki/quickstarts/issue-certificate#choose-the-method","Choose the method",{"_3604":2565,"_31083":2560,"_5":31418,"_21524":58704,"_28264":58705,"_3060":58706},[],"/docs/platform/pki/quickstarts/issue-certificate#identify-the-certificate","Identify the certificate",{"_3604":2566,"_31083":2560,"_5":31418,"_21524":58708,"_28264":58709,"_3060":58710},[],"/docs/platform/pki/quickstarts/issue-certificate#configure-key-and-uses","Configure key and uses",{"_3604":2567,"_31083":2560,"_5":31418,"_21524":58712,"_28264":58713,"_3060":58714},[],"/docs/platform/pki/quickstarts/issue-certificate#issue-and-download","Issue and download",{"_3604":2568,"_31083":2560,"_5":31418,"_21524":58716,"_28264":58717,"_3060":58718},[],"/docs/platform/pki/quickstarts/issue-certificate#verify-the-result","Verify the result",{"_3604":2569,"_31083":2560,"_5":31418,"_21524":58720,"_28264":58721,"_3060":58722},[],"/docs/platform/pki/quickstarts/issue-certificate#inspect-content-and-dates","Inspect content and dates",{"_3604":2570,"_31083":2560,"_5":31418,"_21524":58724,"_28264":58725,"_3060":58726},[],"/docs/platform/pki/quickstarts/issue-certificate#verify-the-chain","Verify the chain",{"_3604":2571,"_31083":2560,"_5":31418,"_21524":58728,"_28264":58729,"_3060":58730},[],"/docs/platform/pki/quickstarts/issue-certificate#check-that-the-key-matches","Check that the key matches",{"_3604":2572,"_31083":2560,"_5":31418,"_21524":58732,"_28264":58733,"_3060":56102},[],"/docs/platform/pki/quickstarts/issue-certificate#if-the-result-fails",{"_3604":2573,"_31083":2560,"_5":31418,"_21524":58735,"_28264":58736,"_3060":50764},[],"/docs/platform/pki/quickstarts/issue-certificate#next-step",{"_3604":2574,"_31083":2560,"_21524":58738,"_5":14790,"_28264":2560,"_3060":58739},[],"You will issue an end-entity certificate for `device-001` using browser key and CSR generation. The result is `device.crt`, `device.key` and the issuing root's public certificate, `ca.pem`.",{"_3604":2575,"_31083":2560,"_21524":58741,"_5":14790,"_28264":58694,"_3060":58742},[],"An active root CA with an available signing key and permission to issue. If one does not exist yet, follow Create your first CA.",{"_3604":2576,"_31083":2560,"_21524":58744,"_5":14790,"_28264":58694,"_3060":58745},[],"Its public certificate in `ca.pem`; this example uses the root created in the previous path.",{"_3604":2577,"_31083":2560,"_21524":58747,"_5":14790,"_28264":58694,"_3060":58748},[],"OpenSSL 3.x and a working directory with restricted access.",{"_3604":2578,"_31083":2560,"_21524":58750,"_5":14790,"_28264":58694,"_3060":58751},[],"A client identifier: here we use `device-001`.",{"_3604":2579,"_31083":2560,"_21524":58753,"_5":14790,"_28264":58694,"_3060":58754},[],"In this flow, the client's key is generated in the browser and must be downloaded when issuance finishes. If you lose it, you must generate a key and issue another certificate. The certificate inventory lets you download the public certificate, but cannot recover this key.",{"_3604":2580,"_31083":2560,"_21524":58756,"_5":14790,"_28264":58697,"_3060":58757},[],"Open the CA from the previous path, go to **Issued Certificates** and select **Issue New**.",{"_3604":2581,"_31083":2560,"_21524":58759,"_5":14790,"_28264":58701,"_3060":58760},[],"Select **Generate Key & CSR in Browser** to follow this example.",{"_3604":2582,"_31083":2560,"_21524":58762,"_5":14790,"_28264":58701,"_3060":58763},[],"If the key must be generated and kept on the destination system, use **Upload Existing CSR**, described in the authorities guide.",{"_3604":2583,"_31083":2560,"_21524":58765,"_5":14790,"_28264":58705,"_3060":58766},[],"Enter `device-001` as the `Common Name`. Add subject details required by your policy and SANs if the consumer uses them to identify the client.",{"_3604":2584,"_31083":2560,"_21524":58768,"_5":14790,"_28264":58705,"_3060":58769},[],"If you continue with manual registration, the `Device ID` will be exactly `device-001`.",{"_3604":2585,"_31083":2560,"_21524":58771,"_5":14790,"_28264":58709,"_3060":58772},[],"Choose an algorithm and size allowed by the profile; for example, ECDSA P-256 if permitted. For this client certificate, select **Digital Signature** and **Client Authentication**, and issue it as an end-entity certificate.",{"_3604":2586,"_31083":2560,"_21524":58774,"_5":14790,"_28264":58709,"_3060":58775},[],"Request, for example, 30 days of validity, always within the CA's lifetime. Review the issuance profile if the resulting content differs from the request.",{"_3604":2587,"_31083":2560,"_21524":58777,"_5":14790,"_28264":58713,"_3060":58778},[],"Confirm issuance. Save the PEM certificate as `device.crt` and the private key as `device.key` in your prepared directory.",{"_3604":2588,"_31083":2560,"_21524":58780,"_5":14790,"_28264":58717,"_3060":58781},[],"Check in **Issued Certificates** that the certificate appears active. Note its serial number and verify the downloaded material using the checks below.",{"_3604":2589,"_31083":2560,"_21524":58783,"_5":14790,"_28264":58721,"_3060":58784},[],"Check `CN=device-001`, the expected issuer, current validity, **Digital Signature** and the extended usage **TLS Web Client Authentication**. It must be an end-entity certificate: it must not declare `CA:TRUE` or enable **Certificate Sign**. If **Basic Constraints** is present, it must indicate `CA:FALSE`. If you requested SANs, check that the expected identifiers appear in the certificate.",{"_3604":2590,"_31083":2560,"_21524":58786,"_5":14790,"_28264":58725,"_3060":58787},[],"The expected result is `device.crt: OK`. This check uses your explicit root and evaluates the chain, dates and compatibility with the TLS client purpose. Also check for the expected usages and names through the inspection above.",{"_3604":2591,"_31083":2560,"_21524":58789,"_5":14790,"_28264":58725,"_3060":58790},[],"If you use an intermediate CA, the trusted root must be in `ca.pem` and you must supply the intermediates with `-untrusted intermediates.pem`. This variant is covered in the trust model.",{"_3604":2592,"_31083":2560,"_21524":58792,"_5":14790,"_28264":58725,"_3060":58793},[],"The command does not query OCSP or CRL. For revocation checks, continue with Certificate validation. See the openssl-verify reference for its options.",{"_3604":2593,"_31083":2560,"_21524":58795,"_5":14790,"_28264":58729,"_3060":58796},[],"In Bash, compare the two public-key digests:",{"_3604":2594,"_31083":2560,"_21524":58798,"_5":14790,"_28264":58729,"_3060":58799},[],"Both commands must finish successfully and show the same SHA-256 digest. If they differ, the private key does not match the selected certificate. Find the correct pair before installing it.",{"_3604":2595,"_31083":2560,"_21524":58801,"_5":14790,"_28264":58729,"_3060":58802},[],"The options used are documented in openssl-x509 and openssl-pkey.",{"_3604":2596,"_31083":2560,"_21524":58804,"_5":14790,"_28264":58733,"_3060":56186},[],{"_3604":2597,"_31083":2560,"_21524":58806,"_5":14790,"_28264":58733,"_3060":58807},[],"What to review",{"_3604":2598,"_31083":2560,"_21524":58809,"_5":14790,"_28264":58733,"_3060":58810},[],"The CA rejects issuance",{"_3604":2599,"_31083":2560,"_21524":58812,"_5":14790,"_28264":58733,"_3060":58813},[],"Permissions, CA state and key, algorithm and profile.",{"_3604":2600,"_31083":2560,"_21524":58815,"_5":14790,"_28264":58733,"_3060":58816},[],"Different subject or usages",{"_3604":2601,"_31083":2560,"_21524":58818,"_5":14790,"_28264":58733,"_3060":58819},[],"Applied profile and requested values.",{"_3604":2602,"_31083":2560,"_21524":58821,"_5":14790,"_28264":58733,"_3060":58822},[],"Issuer cannot be found",{"_3604":2603,"_31083":2560,"_21524":58824,"_5":14790,"_28264":58733,"_3060":58825},[],"Downloaded CA and required intermediate chain.",{"_3604":2604,"_31083":2560,"_21524":58827,"_5":14790,"_28264":58733,"_3060":58828},[],"Validity fails",{"_3604":2605,"_31083":2560,"_21524":58830,"_5":14790,"_28264":58733,"_3060":58831},[],"Certificate and CA dates, and the computer's clock.",{"_3604":2606,"_31083":2560,"_21524":58833,"_5":14790,"_28264":58733,"_3060":58834},[],"Public-key digests differ",{"_3604":2607,"_31083":2560,"_21524":58836,"_5":14790,"_28264":58733,"_3060":58837},[],"Certificate and key files from the same issuance.",{"_3604":2608,"_31083":2560,"_21524":58839,"_5":14790,"_28264":58733,"_3060":58840},[],"See PKI diagnostics to narrow an issuance failure.",{"_3604":2609,"_31083":2560,"_21524":58842,"_5":14790,"_28264":58736,"_3060":58843},[],"You have completed the PKI path when the certificate verifies and the key matches. Choose how to use it:",{"_3604":2610,"_31083":2560,"_21524":58845,"_5":14790,"_28264":58736,"_3060":58846},[],"Manage certificates for inspection, status and revocation.",{"_3604":2611,"_31083":2560,"_21524":58848,"_5":14790,"_28264":58736,"_3060":58849},[],"Register a device manually to associate this identity with Lamassu's inventory.",{"_3604":2612,"_31083":2560,"_21524":58851,"_5":14790,"_28264":58736,"_3060":58852},[],"Prepare EST for the device to request its next identities.",{"_3604":2613,"_31083":2560,"_21524":58854,"_5":14790,"_28264":58736,"_3060":58855},[],"Acceptance by a consumer requires configuring its trust, revocation checks and permissions granted to the identity.",{"_3604":2614,"_31083":2614,"_5":15155,"_3060":58857,"_31421":58858,"_21524":58859,"_28264":2614},"PKI getting started",[50730,52242,56408,55845],[],{"_3604":2615,"_31083":2614,"_21524":58861,"_5":14790,"_28264":2614,"_3060":58862},[],"Create a CA, issue a client certificate and check its chain and key.",{"_3604":2616,"_31083":2614,"_5":31418,"_21524":58864,"_28264":58865,"_3060":50740},[],"/docs/platform/pki/quickstarts/overview#before-you-begin",{"_3604":2617,"_31083":2614,"_5":31418,"_21524":58867,"_28264":58868,"_3060":58869},[],"/docs/platform/pki/quickstarts/overview#recommended-path","Recommended path",{"_3604":2618,"_31083":2614,"_5":31418,"_21524":58871,"_28264":58872,"_3060":56037},[],"/docs/platform/pki/quickstarts/overview#expected-result",{"_3604":2619,"_31083":2614,"_5":31418,"_21524":58874,"_28264":58875,"_3060":58876},[],"/docs/platform/pki/quickstarts/overview#continue-according-to-your-goal","Continue according to your goal",{"_3604":2620,"_31083":2614,"_21524":58878,"_5":14790,"_28264":2614,"_3060":58879},[],"This path is intended for those starting to administer PKI or needing a first X.509 client identity. It ends with three files: a root CA certificate, an end-entity certificate and the client's private key.",{"_3604":2621,"_31083":2614,"_21524":58881,"_5":14790,"_28264":58865,"_3060":58882},[],"A Lamassu instance accessible from your browser. To prepare one, see Deployment.",{"_3604":2622,"_31083":2614,"_21524":58884,"_5":14790,"_28264":58865,"_3060":58885},[],"Permission to manage keys, authorities and issuance. See Access control if an operation is blocked.",{"_3604":2623,"_31083":2614,"_21524":58887,"_5":14790,"_28264":58865,"_3060":58888},[],"An available cryptographic engine for the CA key; check the keys and engines inventory.",{"_3604":2624,"_31083":2614,"_21524":58890,"_5":14790,"_28264":58865,"_3060":58891},[],"OpenSSL 3.x on the computer where you will verify the files.",{"_3604":2625,"_31083":2614,"_21524":58893,"_5":14790,"_28264":58865,"_3060":58894},[],"A working directory with restricted access for the downloaded key.",{"_3604":2626,"_31083":2614,"_21524":58896,"_5":14790,"_28264":58868,"_3060":58897},[],"<Card title=\"1. Create your first CA\" description=\"Create an evaluation root and save its public certificate as ca.pem.\" href=\"/docs/platform/pki/quickstarts/create-certificate-authority\" />",{"_3604":2627,"_31083":2614,"_21524":58899,"_5":14790,"_28264":58868,"_3060":58900},[],"<Card title=\"2. Issue and verify a certificate\" description=\"Issue for device-001 and check content, chain and key correspondence.\" href=\"/docs/platform/pki/quickstarts/issue-certificate\" />",{"_3604":2628,"_31083":2614,"_21524":58902,"_5":14790,"_28264":58868,"_3060":58903},[],"We use `Acme Evaluation Root CA` and `device-001` as example names. If you replace them, keep the same client identifier in the steps you want to connect.",{"_3604":2629,"_31083":2614,"_21524":58905,"_5":14790,"_28264":58868,"_3060":58906},[],"The root in this path signs the end-entity certificate directly to simplify evaluation. Before designing an operational PKI, review the trust model and CA hierarchy.",{"_3604":2630,"_31083":2614,"_21524":58908,"_5":14790,"_28264":58872,"_3060":58909},[],"File or resource",{"_3604":2631,"_31083":2614,"_21524":58911,"_5":14790,"_28264":58872,"_3060":56034},[],{"_3604":2632,"_31083":2614,"_21524":58913,"_5":14790,"_28264":58872,"_3060":58914},[],"Active root CA and `ca.pem`",{"_3604":2633,"_31083":2614,"_21524":58916,"_5":14790,"_28264":58872,"_3060":58917},[],"It is a CA certificate, is currently valid and its self-signature verifies.",{"_3604":2634,"_31083":2614,"_21524":58919,"_5":14790,"_28264":58872,"_3060":58920},[],"End-entity certificate and `device.crt`",{"_3604":2635,"_31083":2614,"_21524":58922,"_5":14790,"_28264":58872,"_3060":58923},[],"It identifies `device-001`, supports client authentication and verifies against `ca.pem`.",{"_3604":2636,"_31083":2614,"_21524":58925,"_5":14790,"_28264":58872,"_3060":58926},[],"Private key `device.key`",{"_3604":2637,"_31083":2614,"_21524":58928,"_5":14790,"_28264":58872,"_3060":58929},[],"Its public key matches the one included in `device.crt`.",{"_3604":2638,"_31083":2614,"_21524":58931,"_5":14790,"_28264":58872,"_3060":58932},[],"These checks validate the issued material. Acceptance by a service also requires its trust, authorization and revocation configuration.",{"_3604":2639,"_31083":2614,"_21524":58934,"_5":14790,"_28264":58875,"_3060":58935},[],"To operate certificates, continue with Certificates and Validation.",{"_3604":2640,"_31083":2614,"_21524":58937,"_5":14790,"_28264":58875,"_3060":58938},[],"To manage a device identity in Lamassu, follow Manual registration. That path includes DMS preparation.",{"_3604":2641,"_31083":2614,"_21524":58940,"_5":14790,"_28264":58875,"_3060":58941},[],"For the device to request its certificate, prepare the DMS and EST client.",{"_3604":2642,"_31083":2642,"_5":15155,"_3060":58943,"_31421":58944,"_21524":58945,"_28264":2642},"PKI troubleshooting",[50730,52242,56408,54983],[],{"_3604":2643,"_31083":2642,"_21524":58947,"_5":14790,"_28264":2642,"_3060":58948},[],"Diagnose certificate issuance, OCSP and CRL.",{"_3604":2644,"_31083":2642,"_5":31418,"_21524":58950,"_28264":58951,"_3060":58952},[],"/docs/platform/pki/troubleshooting#issuance-fails","Issuance fails",{"_3604":2645,"_31083":2642,"_5":31418,"_21524":58954,"_28264":58955,"_3060":58956},[],"/docs/platform/pki/troubleshooting#ocsp-or-crl-do-not-reflect-a-change","OCSP or CRL do not reflect a change",{"_3604":2646,"_31083":2642,"_5":31418,"_21524":58958,"_28264":58959,"_3060":58960},[],"/docs/platform/pki/troubleshooting#the-chain-validates-but-the-connection-fails","The chain validates but the connection fails",{"_3604":2647,"_31083":2642,"_21524":58962,"_5":14790,"_28264":2642,"_3060":58963},[],"This guide helps a PKI operator locate issuance and status publication failures. Keep the Lamassu version, operation, CA, issuer, serial, time and returned error. Do not include private keys or tokens in diagnostics.",{"_3604":2648,"_31083":2642,"_21524":58965,"_5":14790,"_28264":2642,"_3060":58966},[],"For Gateway, sign-in, pods, dependencies and messaging, see Deployment troubleshooting. For device enrollment, see EST diagnostics.",{"_3604":2649,"_31083":2642,"_21524":58968,"_5":14790,"_28264":58951,"_3060":56034},[],{"_3604":2650,"_31083":2642,"_21524":58970,"_5":14790,"_28264":58951,"_3060":58971},[],"What to inspect",{"_3604":2651,"_31083":2642,"_21524":58973,"_5":14790,"_28264":58951,"_3060":50764},[],{"_3604":2652,"_31083":2642,"_21524":58975,"_5":14790,"_28264":58951,"_3060":55250},[],{"_3604":2653,"_31083":2642,"_21524":58977,"_5":14790,"_28264":58951,"_3060":58978},[],"Exists, is active and has usable dates.",{"_3604":2654,"_31083":2642,"_21524":58980,"_5":14790,"_28264":58951,"_3060":58981},[],"Authorities.",{"_3604":2655,"_31083":2642,"_21524":58983,"_5":14790,"_28264":58951,"_3060":58984},[],"Key",{"_3604":2656,"_31083":2642,"_21524":58986,"_5":14790,"_28264":58951,"_3060":58987},[],"The record has a usable private key and the engine can sign.",{"_3604":2657,"_31083":2642,"_21524":58989,"_5":14790,"_28264":58951,"_3060":58990},[],"Try **Sign / Verify** in KMS; check provider permissions and availability.",{"_3604":2658,"_31083":2642,"_21524":58992,"_5":14790,"_28264":58951,"_3060":58993},[],"CSR",{"_3604":2659,"_31083":2642,"_21524":58995,"_5":14790,"_28264":58951,"_3060":58996},[],"Correct PEM and verifiable signature.",{"_3604":2660,"_31083":2642,"_21524":58998,"_5":14790,"_28264":58951,"_3060":58999},[],"`openssl req -in request.csr -noout -verify -text`.",{"_3604":2661,"_31083":2642,"_21524":59001,"_5":14790,"_28264":58951,"_3060":59002},[],"Profile",{"_3604":2662,"_31083":2642,"_21524":59004,"_5":14790,"_28264":58951,"_3060":59005},[],"Selected source, existing ID, allowed algorithm and size.",{"_3604":2663,"_31083":2642,"_21524":59007,"_5":14790,"_28264":58951,"_3060":59008},[],"Check Profiles precedence; CA and DMS resolve differently.",{"_3604":2664,"_31083":2642,"_21524":59010,"_5":14790,"_28264":58951,"_3060":56186},[],{"_3604":2665,"_31083":2642,"_21524":59012,"_5":14790,"_28264":58951,"_3060":59013},[],"Appropriate subject, SAN, usages and dates.",{"_3604":2666,"_31083":2642,"_21524":59015,"_5":14790,"_28264":58951,"_3060":59016},[],"Compare CSR, profile and certificate; successful issuance does not establish consumer acceptance.",{"_3604":2667,"_31083":2642,"_21524":59018,"_5":14790,"_28264":58951,"_3060":59019},[],"For unexpected certificate fields, review `Honor Subject`, `Honor Key Usage`, `Honor Extended Key Usages` and `Honor Extensions`. The latter preserves SAN only, without validating entitlement to those names. Validity is not automatically clamped to CA expiration.",{"_3604":2668,"_31083":2642,"_21524":59021,"_5":14790,"_28264":58951,"_3060":59022},[],"If issuance fails with `400` and `CA Status inconsistent`, the issuing CA is not `ACTIVE` or is outside the validity period of its certificate. The stored status can lag behind the dates until the expiration monitor runs, so check the dates too. Reissue the CA while it is still valid, or issue from another CA.",{"_3604":2669,"_31083":2642,"_21524":59024,"_5":14790,"_28264":58951,"_3060":59025},[],"For CA reissuance failures, check revocation and date: reissuance is not supported for a revoked or already expired CA. For a subordinate CA, also check the status and dates of its parent. To change its key, use Hierarchy and rotation.",{"_3604":2670,"_31083":2642,"_21524":59027,"_5":14790,"_28264":58955,"_3060":59028},[],"Check each boundary independently:",{"_3604":2671,"_31083":2642,"_21524":59030,"_5":14790,"_28264":58955,"_3060":59031},[],"**Record:** read the correct certificate again by serial and issuer. Confirm status, reason and time; expired or permanently revoked records reject further transitions.",{"_3604":2672,"_31083":2642,"_21524":59033,"_5":14790,"_28264":58955,"_3060":59034},[],"**Endpoint:** inspect AIA and CDP. Query those URLs from the consumer’s network; an old route or incorrect issuer can explain a discrepancy.",{"_3604":2673,"_31083":2642,"_21524":59036,"_5":14790,"_28264":58955,"_3060":59037},[],"**OCSP:** save a fresh response, verify signature and timestamps, and observe status. An HTTP error for an absent serial does not mean `Good` or guarantee a signed `Unknown`.",{"_3604":2674,"_31083":2642,"_21524":59039,"_5":14790,"_28264":58955,"_3060":59040},[],"**CRL:** compare `latest_crl`, number and timestamps with the downloaded list. Check the serial in its contents. If unchanged, review `regenerate_on_revoke`, event delivery, jobs, signing and storage with the deployment operator.",{"_3604":2675,"_31083":2642,"_21524":59042,"_5":14790,"_28264":58955,"_3060":59043},[],"**Client:** check cache, policy for expired or unavailable evidence, critical IDP extension and rejection of a new connection.",{"_3604":2676,"_31083":2642,"_21524":59045,"_5":14790,"_28264":58955,"_3060":59046},[],"Reactivation from `CertificateHold` needs a new CRL for the client to stop seeing the hold. A hold cascaded from a CA is lifted by releasing that CA; a cascade from a CA revoked for good is not. Inspect every status and individual operation failure.",{"_3604":2677,"_31083":2642,"_21524":59048,"_5":14790,"_28264":58959,"_3060":59049},[],"Check expected identity, SAN, KU/EKU, matching key, presented intermediates and consumer permissions. Distinguish server TLS trust, client authentication and action authorization. Follow Validation for positive and rejection tests.",{"_3604":2678,"_31083":2642,"_21524":59051,"_5":14790,"_28264":58959,"_3060":59052},[],"When escalating a problem, provide identifiers, error and relevant public evidence, including query timestamps and version. This distinguishes issuance, publication and consumer application failures.",{"_3604":2679,"_31083":2679,"_5":15155,"_3060":59054,"_31421":59055,"_21524":59056,"_28264":2679},"Security",[50730],[],{"_3604":2680,"_31083":2679,"_21524":59058,"_5":14790,"_28264":2679,"_3060":59059},[],"How to report a security vulnerability in Lamassu privately, what to include in a report and which releases receive security fixes.",{"_3604":2681,"_31083":2679,"_5":31418,"_21524":59061,"_28264":59062,"_3060":59063},[],"/docs/security#report-a-vulnerability","Report a vulnerability",{"_3604":2682,"_31083":2679,"_5":31418,"_21524":59065,"_28264":59066,"_3060":59067},[],"/docs/security#what-to-include-in-a-report","What to include in a report",{"_3604":2683,"_31083":2679,"_5":31418,"_21524":59069,"_28264":59070,"_3060":59071},[],"/docs/security#supported-versions","Supported versions",{"_3604":2684,"_31083":2679,"_5":31418,"_21524":59073,"_28264":59074,"_3060":59075},[],"/docs/security#responsible-disclosure","Responsible disclosure",{"_3604":2685,"_31083":2679,"_21524":59077,"_5":14790,"_28264":2679,"_3060":59078},[],"Found a security vulnerability in lamassuiot, lamassu-dashboard, or lamassu-helm? This page explains how to report it privately, what to include in your report and which releases receive security fixes.",{"_3604":2686,"_31083":2679,"_21524":59080,"_5":14790,"_28264":59062,"_3060":59081},[],"Do not report security vulnerabilities through public GitHub issues, discussions, or pull requests. Public reports disclose the problem before maintainers can fix it.",{"_3604":2687,"_31083":2679,"_21524":59083,"_5":14790,"_28264":59062,"_3060":59084},[],"Instead, report privately using GitHub Security Advisories for the affected repository:",{"_3604":2688,"_31083":2679,"_21524":59086,"_5":14790,"_28264":59062,"_3060":15429},[],{"_3604":2689,"_31083":2679,"_21524":59088,"_5":14790,"_28264":59062,"_3060":15358},[],{"_3604":2690,"_31083":2679,"_21524":59090,"_5":14790,"_28264":59062,"_3060":15416},[],{"_3604":2691,"_31083":2679,"_21524":59092,"_5":14790,"_28264":59062,"_3060":59093},[],"This lets maintainers assess and address the issue before it is publicly disclosed.",{"_3604":2692,"_31083":2679,"_21524":59095,"_5":14790,"_28264":59062,"_3060":59096},[],"If private vulnerability reporting is not enabled for that repository, report the vulnerability privately to lamassuiot\\@lksnext.com before disclosing any details publicly.",{"_3604":2693,"_31083":2679,"_21524":59098,"_5":14790,"_28264":59066,"_3060":59099},[],"Describe the vulnerability, its potential impact, and steps to reproduce it using non-sensitive, redacted examples.",{"_3604":2694,"_31083":2679,"_21524":59101,"_5":14790,"_28264":59066,"_3060":59102},[],"Do not include in the report:",{"_3604":2695,"_31083":2679,"_21524":59104,"_5":14790,"_28264":59066,"_3060":59105},[],"Credentials, tokens, or private keys",{"_3604":2696,"_31083":2679,"_21524":59107,"_5":14790,"_28264":59066,"_3060":59108},[],"Customer data or customer-identifiable information",{"_3604":2697,"_31083":2679,"_21524":59110,"_5":14790,"_28264":59066,"_3060":59111},[],"Confidential architecture or internal infrastructure details",{"_3604":2698,"_31083":2679,"_21524":59113,"_5":14790,"_28264":59070,"_3060":59114},[],"Only the latest stable release receives security support. Support for a stable release ends when the next stable release is published. Older releases and pre-releases are not supported.",{"_3604":2699,"_31083":2679,"_21524":59116,"_5":14790,"_28264":59070,"_3060":59117},[],"For upgrade guidance, see Upgrades.",{"_3604":2700,"_31083":2679,"_21524":59119,"_5":14790,"_28264":59074,"_3060":59120},[],"Give maintainers reasonable time to investigate and address a reported vulnerability before any public disclosure.",{"_3604":2701,"_31083":2679,"_21524":59122,"_5":14790,"_28264":59074,"_3060":59123},[],"Avoid privacy violations, data destruction, and service disruption while researching a vulnerability.",{"_3604":2702,"_31083":2679,"_21524":59125,"_5":14790,"_28264":59074,"_3060":59126},[],"Only interact with accounts or data you own, or for which you have explicit permission.",{"_3604":2703,"_31083":2679,"_21524":59128,"_5":14790,"_28264":59074,"_3060":59129},[],"Maintainers acknowledge reports in a timely manner and keep you informed of remediation progress.",{"_3604":2704,"_31083":2679,"_21524":59131,"_5":14790,"_28264":59074,"_3060":59132},[],"This policy covers the source code, configuration, and CI/CD workflows of the lamassuiot, lamassu-dashboard, and lamassu-helm repositories.",{"_3604":2705,"_31083":2705,"_5":15155,"_3060":59134,"_31421":59135,"_21524":59137,"_28264":2705},"3.8.0 to 4.0.0",[50730,59136],"Upgrades",[],{"_3604":2706,"_31083":2705,"_21524":59139,"_5":14790,"_28264":2705,"_3060":59140},[],"What changes in the 4.0.0 architecture, which changes break a 3.8.0 deployment, how to upgrade a Helm release step by step and how to validate the result.",{"_3604":2707,"_31083":2705,"_5":31418,"_21524":59142,"_28264":59143,"_3060":59144},[],"/docs/upgrades/3-8-0-to-4-0-0#architecture-changes","Architecture changes",{"_3604":2708,"_31083":2705,"_5":31418,"_21524":59146,"_28264":59147,"_3060":59148},[],"/docs/upgrades/3-8-0-to-4-0-0#one-postgresql-database-with-schemas","One PostgreSQL database with schemas",{"_3604":2709,"_31083":2705,"_5":31418,"_21524":59150,"_28264":59151,"_3060":59152},[],"/docs/upgrades/3-8-0-to-4-0-0#authorization-moves-into-the-authz-service","Authorization moves into the authz service",{"_3604":2710,"_31083":2705,"_5":31418,"_21524":59154,"_28264":59155,"_3060":59156},[],"/docs/upgrades/3-8-0-to-4-0-0#device-events-get-their-own-store","Device events get their own store",{"_3604":2711,"_31083":2705,"_5":31418,"_21524":59158,"_28264":59159,"_3060":59160},[],"/docs/upgrades/3-8-0-to-4-0-0#a-hardened-helm-chart","A hardened Helm chart",{"_3604":2712,"_31083":2705,"_5":31418,"_21524":59162,"_28264":59163,"_3060":59164},[],"/docs/upgrades/3-8-0-to-4-0-0#what-the-upgrade-migrates-automatically","What the upgrade migrates automatically",{"_3604":2713,"_31083":2705,"_5":31418,"_21524":59166,"_28264":59167,"_3060":59168},[],"/docs/upgrades/3-8-0-to-4-0-0#breaking-changes","Breaking changes",{"_3604":2714,"_31083":2705,"_5":31418,"_21524":59170,"_28264":59171,"_3060":59172},[],"/docs/upgrades/3-8-0-to-4-0-0#helm-chart-and-values","Helm chart and values",{"_3604":2715,"_31083":2705,"_5":31418,"_21524":59174,"_28264":59175,"_3060":59176},[],"/docs/upgrades/3-8-0-to-4-0-0#release-scoped-resource-names","Release-scoped resource names",{"_3604":2716,"_31083":2705,"_5":31418,"_21524":59178,"_28264":59179,"_3060":59180},[],"/docs/upgrades/3-8-0-to-4-0-0#strict-values-validation","Strict values validation",{"_3604":2717,"_31083":2705,"_5":31418,"_21524":59182,"_28264":59183,"_3060":51368},[],"/docs/upgrades/3-8-0-to-4-0-0#credentials-in-kubernetes-secrets",{"_3604":2718,"_31083":2705,"_5":31418,"_21524":59185,"_28264":59186,"_3060":59187},[],"/docs/upgrades/3-8-0-to-4-0-0#required-authorization-configuration","Required authorization configuration",{"_3604":2719,"_31083":2705,"_5":31418,"_21524":59189,"_28264":59190,"_3060":59191},[],"/docs/upgrades/3-8-0-to-4-0-0#gateway-token-validation-removed","Gateway token validation removed",{"_3604":2720,"_31083":2705,"_5":31418,"_21524":59193,"_28264":59194,"_3060":59195},[],"/docs/upgrades/3-8-0-to-4-0-0#non-root-containers","Non-root containers",{"_3604":2721,"_31083":2705,"_5":31418,"_21524":59197,"_28264":59198,"_3060":59199},[],"/docs/upgrades/3-8-0-to-4-0-0#amqp-over-tls","AMQP over TLS",{"_3604":2722,"_31083":2705,"_5":31418,"_21524":59201,"_28264":59202,"_3060":59203},[],"/docs/upgrades/3-8-0-to-4-0-0#renamed-and-reshaped-values","Renamed and reshaped values",{"_3604":2723,"_31083":2705,"_5":31418,"_21524":59205,"_28264":59206,"_3060":59207},[],"/docs/upgrades/3-8-0-to-4-0-0#data-and-storage","Data and storage",{"_3604":2724,"_31083":2705,"_5":31418,"_21524":59209,"_28264":59210,"_3060":59211},[],"/docs/upgrades/3-8-0-to-4-0-0#postgresql-consolidation","PostgreSQL consolidation",{"_3604":2725,"_31083":2705,"_5":31418,"_21524":59213,"_28264":59214,"_3060":59215},[],"/docs/upgrades/3-8-0-to-4-0-0#sqlite-storage-removed","SQLite storage removed",{"_3604":2726,"_31083":2705,"_5":31418,"_21524":59217,"_28264":59218,"_3060":59219},[],"/docs/upgrades/3-8-0-to-4-0-0#legacy-ca-keys-in-the-kms","Legacy CA keys in the KMS",{"_3604":2727,"_31083":2705,"_5":31418,"_21524":59221,"_28264":59222,"_3060":59223},[],"/docs/upgrades/3-8-0-to-4-0-0#references-between-certificates-keys-and-crl-settings","References between certificates, keys and CRL settings",{"_3604":2728,"_31083":2705,"_5":31418,"_21524":59225,"_28264":59226,"_3060":59227},[],"/docs/upgrades/3-8-0-to-4-0-0#apis-and-stored-configuration","APIs and stored configuration",{"_3604":2729,"_31083":2705,"_5":31418,"_21524":59229,"_28264":59230,"_3060":59231},[],"/docs/upgrades/3-8-0-to-4-0-0#dms-webhooks","DMS webhooks",{"_3604":2730,"_31083":2705,"_5":31418,"_21524":59233,"_28264":59234,"_3060":59235},[],"/docs/upgrades/3-8-0-to-4-0-0#re-enrollment-trust-set","Re-enrollment trust set",{"_3604":2731,"_31083":2705,"_5":31418,"_21524":59237,"_28264":59238,"_3060":59239},[],"/docs/upgrades/3-8-0-to-4-0-0#independent-re-enrollment-authentication","Independent re-enrollment authentication",{"_3604":2732,"_31083":2705,"_5":31418,"_21524":59241,"_28264":59242,"_3060":59243},[],"/docs/upgrades/3-8-0-to-4-0-0#dms-update-api","DMS update API",{"_3604":2733,"_31083":2705,"_5":31418,"_21524":59245,"_28264":59246,"_3060":59247},[],"/docs/upgrades/3-8-0-to-4-0-0#certificate-type-values","Certificate type values",{"_3604":2734,"_31083":2705,"_5":31418,"_21524":59249,"_28264":59250,"_3060":59251},[],"/docs/upgrades/3-8-0-to-4-0-0#device-events","Device events",{"_3604":2735,"_31083":2705,"_5":31418,"_21524":59253,"_28264":59254,"_3060":59255},[],"/docs/upgrades/3-8-0-to-4-0-0#crl-signer-field","CRL signer field",{"_3604":2736,"_31083":2705,"_5":31418,"_21524":59257,"_28264":59258,"_3060":59259},[],"/docs/upgrades/3-8-0-to-4-0-0#crl-settings-keyed-by-ca-id","CRL settings keyed by CA ID",{"_3604":2737,"_31083":2705,"_5":31418,"_21524":59261,"_28264":59262,"_3060":59263},[],"/docs/upgrades/3-8-0-to-4-0-0#renamed-va-events","Renamed VA events",{"_3604":2738,"_31083":2705,"_5":31418,"_21524":59265,"_28264":59266,"_3060":59267},[],"/docs/upgrades/3-8-0-to-4-0-0#ca-ids-are-always-assigned-by-the-backend","CA IDs are always assigned by the backend",{"_3604":2739,"_31083":2705,"_5":31418,"_21524":59269,"_28264":59270,"_3060":59271},[],"/docs/upgrades/3-8-0-to-4-0-0#ca-signature-endpoints-removed","CA signature endpoints removed",{"_3604":2740,"_31083":2705,"_5":31418,"_21524":59273,"_28264":59274,"_3060":59275},[],"/docs/upgrades/3-8-0-to-4-0-0#va-crl-signer","VA CRL signer",{"_3604":2741,"_31083":2705,"_5":31418,"_21524":59277,"_28264":59278,"_3060":59279},[],"/docs/upgrades/3-8-0-to-4-0-0#helm-migration-guide","Helm migration guide",{"_3604":2742,"_31083":2705,"_5":31418,"_21524":59281,"_28264":59282,"_3060":59283},[],"/docs/upgrades/3-8-0-to-4-0-0#step-1-prepare","Step 1: Prepare",{"_3604":2743,"_31083":2705,"_5":31418,"_21524":59285,"_28264":59286,"_3060":59287},[],"/docs/upgrades/3-8-0-to-4-0-0#pre-upgrade-check","Pre-upgrade check",{"_3604":2744,"_31083":2705,"_5":31418,"_21524":59289,"_28264":59290,"_3060":59291},[],"/docs/upgrades/3-8-0-to-4-0-0#step-2-update-the-values-file","Step 2: Update the values file",{"_3604":2745,"_31083":2705,"_5":31418,"_21524":59293,"_28264":59294,"_3060":59295},[],"/docs/upgrades/3-8-0-to-4-0-0#step-3-run-the-upgrade","Step 3: Run the upgrade",{"_3604":2746,"_31083":2705,"_5":31418,"_21524":59297,"_28264":59298,"_3060":59299},[],"/docs/upgrades/3-8-0-to-4-0-0#step-4-migrate-the-kms-and-va-data","Step 4: Migrate the KMS and VA data",{"_3604":2747,"_31083":2705,"_5":31418,"_21524":59301,"_28264":59302,"_3060":59303},[],"/docs/upgrades/3-8-0-to-4-0-0#step-5-remove-the-one-off-migration-values","Step 5: Remove the one-off migration values",{"_3604":2748,"_31083":2705,"_5":31418,"_21524":59305,"_28264":59306,"_3060":59307},[],"/docs/upgrades/3-8-0-to-4-0-0#deployments-without-helm","Deployments without Helm",{"_3604":2749,"_31083":2705,"_5":31418,"_21524":59309,"_28264":59310,"_3060":54983},[],"/docs/upgrades/3-8-0-to-4-0-0#troubleshooting",{"_3604":2750,"_31083":2705,"_5":31418,"_21524":59312,"_28264":59313,"_3060":59314},[],"/docs/upgrades/3-8-0-to-4-0-0#validation-checklist","Validation checklist",{"_3604":2751,"_31083":2705,"_5":31418,"_21524":59316,"_28264":59317,"_3060":59318},[],"/docs/upgrades/3-8-0-to-4-0-0#delete-the-old-volumes","Delete the old volumes",{"_3604":2752,"_31083":2705,"_21524":59320,"_5":14790,"_28264":2705,"_3060":59321},[],"Lamassu 4.0.0 is a major release. Storage consolidates into a single PostgreSQL database, a new `authz` service authorizes every request, the Helm chart is hardened, and several APIs and stored configurations change shape. Most data converts automatically during the upgrade, but some changes need operator action before, during or after it.",{"_3604":2753,"_31083":2705,"_21524":59323,"_5":14790,"_28264":2705,"_3060":59324},[],"This page is organized in four parts. Read them in order before you upgrade production:",{"_3604":2754,"_31083":2705,"_21524":59326,"_5":14790,"_28264":2705,"_3060":59327},[],"Architecture changes: what is different in 4.0.0 and what the upgrade migrates on its own.",{"_3604":2755,"_31083":2705,"_21524":59329,"_5":14790,"_28264":2705,"_3060":59330},[],"Breaking changes: every change that can break a 3.8.0 deployment, who it affects and what to do.",{"_3604":2756,"_31083":2705,"_21524":59332,"_5":14790,"_28264":2705,"_3060":59333},[],"Helm migration guide: the step-by-step procedure for a Helm-managed release.",{"_3604":2757,"_31083":2705,"_21524":59335,"_5":14790,"_28264":2705,"_3060":59336},[],"Validation checklist: how to confirm the upgrade worked before you remove the old data.",{"_3604":2758,"_31083":2705,"_21524":59338,"_5":14790,"_28264":2705,"_3060":59339},[],"The 4.0.0 release is upcoming and the backend migration steps on this page are provisional. Verify each procedure against the final release artifacts before upgrading production.",{"_3604":2759,"_31083":2705,"_21524":59341,"_5":14790,"_28264":59147,"_3060":59342},[],"3.8.0 gave each service its own database. The 4.0.0 backend connects to a single PostgreSQL database named `pki` and isolates each service in a schema: `kms`, `ca`, `va`, `devicemanager`, `dmsmanager` and `alerts`. The `authz` service keeps its principals, grants and policies in a separate `authz` database (the development monolith uses an `authz` schema inside `pki` instead), and WFX keeps its own `wfx` database.",{"_3604":2760,"_31083":2705,"_21524":59344,"_5":14790,"_28264":59147,"_3060":59345},[],"PostgreSQL is now the only storage engine. SQLite support is removed, and the `couch_db` and `dynamo_db` engines are not registered in 4.0.0.",{"_3604":2761,"_31083":2705,"_21524":59347,"_5":14790,"_28264":59151,"_3060":59348},[],"In 3.8.0 the API Gateway validated tokens: a JWT policy on every private route checked the signature and only let through tokens that carried the administrator role. Every route was open to any token that passed that check.",{"_3604":2762,"_31083":2705,"_21524":59350,"_5":14790,"_28264":59151,"_3060":59351},[],"4.0.0 removes the gateway policy. The `/api/*` routes reach the services directly, and each service authorizes every request through `authz`, which validates the token against the identity provider's JWKS endpoint and applies fine-grained, entity-level policies to CAs, certificates, devices, DMSs, KMS keys and CRL settings. There is no implicit superuser: the first administrator comes from a bootstrap principal that you configure. The access control page documents principals, policies and the first administrator.",{"_3604":2763,"_31083":2705,"_21524":59353,"_5":14790,"_28264":59155,"_3060":59354},[],"Historical device events move from the `devices.events` column to a dedicated `device_events` store with their own endpoints. The events endpoint can also stream events over Server-Sent Events (SSE); to fan events out across service instances, each Device Manager instance binds its own durable AMQP queue.",{"_3604":2764,"_31083":2705,"_21524":59356,"_5":14790,"_28264":59159,"_3060":59357},[],"Version 4.0.0 of the chart is a security-hardening release:",{"_3604":2765,"_31083":2705,"_21524":59359,"_5":14790,"_28264":59159,"_3060":59360},[],"**Release-scoped resource names.** Every chart-managed resource is named `<release>-lamassu-<component>` instead of the fixed names used in 3.8.0 (`kms`, `va`, `ca`, ...). With a release named `prod` the StatefulSets become `prod-lamassu-kms` and `prod-lamassu-va`. The `nameOverride` and `fullnameOverride` values change the prefix.",{"_3604":2766,"_31083":2705,"_21524":59362,"_5":14790,"_28264":59159,"_3060":59363},[],"**Non-root containers.** Every workload runs as the numeric user `65532:65532` with a `RuntimeDefault` seccomp profile and dropped capabilities. Pods do not mount the service-account token by default, and the chart creates a dedicated ServiceAccount.",{"_3604":2767,"_31083":2705,"_21524":59365,"_5":14790,"_28264":59159,"_3060":59366},[],"**Strict values validation.** `values.schema.json` rejects unknown keys, so leftover 3.8.0 blocks fail `helm lint` and `helm upgrade` instead of being silently ignored.",{"_3604":2768,"_31083":2705,"_21524":59368,"_5":14790,"_28264":59159,"_3060":59369},[],"**No injected scheduling rules.** The chart no longer adds pod anti-affinity or topology spread constraints on its own.",{"_3604":2769,"_31083":2705,"_21524":59371,"_5":14790,"_28264":59163,"_3060":59372},[],"Several migrations run without intervention when you upgrade a Helm release:",{"_3604":2770,"_31083":2705,"_21524":59374,"_5":14790,"_28264":59163,"_3060":59375},[],"Before any service starts, the chart's pre-install/pre-upgrade job prepares PostgreSQL. It creates the `pki`, `authz` and `wfx` databases when they do not exist, creates one schema per service inside `pki`, and imports each 3.8.0 per-service database into its schema. Each import runs as a single transaction, so a failed import leaves no partial schema and a retried job imports again. The job then runs the database migrations for every schema, migrates `authz`, preloads its policies and seeds the `services.authz.bootstrap` principals. It is idempotent and requires a PostgreSQL role allowed to create databases and schemas, as described in Install with Helm.",{"_3604":2771,"_31083":2705,"_21524":59377,"_5":14790,"_28264":59163,"_3060":59378},[],"Stored DMS configuration is rewritten to the 4.0.0 layout, and historical device events are transformed into the new store.",{"_3604":2772,"_31083":2705,"_21524":59380,"_5":14790,"_28264":59163,"_3060":59381},[],"The KMS migration removes the stale `lamassu.io/kms/binded-resources` key metadata, and the VA migration resolves each role's CRL signer (see VA CRL signer).",{"_3604":2773,"_31083":2705,"_21524":59383,"_5":14790,"_28264":59163,"_3060":59384},[],"When `migrations.caToKms.enabled` is set, a pre-upgrade hook registers legacy CA keys in the KMS.",{"_3604":2774,"_31083":2705,"_21524":59386,"_5":14790,"_28264":59163,"_3060":59387},[],"Two things never migrate on their own: the KMS and VA data on local volumes, which stays on volumes the upgraded pods no longer use, and the values file, which you update by hand. Deployments that do not use the Helm chart also have to move their database data themselves; see Deployments without Helm.",{"_3604":2775,"_31083":2705,"_21524":59389,"_5":14790,"_28264":59167,"_3060":59390},[],"Change",{"_3604":2776,"_31083":2705,"_21524":59392,"_5":14790,"_28264":59167,"_3060":59393},[],"Who is affected",{"_3604":2777,"_31083":2705,"_21524":59395,"_5":14790,"_28264":59167,"_3060":59396},[],"Severity",{"_3604":2778,"_31083":2705,"_21524":59398,"_5":14790,"_28264":59167,"_3060":57856},[],{"_3604":2779,"_31083":2705,"_21524":59400,"_5":14790,"_28264":59167,"_3060":59176},[],{"_3604":2780,"_31083":2705,"_21524":59402,"_5":14790,"_28264":59167,"_3060":59403},[],"Helm releases with a filesystem KMS engine or local VA CRL storage",{"_3604":2781,"_31083":2705,"_21524":59405,"_5":14790,"_28264":59167,"_3060":59406},[],"High: KMS and VA start on empty volumes",{"_3604":2782,"_31083":2705,"_21524":59408,"_5":14790,"_28264":59167,"_3060":59409},[],"Copy the data into the new volumes",{"_3604":2783,"_31083":2705,"_21524":59411,"_5":14790,"_28264":59167,"_3060":59180},[],{"_3604":2784,"_31083":2705,"_21524":59413,"_5":14790,"_28264":59167,"_3060":59414},[],"Every Helm release",{"_3604":2785,"_31083":2705,"_21524":59416,"_5":14790,"_28264":59167,"_3060":59417},[],"High: `helm upgrade` fails",{"_3604":2786,"_31083":2705,"_21524":59419,"_5":14790,"_28264":59167,"_3060":59420},[],"Remove or rename legacy keys",{"_3604":2787,"_31083":2705,"_21524":59422,"_5":14790,"_28264":59167,"_3060":51368},[],{"_3604":2788,"_31083":2705,"_21524":59424,"_5":14790,"_28264":59167,"_3060":59414},[],{"_3604":2789,"_31083":2705,"_21524":59426,"_5":14790,"_28264":59167,"_3060":59427},[],"High: `helm upgrade` fails on inline credentials",{"_3604":2790,"_31083":2705,"_21524":59429,"_5":14790,"_28264":59167,"_3060":59430},[],"Create the Secrets first; see Step 2",{"_3604":2791,"_31083":2705,"_21524":59432,"_5":14790,"_28264":59167,"_3060":59187},[],{"_3604":2792,"_31083":2705,"_21524":59434,"_5":14790,"_28264":59167,"_3060":59435},[],"Every deployment",{"_3604":2793,"_31083":2705,"_21524":59437,"_5":14790,"_28264":59167,"_3060":59438},[],"High: without a bootstrap principal there is no administrator",{"_3604":2794,"_31083":2705,"_21524":59440,"_5":14790,"_28264":59167,"_3060":59441},[],"Configure `services.authz`",{"_3604":2795,"_31083":2705,"_21524":59443,"_5":14790,"_28264":59167,"_3060":59191},[],{"_3604":2796,"_31083":2705,"_21524":59445,"_5":14790,"_28264":59167,"_3060":59414},[],{"_3604":2797,"_31083":2705,"_21524":59447,"_5":14790,"_28264":59167,"_3060":59448},[],"High: `helm upgrade` fails on the old keys",{"_3604":2798,"_31083":2705,"_21524":59450,"_5":14790,"_28264":59167,"_3060":59451},[],"Move JWKS and roles into `services.authz`",{"_3604":2799,"_31083":2705,"_21524":59453,"_5":14790,"_28264":59167,"_3060":59211},[],{"_3604":2800,"_31083":2705,"_21524":59455,"_5":14790,"_28264":59167,"_3060":59456},[],"3.8.0 deployments with per-service databases",{"_3604":2801,"_31083":2705,"_21524":59458,"_5":14790,"_28264":59167,"_3060":59459},[],"High: services find no data, or a migration aborts",{"_3604":2802,"_31083":2705,"_21524":59461,"_5":14790,"_28264":59167,"_3060":59462},[],"Clean duplicate CA IDs and empty `engine_id` values first; move data manually outside Helm",{"_3604":2803,"_31083":2705,"_21524":59464,"_5":14790,"_28264":59167,"_3060":59215},[],{"_3604":2804,"_31083":2705,"_21524":59466,"_5":14790,"_28264":59167,"_3060":59467},[],"Deployments on SQLite, `couch_db` or `dynamo_db`",{"_3604":2805,"_31083":2705,"_21524":59469,"_5":14790,"_28264":59167,"_3060":59470},[],"High: the backend no longer starts with them",{"_3604":2806,"_31083":2705,"_21524":59472,"_5":14790,"_28264":59167,"_3060":59473},[],"Move to PostgreSQL before upgrading",{"_3604":2807,"_31083":2705,"_21524":59475,"_5":14790,"_28264":59167,"_3060":59259},[],{"_3604":2808,"_31083":2705,"_21524":59477,"_5":14790,"_28264":59167,"_3060":59478},[],"Every deployment; API clients, custom policies and alert subscriptions are also affected",{"_3604":2809,"_31083":2705,"_21524":59480,"_5":14790,"_28264":59167,"_3060":59481},[],"High: the `/v1/roles` routes are removed and the migration is irreversible",{"_3604":2810,"_31083":2705,"_21524":59483,"_5":14790,"_28264":59167,"_3060":59484},[],"Fix the data the migration aborts on, and back up the database and the CRL bucket",{"_3604":2811,"_31083":2705,"_21524":59486,"_5":14790,"_28264":59167,"_3060":59487},[],"Webhooks with file references",{"_3604":2812,"_31083":2705,"_21524":59489,"_5":14790,"_28264":59167,"_3060":59490},[],"DMSs whose webhook mTLS certificate or key were file paths",{"_3604":2813,"_31083":2705,"_21524":59492,"_5":14790,"_28264":59167,"_3060":59493},[],"High: enrollments calling the webhook fail",{"_3604":2814,"_31083":2705,"_21524":59495,"_5":14790,"_28264":59167,"_3060":59496},[],"Re-enter certificate and key as PEM, or remove the file fields",{"_3604":2815,"_31083":2705,"_21524":59498,"_5":14790,"_28264":59167,"_3060":59195},[],{"_3604":2816,"_31083":2705,"_21524":59500,"_5":14790,"_28264":59167,"_3060":59501},[],"Releases with per-service identity overrides or mounted key material",{"_3604":2817,"_31083":2705,"_21524":59503,"_5":14790,"_28264":59167,"_3060":59504},[],"Medium: services cannot read their files",{"_3604":2818,"_31083":2705,"_21524":59506,"_5":14790,"_28264":59167,"_3060":59507},[],"Remove the overrides and fix volume ownership",{"_3604":2819,"_31083":2705,"_21524":59509,"_5":14790,"_28264":59167,"_3060":59199},[],{"_3604":2820,"_31083":2705,"_21524":59511,"_5":14790,"_28264":59167,"_3060":59512},[],"Releases that set `amqp.tls`",{"_3604":2821,"_31083":2705,"_21524":59514,"_5":14790,"_28264":59167,"_3060":59515},[],"Medium: clients connect to the wrong port",{"_3604":2822,"_31083":2705,"_21524":59517,"_5":14790,"_28264":59167,"_3060":59518},[],"Point `amqp.port` at the TLS listener, or disable TLS",{"_3604":2823,"_31083":2705,"_21524":59520,"_5":14790,"_28264":59167,"_3060":59219},[],{"_3604":2824,"_31083":2705,"_21524":59522,"_5":14790,"_28264":59167,"_3060":59523},[],"Installations whose CA keys predate the KMS",{"_3604":2825,"_31083":2705,"_21524":59525,"_5":14790,"_28264":59167,"_3060":59526},[],"Medium: CA keys stay unmanaged",{"_3604":2826,"_31083":2705,"_21524":59528,"_5":14790,"_28264":59167,"_3060":59529},[],"Run the CA-to-KMS migration",{"_3604":2827,"_31083":2705,"_21524":59531,"_5":14790,"_28264":59167,"_3060":59532},[],"Receiver certificate verification",{"_3604":2828,"_31083":2705,"_21524":59534,"_5":14790,"_28264":59167,"_3060":59535},[],"DMSs whose webhook had `validate_server_cert: false`",{"_3604":2829,"_31083":2705,"_21524":59537,"_5":14790,"_28264":59167,"_3060":59538},[],"Medium: credentials go to an unverified receiver",{"_3604":2830,"_31083":2705,"_21524":59540,"_5":14790,"_28264":59167,"_3060":59541},[],"Set `insecure_skip_verify` to `false`",{"_3604":2831,"_31083":2705,"_21524":59543,"_5":14790,"_28264":59167,"_3060":59235},[],{"_3604":2832,"_31083":2705,"_21524":59545,"_5":14790,"_28264":59167,"_3060":59546},[],"Scripts and consoles that edit DMSs through the API",{"_3604":2833,"_31083":2705,"_21524":59548,"_5":14790,"_28264":59167,"_3060":59549},[],"Medium: an old-layout edit silently empties `validation_cas`",{"_3604":2834,"_31083":2705,"_21524":59551,"_5":14790,"_28264":59167,"_3060":59552},[],"Read the DMS before editing and use the new field",{"_3604":2835,"_31083":2705,"_21524":59554,"_5":14790,"_28264":59167,"_3060":59255},[],{"_3604":2836,"_31083":2705,"_21524":59556,"_5":14790,"_28264":59167,"_3060":59557},[],"Clients that create or update CRL settings through the API",{"_3604":2837,"_31083":2705,"_21524":59559,"_5":14790,"_28264":59167,"_3060":59560},[],"Medium: requests with the old field return an error",{"_3604":2838,"_31083":2705,"_21524":59562,"_5":14790,"_28264":59167,"_3060":59563},[],"Replace `crl_options.subject_key_id_signer` with the required `crl_options.signer_serial_number`",{"_3604":2839,"_31083":2705,"_21524":59565,"_5":14790,"_28264":59167,"_3060":59263},[],{"_3604":2840,"_31083":2705,"_21524":59567,"_5":14790,"_28264":59167,"_3060":59568},[],"Alert subscriptions and consumers of the VA events",{"_3604":2841,"_31083":2705,"_21524":59570,"_5":14790,"_28264":59167,"_3060":59571},[],"Medium: subscription types are renamed automatically, their conditions are not",{"_3604":2842,"_31083":2705,"_21524":59573,"_5":14790,"_28264":59167,"_3060":59574},[],"Review conditions filtering on the old event payload or subject",{"_3604":2843,"_31083":2705,"_21524":59576,"_5":14790,"_28264":59167,"_3060":59251},[],{"_3604":2844,"_31083":2705,"_21524":59578,"_5":14790,"_28264":59167,"_3060":59579},[],"Consumers that read the device `events` field",{"_3604":2845,"_31083":2705,"_21524":59581,"_5":14790,"_28264":59167,"_3060":59582},[],"Medium: the field disappears",{"_3604":2846,"_31083":2705,"_21524":59584,"_5":14790,"_28264":59167,"_3060":59585},[],"Use the new event endpoints",{"_3604":2847,"_31083":2705,"_21524":59587,"_5":14790,"_28264":59167,"_3060":59275},[],{"_3604":2848,"_31083":2705,"_21524":59589,"_5":14790,"_28264":59167,"_3060":59590},[],"Deployments with VA roles whose signer cannot be resolved uniquely",{"_3604":2849,"_31083":2705,"_21524":59592,"_5":14790,"_28264":59167,"_3060":59593},[],"Medium: the VA migration aborts",{"_3604":2850,"_31083":2705,"_21524":59595,"_5":14790,"_28264":59167,"_3060":59596},[],"Fix the affected roles before upgrading",{"_3604":2851,"_31083":2705,"_21524":59598,"_5":14790,"_28264":59167,"_3060":59203},[],{"_3604":2852,"_31083":2705,"_21524":59600,"_5":14790,"_28264":59167,"_3060":59601},[],"Releases that override `toolbox`, `services.connectors`, ports, probes or scheduling",{"_3604":2853,"_31083":2705,"_21524":59603,"_5":14790,"_28264":59167,"_3060":59604},[],"Low to medium: validation errors or changed defaults",{"_3604":2854,"_31083":2705,"_21524":59606,"_5":14790,"_28264":59167,"_3060":59607},[],"Update the values file",{"_3604":2855,"_31083":2705,"_21524":59609,"_5":14790,"_28264":59167,"_3060":59243},[],{"_3604":2856,"_31083":2705,"_21524":59611,"_5":14790,"_28264":59167,"_3060":59612},[],"Clients that send the DMS ID in the update body",{"_3604":2857,"_31083":2705,"_21524":59614,"_5":14790,"_28264":59167,"_3060":59615},[],"Low: the ID in the URL wins",{"_3604":2858,"_31083":2705,"_21524":59617,"_5":14790,"_28264":59167,"_3060":59618},[],"Send the ID in the URL",{"_3604":2859,"_31083":2705,"_21524":59620,"_5":14790,"_28264":59167,"_3060":59267},[],{"_3604":2860,"_31083":2705,"_21524":59622,"_5":14790,"_28264":59167,"_3060":59623},[],"Clients that send an `id` when creating or importing CAs",{"_3604":2861,"_31083":2705,"_21524":59625,"_5":14790,"_28264":59167,"_3060":59626},[],"Low: the ID in the body is ignored, and the field is removed",{"_3604":2862,"_31083":2705,"_21524":59628,"_5":14790,"_28264":59167,"_3060":59629},[],"Let the backend assign the ID and use the returned one",{"_3604":2863,"_31083":2705,"_21524":59631,"_5":14790,"_28264":59167,"_3060":59271},[],{"_3604":2864,"_31083":2705,"_21524":59633,"_5":14790,"_28264":59167,"_3060":59634},[],"API and SDK clients that call `/v1/cas/{id}/signature/sign` or `/verify`, and alert subscriptions on `ca.sign.signature`",{"_3604":2865,"_31083":2705,"_21524":59636,"_5":14790,"_28264":59167,"_3060":59637},[],"Medium: the calls return `404` and the subscriptions never fire",{"_3604":2866,"_31083":2705,"_21524":59639,"_5":14790,"_28264":59167,"_3060":59640},[],"Use the KMS `sign` and `verify` operations",{"_3604":2867,"_31083":2705,"_21524":59642,"_5":14790,"_28264":59167,"_3060":59247},[],{"_3604":2868,"_31083":2705,"_21524":59644,"_5":14790,"_28264":59167,"_3060":59645},[],"Consumers that match on certificate `type`",{"_3604":2869,"_31083":2705,"_21524":59647,"_5":14790,"_28264":59167,"_3060":59648},[],"Low: two values are renamed",{"_3604":2870,"_31083":2705,"_21524":59650,"_5":14790,"_28264":59167,"_3060":59651},[],"Adapt consumers",{"_3604":2871,"_31083":2705,"_21524":59653,"_5":14790,"_28264":59167,"_3060":59239},[],{"_3604":2872,"_31083":2705,"_21524":59655,"_5":14790,"_28264":59167,"_3060":59656},[],"Any DMS",{"_3604":2873,"_31083":2705,"_21524":59658,"_5":14790,"_28264":59167,"_3060":59659},[],"Low: informational",{"_3604":2874,"_31083":2705,"_21524":59661,"_5":14790,"_28264":59167,"_3060":59662},[],"Read both blocks before editing",{"_3604":2875,"_31083":2705,"_21524":59664,"_5":14790,"_28264":59175,"_3060":59665},[],"Kubernetes derives a StatefulSet's PVC name from its pod name (`<volumeClaimTemplate>-<pod-name>`). Renaming the `kms` and `va` StatefulSets means `helm upgrade` binds brand-new, empty PVCs instead of the existing ones. The KMS key material and VA CRLs are not deleted — the old PVCs are orphaned, not removed — but the upgraded pods fail with `no such file or directory` (KMS) or `code=NotFound` (VA) until you copy the data across. This affects KMS when `services.kms.cryptoEngines` uses a `filesystem` engine and VA when `services.va.fileStore.type` is `local`. Every other renamed resource is stateless and is recreated without data-loss risk.",{"_3604":2876,"_31083":2705,"_21524":59667,"_5":14790,"_28264":59175,"_3060":59668},[],"Step 4 of the migration guide copies the data.",{"_3604":2877,"_31083":2705,"_21524":59670,"_5":14790,"_28264":59179,"_3060":59671},[],"`values.schema.json` rejects unknown keys, so every block that 4.0.0 removed or renamed — `toolbox`, `auth.oidc.apiGateway`, `auth.authorization` and others — fails `helm lint` and `helm upgrade` outright. Step 2 lists every change.",{"_3604":2878,"_31083":2705,"_21524":59673,"_5":14790,"_28264":59183,"_3060":59674},[],"In 4.0.0 the chart reads PostgreSQL, AMQP and SMTP credentials from Kubernetes Secrets in the release namespace instead of inline values: `postgres.existingSecret`, `amqp.existingSecret` and — when SMTP authentication is configured — `services.alerts.smtp_server.existingSecret`, each with `usernameKey` and `passwordKey` naming the Secret data keys. The inline `postgres.username`/`postgres.password` and `amqp.username`/`amqp.password` values are removed and rejected by `values.schema.json`, so a 3.8.0 values file fails `helm lint` and `helm upgrade` until the credentials move into Secrets.",{"_3604":2879,"_31083":2705,"_21524":59676,"_5":14790,"_28264":59183,"_3060":59677},[],"The Secrets must exist before `helm upgrade` runs: the pre-upgrade database job connects to PostgreSQL with them. Step 2 creates them through the External Secrets Operator.",{"_3604":2880,"_31083":2705,"_21524":59679,"_5":14790,"_28264":59186,"_3060":59680},[],"3.8.0 had no authorization service, so a 3.8.0 values file has nothing to migrate from: you must add the `services.authz` configuration yourself. It needs the JWKS endpoint of your identity provider, the database mappings the authorization engine uses, and a bootstrap principal that matches how your provider assigns the administrator role. Without a matching principal nobody can administer the PKI.",{"_3604":2881,"_31083":2705,"_21524":59682,"_5":14790,"_28264":59190,"_3060":59683},[],"`auth.oidc.apiGateway.jwks`, `auth.authorization.rolesClaim` and `auth.authorization.roles.admin` are removed with no compatibility aliases, and the schema rejects them. Their settings move into `services.authz`: the JWKS URL becomes `services.authz.jwkUrl`, and the role claim and administrator role become a claim rule of the bootstrap principal. `auth.oidc.frontend` is unchanged.",{"_3604":2882,"_31083":2705,"_21524":59685,"_5":14790,"_28264":59194,"_3060":59686},[],"Service images run on a distroless base as the numeric user `65532`; the `authz` image is Ubuntu with a non-root user that has the same UID. The per-service overrides `services.kms.securityContext.runAsGroup: 0` and `services.authz.securityContext.runAsUser`/`runAsGroup: 999` are removed; group access to the KMS volume and PKCS#11 socket is now handled by the pod-level `fsGroup: 65532`.",{"_3604":2883,"_31083":2705,"_21524":59688,"_5":14790,"_28264":59194,"_3060":59689},[],"3.8.0 did not pin a container identity, so existing files can carry any UID. Any volume that holds keys or CRLs must be owned by `65532:65532`, or at least readable (and, where needed, writable) by that identity.",{"_3604":2884,"_31083":2705,"_21524":59691,"_5":14790,"_28264":59194,"_3060":59692},[],"Pods now carry a pod-level `fsGroup: 65532` with `fsGroupChangePolicy: OnRootMismatch`, which skips recursive ownership changes when the volume root already has the expected group. If your backup helpers or jobs run with a different GID, verify they can still access the volumes they need.",{"_3604":2885,"_31083":2705,"_21524":59694,"_5":14790,"_28264":59198,"_3060":59695},[],"In 3.8.0 `amqp.tls` was not applied and event-bus clients always connected over plaintext. In 4.0.0 `amqp.tls: true` switches them to AMQPS. The default `amqp.port` stays `5672` and does not change when TLS is enabled, so a values file that already set `amqp.tls: true` must point `amqp.port` at the broker's TLS listener (`amqps`, commonly `5671`), or set `amqp.tls: false` to keep plaintext. Clients must also trust the broker's certificate.",{"_3604":2886,"_31083":2705,"_21524":59697,"_5":14790,"_28264":59202,"_3060":59698},[],"`toolbox` is renamed to `connectivityTest`, and the `helm test` hook uses the upstream `curlimages/curl` image pinned by digest.",{"_3604":2887,"_31083":2705,"_21524":59700,"_5":14790,"_28264":59202,"_3060":59701},[],"`services.connectors` is a map keyed by connector ID instead of a list.",{"_3604":2888,"_31083":2705,"_21524":59703,"_5":14790,"_28264":59202,"_3060":59704},[],"The `services.ui.port` default is `8085`, the unprivileged port of the rootless image.",{"_3604":2889,"_31083":2705,"_21524":59706,"_5":14790,"_28264":59202,"_3060":59707},[],"The shared `probes:` block is replaced by independent `livenessProbe`, `readinessProbe` and `startupProbe` blocks.",{"_3604":2890,"_31083":2705,"_21524":59709,"_5":14790,"_28264":59202,"_3060":59710},[],"With `tls.certManagerOptions.issuer` empty, the chart creates a release-scoped self-signed issuer, for example `lamassu-downstream-ca-selfsigned-issuer`. The legacy literal `downstream-ca-selfsigned-issuer` is still accepted and resolves to it.",{"_3604":2891,"_31083":2705,"_21524":59712,"_5":14790,"_28264":59202,"_3060":59713},[],"Anti-affinity and topology spread must be configured explicitly through `affinity` and `topologySpreadConstraints`.",{"_3604":2892,"_31083":2705,"_21524":59715,"_5":14790,"_28264":59210,"_3060":59716},[],"Every 3.8.0 per-service database must end up as a schema of `pki`, keeping its structure, indexes, constraints, data and migration history. The Helm chart does this automatically; deployments without Helm do it by hand (see Deployments without Helm).",{"_3604":2893,"_31083":2705,"_21524":59718,"_5":14790,"_28264":59210,"_3060":59719},[],"Two schema migrations abort on data that 3.8.0 allowed, so clean the data before upgrading:",{"_3604":2894,"_31083":2705,"_21524":59721,"_5":14790,"_28264":59210,"_3060":59722},[],"The CA migration adds a UNIQUE constraint on `ca_certificates.id` and aborts if duplicate CA IDs exist. Imports already reject duplicates with `409`, so new ones cannot normally appear.",{"_3604":2895,"_31083":2705,"_21524":59724,"_5":14790,"_28264":59210,"_3060":59725},[],"The KMS migration promotes the primary key to `(key_id, engine_id)` and aborts with `cannot promote (key_id, engine_id) to primary key: N row(s) have no engine_id; backfill them before migrating` when `kms_keys` rows lack `engine_id`. Backfill `engine_id` first.",{"_3604":2896,"_31083":2705,"_21524":59727,"_5":14790,"_28264":59210,"_3060":59728},[],"The same KMS migration deletes, with a `NOTICE`, aliases that equal an existing key ID, because identifiers now resolve as a key ID before an alias. Affected aliases are dropped, not redirected.",{"_3604":2897,"_31083":2705,"_21524":59730,"_5":14790,"_28264":59214,"_3060":59731},[],"The SQLite storage engine is removed, and the `couch_db` and `dynamo_db` engines are not registered in 4.0.0: their configuration constants remain, but they select no engine. Deployments on any of them must move to PostgreSQL and consolidate their data into the `pki` schemas before upgrading.",{"_3604":2898,"_31083":2705,"_21524":59733,"_5":14790,"_28264":59218,"_3060":59734},[],"CA certificates of type `MANAGED` or `IMPORTED_WITH_KEY` whose private keys predate the KMS service have the key stored only in the crypto engine, under the certificate's `subject_key_id`, with no KMS record. The `ca-to-kms-migration` tool registers them:",{"_3604":2899,"_31083":2705,"_21524":59736,"_5":14790,"_28264":59218,"_3060":59737},[],"The `key_id` is the certificate's `subject_key_id`; it matches the SHA-256 digest of the public key only when the SKI was computed that way.",{"_3604":2900,"_31083":2705,"_21524":59739,"_5":14790,"_28264":59218,"_3060":59740},[],"The tool is idempotent: keys already in the KMS are skipped, so it can be run several times.",{"_3604":2901,"_31083":2705,"_21524":59742,"_5":14790,"_28264":59218,"_3060":59743},[],"Certificates that cannot be read, or lack an engine or a subject key ID, are skipped with a warning. Review the logs and resolve the affected records.",{"_3604":2902,"_31083":2705,"_21524":59745,"_5":14790,"_28264":59218,"_3060":59746},[],"When CA certificates sharing a `subject_key_id` declare conflicting `engine_id`s, the tool fails that key and exits with code `1`, which fails a Helm pre-upgrade hook. Resolve the conflict manually before rerunning.",{"_3604":2903,"_31083":2705,"_21524":59748,"_5":14790,"_28264":59218,"_3060":59749},[],"Once the keys are registered, certificates reference them in the database and the KMS refuses to delete a key that a certificate still uses (`409` `key is in use`). Deleting a certificate record removes it from the CRL and OCSP, so read Before deleting a key before freeing a key.",{"_3604":2904,"_31083":2705,"_21524":59751,"_5":14790,"_28264":59218,"_3060":59752},[],"Optionally, installations with imported CAs from before 3.7 can start the KMS once with `crypto_engines.migrate_keys_format: true`: the KMS renames those SKI-named legacy keys to the SHA-256 digest of their public key (the old name is kept as an alias, and the certificate references follow automatically). Run it once and disable the option again; running it again is safe.",{"_3604":2905,"_31083":2705,"_21524":59754,"_5":14790,"_28264":59218,"_3060":59755},[],"With Helm, enable the hook for the upgrade in step 2; without Helm, run the tool by hand.",{"_3604":2906,"_31083":2705,"_21524":59757,"_5":14790,"_28264":59222,"_3060":59758},[],"Certificates now reference their KMS key, and CRL settings reference their signer certificate, so a key or certificate in use cannot be deleted. The KMS migration drops the legacy `lamassu.io/kms/binded-resources` key metadata. Before 4.0.0, deleting a CA could remove its key while leaving key references in its retained certificate records. The CA migration registers those missing keys in the KMS with only their public key to satisfy the retained references. These entries cannot be deleted while the retained certificates reference them; they do not restore the private key. In 4.0.0, deleting a CA releases the references from its own current certificate and linked reissued certificates before attempting to delete the key; other certificates that still reference it prevent deletion.",{"_3604":2907,"_31083":2705,"_21524":59760,"_5":14790,"_28264":59230,"_3060":59761},[],"Stored webhook configs are rewritten to the current layout and their fields renamed:",{"_3604":2908,"_31083":2705,"_21524":59763,"_5":14790,"_28264":59230,"_3060":59764},[],"Field in 3.8.0",{"_3604":2909,"_31083":2705,"_21524":59766,"_5":14790,"_28264":59230,"_3060":59767},[],"Field in 4.0.0",{"_3604":2910,"_31083":2705,"_21524":59769,"_5":14790,"_28264":59230,"_3060":59770},[],"`validate_server_cert`",{"_3604":2911,"_31083":2705,"_21524":59772,"_5":14790,"_28264":59230,"_3060":59773},[],"`insecure_skip_verify` (value negated)",{"_3604":2912,"_31083":2705,"_21524":59775,"_5":14790,"_28264":59230,"_3060":59776},[],"`oidc`",{"_3604":2913,"_31083":2705,"_21524":59778,"_5":14790,"_28264":59230,"_3060":59779},[],"`jwt_options`",{"_3604":2914,"_31083":2705,"_21524":59781,"_5":14790,"_28264":59230,"_3060":59782},[],"`apikey`",{"_3604":2915,"_31083":2705,"_21524":59784,"_5":14790,"_28264":59230,"_3060":59785},[],"`apikey_options`",{"_3604":2916,"_31083":2705,"_21524":59787,"_5":14790,"_28264":59230,"_3060":59788},[],"`mtls`",{"_3604":2917,"_31083":2705,"_21524":59790,"_5":14790,"_28264":59230,"_3060":59791},[],"`mtls_options`",{"_3604":2918,"_31083":2705,"_21524":59793,"_5":14790,"_28264":59230,"_3060":59794},[],"When the legacy mTLS certificate and key are both PEM, they move into `mtls_options.cert_content` and `mtls_options.key_content` and need no action. Two cases do need it.",{"_3604":2919,"_31083":2705,"_21524":59796,"_5":14790,"_28264":59230,"_3060":59797},[],"**Webhooks with file references.** A mixed config, with a PEM certificate and a file-path key, is migrated to `mtls_options.cert_file` and `mtls_options.key_file`. Webhook delivery rejects those fields on every call, whatever the configured authentication mode, so every enroll and re-enroll that calls that webhook fails until the config is fixed. If the webhook uses mTLS, re-enter the certificate and key as Base64-encoded or plain PEM; if it does not, remove the leftover file fields. Metadata-only updates keep working in the meantime (`PUT` or `PATCH` on `/v1/dms/:id/metadata`). In a variant of the same problem, a stored config with file paths inside `mtls_options.cert_content` or `mtls_options.key_content` makes every full settings update (`POST /v1/dms` or `PUT /v1/dms/:id`) fail validation; settings are replaced wholesale, so resend the config with the certificate and key as PEM.",{"_3604":2920,"_31083":2705,"_21524":59799,"_5":14790,"_28264":59230,"_3060":59800},[],"**Receiver certificate verification.** A config with `validate_server_cert: false` becomes `insecure_skip_verify: true`, so receiver verification stays skipped until that field is set to `false`. Correct it on every migrated config: the webhook authorization channel carries the API key or bearer token, and skipping verification exposes those credentials to a network-positioned attacker. Keep `insecure_skip_verify: true` only when the receiver certificate is deliberately unverifiable.",{"_3604":2921,"_31083":2705,"_21524":59802,"_5":14790,"_28264":59234,"_3060":59803},[],"The flat field `reenrollment_settings.additional_validation_cas` moves into the nested field `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`:",{"_3604":2922,"_31083":2705,"_21524":59805,"_5":14790,"_28264":59234,"_3060":59806},[],"The effective trust set does not change, because the nested value was never consulted when validating re-enrollments. If the flat list was missing or null, it becomes an empty list.",{"_3604":2923,"_31083":2705,"_21524":59808,"_5":14790,"_28264":59234,"_3060":59809},[],"What changes is how API requests are handled. Bodies that still carry `additional_validation_cas` are accepted, but the value is silently dropped because unknown JSON fields are ignored, and GET responses no longer include it. An update body built from the old layout therefore empties `validation_cas` without any error. Always read the DMS before sending an edit and reuse the layout the API returns.",{"_3604":2924,"_31083":2705,"_21524":59811,"_5":14790,"_28264":59238,"_3060":59812},[],"Re-enrollment authentication settings are now stored independently from initial authentication. Nothing needs migrating, but read both blocks before editing a DMS so that you do not modify one while believing you are editing the other. The console exposes independent editors for both blocks; the DMS guide describes their fields, and you can also edit them through the DMS API.",{"_3604":2925,"_31083":2705,"_21524":59814,"_5":14790,"_28264":59242,"_3060":59815},[],"`PUT /v1/dms/:id` takes the DMS ID from the URL and validates the request body. An ID in the body is ignored, so update clients that relied on it.",{"_3604":2926,"_31083":2705,"_21524":59817,"_5":14790,"_28264":59246,"_3060":59818},[],"Stored certificate type values are renamed: `IMPORTED` becomes `IMPORTED_WITH_KEY` and `EXTERNAL` becomes `IMPORTED_WITHOUT_KEY`. `MANAGED` is unchanged. Adapt consumers that read or match on those values.",{"_3604":2927,"_31083":2705,"_21524":59820,"_5":14790,"_28264":59250,"_3060":59821},[],"The `events` field no longer appears in the device representation. Point consumers at the new endpoints:",{"_3604":2928,"_31083":2705,"_21524":59823,"_5":14790,"_28264":59250,"_3060":59824},[],"`GET /v1/devices/:id/events` returns a device's events.",{"_3604":2929,"_31083":2705,"_21524":59826,"_5":14790,"_28264":59250,"_3060":59827},[],"`POST /v1/devices/:id/events` creates an event.",{"_3604":2930,"_31083":2705,"_21524":59829,"_5":14790,"_28264":59250,"_3060":59830},[],"When the request `Accept` header includes `text/event-stream`, the events endpoint streams over SSE with a keepalive every 15 seconds, and returns `501` when SSE is disabled in the deployment. Each Device Manager instance binds a durable AMQP queue named after its service ID, `device-manager-sse-<uuid>`. Queues from crashed or replaced instances linger until removed, so configure an expiration or cleanup policy on the broker.",{"_3604":2931,"_31083":2705,"_21524":59832,"_5":14790,"_28264":59254,"_3060":59833},[],"`crl_options.subject_key_id_signer` is replaced by the required `crl_options.signer_serial_number`, the serial number of the existing certificate that signs the CRL. A new CA's initial value is the serial number of its current certificate. Requests that still carry `subject_key_id_signer` return an error. The authorization entity that holds these settings is also renamed; see CRL settings keyed by CA ID.",{"_3604":2932,"_31083":2705,"_21524":59835,"_5":14790,"_28264":59258,"_3060":59836},[],"In 3.8.0 the VA keyed each CRL by the CA's SKI, and `GET`/`PUT /v1/roles/{ca-ski}` read and updated it. In 4.0.0 the CRL settings of a CA are keyed by its CA ID, and every CA has its own, even when two CAs share a key:",{"_3604":2933,"_31083":2705,"_21524":59838,"_5":14790,"_28264":59258,"_3060":59839},[],"Route",{"_3604":2934,"_31083":2705,"_21524":59841,"_5":14790,"_28264":59258,"_3060":54170},[],{"_3604":2935,"_31083":2705,"_21524":59843,"_5":14790,"_28264":59258,"_3060":59844},[],"`GET /v1/crl-settings`",{"_3604":2936,"_31083":2705,"_21524":59846,"_5":14790,"_28264":59258,"_3060":59847},[],"Lists the CRL settings; filterable at least by `ca_id`, `status` and `legacy_ski`.",{"_3604":2937,"_31083":2705,"_21524":59849,"_5":14790,"_28264":59258,"_3060":59850},[],"`GET /v1/crl-settings/{ca-id}`",{"_3604":2938,"_31083":2705,"_21524":59852,"_5":14790,"_28264":59258,"_3060":59853},[],"Reads the settings of a CA.",{"_3604":2939,"_31083":2705,"_21524":59855,"_5":14790,"_28264":59258,"_3060":59856},[],"`PUT /v1/crl-settings/{ca-id}`",{"_3604":2940,"_31083":2705,"_21524":59858,"_5":14790,"_28264":59258,"_3060":59859},[],"Replaces `crl_options`.",{"_3604":2941,"_31083":2705,"_21524":59861,"_5":14790,"_28264":59258,"_3060":59862},[],"`DELETE /v1/crl-settings/{ca-id}`",{"_3604":2942,"_31083":2705,"_21524":59864,"_5":14790,"_28264":59258,"_3060":59865},[],"Removes the archived settings of a CA.",{"_3604":2943,"_31083":2705,"_21524":59867,"_5":14790,"_28264":59258,"_3060":59868},[],"The options keep their meaning and their defaults: 7 days of `validity`, 6 days and 23 hours of `refresh_interval`, and `regenerate_on_revoke` `true`. `status` (`ACTIVE`, `FINAL` or `ARCHIVED`), `legacy_ski` and `latest_crl` are read-only. A `PUT` validates the signer only when it changes, does not regenerate the CRL, and returns `409` when the settings are not `ACTIVE`.",{"_3604":2944,"_31083":2705,"_21524":59870,"_5":14790,"_28264":59258,"_3060":59871},[],"The public endpoint `GET /crl/{id}` takes the CA ID — the form the CDPs of newly issued certificates use — and keeps resolving the SKI form of certificates issued before the upgrade. Certificates issued before the upgrade keep their `/crl/<ski>` distribution points; newly issued ones carry `/crl/<ca-id>`, and both resolve to the same settings. The VA scheduled CRL job requests a new list on its first run, and the new list includes both URLs in its *Issuing Distribution Point*. Until it succeeds, the old list has only the legacy `/crl/<ski>` IDP: verifiers that compare it with the CDP of newly issued certificates cannot validate those certificates. The default schedule can delay the first run by up to about an hour; failures can extend the window.",{"_3604":2945,"_31083":2705,"_21524":59873,"_5":14790,"_28264":59258,"_3060":59874},[],"The migration that turns VA roles into CRL settings cannot be rolled back: its rollback does nothing. CRLs generated after the upgrade are stored under the CA ID, where 3.8.0 does not look for them, and the archived settings of CAs deleted before the upgrade have no signer to go back to. Returning to 3.8.0 requires restoring both the database and the CRL bucket — the object storage that holds the published lists — from the backups taken before the upgrade.",{"_3604":2946,"_31083":2705,"_21524":59876,"_5":14790,"_28264":59258,"_3060":59877},[],"The migration aborts, and the upgrade fails, on five kinds of data:",{"_3604":2947,"_31083":2705,"_21524":59879,"_5":14790,"_28264":59258,"_3060":59880},[],"CA IDs containing `/`: they cannot be used in CRL URLs. Recreate those CAs with a different ID.",{"_3604":2948,"_31083":2705,"_21524":59882,"_5":14790,"_28264":59258,"_3060":59883},[],"An SKI shared by more than one CA: the error names the SKIs and asks you to recreate all but one of them on a different key.",{"_3604":2949,"_31083":2705,"_21524":59885,"_5":14790,"_28264":59258,"_3060":59886},[],"A VA role whose signer certificate has no key: point the role to a signer with a key, or fix the key reference of the certificate, before upgrading.",{"_3604":2950,"_31083":2705,"_21524":59888,"_5":14790,"_28264":59258,"_3060":59889},[],"A CA whose ID equals the `legacy-<ski>` ID the migration reserves for the archived settings of another role whose CA was deleted: recreate that CA with a different ID.",{"_3604":2951,"_31083":2705,"_21524":59891,"_5":14790,"_28264":59258,"_3060":59892},[],"A CA ID equal to the SKI of another VA role: their CRL URLs would be ambiguous.",{"_3604":2952,"_31083":2705,"_21524":59894,"_5":14790,"_28264":59258,"_3060":59895},[],"The settings of a CA deleted before the upgrade are migrated as `ARCHIVED`, with a `legacy-<ski>` ID and no signer: their last CRL is still served, but never regenerated, and `PUT` returns `409`. There is no API way back to `ACTIVE`. The CRL guide describes the full behavior.",{"_3604":2953,"_31083":2705,"_21524":59897,"_5":14790,"_28264":59258,"_3060":59898},[],"**Custom authorization policies.** The entity `va_role` is renamed to `crl_settings`, with `ca_id` as its primary key and `signer_serial_number` as its relation to certificates. Update policies referencing the old entity. The entity gains the `delete` atomic action, a `signer_key_id` relation to KMS keys, and the filterable columns `signer_engine_id` and `signer_key_id`; grant the new action to whoever may delete archived CRL settings. Replace the 3.8.0 signer filter `crl_subject_key_id_signer` (or `crl_signer_certificate_serial_number` if used by an intermediate version) with `signer_serial_number`. Replace SKI filter values with the corresponding certificate serial numbers; renaming the filter alone is insufficient.",{"_3604":2954,"_31083":2705,"_21524":59900,"_5":14790,"_28264":59262,"_3060":59901},[],"`va.role.update` becomes `va.crl-settings.update` and `va.role.crl.init` becomes `va.crl-settings.init`; `va.role.crl.create` keeps its name and its payload. Every subject changes from `crl/<ski>` to `crl/<ca-id>`, and the payload of the renamed events changes from the old VA role to the CRL settings of the CA, with `ca_id` instead of `ca_ski`. The alerts migration renames the event types of existing subscriptions automatically, but it does not rewrite their conditions — JSON Path, JSON Schema or JavaScript: review conditions that filter on the old payload or on the old `crl/<ski>` subject, including those for `va.role.crl.create`. Direct event-bus consumers and audit searches must adopt the new names and payload themselves.",{"_3604":2955,"_31083":2705,"_21524":59903,"_5":14790,"_28264":59266,"_3060":59904},[],"Creating or importing a CA registers it under a backend-generated UUID. Any `id` sent in the request body is ignored, and the field is removed from the create and import bodies. Scripts that supplied their own IDs and addressed CAs by them must read the ID the backend returns instead.",{"_3604":2956,"_31083":2705,"_21524":59906,"_5":14790,"_28264":59270,"_3060":59907},[],"A CA key now signs only certificates. 3.8.0 let a client sign arbitrary data with a CA key through `POST /v1/cas/{id}/signature/sign` and check the result with `POST /v1/cas/{id}/signature/verify`. 4.0.0 removes both endpoints, the matching `SignatureSign` and `SignatureVerify` methods of the Go SDK `CAService`, and the `ca.sign.signature` event. An alert subscription on that event no longer fires: delete it or move it to another event.",{"_3604":2957,"_31083":2705,"_21524":59909,"_5":14790,"_28264":59270,"_3060":59910},[],"To sign and verify data, use the KMS operations `POST /v1/keys/{id}/sign` and `POST /v1/keys/{id}/verify`, which have their own authorization. Signing a certificate with a CA that is not `ACTIVE` or whose validity period does not include the current time now fails with `400`, even if the stored status has not yet changed to `EXPIRED`: see Certificate authorities.",{"_3604":2958,"_31083":2705,"_21524":59912,"_5":14790,"_28264":59274,"_3060":59913},[],"The VA migration resolves each role's signer from its stored SKI. It first looks for CA certificates with that SKI; if several match, it selects the oldest CA and logs a warning. If no CA certificate matches, it looks among all certificates with that SKI. The migration aborts with `cannot resolve signer certificate for VA role <ca-ski>, SKI <ski>` if that fallback finds zero or multiple candidates. Fix affected roles before upgrading.",{"_3604":2959,"_31083":2705,"_21524":59915,"_5":14790,"_28264":59278,"_3060":59916},[],"The upgrade runs in a fixed order: prepare the data and values, run `helm upgrade`, then copy the KMS and VA data into the new volumes. The copy must run after the upgrade, because the destination StatefulSets and PVCs do not exist before it. If you are not upgrading an existing release, go straight to Install with Helm.",{"_3604":2960,"_31083":2705,"_21524":59918,"_5":14790,"_28264":59282,"_3060":59919},[],"Take a verifiable backup of PostgreSQL and of the CRL object storage — the VA bucket, or the local volume that holds the CRLs — and schedule downtime. The upgrade moves every service's data into `pki`, and the VA migration is irreversible: returning to 3.8.0 needs both backups (see CRL settings keyed by CA ID).",{"_3604":2961,"_31083":2705,"_21524":59921,"_5":14790,"_28264":59282,"_3060":59922},[],"If the deployment runs on SQLite, `couch_db` or `dynamo_db`, move it to PostgreSQL first.",{"_3604":2962,"_31083":2705,"_21524":59924,"_5":14790,"_28264":59282,"_3060":59925},[],"Resolve duplicate CA IDs and backfill `engine_id` in `kms_keys`, as described in PostgreSQL consolidation.",{"_3604":2963,"_31083":2705,"_21524":59927,"_5":14790,"_28264":59282,"_3060":59928},[],"Optionally, run the pre-upgrade check against the consolidated 3.8.0 data before applying the migrations.",{"_3604":2964,"_31083":2705,"_21524":59930,"_5":14790,"_28264":59282,"_3060":59931},[],"Record the names of your local-storage PVCs:",{"_3604":2965,"_31083":2705,"_21524":59933,"_5":14790,"_28264":59282,"_3060":59934},[],"`helm upgrade` does not touch or delete the old PVCs, but nothing references them after the upgrade. You need their names to copy the data and to clean up later.",{"_3604":2966,"_31083":2705,"_21524":59936,"_5":14790,"_28264":59286,"_3060":59937},[],"The 4.0.0 database migrations refuse data they cannot migrate safely: they abort and name the offending objects. The `upgrade-check` tool reports all of those problems before the upgrade, in one run, with the same wording the migration would use. It is read-only: it never writes database rows or keys.",{"_3604":2967,"_31083":2705,"_21524":59939,"_5":14790,"_28264":59286,"_3060":59940},[],"Image: `ghcr.io/lamassuiot/lamassu-upgrade-check`. Configure it with a KMS-style YAML file passed through `LAMASSU_CONFIG_FILE`; only the `postgres` storage provider is supported.",{"_3604":2968,"_31083":2705,"_21524":59942,"_5":14790,"_28264":59286,"_3060":59943},[],"Run it on the 3.8.0 data after it has been consolidated into the `pki` schemas, and before any 4.0.0 migration runs or any 4.0.0 service starts.",{"_3604":2969,"_31083":2705,"_21524":59945,"_5":14790,"_28264":59286,"_3060":59946},[],"Exit codes: `0` means no problems were found, `1` means at least one problem was found, and `2` means the command could not run (bad configuration, unreachable database, or a database that is not a 3.8.0 one), or a check could not run.",{"_3604":2970,"_31083":2705,"_21524":59948,"_5":14790,"_28264":59286,"_3060":59949},[],"It covers the VA migrations only: an all-clear does not prove that the CA and KMS migration guards pass, so it does not replace the duplicate CA ID and `engine_id` checks described in PostgreSQL consolidation.",{"_3604":2971,"_31083":2705,"_21524":59951,"_5":14790,"_28264":59290,"_3060":59952},[],"**Create the credential Secrets.** The 4.0.0 chart reads PostgreSQL, AMQP and SMTP credentials from Kubernetes Secrets, and the pre-upgrade database job needs them before the upgrade runs. Copy the 3.8.0 credentials into your secret-management provider and create the Secrets with the External Secrets Operator (ESO), which the chart does not install:",{"_3604":2972,"_31083":2705,"_21524":59954,"_5":14790,"_28264":59290,"_3060":59955},[],"Configure ESO and its provider (`SecretStore` or `ClusterSecretStore`).",{"_3604":2973,"_31083":2705,"_21524":59957,"_5":14790,"_28264":59290,"_3060":59958},[],"Create an `ExternalSecret` for each credential set you use. Its target Secret must live in the release namespace, be named after the corresponding `existingSecret` value, and contain these keys:",{"_3604":2974,"_31083":2705,"_21524":59960,"_5":14790,"_28264":59290,"_3060":59961},[],"Secret (`existingSecret`)",{"_3604":2975,"_31083":2705,"_21524":59963,"_5":14790,"_28264":59290,"_3060":59964},[],"Required data keys",{"_3604":2976,"_31083":2705,"_21524":59966,"_5":14790,"_28264":59290,"_3060":59967},[],"When",{"_3604":2977,"_31083":2705,"_21524":59969,"_5":14790,"_28264":59290,"_3060":59970},[],"`lamassu-postgres` (default of `postgres.existingSecret`)",{"_3604":2978,"_31083":2705,"_21524":59972,"_5":14790,"_28264":59290,"_3060":59973},[],"`username`, `password`",{"_3604":2979,"_31083":2705,"_21524":59975,"_5":14790,"_28264":59290,"_3060":59976},[],"Always",{"_3604":2980,"_31083":2705,"_21524":59978,"_5":14790,"_28264":59290,"_3060":59979},[],"`lamassu-amqp` (default of `amqp.existingSecret`)",{"_3604":2981,"_31083":2705,"_21524":59981,"_5":14790,"_28264":59290,"_3060":59973},[],{"_3604":2982,"_31083":2705,"_21524":59983,"_5":14790,"_28264":59290,"_3060":59976},[],{"_3604":2983,"_31083":2705,"_21524":59985,"_5":14790,"_28264":59290,"_3060":59986},[],"`services.alerts.smtp_server.existingSecret`",{"_3604":2984,"_31083":2705,"_21524":59988,"_5":14790,"_28264":59290,"_3060":59973},[],{"_3604":2985,"_31083":2705,"_21524":59990,"_5":14790,"_28264":59290,"_3060":59991},[],"Only when SMTP authentication is enabled",{"_3604":2986,"_31083":2705,"_21524":59993,"_5":14790,"_28264":59290,"_3060":59994},[],"Wait for every `ExternalSecret` to be Ready and verify the generated Secrets before running the upgrade.",{"_3604":2987,"_31083":2705,"_21524":59996,"_5":14790,"_28264":59290,"_3060":59997},[],"Do not change the database or broker passwords as part of this migration: ESO synchronizes credentials into Secrets, but it does not update the users configured on the PostgreSQL server or the broker. Removing credentials from the values file does not undo past exposure — if they were ever committed to Git, rotate them after the migration is complete.",{"_3604":2988,"_31083":2705,"_21524":59999,"_5":14790,"_28264":59290,"_3060":60000},[],"The `charts/lamassu/README.md` in the Helm repository documents a full worked example in its *Secret management* section: installing external-secrets 0.20.2, a test Fake `ClusterSecretStore`, the `ExternalSecret` resources and the wait for synchronization. Its Fake provider is for testing only; for production, replace it with your provider's configuration.",{"_3604":2989,"_31083":2705,"_21524":60002,"_5":14790,"_28264":59290,"_3060":60003},[],"**Add `services.authz`.** Configure the JWKS endpoint, the database mappings and the bootstrap principal:",{"_3604":2990,"_31083":2705,"_21524":60005,"_5":14790,"_28264":59290,"_3060":60006},[],"`jwkUrl` is fetched from the `authz` pod, not from the gateway, so a Service in the release namespace can be referenced by its short name. The default points at a Keycloak Service named `auth-keycloak`; set it explicitly if your identity provider lives anywhere else.",{"_3604":2991,"_31083":2705,"_21524":60008,"_5":14790,"_28264":59290,"_3060":60009},[],"`authz` is the authorization service's own storage for principals, grants and policies. `pki` is the database the authorization engine queries when it evaluates policies against entities. Only the `database` field of each entry is required; per-schema `hostname` and `port` values remain accepted but are ignored — the connection always uses the global `postgres.hostname` and `postgres.port` with the global PostgreSQL credential Secret, `postgres.existingSecret` with its configured key names, unless the entry sets its own `existingSecret` (with optional `usernameKey` and `passwordKey`).",{"_3604":2992,"_31083":2705,"_21524":60011,"_5":14790,"_28264":59290,"_3060":60012},[],"If you kept the 3.8.0 role defaults (`realm_access.roles` and `pki-admin`), the default `services.authz.bootstrap` already matches them.",{"_3604":2993,"_31083":2705,"_21524":60014,"_5":14790,"_28264":59290,"_3060":60015},[],"**Delete the gateway token validation blocks.** Remove `auth.oidc.apiGateway` and `auth.authorization` once their settings are in `services.authz`:",{"_3604":2994,"_31083":2705,"_21524":60017,"_5":14790,"_28264":59290,"_3060":60018},[],"**Rename `toolbox` to `connectivityTest`:**",{"_3604":2995,"_31083":2705,"_21524":60020,"_5":14790,"_28264":59290,"_3060":60021},[],"**Remove the per-service identity overrides** `services.kms.securityContext.runAsGroup` and `services.authz.securityContext.runAsUser`/`runAsGroup`.",{"_3604":2996,"_31083":2705,"_21524":60023,"_5":14790,"_28264":59290,"_3060":60024},[],"**Convert `services.connectors` to a map** keyed by connector ID, each entry with its `type` and `image`:",{"_3604":2997,"_31083":2705,"_21524":60026,"_5":14790,"_28264":59290,"_3060":60027},[],"**Check AMQP.** If you set `amqp.tls: true`, also set `amqp.port` to the broker's TLS listener (commonly `5671`), or set `amqp.tls: false` to stay on plaintext.",{"_3604":2998,"_31083":2705,"_21524":60029,"_5":14790,"_28264":59290,"_3060":60030},[],"**Enable the CA-to-KMS migration** if your CA keys predate the KMS:",{"_3604":2999,"_31083":2705,"_21524":60032,"_5":14790,"_28264":59290,"_3060":60033},[],"**Review the remaining values:** overrides that pinned `services.ui.port` to `80`, the old `probes:` block, the TLS issuer, and explicit `affinity` and `topologySpreadConstraints` where your cluster needs them. Renamed and reshaped values describes each one.",{"_3604":3000,"_31083":2705,"_21524":60035,"_5":14790,"_28264":59290,"_3060":60036},[],"Run `helm lint` with the new values before upgrading; the strict schema reports any key that is still unknown. Before running Step 3, confirm every credential `ExternalSecret` is Ready and the generated Secrets contain the expected keys.",{"_3604":3001,"_31083":2705,"_21524":60038,"_5":14790,"_28264":59294,"_3060":60039},[],"Helm runs the pre-upgrade hooks — the CA-to-KMS migration when enabled, and the database job — before applying any workload, so services never start against an unprepared database. If validation rejects unknown values, fix the values file and re-run.",{"_3604":3002,"_31083":2705,"_21524":60041,"_5":14790,"_28264":59294,"_3060":60042},[],"If the deployment uses local KMS or VA storage, those pods fail until you complete step 4, so `--wait` cannot succeed: Helm waits for them to become ready, times out, exits with an error and marks the release `failed`. The hooks have already run by then, and every manifest, including the new StatefulSets and their PVCs, has been applied. Helm does not roll anything back without `--atomic`. Continue with step 4, then re-run the same `helm upgrade` command so it completes and Helm records the release as `deployed`. Both hooks are idempotent, so they are safe to run again.",{"_3604":3003,"_31083":2705,"_21524":60044,"_5":14790,"_28264":59298,"_3060":60045},[],"Skip this step when `services.kms.cryptoEngines` never used a `filesystem` engine and `services.va.fileStore.type` was never `local`.",{"_3604":3004,"_31083":2705,"_21524":60047,"_5":14790,"_28264":59298,"_3060":60048},[],"**Find the new StatefulSets and PVCs.** Their names depend on the release name and any `nameOverride` or `fullnameOverride`; the PVC name is `<volumeClaimTemplate>-<StatefulSet name>-0`:",{"_3604":3005,"_31083":2705,"_21524":60050,"_5":14790,"_28264":59298,"_3060":60051},[],"With release `lamassu` and the default chart name, the new PVCs are `golang-engine-storage-lamassu-kms-0` and `local-crl-file-storage-lamassu-va-0`; with release `prod` they are `golang-engine-storage-prod-lamassu-kms-0` and `local-crl-file-storage-prod-lamassu-va-0`. Confirm both old and new PVCs exist before continuing. If `claims_ok` prints `ABORT`, the block stops before listing the claims: either a StatefulSet lookup failed, or a new claim resolves to the 3.8.0 claim. In the second case the copy would verify against itself and the final cleanup would delete the live volume. The chart always appends `-kms` and `-va` to the release-scoped name, so a collision means the claims are not what this guide expects; investigate before going on. Item 3 runs the same check and refuses to create the helper pod, so nothing touches the volumes. The check returns instead of calling `exit`, which would close your shell and lose the variables set so far. If you only migrate one of the two services, drop the other one's claims from the commands that follow.",{"_3604":3006,"_31083":2705,"_21524":60053,"_5":14790,"_28264":59298,"_3060":60054},[],"**Record the replica counts, scale the new StatefulSets down and wait for every pod that uses the claims to exit**, so nothing writes to either volume while you copy. Helm removes the 3.8.0 `kms` and `va` StatefulSets during the upgrade, but their pods `kms-0` and `va-0` can still be terminating and holding the old claims. While they run, the helper pod either cannot attach the claims or copies a volume that is still being written. The `wait` returns at once for pods that are already gone:",{"_3604":3007,"_31083":2705,"_21524":60056,"_5":14790,"_28264":59298,"_3060":60057},[],"**Run a short-lived helper pod** that mounts all four claims. It runs as root so it can change file ownership, so pin its image by digest and do not mount the service-account token:",{"_3604":3008,"_31083":2705,"_21524":60059,"_5":14790,"_28264":59298,"_3060":60060},[],"**Inspect before writing** so you do not clobber data the new pods may already have written:",{"_3604":3009,"_31083":2705,"_21524":60062,"_5":14790,"_28264":59298,"_3060":60063},[],"An empty result is the common case: a StatefulSet's own pod rarely gets far enough to write anything when its dependent data is missing. If the output is not empty, record the files and confirm with the service owner that they are disposable before you run the copy; do not overlay the 3.8.0 data onto an unknown store.",{"_3604":3010,"_31083":2705,"_21524":60065,"_5":14790,"_28264":59298,"_3060":60066},[],"**Copy the data, align ownership and verify the copy.** The second command must print `copy verified`; any `diff` output means the copy is incomplete, so do not continue:",{"_3604":3011,"_31083":2705,"_21524":60068,"_5":14790,"_28264":59298,"_3060":60069},[],"The `chown` is required even if the old files already look non-root-owned, because 4.0.0 requires exactly `65532:65532` and does not fall back to whatever the image declares.",{"_3604":3012,"_31083":2705,"_21524":60071,"_5":14790,"_28264":59298,"_3060":60072},[],"**Remove the helper and restore the recorded replica counts:**",{"_3604":3013,"_31083":2705,"_21524":60074,"_5":14790,"_28264":59298,"_3060":60075},[],"**Re-run the step 3 `helm upgrade` command.** The KMS and VA pods now start against the copied data, so `--wait` succeeds and the release moves from `failed` to `deployed`.",{"_3604":3014,"_31083":2705,"_21524":60077,"_5":14790,"_28264":59302,"_3060":60078},[],"After the upgrade that performed the CA-to-KMS migration succeeds, remove `migrations.caToKms.enabled` from your values (it defaults to `false`). The hook reads the legacy 3.8.0 `kms-config` ConfigMap while it still exists and falls back to the release-scoped `<release>-lamassu-kms-config` once it is gone.",{"_3604":3015,"_31083":2705,"_21524":60080,"_5":14790,"_28264":59302,"_3060":60081},[],"Then go through the validation checklist. Keep the old PVCs until it passes.",{"_3604":3016,"_31083":2705,"_21524":60083,"_5":14790,"_28264":59306,"_3060":60084},[],"Without the chart's database job, no tool moves data between databases: the migration tooling only applies migrations to a schema that already exists. Move each per-service database into its `pki` schema yourself, preserving structure, indexes, constraints, data and migration history, with writes stopped and a verified backup in hand.",{"_3604":3017,"_31083":2705,"_21524":60086,"_5":14790,"_28264":59306,"_3060":60087},[],"Run the migrations in the required order, one schema at a time: `kms` first, then the `ca-to-kms-migration` tool (needed only for legacy deployments whose CA keys are named by SKI), then `ca`, then `va`. The `devicemanager`, `dmsmanager` and `alerts` schemas are independent and can be migrated in any order. With Helm, the chart's pre-install job applies the schemas in the correct order automatically.",{"_3604":3018,"_31083":2705,"_21524":60089,"_5":14790,"_28264":59306,"_3060":60090},[],"If `kms` has not been migrated, the `ca` migration fails with `kms schema not found: migrate the kms schema before the ca schema`. The `va` migration requires `ca` and `kms` to be migrated first: it fails with `ca schema not found: migrate the ca schema before the va schema` or `kms schema not found: migrate the kms schema before the va schema` if one of them is missing.",{"_3604":3019,"_31083":2705,"_21524":60092,"_5":14790,"_28264":59306,"_3060":60093},[],"The schemas reference each other, so the PostgreSQL role running the migrations needs cross-schema privileges: the `ca` schema needs `USAGE` on `kms` plus `SELECT`, `REFERENCES` and `INSERT` on `kms.kms_keys`, and the `va` schema needs `USAGE` on `ca` plus `SELECT` and `REFERENCES` on `ca.certificates`, `SELECT` on `ca.ca_certificates`, and `USAGE` on `kms` plus `SELECT` and `REFERENCES` on `kms.kms_keys`. Without them the migration aborts; grant the missing privileges and rerun the failed schema. After migrating `ca`, if the CA service runs as a different user than the migration user, grant it `SELECT` on `ca.certificates_view` (`GRANT SELECT ON ca.certificates_view TO service_user`). Without this grant, certificate and CA reads fail with `permission denied for table certificates_view`. After migrating `va`, if the CA service runs as a different user, grant it `USAGE` on the `va` schema and `SELECT` on `va.crl_settings` (`GRANT USAGE ON SCHEMA va TO service_user; GRANT SELECT ON va.crl_settings TO service_user`): the CA service reads `va.crl_settings` when it deletes a CA, and without these grants every deletion of a CA that has a crypto engine fails with `permission denied for schema va` (or `for table crl_settings`).",{"_3604":3020,"_31083":2705,"_21524":60095,"_5":14790,"_28264":59306,"_3060":60096},[],"To apply migrations by hand, `goose-lamassu` must run against the `pki` database with `search_path=<schema>` in the connection string. The binary validates only `search_path`, not the database name, so check `dbname=pki` before running it, and repeat for `kms`, `ca`, `va`, `devicemanager`, `dmsmanager` and `alerts`:",{"_3604":3021,"_31083":2705,"_21524":60098,"_5":14790,"_28264":59306,"_3060":60099},[],"Run `ca-to-kms-migration` first with `--dry-run`, which reports without writing to KMS storage, and then for real:",{"_3604":3022,"_31083":2705,"_21524":60101,"_5":14790,"_28264":59306,"_3060":60102},[],"Point the tool's `storage` configuration at the `pki` database, where the CA and KMS data now live in the `ca` and `kms` schemas. The tool's options are described in `backend/cmd/ca-to-kms-migration/README.md` in the `lamassuiot` repository.",{"_3604":3023,"_31083":2705,"_21524":60104,"_5":14790,"_28264":59306,"_3060":60105},[],"Both tools' READMEs document the 4.0.0 `pki` layout and match this page: `goose-lamassu` uses `dbname=pki` examples and does not validate the database name, and the `ca-to-kms-migration` README describes the single `pki` database and the migration order.",{"_3604":3024,"_31083":2705,"_21524":60107,"_5":14790,"_28264":59310,"_3060":60108},[],"**KMS or VA pods crash with `no such file or directory` or `code=NotFound` right after the upgrade.** The pods are bound to the new, empty PVCs and the data migration has not run yet, or was copied into the wrong PVC. Follow step 4 and check that all four claims exist.",{"_3604":3025,"_31083":2705,"_21524":60110,"_5":14790,"_28264":59310,"_3060":60111},[],"**`helm upgrade --wait` times out and `helm status` reports the release as `failed`.** With local KMS or VA storage this is expected on the first run: the new pods cannot become ready before their data is copied. The hooks ran and the manifests and PVCs were applied, so complete step 4 and re-run the same `helm upgrade` command. If other pods are also not ready, check their logs, because something else is wrong.",{"_3604":3026,"_31083":2705,"_21524":60113,"_5":14790,"_28264":59310,"_3060":60114},[],"**The helper pod stays `Pending` or `ContainerCreating` and `kubectl wait` times out.** Another pod still holds one of the claims; on block storage `kubectl describe pod pvc-migrate-helper` shows a `Multi-Attach error`. Check with `kubectl get pods -n $NAMESPACE` that `kms-0`, `va-0` and the new KMS and VA pods are gone, then re-run the wait.",{"_3604":3027,"_31083":2705,"_21524":60116,"_5":14790,"_28264":59310,"_3060":60117},[],"**`helm upgrade` fails with an unknown-key validation error.** Remove or rename the legacy values — typically `toolbox`, `auth.oidc.apiGateway` or `auth.authorization` — because the strict schema rejects keys it does not know.",{"_3604":3028,"_31083":2705,"_21524":60119,"_5":14790,"_28264":59310,"_3060":60120},[],"**The upgrade fails at the database job.** The PostgreSQL role cannot create databases or schemas, or a schema migration aborted: on duplicate CA IDs or missing `engine_id` values, or in the VA schema on a CA ID containing `/`, an SKI shared by more than one CA (the error asks you to recreate all but one of them on a different key), a role whose signer certificate has no key, a CA ID reserved for the archived settings of another role, or a CA ID equal to another role's SKI. The abort message names the offending objects; fix them and re-run the upgrade.",{"_3604":3029,"_31083":2705,"_21524":60122,"_5":14790,"_28264":59310,"_3060":60123},[],"**The upgrade fails at the CA-to-KMS hook.** CA certificates that share a `subject_key_id` declare conflicting `engine_id`s. Resolve the conflict and re-run.",{"_3604":3030,"_31083":2705,"_21524":60125,"_5":14790,"_28264":59310,"_3060":60126},[],"**Nobody can log in after the upgrade.** Check that `services.authz.jwkUrl` is reachable from the `authz` pod, that `services.authz.bootstrap` matches a role your OIDC provider actually assigns, and that the database job completed.",{"_3604":3031,"_31083":2705,"_21524":60128,"_5":14790,"_28264":59310,"_3060":60129},[],"**A migration aborts with `kms schema not found`.** The schemas must be migrated in order: run the `kms` schema migration before the `ca` and `va` schema migrations.",{"_3604":3032,"_31083":2705,"_21524":60131,"_5":14790,"_28264":59310,"_3060":60132},[],"**A migration aborts with `ca schema not found`.** Run the `ca` schema migration before the `va` schema migration.",{"_3604":3033,"_31083":2705,"_21524":60134,"_5":14790,"_28264":59310,"_3060":60135},[],"**The VA migration fails with `cannot resolve signer certificate for VA role ... N candidates`.** The migration cannot uniquely identify a signer certificate from the SKI stored on the role. Review the SKI and candidate certificates reported in the error; correct the pre-migration data with a verified backup and rerun the migration. The new `signer_serial_number` field is created during that migration, so it cannot be set through the VA API while the migration is failing.",{"_3604":3034,"_31083":2705,"_21524":60137,"_5":14790,"_28264":59310,"_3060":60138},[],"**A migration or service fails with `permission denied for table ...` or `permission denied for schema ...`.** The PostgreSQL role is missing the cross-schema privileges listed in Deployments without Helm; this includes `certificates_view` when the post-migration `GRANT SELECT` was skipped, and `permission denied for schema va` (or `for table crl_settings`) when deleting a CA without the `va` grants. Grant the missing privileges and re-run.",{"_3604":3035,"_31083":2705,"_21524":60140,"_5":14790,"_28264":59313,"_3060":60141},[],"After the upgrade, check in this order:",{"_3604":3036,"_31083":2705,"_21524":60143,"_5":14790,"_28264":59313,"_3060":60144},[],"**Databases.** Each service reads the `pki` database with its own schema, `authz` and `wfx` data are reachable, and the migration status is registered per schema, including the CA unique-ID and KMS composite-key migrations and the foreign-key migrations that run per schema in the required order.",{"_3604":3037,"_31083":2705,"_21524":60146,"_5":14790,"_28264":59313,"_3060":60147},[],"**KMS and VA start cleanly.** Their logs show no `no such file or directory` or `code=NotFound` errors.",{"_3604":3038,"_31083":2705,"_21524":60149,"_5":14790,"_28264":59313,"_3060":60150},[],"**Existing KMS keys work.** Issue a certificate from a CA that existed before the upgrade. None of the other checks reads a KMS key, so this is the only one that proves the key material was copied.",{"_3604":3039,"_31083":2705,"_21524":60152,"_5":14790,"_28264":59313,"_3060":60153},[],"**Existing CRLs are served.** `GET /crl/<ca-id>` on VA returns a previously issued CRL, and `GET /crl/<ca-ski>` with the legacy SKI of a certificate issued before the upgrade also resolves. The VA scheduled CRL job has issued a new list under the CA ID with both URLs in its IDP; check its logs if regeneration has not succeeded.",{"_3604":3040,"_31083":2705,"_21524":60155,"_5":14790,"_28264":59313,"_3060":60156},[],"**Renamed VA events.** Alert subscriptions to `va.role.update` and `va.role.crl.init` now subscribe to `va.crl-settings.update` and `va.crl-settings.init`, and conditions for all VA events, including `va.role.crl.create`, have been reviewed against the new payload (`ca_id` instead of `ca_ski`) and subject (`crl/<ca-id>` instead of `crl/<ski>`). Direct consumers and audit searches use the new event names.",{"_3604":3041,"_31083":2705,"_21524":60158,"_5":14790,"_28264":59313,"_3060":60159},[],"**Legacy CA keys.** If the CA-to-KMS migration ran, review its report and warnings and confirm the expected keys appear in the KMS. Migrated CA certificates now report `key_id` and `has_private_key`, which you can use to confirm the registration.",{"_3604":3042,"_31083":2705,"_21524":60161,"_5":14790,"_28264":59313,"_3060":60162},[],"**Connectivity.** `helm test \"$RELEASE\" -n $NAMESPACE --logs` passes; the hook checks the CA, DMS Manager, Device Manager and VA health endpoints and the UI response.",{"_3604":3043,"_31083":2705,"_21524":60164,"_5":14790,"_28264":59313,"_3060":60165},[],"**Authorization.** Sign in as the bootstrap principal and confirm administration works, check that an identity without permissions receives `403`, and review client and integration permissions.",{"_3604":3044,"_31083":2705,"_21524":60167,"_5":14790,"_28264":59313,"_3060":60168},[],"**AMQP.** The backend connects to the broker with the expected TLS settings, and the cleanup policy for SSE queues is in place.",{"_3604":3045,"_31083":2705,"_21524":60170,"_5":14790,"_28264":59313,"_3060":60171},[],"**Device events.** `GET /v1/devices/:id/events` returns the historical events of a device that had them.",{"_3604":3046,"_31083":2705,"_21524":60173,"_5":14790,"_28264":59313,"_3060":60174},[],"**Webhooks without file fields.** For each DMS that uses a webhook for enrollment or re-enrollment, the `config` block carries `insecure_skip_verify` and the expected option block (`apikey_options`, `jwt_options` or `mtls_options`), with the certificate and key as PEM and no `cert_file` or `key_file`.",{"_3604":3047,"_31083":2705,"_21524":60176,"_5":14790,"_28264":59313,"_3060":60177},[],"**Receiver verification.** `insecure_skip_verify` is `false`, unless the receiver certificate is intentionally unverified.",{"_3604":3048,"_31083":2705,"_21524":60179,"_5":14790,"_28264":59313,"_3060":60180},[],"**Webhook delivery.** One enroll or re-enroll through each migrated webhook completes its authorization call.",{"_3604":3049,"_31083":2705,"_21524":60182,"_5":14790,"_28264":59313,"_3060":60183},[],"**Trust set.** `est_rfc7030_settings.client_certificate_settings.validation_cas` holds the expected CAs, in particular those of the old CA during rotation overlaps.",{"_3604":3050,"_31083":2705,"_21524":60185,"_5":14790,"_28264":59313,"_3060":60186},[],"**API clients.** Scripts and consoles no longer use the old DMS layout (flat `additional_validation_cas`, or the legacy `mtls`, `apikey` and `oidc` fields), send DMS updates with the ID in the URL, and match on the new certificate `type` values.",{"_3604":3051,"_31083":2705,"_21524":60188,"_5":14790,"_28264":59317,"_3060":60189},[],"Only once every check passes, delete the orphaned 3.8.0 volumes to reclaim storage. The delete is irreversible and the old KMS volume may hold the last copy of your CA key material, so take a `VolumeSnapshot` or a backup of both old PVCs first and keep it until you are confident the upgraded deployment is healthy. These are the fixed 3.8.0 names recorded in step 1; before deleting, confirm that neither is mounted by a running pod, for example with `kubectl describe pvc -n $NAMESPACE golang-engine-storage-kms-0 local-crl-file-storage-va-0`, where `Used By` must be `<none>`:",{"_3604":3052,"_31083":2705,"_21524":60191,"_5":14790,"_28264":59317,"_3060":60192},[],"The 3.8.0 per-service databases are no longer used either. Drop them only after the same checks pass and your PostgreSQL backup is verified.",{"_3604":3053,"_31083":2705,"_21524":60194,"_5":14790,"_28264":59317,"_3060":60195},[],"<Card title=\"Install with Helm\" description=\"Prepare dependencies, configure values and install a controlled deployment.\" href=\"/docs/deployment/self-hosted/helm\" />",{"_3604":3054,"_31083":2705,"_21524":60197,"_5":14790,"_28264":59317,"_3060":60198},[],"<Card title=\"Access control\" description=\"Principals, policies and the first administrator.\" href=\"/docs/platform/administration/access-control\" />",{"_3604":3055,"_31083":2705,"_21524":60200,"_5":14790,"_28264":59317,"_3060":60201},[],"<Card title=\"Configure a DMS\" description=\"Enrollment, re-enrollment and webhook settings.\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />","sorting",{"_60204":60205,"_60206":60207,"_60208":60209,"_60210":60211,"_18649":3095,"_72389":3095},"language","english","sortableProperties",[3060,31083,5,28264],"sortablePropertiesWithTypes",{"_3060":25699,"_31083":25699,"_5":25699,"_28264":25699},"sorts",{"_3060":60212,"_31083":63257,"_5":66301,"_28264":69345},{"_4802":60213,"_60214":60215,"_5":25699},{"_14871":6177,"_15250":11094,"_15269":3125,"_30082":5326,"_15256":3867,"_20431":5293,"_14892":5337,"_14899":8118,"_30024":5358,"_30438":4219,"_30459":17176,"_30058":4638,"_35450":5109,"_30161":7771,"_30503":5098,"_35457":30674,"_35460":6863,"_35463":26706,"_35466":6817,"_30905":11309,"_35471":13289,"_35473":4321,"_30940":8946,"_15265":3351,"_35477":3449,"_35480":7445,"_35482":6408,"_30487":3272,"_30925":3559,"_30953":5155,"_35487":10407,"_35489":29599,"_35491":6199,"_30178":3160,"_35494":7197,"_35496":3898,"_35498":10157,"_35500":3785,"_35502":8860,"_30095":6772,"_35505":7505,"_35507":3459,"_30089":18042,"_30524":20934,"_35511":3310,"_35513":7441,"_35516":10972,"_30135":17506,"_35520":5128,"_30015":17777,"_35523":6046,"_30063":3478,"_35526":4555,"_35528":11308,"_35531":7886,"_15259":5111,"_35534":7271,"_35536":10495,"_35539":3558,"_35541":16051,"_35543":11667,"_35545":7911,"_35547":10406,"_20434":5346,"_35550":7740,"_35552":6144,"_30036":4911,"_30481":5347,"_35556":4770,"_35558":4354,"_35560":5220,"_30970":6507,"_35563":11942,"_35565":6240,"_35567":4881,"_31063":12663,"_30540":9677,"_35571":4586,"_35573":3368,"_30073":6587,"_35576":9369,"_35578":17189,"_35580":24261,"_30986":6375,"_30155":10773,"_29535":4939,"_35585":6518,"_35587":4884,"_35589":6712,"_30204":22299,"_35593":7671,"_30475":16248,"_35597":10758,"_35599":4462,"_35601":14714,"_35603":5211,"_35605":3385,"_35607":12697,"_30193":4330,"_30443":24900,"_35611":3902,"_35613":21959,"_35615":15128,"_35618":3515,"_35620":4331,"_35622":9342,"_35624":17305,"_35626":17337,"_35628":9106,"_35630":21473,"_35633":5314,"_35635":3395,"_35637":3775,"_35639":4925,"_35641":12364,"_35644":3322,"_35646":6194,"_35649":3169,"_35652":7311,"_35654":20736,"_35656":7837,"_35658":4537,"_35660":7146,"_35662":50720,"_35664":7753,"_35666":4830,"_35668":3360,"_30486":6206,"_35671":5101,"_35673":16232,"_35675":8698,"_35677":4109,"_35679":3976,"_35681":5929,"_35683":6500,"_35685":3524,"_35687":3379,"_35689":5187,"_35691":6989,"_35693":3464,"_35695":4829,"_35697":3937,"_35699":5475,"_35701":6000,"_35703":6131,"_35705":5114,"_35707":4107,"_35709":3097,"_35711":8317,"_35713":5147,"_35715":7135,"_35717":13197,"_35719":5100,"_35721":14715,"_35723":8279,"_35725":4108,"_35727":6352,"_35729":4227,"_35731":5099,"_35733":7196,"_35735":13666,"_35737":4105,"_35739":8537,"_35741":7842,"_35743":7378,"_35745":7852,"_35747":26823,"_30480":4857,"_35750":8228,"_35752":5328,"_35754":4106,"_35756":4858,"_35758":6451,"_3576