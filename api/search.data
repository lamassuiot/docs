352":87919,"_29354":87922,"_29356":87925,"_29358":87928,"_29360":87931,"_29362":87934,"_29364":87937,"_29366":87940,"_29368":87943,"_29370":87946,"_29372":87949,"_29374":87952,"_29376":87955,"_29378":87958,"_29380":87961,"_29382":87964,"_29384":87967,"_29386":87970,"_29388":87973,"_29390":87976,"_29392":87979,"_29394":87982,"_29396":87985,"_29398":87988,"_29400":87991,"_29402":87994,"_29404":87997,"_29406":88000,"_29408":88003,"_29410":88006,"_29412":88009,"_29414":88012,"_29416":88015,"_29418":88018,"_29420":88021,"_29422":88024,"_29424":88027,"_29426":88030,"_29428":88033,"_29430":88036,"_29432":88039,"_29434":88042,"_29436":88045,"_29438":88048,"_29440":88051,"_29442":88054,"_29444":88057,"_29446":88060,"_29448":88063,"_29450":88066,"_29452":88069,"_29454":88072,"_29456":88075,"_29458":88078,"_29460":88080,"_29462":88082,"_29464":88085,"_29466":88088,"_29468":88091,"_29470":88093,"_29472":88095,"_29474":88097,"_29476":88099},{"_2299":48583,"_22571":48583,"_5":10616,"_1890":82311,"_22830":82312,"_15405":82315,"_21315":48583},"Despliega desde AWS Marketplace",[35156,82313,82314],"Despliegue","Otros modelos",[],{"_2299":48584,"_22571":48583,"_15405":82317,"_5":15294,"_21315":48583,"_1890":82318},[],"Ejecuta una instancia preconfigurada de Lamassu IoT en Amazon EC2.",{"_2299":48585,"_22571":48583,"_5":22827,"_15405":82320,"_21315":82321,"_1890":82322},[],"/docs/es/deployment/aws-marketplace#antes-de-empezar","Antes de empezar",{"_2299":48586,"_22571":48583,"_5":22827,"_15405":82324,"_21315":82325,"_1890":82326},[],"/docs/es/deployment/aws-marketplace#requisitos-de-infraestructura","Requisitos de infraestructura",{"_2299":48587,"_22571":48583,"_5":22827,"_15405":82328,"_21315":82329,"_1890":82330},[],"/docs/es/deployment/aws-marketplace#abre-la-oferta","Abre la oferta",{"_2299":48588,"_22571":48583,"_5":22827,"_15405":82332,"_21315":82333,"_1890":82334},[],"/docs/es/deployment/aws-marketplace#configura-la-instancia","Configura la instancia",{"_2299":48589,"_22571":48583,"_5":22827,"_15405":82336,"_21315":82337,"_1890":82338},[],"/docs/es/deployment/aws-marketplace#limita-el-acceso-de-red","Limita el acceso de red",{"_2299":48590,"_22571":48583,"_5":22827,"_15405":82340,"_21315":82341,"_1890":82342},[],"/docs/es/deployment/aws-marketplace#lanza-y-verifica","Lanza y verifica",{"_2299":48591,"_22571":48583,"_5":22827,"_15405":82344,"_21315":82345,"_1890":82346},[],"/docs/es/deployment/aws-marketplace#siguiente-paso","Siguiente paso",{"_2299":48592,"_22571":48583,"_15405":82348,"_5":15294,"_21315":48583,"_1890":82349},[],"La oferta de AWS Marketplace reduce la preparación inicial a una instancia EC2 dentro de tu cuenta. Tú mantienes el control de la red, el almacenamiento y la operación de la máquina.",{"_2299":48593,"_22571":48583,"_15405":82351,"_5":15294,"_21315":82321,"_1890":82352},[],"Permisos para suscribirte a productos de AWS Marketplace y lanzar instancias EC2.",{"_2299":48594,"_22571":48583,"_15405":82354,"_5":15294,"_21315":82321,"_1890":82355},[],"Una VPC y una subred desde la que puedan acceder administradores y dispositivos.",{"_2299":48595,"_22571":48583,"_15405":82357,"_5":15294,"_21315":82321,"_1890":82358},[],"Un grupo de seguridad que permita los endpoints necesarios.",{"_2299":48596,"_22571":48583,"_15405":82360,"_5":15294,"_21315":82325,"_1890":82361},[],"**Cómputo:** una instancia `t3.large` como mínimo. Utiliza `t3.xlarge` o superior cuando la carga lo requiera.",{"_2299":48597,"_22571":48583,"_15405":82363,"_5":15294,"_21315":82325,"_1890":82364},[],"**Almacenamiento:** un volumen EBS `gp3` de al menos 50 GB, ajustado al tamaño del inventario y la retención.",{"_2299":48598,"_22571":48583,"_15405":82366,"_5":15294,"_21315":82325,"_1890":82367},[],"**Red:** acceso HTTPS desde los consumidores necesarios, restringido a redes de confianza.",{"_2299":48599,"_22571":48583,"_15405":82369,"_5":15294,"_21315":82329,"_1890":82370},[],"Accede a Lamassu IoT en AWS Marketplace y revisa las condiciones antes de suscribirte.",{"_2299":48600,"_22571":48583,"_15405":82372,"_5":15294,"_21315":82333,"_1890":82373},[],"Selecciona `t3.large` o superior, asigna al menos 50 GB de almacenamiento `gp3` y elige la VPC y subred de destino.",{"_2299":48601,"_22571":48583,"_15405":82375,"_5":15294,"_21315":82337,"_1890":82376},[],"Configura el grupo de seguridad para los puertos `443`, `8443` y `9443`. Restringe los orígenes a las redes administrativas y de dispositivos que realmente necesiten conectarse.",{"_2299":48602,"_22571":48583,"_15405":82378,"_5":15294,"_21315":82341,"_1890":82379},[],"Inicia la instancia y abre la consola en `https://<ip-publica>`. Comprueba que puedes autenticarte antes de continuar.",{"_2299":48603,"_22571":48583,"_15405":82381,"_5":15294,"_21315":82345,"_1890":82382},[],"Continúa con Crea tu primera CA para validar la configuración criptográfica de la instancia.",{"_2299":48604,"_22571":48604,"_5":10616,"_1890":82384,"_22830":82385,"_15405":82386,"_21315":48604},"Despliega Lamassu",[35156,82313],[],{"_2299":48605,"_22571":48604,"_15405":82388,"_5":15294,"_21315":48604,"_1890":82389},[],"Elige el modelo operativo que encaja con tu infraestructura y requisitos de control.",{"_2299":48606,"_22571":48604,"_5":22827,"_15405":82391,"_21315":82392,"_1890":82393},[],"/docs/es/deployment/overview#elige-un-modelo","Elige un modelo",{"_2299":48607,"_22571":48604,"_5":22827,"_15405":82395,"_21315":82396,"_1890":82397},[],"/docs/es/deployment/overview#solo-quieres-evaluar-la-plataforma","¿Solo quieres evaluar la plataforma?",{"_2299":48608,"_22571":48604,"_5":22827,"_15405":82399,"_21315":82400,"_1890":82401},[],"/docs/es/deployment/overview#después-del-despliegue","Después del despliegue",{"_2299":48609,"_22571":48604,"_15405":82403,"_5":15294,"_21315":48604,"_1890":82404},[],"Puedes ejecutar Lamassu en tu propio clúster Kubernetes, desplegar una imagen preparada desde AWS Marketplace o consumir la plataforma como servicio gestionado.",{"_2299":48610,"_22571":48604,"_15405":82406,"_5":15294,"_21315":82392,"_1890":82407},[],"Modelo",{"_2299":48611,"_22571":48604,"_15405":82409,"_5":15294,"_21315":82392,"_1890":82410},[],"Recomendado para",{"_2299":48612,"_22571":48604,"_15405":82412,"_5":15294,"_21315":82392,"_1890":82413},[],"Quién opera la infraestructura",{"_2299":48613,"_22571":48604,"_15405":82415,"_5":15294,"_21315":82392,"_1890":82416},[],"Punto de partida",{"_2299":48614,"_22571":48604,"_15405":82418,"_5":15294,"_21315":82392,"_1890":35263},[],{"_2299":48615,"_22571":48604,"_15405":82420,"_5":15294,"_21315":82392,"_1890":82421},[],"Producción, entornos regulados y despliegues personalizados",{"_2299":48616,"_22571":48604,"_15405":82423,"_5":15294,"_21315":82392,"_1890":82424},[],"Tu equipo",{"_2299":48617,"_22571":48604,"_15405":82426,"_5":15294,"_21315":82392,"_1890":82427},[],"Helm o Fastlane",{"_2299":48618,"_22571":48604,"_15405":82429,"_5":15294,"_21315":82392,"_1890":35275},[],{"_2299":48619,"_22571":48604,"_15405":82431,"_5":15294,"_21315":82392,"_1890":82432},[],"Evaluación o despliegue dedicado dentro de una cuenta AWS",{"_2299":48620,"_22571":48604,"_15405":82434,"_5":15294,"_21315":82392,"_1890":82424},[],{"_2299":48621,"_22571":48604,"_15405":82436,"_5":15294,"_21315":82392,"_1890":82437},[],"Imagen preconfigurada en EC2",{"_2299":48622,"_22571":48604,"_15405":82439,"_5":15294,"_21315":82392,"_1890":35286},[],{"_2299":48623,"_22571":48604,"_15405":82441,"_5":15294,"_21315":82392,"_1890":82442},[],"Equipos que quieren utilizar la plataforma sin operarla",{"_2299":48624,"_22571":48604,"_15405":82444,"_5":15294,"_21315":82392,"_1890":35292},[],{"_2299":48625,"_22571":48604,"_15405":82446,"_5":15294,"_21315":82392,"_1890":82447},[],"Suscripción gestionada",{"_2299":48626,"_22571":48604,"_15405":82449,"_5":15294,"_21315":82392,"_1890":82450},[],"<Card title=\"Kubernetes self-managed\" description=\"Controla red, almacenamiento, claves, dependencias y ciclo de actualización.\" href=\"/docs/deployment/self-hosted/overview\" />",{"_2299":48627,"_22571":48604,"_15405":82452,"_5":15294,"_21315":82392,"_1890":82453},[],"<Card title=\"AWS Marketplace\" description=\"Lanza una instancia preconfigurada de Lamassu en AWS EC2.\" href=\"/docs/deployment/aws-marketplace\" />",{"_2299":48628,"_22571":48604,"_15405":82455,"_5":15294,"_21315":82392,"_1890":82456},[],"<Card title=\"Lamassu SaaS\" description=\"Utiliza una instancia operada y actualizada como servicio gestionado.\" href=\"/docs/deployment/saas\" />",{"_2299":48629,"_22571":48604,"_15405":82458,"_5":15294,"_21315":82396,"_1890":82459},[],"Usa Fastlane para levantar PostgreSQL, Keycloak, RabbitMQ y Lamassu en un clúster Kubernetes mediante un único flujo. Está pensado para laboratorios, demos y bootstrap; para producción, configura las dependencias y los valores Helm de forma explícita.",{"_2299":48630,"_22571":48604,"_15405":82461,"_5":15294,"_21315":82400,"_1890":82462},[],"Cuando la consola esté disponible, continúa con Crea tu primera CA. Ese quickstart verifica que el motor criptográfico y la emisión funcionan correctamente.",{"_2299":48631,"_22571":48631,"_5":10616,"_1890":82464,"_22830":82465,"_15405":82466,"_21315":48631},"Utiliza Lamassu como SaaS",[35156,82313,82314],[],{"_2299":48632,"_22571":48631,"_15405":82468,"_5":15294,"_21315":48631,"_1890":82469},[],"Consume Lamassu como servicio gestionado sin operar infraestructura propia.",{"_2299":48633,"_22571":48631,"_5":22827,"_15405":82471,"_21315":82472,"_1890":82473},[],"/docs/es/deployment/saas#qué-gestiona-el-servicio","Qué gestiona el servicio",{"_2299":48634,"_22571":48631,"_5":22827,"_15405":82475,"_21315":82476,"_1890":82477},[],"/docs/es/deployment/saas#planes","Planes",{"_2299":48635,"_22571":48631,"_5":22827,"_15405":82479,"_21315":82480,"_1890":82481},[],"/docs/es/deployment/saas#solicita-acceso","Solicita acceso",{"_2299":48636,"_22571":48631,"_15405":82483,"_5":15294,"_21315":48631,"_1890":82484},[],"Lamassu SaaS ofrece las capacidades de la plataforma en un entorno administrado. Es la opción indicada cuando tu equipo quiere centrarse en la PKI y las identidades de los dispositivos, no en mantener la infraestructura que las soporta.",{"_2299":48637,"_22571":48631,"_15405":82486,"_5":15294,"_21315":82472,"_1890":82487},[],"Disponibilidad y mantenimiento de la plataforma.",{"_2299":48638,"_22571":48631,"_15405":82489,"_5":15294,"_21315":82472,"_1890":82490},[],"Copias de seguridad automáticas.",{"_2299":48639,"_22571":48631,"_15405":82492,"_5":15294,"_21315":82472,"_1890":82493},[],"Actualizaciones de versión.",{"_2299":48640,"_22571":48631,"_15405":82495,"_5":15294,"_21315":82472,"_1890":82496},[],"Soporte técnico y SLA según el plan contratado.",{"_2299":48641,"_22571":48631,"_15405":82498,"_5":15294,"_21315":82476,"_1890":35347},[],{"_2299":48642,"_22571":48631,"_15405":82500,"_5":15294,"_21315":82476,"_1890":82501},[],"Dispositivos",{"_2299":48643,"_22571":48631,"_15405":82503,"_5":15294,"_21315":82476,"_1890":82504},[],"Soporte",{"_2299":48644,"_22571":48631,"_15405":82506,"_5":15294,"_21315":82476,"_1890":35356},[],{"_2299":48645,"_22571":48631,"_15405":82508,"_5":15294,"_21315":82476,"_1890":35359},[],{"_2299":48646,"_22571":48631,"_15405":82510,"_5":15294,"_21315":82476,"_1890":82511},[],"Hasta 1.000",{"_2299":48647,"_22571":48631,"_15405":82513,"_5":15294,"_21315":82476,"_1890":35365},[],{"_2299":48648,"_22571":48631,"_15405":82515,"_5":15294,"_21315":82476,"_1890":82516},[],"99,5 %",{"_2299":48649,"_22571":48631,"_15405":82518,"_5":15294,"_21315":82476,"_1890":35371},[],{"_2299":48650,"_22571":48631,"_15405":82520,"_5":15294,"_21315":82476,"_1890":82521},[],"Hasta 10.000",{"_2299":48651,"_22571":48631,"_15405":82523,"_5":15294,"_21315":82476,"_1890":82524},[],"Email y chat",{"_2299":48652,"_22571":48631,"_15405":82526,"_5":15294,"_21315":82476,"_1890":82527},[],"99,9 %",{"_2299":48653,"_22571":48631,"_15405":82529,"_5":15294,"_21315":82476,"_1890":35383},[],{"_2299":48654,"_22571":48631,"_15405":82531,"_5":15294,"_21315":82476,"_1890":82532},[],"Ilimitados",{"_2299":48655,"_22571":48631,"_15405":82534,"_5":15294,"_21315":82476,"_1890":82535},[],"Dedicado",{"_2299":48656,"_22571":48631,"_15405":82537,"_5":15294,"_21315":82476,"_1890":82538},[],"99,99 %",{"_2299":48657,"_22571":48631,"_15405":82540,"_5":15294,"_21315":82480,"_1890":82541},[],"Contacta con el equipo de Lamassu a través de lamassu.io para solicitar una demo o elegir un plan.",{"_2299":48658,"_22571":48631,"_15405":82543,"_5":15294,"_21315":82480,"_1890":82544},[],"Cuando recibas las credenciales de tu instancia, continúa con Primeros pasos.",{"_2299":48659,"_22571":48659,"_5":10616,"_1890":35400,"_22830":82546,"_15405":82547,"_21315":48659},[35156,82313,35263],[],{"_2299":48660,"_22571":48659,"_15405":82549,"_5":15294,"_21315":48659,"_1890":82550},[],"Arranca un entorno completo de evaluación o laboratorio de Lamassu en un clúster Kubernetes existente.",{"_2299":48661,"_22571":48659,"_5":22827,"_15405":82552,"_21315":82553,"_1890":82554},[],"/docs/es/deployment/self-hosted/fastlane#despliega-con-fastlane","Despliega con Fastlane",{"_2299":48662,"_22571":48659,"_5":22827,"_15405":82556,"_21315":82557,"_1890":82558},[],"/docs/es/deployment/self-hosted/fastlane#qué-añade-fastlane","Qué añade Fastlane",{"_2299":48663,"_22571":48659,"_5":22827,"_15405":82560,"_21315":82561,"_1890":82562},[],"/docs/es/deployment/self-hosted/fastlane#antes-de-comenzar","Antes de comenzar",{"_2299":48664,"_22571":48659,"_5":22827,"_15405":82564,"_21315":82565,"_1890":82566},[],"/docs/es/deployment/self-hosted/fastlane#inicio-rápido","Inicio rápido",{"_2299":48665,"_22571":48659,"_5":22827,"_15405":82568,"_21315":82569,"_1890":82570},[],"/docs/es/deployment/self-hosted/fastlane#selección-de-la-dirección-del-gateway","Selección de la dirección del Gateway",{"_2299":48666,"_22571":48659,"_5":22827,"_15405":82572,"_21315":82573,"_1890":82574},[],"/docs/es/deployment/self-hosted/fastlane#opciones-de-línea-de-comandos","Opciones de línea de comandos",{"_2299":48667,"_22571":48659,"_5":22827,"_15405":82576,"_21315":82577,"_1890":82578},[],"/docs/es/deployment/self-hosted/fastlane#qué-configura-el-script","Qué configura el script",{"_2299":48668,"_22571":48659,"_5":22827,"_15405":82580,"_21315":82581,"_1890":82582},[],"/docs/es/deployment/self-hosted/fastlane#comportamiento-tls","Comportamiento TLS",{"_2299":48669,"_22571":48659,"_5":22827,"_15405":82584,"_21315":82585,"_1890":82586},[],"/docs/es/deployment/self-hosted/fastlane#credenciales-y-archivos-generados","Credenciales y archivos generados",{"_2299":48670,"_22571":48659,"_5":22827,"_15405":82588,"_21315":82589,"_1890":82590},[],"/docs/es/deployment/self-hosted/fastlane#verifica-la-instalación","Verifica la instalación",{"_2299":48671,"_22571":48659,"_15405":82592,"_5":15294,"_21315":82553,"_1890":82593},[],"Fastlane es el camino automatizado para evaluaciones, demos, CI y pequeños clústeres de laboratorio. Instala PostgreSQL, Keycloak, RabbitMQ, Envoy Gateway y Lamassu, y los configura para trabajar juntos.",{"_2299":48672,"_22571":48659,"_15405":82595,"_5":15294,"_21315":82553,"_1890":82596},[],"Para producción, usa Helm para mantener explícitas las decisiones de base de datos, identidad, credenciales, certificados, almacenamiento y upgrades.",{"_2299":48673,"_22571":48659,"_15405":82598,"_5":15294,"_21315":82557,"_1890":82599},[],"Fastlane cubre algunas de las dependencias que el chart de aplicación deja deliberadamente fuera:",{"_2299":48674,"_22571":48659,"_15405":82601,"_5":15294,"_21315":82557,"_1890":82602},[],"Fastlane instala o configura",{"_2299":48675,"_22571":48659,"_15405":82604,"_5":15294,"_21315":82557,"_1890":82605},[],"Tú sigues proporcionando",{"_2299":48676,"_22571":48659,"_15405":82607,"_5":15294,"_21315":82557,"_1890":82608},[],"Instancias de PostgreSQL, RabbitMQ y Keycloak para evaluación",{"_2299":48677,"_22571":48659,"_15405":82610,"_5":15294,"_21315":82557,"_1890":82611},[],"El clúster Kubernetes, sus nodos y el almacenamiento persistente",{"_2299":48678,"_22571":48659,"_15405":82613,"_5":15294,"_21315":82557,"_1890":82614},[],"Envoy Gateway 1.8 y la `GatewayClass` `eg`",{"_2299":48679,"_22571":48659,"_15405":82616,"_5":15294,"_21315":82557,"_1890":82617},[],"cert-manager, accesibilidad desde la red externa, DNS y reglas de firewall/NAT",{"_2299":48680,"_22571":48659,"_15405":82619,"_5":15294,"_21315":82557,"_1890":82620},[],"Un flujo de certificado self-signed para Lamassu, credenciales generadas para las dependencias y un usuario inicial",{"_2299":48681,"_22571":48659,"_15405":82622,"_5":15294,"_21315":82557,"_1890":82623},[],"Confianza de los clientes en la CA self-signed, o un certificado de confianza pasado al script",{"_2299":48682,"_22571":48659,"_15405":82625,"_5":15294,"_21315":82557,"_1890":82626},[],"Componentes opcionales de observabilidad y HSM de laboratorio",{"_2299":48683,"_22571":48659,"_15405":82628,"_5":15294,"_21315":82557,"_1890":82629},[],"Retención de monitorización, backups, HA y un HSM/servicio de claves de producción",{"_2299":48684,"_22571":48659,"_15405":82631,"_5":15294,"_21315":82557,"_1890":82632},[],"Fastlane no convierte el stack en un servicio de producción: no crea el clúster, DNS público, reglas de firewall, backups, alta disponibilidad ni un certificado público de confianza.",{"_2299":48685,"_22571":48659,"_15405":82634,"_5":15294,"_21315":82561,"_1890":82635},[],"Necesitas:",{"_2299":48686,"_22571":48659,"_15405":82637,"_5":15294,"_21315":82561,"_1890":82638},[],"un clúster Kubernetes existente",{"_2299":48687,"_22571":48659,"_15405":82640,"_5":15294,"_21315":82561,"_1890":82641},[],"`kubectl` y Helm, o la CLI de MicroK8s",{"_2299":48688,"_22571":48659,"_15405":82643,"_5":15294,"_21315":82561,"_1890":35498},[],{"_2299":48689,"_22571":48659,"_15405":82645,"_5":15294,"_21315":82561,"_1890":17518},[],{"_2299":48690,"_22571":48659,"_15405":82647,"_5":15294,"_21315":82561,"_1890":82648},[],"`jq` solo si usas `--sample-data`",{"_2299":48691,"_22571":48659,"_15405":82650,"_5":15294,"_21315":82561,"_1890":82651},[],"los puertos externos 80 y 443 libres en un host K3s de un único nodo",{"_2299":48692,"_22571":48659,"_15405":82653,"_5":15294,"_21315":82561,"_1890":82654},[],"Fastlane detecta MicroK8s, K3s, kind o un kubeconfig estándar. Usa `--context` cuando el clúster deseado no sea el contexto actual.",{"_2299":48693,"_22571":48659,"_15405":82656,"_5":15294,"_21315":82561,"_1890":82657},[],"Fastlane instala varios componentes y crea credenciales. Comprueba `kubectl config current-context` o pasa `--context` antes de ejecutarlo.",{"_2299":48694,"_22571":48659,"_15405":82659,"_5":15294,"_21315":82565,"_1890":82660},[],"Ejecuta el script desde un clon del repositorio Helm:",{"_2299":48695,"_22571":48659,"_15405":82662,"_5":15294,"_21315":82565,"_1890":82663},[],"Crea un registro DNS para el dominio elegido antes de probar desde otra máquina. En una VM pequeña, apúntalo a la dirección de la VM o del balanceador que realmente recibe los puertos 80 y 443.",{"_2299":48696,"_22571":48659,"_15405":82665,"_5":15294,"_21315":82569,"_1890":82666},[],"Por defecto, Fastlane ejecuta `hostname -I` y escribe las direcciones devueltas en `gateway.addresses` y en los SAN IP del certificado self-signed.",{"_2299":48697,"_22571":48659,"_15405":82668,"_5":15294,"_21315":82569,"_1890":82669},[],"En una VM de laboratorio con una única interfaz puede seleccionar la dirección esperada. En hosts con Docker, VPN, WireGuard o varias interfaces también puede elegir direcciones inaccesibles para los clientes. Sobrescribe el resultado:",{"_2299":48698,"_22571":48659,"_15405":82671,"_5":15294,"_21315":82569,"_1890":82672},[],"El valor debe ser una dirección gestionada en el lado Kubernetes de la ruta. Si una IP pública de EC2 reenvía tráfico por WireGuard, pasa la dirección accesible de la VM o clúster, no la IP pública de EC2.",{"_2299":48699,"_22571":48659,"_15405":82674,"_5":15294,"_21315":82569,"_1890":82675},[],"Consulta Expón el Gateway para los conflictos de puertos de K3s, VIP, NAT externo y diseños con varios Gateways.",{"_2299":48700,"_22571":48659,"_15405":82677,"_5":15294,"_21315":82573,"_1890":82678},[],"Opción",{"_2299":48701,"_22571":48659,"_15405":82680,"_5":15294,"_21315":82573,"_1890":82681},[],"Valor predeterminado",{"_2299":48702,"_22571":48659,"_15405":82683,"_5":15294,"_21315":82573,"_1890":82684},[],"Propósito",{"_2299":48703,"_22571":48659,"_15405":82686,"_5":15294,"_21315":82573,"_1890":35542},[],{"_2299":48704,"_22571":48659,"_15405":82688,"_5":15294,"_21315":82573,"_1890":35545},[],{"_2299":48705,"_22571":48659,"_15405":82690,"_5":15294,"_21315":82573,"_1890":82691},[],"Muestra la ayuda",{"_2299":48706,"_22571":48659,"_15405":82693,"_5":15294,"_21315":82573,"_1890":35551},[],{"_2299":48707,"_22571":48659,"_15405":82695,"_5":15294,"_21315":82573,"_1890":82696},[],"contexto actual",{"_2299":48708,"_22571":48659,"_15405":82698,"_5":15294,"_21315":82573,"_1890":82699},[],"Selecciona el contexto de kubeconfig para kubectl y Helm",{"_2299":48709,"_22571":48659,"_15405":82701,"_5":15294,"_21315":82573,"_1890":35560},[],{"_2299":48710,"_22571":48659,"_15405":82703,"_5":15294,"_21315":82573,"_1890":4389},[],{"_2299":48711,"_22571":48659,"_15405":82705,"_5":15294,"_21315":82573,"_1890":82706},[],"Omite prompts y genera credenciales para las dependencias",{"_2299":48712,"_22571":48659,"_15405":82708,"_5":15294,"_21315":82573,"_1890":35568},[],{"_2299":48713,"_22571":48659,"_15405":82710,"_5":15294,"_21315":82573,"_1890":35571},[],{"_2299":48714,"_22571":48659,"_15405":82712,"_5":15294,"_21315":82573,"_1890":82713},[],"Namespace de la instalación",{"_2299":48715,"_22571":48659,"_15405":82715,"_5":15294,"_21315":82573,"_1890":35577},[],{"_2299":48716,"_22571":48659,"_15405":82717,"_5":15294,"_21315":82573,"_1890":35580},[],{"_2299":48717,"_22571":48659,"_15405":82719,"_5":15294,"_21315":82573,"_1890":82720},[],"Dominio usado por la UI, OIDC y el certificado",{"_2299":48718,"_22571":48659,"_15405":82722,"_5":15294,"_21315":82573,"_1890":35586},[],{"_2299":48719,"_22571":48659,"_15405":82724,"_5":15294,"_21315":82573,"_1890":10818},[],{"_2299":48720,"_22571":48659,"_15405":82726,"_5":15294,"_21315":82573,"_1890":82727},[],"Versión del chart de Lamassu",{"_2299":48721,"_22571":48659,"_15405":82729,"_5":15294,"_21315":82573,"_1890":35594},[],{"_2299":48722,"_22571":48659,"_15405":82731,"_5":15294,"_21315":82573,"_1890":35597},[],{"_2299":48723,"_22571":48659,"_15405":82733,"_5":15294,"_21315":82573,"_1890":82734},[],"Puerto del listener HTTPS",{"_2299":48724,"_22571":48659,"_15405":82736,"_5":15294,"_21315":82573,"_1890":35603},[],{"_2299":48725,"_22571":48659,"_15405":82738,"_5":15294,"_21315":82573,"_1890":35606},[],{"_2299":48726,"_22571":48659,"_15405":82740,"_5":15294,"_21315":82573,"_1890":82741},[],"Puerto del listener HTTP",{"_2299":48727,"_22571":48659,"_15405":82743,"_5":15294,"_21315":82573,"_1890":35612},[],{"_2299":48728,"_22571":48659,"_15405":82745,"_5":15294,"_21315":82573,"_1890":35545},[],{"_2299":48729,"_22571":48659,"_15405":82747,"_5":15294,"_21315":82573,"_1890":82748},[],"Certificado PEM para TLS downstream",{"_2299":48730,"_22571":48659,"_15405":82750,"_5":15294,"_21315":82573,"_1890":35620},[],{"_2299":48731,"_22571":48659,"_15405":82752,"_5":15294,"_21315":82573,"_1890":35545},[],{"_2299":48732,"_22571":48659,"_15405":82754,"_5":15294,"_21315":82573,"_1890":82755},[],"Clave privada PEM para TLS downstream",{"_2299":48733,"_22571":48659,"_15405":82757,"_5":15294,"_21315":82573,"_1890":35628},[],{"_2299":48734,"_22571":48659,"_15405":82759,"_5":15294,"_21315":82573,"_1890":82760},[],"chart del repositorio",{"_2299":48735,"_22571":48659,"_15405":82762,"_5":15294,"_21315":82573,"_1890":82763},[],"Usa un chart local de Lamassu sin empaquetar",{"_2299":48736,"_22571":48659,"_15405":82765,"_5":15294,"_21315":82573,"_1890":35637},[],{"_2299":48737,"_22571":48659,"_15405":82767,"_5":15294,"_21315":82573,"_1890":82768},[],"detección automática",{"_2299":48738,"_22571":48659,"_15405":82770,"_5":15294,"_21315":82573,"_1890":82771},[],"Sobrescribe la dirección escrita en `gateway.addresses`",{"_2299":48739,"_22571":48659,"_15405":82773,"_5":15294,"_21315":82573,"_1890":35645},[],{"_2299":48740,"_22571":48659,"_15405":82775,"_5":15294,"_21315":82573,"_1890":4389},[],{"_2299":48741,"_22571":48659,"_15405":82777,"_5":15294,"_21315":82573,"_1890":82778},[],"Instala Victoria Logs, VictoriaTraces, Jaeger y un OpenTelemetry Collector",{"_2299":48742,"_22571":48659,"_15405":82780,"_5":15294,"_21315":82573,"_1890":35653},[],{"_2299":48743,"_22571":48659,"_15405":82782,"_5":15294,"_21315":82573,"_1890":4389},[],{"_2299":48744,"_22571":48659,"_15405":82784,"_5":15294,"_21315":82573,"_1890":82785},[],"Crea CA, perfiles, certificados, DMS y dispositivos de ejemplo",{"_2299":48745,"_22571":48659,"_15405":82787,"_5":15294,"_21315":82573,"_1890":35661},[],{"_2299":48746,"_22571":48659,"_15405":82789,"_5":15294,"_21315":82573,"_1890":4389},[],{"_2299":48747,"_22571":48659,"_15405":82791,"_5":15294,"_21315":82573,"_1890":82792},[],"Instala componentes HSM de laboratorio y configura KMS con PKCS#11",{"_2299":48748,"_22571":48659,"_15405":82794,"_5":15294,"_21315":82573,"_1890":35669},[],{"_2299":48749,"_22571":48659,"_15405":82796,"_5":15294,"_21315":82573,"_1890":35672},[],{"_2299":48750,"_22571":48659,"_15405":82798,"_5":15294,"_21315":82573,"_1890":82799},[],"Usa otro chart local de SoftHSM",{"_2299":48751,"_22571":48659,"_15405":82801,"_5":15294,"_21315":82573,"_1890":82802},[],"Fastlane no ofrece un modo offline. Para entornos sin conexión, usa el flujo manual con Helm y prepara un registro y mirror de charts.",{"_2299":48752,"_22571":48659,"_15405":82804,"_5":15294,"_21315":82577,"_1890":35681},[],{"_2299":48753,"_22571":48659,"_15405":82806,"_5":15294,"_21315":82577,"_1890":82807},[],"valida las herramientas locales y el clúster seleccionado",{"_2299":48754,"_22571":48659,"_15405":82809,"_5":15294,"_21315":82577,"_1890":82810},[],"instala o actualiza Envoy Gateway 1.8 y crea la `GatewayClass` `eg`",{"_2299":48755,"_22571":48659,"_15405":82812,"_5":15294,"_21315":82577,"_1890":82813},[],"crea el namespace",{"_2299":48756,"_22571":48659,"_15405":82815,"_5":15294,"_21315":82577,"_1890":82816},[],"instala PostgreSQL y crea las bases de datos necesarias",{"_2299":48757,"_22571":48659,"_15405":82818,"_5":15294,"_21315":82577,"_1890":82819},[],"instala Keycloak y crea el realm `lamassu`, el cliente frontend, el rol administrador y el usuario inicial",{"_2299":48758,"_22571":48659,"_15405":82821,"_5":15294,"_21315":82577,"_1890":82822},[],"instala RabbitMQ",{"_2299":48759,"_22571":48659,"_15405":82824,"_5":15294,"_21315":82577,"_1890":82825},[],"instala opcionalmente observabilidad y componentes HSM de laboratorio",{"_2299":48760,"_22571":48659,"_15405":82827,"_5":15294,"_21315":82577,"_1890":82828},[],"genera `lamassu.yaml` e instala el chart de Lamassu",{"_2299":48761,"_22571":48659,"_15405":82830,"_5":15294,"_21315":82577,"_1890":82831},[],"carga datos de ejemplo opcionalmente",{"_2299":48762,"_22571":48659,"_15405":82833,"_5":15294,"_21315":82577,"_1890":82834},[],"La configuración generada expone Keycloak en `/auth` a través del mismo Gateway y provisiona al usuario inicial `lamassu` como superadministrador de Lamassu.",{"_2299":48763,"_22571":48659,"_15405":82836,"_5":15294,"_21315":82581,"_1890":82837},[],"Al proporcionar `--tls-crt` y `--tls-key`, Fastlane crea el Secret `downstream-provided-crt` y configura `tls.type: external`.",{"_2299":48764,"_22571":48659,"_15405":82839,"_5":15294,"_21315":82581,"_1890":82840},[],"Sin ellos, configura cert-manager con un emisor self-signed. Es adecuado para laboratorio, pero los clientes no confiarán en él hasta que distribuyas la CA. Usa Helm si necesitas un Issuer corporativo, un emisor ACME público o un Secret existente gestionado por otro sistema.",{"_2299":48765,"_22571":48659,"_15405":82842,"_5":15294,"_21315":82585,"_1890":82843},[],"El modo no interactivo genera contraseñas aleatorias para los administradores de PostgreSQL, RabbitMQ y Keycloak. El acceso inicial a Lamassu es `lamassu` / `lamassu` y obliga a cambiar la contraseña en el primer uso.",{"_2299":48766,"_22571":48659,"_15405":82845,"_5":15294,"_21315":82585,"_1890":82846},[],"Fastlane escribe `lamassu.yaml` en el directorio actual e incluye credenciales en él.",{"_2299":48767,"_22571":48659,"_15405":82848,"_5":15294,"_21315":82585,"_1890":82849},[],"Protege el archivo de valores generado, guarda las credenciales en un almacén de secretos apropiado y no reutilices la configuración de identidad de evaluación en producción.",{"_2299":48768,"_22571":48659,"_15405":82851,"_5":15294,"_21315":82589,"_1890":82852},[],"Abre `https://pki.example.com` e inicia sesión con el usuario inicial. Si el Gateway está programado pero la URL no es accesible, sigue las comprobaciones de Expón el Gateway.",{"_2299":48769,"_22571":48769,"_5":10616,"_1890":82854,"_22830":82855,"_15405":82856,"_21315":48769},"Instala con Helm",[35156,82313,35263],[],{"_2299":48770,"_22571":48769,"_15405":82858,"_5":15294,"_21315":48769,"_1890":82859},[],"Prepara las dependencias, configura el chart de Lamassu y verifica un despliegue controlado en Kubernetes.",{"_2299":48771,"_22571":48769,"_5":22827,"_15405":82861,"_21315":82862,"_1890":82863},[],"/docs/es/deployment/self-hosted/helm#instala-lamassu-con-helm","Instala Lamassu con Helm",{"_2299":48772,"_22571":48769,"_5":22827,"_15405":82865,"_21315":82866,"_1890":82562},[],"/docs/es/deployment/self-hosted/helm#antes-de-comenzar",{"_2299":48773,"_22571":48769,"_5":22827,"_15405":82868,"_21315":82869,"_1890":82870},[],"/docs/es/deployment/self-hosted/helm#1-instala-los-requisitos-del-gateway","1\\. Instala los requisitos del Gateway",{"_2299":48774,"_22571":48769,"_5":22827,"_15405":82872,"_21315":82873,"_1890":82874},[],"/docs/es/deployment/self-hosted/helm#2-crea-un-archivo-de-valores","2\\. Crea un archivo de valores",{"_2299":48775,"_22571":48769,"_5":22827,"_15405":82876,"_21315":82877,"_1890":82878},[],"/docs/es/deployment/self-hosted/helm#tls-con-un-secret-existente","TLS con un Secret existente",{"_2299":48776,"_22571":48769,"_5":22827,"_15405":82880,"_21315":82881,"_1890":82882},[],"/docs/es/deployment/self-hosted/helm#provisiona-el-primer-administrador","Provisiona el primer administrador",{"_2299":48777,"_22571":48769,"_5":22827,"_15405":82884,"_21315":82885,"_1890":82886},[],"/docs/es/deployment/self-hosted/helm#3-instala-lamassu","3\\. Instala Lamassu",{"_2299":48778,"_22571":48769,"_5":22827,"_15405":82888,"_21315":82889,"_1890":82890},[],"/docs/es/deployment/self-hosted/helm#4-verifica-el-despliegue","4\\. Verifica el despliegue",{"_2299":48779,"_22571":48769,"_5":22827,"_15405":82892,"_21315":82893,"_1890":82894},[],"/docs/es/deployment/self-hosted/helm#decisiones-para-producción","Decisiones para producción",{"_2299":48780,"_22571":48769,"_15405":82896,"_5":15294,"_21315":82862,"_1890":82897},[],"Usa Helm cuando necesites control explícito sobre identidad, bases de datos, mensajería, certificados, almacenamiento y upgrades. Para un entorno de evaluación en el que el script pueda tomar esas decisiones, usa Fastlane.",{"_2299":48781,"_22571":48769,"_15405":82899,"_5":15294,"_21315":82866,"_1890":82900},[],"Prepara los servicios de plataforma que quedan deliberadamente fuera del chart de Lamassu:",{"_2299":48782,"_22571":48769,"_15405":82902,"_5":15294,"_21315":82866,"_1890":82903},[],"un clúster Kubernetes 1.24+ y Helm 3.2+",{"_2299":48783,"_22571":48769,"_15405":82905,"_5":15294,"_21315":82866,"_1890":82906},[],"un servidor PostgreSQL accesible y un rol autorizado para crear bases de datos y schemas",{"_2299":48784,"_22571":48769,"_15405":82908,"_5":15294,"_21315":82866,"_1890":82909},[],"un broker RabbitMQ accesible y sus credenciales",{"_2299":48785,"_22571":48769,"_15405":82911,"_5":15294,"_21315":82866,"_1890":82912},[],"un proveedor OIDC, normalmente Keycloak, con un realm/tenant y un cliente para Lamassu",{"_2299":48786,"_22571":48769,"_15405":82914,"_5":15294,"_21315":82866,"_1890":82915},[],"Envoy Gateway 1.8+ y una `GatewayClass`",{"_2299":48787,"_22571":48769,"_15405":82917,"_5":15294,"_21315":82866,"_1890":82918},[],"cert-manager 1.14+; para TLS de confianza, un emisor de confianza o un Secret TLS de Kubernetes",{"_2299":48788,"_22571":48769,"_15405":82920,"_5":15294,"_21315":82866,"_1890":82921},[],"una StorageClass y un diseño de tráfico externo",{"_2299":48789,"_22571":48769,"_15405":82923,"_5":15294,"_21315":82866,"_1890":82924},[],"El chart usa por defecto una `GatewayClass` llamada `eg`. Cambia `gateway.className` si tu equipo de plataforma utiliza otro nombre.",{"_2299":48790,"_22571":48769,"_15405":82926,"_5":15294,"_21315":82866,"_1890":82927},[],"Tú proporcionas el servidor PostgreSQL. El job de pre-install del chart se conecta con las credenciales indicadas, crea las bases de datos `pki`, `authz` y `wfx` y los schemas de los servicios, ejecuta las migraciones y aplica `services.authz.bootstrap`.",{"_2299":48791,"_22571":48769,"_15405":82929,"_5":15294,"_21315":82866,"_1890":82930},[],"El chart no tiene dependencias Helm que instalen PostgreSQL, RabbitMQ, un proveedor OIDC, Envoy Gateway ni cert-manager.",{"_2299":48792,"_22571":48769,"_15405":82932,"_5":15294,"_21315":82869,"_1890":82933},[],"Instala o actualiza las CRD de Envoy Gateway antes de su controlador. Estos comandos usan la misma versión que el repositorio Helm de Lamassu:",{"_2299":48793,"_22571":48769,"_15405":82935,"_5":15294,"_21315":82869,"_1890":82936},[],"Crea la `GatewayClass` predeterminada si todavía no existe. Guarda este manifiesto como `gateway-class.yaml`:",{"_2299":48794,"_22571":48769,"_15405":82938,"_5":15294,"_21315":82869,"_1890":82939},[],"Instala cert-manager por separado antes de Lamassu. El chart actual renderiza sus recursos de issuer self-signed y certificado CA incluso cuando `tls.type: external` hace que el Gateway use un Secret TLS existente. Seleccionar TLS externo no elimina por tanto el requisito de cert-manager.",{"_2299":48795,"_22571":48769,"_15405":82941,"_5":15294,"_21315":82873,"_1890":82942},[],"Parte de los valores predeterminados del chart y sobrescribe los específicos del entorno. Este ejemplo supone que PostgreSQL, RabbitMQ y Keycloak son accesibles mediante DNS de Kubernetes y expone Keycloak en `/auth` a través del Gateway compartido:",{"_2299":48796,"_22571":48769,"_15405":82944,"_5":15294,"_21315":82873,"_1890":82945},[],"No añadas `gateway.addresses` por defecto. Deja la asignación de dirección a la implementación del balanceador salvo que tu diseño de red requiera una VIP concreta en Kubernetes. La IP pública de un NAT o proxy upstream no corresponde a este valor.",{"_2299":48797,"_22571":48769,"_15405":82947,"_5":15294,"_21315":82873,"_1890":82948},[],"Si Keycloak es externo y ya tiene una URL accesible, apunta la configuración OIDC hacia él y omite la entrada `/auth` de `gateway.extraRouting`.",{"_2299":48798,"_22571":48769,"_15405":82950,"_5":15294,"_21315":82877,"_1890":82951},[],"Crea un Secret con `tls.crt` y `tls.key` y referéncialo:",{"_2299":48799,"_22571":48769,"_15405":82953,"_5":15294,"_21315":82881,"_1890":82954},[],"No existe un superusuario implícito. Crea en el proveedor OIDC el rol o grupo esperado por `services.authz.bootstrap` y asígnalo al menos a un administrador antes de exponer Lamassu.",{"_2299":48800,"_22571":48769,"_15405":82956,"_5":15294,"_21315":82881,"_1890":82957},[],"El job de pre-install y pre-upgrade aplica el bootstrap de forma idempotente: conserva los principales existentes y añade los grants que falten.",{"_2299":48801,"_22571":48769,"_15405":82959,"_5":15294,"_21315":82881,"_1890":82960},[],"Prueba una identidad autorizada y otra denegada. Si ningún token coincide con un principal activo del bootstrap, nadie podrá administrar la PKI.",{"_2299":48802,"_22571":48769,"_15405":82962,"_5":15294,"_21315":82881,"_1890":82963},[],"Consulta Control de acceso para conocer el modelo de principales y políticas.",{"_2299":48803,"_22571":48769,"_15405":82965,"_5":15294,"_21315":82885,"_1890":82966},[],"Para instalar un checkout local:",{"_2299":48804,"_22571":48769,"_15405":82968,"_5":15294,"_21315":82889,"_1890":82969},[],"El Gateway debe mostrar `PROGRAMMED=True`. Si está programado pero no tiene una dirección utilizable, continúa con Expón el Gateway.",{"_2299":48805,"_22571":48769,"_15405":82971,"_5":15294,"_21315":82889,"_1890":82972},[],"El test de Helm comprueba los endpoints de salud de CA, DMS Manager, Device Manager y VA, y verifica la respuesta de la UI.",{"_2299":48806,"_22571":48769,"_15405":82974,"_5":15294,"_21315":82893,"_1890":82975},[],"Antes de pasar a producción, revisa:",{"_2299":48807,"_22571":48769,"_15405":82977,"_5":15294,"_21315":82893,"_1890":82978},[],"backup y recuperación de PostgreSQL y volúmenes persistentes",{"_2299":48808,"_22571":48769,"_15405":82980,"_5":15294,"_21315":82893,"_1890":82981},[],"un motor KMS de producción; el motor filesystem predeterminado no ofrece alta disponibilidad",{"_2299":48809,"_22571":48769,"_15405":82983,"_5":15294,"_21315":82893,"_1890":82984},[],"almacenamiento compartido para VA antes de aumentar sus réplicas",{"_2299":48810,"_22571":48769,"_15405":82986,"_5":15294,"_21315":82893,"_1890":82987},[],"roles OIDC gestionados y eliminación de credenciales de evaluación",{"_2299":48811,"_22571":48769,"_15405":82989,"_5":15294,"_21315":82893,"_1890":82990},[],"un emisor TLS de confianza o un certificado gestionado externamente",{"_2299":48812,"_22571":48769,"_15405":82992,"_5":15294,"_21315":82893,"_1890":82993},[],"recursos, réplicas, autoscaling, disruption budgets y placement",{"_2299":48813,"_22571":48769,"_15405":82995,"_5":15294,"_21315":82893,"_1890":82996},[],"SMTP, observabilidad y entrega de alertas",{"_2299":48814,"_22571":48769,"_15405":82998,"_5":15294,"_21315":82893,"_1890":82999},[],"las notas de migración de `charts/lamassu/CHANGELOG/` antes de cada upgrade",{"_2299":48815,"_22571":48769,"_15405":83001,"_5":15294,"_21315":82893,"_1890":83002},[],"La referencia completa de valores se mantiene en `charts/lamassu/VALUES.md` dentro del repositorio Helm.",{"_2299":48816,"_22571":48816,"_5":10616,"_1890":83004,"_22830":83005,"_15405":83006,"_21315":48816},"Expón el Gateway",[35156,82313,35263],[],{"_2299":48817,"_22571":48816,"_15405":83008,"_5":15294,"_21315":48816,"_1890":83009},[],"Elige cómo llegan los clientes a Lamassu, cuándo definir gateway.addresses y cómo diseñar varios Gateways.",{"_2299":48818,"_22571":48816,"_5":22827,"_15405":83011,"_21315":83012,"_1890":83013},[],"/docs/es/deployment/self-hosted/networking#expón-el-gateway-de-lamassu","Expón el Gateway de Lamassu",{"_2299":48819,"_22571":48816,"_5":22827,"_15405":83015,"_21315":83016,"_1890":83017},[],"/docs/es/deployment/self-hosted/networking#necesitas-gatewayaddresses","¿Necesitas `gateway.addresses`?",{"_2299":48820,"_22571":48816,"_5":22827,"_15405":83019,"_21315":83020,"_1890":83021},[],"/docs/es/deployment/self-hosted/networking#diseño-recomendado-para-un-solo-nodo","Diseño recomendado para un solo nodo",{"_2299":48821,"_22571":48816,"_5":22827,"_15405":83023,"_21315":83024,"_1890":35902},[],"/docs/es/deployment/self-hosted/networking#k3s",{"_2299":48822,"_22571":48816,"_5":22827,"_15405":83026,"_21315":83027,"_1890":83028},[],"/docs/es/deployment/self-hosted/networking#bare-metal-con-metallb-o-kube-vip","Bare metal con MetalLB o kube-vip",{"_2299":48823,"_22571":48816,"_5":22827,"_15405":83030,"_21315":83031,"_1890":83032},[],"/docs/es/deployment/self-hosted/networking#proxy-externo-nat-o-vpn","Proxy externo, NAT o VPN",{"_2299":48824,"_22571":48816,"_5":22827,"_15405":83034,"_21315":83035,"_1890":83036},[],"/docs/es/deployment/self-hosted/networking#qué-ocurre-si-necesitas-tres-gateways","¿Qué ocurre si necesitas tres Gateways?",{"_2299":48825,"_22571":48816,"_5":22827,"_15405":83038,"_21315":83039,"_1890":83040},[],"/docs/es/deployment/self-hosted/networking#guía-de-decisión","Guía de decisión",{"_2299":48826,"_22571":48816,"_5":22827,"_15405":83042,"_21315":83043,"_1890":83044},[],"/docs/es/deployment/self-hosted/networking#verifica-la-ruta-de-tráfico","Verifica la ruta de tráfico",{"_2299":48827,"_22571":48816,"_15405":83046,"_5":15294,"_21315":83012,"_1890":83047},[],"El chart de Lamassu crea un Gateway compartido con listeners HTTP y HTTPS. Envoy Gateway crea normalmente un deployment de proxy dedicado y un Service `LoadBalancer`.",{"_2299":48828,"_22571":48816,"_15405":83049,"_5":15294,"_21315":83012,"_1890":83050},[],"La accesibilidad externa depende de toda la ruta. Un recurso `Gateway` no configura por sí mismo el router, firewall, DNS, balanceador cloud ni NAT upstream.",{"_2299":48829,"_22571":48816,"_15405":83052,"_5":15294,"_21315":83016,"_1890":83053},[],"Normalmente no. Si lo omites, el controlador del Gateway y la implementación del balanceador pueden asignar una dirección y publicarla en `Gateway.status.addresses` y en el estado del Service generado.",{"_2299":48830,"_22571":48816,"_15405":83055,"_5":15294,"_21315":83016,"_1890":83056},[],"Defínelo únicamente cuando:",{"_2299":48831,"_22571":48816,"_15405":83058,"_5":15294,"_21315":83016,"_1890":83059},[],"tu balanceador cloud o bare metal permite solicitar una dirección concreta",{"_2299":48832,"_22571":48816,"_15405":83061,"_5":15294,"_21315":83016,"_1890":83062},[],"esa dirección está asignada a este Gateway",{"_2299":48833,"_22571":48816,"_15405":83064,"_5":15294,"_21315":83016,"_1890":83065},[],"la red ya enruta el tráfico de esa dirección hasta el clúster",{"_2299":48834,"_22571":48816,"_15405":83067,"_5":15294,"_21315":83016,"_1890":83068},[],"Esto solicita `192.168.1.50`; no reclama la IP en tu LAN ni la vuelve accesible.",{"_2299":48835,"_22571":48816,"_15405":83070,"_5":15294,"_21315":83016,"_1890":83071},[],"No confundas estos valores:",{"_2299":48836,"_22571":48816,"_15405":83073,"_5":15294,"_21315":83016,"_1890":83074},[],"`gateway.addresses` solicita una dirección para el Gateway.",{"_2299":48837,"_22571":48816,"_15405":83076,"_5":15294,"_21315":83016,"_1890":83077},[],"`tls.certManagerOptions.certSpec.addresses` añade direcciones IP a los SAN del certificado TLS.",{"_2299":48838,"_22571":48816,"_15405":83079,"_5":15294,"_21315":83016,"_1890":83080},[],"Si los usuarios se conectan por DNS, añade el nombre a `tls.certManagerOptions.certSpec.hostnames`. No copies la IP pública de un proxy upstream en `gateway.addresses`.",{"_2299":48839,"_22571":48816,"_15405":83082,"_5":15294,"_21315":83020,"_1890":83083},[],"Para una VM pequeña con K3s o MicroK8s, usa un único Gateway externo de Lamassu y enruta todos los endpoints a través de él:",{"_2299":48840,"_22571":48816,"_15405":83085,"_5":15294,"_21315":83020,"_1890":83086},[],"Este diseño utiliza una IP, un punto de entrada TLS y un único par de puertos. El chart ya crea las rutas necesarias.",{"_2299":48841,"_22571":48816,"_15405":83088,"_5":15294,"_21315":83024,"_1890":83089},[],"K3s ServiceLB implementa cada Service `LoadBalancer` mediante pods que reservan los puertos del Service en el nodo. En un único nodo, solo un Service puede ocupar el puerto 80 y otro el 443. El Service Traefik que K3s instala por defecto puede estar ocupando ambos.",{"_2299":48842,"_22571":48816,"_15405":83091,"_5":15294,"_21315":83024,"_1890":83092},[],"Para el diseño recomendado:",{"_2299":48843,"_22571":48816,"_15405":83094,"_5":15294,"_21315":83024,"_1890":83095},[],"Usa un único Gateway de Lamassu expuesto externamente.",{"_2299":48844,"_22571":48816,"_15405":83097,"_5":15294,"_21315":83024,"_1890":83098},[],"Comprueba que los puertos 80 y 443 están libres. Deshabilita o reconfigura Traefik si no forma parte de la ruta de tráfico.",{"_2299":48845,"_22571":48816,"_15405":83100,"_5":15294,"_21315":83024,"_1890":83101},[],"Permite esos puertos en el firewall de la VM y en cualquier security group upstream.",{"_2299":48846,"_22571":48816,"_15405":83103,"_5":15294,"_21315":83024,"_1890":83104},[],"Apunta DNS a la dirección accesible de la VM.",{"_2299":48847,"_22571":48816,"_15405":83106,"_5":15294,"_21315":83024,"_1890":83107},[],"Consulta la documentación de K3s ServiceLB para conocer el uso de host ports y cómo sustituirlo por otro balanceador.",{"_2299":48848,"_22571":48816,"_15405":83109,"_5":15294,"_21315":83027,"_1890":83110},[],"Asigna una VIP de un pool accesible desde la LAN. Puedes solicitarla con `gateway.addresses` si la implementación lo permite. Confirma la dirección asignada en el estado en lugar de asumir que la solicitud tuvo éxito.",{"_2299":48849,"_22571":48816,"_15405":83112,"_5":15294,"_21315":83031,"_1890":83113},[],"Una dirección pública externa puede reenviar TCP 80 y 443 a la VM o a una VIP de Kubernetes:",{"_2299":48850,"_22571":48816,"_15405":83115,"_5":15294,"_21315":83031,"_1890":83116},[],"La IP pública pertenece al dispositivo externo. Deja `gateway.addresses` sin definir o usa la dirección real del lado de Kubernetes, nunca una IP que el clúster no pueda asociar.",{"_2299":48851,"_22571":48816,"_15405":83118,"_5":15294,"_21315":83035,"_1890":83119},[],"Primero decide si necesitas tres data planes independientes o solo tres nombres de host.",{"_2299":48852,"_22571":48816,"_15405":83121,"_5":15294,"_21315":83035,"_1890":83122},[],"Requisito",{"_2299":48853,"_22571":48816,"_15405":83124,"_5":15294,"_21315":83035,"_1890":83125},[],"Diseño recomendado",{"_2299":48854,"_22571":48816,"_15405":83127,"_5":15294,"_21315":83035,"_1890":83128},[],"Consecuencia",{"_2299":48855,"_22571":48816,"_15405":83130,"_5":15294,"_21315":83035,"_1890":83131},[],"Varias URL o servicios de Lamassu",{"_2299":48856,"_22571":48816,"_15405":83133,"_5":15294,"_21315":83035,"_1890":83134},[],"Un Gateway con varias rutas",{"_2299":48857,"_22571":48816,"_15405":83136,"_5":15294,"_21315":83035,"_1890":83137},[],"Una IP y un proxy fleet; es el comportamiento predeterminado del chart",{"_2299":48858,"_22571":48816,"_15405":83139,"_5":15294,"_21315":83035,"_1890":83140},[],"Gateways independientes e IP externas distintas",{"_2299":48859,"_22571":48816,"_15405":83142,"_5":15294,"_21315":83035,"_1890":83143},[],"Una VIP por Gateway",{"_2299":48860,"_22571":48816,"_15405":83145,"_5":15294,"_21315":83035,"_1890":83146},[],"Todos pueden usar 80/443; requiere un balanceador con un pool de direcciones",{"_2299":48861,"_22571":48816,"_15405":83148,"_5":15294,"_21315":83035,"_1890":83149},[],"Gateways independientes, un nodo y una IP",{"_2299":48862,"_22571":48816,"_15405":83151,"_5":15294,"_21315":83035,"_1890":83152},[],"Puertos externos diferentes",{"_2299":48863,"_22571":48816,"_15405":83154,"_5":15294,"_21315":83035,"_1890":83155},[],"Los clientes deben indicar puertos no estándar",{"_2299":48864,"_22571":48816,"_15405":83157,"_5":15294,"_21315":83035,"_1890":83158},[],"Terminación TLS/mTLS separada detrás de una IP",{"_2299":48865,"_22571":48816,"_15405":83160,"_5":15294,"_21315":83035,"_1890":83161},[],"Front door con enrutamiento SNI hacia Gateways internos",{"_2299":48866,"_22571":48816,"_15405":83163,"_5":15294,"_21315":83035,"_1890":83164},[],"Diseño avanzado; el front door usa TLS passthrough y cada Gateway termina su propio TLS",{"_2299":48867,"_22571":48816,"_15405":83166,"_5":15294,"_21315":83035,"_1890":83167},[],"Recursos Gateway separados pero proxy compartido",{"_2299":48868,"_22571":48816,"_15405":83169,"_5":15294,"_21315":83035,"_1890":83170},[],"Modo merged Gateway de Envoy",{"_2299":48869,"_22571":48816,"_15405":83172,"_5":15294,"_21315":83035,"_1890":83173},[],"Solo separación lógica; cada listener necesita una tupla única de puerto, protocolo y hostname",{"_2299":48870,"_22571":48816,"_15405":83175,"_5":15294,"_21315":83035,"_1890":83176},[],"Tres Services `LoadBalancer` independientes no pueden reservar a la vez los mismos puertos 80 y 443 mediante K3s ServiceLB. Usa un Gateway compartido, asigna VIP distintas con otro balanceador o utiliza puertos diferentes.",{"_2299":48871,"_22571":48816,"_15405":83178,"_5":15294,"_21315":83035,"_1890":83179},[],"Envoy Gateway provisiona normalmente un proxy fleet por `Gateway`. Su modo merged Gateway puede compartir un fleet y una dirección, pero no es un cambio directo para varias releases de Lamassu: los listeners generados usan los mismos puertos y protocolos sin hostnames distintos, por lo que entran en conflicto salvo que personalices el diseño.",{"_2299":48872,"_22571":48816,"_15405":83181,"_5":15294,"_21315":83035,"_1890":83182},[],"Usa un front door con SNI solo cuando los Gateways internos deban mantener políticas TLS o mTLS independientes:",{"_2299":48873,"_22571":48816,"_15405":83184,"_5":15294,"_21315":83035,"_1890":83185},[],"Esto requiere hostnames SNI distintos y configuración de red externa al chart de Lamassu.",{"_2299":48874,"_22571":48816,"_15405":83187,"_5":15294,"_21315":83039,"_1890":83188},[],"Si un Gateway puede gestionar TLS y el enrutamiento, usa el valor predeterminado del chart.",{"_2299":48875,"_22571":48816,"_15405":83190,"_5":15294,"_21315":83039,"_1890":83191},[],"Si los Gateways necesitan políticas independientes y puedes asignar IP, usa una VIP por Gateway.",{"_2299":48876,"_22571":48816,"_15405":83193,"_5":15294,"_21315":83039,"_1890":83194},[],"Si solo necesitas separar los recursos Kubernetes, evalúa merged Gateway y usa tuplas de listener únicas.",{"_2299":48877,"_22571":48816,"_15405":83196,"_5":15294,"_21315":83039,"_1890":83197},[],"Si los data planes y la terminación TLS deben ser independientes detrás de una IP, añade un front door con TLS passthrough y SNI.",{"_2299":48878,"_22571":48816,"_15405":83199,"_5":15294,"_21315":83039,"_1890":83200},[],"Si nada de lo anterior es posible, usa puertos externos distintos o cambia el diseño de red.",{"_2299":48879,"_22571":48816,"_15405":83202,"_5":15294,"_21315":83043,"_1890":83203},[],"Comprueba, en orden:",{"_2299":48880,"_22571":48816,"_15405":83205,"_5":15294,"_21315":83043,"_1890":83206},[],"El `Gateway` muestra `Accepted=True` y `Programmed=True`.",{"_2299":48881,"_22571":48816,"_15405":83208,"_5":15294,"_21315":83043,"_1890":83209},[],"Su estado contiene la dirección esperada.",{"_2299":48882,"_22571":48816,"_15405":83211,"_5":15294,"_21315":83043,"_1890":83212},[],"El Service `LoadBalancer` generado tiene una dirección externa utilizable.",{"_2299":48883,"_22571":48816,"_15405":83214,"_5":15294,"_21315":83043,"_1890":83215},[],"El puerto 443 de esa dirección es accesible desde la red del cliente.",{"_2299":48884,"_22571":48816,"_15405":83217,"_5":15294,"_21315":83043,"_1890":83218},[],"DNS resuelve al endpoint accesible externamente.",{"_2299":48885,"_22571":48816,"_15405":83220,"_5":15294,"_21315":83043,"_1890":83221},[],"El certificado contiene el nombre DNS o la IP usada por el cliente.",{"_2299":48886,"_22571":48816,"_15405":83223,"_5":15294,"_21315":83043,"_1890":83224},[],"Gateway API trata las direcciones como estado deseado que el controlador puede asignar o rechazar; consulta la introducción a Gateway API para conocer el modelo.",{"_2299":48887,"_22571":48887,"_5":10616,"_1890":35263,"_22830":83226,"_15405":83227,"_21315":48887},[35156,82313,35263],[],{"_2299":48888,"_22571":48887,"_15405":83229,"_5":15294,"_21315":48887,"_1890":83230},[],"Elige un flujo de instalación y una arquitectura de red para Lamassu en tu clúster Kubernetes.",{"_2299":48889,"_22571":48887,"_5":22827,"_15405":83232,"_21315":83233,"_1890":83234},[],"/docs/es/deployment/self-hosted/overview#despliegue-self-managed-con-kubernetes","Despliegue self-managed con Kubernetes",{"_2299":48890,"_22571":48887,"_5":22827,"_15405":83236,"_21315":83237,"_1890":83238},[],"/docs/es/deployment/self-hosted/overview#elige-un-flujo-de-instalación","Elige un flujo de instalación",{"_2299":48891,"_22571":48887,"_5":22827,"_15405":83240,"_21315":83241,"_1890":83242},[],"/docs/es/deployment/self-hosted/overview#qué-proporciona-el-chart-de-lamassu","Qué proporciona el chart de Lamassu",{"_2299":48892,"_22571":48887,"_5":22827,"_15405":83244,"_21315":83245,"_1890":83246},[],"/docs/es/deployment/self-hosted/overview#cómo-encaja-el-despliegue","Cómo encaja el despliegue",{"_2299":48893,"_22571":48887,"_5":22827,"_15405":83248,"_21315":83249,"_1890":83250},[],"/docs/es/deployment/self-hosted/overview#requisitos-de-plataforma","Requisitos de plataforma",{"_2299":48894,"_22571":48887,"_5":22827,"_15405":83252,"_21315":83253,"_1890":83254},[],"/docs/es/deployment/self-hosted/overview#elige-la-siguiente-página","Elige la siguiente página",{"_2299":48895,"_22571":48887,"_15405":83256,"_5":15294,"_21315":83233,"_1890":83257},[],"Ejecuta Lamassu en un clúster Kubernetes operado por tu equipo. El chart Helm despliega los servicios de Lamassu y sus recursos de enrutamiento; tú proporcionas el clúster, el almacenamiento persistente, el proveedor de identidad, PostgreSQL, RabbitMQ y la ruta de red utilizada por los clientes.",{"_2299":48896,"_22571":48887,"_15405":83259,"_5":15294,"_21315":83237,"_1890":83260},[],"Flujo",{"_2299":48897,"_22571":48887,"_15405":83262,"_5":15294,"_21315":83237,"_1890":83263},[],"Úsalo para",{"_2299":48898,"_22571":48887,"_15405":83265,"_5":15294,"_21315":83237,"_1890":83266},[],"Qué instala",{"_2299":48899,"_22571":48887,"_15405":83268,"_5":15294,"_21315":83237,"_1890":36147},[],{"_2299":48900,"_22571":48887,"_15405":83270,"_5":15294,"_21315":83237,"_1890":83271},[],"Producción y entornos controlados",{"_2299":48901,"_22571":48887,"_15405":83273,"_5":15294,"_21315":83237,"_1890":83274},[],"Servicios de Lamassu y recursos de Gateway API",{"_2299":48902,"_22571":48887,"_15405":83276,"_5":15294,"_21315":83237,"_1890":35400},[],{"_2299":48903,"_22571":48887,"_15405":83278,"_5":15294,"_21315":83237,"_1890":83279},[],"Evaluación, demos, CI y pequeños clústeres de laboratorio",{"_2299":48904,"_22571":48887,"_15405":83281,"_5":15294,"_21315":83237,"_1890":83282},[],"PostgreSQL, Keycloak, RabbitMQ, Envoy Gateway y Lamassu",{"_2299":48905,"_22571":48887,"_15405":83284,"_5":15294,"_21315":83241,"_1890":83285},[],"El chart de Lamassu es un **chart de aplicación**, no un chart de bootstrap del clúster. Crea los recursos Kubernetes que ejecutan y configuran Lamassu, pero espera que ya existan los servicios de plataforma de los que dependen.",{"_2299":48906,"_22571":48887,"_15405":83287,"_5":15294,"_21315":83241,"_1890":83288},[],"Área",{"_2299":48907,"_22571":48887,"_15405":83290,"_5":15294,"_21315":83241,"_1890":83291},[],"El chart de Lamassu proporciona",{"_2299":48908,"_22571":48887,"_15405":83293,"_5":15294,"_21315":83241,"_1890":83294},[],"Tú proporcionas",{"_2299":48909,"_22571":48887,"_15405":83296,"_5":15294,"_21315":83241,"_1890":83297},[],"Aplicaciones Lamassu",{"_2299":48910,"_22571":48887,"_15405":83299,"_5":15294,"_21315":83241,"_1890":83300},[],"Deployments y StatefulSets para la UI y las APIs, Services internos, ConfigMaps, una ServiceAccount y HPA/PDB opcionales",{"_2299":48911,"_22571":48887,"_15405":83302,"_5":15294,"_21315":83241,"_1890":83303},[],"Un clúster Kubernetes operativo, capacidad de cómputo y acceso a las imágenes",{"_2299":48912,"_22571":48887,"_15405":83305,"_5":15294,"_21315":83241,"_1890":83306},[],"Datos PostgreSQL",{"_2299":48913,"_22571":48887,"_15405":83308,"_5":15294,"_21315":83241,"_1890":83309},[],"Un job de pre-install/pre-upgrade que crea las bases de datos y schemas necesarios, ejecuta migraciones y aplica el bootstrap de autorización",{"_2299":48914,"_22571":48887,"_15405":83311,"_5":15294,"_21315":83241,"_1890":83312},[],"Un servidor PostgreSQL accesible, credenciales autorizadas para crear bases de datos y schemas, y operaciones de backup/HA",{"_2299":48915,"_22571":48887,"_15405":83314,"_5":15294,"_21315":83241,"_1890":83315},[],"Mensajería",{"_2299":48916,"_22571":48887,"_15405":83317,"_5":15294,"_21315":83241,"_1890":83318},[],"Configuración de conexión a RabbitMQ para los servicios Lamassu",{"_2299":48917,"_22571":48887,"_15405":83320,"_5":15294,"_21315":83241,"_1890":83321},[],"Un broker RabbitMQ accesible, credenciales y la gestión de su ciclo de vida",{"_2299":48918,"_22571":48887,"_15405":83323,"_5":15294,"_21315":83241,"_1890":83324},[],"Identidad",{"_2299":48919,"_22571":48887,"_15405":83326,"_5":15294,"_21315":83241,"_1890":83327},[],"Configuración OIDC/JWT y de autorización externa, además de los principales iniciales de Lamassu",{"_2299":48920,"_22571":48887,"_15405":83329,"_5":15294,"_21315":83241,"_1890":83330},[],"Un proveedor OIDC, realm/tenant, cliente, usuarios, grupos y roles",{"_2299":48921,"_22571":48887,"_15405":83332,"_5":15294,"_21315":83241,"_1890":83333},[],"Enrutamiento externo",{"_2299":48922,"_22571":48887,"_15405":83335,"_5":15294,"_21315":83241,"_1890":83336},[],"Un `Gateway`, recursos `HTTPRoute`, una configuración `EnvoyProxy` y políticas de seguridad de Envoy",{"_2299":48923,"_22571":48887,"_15405":83338,"_5":15294,"_21315":83241,"_1890":83339},[],"Las CRD de Gateway API y Envoy, el controlador Envoy Gateway, una `GatewayClass`, un balanceador y la ruta de red externa",{"_2299":48924,"_22571":48887,"_15405":83341,"_5":15294,"_21315":83241,"_1890":36221},[],{"_2299":48925,"_22571":48887,"_15405":83343,"_5":15294,"_21315":83241,"_1890":83344},[],"Recursos `Issuer` y `Certificate` CA de cert-manager; un `Certificate` downstream gestionado por el chart o una referencia a tu Secret TLS",{"_2299":48926,"_22571":48887,"_15405":83346,"_5":15294,"_21315":83241,"_1890":83347},[],"cert-manager; para TLS de confianza, un emisor de confianza o un Secret TLS ya poblado",{"_2299":48927,"_22571":48887,"_15405":83349,"_5":15294,"_21315":83241,"_1890":83350},[],"Datos persistentes de la aplicación",{"_2299":48928,"_22571":48887,"_15405":83352,"_5":15294,"_21315":83241,"_1890":83353},[],"PersistentVolumeClaims necesarios para el almacenamiento local predeterminado de KMS y VA",{"_2299":48929,"_22571":48887,"_15405":83355,"_5":15294,"_21315":83241,"_1890":83356},[],"Una StorageClass, almacenamiento físico, backups y un backend compartido/externo cuando el escalado lo requiera",{"_2299":48930,"_22571":48887,"_15405":83358,"_5":15294,"_21315":83241,"_1890":83359},[],"Integraciones opcionales",{"_2299":48931,"_22571":48887,"_15405":83361,"_5":15294,"_21315":83241,"_1890":83362},[],"Puntos de configuración para observabilidad, conectores AWS y conectividad PKCS#11/HSM",{"_2299":48932,"_22571":48887,"_15405":83364,"_5":15294,"_21315":83241,"_1890":83365},[],"Los backends de observabilidad, credenciales cloud y un HSM de producción o servicio externo de claves",{"_2299":48933,"_22571":48887,"_15405":83367,"_5":15294,"_21315":83241,"_1890":83368},[],"El chart crea el `Gateway` y las rutas de Lamassu. No instala el controlador Envoy Gateway ni hace que el Service `LoadBalancer` generado sea accesible desde tu red.",{"_2299":48934,"_22571":48887,"_15405":83370,"_5":15294,"_21315":83241,"_1890":83371},[],"Usa un único Gateway de Lamassu en los puertos 80 y 443 y deja que sus HTTPRoutes distribuyan el tráfico a todos los servicios. Proporciona a ese Gateway un único endpoint accesible mediante el balanceador del clúster, o reenvía tráfico desde un proxy externo o un dispositivo NAT. No necesitas un Gateway por servicio.",{"_2299":48935,"_22571":48887,"_15405":83373,"_5":15294,"_21315":83245,"_1890":83374},[],"El chart crea un `Gateway` compartido por cada release de Helm. Todos los recursos `HTTPRoute` gestionados por el chart se conectan a él. Envoy Gateway provisiona el data plane del proxy y un Service `LoadBalancer` de Kubernetes para ese Gateway.",{"_2299":48936,"_22571":48887,"_15405":83376,"_5":15294,"_21315":83245,"_1890":83377},[],"El valor `gateway.addresses` solo solicita una dirección al controlador del Gateway. No hace que una IP sea enrutable, abre un firewall, configura DNS ni crea NAT. Consulta Expón el Gateway antes de definirlo.",{"_2299":48937,"_22571":48887,"_15405":83379,"_5":15294,"_21315":83249,"_1890":83380},[],"Kubernetes 1.24 o posterior",{"_2299":48938,"_22571":48887,"_15405":83382,"_5":15294,"_21315":83249,"_1890":83383},[],"Helm 3.2 o posterior",{"_2299":48939,"_22571":48887,"_15405":83385,"_5":15294,"_21315":83249,"_1890":83386},[],"Envoy Gateway 1.8 o posterior y una `GatewayClass`",{"_2299":48940,"_22571":48887,"_15405":83388,"_5":15294,"_21315":83249,"_1890":83389},[],"cert-manager 1.14 o posterior; el chart actual renderiza recursos issuer y certificate de cert-manager",{"_2299":48941,"_22571":48887,"_15405":83391,"_5":15294,"_21315":83249,"_1890":83392},[],"almacenamiento persistente adecuado para la configuración elegida de PostgreSQL, RabbitMQ, VA y KMS",{"_2299":48942,"_22571":48887,"_15405":83394,"_5":15294,"_21315":83249,"_1890":83395},[],"una implementación de balanceador o alguna otra ruta deliberada desde los clientes hasta el Gateway",{"_2299":48943,"_22571":48887,"_15405":83397,"_5":15294,"_21315":83249,"_1890":83398},[],"Los despliegues KMS que usan el sidecar PKCS#11 nativo requieren Kubernetes 1.29 o posterior.",{"_2299":48944,"_22571":48887,"_15405":83400,"_5":15294,"_21315":83253,"_1890":83401},[],"<Card title=\"Instala con Helm\" description=\"Prepara dependencias, configura valores, instala y verifica un despliegue controlado.\" href=\"/docs/deployment/self-hosted/helm\" />",{"_2299":48945,"_22571":48887,"_15405":83403,"_5":15294,"_21315":83253,"_1890":83404},[],"<Card title=\"Expón el Gateway\" description=\"Elige un diseño de tráfico externo, comprende gateway.addresses y gestiona varios Gateways.\" href=\"/docs/deployment/self-hosted/networking\" />",{"_2299":48946,"_22571":48887,"_15405":83406,"_5":15294,"_21315":83253,"_1890":83407},[],"<Card title=\"Usa Fastlane\" description=\"Arranca un entorno completo de evaluación o laboratorio con un script.\" href=\"/docs/deployment/self-hosted/fastlane\" />",{"_2299":48947,"_22571":48947,"_5":10616,"_1890":83409,"_22830":83410,"_15405":83413,"_21315":48947},"Control de acceso",[35156,83411,83412],"Plataforma","Administrar Lamassu",[],{"_2299":48948,"_22571":48947,"_15405":83415,"_5":15294,"_21315":48947,"_1890":83416},[],"Diseña quién puede acceder a Lamassu mediante principales, políticas, permisos sobre recursos y autorización de rutas HTTP.",{"_2299":48949,"_22571":48947,"_5":22827,"_15405":83418,"_21315":83419,"_1890":83420},[],"/docs/es/platform/pki/access-control#conceptos-esenciales","Conceptos esenciales",{"_2299":48950,"_22571":48947,"_5":22827,"_15405":83422,"_21315":83423,"_1890":83424},[],"/docs/es/platform/pki/access-control#dos-sistemas-de-decisión","Dos sistemas de decisión",{"_2299":48951,"_22571":48947,"_5":22827,"_15405":83426,"_21315":83427,"_1890":83428},[],"/docs/es/platform/pki/access-control#servicios-http-integrados-o-externos","Servicios HTTP integrados o externos",{"_2299":48952,"_22571":48947,"_5":22827,"_15405":83430,"_21315":83431,"_1890":83432},[],"/docs/es/platform/pki/access-control#servicios-desarrollados-por-lamassu","Servicios desarrollados por Lamassu",{"_2299":48953,"_22571":48947,"_5":22827,"_15405":83434,"_21315":83435,"_1890":83436},[],"/docs/es/platform/pki/access-control#cómo-se-relacionan-ambos-caminos","Cómo se relacionan ambos caminos",{"_2299":48954,"_22571":48947,"_5":22827,"_15405":83438,"_21315":83439,"_1890":83440},[],"/docs/es/platform/pki/access-control#principales-oidc","Principales OIDC",{"_2299":48955,"_22571":48947,"_5":22827,"_15405":83442,"_21315":83443,"_1890":83444},[],"/docs/es/platform/pki/access-control#principales-x509","Principales X.509",{"_2299":48956,"_22571":48947,"_5":22827,"_15405":83446,"_21315":83447,"_1890":83448},[],"/docs/es/platform/pki/access-control#cuando-coinciden-varios-principales","Cuando coinciden varios principales",{"_2299":48957,"_22571":48947,"_5":22827,"_15405":83450,"_21315":83451,"_1890":83452},[],"/docs/es/platform/pki/access-control#cómo-expresan-acceso-las-políticas","Cómo expresan acceso las políticas",{"_2299":48958,"_22571":48947,"_5":22827,"_15405":83454,"_21315":83455,"_1890":83456},[],"/docs/es/platform/pki/access-control#acceso-global-y-acceso-directo","Acceso global y acceso directo",{"_2299":48959,"_22571":48947,"_5":22827,"_15405":83458,"_21315":83459,"_1890":83460},[],"/docs/es/platform/pki/access-control#acceso-heredado-por-relaciones","Acceso heredado por relaciones",{"_2299":48960,"_22571":48947,"_5":22827,"_15405":83462,"_21315":83463,"_1890":83464},[],"/docs/es/platform/pki/access-control#acceso-filtrado-por-atributos","Acceso filtrado por atributos",{"_2299":48961,"_22571":48947,"_5":22827,"_15405":83466,"_21315":83467,"_1890":83468},[],"/docs/es/platform/pki/access-control#reglas-http","Reglas HTTP",{"_2299":48962,"_22571":48947,"_5":22827,"_15405":83470,"_21315":83471,"_1890":83472},[],"/docs/es/platform/pki/access-control#políticas-incluidas","Políticas incluidas",{"_2299":48963,"_22571":48947,"_5":22827,"_15405":83474,"_21315":83475,"_1890":82882},[],"/docs/es/platform/pki/access-control#provisiona-el-primer-administrador",{"_2299":48964,"_22571":48947,"_5":22827,"_15405":83477,"_21315":83478,"_1890":83479},[],"/docs/es/platform/pki/access-control#prepara-el-proveedor-de-identidad","Prepara el proveedor de identidad",{"_2299":48965,"_22571":48947,"_5":22827,"_15405":83481,"_21315":83482,"_1890":83483},[],"/docs/es/platform/pki/access-control#configura-las-dos-validaciones-jwt","Configura las dos validaciones JWT",{"_2299":48966,"_22571":48947,"_5":22827,"_15405":83485,"_21315":83486,"_1890":83487},[],"/docs/es/platform/pki/access-control#instala-y-verifica-el-acceso-administrativo","Instala y verifica el acceso administrativo",{"_2299":48967,"_22571":48947,"_5":22827,"_15405":83489,"_21315":83490,"_1890":83491},[],"/docs/es/platform/pki/access-control#prueba-una-identidad-sin-privilegios","Prueba una identidad sin privilegios",{"_2299":48968,"_22571":48947,"_5":22827,"_15405":83493,"_21315":83494,"_1890":83495},[],"/docs/es/platform/pki/access-control#reduce-el-uso-del-administrador-de-bootstrap","Reduce el uso del administrador de bootstrap",{"_2299":48969,"_22571":48947,"_5":22827,"_15405":83497,"_21315":83498,"_1890":83499},[],"/docs/es/platform/pki/access-control#bootstrap-de-fastlane","Bootstrap de Fastlane",{"_2299":48970,"_22571":48947,"_5":22827,"_15405":83501,"_21315":83502,"_1890":83503},[],"/docs/es/platform/pki/access-control#diseña-roles-de-mínimo-privilegio","Diseña roles de mínimo privilegio",{"_2299":48971,"_22571":48947,"_5":22827,"_15405":83505,"_21315":83506,"_1890":83507},[],"/docs/es/platform/pki/access-control#cambios-y-revocación-de-acceso","Cambios y revocación de acceso",{"_2299":48972,"_22571":48947,"_5":22827,"_15405":83509,"_21315":83510,"_1890":83511},[],"/docs/es/platform/pki/access-control#lista-de-comprobación-operativa","Lista de comprobación operativa",{"_2299":48973,"_22571":48947,"_5":22827,"_15405":83513,"_21315":83514,"_1890":83515},[],"/docs/es/platform/pki/access-control#diagnóstico","Diagnóstico",{"_2299":48974,"_22571":48947,"_5":22827,"_15405":83517,"_21315":83518,"_1890":83519},[],"/docs/es/platform/pki/access-control#la-respuesta-es-401","La respuesta es 401",{"_2299":48975,"_22571":48947,"_5":22827,"_15405":83521,"_21315":83522,"_1890":83523},[],"/docs/es/platform/pki/access-control#la-respuesta-es-403","La respuesta es 403",{"_2299":48976,"_22571":48947,"_5":22827,"_15405":83525,"_21315":83526,"_1890":83527},[],"/docs/es/platform/pki/access-control#todo-devuelve-403","Todo devuelve 403",{"_2299":48977,"_22571":48947,"_5":22827,"_15405":83529,"_21315":83530,"_1890":83531},[],"/docs/es/platform/pki/access-control#todo-falla-cuando-authz-no-está-disponible","Todo falla cuando authz no está disponible",{"_2299":48978,"_22571":48947,"_15405":83533,"_5":15294,"_21315":48947,"_1890":83534},[],"El control de acceso de Lamassu transforma una identidad autenticada en permisos concretos. El proveedor OIDC o el certificado cliente demuestra **quién** realiza una petición; el servicio `authz` decide **qué puede hacer** esa identidad y **sobre qué recursos**.",{"_2299":48979,"_22571":48947,"_15405":83536,"_5":15294,"_21315":48947,"_1890":83537},[],"Lamassu no asigna permisos directamente a usuarios. La cadena completa es:",{"_2299":48980,"_22571":48947,"_15405":83539,"_5":15294,"_21315":48947,"_1890":83540},[],"Este modelo permite representar personas, grupos del proveedor de identidad, cuentas de servicio y dispositivos sin acoplar la autorización a un proveedor concreto.",{"_2299":48981,"_22571":48947,"_15405":83542,"_5":15294,"_21315":83419,"_1890":83543},[],"Un **principal** conecta una credencial con Lamassu. Define cómo reconocer una identidad OIDC o X.509 y puede estar activo o desactivado.",{"_2299":48982,"_22571":48947,"_15405":83545,"_5":15294,"_21315":83419,"_1890":83546},[],"Una **política** agrupa permisos reutilizables. Puede concederse a varios principales y puede contener reglas sobre entidades de Lamassu, reglas sobre rutas HTTP o ambas.",{"_2299":48983,"_22571":48947,"_15405":83548,"_5":15294,"_21315":83419,"_1890":83549},[],"Una **regla de entidad** concede acciones sobre recursos como autoridades certificadoras, certificados, perfiles de emisión, dispositivos, DMS, claves o suscripciones de alertas. Puede abarcar todos los recursos de un tipo o limitarse por identificador, relación o atributo.",{"_2299":48984,"_22571":48947,"_15405":83551,"_5":15294,"_21315":83419,"_1890":83552},[],"Una **regla HTTP** concede acciones asociadas a rutas de una API. Es el mecanismo que utiliza el Gateway para decidir si una petición puede atravesar el perímetro.",{"_2299":48985,"_22571":48947,"_15405":83554,"_5":15294,"_21315":83419,"_1890":83555},[],"Un **grant** es la asociación entre un principal y una política. Quitar el grant elimina todos los permisos aportados por esa política, sin modificarla para los demás principales.",{"_2299":48986,"_22571":48947,"_15405":83557,"_5":15294,"_21315":83419,"_1890":83558},[],"Un JWT válido o un certificado cliente válido no concede acceso por sí mismo. La credencial debe coincidir con al menos un principal activo y alguna de sus políticas debe permitir la operación solicitada.",{"_2299":48987,"_22571":48947,"_15405":83560,"_5":15294,"_21315":83423,"_1890":83561},[],"Lamassu utiliza dos caminos de autorización según quién implementa el servicio protegido. Comparten principales, políticas y grants, pero no interpretan las reglas de la misma manera.",{"_2299":48988,"_22571":48947,"_15405":83563,"_5":15294,"_21315":83423,"_1890":83564},[],"Un servicio externo puede quedar protegido sin conocer el modelo interno de autorización de Lamassu. Un servicio desarrollado por Lamassu integra el motor de autorización y puede decidir sobre recursos concretos y filtrar sus consultas.",{"_2299":48989,"_22571":48947,"_15405":83566,"_5":15294,"_21315":83427,"_1890":83567},[],"Este camino protege APIs que se incorporan a la plataforma a través del Gateway pero que no implementan de forma nativa el SDK de autorización de Lamassu. Job Manager es el ejemplo actual. El mismo patrón permite integrar otros servicios HTTP siempre que sus rutas estén descritas en un esquema HTTP de `authz`.",{"_2299":48990,"_22571":48947,"_15405":83569,"_5":15294,"_21315":83427,"_1890":83570},[],"La decisión se toma **antes de reenviar la petición al servicio**:",{"_2299":48991,"_22571":48947,"_15405":83572,"_5":15294,"_21315":83427,"_1890":83573},[],"Envoy Gateway autentica la petición, normalmente validando un JWT contra el JWKS del proveedor OIDC.",{"_2299":48992,"_22571":48947,"_15405":83575,"_5":15294,"_21315":83427,"_1890":83576},[],"Para una ruta protegida, Envoy envía el método, la URL, las cabeceras y los datos necesarios a `/v1/ext_authz/check`.",{"_2299":48993,"_22571":48947,"_15405":83578,"_5":15294,"_21315":83427,"_1890":83579},[],"`authz` extrae la credencial y resuelve todos los principales activos que coinciden con ella.",{"_2299":48994,"_22571":48947,"_15405":83581,"_5":15294,"_21315":83427,"_1890":83582},[],"Carga por separado las políticas concedidas a cada principal.",{"_2299":48995,"_22571":48947,"_15405":83584,"_5":15294,"_21315":83427,"_1890":83585},[],"El esquema HTTP traduce la combinación de método y ruta a una acción lógica, como `nbi-job-read` o `nbi-workflow-create`.",{"_2299":48996,"_22571":48947,"_15405":83587,"_5":15294,"_21315":83427,"_1890":83588},[],"`authz` busca una regla HTTP que conceda esa acción.",{"_2299":48997,"_22571":48947,"_15405":83590,"_5":15294,"_21315":83427,"_1890":83591},[],"Si la ruta declara restricciones, compara datos de la petición con los atributos normalizados del mismo principal que aporta la política.",{"_2299":48998,"_22571":48947,"_15405":83593,"_5":15294,"_21315":83427,"_1890":83594},[],"Un resultado satisfactorio permite a Envoy reenviar la petición; cualquier otra respuesta la bloquea en el Gateway.",{"_2299":48999,"_22571":48947,"_15405":83596,"_5":15294,"_21315":83427,"_1890":83597},[],"Cuando permite el acceso, `authz` devuelve el principal seleccionado en `x-current-user`. El Gateway puede propagar esa cabecera al servicio para conservar el contexto de identidad.",{"_2299":49000,"_22571":48947,"_15405":83599,"_5":15294,"_21315":83427,"_1890":83600},[],"Las reglas HTTP responden principalmente a &#x2A;*“¿puede esta identidad llamar a esta operación de la API?”**. Por sí solas no generan filtros sobre la base de datos del servicio externo. Para limitar una ruta a un dispositivo, tenant o cliente concreto, el esquema debe declarar una restricción que relacione un valor de la petición con un atributo normalizado del principal.",{"_2299":49001,"_22571":48947,"_15405":83602,"_5":15294,"_21315":83431,"_1890":83603},[],"Los servicios nativos de Lamassu integran autorización en su middleware y conocen las entidades sobre las que operan: certificados, CAs, perfiles de emisión, claves, dispositivos, DMS o suscripciones, entre otras.",{"_2299":49002,"_22571":48947,"_15405":83605,"_5":15294,"_21315":83431,"_1890":83606},[],"La decisión se toma con el contexto de la operación de dominio:",{"_2299":49003,"_22571":48947,"_15405":83608,"_5":15294,"_21315":83431,"_1890":83609},[],"El middleware extrae la credencial y resuelve los principales coincidentes.",{"_2299":49004,"_22571":48947,"_15405":83611,"_5":15294,"_21315":83431,"_1890":83612},[],"El endpoint identifica la acción, el tipo de entidad y, cuando corresponde, la clave del recurso solicitado.",{"_2299":49005,"_22571":48947,"_15405":83614,"_5":15294,"_21315":83431,"_1890":83615},[],"`authz` reúne las reglas de entidad de las políticas concedidas.",{"_2299":49006,"_22571":48947,"_15405":83617,"_5":15294,"_21315":83431,"_1890":83618},[],"El motor evalúa grants directos, filtros por atributos y relaciones con otras entidades.",{"_2299":49007,"_22571":48947,"_15405":83620,"_5":15294,"_21315":83431,"_1890":83621},[],"Para una operación individual, comprueba que el recurso concreto satisface el alcance calculado.",{"_2299":49008,"_22571":48947,"_15405":83623,"_5":15294,"_21315":83431,"_1890":83624},[],"Para un listado, genera un filtro SQL que el servicio añade a su propia consulta.",{"_2299":49009,"_22571":48947,"_15405":83626,"_5":15294,"_21315":83431,"_1890":83627},[],"Aquí el motor responde a &#x2A;*“¿puede esta identidad realizar esta acción sobre este recurso concreto?”**.",{"_2299":49010,"_22571":48947,"_15405":83629,"_5":15294,"_21315":83431,"_1890":83630},[],"Las acciones se dividen en dos grupos:",{"_2299":49011,"_22571":48947,"_15405":83632,"_5":15294,"_21315":83431,"_1890":83633},[],"Las **acciones globales** no necesitan un identificador de recurso. `create`, `import` o el acceso a una sección de la interfaz son ejemplos habituales.",{"_2299":49012,"_22571":48947,"_15405":83635,"_5":15294,"_21315":83431,"_1890":83636},[],"Las **acciones atómicas** se evalúan sobre una instancia concreta. En certificados aparecen `read`, `metadata-update`, `status-update` y `delete`; para una CA también existen `sign`, `reissue` y otras operaciones de ciclo de vida.",{"_2299":49013,"_22571":48947,"_15405":83638,"_5":15294,"_21315":83431,"_1890":83639},[],"El filtrado dentro del servicio evita fugas en listados: los recursos no autorizados quedan fuera de la consulta SQL en lugar de recuperarse y ocultarse después en la interfaz.",{"_2299":49014,"_22571":48947,"_15405":83641,"_5":15294,"_21315":83435,"_1890":83642},[],"No son dos controles equivalentes aplicados dos veces. Las reglas HTTP protegen el perímetro de un servicio integrado; las reglas de entidad expresan permisos sobre el modelo de datos de los servicios nativos.",{"_2299":49015,"_22571":48947,"_15405":83644,"_5":15294,"_21315":83435,"_1890":83645},[],"Una política puede contener ambos tipos de reglas cuando una identidad necesita operar recursos de Lamassu y también llamar a una API integrada. Conceder una regla de entidad no concede automáticamente una acción HTTP, ni una regla HTTP crea acceso sobre una entidad.",{"_2299":49016,"_22571":48947,"_15405":83647,"_5":15294,"_21315":83435,"_1890":83648},[],"Si ninguna combinación de principal, política y regla permite la operación, Lamassu la deniega. Además, `auth.externalAuthorization.failOpen` vale `false` por defecto: si `authz` no está disponible, el Gateway bloquea las rutas protegidas.",{"_2299":49017,"_22571":48947,"_15405":83650,"_5":15294,"_21315":83439,"_1890":83651},[],"Un principal OIDC coincide con los claims de un JWT validado. Es apropiado para usuarios humanos, grupos corporativos, roles del IdP y cuentas de servicio que obtienen tokens.",{"_2299":49018,"_22571":48947,"_15405":83653,"_5":15294,"_21315":83439,"_1890":83654},[],"El siguiente principal representa a cualquier identidad que tenga el rol `pki-operators` en Keycloak:",{"_2299":49019,"_22571":48947,"_15405":83656,"_5":15294,"_21315":83439,"_1890":83657},[],"Las rutas de claims pueden estar anidadas, como `realm_access.roles`. Dentro de un mismo principal, **todas** las condiciones deben cumplirse. Esto permite exigir, por ejemplo, un grupo y una audiencia organizativa a la vez.",{"_2299":49020,"_22571":48947,"_15405":83659,"_5":15294,"_21315":83439,"_1890":83660},[],"Los operadores implementados son:",{"_2299":49021,"_22571":48947,"_15405":83662,"_5":15294,"_21315":83439,"_1890":83663},[],"`equals`, para igualdad exacta;",{"_2299":49022,"_22571":48947,"_15405":83665,"_5":15294,"_21315":83439,"_1890":83666},[],"`contains`, para comprobar la pertenencia a una lista o la presencia de texto en un valor escalar.",{"_2299":49023,"_22571":48947,"_15405":83668,"_5":15294,"_21315":83439,"_1890":83669},[],"Diseña la coincidencia con atributos estables. Para personas, suele ser mejor enlazar permisos a grupos o roles gestionados centralmente que al correo o al nombre de usuario. Para una cuenta de servicio, un `sub` estable evita que sus permisos se mezclen con los de un operador humano.",{"_2299":49024,"_22571":48947,"_15405":83671,"_5":15294,"_21315":83439,"_1890":83672},[],"Aunque el modelo reconoce el nombre de operador `matches`, la implementación actual no evalúa expresiones regulares y la condición nunca coincide. Usa `equals` o `contains`.",{"_2299":49025,"_22571":48947,"_15405":83674,"_5":15294,"_21315":83443,"_1890":83675},[],"Un principal X.509 permite reconocer una carga de trabajo o un dispositivo mediante su certificado cliente. Lamassu comprueba la firma del certificado contra la CA configurada y, según el modo, también su número de serie o Common Name.",{"_2299":49026,"_22571":48947,"_15405":83677,"_5":15294,"_21315":83443,"_1890":83678},[],"Los modos disponibles son:",{"_2299":49027,"_22571":48947,"_15405":83680,"_5":15294,"_21315":83443,"_1890":83681},[],"`serial_and_ca`: un certificado exacto, identificado por número de serie y CA;",{"_2299":49028,"_22571":48947,"_15405":83683,"_5":15294,"_21315":83443,"_1890":83684},[],"`cn_and_ca`: un Common Name exacto o con comodines y una CA concreta;",{"_2299":49029,"_22571":48947,"_15405":83686,"_5":15294,"_21315":83443,"_1890":83687},[],"`any_from_ca`: cualquier certificado emitido directamente por la CA indicada.",{"_2299":49030,"_22571":48947,"_15405":83689,"_5":15294,"_21315":83443,"_1890":83690},[],"Este ejemplo reconoce certificados cuyo CN comienza por `factory-a-` y que están firmados por la CA configurada:",{"_2299":49031,"_22571":48947,"_15405":83692,"_5":15294,"_21315":83443,"_1890":83693},[],"`ca_trust.identity_type` acepta `fingerprint` o `authority_key_id`. En ambos casos debes aportar el certificado de la CA en `ca_trust.pem`; Lamassu verifica tanto la firma como la identidad esperada de la CA.",{"_2299":49032,"_22571":48947,"_15405":83695,"_5":15294,"_21315":83443,"_1890":83696},[],"Usa `any_from_ca` únicamente cuando todas las identidades emitidas por esa CA deban compartir los mismos permisos. Si una CA emite certificados para poblaciones distintas, separa el acceso por serie o CN, o utiliza CAs de emisión diferentes.",{"_2299":49033,"_22571":48947,"_15405":83698,"_5":15294,"_21315":83447,"_1890":83699},[],"Una misma credencial puede coincidir con más de un principal. Es habitual que un usuario coincida con un principal de su equipo y con otro de su función operativa.",{"_2299":49034,"_22571":48947,"_15405":83701,"_5":15294,"_21315":83447,"_1890":83702},[],"Para permisos de entidad, Lamassu combina los permisos con lógica OR: basta con que una de las políticas de uno de los principales permita la acción. Los listados contienen la unión de los recursos visibles para todos ellos.",{"_2299":49035,"_22571":48947,"_15405":83704,"_5":15294,"_21315":83447,"_1890":83705},[],"Las rutas HTTP con restricciones son más estrictas. El mismo principal que aporta la política debe satisfacer también los atributos exigidos por la ruta. Lamassu no combina la política de un principal con un atributo perteneciente a otro.",{"_2299":49036,"_22571":48947,"_15405":83707,"_5":15294,"_21315":83447,"_1890":83708},[],"Por esta razón, añadir un principal coincidente solo puede ampliar el acceso. Antes de crear reglas solapadas, revisa el conjunto completo de políticas que recibirá una identidad real.",{"_2299":49037,"_22571":48947,"_15405":83710,"_5":15294,"_21315":83455,"_1890":83711},[],"Una regla identifica el dominio (`namespace`), el esquema de datos (`schema_name`) y el tipo de entidad (`entity_type`). `actions` enumera las operaciones permitidas.",{"_2299":49038,"_22571":48947,"_15405":83713,"_5":15294,"_21315":83455,"_1890":83714},[],"`direct_grants` limita la regla a identificadores concretos. El valor `*` abarca todas las instancias del tipo. Una política de superadministrador utiliza comodines en esquema, entidad, acciones y grants; una política de mínimo privilegio debe evitarlos siempre que sea posible.",{"_2299":49039,"_22571":48947,"_15405":83716,"_5":15294,"_21315":83459,"_1890":83717},[],"Las reglas pueden seguir relaciones declaradas entre entidades. Por ejemplo, el esquema conoce la relación de un certificado con su CA emisora y la de un dispositivo con su DMS. Una política puede conceder acceso a un recurso padre y propagar acciones seleccionadas hacia sus recursos relacionados.",{"_2299":49040,"_22571":48947,"_15405":83719,"_5":15294,"_21315":83459,"_1890":83720},[],"Esto permite expresar modelos como “puede operar los dispositivos de este DMS” sin mantener una lista individual de cada dispositivo. Cuando se añade un recurso bajo esa relación, hereda el alcance previsto por la política.",{"_2299":49041,"_22571":48947,"_15405":83722,"_5":15294,"_21315":83463,"_1890":83723},[],"`column_filters` aplica condiciones a columnas que el esquema haya declarado como filtrables. Todos los filtros de una misma regla se combinan con AND.",{"_2299":49042,"_22571":48947,"_15405":83725,"_5":15294,"_21315":83463,"_1890":83726},[],"Por ejemplo, esta regla permite leer certificados activos emitidos por una CA concreta:",{"_2299":49043,"_22571":48947,"_15405":83728,"_5":15294,"_21315":83463,"_1890":83729},[],"Los operadores disponibles son `eq`, `neq`, `gt`, `gte`, `lt`, `lte`, `in` y `like`. Usa comparaciones coherentes con el tipo de columna: `like` para texto, comparaciones de orden para números o fechas y `in` cuando haya una colección de valores aceptados.",{"_2299":49044,"_22571":48947,"_15405":83731,"_5":15294,"_21315":83467,"_1890":83732},[],"Las reglas HTTP no apuntan directamente a tablas. Referencian un esquema de rutas y conceden sus acciones lógicas. Las políticas del Job Manager son un ejemplo: distinguen lectura, creación, actualización y eliminación de workflows o jobs.",{"_2299":49045,"_22571":48947,"_15405":83734,"_5":15294,"_21315":83467,"_1890":83735},[],"Algunas rutas también comparan un valor de la petición —extraído de la ruta, query, cabecera o cuerpo JSON— con un atributo normalizado del principal. Así puede verificarse que un dispositivo solo consulte trabajos dirigidos a su propio `client_id`.",{"_2299":49046,"_22571":48947,"_15405":83737,"_5":15294,"_21315":83467,"_1890":83738},[],"Los atributos normalizados desacoplan la política del mecanismo de autenticación. `subject_attribute_mappings` puede derivar, por ejemplo, `device_id` desde `oidc.claim.device_id` o desde `x509.subject.cn`. La regla consume `device_id` en ambos casos.",{"_2299":49047,"_22571":48947,"_15405":83740,"_5":15294,"_21315":83471,"_1890":83741},[],"La precarga de `authz` instala políticas reutilizables para los dominios principales. Entre ellas se encuentran:",{"_2299":49048,"_22571":48947,"_15405":83743,"_5":15294,"_21315":83471,"_1890":83744},[],"acceso completo y de solo lectura a certificados y autoridades;",{"_2299":49049,"_22571":48947,"_15405":83746,"_5":15294,"_21315":83471,"_1890":83747},[],"acceso completo y de solo lectura a KMS;",{"_2299":49050,"_22571":48947,"_15405":83749,"_5":15294,"_21315":83471,"_1890":83750},[],"acceso completo y de solo lectura a Device Manager, DMS Manager, Validation Authority y alertas;",{"_2299":49051,"_22571":48947,"_15405":83752,"_5":15294,"_21315":83471,"_1890":83753},[],"una política `Auditor` de lectura de PKI y visibilidad de autorización;",{"_2299":49052,"_22571":48947,"_15405":83755,"_5":15294,"_21315":83471,"_1890":83756},[],"acceso a la interfaz;",{"_2299":49053,"_22571":48947,"_15405":83758,"_5":15294,"_21315":83471,"_1890":83759},[],"políticas de administración y observación para las APIs NBI y SBI del Job Manager;",{"_2299":49054,"_22571":48947,"_15405":83761,"_5":15294,"_21315":83471,"_1890":83762},[],"`SUPER ADMIN`, que concede todas las acciones sobre los dominios `authz` y `pki`.",{"_2299":49055,"_22571":48947,"_15405":83764,"_5":15294,"_21315":83471,"_1890":83765},[],"Empieza por estas políticas antes de crear otras. Si ninguna refleja el límite que necesitas, crea una política específica y pequeña en lugar de copiar `SUPER ADMIN` y retirar permisos de forma informal.",{"_2299":49056,"_22571":48947,"_15405":83767,"_5":15294,"_21315":83475,"_1890":83768},[],"Una instalación sin un principal que coincida con tu identidad queda sin nadie capaz de administrar la autorización. Configura el IdP y el bootstrap antes de exponer la plataforma.",{"_2299":49057,"_22571":48947,"_15405":83770,"_5":15294,"_21315":83475,"_1890":83771},[],"El chart incluye un principal de bootstrap que busca el rol OIDC `pki-admin` en `realm_access.roles`. Le concede `SUPER ADMIN` y, cuando Job Manager está habilitado, la política administrativa de su API NBI.",{"_2299":49058,"_22571":48947,"_15405":83773,"_5":15294,"_21315":83475,"_1890":83774},[],"El Job Helm de preinstalación y preactualización ejecuta las migraciones de `authz`, precarga las políticas y crea los principales de bootstrap antes de iniciar los servicios. Si el principal ya existe, no lo reemplaza: añade únicamente los grants configurados que todavía falten. Puedes conservar la entrada en `values.yaml` durante las actualizaciones.",{"_2299":49059,"_22571":48947,"_15405":83776,"_5":15294,"_21315":83478,"_1890":83777},[],"Crea el rol o grupo que utilizarás para recuperar y administrar Lamassu. Asígnalo al menos a dos identidades humanas controladas. Si tu proveedor no usa `realm_access.roles`, adapta la ruta del claim tanto en el frontend como en `auth_config.claims`.",{"_2299":49060,"_22571":48947,"_15405":83779,"_5":15294,"_21315":83482,"_1890":83780},[],"El Gateway utiliza `auth.authentication.apiGateway.jwks` para autenticar peticiones. `authz` utiliza `services.authz.jwkUrl` para resolver los principales OIDC. Ambos endpoints deben contener las claves del mismo emisor y ser alcanzables desde sus respectivos componentes.",{"_2299":49061,"_22571":48947,"_15405":83782,"_5":15294,"_21315":83486,"_1890":83783},[],"Inicia sesión con una identidad que tenga `pki-admin`. Confirma que puede acceder a la administración de autorización y realizar una operación de lectura no destructiva.",{"_2299":49062,"_22571":48947,"_15405":83785,"_5":15294,"_21315":83490,"_1890":83786},[],"Usa un segundo usuario sin el rol y confirma que la misma operación queda denegada. Esta prueba detecta claims mal interpretados, políticas demasiado amplias y configuraciones `failOpen` accidentales.",{"_2299":49063,"_22571":48947,"_15405":83788,"_5":15294,"_21315":83494,"_1890":83789},[],"Crea principales operativos con políticas de menor alcance. Reserva `pki-admin` para administración de autorización y recuperación, no para el trabajo diario.",{"_2299":49064,"_22571":48947,"_15405":83791,"_5":15294,"_21315":83498,"_1890":83792},[],"Fastlane instala un realm de Keycloak para laboratorio y crea el usuario `lamassu` con contraseña temporal `lamassu`, rol `pki-admin` y cambio de contraseña obligatorio. Su principal de bootstrap coincide mediante `preferred_username=lamassu`.",{"_2299":49065,"_22571":48947,"_15405":83794,"_5":15294,"_21315":83498,"_1890":83795},[],"Cambia la contraseña en el primer acceso. No reutilices el usuario, la contraseña ni el IdP de Fastlane como diseño de producción.",{"_2299":49066,"_22571":48947,"_15405":83797,"_5":15294,"_21315":83502,"_1890":83798},[],"Evita reproducir la estructura interna de tu empresa con decenas de políticas casi idénticas. Empieza por las responsabilidades que realmente necesitan acceso:",{"_2299":49067,"_22571":48947,"_15405":83800,"_5":15294,"_21315":83502,"_1890":83801},[],"**Administración de autorización**: gestiona principales, políticas y grants. Debe pertenecer a un grupo pequeño y separado.",{"_2299":49068,"_22571":48947,"_15405":83803,"_5":15294,"_21315":83502,"_1890":83804},[],"**Operación de PKI**: administra CAs, perfiles y certificados, pero no necesariamente puede modificar quién obtiene acceso.",{"_2299":49069,"_22571":48947,"_15405":83806,"_5":15294,"_21315":83502,"_1890":83807},[],"**Registro de dispositivos**: opera dispositivos y DMS sin recibir permisos sobre claves o configuración de autorización.",{"_2299":49070,"_22571":48947,"_15405":83809,"_5":15294,"_21315":83502,"_1890":83810},[],"**Auditoría**: consulta configuración y actividad sin crear, modificar, firmar, revocar ni eliminar.",{"_2299":49071,"_22571":48947,"_15405":83812,"_5":15294,"_21315":83502,"_1890":83813},[],"**Automatización**: utiliza una cuenta técnica o certificado independiente, con permisos limitados al flujo y recursos que controla.",{"_2299":49072,"_22571":48947,"_15405":83815,"_5":15294,"_21315":83502,"_1890":83816},[],"Para cada rol, separa “ver” de “cambiar”, limita los recursos mediante grants, relaciones o atributos y evita `*` salvo que el rol deba abarcar futuras acciones automáticamente.",{"_2299":49073,"_22571":48947,"_15405":83818,"_5":15294,"_21315":83502,"_1890":83819},[],"Una regla con `actions: [\"*\"]` se expande a todas las acciones definidas por el esquema. Cuando una versión nueva añade una acción, una política con comodín puede empezar a concederla. Revisa estas políticas durante cada actualización.",{"_2299":49074,"_22571":48947,"_15405":83821,"_5":15294,"_21315":83506,"_1890":83822},[],"Para retirar acceso de inmediato, desactiva el principal o revoca sus grants. Desactivar un principal conserva su configuración y asociaciones para investigación o restauración, pero deja de participar en la coincidencia.",{"_2299":49075,"_22571":48947,"_15405":83824,"_5":15294,"_21315":83506,"_1890":83825},[],"Eliminar un rol o grupo en el IdP evita que nuevos tokens contengan el claim, pero un token ya emitido puede seguir siendo válido hasta expirar. Si la retirada es urgente, combina el cambio en el IdP con la desactivación del principal en Lamassu y la revocación de sesiones o tokens en el proveedor.",{"_2299":49076,"_22571":48947,"_15405":83827,"_5":15294,"_21315":83506,"_1890":83828},[],"Cuando edites una política compartida, recuerda que el cambio afecta a todos sus principales. Para probar un nuevo alcance, crea una política separada, concédela a una identidad de prueba y valida operaciones permitidas y denegadas antes de sustituir la anterior.",{"_2299":49077,"_22571":48947,"_15405":83830,"_5":15294,"_21315":83510,"_1890":83831},[],"Mantén `failOpen: false` salvo que una evaluación de riesgo documentada justifique lo contrario.",{"_2299":49078,"_22571":48947,"_15405":83833,"_5":15294,"_21315":83510,"_1890":83834},[],"Usa grupos o roles estables para personas e identidades independientes para automatizaciones.",{"_2299":49079,"_22571":48947,"_15405":83836,"_5":15294,"_21315":83510,"_1890":83837},[],"Conserva al menos dos administradores de recuperación y prueba su acceso periódicamente.",{"_2299":49080,"_22571":48947,"_15405":83839,"_5":15294,"_21315":83510,"_1890":83840},[],"Revisa los principales activos, sus coincidencias y sus grants después de cambios en el IdP.",{"_2299":49081,"_22571":48947,"_15405":83842,"_5":15294,"_21315":83510,"_1890":83843},[],"Busca comodines en políticas antes de actualizar Lamassu.",{"_2299":49082,"_22571":48947,"_15405":83845,"_5":15294,"_21315":83510,"_1890":83846},[],"Prueba siempre una operación permitida y otra denegada para cada rol.",{"_2299":49083,"_22571":48947,"_15405":83848,"_5":15294,"_21315":83510,"_1890":83849},[],"Correlaciona los cambios de principales, políticas y grants con los registros de auditoría.",{"_2299":49084,"_22571":48947,"_15405":83851,"_5":15294,"_21315":83518,"_1890":83852},[],"La autenticación falló antes de evaluar permisos. Comprueba la firma y expiración del JWT, el emisor, la audiencia y la disponibilidad del JWKS configurado en el Gateway. Para X.509, revisa que el certificado cliente llegue hasta el punto que extrae la credencial.",{"_2299":49085,"_22571":48947,"_15405":83854,"_5":15294,"_21315":83522,"_1890":83855},[],"La credencial pudo procesarse, pero no produjo una autorización positiva. Revisa en este orden:",{"_2299":49086,"_22571":48947,"_15405":83857,"_5":15294,"_21315":83522,"_1890":83858},[],"que exista un principal activo del tipo correcto;",{"_2299":49087,"_22571":48947,"_15405":83860,"_5":15294,"_21315":83522,"_1890":83861},[],"que las rutas de claims y sus valores coincidan exactamente con el token real;",{"_2299":49088,"_22571":48947,"_15405":83863,"_5":15294,"_21315":83522,"_1890":83864},[],"que todas las condiciones del principal se cumplan;",{"_2299":49089,"_22571":48947,"_15405":83866,"_5":15294,"_21315":83522,"_1890":83867},[],"que el principal tenga concedida la política esperada;",{"_2299":49090,"_22571":48947,"_15405":83869,"_5":15294,"_21315":83522,"_1890":83870},[],"que la política incluya la acción y el tipo de recurso o ruta solicitados;",{"_2299":49091,"_22571":48947,"_15405":83872,"_5":15294,"_21315":83522,"_1890":83873},[],"que el identificador, relación, filtro de columna o restricción HTTP incluya el recurso real.",{"_2299":49092,"_22571":48947,"_15405":83875,"_5":15294,"_21315":83522,"_1890":83876},[],"En los logs de `authz`, una decisión del endpoint externo incluye `allowed`, `reason`, `matched_principals`, `evaluated_policy_ids`, `matched_policy_id` y el código de estado. Estos campos permiten separar un fallo de coincidencia de un fallo de permisos.",{"_2299":49093,"_22571":48947,"_15405":83878,"_5":15294,"_21315":83526,"_1890":83879},[],"Comprueba que el principal de bootstrap fue creado y que las políticas fueron precargadas por el Job de migración. Verifica también que `services.authz.jwkUrl` sea alcanzable desde el pod de `authz`; no asumas que una URL pública accesible desde el navegador también funciona dentro del clúster.",{"_2299":49094,"_22571":48947,"_15405":83881,"_5":15294,"_21315":83530,"_1890":83882},[],"Es el comportamiento esperado con `failOpen: false`. Restaura el servicio, su conexión con PostgreSQL y su conectividad con el JWKS. No cambies temporalmente a `failOpen: true` sin aceptar que las rutas protegidas podrían quedar accesibles sin decisión de autorización.",{"_2299":49095,"_22571":48947,"_15405":83884,"_5":15294,"_21315":83530,"_1890":83885},[],"Continúa con Registros de auditoría para investigar cambios de configuración o con Resolución de problemas para diagnosticar el despliegue.",{"_2299":49096,"_22571":49096,"_5":10616,"_1890":83887,"_22830":83888,"_15405":83890,"_21315":49096},"Alertas y suscripciones",[35156,83411,83889],"Operar Lamassu",[],{"_2299":49097,"_22571":49096,"_15405":83892,"_5":15294,"_21315":49096,"_1890":83893},[],"Envía eventos de la PKI a personas y sistemas externos.",{"_2299":49098,"_22571":49096,"_5":22827,"_15405":83895,"_21315":83896,"_1890":83897},[],"/docs/es/platform/pki/alerts#cómo-funciona","Cómo funciona",{"_2299":49099,"_22571":49096,"_5":22827,"_15405":83899,"_21315":83900,"_1890":83901},[],"/docs/es/platform/pki/alerts#canales-disponibles","Canales disponibles",{"_2299":49100,"_22571":49096,"_5":22827,"_15405":83903,"_21315":83904,"_1890":83905},[],"/docs/es/platform/pki/alerts#crea-una-suscripción","Crea una suscripción",{"_2299":49101,"_22571":49096,"_5":22827,"_15405":83907,"_21315":83908,"_1890":83909},[],"/docs/es/platform/pki/alerts#elige-el-evento","Elige el evento",{"_2299":49102,"_22571":49096,"_5":22827,"_15405":83911,"_21315":83912,"_1890":83913},[],"/docs/es/platform/pki/alerts#configura-el-destino","Configura el destino",{"_2299":49103,"_22571":49096,"_5":22827,"_15405":83915,"_21315":83916,"_1890":83917},[],"/docs/es/platform/pki/alerts#limita-las-notificaciones","Limita las notificaciones",{"_2299":49104,"_22571":49096,"_5":22827,"_15405":83919,"_21315":83920,"_1890":83921},[],"/docs/es/platform/pki/alerts#revisa-y-activa","Revisa y activa",{"_2299":49105,"_22571":49096,"_5":22827,"_15405":83923,"_21315":83924,"_1890":83925},[],"/docs/es/platform/pki/alerts#gestiona-una-suscripción","Gestiona una suscripción",{"_2299":49106,"_22571":49096,"_5":22827,"_15405":83927,"_21315":83928,"_1890":83929},[],"/docs/es/platform/pki/alerts#familias-de-eventos","Familias de eventos",{"_2299":49107,"_22571":49096,"_15405":83931,"_5":15294,"_21315":49096,"_1890":83932},[],"Las suscripciones convierten los eventos de Lamassu en notificaciones accionables. Puedes avisar a un equipo, alimentar un sistema de incidentes o activar una automatización cuando cambia una CA, un certificado o un dispositivo.",{"_2299":49108,"_22571":49096,"_15405":83934,"_5":15294,"_21315":83896,"_1890":83935},[],"Un servicio publica un evento de dominio.",{"_2299":49109,"_22571":49096,"_15405":83937,"_5":15294,"_21315":83896,"_1890":83938},[],"Lamassu evalúa las suscripciones asociadas a ese tipo de evento.",{"_2299":49110,"_22571":49096,"_15405":83940,"_5":15294,"_21315":83896,"_1890":83941},[],"El filtro de cada suscripción decide si debe notificarse.",{"_2299":49111,"_22571":49096,"_15405":83943,"_5":15294,"_21315":83896,"_1890":83944},[],"Lamassu entrega el evento al canal configurado.",{"_2299":49112,"_22571":49096,"_15405":83946,"_5":15294,"_21315":83896,"_1890":83947},[],"El inventario de eventos muestra cuándo se observó cada tipo por última vez, cuántas veces ha ocurrido y cuántas suscripciones tiene. Puedes expandir un evento para inspeccionar un ejemplo de su payload JSON antes de crear el filtro.",{"_2299":49113,"_22571":49096,"_15405":83949,"_5":15294,"_21315":83900,"_1890":83950},[],"**Email** envía avisos a una persona o lista operativa. Solo requiere la dirección de destino.",{"_2299":49114,"_22571":49096,"_15405":83952,"_5":15294,"_21315":83900,"_1890":83953},[],"**Microsoft Teams** publica la notificación en un canal mediante su URL de webhook.",{"_2299":49115,"_22571":49096,"_15405":83955,"_5":15294,"_21315":83900,"_1890":83956},[],"**Webhook** entrega el evento a una automatización, SIEM o sistema de incidentes mediante `POST` o `PUT`.",{"_2299":49116,"_22571":49096,"_15405":83958,"_5":15294,"_21315":83908,"_1890":83959},[],"Abre **Alerts**, localiza el tipo de evento y selecciona **Subscribe**. Revisa el último ejemplo JSON para identificar los campos que necesitarás filtrar.",{"_2299":49117,"_22571":49096,"_15405":83961,"_5":15294,"_21315":83912,"_1890":83962},[],"Selecciona Email, Microsoft Teams o Webhook e introduce los datos del canal.",{"_2299":49118,"_22571":49096,"_15405":83964,"_5":15294,"_21315":83916,"_1890":83965},[],"Añade un filtro si no quieres recibir todas las instancias del evento.",{"_2299":49119,"_22571":49096,"_15405":83967,"_5":15294,"_21315":83916,"_1890":83968},[],"**None** notifica todas las instancias del evento.",{"_2299":49120,"_22571":49096,"_15405":83970,"_5":15294,"_21315":83916,"_1890":83971},[],"**JSON Path** evalúa uno o varios campos concretos.",{"_2299":49121,"_22571":49096,"_15405":83973,"_5":15294,"_21315":83916,"_1890":83974},[],"**JSON Schema** acepta únicamente payloads con una estructura determinada.",{"_2299":49122,"_22571":49096,"_15405":83976,"_5":15294,"_21315":83916,"_1890":83977},[],"**JavaScript** permite expresar lógica personalizada.",{"_2299":49123,"_22571":49096,"_15405":83979,"_5":15294,"_21315":83916,"_1890":83980},[],"Por ejemplo, `function (event) { return event.data.status == \"NO_IDENTITY\"; }` limita una suscripción a dispositivos sin identidad.",{"_2299":49124,"_22571":49096,"_15405":83982,"_5":15294,"_21315":83920,"_1890":83983},[],"Comprueba el evento, el canal y el filtro en el resumen. Selecciona **Confirm Subscription** para comenzar la entrega.",{"_2299":49125,"_22571":49096,"_15405":83985,"_5":15294,"_21315":83924,"_1890":83986},[],"Abre una suscripción existente para consultar su destino y filtro, modificar la configuración o seleccionar **Unsubscribe**. Elimina las suscripciones que ya no tengan un propietario operativo para evitar entregas ignoradas o endpoints obsoletos.",{"_2299":49126,"_22571":49096,"_15405":83988,"_5":15294,"_21315":83928,"_1890":83989},[],"**Autoridades:** `ca.create`, `ca.import`, `ca.reissue` y `ca.delete`.",{"_2299":49127,"_22571":49096,"_15405":83991,"_5":15294,"_21315":83928,"_1890":83992},[],"**Certificados:** `ca.sign.certificate` y `certificate.delete`.",{"_2299":49128,"_22571":49096,"_15405":83994,"_5":15294,"_21315":83928,"_1890":83995},[],"**Perfiles:** `profile.create`, `profile.update` y `profile.delete`.",{"_2299":49129,"_22571":49096,"_15405":83997,"_5":15294,"_21315":83928,"_1890":83998},[],"**Enrolamiento:** `dms.create`, `dms.update`, `dms.enroll` y `dms.reenroll`.",{"_2299":49130,"_22571":49096,"_15405":84000,"_5":15294,"_21315":83928,"_1890":84001},[],"**Dispositivos:** `device.create`, `device.identity.update` y `device.status.update`.",{"_2299":49131,"_22571":49096,"_15405":84003,"_5":15294,"_21315":83928,"_1890":84004},[],"**Validación:** `va.role.crl.create`.",{"_2299":49132,"_22571":49096,"_15405":84006,"_5":15294,"_21315":83928,"_1890":84007},[],"**Claves:** `kms.create`, `kms.import`, `kms.sign.message` y `kms.delete`.",{"_2299":49133,"_22571":49096,"_15405":84009,"_5":15294,"_21315":83928,"_1890":84010},[],"Utiliza el catálogo que muestra la consola como fuente para los tipos disponibles en la versión que tienes desplegada.",{"_2299":49134,"_22571":49134,"_5":10616,"_1890":84012,"_22830":84013,"_15405":84014,"_21315":49134},"Registros de auditoría",[35156,83411,83412],[],{"_2299":49135,"_22571":49134,"_15405":84016,"_5":15294,"_21315":49134,"_1890":84017},[],"Entiende qué eventos de auditoría genera Lamassu y cómo convertirlos en una pista durable.",{"_2299":49136,"_22571":49134,"_5":22827,"_15405":84019,"_21315":84020,"_1890":84021},[],"/docs/es/platform/pki/audit-logs#qué-contiene-un-evento","Qué contiene un evento",{"_2299":49137,"_22571":49134,"_5":22827,"_15405":84023,"_21315":84024,"_1890":84025},[],"/docs/es/platform/pki/audit-logs#cobertura","Cobertura",{"_2299":49138,"_22571":49134,"_5":22827,"_15405":84027,"_21315":84028,"_1890":84029},[],"/docs/es/platform/pki/audit-logs#publicación-y-persistencia","Publicación y persistencia",{"_2299":49139,"_22571":49134,"_5":22827,"_15405":84031,"_21315":84032,"_1890":84033},[],"/docs/es/platform/pki/audit-logs#datos-sensibles","Datos sensibles",{"_2299":49140,"_22571":49134,"_5":22827,"_15405":84035,"_21315":84036,"_1890":84037},[],"/docs/es/platform/pki/audit-logs#una-investigación-reproducible","Una investigación reproducible",{"_2299":49141,"_22571":49134,"_5":22827,"_15405":84039,"_21315":84040,"_1890":84041},[],"/docs/es/platform/pki/audit-logs#acota-el-intervalo","Acota el intervalo",{"_2299":49142,"_22571":49134,"_5":22827,"_15405":84043,"_21315":84044,"_1890":84045},[],"/docs/es/platform/pki/audit-logs#identifica-la-operación","Identifica la operación",{"_2299":49143,"_22571":49134,"_5":22827,"_15405":84047,"_21315":84048,"_1890":84049},[],"/docs/es/platform/pki/audit-logs#atribuye-el-principal","Atribuye el principal",{"_2299":49144,"_22571":49134,"_5":22827,"_15405":84051,"_21315":84052,"_1890":84053},[],"/docs/es/platform/pki/audit-logs#compara-intención-y-resultado","Compara intención y resultado",{"_2299":49145,"_22571":49134,"_5":22827,"_15405":84055,"_21315":84056,"_1890":84057},[],"/docs/es/platform/pki/audit-logs#sigue-el-efecto","Sigue el efecto",{"_2299":49146,"_22571":49134,"_5":22827,"_15405":84059,"_21315":84060,"_1890":84061},[],"/docs/es/platform/pki/audit-logs#verificación-periódica","Verificación periódica",{"_2299":49147,"_22571":49134,"_15405":84063,"_5":15294,"_21315":49134,"_1890":84064},[],"Lamassu instrumenta las operaciones mutables de sus servicios con eventos de auditoría. Cada evento describe la operación, los principales que coincidieron, la entrada, el resultado y si terminó con error.",{"_2299":49148,"_22571":49134,"_15405":84066,"_5":15294,"_21315":84020,"_1890":84067},[],"El cuerpo de auditoría incluye:",{"_2299":49149,"_22571":49134,"_15405":84069,"_5":15294,"_21315":84020,"_1890":84070},[],"input: datos recibidos por la operación;",{"_2299":49150,"_22571":49134,"_15405":84072,"_5":15294,"_21315":84020,"_1890":84073},[],"has\\_error: indica si el servicio devolvió un error;",{"_2299":49151,"_22571":49134,"_15405":84075,"_5":15294,"_21315":84020,"_1890":84076},[],"output: resultado producido o mensaje de error;",{"_2299":49152,"_22571":49134,"_15405":84078,"_5":15294,"_21315":84020,"_1890":84079},[],"principals: identificadores de los principales que coincidieron con la petición.",{"_2299":49153,"_22571":49134,"_15405":84081,"_5":15294,"_21315":84020,"_1890":84082},[],"Las operaciones correctas usan un tipo con prefijo audit.. Los fallos publican el tipo de operación con sufijo .error. El evento CloudEvents añade, además, fuente, identificador, fecha y tipo.",{"_2299":49154,"_22571":49134,"_15405":84084,"_5":15294,"_21315":84020,"_1890":84085},[],"Los middlewares publican el registro después de ejecutar la operación, tanto si tuvo éxito como si devolvió un error. Esto permite investigar intentos además de cambios confirmados.",{"_2299":49155,"_22571":49134,"_15405":84087,"_5":15294,"_21315":84024,"_1890":84088},[],"El backend aplica auditoría a mutaciones de:",{"_2299":49156,"_22571":49134,"_15405":84090,"_5":15294,"_21315":84024,"_1890":84091},[],"autoridades, certificados y perfiles de emisión;",{"_2299":49157,"_22571":49134,"_15405":84093,"_5":15294,"_21315":84024,"_1890":84094},[],"claves y motores KMS;",{"_2299":49158,"_22571":49134,"_15405":84096,"_5":15294,"_21315":84024,"_1890":84097},[],"dispositivos e identidades;",{"_2299":49159,"_22571":49134,"_15405":84099,"_5":15294,"_21315":84024,"_1890":84100},[],"DMS y operaciones de enrolamiento;",{"_2299":49160,"_22571":49134,"_15405":84102,"_5":15294,"_21315":84024,"_1890":84103},[],"funciones de validación y CRL;",{"_2299":49161,"_22571":49134,"_15405":84105,"_5":15294,"_21315":84024,"_1890":84106},[],"principales, políticas y concesiones de autorización.",{"_2299":49162,"_22571":49134,"_15405":84108,"_5":15294,"_21315":84024,"_1890":84109},[],"No confundas estos eventos con los eventos de dominio. Un evento de dominio comunica que un recurso cambió para que otro componente reaccione; el evento de auditoría conserva contexto de entrada, salida y principal para investigación.",{"_2299":49163,"_22571":49134,"_15405":84111,"_5":15294,"_21315":84028,"_1890":84112},[],"Los servicios publican auditoría en el bus de eventos cuando su PublisherEventBus está habilitado. El código del backend no implementa un archivo de auditoría consultable y durable por sí solo.",{"_2299":49164,"_22571":49134,"_15405":84114,"_5":15294,"_21315":84028,"_1890":84115},[],"Si necesitas retención, búsquedas, protección contra alteraciones o exportación regulatoria, conecta un consumidor que persista los eventos en el sistema aprobado por tu organización.",{"_2299":49165,"_22571":49134,"_15405":84117,"_5":15294,"_21315":84028,"_1890":84118},[],"Diseña el consumidor para:",{"_2299":49166,"_22571":49134,"_15405":84120,"_5":15294,"_21315":84028,"_1890":84121},[],"suscribirse a los tipos audit.# y también a los tipos de operación terminados en .error;",{"_2299":49167,"_22571":49134,"_15405":84123,"_5":15294,"_21315":84028,"_1890":84124},[],"conservar el CloudEvent completo sin modificar;",{"_2299":49168,"_22571":49134,"_15405":84126,"_5":15294,"_21315":84028,"_1890":84127},[],"registrar el momento de ingestión y detectar duplicados por ID;",{"_2299":49169,"_22571":49134,"_15405":84129,"_5":15294,"_21315":84028,"_1890":84130},[],"cifrar en tránsito y en reposo;",{"_2299":49170,"_22571":49134,"_15405":84132,"_5":15294,"_21315":84028,"_1890":84133},[],"limitar lectura y borrado a un rol separado del operador de PKI;",{"_2299":49171,"_22571":49134,"_15405":84135,"_5":15294,"_21315":84028,"_1890":84136},[],"aplicar una política explícita de retención y legal hold;",{"_2299":49172,"_22571":49134,"_15405":84138,"_5":15294,"_21315":84028,"_1890":84139},[],"alertar si deja de consumir o aumenta la cola pendiente.",{"_2299":49173,"_22571":49134,"_15405":84141,"_5":15294,"_21315":84032,"_1890":84142},[],"Los campos input y output pueden contener sujetos, metadatos, material público, configuración o mensajes de error. Evalúa su clasificación antes de enviarlos a una plataforma externa.",{"_2299":49174,"_22571":49134,"_15405":84144,"_5":15294,"_21315":84032,"_1890":84145},[],"No registres claves privadas, secretos de proveedores ni tokens completos en automatizaciones que rodean a Lamassu. Restringe la exportación y aplica redacción en el destino sin destruir los campos necesarios para atribución.",{"_2299":49175,"_22571":49134,"_15405":84147,"_5":15294,"_21315":84040,"_1890":84148},[],"Parte de la hora reportada y normaliza todas las fuentes a UTC.",{"_2299":49176,"_22571":49134,"_15405":84150,"_5":15294,"_21315":84044,"_1890":84151},[],"Filtra por tipo de evento, fuente de servicio e identificador del recurso.",{"_2299":49177,"_22571":49134,"_15405":84153,"_5":15294,"_21315":84048,"_1890":84154},[],"Revisa principals y correlaciónalo con el proveedor OIDC o la identidad X.509 vigente en ese momento.",{"_2299":49178,"_22571":49134,"_15405":84156,"_5":15294,"_21315":84052,"_1890":84157},[],"Contrasta input, has\\_error y output. Un intento fallido no implica que el recurso haya cambiado.",{"_2299":49179,"_22571":49134,"_15405":84159,"_5":15294,"_21315":84056,"_1890":84160},[],"Busca los eventos de dominio y registros del servicio que compartan recurso y ventana temporal. En una revocación de CA, incluye las operaciones en cascada.",{"_2299":49180,"_22571":49134,"_15405":84162,"_5":15294,"_21315":84060,"_1890":84163},[],"Genera una mutación controlada en un entorno de prueba y comprueba que:",{"_2299":49181,"_22571":49134,"_15405":84165,"_5":15294,"_21315":84060,"_1890":84166},[],"aparece un evento de auditoría correcto;",{"_2299":49182,"_22571":49134,"_15405":84168,"_5":15294,"_21315":84060,"_1890":84169},[],"el principal coincide con la identidad utilizada;",{"_2299":49183,"_22571":49134,"_15405":84171,"_5":15294,"_21315":84060,"_1890":84172},[],"el consumidor lo persiste una sola vez;",{"_2299":49184,"_22571":49134,"_15405":84174,"_5":15294,"_21315":84060,"_1890":84175},[],"puede recuperarse por recurso, actor y periodo;",{"_2299":49185,"_22571":49134,"_15405":84177,"_5":15294,"_21315":84060,"_1890":84178},[],"una interrupción del consumidor produce una alerta.",{"_2299":49186,"_22571":49134,"_15405":84180,"_5":15294,"_21315":84060,"_1890":84181},[],"Para métricas, trazas y logs técnicos del despliegue, consulta Resolución de problemas. La auditoría responde a “quién intentó cambiar qué”; la observabilidad explica cómo se comportó el sistema.",{"_2299":49187,"_22571":49187,"_5":10616,"_1890":84183,"_22830":84184,"_15405":84185,"_21315":49187},"Jerarquía y rotación de CAs",[35156,83411,83889],[],{"_2299":49188,"_22571":49187,"_15405":84187,"_5":15294,"_21315":49187,"_1890":84188},[],"Diseña autoridades raíz e intermedias y sustituye certificados o claves sin romper la confianza.",{"_2299":49189,"_22571":49187,"_5":22827,"_15405":84190,"_21315":84191,"_1890":84192},[],"/docs/es/platform/pki/ca-hierarchy-and-rotation#diseña-la-jerarquía","Diseña la jerarquía",{"_2299":49190,"_22571":49187,"_5":22827,"_15405":84194,"_21315":84195,"_1890":84196},[],"/docs/es/platform/pki/ca-hierarchy-and-rotation#reemisión-y-rotación-no-son-lo-mismo","Reemisión y rotación no son lo mismo",{"_2299":49191,"_22571":49187,"_5":22827,"_15405":84198,"_21315":84199,"_1890":84200},[],"/docs/es/platform/pki/ca-hierarchy-and-rotation#cuándo-elegir-cada-operación","Cuándo elegir cada operación",{"_2299":49192,"_22571":49187,"_5":22827,"_15405":84202,"_21315":84203,"_1890":84204},[],"/docs/es/platform/pki/ca-hierarchy-and-rotation#procedimiento-de-rotación-de-clave","Procedimiento de rotación de clave",{"_2299":49193,"_22571":49187,"_5":22827,"_15405":84206,"_21315":84207,"_1890":84208},[],"/docs/es/platform/pki/ca-hierarchy-and-rotation#inventaría-las-dependencias","Inventaría las dependencias",{"_2299":49194,"_22571":49187,"_5":22827,"_15405":84210,"_21315":84211,"_1890":84212},[],"/docs/es/platform/pki/ca-hierarchy-and-rotation#crea-la-ca-sucesora","Crea la CA sucesora",{"_2299":49195,"_22571":49187,"_5":22827,"_15405":84214,"_21315":84215,"_1890":84216},[],"/docs/es/platform/pki/ca-hierarchy-and-rotation#distribuye-la-nueva-confianza","Distribuye la nueva confianza",{"_2299":49196,"_22571":49187,"_5":22827,"_15405":84218,"_21315":84219,"_1890":84220},[],"/docs/es/platform/pki/ca-hierarchy-and-rotation#cambia-la-emisión","Cambia la emisión",{"_2299":49197,"_22571":49187,"_5":22827,"_15405":84222,"_21315":84223,"_1890":84224},[],"/docs/es/platform/pki/ca-hierarchy-and-rotation#renueva-por-lotes","Renueva por lotes",{"_2299":49198,"_22571":49187,"_5":22827,"_15405":84226,"_21315":84227,"_1890":84228},[],"/docs/es/platform/pki/ca-hierarchy-and-rotation#cierra-el-solapamiento","Cierra el solapamiento",{"_2299":49199,"_22571":49187,"_5":22827,"_15405":84230,"_21315":84231,"_1890":84232},[],"/docs/es/platform/pki/ca-hierarchy-and-rotation#revocación-en-cascada","Revocación en cascada",{"_2299":49200,"_22571":49187,"_5":22827,"_15405":84234,"_21315":84235,"_1890":84236},[],"/docs/es/platform/pki/ca-hierarchy-and-rotation#comprobaciones-después-del-cambio","Comprobaciones después del cambio",{"_2299":49201,"_22571":49187,"_15405":84238,"_5":15294,"_21315":49187,"_1890":84239},[],"La jerarquía determina el alcance de cualquier error o compromiso. Una raíz firma CAs intermedias; las intermedias emiten las identidades que usan dispositivos y servicios. Esta separación permite aislar entornos y rotar una rama sin reemplazar toda la confianza.",{"_2299":49202,"_22571":49187,"_15405":84241,"_5":15294,"_21315":84191,"_1890":84242},[],"Para una instalación de producción, utiliza una raíz muy restringida y una o más intermedias operativas. Separa intermedias cuando cambie alguno de estos límites:",{"_2299":49203,"_22571":49187,"_15405":84244,"_5":15294,"_21315":84191,"_1890":84245},[],"entorno, como producción y preproducción;",{"_2299":49204,"_22571":49187,"_15405":84247,"_5":15294,"_21315":84191,"_1890":84248},[],"propietario o equipo operador;",{"_2299":49205,"_22571":49187,"_15405":84250,"_5":15294,"_21315":84191,"_1890":84251},[],"familia de dispositivos o proceso de fabricación;",{"_2299":49206,"_22571":49187,"_15405":84253,"_5":15294,"_21315":84191,"_1890":84254},[],"región o requisito regulatorio;",{"_2299":49207,"_22571":49187,"_15405":84256,"_5":15294,"_21315":84191,"_1890":84257},[],"motor criptográfico o política de clave;",{"_2299":49208,"_22571":49187,"_15405":84259,"_5":15294,"_21315":84191,"_1890":84260},[],"ventana de mantenimiento y ritmo de renovación.",{"_2299":49209,"_22571":49187,"_15405":84262,"_5":15294,"_21315":84191,"_1890":84263},[],"Evita jerarquías profundas sin una necesidad concreta. Cada nivel añade distribución de cadena, validación y otro certificado que debes renovar.",{"_2299":49210,"_22571":49187,"_15405":84265,"_5":15294,"_21315":84191,"_1890":84266},[],"Una CA hija y los certificados finales deben expirar antes que su emisor. Reserva un margen que permita distribuir otra cadena y renovar los certificados dependientes.",{"_2299":49211,"_22571":49187,"_15405":84268,"_5":15294,"_21315":84195,"_1890":84269},[],"**Reemitir una CA** crea un certificado nuevo sobre la clave existente. Lamassu genera una CSR con esa clave, autofirma si es una raíz o pide a la CA padre que firme si es subordinada. El nuevo certificado queda activo y la CA apunta a su número de serie; los certificados anterior y nuevo quedan enlazados mediante metadatos.",{"_2299":49212,"_22571":49187,"_15405":84271,"_5":15294,"_21315":84195,"_1890":84272},[],"**Rotar una CA** crea una clave y una autoridad sucesoras. Es la opción adecuada ante compromiso, cambio criptográfico, migración de motor o política de claves no exportables.",{"_2299":49213,"_22571":49187,"_15405":84274,"_5":15294,"_21315":84195,"_1890":84275},[],"Lamassu no permite reemitir una CA ya revocada ni una CA cuya fecha de expiración haya pasado. Anticípate a ambas condiciones.",{"_2299":49214,"_22571":49187,"_15405":84277,"_5":15294,"_21315":84199,"_1890":84278},[],"Reemite si la clave sigue siendo confiable y solo necesitas otro periodo de validez o un certificado actualizado.",{"_2299":49215,"_22571":49187,"_15405":84280,"_5":15294,"_21315":84199,"_1890":84281},[],"Rota la clave si existe sospecha de compromiso, cambia el algoritmo o quieres mover la custodia a otro motor.",{"_2299":49216,"_22571":49187,"_15405":84283,"_5":15294,"_21315":84199,"_1890":84284},[],"Crea una rama paralela si no puedes actualizar todos los consumidores al mismo tiempo.",{"_2299":49217,"_22571":49187,"_15405":84286,"_5":15294,"_21315":84199,"_1890":84287},[],"Revoca inmediatamente solo cuando el riesgo de mantener la CA supera el impacto de interrumpir la flota.",{"_2299":49218,"_22571":49187,"_15405":84289,"_5":15294,"_21315":84207,"_1890":84290},[],"Localiza CAs hijas, certificados emitidos, DMS, conectores y almacenes de confianza externos. Incluye dispositivos que pueden permanecer desconectados durante semanas o meses.",{"_2299":49219,"_22571":49187,"_15405":84292,"_5":15294,"_21315":84211,"_1890":84293},[],"Genera una clave nueva en el motor previsto, crea la CA y asígnale un perfil explícito. No reutilices el identificador operativo para ocultar que es una generación distinta.",{"_2299":49220,"_22571":49187,"_15405":84295,"_5":15294,"_21315":84215,"_1890":84296},[],"Añade la nueva raíz o cadena a los consumidores antes de emitir con ella. En un DMS, utiliza las CAs gestionadas de `/cacerts` para mantener temporalmente las cadenas antigua y nueva.",{"_2299":49221,"_22571":49187,"_15405":84298,"_5":15294,"_21315":84219,"_1890":84299},[],"Actualiza la CA de enrolamiento y el perfil de los DMS. Mantén las CAs de validación adicionales si todavía deben aceptarse certificados antiguos durante el re-enrolamiento.",{"_2299":49222,"_22571":49187,"_15405":84301,"_5":15294,"_21315":84223,"_1890":84302},[],"Migra una cohorte pequeña, valida mTLS, OCSP y CRL desde el consumidor y amplía progresivamente. Supervisa qué dispositivos siguen presentando la cadena antigua.",{"_2299":49223,"_22571":49187,"_15405":84304,"_5":15294,"_21315":84227,"_1890":84305},[],"Cuando ningún consumidor legítimo dependa de la autoridad anterior, retírala de la emisión y de las CAs distribuidas. Revócala si la política lo exige.",{"_2299":49224,"_22571":49187,"_15405":84307,"_5":15294,"_21315":84231,"_1890":84308},[],"Al revocar una CA, Lamassu actualiza también sus CAs hijas y certificados emitidos a `REVOKED` con razón `CessationOfOperation`. Las revocaciones de las hijas propagan el efecto a sus propias ramas.",{"_2299":49225,"_22571":49187,"_15405":84310,"_5":15294,"_21315":84231,"_1890":84311},[],"Esto protege la coherencia de la jerarquía, pero convierte la revocación en una acción de gran impacto. No la utilices como mecanismo ordinario para dejar de emitir: primero completa la migración y elimina la CA de los flujos operativos.",{"_2299":49226,"_22571":49187,"_15405":84313,"_5":15294,"_21315":84235,"_1890":84314},[],"La cadena nueva termina en un ancla instalada por el consumidor.",{"_2299":49227,"_22571":49187,"_15405":84316,"_5":15294,"_21315":84235,"_1890":84317},[],"Los certificados nuevos contienen AKI, SKI, KU, EKU y SAN esperados.",{"_2299":49228,"_22571":49187,"_15405":84319,"_5":15294,"_21315":84235,"_1890":84320},[],"El DMS entrega la cadena correcta mediante EST `/cacerts`.",{"_2299":49229,"_22571":49187,"_15405":84322,"_5":15294,"_21315":84235,"_1890":84323},[],"El re-enrolamiento acepta la identidad antigua durante el periodo previsto.",{"_2299":49230,"_22571":49187,"_15405":84325,"_5":15294,"_21315":84235,"_1890":84326},[],"OCSP y CRL responden para las autoridades que siguen activas.",{"_2299":49231,"_22571":49187,"_15405":84328,"_5":15294,"_21315":84235,"_1890":84329},[],"No quedan DMS emitiendo accidentalmente desde la CA anterior.",{"_2299":49232,"_22571":49187,"_15405":84331,"_5":15294,"_21315":84235,"_1890":84332},[],"Consulta el Modelo de confianza para entender los conjuntos de CAs del DMS y Ciclo de vida de un certificado para los estados y efectos de revocación.",{"_2299":49233,"_22571":49233,"_5":10616,"_1890":84334,"_22830":84335,"_15405":84336,"_21315":49233},"Autoridades de certificación",[35156,83411,83889],[],{"_2299":49234,"_22571":49233,"_15405":84338,"_5":15294,"_21315":49233,"_1890":84339},[],"Crea, importa y opera las autoridades que establecen la confianza de tu PKI.",{"_2299":49235,"_22571":49233,"_5":22827,"_15405":84341,"_21315":84342,"_1890":84343},[],"/docs/es/platform/pki/certificate-authorities#elige-un-flujo","Elige un flujo",{"_2299":49236,"_22571":49233,"_5":22827,"_15405":84345,"_21315":84346,"_1890":84347},[],"/docs/es/platform/pki/certificate-authorities#crea-una-autoridad-nueva","Crea una autoridad nueva",{"_2299":49237,"_22571":49233,"_5":22827,"_15405":84349,"_21315":84350,"_1890":82322},[],"/docs/es/platform/pki/certificate-authorities#antes-de-empezar",{"_2299":49238,"_22571":49233,"_5":22827,"_15405":84352,"_21315":84353,"_1890":84354},[],"/docs/es/platform/pki/certificate-authorities#abre-el-asistente","Abre el asistente",{"_2299":49239,"_22571":49233,"_5":22827,"_15405":84356,"_21315":84357,"_1890":84358},[],"/docs/es/platform/pki/certificate-authorities#configura-la-clave","Configura la clave",{"_2299":49240,"_22571":49233,"_5":22827,"_15405":84360,"_21315":84361,"_1890":84362},[],"/docs/es/platform/pki/certificate-authorities#elige-el-tipo-de-ca","Elige el tipo de CA",{"_2299":49241,"_22571":49233,"_5":22827,"_15405":84364,"_21315":84365,"_1890":84366},[],"/docs/es/platform/pki/certificate-authorities#define-la-identidad","Define la identidad",{"_2299":49242,"_22571":49233,"_5":22827,"_15405":84368,"_21315":84369,"_1890":84370},[],"/docs/es/platform/pki/certificate-authorities#configura-validez-y-usos","Configura validez y usos",{"_2299":49243,"_22571":49233,"_5":22827,"_15405":84372,"_21315":84373,"_1890":84374},[],"/docs/es/platform/pki/certificate-authorities#crea-y-verifica","Crea y verifica",{"_2299":49244,"_22571":49233,"_5":22827,"_15405":84376,"_21315":84377,"_1890":84378},[],"/docs/es/platform/pki/certificate-authorities#utiliza-una-clave-del-kms","Utiliza una clave del KMS",{"_2299":49245,"_22571":49233,"_5":22827,"_15405":84380,"_21315":84381,"_1890":84382},[],"/docs/es/platform/pki/certificate-authorities#importa-una-ca-externa","Importa una CA externa",{"_2299":49246,"_22571":49233,"_5":22827,"_15405":84384,"_21315":84385,"_1890":84386},[],"/docs/es/platform/pki/certificate-authorities#selecciona-el-motor","Selecciona el motor",{"_2299":49247,"_22571":49233,"_5":22827,"_15405":84388,"_21315":84389,"_1890":84390},[],"/docs/es/platform/pki/certificate-authorities#carga-el-material","Carga el material",{"_2299":49248,"_22571":49233,"_5":22827,"_15405":84392,"_21315":84393,"_1890":84394},[],"/docs/es/platform/pki/certificate-authorities#define-la-emisión-predeterminada","Define la emisión predeterminada",{"_2299":49249,"_22571":49233,"_5":22827,"_15405":84396,"_21315":84397,"_1890":84398},[],"/docs/es/platform/pki/certificate-authorities#verifica-la-importación","Verifica la importación",{"_2299":49250,"_22571":49233,"_5":22827,"_15405":84400,"_21315":84401,"_1890":84402},[],"/docs/es/platform/pki/certificate-authorities#inspecciona-una-autoridad","Inspecciona una autoridad",{"_2299":49251,"_22571":49233,"_5":22827,"_15405":84404,"_21315":84405,"_1890":84406},[],"/docs/es/platform/pki/certificate-authorities#emite-certificados","Emite certificados",{"_2299":49252,"_22571":49233,"_5":22827,"_15405":84408,"_21315":84409,"_1890":84410},[],"/docs/es/platform/pki/certificate-authorities#revoca-una-ca","Revoca una CA",{"_2299":49253,"_22571":49233,"_5":22827,"_15405":84412,"_21315":84413,"_1890":84414},[],"/docs/es/platform/pki/certificate-authorities#evalúa-el-impacto","Evalúa el impacto",{"_2299":49254,"_22571":49233,"_5":22827,"_15405":84416,"_21315":84417,"_1890":84418},[],"/docs/es/platform/pki/certificate-authorities#inicia-la-revocación","Inicia la revocación",{"_2299":49255,"_22571":49233,"_5":22827,"_15405":84420,"_21315":84421,"_1890":84422},[],"/docs/es/platform/pki/certificate-authorities#confirma-la-identidad","Confirma la identidad",{"_2299":49256,"_22571":49233,"_5":22827,"_15405":84424,"_21315":84425,"_1890":84426},[],"/docs/es/platform/pki/certificate-authorities#comprueba-la-publicación","Comprueba la publicación",{"_2299":49257,"_22571":49233,"_15405":84428,"_5":15294,"_21315":49233,"_1890":84429},[],"Una autoridad de certificación (CA) vincula identidades con claves públicas mediante certificados firmados. En Lamassu puedes crear una jerarquía nueva, utilizar una clave que ya está en el KMS o incorporar una CA externa.",{"_2299":49258,"_22571":49233,"_15405":84431,"_5":15294,"_21315":49233,"_1890":84432},[],"Para diseñar una cadena completa o sustituir una autoridad en producción, consulta Jerarquía y rotación de CAs. Si necesitas estandarizar qué puede firmar cada autoridad, utiliza Perfiles de certificado.",{"_2299":49259,"_22571":49233,"_15405":84434,"_5":15294,"_21315":84342,"_1890":84435},[],"**Nueva CA y nueva clave:** crea una raíz de confianza desde cero. Lamassu genera y custodia el par de claves.",{"_2299":49260,"_22571":49233,"_15405":84437,"_5":15294,"_21315":84342,"_1890":84438},[],"**Nueva CA desde KMS:** reutiliza una clave que ya está registrada en la plataforma.",{"_2299":49261,"_22571":49233,"_15405":84440,"_5":15294,"_21315":84342,"_1890":84441},[],"**Importar CA con clave privada:** incorpora una autoridad externa con la que Lamassu podrá emitir.",{"_2299":49262,"_22571":49233,"_15405":84443,"_5":15294,"_21315":84342,"_1890":84444},[],"**Importar solo el certificado:** añade una autoridad para construir cadenas y validar, pero no para emitir.",{"_2299":49263,"_22571":49233,"_15405":84446,"_5":15294,"_21315":84342,"_1890":84447},[],"¿Es tu primera vez? Sigue Crea tu primera CA para completar el recorrido mínimo.",{"_2299":49264,"_22571":49233,"_15405":84449,"_5":15294,"_21315":84350,"_1890":84450},[],"Decide si la CA será raíz o intermedia.",{"_2299":49265,"_22571":49233,"_15405":84452,"_5":15294,"_21315":84350,"_1890":84453},[],"Elige el motor que custodiará la clave.",{"_2299":49266,"_22571":49233,"_15405":84455,"_5":15294,"_21315":84350,"_1890":84456},[],"Define una validez superior a la de los certificados que emitirá.",{"_2299":49267,"_22571":49233,"_15405":84458,"_5":15294,"_21315":84350,"_1890":84459},[],"Para una CA intermedia, asegúrate de que la CA padre esté activa.",{"_2299":49268,"_22571":49233,"_15405":84461,"_5":15294,"_21315":84353,"_1890":84462},[],"En **Certification Authorities**, selecciona **Create New CA** y elige generar un par de claves nuevo.",{"_2299":49269,"_22571":49233,"_15405":84464,"_5":15294,"_21315":84357,"_1890":84465},[],"Selecciona el motor criptográfico, el algoritmo y el tamaño o curva. Lamassu admite claves RSA y EC según las capacidades del motor.",{"_2299":49270,"_22571":49233,"_15405":84467,"_5":15294,"_21315":84357,"_1890":84468},[],"Para RSA puedes elegir 1024, 2048, 3072 o 4096 bits. Para EC están disponibles las curvas P-256, P-384 y P-521.",{"_2299":49271,"_22571":49233,"_15405":84470,"_5":15294,"_21315":84361,"_1890":84471},[],"Selecciona **Root CA** para una autoridad autofirmada o **Intermediate CA** para una autoridad firmada por otra CA. En el segundo caso, elige la CA emisora.",{"_2299":49272,"_22571":49233,"_15405":84473,"_5":15294,"_21315":84365,"_1890":84474},[],"Introduce un **CA Name** único. Este nombre se convierte en el `Common Name` del certificado. Completa los campos del Distinguished Name que necesite tu política:",{"_2299":49273,"_22571":49233,"_15405":84476,"_5":15294,"_21315":84365,"_1890":84477},[],"`C`: código de país ISO 3166-1 de dos letras.",{"_2299":49274,"_22571":49233,"_15405":84479,"_5":15294,"_21315":84365,"_1890":84480},[],"`ST`: estado o provincia.",{"_2299":49275,"_22571":49233,"_15405":84482,"_5":15294,"_21315":84365,"_1890":84483},[],"`L`: localidad.",{"_2299":49276,"_22571":49233,"_15405":84485,"_5":15294,"_21315":84365,"_1890":84486},[],"`O`: organización.",{"_2299":49277,"_22571":49233,"_15405":84488,"_5":15294,"_21315":84365,"_1890":84489},[],"`OU`: unidad organizativa.",{"_2299":49278,"_22571":49233,"_15405":84491,"_5":15294,"_21315":84365,"_1890":84492},[],"El identificador interno de la CA se genera automáticamente y no se puede modificar.",{"_2299":49279,"_22571":49233,"_15405":84494,"_5":15294,"_21315":84369,"_1890":84495},[],"Define **CA Certificate Expiration** y **Default End-Entity Certificate Issuance Expiration**. Puedes expresar una duración (`5y 8w 4d`), seleccionar una fecha o utilizar la fecha máxima permitida.",{"_2299":49280,"_22571":49233,"_15405":84497,"_5":15294,"_21315":84369,"_1890":84498},[],"Selecciona un perfil de emisión existente o configura los `Key Usage` y `Extended Key Usage` en el formulario. Si no eliges un perfil, Lamassu aplica los usos básicos predeterminados.",{"_2299":49281,"_22571":49233,"_15405":84500,"_5":15294,"_21315":84373,"_1890":84501},[],"Confirma el formulario. La CA debe aparecer en el inventario con su certificado PEM, estado, fecha de expiración y relación de certificados emitidos.",{"_2299":49282,"_22571":49233,"_15405":84503,"_5":15294,"_21315":84373,"_1890":84504},[],"Una CA no puede emitir certificados que superen su propia fecha de expiración. Deja margen suficiente para renovar o sustituir la autoridad sin interrumpir a los consumidores.",{"_2299":49283,"_22571":49233,"_15405":84506,"_5":15294,"_21315":84377,"_1890":84507},[],"Selecciona &#x2A;*Create New CA (Existing Key)** cuando la clave ya esté registrada en Lamassu. El asistente pide primero la clave de soporte y después muestra la misma configuración de tipo, identidad, validez y perfil.",{"_2299":49284,"_22571":49233,"_15405":84509,"_5":15294,"_21315":84377,"_1890":84510},[],"Este flujo resulta útil cuando la clave se creó previamente en un HSM, se importó mediante BYOK o debe reutilizarse con una política de custodia concreta.",{"_2299":49285,"_22571":49233,"_15405":84512,"_5":15294,"_21315":84381,"_1890":84513},[],"La importación conserva una autoridad creada fuera de Lamassu.",{"_2299":49286,"_22571":49233,"_15405":84515,"_5":15294,"_21315":84385,"_1890":84516},[],"Elige el motor que custodiará la clave importada.",{"_2299":49287,"_22571":49233,"_15405":84518,"_5":15294,"_21315":84389,"_1890":84519},[],"Proporciona el certificado de CA y la clave privada en formato PEM. Para una CA subordinada, añade opcionalmente la cadena de validación.",{"_2299":49288,"_22571":49233,"_15405":84521,"_5":15294,"_21315":84393,"_1890":84522},[],"Configura la validez que recibirán los certificados finales cuando una solicitud no indique otra duración.",{"_2299":49289,"_22571":49233,"_15405":84524,"_5":15294,"_21315":84397,"_1890":84525},[],"Lamassu comprueba que el certificado pertenece a una CA y que el material es coherente antes de registrarlo.",{"_2299":49290,"_22571":49233,"_15405":84527,"_5":15294,"_21315":84397,"_1890":84528},[],"Si no dispones de la clave privada, importa únicamente el certificado. La autoridad podrá formar parte de cadenas de confianza y procesos de validación, pero no podrá emitir certificados desde Lamassu.",{"_2299":49291,"_22571":49233,"_15405":84530,"_5":15294,"_21315":84401,"_1890":84531},[],"Abre una CA desde el inventario para consultar:",{"_2299":49292,"_22571":49233,"_15405":84533,"_5":15294,"_21315":84401,"_1890":84534},[],"Estado y periodo de validez.",{"_2299":49293,"_22571":49233,"_15405":84536,"_5":15294,"_21315":84401,"_1890":84537},[],"Certificado y cadena en formato PEM.",{"_2299":49294,"_22571":49233,"_15405":84539,"_5":15294,"_21315":84401,"_1890":84540},[],"Número de certificados activos, expirados y revocados.",{"_2299":49295,"_22571":49233,"_15405":84542,"_5":15294,"_21315":84401,"_1890":84543},[],"Certificados emitidos en **Issued Certificates**.",{"_2299":49296,"_22571":49233,"_15405":84545,"_5":15294,"_21315":84401,"_1890":84546},[],"CRL vinculada a la autoridad.",{"_2299":49297,"_22571":49233,"_15405":84548,"_5":15294,"_21315":84401,"_1890":84549},[],"Metadatos y motor criptográfico asociado.",{"_2299":49298,"_22571":49233,"_15405":84551,"_5":15294,"_21315":84401,"_1890":84552},[],"Puedes filtrar el inventario por nombre, estado y tipo de CA.",{"_2299":49299,"_22571":49233,"_15405":84554,"_5":15294,"_21315":84405,"_1890":84555},[],"Puedes iniciar una emisión desde **Issued Certificates**, desde la acción de una CA o desde el inventario global de certificados.",{"_2299":49300,"_22571":49233,"_15405":84557,"_5":15294,"_21315":84405,"_1890":84558},[],"**Generate Key & CSR in Browser** resulta útil para una operación manual o una prueba rápida. El navegador genera la clave y debes descargarla al finalizar.",{"_2299":49301,"_22571":49233,"_15405":84560,"_5":15294,"_21315":84405,"_1890":84561},[],"**Upload Existing CSR** es la opción adecuada cuando la clave debe permanecer en el sistema de destino. Lamassu recibe la solicitud, pero nunca la clave privada.",{"_2299":49302,"_22571":49233,"_15405":84563,"_5":15294,"_21315":84405,"_1890":84564},[],"Sigue Emite tu primer certificado para el flujo guiado. La gestión de certificados explica el inventario, la inspección y la revocación.",{"_2299":49303,"_22571":49233,"_15405":84566,"_5":15294,"_21315":84409,"_1890":84567},[],"Revocar una CA invalida la confianza en los certificados que ha emitido y puede interrumpir dispositivos y servicios. La acción es irreversible.",{"_2299":49304,"_22571":49233,"_15405":84569,"_5":15294,"_21315":84413,"_1890":84570},[],"Identifica los certificados, dispositivos y consumidores que dependen de la CA. Prepara una autoridad y una cadena de sustitución cuando sea necesario.",{"_2299":49305,"_22571":49233,"_15405":84572,"_5":15294,"_21315":84417,"_1890":84573},[],"Abre la autoridad y selecciona **Revoke CA**. Elige la razón que describa el incidente, por ejemplo `KeyCompromise`, `CACompromise`, `Superseded` o `CessationOfOperation`.",{"_2299":49306,"_22571":49233,"_15405":84575,"_5":15294,"_21315":84421,"_1890":84576},[],"Escribe exactamente el nombre de la CA para habilitar **Confirm Revocation**.",{"_2299":49307,"_22571":49233,"_15405":84578,"_5":15294,"_21315":84425,"_1890":84579},[],"El estado debe cambiar a **REVOKED** y la CRL debe reflejar la nueva información. La CA deja de poder emitir certificados.",{"_2299":49308,"_22571":49233,"_15405":84581,"_5":15294,"_21315":84425,"_1890":84582},[],"La eliminación permanente solo está disponible después de revocar. Elimina el registro únicamente cuando la política de retención y auditoría lo permita.",{"_2299":49309,"_22571":49309,"_5":10616,"_1890":84584,"_22830":84585,"_15405":84586,"_21315":49309},"Perfiles de certificado",[35156,83411,83889],[],{"_2299":49310,"_22571":49309,"_15405":84588,"_5":15294,"_21315":49309,"_1890":84589},[],"Define políticas reutilizables para emitir certificados coherentes y limitar las claves aceptadas.",{"_2299":49311,"_22571":49309,"_5":22827,"_15405":84591,"_21315":84592,"_1890":84593},[],"/docs/es/platform/pki/certificate-profiles#qué-controla-un-perfil","Qué controla un perfil",{"_2299":49312,"_22571":49309,"_5":22827,"_15405":84595,"_21315":84596,"_1890":84597},[],"/docs/es/platform/pki/certificate-profiles#validez","Validez",{"_2299":49313,"_22571":49309,"_5":22827,"_15405":84599,"_21315":84600,"_1890":84601},[],"/docs/es/platform/pki/certificate-profiles#certificado-de-ca-o-certificado-final","Certificado de CA o certificado final",{"_2299":49314,"_22571":49309,"_5":22827,"_15405":84603,"_21315":84604,"_1890":84605},[],"/docs/es/platform/pki/certificate-profiles#key-usage-y-extended-key-usage","Key Usage y Extended Key Usage",{"_2299":49315,"_22571":49309,"_5":22827,"_15405":84607,"_21315":84608,"_1890":84609},[],"/docs/es/platform/pki/certificate-profiles#sujeto","Sujeto",{"_2299":49316,"_22571":49309,"_5":22827,"_15405":84611,"_21315":84612,"_1890":84613},[],"/docs/es/platform/pki/certificate-profiles#extensiones-de-la-csr","Extensiones de la CSR",{"_2299":49317,"_22571":49309,"_5":22827,"_15405":84615,"_21315":84616,"_1890":84617},[],"/docs/es/platform/pki/certificate-profiles#restricciones-criptográficas","Restricciones criptográficas",{"_2299":49318,"_22571":49309,"_5":22827,"_15405":84619,"_21315":84620,"_1890":84621},[],"/docs/es/platform/pki/certificate-profiles#precedencia-del-perfil","Precedencia del perfil",{"_2299":49319,"_22571":49309,"_5":22827,"_15405":84623,"_21315":84624,"_1890":84625},[],"/docs/es/platform/pki/certificate-profiles#crea-un-perfil","Crea un perfil",{"_2299":49320,"_22571":49309,"_5":22827,"_15405":84627,"_21315":84628,"_1890":84629},[],"/docs/es/platform/pki/certificate-profiles#define-un-único-propósito","Define un único propósito",{"_2299":49321,"_22571":49309,"_5":22827,"_15405":84631,"_21315":84632,"_1890":84633},[],"/docs/es/platform/pki/certificate-profiles#elige-la-validez","Elige la validez",{"_2299":49322,"_22571":49309,"_5":22827,"_15405":84635,"_21315":84636,"_1890":84637},[],"/docs/es/platform/pki/certificate-profiles#fija-usos-y-sujeto","Fija usos y sujeto",{"_2299":49323,"_22571":49309,"_5":22827,"_15405":84639,"_21315":84640,"_1890":84641},[],"/docs/es/platform/pki/certificate-profiles#restringe-las-claves","Restringe las claves",{"_2299":49324,"_22571":49309,"_5":22827,"_15405":84643,"_21315":84644,"_1890":84645},[],"/docs/es/platform/pki/certificate-profiles#asócialo-y-prueba","Asócialo y prueba",{"_2299":49325,"_22571":49309,"_5":22827,"_15405":84647,"_21315":84648,"_1890":84649},[],"/docs/es/platform/pki/certificate-profiles#ejemplos-de-diseño","Ejemplos de diseño",{"_2299":49326,"_22571":49309,"_5":22827,"_15405":84651,"_21315":84652,"_1890":84653},[],"/docs/es/platform/pki/certificate-profiles#cambios-y-eliminación","Cambios y eliminación",{"_2299":49327,"_22571":49309,"_15405":84655,"_5":15294,"_21315":49309,"_1890":84656},[],"Un perfil de emisión convierte una política de certificados en configuración reutilizable. En lugar de decidir validez, sujeto, extensiones y algoritmos en cada solicitud, defines una vez qué está permitido y asocias el perfil a una CA, un DMS o una emisión concreta.",{"_2299":49328,"_22571":49309,"_15405":84658,"_5":15294,"_21315":84596,"_1890":84659},[],"Puedes expresar la vigencia como una duración desde el momento de emisión o como una fecha final fija. Una duración funciona bien para identidades recurrentes; una fecha común sirve para hacer que todo un lote termine antes de una migración o retirada.",{"_2299":49329,"_22571":49309,"_15405":84661,"_5":15294,"_21315":84596,"_1890":84662},[],"La fecha final nunca debe superar la de la CA emisora.",{"_2299":49330,"_22571":49309,"_15405":84664,"_5":15294,"_21315":84600,"_1890":84665},[],"`Sign as CA` establece `IsCA` y las restricciones básicas necesarias para una autoridad. Actívalo solo en perfiles destinados a crear o reemitir CAs subordinadas.",{"_2299":49331,"_22571":49309,"_15405":84667,"_5":15294,"_21315":84604,"_1890":84668},[],"El perfil puede imponer usos como `DigitalSignature`, `KeyEncipherment`, `CertSign`, `CRLSign`, `ClientAuth`, `ServerAuth` u `OCSPSigning`.",{"_2299":49332,"_22571":49309,"_15405":84670,"_5":15294,"_21315":84604,"_1890":84671},[],"Si activas **Honor Key Usage** o **Honor Extended Key Usages**, Lamassu conserva los valores solicitados por la CSR. Si los desactivas, los sustituye por los definidos en el perfil.",{"_2299":49333,"_22571":49309,"_15405":84673,"_5":15294,"_21315":84604,"_1890":84674},[],"No habilites las opciones `Honor…` para solicitudes no confiables salvo que otro componente valide esos campos. De lo contrario, el solicitante puede elegir capacidades más amplias de las previstas.",{"_2299":49334,"_22571":49309,"_15405":84676,"_5":15294,"_21315":84608,"_1890":84677},[],"Con **Honor Subject**, el certificado conserva el sujeto de la CSR. Sin esa opción, Lamassu aplica `CN`, `O`, `OU`, `C`, `ST` y `L` del perfil. Si el perfil no define `Common Name`, se conserva el CN solicitado.",{"_2299":49335,"_22571":49309,"_15405":84679,"_5":15294,"_21315":84612,"_1890":84680},[],"Con **Honor Extensions**, Lamassu filtra las extensiones adicionales solicitadas y conserva únicamente SAN. Sin esa opción, descarta las extensiones adicionales de la CSR.",{"_2299":49336,"_22571":49309,"_15405":84682,"_5":15294,"_21315":84612,"_1890":84683},[],"Este comportamiento permite aceptar DNS, IP, correo o URI como identidades alternativas sin aceptar extensiones arbitrarias.",{"_2299":49337,"_22571":49309,"_15405":84685,"_5":15294,"_21315":84616,"_1890":84686},[],"La aplicación criptográfica puede:",{"_2299":49338,"_22571":49309,"_15405":84688,"_5":15294,"_21315":84616,"_1890":84689},[],"permitir o bloquear claves RSA;",{"_2299":49339,"_22571":49309,"_15405":84691,"_5":15294,"_21315":84616,"_1890":84692},[],"limitar los tamaños RSA admitidos;",{"_2299":49340,"_22571":49309,"_15405":84694,"_5":15294,"_21315":84616,"_1890":84695},[],"permitir o bloquear claves ECDSA;",{"_2299":49341,"_22571":49309,"_15405":84697,"_5":15294,"_21315":84616,"_1890":84698},[],"limitar los tamaños o curvas ECDSA admitidos.",{"_2299":49342,"_22571":49309,"_15405":84700,"_5":15294,"_21315":84616,"_1890":84701},[],"Cuando está habilitada, Lamassu comprueba la clave pública antes de crear una CA o firmar una CSR. Una clave cuyo tipo o tamaño no figure en el perfil se rechaza.",{"_2299":49343,"_22571":49309,"_15405":84703,"_5":15294,"_21315":84620,"_1890":84704},[],"En operaciones que admiten varias fuentes, Lamassu resuelve el perfil en este orden:",{"_2299":49344,"_22571":49309,"_15405":84706,"_5":15294,"_21315":84620,"_1890":84707},[],"Perfil enviado dentro de la operación.",{"_2299":49345,"_22571":49309,"_15405":84709,"_5":15294,"_21315":84620,"_1890":84710},[],"Identificador de perfil enviado en la operación.",{"_2299":49346,"_22571":49309,"_15405":84712,"_5":15294,"_21315":84620,"_1890":84713},[],"Perfil predeterminado asociado a la CA.",{"_2299":49347,"_22571":49309,"_15405":84715,"_5":15294,"_21315":84620,"_1890":84716},[],"Un DMS también puede referenciar su propio perfil de emisión. De este modo, varias flotas pueden usar la misma CA con políticas distintas.",{"_2299":49348,"_22571":49309,"_15405":84718,"_5":15294,"_21315":84628,"_1890":84719},[],"Separa, por ejemplo, dispositivos mTLS, servidores y CAs intermedias. Un perfil pequeño y específico es más fácil de revisar que uno que permita todos los usos.",{"_2299":49349,"_22571":49309,"_15405":84721,"_5":15294,"_21315":84632,"_1890":84722},[],"Alinea la duración con la capacidad real de renovación de la flota. Deja margen respecto a la expiración de la CA.",{"_2299":49350,"_22571":49309,"_15405":84724,"_5":15294,"_21315":84636,"_1890":84725},[],"Para un dispositivo que se autentica como cliente, el punto de partida habitual es `DigitalSignature` y `ClientAuth`. Añade `ServerAuth` o `KeyEncipherment` solo si el protocolo lo necesita.",{"_2299":49351,"_22571":49309,"_15405":84727,"_5":15294,"_21315":84640,"_1890":84728},[],"Habilita la aplicación criptográfica y enumera únicamente algoritmos y tamaños compatibles con tu política y tus dispositivos.",{"_2299":49352,"_22571":49309,"_15405":84730,"_5":15294,"_21315":84644,"_1890":84731},[],"Asocia el perfil a una CA o DMS. Emite un certificado de prueba y comprueba sujeto, SAN, KU, EKU, restricciones básicas y fechas con una herramienta X.509 independiente.",{"_2299":49353,"_22571":49309,"_15405":84733,"_5":15294,"_21315":84648,"_1890":84734},[],"**Dispositivo mTLS**\\\nCertificado final, validez corta, `DigitalSignature`, `ClientAuth`, sujeto controlado por el DMS y SAN permitido cuando identifica al dispositivo.",{"_2299":49354,"_22571":49309,"_15405":84736,"_5":15294,"_21315":84648,"_1890":84737},[],"**Servidor TLS**\\\nCertificado final, `DigitalSignature`, `ServerAuth` y SAN obligatorio con los nombres que utilizarán los clientes.",{"_2299":49355,"_22571":49309,"_15405":84739,"_5":15294,"_21315":84648,"_1890":84740},[],"**CA intermedia**\\\n`Sign as CA`, `CertSign` y `CRLSign`, validez superior a sus certificados finales y restricciones criptográficas más exigentes.",{"_2299":49356,"_22571":49309,"_15405":84742,"_5":15294,"_21315":84648,"_1890":84743},[],"Son patrones de partida, no una política universal. Verifica siempre los requisitos del protocolo, del consumidor y del marco regulatorio aplicable.",{"_2299":49357,"_22571":49309,"_15405":84745,"_5":15294,"_21315":84652,"_1890":84746},[],"Actualizar un perfil afecta a emisiones futuras; no modifica certificados ya firmados. Prueba los cambios antes de aplicarlos a una CA en producción y conserva la justificación operativa.",{"_2299":49358,"_22571":49309,"_15405":84748,"_5":15294,"_21315":84652,"_1890":84749},[],"Antes de eliminar un perfil, comprueba que ninguna CA o DMS dependa de él. Si deseas sustituirlo, crea la versión nueva, actualiza las referencias y realiza una emisión de prueba antes de retirar el anterior.",{"_2299":49359,"_22571":49359,"_5":10616,"_1890":84751,"_22830":84752,"_15405":84753,"_21315":49359},"Validación de certificados",[35156,83411,83889],[],{"_2299":49360,"_22571":49359,"_15405":84755,"_5":15294,"_21315":49359,"_1890":84756},[],"Publica el estado de las identidades mediante OCSP y CRL.",{"_2299":49361,"_22571":49359,"_5":22827,"_15405":84758,"_21315":84759,"_1890":84760},[],"/docs/es/platform/pki/certificate-validation#elige-un-mecanismo","Elige un mecanismo",{"_2299":49362,"_22571":49359,"_15405":84762,"_5":15294,"_21315":49359,"_1890":84763},[],"La emisión demuestra quién firmó un certificado; la validación permite saber si todavía debe aceptarse. Lamassu publica el estado mediante dos mecanismos complementarios.",{"_2299":49363,"_22571":49359,"_15405":84765,"_5":15294,"_21315":84759,"_1890":84766},[],"Usa **OCSP** cuando el consumidor esté conectado y necesite consultar el estado más reciente de un certificado concreto.",{"_2299":49364,"_22571":49359,"_15405":84768,"_5":15294,"_21315":84759,"_1890":84769},[],"Usa una **CRL** cuando la validación deba realizarse localmente, sin conexión o sobre un volumen elevado de certificados. El consumidor descarga periódicamente una lista firmada y la conserva hasta la siguiente actualización.",{"_2299":49365,"_22571":49359,"_15405":84771,"_5":15294,"_21315":84759,"_1890":84772},[],"Muchos entornos utilizan ambos: OCSP como comprobación primaria y CRL como mecanismo local o de respaldo.",{"_2299":49366,"_22571":49359,"_15405":84774,"_5":15294,"_21315":84759,"_1890":84775},[],"<Card title=\"Validación online con OCSP\" description=\"Consulta estados Good, Revoked y Unknown en tiempo real.\" href=\"/docs/platform/pki/ocsp\" />",{"_2299":49367,"_22571":49359,"_15405":84777,"_5":15294,"_21315":84759,"_1890":84778},[],"<Card title=\"Listas de revocación\" description=\"Genera, publica y distribuye CRLs por autoridad.\" href=\"/docs/platform/pki/crl\" />",{"_2299":49368,"_22571":49368,"_5":10616,"_1890":84780,"_22830":84781,"_15405":84782,"_21315":49368},"Certificados",[35156,83411,83889],[],{"_2299":49369,"_22571":49368,"_15405":84784,"_5":15294,"_21315":49368,"_1890":84785},[],"Consulta, descarga y revoca los certificados emitidos por Lamassu.",{"_2299":49370,"_22571":49368,"_5":22827,"_15405":84787,"_21315":84788,"_1890":84789},[],"/docs/es/platform/pki/certificates#busca-un-certificado","Busca un certificado",{"_2299":49371,"_22571":49368,"_5":22827,"_15405":84791,"_21315":84792,"_1890":84793},[],"/docs/es/platform/pki/certificates#descarga-el-certificado","Descarga el certificado",{"_2299":49372,"_22571":49368,"_5":22827,"_15405":84795,"_21315":84796,"_1890":84797},[],"/docs/es/platform/pki/certificates#revoca-un-certificado","Revoca un certificado",{"_2299":49373,"_22571":49368,"_5":22827,"_15405":84799,"_21315":84800,"_1890":84801},[],"/docs/es/platform/pki/certificates#abre-la-acción","Abre la acción",{"_2299":49374,"_22571":49368,"_5":22827,"_15405":84803,"_21315":84804,"_1890":84805},[],"/docs/es/platform/pki/certificates#elige-una-razón","Elige una razón",{"_2299":49375,"_22571":49368,"_5":22827,"_15405":84807,"_21315":84808,"_1890":84809},[],"/docs/es/platform/pki/certificates#confirma-y-verifica","Confirma y verifica",{"_2299":49376,"_22571":49368,"_5":22827,"_15405":84811,"_21315":84812,"_1890":84813},[],"/docs/es/platform/pki/certificates#continúa","Continúa",{"_2299":49377,"_22571":49368,"_15405":84815,"_5":15294,"_21315":49368,"_1890":84816},[],"El inventario de certificados ofrece una vista global de las identidades emitidas por todas las autoridades. También puedes abrir **Issued Certificates** dentro de una CA para limitar la vista a ese emisor.",{"_2299":49378,"_22571":49368,"_15405":84818,"_5":15294,"_21315":84788,"_1890":84819},[],"Abre **Certificates** y filtra por:",{"_2299":49379,"_22571":49368,"_15405":84821,"_5":15294,"_21315":84788,"_1890":84822},[],"`Common Name` del sujeto.",{"_2299":49380,"_22571":49368,"_15405":84824,"_5":15294,"_21315":84788,"_1890":84825},[],"Número de serie.",{"_2299":49381,"_22571":49368,"_15405":84827,"_5":15294,"_21315":84788,"_1890":84828},[],"Estado.",{"_2299":49382,"_22571":49368,"_15405":84830,"_5":15294,"_21315":84788,"_1890":84831},[],"Autoridad emisora.",{"_2299":49383,"_22571":49368,"_15405":84833,"_5":15294,"_21315":84788,"_1890":84834},[],"Utiliza **Quick Inspect** para una comprobación rápida o **View Details** para ver el sujeto, SANs, usos, cadena, periodo de validez y metadatos completos.",{"_2299":49384,"_22571":49368,"_15405":84836,"_5":15294,"_21315":84792,"_1890":84837},[],"La acción de descarga entrega el certificado en formato PEM. Si el certificado se emitió mediante un CSR externo, la clave privada permanece en el sistema que generó ese CSR. Si se generó en el navegador, la clave solo estuvo disponible al finalizar la emisión.",{"_2299":49385,"_22571":49368,"_15405":84839,"_5":15294,"_21315":84796,"_1890":84840},[],"Revoca una identidad cuando la clave se haya comprometido, el sujeto ya no esté autorizado o el certificado deba dejar de aceptarse antes de expirar.",{"_2299":49386,"_22571":49368,"_15405":84842,"_5":15294,"_21315":84800,"_1890":84843},[],"En el inventario o la vista de detalle, selecciona **Revoke Certificate**.",{"_2299":49387,"_22571":49368,"_15405":84845,"_5":15294,"_21315":84804,"_1890":84846},[],"Selecciona la razón que represente el incidente. Esta información se publica en OCSP y en la CRL.",{"_2299":49388,"_22571":49368,"_15405":84848,"_5":15294,"_21315":84808,"_1890":84849},[],"Confirma la operación y comprueba que el estado sea **Revoked**. Si la CA regenera la CRL al revocar, verifica también que exista una versión nueva.",{"_2299":49389,"_22571":49368,"_15405":84851,"_5":15294,"_21315":84808,"_1890":84852},[],"Una revocación con la razón `CertificateHold` puede reactivarse. Las demás razones producen una revocación definitiva.",{"_2299":49390,"_22571":49368,"_15405":84854,"_5":15294,"_21315":84812,"_1890":84855},[],"<Card title=\"Validar con OCSP\" description=\"Consulta el estado de un certificado en tiempo real.\" href=\"/docs/platform/pki/ocsp\" />",{"_2299":49391,"_22571":49368,"_15405":84857,"_5":15294,"_21315":84812,"_1890":84858},[],"<Card title=\"Distribuir una CRL\" description=\"Publica el estado para validación offline.\" href=\"/docs/platform/pki/crl\" />",{"_2299":49392,"_22571":49392,"_5":10616,"_1890":84860,"_22830":84861,"_15405":84863,"_21315":49392},"Arquitectura de la plataforma",[35156,83411,84862],"Conceptos",[],{"_2299":49393,"_22571":49392,"_15405":84865,"_5":15294,"_21315":49392,"_1890":84866},[],"Componentes de Lamassu y relación entre control, claves, emisión y dispositivos.",{"_2299":49394,"_22571":49392,"_5":22827,"_15405":84868,"_21315":84869,"_1890":84870},[],"/docs/es/platform/pki/concepts/architecture#plano-de-control","Plano de control",{"_2299":49395,"_22571":49392,"_5":22827,"_15405":84872,"_21315":84873,"_1890":84874},[],"/docs/es/platform/pki/concepts/architecture#custodia-y-operaciones-criptográficas","Custodia y operaciones criptográficas",{"_2299":49396,"_22571":49392,"_5":22827,"_15405":84876,"_21315":84877,"_1890":84878},[],"/docs/es/platform/pki/concepts/architecture#emisión-y-enrolamiento","Emisión y enrolamiento",{"_2299":49397,"_22571":49392,"_5":22827,"_15405":84880,"_21315":84881,"_1890":84882},[],"/docs/es/platform/pki/concepts/architecture#estado-y-validación","Estado y validación",{"_2299":49398,"_22571":49392,"_5":22827,"_15405":84884,"_21315":84885,"_1890":84886},[],"/docs/es/platform/pki/concepts/architecture#dependencias-de-la-plataforma","Dependencias de la plataforma",{"_2299":49399,"_22571":49392,"_15405":84888,"_5":15294,"_21315":49392,"_1890":84889},[],"Lamassu se despliega como un conjunto de servicios independientes. La separación evita que todos los componentes necesiten acceso directo a las claves privadas y permite escalar cada capacidad según la carga.",{"_2299":49400,"_22571":49392,"_15405":84891,"_5":15294,"_21315":84869,"_1890":84892},[],"La consola y las APIs administran autoridades, certificados, DMS, dispositivos, alertas y configuración. Los eventos de dominio permiten que conectores y automatizaciones reaccionen a los cambios sin sondear continuamente la plataforma.",{"_2299":49401,"_22571":49392,"_15405":84894,"_5":15294,"_21315":84873,"_1890":84895},[],"El KMS ofrece una interfaz común sobre motores software, PKCS#11 y proveedores cloud. El motor seleccionado conserva la clave o delega la operación criptográfica sin que los demás servicios conozcan su implementación.",{"_2299":49402,"_22571":49392,"_15405":84897,"_5":15294,"_21315":84877,"_1890":84898},[],"El servicio de CA emite certificados y mantiene la relación con su autoridad. El DMS aplica las reglas de enrolamiento y expone los flujos EST para que un dispositivo solicite o renueve una identidad.",{"_2299":49403,"_22571":49392,"_15405":84900,"_5":15294,"_21315":84881,"_1890":84901},[],"Device Manager conserva la vista operativa del dispositivo y su historial. Validation Authority publica OCSP y CRLs para que otros sistemas decidan si deben confiar en un certificado presentado.",{"_2299":49404,"_22571":49392,"_15405":84903,"_5":15294,"_21315":84885,"_1890":84904},[],"En un despliegue autogestionado, Lamassu utiliza PostgreSQL para persistencia, RabbitMQ para mensajería y un proveedor OIDC para autenticación. Consulta la arquitectura de despliegue para ver cómo se publican los servicios en Kubernetes.",{"_2299":49405,"_22571":49405,"_5":10616,"_1890":84906,"_22830":84907,"_15405":84908,"_21315":49405},"Ciclo de vida de un certificado",[35156,83411,84862],[],{"_2299":49406,"_22571":49405,"_15405":84910,"_5":15294,"_21315":49405,"_1890":84911},[],"Emisión, uso, renovación, revocación y retirada de certificados en Lamassu.",{"_2299":49407,"_22571":49405,"_5":22827,"_15405":84913,"_21315":84914,"_1890":84915},[],"/docs/es/platform/pki/concepts/certificate-lifecycle#el-recorrido-completo","El recorrido completo",{"_2299":49408,"_22571":49405,"_5":22827,"_15405":84917,"_21315":84918,"_1890":84919},[],"/docs/es/platform/pki/concepts/certificate-lifecycle#solicitud","Solicitud",{"_2299":49409,"_22571":49405,"_5":22827,"_15405":84921,"_21315":84922,"_1890":84923},[],"/docs/es/platform/pki/concepts/certificate-lifecycle#emisión","Emisión",{"_2299":49410,"_22571":49405,"_5":22827,"_15405":84925,"_21315":84926,"_1890":84927},[],"/docs/es/platform/pki/concepts/certificate-lifecycle#uso-y-supervisión","Uso y supervisión",{"_2299":49411,"_22571":49405,"_5":22827,"_15405":84929,"_21315":84930,"_1890":84931},[],"/docs/es/platform/pki/concepts/certificate-lifecycle#renovación-o-re-enrolamiento","Renovación o re-enrolamiento",{"_2299":49412,"_22571":49405,"_5":22827,"_15405":84933,"_21315":84934,"_1890":84935},[],"/docs/es/platform/pki/concepts/certificate-lifecycle#revocación-o-retirada","Revocación o retirada",{"_2299":49413,"_22571":49405,"_5":22827,"_15405":84937,"_21315":84938,"_1890":84939},[],"/docs/es/platform/pki/concepts/certificate-lifecycle#estados-del-certificado","Estados del certificado",{"_2299":49414,"_22571":49405,"_5":22827,"_15405":84941,"_21315":84942,"_1890":84943},[],"/docs/es/platform/pki/concepts/certificate-lifecycle#renovación-y-revocación-no-son-equivalentes","Renovación y revocación no son equivalentes",{"_2299":49415,"_22571":49405,"_5":22827,"_15405":84945,"_21315":84946,"_1890":84947},[],"/docs/es/platform/pki/concepts/certificate-lifecycle#efecto-de-revocar-una-ca","Efecto de revocar una CA",{"_2299":49416,"_22571":49405,"_5":22827,"_15405":84949,"_21315":84950,"_1890":84951},[],"/docs/es/platform/pki/concepts/certificate-lifecycle#qué-debes-observar","Qué debes observar",{"_2299":49417,"_22571":49405,"_15405":84953,"_5":15294,"_21315":49405,"_1890":84954},[],"Emitir un certificado es solo el comienzo. Durante su vida útil debes comprobar su vigencia, renovarlo antes de que caduque y retirarlo cuando deje de ser fiable. Lamassu conserva el certificado, su CA emisora, su estado y, cuando pertenece a un dispositivo, la identidad a la que está vinculado.",{"_2299":49418,"_22571":49405,"_15405":84956,"_5":15294,"_21315":84918,"_1890":84957},[],"El solicitante genera una clave y una CSR. En los flujos recomendados, la clave privada permanece en el dispositivo, navegador o motor criptográfico que la creó.",{"_2299":49419,"_22571":49405,"_15405":84959,"_5":15294,"_21315":84922,"_1890":84960},[],"La CA firma la CSR. El perfil de emisión determina la validez, los usos, el sujeto, las extensiones admitidas y las restricciones criptográficas.",{"_2299":49420,"_22571":49405,"_15405":84962,"_5":15294,"_21315":84926,"_1890":84963},[],"El certificado queda en estado `ACTIVE`. Lamassu monitoriza su fecha `Not After`; el trabajo de monitorización criptográfica marca como `EXPIRED` los certificados que han vencido.",{"_2299":49421,"_22571":49405,"_15405":84965,"_5":15294,"_21315":84930,"_1890":84966},[],"Se emite un certificado nuevo antes de que caduque el anterior. En un DMS puedes abrir ventanas preventiva y crítica para que el dispositivo se re-enrole mediante EST.",{"_2299":49422,"_22571":49405,"_15405":84968,"_5":15294,"_21315":84934,"_1890":84969},[],"Si la identidad deja de ser fiable, Lamassu registra la razón y la hora de revocación. OCSP y las CRLs permiten que los consumidores conozcan ese estado.",{"_2299":49423,"_22571":49405,"_15405":84971,"_5":15294,"_21315":84938,"_1890":84972},[],"Lamassu persiste cuatro estados X.509:",{"_2299":49424,"_22571":49405,"_15405":84974,"_5":15294,"_21315":84938,"_1890":84975},[],"**`ACTIVE`**: el certificado está habilitado y dentro de su periodo de validez.",{"_2299":49425,"_22571":49405,"_15405":84977,"_5":15294,"_21315":84938,"_1890":84978},[],"**`EXPIRED`**: ha superado su fecha de expiración. El monitor lo detecta de forma periódica; no es un estado que deba asignarse manualmente.",{"_2299":49426,"_22571":49405,"_15405":84980,"_5":15294,"_21315":84938,"_1890":84981},[],"**`REVOKED`**: fue invalidado antes de expirar, con una razón y una marca temporal.",{"_2299":49427,"_22571":49405,"_15405":84983,"_5":15294,"_21315":84938,"_1890":84984},[],"**`INACTIVE`**: está deshabilitado sin representar una revocación definitiva.",{"_2299":49428,"_22571":49405,"_15405":84986,"_5":15294,"_21315":84938,"_1890":84987},[],"La vista del dispositivo puede añadir estados operativos como ausencia de identidad, renovación pendiente, expiración próxima o baja. Son una interpretación del estado del dispositivo y de sus certificados, no nuevos estados X.509.",{"_2299":49429,"_22571":49405,"_15405":84989,"_5":15294,"_21315":84942,"_1890":84990},[],"La **renovación** crea un certificado sucesor para una identidad que continúa siendo válida. La **revocación** comunica que el certificado actual ya no debe aceptarse. Renueva para mantener continuidad; revoca ante compromiso, retirada o un cambio que invalide la identidad.",{"_2299":49430,"_22571":49405,"_15405":84992,"_5":15294,"_21315":84942,"_1890":84993},[],"Solo una revocación con razón `CertificateHold` puede revertirse. Una revocación con cualquier otra razón es definitiva en Lamassu.",{"_2299":49431,"_22571":49405,"_15405":84995,"_5":15294,"_21315":84942,"_1890":84996},[],"La operación **Reissue CA** genera otro certificado para la misma clave y enlaza ambos números de serie mediante metadatos. No equivale a una rotación de clave. Para cambiar la clave, crea una CA sucesora y realiza una migración con periodo de solapamiento.",{"_2299":49432,"_22571":49405,"_15405":84998,"_5":15294,"_21315":84946,"_1890":84999},[],"Revocar una CA es una operación en cascada. Lamassu revoca sus CAs hijas y los certificados que ha emitido con la razón `CessationOfOperation`. La propagación continúa por la jerarquía.",{"_2299":49433,"_22571":49405,"_15405":85001,"_5":15294,"_21315":84946,"_1890":85002},[],"Antes de confirmar:",{"_2299":49434,"_22571":49405,"_15405":85004,"_5":15294,"_21315":84946,"_1890":85005},[],"Identifica DMS, dispositivos y servicios que confían en esa cadena.",{"_2299":49435,"_22571":49405,"_15405":85007,"_5":15294,"_21315":84946,"_1890":85008},[],"Distribuye la nueva cadena de confianza.",{"_2299":49436,"_22571":49405,"_15405":85010,"_5":15294,"_21315":84946,"_1890":85011},[],"Reemite las identidades necesarias.",{"_2299":49437,"_22571":49405,"_15405":85013,"_5":15294,"_21315":84946,"_1890":85014},[],"Comprueba OCSP y CRL desde un consumidor real.",{"_2299":49438,"_22571":49405,"_15405":85016,"_5":15294,"_21315":84946,"_1890":85017},[],"Revoca la CA antigua cuando ya no exista tráfico legítimo.",{"_2299":49439,"_22571":49405,"_15405":85019,"_5":15294,"_21315":84946,"_1890":85020},[],"Dar de baja un dispositivo revoca sus certificados y le impide obtener nuevas identidades. Utiliza esta acción únicamente cuando el dispositivo se retire de forma permanente.",{"_2299":49440,"_22571":49405,"_15405":85022,"_5":15294,"_21315":84950,"_1890":85023},[],"Certificados que entran en la ventana preventiva o crítica de renovación.",{"_2299":49441,"_22571":49405,"_15405":85025,"_5":15294,"_21315":84950,"_1890":85026},[],"Errores repetidos de enrolamiento o re-enrolamiento.",{"_2299":49442,"_22571":49405,"_15405":85028,"_5":15294,"_21315":84950,"_1890":85029},[],"Cambios de estado y razones de revocación.",{"_2299":49443,"_22571":49405,"_15405":85031,"_5":15294,"_21315":84950,"_1890":85032},[],"Publicación y vigencia de OCSP y CRLs.",{"_2299":49444,"_22571":49405,"_15405":85034,"_5":15294,"_21315":84950,"_1890":85035},[],"Dependencias que todavía presentan un certificado sustituido.",{"_2299":49445,"_22571":49405,"_15405":85037,"_5":15294,"_21315":84950,"_1890":85038},[],"El historial del dispositivo relaciona sus identidades anteriores y actuales. Para cambios administrativos y errores de mutación, consulta Registros de auditoría.",{"_2299":49446,"_22571":49446,"_5":10616,"_1890":85040,"_22830":85041,"_15405":85042,"_21315":49446},"Glosario",[35156,83411,84862],[],{"_2299":49447,"_22571":49446,"_15405":85044,"_5":15294,"_21315":49446,"_1890":85045},[],"Términos de PKI, certificados y gestión de identidades usados en Lamassu.",{"_2299":49448,"_22571":49446,"_5":22827,"_15405":85047,"_21315":85048,"_1890":37929},[],"/docs/es/platform/pki/concepts/glossary#ac",{"_2299":49449,"_22571":49446,"_5":22827,"_15405":85050,"_21315":85051,"_1890":37933},[],"/docs/es/platform/pki/concepts/glossary#dk",{"_2299":49450,"_22571":49446,"_5":22827,"_15405":85053,"_21315":85054,"_1890":37937},[],"/docs/es/platform/pki/concepts/glossary#mr",{"_2299":49451,"_22571":49446,"_5":22827,"_15405":85056,"_21315":85057,"_1890":37941},[],"/docs/es/platform/pki/concepts/glossary#sz",{"_2299":49452,"_22571":49446,"_15405":85059,"_5":15294,"_21315":85048,"_1890":85060},[],"**AKI (Authority Key Identifier)**\\\nIdentificador de la clave pública de la autoridad que firmó un certificado. Ayuda a construir la cadena hacia el emisor correcto.",{"_2299":49453,"_22571":49446,"_15405":85062,"_5":15294,"_21315":85048,"_1890":85063},[],"**Ancla de confianza**\\\nCertificado, normalmente de una CA raíz, que un consumidor acepta de forma explícita como punto final de una cadena.",{"_2299":49454,"_22571":49446,"_15405":85065,"_5":15294,"_21315":85048,"_1890":85066},[],"**CA (Certification Authority)**\\\nAutoridad que firma certificados y vincula una identidad con una clave pública.",{"_2299":49455,"_22571":49446,"_15405":85068,"_5":15294,"_21315":85048,"_1890":85069},[],"**CA intermedia**\\\nCA firmada por otra autoridad. Se utiliza para emitir sin exponer la raíz a la operación diaria.",{"_2299":49456,"_22571":49446,"_15405":85071,"_5":15294,"_21315":85048,"_1890":85072},[],"**CA raíz**\\\nCA autofirmada que inicia una jerarquía de confianza.",{"_2299":49457,"_22571":49446,"_15405":85074,"_5":15294,"_21315":85048,"_1890":85075},[],"**Certificado X.509**\\\nDocumento firmado que contiene una clave pública, un sujeto, un emisor, un periodo de validez y extensiones que delimitan su uso.",{"_2299":49458,"_22571":49446,"_15405":85077,"_5":15294,"_21315":85048,"_1890":85078},[],"**CRL (Certificate Revocation List)**\\\nLista firmada de certificados revocados publicada por una CA.",{"_2299":49459,"_22571":49446,"_15405":85080,"_5":15294,"_21315":85048,"_1890":85081},[],"**CSR (Certificate Signing Request)**\\\nSolicitud PKCS#10 que contiene una clave pública y atributos solicitados. La firma de la CSR demuestra posesión de la clave privada correspondiente.",{"_2299":49460,"_22571":49446,"_15405":85083,"_5":15294,"_21315":85051,"_1890":85084},[],"**DMS (Device Management Service)**\\\nConfiguración que agrupa reglas de registro, enrolamiento, re-enrolamiento, emisión y distribución de CAs para una flota.",{"_2299":49461,"_22571":49446,"_15405":85086,"_5":15294,"_21315":85051,"_1890":85087},[],"**Distinguished Name (DN)**\\\nConjunto de atributos del sujeto o emisor, como `CN`, `O`, `OU`, `C`, `ST` y `L`.",{"_2299":49462,"_22571":49446,"_15405":85089,"_5":15294,"_21315":85051,"_1890":85090},[],"**EST (Enrollment over Secure Transport)**\\\nProtocolo definido en RFC 7030 para obtener CAs, enrolar y re-enrolar certificados sobre HTTPS.",{"_2299":49463,"_22571":49446,"_15405":85092,"_5":15294,"_21315":85051,"_1890":85093},[],"**Extended Key Usage (EKU)**\\\nExtensión que acota finalidades como autenticación de cliente, autenticación de servidor, firma de código u OCSP.",{"_2299":49464,"_22571":49446,"_15405":85095,"_5":15294,"_21315":85051,"_1890":85096},[],"**Identidad de dispositivo**\\\nRelación entre un dispositivo y uno de sus certificados. Un dispositivo puede conservar un historial de identidades.",{"_2299":49465,"_22571":49446,"_15405":85098,"_5":15294,"_21315":85051,"_1890":85099},[],"**Identity slot**\\\nPosición lógica en un dispositivo donde Lamassu vincula una identidad activa o histórica.",{"_2299":49466,"_22571":49446,"_15405":85101,"_5":15294,"_21315":85051,"_1890":85102},[],"**JITP (Just-in-Time Provisioning)**\\\nRegistro automático de un dispositivo cuando completa correctamente su primer enrolamiento.",{"_2299":49467,"_22571":49446,"_15405":85104,"_5":15294,"_21315":85051,"_1890":85105},[],"**KMS (Key Management Service)**\\\nServicio de Lamassu que normaliza generación, importación y uso de claves sobre distintos motores criptográficos.",{"_2299":49468,"_22571":49446,"_15405":85107,"_5":15294,"_21315":85051,"_1890":85108},[],"**Key Usage**\\\nExtensión X.509 que permite operaciones básicas como firma digital, cifrado de clave o firma de certificados.",{"_2299":49469,"_22571":49446,"_15405":85110,"_5":15294,"_21315":85054,"_1890":85111},[],"**mTLS (Mutual TLS)**\\\nTLS donde cliente y servidor presentan certificados. Un DMS puede usar el certificado cliente como método de autenticación.",{"_2299":49470,"_22571":49446,"_15405":85113,"_5":15294,"_21315":85054,"_1890":85114},[],"**OCSP (Online Certificate Status Protocol)**\\\nProtocolo para consultar en línea si un certificado está vigente, revocado o es desconocido.",{"_2299":49471,"_22571":49446,"_15405":85116,"_5":15294,"_21315":85054,"_1890":85117},[],"**Perfil de emisión**\\\nPolítica reutilizable que define cómo Lamassu construye un certificado y qué claves acepta.",{"_2299":49472,"_22571":49446,"_15405":85119,"_5":15294,"_21315":85054,"_1890":85120},[],"**Principal**\\\nIdentidad de operador o cliente de API reconocida por el servicio de autorización. Lamassu admite principales OIDC y X.509.",{"_2299":49473,"_22571":49446,"_15405":85122,"_5":15294,"_21315":85054,"_1890":85123},[],"**Política**\\\nConjunto de permisos asignable a uno o varios principales.",{"_2299":49474,"_22571":49446,"_15405":85125,"_5":15294,"_21315":85054,"_1890":85126},[],"**RA (Registration Authority)**\\\nComponente que verifica al solicitante antes de pedir a una CA que emita. El DMS cumple este papel en los flujos de enrolamiento de dispositivos.",{"_2299":49475,"_22571":49446,"_15405":85128,"_5":15294,"_21315":85054,"_1890":85129},[],"**Relying party**\\\nSistema consumidor que decide si acepta un certificado presentado.",{"_2299":49476,"_22571":49446,"_15405":85131,"_5":15294,"_21315":85054,"_1890":85132},[],"**Revocación**\\\nInvalidación de un certificado antes de su fecha de expiración.",{"_2299":49477,"_22571":49446,"_15405":85134,"_5":15294,"_21315":85057,"_1890":85135},[],"**SAN (Subject Alternative Name)**\\\nExtensión que añade identidades como nombres DNS, direcciones IP, correos o URIs.",{"_2299":49478,"_22571":49446,"_15405":85137,"_5":15294,"_21315":85057,"_1890":85138},[],"**SKI (Subject Key Identifier)**\\\nIdentificador derivado de la clave pública del propio certificado.",{"_2299":49479,"_22571":49446,"_15405":85140,"_5":15294,"_21315":85057,"_1890":85141},[],"**VA (Validation Authority)**\\\nServicio de Lamassu responsable de las respuestas OCSP y la generación o publicación de CRLs.",{"_2299":49480,"_22571":49446,"_15405":85143,"_5":15294,"_21315":85057,"_1890":85144},[],"**Ventana de renovación**\\\nPeriodo anterior a la expiración durante el que un dispositivo puede o debe solicitar otra identidad.",{"_2299":49481,"_22571":49446,"_15405":85146,"_5":15294,"_21315":85057,"_1890":85147},[],"¿Falta un término operativo? Consulta primero Cómo funciona Lamassu y el Modelo de confianza, donde estos conceptos aparecen conectados.",{"_2299":49482,"_22571":49482,"_5":10616,"_1890":85149,"_22830":85150,"_15405":85151,"_21315":49482},"Cómo funciona Lamassu",[35156,83411,84862],[],{"_2299":49483,"_22571":49482,"_15405":85153,"_5":15294,"_21315":49482,"_1890":85154},[],"El modelo mental de confianza, claves, certificados y dispositivos.",{"_2299":49484,"_22571":49482,"_5":22827,"_15405":85156,"_21315":85157,"_1890":85158},[],"/docs/es/platform/pki/concepts/overview#el-modelo-en-cinco-piezas","El modelo en cinco piezas",{"_2299":49485,"_22571":49482,"_5":22827,"_15405":85160,"_21315":85161,"_1890":85162},[],"/docs/es/platform/pki/concepts/overview#del-alta-a-la-operación","Del alta a la operación",{"_2299":49486,"_22571":49482,"_15405":85164,"_5":15294,"_21315":49482,"_1890":85165},[],"Lamassu conecta tres elementos: una **raíz de confianza**, una **política de emisión** y una **entidad que necesita demostrar su identidad**. La plataforma coordina esos elementos durante todo el ciclo de vida del certificado.",{"_2299":49487,"_22571":49482,"_15405":85167,"_5":15294,"_21315":85157,"_1890":85168},[],"**Motor criptográfico.** Genera o custodia claves y ejecuta las operaciones privadas sin exponer el material criptográfico al resto de servicios.",{"_2299":49488,"_22571":49482,"_15405":85170,"_5":15294,"_21315":85157,"_1890":85171},[],"**Autoridad de certificación (CA).** Firma certificados y establece la cadena de confianza.",{"_2299":49489,"_22571":49482,"_15405":85173,"_5":15294,"_21315":85157,"_1890":85174},[],"**Device Management Service (DMS).** Define cómo se registran, autentican y renuevan los dispositivos de una flota.",{"_2299":49490,"_22571":49482,"_15405":85176,"_5":15294,"_21315":85157,"_1890":85177},[],"**Dispositivo.** Conserva su clave privada y presenta el certificado para demostrar su identidad.",{"_2299":49491,"_22571":49482,"_15405":85179,"_5":15294,"_21315":85157,"_1890":85180},[],"**Validation Authority (VA).** Publica el estado de los certificados mediante OCSP y CRL.",{"_2299":49492,"_22571":49482,"_15405":85182,"_5":15294,"_21315":85161,"_1890":85183},[],"Un administrador configura un motor criptográfico y crea o importa una CA.",{"_2299":49493,"_22571":49482,"_15405":85185,"_5":15294,"_21315":85161,"_1890":85186},[],"Un DMS relaciona esa CA con una política de enrolamiento.",{"_2299":49494,"_22571":49482,"_15405":85188,"_5":15294,"_21315":85161,"_1890":85189},[],"El dispositivo genera una clave y solicita un certificado mediante EST, o un operador le asigna una identidad.",{"_2299":49495,"_22571":49482,"_15405":85191,"_5":15294,"_21315":85161,"_1890":85192},[],"Lamassu conserva el inventario, el historial y el estado de la identidad.",{"_2299":49496,"_22571":49482,"_15405":85194,"_5":15294,"_21315":85161,"_1890":85195},[],"Los consumidores comprueban la cadena y consultan OCSP o una CRL cuando necesitan conocer su vigencia.",{"_2299":49497,"_22571":49482,"_15405":85197,"_5":15294,"_21315":85161,"_1890":85198},[],"<Card title=\"Arquitectura\" description=\"Conoce los componentes y dónde termina la responsabilidad de cada uno.\" href=\"/docs/platform/pki/concepts/architecture\" />",{"_2299":49498,"_22571":49482,"_15405":85200,"_5":15294,"_21315":85161,"_1890":85201},[],"<Card title=\"Ciclo de vida de una identidad\" description=\"Sigue un certificado desde el enrolamiento hasta la renovación o revocación.\" href=\"/docs/platform/pki/concepts/certificate-lifecycle\" />",{"_2299":49499,"_22571":49499,"_5":10616,"_1890":85203,"_22830":85204,"_15405":85205,"_21315":49499},"Modelo de confianza",[35156,83411,84862],[],{"_2299":49500,"_22571":49499,"_15405":85207,"_5":15294,"_21315":49499,"_1890":85208},[],"Entiende dónde nace la confianza, cómo se distribuye y qué valida cada componente.",{"_2299":49501,"_22571":49499,"_5":22827,"_15405":85210,"_21315":85211,"_1890":85212},[],"/docs/es/platform/pki/concepts/trust-model#las-cuatro-decisiones-de-confianza","Las cuatro decisiones de confianza",{"_2299":49502,"_22571":49499,"_5":22827,"_15405":85214,"_21315":85215,"_1890":85216},[],"/docs/es/platform/pki/concepts/trust-model#quién-puede-emitir","Quién puede emitir",{"_2299":49503,"_22571":49499,"_5":22827,"_15405":85218,"_21315":85219,"_1890":85220},[],"/docs/es/platform/pki/concepts/trust-model#qué-puede-emitirse","Qué puede emitirse",{"_2299":49504,"_22571":49499,"_5":22827,"_15405":85222,"_21315":85223,"_1890":85224},[],"/docs/es/platform/pki/concepts/trust-model#quién-puede-solicitarlo","Quién puede solicitarlo",{"_2299":49505,"_22571":49499,"_5":22827,"_15405":85226,"_21315":85227,"_1890":85228},[],"/docs/es/platform/pki/concepts/trust-model#quién-acepta-el-resultado","Quién acepta el resultado",{"_2299":49506,"_22571":49499,"_5":22827,"_15405":85230,"_21315":85231,"_1890":85232},[],"/docs/es/platform/pki/concepts/trust-model#flujo-de-una-identidad","Flujo de una identidad",{"_2299":49507,"_22571":49499,"_5":22827,"_15405":85234,"_21315":85235,"_1890":85236},[],"/docs/es/platform/pki/concepts/trust-model#cas-de-enrolamiento-validación-y-distribución","CAs de enrolamiento, validación y distribución",{"_2299":49508,"_22571":49499,"_5":22827,"_15405":85238,"_21315":85239,"_1890":85240},[],"/docs/es/platform/pki/concepts/trust-model#validación-y-revocación","Validación y revocación",{"_2299":49509,"_22571":49499,"_5":22827,"_15405":85242,"_21315":85243,"_1890":85244},[],"/docs/es/platform/pki/concepts/trust-model#límites-de-custodia","Límites de custodia",{"_2299":49510,"_22571":49499,"_5":22827,"_15405":85246,"_21315":85247,"_1890":85248},[],"/docs/es/platform/pki/concepts/trust-model#patrón-recomendado","Patrón recomendado",{"_2299":49511,"_22571":49499,"_15405":85250,"_5":15294,"_21315":49499,"_1890":85251},[],"En Lamassu, confianza no significa simplemente que un certificado exista en el inventario. Un consumidor confía en una identidad cuando puede construir una cadena hasta una raíz que reconoce, comprobar que el certificado sirve para el uso esperado y verificar que sigue vigente.",{"_2299":49512,"_22571":49499,"_15405":85253,"_5":15294,"_21315":85215,"_1890":85254},[],"La jerarquía de CAs define qué autoridades pueden firmar. Una CA raíz establece el ancla de confianza; las CAs intermedias separan ámbitos operativos y evitan utilizar la raíz para cada emisión.",{"_2299":49513,"_22571":49499,"_15405":85256,"_5":15294,"_21315":85219,"_1890":85257},[],"Los perfiles de certificado limitan validez, sujeto, usos, extensiones y parámetros criptográficos. La posesión de una CA no sustituye a una política de emisión.",{"_2299":49514,"_22571":49499,"_15405":85259,"_5":15294,"_21315":85223,"_1890":85260},[],"El DMS actúa como punto de enrolamiento. Puede autenticar una solicitud EST con certificado cliente, webhook externo o una combinación de ambos. Las CAs configuradas para validar al solicitante no tienen por qué ser la CA que emitirá la identidad nueva.",{"_2299":49515,"_22571":49499,"_15405":85262,"_5":15294,"_21315":85227,"_1890":85263},[],"El servicio o dispositivo consumidor mantiene su propio almacén de confianza. Lamassu puede distribuir la CA del sistema, la CA de enrolamiento y otras CAs gestionadas mediante `/cacerts`, pero el consumidor decide cuáles instala y cómo aplica la validación.",{"_2299":49516,"_22571":49499,"_15405":85265,"_5":15294,"_21315":85231,"_1890":85266},[],"El dispositivo demuestra que puede enrolarse según la política del DMS.",{"_2299":49517,"_22571":49499,"_15405":85268,"_5":15294,"_21315":85231,"_1890":85269},[],"El DMS valida la solicitud y remite la CSR a la CA de enrolamiento.",{"_2299":49518,"_22571":49499,"_15405":85271,"_5":15294,"_21315":85231,"_1890":85272},[],"La CA aplica el perfil y firma sin recibir la clave privada del dispositivo.",{"_2299":49519,"_22571":49499,"_15405":85274,"_5":15294,"_21315":85231,"_1890":85275},[],"El dispositivo instala el certificado y la cadena que necesita.",{"_2299":49520,"_22571":49499,"_15405":85277,"_5":15294,"_21315":85231,"_1890":85278},[],"El sistema que confía en el dispositivo valida cadena, fechas, usos y estado de revocación.",{"_2299":49521,"_22571":49499,"_15405":85280,"_5":15294,"_21315":85231,"_1890":85281},[],"OIDC o X.509 identifica al operador que llama a Lamassu. El servicio de autorización decide qué acciones puede realizar. La jerarquía X.509, en cambio, determina si un certificado presentado por un dispositivo es confiable.",{"_2299":49522,"_22571":49499,"_15405":85283,"_5":15294,"_21315":85235,"_1890":85284},[],"Un DMS relaciona tres conjuntos que conviene diseñar por separado:",{"_2299":49523,"_22571":49499,"_15405":85286,"_5":15294,"_21315":85235,"_1890":85287},[],"**CA de enrolamiento:** firma las nuevas identidades.",{"_2299":49524,"_22571":49499,"_15405":85289,"_5":15294,"_21315":85235,"_1890":85290},[],"**CAs de validación:** autentican certificados cliente usados para enrolamiento o migración. En re-enrolamiento, Lamassu prueba primero la CA de enrolamiento y después las CAs de validación adicionales.",{"_2299":49525,"_22571":49499,"_15405":85292,"_5":15294,"_21315":85235,"_1890":85293},[],"**CAs distribuidas:** forman el contenido que el dispositivo obtiene mediante EST `/cacerts`. Puedes incluir la CA del sistema, la CA de enrolamiento y una lista de CAs gestionadas.",{"_2299":49526,"_22571":49499,"_15405":85295,"_5":15294,"_21315":85235,"_1890":85296},[],"Esta separación permite migrar una flota: aceptas temporalmente certificados de la jerarquía anterior, emites con la nueva y distribuyes ambas cadenas durante el solapamiento.",{"_2299":49527,"_22571":49499,"_15405":85298,"_5":15294,"_21315":85239,"_1890":85299},[],"Una cadena válida no garantiza por sí sola que el certificado deba aceptarse. El consumidor también debe comprobar:",{"_2299":49528,"_22571":49499,"_15405":85301,"_5":15294,"_21315":85239,"_1890":85302},[],"que la fecha actual está entre `Not Before` y `Not After`;",{"_2299":49529,"_22571":49499,"_15405":85304,"_5":15294,"_21315":85239,"_1890":85305},[],"que `Key Usage` y `Extended Key Usage` permiten la operación;",{"_2299":49530,"_22571":49499,"_15405":85307,"_5":15294,"_21315":85239,"_1890":85308},[],"que nombres, SANs y sujeto coinciden con la identidad esperada;",{"_2299":49531,"_22571":49499,"_15405":85310,"_5":15294,"_21315":85239,"_1890":85311},[],"que el certificado no aparece revocado mediante OCSP o una CRL.",{"_2299":49532,"_22571":49499,"_15405":85313,"_5":15294,"_21315":85239,"_1890":85314},[],"Durante la autenticación mTLS de un DMS, Lamassu intenta comprobar la revocación. Si el certificado no contiene información suficiente para efectuar esa comprobación, el backend registra una advertencia y continúa tratándolo como no revocado. Diseña los perfiles y puntos de distribución para evitar esa situación en producción.",{"_2299":49533,"_22571":49499,"_15405":85316,"_5":15294,"_21315":85243,"_1890":85317},[],"El KMS conserva la referencia de la clave y delega la operación al motor configurado. Con un HSM o un KMS cloud, la clave privada puede permanecer no exportable. Eso protege la custodia, pero no impide por sí solo el uso indebido: todavía debes restringir quién puede ordenar una firma y auditar esas operaciones.",{"_2299":49534,"_22571":49499,"_15405":85319,"_5":15294,"_21315":85247,"_1890":85320},[],"Mantén la raíz fuera de las operaciones diarias o con acceso muy restringido.",{"_2299":49535,"_22571":49499,"_15405":85322,"_5":15294,"_21315":85247,"_1890":85323},[],"Emite desde CAs intermedias separadas por entorno o dominio de riesgo.",{"_2299":49536,"_22571":49499,"_15405":85325,"_5":15294,"_21315":85247,"_1890":85326},[],"Asigna perfiles explícitos a cada caso de uso.",{"_2299":49537,"_22571":49499,"_15405":85328,"_5":15294,"_21315":85247,"_1890":85329},[],"Distribuye la nueva confianza antes de comenzar una rotación.",{"_2299":49538,"_22571":49499,"_15405":85331,"_5":15294,"_21315":85247,"_1890":85332},[],"Mantén solapamiento suficiente para renovar una flota desconectada.",{"_2299":49539,"_22571":49499,"_15405":85334,"_5":15294,"_21315":85247,"_1890":85335},[],"Valida desde el sistema consumidor, no solo desde la consola de Lamassu.",{"_2299":49540,"_22571":49499,"_15405":85337,"_5":15294,"_21315":85247,"_1890":85338},[],"Continúa con Jerarquía y rotación de CAs para convertir este modelo en un procedimiento operativo.",{"_2299":49541,"_22571":49541,"_5":10616,"_1890":85340,"_22830":85341,"_15405":85342,"_21315":49541},"Listas de revocación (CRL)",[35156,83411,83889],[],{"_2299":49542,"_22571":49541,"_15405":85344,"_5":15294,"_21315":49541,"_1890":85345},[],"Genera y distribuye listas firmadas para validar certificados sin conexión.",{"_2299":49543,"_22571":49541,"_5":22827,"_15405":85347,"_21315":85348,"_1890":85349},[],"/docs/es/platform/pki/crl#servicio-crl","Servicio CRL",{"_2299":49544,"_22571":49541,"_5":22827,"_15405":85351,"_21315":85352,"_1890":85353},[],"/docs/es/platform/pki/crl#rol-va-y-configuración-por-ca","Rol VA y configuración por CA",{"_2299":49545,"_22571":49541,"_5":22827,"_15405":85355,"_21315":85356,"_1890":85357},[],"/docs/es/platform/pki/crl#regeneración-periódica-y-automática","Regeneración periódica y automática",{"_2299":49546,"_22571":49541,"_5":22827,"_15405":85359,"_21315":85360,"_1890":85361},[],"/docs/es/platform/pki/crl#contenido-de-la-crl","Contenido de la CRL",{"_2299":49547,"_22571":49541,"_5":22827,"_15405":85363,"_21315":85364,"_1890":85365},[],"/docs/es/platform/pki/crl#endpoint-público-de-descarga","Endpoint público de descarga",{"_2299":49548,"_22571":49541,"_5":22827,"_15405":85367,"_21315":85368,"_1890":85369},[],"/docs/es/platform/pki/crl#api-de-gestión-del-rol-va","API de gestión del rol VA",{"_2299":49549,"_22571":49541,"_5":22827,"_15405":85371,"_21315":85372,"_1890":85373},[],"/docs/es/platform/pki/crl#desde-la-interfaz","Desde la interfaz",{"_2299":49550,"_22571":49541,"_5":22827,"_15405":85375,"_21315":85376,"_1890":85377},[],"/docs/es/platform/pki/crl#referencias","Referencias",{"_2299":49551,"_22571":49541,"_15405":85379,"_5":15294,"_21315":85348,"_1890":85380},[],"Una CRL (*Certificate Revocation List*) es una lista firmada que contiene los números de serie de los certificados revocados antes de su fecha de caducidad. A diferencia de OCSP, no requiere una consulta en tiempo real: la parte que confía descarga la lista periódicamente y la consulta de forma local.",{"_2299":49552,"_22571":49541,"_15405":85382,"_5":15294,"_21315":85348,"_1890":85383},[],"Lamassu genera y mantiene una CRL por cada CA que gestiona. Cada CRL está firmada con la clave privada de la propia CA emisora y se almacena en el sistema de almacenamiento de objetos configurado en la plataforma.",{"_2299":49553,"_22571":49541,"_15405":85385,"_5":15294,"_21315":85352,"_1890":85386},[],"La publicación de la CRL de cada CA se controla mediante un *rol VA*. Este objeto define cómo se genera, cuándo se regenera y qué clave se utiliza para firmarla.",{"_2299":49554,"_22571":49541,"_15405":85388,"_5":15294,"_21315":85352,"_1890":85389},[],"Los parámetros principales son:",{"_2299":49555,"_22571":49541,"_15405":85391,"_5":15294,"_21315":85352,"_1890":85392},[],"**`validity`** define el periodo de validez reflejado en `nextUpdate`. Su valor predeterminado es 7 días.",{"_2299":49556,"_22571":49541,"_15405":85394,"_5":15294,"_21315":85352,"_1890":85395},[],"**`refresh_interval`** establece el intervalo mínimo entre regeneraciones programadas. Por defecto es aproximadamente 6 días y 23 horas.",{"_2299":49557,"_22571":49541,"_15405":85397,"_5":15294,"_21315":85352,"_1890":85398},[],"**`regenerate_on_revoke`** ordena publicar una versión nueva inmediatamente después de una revocación. Está activo por defecto.",{"_2299":49558,"_22571":49541,"_15405":85400,"_5":15294,"_21315":85352,"_1890":85401},[],"El campo `subject_key_id_signer` identifica la CA cuya clave privada firma la CRL. Por defecto, cada CA firma su propia CRL.",{"_2299":49559,"_22571":49541,"_15405":85403,"_5":15294,"_21315":85352,"_1890":85404},[],"Cada CRL lleva un número de versión incremental. Lamassu almacena todas las versiones en la ruta `pki/va/crl/{subject_key_id}/{version}.crl` del almacenamiento de objetos.",{"_2299":49560,"_22571":49541,"_15405":85406,"_5":15294,"_21315":85356,"_1890":85407},[],"Un proceso en segundo plano supervisa los roles VA activos. Cuando la validez restante de la CRL vigente cae por debajo del período de vigilancia configurado (*blind period*), el sistema solicita la generación de una nueva CRL. Así se evita que la CRL publicada caduque sin que exista una versión válida disponible.",{"_2299":49561,"_22571":49541,"_15405":85409,"_5":15294,"_21315":85356,"_1890":85410},[],"Además, cuando `regenerate_on_revoke` está activo, que es el comportamiento por defecto, cualquier revocación de un certificado desencadena inmediatamente la generación de una nueva CRL para la CA afectada. Esto reduce al mínimo el tiempo entre la revocación y su publicación.",{"_2299":49562,"_22571":49541,"_15405":85412,"_5":15294,"_21315":85360,"_1890":85413},[],"Cada entrada de la CRL incluye el número de serie del certificado revocado, la fecha de revocación y el código de razón conforme a RFC 5280.",{"_2299":49563,"_22571":49541,"_15405":85415,"_5":15294,"_21315":85360,"_1890":85416},[],"La CRL incluye también la extensión *Issuing Distribution Point* (IDP, OID 2.5.29.28), marcada como crítica, que indica la URL pública desde la que puede descargarse. Esa URL apunta al endpoint `/crl/{subject_key_id}` de cada dominio VA configurado.",{"_2299":49564,"_22571":49541,"_15405":85418,"_5":15294,"_21315":85364,"_1890":85419},[],"La CRL más reciente de una CA se puede obtener directamente sin autenticación:",{"_2299":49565,"_22571":49541,"_15405":85421,"_5":15294,"_21315":85364,"_1890":85422},[],"La respuesta tiene `Content-Type: application/pkix-crl` y contiene la CRL en formato DER.",{"_2299":49566,"_22571":49541,"_15405":85424,"_5":15294,"_21315":85368,"_1890":85425},[],"El rol VA de una CA se puede consultar y actualizar mediante la API:",{"_2299":49567,"_22571":49541,"_15405":85427,"_5":15294,"_21315":85368,"_1890":85428},[],"Método",{"_2299":49568,"_22571":49541,"_15405":85430,"_5":15294,"_21315":85368,"_1890":85431},[],"Ruta",{"_2299":49569,"_22571":49541,"_15405":85433,"_5":15294,"_21315":85368,"_1890":85434},[],"Descripción",{"_2299":49570,"_22571":49541,"_15405":85436,"_5":15294,"_21315":85368,"_1890":38321},[],{"_2299":49571,"_22571":49541,"_15405":85438,"_5":15294,"_21315":85368,"_1890":38324},[],{"_2299":49572,"_22571":49541,"_15405":85440,"_5":15294,"_21315":85368,"_1890":85441},[],"Devuelve la configuración del rol VA y los metadatos de la última CRL emitida.",{"_2299":49573,"_22571":49541,"_15405":85443,"_5":15294,"_21315":85368,"_1890":38330},[],{"_2299":49574,"_22571":49541,"_15405":85445,"_5":15294,"_21315":85368,"_1890":38324},[],{"_2299":49575,"_22571":49541,"_15405":85447,"_5":15294,"_21315":85368,"_1890":85448},[],"Actualiza los parámetros de la configuración del rol VA (`validity`, `refresh_interval`, `regenerate_on_revoke`).",{"_2299":49576,"_22571":49541,"_15405":85450,"_5":15294,"_21315":85368,"_1890":85451},[],"Ejemplo de consulta del rol VA:",{"_2299":49577,"_22571":49541,"_15405":85453,"_5":15294,"_21315":85368,"_1890":85454},[],"La respuesta incluye el campo `latest_crl` con la versión, la fecha de inicio de validez y la fecha de caducidad de la CRL actualmente publicada.",{"_2299":49578,"_22571":49541,"_15405":85456,"_5":15294,"_21315":85372,"_1890":85457},[],"Desde el panel de detalle de una CA es posible previsualizar el contenido de la CRL activa y descargarla directamente para su uso offline o para importarla en aplicaciones que realicen validación local.",{"_2299":49579,"_22571":49541,"_15405":85459,"_5":15294,"_21315":85376,"_1890":38347},[],{"_2299":49580,"_22571":49541,"_15405":85461,"_5":15294,"_21315":85376,"_1890":85462},[],"<Card title=\"Servicio OCSP\" href=\"/docs/platform/pki/ocsp\" />",{"_2299":49581,"_22571":49541,"_15405":85464,"_5":15294,"_21315":85376,"_1890":85465},[],"<Card title=\"Validación de certificados\" href=\"/docs/platform/pki/certificate-validation\" />",{"_2299":49582,"_22571":49582,"_5":10616,"_1890":38355,"_22830":85467,"_15405":85468,"_21315":49582},[35156,83411,83889],[],{"_2299":49583,"_22571":49582,"_15405":85470,"_5":15294,"_21315":49582,"_1890":85471},[],"Define cómo una flota recibe, renueva y utiliza sus identidades.",{"_2299":49584,"_22571":49582,"_5":22827,"_15405":85473,"_21315":85474,"_1890":82322},[],"/docs/es/platform/pki/device-enrollment#antes-de-empezar",{"_2299":49585,"_22571":49582,"_5":22827,"_15405":85476,"_21315":85477,"_1890":85478},[],"/docs/es/platform/pki/device-enrollment#configura-un-dms","Configura un DMS",{"_2299":49586,"_22571":49582,"_5":22827,"_15405":85480,"_21315":85481,"_1890":85482},[],"/docs/es/platform/pki/device-enrollment#identifica-la-flota","Identifica la flota",{"_2299":49587,"_22571":49582,"_5":22827,"_15405":85484,"_21315":85485,"_1890":85486},[],"/docs/es/platform/pki/device-enrollment#selecciona-la-ca-de-enrolamiento","Selecciona la CA de enrolamiento",{"_2299":49588,"_22571":49582,"_5":22827,"_15405":85488,"_21315":85489,"_1890":85490},[],"/docs/es/platform/pki/device-enrollment#configura-est","Configura EST",{"_2299":49589,"_22571":49582,"_5":22827,"_15405":85492,"_21315":85493,"_1890":85494},[],"/docs/es/platform/pki/device-enrollment#distribuye-la-confianza","Distribuye la confianza",{"_2299":49590,"_22571":49582,"_5":22827,"_15405":85496,"_21315":85497,"_1890":85498},[],"/docs/es/platform/pki/device-enrollment#verifica-los-endpoints","Verifica los endpoints",{"_2299":49591,"_22571":49582,"_5":22827,"_15405":85500,"_21315":85501,"_1890":85502},[],"/docs/es/platform/pki/device-enrollment#distribución-de-confianza","Distribución de confianza",{"_2299":49592,"_22571":49582,"_5":22827,"_15405":85504,"_21315":85505,"_1890":85506},[],"/docs/es/platform/pki/device-enrollment#opera-el-inventario-de-dms","Opera el inventario de DMS",{"_2299":49593,"_22571":49582,"_5":22827,"_15405":85508,"_21315":85509,"_1890":85510},[],"/docs/es/platform/pki/device-enrollment#integra-los-dispositivos","Integra los dispositivos",{"_2299":49594,"_22571":49582,"_15405":85512,"_5":15294,"_21315":49582,"_1890":85513},[],"Un &#x2A;*Device Management Service (DMS)** actúa como autoridad de registro frente a una flota. Recibe solicitudes, aplica la política de autenticación y encarga la emisión a la CA configurada.",{"_2299":49595,"_22571":49582,"_15405":85515,"_5":15294,"_21315":49582,"_1890":85516},[],"Cada DMS es un límite operativo independiente: puede representar una línea de producto, un entorno o un tipo de dispositivo con su propia CA, reglas de autenticación, confianza distribuida y ventana de renovación.",{"_2299":49596,"_22571":49582,"_15405":85518,"_5":15294,"_21315":85474,"_1890":85519},[],"Crea o importa al menos una CA activa.",{"_2299":49597,"_22571":49582,"_15405":85521,"_5":15294,"_21315":85474,"_1890":85522},[],"Decide cómo se autenticarán los dispositivos durante el primer enrolamiento.",{"_2299":49598,"_22571":49582,"_15405":85524,"_5":15294,"_21315":85474,"_1890":85525},[],"Define qué autoridades debe recibir el dispositivo como anclas de confianza.",{"_2299":49599,"_22571":49582,"_15405":85527,"_5":15294,"_21315":85474,"_1890":85528},[],"Asegúrate de tener permisos para administrar DMS.",{"_2299":49600,"_22571":49582,"_15405":85530,"_5":15294,"_21315":85481,"_1890":85531},[],"Asigna al DMS un nombre que describa su alcance, por ejemplo una familia de dispositivos o un entorno.",{"_2299":49601,"_22571":49582,"_15405":85533,"_5":15294,"_21315":85485,"_1890":85534},[],"Elige la autoridad que emitirá las identidades. Su política y periodo de validez condicionan los certificados que podrá obtener la flota.",{"_2299":49602,"_22571":49582,"_15405":85536,"_5":15294,"_21315":85489,"_1890":85537},[],"Define la autenticación de `enroll`, la política de `reenroll`, la ventana de renovación y, si se necesita, `serverkeygen`.",{"_2299":49603,"_22571":49582,"_15405":85539,"_5":15294,"_21315":85493,"_1890":85540},[],"Configura **CA Distribution** para controlar la respuesta del endpoint `cacerts`.",{"_2299":49604,"_22571":49582,"_15405":85542,"_5":15294,"_21315":85497,"_1890":85543},[],"Desde el menú del DMS, abre &#x2A;*EST (RFC-7030)** y comprueba la URL base y los ejemplos de invocación antes de integrar el firmware.",{"_2299":49605,"_22571":49582,"_15405":85545,"_5":15294,"_21315":85501,"_1890":85546},[],"**Include Lamassu System CA** distribuye el certificado TLS del servidor Lamassu, útil para *pinning*. No representa una CA de emisión.",{"_2299":49606,"_22571":49582,"_15405":85548,"_5":15294,"_21315":85501,"_1890":85549},[],"**Include Enrollment CA** añade la autoridad configurada para emitir las identidades del DMS.",{"_2299":49607,"_22571":49582,"_15405":85551,"_5":15294,"_21315":85501,"_1890":85552},[],"**Managed CAs** permite incluir autoridades adicionales que el dispositivo debe considerar de confianza.",{"_2299":49608,"_22571":49582,"_15405":85554,"_5":15294,"_21315":85505,"_1890":85555},[],"**Edit** modifica la política del DMS.",{"_2299":49609,"_22571":49582,"_15405":85557,"_5":15294,"_21315":85505,"_1890":85558},[],"**Go to DMS owned devices** abre únicamente los dispositivos de esa flota.",{"_2299":49610,"_22571":49582,"_15405":85560,"_5":15294,"_21315":85505,"_1890":85561},[],"**Show/Edit Metadata** permite gestionar configuración avanzada y datos de integraciones.",{"_2299":49611,"_22571":49582,"_15405":85563,"_5":15294,"_21315":85505,"_1890":85564},[],"**EST (RFC-7030)** muestra los endpoints y ejemplos específicos del DMS.",{"_2299":49612,"_22571":49582,"_15405":85566,"_5":15294,"_21315":85505,"_1890":85567},[],"**Delete** elimina el DMS y su configuración. La acción es irreversible.",{"_2299":49613,"_22571":49582,"_15405":85569,"_5":15294,"_21315":85509,"_1890":85570},[],"<Card title=\"Enrolamiento EST\" description=\"Configura autenticación, endpoints y flujos para firmware.\" href=\"/docs/platform/pki/est-enrollment\" />",{"_2299":49614,"_22571":49582,"_15405":85572,"_5":15294,"_21315":85509,"_1890":85573},[],"<Card title=\"Dispositivos e identidades\" description=\"Consulta estados, historial y acciones operativas.\" href=\"/docs/platform/pki/device-management\" />",{"_2299":49615,"_22571":49615,"_5":10616,"_1890":85575,"_22830":85576,"_15405":85577,"_21315":49615},"Dispositivos e identidades",[35156,83411,83889],[],{"_2299":49616,"_22571":49615,"_15405":85579,"_5":15294,"_21315":49615,"_1890":85580},[],"Registra dispositivos y controla sus identidades durante todo el ciclo de vida.",{"_2299":49617,"_22571":49615,"_5":22827,"_15405":85582,"_21315":85583,"_1890":85584},[],"/docs/es/platform/pki/device-management#estados-del-dispositivo","Estados del dispositivo",{"_2299":49618,"_22571":49615,"_5":22827,"_15405":85586,"_21315":85587,"_1890":85588},[],"/docs/es/platform/pki/device-management#inspecciona-un-dispositivo","Inspecciona un dispositivo",{"_2299":49619,"_22571":49615,"_5":22827,"_15405":85590,"_21315":85591,"_1890":85592},[],"/docs/es/platform/pki/device-management#registra-un-dispositivo-manualmente","Registra un dispositivo manualmente",{"_2299":49620,"_22571":49615,"_5":22827,"_15405":85594,"_21315":85595,"_1890":85596},[],"/docs/es/platform/pki/device-management#crea-el-dispositivo","Crea el dispositivo",{"_2299":49621,"_22571":49615,"_5":22827,"_15405":85598,"_21315":85599,"_1890":85600},[],"/docs/es/platform/pki/device-management#define-su-pertenencia","Define su pertenencia",{"_2299":49622,"_22571":49615,"_5":22827,"_15405":85602,"_21315":85603,"_1890":85604},[],"/docs/es/platform/pki/device-management#clasifica-el-dispositivo","Clasifica el dispositivo",{"_2299":49623,"_22571":49615,"_5":22827,"_15405":85606,"_21315":85607,"_1890":85608},[],"/docs/es/platform/pki/device-management#verifica-el-alta","Verifica el alta",{"_2299":49624,"_22571":49615,"_5":22827,"_15405":85610,"_21315":85611,"_1890":85612},[],"/docs/es/platform/pki/device-management#asigna-una-identidad-manualmente","Asigna una identidad manualmente",{"_2299":49625,"_22571":49615,"_5":22827,"_15405":85614,"_21315":85615,"_1890":85616},[],"/docs/es/platform/pki/device-management#revoca-la-identidad-actual","Revoca la identidad actual",{"_2299":49626,"_22571":49615,"_5":22827,"_15405":85618,"_21315":85619,"_1890":85620},[],"/docs/es/platform/pki/device-management#retira-un-dispositivo","Retira un dispositivo",{"_2299":49627,"_22571":49615,"_5":22827,"_15405":85622,"_21315":85623,"_1890":85624},[],"/docs/es/platform/pki/device-management#automatiza-el-enrolamiento","Automatiza el enrolamiento",{"_2299":49628,"_22571":49615,"_15405":85626,"_5":15294,"_21315":49615,"_1890":85627},[],"Un dispositivo gestionado representa una entidad de tu flota y conserva el historial de los certificados que ha utilizado. Lamassu separa el dispositivo de su identidad actual para que puedas renovar o sustituir certificados sin perder trazabilidad.",{"_2299":49629,"_22571":49615,"_15405":85629,"_5":15294,"_21315":85583,"_1890":85630},[],"**Active** indica que el dispositivo tiene una identidad válida.",{"_2299":49630,"_22571":49615,"_15405":85632,"_5":15294,"_21315":85583,"_1890":85633},[],"**No Identity** aparece cuando está registrado, pero todavía no tiene un certificado asociado.",{"_2299":49631,"_22571":49615,"_15405":85635,"_5":15294,"_21315":85583,"_1890":85636},[],"**Renewal Pending** señala que ha entrado en la ventana de renovación.",{"_2299":49632,"_22571":49615,"_15405":85638,"_5":15294,"_21315":85583,"_1890":85639},[],"**Expiring Soon** advierte que el certificado está próximo a expirar.",{"_2299":49633,"_22571":49615,"_15405":85641,"_5":15294,"_21315":85583,"_1890":85642},[],"**Expired** indica que la identidad ha superado su fecha de validez.",{"_2299":49634,"_22571":49615,"_15405":85644,"_5":15294,"_21315":85583,"_1890":85645},[],"**Revoked** identifica un certificado invalidado antes de su expiración.",{"_2299":49635,"_22571":49615,"_15405":85647,"_5":15294,"_21315":85583,"_1890":85648},[],"**Decommissioned** corresponde a un dispositivo retirado de forma permanente.",{"_2299":49636,"_22571":49615,"_15405":85650,"_5":15294,"_21315":85583,"_1890":85651},[],"El inventario permite filtrar por `Device ID`, etiquetas y estado.",{"_2299":49637,"_22571":49615,"_15405":85653,"_5":15294,"_21315":85587,"_1890":85654},[],"La vista de detalle separa dos perspectivas:",{"_2299":49638,"_22571":49615,"_15405":85656,"_5":15294,"_21315":85587,"_1890":85657},[],"**Certificate History** conserva todos los certificados asociados, con su número de serie, emisor, estado y periodo de validez.",{"_2299":49639,"_22571":49615,"_15405":85659,"_5":15294,"_21315":85587,"_1890":85660},[],"**Device Event Timeline** ordena cronológicamente registros, enrolamientos, renovaciones y cambios de estado.",{"_2299":49640,"_22571":49615,"_15405":85662,"_5":15294,"_21315":85587,"_1890":85663},[],"Utiliza el historial para auditoría y la línea de tiempo para reconstruir un incidente o diagnosticar una transición inesperada.",{"_2299":49641,"_22571":49615,"_15405":85665,"_5":15294,"_21315":85591,"_1890":85666},[],"El registro previo es útil cuando la política exige que el dispositivo exista antes de solicitar su primer certificado.",{"_2299":49642,"_22571":49615,"_15405":85668,"_5":15294,"_21315":85595,"_1890":85669},[],"Desde **Managed Devices**, abre el formulario de registro.",{"_2299":49643,"_22571":49615,"_15405":85671,"_5":15294,"_21315":85599,"_1890":85672},[],"Introduce un **Device ID** único y selecciona el DMS que aplicará las políticas de enrolamiento y renovación.",{"_2299":49644,"_22571":49615,"_15405":85674,"_5":15294,"_21315":85603,"_1890":85675},[],"Añade un icono y etiquetas si necesitas agruparlo por modelo, ubicación, entorno u otro criterio operativo.",{"_2299":49645,"_22571":49615,"_15405":85677,"_5":15294,"_21315":85607,"_1890":85678},[],"El dispositivo debe aparecer con estado **No Identity** hasta que complete el enrolamiento o reciba una identidad manual.",{"_2299":49646,"_22571":49615,"_15405":85680,"_5":15294,"_21315":85611,"_1890":85681},[],"La acción **Assign Identity** está disponible mientras el dispositivo permanece en **No Identity**.",{"_2299":49647,"_22571":49615,"_15405":85683,"_5":15294,"_21315":85611,"_1890":85684},[],"Abre el dispositivo y selecciona **Assign Identity**.",{"_2299":49648,"_22571":49615,"_15405":85686,"_5":15294,"_21315":85611,"_1890":85687},[],"Elige un certificado activo cuyo `Common Name` coincida con el `Device ID`.",{"_2299":49649,"_22571":49615,"_15405":85689,"_5":15294,"_21315":85611,"_1890":85690},[],"Si no existe, selecciona **Issue New Instead** y elige una CA vinculada al DMS.",{"_2299":49650,"_22571":49615,"_15405":85692,"_5":15294,"_21315":85611,"_1890":85693},[],"Confirma la asignación.",{"_2299":49651,"_22571":49615,"_15405":85695,"_5":15294,"_21315":85611,"_1890":85696},[],"El dispositivo debe cambiar a **Active** y el certificado debe aparecer en su historial.",{"_2299":49652,"_22571":49615,"_15405":85698,"_5":15294,"_21315":85615,"_1890":85699},[],"En **Device Event Timeline**, localiza el último certificado activo y selecciona **Revoke**. Elige una razón conforme a tu política y confirma la operación.",{"_2299":49653,"_22571":49615,"_15405":85701,"_5":15294,"_21315":85615,"_1890":85702},[],"La revocación invalida el certificado, pero no elimina el dispositivo. Puedes restaurar su operación asignándole una identidad nueva. `CertificateHold` permite reactivar el certificado retenido; el resto de razones son definitivas.",{"_2299":49654,"_22571":49615,"_15405":85704,"_5":15294,"_21315":85619,"_1890":85705},[],"Esta acción revoca todos los certificados del dispositivo e impide que vuelva a obtener una identidad.",{"_2299":49655,"_22571":49615,"_15405":85707,"_5":15294,"_21315":85619,"_1890":85708},[],"Usa **Decommission** únicamente cuando el dispositivo haya dejado de operar o ya no sea fiable. Tras confirmar, Lamassu revoca la identidad activa con `CessationOfOperation` y cambia el estado a **Decommissioned**.",{"_2299":49656,"_22571":49615,"_15405":85710,"_5":15294,"_21315":85623,"_1890":85711},[],"<Card title=\"Configura un DMS\" description=\"Define la CA, confianza y políticas de la flota.\" href=\"/docs/platform/pki/device-enrollment\" />",{"_2299":49657,"_22571":49615,"_15405":85713,"_5":15294,"_21315":85623,"_1890":85714},[],"<Card title=\"Integra EST\" description=\"Permite que el dispositivo solicite y renueve su identidad.\" href=\"/docs/platform/pki/est-enrollment\" />",{"_2299":49658,"_22571":49658,"_5":10616,"_1890":85716,"_22830":85717,"_15405":85718,"_21315":49658},"Enrolamiento de dispositivos con EST",[35156,83411,83889],[],{"_2299":49659,"_22571":49658,"_15405":85720,"_5":15294,"_21315":49658,"_1890":85721},[],"Guía del protocolo EST en Lamassu IoT, con la configuración del DMS para el administrador PKI y la referencia de endpoints para el integrador de dispositivos.",{"_2299":49660,"_22571":49658,"_5":22827,"_15405":85723,"_21315":85724,"_1890":38614},[],"/docs/es/platform/pki/est-enrollment#est-enrollment-over-secure-transport",{"_2299":49661,"_22571":49658,"_5":22827,"_15405":85726,"_21315":85727,"_1890":85728},[],"/docs/es/platform/pki/est-enrollment#configuración-del-dms","Configuración del DMS",{"_2299":49662,"_22571":49658,"_5":22827,"_15405":85730,"_21315":85731,"_1890":85732},[],"/docs/es/platform/pki/est-enrollment#requisitos-previos","Requisitos previos",{"_2299":49663,"_22571":49658,"_5":22827,"_15405":85734,"_21315":85735,"_1890":85736},[],"/docs/es/platform/pki/est-enrollment#configuración-de-enrollment","Configuración de enrollment",{"_2299":49664,"_22571":49658,"_5":22827,"_15405":85738,"_21315":85739,"_1890":38630},[],"/docs/es/platform/pki/est-enrollment#enrollment-device-registration",{"_2299":49665,"_22571":49658,"_5":22827,"_15405":85741,"_21315":85742,"_1890":38634},[],"/docs/es/platform/pki/est-enrollment#enrollment-settings",{"_2299":49666,"_22571":49658,"_5":22827,"_15405":85744,"_21315":85745,"_1890":85746},[],"/docs/es/platform/pki/est-enrollment#perfil-de-emisión","Perfil de emisión",{"_2299":49667,"_22571":49658,"_5":22827,"_15405":85748,"_21315":85749,"_1890":85750},[],"/docs/es/platform/pki/est-enrollment#configuración-de-re-enrollment","Configuración de re-enrollment",{"_2299":49668,"_22571":49658,"_5":22827,"_15405":85752,"_21315":85753,"_1890":85754},[],"/docs/es/platform/pki/est-enrollment#configuración-de-serverkeygen","Configuración de ServerKeyGen",{"_2299":49669,"_22571":49658,"_5":22827,"_15405":85756,"_21315":85757,"_1890":85758},[],"/docs/es/platform/pki/est-enrollment#verificar-la-configuración","Verificar la configuración",{"_2299":49670,"_22571":49658,"_5":22827,"_15405":85760,"_21315":85761,"_1890":85762},[],"/docs/es/platform/pki/est-enrollment#integración-de-dispositivos","Integración de dispositivos",{"_2299":49671,"_22571":49658,"_5":22827,"_15405":85764,"_21315":85765,"_1890":82322},[],"/docs/es/platform/pki/est-enrollment#antes-de-empezar",{"_2299":49672,"_22571":49658,"_5":22827,"_15405":85767,"_21315":85768,"_1890":85769},[],"/docs/es/platform/pki/est-enrollment#resumen-del-flujo","Resumen del flujo",{"_2299":49673,"_22571":49658,"_5":22827,"_15405":85771,"_21315":85772,"_1890":85773},[],"/docs/es/platform/pki/est-enrollment#modelo-de-autenticación-del-cliente","Modelo de autenticación del cliente",{"_2299":49674,"_22571":49658,"_5":22827,"_15405":85775,"_21315":85776,"_1890":85777},[],"/docs/es/platform/pki/est-enrollment#referencia-de-endpoints","Referencia de endpoints",{"_2299":49675,"_22571":49658,"_5":22827,"_15405":85779,"_21315":85780,"_1890":38673},[],"/docs/es/platform/pki/est-enrollment#cacerts",{"_2299":49676,"_22571":49658,"_5":22827,"_15405":85782,"_21315":85783,"_1890":38677},[],"/docs/es/platform/pki/est-enrollment#simpleenroll",{"_2299":49677,"_22571":49658,"_5":22827,"_15405":85785,"_21315":85786,"_1890":38681},[],"/docs/es/platform/pki/est-enrollment#simplereenroll",{"_2299":49678,"_22571":49658,"_5":22827,"_15405":85788,"_21315":85789,"_1890":38685},[],"/docs/es/platform/pki/est-enrollment#serverkeygen",{"_2299":49679,"_22571":49658,"_5":22827,"_15405":85791,"_21315":85792,"_1890":85793},[],"/docs/es/platform/pki/est-enrollment#flujos-completos","Flujos completos",{"_2299":49680,"_22571":49658,"_5":22827,"_15405":85795,"_21315":85796,"_1890":85797},[],"/docs/es/platform/pki/est-enrollment#ejemplo-end-to-end-enroll","Ejemplo end-to-end: enroll",{"_2299":49681,"_22571":49658,"_5":22827,"_15405":85799,"_21315":85800,"_1890":85801},[],"/docs/es/platform/pki/est-enrollment#ejemplo-end-to-end-reenroll","Ejemplo end-to-end: reenroll",{"_2299":49682,"_22571":49658,"_5":22827,"_15405":85803,"_21315":85804,"_1890":85805},[],"/docs/es/platform/pki/est-enrollment#próximos-pasos-tras-el-enrolamiento","Próximos pasos tras el enrolamiento",{"_2299":49683,"_22571":49658,"_5":22827,"_15405":85807,"_21315":85808,"_1890":85809},[],"/docs/es/platform/pki/est-enrollment#diagnóstico-y-compatibilidad","Diagnóstico y compatibilidad",{"_2299":49684,"_22571":49658,"_5":22827,"_15405":85811,"_21315":85812,"_1890":85813},[],"/docs/es/platform/pki/est-enrollment#códigos-de-error-y-diagnóstico","Códigos de error y diagnóstico",{"_2299":49685,"_22571":49658,"_5":22827,"_15405":85815,"_21315":85816,"_1890":85817},[],"/docs/es/platform/pki/est-enrollment#notas-de-compatibilidad","Notas de compatibilidad",{"_2299":49686,"_22571":49658,"_15405":85819,"_5":15294,"_21315":85724,"_1890":85820},[],"Lamassu IoT implementa el protocolo &#x2A;*EST (Enrollment over Secure Transport)** descrito en el RFC 7030 como su único mecanismo de inscripción de certificados para dispositivos. Cada DMS expone los endpoints EST, valida al dispositivo y aplica sus propias políticas de autenticación, registro y renovación. Así, actúa como autoridad de registro (RA) frente al cliente.",{"_2299":49687,"_22571":49658,"_15405":85822,"_5":15294,"_21315":85724,"_1890":85823},[],"La entidad que emite y firma criptográficamente el certificado es siempre la **CA asociada al DMS**, no el DMS. El DMS coordina el proceso: recibe el CSR, autentica al dispositivo y aplica la política de emisión. Esta distinción es relevante para el administrador PKI al seleccionar la `EnrollmentCA` y para el integrador al interpretar la cadena de confianza recibida de `/cacerts`.",{"_2299":49688,"_22571":49658,"_15405":85825,"_5":15294,"_21315":85724,"_1890":85826},[],"Esta guía está dividida en dos partes:",{"_2299":49689,"_22571":49658,"_15405":85828,"_5":15294,"_21315":85724,"_1890":85829},[],"Configuración del DMS, para el administrador PKI.",{"_2299":49690,"_22571":49658,"_15405":85831,"_5":15294,"_21315":85724,"_1890":85832},[],"Integración de dispositivos, para quien consume los endpoints EST desde firmware, scripts o servicios de aprovisionamiento.",{"_2299":49691,"_22571":49658,"_15405":85834,"_5":15294,"_21315":85724,"_1890":85835},[],"Si solo necesita una orientación rápida, este es el recorrido recomendado:",{"_2299":49692,"_22571":49658,"_15405":85837,"_5":15294,"_21315":85724,"_1890":85838},[],"**Administrador PKI:** empiece por Configuración del DMS y termine con Diagnóstico y compatibilidad.",{"_2299":49693,"_22571":49658,"_15405":85840,"_5":15294,"_21315":85724,"_1890":85841},[],"**Integrador de dispositivos:** empiece por Antes de empezar y continúe con `/cacerts`, `/simpleenroll`, `/simplereenroll` o `/serverkeygen`, según el flujo que vaya a implementar.",{"_2299":49694,"_22571":49658,"_15405":85843,"_5":15294,"_21315":85731,"_1890":85844},[],"Antes de configurar un DMS para EST, deben existir los siguientes recursos en la plataforma:",{"_2299":49695,"_22571":49658,"_15405":85846,"_5":15294,"_21315":85731,"_1890":85847},[],"**Una CA disponible**: la CA que actuará como `EnrollmentCA` debe estar creada y en estado activo en Lamassu. Si el modo de autenticación es `CLIENT_CERTIFICATE`, también deben estar creadas las CAs de validación del certificado bootstrap.",{"_2299":49696,"_22571":49658,"_15405":85849,"_5":15294,"_21315":85731,"_1890":85850},[],"**Un DMS creado**: el DMS al que se aplicará esta configuración debe existir previamente. La configuración EST se aplica sobre un DMS existente, no lo crea.",{"_2299":49697,"_22571":49658,"_15405":85852,"_5":15294,"_21315":85731,"_1890":85853},[],"Conviene separar cuatro bloques de configuración:",{"_2299":49698,"_22571":49658,"_15405":85855,"_5":15294,"_21315":85731,"_1890":85856},[],"Cómo se realizará el enrollment inicial, incluyendo el modo de alta y la autenticación del cliente.",{"_2299":49699,"_22571":49658,"_15405":85858,"_5":15294,"_21315":85731,"_1890":85859},[],"Cómo se gestionará el re-enrollment de certificados ya emitidos.",{"_2299":49700,"_22571":49658,"_15405":85861,"_5":15294,"_21315":85731,"_1890":85862},[],"Cómo se configurará el endpoint cacerts para la distribución de las CAs de confianza utilizadas por los dispositivos.",{"_2299":49701,"_22571":49658,"_15405":85864,"_5":15294,"_21315":85731,"_1890":85865},[],"Si se habilitará la generación de claves en servidor mediante `ServerKeyGen`.",{"_2299":49702,"_22571":49658,"_15405":85867,"_5":15294,"_21315":85739,"_1890":85868},[],"En esta sección se define cómo se registran los dispositivos nuevos y con qué credenciales se autentican.",{"_2299":49703,"_22571":49658,"_15405":85870,"_5":15294,"_21315":85739,"_1890":85871},[],"**Registration Mode**: determina el comportamiento al recibir una inscripción inicial. En modo `JITP` (*Just-In-Time Provisioning*), el dispositivo se crea automáticamente la primera vez que se presenta, aplicando los tags, metadatos e icono definidos en el perfil de aprovisionamiento. En modo `PRE_REGISTRATION`, el dispositivo debe existir previamente en la plataforma; si no existe, la solicitud se rechaza con `device not preregistered`. El modo JITP es adecuado para flotas grandes donde el inventario se construye durante el despliegue; el modo `PRE_REGISTRATION` encaja en entornos de alta seguridad donde cada dispositivo se aprueba de forma explícita antes de recibir un certificado.",{"_2299":49704,"_22571":49658,"_15405":85873,"_5":15294,"_21315":85739,"_1890":85874},[],"**Tags**: se aplican a cada dispositivo creado automáticamente por este DMS. Son opcionales y solo tienen efecto en modo JITP. Los tags permiten mejorar la búsqueda de dispositivos.",{"_2299":49705,"_22571":49658,"_15405":85876,"_5":15294,"_21315":85739,"_1890":85877},[],"**Icon**: se aplica a cada dispositivo creado automáticamente por este DMS. Es opcional y solo tiene efecto en modo JITP. Únicamente visual.",{"_2299":49706,"_22571":49658,"_15405":85879,"_5":15294,"_21315":85742,"_1890":85880},[],"**Enrollment CA**: identifica la CA que firmará los certificados de identidad emitidos a través de este DMS. Su elección determina la cadena de confianza que el dispositivo recibirá y la raíz contra la que los sistemas de backend validarán los certificados de flota.",{"_2299":49707,"_22571":49658,"_15405":85882,"_5":15294,"_21315":85742,"_1890":85883},[],"**Allow Override Enrollment** (`enable_replaceable_enrollment`): permite que un dispositivo ya enrolado vuelva a inscribirse mediante `/simpleenroll`. Cuando está activa, el certificado anterior se revoca con la razón `superseded` y el slot de identidad se actualiza. Cuando está inactiva, un segundo intento de `simpleenroll` se rechaza con `forbiddenNewEnrollment`. Esta opción debe habilitarse con precaución en entornos de producción, ya que permite sustituir la identidad de un dispositivo sin pasar por el flujo de re-enrollment.",{"_2299":49708,"_22571":49658,"_15405":85885,"_5":15294,"_21315":85742,"_1890":85886},[],"**Verify CSR Signature** (`verify_csr_signature`): controla si el servidor valida la firma del CSR contra la clave pública declarada en él (prueba de posesión PKCS#10). Cuando está inactiva, un solicitante podría enviar un CSR con una clave pública que no controla y obtener un certificado vinculado a ella. Para flotas IoT en redes abiertas debe estar activa.",{"_2299":49709,"_22571":49658,"_15405":85888,"_5":15294,"_21315":85742,"_1890":85889},[],"**Authentication Mode**: define cómo el DMS valida la identidad del dispositivo durante el enrollment. Puede exigir un certificado mTLS (`CLIENT_CERTIFICATE`), delegar la autorización en un webhook (`EXTERNAL_WEBHOOK`), combinar ambos controles (`CLIENT_CERTIFICATE_AND_EXTERNAL_WEBHOOK`) o aceptar solicitudes sin autenticación (`NO_AUTH`). Este último modo debe limitarse a laboratorios o redes de aprovisionamiento aisladas.",{"_2299":49710,"_22571":49658,"_15405":85891,"_5":15294,"_21315":85742,"_1890":85892},[],"Cuando el modo es `CLIENT_CERTIFICATE` o `CLIENT_CERTIFICATE_AND_EXTERNAL_WEBHOOK`, se configuran además estos parámetros:",{"_2299":49711,"_22571":49658,"_15405":85894,"_5":15294,"_21315":85742,"_1890":85895},[],"**Validation CAs**: lista de CAs de confianza para validar el certificado bootstrap presentado por el dispositivo.",{"_2299":49712,"_22571":49658,"_15405":85897,"_5":15294,"_21315":85742,"_1890":85898},[],"**Chain Validation Level**: profundidad máxima de la cadena de validación. El valor `-1` valida la cadena completa hasta la CA raíz.",{"_2299":49713,"_22571":49658,"_15405":85900,"_5":15294,"_21315":85742,"_1890":85901},[],"**Allow Authenticating Expired Certificates**: si está activo, acepta certificados cliente caducados. Es útil en escenarios de recuperación donde el dispositivo no pudo renovar su certificado a tiempo.",{"_2299":49714,"_22571":49658,"_15405":85903,"_5":15294,"_21315":85742,"_1890":85904},[],"Cuando el modo incluye `EXTERNAL_WEBHOOK`, se configuran además estos parámetros:",{"_2299":49715,"_22571":49658,"_15405":85906,"_5":15294,"_21315":85742,"_1890":85907},[],"**Webhook URL**: dirección del servicio externo que decidirá la autorización.",{"_2299":49716,"_22571":49658,"_15405":85909,"_5":15294,"_21315":85742,"_1890":85910},[],"**HTTP Method**: método HTTP utilizado para invocar el webhook. Admite `POST` (por defecto) o `PUT`; ambos son equivalentes para el webhook, solo cambia el verbo con el que Lamassu realiza la llamada.",{"_2299":49717,"_22571":49658,"_15405":85912,"_5":15294,"_21315":85742,"_1890":85913},[],"**Timeout**: tiempo máximo de espera de la llamada al webhook. Si no se especifica, el valor por defecto es de **10 segundos**; superado ese plazo sin respuesta, Lamassu deniega la operación.",{"_2299":49718,"_22571":49658,"_15405":85915,"_5":15294,"_21315":85742,"_1890":85916},[],"**Webhook Authentication Mode**: modo de autenticación del webhook hacia el servicio externo, por ejemplo `ApiKey`, `OIDC` o `mTLS`.",{"_2299":49719,"_22571":49658,"_15405":85918,"_5":15294,"_21315":85742,"_1890":85919},[],"El contrato exacto que debe implementar el servicio webhook (esquema de petición y respuesta, ejemplos) está publicado como especificación OpenAPI: referencia del webhook de autorización.",{"_2299":49720,"_22571":49658,"_15405":85921,"_5":15294,"_21315":85745,"_1890":85922},[],"El comportamiento del certificado emitido no lo determina únicamente el CSR del dispositivo, sino el **perfil de emisión** (`IssuanceProfile`) asociado al DMS. El integrador no configura este perfil, pero sus reglas afectan al contenido del certificado final:",{"_2299":49721,"_22571":49658,"_15405":85924,"_5":15294,"_21315":85745,"_1890":85925},[],"**`HonorSubject`** controla si el subject del CSR se traslada literalmente al certificado. Si está desactivado, la CA aplica la plantilla del perfil e ignora el subject recibido.",{"_2299":49722,"_22571":49658,"_15405":85927,"_5":15294,"_21315":85745,"_1890":85928},[],"**`HonorKeyUsage`** decide si se respeta el `KeyUsage` del CSR o se sustituye por el definido en la plantilla.",{"_2299":49723,"_22571":49658,"_15405":85930,"_5":15294,"_21315":85745,"_1890":85931},[],"**`HonorExtendedKeyUsages`** aplica la misma regla a `ExtKeyUsage`.",{"_2299":49724,"_22571":49658,"_15405":85933,"_5":15294,"_21315":85745,"_1890":85934},[],"**`HonorExtensions`** controla si el resto de extensiones del CSR, como SAN o CDP, se incluyen en el certificado.",{"_2299":49725,"_22571":49658,"_15405":85936,"_5":15294,"_21315":85745,"_1890":85937},[],"Esto es relevante para el integrador: el `KeyUsage`, `ExtKeyUsage` y los SAN que declara el CSR pueden no aparecer tal cual en el certificado final si el perfil así lo decide. Consulte con el administrador PKI si el certificado emitido no contiene las extensiones esperadas.",{"_2299":49726,"_22571":49658,"_15405":85939,"_5":15294,"_21315":85749,"_1890":85940},[],"La sección **Re-Enrollment Settings** controla el proceso de renovación de certificados. El re-enrollment puede realizarse únicamente cuando el certificado está dentro de la ventana configurada, y opcionalmente también cuando el certificado ya ha caducado.",{"_2299":49727,"_22571":49658,"_15405":85942,"_5":15294,"_21315":85749,"_1890":85943},[],"**Revoke On Re-Enroll**: si está activo, el certificado anterior se revoca automáticamente con la razón `superseded` una vez emitido el nuevo.",{"_2299":49728,"_22571":49658,"_15405":85945,"_5":15294,"_21315":85749,"_1890":85946},[],"**Allow Expired Renewal**: permite renovar un certificado ya caducado. Es útil cuando un dispositivo ha estado desconectado y no pudo renovar dentro de la ventana.",{"_2299":49729,"_22571":49658,"_15405":85948,"_5":15294,"_21315":85749,"_1890":85949},[],"**Allowed Renewal Delta**: ventana de tiempo previa a la caducidad durante la cual se permite el re-enrollment. Antes de que se abra esta ventana, la solicitud se rechaza con `invalid reenroll window`.",{"_2299":49730,"_22571":49658,"_15405":85951,"_5":15294,"_21315":85749,"_1890":85952},[],"**Preventive Renewal Delta**: tiempo previo a la caducidad a partir del cual se emiten alertas de renovación preventiva.",{"_2299":49731,"_22571":49658,"_15405":85954,"_5":15294,"_21315":85749,"_1890":85955},[],"**Critical Renewal Delta**: umbral más cercano al vencimiento que activa alertas de estado crítico.",{"_2299":49732,"_22571":49658,"_15405":85957,"_5":15294,"_21315":85749,"_1890":85958},[],"**Additional Validation CAs**: CAs adicionales aceptadas como emisoras del certificado en vigor durante el re-enrollment. Permite migrar a una nueva CA de enrolamiento sin interrumpir la renovación de dispositivos ya enrolados con la CA anterior.",{"_2299":49733,"_22571":49658,"_15405":85960,"_5":15294,"_21315":85753,"_1890":85961},[],"La sección **Server Key Generation** permite que Lamassu genere el par de claves del dispositivo en el servidor y lo devuelva junto con el certificado emitido. Es útil para dispositivos con capacidad criptográfica limitada.",{"_2299":49734,"_22571":49658,"_15405":85963,"_5":15294,"_21315":85753,"_1890":85964},[],"La opción **Enable Server-Side Key Generation** activa el endpoint `/serverkeygen`. Cuando está inactiva, cualquier llamada a ese endpoint se rechaza con `server key generation not enabled`.",{"_2299":49735,"_22571":49658,"_15405":85966,"_5":15294,"_21315":85753,"_1890":85967},[],"**Key Type** selecciona el algoritmo: `RSA` o `ECDSA`. El campo &#x2A;*Key Size (bits)** determina el tamaño de la clave. Para ECDSA, el tamaño en bits determina también la curva: 256 corresponde a P-256, 384 a P-384 y 521 a P-521.",{"_2299":49736,"_22571":49658,"_15405":85969,"_5":15294,"_21315":85753,"_1890":85970},[],"La clave se genera en el motor software del servidor, no en un Crypto Engine de hardware como AWS KMS o PKCS#11. La única protección de la clave en tránsito es el canal TLS; no se aplica cifrado adicional (CMS EnvelopedData) sobre la clave antes de enviarla al dispositivo. Consulte el apartado `/serverkeygen` de la referencia para integrador para conocer el formato exacto de la respuesta y las consideraciones de seguridad.",{"_2299":49737,"_22571":49658,"_15405":85972,"_5":15294,"_21315":85757,"_1890":85973},[],"Una vez aplicados los ajustes de enrollment, re-enrollment y ServerKeyGen, puede confirmar que el DMS está operativo de las siguientes formas:",{"_2299":49738,"_22571":49658,"_15405":85975,"_5":15294,"_21315":85757,"_1890":85976},[],"**Desde la consola**: accede al detalle del DMS y comprueba que la sección EST muestra la CA de enrolamiento asignada y el modo de autenticación configurado.",{"_2299":49739,"_22571":49658,"_15405":85978,"_5":15294,"_21315":85757,"_1890":85979},[],"**Con una solicitud de prueba**: invoca el endpoint `/cacerts` del DMS desde un cliente `curl` con la confianza del servidor. Una respuesta `200 OK` con contenido base64 confirma que el DMS está activo y que la CA de enrolamiento es accesible.",{"_2299":49740,"_22571":49658,"_15405":85981,"_5":15294,"_21315":85757,"_1890":85982},[],"Si el DMS no existe o la CA no está disponible, el servidor responde con `DMS not found` u otro mensaje de error. Consulte la sección Diagnóstico y compatibilidad para interpretar los mensajes de error.",{"_2299":49741,"_22571":49658,"_15405":85984,"_5":15294,"_21315":85761,"_1890":85985},[],"*Esta sección está dirigida al integrador de dispositivos.*",{"_2299":49742,"_22571":49658,"_15405":85987,"_5":15294,"_21315":85761,"_1890":85988},[],"Los endpoints EST de Lamassu se publican bajo el prefijo `/.well-known/est` y exigen siempre la presencia del segmento de ruta `{aps}`, que se interpreta como el identificador del DMS al que se dirige la operación. La asociación es directa: el valor de `{aps}` recibido en la URL se utiliza como ID de DMS al consultar el almacén interno. Las variantes registradas sin `{aps}` (por ejemplo `/.well-known/est/cacerts`) están enrutadas en el código, pero su gestor exige el campo `APS` y devuelve `400 Bad Request` con el mensaje `Field validation for 'APS' failed` cuando el segmento no se proporciona.",{"_2299":49743,"_22571":49658,"_15405":85990,"_5":15294,"_21315":85761,"_1890":85991},[],"Esta parte sigue el orden habitual de trabajo del integrador: primero los requisitos previos y el modelo de autenticación, después la referencia de cada endpoint y, al final, ejemplos completos y material de diagnóstico.",{"_2299":49744,"_22571":49658,"_15405":85993,"_5":15294,"_21315":85765,"_1890":85994},[],"El administrador PKI debe haber configurado un DMS con el protocolo `EST_RFC7030`, una CA de enrolamiento asignada y al menos un modo de autenticación. Sin esa configuración previa, Lamassu rechaza cualquier solicitud de enrolamiento. Los detalles de esa configuración se encuentran en la sección de configuración del DMS de esta misma página.",{"_2299":49745,"_22571":49658,"_15405":85996,"_5":15294,"_21315":85765,"_1890":85997},[],"Antes de realizar la primera llamada, asegúrese de tener:",{"_2299":49746,"_22571":49658,"_15405":85999,"_5":15294,"_21315":85765,"_1890":86000},[],"**La URL del host EST**, por ejemplo `https://est.lamassu.example`, proporcionada por el administrador PKI.",{"_2299":49747,"_22571":49658,"_15405":86002,"_5":15294,"_21315":85765,"_1890":86003},[],"**El ancla de confianza del servidor** (`lamassu-trust.pem`), raíz o intermedia, con la que el cliente validará el TLS de Lamassu.",{"_2299":49748,"_22571":49658,"_15405":86005,"_5":15294,"_21315":85765,"_1890":86006},[],"**El certificado bootstrap y su clave privada** si el DMS usa `CLIENT_CERTIFICATE` o `CLIENT_CERTIFICATE_AND_EXTERNAL_WEBHOOK`. Esta identidad debe proceder de una de las `ValidationCAs` configuradas, normalmente una CA de aprovisionamiento distinta de la CA de enrolamiento.",{"_2299":49749,"_22571":49658,"_15405":86008,"_5":15294,"_21315":85765,"_1890":86009},[],"**El ID del DMS** (`{aps}`), que debe aparecer en todas las rutas EST.",{"_2299":49750,"_22571":49658,"_15405":86011,"_5":15294,"_21315":85768,"_1890":86012},[],"**Descargue la confianza con `/cacerts`:** el cliente valida el TLS del servidor y recibe los certificados en PKCS#7 o PEM.",{"_2299":49751,"_22571":49658,"_15405":86014,"_5":15294,"_21315":85768,"_1890":86015},[],"**Realice el alta inicial con `/simpleenroll`:** presente el certificado bootstrap o la credencial definida por `AuthMode` para obtener el certificado del dispositivo.",{"_2299":49752,"_22571":49658,"_15405":86017,"_5":15294,"_21315":85768,"_1890":86018},[],"**Renueve con `/simplereenroll`:** autentíquese con el certificado actual del dispositivo para obtener uno nuevo.",{"_2299":49753,"_22571":49658,"_15405":86020,"_5":15294,"_21315":85768,"_1890":86021},[],"**Use `/serverkeygen` solo si necesita generación de claves en servidor:** aplica la misma autenticación que `/simpleenroll` y devuelve la clave privada PKCS#8 junto con el certificado.",{"_2299":49754,"_22571":49658,"_15405":86023,"_5":15294,"_21315":85772,"_1890":86024},[],"La implementación de Lamassu reconoce cuatro configuraciones de autenticación para `/simpleenroll`, expresadas mediante el campo `EnrollmentOptionsESTRFC7030.AuthMode` del DMS. Tres son modos simples (`CLIENT_CERTIFICATE`, `EXTERNAL_WEBHOOK`, `NO_AUTH`) y una combina dos controles (`CLIENT_CERTIFICATE_AND_EXTERNAL_WEBHOOK`). El cliente debe presentarse en el modo que el DMS espera; cualquier otra combinación genera un fallo en la inscripción.",{"_2299":49755,"_22571":49658,"_15405":86026,"_5":15294,"_21315":85772,"_1890":86027},[],"Modo (`AuthMode`)",{"_2299":49756,"_22571":49658,"_15405":86029,"_5":15294,"_21315":85772,"_1890":85434},[],{"_2299":49757,"_22571":49658,"_15405":86031,"_5":15294,"_21315":85772,"_1890":86032},[],"Credencial esperada",{"_2299":49758,"_22571":49658,"_15405":86034,"_5":15294,"_21315":85772,"_1890":86035},[],"Aplica en enroll",{"_2299":49759,"_22571":49658,"_15405":86037,"_5":15294,"_21315":85772,"_1890":86038},[],"Aplica en reenroll",{"_2299":49760,"_22571":49658,"_15405":86040,"_5":15294,"_21315":85772,"_1890":38937},[],{"_2299":49761,"_22571":49658,"_15405":86042,"_5":15294,"_21315":85772,"_1890":86043},[],"mTLS con certificado X.509",{"_2299":49762,"_22571":49658,"_15405":86045,"_5":15294,"_21315":85772,"_1890":86046},[],"Certificado y clave privada cliente",{"_2299":49763,"_22571":49658,"_15405":86048,"_5":15294,"_21315":85772,"_1890":86049},[],"Sí",{"_2299":49764,"_22571":49658,"_15405":86051,"_5":15294,"_21315":85772,"_1890":86052},[],"Sí (con el certificado en vigor)",{"_2299":49765,"_22571":49658,"_15405":86054,"_5":15294,"_21315":85772,"_1890":38952},[],{"_2299":49766,"_22571":49658,"_15405":86056,"_5":15294,"_21315":85772,"_1890":86057},[],"mTLS más validación por webhook",{"_2299":49767,"_22571":49658,"_15405":86059,"_5":15294,"_21315":85772,"_1890":86060},[],"Certificado y clave privada cliente, más aprobación del webhook",{"_2299":49768,"_22571":49658,"_15405":86062,"_5":15294,"_21315":85772,"_1890":86049},[],{"_2299":49769,"_22571":49658,"_15405":86064,"_5":15294,"_21315":85772,"_1890":86065},[],"No como combinación; en reenroll no mantiene ambos controles",{"_2299":49770,"_22571":49658,"_15405":86067,"_5":15294,"_21315":85772,"_1890":38966},[],{"_2299":49771,"_22571":49658,"_15405":86069,"_5":15294,"_21315":85772,"_1890":86070},[],"Webhook externo de autorización",{"_2299":49772,"_22571":49658,"_15405":86072,"_5":15294,"_21315":85772,"_1890":86073},[],"Ninguna en el canal TLS",{"_2299":49773,"_22571":49658,"_15405":86075,"_5":15294,"_21315":85772,"_1890":86049},[],{"_2299":49774,"_22571":49658,"_15405":86077,"_5":15294,"_21315":85772,"_1890":86078},[],"No, degrada a `NO_AUTH`",{"_2299":49775,"_22571":49658,"_15405":86080,"_5":15294,"_21315":85772,"_1890":38980},[],{"_2299":49776,"_22571":49658,"_15405":86082,"_5":15294,"_21315":85772,"_1890":86083},[],"Sin autenticación",{"_2299":49777,"_22571":49658,"_15405":86085,"_5":15294,"_21315":85772,"_1890":86086},[],"Ninguna",{"_2299":49778,"_22571":49658,"_15405":86088,"_5":15294,"_21315":85772,"_1890":86089},[],"Sí (uso restringido)",{"_2299":49779,"_22571":49658,"_15405":86091,"_5":15294,"_21315":85772,"_1890":86089},[],{"_2299":49780,"_22571":49658,"_15405":86093,"_5":15294,"_21315":85772,"_1890":86094},[],"JWT **no es un modo de autenticación válido en EST**. El extractor de identidad JWT existe en el código pero solo se evalúa en la API de administración de Lamassu. Cualquier *Bearer token* enviado a `/.well-known/est/...` se ignora silenciosamente. Cuando el DMS está configurado con `AuthMode: CLIENT_CERTIFICATE`, una petición que solo aporte JWT se rechaza por falta de certificado cliente. Cuando el DMS está en `AuthMode: NO_AUTH`, la petición se procesa como tal y el JWT no añade ni resta autorización.",{"_2299":49781,"_22571":49658,"_15405":86096,"_5":15294,"_21315":85772,"_1890":86097},[],"**`CLIENT_CERTIFICATE`**: el cliente presenta un certificado X.509 emitido por una de las CAs declaradas en `AuthOptionsMTLS.ValidationCAs`. El proceso valida la cadena del certificado contra esas CAs mediante los parámetros `ValidationCAs`, `AllowExpired` y `ChainLevelValidation`. Además, el servicio comprueba el estado de revocación en tres pasos: primero busca el cert en la base de datos local de Lamassu; si no lo encuentra, consulta los responders OCSP listados en la extensión AIA; si OCSP falla, intenta los CRL Distribution Points (CDP). Un certificado revocado interrumpe la inscripción con `certificate is revoked`.",{"_2299":49782,"_22571":49658,"_15405":86099,"_5":15294,"_21315":85772,"_1890":86100},[],"Sus parámetros principales son `ValidationCAs`, la lista de CAs que pueden validar el certificado bootstrap o el certificado en vigor; `AllowExpired`, que permite aceptar certificados cliente caducados; y `ChainLevelValidation`, que limita la profundidad de la cadena cuando su valor es mayor que cero.",{"_2299":49783,"_22571":49658,"_15405":86102,"_5":15294,"_21315":85772,"_1890":86103},[],"**`EXTERNAL_WEBHOOK`**: Lamassu delega la decisión de autorización en un servicio HTTP externo. El servidor EST construye una petición `POST` al webhook configurado con un cuerpo JSON que reproduce el contexto de la inscripción.",{"_2299":49784,"_22571":49658,"_15405":86105,"_5":15294,"_21315":85772,"_1890":86106},[],"El valor del campo `csr` es la **codificación base64 del PEM** del CSR (no el DER, y no el PEM en claro). El webhook debe responder con `2xx` y un cuerpo JSON `{\"authorized\": true}` para continuar; cualquier otra respuesta aborta el enrolamiento con `external webhook denied enrollment`. Un `204 No Content` **no es una respuesta válida** aunque sea un código `2xx`: Lamassu exige un cuerpo JSON con el campo `authorized`, así que un webhook que responda sin cuerpo deniega la operación igual que un error.",{"_2299":49785,"_22571":49658,"_15405":86108,"_5":15294,"_21315":85772,"_1890":86109},[],"**`CLIENT_CERTIFICATE_AND_EXTERNAL_WEBHOOK`**: combina los dos modos anteriores durante `/simpleenroll`. El cliente debe presentar un certificado mTLS válido y el webhook debe devolver `authorized: true`. En `/simplereenroll` la combinación no se conserva: el chequeo conjunto mTLS + webhook no se mantiene, por lo que el integrador no debe asumir que las mismas garantías del enrollment inicial aplican en reenroll.",{"_2299":49786,"_22571":49658,"_15405":86111,"_5":15294,"_21315":85772,"_1890":86112},[],"**`NO_AUTH`**: el DMS acepta cualquier CSR sin validar identidad del cliente. Lamassu emite un aviso en su log (`DMS is configured with NoAuth, allowing enrollment`) y procede al alta. Debe restringirse a entornos controlados (una red de aprovisionamiento aislada); cualquier red expuesta a internet con un DMS en `NO_AUTH` queda abierta a la emisión de certificados por terceros no autorizados.",{"_2299":49787,"_22571":49658,"_15405":86114,"_5":15294,"_21315":85776,"_1890":86115},[],"Las siguientes secciones describen los endpoints en el orden más habitual de uso dentro del ciclo de vida del dispositivo:",{"_2299":49788,"_22571":49658,"_15405":86117,"_5":15294,"_21315":85776,"_1890":86118},[],"`/cacerts`: descarga de la cadena de confianza.",{"_2299":49789,"_22571":49658,"_15405":86120,"_5":15294,"_21315":85776,"_1890":86121},[],"`/simpleenroll`: inscripción inicial del certificado.",{"_2299":49790,"_22571":49658,"_15405":86123,"_5":15294,"_21315":85776,"_1890":86124},[],"`/simplereenroll`: renovación de un certificado ya emitido.",{"_2299":49791,"_22571":49658,"_15405":86126,"_5":15294,"_21315":85776,"_1890":86127},[],"`/serverkeygen`: inscripción con generación de clave en servidor.",{"_2299":49792,"_22571":49658,"_15405":86129,"_5":15294,"_21315":85780,"_1890":86130},[],"El endpoint `GET /.well-known/est/{aps}/cacerts` distribuye los certificados que el dispositivo necesita para validar al servidor EST y al resto de las CAs gestionadas por el DMS. Lamassu inserta los certificados en este orden: primero el certificado **downstream** del servidor Lamassu, que es la hoja TLS del servidor y no una CA, útil para pinning si `IncludeLamassuSystemCA` está activado; después la lista `ManagedCAs` declarada en el DMS; y por último la CA de enrolamiento, si `IncludeEnrollmentCA` está activado.",{"_2299":49793,"_22571":49658,"_15405":86132,"_5":15294,"_21315":85780,"_1890":86133},[],"`CADistributionSettings` permite decidir qué se publica:",{"_2299":49794,"_22571":49658,"_15405":86135,"_5":15294,"_21315":85780,"_1890":86136},[],"**`IncludeLamassuSystemCA`** añade el certificado *downstream* del servidor Lamassu. Es la hoja TLS que el cliente puede usar para anclar la conexión, no una CA.",{"_2299":49795,"_22571":49658,"_15405":86138,"_5":15294,"_21315":85780,"_1890":86139},[],"**`IncludeEnrollmentCA`** añade la CA emisora del DMS, responsable de firmar los certificados de dispositivo.",{"_2299":49796,"_22571":49658,"_15405":86141,"_5":15294,"_21315":85780,"_1890":86142},[],"**`ManagedCAs`** publica CAs adicionales como anclas de confianza.",{"_2299":49797,"_22571":49658,"_15405":86144,"_5":15294,"_21315":85780,"_1890":86145},[],"El formato por defecto es PKCS#7 *degenerate* (sólo certificados) codificado en base64. La respuesta declara `Content-Type: application/pkcs7-mime; smime-type=certs-only` y `Content-Transfer-Encoding: base64`. El base64 viene troceado en líneas de **76 caracteres** terminadas en CRLF, una anchura conforme con S/MIME (RFC 5751), no los 64 que sugieren ciertas guías de RFC 7030. Este troceo aplica únicamente a `/cacerts` y `/simpleenroll`; las partes internas de `/serverkeygen` no llevan wrap, como se explica más abajo.",{"_2299":49798,"_22571":49658,"_15405":86147,"_5":15294,"_21315":85780,"_1890":86148},[],"El PKCS#7 *degenerate* es un **conjunto** de certificados sin orden semántico definido. Aunque Lamassu los inserta en el orden indicado, el integrador no debe asumir ese orden al validar cadenas: la cadena debe construirse por correspondencia `Subject`/`Issuer` (o por AKI/SKI), no por la posición en la respuesta.",{"_2299":49799,"_22571":49658,"_15405":86150,"_5":15294,"_21315":85780,"_1890":86151},[],"El flag `-i` (ignore garbage) ayuda a tolerar el CRLF que Lamassu añade y es necesario en algunos `base64` (BusyBox, BSD); en GNU coreutils se ignora.",{"_2299":49800,"_22571":49658,"_15405":86153,"_5":15294,"_21315":85780,"_1890":86154},[],"Lamassu añade además una extensión sobre el RFC: si el cliente envía la cabecera `Accept: application/x-pem-file`, el servidor responde con la concatenación PEM de los mismos certificados, sin el envoltorio PKCS#7. Esto facilita el consumo desde scripts. La extensión también funciona en `/simpleenroll` y `/simplereenroll`.",{"_2299":49801,"_22571":49658,"_15405":86156,"_5":15294,"_21315":85783,"_1890":86157},[],"El endpoint `POST /.well-known/est/{aps}/simpleenroll` recibe un CSR y devuelve el certificado emitido. El cuerpo de la petición debe ser el **PKCS#10 (CSR) en DER, codificado en base64** sin saltos de línea. La base64 envuelve directamente al DER, no al PEM. La cabecera `Content-Type` debe valer `application/pkcs10`. Si el `Content-Type` es diferente, el servidor responde `400` con `content-type must be application/pkcs10`; si el cuerpo no es base64 válido, responde `400` con `body payload must be base64 encoded`.",{"_2299":49802,"_22571":49658,"_15405":86159,"_5":15294,"_21315":85783,"_1890":86160},[],"La respuesta sigue el mismo envoltorio que `/cacerts`: PKCS#7 *degenerate* en base64, con `Content-Type: application/pkcs7-mime; smime-type=certs-only`. El PKCS#7 contiene **únicamente el certificado de hoja** recién emitido; no incluye la CA emisora ni intermediarios. Esto cumple RFC 7030 §4.2.3 (donde la cadena es opcional) pero implica que el integrador debe combinar este certificado con la cadena obtenida de `/cacerts` antes de presentarlo a cualquier relying party que valide cadena completa (por ejemplo, un broker MQTT con mTLS estricta).",{"_2299":49803,"_22571":49658,"_15405":86162,"_5":15294,"_21315":85783,"_1890":86163},[],"Varios campos del DMS gobiernan el comportamiento de `/simpleenroll`. El integrador no los configura, pero conviene conocerlos para interpretar los rechazos:",{"_2299":49804,"_22571":49658,"_15405":86165,"_5":15294,"_21315":85783,"_1890":86166},[],"**`EnrollmentSettings.RegistrationMode`** decide si el dispositivo se crea durante la primera inscripción (`JITP`) o debe existir previamente (`PRE_REGISTRATION`).",{"_2299":49805,"_22571":49658,"_15405":86168,"_5":15294,"_21315":85783,"_1890":86169},[],"**`EnrollmentSettings.EnableReplaceableEnrollment`** permite repetir `/simpleenroll` para un dispositivo ya enrolado. Al hacerlo, revoca el certificado anterior como `superseded`; si está desactivado, el servidor responde con `forbiddenNewEnrollment`.",{"_2299":49806,"_22571":49658,"_15405":86171,"_5":15294,"_21315":85783,"_1890":86172},[],"**`EnrollmentSettings.VerifyCSRSignature`** valida que quien envía el CSR controla la clave privada declarada. Para flotas IoT en redes abiertas debe estar activo.",{"_2299":49807,"_22571":49658,"_15405":86174,"_5":15294,"_21315":85783,"_1890":86175},[],"En modo `JITP`, el primer `simpleenroll` con un `CommonName` que aún no existe en Lamassu crea el dispositivo automáticamente. En modo `PRE_REGISTRATION`, el dispositivo debe existir previamente; un `CommonName` desconocido se rechaza con `device not preregistered`. Consulte Configuración de enrollment para más detalles sobre ambos modos y el comportamiento del perfil de emisión.",{"_2299":49808,"_22571":49658,"_15405":86177,"_5":15294,"_21315":85786,"_1890":86178},[],"El endpoint `POST /.well-known/est/{aps}/simplereenroll` renueva el certificado de un dispositivo ya enrolado. El formato del cuerpo es idéntico al de `/simpleenroll` (DER base64 sin saltos, `Content-Type: application/pkcs10`). La diferencia está en la autenticación: el cliente debe presentar **el certificado en vigor** del dispositivo (no el bootstrap) como credencial mTLS.",{"_2299":49809,"_22571":49658,"_15405":86180,"_5":15294,"_21315":85786,"_1890":86181},[],"Si el DMS está configurado con `AuthMode: EXTERNAL_WEBHOOK`, el webhook **no se invoca** durante `/simplereenroll`. El flujo de renovación degrada silenciosamente a `NO_AUTH`: cualquier cliente que conozca un `CommonName` válido puede solicitar reenroll para ese dispositivo sin autenticación (`allowing reenroll: using NO AUTH mode` en el log). Un DMS con `EXTERNAL_WEBHOOK` no debe usarse en producción para flujos de reenroll a menos que se controle la red de acceso al endpoint.",{"_2299":49810,"_22571":49658,"_15405":86183,"_5":15294,"_21315":85786,"_1890":86184},[],"El comportamiento del reenroll está condicionado por varios campos de `ReEnrollmentSettings`:",{"_2299":49811,"_22571":49658,"_15405":86186,"_5":15294,"_21315":85786,"_1890":86187},[],"**`ReEnrollmentDelta`** abre la ventana de renovación en `NotAfter - ReEnrollmentDelta`. Antes de ese instante, el servidor responde con `invalid reenroll window`.",{"_2299":49812,"_22571":49658,"_15405":86189,"_5":15294,"_21315":85786,"_1890":86190},[],"**`EnableExpiredRenewal`** permite usar un certificado ya caducado como prueba de identidad; si está desactivado, el servidor responde con `expired certificate`.",{"_2299":49813,"_22571":49658,"_15405":86192,"_5":15294,"_21315":85786,"_1890":86193},[],"**`RevokeOnReEnrollment`** revoca el certificado anterior como `superseded` después de emitir el nuevo.",{"_2299":49814,"_22571":49658,"_15405":86195,"_5":15294,"_21315":85786,"_1890":86196},[],"**`AdditionalValidationCAs`** añade emisores válidos para el certificado actual, además de la CA de enrolamiento del DMS.",{"_2299":49815,"_22571":49658,"_15405":86198,"_5":15294,"_21315":85786,"_1890":86199},[],"**Inmutabilidad del subject**: el CSR de renovación debe tener exactamente el mismo subject que el certificado en vigor. Lamassu compara, byte a byte, el `RawSubject` del CSR con el del certificado (`slices.Compare`). Si los bytes difieren, el servidor cae a una comparación semántica de respaldo sobre los atributos `CommonName`, `OrganizationalUnit`, `Organization`, `Locality`, `Province` y `Country`. Si todos esos atributos coinciden, el reenroll continúa pese a la diferencia de bytes (rescata casos donde solo cambia la codificación, `PrintableString` frente a `UTF8String`). Si algún atributo difiere, el reenroll se aborta con `invalid RawSubject bytes`. El integrador debe regenerar el CSR con exactamente el mismo subject que en la inscripción inicial para no depender del comportamiento de fallback.",{"_2299":49816,"_22571":49658,"_15405":86201,"_5":15294,"_21315":85786,"_1890":86202},[],"**Validación de la cadena del certificado presentado**: la validación se intenta primero contra la CA de enrolamiento del DMS; si falla, recorre las `AdditionalValidationCAs`. La validación es \"shallow\": cada CA se prueba como ancla, no se compone una cadena multinivel. El cliente debe presentar la cadena completa en el handshake mTLS. Un certificado revocado aborta el reenroll con `certificate is revoked`.",{"_2299":49817,"_22571":49658,"_15405":86204,"_5":15294,"_21315":85789,"_1890":86205},[],"El endpoint `POST /.well-known/est/{aps}/serverkeygen` permite que Lamassu genere el par de claves del dispositivo en el servidor y devuelva, en la misma respuesta, la clave privada y el certificado emitido. Es útil para dispositivos con capacidad criptográfica limitada o flujos donde la clave se aprovisiona durante la fabricación.",{"_2299":49818,"_22571":49658,"_15405":86207,"_5":15294,"_21315":85789,"_1890":86208},[],"Este endpoint requiere que `ServerKeyGen.Enabled` valga `true` en el DMS. Si no está activado, el servidor responde con `server key generation not enabled`. La autenticación se aplica igual que en `/simpleenroll`: el integrador presenta la credencial que corresponda al `AuthMode` del DMS.",{"_2299":49819,"_22571":49658,"_15405":86210,"_5":15294,"_21315":85789,"_1890":86211},[],"El algoritmo y el tamaño de la clave generada se deciden por el DMS, no por el cliente.",{"_2299":49820,"_22571":49658,"_15405":86213,"_5":15294,"_21315":85789,"_1890":86214},[],"**RSA** admite cualquier tamaño aceptado por `crypto/rsa`; los valores habituales son 2048, 3072 y 4096 bits. Un valor no válido hace fallar la generación con un error `500`.",{"_2299":49821,"_22571":49658,"_15405":86216,"_5":15294,"_21315":85789,"_1890":86217},[],"**ECDSA** admite 224, 256, 384 y 521 bits, equivalentes a P-224, P-256 (`prime256v1`), P-384 y P-521. Cualquier otro valor degrada **silenciosamente** a P-256 y solo deja un aviso en el log: el cliente no recibe un error y puede obtener una curva distinta de la esperada.",{"_2299":49822,"_22571":49658,"_15405":86219,"_5":15294,"_21315":85789,"_1890":86220},[],"El CSR enviado por el cliente sirve únicamente para transportar el subject y las extensiones; la prueba de posesión PKCS#10 no aplica aquí porque el cliente no es quien generó la clave. Lamassu descarta la clave pública del CSR original, genera un par de claves nuevo con su entropía interna, en motor software y no en un Crypto Engine de hardware como AWS KMS o PKCS#11, construye un CSR nuevo con esa clave y procede a una inscripción interna equivalente a `/simpleenroll`.",{"_2299":49823,"_22571":49658,"_15405":86222,"_5":15294,"_21315":85789,"_1890":86223},[],"La respuesta es un `multipart/mixed` con el boundary literal `estServerLamassuBoundary`. Contiene dos partes:",{"_2299":49824,"_22571":49658,"_15405":86225,"_5":15294,"_21315":85789,"_1890":86226},[],"La clave privada en formato **PKCS#8 sin cifrar**, codificada en base64 dentro de una parte con `Content-Type: application/pkcs8`.",{"_2299":49825,"_22571":49658,"_15405":86228,"_5":15294,"_21315":85789,"_1890":86229},[],"El certificado emitido en PKCS#7 *degenerate* base64, dentro de una parte con `Content-Type: application/pkcs7-mime; smime-type=certs-only`.",{"_2299":49826,"_22571":49658,"_15405":86231,"_5":15294,"_21315":85789,"_1890":86232},[],"A diferencia de `/cacerts` y `/simpleenroll`, donde el base64 va troceado en líneas de 76 caracteres, cada parte de `/serverkeygen` viaja como **una única línea base64 sin saltos**. Cualquier proxy inverso que reescriba el cuerpo (por ejemplo, normalizando line endings) puede romper el parseo.",{"_2299":49827,"_22571":49658,"_15405":86234,"_5":15294,"_21315":85789,"_1890":86235},[],"Este endpoint invierte el principio PKI por el que el subscriber controla su clave privada. La clave se serializa en PKCS#8 sin cifrar (`PrivateKeyInfo`, sin `EncryptedPrivateKeyInfo`). No se aplica el envoltorio CMS `EnvelopedData` contemplado en RFC 7030 §4.4.2; no se aplica AES key wrap ni cifrado simétrico por contraseña. La única protección es el TLS del canal. El integrador debe garantizar que: (a) ningún proxy inverso termine TLS y registre el cuerpo de la respuesta; (b) la clave se cifre en reposo inmediatamente tras recibirla; (c) la cuenta de auditoría en el servidor Lamassu queda como punto único de origen de la clave.",{"_2299":49828,"_22571":49658,"_15405":86237,"_5":15294,"_21315":85789,"_1890":86238},[],"Para separar las dos partes, el siguiente fragmento usa `awk` con el boundary literal. Funciona con la estructura exacta de Lamassu (cada parte = headers + línea en blanco + una sola línea base64); cualquier proxy intermedio que reescriba el cuerpo lo romperá.",{"_2299":49829,"_22571":49658,"_15405":86240,"_5":15294,"_21315":85792,"_1890":86241},[],"Una vez revisados los endpoints por separado, estos ejemplos muestran cómo encadenarlos en dos escenarios habituales: el alta inicial de un dispositivo y la renovación de un certificado ya emitido.",{"_2299":49830,"_22571":49658,"_15405":86243,"_5":15294,"_21315":85796,"_1890":86244},[],"El siguiente script ilustra el proceso completo de inscripción de un dispositivo con clave EC P-256 generada localmente y autenticación mTLS contra un certificado bootstrap.",{"_2299":49831,"_22571":49658,"_15405":86246,"_5":15294,"_21315":85800,"_1890":86247},[],"El siguiente script reproduce un proceso de renovación: detecta la expiración del certificado actual, regenera el CSR con el **mismo subject** y se autentica con el certificado en vigor.",{"_2299":49832,"_22571":49658,"_15405":86249,"_5":15294,"_21315":85804,"_1890":86250},[],"Una vez que el dispositivo ha obtenido su certificado de identidad, los pasos habituales son:",{"_2299":49833,"_22571":49658,"_15405":86252,"_5":15294,"_21315":85804,"_1890":86253},[],"**Instalar la cadena de confianza** (`cacerts.pem`) en el almacén de confianza del dispositivo. El broker MQTT, el servidor HTTPS o cualquier relying party que valide mTLS necesitará esta cadena.",{"_2299":49834,"_22571":49658,"_15405":86255,"_5":15294,"_21315":85804,"_1890":86256},[],"**Combinar el certificado de hoja con la cadena** antes de presentarlo en conexiones mTLS. La respuesta de `/simpleenroll` contiene solo el certificado de hoja; el relying party puede rechazar la conexión si no recibe la cadena completa.",{"_2299":49835,"_22571":49658,"_15405":86258,"_5":15294,"_21315":85804,"_1890":86259},[],"**Planificar la renovación**: configurar en el dispositivo un temporizador que invoque `/simplereenroll` dentro de la ventana `ReEnrollmentDelta` antes de la caducidad del certificado. No espere a que caduque salvo que `EnableExpiredRenewal` esté activo.",{"_2299":49836,"_22571":49658,"_15405":86261,"_5":15294,"_21315":85812,"_1890":86262},[],"Lamassu mapea casi todos los errores de negocio a `500 Internal Server Error`, no a `4xx`. El código de estado HTTP no es suficiente para distinguir entre un error de red y un error de política. El integrador debe inspeccionar el campo `err` del cuerpo JSON (`{\"err\": \"<mensaje>\"}`) para determinar la causa exacta del fallo.",{"_2299":49837,"_22571":49658,"_15405":86264,"_5":15294,"_21315":85812,"_1890":39165},[],{"_2299":49838,"_22571":49658,"_15405":86266,"_5":15294,"_21315":85812,"_1890":86267},[],"Mensaje",{"_2299":49839,"_22571":49658,"_15405":86269,"_5":15294,"_21315":85812,"_1890":86270},[],"Causa",{"_2299":49840,"_22571":49658,"_15405":86272,"_5":15294,"_21315":85812,"_1890":86273},[],"Acción del integrador",{"_2299":49841,"_22571":49658,"_15405":86275,"_5":15294,"_21315":85812,"_1890":21907},[],{"_2299":49842,"_22571":49658,"_15405":86277,"_5":15294,"_21315":85812,"_1890":39179},[],{"_2299":49843,"_22571":49658,"_15405":86279,"_5":15294,"_21315":85812,"_1890":86280},[],"El segmento `{aps}` falta en la URL.",{"_2299":49844,"_22571":49658,"_15405":86282,"_5":15294,"_21315":85812,"_1890":86283},[],"Incluir el ID del DMS en la ruta.",{"_2299":49845,"_22571":49658,"_15405":86285,"_5":15294,"_21315":85812,"_1890":21907},[],{"_2299":49846,"_22571":49658,"_15405":86287,"_5":15294,"_21315":85812,"_1890":39190},[],{"_2299":49847,"_22571":49658,"_15405":86289,"_5":15294,"_21315":85812,"_1890":86290},[],"Cabecera `Content-Type` ausente o incorrecta.",{"_2299":49848,"_22571":49658,"_15405":86292,"_5":15294,"_21315":85812,"_1890":86293},[],"Fijar `Content-Type: application/pkcs10`.",{"_2299":49849,"_22571":49658,"_15405":86295,"_5":15294,"_21315":85812,"_1890":21907},[],{"_2299":49850,"_22571":49658,"_15405":86297,"_5":15294,"_21315":85812,"_1890":39201},[],{"_2299":49851,"_22571":49658,"_15405":86299,"_5":15294,"_21315":85812,"_1890":86300},[],"El cuerpo no es base64 válido.",{"_2299":49852,"_22571":49658,"_15405":86302,"_5":15294,"_21315":85812,"_1890":86303},[],"Usar `base64 -w 0` para evitar saltos de línea.",{"_2299":49853,"_22571":49658,"_15405":86305,"_5":15294,"_21315":85812,"_1890":21820},[],{"_2299":49854,"_22571":49658,"_15405":86307,"_5":15294,"_21315":85812,"_1890":39212},[],{"_2299":49855,"_22571":49658,"_15405":86309,"_5":15294,"_21315":85812,"_1890":86310},[],"El valor `{aps}` no se corresponde con ningún DMS.",{"_2299":49856,"_22571":49658,"_15405":86312,"_5":15294,"_21315":85812,"_1890":86313},[],"Verificar el identificador con el administrador PKI.",{"_2299":49857,"_22571":49658,"_15405":86315,"_5":15294,"_21315":85812,"_1890":21820},[],{"_2299":49858,"_22571":49658,"_15405":86317,"_5":15294,"_21315":85812,"_1890":39223},[],{"_2299":49859,"_22571":49658,"_15405":86319,"_5":15294,"_21315":85812,"_1890":86320},[],"El certificado cliente no es válido contra `ValidationCAs`.",{"_2299":49860,"_22571":49658,"_15405":86322,"_5":15294,"_21315":85812,"_1890":86323},[],"Comprobar la cadena del certificado bootstrap.",{"_2299":49861,"_22571":49658,"_15405":86325,"_5":15294,"_21315":85812,"_1890":21820},[],{"_2299":49862,"_22571":49658,"_15405":86327,"_5":15294,"_21315":85812,"_1890":39234},[],{"_2299":49863,"_22571":49658,"_15405":86329,"_5":15294,"_21315":85812,"_1890":86330},[],"El certificado **presentado como credencial mTLS** está revocado en Lamassu o vía OCSP/CRL externos.",{"_2299":49864,"_22571":49658,"_15405":86332,"_5":15294,"_21315":85812,"_1890":86333},[],"Solicitar un nuevo certificado bootstrap o investigar la revocación.",{"_2299":49865,"_22571":49658,"_15405":86335,"_5":15294,"_21315":85812,"_1890":21820},[],{"_2299":49866,"_22571":49658,"_15405":86337,"_5":15294,"_21315":85812,"_1890":39245},[],{"_2299":49867,"_22571":49658,"_15405":86339,"_5":15294,"_21315":85812,"_1890":86340},[],"En reenroll, el certificado **activo del dispositivo en la base de datos** figura como revocado.",{"_2299":49868,"_22571":49658,"_15405":86342,"_5":15294,"_21315":85812,"_1890":86343},[],"Revisar el estado del slot de identidad; si la revocación fue intencional, emitir un nuevo enroll en lugar de reenroll.",{"_2299":49869,"_22571":49658,"_15405":86345,"_5":15294,"_21315":85812,"_1890":21820},[],{"_2299":49870,"_22571":49658,"_15405":86347,"_5":15294,"_21315":85812,"_1890":39256},[],{"_2299":49871,"_22571":49658,"_15405":86349,"_5":15294,"_21315":85812,"_1890":86350},[],"El certificado presentado ha caducado y el DMS no permite `AllowExpired`/`EnableExpiredRenewal`.",{"_2299":49872,"_22571":49658,"_15405":86352,"_5":15294,"_21315":85812,"_1890":86353},[],"Renovar antes de la caducidad o solicitar habilitar `EnableExpiredRenewal`.",{"_2299":49873,"_22571":49658,"_15405":86355,"_5":15294,"_21315":85812,"_1890":21820},[],{"_2299":49874,"_22571":49658,"_15405":86357,"_5":15294,"_21315":85812,"_1890":39267},[],{"_2299":49875,"_22571":49658,"_15405":86359,"_5":15294,"_21315":85812,"_1890":86360},[],"El dispositivo ya está enrolado y `EnableReplaceableEnrollment` es `false`.",{"_2299":49876,"_22571":49658,"_15405":86362,"_5":15294,"_21315":85812,"_1890":86363},[],"Usar `/simplereenroll` o pedir al administrador que habilite el flag.",{"_2299":49877,"_22571":49658,"_15405":86365,"_5":15294,"_21315":85812,"_1890":21820},[],{"_2299":49878,"_22571":49658,"_15405":86367,"_5":15294,"_21315":85812,"_1890":39278},[],{"_2299":49879,"_22571":49658,"_15405":86369,"_5":15294,"_21315":85812,"_1890":86370},[],"El DMS está en `PRE_REGISTRATION` y el dispositivo no existe.",{"_2299":49880,"_22571":49658,"_15405":86372,"_5":15294,"_21315":85812,"_1890":86373},[],"Registrar el dispositivo antes de inscribirlo.",{"_2299":49881,"_22571":49658,"_15405":86375,"_5":15294,"_21315":85812,"_1890":21820},[],{"_2299":49882,"_22571":49658,"_15405":86377,"_5":15294,"_21315":85812,"_1890":39289},[],{"_2299":49883,"_22571":49658,"_15405":86379,"_5":15294,"_21315":85812,"_1890":86380},[],"Se intenta renovar antes de `NotAfter - ReEnrollmentDelta`.",{"_2299":49884,"_22571":49658,"_15405":86382,"_5":15294,"_21315":85812,"_1890":86383},[],"Esperar a la apertura de la ventana o pedir un `ReEnrollmentDelta` mayor.",{"_2299":49885,"_22571":49658,"_15405":86385,"_5":15294,"_21315":85812,"_1890":21820},[],{"_2299":49886,"_22571":49658,"_15405":86387,"_5":15294,"_21315":85812,"_1890":39300},[],{"_2299":49887,"_22571":49658,"_15405":86389,"_5":15294,"_21315":85812,"_1890":86390},[],"El subject del CSR de renovación no coincide con el del certificado en vigor.",{"_2299":49888,"_22571":49658,"_15405":86392,"_5":15294,"_21315":85812,"_1890":86393},[],"Regenerar el CSR con el subject exacto del cert anterior.",{"_2299":49889,"_22571":49658,"_15405":86395,"_5":15294,"_21315":85812,"_1890":21820},[],{"_2299":49890,"_22571":49658,"_15405":86397,"_5":15294,"_21315":85812,"_1890":39311},[],{"_2299":49891,"_22571":49658,"_15405":86399,"_5":15294,"_21315":85812,"_1890":86400},[],"El webhook devolvió un código no `2xx` o `authorized != true`.",{"_2299":49892,"_22571":49658,"_15405":86402,"_5":15294,"_21315":85812,"_1890":86403},[],"Revisar los logs del servicio webhook.",{"_2299":49893,"_22571":49658,"_15405":86405,"_5":15294,"_21315":85812,"_1890":21820},[],{"_2299":49894,"_22571":49658,"_15405":86407,"_5":15294,"_21315":85812,"_1890":39322},[],{"_2299":49895,"_22571":49658,"_15405":86409,"_5":15294,"_21315":85812,"_1890":86410},[],"`/serverkeygen` está deshabilitado en el DMS.",{"_2299":49896,"_22571":49658,"_15405":86412,"_5":15294,"_21315":85812,"_1890":86413},[],"Pedir al administrador activar `ServerKeyGen.Enabled`.",{"_2299":49897,"_22571":49658,"_15405":86415,"_5":15294,"_21315":85812,"_1890":86416},[],"Para los mensajes que no figuren en esta tabla, los logs del servidor Lamassu (con los campos `func`, `dms`, `device-cn`, `step`, `auth-method`, `auth-status`) son el primer lugar donde buscar la causa.",{"_2299":49898,"_22571":49658,"_15405":86418,"_5":15294,"_21315":85816,"_1890":86419},[],"La implementación de Lamassu se ajusta al RFC 7030 en lo esencial pero introduce varias particularidades que pueden afectar a clientes EST estrictos o a librerías de terceros:",{"_2299":49899,"_22571":49658,"_15405":86421,"_5":15294,"_21315":85816,"_1890":86422},[],"Los endpoints `/csrattrs` y `/fullcmc` del RFC 7030 **no están implementados** en Lamassu. Un cliente que invoque `/.well-known/est/<DMS_ID>/csrattrs` recibirá `404 Not Found` en lugar del `204 No Content` que el RFC sugiere para \"sin atributos\". Las librerías EST estrictas deben configurarse para no intentar `csrattrs`.",{"_2299":49900,"_22571":49658,"_15405":86424,"_5":15294,"_21315":85816,"_1890":86425},[],"El base64 de la respuesta de `/cacerts` y `/simpleenroll` se trocea en líneas de **76 caracteres** terminadas con CRLF (conforme con S/MIME, RFC 5751). Las partes de `/serverkeygen` no aplican wrap.",{"_2299":49901,"_22571":49658,"_15405":86427,"_5":15294,"_21315":85816,"_1890":86428},[],"El boundary del `multipart/mixed` en `/serverkeygen` está fijado y no se puede negociar.",{"_2299":49902,"_22571":49658,"_15405":86430,"_5":15294,"_21315":85816,"_1890":86431},[],"El segmento `{aps}` es **obligatorio** en todas las rutas EST. Las rutas registradas sin `{aps}` están en el código pero responden `400`.",{"_2299":49903,"_22571":49658,"_15405":86433,"_5":15294,"_21315":85816,"_1890":86434},[],"El cuerpo de `/cacerts`, `/simpleenroll` y `/simplereenroll` puede devolverse como PEM concatenado si el cliente envía `Accept: application/x-pem-file`. Esta es una extensión específica de Lamassu y no aparece en el RFC.",{"_2299":49904,"_22571":49658,"_15405":86436,"_5":15294,"_21315":85816,"_1890":86437},[],"El servidor no rechaza explícitamente CSRs firmados con SHA-1 o MD5; el integrador debe generar el CSR con SHA-256 o superior.",{"_2299":49905,"_22571":49658,"_15405":86439,"_5":15294,"_21315":85816,"_1890":86440},[],"<Card title=\"Visión general del DMS\" href=\"/docs/platform/pki/device-enrollment\" />",{"_2299":49906,"_22571":49658,"_15405":86442,"_5":15294,"_21315":85816,"_1890":86443},[],"<Card title=\"Validación OCSP\" href=\"/docs/platform/pki/ocsp\" />",{"_2299":49907,"_22571":49658,"_15405":86445,"_5":15294,"_21315":85816,"_1890":86446},[],"<Card title=\"Gestionar dispositivos\" href=\"/docs/platform/pki/device-management\" />",{"_2299":49908,"_22571":49908,"_5":10616,"_1890":39363,"_22830":86448,"_15405":86450,"_21315":49908},[35156,83411,86449],"Integraciones",[],{"_2299":49909,"_22571":49908,"_15405":86452,"_5":15294,"_21315":49908,"_1890":86453},[],"El conector de Lamassu para AWS IoT Core sincroniza las identidades de los dispositivos con la plataforma AWS, gestionando el registro de CAs, el aprovisionamiento de Things y el ciclo de vida de los certificados de forma automática y orientada a eventos.",{"_2299":49910,"_22571":49908,"_5":22827,"_15405":86455,"_21315":86456,"_1890":86457},[],"/docs/es/platform/pki/integrations/aws-iot-core#arquitectura-del-conector","Arquitectura del conector",{"_2299":49911,"_22571":49908,"_5":22827,"_15405":86459,"_21315":86460,"_1890":86461},[],"/docs/es/platform/pki/integrations/aws-iot-core#prerrequisitos","Prerrequisitos",{"_2299":49912,"_22571":49908,"_5":22827,"_15405":86463,"_21315":86464,"_1890":86465},[],"/docs/es/platform/pki/integrations/aws-iot-core#permisos-iam-necesarios","Permisos IAM necesarios",{"_2299":49913,"_22571":49908,"_5":22827,"_15405":86467,"_21315":86468,"_1890":86469},[],"/docs/es/platform/pki/integrations/aws-iot-core#parámetros-de-configuración","Parámetros de configuración",{"_2299":49914,"_22571":49908,"_5":22827,"_15405":86471,"_21315":86472,"_1890":86473},[],"/docs/es/platform/pki/integrations/aws-iot-core#registro-de-la-ca-en-aws-iot-core","Registro de la CA en AWS IoT Core",{"_2299":49915,"_22571":49908,"_5":22827,"_15405":86475,"_21315":86476,"_1890":86477},[],"/docs/es/platform/pki/integrations/aws-iot-core#cómo-solicitar-el-registro","Cómo solicitar el registro",{"_2299":49916,"_22571":49908,"_5":22827,"_15405":86479,"_21315":86480,"_1890":39396},[],"/docs/es/platform/pki/integrations/aws-iot-core#primary-account",{"_2299":49917,"_22571":49908,"_5":22827,"_15405":86482,"_21315":86483,"_1890":39400},[],"/docs/es/platform/pki/integrations/aws-iot-core#secondary-account-sni-only",{"_2299":49918,"_22571":49908,"_5":22827,"_15405":86485,"_21315":86486,"_1890":85728},[],"/docs/es/platform/pki/integrations/aws-iot-core#configuración-del-dms",{"_2299":49919,"_22571":49908,"_5":22827,"_15405":86488,"_21315":86489,"_1890":86490},[],"/docs/es/platform/pki/integrations/aws-iot-core#modo-none","Modo `none`",{"_2299":49920,"_22571":49908,"_5":22827,"_15405":86492,"_21315":86493,"_1890":86494},[],"/docs/es/platform/pki/integrations/aws-iot-core#modo-auto","Modo `auto`",{"_2299":49921,"_22571":49908,"_5":22827,"_15405":86496,"_21315":86497,"_1890":86498},[],"/docs/es/platform/pki/integrations/aws-iot-core#modo-jitp","Modo `jitp`",{"_2299":49922,"_22571":49908,"_5":22827,"_15405":86500,"_21315":86501,"_1890":86502},[],"/docs/es/platform/pki/integrations/aws-iot-core#aprovisionamiento-de-dispositivos-modo-automático","Aprovisionamiento de dispositivos (modo automático)",{"_2299":49923,"_22571":49908,"_5":22827,"_15405":86504,"_21315":86505,"_1890":86506},[],"/docs/es/platform/pki/integrations/aws-iot-core#aprovisionamiento-de-dispositivos-modo-jitp","Aprovisionamiento de dispositivos (modo JITP)",{"_2299":49924,"_22571":49908,"_5":22827,"_15405":86508,"_21315":86509,"_1890":86510},[],"/docs/es/platform/pki/integrations/aws-iot-core#sincronización-del-estado-del-certificado","Sincronización del estado del certificado",{"_2299":49925,"_22571":49908,"_5":22827,"_15405":86512,"_21315":86513,"_1890":86514},[],"/docs/es/platform/pki/integrations/aws-iot-core#desconexión-forzada-al-revocar","Desconexión forzada al revocar",{"_2299":49926,"_22571":49908,"_5":22827,"_15405":86516,"_21315":86517,"_1890":86518},[],"/docs/es/platform/pki/integrations/aws-iot-core#device-shadow-y-automatización","Device Shadow y automatización",{"_2299":49927,"_22571":49908,"_5":22827,"_15405":86520,"_21315":86521,"_1890":86522},[],"/docs/es/platform/pki/integrations/aws-iot-core#qué-escribe-el-conector-en-el-shadow","Qué escribe el conector en el shadow",{"_2299":49928,"_22571":49908,"_5":22827,"_15405":86524,"_21315":86525,"_1890":86526},[],"/docs/es/platform/pki/integrations/aws-iot-core#políticas-de-aws-iot","Políticas de AWS IoT",{"_2299":49929,"_22571":49908,"_5":22827,"_15405":86528,"_21315":86529,"_1890":86530},[],"/docs/es/platform/pki/integrations/aws-iot-core#solución-de-problemas","Solución de problemas",{"_2299":49930,"_22571":49908,"_15405":86532,"_5":15294,"_21315":49908,"_1890":86533},[],"La integración de Lamassu con AWS IoT Core cubre el puente entre la PKI gestionada por Lamassu y la plataforma de conectividad de AWS. Cuando un dispositivo obtiene su certificado a través del proceso de enrolamiento EST, el conector se encarga de que ese certificado y la identidad asociada sean reconocidos en AWS IoT Core sin intervención manual. El resultado es que el dispositivo puede autenticarse directamente en AWS con el mismo certificado X.509 que Lamassu emitió.",{"_2299":49931,"_22571":49908,"_15405":86535,"_5":15294,"_21315":49908,"_1890":86536},[],"Desde el punto de vista del protocolo, el dispositivo se autentica ante AWS IoT Core mediante TLS mutuo (mTLS): presenta su certificado X.509 emitido por Lamassu como certificado de cliente, y AWS IoT Core verifica la cadena de certificados hasta llegar a la CA registrada en la cuenta. Lamassu actúa como autoridad de certificación (CA); el conector se encarga de que esa CA esté registrada en AWS y de que el certificado del dispositivo sea conocido por la plataforma antes de que el dispositivo intente conectarse (en modo `auto`) o en su primera conexión (en modo JITP).",{"_2299":49932,"_22571":49908,"_15405":86538,"_5":15294,"_21315":49908,"_1890":86539},[],"Este documento está dirigido tanto al administrador PKI, que necesita configurar el conector y registrar las CAs, como al desarrollador de firmware de dispositivos, que necesita entender cómo se nombran los Things, cómo funciona el Device Shadow y qué ocurre cuando un certificado se revoca. Para el desarrollador de firmware, el dato más importante es que el **nombre del Thing en AWS (ThingName) corresponde siempre al Common Name (CN) del certificado emitido por Lamassu**, independientemente del modo de aprovisionamiento.",{"_2299":49933,"_22571":49908,"_15405":86541,"_5":15294,"_21315":86456,"_1890":86542},[],"El conector de AWS IoT Core es un proceso Go independiente, un binario o contenedor separado del núcleo de Lamassu. En un despliegue monolítico se compila por defecto (etiqueta de compilación `!noaws`) y se activa mediante `aws_iot_manager.enabled: true` en el fichero de configuración. En despliegues distribuidos, se ejecuta como un contenedor propio con acceso a los servicios de CA, DMS Manager y Device Manager de Lamassu a través de HTTP.",{"_2299":49934,"_22571":49908,"_15405":86544,"_5":15294,"_21315":86456,"_1890":86545},[],"El conector no sondea los servicios de Lamassu periódicamente. En su lugar, **se suscribe al bus de eventos interno** de Lamassu (AMQP o AWS SQS/SNS, configurable) y reacciona a los eventos que le interesan: creación o actualización de CAs, creación o actualización de DMS, vinculación de identidad de dispositivo, cambio de estado de certificado, actualización de metadatos de certificado y actualización de metadatos de dispositivo. Este modelo orientado a eventos garantiza que la sincronización con AWS sea casi inmediata y no genere carga de sondeo.",{"_2299":49935,"_22571":49908,"_15405":86547,"_5":15294,"_21315":86456,"_1890":86548},[],"Para evitar bucles infinitos, el conector ignora cualquier evento cuyo campo `source` de CloudEvent coincida con su propia URI de origen. Esto previene que las escrituras de metadatos que el propio conector realiza vuelvan a disparar el mismo flujo.",{"_2299":49936,"_22571":49908,"_15405":86550,"_5":15294,"_21315":86456,"_1890":86551},[],"Cuando se ejecutan varios conectores en paralelo, por ejemplo, para distintas cuentas de AWS, cada instancia tiene su propio `connector_id`. Todos los metadatos que el conector escribe en Lamassu se almacenan bajo la clave `lamassu.io/iot/{connector_id}`, lo que permite coexistencia sin colisiones.",{"_2299":49937,"_22571":49908,"_15405":86553,"_5":15294,"_21315":86460,"_1890":86554},[],"Antes de activar el conector es necesario disponer de una cuenta AWS con los permisos IAM adecuados y tener el conector correctamente configurado. El proceso de despliegue (Docker Compose, Kubernetes o binario) se describe en la documentación de despliegue.",{"_2299":49938,"_22571":49908,"_15405":86556,"_5":15294,"_21315":86464,"_1890":86557},[],"La identidad IAM con la que opera el conector debe tener al mínimo los siguientes permisos sobre los recursos de la cuenta destino:",{"_2299":49939,"_22571":49908,"_15405":86559,"_5":15294,"_21315":86464,"_1890":86560},[],"Acción IAM",{"_2299":49940,"_22571":49908,"_15405":86562,"_5":15294,"_21315":86464,"_1890":82684},[],{"_2299":49941,"_22571":49908,"_15405":86564,"_5":15294,"_21315":86464,"_1890":39482},[],{"_2299":49942,"_22571":49908,"_15405":86566,"_5":15294,"_21315":86464,"_1890":86567},[],"Obtener el código de verificación para el registro de CA en Primary Account",{"_2299":49943,"_22571":49908,"_15405":86569,"_5":15294,"_21315":86464,"_1890":39488},[],{"_2299":49944,"_22571":49908,"_15405":86571,"_5":15294,"_21315":86464,"_1890":86572},[],"Registrar la CA en AWS IoT",{"_2299":49945,"_22571":49908,"_15405":86574,"_5":15294,"_21315":86464,"_1890":39494},[],{"_2299":49946,"_22571":49908,"_15405":86576,"_5":15294,"_21315":86464,"_1890":86577},[],"Consultar el estado del registro de la CA",{"_2299":49947,"_22571":49908,"_15405":86579,"_5":15294,"_21315":86464,"_1890":39500},[],{"_2299":49948,"_22571":49908,"_15405":86581,"_5":15294,"_21315":86464,"_1890":86582},[],"Crear o actualizar Things en IoT Core",{"_2299":49949,"_22571":49908,"_15405":86584,"_5":15294,"_21315":86464,"_1890":39506},[],{"_2299":49950,"_22571":49908,"_15405":86586,"_5":15294,"_21315":86464,"_1890":86587},[],"Aprovisionar Things mediante plantilla",{"_2299":49951,"_22571":49908,"_15405":86589,"_5":15294,"_21315":86464,"_1890":39512},[],{"_2299":49952,"_22571":49908,"_15405":86591,"_5":15294,"_21315":86464,"_1890":86592},[],"Registrar certificados de dispositivo",{"_2299":49953,"_22571":49908,"_15405":86594,"_5":15294,"_21315":86464,"_1890":39518},[],{"_2299":49954,"_22571":49908,"_15405":86596,"_5":15294,"_21315":86464,"_1890":86597},[],"Cambiar el estado de un certificado (ACTIVE / INACTIVE / REVOKED)",{"_2299":49955,"_22571":49908,"_15405":86599,"_5":15294,"_21315":86464,"_1890":39524},[],{"_2299":49956,"_22571":49908,"_15405":86601,"_5":15294,"_21315":86464,"_1890":86602},[],"Crear y adjuntar políticas IoT",{"_2299":49957,"_22571":49908,"_15405":86604,"_5":15294,"_21315":86464,"_1890":39530},[],{"_2299":49958,"_22571":49908,"_15405":86606,"_5":15294,"_21315":86464,"_1890":86607},[],"Gestionar grupos de Things",{"_2299":49959,"_22571":49908,"_15405":86609,"_5":15294,"_21315":86464,"_1890":39536},[],{"_2299":49960,"_22571":49908,"_15405":86611,"_5":15294,"_21315":86464,"_1890":86612},[],"Crear plantillas JITP",{"_2299":49961,"_22571":49908,"_15405":86614,"_5":15294,"_21315":86464,"_1890":39542},[],{"_2299":49962,"_22571":49908,"_15405":86616,"_5":15294,"_21315":86464,"_1890":86617},[],"Leer y escribir el Device Shadow",{"_2299":49963,"_22571":49908,"_15405":86619,"_5":15294,"_21315":86464,"_1890":86620},[],"Para el mecanismo de desconexión forzada tras revocación también se requiere acceso a la API del plano de datos de AWS IoT (`iot:Connect` con SigV4 sobre WebSocket), que se negocia de forma implícita con las credenciales del conector.",{"_2299":49964,"_22571":49908,"_15405":86622,"_5":15294,"_21315":86468,"_1890":86623},[],"Parámetro",{"_2299":49965,"_22571":49908,"_15405":86625,"_5":15294,"_21315":86468,"_1890":86626},[],"Tipo",{"_2299":49966,"_22571":49908,"_15405":86628,"_5":15294,"_21315":86468,"_1890":86629},[],"Requerido",{"_2299":49967,"_22571":49908,"_15405":86631,"_5":15294,"_21315":86468,"_1890":85434},[],{"_2299":49968,"_22571":49908,"_15405":86633,"_5":15294,"_21315":86468,"_1890":39562},[],{"_2299":49969,"_22571":49908,"_15405":86635,"_5":15294,"_21315":86468,"_1890":18572},[],{"_2299":49970,"_22571":49908,"_15405":86637,"_5":15294,"_21315":86468,"_1890":86049},[],{"_2299":49971,"_22571":49908,"_15405":86639,"_5":15294,"_21315":86468,"_1890":86640},[],"Identificador único de esta instancia del conector. Se usa como espacio de nombres para los metadatos: `lamassu.io/iot/{connector_id}`.",{"_2299":49972,"_22571":49908,"_15405":86642,"_5":15294,"_21315":86468,"_1890":39572},[],{"_2299":49973,"_22571":49908,"_15405":86644,"_5":15294,"_21315":86468,"_1890":18572},[],{"_2299":49974,"_22571":49908,"_15405":86646,"_5":15294,"_21315":86468,"_1890":86049},[],{"_2299":49975,"_22571":49908,"_15405":86648,"_5":15294,"_21315":86468,"_1890":86649},[],"Región AWS donde opera el conector.",{"_2299":49976,"_22571":49908,"_15405":86651,"_5":15294,"_21315":86468,"_1890":39582},[],{"_2299":49977,"_22571":49908,"_15405":86653,"_5":15294,"_21315":86468,"_1890":18572},[],{"_2299":49978,"_22571":49908,"_15405":86655,"_5":15294,"_21315":86468,"_1890":86049},[],{"_2299":49979,"_22571":49908,"_15405":86657,"_5":15294,"_21315":86468,"_1890":86658},[],"Método de autenticación: `static`, `role` o vacío (cadena de credenciales por defecto del SDK).",{"_2299":49980,"_22571":49908,"_15405":86660,"_5":15294,"_21315":86468,"_1890":39592},[],{"_2299":49981,"_22571":49908,"_15405":86662,"_5":15294,"_21315":86468,"_1890":18572},[],{"_2299":49982,"_22571":49908,"_15405":86664,"_5":15294,"_21315":86468,"_1890":86665},[],"Solo con `auth_method=static`",{"_2299":49983,"_22571":49908,"_15405":86667,"_5":15294,"_21315":86468,"_1890":86668},[],"Clave de acceso AWS.",{"_2299":49984,"_22571":49908,"_15405":86670,"_5":15294,"_21315":86468,"_1890":39603},[],{"_2299":49985,"_22571":49908,"_15405":86672,"_5":15294,"_21315":86468,"_1890":18572},[],{"_2299":49986,"_22571":49908,"_15405":86674,"_5":15294,"_21315":86468,"_1890":86665},[],{"_2299":49987,"_22571":49908,"_15405":86676,"_5":15294,"_21315":86468,"_1890":86677},[],"Clave secreta AWS.",{"_2299":49988,"_22571":49908,"_15405":86679,"_5":15294,"_21315":86468,"_1890":39613},[],{"_2299":49989,"_22571":49908,"_15405":86681,"_5":15294,"_21315":86468,"_1890":18572},[],{"_2299":49990,"_22571":49908,"_15405":86683,"_5":15294,"_21315":86468,"_1890":39618},[],{"_2299":49991,"_22571":49908,"_15405":86685,"_5":15294,"_21315":86468,"_1890":86686},[],"Token de sesión (con `auth_method=static`).",{"_2299":49992,"_22571":49908,"_15405":86688,"_5":15294,"_21315":86468,"_1890":39624},[],{"_2299":49993,"_22571":49908,"_15405":86690,"_5":15294,"_21315":86468,"_1890":18572},[],{"_2299":49994,"_22571":49908,"_15405":86692,"_5":15294,"_21315":86468,"_1890":86693},[],"Solo con `auth_method=role`",{"_2299":49995,"_22571":49908,"_15405":86695,"_5":15294,"_21315":86468,"_1890":86696},[],"ARN del rol a asumir.",{"_2299":49996,"_22571":49908,"_15405":86698,"_5":15294,"_21315":86468,"_1890":39635},[],{"_2299":49997,"_22571":49908,"_15405":86700,"_5":15294,"_21315":86468,"_1890":18572},[],{"_2299":49998,"_22571":49908,"_15405":86702,"_5":15294,"_21315":86468,"_1890":39618},[],{"_2299":49999,"_22571":49908,"_15405":86704,"_5":15294,"_21315":86468,"_1890":86705},[],"URL alternativa para todos los servicios AWS (útil con LocalStack en pruebas).",{"_2299":50000,"_22571":49908,"_15405":86707,"_5":15294,"_21315":86468,"_1890":39645},[],{"_2299":50001,"_22571":49908,"_15405":86709,"_5":15294,"_21315":86468,"_1890":63308},[],{"_2299":50002,"_22571":49908,"_15405":86711,"_5":15294,"_21315":86468,"_1890":86049},[],{"_2299":50003,"_22571":49908,"_15405":86713,"_5":15294,"_21315":86468,"_1890":86714},[],"Configuración del bus de eventos al que se suscribe el conector (AMQP o AWS SQS/SNS).",{"_2299":50004,"_22571":49908,"_15405":86716,"_5":15294,"_21315":86468,"_1890":39655},[],{"_2299":50005,"_22571":49908,"_15405":86718,"_5":15294,"_21315":86468,"_1890":18572},[],{"_2299":50006,"_22571":49908,"_15405":86720,"_5":15294,"_21315":86468,"_1890":86049},[],{"_2299":50007,"_22571":49908,"_15405":86722,"_5":15294,"_21315":86468,"_1890":86723},[],"URL HTTP del servicio DMS Manager de Lamassu.",{"_2299":50008,"_22571":49908,"_15405":86725,"_5":15294,"_21315":86468,"_1890":39665},[],{"_2299":50009,"_22571":49908,"_15405":86727,"_5":15294,"_21315":86468,"_1890":18572},[],{"_2299":50010,"_22571":49908,"_15405":86729,"_5":15294,"_21315":86468,"_1890":86049},[],{"_2299":50011,"_22571":49908,"_15405":86731,"_5":15294,"_21315":86468,"_1890":86732},[],"URL HTTP del Device Manager de Lamassu.",{"_2299":50012,"_22571":49908,"_15405":86734,"_5":15294,"_21315":86468,"_1890":39675},[],{"_2299":50013,"_22571":49908,"_15405":86736,"_5":15294,"_21315":86468,"_1890":18572},[],{"_2299":50014,"_22571":49908,"_15405":86738,"_5":15294,"_21315":86468,"_1890":86049},[],{"_2299":50015,"_22571":49908,"_15405":86740,"_5":15294,"_21315":86468,"_1890":86741},[],"URL HTTP del servicio de CA de Lamassu.",{"_2299":50016,"_22571":49908,"_15405":86743,"_5":15294,"_21315":86472,"_1890":86744},[],"Para que los dispositivos puedan autenticarse en AWS IoT Core con certificados emitidos por una CA de Lamassu, esa CA debe registrarse previamente en la cuenta AWS. El conector gestiona este registro de forma automática en respuesta a los eventos `EventCreateCAKey`, `EventImportCAKey` y `EventUpdateCAMetadataKey`, pero la operación **solo se dispara cuando el administrador la solicita explícitamente** mediante el campo de metadatos de la CA.",{"_2299":50017,"_22571":49908,"_15405":86746,"_5":15294,"_21315":86476,"_1890":86747},[],"El registro se desencadena estableciendo el valor `registration.status = \"REQUESTED\"` en la clave `lamassu.io/iot/{connector_id}` de los metadatos de la CA. Esto puede hacerse desde la consola de Lamassu en la sección de gestión de la CA o mediante la API.",{"_2299":50018,"_22571":49908,"_15405":86749,"_5":15294,"_21315":86476,"_1890":86750},[],"Una vez recibido el evento, el conector intenta registrar la CA en AWS y actualiza el campo `registration.status` en los metadatos de la CA con el resultado: `\"SUCCEEDED\"` si el registro fue correcto, o `\"FAILED\"` acompañado de un mensaje de error en caso contrario. El proceso es asíncrono, por lo que es necesario consultar periódicamente el estado de los metadatos hasta que la operación concluya.",{"_2299":50019,"_22571":49908,"_15405":86752,"_5":15294,"_21315":86480,"_1890":86753},[],"Cuando el parámetro `primary_account` es `true`, el conector ejecuta el flujo completo de registro con verificación de posesión de clave privada:",{"_2299":50020,"_22571":49908,"_15405":86755,"_5":15294,"_21315":86480,"_1890":86756},[],"Llama a `iot:GetRegistrationCode` para obtener el código de verificación de AWS.",{"_2299":50021,"_22571":49908,"_15405":86758,"_5":15294,"_21315":86480,"_1890":86759},[],"El conector genera internamente un par de claves RSA-2048 efímero y construye un CSR cuyo Common Name es exactamente ese código de registro. A continuación llama al servicio de firma de Lamassu para que la CA registrada emita un certificado de verificación X.509 real firmando ese CSR. La clave privada efímera se usa únicamente para este propósito y no se almacena ni se envía a AWS.",{"_2299":50022,"_22571":49908,"_15405":86761,"_5":15294,"_21315":86480,"_1890":86762},[],"Envía a AWS la CA (en PEM) y el certificado de verificación mediante `iot:RegisterCACertificate`, activando el registro con `AllowAutoRegistration: true`.",{"_2299":50023,"_22571":49908,"_15405":86764,"_5":15294,"_21315":86480,"_1890":86765},[],"Solo una cuenta puede ser propietaria de una CA en una región AWS dada. Si la CA ya está registrada con el mismo número de serie, el conector omite el paso silenciosamente.",{"_2299":50024,"_22571":49908,"_15405":86767,"_5":15294,"_21315":86480,"_1890":86768},[],"Los tags que AWS IoT Core aplica al certificado de CA registrado son `LMS.CA.ID`, `LMS.CA.SN` y `LMS.CA.CN`.",{"_2299":50025,"_22571":49908,"_15405":86770,"_5":15294,"_21315":86483,"_1890":86771},[],"Cuando `primary_account` es `false`, el conector registra la CA usando el modo `CertificateMode: SNI_ONLY`. Este modo no requiere código de verificación ni acceso a la clave privada de la CA, por lo que es la opción adecuada cuando la CA se gestiona desde otra cuenta de AWS o cuando el administrador no dispone de la clave privada. Es el método habitual para registrar la misma CA en varias cuentas de AWS simultáneamente.",{"_2299":50026,"_22571":49908,"_15405":86773,"_5":15294,"_21315":86486,"_1890":86774},[],"Cada DMS que participe en la integración con AWS IoT Core debe tener configurada la clave de metadatos `lamassu.io/iot/{connector_id}`. El campo más importante de esa configuración es `registration_mode`, que determina cómo se aprovisionan los dispositivos en AWS.",{"_2299":50027,"_22571":49908,"_15405":86776,"_5":15294,"_21315":86486,"_1890":86777},[],"Existen tres modos de registro, y la elección entre ellos depende de la estrategia de aprovisionamiento de la flota.",{"_2299":50028,"_22571":49908,"_15405":86779,"_5":15294,"_21315":86489,"_1890":86780},[],"En este modo el conector **no crea Things, grupos ni políticas** en AWS IoT Core. Se limita a sincronizar el estado de los certificados (activo, revocado, suspendido) a medida que cambian en Lamassu. Es el modo adecuado cuando el aprovisionamiento de Things en AWS se gestiona por un sistema externo y solo se necesita que Lamassu mantenga el estado de los certificados actualizado.",{"_2299":50029,"_22571":49908,"_15405":86782,"_5":15294,"_21315":86493,"_1890":86783},[],"El modo `auto` delega en Lamassu el aprovisionamiento completo del dispositivo en AWS en el momento del enrolamiento. Cuando el dispositivo completa con éxito su enrolamiento EST y Lamassu emite el evento `EventBindDeviceIdentityKey`, el conector ejecuta automáticamente la siguiente secuencia:",{"_2299":50030,"_22571":49908,"_15405":86785,"_5":15294,"_21315":86493,"_1890":86786},[],"Crea o actualiza las políticas IoT configuradas en el DMS.",{"_2299":50031,"_22571":49908,"_15405":86788,"_5":15294,"_21315":86493,"_1890":86789},[],"Crea el grupo raíz `LAMASSU` en la cuenta AWS (si no existe) y los grupos hijos configurados en el DMS como subgrupos de `LAMASSU`. Si los grupos ya existen, el error `ResourceAlreadyExistsException` se ignora, por lo que la operación es idempotente.",{"_2299":50032,"_22571":49908,"_15405":86791,"_5":15294,"_21315":86493,"_1890":86792},[],"Si el Thing ya existía en AWS IoT Core, el conector itera todos los certificados (principals) actualmente adjuntos a ese Thing y los marca como `REVOKED` en AWS, para garantizar que los certificados anteriores no puedan seguir siendo usados para autenticarse.",{"_2299":50033,"_22571":49908,"_15405":86794,"_5":15294,"_21315":86493,"_1890":86795},[],"Llama a `iot:RegisterThing` con una plantilla de aprovisionamiento de estilo CloudFormation que crea el Thing, registra el certificado del dispositivo (PEM del certificado del dispositivo y del certificado de la CA emisora) y adjunta las políticas configuradas.\nUna vez completado el aprovisionamiento, el conector almacena el ARN del certificado resultante en los metadatos del certificado de Lamassu bajo la clave `lamassu.io/iot/{connector_id}` y marca el dispositivo como `Registered: true` en Device Manager.",{"_2299":50034,"_22571":49908,"_15405":86797,"_5":15294,"_21315":86493,"_1890":86798},[],"**El nombre del Thing en AWS es el Common Name (CN) del certificado del dispositivo.** Esta convención es fundamental para el desarrollador de firmware: el valor `/CN=` que el dispositivo incluye en su CSR al enrolarse se convierte en el ThingName con el que deberá identificarse en todas las operaciones MQTT contra AWS IoT Core.",{"_2299":50035,"_22571":49908,"_15405":86800,"_5":15294,"_21315":86497,"_1890":86801},[],"El modo Just-In-Time Provisioning (JITP) delega el aprovisionamiento en AWS en lugar de hacerlo el conector directamente. Cuando el conector detecta que el DMS está en modo `jitp`, crea una plantilla de aprovisionamiento JITP en AWS IoT Core y la adjunta al certificado de CA registrado. Esta plantilla se crea o actualiza en el momento en que el DMS se crea o actualiza en Lamassu - no en el momento del enrolamiento del dispositivo. A partir de ese momento, cuando un dispositivo con un certificado emitido por esa CA se conecta por primera vez a AWS IoT Core, AWS ejecuta la plantilla automáticamente: crea el Thing, registra el certificado y lo activa.",{"_2299":50036,"_22571":49908,"_15405":86803,"_5":15294,"_21315":86497,"_1890":86804},[],"El nombre del Thing en la plantilla JITP se deriva de `AWS::IoT::Certificate::CommonName`, que corresponde al CN del certificado del dispositivo - la misma convención que el modo `auto`.",{"_2299":50037,"_22571":49908,"_15405":86806,"_5":15294,"_21315":86497,"_1890":86807},[],"Este modo requiere que se configure el campo `jitp_config.provisioning_role_arn` con el ARN de un rol IAM que AWS IoT Core pueda asumir para ejecutar la plantilla. Si no se configura, el conector utiliza el valor por defecto `arn:aws:iam::{account}:role/JITPRole` y registra un aviso en el log. El administrador debe asegurarse de que ese rol existe en la cuenta y tiene los permisos necesarios antes de activar el modo JITP.",{"_2299":50038,"_22571":49908,"_15405":86809,"_5":15294,"_21315":86501,"_1890":86810},[],"Para el desarrollador de firmware, el modo `auto` es transparente: el dispositivo realiza su enrolamiento EST de la forma habitual y, como efecto secundario, queda aprovisionado en AWS IoT Core sin ningún paso adicional.",{"_2299":50039,"_22571":49908,"_15405":86812,"_5":15294,"_21315":86501,"_1890":86813},[],"El flujo completo desde el punto de vista del dispositivo es el siguiente:",{"_2299":50040,"_22571":49908,"_15405":86815,"_5":15294,"_21315":86501,"_1890":86816},[],"Una vez que el conector completa el aprovisionamiento, el dispositivo puede conectarse al endpoint AWS IoT Core de MQTT usando su clave privada y el certificado emitido por Lamassu. El ThingName con el que debe identificarse en AWS es exactamente el CN del certificado.",{"_2299":50041,"_22571":49908,"_15405":86818,"_5":15294,"_21315":86505,"_1890":86819},[],"En el modo JITP el dispositivo también realiza su enrolamiento EST de forma convencional y obtiene su certificado de Lamassu. La diferencia es que AWS IoT Core no conoce al dispositivo hasta que este intenta conectarse por primera vez.",{"_2299":50042,"_22571":49908,"_15405":86821,"_5":15294,"_21315":86505,"_1890":86822},[],"Cuando el dispositivo establece su primera conexión MQTT a AWS IoT Core presentando el certificado emitido por Lamassu, AWS detecta que el certificado pertenece a una CA registrada con una plantilla JITP, ejecuta esa plantilla y crea el Thing automáticamente. La conexión inicial puede fallar o demorarse mientras se ejecuta la plantilla; el firmware debe estar preparado para reintentar la conexión.",{"_2299":50043,"_22571":49908,"_15405":86824,"_5":15294,"_21315":86505,"_1890":86825},[],"Para que el flujo JITP funcione correctamente:",{"_2299":50044,"_22571":49908,"_15405":86827,"_5":15294,"_21315":86505,"_1890":86828},[],"La CA debe estar registrada en AWS en modo Primary Account (el modo SNI-only no admite JITP).",{"_2299":50045,"_22571":49908,"_15405":86830,"_5":15294,"_21315":86505,"_1890":86831},[],"El rol IAM configurado en `jitp_config.provisioning_role_arn` debe existir y tener permisos para crear Things, registrar certificados y adjuntar políticas en la cuenta AWS.",{"_2299":50046,"_22571":49908,"_15405":86833,"_5":15294,"_21315":86505,"_1890":86834},[],"El dispositivo debe presentar tanto su certificado como el certificado de la CA emisora en el handshake TLS con AWS IoT Core.",{"_2299":50047,"_22571":49908,"_15405":86836,"_5":15294,"_21315":86505,"_1890":86837},[],"Los certificados aprovisionados mediante JITP **no tienen asociada la clave de metadatos del conector** (`lamassu.io/iot/{connector_id}`) en Lamassu. Como consecuencia, los cambios de estado de esos certificados en Lamassu no se sincronizan automáticamente con AWS a través del mecanismo de sincronización de estado descrito en la siguiente sección.",{"_2299":50048,"_22571":49908,"_15405":86839,"_5":15294,"_21315":86509,"_1890":86840},[],"El conector escucha el evento `EventUpdateCertificateStatusKey` y, cuando un certificado que tiene la clave de metadatos del conector cambia de estado en Lamassu, replica ese cambio en AWS IoT Core. La tabla siguiente muestra la correspondencia de estados:",{"_2299":50049,"_22571":49908,"_15405":86842,"_5":15294,"_21315":86509,"_1890":86843},[],"Estado en Lamassu",{"_2299":50050,"_22571":49908,"_15405":86845,"_5":15294,"_21315":86509,"_1890":86846},[],"Razón de revocación",{"_2299":50051,"_22571":49908,"_15405":86848,"_5":15294,"_21315":86509,"_1890":86849},[],"Estado en AWS IoT Core",{"_2299":50052,"_22571":49908,"_15405":86851,"_5":15294,"_21315":86509,"_1890":39796},[],{"_2299":50053,"_22571":49908,"_15405":86853,"_5":15294,"_21315":86509,"_1890":86086},[],{"_2299":50054,"_22571":49908,"_15405":86855,"_5":15294,"_21315":86509,"_1890":39801},[],{"_2299":50055,"_22571":49908,"_15405":86857,"_5":15294,"_21315":86509,"_1890":39804},[],{"_2299":50056,"_22571":49908,"_15405":86859,"_5":15294,"_21315":86509,"_1890":39807},[],{"_2299":50057,"_22571":49908,"_15405":86861,"_5":15294,"_21315":86509,"_1890":39810},[],{"_2299":50058,"_22571":49908,"_15405":86863,"_5":15294,"_21315":86509,"_1890":39804},[],{"_2299":50059,"_22571":49908,"_15405":86865,"_5":15294,"_21315":86509,"_1890":86866},[],"Cualquier otra razón",{"_2299":50060,"_22571":49908,"_15405":86868,"_5":15294,"_21315":86509,"_1890":39818},[],{"_2299":50061,"_22571":49908,"_15405":86870,"_5":15294,"_21315":86509,"_1890":86871},[],"Solo los estados `Active` y `Revoked` producen una llamada a `iot:UpdateCertificate`. Los demás estados del ciclo de vida de Lamassu (`RenewalWindow`, `AboutToExpire`, `Expired`) no se sincronizan con AWS IoT Core; el estado del certificado en AWS permanece sin cambios hasta que el estado en Lamassu sea `Active` o `Revoked`.",{"_2299":50062,"_22571":49908,"_15405":86873,"_5":15294,"_21315":86513,"_1890":86874},[],"Cuando el conector marca un certificado como `REVOKED` o `INACTIVE` en AWS, ejecuta adicionalmente una desconexión forzada del dispositivo. Para ello abre una conexión MQTT sobre WebSocket (con autenticación SigV4 con las credenciales del conector) al endpoint de datos de AWS IoT Core, usando el CN del certificado como identificador de cliente MQTT, y la cierra inmediatamente. Esto termina cualquier sesión MQTT activa que el dispositivo pueda tener en ese momento.",{"_2299":50063,"_22571":49908,"_15405":86876,"_5":15294,"_21315":86513,"_1890":86877},[],"Esta desconexión forzada se produce en el momento en que Lamassu registra el cambio de estado. Si el dispositivo vuelve a intentar conectarse tras la desconexión, AWS IoT Core rechazará la conexión porque el certificado ya figura como `REVOKED` o `INACTIVE`.",{"_2299":50064,"_22571":49908,"_15405":86879,"_5":15294,"_21315":86513,"_1890":86880},[],"Los certificados aprovisionados en modo JITP no disponen de esta sincronización automática, ya que no tienen la clave de metadatos del conector.",{"_2299":50065,"_22571":49908,"_15405":86882,"_5":15294,"_21315":86517,"_1890":86883},[],"El conector puede escribir en el Device Shadow de AWS IoT Core para enviar señales de acción al firmware del dispositivo. Esta funcionalidad se activa por DMS mediante `shadow_config.enable: true`.",{"_2299":50066,"_22571":49908,"_15405":86885,"_5":15294,"_21315":86517,"_1890":86886},[],"Si `shadow_config.shadow_name` contiene un valor, el conector usa un Named Shadow con ese nombre; en caso contrario, usa el Classic Shadow (shadow predeterminado del Thing).",{"_2299":50067,"_22571":49908,"_15405":86888,"_5":15294,"_21315":86521,"_1890":86889},[],"El conector escribe en el campo `desired.identity_actions` del documento shadow. Cada entrada contiene un timestamp Unix en milisegundos. El firmware del dispositivo debe leer este campo y actuar en consecuencia.",{"_2299":50068,"_22571":49908,"_15405":86891,"_5":15294,"_21315":86521,"_1890":86892},[],"Existen dos tipos de acciones:",{"_2299":50069,"_22571":49908,"_15405":86894,"_5":15294,"_21315":86521,"_1890":86895},[],"**`UPDATE_CERTIFICATE`**: se escribe cuando la ventana de renovación preventiva de un certificado se activa - es decir, cuando el campo `triggered` de la delta de renovación preventiva pasa de `false` a `true`. Esta acción indica al dispositivo que debe iniciar el proceso de re-enrolamiento para renovar su certificado antes de que expire.",{"_2299":50070,"_22571":49908,"_15405":86897,"_5":15294,"_21315":86521,"_1890":86898},[],"**`UPDATE_TRUST_ANCHOR_LIST`**: se escribe en todos los dispositivos de un DMS cuando la lista `ManagedCAs` del DMS cambia. Esta acción indica al dispositivo que debe actualizar su almacén de CAs de confianza.",{"_2299":50071,"_22571":49908,"_15405":86900,"_5":15294,"_21315":86521,"_1890":86901},[],"El proceso de escritura en el shadow consiste en leer el shadow actual (`iotdata:GetThingShadow`), combinar las nuevas acciones con las existentes y escribir el resultado (`iotdata:UpdateThingShadow`). Si el shadow no existe, el conector lo crea. Tras una escritura correcta, la lista de acciones pendientes en los metadatos del dispositivo en Lamassu se limpia.",{"_2299":50072,"_22571":49908,"_15405":86903,"_5":15294,"_21315":86525,"_1890":86904},[],"El conector crea y adjunta las políticas que se configuran en el DMS. Una política típica para un dispositivo que usa MQTT y Device Shadow tiene la siguiente estructura:",{"_2299":50073,"_22571":49908,"_15405":86906,"_5":15294,"_21315":86525,"_1890":86907},[],"En la política anterior, los marcadores `<AWS_REGION>` y `<AWS_ACCOUNT_ID>` deben reemplazarse por la región AWS y el identificador de cuenta de doce dígitos de la cuenta destino antes de aplicar la política. La variable `${iot:Connection.Thing.ThingName}` limita automáticamente cada permiso al Thing al que el dispositivo está conectado, siguiendo el principio de mínimo privilegio. La variable `${ShadowName}` en los ARN de shadow es un marcador que debe reemplazarse con el valor de `shadow_config.shadow_name` configurado en el DMS; si se usa el Classic Shadow, se puede simplificar eliminando el segmento `name/${ShadowName}/`. Las políticas de AWS IoT no admiten expresiones regulares con alternancia; la notación `[name/${ShadowName}/]*` representa la opcionalidad del segmento dentro de las restricciones de la sintaxis de ARN.",{"_2299":50074,"_22571":49908,"_15405":86909,"_5":15294,"_21315":86525,"_1890":86910},[],"El primer statement permite que el dispositivo se conecte usando su ThingName como identificador MQTT. El segundo autoriza la publicación en el topic MQTT genérico del Thing y en los topics del shadow, necesario para que el dispositivo pueda actualizar el estado reportado. Los dos últimos statements otorgan permisos de suscripción y recepción sobre los mismos topics, lo que permite al dispositivo recibir actualizaciones del shadow (por ejemplo, las acciones `UPDATE_CERTIFICATE` y `UPDATE_TRUST_ANCHOR_LIST` escritas por el conector).",{"_2299":50075,"_22571":49908,"_15405":86912,"_5":15294,"_21315":86529,"_1890":86913},[],"**Síntoma:** El registro de la CA permanece indefinidamente en estado `REQUESTED`.",{"_2299":50076,"_22571":49908,"_15405":86915,"_5":15294,"_21315":86529,"_1890":86916},[],"**Causa:** El conector no está en ejecución o no está suscrito al bus de eventos. También puede indicar credenciales IAM incorrectas, permisos insuficientes o que la clave de metadatos se escribió con un `connector_id` incorrecto.",{"_2299":50077,"_22571":49908,"_15405":86918,"_5":15294,"_21315":86529,"_1890":86919},[],"**Resolución:** Verificar que el proceso del conector está activo y que los logs no muestran errores de comunicación con AWS. Comprobar que el campo de metadatos se escribió bajo la clave exacta `lamassu.io/iot/{connector_id}`. Si el error persiste, el conector actualizará el estado a `FAILED` con un mensaje descriptivo en los metadatos de la CA.",{"_2299":50078,"_22571":49908,"_15405":86921,"_5":15294,"_21315":86529,"_1890":86922},[],"**Síntoma:** El estado de un certificado no se sincroniza con AWS tras una revocación.",{"_2299":50079,"_22571":49908,"_15405":86924,"_5":15294,"_21315":86529,"_1890":86925},[],"**Causa:** Lo más habitual es que el certificado fue aprovisionado en modo JITP. Los certificados JITP no tienen la clave de metadatos del conector y quedan fuera del mecanismo de sincronización de estado. Si el DMS está en modo `auto`, puede indicar que el aprovisionamiento inicial no completó correctamente y el ARN de AWS no se almacenó en los metadatos del certificado.",{"_2299":50080,"_22571":49908,"_15405":86927,"_5":15294,"_21315":86529,"_1890":86928},[],"**Resolución:** Para certificados JITP, migrar el DMS a modo `auto` y re-aprovisionar los dispositivos afectados. Para certificados en modo `auto`, verificar que el certificado tiene el ARN de AWS almacenado en sus metadatos; si no lo tiene, repetir el aprovisionamiento.",{"_2299":50081,"_22571":49908,"_15405":86930,"_5":15294,"_21315":86529,"_1890":86931},[],"**Síntoma:** La desconexión forzada no termina la sesión MQTT del dispositivo tras la revocación.",{"_2299":50082,"_22571":49908,"_15405":86933,"_5":15294,"_21315":86529,"_1890":86934},[],"**Causa:** El dispositivo usa un client ID MQTT diferente al CN del certificado. La desconexión forzada abre una conexión usando el CN como client ID; si el firmware usa otro identificador, la desconexión no afecta a esa sesión.",{"_2299":50083,"_22571":49908,"_15405":86936,"_5":15294,"_21315":86529,"_1890":86937},[],"**Resolución:** Asegurarse de que el firmware usa exactamente el CN del certificado como identificador de cliente MQTT. Ese CN coincide con el ThingName en AWS IoT Core.",{"_2299":50084,"_22571":49908,"_15405":86939,"_5":15294,"_21315":86529,"_1890":86940},[],"**Síntoma:** El dispositivo recibe `CLIENT_ID_REJECTED` al conectarse a AWS IoT Core.",{"_2299":50085,"_22571":49908,"_15405":86942,"_5":15294,"_21315":86529,"_1890":86943},[],"**Causa:** El client ID MQTT no coincide con el ThingName, que es siempre el CN del certificado emitido por Lamassu.",{"_2299":50086,"_22571":49908,"_15405":86945,"_5":15294,"_21315":86529,"_1890":86946},[],"**Resolución:** Verificar que el firmware usa exactamente el valor del campo CN incluido en el CSR de enrolamiento como identificador de cliente MQTT.",{"_2299":50087,"_22571":49908,"_15405":86948,"_5":15294,"_21315":86529,"_1890":86949},[],"**Síntoma:** La primera conexión MQTT del dispositivo en modo JITP falla o excede el tiempo de espera.",{"_2299":50088,"_22571":49908,"_15405":86951,"_5":15294,"_21315":86529,"_1890":86952},[],"**Causa:** Es el comportamiento esperado mientras AWS ejecuta la plantilla JITP en la primera conexión del dispositivo.",{"_2299":50089,"_22571":49908,"_15405":86954,"_5":15294,"_21315":86529,"_1890":86955},[],"**Resolución:** El firmware debe implementar reintentos con backoff exponencial para la primera conexión. Si el fallo persiste más allá de unos minutos, verificar que el rol IAM configurado en `jitp_config.provisioning_role_arn` existe en la cuenta y tiene permisos para crear Things, registrar certificados y adjuntar políticas.",{"_2299":50090,"_22571":49908,"_15405":86957,"_5":15294,"_21315":86529,"_1890":86958},[],"**Síntoma:** El Device Shadow no se actualiza cuando debería.",{"_2299":50091,"_22571":49908,"_15405":86960,"_5":15294,"_21315":86529,"_1890":86961},[],"**Causa:** La función de shadow está desactivada en la configuración del DMS, las credenciales del conector carecen de permisos sobre la API de datos de IoT, o el firmware lee un shadow diferente al configurado.",{"_2299":50092,"_22571":49908,"_15405":86963,"_5":15294,"_21315":86529,"_1890":86964},[],"**Resolución:** Comprobar que `shadow_config.enable` está a `true` en los metadatos del conector para el DMS correspondiente. Si se usa Named Shadow, verificar que `shadow_config.shadow_name` contiene el nombre correcto y que el firmware lee ese Named Shadow y no el Classic Shadow. Confirmar que las credenciales del conector tienen permisos `iotdata:GetThingShadow` y `iotdata:UpdateThingShadow`.",{"_2299":50093,"_22571":49908,"_15405":86966,"_5":15294,"_21315":86529,"_1890":86967},[],"<Card title=\"Configurar un DMS\" href=\"/docs/platform/pki/device-enrollment\" />",{"_2299":50094,"_22571":49908,"_15405":86969,"_5":15294,"_21315":86529,"_1890":86970},[],"<Card title=\"Enrolamiento de dispositivos (EST)\" href=\"/docs/platform/pki/est-enrollment\" />",{"_2299":50095,"_22571":49908,"_15405":86972,"_5":15294,"_21315":86529,"_1890":86973},[],"<Card title=\"Gestión de certificados\" href=\"/docs/platform/pki/certificates\" />",{"_2299":50096,"_22571":50096,"_5":10616,"_1890":86975,"_22830":86976,"_15405":86977,"_21315":50096},"Claves y motores criptográficos",[35156,83411,83889],[],{"_2299":50097,"_22571":50096,"_15405":86979,"_5":15294,"_21315":50096,"_1890":86980},[],"Genera, importa y opera claves sin acoplar la PKI a un proveedor concreto.",{"_2299":50098,"_22571":50096,"_5":22827,"_15405":86982,"_21315":86983,"_1890":86984},[],"/docs/es/platform/pki/key-management#gestión-de-claves-criptográficas","Gestión de claves criptográficas",{"_2299":50099,"_22571":50096,"_5":22827,"_15405":86986,"_21315":86987,"_1890":86988},[],"/docs/es/platform/pki/key-management#qué-resuelve-el-kms","Qué resuelve el KMS",{"_2299":50100,"_22571":50096,"_5":22827,"_15405":86990,"_21315":86991,"_1890":86992},[],"/docs/es/platform/pki/key-management#motores-criptográficos","Motores criptográficos",{"_2299":50101,"_22571":50096,"_5":22827,"_15405":86994,"_21315":86995,"_1890":39946},[],"/docs/es/platform/pki/key-management#file-system",{"_2299":50102,"_22571":50096,"_5":22827,"_15405":86997,"_21315":86998,"_1890":39950},[],"/docs/es/platform/pki/key-management#hashicorp-vault",{"_2299":50103,"_22571":50096,"_5":22827,"_15405":87000,"_21315":87001,"_1890":39954},[],"/docs/es/platform/pki/key-management#aws-secrets-manager",{"_2299":50104,"_22571":50096,"_5":22827,"_15405":87003,"_21315":87004,"_1890":39958},[],"/docs/es/platform/pki/key-management#aws-kms",{"_2299":50105,"_22571":50096,"_5":22827,"_15405":87006,"_21315":87007,"_1890":39962},[],"/docs/es/platform/pki/key-management#pkcs11",{"_2299":50106,"_22571":50096,"_5":22827,"_15405":87009,"_21315":87010,"_1890":87011},[],"/docs/es/platform/pki/key-management#inventario-de-claves","Inventario de claves",{"_2299":50107,"_22571":50096,"_5":22827,"_15405":87013,"_21315":87014,"_1890":87015},[],"/docs/es/platform/pki/key-management#crear-o-importar-claves","Crear o importar claves",{"_2299":50108,"_22571":50096,"_5":22827,"_15405":87017,"_21315":87018,"_1890":87019},[],"/docs/es/platform/pki/key-management#generar-un-nuevo-par-de-claves","Generar un nuevo par de claves",{"_2299":50109,"_22571":50096,"_5":22827,"_15405":87021,"_21315":87022,"_1890":87023},[],"/docs/es/platform/pki/key-management#importar-un-par-existente","Importar un par existente",{"_2299":50110,"_22571":50096,"_5":22827,"_15405":87025,"_21315":87026,"_1890":87027},[],"/docs/es/platform/pki/key-management#operaciones-sobre-una-clave","Operaciones sobre una clave",{"_2299":50111,"_22571":50096,"_5":22827,"_15405":87029,"_21315":87030,"_1890":87031},[],"/docs/es/platform/pki/key-management#ver-detalles","Ver detalles",{"_2299":50112,"_22571":50096,"_5":22827,"_15405":87033,"_21315":87034,"_1890":87035},[],"/docs/es/platform/pki/key-management#firmar-y-verificar","Firmar y verificar",{"_2299":50113,"_22571":50096,"_5":22827,"_15405":87037,"_21315":87038,"_1890":39994},[],"/docs/es/platform/pki/key-management#sign",{"_2299":50114,"_22571":50096,"_5":22827,"_15405":87040,"_21315":87041,"_1890":39998},[],"/docs/es/platform/pki/key-management#verify",{"_2299":50115,"_22571":50096,"_5":22827,"_15405":87043,"_21315":87044,"_1890":87045},[],"/docs/es/platform/pki/key-management#generar-un-csr","Generar un CSR",{"_2299":50116,"_22571":50096,"_5":22827,"_15405":87047,"_21315":87048,"_1890":87049},[],"/docs/es/platform/pki/key-management#firma-local-con-pkcs11","Firma local con PKCS#11",{"_2299":50117,"_22571":50096,"_15405":87051,"_5":15294,"_21315":86983,"_1890":87052},[],"El servicio de Gestión de Claves Criptográficas (KMS) de Lamassu IoT centraliza la generación, importación, custodia y uso de las claves de la plataforma. Desde aquí se gestionan las claves que soportan a las CAs y al resto de operaciones de firma que dependen de la PKI.",{"_2299":50118,"_22571":50096,"_15405":87054,"_5":15294,"_21315":86983,"_1890":87055},[],"En la configuración actual, Lamassu IoT trabaja exclusivamente con claves asimétricas, como RSA y curvas elípticas. Estas claves se usan para emitir certificados X.509, firmar solicitudes y realizar operaciones de autenticación y validación dentro del sistema.",{"_2299":50119,"_22571":50096,"_15405":87057,"_5":15294,"_21315":86987,"_1890":87058},[],"El KMS unifica la gestión del ciclo de vida de las claves y evita que cada servicio tenga que integrarse directamente con un proveedor criptográfico concreto.",{"_2299":50120,"_22571":50096,"_15405":87060,"_5":15294,"_21315":86987,"_1890":87061},[],"En la práctica, permite:",{"_2299":50121,"_22571":50096,"_15405":87063,"_5":15294,"_21315":86987,"_1890":87064},[],"Generar nuevos pares de claves desde Lamassu IoT.",{"_2299":50122,"_22571":50096,"_15405":87066,"_5":15294,"_21315":86987,"_1890":87067},[],"Importar claves creadas externamente.",{"_2299":50123,"_22571":50096,"_15405":87069,"_5":15294,"_21315":86987,"_1890":87070},[],"Delegar la custodia y las operaciones criptográficas en motores externos.",{"_2299":50124,"_22571":50096,"_15405":87072,"_5":15294,"_21315":86987,"_1890":87073},[],"Reutilizar claves ya existentes para CAs, CSR y tareas de firma o verificación.",{"_2299":50125,"_22571":50096,"_15405":87075,"_5":15294,"_21315":86991,"_1890":87076},[],"Lamassu puede trabajar con distintos motores criptográficos según los requisitos del despliegue. En algunos entornos bastará con un motor software; en otros será necesario delegar la custodia en un HSM, en un servicio cloud o en una plataforma especializada.",{"_2299":50126,"_22571":50096,"_15405":87078,"_5":15294,"_21315":86991,"_1890":87079},[],"Una misma instancia puede tener varios motores configurados al mismo tiempo, incluso varias instancias del mismo tipo. Esto permite adaptar la operación a distintos niveles de seguridad, coste y requisitos regulatorios.",{"_2299":50127,"_22571":50096,"_15405":87081,"_5":15294,"_21315":86991,"_1890":87082},[],"Actualmente, Lamassu soporta cinco tipos de motor. Elige según el nivel de aislamiento que necesites y quién debe poder acceder al material privado.",{"_2299":50128,"_22571":50096,"_15405":87084,"_5":15294,"_21315":86995,"_1890":87085},[],"Genera las claves con las librerías criptográficas de Go y delega su protección en el sistema de archivos. Funciona tanto on-premise como en cloud, pero no evita la extracción de la clave y no está recomendado para producción.",{"_2299":50129,"_22571":50096,"_15405":87087,"_5":15294,"_21315":86998,"_1890":87088},[],"Protege las claves en reposo y puede ejecutarse on-premise o en cloud. Un administrador con permisos suficientes todavía puede visualizar el material privado, por lo que conviene limitar el acceso administrativo y custodiar las claves de *unseal*.",{"_2299":50130,"_22571":50096,"_15405":87090,"_5":15294,"_21315":87001,"_1890":87091},[],"Ofrece persistencia cifrada en AWS con coste asociado. Protege la clave en reposo, pero un administrador autorizado puede recuperarla; no proporciona la misma resistencia a la extracción que un KMS o HSM.",{"_2299":50131,"_22571":50096,"_15405":87093,"_5":15294,"_21315":87004,"_1890":87094},[],"Genera las claves con entropía hardware y no expone la clave privada. Las operaciones se ejecutan dentro del servicio. Aun así, una identidad con permisos suficientes podría utilizar la clave para firmar, por lo que la política IAM sigue siendo crítica.",{"_2299":50132,"_22571":50096,"_15405":87096,"_5":15294,"_21315":87007,"_1890":87097},[],"Permite integrar HSMs locales, entornos aislados y servicios *Key as a Service*. La generación, persistencia y resistencia a la extracción dependen del dispositivo o proveedor concreto. Es la opción más flexible cuando la política exige custodia hardware.",{"_2299":50133,"_22571":50096,"_15405":87099,"_5":15294,"_21315":87007,"_1890":87100},[],"Lamassu muestra en la consola el listado completo de motores habilitados.",{"_2299":50134,"_22571":50096,"_15405":87102,"_5":15294,"_21315":87007,"_1890":87103},[],"Cada motor define qué algoritmos soporta, como RSA o ECC/ECDSA, y qué tamaños de clave puede generar.",{"_2299":50135,"_22571":50096,"_15405":87105,"_5":15294,"_21315":87007,"_1890":87106},[],"Durante el despliegue es obligatorio definir un motor por defecto. Ese motor se utilizará cuando un proceso necesite crear o persistir una clave y el usuario no haya seleccionado uno específico, por ejemplo al crear o importar una CA.",{"_2299":50136,"_22571":50096,"_15405":87108,"_5":15294,"_21315":87010,"_1890":87109},[],"La pantalla principal de KMS muestra el inventario completo de claves registradas en el sistema. Es la vista de referencia para revisar qué claves existen, dónde están custodiadas y con qué entidades están relacionadas.",{"_2299":50137,"_22571":50096,"_15405":87111,"_5":15294,"_21315":87010,"_1890":87112},[],"La tabla incluye los siguientes campos:",{"_2299":50138,"_22571":50096,"_15405":87114,"_5":15294,"_21315":87010,"_1890":87115},[],"**Name**: nombre descriptivo de la clave.",{"_2299":50139,"_22571":50096,"_15405":87117,"_5":15294,"_21315":87010,"_1890":87118},[],"**Type**: algoritmo y tamaño de clave, por ejemplo RSA 2048 o EC P-256.",{"_2299":50140,"_22571":50096,"_15405":87120,"_5":15294,"_21315":87010,"_1890":87121},[],"**Strength**: indicador visual de fortaleza criptográfica.",{"_2299":50141,"_22571":50096,"_15405":87123,"_5":15294,"_21315":87010,"_1890":87124},[],"**Public/Private**: indica si Lamassu gestiona el par completo o solo la clave pública.",{"_2299":50142,"_22571":50096,"_15405":87126,"_5":15294,"_21315":87010,"_1890":87127},[],"**Crypto Engine**: motor criptográfico que custodia la clave.",{"_2299":50143,"_22571":50096,"_15405":87129,"_5":15294,"_21315":87010,"_1890":87130},[],"**Aliases**: nombres alternativos asociados a la clave.",{"_2299":50144,"_22571":50096,"_15405":87132,"_5":15294,"_21315":87010,"_1890":87133},[],"**Tags**: etiquetas para clasificación y búsqueda.",{"_2299":50145,"_22571":50096,"_15405":87135,"_5":15294,"_21315":87010,"_1890":87136},[],"**Related Entities**: certificados u otras entidades vinculadas a esa clave.",{"_2299":50146,"_22571":50096,"_15405":87138,"_5":15294,"_21315":87010,"_1890":87139},[],"Desde esta vista también se accede a las acciones más habituales:",{"_2299":50147,"_22571":50096,"_15405":87141,"_5":15294,"_21315":87010,"_1890":87142},[],"**View Details** para consultar metadatos, identificadores y relaciones.",{"_2299":50148,"_22571":50096,"_15405":87144,"_5":15294,"_21315":87010,"_1890":87145},[],"**Generate CSR** para crear una solicitud PKCS#10 con la clave seleccionada.",{"_2299":50149,"_22571":50096,"_15405":87147,"_5":15294,"_21315":87010,"_1890":87148},[],"**Sign / Verify** para probar operaciones criptográficas sobre la clave.",{"_2299":50150,"_22571":50096,"_15405":87150,"_5":15294,"_21315":87010,"_1890":87151},[],"**Delete Key** para eliminar la clave del sistema.",{"_2299":50151,"_22571":50096,"_15405":87153,"_5":15294,"_21315":87014,"_1890":87154},[],"El alta de claves se realiza desde el asistente que se abre con **Create New Key**.",{"_2299":50152,"_22571":50096,"_15405":87156,"_5":15294,"_21315":87018,"_1890":87157},[],"Si la clave va a nacer dentro de Lamassu, el flujo recomendado es generar un nuevo par gestionado directamente por uno de los motores configurados.",{"_2299":50153,"_22571":50096,"_15405":87159,"_5":15294,"_21315":87018,"_1890":87160},[],"En la primera pantalla del asistente, elija **Generate New Key Pair** y después defina los parámetros principales:",{"_2299":50154,"_22571":50096,"_15405":87162,"_5":15294,"_21315":87018,"_1890":87163},[],"**Key Name**: nombre único y descriptivo.",{"_2299":50155,"_22571":50096,"_15405":87165,"_5":15294,"_21315":87018,"_1890":87166},[],"**Crypto Engine**: motor que custodiará la clave.",{"_2299":50156,"_22571":50096,"_15405":87168,"_5":15294,"_21315":87018,"_1890":87169},[],"**Key Type** y **Key Size**: algoritmo y tamaño o curva.",{"_2299":50157,"_22571":50096,"_15405":87171,"_5":15294,"_21315":87018,"_1890":87172},[],"**Tags**: metadatos para clasificar la clave.",{"_2299":50158,"_22571":50096,"_15405":87174,"_5":15294,"_21315":87018,"_1890":87175},[],"**Metadata**: información adicional para usos avanzados.",{"_2299":50159,"_22571":50096,"_15405":87177,"_5":15294,"_21315":87022,"_1890":87178},[],"La importación permite registrar en Lamassu una clave generada fuera de la plataforma. Es el flujo habitual en escenarios BYOK, migraciones o integración con material criptográfico que ya está en producción.",{"_2299":50160,"_22571":50096,"_15405":87180,"_5":15294,"_21315":87022,"_1890":87181},[],"Cuando la clave se ha generado en un entorno aislado o en un HSM externo.",{"_2299":50161,"_22571":50096,"_15405":87183,"_5":15294,"_21315":87022,"_1890":87184},[],"Cuando se necesita migrar una PKI existente sin reemitir certificados.",{"_2299":50162,"_22571":50096,"_15405":87186,"_5":15294,"_21315":87022,"_1890":87187},[],"Cuando Lamassu debe operar con una raíz de confianza creada por un tercero.",{"_2299":50163,"_22571":50096,"_15405":87189,"_5":15294,"_21315":87022,"_1890":87190},[],"En el asistente, elija **Import Existing Key Pair** y complete los campos solicitados:",{"_2299":50164,"_22571":50096,"_15405":87192,"_5":15294,"_21315":87022,"_1890":87193},[],"**Key Name**: nombre descriptivo dentro de Lamassu IoT.",{"_2299":50165,"_22571":50096,"_15405":87195,"_5":15294,"_21315":87022,"_1890":87196},[],"**Crypto Engine**: motor que custodiará la clave importada.",{"_2299":50166,"_22571":50096,"_15405":87198,"_5":15294,"_21315":87022,"_1890":87199},[],"**Tags**: etiquetas para organización y búsqueda.",{"_2299":50167,"_22571":50096,"_15405":87201,"_5":15294,"_21315":87022,"_1890":87202},[],"**Metadata**: información adicional opcional.",{"_2299":50168,"_22571":50096,"_15405":87204,"_5":15294,"_21315":87022,"_1890":87205},[],"**Private Key (PEM)**: clave privada en formato PEM.",{"_2299":50169,"_22571":50096,"_15405":87207,"_5":15294,"_21315":87022,"_1890":87208},[],"Una vez completado el asistente, la clave queda almacenada en el motor seleccionado y puede utilizarse para firma, generación de CSR y el resto de operaciones soportadas por KMS.",{"_2299":50170,"_22571":50096,"_15405":87210,"_5":15294,"_21315":87026,"_1890":87211},[],"Cada clave registrada dispone de una vista de detalle y de varias acciones operativas.",{"_2299":50171,"_22571":50096,"_15405":87213,"_5":15294,"_21315":87030,"_1890":87214},[],"La pantalla **View Details** concentra la información técnica y administrativa de la clave.",{"_2299":50172,"_22571":50096,"_15405":87216,"_5":15294,"_21315":87030,"_1890":87217},[],"En la pestaña **Overview** se muestran, entre otros, estos campos:",{"_2299":50173,"_22571":50096,"_15405":87219,"_5":15294,"_21315":87030,"_1890":87220},[],"**Key Name**: nombre descriptivo.",{"_2299":50174,"_22571":50096,"_15405":87222,"_5":15294,"_21315":87030,"_1890":87223},[],"**Key Identifier**: identificador único del sistema. Lamassu utiliza formatos de ID basados en PKCS11.",{"_2299":50175,"_22571":50096,"_15405":87225,"_5":15294,"_21315":87030,"_1890":87226},[],"**Tags**: etiquetas asociadas.",{"_2299":50176,"_22571":50096,"_15405":87228,"_5":15294,"_21315":87030,"_1890":87229},[],"**Aliases**: nombres alternativos.",{"_2299":50177,"_22571":50096,"_15405":87231,"_5":15294,"_21315":87030,"_1890":87232},[],"**Crypto Engine**: motor en el que reside la clave.",{"_2299":50178,"_22571":50096,"_15405":87234,"_5":15294,"_21315":87030,"_1890":87235},[],"**Algorithm, Key Size & Strength**: algoritmo, parámetros y nivel de fortaleza.",{"_2299":50179,"_22571":50096,"_15405":87237,"_5":15294,"_21315":87030,"_1890":87238},[],"La sección **Related Entities** muestra qué objetos de Lamassu dependen de esa clave.",{"_2299":50180,"_22571":50096,"_15405":87240,"_5":15294,"_21315":87030,"_1890":87241},[],"La pestaña **Public Key** presenta la clave pública en formato PEM, lista para consulta o copia.",{"_2299":50181,"_22571":50096,"_15405":87243,"_5":15294,"_21315":87034,"_1890":87244},[],"La acción **Sign / Verify** sirve para validar que la clave y el motor criptográfico funcionan correctamente.",{"_2299":50182,"_22571":50096,"_15405":87246,"_5":15294,"_21315":87034,"_1890":87247},[],"Al abrirla aparecen dos áreas: **Sign** y **Verify**.",{"_2299":50183,"_22571":50096,"_15405":87249,"_5":15294,"_21315":87038,"_1890":87250},[],"Esta pestaña usa la clave privada para generar una firma digital sobre un mensaje o sobre un *digest* ya calculado.",{"_2299":50184,"_22571":50096,"_15405":87252,"_5":15294,"_21315":87038,"_1890":87253},[],"Campos principales:",{"_2299":50185,"_22571":50096,"_15405":87255,"_5":15294,"_21315":87038,"_1890":87256},[],"**Algorithm**: algoritmo de firma disponible para el tipo de clave.",{"_2299":50186,"_22571":50096,"_15405":87258,"_5":15294,"_21315":87038,"_1890":87259},[],"**Message Type**: `Raw` para datos en claro o `Digest` para un hash precalculado.",{"_2299":50187,"_22571":50096,"_15405":87261,"_5":15294,"_21315":87038,"_1890":87262},[],"**Payload Encoding**: codificación de entrada, como UTF-8, Hex o Base64.",{"_2299":50188,"_22571":50096,"_15405":87264,"_5":15294,"_21315":87038,"_1890":87265},[],"**Message**: contenido que se va a firmar.",{"_2299":50189,"_22571":50096,"_15405":87267,"_5":15294,"_21315":87038,"_1890":87268},[],"**Signature**: resultado de la operación, mostrado en hexadecimal.",{"_2299":50190,"_22571":50096,"_15405":87270,"_5":15294,"_21315":87041,"_1890":87271},[],"Esta pestaña comprueba si una firma corresponde a la clave pública asociada.",{"_2299":50191,"_22571":50096,"_15405":87273,"_5":15294,"_21315":87041,"_1890":87253},[],{"_2299":50192,"_22571":50096,"_15405":87275,"_5":15294,"_21315":87041,"_1890":87276},[],"**Algorithm**: debe coincidir con el algoritmo usado para la firma.",{"_2299":50193,"_22571":50096,"_15405":87278,"_5":15294,"_21315":87041,"_1890":87279},[],"**Message Type**: `Raw` o `Digest`.",{"_2299":50194,"_22571":50096,"_15405":87281,"_5":15294,"_21315":87041,"_1890":87282},[],"**Payload Encoding**: codificación del mensaje.",{"_2299":50195,"_22571":50096,"_15405":87284,"_5":15294,"_21315":87041,"_1890":87285},[],"**Message**: mensaje original o hash.",{"_2299":50196,"_22571":50096,"_15405":87287,"_5":15294,"_21315":87041,"_1890":87288},[],"**Signature**: firma que se desea comprobar.",{"_2299":50197,"_22571":50096,"_15405":87290,"_5":15294,"_21315":87041,"_1890":87291},[],"**Result**: indicador del resultado de la validación.",{"_2299":50198,"_22571":50096,"_15405":87293,"_5":15294,"_21315":87044,"_1890":87294},[],"La acción **Generate CSR** crea una solicitud PKCS#10 firmada con la clave privada custodiada en Lamassu, sin exponerla fuera del motor criptográfico.",{"_2299":50199,"_22571":50096,"_15405":87296,"_5":15294,"_21315":87044,"_1890":87297},[],"Este flujo es útil para:",{"_2299":50200,"_22571":50096,"_15405":87299,"_5":15294,"_21315":87044,"_1890":87300},[],"Solicitar certificados a una CA externa.",{"_2299":50201,"_22571":50096,"_15405":87302,"_5":15294,"_21315":87044,"_1890":87303},[],"Renovar una identidad manteniendo la misma clave.",{"_2299":50202,"_22571":50096,"_15405":87305,"_5":15294,"_21315":87044,"_1890":87306},[],"Al abrir el formulario se solicitan los datos del sujeto y los atributos principales del certificado:",{"_2299":50203,"_22571":50096,"_15405":87308,"_5":15294,"_21315":87044,"_1890":87309},[],"**Common Name (CN)**: nombre principal de la identidad.",{"_2299":50204,"_22571":50096,"_15405":87311,"_5":15294,"_21315":87044,"_1890":87312},[],"**Organization (O)**: organización o empresa.",{"_2299":50205,"_22571":50096,"_15405":87314,"_5":15294,"_21315":87044,"_1890":87315},[],"**Organizational Unit (OU)**: departamento o unidad.",{"_2299":50206,"_22571":50096,"_15405":87317,"_5":15294,"_21315":87044,"_1890":87318},[],"**Country (C)**: código de país de dos letras.",{"_2299":50207,"_22571":50096,"_15405":87320,"_5":15294,"_21315":87044,"_1890":87321},[],"**State / Province (ST)**: estado o provincia.",{"_2299":50208,"_22571":50096,"_15405":87323,"_5":15294,"_21315":87044,"_1890":87324},[],"**Locality (L)**: ciudad o localidad.",{"_2299":50209,"_22571":50096,"_15405":87326,"_5":15294,"_21315":87044,"_1890":87327},[],"**Email Address**: correo de contacto.",{"_2299":50210,"_22571":50096,"_15405":87329,"_5":15294,"_21315":87044,"_1890":87330},[],"**Subject Alternative Names (SANs)**: nombres o identificadores alternativos, como DNS o IP.",{"_2299":50211,"_22571":50096,"_15405":87332,"_5":15294,"_21315":87044,"_1890":87333},[],"Una vez completado el formulario, Lamassu genera la CSR y la presenta para su descarga o copia.",{"_2299":50212,"_22571":50096,"_15405":87335,"_5":15294,"_21315":87048,"_1890":87336},[],"Lamassu también ofrece una ayuda específica para integraciones locales mediante **Sign locally with OpenSSL & PKCS11 tools**.",{"_2299":50213,"_22571":50096,"_15405":87338,"_5":15294,"_21315":87048,"_1890":87339},[],"Esta opción muestra los pasos necesarios para configurar el entorno local, cargar el módulo PKCS#11 y ejecutar firmas con herramientas como OpenSSL sin extraer la clave privada del entorno custodiado.",{"_2299":50214,"_22571":50214,"_5":10616,"_1890":87341,"_22830":87342,"_15405":87343,"_21315":50214},"Validación online con OCSP",[35156,83411,83889],[],{"_2299":50215,"_22571":50214,"_15405":87345,"_5":15294,"_21315":50214,"_1890":87346},[],"Consulta en tiempo real si un certificado sigue vigente o se ha revocado.",{"_2299":50216,"_22571":50214,"_5":22827,"_15405":87348,"_21315":87349,"_1890":87350},[],"/docs/es/platform/pki/ocsp#servicio-ocsp","Servicio OCSP",{"_2299":50217,"_22571":50214,"_5":22827,"_15405":87352,"_21315":87353,"_1890":87354},[],"/docs/es/platform/pki/ocsp#cómo-funciona-el-respondedor-en-lamassu","Cómo funciona el respondedor en Lamassu",{"_2299":50218,"_22571":50214,"_5":22827,"_15405":87356,"_21315":87357,"_1890":87358},[],"/docs/es/platform/pki/ocsp#enlace-en-los-certificados-emitidos","Enlace en los certificados emitidos",{"_2299":50219,"_22571":50214,"_5":22827,"_15405":87360,"_21315":87361,"_1890":87362},[],"/docs/es/platform/pki/ocsp#endpoints-http","Endpoints HTTP",{"_2299":50220,"_22571":50214,"_5":22827,"_15405":87364,"_21315":87365,"_1890":87366},[],"/docs/es/platform/pki/ocsp#comprobación-desde-la-interfaz","Comprobación desde la interfaz",{"_2299":50221,"_22571":50214,"_5":22827,"_15405":87368,"_21315":87369,"_1890":85377},[],"/docs/es/platform/pki/ocsp#referencias",{"_2299":50222,"_22571":50214,"_15405":87371,"_5":15294,"_21315":87349,"_1890":87372},[],"OCSP (Online Certificate Status Protocol) es el mecanismo que permite a una parte que confía comprobar, en tiempo real, si un certificado concreto está vigente o ha sido revocado. En lugar de descargar una lista completa de certificados revocados, el cliente envía una consulta con el número de serie del certificado y recibe una respuesta firmada con el estado actual.",{"_2299":50223,"_22571":50214,"_15405":87374,"_5":15294,"_21315":87349,"_1890":87375},[],"Lamassu integra un respondedor OCSP propio que atiende estas consultas consultando directamente la base de datos interna de certificados. No se requiere ningún componente externo.",{"_2299":50224,"_22571":50214,"_15405":87377,"_5":15294,"_21315":87353,"_1890":87378},[],"Cuando un cliente solicita el estado de un certificado, el respondedor localiza el certificado por su número de serie y determina su estado según el registro interno:",{"_2299":50225,"_22571":50214,"_15405":87380,"_5":15294,"_21315":87353,"_1890":87381},[],"Si el certificado está activo, la respuesta indica `Good`.",{"_2299":50226,"_22571":50214,"_15405":87383,"_5":15294,"_21315":87353,"_1890":87384},[],"Si el certificado ha sido revocado, la respuesta indica `Revoked` e incluye la marca de tiempo de revocación y el código de razón conforme a RFC 5280.",{"_2299":50227,"_22571":50214,"_15405":87386,"_5":15294,"_21315":87353,"_1890":87387},[],"Si el número de serie no se encuentra o el estado no es reconocible, la respuesta indica `Unknown`.",{"_2299":50228,"_22571":50214,"_15405":87389,"_5":15294,"_21315":87353,"_1890":87390},[],"La respuesta OCSP es firmada por la CA emisora del certificado consultado, utilizando el motor criptográfico asociado a esa CA. Lamassu no utiliza un certificado delegado de firma OCSP: la CA actúa directamente como respondedor.",{"_2299":50229,"_22571":50214,"_15405":87392,"_5":15294,"_21315":87353,"_1890":87393},[],"Cada respuesta tiene una ventana de validez de 24 horas, reflejada en los campos `thisUpdate` y `nextUpdate` de la respuesta. Los clientes que cacheen respuestas deben tener en cuenta esta ventana al determinar durante cuánto tiempo una respuesta sigue siendo válida.",{"_2299":50230,"_22571":50214,"_15405":87395,"_5":15294,"_21315":87357,"_1890":87396},[],"La URL del respondedor OCSP se incorpora automáticamente en la extensión AIA (*Authority Information Access*) de todos los certificados emitidos por Lamassu. Los clientes que verifican certificados pueden leer esta URL directamente del certificado sin necesidad de configuración adicional.",{"_2299":50231,"_22571":50214,"_15405":87398,"_5":15294,"_21315":87361,"_1890":87399},[],"El respondedor acepta los dos formatos definidos en RFC 6960:",{"_2299":50232,"_22571":50214,"_15405":87401,"_5":15294,"_21315":87361,"_1890":87402},[],"`GET /ocsp/{ocsp_request}` incluye la petición OCSP codificada en Base64url dentro de la propia URL.",{"_2299":50233,"_22571":50214,"_15405":87404,"_5":15294,"_21315":87361,"_1890":87405},[],"`POST /ocsp` envía la petición en el cuerpo con `Content-Type: application/ocsp-request`.",{"_2299":50234,"_22571":50214,"_15405":87407,"_5":15294,"_21315":87361,"_1890":87408},[],"Ejemplo de consulta con `curl` mediante POST:",{"_2299":50235,"_22571":50214,"_15405":87410,"_5":15294,"_21315":87361,"_1890":87411},[],"La respuesta tiene `Content-Type: application/ocsp-response` y contiene la respuesta OCSP en formato DER.",{"_2299":50236,"_22571":50214,"_15405":87413,"_5":15294,"_21315":87365,"_1890":87414},[],"Desde la pantalla de certificados de Lamassu es posible lanzar una petición OCSP directamente sobre el certificado seleccionado mediante la acción **OCSP Check**. Esta acción muestra el estado devuelto por el respondedor sin necesidad de herramientas externas.",{"_2299":50237,"_22571":50214,"_15405":87416,"_5":15294,"_21315":87369,"_1890":40374},[],{"_2299":50238,"_22571":50214,"_15405":87418,"_5":15294,"_21315":87369,"_1890":87419},[],"RFC 5280 - *Internet X.509 Public Key Infrastructure Certificate and Certificate Revocation List (CRL) Profile* (razones de revocación, sección 5.3.1)",{"_2299":50239,"_22571":50214,"_15405":87421,"_5":15294,"_21315":87369,"_1890":87422},[],"<Card title=\"Servicio CRL\" href=\"/docs/platform/pki/crl\" />",{"_2299":50240,"_22571":50214,"_15405":87424,"_5":15294,"_21315":87369,"_1890":85465},[],{"_2299":50241,"_22571":50241,"_5":10616,"_1890":87426,"_22830":87427,"_15405":87428,"_21315":50241},"Plataforma Lamassu IoT",[35156,83411],[],{"_2299":50242,"_22571":50241,"_15405":87430,"_5":15294,"_21315":50241,"_1890":87431},[],"Gestiona la PKI y las identidades digitales de tus dispositivos desde una única plataforma.",{"_2299":50243,"_22571":50241,"_5":22827,"_15405":87433,"_21315":87434,"_1890":87435},[],"/docs/es/platform/pki/overview#empieza-aquí","Empieza aquí",{"_2299":50244,"_22571":50241,"_5":22827,"_15405":87437,"_21315":87438,"_1890":87439},[],"/docs/es/platform/pki/overview#capacidades-principales","Capacidades principales",{"_2299":50245,"_22571":50241,"_5":22827,"_15405":87441,"_21315":87442,"_1890":87443},[],"/docs/es/platform/pki/overview#construye-tu-jerarquía-de-confianza","Construye tu jerarquía de confianza",{"_2299":50246,"_22571":50241,"_5":22827,"_15405":87445,"_21315":87446,"_1890":87447},[],"/docs/es/platform/pki/overview#protege-las-claves-criptográficas","Protege las claves criptográficas",{"_2299":50247,"_22571":50241,"_5":22827,"_15405":87449,"_21315":87450,"_1890":87451},[],"/docs/es/platform/pki/overview#emite-y-controla-certificados","Emite y controla certificados",{"_2299":50248,"_22571":50241,"_5":22827,"_15405":87453,"_21315":87454,"_1890":87455},[],"/docs/es/platform/pki/overview#automatiza-identidades-de-dispositivos","Automatiza identidades de dispositivos",{"_2299":50249,"_22571":50241,"_5":22827,"_15405":87457,"_21315":87458,"_1890":87459},[],"/docs/es/platform/pki/overview#publica-el-estado-de-validación","Publica el estado de validación",{"_2299":50250,"_22571":50241,"_5":22827,"_15405":87461,"_21315":87462,"_1890":87463},[],"/docs/es/platform/pki/overview#reacciona-a-los-eventos","Reacciona a los eventos",{"_2299":50251,"_22571":50241,"_5":22827,"_15405":87465,"_21315":87466,"_1890":87467},[],"/docs/es/platform/pki/overview#elige-tu-recorrido","Elige tu recorrido",{"_2299":50252,"_22571":50241,"_5":22827,"_15405":87469,"_21315":87470,"_1890":87471},[],"/docs/es/platform/pki/overview#referencia-operativa","Referencia operativa",{"_2299":50253,"_22571":50241,"_15405":87473,"_5":15294,"_21315":50241,"_1890":87474},[],"Lamassu IoT centraliza la emisión, distribución, renovación y revocación de identidades X.509 para dispositivos conectados. Puedes construir una PKI privada, proteger sus claves y automatizar el enrolamiento de una flota sin perder visibilidad sobre cada certificado.",{"_2299":50254,"_22571":50241,"_15405":87476,"_5":15294,"_21315":87434,"_1890":87477},[],"<Card title=\"Primeros pasos\" description=\"Crea una CA, emite un certificado y registra tu primer dispositivo.\" href=\"/docs/platform/pki/quickstarts/overview\" />",{"_2299":50255,"_22571":50241,"_15405":87479,"_5":15294,"_21315":87434,"_1890":87480},[],"<Card title=\"Cómo funciona Lamassu\" description=\"Construye el modelo mental de autoridades, claves, identidades y validación.\" href=\"/docs/platform/pki/concepts/overview\" />",{"_2299":50256,"_22571":50241,"_15405":87482,"_5":15294,"_21315":87442,"_1890":87483},[],"Crea autoridades raíz e intermedias o importa una PKI existente. Define qué autoridad puede emitir cada identidad y conserva la cadena de confianza completa.",{"_2299":50257,"_22571":50241,"_15405":87485,"_5":15294,"_21315":87446,"_1890":87486},[],"Genera y custodia claves mediante motores software, HSMs PKCS#11 o servicios cloud. Lamassu desacopla las operaciones de la ubicación física de la clave.",{"_2299":50258,"_22571":50241,"_15405":87488,"_5":15294,"_21315":87450,"_1890":87489},[],"Emite certificados desde la consola o a partir de un CSR, consulta su estado y revócalos cuando dejan de ser fiables.",{"_2299":50259,"_22571":50241,"_15405":87491,"_5":15294,"_21315":87454,"_1890":87492},[],"Define políticas de enrolamiento mediante un Device Management Service (DMS) y deja que los dispositivos soliciten o renueven su identidad a través de EST.",{"_2299":50260,"_22571":50241,"_15405":87494,"_5":15294,"_21315":87458,"_1890":87495},[],"Ofrece validación online mediante OCSP y distribuye CRLs para consumidores que necesitan comprobar certificados sin conexión.",{"_2299":50261,"_22571":50241,"_15405":87497,"_5":15294,"_21315":87462,"_1890":87498},[],"Suscríbete a cambios del ciclo de vida y envía notificaciones por correo, Microsoft Teams o webhooks.",{"_2299":50262,"_22571":50241,"_15405":87500,"_5":15294,"_21315":87466,"_1890":87501},[],"<Card title=\"Administro la PKI\" description=\"Configura motores, autoridades, emisión y validación.\" href=\"/docs/platform/pki/key-management\" />",{"_2299":50263,"_22571":50241,"_15405":87503,"_5":15294,"_21315":87466,"_1890":87504},[],"<Card title=\"Integro un dispositivo\" description=\"Configura el DMS y usa EST para obtener una identidad.\" href=\"/docs/platform/pki/device-enrollment\" />",{"_2299":50264,"_22571":50241,"_15405":87506,"_5":15294,"_21315":87466,"_1890":87507},[],"<Card title=\"Opero la plataforma\" description=\"Despliega Lamassu y prepara sus dependencias.\" href=\"/docs/deployment/overview\" />",{"_2299":50265,"_22571":50241,"_15405":87509,"_5":15294,"_21315":87466,"_1890":87510},[],"<Card title=\"Integro otro sistema\" description=\"Conecta Lamassu con AWS IoT Core y otros destinos.\" href=\"/docs/platform/pki/integrations/aws-iot-core\" />",{"_2299":50266,"_22571":50241,"_15405":87512,"_5":15294,"_21315":87470,"_1890":87513},[],"<Card title=\"Perfiles de certificado\" description=\"Convierte la política de emisión en restricciones reutilizables.\" href=\"/docs/platform/pki/certificate-profiles\" />",{"_2299":50267,"_22571":50241,"_15405":87515,"_5":15294,"_21315":87470,"_1890":87516},[],"<Card title=\"Jerarquía y rotación\" description=\"Sustituye certificados o claves de CA sin romper la confianza.\" href=\"/docs/platform/pki/ca-hierarchy-and-rotation\" />",{"_2299":50268,"_22571":50241,"_15405":87518,"_5":15294,"_21315":87470,"_1890":87519},[],"<Card title=\"Control de acceso\" description=\"Configura principales, políticas y el primer administrador.\" href=\"/docs/platform/pki/access-control\" />",{"_2299":50269,"_22571":50241,"_15405":87521,"_5":15294,"_21315":87470,"_1890":87522},[],"<Card title=\"Resolución de problemas\" description=\"Diagnostica Gateway, servicios, emisión y enrolamiento.\" href=\"/docs/platform/pki/troubleshooting\" />",{"_2299":50270,"_22571":50270,"_5":10616,"_1890":87524,"_22830":87525,"_15405":87527,"_21315":50270},"Crea tu primera CA",[35156,83411,87526],"Primeros pasos",[],{"_2299":50271,"_22571":50270,"_15405":87529,"_5":15294,"_21315":50270,"_1890":87530},[],"Crea una autoridad raíz y comprueba que está preparada para emitir certificados.",{"_2299":50272,"_22571":50270,"_5":22827,"_15405":87532,"_21315":87533,"_1890":82322},[],"/docs/es/platform/pki/quickstarts/create-certificate-authority#antes-de-empezar",{"_2299":50273,"_22571":50270,"_5":22827,"_15405":87535,"_21315":87536,"_1890":87537},[],"/docs/es/platform/pki/quickstarts/create-certificate-authority#abre-el-asistente-de-creación","Abre el asistente de creación",{"_2299":50274,"_22571":50270,"_5":22827,"_15405":87539,"_21315":87540,"_1890":87541},[],"/docs/es/platform/pki/quickstarts/create-certificate-authority#selecciona-la-clave","Selecciona la clave",{"_2299":50275,"_22571":50270,"_5":22827,"_15405":87543,"_21315":87544,"_1890":87545},[],"/docs/es/platform/pki/quickstarts/create-certificate-authority#define-la-autoridad","Define la autoridad",{"_2299":50276,"_22571":50270,"_5":22827,"_15405":87547,"_21315":87548,"_1890":87549},[],"/docs/es/platform/pki/quickstarts/create-certificate-authority#revisa-y-crea-la-ca","Revisa y crea la CA",{"_2299":50277,"_22571":50270,"_5":22827,"_15405":87551,"_21315":87552,"_1890":87553},[],"/docs/es/platform/pki/quickstarts/create-certificate-authority#verifica-el-resultado","Verifica el resultado",{"_2299":50278,"_22571":50270,"_5":22827,"_15405":87555,"_21315":87556,"_1890":82346},[],"/docs/es/platform/pki/quickstarts/create-certificate-authority#siguiente-paso",{"_2299":50279,"_22571":50270,"_15405":87558,"_5":15294,"_21315":50270,"_1890":87559},[],"En este quickstart crearás una autoridad de certificación raíz con un nuevo par de claves. Al terminar tendrás una CA activa que podrás usar en el siguiente quickstart.",{"_2299":50280,"_22571":50270,"_15405":87561,"_5":15294,"_21315":87533,"_1890":87562},[],"Acceso a la consola con permisos para gestionar autoridades.",{"_2299":50281,"_22571":50270,"_15405":87564,"_5":15294,"_21315":87533,"_1890":87565},[],"Al menos un motor criptográfico disponible.",{"_2299":50282,"_22571":50270,"_15405":87567,"_5":15294,"_21315":87533,"_1890":87568},[],"Un nombre que identifique el propósito de la CA, por ejemplo `Acme Device Root CA`.",{"_2299":50283,"_22571":50270,"_15405":87570,"_5":15294,"_21315":87533,"_1890":87571},[],"Una CA raíz se autofirma y actúa como ancla de confianza. Para producción suele ser preferible mantener la raíz más protegida y emitir desde una CA intermedia.",{"_2299":50284,"_22571":50270,"_15405":87573,"_5":15294,"_21315":87536,"_1890":87574},[],"En el menú lateral, abre **Certification Authorities** y selecciona **Create New CA**.",{"_2299":50285,"_22571":50270,"_15405":87576,"_5":15294,"_21315":87536,"_1890":87577},[],"Elige crear una CA con un par de claves nuevo. Si ya tienes la clave en el KMS, usa &#x2A;*Create New CA (Existing Key)**.",{"_2299":50286,"_22571":50270,"_15405":87579,"_5":15294,"_21315":87540,"_1890":87580},[],"Elige el motor criptográfico que custodiará la clave y configura el algoritmo. Para una primera CA puedes usar **EC P-384**, siempre que sea compatible con tus consumidores.",{"_2299":50287,"_22571":50270,"_15405":87582,"_5":15294,"_21315":87540,"_1890":87583},[],"La clave privada permanecerá bajo el control del motor seleccionado.",{"_2299":50288,"_22571":50270,"_15405":87585,"_5":15294,"_21315":87544,"_1890":87586},[],"Selecciona **Root CA** y completa:",{"_2299":50289,"_22571":50270,"_15405":87588,"_5":15294,"_21315":87544,"_1890":87589},[],"**CA Name**: un nombre único y reconocible.",{"_2299":50290,"_22571":50270,"_15405":87591,"_5":15294,"_21315":87544,"_1890":87592},[],"**Subject**: al menos la organización y el país que identificarán a la autoridad.",{"_2299":50291,"_22571":50270,"_15405":87594,"_5":15294,"_21315":87544,"_1890":87595},[],"**CA Certificate Expiration**: una validez mayor que la de los certificados que emitirá.",{"_2299":50292,"_22571":50270,"_15405":87597,"_5":15294,"_21315":87544,"_1890":87598},[],"**Default End-Entity Certificate Issuance Expiration**: la validez predeterminada de los certificados finales.",{"_2299":50293,"_22571":50270,"_15405":87600,"_5":15294,"_21315":87544,"_1890":87601},[],"El nombre de la CA se utilizará como `Common Name` del certificado.",{"_2299":50294,"_22571":50270,"_15405":87603,"_5":15294,"_21315":87548,"_1890":87604},[],"Comprueba el algoritmo, el sujeto y las fechas antes de confirmar. Estos valores definen el ancla de confianza y no deberían elegirse como simples datos de prueba en un entorno productivo.",{"_2299":50295,"_22571":50270,"_15405":87606,"_5":15294,"_21315":87552,"_1890":87607},[],"Abre la nueva CA desde el listado. Debe aparecer activa y mostrar su certificado PEM, la fecha de expiración y la pestaña **Issued Certificates**.",{"_2299":50296,"_22571":50270,"_15405":87609,"_5":15294,"_21315":87556,"_1890":87610},[],"Usa la autoridad para emitir tu primer certificado, o consulta la guía completa de autoridades para crear una CA intermedia, importar una CA o definir perfiles avanzados.",{"_2299":50297,"_22571":50297,"_5":10616,"_1890":87612,"_22830":87613,"_15405":87614,"_21315":50297},"Emite tu primer certificado",[35156,83411,87526],[],{"_2299":50298,"_22571":50297,"_15405":87616,"_5":15294,"_21315":50297,"_1890":87617},[],"Emite una identidad X.509 desde la consola y verifica el resultado.",{"_2299":50299,"_22571":50297,"_5":22827,"_15405":87619,"_21315":87620,"_1890":82322},[],"/docs/es/platform/pki/quickstarts/issue-certificate#antes-de-empezar",{"_2299":50300,"_22571":50297,"_5":22827,"_15405":87622,"_21315":87623,"_1890":87624},[],"/docs/es/platform/pki/quickstarts/issue-certificate#inicia-la-emisión","Inicia la emisión",{"_2299":50301,"_22571":50297,"_5":22827,"_15405":87626,"_21315":87627,"_1890":87628},[],"/docs/es/platform/pki/quickstarts/issue-certificate#elige-el-método","Elige el método",{"_2299":50302,"_22571":50297,"_5":22827,"_15405":87630,"_21315":87631,"_1890":87632},[],"/docs/es/platform/pki/quickstarts/issue-certificate#identifica-el-certificado","Identifica el certificado",{"_2299":50303,"_22571":50297,"_5":22827,"_15405":87634,"_21315":87635,"_1890":87636},[],"/docs/es/platform/pki/quickstarts/issue-certificate#configura-clave-y-usos","Configura clave y usos",{"_2299":50304,"_22571":50297,"_5":22827,"_15405":87638,"_21315":87639,"_1890":87640},[],"/docs/es/platform/pki/quickstarts/issue-certificate#emite-y-descarga","Emite y descarga",{"_2299":50305,"_22571":50297,"_5":22827,"_15405":87642,"_21315":87643,"_1890":87553},[],"/docs/es/platform/pki/quickstarts/issue-certificate#verifica-el-resultado",{"_2299":50306,"_22571":50297,"_5":22827,"_15405":87645,"_21315":87646,"_1890":82346},[],"/docs/es/platform/pki/quickstarts/issue-certificate#siguiente-paso",{"_2299":50307,"_22571":50297,"_15405":87648,"_5":15294,"_21315":50297,"_1890":87649},[],"En este quickstart Lamassu generará la clave y el CSR en el navegador, y la CA emitirá el certificado. Al terminar descargarás el certificado y su clave privada.",{"_2299":50308,"_22571":50297,"_15405":87651,"_5":15294,"_21315":87620,"_1890":87652},[],"Una CA activa con permiso para emitir certificados.",{"_2299":50309,"_22571":50297,"_15405":87654,"_5":15294,"_21315":87620,"_1890":87655},[],"Un nombre para la identidad, por ejemplo `device-001.example.internal`.",{"_2299":50310,"_22571":50297,"_15405":87657,"_5":15294,"_21315":87620,"_1890":87658},[],"Un lugar seguro en el que custodiar la clave privada descargada.",{"_2299":50311,"_22571":50297,"_15405":87660,"_5":15294,"_21315":87620,"_1890":87661},[],"En este flujo la clave se genera en el navegador y Lamassu no la almacena. Descárgala y protégela antes de cerrar el resultado de la operación.",{"_2299":50312,"_22571":50297,"_15405":87663,"_5":15294,"_21315":87623,"_1890":87664},[],"Abre la CA creada en el quickstart anterior, entra en **Issued Certificates** y selecciona **Issue New**.",{"_2299":50313,"_22571":50297,"_15405":87666,"_5":15294,"_21315":87627,"_1890":87667},[],"Selecciona **Generate Key & CSR in Browser**. Usa **Upload Existing CSR** cuando la clave privada deba generarse y permanecer en el sistema de destino.",{"_2299":50314,"_22571":50297,"_15405":87669,"_5":15294,"_21315":87631,"_1890":87670},[],"Introduce el `Common Name` y, si corresponde, la organización, unidad organizativa y ubicación. Añade SANs para cada nombre DNS, dirección IP, correo o URI con el que se vaya a validar la identidad.",{"_2299":50315,"_22571":50297,"_15405":87672,"_5":15294,"_21315":87635,"_1890":87673},[],"Elige RSA o ECDSA, define la validez y selecciona los usos de clave. Para una identidad de dispositivo que usa mTLS, habilita **Digital Signature** y **Client Authentication**.",{"_2299":50316,"_22571":50297,"_15405":87675,"_5":15294,"_21315":87635,"_1890":87676},[],"La validez no puede superar la fecha de expiración de la CA emisora.",{"_2299":50317,"_22571":50297,"_15405":87678,"_5":15294,"_21315":87639,"_1890":87679},[],"Confirma la emisión y descarga inmediatamente el certificado y la clave privada en formato PEM.",{"_2299":50318,"_22571":50297,"_15405":87681,"_5":15294,"_21315":87643,"_1890":87682},[],"El certificado debe aparecer en **Issued Certificates** con estado activo. Comprueba su sujeto, SANs, emisor, usos y periodo de validez.",{"_2299":50319,"_22571":50297,"_15405":87684,"_5":15294,"_21315":87646,"_1890":87685},[],"Registra tu primer dispositivo para asociar la identidad a una entidad gestionada, o consulta la gestión de certificados.",{"_2299":50320,"_22571":50320,"_5":10616,"_1890":87526,"_22830":87687,"_15405":87688,"_21315":50320},[35156,83411,87526],[],{"_2299":50321,"_22571":50320,"_15405":87690,"_5":15294,"_21315":50320,"_1890":87691},[],"Obtén un primer resultado con Lamassu y continúa desde una base funcional.",{"_2299":50322,"_22571":50320,"_5":22827,"_15405":87693,"_21315":87694,"_1890":87695},[],"/docs/es/platform/pki/quickstarts/overview#ruta-recomendada","Ruta recomendada",{"_2299":50323,"_22571":50320,"_5":22827,"_15405":87697,"_21315":87698,"_1890":82322},[],"/docs/es/platform/pki/quickstarts/overview#antes-de-empezar",{"_2299":50324,"_22571":50320,"_15405":87700,"_5":15294,"_21315":50320,"_1890":87701},[],"Los quickstarts te llevan desde una instancia preparada hasta una identidad de dispositivo activa. Cada guía produce un resultado verificable y enlaza la explicación detallada cuando necesitas ir más allá.",{"_2299":50325,"_22571":50320,"_15405":87703,"_5":15294,"_21315":87694,"_1890":87704},[],"<Card title=\"1. Crea tu primera CA\" description=\"Establece una raíz de confianza capaz de emitir certificados.\" href=\"/docs/platform/pki/quickstarts/create-certificate-authority\" />",{"_2299":50326,"_22571":50320,"_15405":87706,"_5":15294,"_21315":87694,"_1890":87707},[],"<Card title=\"2. Emite un certificado\" description=\"Crea una identidad X.509 y verifica su contenido.\" href=\"/docs/platform/pki/quickstarts/issue-certificate\" />",{"_2299":50327,"_22571":50320,"_15405":87709,"_5":15294,"_21315":87694,"_1890":87710},[],"<Card title=\"3. Registra un dispositivo\" description=\"Añade un dispositivo y asígnale su primera identidad.\" href=\"/docs/platform/pki/quickstarts/register-device\" />",{"_2299":50328,"_22571":50320,"_15405":87712,"_5":15294,"_21315":87698,"_1890":87713},[],"Necesitas acceso a la consola de Lamassu IoT y permisos para administrar claves, autoridades y dispositivos. La instancia debe tener al menos un motor criptográfico configurado.",{"_2299":50329,"_22571":50320,"_15405":87715,"_5":15294,"_21315":87698,"_1890":87716},[],"Si todavía no tienes una instancia, elige primero un modelo de despliegue.",{"_2299":50330,"_22571":50330,"_5":10616,"_1890":87718,"_22830":87719,"_15405":87720,"_21315":50330},"Registra tu primer dispositivo",[35156,83411,87526],[],{"_2299":50331,"_22571":50330,"_15405":87722,"_5":15294,"_21315":50330,"_1890":87723},[],"Añade un dispositivo a Lamassu y asígnale una identidad activa.",{"_2299":50332,"_22571":50330,"_5":22827,"_15405":87725,"_21315":87726,"_1890":82322},[],"/docs/es/platform/pki/quickstarts/register-device#antes-de-empezar",{"_2299":50333,"_22571":50330,"_5":22827,"_15405":87728,"_21315":87729,"_1890":87730},[],"/docs/es/platform/pki/quickstarts/register-device#registra-el-dispositivo","Registra el dispositivo",{"_2299":50334,"_22571":50330,"_5":22827,"_15405":87732,"_21315":87733,"_1890":87734},[],"/docs/es/platform/pki/quickstarts/register-device#comprueba-el-estado-inicial","Comprueba el estado inicial",{"_2299":50335,"_22571":50330,"_5":22827,"_15405":87736,"_21315":87737,"_1890":87738},[],"/docs/es/platform/pki/quickstarts/register-device#asigna-una-identidad","Asigna una identidad",{"_2299":50336,"_22571":50330,"_5":22827,"_15405":87740,"_21315":87741,"_1890":87742},[],"/docs/es/platform/pki/quickstarts/register-device#verifica-el-dispositivo","Verifica el dispositivo",{"_2299":50337,"_22571":50330,"_5":22827,"_15405":87744,"_21315":87745,"_1890":87746},[],"/docs/es/platform/pki/quickstarts/register-device#automatiza-el-siguiente-dispositivo","Automatiza el siguiente dispositivo",{"_2299":50338,"_22571":50330,"_15405":87748,"_5":15294,"_21315":50330,"_1890":87749},[],"En este quickstart registrarás manualmente un dispositivo y le asignarás su primer certificado. Es el recorrido más corto para entender cómo Lamassu relaciona una entidad física con su historial de identidades.",{"_2299":50339,"_22571":50330,"_15405":87751,"_5":15294,"_21315":87726,"_1890":87752},[],"Un DMS configurado.",{"_2299":50340,"_22571":50330,"_15405":87754,"_5":15294,"_21315":87726,"_1890":87755},[],"Una CA asociada al DMS.",{"_2299":50341,"_22571":50330,"_15405":87757,"_5":15294,"_21315":87726,"_1890":87758},[],"Un identificador único para el dispositivo.",{"_2299":50342,"_22571":50330,"_15405":87760,"_5":15294,"_21315":87729,"_1890":87761},[],"Abre **Managed Devices**, selecciona la acción para registrar un dispositivo y completa:",{"_2299":50343,"_22571":50330,"_15405":87763,"_5":15294,"_21315":87729,"_1890":87764},[],"**Device ID**: identificador único del dispositivo.",{"_2299":50344,"_22571":50330,"_15405":87766,"_5":15294,"_21315":87729,"_1890":87767},[],"**Registration Authority**: DMS que aplicará las políticas de enrolamiento.",{"_2299":50345,"_22571":50330,"_15405":87769,"_5":15294,"_21315":87729,"_1890":87770},[],"**Icon** y **Tags**: clasificación opcional para localizarlo después.",{"_2299":50346,"_22571":50330,"_15405":87772,"_5":15294,"_21315":87733,"_1890":87773},[],"Abre el dispositivo recién creado. Debe aparecer con estado **No Identity**: existe en el inventario, pero todavía no tiene un certificado asociado.",{"_2299":50347,"_22571":50330,"_15405":87775,"_5":15294,"_21315":87737,"_1890":87776},[],"Selecciona **Assign Identity**. Lamassu buscará certificados activos cuyo `Common Name` coincida con el `Device ID`.",{"_2299":50348,"_22571":50330,"_15405":87778,"_5":15294,"_21315":87737,"_1890":87779},[],"Selecciona un certificado existente o usa **Issue New Instead** para emitir uno desde una CA vinculada al DMS.",{"_2299":50349,"_22571":50330,"_15405":87781,"_5":15294,"_21315":87741,"_1890":87782},[],"Tras confirmar, el estado debe cambiar a **Active**. Revisa **Certificate History** para comprobar la identidad asociada y **Device Event Timeline** para ver el evento de asignación.",{"_2299":50350,"_22571":50330,"_15405":87784,"_5":15294,"_21315":87745,"_1890":87785},[],"El registro manual ayuda a entender el modelo, pero una flota debe usar enrolamiento automatizado. Continúa con Device Management Service y la integración EST.",{"_2299":50351,"_22571":50351,"_5":10616,"_1890":87787,"_22830":87788,"_15405":87789,"_21315":50351},"Resolución de problemas",[35156,83411,83412],[],{"_2299":50352,"_22571":50351,"_15405":87791,"_5":15294,"_21315":50351,"_1890":87792},[],"Diagnostica acceso, salud, emisión, enrolamiento y dependencias en un despliegue de Lamassu.",{"_2299":50353,"_22571":50351,"_5":22827,"_15405":87794,"_21315":87795,"_1890":87796},[],"/docs/es/platform/pki/troubleshooting#secuencia-de-diagnóstico","Secuencia de diagnóstico",{"_2299":50354,"_22571":50351,"_5":22827,"_15405":87798,"_21315":87799,"_1890":87800},[],"/docs/es/platform/pki/troubleshooting#reproduce-una-sola-operación","Reproduce una sola operación",{"_2299":50355,"_22571":50351,"_5":22827,"_15405":87802,"_21315":87803,"_1890":87804},[],"/docs/es/platform/pki/troubleshooting#separa-cliente-gateway-y-servicio","Separa cliente, Gateway y servicio",{"_2299":50356,"_22571":50351,"_5":22827,"_15405":87806,"_21315":87807,"_1890":87808},[],"/docs/es/platform/pki/troubleshooting#revisa-el-estado-de-kubernetes","Revisa el estado de Kubernetes",{"_2299":50357,"_22571":50351,"_5":22827,"_15405":87810,"_21315":87811,"_1890":87812},[],"/docs/es/platform/pki/troubleshooting#consulta-el-servicio-afectado","Consulta el servicio afectado",{"_2299":50358,"_22571":50351,"_5":22827,"_15405":87814,"_21315":87815,"_1890":87816},[],"/docs/es/platform/pki/troubleshooting#valida-el-resultado-desde-fuera","Valida el resultado desde fuera",{"_2299":50359,"_22571":50351,"_5":22827,"_15405":87818,"_21315":87819,"_1890":87820},[],"/docs/es/platform/pki/troubleshooting#recogida-mínima-de-evidencias","Recogida mínima de evidencias",{"_2299":50360,"_22571":50351,"_5":22827,"_15405":87822,"_21315":87823,"_1890":87824},[],"/docs/es/platform/pki/troubleshooting#no-puedo-iniciar-sesión","No puedo iniciar sesión",{"_2299":50361,"_22571":50351,"_5":22827,"_15405":87826,"_21315":87827,"_1890":87828},[],"/docs/es/platform/pki/troubleshooting#todo-devuelve-403-o-5xx","Todo devuelve 403 o 5xx",{"_2299":50362,"_22571":50351,"_5":22827,"_15405":87830,"_21315":87831,"_1890":87832},[],"/docs/es/platform/pki/troubleshooting#un-pod-no-está-ready","Un pod no está Ready",{"_2299":50363,"_22571":50351,"_5":22827,"_15405":87834,"_21315":87835,"_1890":87836},[],"/docs/es/platform/pki/troubleshooting#la-emisión-falla","La emisión falla",{"_2299":50364,"_22571":50351,"_5":22827,"_15405":87838,"_21315":87839,"_1890":87840},[],"/docs/es/platform/pki/troubleshooting#el-enrolamiento-est-falla","El enrolamiento EST falla",{"_2299":50365,"_22571":50351,"_5":22827,"_15405":87842,"_21315":87843,"_1890":87844},[],"/docs/es/platform/pki/troubleshooting#ocsp-o-crl-no-reflejan-un-cambio","OCSP o CRL no reflejan un cambio",{"_2299":50366,"_22571":50351,"_5":22827,"_15405":87846,"_21315":87847,"_1890":87848},[],"/docs/es/platform/pki/troubleshooting#los-eventos-no-llegan","Los eventos no llegan",{"_2299":50367,"_22571":50351,"_5":22827,"_15405":87850,"_21315":87851,"_1890":87852},[],"/docs/es/platform/pki/troubleshooting#observabilidad","Observabilidad",{"_2299":50368,"_22571":50351,"_15405":87854,"_5":15294,"_21315":50351,"_1890":87855},[],"Empieza por localizar la capa que falla. Una respuesta del Gateway, un pod no preparado y una emisión rechazada pueden parecer el mismo problema desde la consola, pero requieren evidencias distintas.",{"_2299":50369,"_22571":50351,"_15405":87857,"_5":15294,"_21315":87799,"_1890":87858},[],"Anota hora en UTC, usuario o principal, recurso, endpoint y resultado. Evita repetir una acción destructiva como revocación o eliminación.",{"_2299":50370,"_22571":50351,"_15405":87860,"_5":15294,"_21315":87803,"_1890":87861},[],"Comprueba el código HTTP. Un 401 apunta a autenticación; un 403, a autorización; un 404, a ruta o recurso; un 5xx, al servicio o una dependencia.",{"_2299":50371,"_22571":50351,"_15405":87863,"_5":15294,"_21315":87807,"_1890":87864},[],"Localiza pods no preparados, reinicios, eventos recientes y el estado del release.",{"_2299":50372,"_22571":50351,"_15405":87866,"_5":15294,"_21315":87811,"_1890":87867},[],"Revisa su endpoint /health y sus logs en la misma ventana temporal. Después sigue la dependencia indicada: PostgreSQL, RabbitMQ, proveedor OIDC o motor criptográfico.",{"_2299":50373,"_22571":50351,"_15405":87869,"_5":15294,"_21315":87815,"_1890":87870},[],"Para PKI, comprueba el certificado, la cadena, OCSP o CRL con el mismo tipo de cliente que utiliza producción.",{"_2299":50374,"_22571":50351,"_15405":87872,"_5":15294,"_21315":87819,"_1890":87873},[],"Sustituye los marcadores por tu release, namespace y deployment reales.",{"_2299":50375,"_22571":50351,"_15405":87875,"_5":15294,"_21315":87819,"_1890":87876},[],"Ejecuta también la prueba de conectividad del chart:",{"_2299":50376,"_22571":50351,"_15405":87878,"_5":15294,"_21315":87819,"_1890":87879},[],"El test consulta la salud de CA, DMS Manager, Device Manager y VA, y comprueba que la UI devuelve HTML. Un test correcto confirma conectividad básica, no un flujo completo de emisión.",{"_2299":50377,"_22571":50351,"_15405":87881,"_5":15294,"_21315":87819,"_1890":87882},[],"Los servicios del chart exponen sondas de inicio, disponibilidad y vida sobre /health. Un pod puede estar ejecutándose pero no recibir tráfico si la readiness probe falla.",{"_2299":50378,"_22571":50351,"_15405":87884,"_5":15294,"_21315":87823,"_1890":87885},[],"Si recibes un 401:",{"_2299":50379,"_22571":50351,"_15405":87887,"_5":15294,"_21315":87823,"_1890":87888},[],"comprueba que la autoridad OIDC de la UI sea accesible desde el navegador;",{"_2299":50380,"_22571":50351,"_15405":87890,"_5":15294,"_21315":87823,"_1890":87891},[],"verifica emisor, audiencia y expiración del token;",{"_2299":50381,"_22571":50351,"_15405":87893,"_5":15294,"_21315":87823,"_1890":87894},[],"confirma que el Gateway puede obtener las claves de la URI JWKS;",{"_2299":50382,"_22571":50351,"_15405":87896,"_5":15294,"_21315":87823,"_1890":87897},[],"revisa que la ruta pública e interna del proveedor apunten al mismo realm.",{"_2299":50383,"_22571":50351,"_15405":87899,"_5":15294,"_21315":87823,"_1890":87900},[],"Si el login termina pero las APIs devuelven 403:",{"_2299":50384,"_22571":50351,"_15405":87902,"_5":15294,"_21315":87823,"_1890":87903},[],"inspecciona los claims reales del token;",{"_2299":50385,"_22571":50351,"_15405":87905,"_5":15294,"_21315":87823,"_1890":87906},[],"confirma que coinciden con un principal activo;",{"_2299":50386,"_22571":50351,"_15405":87908,"_5":15294,"_21315":87823,"_1890":87909},[],"revisa las políticas concedidas al principal;",{"_2299":50387,"_22571":50351,"_15405":87911,"_5":15294,"_21315":87823,"_1890":87912},[],"verifica que authz alcanza PostgreSQL y su JWKS.",{"_2299":50388,"_22571":50351,"_15405":87914,"_5":15294,"_21315":87823,"_1890":87915},[],"En una instalación nueva, confirma que el Job de migración terminó. Ese Job crea esquemas, migra authz, precarga políticas y provisiona los principales definidos en services.authz.bootstrap.",{"_2299":50389,"_22571":50351,"_15405":87917,"_5":15294,"_21315":87827,"_1890":87918},[],"La autorización externa falla cerrada por defecto. Si authz no está disponible, las rutas protegidas se bloquean.",{"_2299":50390,"_22571":50351,"_15405":87920,"_5":15294,"_21315":87827,"_1890":87921},[],"Localiza el pod y Service de authz.",{"_2299":50391,"_22571":50351,"_15405":87923,"_5":15294,"_21315":87827,"_1890":87924},[],"Comprueba /health, logs y conexión a su base de datos.",{"_2299":50392,"_22571":50351,"_15405":87926,"_5":15294,"_21315":87827,"_1890":87927},[],"Verifica el DNS y puerto configurados en externalAuthorization.",{"_2299":50393,"_22571":50351,"_15405":87929,"_5":15294,"_21315":87827,"_1890":87930},[],"Comprueba que la ruta del check es /v1/ext\\_authz/check.",{"_2299":50394,"_22571":50351,"_15405":87932,"_5":15294,"_21315":87827,"_1890":87933},[],"No cambies a failOpen: true como solución permanente: permitiría tráfico sin autorización durante la caída.",{"_2299":50395,"_22571":50351,"_15405":87935,"_5":15294,"_21315":87831,"_1890":87936},[],"Revisa primero kubectl describe pod. Las causas habituales son:",{"_2299":50396,"_22571":50351,"_15405":87938,"_5":15294,"_21315":87831,"_1890":87939},[],"credenciales o DNS incorrectos para PostgreSQL o RabbitMQ;",{"_2299":50397,"_22571":50351,"_15405":87941,"_5":15294,"_21315":87831,"_1890":87942},[],"volumen persistente sin enlazar;",{"_2299":50398,"_22571":50351,"_15405":87944,"_5":15294,"_21315":87831,"_1890":87945},[],"imagen inaccesible o política de pull incorrecta;",{"_2299":50399,"_22571":50351,"_15405":87947,"_5":15294,"_21315":87831,"_1890":87948},[],"configuración inválida del motor criptográfico;",{"_2299":50400,"_22571":50351,"_15405":87950,"_5":15294,"_21315":87831,"_1890":87951},[],"límites de CPU o memoria demasiado bajos;",{"_2299":50401,"_22571":50351,"_15405":87953,"_5":15294,"_21315":87831,"_1890":87954},[],"migración previa incompleta.",{"_2299":50402,"_22571":50351,"_15405":87956,"_5":15294,"_21315":87831,"_1890":87957},[],"Los valores genéricos solicitan 100 mCPU y 128 MiB y limitan a 500 mCPU y 512 MiB. Ajusta por servicio cuando haya OOMKills, throttling o arranques lentos.",{"_2299":50403,"_22571":50351,"_15405":87959,"_5":15294,"_21315":87831,"_1890":87960},[],"Los motores KMS basados en filesystem y el almacenamiento local de VA utilizan volúmenes de acceso exclusivo. Mantén una réplica o migra a backends compartidos antes de habilitar autoscaling.",{"_2299":50404,"_22571":50351,"_15405":87962,"_5":15294,"_21315":87835,"_1890":87963},[],"Acota el error siguiendo este orden:",{"_2299":50405,"_22571":50351,"_15405":87965,"_5":15294,"_21315":87835,"_1890":87966},[],"La CA existe, está activa y no ha expirado.",{"_2299":50406,"_22571":50351,"_15405":87968,"_5":15294,"_21315":87835,"_1890":87969},[],"La CA tiene una clave privada utilizable y el motor está disponible.",{"_2299":50407,"_22571":50351,"_15405":87971,"_5":15294,"_21315":87835,"_1890":87972},[],"La CSR tiene una firma válida.",{"_2299":50408,"_22571":50351,"_15405":87974,"_5":15294,"_21315":87835,"_1890":87975},[],"El perfil permite el tipo y tamaño de clave.",{"_2299":50409,"_22571":50351,"_15405":87977,"_5":15294,"_21315":87835,"_1890":87978},[],"La validez solicitada cabe dentro de la vigencia de la CA.",{"_2299":50410,"_22571":50351,"_15405":87980,"_5":15294,"_21315":87835,"_1890":87981},[],"KU, EKU, sujeto y extensiones cumplen el perfil.",{"_2299":50411,"_22571":50351,"_15405":87983,"_5":15294,"_21315":87835,"_1890":87984},[],"Si la reemisión de una CA falla, recuerda que no se admite para una CA revocada o ya expirada. Para cambiar su clave, sigue Jerarquía y rotación de CAs.",{"_2299":50412,"_22571":50351,"_15405":87986,"_5":15294,"_21315":87839,"_1890":87987},[],"Comprueba:",{"_2299":50413,"_22571":50351,"_15405":87989,"_5":15294,"_21315":87839,"_1890":87990},[],"el identificador del DMS en el path EST;",{"_2299":50414,"_22571":50351,"_15405":87992,"_5":15294,"_21315":87839,"_1890":87993},[],"el método de autenticación configurado;",{"_2299":50415,"_22571":50351,"_15405":87995,"_5":15294,"_21315":87839,"_1890":87996},[],"la cadena presentada por el cliente;",{"_2299":50416,"_22571":50351,"_15405":87998,"_5":15294,"_21315":87839,"_1890":87999},[],"las CAs de validación y el límite de niveles;",{"_2299":50417,"_22571":50351,"_15405":88001,"_5":15294,"_21315":87839,"_1890":88002},[],"el estado de revocación del certificado cliente;",{"_2299":50418,"_22571":50351,"_15405":88004,"_5":15294,"_21315":87839,"_1890":88005},[],"la firma de la CSR;",{"_2299":50419,"_22571":50351,"_15405":88007,"_5":15294,"_21315":87839,"_1890":88008},[],"la CA y el perfil usados para emitir;",{"_2299":50420,"_22571":50351,"_15405":88010,"_5":15294,"_21315":87839,"_1890":88011},[],"la ventana de re-enrolamiento.",{"_2299":50421,"_22571":50351,"_15405":88013,"_5":15294,"_21315":87839,"_1890":88014},[],"En re-enrolamiento, Lamassu intenta validar primero con la CA de enrolamiento y después con las CAs adicionales. Durante una migración, conserva la CA anterior en ese segundo conjunto hasta terminar el solapamiento.",{"_2299":50422,"_22571":50351,"_15405":88016,"_5":15294,"_21315":87843,"_1890":88017},[],"Confirma que la revocación quedó persistida y tiene razón y timestamp.",{"_2299":50423,"_22571":50351,"_15405":88019,"_5":15294,"_21315":87843,"_1890":88020},[],"Revisa la configuración y logs de VA.",{"_2299":50424,"_22571":50351,"_15405":88022,"_5":15294,"_21315":87843,"_1890":88023},[],"Comprueba la periodicidad y próxima actualización de la CRL.",{"_2299":50425,"_22571":50351,"_15405":88025,"_5":15294,"_21315":87843,"_1890":88026},[],"Descarta cachés intermedias en proxy y cliente.",{"_2299":50426,"_22571":50351,"_15405":88028,"_5":15294,"_21315":87843,"_1890":88029},[],"Verifica que el certificado apunta al endpoint que estás consultando.",{"_2299":50427,"_22571":50351,"_15405":88031,"_5":15294,"_21315":87843,"_1890":88032},[],"Consulta por número de serie y emisor correctos.",{"_2299":50428,"_22571":50351,"_15405":88034,"_5":15294,"_21315":87847,"_1890":88035},[],"Los eventos de dominio y auditoría dependen del publisher del bus:",{"_2299":50429,"_22571":50351,"_15405":88037,"_5":15294,"_21315":87847,"_1890":88038},[],"verifica que esté habilitado en el servicio emisor;",{"_2299":50430,"_22571":50351,"_15405":88040,"_5":15294,"_21315":87847,"_1890":88041},[],"comprueba conectividad y credenciales AMQP;",{"_2299":50431,"_22571":50351,"_15405":88043,"_5":15294,"_21315":87847,"_1890":88044},[],"revisa exchange, routing key, colas y consumidores;",{"_2299":50432,"_22571":50351,"_15405":88046,"_5":15294,"_21315":87847,"_1890":88047},[],"inspecciona dead-letter queues;",{"_2299":50433,"_22571":50351,"_15405":88049,"_5":15294,"_21315":87847,"_1890":88050},[],"alerta sobre colas durables huérfanas y crecimiento de backlog.",{"_2299":50434,"_22571":50351,"_15405":88052,"_5":15294,"_21315":87847,"_1890":88053},[],"Una caída del consumidor no siempre impide que la operación principal termine. Por eso debes monitorizar RabbitMQ y verificar de forma independiente la persistencia de auditoría.",{"_2299":50435,"_22571":50351,"_15405":88055,"_5":15294,"_21315":87851,"_1890":88056},[],"El chart puede habilitar instrumentación OpenTelemetry. Las trazas se exportan por OTLP HTTP y los logs pueden dirigirse a un endpoint compatible, como VictoriaLogs. Usa un identificador de correlación y la misma ventana temporal para unir Gateway, authz, servicio y dependencia.",{"_2299":50436,"_22571":50351,"_15405":88058,"_5":15294,"_21315":87851,"_1890":88059},[],"Antes de cerrar una incidencia, guarda:",{"_2299":50437,"_22571":50351,"_15405":88061,"_5":15294,"_21315":87851,"_1890":88062},[],"causa confirmada;",{"_2299":50438,"_22571":50351,"_15405":88064,"_5":15294,"_21315":87851,"_1890":88065},[],"alcance temporal y recursos afectados;",{"_2299":50439,"_22571":50351,"_15405":88067,"_5":15294,"_21315":87851,"_1890":88068},[],"comandos o consultas utilizados;",{"_2299":50440,"_22571":50351,"_15405":88070,"_5":15294,"_21315":87851