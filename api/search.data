ocs/deployment/aws-marketplace#infrastructure-requirements","Infrastructure requirements",{"_3465":19,"_30219":15,"_5":30548,"_20927":49270,"_27457":49271,"_2948":49272},[],"/docs/deployment/aws-marketplace#open-the-offer","Open the offer",{"_3465":20,"_30219":15,"_5":30548,"_20927":49274,"_27457":49275,"_2948":49276},[],"/docs/deployment/aws-marketplace#configure-the-instance","Configure the instance",{"_3465":21,"_30219":15,"_5":30548,"_20927":49278,"_27457":49279,"_2948":49280},[],"/docs/deployment/aws-marketplace#limit-network-access","Limit network access",{"_3465":22,"_30219":15,"_5":30548,"_20927":49282,"_27457":49283,"_2948":49284},[],"/docs/deployment/aws-marketplace#launch-and-verify","Launch and verify",{"_3465":23,"_30219":15,"_5":30548,"_20927":49286,"_27457":49287,"_2948":49288},[],"/docs/deployment/aws-marketplace#next-step","Next step",{"_3465":24,"_30219":15,"_20927":49290,"_5":14373,"_27457":15,"_2948":49291},[],"The AWS Marketplace offering reduces initial setup to an EC2 instance inside your account. You keep control of the network, storage and operation of the machine.",{"_3465":25,"_30219":15,"_20927":49293,"_5":14373,"_27457":49263,"_2948":49294},[],"Permissions to subscribe to AWS Marketplace products and launch EC2 instances.",{"_3465":26,"_30219":15,"_20927":49296,"_5":14373,"_27457":49263,"_2948":49297},[],"A VPC and a subnet from which administrators and devices can reach the instance.",{"_3465":27,"_30219":15,"_20927":49299,"_5":14373,"_27457":49263,"_2948":49300},[],"A security group allowing the necessary endpoints.",{"_3465":28,"_30219":15,"_20927":49302,"_5":14373,"_27457":49267,"_2948":49303},[],"**Compute:** a `t3.large` instance at minimum. Use `t3.xlarge` or higher when the load requires it.",{"_3465":29,"_30219":15,"_20927":49305,"_5":14373,"_27457":49267,"_2948":49306},[],"**Storage:** an EBS `gp3` volume of at least 50 GB, sized to your inventory and retention needs.",{"_3465":30,"_30219":15,"_20927":49308,"_5":14373,"_27457":49267,"_2948":49309},[],"**Network:** HTTPS access from the necessary consumers, restricted to trusted networks.",{"_3465":31,"_30219":15,"_20927":49311,"_5":14373,"_27457":49271,"_2948":49312},[],"Go to Lamassu IoT on AWS Marketplace and review the terms before subscribing.",{"_3465":32,"_30219":15,"_20927":49314,"_5":14373,"_27457":49275,"_2948":49315},[],"Select `t3.large` or higher, assign at least 50 GB of `gp3` storage and choose the target VPC and subnet.",{"_3465":33,"_30219":15,"_20927":49317,"_5":14373,"_27457":49279,"_2948":49318},[],"Configure the security group for ports `443`, `8443` and `9443`. Restrict the origins to the administrative and device networks that really need to connect.",{"_3465":34,"_30219":15,"_20927":49320,"_5":14373,"_27457":49283,"_2948":49321},[],"Start the instance and open the console at `https://<public-ip>`. Check you can authenticate before continuing.",{"_3465":35,"_30219":15,"_20927":49323,"_5":14373,"_27457":49287,"_2948":49324},[],"Continue with Create your first CA to validate the instance's cryptographic configuration.",{"_3465":36,"_30219":36,"_5":14725,"_2948":49326,"_30551":49327,"_20927":49328,"_27457":36},"Deploy Lamassu",[49254,49255],[],{"_3465":37,"_30219":36,"_20927":49330,"_5":14373,"_27457":36,"_2948":49331},[],"Choose the operating model that fits your infrastructure and control requirements.",{"_3465":38,"_30219":36,"_5":30548,"_20927":49333,"_27457":49334,"_2948":49335},[],"/docs/deployment/overview#choose-a-model","Choose a model",{"_3465":39,"_30219":36,"_5":30548,"_20927":49337,"_27457":49338,"_2948":49339},[],"/docs/deployment/overview#just-want-to-evaluate-the-platform","Just want to evaluate the platform?",{"_3465":40,"_30219":36,"_5":30548,"_20927":49341,"_27457":49342,"_2948":49343},[],"/docs/deployment/overview#after-deployment","After deployment",{"_3465":41,"_30219":36,"_20927":49345,"_5":14373,"_27457":36,"_2948":49346},[],"You can run Lamassu on your own Kubernetes cluster, deploy a prebuilt image from AWS Marketplace or consume the platform as a managed service.",{"_3465":42,"_30219":36,"_20927":49348,"_5":14373,"_27457":49334,"_2948":49349},[],"Model",{"_3465":43,"_30219":36,"_20927":49351,"_5":14373,"_27457":49334,"_2948":49352},[],"Recommended for",{"_3465":44,"_30219":36,"_20927":49354,"_5":14373,"_27457":49334,"_2948":49355},[],"Who operates the infrastructure",{"_3465":45,"_30219":36,"_20927":49357,"_5":14373,"_27457":49334,"_2948":49358},[],"Starting point",{"_3465":46,"_30219":36,"_20927":49360,"_5":14373,"_27457":49334,"_2948":49361},[],"Kubernetes self-managed",{"_3465":47,"_30219":36,"_20927":49363,"_5":14373,"_27457":49334,"_2948":49364},[],"Production, regulated environments and custom deployments",{"_3465":48,"_30219":36,"_20927":49366,"_5":14373,"_27457":49334,"_2948":49367},[],"Your team",{"_3465":49,"_30219":36,"_20927":49369,"_5":14373,"_27457":49334,"_2948":49370},[],"Helm or Fastlane",{"_3465":50,"_30219":36,"_20927":49372,"_5":14373,"_27457":49334,"_2948":49373},[],"AWS Marketplace",{"_3465":51,"_30219":36,"_20927":49375,"_5":14373,"_27457":49334,"_2948":49376},[],"Evaluation or a dedicated deployment inside an AWS account",{"_3465":52,"_30219":36,"_20927":49378,"_5":14373,"_27457":49334,"_2948":49367},[],{"_3465":53,"_30219":36,"_20927":49380,"_5":14373,"_27457":49334,"_2948":49381},[],"Preconfigured image on EC2",{"_3465":54,"_30219":36,"_20927":49383,"_5":14373,"_27457":49334,"_2948":49384},[],"SaaS",{"_3465":55,"_30219":36,"_20927":49386,"_5":14373,"_27457":49334,"_2948":49387},[],"Teams that want to use the platform without operating it",{"_3465":56,"_30219":36,"_20927":49389,"_5":14373,"_27457":49334,"_2948":49390},[],"Lamassu",{"_3465":57,"_30219":36,"_20927":49392,"_5":14373,"_27457":49334,"_2948":49393},[],"Managed subscription",{"_3465":58,"_30219":36,"_20927":49395,"_5":14373,"_27457":49334,"_2948":49396},[],"<Card title=\"Kubernetes self-managed\" description=\"Control network, storage, keys, dependencies and the upgrade cycle.\" href=\"/docs/deployment/self-hosted/overview\" />",{"_3465":59,"_30219":36,"_20927":49398,"_5":14373,"_27457":49334,"_2948":49399},[],"<Card title=\"AWS Marketplace\" description=\"Launch a preconfigured Lamassu instance on AWS EC2.\" href=\"/docs/deployment/aws-marketplace\" />",{"_3465":60,"_30219":36,"_20927":49401,"_5":14373,"_27457":49334,"_2948":49402},[],"<Card title=\"Lamassu SaaS\" description=\"Use an operated and updated instance as a managed service.\" href=\"/docs/deployment/saas\" />",{"_3465":61,"_30219":36,"_20927":49404,"_5":14373,"_27457":49338,"_2948":49405},[],"Use Fastlane to bring up PostgreSQL, Keycloak, RabbitMQ and Lamassu on a Kubernetes cluster through a single flow. It is intended for labs, demos and bootstrap; for production, configure dependencies and Helm values explicitly.",{"_3465":62,"_30219":36,"_20927":49407,"_5":14373,"_27457":49342,"_2948":49408},[],"Once the console is available, continue with Create your first CA. That quickstart verifies the cryptographic engine and issuance work correctly.",{"_3465":63,"_30219":63,"_5":14725,"_2948":49410,"_30551":49411,"_20927":49412,"_27457":63},"Use Lamassu as SaaS",[49254,49255,49256],[],{"_3465":64,"_30219":63,"_20927":49414,"_5":14373,"_27457":63,"_2948":49415},[],"Consume Lamassu as a managed service without operating your own infrastructure.",{"_3465":65,"_30219":63,"_5":30548,"_20927":49417,"_27457":49418,"_2948":49419},[],"/docs/deployment/saas#what-the-service-manages","What the service manages",{"_3465":66,"_30219":63,"_5":30548,"_20927":49421,"_27457":49422,"_2948":49423},[],"/docs/deployment/saas#plans","Plans",{"_3465":67,"_30219":63,"_5":30548,"_20927":49425,"_27457":49426,"_2948":49427},[],"/docs/deployment/saas#request-access","Request access",{"_3465":68,"_30219":63,"_20927":49429,"_5":14373,"_27457":63,"_2948":49430},[],"Lamassu SaaS offers the platform's capabilities in a managed environment. It is the right option when your team wants to focus on PKI and device identities, not on maintaining the infrastructure that supports them.",{"_3465":69,"_30219":63,"_20927":49432,"_5":14373,"_27457":49418,"_2948":49433},[],"Platform availability and maintenance.",{"_3465":70,"_30219":63,"_20927":49435,"_5":14373,"_27457":49418,"_2948":49436},[],"Automatic backups.",{"_3465":71,"_30219":63,"_20927":49438,"_5":14373,"_27457":49418,"_2948":49439},[],"Version upgrades.",{"_3465":72,"_30219":63,"_20927":49441,"_5":14373,"_27457":49418,"_2948":49442},[],"Technical support and SLA according to your plan.",{"_3465":73,"_30219":63,"_20927":49444,"_5":14373,"_27457":49422,"_2948":49445},[],"Plan",{"_3465":74,"_30219":63,"_20927":49447,"_5":14373,"_27457":49422,"_2948":49448},[],"Devices",{"_3465":75,"_30219":63,"_20927":49450,"_5":14373,"_27457":49422,"_2948":49451},[],"Support",{"_3465":76,"_30219":63,"_20927":49453,"_5":14373,"_27457":49422,"_2948":49454},[],"SLA",{"_3465":77,"_30219":63,"_20927":49456,"_5":14373,"_27457":49422,"_2948":49457},[],"Starter",{"_3465":78,"_30219":63,"_20927":49459,"_5":14373,"_27457":49422,"_2948":49460},[],"Up to 1,000",{"_3465":79,"_30219":63,"_20927":49462,"_5":14373,"_27457":49422,"_2948":49463},[],"Email",{"_3465":80,"_30219":63,"_20927":49465,"_5":14373,"_27457":49422,"_2948":49466},[],"99.5 %",{"_3465":81,"_30219":63,"_20927":49468,"_5":14373,"_27457":49422,"_2948":49469},[],"Professional",{"_3465":82,"_30219":63,"_20927":49471,"_5":14373,"_27457":49422,"_2948":49472},[],"Up to 10,000",{"_3465":83,"_30219":63,"_20927":49474,"_5":14373,"_27457":49422,"_2948":49475},[],"Email and chat",{"_3465":84,"_30219":63,"_20927":49477,"_5":14373,"_27457":49422,"_2948":49478},[],"99.9 %",{"_3465":85,"_30219":63,"_20927":49480,"_5":14373,"_27457":49422,"_2948":49481},[],"Enterprise",{"_3465":86,"_30219":63,"_20927":49483,"_5":14373,"_27457":49422,"_2948":49484},[],"Unlimited",{"_3465":87,"_30219":63,"_20927":49486,"_5":14373,"_27457":49422,"_2948":49487},[],"Dedicated",{"_3465":88,"_30219":63,"_20927":49489,"_5":14373,"_27457":49422,"_2948":49490},[],"99.99 %",{"_3465":89,"_30219":63,"_20927":49492,"_5":14373,"_27457":49426,"_2948":49493},[],"Contact the Lamassu team through lamassu.io to request a demo or choose a plan.",{"_3465":90,"_30219":63,"_20927":49495,"_5":14373,"_27457":49426,"_2948":49496},[],"When you receive your instance's credentials, continue with Get started.",{"_3465":91,"_30219":91,"_5":14725,"_2948":49498,"_30551":49499,"_20927":49500,"_27457":91},"Fastlane",[49254,49255,49361],[],{"_3465":92,"_30219":91,"_20927":49502,"_5":14373,"_27457":91,"_2948":49503},[],"Bootstrap a complete Lamassu evaluation or lab environment on an existing Kubernetes cluster.",{"_3465":93,"_30219":91,"_5":30548,"_20927":49505,"_27457":49506,"_2948":49507},[],"/docs/deployment/self-hosted/fastlane#deploy-with-fastlane","Deploy with Fastlane",{"_3465":94,"_30219":91,"_5":30548,"_20927":49509,"_27457":49510,"_2948":49511},[],"/docs/deployment/self-hosted/fastlane#what-fastlane-adds","What Fastlane adds",{"_3465":95,"_30219":91,"_5":30548,"_20927":49513,"_27457":49514,"_2948":49264},[],"/docs/deployment/self-hosted/fastlane#before-you-begin",{"_3465":96,"_30219":91,"_5":30548,"_20927":49516,"_27457":49517,"_2948":49518},[],"/docs/deployment/self-hosted/fastlane#quick-start","Quick start",{"_3465":97,"_30219":91,"_5":30548,"_20927":49520,"_27457":49521,"_2948":49522},[],"/docs/deployment/self-hosted/fastlane#gateway-address-selection","Gateway address selection",{"_3465":98,"_30219":91,"_5":30548,"_20927":49524,"_27457":49525,"_2948":49526},[],"/docs/deployment/self-hosted/fastlane#command-line-options","Command-line options",{"_3465":99,"_30219":91,"_5":30548,"_20927":49528,"_27457":49529,"_2948":49530},[],"/docs/deployment/self-hosted/fastlane#development-mode","Development mode",{"_3465":100,"_30219":91,"_5":30548,"_20927":49532,"_27457":49533,"_2948":49534},[],"/docs/deployment/self-hosted/fastlane#what-the-script-configures","What the script configures",{"_3465":101,"_30219":91,"_5":30548,"_20927":49536,"_27457":49537,"_2948":49538},[],"/docs/deployment/self-hosted/fastlane#tls-behavior","TLS behavior",{"_3465":102,"_30219":91,"_5":30548,"_20927":49540,"_27457":49541,"_2948":49542},[],"/docs/deployment/self-hosted/fastlane#credentials-and-generated-files","Credentials and generated files",{"_3465":103,"_30219":91,"_5":30548,"_20927":49544,"_27457":49545,"_2948":49546},[],"/docs/deployment/self-hosted/fastlane#verify-the-installation","Verify the installation",{"_3465":104,"_30219":91,"_20927":49548,"_5":14373,"_27457":49506,"_2948":49549},[],"Fastlane is the automated path for evaluations, demos, CI and small lab clusters. It installs PostgreSQL, Keycloak, RabbitMQ, Envoy Gateway and Lamassu, then configures them to work together.",{"_3465":105,"_30219":91,"_20927":49551,"_5":14373,"_27457":49506,"_2948":49552},[],"For production, use Helm so database, identity, credentials, certificates, storage and upgrades remain explicit.",{"_3465":106,"_30219":91,"_20927":49554,"_5":14373,"_27457":49510,"_2948":49555},[],"Fastlane closes some of the gaps intentionally left by the application chart:",{"_3465":107,"_30219":91,"_20927":49557,"_5":14373,"_27457":49510,"_2948":49558},[],"Fastlane installs or configures",{"_3465":108,"_30219":91,"_20927":49560,"_5":14373,"_27457":49510,"_2948":49561},[],"You still provide",{"_3465":109,"_30219":91,"_20927":49563,"_5":14373,"_27457":49510,"_2948":49564},[],"PostgreSQL, RabbitMQ and Keycloak instances for evaluation",{"_3465":110,"_30219":91,"_20927":49566,"_5":14373,"_27457":49510,"_2948":49567},[],"The Kubernetes cluster, nodes and persistent storage",{"_3465":111,"_30219":91,"_20927":49569,"_5":14373,"_27457":49510,"_2948":49570},[],"Envoy Gateway 1.8 and the `eg` `GatewayClass`",{"_3465":112,"_30219":91,"_20927":49572,"_5":14373,"_27457":49510,"_2948":49573},[],"cert-manager, external network reachability, DNS and firewall/NAT rules",{"_3465":113,"_30219":91,"_20927":49575,"_5":14373,"_27457":49510,"_2948":49576},[],"A self-signed Lamassu certificate flow, generated dependency credentials and an initial user",{"_3465":114,"_30219":91,"_20927":49578,"_5":14373,"_27457":49510,"_2948":49579},[],"Client trust for the self-signed CA, or a trusted certificate passed to the script",{"_3465":115,"_30219":91,"_20927":49581,"_5":14373,"_27457":49510,"_2948":49582},[],"Optional observability and lab HSM components",{"_3465":116,"_30219":91,"_20927":49584,"_5":14373,"_27457":49510,"_2948":49585},[],"Production monitoring retention, backups, HA and a production HSM/key service",{"_3465":117,"_30219":91,"_20927":49587,"_5":14373,"_27457":49510,"_2948":49588},[],"Fastlane does not turn the resulting stack into a production service: it does not create the cluster, public DNS, firewall rules, backups, high availability or a trusted public certificate.",{"_3465":118,"_30219":91,"_20927":49590,"_5":14373,"_27457":49514,"_2948":49591},[],"You need:",{"_3465":119,"_30219":91,"_20927":49593,"_5":14373,"_27457":49514,"_2948":49594},[],"an existing Kubernetes cluster",{"_3465":120,"_30219":91,"_20927":49596,"_5":14373,"_27457":49514,"_2948":49597},[],"`kubectl` and Helm, or the MicroK8s CLI",{"_3465":121,"_30219":91,"_20927":49599,"_5":14373,"_27457":49514,"_2948":49600},[],"`yq`",{"_3465":122,"_30219":91,"_20927":49602,"_5":14373,"_27457":49514,"_2948":23665},[],{"_3465":123,"_30219":91,"_20927":49604,"_5":14373,"_27457":49514,"_2948":49605},[],"`jq` only when using `--sample-data` or `--development`",{"_3465":124,"_30219":91,"_20927":49607,"_5":14373,"_27457":49514,"_2948":49608},[],"`ssh-keygen` only when using `--with-hsm`",{"_3465":125,"_30219":91,"_20927":49610,"_5":14373,"_27457":49514,"_2948":49611},[],"free external ports 80 and 443 on a single-node K3s host",{"_3465":126,"_30219":91,"_20927":49613,"_5":14373,"_27457":49514,"_2948":49614},[],"Fastlane detects MicroK8s, K3s, kind or a standard kubeconfig. Use `--context` when the intended cluster is not the current context.",{"_3465":127,"_30219":91,"_20927":49616,"_5":14373,"_27457":49514,"_2948":49617},[],"Fastlane installs several components and creates credentials. Check `kubectl config current-context` or pass `--context` before running it.",{"_3465":128,"_30219":91,"_20927":49619,"_5":14373,"_27457":49517,"_2948":49620},[],"Run the script from a clone of the Helm repository:",{"_3465":129,"_30219":91,"_20927":49622,"_5":14373,"_27457":49517,"_2948":49623},[],"Create a DNS record for the chosen domain before testing from another machine. For a small VM, point it at the VM or load-balancer address that actually receives ports 80 and 443.",{"_3465":130,"_30219":91,"_20927":49625,"_5":14373,"_27457":49521,"_2948":49626},[],"By default, Fastlane runs `hostname -I` and writes the returned addresses to `gateway.addresses` and to the self-signed certificate's IP SANs.",{"_3465":131,"_30219":91,"_20927":49628,"_5":14373,"_27457":49521,"_2948":49629},[],"On a single-homed lab VM this can select the expected node address. On hosts with Docker, VPN, WireGuard or several interfaces it can also select addresses clients cannot reach. Override the result explicitly:",{"_3465":132,"_30219":91,"_20927":49631,"_5":14373,"_27457":49521,"_2948":49632},[],"The value must be an address handled on the Kubernetes side of the traffic path. If a public EC2 address forwards through WireGuard to the cluster, pass the reachable cluster/VM address, not the EC2 public address.",{"_3465":133,"_30219":91,"_20927":49634,"_5":14373,"_27457":49521,"_2948":49635},[],"See Expose the Gateway for K3s port conflicts, VIPs, external NAT and multi-Gateway designs.",{"_3465":134,"_30219":91,"_20927":49637,"_5":14373,"_27457":49525,"_2948":49638},[],"Option",{"_3465":135,"_30219":91,"_20927":49640,"_5":14373,"_27457":49525,"_2948":49641},[],"Default",{"_3465":136,"_30219":91,"_20927":49643,"_5":14373,"_27457":49525,"_2948":49644},[],"Purpose",{"_3465":137,"_30219":91,"_20927":49646,"_5":14373,"_27457":49525,"_2948":49647},[],"`-h`, `--help`",{"_3465":138,"_30219":91,"_20927":49649,"_5":14373,"_27457":49525,"_2948":49650},[],"—",{"_3465":139,"_30219":91,"_20927":49652,"_5":14373,"_27457":49525,"_2948":49653},[],"Show help",{"_3465":140,"_30219":91,"_20927":49655,"_5":14373,"_27457":49525,"_2948":49656},[],"`-c`, `--context`",{"_3465":141,"_30219":91,"_20927":49658,"_5":14373,"_27457":49525,"_2948":49659},[],"current context",{"_3465":142,"_30219":91,"_20927":49661,"_5":14373,"_27457":49525,"_2948":49662},[],"Select the kubeconfig context for kubectl and Helm",{"_3465":143,"_30219":91,"_20927":49664,"_5":14373,"_27457":49525,"_2948":49665},[],"`-n`, `--non-interactive`",{"_3465":144,"_30219":91,"_20927":49667,"_5":14373,"_27457":49525,"_2948":6533},[],{"_3465":145,"_30219":91,"_20927":49669,"_5":14373,"_27457":49525,"_2948":49670},[],"Skip prompts and generate dependency credentials",{"_3465":146,"_30219":91,"_20927":49672,"_5":14373,"_27457":49525,"_2948":49673},[],"`-ns`, `--namespace`",{"_3465":147,"_30219":91,"_20927":49675,"_5":14373,"_27457":49525,"_2948":49676},[],"`lamassu-dev`",{"_3465":148,"_30219":91,"_20927":49678,"_5":14373,"_27457":49525,"_2948":49679},[],"Namespace for the installation",{"_3465":149,"_30219":91,"_20927":49681,"_5":14373,"_27457":49525,"_2948":49682},[],"`-d`, `--domain`",{"_3465":150,"_30219":91,"_20927":49684,"_5":14373,"_27457":49525,"_2948":49685},[],"`dev.lamassu.io`",{"_3465":151,"_30219":91,"_20927":49687,"_5":14373,"_27457":49525,"_2948":49688},[],"Domain used by the UI, OIDC and certificate",{"_3465":152,"_30219":91,"_20927":49690,"_5":14373,"_27457":49525,"_2948":49691},[],"`-v`, `--version`",{"_3465":153,"_30219":91,"_20927":49693,"_5":14373,"_27457":49525,"_2948":15070},[],{"_3465":154,"_30219":91,"_20927":49695,"_5":14373,"_27457":49525,"_2948":49696},[],"Lamassu chart version",{"_3465":155,"_30219":91,"_20927":49698,"_5":14373,"_27457":49525,"_2948":49699},[],"`--https-port`",{"_3465":156,"_30219":91,"_20927":49701,"_5":14373,"_27457":49525,"_2948":49702},[],"`443`",{"_3465":157,"_30219":91,"_20927":49704,"_5":14373,"_27457":49525,"_2948":49705},[],"Gateway HTTPS listener port",{"_3465":158,"_30219":91,"_20927":49707,"_5":14373,"_27457":49525,"_2948":49708},[],"`--http-port`",{"_3465":159,"_30219":91,"_20927":49710,"_5":14373,"_27457":49525,"_2948":49711},[],"`80`",{"_3465":160,"_30219":91,"_20927":49713,"_5":14373,"_27457":49525,"_2948":49714},[],"Gateway HTTP listener port",{"_3465":161,"_30219":91,"_20927":49716,"_5":14373,"_27457":49525,"_2948":49717},[],"`--tls-crt`",{"_3465":162,"_30219":91,"_20927":49719,"_5":14373,"_27457":49525,"_2948":49650},[],{"_3465":163,"_30219":91,"_20927":49721,"_5":14373,"_27457":49525,"_2948":49722},[],"PEM certificate for downstream TLS",{"_3465":164,"_30219":91,"_20927":49724,"_5":14373,"_27457":49525,"_2948":49725},[],"`--tls-key`",{"_3465":165,"_30219":91,"_20927":49727,"_5":14373,"_27457":49525,"_2948":49650},[],{"_3465":166,"_30219":91,"_20927":49729,"_5":14373,"_27457":49525,"_2948":49730},[],"PEM private key for downstream TLS",{"_3465":167,"_30219":91,"_20927":49732,"_5":14373,"_27457":49525,"_2948":49733},[],"`-l`, `--local-chart-path`",{"_3465":168,"_30219":91,"_20927":49735,"_5":14373,"_27457":49525,"_2948":49736},[],"repository chart",{"_3465":169,"_30219":91,"_20927":49738,"_5":14373,"_27457":49525,"_2948":49739},[],"Use an unpacked local Lamassu chart",{"_3465":170,"_30219":91,"_20927":49741,"_5":14373,"_27457":49525,"_2948":49742},[],"`-ip`, `--gateway-ip`",{"_3465":171,"_30219":91,"_20927":49744,"_5":14373,"_27457":49525,"_2948":8734},[],{"_3465":172,"_30219":91,"_20927":49746,"_5":14373,"_27457":49525,"_2948":49747},[],"Override the address written to `gateway.addresses`",{"_3465":173,"_30219":91,"_20927":49749,"_5":14373,"_27457":49525,"_2948":49750},[],"`--otel`",{"_3465":174,"_30219":91,"_20927":49752,"_5":14373,"_27457":49525,"_2948":6533},[],{"_3465":175,"_30219":91,"_20927":49754,"_5":14373,"_27457":49525,"_2948":49755},[],"Install Victoria Logs, VictoriaTraces, Jaeger and an OpenTelemetry Collector",{"_3465":176,"_30219":91,"_20927":49757,"_5":14373,"_27457":49525,"_2948":49758},[],"`--development`",{"_3465":177,"_30219":91,"_20927":49760,"_5":14373,"_27457":49525,"_2948":6533},[],{"_3465":178,"_30219":91,"_20927":49762,"_5":14373,"_27457":49525,"_2948":49763},[],"Development mode: fully provisions the Keycloak `lamassu` user (fixed `lamassu`/`lamassu` password, no first-login steps) and lets the `frontend` client accept any redirect URI or web origin. Not for production",{"_3465":179,"_30219":91,"_20927":49765,"_5":14373,"_27457":49525,"_2948":49766},[],"`--sample-data`",{"_3465":180,"_30219":91,"_20927":49768,"_5":14373,"_27457":49525,"_2948":6533},[],{"_3465":181,"_30219":91,"_20927":49770,"_5":14373,"_27457":49525,"_2948":49771},[],"Create sample CAs, profiles, certificates, DMS data and devices",{"_3465":182,"_30219":91,"_20927":49773,"_5":14373,"_27457":49525,"_2948":49774},[],"`--with-hsm`",{"_3465":183,"_30219":91,"_20927":49776,"_5":14373,"_27457":49525,"_2948":6533},[],{"_3465":184,"_30219":91,"_20927":49778,"_5":14373,"_27457":49525,"_2948":49779},[],"Install lab HSM components and configure KMS for PKCS#11",{"_3465":185,"_30219":91,"_20927":49781,"_5":14373,"_27457":49525,"_2948":49782},[],"`--softhsm-chart-path`",{"_3465":186,"_30219":91,"_20927":49784,"_5":14373,"_27457":49525,"_2948":49785},[],"`./charts/softhsm`",{"_3465":187,"_30219":91,"_20927":49787,"_5":14373,"_27457":49525,"_2948":49788},[],"Use a different local SoftHSM chart",{"_3465":188,"_30219":91,"_20927":49790,"_5":14373,"_27457":49525,"_2948":49791},[],"Fastlane does not provide an offline mode. Use the manual Helm workflow and a prepared registry/chart mirror for disconnected environments.",{"_3465":189,"_30219":91,"_20927":49793,"_5":14373,"_27457":49529,"_2948":49794},[],"`--development` adjusts the Keycloak `lamassu` realm generated by Fastlane for a disposable evaluation environment:",{"_3465":190,"_30219":91,"_20927":49796,"_5":14373,"_27457":49529,"_2948":49797},[],"the `lamassu` user is fully provisioned (first name Lamassu, last name Admin, email `lamassu@lamassu.io`, verified): there are no profile setup or password change steps on first login",{"_3465":191,"_30219":91,"_20927":49799,"_5":14373,"_27457":49529,"_2948":49800},[],"the well-known `lamassu`/`lamassu` password is fixed and permanent: it is never rotated and grants the `pki-admin` role, including non-interactive tokens through the `frontend` client",{"_3465":192,"_30219":91,"_20927":49802,"_5":14373,"_27457":49529,"_2948":49803},[],"the `frontend` client accepts any redirect URI and any web origin (`*`) instead of the original `/*` patterns",{"_3465":193,"_30219":91,"_20927":49805,"_5":14373,"_27457":49529,"_2948":49806},[],"With `--development`, the fixed `lamassu`/`lamassu` password grants `pki-admin` access to anyone who can reach the installation. Never use it on anything exposed beyond a development machine or a network-reachable host.",{"_3465":194,"_30219":91,"_20927":49808,"_5":14373,"_27457":49529,"_2948":49809},[],"`--development` applies when the `lamassu` realm is first imported. It does not modify an existing cluster. It can be combined with `--sample-data`: the development transform runs first, then sample data is added to the same realm configuration.",{"_3465":195,"_30219":91,"_20927":49811,"_5":14373,"_27457":49533,"_2948":49812},[],"Fastlane:",{"_3465":196,"_30219":91,"_20927":49814,"_5":14373,"_27457":49533,"_2948":49815},[],"validates local tools and the selected cluster",{"_3465":197,"_30219":91,"_20927":49817,"_5":14373,"_27457":49533,"_2948":49818},[],"installs or upgrades Envoy Gateway 1.8 and creates the `eg` `GatewayClass`",{"_3465":198,"_30219":91,"_20927":49820,"_5":14373,"_27457":49533,"_2948":49821},[],"creates the namespace",{"_3465":199,"_30219":91,"_20927":49823,"_5":14373,"_27457":49533,"_2948":49824},[],"installs PostgreSQL and creates the required databases",{"_3465":200,"_30219":91,"_20927":49826,"_5":14373,"_27457":49533,"_2948":49827},[],"installs Keycloak and creates the `lamassu` realm, frontend client, admin role and initial user",{"_3465":201,"_30219":91,"_20927":49829,"_5":14373,"_27457":49533,"_2948":49830},[],"installs RabbitMQ",{"_3465":202,"_30219":91,"_20927":49832,"_5":14373,"_27457":49533,"_2948":49833},[],"optionally installs observability and lab HSM components",{"_3465":203,"_30219":91,"_20927":49835,"_5":14373,"_27457":49533,"_2948":49836},[],"generates `lamassu.yaml` and installs the Lamassu chart",{"_3465":204,"_30219":91,"_20927":49838,"_5":14373,"_27457":49533,"_2948":49839},[],"optionally loads sample data",{"_3465":205,"_30219":91,"_20927":49841,"_5":14373,"_27457":49533,"_2948":49842},[],"The generated configuration exposes Keycloak at `/auth` through the same Gateway and bootstraps the initial `lamassu` user as a Lamassu super administrator.",{"_3465":206,"_30219":91,"_20927":49844,"_5":14373,"_27457":49537,"_2948":49845},[],"With both `--tls-crt` and `--tls-key`, Fastlane creates the `downstream-provided-crt` Secret and configures `tls.type: external`.",{"_3465":207,"_30219":91,"_20927":49847,"_5":14373,"_27457":49537,"_2948":49848},[],"Without them, it configures cert-manager with a self-signed issuer. This is suitable for a lab but will not be trusted by clients until you distribute the CA. Use Helm when you need a corporate Issuer, public ACME issuer or an existing Secret managed by another system.",{"_3465":208,"_30219":91,"_20927":49850,"_5":14373,"_27457":49541,"_2948":49851},[],"Non-interactive mode generates random PostgreSQL, RabbitMQ and Keycloak administrator passwords. The initial Lamassu login is `lamassu` / `lamassu` and requires a password change on first use, unless `--development` was used: in that case the password stays fixed and permanent.",{"_3465":209,"_30219":91,"_20927":49853,"_5":14373,"_27457":49541,"_2948":49854},[],"Fastlane writes `lamassu.yaml` in the current directory and injects credentials into it.",{"_3465":210,"_30219":91,"_20927":49856,"_5":14373,"_27457":49541,"_2948":49857},[],"Protect the generated values file, record the generated credentials in an appropriate secret store and do not reuse the evaluation identity setup in production.",{"_3465":211,"_30219":91,"_20927":49859,"_5":14373,"_27457":49545,"_2948":49860},[],"Then open `https://pki.example.com` and sign in with the initial user. If the Gateway is programmed but the URL is unreachable, follow the checks in Expose the Gateway.",{"_3465":212,"_30219":212,"_5":14725,"_2948":49862,"_30551":49863,"_20927":49864,"_27457":212},"Install with Helm",[49254,49255,49361],[],{"_3465":213,"_30219":212,"_20927":49866,"_5":14373,"_27457":212,"_2948":49867},[],"Prepare dependencies, configure the Lamassu chart and verify a controlled Kubernetes deployment.",{"_3465":214,"_30219":212,"_5":30548,"_20927":49869,"_27457":49870,"_2948":49871},[],"/docs/deployment/self-hosted/helm#install-lamassu-with-helm","Install Lamassu with Helm",{"_3465":215,"_30219":212,"_5":30548,"_20927":49873,"_27457":49874,"_2948":49264},[],"/docs/deployment/self-hosted/helm#before-you-begin",{"_3465":216,"_30219":212,"_5":30548,"_20927":49876,"_27457":49877,"_2948":49878},[],"/docs/deployment/self-hosted/helm#1-install-the-gateway-prerequisites","1\\. Install the Gateway prerequisites",{"_3465":217,"_30219":212,"_5":30548,"_20927":49880,"_27457":49881,"_2948":49882},[],"/docs/deployment/self-hosted/helm#2-create-a-values-file","2\\. Create a values file",{"_3465":218,"_30219":212,"_5":30548,"_20927":49884,"_27457":49885,"_2948":49886},[],"/docs/deployment/self-hosted/helm#tls-with-an-existing-secret","TLS with an existing Secret",{"_3465":219,"_30219":212,"_5":30548,"_20927":49888,"_27457":49889,"_2948":49890},[],"/docs/deployment/self-hosted/helm#amqp-tls-amqps","AMQP TLS (AMQPS)",{"_3465":220,"_30219":212,"_5":30548,"_20927":49892,"_27457":49893,"_2948":49894},[],"/docs/deployment/self-hosted/helm#provision-the-first-administrator","Provision the first administrator",{"_3465":221,"_30219":212,"_5":30548,"_20927":49896,"_27457":49897,"_2948":49898},[],"/docs/deployment/self-hosted/helm#3-install-lamassu","3\\. Install Lamassu",{"_3465":222,"_30219":212,"_5":30548,"_20927":49900,"_27457":49901,"_2948":49902},[],"/docs/deployment/self-hosted/helm#4-verify-the-deployment","4\\. Verify the deployment",{"_3465":223,"_30219":212,"_5":30548,"_20927":49904,"_27457":49905,"_2948":49906},[],"/docs/deployment/self-hosted/helm#upgrading-lamassu","Upgrading Lamassu",{"_3465":224,"_30219":212,"_5":30548,"_20927":49908,"_27457":49909,"_2948":49910},[],"/docs/deployment/self-hosted/helm#production-decisions","Production decisions",{"_3465":225,"_30219":212,"_20927":49912,"_5":14373,"_27457":49870,"_2948":49913},[],"Use the Helm workflow when you need explicit control over identity, databases, messaging, certificates, storage and upgrades. For an evaluation environment where the script can make those choices for you, use Fastlane.",{"_3465":226,"_30219":212,"_20927":49915,"_5":14373,"_27457":49874,"_2948":49916},[],"Prepare the platform services that are deliberately outside the Lamassu chart:",{"_3465":227,"_30219":212,"_20927":49918,"_5":14373,"_27457":49874,"_2948":49919},[],"a Kubernetes 1.24+ cluster and Helm 3.2+",{"_3465":228,"_30219":212,"_20927":49921,"_5":14373,"_27457":49874,"_2948":49922},[],"a reachable PostgreSQL server and a role allowed to create databases and schemas",{"_3465":229,"_30219":212,"_20927":49924,"_5":14373,"_27457":49874,"_2948":49925},[],"a reachable RabbitMQ broker and credentials",{"_3465":230,"_30219":212,"_20927":49927,"_5":14373,"_27457":49874,"_2948":49928},[],"an OIDC provider, normally Keycloak, with a realm/tenant and client for Lamassu",{"_3465":231,"_30219":212,"_20927":49930,"_5":14373,"_27457":49874,"_2948":49931},[],"Envoy Gateway 1.8+ and a `GatewayClass`",{"_3465":232,"_30219":212,"_20927":49933,"_5":14373,"_27457":49874,"_2948":49934},[],"cert-manager 1.14+ (only for the default `tls.type: certManager` mode); for trusted TLS, either a trusted issuer or a Kubernetes TLS Secret",{"_3465":233,"_30219":212,"_20927":49936,"_5":14373,"_27457":49874,"_2948":49937},[],"a StorageClass and an external traffic design",{"_3465":234,"_30219":212,"_20927":49939,"_5":14373,"_27457":49874,"_2948":49940},[],"The chart defaults to a `GatewayClass` named `eg`. Change `gateway.className` if your platform team uses another name.",{"_3465":235,"_30219":212,"_20927":49942,"_5":14373,"_27457":49874,"_2948":49943},[],"You provide the PostgreSQL server. The chart's pre-install job connects with the supplied credentials, creates the required `pki`, `authz` and `wfx` databases and service schemas, runs migrations, and applies `services.authz.bootstrap`.",{"_3465":236,"_30219":212,"_20927":49945,"_5":14373,"_27457":49874,"_2948":49946},[],"The chart has no Helm dependencies that install PostgreSQL, RabbitMQ, an OIDC provider, Envoy Gateway or cert-manager.",{"_3465":237,"_30219":212,"_20927":49948,"_5":14373,"_27457":49877,"_2948":49949},[],"Install or upgrade the Envoy Gateway CRDs before its controller. The commands below match the version used by the Lamassu Helm repository:",{"_3465":238,"_30219":212,"_20927":49951,"_5":14373,"_27457":49877,"_2948":49952},[],"Create the default `GatewayClass` if it does not already exist. Save this manifest as `gateway-class.yaml`:",{"_3465":239,"_30219":212,"_20927":49954,"_5":14373,"_27457":49877,"_2948":49955},[],"Install cert-manager separately before Lamassu, but only for the default `tls.type: certManager` mode. In that mode the chart renders its self-signed Issuer and CA Certificate resources regardless of whether `tls.certManagerOptions.clusterIssuer` is set, so cert-manager stays a prerequisite. With `tls.type: external`, the chart renders no cert-manager resources and the Gateway terminates TLS with an existing Secret you provide instead.",{"_3465":240,"_30219":212,"_20927":49957,"_5":14373,"_27457":49881,"_2948":49958},[],"Start with the chart defaults and override the environment-specific values. This example assumes PostgreSQL, RabbitMQ and Keycloak are reachable through Kubernetes DNS, and exposes Keycloak at `/auth` through the shared Lamassu Gateway:",{"_3465":241,"_30219":212,"_20927":49960,"_5":14373,"_27457":49881,"_2948":49961},[],"Do not add `gateway.addresses` by default. Leave address assignment to the load-balancer implementation unless your network design requires a specific Kubernetes-side VIP. The public IP of an upstream NAT gateway or reverse proxy does not belong in this value.",{"_3465":242,"_30219":212,"_20927":49963,"_5":14373,"_27457":49881,"_2948":49964},[],"If Keycloak is external and already has its own reachable URL, point the OIDC settings at it and omit the `/auth` entry from `gateway.extraRouting`.",{"_3465":243,"_30219":212,"_20927":49966,"_5":14373,"_27457":49881,"_2948":49967},[],"If your values file still carries the legacy gateway JWT validation settings — `auth.oidc.apiGateway.jwks`, `auth.authorization.rolesClaim` or `auth.authorization.roles.admin` — remove them. The migration guide `charts/lamassu/CHANGELOG/3.8.0->4.0.0.md` documents their removal with no compatibility aliases, and `values.schema.json` rejects the leftover blocks instead of silently ignoring them. The replacements are `services.authz.jwkUrl` and `services.authz.bootstrap`, already shown in the example above.",{"_3465":244,"_30219":212,"_20927":49969,"_5":14373,"_27457":49885,"_2948":49970},[],"Create a Secret containing `tls.crt` and `tls.key`, then reference it. The Secret must already exist before installing: in `external` mode the chart renders no cert-manager resources and never creates this Secret.",{"_3465":245,"_30219":212,"_20927":49972,"_5":14373,"_27457":49889,"_2948":49973},[],"`amqp.tls: true` selects AMQPS in every event-bus configuration block. The default port stays `5672` and does not change automatically when TLS is enabled, so set `amqp.port` to the broker's TLS listener, commonly `5671`.",{"_3465":246,"_30219":212,"_20927":49975,"_5":14373,"_27457":49889,"_2948":49976},[],"With no CA Secret configured, the event-bus clients use the system-trusted CAs. To trust a private CA, create a Secret in the release namespace containing the CA certificate in PEM format and set `amqp.ca.secretName` (and `amqp.ca.certificateKey` if the data key is not `ca.crt`).",{"_3465":247,"_30219":212,"_20927":49978,"_5":14373,"_27457":49889,"_2948":49979},[],"For brokers that require mutual TLS, create a Secret containing the client certificate and private key and set `amqp.client.secretName` (with `amqp.client.certificateKey` and `amqp.client.privateKeyKey` if the data keys are not `tls.crt` and `tls.key`).",{"_3465":248,"_30219":212,"_20927":49981,"_5":14373,"_27457":49889,"_2948":49982},[],"The chart mounts configured Secrets read-only into every AMQP-consuming workload: the CA certificate under `/etc/lamassu/amqp/ca` and the client certificate and key under `/etc/lamassu/amqp/client`. The mounted file names are always `ca.crt`, `tls.crt` and `tls.key` — the `certificateKey` and `privateKeyKey` values rename only the Secret data keys, never the on-disk paths. The client private key is mounted with restrictive permissions (`defaultMode: 0440`; the CA volume uses `0444`), which works because the chart adds `fsGroup` to the pod security context when `amqp.client.secretName` is set — it uses the container `runAsGroup` (default `65532`) when `fsGroup` is not already set.",{"_3465":249,"_30219":212,"_20927":49984,"_5":14373,"_27457":49889,"_2948":49985},[],"Both Secret options require `amqp.tls: true`: `values.schema.json` rejects a non-empty `secretName` when `tls` is false, rejects unknown keys and rejects data-key names outside `^[A-Za-z0-9._-]+$`. The referenced Secret must exist in the release namespace or the consuming pods fail to start.",{"_3465":250,"_30219":212,"_20927":49987,"_5":14373,"_27457":49889,"_2948":49988},[],"The AMQP client loads certificates at startup, so restart the consuming pods after updating either Secret. Changing any `amqp` value rolls the consuming pods through the `checksum/config` annotation, but a change to Secret content alone does not trigger a rollout.",{"_3465":251,"_30219":212,"_20927":49990,"_5":14373,"_27457":49889,"_2948":49991},[],"Per the migration guide `charts/lamassu/CHANGELOG/3.8.0->4.0.0.md`: in 3.8.0 `amqp.tls` was not applied and event-bus clients used plaintext AMQP; from 4.0.0, `amqp.tls: true` switches them to AMQPS. Set `amqp.port` to the broker TLS listener before upgrading, or set `amqp.tls: false` to keep plaintext AMQP. `amqp.tls: false` sends the broker credentials and all event-bus traffic in cleartext.",{"_3465":252,"_30219":212,"_20927":49993,"_5":14373,"_27457":49893,"_2948":49994},[],"There is no implicit superuser. Create the role or group expected by `services.authz.bootstrap` in the OIDC provider and assign it to at least one administrator before exposing Lamassu.",{"_3465":253,"_30219":212,"_20927":49996,"_5":14373,"_27457":49893,"_2948":49997},[],"The pre-install and pre-upgrade job applies the bootstrap idempotently: existing principals are preserved and missing grants are added.",{"_3465":254,"_30219":212,"_20927":49999,"_5":14373,"_27457":49893,"_2948":50000},[],"Test both an authorized identity and a denied identity. If no token matches an active bootstrap principal, nobody can administer the PKI.",{"_3465":255,"_30219":212,"_20927":50002,"_5":14373,"_27457":49893,"_2948":50003},[],"See Access control for the principal and policy model.",{"_3465":256,"_30219":212,"_20927":50005,"_5":14373,"_27457":49897,"_2948":50006},[],"To install a local checkout instead:",{"_3465":257,"_30219":212,"_20927":50008,"_5":14373,"_27457":49901,"_2948":50009},[],"The Gateway should report `PROGRAMMED=True`. If it is programmed but has no usable address, continue with Expose the Gateway.",{"_3465":258,"_30219":212,"_20927":50011,"_5":14373,"_27457":49901,"_2948":50012},[],"The Helm test checks the CA, DMS Manager, Device Manager and VA health endpoints and verifies the UI response.",{"_3465":259,"_30219":212,"_20927":50014,"_5":14373,"_27457":49905,"_2948":50015},[],"Version-specific upgrade steps live in `charts/lamassu/CHANGELOG/` in the Helm repository. The chart also ships an optional pre-upgrade Job that migrates existing CA private keys into the KMS engine configured for the release. It is off by default (`migrations.caToKms.enabled: false`) and is only needed when upgrading from a version prior to 3.7.0.",{"_3465":260,"_30219":212,"_20927":50017,"_5":14373,"_27457":49905,"_2948":50018},[],"While the flag is enabled, every `helm upgrade` creates the `<chart fullname>-ca-to-kms-migration` Job (`lamassu-ca-to-kms-migration` for release `lamassu`); a fresh install does not create it. Its hook weight is `-10`, so it runs before the other pre-upgrade hooks: the authorization bootstrap configuration (weight `-4`) and the database-migration Job (weight `-3`).",{"_3465":261,"_30219":212,"_20927":50020,"_5":14373,"_27457":49905,"_2948":50021},[],"The Job consumes the same KMS service configuration the chart renders into the KMS ConfigMap, including the engines from `services.kms.cryptoEngines`, and runs the migration tool defined in `migrations.caToKms.image`. It mounts that configuration read-only at `/etc/lamassuiot/config.yml` from the ConfigMap key `config`, so configure the destination engine in your values before the upgrade that performs the migration.",{"_3465":262,"_30219":212,"_20927":50023,"_5":14373,"_27457":49905,"_2948":50024},[],"The Job resolves its configuration through a projected volume with two optional sources: the release-scoped `<chart fullname>-kms-config` (`lamassu-kms-config` for release `lamassu`, `prod-lamassu-kms-config` for release `prod`) and the legacy unscoped `kms-config` created by chart versions before release-scoped naming. The legacy configuration remains authoritative while it is still present, and the release-scoped one is used once the legacy one is gone. Both sources are optional, so a missing ConfigMap never leaves the upgrade pod in `ContainerCreating`.",{"_3465":263,"_30219":212,"_20927":50026,"_5":14373,"_27457":49905,"_2948":50027},[],"Keep `migrations.caToKms.enabled: true` for the upgrade that performs the migration, then remove the flag from your values once the migration completes; it defaults to `false`.",{"_3465":264,"_30219":212,"_20927":50029,"_5":14373,"_27457":49909,"_2948":50030},[],"Before going live, review:",{"_3465":265,"_30219":212,"_20927":50032,"_5":14373,"_27457":49909,"_2948":50033},[],"backup and recovery for PostgreSQL and persistent volumes",{"_3465":266,"_30219":212,"_20927":50035,"_5":14373,"_27457":49909,"_2948":50036},[],"a production KMS engine; the default filesystem engine is not an HA design",{"_3465":267,"_30219":212,"_20927":50038,"_5":14373,"_27457":49909,"_2948":50039},[],"shared VA storage before increasing VA replicas",{"_3465":268,"_30219":212,"_20927":50041,"_5":14373,"_27457":49909,"_2948":50042},[],"managed OIDC roles and removal of evaluation credentials",{"_3465":269,"_30219":212,"_20927":50044,"_5":14373,"_27457":49909,"_2948":50045},[],"a trusted TLS issuer or externally managed certificate",{"_3465":270,"_30219":212,"_20927":50047,"_5":14373,"_27457":49909,"_2948":50048},[],"resource requests, replicas, autoscaling, disruption budgets and placement",{"_3465":271,"_30219":212,"_20927":50050,"_5":14373,"_27457":49909,"_2948":50051},[],"SMTP, observability and alert delivery",{"_3465":272,"_30219":212,"_20927":50053,"_5":14373,"_27457":49909,"_2948":50054},[],"the version upgrade guides and migration notes in `charts/lamassu/CHANGELOG/` before every upgrade, including the optional CA-to-KMS migration hook described above",{"_3465":273,"_30219":212,"_20927":50056,"_5":14373,"_27457":49909,"_2948":50057},[],"The complete values reference is maintained in `charts/lamassu/VALUES.md` in the Helm repository.",{"_3465":274,"_30219":274,"_5":14725,"_2948":50059,"_30551":50060,"_20927":50061,"_27457":274},"Expose the Gateway",[49254,49255,49361],[],{"_3465":275,"_30219":274,"_20927":50063,"_5":14373,"_27457":274,"_2948":50064},[],"Choose how clients reach Lamassu, when to set gateway.addresses and how to design multiple Gateways.",{"_3465":276,"_30219":274,"_5":30548,"_20927":50066,"_27457":50067,"_2948":50068},[],"/docs/deployment/self-hosted/networking#expose-the-lamassu-gateway","Expose the Lamassu Gateway",{"_3465":277,"_30219":274,"_5":30548,"_20927":50070,"_27457":50071,"_2948":50072},[],"/docs/deployment/self-hosted/networking#do-you-need-gatewayaddresses","Do you need `gateway.addresses`?",{"_3465":278,"_30219":274,"_5":30548,"_20927":50074,"_27457":50075,"_2948":50076},[],"/docs/deployment/self-hosted/networking#recommended-single-node-design","Recommended single-node design",{"_3465":279,"_30219":274,"_5":30548,"_20927":50078,"_27457":50079,"_2948":50080},[],"/docs/deployment/self-hosted/networking#k3s","K3s",{"_3465":280,"_30219":274,"_5":30548,"_20927":50082,"_27457":50083,"_2948":50084},[],"/docs/deployment/self-hosted/networking#bare-metal-with-metallb-or-kube-vip","Bare metal with MetalLB or kube-vip",{"_3465":281,"_30219":274,"_5":30548,"_20927":50086,"_27457":50087,"_2948":50088},[],"/docs/deployment/self-hosted/networking#external-reverse-proxy-nat-or-vpn","External reverse proxy, NAT or VPN",{"_3465":282,"_30219":274,"_5":30548,"_20927":50090,"_27457":50091,"_2948":50092},[],"/docs/deployment/self-hosted/networking#what-if-you-need-three-gateways","What if you need three Gateways?",{"_3465":283,"_30219":274,"_5":30548,"_20927":50094,"_27457":50095,"_2948":50096},[],"/docs/deployment/self-hosted/networking#client-certificates-and-identity-headers","Client certificates and identity headers",{"_3465":284,"_30219":274,"_5":30548,"_20927":50098,"_27457":50099,"_2948":50100},[],"/docs/deployment/self-hosted/networking#decision-guide","Decision guide",{"_3465":285,"_30219":274,"_5":30548,"_20927":50102,"_27457":50103,"_2948":50104},[],"/docs/deployment/self-hosted/networking#egress-proxy","Egress proxy",{"_3465":286,"_30219":274,"_5":30548,"_20927":50106,"_27457":50107,"_2948":50108},[],"/docs/deployment/self-hosted/networking#verify-the-traffic-path","Verify the traffic path",{"_3465":287,"_30219":274,"_20927":50110,"_5":14373,"_27457":50067,"_2948":50111},[],"The Lamassu chart creates one shared Gateway with HTTP and HTTPS listeners. Envoy Gateway normally creates a dedicated proxy deployment and a `LoadBalancer` Service for it.",{"_3465":288,"_30219":274,"_20927":50113,"_5":14373,"_27457":50067,"_2948":50114},[],"External reachability is the result of the whole path. A `Gateway` resource alone does not configure your router, firewall, DNS, cloud load balancer or upstream NAT.",{"_3465":289,"_30219":274,"_20927":50116,"_5":14373,"_27457":50071,"_2948":50117},[],"Usually, no. If you omit it, the Gateway controller and the cluster load-balancer implementation can assign an address and report it in `Gateway.status.addresses` and the generated Service status.",{"_3465":290,"_30219":274,"_20927":50119,"_5":14373,"_27457":50071,"_2948":50120},[],"Set it only when:",{"_3465":291,"_30219":274,"_20927":50122,"_5":14373,"_27457":50071,"_2948":50123},[],"your cloud or bare-metal load balancer supports requesting a specific address",{"_3465":292,"_30219":274,"_20927":50125,"_5":14373,"_27457":50071,"_2948":50126},[],"that address is allocated to this Gateway",{"_3465":293,"_30219":274,"_20927":50128,"_5":14373,"_27457":50071,"_2948":50129},[],"the surrounding network already routes traffic for it to the cluster",{"_3465":294,"_30219":274,"_20927":50131,"_5":14373,"_27457":50071,"_2948":50132},[],"This requests `192.168.1.50`; it does not claim the IP on your LAN or make it reachable.",{"_3465":295,"_30219":274,"_20927":50134,"_5":14373,"_27457":50071,"_2948":50135},[],"Keep these two settings separate:",{"_3465":296,"_30219":274,"_20927":50137,"_5":14373,"_27457":50071,"_2948":50138},[],"`gateway.addresses` requests an address for the Gateway.",{"_3465":297,"_30219":274,"_20927":50140,"_5":14373,"_27457":50071,"_2948":50141},[],"`tls.certManagerOptions.certSpec.addresses` adds IP subject alternative names to the TLS certificate.",{"_3465":298,"_30219":274,"_20927":50143,"_5":14373,"_27457":50071,"_2948":50144},[],"If users connect by DNS name, put that name in `tls.certManagerOptions.certSpec.hostnames`. Do not copy an upstream proxy's public IP into `gateway.addresses`.",{"_3465":299,"_30219":274,"_20927":50146,"_5":14373,"_27457":50075,"_2948":50147},[],"For a small VM running K3s or MicroK8s, use one external Lamassu Gateway and route every Lamassu endpoint through it:",{"_3465":300,"_30219":274,"_20927":50149,"_5":14373,"_27457":50075,"_2948":50150},[],"This design uses one IP, one TLS entry point and one pair of ports. The chart already creates the required routes.",{"_3465":301,"_30219":274,"_20927":50152,"_5":14373,"_27457":50079,"_2948":50153},[],"K3s ServiceLB implements each `LoadBalancer` Service with pods that reserve the Service ports on the node. On a single node, only one Service can therefore own port 80 and one can own port 443. The default K3s Traefik Service may already hold both ports.",{"_3465":302,"_30219":274,"_20927":50155,"_5":14373,"_27457":50079,"_2948":50156},[],"For the recommended design:",{"_3465":303,"_30219":274,"_20927":50158,"_5":14373,"_27457":50079,"_2948":50159},[],"Use only one externally exposed Lamassu Gateway.",{"_3465":304,"_30219":274,"_20927":50161,"_5":14373,"_27457":50079,"_2948":50162},[],"Ensure ports 80 and 443 are free. Disable or reconfigure Traefik if it is not part of your traffic path.",{"_3465":305,"_30219":274,"_20927":50164,"_5":14373,"_27457":50079,"_2948":50165},[],"Allow those ports through the VM firewall and any upstream security group.",{"_3465":306,"_30219":274,"_20927":50167,"_5":14373,"_27457":50079,"_2948":50168},[],"Point DNS at the VM's reachable address.",{"_3465":307,"_30219":274,"_20927":50170,"_5":14373,"_27457":50079,"_2948":50171},[],"See the K3s ServiceLB documentation for its host-port behavior and how to replace it with another load-balancer implementation.",{"_3465":308,"_30219":274,"_20927":50173,"_5":14373,"_27457":50083,"_2948":50174},[],"Allocate a VIP from an address pool reachable on your LAN. You may request that VIP with `gateway.addresses` if the selected implementation supports it. Confirm the assigned address in status rather than assuming the request succeeded.",{"_3465":309,"_30219":274,"_20927":50176,"_5":14373,"_27457":50087,"_2948":50177},[],"An external public address can forward TCP 80 and 443 to the VM or to a Kubernetes-side VIP:",{"_3465":310,"_30219":274,"_20927":50179,"_5":14373,"_27457":50087,"_2948":50180},[],"The public IP belongs to the external device. Leave `gateway.addresses` unset or set it to the actual Kubernetes-side address, never to an address that the cluster cannot bind.",{"_3465":311,"_30219":274,"_20927":50182,"_5":14373,"_27457":50091,"_2948":50183},[],"First decide whether you need three independent data planes or only three hostnames.",{"_3465":312,"_30219":274,"_20927":50185,"_5":14373,"_27457":50091,"_2948":50186},[],"Requirement",{"_3465":313,"_30219":274,"_20927":50188,"_5":14373,"_27457":50091,"_2948":50189},[],"Recommended design",{"_3465":314,"_30219":274,"_20927":50191,"_5":14373,"_27457":50091,"_2948":50192},[],"Consequence",{"_3465":315,"_30219":274,"_20927":50194,"_5":14373,"_27457":50091,"_2948":50195},[],"Several Lamassu URLs or services",{"_3465":316,"_30219":274,"_20927":50197,"_5":14373,"_27457":50091,"_2948":50198},[],"One Gateway with multiple routes",{"_3465":317,"_30219":274,"_20927":50200,"_5":14373,"_27457":50091,"_2948":50201},[],"One IP and one proxy fleet; this is the chart default",{"_3465":318,"_30219":274,"_20927":50203,"_5":14373,"_27457":50091,"_2948":50204},[],"Independent Gateways and separate external IPs",{"_3465":319,"_30219":274,"_20927":50206,"_5":14373,"_27457":50091,"_2948":50207},[],"One VIP per Gateway",{"_3465":320,"_30219":274,"_20927":50209,"_5":14373,"_27457":50091,"_2948":50210},[],"All Gateways can use 80/443; requires a load balancer with an address pool",{"_3465":321,"_30219":274,"_20927":50212,"_5":14373,"_27457":50091,"_2948":50213},[],"Independent Gateways on one node and one IP",{"_3465":322,"_30219":274,"_20927":50215,"_5":14373,"_27457":50091,"_2948":50216},[],"Use different external ports",{"_3465":323,"_30219":274,"_20927":50218,"_5":14373,"_27457":50091,"_2948":50219},[],"Clients must include non-standard ports",{"_3465":324,"_30219":274,"_20927":50221,"_5":14373,"_27457":50091,"_2948":50222},[],"Separate TLS/mTLS termination behind one IP",{"_3465":325,"_30219":274,"_20927":50224,"_5":14373,"_27457":50091,"_2948":50225},[],"Front-door SNI routing to internal Gateways",{"_3465":326,"_30219":274,"_20927":50227,"_5":14373,"_27457":50091,"_2948":50228},[],"Advanced design; the front door uses TLS passthrough and each internal Gateway terminates its own TLS",{"_3465":327,"_30219":274,"_20927":50230,"_5":14373,"_27457":50091,"_2948":50231},[],"Separate Gateway resources but shared proxy infrastructure",{"_3465":328,"_30219":274,"_20927":50233,"_5":14373,"_27457":50091,"_2948":50234},[],"Envoy merged-Gateway mode",{"_3465":329,"_30219":274,"_20927":50236,"_5":14373,"_27457":50091,"_2948":50237},[],"Logical separation only; listeners must have unique port, protocol and hostname tuples",{"_3465":330,"_30219":274,"_20927":50239,"_5":14373,"_27457":50091,"_2948":50240},[],"Three independent `LoadBalancer` Services cannot all reserve the same node ports 80 and 443 through K3s ServiceLB. Use one shared Gateway, allocate distinct VIPs with another load-balancer implementation, or use different ports.",{"_3465":331,"_30219":274,"_20927":50242,"_5":14373,"_27457":50091,"_2948":50243},[],"Envoy Gateway normally provisions a proxy fleet per `Gateway`. Its merged-Gateway mode can share one fleet and address, but it is not a drop-in switch for multiple Lamassu releases: the generated Lamassu listeners use the same ports and protocols without distinct hostnames, so they conflict unless you deliberately customize the listener design.",{"_3465":332,"_30219":274,"_20927":50245,"_5":14373,"_27457":50091,"_2948":50246},[],"Use a front-door SNI design only when the internal Gateways must retain independent TLS or mTLS policy:",{"_3465":333,"_30219":274,"_20927":50248,"_5":14373,"_27457":50091,"_2948":50249},[],"This requires distinct SNI hostnames and cluster networking outside the Lamassu chart.",{"_3465":334,"_30219":274,"_20927":50251,"_5":14373,"_27457":50095,"_2948":50252},[],"The chart renders a `ClientTrafficPolicy` named `enable-mtls` on its shared Gateway automatically; no Helm value enables or disables it. TLS termination accepts requests with or without a client certificate: devices may present one, but they are not required to. Before forwarding a request, the Gateway removes identity and certificate headers that a client could otherwise supply itself: `X-Principal-Id`, `X-Lms-Source`, `X-Forwarded-Client-Cert`, `X-Forwarded-Cert`, `X-Forwarded-Tls-Client-Cert` (the Traefik spelling), `Ssl-Client-Cert` and `X-Amzn-Mtls-Clientcert`. The Traefik spelling is included because backends that accept `X-Forwarded-Tls-Client-Cert` directly would otherwise receive certificate identity data supplied by the client itself, without a client certificate having been presented. After stripping, Envoy adds its own `X-Forwarded-Client-Cert` carrying the presented certificate and its chain, so services that read certificate identity receive only gateway-generated values. No Helm value changes the list of stripped headers. The Access control page describes how `authz` uses this protection to keep `X-Principal-ID` out of reach of clients.",{"_3465":335,"_30219":274,"_20927":50254,"_5":14373,"_27457":50099,"_2948":50255},[],"If one Gateway can own TLS and routing, use the chart default.",{"_3465":336,"_30219":274,"_20927":50257,"_5":14373,"_27457":50099,"_2948":50258},[],"If Gateways need independent policy and you can allocate IPs, use one VIP per Gateway.",{"_3465":337,"_30219":274,"_20927":50260,"_5":14373,"_27457":50099,"_2948":50261},[],"If only the Kubernetes resources need separation, evaluate merged-Gateway mode and make every listener tuple unique.",{"_3465":338,"_30219":274,"_20927":50263,"_5":14373,"_27457":50099,"_2948":50264},[],"If data planes and TLS termination must stay independent behind one IP, add a front-door SNI passthrough layer.",{"_3465":339,"_30219":274,"_20927":50266,"_5":14373,"_27457":50099,"_2948":50267},[],"If none of those are possible, use different external ports or change the external network design.",{"_3465":340,"_30219":274,"_20927":50269,"_5":14373,"_27457":50103,"_2948":50270},[],"Internal Lamassu clients — the Vault engine connection, service-to-service calls and webhook deliveries — honor the `HTTP_PROXY`, `HTTPS_PROXY` and `NO_PROXY` environment variables. The exception is the authorization-engine connector: it uses its own transport and does not consult these proxy variables. If your deployment routes egress through a proxy, list in-cluster service names in `NO_PROXY` (for example `.svc,.cluster.local`) so internal traffic stays inside the cluster. Loopback traffic is never sent through a proxy.",{"_3465":341,"_30219":274,"_20927":50272,"_5":14373,"_27457":50103,"_2948":50273},[],"The default transport of these clients bounds the dial timeout (30 seconds), the TLS handshake (10 seconds) and idle connection reuse (90 seconds) so an unreachable dependency fails fast instead of hanging; these values are Go transport defaults, not Lamassu settings. HTTP/2 is negotiated when the peer supports it. The authorization-engine connector keeps its own transport without these dial and handshake timeouts; only its overall 30-second request timeout bounds each call.",{"_3465":342,"_30219":274,"_20927":50275,"_5":14373,"_27457":50107,"_2948":50276},[],"Check, in order:",{"_3465":343,"_30219":274,"_20927":50278,"_5":14373,"_27457":50107,"_2948":50279},[],"`Gateway` has `Accepted=True` and `Programmed=True`.",{"_3465":344,"_30219":274,"_20927":50281,"_5":14373,"_27457":50107,"_2948":50282},[],"Its status contains the expected address.",{"_3465":345,"_30219":274,"_20927":50284,"_5":14373,"_27457":50107,"_2948":50285},[],"The generated `LoadBalancer` Service has a usable external address.",{"_3465":346,"_30219":274,"_20927":50287,"_5":14373,"_27457":50107,"_2948":50288},[],"Port 443 reaches that address from the client network.",{"_3465":347,"_30219":274,"_20927":50290,"_5":14373,"_27457":50107,"_2948":50291},[],"DNS resolves to the externally reachable endpoint.",{"_3465":348,"_30219":274,"_20927":50293,"_5":14373,"_27457":50107,"_2948":50294},[],"The certificate contains the DNS name or IP used by the client.",{"_3465":349,"_30219":274,"_20927":50296,"_5":14373,"_27457":50107,"_2948":50297},[],"The Gateway API treats addresses as desired state that a controller may assign or reject; see the Gateway API overview for the resource model.",{"_3465":350,"_30219":350,"_5":14725,"_2948":49361,"_30551":50299,"_20927":50300,"_27457":350},[49254,49255,49361],[],{"_3465":351,"_30219":350,"_20927":50302,"_5":14373,"_27457":350,"_2948":50303},[],"Choose an installation workflow and network architecture for Lamassu on your Kubernetes cluster.",{"_3465":352,"_30219":350,"_5":30548,"_20927":50305,"_27457":50306,"_2948":50307},[],"/docs/deployment/self-hosted/overview#self-managed-kubernetes-deployment","Self-managed Kubernetes deployment",{"_3465":353,"_30219":350,"_5":30548,"_20927":50309,"_27457":50310,"_2948":50311},[],"/docs/deployment/self-hosted/overview#choose-an-installation-workflow","Choose an installation workflow",{"_3465":354,"_30219":350,"_5":30548,"_20927":50313,"_27457":50314,"_2948":50315},[],"/docs/deployment/self-hosted/overview#what-the-lamassu-chart-provides","What the Lamassu chart provides",{"_3465":355,"_30219":350,"_5":30548,"_20927":50317,"_27457":50318,"_2948":50319},[],"/docs/deployment/self-hosted/overview#how-the-deployment-fits-together","How the deployment fits together",{"_3465":356,"_30219":350,"_5":30548,"_20927":50321,"_27457":50322,"_2948":50323},[],"/docs/deployment/self-hosted/overview#platform-requirements","Platform requirements",{"_3465":357,"_30219":350,"_5":30548,"_20927":50325,"_27457":50326,"_2948":50327},[],"/docs/deployment/self-hosted/overview#choose-the-next-page","Choose the next page",{"_3465":358,"_30219":350,"_20927":50329,"_5":14373,"_27457":50306,"_2948":50330},[],"Run Lamassu in a Kubernetes cluster operated by your team. The Helm chart deploys the Lamassu services and their routing resources; you provide the cluster, persistent storage, identity provider, PostgreSQL, RabbitMQ and the network path used by clients.",{"_3465":359,"_30219":350,"_20927":50332,"_5":14373,"_27457":50310,"_2948":50333},[],"Workflow",{"_3465":360,"_30219":350,"_20927":50335,"_5":14373,"_27457":50310,"_2948":50336},[],"Use it for",{"_3465":361,"_30219":350,"_20927":50338,"_5":14373,"_27457":50310,"_2948":50339},[],"What it installs",{"_3465":362,"_30219":350,"_20927":50341,"_5":14373,"_27457":50310,"_2948":50342},[],"Helm",{"_3465":363,"_30219":350,"_20927":50344,"_5":14373,"_27457":50310,"_2948":50345},[],"Production and controlled environments",{"_3465":364,"_30219":350,"_20927":50347,"_5":14373,"_27457":50310,"_2948":50348},[],"Lamassu services and Gateway API resources",{"_3465":365,"_30219":350,"_20927":50350,"_5":14373,"_27457":50310,"_2948":49498},[],{"_3465":366,"_30219":350,"_20927":50352,"_5":14373,"_27457":50310,"_2948":50353},[],"Evaluation, demos, CI and small lab clusters",{"_3465":367,"_30219":350,"_20927":50355,"_5":14373,"_27457":50310,"_2948":50356},[],"PostgreSQL, Keycloak, RabbitMQ, Envoy Gateway and Lamassu",{"_3465":368,"_30219":350,"_20927":50358,"_5":14373,"_27457":50314,"_2948":50359},[],"The Lamassu chart is an **application chart**, not a cluster bootstrap chart. It creates the Kubernetes resources that run and configure Lamassu, but it expects the platform services those resources depend on to exist.",{"_3465":369,"_30219":350,"_20927":50361,"_5":14373,"_27457":50314,"_2948":50362},[],"Area",{"_3465":370,"_30219":350,"_20927":50364,"_5":14373,"_27457":50314,"_2948":50365},[],"The Lamassu chart provides",{"_3465":371,"_30219":350,"_20927":50367,"_5":14373,"_27457":50314,"_2948":50368},[],"You provide",{"_3465":372,"_30219":350,"_20927":50370,"_5":14373,"_27457":50314,"_2948":50371},[],"Lamassu applications",{"_3465":373,"_30219":350,"_20927":50373,"_5":14373,"_27457":50314,"_2948":50374},[],"Deployments and StatefulSets for the UI and APIs, internal Services, ConfigMaps, a ServiceAccount, and optional HPAs and PDBs",{"_3465":374,"_30219":350,"_20927":50376,"_5":14373,"_27457":50314,"_2948":50377},[],"A working Kubernetes cluster, compute capacity and access to the container images",{"_3465":375,"_30219":350,"_20927":50379,"_5":14373,"_27457":50314,"_2948":50380},[],"PostgreSQL data",{"_3465":376,"_30219":350,"_20927":50382,"_5":14373,"_27457":50314,"_2948":50383},[],"A pre-install/pre-upgrade job that creates the required databases and schemas, runs migrations and applies the authorization bootstrap",{"_3465":377,"_30219":350,"_20927":50385,"_5":14373,"_27457":50314,"_2948":50386},[],"A reachable PostgreSQL server, credentials allowed to create databases and schemas, and backup/HA operations",{"_3465":378,"_30219":350,"_20927":50388,"_5":14373,"_27457":50314,"_2948":50389},[],"Messaging",{"_3465":379,"_30219":350,"_20927":50391,"_5":14373,"_27457":50314,"_2948":50392},[],"RabbitMQ connection configuration for the Lamassu services; the connection can use AMQPS, with an optional private CA and an optional client certificate, both set through chart values",{"_3465":380,"_30219":350,"_20927":50394,"_5":14373,"_27457":50314,"_2948":50395},[],"A reachable RabbitMQ broker, credentials and its lifecycle",{"_3465":381,"_30219":350,"_20927":50397,"_5":14373,"_27457":50314,"_2948":50398},[],"Identity",{"_3465":382,"_30219":350,"_20927":50400,"_5":14373,"_27457":50314,"_2948":50401},[],"OIDC/JWT and external-authorization configuration, plus initial Lamassu authorization principals",{"_3465":383,"_30219":350,"_20927":50403,"_5":14373,"_27457":50314,"_2948":50404},[],"An OIDC provider, realm/tenant, client, users, groups and roles",{"_3465":384,"_30219":350,"_20927":50406,"_5":14373,"_27457":50314,"_2948":50407},[],"External routing",{"_3465":385,"_30219":350,"_20927":50409,"_5":14373,"_27457":50314,"_2948":50410},[],"One `Gateway`, `HTTPRoute` resources, an `EnvoyProxy` configuration and Envoy security policies",{"_3465":386,"_30219":350,"_20927":50412,"_5":14373,"_27457":50314,"_2948":50413},[],"Gateway API and Envoy CRDs, the Envoy Gateway controller, a `GatewayClass`, a load-balancer implementation and the external network path",{"_3465":387,"_30219":350,"_20927":50415,"_5":14373,"_27457":50314,"_2948":50416},[],"TLS",{"_3465":388,"_30219":350,"_20927":50418,"_5":14373,"_27457":50314,"_2948":50419},[],"In the default `tls.type: certManager` mode, cert-manager `Issuer` and CA `Certificate` resources and a chart-managed downstream `Certificate`; in the `tls.type: external` mode, a reference to your TLS Secret",{"_3465":389,"_30219":350,"_20927":50421,"_5":14373,"_27457":50314,"_2948":50422},[],"cert-manager only for the default `tls.type: certManager` mode; for trusted TLS, a trusted issuer or a populated TLS Secret",{"_3465":390,"_30219":350,"_20927":50424,"_5":14373,"_27457":50314,"_2948":50425},[],"Persistent application data",{"_3465":391,"_30219":350,"_20927":50427,"_5":14373,"_27457":50314,"_2948":50428},[],"PersistentVolumeClaims required by the default local KMS and VA storage",{"_3465":392,"_30219":350,"_20927":50430,"_5":14373,"_27457":50314,"_2948":50431},[],"A StorageClass, physical storage, backups and a shared/external backend when scaling requires one",{"_3465":393,"_30219":350,"_20927":50433,"_5":14373,"_27457":50314,"_2948":50434},[],"Optional integrations",{"_3465":394,"_30219":350,"_20927":50436,"_5":14373,"_27457":50314,"_2948":50437},[],"Configuration hooks for observability, AWS connectors and PKCS#11/HSM connectivity",{"_3465":395,"_30219":350,"_20927":50439,"_5":14373,"_27457":50314,"_2948":50440},[],"The observability backends, cloud credentials and production HSM or external key service",{"_3465":396,"_30219":350,"_20927":50442,"_5":14373,"_27457":50314,"_2948":50443},[],"The chart creates Lamassu's `Gateway` and routes. It does not install the Envoy Gateway controller or make the generated `LoadBalancer` Service reachable from your network.",{"_3465":397,"_30219":350,"_20927":50445,"_5":14373,"_27457":50314,"_2948":50446},[],"Use one Lamassu Gateway on ports 80 and 443 and let its HTTPRoutes dispatch traffic to every Lamassu service. Give that Gateway one externally reachable endpoint through the cluster load balancer, or forward traffic to it from an external proxy or NAT device. You do not need one Gateway per service.",{"_3465":398,"_30219":350,"_20927":50448,"_5":14373,"_27457":50318,"_2948":50449},[],"The chart creates one shared `Gateway` per Helm release. All chart-managed `HTTPRoute` resources attach to it. Envoy Gateway provisions the proxy data plane and a Kubernetes `LoadBalancer` Service for that Gateway.",{"_3465":399,"_30219":350,"_20927":50451,"_5":14373,"_27457":50318,"_2948":50452},[],"The `gateway.addresses` value is only an address request to the Gateway controller. It does not make an IP routable, open a firewall, configure DNS or create NAT. See Expose the Gateway before setting it.",{"_3465":400,"_30219":350,"_20927":50454,"_5":14373,"_27457":50322,"_2948":50455},[],"Kubernetes 1.24 or newer",{"_3465":401,"_30219":350,"_20927":50457,"_5":14373,"_27457":50322,"_2948":50458},[],"Helm 3.2 or newer",{"_3465":402,"_30219":350,"_20927":50460,"_5":14373,"_27457":50322,"_2948":50461},[],"Envoy Gateway 1.8 or newer and a `GatewayClass`",{"_3465":403,"_30219":350,"_20927":50463,"_5":14373,"_27457":50322,"_2948":50464},[],"cert-manager 1.14 or newer; required only for the default `tls.type: certManager` TLS mode, not for `tls.type: external`",{"_3465":404,"_30219":350,"_20927":50466,"_5":14373,"_27457":50322,"_2948":50467},[],"persistent storage suitable for the selected PostgreSQL, RabbitMQ, VA and KMS configuration",{"_3465":405,"_30219":350,"_20927":50469,"_5":14373,"_27457":50322,"_2948":50470},[],"a load-balancer implementation or another deliberate path from clients to the Gateway",{"_3465":406,"_30219":350,"_20927":50472,"_5":14373,"_27457":50322,"_2948":50473},[],"KMS deployments using the native PKCS#11 sidecar require Kubernetes 1.29 or newer. Prebuilt Lamassu container images are published for `linux/amd64` and `linux/arm64`, and the KMS PKCS#11 client module (`p11-kit-client.so`) is installed at the target architecture's Debian library path: `/usr/lib/x86_64-linux-gnu/pkcs11/p11-kit-client.so` on amd64 and `/usr/lib/aarch64-linux-gnu/pkcs11/p11-kit-client.so` on arm64. The x86\\_64 path is retained as a compatibility alias for existing configurations.",{"_3465":407,"_30219":350,"_20927":50475,"_5":14373,"_27457":50326,"_2948":50476},[],"<Card title=\"Install with Helm\" description=\"Prepare dependencies, configure values, install and verify a controlled deployment.\" href=\"/docs/deployment/self-hosted/helm\" />",{"_3465":408,"_30219":350,"_20927":50478,"_5":14373,"_27457":50326,"_2948":50479},[],"<Card title=\"Upgrade from 3.8.0\" description=\"Upgrade an existing Helm release to 4.0.0: architecture changes, breaking changes, migration steps and validation.\" href=\"/docs/upgrades/3-8-0-to-4-0-0\" />",{"_3465":409,"_30219":350,"_20927":50481,"_5":14373,"_27457":50326,"_2948":50482},[],"<Card title=\"Expose the Gateway\" description=\"Choose an external traffic design, understand gateway.addresses and handle multiple Gateways.\" href=\"/docs/deployment/self-hosted/networking\" />",{"_3465":410,"_30219":350,"_20927":50484,"_5":14373,"_27457":50326,"_2948":50485},[],"<Card title=\"Use Fastlane\" description=\"Bootstrap a complete evaluation or lab environment with one script.\" href=\"/docs/deployment/self-hosted/fastlane\" />",{"_3465":411,"_30219":411,"_5":14725,"_2948":50487,"_30551":50488,"_20927":50490,"_27457":411},"Deployment troubleshooting",[49254,49255,50489],"Operations",[],{"_3465":412,"_30219":411,"_20927":50492,"_5":14373,"_27457":411,"_2948":50493},[],"Diagnose access, service health and infrastructure dependencies.",{"_3465":413,"_30219":411,"_5":30548,"_20927":50495,"_27457":50496,"_2948":50497},[],"/docs/deployment/troubleshooting#diagnostic-sequence","Diagnostic sequence",{"_3465":414,"_30219":411,"_5":30548,"_20927":50499,"_27457":50500,"_2948":50501},[],"/docs/deployment/troubleshooting#reproduce-a-single-operation","Reproduce a single operation",{"_3465":415,"_30219":411,"_5":30548,"_20927":50503,"_27457":50504,"_2948":50505},[],"/docs/deployment/troubleshooting#separate-client-gateway-and-service","Separate client, Gateway and service",{"_3465":416,"_30219":411,"_5":30548,"_20927":50507,"_27457":50508,"_2948":50509},[],"/docs/deployment/troubleshooting#review-kubernetes-status","Review Kubernetes status",{"_3465":417,"_30219":411,"_5":30548,"_20927":50511,"_27457":50512,"_2948":50513},[],"/docs/deployment/troubleshooting#query-the-affected-service","Query the affected service",{"_3465":418,"_30219":411,"_5":30548,"_20927":50515,"_27457":50516,"_2948":50517},[],"/docs/deployment/troubleshooting#validate-the-result-from-outside","Validate the result from outside",{"_3465":419,"_30219":411,"_5":30548,"_20927":50519,"_27457":50520,"_2948":50521},[],"/docs/deployment/troubleshooting#minimal-evidence-collection","Minimal evidence collection",{"_3465":420,"_30219":411,"_5":30548,"_20927":50523,"_27457":50524,"_2948":50525},[],"/docs/deployment/troubleshooting#i-cannot-sign-in","I cannot sign in",{"_3465":421,"_30219":411,"_5":30548,"_20927":50527,"_27457":50528,"_2948":50529},[],"/docs/deployment/troubleshooting#everything-returns-403-or-5xx","Everything returns 403 or 5xx",{"_3465":422,"_30219":411,"_5":30548,"_20927":50531,"_27457":50532,"_2948":50533},[],"/docs/deployment/troubleshooting#api-500-errors","API 500 errors",{"_3465":423,"_30219":411,"_5":30548,"_20927":50535,"_27457":50536,"_2948":50537},[],"/docs/deployment/troubleshooting#a-pod-is-not-ready","A pod is not Ready",{"_3465":424,"_30219":411,"_5":30548,"_20927":50539,"_27457":50540,"_2948":50541},[],"/docs/deployment/troubleshooting#events-are-not-arriving","Events are not arriving",{"_3465":425,"_30219":411,"_5":30548,"_20927":50543,"_27457":50544,"_2948":50545},[],"/docs/deployment/troubleshooting#observability","Observability",{"_3465":426,"_30219":411,"_20927":50547,"_5":14373,"_27457":411,"_2948":50548},[],"Start by locating the failing layer. A Gateway response and an unready pod require different evidence. For rejected issuance or validation results, see PKI troubleshooting; for enrollment, see EST diagnostics.",{"_3465":427,"_30219":411,"_20927":50550,"_5":14373,"_27457":50500,"_2948":50551},[],"Note the time in UTC, user or principal, resource, endpoint and result. Avoid repeating a destructive action such as revocation or deletion.",{"_3465":428,"_30219":411,"_20927":50553,"_5":14373,"_27457":50504,"_2948":50554},[],"Check the HTTP status. A 401 points to authentication; a 403, to authorization; a 404, to route or resource; a 5xx, to the service or a dependency.",{"_3465":429,"_30219":411,"_20927":50556,"_5":14373,"_27457":50508,"_2948":50557},[],"Locate unready pods, restarts, recent events and the state of the release.",{"_3465":430,"_30219":411,"_20927":50559,"_5":14373,"_27457":50512,"_2948":50560},[],"Review its /health endpoint and its logs in the same time window. Then follow the indicated dependency: PostgreSQL, RabbitMQ, the OIDC provider or the cryptographic engine.",{"_3465":431,"_30219":411,"_20927":50562,"_5":14373,"_27457":50516,"_2948":50563},[],"For PKI, check the certificate, the chain, OCSP or CRL with the same type of client production uses.",{"_3465":432,"_30219":411,"_20927":50565,"_5":14373,"_27457":50520,"_2948":50566},[],"Replace the placeholders with your real release, namespace and deployment.",{"_3465":433,"_30219":411,"_20927":50568,"_5":14373,"_27457":50520,"_2948":50569},[],"Also run the chart's connectivity test:",{"_3465":434,"_30219":411,"_20927":50571,"_5":14373,"_27457":50520,"_2948":50572},[],"The test checks the health of CA, DMS Manager, Device Manager and VA, and verifies that the UI returns HTML. A passing test confirms basic connectivity, not a full issuance flow.",{"_3465":435,"_30219":411,"_20927":50574,"_5":14373,"_27457":50520,"_2948":50575},[],"The chart's services expose startup, readiness and liveness probes over /health. A pod can be running but receive no traffic if the readiness probe fails.",{"_3465":436,"_30219":411,"_20927":50577,"_5":14373,"_27457":50524,"_2948":50578},[],"If you receive a 401:",{"_3465":437,"_30219":411,"_20927":50580,"_5":14373,"_27457":50524,"_2948":50581},[],"check that the UI's OIDC authority is reachable from the browser;",{"_3465":438,"_30219":411,"_20927":50583,"_5":14373,"_27457":50524,"_2948":50584},[],"verify issuer, audience and expiration of the token;",{"_3465":439,"_30219":411,"_20927":50586,"_5":14373,"_27457":50524,"_2948":50587},[],"confirm the Gateway can fetch the keys from the JWKS URI;",{"_3465":440,"_30219":411,"_20927":50589,"_5":14373,"_27457":50524,"_2948":50590},[],"check that the provider's public and internal routes point to the same realm.",{"_3465":441,"_30219":411,"_20927":50592,"_5":14373,"_27457":50524,"_2948":50593},[],"If login succeeds but the APIs return 403:",{"_3465":442,"_30219":411,"_20927":50595,"_5":14373,"_27457":50524,"_2948":50596},[],"inspect the token's real claims;",{"_3465":443,"_30219":411,"_20927":50598,"_5":14373,"_27457":50524,"_2948":50599},[],"confirm they match an active principal;",{"_3465":444,"_30219":411,"_20927":50601,"_5":14373,"_27457":50524,"_2948":50602},[],"review the policies granted to that principal;",{"_3465":445,"_30219":411,"_20927":50604,"_5":14373,"_27457":50524,"_2948":50605},[],"verify that authz reaches PostgreSQL and its JWKS.",{"_3465":446,"_30219":411,"_20927":50607,"_5":14373,"_27457":50524,"_2948":50608},[],"On a fresh installation, confirm the migration Job finished. That Job creates schemas, migrates authz, preloads policies and provisions the principals defined in services.authz.bootstrap.",{"_3465":447,"_30219":411,"_20927":50610,"_5":14373,"_27457":50528,"_2948":50611},[],"External authorization fails closed by default. If authz is unavailable, protected routes are blocked.",{"_3465":448,"_30219":411,"_20927":50613,"_5":14373,"_27457":50528,"_2948":50614},[],"Locate the authz pod and Service.",{"_3465":449,"_30219":411,"_20927":50616,"_5":14373,"_27457":50528,"_2948":50617},[],"Check /health, logs and its database connection.",{"_3465":450,"_30219":411,"_20927":50619,"_5":14373,"_27457":50528,"_2948":50620},[],"Verify the DNS and port configured in externalAuthorization.",{"_3465":451,"_30219":411,"_20927":50622,"_5":14373,"_27457":50528,"_2948":50623},[],"Check the check route is /v1/ext\\_authz/check.",{"_3465":452,"_30219":411,"_20927":50625,"_5":14373,"_27457":50528,"_2948":50626},[],"Do not switch to failOpen: true as a permanent workaround: it would allow traffic without authorization during the outage.",{"_3465":453,"_30219":411,"_20927":50628,"_5":14373,"_27457":50532,"_2948":50629},[],"A 500 indicates an internal failure, such as an unavailable database. The `{\"err\": ...}` body currently includes the text of the internal error, which can contain schema, table and constraint names and, on connection failures, the database host and user (not the password). Find the cause in the service log using the request time, and do not forward the body to third parties or show it to end users. This is a known information-disclosure defect: generic messages are planned for 500 responses, keeping the detail only in the service log (tracked in lamassuiot#814). The authorization connector also returns the internal error, in the `details.error` field. Some request errors, such as a key size the engine does not support, are also returned as 500.",{"_3465":454,"_30219":411,"_20927":50631,"_5":14373,"_27457":50536,"_2948":50632},[],"Review kubectl describe pod first. Common causes are:",{"_3465":455,"_30219":411,"_20927":50634,"_5":14373,"_27457":50536,"_2948":50635},[],"wrong credentials or DNS for PostgreSQL or RabbitMQ;",{"_3465":456,"_30219":411,"_20927":50637,"_5":14373,"_27457":50536,"_2948":50638},[],"a missing AMQP CA or client certificate Secret referenced by `amqp.ca.secretName` or `amqp.client.secretName`;",{"_3465":457,"_30219":411,"_20927":50640,"_5":14373,"_27457":50536,"_2948":50641},[],"unbound persistent volume;",{"_3465":458,"_30219":411,"_20927":50643,"_5":14373,"_27457":50536,"_2948":50644},[],"inaccessible image or incorrect pull policy;",{"_3465":459,"_30219":411,"_20927":50646,"_5":14373,"_27457":50536,"_2948":50647},[],"invalid cryptographic engine configuration;",{"_3465":460,"_30219":411,"_20927":50649,"_5":14373,"_27457":50536,"_2948":50650},[],"CPU or memory limits set too low;",{"_3465":461,"_30219":411,"_20927":50652,"_5":14373,"_27457":50536,"_2948":50653},[],"an incomplete prior migration.",{"_3465":462,"_30219":411,"_20927":50655,"_5":14373,"_27457":50536,"_2948":50656},[],"Generic values request 100 mCPU and 128 MiB and limit to 500 mCPU and 512 MiB. Tune per service when you see OOMKills, throttling or slow startups.",{"_3465":463,"_30219":411,"_20927":50658,"_5":14373,"_27457":50536,"_2948":50659},[],"Filesystem-based KMS engines and VA local storage use exclusive-access volumes. Keep a single replica or migrate to shared backends before enabling autoscaling.",{"_3465":464,"_30219":411,"_20927":50661,"_5":14373,"_27457":50536,"_2948":50662},[],"Internal calls now fail fast instead of hanging for the clients covered by Egress proxy: connection attempts time out after 30 seconds and TLS handshakes after 10 seconds. The authorization-engine connector keeps its own transport without these dial and handshake timeouts; only its overall 30-second request timeout bounds each call. If an egress proxy handles the cluster's outbound traffic, check the pod's `HTTP_PROXY`, `HTTPS_PROXY` and `NO_PROXY` environment variables and list in-cluster service names in `NO_PROXY`.",{"_3465":465,"_30219":411,"_20927":50664,"_5":14373,"_27457":50540,"_2948":50665},[],"Domain and audit events depend on the bus publisher:",{"_3465":466,"_30219":411,"_20927":50667,"_5":14373,"_27457":50540,"_2948":50668},[],"verify it is enabled in the emitting service;",{"_3465":467,"_30219":411,"_20927":50670,"_5":14373,"_27457":50540,"_2948":50671},[],"check AMQP connectivity and credentials;",{"_3465":468,"_30219":411,"_20927":50673,"_5":14373,"_27457":50540,"_2948":50674},[],"review exchange, routing key, queues and consumers;",{"_3465":469,"_30219":411,"_20927":50676,"_5":14373,"_27457":50540,"_2948":50677},[],"inspect dead-letter queues;",{"_3465":470,"_30219":411,"_20927":50679,"_5":14373,"_27457":50540,"_2948":50680},[],"alert on orphan durable queues and backlog growth.",{"_3465":471,"_30219":411,"_20927":50682,"_5":14373,"_27457":50540,"_2948":50683},[],"If `amqp.tls` is enabled, verify the TLS side as well:",{"_3465":472,"_30219":411,"_20927":50685,"_5":14373,"_27457":50540,"_2948":50686},[],"confirm the broker listener speaks AMQPS on the configured port — the default port stays `5672` and does not follow TLS automatically;",{"_3465":473,"_30219":411,"_20927":50688,"_5":14373,"_27457":50540,"_2948":50689},[],"if you set `amqp.ca.secretName`, confirm the Secret exists in the release namespace and its data key matches `amqp.ca.certificateKey` (default `ca.crt`); if `amqp.ca.secretName` is not set, the clients trust the system CAs;",{"_3465":474,"_30219":411,"_20927":50691,"_5":14373,"_27457":50540,"_2948":50692},[],"remember that a missing referenced Secret prevents the consuming pods from starting;",{"_3465":475,"_30219":411,"_20927":50694,"_5":14373,"_27457":50540,"_2948":50695},[],"after updating the CA or client certificate Secret, restart the consuming pods: the AMQP client loads certificates at startup.",{"_3465":476,"_30219":411,"_20927":50697,"_5":14373,"_27457":50540,"_2948":50698},[],"See AMQP TLS (AMQPS) for the full configuration.",{"_3465":477,"_30219":411,"_20927":50700,"_5":14373,"_27457":50540,"_2948":50701},[],"A consumer outage does not always prevent the main operation from completing. That is why you must monitor RabbitMQ and independently verify the persistence of audit logs.",{"_3465":478,"_30219":411,"_20927":50703,"_5":14373,"_27457":50544,"_2948":50704},[],"The chart can enable OpenTelemetry instrumentation for the services that support it, including authz; it does not configure OpenTelemetry for AWS Connector, wfx or the UI. Traces are exported over OTLP HTTP and logs can be directed to a compatible endpoint, such as VictoriaLogs. Use a correlation identifier and the same time window to join Gateway, service and dependency.",{"_3465":479,"_30219":411,"_20927":50706,"_5":14373,"_27457":50544,"_2948":50707},[],"Before closing an incident, record:",{"_3465":480,"_30219":411,"_20927":50709,"_5":14373,"_27457":50544,"_2948":50710},[],"the confirmed cause;",{"_3465":481,"_30219":411,"_20927":50712,"_5":14373,"_27457":50544,"_2948":50713},[],"the time scope and affected resources;",{"_3465":482,"_30219":411,"_20927":50715,"_5":14373,"_27457":50544,"_2948":50716},[],"the commands or queries used;",{"_3465":483,"_30219":411,"_20927":50718,"_5":14373,"_27457":50544,"_2948":50719},[],"the applied change and how to revert it;",{"_3465":484,"_30219":411,"_20927":50721,"_5":14373,"_27457":50544,"_2948":50722},[],"validation from a consumer;",{"_3465":485,"_30219":411,"_20927":50724,"_5":14373,"_27457":50544,"_2948":50725},[],"the preventive action and its owner.",{"_3465":486,"_30219":486,"_5":14725,"_2948":50727,"_30551":50728,"_20927":50731,"_27457":486},"Access control",[49254,50729,50730],"Platform","Administration",[],{"_3465":487,"_30219":486,"_20927":50733,"_5":14373,"_27457":486,"_2948":50734},[],"Design who can access Lamassu through principals, policies, resource permissions and HTTP route authorization.",{"_3465":488,"_30219":486,"_5":30548,"_20927":50736,"_27457":50737,"_2948":50738},[],"/docs/platform/administration/access-control#essential-concepts","Essential concepts",{"_3465":489,"_30219":486,"_5":30548,"_20927":50740,"_27457":50741,"_2948":50742},[],"/docs/platform/administration/access-control#two-decision-systems","Two decision systems",{"_3465":490,"_30219":486,"_5":30548,"_20927":50744,"_27457":50745,"_2948":50746},[],"/docs/platform/administration/access-control#integrated-or-external-http-services","Integrated or external HTTP services",{"_3465":491,"_30219":486,"_5":30548,"_20927":50748,"_27457":50749,"_2948":50750},[],"/docs/platform/administration/access-control#authentication-only-routes-and-unmapped-paths","Authentication-only routes and unmapped paths",{"_3465":492,"_30219":486,"_5":30548,"_20927":50752,"_27457":50753,"_2948":50754},[],"/docs/platform/administration/access-control#services-developed-by-lamassu","Services developed by Lamassu",{"_3465":493,"_30219":486,"_5":30548,"_20927":50756,"_27457":50757,"_2948":50758},[],"/docs/platform/administration/access-control#how-the-two-paths-relate","How the two paths relate",{"_3465":494,"_30219":486,"_5":30548,"_20927":50760,"_27457":50761,"_2948":50762},[],"/docs/platform/administration/access-control#oidc-principals","OIDC principals",{"_3465":495,"_30219":486,"_5":30548,"_20927":50764,"_27457":50765,"_2948":50766},[],"/docs/platform/administration/access-control#x509-principals","X.509 principals",{"_3465":496,"_30219":486,"_5":30548,"_20927":50768,"_27457":50769,"_2948":50770},[],"/docs/platform/administration/access-control#when-several-principals-match","When several principals match",{"_3465":497,"_30219":486,"_5":30548,"_20927":50772,"_27457":50773,"_2948":50774},[],"/docs/platform/administration/access-control#how-policies-express-access","How policies express access",{"_3465":498,"_30219":486,"_5":30548,"_20927":50776,"_27457":50777,"_2948":50778},[],"/docs/platform/administration/access-control#global-and-direct-access","Global and direct access",{"_3465":499,"_30219":486,"_5":30548,"_20927":50780,"_27457":50781,"_2948":50782},[],"/docs/platform/administration/access-control#access-inherited-through-relations","Access inherited through relations",{"_3465":500,"_30219":486,"_5":30548,"_20927":50784,"_27457":50785,"_2948":50786},[],"/docs/platform/administration/access-control#attribute-filtered-access","Attribute-filtered access",{"_3465":501,"_30219":486,"_5":30548,"_20927":50788,"_27457":50789,"_2948":50790},[],"/docs/platform/administration/access-control#http-rules","HTTP rules",{"_3465":502,"_30219":486,"_5":30548,"_20927":50792,"_27457":50793,"_2948":50794},[],"/docs/platform/administration/access-control#included-policies","Included policies",{"_3465":503,"_30219":486,"_5":30548,"_20927":50796,"_27457":50797,"_2948":49894},[],"/docs/platform/administration/access-control#provision-the-first-administrator",{"_3465":504,"_30219":486,"_5":30548,"_20927":50799,"_27457":50800,"_2948":50801},[],"/docs/platform/administration/access-control#prepare-the-identity-provider","Prepare the identity provider",{"_3465":505,"_30219":486,"_5":30548,"_20927":50803,"_27457":50804,"_2948":50805},[],"/docs/platform/administration/access-control#configure-token-validation","Configure token validation",{"_3465":506,"_30219":486,"_5":30548,"_20927":50807,"_27457":50808,"_2948":50809},[],"/docs/platform/administration/access-control#install-and-verify-administrative-access","Install and verify administrative access",{"_3465":507,"_30219":486,"_5":30548,"_20927":50811,"_27457":50812,"_2948":50813},[],"/docs/platform/administration/access-control#test-an-unprivileged-identity","Test an unprivileged identity",{"_3465":508,"_30219":486,"_5":30548,"_20927":50815,"_27457":50816,"_2948":50817},[],"/docs/platform/administration/access-control#reduce-use-of-the-bootstrap-administrator","Reduce use of the bootstrap administrator",{"_3465":509,"_30219":486,"_5":30548,"_20927":50819,"_27457":50820,"_2948":50821},[],"/docs/platform/administration/access-control#fastlane-bootstrap","Fastlane bootstrap",{"_3465":510,"_30219":486,"_5":30548,"_20927":50823,"_27457":50824,"_2948":50825},[],"/docs/platform/administration/access-control#design-least-privilege-roles","Design least-privilege roles",{"_3465":511,"_30219":486,"_5":30548,"_20927":50827,"_27457":50828,"_2948":50829},[],"/docs/platform/administration/access-control#changes-and-access-revocation","Changes and access revocation",{"_3465":512,"_30219":486,"_5":30548,"_20927":50831,"_27457":50832,"_2948":50833},[],"/docs/platform/administration/access-control#operational-checklist","Operational checklist",{"_3465":513,"_30219":486,"_5":30548,"_20927":50835,"_27457":50836,"_2948":50837},[],"/docs/platform/administration/access-control#diagnostics","Diagnostics",{"_3465":514,"_30219":486,"_5":30548,"_20927":50839,"_27457":50840,"_2948":50841},[],"/docs/platform/administration/access-control#the-response-is-401","The response is 401",{"_3465":515,"_30219":486,"_5":30548,"_20927":50843,"_27457":50844,"_2948":50845},[],"/docs/platform/administration/access-control#the-response-is-403","The response is 403",{"_3465":516,"_30219":486,"_5":30548,"_20927":50847,"_27457":50848,"_2948":50849},[],"/docs/platform/administration/access-control#everything-returns-403","Everything returns 403",{"_3465":517,"_30219":486,"_5":30548,"_20927":50851,"_27457":50852,"_2948":50853},[],"/docs/platform/administration/access-control#access-appears-without-a-policy-grant","Access appears without a policy grant",{"_3465":518,"_30219":486,"_5":30548,"_20927":50855,"_27457":50856,"_2948":50857},[],"/docs/platform/administration/access-control#everything-fails-when-authz-is-unavailable","Everything fails when authz is unavailable",{"_3465":519,"_30219":486,"_20927":50859,"_5":14373,"_27457":486,"_2948":50860},[],"Lamassu access control turns an authenticated identity into concrete permissions. The OIDC provider or the client certificate proves **who** makes a request; the `authz` service decides **what that identity can do** and **over which resources**.",{"_3465":520,"_30219":486,"_20927":50862,"_5":14373,"_27457":486,"_2948":50863},[],"Lamassu does not assign permissions directly to users. The full chain is:",{"_3465":521,"_30219":486,"_20927":50865,"_5":14373,"_27457":486,"_2948":50866},[],"This model lets you represent people, identity-provider groups, service accounts and devices without coupling authorization to a specific provider.",{"_3465":522,"_30219":486,"_20927":50868,"_5":14373,"_27457":50737,"_2948":50869},[],"A **principal** connects a credential to Lamassu. It defines how to recognize an OIDC or X.509 identity and can be active or disabled.",{"_3465":523,"_30219":486,"_20927":50871,"_5":14373,"_27457":50737,"_2948":50872},[],"A **policy** groups reusable permissions. It can be granted to several principals and can contain rules about Lamassu entities, rules about HTTP routes or both.",{"_3465":524,"_30219":486,"_20927":50874,"_5":14373,"_27457":50737,"_2948":50875},[],"An **entity rule** grants actions over resources such as certification authorities, certificates, issuance profiles, devices, DMSs, keys or alert subscriptions. It can cover all resources of a type or be limited by identifier, relation or attribute.",{"_3465":525,"_30219":486,"_20927":50877,"_5":14373,"_27457":50737,"_2948":50878},[],"An **HTTP rule** grants actions associated with API routes. It is the mechanism the Gateway uses to decide whether a request may cross the perimeter.",{"_3465":526,"_30219":486,"_20927":50880,"_5":14373,"_27457":50737,"_2948":50881},[],"A **grant** is the association between a principal and a policy. Removing the grant removes all permissions contributed by that policy, without modifying it for other principals.",{"_3465":527,"_30219":486,"_20927":50883,"_5":14373,"_27457":50737,"_2948":50884},[],"A valid JWT or a valid client certificate does not grant access by itself. The credential must match at least one active principal and, unless the HTTP schema exempts the route, one of its policies must allow the requested operation. See *Authentication-only routes and unmapped paths* for those exemptions.",{"_3465":528,"_30219":486,"_20927":50886,"_5":14373,"_27457":50741,"_2948":50887},[],"Lamassu uses two authorization paths depending on who implements the protected service. They share principals, policies and grants, but they do not interpret the rules the same way.",{"_3465":529,"_30219":486,"_20927":50889,"_5":14373,"_27457":50741,"_2948":50890},[],"An external service can be protected without knowing Lamassu's internal authorization model. A service developed by Lamassu embeds the authorization engine and can decide on concrete resources and filter its queries.",{"_3465":530,"_30219":486,"_20927":50892,"_5":14373,"_27457":50745,"_2948":50893},[],"This path protects APIs that join the platform through the Gateway but do not natively implement Lamassu's authorization SDK. Job Manager is the current example. The same pattern allows integrating other HTTP services as long as their routes are described in an `authz` HTTP schema.",{"_3465":531,"_30219":486,"_20927":50895,"_5":14373,"_27457":50745,"_2948":50896},[],"The decision is made **before forwarding the request to the service**:",{"_3465":532,"_30219":486,"_20927":50898,"_5":14373,"_27457":50745,"_2948":50899},[],"Envoy Gateway authenticates the request, usually validating a JWT against the OIDC provider's JWKS.",{"_3465":533,"_30219":486,"_20927":50901,"_5":14373,"_27457":50745,"_2948":50902},[],"For a protected route, Envoy sends the method, URL, headers and required data to `/v1/ext_authz/check`.",{"_3465":534,"_30219":486,"_20927":50904,"_5":14373,"_27457":50745,"_2948":50905},[],"`authz` extracts the credential and resolves all active principals matching it.",{"_3465":535,"_30219":486,"_20927":50907,"_5":14373,"_27457":50745,"_2948":50908},[],"It separately loads the policies granted to each principal.",{"_3465":536,"_30219":486,"_20927":50910,"_5":14373,"_27457":50745,"_2948":50911},[],"The HTTP schema translates the method and route combination into a logical action, such as `nbi-job-read` or `nbi-workflow-create`.",{"_3465":537,"_30219":486,"_20927":50913,"_5":14373,"_27457":50745,"_2948":50914},[],"`authz` looks for an HTTP rule granting that action.",{"_3465":538,"_30219":486,"_20927":50916,"_5":14373,"_27457":50745,"_2948":50917},[],"If the route declares constraints, it compares request data with the normalized attributes of the same principal contributing the policy; the policy's own `param_constraints` also pin the granted action to literal request values.",{"_3465":539,"_30219":486,"_20927":50919,"_5":14373,"_27457":50745,"_2948":50920},[],"A satisfying result lets Envoy forward the request; any other response blocks it at the Gateway.",{"_3465":540,"_30219":486,"_20927":50922,"_5":14373,"_27457":50745,"_2948":50923},[],"When it allows access, `authz` returns the selected principal in the `X-Principal-ID` response header. The Gateway can propagate that header to the service to preserve the identity context. Clients cannot forge this header: the Gateway removes client-supplied `X-Principal-Id` (and the other forwarded identity and certificate headers) before forwarding, so only `authz` can set it. See Expose the Gateway for the full list of stripped headers.",{"_3465":541,"_30219":486,"_20927":50925,"_5":14373,"_27457":50745,"_2948":50926},[],"HTTP rules primarily answer &#x2A;*\"can this identity call this API operation?\"**. On their own they do not produce filters over the external service's database. To limit a route to a specific device, tenant or client, either the schema declares a constraint relating a request value to a normalized attribute of the principal, or the policy pins the request value to a literal with `param_constraints`. The first scopes each identity to its own resources through a single grant; the second restricts a grant to a fixed value regardless of who holds it.",{"_3465":542,"_30219":486,"_20927":50928,"_5":14373,"_27457":50749,"_2948":50929},[],"Two schema-level settings cover endpoints that policies do not mention:",{"_3465":543,"_30219":486,"_20927":50931,"_5":14373,"_27457":50749,"_2948":50932},[],"**`skip_authz: true` on a route** allows any identity that matches an active principal to reach it, even one with no granted policies. Use it for paths such as `/openapi.json` or `/health` that every authenticated caller should be able to access. The request still has to authenticate successfully: a credential that fails validation or matches no active principal is rejected before this setting is considered. A `skip_authz` route cannot declare constraints, and it wins over any other schema's route or default action for the same request.",{"_3465":544,"_30219":486,"_20927":50934,"_5":14373,"_27457":50749,"_2948":50935},[],"**`default_action` with `base_paths`** decides what happens when a request falls under a path prefix the schema owns but no explicit route matches. `deny` — the value the Job Manager schema ships with — turns the implicit denial of unmapped paths into an explicit, auditable statement; `allow` opens unmapped endpoints under that prefix to any identity that matches an active principal.",{"_3465":545,"_30219":486,"_20927":50937,"_5":14373,"_27457":50749,"_2948":50938},[],"These are decisions of the schema, not of a policy: `skip_authz` removes the grant check for that route, even when another schema maps the same request to an action that requires a grant, and `default_action` only covers requests that no explicit route in any schema matches. Keep three rules in mind:",{"_3465":546,"_30219":486,"_20927":50940,"_5":14373,"_27457":50749,"_2948":50941},[],"`default_action` requires at least one `base_paths` entry, and base paths are absolute paths such as `/api/wfx/nbi/v1`.",{"_3465":547,"_30219":486,"_20927":50943,"_5":14373,"_27457":50749,"_2948":50944},[],"An explicit route in any schema takes precedence: the fallback only decides requests that no schema's routes cover. When the prefixes of two schemas overlap, the longest matching prefix decides.",{"_3465":548,"_30219":486,"_20927":50946,"_5":14373,"_27457":50749,"_2948":50947},[],"Two schemas cannot claim the same base path with different default actions; the conflicting schema fails to load.",{"_3465":549,"_30219":486,"_20927":50949,"_5":14373,"_27457":50749,"_2948":50950},[],"A `skip_authz` route and a `default_action: \"allow\"` prefix grant access without consulting any policy. Every identity that matches an active principal can reach what they open, including identities with no granted policies. A `skip_authz` route in one schema also opens a request that another schema maps to a grant-protected action. Review these settings whenever you add or upgrade an integrated service.",{"_3465":550,"_30219":486,"_20927":50952,"_5":14373,"_27457":50753,"_2948":50953},[],"Lamassu's native services embed authorization in their middleware and know the entities they operate on: certificates, CAs, issuance profiles, keys, devices, DMSs or subscriptions, among others.",{"_3465":551,"_30219":486,"_20927":50955,"_5":14373,"_27457":50753,"_2948":50956},[],"The decision is made with the domain operation context:",{"_3465":552,"_30219":486,"_20927":50958,"_5":14373,"_27457":50753,"_2948":50959},[],"The middleware extracts the credential and resolves the matching principals.",{"_3465":553,"_30219":486,"_20927":50961,"_5":14373,"_27457":50753,"_2948":50962},[],"The endpoint identifies the action, the entity type and, when applicable, the key of the requested resource.",{"_3465":554,"_30219":486,"_20927":50964,"_5":14373,"_27457":50753,"_2948":50965},[],"`authz` gathers the entity rules of the granted policies.",{"_3465":555,"_30219":486,"_20927":50967,"_5":14373,"_27457":50753,"_2948":50968},[],"The engine evaluates direct grants, attribute filters and relations with other entities.",{"_3465":556,"_30219":486,"_20927":50970,"_5":14373,"_27457":50753,"_2948":50971},[],"For an individual operation, it checks that the concrete resource satisfies the computed scope.",{"_3465":557,"_30219":486,"_20927":50973,"_5":14373,"_27457":50753,"_2948":50974},[],"For a listing, it generates a SQL filter that the service adds to its own query.",{"_3465":558,"_30219":486,"_20927":50976,"_5":14373,"_27457":50753,"_2948":50977},[],"Here the engine answers &#x2A;*\"can this identity perform this action on this concrete resource?\"**.",{"_3465":559,"_30219":486,"_20927":50979,"_5":14373,"_27457":50753,"_2948":50980},[],"Actions fall into two groups:",{"_3465":560,"_30219":486,"_20927":50982,"_5":14373,"_27457":50753,"_2948":50983},[],"**Global actions** do not need a resource identifier. `create`, `import` or access to a console section are common examples.",{"_3465":561,"_30219":486,"_20927":50985,"_5":14373,"_27457":50753,"_2948":50986},[],"**Atomic actions** are evaluated on a concrete instance. For certificates these include `read`, `metadata-update`, `status-update` and `delete`; for a CA there are also `sign`, `reissue` and other lifecycle operations.",{"_3465":562,"_30219":486,"_20927":50988,"_5":14373,"_27457":50753,"_2948":50989},[],"Filtering inside the service prevents leaks in listings: unauthorized resources are excluded from the SQL query instead of being fetched and hidden later in the interface.",{"_3465":563,"_30219":486,"_20927":50991,"_5":14373,"_27457":50757,"_2948":50992},[],"They are not two equivalent controls applied twice. HTTP rules protect the perimeter of an integrated service; entity rules express permissions over the data model of the native services.",{"_3465":564,"_30219":486,"_20927":50994,"_5":14373,"_27457":50757,"_2948":50995},[],"A policy can contain both rule types when an identity needs to operate Lamassu resources and also call an integrated API. Granting an entity rule does not automatically grant an HTTP action, nor does an HTTP rule create access over an entity.",{"_3465":565,"_30219":486,"_20927":50997,"_5":14373,"_27457":50757,"_2948":50998},[],"If no combination of principal, policy and rule allows the operation, Lamassu denies it, unless the HTTP schema declares `skip_authz` on the route or `default_action: allow` on a base path that covers it (see *Authentication-only routes and unmapped paths*). Additionally, `auth.externalAuthorization.failOpen` is `false` by default: if `authz` is unavailable, the Gateway blocks protected routes.",{"_3465":566,"_30219":486,"_20927":51000,"_5":14373,"_27457":50761,"_2948":51001},[],"An OIDC principal matches the claims of a validated JWT. It is appropriate for human users, corporate groups, IdP roles and service accounts that obtain tokens.",{"_3465":567,"_30219":486,"_20927":51003,"_5":14373,"_27457":50761,"_2948":51004},[],"The following principal represents any identity holding the `pki-operators` role in Keycloak:",{"_3465":568,"_30219":486,"_20927":51006,"_5":14373,"_27457":50761,"_2948":51007},[],"Claim paths can be nested, such as `realm_access.roles`. Within a single principal, **all** conditions must hold. This lets you require, for example, a group and an organizational audience at the same time.",{"_3465":569,"_30219":486,"_20927":51009,"_5":14373,"_27457":50761,"_2948":51010},[],"The implemented operators are:",{"_3465":570,"_30219":486,"_20927":51012,"_5":14373,"_27457":50761,"_2948":51013},[],"`equals`, for exact equality;",{"_3465":571,"_30219":486,"_20927":51015,"_5":14373,"_27457":50761,"_2948":51016},[],"`contains`, to check membership in a list or the presence of text in a scalar value.",{"_3465":572,"_30219":486,"_20927":51018,"_5":14373,"_27457":50761,"_2948":51019},[],"Design matching with stable attributes. For people, it is usually better to bind permissions to centrally managed groups or roles than to the email or username. For a service account, a stable `sub` keeps its permissions from mixing with a human operator's.",{"_3465":573,"_30219":486,"_20927":51021,"_5":14373,"_27457":50761,"_2948":51022},[],"Although the model recognizes the operator name `matches`, the current implementation does not evaluate regular expressions and the condition never matches. Use `equals` or `contains`.",{"_3465":574,"_30219":486,"_20927":51024,"_5":14373,"_27457":50765,"_2948":51025},[],"An X.509 principal lets you recognize a workload or a device by its client certificate. Lamassu checks the certificate signature against the configured CA and, depending on the mode, also its serial number or Common Name.",{"_3465":575,"_30219":486,"_20927":51027,"_5":14373,"_27457":50765,"_2948":51028},[],"The available modes are:",{"_3465":576,"_30219":486,"_20927":51030,"_5":14373,"_27457":50765,"_2948":51031},[],"`serial_and_ca`: an exact certificate, identified by serial number and CA;",{"_3465":577,"_30219":486,"_20927":51033,"_5":14373,"_27457":50765,"_2948":51034},[],"`cn_and_ca`: an exact or wildcard Common Name and a specific CA;",{"_3465":578,"_30219":486,"_20927":51036,"_5":14373,"_27457":50765,"_2948":51037},[],"`any_from_ca`: any certificate issued directly by the given CA.",{"_3465":579,"_30219":486,"_20927":51039,"_5":14373,"_27457":50765,"_2948":51040},[],"This example recognizes certificates whose CN starts with `factory-a-` and that are signed by the configured CA:",{"_3465":580,"_30219":486,"_20927":51042,"_5":14373,"_27457":50765,"_2948":51043},[],"`ca_trust.identity_type` accepts `fingerprint` or `authority_key_id`. In both cases you must provide the CA certificate in `ca_trust.pem`; Lamassu verifies both the signature and the expected identity of the CA.",{"_3465":581,"_30219":486,"_20927":51045,"_5":14373,"_27457":50765,"_2948":51046},[],"Use `any_from_ca` only when every identity issued by that CA should share the same permissions. If a CA issues certificates for different populations, separate access by serial or CN, or use different issuing CAs.",{"_3465":582,"_30219":486,"_20927":51048,"_5":14373,"_27457":50769,"_2948":51049},[],"A single credential can match more than one principal. It is common for a user to match a principal of their team and another of their operational function.",{"_3465":583,"_30219":486,"_20927":51051,"_5":14373,"_27457":50769,"_2948":51052},[],"For entity permissions, Lamassu combines permissions with OR logic: it is enough that one policy of one of the principals allows the action. Listings contain the union of the resources visible to all of them.",{"_3465":584,"_30219":486,"_20927":51054,"_5":14373,"_27457":50769,"_2948":51055},[],"HTTP routes with constraints are stricter. The same principal contributing the policy must also satisfy the attributes required by the route. Lamassu does not combine one principal's policy with an attribute belonging to another.",{"_3465":585,"_30219":486,"_20927":51057,"_5":14373,"_27457":50769,"_2948":51058},[],"For this reason, adding a matching principal can only broaden access. Before creating overlapping rules, review the full set of policies a real identity will receive.",{"_3465":586,"_30219":486,"_20927":51060,"_5":14373,"_27457":50777,"_2948":51061},[],"A rule identifies the domain (`namespace`), the data schema (`schema_name`) and the entity type (`entity_type`). `actions` lists the allowed operations.",{"_3465":587,"_30219":486,"_20927":51063,"_5":14373,"_27457":50777,"_2948":51064},[],"`direct_grants` limits the rule to concrete identifiers. The value `*` covers all instances of the type. A superadministrator policy uses wildcards in schema, entity, actions and grants; a least-privilege policy should avoid them whenever possible.",{"_3465":588,"_30219":486,"_20927":51066,"_5":14373,"_27457":50781,"_2948":51067},[],"Rules can follow relations declared between entities. For example, the schema knows the relation of a certificate to its issuing CA, of a device to its DMS and of a certificate to the KMS key that stores its private key, so a grant on the key also covers the certificates that use it. A policy can grant access to a parent resource and propagate selected actions to its related resources.",{"_3465":589,"_30219":486,"_20927":51069,"_5":14373,"_27457":50781,"_2948":51070},[],"This lets you express models like \"can operate the devices of this DMS\" without maintaining an individual list of every device. When a resource is added under that relation, it inherits the scope planned by the policy.",{"_3465":590,"_30219":486,"_20927":51072,"_5":14373,"_27457":50785,"_2948":51073},[],"`column_filters` applies conditions to columns the schema has declared filterable. All filters of the same rule are combined with AND.",{"_3465":591,"_30219":486,"_20927":51075,"_5":14373,"_27457":50785,"_2948":51076},[],"For example, this rule allows reading active certificates issued by a specific CA:",{"_3465":592,"_30219":486,"_20927":51078,"_5":14373,"_27457":50785,"_2948":51079},[],"The available operators are `eq`, `neq`, `gt`, `gte`, `lt`, `lte`, `in` and `like`. Use comparisons consistent with the column type: `like` for text, ordering comparisons for numbers or dates and `in` when there is a collection of accepted values.",{"_3465":593,"_30219":486,"_20927":51081,"_5":14373,"_27457":50789,"_2948":51082},[],"HTTP rules do not point directly at tables. They reference a route schema and grant its logical actions. Job Manager's policies are an example: they distinguish reading, creating, updating and deleting workflows or jobs.",{"_3465":594,"_30219":486,"_20927":51084,"_5":14373,"_27457":50789,"_2948":51085},[],"Some routes also compare a request value — taken from the path, query, header or JSON body — with a normalized attribute of the principal. This way you can verify that a device only queries jobs addressed to its own `client_id`.",{"_3465":595,"_30219":486,"_20927":51087,"_5":14373,"_27457":50789,"_2948":51088},[],"Normalized attributes decouple the policy from the authentication mechanism. `subject_attribute_mappings` can derive, for example, `device_id` from `oidc.claim.device_id` or from `x509.subject.cn`. The rule consumes `device_id` in both cases.",{"_3465":596,"_30219":486,"_20927":51090,"_5":14373,"_27457":50789,"_2948":51091},[],"An HTTP rule can also pin a granted action to a literal value carried by the request itself through `param_constraints`. It extracts the value with the same sources as route constraints — `path_regex_group`, `query`, `header` or `json_body` — but compares it against an `equals` literal written into the policy rather than against a subject attribute. The grant then depends only on the request, not on who holds the policy:",{"_3465":597,"_30219":486,"_20927":51093,"_5":14373,"_27457":50789,"_2948":51094},[],"Combined with a schema route such as `^/api/mysvc/system/([^/]+)/info$`, this grants `GET /api/mysvc/system/1/info` and denies the same call for system `2`, regardless of the principal's attributes. The same mechanism pins query parameters, headers or JSON body fields, for example `{ \"source\": \"query\", \"name\": \"tenant_id\" }` with `\"equals\": \"1\"` to accept only requests carrying `?tenant_id=1`.",{"_3465":598,"_30219":486,"_20927":51096,"_5":14373,"_27457":50789,"_2948":51097},[],"Note that:",{"_3465":599,"_30219":486,"_20927":51099,"_5":14373,"_27457":50789,"_2948":51100},[],"`action` must be one of the actions granted by the rule; `equals` is required; `path_regex_group` needs an `index` greater than zero, `query` and `header` need a `name`, and `json_body` needs a `path` such as `$.tenant_id`.",{"_3465":600,"_30219":486,"_20927":51102,"_5":14373,"_27457":50789,"_2948":51103},[],"`param_constraints` are not cross-checked against the schema when the policy is loaded. A reference the route cannot satisfy — for instance a `path_regex_group` on a route without capture groups — simply never matches, and the request is denied.",{"_3465":601,"_30219":486,"_20927":51105,"_5":14373,"_27457":50789,"_2948":51106},[],"Several `param_constraints` for the same action combine with AND. A rule without them keeps the usual behavior: the action is granted wherever the route matches and the subject constraints pass.",{"_3465":602,"_30219":486,"_20927":51108,"_5":14373,"_27457":50793,"_2948":51109},[],"The `authz` preload installs reusable policies for the main domains. Among them are:",{"_3465":603,"_30219":486,"_20927":51111,"_5":14373,"_27457":50793,"_2948":51112},[],"full and read-only access to certificates and authorities;",{"_3465":604,"_30219":486,"_20927":51114,"_5":14373,"_27457":50793,"_2948":51115},[],"full and read-only access to the KMS;",{"_3465":605,"_30219":486,"_20927":51117,"_5":14373,"_27457":50793,"_2948":51118},[],"full and read-only access to Device Manager, DMS Manager, Validation Authority and alerts;",{"_3465":606,"_30219":486,"_20927":51120,"_5":14373,"_27457":50793,"_2948":51121},[],"an `Auditor` policy with PKI read access and authorization visibility;",{"_3465":607,"_30219":486,"_20927":51123,"_5":14373,"_27457":50793,"_2948":51124},[],"console access;",{"_3465":608,"_30219":486,"_20927":51126,"_5":14373,"_27457":50793,"_2948":51127},[],"administration and observation policies for the Job Manager NBI and SBI APIs;",{"_3465":609,"_30219":486,"_20927":51129,"_5":14373,"_27457":50793,"_2948":51130},[],"`SUPER ADMIN`, which grants all actions over the `authz` and `pki` domains.",{"_3465":610,"_30219":486,"_20927":51132,"_5":14373,"_27457":50793,"_2948":51133},[],"Start with these policies before creating others. If none reflects the boundary you need, create a specific, small policy instead of copying `SUPER ADMIN` and informally removing permissions.",{"_3465":611,"_30219":486,"_20927":51135,"_5":14373,"_27457":50797,"_2948":51136},[],"An installation without a principal matching your identity is left with nobody able to administer authorization. Configure the IdP and the bootstrap before exposing the platform.",{"_3465":612,"_30219":486,"_20927":51138,"_5":14373,"_27457":50797,"_2948":51139},[],"The chart includes a bootstrap principal that looks for the OIDC role `pki-admin` in `realm_access.roles`. It grants it `SUPER ADMIN` and, when Job Manager is enabled, the administrative policy of its NBI API.",{"_3465":613,"_30219":486,"_20927":51141,"_5":14373,"_27457":50797,"_2948":51142},[],"The pre-install and pre-upgrade Helm Job runs the `authz` migrations, preloads the policies and creates the bootstrap principals before the services start. If the principal already exists, it does not replace it: it only adds the configured grants that are still missing. You can keep the entry in `values.yaml` across upgrades.",{"_3465":614,"_30219":486,"_20927":51144,"_5":14373,"_27457":50800,"_2948":51145},[],"Create the role or group you will use to administer Lamassu. Assign it to at least two controlled human identities. If your provider does not use `realm_access.roles`, adapt the claim path in both the frontend and `auth_config.claims`.",{"_3465":615,"_30219":486,"_20927":51147,"_5":14373,"_27457":50804,"_2948":51148},[],"`authz` validates every token against `services.authz.jwkUrl`, which is fetched from the `authz` pod. The Gateway does not validate tokens itself: Lamassu services authorize each request through `authz`, and routes labeled `auth=external`, such as the Job Manager ones, are checked by the Gateway through `authz` when `auth.externalAuthorization` is enabled. The endpoint must serve the keys of the issuer configured in `auth.oidc.frontend.authority`.",{"_3465":616,"_30219":486,"_20927":51150,"_5":14373,"_27457":50804,"_2948":51151},[],"Releases upgraded from 3.8.0 must remove `auth.oidc.apiGateway` and `auth.authorization`, which the 4.0.0 chart rejects. See 3.8.0 to 4.0.0.",{"_3465":617,"_30219":486,"_20927":51153,"_5":14373,"_27457":50808,"_2948":51154},[],"Sign in with an identity holding `pki-admin`. Confirm it can access authorization administration and perform a non-destructive read operation.",{"_3465":618,"_30219":486,"_20927":51156,"_5":14373,"_27457":50812,"_2948":51157},[],"Use a second user without the role and confirm the same operation is denied. This test catches misread claims, overly broad policies and accidental `failOpen` configurations.",{"_3465":619,"_30219":486,"_20927":51159,"_5":14373,"_27457":50816,"_2948":51160},[],"Create operational principals with narrower policies. Reserve `pki-admin` for authorization administration and recovery, not for daily work.",{"_3465":620,"_30219":486,"_20927":51162,"_5":14373,"_27457":50820,"_2948":51163},[],"Fastlane installs a Keycloak realm for the lab and creates the user `lamassu` with the temporary password `lamassu`, the role `pki-admin` and a mandatory password change. Its bootstrap principal matches through `preferred_username=lamassu`.",{"_3465":621,"_30219":486,"_20927":51165,"_5":14373,"_27457":50820,"_2948":51166},[],"Change the password on first login. Do not reuse the Fastlane user, password or IdP as a production design.",{"_3465":622,"_30219":486,"_20927":51168,"_5":14373,"_27457":50824,"_2948":51169},[],"Avoid reproducing your company's internal structure with dozens of nearly identical policies. Start from the responsibilities that actually need access:",{"_3465":623,"_30219":486,"_20927":51171,"_5":14373,"_27457":50824,"_2948":51172},[],"**Authorization administration**: manages principals, policies and grants. It should belong to a small, separate group.",{"_3465":624,"_30219":486,"_20927":51174,"_5":14373,"_27457":50824,"_2948":51175},[],"**PKI operation**: administers CAs, profiles and certificates, but not necessarily who gets access.",{"_3465":625,"_30219":486,"_20927":51177,"_5":14373,"_27457":50824,"_2948":51178},[],"**Device registration**: operates devices and DMSs without receiving permissions over keys or authorization configuration.",{"_3465":626,"_30219":486,"_20927":51180,"_5":14373,"_27457":50824,"_2948":51181},[],"**Audit**: reviews configuration and activity without creating, modifying, signing, revoking or deleting.",{"_3465":627,"_30219":486,"_20927":51183,"_5":14373,"_27457":50824,"_2948":51184},[],"**Automation**: uses a technical account or a separate certificate, with permissions limited to the flow and resources it controls.",{"_3465":628,"_30219":486,"_20927":51186,"_5":14373,"_27457":50824,"_2948":51187},[],"For each role, separate \"view\" from \"change\", limit resources through grants, relations or attributes and avoid `*` unless the role must automatically cover future actions.",{"_3465":629,"_30219":486,"_20927":51189,"_5":14373,"_27457":50824,"_2948":51190},[],"A rule with `actions: [\"*\"]` expands to every action defined by the schema. When a new version adds an action, a wildcard policy may start granting it. Review these policies on every upgrade.",{"_3465":630,"_30219":486,"_20927":51192,"_5":14373,"_27457":50828,"_2948":51193},[],"To revoke access immediately, disable the principal or revoke its grants. Disabling a principal keeps its configuration and associations for investigation or restoration, but it stops taking part in matching.",{"_3465":631,"_30219":486,"_20927":51195,"_5":14373,"_27457":50828,"_2948":51196},[],"Deleting a role or group in the IdP prevents new tokens from containing the claim, but an already-issued token may remain valid until it expires. If removal is urgent, combine the IdP change with disabling the principal in Lamassu and revoking sessions or tokens at the provider.",{"_3465":632,"_30219":486,"_20927":51198,"_5":14373,"_27457":50828,"_2948":51199},[],"When you edit a shared policy, remember the change affects all its principals. To test a new scope, create a separate policy, grant it to a test identity and validate allowed and denied operations before replacing the old one.",{"_3465":633,"_30219":486,"_20927":51201,"_5":14373,"_27457":50832,"_2948":51202},[],"Keep `failOpen: false` unless a documented risk assessment justifies otherwise.",{"_3465":634,"_30219":486,"_20927":51204,"_5":14373,"_27457":50832,"_2948":51205},[],"Use groups or stable roles for people and independent identities for automations.",{"_3465":635,"_30219":486,"_20927":51207,"_5":14373,"_27457":50832,"_2948":51208},[],"Keep at least two recovery administrators and test their access periodically.",{"_3465":636,"_30219":486,"_20927":51210,"_5":14373,"_27457":50832,"_2948":51211},[],"Review active principals, their matches and their grants after IdP changes.",{"_3465":637,"_30219":486,"_20927":51213,"_5":14373,"_27457":50832,"_2948":51214},[],"Search for wildcards in policies before upgrading Lamassu.",{"_3465":638,"_30219":486,"_20927":51216,"_5":14373,"_27457":50832,"_2948":51217},[],"Review `skip_authz` routes and `default_action` settings in HTTP schemas when integrating or upgrading a service.",{"_3465":639,"_30219":486,"_20927":51219,"_5":14373,"_27457":50832,"_2948":51220},[],"Always test one allowed and one denied operation for each role.",{"_3465":640,"_30219":486,"_20927":51222,"_5":14373,"_27457":50832,"_2948":51223},[],"Correlate changes to principals, policies and grants with the audit logs.",{"_3465":641,"_30219":486,"_20927":51225,"_5":14373,"_27457":50840,"_2948":51226},[],"Authentication failed before permissions were evaluated. Check the JWT signature and expiration, issuer, audience and the availability of the JWKS configured in the Gateway. For X.509, check that the client certificate reaches the point that extracts the credential.",{"_3465":642,"_30219":486,"_20927":51228,"_5":14373,"_27457":50844,"_2948":51229},[],"The credential could be processed but did not produce a positive authorization. Review in this order:",{"_3465":643,"_30219":486,"_20927":51231,"_5":14373,"_27457":50844,"_2948":51232},[],"that an active principal of the correct type exists;",{"_3465":644,"_30219":486,"_20927":51234,"_5":14373,"_27457":50844,"_2948":51235},[],"that the claim paths and values match the real token exactly;",{"_3465":645,"_30219":486,"_20927":51237,"_5":14373,"_27457":50844,"_2948":51238},[],"that all of the principal's conditions hold;",{"_3465":646,"_30219":486,"_20927":51240,"_5":14373,"_27457":50844,"_2948":51241},[],"that the principal has the expected policy granted;",{"_3465":647,"_30219":486,"_20927":51243,"_5":14373,"_27457":50844,"_2948":51244},[],"that the policy includes the action and the requested resource type or route;",{"_3465":648,"_30219":486,"_20927":51246,"_5":14373,"_27457":50844,"_2948":51247},[],"that the identifier, relation, column filter or HTTP constraint includes the real resource.",{"_3465":649,"_30219":486,"_20927":51249,"_5":14373,"_27457":50844,"_2948":51250},[],"In the `authz` logs, an external endpoint decision includes `allowed`, `reason`, `matched_principals`, `evaluated_policy_ids`, `matched_policy_id` and the status code. These fields let you separate a matching failure from a permissions failure. With OpenTelemetry tracing enabled, a request that reaches the policy engine produces an `engine.CheckHTTPRequest` span whose attributes record `authz.allowed`, the matched policy and the matched principal. Correlation with the Gateway trace requires trace context to be propagated to authz.",{"_3465":650,"_30219":486,"_20927":51252,"_5":14373,"_27457":50848,"_2948":51253},[],"Check that the bootstrap principal was created and that the policies were preloaded by the migration Job. Also verify that `services.authz.jwkUrl` is reachable from the `authz` pod; do not assume that a URL accessible from the browser also works inside the cluster.",{"_3465":651,"_30219":486,"_20927":51255,"_5":14373,"_27457":50852,"_2948":51256},[],"The path may be covered by a schema-level decision rather than by a policy: routes marked `skip_authz` allow any identity that matches an active principal, and a request under a `base_paths` prefix whose schema sets `default_action: allow` is likewise allowed without consulting policies. Confirm which of the two applies before looking for missing or misassigned grants.",{"_3465":652,"_30219":486,"_20927":51258,"_5":14373,"_27457":50856,"_2948":51259},[],"This is the expected behavior with `failOpen: false`. Restore the service, its PostgreSQL connection and its JWKS connectivity. Do not temporarily switch to `failOpen: true` without accepting that protected routes could become accessible without an authorization decision.",{"_3465":653,"_30219":486,"_20927":51261,"_5":14373,"_27457":50856,"_2948":51262},[],"Continue with Audit logs to investigate configuration changes or with Troubleshooting to diagnose the deployment.",{"_3465":654,"_30219":654,"_5":14725,"_2948":51264,"_30551":51265,"_20927":51266,"_27457":654},"Alerts and subscriptions",[49254,50729,50730],[],{"_3465":655,"_30219":654,"_20927":51268,"_5":14373,"_27457":654,"_2948":51269},[],"Send PKI events to people and external systems.",{"_3465":656,"_30219":654,"_5":30548,"_20927":51271,"_27457":51272,"_2948":51273},[],"/docs/platform/administration/alerts#how-it-works","How it works",{"_3465":657,"_30219":654,"_5":30548,"_20927":51275,"_27457":51276,"_2948":51277},[],"/docs/platform/administration/alerts#available-channels","Available channels",{"_3465":658,"_30219":654,"_5":30548,"_20927":51279,"_27457":51280,"_2948":51281},[],"/docs/platform/administration/alerts#create-a-subscription","Create a subscription",{"_3465":659,"_30219":654,"_5":30548,"_20927":51283,"_27457":51284,"_2948":51285},[],"/docs/platform/administration/alerts#choose-the-event","Choose the event",{"_3465":660,"_30219":654,"_5":30548,"_20927":51287,"_27457":51288,"_2948":51289},[],"/docs/platform/administration/alerts#configure-the-destination","Configure the destination",{"_3465":661,"_30219":654,"_5":30548,"_20927":51291,"_27457":51292,"_2948":51293},[],"/docs/platform/administration/alerts#limit-the-notifications","Limit the notifications",{"_3465":662,"_30219":654,"_5":30548,"_20927":51295,"_27457":51296,"_2948":51297},[],"/docs/platform/administration/alerts#review-and-activate","Review and activate",{"_3465":663,"_30219":654,"_5":30548,"_20927":51299,"_27457":51300,"_2948":51301},[],"/docs/platform/administration/alerts#configure-the-webhook-http-client","Configure the webhook HTTP client",{"_3465":664,"_30219":654,"_5":30548,"_20927":51303,"_27457":51304,"_2948":51305},[],"/docs/platform/administration/alerts#webhook-delivery-rules","Webhook delivery rules",{"_3465":665,"_30219":654,"_5":30548,"_20927":51307,"_27457":51308,"_2948":51309},[],"/docs/platform/administration/alerts#manage-a-subscription","Manage a subscription",{"_3465":666,"_30219":654,"_5":30548,"_20927":51311,"_27457":51312,"_2948":51313},[],"/docs/platform/administration/alerts#event-families","Event families",{"_3465":667,"_30219":654,"_20927":51315,"_5":14373,"_27457":654,"_2948":51316},[],"Subscriptions turn Lamassu events into actionable notifications. You can alert a team, feed an incident system or trigger an automation when a CA, certificate or device changes.",{"_3465":668,"_30219":654,"_20927":51318,"_5":14373,"_27457":51272,"_2948":51319},[],"A service publishes a domain event.",{"_3465":669,"_30219":654,"_20927":51321,"_5":14373,"_27457":51272,"_2948":51322},[],"Lamassu evaluates the subscriptions associated with that event type.",{"_3465":670,"_30219":654,"_20927":51324,"_5":14373,"_27457":51272,"_2948":51325},[],"Each subscription's filter decides whether it should be notified.",{"_3465":671,"_30219":654,"_20927":51327,"_5":14373,"_27457":51272,"_2948":51328},[],"Lamassu delivers the event to the configured channel.",{"_3465":672,"_30219":654,"_20927":51330,"_5":14373,"_27457":51272,"_2948":51331},[],"The event inventory shows when each type was last observed, how many times it has occurred and how many subscriptions it has. You can expand an event to inspect an example of its JSON payload before creating the filter.",{"_3465":673,"_30219":654,"_20927":51333,"_5":14373,"_27457":51276,"_2948":51334},[],"**Email** sends alerts to a person or an operational list. It only requires the destination address. Event content is rendered as HTML-escaped text, never as markup.",{"_3465":674,"_30219":654,"_20927":51336,"_5":14373,"_27457":51276,"_2948":51337},[],"**Microsoft Teams** posts the notification to a channel through its webhook URL.",{"_3465":675,"_30219":654,"_20927":51339,"_5":14373,"_27457":51276,"_2948":51340},[],"**Webhook** delivers the event to an automation, SIEM or incident system via `POST` or `PUT`.",{"_3465":676,"_30219":654,"_20927":51342,"_5":14373,"_27457":51276,"_2948":51343},[],"The Microsoft Teams and Webhook channels accept an optional `http_client` block that authenticates the call to the receiver. `auth_mode` selects `noauth` (the default), `apikey`, `jwt` or `mtls`; each mode requires its own options:",{"_3465":677,"_30219":654,"_20927":51345,"_5":14373,"_27457":51276,"_2948":51346},[],"`apikey_options` requires `header` and `key`.",{"_3465":678,"_30219":654,"_20927":51348,"_5":14373,"_27457":51276,"_2948":51349},[],"`jwt_options` requires `oidc_client_id`, `oidc_client_secret` and an absolute `http` or `https` `oidc_well_known`.",{"_3465":679,"_30219":654,"_20927":51351,"_5":14373,"_27457":51276,"_2948":51352},[],"`mtls_options` requires `cert_content` and `key_content` as Base64-encoded PEM, like certificates elsewhere in the API; plain PEM is also accepted. Values that reference files on the server are rejected, and the pair must decode to a matching certificate and private key.",{"_3465":680,"_30219":654,"_20927":51354,"_5":14373,"_27457":51276,"_2948":51355},[],"The alerts API reference documents the full `http_client` schema.",{"_3465":681,"_30219":654,"_20927":51357,"_5":14373,"_27457":51284,"_2948":51358},[],"Open **Alerts**, locate the event type and select **Subscribe**. Review the latest JSON example to identify the fields you will need to filter on.",{"_3465":682,"_30219":654,"_20927":51360,"_5":14373,"_27457":51288,"_2948":51361},[],"Select Email, Microsoft Teams or Webhook and enter the channel details.",{"_3465":683,"_30219":654,"_20927":51363,"_5":14373,"_27457":51292,"_2948":51364},[],"Add a filter if you don't want to receive every instance of the event.",{"_3465":684,"_30219":654,"_20927":51366,"_5":14373,"_27457":51292,"_2948":51367},[],"**None** notifies all instances of the event.",{"_3465":685,"_30219":654,"_20927":51369,"_5":14373,"_27457":51292,"_2948":51370},[],"**JSON Path** evaluates one or more specific fields.",{"_3465":686,"_30219":654,"_20927":51372,"_5":14373,"_27457":51292,"_2948":51373},[],"**JSON Schema** accepts only payloads with a particular structure.",{"_3465":687,"_30219":654,"_20927":51375,"_5":14373,"_27457":51292,"_2948":51376},[],"**JavaScript** lets you express custom logic. Each filter runs for at most 100 milliseconds; a filter that exceeds this limit fails the condition and the notification is skipped with the error `javascript filter execution timed out`.",{"_3465":688,"_30219":654,"_20927":51378,"_5":14373,"_27457":51292,"_2948":51379},[],"For example, `function (event) { return event.data.status == \"NO_IDENTITY\"; }` limits a subscription to devices without an identity.",{"_3465":689,"_30219":654,"_20927":51381,"_5":14373,"_27457":51292,"_2948":51382},[],"The console evaluates the filter against the JSON shown in the **Input Event** editor, which is prefilled with the latest event, and reports whether it matches. For JSON Path and JavaScript filters, it shows **The filter matches this Cloud Event** or **The filter does not match this Cloud Event**. JSON Path expressions are evaluated against the full Cloud Event, so the default `$.data` selects the event's `data` field, and the expression must start with `$`.",{"_3465":690,"_30219":654,"_20927":51384,"_5":14373,"_27457":51296,"_2948":51385},[],"Check the event, channel and filter in the summary. Select **Confirm Subscription** to start delivery.",{"_3465":691,"_30219":654,"_20927":51387,"_5":14373,"_27457":51300,"_2948":51388},[],"The Webhook and Microsoft Teams channels show this configuration in the subscribe form, at the channel step, and again when editing a subscription; Email does not use it. The fields map to the optional `http_client` block described above:",{"_3465":692,"_30219":654,"_20927":51390,"_5":14373,"_27457":51300,"_2948":51391},[],"**Log Level** selects `debug`, `info`, `warn` or `error`; `info` is the default.",{"_3465":693,"_30219":654,"_20927":51393,"_5":14373,"_27457":51300,"_2948":51394},[],"**Call Timeout** defaults to 10 seconds. The console rejects a value above 30 seconds with `Webhook timeout must be at most 30s.`; the API clamps the same value to the cap instead (see Calls are bounded).",{"_3465":694,"_30219":654,"_20927":51396,"_5":14373,"_27457":51300,"_2948":51397},[],"There is no TLS-verification switch for these channels, because the service always verifies the receiver certificate (see TLS is always verified).",{"_3465":695,"_30219":654,"_20927":51399,"_5":14373,"_27457":51300,"_2948":51400},[],"**HTTP Authentication** selects `No Authentication` (the default), `API Key` (API key value and Header Name, `X-API-Key` by default), `OIDC Client Credentials` (Client ID, Client Secret and Well-Known URL) or `Mutual TLS` (Client Certificate and Client Private Key pasted as PEM). A stored private key stays hidden until you select **Show**.",{"_3465":696,"_30219":654,"_20927":51402,"_5":14373,"_27457":51300,"_2948":51403},[],"A `http://` URL shows the console warning `Unencrypted HTTP connection` (see the Credentials over http\\:// callout below).",{"_3465":697,"_30219":654,"_20927":51405,"_5":14373,"_27457":51300,"_2948":51406},[],"The form validates inline against the same delivery rules: the webhook URL and the OIDC Well-Known URL must be absolute `http` or `https` URLs, an API-key header may not use a reserved name, and the mTLS certificate and key must be PEM content, not file paths.",{"_3465":698,"_30219":654,"_20927":51408,"_5":14373,"_27457":51300,"_2948":51409},[],"The summary in the Confirm step shows the authentication as `None`, `OIDC client credentials`, `API key` or `Mutual TLS`. The subscription details show the authentication, the API key header name (never the value), the OIDC issuer URL, mTLS as `Configured` and a fixed `TLS verification: Verified` row. The API key, client secret and private key are not shown in the subscription details.",{"_3465":699,"_30219":654,"_20927":51411,"_5":14373,"_27457":51304,"_2948":51412},[],"Notifications delivered through the Microsoft Teams and Webhook channels follow a fixed HTTP policy:",{"_3465":700,"_30219":654,"_20927":51414,"_5":14373,"_27457":51304,"_2948":51415},[],"**TLS is always verified.** The receiver certificate is checked against the system trust store. `insecure_skip_verify` is enforced as `false` — including when it is set to `true` — so self-signed or otherwise untrusted receivers fail delivery.",{"_3465":701,"_30219":654,"_20927":51417,"_5":14373,"_27457":51304,"_2948":51418},[],"**Redirects are not followed.** A `3xx` response fails with `unexpected status code: <n>: redirects are not followed`. Configure `webhook_url` with the final absolute `http` or `https` URL: an `http://` address that an ingress redirects to `https://` stops working.",{"_3465":702,"_30219":654,"_20927":51420,"_5":14373,"_27457":51304,"_2948":51421},[],"**Calls are bounded.** A call defaults to a 10 second timeout; a configured `call_timeout` is capped at 30 seconds. Values above the cap are clamped, not rejected.",{"_3465":703,"_30219":654,"_20927":51423,"_5":14373,"_27457":51304,"_2948":51424},[],"**The response body is ignored.** Delivery checks the status code only, so the receiver may answer with any body.",{"_3465":704,"_30219":654,"_20927":51426,"_5":14373,"_27457":51304,"_2948":51427},[],"**API-key headers are restricted.** A custom `apikey_options.header` may not use names that the platform or receiving services trust — for example `X-Principal-Id`, `X-Request-Id`, `Host`, `Content-Type` or `Forwarded` — and no name may start with `X-Forwarded-`, `X-Envoy-` or `X-Lms-`. Comparisons are case-insensitive.",{"_3465":705,"_30219":654,"_20927":51429,"_5":14373,"_27457":51304,"_2948":51430},[],"**Invalid configurations are rejected at subscribe time.** A channel configuration that would fail on every delivery returns HTTP 400 with a body that starts with `struct validation error:`, and the subscription is not created.",{"_3465":706,"_30219":654,"_20927":51432,"_5":14373,"_27457":51304,"_2948":51433},[],"Credentials are sent regardless of the URL scheme. With an `http://` `webhook_url`, the API key or bearer token travels in cleartext and mTLS has no effect. Prefer `https://` for `webhook_url`, `oidc_well_known` and the token endpoint it advertises.",{"_3465":707,"_30219":654,"_20927":51435,"_5":14373,"_27457":51308,"_2948":51436},[],"Open an existing subscription to review its destination and filter, modify the configuration or select **Unsubscribe**. Remove subscriptions that no longer have an operational owner to avoid ignored deliveries or stale endpoints.",{"_3465":708,"_30219":654,"_20927":51438,"_5":14373,"_27457":51308,"_2948":51439},[],"Subscriptions created with older console versions may store the webhook target under `url` and `method` instead of `webhook_url` and `webhook_method`. The service delivers only through `webhook_url` and `webhook_method`, so such a subscription does not deliver even though the subscription details show the stored target. Open the subscription and save it again: the edit form prefills the stored target, and saving rewrites the channel configuration in the current layout.",{"_3465":709,"_30219":654,"_20927":51441,"_5":14373,"_27457":51312,"_2948":51442},[],"**Authorities:** `ca.create`, `ca.import`, `ca.reissue` and `ca.delete`.",{"_3465":710,"_30219":654,"_20927":51444,"_5":14373,"_27457":51312,"_2948":51445},[],"**Certificates:** `ca.sign.certificate` and `certificate.delete`.",{"_3465":711,"_30219":654,"_20927":51447,"_5":14373,"_27457":51312,"_2948":51448},[],"**Profiles:** `profile.issuance.create`, `profile.issuance.update` and `profile.issuance.delete`.",{"_3465":712,"_30219":654,"_20927":51450,"_5":14373,"_27457":51312,"_2948":51451},[],"**Enrollment:** `dms.create`, `dms.update`, `dms.enroll` and `dms.reenroll`.",{"_3465":713,"_30219":654,"_20927":51453,"_5":14373,"_27457":51312,"_2948":51454},[],"**Devices:** `device.create`, `device.identity.update` and `device.status.update`.",{"_3465":714,"_30219":654,"_20927":51456,"_5":14373,"_27457":51312,"_2948":51457},[],"**Validation:** `va.role.crl.create`, `va.crl-settings.init` and `va.crl-settings.update`.",{"_3465":715,"_30219":654,"_20927":51459,"_5":14373,"_27457":51312,"_2948":51460},[],"**Keys:** `kms.create`, `kms.import`, `kms.sign` and `kms.delete`.",{"_3465":716,"_30219":654,"_20927":51462,"_5":14373,"_27457":51312,"_2948":51463},[],"Use the catalog shown in the console as the source for the types available in your deployed version.",{"_3465":717,"_30219":654,"_20927":51465,"_5":14373,"_27457":51312,"_2948":51466},[],"Since 4.0.0, `va.crl-settings.init` and `va.crl-settings.update` carry the CRL settings of a CA (`ca_id`) and replace `va.role.crl.init` and `va.role.update`. The upgrade migration renames the types of existing subscriptions automatically, but it does not rewrite their conditions: review filters that read the old payload or the old `crl/<ski>` subject, including filters for `va.role.crl.create` (see 3.8.0 to 4.0.0).",{"_3465":718,"_30219":718,"_5":14725,"_2948":51468,"_30551":51469,"_20927":51470,"_27457":718},"Audit logs",[49254,50729,50730],[],{"_3465":719,"_30219":718,"_20927":51472,"_5":14373,"_27457":718,"_2948":51473},[],"Understand which audit events Lamassu generates and how to turn them into a durable trail.",{"_3465":720,"_30219":718,"_5":30548,"_20927":51475,"_27457":51476,"_2948":51477},[],"/docs/platform/administration/audit-logs#what-an-event-contains","What an event contains",{"_3465":721,"_30219":718,"_5":30548,"_20927":51479,"_27457":51480,"_2948":51481},[],"/docs/platform/administration/audit-logs#coverage","Coverage",{"_3465":722,"_30219":718,"_5":30548,"_20927":51483,"_27457":51484,"_2948":51485},[],"/docs/platform/administration/audit-logs#publication-and-persistence","Publication and persistence",{"_3465":723,"_30219":718,"_5":30548,"_20927":51487,"_27457":51488,"_2948":51489},[],"/docs/platform/administration/audit-logs#sensitive-data","Sensitive data",{"_3465":724,"_30219":718,"_5":30548,"_20927":51491,"_27457":51492,"_2948":51493},[],"/docs/platform/administration/audit-logs#a-reproducible-investigation","A reproducible investigation",{"_3465":725,"_30219":718,"_5":30548,"_20927":51495,"_27457":51496,"_2948":51497},[],"/docs/platform/administration/audit-logs#bound-the-interval","Bound the interval",{"_3465":726,"_30219":718,"_5":30548,"_20927":51499,"_27457":51500,"_2948":51501},[],"/docs/platform/administration/audit-logs#identify-the-operation","Identify the operation",{"_3465":727,"_30219":718,"_5":30548,"_20927":51503,"_27457":51504,"_2948":51505},[],"/docs/platform/administration/audit-logs#attribute-the-principal","Attribute the principal",{"_3465":728,"_30219":718,"_5":30548,"_20927":51507,"_27457":51508,"_2948":51509},[],"/docs/platform/administration/audit-logs#compare-intent-and-result","Compare intent and result",{"_3465":729,"_30219":718,"_5":30548,"_20927":51511,"_27457":51512,"_2948":51513},[],"/docs/platform/administration/audit-logs#follow-the-effect","Follow the effect",{"_3465":730,"_30219":718,"_5":30548,"_20927":51515,"_27457":51516,"_2948":51517},[],"/docs/platform/administration/audit-logs#periodic-verification","Periodic verification",{"_3465":731,"_30219":718,"_20927":51519,"_5":14373,"_27457":718,"_2948":51520},[],"Lamassu instruments the mutable operations of its services with audit events. Each event describes the operation, the principals that matched, the input, the result and whether it ended in error.",{"_3465":732,"_30219":718,"_20927":51522,"_5":14373,"_27457":51476,"_2948":51523},[],"The audit body includes:",{"_3465":733,"_30219":718,"_20927":51525,"_5":14373,"_27457":51476,"_2948":51526},[],"input: data received by the operation;",{"_3465":734,"_30219":718,"_20927":51528,"_5":14373,"_27457":51476,"_2948":51529},[],"has\\_error: whether the service returned an error;",{"_3465":735,"_30219":718,"_20927":51531,"_5":14373,"_27457":51476,"_2948":51532},[],"output: produced result or error message;",{"_3465":736,"_30219":718,"_20927":51534,"_5":14373,"_27457":51476,"_2948":51535},[],"principals: identifiers of the principals that matched the request.",{"_3465":737,"_30219":718,"_20927":51537,"_5":14373,"_27457":51476,"_2948":51538},[],"Successful operations use a type prefixed with audit.. Failures publish the operation type suffixed with .error. The CloudEvents event additionally adds source, identifier, date and type.",{"_3465":738,"_30219":718,"_20927":51540,"_5":14373,"_27457":51476,"_2948":51541},[],"The middlewares publish the record after executing the operation, whether it succeeded or returned an error. This lets you investigate attempts as well as confirmed changes.",{"_3465":739,"_30219":718,"_20927":51543,"_5":14373,"_27457":51480,"_2948":51544},[],"The backend applies auditing to mutations of:",{"_3465":740,"_30219":718,"_20927":51546,"_5":14373,"_27457":51480,"_2948":51547},[],"authorities, certificates and issuance profiles;",{"_3465":741,"_30219":718,"_20927":51549,"_5":14373,"_27457":51480,"_2948":51550},[],"keys and KMS engines;",{"_3465":742,"_30219":718,"_20927":51552,"_5":14373,"_27457":51480,"_2948":51553},[],"devices and identities;",{"_3465":743,"_30219":718,"_20927":51555,"_5":14373,"_27457":51480,"_2948":51556},[],"DMSs and enrollment operations;",{"_3465":744,"_30219":718,"_20927":51558,"_5":14373,"_27457":51480,"_2948":51559},[],"validation functions and CRL;",{"_3465":745,"_30219":718,"_20927":51561,"_5":14373,"_27457":51480,"_2948":51562},[],"principals, policies and authorization grants.",{"_3465":746,"_30219":718,"_20927":51564,"_5":14373,"_27457":51480,"_2948":51565},[],"Do not confuse these events with domain events. A domain event announces that a resource changed so another component can react; the audit event keeps input, output and principal context for investigation.",{"_3465":747,"_30219":718,"_20927":51567,"_5":14373,"_27457":51484,"_2948":51568},[],"Services publish audit records to the event bus when their PublisherEventBus is enabled. The backend code does not, by itself, implement a queryable, durable audit file.",{"_3465":748,"_30219":718,"_20927":51570,"_5":14373,"_27457":51484,"_2948":51571},[],"If you need retention, search, tamper protection or regulatory export, connect a consumer that persists the events into the system approved by your organization.",{"_3465":749,"_30219":718,"_20927":51573,"_5":14373,"_27457":51484,"_2948":51574},[],"Design the consumer to:",{"_3465":750,"_30219":718,"_20927":51576,"_5":14373,"_27457":51484,"_2948":51577},[],"subscribe to the audit.# types and also to operation types ending in .error;",{"_3465":751,"_30219":718,"_20927":51579,"_5":14373,"_27457":51484,"_2948":51580},[],"keep the complete CloudEvent unmodified;",{"_3465":752,"_30219":718,"_20927":51582,"_5":14373,"_27457":51484,"_2948":51583},[],"record the ingestion time and detect duplicates by ID;",{"_3465":753,"_30219":718,"_20927":51585,"_5":14373,"_27457":51484,"_2948":51586},[],"encrypt in transit and at rest;",{"_3465":754,"_30219":718,"_20927":51588,"_5":14373,"_27457":51484,"_2948":51589},[],"restrict reading and deletion to a role separate from the PKI operator;",{"_3465":755,"_30219":718,"_20927":51591,"_5":14373,"_27457":51484,"_2948":51592},[],"apply an explicit retention and legal hold policy;",{"_3465":756,"_30219":718,"_20927":51594,"_5":14373,"_27457":51484,"_2948":51595},[],"alert if it stops consuming or the pending queue grows.",{"_3465":757,"_30219":718,"_20927":51597,"_5":14373,"_27457":51488,"_2948":51598},[],"The input and output fields can contain subjects, metadata, public material, configuration or error messages. Evaluate their classification before sending them to an external platform.",{"_3465":758,"_30219":718,"_20927":51600,"_5":14373,"_27457":51488,"_2948":51601},[],"Do not log private keys, provider secrets or full tokens in automations around Lamassu. Restrict export and apply redaction at the destination without destroying the fields needed for attribution.",{"_3465":759,"_30219":718,"_20927":51603,"_5":14373,"_27457":51496,"_2948":51604},[],"Start from the reported time and normalize every source to UTC.",{"_3465":760,"_30219":718,"_20927":51606,"_5":14373,"_27457":51500,"_2948":51607},[],"Filter by event type, service source and resource identifier.",{"_3465":761,"_30219":718,"_20927":51609,"_5":14373,"_27457":51504,"_2948":51610},[],"Review principals and correlate them with the OIDC provider or the X.509 identity valid at that moment.",{"_3465":762,"_30219":718,"_20927":51612,"_5":14373,"_27457":51508,"_2948":51613},[],"Contrast input, has\\_error and output. A failed attempt does not mean the resource changed.",{"_3465":763,"_30219":718,"_20927":51615,"_5":14373,"_27457":51512,"_2948":51616},[],"Look for the domain events and service records that share resource and time window. In a CA revocation, include the cascading operations.",{"_3465":764,"_30219":718,"_20927":51618,"_5":14373,"_27457":51516,"_2948":51619},[],"Generate a controlled mutation in a test environment and check that:",{"_3465":765,"_30219":718,"_20927":51621,"_5":14373,"_27457":51516,"_2948":51622},[],"a successful audit event appears;",{"_3465":766,"_30219":718,"_20927":51624,"_5":14373,"_27457":51516,"_2948":51625},[],"the principal matches the identity used;",{"_3465":767,"_30219":718,"_20927":51627,"_5":14373,"_27457":51516,"_2948":51628},[],"the consumer persists it exactly once;",{"_3465":768,"_30219":718,"_20927":51630,"_5":14373,"_27457":51516,"_2948":51631},[],"it can be retrieved by resource, actor and period;",{"_3465":769,"_30219":718,"_20927":51633,"_5":14373,"_27457":51516,"_2948":51634},[],"a consumer outage raises an alert.",{"_3465":770,"_30219":718,"_20927":51636,"_5":14373,"_27457":51516,"_2948":51637},[],"For metrics, traces and technical logs of the deployment, see Troubleshooting. Audit answers \"who tried to change what\"; observability explains how the system behaved.",{"_3465":771,"_30219":771,"_5":14725,"_2948":51639,"_30551":51640,"_20927":51641,"_27457":771},"Platform architecture",[49254,50729],[],{"_3465":772,"_30219":771,"_20927":51643,"_5":14373,"_27457":771,"_2948":51644},[],"Lamassu components and how control, keys, issuance and devices relate.",{"_3465":773,"_30219":771,"_5":30548,"_20927":51646,"_27457":51647,"_2948":51648},[],"/docs/platform/concepts/architecture#control-plane","Control plane",{"_3465":774,"_30219":771,"_5":30548,"_20927":51650,"_27457":51651,"_2948":51652},[],"/docs/platform/concepts/architecture#key-custody-and-cryptographic-operations","Key custody and cryptographic operations",{"_3465":775,"_30219":771,"_5":30548,"_20927":51654,"_27457":51655,"_2948":51656},[],"/docs/platform/concepts/architecture#issuance-and-enrollment","Issuance and enrollment",{"_3465":776,"_30219":771,"_5":30548,"_20927":51658,"_27457":51659,"_2948":51660},[],"/docs/platform/concepts/architecture#status-and-validation","Status and validation",{"_3465":777,"_30219":771,"_5":30548,"_20927":51662,"_27457":51663,"_2948":51664},[],"/docs/platform/concepts/architecture#platform-dependencies","Platform dependencies",{"_3465":778,"_30219":771,"_20927":51666,"_5":14373,"_27457":771,"_2948":51667},[],"Lamassu deploys as a set of independent services. This separation keeps every component from needing direct access to private keys and lets each capability scale according to load.",{"_3465":779,"_30219":771,"_20927":51669,"_5":14373,"_27457":771,"_2948":51670},[],"Switch to the low level to see the internals of the Lamassu platform box (CA, KMS, DMS, Device Manager, VA, Alerts, AWS IoT connector, Job Manager and the console/API), and to medium to see it as a single platform alongside its external dependencies.",{"_3465":780,"_30219":771,"_20927":51672,"_5":14373,"_27457":51647,"_2948":51673},[],"The console and the APIs manage authorities, certificates, DMSs, devices, alerts and configuration. Domain events allow connectors and automations to react to changes without continuously polling the platform.",{"_3465":781,"_30219":771,"_20927":51675,"_5":14373,"_27457":51651,"_2948":51676},[],"The KMS offers a common interface over software engines, PKCS#11 and cloud providers. The selected engine keeps the key or delegates the cryptographic operation without the other services knowing its implementation.",{"_3465":782,"_30219":771,"_20927":51678,"_5":14373,"_27457":51655,"_2948":51679},[],"The CA service issues certificates and maintains the relationship with its authority. The DMS applies the enrollment rules and exposes the EST flows so a device can request or renew an identity.",{"_3465":783,"_30219":771,"_20927":51681,"_5":14373,"_27457":51659,"_2948":51682},[],"Device Manager keeps the operational view of the device and its history. The Validation Authority publishes OCSP and CRLs so other systems can decide whether to trust a presented certificate.",{"_3465":784,"_30219":771,"_20927":51684,"_5":14373,"_27457":51663,"_2948":51685},[],"In a self-managed deployment, Lamassu uses PostgreSQL for persistence, RabbitMQ for messaging and an OIDC provider for authentication. See the deployment architecture for how the services are published on Kubernetes.",{"_3465":785,"_30219":785,"_5":14725,"_2948":51687,"_30551":51688,"_20927":51689,"_27457":785},"How Lamassu works",[49254,50729],[],{"_3465":786,"_30219":785,"_20927":51691,"_5":14373,"_27457":785,"_2948":51692},[],"The mental model of trust, keys, certificates and devices.",{"_3465":787,"_30219":785,"_5":30548,"_20927":51694,"_27457":51695,"_2948":51696},[],"/docs/platform/concepts/overview#the-model-in-five-pieces","The model in five pieces",{"_3465":788,"_30219":785,"_5":30548,"_20927":51698,"_27457":51699,"_2948":51700},[],"/docs/platform/concepts/overview#from-onboarding-to-operation","From onboarding to operation",{"_3465":789,"_30219":785,"_20927":51702,"_5":14373,"_27457":785,"_2948":51703},[],"Lamassu connects three elements: a **root of trust**, an **issuance policy** and an **entity that needs to prove its identity**. The platform coordinates these elements throughout the certificate lifecycle.",{"_3465":790,"_30219":785,"_20927":51705,"_5":14373,"_27457":51695,"_2948":51706},[],"**Cryptographic engine.** Generates or safeguards keys and executes private-key operations without exposing key material to the rest of the services.",{"_3465":791,"_30219":785,"_20927":51708,"_5":14373,"_27457":51695,"_2948":51709},[],"**Certification Authority (CA).** Signs certificates and establishes the chain of trust.",{"_3465":792,"_30219":785,"_20927":51711,"_5":14373,"_27457":51695,"_2948":51712},[],"**Device Management Service (DMS).** Defines how the devices of a fleet are registered, authenticated and renewed.",{"_3465":793,"_30219":785,"_20927":51714,"_5":14373,"_27457":51695,"_2948":51715},[],"**Device.** Keeps its private key and presents the certificate to prove its identity.",{"_3465":794,"_30219":785,"_20927":51717,"_5":14373,"_27457":51695,"_2948":51718},[],"**Validation Authority (VA).** Publishes the status of certificates through OCSP and CRL.",{"_3465":795,"_30219":785,"_20927":51720,"_5":14373,"_27457":51699,"_2948":51721},[],"An administrator configures a cryptographic engine and creates or imports a CA.",{"_3465":796,"_30219":785,"_20927":51723,"_5":14373,"_27457":51699,"_2948":51724},[],"A DMS relates that CA to an enrollment policy.",{"_3465":797,"_30219":785,"_20927":51726,"_5":14373,"_27457":51699,"_2948":51727},[],"The device generates a key and requests a certificate through EST, or an operator assigns it an identity.",{"_3465":798,"_30219":785,"_20927":51729,"_5":14373,"_27457":51699,"_2948":51730},[],"Lamassu keeps the inventory, history and status of the identity.",{"_3465":799,"_30219":785,"_20927":51732,"_5":14373,"_27457":51699,"_2948":51733},[],"Consumers check the chain and query OCSP or a CRL when they need to know whether it is still valid.",{"_3465":800,"_30219":785,"_20927":51735,"_5":14373,"_27457":51699,"_2948":51736},[],"<Card title=\"Architecture\" description=\"Get to know the components and where each one's responsibility ends.\" href=\"/docs/platform/concepts/architecture\" />",{"_3465":801,"_30219":785,"_20927":51738,"_5":14373,"_27457":51699,"_2948":51739},[],"<Card title=\"Identity lifecycle\" description=\"Follow a certificate from enrollment to renewal or revocation.\" href=\"/docs/platform/pki/concepts/certificate-lifecycle\" />",{"_3465":802,"_30219":802,"_5":14725,"_2948":51741,"_30551":51742,"_20927":51744,"_27457":802},"Devices and identities",[49254,50729,51743,51741],"IoT Fleets",[],{"_3465":803,"_30219":802,"_20927":51746,"_5":14373,"_27457":802,"_2948":51747},[],"Register, inspect and retire devices while checking their current identity and history.",{"_3465":804,"_30219":802,"_5":30548,"_20927":51749,"_27457":51750,"_2948":51751},[],"/docs/platform/iot-fleets/device-management#device-states","Device states",{"_3465":805,"_30219":802,"_5":30548,"_20927":51753,"_27457":51754,"_2948":51755},[],"/docs/platform/iot-fleets/device-management#inspect-a-device","Inspect a device",{"_3465":806,"_30219":802,"_5":30548,"_20927":51757,"_27457":51758,"_2948":51759},[],"/docs/platform/iot-fleets/device-management#register-a-device-manually","Register a device manually",{"_3465":807,"_30219":802,"_5":30548,"_20927":51761,"_27457":51762,"_2948":51763},[],"/docs/platform/iot-fleets/device-management#create-the-device","Create the device",{"_3465":808,"_30219":802,"_5":30548,"_20927":51765,"_27457":51766,"_2948":51767},[],"/docs/platform/iot-fleets/device-management#define-its-membership","Define its membership",{"_3465":809,"_30219":802,"_5":30548,"_20927":51769,"_27457":51770,"_2948":51771},[],"/docs/platform/iot-fleets/device-management#classify-the-device","Classify the device",{"_3465":810,"_30219":802,"_5":30548,"_20927":51773,"_27457":51774,"_2948":51775},[],"/docs/platform/iot-fleets/device-management#verify-the-registration","Verify the registration",{"_3465":811,"_30219":802,"_5":30548,"_20927":51777,"_27457":51778,"_2948":51779},[],"/docs/platform/iot-fleets/device-management#assign-an-identity-manually","Assign an identity manually",{"_3465":812,"_30219":802,"_5":30548,"_20927":51781,"_27457":51782,"_2948":51783},[],"/docs/platform/iot-fleets/device-management#revoke-the-current-identity","Revoke the current identity",{"_3465":813,"_30219":802,"_5":30548,"_20927":51785,"_27457":51786,"_2948":51787},[],"/docs/platform/iot-fleets/device-management#decommission-a-device","Decommission a device",{"_3465":814,"_30219":802,"_5":30548,"_20927":51789,"_27457":51790,"_2948":51791},[],"/docs/platform/iot-fleets/device-management#automate-enrollment","Automate enrollment",{"_3465":815,"_30219":802,"_20927":51793,"_5":14373,"_27457":802,"_2948":51794},[],"This guide is for a fleet operator. You need device, DMS and certificate permissions for the intended actions. A fleet is organized through these resources, tags and metadata; there is no separate “fleet” object to create.",{"_3465":816,"_30219":802,"_20927":51796,"_5":14373,"_27457":802,"_2948":51797},[],"Each device has a `Device ID`, one owning DMS (`dms_owner`) and, once provisioned, an identity slot with an active version and previous versions. In these flows, keep the CSR and certificate `Common Name` equal to `Device ID`: binding uses that CN to update the device.",{"_3465":817,"_30219":802,"_20927":51799,"_5":14373,"_27457":51750,"_2948":51800},[],"Operational view",{"_3465":818,"_30219":802,"_20927":51802,"_5":14373,"_27457":51750,"_2948":51803},[],"Meaning",{"_3465":819,"_30219":802,"_20927":51805,"_5":14373,"_27457":51750,"_2948":51806},[],"**No Identity**",{"_3465":820,"_30219":802,"_20927":51808,"_5":14373,"_27457":51750,"_2948":51809},[],"A record exists without an associated identity.",{"_3465":821,"_30219":802,"_20927":51811,"_5":14373,"_27457":51750,"_2948":51812},[],"**Active**",{"_3465":822,"_30219":802,"_20927":51814,"_5":14373,"_27457":51750,"_2948":51815},[],"The slot is active; also check certificate dates, status and usages.",{"_3465":823,"_30219":802,"_20927":51817,"_5":14373,"_27457":51750,"_2948":51818},[],"**Renewal Pending**",{"_3465":824,"_30219":802,"_20927":51820,"_5":14373,"_27457":51750,"_2948":51821},[],"The identity is in the operational renewal window.",{"_3465":825,"_30219":802,"_20927":51823,"_5":14373,"_27457":51750,"_2948":51824},[],"**Expiring Soon**",{"_3465":826,"_30219":802,"_20927":51826,"_5":14373,"_27457":51750,"_2948":51827},[],"Expiration is approaching according to configured thresholds.",{"_3465":827,"_30219":802,"_20927":51829,"_5":14373,"_27457":51750,"_2948":51830},[],"**Expired**",{"_3465":828,"_30219":802,"_20927":51832,"_5":14373,"_27457":51750,"_2948":51833},[],"The identity has expired.",{"_3465":829,"_30219":802,"_20927":51835,"_5":14373,"_27457":51750,"_2948":51836},[],"**Revoked**",{"_3465":830,"_30219":802,"_20927":51838,"_5":14373,"_27457":51750,"_2948":51839},[],"The identity is marked revoked.",{"_3465":831,"_30219":802,"_20927":51841,"_5":14373,"_27457":51750,"_2948":51842},[],"**Decommissioned**",{"_3465":832,"_30219":802,"_20927":51844,"_5":14373,"_27457":51750,"_2948":51845},[],"The record is retired and ordinary updates do not restore operation.",{"_3465":833,"_30219":802,"_20927":51847,"_5":14373,"_27457":51750,"_2948":51848},[],"Device, slot and certificate states are distinct. Events and jobs can update the view after saving a certificate; an **Active** label does not establish consumer acceptance.",{"_3465":834,"_30219":802,"_20927":51850,"_5":14373,"_27457":51754,"_2948":51851},[],"Filter the inventory by ID, tags and status. Open details and record the owning DMS, active version and current certificate serial.",{"_3465":835,"_30219":802,"_20927":51853,"_5":14373,"_27457":51754,"_2948":51854},[],"**Certificate History** relates previous and current versions. Replacing the slot does not by itself revoke every previous version.",{"_3465":836,"_30219":802,"_20927":51856,"_5":14373,"_27457":51754,"_2948":51857},[],"**Device Event Timeline** helps reconstruct registration, provisioning, renewal and status changes. A change may be saved even if event persistence fails; also inspect the record and certificates.",{"_3465":837,"_30219":802,"_20927":51859,"_5":14373,"_27457":51754,"_2948":51860},[],"Compare these values with the identity installed on the device. Updating a Lamassu slot does not install files on the remote equipment.",{"_3465":838,"_30219":802,"_20927":51862,"_5":14373,"_27457":51758,"_2948":51863},[],"Use this flow to prepare inventory or assign an identity through the console. You need an existing DMS.",{"_3465":839,"_30219":802,"_20927":51865,"_5":14373,"_27457":51762,"_2948":51866},[],"Open registration in **Managed Devices**. Confirm the ID does not already exist in another DMS: ID lookup is not restricted to a fleet.",{"_3465":840,"_30219":802,"_20927":51868,"_5":14373,"_27457":51766,"_2948":51869},[],"Enter **Device ID** and select its owning DMS. The console’s **Registration Authority** label refers to that DMS.",{"_3465":841,"_30219":802,"_20927":51871,"_5":14373,"_27457":51770,"_2948":51872},[],"Add model, environment or location tags and an icon according to your inventory.",{"_3465":842,"_30219":802,"_20927":51874,"_5":14373,"_27457":51774,"_2948":51875},[],"Read the device again: require the intended DMS and **No Identity**. Follow Manual registration to complete assignment.",{"_3465":843,"_30219":802,"_20927":51877,"_5":14373,"_27457":51774,"_2948":51878},[],"Preregistration does not establish that `/simpleenroll` will admit the request. Review its interaction with `enable_replaceable_enrollment` in Provisioning strategies.",{"_3465":844,"_30219":802,"_20927":51880,"_5":14373,"_27457":51778,"_2948":51881},[],"From **No Identity**, use **Assign Identity**:",{"_3465":845,"_30219":802,"_20927":51883,"_5":14373,"_27457":51778,"_2948":51884},[],"Select an active, current certificate suitable for the consumer, with `CN` exactly equal to `Device ID`.",{"_3465":846,"_30219":802,"_20927":51886,"_5":14373,"_27457":51778,"_2948":51887},[],"If unavailable, **Issue New Instead** starts issuance using the intended CA. Review the profile first.",{"_3465":847,"_30219":802,"_20927":51889,"_5":14373,"_27457":51778,"_2948":51890},[],"Confirm and read the serial, active version and history again.",{"_3465":848,"_30219":802,"_20927":51892,"_5":14373,"_27457":51778,"_2948":51893},[],"Install the key/certificate pair and required intermediates on the device and test usage.",{"_3465":849,"_30219":802,"_20927":51895,"_5":14373,"_27457":51778,"_2948":51896},[],"Issuing, binding and installing are separate steps. If an operation fails, check which steps persisted before repeating it.",{"_3465":850,"_30219":802,"_20927":51898,"_5":14373,"_27457":51782,"_2948":51899},[],"Locate the active serial in history and revoke it with an appropriate reason. Verify the record, OCSP/CRL publication and rejection of a new consumer connection using the certificate guide.",{"_3465":851,"_30219":802,"_20927":51901,"_5":14373,"_27457":51782,"_2948":51902},[],"Revocation does not remove the device. It does not automatically enable another enrollment either: recovery depends on its credential, status and DMS policy. `CertificateHold` can be reactivated under PKI conditions; other reasons block subsequent certificate changes.",{"_3465":852,"_30219":802,"_20927":51904,"_5":14373,"_27457":51786,"_2948":51905},[],"Before **Decommission**, inventory active and previous identities, connections and destination permissions. Prepare retirement in the consumer.",{"_3465":853,"_30219":802,"_20927":51907,"_5":14373,"_27457":51786,"_2948":51908},[],"The backend saves **Decommissioned** and attempts to revoke the active version’s certificate with `CessationOfOperation` if the slot was not expired or revoked. It does not traverse all history. Deferred revocation can fail after retirement is saved; check the result by serial.",{"_3465":854,"_30219":802,"_20927":51910,"_5":14373,"_27457":51786,"_2948":51911},[],"Retired status protects ordinary device and slot updates. It does not guarantee that every EST request is rejected before issuance: binding can skip a retired device without returning an error. Check for remaining usable certificates or permissions and block new admission in the relevant control.",{"_3465":855,"_30219":802,"_20927":51913,"_5":14373,"_27457":51786,"_2948":51914},[],"Retain records according to audit policy. Do not reuse a retired ID to hide an equipment change.",{"_3465":856,"_30219":802,"_20927":51916,"_5":14373,"_27457":51790,"_2948":51917},[],"<Card title=\"Enroll and connect a device\" description=\"Obtain an identity from the client and test mTLS.\" href=\"/docs/platform/iot-fleets/quickstarts/enroll-device\" />",{"_3465":857,"_30219":802,"_20927":51919,"_5":14373,"_27457":51790,"_2948":51920},[],"<Card title=\"Renewal and recovery\" description=\"Install the successor and handle failures without losing known state.\" href=\"/docs/platform/iot-fleets/enrollment/renewal-and-recovery\" />",{"_3465":858,"_30219":858,"_5":14725,"_2948":51922,"_30551":51923,"_20927":51925,"_27457":858},"Bootstrap identity and authentication",[49254,50729,51743,51741,51924],"Enrollment with PKI",[],{"_3465":859,"_30219":858,"_20927":51927,"_5":14373,"_27457":858,"_2948":51928},[],"Prepare server trust and admission proofs for enroll and reenroll.",{"_3465":860,"_30219":858,"_5":30548,"_20927":51930,"_27457":51931,"_2948":51932},[],"/docs/platform/iot-fleets/enrollment/bootstrap-identity#initial-server-trust","Initial server trust",{"_3465":861,"_30219":858,"_5":30548,"_20927":51934,"_27457":51935,"_2948":51936},[],"/docs/platform/iot-fleets/enrollment/bootstrap-identity#bootstrap-credential","Bootstrap credential",{"_3465":862,"_30219":858,"_5":30548,"_20927":51938,"_27457":51939,"_2948":51940},[],"/docs/platform/iot-fleets/enrollment/bootstrap-identity#modes-per-operation","Modes per operation",{"_3465":863,"_30219":858,"_5":30548,"_20927":51942,"_27457":51943,"_2948":51944},[],"/docs/platform/iot-fleets/enrollment/bootstrap-identity#webhook-contract","Webhook contract",{"_3465":864,"_30219":858,"_5":30548,"_20927":51946,"_27457":51947,"_2948":51948},[],"/docs/platform/iot-fleets/enrollment/bootstrap-identity#revocation-and-checks","Revocation and checks",{"_3465":865,"_30219":858,"_20927":51950,"_5":14373,"_27457":858,"_2948":51951},[],"This guide connects the DMS administrator with device manufacturing and integration. Before requesting an operational identity, the client must authenticate the EST server and establish entitlement to request the intended ID.",{"_3465":866,"_30219":858,"_20927":51953,"_5":14373,"_27457":51931,"_2948":51954},[],"Install a previously verified root, chain or pin through a trusted channel: manufacturing, approved configuration or authenticated distribution. It enables TLS and server-name verification before downloading `/cacerts`.",{"_3465":867,"_30219":858,"_20927":51956,"_5":14373,"_27457":51931,"_2948":51957},[],"Your only trust proof cannot come from the same unauthenticated server. The EST server TLS certificate, bootstrap certificate and operational identity issuer may belong to different hierarchies.",{"_3465":868,"_30219":858,"_20927":51959,"_5":14373,"_27457":51935,"_2948":51960},[],"With `CLIENT_CERTIFICATE`, the device presents its initial certificate and proves key possession through TLS. The DMS validates it against admission CAs. In the inspected flow, the validator receives one leaf credential: configure and test the direct issuer for the simple case; sending more intermediates does not establish delivery to the service.",{"_3465":869,"_30219":858,"_20927":51962,"_5":14373,"_27457":51935,"_2948":51963},[],"Check dates, matching certificate/key and revocation before provisioning. A credential shared across equipment identifies that shared credential, not an individual device.",{"_3465":870,"_30219":858,"_20927":51965,"_5":14373,"_27457":51935,"_2948":51966},[],"Initial mTLS validation does not by itself compare bootstrap CN with the requested CSR CN. If a requester should only request its own `Device ID`, add a control binding credential to ID, such as the combined webhook, and test a request with another CN. Certificate re-enrollment does compare its CN to the CSR; subsequent checks use the registered active identity.",{"_3465":871,"_30219":858,"_20927":51968,"_5":14373,"_27457":51939,"_2948":51969},[],"Select the four modes independently for enrollment and re-enrollment in DMS. Renewal credentials depend on that block; do not assume the bootstrap is always used or the webhook disappears.",{"_3465":872,"_30219":858,"_20927":51971,"_5":14373,"_27457":51939,"_2948":51972},[],"An administrative OIDC token is not a native EST mode. A webhook may interpret an agreed credential header; that service then performs authorization. In NO\\_AUTH, sending a token does not add DMS authentication.",{"_3465":873,"_30219":858,"_20927":51974,"_5":14373,"_27457":51943,"_2948":51975},[],"The DMS sends operation context to the configured service. Method comes from configuration; agree the contract before selecting POST or PUT. Authorization wait defaults to 10 seconds, replaced by a configured positive timeout. The DMS verifies the receiver certificate unless `insecure_skip_verify` is enabled in the webhook config — verification is on by default — and does not follow redirects, so the configured URL must be the final one. The authorization response must be JSON of at most 1 MiB. With Lamassu-to-webhook authentication configured over `http://`, the API key or bearer token travels in cleartext, and mTLS has no effect because no TLS handshake takes place, so the client certificate is never presented; prefer `https://`. Configure those options in the webhook settings of the DMS guide.",{"_3465":874,"_30219":858,"_20927":51977,"_5":14373,"_27457":51943,"_2948":51978},[],"Example body:",{"_3465":875,"_30219":858,"_20927":51980,"_5":14373,"_27457":51943,"_2948":51981},[],"`csr` is **base64 of PEM**, unlike the EST body, which is base64 of DER. `http_request` contains URL and first header entries from available HTTP context. This body does not include an `operation` field; distinguish enroll and reenroll through the path and configured policy.",{"_3465":876,"_30219":858,"_20927":51983,"_5":14373,"_27457":51943,"_2948":51984},[],"The webhook should verify credential, its relationship to `device_cn`, DMS, operation and admission policy. Forwarded headers are not themselves trusted evidence. **Lamassu-to-webhook authentication** is a separate relationship configured in the server’s HTTP client.",{"_3465":877,"_30219":858,"_20927":51986,"_5":14373,"_27457":51943,"_2948":51987},[],"Continuation requires a successful HTTP response and JSON:",{"_3465":878,"_30219":858,"_20927":51989,"_5":14373,"_27457":51943,"_2948":51990},[],"A bodyless `204` does not satisfy the contract. Denial, transport error, uninterpretable response or timeout abort authorization. Combined mode validates the certificate first, then queries the webhook. See the webhook specification.",{"_3465":879,"_30219":858,"_20927":51992,"_5":14373,"_27457":51947,"_2948":51993},[],"The DMS first looks up the certificate in Lamassu; for external certificates it attempts OCSP and CRL. If revocation cannot be checked, validators can continue treating it as not revoked. The code also does not establish rejection of every external status other than Good. Test required behavior with your actual credential and endpoint; do not present this as guaranteed strict enforcement across every source.",{"_3465":880,"_30219":858,"_20927":51995,"_5":14373,"_27457":51947,"_2948":51996},[],"Test an allowed certificate, an incorrect one, another CN, webhook denial, timeout and re-enrollment under its own policy. Keep results and schedule bootstrap credential retirement where appropriate. Continue with EST client.",{"_3465":881,"_30219":881,"_5":14725,"_2948":51998,"_30551":51999,"_20927":52000,"_27457":881},"Configure and operate the DMS",[49254,50729,51743,51741,51924],[],{"_3465":882,"_30219":881,"_20927":52002,"_5":14373,"_27457":881,"_2948":52003},[],"Define registration, authentication per operation, issuance, renewal and distributed trust.",{"_3465":883,"_30219":881,"_5":30548,"_20927":52005,"_27457":52006,"_2948":49264},[],"/docs/platform/iot-fleets/enrollment/dms#before-you-begin",{"_3465":884,"_30219":881,"_5":30548,"_20927":52008,"_27457":52009,"_2948":52010},[],"/docs/platform/iot-fleets/enrollment/dms#configure-a-dms","Configure a DMS",{"_3465":885,"_30219":881,"_5":30548,"_20927":52012,"_27457":52013,"_2948":52014},[],"/docs/platform/iot-fleets/enrollment/dms#identify-the-fleet","Identify the fleet",{"_3465":886,"_30219":881,"_5":30548,"_20927":52016,"_27457":52017,"_2948":52018},[],"/docs/platform/iot-fleets/enrollment/dms#select-the-enrollment-ca","Select the enrollment CA",{"_3465":887,"_30219":881,"_5":30548,"_20927":52020,"_27457":52021,"_2948":52022},[],"/docs/platform/iot-fleets/enrollment/dms#configure-est","Configure EST",{"_3465":888,"_30219":881,"_5":30548,"_20927":52024,"_27457":52025,"_2948":52026},[],"/docs/platform/iot-fleets/enrollment/dms#distribute-trust","Distribute trust",{"_3465":889,"_30219":881,"_5":30548,"_20927":52028,"_27457":52029,"_2948":52030},[],"/docs/platform/iot-fleets/enrollment/dms#verify-the-endpoints","Verify the endpoints",{"_3465":890,"_30219":881,"_5":30548,"_20927":52032,"_27457":52033,"_2948":52034},[],"/docs/platform/iot-fleets/enrollment/dms#enrollment-configuration","Enrollment configuration",{"_3465":891,"_30219":881,"_5":30548,"_20927":52036,"_27457":52037,"_2948":52038},[],"/docs/platform/iot-fleets/enrollment/dms#enrollment-device-registration","Enrollment Device Registration",{"_3465":892,"_30219":881,"_5":30548,"_20927":52040,"_27457":52041,"_2948":52042},[],"/docs/platform/iot-fleets/enrollment/dms#enrollment-settings","Enrollment Settings",{"_3465":893,"_30219":881,"_5":30548,"_20927":52044,"_27457":52045,"_2948":52046},[],"/docs/platform/iot-fleets/enrollment/dms#authentication-per-operation","Authentication per operation",{"_3465":894,"_30219":881,"_5":30548,"_20927":52048,"_27457":52049,"_2948":52050},[],"/docs/platform/iot-fleets/enrollment/dms#external-webhook-settings","External webhook settings",{"_3465":895,"_30219":881,"_5":30548,"_20927":52052,"_27457":52053,"_2948":52054},[],"/docs/platform/iot-fleets/enrollment/dms#issuance-profile","Issuance profile",{"_3465":896,"_30219":881,"_5":30548,"_20927":52056,"_27457":52057,"_2948":52058},[],"/docs/platform/iot-fleets/enrollment/dms#re-enrollment-configuration","Re-enrollment configuration",{"_3465":897,"_30219":881,"_5":30548,"_20927":52060,"_27457":52061,"_2948":52062},[],"/docs/platform/iot-fleets/enrollment/dms#serverkeygen","ServerKeyGen",{"_3465":898,"_30219":881,"_5":30548,"_20927":52064,"_27457":52065,"_2948":52066},[],"/docs/platform/iot-fleets/enrollment/dms#trust-distribution","Trust distribution",{"_3465":899,"_30219":881,"_5":30548,"_20927":52068,"_27457":52069,"_2948":52070},[],"/docs/platform/iot-fleets/enrollment/dms#operate-the-dms-inventory","Operate the DMS inventory",{"_3465":900,"_30219":881,"_5":30548,"_20927":52072,"_27457":52073,"_2948":52074},[],"/docs/platform/iot-fleets/enrollment/dms#integrate-the-devices","Integrate the devices",{"_3465":901,"_30219":881,"_20927":52076,"_5":14373,"_27457":881,"_2948":52077},[],"A &#x2A;*Device Management Service (DMS)** configures admission and identity lifecycle for its devices. It acts as a registration authority; the CA selected in `Enrollment CA` signs certificates. This guide is for the policy administrator.",{"_3465":902,"_30219":881,"_20927":52079,"_5":14373,"_27457":52006,"_2948":52080},[],"You need DMS management permissions, an active CA with a usable key and a tested issuance profile. Agree device ID, initial credential, consumer and renewal window with the integrator. Review Provisioning strategies before choosing registration and replacement.",{"_3465":903,"_30219":881,"_20927":52082,"_5":14373,"_27457":52006,"_2948":52083},[],"Prepare EST server trust and device connectivity through Deployment. Your operator’s administrative authentication does not replace device EST authentication.",{"_3465":904,"_30219":881,"_20927":52085,"_5":14373,"_27457":52013,"_2948":52086},[],"Create the DMS with a recognizable name and retain its ID. EST URLs use this identifier, not the display name. Each device retains one owning DMS.",{"_3465":905,"_30219":881,"_20927":52088,"_5":14373,"_27457":52017,"_2948":52089},[],"Choose **Enrollment CA** and an explicit profile appropriate for the end-entity identity. Keep CN compatible with `Device ID`. The test certificate should allow its intended purpose and expire within issuer validity.",{"_3465":906,"_30219":881,"_20927":52091,"_5":14373,"_27457":52021,"_2948":52092},[],"Select initial enrollment registration and authentication. Separately configure re-enrollment authentication, thresholds and previous certificate retirement. Leave ServerKeyGen disabled if the client generates its key.",{"_3465":907,"_30219":881,"_20927":52094,"_5":14373,"_27457":52025,"_2948":52095},[],"Select certificates returned by `/cacerts`. Explicitly include required intermediates and roots, keeping distribution distinct from automatic trust installation.",{"_3465":908,"_30219":881,"_20927":52097,"_5":14373,"_27457":52029,"_2948":52098},[],"Save and read configuration again. Query `/cacerts`, perform an allowed and a rejected enrollment, and inspect device, serial and history. Creating the DMS or downloading cacerts does not establish working authentication and issuance.",{"_3465":909,"_30219":881,"_20927":52100,"_5":14373,"_27457":52037,"_2948":52101},[],"`settings.enrollment_settings.registration_mode` accepts `JITP` or `PRE_REGISTRATION`. JITP creates an unknown device with the CSR CN as ID and the DMS as owner. `device_provisioning_profile` supplies tags, metadata and icon for that registration.",{"_3465":910,"_30219":881,"_20927":52103,"_5":14373,"_27457":52037,"_2948":52104},[],"PRE\\_REGISTRATION requires an existing ID. In the inspected code, an existing device encounters replacement checks first, even without an identity. Review preregistration conditions before using this mode.",{"_3465":911,"_30219":881,"_20927":52106,"_5":14373,"_27457":52041,"_2948":52107},[],"`settings.enrollment_settings` field",{"_3465":912,"_30219":881,"_20927":52109,"_5":14373,"_27457":52041,"_2948":52110},[],"Decision",{"_3465":913,"_30219":881,"_20927":52112,"_5":14373,"_27457":52041,"_2948":52113},[],"`protocol`",{"_3465":914,"_30219":881,"_20927":52115,"_5":14373,"_27457":52041,"_2948":52116},[],"`EST_RFC7030` for these operations.",{"_3465":915,"_30219":881,"_20927":52118,"_5":14373,"_27457":52041,"_2948":52119},[],"`enrollment_ca`",{"_3465":916,"_30219":881,"_20927":52121,"_5":14373,"_27457":52041,"_2948":52122},[],"ID of the signing CA.",{"_3465":917,"_30219":881,"_20927":52124,"_5":14373,"_27457":52041,"_2948":52125},[],"`verify_csr_signature`",{"_3465":918,"_30219":881,"_20927":52127,"_5":14373,"_27457":52041,"_2948":52128},[],"Keep `true` to verify CSR key possession.",{"_3465":919,"_30219":881,"_20927":52130,"_5":14373,"_27457":52041,"_2948":52131},[],"`enable_replaceable_enrollment`",{"_3465":920,"_30219":881,"_20927":52133,"_5":14373,"_27457":52041,"_2948":52134},[],"Allows `/simpleenroll` for an existing ID in the same DMS. It can attempt previous certificate revocation even if a later phase fails; this is not atomic.",{"_3465":921,"_30219":881,"_20927":52136,"_5":14373,"_27457":52041,"_2948":52137},[],"`est_rfc7030_settings.auth_mode`",{"_3465":922,"_30219":881,"_20927":52139,"_5":14373,"_27457":52041,"_2948":52140},[],"One of the four authentication modes.",{"_3465":923,"_30219":881,"_20927":52142,"_5":14373,"_27457":52041,"_2948":52143},[],"Initial enrollment rejects an ID owned by another DMS. Do not automatically enable replacement in response to an error; Troubleshooting distinguishes repeated IDs, ownership and partial changes.",{"_3465":924,"_30219":881,"_20927":52145,"_5":14373,"_27457":52045,"_2948":52146},[],"The blocks are independent:",{"_3465":925,"_30219":881,"_20927":52148,"_5":14373,"_27457":52045,"_2948":52149},[],"`settings.enrollment_settings.est_rfc7030_settings` for `/simpleenroll` and `/serverkeygen`.",{"_3465":926,"_30219":881,"_20927":52151,"_5":14373,"_27457":52045,"_2948":52152},[],"`settings.reenrollment_settings.est_rfc7030_settings` for `/simplereenroll`.",{"_3465":927,"_30219":881,"_20927":52154,"_5":14373,"_27457":52045,"_2948":52155},[],"`auth_mode`",{"_3465":928,"_30219":881,"_20927":52157,"_5":14373,"_27457":52045,"_2948":52158},[],"Control applied in the configured operation",{"_3465":929,"_30219":881,"_20927":52160,"_5":14373,"_27457":52045,"_2948":52161},[],"`CLIENT_CERTIFICATE`",{"_3465":930,"_30219":881,"_20927":52163,"_5":14373,"_27457":52045,"_2948":52164},[],"Presented certificate validation.",{"_3465":931,"_30219":881,"_20927":52166,"_5":14373,"_27457":52045,"_2948":52167},[],"`EXTERNAL_WEBHOOK`",{"_3465":932,"_30219":881,"_20927":52169,"_5":14373,"_27457":52045,"_2948":52170},[],"Configured webhook authorization.",{"_3465":933,"_30219":881,"_20927":52172,"_5":14373,"_27457":52045,"_2948":52173},[],"`CLIENT_CERTIFICATE_AND_EXTERNAL_WEBHOOK`",{"_3465":934,"_30219":881,"_20927":52175,"_5":14373,"_27457":52045,"_2948":52176},[],"Certificate validation followed by webhook approval.",{"_3465":935,"_30219":881,"_20927":52178,"_5":14373,"_27457":52045,"_2948":52179},[],"`NO_AUTH`",{"_3465":936,"_30219":881,"_20927":52181,"_5":14373,"_27457":52045,"_2948":52182},[],"No DMS requester authentication.",{"_3465":937,"_30219":881,"_20927":52184,"_5":14373,"_27457":52045,"_2948":52185},[],"Webhook and combined modes also execute during re-enrollment when configured in its block. They do not implicitly degrade to NO\\_AUTH. An absent or unrecognized mode fails.",{"_3465":938,"_30219":881,"_20927":52187,"_5":14373,"_27457":52045,"_2948":52188},[],"For initial mTLS, `client_certificate_settings` contains `validation_cas`, `allow_expired` and `chain_level_validation`. The inspected flow receives one certificate credential; it does not guarantee forwarding every handshake intermediate to the validator. For a direct case, configure the bootstrap’s direct issuer as validation CA and test the actual Gateway path.",{"_3465":939,"_30219":881,"_20927":52190,"_5":14373,"_27457":52045,"_2948":52191},[],"For certificate re-enrollment, the validator tries the enrollment CA first and then the CAs listed in `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`; those are the re-enrollment validation CAs. That list is optional because the enrollment CA is always trusted for re-enrollment, and each settings block consults only its own `validation_cas`. CAs listed only in the initial block's `validation_cas` do not extend re-enrollment acceptance; during a CA rotation, add the old issuance CA to the re-enrollment block's list. The re-enrollment validator compares the presented TLS leaf against those CAs; the re-enrollment block's `chain_level_validation` and `allow_expired` values are stored but not consulted, and expiry is governed by `enable_expired_renewal`.",{"_3465":940,"_30219":881,"_20927":52193,"_5":14373,"_27457":52045,"_2948":52194},[],"For a webhook, configure destination, Lamassu-to-service authentication, method and timeout. The authentication contract explains the device credential and request body. `NO_AUTH` does not establish ownership of the requested ID.",{"_3465":941,"_30219":881,"_20927":52196,"_5":14373,"_27457":52049,"_2948":52197},[],"The webhook authentication modes read `external_webhook_settings` in the same `est_rfc7030_settings` block:",{"_3465":942,"_30219":881,"_20927":52199,"_5":14373,"_27457":52049,"_2948":52200},[],"`external_webhook_settings` field",{"_3465":943,"_30219":881,"_20927":52202,"_5":14373,"_27457":52049,"_2948":52110},[],{"_3465":944,"_30219":881,"_20927":52204,"_5":14373,"_27457":52049,"_2948":52205},[],"`url`",{"_3465":945,"_30219":881,"_20927":52207,"_5":14373,"_27457":52049,"_2948":52208},[],"Absolute `http` or `https` URL of the receiver. It must be the final URL; redirects are not followed.",{"_3465":946,"_30219":881,"_20927":52210,"_5":14373,"_27457":52049,"_2948":52211},[],"`method`",{"_3465":947,"_30219":881,"_20927":52213,"_5":14373,"_27457":52049,"_2948":52214},[],"`POST` or `PUT`; `POST` by default.",{"_3465":948,"_30219":881,"_20927":52216,"_5":14373,"_27457":52049,"_2948":52217},[],"`name`",{"_3465":949,"_30219":881,"_20927":52219,"_5":14373,"_27457":52049,"_2948":52220},[],"Label used in service logs.",{"_3465":950,"_30219":881,"_20927":52222,"_5":14373,"_27457":52049,"_2948":52223},[],"`config.auth_mode`",{"_3465":951,"_30219":881,"_20927":52225,"_5":14373,"_27457":52049,"_2948":52226},[],"`noauth`, `apikey`, `jwt` or `mtls`. An absent or unknown value behaves as `noauth`.",{"_3465":952,"_30219":881,"_20927":52228,"_5":14373,"_27457":52049,"_2948":52229},[],"`config.log_level`",{"_3465":953,"_30219":881,"_20927":52231,"_5":14373,"_27457":52049,"_2948":52232},[],"Log level of the webhook call: `debug`, `info`, `warn` or `error`; `info` by default.",{"_3465":954,"_30219":881,"_20927":52234,"_5":14373,"_27457":52049,"_2948":52235},[],"`config.apikey_options`",{"_3465":955,"_30219":881,"_20927":52237,"_5":14373,"_27457":52049,"_2948":52238},[],"Required for `apikey`: `header` and `key`. Reserved header names are rejected.",{"_3465":956,"_30219":881,"_20927":52240,"_5":14373,"_27457":52049,"_2948":52241},[],"`config.jwt_options`",{"_3465":957,"_30219":881,"_20927":52243,"_5":14373,"_27457":52049,"_2948":52244},[],"Required for `jwt`: `oidc_client_id`, `oidc_client_secret` and an absolute `http` or `https` `oidc_well_known`.",{"_3465":958,"_30219":881,"_20927":52246,"_5":14373,"_27457":52049,"_2948":52247},[],"`config.mtls_options`",{"_3465":959,"_30219":881,"_20927":52249,"_5":14373,"_27457":52049,"_2948":52250},[],"Required for `mtls`: `cert_content` and `key_content` as Base64-encoded PEM, like certificates elsewhere in the API; plain PEM is also accepted.",{"_3465":960,"_30219":881,"_20927":52252,"_5":14373,"_27457":52049,"_2948":52253},[],"`config.insecure_skip_verify`",{"_3465":961,"_30219":881,"_20927":52255,"_5":14373,"_27457":52049,"_2948":52256},[],"Skips verification of the receiver certificate when `true`. Verification is on by default. Unlike alert channels, this flag is honored here.",{"_3465":962,"_30219":881,"_20927":52258,"_5":14373,"_27457":52049,"_2948":52259},[],"`config.call_timeout`",{"_3465":963,"_30219":881,"_20927":52261,"_5":14373,"_27457":52049,"_2948":52262},[],"Maximum duration of the authorization call (for example `10s`); 10 seconds by default.",{"_3465":964,"_30219":881,"_20927":52264,"_5":14373,"_27457":52049,"_2948":52265},[],"Rules for that configuration:",{"_3465":965,"_30219":881,"_20927":52267,"_5":14373,"_27457":52049,"_2948":52268},[],"Creating or updating a DMS whose enrollment or reenrollment `auth_mode` uses the webhook validates the block and returns HTTP 400 — the body starts with `struct validation error:` and continues with `invalid enrollment external webhook config` or `invalid reenrollment external webhook config` — when the URL, method or options are invalid. That includes an `mtls_options.cert_content`/`key_content` pair that does not decode to a matching certificate and private key. File references (`ca_cert_file`, `mtls_options.cert_file`, `mtls_options.key_file`) are always invalid: the service does not read files, so enter the certificate and key as Base64-encoded PEM in `mtls_options.cert_content` and `key_content`, or as plain PEM.",{"_3465":966,"_30219":881,"_20927":52270,"_5":14373,"_27457":52049,"_2948":52271},[],"A custom `apikey_options.header` may not use names that the platform or the receiving service trusts — for example `X-Principal-Id`, `X-Request-Id`, `Host`, `Content-Type` or `Forwarded` — and no name may start with `X-Forwarded-`, `X-Envoy-` or `X-Lms-` (case-insensitive). The DMS API reference documents the `WebhookCall` and `WebhookCallHttpClient` schemas and that reserved API-key headers are rejected.",{"_3465":967,"_30219":881,"_20927":52273,"_5":14373,"_27457":52049,"_2948":52274},[],"The nested `http_client` key exists only in alert channel configurations; in a DMS body it is ignored. The DMS key is `external_webhook_settings.config`.",{"_3465":968,"_30219":881,"_20927":52276,"_5":14373,"_27457":52049,"_2948":52277},[],"A body with `config.auth_mode` set to `apikey`, `jwt` or `mtls` must carry its corresponding option block (`apikey_options`, `jwt_options` or `mtls_options`) — and nothing else. Bodies with those auth modes carrying only `apikey`, `oidc` or `mtls` fail validation with 400, and `validate_server_cert` is always ignored: use `insecure_skip_verify`. Only bodies without option blocks are accepted as `noauth`, and their credentials are dropped.",{"_3465":969,"_30219":881,"_20927":52279,"_5":14373,"_27457":52049,"_2948":52280},[],"The authorization response must be JSON of at most 1 MiB; a larger body fails the call.",{"_3465":970,"_30219":881,"_20927":52282,"_5":14373,"_27457":52049,"_2948":52283},[],"With credentials configured, they are sent regardless of the URL scheme: an `http://` webhook receives the API key or bearer token in cleartext, and mTLS has no effect because no TLS handshake takes place, so the client certificate is never presented. Prefer `https://` for `url`, `oidc_well_known` and the token endpoint it advertises.",{"_3465":971,"_30219":881,"_20927":52285,"_5":14373,"_27457":52049,"_2948":52286},[],"Initial authentication and renewal settings are stored independently. If a DMS only has the initial authentication block, renewal reuses it: read both blocks before editing. The console exposes independent editors for the enrollment and re-enrollment authentication, with the same Log Level, Call Timeout, HTTP Authentication and credential fields as the webhook channels, plus a **Skip TLS Verification** switch (off by default, so verification stays on; the console warns when you enable it).",{"_3465":972,"_30219":881,"_20927":52288,"_5":14373,"_27457":52049,"_2948":52289},[],"Webhook credentials must be stored as PEM content. File references (`ca_cert_file`, `mtls_options.cert_file`, `mtls_options.key_file`) are never valid in a stored webhook config: delivery rejects any webhook config that references files, whatever its auth mode, so every enroll and reenroll that calls that webhook fails until the certificate and key are entered as Base64-encoded or plain PEM in `mtls_options.cert_content` and `key_content`, or the file fields are removed if the webhook does not use mTLS. If a stored config holds file paths in `mtls_options.cert_content` or `key_content`, every full settings update (`POST /v1/dms`, `PUT /v1/dms/:id`) fails validation — settings are replaced wholesale, so the stored config must be resent — until the values are replaced by PEM content or the webhook stops being used. Meanwhile, delivery of that webhook fails on every call; a metadata-only update through `PUT` or `PATCH` on `/v1/dms/:id/metadata` still succeeds. To fix it in the console, open the DMS, replace any file-path value with PEM content — the editor rejects file paths with an inline field error — and save. Saving rewrites `external_webhook_settings.config` with the current keys, and the console reads both plain and Base64-encoded PEM from migrated configurations and stores the material Base64-encoded. If your stored config previously relied on `validate_server_cert: false`, it now carries `insecure_skip_verify: true`: receiver-certificate verification stays skipped until you set that flag to `false`. See 3.8.0 to 4.0.0 for the upgrade notes and the operator checklist.",{"_3465":973,"_30219":881,"_20927":52291,"_5":14373,"_27457":52049,"_2948":52292},[],"The re-enrollment trust set lives in `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`. The flat field `reenrollment_settings.additional_validation_cas` is not part of the API: bodies that carry it are accepted but the value is silently ignored — unknown JSON fields are dropped — and GET responses do not include it. Read the DMS before sending API edits: an update body built with that flat field silently empties `validation_cas`.",{"_3465":974,"_30219":881,"_20927":52294,"_5":14373,"_27457":52053,"_2948":52295},[],"`settings.issuance_profile_id` takes precedence over `settings.issuance_profile`; without either, the CA default profile is used. The resolved profile — including the CA default used as fallback when the DMS defines none — must define an end-entity certificate: a `Sign as CA` profile is rejected at enrollment and re-enrollment time. Rules are documented once in Profiles. DMS changes affect future requests; they do not modify signed certificates or install client trust.",{"_3465":975,"_30219":881,"_20927":52297,"_5":14373,"_27457":52057,"_2948":52298},[],"`settings.reenrollment_settings` field",{"_3465":976,"_30219":881,"_20927":52300,"_5":14373,"_27457":52057,"_2948":49644},[],{"_3465":977,"_30219":881,"_20927":52302,"_5":14373,"_27457":52057,"_2948":52303},[],"`reenrollment_delta`",{"_3465":978,"_30219":881,"_20927":52305,"_5":14373,"_27457":52057,"_2948":52306},[],"Opens the window at the active certificate’s `NotAfter` minus this delta.",{"_3465":979,"_30219":881,"_20927":52308,"_5":14373,"_27457":52057,"_2948":52309},[],"`preventive_delta`",{"_3465":980,"_30219":881,"_20927":52311,"_5":14373,"_27457":52057,"_2948":52312},[],"Preventive operational monitoring threshold.",{"_3465":981,"_30219":881,"_20927":52314,"_5":14373,"_27457":52057,"_2948":52315},[],"`critical_delta`",{"_3465":982,"_30219":881,"_20927":52317,"_5":14373,"_27457":52057,"_2948":52318},[],"Critical operational monitoring threshold.",{"_3465":983,"_30219":881,"_20927":52320,"_5":14373,"_27457":52057,"_2948":52321},[],"`enable_expired_renewal`",{"_3465":984,"_30219":881,"_20927":52323,"_5":14373,"_27457":52057,"_2948":52324},[],"Accepts an expired presented certificate in the renewal mTLS validator. Does not authorize another mode or remove Gateway constraints by itself.",{"_3465":985,"_30219":881,"_20927":52326,"_5":14373,"_27457":52057,"_2948":52327},[],"`est_rfc7030_settings.client_certificate_settings.validation_cas`",{"_3465":986,"_30219":881,"_20927":52329,"_5":14373,"_27457":52057,"_2948":52330},[],"Re-enrollment validation CAs for the renewal mTLS credential, tried after the enrollment CA; optional, because the enrollment CA is always trusted. Typically populated during CA rotation while old-CA cohorts renew.",{"_3465":987,"_30219":881,"_20927":52332,"_5":14373,"_27457":52057,"_2948":52333},[],"`revoke_on_reenrollment`",{"_3465":988,"_30219":881,"_20927":52335,"_5":14373,"_27457":52057,"_2948":52336},[],"If the previous certificate is ACTIVE, attempts Superseded revocation before binding its successor.",{"_3465":989,"_30219":881,"_20927":52338,"_5":14373,"_27457":52057,"_2948":52339},[],"Monitoring does not renew: the client must schedule the request and installation. Webhook and NO\\_AUTH modes do not use the same mTLS expired-credential validator; the webhook must explicitly authorize permitted recovery. Review Renewal and recovery for operation order and partial failures.",{"_3465":990,"_30219":881,"_20927":52341,"_5":14373,"_27457":52061,"_2948":52342},[],"`settings.server_keygen_settings.enabled` enables software key generation on the server. The console exposes it through an **Enable server-side key generation** switch and a **Key type** selection: `ECDSA` P-256, P-384 or P-521, or `RSA` with 2048, 3072 or 4096 bits; the defaults are P-256 for `ECDSA` and 4096 bit for `RSA`. Algorithm and size come from its `key` field, stored as `{type,bits}` where P-256, P-384 and P-521 map to `bits` 256, 384 and 521; `key` is omitted when disabled. The profile must permit them. The response contains an unencrypted PKCS#8 key inside TLS alongside the certificate. See format and extraction in EST reference.",{"_3465":991,"_30219":881,"_20927":52344,"_5":14373,"_27457":52065,"_2948":49638},[],{"_3465":992,"_30219":881,"_20927":52346,"_5":14373,"_27457":52065,"_2948":52347},[],"Published material",{"_3465":993,"_30219":881,"_20927":52349,"_5":14373,"_27457":52065,"_2948":52350},[],"**Include Lamassu System CA**",{"_3465":994,"_30219":881,"_20927":52352,"_5":14373,"_27457":52065,"_2948":52353},[],"Available downstream TLS certificate; it can be a leaf, not an issuing CA.",{"_3465":995,"_30219":881,"_20927":52355,"_5":14373,"_27457":52065,"_2948":52356},[],"**Include Enrollment CA**",{"_3465":996,"_30219":881,"_20927":52358,"_5":14373,"_27457":52065,"_2948":52359},[],"Selected issuing CA certificate.",{"_3465":997,"_30219":881,"_20927":52361,"_5":14373,"_27457":52065,"_2948":52362},[],"**Managed CAs**",{"_3465":998,"_30219":881,"_20927":52364,"_5":14373,"_27457":52065,"_2948":52365},[],"Explicitly selected CA certificates.",{"_3465":999,"_30219":881,"_20927":52367,"_5":14373,"_27457":52065,"_2948":52368},[],"All ancestors are not added automatically. Trust distribution distinguishes trusted roots, intermediates and initial server trust.",{"_3465":1000,"_30219":881,"_20927":52370,"_5":14373,"_27457":52069,"_2948":52371},[],"**Edit** changes name, settings and metadata. Updates go through the DMS API. `PUT /v1/dms/{id}` always targets the DMS identified by the URL path: the body carries no `id` field, and any `id` or `creation_ts` in it is silently ignored — authorization is evaluated against the same URL identifier. The body must include a non-empty `name` and a `settings` object; missing either returns HTTP 400 and leaves the stored DMS unchanged. `name` and `settings` are always full replacements, so read the DMS before sending API edits to avoid losing fields. `metadata` is optional: omitting it or sending `null` keeps the stored metadata, a supplied object replaces it entirely, and `{}` clears it (a later GET returns an empty object, not `null`). Old-style bodies that carry the full DMS object keep working while they include `name` and `settings`; unknown fields are ignored. Updates reject an empty `name` with HTTP 400: a DMS whose stored name was zeroed by an earlier update must be renamed before any client round-trips it — the AWS IoT connector’s JITP writeback included. If the object does not include the AWS IoT connector key (`lamassu.io/iot/{connector_id}`), the connector ignores the DMS's later events.",{"_3465":1001,"_30219":881,"_20927":52373,"_5":14373,"_27457":52069,"_2948":52374},[],"**Go to DMS owned devices** restricts inventory by owner. **Show/Edit Metadata** contains operational and integration data; consult the integration guide before changing it. &#x2A;*EST (RFC-7030)** helps locate URLs.",{"_3465":1002,"_30219":881,"_20927":52376,"_5":14373,"_27457":52069,"_2948":52377},[],"**Delete** removes the DMS record and configuration; it does not itself cascade revocation across every device and certificate. Migrate dependencies and retain audit references before retirement.",{"_3465":1003,"_30219":881,"_20927":52379,"_5":14373,"_27457":52073,"_2948":52380},[],"Continue with EST client or the enrollment and mTLS tutorial. EST reference covers formats; Troubleshooting covers failures.",{"_3465":1004,"_30219":1004,"_5":14725,"_2948":52382,"_30551":52383,"_20927":52384,"_27457":1004},"Integrate the EST client",[49254,50729,51743,51741,51924],[],{"_3465":1005,"_30219":1004,"_20927":52386,"_5":14373,"_27457":1004,"_2948":52387},[],"Prepare trust, send a CSR and check the identity you receive.",{"_3465":1006,"_30219":1004,"_5":30548,"_20927":52389,"_27457":52390,"_2948":49264},[],"/docs/platform/iot-fleets/enrollment/est-client#before-you-begin",{"_3465":1007,"_30219":1004,"_5":30548,"_20927":52392,"_27457":52393,"_2948":52394},[],"/docs/platform/iot-fleets/enrollment/est-client#download-and-inspect-cacerts","Download and inspect cacerts",{"_3465":1008,"_30219":1004,"_5":30548,"_20927":52396,"_27457":52397,"_2948":52398},[],"/docs/platform/iot-fleets/enrollment/est-client#prepare-the-csr","Prepare the CSR",{"_3465":1009,"_30219":1004,"_5":30548,"_20927":52400,"_27457":52401,"_2948":52402},[],"/docs/platform/iot-fleets/enrollment/est-client#request-the-identity","Request the identity",{"_3465":1010,"_30219":1004,"_5":30548,"_20927":52404,"_27457":52405,"_2948":52406},[],"/docs/platform/iot-fleets/enrollment/est-client#check-and-install-the-result","Check and install the result",{"_3465":1011,"_30219":1004,"_5":30548,"_20927":52408,"_27457":52409,"_2948":52410},[],"/docs/platform/iot-fleets/enrollment/est-client#next-steps","Next steps",{"_3465":1012,"_30219":1004,"_20927":52412,"_5":14373,"_27457":1004,"_2948":52413},[],"This guide is for those implementing the device client. The administrator must have prepared the DMS policy. For a complete first run, follow Enroll and connect your first device.",{"_3465":1013,"_30219":1004,"_20927":52415,"_5":14373,"_27457":52390,"_2948":52416},[],"You need the public HTTPS DMS URL, server trust obtained through an approved channel, the operation's authentication mode and an admitted identifier. The examples use Bash, OpenSSL 3.x and curl with `--fail-with-body`; use a private working directory and compatible versions of these tools.",{"_3465":1014,"_30219":1004,"_20927":52418,"_5":14373,"_27457":52390,"_2948":52419},[],"Prepare `est-trust.pem` to verify the EST server, `bootstrap.crt` and `bootstrap.key` for initial certificate authentication, and `device-root.pem` as the approved root of the device issuer. The two trust files can contain different roots. For another authentication mode, adapt the credentials according to Bootstrap identity.",{"_3465":1015,"_30219":1004,"_20927":52421,"_5":14373,"_27457":52390,"_2948":52422},[],"Replace the host and `REPLACE_DMS_ID` with those of your installation. The URL's APS is the DMS identifier, not its display name.",{"_3465":1016,"_30219":1004,"_20927":52424,"_5":14373,"_27457":52393,"_2948":52425},[],"The default content is Base64-encoded DER PKCS#7. It is not a direct PEM file.",{"_3465":1017,"_30219":1004,"_20927":52427,"_5":14373,"_27457":52393,"_2948":52428},[],"Check fingerprints, issuers and dates against the trust distribution policy. The response can contain a selection of CAs and Lamassu's TLS certificate. Do not turn the entire bundle into trusted roots or use it to authenticate its own initial download. HTTP 200 here does not prove that authentication or issuance works.",{"_3465":1018,"_30219":1004,"_20927":52430,"_5":14373,"_27457":52397,"_2948":52431},[],"The example generates a new EC P-256 key and uses `est-device-001`, which must be available if the DMS registers automatically. The `Common Name` becomes the device identifier. Check that the profile permits the selected key and subject.",{"_3465":1019,"_30219":1004,"_20927":52433,"_5":14373,"_27457":52397,"_2948":52434},[],"An implementation using hardware or its own store must produce the CSR through its resident key. `simpleenroll` sends the request and retains the key in the client. Honor Extensions does not authorize every requested attribute: see Profiles.",{"_3465":1020,"_30219":1004,"_20927":52436,"_5":14373,"_27457":52401,"_2948":52437},[],"With initial `CLIENT_CERTIFICATE` authentication, send the Base64-encoded DER CSR using `Content-Type: application/pkcs10`:",{"_3465":1021,"_30219":1004,"_20927":52439,"_5":14373,"_27457":52401,"_2948":52440},[],"Stop if curl fails. Retain the HTTP code, headers and body for diagnosis; an error response is not decoded as a certificate. The Bash example stops before that conversion. A timeout leaves the operation's result to be checked in Lamassu: do not automatically repeat issuance.",{"_3465":1022,"_30219":1004,"_20927":52442,"_5":14373,"_27457":52405,"_2948":52443},[],"For a root that issues directly:",{"_3465":1023,"_30219":1004,"_20927":52445,"_5":14373,"_27457":52405,"_2948":52446},[],"Also verify that the CN is correct, the certificate is a leaf, its uses permit your application and its dates satisfy the profile. `cmp` must exit with code 0. With intermediates, provide the chain through `-untrusted` as described in PKI validation.",{"_3465":1024,"_30219":1004,"_20927":52448,"_5":14373,"_27457":52405,"_2948":52449},[],"Query the device: the owning DMS, current serial number and history must match the result. Protect the key/certificate pair and install both using the device's mechanism. Association in Lamassu does not install files in the client. Check a real connection before considering the process complete.",{"_3465":1025,"_30219":1004,"_20927":52451,"_5":14373,"_27457":52409,"_2948":52452},[],"Implement renewal and recovery and trust updates. The EST reference covers endpoints, formats and ServerKeyGen; troubleshooting helps distinguish transport, admission and persistence failures.",{"_3465":1026,"_30219":1026,"_5":14725,"_2948":52454,"_30551":52455,"_20927":52456,"_27457":1026},"EST reference",[49254,50729,51743,51741,51924],[],{"_3465":1027,"_30219":1026,"_20927":52458,"_5":14373,"_27457":1026,"_2948":52459},[],"Look up Lamassu routes, formats, authentication and multipart responses.",{"_3465":1028,"_30219":1026,"_5":30548,"_20927":52461,"_27457":52462,"_2948":52463},[],"/docs/platform/iot-fleets/enrollment/est-reference#endpoint-reference","Endpoint reference",{"_3465":1029,"_30219":1026,"_5":30548,"_20927":52465,"_27457":52466,"_2948":22683},[],"/docs/platform/iot-fleets/enrollment/est-reference#cacerts",{"_3465":1030,"_30219":1026,"_5":30548,"_20927":52468,"_27457":52469,"_2948":26060},[],"/docs/platform/iot-fleets/enrollment/est-reference#simpleenroll",{"_3465":1031,"_30219":1026,"_5":30548,"_20927":52471,"_27457":52472,"_2948":26067},[],"/docs/platform/iot-fleets/enrollment/est-reference#simplereenroll",{"_3465":1032,"_30219":1026,"_5":30548,"_20927":52474,"_27457":52475,"_2948":25386},[],"/docs/platform/iot-fleets/enrollment/est-reference#serverkeygen",{"_3465":1033,"_30219":1026,"_5":30548,"_20927":52477,"_27457":52478,"_2948":52479},[],"/docs/platform/iot-fleets/enrollment/est-reference#response-format","Response format",{"_3465":1034,"_30219":1026,"_5":30548,"_20927":52481,"_27457":52482,"_2948":52483},[],"/docs/platform/iot-fleets/enrollment/est-reference#request-and-extraction","Request and extraction",{"_3465":1035,"_30219":1026,"_5":30548,"_20927":52485,"_27457":52486,"_2948":52487},[],"/docs/platform/iot-fleets/enrollment/est-reference#compatibility-notes","Compatibility notes",{"_3465":1036,"_30219":1026,"_20927":52489,"_5":14373,"_27457":1026,"_2948":52490},[],"Reference for the examined backend, based on RFC 7030. Use EST client for the procedure and DMS to configure policy.",{"_3465":1037,"_30219":1026,"_20927":52492,"_5":14373,"_27457":52462,"_2948":52493},[],"Public route in the examples: `/.well-known/est/{APS}/{operation}`. `APS` is the DMS ID. The router admits routes without that segment, but the controller requires it; do not use them as a default service. Gateway configuration determines the public host and route.",{"_3465":1038,"_30219":1026,"_20927":52495,"_5":14373,"_27457":52462,"_2948":52496},[],"Operation",{"_3465":1039,"_30219":1026,"_20927":52498,"_5":14373,"_27457":52462,"_2948":52499},[],"Method",{"_3465":1040,"_30219":1026,"_20927":52501,"_5":14373,"_27457":52462,"_2948":52502},[],"Authentication and condition",{"_3465":1041,"_30219":1026,"_20927":52504,"_5":14373,"_27457":52462,"_2948":52505},[],"`/cacerts`",{"_3465":1042,"_30219":1026,"_20927":52507,"_5":14373,"_27457":52462,"_2948":52508},[],"GET",{"_3465":1043,"_30219":1026,"_20927":52510,"_5":14373,"_27457":52462,"_2948":52511},[],"DMS reading does not require an EST credential; HTTPS and infrastructure controls still apply.",{"_3465":1044,"_30219":1026,"_20927":52513,"_5":14373,"_27457":52462,"_2948":52514},[],"`/simpleenroll`",{"_3465":1045,"_30219":1026,"_20927":52516,"_5":14373,"_27457":52462,"_2948":52517},[],"POST",{"_3465":1046,"_30219":1026,"_20927":52519,"_5":14373,"_27457":52462,"_2948":52520},[],"Initial authentication and DMS registration/replacement policy.",{"_3465":1047,"_30219":1026,"_20927":52522,"_5":14373,"_27457":52462,"_2948":52523},[],"`/simplereenroll`",{"_3465":1048,"_30219":1026,"_20927":52525,"_5":14373,"_27457":52462,"_2948":52517},[],{"_3465":1049,"_30219":1026,"_20927":52527,"_5":14373,"_27457":52462,"_2948":52528},[],"Renewal authentication, existing identity, subject, revocation and window.",{"_3465":1050,"_30219":1026,"_20927":52530,"_5":14373,"_27457":52462,"_2948":52531},[],"`/serverkeygen`",{"_3465":1051,"_30219":1026,"_20927":52533,"_5":14373,"_27457":52462,"_2948":52517},[],{"_3465":1052,"_30219":1026,"_20927":52535,"_5":14373,"_27457":52462,"_2948":52536},[],"Initial authentication and admission; server generation enabled.",{"_3465":1053,"_30219":1026,"_20927":52538,"_5":14373,"_27457":52462,"_2948":52539},[],"These routes do not implement `/csrattrs` or `/fullcmc`. There is no native JWT EST authentication mode; a webhook can interpret a request credential according to its own contract.",{"_3465":1054,"_30219":1026,"_20927":52541,"_5":14373,"_27457":52466,"_2948":52542},[],"The default response has `Content-Type: application/pkcs7-mime; smime-type=certs-only` and `Content-Transfer-Encoding: base64`. The body is Base64-encoded DER PKCS#7 with lines of up to 76 characters. It includes the certificates selected by the DMS, not necessarily every ancestor.",{"_3465":1055,"_30219":1026,"_20927":52544,"_5":14373,"_27457":52466,"_2948":52545},[],"`Accept: application/x-pem-file` requests the bundle in PEM through a Lamassu extension. Inspect and approve its contents before modifying trusted roots.",{"_3465":1056,"_30219":1026,"_20927":52547,"_5":14373,"_27457":52469,"_2948":52548},[],"Send a Base64-encoded DER PKCS#10 CSR with `Content-Type: application/pkcs10`. The examined controller compares that media type literally; avoid adding parameters such as charset. The CN identifies the device and the CSR signature must be verified through DMS policy.",{"_3465":1057,"_30219":1026,"_20927":52550,"_5":14373,"_27457":52469,"_2948":52551},[],"The default response uses the PKCS#7/Base64 format described for cacerts, but contains the issued certificate; do not assume it includes its entire chain. `Accept: application/x-pem-file` returns that certificate in PEM. The client retains the key that signed the CSR.",{"_3465":1058,"_30219":1026,"_20927":52553,"_5":14373,"_27457":52472,"_2948":52554},[],"Use the same request and certificate response formats. Authentication comes from the independent `reenrollment_settings.est_rfc7030_settings` block. With a client certificate, its CN must match the CSR CN; the subject is also checked against the current certificate.",{"_3465":1059,"_30219":1026,"_20927":52556,"_5":14373,"_27457":52472,"_2948":52557},[],"In mTLS mode, the enrollment CA always validates the re-enrollment credential; certificates from other issuers are accepted only if they are listed as validation CAs in the re-enrollment block. The expiry check through `enable_expired_renewal` belongs to that validator. A revoked current certificate and a request before the window are rejected. See Renewal for installation and recovery.",{"_3465":1060,"_30219":1026,"_20927":52559,"_5":14373,"_27457":52475,"_2948":52560},[],"The server generates a software key, rebuilds the CSR with that key and performs initial enrollment. The flag must be enabled and the algorithm permitted by the profile. This operation's key does not become a hardware key because the CA is hosted in an HSM.",{"_3465":1061,"_30219":1026,"_20927":52562,"_5":14373,"_27457":52475,"_2948":52563},[],"The code supports RSA and ECDSA, and the `bits` value of the DMS key setting means something different for each. For ECDSA it selects the curve: 224, 256, 384 or 521 map to P-224, P-256, P-384 and P-521, and an unrecognized size falls back to P-256, so explicitly select a compatible size and check the resulting key. For RSA it is used directly as the modulus size; the console offers 2048, 3072 and 4096 bits. Do not reuse an enrolled ID to test this operation without reviewing replacement.",{"_3465":1062,"_30219":1026,"_20927":52565,"_5":14373,"_27457":52478,"_2948":52566},[],"The body is **MIME multipart/mixed**, with the boundary specified in `Content-Type`. It contains two parts:",{"_3465":1063,"_30219":1026,"_20927":52568,"_5":14373,"_27457":52478,"_2948":52569},[],"Part",{"_3465":1064,"_30219":1026,"_20927":52571,"_5":14373,"_27457":52478,"_2948":52572},[],"Content after decoding its Base64",{"_3465":1065,"_30219":1026,"_20927":52574,"_5":14373,"_27457":52478,"_2948":52575},[],"`application/pkcs8`",{"_3465":1066,"_30219":1026,"_20927":52577,"_5":14373,"_27457":52478,"_2948":52578},[],"Unencrypted DER PKCS#8 private key.",{"_3465":1067,"_30219":1026,"_20927":52580,"_5":14373,"_27457":52478,"_2948":52581},[],"`application/pkcs7-mime; smime-type=certs-only`",{"_3465":1068,"_30219":1026,"_20927":52583,"_5":14373,"_27457":52478,"_2948":52584},[],"DER PKCS#7 containing the issued certificate.",{"_3465":1069,"_30219":1026,"_20927":52586,"_5":14373,"_27457":52478,"_2948":52587},[],"The controller also adds `Content-Transfer-Encoding: base64` to the outer header, although the outer body is MIME text. &#x2A;*Do not Base64-decode the entire body.** Read the actual boundary and decode each part according to its headers.",{"_3465":1070,"_30219":1026,"_20927":52589,"_5":14373,"_27457":52482,"_2948":52590},[],"In a Bash session with `set -euo pipefail` and `umask 077`, use `EST_BASE` and the trust/bootstrap files from EST client. Select an available and admitted `est-serverkeygen-001`. The `server-request.key` only signs the input CSR; the received identity uses the server-generated key.",{"_3465":1071,"_30219":1026,"_20927":52592,"_5":14373,"_27457":52482,"_2948":52593},[],"Save this Python 3 extractor. It validates both parts before writing and rejects existing output files:",{"_3465":1072,"_30219":1026,"_20927":52595,"_5":14373,"_27457":52482,"_2948":52596},[],"Convert and check the result:",{"_3465":1073,"_30219":1026,"_20927":52598,"_5":14373,"_27457":52482,"_2948":52599},[],"Inspect the CN, serial, dates and uses; check association in Lamassu before installing. Protect the DER and PEM files containing the key and remove temporary copies according to the device's storage mechanism. See openssl-pkcs8 and the Python MIME parser.",{"_3465":1074,"_30219":1026,"_20927":52601,"_5":14373,"_27457":52486,"_2948":52602},[],"Do not interpret every 500 as a transient failure. Invalid input typically produces 400; service denials and errors typically produce 500 with a JSON `err` body. Gateway errors and some controller paths can have another format. Retain headers and body before decoding and see troubleshooting.",{"_3465":1075,"_30219":1026,"_20927":52604,"_5":14373,"_27457":52486,"_2948":52605},[],"The examples use openssl-pkcs7 to extract certificates and openssl-x509 to prepare renewal. Check your version's capabilities and responses before integrating a generic EST client.",{"_3465":1076,"_30219":1076,"_5":14725,"_2948":51924,"_30551":52607,"_20927":52608,"_27457":1076},[49254,50729,51743,51741,51924],[],{"_3465":1077,"_30219":1076,"_20927":52610,"_5":14373,"_27457":1076,"_2948":52611},[],"Choose admission policy and connect DMS, initial trust and the EST client.",{"_3465":1078,"_30219":1076,"_5":30548,"_20927":52613,"_27457":52614,"_2948":52615},[],"/docs/platform/iot-fleets/enrollment/overview#the-journey","The journey",{"_3465":1079,"_30219":1076,"_5":30548,"_20927":52617,"_27457":52618,"_2948":52619},[],"/docs/platform/iot-fleets/enrollment/overview#for-the-administrator","For the administrator",{"_3465":1080,"_30219":1076,"_5":30548,"_20927":52621,"_27457":52622,"_2948":52623},[],"/docs/platform/iot-fleets/enrollment/overview#for-the-integrator","For the integrator",{"_3465":1081,"_30219":1076,"_5":30548,"_20927":52625,"_27457":52626,"_2948":52627},[],"/docs/platform/iot-fleets/enrollment/overview#contract-version","Contract version",{"_3465":1082,"_30219":1076,"_20927":52629,"_5":14373,"_27457":1076,"_2948":52630},[],"Enrollment with PKI covers the path from device admission to identity installation and renewal. The DMS acts as a registration authority: it authenticates the request, applies registration policy and asks the CA to sign. The client keeps or receives the key, installs the result and presents it to the consumer.",{"_3465":1083,"_30219":1076,"_20927":52632,"_5":14373,"_27457":52614,"_2948":52633},[],"The administrator prepares the CA, issuance profile and DMS.",{"_3465":1084,"_30219":1076,"_20927":52635,"_5":14373,"_27457":52614,"_2948":52636},[],"The integrator installs initial EST server trust and an admission credential.",{"_3465":1085,"_30219":1076,"_20927":52638,"_5":14373,"_27457":52614,"_2948":52639},[],"The client requests an identity for its `Device ID` through EST.",{"_3465":1086,"_30219":1076,"_20927":52641,"_5":14373,"_27457":52614,"_2948":52642},[],"Certificate, device binding and key/certificate installation are checked.",{"_3465":1087,"_30219":1076,"_20927":52644,"_5":14373,"_27457":52614,"_2948":52645},[],"The consumer validates and authorizes the identity; the client schedules renewal and recovery.",{"_3465":1088,"_30219":1076,"_20927":52647,"_5":14373,"_27457":52614,"_2948":52648},[],"EST uses `/.well-known/est/{DMS_ID}`. Administrative APIs and manual assignment remain separate paths. Enroll and connect a device completes an initial mTLS test.",{"_3465":1089,"_30219":1076,"_20927":52650,"_5":14373,"_27457":52618,"_2948":52651},[],"<Card title=\"Provisioning strategies\" description=\"Choose automatic registration, preregistration or manual assignment.\" href=\"/docs/platform/iot-fleets/enrollment/provisioning-strategies\" />",{"_3465":1090,"_30219":1076,"_20927":52653,"_5":14373,"_27457":52618,"_2948":52654},[],"<Card title=\"Configure the DMS\" description=\"Separate admission, authentication per operation, profiles and distribution.\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_3465":1091,"_30219":1076,"_20927":52656,"_5":14373,"_27457":52618,"_2948":52657},[],"<Card title=\"Bootstrap identity and authentication\" description=\"Decide which proof allows requesting the first identity.\" href=\"/docs/platform/iot-fleets/enrollment/bootstrap-identity\" />",{"_3465":1092,"_30219":1076,"_20927":52659,"_5":14373,"_27457":52618,"_2948":52660},[],"<Card title=\"Trust distribution\" description=\"Update roots and chains with verified overlap.\" href=\"/docs/platform/iot-fleets/enrollment/trust-distribution\" />",{"_3465":1093,"_30219":1076,"_20927":52662,"_5":14373,"_27457":52622,"_2948":52663},[],"<Card title=\"EST client\" description=\"Prepare the request, verify the response and install the identity.\" href=\"/docs/platform/iot-fleets/enrollment/est-client\" />",{"_3465":1094,"_30219":1076,"_20927":52665,"_5":14373,"_27457":52622,"_2948":52666},[],"<Card title=\"Renewal and recovery\" description=\"Generate the successor and handle expired or lost credentials.\" href=\"/docs/platform/iot-fleets/enrollment/renewal-and-recovery\" />",{"_3465":1095,"_30219":1076,"_20927":52668,"_5":14373,"_27457":52622,"_2948":52669},[],"<Card title=\"EST reference\" description=\"Look up paths, formats, authentication and ServerKeyGen.\" href=\"/docs/platform/iot-fleets/enrollment/est-reference\" />",{"_3465":1096,"_30219":1076,"_20927":52671,"_5":14373,"_27457":52622,"_2948":52672},[],"<Card title=\"Troubleshooting\" description=\"Distinguish transport, policy, issuance and installation failures.\" href=\"/docs/platform/iot-fleets/enrollment/troubleshooting\" />",{"_3465":1097,"_30219":1076,"_20927":52674,"_5":14373,"_27457":52626,"_2948":52675},[],"This block describes `main` code inspected at commit `8f42c47157f9a36bac3ed5caa3692aebebe19c4b`. The site catalog publishes `main (unstable)`; this behavior is not attributed to a stable release. Before using another version, check its contract, particularly independent re-enrollment authentication. Client checks and live-instance tests are distinguished in the revision plan.",{"_3465":1098,"_30219":1076,"_20927":52677,"_5":14373,"_27457":52626,"_2948":52678},[],"Gateway, TLS, provider and service configuration belongs to Deployment. Identity use in AWS or other destinations belongs to Integrations.",{"_3465":1099,"_30219":1099,"_5":14725,"_2948":52680,"_30551":52681,"_20927":52682,"_27457":1099},"Provisioning strategies",[49254,50729,51743,51741,51924],[],{"_3465":1100,"_30219":1099,"_20927":52684,"_5":14373,"_27457":1099,"_2948":52685},[],"Choose device registration, identity authorization and key generation.",{"_3465":1101,"_30219":1099,"_5":30548,"_20927":52687,"_27457":52688,"_2948":52689},[],"/docs/platform/iot-fleets/enrollment/provisioning-strategies#choose-registration","Choose registration",{"_3465":1102,"_30219":1099,"_5":30548,"_20927":52691,"_27457":52692,"_2948":52693},[],"/docs/platform/iot-fleets/enrollment/provisioning-strategies#preregistration-and-replacement","Preregistration and replacement",{"_3465":1103,"_30219":1099,"_5":30548,"_20927":52695,"_27457":52696,"_2948":52697},[],"/docs/platform/iot-fleets/enrollment/provisioning-strategies#choose-authentication","Choose authentication",{"_3465":1104,"_30219":1099,"_5":30548,"_20927":52699,"_27457":52700,"_2948":52701},[],"/docs/platform/iot-fleets/enrollment/provisioning-strategies#choose-custody","Choose custody",{"_3465":1105,"_30219":1099,"_5":30548,"_20927":52703,"_27457":52704,"_2948":52705},[],"/docs/platform/iot-fleets/enrollment/provisioning-strategies#check-the-decision","Check the decision",{"_3465":1106,"_30219":1099,"_20927":52707,"_5":14373,"_27457":1099,"_2948":52708},[],"This guide helps the provisioning administrator choose a path before configuring the DMS. Separate three decisions: when the device exists, how its request is authorized and who generates its key. None grants destination access by itself.",{"_3465":1107,"_30219":1099,"_20927":52710,"_5":14373,"_27457":52688,"_2948":52711},[],"Path",{"_3465":1108,"_30219":1099,"_20927":52713,"_5":14373,"_27457":52688,"_2948":52714},[],"When the device exists",{"_3465":1109,"_30219":1099,"_20927":52716,"_5":14373,"_27457":52688,"_2948":52717},[],"What to check",{"_3465":1110,"_30219":1099,"_20927":52719,"_5":14373,"_27457":52688,"_2948":52720},[],"Manual assignment",{"_3465":1111,"_30219":1099,"_20927":52722,"_5":14373,"_27457":52688,"_2948":52723},[],"An operator creates it before associating a certificate.",{"_3465":1112,"_30219":1099,"_20927":52725,"_5":14373,"_27457":52688,"_2948":52726},[],"ID, owning DMS, certificate CN and bound serial.",{"_3465":1113,"_30219":1099,"_20927":52728,"_5":14373,"_27457":52688,"_2948":52729},[],"EST with `JITP`",{"_3465":1114,"_30219":1099,"_20927":52731,"_5":14373,"_27457":52688,"_2948":52732},[],"Created for an unknown CN during `/simpleenroll`.",{"_3465":1115,"_30219":1099,"_20927":52734,"_5":14373,"_27457":52688,"_2948":52735},[],"Authorized credential, unused ID, profile, resulting registration and identity.",{"_3465":1116,"_30219":1099,"_20927":52737,"_5":14373,"_27457":52688,"_2948":52738},[],"EST with `PRE_REGISTRATION`",{"_3465":1117,"_30219":1099,"_20927":52740,"_5":14373,"_27457":52688,"_2948":52741},[],"Must exist before `/simpleenroll`.",{"_3465":1118,"_30219":1099,"_20927":52743,"_5":14373,"_27457":52688,"_2948":52744},[],"Approved record, same DMS and replacement conditions for your version.",{"_3465":1119,"_30219":1099,"_20927":52746,"_5":14373,"_27457":52688,"_2948":52747},[],"Lamassu `JITP` creates inventory and identity in Lamassu. AWS JITP provisions a destination in AWS; these are separate decisions.",{"_3465":1120,"_30219":1099,"_20927":52749,"_5":14373,"_27457":52688,"_2948":52750},[],"For an initial client test, use Enroll and connect a device. To prepare inventory without EST, follow Manual registration.",{"_3465":1121,"_30219":1099,"_20927":52752,"_5":14373,"_27457":52692,"_2948":52753},[],"In the inspected code, finding any device owned by the same DMS triggers the `enable_replaceable_enrollment` check before PRE\\_REGISTRATION. With the flag disabled, a preregistered device can receive `forbiddenNewEnrollment` even in **No Identity**. Selecting PRE\\_REGISTRATION alone therefore does not establish a working path.",{"_3465":1122,"_30219":1099,"_20927":52755,"_5":14373,"_27457":52692,"_2948":52756},[],"Enabling the flag permits repeated `/simpleenroll` for an existing ID. The backend schedules a deferred attempt to revoke the previous certificate with `Superseded`; it can also run if later issuance or binding fails. Without an identity, that attempt can fail because no serial exists. The flag does not provide a replacement transaction or guarantee restoration of previous state.",{"_3465":1123,"_30219":1099,"_20927":52758,"_5":14373,"_27457":52692,"_2948":52759},[],"Test the exact case on your version before enabling it for a population. For an operational identity with authorized renewal, use `/simplereenroll`; for recovery, follow Renewal and recovery and check persisted state before retrying.",{"_3465":1124,"_30219":1099,"_20927":52761,"_5":14373,"_27457":52696,"_2948":52762},[],"Decide initial enrollment and re-enrollment separately:",{"_3465":1125,"_30219":1099,"_20927":52764,"_5":14373,"_27457":52696,"_2948":52765},[],"**Client certificate:** useful when each device has an initial credential whose key it controls.",{"_3465":1126,"_30219":1099,"_20927":52767,"_5":14373,"_27457":52696,"_2948":52768},[],"**Webhook:** useful when another authority knows inventory, credentials or entitlement to a requested ID.",{"_3465":1127,"_30219":1099,"_20927":52770,"_5":14373,"_27457":52696,"_2948":52771},[],"**Certificate and webhook:** requires both controls in the configured operation.",{"_3465":1128,"_30219":1099,"_20927":52773,"_5":14373,"_27457":52696,"_2948":52774},[],"**NO\\_AUTH:** does not establish requester identity; appropriate only when admission is deliberately controlled outside that DMS.",{"_3465":1129,"_30219":1099,"_20927":52776,"_5":14373,"_27457":52696,"_2948":52777},[],"Authenticating an initial certificate does not itself establish entitlement to choose any CSR CN. Define that authorization in Bootstrap identity and authentication.",{"_3465":1130,"_30219":1099,"_20927":52779,"_5":14373,"_27457":52700,"_2948":49638},[],{"_3465":1131,"_30219":1099,"_20927":52781,"_5":14373,"_27457":52700,"_2948":52782},[],"Material crossing EST",{"_3465":1132,"_30219":1099,"_20927":52784,"_5":14373,"_27457":52700,"_2948":52785},[],"Device-generated key",{"_3465":1133,"_30219":1099,"_20927":52787,"_5":14373,"_27457":52700,"_2948":52788},[],"Public CSR and certificate; the key stays on the client.",{"_3465":1134,"_30219":1099,"_20927":52790,"_5":14373,"_27457":52700,"_2948":52791},[],"Existing device key",{"_3465":1135,"_30219":1099,"_20927":52793,"_5":14373,"_27457":52700,"_2948":52794},[],"CSR signed with that key and a new certificate.",{"_3465":1136,"_30219":1099,"_20927":52796,"_5":14373,"_27457":52700,"_2948":52062},[],{"_3465":1137,"_30219":1099,"_20927":52798,"_5":14373,"_27457":52700,"_2948":52799},[],"Private PKCS#8 key and certificate in a TLS-protected multipart response.",{"_3465":1138,"_30219":1099,"_20927":52801,"_5":14373,"_27457":52700,"_2948":52802},[],"ServerKeyGen does not automatically use the CA’s HSM or KMS for the device key. Review its contract and extraction and the device’s ability to install the material.",{"_3465":1139,"_30219":1099,"_20927":52804,"_5":14373,"_27457":52704,"_2948":52805},[],"Before expanding the flow, test allowed registration, incorrect credentials, an ID owned by another DMS, repeated requests and recovery after failure. Keep ID, serial, active version and error. Also test consumer acceptance and rejection; issuance does not imply destination registration or permission to operate.",{"_3465":1140,"_30219":1140,"_5":14725,"_2948":52807,"_30551":52808,"_20927":52809,"_27457":1140},"Renewal and recovery",[49254,50729,51743,51741,51924],[],{"_3465":1141,"_30219":1140,"_20927":52811,"_5":14373,"_27457":1140,"_2948":52812},[],"Renew without losing the identity and recover devices according to their actual state.",{"_3465":1142,"_30219":1140,"_5":30548,"_20927":52814,"_27457":52815,"_2948":52816},[],"/docs/platform/iot-fleets/enrollment/renewal-and-recovery#prepare-renewal","Prepare renewal",{"_3465":1143,"_30219":1140,"_5":30548,"_20927":52818,"_27457":52819,"_2948":52820},[],"/docs/platform/iot-fleets/enrollment/renewal-and-recovery#request-the-successor-certificate","Request the successor certificate",{"_3465":1144,"_30219":1140,"_5":30548,"_20927":52822,"_27457":52823,"_2948":52824},[],"/docs/platform/iot-fleets/enrollment/renewal-and-recovery#install-and-check-the-new-pair","Install and check the new pair",{"_3465":1145,"_30219":1140,"_5":30548,"_20927":52826,"_27457":52827,"_2948":52828},[],"/docs/platform/iot-fleets/enrollment/renewal-and-recovery#recover-according-to-state","Recover according to state",{"_3465":1146,"_30219":1140,"_5":30548,"_20927":52830,"_27457":52831,"_2948":52832},[],"/docs/platform/iot-fleets/enrollment/renewal-and-recovery#continuous-operation","Continuous operation",{"_3465":1147,"_30219":1140,"_20927":52834,"_5":14373,"_27457":1140,"_2948":52835},[],"Renewal retains the device identifier and requests a successor certificate. The client must complete the process: check the response, install the matching pair and demonstrate that the consumer accepts it. Lamassu alerts notify you; they do not perform those steps.",{"_3465":1148,"_30219":1140,"_20927":52837,"_5":14373,"_27457":52815,"_2948":52838},[],"Query the current certificate in Lamassu and compare it with the installed certificate. You need its subject, serial and dates, as well as the client key.",{"_3465":1149,"_30219":1140,"_20927":52840,"_5":14373,"_27457":52815,"_2948":52841},[],"Check the **re-enrollment** authentication mode: it is independent of initial authentication. With `CLIENT_CERTIFICATE`, use the current identity; do not assume the bootstrap credential is admitted.",{"_3465":1150,"_30219":1140,"_20927":52843,"_5":14373,"_27457":52815,"_2948":52844},[],"Calculate the window's start: the current certificate's `NotAfter` minus `reenrollment_delta`. Preventive and critical thresholds produce states/notifications; they do not extend that window.",{"_3465":1151,"_30219":1140,"_20927":52846,"_5":14373,"_27457":52815,"_2948":52847},[],"Review **Revoke on Re-enrollment** and recovery if installation fails. When enabled, Lamassu can revoke the previous identity before the client installs the new one.",{"_3465":1152,"_30219":1140,"_20927":52849,"_5":14373,"_27457":52819,"_2948":52850},[],"The example continues the EST tutorial, in the same Bash session with `set -euo pipefail`, `umask 077` and `EST_BASE`. Use a new key compatible with the profile. Conversion from the certificate preserves the subject and copies only SAN when present; check the subject and requested names before sending it. The backend checks the subject against the current identity: it attempts RawSubject equality and then compares CN, OU, O, L, ST and C. Rebuilding only the CN can lose required attributes.",{"_3465":1153,"_30219":1140,"_20927":52852,"_5":14373,"_27457":52819,"_2948":52853},[],"The request authenticates with `device.crt` and `device.key`; the CSR contains the new public key. Also check extensions, dates and correspondence of the serial with the current slot in Lamassu. Do not resubmit a failed request without querying that state: issuance, previous revocation and successor binding can have partial results.",{"_3465":1154,"_30219":1140,"_20927":52855,"_5":14373,"_27457":52823,"_2948":52856},[],"Keep the result as `device.next.crt` and `device.next.key` until verified. Switch the pair through a coordinated operation in the device store or configuration; avoid temporarily exposing a certificate with another version's key.",{"_3465":1155,"_30219":1140,"_20927":52858,"_5":14373,"_27457":52823,"_2948":52859},[],"Test mTLS with the consumer and verify that it uses the new serial. Confirm the history and current certificate in Lamassu. If **Revoke on Re-enrollment** was disabled, the previous identity can remain valid: retire it according to PKI policy after testing the successor, and check revocation publication and consumption.",{"_3465":1156,"_30219":1140,"_20927":52861,"_5":14373,"_27457":52823,"_2948":52862},[],"If the previous identity is already revoked, retaining its files does not restore a valid connection. Recovery requires an admitted credential and authorized intervention according to the situation.",{"_3465":1157,"_30219":1140,"_20927":52864,"_5":14373,"_27457":52827,"_2948":52865},[],"Situation",{"_3465":1158,"_30219":1140,"_20927":52867,"_5":14373,"_27457":52827,"_2948":52868},[],"Procedure",{"_3465":1159,"_30219":1140,"_20927":52870,"_5":14373,"_27457":52827,"_2948":52871},[],"Valid certificate, outside the window",{"_3465":1160,"_30219":1140,"_20927":52873,"_5":14373,"_27457":52827,"_2948":52874},[],"Schedule the request within the window. Do not use `simpleenroll` to bypass it.",{"_3465":1161,"_30219":1140,"_20927":52876,"_5":14373,"_27457":52827,"_2948":52877},[],"Expired certificate, key available",{"_3465":1162,"_30219":1140,"_20927":52879,"_5":14373,"_27457":52827,"_2948":52880},[],"With certificate authentication, review `enable_expired_renewal` and whether Gateway permits presenting that credential. Revocation, subject and the remaining checks still apply.",{"_3465":1163,"_30219":1140,"_20927":52882,"_5":14373,"_27457":52827,"_2948":52883},[],"Renewal through webhook or `NO_AUTH`",{"_3465":1164,"_30219":1140,"_20927":52885,"_5":14373,"_27457":52827,"_2948":52886},[],"The mTLS expiry check does not run in these modes. Define expiry and authorization policy in the corresponding admission process; the flag is not a universal prohibition.",{"_3465":1165,"_30219":1140,"_20927":52888,"_5":14373,"_27457":52827,"_2948":52889},[],"Lost or inaccessible key",{"_3465":1166,"_30219":1140,"_20927":52891,"_5":14373,"_27457":52827,"_2948":52892},[],"You cannot prove possession of the previous identity. Authorize new admission and, if appropriate, controlled replacement; revoke the compromised identity.",{"_3465":1167,"_30219":1140,"_20927":52894,"_5":14373,"_27457":52827,"_2948":52895},[],"Current identity revoked",{"_3465":1168,"_30219":1140,"_20927":52897,"_5":14373,"_27457":52827,"_2948":52898},[],"`simplereenroll` rejects the revoked current certificate. Investigate the reason and prepare an authorized readmission procedure; do not disable authentication to force it.",{"_3465":1169,"_30219":1140,"_20927":52900,"_5":14373,"_27457":52827,"_2948":52901},[],"Device without an identity",{"_3465":1170,"_30219":1140,"_20927":52903,"_5":14373,"_27457":52827,"_2948":52904},[],"Use initial enrollment. For an existing entry, check the replacement restriction in provisioning.",{"_3465":1171,"_30219":1140,"_20927":52906,"_5":14373,"_27457":52827,"_2948":52907},[],"Retired device",{"_3465":1172,"_30219":1140,"_20927":52909,"_5":14373,"_27457":52827,"_2948":52910},[],"Review the operational decision before readmission. Decommissioned state and revocation of the entire history are not equivalent.",{"_3465":1173,"_30219":1140,"_20927":52912,"_5":14373,"_27457":52827,"_2948":52913},[],"Timeout, HTTP 500 or installation failure",{"_3465":1174,"_30219":1140,"_20927":52915,"_5":14373,"_27457":52827,"_2948":52916},[],"Inspect the device, issued certificates and history before retrying. A successor may have been issued or the previous identity revoked.",{"_3465":1175,"_30219":1140,"_20927":52918,"_5":14373,"_27457":52831,"_2948":52919},[],"Schedule renewal with time for disconnections, trust distribution and consumer checks. Stagger requests across the population and bound retries within the window; authentication, subject and policy errors require correcting their cause. Maintain an admitted and tested recovery mechanism for lost keys and pairs that could not be installed.",{"_3465":1176,"_30219":1140,"_20927":52921,"_5":14373,"_27457":52831,"_2948":52922},[],"Continue with Trust distribution, Devices and identities and Troubleshooting.",{"_3465":1177,"_30219":1177,"_5":14725,"_2948":52924,"_30551":52925,"_20927":52926,"_27457":1177},"Enrollment troubleshooting",[49254,50729,51743,51741,51924],[],{"_3465":1178,"_30219":1177,"_20927":52928,"_5":14373,"_27457":1177,"_2948":52929},[],"Locate transport, authentication, registration, issuance and installation failures.",{"_3465":1179,"_30219":1177,"_5":30548,"_20927":52931,"_27457":52932,"_2948":52933},[],"/docs/platform/iot-fleets/enrollment/troubleshooting#diagnostics-and-compatibility","Diagnostics and compatibility",{"_3465":1180,"_30219":1177,"_5":30548,"_20927":52935,"_27457":52936,"_2948":52937},[],"/docs/platform/iot-fleets/enrollment/troubleshooting#error-codes-and-diagnostics","Error codes and diagnostics",{"_3465":1181,"_30219":1177,"_5":30548,"_20927":52939,"_27457":52940,"_2948":52487},[],"/docs/platform/iot-fleets/enrollment/troubleshooting#compatibility-notes",{"_3465":1182,"_30219":1177,"_5":30548,"_20927":52942,"_27457":52943,"_2948":52944},[],"/docs/platform/iot-fleets/enrollment/troubleshooting#est-enrollment-fails","EST enrollment fails",{"_3465":1183,"_30219":1177,"_20927":52946,"_5":14373,"_27457":1177,"_2948":52947},[],"Diagnose one operation and device at a time. Record the DMS/APS, endpoint, time, HTTP code, presented serial and CSR CN. Retain the response without including private keys or webhook credentials in the report.",{"_3465":1184,"_30219":1177,"_20927":52949,"_5":14373,"_27457":52936,"_2948":52950},[],"The EST controller normally returns 400 when rejecting input and 500 when the service rejects or fails the operation. A 500 can also represent a policy denial; it does not mean retrying is safe. Gateway can produce its own codes and bodies. Examine the actual body and persisted result.",{"_3465":1185,"_30219":1177,"_20927":52952,"_5":14373,"_27457":52936,"_2948":52953},[],"Symptom or message",{"_3465":1186,"_30219":1177,"_20927":52955,"_5":14373,"_27457":52936,"_2948":52717},[],{"_3465":1187,"_30219":1177,"_20927":52957,"_5":14373,"_27457":52936,"_2948":52958},[],"curl rejects TLS, name or issuer",{"_3465":1188,"_30219":1177,"_20927":52960,"_5":14373,"_27457":52936,"_2948":52961},[],"URL, clock, server SAN and approved root in `est-trust.pem`. Resolve trust in Deployment; do not skip verification.",{"_3465":1189,"_30219":1177,"_20927":52963,"_5":14373,"_27457":52936,"_2948":52964},[],"404 or missing APS",{"_3465":1190,"_30219":1177,"_20927":52966,"_5":14373,"_27457":52936,"_2948":52967},[],"Public route `/.well-known/est/{DMS_ID}/{operation}` and existing DMS. APS is not the service name.",{"_3465":1191,"_30219":1177,"_20927":52969,"_5":14373,"_27457":52936,"_2948":52970},[],"400, CSR or format error",{"_3465":1192,"_30219":1177,"_20927":52972,"_5":14373,"_27457":52936,"_2948":52973},[],"`Content-Type: application/pkcs10`, Base64 of DER, valid signature and a body preserved without double encoding.",{"_3465":1193,"_30219":1177,"_20927":52975,"_5":14373,"_27457":52936,"_2948":52976},[],"Missing credential or invalid certificate",{"_3465":1194,"_30219":1177,"_20927":52978,"_5":14373,"_27457":52936,"_2948":52979},[],"Operation mode, validating CA, dates, revocation and credential delivery by Gateway. Do not confuse server TLS trust with the bootstrap CA.",{"_3465":1195,"_30219":1177,"_20927":52981,"_5":14373,"_27457":52936,"_2948":52982},[],"Webhook denies, times out or responds without authorization",{"_3465":1196,"_30219":1177,"_20927":52984,"_5":14373,"_27457":52936,"_2948":52985},[],"Configuration, connectivity and JSON response with `authorized: true`. There is no automatic fallback to `NO_AUTH`.",{"_3465":1197,"_30219":1177,"_20927":52987,"_5":14373,"_27457":52936,"_2948":52988},[],"`unexpected status code: <n>: redirects are not followed`",{"_3465":1198,"_30219":1177,"_20927":52990,"_5":14373,"_27457":52936,"_2948":52991},[],"The webhook answered with a redirect. Configure the final absolute `http` or `https` URL in the webhook config; redirects are never followed.",{"_3465":1199,"_30219":1177,"_20927":52993,"_5":14373,"_27457":52936,"_2948":52994},[],"`webhook response exceeds 1048576 bytes`",{"_3465":1200,"_30219":1177,"_20927":52996,"_5":14373,"_27457":52936,"_2948":52997},[],"The receiver returned more than 1 MiB of JSON. Reduce the response of the authorization webhook.",{"_3465":1201,"_30219":1177,"_20927":52999,"_5":14373,"_27457":52936,"_2948":53000},[],"`webhook config must not reference files`",{"_3465":1202,"_30219":1177,"_20927":53002,"_5":14373,"_27457":52936,"_2948":53003},[],"The webhook config points to files (`ca_cert_file`, `mtls_options.cert_file`, `mtls_options.key_file`). For mTLS, enter the certificate and key as Base64-encoded PEM in `cert_content` and `key_content`, or as plain PEM; remove any other file field, including `ca_cert_file`, which has no inline equivalent (the receiver certificate must chain to the system trust store). See the webhook credentials guidance in DMS.",{"_3465":1203,"_30219":1177,"_20927":53005,"_5":14373,"_27457":52936,"_2948":53006},[],"`mtls_options.cert_content must be base64-encoded PEM`",{"_3465":1204,"_30219":1177,"_20927":53008,"_5":14373,"_27457":52936,"_2948":53009},[],"The value is neither Base64-encoded PEM nor plain PEM: it is a file path or Base64 of non-PEM data. Enter the certificate and key as Base64-encoded PEM, like certificates elsewhere in the API, or as plain PEM (see the webhook settings in DMS). The same message names `mtls_options.key_content` when the key is the offending value.",{"_3465":1205,"_30219":1177,"_20927":53011,"_5":14373,"_27457":52936,"_2948":53012},[],"`webhook mTLS certificate and key are invalid: …`",{"_3465":1206,"_30219":1177,"_20927":53014,"_5":14373,"_27457":52936,"_2948":53015},[],"The certificate and key do not form a matching pair. Enter both values from the same pair; the check runs when the DMS is saved and again on every webhook call.",{"_3465":1207,"_30219":1177,"_20927":53017,"_5":14373,"_27457":52936,"_2948":53018},[],"400 `struct validation error` creating or updating a DMS",{"_3465":1208,"_30219":1177,"_20927":53020,"_5":14373,"_27457":52936,"_2948":53021},[],"The webhook config of the operation that uses it is invalid. Review `external_webhook_settings` in DMS.",{"_3465":1209,"_30219":1177,"_20927":53023,"_5":14373,"_27457":52936,"_2948":53024},[],"HTTP 500 with an `err` body on enroll or reenroll",{"_3465":1210,"_30219":1177,"_20927":53026,"_5":14373,"_27457":52936,"_2948":53027},[],"Service failures reach the EST client as 500 with a body of `err` plus the message; webhook authorization errors are named there.",{"_3465":1211,"_30219":1177,"_20927":53029,"_5":14373,"_27457":52936,"_2948":53030},[],"`device not preregistered`",{"_3465":1212,"_30219":1177,"_20927":53032,"_5":14373,"_27457":52936,"_2948":53033},[],"PRE\\_REGISTRATION requires an existing inventory entry.",{"_3465":1213,"_30219":1177,"_20927":53035,"_5":14373,"_27457":52936,"_2948":53036},[],"`forbiddenNewEnrollment`",{"_3465":1214,"_30219":1177,"_20927":53038,"_5":14373,"_27457":52936,"_2948":53039},[],"An existing device requires replacement to be enabled, even in No Identity. Investigate before enabling the flag.",{"_3465":1215,"_30219":1177,"_20927":53041,"_5":14373,"_27457":52936,"_2948":53042},[],"Different owning DMS",{"_3465":1216,"_30219":1177,"_20927":53044,"_5":14373,"_27457":52936,"_2948":53045},[],"CN/ID, global inventory and owning DMS; do not reuse an ID from another context.",{"_3465":1217,"_30219":1177,"_20927":53047,"_5":14373,"_27457":52936,"_2948":53048},[],"`invalid RawSubject bytes`",{"_3465":1218,"_30219":1177,"_20927":53050,"_5":14373,"_27457":52936,"_2948":53051},[],"CSR subject versus the current certificate. Preserve its attributes as well as its CN.",{"_3465":1219,"_30219":1177,"_20927":53053,"_5":14373,"_27457":52936,"_2948":53054},[],"`invalid reenroll window`",{"_3465":1220,"_30219":1177,"_20927":53056,"_5":14373,"_27457":52936,"_2948":53057},[],"Current identity's NotAfter and reenrollment\\_delta. Alert thresholds do not change that window.",{"_3465":1221,"_30219":1177,"_20927":53059,"_5":14373,"_27457":52936,"_2948":53060},[],"Current certificate revoked",{"_3465":1222,"_30219":1177,"_20927":53062,"_5":14373,"_27457":52936,"_2948":53063},[],"Renewal rejected; prepare authorized recovery according to the cause.",{"_3465":1223,"_30219":1177,"_20927":53065,"_5":14373,"_27457":52936,"_2948":53066},[],"CA, profile or signing error",{"_3465":1224,"_30219":1177,"_20927":53068,"_5":14373,"_27457":52936,"_2948":53069},[],"Active CA, available key, selected profile and restrictions. Successful cacerts does not prove issuance.",{"_3465":1225,"_30219":1177,"_20927":53071,"_5":14373,"_27457":52936,"_2948":53072},[],"HTTP 200 without a device connection",{"_3465":1226,"_30219":1177,"_20927":53074,"_5":14373,"_27457":52936,"_2948":53075},[],"Installed pair, chain, uses, consumer trust and permissions. Also check the slot and history.",{"_3465":1227,"_30219":1177,"_20927":53077,"_5":14373,"_27457":52936,"_2948":53078},[],"Timeout or error after issuance",{"_3465":1228,"_30219":1177,"_20927":53080,"_5":14373,"_27457":52936,"_2948":53081},[],"New certificates, current slot and previous identity's state before retrying.",{"_3465":1229,"_30219":1177,"_20927":53083,"_5":14373,"_27457":52940,"_2948":53084},[],"The examples use the contract of the examined backend. Do not automatically attribute that behavior to another release. Check the saved renewal mode and Gateway behavior with expired certificates and the bootstrap CA.",{"_3465":1230,"_30219":1177,"_20927":53086,"_5":14373,"_27457":52940,"_2948":53087},[],"The default response is Base64-encoded DER PKCS#7; PEM through `Accept: application/x-pem-file` is a Lamassu extension. ServerKeyGen returns multipart and requires handling each part separately. See the EST reference.",{"_3465":1231,"_30219":1177,"_20927":53089,"_5":14373,"_27457":52943,"_2948":53090},[],"Check HTTPS with the approved root and query cacerts for the correct APS.",{"_3465":1232,"_30219":1177,"_20927":53092,"_5":14373,"_27457":52943,"_2948":53093},[],"Review the saved DMS: protocol, registration, authentication for that operation, CA, profile and window.",{"_3465":1233,"_30219":1177,"_20927":53095,"_5":14373,"_27457":52943,"_2948":53096},[],"Verify the CSR locally and relate its CN to the inventory.",{"_3465":1234,"_30219":1177,"_20927":53098,"_5":14373,"_27457":52943,"_2948":53099},[],"Make one request, save headers/body and query the device and certificates.",{"_3465":1235,"_30219":1177,"_20927":53101,"_5":14373,"_27457":52943,"_2948":53102},[],"If you receive an identity, check the key, subject, use and connection with the consumer.",{"_3465":1236,"_30219":1177,"_20927":53104,"_5":14373,"_27457":52943,"_2948":53105},[],"External bootstrap revocation checks have limitations: absence of evidence can be accepted, and OCSP Unknown does not cause the same rejection as Revoked. Do not assume a policy that rejects every uncertainty. An intermediate CA in the TLS chain does not prove that the entire chain reached the DMS validator either.",{"_3465":1237,"_30219":1177,"_20927":53107,"_5":14373,"_27457":52943,"_2948":53108},[],"For logs, networking, pods or Gateway headers, continue in Deployment troubleshooting. For identities issued, revoked or bound partially, use Renewal and recovery and Devices and identities.",{"_3465":1238,"_30219":1238,"_5":14725,"_2948":53110,"_30551":53111,"_20927":53112,"_27457":1238},"Trust distribution and updates",[49254,50729,51743,51741,51924],[],{"_3465":1239,"_30219":1238,"_20927":53114,"_5":14373,"_27457":1238,"_2948":53115},[],"Separate roots, intermediates and initial TLS trust when distributing or migrating certificates.",{"_3465":1240,"_30219":1238,"_5":30548,"_20927":53117,"_27457":53118,"_2948":53119},[],"/docs/platform/iot-fleets/enrollment/trust-distribution#three-trust-relationships","Three trust relationships",{"_3465":1241,"_30219":1238,"_5":30548,"_20927":53121,"_27457":53122,"_2948":53123},[],"/docs/platform/iot-fleets/enrollment/trust-distribution#what-cacerts-returns","What cacerts returns",{"_3465":1242,"_30219":1238,"_5":30548,"_20927":53125,"_27457":53126,"_2948":53127},[],"/docs/platform/iot-fleets/enrollment/trust-distribution#install-the-required-material","Install the required material",{"_3465":1243,"_30219":1238,"_5":30548,"_20927":53129,"_27457":53130,"_2948":53131},[],"/docs/platform/iot-fleets/enrollment/trust-distribution#migrate-trust","Migrate trust",{"_3465":1244,"_30219":1238,"_5":30548,"_20927":53133,"_27457":53134,"_2948":53135},[],"/docs/platform/iot-fleets/enrollment/trust-distribution#check-the-update","Check the update",{"_3465":1245,"_30219":1238,"_20927":53137,"_5":14373,"_27457":1238,"_2948":53138},[],"This guide is for device and consumer trust administrators. You need issuer inventory, trust-store access and an authenticated update channel. Distributing certificates is separate from choosing trusted anchors.",{"_3465":1246,"_30219":1238,"_20927":53140,"_5":14373,"_27457":53118,"_2948":53141},[],"Relationship",{"_3465":1247,"_30219":1238,"_20927":53143,"_5":14373,"_27457":53118,"_2948":53144},[],"Material prepared by its owner",{"_3465":1248,"_30219":1238,"_20927":53146,"_5":14373,"_27457":53118,"_2948":53147},[],"Device → EST server",{"_3465":1249,"_30219":1238,"_20927":53149,"_5":14373,"_27457":53118,"_2948":53150},[],"Previously verified server root, chain or pin and TLS name.",{"_3465":1250,"_30219":1238,"_20927":53152,"_5":14373,"_27457":53118,"_2948":53153},[],"DMS → requester",{"_3465":1251,"_30219":1238,"_20927":53155,"_5":14373,"_27457":53118,"_2948":53156},[],"CAs and rules authorizing initial or renewal credentials.",{"_3465":1252,"_30219":1238,"_20927":53158,"_5":14373,"_27457":53118,"_2948":53159},[],"Consumer → device",{"_3465":1253,"_30219":1238,"_20927":53161,"_5":14373,"_27457":53118,"_2948":53162},[],"Operational identity roots, intermediates, validation and permissions.",{"_3465":1254,"_30219":1238,"_20927":53164,"_5":14373,"_27457":53118,"_2948":53165},[],"Obtaining a certificate does not automatically configure these relationships in third parties. Review the Trust model.",{"_3465":1255,"_30219":1238,"_20927":53167,"_5":14373,"_27457":53122,"_2948":53168},[],"The DMS may include the available downstream TLS certificate, selected Managed CAs and enrollment CA. Selecting the issuer does not include every ancestor. The set may contain leaves, roots and intermediates, including multiple hierarchies during migration.",{"_3465":1256,"_30219":1238,"_20927":53170,"_5":14373,"_27457":53122,"_2948":53171},[],"Position does not define the chain. Identify certificates by subject, issuer, AKI/SKI, signature and constraints. Download and inspect using EST client.",{"_3465":1257,"_30219":1238,"_20927":53173,"_5":14373,"_27457":53126,"_2948":53174},[],"Keep initial EST server trust separate from identity consumer trust.",{"_3465":1258,"_30219":1238,"_20927":53176,"_5":14373,"_27457":53126,"_2948":53177},[],"Select policy-approved roots as anchors.",{"_3465":1259,"_30219":1238,"_20927":53179,"_5":14373,"_27457":53126,"_2948":53180},[],"Retain intermediates for chain building or presentation; do not automatically turn them into roots.",{"_3465":1260,"_30219":1238,"_20927":53182,"_5":14373,"_27457":53126,"_2948":53183},[],"Present the leaf and required intermediates in mTLS. Normally the peer already trusts its root and does not need it sent.",{"_3465":1261,"_30219":1238,"_20927":53185,"_5":14373,"_27457":53126,"_2948":53186},[],"Verify chain, dates, names, usages and revocation from the consumer.",{"_3465":1262,"_30219":1238,"_20927":53188,"_5":14373,"_27457":53126,"_2948":53189},[],"Do not indiscriminately use all of `cacerts.pem` as `-CAfile`: this can expand trusted authorities, hide missing intermediates or trust a TLS leaf intended for another purpose.",{"_3465":1263,"_30219":1238,"_20927":53191,"_5":14373,"_27457":53130,"_2948":53192},[],"Before changing Enrollment CA, inventory disconnected equipment, bootstrap and operational certificates, and consumers. Distribute the new root and required intermediates; check that a cohort accepts both old and new chains.",{"_3465":1264,"_30219":1238,"_20927":53194,"_5":14373,"_27457":53130,"_2948":53195},[],"In the DMS, separate distributed CAs from the re-enrollment validation CAs at `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`, used for re-enrollment credentials. That list is optional because the enrollment CA always validates re-enrollment credentials, but when switching the enrollment CA, add the previous issuance CA to it so old-CA identities keep re-enrolling during overlap. The inspected validator tries the enrollment CA followed by those CAs against the received leaf; accepting a multilevel chain requires checking what reaches the service and which issuer is configured.",{"_3465":1265,"_30219":1238,"_20927":53197,"_5":14373,"_27457":53130,"_2948":53198},[],"Switch issuance, renew in cohorts and compare the installed serial with the active slot. Remove previous trust once no legitimate equipment needs it and policy permits ending overlap. Follow Hierarchy and rotation for the PKI operation.",{"_3465":1266,"_30219":1238,"_20927":53200,"_5":14373,"_27457":53134,"_2948":53201},[],"Test an old identity allowed during overlap, a new one, an unknown chain and the result after removing old trust. Keep trust-store version, approved set, date and result. Reachable `/cacerts` establishes distribution only; it does not establish installation or acceptance across every device.",{"_3465":1267,"_30219":1267,"_5":14725,"_2948":53203,"_30551":53204,"_20927":53206,"_27457":1267},"AWS IoT Core",[49254,50729,51743,51741,53205],"Integrations",[],{"_3465":1268,"_30219":1267,"_20927":53208,"_5":14373,"_27457":1267,"_2948":53209},[],"Lamassu's connector for AWS IoT Core syncs device identities with the AWS platform, handling CA registration, Thing provisioning and certificate lifecycle automatically and event-driven.",{"_3465":1269,"_30219":1267,"_5":30548,"_20927":53211,"_27457":53212,"_2948":53213},[],"/docs/platform/iot-fleets/integrations/aws-iot-core#connector-architecture","Connector architecture",{"_3465":1270,"_30219":1267,"_5":30548,"_20927":53215,"_27457":53216,"_2948":53217},[],"/docs/platform/iot-fleets/integrations/aws-iot-core#prerequisites","Prerequisites",{"_3465":1271,"_30219":1267,"_5":30548,"_20927":53219,"_27457":53220,"_2948":53221},[],"/docs/platform/iot-fleets/integrations/aws-iot-core#required-iam-permissions","Required IAM permissions",{"_3465":1272,"_30219":1267,"_5":30548,"_20927":53223,"_27457":53224,"_2948":53225},[],"/docs/platform/iot-fleets/integrations/aws-iot-core#configuration-parameters","Configuration parameters",{"_3465":1273,"_30219":1267,"_5":30548,"_20927":53227,"_27457":53228,"_2948":53229},[],"/docs/platform/iot-fleets/integrations/aws-iot-core#events-and-aws-resources","Events and AWS resources",{"_3465":1274,"_30219":1267,"_5":30548,"_20927":53231,"_27457":53232,"_2948":53233},[],"/docs/platform/iot-fleets/integrations/aws-iot-core#ca-registration-in-aws-iot-core","CA registration in AWS IoT Core",{"_3465":1275,"_30219":1267,"_5":30548,"_20927":53235,"_27457":53236,"_2948":53237},[],"/docs/platform/iot-fleets/integrations/aws-iot-core#how-to-request-registration","How to request registration",{"_3465":1276,"_30219":1267,"_5":30548,"_20927":53239,"_27457":53240,"_2948":53241},[],"/docs/platform/iot-fleets/integrations/aws-iot-core#ca-registration-states","CA registration states",{"_3465":1277,"_30219":1267,"_5":30548,"_20927":53243,"_27457":53244,"_2948":53245},[],"/docs/platform/iot-fleets/integrations/aws-iot-core#primary-account","Primary Account",{"_3465":1278,"_30219":1267,"_5":30548,"_20927":53247,"_27457":53248,"_2948":53249},[],"/docs/platform/iot-fleets/integrations/aws-iot-core#secondary-account-sni-only","Secondary Account (SNI-only)",{"_3465":1279,"_30219":1267,"_5":30548,"_20927":53251,"_27457":53252,"_2948":53253},[],"/docs/platform/iot-fleets/integrations/aws-iot-core#dms-configuration","DMS configuration",{"_3465":1280,"_30219":1267,"_5":30548,"_20927":53255,"_27457":53256,"_2948":53257},[],"/docs/platform/iot-fleets/integrations/aws-iot-core#none-mode","`none` mode",{"_3465":1281,"_30219":1267,"_5":30548,"_20927":53259,"_27457":53260,"_2948":53261},[],"/docs/platform/iot-fleets/integrations/aws-iot-core#auto-mode","`auto` mode",{"_3465":1282,"_30219":1267,"_5":30548,"_20927":53263,"_27457":53264,"_2948":53265},[],"/docs/platform/iot-fleets/integrations/aws-iot-core#jitp-mode","`jitp` mode",{"_3465":1283,"_30219":1267,"_5":30548,"_20927":53267,"_27457":53268,"_2948":53269},[],"/docs/platform/iot-fleets/integrations/aws-iot-core#dms-registration-mode-states","DMS registration-mode states",{"_3465":1284,"_30219":1267,"_5":30548,"_20927":53271,"_27457":53272,"_2948":53273},[],"/docs/platform/iot-fleets/integrations/aws-iot-core#device-provisioning-automatic-mode","Device provisioning (automatic mode)",{"_3465":1285,"_30219":1267,"_5":30548,"_20927":53275,"_27457":53276,"_2948":53277},[],"/docs/platform/iot-fleets/integrations/aws-iot-core#thing-lifecycle","Thing lifecycle",{"_3465":1286,"_30219":1267,"_5":30548,"_20927":53279,"_27457":53280,"_2948":53281},[],"/docs/platform/iot-fleets/integrations/aws-iot-core#device-provisioning-jitp-mode","Device provisioning (JITP mode)",{"_3465":1287,"_30219":1267,"_5":30548,"_20927":53283,"_27457":53284,"_2948":53285},[],"/docs/platform/iot-fleets/integrations/aws-iot-core#certificate-status-synchronization","Certificate status synchronization",{"_3465":1288,"_30219":1267,"_5":30548,"_20927":53287,"_27457":53288,"_2948":53289},[],"/docs/platform/iot-fleets/integrations/aws-iot-core#certificate-status-states","Certificate status states",{"_3465":1289,"_30219":1267,"_5":30548,"_20927":53291,"_27457":53292,"_2948":53293},[],"/docs/platform/iot-fleets/integrations/aws-iot-core#forced-disconnect-on-revocation","Forced disconnect on revocation",{"_3465":1290,"_30219":1267,"_5":30548,"_20927":53295,"_27457":53296,"_2948":53297},[],"/docs/platform/iot-fleets/integrations/aws-iot-core#device-shadow-and-automation","Device Shadow and automation",{"_3465":1291,"_30219":1267,"_5":30548,"_20927":53299,"_27457":53300,"_2948":53301},[],"/docs/platform/iot-fleets/integrations/aws-iot-core#what-the-connector-writes-to-the-shadow","What the connector writes to the shadow",{"_3465":1292,"_30219":1267,"_5":30548,"_20927":53303,"_27457":53304,"_2948":53305},[],"/docs/platform/iot-fleets/integrations/aws-iot-core#aws-iot-policies","AWS IoT policies",{"_3465":1293,"_30219":1267,"_5":30548,"_20927":53307,"_27457":53308,"_2948":53309},[],"/docs/platform/iot-fleets/integrations/aws-iot-core#troubleshooting","Troubleshooting",{"_3465":1294,"_30219":1267,"_20927":53311,"_5":14373,"_27457":1267,"_2948":53312},[],"Lamassu's integration with AWS IoT Core bridges the PKI managed by Lamassu and AWS's connectivity platform. When a device obtains its certificate through the EST enrollment process, the connector ensures that certificate and its associated identity are recognized in AWS IoT Core without manual intervention. The result is that the device can authenticate directly to AWS with the same X.509 certificate Lamassu issued.",{"_3465":1295,"_30219":1267,"_20927":53314,"_5":14373,"_27457":1267,"_2948":53315},[],"From a protocol standpoint, the device authenticates to AWS IoT Core via mutual TLS (mTLS): it presents its Lamassu-issued X.509 certificate as the client certificate, and AWS IoT Core verifies the certificate chain up to the CA registered in the account. Lamassu acts as the certification authority (CA); the connector ensures that CA is registered in AWS and that the device's certificate is known to the platform before the device attempts to connect (in `auto` mode) or on its first connection (in JITP mode).",{"_3465":1296,"_30219":1267,"_20927":53317,"_5":14373,"_27457":1267,"_2948":53318},[],"This document is aimed both at the PKI administrator, who needs to configure the connector and register CAs, and at the device firmware developer, who needs to understand how Things are named, how the Device Shadow works and what happens when a certificate is revoked. For the firmware developer, the most important fact is that **the AWS Thing name (ThingName) always corresponds to the Common Name (CN) of the certificate issued by Lamassu**, regardless of the provisioning mode.",{"_3465":1297,"_30219":1267,"_20927":53320,"_5":14373,"_27457":53212,"_2948":53321},[],"The AWS IoT Core connector is an independent Go process, a binary or container separate from Lamassu's core. In a monolithic deployment it is compiled by default (build tag `!noaws`) and activated with `aws_iot_manager.enabled: true` in the configuration file. In distributed deployments, it runs as its own container with access to Lamassu's CA, DMS Manager and Device Manager services over HTTP.",{"_3465":1298,"_30219":1267,"_20927":53323,"_5":14373,"_27457":53212,"_2948":53324},[],"The connector does not poll Lamassu's services periodically. Instead, it **subscribes to Lamassu's internal event bus** (AMQP or AWS SQS/SNS, configurable) and reacts to the events it cares about: CA creation or update, DMS creation or update, device identity binding, certificate status change, certificate metadata update and device metadata update. This event-driven model ensures synchronization with AWS is nearly immediate and produces no polling load.",{"_3465":1299,"_30219":1267,"_20927":53326,"_5":14373,"_27457":53212,"_2948":53327},[],"To avoid infinite loops, the connector ignores any event whose CloudEvent `source` field matches its own origin URI. This prevents the metadata writes the connector itself performs from re-triggering the same flow.",{"_3465":1300,"_30219":1267,"_20927":53329,"_5":14373,"_27457":53212,"_2948":53330},[],"When several connectors run in parallel, for example for different AWS accounts, each instance has its own `connector_id`. All metadata the connector writes to Lamassu is stored under the key `lamassu.io/iot/{connector_id}`, allowing coexistence without collisions.",{"_3465":1301,"_30219":1267,"_20927":53332,"_5":14373,"_27457":53216,"_2948":53333},[],"Before enabling the connector you need an AWS account with the proper IAM permissions and the connector correctly configured. The deployment process (Docker Compose, Kubernetes or binary) is described in the deployment documentation.",{"_3465":1302,"_30219":1267,"_20927":53335,"_5":14373,"_27457":53220,"_2948":53336},[],"The IAM identity operating the connector needs at minimum the following permissions on the target account's resources:",{"_3465":1303,"_30219":1267,"_20927":53338,"_5":14373,"_27457":53220,"_2948":53339},[],"IAM action",{"_3465":1304,"_30219":1267,"_20927":53341,"_5":14373,"_27457":53220,"_2948":49644},[],{"_3465":1305,"_30219":1267,"_20927":53343,"_5":14373,"_27457":53220,"_2948":53344},[],"`iot:GetRegistrationCode`",{"_3465":1306,"_30219":1267,"_20927":53346,"_5":14373,"_27457":53220,"_2948":53347},[],"Obtain the verification code for CA registration in the Primary Account",{"_3465":1307,"_30219":1267,"_20927":53349,"_5":14373,"_27457":53220,"_2948":53350},[],"`iot:RegisterCACertificate`",{"_3465":1308,"_30219":1267,"_20927":53352,"_5":14373,"_27457":53220,"_2948":53353},[],"Register the CA in AWS IoT",{"_3465":1309,"_30219":1267,"_20927":53355,"_5":14373,"_27457":53220,"_2948":53356},[],"`iot:DescribeCACertificate`",{"_3465":1310,"_30219":1267,"_20927":53358,"_5":14373,"_27457":53220,"_2948":53359},[],"Check the CA registration status",{"_3465":1311,"_30219":1267,"_20927":53361,"_5":14373,"_27457":53220,"_2948":53362},[],"`iot:CreateThing` / `iot:UpdateThing`",{"_3465":1312,"_30219":1267,"_20927":53364,"_5":14373,"_27457":53220,"_2948":53365},[],"Create or update Things in IoT Core",{"_3465":1313,"_30219":1267,"_20927":53367,"_5":14373,"_27457":53220,"_2948":53368},[],"`iot:RegisterThing`",{"_3465":1314,"_30219":1267,"_20927":53370,"_5":14373,"_27457":53220,"_2948":53371},[],"Provision Things through a template",{"_3465":1315,"_30219":1267,"_20927":53373,"_5":14373,"_27457":53220,"_2948":53374},[],"`iot:RegisterCertificate`",{"_3465":1316,"_30219":1267,"_20927":53376,"_5":14373,"_27457":53220,"_2948":53377},[],"Register device certificates",{"_3465":1317,"_30219":1267,"_20927":53379,"_5":14373,"_27457":53220,"_2948":53380},[],"`iot:UpdateCertificate`",{"_3465":1318,"_30219":1267,"_20927":53382,"_5":14373,"_27457":53220,"_2948":53383},[],"Change a certificate's status (ACTIVE / INACTIVE / REVOKED)",{"_3465":1319,"_30219":1267,"_20927":53385,"_5":14373,"_27457":53220,"_2948":53386},[],"`iot:CreatePolicy` / `iot:AttachPolicy`",{"_3465":1320,"_30219":1267,"_20927":53388,"_5":14373,"_27457":53220,"_2948":53389},[],"Create and attach IoT policies",{"_3465":1321,"_30219":1267,"_20927":53391,"_5":14373,"_27457":53220,"_2948":53392},[],"`iot:CreateThingGroup` / `iot:AddThingToThingGroup`",{"_3465":1322,"_30219":1267,"_20927":53394,"_5":14373,"_27457":53220,"_2948":53395},[],"Manage Thing groups",{"_3465":1323,"_30219":1267,"_20927":53397,"_5":14373,"_27457":53220,"_2948":53398},[],"`iot:CreateProvisioningTemplate`",{"_3465":1324,"_30219":1267,"_20927":53400,"_5":14373,"_27457":53220,"_2948":53401},[],"Create JITP templates",{"_3465":1325,"_30219":1267,"_20927":53403,"_5":14373,"_27457":53220,"_2948":53404},[],"`iotdata:GetThingShadow` / `iotdata:UpdateThingShadow`",{"_3465":1326,"_30219":1267,"_20927":53406,"_5":14373,"_27457":53220,"_2948":53407},[],"Read and write the Device Shadow",{"_3465":1327,"_30219":1267,"_20927":53409,"_5":14373,"_27457":53220,"_2948":53410},[],"The forced-disconnect mechanism after revocation also requires access to the AWS IoT data plane API (`iot:Connect` with SigV4 over WebSocket), negotiated implicitly with the connector's credentials.",{"_3465":1328,"_30219":1267,"_20927":53412,"_5":14373,"_27457":53224,"_2948":53413},[],"Parameter",{"_3465":1329,"_30219":1267,"_20927":53415,"_5":14373,"_27457":53224,"_2948":53416},[],"Type",{"_3465":1330,"_30219":1267,"_20927":53418,"_5":14373,"_27457":53224,"_2948":53419},[],"Required",{"_3465":1331,"_30219":1267,"_20927":53421,"_5":14373,"_27457":53224,"_2948":53422},[],"Description",{"_3465":1332,"_30219":1267,"_20927":53424,"_5":14373,"_27457":53224,"_2948":53425},[],"`connector_id`",{"_3465":1333,"_30219":1267,"_20927":53427,"_5":14373,"_27457":53224,"_2948":25026},[],{"_3465":1334,"_30219":1267,"_20927":53429,"_5":14373,"_27457":53224,"_2948":53430},[],"Yes",{"_3465":1335,"_30219":1267,"_20927":53432,"_5":14373,"_27457":53224,"_2948":53433},[],"Unique identifier of this connector instance. Used as the metadata namespace: `lamassu.io/iot/{connector_id}`.",{"_3465":1336,"_30219":1267,"_20927":53435,"_5":14373,"_27457":53224,"_2948":53436},[],"`aws_config.region`",{"_3465":1337,"_30219":1267,"_20927":53438,"_5":14373,"_27457":53224,"_2948":25026},[],{"_3465":1338,"_30219":1267,"_20927":53440,"_5":14373,"_27457":53224,"_2948":53430},[],{"_3465":1339,"_30219":1267,"_20927":53442,"_5":14373,"_27457":53224,"_2948":53443},[],"AWS region where the connector operates.",{"_3465":1340,"_30219":1267,"_20927":53445,"_5":14373,"_27457":53224,"_2948":53446},[],"`aws_config.auth_method`",{"_3465":1341,"_30219":1267,"_20927":53448,"_5":14373,"_27457":53224,"_2948":25026},[],{"_3465":1342,"_30219":1267,"_20927":53450,"_5":14373,"_27457":53224,"_2948":53430},[],{"_3465":1343,"_30219":1267,"_20927":53452,"_5":14373,"_27457":53224,"_2948":53453},[],"Authentication method: `static`, `role` or empty (SDK default credential chain).",{"_3465":1344,"_30219":1267,"_20927":53455,"_5":14373,"_27457":53224,"_2948":53456},[],"`aws_config.access_key_id`",{"_3465":1345,"_30219":1267,"_20927":53458,"_5":14373,"_27457":53224,"_2948":25026},[],{"_3465":1346,"_30219":1267,"_20927":53460,"_5":14373,"_27457":53224,"_2948":53461},[],"Only with `auth_method=static`",{"_3465":1347,"_30219":1267,"_20927":53463,"_5":14373,"_27457":53224,"_2948":53464},[],"AWS access key.",{"_3465":1348,"_30219":1267,"_20927":53466,"_5":14373,"_27457":53224,"_2948":53467},[],"`aws_config.secret_access_key`",{"_3465":1349,"_30219":1267,"_20927":53469,"_5":14373,"_27457":53224,"_2948":25026},[],{"_3465":1350,"_30219":1267,"_20927":53471,"_5":14373,"_27457":53224,"_2948":53461},[],{"_3465":1351,"_30219":1267,"_20927":53473,"_5":14373,"_27457":53224,"_2948":53474},[],"AWS secret key.",{"_3465":1352,"_30219":1267,"_20927":53476,"_5":14373,"_27457":53224,"_2948":53477},[],"`aws_config.session_token`",{"_3465":1353,"_30219":1267,"_20927":53479,"_5":14373,"_27457":53224,"_2948":25026},[],{"_3465":1354,"_30219":1267,"_20927":53481,"_5":14373,"_27457":53224,"_2948":53482},[],"No",{"_3465":1355,"_30219":1267,"_20927":53484,"_5":14373,"_27457":53224,"_2948":53485},[],"Session token (with `auth_method=static`).",{"_3465":1356,"_30219":1267,"_20927":53487,"_5":14373,"_27457":53224,"_2948":53488},[],"`aws_config.role_arn`",{"_3465":1357,"_30219":1267,"_20927":53490,"_5":14373,"_27457":53224,"_2948":25026},[],{"_3465":1358,"_30219":1267,"_20927":53492,"_5":14373,"_27457":53224,"_2948":53493},[],"Only with `auth_method=role`",{"_3465":1359,"_30219":1267,"_20927":53495,"_5":14373,"_27457":53224,"_2948":53496},[],"ARN of the role to assume.",{"_3465":1360,"_30219":1267,"_20927":53498,"_5":14373,"_27457":53224,"_2948":53499},[],"`aws_config.endpoint_url`",{"_3465":1361,"_30219":1267,"_20927":53501,"_5":14373,"_27457":53224,"_2948":25026},[],{"_3465":1362,"_30219":1267,"_20927":53503,"_5":14373,"_27457":53224,"_2948":53482},[],{"_3465":1363,"_30219":1267,"_20927":53505,"_5":14373,"_27457":53224,"_2948":53506},[],"Alternative URL for all AWS services (useful with LocalStack in tests).",{"_3465":1364,"_30219":1267,"_20927":53508,"_5":14373,"_27457":53224,"_2948":53509},[],"`subscriber_event_bus`",{"_3465":1365,"_30219":1267,"_20927":53511,"_5":14373,"_27457":53224,"_2948":17611},[],{"_3465":1366,"_30219":1267,"_20927":53513,"_5":14373,"_27457":53224,"_2948":53430},[],{"_3465":1367,"_30219":1267,"_20927":53515,"_5":14373,"_27457":53224,"_2948":53516},[],"Configuration of the event bus the connector subscribes to (AMQP or AWS SQS/SNS).",{"_3465":1368,"_30219":1267,"_20927":53518,"_5":14373,"_27457":53224,"_2948":53519},[],"`dms_manager_client`",{"_3465":1369,"_30219":1267,"_20927":53521,"_5":14373,"_27457":53224,"_2948":25026},[],{"_3465":1370,"_30219":1267,"_20927":53523,"_5":14373,"_27457":53224,"_2948":53430},[],{"_3465":1371,"_30219":1267,"_20927":53525,"_5":14373,"_27457":53224,"_2948":53526},[],"HTTP URL of Lamassu's DMS Manager service.",{"_3465":1372,"_30219":1267,"_20927":53528,"_5":14373,"_27457":53224,"_2948":53529},[],"`device_manager_client`",{"_3465":1373,"_30219":1267,"_20927":53531,"_5":14373,"_27457":53224,"_2948":25026},[],{"_3465":1374,"_30219":1267,"_20927":53533,"_5":14373,"_27457":53224,"_2948":53430},[],{"_3465":1375,"_30219":1267,"_20927":53535,"_5":14373,"_27457":53224,"_2948":53536},[],"HTTP URL of Lamassu's Device Manager.",{"_3465":1376,"_30219":1267,"_20927":53538,"_5":14373,"_27457":53224,"_2948":53539},[],"`ca_client`",{"_3465":1377,"_30219":1267,"_20927":53541,"_5":14373,"_27457":53224,"_2948":25026},[],{"_3465":1378,"_30219":1267,"_20927":53543,"_5":14373,"_27457":53224,"_2948":53430},[],{"_3465":1379,"_30219":1267,"_20927":53545,"_5":14373,"_27457":53224,"_2948":53546},[],"HTTP URL of Lamassu's CA service.",{"_3465":1380,"_30219":1267,"_20927":53548,"_5":14373,"_27457":53228,"_2948":53549},[],"The connector owns the AWS side of four resource types — CAs, DMS provisioning templates (JITP), device certificates and Things. This section maps the bus events the connector consumes to the AWS resources they touch and to the AWS calls each flow performs. The state machine of each resource lives next to its detailed explanation; the last column links to it. AWS resources are referenced with the notation `IoTCore/<resource>`.",{"_3465":1381,"_30219":1267,"_20927":53551,"_5":14373,"_27457":53228,"_2948":53552},[],"The **CloudEvent type** column lists the event name on Lamassu's internal event bus; the **IAM actions** column lists the exact AWS SDK operations each flow invokes, so the required permissions can be derived directly from this table.",{"_3465":1382,"_30219":1267,"_20927":53554,"_5":14373,"_27457":53228,"_2948":53555},[],"CloudEvent type",{"_3465":1383,"_30219":1267,"_20927":53557,"_5":14373,"_27457":53228,"_2948":53558},[],"Lamassu resource",{"_3465":1384,"_30219":1267,"_20927":53560,"_5":14373,"_27457":53228,"_2948":53561},[],"AWS Resource",{"_3465":1385,"_30219":1267,"_20927":53563,"_5":14373,"_27457":53228,"_2948":53564},[],"IAM actions",{"_3465":1386,"_30219":1267,"_20927":53566,"_5":14373,"_27457":53228,"_2948":53567},[],"AWS calls and effect",{"_3465":1387,"_30219":1267,"_20927":53569,"_5":14373,"_27457":53228,"_2948":53570},[],"Where in this page",{"_3465":1388,"_30219":1267,"_20927":53572,"_5":14373,"_27457":53228,"_2948":53573},[],"`EventCreateCAKey` / `EventImportCAKey` / `EventUpdateCAMetadataKey`",{"_3465":1389,"_30219":1267,"_20927":53575,"_5":14373,"_27457":53228,"_2948":53576},[],"CA",{"_3465":1390,"_30219":1267,"_20927":53578,"_5":14373,"_27457":53228,"_2948":53579},[],"`IoTCore/CACertificate`",{"_3465":1391,"_30219":1267,"_20927":53581,"_5":14373,"_27457":53228,"_2948":53582},[],"`iot:GetRegistrationCode`, `iot:RegisterCACertificate`, `iot:DescribeCACertificate`, `iot:ListCACertificates`",{"_3465":1392,"_30219":1267,"_20927":53584,"_5":14373,"_27457":53228,"_2948":53585},[],"Loads the CA into connector state; a `registration.status = REQUESTED` write fires the registration flow (Primary with verification certificate, or SNI-only) and writes `SUCCEEDED` or `FAILED` back to the CA's metadata.",{"_3465":1393,"_30219":1267,"_20927":53587,"_5":14373,"_27457":53228,"_2948":53241},[],{"_3465":1394,"_30219":1267,"_20927":53589,"_5":14373,"_27457":53228,"_2948":53590},[],"`EventCreateDMSKey` / `EventUpdateDMSKey`",{"_3465":1395,"_30219":1267,"_20927":53592,"_5":14373,"_27457":53228,"_2948":53593},[],"DMS",{"_3465":1396,"_30219":1267,"_20927":53595,"_5":14373,"_27457":53228,"_2948":53596},[],"`IoTCore/ProvisioningTemplate`",{"_3465":1397,"_30219":1267,"_20927":53598,"_5":14373,"_27457":53228,"_2948":53599},[],"`iot:CreateProvisioningTemplate`, `iot:UpdateCACertificate`",{"_3465":1398,"_30219":1267,"_20927":53601,"_5":14373,"_27457":53228,"_2948":53602},[],"In `jitp` mode, attempts to create the provisioning template and attaches it to the registered CA. Non-idempotent: a `PUT /v1/dms/{id}` edit retries the creation and lands in `lamassu-dlq` after 3 retries. Idempotent for `none` and `auto` (configuration only).",{"_3465":1399,"_30219":1267,"_20927":53604,"_5":14373,"_27457":53228,"_2948":53269},[],{"_3465":1400,"_30219":1267,"_20927":53606,"_5":14373,"_27457":53228,"_2948":53607},[],"`EventBindDeviceIdentityKey`",{"_3465":1401,"_30219":1267,"_20927":53609,"_5":14373,"_27457":53228,"_2948":53610},[],"Device",{"_3465":1402,"_30219":1267,"_20927":53612,"_5":14373,"_27457":53228,"_2948":53613},[],"`IoTCore/Policy`, `IoTCore/ThingGroup`, `IoTCore/Thing`",{"_3465":1403,"_30219":1267,"_20927":53615,"_5":14373,"_27457":53228,"_2948":53616},[],"`iot:CreatePolicy` / `iot:DeletePolicyVersion`, `iot:GetPolicy` / `iot:ListPolicyVersions`, `iot:CreateThingGroup`, `iot:DescribeThing` / `iot:ListThingPrincipals`, `iot:RegisterThing`",{"_3465":1404,"_30219":1267,"_20927":53618,"_5":14373,"_27457":53228,"_2948":53619},[],"In `auto` mode: creates/updates policies, ensures Thing groups, revokes stale principals and provisions the Thing via `iot:RegisterThing`. In `jitp` mode: no AWS calls; AWS runs the JITP template on first connection.",{"_3465":1405,"_30219":1267,"_20927":53621,"_5":14373,"_27457":53228,"_2948":53277},[],{"_3465":1406,"_30219":1267,"_20927":53623,"_5":14373,"_27457":53228,"_2948":53624},[],"`EventUpdateCertificateStatusKey`",{"_3465":1407,"_30219":1267,"_20927":53626,"_5":14373,"_27457":53228,"_2948":53627},[],"Certificate",{"_3465":1408,"_30219":1267,"_20927":53629,"_5":14373,"_27457":53228,"_2948":53630},[],"`IoTCore/Certificate`",{"_3465":1409,"_30219":1267,"_20927":53632,"_5":14373,"_27457":53228,"_2948":53633},[],"`iot:UpdateCertificate`, `iot:Connect` (data plane)",{"_3465":1410,"_30219":1267,"_20927":53635,"_5":14373,"_27457":53228,"_2948":53636},[],"Maps status to AWS (`ACTIVE`, `INACTIVE`, `REVOKED`), calls `iot:UpdateCertificate` and forces an MQTT disconnect on revoke.",{"_3465":1411,"_30219":1267,"_20927":53638,"_5":14373,"_27457":53228,"_2948":53289},[],{"_3465":1412,"_30219":1267,"_20927":53640,"_5":14373,"_27457":53228,"_2948":53641},[],"`EventUpdateCertificateMetadataKey` / `EventUpdateDeviceMetadataKey`",{"_3465":1413,"_30219":1267,"_20927":53643,"_5":14373,"_27457":53228,"_2948":53644},[],"Certificate / Device",{"_3465":1414,"_30219":1267,"_20927":53646,"_5":14373,"_27457":53228,"_2948":53647},[],"`IoTCore/Certificate`, `IoTCore/Thing`",{"_3465":1415,"_30219":1267,"_20927":53649,"_5":14373,"_27457":53228,"_2948":49650},[],{"_3465":1416,"_30219":1267,"_20927":53651,"_5":14373,"_27457":53228,"_2948":53652},[],"Refreshes internal state; the connector ignores events whose CloudEvent `source` matches its own URI to avoid self-triggered loops.",{"_3465":1417,"_30219":1267,"_20927":53654,"_5":14373,"_27457":53228,"_2948":53297},[],{"_3465":1418,"_30219":1267,"_20927":53656,"_5":14373,"_27457":53232,"_2948":53657},[],"For devices to authenticate to AWS IoT Core with certificates issued by a Lamassu CA, that CA must first be registered in the AWS account. The connector handles this registration automatically in response to the `EventCreateCAKey`, `EventImportCAKey` and `EventUpdateCAMetadataKey` events, but the operation **only fires when the administrator explicitly requests it** through the CA metadata field.",{"_3465":1419,"_30219":1267,"_20927":53659,"_5":14373,"_27457":53236,"_2948":53660},[],"Registration is triggered by setting `registration.status = \"REQUESTED\"` on the `lamassu.io/iot/{connector_id}` key of the CA's metadata. This can be done from the Lamassu console in the CA management section or through the API.",{"_3465":1420,"_30219":1267,"_20927":53662,"_5":14373,"_27457":53236,"_2948":53663},[],"Once the event is received, the connector attempts to register the CA in AWS and updates the `registration.status` field in the CA's metadata with the result: `\"SUCCEEDED\"` if registration was successful, or `\"FAILED\"` with an error message otherwise. The process is asynchronous, so you must periodically check the metadata status until the operation completes.",{"_3465":1421,"_30219":1267,"_20927":53665,"_5":14373,"_27457":53240,"_2948":53666},[],"The CA registration flow is driven by the `registration.status` field of the CA's connector metadata:",{"_3465":1422,"_30219":1267,"_20927":53668,"_5":14373,"_27457":53240,"_2948":53669},[],"Transition",{"_3465":1423,"_30219":1267,"_20927":53671,"_5":14373,"_27457":53240,"_2948":53672},[],"AWS calls",{"_3465":1424,"_30219":1267,"_20927":53674,"_5":14373,"_27457":53240,"_2948":53675},[],"`NotRegistered` → `Requested`",{"_3465":1425,"_30219":1267,"_20927":53677,"_5":14373,"_27457":53240,"_2948":53678},[],"none (metadata write only)",{"_3465":1426,"_30219":1267,"_20927":53680,"_5":14373,"_27457":53240,"_2948":53681},[],"`Requested` → `Registering`",{"_3465":1427,"_30219":1267,"_20927":53683,"_5":14373,"_27457":53240,"_2948":53684},[],"`iot:GetRegistrationCode` (Primary Account only)",{"_3465":1428,"_30219":1267,"_20927":53686,"_5":14373,"_27457":53240,"_2948":53687},[],"`Registering` → `Succeeded`",{"_3465":1429,"_30219":1267,"_20927":53689,"_5":14373,"_27457":53240,"_2948":53690},[],"`iot:RegisterCACertificate` (Primary: proof-of-possession with an ephemeral key; SNI-only: `CertificateMode: SNI_ONLY`)",{"_3465":1430,"_30219":1267,"_20927":53692,"_5":14373,"_27457":53240,"_2948":53693},[],"`Registering` → `Failed`",{"_3465":1431,"_30219":1267,"_20927":53695,"_5":14373,"_27457":53240,"_2948":53696},[],"failed `iot:RegisterCACertificate`; the error detail is written to the CA's metadata",{"_3465":1432,"_30219":1267,"_20927":53698,"_5":14373,"_27457":53240,"_2948":53699},[],"`Failed` / `Succeeded` → `Requested`",{"_3465":1433,"_30219":1267,"_20927":53701,"_5":14373,"_27457":53240,"_2948":53702},[],"none (a new `REQUESTED` write re-runs the flow)",{"_3465":1434,"_30219":1267,"_20927":53704,"_5":14373,"_27457":53244,"_2948":53705},[],"When the `primary_account` parameter is `true`, the connector runs the full registration flow with proof-of-possession of the private key:",{"_3465":1435,"_30219":1267,"_20927":53707,"_5":14373,"_27457":53244,"_2948":53708},[],"It calls `iot:GetRegistrationCode` to obtain AWS's verification code.",{"_3465":1436,"_30219":1267,"_20927":53710,"_5":14373,"_27457":53244,"_2948":53711},[],"The connector internally generates an ephemeral RSA-2048 key pair and builds a CSR whose Common Name is exactly that registration code. It then calls Lamassu's signing service so the registered CA issues a real X.509 verification certificate signing that CSR. The ephemeral private key is used only for this purpose and is neither stored nor sent to AWS.",{"_3465":1437,"_30219":1267,"_20927":53713,"_5":14373,"_27457":53244,"_2948":53714},[],"It sends the CA (in PEM) and the verification certificate to AWS via `iot:RegisterCACertificate`, enabling registration with `AllowAutoRegistration: true`.",{"_3465":1438,"_30219":1267,"_20927":53716,"_5":14373,"_27457":53244,"_2948":53717},[],"Only one account can own a CA in a given AWS region. If the CA is already registered with the same serial number, the connector silently skips the step.",{"_3465":1439,"_30219":1267,"_20927":53719,"_5":14373,"_27457":53244,"_2948":53720},[],"The tags AWS IoT Core applies to the registered CA certificate are `LMS.CA.ID`, `LMS.CA.SN` and `LMS.CA.CN`.",{"_3465":1440,"_30219":1267,"_20927":53722,"_5":14373,"_27457":53248,"_2948":53723},[],"When `primary_account` is `false`, the connector registers the CA using `CertificateMode: SNI_ONLY`. This mode requires no verification code or access to the CA's private key, so it is the right choice when the CA is managed from another AWS account or when the administrator does not hold the private key. It is the usual method to register the same CA in several AWS accounts simultaneously.",{"_3465":1441,"_30219":1267,"_20927":53725,"_5":14373,"_27457":53252,"_2948":53726},[],"Each DMS participating in the AWS IoT Core integration must have the metadata key `lamassu.io/iot/{connector_id}` configured. The most important field of that configuration is `registration_mode`, which determines how devices are provisioned in AWS.",{"_3465":1442,"_30219":1267,"_20927":53728,"_5":14373,"_27457":53252,"_2948":53729},[],"There are three registration modes, and the choice among them depends on the fleet's provisioning strategy.",{"_3465":1443,"_30219":1267,"_20927":53731,"_5":14373,"_27457":53256,"_2948":53732},[],"In this mode the connector **creates no Things, groups or policies** in AWS IoT Core. It only syncs certificate status (active, revoked, suspended) as it changes in Lamassu. It is the right mode when Thing provisioning in AWS is managed by an external system and Lamassu only needs to keep certificate status up to date.",{"_3465":1444,"_30219":1267,"_20927":53734,"_5":14373,"_27457":53260,"_2948":53735},[],"`auto` mode delegates full device provisioning in AWS to Lamassu at enrollment time. When the device successfully completes its EST enrollment and Lamassu emits the `EventBindDeviceIdentityKey` event, the connector automatically executes the following sequence:",{"_3465":1445,"_30219":1267,"_20927":53737,"_5":14373,"_27457":53260,"_2948":53738},[],"Creates or updates the IoT policies configured in the DMS.",{"_3465":1446,"_30219":1267,"_20927":53740,"_5":14373,"_27457":53260,"_2948":53741},[],"Creates the root group `LAMASSU` in the AWS account (if it does not exist) and the child groups configured in the DMS as subgroups of `LAMASSU`. If the groups already exist, the `ResourceAlreadyExistsException` error is ignored, making the operation idempotent.",{"_3465":1447,"_30219":1267,"_20927":53743,"_5":14373,"_27457":53260,"_2948":53744},[],"If the Thing already existed in AWS IoT Core, the connector iterates all certificates (principals) currently attached to that Thing and marks them as `REVOKED` in AWS, ensuring previous certificates cannot keep being used to authenticate.",{"_3465":1448,"_30219":1267,"_20927":53746,"_5":14373,"_27457":53260,"_2948":53747},[],"Calls `iot:RegisterThing` with a CloudFormation-style provisioning template that creates the Thing, registers the device's certificate (PEM of the device certificate and of the issuing CA certificate) and attaches the configured policies.",{"_3465":1449,"_30219":1267,"_20927":53749,"_5":14373,"_27457":53260,"_2948":53750},[],"Once provisioning completes, the connector stores the resulting certificate's ARN in the Lamassu certificate's metadata under the key `lamassu.io/iot/{connector_id}` and marks the device as `Registered: true` in Device Manager.",{"_3465":1450,"_30219":1267,"_20927":53752,"_5":14373,"_27457":53260,"_2948":53753},[],"**The Thing name in AWS is the Common Name (CN) of the device's certificate.** This convention is fundamental for the firmware developer: the `/CN=` value the device includes in its CSR when enrolling becomes the ThingName it must identify itself with in all MQTT operations against AWS IoT Core.",{"_3465":1451,"_30219":1267,"_20927":53755,"_5":14373,"_27457":53264,"_2948":53756},[],"Just-In-Time Provisioning (JITP) mode delegates provisioning to AWS instead of the connector doing it directly. When the connector detects the DMS is in `jitp` mode, it creates a JITP provisioning template in AWS IoT Core and attaches it to the registered CA certificate. The connector attempts to create this template when the DMS is created and again on every full DMS edit (`PUT /v1/dms/{id}`) — not at device enrollment time. The attempt is not idempotent: when a template named after the DMS ID already exists, the creation call fails, the event is retried three times and finally lands in the `lamassu-dlq` poison queue (see Troubleshooting). The template is created once; later DMS edits never update its content. A DMS update that omits `metadata` or sends `null` keeps the stored metadata, so the connector key `lamassu.io/iot/{connector_id}` remains present and the attempt is still triggered. A body that supplies a `metadata` object replaces the stored metadata entirely: if that object does not carry the connector key, the key is dropped and the connector silently skips the DMS's future events. Once the template is attached, when a device with a certificate issued by that CA connects to AWS IoT Core for the first time, AWS executes the template automatically: it creates the Thing, registers the certificate and activates it.",{"_3465":1452,"_30219":1267,"_20927":53758,"_5":14373,"_27457":53264,"_2948":53759},[],"The connector creates the template, named after the DMS ID, only once. Each later edit of the DMS that keeps the connector key tries to create it again and fails, because the connector does not update existing templates. Later changes to `jitp_config.provisioning_role_arn`, `jitp_config.enable_template` or to the groups and policies the template references must be applied by hand in AWS IoT Core.",{"_3465":1453,"_30219":1267,"_20927":53761,"_5":14373,"_27457":53264,"_2948":53762},[],"The failed event is retried and ends in `lamassu-dlq`. Groups and policies are registered before the failure, but the assignment of the template to the registered CA, the write-back of the ARN to the DMS and the shadow update when `ManagedCAs` changes are skipped.",{"_3465":1454,"_30219":1267,"_20927":53764,"_5":14373,"_27457":53264,"_2948":53765},[],"The Thing name in the JITP template is derived from `AWS::IoT::Certificate::CommonName`, which corresponds to the device certificate's CN — the same convention as `auto` mode.",{"_3465":1455,"_30219":1267,"_20927":53767,"_5":14373,"_27457":53264,"_2948":53768},[],"This mode requires the `jitp_config.provisioning_role_arn` field to be configured with the ARN of an IAM role AWS IoT Core can assume to execute the template. If not configured, the connector uses the default `arn:aws:iam::{account}:role/JITPRole` and logs a warning. The administrator must ensure that role exists in the account and has the necessary permissions before enabling JITP mode.",{"_3465":1456,"_30219":1267,"_20927":53770,"_5":14373,"_27457":53268,"_2948":53771},[],"The DMS's `registration_mode` determines what the connector does on the AWS side when the DMS is created or fully edited:",{"_3465":1457,"_30219":1267,"_20927":53773,"_5":14373,"_27457":53268,"_2948":53669},[],{"_3465":1458,"_30219":1267,"_20927":53775,"_5":14373,"_27457":53268,"_2948":53672},[],{"_3465":1459,"_30219":1267,"_20927":53777,"_5":14373,"_27457":53268,"_2948":53778},[],"`Unconfigured` → `None` / `Auto`",{"_3465":1460,"_30219":1267,"_20927":53780,"_5":14373,"_27457":53268,"_2948":53781},[],"none (configuration only)",{"_3465":1461,"_30219":1267,"_20927":53783,"_5":14373,"_27457":53268,"_2948":53784},[],"`None` ↔ `Auto`",{"_3465":1462,"_30219":1267,"_20927":53786,"_5":14373,"_27457":53268,"_2948":53781},[],{"_3465":1463,"_30219":1267,"_20927":53788,"_5":14373,"_27457":53268,"_2948":53789},[],"Any → `Jitp`",{"_3465":1464,"_30219":1267,"_20927":53791,"_5":14373,"_27457":53268,"_2948":53792},[],"`iot:CreateProvisioningTemplate` (non-idempotent: it fails when the template already exists; after 3 retries the event lands in `lamassu-dlq`)",{"_3465":1465,"_30219":1267,"_20927":53794,"_5":14373,"_27457":53268,"_2948":53795},[],"`Jitp` → `None` / `Auto`",{"_3465":1466,"_30219":1267,"_20927":53797,"_5":14373,"_27457":53268,"_2948":53798},[],"none (the template stays in the AWS account)",{"_3465":1467,"_30219":1267,"_20927":53800,"_5":14373,"_27457":53272,"_2948":53801},[],"For the firmware developer, `auto` mode is transparent: the device performs its EST enrollment as usual and, as a side effect, it is provisioned in AWS IoT Core with no additional step.",{"_3465":1468,"_30219":1267,"_20927":53803,"_5":14373,"_27457":53272,"_2948":53804},[],"The full flow from the device's perspective is:",{"_3465":1469,"_30219":1267,"_20927":53806,"_5":14373,"_27457":53272,"_2948":53807},[],"Once the connector completes provisioning, the device can connect to the AWS IoT Core MQTT endpoint using its private key and the certificate issued by Lamassu. The ThingName it must identify itself with in AWS is exactly the certificate's CN.",{"_3465":1470,"_30219":1267,"_20927":53809,"_5":14373,"_27457":53276,"_2948":53810},[],"Things only exist under `auto` mode; in `jitp` mode AWS creates the Thing itself when the device first connects. The Thing name is always the device certificate's CN:",{"_3465":1471,"_30219":1267,"_20927":53812,"_5":14373,"_27457":53276,"_2948":53669},[],{"_3465":1472,"_30219":1267,"_20927":53814,"_5":14373,"_27457":53276,"_2948":53672},[],{"_3465":1473,"_30219":1267,"_20927":53816,"_5":14373,"_27457":53276,"_2948":53817},[],"`Absent` → `Provisioned`",{"_3465":1474,"_30219":1267,"_20927":53819,"_5":14373,"_27457":53276,"_2948":53820},[],"policies created/updated, Thing groups ensured, `iot:RegisterThing` (creates the Thing, registers the certificate, attaches policies)",{"_3465":1475,"_30219":1267,"_20927":53822,"_5":14373,"_27457":53276,"_2948":53823},[],"`Provisioned` → `Provisioned` (re-enrollment)",{"_3465":1476,"_30219":1267,"_20927":53825,"_5":14373,"_27457":53276,"_2948":53826},[],"stale principals marked `REVOKED`, new `iot:RegisterThing` run; the new certificate ARN replaces the old one in Lamassu metadata",{"_3465":1477,"_30219":1267,"_20927":53828,"_5":14373,"_27457":53276,"_2948":53829},[],"In `jitp` mode the connector makes no provisioning calls: AWS executes the JITP template on the device's first connection and creates the Thing, registers the certificate and activates it on its own.",{"_3465":1478,"_30219":1267,"_20927":53831,"_5":14373,"_27457":53280,"_2948":53832},[],"In JITP mode the device also performs its EST enrollment conventionally and obtains its certificate from Lamassu. The difference is that AWS IoT Core does not know the device until it attempts its first connection.",{"_3465":1479,"_30219":1267,"_20927":53834,"_5":14373,"_27457":53280,"_2948":53835},[],"When the device establishes its first MQTT connection to AWS IoT Core presenting the Lamassu-issued certificate, AWS detects that the certificate belongs to a CA registered with a JITP template, executes that template and creates the Thing automatically. The initial connection may fail or be delayed while the template runs; firmware must be prepared to retry the connection.",{"_3465":1480,"_30219":1267,"_20927":53837,"_5":14373,"_27457":53280,"_2948":53838},[],"For the JITP flow to work correctly:",{"_3465":1481,"_30219":1267,"_20927":53840,"_5":14373,"_27457":53280,"_2948":53841},[],"The CA must be registered in AWS in Primary Account mode (SNI-only mode does not support JITP).",{"_3465":1482,"_30219":1267,"_20927":53843,"_5":14373,"_27457":53280,"_2948":53844},[],"The IAM role configured in `jitp_config.provisioning_role_arn` must exist and have permissions to create Things, register certificates and attach policies in the AWS account.",{"_3465":1483,"_30219":1267,"_20927":53846,"_5":14373,"_27457":53280,"_2948":53847},[],"The device must present both its certificate and the issuing CA's certificate in the TLS handshake with AWS IoT Core.",{"_3465":1484,"_30219":1267,"_20927":53849,"_5":14373,"_27457":53280,"_2948":53850},[],"Certificates provisioned via JITP **do not have the connector's metadata key** (`lamassu.io/iot/{connector_id}`) in Lamassu. As a consequence, status changes of those certificates in Lamassu are not automatically synced to AWS through the state synchronization mechanism described in the next section.",{"_3465":1485,"_30219":1267,"_20927":53852,"_5":14373,"_27457":53284,"_2948":53853},[],"The connector listens for the `EventUpdateCertificateStatusKey` event and, when a certificate holding the connector's metadata key changes status in Lamassu, replicates that change in AWS IoT Core. The following table shows the status mapping:",{"_3465":1486,"_30219":1267,"_20927":53855,"_5":14373,"_27457":53284,"_2948":53856},[],"Status in Lamassu",{"_3465":1487,"_30219":1267,"_20927":53858,"_5":14373,"_27457":53284,"_2948":53859},[],"Revocation reason",{"_3465":1488,"_30219":1267,"_20927":53861,"_5":14373,"_27457":53284,"_2948":53862},[],"Status in AWS IoT Core",{"_3465":1489,"_30219":1267,"_20927":53864,"_5":14373,"_27457":53284,"_2948":53865},[],"`Active`",{"_3465":1490,"_30219":1267,"_20927":53867,"_5":14373,"_27457":53284,"_2948":53868},[],"None",{"_3465":1491,"_30219":1267,"_20927":53870,"_5":14373,"_27457":53284,"_2948":53871},[],"`ACTIVE`",{"_3465":1492,"_30219":1267,"_20927":53873,"_5":14373,"_27457":53284,"_2948":53874},[],"`Revoked`",{"_3465":1493,"_30219":1267,"_20927":53876,"_5":14373,"_27457":53284,"_2948":53877},[],"`certificateHold`",{"_3465":1494,"_30219":1267,"_20927":53879,"_5":14373,"_27457":53284,"_2948":53880},[],"`INACTIVE`",{"_3465":1495,"_30219":1267,"_20927":53882,"_5":14373,"_27457":53284,"_2948":53874},[],{"_3465":1496,"_30219":1267,"_20927":53884,"_5":14373,"_27457":53284,"_2948":53885},[],"Any other reason",{"_3465":1497,"_30219":1267,"_20927":53887,"_5":14373,"_27457":53284,"_2948":53888},[],"`REVOKED`",{"_3465":1498,"_30219":1267,"_20927":53890,"_5":14373,"_27457":53284,"_2948":53891},[],"Only the `Active` and `Revoked` states produce a call to `iot:UpdateCertificate`. The other lifecycle states of Lamassu (`RenewalWindow`, `AboutToExpire`, `Expired`) are not synced to AWS IoT Core; the certificate status in AWS remains unchanged until the status in Lamassu becomes `Active` or `Revoked`.",{"_3465":1499,"_30219":1267,"_20927":53893,"_5":14373,"_27457":53288,"_2948":53894},[],"Certificates holding the connector's metadata key sync their status; certificates provisioned via JITP have no metadata key and stay out of this machine:",{"_3465":1500,"_30219":1267,"_20927":53896,"_5":14373,"_27457":53288,"_2948":53669},[],{"_3465":1501,"_30219":1267,"_20927":53898,"_5":14373,"_27457":53288,"_2948":53672},[],{"_3465":1502,"_30219":1267,"_20927":53900,"_5":14373,"_27457":53288,"_2948":53901},[],"`NotSynced` → `Active`",{"_3465":1503,"_30219":1267,"_20927":53903,"_5":14373,"_27457":53288,"_2948":53380},[],{"_3465":1504,"_30219":1267,"_20927":53905,"_5":14373,"_27457":53288,"_2948":53906},[],"`Active` → `Inactive`",{"_3465":1505,"_30219":1267,"_20927":53908,"_5":14373,"_27457":53288,"_2948":53909},[],"`iot:UpdateCertificate` + forced MQTT disconnect",{"_3465":1506,"_30219":1267,"_20927":53911,"_5":14373,"_27457":53288,"_2948":53912},[],"`Active` → `Revoked`",{"_3465":1507,"_30219":1267,"_20927":53914,"_5":14373,"_27457":53288,"_2948":53909},[],{"_3465":1508,"_30219":1267,"_20927":53916,"_5":14373,"_27457":53288,"_2948":53917},[],"`Inactive` / `Revoked` → `Active`",{"_3465":1509,"_30219":1267,"_20927":53919,"_5":14373,"_27457":53288,"_2948":53380},[],{"_3465":1510,"_30219":1267,"_20927":53921,"_5":14373,"_27457":53288,"_2948":53922},[],"`RenewalWindow` / `AboutToExpire` / `Expired`",{"_3465":1511,"_30219":1267,"_20927":53924,"_5":14373,"_27457":53288,"_2948":53925},[],"none (these states are not synced to AWS)",{"_3465":1512,"_30219":1267,"_20927":53927,"_5":14373,"_27457":53292,"_2948":53928},[],"When the connector marks a certificate as `REVOKED` or `INACTIVE` in AWS, it additionally performs a forced disconnect of the device. To do so it opens an MQTT connection over WebSocket (with SigV4 authentication using the connector's credentials) to the AWS IoT Core data endpoint, using the certificate's CN as the MQTT client identifier, and closes it immediately. This terminates any active MQTT session the device may have at that moment.",{"_3465":1513,"_30219":1267,"_20927":53930,"_5":14373,"_27457":53292,"_2948":53931},[],"This forced disconnect happens at the moment Lamassu records the status change. If the device tries to reconnect after the disconnect, AWS IoT Core will reject the connection because the certificate is already listed as `REVOKED` or `INACTIVE`.",{"_3465":1514,"_30219":1267,"_20927":53933,"_5":14373,"_27457":53292,"_2948":53934},[],"Certificates provisioned in JITP mode do not have this automatic sync, since they lack the connector's metadata key.",{"_3465":1515,"_30219":1267,"_20927":53936,"_5":14373,"_27457":53296,"_2948":53937},[],"The connector can write to the AWS IoT Core Device Shadow to send action signals to the device firmware. This feature is enabled per DMS with `shadow_config.enable: true`.",{"_3465":1516,"_30219":1267,"_20927":53939,"_5":14373,"_27457":53296,"_2948":53940},[],"If `shadow_config.shadow_name` holds a value, the connector uses a Named Shadow with that name; otherwise it uses the Classic Shadow (the Thing's default shadow).",{"_3465":1517,"_30219":1267,"_20927":53942,"_5":14373,"_27457":53300,"_2948":53943},[],"The connector writes to the `desired.identity_actions` field of the shadow document. Each entry contains a Unix timestamp in milliseconds. The device firmware must read this field and act accordingly.",{"_3465":1518,"_30219":1267,"_20927":53945,"_5":14373,"_27457":53300,"_2948":53946},[],"There are two action types:",{"_3465":1519,"_30219":1267,"_20927":53948,"_5":14373,"_27457":53300,"_2948":53949},[],"**`UPDATE_CERTIFICATE`**: written when a certificate's preventive renewal window activates — that is, when the `triggered` field of the preventive renewal delta flips from `false` to `true`. This action tells the device it must start the re-enrollment process to renew its certificate before it expires.",{"_3465":1520,"_30219":1267,"_20927":53951,"_5":14373,"_27457":53300,"_2948":53952},[],"**`UPDATE_TRUST_ANCHOR_LIST`**: written to all devices of a DMS when the DMS's `ManagedCAs` list changes. This action tells the device it must update its trusted CA store.",{"_3465":1521,"_30219":1267,"_20927":53954,"_5":14373,"_27457":53300,"_2948":53955},[],"The shadow write process consists of reading the current shadow (`iotdata:GetThingShadow`), merging the new actions with the existing ones and writing the result (`iotdata:UpdateThingShadow`). If the shadow does not exist, the connector creates it. After a successful write, the list of pending actions in the device's metadata in Lamassu is cleared.",{"_3465":1522,"_30219":1267,"_20927":53957,"_5":14373,"_27457":53304,"_2948":53958},[],"The connector creates and attaches the policies configured in the DMS. A typical policy for a device using MQTT and the Device Shadow has this structure:",{"_3465":1523,"_30219":1267,"_20927":53960,"_5":14373,"_27457":53304,"_2948":53961},[],"In the policy above, the `<AWS_REGION>` and `<AWS_ACCOUNT_ID>` placeholders must be replaced with the AWS region and the twelve-digit account identifier of the target account before applying the policy. The `${iot:Connection.Thing.ThingName}` variable automatically limits each permission to the Thing the device is connected as, following the principle of least privilege. The `${ShadowName}` variable in the shadow ARNs is a placeholder that must be replaced with the `shadow_config.shadow_name` value configured in the DMS; if the Classic Shadow is used, it can be simplified by removing the `name/${ShadowName}/` segment. AWS IoT policies do not support regex alternation; the `[name/${ShadowName}/]*` notation represents the optionality of that segment within ARN syntax constraints.",{"_3465":1524,"_30219":1267,"_20927":53963,"_5":14373,"_27457":53304,"_2948":53964},[],"The first statement lets the device connect using its ThingName as the MQTT identifier. The second authorizes publishing to the Thing's generic MQTT topic and to the shadow topics, needed so the device can update its reported state. The last two statements grant subscribe and receive permissions over the same topics, letting the device receive shadow updates (for example, the `UPDATE_CERTIFICATE` and `UPDATE_TRUST_ANCHOR_LIST` actions written by the connector).",{"_3465":1525,"_30219":1267,"_20927":53966,"_5":14373,"_27457":53308,"_2948":53967},[],"**Symptom:** The CA registration stays in `REQUESTED` indefinitely.",{"_3465":1526,"_30219":1267,"_20927":53969,"_5":14373,"_27457":53308,"_2948":53970},[],"**Cause:** The connector is not running or is not subscribed to the event bus. It can also indicate incorrect IAM credentials, insufficient permissions or that the metadata key was written with a wrong `connector_id`.",{"_3465":1527,"_30219":1267,"_20927":53972,"_5":14373,"_27457":53308,"_2948":53973},[],"**Resolution:** Verify the connector process is active and the logs show no AWS communication errors. Check the metadata field was written under the exact key `lamassu.io/iot/{connector_id}`. If the error persists, the connector will update the status to `FAILED` with a descriptive message in the CA metadata.",{"_3465":1528,"_30219":1267,"_20927":53975,"_5":14373,"_27457":53308,"_2948":53976},[],"**Symptom:** A certificate's status is not synced to AWS after a revocation.",{"_3465":1529,"_30219":1267,"_20927":53978,"_5":14373,"_27457":53308,"_2948":53979},[],"**Cause:** Most commonly the certificate was provisioned in JITP mode. JITP certificates lack the connector's metadata key and are outside the state synchronization mechanism. If the DMS is in `auto` mode, it may indicate the initial provisioning did not complete correctly and the AWS ARN was not stored in the certificate metadata.",{"_3465":1530,"_30219":1267,"_20927":53981,"_5":14373,"_27457":53308,"_2948":53982},[],"**Resolution:** For JITP certificates, migrate the DMS to `auto` mode and re-provision the affected devices. For `auto` mode certificates, verify the certificate has the AWS ARN stored in its metadata; if not, repeat the provisioning.",{"_3465":1531,"_30219":1267,"_20927":53984,"_5":14373,"_27457":53308,"_2948":53985},[],"**Symptom:** The forced disconnect does not terminate the device's MQTT session after revocation.",{"_3465":1532,"_30219":1267,"_20927":53987,"_5":14373,"_27457":53308,"_2948":53988},[],"**Cause:** The device uses an MQTT client ID different from the certificate's CN. The forced disconnect opens a connection using the CN as client ID; if the firmware uses another identifier, the disconnect does not affect that session.",{"_3465":1533,"_30219":1267,"_20927":53990,"_5":14373,"_27457":53308,"_2948":53991},[],"**Resolution:** Make sure the firmware uses exactly the certificate's CN as the MQTT client identifier. That CN matches the ThingName in AWS IoT Core.",{"_3465":1534,"_30219":1267,"_20927":53993,"_5":14373,"_27457":53308,"_2948":53994},[],"**Symptom:** The device receives `CLIENT_ID_REJECTED` when connecting to AWS IoT Core.",{"_3465":1535,"_30219":1267,"_20927":53996,"_5":14373,"_27457":53308,"_2948":53997},[],"**Cause:** The MQTT client ID does not match the ThingName, which is always the CN of the certificate issued by Lamassu.",{"_3465":1536,"_30219":1267,"_20927":53999,"_5":14373,"_27457":53308,"_2948":54000},[],"**Resolution:** Verify the firmware uses exactly the value of the CN field included in the enrollment CSR as the MQTT client identifier.",{"_3465":1537,"_30219":1267,"_20927":54002,"_5":14373,"_27457":53308,"_2948":54003},[],"**Symptom:** The device's first MQTT connection in JITP mode fails or times out.",{"_3465":1538,"_30219":1267,"_20927":54005,"_5":14373,"_27457":53308,"_2948":54006},[],"**Cause:** This is expected behavior while AWS executes the JITP template on the device's first connection.",{"_3465":1539,"_30219":1267,"_20927":54008,"_5":14373,"_27457":53308,"_2948":54009},[],"**Resolution:** Firmware must implement retries with exponential backoff for the first connection. If the failure persists beyond a few minutes, verify the IAM role configured in `jitp_config.provisioning_role_arn` exists in the account and has permissions to create Things, register certificates and attach policies.",{"_3465":1540,"_30219":1267,"_20927":54011,"_5":14373,"_27457":53308,"_2948":54012},[],"**Symptom:** The Device Shadow is not updated when it should be.",{"_3465":1541,"_30219":1267,"_20927":54014,"_5":14373,"_27457":53308,"_2948":54015},[],"**Cause:** The shadow feature is disabled in the DMS configuration, the connector's credentials lack IoT data-plane permissions, or the firmware reads a different shadow than the configured one.",{"_3465":1542,"_30219":1267,"_20927":54017,"_5":14373,"_27457":53308,"_2948":54018},[],"**Resolution:** Check that `shadow_config.enable` is `true` in the connector metadata for the corresponding DMS. If a Named Shadow is used, verify `shadow_config.shadow_name` holds the correct name and that the firmware reads that Named Shadow and not the Classic Shadow. Confirm the connector's credentials have `iotdata:GetThingShadow` and `iotdata:UpdateThingShadow` permissions.",{"_3465":1543,"_30219":1267,"_20927":54020,"_5":14373,"_27457":53308,"_2948":54021},[],"**Symptom:** After editing a DMS in `jitp` mode, DMS update messages appear in `lamassu-dlq`, or JITP configuration changes have no effect in AWS.",{"_3465":1544,"_30219":1267,"_20927":54023,"_5":14373,"_27457":53308,"_2948":54024},[],"**Cause:** Every full DMS edit (`PUT /v1/dms/{id}`) triggers a `CreateProvisioningTemplate` attempt for the template named after the DMS ID, and the call is not idempotent: when the template already exists, it fails, the event is retried three times and finally lands in `lamassu-dlq`. The connector’s later steps are skipped.",{"_3465":1545,"_30219":1267,"_20927":54026,"_5":14373,"_27457":53308,"_2948":54027},[],"**Resolution:** Check that the template named with the DMS ID exists in AWS IoT Core and that JITP enrollment works. If the JITP configuration was changed, apply it by hand to the AWS template.",{"_3465":1546,"_30219":1267,"_20927":54029,"_5":14373,"_27457":53308,"_2948":54030},[],"<Card title=\"Configure a DMS\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_3465":1547,"_30219":1267,"_20927":54032,"_5":14373,"_27457":53308,"_2948":54033},[],"<Card title=\"Device enrollment (EST)\" href=\"/docs/platform/iot-fleets/enrollment/overview\" />",{"_3465":1548,"_30219":1267,"_20927":54035,"_5":14373,"_27457":53308,"_2948":54036},[],"<Card title=\"Certificate management\" href=\"/docs/platform/pki/certificates\" />",{"_3465":1549,"_30219":1549,"_5":14725,"_2948":51743,"_30551":54038,"_20927":54039,"_27457":1549},[49254,50729,51743],[],{"_3465":1550,"_30219":1549,"_20927":54041,"_5":14373,"_27457":1549,"_2948":54042},[],"Organize devices and their identities, prepare enrollment and integrate consumers.",{"_3465":1551,"_30219":1549,"_5":30548,"_20927":54044,"_27457":54045,"_2948":54046},[],"/docs/platform/iot-fleets/overview#start-here","Start here",{"_3465":1552,"_30219":1549,"_5":30548,"_20927":54048,"_27457":54049,"_2948":51741},[],"/docs/platform/iot-fleets/overview#devices-and-identities",{"_3465":1553,"_30219":1549,"_5":30548,"_20927":54051,"_27457":54052,"_2948":51924},[],"/docs/platform/iot-fleets/overview#enrollment-with-pki",{"_3465":1554,"_30219":1549,"_5":30548,"_20927":54054,"_27457":54055,"_2948":53205},[],"/docs/platform/iot-fleets/overview#integrations",{"_3465":1555,"_30219":1549,"_5":30548,"_20927":54057,"_27457":54058,"_2948":54059},[],"/docs/platform/iot-fleets/overview#who-prepares-each-part","Who prepares each part",{"_3465":1556,"_30219":1549,"_20927":54061,"_5":14373,"_27457":1549,"_2948":54062},[],"IoT Fleets applies PKI to the device lifecycle: registration, obtaining an identity, renewal and retirement. It is intended for those who administer a device population and those who integrate its enrollment client or the system that accepts it.",{"_3465":1557,"_30219":1549,"_20927":54064,"_5":14373,"_27457":54045,"_2948":54065},[],"Follow Enroll and connect your first device to prepare a DMS, obtain the identity from the client and demonstrate an mTLS connection. The automatic path includes initial trust, a CSR and result checks.",{"_3465":1558,"_30219":1549,"_20927":54067,"_5":14373,"_27457":54045,"_2948":54068},[],"To start with an existing certificate, use Register a device manually. You can then prepare enrollment and renewal for the next device.",{"_3465":1559,"_30219":1549,"_20927":54070,"_5":14373,"_27457":54049,"_2948":54071},[],"Resource",{"_3465":1560,"_30219":1549,"_20927":54073,"_5":14373,"_27457":54049,"_2948":54074},[],"What it represents",{"_3465":1561,"_30219":1549,"_20927":54076,"_5":14373,"_27457":54049,"_2948":54077},[],"**Device**",{"_3465":1562,"_30219":1549,"_20927":54079,"_5":14373,"_27457":54049,"_2948":54080},[],"An inventory entry with an identifier, owning DMS and classification.",{"_3465":1563,"_30219":1549,"_20927":54082,"_5":14373,"_27457":54049,"_2948":54083},[],"**Identity**",{"_3465":1564,"_30219":1549,"_20927":54085,"_5":14373,"_27457":54049,"_2948":54086},[],"The device's association with its certificates: an active version and a history.",{"_3465":1565,"_30219":1549,"_20927":54088,"_5":14373,"_27457":54049,"_2948":54089},[],"**DMS**",{"_3465":1566,"_30219":1549,"_20927":54091,"_5":14373,"_27457":54049,"_2948":54092},[],"The service that configures admission, enrollment, renewal and trust distribution.",{"_3465":1567,"_30219":1549,"_20927":54094,"_5":14373,"_27457":54049,"_2948":54095},[],"**Fleet**",{"_3465":1568,"_30219":1549,"_20927":54097,"_5":14373,"_27457":54049,"_2948":54098},[],"The population you operate, represented through devices, DMSs, tags and metadata.",{"_3465":1569,"_30219":1549,"_20927":54100,"_5":14373,"_27457":54049,"_2948":54101},[],"Each device has an owning DMS. You can organize a population through several DMSs when it needs different policies, and use tags to classify it. “Fleet” describes that operational context; the resources you create and query are DMSs and devices.",{"_3465":1570,"_30219":1549,"_20927":54103,"_5":14373,"_27457":54049,"_2948":54104},[],"Device management covers states, certificate history and identity actions. During renewal, retain the relationship with the device and check which certificate becomes the current identity.",{"_3465":1571,"_30219":1549,"_20927":54106,"_5":14373,"_27457":54052,"_2948":54107},[],"This section connects PKI rules to the device client. Preparation follows this order:",{"_3465":1572,"_30219":1549,"_20927":54109,"_5":14373,"_27457":54052,"_2948":54110},[],"**CA and profile:** prepare the issuer and certificate rules in PKI.",{"_3465":1573,"_30219":1549,"_20927":54112,"_5":14373,"_27457":54052,"_2948":54113},[],"**DMS policy:** define how the device is admitted, how requests authenticate and which trust is distributed.",{"_3465":1574,"_30219":1549,"_20927":54115,"_5":14373,"_27457":54052,"_2948":54116},[],"**Client:** prepare the initial credential, server trust, and key generation or custody.",{"_3465":1575,"_30219":1549,"_20927":54118,"_5":14373,"_27457":54052,"_2948":54119},[],"**Result:** request the certificate, install it and check its association with the device.",{"_3465":1576,"_30219":1549,"_20927":54121,"_5":14373,"_27457":54052,"_2948":54122},[],"**Continuity:** configure renewal, successor installation and recovery according to DMS policy.",{"_3465":1577,"_30219":1549,"_20927":54124,"_5":14373,"_27457":54052,"_2948":54125},[],"<Card title=\"Configure the DMS\" description=\"Prepare the CA, admission, authentication and renewal rules.\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_3465":1578,"_30219":1549,"_20927":54127,"_5":14373,"_27457":54052,"_2948":54128},[],"<Card title=\"Integrate the EST client\" description=\"Review the device endpoints, formats and checks.\" href=\"/docs/platform/iot-fleets/enrollment/est-client\" />",{"_3465":1579,"_30219":1549,"_20927":54130,"_5":14373,"_27457":54055,"_2948":54131},[],"An issued identity needs a consumer that trusts its issuer, validates the certificate and grants the device permissions. Prepare both the device's trust in the server and the server's trust in the device.",{"_3465":1580,"_30219":1549,"_20927":54133,"_5":14373,"_27457":54055,"_2948":54134},[],"The AWS IoT Core guide explains how to use the identity in that destination. Provisioning in Lamassu and provisioning in the destination are separate decisions; review the conditions of the chosen mode before expecting state synchronization.",{"_3465":1581,"_30219":1549,"_20927":54136,"_5":14373,"_27457":54058,"_2948":54137},[],"Participant",{"_3465":1582,"_30219":1549,"_20927":54139,"_5":14373,"_27457":54058,"_2948":54140},[],"Responsibility",{"_3465":1583,"_30219":1549,"_20927":54142,"_5":14373,"_27457":54058,"_2948":54143},[],"PKI administrator",{"_3465":1584,"_30219":1549,"_20927":54145,"_5":14373,"_27457":54058,"_2948":54146},[],"CA, issuance profile, chain and revocation publication.",{"_3465":1585,"_30219":1549,"_20927":54148,"_5":14373,"_27457":54058,"_2948":54149},[],"Provisioning administrator",{"_3465":1586,"_30219":1549,"_20927":54151,"_5":14373,"_27457":54058,"_2948":54152},[],"DMS, admission, authentication per operation and inventory.",{"_3465":1587,"_30219":1549,"_20927":54154,"_5":14373,"_27457":54058,"_2948":54155},[],"Device integrator",{"_3465":1588,"_30219":1549,"_20927":54157,"_5":14373,"_27457":54058,"_2948":54158},[],"Initial credential, key, EST client, trust and certificate installation.",{"_3465":1589,"_30219":1549,"_20927":54160,"_5":14373,"_27457":54058,"_2948":54161},[],"Consumer integrator",{"_3465":1590,"_30219":1549,"_20927":54163,"_5":14373,"_27457":54058,"_2948":54164},[],"Trusted issuers, validation and device permissions in the destination.",{"_3465":1591,"_30219":1549,"_20927":54166,"_5":14373,"_27457":54058,"_2948":54167},[],"Permissions and audit are shared with the rest of Platform. Prepare installation and instance connectivity in Deployment.",{"_3465":1592,"_30219":1592,"_5":14725,"_2948":54169,"_30551":54170,"_20927":54172,"_27457":1592},"Enroll and connect your first device",[49254,50729,51743,54171],"Getting started",[],{"_3465":1593,"_30219":1592,"_20927":54174,"_5":14373,"_27457":1592,"_2948":54175},[],"Obtain an identity through EST, verify its association and use it in an mTLS connection.",{"_3465":1594,"_30219":1592,"_5":30548,"_20927":54177,"_27457":54178,"_2948":49264},[],"/docs/platform/iot-fleets/quickstarts/enroll-device#before-you-begin",{"_3465":1595,"_30219":1592,"_5":30548,"_20927":54180,"_27457":54181,"_2948":54182},[],"/docs/platform/iot-fleets/quickstarts/enroll-device#prepare-the-bootstrap-credential","Prepare the bootstrap credential",{"_3465":1596,"_30219":1592,"_5":30548,"_20927":54184,"_27457":54185,"_2948":54186},[],"/docs/platform/iot-fleets/quickstarts/enroll-device#configure-the-evaluation-dms","Configure the evaluation DMS",{"_3465":1597,"_30219":1592,"_5":30548,"_20927":54188,"_27457":54189,"_2948":54190},[],"/docs/platform/iot-fleets/quickstarts/enroll-device#prepare-the-client-and-check-cacerts","Prepare the client and check cacerts",{"_3465":1598,"_30219":1592,"_5":30548,"_20927":54192,"_27457":54193,"_2948":54194},[],"/docs/platform/iot-fleets/quickstarts/enroll-device#enroll-the-device","Enroll the device",{"_3465":1599,"_30219":1592,"_5":30548,"_20927":54196,"_27457":54197,"_2948":54198},[],"/docs/platform/iot-fleets/quickstarts/enroll-device#verify-the-obtained-identity","Verify the obtained identity",{"_3465":1600,"_30219":1592,"_5":30548,"_20927":54200,"_27457":54201,"_2948":54202},[],"/docs/platform/iot-fleets/quickstarts/enroll-device#demonstrate-an-mtls-connection","Demonstrate an mTLS connection",{"_3465":1601,"_30219":1592,"_5":30548,"_20927":54204,"_27457":54205,"_2948":54206},[],"/docs/platform/iot-fleets/quickstarts/enroll-device#result-and-continuity","Result and continuity",{"_3465":1602,"_30219":1592,"_20927":54208,"_5":14373,"_27457":1592,"_2948":54209},[],"Prepare an evaluation DMS, enroll `est-device-001` from the client and use its identity with a local consumer that requires a certificate. The path connects administrator policy to the material the device actually installs.",{"_3465":1603,"_30219":1592,"_20927":54211,"_5":14373,"_27457":54178,"_2948":54212},[],"A Lamassu instance accessible through HTTPS and permissions for CAs, profiles, DMSs and reading devices/certificates.",{"_3465":1604,"_30219":1592,"_20927":54214,"_5":14373,"_27457":54178,"_2948":54215},[],"Bash, OpenSSL 3.x, curl with `--fail-with-body` and two terminals on your computer. Work in a new directory with restricted access.",{"_3465":1605,"_30219":1592,"_20927":54217,"_5":14373,"_27457":54178,"_2948":54218},[],"An active root CA that issues directly, with an available key and sufficient validity. Follow Create your first CA. Save its verified public certificate as `device-root.pem`.",{"_3465":1606,"_30219":1592,"_20927":54220,"_5":14373,"_27457":54178,"_2948":54221},[],"Available global identifier `est-device-001`. This path uses automatic registration: do not create the device in the console first.",{"_3465":1607,"_30219":1592,"_20927":54223,"_5":14373,"_27457":54178,"_2948":54224},[],"The approved root for Lamassu HTTPS in `est-trust.pem`, obtained through an independent channel. It can differ from the device CA; prepare networking/TLS in Deployment.",{"_3465":1608,"_30219":1592,"_20927":54226,"_5":14373,"_27457":54181,"_2948":54227},[],"Issue a bootstrap leaf certificate with `CN=est-device-001`, its own key and Client Authentication use. Follow Issue and verify a certificate, changing its CN and saving the result as `bootstrap.crt` and `bootstrap.key`. Choose validity that covers this test and check the pair and chain.",{"_3465":1609,"_30219":1592,"_20927":54229,"_5":14373,"_27457":54181,"_2948":54230},[],"The same root CA can issue it for this isolated evaluation. The operational identity will have a different key and certificate. The matching CN makes the example easier to read; initial certificate authentication does not itself bind the bootstrap CN to the requested ID. Review admission before applying the policy to a population.",{"_3465":1610,"_30219":1592,"_20927":54232,"_5":14373,"_27457":54185,"_2948":54233},[],"Create an explicit leaf profile compatible with EC P-256, with **Honor Subject**, CN from the CSR, **Digital Signature**, **Client Authentication** and **1 hour** validity within the root's validity. Do not enable CA signing. Rules and precedence are explained in Profiles.",{"_3465":1611,"_30219":1592,"_20927":54235,"_5":14373,"_27457":54185,"_2948":54236},[],"Create the `Acme EST Evaluation` DMS with this configuration:",{"_3465":1612,"_30219":1592,"_20927":54238,"_5":14373,"_27457":54185,"_2948":54239},[],"Setting",{"_3465":1613,"_30219":1592,"_20927":54241,"_5":14373,"_27457":54185,"_2948":54242},[],"Evaluation value",{"_3465":1614,"_30219":1592,"_20927":54244,"_5":14373,"_27457":54185,"_2948":54245},[],"Enrollment CA",{"_3465":1615,"_30219":1592,"_20927":54247,"_5":14373,"_27457":54185,"_2948":54248},[],"Issuing root from `device-root.pem`.",{"_3465":1616,"_30219":1592,"_20927":54250,"_5":14373,"_27457":54185,"_2948":52054},[],{"_3465":1617,"_30219":1592,"_20927":54252,"_5":14373,"_27457":54185,"_2948":54253},[],"The 1-hour leaf profile you just prepared.",{"_3465":1618,"_30219":1592,"_20927":54255,"_5":14373,"_27457":54185,"_2948":54256},[],"Protocol / Registration Mode",{"_3465":1619,"_30219":1592,"_20927":54258,"_5":14373,"_27457":54185,"_2948":54259},[],"`EST_RFC7030` / `JITP`.",{"_3465":1620,"_30219":1592,"_20927":54261,"_5":14373,"_27457":54185,"_2948":54262},[],"Verify CSR Signature",{"_3465":1621,"_30219":1592,"_20927":54264,"_5":14373,"_27457":54185,"_2948":54265},[],"Enabled.",{"_3465":1622,"_30219":1592,"_20927":54267,"_5":14373,"_27457":54185,"_2948":54268},[],"Enable Replaceable Enrollment",{"_3465":1623,"_30219":1592,"_20927":54270,"_5":14373,"_27457":54185,"_2948":54271},[],"Disabled; the ID must be new.",{"_3465":1624,"_30219":1592,"_20927":54273,"_5":14373,"_27457":54185,"_2948":54274},[],"Initial authentication",{"_3465":1625,"_30219":1592,"_20927":54276,"_5":14373,"_27457":54185,"_2948":54277},[],"`CLIENT_CERTIFICATE`; Validation CAs includes the direct bootstrap issuer; no expired certificates.",{"_3465":1626,"_30219":1592,"_20927":54279,"_5":14373,"_27457":54185,"_2948":54280},[],"Renewal authentication",{"_3465":1627,"_30219":1592,"_20927":54282,"_5":14373,"_27457":54185,"_2948":54283},[],"`CLIENT_CERTIFICATE`, configured in the independent re-enrollment block.",{"_3465":1628,"_30219":1592,"_20927":54285,"_5":14373,"_27457":54185,"_2948":54286},[],"Re-enrollment Validation CAs / Enable Expired Renewal",{"_3465":1629,"_30219":1592,"_20927":54288,"_5":14373,"_27457":54185,"_2948":54289},[],"Not needed for this direct issuance; the Enrollment CA is always trusted for re-enrollment / disabled.",{"_3465":1630,"_30219":1592,"_20927":54291,"_5":14373,"_27457":54185,"_2948":54292},[],"Re-enrollment Delta",{"_3465":1631,"_30219":1592,"_20927":54294,"_5":14373,"_27457":54185,"_2948":54295},[],"1 hour.",{"_3465":1632,"_30219":1592,"_20927":54297,"_5":14373,"_27457":54185,"_2948":54298},[],"Preventive / Critical Delta",{"_3465":1633,"_30219":1592,"_20927":54300,"_5":14373,"_27457":54185,"_2948":54301},[],"30 minutes / 10 minutes.",{"_3465":1634,"_30219":1592,"_20927":54303,"_5":14373,"_27457":54185,"_2948":54304},[],"Revoke on Re-enrollment",{"_3465":1635,"_30219":1592,"_20927":54306,"_5":14373,"_27457":54185,"_2948":54307},[],"Disabled to test the successor before retiring the previous identity.",{"_3465":1636,"_30219":1592,"_20927":54309,"_5":14373,"_27457":54185,"_2948":52062},[],{"_3465":1637,"_30219":1592,"_20927":54311,"_5":14373,"_27457":54185,"_2948":54312},[],"Disabled; the operational key is generated in the client.",{"_3465":1638,"_30219":1592,"_20927":54314,"_5":14373,"_27457":54185,"_2948":54315},[],"CA Distribution",{"_3465":1639,"_30219":1592,"_20927":54317,"_5":14373,"_27457":54185,"_2948":54318},[],"Include Enrollment CA enabled; Include Lamassu System CA disabled.",{"_3465":1640,"_30219":1592,"_20927":54320,"_5":14373,"_27457":54185,"_2948":54321},[],"Equal duration and window allow immediate renewal testing. These are evaluation values; size production settings according to connectivity and recovery times. Save, reread both authentication blocks and retain the DMS ID. The console exposes independent editors for the enrollment and re-enrollment authentication; the DMS guide describes their fields, and you can also check the resource through the DMS API.",{"_3465":1641,"_30219":1592,"_20927":54323,"_5":14373,"_27457":54189,"_2948":54324},[],"Place the four trust and bootstrap files in the new directory. Replace the URL with your installation's URL:",{"_3465":1642,"_30219":1592,"_20927":54326,"_5":14373,"_27457":54189,"_2948":54327},[],"The download must succeed and contain the expected enrollment root. Compare its fingerprint with `device-root.pem`. This check does not turn the response into initial trust or prove that you can issue.",{"_3465":1643,"_30219":1592,"_20927":54329,"_5":14373,"_27457":54193,"_2948":54330},[],"Generate a new key and CSR with the selected identifier:",{"_3465":1644,"_30219":1592,"_20927":54332,"_5":14373,"_27457":54193,"_2948":54333},[],"Request the identity with the bootstrap credential and extract the certificate from the default response:",{"_3465":1645,"_30219":1592,"_20927":54335,"_5":14373,"_27457":54193,"_2948":54336},[],"If curl fails, use Troubleshooting with the saved body. Do not convert it or repeat the request without querying inventory: a timeout or error can follow persisted issuance.",{"_3465":1646,"_30219":1592,"_20927":54338,"_5":14373,"_27457":54197,"_2948":54339},[],"Expect `device.crt: OK` and exit code 0 from `cmp`. Check the CN, serial, dates, Digital Signature and Client Authentication. The certificate must be a leaf: it must not declare `CA:TRUE` or Certificate Sign use. Check that its validity matches the one-hour profile.",{"_3465":1647,"_30219":1592,"_20927":54341,"_5":14373,"_27457":54197,"_2948":54342},[],"In Lamassu, open `est-device-001`. It must be created with the intended owning DMS, a current identity and the received certificate in its history. Compare the local serial with the slot; thresholds can show a renewal state rather than simply Active.",{"_3465":1648,"_30219":1592,"_20927":54344,"_5":14373,"_27457":54201,"_2948":54345},[],"In a second terminal, enter the same directory and run `umask 077`. Create a local server certificate and start a test consumer. This server trusts `device-root.pem` and requires a valid client identity:",{"_3465":1649,"_30219":1592,"_20927":54347,"_5":14373,"_27457":54201,"_2948":54348},[],"Leave it running. In the first terminal, connect using the obtained identity:",{"_3465":1650,"_30219":1592,"_20927":54350,"_5":14373,"_27457":54201,"_2948":54351},[],"Expect HTTP `200`. The client's trust in this local server is its self-signed `consumer.crt`; the server verifies the device against `device-root.pem`. The HTML file displays OpenSSL diagnostic information.",{"_3465":1651,"_30219":1592,"_20927":54353,"_5":14373,"_27457":54201,"_2948":54354},[],"With the same server still running, test that a request without a client certificate is rejected:",{"_3465":1652,"_30219":1592,"_20927":54356,"_5":14373,"_27457":54201,"_2948":54357},[],"Rejection must correspond to a missing certificate at the server, not a stopped server. Stop the consumer with Ctrl+C after the test. This exercise demonstrates TLS authentication and key possession; your application must also define authorization and revocation consumption. Server options are described in openssl-s\\_server.",{"_3465":1653,"_30219":1592,"_20927":54359,"_5":14373,"_27457":54205,"_2948":54360},[],"Check",{"_3465":1654,"_30219":1592,"_20927":54362,"_5":14373,"_27457":54205,"_2948":54363},[],"Expected result",{"_3465":1655,"_30219":1592,"_20927":54365,"_5":14373,"_27457":54205,"_2948":54366},[],"Registration",{"_3465":1656,"_30219":1592,"_20927":54368,"_5":14373,"_27457":54205,"_2948":54369},[],"ID created automatically and correct DMS.",{"_3465":1657,"_30219":1592,"_20927":54371,"_5":14373,"_27457":54205,"_2948":53627},[],{"_3465":1658,"_30219":1592,"_20927":54373,"_5":14373,"_27457":54205,"_2948":54374},[],"CN, profile, serial and key verified.",{"_3465":1659,"_30219":1592,"_20927":54376,"_5":14373,"_27457":54205,"_2948":54377},[],"Inventory",{"_3465":1660,"_30219":1592,"_20927":54379,"_5":14373,"_27457":54205,"_2948":54380},[],"Received serial visible as the current identity and in history.",{"_3465":1661,"_30219":1592,"_20927":54382,"_5":14373,"_27457":54205,"_2948":54383},[],"Consumer",{"_3465":1662,"_30219":1592,"_20927":54385,"_5":14373,"_27457":54205,"_2948":54386},[],"mTLS responds 200 with the identity and rejects a missing certificate.",{"_3465":1663,"_30219":1592,"_20927":54388,"_5":14373,"_27457":54205,"_2948":54389},[],"Continue with Renewal and recovery to request a successor pair within the window, install it and repeat the mTLS check. The consumer must use the new files in that test. After checking the successor, retire the previous certificate according to PKI policy; the example does not revoke it automatically.",{"_3465":1664,"_30219":1592,"_20927":54391,"_5":14373,"_27457":54205,"_2948":54392},[],"Devices and identities explains retirement and the limits of historical revocation. For a real destination, prepare consumer trust, validation and permissions; AWS IoT Core is an available integration.",{"_3465":1665,"_30219":1665,"_5":14725,"_2948":51759,"_30551":54394,"_20927":54395,"_27457":1665},[49254,50729,51743,54171],[],{"_3465":1666,"_30219":1665,"_20927":54397,"_5":14373,"_27457":1665,"_2948":54398},[],"Prepare a DMS, register a device and associate a verified certificate with its identity.",{"_3465":1667,"_30219":1665,"_5":30548,"_20927":54400,"_27457":54401,"_2948":49264},[],"/docs/platform/iot-fleets/quickstarts/register-device#before-you-begin",{"_3465":1668,"_30219":1665,"_5":30548,"_20927":54403,"_27457":54404,"_2948":54405},[],"/docs/platform/iot-fleets/quickstarts/register-device#prepare-the-dms","Prepare the DMS",{"_3465":1669,"_30219":1665,"_5":30548,"_20927":54407,"_27457":54408,"_2948":54409},[],"/docs/platform/iot-fleets/quickstarts/register-device#register-the-device","Register the device",{"_3465":1670,"_30219":1665,"_5":30548,"_20927":54411,"_27457":54412,"_2948":54413},[],"/docs/platform/iot-fleets/quickstarts/register-device#check-the-initial-status","Check the initial status",{"_3465":1671,"_30219":1665,"_5":30548,"_20927":54415,"_27457":54416,"_2948":54417},[],"/docs/platform/iot-fleets/quickstarts/register-device#assign-an-identity","Assign an identity",{"_3465":1672,"_30219":1665,"_5":30548,"_20927":54419,"_27457":54420,"_2948":54421},[],"/docs/platform/iot-fleets/quickstarts/register-device#verify-the-device","Verify the device",{"_3465":1673,"_30219":1665,"_5":30548,"_20927":54423,"_27457":54424,"_2948":54363},[],"/docs/platform/iot-fleets/quickstarts/register-device#expected-result",{"_3465":1674,"_30219":1665,"_5":30548,"_20927":54426,"_27457":54427,"_2948":54428},[],"/docs/platform/iot-fleets/quickstarts/register-device#if-the-result-fails","If the result fails",{"_3465":1675,"_30219":1665,"_5":30548,"_20927":54430,"_27457":54431,"_2948":54432},[],"/docs/platform/iot-fleets/quickstarts/register-device#automate-the-next-device","Automate the next device",{"_3465":1676,"_30219":1665,"_20927":54434,"_5":14373,"_27457":1665,"_2948":54435},[],"This path is intended for those starting to administer device identities. You will register `device-001` and assign an existing certificate to check the relationship between device, DMS and identity history.",{"_3465":1677,"_30219":1665,"_20927":54437,"_5":14373,"_27457":1665,"_2948":54438},[],"Assignment updates Lamassu's inventory. Install the key and certificate separately on the device; check the connection to a consumer in that destination's integration.",{"_3465":1678,"_30219":1665,"_20927":54440,"_5":14373,"_27457":54401,"_2948":54441},[],"An accessible instance and permission to administer DMSs, devices and certificate associations.",{"_3465":1679,"_30219":1665,"_20927":54443,"_5":14373,"_27457":54401,"_2948":54444},[],"An active CA with an available key. If one does not exist yet, follow Create your first CA.",{"_3465":1680,"_30219":1665,"_20927":54446,"_5":14373,"_27457":54401,"_2948":54447},[],"An active end-entity certificate from that CA whose `Common Name` is exactly `device-001`, together with its private key. Follow Issue and verify a certificate to obtain and check both.",{"_3465":1681,"_30219":1665,"_20927":54449,"_5":14373,"_27457":54401,"_2948":54450},[],"The identifier `device-001` available in the inventory. If you already used it, choose another and issue the certificate with that same `Common Name`.",{"_3465":1682,"_30219":1665,"_20927":54452,"_5":14373,"_27457":54404,"_2948":54453},[],"A DMS must exist before registering the device. If you already have a suitable one, check its CA and note its identifier; to create one:",{"_3465":1683,"_30219":1665,"_20927":54455,"_5":14373,"_27457":54404,"_2948":54456},[],"Open the DMS inventory and its creation action. Assign a recognizable name, such as `Acme Evaluation DMS`.",{"_3465":1684,"_30219":1665,"_20927":54458,"_5":14373,"_27457":54404,"_2948":54459},[],"In **Enrollment CA**, select the CA that issued `device.crt`.",{"_3465":1685,"_30219":1665,"_20927":54461,"_5":14373,"_27457":54404,"_2948":54462},[],"In **Registration Mode**, select `PRE_REGISTRATION` for the path that starts with explicit registration.",{"_3465":1686,"_30219":1665,"_20927":54464,"_5":14373,"_27457":54404,"_2948":54465},[],"In the authentication section, enable **Require client certificate** and leave **Call external webhook** off. Under **Require client certificate**, add the CA whose initial certificates you will accept to **Validation CAs**; for this evaluation, it can be the same CA. Keep **Verify CSR Signature** enabled and leave **Enable server-side key generation** off if you will not use it.",{"_3465":1687,"_30219":1665,"_20927":54467,"_5":14373,"_27457":54404,"_2948":54468},[],"Review renewal and trust distribution settings with the DMS guide, save the service and note its identifier.",{"_3465":1688,"_30219":1665,"_20927":54470,"_5":14373,"_27457":54404,"_2948":54471},[],"Reopen the DMS and confirm that the enrollment CA is the expected one and the service appears in inventory.",{"_3465":1689,"_30219":1665,"_20927":54473,"_5":14373,"_27457":54404,"_2948":54474},[],"These settings prepare DMS policy. The next steps register and assign through the console; they do not send an EST request or test admission through that protocol.",{"_3465":1690,"_30219":1665,"_20927":54476,"_5":14373,"_27457":54408,"_2948":54477},[],"Open **Managed Devices** and the registration action. Complete:",{"_3465":1691,"_30219":1665,"_20927":54479,"_5":14373,"_27457":54408,"_2948":54480},[],"**Device ID**: `device-001`.",{"_3465":1692,"_30219":1665,"_20927":54482,"_5":14373,"_27457":54408,"_2948":54483},[],"**Registration Authority**: the DMS you just prepared; this label identifies the service fulfilling the registration authority role.",{"_3465":1693,"_30219":1665,"_20927":54485,"_5":14373,"_27457":54408,"_2948":54486},[],"**Icon** and **Tags**: optional classification.",{"_3465":1694,"_30219":1665,"_20927":54488,"_5":14373,"_27457":54408,"_2948":54489},[],"Confirm registration.",{"_3465":1695,"_30219":1665,"_20927":54491,"_5":14373,"_27457":54412,"_2948":54492},[],"Open the device. It should appear in **No Identity** and show the selected owning DMS.",{"_3465":1696,"_30219":1665,"_20927":54494,"_5":14373,"_27457":54412,"_2948":54495},[],"Registration creates the inventory entry; the certificate must still be associated.",{"_3465":1697,"_30219":1665,"_20927":54497,"_5":14373,"_27457":54416,"_2948":54498},[],"Select **Assign Identity** and the existing certificate with `CN=device-001`. Check its serial number, issuer and validity against the certificate you verified in PKI.",{"_3465":1698,"_30219":1665,"_20927":54500,"_5":14373,"_27457":54416,"_2948":54501},[],"Confirm the association. The **Issue New Instead** alternative is explained in Devices and identities.",{"_3465":1699,"_30219":1665,"_20927":54503,"_5":14373,"_27457":54420,"_2948":54504},[],"Check that it has an active identity. In **Certificate History**, verify the associated serial number; in **Device Event Timeline**, find the assignment event.",{"_3465":1700,"_30219":1665,"_20927":54506,"_5":14373,"_27457":54420,"_2948":54507},[],"Keep the device identifier, owning DMS and serial number as references for the result.",{"_3465":1701,"_30219":1665,"_20927":54509,"_5":14373,"_27457":54424,"_2948":54360},[],{"_3465":1702,"_30219":1665,"_20927":54511,"_5":14373,"_27457":54424,"_2948":54512},[],"Result",{"_3465":1703,"_30219":1665,"_20927":54514,"_5":14373,"_27457":54424,"_2948":53610},[],{"_3465":1704,"_30219":1665,"_20927":54516,"_5":14373,"_27457":54424,"_2948":54517},[],"`device-001` appears in inventory with the expected DMS.",{"_3465":1705,"_30219":1665,"_20927":54519,"_5":14373,"_27457":54424,"_2948":54520},[],"Current identity",{"_3465":1706,"_30219":1665,"_20927":54522,"_5":14373,"_27457":54424,"_2948":54523},[],"The associated certificate matches the one you verified in PKI.",{"_3465":1707,"_30219":1665,"_20927":54525,"_5":14373,"_27457":54424,"_2948":54526},[],"History",{"_3465":1708,"_30219":1665,"_20927":54528,"_5":14373,"_27457":54424,"_2948":54529},[],"The associated issuance appears with its serial number and dates.",{"_3465":1709,"_30219":1665,"_20927":54531,"_5":14373,"_27457":54424,"_2948":54532},[],"Key and certificate",{"_3465":1710,"_30219":1665,"_20927":54534,"_5":14373,"_27457":54424,"_2948":54535},[],"You have the verified pair ready to install on the device.",{"_3465":1711,"_30219":1665,"_20927":54537,"_5":14373,"_27457":54427,"_2948":54538},[],"If you cannot select the DMS, confirm its creation and your read permissions.",{"_3465":1712,"_30219":1665,"_20927":54540,"_5":14373,"_27457":54427,"_2948":54541},[],"If no eligible certificate appears, check that its `Common Name` matches the `Device ID` exactly, it is active and it was issued by the expected CA.",{"_3465":1713,"_30219":1665,"_20927":54543,"_5":14373,"_27457":54427,"_2948":54544},[],"If assignment fails, review permissions and operation diagnostics before repeating it. Query the device and its history again to find the persisted result.",{"_3465":1714,"_30219":1665,"_20927":54546,"_5":14373,"_27457":54427,"_2948":54547},[],"If an expiration or renewal state appears, check certificate dates and DMS thresholds in Devices and identities.",{"_3465":1715,"_30219":1665,"_20927":54549,"_5":14373,"_27457":54431,"_2948":54550},[],"Continue with DMS and EST for the device to request and renew certificates. Prepare server trust, the initial credential and policies for each operation before implementing the client.",{"_3465":1716,"_30219":1665,"_20927":54552,"_5":14373,"_27457":54431,"_2948":54553},[],"For a path from the client through mTLS, follow Enroll and connect your first device with a new ID.",{"_3465":1717,"_30219":1665,"_20927":54555,"_5":14373,"_27457":54431,"_2948":54556},[],"To use the identity in AWS IoT Core, also prepare trust and permissions in the destination. Check the connection from the device after installing the required key, certificate and chain.",{"_3465":1718,"_30219":1718,"_5":14725,"_2948":54558,"_30551":54559,"_20927":54560,"_27457":1718},"Lamassu IoT Platform",[49254,50729],[],{"_3465":1719,"_30219":1718,"_20927":54562,"_5":14373,"_27457":1718,"_2948":54563},[],"Build a PKI and apply its certificates to your devices' lifecycle.",{"_3465":1720,"_30219":1718,"_5":30548,"_20927":54565,"_27457":54566,"_2948":54046},[],"/docs/platform/overview#start-here",{"_3465":1721,"_30219":1718,"_5":30548,"_20927":54568,"_27457":54569,"_2948":54570},[],"/docs/platform/overview#choose-your-path","Choose your path",{"_3465":1722,"_30219":1718,"_5":30548,"_20927":54572,"_27457":54573,"_2948":54574},[],"/docs/platform/overview#architecture-at-a-glance","Architecture at a glance",{"_3465":1723,"_30219":1718,"_5":30548,"_20927":54576,"_27457":54577,"_2948":54578},[],"/docs/platform/overview#core-capabilities","Core capabilities",{"_3465":1724,"_30219":1718,"_5":30548,"_20927":54580,"_27457":54581,"_2948":54582},[],"/docs/platform/overview#build-your-trust-hierarchy","Build your trust hierarchy",{"_3465":1725,"_30219":1718,"_5":30548,"_20927":54584,"_27457":54585,"_2948":54586},[],"/docs/platform/overview#protect-cryptographic-keys","Protect cryptographic keys",{"_3465":1726,"_30219":1718,"_5":30548,"_20927":54588,"_27457":54589,"_2948":54590},[],"/docs/platform/overview#issue-and-control-certificates","Issue and control certificates",{"_3465":1727,"_30219":1718,"_5":30548,"_20927":54592,"_27457":54593,"_2948":54594},[],"/docs/platform/overview#automate-device-identities","Automate device identities",{"_3465":1728,"_30219":1718,"_5":30548,"_20927":54596,"_27457":54597,"_2948":54598},[],"/docs/platform/overview#publish-validation-status","Publish validation status",{"_3465":1729,"_30219":1718,"_5":30548,"_20927":54600,"_27457":54601,"_2948":54602},[],"/docs/platform/overview#react-to-events","React to events",{"_3465":1730,"_30219":1718,"_5":30548,"_20927":54604,"_27457":54605,"_2948":54606},[],"/docs/platform/overview#operational-reference","Operational reference",{"_3465":1731,"_30219":1718,"_20927":54608,"_5":14373,"_27457":1718,"_2948":54609},[],"Lamassu IoT lets you administer a private PKI and use it to issue, renew and revoke X.509 device identities. The Platform documentation follows two paths: **PKI**, for authorities and certificates, and **IoT Fleets**, for applying those identities to a device population.",{"_3465":1732,"_30219":1718,"_20927":54611,"_5":14373,"_27457":54566,"_2948":54612},[],"Choose the result you need:",{"_3465":1733,"_30219":1718,"_20927":54614,"_5":14373,"_27457":54566,"_2948":54615},[],"<Card title=\"Issue and verify a certificate\" description=\"Prepare a CA, issue an X.509 identity and check its chain and key.\" href=\"/docs/platform/pki/quickstarts/overview\" />",{"_3465":1734,"_30219":1718,"_20927":54617,"_5":14373,"_27457":54566,"_2948":54618},[],"<Card title=\"Enroll and connect a device\" description=\"Prepare the DMS, request an identity through EST and check an mTLS connection.\" href=\"/docs/platform/iot-fleets/quickstarts/enroll-device\" />",{"_3465":1735,"_30219":1718,"_20927":54620,"_5":14373,"_27457":54566,"_2948":54621},[],"If you are still preparing the instance, start in Deployment. The Platform paths assume an accessible console and permission to perform the operations.",{"_3465":1736,"_30219":1718,"_20927":54623,"_5":14373,"_27457":54569,"_2948":54624},[],"Section",{"_3465":1737,"_30219":1718,"_20927":54626,"_5":14373,"_27457":54569,"_2948":54627},[],"What you manage",{"_3465":1738,"_30219":1718,"_20927":54629,"_5":14373,"_27457":54569,"_2948":54630},[],"Entry point",{"_3465":1739,"_30219":1718,"_20927":54632,"_5":14373,"_27457":54569,"_2948":54633},[],"**PKI**",{"_3465":1740,"_30219":1718,"_20927":54635,"_5":14373,"_27457":54569,"_2948":54636},[],"Keys, authorities, profiles, certificates and publication of revocation status.",{"_3465":1741,"_30219":1718,"_20927":54638,"_5":14373,"_27457":54569,"_2948":54639},[],"PKI overview",{"_3465":1742,"_30219":1718,"_20927":54641,"_5":14373,"_27457":54569,"_2948":54642},[],"**IoT Fleets**",{"_3465":1743,"_30219":1718,"_20927":54644,"_5":14373,"_27457":54569,"_2948":54645},[],"Devices, identity history, DMS policies, EST enrollment and integrations.",{"_3465":1744,"_30219":1718,"_20927":54647,"_5":14373,"_27457":54569,"_2948":54648},[],"IoT Fleets overview",{"_3465":1745,"_30219":1718,"_20927":54650,"_5":14373,"_27457":54569,"_2948":54651},[],"**Administration**",{"_3465":1746,"_30219":1718,"_20927":54653,"_5":14373,"_27457":54569,"_2948":54654},[],"Operator permissions, audit and event subscriptions.",{"_3465":1747,"_30219":1718,"_20927":54656,"_5":14373,"_27457":54569,"_2948":50727},[],{"_3465":1748,"_30219":1718,"_20927":54658,"_5":14373,"_27457":54569,"_2948":54659},[],"A CA determines who signs, and a profile defines what can be issued. The DMS applies admission and enrollment policy. The device retains its association with certificates, and the external consumer decides which identity it accepts.",{"_3465":1749,"_30219":1718,"_20927":54661,"_5":14373,"_27457":54573,"_2948":54662},[],"An identity's journey connects four responsibilities:",{"_3465":1750,"_30219":1718,"_20927":54664,"_5":14373,"_27457":54573,"_2948":54665},[],"The PKI administrator prepares the authority, its key and issuance rules.",{"_3465":1751,"_30219":1718,"_20927":54667,"_5":14373,"_27457":54573,"_2948":54668},[],"The provisioning administrator configures the DMS and initial trust.",{"_3465":1752,"_30219":1718,"_20927":54670,"_5":14373,"_27457":54573,"_2948":54671},[],"The device client requests a certificate and installs it with the matching key.",{"_3465":1753,"_30219":1718,"_20927":54673,"_5":14373,"_27457":54573,"_2948":54674},[],"The consumer validates the identity and applies its access permissions.",{"_3465":1754,"_30219":1718,"_20927":54676,"_5":14373,"_27457":54573,"_2948":54677},[],"See How Lamassu works to understand the resources and platform architecture for the services. Installation, network exposure and dependencies are explained in Deployment.",{"_3465":1755,"_30219":1718,"_20927":54679,"_5":14373,"_27457":54581,"_2948":54680},[],"Create or incorporate authorities and organize their relationships in PKI. The hierarchy and its rotation determine which chains consumers must recognize.",{"_3465":1756,"_30219":1718,"_20927":54682,"_5":14373,"_27457":54585,"_2948":54683},[],"Choose the engine that keeps authority keys and control who can use them. See Keys and engines; provider setup belongs to deployment.",{"_3465":1757,"_30219":1718,"_20927":54685,"_5":14373,"_27457":54589,"_2948":54686},[],"Define issuance profiles, sign requests and review the certificate inventory. Check the issued certificate from the client that will use it.",{"_3465":1758,"_30219":1718,"_20927":54688,"_5":14373,"_27457":54593,"_2948":54689},[],"Configure a DMS and use EST to request and renew certificates. Preparing the initial credential and installing the result belong to device integration.",{"_3465":1759,"_30219":1718,"_20927":54691,"_5":14373,"_27457":54597,"_2948":54692},[],"Use OCSP and CRL to publish revocation status. Each consumer must configure how it retrieves and applies that information.",{"_3465":1760,"_30219":1718,"_20927":54694,"_5":14373,"_27457":54601,"_2948":54695},[],"Use audit logs to investigate changes and configure alerts and subscriptions to react to lifecycle events.",{"_3465":1761,"_30219":1718,"_20927":54697,"_5":14373,"_27457":54605,"_2948":54140},[],{"_3465":1762,"_30219":1718,"_20927":54699,"_5":14373,"_27457":54605,"_2948":54700},[],"What it prepares or checks",{"_3465":1763,"_30219":1718,"_20927":54702,"_5":14373,"_27457":54605,"_2948":54143},[],{"_3465":1764,"_30219":1718,"_20927":54704,"_5":14373,"_27457":54605,"_2948":54705},[],"Key custody, CA hierarchy, profiles and validation.",{"_3465":1765,"_30219":1718,"_20927":54707,"_5":14373,"_27457":54605,"_2948":54708},[],"Fleet administrator",{"_3465":1766,"_30219":1718,"_20927":54710,"_5":14373,"_27457":54605,"_2948":54711},[],"DMS, device admission, renewal policy and inventory.",{"_3465":1767,"_30219":1718,"_20927":54713,"_5":14373,"_27457":54605,"_2948":54155},[],{"_3465":1768,"_30219":1718,"_20927":54715,"_5":14373,"_27457":54605,"_2948":54716},[],"Initial credential, server trust, EST client, and key and certificate storage.",{"_3465":1769,"_30219":1718,"_20927":54718,"_5":14373,"_27457":54605,"_2948":54161},[],{"_3465":1770,"_30219":1718,"_20927":54720,"_5":14373,"_27457":54605,"_2948":54721},[],"Issuer trust, certificate validation and permissions in the destination.",{"_3465":1771,"_30219":1718,"_20927":54723,"_5":14373,"_27457":54605,"_2948":54724},[],"Infrastructure operator",{"_3465":1772,"_30219":1718,"_20927":54726,"_5":14373,"_27457":54605,"_2948":54727},[],"Installation, network, availability, dependencies and deployment diagnosis.",{"_3465":1773,"_30219":1718,"_20927":54729,"_5":14373,"_27457":54605,"_2948":54730},[],"The API reference contains contracts for automating operations. To investigate a failure, start in the affected section: PKI, EST or Deployment.",{"_3465":1774,"_30219":1774,"_5":14725,"_2948":54732,"_30551":54733,"_20927":54736,"_27457":1774},"CA hierarchy and rotation",[49254,50729,54734,54735],"PKI","Keys, authorities and certificates",[],{"_3465":1775,"_30219":1774,"_20927":54738,"_5":14373,"_27457":1774,"_2948":54739},[],"Design root and intermediate authorities and replace certificates or keys without breaking trust.",{"_3465":1776,"_30219":1774,"_5":30548,"_20927":54741,"_27457":54742,"_2948":54743},[],"/docs/platform/pki/ca-hierarchy-and-rotation#design-the-hierarchy","Design the hierarchy",{"_3465":1777,"_30219":1774,"_5":30548,"_20927":54745,"_27457":54746,"_2948":54747},[],"/docs/platform/pki/ca-hierarchy-and-rotation#reissuance-and-rotation-are-not-the-same","Reissuance and rotation are not the same",{"_3465":1778,"_30219":1774,"_5":30548,"_20927":54749,"_27457":54750,"_2948":54751},[],"/docs/platform/pki/ca-hierarchy-and-rotation#when-to-choose-each-operation","When to choose each operation",{"_3465":1779,"_30219":1774,"_5":30548,"_20927":54753,"_27457":54754,"_2948":54755},[],"/docs/platform/pki/ca-hierarchy-and-rotation#key-rotation-procedure","Key rotation procedure",{"_3465":1780,"_30219":1774,"_5":30548,"_20927":54757,"_27457":54758,"_2948":54759},[],"/docs/platform/pki/ca-hierarchy-and-rotation#inventory-the-dependencies","Inventory the dependencies",{"_3465":1781,"_30219":1774,"_5":30548,"_20927":54761,"_27457":54762,"_2948":54763},[],"/docs/platform/pki/ca-hierarchy-and-rotation#create-the-successor-ca","Create the successor CA",{"_3465":1782,"_30219":1774,"_5":30548,"_20927":54765,"_27457":54766,"_2948":54767},[],"/docs/platform/pki/ca-hierarchy-and-rotation#distribute-the-new-trust","Distribute the new trust",{"_3465":1783,"_30219":1774,"_5":30548,"_20927":54769,"_27457":54770,"_2948":54771},[],"/docs/platform/pki/ca-hierarchy-and-rotation#switch-issuance","Switch issuance",{"_3465":1784,"_30219":1774,"_5":30548,"_20927":54773,"_27457":54774,"_2948":54775},[],"/docs/platform/pki/ca-hierarchy-and-rotation#renew-in-batches","Renew in batches",{"_3465":1785,"_30219":1774,"_5":30548,"_20927":54777,"_27457":54778,"_2948":54779},[],"/docs/platform/pki/ca-hierarchy-and-rotation#close-the-overlap","Close the overlap",{"_3465":1786,"_30219":1774,"_5":30548,"_20927":54781,"_27457":54782,"_2948":54783},[],"/docs/platform/pki/ca-hierarchy-and-rotation#cascading-revocation","Cascading revocation",{"_3465":1787,"_30219":1774,"_5":30548,"_20927":54785,"_27457":54786,"_2948":54787},[],"/docs/platform/pki/ca-hierarchy-and-rotation#checks-after-the-change","Checks after the change",{"_3465":1788,"_30219":1774,"_20927":54789,"_5":14373,"_27457":1774,"_2948":54790},[],"The hierarchy determines the blast radius of any error or compromise. A root signs intermediate CAs; intermediates issue the identities used by devices and services. This separation lets you isolate environments and rotate a branch without replacing all trust.",{"_3465":1789,"_30219":1774,"_20927":54792,"_5":14373,"_27457":1774,"_2948":54793},[],"This procedure is for the PKI operator replacing an authority in use. You need access to CAs, keys and profiles, a dependency inventory and coordination with trust-store and device owners. Before switching issuance, prepare a test cohort and decide the criterion for ending overlap.",{"_3465":1790,"_30219":1774,"_20927":54795,"_5":14373,"_27457":54742,"_2948":54796},[],"For a production installation, use a very restricted root and one or more operational intermediates. Separate intermediates when any of these boundaries change:",{"_3465":1791,"_30219":1774,"_20927":54798,"_5":14373,"_27457":54742,"_2948":54799},[],"environment, such as production and preproduction;",{"_3465":1792,"_30219":1774,"_20927":54801,"_5":14373,"_27457":54742,"_2948":54802},[],"owner or operating team;",{"_3465":1793,"_30219":1774,"_20927":54804,"_5":14373,"_27457":54742,"_2948":54805},[],"device family or manufacturing process;",{"_3465":1794,"_30219":1774,"_20927":54807,"_5":14373,"_27457":54742,"_2948":54808},[],"region or regulatory requirement;",{"_3465":1795,"_30219":1774,"_20927":54810,"_5":14373,"_27457":54742,"_2948":54811},[],"cryptographic engine or key policy;",{"_3465":1796,"_30219":1774,"_20927":54813,"_5":14373,"_27457":54742,"_2948":54814},[],"maintenance window and renewal cadence.",{"_3465":1797,"_30219":1774,"_20927":54816,"_5":14373,"_27457":54742,"_2948":54817},[],"Avoid deep hierarchies without a concrete need. Each level adds chain distribution, validation and one more certificate you must renew.",{"_3465":1798,"_30219":1774,"_20927":54819,"_5":14373,"_27457":54742,"_2948":54820},[],"A child CA and its end-entity certificates must expire before their issuer. Reserve a margin that allows distributing another chain and renewing dependent certificates.",{"_3465":1799,"_30219":1774,"_20927":54822,"_5":14373,"_27457":54746,"_2948":54823},[],"**Reissuing a CA** creates a new certificate over the existing key. Lamassu generates a CSR with that key, self-signs it if it is a root or asks the parent CA to sign it if it is subordinate. The new certificate becomes active and the CA points to its serial number; the old and new certificates are linked through metadata.",{"_3465":1800,"_30219":1774,"_20927":54825,"_5":14373,"_27457":54746,"_2948":54826},[],"If the CRL settings of the CA are signed by the superseded CA certificate, reissuing moves the signer to the new certificate — provided it carries `cRLSign` — and republishes the CRL. Otherwise, and for settings signed by a different certificate, the signer is kept, so check the new certificate’s key usage after reissuing; see the CRL guide.",{"_3465":1801,"_30219":1774,"_20927":54828,"_5":14373,"_27457":54746,"_2948":54829},[],"**Rotating a CA** creates a successor key and authority. It is the right choice in the face of compromise, a cryptographic change, an engine migration or non-exportable key policies.",{"_3465":1802,"_30219":1774,"_20927":54831,"_5":14373,"_27457":54746,"_2948":54832},[],"Lamassu does not allow reissuing an already-revoked CA or a CA whose expiration date has passed. Plan ahead for both conditions.",{"_3465":1803,"_30219":1774,"_20927":54834,"_5":14373,"_27457":54750,"_2948":54835},[],"Reissue if the key is still trustworthy and you only need another validity period or an updated certificate.",{"_3465":1804,"_30219":1774,"_20927":54837,"_5":14373,"_27457":54750,"_2948":54838},[],"Rotate the key if compromise is suspected, the algorithm changes or you want to move custody to another engine.",{"_3465":1805,"_30219":1774,"_20927":54840,"_5":14373,"_27457":54750,"_2948":54841},[],"Create a parallel branch if you cannot update all consumers at the same time.",{"_3465":1806,"_30219":1774,"_20927":54843,"_5":14373,"_27457":54750,"_2948":54844},[],"Revoke immediately only when the risk of keeping the CA outweighs the impact of interrupting the fleet.",{"_3465":1807,"_30219":1774,"_20927":54846,"_5":14373,"_27457":54758,"_2948":54847},[],"Locate child CAs, issued certificates, DMSs, connectors and external trust stores. Include devices that may stay offline for weeks or months.",{"_3465":1808,"_30219":1774,"_20927":54849,"_5":14373,"_27457":54762,"_2948":54850},[],"Generate a new key in the planned engine, create the CA and assign it an explicit profile. Do not reuse the operational identifier to hide that it is a different generation.",{"_3465":1809,"_30219":1774,"_20927":54852,"_5":14373,"_27457":54766,"_2948":54853},[],"Add the new root or chain to consumers before issuing with it. If distributing through EST `/cacerts`, explicitly include the required managed CAs and inspect the content; including the issuer does not automatically include every intermediate. Install the new trust in a cohort and verify that it still accepts the previous identity.",{"_3465":1810,"_30219":1774,"_20927":54855,"_5":14373,"_27457":54770,"_2948":54856},[],"Update the enrollment CA and profile of the DMSs. While old-CA cohorts still renew, add the previous enrollment CA to each DMS's re-enrollment validation CAs (`reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`): the new enrollment CA is trusted automatically, but the old one was the enrollment CA and appears in no re-enrollment trust list, so without that entry its certificates can no longer renew. The DMS guide documents the setting.",{"_3465":1811,"_30219":1774,"_20927":54858,"_5":14373,"_27457":54774,"_2948":54859},[],"Migrate a small cohort, validate mTLS, OCSP and CRL from the consumer and expand progressively. Monitor which devices still present the old chain.",{"_3465":1812,"_30219":1774,"_20927":54861,"_5":14373,"_27457":54778,"_2948":54862},[],"Once no legitimate consumer depends on the previous authority, remove it from issuance, from the re-enrollment validation CAs and from the distributed CAs. Revoke it if policy requires it.",{"_3465":1813,"_30219":1774,"_20927":54864,"_5":14373,"_27457":54782,"_2948":54865},[],"Lamassu saves the CA’s revocation, then attempts to revoke child CAs and issued certificates with `CessationOfOperation`. Propagation continues recursively through child CAs. This is not a transaction over the whole hierarchy: some resources may have changed while other updates failed.",{"_3465":1814,"_30219":1774,"_20927":54867,"_5":14373,"_27457":54782,"_2948":54868},[],"Resources in `EXPIRED` state and resources already revoked for a final reason reject further status transitions. Per-descendant failures are logged; review the inventory and logs even when the parent operation completes.",{"_3465":1815,"_30219":1774,"_20927":54870,"_5":14373,"_27457":54782,"_2948":54871},[],"`CertificateHold` allows reactivating the parent while it is not expired, but does not restore child CAs or certificates permanently revoked during the cascade. Holding a CA therefore does not provide a reversible pause for its entire branch.",{"_3465":1816,"_30219":1774,"_20927":54873,"_5":14373,"_27457":54782,"_2948":54874},[],"Before closing the change, compare the original dependency inventory with final states and verify revocation publication for each issuer. Do not use revocation as the ordinary mechanism to stop issuance: complete migration and remove the CA from operational flows.",{"_3465":1817,"_30219":1774,"_20927":54876,"_5":14373,"_27457":54786,"_2948":54877},[],"The new chain ends in an anchor installed by the consumer.",{"_3465":1818,"_30219":1774,"_20927":54879,"_5":14373,"_27457":54786,"_2948":54880},[],"New certificates contain the expected AKI, SKI, KU, EKU and SAN.",{"_3465":1819,"_30219":1774,"_20927":54882,"_5":14373,"_27457":54786,"_2948":54883},[],"The DMS delivers the correct chain through EST `/cacerts`.",{"_3465":1820,"_30219":1774,"_20927":54885,"_5":14373,"_27457":54786,"_2948":54886},[],"Re-enrollment accepts the old identity during the planned period.",{"_3465":1821,"_30219":1774,"_20927":54888,"_5":14373,"_27457":54786,"_2948":54889},[],"OCSP and CRL respond for the authorities that remain active.",{"_3465":1822,"_30219":1774,"_20927":54891,"_5":14373,"_27457":54786,"_2948":54892},[],"No DMS is left accidentally issuing from the old CA.",{"_3465":1823,"_30219":1774,"_20927":54894,"_5":14373,"_27457":54786,"_2948":54895},[],"See the Trust model to understand the DMS's CA sets and Certificate lifecycle for states and revocation effects.",{"_3465":1824,"_30219":1824,"_5":14725,"_2948":54897,"_30551":54898,"_20927":54899,"_27457":1824},"Certification authorities",[49254,50729,54734,54735],[],{"_3465":1825,"_30219":1824,"_20927":54901,"_5":14373,"_27457":1824,"_2948":54902},[],"Create, import and operate the authorities that establish your PKI's trust.",{"_3465":1826,"_30219":1824,"_5":30548,"_20927":54904,"_27457":54905,"_2948":54906},[],"/docs/platform/pki/certificate-authorities#choose-a-flow","Choose a flow",{"_3465":1827,"_30219":1824,"_5":30548,"_20927":54908,"_27457":54909,"_2948":54910},[],"/docs/platform/pki/certificate-authorities#create-a-new-authority","Create a new authority",{"_3465":1828,"_30219":1824,"_5":30548,"_20927":54912,"_27457":54913,"_2948":49264},[],"/docs/platform/pki/certificate-authorities#before-you-begin",{"_3465":1829,"_30219":1824,"_5":30548,"_20927":54915,"_27457":54916,"_2948":54917},[],"/docs/platform/pki/certificate-authorities#open-the-wizard","Open the wizard",{"_3465":1830,"_30219":1824,"_5":30548,"_20927":54919,"_27457":54920,"_2948":54921},[],"/docs/platform/pki/certificate-authorities#configure-the-key","Configure the key",{"_3465":1831,"_30219":1824,"_5":30548,"_20927":54923,"_27457":54924,"_2948":54925},[],"/docs/platform/pki/certificate-authorities#choose-the-ca-type","Choose the CA type",{"_3465":1832,"_30219":1824,"_5":30548,"_20927":54927,"_27457":54928,"_2948":54929},[],"/docs/platform/pki/certificate-authorities#define-the-identity","Define the identity",{"_3465":1833,"_30219":1824,"_5":30548,"_20927":54931,"_27457":54932,"_2948":54933},[],"/docs/platform/pki/certificate-authorities#configure-validity-and-uses","Configure validity and uses",{"_3465":1834,"_30219":1824,"_5":30548,"_20927":54935,"_27457":54936,"_2948":54937},[],"/docs/platform/pki/certificate-authorities#create-and-verify","Create and verify",{"_3465":1835,"_30219":1824,"_5":30548,"_20927":54939,"_27457":54940,"_2948":54941},[],"/docs/platform/pki/certificate-authorities#use-a-key-from-the-kms","Use a key from the KMS",{"_3465":1836,"_30219":1824,"_5":30548,"_20927":54943,"_27457":54944,"_2948":54945},[],"/docs/platform/pki/certificate-authorities#import-an-external-ca","Import an external CA",{"_3465":1837,"_30219":1824,"_5":30548,"_20927":54947,"_27457":54948,"_2948":54949},[],"/docs/platform/pki/certificate-authorities#select-the-engine","Select the engine",{"_3465":1838,"_30219":1824,"_5":30548,"_20927":54951,"_27457":54952,"_2948":54953},[],"/docs/platform/pki/certificate-authorities#load-the-material","Load the material",{"_3465":1839,"_30219":1824,"_5":30548,"_20927":54955,"_27457":54956,"_2948":54957},[],"/docs/platform/pki/certificate-authorities#define-the-default-issuance","Define the default issuance",{"_3465":1840,"_30219":1824,"_5":30548,"_20927":54959,"_27457":54960,"_2948":54961},[],"/docs/platform/pki/certificate-authorities#verify-the-import","Verify the import",{"_3465":1841,"_30219":1824,"_5":30548,"_20927":54963,"_27457":54964,"_2948":54965},[],"/docs/platform/pki/certificate-authorities#inspect-an-authority","Inspect an authority",{"_3465":1842,"_30219":1824,"_5":30548,"_20927":54967,"_27457":54968,"_2948":54969},[],"/docs/platform/pki/certificate-authorities#issue-certificates","Issue certificates",{"_3465":1843,"_30219":1824,"_5":30548,"_20927":54971,"_27457":54972,"_2948":54973},[],"/docs/platform/pki/certificate-authorities#revoke-a-ca","Revoke a CA",{"_3465":1844,"_30219":1824,"_5":30548,"_20927":54975,"_27457":54976,"_2948":54977},[],"/docs/platform/pki/certificate-authorities#assess-the-impact","Assess the impact",{"_3465":1845,"_30219":1824,"_5":30548,"_20927":54979,"_27457":54980,"_2948":54981},[],"/docs/platform/pki/certificate-authorities#start-the-revocation","Start the revocation",{"_3465":1846,"_30219":1824,"_5":30548,"_20927":54983,"_27457":54984,"_2948":54985},[],"/docs/platform/pki/certificate-authorities#confirm-the-identity","Confirm the identity",{"_3465":1847,"_30219":1824,"_5":30548,"_20927":54987,"_27457":54988,"_2948":54989},[],"/docs/platform/pki/certificate-authorities#check-the-publication","Check the publication",{"_3465":1848,"_30219":1824,"_5":30548,"_20927":54991,"_27457":54992,"_2948":54993},[],"/docs/platform/pki/certificate-authorities#delete-a-ca","Delete a CA",{"_3465":1849,"_30219":1824,"_20927":54995,"_5":14373,"_27457":1824,"_2948":54996},[],"A certification authority (CA) binds identities to public keys through signed certificates. In Lamassu you can create a new hierarchy, use a key already in the KMS or incorporate an external CA.",{"_3465":1850,"_30219":1824,"_20927":54998,"_5":14373,"_27457":1824,"_2948":54999},[],"To design a full chain or replace an authority in production, see CA hierarchy and rotation. If you need to standardize what each authority can sign, use Certificate profiles.",{"_3465":1851,"_30219":1824,"_20927":55001,"_5":14373,"_27457":1824,"_2948":55002},[],"To administer CAs, you need authority and key permissions, a reachable engine and a reviewed profile. An external consumer does not trust a CA merely because it appears in this inventory: agree root and chain distribution separately.",{"_3465":1852,"_30219":1824,"_20927":55004,"_5":14373,"_27457":54905,"_2948":55005},[],"**New CA with a new key:** create a root of trust from scratch. Lamassu generates and keeps the key pair.",{"_3465":1853,"_30219":1824,"_20927":55007,"_5":14373,"_27457":54905,"_2948":55008},[],"**New CA from the KMS:** reuse a key already registered in the platform.",{"_3465":1854,"_30219":1824,"_20927":55010,"_5":14373,"_27457":54905,"_2948":55011},[],"**Import a CA with its private key:** incorporate an external authority that Lamassu can issue with.",{"_3465":1855,"_30219":1824,"_20927":55013,"_5":14373,"_27457":54905,"_2948":55014},[],"**Import only the certificate:** register public material. If Lamassu finds its key in the KMS, it can associate it; otherwise, the CA has no usable key for issuance.",{"_3465":1856,"_30219":1824,"_20927":55016,"_5":14373,"_27457":54905,"_2948":55017},[],"First time here? Follow Create your first CA to complete the minimal journey.",{"_3465":1857,"_30219":1824,"_20927":55019,"_5":14373,"_27457":54913,"_2948":55020},[],"Decide whether the CA will be a root or an intermediate.",{"_3465":1858,"_30219":1824,"_20927":55022,"_5":14373,"_27457":54913,"_2948":55023},[],"Choose the engine that will keep the key.",{"_3465":1859,"_30219":1824,"_20927":55025,"_5":14373,"_27457":54913,"_2948":55026},[],"Define a validity longer than that of the certificates it will issue.",{"_3465":1860,"_30219":1824,"_20927":55028,"_5":14373,"_27457":54913,"_2948":55029},[],"For an intermediate CA, make sure the parent CA is active.",{"_3465":1861,"_30219":1824,"_20927":55031,"_5":14373,"_27457":54916,"_2948":55032},[],"In **Certification Authorities**, select **Create New CA** and choose to generate a new key pair.",{"_3465":1862,"_30219":1824,"_20927":55034,"_5":14373,"_27457":54920,"_2948":55035},[],"Select the cryptographic engine, the algorithm and the size or curve. Lamassu supports RSA and EC keys according to the engine's capabilities.",{"_3465":1863,"_30219":1824,"_20927":55037,"_5":14373,"_27457":54920,"_2948":55038},[],"Use only sizes and curves supported by the engine and the profile’s cryptographic policy. Read Keys and engines before reusing external material.",{"_3465":1864,"_30219":1824,"_20927":55040,"_5":14373,"_27457":54924,"_2948":55041},[],"Select **Root CA** for a self-signed authority or **Intermediate CA** for an authority signed by another CA. In the latter case, choose the issuing CA.",{"_3465":1865,"_30219":1824,"_20927":55043,"_5":14373,"_27457":54928,"_2948":55044},[],"Enter a unique **CA Name**. This name becomes the certificate's `Common Name`. Complete the Distinguished Name fields your policy requires:",{"_3465":1866,"_30219":1824,"_20927":55046,"_5":14373,"_27457":54928,"_2948":55047},[],"`C`: two-letter ISO 3166-1 country code.",{"_3465":1867,"_30219":1824,"_20927":55049,"_5":14373,"_27457":54928,"_2948":55050},[],"`ST`: state or province.",{"_3465":1868,"_30219":1824,"_20927":55052,"_5":14373,"_27457":54928,"_2948":55053},[],"`L`: locality.",{"_3465":1869,"_30219":1824,"_20927":55055,"_5":14373,"_27457":54928,"_2948":55056},[],"`O`: organization.",{"_3465":1870,"_30219":1824,"_20927":55058,"_5":14373,"_27457":54928,"_2948":55059},[],"`OU`: organizational unit.",{"_3465":1871,"_30219":1824,"_20927":55061,"_5":14373,"_27457":54928,"_2948":55062},[],"The CA's internal identifier is generated automatically and cannot be changed.",{"_3465":1872,"_30219":1824,"_20927":55064,"_5":14373,"_27457":54932,"_2948":55065},[],"Define **CA Certificate Expiration** and **Default End-Entity Certificate Issuance Expiration**. You can express a duration (`5y 8w 4d`), pick a date or use the maximum allowed date.",{"_3465":1873,"_30219":1824,"_20927":55067,"_5":14373,"_27457":54932,"_2948":55068},[],"Review the CA’s own certificate separately from the default profile for certificates it will issue later. Choose an explicit issuance policy; do not assume the form’s initial values suit your consumers.",{"_3465":1874,"_30219":1824,"_20927":55070,"_5":14373,"_27457":54936,"_2948":55071},[],"Confirm the form and open the CA. Check status, issuer, dates, associated engine and key. Download the certificate: it should contain `CA:TRUE` and a usage permitting certificate signing. Verify the self-signature for a root or the chain to your root for an intermediate. Complete a test issuance to check that the key can actually sign.",{"_3465":1875,"_30219":1824,"_20927":55073,"_5":14373,"_27457":54936,"_2948":55074},[],"Plan and verify expiration using the Profiles rules. Issuance does not automatically clamp validity to the issuer’s expiration; leave time to replace the authority and renew identities.",{"_3465":1876,"_30219":1824,"_20927":55076,"_5":14373,"_27457":54940,"_2948":55077},[],"Select &#x2A;*Create New CA (Existing Key)** when the key is already registered in Lamassu. The wizard first asks for the backing key and then shows the same configuration of type, identity, validity and profile.",{"_3465":1877,"_30219":1824,"_20927":55079,"_5":14373,"_27457":54940,"_2948":55080},[],"This flow is useful when the key was previously created in an HSM, imported through BYOK or must be reused under a specific custody policy.",{"_3465":1878,"_30219":1824,"_20927":55082,"_5":14373,"_27457":54944,"_2948":55083},[],"You need the CA certificate in PEM, its chain to a known root and, when importing it, an exportable private key. Before uploading material, verify signature, dates, `CA:TRUE`, signing usages (including `cRLSign`, without which the CA cannot publish its CRL) and public-key correspondence. The key verification procedure also compares a CA key and certificate.",{"_3465":1879,"_30219":1824,"_20927":55085,"_5":14373,"_27457":54944,"_2948":55086},[],"The backend rejects an import whose certificate lacks the CA basic constraint (`basicConstraints cA flag is not set`), whose serial number matches a stored certificate with different contents, or whose identical certificate already belongs to an existing CA. A deleted CA's certificate record is kept and can be reused when re-importing the same certificate, including its previous status. Re-importing a different certificate with that serial number is rejected; check the certificate and status after re-importing.",{"_3465":1880,"_30219":1824,"_20927":55088,"_5":14373,"_27457":54944,"_2948":55089},[],"Deleting a CA releases the key references of its own current certificate and linked reissued certificates, while keeping those records for its issuer's CRL and OCSP. It then attempts to delete the key; the KMS keeps it if other certificates still reference it, such as another CA sharing the key. Revoking certificates issued by the deleted CA does not release their own key references.",{"_3465":1881,"_30219":1824,"_20927":55091,"_5":14373,"_27457":54948,"_2948":55092},[],"Check the installation’s default engine before importing a CA with a key. CA import delegates key import to that engine; it does not guarantee arbitrary provider selection from the form. To select an engine while importing the key separately, use the KMS.",{"_3465":1882,"_30219":1824,"_20927":55094,"_5":14373,"_27457":54952,"_2948":55095},[],"Import the certificate and, when applicable, its PEM key. Register the CAs needed to identify the issuer. Registering a CA does not install it in external trust stores.",{"_3465":1883,"_30219":1824,"_20927":55097,"_5":14373,"_27457":54952,"_2948":55098},[],"The backend validates before importing any key: a duplicate CA ID and a certificate that is not a CA (missing `basicConstraints` `cA=TRUE`) are rejected, the latter with `400` `certificate is not a CA: basicConstraints cA flag is not set`. If a failure occurs after the key was imported, the key is kept in the KMS and a warning tells you to delete it manually.",{"_3465":1884,"_30219":1824,"_20927":55100,"_5":14373,"_27457":54956,"_2948":55101},[],"Associate an explicit issuance profile if the CA will sign. Check usages and dates using Profiles.",{"_3465":1885,"_30219":1824,"_20927":55103,"_5":14373,"_27457":54960,"_2948":55104},[],"Review the registered type, associated key and engine, and issuer relationship. Certificate-only import may associate an existing KMS key using the certificate’s key identifier. Without a usable key, the CA is public material and cannot sign.",{"_3465":1886,"_30219":1824,"_20927":55106,"_5":14373,"_27457":54960,"_2948":55107},[],"For an issuing CA, complete a test issuance and check OCSP and CRL. Creating the record alone does not establish key availability, complete chain consistency or status publication.",{"_3465":1887,"_30219":1824,"_20927":55109,"_5":14373,"_27457":54964,"_2948":55110},[],"Open a CA from the inventory to review:",{"_3465":1888,"_30219":1824,"_20927":55112,"_5":14373,"_27457":54964,"_2948":55113},[],"Status and validity period.",{"_3465":1889,"_30219":1824,"_20927":55115,"_5":14373,"_27457":54964,"_2948":55116},[],"Certificate and chain in PEM format.",{"_3465":1890,"_30219":1824,"_20927":55118,"_5":14373,"_27457":54964,"_2948":55119},[],"Number of active, expired and revoked certificates.",{"_3465":1891,"_30219":1824,"_20927":55121,"_5":14373,"_27457":54964,"_2948":55122},[],"Certificates issued in **Issued Certificates**.",{"_3465":1892,"_30219":1824,"_20927":55124,"_5":14373,"_27457":54964,"_2948":55125},[],"The CRL linked to the authority.",{"_3465":1893,"_30219":1824,"_20927":55127,"_5":14373,"_27457":54964,"_2948":55128},[],"Metadata and the associated cryptographic engine.",{"_3465":1894,"_30219":1824,"_20927":55130,"_5":14373,"_27457":54964,"_2948":55131},[],"You can filter the inventory by name, status and CA type.",{"_3465":1895,"_30219":1824,"_20927":55133,"_5":14373,"_27457":54968,"_2948":55134},[],"You can start an issuance from **Issued Certificates**, from a CA's action menu or from the global certificate inventory.",{"_3465":1896,"_30219":1824,"_20927":55136,"_5":14373,"_27457":54968,"_2948":55137},[],"**Generate Key & CSR in Browser** is useful for a manual operation or a quick test. The browser generates the key and you must download it at the end.",{"_3465":1897,"_30219":1824,"_20927":55139,"_5":14373,"_27457":54968,"_2948":55140},[],"**Upload Existing CSR** is the right option when the key must remain on the target system. Lamassu receives the request but never the private key.",{"_3465":1898,"_30219":1824,"_20927":55142,"_5":14373,"_27457":54968,"_2948":55143},[],"Follow Issue your first certificate for the guided flow. Certificate management explains the inventory, inspection and revocation.",{"_3465":1899,"_30219":1824,"_20927":55145,"_5":14373,"_27457":54972,"_2948":55146},[],"Revoking a CA prevents issuance and may interrupt its entire branch. Only `CertificateHold` allows reactivating the CA itself if it is not expired. Descendant revocation is attempted with `CessationOfOperation`; reactivating the parent does not restore those descendants. Follow the cascading revocation conditions.",{"_3465":1900,"_30219":1824,"_20927":55148,"_5":14373,"_27457":54976,"_2948":55149},[],"Identify the certificates, devices and consumers that depend on the CA. Prepare a replacement authority and chain when necessary.",{"_3465":1901,"_30219":1824,"_20927":55151,"_5":14373,"_27457":54980,"_2948":55152},[],"Open the authority and select **Revoke CA**. Choose the reason that describes the incident, for example `KeyCompromise`, `CACompromise`, `Superseded` or `CessationOfOperation`.",{"_3465":1902,"_30219":1824,"_20927":55154,"_5":14373,"_27457":54984,"_2948":55155},[],"Type the CA's name exactly to enable **Confirm Revocation**.",{"_3465":1903,"_30219":1824,"_20927":55157,"_5":14373,"_27457":54988,"_2948":55158},[],"Check **REVOKED** on the CA and review descendants individually; propagation permits partial failures. Independently verify OCSP and CRL publication and consumer rejection. A revoked record does not guarantee that an existing session closes.",{"_3465":1904,"_30219":1824,"_20927":55160,"_5":14373,"_27457":54992,"_2948":55161},[],"Permanent deletion is only available with the CA revoked or expired; a CA imported without a key can be deleted in any state. Delete the record only when your retention and audit policy allows it.",{"_3465":1905,"_30219":1824,"_20927":55163,"_5":14373,"_27457":54992,"_2948":55164},[],"The CA’s CRL settings are kept, and they cannot be removed through the API. The last CRL keeps being served but is never regenerated once the CA is gone, so adjust its validity and signer beforehand (see CRL). The CA’s key is released, but the KMS keeps it while other certificates still reference it.",{"_3465":1906,"_30219":1824,"_20927":55166,"_5":14373,"_27457":54992,"_2948":55167},[],"Lamassu keeps the certificate record of a deleted CA. If that same certificate is imported again, the import succeeds and reuses the record: it updates the type, issuer and key but keeps the status, so the CA reappears in the state it had when deleted (normally revoked or expired). A different certificate with the same serial number is rejected with a 400 error, and a certificate that already belongs to an existing CA with a 409 error. To avoid inheriting the previous status, use a certificate with a different serial number and check the result after importing. The reimported CA is registered under a new, backend-generated CA ID and does not inherit the CRL settings of the deleted CA: those keep serving their last CRL at the CA ID URL, and at `/crl/<ski>` — the URL that certificates issued before the 4.0.0 upgrade carry — when the settings were migrated by that upgrade; when they are archived, they can no longer be edited (see CRL).",{"_3465":1907,"_30219":1907,"_5":14725,"_2948":55169,"_30551":55170,"_20927":55171,"_27457":1907},"Certificate profiles",[49254,50729,54734,54735],[],{"_3465":1908,"_30219":1907,"_20927":55173,"_5":14373,"_27457":1907,"_2948":55174},[],"Define reusable policies to issue consistent certificates and constrain accepted keys.",{"_3465":1909,"_30219":1907,"_5":30548,"_20927":55176,"_27457":55177,"_2948":55178},[],"/docs/platform/pki/certificate-profiles#what-a-profile-controls","What a profile controls",{"_3465":1910,"_30219":1907,"_5":30548,"_20927":55180,"_27457":55181,"_2948":55182},[],"/docs/platform/pki/certificate-profiles#validity","Validity",{"_3465":1911,"_30219":1907,"_5":30548,"_20927":55184,"_27457":55185,"_2948":55186},[],"/docs/platform/pki/certificate-profiles#ca-certificate-or-end-entity-certificate","CA certificate or end-entity certificate",{"_3465":1912,"_30219":1907,"_5":30548,"_20927":55188,"_27457":55189,"_2948":55190},[],"/docs/platform/pki/certificate-profiles#key-usage-and-extended-key-usage","Key Usage and Extended Key Usage",{"_3465":1913,"_30219":1907,"_5":30548,"_20927":55192,"_27457":55193,"_2948":55194},[],"/docs/platform/pki/certificate-profiles#subject","Subject",{"_3465":1914,"_30219":1907,"_5":30548,"_20927":55196,"_27457":55197,"_2948":55198},[],"/docs/platform/pki/certificate-profiles#csr-extensions","CSR extensions",{"_3465":1915,"_30219":1907,"_5":30548,"_20927":55200,"_27457":55201,"_2948":55202},[],"/docs/platform/pki/certificate-profiles#cryptographic-constraints","Cryptographic constraints",{"_3465":1916,"_30219":1907,"_5":30548,"_20927":55204,"_27457":55205,"_2948":55206},[],"/docs/platform/pki/certificate-profiles#profile-precedence","Profile precedence",{"_3465":1917,"_30219":1907,"_5":30548,"_20927":55208,"_27457":55209,"_2948":55210},[],"/docs/platform/pki/certificate-profiles#create-a-profile","Create a profile",{"_3465":1918,"_30219":1907,"_5":30548,"_20927":55212,"_27457":55213,"_2948":55214},[],"/docs/platform/pki/certificate-profiles#define-a-single-purpose","Define a single purpose",{"_3465":1919,"_30219":1907,"_5":30548,"_20927":55216,"_27457":55217,"_2948":55218},[],"/docs/platform/pki/certificate-profiles#choose-the-validity","Choose the validity",{"_3465":1920,"_30219":1907,"_5":30548,"_20927":55220,"_27457":55221,"_2948":55222},[],"/docs/platform/pki/certificate-profiles#fix-usages-and-subject","Fix usages and subject",{"_3465":1921,"_30219":1907,"_5":30548,"_20927":55224,"_27457":55225,"_2948":55226},[],"/docs/platform/pki/certificate-profiles#constrain-the-keys","Constrain the keys",{"_3465":1922,"_30219":1907,"_5":30548,"_20927":55228,"_27457":55229,"_2948":55230},[],"/docs/platform/pki/certificate-profiles#attach-it-and-test","Attach it and test",{"_3465":1923,"_30219":1907,"_5":30548,"_20927":55232,"_27457":55233,"_2948":55234},[],"/docs/platform/pki/certificate-profiles#design-examples","Design examples",{"_3465":1924,"_30219":1907,"_5":30548,"_20927":55236,"_27457":55237,"_2948":55238},[],"/docs/platform/pki/certificate-profiles#changes-and-deletion","Changes and deletion",{"_3465":1925,"_30219":1907,"_20927":55240,"_5":14373,"_27457":1907,"_2948":55241},[],"An issuance profile turns a certificate policy into reusable configuration. Instead of deciding validity, subject, extensions and algorithms on every request, you define once what is allowed and attach the profile to a CA, a DMS or a specific issuance.",{"_3465":1926,"_30219":1907,"_20927":55243,"_5":14373,"_27457":1907,"_2948":55244},[],"This guide is for the PKI administrator defining issuance policy. You need permissions to manage profiles and associate them with the intended CA or DMS, plus a test consumer with known identity and purpose requirements.",{"_3465":1927,"_30219":1907,"_20927":55246,"_5":14373,"_27457":55181,"_2948":55247},[],"You can express the lifetime as a duration from the moment of issuance or as a fixed end date. A duration works well for recurring identities; a common date is useful to make a whole batch end before a migration or retirement.",{"_3465":1928,"_30219":1907,"_20927":55249,"_5":14373,"_27457":55181,"_2948":55250},[],"Plan the end date within the issuing CA’s validity and leave a renewal margin. The signer calculates the date from the profile; it does not automatically clamp validity to the issuer’s expiration. Check both dates in the resulting certificate. A fixed date in the past does not produce a usable identity either.",{"_3465":1929,"_30219":1907,"_20927":55252,"_5":14373,"_27457":55185,"_2948":55253},[],"`Sign as CA` sets `IsCA` and the basic constraints needed for an authority. Lamassu enforces this: a profile with `Sign as CA` is consumed only when creating or reissuing a CA. Any signing request that resolves to such a profile is rejected — direct signing with a CA, including certificate issuance requests on it, and DMS enrollment or re-enrollment. Nothing validates the profile when it is saved: if a CA's default profile or a DMS profile has `Sign as CA` enabled, the problem appears on the first signing request that resolves to it — for a DMS profile, when a device tries to enroll or re-enroll — and renewal stays blocked until the profile is changed.",{"_3465":1930,"_30219":1907,"_20927":55255,"_5":14373,"_27457":55189,"_2948":55256},[],"The profile can enforce usages such as `DigitalSignature`, `KeyEncipherment`, `CertSign`, `CRLSign`, `ClientAuth`, `ServerAuth` or `OCSPSigning`.",{"_3465":1931,"_30219":1907,"_20927":55258,"_5":14373,"_27457":55189,"_2948":55259},[],"If you enable **Honor Key Usage** or **Honor Extended Key Usages**, Lamassu keeps the values requested by the CSR. If you disable them, it replaces them with the ones defined in the profile.",{"_3465":1932,"_30219":1907,"_20927":55261,"_5":14373,"_27457":55189,"_2948":55262},[],"Do not enable the `Honor…` options for untrusted requests unless another component validates those fields. Otherwise, the requester may choose broader capabilities than intended.",{"_3465":1933,"_30219":1907,"_20927":55264,"_5":14373,"_27457":55193,"_2948":55265},[],"With **Honor Subject**, the certificate keeps the subject of the CSR. Without that option, Lamassu applies the profile's `CN`, `O`, `OU`, `C`, `ST` and `L`. If the profile does not define a `Common Name`, the requested CN is kept.",{"_3465":1934,"_30219":1907,"_20927":55267,"_5":14373,"_27457":55197,"_2948":55268},[],"With **Honor Extensions**, Lamassu filters the additional requested extensions and keeps only SAN. Without that option, it discards the CSR's additional extensions.",{"_3465":1935,"_30219":1907,"_20927":55270,"_5":14373,"_27457":55197,"_2948":55271},[],"This preserves SAN, but does not establish that the requester is entitled to those DNS names, IP addresses, emails or URIs. Validate that authorization before issuing. OCSP and CRL locations come from the issuance service configuration; `Honor Extensions` does not copy CSR distribution points.",{"_3465":1936,"_30219":1907,"_20927":55273,"_5":14373,"_27457":55201,"_2948":55274},[],"The cryptographic enforcement can:",{"_3465":1937,"_30219":1907,"_20927":55276,"_5":14373,"_27457":55201,"_2948":55277},[],"allow or block RSA keys;",{"_3465":1938,"_30219":1907,"_20927":55279,"_5":14373,"_27457":55201,"_2948":55280},[],"limit the supported RSA sizes;",{"_3465":1939,"_30219":1907,"_20927":55282,"_5":14373,"_27457":55201,"_2948":55283},[],"allow or block ECDSA keys;",{"_3465":1940,"_30219":1907,"_20927":55285,"_5":14373,"_27457":55201,"_2948":55286},[],"limit the supported ECDSA sizes or curves.",{"_3465":1941,"_30219":1907,"_20927":55288,"_5":14373,"_27457":55201,"_2948":55289},[],"When it is enabled, Lamassu checks the public key before creating a CA or signing a CSR. A key whose type or size is not listed in the profile is rejected.",{"_3465":1942,"_30219":1907,"_20927":55291,"_5":14373,"_27457":55205,"_2948":55292},[],"Resolution depends on the entry point. One complete profile is selected; its fields are not merged with the CA’s profile.",{"_3465":1943,"_30219":1907,"_20927":55294,"_5":14373,"_27457":55205,"_2948":52496},[],{"_3465":1944,"_30219":1907,"_20927":55296,"_5":14373,"_27457":55205,"_2948":55297},[],"First choice",{"_3465":1945,"_30219":1907,"_20927":55299,"_5":14373,"_27457":55205,"_2948":55300},[],"Second choice",{"_3465":1946,"_30219":1907,"_20927":55302,"_5":14373,"_27457":55205,"_2948":55303},[],"If neither is supplied",{"_3465":1947,"_30219":1907,"_20927":55305,"_5":14373,"_27457":55205,"_2948":55306},[],"Direct signing with a CA",{"_3465":1948,"_30219":1907,"_20927":55308,"_5":14373,"_27457":55205,"_2948":55309},[],"`issuance_profile` embedded in the request",{"_3465":1949,"_30219":1907,"_20927":55311,"_5":14373,"_27457":55205,"_2948":55312},[],"Request `issuance_profile_id`",{"_3465":1950,"_30219":1907,"_20927":55314,"_5":14373,"_27457":55205,"_2948":55315},[],"CA default profile (`profile_id`).",{"_3465":1951,"_30219":1907,"_20927":55317,"_5":14373,"_27457":55205,"_2948":55318},[],"Issuance through a DMS",{"_3465":1952,"_30219":1907,"_20927":55320,"_5":14373,"_27457":55205,"_2948":55321},[],"`settings.issuance_profile_id`",{"_3465":1953,"_30219":1907,"_20927":55323,"_5":14373,"_27457":55205,"_2948":55324},[],"`settings.issuance_profile` embedded in the DMS",{"_3465":1954,"_30219":1907,"_20927":55326,"_5":14373,"_27457":55205,"_2948":55327},[],"Enrollment CA default profile.",{"_3465":1955,"_30219":1907,"_20927":55329,"_5":14373,"_27457":55205,"_2948":55330},[],"If the selected identifier cannot be resolved, the operation fails; it does not silently fall back to the CA’s profile. Avoid setting both options at once. Recording which profile was selected helps explain why a certificate differs from its CSR.",{"_3465":1956,"_30219":1907,"_20927":55332,"_5":14373,"_27457":55205,"_2948":55333},[],"Several fleets can share a CA while keeping different profiles through their DMSs. Requester authentication and device registration policy are configured separately in DMS.",{"_3465":1957,"_30219":1907,"_20927":55335,"_5":14373,"_27457":55213,"_2948":55336},[],"Separate, for example, mTLS devices, servers and intermediate CAs. A small, specific profile is easier to review than one that allows every use.",{"_3465":1958,"_30219":1907,"_20927":55338,"_5":14373,"_27457":55217,"_2948":55339},[],"Align the duration with the fleet's real renewal capacity. Leave margin against the CA's expiration.",{"_3465":1959,"_30219":1907,"_20927":55341,"_5":14373,"_27457":55221,"_2948":55342},[],"For a device that authenticates as a client, the usual starting point is `DigitalSignature` and `ClientAuth`. Add `ServerAuth` or `KeyEncipherment` only if the protocol needs it.",{"_3465":1960,"_30219":1907,"_20927":55344,"_5":14373,"_27457":55225,"_2948":55345},[],"Enable cryptographic enforcement and list only algorithms and sizes compatible with your policy and your devices.",{"_3465":1961,"_30219":1907,"_20927":55347,"_5":14373,"_27457":55229,"_2948":55348},[],"Attach the profile to a CA or DMS and check the precedence above. Issue a CSR with known usages and SAN; inspect the result with `openssl x509 -in device.crt -noout -text`. Check subject, SAN, KU, EKU and dates. For an end-entity identity, disable `Sign as CA`, require no `CA:TRUE` or `Certificate Sign`, and require `CA:FALSE` if Basic Constraints is present.",{"_3465":1962,"_30219":1907,"_20927":55350,"_5":14373,"_27457":55229,"_2948":55351},[],"Also try a key excluded by policy: issuance should fail. Follow the certificate verification and test acceptance in the intended consumer.",{"_3465":1963,"_30219":1907,"_20927":55353,"_5":14373,"_27457":55233,"_2948":55354},[],"**mTLS device**\\\nEnd-entity certificate, short validity, `DigitalSignature`, `ClientAuth`, subject controlled by the DMS and SAN allowed when it identifies the device.",{"_3465":1964,"_30219":1907,"_20927":55356,"_5":14373,"_27457":55233,"_2948":55357},[],"**TLS server**\\\nEnd-entity certificate, `DigitalSignature`, `ServerAuth` and mandatory SAN with the names clients will use.",{"_3465":1965,"_30219":1907,"_20927":55359,"_5":14373,"_27457":55233,"_2948":55360},[],"**Intermediate CA**\\\n`Sign as CA`, `CertSign` and `CRLSign`, validity longer than its end-entity certificates and stricter cryptographic constraints.",{"_3465":1966,"_30219":1907,"_20927":55362,"_5":14373,"_27457":55233,"_2948":55363},[],"These patterns express design decisions. Enabling `Honor Extensions` does not require a CSR to contain SAN or validate its names; enforce that in the request workflow. A profile does not install trust or grant permissions in the consumer.",{"_3465":1967,"_30219":1907,"_20927":55365,"_5":14373,"_27457":55237,"_2948":55366},[],"Updating a profile affects future issuances; it does not modify already-signed certificates. Test changes before applying them to a CA in production and keep the operational justification.",{"_3465":1968,"_30219":1907,"_20927":55368,"_5":14373,"_27457":55237,"_2948":55369},[],"Before deleting a profile, check that no CA or DMS depends on it. If you want to replace it, create the new version, update the references and perform a test issuance before retiring the old one.",{"_3465":1969,"_30219":1969,"_5":14725,"_2948":55371,"_30551":55372,"_20927":55374,"_27457":1969},"Certificate validation",[49254,50729,54734,55373],"Validation",[],{"_3465":1970,"_30219":1969,"_20927":55376,"_5":14373,"_27457":1969,"_2948":55377},[],"Check chain, identity, purpose and revocation from the consumer.",{"_3465":1971,"_30219":1969,"_5":30548,"_20927":55379,"_27457":55380,"_2948":55381},[],"/docs/platform/pki/certificate-validation#before-querying-status","Before querying status",{"_3465":1972,"_30219":1969,"_5":30548,"_20927":55383,"_27457":55384,"_2948":55385},[],"/docs/platform/pki/certificate-validation#choose-a-mechanism","Choose a mechanism",{"_3465":1973,"_30219":1969,"_5":30548,"_20927":55387,"_27457":55388,"_2948":55389},[],"/docs/platform/pki/certificate-validation#check-consumer-behavior","Check consumer behavior",{"_3465":1974,"_30219":1969,"_20927":55391,"_5":14373,"_27457":1969,"_2948":55392},[],"This guide brings together the checks needed when integrating a certificate consumer. You need the presented certificate, intermediates and roots that your application has deliberately chosen to trust. Lamassu publishes status; the consumer applies acceptance policy.",{"_3465":1975,"_30219":1969,"_20927":55394,"_5":14373,"_27457":55380,"_2948":55395},[],"Verify these criteria together:",{"_3465":1976,"_30219":1969,"_20927":55397,"_5":14373,"_27457":55380,"_2948":54360},[],{"_3465":1977,"_30219":1969,"_20927":55399,"_5":14373,"_27457":55380,"_2948":55400},[],"Required result",{"_3465":1978,"_30219":1969,"_20927":55402,"_5":14373,"_27457":55380,"_2948":55403},[],"Chain and signature",{"_3465":1979,"_30219":1969,"_20927":55405,"_5":14373,"_27457":55380,"_2948":55406},[],"Valid chain to a root deliberately installed in the consumer.",{"_3465":1980,"_30219":1969,"_20927":55408,"_5":14373,"_27457":55380,"_2948":55409},[],"Dates",{"_3465":1981,"_30219":1969,"_20927":55411,"_5":14373,"_27457":55380,"_2948":55412},[],"Current time between `Not Before` and `Not After`, including the CAs in the chain.",{"_3465":1982,"_30219":1969,"_20927":55414,"_5":14373,"_27457":55380,"_2948":50398},[],{"_3465":1983,"_30219":1969,"_20927":55416,"_5":14373,"_27457":55380,"_2948":55417},[],"Name, SAN or identifier matches the expected peer.",{"_3465":1984,"_30219":1969,"_20927":55419,"_5":14373,"_27457":55380,"_2948":49644},[],{"_3465":1985,"_30219":1969,"_20927":55421,"_5":14373,"_27457":55380,"_2948":55422},[],"KU, EKU and constraints permit the specific operation.",{"_3465":1986,"_30219":1969,"_20927":55424,"_5":14373,"_27457":55380,"_2948":55425},[],"Revocation",{"_3465":1987,"_30219":1969,"_20927":55427,"_5":14373,"_27457":55380,"_2948":55428},[],"Signed, current evidence corresponding to the queried issuer and certificate.",{"_3465":1988,"_30219":1969,"_20927":55430,"_5":14373,"_27457":55380,"_2948":55431},[],"Authorization",{"_3465":1989,"_30219":1969,"_20927":55433,"_5":14373,"_27457":55380,"_2948":55434},[],"The application permits that identity to perform the action.",{"_3465":1990,"_30219":1969,"_20927":55436,"_5":14373,"_27457":55380,"_2948":55437},[],"The issuance walkthrough checks chain and purpose with OpenSSL. That check does not automatically query OCSP or download a CRL. Inventory presence or an OCSP `Good` response does not replace the other criteria.",{"_3465":1991,"_30219":1969,"_20927":55439,"_5":14373,"_27457":55384,"_2948":55440},[],"Mechanism",{"_3465":1992,"_30219":1969,"_20927":55442,"_5":14373,"_27457":55384,"_2948":55443},[],"When to use it",{"_3465":1993,"_30219":1969,"_20927":55445,"_5":14373,"_27457":55384,"_2948":55446},[],"What you must maintain",{"_3465":1994,"_30219":1969,"_20927":55448,"_5":14373,"_27457":55384,"_2948":55449},[],"OCSP",{"_3465":1995,"_30219":1969,"_20927":55451,"_5":14373,"_27457":55384,"_2948":55452},[],"Status query for a specific certificate.",{"_3465":1996,"_30219":1969,"_20927":55454,"_5":14373,"_27457":55384,"_2948":55455},[],"Responder access, signature verification and cache/freshness policy.",{"_3465":1997,"_30219":1969,"_20927":55457,"_5":14373,"_27457":55384,"_2948":55458},[],"CRL",{"_3465":1998,"_30219":1969,"_20927":55460,"_5":14373,"_27457":55384,"_2948":55461},[],"Local checks for many certificates or offline operation.",{"_3465":1999,"_30219":1969,"_20927":55463,"_5":14373,"_27457":55384,"_2948":55464},[],"Periodic download of an issuer-signed list and rejection of expired lists.",{"_3465":2000,"_30219":1969,"_20927":55466,"_5":14373,"_27457":55384,"_2948":55467},[],"OCSP can also return a response reusable until `nextUpdate`; a CRL changes when a new version is published. Neither mechanism alone guarantees that a consumer learns a revocation at the moment it is saved.",{"_3465":2001,"_30219":1969,"_20927":55469,"_5":14373,"_27457":55384,"_2948":55470},[],"If using both, define when fallback is allowed and what the client does when retrieval, signature or freshness checks fail, or the result is `Unknown`. Accepting an identity when its status cannot be checked must be an explicit application decision.",{"_3465":2002,"_30219":1969,"_20927":55472,"_5":14373,"_27457":55388,"_2948":55473},[],"Accept a current, authorized certificate with a known chain.",{"_3465":2003,"_30219":1969,"_20927":55475,"_5":14373,"_27457":55388,"_2948":55476},[],"Reject another certificate with an unknown root or incompatible purpose.",{"_3465":2004,"_30219":1969,"_20927":55478,"_5":14373,"_27457":55388,"_2948":55479},[],"Revoke a test certificate and verify the OCSP response or new CRL.",{"_3465":2005,"_30219":1969,"_20927":55481,"_5":14373,"_27457":55388,"_2948":55482},[],"Check that a new connection with that identity is rejected.",{"_3465":2006,"_30219":1969,"_20927":55484,"_5":14373,"_27457":55388,"_2948":55485},[],"Simulate an unreachable endpoint and expired evidence; observe whether the result matches policy.",{"_3465":2007,"_30219":1969,"_20927":55487,"_5":14373,"_27457":55388,"_2948":55488},[],"Keep the serial number, issuer, revocation reason, query time and evidence timestamps. An existing session may need explicit closure or reauthentication in the consumer; publishing revocation does not automatically close it.",{"_3465":2008,"_30219":1969,"_20927":55490,"_5":14373,"_27457":55388,"_2948":55491},[],"For a chain with intermediates, validate their status according to consumer policy as well. An end-entity issuer’s CRL does not replace checks on every CA in the chain.",{"_3465":2009,"_30219":1969,"_20927":55493,"_5":14373,"_27457":55388,"_2948":55494},[],"<Card title=\"Online validation with OCSP\" description=\"Generate a query and verify signature, status and timestamps.\" href=\"/docs/platform/pki/ocsp\" />",{"_3465":2010,"_30219":1969,"_20927":55496,"_5":14373,"_27457":55388,"_2948":55497},[],"<Card title=\"Revocation lists\" description=\"Download, inspect and use an issuer’s CRL.\" href=\"/docs/platform/pki/crl\" />",{"_3465":2011,"_30219":2011,"_5":14725,"_2948":55499,"_30551":55500,"_20927":55501,"_27457":2011},"Certificates",[49254,50729,54734,54735],[],{"_3465":2012,"_30219":2011,"_20927":55503,"_5":14373,"_27457":2011,"_2948":55504},[],"Inspect, download and revoke the certificates issued by Lamassu.",{"_3465":2013,"_30219":2011,"_5":30548,"_20927":55506,"_27457":55507,"_2948":55508},[],"/docs/platform/pki/certificates#find-a-certificate","Find a certificate",{"_3465":2014,"_30219":2011,"_5":30548,"_20927":55510,"_27457":55511,"_2948":55512},[],"/docs/platform/pki/certificates#download-the-certificate","Download the certificate",{"_3465":2015,"_30219":2011,"_5":30548,"_20927":55514,"_27457":55515,"_2948":55516},[],"/docs/platform/pki/certificates#issue-from-an-existing-csr","Issue from an existing CSR",{"_3465":2016,"_30219":2011,"_5":30548,"_20927":55518,"_27457":55519,"_2948":55520},[],"/docs/platform/pki/certificates#revoke-a-certificate","Revoke a certificate",{"_3465":2017,"_30219":2011,"_5":30548,"_20927":55522,"_27457":55523,"_2948":55524},[],"/docs/platform/pki/certificates#open-the-action","Open the action",{"_3465":2018,"_30219":2011,"_5":30548,"_20927":55526,"_27457":55527,"_2948":55528},[],"/docs/platform/pki/certificates#choose-a-reason","Choose a reason",{"_3465":2019,"_30219":2011,"_5":30548,"_20927":55530,"_27457":55531,"_2948":55532},[],"/docs/platform/pki/certificates#confirm-and-verify","Confirm and verify",{"_3465":2020,"_30219":2011,"_5":30548,"_20927":55534,"_27457":55535,"_2948":55536},[],"/docs/platform/pki/certificates#reactivate-a-hold","Reactivate a hold",{"_3465":2021,"_30219":2011,"_5":30548,"_20927":55538,"_27457":55539,"_2948":55540},[],"/docs/platform/pki/certificates#continue","Continue",{"_3465":2022,"_30219":2011,"_20927":55542,"_5":14373,"_27457":2011,"_2948":55543},[],"This guide is for a PKI operator inspecting or retiring an issued identity. You need inventory access and, to change states, permissions on the certificate. Open **Certificates** for a global view or **Issued Certificates** within a CA to restrict it to that issuer.",{"_3465":2023,"_30219":2011,"_20927":55545,"_5":14373,"_27457":55507,"_2948":55546},[],"Filter by `Common Name`, serial, status and issuer. A certificate does not contain its private key, so the private-key surfaces answer which certificates have their key held in Lamassu’s KMS:",{"_3465":2024,"_30219":2011,"_20927":55548,"_5":14373,"_27457":55507,"_2948":55549},[],"The advanced **Private Key** filter, available on the Certificates page and on a CA’s **Issued Certificates** tab, narrows the list to **All Certificates**, **With Private Key** or **Without Private Key**.",{"_3465":2025,"_30219":2011,"_20927":55551,"_5":14373,"_27457":55507,"_2948":55552},[],"The sortable **Private Key** column — shown by default, hidden on narrow screens — marks a key held in the KMS with a green check mark and otherwise shows `-`.",{"_3465":2026,"_30219":2011,"_20927":55554,"_5":14373,"_27457":55507,"_2948":55555},[],"In certificate details, the **Information** tab shows a **Private Key** row in the **Key & Signature** section. When the certificate reports a private key and its KMS engine and key IDs are available, the row links to the key (tooltip: **Open private key in KMS**). Otherwise, it shows **Present** if the certificate reports a private key, or **Not available** if it does not. This does not establish whether a key exists outside Lamassu.",{"_3465":2027,"_30219":2011,"_20927":55557,"_5":14373,"_27457":55507,"_2948":55558},[],"Use **Quick Inspect** for a quick review or **View Details** for subject, SAN, usages, chain, dates and metadata.",{"_3465":2028,"_30219":2011,"_20927":55560,"_5":14373,"_27457":55507,"_2948":55561},[],"Certificate records expose `key_id` (the KMS key that holds the private key, empty when the KMS does not hold it) and `has_private_key` (derived at read time from the KMS). Certificate and CA listings accept a `has_private_key` filter, which is useful, for example, to check the result of the CA-to-KMS migration of the 4.0.0 upgrade.",{"_3465":2029,"_30219":2011,"_20927":55563,"_5":14373,"_27457":55507,"_2948":55564},[],"Identify a certificate by issuer and serial; a name can correspond to several renewals. Check which certificate the consumer actually uses and which occupies the device’s active identity. Identity history and the certificate inventory answer different questions.",{"_3465":2030,"_30219":2011,"_20927":55566,"_5":14373,"_27457":55511,"_2948":55567},[],"Download the PEM and inspect it:",{"_3465":2031,"_30219":2011,"_20927":55569,"_5":14373,"_27457":55511,"_2948":55570},[],"Check issuance policy, chain and usages with the verification walkthrough. A certificate does not contain its private key. For an external CSR, the key remains where it was generated; for the browser flow, retain the file downloaded upon issuance. If the key is lost, plan a new identity rather than expecting recovery from the certificate.",{"_3465":2032,"_30219":2011,"_20927":55572,"_5":14373,"_27457":55515,"_2948":55573},[],"Use this flow when the identity’s key must remain on the system that generated it. You need an active CA with a usable key, a PEM CSR and a suitable profile.",{"_3465":2033,"_30219":2011,"_20927":55575,"_5":14373,"_27457":55515,"_2948":55576},[],"Verify the request with `openssl req -in request.csr -noout -verify -text`. Review subject, SAN and algorithm, and authorize the requested identity.",{"_3465":2034,"_30219":2011,"_20927":55578,"_5":14373,"_27457":55515,"_2948":55579},[],"Start issuance from the CA or inventory and select **Upload Existing CSR**.",{"_3465":2035,"_30219":2011,"_20927":55581,"_5":14373,"_27457":55515,"_2948":55582},[],"Confirm the CA and profile resolved according to Profiles; the request does not guarantee that every field is retained.",{"_3465":2036,"_30219":2011,"_20927":55584,"_5":14373,"_27457":55515,"_2948":55585},[],"Download the certificate and inspect dates, issuer, subject, SAN, KU and EKU. Check correspondence with the private key on the originating system.",{"_3465":2037,"_30219":2011,"_20927":55587,"_5":14373,"_27457":55515,"_2948":55588},[],"Install certificate and chain in the intended consumer and test a connection. Issuance alone does not register a device or grant access in an integration.",{"_3465":2038,"_30219":2011,"_20927":55590,"_5":14373,"_27457":55515,"_2948":55591},[],"For browser key generation, follow Issue your first certificate.",{"_3465":2039,"_30219":2011,"_20927":55593,"_5":14373,"_27457":55519,"_2948":55594},[],"Revoke when the key is compromised, the subject is no longer authorized or the identity must stop being accepted before expiration. Before changing status, identify consumers and prepare any required replacement.",{"_3465":2040,"_30219":2011,"_20927":55596,"_5":14373,"_27457":55523,"_2948":55597},[],"Locate the correct issuer and serial and select **Revoke Certificate**. `EXPIRED` records and records revoked for a final reason reject subsequent status changes.",{"_3465":2041,"_30219":2011,"_20927":55599,"_5":14373,"_27457":55527,"_2948":55600},[],"Select the incident reason. `CertificateHold` represents a reversible certificate suspension; other reasons block later changes. Do not use a suspension to address a compromised key.",{"_3465":2042,"_30219":2011,"_20927":55602,"_5":14373,"_27457":55531,"_2948":55603},[],"Save the change and read the record again: require **REVOKED**, reason and timestamp. Then verify a fresh OCSP query and, if using CRL, its published version and the serial’s presence. Finally check rejection of a new connection in the consumer.",{"_3465":2043,"_30219":2011,"_20927":55605,"_5":14373,"_27457":55531,"_2948":55606},[],"Revocation does not erase the certificate, delete the key or guarantee closure of existing sessions. Status and publication are separate steps.",{"_3465":2044,"_30219":2011,"_20927":55608,"_5":14373,"_27457":55531,"_2948":55609},[],"A certificate revoked with `CertificateHold` can be reactivated if it is not in `EXPIRED` state. Its dates and consumer trust remain mandatory.",{"_3465":2045,"_30219":2011,"_20927":55611,"_5":14373,"_27457":55535,"_2948":55612},[],"Check that the saved reason is `CertificateHold` and the identity still satisfies policy. Request `ACTIVE` through the status update operation exposed by your installation; consult the API reference. Do not assume changing consumer permissions also changes status in Lamassu.",{"_3465":2046,"_30219":2011,"_20927":55614,"_5":14373,"_27457":55535,"_2948":55615},[],"Read the record and query OCSP again. With `regenerate_on_revoke` enabled, the reactivation event requests CRL regeneration: check that the new list omits the serial. An earlier list can still mark it revoked until the client refreshes its copy.",{"_3465":2047,"_30219":2011,"_20927":55617,"_5":14373,"_27457":55535,"_2948":55618},[],"This does not undo permanent revocation or a cascade started by revoking a CA.",{"_3465":2048,"_30219":2011,"_20927":55620,"_5":14373,"_27457":55539,"_2948":55621},[],"<Card title=\"Validate with OCSP\" description=\"Query and verify a certificate’s signed status.\" href=\"/docs/platform/pki/ocsp\" />",{"_3465":2049,"_30219":2011,"_20927":55623,"_5":14373,"_27457":55539,"_2948":55624},[],"<Card title=\"Distribute a CRL\" description=\"Publish status for local validation.\" href=\"/docs/platform/pki/crl\" />",{"_3465":2050,"_30219":2050,"_5":14725,"_2948":55626,"_30551":55627,"_20927":55629,"_27457":2050},"Certificate lifecycle",[49254,50729,54734,55628],"Concepts",[],{"_3465":2051,"_30219":2050,"_20927":55631,"_5":14373,"_27457":2050,"_2948":55632},[],"Issuance, use, renewal, revocation and retirement of certificates in Lamassu.",{"_3465":2052,"_30219":2050,"_5":30548,"_20927":55634,"_27457":55635,"_2948":55636},[],"/docs/platform/pki/concepts/certificate-lifecycle#the-full-journey","The full journey",{"_3465":2053,"_30219":2050,"_5":30548,"_20927":55638,"_27457":55639,"_2948":55640},[],"/docs/platform/pki/concepts/certificate-lifecycle#request","Request",{"_3465":2054,"_30219":2050,"_5":30548,"_20927":55642,"_27457":55643,"_2948":55644},[],"/docs/platform/pki/concepts/certificate-lifecycle#issuance","Issuance",{"_3465":2055,"_30219":2050,"_5":30548,"_20927":55646,"_27457":55647,"_2948":55648},[],"/docs/platform/pki/concepts/certificate-lifecycle#use-and-monitoring","Use and monitoring",{"_3465":2056,"_30219":2050,"_5":30548,"_20927":55650,"_27457":55651,"_2948":55652},[],"/docs/platform/pki/concepts/certificate-lifecycle#renewal-or-re-enrollment","Renewal or re-enrollment",{"_3465":2057,"_30219":2050,"_5":30548,"_20927":55654,"_27457":55655,"_2948":55656},[],"/docs/platform/pki/concepts/certificate-lifecycle#revocation-or-retirement","Revocation or retirement",{"_3465":2058,"_30219":2050,"_5":30548,"_20927":55658,"_27457":55659,"_2948":55660},[],"/docs/platform/pki/concepts/certificate-lifecycle#certificate-states","Certificate states",{"_3465":2059,"_30219":2050,"_5":30548,"_20927":55662,"_27457":55663,"_2948":55664},[],"/docs/platform/pki/concepts/certificate-lifecycle#renewal-and-revocation-are-not-equivalent","Renewal and revocation are not equivalent",{"_3465":2060,"_30219":2050,"_5":30548,"_20927":55666,"_27457":55667,"_2948":55668},[],"/docs/platform/pki/concepts/certificate-lifecycle#effect-of-revoking-a-ca","Effect of revoking a CA",{"_3465":2061,"_30219":2050,"_5":30548,"_20927":55670,"_27457":55671,"_2948":55672},[],"/docs/platform/pki/concepts/certificate-lifecycle#what-you-should-watch","What you should watch",{"_3465":2062,"_30219":2050,"_20927":55674,"_5":14373,"_27457":2050,"_2948":55675},[],"Issuing a certificate is only the beginning. During its useful life you must check its validity, renew it before it expires and retire it when it stops being trustworthy. Lamassu keeps the certificate, its issuing CA, its status and, when it belongs to a device, the identity it is linked to.",{"_3465":2063,"_30219":2050,"_20927":55677,"_5":14373,"_27457":55639,"_2948":55678},[],"The requester generates a key and a CSR. In the recommended flows, the private key stays in the device, browser or cryptographic engine that created it.",{"_3465":2064,"_30219":2050,"_20927":55680,"_5":14373,"_27457":55643,"_2948":55681},[],"The CA signs the CSR. The issuance profile determines the validity, uses, subject, allowed extensions and cryptographic constraints.",{"_3465":2065,"_30219":2050,"_20927":55683,"_5":14373,"_27457":55647,"_2948":55684},[],"The certificate enters the `ACTIVE` state. Lamassu monitors its `Not After` date; the cryptographic monitoring job marks certificates that have expired as `EXPIRED`.",{"_3465":2066,"_30219":2050,"_20927":55686,"_5":14373,"_27457":55651,"_2948":55687},[],"A new certificate is issued before the previous one expires. In a DMS you can open preventive and critical windows so the device re-enrolls through EST.",{"_3465":2067,"_30219":2050,"_20927":55689,"_5":14373,"_27457":55655,"_2948":55690},[],"If the identity stops being trustworthy, Lamassu records the reason and time of revocation. OCSP and CRLs let consumers learn that status.",{"_3465":2068,"_30219":2050,"_20927":55692,"_5":14373,"_27457":55659,"_2948":55693},[],"Lamassu persists four X.509 states:",{"_3465":2069,"_30219":2050,"_20927":55695,"_5":14373,"_27457":55659,"_2948":55696},[],"**`ACTIVE`**: the record is enabled. Also check `Not Before` and `Not After`: this state does not establish time validity.",{"_3465":2070,"_30219":2050,"_20927":55698,"_5":14373,"_27457":55659,"_2948":55699},[],"**`EXPIRED`**: it has passed its expiration date. The monitor detects this periodically; it is not a state that should be assigned manually.",{"_3465":2071,"_30219":2050,"_20927":55701,"_5":14373,"_27457":55659,"_2948":55702},[],"**`REVOKED`**: it was invalidated before expiring, with a reason and a timestamp.",{"_3465":2072,"_30219":2050,"_20927":55704,"_5":14373,"_27457":55659,"_2948":55705},[],"**`INACTIVE`**: it is disabled without representing a definitive revocation.",{"_3465":2073,"_30219":2050,"_20927":55707,"_5":14373,"_27457":55659,"_2948":55708},[],"The device view may add operational states such as missing identity, pending renewal, expiring soon or decommissioned. These are an interpretation of the device's status and its certificates, not new X.509 states.",{"_3465":2074,"_30219":2050,"_20927":55710,"_5":14373,"_27457":55663,"_2948":55711},[],"**Renewal** creates a successor certificate for an identity that remains valid. **Revocation** communicates that the current certificate must no longer be accepted. Renew to maintain continuity; revoke in response to compromise, retirement or a change that invalidates the identity.",{"_3465":2075,"_30219":2050,"_20927":55713,"_5":14373,"_27457":55663,"_2948":55714},[],"Only `CertificateHold` allows reactivating a revoked certificate that is not in `EXPIRED` state. Revocation for another reason blocks subsequent status changes. `EXPIRED` records also reject changes; the consumer must check dates even before the monitor updates the state. Certificates explains how to verify revocation and reactivation.",{"_3465":2076,"_30219":2050,"_20927":55716,"_5":14373,"_27457":55663,"_2948":55717},[],"The **Reissue CA** operation generates another certificate for the same key and links both serial numbers through metadata. It is not a key rotation. To change the key, create a successor CA and perform a migration with an overlapping period.",{"_3465":2077,"_30219":2050,"_20927":55719,"_5":14373,"_27457":55667,"_2948":55720},[],"Revoking a CA starts a cascade that attempts to revoke descendants with `CessationOfOperation`. It may end with partial failures and is not undone by reactivating the parent. Read Hierarchy and rotation for conditions and checks.",{"_3465":2078,"_30219":2050,"_20927":55722,"_5":14373,"_27457":55667,"_2948":55723},[],"Before confirming:",{"_3465":2079,"_30219":2050,"_20927":55725,"_5":14373,"_27457":55667,"_2948":55726},[],"Identify DMSs, devices and services that trust that chain.",{"_3465":2080,"_30219":2050,"_20927":55728,"_5":14373,"_27457":55667,"_2948":55729},[],"Distribute the new chain of trust.",{"_3465":2081,"_30219":2050,"_20927":55731,"_5":14373,"_27457":55667,"_2948":55732},[],"Reissue the necessary identities.",{"_3465":2082,"_30219":2050,"_20927":55734,"_5":14373,"_27457":55667,"_2948":55735},[],"Check OCSP and CRL from a real consumer.",{"_3465":2083,"_30219":2050,"_20927":55737,"_5":14373,"_27457":55667,"_2948":55738},[],"Revoke the old CA once no legitimate traffic remains.",{"_3465":2084,"_30219":2050,"_20927":55740,"_5":14373,"_27457":55667,"_2948":55741},[],"Device retirement belongs to the IoT Fleets lifecycle. It affects the active identity; it does not automatically traverse and revoke every historical certificate. Review previous identities and consumer permissions separately in Device management.",{"_3465":2085,"_30219":2050,"_20927":55743,"_5":14373,"_27457":55671,"_2948":55744},[],"Certificates entering the preventive or critical renewal window.",{"_3465":2086,"_30219":2050,"_20927":55746,"_5":14373,"_27457":55671,"_2948":55747},[],"Repeated enrollment or re-enrollment failures.",{"_3465":2087,"_30219":2050,"_20927":55749,"_5":14373,"_27457":55671,"_2948":55750},[],"Status changes and revocation reasons.",{"_3465":2088,"_30219":2050,"_20927":55752,"_5":14373,"_27457":55671,"_2948":55753},[],"OCSP and CRL publication and validity.",{"_3465":2089,"_30219":2050,"_20927":55755,"_5":14373,"_27457":55671,"_2948":55756},[],"Dependencies still presenting a replaced certificate.",{"_3465":2090,"_30219":2050,"_20927":55758,"_5":14373,"_27457":55671,"_2948":55759},[],"The device history relates its previous and current identities. For administrative changes and mutation errors, see Audit logs.",{"_3465":2091,"_30219":2091,"_5":14725,"_2948":55761,"_30551":55762,"_20927":55763,"_27457":2091},"Trust model",[49254,50729,54734,55628],[],{"_3465":2092,"_30219":2091,"_20927":55765,"_5":14373,"_27457":2091,"_2948":55766},[],"Understand where trust originates, how it is distributed and what each component validates.",{"_3465":2093,"_30219":2091,"_5":30548,"_20927":55768,"_27457":55769,"_2948":55770},[],"/docs/platform/pki/concepts/trust-model#the-four-trust-decisions","The four trust decisions",{"_3465":2094,"_30219":2091,"_5":30548,"_20927":55772,"_27457":55773,"_2948":55774},[],"/docs/platform/pki/concepts/trust-model#who-can-issue","Who can issue",{"_3465":2095,"_30219":2091,"_5":30548,"_20927":55776,"_27457":55777,"_2948":55778},[],"/docs/platform/pki/concepts/trust-model#what-can-be-issued","What can be issued",{"_3465":2096,"_30219":2091,"_5":30548,"_20927":55780,"_27457":55781,"_2948":55782},[],"/docs/platform/pki/concepts/trust-model#who-can-request-it","Who can request it",{"_3465":2097,"_30219":2091,"_5":30548,"_20927":55784,"_27457":55785,"_2948":55786},[],"/docs/platform/pki/concepts/trust-model#who-accepts-the-result","Who accepts the result",{"_3465":2098,"_30219":2091,"_5":30548,"_20927":55788,"_27457":55789,"_2948":55790},[],"/docs/platform/pki/concepts/trust-model#identity-flow","Identity flow",{"_3465":2099,"_30219":2091,"_5":30548,"_20927":55792,"_27457":55793,"_2948":55794},[],"/docs/platform/pki/concepts/trust-model#enrollment-validation-and-distribution-cas","Enrollment, validation and distribution CAs",{"_3465":2100,"_30219":2091,"_5":30548,"_20927":55796,"_27457":55797,"_2948":55798},[],"/docs/platform/pki/concepts/trust-model#validation-and-revocation","Validation and revocation",{"_3465":2101,"_30219":2091,"_5":30548,"_20927":55800,"_27457":55801,"_2948":55802},[],"/docs/platform/pki/concepts/trust-model#custody-limits","Custody limits",{"_3465":2102,"_30219":2091,"_5":30548,"_20927":55804,"_27457":55805,"_2948":55806},[],"/docs/platform/pki/concepts/trust-model#recommended-pattern","Recommended pattern",{"_3465":2103,"_30219":2091,"_20927":55808,"_5":14373,"_27457":2091,"_2948":55809},[],"In Lamassu, trust does not simply mean that a certificate exists in the inventory. A consumer trusts an identity when it can build a chain to a root it recognizes, check that the certificate is fit for the intended use and verify that it is still valid.",{"_3465":2104,"_30219":2091,"_20927":55811,"_5":14373,"_27457":55773,"_2948":55812},[],"The CA hierarchy defines which authorities can sign. A root CA establishes the anchor of trust; intermediate CAs separate operating domains and avoid using the root for every issuance.",{"_3465":2105,"_30219":2091,"_20927":55814,"_5":14373,"_27457":55777,"_2948":55815},[],"Certificate profiles limit validity, subject, uses, extensions and cryptographic parameters. Possessing a CA does not replace an issuance policy.",{"_3465":2106,"_30219":2091,"_20927":55817,"_5":14373,"_27457":55781,"_2948":55818},[],"The DMS acts as the enrollment point. It can authenticate an EST request with a client certificate, an external webhook or a combination of both. CAs configured to validate the requester do not have to be the CA that will issue the new identity.",{"_3465":2107,"_30219":2091,"_20927":55820,"_5":14373,"_27457":55785,"_2948":55821},[],"The consumer keeps its own trust store. EST `/cacerts` can distribute the service TLS certificate, the enrollment CA and selected managed CAs. Initial trust for authenticating that service must come from an already trusted channel. Download and inspect the contents: do not assume they form a complete chain or install every entry as a root.",{"_3465":2108,"_30219":2091,"_20927":55823,"_5":14373,"_27457":55789,"_2948":55824},[],"The device proves it can enroll according to the DMS policy.",{"_3465":2109,"_30219":2091,"_20927":55826,"_5":14373,"_27457":55789,"_2948":55827},[],"The DMS validates the request and forwards the CSR to the enrollment CA.",{"_3465":2110,"_30219":2091,"_20927":55829,"_5":14373,"_27457":55789,"_2948":55830},[],"In the device-generated CSR flow, the CA applies the profile and signs without receiving the device’s private key.",{"_3465":2111,"_30219":2091,"_20927":55832,"_5":14373,"_27457":55789,"_2948":55833},[],"The device installs the certificate and the chain it needs.",{"_3465":2112,"_30219":2091,"_20927":55835,"_5":14373,"_27457":55789,"_2948":55836},[],"The system that trusts the device validates the chain, dates, uses and revocation status.",{"_3465":2113,"_30219":2091,"_20927":55838,"_5":14373,"_27457":55789,"_2948":55839},[],"OIDC or X.509 identifies the operator calling Lamassu. The authorization service decides which actions it may perform. The X.509 hierarchy, on the other hand, determines whether a certificate presented by a device is trustworthy.",{"_3465":2114,"_30219":2091,"_20927":55841,"_5":14373,"_27457":55793,"_2948":55842},[],"A DMS relates three sets that are worth designing separately:",{"_3465":2115,"_30219":2091,"_20927":55844,"_5":14373,"_27457":55793,"_2948":55845},[],"**Enrollment CA:** signs the new identities.",{"_3465":2116,"_30219":2091,"_20927":55847,"_5":14373,"_27457":55793,"_2948":55848},[],"**Validation CAs:** authenticate the client certificates used for enrollment or migration. During re-enrollment, the enrollment CA is always trusted and Lamassu then tries the validation CAs configured in the re-enrollment block; those are optional.",{"_3465":2117,"_30219":2091,"_20927":55850,"_5":14373,"_27457":55793,"_2948":55851},[],"**Distributed CAs:** form the content the device obtains through EST `/cacerts`. You can include the service TLS certificate, the enrollment CA and an explicit list of managed CAs. Including the issuer does not automatically add all its ancestors.",{"_3465":2118,"_30219":2091,"_20927":55853,"_5":14373,"_27457":55793,"_2948":55854},[],"This separation makes it possible to migrate a fleet: you temporarily accept certificates from the old hierarchy, issue with the new one and distribute both chains during the overlap.",{"_3465":2119,"_30219":2091,"_20927":55856,"_5":14373,"_27457":55797,"_2948":55857},[],"A valid chain does not by itself guarantee that a certificate should be accepted. The consumer must also check:",{"_3465":2120,"_30219":2091,"_20927":55859,"_5":14373,"_27457":55797,"_2948":55860},[],"that the current date is between `Not Before` and `Not After`;",{"_3465":2121,"_30219":2091,"_20927":55862,"_5":14373,"_27457":55797,"_2948":55863},[],"that `Key Usage` and `Extended Key Usage` allow the operation;",{"_3465":2122,"_30219":2091,"_20927":55865,"_5":14373,"_27457":55797,"_2948":55866},[],"that names, SANs and subject match the expected identity;",{"_3465":2123,"_30219":2091,"_20927":55868,"_5":14373,"_27457":55797,"_2948":55869},[],"that the certificate does not appear revoked in OCSP or a CRL.",{"_3465":2124,"_30219":2091,"_20927":55871,"_5":14373,"_27457":55797,"_2948":55872},[],"An OCSP `Good` status does not replace chain, date, usage and identity checks either; Validation brings those criteria together.",{"_3465":2125,"_30219":2091,"_20927":55874,"_5":14373,"_27457":55797,"_2948":55875},[],"During the mTLS authentication of a DMS, Lamassu attempts to check revocation. If the certificate does not contain enough information to perform that check, the backend logs a warning and continues treating it as not revoked. Design your profiles and distribution points to avoid that situation in production.",{"_3465":2126,"_30219":2091,"_20927":55877,"_5":14373,"_27457":55801,"_2948":55878},[],"The KMS keeps the reference to the key and delegates the operation to the configured engine. With an HSM or a cloud KMS, the private key can remain non-exportable. That protects custody, but it does not by itself prevent misuse: you still must restrict who can request a signature and audit those operations.",{"_3465":2127,"_30219":2091,"_20927":55880,"_5":14373,"_27457":55805,"_2948":55881},[],"Keep the root out of daily operations, or with very restricted access.",{"_3465":2128,"_30219":2091,"_20927":55883,"_5":14373,"_27457":55805,"_2948":55884},[],"Issue from intermediate CAs separated by environment or risk domain.",{"_3465":2129,"_30219":2091,"_20927":55886,"_5":14373,"_27457":55805,"_2948":55887},[],"Assign explicit profiles to every use case.",{"_3465":2130,"_30219":2091,"_20927":55889,"_5":14373,"_27457":55805,"_2948":55890},[],"Distribute the new trust before starting a rotation.",{"_3465":2131,"_30219":2091,"_20927":55892,"_5":14373,"_27457":55805,"_2948":55893},[],"Keep enough overlap to renew a disconnected fleet.",{"_3465":2132,"_30219":2091,"_20927":55895,"_5":14373,"_27457":55805,"_2948":55896},[],"Validate from the consuming system, not only from the Lamassu console.",{"_3465":2133,"_30219":2091,"_20927":55898,"_5":14373,"_27457":55805,"_2948":55899},[],"Continue with CA hierarchy and rotation to turn this model into an operating procedure.",{"_3465":2134,"_30219":2134,"_5":14725,"_2948":55901,"_30551":55902,"_20927":55903,"_27457":2134},"Revocation lists (CRL)",[49254,50729,54734,55373],[],{"_3465":2135,"_30219":2134,"_20927":55905,"_5":14373,"_27457":2134,"_2948":55906},[],"Generate and distribute signed lists to validate certificates offline.",{"_3465":2136,"_30219":2134,"_5":30548,"_20927":55908,"_27457":55909,"_2948":55910},[],"/docs/platform/pki/crl#crl-settings","CRL settings",{"_3465":2137,"_30219":2134,"_5":30548,"_20927":55912,"_27457":55913,"_2948":55914},[],"/docs/platform/pki/crl#cas-that-share-a-key","CAs that share a key",{"_3465":2138,"_30219":2134,"_5":30548,"_20927":55916,"_27457":55917,"_2948":55918},[],"/docs/platform/pki/crl#periodic-and-automatic-regeneration","Periodic and automatic regeneration",{"_3465":2139,"_30219":2134,"_5":30548,"_20927":55920,"_27457":55921,"_2948":55922},[],"/docs/platform/pki/crl#crl-contents","CRL contents",{"_3465":2140,"_30219":2134,"_5":30548,"_20927":55924,"_27457":55925,"_2948":55926},[],"/docs/platform/pki/crl#public-download-endpoint","Public download endpoint",{"_3465":2141,"_30219":2134,"_5":30548,"_20927":55928,"_27457":55929,"_2948":55930},[],"/docs/platform/pki/crl#crl-settings-api","CRL settings API",{"_3465":2142,"_30219":2134,"_5":30548,"_20927":55932,"_27457":55933,"_2948":55934},[],"/docs/platform/pki/crl#common-crl-settings-errors","Common CRL settings errors",{"_3465":2143,"_30219":2134,"_5":30548,"_20927":55936,"_27457":55937,"_2948":55938},[],"/docs/platform/pki/crl#from-the-interface","From the interface",{"_3465":2144,"_30219":2134,"_5":30548,"_20927":55940,"_27457":55941,"_2948":55942},[],"/docs/platform/pki/crl#references","References",{"_3465":2145,"_30219":2134,"_20927":55944,"_5":14373,"_27457":2134,"_2948":55945},[],"A CRL is an issuer-signed list of revoked certificates. This guide is for an operator publishing lists and an integrator using them locally. You need the issuing CA certificate, its CA ID and access to the published endpoint. The client must maintain a current copy: offline operation still requires refreshing evidence.",{"_3465":2146,"_30219":2134,"_20927":55947,"_5":14373,"_27457":55909,"_2948":55948},[],"The CRL settings of a CA store the configuration and metadata of its latest published list. Each CA has its own settings, keyed by its CA ID — even when two CAs share a key: they share the SKI, not the CRL. Generation requires a usable issuer key; do not assume an imported CA without a key has an available CRL.",{"_3465":2147,"_30219":2134,"_20927":55950,"_5":14373,"_27457":55909,"_2948":55951},[],"Field",{"_3465":2148,"_30219":2134,"_20927":55953,"_5":14373,"_27457":55909,"_2948":49644},[],{"_3465":2149,"_30219":2134,"_20927":55955,"_5":14373,"_27457":55909,"_2948":55956},[],"`ca_id`",{"_3465":2150,"_30219":2134,"_20927":55958,"_5":14373,"_27457":55909,"_2948":55959},[],"ID of the CA the settings belong to.",{"_3465":2151,"_30219":2134,"_20927":55961,"_5":14373,"_27457":55909,"_2948":55962},[],"`status`",{"_3465":2152,"_30219":2134,"_20927":55964,"_5":14373,"_27457":55909,"_2948":55965},[],"`ACTIVE` settings generate CRLs. `ARCHIVED` ones belong to a CA that no longer exists: their last CRL is still served, but never regenerated.",{"_3465":2153,"_30219":2134,"_20927":55967,"_5":14373,"_27457":55909,"_2948":55968},[],"`legacy_ski`",{"_3465":2154,"_30219":2134,"_20927":55970,"_5":14373,"_27457":55909,"_2948":55971},[],"Read-only. SKI the settings were keyed by before the 4.0.0 migration; only migrated settings have it, and `/crl/<ski>` keeps resolving to them.",{"_3465":2155,"_30219":2134,"_20927":55973,"_5":14373,"_27457":55909,"_2948":55974},[],"`latest_crl`",{"_3465":2156,"_30219":2134,"_20927":55976,"_5":14373,"_27457":55909,"_2948":55977},[],"Version, validity start and end of the last published list. Read-only.",{"_3465":2157,"_30219":2134,"_20927":55979,"_5":14373,"_27457":55909,"_2948":55980},[],"`crl_options` field",{"_3465":2158,"_30219":2134,"_20927":55982,"_5":14373,"_27457":55909,"_2948":49644},[],{"_3465":2159,"_30219":2134,"_20927":55984,"_5":14373,"_27457":55909,"_2948":55985},[],"Initial value",{"_3465":2160,"_30219":2134,"_20927":55987,"_5":14373,"_27457":55909,"_2948":55988},[],"`validity`",{"_3465":2161,"_30219":2134,"_20927":55990,"_5":14373,"_27457":55909,"_2948":55991},[],"Time from `thisUpdate` to `nextUpdate`.",{"_3465":2162,"_30219":2134,"_20927":55993,"_5":14373,"_27457":55909,"_2948":55994},[],"7 days.",{"_3465":2163,"_30219":2134,"_20927":55996,"_5":14373,"_27457":55909,"_2948":55997},[],"`refresh_interval`",{"_3465":2164,"_30219":2134,"_20927":55999,"_5":14373,"_27457":55909,"_2948":56000},[],"Time since the issuance of the latest published CRL that triggers scheduled renewal; `0` disables only this trigger. The effective granularity is bounded by the job frequency (see Periodic and automatic regeneration).",{"_3465":2165,"_30219":2134,"_20927":56002,"_5":14373,"_27457":55909,"_2948":56003},[],"6 days and 23 hours.",{"_3465":2166,"_30219":2134,"_20927":56005,"_5":14373,"_27457":55909,"_2948":56006},[],"`regenerate_on_revoke`",{"_3465":2167,"_30219":2134,"_20927":56008,"_5":14373,"_27457":55909,"_2948":56009},[],"Request regeneration on revocation or reactivation from `CertificateHold` events.",{"_3465":2168,"_30219":2134,"_20927":56011,"_5":14373,"_27457":55909,"_2948":56012},[],"`true`.",{"_3465":2169,"_30219":2134,"_20927":56014,"_5":14373,"_27457":55909,"_2948":56015},[],"`signer_serial_number`",{"_3465":2170,"_30219":2134,"_20927":56017,"_5":14373,"_27457":55909,"_2948":56018},[],"Serial number of the existing certificate that signs the CRL.",{"_3465":2171,"_30219":2134,"_20927":56020,"_5":14373,"_27457":55909,"_2948":56021},[],"Serial number of the CA’s current certificate.",{"_3465":2172,"_30219":2134,"_20927":56023,"_5":14373,"_27457":55909,"_2948":56024},[],"The signer must be an existing certificate with the `cRLSign` key usage and the same subject and public key as the CA. Certificates from before a reissue qualify. A delegated signer is not supported: a certificate with the CA’s subject but a different key is rejected.",{"_3465":2173,"_30219":2134,"_20927":56026,"_5":14373,"_27457":55909,"_2948":56027},[],"When a CA is reissued and the signer is the superseded CA certificate, the VA moves the signer to the new certificate — provided it carries `cRLSign` — and republishes the CRL. If the new certificate lacks `cRLSign`, the VA keeps the previous signer and logs a warning. If the signer is any other certificate with the CA’s subject and key, it is deliberately left unchanged; the previous certificate then cannot be deleted while the settings use it (the API returns `409` `certificate is in use`), and to retire it you update the signer with `PUT`.",{"_3465":2174,"_30219":2134,"_20927":56029,"_5":14373,"_27457":55909,"_2948":56030},[],"A CA whose signer lacks `cRLSign` cannot generate its CRL, and an update that selects a signer without `cRLSign` is rejected (400 error). Since 4.0 the VA requires this usage. Check before importing with `openssl x509 -noout -ext keyUsage` and, if it is missing, obtain a certificate for the same CA and key that includes it and update the settings to use it as the signer. After reissuing a CA, also check the key usage of the new certificate: it may not keep the original’s usages, and without `cRLSign` the settings keep their previous signer.",{"_3465":2175,"_30219":2134,"_20927":56032,"_5":14373,"_27457":55909,"_2948":56033},[],"Deleting a CA keeps its CRL settings, and they cannot be removed through the API. What happens next depends on when the CA was deleted:",{"_3465":2176,"_30219":2134,"_20927":56035,"_5":14373,"_27457":55909,"_2948":56036},[],"The 4.0.0 upgrade migration archives the settings of the CAs that had been deleted before the upgrade. Their `status` is `ARCHIVED` and their `ca_id` is `legacy-<ski>`: the last CRL keeps being served, but it is never regenerated, any `PUT` returns 409, and there is no API way back to `ACTIVE`.",{"_3465":2177,"_30219":2134,"_20927":56038,"_5":14373,"_27457":55909,"_2948":56039},[],"A CA deleted while running 4.0.0 leaves `ACTIVE` settings. The last CRL keeps being served, but once it expires nothing regenerates it: the renewal job logs `something went wrong while calculating CRL for CA <ca-id>` on every cycle because it can no longer resolve the CA. The options can still be edited while the signer is unchanged; changing the signer fails, because there is no CA left to match it.",{"_3465":2178,"_30219":2134,"_20927":56041,"_5":14373,"_27457":55909,"_2948":56042},[],"Adjust validity and signer before deleting a CA.",{"_3465":2179,"_30219":2134,"_20927":56044,"_5":14373,"_27457":55909,"_2948":56045},[],"`PUT` validates the signer only when the request changes it. If the stored signer is no longer valid, the other options can still be edited, but the CRL cannot be regenerated until a valid signer is set.",{"_3465":2180,"_30219":2134,"_20927":56047,"_5":14373,"_27457":55909,"_2948":56048},[],"Sharing a key between CAs is a migration blocker: the 4.0.0 upgrade aborts while an SKI belongs to more than one CA. See CAs that share a key.",{"_3465":2181,"_30219":2134,"_20927":56050,"_5":14373,"_27457":55909,"_2948":56051},[],"CRL versions are kept as PEM in object storage at `pki/va/crl/<ca-id>/<version>.crl`; the public endpoint returns DER. CRLs published before the 4.0.0 upgrade remain at `pki/va/crl/<ski>/<version>.crl` and keep being served.",{"_3465":2182,"_30219":2134,"_20927":56053,"_5":14373,"_27457":55913,"_2948":56054},[],"Since 4.0.0, each CA publishes its own CRL even when its key is shared: two CAs with the same key have the same SKI, but each has its own CRL settings and its own list, signed by a certificate with that CA’s identity.",{"_3465":2183,"_30219":2134,"_20927":56056,"_5":14373,"_27457":55913,"_2948":56057},[],"Certificates issued from now on carry `/crl/<ca-id>` distribution points, so each CA’s certificates resolve to its own list. Certificates issued before the upgrade keep their `/crl/<ski>` distribution points: that URL keeps resolving to the settings the upgrade migrated, and always serves the list of the CA that owned that SKI when the upgrade ran. It is never rebound to a CA created later with the same key. After regeneration, the migrated list includes both URLs in its *Issuing Distribution Point* (OID `2.5.29.28`), so a verifier that compares the IDP with the CDP of the certificate accepts either form. Until the VA scheduled CRL job successfully regenerates it, the pre-upgrade list contains only the legacy `/crl/<ski>` IDP; IDP-checking verifiers cannot validate newly issued certificates with `/crl/<ca-id>` CDPs. The first run can take up to about an hour with the default schedule, and failures can extend the window.",{"_3465":2184,"_30219":2134,"_20927":56059,"_5":14373,"_27457":55913,"_2948":56060},[],"Sharing an SKI between CAs blocks the upgrade: the migration aborts and names the SKIs. To detect the problem before upgrading, compare the SKI of the CAs in the inventory: two with the same SKI are affected. To fix it, create a CA with its own key and reissue its certificates; those already issued keep the old URL and are not corrected until reissued.",{"_3465":2185,"_30219":2134,"_20927":56062,"_5":14373,"_27457":55913,"_2948":56063},[],"Lamassu takes the SKI of an imported certificate as-is and does not check that it corresponds to its public key. Until Lamassu rejects imports whose SKI collides with an existing CA — proposed in lamassuiot#834, together with the per-CA CRL that 4.0.0 implements — restrict the permission to import CAs as an interim control; it covers only the import path. Creating a CA with &#x2A;*Create New CA (Existing Key)** on a KMS key another CA already uses produces the same SKI collision, so avoid reusing keys across CAs.",{"_3465":2186,"_30219":2134,"_20927":56065,"_5":14373,"_27457":55917,"_2948":56066},[],"The VA scheduled job checks the CRL settings of every CA on each run and requests a new list when either of these conditions is met:",{"_3465":2187,"_30219":2134,"_20927":56068,"_5":14373,"_27457":55917,"_2948":56069},[],"**The list is about to expire:** the remaining validity of `latest_crl` is less than the interval between job runs. This condition always applies and cannot be disabled.",{"_3465":2188,"_30219":2134,"_20927":56071,"_5":14373,"_27457":55917,"_2948":56072},[],"**The refresh interval has elapsed:** the time since the issuance of the latest published CRL reaches `refresh_interval`. Setting `refresh_interval` to `0` disables only this condition; the list is still regenerated when it is about to expire.",{"_3465":2189,"_30219":2134,"_20927":56074,"_5":14373,"_27457":55917,"_2948":56075},[],"Setting `refresh_interval` to `0` therefore does not freeze regeneration. With the default 7-day validity and an hourly job, a CRL is renewed up to an hour before it expires even if `refresh_interval` is `0`. Because the job runs on its own schedule, `refresh_interval` is honored only as precisely as the job frequency allows.",{"_3465":2190,"_30219":2134,"_20927":56077,"_5":14373,"_27457":55917,"_2948":56078},[],"The job frequency is set in Helm with `services.va.job.crl.frequency` (default `0 * * * *`) and accepts a duration (`1h`) or a cron expression. A cron expression is converted into a constant interval equal to the time left until its next firing when the service starts, so it is not aligned with the clock. Keep `validity` well above that interval: with a shorter validity, the list is regenerated on every cycle.",{"_3465":2191,"_30219":2134,"_20927":56080,"_5":14373,"_27457":55917,"_2948":56081},[],"If generation fails (for example, because the CA cannot be resolved or the signer is invalid), the job logs the warning `something went wrong while calculating CRL for CA <ca-id>` and retries on the next cycle. There is no other renewal path until the cause is fixed, and the last published list keeps being served until it expires. All of this depends on working jobs, storage and signing.",{"_3465":2192,"_30219":2134,"_20927":56083,"_5":14373,"_27457":55917,"_2948":56084},[],"Settings whose `status` is `ARCHIVED` are skipped: nothing regenerates their CRL.",{"_3465":2193,"_30219":2134,"_20927":56086,"_5":14373,"_27457":55917,"_2948":56087},[],"With `regenerate_on_revoke`, the event handler requests a new CRL upon revocation or reactivation from `CertificateHold` to `ACTIVE`. This happens after the status change and has its own failure paths: if generation fails (for example, because of an invalid signer), the event is retried and, once retries are exhausted, moves to the failed-events queue. If the issuing CA has no CRL settings, there is no CRL to regenerate: the event is acknowledged without retry, the VA logs a warning, and nothing appears in the failed-events queue. Confirming revocation does not establish that the new CRL is already published or that all clients have downloaded it.",{"_3465":2194,"_30219":2134,"_20927":56089,"_5":14373,"_27457":55917,"_2948":56090},[],"Compare CRL numbers and timestamps before and after a change. Monitor expired lists and generation failures; clients must apply policy when current evidence is unavailable.",{"_3465":2195,"_30219":2134,"_20927":56092,"_5":14373,"_27457":55921,"_2948":56093},[],"Each entry contains serial number, revocation time and reason. The generator queries certificates in `REVOKED` state for the selected CA. A reactivated certificate disappears when the list is recalculated; an earlier downloaded copy retains its contents.",{"_3465":2196,"_30219":2134,"_20927":56095,"_5":14373,"_27457":55921,"_2948":56096},[],"The list contains a critical *Issuing Distribution Point* (OID `2.5.29.28`) with configured distribution URLs. Check that your client interprets this extension and that it matches the list’s scope. If rejected, investigate format and scope; ignoring a critical extension is not successful validation.",{"_3465":2197,"_30219":2134,"_20927":56098,"_5":14373,"_27457":55925,"_2948":56099},[],"The VA service exposes `GET /crl/{id}` without management authorization. Use the **issuing CA’s** ID, not the end-entity certificate’s ID or serial. Certificates issued before the 4.0.0 upgrade carry `/crl/<ski>` URLs with the SKI of the CA key; that form keeps resolving. First inspect the certificate’s CDP:",{"_3465":2198,"_30219":2134,"_20927":56101,"_5":14373,"_27457":55925,"_2948":56102},[],"Replace the following URL with the CDP URL and review exposure in Deployment:",{"_3465":2199,"_30219":2134,"_20927":56104,"_5":14373,"_27457":55925,"_2948":56105},[],"You need OpenSSL 3.x and `issuer.pem` containing the direct issuer’s certificate. An accepted signer certificate has the same subject and public key as the CA, so this signature check also works when the settings point to an earlier certificate for that CA and key. Require a valid signature, current timestamps and the expected issuer. For a root that issues directly:",{"_3465":2200,"_30219":2134,"_20927":56107,"_5":14373,"_27457":55925,"_2948":56108},[],"`roots.pem` contains deliberately trusted roots. For intermediates, add `-untrusted intermediates.pem` before the `device.crt` argument. `-crl_check` checks the end-entity certificate’s revocation against the local list; it does not download other lists or establish the status of the whole chain. A complete chain check needs the corresponding CRLs and a policy requiring them.",{"_3465":2201,"_30219":2134,"_20927":56110,"_5":14373,"_27457":55925,"_2948":56111},[],"The test should accept an allowed certificate absent from the list and reject it with `certificate revoked` after publishing and using the list containing its serial.",{"_3465":2202,"_30219":2134,"_20927":56113,"_5":14373,"_27457":55929,"_2948":56114},[],"The following paths are relative to the VA service; confirm the public prefix in the Gateway. They are not the URLs of the public OCSP and CRL endpoints.",{"_3465":2203,"_30219":2134,"_20927":56116,"_5":14373,"_27457":55929,"_2948":52499},[],{"_3465":2204,"_30219":2134,"_20927":56118,"_5":14373,"_27457":55929,"_2948":56119},[],"Relative path",{"_3465":2205,"_30219":2134,"_20927":56121,"_5":14373,"_27457":55929,"_2948":52496},[],{"_3465":2206,"_30219":2134,"_20927":56123,"_5":14373,"_27457":55929,"_2948":56124},[],"`GET`",{"_3465":2207,"_30219":2134,"_20927":56126,"_5":14373,"_27457":55929,"_2948":56127},[],"`/v1/crl-settings`",{"_3465":2208,"_30219":2134,"_20927":56129,"_5":14373,"_27457":55929,"_2948":56130},[],"List the CRL settings; filterable at least by `ca_id`, `status` and `legacy_ski`.",{"_3465":2209,"_30219":2134,"_20927":56132,"_5":14373,"_27457":55929,"_2948":56124},[],{"_3465":2210,"_30219":2134,"_20927":56134,"_5":14373,"_27457":55929,"_2948":56135},[],"`/v1/crl-settings/{ca-id}`",{"_3465":2211,"_30219":2134,"_20927":56137,"_5":14373,"_27457":55929,"_2948":56138},[],"Read the `crl_options` and `latest_crl` of a CA.",{"_3465":2212,"_30219":2134,"_20927":56140,"_5":14373,"_27457":55929,"_2948":56141},[],"`PUT`",{"_3465":2213,"_30219":2134,"_20927":56143,"_5":14373,"_27457":55929,"_2948":56135},[],{"_3465":2214,"_30219":2134,"_20927":56145,"_5":14373,"_27457":55929,"_2948":56146},[],"Replace the CRL configuration of a CA.",{"_3465":2215,"_30219":2134,"_20927":56148,"_5":14373,"_27457":55929,"_2948":56149},[],"You need authentication and CRL settings read or update permissions. Consult your installation’s API reference and Access control. Read current configuration before updating and send the full object expected by the contract — `refresh_interval`, `validity`, `signer_serial_number` and `regenerate_on_revoke`: the backend replaces all four; it does not merge omitted fields. `status`, `legacy_ski` and `latest_crl` are read-only. A `PUT` returns 409 when the settings are not `ACTIVE`, validates the signer only when it changes, and does not regenerate the CRL.",{"_3465":2216,"_30219":2134,"_20927":56151,"_5":14373,"_27457":55929,"_2948":56152},[],"After a change, check saved configuration and the next list actually published. Updating the settings alone does not establish regeneration or client acceptance.",{"_3465":2217,"_30219":2134,"_20927":56154,"_5":14373,"_27457":55933,"_2948":56155},[],"Symptom",{"_3465":2218,"_30219":2134,"_20927":56157,"_5":14373,"_27457":55933,"_2948":56158},[],"Cause",{"_3465":2219,"_30219":2134,"_20927":56160,"_5":14373,"_27457":55933,"_2948":56161},[],"Action",{"_3465":2220,"_30219":2134,"_20927":56163,"_5":14373,"_27457":55933,"_2948":56164},[],"`PUT /v1/crl-settings/{ca-id}` returns 409.",{"_3465":2221,"_30219":2134,"_20927":56166,"_5":14373,"_27457":55933,"_2948":56167},[],"The settings are not `ACTIVE`: the migration archived them because their CA was deleted before the upgrade.",{"_3465":2222,"_30219":2134,"_20927":56169,"_5":14373,"_27457":55933,"_2948":56170},[],"There is no API way back to `ACTIVE`. The last CRL keeps being served.",{"_3465":2223,"_30219":2134,"_20927":56172,"_5":14373,"_27457":55933,"_2948":56173},[],"`PUT` returns 400.",{"_3465":2224,"_30219":2134,"_20927":56175,"_5":14373,"_27457":55933,"_2948":56176},[],"The new signer lacks `cRLSign`, or its subject and public key do not match the CA.",{"_3465":2225,"_30219":2134,"_20927":56178,"_5":14373,"_27457":55933,"_2948":56179},[],"Set the serial number of a valid certificate of that CA.",{"_3465":2226,"_30219":2134,"_20927":56181,"_5":14373,"_27457":55933,"_2948":56182},[],"`PUT` returns 404.",{"_3465":2227,"_30219":2134,"_20927":56184,"_5":14373,"_27457":55933,"_2948":56185},[],"The CA or the new signer certificate does not exist (for example, the CA was deleted), or the CA has no CRL settings (for example, an imported CA).",{"_3465":2228,"_30219":2134,"_20927":56187,"_5":14373,"_27457":55933,"_2948":56188},[],"Check the CA ID and the signer serial number.",{"_3465":2229,"_30219":2134,"_20927":56190,"_5":14373,"_27457":55933,"_2948":56191},[],"`PUT` returns 400 from a 3.x client.",{"_3465":2230,"_30219":2134,"_20927":56193,"_5":14373,"_27457":55933,"_2948":56194},[],"`crl_options.subject_key_id_signer` was replaced by `crl_options.signer_serial_number`, which is required.",{"_3465":2231,"_30219":2134,"_20927":56196,"_5":14373,"_27457":55933,"_2948":56197},[],"Update the client to send the new field.",{"_3465":2232,"_30219":2134,"_20927":56199,"_5":14373,"_27457":55933,"_2948":56200},[],"The CRL does not change after revoking a certificate.",{"_3465":2233,"_30219":2134,"_20927":56202,"_5":14373,"_27457":55933,"_2948":56203},[],"`regenerate_on_revoke` is `false`, the issuing CA has no CRL settings, or generation failed because of an invalid signer.",{"_3465":2234,"_30219":2134,"_20927":56205,"_5":14373,"_27457":55933,"_2948":56206},[],"Check the VA logs. Missing settings only produce a warning (no retry, no failed-events entry); an invalid signer also leaves the event in the failed-events queue, so fix the signer.",{"_3465":2235,"_30219":2134,"_20927":56208,"_5":14373,"_27457":55933,"_2948":56209},[],"A verifier rejects the CRL because of the issuer.",{"_3465":2236,"_30219":2134,"_20927":56211,"_5":14373,"_27457":55933,"_2948":56212},[],"The list was fetched through a legacy `/crl/<ski>` URL and belongs to the CA that owned that SKI when the upgrade ran.",{"_3465":2237,"_30219":2134,"_20927":56214,"_5":14373,"_27457":55933,"_2948":56215},[],"Use the CDP of the certificate being validated: certificates issued in 4.0.0 carry `/crl/<ca-id>` URLs.",{"_3465":2238,"_30219":2134,"_20927":56217,"_5":14373,"_27457":55937,"_2948":56218},[],"The CA view lets you inspect and download the available list. Compare version, issuer and timestamps with the copy downloaded from the public endpoint. The CA’s VA settings also let you select the CRL signer: the certificate picker only offers certificates that have a private key and carry the `cRLSign` key usage. If a configured signer’s certificate cannot be resolved, the interface shows `Unknown Certificate (Serial: X)` or `Certificate details unavailable (Serial: X)`. Diagnose differences using PKI troubleshooting.",{"_3465":2239,"_30219":2134,"_20927":56220,"_5":14373,"_27457":55941,"_2948":56221},[],"RFC 5280: X.509 and CRL profile.",{"_3465":2240,"_30219":2134,"_20927":56223,"_5":14373,"_27457":55941,"_2948":56224},[],"OpenSSL: openssl-crl.",{"_3465":2241,"_30219":2134,"_20927":56226,"_5":14373,"_27457":55941,"_2948":56227},[],"OpenSSL: openssl-verify.",{"_3465":2242,"_30219":2134,"_20927":56229,"_5":14373,"_27457":55941,"_2948":56230},[],"<Card title=\"OCSP service\" href=\"/docs/platform/pki/ocsp\" />",{"_3465":2243,"_30219":2134,"_20927":56232,"_5":14373,"_27457":55941,"_2948":56233},[],"<Card title=\"Certificate validation\" href=\"/docs/platform/pki/certificate-validation\" />",{"_3465":2244,"_30219":2244,"_5":14725,"_2948":56235,"_30551":56236,"_20927":56237,"_27457":2244},"Keys and cryptographic engines",[49254,50729,54734,54735],[],{"_3465":2245,"_30219":2244,"_20927":56239,"_5":14373,"_27457":2244,"_2948":56240},[],"Generate, import and operate keys without coupling the PKI to a specific provider.",{"_3465":2246,"_30219":2244,"_5":30548,"_20927":56242,"_27457":56243,"_2948":56244},[],"/docs/platform/pki/key-management#what-the-kms-solves","What the KMS solves",{"_3465":2247,"_30219":2244,"_5":30548,"_20927":56246,"_27457":56247,"_2948":56248},[],"/docs/platform/pki/key-management#cryptographic-engines","Cryptographic engines",{"_3465":2248,"_30219":2244,"_5":30548,"_20927":56250,"_27457":56251,"_2948":56252},[],"/docs/platform/pki/key-management#file-system","File System",{"_3465":2249,"_30219":2244,"_5":30548,"_20927":56254,"_27457":56255,"_2948":56256},[],"/docs/platform/pki/key-management#hashicorp-vault","HashiCorp Vault",{"_3465":2250,"_30219":2244,"_5":30548,"_20927":56258,"_27457":56259,"_2948":56260},[],"/docs/platform/pki/key-management#aws-secrets-manager","AWS Secrets Manager",{"_3465":2251,"_30219":2244,"_5":30548,"_20927":56262,"_27457":56263,"_2948":56264},[],"/docs/platform/pki/key-management#aws-kms","AWS KMS",{"_3465":2252,"_30219":2244,"_5":30548,"_20927":56266,"_27457":56267,"_2948":56268},[],"/docs/platform/pki/key-management#pkcs11","PKCS#11",{"_3465":2253,"_30219":2244,"_5":30548,"_20927":56270,"_27457":56271,"_2948":56272},[],"/docs/platform/pki/key-management#azure-key-vault","Azure Key Vault",{"_3465":2254,"_30219":2244,"_5":30548,"_20927":56274,"_27457":56275,"_2948":56276},[],"/docs/platform/pki/key-management#key-inventory","Key inventory",{"_3465":2255,"_30219":2244,"_5":30548,"_20927":56278,"_27457":56279,"_2948":56280},[],"/docs/platform/pki/key-management#create-or-import-keys","Create or import keys",{"_3465":2256,"_30219":2244,"_5":30548,"_20927":56282,"_27457":56283,"_2948":56284},[],"/docs/platform/pki/key-management#generate-a-new-key-pair","Generate a new key pair",{"_3465":2257,"_30219":2244,"_5":30548,"_20927":56286,"_27457":56287,"_2948":56288},[],"/docs/platform/pki/key-management#import-an-existing-pair","Import an existing pair",{"_3465":2258,"_30219":2244,"_5":30548,"_20927":56290,"_27457":56291,"_2948":56292},[],"/docs/platform/pki/key-management#operations-on-a-key","Operations on a key",{"_3465":2259,"_30219":2244,"_5":30548,"_20927":56294,"_27457":56295,"_2948":56296},[],"/docs/platform/pki/key-management#view-details","View details",{"_3465":2260,"_30219":2244,"_5":30548,"_20927":56298,"_27457":56299,"_2948":56300},[],"/docs/platform/pki/key-management#sign-and-verify","Sign and verify",{"_3465":2261,"_30219":2244,"_5":30548,"_20927":56302,"_27457":56303,"_2948":56304},[],"/docs/platform/pki/key-management#sign","Sign",{"_3465":2262,"_30219":2244,"_5":30548,"_20927":56306,"_27457":56307,"_2948":56308},[],"/docs/platform/pki/key-management#verify","Verify",{"_3465":2263,"_30219":2244,"_5":30548,"_20927":56310,"_27457":56311,"_2948":56312},[],"/docs/platform/pki/key-management#generate-a-csr","Generate a CSR",{"_3465":2264,"_30219":2244,"_5":30548,"_20927":56314,"_27457":56315,"_2948":56316},[],"/docs/platform/pki/key-management#sign-locally-with-pkcs11","Sign locally with PKCS#11",{"_3465":2265,"_30219":2244,"_5":30548,"_20927":56318,"_27457":56319,"_2948":56320},[],"/docs/platform/pki/key-management#before-deleting-a-key","Before deleting a key",{"_3465":2266,"_30219":2244,"_20927":56322,"_5":14373,"_27457":2244,"_2948":56323},[],"The Cryptographic Key Management Service (KMS) of Lamassu IoT centralizes the generation, import, custody and use of the platform's keys. This is where you manage the keys that support the CAs and the rest of the signing operations that depend on the PKI.",{"_3465":2267,"_30219":2244,"_20927":56325,"_5":14373,"_27457":2244,"_2948":56326},[],"In the current configuration, Lamassu IoT works exclusively with asymmetric keys, such as RSA and elliptic curves. These keys are used to issue X.509 certificates, sign requests and perform authentication and validation operations within the system.",{"_3465":2268,"_30219":2244,"_20927":56328,"_5":14373,"_27457":56243,"_2948":56329},[],"The KMS unifies key lifecycle management and prevents every service from having to integrate directly with a specific cryptographic provider.",{"_3465":2269,"_30219":2244,"_20927":56331,"_5":14373,"_27457":56243,"_2948":56332},[],"In practice, it lets you:",{"_3465":2270,"_30219":2244,"_20927":56334,"_5":14373,"_27457":56243,"_2948":56335},[],"Generate new key pairs from Lamassu IoT.",{"_3465":2271,"_30219":2244,"_20927":56337,"_5":14373,"_27457":56243,"_2948":56338},[],"Import keys created externally.",{"_3465":2272,"_30219":2244,"_20927":56340,"_5":14373,"_27457":56243,"_2948":56341},[],"Delegate custody and cryptographic operations to external engines.",{"_3465":2273,"_30219":2244,"_20927":56343,"_5":14373,"_27457":56243,"_2948":56344},[],"Reuse existing keys for CAs, CSRs and signing or verification tasks.",{"_3465":2274,"_30219":2244,"_20927":56346,"_5":14373,"_27457":56247,"_2948":56347},[],"Lamassu can work with different cryptographic engines depending on deployment requirements. In some environments a software engine is enough; in others custody must be delegated to an HSM, a cloud service or a specialized platform.",{"_3465":2275,"_30219":2244,"_20927":56349,"_5":14373,"_27457":56247,"_2948":56350},[],"A single instance can have several engines configured at the same time, including multiple instances of the same type. This lets you adapt operations to different security, cost and regulatory requirements.",{"_3465":2276,"_30219":2244,"_20927":56352,"_5":14373,"_27457":56247,"_2948":56353},[],"This guide is for the PKI operator: select and use an already enabled engine. Installation, credentials, persistent storage and connectivity belong to Deployment. Before generating a CA, check the default engine, advertised algorithms and a test signature. Availability in your installation depends on its version and configuration.",{"_3465":2277,"_30219":2244,"_20927":56355,"_5":14373,"_27457":56251,"_2948":56356},[],"Generates software keys and stores private material in files. Custody depends on installation permissions, storage and backups. Before using it for an operational CA, agree how the key will be recovered and how replicas will access it; the KMS record does not replace those files.",{"_3465":2278,"_30219":2244,"_20927":56358,"_5":14373,"_27457":56255,"_2948":56359},[],"The adapter uses KV storage for private material. This is not signing within Vault Transit: someone able to read the secret can recover the key. Review read permissions, availability and recovery with the deployment owner.",{"_3465":2279,"_30219":2244,"_20927":56361,"_5":14373,"_27457":56255,"_2948":56362},[],"The adapter reaches Vault over its configured HTTP(S) endpoint. The Vault server certificate is verified against the system trust store; a Vault signed by a private CA is trusted by adding its CA certificate to the engine's `ca_cert_file` (PEM-encoded). `insecure_skip_verify=true` disables verification and is a last resort; agree the transport settings with the deployment owner.",{"_3465":2280,"_30219":2244,"_20927":56364,"_5":14373,"_27457":56259,"_2948":56365},[],"Offers encrypted persistence in AWS at a cost. It protects the key at rest, but an authorized administrator can recover it; it does not provide the same extraction resistance as a KMS or HSM.",{"_3465":2281,"_30219":2244,"_20927":56367,"_5":14373,"_27457":56263,"_2948":56368},[],"Delegates signing to AWS KMS. The adapter also implements external material import, subject to provider capabilities and permissions. A key generated outside the service has already existed outside its custody; importing it does not remove those copies. Check generation, import and signing as separate operations.",{"_3465":2282,"_30219":2244,"_20927":56370,"_5":14373,"_27457":56267,"_2948":56371},[],"Allows integrating local HSMs, isolated environments and *Key as a Service* offerings. Generation, persistence and extraction resistance depend on the specific device or provider. It is the most flexible option when policy requires hardware custody.",{"_3465":2283,"_30219":2244,"_20927":56373,"_5":14373,"_27457":56271,"_2948":56374},[],"The backend also provides adapters for **Key Vault Keys** and **Key Vault Secrets**. The former delegates signing to the key service; the latter stores private material as secrets and signs using that material. These are different custody models. Confirm which adapter is enabled in your installation and test the required operations.",{"_3465":2284,"_30219":2244,"_20927":56376,"_5":14373,"_27457":56271,"_2948":56377},[],"Lamassu shows the enabled engines in the console.",{"_3465":2285,"_30219":2244,"_20927":56379,"_5":14373,"_27457":56271,"_2948":56380},[],"Each engine defines which algorithms it supports, such as RSA or ECC/ECDSA, and which key sizes it can generate.",{"_3465":2286,"_30219":2244,"_20927":56382,"_5":14373,"_27457":56271,"_2948":56383},[],"Confirm with the deployment operator which engine is configured as the default. That engine will be used when a process needs to create or persist a key and the user has not selected a specific one, for example when creating or importing a CA.",{"_3465":2287,"_30219":2244,"_20927":56385,"_5":14373,"_27457":56275,"_2948":56386},[],"The main KMS screen shows the complete inventory of keys registered in the system. It is the reference view for reviewing which keys exist, where they are kept and which entities they relate to.",{"_3465":2288,"_30219":2244,"_20927":56388,"_5":14373,"_27457":56275,"_2948":56389},[],"The table includes the following fields:",{"_3465":2289,"_30219":2244,"_20927":56391,"_5":14373,"_27457":56275,"_2948":56392},[],"**Name**: descriptive name of the key.",{"_3465":2290,"_30219":2244,"_20927":56394,"_5":14373,"_27457":56275,"_2948":56395},[],"**Type**: algorithm and key size, for example RSA 2048 or EC P-256.",{"_3465":2291,"_30219":2244,"_20927":56397,"_5":14373,"_27457":56275,"_2948":56398},[],"**Strength**: visual indicator of cryptographic strength.",{"_3465":2292,"_30219":2244,"_20927":56400,"_5":14373,"_27457":56275,"_2948":56401},[],"**Public/Private**: whether Lamassu manages the full pair or only the public key.",{"_3465":2293,"_30219":2244,"_20927":56403,"_5":14373,"_27457":56275,"_2948":56404},[],"**Crypto Engine**: cryptographic engine keeping the key.",{"_3465":2294,"_30219":2244,"_20927":56406,"_5":14373,"_27457":56275,"_2948":56407},[],"**Aliases**: alternative names associated with the key.",{"_3465":2295,"_30219":2244,"_20927":56409,"_5":14373,"_27457":56275,"_2948":56410},[],"**Tags**: labels for classification and search.",{"_3465":2296,"_30219":2244,"_20927":56412,"_5":14373,"_27457":56275,"_2948":56413},[],"**Related Entities**: certificates or other entities linked to that key.",{"_3465":2297,"_30219":2244,"_20927":56415,"_5":14373,"_27457":56275,"_2948":56416},[],"From this view you also reach the most common actions:",{"_3465":2298,"_30219":2244,"_20927":56418,"_5":14373,"_27457":56275,"_2948":56419},[],"**View Details** to inspect metadata, identifiers and relationships.",{"_3465":2299,"_30219":2244,"_20927":56421,"_5":14373,"_27457":56275,"_2948":56422},[],"**Generate CSR** to create a PKCS#10 request with the selected key.",{"_3465":2300,"_30219":2244,"_20927":56424,"_5":14373,"_27457":56275,"_2948":56425},[],"**Sign / Verify** to test cryptographic operations on the key.",{"_3465":2301,"_30219":2244,"_20927":56427,"_5":14373,"_27457":56275,"_2948":56428},[],"**Delete Key** to remove the key from the system.",{"_3465":2302,"_30219":2244,"_20927":56430,"_5":14373,"_27457":56279,"_2948":56431},[],"You need key administration permissions and a reachable engine. The issuance profile must allow the chosen algorithm if the key will be used in a CA or CSR. Open **Create New Key** and choose generation or import.",{"_3465":2303,"_30219":2244,"_20927":56433,"_5":14373,"_27457":56283,"_2948":56434},[],"If the key will be born inside Lamassu, the recommended flow is to generate a new pair managed directly by one of the configured engines.",{"_3465":2304,"_30219":2244,"_20927":56436,"_5":14373,"_27457":56283,"_2948":56437},[],"On the wizard's first screen, choose **Generate New Key Pair** and then define the main parameters:",{"_3465":2305,"_30219":2244,"_20927":56439,"_5":14373,"_27457":56283,"_2948":56440},[],"**Key Name**: unique and descriptive name.",{"_3465":2306,"_30219":2244,"_20927":56442,"_5":14373,"_27457":56283,"_2948":56443},[],"**Crypto Engine**: engine that will keep the key.",{"_3465":2307,"_30219":2244,"_20927":56445,"_5":14373,"_27457":56283,"_2948":56446},[],"**Key Type** and **Key Size**: algorithm and size or curve.",{"_3465":2308,"_30219":2244,"_20927":56448,"_5":14373,"_27457":56283,"_2948":56449},[],"**Tags**: metadata to classify the key.",{"_3465":2309,"_30219":2244,"_20927":56451,"_5":14373,"_27457":56283,"_2948":56452},[],"**Metadata**: additional information for advanced uses.",{"_3465":2310,"_30219":2244,"_20927":56454,"_5":14373,"_27457":56287,"_2948":56455},[],"Importing lets you register in Lamassu a key generated outside the platform. It is the usual flow in BYOK scenarios, migrations or integration with cryptographic material already in production.",{"_3465":2311,"_30219":2244,"_20927":56457,"_5":14373,"_27457":56287,"_2948":56458},[],"When you have an exportable private key and the destination engine supports import.",{"_3465":2312,"_30219":2244,"_20927":56460,"_5":14373,"_27457":56287,"_2948":56461},[],"When an existing PKI needs to be migrated without reissuing certificates.",{"_3465":2313,"_30219":2244,"_20927":56463,"_5":14373,"_27457":56287,"_2948":56464},[],"When Lamassu must operate with a root of trust created by a third party.",{"_3465":2314,"_30219":2244,"_20927":56466,"_5":14373,"_27457":56287,"_2948":56467},[],"In the wizard, choose **Import Existing Key Pair** and complete the requested fields:",{"_3465":2315,"_30219":2244,"_20927":56469,"_5":14373,"_27457":56287,"_2948":56470},[],"**Key Name**: descriptive name within Lamassu IoT.",{"_3465":2316,"_30219":2244,"_20927":56472,"_5":14373,"_27457":56287,"_2948":56473},[],"**Crypto Engine**: engine that will keep the imported key.",{"_3465":2317,"_30219":2244,"_20927":56475,"_5":14373,"_27457":56287,"_2948":56476},[],"**Tags**: labels for organization and search.",{"_3465":2318,"_30219":2244,"_20927":56478,"_5":14373,"_27457":56287,"_2948":56479},[],"**Metadata**: additional optional information.",{"_3465":2319,"_30219":2244,"_20927":56481,"_5":14373,"_27457":56287,"_2948":56482},[],"**Private Key (PEM)**: private key in PEM format.",{"_3465":2320,"_30219":2244,"_20927":56484,"_5":14373,"_27457":56287,"_2948":56485},[],"After a successful import, open the record, check the engine and public key, and perform a test signature. A non-exportable HSM key cannot be uploaded through this PEM form: configure engine access and check how the existing key is registered. Review dependencies and any provider resources already created if an operation fails partway through.",{"_3465":2321,"_30219":2244,"_20927":56487,"_5":14373,"_27457":56291,"_2948":56488},[],"Each registered key has a detail view and several operational actions.",{"_3465":2322,"_30219":2244,"_20927":56490,"_5":14373,"_27457":56295,"_2948":56491},[],"The **View Details** screen concentrates the technical and administrative information of the key.",{"_3465":2323,"_30219":2244,"_20927":56493,"_5":14373,"_27457":56295,"_2948":56494},[],"The **Overview** tab shows, among others, these fields:",{"_3465":2324,"_30219":2244,"_20927":56496,"_5":14373,"_27457":56295,"_2948":56497},[],"**Key Name**: descriptive name.",{"_3465":2325,"_30219":2244,"_20927":56499,"_5":14373,"_27457":56295,"_2948":56500},[],"**Key Identifier**: unique system identifier. Lamassu uses PKCS11-based ID formats.",{"_3465":2326,"_30219":2244,"_20927":56502,"_5":14373,"_27457":56295,"_2948":56503},[],"**Tags**: associated labels.",{"_3465":2327,"_30219":2244,"_20927":56505,"_5":14373,"_27457":56295,"_2948":56506},[],"**Aliases**: alternative names.",{"_3465":2328,"_30219":2244,"_20927":56508,"_5":14373,"_27457":56295,"_2948":56509},[],"**Crypto Engine**: engine where the key resides.",{"_3465":2329,"_30219":2244,"_20927":56511,"_5":14373,"_27457":56295,"_2948":56512},[],"**Algorithm, Key Size & Strength**: algorithm, parameters and strength level.",{"_3465":2330,"_30219":2244,"_20927":56514,"_5":14373,"_27457":56295,"_2948":56515},[],"The **Related Entities** section shows which Lamassu objects depend on that key.",{"_3465":2331,"_30219":2244,"_20927":56517,"_5":14373,"_27457":56295,"_2948":56518},[],"The **Public Key** tab shows public material in PEM. The record’s identifier and URI locate the key; a PKCS#11-formatted URI does not establish that the engine is an HSM or that a local module can access it.",{"_3465":2332,"_30219":2244,"_20927":56520,"_5":14373,"_27457":56299,"_2948":56521},[],"The **Sign / Verify** action validates that the key and the cryptographic engine work correctly.",{"_3465":2333,"_30219":2244,"_20927":56523,"_5":14373,"_27457":56299,"_2948":56524},[],"Sign a test message, save the signature and verify it using the same public key, algorithm and encoding. Then change the message: verification should fail. This tests one operation; it does not establish every engine capability or a CA’s chain.",{"_3465":2334,"_30219":2244,"_20927":56526,"_5":14373,"_27457":56299,"_2948":56527},[],"When you open it, two areas appear: **Sign** and **Verify**.",{"_3465":2335,"_30219":2244,"_20927":56529,"_5":14373,"_27457":56303,"_2948":56530},[],"This tab uses the private key to generate a digital signature over a message or an already computed *digest*.",{"_3465":2336,"_30219":2244,"_20927":56532,"_5":14373,"_27457":56303,"_2948":56533},[],"Main fields:",{"_3465":2337,"_30219":2244,"_20927":56535,"_5":14373,"_27457":56303,"_2948":56536},[],"**Algorithm**: signing algorithm available for the key type.",{"_3465":2338,"_30219":2244,"_20927":56538,"_5":14373,"_27457":56303,"_2948":56539},[],"**Message Type**: `Raw` for clear data or `Digest` for a precomputed hash.",{"_3465":2339,"_30219":2244,"_20927":56541,"_5":14373,"_27457":56303,"_2948":56542},[],"**Payload Encoding**: input encoding, such as UTF-8, Hex or Base64.",{"_3465":2340,"_30219":2244,"_20927":56544,"_5":14373,"_27457":56303,"_2948":56545},[],"**Message**: content to sign.",{"_3465":2341,"_30219":2244,"_20927":56547,"_5":14373,"_27457":56303,"_2948":56548},[],"**Signature**: result of the operation, shown in hexadecimal.",{"_3465":2342,"_30219":2244,"_20927":56550,"_5":14373,"_27457":56307,"_2948":56551},[],"This tab checks whether a signature corresponds to the associated public key.",{"_3465":2343,"_30219":2244,"_20927":56553,"_5":14373,"_27457":56307,"_2948":56533},[],{"_3465":2344,"_30219":2244,"_20927":56555,"_5":14373,"_27457":56307,"_2948":56556},[],"**Algorithm**: must match the algorithm used for the signature.",{"_3465":2345,"_30219":2244,"_20927":56558,"_5":14373,"_27457":56307,"_2948":56559},[],"**Message Type**: `Raw` or `Digest`.",{"_3465":2346,"_30219":2244,"_20927":56561,"_5":14373,"_27457":56307,"_2948":56562},[],"**Payload Encoding**: encoding of the message.",{"_3465":2347,"_30219":2244,"_20927":56564,"_5":14373,"_27457":56307,"_2948":56565},[],"**Message**: original message or hash.",{"_3465":2348,"_30219":2244,"_20927":56567,"_5":14373,"_27457":56307,"_2948":56568},[],"**Signature**: signature to check.",{"_3465":2349,"_30219":2244,"_20927":56570,"_5":14373,"_27457":56307,"_2948":56571},[],"**Result**: indicator of the validation result.",{"_3465":2350,"_30219":2244,"_20927":56573,"_5":14373,"_27457":56311,"_2948":56574},[],"The **Generate CSR** action creates a PKCS#10 request signed with the private key kept in Lamassu, without exposing it outside the cryptographic engine.",{"_3465":2351,"_30219":2244,"_20927":56576,"_5":14373,"_27457":56311,"_2948":56577},[],"This flow is useful for:",{"_3465":2352,"_30219":2244,"_20927":56579,"_5":14373,"_27457":56311,"_2948":56580},[],"Requesting certificates from an external CA.",{"_3465":2353,"_30219":2244,"_20927":56582,"_5":14373,"_27457":56311,"_2948":56583},[],"Renewing an identity while keeping the same key.",{"_3465":2354,"_30219":2244,"_20927":56585,"_5":14373,"_27457":56311,"_2948":56586},[],"When you open the form, it asks for the subject data and the main certificate attributes:",{"_3465":2355,"_30219":2244,"_20927":56588,"_5":14373,"_27457":56311,"_2948":56589},[],"**Common Name (CN)**: main name of the identity.",{"_3465":2356,"_30219":2244,"_20927":56591,"_5":14373,"_27457":56311,"_2948":56592},[],"**Organization (O)**: organization or company.",{"_3465":2357,"_30219":2244,"_20927":56594,"_5":14373,"_27457":56311,"_2948":56595},[],"**Organizational Unit (OU)**: department or unit.",{"_3465":2358,"_30219":2244,"_20927":56597,"_5":14373,"_27457":56311,"_2948":56598},[],"**Country (C)**: two-letter country code.",{"_3465":2359,"_30219":2244,"_20927":56600,"_5":14373,"_27457":56311,"_2948":56601},[],"**State / Province (ST)**: state or province.",{"_3465":2360,"_30219":2244,"_20927":56603,"_5":14373,"_27457":56311,"_2948":56604},[],"**Locality (L)**: city or locality.",{"_3465":2361,"_30219":2244,"_20927":56606,"_5":14373,"_27457":56311,"_2948":56607},[],"**Email Address**: contact email.",{"_3465":2362,"_30219":2244,"_20927":56609,"_5":14373,"_27457":56311,"_2948":56610},[],"**Subject Alternative Names (SANs)**: alternative names or identifiers, such as DNS or IP.",{"_3465":2363,"_30219":2244,"_20927":56612,"_5":14373,"_27457":56311,"_2948":56613},[],"Download the CSR and run `openssl req -in request.csr -noout -verify -text`. Check signature, subject and SAN before sending it. A CSR does not determine the final certificate by itself: issuance policy can replace its fields.",{"_3465":2364,"_30219":2244,"_20927":56615,"_5":14373,"_27457":56315,"_2948":56616},[],"Lamassu also offers specific help for local integrations through **Sign locally with OpenSSL & PKCS11 tools**.",{"_3465":2365,"_30219":2244,"_20927":56618,"_5":14373,"_27457":56315,"_2948":56619},[],"It requires the module, token and permissions of the corresponding provider. Check that the Lamassu identifier matches the object accessible from that module. Module configuration belongs to the client environment or Deployment.",{"_3465":2366,"_30219":2244,"_20927":56621,"_5":14373,"_27457":56319,"_2948":56622},[],"Review **Related Entities** and locate CAs, certificates and validation processes that still need signatures. Revoking a CA does not remove the need to publish status during its retention period. Deleting a key does not automatically revoke its certificates either. Plan replacement and retention before using **Delete Key**; provider deletion behavior depends on the engine.",{"_3465":2367,"_30219":2244,"_20927":56624,"_5":14373,"_27457":56319,"_2948":56625},[],"The KMS refuses to delete a key that certificates still reference, with `409` `key is in use`. Revoking a certificate or letting it expire does not release its key reference. Deleting a CA releases the references from its own current certificate and linked reissued certificates, which stay in place to back the CRL and OCSP, and then attempts to delete the key. If other certificates still reference the key, such as another CA sharing it, the KMS keeps it. The certificates the CA issued keep their own key references, even when revoked. The API lets you delete such a certificate only once its issuer CA no longer exists, and deleting it removes it from the CRL and OCSP responses, so keep revoked certificates for their retention period and delete only expired or superseded ones. Legacy references retained by the upgrade migration are described in the upgrade guide.",{"_3465":2368,"_30219":2368,"_5":14725,"_2948":56627,"_30551":56628,"_20927":56629,"_27457":2368},"Online validation with OCSP",[49254,50729,54734,55373],[],{"_3465":2369,"_30219":2368,"_20927":56631,"_5":14373,"_27457":2368,"_2948":56632},[],"Query signed status and verify the responder’s response.",{"_3465":2370,"_30219":2368,"_5":30548,"_20927":56634,"_27457":56635,"_2948":56636},[],"/docs/platform/pki/ocsp#how-the-responder-works-in-lamassu","How the responder works in Lamassu",{"_3465":2371,"_30219":2368,"_5":30548,"_20927":56638,"_27457":56639,"_2948":56640},[],"/docs/platform/pki/ocsp#embedding-in-issued-certificates","Embedding in issued certificates",{"_3465":2372,"_30219":2368,"_5":30548,"_20927":56642,"_27457":56643,"_2948":56644},[],"/docs/platform/pki/ocsp#http-endpoints","HTTP endpoints",{"_3465":2373,"_30219":2368,"_5":30548,"_20927":56646,"_27457":56647,"_2948":56648},[],"/docs/platform/pki/ocsp#generate-and-verify-a-query","Generate and verify a query",{"_3465":2374,"_30219":2368,"_5":30548,"_20927":56650,"_27457":56651,"_2948":56652},[],"/docs/platform/pki/ocsp#check-from-the-interface","Check from the interface",{"_3465":2375,"_30219":2368,"_5":30548,"_20927":56654,"_27457":56655,"_2948":55942},[],"/docs/platform/pki/ocsp#references",{"_3465":2376,"_30219":2368,"_20927":56657,"_5":14373,"_27457":2368,"_2948":56658},[],"OCSP queries a certificate’s status and returns a signed response. This guide is for an integrator checking what Lamassu publishes and how the consumer must verify it. For complete identity validation, follow Certificate validation.",{"_3465":2377,"_30219":2368,"_20927":56660,"_5":14373,"_27457":56635,"_2948":56661},[],"The responder retrieves the certificate by serial number and locates its issuing CA in the inventory. It translates persisted status as follows:",{"_3465":2378,"_30219":2368,"_20927":56663,"_5":14373,"_27457":56635,"_2948":56664},[],"Record status",{"_3465":2379,"_30219":2368,"_20927":56666,"_5":14373,"_27457":56635,"_2948":56667},[],"Signed response",{"_3465":2380,"_30219":2368,"_20927":56669,"_5":14373,"_27457":56635,"_2948":53871},[],{"_3465":2381,"_30219":2368,"_20927":56671,"_5":14373,"_27457":56635,"_2948":56672},[],"`Good`.",{"_3465":2382,"_30219":2368,"_20927":56674,"_5":14373,"_27457":56635,"_2948":53888},[],{"_3465":2383,"_30219":2368,"_20927":56676,"_5":14373,"_27457":56635,"_2948":56677},[],"`Revoked`, with revocation reason and timestamp.",{"_3465":2384,"_30219":2368,"_20927":56679,"_5":14373,"_27457":56635,"_2948":56680},[],"Other states, including `INACTIVE` and `EXPIRED`",{"_3465":2385,"_30219":2368,"_20927":56682,"_5":14373,"_27457":56635,"_2948":56683},[],"`Unknown` if the certificate and issuer can be retrieved.",{"_3465":2386,"_30219":2368,"_20927":56685,"_5":14373,"_27457":56635,"_2948":56686},[],"An absent serial number causes a lookup error; it does not guarantee a signed `Unknown` response. Lookup or signing errors produce an HTTP failure. Treat that as unavailable evidence according to consumer policy.",{"_3465":2387,"_30219":2368,"_20927":56688,"_5":14373,"_27457":56635,"_2948":56689},[],"The issuing CA itself signs the response through its KMS-associated key. A delegated OCSP signing certificate is not used. An imported CA without a usable key cannot sign responses.",{"_3465":2388,"_30219":2368,"_20927":56691,"_5":14373,"_27457":56635,"_2948":56692},[],"The implementation sets `thisUpdate` approximately one day before response generation and `nextUpdate` one day after: the declared window is about 48 hours. Inspect received values and apply your freshness policy. The response reflects stored status when queried; a previously cached copy does not change upon revocation.",{"_3465":2389,"_30219":2368,"_20927":56694,"_5":14373,"_27457":56639,"_2948":56695},[],"The signer constructs OCSP URLs from configured VA domains and adds them to AIA. Without domains, there is no URL to add; an imported certificate retains its original extensions. Inspect the actual certificate:",{"_3465":2390,"_30219":2368,"_20927":56697,"_5":14373,"_27457":56639,"_2948":56698},[],"Check that the consumer can reach this URL. DNS, endpoint exposure and domain configuration belong to Deployment. Changing configuration does not modify already signed certificates.",{"_3465":2391,"_30219":2368,"_20927":56700,"_5":14373,"_27457":56643,"_2948":56701},[],"The service accepts:",{"_3465":2392,"_30219":2368,"_20927":56703,"_5":14373,"_27457":56643,"_2948":52499},[],{"_3465":2393,"_30219":2368,"_20927":56705,"_5":14373,"_27457":56643,"_2948":56706},[],"VA service path",{"_3465":2394,"_30219":2368,"_20927":56708,"_5":14373,"_27457":56643,"_2948":56709},[],"Format",{"_3465":2395,"_30219":2368,"_20927":56711,"_5":14373,"_27457":56643,"_2948":56712},[],"`POST`",{"_3465":2396,"_30219":2368,"_20927":56714,"_5":14373,"_27457":56643,"_2948":56715},[],"`/ocsp`",{"_3465":2397,"_30219":2368,"_20927":56717,"_5":14373,"_27457":56643,"_2948":56718},[],"DER request, `Content-Type: application/ocsp-request`.",{"_3465":2398,"_30219":2368,"_20927":56720,"_5":14373,"_27457":56643,"_2948":56124},[],{"_3465":2399,"_30219":2368,"_20927":56722,"_5":14373,"_27457":56643,"_2948":56723},[],"`/ocsp/{ocsp_request}`",{"_3465":2400,"_30219":2368,"_20927":56725,"_5":14373,"_27457":56643,"_2948":56726},[],"DER request encoded using padded URL Base64.",{"_3465":2401,"_30219":2368,"_20927":56728,"_5":14373,"_27457":56643,"_2948":56729},[],"Use POST to avoid client encoding differences. A successful response has `Content-Type: application/ocsp-response` and a DER body. The public prefix depends on the Gateway; use the URL published in the certificate and checked by the operator.",{"_3465":2402,"_30219":2368,"_20927":56731,"_5":14373,"_27457":56647,"_2948":56732},[],"You need OpenSSL 3.x, `device.crt`, its direct issuer’s certificate `issuer.pem` and the consumer’s trusted roots in `roots.pem`. For an intermediate issuer, also prepare `intermediates.pem` containing the intermediate CAs.",{"_3465":2403,"_30219":2368,"_20927":56734,"_5":14373,"_27457":56647,"_2948":56735},[],"Generate the request:",{"_3465":2404,"_30219":2368,"_20927":56737,"_5":14373,"_27457":56647,"_2948":56738},[],"This example omits the nonce because the responder does not echo it. Verification relies on signature, response correspondence and timestamps; it does not demonstrate freshness through a nonce.",{"_3465":2405,"_30219":2368,"_20927":56740,"_5":14373,"_27457":56647,"_2948":56741},[],"Replace the example URL with the inspected endpoint:",{"_3465":2406,"_30219":2368,"_20927":56743,"_5":14373,"_27457":56647,"_2948":56744},[],"Verify the returned DER:",{"_3465":2407,"_30219":2368,"_20927":56746,"_5":14373,"_27457":56647,"_2948":56747},[],"For intermediates, add `-verify_other intermediates.pem`. Require successful response verification and inspect the status corresponding to `device.crt`, issuer, serial, `thisUpdate` and `nextUpdate`. `Response verify OK` validates the response only: also observe `good`, `revoked` or `unknown`. Do not accept an identity based only on the command’s exit code.",{"_3465":2408,"_30219":2368,"_20927":56749,"_5":14373,"_27457":56651,"_2948":56750},[],"**OCSP Check** shows what Lamassu returns for a selected certificate. Complete the check from the consumer’s network and trust store: a console query does not establish its validation configuration.",{"_3465":2409,"_30219":2368,"_20927":56752,"_5":14373,"_27457":56651,"_2948":56753},[],"To check a change, save an earlier response, revoke a test certificate and request another response. The new query should reflect persisted status; compare timestamps to rule out reuse of an earlier response. If it fails, follow PKI troubleshooting.",{"_3465":2410,"_30219":2368,"_20927":56755,"_5":14373,"_27457":56655,"_2948":56756},[],"RFC 6960: OCSP.",{"_3465":2411,"_30219":2368,"_20927":56758,"_5":14373,"_27457":56655,"_2948":56759},[],"OpenSSL: openssl-ocsp.",{"_3465":2412,"_30219":2368,"_20927":56761,"_5":14373,"_27457":56655,"_2948":56762},[],"<Card title=\"CRL service\" href=\"/docs/platform/pki/crl\" />",{"_3465":2413,"_30219":2368,"_20927":56764,"_5":14373,"_27457":56655,"_2948":56233},[],{"_3465":2414,"_30219":2414,"_5":14725,"_2948":54734,"_30551":56766,"_20927":56767,"_27457":2414},[49254,50729,54734],[],{"_3465":2415,"_30219":2414,"_20927":56769,"_5":14373,"_27457":2414,"_2948":56770},[],"Administer keys and authorities, define issuance and verify the resulting certificates.",{"_3465":2416,"_30219":2414,"_5":30548,"_20927":56772,"_27457":56773,"_2948":54046},[],"/docs/platform/pki/overview#start-here",{"_3465":2417,"_30219":2414,"_5":30548,"_20927":56775,"_27457":56776,"_2948":56777},[],"/docs/platform/pki/overview#what-you-need","What you need",{"_3465":2418,"_30219":2414,"_5":30548,"_20927":56779,"_27457":56780,"_2948":54578},[],"/docs/platform/pki/overview#core-capabilities",{"_3465":2419,"_30219":2414,"_5":30548,"_20927":56782,"_27457":56783,"_2948":54582},[],"/docs/platform/pki/overview#build-your-trust-hierarchy",{"_3465":2420,"_30219":2414,"_5":30548,"_20927":56785,"_27457":56786,"_2948":54586},[],"/docs/platform/pki/overview#protect-cryptographic-keys",{"_3465":2421,"_30219":2414,"_5":30548,"_20927":56788,"_27457":56789,"_2948":54590},[],"/docs/platform/pki/overview#issue-and-control-certificates",{"_3465":2422,"_30219":2414,"_5":30548,"_20927":56791,"_27457":56792,"_2948":54598},[],"/docs/platform/pki/overview#publish-validation-status",{"_3465":2423,"_30219":2414,"_5":30548,"_20927":56794,"_27457":56795,"_2948":56796},[],"/docs/platform/pki/overview#how-to-check-the-result","How to check the result",{"_3465":2424,"_30219":2414,"_5":30548,"_20927":56798,"_27457":56799,"_2948":55540},[],"/docs/platform/pki/overview#continue",{"_3465":2425,"_30219":2414,"_20927":56801,"_5":14373,"_27457":2414,"_2948":56802},[],"The PKI section explains how to build and operate X.509 trust in Lamassu: which authorities issue, which rules apply and how to check certificates. It is intended for PKI administrators and anyone who needs to use certificates in a consuming system.",{"_3465":2426,"_30219":2414,"_20927":56804,"_5":14373,"_27457":56773,"_2948":56805},[],"Follow PKI getting started to create a CA, issue a client certificate and verify it with OpenSSL. The result is a certificate, its private key and a verified chain.",{"_3465":2427,"_30219":2414,"_20927":56807,"_5":14373,"_27457":56773,"_2948":56808},[],"You can complete that path before managing devices. When you need to associate the identity with an inventory or automate its enrollment, continue in IoT Fleets.",{"_3465":2428,"_30219":2414,"_20927":56810,"_5":14373,"_27457":56776,"_2948":56811},[],"An accessible instance and permission to manage the keys, CAs and certificates you will use.",{"_3465":2429,"_30219":2414,"_20927":56813,"_5":14373,"_27457":56776,"_2948":56814},[],"An available cryptographic engine to keep the authority's key.",{"_3465":2430,"_30219":2414,"_20927":56816,"_5":14373,"_27457":56776,"_2948":56817},[],"The certificate's purpose, such as authenticating a client through mTLS.",{"_3465":2431,"_30219":2414,"_20927":56819,"_5":14373,"_27457":56776,"_2948":56820},[],"Consumer requirements: accepted issuers, algorithms, names and permitted usages.",{"_3465":2432,"_30219":2414,"_20927":56822,"_5":14373,"_27457":56776,"_2948":56823},[],"Prepare the instance and cryptographic provider in Deployment. The trust model explains hierarchy choices.",{"_3465":2433,"_30219":2414,"_20927":56825,"_5":14373,"_27457":56783,"_2948":56826},[],"Authorities sign certificates. A root establishes the trust anchor, and an intermediate separates issuance by environment or purpose. Hierarchy and rotation explains how to maintain trust when replacing an authority.",{"_3465":2434,"_30219":2414,"_20927":56828,"_5":14373,"_27457":56786,"_2948":56829},[],"CA signing keys are managed through KMS and cryptographic engines. A client that generates a CSR can keep its own key: preserve that custody when choosing the issuance method.",{"_3465":2435,"_30219":2414,"_20927":56831,"_5":14373,"_27457":56789,"_2948":56832},[],"A profile establishes subject, validity, usage and key restrictions. The CA applies issuance configuration and signs the certificate. In the inventory, you can inspect the result, download it and manage its status.",{"_3465":2436,"_30219":2414,"_20927":56834,"_5":14373,"_27457":56792,"_2948":56835},[],"Validation covers the chain, validity, usages and revocation status. Lamassu publishes status through OCSP and CRL; the consumer configures which issuers it recognizes and how it checks that status.",{"_3465":2437,"_30219":2414,"_20927":56837,"_5":14373,"_27457":56795,"_2948":56838},[],"An active certificate in the console is one part of the check. Also verify that:",{"_3465":2438,"_30219":2414,"_20927":56840,"_5":14373,"_27457":56795,"_2948":56841},[],"its subject and extensions identify the expected client;",{"_3465":2439,"_30219":2414,"_20927":56843,"_5":14373,"_27457":56795,"_2948":56844},[],"its public key matches the client's private key;",{"_3465":2440,"_30219":2414,"_20927":56846,"_5":14373,"_27457":56795,"_2948":56847},[],"its chain reaches a root trusted by the consumer;",{"_3465":2441,"_30219":2414,"_20927":56849,"_5":14373,"_27457":56795,"_2948":56850},[],"its dates and usages allow the operation;",{"_3465":2442,"_30219":2414,"_20927":56852,"_5":14373,"_27457":56795,"_2948":56853},[],"the consumer applies revocation checks and authorization.",{"_3465":2443,"_30219":2414,"_20927":56855,"_5":14373,"_27457":56795,"_2948":56856},[],"The issuance path includes the first independent checks.",{"_3465":2444,"_30219":2414,"_20927":56858,"_5":14373,"_27457":56799,"_2948":56859},[],"<Card title=\"PKI getting started\" description=\"Create a CA, then issue and verify a client certificate.\" href=\"/docs/platform/pki/quickstarts/overview\" />",{"_3465":2445,"_30219":2414,"_20927":56861,"_5":14373,"_27457":56799,"_2948":56862},[],"<Card title=\"Apply PKI to devices\" description=\"Associate certificates with inventory and prepare enrollment.\" href=\"/docs/platform/iot-fleets/overview\" />",{"_3465":2446,"_30219":2414,"_20927":56864,"_5":14373,"_27457":56799,"_2948":56865},[],"<Card title=\"PKI diagnostics\" description=\"Check issuance, OCSP and CRL when the result fails.\" href=\"/docs/platform/pki/troubleshooting\" />",{"_3465":2447,"_30219":2447,"_5":14725,"_2948":56867,"_30551":56868,"_20927":56869,"_27457":2447},"Create your first CA",[49254,50729,54734,54171],[],{"_3465":2448,"_30219":2447,"_20927":56871,"_5":14373,"_27457":2447,"_2948":56872},[],"Create an evaluation root and check its certificate before issuing.",{"_3465":2449,"_30219":2447,"_5":30548,"_20927":56874,"_27457":56875,"_2948":49264},[],"/docs/platform/pki/quickstarts/create-certificate-authority#before-you-begin",{"_3465":2450,"_30219":2447,"_5":30548,"_20927":56877,"_27457":56878,"_2948":56879},[],"/docs/platform/pki/quickstarts/create-certificate-authority#open-the-creation-wizard-toc","Open the creation wizard [!toc]",{"_3465":2451,"_30219":2447,"_5":30548,"_20927":56881,"_27457":56882,"_2948":56883},[],"/docs/platform/pki/quickstarts/create-certificate-authority#select-the-key-toc","Select the key [!toc]",{"_3465":2452,"_30219":2447,"_5":30548,"_20927":56885,"_27457":56886,"_2948":56887},[],"/docs/platform/pki/quickstarts/create-certificate-authority#define-the-authority-toc","Define the authority [!toc]",{"_3465":2453,"_30219":2447,"_5":30548,"_20927":56889,"_27457":56890,"_2948":56891},[],"/docs/platform/pki/quickstarts/create-certificate-authority#review-and-create-the-ca-toc","Review and create the CA [!toc]",{"_3465":2454,"_30219":2447,"_5":30548,"_20927":56893,"_27457":56894,"_2948":56895},[],"/docs/platform/pki/quickstarts/create-certificate-authority#verify-the-result-toc","Verify the result [!toc]",{"_3465":2455,"_30219":2447,"_5":30548,"_20927":56897,"_27457":56898,"_2948":56899},[],"/docs/platform/pki/quickstarts/create-certificate-authority#check-the-ca-certificate","Check the CA certificate",{"_3465":2456,"_30219":2447,"_5":30548,"_20927":56901,"_27457":56902,"_2948":54428},[],"/docs/platform/pki/quickstarts/create-certificate-authority#if-the-result-fails",{"_3465":2457,"_30219":2447,"_5":30548,"_20927":56904,"_27457":56905,"_2948":49288},[],"/docs/platform/pki/quickstarts/create-certificate-authority#next-step",{"_3465":2458,"_30219":2447,"_20927":56907,"_5":14373,"_27457":2447,"_2948":56908},[],"You will create a root authority with a new key kept by a Lamassu engine. The result is an active CA and its public certificate in `ca.pem`, ready to verify issuance in the next path.",{"_3465":2459,"_30219":2447,"_20927":56910,"_5":14373,"_27457":56875,"_2948":56911},[],"Console access and permission to create keys and authorities.",{"_3465":2460,"_30219":2447,"_20927":56913,"_5":14373,"_27457":56875,"_2948":56914},[],"An available cryptographic engine that supports the chosen algorithm.",{"_3465":2461,"_30219":2447,"_20927":56916,"_5":14373,"_27457":56875,"_2948":56917},[],"OpenSSL 3.x to check the downloaded certificate.",{"_3465":2462,"_30219":2447,"_20927":56919,"_5":14373,"_27457":56875,"_2948":56920},[],"Use an evaluation instance or an authority intended for these tests. The example creates a root that issues directly; to design an operational hierarchy, see Hierarchy and rotation.",{"_3465":2463,"_30219":2447,"_20927":56922,"_5":14373,"_27457":56878,"_2948":56923},[],"In **Certification Authorities**, select **Create New CA** and choose to create a CA with a new key pair.",{"_3465":2464,"_30219":2447,"_20927":56925,"_5":14373,"_27457":56878,"_2948":56926},[],"The &#x2A;*Create New CA (Existing Key)** flow is explained in the authorities guide.",{"_3465":2465,"_30219":2447,"_20927":56928,"_5":14373,"_27457":56882,"_2948":56929},[],"Choose the engine that will keep the key and an algorithm its capabilities allow. For this example, you can use **EC P-384** if available.",{"_3465":2466,"_30219":2447,"_20927":56931,"_5":14373,"_27457":56882,"_2948":56932},[],"The CA private key is used through the engine. In this path, you will download only the authority's public certificate.",{"_3465":2467,"_30219":2447,"_20927":56934,"_5":14373,"_27457":56886,"_2948":56935},[],"Select **Root CA** and complete:",{"_3465":2468,"_30219":2447,"_20927":56937,"_5":14373,"_27457":56886,"_2948":56938},[],"**CA Name**: `Acme Evaluation Root CA`.",{"_3465":2469,"_30219":2447,"_20927":56940,"_5":14373,"_27457":56886,"_2948":56941},[],"**Subject**: organization and country details for your evaluation.",{"_3465":2470,"_30219":2447,"_20927":56943,"_5":14373,"_27457":56886,"_2948":56944},[],"**CA Certificate Expiration**: for example, one year from creation.",{"_3465":2471,"_30219":2447,"_20927":56946,"_5":14373,"_27457":56886,"_2948":56947},[],"**Default End-Entity Certificate Issuance Expiration**: for example, 90 days, within the CA's lifetime.",{"_3465":2472,"_30219":2447,"_20927":56949,"_5":14373,"_27457":56886,"_2948":56950},[],"The CA name becomes its `Common Name`. Keep the CA usages needed to sign certificates and CRLs.",{"_3465":2473,"_30219":2447,"_20927":56952,"_5":14373,"_27457":56890,"_2948":56953},[],"Check the engine, algorithm, subject, root type and dates. Confirm creation and note the authority identifier so you can recognize it in the DMS or API.",{"_3465":2474,"_30219":2447,"_20927":56955,"_5":14373,"_27457":56894,"_2948":56956},[],"Open the new CA. It should appear active, show its certificate and allow access to **Issued Certificates**.",{"_3465":2475,"_30219":2447,"_20927":56958,"_5":14373,"_27457":56894,"_2948":56959},[],"Download or copy the authority's PEM certificate and save it as `ca.pem`. Check that the file contains the complete block, including `BEGIN CERTIFICATE` and `END CERTIFICATE`.",{"_3465":2476,"_30219":2447,"_20927":56961,"_5":14373,"_27457":56898,"_2948":56962},[],"Run from the directory where you saved `ca.pem`:",{"_3465":2477,"_30219":2447,"_20927":56964,"_5":14373,"_27457":56898,"_2948":56965},[],"Check that the subject and issuer match the root you created, the dates include the current time, **Basic Constraints** contains `CA:TRUE` and **Key Usage** allows certificate signing. The last command should return `ca.pem: OK`.",{"_3465":2478,"_30219":2447,"_20927":56967,"_5":14373,"_27457":56898,"_2948":56968},[],"You explicitly selected `ca.pem` as the trust anchor for this test. A valid self-signature does not install that trust in other consumers. See the openssl-verify reference for verification options.",{"_3465":2479,"_30219":2447,"_20927":56970,"_5":14373,"_27457":56902,"_2948":56971},[],"If creation fails, check permissions, engine availability and the selected algorithm.",{"_3465":2480,"_30219":2447,"_20927":56973,"_5":14373,"_27457":56902,"_2948":56974},[],"If OpenSSL cannot read the file, copy the complete PEM block again.",{"_3465":2481,"_30219":2447,"_20927":56976,"_5":14373,"_27457":56902,"_2948":56977},[],"If signature or date checks fail, check that you downloaded this CA's certificate and that your computer's clock is correct.",{"_3465":2482,"_30219":2447,"_20927":56979,"_5":14373,"_27457":56902,"_2948":56980},[],"PKI diagnostics covers issuance checks and cryptographic dependencies.",{"_3465":2483,"_30219":2447,"_20927":56982,"_5":14373,"_27457":56905,"_2948":56983},[],"Continue with Issue and verify a certificate, using this authority and `ca.pem`.",{"_3465":2484,"_30219":2484,"_5":14725,"_2948":56985,"_30551":56986,"_20927":56987,"_27457":2484},"Issue and verify a certificate",[49254,50729,54734,54171],[],{"_3465":2485,"_30219":2484,"_20927":56989,"_5":14373,"_27457":2484,"_2948":56990},[],"Issue a client certificate and check content, chain and key correspondence.",{"_3465":2486,"_30219":2484,"_5":30548,"_20927":56992,"_27457":56993,"_2948":49264},[],"/docs/platform/pki/quickstarts/issue-certificate#before-you-begin",{"_3465":2487,"_30219":2484,"_5":30548,"_20927":56995,"_27457":56996,"_2948":56997},[],"/docs/platform/pki/quickstarts/issue-certificate#start-the-issuance","Start the issuance",{"_3465":2488,"_30219":2484,"_5":30548,"_20927":56999,"_27457":57000,"_2948":57001},[],"/docs/platform/pki/quickstarts/issue-certificate#choose-the-method","Choose the method",{"_3465":2489,"_30219":2484,"_5":30548,"_20927":57003,"_27457":57004,"_2948":57005},[],"/docs/platform/pki/quickstarts/issue-certificate#identify-the-certificate","Identify the certificate",{"_3465":2490,"_30219":2484,"_5":30548,"_20927":57007,"_27457":57008,"_2948":57009},[],"/docs/platform/pki/quickstarts/issue-certificate#configure-key-and-uses","Configure key and uses",{"_3465":2491,"_30219":2484,"_5":30548,"_20927":57011,"_27457":57012,"_2948":57013},[],"/docs/platform/pki/quickstarts/issue-certificate#issue-and-download","Issue and download",{"_3465":2492,"_30219":2484,"_5":30548,"_20927":57015,"_27457":57016,"_2948":57017},[],"/docs/platform/pki/quickstarts/issue-certificate#verify-the-result","Verify the result",{"_3465":2493,"_30219":2484,"_5":30548,"_20927":57019,"_27457":57020,"_2948":57021},[],"/docs/platform/pki/quickstarts/issue-certificate#inspect-content-and-dates","Inspect content and dates",{"_3465":2494,"_30219":2484,"_5":30548,"_20927":57023,"_27457":57024,"_2948":57025},[],"/docs/platform/pki/quickstarts/issue-certificate#verify-the-chain","Verify the chain",{"_3465":2495,"_30219":2484,"_5":30548,"_20927":57027,"_27457":57028,"_2948":57029},[],"/docs/platform/pki/quickstarts/issue-certificate#check-that-the-key-matches","Check that the key matches",{"_3465":2496,"_30219":2484,"_5":30548,"_20927":57031,"_27457":57032,"_2948":54428},[],"/docs/platform/pki/quickstarts/issue-certificate#if-the-result-fails",{"_3465":2497,"_30219":2484,"_5":30548,"_20927":57034,"_27457":57035,"_2948":49288},[],"/docs/platform/pki/quickstarts/issue-certificate#next-step",{"_3465":2498,"_30219":2484,"_20927":57037,"_5":14373,"_27457":2484,"_2948":57038},[],"You will issue an end-entity certificate for `device-001` using browser key and CSR generation. The result is `device.crt`, `device.key` and the issuing root's public certificate, `ca.pem`.",{"_3465":2499,"_30219":2484,"_20927":57040,"_5":14373,"_27457":56993,"_2948":57041},[],"An active root CA with an available signing key and permission to issue. If one does not exist yet, follow Create your first CA.",{"_3465":2500,"_30219":2484,"_20927":57043,"_5":14373,"_27457":56993,"_2948":57044},[],"Its public certificate in `ca.pem`; this example uses the root created in the previous path.",{"_3465":2501,"_30219":2484,"_20927":57046,"_5":14373,"_27457":56993,"_2948":57047},[],"OpenSSL 3.x and a working directory with restricted access.",{"_3465":2502,"_30219":2484,"_20927":57049,"_5":14373,"_27457":56993,"_2948":57050},[],"A client identifier: here we use `device-001`.",{"_3465":2503,"_30219":2484,"_20927":57052,"_5":14373,"_27457":56993,"_2948":57053},[],"In this flow, the client's key is generated in the browser and must be downloaded when issuance finishes. If you lose it, you must generate a key and issue another certificate. The certificate inventory lets you download the public certificate, but cannot recover this key.",{"_3465":2504,"_30219":2484,"_20927":57055,"_5":14373,"_27457":56996,"_2948":57056},[],"Open the CA from the previous path, go to **Issued Certificates** and select **Issue New**.",{"_3465":2505,"_30219":2484,"_20927":57058,"_5":14373,"_27457":57000,"_2948":57059},[],"Select **Generate Key & CSR in Browser** to follow this example.",{"_3465":2506,"_30219":2484,"_20927":57061,"_5":14373,"_27457":57000,"_2948":57062},[],"If the key must be generated and kept on the destination system, use **Upload Existing CSR**, described in the authorities guide.",{"_3465":2507,"_30219":2484,"_20927":57064,"_5":14373,"_27457":57004,"_2948":57065},[],"Enter `device-001` as the `Common Name`. Add subject details required by your policy and SANs if the consumer uses them to identify the client.",{"_3465":2508,"_30219":2484,"_20927":57067,"_5":14373,"_27457":57004,"_2948":57068},[],"If you continue with manual registration, the `Device ID` will be exactly `device-001`.",{"_3465":2509,"_30219":2484,"_20927":57070,"_5":14373,"_27457":57008,"_2948":57071},[],"Choose an algorithm and size allowed by the profile; for example, ECDSA P-256 if permitted. For this client certificate, select **Digital Signature** and **Client Authentication**, and issue it as an end-entity certificate.",{"_3465":2510,"_30219":2484,"_20927":57073,"_5":14373,"_27457":57008,"_2948":57074},[],"Request, for example, 30 days of validity, always within the CA's lifetime. Review the issuance profile if the resulting content differs from the request.",{"_3465":2511,"_30219":2484,"_20927":57076,"_5":14373,"_27457":57012,"_2948":57077},[],"Confirm issuance. Save the PEM certificate as `device.crt` and the private key as `device.key` in your prepared directory.",{"_3465":2512,"_30219":2484,"_20927":57079,"_5":14373,"_27457":57016,"_2948":57080},[],"Check in **Issued Certificates** that the certificate appears active. Note its serial number and verify the downloaded material using the checks below.",{"_3465":2513,"_30219":2484,"_20927":57082,"_5":14373,"_27457":57020,"_2948":57083},[],"Check `CN=device-001`, the expected issuer, current validity, **Digital Signature** and the extended usage **TLS Web Client Authentication**. It must be an end-entity certificate: it must not declare `CA:TRUE` or enable **Certificate Sign**. If **Basic Constraints** is present, it must indicate `CA:FALSE`. If you requested SANs, check that the expected identifiers appear in the certificate.",{"_3465":2514,"_30219":2484,"_20927":57085,"_5":14373,"_27457":57024,"_2948":57086},[],"The expected result is `device.crt: OK`. This check uses your explicit root and evaluates the chain, dates and compatibility with the TLS client purpose. Also check for the expected usages and names through the inspection above.",{"_3465":2515,"_30219":2484,"_20927":57088,"_5":14373,"_27457":57024,"_2948":57089},[],"If you use an intermediate CA, the trusted root must be in `ca.pem` and you must supply the intermediates with `-untrusted intermediates.pem`. This variant is covered in the trust model.",{"_3465":2516,"_30219":2484,"_20927":57091,"_5":14373,"_27457":57024,"_2948":57092},[],"The command does not query OCSP or CRL. For revocation checks, continue with Certificate validation. See the openssl-verify reference for its options.",{"_3465":2517,"_30219":2484,"_20927":57094,"_5":14373,"_27457":57028,"_2948":57095},[],"In Bash, compare the two public-key digests:",{"_3465":2518,"_30219":2484,"_20927":57097,"_5":14373,"_27457":57028,"_2948":57098},[],"Both commands must finish successfully and show the same SHA-256 digest. If they differ, the private key does not match the selected certificate. Find the correct pair before installing it.",{"_3465":2519,"_30219":2484,"_20927":57100,"_5":14373,"_27457":57028,"_2948":57101},[],"The options used are documented in openssl-x509 and openssl-pkey.",{"_3465":2520,"_30219":2484,"_20927":57103,"_5":14373,"_27457":57032,"_2948":54512},[],{"_3465":2521,"_30219":2484,"_20927":57105,"_5":14373,"_27457":57032,"_2948":57106},[],"What to review",{"_3465":2522,"_30219":2484,"_20927":57108,"_5":14373,"_27457":57032,"_2948":57109},[],"The CA rejects issuance",{"_3465":2523,"_30219":2484,"_20927":57111,"_5":14373,"_27457":57032,"_2948":57112},[],"Permissions, CA state and key, algorithm and profile.",{"_3465":2524,"_30219":2484,"_20927":57114,"_5":14373,"_27457":57032,"_2948":57115},[],"Different subject or usages",{"_3465":2525,"_30219":2484,"_20927":57117,"_5":14373,"_27457":57032,"_2948":57118},[],"Applied profile and requested values.",{"_3465":2526,"_30219":2484,"_20927":57120,"_5":14373,"_27457":57032,"_2948":57121},[],"Issuer cannot be found",{"_3465":2527,"_30219":2484,"_20927":57123,"_5":14373,"_27457":57032,"_2948":57124},[],"Downloaded CA and required intermediate chain.",{"_3465":2528,"_30219":2484,"_20927":57126,"_5":14373,"_27457":57032,"_2948":57127},[],"Validity fails",{"_3465":2529,"_30219":2484,"_20927":57129,"_5":14373,"_27457":57032,"_2948":57130},[],"Certificate and CA dates, and the computer's clock.",{"_3465":2530,"_30219":2484,"_20927":57132,"_5":14373,"_27457":57032,"_2948":57133},[],"Public-key digests differ",{"_3465":2531,"_30219":2484,"_20927":57135,"_5":14373,"_27457":57032,"_2948":57136},[],"Certificate and key files from the same issuance.",{"_3465":2532,"_30219":2484,"_20927":57138,"_5":14373,"_27457":57032,"_2948":57139},[],"See PKI diagnostics to narrow an issuance failure.",{"_3465":2533,"_30219":2484,"_20927":57141,"_5":14373,"_27457":57035,"_2948":57142},[],"You have completed the PKI path when the certificate verifies and the key matches. Choose how to use it:",{"_3465":2534,"_30219":2484,"_20927":57144,"_5":14373,"_27457":57035,"_2948":57145},[],"Manage certificates for inspection, status and revocation.",{"_3465":2535,"_30219":2484,"_20927":57147,"_5":14373,"_27457":57035,"_2948":57148},[],"Register a device manually to associate this identity with Lamassu's inventory.",{"_3465":2536,"_30219":2484,"_20927":57150,"_5":14373,"_27457":57035,"_2948":57151},[],"Prepare EST for the device to request its next identities.",{"_3465":2537,"_30219":2484,"_20927":57153,"_5":14373,"_27457":57035,"_2948":57154},[],"Acceptance by a consumer requires configuring its trust, revocation checks and permissions granted to the identity.",{"_3465":2538,"_30219":2538,"_5":14725,"_2948":57156,"_30551":57157,"_20927":57158,"_27457":2538},"PKI getting started",[49254,50729,54734,54171],[],{"_3465":2539,"_30219":2538,"_20927":57160,"_5":14373,"_27457":2538,"_2948":57161},[],"Create a CA, issue a client certificate and check its chain and key.",{"_3465":2540,"_30219":2538,"_5":30548,"_20927":57163,"_27457":57164,"_2948":49264},[],"/docs/platform/pki/quickstarts/overview#before-you-begin",{"_3465":2541,"_30219":2538,"_5":30548,"_20927":57166,"_27457":57167,"_2948":57168},[],"/docs/platform/pki/quickstarts/overview#recommended-path","Recommended path",{"_3465":2542,"_30219":2538,"_5":30548,"_20927":57170,"_27457":57171,"_2948":54363},[],"/docs/platform/pki/quickstarts/overview#expected-result",{"_3465":2543,"_30219":2538,"_5":30548,"_20927":57173,"_27457":57174,"_2948":57175},[],"/docs/platform/pki/quickstarts/overview#continue-according-to-your-goal","Continue according to your goal",{"_3465":2544,"_30219":2538,"_20927":57177,"_5":14373,"_27457":2538,"_2948":57178},[],"This path is intended for those starting to administer PKI or needing a first X.509 client identity. It ends with three files: a root CA certificate, an end-entity certificate and the client's private key.",{"_3465":2545,"_30219":2538,"_20927":57180,"_5":14373,"_27457":57164,"_2948":57181},[],"A Lamassu instance accessible from your browser. To prepare one, see Deployment.",{"_3465":2546,"_30219":2538,"_20927":57183,"_5":14373,"_27457":57164,"_2948":57184},[],"Permission to manage keys, authorities and issuance. See Access control if an operation is blocked.",{"_3465":2547,"_30219":2538,"_20927":57186,"_5":14373,"_27457":57164,"_2948":57187},[],"An available cryptographic engine for the CA key; check the keys and engines inventory.",{"_3465":2548,"_30219":2538,"_20927":57189,"_5":14373,"_27457":57164,"_2948":57190},[],"OpenSSL 3.x on the computer where you will verify the files.",{"_3465":2549,"_30219":2538,"_20927":57192,"_5":14373,"_27457":57164,"_2948":57193},[],"A working directory with restricted access for the downloaded key.",{"_3465":2550,"_30219":2538,"_20927":57195,"_5":14373,"_27457":57167,"_2948":57196},[],"<Card title=\"1. Create your first CA\" description=\"Create an evaluation root and save its public certificate as ca.pem.\" href=\"/docs/platform/pki/quickstarts/create-certificate-authority\" />",{"_3465":2551,"_30219":2538,"_20927":57198,"_5":14373,"_27457":57167,"_2948":57199},[],"<Card title=\"2. Issue and verify a certificate\" description=\"Issue for device-001 and check content, chain and key correspondence.\" href=\"/docs/platform/pki/quickstarts/issue-certificate\" />",{"_3465":2552,"_30219":2538,"_20927":57201,"_5":14373,"_27457":57167,"_2948":57202},[],"We use `Acme Evaluation Root CA` and `device-001` as example names. If you replace them, keep the same client identifier in the steps you want to connect.",{"_3465":2553,"_30219":2538,"_20927":57204,"_5":14373,"_27457":57167,"_2948":57205},[],"The root in this path signs the end-entity certificate directly to simplify evaluation. Before designing an operational PKI, review the trust model and CA hierarchy.",{"_3465":2554,"_30219":2538,"_20927":57207,"_5":14373,"_27457":57171,"_2948":57208},[],"File or resource",{"_3465":2555,"_30219":2538,"_20927":57210,"_5":14373,"_27457":57171,"_2948":54360},[],{"_3465":2556,"_30219":2538,"_20927":57212,"_5":14373,"_27457":57171,"_2948":57213},[],"Active root CA and `ca.pem`",{"_3465":2557,"_30219":2538,"_20927":57215,"_5":14373,"_27457":57171,"_2948":57216},[],"It is a CA certificate, is currently valid and its self-signature verifies.",{"_3465":2558,"_30219":2538,"_20927":57218,"_5":14373,"_27457":57171,"_2948":57219},[],"End-entity certificate and `device.crt`",{"_3465":2559,"_30219":2538,"_20927":57221,"_5":14373,"_27457":57171,"_2948":57222},[],"It identifies `device-001`, supports client authentication and verifies against `ca.pem`.",{"_3465":2560,"_30219":2538,"_20927":57224,"_5":14373,"_27457":57171,"_2948":57225},[],"Private key `device.key`",{"_3465":2561,"_30219":2538,"_20927":57227,"_5":14373,"_27457":57171,"_2948":57228},[],"Its public key matches the one included in `device.crt`.",{"_3465":2562,"_30219":2538,"_20927":57230,"_5":14373,"_27457":57171,"_2948":57231},[],"These checks validate the issued material. Acceptance by a service also requires its trust, authorization and revocation configuration.",{"_3465":2563,"_30219":2538,"_20927":57233,"_5":14373,"_27457":57174,"_2948":57234},[],"To operate certificates, continue with Certificates and Validation.",{"_3465":2564,"_30219":2538,"_20927":57236,"_5":14373,"_27457":57174,"_2948":57237},[],"To manage a device identity in Lamassu, follow Manual registration. That path includes DMS preparation.",{"_3465":2565,"_30219":2538,"_20927":57239,"_5":14373,"_27457":57174,"_2948":57240},[],"For the device to request its certificate, prepare the DMS and EST client.",{"_3465":2566,"_30219":2566,"_5":14725,"_2948":57242,"_30551":57243,"_20927":57244,"_27457":2566},"PKI troubleshooting",[49254,50729,54734,53309],[],{"_3465":2567,"_30219":2566,"_20927":57246,"_5":14373,"_27457":2566,"_2948":57247},[],"Diagnose certificate issuance, OCSP and CRL.",{"_3465":2568,"_30219":2566,"_5":30548,"_20927":57249,"_27457":57250,"_2948":57251},[],"/docs/platform/pki/troubleshooting#issuance-fails","Issuance fails",{"_3465":2569,"_30219":2566,"_5":30548,"_20927":57253,"_27457":57254,"_2948":57255},[],"/docs/platform/pki/troubleshooting#ocsp-or-crl-do-not-reflect-a-change","OCSP or CRL do not reflect a change",{"_3465":2570,"_30219":2566,"_5":30548,"_20927":57257,"_27457":57258,"_2948":57259},[],"/docs/platform/pki/troubleshooting#the-chain-validates-but-the-connection-fails","The chain validates but the connection fails",{"_3465":2571,"_30219":2566,"_20927":57261,"_5":14373,"_27457":2566,"_2948":57262},[],"This guide helps a PKI operator locate issuance and status publication failures. Keep the Lamassu version, operation, CA, issuer, serial, time and returned error. Do not include private keys or tokens in diagnostics.",{"_3465":2572,"_30219":2566,"_20927":57264,"_5":14373,"_27457":2566,"_2948":57265},[],"For Gateway, sign-in, pods, dependencies and messaging, see Deployment troubleshooting. For device enrollment, see EST diagnostics.",{"_3465":2573,"_30219":2566,"_20927":57267,"_5":14373,"_27457":57250,"_2948":54360},[],{"_3465":2574,"_30219":2566,"_20927":57269,"_5":14373,"_27457":57250,"_2948":57270},[],"What to inspect",{"_3465":2575,"_30219":2566,"_20927":57272,"_5":14373,"_27457":57250,"_2948":49288},[],{"_3465":2576,"_30219":2566,"_20927":57274,"_5":14373,"_27457":57250,"_2948":53576},[],{"_3465":2577,"_30219":2566,"_20927":57276,"_5":14373,"_27457":57250,"_2948":57277},[],"Exists, is active and has usable dates.",{"_3465":2578,"_30219":2566,"_20927":57279,"_5":14373,"_27457":57250,"_2948":57280},[],"Authorities.",{"_3465":2579,"_30219":2566,"_20927":57282,"_5":14373,"_27457":57250,"_2948":57283},[],"Key",{"_3465":2580,"_30219":2566,"_20927":57285,"_5":14373,"_27457":57250,"_2948":57286},[],"The record has a usable private key and the engine can sign.",{"_3465":2581,"_30219":2566,"_20927":57288,"_5":14373,"_27457":57250,"_2948":57289},[],"Try **Sign / Verify** in KMS; check provider permissions and availability.",{"_3465":2582,"_30219":2566,"_20927":57291,"_5":14373,"_27457":57250,"_2948":57292},[],"CSR",{"_3465":2583,"_30219":2566,"_20927":57294,"_5":14373,"_27457":57250,"_2948":57295},[],"Correct PEM and verifiable signature.",{"_3465":2584,"_30219":2566,"_20927":57297,"_5":14373,"_27457":57250,"_2948":57298},[],"`openssl req -in request.csr -noout -verify -text`.",{"_3465":2585,"_30219":2566,"_20927":57300,"_5":14373,"_27457":57250,"_2948":57301},[],"Profile",{"_3465":2586,"_30219":2566,"_20927":57303,"_5":14373,"_27457":57250,"_2948":57304},[],"Selected source, existing ID, allowed algorithm and size.",{"_3465":2587,"_30219":2566,"_20927":57306,"_5":14373,"_27457":57250,"_2948":57307},[],"Check Profiles precedence; CA and DMS resolve differently.",{"_3465":2588,"_30219":2566,"_20927":57309,"_5":14373,"_27457":57250,"_2948":54512},[],{"_3465":2589,"_30219":2566,"_20927":57311,"_5":14373,"_27457":57250,"_2948":57312},[],"Appropriate subject, SAN, usages and dates.",{"_3465":2590,"_30219":2566,"_20927":57314,"_5":14373,"_27457":57250,"_2948":57315},[],"Compare CSR, profile and certificate; successful issuance does not establish consumer acceptance.",{"_3465":2591,"_30219":2566,"_20927":57317,"_5":14373,"_27457":57250,"_2948":57318},[],"For unexpected certificate fields, review `Honor Subject`, `Honor Key Usage`, `Honor Extended Key Usages` and `Honor Extensions`. The latter preserves SAN only, without validating entitlement to those names. Validity is not automatically clamped to CA expiration.",{"_3465":2592,"_30219":2566,"_20927":57320,"_5":14373,"_27457":57250,"_2948":57321},[],"For CA reissuance failures, check revocation and date: reissuance is not supported for a revoked or already expired CA. To change its key, use Hierarchy and rotation.",{"_3465":2593,"_30219":2566,"_20927":57323,"_5":14373,"_27457":57254,"_2948":57324},[],"Check each boundary independently:",{"_3465":2594,"_30219":2566,"_20927":57326,"_5":14373,"_27457":57254,"_2948":57327},[],"**Record:** read the correct certificate again by serial and issuer. Confirm status, reason and time; expired or permanently revoked records reject further transitions.",{"_3465":2595,"_30219":2566,"_20927":57329,"_5":14373,"_27457":57254,"_2948":57330},[],"**Endpoint:** inspect AIA and CDP. Query those URLs from the consumer’s network; an old route or incorrect issuer can explain a discrepancy.",{"_3465":2596,"_30219":2566,"_20927":57332,"_5":14373,"_27457":57254,"_2948":57333},[],"**OCSP:** save a fresh response, verify signature and timestamps, and observe status. An HTTP error for an absent serial does not mean `Good` or guarantee a signed `Unknown`.",{"_3465":2597,"_30219":2566,"_20927":57335,"_5":14373,"_27457":57254,"_2948":57336},[],"**CRL:** compare `latest_crl`, number and timestamps with the downloaded list. Check the serial in its contents. If unchanged, review `regenerate_on_revoke`, event delivery, jobs, signing and storage with the deployment operator.",{"_3465":2598,"_30219":2566,"_20927":57338,"_5":14373,"_27457":57254,"_2948":57339},[],"**Client:** check cache, policy for expired or unavailable evidence, critical IDP extension and rejection of a new connection.",{"_3465":2599,"_30219":2566,"_20927":57341,"_5":14373,"_27457":57254,"_2948":57342},[],"Reactivation from `CertificateHold` needs a new CRL for the client to stop seeing the hold. Reactivating a CA does not restore its descendant cascade; inspect every status and individual operation failure.",{"_3465":2600,"_30219":2566,"_20927":57344,"_5":14373,"_27457":57258,"_2948":57345},[],"Check expected identity, SAN, KU/EKU, matching key, presented intermediates and consumer permissions. Distinguish server TLS trust, client authentication and action authorization. Follow Validation for positive and rejection tests.",{"_3465":2601,"_30219":2566,"_20927":57347,"_5":14373,"_27457":57258,"_2948":57348},[],"When escalating a problem, provide identifiers, error and relevant public evidence, including query timestamps and version. This distinguishes issuance, publication and consumer application failures.",{"_3465":2602,"_30219":2602,"_5":14725,"_2948":57350,"_30551":57351,"_20927":57352,"_27457":2602},"Security",[49254],[],{"_3465":2603,"_30219":2602,"_20927":57354,"_5":14373,"_27457":2602,"_2948":57355},[],"How to report a security vulnerability in Lamassu privately, what to include in a report and which releases receive security fixes.",{"_3465":2604,"_30219":2602,"_5":30548,"_20927":57357,"_27457":57358,"_2948":57359},[],"/docs/security#report-a-vulnerability","Report a vulnerability",{"_3465":2605,"_30219":2602,"_5":30548,"_20927":57361,"_27457":57362,"_2948":57363},[],"/docs/security#what-to-include-in-a-report","What to include in a report",{"_3465":2606,"_30219":2602,"_5":30548,"_20927":57365,"_27457":57366,"_2948":57367},[],"/docs/security#supported-versions","Supported versions",{"_3465":2607,"_30219":2602,"_5":30548,"_20927":57369,"_27457":57370,"_2948":57371},[],"/docs/security#responsible-disclosure","Responsible disclosure",{"_3465":2608,"_30219":2602,"_20927":57373,"_5":14373,"_27457":2602,"_2948":57374},[],"Found a security vulnerability in lamassuiot, lamassu-dashboard, or lamassu-helm? This page explains how to report it privately, what to include in your report and which releases receive security fixes.",{"_3465":2609,"_30219":2602,"_20927":57376,"_5":14373,"_27457":57358,"_2948":57377},[],"Do not report security vulnerabilities through public GitHub issues, discussions, or pull requests. Public reports disclose the problem before maintainers can fix it.",{"_3465":2610,"_30219":2602,"_20927":57379,"_5":14373,"_27457":57358,"_2948":57380},[],"Instead, report privately using GitHub Security Advisories for the affected repository:",{"_3465":2611,"_30219":2602,"_20927":57382,"_5":14373,"_27457":57358,"_2948":14997},[],{"_3465":2612,"_30219":2602,"_20927":57384,"_5":14373,"_27457":57358,"_2948":14937},[],{"_3465":2613,"_30219":2602,"_20927":57386,"_5":14373,"_27457":57358,"_2948":14984},[],{"_3465":2614,"_30219":2602,"_20927":57388,"_5":14373,"_27457":57358,"_2948":57389},[],"This lets maintainers assess and address the issue before it is publicly disclosed.",{"_3465":2615,"_30219":2602,"_20927":57391,"_5":14373,"_27457":57358,"_2948":57392},[],"If private vulnerability reporting is not enabled for that repository, report the vulnerability privately to lamassuiot\\@lksnext.com before disclosing any details publicly.",{"_3465":2616,"_30219":2602,"_20927":57394,"_5":14373,"_27457":57362,"_2948":57395},[],"Describe the vulnerability, its potential impact, and steps to reproduce it using non-sensitive, redacted examples.",{"_3465":2617,"_30219":2602,"_20927":57397,"_5":14373,"_27457":57362,"_2948":57398},[],"Do not include in the report:",{"_3465":2618,"_30219":2602,"_20927":57400,"_5":14373,"_27457":57362,"_2948":57401},[],"Credentials, tokens, or private keys",{"_3465":2619,"_30219":2602,"_20927":57403,"_5":14373,"_27457":57362,"_2948":57404},[],"Customer data or customer-identifiable information",{"_3465":2620,"_30219":2602,"_20927":57406,"_5":14373,"_27457":57362,"_2948":57407},[],"Confidential architecture or internal infrastructure details",{"_3465":2621,"_30219":2602,"_20927":57409,"_5":14373,"_27457":57366,"_2948":57410},[],"Only the latest stable release receives security support. Support for a stable release ends when the next stable release is published. Older releases and pre-releases are not supported.",{"_3465":2622,"_30219":2602,"_20927":57412,"_5":14373,"_27457":57366,"_2948":57413},[],"For upgrade guidance, see Upgrades.",{"_3465":2623,"_30219":2602,"_20927":57415,"_5":14373,"_27457":57370,"_2948":57416},[],"Give maintainers reasonable time to investigate and address a reported vulnerability before any public disclosure.",{"_3465":2624,"_30219":2602,"_20927":57418,"_5":14373,"_27457":57370,"_2948":57419},[],"Avoid privacy violations, data destruction, and service disruption while researching a vulnerability.",{"_3465":2625,"_30219":2602,"_20927":57421,"_5":14373,"_27457":57370,"_2948":57422},[],"Only interact with accounts or data you own, or for which you have explicit permission.",{"_3465":2626,"_30219":2602,"_20927":57424,"_5":14373,"_27457":57370,"_2948":57425},[],"Maintainers acknowledge reports in a timely manner and keep you informed of remediation progress.",{"_3465":2627,"_30219":2602,"_20927":57427,"_5":14373,"_27457":57370,"_2948":57428},[],"This policy covers the source code, configuration, and CI/CD workflows of the lamassuiot, lamassu-dashboard, and lamassu-helm repositories.",{"_3465":2628,"_30219":2628,"_5":14725,"_2948":57430,"_30551":57431,"_20927":57433,"_27457":2628},"3.8.0 to 4.0.0",[49254,57432],"Upgrades",[],{"_3465":2629,"_30219":2628,"_20927":57435,"_5":14373,"_27457":2628,"_2948":57436},[],"What changes in the 4.0.0 architecture, which changes break a 3.8.0 deployment, how to upgrade a Helm release step by step and how to validate the result.",{"_3465":2630,"_30219":2628,"_5":30548,"_20927":57438,"_27457":57439,"_2948":57440},[],"/docs/upgrades/3-8-0-to-4-0-0#architecture-changes","Architecture changes",{"_3465":2631,"_30219":2628,"_5":30548,"_20927":57442,"_27457":57443,"_2948":57444},[],"/docs/upgrades/3-8-0-to-4-0-0#one-postgresql-database-with-schemas","One PostgreSQL database with schemas",{"_3465":2632,"_30219":2628,"_5":30548,"_20927":57446,"_27457":57447,"_2948":57448},[],"/docs/upgrades/3-8-0-to-4-0-0#authorization-moves-into-the-authz-service","Authorization moves into the authz service",{"_3465":2633,"_30219":2628,"_5":30548,"_20927":57450,"_27457":57451,"_2948":57452},[],"/docs/upgrades/3-8-0-to-4-0-0#device-events-get-their-own-store","Device events get their own store",{"_3465":2634,"_30219":2628,"_5":30548,"_20927":57454,"_27457":57455,"_2948":57456},[],"/docs/upgrades/3-8-0-to-4-0-0#a-hardened-helm-chart","A hardened Helm chart",{"_3465":2635,"_30219":2628,"_5":30548,"_20927":57458,"_27457":57459,"_2948":57460},[],"/docs/upgrades/3-8-0-to-4-0-0#what-the-upgrade-migrates-automatically","What the upgrade migrates automatically",{"_3465":2636,"_30219":2628,"_5":30548,"_20927":57462,"_27457":57463,"_2948":57464},[],"/docs/upgrades/3-8-0-to-4-0-0#breaking-changes","Breaking changes",{"_3465":2637,"_30219":2628,"_5":30548,"_20927":57466,"_27457":57467,"_2948":57468},[],"/docs/upgrades/3-8-0-to-4-0-0#helm-chart-and-values","Helm chart and values",{"_3465":2638,"_30219":2628,"_5":30548,"_20927":57470,"_27457":57471,"_2948":57472},[],"/docs/upgrades/3-8-0-to-4-0-0#release-scoped-resource-names","Release-scoped resource names",{"_3465":2639,"_30219":2628,"_5":30548,"_20927":57474,"_27457":57475,"_2948":57476},[],"/docs/upgrades/3-8-0-to-4-0-0#strict-values-validation","Strict values validation",{"_3465":2640,"_30219":2628,"_5":30548,"_20927":57478,"_27457":57479,"_2948":57480},[],"/docs/upgrades/3-8-0-to-4-0-0#required-authorization-configuration","Required authorization configuration",{"_3465":2641,"_30219":2628,"_5":30548,"_20927":57482,"_27457":57483,"_2948":57484},[],"/docs/upgrades/3-8-0-to-4-0-0#gateway-token-validation-removed","Gateway token validation removed",{"_3465":2642,"_30219":2628,"_5":30548,"_20927":57486,"_27457":57487,"_2948":57488},[],"/docs/upgrades/3-8-0-to-4-0-0#non-root-containers","Non-root containers",{"_3465":2643,"_30219":2628,"_5":30548,"_20927":57490,"_27457":57491,"_2948":57492},[],"/docs/upgrades/3-8-0-to-4-0-0#amqp-over-tls","AMQP over TLS",{"_3465":2644,"_30219":2628,"_5":30548,"_20927":57494,"_27457":57495,"_2948":57496},[],"/docs/upgrades/3-8-0-to-4-0-0#renamed-and-reshaped-values","Renamed and reshaped values",{"_3465":2645,"_30219":2628,"_5":30548,"_20927":57498,"_27457":57499,"_2948":57500},[],"/docs/upgrades/3-8-0-to-4-0-0#data-and-storage","Data and storage",{"_3465":2646,"_30219":2628,"_5":30548,"_20927":57502,"_27457":57503,"_2948":57504},[],"/docs/upgrades/3-8-0-to-4-0-0#postgresql-consolidation","PostgreSQL consolidation",{"_3465":2647,"_30219":2628,"_5":30548,"_20927":57506,"_27457":57507,"_2948":57508},[],"/docs/upgrades/3-8-0-to-4-0-0#sqlite-storage-removed","SQLite storage removed",{"_3465":2648,"_30219":2628,"_5":30548,"_20927":57510,"_27457":57511,"_2948":57512},[],"/docs/upgrades/3-8-0-to-4-0-0#legacy-ca-keys-in-the-kms","Legacy CA keys in the KMS",{"_3465":2649,"_30219":2628,"_5":30548,"_20927":57514,"_27457":57515,"_2948":57516},[],"/docs/upgrades/3-8-0-to-4-0-0#references-between-certificates-keys-and-crl-settings","References between certificates, keys and CRL settings",{"_3465":2650,"_30219":2628,"_5":30548,"_20927":57518,"_27457":57519,"_2948":57520},[],"/docs/upgrades/3-8-0-to-4-0-0#apis-and-stored-configuration","APIs and stored configuration",{"_3465":2651,"_30219":2628,"_5":30548,"_20927":57522,"_27457":57523,"_2948":57524},[],"/docs/upgrades/3-8-0-to-4-0-0#dms-webhooks","DMS webhooks",{"_3465":2652,"_30219":2628,"_5":30548,"_20927":57526,"_27457":57527,"_2948":57528},[],"/docs/upgrades/3-8-0-to-4-0-0#re-enrollment-trust-set","Re-enrollment trust set",{"_3465":2653,"_30219":2628,"_5":30548,"_20927":57530,"_27457":57531,"_2948":57532},[],"/docs/upgrades/3-8-0-to-4-0-0#independent-re-enrollment-authentication","Independent re-enrollment authentication",{"_3465":2654,"_30219":2628,"_5":30548,"_20927":57534,"_27457":57535,"_2948":57536},[],"/docs/upgrades/3-8-0-to-4-0-0#dms-update-api","DMS update API",{"_3465":2655,"_30219":2628,"_5":30548,"_20927":57538,"_27457":57539,"_2948":57540},[],"/docs/upgrades/3-8-0-to-4-0-0#certificate-type-values","Certificate type values",{"_3465":2656,"_30219":2628,"_5":30548,"_20927":57542,"_27457":57543,"_2948":57544},[],"/docs/upgrades/3-8-0-to-4-0-0#device-events","Device events",{"_3465":2657,"_30219":2628,"_5":30548,"_20927":57546,"_27457":57547,"_2948":57548},[],"/docs/upgrades/3-8-0-to-4-0-0#crl-signer-field","CRL signer field",{"_3465":2658,"_30219":2628,"_5":30548,"_20927":57550,"_27457":57551,"_2948":57552},[],"/docs/upgrades/3-8-0-to-4-0-0#crl-settings-keyed-by-ca-id","CRL settings keyed by CA ID",{"_3465":2659,"_30219":2628,"_5":30548,"_20927":57554,"_27457":57555,"_2948":57556},[],"/docs/upgrades/3-8-0-to-4-0-0#renamed-va-events","Renamed VA events",{"_3465":2660,"_30219":2628,"_5":30548,"_20927":57558,"_27457":57559,"_2948":57560},[],"/docs/upgrades/3-8-0-to-4-0-0#ca-ids-are-always-assigned-by-the-backend","CA IDs are always assigned by the backend",{"_3465":2661,"_30219":2628,"_5":30548,"_20927":57562,"_27457":57563,"_2948":57564},[],"/docs/upgrades/3-8-0-to-4-0-0#va-crl-signer","VA CRL signer",{"_3465":2662,"_30219":2628,"_5":30548,"_20927":57566,"_27457":57567,"_2948":57568},[],"/docs/upgrades/3-8-0-to-4-0-0#helm-migration-guide","Helm migration guide",{"_3465":2663,"_30219":2628,"_5":30548,"_20927":57570,"_27457":57571,"_2948":57572},[],"/docs/upgrades/3-8-0-to-4-0-0#step-1-prepare","Step 1: Prepare",{"_3465":2664,"_30219":2628,"_5":30548,"_20927":57574,"_27457":57575,"_2948":57576},[],"/docs/upgrades/3-8-0-to-4-0-0#pre-upgrade-check","Pre-upgrade check",{"_3465":2665,"_30219":2628,"_5":30548,"_20927":57578,"_27457":57579,"_2948":57580},[],"/docs/upgrades/3-8-0-to-4-0-0#step-2-update-the-values-file","Step 2: Update the values file",{"_3465":2666,"_30219":2628,"_5":30548,"_20927":57582,"_27457":57583,"_2948":57584},[],"/docs/upgrades/3-8-0-to-4-0-0#step-3-run-the-upgrade","Step 3: Run the upgrade",{"_3465":2667,"_30219":2628,"_5":30548,"_20927":57586,"_27457":57587,"_2948":57588},[],"/docs/upgrades/3-8-0-to-4-0-0#step-4-migrate-the-kms-and-va-data","Step 4: Migrate the KMS and VA data",{"_3465":2668,"_30219":2628,"_5":30548,"_20927":57590,"_27457":57591,"_2948":57592},[],"/docs/upgrades/3-8-0-to-4-0-0#step-5-remove-the-one-off-migration-values","Step 5: Remove the one-off migration values",{"_3465":2669,"_30219":2628,"_5":30548,"_20927":57594,"_27457":57595,"_2948":57596},[],"/docs/upgrades/3-8-0-to-4-0-0#deployments-without-helm","Deployments without Helm",{"_3465":2670,"_30219":2628,"_5":30548,"_20927":57598,"_27457":57599,"_2948":53309},[],"/docs/upgrades/3-8-0-to-4-0-0#troubleshooting",{"_3465":2671,"_30219":2628,"_5":30548,"_20927":57601,"_27457":57602,"_2948":57603},[],"/docs/upgrades/3-8-0-to-4-0-0#validation-checklist","Validation checklist",{"_3465":2672,"_30219":2628,"_5":30548,"_20927":57605,"_27457":57606,"_2948":57607},[],"/docs/upgrades/3-8-0-to-4-0-0#delete-the-old-volumes","Delete the old volumes",{"_3465":2673,"_30219":2628,"_20927":57609,"_5":14373,"_27457":2628,"_2948":57610},[],"Lamassu 4.0.0 is a major release. Storage consolidates into a single PostgreSQL database, a new `authz` service authorizes every request, the Helm chart is hardened, and several APIs and stored configurations change shape. Most data converts automatically during the upgrade, but some changes need operator action before, during or after it.",{"_3465":2674,"_30219":2628,"_20927":57612,"_5":14373,"_27457":2628,"_2948":57613},[],"This page is organized in four parts. Read them in order before you upgrade production:",{"_3465":2675,"_30219":2628,"_20927":57615,"_5":14373,"_27457":2628,"_2948":57616},[],"Architecture changes: what is different in 4.0.0 and what the upgrade migrates on its own.",{"_3465":2676,"_30219":2628,"_20927":57618,"_5":14373,"_27457":2628,"_2948":57619},[],"Breaking changes: every change that can break a 3.8.0 deployment, who it affects and what to do.",{"_3465":2677,"_30219":2628,"_20927":57621,"_5":14373,"_27457":2628,"_2948":57622},[],"Helm migration guide: the step-by-step procedure for a Helm-managed release.",{"_3465":2678,"_30219":2628,"_20927":57624,"_5":14373,"_27457":2628,"_2948":57625},[],"Validation checklist: how to confirm the upgrade worked before you remove the old data.",{"_3465":2679,"_30219":2628,"_20927":57627,"_5":14373,"_27457":2628,"_2948":57628},[],"The 4.0.0 release is upcoming and the backend migration steps on this page are provisional. Verify each procedure against the final release artifacts before upgrading production.",{"_3465":2680,"_30219":2628,"_20927":57630,"_5":14373,"_27457":57443,"_2948":57631},[],"3.8.0 gave each service its own database. The 4.0.0 backend connects to a single PostgreSQL database named `pki` and isolates each service in a schema: `kms`, `ca`, `va`, `devicemanager`, `dmsmanager` and `alerts`. The `authz` service keeps its principals, grants and policies in a separate `authz` database (the development monolith uses an `authz` schema inside `pki` instead), and WFX keeps its own `wfx` database.",{"_3465":2681,"_30219":2628,"_20927":57633,"_5":14373,"_27457":57443,"_2948":57634},[],"PostgreSQL is now the only storage engine. SQLite support is removed, and the `couch_db` and `dynamo_db` engines are not registered in 4.0.0.",{"_3465":2682,"_30219":2628,"_20927":57636,"_5":14373,"_27457":57447,"_2948":57637},[],"In 3.8.0 the API Gateway validated tokens: a JWT policy on every private route checked the signature and only let through tokens that carried the administrator role. Every route was open to any token that passed that check.",{"_3465":2683,"_30219":2628,"_20927":57639,"_5":14373,"_27457":57447,"_2948":57640},[],"4.0.0 removes the gateway policy. The `/api/*` routes reach the services directly, and each service authorizes every request through `authz`, which validates the token against the identity provider's JWKS endpoint and applies fine-grained, entity-level policies to CAs, certificates, devices, DMSs, KMS keys and CRL settings. There is no implicit superuser: the first administrator comes from a bootstrap principal that you configure. The access control page documents principals, policies and the first administrator.",{"_3465":2684,"_30219":2628,"_20927":57642,"_5":14373,"_27457":57451,"_2948":57643},[],"Historical device events move from the `devices.events` column to a dedicated `device_events` store with their own endpoints. The events endpoint can also stream events over Server-Sent Events (SSE); to fan events out across service instances, each Device Manager instance binds its own durable AMQP queue.",{"_3465":2685,"_30219":2628,"_20927":57645,"_5":14373,"_27457":57455,"_2948":57646},[],"Version 4.0.0 of the chart is a security-hardening release:",{"_3465":2686,"_30219":2628,"_20927":57648,"_5":14373,"_27457":57455,"_2948":57649},[],"**Release-scoped resource names.** Every chart-managed resource is named `<release>-lamassu-<component>` instead of the fixed names used in 3.8.0 (`kms`, `va`, `ca`, ...). With a release named `prod` the StatefulSets become `prod-lamassu-kms` and `prod-lamassu-va`. The `nameOverride` and `fullnameOverride` values change the prefix.",{"_3465":2687,"_30219":2628,"_20927":57651,"_5":14373,"_27457":57455,"_2948":57652},[],"**Non-root containers.** Every workload runs as the numeric user `65532:65532` with a `RuntimeDefault` seccomp profile and dropped capabilities. Pods do not mount the service-account token by default, and the chart creates a dedicated ServiceAccount.",{"_3465":2688,"_30219":2628,"_20927":57654,"_5":14373,"_27457":57455,"_2948":57655},[],"**Strict values validation.** `values.schema.json` rejects unknown keys, so leftover 3.8.0 blocks fail `helm lint` and `helm upgrade` instead of being silently ignored.",{"_3465":2689,"_30219":2628,"_20927":57657,"_5":14373,"_27457":57455,"_2948":57658},[],"**No injected scheduling rules.** The chart no longer adds pod anti-affinity or topology spread constraints on its own.",{"_3465":2690,"_30219":2628,"_20927":57660,"_5":14373,"_27457":57459,"_2948":57661},[],"Several migrations run without intervention when you upgrade a Helm release:",{"_3465":2691,"_30219":2628,"_20927":57663,"_5":14373,"_27457":57459,"_2948":57664},[],"Before any service starts, the chart's pre-install/pre-upgrade job prepares PostgreSQL. It creates the `pki`, `authz` and `wfx` databases when they do not exist, creates one schema per service inside `pki`, and imports each 3.8.0 per-service database into its schema. Each import runs as a single transaction, so a failed import leaves no partial schema and a retried job imports again. The job then runs the database migrations for every schema, migrates `authz`, preloads its policies and seeds the `services.authz.bootstrap` principals. It is idempotent and requires a PostgreSQL role allowed to create databases and schemas, as described in Install with Helm.",{"_3465":2692,"_30219":2628,"_20927":57666,"_5":14373,"_27457":57459,"_2948":57667},[],"Stored DMS configuration is rewritten to the 4.0.0 layout, and historical device events are transformed into the new store.",{"_3465":2693,"_30219":2628,"_20927":57669,"_5":14373,"_27457":57459,"_2948":57670},[],"The KMS migration removes the stale `lamassu.io/kms/binded-resources` key metadata, and the VA migration resolves each role's CRL signer (see VA CRL signer).",{"_3465":2694,"_30219":2628,"_20927":57672,"_5":14373,"_27457":57459,"_2948":57673},[],"When `migrations.caToKms.enabled` is set, a pre-upgrade hook registers legacy CA keys in the KMS.",{"_3465":2695,"_30219":2628,"_20927":57675,"_5":14373,"_27457":57459,"_2948":57676},[],"Two things never migrate on their own: the KMS and VA data on local volumes, which stays on volumes the upgraded pods no longer use, and the values file, which you update by hand. Deployments that do not use the Helm chart also have to move their database data themselves; see Deployments without Helm.",{"_3465":2696,"_30219":2628,"_20927":57678,"_5":14373,"_27457":57463,"_2948":57679},[],"Change",{"_3465":2697,"_30219":2628,"_20927":57681,"_5":14373,"_27457":57463,"_2948":57682},[],"Who is affected",{"_3465":2698,"_30219":2628,"_20927":57684,"_5":14373,"_27457":57463,"_2948":57685},[],"Severity",{"_3465":2699,"_30219":2628,"_20927":57687,"_5":14373,"_27457":57463,"_2948":56161},[],{"_3465":2700,"_30219":2628,"_20927":57689,"_5":14373,"_27457":57463,"_2948":57472},[],{"_3465":2701,"_30219":2628,"_20927":57691,"_5":14373,"_27457":57463,"_2948":57692},[],"Helm releases with a filesystem KMS engine or local VA CRL storage",{"_3465":2702,"_30219":2628,"_20927":57694,"_5":14373,"_27457":57463,"_2948":57695},[],"High: KMS and VA start on empty volumes",{"_3465":2703,"_30219":2628,"_20927":57697,"_5":14373,"_27457":57463,"_2948":57698},[],"Copy the data into the new volumes",{"_3465":2704,"_30219":2628,"_20927":57700,"_5":14373,"_27457":57463,"_2948":57476},[],{"_3465":2705,"_30219":2628,"_20927":57702,"_5":14373,"_27457":57463,"_2948":57703},[],"Every Helm release",{"_3465":2706,"_30219":2628,"_20927":57705,"_5":14373,"_27457":57463,"_2948":57706},[],"High: `helm upgrade` fails",{"_3465":2707,"_30219":2628,"_20927":57708,"_5":14373,"_27457":57463,"_2948":57709},[],"Remove or rename legacy keys",{"_3465":2708,"_30219":2628,"_20927":57711,"_5":14373,"_27457":57463,"_2948":57480},[],{"_3465":2709,"_30219":2628,"_20927":57713,"_5":14373,"_27457":57463,"_2948":57714},[],"Every deployment",{"_3465":2710,"_30219":2628,"_20927":57716,"_5":14373,"_27457":57463,"_2948":57717},[],"High: without a bootstrap principal there is no administrator",{"_3465":2711,"_30219":2628,"_20927":57719,"_5":14373,"_27457":57463,"_2948":57720},[],"Configure `services.authz`",{"_3465":2712,"_30219":2628,"_20927":57722,"_5":14373,"_27457":57463,"_2948":57484},[],{"_3465":2713,"_30219":2628,"_20927":57724,"_5":14373,"_27457":57463,"_2948":57703},[],{"_3465":2714,"_30219":2628,"_20927":57726,"_5":14373,"_27457":57463,"_2948":57727},[],"High: `helm upgrade` fails on the old keys",{"_3465":2715,"_30219":2628,"_20927":57729,"_5":14373,"_27457":57463,"_2948":57730},[],"Move JWKS and roles into `services.authz`",{"_3465":2716,"_30219":2628,"_20927":57732,"_5":14373,"_27457":57463,"_2948":57504},[],{"_3465":2717,"_30219":2628,"_20927":57734,"_5":14373,"_27457":57463,"_2948":57735},[],"3.8.0 deployments with per-service databases",{"_3465":2718,"_30219":2628,"_20927":57737,"_5":14373,"_27457":57463,"_2948":57738},[],"High: services find no data, or a migration aborts",{"_3465":2719,"_30219":2628,"_20927":57740,"_5":14373,"_27457":57463,"_2948":57741},[],"Clean duplicate CA IDs and empty `engine_id` values first; move data manually outside Helm",{"_3465":2720,"_30219":2628,"_20927":57743,"_5":14373,"_27457":57463,"_2948":57508},[],{"_3465":2721,"_30219":2628,"_20927":57745,"_5":14373,"_27457":57463,"_2948":57746},[],"Deployments on SQLite, `couch_db` or `dynamo_db`",{"_3465":2722,"_30219":2628,"_20927":57748,"_5":14373,"_27457":57463,"_2948":57749},[],"High: the backend no longer starts with them",{"_3465":2723,"_30219":2628,"_20927":57751,"_5":14373,"_27457":57463,"_2948":57752},[],"Move to PostgreSQL before upgrading",{"_3465":2724,"_30219":2628,"_20927":57754,"_5":14373,"_27457":57463,"_2948":57552},[],{"_3465":2725,"_30219":2628,"_20927":57756,"_5":14373,"_27457":57463,"_2948":57757},[],"Every deployment; API clients, custom policies and alert subscriptions are also affected",{"_3465":2726,"_30219":2628,"_20927":57759,"_5":14373,"_27457":57463,"_2948":57760},[],"High: the `/v1/roles` routes are removed and the migration is irreversible",{"_3465":2727,"_30219":2628,"_20927":57762,"_5":14373,"_27457":57463,"_2948":57763},[],"Fix the data the migration aborts on, and back up the database and the CRL bucket",{"_3465":2728,"_30219":2628,"_20927":57765,"_5":14373,"_27457":57463,"_2948":57766},[],"Webhooks with file references",{"_3465":2729,"_30219":2628,"_20927":57768,"_5":14373,"_27457":57463,"_2948":57769},[],"DMSs whose webhook mTLS certificate or key were file paths",{"_3465":2730,"_30219":2628,"_20927":57771,"_5":14373,"_27457":57463,"_2948":57772},[],"High: enrollments calling the webhook fail",{"_3465":2731,"_30219":2628,"_20927":57774,"_5":14373,"_27457":57463,"_2948":57775},[],"Re-enter certificate and key as PEM, or remove the file fields",{"_3465":2732,"_30219":2628,"_20927":57777,"_5":14373,"_27457":57463,"_2948":57488},[],{"_3465":2733,"_30219":2628,"_20927":57779,"_5":14373,"_27457":57463,"_2948":57780},[],"Releases with per-service identity overrides or mounted key material",{"_3465":2734,"_30219":2628,"_20927":57782,"_5":14373,"_27457":57463,"_2948":57783},[],"Medium: services cannot read their files",{"_3465":2735,"_30219":2628,"_20927":57785,"_5":14373,"_27457":57463,"_2948":57786},[],"Remove the overrides and fix volume ownership",{"_3465":2736,"_30219":2628,"_20927":57788,"_5":14373,"_27457":57463,"_2948":57492},[],{"_3465":2737,"_30219":2628,"_20927":57790,"_5":14373,"_27457":57463,"_2948":57791},[],"Releases that set `amqp.tls`",{"_3465":2738,"_30219":2628,"_20927":57793,"_5":14373,"_27457":57463,"_2948":57794},[],"Medium: clients connect to the wrong port",{"_3465":2739,"_30219":2628,"_20927":57796,"_5":14373,"_27457":57463,"_2948":57797},[],"Point `amqp.port` at the TLS listener, or disable TLS",{"_3465":2740,"_30219":2628,"_20927":57799,"_5":14373,"_27457":57463,"_2948":57512},[],{"_3465":2741,"_30219":2628,"_20927":57801,"_5":14373,"_27457":57463,"_2948":57802},[],"Installations whose CA keys predate the KMS",{"_3465":2742,"_30219":2628,"_20927":57804,"_5":14373,"_27457":57463,"_2948":57805},[],"Medium: CA keys stay unmanaged",{"_3465":2743,"_30219":2628,"_20927":57807,"_5":14373,"_27457":57463,"_2948":57808},[],"Run the CA-to-KMS migration",{"_3465":2744,"_30219":2628,"_20927":57810,"_5":14373,"_27457":57463,"_2948":57811},[],"Receiver certificate verification",{"_3465":2745,"_30219":2628,"_20927":57813,"_5":14373,"_27457":57463,"_2948":57814},[],"DMSs whose webhook had `validate_server_cert: false`",{"_3465":2746,"_30219":2628,"_20927":57816,"_5":14373,"_27457":57463,"_2948":57817},[],"Medium: credentials go to an unverified receiver",{"_3465":2747,"_30219":2628,"_20927":57819,"_5":14373,"_27457":57463,"_2948":57820},[],"Set `insecure_skip_verify` to `false`",{"_3465":2748,"_30219":2628,"_20927":57822,"_5":14373,"_27457":57463,"_2948":57528},[],{"_3465":2749,"_30219":2628,"_20927":57824,"_5":14373,"_27457":57463,"_2948":57825},[],"Scripts and consoles that edit DMSs through the API",{"_3465":2750,"_30219":2628,"_20927":57827,"_5":14373,"_27457":57463,"_2948":57828},[],"Medium: an old-layout edit silently empties `validation_cas`",{"_3465":2751,"_30219":2628,"_20927":57830,"_5":14373,"_27457":57463,"_2948":57831},[],"Read the DMS before editing and use the new field",{"_3465":2752,"_30219":2628,"_20927":57833,"_5":14373,"_27457":57463,"_2948":57548},[],{"_3465":2753,"_30219":2628,"_20927":57835,"_5":14373,"_27457":57463,"_2948":57836},[],"Clients that create or update CRL settings through the API",{"_3465":2754,"_30219":2628,"_20927":57838,"_5":14373,"_27457":57463,"_2948":57839},[],"Medium: requests with the old field return an error",{"_3465":2755,"_30219":2628,"_20927":57841,"_5":14373,"_27457":57463,"_2948":57842},[],"Replace `crl_options.subject_key_id_signer` with the required `crl_options.signer_serial_number`",{"_3465":2756,"_30219":2628,"_20927":57844,"_5":14373,"_27457":57463,"_2948":57556},[],{"_3465":2757,"_30219":2628,"_20927":57846,"_5":14373,"_27457":57463,"_2948":57847},[],"Alert subscriptions and consumers of the VA events",{"_3465":2758,"_30219":2628,"_20927":57849,"_5":14373,"_27457":57463,"_2948":57850},[],"Medium: subscription types are renamed automatically, their conditions are not",{"_3465":2759,"_30219":2628,"_20927":57852,"_5":14373,"_27457":57463,"_2948":57853},[],"Review conditions filtering on the old event payload or subject",{"_3465":2760,"_30219":2628,"_20927":57855,"_5":14373,"_27457":57463,"_2948":57544},[],{"_3465":2761,"_30219":2628,"_20927":57857,"_5":14373,"_27457":57463,"_2948":57858},[],"Consumers that read the device `events` field",{"_3465":2762,"_30219":2628,"_20927":57860,"_5":14373,"_27457":57463,"_2948":57861},[],"Medium: the field disappears",{"_3465":2763,"_30219":2628,"_20927":57863,"_5":14373,"_27457":57463,"_2948":57864},[],"Use the new event endpoints",{"_3465":2764,"_30219":2628,"_20927":57866,"_5":14373,"_27457":57463,"_2948":57564},[],{"_3465":2765,"_30219":2628,"_20927":57868,"_5":14373,"_27457":57463,"_2948":57869},[],"Deployments with VA roles whose signer cannot be resolved uniquely",{"_3465":2766,"_30219":2628,"_20927":57871,"_5":14373,"_27457":57463,"_2948":57872},[],"Medium: the VA migration aborts",{"_3465":2767,"_30219":2628,"_20927":57874,"_5":14373,"_27457":57463,"_2948":57875},[],"Fix the affected roles before upgrading",{"_3465":2768,"_30219":2628,"_20927":57877,"_5":14373,"_27457":57463,"_2948":57496},[],{"_3465":2769,"_30219":2628,"_20927":57879,"_5":14373,"_27457":57463,"_2948":57880},[],"Releases that override `toolbox`, `services.connectors`, ports, probes or scheduling",{"_3465":2770,"_30219":2628,"_20927":57882,"_5":14373,"_27457":57463,"_2948":57883},[],"Low to medium: validation errors or changed defaults",{"_3465":2771,"_30219":2628,"_20927":57885,"_5":14373,"_27457":57463,"_2948":57886},[],"Update the values file",{"_3465":2772,"_30219":2628,"_20927":57888,"_5":14373,"_27457":57463,"_2948":57536},[],{"_3465":2773,"_30219":2628,"_20927":57890,"_5":14373,"_27457":57463,"_2948":57891},[],"Clients that send the DMS ID in the update body",{"_3465":2774,"_30219":2628,"_20927":57893,"_5":14373,"_27457":57463,"_2948":57894},[],"Low: the ID in the URL wins",{"_3465":2775,"_30219":2628,"_20927":57896,"_5":14373,"_27457":57463,"_2948":57897},[],"Send the ID in the URL",{"_3465":2776,"_30219":2628,"_20927":57899,"_5":14373,"_27457":57463,"_2948":57560},[],{"_3465":2777,"_30219":2628,"_20927":57901,"_5":14373,"_27457":57463,"_2948":57902},[],"Clients that send an `id` when creating or importing CAs",{"_3465":2778,"_30219":2628,"_20927":57904,"_5":14373,"_27457":57463,"_2948":57905},[],"Low: the ID in the body is ignored, and the field is removed",{"_3465":2779,"_30219":2628,"_20927":57907,"_5":14373,"_27457":57463,"_2948":57908},[],"Let the backend assign the ID and use the returned one",{"_3465":2780,"_30219":2628,"_20927":57910,"_5":14373,"_27457":57463,"_2948":57540},[],{"_3465":2781,"_30219":2628,"_20927":57912,"_5":14373,"_27457":57463,"_2948":57913},[],"Consumers that match on certificate `type`",{"_3465":2782,"_30219":2628,"_20927":57915,"_5":14373,"_27457":57463,"_2948":57916},[],"Low: two values are renamed",{"_3465":2783,"_30219":2628,"_20927":57918,"_5":14373,"_27457":57463,"_2948":57919},[],"Adapt consumers",{"_3465":2784,"_30219":2628,"_20927":57921,"_5":14373,"_27457":57463,"_2948":57532},[],{"_3465":2785,"_30219":2628,"_20927":57923,"_5":14373,"_27457":57463,"_2948":57924},[],"Any DMS",{"_3465":2786,"_30219":2628,"_20927":57926,"_5":14373,"_27457":57463,"_2948":57927},[],"Low: informational",{"_3465":2787,"_30219":2628,"_20927":57929,"_5":14373,"_27457":57463,"_2948":57930},[],"Read both blocks before editing",{"_3465":2788,"_30219":2628,"_20927":57932,"_5":14373,"_27457":57471,"_2948":57933},[],"Kubernetes derives a StatefulSet's PVC name from its pod name (`<volumeClaimTemplate>-<pod-name>`). Renaming the `kms` and `va` StatefulSets means `helm upgrade` binds brand-new, empty PVCs instead of the existing ones. The KMS key material and VA CRLs are not deleted — the old PVCs are orphaned, not removed — but the upgraded pods fail with `no such file or directory` (KMS) or `code=NotFound` (VA) until you copy the data across. This affects KMS when `services.kms.cryptoEngines` uses a `filesystem` engine and VA when `services.va.fileStore.type` is `local`. Every other renamed resource is stateless and is recreated without data-loss risk.",{"_3465":2789,"_30219":2628,"_20927":57935,"_5":14373,"_27457":57471,"_2948":57936},[],"Step 4 of the migration guide copies the data.",{"_3465":2790,"_30219":2628,"_20927":57938,"_5":14373,"_27457":57475,"_2948":57939},[],"`values.schema.json` rejects unknown keys, so every block that 4.0.0 removed or renamed — `toolbox`, `auth.oidc.apiGateway`, `auth.authorization` and others — fails `helm lint` and `helm upgrade` outright. Step 2 lists every change.",{"_3465":2791,"_30219":2628,"_20927":57941,"_5":14373,"_27457":57479,"_2948":57942},[],"3.8.0 had no authorization service, so a 3.8.0 values file has nothing to migrate from: you must add the `services.authz` configuration yourself. It needs the JWKS endpoint of your identity provider, the database mappings the authorization engine uses, and a bootstrap principal that matches how your provider assigns the administrator role. Without a matching principal nobody can administer the PKI.",{"_3465":2792,"_30219":2628,"_20927":57944,"_5":14373,"_27457":57483,"_2948":57945},[],"`auth.oidc.apiGateway.jwks`, `auth.authorization.rolesClaim` and `auth.authorization.roles.admin` are removed with no compatibility aliases, and the schema rejects them. Their settings move into `services.authz`: the JWKS URL becomes `services.authz.jwkUrl`, and the role claim and administrator role become a claim rule of the bootstrap principal. `auth.oidc.frontend` is unchanged.",{"_3465":2793,"_30219":2628,"_20927":57947,"_5":14373,"_27457":57487,"_2948":57948},[],"Service images run on a distroless base as the numeric user `65532`; the `authz` image is Ubuntu with a non-root user that has the same UID. The per-service overrides `services.kms.securityContext.runAsGroup: 0` and `services.authz.securityContext.runAsUser`/`runAsGroup: 999` are removed; group access to the KMS volume and PKCS#11 socket is now handled by the pod-level `fsGroup: 65532`.",{"_3465":2794,"_30219":2628,"_20927":57950,"_5":14373,"_27457":57487,"_2948":57951},[],"3.8.0 did not pin a container identity, so existing files can carry any UID. Any volume that holds keys or CRLs must be owned by `65532:65532`, or at least readable (and, where needed, writable) by that identity.",{"_3465":2795,"_30219":2628,"_20927":57953,"_5":14373,"_27457":57491,"_2948":57954},[],"In 3.8.0 `amqp.tls` was not applied and event-bus clients always connected over plaintext. In 4.0.0 `amqp.tls: true` switches them to AMQPS. The default `amqp.port` stays `5672` and does not change when TLS is enabled, so a values file that already set `amqp.tls: true` must point `amqp.port` at the broker's TLS listener (`amqps`, commonly `5671`), or set `amqp.tls: false` to keep plaintext. Clients must also trust the broker's certificate.",{"_3465":2796,"_30219":2628,"_20927":57956,"_5":14373,"_27457":57495,"_2948":57957},[],"`toolbox` is renamed to `connectivityTest`, and the `helm test` hook uses the upstream `curlimages/curl` image pinned by digest.",{"_3465":2797,"_30219":2628,"_20927":57959,"_5":14373,"_27457":57495,"_2948":57960},[],"`services.connectors` is a map keyed by connector ID instead of a list.",{"_3465":2798,"_30219":2628,"_20927":57962,"_5":14373,"_27457":57495,"_2948":57963},[],"The `services.ui.port` default is `8085`, the unprivileged port of the rootless image.",{"_3465":2799,"_30219":2628,"_20927":57965,"_5":14373,"_27457":57495,"_2948":57966},[],"The shared `probes:` block is replaced by independent `livenessProbe`, `readinessProbe` and `startupProbe` blocks.",{"_3465":2800,"_30219":2628,"_20927":57968,"_5":14373,"_27457":57495,"_2948":57969},[],"With `tls.certManagerOptions.issuer` empty, the chart creates a release-scoped self-signed issuer, for example `lamassu-downstream-ca-selfsigned-issuer`. The legacy literal `downstream-ca-selfsigned-issuer` is still accepted and resolves to it.",{"_3465":2801,"_30219":2628,"_20927":57971,"_5":14373,"_27457":57495,"_2948":57972},[],"Anti-affinity and topology spread must be configured explicitly through `affinity` and `topologySpreadConstraints`.",{"_3465":2802,"_30219":2628,"_20927":57974,"_5":14373,"_27457":57503,"_2948":57975},[],"Every 3.8.0 per-service database must end up as a schema of `pki`, keeping its structure, indexes, constraints, data and migration history. The Helm chart does this automatically; deployments without Helm do it by hand (see Deployments without Helm).",{"_3465":2803,"_30219":2628,"_20927":57977,"_5":14373,"_27457":57503,"_2948":57978},[],"Two schema migrations abort on data that 3.8.0 allowed, so clean the data before upgrading:",{"_3465":2804,"_30219":2628,"_20927":57980,"_5":14373,"_27457":57503,"_2948":57981},[],"The CA migration adds a UNIQUE constraint on `ca_certificates.id` and aborts if duplicate CA IDs exist. Imports already reject duplicates with `409`, so new ones cannot normally appear.",{"_3465":2805,"_30219":2628,"_20927":57983,"_5":14373,"_27457":57503,"_2948":57984},[],"The KMS migration promotes the primary key to `(key_id, engine_id)` and aborts with `cannot promote (key_id, engine_id) to primary key: N row(s) have no engine_id; backfill them before migrating` when `kms_keys` rows lack `engine_id`. Backfill `engine_id` first.",{"_3465":2806,"_30219":2628,"_20927":57986,"_5":14373,"_27457":57503,"_2948":57987},[],"The same KMS migration deletes, with a `NOTICE`, aliases that equal an existing key ID, because identifiers now resolve as a key ID before an alias. Affected aliases are dropped, not redirected.",{"_3465":2807,"_30219":2628,"_20927":57989,"_5":14373,"_27457":57507,"_2948":57990},[],"The SQLite storage engine is removed, and the `couch_db` and `dynamo_db` engines are not registered in 4.0.0: their configuration constants remain, but they select no engine. Deployments on any of them must move to PostgreSQL and consolidate their data into the `pki` schemas before upgrading.",{"_3465":2808,"_30219":2628,"_20927":57992,"_5":14373,"_27457":57511,"_2948":57993},[],"CA certificates of type `MANAGED` or `IMPORTED_WITH_KEY` whose private keys predate the KMS service have the key stored only in the crypto engine, under the certificate's `subject_key_id`, with no KMS record. The `ca-to-kms-migration` tool registers them:",{"_3465":2809,"_30219":2628,"_20927":57995,"_5":14373,"_27457":57511,"_2948":57996},[],"The `key_id` is the certificate's `subject_key_id`; it matches the SHA-256 digest of the public key only when the SKI was computed that way.",{"_3465":2810,"_30219":2628,"_20927":57998,"_5":14373,"_27457":57511,"_2948":57999},[],"The tool is idempotent: keys already in the KMS are skipped, so it can be run several times.",{"_3465":2811,"_30219":2628,"_20927":58001,"_5":14373,"_27457":57511,"_2948":58002},[],"Certificates that cannot be read, or lack an engine or a subject key ID, are skipped with a warning. Review the logs and resolve the affected records.",{"_3465":2812,"_30219":2628,"_20927":58004,"_5":14373,"_27457":57511,"_2948":58005},[],"When CA certificates sharing a `subject_key_id` declare conflicting `engine_id`s, the tool fails that key and exits with code `1`, which fails a Helm pre-upgrade hook. Resolve the conflict manually before rerunning.",{"_3465":2813,"_30219":2628,"_20927":58007,"_5":14373,"_27457":57511,"_2948":58008},[],"Once the keys are registered, certificates reference them in the database and the KMS refuses to delete a key that a certificate still uses (`409` `key is in use`). Deleting a certificate record removes it from the CRL and OCSP, so read Before deleting a key before freeing a key.",{"_3465":2814,"_30219":2628,"_20927":58010,"_5":14373,"_27457":57511,"_2948":58011},[],"Optionally, installations with imported CAs from before 3.7 can start the KMS once with `crypto_engines.migrate_keys_format: true`: the KMS renames those SKI-named legacy keys to the SHA-256 digest of their public key (the old name is kept as an alias, and the certificate references follow automatically). Run it once and disable the option again; running it again is safe.",{"_3465":2815,"_30219":2628,"_20927":58013,"_5":14373,"_27457":57511,"_2948":58014},[],"With Helm, enable the hook for the upgrade in step 2; without Helm, run the tool by hand.",{"_3465":2816,"_30219":2628,"_20927":58016,"_5":14373,"_27457":57515,"_2948":58017},[],"Certificates now reference their KMS key, and CRL settings reference their signer certificate, so a key or certificate in use cannot be deleted. The KMS migration drops the legacy `lamassu.io/kms/binded-resources` key metadata. Before 4.0.0, deleting a CA could remove its key while leaving key references in its retained certificate records. The CA migration registers those missing keys in the KMS with only their public key to satisfy the retained references. These entries cannot be deleted while the retained certificates reference them; they do not restore the private key. In 4.0.0, deleting a CA releases the references from its own current certificate and linked reissued certificates before attempting to delete the key; other certificates that still reference it prevent deletion.",{"_3465":2817,"_30219":2628,"_20927":58019,"_5":14373,"_27457":57523,"_2948":58020},[],"Stored webhook configs are rewritten to the current layout and their fields renamed:",{"_3465":2818,"_30219":2628,"_20927":58022,"_5":14373,"_27457":57523,"_2948":58023},[],"Field in 3.8.0",{"_3465":2819,"_30219":2628,"_20927":58025,"_5":14373,"_27457":57523,"_2948":58026},[],"Field in 4.0.0",{"_3465":2820,"_30219":2628,"_20927":58028,"_5":14373,"_27457":57523,"_2948":58029},[],"`validate_server_cert`",{"_3465":2821,"_30219":2628,"_20927":58031,"_5":14373,"_27457":57523,"_2948":58032},[],"`insecure_skip_verify` (value negated)",{"_3465":2822,"_30219":2628,"_20927":58034,"_5":14373,"_27457":57523,"_2948":58035},[],"`oidc`",{"_3465":2823,"_30219":2628,"_20927":58037,"_5":14373,"_27457":57523,"_2948":58038},[],"`jwt_options`",{"_3465":2824,"_30219":2628,"_20927":58040,"_5":14373,"_27457":57523,"_2948":58041},[],"`apikey`",{"_3465":2825,"_30219":2628,"_20927":58043,"_5":14373,"_27457":57523,"_2948":58044},[],"`apikey_options`",{"_3465":2826,"_30219":2628,"_20927":58046,"_5":14373,"_27457":57523,"_2948":58047},[],"`mtls`",{"_3465":2827,"_30219":2628,"_20927":58049,"_5":14373,"_27457":57523,"_2948":58050},[],"`mtls_options`",{"_3465":2828,"_30219":2628,"_20927":58052,"_5":14373,"_27457":57523,"_2948":58053},[],"When the legacy mTLS certificate and key are both PEM, they move into `mtls_options.cert_content` and `mtls_options.key_content` and need no action. Two cases do need it.",{"_3465":2829,"_30219":2628,"_20927":58055,"_5":14373,"_27457":57523,"_2948":58056},[],"**Webhooks with file references.** A mixed config, with a PEM certificate and a file-path key, is migrated to `mtls_options.cert_file` and `mtls_options.key_file`. Webhook delivery rejects those fields on every call, whatever the configured authentication mode, so every enroll and re-enroll that calls that webhook fails until the config is fixed. If the webhook uses mTLS, re-enter the certificate and key as Base64-encoded or plain PEM; if it does not, remove the leftover file fields. Metadata-only updates keep working in the meantime (`PUT` or `PATCH` on `/v1/dms/:id/metadata`). In a variant of the same problem, a stored config with file paths inside `mtls_options.cert_content` or `mtls_options.key_content` makes every full settings update (`POST /v1/dms` or `PUT /v1/dms/:id`) fail validation; settings are replaced wholesale, so resend the config with the certificate and key as PEM.",{"_3465":2830,"_30219":2628,"_20927":58058,"_5":14373,"_27457":57523,"_2948":58059},[],"**Receiver certificate verification.** A config with `validate_server_cert: false` becomes `insecure_skip_verify: true`, so receiver verification stays skipped until that field is set to `false`. Correct it on every migrated config: the webhook authorization channel carries the API key or bearer token, and skipping verification exposes those credentials to a network-positioned attacker. Keep `insecure_skip_verify: true` only when the receiver certificate is deliberately unverifiable.",{"_3465":2831,"_30219":2628,"_20927":58061,"_5":14373,"_27457":57527,"_2948":58062},[],"The flat field `reenrollment_settings.additional_validation_cas` moves into the nested field `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`:",{"_3465":2832,"_30219":2628,"_20927":58064,"_5":14373,"_27457":57527,"_2948":58065},[],"The effective trust set does not change, because the nested value was never consulted when validating re-enrollments. If the flat list was missing or null, it becomes an empty list.",{"_3465":2833,"_30219":2628,"_20927":58067,"_5":14373,"_27457":57527,"_2948":58068},[],"What changes is how API requests are handled. Bodies that still carry `additional_validation_cas` are accepted, but the value is silently dropped because unknown JSON fields are ignored, and GET responses no longer include it. An update body built from the old layout therefore empties `validation_cas` without any error. Always read the DMS before sending an edit and reuse the layout the API returns.",{"_3465":2834,"_30219":2628,"_20927":58070,"_5":14373,"_27457":57531,"_2948":58071},[],"Re-enrollment authentication settings are now stored independently from initial authentication. Nothing needs migrating, but read both blocks before editing a DMS so that you do not modify one while believing you are editing the other. The console exposes independent editors for both blocks; the DMS guide describes their fields, and you can also edit them through the DMS API.",{"_3465":2835,"_30219":2628,"_20927":58073,"_5":14373,"_27457":57535,"_2948":58074},[],"`PUT /v1/dms/:id` takes the DMS ID from the URL and validates the request body. An ID in the body is ignored, so update clients that relied on it.",{"_3465":2836,"_30219":2628,"_20927":58076,"_5":14373,"_27457":57539,"_2948":58077},[],"Stored certificate type values are renamed: `IMPORTED` becomes `IMPORTED_WITH_KEY` and `EXTERNAL` becomes `IMPORTED_WITHOUT_KEY`. `MANAGED` is unchanged. Adapt consumers that read or match on those values.",{"_3465":2837,"_30219":2628,"_20927":58079,"_5":14373,"_27457":57543,"_2948":58080},[],"The `events` field no longer appears in the device representation. Point consumers at the new endpoints:",{"_3465":2838,"_30219":2628,"_20927":58082,"_5":14373,"_27457":57543,"_2948":58083},[],"`GET /v1/devices/:id/events` returns a device's events.",{"_3465":2839,"_30219":2628,"_20927":58085,"_5":14373,"_27457":57543,"_2948":58086},[],"`POST /v1/devices/:id/events` creates an event.",{"_3465":2840,"_30219":2628,"_20927":58088,"_5":14373,"_27457":57543,"_2948":58089},[],"When the request `Accept` header includes `text/event-stream`, the events endpoint streams over SSE with a keepalive every 15 seconds, and returns `501` when SSE is disabled in the deployment. Each Device Manager instance binds a durable AMQP queue named after its service ID, `device-manager-sse-<uuid>`. Queues from crashed or replaced instances linger until removed, so configure an expiration or cleanup policy on the broker.",{"_3465":2841,"_30219":2628,"_20927":58091,"_5":14373,"_27457":57547,"_2948":58092},[],"`crl_options.subject_key_id_signer` is replaced by the required `crl_options.signer_serial_number`, the serial number of the existing certificate that signs the CRL. A new CA's initial value is the serial number of its current certificate. Requests that still carry `subject_key_id_signer` return an error. The authorization entity that holds these settings is also renamed; see CRL settings keyed by CA ID.",{"_3465":2842,"_30219":2628,"_20927":58094,"_5":14373,"_27457":57551,"_2948":58095},[],"In 3.8.0 the VA keyed each CRL by the CA's SKI, and `GET`/`PUT /v1/roles/{ca-ski}` read and updated it. In 4.0.0 the CRL settings of a CA are keyed by its CA ID, and every CA has its own, even when two CAs share a key:",{"_3465":2843,"_30219":2628,"_20927":58097,"_5":14373,"_27457":57551,"_2948":58098},[],"Route",{"_3465":2844,"_30219":2628,"_20927":58100,"_5":14373,"_27457":57551,"_2948":52496},[],{"_3465":2845,"_30219":2628,"_20927":58102,"_5":14373,"_27457":57551,"_2948":58103},[],"`GET /v1/crl-settings`",{"_3465":2846,"_30219":2628,"_20927":58105,"_5":14373,"_27457":57551,"_2948":58106},[],"Lists the CRL settings; filterable at least by `ca_id`, `status` and `legacy_ski`.",{"_3465":2847,"_30219":2628,"_20927":58108,"_5":14373,"_27457":57551,"_2948":58109},[],"`GET /v1/crl-settings/{ca-id}`",{"_3465":2848,"_30219":2628,"_20927":58111,"_5":14373,"_27457":57551,"_2948":58112},[],"Reads the settings of a CA.",{"_3465":2849,"_30219":2628,"_20927":58114,"_5":14373,"_27457":57551,"_2948":58115},[],"`PUT /v1/crl-settings/{ca-id}`",{"_3465":2850,"_30219":2628,"_20927":58117,"_5":14373,"_27457":57551,"_2948":58118},[],"Replaces `crl_options`.",{"_3465":2851,"_30219":2628,"_20927":58120,"_5":14373,"_27457":57551,"_2948":58121},[],"The options keep their meaning and their defaults: 7 days of `validity`, 6 days and 23 hours of `refresh_interval`, and `regenerate_on_revoke` `true`. `status` (`ACTIVE` or `ARCHIVED`), `legacy_ski` and `latest_crl` are read-only. A `PUT` validates the signer only when it changes, does not regenerate the CRL, and returns `409` when the settings are not `ACTIVE`.",{"_3465":2852,"_30219":2628,"_20927":58123,"_5":14373,"_27457":57551,"_2948":58124},[],"The public endpoint `GET /crl/{id}` takes the CA ID — the form the CDPs of newly issued certificates use — and keeps resolving the SKI form of certificates issued before the upgrade. Certificates issued before the upgrade keep their `/crl/<ski>` distribution points; newly issued ones carry `/crl/<ca-id>`, and both resolve to the same settings. The VA scheduled CRL job requests a new list on its first run, and the new list includes both URLs in its *Issuing Distribution Point*. Until it succeeds, the old list has only the legacy `/crl/<ski>` IDP: verifiers that compare it with the CDP of newly issued certificates cannot validate those certificates. The default schedule can delay the first run by up to about an hour; failures can extend the window.",{"_3465":2853,"_30219":2628,"_20927":58126,"_5":14373,"_27457":57551,"_2948":58127},[],"The migration that turns VA roles into CRL settings cannot be rolled back: its rollback does nothing. CRLs generated after the upgrade are stored under the CA ID, where 3.8.0 does not look for them, and the archived settings of CAs deleted before the upgrade have no signer to go back to. Returning to 3.8.0 requires restoring both the database and the CRL bucket — the object storage that holds the published lists — from the backups taken before the upgrade.",{"_3465":2854,"_30219":2628,"_20927":58129,"_5":14373,"_27457":57551,"_2948":58130},[],"The migration aborts, and the upgrade fails, on five kinds of data:",{"_3465":2855,"_30219":2628,"_20927":58132,"_5":14373,"_27457":57551,"_2948":58133},[],"CA IDs containing `/`: they cannot be used in CRL URLs. Recreate those CAs with a different ID.",{"_3465":2856,"_30219":2628,"_20927":58135,"_5":14373,"_27457":57551,"_2948":58136},[],"An SKI shared by more than one CA: the error names the SKIs and asks you to recreate all but one of them on a different key.",{"_3465":2857,"_30219":2628,"_20927":58138,"_5":14373,"_27457":57551,"_2948":58139},[],"A VA role whose signer certificate has no key: point the role to a signer with a key, or fix the key reference of the certificate, before upgrading.",{"_3465":2858,"_30219":2628,"_20927":58141,"_5":14373,"_27457":57551,"_2948":58142},[],"A CA whose ID equals the `legacy-<ski>` ID the migration reserves for the archived settings of another role whose CA was deleted: recreate that CA with a different ID.",{"_3465":2859,"_30219":2628,"_20927":58144,"_5":14373,"_27457":57551,"_2948":58145},[],"A CA ID equal to the SKI of another VA role: their CRL URLs would be ambiguous.",{"_3465":2860,"_30219":2628,"_20927":58147,"_5":14373,"_27457":57551,"_2948":58148},[],"The settings of a CA deleted before the upgrade are migrated as `ARCHIVED`, with a `legacy-<ski>` ID and no signer: their last CRL is still served, but never regenerated, and `PUT` returns `409`. There is no API way back to `ACTIVE`. The CRL guide describes the full behavior.",{"_3465":2861,"_30219":2628,"_20927":58150,"_5":14373,"_27457":57551,"_2948":58151},[],"**Custom authorization policies.** The entity `va_role` is renamed to `crl_settings`, with `ca_id` as its primary key and `signer_serial_number` as its relation to certificates. Update policies referencing the old entity. Replace the 3.8.0 signer filter `crl_subject_key_id_signer` (or `crl_signer_certificate_serial_number` if used by an intermediate version) with `signer_serial_number`. Replace SKI filter values with the corresponding certificate serial numbers; renaming the filter alone is insufficient.",{"_3465":2862,"_30219":2628,"_20927":58153,"_5":14373,"_27457":57555,"_2948":58154},[],"`va.role.update` becomes `va.crl-settings.update` and `va.role.crl.init` becomes `va.crl-settings.init`; `va.role.crl.create` keeps its name and its payload. Every subject changes from `crl/<ski>` to `crl/<ca-id>`, and the payload of the renamed events changes from the old VA role to the CRL settings of the CA, with `ca_id` instead of `ca_ski`. The alerts migration renames the event types of existing subscriptions automatically, but it does not rewrite their conditions — JSON Path, JSON Schema or JavaScript: review conditions that filter on the old payload or on the old `crl/<ski>` subject, including those for `va.role.crl.create`. Direct event-bus consumers and audit searches must adopt the new names and payload themselves.",{"_3465":2863,"_30219":2628,"_20927":58156,"_5":14373,"_27457":57559,"_2948":58157},[],"Creating or importing a CA registers it under a backend-generated UUID. Any `id` sent in the request body is ignored, and the field is removed from the create and import bodies. Scripts that supplied their own IDs and addressed CAs by them must read the ID the backend returns instead.",{"_3465":2864,"_30219":2628,"_20927":58159,"_5":14373,"_27457":57563,"_2948":58160},[],"The VA migration resolves each role's signer from its stored SKI. It first looks for CA certificates with that SKI; if several match, it selects the oldest CA and logs a warning. If no CA certificate matches, it looks among all certificates with that SKI. The migration aborts with `cannot resolve signer certificate for VA role <ca-ski>, SKI <ski>` if that fallback finds zero or multiple candidates. Fix affected roles before upgrading.",{"_3465":2865,"_30219":2628,"_20927":58162,"_5":14373,"_27457":57567,"_2948":58163},[],"The upgrade runs in a fixed order: prepare the data and values, run `helm upgrade`, then copy the KMS and VA data into the new volumes. The copy must run after the upgrade, because the destination StatefulSets and PVCs do not exist before it. If you are not upgrading an existing release, go straight to Install with Helm.",{"_3465":2866,"_30219":2628,"_20927":58165,"_5":14373,"_27457":57571,"_2948":58166},[],"Take a verifiable backup of PostgreSQL and of the CRL object storage — the VA bucket, or the local volume that holds the CRLs — and schedule downtime. The upgrade moves every service's data into `pki`, and the VA migration is irreversible: returning to 3.8.0 needs both backups (see CRL settings keyed by CA ID).",{"_3465":2867,"_30219":2628,"_20927":58168,"_5":14373,"_27457":57571,"_2948":58169},[],"If the deployment runs on SQLite, `couch_db` or `dynamo_db`, move it to PostgreSQL first.",{"_3465":2868,"_30219":2628,"_20927":58171,"_5":14373,"_27457":57571,"_2948":58172},[],"Resolve duplicate CA IDs and backfill `engine_id` in `kms_keys`, as described in PostgreSQL consolidation.",{"_3465":2869,"_30219":2628,"_20927":58174,"_5":14373,"_27457":57571,"_2948":58175},[],"Optionally, run the pre-upgrade check against the consolidated 3.8.0 data before applying the migrations.",{"_3465":2870,"_30219":2628,"_20927":58177,"_5":14373,"_27457":57571,"_2948":58178},[],"Record the names of your local-storage PVCs:",{"_3465":2871,"_30219":2628,"_20927":58180,"_5":14373,"_27457":57571,"_2948":58181},[],"`helm upgrade` does not touch or delete the old PVCs, but nothing references them after the upgrade. You need their names to copy the data and to clean up later.",{"_3465":2872,"_30219":2628,"_20927":58183,"_5":14373,"_27457":57575,"_2948":58184},[],"The 4.0.0 database migrations refuse data they cannot migrate safely: they abort and name the offending objects. The `upgrade-check` tool reports all of those problems before the upgrade, in one run, with the same wording the migration would use. It is read-only: it never writes database rows or keys.",{"_3465":2873,"_30219":2628,"_20927":58186,"_5":14373,"_27457":57575,"_2948":58187},[],"Image: `ghcr.io/lamassuiot/lamassu-upgrade-check`. Configure it with a KMS-style YAML file passed through `LAMASSU_CONFIG_FILE`; only the `postgres` storage provider is supported.",{"_3465":2874,"_30219":2628,"_20927":58189,"_5":14373,"_27457":57575,"_2948":58190},[],"Run it on the 3.8.0 data after it has been consolidated into the `pki` schemas, and before any 4.0.0 migration runs or any 4.0.0 service starts.",{"_3465":2875,"_30219":2628,"_20927":58192,"_5":14373,"_27457":57575,"_2948":58193},[],"Exit codes: `0` means no problems were found, `1` means at least one problem was found, and `2` means the command could not run (bad configuration, unreachable database, or a database that is not a 3.8.0 one), or a check could not run.",{"_3465":2876,"_30219":2628,"_20927":58195,"_5":14373,"_27457":57575,"_2948":58196},[],"It covers the VA migrations only: an all-clear does not prove that the CA and KMS migration guards pass, so it does not replace the duplicate CA ID and `engine_id` checks described in PostgreSQL consolidation.",{"_3465":2877,"_30219":2628,"_20927":58198,"_5":14373,"_27457":57579,"_2948":58199},[],"**Add `services.authz`.** Configure the JWKS endpoint, the database mappings and the bootstrap principal:",{"_3465":2878,"_30219":2628,"_20927":58201,"_5":14373,"_27457":57579,"_2948":58202},[],"`jwkUrl` is fetched from the `authz` pod, not from the gateway, so a Service in the release namespace can be referenced by its short name. The default points at a Keycloak Service named `auth-keycloak`; set it explicitly if your identity provider lives anywhere else.",{"_3465":2879,"_30219":2628,"_20927":58204,"_5":14373,"_27457":57579,"_2948":58205},[],"`authz` is the authorization service's own storage for principals, grants and policies. `pki` is the database the authorization engine queries when it evaluates policies against entities. Only the `database` field of each entry is read; the connection always uses the global `postgres.hostname`, `postgres.port`, `postgres.username` and `postgres.password` values.",{"_3465":2880,"_30219":2628,"_20927":58207,"_5":14373,"_27457":57579,"_2948":58208},[],"If you kept the 3.8.0 role defaults (`realm_access.roles` and `pki-admin`), the default `services.authz.bootstrap` already matches them.",{"_3465":2881,"_30219":2628,"_20927":58210,"_5":14373,"_27457":57579,"_2948":58211},[],"**Delete the gateway token validation blocks.** Remove `auth.oidc.apiGateway` and `auth.authorization` once their settings are in `services.authz`:",{"_3465":2882,"_30219":2628,"_20927":58213,"_5":14373,"_27457":57579,"_2948":58214},[],"**Rename `toolbox` to `connectivityTest`:**",{"_3465":2883,"_30219":2628,"_20927":58216,"_5":14373,"_27457":57579,"_2948":58217},[],"**Remove the per-service identity overrides** `services.kms.securityContext.runAsGroup` and `services.authz.securityContext.runAsUser`/`runAsGroup`.",{"_3465":2884,"_30219":2628,"_20927":58219,"_5":14373,"_27457":57579,"_2948":58220},[],"**Convert `services.connectors` to a map** keyed by connector ID, each entry with its `type` and `image`:",{"_3465":2885,"_30219":2628,"_20927":58222,"_5":14373,"_27457":57579,"_2948":58223},[],"**Check AMQP.** If you set `amqp.tls: true`, also set `amqp.port` to the broker's TLS listener (commonly `5671`), or set `amqp.tls: false` to stay on plaintext.",{"_3465":2886,"_30219":2628,"_20927":58225,"_5":14373,"_27457":57579,"_2948":58226},[],"**Enable the CA-to-KMS migration** if your CA keys predate the KMS:",{"_3465":2887,"_30219":2628,"_20927":58228,"_5":14373,"_27457":57579,"_2948":58229},[],"**Review the remaining values:** overrides that pinned `services.ui.port` to `80`, the old `probes:` block, the TLS issuer, and explicit `affinity` and `topologySpreadConstraints` where your cluster needs them. Renamed and reshaped values describes each one.",{"_3465":2888,"_30219":2628,"_20927":58231,"_5":14373,"_27457":57579,"_2948":58232},[],"Run `helm lint` with the new values before upgrading; the strict schema reports any key that is still unknown.",{"_3465":2889,"_30219":2628,"_20927":58234,"_5":14373,"_27457":57583,"_2948":58235},[],"Helm runs the pre-upgrade hooks — the CA-to-KMS migration when enabled, and the database job — before applying any workload, so services never start against an unprepared database. If validation rejects unknown values, fix the values file and re-run.",{"_3465":2890,"_30219":2628,"_20927":58237,"_5":14373,"_27457":57583,"_2948":58238},[],"If the deployment uses local KMS or VA storage, those pods fail until you complete step 4, so `--wait` cannot succeed: Helm waits for them to become ready, times out, exits with an error and marks the release `failed`. The hooks have already run by then, and every manifest, including the new StatefulSets and their PVCs, has been applied. Helm does not roll anything back without `--atomic`. Continue with step 4, then re-run the same `helm upgrade` command so it completes and Helm records the release as `deployed`. Both hooks are idempotent, so they are safe to run again.",{"_3465":2891,"_30219":2628,"_20927":58240,"_5":14373,"_27457":57587,"_2948":58241},[],"Skip this step when `services.kms.cryptoEngines` never used a `filesystem` engine and `services.va.fileStore.type` was never `local`.",{"_3465":2892,"_30219":2628,"_20927":58243,"_5":14373,"_27457":57587,"_2948":58244},[],"**Find the new StatefulSets and PVCs.** Their names depend on the release name and any `nameOverride` or `fullnameOverride`; the PVC name is `<volumeClaimTemplate>-<StatefulSet name>-0`:",{"_3465":2893,"_30219":2628,"_20927":58246,"_5":14373,"_27457":57587,"_2948":58247},[],"With release `lamassu` and the default chart name, the new PVCs are `golang-engine-storage-lamassu-kms-0` and `local-crl-file-storage-lamassu-va-0`; with release `prod` they are `golang-engine-storage-prod-lamassu-kms-0` and `local-crl-file-storage-prod-lamassu-va-0`. Confirm both old and new PVCs exist before continuing. If `claims_ok` prints `ABORT`, the block stops before listing the claims: either a StatefulSet lookup failed, or a new claim resolves to the 3.8.0 claim. In the second case the copy would verify against itself and the final cleanup would delete the live volume. The chart always appends `-kms` and `-va` to the release-scoped name, so a collision means the claims are not what this guide expects; investigate before going on. Item 3 runs the same check and refuses to create the helper pod, so nothing touches the volumes. The check returns instead of calling `exit`, which would close your shell and lose the variables set so far. If you only migrate one of the two services, drop the other one's claims from the commands that follow.",{"_3465":2894,"_30219":2628,"_20927":58249,"_5":14373,"_27457":57587,"_2948":58250},[],"**Record the replica counts, scale the new StatefulSets down and wait for every pod that uses the claims to exit**, so nothing writes to either volume while you copy. Helm removes the 3.8.0 `kms` and `va` StatefulSets during the upgrade, but their pods `kms-0` and `va-0` can still be terminating and holding the old claims. While they run, the helper pod either cannot attach the claims or copies a volume that is still being written. The `wait` returns at once for pods that are already gone:",{"_3465":2895,"_30219":2628,"_20927":58252,"_5":14373,"_27457":57587,"_2948":58253},[],"**Run a short-lived helper pod** that mounts all four claims. It runs as root so it can change file ownership, so pin its image by digest and do not mount the service-account token:",{"_3465":2896,"_30219":2628,"_20927":58255,"_5":14373,"_27457":57587,"_2948":58256},[],"**Inspect before writing** so you do not clobber data the new pods may already have written:",{"_3465":2897,"_30219":2628,"_20927":58258,"_5":14373,"_27457":57587,"_2948":58259},[],"An empty result is the common case: a StatefulSet's own pod rarely gets far enough to write anything when its dependent data is missing. If the output is not empty, record the files and confirm with the service owner that they are disposable before you run the copy; do not overlay the 3.8.0 data onto an unknown store.",{"_3465":2898,"_30219":2628,"_20927":58261,"_5":14373,"_27457":57587,"_2948":58262},[],"**Copy the data, align ownership and verify the copy.** The second command must print `copy verified`; any `diff` output means the copy is incomplete, so do not continue:",{"_3465":2899,"_30219":2628,"_20927":58264,"_5":14373,"_27457":57587,"_2948":58265},[],"The `chown` is required even if the old files already look non-root-owned, because 4.0.0 requires exactly `65532:65532` and does not fall back to whatever the image declares.",{"_3465":2900,"_30219":2628,"_20927":58267,"_5":14373,"_27457":57587,"_2948":58268},[],"**Remove the helper and restore the recorded replica counts:**",{"_3465":2901,"_30219":2628,"_20927":58270,"_5":14373,"_27457":57587,"_2948":58271},[],"**Re-run the step 3 `helm upgrade` command.** The KMS and VA pods now start against the copied data, so `--wait` succeeds and the release moves from `failed` to `deployed`.",{"_3465":2902,"_30219":2628,"_20927":58273,"_5":14373,"_27457":57591,"_2948":58274},[],"After the upgrade that performed the CA-to-KMS migration succeeds, remove `migrations.caToKms.enabled` from your values (it defaults to `false`). The hook reads the legacy 3.8.0 `kms-config` ConfigMap while it still exists and falls back to the release-scoped `<release>-lamassu-kms-config` once it is gone.",{"_3465":2903,"_30219":2628,"_20927":58276,"_5":14373,"_27457":57591,"_2948":58277},[],"Then go through the validation checklist. Keep the old PVCs until it passes.",{"_3465":2904,"_30219":2628,"_20927":58279,"_5":14373,"_27457":57595,"_2948":58280},[],"Without the chart's database job, no tool moves data between databases: the migration tooling only applies migrations to a schema that already exists. Move each per-service database into its `pki` schema yourself, preserving structure, indexes, constraints, data and migration history, with writes stopped and a verified backup in hand.",{"_3465":2905,"_30219":2628,"_20927":58282,"_5":14373,"_27457":57595,"_2948":58283},[],"Run the migrations in the required order, one schema at a time: `kms` first, then the `ca-to-kms-migration` tool (needed only for legacy deployments whose CA keys are named by SKI), then `ca`, then `va`. The `devicemanager`, `dmsmanager` and `alerts` schemas are independent and can be migrated in any order. With Helm, the chart's pre-install job applies the schemas in the correct order automatically.",{"_3465":2906,"_30219":2628,"_20927":58285,"_5":14373,"_27457":57595,"_2948":58286},[],"If `kms` has not been migrated, the `ca` migration fails with `kms schema not found: migrate the kms schema before the ca schema`. The `va` migration likewise requires `ca` to be migrated first.",{"_3465":2907,"_30219":2628,"_20927":58288,"_5":14373,"_27457":57595,"_2948":58289},[],"The schemas reference each other, so the PostgreSQL role running the migrations needs cross-schema privileges: the `ca` schema needs `USAGE` on `kms` plus `SELECT`, `REFERENCES` and `INSERT` on `kms.kms_keys`, and the `va` schema needs `USAGE` on `ca` plus `SELECT` and `REFERENCES` on `ca.certificates` and `SELECT` on `ca.ca_certificates`. Without them the migration aborts; grant the missing privileges and rerun the failed schema. After migrating `ca`, if the CA service runs as a different user than the migration user, grant it `SELECT` on `ca.certificates_view` (`GRANT SELECT ON ca.certificates_view TO service_user`). Without this grant, certificate and CA reads fail with `permission denied for table certificates_view`.",{"_3465":2908,"_30219":2628,"_20927":58291,"_5":14373,"_27457":57595,"_2948":58292},[],"To apply migrations by hand, `goose-lamassu` must run against the `pki` database with `search_path=<schema>` in the connection string. The binary validates only `search_path`, not the database name, so check `dbname=pki` before running it, and repeat for `kms`, `ca`, `va`, `devicemanager`, `dmsmanager` and `alerts`:",{"_3465":2909,"_30219":2628,"_20927":58294,"_5":14373,"_27457":57595,"_2948":58295},[],"Run `ca-to-kms-migration` first with `--dry-run`, which reports without writing to KMS storage, and then for real:",{"_3465":2910,"_30219":2628,"_20927":58297,"_5":14373,"_27457":57595,"_2948":58298},[],"Point the tool's `storage` configuration at the `pki` database, where the CA and KMS data now live in the `ca` and `kms` schemas. The tool's options are described in `backend/cmd/ca-to-kms-migration/README.md` in the `lamassuiot` repository.",{"_3465":2911,"_30219":2628,"_20927":58300,"_5":14373,"_27457":57595,"_2948":58301},[],"Both tools' READMEs document the 4.0.0 `pki` layout and match this page: `goose-lamassu` uses `dbname=pki` examples and does not validate the database name, and the `ca-to-kms-migration` README describes the single `pki` database and the migration order.",{"_3465":2912,"_30219":2628,"_20927":58303,"_5":14373,"_27457":57599,"_2948":58304},[],"**KMS or VA pods crash with `no such file or directory` or `code=NotFound` right after the upgrade.** The pods are bound to the new, empty PVCs and the data migration has not run yet, or was copied into the wrong PVC. Follow step 4 and check that all four claims exist.",{"_3465":2913,"_30219":2628,"_20927":58306,"_5":14373,"_27457":57599,"_2948":58307},[],"**`helm upgrade --wait` times out and `helm status` reports the release as `failed`.** With local KMS or VA storage this is expected on the first run: the new pods cannot become ready before their data is copied. The hooks ran and the manifests and PVCs were applied, so complete step 4 and re-run the same `helm upgrade` command. If other pods are also not ready, check their logs, because something else is wrong.",{"_3465":2914,"_30219":2628,"_20927":58309,"_5":14373,"_27457":57599,"_2948":58310},[],"**The helper pod stays `Pending` or `ContainerCreating` and `kubectl wait` times out.** Another pod still holds one of the claims; on block storage `kubectl describe pod pvc-migrate-helper` shows a `Multi-Attach error`. Check with `kubectl get pods -n $NAMESPACE` that `kms-0`, `va-0` and the new KMS and VA pods are gone, then re-run the wait.",{"_3465":2915,"_30219":2628,"_20927":58312,"_5":14373,"_27457":57599,"_2948":58313},[],"**`helm upgrade` fails with an unknown-key validation error.** Remove or rename the legacy values — typically `toolbox`, `auth.oidc.apiGateway` or `auth.authorization` — because the strict schema rejects keys it does not know.",{"_3465":2916,"_30219":2628,"_20927":58315,"_5":14373,"_27457":57599,"_2948":58316},[],"**The upgrade fails at the database job.** The PostgreSQL role cannot create databases or schemas, or a schema migration aborted: on duplicate CA IDs or missing `engine_id` values, or in the VA schema on a CA ID containing `/`, an SKI shared by more than one CA (the error asks you to recreate all but one of them on a different key), a role whose signer certificate has no key, a CA ID reserved for the archived settings of another role, or a CA ID equal to another role's SKI. The abort message names the offending objects; fix them and re-run the upgrade.",{"_3465":2917,"_30219":2628,"_20927":58318,"_5":14373,"_27457":57599,"_2948":58319},[],"**The upgrade fails at the CA-to-KMS hook.** CA certificates that share a `subject_key_id` declare conflicting `engine_id`s. Resolve the conflict and re-run.",{"_3465":2918,"_30219":2628,"_20927":58321,"_5":14373,"_27457":57599,"_2948":58322},[],"**Nobody can log in after the upgrade.** Check that `services.authz.jwkUrl` is reachable from the `authz` pod, that `services.authz.bootstrap` matches a role your OIDC provider actually assigns, and that the database job completed.",{"_3465":2919,"_30219":2628,"_20927":58324,"_5":14373,"_27457":57599,"_2948":58325},[],"**A migration aborts with `kms schema not found`.** The schemas must be migrated in order: run the `kms` schema migration before the `ca` schema migration.",{"_3465":2920,"_30219":2628,"_20927":58327,"_5":14373,"_27457":57599,"_2948":58328},[],"**A migration aborts with `ca schema not found`.** Run the `ca` schema migration before the `va` schema migration.",{"_3465":2921,"_30219":2628,"_20927":58330,"_5":14373,"_27457":57599,"_2948":58331},[],"**The VA migration fails with `cannot resolve signer certificate for VA role ... N candidates`.** The migration cannot uniquely identify a signer certificate from the SKI stored on the role. Review the SKI and candidate certificates reported in the error; correct the pre-migration data with a verified backup and rerun the migration. The new `signer_serial_number` field is created during that migration, so it cannot be set through the VA API while the migration is failing.",{"_3465":2922,"_30219":2628,"_20927":58333,"_5":14373,"_27457":57599,"_2948":58334},[],"**A migration or service fails with `permission denied for table ...`.** The PostgreSQL role is missing the cross-schema privileges listed in Deployments without Helm; this includes `certificates_view` when the post-migration `GRANT SELECT` was skipped. Grant the missing privileges and re-run.",{"_3465":2923,"_30219":2628,"_20927":58336,"_5":14373,"_27457":57602,"_2948":58337},[],"After the upgrade, check in this order:",{"_3465":2924,"_30219":2628,"_20927":58339,"_5":14373,"_27457":57602,"_2948":58340},[],"**Databases.** Each service reads the `pki` database with its own schema, `authz` and `wfx` data are reachable, and the migration status is registered per schema, including the CA unique-ID and KMS composite-key migrations and the foreign-key migrations that run per schema in the required order.",{"_3465":2925,"_30219":2628,"_20927":58342,"_5":14373,"_27457":57602,"_2948":58343},[],"**KMS and VA start cleanly.** Their logs show no `no such file or directory` or `code=NotFound` errors.",{"_3465":2926,"_30219":2628,"_20927":58345,"_5":14373,"_27457":57602,"_2948":58346},[],"**Existing KMS keys work.** Issue a certificate from a CA that existed before the upgrade. None of the other checks reads a KMS key, so this is the only one that proves the key material was copied.",{"_3465":2927,"_30219":2628,"_20927":58348,"_5":14373,"_27457":57602,"_2948":58349},[],"**Existing CRLs are served.** `GET /crl/<ca-id>` on VA returns a previously issued CRL, and `GET /crl/<ca-ski>` with the legacy SKI of a certificate issued before the upgrade also resolves. The VA scheduled CRL job has issued a new list under the CA ID with both URLs in its IDP; check its logs if regeneration has not succeeded.",{"_3465":2928,"_30219":2628,"_20927":58351,"_5":14373,"_27457":57602,"_2948":58352},[],"**Renamed VA events.** Alert subscriptions to `va.role.update` and `va.role.crl.init` now subscribe to `va.crl-settings.update` and `va.crl-settings.init`, and conditions for all VA events, including `va.role.crl.create`, have been reviewed against the new payload (`ca_id` instead of `ca_ski`) and subject (`crl/<ca-id>` instead of `crl/<ski>`). Direct consumers and audit searches use the new event names.",{"_3465":2929,"_30219":2628,"_20927":58354,"_5":14373,"_27457":57602,"_2948":58355},[],"**Legacy CA keys.** If the CA-to-KMS migration ran, review its report and warnings and confirm the expected keys appear in the KMS. Migrated CA certificates now report `key_id` and `has_private_key`, which you can use to confirm the registration.",{"_3465":2930,"_30219":2628,"_20927":58357,"_5":14373,"_27457":57602,"_2948":58358},[],"**Connectivity.** `helm test \"$RELEASE\" -n $NAMESPACE --logs` passes; the hook checks the CA, DMS Manager, Device Manager and VA health endpoints and the UI response.",{"_3465":2931,"_30219":2628,"_20927":58360,"_5":14373,"_27457":57602,"_2948":58361},[],"**Authorization.** Sign in as the bootstrap principal and confirm administration works, check that an identity without permissions receives `403`, and review client and integration permissions.",{"_3465":2932,"_30219":2628,"_20927":58363,"_5":14373,"_27457":57602,"_2948":58364},[],"**AMQP.** The backend connects to the broker with the expected TLS settings, and the cleanup policy for SSE queues is in place.",{"_3465":2933,"_30219":2628,"_20927":58366,"_5":14373,"_27457":57602,"_2948":58367},[],"**Device events.** `GET /v1/devices/:id/events` returns the historical events of a device that had them.",{"_3465":2934,"_30219":2628,"_20927":58369,"_5":14373,"_27457":57602,"_2948":58370},[],"**Webhooks without file fields.** For each DMS that uses a webhook for enrollment or re-enrollment, the `config` block carries `insecure_skip_verify` and the expected option block (`apikey_options`, `jwt_options` or `mtls_options`), with the certificate and key as PEM and no `cert_file` or `key_file`.",{"_3465":2935,"_30219":2628,"_20927":58372,"_5":14373,"_27457":57602,"_2948":58373},[],"**Receiver verification.** `insecure_skip_verify` is `false`, unless the receiver certificate is intentionally unverified.",{"_3465":2936,"_30219":2628,"_20927":58375,"_5":14373,"_27457":57602,"_2948":58376},[],"**Webhook delivery.** One enroll or re-enroll through each migrated webhook completes its authorization call.",{"_3465":2937,"_30219":2628,"_20927":58378,"_5":14373,"_27457":57602,"_2948":58379},[],"**Trust set.** `est_rfc7030_settings.client_certificate_settings.validation_cas` holds the expected CAs, in particular those of the old CA during rotation overlaps.",{"_3465":2938,"_30219":2628,"_20927":58381,"_5":14373,"_27457":57602,"_2948":58382},[],"**API clients.** Scripts and consoles no longer use the old DMS layout (flat `additional_validation_cas`, or the legacy `mtls`, `apikey` and `oidc` fields), send DMS updates with the ID in the URL, and match on the new certificate `type` values.",{"_3465":2939,"_30219":2628,"_20927":58384,"_5":14373,"_27457":57606,"_2948":58385},[],"Only once every check passes, delete the orphaned 3.8.0 volumes to reclaim storage. The delete is irreversible and the old KMS volume may hold the last copy of your CA key material, so take a `VolumeSnapshot` or a backup of both old PVCs first and keep it until you are confident the upgraded deployment is healthy. These are the fixed 3.8.0 names recorded in step 1; before deleting, confirm that neither is mounted by a running pod, for example with `kubectl describe pvc -n $NAMESPACE golang-engine-storage-kms-0 local-crl-file-storage-va-0`, where `Used By` must be `<none>`:",{"_3465":2940,"_30219":2628,"_20927":58387,"_5":14373,"_27457":57606,"_2948":58388},[],"The 3.8.0 per-service databases are no longer used either. Drop them only after the same checks pass and your PostgreSQL backup is verified.",{"_3465":2941,"_30219":2628,"_20927":58390,"_5":14373,"_27457":57606,"_2948":58391},[],"<Card title=\"Install with Helm\" description=\"Prepare dependencies, configure values and install a controlled deployment.\" href=\"/docs/deployment/self-hosted/helm\" />",{"_3465":2942,"_30219":2628,"_20927":58393,"_5":14373,"_27457":57606,"_2948":58394},[],"<Card title=\"Access control\" description=\"Principals, policies and the first administrator.\" href=\"/docs/platform/administration/access-control\" />",{"_3465":2943,"_30219":2628,"_20927":58396,"_5":14373,"_27457":57606,"_2948":58397},[],"<Card title=\"Configure a DMS\" description=\"Enrollment, re-enrollment and webhook settings.\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />","sorting",{"_58400":58401,"_58402":58403,"_58404":58405,"_58406":58407,"_18133":2983,"_70137":2983},"language","english","sortableProperties",[2948,30219,5,27457],"sortablePropertiesWithTypes",{"_2948":25026,"_30219":25026,"_5":25026,"_27457":25026},"sorts",{"_2948":58408,"_30219":61341,"_5":64273,"_27457":67205},{"_4645":58409,"_58410":58411,"_5":25026},{"_14449":5980,"_14829":22545,"_14848":3415,"_29222":3318,"_14835":5054,"_19859":4001,"_14470":25188,"_14477":3350,"_29164":3438,"_29573":3036,"_29594":4622,"_29198":5960,"_34539":6922,"_29301":7502,"_29638":4936,"_34546":4787,"_34549":7053,"_34552":7639,"_34555":14295,"_30045":3667,"_34560":5115,"_34562":4183,"_30075":24223,"_14844":24395,"_34566":4735,"_34569":4056,"_34571":6197,"_29622":7606,"_30040":3366,"_30088":4986,"_34576":3093,"_34578":7593,"_34580":7480,"_29318":3048,"_34583":3933,"_34585":5817,"_34587":7044,"_34589":3655,"_34591":6971,"_29235":10772,"_34594":7000,"_34596":8414,"_29229":3814,"_29659":6577,"_34600":9541,"_34602":4190,"_34605":9181,"_29275":5828,"_34609":4037,"_29155":18542,"_34612":7028,"_29203":10461,"_34615":7482,"_34617":14330,"_34620":5159,"_14838":5178,"_34623":17628,"_34625":5844,"_34628":16706,"_34630