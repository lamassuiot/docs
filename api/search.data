om AWS Marketplace",[49125,49126,49127],"Docs","Deployment","Other models",[],{"_3461":16,"_30106":15,"_20907":49130,"_5":14363,"_27392":15,"_2946":49131},[],"Run a preconfigured Lamassu IoT instance on Amazon EC2.",{"_3461":17,"_30106":15,"_5":30435,"_20907":49133,"_27392":49134,"_2946":49135},[],"/docs/deployment/aws-marketplace#before-you-begin","Before you begin",{"_3461":18,"_30106":15,"_5":30435,"_20907":49137,"_27392":49138,"_2946":49139},[],"/docs/deployment/aws-marketplace#infrastructure-requirements","Infrastructure requirements",{"_3461":19,"_30106":15,"_5":30435,"_20907":49141,"_27392":49142,"_2946":49143},[],"/docs/deployment/aws-marketplace#open-the-offer","Open the offer",{"_3461":20,"_30106":15,"_5":30435,"_20907":49145,"_27392":49146,"_2946":49147},[],"/docs/deployment/aws-marketplace#configure-the-instance","Configure the instance",{"_3461":21,"_30106":15,"_5":30435,"_20907":49149,"_27392":49150,"_2946":49151},[],"/docs/deployment/aws-marketplace#limit-network-access","Limit network access",{"_3461":22,"_30106":15,"_5":30435,"_20907":49153,"_27392":49154,"_2946":49155},[],"/docs/deployment/aws-marketplace#launch-and-verify","Launch and verify",{"_3461":23,"_30106":15,"_5":30435,"_20907":49157,"_27392":49158,"_2946":49159},[],"/docs/deployment/aws-marketplace#next-step","Next step",{"_3461":24,"_30106":15,"_20907":49161,"_5":14363,"_27392":15,"_2946":49162},[],"The AWS Marketplace offering reduces initial setup to an EC2 instance inside your account. You keep control of the network, storage and operation of the machine.",{"_3461":25,"_30106":15,"_20907":49164,"_5":14363,"_27392":49134,"_2946":49165},[],"Permissions to subscribe to AWS Marketplace products and launch EC2 instances.",{"_3461":26,"_30106":15,"_20907":49167,"_5":14363,"_27392":49134,"_2946":49168},[],"A VPC and a subnet from which administrators and devices can reach the instance.",{"_3461":27,"_30106":15,"_20907":49170,"_5":14363,"_27392":49134,"_2946":49171},[],"A security group allowing the necessary endpoints.",{"_3461":28,"_30106":15,"_20907":49173,"_5":14363,"_27392":49138,"_2946":49174},[],"**Compute:** a `t3.large` instance at minimum. Use `t3.xlarge` or higher when the load requires it.",{"_3461":29,"_30106":15,"_20907":49176,"_5":14363,"_27392":49138,"_2946":49177},[],"**Storage:** an EBS `gp3` volume of at least 50 GB, sized to your inventory and retention needs.",{"_3461":30,"_30106":15,"_20907":49179,"_5":14363,"_27392":49138,"_2946":49180},[],"**Network:** HTTPS access from the necessary consumers, restricted to trusted networks.",{"_3461":31,"_30106":15,"_20907":49182,"_5":14363,"_27392":49142,"_2946":49183},[],"Go to Lamassu IoT on AWS Marketplace and review the terms before subscribing.",{"_3461":32,"_30106":15,"_20907":49185,"_5":14363,"_27392":49146,"_2946":49186},[],"Select `t3.large` or higher, assign at least 50 GB of `gp3` storage and choose the target VPC and subnet.",{"_3461":33,"_30106":15,"_20907":49188,"_5":14363,"_27392":49150,"_2946":49189},[],"Configure the security group for ports `443`, `8443` and `9443`. Restrict the origins to the administrative and device networks that really need to connect.",{"_3461":34,"_30106":15,"_20907":49191,"_5":14363,"_27392":49154,"_2946":49192},[],"Start the instance and open the console at `https://<public-ip>`. Check you can authenticate before continuing.",{"_3461":35,"_30106":15,"_20907":49194,"_5":14363,"_27392":49158,"_2946":49195},[],"Continue with Create your first CA to validate the instance's cryptographic configuration.",{"_3461":36,"_30106":36,"_5":14715,"_2946":49197,"_30438":49198,"_20907":49199,"_27392":36},"Deploy Lamassu",[49125,49126],[],{"_3461":37,"_30106":36,"_20907":49201,"_5":14363,"_27392":36,"_2946":49202},[],"Choose the operating model that fits your infrastructure and control requirements.",{"_3461":38,"_30106":36,"_5":30435,"_20907":49204,"_27392":49205,"_2946":49206},[],"/docs/deployment/overview#choose-a-model","Choose a model",{"_3461":39,"_30106":36,"_5":30435,"_20907":49208,"_27392":49209,"_2946":49210},[],"/docs/deployment/overview#just-want-to-evaluate-the-platform","Just want to evaluate the platform?",{"_3461":40,"_30106":36,"_5":30435,"_20907":49212,"_27392":49213,"_2946":49214},[],"/docs/deployment/overview#after-deployment","After deployment",{"_3461":41,"_30106":36,"_20907":49216,"_5":14363,"_27392":36,"_2946":49217},[],"You can run Lamassu on your own Kubernetes cluster, deploy a prebuilt image from AWS Marketplace or consume the platform as a managed service.",{"_3461":42,"_30106":36,"_20907":49219,"_5":14363,"_27392":49205,"_2946":49220},[],"Model",{"_3461":43,"_30106":36,"_20907":49222,"_5":14363,"_27392":49205,"_2946":49223},[],"Recommended for",{"_3461":44,"_30106":36,"_20907":49225,"_5":14363,"_27392":49205,"_2946":49226},[],"Who operates the infrastructure",{"_3461":45,"_30106":36,"_20907":49228,"_5":14363,"_27392":49205,"_2946":49229},[],"Starting point",{"_3461":46,"_30106":36,"_20907":49231,"_5":14363,"_27392":49205,"_2946":49232},[],"Kubernetes self-managed",{"_3461":47,"_30106":36,"_20907":49234,"_5":14363,"_27392":49205,"_2946":49235},[],"Production, regulated environments and custom deployments",{"_3461":48,"_30106":36,"_20907":49237,"_5":14363,"_27392":49205,"_2946":49238},[],"Your team",{"_3461":49,"_30106":36,"_20907":49240,"_5":14363,"_27392":49205,"_2946":49241},[],"Helm or Fastlane",{"_3461":50,"_30106":36,"_20907":49243,"_5":14363,"_27392":49205,"_2946":49244},[],"AWS Marketplace",{"_3461":51,"_30106":36,"_20907":49246,"_5":14363,"_27392":49205,"_2946":49247},[],"Evaluation or a dedicated deployment inside an AWS account",{"_3461":52,"_30106":36,"_20907":49249,"_5":14363,"_27392":49205,"_2946":49238},[],{"_3461":53,"_30106":36,"_20907":49251,"_5":14363,"_27392":49205,"_2946":49252},[],"Preconfigured image on EC2",{"_3461":54,"_30106":36,"_20907":49254,"_5":14363,"_27392":49205,"_2946":49255},[],"SaaS",{"_3461":55,"_30106":36,"_20907":49257,"_5":14363,"_27392":49205,"_2946":49258},[],"Teams that want to use the platform without operating it",{"_3461":56,"_30106":36,"_20907":49260,"_5":14363,"_27392":49205,"_2946":49261},[],"Lamassu",{"_3461":57,"_30106":36,"_20907":49263,"_5":14363,"_27392":49205,"_2946":49264},[],"Managed subscription",{"_3461":58,"_30106":36,"_20907":49266,"_5":14363,"_27392":49205,"_2946":49267},[],"<Card title=\"Kubernetes self-managed\" description=\"Control network, storage, keys, dependencies and the upgrade cycle.\" href=\"/docs/deployment/self-hosted/overview\" />",{"_3461":59,"_30106":36,"_20907":49269,"_5":14363,"_27392":49205,"_2946":49270},[],"<Card title=\"AWS Marketplace\" description=\"Launch a preconfigured Lamassu instance on AWS EC2.\" href=\"/docs/deployment/aws-marketplace\" />",{"_3461":60,"_30106":36,"_20907":49272,"_5":14363,"_27392":49205,"_2946":49273},[],"<Card title=\"Lamassu SaaS\" description=\"Use an operated and updated instance as a managed service.\" href=\"/docs/deployment/saas\" />",{"_3461":61,"_30106":36,"_20907":49275,"_5":14363,"_27392":49209,"_2946":49276},[],"Use Fastlane to bring up PostgreSQL, Keycloak, RabbitMQ and Lamassu on a Kubernetes cluster through a single flow. It is intended for labs, demos and bootstrap; for production, configure dependencies and Helm values explicitly.",{"_3461":62,"_30106":36,"_20907":49278,"_5":14363,"_27392":49213,"_2946":49279},[],"Once the console is available, continue with Create your first CA. That quickstart verifies the cryptographic engine and issuance work correctly.",{"_3461":63,"_30106":63,"_5":14715,"_2946":49281,"_30438":49282,"_20907":49283,"_27392":63},"Use Lamassu as SaaS",[49125,49126,49127],[],{"_3461":64,"_30106":63,"_20907":49285,"_5":14363,"_27392":63,"_2946":49286},[],"Consume Lamassu as a managed service without operating your own infrastructure.",{"_3461":65,"_30106":63,"_5":30435,"_20907":49288,"_27392":49289,"_2946":49290},[],"/docs/deployment/saas#what-the-service-manages","What the service manages",{"_3461":66,"_30106":63,"_5":30435,"_20907":49292,"_27392":49293,"_2946":49294},[],"/docs/deployment/saas#plans","Plans",{"_3461":67,"_30106":63,"_5":30435,"_20907":49296,"_27392":49297,"_2946":49298},[],"/docs/deployment/saas#request-access","Request access",{"_3461":68,"_30106":63,"_20907":49300,"_5":14363,"_27392":63,"_2946":49301},[],"Lamassu SaaS offers the platform's capabilities in a managed environment. It is the right option when your team wants to focus on PKI and device identities, not on maintaining the infrastructure that supports them.",{"_3461":69,"_30106":63,"_20907":49303,"_5":14363,"_27392":49289,"_2946":49304},[],"Platform availability and maintenance.",{"_3461":70,"_30106":63,"_20907":49306,"_5":14363,"_27392":49289,"_2946":49307},[],"Automatic backups.",{"_3461":71,"_30106":63,"_20907":49309,"_5":14363,"_27392":49289,"_2946":49310},[],"Version upgrades.",{"_3461":72,"_30106":63,"_20907":49312,"_5":14363,"_27392":49289,"_2946":49313},[],"Technical support and SLA according to your plan.",{"_3461":73,"_30106":63,"_20907":49315,"_5":14363,"_27392":49293,"_2946":49316},[],"Plan",{"_3461":74,"_30106":63,"_20907":49318,"_5":14363,"_27392":49293,"_2946":49319},[],"Devices",{"_3461":75,"_30106":63,"_20907":49321,"_5":14363,"_27392":49293,"_2946":49322},[],"Support",{"_3461":76,"_30106":63,"_20907":49324,"_5":14363,"_27392":49293,"_2946":49325},[],"SLA",{"_3461":77,"_30106":63,"_20907":49327,"_5":14363,"_27392":49293,"_2946":49328},[],"Starter",{"_3461":78,"_30106":63,"_20907":49330,"_5":14363,"_27392":49293,"_2946":49331},[],"Up to 1,000",{"_3461":79,"_30106":63,"_20907":49333,"_5":14363,"_27392":49293,"_2946":49334},[],"Email",{"_3461":80,"_30106":63,"_20907":49336,"_5":14363,"_27392":49293,"_2946":49337},[],"99.5 %",{"_3461":81,"_30106":63,"_20907":49339,"_5":14363,"_27392":49293,"_2946":49340},[],"Professional",{"_3461":82,"_30106":63,"_20907":49342,"_5":14363,"_27392":49293,"_2946":49343},[],"Up to 10,000",{"_3461":83,"_30106":63,"_20907":49345,"_5":14363,"_27392":49293,"_2946":49346},[],"Email and chat",{"_3461":84,"_30106":63,"_20907":49348,"_5":14363,"_27392":49293,"_2946":49349},[],"99.9 %",{"_3461":85,"_30106":63,"_20907":49351,"_5":14363,"_27392":49293,"_2946":49352},[],"Enterprise",{"_3461":86,"_30106":63,"_20907":49354,"_5":14363,"_27392":49293,"_2946":49355},[],"Unlimited",{"_3461":87,"_30106":63,"_20907":49357,"_5":14363,"_27392":49293,"_2946":49358},[],"Dedicated",{"_3461":88,"_30106":63,"_20907":49360,"_5":14363,"_27392":49293,"_2946":49361},[],"99.99 %",{"_3461":89,"_30106":63,"_20907":49363,"_5":14363,"_27392":49297,"_2946":49364},[],"Contact the Lamassu team through lamassu.io to request a demo or choose a plan.",{"_3461":90,"_30106":63,"_20907":49366,"_5":14363,"_27392":49297,"_2946":49367},[],"When you receive your instance's credentials, continue with Get started.",{"_3461":91,"_30106":91,"_5":14715,"_2946":49369,"_30438":49370,"_20907":49371,"_27392":91},"Fastlane",[49125,49126,49232],[],{"_3461":92,"_30106":91,"_20907":49373,"_5":14363,"_27392":91,"_2946":49374},[],"Bootstrap a complete Lamassu evaluation or lab environment on an existing Kubernetes cluster.",{"_3461":93,"_30106":91,"_5":30435,"_20907":49376,"_27392":49377,"_2946":49378},[],"/docs/deployment/self-hosted/fastlane#deploy-with-fastlane","Deploy with Fastlane",{"_3461":94,"_30106":91,"_5":30435,"_20907":49380,"_27392":49381,"_2946":49382},[],"/docs/deployment/self-hosted/fastlane#what-fastlane-adds","What Fastlane adds",{"_3461":95,"_30106":91,"_5":30435,"_20907":49384,"_27392":49385,"_2946":49135},[],"/docs/deployment/self-hosted/fastlane#before-you-begin",{"_3461":96,"_30106":91,"_5":30435,"_20907":49387,"_27392":49388,"_2946":49389},[],"/docs/deployment/self-hosted/fastlane#quick-start","Quick start",{"_3461":97,"_30106":91,"_5":30435,"_20907":49391,"_27392":49392,"_2946":49393},[],"/docs/deployment/self-hosted/fastlane#gateway-address-selection","Gateway address selection",{"_3461":98,"_30106":91,"_5":30435,"_20907":49395,"_27392":49396,"_2946":49397},[],"/docs/deployment/self-hosted/fastlane#command-line-options","Command-line options",{"_3461":99,"_30106":91,"_5":30435,"_20907":49399,"_27392":49400,"_2946":49401},[],"/docs/deployment/self-hosted/fastlane#development-mode","Development mode",{"_3461":100,"_30106":91,"_5":30435,"_20907":49403,"_27392":49404,"_2946":49405},[],"/docs/deployment/self-hosted/fastlane#what-the-script-configures","What the script configures",{"_3461":101,"_30106":91,"_5":30435,"_20907":49407,"_27392":49408,"_2946":49409},[],"/docs/deployment/self-hosted/fastlane#tls-behavior","TLS behavior",{"_3461":102,"_30106":91,"_5":30435,"_20907":49411,"_27392":49412,"_2946":49413},[],"/docs/deployment/self-hosted/fastlane#credentials-and-generated-files","Credentials and generated files",{"_3461":103,"_30106":91,"_5":30435,"_20907":49415,"_27392":49416,"_2946":49417},[],"/docs/deployment/self-hosted/fastlane#verify-the-installation","Verify the installation",{"_3461":104,"_30106":91,"_20907":49419,"_5":14363,"_27392":49377,"_2946":49420},[],"Fastlane is the automated path for evaluations, demos, CI and small lab clusters. It installs PostgreSQL, Keycloak, RabbitMQ, Envoy Gateway and Lamassu, then configures them to work together.",{"_3461":105,"_30106":91,"_20907":49422,"_5":14363,"_27392":49377,"_2946":49423},[],"For production, use Helm so database, identity, credentials, certificates, storage and upgrades remain explicit.",{"_3461":106,"_30106":91,"_20907":49425,"_5":14363,"_27392":49381,"_2946":49426},[],"Fastlane closes some of the gaps intentionally left by the application chart:",{"_3461":107,"_30106":91,"_20907":49428,"_5":14363,"_27392":49381,"_2946":49429},[],"Fastlane installs or configures",{"_3461":108,"_30106":91,"_20907":49431,"_5":14363,"_27392":49381,"_2946":49432},[],"You still provide",{"_3461":109,"_30106":91,"_20907":49434,"_5":14363,"_27392":49381,"_2946":49435},[],"PostgreSQL, RabbitMQ and Keycloak instances for evaluation",{"_3461":110,"_30106":91,"_20907":49437,"_5":14363,"_27392":49381,"_2946":49438},[],"The Kubernetes cluster, nodes and persistent storage",{"_3461":111,"_30106":91,"_20907":49440,"_5":14363,"_27392":49381,"_2946":49441},[],"Envoy Gateway 1.8 and the `eg` `GatewayClass`",{"_3461":112,"_30106":91,"_20907":49443,"_5":14363,"_27392":49381,"_2946":49444},[],"cert-manager, external network reachability, DNS and firewall/NAT rules",{"_3461":113,"_30106":91,"_20907":49446,"_5":14363,"_27392":49381,"_2946":49447},[],"A self-signed Lamassu certificate flow, generated dependency credentials and an initial user",{"_3461":114,"_30106":91,"_20907":49449,"_5":14363,"_27392":49381,"_2946":49450},[],"Client trust for the self-signed CA, or a trusted certificate passed to the script",{"_3461":115,"_30106":91,"_20907":49452,"_5":14363,"_27392":49381,"_2946":49453},[],"Optional observability and lab HSM components",{"_3461":116,"_30106":91,"_20907":49455,"_5":14363,"_27392":49381,"_2946":49456},[],"Production monitoring retention, backups, HA and a production HSM/key service",{"_3461":117,"_30106":91,"_20907":49458,"_5":14363,"_27392":49381,"_2946":49459},[],"Fastlane does not turn the resulting stack into a production service: it does not create the cluster, public DNS, firewall rules, backups, high availability or a trusted public certificate.",{"_3461":118,"_30106":91,"_20907":49461,"_5":14363,"_27392":49385,"_2946":49462},[],"You need:",{"_3461":119,"_30106":91,"_20907":49464,"_5":14363,"_27392":49385,"_2946":49465},[],"an existing Kubernetes cluster",{"_3461":120,"_30106":91,"_20907":49467,"_5":14363,"_27392":49385,"_2946":49468},[],"`kubectl` and Helm, or the MicroK8s CLI",{"_3461":121,"_30106":91,"_20907":49470,"_5":14363,"_27392":49385,"_2946":49471},[],"`yq`",{"_3461":122,"_30106":91,"_20907":49473,"_5":14363,"_27392":49385,"_2946":23628},[],{"_3461":123,"_30106":91,"_20907":49475,"_5":14363,"_27392":49385,"_2946":49476},[],"`jq` only when using `--sample-data` or `--development`",{"_3461":124,"_30106":91,"_20907":49478,"_5":14363,"_27392":49385,"_2946":49479},[],"`ssh-keygen` only when using `--with-hsm`",{"_3461":125,"_30106":91,"_20907":49481,"_5":14363,"_27392":49385,"_2946":49482},[],"free external ports 80 and 443 on a single-node K3s host",{"_3461":126,"_30106":91,"_20907":49484,"_5":14363,"_27392":49385,"_2946":49485},[],"Fastlane detects MicroK8s, K3s, kind or a standard kubeconfig. Use `--context` when the intended cluster is not the current context.",{"_3461":127,"_30106":91,"_20907":49487,"_5":14363,"_27392":49385,"_2946":49488},[],"Fastlane installs several components and creates credentials. Check `kubectl config current-context` or pass `--context` before running it.",{"_3461":128,"_30106":91,"_20907":49490,"_5":14363,"_27392":49388,"_2946":49491},[],"Run the script from a clone of the Helm repository:",{"_3461":129,"_30106":91,"_20907":49493,"_5":14363,"_27392":49388,"_2946":49494},[],"Create a DNS record for the chosen domain before testing from another machine. For a small VM, point it at the VM or load-balancer address that actually receives ports 80 and 443.",{"_3461":130,"_30106":91,"_20907":49496,"_5":14363,"_27392":49392,"_2946":49497},[],"By default, Fastlane runs `hostname -I` and writes the returned addresses to `gateway.addresses` and to the self-signed certificate's IP SANs.",{"_3461":131,"_30106":91,"_20907":49499,"_5":14363,"_27392":49392,"_2946":49500},[],"On a single-homed lab VM this can select the expected node address. On hosts with Docker, VPN, WireGuard or several interfaces it can also select addresses clients cannot reach. Override the result explicitly:",{"_3461":132,"_30106":91,"_20907":49502,"_5":14363,"_27392":49392,"_2946":49503},[],"The value must be an address handled on the Kubernetes side of the traffic path. If a public EC2 address forwards through WireGuard to the cluster, pass the reachable cluster/VM address, not the EC2 public address.",{"_3461":133,"_30106":91,"_20907":49505,"_5":14363,"_27392":49392,"_2946":49506},[],"See Expose the Gateway for K3s port conflicts, VIPs, external NAT and multi-Gateway designs.",{"_3461":134,"_30106":91,"_20907":49508,"_5":14363,"_27392":49396,"_2946":49509},[],"Option",{"_3461":135,"_30106":91,"_20907":49511,"_5":14363,"_27392":49396,"_2946":49512},[],"Default",{"_3461":136,"_30106":91,"_20907":49514,"_5":14363,"_27392":49396,"_2946":49515},[],"Purpose",{"_3461":137,"_30106":91,"_20907":49517,"_5":14363,"_27392":49396,"_2946":49518},[],"`-h`, `--help`",{"_3461":138,"_30106":91,"_20907":49520,"_5":14363,"_27392":49396,"_2946":49521},[],"—",{"_3461":139,"_30106":91,"_20907":49523,"_5":14363,"_27392":49396,"_2946":49524},[],"Show help",{"_3461":140,"_30106":91,"_20907":49526,"_5":14363,"_27392":49396,"_2946":49527},[],"`-c`, `--context`",{"_3461":141,"_30106":91,"_20907":49529,"_5":14363,"_27392":49396,"_2946":49530},[],"current context",{"_3461":142,"_30106":91,"_20907":49532,"_5":14363,"_27392":49396,"_2946":49533},[],"Select the kubeconfig context for kubectl and Helm",{"_3461":143,"_30106":91,"_20907":49535,"_5":14363,"_27392":49396,"_2946":49536},[],"`-n`, `--non-interactive`",{"_3461":144,"_30106":91,"_20907":49538,"_5":14363,"_27392":49396,"_2946":6523},[],{"_3461":145,"_30106":91,"_20907":49540,"_5":14363,"_27392":49396,"_2946":49541},[],"Skip prompts and generate dependency credentials",{"_3461":146,"_30106":91,"_20907":49543,"_5":14363,"_27392":49396,"_2946":49544},[],"`-ns`, `--namespace`",{"_3461":147,"_30106":91,"_20907":49546,"_5":14363,"_27392":49396,"_2946":49547},[],"`lamassu-dev`",{"_3461":148,"_30106":91,"_20907":49549,"_5":14363,"_27392":49396,"_2946":49550},[],"Namespace for the installation",{"_3461":149,"_30106":91,"_20907":49552,"_5":14363,"_27392":49396,"_2946":49553},[],"`-d`, `--domain`",{"_3461":150,"_30106":91,"_20907":49555,"_5":14363,"_27392":49396,"_2946":49556},[],"`dev.lamassu.io`",{"_3461":151,"_30106":91,"_20907":49558,"_5":14363,"_27392":49396,"_2946":49559},[],"Domain used by the UI, OIDC and certificate",{"_3461":152,"_30106":91,"_20907":49561,"_5":14363,"_27392":49396,"_2946":49562},[],"`-v`, `--version`",{"_3461":153,"_30106":91,"_20907":49564,"_5":14363,"_27392":49396,"_2946":15061},[],{"_3461":154,"_30106":91,"_20907":49566,"_5":14363,"_27392":49396,"_2946":49567},[],"Lamassu chart version",{"_3461":155,"_30106":91,"_20907":49569,"_5":14363,"_27392":49396,"_2946":49570},[],"`--https-port`",{"_3461":156,"_30106":91,"_20907":49572,"_5":14363,"_27392":49396,"_2946":49573},[],"`443`",{"_3461":157,"_30106":91,"_20907":49575,"_5":14363,"_27392":49396,"_2946":49576},[],"Gateway HTTPS listener port",{"_3461":158,"_30106":91,"_20907":49578,"_5":14363,"_27392":49396,"_2946":49579},[],"`--http-port`",{"_3461":159,"_30106":91,"_20907":49581,"_5":14363,"_27392":49396,"_2946":49582},[],"`80`",{"_3461":160,"_30106":91,"_20907":49584,"_5":14363,"_27392":49396,"_2946":49585},[],"Gateway HTTP listener port",{"_3461":161,"_30106":91,"_20907":49587,"_5":14363,"_27392":49396,"_2946":49588},[],"`--tls-crt`",{"_3461":162,"_30106":91,"_20907":49590,"_5":14363,"_27392":49396,"_2946":49521},[],{"_3461":163,"_30106":91,"_20907":49592,"_5":14363,"_27392":49396,"_2946":49593},[],"PEM certificate for downstream TLS",{"_3461":164,"_30106":91,"_20907":49595,"_5":14363,"_27392":49396,"_2946":49596},[],"`--tls-key`",{"_3461":165,"_30106":91,"_20907":49598,"_5":14363,"_27392":49396,"_2946":49521},[],{"_3461":166,"_30106":91,"_20907":49600,"_5":14363,"_27392":49396,"_2946":49601},[],"PEM private key for downstream TLS",{"_3461":167,"_30106":91,"_20907":49603,"_5":14363,"_27392":49396,"_2946":49604},[],"`-l`, `--local-chart-path`",{"_3461":168,"_30106":91,"_20907":49606,"_5":14363,"_27392":49396,"_2946":49607},[],"repository chart",{"_3461":169,"_30106":91,"_20907":49609,"_5":14363,"_27392":49396,"_2946":49610},[],"Use an unpacked local Lamassu chart",{"_3461":170,"_30106":91,"_20907":49612,"_5":14363,"_27392":49396,"_2946":49613},[],"`-ip`, `--gateway-ip`",{"_3461":171,"_30106":91,"_20907":49615,"_5":14363,"_27392":49396,"_2946":8724},[],{"_3461":172,"_30106":91,"_20907":49617,"_5":14363,"_27392":49396,"_2946":49618},[],"Override the address written to `gateway.addresses`",{"_3461":173,"_30106":91,"_20907":49620,"_5":14363,"_27392":49396,"_2946":49621},[],"`--otel`",{"_3461":174,"_30106":91,"_20907":49623,"_5":14363,"_27392":49396,"_2946":6523},[],{"_3461":175,"_30106":91,"_20907":49625,"_5":14363,"_27392":49396,"_2946":49626},[],"Install Victoria Logs, VictoriaTraces, Jaeger and an OpenTelemetry Collector",{"_3461":176,"_30106":91,"_20907":49628,"_5":14363,"_27392":49396,"_2946":49629},[],"`--development`",{"_3461":177,"_30106":91,"_20907":49631,"_5":14363,"_27392":49396,"_2946":6523},[],{"_3461":178,"_30106":91,"_20907":49633,"_5":14363,"_27392":49396,"_2946":49634},[],"Development mode: fully provisions the Keycloak `lamassu` user (fixed `lamassu`/`lamassu` password, no first-login steps) and lets the `frontend` client accept any redirect URI or web origin. Not for production",{"_3461":179,"_30106":91,"_20907":49636,"_5":14363,"_27392":49396,"_2946":49637},[],"`--sample-data`",{"_3461":180,"_30106":91,"_20907":49639,"_5":14363,"_27392":49396,"_2946":6523},[],{"_3461":181,"_30106":91,"_20907":49641,"_5":14363,"_27392":49396,"_2946":49642},[],"Create sample CAs, profiles, certificates, DMS data and devices",{"_3461":182,"_30106":91,"_20907":49644,"_5":14363,"_27392":49396,"_2946":49645},[],"`--with-hsm`",{"_3461":183,"_30106":91,"_20907":49647,"_5":14363,"_27392":49396,"_2946":6523},[],{"_3461":184,"_30106":91,"_20907":49649,"_5":14363,"_27392":49396,"_2946":49650},[],"Install lab HSM components and configure KMS for PKCS#11",{"_3461":185,"_30106":91,"_20907":49652,"_5":14363,"_27392":49396,"_2946":49653},[],"`--softhsm-chart-path`",{"_3461":186,"_30106":91,"_20907":49655,"_5":14363,"_27392":49396,"_2946":49656},[],"`./charts/softhsm`",{"_3461":187,"_30106":91,"_20907":49658,"_5":14363,"_27392":49396,"_2946":49659},[],"Use a different local SoftHSM chart",{"_3461":188,"_30106":91,"_20907":49661,"_5":14363,"_27392":49396,"_2946":49662},[],"Fastlane does not provide an offline mode. Use the manual Helm workflow and a prepared registry/chart mirror for disconnected environments.",{"_3461":189,"_30106":91,"_20907":49664,"_5":14363,"_27392":49400,"_2946":49665},[],"`--development` adjusts the Keycloak `lamassu` realm generated by Fastlane for a disposable evaluation environment:",{"_3461":190,"_30106":91,"_20907":49667,"_5":14363,"_27392":49400,"_2946":49668},[],"the `lamassu` user is fully provisioned (first name Lamassu, last name Admin, email `lamassu@lamassu.io`, verified): there are no profile setup or password change steps on first login",{"_3461":191,"_30106":91,"_20907":49670,"_5":14363,"_27392":49400,"_2946":49671},[],"the well-known `lamassu`/`lamassu` password is fixed and permanent: it is never rotated and grants the `pki-admin` role, including non-interactive tokens through the `frontend` client",{"_3461":192,"_30106":91,"_20907":49673,"_5":14363,"_27392":49400,"_2946":49674},[],"the `frontend` client accepts any redirect URI and any web origin (`*`) instead of the original `/*` patterns",{"_3461":193,"_30106":91,"_20907":49676,"_5":14363,"_27392":49400,"_2946":49677},[],"With `--development`, the fixed `lamassu`/`lamassu` password grants `pki-admin` access to anyone who can reach the installation. Never use it on anything exposed beyond a development machine or a network-reachable host.",{"_3461":194,"_30106":91,"_20907":49679,"_5":14363,"_27392":49400,"_2946":49680},[],"`--development` applies when the `lamassu` realm is first imported. It does not modify an existing cluster. It can be combined with `--sample-data`: the development transform runs first, then sample data is added to the same realm configuration.",{"_3461":195,"_30106":91,"_20907":49682,"_5":14363,"_27392":49404,"_2946":49683},[],"Fastlane:",{"_3461":196,"_30106":91,"_20907":49685,"_5":14363,"_27392":49404,"_2946":49686},[],"validates local tools and the selected cluster",{"_3461":197,"_30106":91,"_20907":49688,"_5":14363,"_27392":49404,"_2946":49689},[],"installs or upgrades Envoy Gateway 1.8 and creates the `eg` `GatewayClass`",{"_3461":198,"_30106":91,"_20907":49691,"_5":14363,"_27392":49404,"_2946":49692},[],"creates the namespace",{"_3461":199,"_30106":91,"_20907":49694,"_5":14363,"_27392":49404,"_2946":49695},[],"installs PostgreSQL and creates the required databases",{"_3461":200,"_30106":91,"_20907":49697,"_5":14363,"_27392":49404,"_2946":49698},[],"installs Keycloak and creates the `lamassu` realm, frontend client, admin role and initial user",{"_3461":201,"_30106":91,"_20907":49700,"_5":14363,"_27392":49404,"_2946":49701},[],"installs RabbitMQ",{"_3461":202,"_30106":91,"_20907":49703,"_5":14363,"_27392":49404,"_2946":49704},[],"optionally installs observability and lab HSM components",{"_3461":203,"_30106":91,"_20907":49706,"_5":14363,"_27392":49404,"_2946":49707},[],"generates `lamassu.yaml` and installs the Lamassu chart",{"_3461":204,"_30106":91,"_20907":49709,"_5":14363,"_27392":49404,"_2946":49710},[],"optionally loads sample data",{"_3461":205,"_30106":91,"_20907":49712,"_5":14363,"_27392":49404,"_2946":49713},[],"The generated configuration exposes Keycloak at `/auth` through the same Gateway and bootstraps the initial `lamassu` user as a Lamassu super administrator.",{"_3461":206,"_30106":91,"_20907":49715,"_5":14363,"_27392":49408,"_2946":49716},[],"With both `--tls-crt` and `--tls-key`, Fastlane creates the `downstream-provided-crt` Secret and configures `tls.type: external`.",{"_3461":207,"_30106":91,"_20907":49718,"_5":14363,"_27392":49408,"_2946":49719},[],"Without them, it configures cert-manager with a self-signed issuer. This is suitable for a lab but will not be trusted by clients until you distribute the CA. Use Helm when you need a corporate Issuer, public ACME issuer or an existing Secret managed by another system.",{"_3461":208,"_30106":91,"_20907":49721,"_5":14363,"_27392":49412,"_2946":49722},[],"Non-interactive mode generates random PostgreSQL, RabbitMQ and Keycloak administrator passwords. The initial Lamassu login is `lamassu` / `lamassu` and requires a password change on first use, unless `--development` was used: in that case the password stays fixed and permanent.",{"_3461":209,"_30106":91,"_20907":49724,"_5":14363,"_27392":49412,"_2946":49725},[],"Fastlane writes `lamassu.yaml` in the current directory and injects credentials into it.",{"_3461":210,"_30106":91,"_20907":49727,"_5":14363,"_27392":49412,"_2946":49728},[],"Protect the generated values file, record the generated credentials in an appropriate secret store and do not reuse the evaluation identity setup in production.",{"_3461":211,"_30106":91,"_20907":49730,"_5":14363,"_27392":49416,"_2946":49731},[],"Then open `https://pki.example.com` and sign in with the initial user. If the Gateway is programmed but the URL is unreachable, follow the checks in Expose the Gateway.",{"_3461":212,"_30106":212,"_5":14715,"_2946":49733,"_30438":49734,"_20907":49735,"_27392":212},"Install with Helm",[49125,49126,49232],[],{"_3461":213,"_30106":212,"_20907":49737,"_5":14363,"_27392":212,"_2946":49738},[],"Prepare dependencies, configure the Lamassu chart and verify a controlled Kubernetes deployment.",{"_3461":214,"_30106":212,"_5":30435,"_20907":49740,"_27392":49741,"_2946":49742},[],"/docs/deployment/self-hosted/helm#install-lamassu-with-helm","Install Lamassu with Helm",{"_3461":215,"_30106":212,"_5":30435,"_20907":49744,"_27392":49745,"_2946":49135},[],"/docs/deployment/self-hosted/helm#before-you-begin",{"_3461":216,"_30106":212,"_5":30435,"_20907":49747,"_27392":49748,"_2946":49749},[],"/docs/deployment/self-hosted/helm#1-install-the-gateway-prerequisites","1\\. Install the Gateway prerequisites",{"_3461":217,"_30106":212,"_5":30435,"_20907":49751,"_27392":49752,"_2946":49753},[],"/docs/deployment/self-hosted/helm#2-create-a-values-file","2\\. Create a values file",{"_3461":218,"_30106":212,"_5":30435,"_20907":49755,"_27392":49756,"_2946":49757},[],"/docs/deployment/self-hosted/helm#tls-with-an-existing-secret","TLS with an existing Secret",{"_3461":219,"_30106":212,"_5":30435,"_20907":49759,"_27392":49760,"_2946":49761},[],"/docs/deployment/self-hosted/helm#amqp-tls-amqps","AMQP TLS (AMQPS)",{"_3461":220,"_30106":212,"_5":30435,"_20907":49763,"_27392":49764,"_2946":49765},[],"/docs/deployment/self-hosted/helm#provision-the-first-administrator","Provision the first administrator",{"_3461":221,"_30106":212,"_5":30435,"_20907":49767,"_27392":49768,"_2946":49769},[],"/docs/deployment/self-hosted/helm#3-install-lamassu","3\\. Install Lamassu",{"_3461":222,"_30106":212,"_5":30435,"_20907":49771,"_27392":49772,"_2946":49773},[],"/docs/deployment/self-hosted/helm#4-verify-the-deployment","4\\. Verify the deployment",{"_3461":223,"_30106":212,"_5":30435,"_20907":49775,"_27392":49776,"_2946":49777},[],"/docs/deployment/self-hosted/helm#upgrading-lamassu","Upgrading Lamassu",{"_3461":224,"_30106":212,"_5":30435,"_20907":49779,"_27392":49780,"_2946":49781},[],"/docs/deployment/self-hosted/helm#production-decisions","Production decisions",{"_3461":225,"_30106":212,"_20907":49783,"_5":14363,"_27392":49741,"_2946":49784},[],"Use the Helm workflow when you need explicit control over identity, databases, messaging, certificates, storage and upgrades. For an evaluation environment where the script can make those choices for you, use Fastlane.",{"_3461":226,"_30106":212,"_20907":49786,"_5":14363,"_27392":49745,"_2946":49787},[],"Prepare the platform services that are deliberately outside the Lamassu chart:",{"_3461":227,"_30106":212,"_20907":49789,"_5":14363,"_27392":49745,"_2946":49790},[],"a Kubernetes 1.24+ cluster and Helm 3.2+",{"_3461":228,"_30106":212,"_20907":49792,"_5":14363,"_27392":49745,"_2946":49793},[],"a reachable PostgreSQL server and a role allowed to create databases and schemas",{"_3461":229,"_30106":212,"_20907":49795,"_5":14363,"_27392":49745,"_2946":49796},[],"a reachable RabbitMQ broker and credentials",{"_3461":230,"_30106":212,"_20907":49798,"_5":14363,"_27392":49745,"_2946":49799},[],"an OIDC provider, normally Keycloak, with a realm/tenant and client for Lamassu",{"_3461":231,"_30106":212,"_20907":49801,"_5":14363,"_27392":49745,"_2946":49802},[],"Envoy Gateway 1.8+ and a `GatewayClass`",{"_3461":232,"_30106":212,"_20907":49804,"_5":14363,"_27392":49745,"_2946":49805},[],"cert-manager 1.14+ (only for the default `tls.type: certManager` mode); for trusted TLS, either a trusted issuer or a Kubernetes TLS Secret",{"_3461":233,"_30106":212,"_20907":49807,"_5":14363,"_27392":49745,"_2946":49808},[],"a StorageClass and an external traffic design",{"_3461":234,"_30106":212,"_20907":49810,"_5":14363,"_27392":49745,"_2946":49811},[],"The chart defaults to a `GatewayClass` named `eg`. Change `gateway.className` if your platform team uses another name.",{"_3461":235,"_30106":212,"_20907":49813,"_5":14363,"_27392":49745,"_2946":49814},[],"You provide the PostgreSQL server. The chart's pre-install job connects with the supplied credentials, creates the required `pki`, `authz` and `wfx` databases and service schemas, runs migrations, and applies `services.authz.bootstrap`.",{"_3461":236,"_30106":212,"_20907":49816,"_5":14363,"_27392":49745,"_2946":49817},[],"The chart has no Helm dependencies that install PostgreSQL, RabbitMQ, an OIDC provider, Envoy Gateway or cert-manager.",{"_3461":237,"_30106":212,"_20907":49819,"_5":14363,"_27392":49748,"_2946":49820},[],"Install or upgrade the Envoy Gateway CRDs before its controller. The commands below match the version used by the Lamassu Helm repository:",{"_3461":238,"_30106":212,"_20907":49822,"_5":14363,"_27392":49748,"_2946":49823},[],"Create the default `GatewayClass` if it does not already exist. Save this manifest as `gateway-class.yaml`:",{"_3461":239,"_30106":212,"_20907":49825,"_5":14363,"_27392":49748,"_2946":49826},[],"Install cert-manager separately before Lamassu, but only for the default `tls.type: certManager` mode. In that mode the chart renders its self-signed Issuer and CA Certificate resources regardless of whether `tls.certManagerOptions.clusterIssuer` is set, so cert-manager stays a prerequisite. With `tls.type: external`, the chart renders no cert-manager resources and the Gateway terminates TLS with an existing Secret you provide instead.",{"_3461":240,"_30106":212,"_20907":49828,"_5":14363,"_27392":49752,"_2946":49829},[],"Start with the chart defaults and override the environment-specific values. This example assumes PostgreSQL, RabbitMQ and Keycloak are reachable through Kubernetes DNS, and exposes Keycloak at `/auth` through the shared Lamassu Gateway:",{"_3461":241,"_30106":212,"_20907":49831,"_5":14363,"_27392":49752,"_2946":49832},[],"Do not add `gateway.addresses` by default. Leave address assignment to the load-balancer implementation unless your network design requires a specific Kubernetes-side VIP. The public IP of an upstream NAT gateway or reverse proxy does not belong in this value.",{"_3461":242,"_30106":212,"_20907":49834,"_5":14363,"_27392":49752,"_2946":49835},[],"If Keycloak is external and already has its own reachable URL, point the OIDC settings at it and omit the `/auth` entry from `gateway.extraRouting`.",{"_3461":243,"_30106":212,"_20907":49837,"_5":14363,"_27392":49752,"_2946":49838},[],"If your values file still carries the legacy gateway JWT validation settings — `auth.oidc.apiGateway.jwks`, `auth.authorization.rolesClaim` or `auth.authorization.roles.admin` — remove them. The migration guide `charts/lamassu/CHANGELOG/3.8.0->4.0.0.md` documents their removal with no compatibility aliases, and `values.schema.json` rejects the leftover blocks instead of silently ignoring them. The replacements are `services.authz.jwkUrl` and `services.authz.bootstrap`, already shown in the example above.",{"_3461":244,"_30106":212,"_20907":49840,"_5":14363,"_27392":49756,"_2946":49841},[],"Create a Secret containing `tls.crt` and `tls.key`, then reference it. The Secret must already exist before installing: in `external` mode the chart renders no cert-manager resources and never creates this Secret.",{"_3461":245,"_30106":212,"_20907":49843,"_5":14363,"_27392":49760,"_2946":49844},[],"`amqp.tls: true` selects AMQPS in every event-bus configuration block. The default port stays `5672` and does not change automatically when TLS is enabled, so set `amqp.port` to the broker's TLS listener, commonly `5671`.",{"_3461":246,"_30106":212,"_20907":49846,"_5":14363,"_27392":49760,"_2946":49847},[],"With no CA Secret configured, the event-bus clients use the system-trusted CAs. To trust a private CA, create a Secret in the release namespace containing the CA certificate in PEM format and set `amqp.ca.secretName` (and `amqp.ca.certificateKey` if the data key is not `ca.crt`).",{"_3461":247,"_30106":212,"_20907":49849,"_5":14363,"_27392":49760,"_2946":49850},[],"For brokers that require mutual TLS, create a Secret containing the client certificate and private key and set `amqp.client.secretName` (with `amqp.client.certificateKey` and `amqp.client.privateKeyKey` if the data keys are not `tls.crt` and `tls.key`).",{"_3461":248,"_30106":212,"_20907":49852,"_5":14363,"_27392":49760,"_2946":49853},[],"The chart mounts configured Secrets read-only into every AMQP-consuming workload: the CA certificate under `/etc/lamassu/amqp/ca` and the client certificate and key under `/etc/lamassu/amqp/client`. The mounted file names are always `ca.crt`, `tls.crt` and `tls.key` — the `certificateKey` and `privateKeyKey` values rename only the Secret data keys, never the on-disk paths. The client private key is mounted with restrictive permissions (`defaultMode: 0440`; the CA volume uses `0444`), which works because the chart adds `fsGroup` to the pod security context when `amqp.client.secretName` is set — it uses the container `runAsGroup` (default `65532`) when `fsGroup` is not already set.",{"_3461":249,"_30106":212,"_20907":49855,"_5":14363,"_27392":49760,"_2946":49856},[],"Both Secret options require `amqp.tls: true`: `values.schema.json` rejects a non-empty `secretName` when `tls` is false, rejects unknown keys and rejects data-key names outside `^[A-Za-z0-9._-]+$`. The referenced Secret must exist in the release namespace or the consuming pods fail to start.",{"_3461":250,"_30106":212,"_20907":49858,"_5":14363,"_27392":49760,"_2946":49859},[],"The AMQP client loads certificates at startup, so restart the consuming pods after updating either Secret. Changing any `amqp` value rolls the consuming pods through the `checksum/config` annotation, but a change to Secret content alone does not trigger a rollout.",{"_3461":251,"_30106":212,"_20907":49861,"_5":14363,"_27392":49760,"_2946":49862},[],"Per the migration guide `charts/lamassu/CHANGELOG/3.8.0->4.0.0.md`: in 3.8.0 `amqp.tls` was not applied and event-bus clients used plaintext AMQP; from 4.0.0, `amqp.tls: true` switches them to AMQPS. Set `amqp.port` to the broker TLS listener before upgrading, or set `amqp.tls: false` to keep plaintext AMQP. `amqp.tls: false` sends the broker credentials and all event-bus traffic in cleartext.",{"_3461":252,"_30106":212,"_20907":49864,"_5":14363,"_27392":49764,"_2946":49865},[],"There is no implicit superuser. Create the role or group expected by `services.authz.bootstrap` in the OIDC provider and assign it to at least one administrator before exposing Lamassu.",{"_3461":253,"_30106":212,"_20907":49867,"_5":14363,"_27392":49764,"_2946":49868},[],"The pre-install and pre-upgrade job applies the bootstrap idempotently: existing principals are preserved and missing grants are added.",{"_3461":254,"_30106":212,"_20907":49870,"_5":14363,"_27392":49764,"_2946":49871},[],"Test both an authorized identity and a denied identity. If no token matches an active bootstrap principal, nobody can administer the PKI.",{"_3461":255,"_30106":212,"_20907":49873,"_5":14363,"_27392":49764,"_2946":49874},[],"See Access control for the principal and policy model.",{"_3461":256,"_30106":212,"_20907":49876,"_5":14363,"_27392":49768,"_2946":49877},[],"To install a local checkout instead:",{"_3461":257,"_30106":212,"_20907":49879,"_5":14363,"_27392":49772,"_2946":49880},[],"The Gateway should report `PROGRAMMED=True`. If it is programmed but has no usable address, continue with Expose the Gateway.",{"_3461":258,"_30106":212,"_20907":49882,"_5":14363,"_27392":49772,"_2946":49883},[],"The Helm test checks the CA, DMS Manager, Device Manager and VA health endpoints and verifies the UI response.",{"_3461":259,"_30106":212,"_20907":49885,"_5":14363,"_27392":49776,"_2946":49886},[],"Version-specific upgrade steps live in `charts/lamassu/CHANGELOG/` in the Helm repository. The chart also ships an optional pre-upgrade Job that migrates existing CA private keys into the KMS engine configured for the release. It is off by default (`migrations.caToKms.enabled: false`) and is only needed when upgrading from a version prior to 3.7.0.",{"_3461":260,"_30106":212,"_20907":49888,"_5":14363,"_27392":49776,"_2946":49889},[],"While the flag is enabled, every `helm upgrade` creates the `<chart fullname>-ca-to-kms-migration` Job (`lamassu-ca-to-kms-migration` for release `lamassu`); a fresh install does not create it. Its hook weight is `-10`, so it runs before the other pre-upgrade hooks: the authorization bootstrap configuration (weight `-4`) and the database-migration Job (weight `-3`).",{"_3461":261,"_30106":212,"_20907":49891,"_5":14363,"_27392":49776,"_2946":49892},[],"The Job consumes the same KMS service configuration the chart renders into the KMS ConfigMap, including the engines from `services.kms.cryptoEngines`, and runs the migration tool defined in `migrations.caToKms.image`. It mounts that configuration read-only at `/etc/lamassuiot/config.yml` from the ConfigMap key `config`, so configure the destination engine in your values before the upgrade that performs the migration.",{"_3461":262,"_30106":212,"_20907":49894,"_5":14363,"_27392":49776,"_2946":49895},[],"The Job resolves its configuration through a projected volume with two optional sources: the release-scoped `<chart fullname>-kms-config` (`lamassu-kms-config` for release `lamassu`, `prod-lamassu-kms-config` for release `prod`) and the legacy unscoped `kms-config` created by chart versions before release-scoped naming. The legacy configuration remains authoritative while it is still present, and the release-scoped one is used once the legacy one is gone. Both sources are optional, so a missing ConfigMap never leaves the upgrade pod in `ContainerCreating`.",{"_3461":263,"_30106":212,"_20907":49897,"_5":14363,"_27392":49776,"_2946":49898},[],"Keep `migrations.caToKms.enabled: true` for the upgrade that performs the migration, then remove the flag from your values once the migration completes; it defaults to `false`.",{"_3461":264,"_30106":212,"_20907":49900,"_5":14363,"_27392":49780,"_2946":49901},[],"Before going live, review:",{"_3461":265,"_30106":212,"_20907":49903,"_5":14363,"_27392":49780,"_2946":49904},[],"backup and recovery for PostgreSQL and persistent volumes",{"_3461":266,"_30106":212,"_20907":49906,"_5":14363,"_27392":49780,"_2946":49907},[],"a production KMS engine; the default filesystem engine is not an HA design",{"_3461":267,"_30106":212,"_20907":49909,"_5":14363,"_27392":49780,"_2946":49910},[],"shared VA storage before increasing VA replicas",{"_3461":268,"_30106":212,"_20907":49912,"_5":14363,"_27392":49780,"_2946":49913},[],"managed OIDC roles and removal of evaluation credentials",{"_3461":269,"_30106":212,"_20907":49915,"_5":14363,"_27392":49780,"_2946":49916},[],"a trusted TLS issuer or externally managed certificate",{"_3461":270,"_30106":212,"_20907":49918,"_5":14363,"_27392":49780,"_2946":49919},[],"resource requests, replicas, autoscaling, disruption budgets and placement",{"_3461":271,"_30106":212,"_20907":49921,"_5":14363,"_27392":49780,"_2946":49922},[],"SMTP, observability and alert delivery",{"_3461":272,"_30106":212,"_20907":49924,"_5":14363,"_27392":49780,"_2946":49925},[],"the version upgrade guides and migration notes in `charts/lamassu/CHANGELOG/` before every upgrade, including the optional CA-to-KMS migration hook described above",{"_3461":273,"_30106":212,"_20907":49927,"_5":14363,"_27392":49780,"_2946":49928},[],"The complete values reference is maintained in `charts/lamassu/VALUES.md` in the Helm repository.",{"_3461":274,"_30106":274,"_5":14715,"_2946":49930,"_30438":49931,"_20907":49932,"_27392":274},"Expose the Gateway",[49125,49126,49232],[],{"_3461":275,"_30106":274,"_20907":49934,"_5":14363,"_27392":274,"_2946":49935},[],"Choose how clients reach Lamassu, when to set gateway.addresses and how to design multiple Gateways.",{"_3461":276,"_30106":274,"_5":30435,"_20907":49937,"_27392":49938,"_2946":49939},[],"/docs/deployment/self-hosted/networking#expose-the-lamassu-gateway","Expose the Lamassu Gateway",{"_3461":277,"_30106":274,"_5":30435,"_20907":49941,"_27392":49942,"_2946":49943},[],"/docs/deployment/self-hosted/networking#do-you-need-gatewayaddresses","Do you need `gateway.addresses`?",{"_3461":278,"_30106":274,"_5":30435,"_20907":49945,"_27392":49946,"_2946":49947},[],"/docs/deployment/self-hosted/networking#recommended-single-node-design","Recommended single-node design",{"_3461":279,"_30106":274,"_5":30435,"_20907":49949,"_27392":49950,"_2946":49951},[],"/docs/deployment/self-hosted/networking#k3s","K3s",{"_3461":280,"_30106":274,"_5":30435,"_20907":49953,"_27392":49954,"_2946":49955},[],"/docs/deployment/self-hosted/networking#bare-metal-with-metallb-or-kube-vip","Bare metal with MetalLB or kube-vip",{"_3461":281,"_30106":274,"_5":30435,"_20907":49957,"_27392":49958,"_2946":49959},[],"/docs/deployment/self-hosted/networking#external-reverse-proxy-nat-or-vpn","External reverse proxy, NAT or VPN",{"_3461":282,"_30106":274,"_5":30435,"_20907":49961,"_27392":49962,"_2946":49963},[],"/docs/deployment/self-hosted/networking#what-if-you-need-three-gateways","What if you need three Gateways?",{"_3461":283,"_30106":274,"_5":30435,"_20907":49965,"_27392":49966,"_2946":49967},[],"/docs/deployment/self-hosted/networking#decision-guide","Decision guide",{"_3461":284,"_30106":274,"_5":30435,"_20907":49969,"_27392":49970,"_2946":49971},[],"/docs/deployment/self-hosted/networking#egress-proxy","Egress proxy",{"_3461":285,"_30106":274,"_5":30435,"_20907":49973,"_27392":49974,"_2946":49975},[],"/docs/deployment/self-hosted/networking#verify-the-traffic-path","Verify the traffic path",{"_3461":286,"_30106":274,"_20907":49977,"_5":14363,"_27392":49938,"_2946":49978},[],"The Lamassu chart creates one shared Gateway with HTTP and HTTPS listeners. Envoy Gateway normally creates a dedicated proxy deployment and a `LoadBalancer` Service for it.",{"_3461":287,"_30106":274,"_20907":49980,"_5":14363,"_27392":49938,"_2946":49981},[],"External reachability is the result of the whole path. A `Gateway` resource alone does not configure your router, firewall, DNS, cloud load balancer or upstream NAT.",{"_3461":288,"_30106":274,"_20907":49983,"_5":14363,"_27392":49942,"_2946":49984},[],"Usually, no. If you omit it, the Gateway controller and the cluster load-balancer implementation can assign an address and report it in `Gateway.status.addresses` and the generated Service status.",{"_3461":289,"_30106":274,"_20907":49986,"_5":14363,"_27392":49942,"_2946":49987},[],"Set it only when:",{"_3461":290,"_30106":274,"_20907":49989,"_5":14363,"_27392":49942,"_2946":49990},[],"your cloud or bare-metal load balancer supports requesting a specific address",{"_3461":291,"_30106":274,"_20907":49992,"_5":14363,"_27392":49942,"_2946":49993},[],"that address is allocated to this Gateway",{"_3461":292,"_30106":274,"_20907":49995,"_5":14363,"_27392":49942,"_2946":49996},[],"the surrounding network already routes traffic for it to the cluster",{"_3461":293,"_30106":274,"_20907":49998,"_5":14363,"_27392":49942,"_2946":49999},[],"This requests `192.168.1.50`; it does not claim the IP on your LAN or make it reachable.",{"_3461":294,"_30106":274,"_20907":50001,"_5":14363,"_27392":49942,"_2946":50002},[],"Keep these two settings separate:",{"_3461":295,"_30106":274,"_20907":50004,"_5":14363,"_27392":49942,"_2946":50005},[],"`gateway.addresses` requests an address for the Gateway.",{"_3461":296,"_30106":274,"_20907":50007,"_5":14363,"_27392":49942,"_2946":50008},[],"`tls.certManagerOptions.certSpec.addresses` adds IP subject alternative names to the TLS certificate.",{"_3461":297,"_30106":274,"_20907":50010,"_5":14363,"_27392":49942,"_2946":50011},[],"If users connect by DNS name, put that name in `tls.certManagerOptions.certSpec.hostnames`. Do not copy an upstream proxy's public IP into `gateway.addresses`.",{"_3461":298,"_30106":274,"_20907":50013,"_5":14363,"_27392":49946,"_2946":50014},[],"For a small VM running K3s or MicroK8s, use one external Lamassu Gateway and route every Lamassu endpoint through it:",{"_3461":299,"_30106":274,"_20907":50016,"_5":14363,"_27392":49946,"_2946":50017},[],"This design uses one IP, one TLS entry point and one pair of ports. The chart already creates the required routes.",{"_3461":300,"_30106":274,"_20907":50019,"_5":14363,"_27392":49950,"_2946":50020},[],"K3s ServiceLB implements each `LoadBalancer` Service with pods that reserve the Service ports on the node. On a single node, only one Service can therefore own port 80 and one can own port 443. The default K3s Traefik Service may already hold both ports.",{"_3461":301,"_30106":274,"_20907":50022,"_5":14363,"_27392":49950,"_2946":50023},[],"For the recommended design:",{"_3461":302,"_30106":274,"_20907":50025,"_5":14363,"_27392":49950,"_2946":50026},[],"Use only one externally exposed Lamassu Gateway.",{"_3461":303,"_30106":274,"_20907":50028,"_5":14363,"_27392":49950,"_2946":50029},[],"Ensure ports 80 and 443 are free. Disable or reconfigure Traefik if it is not part of your traffic path.",{"_3461":304,"_30106":274,"_20907":50031,"_5":14363,"_27392":49950,"_2946":50032},[],"Allow those ports through the VM firewall and any upstream security group.",{"_3461":305,"_30106":274,"_20907":50034,"_5":14363,"_27392":49950,"_2946":50035},[],"Point DNS at the VM's reachable address.",{"_3461":306,"_30106":274,"_20907":50037,"_5":14363,"_27392":49950,"_2946":50038},[],"See the K3s ServiceLB documentation for its host-port behavior and how to replace it with another load-balancer implementation.",{"_3461":307,"_30106":274,"_20907":50040,"_5":14363,"_27392":49954,"_2946":50041},[],"Allocate a VIP from an address pool reachable on your LAN. You may request that VIP with `gateway.addresses` if the selected implementation supports it. Confirm the assigned address in status rather than assuming the request succeeded.",{"_3461":308,"_30106":274,"_20907":50043,"_5":14363,"_27392":49958,"_2946":50044},[],"An external public address can forward TCP 80 and 443 to the VM or to a Kubernetes-side VIP:",{"_3461":309,"_30106":274,"_20907":50046,"_5":14363,"_27392":49958,"_2946":50047},[],"The public IP belongs to the external device. Leave `gateway.addresses` unset or set it to the actual Kubernetes-side address, never to an address that the cluster cannot bind.",{"_3461":310,"_30106":274,"_20907":50049,"_5":14363,"_27392":49962,"_2946":50050},[],"First decide whether you need three independent data planes or only three hostnames.",{"_3461":311,"_30106":274,"_20907":50052,"_5":14363,"_27392":49962,"_2946":50053},[],"Requirement",{"_3461":312,"_30106":274,"_20907":50055,"_5":14363,"_27392":49962,"_2946":50056},[],"Recommended design",{"_3461":313,"_30106":274,"_20907":50058,"_5":14363,"_27392":49962,"_2946":50059},[],"Consequence",{"_3461":314,"_30106":274,"_20907":50061,"_5":14363,"_27392":49962,"_2946":50062},[],"Several Lamassu URLs or services",{"_3461":315,"_30106":274,"_20907":50064,"_5":14363,"_27392":49962,"_2946":50065},[],"One Gateway with multiple routes",{"_3461":316,"_30106":274,"_20907":50067,"_5":14363,"_27392":49962,"_2946":50068},[],"One IP and one proxy fleet; this is the chart default",{"_3461":317,"_30106":274,"_20907":50070,"_5":14363,"_27392":49962,"_2946":50071},[],"Independent Gateways and separate external IPs",{"_3461":318,"_30106":274,"_20907":50073,"_5":14363,"_27392":49962,"_2946":50074},[],"One VIP per Gateway",{"_3461":319,"_30106":274,"_20907":50076,"_5":14363,"_27392":49962,"_2946":50077},[],"All Gateways can use 80/443; requires a load balancer with an address pool",{"_3461":320,"_30106":274,"_20907":50079,"_5":14363,"_27392":49962,"_2946":50080},[],"Independent Gateways on one node and one IP",{"_3461":321,"_30106":274,"_20907":50082,"_5":14363,"_27392":49962,"_2946":50083},[],"Use different external ports",{"_3461":322,"_30106":274,"_20907":50085,"_5":14363,"_27392":49962,"_2946":50086},[],"Clients must include non-standard ports",{"_3461":323,"_30106":274,"_20907":50088,"_5":14363,"_27392":49962,"_2946":50089},[],"Separate TLS/mTLS termination behind one IP",{"_3461":324,"_30106":274,"_20907":50091,"_5":14363,"_27392":49962,"_2946":50092},[],"Front-door SNI routing to internal Gateways",{"_3461":325,"_30106":274,"_20907":50094,"_5":14363,"_27392":49962,"_2946":50095},[],"Advanced design; the front door uses TLS passthrough and each internal Gateway terminates its own TLS",{"_3461":326,"_30106":274,"_20907":50097,"_5":14363,"_27392":49962,"_2946":50098},[],"Separate Gateway resources but shared proxy infrastructure",{"_3461":327,"_30106":274,"_20907":50100,"_5":14363,"_27392":49962,"_2946":50101},[],"Envoy merged-Gateway mode",{"_3461":328,"_30106":274,"_20907":50103,"_5":14363,"_27392":49962,"_2946":50104},[],"Logical separation only; listeners must have unique port, protocol and hostname tuples",{"_3461":329,"_30106":274,"_20907":50106,"_5":14363,"_27392":49962,"_2946":50107},[],"Three independent `LoadBalancer` Services cannot all reserve the same node ports 80 and 443 through K3s ServiceLB. Use one shared Gateway, allocate distinct VIPs with another load-balancer implementation, or use different ports.",{"_3461":330,"_30106":274,"_20907":50109,"_5":14363,"_27392":49962,"_2946":50110},[],"Envoy Gateway normally provisions a proxy fleet per `Gateway`. Its merged-Gateway mode can share one fleet and address, but it is not a drop-in switch for multiple Lamassu releases: the generated Lamassu listeners use the same ports and protocols without distinct hostnames, so they conflict unless you deliberately customize the listener design.",{"_3461":331,"_30106":274,"_20907":50112,"_5":14363,"_27392":49962,"_2946":50113},[],"Use a front-door SNI design only when the internal Gateways must retain independent TLS or mTLS policy:",{"_3461":332,"_30106":274,"_20907":50115,"_5":14363,"_27392":49962,"_2946":50116},[],"This requires distinct SNI hostnames and cluster networking outside the Lamassu chart.",{"_3461":333,"_30106":274,"_20907":50118,"_5":14363,"_27392":49966,"_2946":50119},[],"If one Gateway can own TLS and routing, use the chart default.",{"_3461":334,"_30106":274,"_20907":50121,"_5":14363,"_27392":49966,"_2946":50122},[],"If Gateways need independent policy and you can allocate IPs, use one VIP per Gateway.",{"_3461":335,"_30106":274,"_20907":50124,"_5":14363,"_27392":49966,"_2946":50125},[],"If only the Kubernetes resources need separation, evaluate merged-Gateway mode and make every listener tuple unique.",{"_3461":336,"_30106":274,"_20907":50127,"_5":14363,"_27392":49966,"_2946":50128},[],"If data planes and TLS termination must stay independent behind one IP, add a front-door SNI passthrough layer.",{"_3461":337,"_30106":274,"_20907":50130,"_5":14363,"_27392":49966,"_2946":50131},[],"If none of those are possible, use different external ports or change the external network design.",{"_3461":338,"_30106":274,"_20907":50133,"_5":14363,"_27392":49970,"_2946":50134},[],"Internal Lamassu clients — the Vault engine connection, service-to-service calls and webhook deliveries — honor the `HTTP_PROXY`, `HTTPS_PROXY` and `NO_PROXY` environment variables. The exception is the authorization-engine connector: it uses its own transport and does not consult these proxy variables. If your deployment routes egress through a proxy, list in-cluster service names in `NO_PROXY` (for example `.svc,.cluster.local`) so internal traffic stays inside the cluster. Loopback traffic is never sent through a proxy.",{"_3461":339,"_30106":274,"_20907":50136,"_5":14363,"_27392":49970,"_2946":50137},[],"The default transport of these clients bounds the dial timeout (30 seconds), the TLS handshake (10 seconds) and idle connection reuse (90 seconds) so an unreachable dependency fails fast instead of hanging; these values are Go transport defaults, not Lamassu settings. HTTP/2 is negotiated when the peer supports it. The authorization-engine connector keeps its own transport without these dial and handshake timeouts; only its overall 30-second request timeout bounds each call.",{"_3461":340,"_30106":274,"_20907":50139,"_5":14363,"_27392":49974,"_2946":50140},[],"Check, in order:",{"_3461":341,"_30106":274,"_20907":50142,"_5":14363,"_27392":49974,"_2946":50143},[],"`Gateway` has `Accepted=True` and `Programmed=True`.",{"_3461":342,"_30106":274,"_20907":50145,"_5":14363,"_27392":49974,"_2946":50146},[],"Its status contains the expected address.",{"_3461":343,"_30106":274,"_20907":50148,"_5":14363,"_27392":49974,"_2946":50149},[],"The generated `LoadBalancer` Service has a usable external address.",{"_3461":344,"_30106":274,"_20907":50151,"_5":14363,"_27392":49974,"_2946":50152},[],"Port 443 reaches that address from the client network.",{"_3461":345,"_30106":274,"_20907":50154,"_5":14363,"_27392":49974,"_2946":50155},[],"DNS resolves to the externally reachable endpoint.",{"_3461":346,"_30106":274,"_20907":50157,"_5":14363,"_27392":49974,"_2946":50158},[],"The certificate contains the DNS name or IP used by the client.",{"_3461":347,"_30106":274,"_20907":50160,"_5":14363,"_27392":49974,"_2946":50161},[],"The Gateway API treats addresses as desired state that a controller may assign or reject; see the Gateway API overview for the resource model.",{"_3461":348,"_30106":348,"_5":14715,"_2946":49232,"_30438":50163,"_20907":50164,"_27392":348},[49125,49126,49232],[],{"_3461":349,"_30106":348,"_20907":50166,"_5":14363,"_27392":348,"_2946":50167},[],"Choose an installation workflow and network architecture for Lamassu on your Kubernetes cluster.",{"_3461":350,"_30106":348,"_5":30435,"_20907":50169,"_27392":50170,"_2946":50171},[],"/docs/deployment/self-hosted/overview#self-managed-kubernetes-deployment","Self-managed Kubernetes deployment",{"_3461":351,"_30106":348,"_5":30435,"_20907":50173,"_27392":50174,"_2946":50175},[],"/docs/deployment/self-hosted/overview#choose-an-installation-workflow","Choose an installation workflow",{"_3461":352,"_30106":348,"_5":30435,"_20907":50177,"_27392":50178,"_2946":50179},[],"/docs/deployment/self-hosted/overview#what-the-lamassu-chart-provides","What the Lamassu chart provides",{"_3461":353,"_30106":348,"_5":30435,"_20907":50181,"_27392":50182,"_2946":50183},[],"/docs/deployment/self-hosted/overview#how-the-deployment-fits-together","How the deployment fits together",{"_3461":354,"_30106":348,"_5":30435,"_20907":50185,"_27392":50186,"_2946":50187},[],"/docs/deployment/self-hosted/overview#platform-requirements","Platform requirements",{"_3461":355,"_30106":348,"_5":30435,"_20907":50189,"_27392":50190,"_2946":50191},[],"/docs/deployment/self-hosted/overview#choose-the-next-page","Choose the next page",{"_3461":356,"_30106":348,"_20907":50193,"_5":14363,"_27392":50170,"_2946":50194},[],"Run Lamassu in a Kubernetes cluster operated by your team. The Helm chart deploys the Lamassu services and their routing resources; you provide the cluster, persistent storage, identity provider, PostgreSQL, RabbitMQ and the network path used by clients.",{"_3461":357,"_30106":348,"_20907":50196,"_5":14363,"_27392":50174,"_2946":50197},[],"Workflow",{"_3461":358,"_30106":348,"_20907":50199,"_5":14363,"_27392":50174,"_2946":50200},[],"Use it for",{"_3461":359,"_30106":348,"_20907":50202,"_5":14363,"_27392":50174,"_2946":50203},[],"What it installs",{"_3461":360,"_30106":348,"_20907":50205,"_5":14363,"_27392":50174,"_2946":50206},[],"Helm",{"_3461":361,"_30106":348,"_20907":50208,"_5":14363,"_27392":50174,"_2946":50209},[],"Production and controlled environments",{"_3461":362,"_30106":348,"_20907":50211,"_5":14363,"_27392":50174,"_2946":50212},[],"Lamassu services and Gateway API resources",{"_3461":363,"_30106":348,"_20907":50214,"_5":14363,"_27392":50174,"_2946":49369},[],{"_3461":364,"_30106":348,"_20907":50216,"_5":14363,"_27392":50174,"_2946":50217},[],"Evaluation, demos, CI and small lab clusters",{"_3461":365,"_30106":348,"_20907":50219,"_5":14363,"_27392":50174,"_2946":50220},[],"PostgreSQL, Keycloak, RabbitMQ, Envoy Gateway and Lamassu",{"_3461":366,"_30106":348,"_20907":50222,"_5":14363,"_27392":50178,"_2946":50223},[],"The Lamassu chart is an **application chart**, not a cluster bootstrap chart. It creates the Kubernetes resources that run and configure Lamassu, but it expects the platform services those resources depend on to exist.",{"_3461":367,"_30106":348,"_20907":50225,"_5":14363,"_27392":50178,"_2946":50226},[],"Area",{"_3461":368,"_30106":348,"_20907":50228,"_5":14363,"_27392":50178,"_2946":50229},[],"The Lamassu chart provides",{"_3461":369,"_30106":348,"_20907":50231,"_5":14363,"_27392":50178,"_2946":50232},[],"You provide",{"_3461":370,"_30106":348,"_20907":50234,"_5":14363,"_27392":50178,"_2946":50235},[],"Lamassu applications",{"_3461":371,"_30106":348,"_20907":50237,"_5":14363,"_27392":50178,"_2946":50238},[],"Deployments and StatefulSets for the UI and APIs, internal Services, ConfigMaps, a ServiceAccount, and optional HPAs and PDBs",{"_3461":372,"_30106":348,"_20907":50240,"_5":14363,"_27392":50178,"_2946":50241},[],"A working Kubernetes cluster, compute capacity and access to the container images",{"_3461":373,"_30106":348,"_20907":50243,"_5":14363,"_27392":50178,"_2946":50244},[],"PostgreSQL data",{"_3461":374,"_30106":348,"_20907":50246,"_5":14363,"_27392":50178,"_2946":50247},[],"A pre-install/pre-upgrade job that creates the required databases and schemas, runs migrations and applies the authorization bootstrap",{"_3461":375,"_30106":348,"_20907":50249,"_5":14363,"_27392":50178,"_2946":50250},[],"A reachable PostgreSQL server, credentials allowed to create databases and schemas, and backup/HA operations",{"_3461":376,"_30106":348,"_20907":50252,"_5":14363,"_27392":50178,"_2946":50253},[],"Messaging",{"_3461":377,"_30106":348,"_20907":50255,"_5":14363,"_27392":50178,"_2946":50256},[],"RabbitMQ connection configuration for the Lamassu services; the connection can use AMQPS, with an optional private CA and an optional client certificate, both set through chart values",{"_3461":378,"_30106":348,"_20907":50258,"_5":14363,"_27392":50178,"_2946":50259},[],"A reachable RabbitMQ broker, credentials and its lifecycle",{"_3461":379,"_30106":348,"_20907":50261,"_5":14363,"_27392":50178,"_2946":50262},[],"Identity",{"_3461":380,"_30106":348,"_20907":50264,"_5":14363,"_27392":50178,"_2946":50265},[],"OIDC/JWT and external-authorization configuration, plus initial Lamassu authorization principals",{"_3461":381,"_30106":348,"_20907":50267,"_5":14363,"_27392":50178,"_2946":50268},[],"An OIDC provider, realm/tenant, client, users, groups and roles",{"_3461":382,"_30106":348,"_20907":50270,"_5":14363,"_27392":50178,"_2946":50271},[],"External routing",{"_3461":383,"_30106":348,"_20907":50273,"_5":14363,"_27392":50178,"_2946":50274},[],"One `Gateway`, `HTTPRoute` resources, an `EnvoyProxy` configuration and Envoy security policies",{"_3461":384,"_30106":348,"_20907":50276,"_5":14363,"_27392":50178,"_2946":50277},[],"Gateway API and Envoy CRDs, the Envoy Gateway controller, a `GatewayClass`, a load-balancer implementation and the external network path",{"_3461":385,"_30106":348,"_20907":50279,"_5":14363,"_27392":50178,"_2946":50280},[],"TLS",{"_3461":386,"_30106":348,"_20907":50282,"_5":14363,"_27392":50178,"_2946":50283},[],"In the default `tls.type: certManager` mode, cert-manager `Issuer` and CA `Certificate` resources and a chart-managed downstream `Certificate`; in the `tls.type: external` mode, a reference to your TLS Secret",{"_3461":387,"_30106":348,"_20907":50285,"_5":14363,"_27392":50178,"_2946":50286},[],"cert-manager only for the default `tls.type: certManager` mode; for trusted TLS, a trusted issuer or a populated TLS Secret",{"_3461":388,"_30106":348,"_20907":50288,"_5":14363,"_27392":50178,"_2946":50289},[],"Persistent application data",{"_3461":389,"_30106":348,"_20907":50291,"_5":14363,"_27392":50178,"_2946":50292},[],"PersistentVolumeClaims required by the default local KMS and VA storage",{"_3461":390,"_30106":348,"_20907":50294,"_5":14363,"_27392":50178,"_2946":50295},[],"A StorageClass, physical storage, backups and a shared/external backend when scaling requires one",{"_3461":391,"_30106":348,"_20907":50297,"_5":14363,"_27392":50178,"_2946":50298},[],"Optional integrations",{"_3461":392,"_30106":348,"_20907":50300,"_5":14363,"_27392":50178,"_2946":50301},[],"Configuration hooks for observability, AWS connectors and PKCS#11/HSM connectivity",{"_3461":393,"_30106":348,"_20907":50303,"_5":14363,"_27392":50178,"_2946":50304},[],"The observability backends, cloud credentials and production HSM or external key service",{"_3461":394,"_30106":348,"_20907":50306,"_5":14363,"_27392":50178,"_2946":50307},[],"The chart creates Lamassu's `Gateway` and routes. It does not install the Envoy Gateway controller or make the generated `LoadBalancer` Service reachable from your network.",{"_3461":395,"_30106":348,"_20907":50309,"_5":14363,"_27392":50178,"_2946":50310},[],"Use one Lamassu Gateway on ports 80 and 443 and let its HTTPRoutes dispatch traffic to every Lamassu service. Give that Gateway one externally reachable endpoint through the cluster load balancer, or forward traffic to it from an external proxy or NAT device. You do not need one Gateway per service.",{"_3461":396,"_30106":348,"_20907":50312,"_5":14363,"_27392":50182,"_2946":50313},[],"The chart creates one shared `Gateway` per Helm release. All chart-managed `HTTPRoute` resources attach to it. Envoy Gateway provisions the proxy data plane and a Kubernetes `LoadBalancer` Service for that Gateway.",{"_3461":397,"_30106":348,"_20907":50315,"_5":14363,"_27392":50182,"_2946":50316},[],"The `gateway.addresses` value is only an address request to the Gateway controller. It does not make an IP routable, open a firewall, configure DNS or create NAT. See Expose the Gateway before setting it.",{"_3461":398,"_30106":348,"_20907":50318,"_5":14363,"_27392":50186,"_2946":50319},[],"Kubernetes 1.24 or newer",{"_3461":399,"_30106":348,"_20907":50321,"_5":14363,"_27392":50186,"_2946":50322},[],"Helm 3.2 or newer",{"_3461":400,"_30106":348,"_20907":50324,"_5":14363,"_27392":50186,"_2946":50325},[],"Envoy Gateway 1.8 or newer and a `GatewayClass`",{"_3461":401,"_30106":348,"_20907":50327,"_5":14363,"_27392":50186,"_2946":50328},[],"cert-manager 1.14 or newer; required only for the default `tls.type: certManager` TLS mode, not for `tls.type: external`",{"_3461":402,"_30106":348,"_20907":50330,"_5":14363,"_27392":50186,"_2946":50331},[],"persistent storage suitable for the selected PostgreSQL, RabbitMQ, VA and KMS configuration",{"_3461":403,"_30106":348,"_20907":50333,"_5":14363,"_27392":50186,"_2946":50334},[],"a load-balancer implementation or another deliberate path from clients to the Gateway",{"_3461":404,"_30106":348,"_20907":50336,"_5":14363,"_27392":50186,"_2946":50337},[],"KMS deployments using the native PKCS#11 sidecar require Kubernetes 1.29 or newer. Prebuilt Lamassu container images are published for `linux/amd64` and `linux/arm64`, and the KMS PKCS#11 client module (`p11-kit-client.so`) is installed at the target architecture's Debian library path: `/usr/lib/x86_64-linux-gnu/pkcs11/p11-kit-client.so` on amd64 and `/usr/lib/aarch64-linux-gnu/pkcs11/p11-kit-client.so` on arm64. The x86\\_64 path is retained as a compatibility alias for existing configurations.",{"_3461":405,"_30106":348,"_20907":50339,"_5":14363,"_27392":50190,"_2946":50340},[],"<Card title=\"Install with Helm\" description=\"Prepare dependencies, configure values, install and verify a controlled deployment.\" href=\"/docs/deployment/self-hosted/helm\" />",{"_3461":406,"_30106":348,"_20907":50342,"_5":14363,"_27392":50190,"_2946":50343},[],"<Card title=\"Upgrade from 3.8.0\" description=\"Upgrade an existing Helm release to 4.0.0: architecture changes, breaking changes, migration steps and validation.\" href=\"/docs/upgrades/3-8-0-to-4-0-0\" />",{"_3461":407,"_30106":348,"_20907":50345,"_5":14363,"_27392":50190,"_2946":50346},[],"<Card title=\"Expose the Gateway\" description=\"Choose an external traffic design, understand gateway.addresses and handle multiple Gateways.\" href=\"/docs/deployment/self-hosted/networking\" />",{"_3461":408,"_30106":348,"_20907":50348,"_5":14363,"_27392":50190,"_2946":50349},[],"<Card title=\"Use Fastlane\" description=\"Bootstrap a complete evaluation or lab environment with one script.\" href=\"/docs/deployment/self-hosted/fastlane\" />",{"_3461":409,"_30106":409,"_5":14715,"_2946":50351,"_30438":50352,"_20907":50354,"_27392":409},"Deployment troubleshooting",[49125,49126,50353],"Operations",[],{"_3461":410,"_30106":409,"_20907":50356,"_5":14363,"_27392":409,"_2946":50357},[],"Diagnose access, service health and infrastructure dependencies.",{"_3461":411,"_30106":409,"_5":30435,"_20907":50359,"_27392":50360,"_2946":50361},[],"/docs/deployment/troubleshooting#diagnostic-sequence","Diagnostic sequence",{"_3461":412,"_30106":409,"_5":30435,"_20907":50363,"_27392":50364,"_2946":50365},[],"/docs/deployment/troubleshooting#reproduce-a-single-operation","Reproduce a single operation",{"_3461":413,"_30106":409,"_5":30435,"_20907":50367,"_27392":50368,"_2946":50369},[],"/docs/deployment/troubleshooting#separate-client-gateway-and-service","Separate client, Gateway and service",{"_3461":414,"_30106":409,"_5":30435,"_20907":50371,"_27392":50372,"_2946":50373},[],"/docs/deployment/troubleshooting#review-kubernetes-status","Review Kubernetes status",{"_3461":415,"_30106":409,"_5":30435,"_20907":50375,"_27392":50376,"_2946":50377},[],"/docs/deployment/troubleshooting#query-the-affected-service","Query the affected service",{"_3461":416,"_30106":409,"_5":30435,"_20907":50379,"_27392":50380,"_2946":50381},[],"/docs/deployment/troubleshooting#validate-the-result-from-outside","Validate the result from outside",{"_3461":417,"_30106":409,"_5":30435,"_20907":50383,"_27392":50384,"_2946":50385},[],"/docs/deployment/troubleshooting#minimal-evidence-collection","Minimal evidence collection",{"_3461":418,"_30106":409,"_5":30435,"_20907":50387,"_27392":50388,"_2946":50389},[],"/docs/deployment/troubleshooting#i-cannot-sign-in","I cannot sign in",{"_3461":419,"_30106":409,"_5":30435,"_20907":50391,"_27392":50392,"_2946":50393},[],"/docs/deployment/troubleshooting#everything-returns-403-or-5xx","Everything returns 403 or 5xx",{"_3461":420,"_30106":409,"_5":30435,"_20907":50395,"_27392":50396,"_2946":50397},[],"/docs/deployment/troubleshooting#api-500-errors","API 500 errors",{"_3461":421,"_30106":409,"_5":30435,"_20907":50399,"_27392":50400,"_2946":50401},[],"/docs/deployment/troubleshooting#a-pod-is-not-ready","A pod is not Ready",{"_3461":422,"_30106":409,"_5":30435,"_20907":50403,"_27392":50404,"_2946":50405},[],"/docs/deployment/troubleshooting#events-are-not-arriving","Events are not arriving",{"_3461":423,"_30106":409,"_5":30435,"_20907":50407,"_27392":50408,"_2946":50409},[],"/docs/deployment/troubleshooting#observability","Observability",{"_3461":424,"_30106":409,"_20907":50411,"_5":14363,"_27392":409,"_2946":50412},[],"Start by locating the failing layer. A Gateway response and an unready pod require different evidence. For rejected issuance or validation results, see PKI troubleshooting; for enrollment, see EST diagnostics.",{"_3461":425,"_30106":409,"_20907":50414,"_5":14363,"_27392":50364,"_2946":50415},[],"Note the time in UTC, user or principal, resource, endpoint and result. Avoid repeating a destructive action such as revocation or deletion.",{"_3461":426,"_30106":409,"_20907":50417,"_5":14363,"_27392":50368,"_2946":50418},[],"Check the HTTP status. A 401 points to authentication; a 403, to authorization; a 404, to route or resource; a 5xx, to the service or a dependency.",{"_3461":427,"_30106":409,"_20907":50420,"_5":14363,"_27392":50372,"_2946":50421},[],"Locate unready pods, restarts, recent events and the state of the release.",{"_3461":428,"_30106":409,"_20907":50423,"_5":14363,"_27392":50376,"_2946":50424},[],"Review its /health endpoint and its logs in the same time window. Then follow the indicated dependency: PostgreSQL, RabbitMQ, the OIDC provider or the cryptographic engine.",{"_3461":429,"_30106":409,"_20907":50426,"_5":14363,"_27392":50380,"_2946":50427},[],"For PKI, check the certificate, the chain, OCSP or CRL with the same type of client production uses.",{"_3461":430,"_30106":409,"_20907":50429,"_5":14363,"_27392":50384,"_2946":50430},[],"Replace the placeholders with your real release, namespace and deployment.",{"_3461":431,"_30106":409,"_20907":50432,"_5":14363,"_27392":50384,"_2946":50433},[],"Also run the chart's connectivity test:",{"_3461":432,"_30106":409,"_20907":50435,"_5":14363,"_27392":50384,"_2946":50436},[],"The test checks the health of CA, DMS Manager, Device Manager and VA, and verifies that the UI returns HTML. A passing test confirms basic connectivity, not a full issuance flow.",{"_3461":433,"_30106":409,"_20907":50438,"_5":14363,"_27392":50384,"_2946":50439},[],"The chart's services expose startup, readiness and liveness probes over /health. A pod can be running but receive no traffic if the readiness probe fails.",{"_3461":434,"_30106":409,"_20907":50441,"_5":14363,"_27392":50388,"_2946":50442},[],"If you receive a 401:",{"_3461":435,"_30106":409,"_20907":50444,"_5":14363,"_27392":50388,"_2946":50445},[],"check that the UI's OIDC authority is reachable from the browser;",{"_3461":436,"_30106":409,"_20907":50447,"_5":14363,"_27392":50388,"_2946":50448},[],"verify issuer, audience and expiration of the token;",{"_3461":437,"_30106":409,"_20907":50450,"_5":14363,"_27392":50388,"_2946":50451},[],"confirm the Gateway can fetch the keys from the JWKS URI;",{"_3461":438,"_30106":409,"_20907":50453,"_5":14363,"_27392":50388,"_2946":50454},[],"check that the provider's public and internal routes point to the same realm.",{"_3461":439,"_30106":409,"_20907":50456,"_5":14363,"_27392":50388,"_2946":50457},[],"If login succeeds but the APIs return 403:",{"_3461":440,"_30106":409,"_20907":50459,"_5":14363,"_27392":50388,"_2946":50460},[],"inspect the token's real claims;",{"_3461":441,"_30106":409,"_20907":50462,"_5":14363,"_27392":50388,"_2946":50463},[],"confirm they match an active principal;",{"_3461":442,"_30106":409,"_20907":50465,"_5":14363,"_27392":50388,"_2946":50466},[],"review the policies granted to that principal;",{"_3461":443,"_30106":409,"_20907":50468,"_5":14363,"_27392":50388,"_2946":50469},[],"verify that authz reaches PostgreSQL and its JWKS.",{"_3461":444,"_30106":409,"_20907":50471,"_5":14363,"_27392":50388,"_2946":50472},[],"On a fresh installation, confirm the migration Job finished. That Job creates schemas, migrates authz, preloads policies and provisions the principals defined in services.authz.bootstrap.",{"_3461":445,"_30106":409,"_20907":50474,"_5":14363,"_27392":50392,"_2946":50475},[],"External authorization fails closed by default. If authz is unavailable, protected routes are blocked.",{"_3461":446,"_30106":409,"_20907":50477,"_5":14363,"_27392":50392,"_2946":50478},[],"Locate the authz pod and Service.",{"_3461":447,"_30106":409,"_20907":50480,"_5":14363,"_27392":50392,"_2946":50481},[],"Check /health, logs and its database connection.",{"_3461":448,"_30106":409,"_20907":50483,"_5":14363,"_27392":50392,"_2946":50484},[],"Verify the DNS and port configured in externalAuthorization.",{"_3461":449,"_30106":409,"_20907":50486,"_5":14363,"_27392":50392,"_2946":50487},[],"Check the check route is /v1/ext\\_authz/check.",{"_3461":450,"_30106":409,"_20907":50489,"_5":14363,"_27392":50392,"_2946":50490},[],"Do not switch to failOpen: true as a permanent workaround: it would allow traffic without authorization during the outage.",{"_3461":451,"_30106":409,"_20907":50492,"_5":14363,"_27392":50396,"_2946":50493},[],"A 500 indicates an internal failure, such as an unavailable database. The `{\"err\": ...}` body currently includes the text of the internal error, which can contain schema, table and constraint names and, on connection failures, the database host and user (not the password). Find the cause in the service log using the request time, and do not forward the body to third parties or show it to end users. This is a known information-disclosure defect: generic messages are planned for 500 responses, keeping the detail only in the service log (tracked in lamassuiot#814). The authorization connector also returns the internal error, in the `details.error` field. Some request errors, such as a key size the engine does not support, are also returned as 500.",{"_3461":452,"_30106":409,"_20907":50495,"_5":14363,"_27392":50400,"_2946":50496},[],"Review kubectl describe pod first. Common causes are:",{"_3461":453,"_30106":409,"_20907":50498,"_5":14363,"_27392":50400,"_2946":50499},[],"wrong credentials or DNS for PostgreSQL or RabbitMQ;",{"_3461":454,"_30106":409,"_20907":50501,"_5":14363,"_27392":50400,"_2946":50502},[],"a missing AMQP CA or client certificate Secret referenced by `amqp.ca.secretName` or `amqp.client.secretName`;",{"_3461":455,"_30106":409,"_20907":50504,"_5":14363,"_27392":50400,"_2946":50505},[],"unbound persistent volume;",{"_3461":456,"_30106":409,"_20907":50507,"_5":14363,"_27392":50400,"_2946":50508},[],"inaccessible image or incorrect pull policy;",{"_3461":457,"_30106":409,"_20907":50510,"_5":14363,"_27392":50400,"_2946":50511},[],"invalid cryptographic engine configuration;",{"_3461":458,"_30106":409,"_20907":50513,"_5":14363,"_27392":50400,"_2946":50514},[],"CPU or memory limits set too low;",{"_3461":459,"_30106":409,"_20907":50516,"_5":14363,"_27392":50400,"_2946":50517},[],"an incomplete prior migration.",{"_3461":460,"_30106":409,"_20907":50519,"_5":14363,"_27392":50400,"_2946":50520},[],"Generic values request 100 mCPU and 128 MiB and limit to 500 mCPU and 512 MiB. Tune per service when you see OOMKills, throttling or slow startups.",{"_3461":461,"_30106":409,"_20907":50522,"_5":14363,"_27392":50400,"_2946":50523},[],"Filesystem-based KMS engines and VA local storage use exclusive-access volumes. Keep a single replica or migrate to shared backends before enabling autoscaling.",{"_3461":462,"_30106":409,"_20907":50525,"_5":14363,"_27392":50400,"_2946":50526},[],"Internal calls now fail fast instead of hanging for the clients covered by Egress proxy: connection attempts time out after 30 seconds and TLS handshakes after 10 seconds. The authorization-engine connector keeps its own transport without these dial and handshake timeouts; only its overall 30-second request timeout bounds each call. If an egress proxy handles the cluster's outbound traffic, check the pod's `HTTP_PROXY`, `HTTPS_PROXY` and `NO_PROXY` environment variables and list in-cluster service names in `NO_PROXY`.",{"_3461":463,"_30106":409,"_20907":50528,"_5":14363,"_27392":50404,"_2946":50529},[],"Domain and audit events depend on the bus publisher:",{"_3461":464,"_30106":409,"_20907":50531,"_5":14363,"_27392":50404,"_2946":50532},[],"verify it is enabled in the emitting service;",{"_3461":465,"_30106":409,"_20907":50534,"_5":14363,"_27392":50404,"_2946":50535},[],"check AMQP connectivity and credentials;",{"_3461":466,"_30106":409,"_20907":50537,"_5":14363,"_27392":50404,"_2946":50538},[],"review exchange, routing key, queues and consumers;",{"_3461":467,"_30106":409,"_20907":50540,"_5":14363,"_27392":50404,"_2946":50541},[],"inspect dead-letter queues;",{"_3461":468,"_30106":409,"_20907":50543,"_5":14363,"_27392":50404,"_2946":50544},[],"alert on orphan durable queues and backlog growth.",{"_3461":469,"_30106":409,"_20907":50546,"_5":14363,"_27392":50404,"_2946":50547},[],"If `amqp.tls` is enabled, verify the TLS side as well:",{"_3461":470,"_30106":409,"_20907":50549,"_5":14363,"_27392":50404,"_2946":50550},[],"confirm the broker listener speaks AMQPS on the configured port — the default port stays `5672` and does not follow TLS automatically;",{"_3461":471,"_30106":409,"_20907":50552,"_5":14363,"_27392":50404,"_2946":50553},[],"if you set `amqp.ca.secretName`, confirm the Secret exists in the release namespace and its data key matches `amqp.ca.certificateKey` (default `ca.crt`); if `amqp.ca.secretName` is not set, the clients trust the system CAs;",{"_3461":472,"_30106":409,"_20907":50555,"_5":14363,"_27392":50404,"_2946":50556},[],"remember that a missing referenced Secret prevents the consuming pods from starting;",{"_3461":473,"_30106":409,"_20907":50558,"_5":14363,"_27392":50404,"_2946":50559},[],"after updating the CA or client certificate Secret, restart the consuming pods: the AMQP client loads certificates at startup.",{"_3461":474,"_30106":409,"_20907":50561,"_5":14363,"_27392":50404,"_2946":50562},[],"See AMQP TLS (AMQPS) for the full configuration.",{"_3461":475,"_30106":409,"_20907":50564,"_5":14363,"_27392":50404,"_2946":50565},[],"A consumer outage does not always prevent the main operation from completing. That is why you must monitor RabbitMQ and independently verify the persistence of audit logs.",{"_3461":476,"_30106":409,"_20907":50567,"_5":14363,"_27392":50408,"_2946":50568},[],"The chart can enable OpenTelemetry instrumentation for the services that support it, including authz; it does not configure OpenTelemetry for AWS Connector, wfx or the UI. Traces are exported over OTLP HTTP and logs can be directed to a compatible endpoint, such as VictoriaLogs. Use a correlation identifier and the same time window to join Gateway, service and dependency.",{"_3461":477,"_30106":409,"_20907":50570,"_5":14363,"_27392":50408,"_2946":50571},[],"Before closing an incident, record:",{"_3461":478,"_30106":409,"_20907":50573,"_5":14363,"_27392":50408,"_2946":50574},[],"the confirmed cause;",{"_3461":479,"_30106":409,"_20907":50576,"_5":14363,"_27392":50408,"_2946":50577},[],"the time scope and affected resources;",{"_3461":480,"_30106":409,"_20907":50579,"_5":14363,"_27392":50408,"_2946":50580},[],"the commands or queries used;",{"_3461":481,"_30106":409,"_20907":50582,"_5":14363,"_27392":50408,"_2946":50583},[],"the applied change and how to revert it;",{"_3461":482,"_30106":409,"_20907":50585,"_5":14363,"_27392":50408,"_2946":50586},[],"validation from a consumer;",{"_3461":483,"_30106":409,"_20907":50588,"_5":14363,"_27392":50408,"_2946":50589},[],"the preventive action and its owner.",{"_3461":484,"_30106":484,"_5":14715,"_2946":50591,"_30438":50592,"_20907":50595,"_27392":484},"Access control",[49125,50593,50594],"Platform","Administration",[],{"_3461":485,"_30106":484,"_20907":50597,"_5":14363,"_27392":484,"_2946":50598},[],"Design who can access Lamassu through principals, policies, resource permissions and HTTP route authorization.",{"_3461":486,"_30106":484,"_5":30435,"_20907":50600,"_27392":50601,"_2946":50602},[],"/docs/platform/administration/access-control#essential-concepts","Essential concepts",{"_3461":487,"_30106":484,"_5":30435,"_20907":50604,"_27392":50605,"_2946":50606},[],"/docs/platform/administration/access-control#two-decision-systems","Two decision systems",{"_3461":488,"_30106":484,"_5":30435,"_20907":50608,"_27392":50609,"_2946":50610},[],"/docs/platform/administration/access-control#integrated-or-external-http-services","Integrated or external HTTP services",{"_3461":489,"_30106":484,"_5":30435,"_20907":50612,"_27392":50613,"_2946":50614},[],"/docs/platform/administration/access-control#authentication-only-routes-and-unmapped-paths","Authentication-only routes and unmapped paths",{"_3461":490,"_30106":484,"_5":30435,"_20907":50616,"_27392":50617,"_2946":50618},[],"/docs/platform/administration/access-control#services-developed-by-lamassu","Services developed by Lamassu",{"_3461":491,"_30106":484,"_5":30435,"_20907":50620,"_27392":50621,"_2946":50622},[],"/docs/platform/administration/access-control#how-the-two-paths-relate","How the two paths relate",{"_3461":492,"_30106":484,"_5":30435,"_20907":50624,"_27392":50625,"_2946":50626},[],"/docs/platform/administration/access-control#oidc-principals","OIDC principals",{"_3461":493,"_30106":484,"_5":30435,"_20907":50628,"_27392":50629,"_2946":50630},[],"/docs/platform/administration/access-control#x509-principals","X.509 principals",{"_3461":494,"_30106":484,"_5":30435,"_20907":50632,"_27392":50633,"_2946":50634},[],"/docs/platform/administration/access-control#when-several-principals-match","When several principals match",{"_3461":495,"_30106":484,"_5":30435,"_20907":50636,"_27392":50637,"_2946":50638},[],"/docs/platform/administration/access-control#how-policies-express-access","How policies express access",{"_3461":496,"_30106":484,"_5":30435,"_20907":50640,"_27392":50641,"_2946":50642},[],"/docs/platform/administration/access-control#global-and-direct-access","Global and direct access",{"_3461":497,"_30106":484,"_5":30435,"_20907":50644,"_27392":50645,"_2946":50646},[],"/docs/platform/administration/access-control#access-inherited-through-relations","Access inherited through relations",{"_3461":498,"_30106":484,"_5":30435,"_20907":50648,"_27392":50649,"_2946":50650},[],"/docs/platform/administration/access-control#attribute-filtered-access","Attribute-filtered access",{"_3461":499,"_30106":484,"_5":30435,"_20907":50652,"_27392":50653,"_2946":50654},[],"/docs/platform/administration/access-control#http-rules","HTTP rules",{"_3461":500,"_30106":484,"_5":30435,"_20907":50656,"_27392":50657,"_2946":50658},[],"/docs/platform/administration/access-control#included-policies","Included policies",{"_3461":501,"_30106":484,"_5":30435,"_20907":50660,"_27392":50661,"_2946":49765},[],"/docs/platform/administration/access-control#provision-the-first-administrator",{"_3461":502,"_30106":484,"_5":30435,"_20907":50663,"_27392":50664,"_2946":50665},[],"/docs/platform/administration/access-control#prepare-the-identity-provider","Prepare the identity provider",{"_3461":503,"_30106":484,"_5":30435,"_20907":50667,"_27392":50668,"_2946":50669},[],"/docs/platform/administration/access-control#configure-token-validation","Configure token validation",{"_3461":504,"_30106":484,"_5":30435,"_20907":50671,"_27392":50672,"_2946":50673},[],"/docs/platform/administration/access-control#install-and-verify-administrative-access","Install and verify administrative access",{"_3461":505,"_30106":484,"_5":30435,"_20907":50675,"_27392":50676,"_2946":50677},[],"/docs/platform/administration/access-control#test-an-unprivileged-identity","Test an unprivileged identity",{"_3461":506,"_30106":484,"_5":30435,"_20907":50679,"_27392":50680,"_2946":50681},[],"/docs/platform/administration/access-control#reduce-use-of-the-bootstrap-administrator","Reduce use of the bootstrap administrator",{"_3461":507,"_30106":484,"_5":30435,"_20907":50683,"_27392":50684,"_2946":50685},[],"/docs/platform/administration/access-control#fastlane-bootstrap","Fastlane bootstrap",{"_3461":508,"_30106":484,"_5":30435,"_20907":50687,"_27392":50688,"_2946":50689},[],"/docs/platform/administration/access-control#design-least-privilege-roles","Design least-privilege roles",{"_3461":509,"_30106":484,"_5":30435,"_20907":50691,"_27392":50692,"_2946":50693},[],"/docs/platform/administration/access-control#changes-and-access-revocation","Changes and access revocation",{"_3461":510,"_30106":484,"_5":30435,"_20907":50695,"_27392":50696,"_2946":50697},[],"/docs/platform/administration/access-control#operational-checklist","Operational checklist",{"_3461":511,"_30106":484,"_5":30435,"_20907":50699,"_27392":50700,"_2946":50701},[],"/docs/platform/administration/access-control#diagnostics","Diagnostics",{"_3461":512,"_30106":484,"_5":30435,"_20907":50703,"_27392":50704,"_2946":50705},[],"/docs/platform/administration/access-control#the-response-is-401","The response is 401",{"_3461":513,"_30106":484,"_5":30435,"_20907":50707,"_27392":50708,"_2946":50709},[],"/docs/platform/administration/access-control#the-response-is-403","The response is 403",{"_3461":514,"_30106":484,"_5":30435,"_20907":50711,"_27392":50712,"_2946":50713},[],"/docs/platform/administration/access-control#everything-returns-403","Everything returns 403",{"_3461":515,"_30106":484,"_5":30435,"_20907":50715,"_27392":50716,"_2946":50717},[],"/docs/platform/administration/access-control#access-appears-without-a-policy-grant","Access appears without a policy grant",{"_3461":516,"_30106":484,"_5":30435,"_20907":50719,"_27392":50720,"_2946":50721},[],"/docs/platform/administration/access-control#everything-fails-when-authz-is-unavailable","Everything fails when authz is unavailable",{"_3461":517,"_30106":484,"_20907":50723,"_5":14363,"_27392":484,"_2946":50724},[],"Lamassu access control turns an authenticated identity into concrete permissions. The OIDC provider or the client certificate proves **who** makes a request; the `authz` service decides **what that identity can do** and **over which resources**.",{"_3461":518,"_30106":484,"_20907":50726,"_5":14363,"_27392":484,"_2946":50727},[],"Lamassu does not assign permissions directly to users. The full chain is:",{"_3461":519,"_30106":484,"_20907":50729,"_5":14363,"_27392":484,"_2946":50730},[],"This model lets you represent people, identity-provider groups, service accounts and devices without coupling authorization to a specific provider.",{"_3461":520,"_30106":484,"_20907":50732,"_5":14363,"_27392":50601,"_2946":50733},[],"A **principal** connects a credential to Lamassu. It defines how to recognize an OIDC or X.509 identity and can be active or disabled.",{"_3461":521,"_30106":484,"_20907":50735,"_5":14363,"_27392":50601,"_2946":50736},[],"A **policy** groups reusable permissions. It can be granted to several principals and can contain rules about Lamassu entities, rules about HTTP routes or both.",{"_3461":522,"_30106":484,"_20907":50738,"_5":14363,"_27392":50601,"_2946":50739},[],"An **entity rule** grants actions over resources such as certification authorities, certificates, issuance profiles, devices, DMSs, keys or alert subscriptions. It can cover all resources of a type or be limited by identifier, relation or attribute.",{"_3461":523,"_30106":484,"_20907":50741,"_5":14363,"_27392":50601,"_2946":50742},[],"An **HTTP rule** grants actions associated with API routes. It is the mechanism the Gateway uses to decide whether a request may cross the perimeter.",{"_3461":524,"_30106":484,"_20907":50744,"_5":14363,"_27392":50601,"_2946":50745},[],"A **grant** is the association between a principal and a policy. Removing the grant removes all permissions contributed by that policy, without modifying it for other principals.",{"_3461":525,"_30106":484,"_20907":50747,"_5":14363,"_27392":50601,"_2946":50748},[],"A valid JWT or a valid client certificate does not grant access by itself. The credential must match at least one active principal and, unless the HTTP schema exempts the route, one of its policies must allow the requested operation. See *Authentication-only routes and unmapped paths* for those exemptions.",{"_3461":526,"_30106":484,"_20907":50750,"_5":14363,"_27392":50605,"_2946":50751},[],"Lamassu uses two authorization paths depending on who implements the protected service. They share principals, policies and grants, but they do not interpret the rules the same way.",{"_3461":527,"_30106":484,"_20907":50753,"_5":14363,"_27392":50605,"_2946":50754},[],"An external service can be protected without knowing Lamassu's internal authorization model. A service developed by Lamassu embeds the authorization engine and can decide on concrete resources and filter its queries.",{"_3461":528,"_30106":484,"_20907":50756,"_5":14363,"_27392":50609,"_2946":50757},[],"This path protects APIs that join the platform through the Gateway but do not natively implement Lamassu's authorization SDK. Job Manager is the current example. The same pattern allows integrating other HTTP services as long as their routes are described in an `authz` HTTP schema.",{"_3461":529,"_30106":484,"_20907":50759,"_5":14363,"_27392":50609,"_2946":50760},[],"The decision is made **before forwarding the request to the service**:",{"_3461":530,"_30106":484,"_20907":50762,"_5":14363,"_27392":50609,"_2946":50763},[],"Envoy Gateway authenticates the request, usually validating a JWT against the OIDC provider's JWKS.",{"_3461":531,"_30106":484,"_20907":50765,"_5":14363,"_27392":50609,"_2946":50766},[],"For a protected route, Envoy sends the method, URL, headers and required data to `/v1/ext_authz/check`.",{"_3461":532,"_30106":484,"_20907":50768,"_5":14363,"_27392":50609,"_2946":50769},[],"`authz` extracts the credential and resolves all active principals matching it.",{"_3461":533,"_30106":484,"_20907":50771,"_5":14363,"_27392":50609,"_2946":50772},[],"It separately loads the policies granted to each principal.",{"_3461":534,"_30106":484,"_20907":50774,"_5":14363,"_27392":50609,"_2946":50775},[],"The HTTP schema translates the method and route combination into a logical action, such as `nbi-job-read` or `nbi-workflow-create`.",{"_3461":535,"_30106":484,"_20907":50777,"_5":14363,"_27392":50609,"_2946":50778},[],"`authz` looks for an HTTP rule granting that action.",{"_3461":536,"_30106":484,"_20907":50780,"_5":14363,"_27392":50609,"_2946":50781},[],"If the route declares constraints, it compares request data with the normalized attributes of the same principal contributing the policy; the policy's own `param_constraints` also pin the granted action to literal request values.",{"_3461":537,"_30106":484,"_20907":50783,"_5":14363,"_27392":50609,"_2946":50784},[],"A satisfying result lets Envoy forward the request; any other response blocks it at the Gateway.",{"_3461":538,"_30106":484,"_20907":50786,"_5":14363,"_27392":50609,"_2946":50787},[],"When it allows access, `authz` returns the selected principal in the `X-Principal-ID` response header. The Gateway can propagate that header to the service to preserve the identity context.",{"_3461":539,"_30106":484,"_20907":50789,"_5":14363,"_27392":50609,"_2946":50790},[],"HTTP rules primarily answer &#x2A;*\"can this identity call this API operation?\"**. On their own they do not produce filters over the external service's database. To limit a route to a specific device, tenant or client, either the schema declares a constraint relating a request value to a normalized attribute of the principal, or the policy pins the request value to a literal with `param_constraints`. The first scopes each identity to its own resources through a single grant; the second restricts a grant to a fixed value regardless of who holds it.",{"_3461":540,"_30106":484,"_20907":50792,"_5":14363,"_27392":50613,"_2946":50793},[],"Two schema-level settings cover endpoints that policies do not mention:",{"_3461":541,"_30106":484,"_20907":50795,"_5":14363,"_27392":50613,"_2946":50796},[],"**`skip_authz: true` on a route** allows any identity that matches an active principal to reach it, even one with no granted policies. Use it for paths such as `/openapi.json` or `/health` that every authenticated caller should be able to access. The request still has to authenticate successfully: a credential that fails validation or matches no active principal is rejected before this setting is considered. A `skip_authz` route cannot declare constraints, and it wins over any other schema's route or default action for the same request.",{"_3461":542,"_30106":484,"_20907":50798,"_5":14363,"_27392":50613,"_2946":50799},[],"**`default_action` with `base_paths`** decides what happens when a request falls under a path prefix the schema owns but no explicit route matches. `deny` — the value the Job Manager schema ships with — turns the implicit denial of unmapped paths into an explicit, auditable statement; `allow` opens unmapped endpoints under that prefix to any identity that matches an active principal.",{"_3461":543,"_30106":484,"_20907":50801,"_5":14363,"_27392":50613,"_2946":50802},[],"These are decisions of the schema, not of a policy: `skip_authz` removes the grant check for that route, even when another schema maps the same request to an action that requires a grant, and `default_action` only covers requests that no explicit route in any schema matches. Keep three rules in mind:",{"_3461":544,"_30106":484,"_20907":50804,"_5":14363,"_27392":50613,"_2946":50805},[],"`default_action` requires at least one `base_paths` entry, and base paths are absolute paths such as `/api/wfx/nbi/v1`.",{"_3461":545,"_30106":484,"_20907":50807,"_5":14363,"_27392":50613,"_2946":50808},[],"An explicit route in any schema takes precedence: the fallback only decides requests that no schema's routes cover. When the prefixes of two schemas overlap, the longest matching prefix decides.",{"_3461":546,"_30106":484,"_20907":50810,"_5":14363,"_27392":50613,"_2946":50811},[],"Two schemas cannot claim the same base path with different default actions; the conflicting schema fails to load.",{"_3461":547,"_30106":484,"_20907":50813,"_5":14363,"_27392":50613,"_2946":50814},[],"A `skip_authz` route and a `default_action: \"allow\"` prefix grant access without consulting any policy. Every identity that matches an active principal can reach what they open, including identities with no granted policies. A `skip_authz` route in one schema also opens a request that another schema maps to a grant-protected action. Review these settings whenever you add or upgrade an integrated service.",{"_3461":548,"_30106":484,"_20907":50816,"_5":14363,"_27392":50617,"_2946":50817},[],"Lamassu's native services embed authorization in their middleware and know the entities they operate on: certificates, CAs, issuance profiles, keys, devices, DMSs or subscriptions, among others.",{"_3461":549,"_30106":484,"_20907":50819,"_5":14363,"_27392":50617,"_2946":50820},[],"The decision is made with the domain operation context:",{"_3461":550,"_30106":484,"_20907":50822,"_5":14363,"_27392":50617,"_2946":50823},[],"The middleware extracts the credential and resolves the matching principals.",{"_3461":551,"_30106":484,"_20907":50825,"_5":14363,"_27392":50617,"_2946":50826},[],"The endpoint identifies the action, the entity type and, when applicable, the key of the requested resource.",{"_3461":552,"_30106":484,"_20907":50828,"_5":14363,"_27392":50617,"_2946":50829},[],"`authz` gathers the entity rules of the granted policies.",{"_3461":553,"_30106":484,"_20907":50831,"_5":14363,"_27392":50617,"_2946":50832},[],"The engine evaluates direct grants, attribute filters and relations with other entities.",{"_3461":554,"_30106":484,"_20907":50834,"_5":14363,"_27392":50617,"_2946":50835},[],"For an individual operation, it checks that the concrete resource satisfies the computed scope.",{"_3461":555,"_30106":484,"_20907":50837,"_5":14363,"_27392":50617,"_2946":50838},[],"For a listing, it generates a SQL filter that the service adds to its own query.",{"_3461":556,"_30106":484,"_20907":50840,"_5":14363,"_27392":50617,"_2946":50841},[],"Here the engine answers &#x2A;*\"can this identity perform this action on this concrete resource?\"**.",{"_3461":557,"_30106":484,"_20907":50843,"_5":14363,"_27392":50617,"_2946":50844},[],"Actions fall into two groups:",{"_3461":558,"_30106":484,"_20907":50846,"_5":14363,"_27392":50617,"_2946":50847},[],"**Global actions** do not need a resource identifier. `create`, `import` or access to a console section are common examples.",{"_3461":559,"_30106":484,"_20907":50849,"_5":14363,"_27392":50617,"_2946":50850},[],"**Atomic actions** are evaluated on a concrete instance. For certificates these include `read`, `metadata-update`, `status-update` and `delete`; for a CA there are also `sign`, `reissue` and other lifecycle operations.",{"_3461":560,"_30106":484,"_20907":50852,"_5":14363,"_27392":50617,"_2946":50853},[],"Filtering inside the service prevents leaks in listings: unauthorized resources are excluded from the SQL query instead of being fetched and hidden later in the interface.",{"_3461":561,"_30106":484,"_20907":50855,"_5":14363,"_27392":50621,"_2946":50856},[],"They are not two equivalent controls applied twice. HTTP rules protect the perimeter of an integrated service; entity rules express permissions over the data model of the native services.",{"_3461":562,"_30106":484,"_20907":50858,"_5":14363,"_27392":50621,"_2946":50859},[],"A policy can contain both rule types when an identity needs to operate Lamassu resources and also call an integrated API. Granting an entity rule does not automatically grant an HTTP action, nor does an HTTP rule create access over an entity.",{"_3461":563,"_30106":484,"_20907":50861,"_5":14363,"_27392":50621,"_2946":50862},[],"If no combination of principal, policy and rule allows the operation, Lamassu denies it, unless the HTTP schema declares `skip_authz` on the route or `default_action: allow` on a base path that covers it (see *Authentication-only routes and unmapped paths*). Additionally, `auth.externalAuthorization.failOpen` is `false` by default: if `authz` is unavailable, the Gateway blocks protected routes.",{"_3461":564,"_30106":484,"_20907":50864,"_5":14363,"_27392":50625,"_2946":50865},[],"An OIDC principal matches the claims of a validated JWT. It is appropriate for human users, corporate groups, IdP roles and service accounts that obtain tokens.",{"_3461":565,"_30106":484,"_20907":50867,"_5":14363,"_27392":50625,"_2946":50868},[],"The following principal represents any identity holding the `pki-operators` role in Keycloak:",{"_3461":566,"_30106":484,"_20907":50870,"_5":14363,"_27392":50625,"_2946":50871},[],"Claim paths can be nested, such as `realm_access.roles`. Within a single principal, **all** conditions must hold. This lets you require, for example, a group and an organizational audience at the same time.",{"_3461":567,"_30106":484,"_20907":50873,"_5":14363,"_27392":50625,"_2946":50874},[],"The implemented operators are:",{"_3461":568,"_30106":484,"_20907":50876,"_5":14363,"_27392":50625,"_2946":50877},[],"`equals`, for exact equality;",{"_3461":569,"_30106":484,"_20907":50879,"_5":14363,"_27392":50625,"_2946":50880},[],"`contains`, to check membership in a list or the presence of text in a scalar value.",{"_3461":570,"_30106":484,"_20907":50882,"_5":14363,"_27392":50625,"_2946":50883},[],"Design matching with stable attributes. For people, it is usually better to bind permissions to centrally managed groups or roles than to the email or username. For a service account, a stable `sub` keeps its permissions from mixing with a human operator's.",{"_3461":571,"_30106":484,"_20907":50885,"_5":14363,"_27392":50625,"_2946":50886},[],"Although the model recognizes the operator name `matches`, the current implementation does not evaluate regular expressions and the condition never matches. Use `equals` or `contains`.",{"_3461":572,"_30106":484,"_20907":50888,"_5":14363,"_27392":50629,"_2946":50889},[],"An X.509 principal lets you recognize a workload or a device by its client certificate. Lamassu checks the certificate signature against the configured CA and, depending on the mode, also its serial number or Common Name.",{"_3461":573,"_30106":484,"_20907":50891,"_5":14363,"_27392":50629,"_2946":50892},[],"The available modes are:",{"_3461":574,"_30106":484,"_20907":50894,"_5":14363,"_27392":50629,"_2946":50895},[],"`serial_and_ca`: an exact certificate, identified by serial number and CA;",{"_3461":575,"_30106":484,"_20907":50897,"_5":14363,"_27392":50629,"_2946":50898},[],"`cn_and_ca`: an exact or wildcard Common Name and a specific CA;",{"_3461":576,"_30106":484,"_20907":50900,"_5":14363,"_27392":50629,"_2946":50901},[],"`any_from_ca`: any certificate issued directly by the given CA.",{"_3461":577,"_30106":484,"_20907":50903,"_5":14363,"_27392":50629,"_2946":50904},[],"This example recognizes certificates whose CN starts with `factory-a-` and that are signed by the configured CA:",{"_3461":578,"_30106":484,"_20907":50906,"_5":14363,"_27392":50629,"_2946":50907},[],"`ca_trust.identity_type` accepts `fingerprint` or `authority_key_id`. In both cases you must provide the CA certificate in `ca_trust.pem`; Lamassu verifies both the signature and the expected identity of the CA.",{"_3461":579,"_30106":484,"_20907":50909,"_5":14363,"_27392":50629,"_2946":50910},[],"Use `any_from_ca` only when every identity issued by that CA should share the same permissions. If a CA issues certificates for different populations, separate access by serial or CN, or use different issuing CAs.",{"_3461":580,"_30106":484,"_20907":50912,"_5":14363,"_27392":50633,"_2946":50913},[],"A single credential can match more than one principal. It is common for a user to match a principal of their team and another of their operational function.",{"_3461":581,"_30106":484,"_20907":50915,"_5":14363,"_27392":50633,"_2946":50916},[],"For entity permissions, Lamassu combines permissions with OR logic: it is enough that one policy of one of the principals allows the action. Listings contain the union of the resources visible to all of them.",{"_3461":582,"_30106":484,"_20907":50918,"_5":14363,"_27392":50633,"_2946":50919},[],"HTTP routes with constraints are stricter. The same principal contributing the policy must also satisfy the attributes required by the route. Lamassu does not combine one principal's policy with an attribute belonging to another.",{"_3461":583,"_30106":484,"_20907":50921,"_5":14363,"_27392":50633,"_2946":50922},[],"For this reason, adding a matching principal can only broaden access. Before creating overlapping rules, review the full set of policies a real identity will receive.",{"_3461":584,"_30106":484,"_20907":50924,"_5":14363,"_27392":50641,"_2946":50925},[],"A rule identifies the domain (`namespace`), the data schema (`schema_name`) and the entity type (`entity_type`). `actions` lists the allowed operations.",{"_3461":585,"_30106":484,"_20907":50927,"_5":14363,"_27392":50641,"_2946":50928},[],"`direct_grants` limits the rule to concrete identifiers. The value `*` covers all instances of the type. A superadministrator policy uses wildcards in schema, entity, actions and grants; a least-privilege policy should avoid them whenever possible.",{"_3461":586,"_30106":484,"_20907":50930,"_5":14363,"_27392":50645,"_2946":50931},[],"Rules can follow relations declared between entities. For example, the schema knows the relation of a certificate to its issuing CA, of a device to its DMS and of a certificate to the KMS key that stores its private key, so a grant on the key also covers the certificates that use it. A policy can grant access to a parent resource and propagate selected actions to its related resources.",{"_3461":587,"_30106":484,"_20907":50933,"_5":14363,"_27392":50645,"_2946":50934},[],"This lets you express models like \"can operate the devices of this DMS\" without maintaining an individual list of every device. When a resource is added under that relation, it inherits the scope planned by the policy.",{"_3461":588,"_30106":484,"_20907":50936,"_5":14363,"_27392":50649,"_2946":50937},[],"`column_filters` applies conditions to columns the schema has declared filterable. All filters of the same rule are combined with AND.",{"_3461":589,"_30106":484,"_20907":50939,"_5":14363,"_27392":50649,"_2946":50940},[],"For example, this rule allows reading active certificates issued by a specific CA:",{"_3461":590,"_30106":484,"_20907":50942,"_5":14363,"_27392":50649,"_2946":50943},[],"The available operators are `eq`, `neq`, `gt`, `gte`, `lt`, `lte`, `in` and `like`. Use comparisons consistent with the column type: `like` for text, ordering comparisons for numbers or dates and `in` when there is a collection of accepted values.",{"_3461":591,"_30106":484,"_20907":50945,"_5":14363,"_27392":50653,"_2946":50946},[],"HTTP rules do not point directly at tables. They reference a route schema and grant its logical actions. Job Manager's policies are an example: they distinguish reading, creating, updating and deleting workflows or jobs.",{"_3461":592,"_30106":484,"_20907":50948,"_5":14363,"_27392":50653,"_2946":50949},[],"Some routes also compare a request value — taken from the path, query, header or JSON body — with a normalized attribute of the principal. This way you can verify that a device only queries jobs addressed to its own `client_id`.",{"_3461":593,"_30106":484,"_20907":50951,"_5":14363,"_27392":50653,"_2946":50952},[],"Normalized attributes decouple the policy from the authentication mechanism. `subject_attribute_mappings` can derive, for example, `device_id` from `oidc.claim.device_id` or from `x509.subject.cn`. The rule consumes `device_id` in both cases.",{"_3461":594,"_30106":484,"_20907":50954,"_5":14363,"_27392":50653,"_2946":50955},[],"An HTTP rule can also pin a granted action to a literal value carried by the request itself through `param_constraints`. It extracts the value with the same sources as route constraints — `path_regex_group`, `query`, `header` or `json_body` — but compares it against an `equals` literal written into the policy rather than against a subject attribute. The grant then depends only on the request, not on who holds the policy:",{"_3461":595,"_30106":484,"_20907":50957,"_5":14363,"_27392":50653,"_2946":50958},[],"Combined with a schema route such as `^/api/mysvc/system/([^/]+)/info$`, this grants `GET /api/mysvc/system/1/info` and denies the same call for system `2`, regardless of the principal's attributes. The same mechanism pins query parameters, headers or JSON body fields, for example `{ \"source\": \"query\", \"name\": \"tenant_id\" }` with `\"equals\": \"1\"` to accept only requests carrying `?tenant_id=1`.",{"_3461":596,"_30106":484,"_20907":50960,"_5":14363,"_27392":50653,"_2946":50961},[],"Note that:",{"_3461":597,"_30106":484,"_20907":50963,"_5":14363,"_27392":50653,"_2946":50964},[],"`action` must be one of the actions granted by the rule; `equals` is required; `path_regex_group` needs an `index` greater than zero, `query` and `header` need a `name`, and `json_body` needs a `path` such as `$.tenant_id`.",{"_3461":598,"_30106":484,"_20907":50966,"_5":14363,"_27392":50653,"_2946":50967},[],"`param_constraints` are not cross-checked against the schema when the policy is loaded. A reference the route cannot satisfy — for instance a `path_regex_group` on a route without capture groups — simply never matches, and the request is denied.",{"_3461":599,"_30106":484,"_20907":50969,"_5":14363,"_27392":50653,"_2946":50970},[],"Several `param_constraints` for the same action combine with AND. A rule without them keeps the usual behavior: the action is granted wherever the route matches and the subject constraints pass.",{"_3461":600,"_30106":484,"_20907":50972,"_5":14363,"_27392":50657,"_2946":50973},[],"The `authz` preload installs reusable policies for the main domains. Among them are:",{"_3461":601,"_30106":484,"_20907":50975,"_5":14363,"_27392":50657,"_2946":50976},[],"full and read-only access to certificates and authorities;",{"_3461":602,"_30106":484,"_20907":50978,"_5":14363,"_27392":50657,"_2946":50979},[],"full and read-only access to the KMS;",{"_3461":603,"_30106":484,"_20907":50981,"_5":14363,"_27392":50657,"_2946":50982},[],"full and read-only access to Device Manager, DMS Manager, Validation Authority and alerts;",{"_3461":604,"_30106":484,"_20907":50984,"_5":14363,"_27392":50657,"_2946":50985},[],"an `Auditor` policy with PKI read access and authorization visibility;",{"_3461":605,"_30106":484,"_20907":50987,"_5":14363,"_27392":50657,"_2946":50988},[],"console access;",{"_3461":606,"_30106":484,"_20907":50990,"_5":14363,"_27392":50657,"_2946":50991},[],"administration and observation policies for the Job Manager NBI and SBI APIs;",{"_3461":607,"_30106":484,"_20907":50993,"_5":14363,"_27392":50657,"_2946":50994},[],"`SUPER ADMIN`, which grants all actions over the `authz` and `pki` domains.",{"_3461":608,"_30106":484,"_20907":50996,"_5":14363,"_27392":50657,"_2946":50997},[],"Start with these policies before creating others. If none reflects the boundary you need, create a specific, small policy instead of copying `SUPER ADMIN` and informally removing permissions.",{"_3461":609,"_30106":484,"_20907":50999,"_5":14363,"_27392":50661,"_2946":51000},[],"An installation without a principal matching your identity is left with nobody able to administer authorization. Configure the IdP and the bootstrap before exposing the platform.",{"_3461":610,"_30106":484,"_20907":51002,"_5":14363,"_27392":50661,"_2946":51003},[],"The chart includes a bootstrap principal that looks for the OIDC role `pki-admin` in `realm_access.roles`. It grants it `SUPER ADMIN` and, when Job Manager is enabled, the administrative policy of its NBI API.",{"_3461":611,"_30106":484,"_20907":51005,"_5":14363,"_27392":50661,"_2946":51006},[],"The pre-install and pre-upgrade Helm Job runs the `authz` migrations, preloads the policies and creates the bootstrap principals before the services start. If the principal already exists, it does not replace it: it only adds the configured grants that are still missing. You can keep the entry in `values.yaml` across upgrades.",{"_3461":612,"_30106":484,"_20907":51008,"_5":14363,"_27392":50664,"_2946":51009},[],"Create the role or group you will use to administer Lamassu. Assign it to at least two controlled human identities. If your provider does not use `realm_access.roles`, adapt the claim path in both the frontend and `auth_config.claims`.",{"_3461":613,"_30106":484,"_20907":51011,"_5":14363,"_27392":50668,"_2946":51012},[],"`authz` validates every token against `services.authz.jwkUrl`, which is fetched from the `authz` pod. The Gateway does not validate tokens itself: Lamassu services authorize each request through `authz`, and routes labeled `auth=external`, such as the Job Manager ones, are checked by the Gateway through `authz` when `auth.externalAuthorization` is enabled. The endpoint must serve the keys of the issuer configured in `auth.oidc.frontend.authority`.",{"_3461":614,"_30106":484,"_20907":51014,"_5":14363,"_27392":50668,"_2946":51015},[],"Releases upgraded from 3.8.0 must remove `auth.oidc.apiGateway` and `auth.authorization`, which the 4.0.0 chart rejects. See 3.8.0 to 4.0.0.",{"_3461":615,"_30106":484,"_20907":51017,"_5":14363,"_27392":50672,"_2946":51018},[],"Sign in with an identity holding `pki-admin`. Confirm it can access authorization administration and perform a non-destructive read operation.",{"_3461":616,"_30106":484,"_20907":51020,"_5":14363,"_27392":50676,"_2946":51021},[],"Use a second user without the role and confirm the same operation is denied. This test catches misread claims, overly broad policies and accidental `failOpen` configurations.",{"_3461":617,"_30106":484,"_20907":51023,"_5":14363,"_27392":50680,"_2946":51024},[],"Create operational principals with narrower policies. Reserve `pki-admin` for authorization administration and recovery, not for daily work.",{"_3461":618,"_30106":484,"_20907":51026,"_5":14363,"_27392":50684,"_2946":51027},[],"Fastlane installs a Keycloak realm for the lab and creates the user `lamassu` with the temporary password `lamassu`, the role `pki-admin` and a mandatory password change. Its bootstrap principal matches through `preferred_username=lamassu`.",{"_3461":619,"_30106":484,"_20907":51029,"_5":14363,"_27392":50684,"_2946":51030},[],"Change the password on first login. Do not reuse the Fastlane user, password or IdP as a production design.",{"_3461":620,"_30106":484,"_20907":51032,"_5":14363,"_27392":50688,"_2946":51033},[],"Avoid reproducing your company's internal structure with dozens of nearly identical policies. Start from the responsibilities that actually need access:",{"_3461":621,"_30106":484,"_20907":51035,"_5":14363,"_27392":50688,"_2946":51036},[],"**Authorization administration**: manages principals, policies and grants. It should belong to a small, separate group.",{"_3461":622,"_30106":484,"_20907":51038,"_5":14363,"_27392":50688,"_2946":51039},[],"**PKI operation**: administers CAs, profiles and certificates, but not necessarily who gets access.",{"_3461":623,"_30106":484,"_20907":51041,"_5":14363,"_27392":50688,"_2946":51042},[],"**Device registration**: operates devices and DMSs without receiving permissions over keys or authorization configuration.",{"_3461":624,"_30106":484,"_20907":51044,"_5":14363,"_27392":50688,"_2946":51045},[],"**Audit**: reviews configuration and activity without creating, modifying, signing, revoking or deleting.",{"_3461":625,"_30106":484,"_20907":51047,"_5":14363,"_27392":50688,"_2946":51048},[],"**Automation**: uses a technical account or a separate certificate, with permissions limited to the flow and resources it controls.",{"_3461":626,"_30106":484,"_20907":51050,"_5":14363,"_27392":50688,"_2946":51051},[],"For each role, separate \"view\" from \"change\", limit resources through grants, relations or attributes and avoid `*` unless the role must automatically cover future actions.",{"_3461":627,"_30106":484,"_20907":51053,"_5":14363,"_27392":50688,"_2946":51054},[],"A rule with `actions: [\"*\"]` expands to every action defined by the schema. When a new version adds an action, a wildcard policy may start granting it. Review these policies on every upgrade.",{"_3461":628,"_30106":484,"_20907":51056,"_5":14363,"_27392":50692,"_2946":51057},[],"To revoke access immediately, disable the principal or revoke its grants. Disabling a principal keeps its configuration and associations for investigation or restoration, but it stops taking part in matching.",{"_3461":629,"_30106":484,"_20907":51059,"_5":14363,"_27392":50692,"_2946":51060},[],"Deleting a role or group in the IdP prevents new tokens from containing the claim, but an already-issued token may remain valid until it expires. If removal is urgent, combine the IdP change with disabling the principal in Lamassu and revoking sessions or tokens at the provider.",{"_3461":630,"_30106":484,"_20907":51062,"_5":14363,"_27392":50692,"_2946":51063},[],"When you edit a shared policy, remember the change affects all its principals. To test a new scope, create a separate policy, grant it to a test identity and validate allowed and denied operations before replacing the old one.",{"_3461":631,"_30106":484,"_20907":51065,"_5":14363,"_27392":50696,"_2946":51066},[],"Keep `failOpen: false` unless a documented risk assessment justifies otherwise.",{"_3461":632,"_30106":484,"_20907":51068,"_5":14363,"_27392":50696,"_2946":51069},[],"Use groups or stable roles for people and independent identities for automations.",{"_3461":633,"_30106":484,"_20907":51071,"_5":14363,"_27392":50696,"_2946":51072},[],"Keep at least two recovery administrators and test their access periodically.",{"_3461":634,"_30106":484,"_20907":51074,"_5":14363,"_27392":50696,"_2946":51075},[],"Review active principals, their matches and their grants after IdP changes.",{"_3461":635,"_30106":484,"_20907":51077,"_5":14363,"_27392":50696,"_2946":51078},[],"Search for wildcards in policies before upgrading Lamassu.",{"_3461":636,"_30106":484,"_20907":51080,"_5":14363,"_27392":50696,"_2946":51081},[],"Review `skip_authz` routes and `default_action` settings in HTTP schemas when integrating or upgrading a service.",{"_3461":637,"_30106":484,"_20907":51083,"_5":14363,"_27392":50696,"_2946":51084},[],"Always test one allowed and one denied operation for each role.",{"_3461":638,"_30106":484,"_20907":51086,"_5":14363,"_27392":50696,"_2946":51087},[],"Correlate changes to principals, policies and grants with the audit logs.",{"_3461":639,"_30106":484,"_20907":51089,"_5":14363,"_27392":50704,"_2946":51090},[],"Authentication failed before permissions were evaluated. Check the JWT signature and expiration, issuer, audience and the availability of the JWKS configured in the Gateway. For X.509, check that the client certificate reaches the point that extracts the credential.",{"_3461":640,"_30106":484,"_20907":51092,"_5":14363,"_27392":50708,"_2946":51093},[],"The credential could be processed but did not produce a positive authorization. Review in this order:",{"_3461":641,"_30106":484,"_20907":51095,"_5":14363,"_27392":50708,"_2946":51096},[],"that an active principal of the correct type exists;",{"_3461":642,"_30106":484,"_20907":51098,"_5":14363,"_27392":50708,"_2946":51099},[],"that the claim paths and values match the real token exactly;",{"_3461":643,"_30106":484,"_20907":51101,"_5":14363,"_27392":50708,"_2946":51102},[],"that all of the principal's conditions hold;",{"_3461":644,"_30106":484,"_20907":51104,"_5":14363,"_27392":50708,"_2946":51105},[],"that the principal has the expected policy granted;",{"_3461":645,"_30106":484,"_20907":51107,"_5":14363,"_27392":50708,"_2946":51108},[],"that the policy includes the action and the requested resource type or route;",{"_3461":646,"_30106":484,"_20907":51110,"_5":14363,"_27392":50708,"_2946":51111},[],"that the identifier, relation, column filter or HTTP constraint includes the real resource.",{"_3461":647,"_30106":484,"_20907":51113,"_5":14363,"_27392":50708,"_2946":51114},[],"In the `authz` logs, an external endpoint decision includes `allowed`, `reason`, `matched_principals`, `evaluated_policy_ids`, `matched_policy_id` and the status code. These fields let you separate a matching failure from a permissions failure. With OpenTelemetry tracing enabled, a request that reaches the policy engine produces an `engine.CheckHTTPRequest` span whose attributes record `authz.allowed`, the matched policy and the matched principal. Correlation with the Gateway trace requires trace context to be propagated to authz.",{"_3461":648,"_30106":484,"_20907":51116,"_5":14363,"_27392":50712,"_2946":51117},[],"Check that the bootstrap principal was created and that the policies were preloaded by the migration Job. Also verify that `services.authz.jwkUrl` is reachable from the `authz` pod; do not assume that a URL accessible from the browser also works inside the cluster.",{"_3461":649,"_30106":484,"_20907":51119,"_5":14363,"_27392":50716,"_2946":51120},[],"The path may be covered by a schema-level decision rather than by a policy: routes marked `skip_authz` allow any identity that matches an active principal, and a request under a `base_paths` prefix whose schema sets `default_action: allow` is likewise allowed without consulting policies. Confirm which of the two applies before looking for missing or misassigned grants.",{"_3461":650,"_30106":484,"_20907":51122,"_5":14363,"_27392":50720,"_2946":51123},[],"This is the expected behavior with `failOpen: false`. Restore the service, its PostgreSQL connection and its JWKS connectivity. Do not temporarily switch to `failOpen: true` without accepting that protected routes could become accessible without an authorization decision.",{"_3461":651,"_30106":484,"_20907":51125,"_5":14363,"_27392":50720,"_2946":51126},[],"Continue with Audit logs to investigate configuration changes or with Troubleshooting to diagnose the deployment.",{"_3461":652,"_30106":652,"_5":14715,"_2946":51128,"_30438":51129,"_20907":51130,"_27392":652},"Alerts and subscriptions",[49125,50593,50594],[],{"_3461":653,"_30106":652,"_20907":51132,"_5":14363,"_27392":652,"_2946":51133},[],"Send PKI events to people and external systems.",{"_3461":654,"_30106":652,"_5":30435,"_20907":51135,"_27392":51136,"_2946":51137},[],"/docs/platform/administration/alerts#how-it-works","How it works",{"_3461":655,"_30106":652,"_5":30435,"_20907":51139,"_27392":51140,"_2946":51141},[],"/docs/platform/administration/alerts#available-channels","Available channels",{"_3461":656,"_30106":652,"_5":30435,"_20907":51143,"_27392":51144,"_2946":51145},[],"/docs/platform/administration/alerts#create-a-subscription","Create a subscription",{"_3461":657,"_30106":652,"_5":30435,"_20907":51147,"_27392":51148,"_2946":51149},[],"/docs/platform/administration/alerts#choose-the-event","Choose the event",{"_3461":658,"_30106":652,"_5":30435,"_20907":51151,"_27392":51152,"_2946":51153},[],"/docs/platform/administration/alerts#configure-the-destination","Configure the destination",{"_3461":659,"_30106":652,"_5":30435,"_20907":51155,"_27392":51156,"_2946":51157},[],"/docs/platform/administration/alerts#limit-the-notifications","Limit the notifications",{"_3461":660,"_30106":652,"_5":30435,"_20907":51159,"_27392":51160,"_2946":51161},[],"/docs/platform/administration/alerts#review-and-activate","Review and activate",{"_3461":661,"_30106":652,"_5":30435,"_20907":51163,"_27392":51164,"_2946":51165},[],"/docs/platform/administration/alerts#configure-the-webhook-http-client","Configure the webhook HTTP client",{"_3461":662,"_30106":652,"_5":30435,"_20907":51167,"_27392":51168,"_2946":51169},[],"/docs/platform/administration/alerts#webhook-delivery-rules","Webhook delivery rules",{"_3461":663,"_30106":652,"_5":30435,"_20907":51171,"_27392":51172,"_2946":51173},[],"/docs/platform/administration/alerts#manage-a-subscription","Manage a subscription",{"_3461":664,"_30106":652,"_5":30435,"_20907":51175,"_27392":51176,"_2946":51177},[],"/docs/platform/administration/alerts#event-families","Event families",{"_3461":665,"_30106":652,"_20907":51179,"_5":14363,"_27392":652,"_2946":51180},[],"Subscriptions turn Lamassu events into actionable notifications. You can alert a team, feed an incident system or trigger an automation when a CA, certificate or device changes.",{"_3461":666,"_30106":652,"_20907":51182,"_5":14363,"_27392":51136,"_2946":51183},[],"A service publishes a domain event.",{"_3461":667,"_30106":652,"_20907":51185,"_5":14363,"_27392":51136,"_2946":51186},[],"Lamassu evaluates the subscriptions associated with that event type.",{"_3461":668,"_30106":652,"_20907":51188,"_5":14363,"_27392":51136,"_2946":51189},[],"Each subscription's filter decides whether it should be notified.",{"_3461":669,"_30106":652,"_20907":51191,"_5":14363,"_27392":51136,"_2946":51192},[],"Lamassu delivers the event to the configured channel.",{"_3461":670,"_30106":652,"_20907":51194,"_5":14363,"_27392":51136,"_2946":51195},[],"The event inventory shows when each type was last observed, how many times it has occurred and how many subscriptions it has. You can expand an event to inspect an example of its JSON payload before creating the filter.",{"_3461":671,"_30106":652,"_20907":51197,"_5":14363,"_27392":51140,"_2946":51198},[],"**Email** sends alerts to a person or an operational list. It only requires the destination address. Event content is rendered as HTML-escaped text, never as markup.",{"_3461":672,"_30106":652,"_20907":51200,"_5":14363,"_27392":51140,"_2946":51201},[],"**Microsoft Teams** posts the notification to a channel through its webhook URL.",{"_3461":673,"_30106":652,"_20907":51203,"_5":14363,"_27392":51140,"_2946":51204},[],"**Webhook** delivers the event to an automation, SIEM or incident system via `POST` or `PUT`.",{"_3461":674,"_30106":652,"_20907":51206,"_5":14363,"_27392":51140,"_2946":51207},[],"The Microsoft Teams and Webhook channels accept an optional `http_client` block that authenticates the call to the receiver. `auth_mode` selects `noauth` (the default), `apikey`, `jwt` or `mtls`; each mode requires its own options:",{"_3461":675,"_30106":652,"_20907":51209,"_5":14363,"_27392":51140,"_2946":51210},[],"`apikey_options` requires `header` and `key`.",{"_3461":676,"_30106":652,"_20907":51212,"_5":14363,"_27392":51140,"_2946":51213},[],"`jwt_options` requires `oidc_client_id`, `oidc_client_secret` and an absolute `http` or `https` `oidc_well_known`.",{"_3461":677,"_30106":652,"_20907":51215,"_5":14363,"_27392":51140,"_2946":51216},[],"`mtls_options` requires `cert_content` and `key_content` as Base64-encoded PEM, like certificates elsewhere in the API; plain PEM is also accepted. Values that reference files on the server are rejected, and the pair must decode to a matching certificate and private key.",{"_3461":678,"_30106":652,"_20907":51218,"_5":14363,"_27392":51140,"_2946":51219},[],"The alerts API reference documents the full `http_client` schema.",{"_3461":679,"_30106":652,"_20907":51221,"_5":14363,"_27392":51148,"_2946":51222},[],"Open **Alerts**, locate the event type and select **Subscribe**. Review the latest JSON example to identify the fields you will need to filter on.",{"_3461":680,"_30106":652,"_20907":51224,"_5":14363,"_27392":51152,"_2946":51225},[],"Select Email, Microsoft Teams or Webhook and enter the channel details.",{"_3461":681,"_30106":652,"_20907":51227,"_5":14363,"_27392":51156,"_2946":51228},[],"Add a filter if you don't want to receive every instance of the event.",{"_3461":682,"_30106":652,"_20907":51230,"_5":14363,"_27392":51156,"_2946":51231},[],"**None** notifies all instances of the event.",{"_3461":683,"_30106":652,"_20907":51233,"_5":14363,"_27392":51156,"_2946":51234},[],"**JSON Path** evaluates one or more specific fields.",{"_3461":684,"_30106":652,"_20907":51236,"_5":14363,"_27392":51156,"_2946":51237},[],"**JSON Schema** accepts only payloads with a particular structure.",{"_3461":685,"_30106":652,"_20907":51239,"_5":14363,"_27392":51156,"_2946":51240},[],"**JavaScript** lets you express custom logic. Each filter runs for at most 100 milliseconds; a filter that exceeds this limit fails the condition and the notification is skipped with the error `javascript filter execution timed out`.",{"_3461":686,"_30106":652,"_20907":51242,"_5":14363,"_27392":51156,"_2946":51243},[],"For example, `function (event) { return event.data.status == \"NO_IDENTITY\"; }` limits a subscription to devices without an identity.",{"_3461":687,"_30106":652,"_20907":51245,"_5":14363,"_27392":51156,"_2946":51246},[],"The console evaluates the filter against the JSON shown in the **Input Event** editor, which is prefilled with the latest event, and reports whether it matches. For JSON Path and JavaScript filters, it shows **The filter matches this Cloud Event** or **The filter does not match this Cloud Event**. JSON Path expressions are evaluated against the full Cloud Event, so the default `$.data` selects the event's `data` field, and the expression must start with `$`.",{"_3461":688,"_30106":652,"_20907":51248,"_5":14363,"_27392":51160,"_2946":51249},[],"Check the event, channel and filter in the summary. Select **Confirm Subscription** to start delivery.",{"_3461":689,"_30106":652,"_20907":51251,"_5":14363,"_27392":51164,"_2946":51252},[],"The Webhook and Microsoft Teams channels show this configuration in the subscribe form, at the channel step, and again when editing a subscription; Email does not use it. The fields map to the optional `http_client` block described above:",{"_3461":690,"_30106":652,"_20907":51254,"_5":14363,"_27392":51164,"_2946":51255},[],"**Log Level** selects `debug`, `info`, `warn` or `error`; `info` is the default.",{"_3461":691,"_30106":652,"_20907":51257,"_5":14363,"_27392":51164,"_2946":51258},[],"**Call Timeout** defaults to 10 seconds. The console rejects a value above 30 seconds with `Webhook timeout must be at most 30s.`; the API clamps the same value to the cap instead (see Calls are bounded).",{"_3461":692,"_30106":652,"_20907":51260,"_5":14363,"_27392":51164,"_2946":51261},[],"There is no TLS-verification switch for these channels, because the service always verifies the receiver certificate (see TLS is always verified).",{"_3461":693,"_30106":652,"_20907":51263,"_5":14363,"_27392":51164,"_2946":51264},[],"**HTTP Authentication** selects `No Authentication` (the default), `API Key` (API key value and Header Name, `X-API-Key` by default), `OIDC Client Credentials` (Client ID, Client Secret and Well-Known URL) or `Mutual TLS` (Client Certificate and Client Private Key pasted as PEM). A stored private key stays hidden until you select **Show**.",{"_3461":694,"_30106":652,"_20907":51266,"_5":14363,"_27392":51164,"_2946":51267},[],"A `http://` URL shows the console warning `Unencrypted HTTP connection` (see the Credentials over http\\:// callout below).",{"_3461":695,"_30106":652,"_20907":51269,"_5":14363,"_27392":51164,"_2946":51270},[],"The form validates inline against the same delivery rules: the webhook URL and the OIDC Well-Known URL must be absolute `http` or `https` URLs, an API-key header may not use a reserved name, and the mTLS certificate and key must be PEM content, not file paths.",{"_3461":696,"_30106":652,"_20907":51272,"_5":14363,"_27392":51164,"_2946":51273},[],"The summary in the Confirm step shows the authentication as `None`, `OIDC client credentials`, `API key` or `Mutual TLS`. The subscription details show the authentication, the API key header name (never the value), the OIDC issuer URL, mTLS as `Configured` and a fixed `TLS verification: Verified` row. The API key, client secret and private key are not shown in the subscription details.",{"_3461":697,"_30106":652,"_20907":51275,"_5":14363,"_27392":51168,"_2946":51276},[],"Notifications delivered through the Microsoft Teams and Webhook channels follow a fixed HTTP policy:",{"_3461":698,"_30106":652,"_20907":51278,"_5":14363,"_27392":51168,"_2946":51279},[],"**TLS is always verified.** The receiver certificate is checked against the system trust store. `insecure_skip_verify` is enforced as `false` — including when it is set to `true` — so self-signed or otherwise untrusted receivers fail delivery.",{"_3461":699,"_30106":652,"_20907":51281,"_5":14363,"_27392":51168,"_2946":51282},[],"**Redirects are not followed.** A `3xx` response fails with `unexpected status code: <n>: redirects are not followed`. Configure `webhook_url` with the final absolute `http` or `https` URL: an `http://` address that an ingress redirects to `https://` stops working.",{"_3461":700,"_30106":652,"_20907":51284,"_5":14363,"_27392":51168,"_2946":51285},[],"**Calls are bounded.** A call defaults to a 10 second timeout; a configured `call_timeout` is capped at 30 seconds. Values above the cap are clamped, not rejected.",{"_3461":701,"_30106":652,"_20907":51287,"_5":14363,"_27392":51168,"_2946":51288},[],"**The response body is ignored.** Delivery checks the status code only, so the receiver may answer with any body.",{"_3461":702,"_30106":652,"_20907":51290,"_5":14363,"_27392":51168,"_2946":51291},[],"**API-key headers are restricted.** A custom `apikey_options.header` may not use names that the platform or receiving services trust — for example `X-Principal-Id`, `X-Request-Id`, `Host`, `Content-Type` or `Forwarded` — and no name may start with `X-Forwarded-`, `X-Envoy-` or `X-Lms-`. Comparisons are case-insensitive.",{"_3461":703,"_30106":652,"_20907":51293,"_5":14363,"_27392":51168,"_2946":51294},[],"**Invalid configurations are rejected at subscribe time.** A channel configuration that would fail on every delivery returns HTTP 400 with a body that starts with `struct validation error:`, and the subscription is not created.",{"_3461":704,"_30106":652,"_20907":51296,"_5":14363,"_27392":51168,"_2946":51297},[],"Credentials are sent regardless of the URL scheme. With an `http://` `webhook_url`, the API key or bearer token travels in cleartext and mTLS has no effect. Prefer `https://` for `webhook_url`, `oidc_well_known` and the token endpoint it advertises.",{"_3461":705,"_30106":652,"_20907":51299,"_5":14363,"_27392":51172,"_2946":51300},[],"Open an existing subscription to review its destination and filter, modify the configuration or select **Unsubscribe**. Remove subscriptions that no longer have an operational owner to avoid ignored deliveries or stale endpoints.",{"_3461":706,"_30106":652,"_20907":51302,"_5":14363,"_27392":51172,"_2946":51303},[],"Subscriptions created with older console versions may store the webhook target under `url` and `method` instead of `webhook_url` and `webhook_method`. The service delivers only through `webhook_url` and `webhook_method`, so such a subscription does not deliver even though the subscription details show the stored target. Open the subscription and save it again: the edit form prefills the stored target, and saving rewrites the channel configuration in the current layout.",{"_3461":707,"_30106":652,"_20907":51305,"_5":14363,"_27392":51176,"_2946":51306},[],"**Authorities:** `ca.create`, `ca.import`, `ca.reissue` and `ca.delete`.",{"_3461":708,"_30106":652,"_20907":51308,"_5":14363,"_27392":51176,"_2946":51309},[],"**Certificates:** `ca.sign.certificate` and `certificate.delete`.",{"_3461":709,"_30106":652,"_20907":51311,"_5":14363,"_27392":51176,"_2946":51312},[],"**Profiles:** `profile.issuance.create`, `profile.issuance.update` and `profile.issuance.delete`.",{"_3461":710,"_30106":652,"_20907":51314,"_5":14363,"_27392":51176,"_2946":51315},[],"**Enrollment:** `dms.create`, `dms.update`, `dms.enroll` and `dms.reenroll`.",{"_3461":711,"_30106":652,"_20907":51317,"_5":14363,"_27392":51176,"_2946":51318},[],"**Devices:** `device.create`, `device.identity.update` and `device.status.update`.",{"_3461":712,"_30106":652,"_20907":51320,"_5":14363,"_27392":51176,"_2946":51321},[],"**Validation:** `va.role.crl.create`, `va.crl-settings.init` and `va.crl-settings.update`.",{"_3461":713,"_30106":652,"_20907":51323,"_5":14363,"_27392":51176,"_2946":51324},[],"**Keys:** `kms.create`, `kms.import`, `kms.sign` and `kms.delete`.",{"_3461":714,"_30106":652,"_20907":51326,"_5":14363,"_27392":51176,"_2946":51327},[],"Use the catalog shown in the console as the source for the types available in your deployed version.",{"_3461":715,"_30106":652,"_20907":51329,"_5":14363,"_27392":51176,"_2946":51330},[],"Since 4.0.0, `va.crl-settings.init` and `va.crl-settings.update` carry the CRL settings of a CA (`ca_id`) and replace `va.role.crl.init` and `va.role.update`. The upgrade migration renames the types of existing subscriptions automatically, but it does not rewrite their conditions: review filters that read the old payload or the old `crl/<ski>` subject, including filters for `va.role.crl.create` (see 3.8.0 to 4.0.0).",{"_3461":716,"_30106":716,"_5":14715,"_2946":51332,"_30438":51333,"_20907":51334,"_27392":716},"Audit logs",[49125,50593,50594],[],{"_3461":717,"_30106":716,"_20907":51336,"_5":14363,"_27392":716,"_2946":51337},[],"Understand which audit events Lamassu generates and how to turn them into a durable trail.",{"_3461":718,"_30106":716,"_5":30435,"_20907":51339,"_27392":51340,"_2946":51341},[],"/docs/platform/administration/audit-logs#what-an-event-contains","What an event contains",{"_3461":719,"_30106":716,"_5":30435,"_20907":51343,"_27392":51344,"_2946":51345},[],"/docs/platform/administration/audit-logs#coverage","Coverage",{"_3461":720,"_30106":716,"_5":30435,"_20907":51347,"_27392":51348,"_2946":51349},[],"/docs/platform/administration/audit-logs#publication-and-persistence","Publication and persistence",{"_3461":721,"_30106":716,"_5":30435,"_20907":51351,"_27392":51352,"_2946":51353},[],"/docs/platform/administration/audit-logs#sensitive-data","Sensitive data",{"_3461":722,"_30106":716,"_5":30435,"_20907":51355,"_27392":51356,"_2946":51357},[],"/docs/platform/administration/audit-logs#a-reproducible-investigation","A reproducible investigation",{"_3461":723,"_30106":716,"_5":30435,"_20907":51359,"_27392":51360,"_2946":51361},[],"/docs/platform/administration/audit-logs#bound-the-interval","Bound the interval",{"_3461":724,"_30106":716,"_5":30435,"_20907":51363,"_27392":51364,"_2946":51365},[],"/docs/platform/administration/audit-logs#identify-the-operation","Identify the operation",{"_3461":725,"_30106":716,"_5":30435,"_20907":51367,"_27392":51368,"_2946":51369},[],"/docs/platform/administration/audit-logs#attribute-the-principal","Attribute the principal",{"_3461":726,"_30106":716,"_5":30435,"_20907":51371,"_27392":51372,"_2946":51373},[],"/docs/platform/administration/audit-logs#compare-intent-and-result","Compare intent and result",{"_3461":727,"_30106":716,"_5":30435,"_20907":51375,"_27392":51376,"_2946":51377},[],"/docs/platform/administration/audit-logs#follow-the-effect","Follow the effect",{"_3461":728,"_30106":716,"_5":30435,"_20907":51379,"_27392":51380,"_2946":51381},[],"/docs/platform/administration/audit-logs#periodic-verification","Periodic verification",{"_3461":729,"_30106":716,"_20907":51383,"_5":14363,"_27392":716,"_2946":51384},[],"Lamassu instruments the mutable operations of its services with audit events. Each event describes the operation, the principals that matched, the input, the result and whether it ended in error.",{"_3461":730,"_30106":716,"_20907":51386,"_5":14363,"_27392":51340,"_2946":51387},[],"The audit body includes:",{"_3461":731,"_30106":716,"_20907":51389,"_5":14363,"_27392":51340,"_2946":51390},[],"input: data received by the operation;",{"_3461":732,"_30106":716,"_20907":51392,"_5":14363,"_27392":51340,"_2946":51393},[],"has\\_error: whether the service returned an error;",{"_3461":733,"_30106":716,"_20907":51395,"_5":14363,"_27392":51340,"_2946":51396},[],"output: produced result or error message;",{"_3461":734,"_30106":716,"_20907":51398,"_5":14363,"_27392":51340,"_2946":51399},[],"principals: identifiers of the principals that matched the request.",{"_3461":735,"_30106":716,"_20907":51401,"_5":14363,"_27392":51340,"_2946":51402},[],"Successful operations use a type prefixed with audit.. Failures publish the operation type suffixed with .error. The CloudEvents event additionally adds source, identifier, date and type.",{"_3461":736,"_30106":716,"_20907":51404,"_5":14363,"_27392":51340,"_2946":51405},[],"The middlewares publish the record after executing the operation, whether it succeeded or returned an error. This lets you investigate attempts as well as confirmed changes.",{"_3461":737,"_30106":716,"_20907":51407,"_5":14363,"_27392":51344,"_2946":51408},[],"The backend applies auditing to mutations of:",{"_3461":738,"_30106":716,"_20907":51410,"_5":14363,"_27392":51344,"_2946":51411},[],"authorities, certificates and issuance profiles;",{"_3461":739,"_30106":716,"_20907":51413,"_5":14363,"_27392":51344,"_2946":51414},[],"keys and KMS engines;",{"_3461":740,"_30106":716,"_20907":51416,"_5":14363,"_27392":51344,"_2946":51417},[],"devices and identities;",{"_3461":741,"_30106":716,"_20907":51419,"_5":14363,"_27392":51344,"_2946":51420},[],"DMSs and enrollment operations;",{"_3461":742,"_30106":716,"_20907":51422,"_5":14363,"_27392":51344,"_2946":51423},[],"validation functions and CRL;",{"_3461":743,"_30106":716,"_20907":51425,"_5":14363,"_27392":51344,"_2946":51426},[],"principals, policies and authorization grants.",{"_3461":744,"_30106":716,"_20907":51428,"_5":14363,"_27392":51344,"_2946":51429},[],"Do not confuse these events with domain events. A domain event announces that a resource changed so another component can react; the audit event keeps input, output and principal context for investigation.",{"_3461":745,"_30106":716,"_20907":51431,"_5":14363,"_27392":51348,"_2946":51432},[],"Services publish audit records to the event bus when their PublisherEventBus is enabled. The backend code does not, by itself, implement a queryable, durable audit file.",{"_3461":746,"_30106":716,"_20907":51434,"_5":14363,"_27392":51348,"_2946":51435},[],"If you need retention, search, tamper protection or regulatory export, connect a consumer that persists the events into the system approved by your organization.",{"_3461":747,"_30106":716,"_20907":51437,"_5":14363,"_27392":51348,"_2946":51438},[],"Design the consumer to:",{"_3461":748,"_30106":716,"_20907":51440,"_5":14363,"_27392":51348,"_2946":51441},[],"subscribe to the audit.# types and also to operation types ending in .error;",{"_3461":749,"_30106":716,"_20907":51443,"_5":14363,"_27392":51348,"_2946":51444},[],"keep the complete CloudEvent unmodified;",{"_3461":750,"_30106":716,"_20907":51446,"_5":14363,"_27392":51348,"_2946":51447},[],"record the ingestion time and detect duplicates by ID;",{"_3461":751,"_30106":716,"_20907":51449,"_5":14363,"_27392":51348,"_2946":51450},[],"encrypt in transit and at rest;",{"_3461":752,"_30106":716,"_20907":51452,"_5":14363,"_27392":51348,"_2946":51453},[],"restrict reading and deletion to a role separate from the PKI operator;",{"_3461":753,"_30106":716,"_20907":51455,"_5":14363,"_27392":51348,"_2946":51456},[],"apply an explicit retention and legal hold policy;",{"_3461":754,"_30106":716,"_20907":51458,"_5":14363,"_27392":51348,"_2946":51459},[],"alert if it stops consuming or the pending queue grows.",{"_3461":755,"_30106":716,"_20907":51461,"_5":14363,"_27392":51352,"_2946":51462},[],"The input and output fields can contain subjects, metadata, public material, configuration or error messages. Evaluate their classification before sending them to an external platform.",{"_3461":756,"_30106":716,"_20907":51464,"_5":14363,"_27392":51352,"_2946":51465},[],"Do not log private keys, provider secrets or full tokens in automations around Lamassu. Restrict export and apply redaction at the destination without destroying the fields needed for attribution.",{"_3461":757,"_30106":716,"_20907":51467,"_5":14363,"_27392":51360,"_2946":51468},[],"Start from the reported time and normalize every source to UTC.",{"_3461":758,"_30106":716,"_20907":51470,"_5":14363,"_27392":51364,"_2946":51471},[],"Filter by event type, service source and resource identifier.",{"_3461":759,"_30106":716,"_20907":51473,"_5":14363,"_27392":51368,"_2946":51474},[],"Review principals and correlate them with the OIDC provider or the X.509 identity valid at that moment.",{"_3461":760,"_30106":716,"_20907":51476,"_5":14363,"_27392":51372,"_2946":51477},[],"Contrast input, has\\_error and output. A failed attempt does not mean the resource changed.",{"_3461":761,"_30106":716,"_20907":51479,"_5":14363,"_27392":51376,"_2946":51480},[],"Look for the domain events and service records that share resource and time window. In a CA revocation, include the cascading operations.",{"_3461":762,"_30106":716,"_20907":51482,"_5":14363,"_27392":51380,"_2946":51483},[],"Generate a controlled mutation in a test environment and check that:",{"_3461":763,"_30106":716,"_20907":51485,"_5":14363,"_27392":51380,"_2946":51486},[],"a successful audit event appears;",{"_3461":764,"_30106":716,"_20907":51488,"_5":14363,"_27392":51380,"_2946":51489},[],"the principal matches the identity used;",{"_3461":765,"_30106":716,"_20907":51491,"_5":14363,"_27392":51380,"_2946":51492},[],"the consumer persists it exactly once;",{"_3461":766,"_30106":716,"_20907":51494,"_5":14363,"_27392":51380,"_2946":51495},[],"it can be retrieved by resource, actor and period;",{"_3461":767,"_30106":716,"_20907":51497,"_5":14363,"_27392":51380,"_2946":51498},[],"a consumer outage raises an alert.",{"_3461":768,"_30106":716,"_20907":51500,"_5":14363,"_27392":51380,"_2946":51501},[],"For metrics, traces and technical logs of the deployment, see Troubleshooting. Audit answers \"who tried to change what\"; observability explains how the system behaved.",{"_3461":769,"_30106":769,"_5":14715,"_2946":51503,"_30438":51504,"_20907":51505,"_27392":769},"Platform architecture",[49125,50593],[],{"_3461":770,"_30106":769,"_20907":51507,"_5":14363,"_27392":769,"_2946":51508},[],"Lamassu components and how control, keys, issuance and devices relate.",{"_3461":771,"_30106":769,"_5":30435,"_20907":51510,"_27392":51511,"_2946":51512},[],"/docs/platform/concepts/architecture#control-plane","Control plane",{"_3461":772,"_30106":769,"_5":30435,"_20907":51514,"_27392":51515,"_2946":51516},[],"/docs/platform/concepts/architecture#key-custody-and-cryptographic-operations","Key custody and cryptographic operations",{"_3461":773,"_30106":769,"_5":30435,"_20907":51518,"_27392":51519,"_2946":51520},[],"/docs/platform/concepts/architecture#issuance-and-enrollment","Issuance and enrollment",{"_3461":774,"_30106":769,"_5":30435,"_20907":51522,"_27392":51523,"_2946":51524},[],"/docs/platform/concepts/architecture#status-and-validation","Status and validation",{"_3461":775,"_30106":769,"_5":30435,"_20907":51526,"_27392":51527,"_2946":51528},[],"/docs/platform/concepts/architecture#platform-dependencies","Platform dependencies",{"_3461":776,"_30106":769,"_20907":51530,"_5":14363,"_27392":769,"_2946":51531},[],"Lamassu deploys as a set of independent services. This separation keeps every component from needing direct access to private keys and lets each capability scale according to load.",{"_3461":777,"_30106":769,"_20907":51533,"_5":14363,"_27392":769,"_2946":51534},[],"Switch to the low level to see the internals of the Lamassu platform box (CA, KMS, DMS, Device Manager, VA, Alerts, AWS IoT connector, Job Manager and the console/API), and to medium to see it as a single platform alongside its external dependencies.",{"_3461":778,"_30106":769,"_20907":51536,"_5":14363,"_27392":51511,"_2946":51537},[],"The console and the APIs manage authorities, certificates, DMSs, devices, alerts and configuration. Domain events allow connectors and automations to react to changes without continuously polling the platform.",{"_3461":779,"_30106":769,"_20907":51539,"_5":14363,"_27392":51515,"_2946":51540},[],"The KMS offers a common interface over software engines, PKCS#11 and cloud providers. The selected engine keeps the key or delegates the cryptographic operation without the other services knowing its implementation.",{"_3461":780,"_30106":769,"_20907":51542,"_5":14363,"_27392":51519,"_2946":51543},[],"The CA service issues certificates and maintains the relationship with its authority. The DMS applies the enrollment rules and exposes the EST flows so a device can request or renew an identity.",{"_3461":781,"_30106":769,"_20907":51545,"_5":14363,"_27392":51523,"_2946":51546},[],"Device Manager keeps the operational view of the device and its history. The Validation Authority publishes OCSP and CRLs so other systems can decide whether to trust a presented certificate.",{"_3461":782,"_30106":769,"_20907":51548,"_5":14363,"_27392":51527,"_2946":51549},[],"In a self-managed deployment, Lamassu uses PostgreSQL for persistence, RabbitMQ for messaging and an OIDC provider for authentication. See the deployment architecture for how the services are published on Kubernetes.",{"_3461":783,"_30106":783,"_5":14715,"_2946":51551,"_30438":51552,"_20907":51553,"_27392":783},"How Lamassu works",[49125,50593],[],{"_3461":784,"_30106":783,"_20907":51555,"_5":14363,"_27392":783,"_2946":51556},[],"The mental model of trust, keys, certificates and devices.",{"_3461":785,"_30106":783,"_5":30435,"_20907":51558,"_27392":51559,"_2946":51560},[],"/docs/platform/concepts/overview#the-model-in-five-pieces","The model in five pieces",{"_3461":786,"_30106":783,"_5":30435,"_20907":51562,"_27392":51563,"_2946":51564},[],"/docs/platform/concepts/overview#from-onboarding-to-operation","From onboarding to operation",{"_3461":787,"_30106":783,"_20907":51566,"_5":14363,"_27392":783,"_2946":51567},[],"Lamassu connects three elements: a **root of trust**, an **issuance policy** and an **entity that needs to prove its identity**. The platform coordinates these elements throughout the certificate lifecycle.",{"_3461":788,"_30106":783,"_20907":51569,"_5":14363,"_27392":51559,"_2946":51570},[],"**Cryptographic engine.** Generates or safeguards keys and executes private-key operations without exposing key material to the rest of the services.",{"_3461":789,"_30106":783,"_20907":51572,"_5":14363,"_27392":51559,"_2946":51573},[],"**Certification Authority (CA).** Signs certificates and establishes the chain of trust.",{"_3461":790,"_30106":783,"_20907":51575,"_5":14363,"_27392":51559,"_2946":51576},[],"**Device Management Service (DMS).** Defines how the devices of a fleet are registered, authenticated and renewed.",{"_3461":791,"_30106":783,"_20907":51578,"_5":14363,"_27392":51559,"_2946":51579},[],"**Device.** Keeps its private key and presents the certificate to prove its identity.",{"_3461":792,"_30106":783,"_20907":51581,"_5":14363,"_27392":51559,"_2946":51582},[],"**Validation Authority (VA).** Publishes the status of certificates through OCSP and CRL.",{"_3461":793,"_30106":783,"_20907":51584,"_5":14363,"_27392":51563,"_2946":51585},[],"An administrator configures a cryptographic engine and creates or imports a CA.",{"_3461":794,"_30106":783,"_20907":51587,"_5":14363,"_27392":51563,"_2946":51588},[],"A DMS relates that CA to an enrollment policy.",{"_3461":795,"_30106":783,"_20907":51590,"_5":14363,"_27392":51563,"_2946":51591},[],"The device generates a key and requests a certificate through EST, or an operator assigns it an identity.",{"_3461":796,"_30106":783,"_20907":51593,"_5":14363,"_27392":51563,"_2946":51594},[],"Lamassu keeps the inventory, history and status of the identity.",{"_3461":797,"_30106":783,"_20907":51596,"_5":14363,"_27392":51563,"_2946":51597},[],"Consumers check the chain and query OCSP or a CRL when they need to know whether it is still valid.",{"_3461":798,"_30106":783,"_20907":51599,"_5":14363,"_27392":51563,"_2946":51600},[],"<Card title=\"Architecture\" description=\"Get to know the components and where each one's responsibility ends.\" href=\"/docs/platform/concepts/architecture\" />",{"_3461":799,"_30106":783,"_20907":51602,"_5":14363,"_27392":51563,"_2946":51603},[],"<Card title=\"Identity lifecycle\" description=\"Follow a certificate from enrollment to renewal or revocation.\" href=\"/docs/platform/pki/concepts/certificate-lifecycle\" />",{"_3461":800,"_30106":800,"_5":14715,"_2946":51605,"_30438":51606,"_20907":51608,"_27392":800},"Devices and identities",[49125,50593,51607,51605],"IoT Fleets",[],{"_3461":801,"_30106":800,"_20907":51610,"_5":14363,"_27392":800,"_2946":51611},[],"Register, inspect and retire devices while checking their current identity and history.",{"_3461":802,"_30106":800,"_5":30435,"_20907":51613,"_27392":51614,"_2946":51615},[],"/docs/platform/iot-fleets/device-management#device-states","Device states",{"_3461":803,"_30106":800,"_5":30435,"_20907":51617,"_27392":51618,"_2946":51619},[],"/docs/platform/iot-fleets/device-management#inspect-a-device","Inspect a device",{"_3461":804,"_30106":800,"_5":30435,"_20907":51621,"_27392":51622,"_2946":51623},[],"/docs/platform/iot-fleets/device-management#register-a-device-manually","Register a device manually",{"_3461":805,"_30106":800,"_5":30435,"_20907":51625,"_27392":51626,"_2946":51627},[],"/docs/platform/iot-fleets/device-management#create-the-device","Create the device",{"_3461":806,"_30106":800,"_5":30435,"_20907":51629,"_27392":51630,"_2946":51631},[],"/docs/platform/iot-fleets/device-management#define-its-membership","Define its membership",{"_3461":807,"_30106":800,"_5":30435,"_20907":51633,"_27392":51634,"_2946":51635},[],"/docs/platform/iot-fleets/device-management#classify-the-device","Classify the device",{"_3461":808,"_30106":800,"_5":30435,"_20907":51637,"_27392":51638,"_2946":51639},[],"/docs/platform/iot-fleets/device-management#verify-the-registration","Verify the registration",{"_3461":809,"_30106":800,"_5":30435,"_20907":51641,"_27392":51642,"_2946":51643},[],"/docs/platform/iot-fleets/device-management#assign-an-identity-manually","Assign an identity manually",{"_3461":810,"_30106":800,"_5":30435,"_20907":51645,"_27392":51646,"_2946":51647},[],"/docs/platform/iot-fleets/device-management#revoke-the-current-identity","Revoke the current identity",{"_3461":811,"_30106":800,"_5":30435,"_20907":51649,"_27392":51650,"_2946":51651},[],"/docs/platform/iot-fleets/device-management#decommission-a-device","Decommission a device",{"_3461":812,"_30106":800,"_5":30435,"_20907":51653,"_27392":51654,"_2946":51655},[],"/docs/platform/iot-fleets/device-management#automate-enrollment","Automate enrollment",{"_3461":813,"_30106":800,"_20907":51657,"_5":14363,"_27392":800,"_2946":51658},[],"This guide is for a fleet operator. You need device, DMS and certificate permissions for the intended actions. A fleet is organized through these resources, tags and metadata; there is no separate “fleet” object to create.",{"_3461":814,"_30106":800,"_20907":51660,"_5":14363,"_27392":800,"_2946":51661},[],"Each device has a `Device ID`, one owning DMS (`dms_owner`) and, once provisioned, an identity slot with an active version and previous versions. In these flows, keep the CSR and certificate `Common Name` equal to `Device ID`: binding uses that CN to update the device.",{"_3461":815,"_30106":800,"_20907":51663,"_5":14363,"_27392":51614,"_2946":51664},[],"Operational view",{"_3461":816,"_30106":800,"_20907":51666,"_5":14363,"_27392":51614,"_2946":51667},[],"Meaning",{"_3461":817,"_30106":800,"_20907":51669,"_5":14363,"_27392":51614,"_2946":51670},[],"**No Identity**",{"_3461":818,"_30106":800,"_20907":51672,"_5":14363,"_27392":51614,"_2946":51673},[],"A record exists without an associated identity.",{"_3461":819,"_30106":800,"_20907":51675,"_5":14363,"_27392":51614,"_2946":51676},[],"**Active**",{"_3461":820,"_30106":800,"_20907":51678,"_5":14363,"_27392":51614,"_2946":51679},[],"The slot is active; also check certificate dates, status and usages.",{"_3461":821,"_30106":800,"_20907":51681,"_5":14363,"_27392":51614,"_2946":51682},[],"**Renewal Pending**",{"_3461":822,"_30106":800,"_20907":51684,"_5":14363,"_27392":51614,"_2946":51685},[],"The identity is in the operational renewal window.",{"_3461":823,"_30106":800,"_20907":51687,"_5":14363,"_27392":51614,"_2946":51688},[],"**Expiring Soon**",{"_3461":824,"_30106":800,"_20907":51690,"_5":14363,"_27392":51614,"_2946":51691},[],"Expiration is approaching according to configured thresholds.",{"_3461":825,"_30106":800,"_20907":51693,"_5":14363,"_27392":51614,"_2946":51694},[],"**Expired**",{"_3461":826,"_30106":800,"_20907":51696,"_5":14363,"_27392":51614,"_2946":51697},[],"The identity has expired.",{"_3461":827,"_30106":800,"_20907":51699,"_5":14363,"_27392":51614,"_2946":51700},[],"**Revoked**",{"_3461":828,"_30106":800,"_20907":51702,"_5":14363,"_27392":51614,"_2946":51703},[],"The identity is marked revoked.",{"_3461":829,"_30106":800,"_20907":51705,"_5":14363,"_27392":51614,"_2946":51706},[],"**Decommissioned**",{"_3461":830,"_30106":800,"_20907":51708,"_5":14363,"_27392":51614,"_2946":51709},[],"The record is retired and ordinary updates do not restore operation.",{"_3461":831,"_30106":800,"_20907":51711,"_5":14363,"_27392":51614,"_2946":51712},[],"Device, slot and certificate states are distinct. Events and jobs can update the view after saving a certificate; an **Active** label does not establish consumer acceptance.",{"_3461":832,"_30106":800,"_20907":51714,"_5":14363,"_27392":51618,"_2946":51715},[],"Filter the inventory by ID, tags and status. Open details and record the owning DMS, active version and current certificate serial.",{"_3461":833,"_30106":800,"_20907":51717,"_5":14363,"_27392":51618,"_2946":51718},[],"**Certificate History** relates previous and current versions. Replacing the slot does not by itself revoke every previous version.",{"_3461":834,"_30106":800,"_20907":51720,"_5":14363,"_27392":51618,"_2946":51721},[],"**Device Event Timeline** helps reconstruct registration, provisioning, renewal and status changes. A change may be saved even if event persistence fails; also inspect the record and certificates.",{"_3461":835,"_30106":800,"_20907":51723,"_5":14363,"_27392":51618,"_2946":51724},[],"Compare these values with the identity installed on the device. Updating a Lamassu slot does not install files on the remote equipment.",{"_3461":836,"_30106":800,"_20907":51726,"_5":14363,"_27392":51622,"_2946":51727},[],"Use this flow to prepare inventory or assign an identity through the console. You need an existing DMS.",{"_3461":837,"_30106":800,"_20907":51729,"_5":14363,"_27392":51626,"_2946":51730},[],"Open registration in **Managed Devices**. Confirm the ID does not already exist in another DMS: ID lookup is not restricted to a fleet.",{"_3461":838,"_30106":800,"_20907":51732,"_5":14363,"_27392":51630,"_2946":51733},[],"Enter **Device ID** and select its owning DMS. The console’s **Registration Authority** label refers to that DMS.",{"_3461":839,"_30106":800,"_20907":51735,"_5":14363,"_27392":51634,"_2946":51736},[],"Add model, environment or location tags and an icon according to your inventory.",{"_3461":840,"_30106":800,"_20907":51738,"_5":14363,"_27392":51638,"_2946":51739},[],"Read the device again: require the intended DMS and **No Identity**. Follow Manual registration to complete assignment.",{"_3461":841,"_30106":800,"_20907":51741,"_5":14363,"_27392":51638,"_2946":51742},[],"Preregistration does not establish that `/simpleenroll` will admit the request. Review its interaction with `enable_replaceable_enrollment` in Provisioning strategies.",{"_3461":842,"_30106":800,"_20907":51744,"_5":14363,"_27392":51642,"_2946":51745},[],"From **No Identity**, use **Assign Identity**:",{"_3461":843,"_30106":800,"_20907":51747,"_5":14363,"_27392":51642,"_2946":51748},[],"Select an active, current certificate suitable for the consumer, with `CN` exactly equal to `Device ID`.",{"_3461":844,"_30106":800,"_20907":51750,"_5":14363,"_27392":51642,"_2946":51751},[],"If unavailable, **Issue New Instead** starts issuance using the intended CA. Review the profile first.",{"_3461":845,"_30106":800,"_20907":51753,"_5":14363,"_27392":51642,"_2946":51754},[],"Confirm and read the serial, active version and history again.",{"_3461":846,"_30106":800,"_20907":51756,"_5":14363,"_27392":51642,"_2946":51757},[],"Install the key/certificate pair and required intermediates on the device and test usage.",{"_3461":847,"_30106":800,"_20907":51759,"_5":14363,"_27392":51642,"_2946":51760},[],"Issuing, binding and installing are separate steps. If an operation fails, check which steps persisted before repeating it.",{"_3461":848,"_30106":800,"_20907":51762,"_5":14363,"_27392":51646,"_2946":51763},[],"Locate the active serial in history and revoke it with an appropriate reason. Verify the record, OCSP/CRL publication and rejection of a new consumer connection using the certificate guide.",{"_3461":849,"_30106":800,"_20907":51765,"_5":14363,"_27392":51646,"_2946":51766},[],"Revocation does not remove the device. It does not automatically enable another enrollment either: recovery depends on its credential, status and DMS policy. `CertificateHold` can be reactivated under PKI conditions; other reasons block subsequent certificate changes.",{"_3461":850,"_30106":800,"_20907":51768,"_5":14363,"_27392":51650,"_2946":51769},[],"Before **Decommission**, inventory active and previous identities, connections and destination permissions. Prepare retirement in the consumer.",{"_3461":851,"_30106":800,"_20907":51771,"_5":14363,"_27392":51650,"_2946":51772},[],"The backend saves **Decommissioned** and attempts to revoke the active version’s certificate with `CessationOfOperation` if the slot was not expired or revoked. It does not traverse all history. Deferred revocation can fail after retirement is saved; check the result by serial.",{"_3461":852,"_30106":800,"_20907":51774,"_5":14363,"_27392":51650,"_2946":51775},[],"Retired status protects ordinary device and slot updates. It does not guarantee that every EST request is rejected before issuance: binding can skip a retired device without returning an error. Check for remaining usable certificates or permissions and block new admission in the relevant control.",{"_3461":853,"_30106":800,"_20907":51777,"_5":14363,"_27392":51650,"_2946":51778},[],"Retain records according to audit policy. Do not reuse a retired ID to hide an equipment change.",{"_3461":854,"_30106":800,"_20907":51780,"_5":14363,"_27392":51654,"_2946":51781},[],"<Card title=\"Enroll and connect a device\" description=\"Obtain an identity from the client and test mTLS.\" href=\"/docs/platform/iot-fleets/quickstarts/enroll-device\" />",{"_3461":855,"_30106":800,"_20907":51783,"_5":14363,"_27392":51654,"_2946":51784},[],"<Card title=\"Renewal and recovery\" description=\"Install the successor and handle failures without losing known state.\" href=\"/docs/platform/iot-fleets/enrollment/renewal-and-recovery\" />",{"_3461":856,"_30106":856,"_5":14715,"_2946":51786,"_30438":51787,"_20907":51789,"_27392":856},"Bootstrap identity and authentication",[49125,50593,51607,51605,51788],"Enrollment with PKI",[],{"_3461":857,"_30106":856,"_20907":51791,"_5":14363,"_27392":856,"_2946":51792},[],"Prepare server trust and admission proofs for enroll and reenroll.",{"_3461":858,"_30106":856,"_5":30435,"_20907":51794,"_27392":51795,"_2946":51796},[],"/docs/platform/iot-fleets/enrollment/bootstrap-identity#initial-server-trust","Initial server trust",{"_3461":859,"_30106":856,"_5":30435,"_20907":51798,"_27392":51799,"_2946":51800},[],"/docs/platform/iot-fleets/enrollment/bootstrap-identity#bootstrap-credential","Bootstrap credential",{"_3461":860,"_30106":856,"_5":30435,"_20907":51802,"_27392":51803,"_2946":51804},[],"/docs/platform/iot-fleets/enrollment/bootstrap-identity#modes-per-operation","Modes per operation",{"_3461":861,"_30106":856,"_5":30435,"_20907":51806,"_27392":51807,"_2946":51808},[],"/docs/platform/iot-fleets/enrollment/bootstrap-identity#webhook-contract","Webhook contract",{"_3461":862,"_30106":856,"_5":30435,"_20907":51810,"_27392":51811,"_2946":51812},[],"/docs/platform/iot-fleets/enrollment/bootstrap-identity#revocation-and-checks","Revocation and checks",{"_3461":863,"_30106":856,"_20907":51814,"_5":14363,"_27392":856,"_2946":51815},[],"This guide connects the DMS administrator with device manufacturing and integration. Before requesting an operational identity, the client must authenticate the EST server and establish entitlement to request the intended ID.",{"_3461":864,"_30106":856,"_20907":51817,"_5":14363,"_27392":51795,"_2946":51818},[],"Install a previously verified root, chain or pin through a trusted channel: manufacturing, approved configuration or authenticated distribution. It enables TLS and server-name verification before downloading `/cacerts`.",{"_3461":865,"_30106":856,"_20907":51820,"_5":14363,"_27392":51795,"_2946":51821},[],"Your only trust proof cannot come from the same unauthenticated server. The EST server TLS certificate, bootstrap certificate and operational identity issuer may belong to different hierarchies.",{"_3461":866,"_30106":856,"_20907":51823,"_5":14363,"_27392":51799,"_2946":51824},[],"With `CLIENT_CERTIFICATE`, the device presents its initial certificate and proves key possession through TLS. The DMS validates it against admission CAs. In the inspected flow, the validator receives one leaf credential: configure and test the direct issuer for the simple case; sending more intermediates does not establish delivery to the service.",{"_3461":867,"_30106":856,"_20907":51826,"_5":14363,"_27392":51799,"_2946":51827},[],"Check dates, matching certificate/key and revocation before provisioning. A credential shared across equipment identifies that shared credential, not an individual device.",{"_3461":868,"_30106":856,"_20907":51829,"_5":14363,"_27392":51799,"_2946":51830},[],"Initial mTLS validation does not by itself compare bootstrap CN with the requested CSR CN. If a requester should only request its own `Device ID`, add a control binding credential to ID, such as the combined webhook, and test a request with another CN. Certificate re-enrollment does compare its CN to the CSR; subsequent checks use the registered active identity.",{"_3461":869,"_30106":856,"_20907":51832,"_5":14363,"_27392":51803,"_2946":51833},[],"Select the four modes independently for enrollment and re-enrollment in DMS. Renewal credentials depend on that block; do not assume the bootstrap is always used or the webhook disappears.",{"_3461":870,"_30106":856,"_20907":51835,"_5":14363,"_27392":51803,"_2946":51836},[],"An administrative OIDC token is not a native EST mode. A webhook may interpret an agreed credential header; that service then performs authorization. In NO\\_AUTH, sending a token does not add DMS authentication.",{"_3461":871,"_30106":856,"_20907":51838,"_5":14363,"_27392":51807,"_2946":51839},[],"The DMS sends operation context to the configured service. Method comes from configuration; agree the contract before selecting POST or PUT. Authorization wait defaults to 10 seconds, replaced by a configured positive timeout. The DMS verifies the receiver certificate unless `insecure_skip_verify` is enabled in the webhook config — verification is on by default — and does not follow redirects, so the configured URL must be the final one. The authorization response must be JSON of at most 1 MiB. With Lamassu-to-webhook authentication configured over `http://`, the API key or bearer token travels in cleartext, and mTLS has no effect because no TLS handshake takes place, so the client certificate is never presented; prefer `https://`. Configure those options in the webhook settings of the DMS guide.",{"_3461":872,"_30106":856,"_20907":51841,"_5":14363,"_27392":51807,"_2946":51842},[],"Example body:",{"_3461":873,"_30106":856,"_20907":51844,"_5":14363,"_27392":51807,"_2946":51845},[],"`csr` is **base64 of PEM**, unlike the EST body, which is base64 of DER. `http_request` contains URL and first header entries from available HTTP context. This body does not include an `operation` field; distinguish enroll and reenroll through the path and configured policy.",{"_3461":874,"_30106":856,"_20907":51847,"_5":14363,"_27392":51807,"_2946":51848},[],"The webhook should verify credential, its relationship to `device_cn`, DMS, operation and admission policy. Forwarded headers are not themselves trusted evidence. **Lamassu-to-webhook authentication** is a separate relationship configured in the server’s HTTP client.",{"_3461":875,"_30106":856,"_20907":51850,"_5":14363,"_27392":51807,"_2946":51851},[],"Continuation requires a successful HTTP response and JSON:",{"_3461":876,"_30106":856,"_20907":51853,"_5":14363,"_27392":51807,"_2946":51854},[],"A bodyless `204` does not satisfy the contract. Denial, transport error, uninterpretable response or timeout abort authorization. Combined mode validates the certificate first, then queries the webhook. See the webhook specification.",{"_3461":877,"_30106":856,"_20907":51856,"_5":14363,"_27392":51811,"_2946":51857},[],"The DMS first looks up the certificate in Lamassu; for external certificates it attempts OCSP and CRL. If revocation cannot be checked, validators can continue treating it as not revoked. The code also does not establish rejection of every external status other than Good. Test required behavior with your actual credential and endpoint; do not present this as guaranteed strict enforcement across every source.",{"_3461":878,"_30106":856,"_20907":51859,"_5":14363,"_27392":51811,"_2946":51860},[],"Test an allowed certificate, an incorrect one, another CN, webhook denial, timeout and re-enrollment under its own policy. Keep results and schedule bootstrap credential retirement where appropriate. Continue with EST client.",{"_3461":879,"_30106":879,"_5":14715,"_2946":51862,"_30438":51863,"_20907":51864,"_27392":879},"Configure and operate the DMS",[49125,50593,51607,51605,51788],[],{"_3461":880,"_30106":879,"_20907":51866,"_5":14363,"_27392":879,"_2946":51867},[],"Define registration, authentication per operation, issuance, renewal and distributed trust.",{"_3461":881,"_30106":879,"_5":30435,"_20907":51869,"_27392":51870,"_2946":49135},[],"/docs/platform/iot-fleets/enrollment/dms#before-you-begin",{"_3461":882,"_30106":879,"_5":30435,"_20907":51872,"_27392":51873,"_2946":51874},[],"/docs/platform/iot-fleets/enrollment/dms#configure-a-dms","Configure a DMS",{"_3461":883,"_30106":879,"_5":30435,"_20907":51876,"_27392":51877,"_2946":51878},[],"/docs/platform/iot-fleets/enrollment/dms#identify-the-fleet","Identify the fleet",{"_3461":884,"_30106":879,"_5":30435,"_20907":51880,"_27392":51881,"_2946":51882},[],"/docs/platform/iot-fleets/enrollment/dms#select-the-enrollment-ca","Select the enrollment CA",{"_3461":885,"_30106":879,"_5":30435,"_20907":51884,"_27392":51885,"_2946":51886},[],"/docs/platform/iot-fleets/enrollment/dms#configure-est","Configure EST",{"_3461":886,"_30106":879,"_5":30435,"_20907":51888,"_27392":51889,"_2946":51890},[],"/docs/platform/iot-fleets/enrollment/dms#distribute-trust","Distribute trust",{"_3461":887,"_30106":879,"_5":30435,"_20907":51892,"_27392":51893,"_2946":51894},[],"/docs/platform/iot-fleets/enrollment/dms#verify-the-endpoints","Verify the endpoints",{"_3461":888,"_30106":879,"_5":30435,"_20907":51896,"_27392":51897,"_2946":51898},[],"/docs/platform/iot-fleets/enrollment/dms#enrollment-configuration","Enrollment configuration",{"_3461":889,"_30106":879,"_5":30435,"_20907":51900,"_27392":51901,"_2946":51902},[],"/docs/platform/iot-fleets/enrollment/dms#enrollment-device-registration","Enrollment Device Registration",{"_3461":890,"_30106":879,"_5":30435,"_20907":51904,"_27392":51905,"_2946":51906},[],"/docs/platform/iot-fleets/enrollment/dms#enrollment-settings","Enrollment Settings",{"_3461":891,"_30106":879,"_5":30435,"_20907":51908,"_27392":51909,"_2946":51910},[],"/docs/platform/iot-fleets/enrollment/dms#authentication-per-operation","Authentication per operation",{"_3461":892,"_30106":879,"_5":30435,"_20907":51912,"_27392":51913,"_2946":51914},[],"/docs/platform/iot-fleets/enrollment/dms#external-webhook-settings","External webhook settings",{"_3461":893,"_30106":879,"_5":30435,"_20907":51916,"_27392":51917,"_2946":51918},[],"/docs/platform/iot-fleets/enrollment/dms#issuance-profile","Issuance profile",{"_3461":894,"_30106":879,"_5":30435,"_20907":51920,"_27392":51921,"_2946":51922},[],"/docs/platform/iot-fleets/enrollment/dms#re-enrollment-configuration","Re-enrollment configuration",{"_3461":895,"_30106":879,"_5":30435,"_20907":51924,"_27392":51925,"_2946":51926},[],"/docs/platform/iot-fleets/enrollment/dms#serverkeygen","ServerKeyGen",{"_3461":896,"_30106":879,"_5":30435,"_20907":51928,"_27392":51929,"_2946":51930},[],"/docs/platform/iot-fleets/enrollment/dms#trust-distribution","Trust distribution",{"_3461":897,"_30106":879,"_5":30435,"_20907":51932,"_27392":51933,"_2946":51934},[],"/docs/platform/iot-fleets/enrollment/dms#operate-the-dms-inventory","Operate the DMS inventory",{"_3461":898,"_30106":879,"_5":30435,"_20907":51936,"_27392":51937,"_2946":51938},[],"/docs/platform/iot-fleets/enrollment/dms#integrate-the-devices","Integrate the devices",{"_3461":899,"_30106":879,"_20907":51940,"_5":14363,"_27392":879,"_2946":51941},[],"A &#x2A;*Device Management Service (DMS)** configures admission and identity lifecycle for its devices. It acts as a registration authority; the CA selected in `Enrollment CA` signs certificates. This guide is for the policy administrator.",{"_3461":900,"_30106":879,"_20907":51943,"_5":14363,"_27392":51870,"_2946":51944},[],"You need DMS management permissions, an active CA with a usable key and a tested issuance profile. Agree device ID, initial credential, consumer and renewal window with the integrator. Review Provisioning strategies before choosing registration and replacement.",{"_3461":901,"_30106":879,"_20907":51946,"_5":14363,"_27392":51870,"_2946":51947},[],"Prepare EST server trust and device connectivity through Deployment. Your operator’s administrative authentication does not replace device EST authentication.",{"_3461":902,"_30106":879,"_20907":51949,"_5":14363,"_27392":51877,"_2946":51950},[],"Create the DMS with a recognizable name and retain its ID. EST URLs use this identifier, not the display name. Each device retains one owning DMS.",{"_3461":903,"_30106":879,"_20907":51952,"_5":14363,"_27392":51881,"_2946":51953},[],"Choose **Enrollment CA** and an explicit profile appropriate for the end-entity identity. Keep CN compatible with `Device ID`. The test certificate should allow its intended purpose and expire within issuer validity.",{"_3461":904,"_30106":879,"_20907":51955,"_5":14363,"_27392":51885,"_2946":51956},[],"Select initial enrollment registration and authentication. Separately configure re-enrollment authentication, thresholds and previous certificate retirement. Leave ServerKeyGen disabled if the client generates its key.",{"_3461":905,"_30106":879,"_20907":51958,"_5":14363,"_27392":51889,"_2946":51959},[],"Select certificates returned by `/cacerts`. Explicitly include required intermediates and roots, keeping distribution distinct from automatic trust installation.",{"_3461":906,"_30106":879,"_20907":51961,"_5":14363,"_27392":51893,"_2946":51962},[],"Save and read configuration again. Query `/cacerts`, perform an allowed and a rejected enrollment, and inspect device, serial and history. Creating the DMS or downloading cacerts does not establish working authentication and issuance.",{"_3461":907,"_30106":879,"_20907":51964,"_5":14363,"_27392":51901,"_2946":51965},[],"`settings.enrollment_settings.registration_mode` accepts `JITP` or `PRE_REGISTRATION`. JITP creates an unknown device with the CSR CN as ID and the DMS as owner. `device_provisioning_profile` supplies tags, metadata and icon for that registration.",{"_3461":908,"_30106":879,"_20907":51967,"_5":14363,"_27392":51901,"_2946":51968},[],"PRE\\_REGISTRATION requires an existing ID. In the inspected code, an existing device encounters replacement checks first, even without an identity. Review preregistration conditions before using this mode.",{"_3461":909,"_30106":879,"_20907":51970,"_5":14363,"_27392":51905,"_2946":51971},[],"`settings.enrollment_settings` field",{"_3461":910,"_30106":879,"_20907":51973,"_5":14363,"_27392":51905,"_2946":51974},[],"Decision",{"_3461":911,"_30106":879,"_20907":51976,"_5":14363,"_27392":51905,"_2946":51977},[],"`protocol`",{"_3461":912,"_30106":879,"_20907":51979,"_5":14363,"_27392":51905,"_2946":51980},[],"`EST_RFC7030` for these operations.",{"_3461":913,"_30106":879,"_20907":51982,"_5":14363,"_27392":51905,"_2946":51983},[],"`enrollment_ca`",{"_3461":914,"_30106":879,"_20907":51985,"_5":14363,"_27392":51905,"_2946":51986},[],"ID of the signing CA.",{"_3461":915,"_30106":879,"_20907":51988,"_5":14363,"_27392":51905,"_2946":51989},[],"`verify_csr_signature`",{"_3461":916,"_30106":879,"_20907":51991,"_5":14363,"_27392":51905,"_2946":51992},[],"Keep `true` to verify CSR key possession.",{"_3461":917,"_30106":879,"_20907":51994,"_5":14363,"_27392":51905,"_2946":51995},[],"`enable_replaceable_enrollment`",{"_3461":918,"_30106":879,"_20907":51997,"_5":14363,"_27392":51905,"_2946":51998},[],"Allows `/simpleenroll` for an existing ID in the same DMS. It can attempt previous certificate revocation even if a later phase fails; this is not atomic.",{"_3461":919,"_30106":879,"_20907":52000,"_5":14363,"_27392":51905,"_2946":52001},[],"`est_rfc7030_settings.auth_mode`",{"_3461":920,"_30106":879,"_20907":52003,"_5":14363,"_27392":51905,"_2946":52004},[],"One of the four authentication modes.",{"_3461":921,"_30106":879,"_20907":52006,"_5":14363,"_27392":51905,"_2946":52007},[],"Initial enrollment rejects an ID owned by another DMS. Do not automatically enable replacement in response to an error; Troubleshooting distinguishes repeated IDs, ownership and partial changes.",{"_3461":922,"_30106":879,"_20907":52009,"_5":14363,"_27392":51909,"_2946":52010},[],"The blocks are independent:",{"_3461":923,"_30106":879,"_20907":52012,"_5":14363,"_27392":51909,"_2946":52013},[],"`settings.enrollment_settings.est_rfc7030_settings` for `/simpleenroll` and `/serverkeygen`.",{"_3461":924,"_30106":879,"_20907":52015,"_5":14363,"_27392":51909,"_2946":52016},[],"`settings.reenrollment_settings.est_rfc7030_settings` for `/simplereenroll`.",{"_3461":925,"_30106":879,"_20907":52018,"_5":14363,"_27392":51909,"_2946":52019},[],"`auth_mode`",{"_3461":926,"_30106":879,"_20907":52021,"_5":14363,"_27392":51909,"_2946":52022},[],"Control applied in the configured operation",{"_3461":927,"_30106":879,"_20907":52024,"_5":14363,"_27392":51909,"_2946":52025},[],"`CLIENT_CERTIFICATE`",{"_3461":928,"_30106":879,"_20907":52027,"_5":14363,"_27392":51909,"_2946":52028},[],"Presented certificate validation.",{"_3461":929,"_30106":879,"_20907":52030,"_5":14363,"_27392":51909,"_2946":52031},[],"`EXTERNAL_WEBHOOK`",{"_3461":930,"_30106":879,"_20907":52033,"_5":14363,"_27392":51909,"_2946":52034},[],"Configured webhook authorization.",{"_3461":931,"_30106":879,"_20907":52036,"_5":14363,"_27392":51909,"_2946":52037},[],"`CLIENT_CERTIFICATE_AND_EXTERNAL_WEBHOOK`",{"_3461":932,"_30106":879,"_20907":52039,"_5":14363,"_27392":51909,"_2946":52040},[],"Certificate validation followed by webhook approval.",{"_3461":933,"_30106":879,"_20907":52042,"_5":14363,"_27392":51909,"_2946":52043},[],"`NO_AUTH`",{"_3461":934,"_30106":879,"_20907":52045,"_5":14363,"_27392":51909,"_2946":52046},[],"No DMS requester authentication.",{"_3461":935,"_30106":879,"_20907":52048,"_5":14363,"_27392":51909,"_2946":52049},[],"Webhook and combined modes also execute during re-enrollment when configured in its block. They do not implicitly degrade to NO\\_AUTH. An absent or unrecognized mode fails.",{"_3461":936,"_30106":879,"_20907":52051,"_5":14363,"_27392":51909,"_2946":52052},[],"For initial mTLS, `client_certificate_settings` contains `validation_cas`, `allow_expired` and `chain_level_validation`. The inspected flow receives one certificate credential; it does not guarantee forwarding every handshake intermediate to the validator. For a direct case, configure the bootstrap’s direct issuer as validation CA and test the actual Gateway path.",{"_3461":937,"_30106":879,"_20907":52054,"_5":14363,"_27392":51909,"_2946":52055},[],"For certificate re-enrollment, the validator tries the enrollment CA first and then the CAs listed in `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`; those are the re-enrollment validation CAs. That list is optional because the enrollment CA is always trusted for re-enrollment, and each settings block consults only its own `validation_cas`. CAs listed only in the initial block's `validation_cas` do not extend re-enrollment acceptance; during a CA rotation, add the old issuance CA to the re-enrollment block's list. The re-enrollment validator compares the presented TLS leaf against those CAs; the re-enrollment block's `chain_level_validation` and `allow_expired` values are stored but not consulted, and expiry is governed by `enable_expired_renewal`.",{"_3461":938,"_30106":879,"_20907":52057,"_5":14363,"_27392":51909,"_2946":52058},[],"For a webhook, configure destination, Lamassu-to-service authentication, method and timeout. The authentication contract explains the device credential and request body. `NO_AUTH` does not establish ownership of the requested ID.",{"_3461":939,"_30106":879,"_20907":52060,"_5":14363,"_27392":51913,"_2946":52061},[],"The webhook authentication modes read `external_webhook_settings` in the same `est_rfc7030_settings` block:",{"_3461":940,"_30106":879,"_20907":52063,"_5":14363,"_27392":51913,"_2946":52064},[],"`external_webhook_settings` field",{"_3461":941,"_30106":879,"_20907":52066,"_5":14363,"_27392":51913,"_2946":51974},[],{"_3461":942,"_30106":879,"_20907":52068,"_5":14363,"_27392":51913,"_2946":52069},[],"`url`",{"_3461":943,"_30106":879,"_20907":52071,"_5":14363,"_27392":51913,"_2946":52072},[],"Absolute `http` or `https` URL of the receiver. It must be the final URL; redirects are not followed.",{"_3461":944,"_30106":879,"_20907":52074,"_5":14363,"_27392":51913,"_2946":52075},[],"`method`",{"_3461":945,"_30106":879,"_20907":52077,"_5":14363,"_27392":51913,"_2946":52078},[],"`POST` or `PUT`; `POST` by default.",{"_3461":946,"_30106":879,"_20907":52080,"_5":14363,"_27392":51913,"_2946":52081},[],"`name`",{"_3461":947,"_30106":879,"_20907":52083,"_5":14363,"_27392":51913,"_2946":52084},[],"Label used in service logs.",{"_3461":948,"_30106":879,"_20907":52086,"_5":14363,"_27392":51913,"_2946":52087},[],"`config.auth_mode`",{"_3461":949,"_30106":879,"_20907":52089,"_5":14363,"_27392":51913,"_2946":52090},[],"`noauth`, `apikey`, `jwt` or `mtls`. An absent or unknown value behaves as `noauth`.",{"_3461":950,"_30106":879,"_20907":52092,"_5":14363,"_27392":51913,"_2946":52093},[],"`config.log_level`",{"_3461":951,"_30106":879,"_20907":52095,"_5":14363,"_27392":51913,"_2946":52096},[],"Log level of the webhook call: `debug`, `info`, `warn` or `error`; `info` by default.",{"_3461":952,"_30106":879,"_20907":52098,"_5":14363,"_27392":51913,"_2946":52099},[],"`config.apikey_options`",{"_3461":953,"_30106":879,"_20907":52101,"_5":14363,"_27392":51913,"_2946":52102},[],"Required for `apikey`: `header` and `key`. Reserved header names are rejected.",{"_3461":954,"_30106":879,"_20907":52104,"_5":14363,"_27392":51913,"_2946":52105},[],"`config.jwt_options`",{"_3461":955,"_30106":879,"_20907":52107,"_5":14363,"_27392":51913,"_2946":52108},[],"Required for `jwt`: `oidc_client_id`, `oidc_client_secret` and an absolute `http` or `https` `oidc_well_known`.",{"_3461":956,"_30106":879,"_20907":52110,"_5":14363,"_27392":51913,"_2946":52111},[],"`config.mtls_options`",{"_3461":957,"_30106":879,"_20907":52113,"_5":14363,"_27392":51913,"_2946":52114},[],"Required for `mtls`: `cert_content` and `key_content` as Base64-encoded PEM, like certificates elsewhere in the API; plain PEM is also accepted.",{"_3461":958,"_30106":879,"_20907":52116,"_5":14363,"_27392":51913,"_2946":52117},[],"`config.insecure_skip_verify`",{"_3461":959,"_30106":879,"_20907":52119,"_5":14363,"_27392":51913,"_2946":52120},[],"Skips verification of the receiver certificate when `true`. Verification is on by default. Unlike alert channels, this flag is honored here.",{"_3461":960,"_30106":879,"_20907":52122,"_5":14363,"_27392":51913,"_2946":52123},[],"`config.call_timeout`",{"_3461":961,"_30106":879,"_20907":52125,"_5":14363,"_27392":51913,"_2946":52126},[],"Maximum duration of the authorization call (for example `10s`); 10 seconds by default.",{"_3461":962,"_30106":879,"_20907":52128,"_5":14363,"_27392":51913,"_2946":52129},[],"Rules for that configuration:",{"_3461":963,"_30106":879,"_20907":52131,"_5":14363,"_27392":51913,"_2946":52132},[],"Creating or updating a DMS whose enrollment or reenrollment `auth_mode` uses the webhook validates the block and returns HTTP 400 — the body starts with `struct validation error:` and continues with `invalid enrollment external webhook config` or `invalid reenrollment external webhook config` — when the URL, method or options are invalid. That includes an `mtls_options.cert_content`/`key_content` pair that does not decode to a matching certificate and private key. File references (`ca_cert_file`, `mtls_options.cert_file`, `mtls_options.key_file`) are always invalid: the service does not read files, so enter the certificate and key as Base64-encoded PEM in `mtls_options.cert_content` and `key_content`, or as plain PEM.",{"_3461":964,"_30106":879,"_20907":52134,"_5":14363,"_27392":51913,"_2946":52135},[],"A custom `apikey_options.header` may not use names that the platform or the receiving service trusts — for example `X-Principal-Id`, `X-Request-Id`, `Host`, `Content-Type` or `Forwarded` — and no name may start with `X-Forwarded-`, `X-Envoy-` or `X-Lms-` (case-insensitive). The DMS API reference documents the `WebhookCall` and `WebhookCallHttpClient` schemas and that reserved API-key headers are rejected.",{"_3461":965,"_30106":879,"_20907":52137,"_5":14363,"_27392":51913,"_2946":52138},[],"The nested `http_client` key exists only in alert channel configurations; in a DMS body it is ignored. The DMS key is `external_webhook_settings.config`.",{"_3461":966,"_30106":879,"_20907":52140,"_5":14363,"_27392":51913,"_2946":52141},[],"A body with `config.auth_mode` set to `apikey`, `jwt` or `mtls` must carry its corresponding option block (`apikey_options`, `jwt_options` or `mtls_options`) — and nothing else. Bodies with those auth modes carrying only `apikey`, `oidc` or `mtls` fail validation with 400, and `validate_server_cert` is always ignored: use `insecure_skip_verify`. Only bodies without option blocks are accepted as `noauth`, and their credentials are dropped.",{"_3461":967,"_30106":879,"_20907":52143,"_5":14363,"_27392":51913,"_2946":52144},[],"The authorization response must be JSON of at most 1 MiB; a larger body fails the call.",{"_3461":968,"_30106":879,"_20907":52146,"_5":14363,"_27392":51913,"_2946":52147},[],"With credentials configured, they are sent regardless of the URL scheme: an `http://` webhook receives the API key or bearer token in cleartext, and mTLS has no effect because no TLS handshake takes place, so the client certificate is never presented. Prefer `https://` for `url`, `oidc_well_known` and the token endpoint it advertises.",{"_3461":969,"_30106":879,"_20907":52149,"_5":14363,"_27392":51913,"_2946":52150},[],"Initial authentication and renewal settings are stored independently. If a DMS only has the initial authentication block, renewal reuses it: read both blocks before editing. The console exposes independent editors for the enrollment and re-enrollment authentication, with the same Log Level, Call Timeout, HTTP Authentication and credential fields as the webhook channels, plus a **Skip TLS Verification** switch (off by default, so verification stays on; the console warns when you enable it).",{"_3461":970,"_30106":879,"_20907":52152,"_5":14363,"_27392":51913,"_2946":52153},[],"Webhook credentials must be stored as PEM content. File references (`ca_cert_file`, `mtls_options.cert_file`, `mtls_options.key_file`) are never valid in a stored webhook config: delivery rejects any webhook config that references files, whatever its auth mode, so every enroll and reenroll that calls that webhook fails until the certificate and key are entered as Base64-encoded or plain PEM in `mtls_options.cert_content` and `key_content`, or the file fields are removed if the webhook does not use mTLS. If a stored config holds file paths in `mtls_options.cert_content` or `key_content`, every full settings update (`POST /v1/dms`, `PUT /v1/dms/:id`) fails validation — settings are replaced wholesale, so the stored config must be resent — until the values are replaced by PEM content or the webhook stops being used. Meanwhile, delivery of that webhook fails on every call; a metadata-only update through `PUT` or `PATCH` on `/v1/dms/:id/metadata` still succeeds. To fix it in the console, open the DMS, replace any file-path value with PEM content — the editor rejects file paths with an inline field error — and save. Saving rewrites `external_webhook_settings.config` with the current keys, and the console reads both plain and Base64-encoded PEM from migrated configurations and stores the material Base64-encoded. If your stored config previously relied on `validate_server_cert: false`, it now carries `insecure_skip_verify: true`: receiver-certificate verification stays skipped until you set that flag to `false`. See 3.8.0 to 4.0.0 for the upgrade notes and the operator checklist.",{"_3461":971,"_30106":879,"_20907":52155,"_5":14363,"_27392":51913,"_2946":52156},[],"The re-enrollment trust set lives in `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`. The flat field `reenrollment_settings.additional_validation_cas` is not part of the API: bodies that carry it are accepted but the value is silently ignored — unknown JSON fields are dropped — and GET responses do not include it. Read the DMS before sending API edits: an update body built with that flat field silently empties `validation_cas`.",{"_3461":972,"_30106":879,"_20907":52158,"_5":14363,"_27392":51917,"_2946":52159},[],"`settings.issuance_profile_id` takes precedence over `settings.issuance_profile`; without either, the CA default profile is used. Rules are documented once in Profiles. DMS changes affect future requests; they do not modify signed certificates or install client trust.",{"_3461":973,"_30106":879,"_20907":52161,"_5":14363,"_27392":51921,"_2946":52162},[],"`settings.reenrollment_settings` field",{"_3461":974,"_30106":879,"_20907":52164,"_5":14363,"_27392":51921,"_2946":49515},[],{"_3461":975,"_30106":879,"_20907":52166,"_5":14363,"_27392":51921,"_2946":52167},[],"`reenrollment_delta`",{"_3461":976,"_30106":879,"_20907":52169,"_5":14363,"_27392":51921,"_2946":52170},[],"Opens the window at the active certificate’s `NotAfter` minus this delta.",{"_3461":977,"_30106":879,"_20907":52172,"_5":14363,"_27392":51921,"_2946":52173},[],"`preventive_delta`",{"_3461":978,"_30106":879,"_20907":52175,"_5":14363,"_27392":51921,"_2946":52176},[],"Preventive operational monitoring threshold.",{"_3461":979,"_30106":879,"_20907":52178,"_5":14363,"_27392":51921,"_2946":52179},[],"`critical_delta`",{"_3461":980,"_30106":879,"_20907":52181,"_5":14363,"_27392":51921,"_2946":52182},[],"Critical operational monitoring threshold.",{"_3461":981,"_30106":879,"_20907":52184,"_5":14363,"_27392":51921,"_2946":52185},[],"`enable_expired_renewal`",{"_3461":982,"_30106":879,"_20907":52187,"_5":14363,"_27392":51921,"_2946":52188},[],"Accepts an expired presented certificate in the renewal mTLS validator. Does not authorize another mode or remove Gateway constraints by itself.",{"_3461":983,"_30106":879,"_20907":52190,"_5":14363,"_27392":51921,"_2946":52191},[],"`est_rfc7030_settings.client_certificate_settings.validation_cas`",{"_3461":984,"_30106":879,"_20907":52193,"_5":14363,"_27392":51921,"_2946":52194},[],"Re-enrollment validation CAs for the renewal mTLS credential, tried after the enrollment CA; optional, because the enrollment CA is always trusted. Typically populated during CA rotation while old-CA cohorts renew.",{"_3461":985,"_30106":879,"_20907":52196,"_5":14363,"_27392":51921,"_2946":52197},[],"`revoke_on_reenrollment`",{"_3461":986,"_30106":879,"_20907":52199,"_5":14363,"_27392":51921,"_2946":52200},[],"If the previous certificate is ACTIVE, attempts Superseded revocation before binding its successor.",{"_3461":987,"_30106":879,"_20907":52202,"_5":14363,"_27392":51921,"_2946":52203},[],"Monitoring does not renew: the client must schedule the request and installation. Webhook and NO\\_AUTH modes do not use the same mTLS expired-credential validator; the webhook must explicitly authorize permitted recovery. Review Renewal and recovery for operation order and partial failures.",{"_3461":988,"_30106":879,"_20907":52205,"_5":14363,"_27392":51925,"_2946":52206},[],"`settings.server_keygen_settings.enabled` enables software key generation on the server. The console exposes it through an **Enable server-side key generation** switch and a **Key type** selection: `ECDSA` P-256, P-384 or P-521, or `RSA` with 2048, 3072 or 4096 bits; the defaults are P-256 for `ECDSA` and 4096 bit for `RSA`. Algorithm and size come from its `key` field, stored as `{type,bits}` where P-256, P-384 and P-521 map to `bits` 256, 384 and 521; `key` is omitted when disabled. The profile must permit them. The response contains an unencrypted PKCS#8 key inside TLS alongside the certificate. See format and extraction in EST reference.",{"_3461":989,"_30106":879,"_20907":52208,"_5":14363,"_27392":51929,"_2946":49509},[],{"_3461":990,"_30106":879,"_20907":52210,"_5":14363,"_27392":51929,"_2946":52211},[],"Published material",{"_3461":991,"_30106":879,"_20907":52213,"_5":14363,"_27392":51929,"_2946":52214},[],"**Include Lamassu System CA**",{"_3461":992,"_30106":879,"_20907":52216,"_5":14363,"_27392":51929,"_2946":52217},[],"Available downstream TLS certificate; it can be a leaf, not an issuing CA.",{"_3461":993,"_30106":879,"_20907":52219,"_5":14363,"_27392":51929,"_2946":52220},[],"**Include Enrollment CA**",{"_3461":994,"_30106":879,"_20907":52222,"_5":14363,"_27392":51929,"_2946":52223},[],"Selected issuing CA certificate.",{"_3461":995,"_30106":879,"_20907":52225,"_5":14363,"_27392":51929,"_2946":52226},[],"**Managed CAs**",{"_3461":996,"_30106":879,"_20907":52228,"_5":14363,"_27392":51929,"_2946":52229},[],"Explicitly selected CA certificates.",{"_3461":997,"_30106":879,"_20907":52231,"_5":14363,"_27392":51929,"_2946":52232},[],"All ancestors are not added automatically. Trust distribution distinguishes trusted roots, intermediates and initial server trust.",{"_3461":998,"_30106":879,"_20907":52234,"_5":14363,"_27392":51933,"_2946":52235},[],"**Edit** changes name, settings and metadata. Updates go through the DMS API. `PUT /v1/dms/{id}` always targets the DMS identified by the URL path: the body carries no `id` field, and any `id` or `creation_ts` in it is silently ignored — authorization is evaluated against the same URL identifier. The body must include a non-empty `name` and a `settings` object; missing either returns HTTP 400 and leaves the stored DMS unchanged. `name` and `settings` are always full replacements, so read the DMS before sending API edits to avoid losing fields. `metadata` is optional: omitting it or sending `null` keeps the stored metadata, a supplied object replaces it entirely, and `{}` clears it (a later GET returns an empty object, not `null`). Old-style bodies that carry the full DMS object keep working while they include `name` and `settings`; unknown fields are ignored. Updates reject an empty `name` with HTTP 400: a DMS whose stored name was zeroed by an earlier update must be renamed before any client round-trips it — the AWS IoT connector’s JITP writeback included. If the object does not include the AWS IoT connector key (`lamassu.io/iot/{connector_id}`), the connector ignores the DMS's later events.",{"_3461":999,"_30106":879,"_20907":52237,"_5":14363,"_27392":51933,"_2946":52238},[],"**Go to DMS owned devices** restricts inventory by owner. **Show/Edit Metadata** contains operational and integration data; consult the integration guide before changing it. &#x2A;*EST (RFC-7030)** helps locate URLs.",{"_3461":1000,"_30106":879,"_20907":52240,"_5":14363,"_27392":51933,"_2946":52241},[],"**Delete** removes the DMS record and configuration; it does not itself cascade revocation across every device and certificate. Migrate dependencies and retain audit references before retirement.",{"_3461":1001,"_30106":879,"_20907":52243,"_5":14363,"_27392":51937,"_2946":52244},[],"Continue with EST client or the enrollment and mTLS tutorial. EST reference covers formats; Troubleshooting covers failures.",{"_3461":1002,"_30106":1002,"_5":14715,"_2946":52246,"_30438":52247,"_20907":52248,"_27392":1002},"Integrate the EST client",[49125,50593,51607,51605,51788],[],{"_3461":1003,"_30106":1002,"_20907":52250,"_5":14363,"_27392":1002,"_2946":52251},[],"Prepare trust, send a CSR and check the identity you receive.",{"_3461":1004,"_30106":1002,"_5":30435,"_20907":52253,"_27392":52254,"_2946":49135},[],"/docs/platform/iot-fleets/enrollment/est-client#before-you-begin",{"_3461":1005,"_30106":1002,"_5":30435,"_20907":52256,"_27392":52257,"_2946":52258},[],"/docs/platform/iot-fleets/enrollment/est-client#download-and-inspect-cacerts","Download and inspect cacerts",{"_3461":1006,"_30106":1002,"_5":30435,"_20907":52260,"_27392":52261,"_2946":52262},[],"/docs/platform/iot-fleets/enrollment/est-client#prepare-the-csr","Prepare the CSR",{"_3461":1007,"_30106":1002,"_5":30435,"_20907":52264,"_27392":52265,"_2946":52266},[],"/docs/platform/iot-fleets/enrollment/est-client#request-the-identity","Request the identity",{"_3461":1008,"_30106":1002,"_5":30435,"_20907":52268,"_27392":52269,"_2946":52270},[],"/docs/platform/iot-fleets/enrollment/est-client#check-and-install-the-result","Check and install the result",{"_3461":1009,"_30106":1002,"_5":30435,"_20907":52272,"_27392":52273,"_2946":52274},[],"/docs/platform/iot-fleets/enrollment/est-client#next-steps","Next steps",{"_3461":1010,"_30106":1002,"_20907":52276,"_5":14363,"_27392":1002,"_2946":52277},[],"This guide is for those implementing the device client. The administrator must have prepared the DMS policy. For a complete first run, follow Enroll and connect your first device.",{"_3461":1011,"_30106":1002,"_20907":52279,"_5":14363,"_27392":52254,"_2946":52280},[],"You need the public HTTPS DMS URL, server trust obtained through an approved channel, the operation's authentication mode and an admitted identifier. The examples use Bash, OpenSSL 3.x and curl with `--fail-with-body`; use a private working directory and compatible versions of these tools.",{"_3461":1012,"_30106":1002,"_20907":52282,"_5":14363,"_27392":52254,"_2946":52283},[],"Prepare `est-trust.pem` to verify the EST server, `bootstrap.crt` and `bootstrap.key` for initial certificate authentication, and `device-root.pem` as the approved root of the device issuer. The two trust files can contain different roots. For another authentication mode, adapt the credentials according to Bootstrap identity.",{"_3461":1013,"_30106":1002,"_20907":52285,"_5":14363,"_27392":52254,"_2946":52286},[],"Replace the host and `REPLACE_DMS_ID` with those of your installation. The URL's APS is the DMS identifier, not its display name.",{"_3461":1014,"_30106":1002,"_20907":52288,"_5":14363,"_27392":52257,"_2946":52289},[],"The default content is Base64-encoded DER PKCS#7. It is not a direct PEM file.",{"_3461":1015,"_30106":1002,"_20907":52291,"_5":14363,"_27392":52257,"_2946":52292},[],"Check fingerprints, issuers and dates against the trust distribution policy. The response can contain a selection of CAs and Lamassu's TLS certificate. Do not turn the entire bundle into trusted roots or use it to authenticate its own initial download. HTTP 200 here does not prove that authentication or issuance works.",{"_3461":1016,"_30106":1002,"_20907":52294,"_5":14363,"_27392":52261,"_2946":52295},[],"The example generates a new EC P-256 key and uses `est-device-001`, which must be available if the DMS registers automatically. The `Common Name` becomes the device identifier. Check that the profile permits the selected key and subject.",{"_3461":1017,"_30106":1002,"_20907":52297,"_5":14363,"_27392":52261,"_2946":52298},[],"An implementation using hardware or its own store must produce the CSR through its resident key. `simpleenroll` sends the request and retains the key in the client. Honor Extensions does not authorize every requested attribute: see Profiles.",{"_3461":1018,"_30106":1002,"_20907":52300,"_5":14363,"_27392":52265,"_2946":52301},[],"With initial `CLIENT_CERTIFICATE` authentication, send the Base64-encoded DER CSR using `Content-Type: application/pkcs10`:",{"_3461":1019,"_30106":1002,"_20907":52303,"_5":14363,"_27392":52265,"_2946":52304},[],"Stop if curl fails. Retain the HTTP code, headers and body for diagnosis; an error response is not decoded as a certificate. The Bash example stops before that conversion. A timeout leaves the operation's result to be checked in Lamassu: do not automatically repeat issuance.",{"_3461":1020,"_30106":1002,"_20907":52306,"_5":14363,"_27392":52269,"_2946":52307},[],"For a root that issues directly:",{"_3461":1021,"_30106":1002,"_20907":52309,"_5":14363,"_27392":52269,"_2946":52310},[],"Also verify that the CN is correct, the certificate is a leaf, its uses permit your application and its dates satisfy the profile. `cmp` must exit with code 0. With intermediates, provide the chain through `-untrusted` as described in PKI validation.",{"_3461":1022,"_30106":1002,"_20907":52312,"_5":14363,"_27392":52269,"_2946":52313},[],"Query the device: the owning DMS, current serial number and history must match the result. Protect the key/certificate pair and install both using the device's mechanism. Association in Lamassu does not install files in the client. Check a real connection before considering the process complete.",{"_3461":1023,"_30106":1002,"_20907":52315,"_5":14363,"_27392":52273,"_2946":52316},[],"Implement renewal and recovery and trust updates. The EST reference covers endpoints, formats and ServerKeyGen; troubleshooting helps distinguish transport, admission and persistence failures.",{"_3461":1024,"_30106":1024,"_5":14715,"_2946":52318,"_30438":52319,"_20907":52320,"_27392":1024},"EST reference",[49125,50593,51607,51605,51788],[],{"_3461":1025,"_30106":1024,"_20907":52322,"_5":14363,"_27392":1024,"_2946":52323},[],"Look up Lamassu routes, formats, authentication and multipart responses.",{"_3461":1026,"_30106":1024,"_5":30435,"_20907":52325,"_27392":52326,"_2946":52327},[],"/docs/platform/iot-fleets/enrollment/est-reference#endpoint-reference","Endpoint reference",{"_3461":1027,"_30106":1024,"_5":30435,"_20907":52329,"_27392":52330,"_2946":22658},[],"/docs/platform/iot-fleets/enrollment/est-reference#cacerts",{"_3461":1028,"_30106":1024,"_5":30435,"_20907":52332,"_27392":52333,"_2946":26007},[],"/docs/platform/iot-fleets/enrollment/est-reference#simpleenroll",{"_3461":1029,"_30106":1024,"_5":30435,"_20907":52335,"_27392":52336,"_2946":26014},[],"/docs/platform/iot-fleets/enrollment/est-reference#simplereenroll",{"_3461":1030,"_30106":1024,"_5":30435,"_20907":52338,"_27392":52339,"_2946":25333},[],"/docs/platform/iot-fleets/enrollment/est-reference#serverkeygen",{"_3461":1031,"_30106":1024,"_5":30435,"_20907":52341,"_27392":52342,"_2946":52343},[],"/docs/platform/iot-fleets/enrollment/est-reference#response-format","Response format",{"_3461":1032,"_30106":1024,"_5":30435,"_20907":52345,"_27392":52346,"_2946":52347},[],"/docs/platform/iot-fleets/enrollment/est-reference#request-and-extraction","Request and extraction",{"_3461":1033,"_30106":1024,"_5":30435,"_20907":52349,"_27392":52350,"_2946":52351},[],"/docs/platform/iot-fleets/enrollment/est-reference#compatibility-notes","Compatibility notes",{"_3461":1034,"_30106":1024,"_20907":52353,"_5":14363,"_27392":1024,"_2946":52354},[],"Reference for the examined backend, based on RFC 7030. Use EST client for the procedure and DMS to configure policy.",{"_3461":1035,"_30106":1024,"_20907":52356,"_5":14363,"_27392":52326,"_2946":52357},[],"Public route in the examples: `/.well-known/est/{APS}/{operation}`. `APS` is the DMS ID. The router admits routes without that segment, but the controller requires it; do not use them as a default service. Gateway configuration determines the public host and route.",{"_3461":1036,"_30106":1024,"_20907":52359,"_5":14363,"_27392":52326,"_2946":52360},[],"Operation",{"_3461":1037,"_30106":1024,"_20907":52362,"_5":14363,"_27392":52326,"_2946":52363},[],"Method",{"_3461":1038,"_30106":1024,"_20907":52365,"_5":14363,"_27392":52326,"_2946":52366},[],"Authentication and condition",{"_3461":1039,"_30106":1024,"_20907":52368,"_5":14363,"_27392":52326,"_2946":52369},[],"`/cacerts`",{"_3461":1040,"_30106":1024,"_20907":52371,"_5":14363,"_27392":52326,"_2946":52372},[],"GET",{"_3461":1041,"_30106":1024,"_20907":52374,"_5":14363,"_27392":52326,"_2946":52375},[],"DMS reading does not require an EST credential; HTTPS and infrastructure controls still apply.",{"_3461":1042,"_30106":1024,"_20907":52377,"_5":14363,"_27392":52326,"_2946":52378},[],"`/simpleenroll`",{"_3461":1043,"_30106":1024,"_20907":52380,"_5":14363,"_27392":52326,"_2946":52381},[],"POST",{"_3461":1044,"_30106":1024,"_20907":52383,"_5":14363,"_27392":52326,"_2946":52384},[],"Initial authentication and DMS registration/replacement policy.",{"_3461":1045,"_30106":1024,"_20907":52386,"_5":14363,"_27392":52326,"_2946":52387},[],"`/simplereenroll`",{"_3461":1046,"_30106":1024,"_20907":52389,"_5":14363,"_27392":52326,"_2946":52381},[],{"_3461":1047,"_30106":1024,"_20907":52391,"_5":14363,"_27392":52326,"_2946":52392},[],"Renewal authentication, existing identity, subject, revocation and window.",{"_3461":1048,"_30106":1024,"_20907":52394,"_5":14363,"_27392":52326,"_2946":52395},[],"`/serverkeygen`",{"_3461":1049,"_30106":1024,"_20907":52397,"_5":14363,"_27392":52326,"_2946":52381},[],{"_3461":1050,"_30106":1024,"_20907":52399,"_5":14363,"_27392":52326,"_2946":52400},[],"Initial authentication and admission; server generation enabled.",{"_3461":1051,"_30106":1024,"_20907":52402,"_5":14363,"_27392":52326,"_2946":52403},[],"These routes do not implement `/csrattrs` or `/fullcmc`. There is no native JWT EST authentication mode; a webhook can interpret a request credential according to its own contract.",{"_3461":1052,"_30106":1024,"_20907":52405,"_5":14363,"_27392":52330,"_2946":52406},[],"The default response has `Content-Type: application/pkcs7-mime; smime-type=certs-only` and `Content-Transfer-Encoding: base64`. The body is Base64-encoded DER PKCS#7 with lines of up to 76 characters. It includes the certificates selected by the DMS, not necessarily every ancestor.",{"_3461":1053,"_30106":1024,"_20907":52408,"_5":14363,"_27392":52330,"_2946":52409},[],"`Accept: application/x-pem-file` requests the bundle in PEM through a Lamassu extension. Inspect and approve its contents before modifying trusted roots.",{"_3461":1054,"_30106":1024,"_20907":52411,"_5":14363,"_27392":52333,"_2946":52412},[],"Send a Base64-encoded DER PKCS#10 CSR with `Content-Type: application/pkcs10`. The examined controller compares that media type literally; avoid adding parameters such as charset. The CN identifies the device and the CSR signature must be verified through DMS policy.",{"_3461":1055,"_30106":1024,"_20907":52414,"_5":14363,"_27392":52333,"_2946":52415},[],"The default response uses the PKCS#7/Base64 format described for cacerts, but contains the issued certificate; do not assume it includes its entire chain. `Accept: application/x-pem-file` returns that certificate in PEM. The client retains the key that signed the CSR.",{"_3461":1056,"_30106":1024,"_20907":52417,"_5":14363,"_27392":52336,"_2946":52418},[],"Use the same request and certificate response formats. Authentication comes from the independent `reenrollment_settings.est_rfc7030_settings` block. With a client certificate, its CN must match the CSR CN; the subject is also checked against the current certificate.",{"_3461":1057,"_30106":1024,"_20907":52420,"_5":14363,"_27392":52336,"_2946":52421},[],"In mTLS mode, the enrollment CA always validates the re-enrollment credential; certificates from other issuers are accepted only if they are listed as validation CAs in the re-enrollment block. The expiry check through `enable_expired_renewal` belongs to that validator. A revoked current certificate and a request before the window are rejected. See Renewal for installation and recovery.",{"_3461":1058,"_30106":1024,"_20907":52423,"_5":14363,"_27392":52339,"_2946":52424},[],"The server generates a software key, rebuilds the CSR with that key and performs initial enrollment. The flag must be enabled and the algorithm permitted by the profile. This operation's key does not become a hardware key because the CA is hosted in an HSM.",{"_3461":1059,"_30106":1024,"_20907":52426,"_5":14363,"_27392":52339,"_2946":52427},[],"The code supports RSA and ECDSA, and the `bits` value of the DMS key setting means something different for each. For ECDSA it selects the curve: 224, 256, 384 or 521 map to P-224, P-256, P-384 and P-521, and an unrecognized size falls back to P-256, so explicitly select a compatible size and check the resulting key. For RSA it is used directly as the modulus size; the console offers 2048, 3072 and 4096 bits. Do not reuse an enrolled ID to test this operation without reviewing replacement.",{"_3461":1060,"_30106":1024,"_20907":52429,"_5":14363,"_27392":52342,"_2946":52430},[],"The body is **MIME multipart/mixed**, with the boundary specified in `Content-Type`. It contains two parts:",{"_3461":1061,"_30106":1024,"_20907":52432,"_5":14363,"_27392":52342,"_2946":52433},[],"Part",{"_3461":1062,"_30106":1024,"_20907":52435,"_5":14363,"_27392":52342,"_2946":52436},[],"Content after decoding its Base64",{"_3461":1063,"_30106":1024,"_20907":52438,"_5":14363,"_27392":52342,"_2946":52439},[],"`application/pkcs8`",{"_3461":1064,"_30106":1024,"_20907":52441,"_5":14363,"_27392":52342,"_2946":52442},[],"Unencrypted DER PKCS#8 private key.",{"_3461":1065,"_30106":1024,"_20907":52444,"_5":14363,"_27392":52342,"_2946":52445},[],"`application/pkcs7-mime; smime-type=certs-only`",{"_3461":1066,"_30106":1024,"_20907":52447,"_5":14363,"_27392":52342,"_2946":52448},[],"DER PKCS#7 containing the issued certificate.",{"_3461":1067,"_30106":1024,"_20907":52450,"_5":14363,"_27392":52342,"_2946":52451},[],"The controller also adds `Content-Transfer-Encoding: base64` to the outer header, although the outer body is MIME text. &#x2A;*Do not Base64-decode the entire body.** Read the actual boundary and decode each part according to its headers.",{"_3461":1068,"_30106":1024,"_20907":52453,"_5":14363,"_27392":52346,"_2946":52454},[],"In a Bash session with `set -euo pipefail` and `umask 077`, use `EST_BASE` and the trust/bootstrap files from EST client. Select an available and admitted `est-serverkeygen-001`. The `server-request.key` only signs the input CSR; the received identity uses the server-generated key.",{"_3461":1069,"_30106":1024,"_20907":52456,"_5":14363,"_27392":52346,"_2946":52457},[],"Save this Python 3 extractor. It validates both parts before writing and rejects existing output files:",{"_3461":1070,"_30106":1024,"_20907":52459,"_5":14363,"_27392":52346,"_2946":52460},[],"Convert and check the result:",{"_3461":1071,"_30106":1024,"_20907":52462,"_5":14363,"_27392":52346,"_2946":52463},[],"Inspect the CN, serial, dates and uses; check association in Lamassu before installing. Protect the DER and PEM files containing the key and remove temporary copies according to the device's storage mechanism. See openssl-pkcs8 and the Python MIME parser.",{"_3461":1072,"_30106":1024,"_20907":52465,"_5":14363,"_27392":52350,"_2946":52466},[],"Do not interpret every 500 as a transient failure. Invalid input typically produces 400; service denials and errors typically produce 500 with a JSON `err` body. Gateway errors and some controller paths can have another format. Retain headers and body before decoding and see troubleshooting.",{"_3461":1073,"_30106":1024,"_20907":52468,"_5":14363,"_27392":52350,"_2946":52469},[],"The examples use openssl-pkcs7 to extract certificates and openssl-x509 to prepare renewal. Check your version's capabilities and responses before integrating a generic EST client.",{"_3461":1074,"_30106":1074,"_5":14715,"_2946":51788,"_30438":52471,"_20907":52472,"_27392":1074},[49125,50593,51607,51605,51788],[],{"_3461":1075,"_30106":1074,"_20907":52474,"_5":14363,"_27392":1074,"_2946":52475},[],"Choose admission policy and connect DMS, initial trust and the EST client.",{"_3461":1076,"_30106":1074,"_5":30435,"_20907":52477,"_27392":52478,"_2946":52479},[],"/docs/platform/iot-fleets/enrollment/overview#the-journey","The journey",{"_3461":1077,"_30106":1074,"_5":30435,"_20907":52481,"_27392":52482,"_2946":52483},[],"/docs/platform/iot-fleets/enrollment/overview#for-the-administrator","For the administrator",{"_3461":1078,"_30106":1074,"_5":30435,"_20907":52485,"_27392":52486,"_2946":52487},[],"/docs/platform/iot-fleets/enrollment/overview#for-the-integrator","For the integrator",{"_3461":1079,"_30106":1074,"_5":30435,"_20907":52489,"_27392":52490,"_2946":52491},[],"/docs/platform/iot-fleets/enrollment/overview#contract-version","Contract version",{"_3461":1080,"_30106":1074,"_20907":52493,"_5":14363,"_27392":1074,"_2946":52494},[],"Enrollment with PKI covers the path from device admission to identity installation and renewal. The DMS acts as a registration authority: it authenticates the request, applies registration policy and asks the CA to sign. The client keeps or receives the key, installs the result and presents it to the consumer.",{"_3461":1081,"_30106":1074,"_20907":52496,"_5":14363,"_27392":52478,"_2946":52497},[],"The administrator prepares the CA, issuance profile and DMS.",{"_3461":1082,"_30106":1074,"_20907":52499,"_5":14363,"_27392":52478,"_2946":52500},[],"The integrator installs initial EST server trust and an admission credential.",{"_3461":1083,"_30106":1074,"_20907":52502,"_5":14363,"_27392":52478,"_2946":52503},[],"The client requests an identity for its `Device ID` through EST.",{"_3461":1084,"_30106":1074,"_20907":52505,"_5":14363,"_27392":52478,"_2946":52506},[],"Certificate, device binding and key/certificate installation are checked.",{"_3461":1085,"_30106":1074,"_20907":52508,"_5":14363,"_27392":52478,"_2946":52509},[],"The consumer validates and authorizes the identity; the client schedules renewal and recovery.",{"_3461":1086,"_30106":1074,"_20907":52511,"_5":14363,"_27392":52478,"_2946":52512},[],"EST uses `/.well-known/est/{DMS_ID}`. Administrative APIs and manual assignment remain separate paths. Enroll and connect a device completes an initial mTLS test.",{"_3461":1087,"_30106":1074,"_20907":52514,"_5":14363,"_27392":52482,"_2946":52515},[],"<Card title=\"Provisioning strategies\" description=\"Choose automatic registration, preregistration or manual assignment.\" href=\"/docs/platform/iot-fleets/enrollment/provisioning-strategies\" />",{"_3461":1088,"_30106":1074,"_20907":52517,"_5":14363,"_27392":52482,"_2946":52518},[],"<Card title=\"Configure the DMS\" description=\"Separate admission, authentication per operation, profiles and distribution.\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_3461":1089,"_30106":1074,"_20907":52520,"_5":14363,"_27392":52482,"_2946":52521},[],"<Card title=\"Bootstrap identity and authentication\" description=\"Decide which proof allows requesting the first identity.\" href=\"/docs/platform/iot-fleets/enrollment/bootstrap-identity\" />",{"_3461":1090,"_30106":1074,"_20907":52523,"_5":14363,"_27392":52482,"_2946":52524},[],"<Card title=\"Trust distribution\" description=\"Update roots and chains with verified overlap.\" href=\"/docs/platform/iot-fleets/enrollment/trust-distribution\" />",{"_3461":1091,"_30106":1074,"_20907":52526,"_5":14363,"_27392":52486,"_2946":52527},[],"<Card title=\"EST client\" description=\"Prepare the request, verify the response and install the identity.\" href=\"/docs/platform/iot-fleets/enrollment/est-client\" />",{"_3461":1092,"_30106":1074,"_20907":52529,"_5":14363,"_27392":52486,"_2946":52530},[],"<Card title=\"Renewal and recovery\" description=\"Generate the successor and handle expired or lost credentials.\" href=\"/docs/platform/iot-fleets/enrollment/renewal-and-recovery\" />",{"_3461":1093,"_30106":1074,"_20907":52532,"_5":14363,"_27392":52486,"_2946":52533},[],"<Card title=\"EST reference\" description=\"Look up paths, formats, authentication and ServerKeyGen.\" href=\"/docs/platform/iot-fleets/enrollment/est-reference\" />",{"_3461":1094,"_30106":1074,"_20907":52535,"_5":14363,"_27392":52486,"_2946":52536},[],"<Card title=\"Troubleshooting\" description=\"Distinguish transport, policy, issuance and installation failures.\" href=\"/docs/platform/iot-fleets/enrollment/troubleshooting\" />",{"_3461":1095,"_30106":1074,"_20907":52538,"_5":14363,"_27392":52490,"_2946":52539},[],"This block describes `main` code inspected at commit `8f42c47157f9a36bac3ed5caa3692aebebe19c4b`. The site catalog publishes `main (unstable)`; this behavior is not attributed to a stable release. Before using another version, check its contract, particularly independent re-enrollment authentication. Client checks and live-instance tests are distinguished in the revision plan.",{"_3461":1096,"_30106":1074,"_20907":52541,"_5":14363,"_27392":52490,"_2946":52542},[],"Gateway, TLS, provider and service configuration belongs to Deployment. Identity use in AWS or other destinations belongs to Integrations.",{"_3461":1097,"_30106":1097,"_5":14715,"_2946":52544,"_30438":52545,"_20907":52546,"_27392":1097},"Provisioning strategies",[49125,50593,51607,51605,51788],[],{"_3461":1098,"_30106":1097,"_20907":52548,"_5":14363,"_27392":1097,"_2946":52549},[],"Choose device registration, identity authorization and key generation.",{"_3461":1099,"_30106":1097,"_5":30435,"_20907":52551,"_27392":52552,"_2946":52553},[],"/docs/platform/iot-fleets/enrollment/provisioning-strategies#choose-registration","Choose registration",{"_3461":1100,"_30106":1097,"_5":30435,"_20907":52555,"_27392":52556,"_2946":52557},[],"/docs/platform/iot-fleets/enrollment/provisioning-strategies#preregistration-and-replacement","Preregistration and replacement",{"_3461":1101,"_30106":1097,"_5":30435,"_20907":52559,"_27392":52560,"_2946":52561},[],"/docs/platform/iot-fleets/enrollment/provisioning-strategies#choose-authentication","Choose authentication",{"_3461":1102,"_30106":1097,"_5":30435,"_20907":52563,"_27392":52564,"_2946":52565},[],"/docs/platform/iot-fleets/enrollment/provisioning-strategies#choose-custody","Choose custody",{"_3461":1103,"_30106":1097,"_5":30435,"_20907":52567,"_27392":52568,"_2946":52569},[],"/docs/platform/iot-fleets/enrollment/provisioning-strategies#check-the-decision","Check the decision",{"_3461":1104,"_30106":1097,"_20907":52571,"_5":14363,"_27392":1097,"_2946":52572},[],"This guide helps the provisioning administrator choose a path before configuring the DMS. Separate three decisions: when the device exists, how its request is authorized and who generates its key. None grants destination access by itself.",{"_3461":1105,"_30106":1097,"_20907":52574,"_5":14363,"_27392":52552,"_2946":52575},[],"Path",{"_3461":1106,"_30106":1097,"_20907":52577,"_5":14363,"_27392":52552,"_2946":52578},[],"When the device exists",{"_3461":1107,"_30106":1097,"_20907":52580,"_5":14363,"_27392":52552,"_2946":52581},[],"What to check",{"_3461":1108,"_30106":1097,"_20907":52583,"_5":14363,"_27392":52552,"_2946":52584},[],"Manual assignment",{"_3461":1109,"_30106":1097,"_20907":52586,"_5":14363,"_27392":52552,"_2946":52587},[],"An operator creates it before associating a certificate.",{"_3461":1110,"_30106":1097,"_20907":52589,"_5":14363,"_27392":52552,"_2946":52590},[],"ID, owning DMS, certificate CN and bound serial.",{"_3461":1111,"_30106":1097,"_20907":52592,"_5":14363,"_27392":52552,"_2946":52593},[],"EST with `JITP`",{"_3461":1112,"_30106":1097,"_20907":52595,"_5":14363,"_27392":52552,"_2946":52596},[],"Created for an unknown CN during `/simpleenroll`.",{"_3461":1113,"_30106":1097,"_20907":52598,"_5":14363,"_27392":52552,"_2946":52599},[],"Authorized credential, unused ID, profile, resulting registration and identity.",{"_3461":1114,"_30106":1097,"_20907":52601,"_5":14363,"_27392":52552,"_2946":52602},[],"EST with `PRE_REGISTRATION`",{"_3461":1115,"_30106":1097,"_20907":52604,"_5":14363,"_27392":52552,"_2946":52605},[],"Must exist before `/simpleenroll`.",{"_3461":1116,"_30106":1097,"_20907":52607,"_5":14363,"_27392":52552,"_2946":52608},[],"Approved record, same DMS and replacement conditions for your version.",{"_3461":1117,"_30106":1097,"_20907":52610,"_5":14363,"_27392":52552,"_2946":52611},[],"Lamassu `JITP` creates inventory and identity in Lamassu. AWS JITP provisions a destination in AWS; these are separate decisions.",{"_3461":1118,"_30106":1097,"_20907":52613,"_5":14363,"_27392":52552,"_2946":52614},[],"For an initial client test, use Enroll and connect a device. To prepare inventory without EST, follow Manual registration.",{"_3461":1119,"_30106":1097,"_20907":52616,"_5":14363,"_27392":52556,"_2946":52617},[],"In the inspected code, finding any device owned by the same DMS triggers the `enable_replaceable_enrollment` check before PRE\\_REGISTRATION. With the flag disabled, a preregistered device can receive `forbiddenNewEnrollment` even in **No Identity**. Selecting PRE\\_REGISTRATION alone therefore does not establish a working path.",{"_3461":1120,"_30106":1097,"_20907":52619,"_5":14363,"_27392":52556,"_2946":52620},[],"Enabling the flag permits repeated `/simpleenroll` for an existing ID. The backend schedules a deferred attempt to revoke the previous certificate with `Superseded`; it can also run if later issuance or binding fails. Without an identity, that attempt can fail because no serial exists. The flag does not provide a replacement transaction or guarantee restoration of previous state.",{"_3461":1121,"_30106":1097,"_20907":52622,"_5":14363,"_27392":52556,"_2946":52623},[],"Test the exact case on your version before enabling it for a population. For an operational identity with authorized renewal, use `/simplereenroll`; for recovery, follow Renewal and recovery and check persisted state before retrying.",{"_3461":1122,"_30106":1097,"_20907":52625,"_5":14363,"_27392":52560,"_2946":52626},[],"Decide initial enrollment and re-enrollment separately:",{"_3461":1123,"_30106":1097,"_20907":52628,"_5":14363,"_27392":52560,"_2946":52629},[],"**Client certificate:** useful when each device has an initial credential whose key it controls.",{"_3461":1124,"_30106":1097,"_20907":52631,"_5":14363,"_27392":52560,"_2946":52632},[],"**Webhook:** useful when another authority knows inventory, credentials or entitlement to a requested ID.",{"_3461":1125,"_30106":1097,"_20907":52634,"_5":14363,"_27392":52560,"_2946":52635},[],"**Certificate and webhook:** requires both controls in the configured operation.",{"_3461":1126,"_30106":1097,"_20907":52637,"_5":14363,"_27392":52560,"_2946":52638},[],"**NO\\_AUTH:** does not establish requester identity; appropriate only when admission is deliberately controlled outside that DMS.",{"_3461":1127,"_30106":1097,"_20907":52640,"_5":14363,"_27392":52560,"_2946":52641},[],"Authenticating an initial certificate does not itself establish entitlement to choose any CSR CN. Define that authorization in Bootstrap identity and authentication.",{"_3461":1128,"_30106":1097,"_20907":52643,"_5":14363,"_27392":52564,"_2946":49509},[],{"_3461":1129,"_30106":1097,"_20907":52645,"_5":14363,"_27392":52564,"_2946":52646},[],"Material crossing EST",{"_3461":1130,"_30106":1097,"_20907":52648,"_5":14363,"_27392":52564,"_2946":52649},[],"Device-generated key",{"_3461":1131,"_30106":1097,"_20907":52651,"_5":14363,"_27392":52564,"_2946":52652},[],"Public CSR and certificate; the key stays on the client.",{"_3461":1132,"_30106":1097,"_20907":52654,"_5":14363,"_27392":52564,"_2946":52655},[],"Existing device key",{"_3461":1133,"_30106":1097,"_20907":52657,"_5":14363,"_27392":52564,"_2946":52658},[],"CSR signed with that key and a new certificate.",{"_3461":1134,"_30106":1097,"_20907":52660,"_5":14363,"_27392":52564,"_2946":51926},[],{"_3461":1135,"_30106":1097,"_20907":52662,"_5":14363,"_27392":52564,"_2946":52663},[],"Private PKCS#8 key and certificate in a TLS-protected multipart response.",{"_3461":1136,"_30106":1097,"_20907":52665,"_5":14363,"_27392":52564,"_2946":52666},[],"ServerKeyGen does not automatically use the CA’s HSM or KMS for the device key. Review its contract and extraction and the device’s ability to install the material.",{"_3461":1137,"_30106":1097,"_20907":52668,"_5":14363,"_27392":52568,"_2946":52669},[],"Before expanding the flow, test allowed registration, incorrect credentials, an ID owned by another DMS, repeated requests and recovery after failure. Keep ID, serial, active version and error. Also test consumer acceptance and rejection; issuance does not imply destination registration or permission to operate.",{"_3461":1138,"_30106":1138,"_5":14715,"_2946":52671,"_30438":52672,"_20907":52673,"_27392":1138},"Renewal and recovery",[49125,50593,51607,51605,51788],[],{"_3461":1139,"_30106":1138,"_20907":52675,"_5":14363,"_27392":1138,"_2946":52676},[],"Renew without losing the identity and recover devices according to their actual state.",{"_3461":1140,"_30106":1138,"_5":30435,"_20907":52678,"_27392":52679,"_2946":52680},[],"/docs/platform/iot-fleets/enrollment/renewal-and-recovery#prepare-renewal","Prepare renewal",{"_3461":1141,"_30106":1138,"_5":30435,"_20907":52682,"_27392":52683,"_2946":52684},[],"/docs/platform/iot-fleets/enrollment/renewal-and-recovery#request-the-successor-certificate","Request the successor certificate",{"_3461":1142,"_30106":1138,"_5":30435,"_20907":52686,"_27392":52687,"_2946":52688},[],"/docs/platform/iot-fleets/enrollment/renewal-and-recovery#install-and-check-the-new-pair","Install and check the new pair",{"_3461":1143,"_30106":1138,"_5":30435,"_20907":52690,"_27392":52691,"_2946":52692},[],"/docs/platform/iot-fleets/enrollment/renewal-and-recovery#recover-according-to-state","Recover according to state",{"_3461":1144,"_30106":1138,"_5":30435,"_20907":52694,"_27392":52695,"_2946":52696},[],"/docs/platform/iot-fleets/enrollment/renewal-and-recovery#continuous-operation","Continuous operation",{"_3461":1145,"_30106":1138,"_20907":52698,"_5":14363,"_27392":1138,"_2946":52699},[],"Renewal retains the device identifier and requests a successor certificate. The client must complete the process: check the response, install the matching pair and demonstrate that the consumer accepts it. Lamassu alerts notify you; they do not perform those steps.",{"_3461":1146,"_30106":1138,"_20907":52701,"_5":14363,"_27392":52679,"_2946":52702},[],"Query the current certificate in Lamassu and compare it with the installed certificate. You need its subject, serial and dates, as well as the client key.",{"_3461":1147,"_30106":1138,"_20907":52704,"_5":14363,"_27392":52679,"_2946":52705},[],"Check the **re-enrollment** authentication mode: it is independent of initial authentication. With `CLIENT_CERTIFICATE`, use the current identity; do not assume the bootstrap credential is admitted.",{"_3461":1148,"_30106":1138,"_20907":52707,"_5":14363,"_27392":52679,"_2946":52708},[],"Calculate the window's start: the current certificate's `NotAfter` minus `reenrollment_delta`. Preventive and critical thresholds produce states/notifications; they do not extend that window.",{"_3461":1149,"_30106":1138,"_20907":52710,"_5":14363,"_27392":52679,"_2946":52711},[],"Review **Revoke on Re-enrollment** and recovery if installation fails. When enabled, Lamassu can revoke the previous identity before the client installs the new one.",{"_3461":1150,"_30106":1138,"_20907":52713,"_5":14363,"_27392":52683,"_2946":52714},[],"The example continues the EST tutorial, in the same Bash session with `set -euo pipefail`, `umask 077` and `EST_BASE`. Use a new key compatible with the profile. Conversion from the certificate preserves the subject and copies only SAN when present; check the subject and requested names before sending it. The backend checks the subject against the current identity: it attempts RawSubject equality and then compares CN, OU, O, L, ST and C. Rebuilding only the CN can lose required attributes.",{"_3461":1151,"_30106":1138,"_20907":52716,"_5":14363,"_27392":52683,"_2946":52717},[],"The request authenticates with `device.crt` and `device.key`; the CSR contains the new public key. Also check extensions, dates and correspondence of the serial with the current slot in Lamassu. Do not resubmit a failed request without querying that state: issuance, previous revocation and successor binding can have partial results.",{"_3461":1152,"_30106":1138,"_20907":52719,"_5":14363,"_27392":52687,"_2946":52720},[],"Keep the result as `device.next.crt` and `device.next.key` until verified. Switch the pair through a coordinated operation in the device store or configuration; avoid temporarily exposing a certificate with another version's key.",{"_3461":1153,"_30106":1138,"_20907":52722,"_5":14363,"_27392":52687,"_2946":52723},[],"Test mTLS with the consumer and verify that it uses the new serial. Confirm the history and current certificate in Lamassu. If **Revoke on Re-enrollment** was disabled, the previous identity can remain valid: retire it according to PKI policy after testing the successor, and check revocation publication and consumption.",{"_3461":1154,"_30106":1138,"_20907":52725,"_5":14363,"_27392":52687,"_2946":52726},[],"If the previous identity is already revoked, retaining its files does not restore a valid connection. Recovery requires an admitted credential and authorized intervention according to the situation.",{"_3461":1155,"_30106":1138,"_20907":52728,"_5":14363,"_27392":52691,"_2946":52729},[],"Situation",{"_3461":1156,"_30106":1138,"_20907":52731,"_5":14363,"_27392":52691,"_2946":52732},[],"Procedure",{"_3461":1157,"_30106":1138,"_20907":52734,"_5":14363,"_27392":52691,"_2946":52735},[],"Valid certificate, outside the window",{"_3461":1158,"_30106":1138,"_20907":52737,"_5":14363,"_27392":52691,"_2946":52738},[],"Schedule the request within the window. Do not use `simpleenroll` to bypass it.",{"_3461":1159,"_30106":1138,"_20907":52740,"_5":14363,"_27392":52691,"_2946":52741},[],"Expired certificate, key available",{"_3461":1160,"_30106":1138,"_20907":52743,"_5":14363,"_27392":52691,"_2946":52744},[],"With certificate authentication, review `enable_expired_renewal` and whether Gateway permits presenting that credential. Revocation, subject and the remaining checks still apply.",{"_3461":1161,"_30106":1138,"_20907":52746,"_5":14363,"_27392":52691,"_2946":52747},[],"Renewal through webhook or `NO_AUTH`",{"_3461":1162,"_30106":1138,"_20907":52749,"_5":14363,"_27392":52691,"_2946":52750},[],"The mTLS expiry check does not run in these modes. Define expiry and authorization policy in the corresponding admission process; the flag is not a universal prohibition.",{"_3461":1163,"_30106":1138,"_20907":52752,"_5":14363,"_27392":52691,"_2946":52753},[],"Lost or inaccessible key",{"_3461":1164,"_30106":1138,"_20907":52755,"_5":14363,"_27392":52691,"_2946":52756},[],"You cannot prove possession of the previous identity. Authorize new admission and, if appropriate, controlled replacement; revoke the compromised identity.",{"_3461":1165,"_30106":1138,"_20907":52758,"_5":14363,"_27392":52691,"_2946":52759},[],"Current identity revoked",{"_3461":1166,"_30106":1138,"_20907":52761,"_5":14363,"_27392":52691,"_2946":52762},[],"`simplereenroll` rejects the revoked current certificate. Investigate the reason and prepare an authorized readmission procedure; do not disable authentication to force it.",{"_3461":1167,"_30106":1138,"_20907":52764,"_5":14363,"_27392":52691,"_2946":52765},[],"Device without an identity",{"_3461":1168,"_30106":1138,"_20907":52767,"_5":14363,"_27392":52691,"_2946":52768},[],"Use initial enrollment. For an existing entry, check the replacement restriction in provisioning.",{"_3461":1169,"_30106":1138,"_20907":52770,"_5":14363,"_27392":52691,"_2946":52771},[],"Retired device",{"_3461":1170,"_30106":1138,"_20907":52773,"_5":14363,"_27392":52691,"_2946":52774},[],"Review the operational decision before readmission. Decommissioned state and revocation of the entire history are not equivalent.",{"_3461":1171,"_30106":1138,"_20907":52776,"_5":14363,"_27392":52691,"_2946":52777},[],"Timeout, HTTP 500 or installation failure",{"_3461":1172,"_30106":1138,"_20907":52779,"_5":14363,"_27392":52691,"_2946":52780},[],"Inspect the device, issued certificates and history before retrying. A successor may have been issued or the previous identity revoked.",{"_3461":1173,"_30106":1138,"_20907":52782,"_5":14363,"_27392":52695,"_2946":52783},[],"Schedule renewal with time for disconnections, trust distribution and consumer checks. Stagger requests across the population and bound retries within the window; authentication, subject and policy errors require correcting their cause. Maintain an admitted and tested recovery mechanism for lost keys and pairs that could not be installed.",{"_3461":1174,"_30106":1138,"_20907":52785,"_5":14363,"_27392":52695,"_2946":52786},[],"Continue with Trust distribution, Devices and identities and Troubleshooting.",{"_3461":1175,"_30106":1175,"_5":14715,"_2946":52788,"_30438":52789,"_20907":52790,"_27392":1175},"Enrollment troubleshooting",[49125,50593,51607,51605,51788],[],{"_3461":1176,"_30106":1175,"_20907":52792,"_5":14363,"_27392":1175,"_2946":52793},[],"Locate transport, authentication, registration, issuance and installation failures.",{"_3461":1177,"_30106":1175,"_5":30435,"_20907":52795,"_27392":52796,"_2946":52797},[],"/docs/platform/iot-fleets/enrollment/troubleshooting#diagnostics-and-compatibility","Diagnostics and compatibility",{"_3461":1178,"_30106":1175,"_5":30435,"_20907":52799,"_27392":52800,"_2946":52801},[],"/docs/platform/iot-fleets/enrollment/troubleshooting#error-codes-and-diagnostics","Error codes and diagnostics",{"_3461":1179,"_30106":1175,"_5":30435,"_20907":52803,"_27392":52804,"_2946":52351},[],"/docs/platform/iot-fleets/enrollment/troubleshooting#compatibility-notes",{"_3461":1180,"_30106":1175,"_5":30435,"_20907":52806,"_27392":52807,"_2946":52808},[],"/docs/platform/iot-fleets/enrollment/troubleshooting#est-enrollment-fails","EST enrollment fails",{"_3461":1181,"_30106":1175,"_20907":52810,"_5":14363,"_27392":1175,"_2946":52811},[],"Diagnose one operation and device at a time. Record the DMS/APS, endpoint, time, HTTP code, presented serial and CSR CN. Retain the response without including private keys or webhook credentials in the report.",{"_3461":1182,"_30106":1175,"_20907":52813,"_5":14363,"_27392":52800,"_2946":52814},[],"The EST controller normally returns 400 when rejecting input and 500 when the service rejects or fails the operation. A 500 can also represent a policy denial; it does not mean retrying is safe. Gateway can produce its own codes and bodies. Examine the actual body and persisted result.",{"_3461":1183,"_30106":1175,"_20907":52816,"_5":14363,"_27392":52800,"_2946":52817},[],"Symptom or message",{"_3461":1184,"_30106":1175,"_20907":52819,"_5":14363,"_27392":52800,"_2946":52581},[],{"_3461":1185,"_30106":1175,"_20907":52821,"_5":14363,"_27392":52800,"_2946":52822},[],"curl rejects TLS, name or issuer",{"_3461":1186,"_30106":1175,"_20907":52824,"_5":14363,"_27392":52800,"_2946":52825},[],"URL, clock, server SAN and approved root in `est-trust.pem`. Resolve trust in Deployment; do not skip verification.",{"_3461":1187,"_30106":1175,"_20907":52827,"_5":14363,"_27392":52800,"_2946":52828},[],"404 or missing APS",{"_3461":1188,"_30106":1175,"_20907":52830,"_5":14363,"_27392":52800,"_2946":52831},[],"Public route `/.well-known/est/{DMS_ID}/{operation}` and existing DMS. APS is not the service name.",{"_3461":1189,"_30106":1175,"_20907":52833,"_5":14363,"_27392":52800,"_2946":52834},[],"400, CSR or format error",{"_3461":1190,"_30106":1175,"_20907":52836,"_5":14363,"_27392":52800,"_2946":52837},[],"`Content-Type: application/pkcs10`, Base64 of DER, valid signature and a body preserved without double encoding.",{"_3461":1191,"_30106":1175,"_20907":52839,"_5":14363,"_27392":52800,"_2946":52840},[],"Missing credential or invalid certificate",{"_3461":1192,"_30106":1175,"_20907":52842,"_5":14363,"_27392":52800,"_2946":52843},[],"Operation mode, validating CA, dates, revocation and credential delivery by Gateway. Do not confuse server TLS trust with the bootstrap CA.",{"_3461":1193,"_30106":1175,"_20907":52845,"_5":14363,"_27392":52800,"_2946":52846},[],"Webhook denies, times out or responds without authorization",{"_3461":1194,"_30106":1175,"_20907":52848,"_5":14363,"_27392":52800,"_2946":52849},[],"Configuration, connectivity and JSON response with `authorized: true`. There is no automatic fallback to `NO_AUTH`.",{"_3461":1195,"_30106":1175,"_20907":52851,"_5":14363,"_27392":52800,"_2946":52852},[],"`unexpected status code: <n>: redirects are not followed`",{"_3461":1196,"_30106":1175,"_20907":52854,"_5":14363,"_27392":52800,"_2946":52855},[],"The webhook answered with a redirect. Configure the final absolute `http` or `https` URL in the webhook config; redirects are never followed.",{"_3461":1197,"_30106":1175,"_20907":52857,"_5":14363,"_27392":52800,"_2946":52858},[],"`webhook response exceeds 1048576 bytes`",{"_3461":1198,"_30106":1175,"_20907":52860,"_5":14363,"_27392":52800,"_2946":52861},[],"The receiver returned more than 1 MiB of JSON. Reduce the response of the authorization webhook.",{"_3461":1199,"_30106":1175,"_20907":52863,"_5":14363,"_27392":52800,"_2946":52864},[],"`webhook config must not reference files`",{"_3461":1200,"_30106":1175,"_20907":52866,"_5":14363,"_27392":52800,"_2946":52867},[],"The webhook config points to files (`ca_cert_file`, `mtls_options.cert_file`, `mtls_options.key_file`). For mTLS, enter the certificate and key as Base64-encoded PEM in `cert_content` and `key_content`, or as plain PEM; remove any other file field, including `ca_cert_file`, which has no inline equivalent (the receiver certificate must chain to the system trust store). See the webhook credentials guidance in DMS.",{"_3461":1201,"_30106":1175,"_20907":52869,"_5":14363,"_27392":52800,"_2946":52870},[],"`mtls_options.cert_content must be base64-encoded PEM`",{"_3461":1202,"_30106":1175,"_20907":52872,"_5":14363,"_27392":52800,"_2946":52873},[],"The value is neither Base64-encoded PEM nor plain PEM: it is a file path or Base64 of non-PEM data. Enter the certificate and key as Base64-encoded PEM, like certificates elsewhere in the API, or as plain PEM (see the webhook settings in DMS). The same message names `mtls_options.key_content` when the key is the offending value.",{"_3461":1203,"_30106":1175,"_20907":52875,"_5":14363,"_27392":52800,"_2946":52876},[],"`webhook mTLS certificate and key are invalid: …`",{"_3461":1204,"_30106":1175,"_20907":52878,"_5":14363,"_27392":52800,"_2946":52879},[],"The certificate and key do not form a matching pair. Enter both values from the same pair; the check runs when the DMS is saved and again on every webhook call.",{"_3461":1205,"_30106":1175,"_20907":52881,"_5":14363,"_27392":52800,"_2946":52882},[],"400 `struct validation error` creating or updating a DMS",{"_3461":1206,"_30106":1175,"_20907":52884,"_5":14363,"_27392":52800,"_2946":52885},[],"The webhook config of the operation that uses it is invalid. Review `external_webhook_settings` in DMS.",{"_3461":1207,"_30106":1175,"_20907":52887,"_5":14363,"_27392":52800,"_2946":52888},[],"HTTP 500 with an `err` body on enroll or reenroll",{"_3461":1208,"_30106":1175,"_20907":52890,"_5":14363,"_27392":52800,"_2946":52891},[],"Service failures reach the EST client as 500 with a body of `err` plus the message; webhook authorization errors are named there.",{"_3461":1209,"_30106":1175,"_20907":52893,"_5":14363,"_27392":52800,"_2946":52894},[],"`device not preregistered`",{"_3461":1210,"_30106":1175,"_20907":52896,"_5":14363,"_27392":52800,"_2946":52897},[],"PRE\\_REGISTRATION requires an existing inventory entry.",{"_3461":1211,"_30106":1175,"_20907":52899,"_5":14363,"_27392":52800,"_2946":52900},[],"`forbiddenNewEnrollment`",{"_3461":1212,"_30106":1175,"_20907":52902,"_5":14363,"_27392":52800,"_2946":52903},[],"An existing device requires replacement to be enabled, even in No Identity. Investigate before enabling the flag.",{"_3461":1213,"_30106":1175,"_20907":52905,"_5":14363,"_27392":52800,"_2946":52906},[],"Different owning DMS",{"_3461":1214,"_30106":1175,"_20907":52908,"_5":14363,"_27392":52800,"_2946":52909},[],"CN/ID, global inventory and owning DMS; do not reuse an ID from another context.",{"_3461":1215,"_30106":1175,"_20907":52911,"_5":14363,"_27392":52800,"_2946":52912},[],"`invalid RawSubject bytes`",{"_3461":1216,"_30106":1175,"_20907":52914,"_5":14363,"_27392":52800,"_2946":52915},[],"CSR subject versus the current certificate. Preserve its attributes as well as its CN.",{"_3461":1217,"_30106":1175,"_20907":52917,"_5":14363,"_27392":52800,"_2946":52918},[],"`invalid reenroll window`",{"_3461":1218,"_30106":1175,"_20907":52920,"_5":14363,"_27392":52800,"_2946":52921},[],"Current identity's NotAfter and reenrollment\\_delta. Alert thresholds do not change that window.",{"_3461":1219,"_30106":1175,"_20907":52923,"_5":14363,"_27392":52800,"_2946":52924},[],"Current certificate revoked",{"_3461":1220,"_30106":1175,"_20907":52926,"_5":14363,"_27392":52800,"_2946":52927},[],"Renewal rejected; prepare authorized recovery according to the cause.",{"_3461":1221,"_30106":1175,"_20907":52929,"_5":14363,"_27392":52800,"_2946":52930},[],"CA, profile or signing error",{"_3461":1222,"_30106":1175,"_20907":52932,"_5":14363,"_27392":52800,"_2946":52933},[],"Active CA, available key, selected profile and restrictions. Successful cacerts does not prove issuance.",{"_3461":1223,"_30106":1175,"_20907":52935,"_5":14363,"_27392":52800,"_2946":52936},[],"HTTP 200 without a device connection",{"_3461":1224,"_30106":1175,"_20907":52938,"_5":14363,"_27392":52800,"_2946":52939},[],"Installed pair, chain, uses, consumer trust and permissions. Also check the slot and history.",{"_3461":1225,"_30106":1175,"_20907":52941,"_5":14363,"_27392":52800,"_2946":52942},[],"Timeout or error after issuance",{"_3461":1226,"_30106":1175,"_20907":52944,"_5":14363,"_27392":52800,"_2946":52945},[],"New certificates, current slot and previous identity's state before retrying.",{"_3461":1227,"_30106":1175,"_20907":52947,"_5":14363,"_27392":52804,"_2946":52948},[],"The examples use the contract of the examined backend. Do not automatically attribute that behavior to another release. Check the saved renewal mode and Gateway behavior with expired certificates and the bootstrap CA.",{"_3461":1228,"_30106":1175,"_20907":52950,"_5":14363,"_27392":52804,"_2946":52951},[],"The default response is Base64-encoded DER PKCS#7; PEM through `Accept: application/x-pem-file` is a Lamassu extension. ServerKeyGen returns multipart and requires handling each part separately. See the EST reference.",{"_3461":1229,"_30106":1175,"_20907":52953,"_5":14363,"_27392":52807,"_2946":52954},[],"Check HTTPS with the approved root and query cacerts for the correct APS.",{"_3461":1230,"_30106":1175,"_20907":52956,"_5":14363,"_27392":52807,"_2946":52957},[],"Review the saved DMS: protocol, registration, authentication for that operation, CA, profile and window.",{"_3461":1231,"_30106":1175,"_20907":52959,"_5":14363,"_27392":52807,"_2946":52960},[],"Verify the CSR locally and relate its CN to the inventory.",{"_3461":1232,"_30106":1175,"_20907":52962,"_5":14363,"_27392":52807,"_2946":52963},[],"Make one request, save headers/body and query the device and certificates.",{"_3461":1233,"_30106":1175,"_20907":52965,"_5":14363,"_27392":52807,"_2946":52966},[],"If you receive an identity, check the key, subject, use and connection with the consumer.",{"_3461":1234,"_30106":1175,"_20907":52968,"_5":14363,"_27392":52807,"_2946":52969},[],"External bootstrap revocation checks have limitations: absence of evidence can be accepted, and OCSP Unknown does not cause the same rejection as Revoked. Do not assume a policy that rejects every uncertainty. An intermediate CA in the TLS chain does not prove that the entire chain reached the DMS validator either.",{"_3461":1235,"_30106":1175,"_20907":52971,"_5":14363,"_27392":52807,"_2946":52972},[],"For logs, networking, pods or Gateway headers, continue in Deployment troubleshooting. For identities issued, revoked or bound partially, use Renewal and recovery and Devices and identities.",{"_3461":1236,"_30106":1236,"_5":14715,"_2946":52974,"_30438":52975,"_20907":52976,"_27392":1236},"Trust distribution and updates",[49125,50593,51607,51605,51788],[],{"_3461":1237,"_30106":1236,"_20907":52978,"_5":14363,"_27392":1236,"_2946":52979},[],"Separate roots, intermediates and initial TLS trust when distributing or migrating certificates.",{"_3461":1238,"_30106":1236,"_5":30435,"_20907":52981,"_27392":52982,"_2946":52983},[],"/docs/platform/iot-fleets/enrollment/trust-distribution#three-trust-relationships","Three trust relationships",{"_3461":1239,"_30106":1236,"_5":30435,"_20907":52985,"_27392":52986,"_2946":52987},[],"/docs/platform/iot-fleets/enrollment/trust-distribution#what-cacerts-returns","What cacerts returns",{"_3461":1240,"_30106":1236,"_5":30435,"_20907":52989,"_27392":52990,"_2946":52991},[],"/docs/platform/iot-fleets/enrollment/trust-distribution#install-the-required-material","Install the required material",{"_3461":1241,"_30106":1236,"_5":30435,"_20907":52993,"_27392":52994,"_2946":52995},[],"/docs/platform/iot-fleets/enrollment/trust-distribution#migrate-trust","Migrate trust",{"_3461":1242,"_30106":1236,"_5":30435,"_20907":52997,"_27392":52998,"_2946":52999},[],"/docs/platform/iot-fleets/enrollment/trust-distribution#check-the-update","Check the update",{"_3461":1243,"_30106":1236,"_20907":53001,"_5":14363,"_27392":1236,"_2946":53002},[],"This guide is for device and consumer trust administrators. You need issuer inventory, trust-store access and an authenticated update channel. Distributing certificates is separate from choosing trusted anchors.",{"_3461":1244,"_30106":1236,"_20907":53004,"_5":14363,"_27392":52982,"_2946":53005},[],"Relationship",{"_3461":1245,"_30106":1236,"_20907":53007,"_5":14363,"_27392":52982,"_2946":53008},[],"Material prepared by its owner",{"_3461":1246,"_30106":1236,"_20907":53010,"_5":14363,"_27392":52982,"_2946":53011},[],"Device → EST server",{"_3461":1247,"_30106":1236,"_20907":53013,"_5":14363,"_27392":52982,"_2946":53014},[],"Previously verified server root, chain or pin and TLS name.",{"_3461":1248,"_30106":1236,"_20907":53016,"_5":14363,"_27392":52982,"_2946":53017},[],"DMS → requester",{"_3461":1249,"_30106":1236,"_20907":53019,"_5":14363,"_27392":52982,"_2946":53020},[],"CAs and rules authorizing initial or renewal credentials.",{"_3461":1250,"_30106":1236,"_20907":53022,"_5":14363,"_27392":52982,"_2946":53023},[],"Consumer → device",{"_3461":1251,"_30106":1236,"_20907":53025,"_5":14363,"_27392":52982,"_2946":53026},[],"Operational identity roots, intermediates, validation and permissions.",{"_3461":1252,"_30106":1236,"_20907":53028,"_5":14363,"_27392":52982,"_2946":53029},[],"Obtaining a certificate does not automatically configure these relationships in third parties. Review the Trust model.",{"_3461":1253,"_30106":1236,"_20907":53031,"_5":14363,"_27392":52986,"_2946":53032},[],"The DMS may include the available downstream TLS certificate, selected Managed CAs and enrollment CA. Selecting the issuer does not include every ancestor. The set may contain leaves, roots and intermediates, including multiple hierarchies during migration.",{"_3461":1254,"_30106":1236,"_20907":53034,"_5":14363,"_27392":52986,"_2946":53035},[],"Position does not define the chain. Identify certificates by subject, issuer, AKI/SKI, signature and constraints. Download and inspect using EST client.",{"_3461":1255,"_30106":1236,"_20907":53037,"_5":14363,"_27392":52990,"_2946":53038},[],"Keep initial EST server trust separate from identity consumer trust.",{"_3461":1256,"_30106":1236,"_20907":53040,"_5":14363,"_27392":52990,"_2946":53041},[],"Select policy-approved roots as anchors.",{"_3461":1257,"_30106":1236,"_20907":53043,"_5":14363,"_27392":52990,"_2946":53044},[],"Retain intermediates for chain building or presentation; do not automatically turn them into roots.",{"_3461":1258,"_30106":1236,"_20907":53046,"_5":14363,"_27392":52990,"_2946":53047},[],"Present the leaf and required intermediates in mTLS. Normally the peer already trusts its root and does not need it sent.",{"_3461":1259,"_30106":1236,"_20907":53049,"_5":14363,"_27392":52990,"_2946":53050},[],"Verify chain, dates, names, usages and revocation from the consumer.",{"_3461":1260,"_30106":1236,"_20907":53052,"_5":14363,"_27392":52990,"_2946":53053},[],"Do not indiscriminately use all of `cacerts.pem` as `-CAfile`: this can expand trusted authorities, hide missing intermediates or trust a TLS leaf intended for another purpose.",{"_3461":1261,"_30106":1236,"_20907":53055,"_5":14363,"_27392":52994,"_2946":53056},[],"Before changing Enrollment CA, inventory disconnected equipment, bootstrap and operational certificates, and consumers. Distribute the new root and required intermediates; check that a cohort accepts both old and new chains.",{"_3461":1262,"_30106":1236,"_20907":53058,"_5":14363,"_27392":52994,"_2946":53059},[],"In the DMS, separate distributed CAs from the re-enrollment validation CAs at `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`, used for re-enrollment credentials. That list is optional because the enrollment CA always validates re-enrollment credentials, but when switching the enrollment CA, add the previous issuance CA to it so old-CA identities keep re-enrolling during overlap. The inspected validator tries the enrollment CA followed by those CAs against the received leaf; accepting a multilevel chain requires checking what reaches the service and which issuer is configured.",{"_3461":1263,"_30106":1236,"_20907":53061,"_5":14363,"_27392":52994,"_2946":53062},[],"Switch issuance, renew in cohorts and compare the installed serial with the active slot. Remove previous trust once no legitimate equipment needs it and policy permits ending overlap. Follow Hierarchy and rotation for the PKI operation.",{"_3461":1264,"_30106":1236,"_20907":53064,"_5":14363,"_27392":52998,"_2946":53065},[],"Test an old identity allowed during overlap, a new one, an unknown chain and the result after removing old trust. Keep trust-store version, approved set, date and result. Reachable `/cacerts` establishes distribution only; it does not establish installation or acceptance across every device.",{"_3461":1265,"_30106":1265,"_5":14715,"_2946":53067,"_30438":53068,"_20907":53070,"_27392":1265},"AWS IoT Core",[49125,50593,51607,51605,53069],"Integrations",[],{"_3461":1266,"_30106":1265,"_20907":53072,"_5":14363,"_27392":1265,"_2946":53073},[],"Lamassu's connector for AWS IoT Core syncs device identities with the AWS platform, handling CA registration, Thing provisioning and certificate lifecycle automatically and event-driven.",{"_3461":1267,"_30106":1265,"_5":30435,"_20907":53075,"_27392":53076,"_2946":53077},[],"/docs/platform/iot-fleets/integrations/aws-iot-core#connector-architecture","Connector architecture",{"_3461":1268,"_30106":1265,"_5":30435,"_20907":53079,"_27392":53080,"_2946":53081},[],"/docs/platform/iot-fleets/integrations/aws-iot-core#prerequisites","Prerequisites",{"_3461":1269,"_30106":1265,"_5":30435,"_20907":53083,"_27392":53084,"_2946":53085},[],"/docs/platform/iot-fleets/integrations/aws-iot-core#required-iam-permissions","Required IAM permissions",{"_3461":1270,"_30106":1265,"_5":30435,"_20907":53087,"_27392":53088,"_2946":53089},[],"/docs/platform/iot-fleets/integrations/aws-iot-core#configuration-parameters","Configuration parameters",{"_3461":1271,"_30106":1265,"_5":30435,"_20907":53091,"_27392":53092,"_2946":53093},[],"/docs/platform/iot-fleets/integrations/aws-iot-core#events-and-aws-resources","Events and AWS resources",{"_3461":1272,"_30106":1265,"_5":30435,"_20907":53095,"_27392":53096,"_2946":53097},[],"/docs/platform/iot-fleets/integrations/aws-iot-core#ca-registration-in-aws-iot-core","CA registration in AWS IoT Core",{"_3461":1273,"_30106":1265,"_5":30435,"_20907":53099,"_27392":53100,"_2946":53101},[],"/docs/platform/iot-fleets/integrations/aws-iot-core#how-to-request-registration","How to request registration",{"_3461":1274,"_30106":1265,"_5":30435,"_20907":53103,"_27392":53104,"_2946":53105},[],"/docs/platform/iot-fleets/integrations/aws-iot-core#ca-registration-states","CA registration states",{"_3461":1275,"_30106":1265,"_5":30435,"_20907":53107,"_27392":53108,"_2946":53109},[],"/docs/platform/iot-fleets/integrations/aws-iot-core#primary-account","Primary Account",{"_3461":1276,"_30106":1265,"_5":30435,"_20907":53111,"_27392":53112,"_2946":53113},[],"/docs/platform/iot-fleets/integrations/aws-iot-core#secondary-account-sni-only","Secondary Account (SNI-only)",{"_3461":1277,"_30106":1265,"_5":30435,"_20907":53115,"_27392":53116,"_2946":53117},[],"/docs/platform/iot-fleets/integrations/aws-iot-core#dms-configuration","DMS configuration",{"_3461":1278,"_30106":1265,"_5":30435,"_20907":53119,"_27392":53120,"_2946":53121},[],"/docs/platform/iot-fleets/integrations/aws-iot-core#none-mode","`none` mode",{"_3461":1279,"_30106":1265,"_5":30435,"_20907":53123,"_27392":53124,"_2946":53125},[],"/docs/platform/iot-fleets/integrations/aws-iot-core#auto-mode","`auto` mode",{"_3461":1280,"_30106":1265,"_5":30435,"_20907":53127,"_27392":53128,"_2946":53129},[],"/docs/platform/iot-fleets/integrations/aws-iot-core#jitp-mode","`jitp` mode",{"_3461":1281,"_30106":1265,"_5":30435,"_20907":53131,"_27392":53132,"_2946":53133},[],"/docs/platform/iot-fleets/integrations/aws-iot-core#dms-registration-mode-states","DMS registration-mode states",{"_3461":1282,"_30106":1265,"_5":30435,"_20907":53135,"_27392":53136,"_2946":53137},[],"/docs/platform/iot-fleets/integrations/aws-iot-core#device-provisioning-automatic-mode","Device provisioning (automatic mode)",{"_3461":1283,"_30106":1265,"_5":30435,"_20907":53139,"_27392":53140,"_2946":53141},[],"/docs/platform/iot-fleets/integrations/aws-iot-core#thing-lifecycle","Thing lifecycle",{"_3461":1284,"_30106":1265,"_5":30435,"_20907":53143,"_27392":53144,"_2946":53145},[],"/docs/platform/iot-fleets/integrations/aws-iot-core#device-provisioning-jitp-mode","Device provisioning (JITP mode)",{"_3461":1285,"_30106":1265,"_5":30435,"_20907":53147,"_27392":53148,"_2946":53149},[],"/docs/platform/iot-fleets/integrations/aws-iot-core#certificate-status-synchronization","Certificate status synchronization",{"_3461":1286,"_30106":1265,"_5":30435,"_20907":53151,"_27392":53152,"_2946":53153},[],"/docs/platform/iot-fleets/integrations/aws-iot-core#certificate-status-states","Certificate status states",{"_3461":1287,"_30106":1265,"_5":30435,"_20907":53155,"_27392":53156,"_2946":53157},[],"/docs/platform/iot-fleets/integrations/aws-iot-core#forced-disconnect-on-revocation","Forced disconnect on revocation",{"_3461":1288,"_30106":1265,"_5":30435,"_20907":53159,"_27392":53160,"_2946":53161},[],"/docs/platform/iot-fleets/integrations/aws-iot-core#device-shadow-and-automation","Device Shadow and automation",{"_3461":1289,"_30106":1265,"_5":30435,"_20907":53163,"_27392":53164,"_2946":53165},[],"/docs/platform/iot-fleets/integrations/aws-iot-core#what-the-connector-writes-to-the-shadow","What the connector writes to the shadow",{"_3461":1290,"_30106":1265,"_5":30435,"_20907":53167,"_27392":53168,"_2946":53169},[],"/docs/platform/iot-fleets/integrations/aws-iot-core#aws-iot-policies","AWS IoT policies",{"_3461":1291,"_30106":1265,"_5":30435,"_20907":53171,"_27392":53172,"_2946":53173},[],"/docs/platform/iot-fleets/integrations/aws-iot-core#troubleshooting","Troubleshooting",{"_3461":1292,"_30106":1265,"_20907":53175,"_5":14363,"_27392":1265,"_2946":53176},[],"Lamassu's integration with AWS IoT Core bridges the PKI managed by Lamassu and AWS's connectivity platform. When a device obtains its certificate through the EST enrollment process, the connector ensures that certificate and its associated identity are recognized in AWS IoT Core without manual intervention. The result is that the device can authenticate directly to AWS with the same X.509 certificate Lamassu issued.",{"_3461":1293,"_30106":1265,"_20907":53178,"_5":14363,"_27392":1265,"_2946":53179},[],"From a protocol standpoint, the device authenticates to AWS IoT Core via mutual TLS (mTLS): it presents its Lamassu-issued X.509 certificate as the client certificate, and AWS IoT Core verifies the certificate chain up to the CA registered in the account. Lamassu acts as the certification authority (CA); the connector ensures that CA is registered in AWS and that the device's certificate is known to the platform before the device attempts to connect (in `auto` mode) or on its first connection (in JITP mode).",{"_3461":1294,"_30106":1265,"_20907":53181,"_5":14363,"_27392":1265,"_2946":53182},[],"This document is aimed both at the PKI administrator, who needs to configure the connector and register CAs, and at the device firmware developer, who needs to understand how Things are named, how the Device Shadow works and what happens when a certificate is revoked. For the firmware developer, the most important fact is that **the AWS Thing name (ThingName) always corresponds to the Common Name (CN) of the certificate issued by Lamassu**, regardless of the provisioning mode.",{"_3461":1295,"_30106":1265,"_20907":53184,"_5":14363,"_27392":53076,"_2946":53185},[],"The AWS IoT Core connector is an independent Go process, a binary or container separate from Lamassu's core. In a monolithic deployment it is compiled by default (build tag `!noaws`) and activated with `aws_iot_manager.enabled: true` in the configuration file. In distributed deployments, it runs as its own container with access to Lamassu's CA, DMS Manager and Device Manager services over HTTP.",{"_3461":1296,"_30106":1265,"_20907":53187,"_5":14363,"_27392":53076,"_2946":53188},[],"The connector does not poll Lamassu's services periodically. Instead, it **subscribes to Lamassu's internal event bus** (AMQP or AWS SQS/SNS, configurable) and reacts to the events it cares about: CA creation or update, DMS creation or update, device identity binding, certificate status change, certificate metadata update and device metadata update. This event-driven model ensures synchronization with AWS is nearly immediate and produces no polling load.",{"_3461":1297,"_30106":1265,"_20907":53190,"_5":14363,"_27392":53076,"_2946":53191},[],"To avoid infinite loops, the connector ignores any event whose CloudEvent `source` field matches its own origin URI. This prevents the metadata writes the connector itself performs from re-triggering the same flow.",{"_3461":1298,"_30106":1265,"_20907":53193,"_5":14363,"_27392":53076,"_2946":53194},[],"When several connectors run in parallel, for example for different AWS accounts, each instance has its own `connector_id`. All metadata the connector writes to Lamassu is stored under the key `lamassu.io/iot/{connector_id}`, allowing coexistence without collisions.",{"_3461":1299,"_30106":1265,"_20907":53196,"_5":14363,"_27392":53080,"_2946":53197},[],"Before enabling the connector you need an AWS account with the proper IAM permissions and the connector correctly configured. The deployment process (Docker Compose, Kubernetes or binary) is described in the deployment documentation.",{"_3461":1300,"_30106":1265,"_20907":53199,"_5":14363,"_27392":53084,"_2946":53200},[],"The IAM identity operating the connector needs at minimum the following permissions on the target account's resources:",{"_3461":1301,"_30106":1265,"_20907":53202,"_5":14363,"_27392":53084,"_2946":53203},[],"IAM action",{"_3461":1302,"_30106":1265,"_20907":53205,"_5":14363,"_27392":53084,"_2946":49515},[],{"_3461":1303,"_30106":1265,"_20907":53207,"_5":14363,"_27392":53084,"_2946":53208},[],"`iot:GetRegistrationCode`",{"_3461":1304,"_30106":1265,"_20907":53210,"_5":14363,"_27392":53084,"_2946":53211},[],"Obtain the verification code for CA registration in the Primary Account",{"_3461":1305,"_30106":1265,"_20907":53213,"_5":14363,"_27392":53084,"_2946":53214},[],"`iot:RegisterCACertificate`",{"_3461":1306,"_30106":1265,"_20907":53216,"_5":14363,"_27392":53084,"_2946":53217},[],"Register the CA in AWS IoT",{"_3461":1307,"_30106":1265,"_20907":53219,"_5":14363,"_27392":53084,"_2946":53220},[],"`iot:DescribeCACertificate`",{"_3461":1308,"_30106":1265,"_20907":53222,"_5":14363,"_27392":53084,"_2946":53223},[],"Check the CA registration status",{"_3461":1309,"_30106":1265,"_20907":53225,"_5":14363,"_27392":53084,"_2946":53226},[],"`iot:CreateThing` / `iot:UpdateThing`",{"_3461":1310,"_30106":1265,"_20907":53228,"_5":14363,"_27392":53084,"_2946":53229},[],"Create or update Things in IoT Core",{"_3461":1311,"_30106":1265,"_20907":53231,"_5":14363,"_27392":53084,"_2946":53232},[],"`iot:RegisterThing`",{"_3461":1312,"_30106":1265,"_20907":53234,"_5":14363,"_27392":53084,"_2946":53235},[],"Provision Things through a template",{"_3461":1313,"_30106":1265,"_20907":53237,"_5":14363,"_27392":53084,"_2946":53238},[],"`iot:RegisterCertificate`",{"_3461":1314,"_30106":1265,"_20907":53240,"_5":14363,"_27392":53084,"_2946":53241},[],"Register device certificates",{"_3461":1315,"_30106":1265,"_20907":53243,"_5":14363,"_27392":53084,"_2946":53244},[],"`iot:UpdateCertificate`",{"_3461":1316,"_30106":1265,"_20907":53246,"_5":14363,"_27392":53084,"_2946":53247},[],"Change a certificate's status (ACTIVE / INACTIVE / REVOKED)",{"_3461":1317,"_30106":1265,"_20907":53249,"_5":14363,"_27392":53084,"_2946":53250},[],"`iot:CreatePolicy` / `iot:AttachPolicy`",{"_3461":1318,"_30106":1265,"_20907":53252,"_5":14363,"_27392":53084,"_2946":53253},[],"Create and attach IoT policies",{"_3461":1319,"_30106":1265,"_20907":53255,"_5":14363,"_27392":53084,"_2946":53256},[],"`iot:CreateThingGroup` / `iot:AddThingToThingGroup`",{"_3461":1320,"_30106":1265,"_20907":53258,"_5":14363,"_27392":53084,"_2946":53259},[],"Manage Thing groups",{"_3461":1321,"_30106":1265,"_20907":53261,"_5":14363,"_27392":53084,"_2946":53262},[],"`iot:CreateProvisioningTemplate`",{"_3461":1322,"_30106":1265,"_20907":53264,"_5":14363,"_27392":53084,"_2946":53265},[],"Create JITP templates",{"_3461":1323,"_30106":1265,"_20907":53267,"_5":14363,"_27392":53084,"_2946":53268},[],"`iotdata:GetThingShadow` / `iotdata:UpdateThingShadow`",{"_3461":1324,"_30106":1265,"_20907":53270,"_5":14363,"_27392":53084,"_2946":53271},[],"Read and write the Device Shadow",{"_3461":1325,"_30106":1265,"_20907":53273,"_5":14363,"_27392":53084,"_2946":53274},[],"The forced-disconnect mechanism after revocation also requires access to the AWS IoT data plane API (`iot:Connect` with SigV4 over WebSocket), negotiated implicitly with the connector's credentials.",{"_3461":1326,"_30106":1265,"_20907":53276,"_5":14363,"_27392":53088,"_2946":53277},[],"Parameter",{"_3461":1327,"_30106":1265,"_20907":53279,"_5":14363,"_27392":53088,"_2946":53280},[],"Type",{"_3461":1328,"_30106":1265,"_20907":53282,"_5":14363,"_27392":53088,"_2946":53283},[],"Required",{"_3461":1329,"_30106":1265,"_20907":53285,"_5":14363,"_27392":53088,"_2946":53286},[],"Description",{"_3461":1330,"_30106":1265,"_20907":53288,"_5":14363,"_27392":53088,"_2946":53289},[],"`connector_id`",{"_3461":1331,"_30106":1265,"_20907":53291,"_5":14363,"_27392":53088,"_2946":24973},[],{"_3461":1332,"_30106":1265,"_20907":53293,"_5":14363,"_27392":53088,"_2946":53294},[],"Yes",{"_3461":1333,"_30106":1265,"_20907":53296,"_5":14363,"_27392":53088,"_2946":53297},[],"Unique identifier of this connector instance. Used as the metadata namespace: `lamassu.io/iot/{connector_id}`.",{"_3461":1334,"_30106":1265,"_20907":53299,"_5":14363,"_27392":53088,"_2946":53300},[],"`aws_config.region`",{"_3461":1335,"_30106":1265,"_20907":53302,"_5":14363,"_27392":53088,"_2946":24973},[],{"_3461":1336,"_30106":1265,"_20907":53304,"_5":14363,"_27392":53088,"_2946":53294},[],{"_3461":1337,"_30106":1265,"_20907":53306,"_5":14363,"_27392":53088,"_2946":53307},[],"AWS region where the connector operates.",{"_3461":1338,"_30106":1265,"_20907":53309,"_5":14363,"_27392":53088,"_2946":53310},[],"`aws_config.auth_method`",{"_3461":1339,"_30106":1265,"_20907":53312,"_5":14363,"_27392":53088,"_2946":24973},[],{"_3461":1340,"_30106":1265,"_20907":53314,"_5":14363,"_27392":53088,"_2946":53294},[],{"_3461":1341,"_30106":1265,"_20907":53316,"_5":14363,"_27392":53088,"_2946":53317},[],"Authentication method: `static`, `role` or empty (SDK default credential chain).",{"_3461":1342,"_30106":1265,"_20907":53319,"_5":14363,"_27392":53088,"_2946":53320},[],"`aws_config.access_key_id`",{"_3461":1343,"_30106":1265,"_20907":53322,"_5":14363,"_27392":53088,"_2946":24973},[],{"_3461":1344,"_30106":1265,"_20907":53324,"_5":14363,"_27392":53088,"_2946":53325},[],"Only with `auth_method=static`",{"_3461":1345,"_30106":1265,"_20907":53327,"_5":14363,"_27392":53088,"_2946":53328},[],"AWS access key.",{"_3461":1346,"_30106":1265,"_20907":53330,"_5":14363,"_27392":53088,"_2946":53331},[],"`aws_config.secret_access_key`",{"_3461":1347,"_30106":1265,"_20907":53333,"_5":14363,"_27392":53088,"_2946":24973},[],{"_3461":1348,"_30106":1265,"_20907":53335,"_5":14363,"_27392":53088,"_2946":53325},[],{"_3461":1349,"_30106":1265,"_20907":53337,"_5":14363,"_27392":53088,"_2946":53338},[],"AWS secret key.",{"_3461":1350,"_30106":1265,"_20907":53340,"_5":14363,"_27392":53088,"_2946":53341},[],"`aws_config.session_token`",{"_3461":1351,"_30106":1265,"_20907":53343,"_5":14363,"_27392":53088,"_2946":24973},[],{"_3461":1352,"_30106":1265,"_20907":53345,"_5":14363,"_27392":53088,"_2946":53346},[],"No",{"_3461":1353,"_30106":1265,"_20907":53348,"_5":14363,"_27392":53088,"_2946":53349},[],"Session token (with `auth_method=static`).",{"_3461":1354,"_30106":1265,"_20907":53351,"_5":14363,"_27392":53088,"_2946":53352},[],"`aws_config.role_arn`",{"_3461":1355,"_30106":1265,"_20907":53354,"_5":14363,"_27392":53088,"_2946":24973},[],{"_3461":1356,"_30106":1265,"_20907":53356,"_5":14363,"_27392":53088,"_2946":53357},[],"Only with `auth_method=role`",{"_3461":1357,"_30106":1265,"_20907":53359,"_5":14363,"_27392":53088,"_2946":53360},[],"ARN of the role to assume.",{"_3461":1358,"_30106":1265,"_20907":53362,"_5":14363,"_27392":53088,"_2946":53363},[],"`aws_config.endpoint_url`",{"_3461":1359,"_30106":1265,"_20907":53365,"_5":14363,"_27392":53088,"_2946":24973},[],{"_3461":1360,"_30106":1265,"_20907":53367,"_5":14363,"_27392":53088,"_2946":53346},[],{"_3461":1361,"_30106":1265,"_20907":53369,"_5":14363,"_27392":53088,"_2946":53370},[],"Alternative URL for all AWS services (useful with LocalStack in tests).",{"_3461":1362,"_30106":1265,"_20907":53372,"_5":14363,"_27392":53088,"_2946":53373},[],"`subscriber_event_bus`",{"_3461":1363,"_30106":1265,"_20907":53375,"_5":14363,"_27392":53088,"_2946":17602},[],{"_3461":1364,"_30106":1265,"_20907":53377,"_5":14363,"_27392":53088,"_2946":53294},[],{"_3461":1365,"_30106":1265,"_20907":53379,"_5":14363,"_27392":53088,"_2946":53380},[],"Configuration of the event bus the connector subscribes to (AMQP or AWS SQS/SNS).",{"_3461":1366,"_30106":1265,"_20907":53382,"_5":14363,"_27392":53088,"_2946":53383},[],"`dms_manager_client`",{"_3461":1367,"_30106":1265,"_20907":53385,"_5":14363,"_27392":53088,"_2946":24973},[],{"_3461":1368,"_30106":1265,"_20907":53387,"_5":14363,"_27392":53088,"_2946":53294},[],{"_3461":1369,"_30106":1265,"_20907":53389,"_5":14363,"_27392":53088,"_2946":53390},[],"HTTP URL of Lamassu's DMS Manager service.",{"_3461":1370,"_30106":1265,"_20907":53392,"_5":14363,"_27392":53088,"_2946":53393},[],"`device_manager_client`",{"_3461":1371,"_30106":1265,"_20907":53395,"_5":14363,"_27392":53088,"_2946":24973},[],{"_3461":1372,"_30106":1265,"_20907":53397,"_5":14363,"_27392":53088,"_2946":53294},[],{"_3461":1373,"_30106":1265,"_20907":53399,"_5":14363,"_27392":53088,"_2946":53400},[],"HTTP URL of Lamassu's Device Manager.",{"_3461":1374,"_30106":1265,"_20907":53402,"_5":14363,"_27392":53088,"_2946":53403},[],"`ca_client`",{"_3461":1375,"_30106":1265,"_20907":53405,"_5":14363,"_27392":53088,"_2946":24973},[],{"_3461":1376,"_30106":1265,"_20907":53407,"_5":14363,"_27392":53088,"_2946":53294},[],{"_3461":1377,"_30106":1265,"_20907":53409,"_5":14363,"_27392":53088,"_2946":53410},[],"HTTP URL of Lamassu's CA service.",{"_3461":1378,"_30106":1265,"_20907":53412,"_5":14363,"_27392":53092,"_2946":53413},[],"The connector owns the AWS side of four resource types — CAs, DMS provisioning templates (JITP), device certificates and Things. This section maps the bus events the connector consumes to the AWS resources they touch and to the AWS calls each flow performs. The state machine of each resource lives next to its detailed explanation; the last column links to it. AWS resources are referenced with the notation `IoTCore/<resource>`.",{"_3461":1379,"_30106":1265,"_20907":53415,"_5":14363,"_27392":53092,"_2946":53416},[],"The **CloudEvent type** column lists the event name on Lamassu's internal event bus; the **IAM actions** column lists the exact AWS SDK operations each flow invokes, so the required permissions can be derived directly from this table.",{"_3461":1380,"_30106":1265,"_20907":53418,"_5":14363,"_27392":53092,"_2946":53419},[],"CloudEvent type",{"_3461":1381,"_30106":1265,"_20907":53421,"_5":14363,"_27392":53092,"_2946":53422},[],"Lamassu resource",{"_3461":1382,"_30106":1265,"_20907":53424,"_5":14363,"_27392":53092,"_2946":53425},[],"AWS Resource",{"_3461":1383,"_30106":1265,"_20907":53427,"_5":14363,"_27392":53092,"_2946":53428},[],"IAM actions",{"_3461":1384,"_30106":1265,"_20907":53430,"_5":14363,"_27392":53092,"_2946":53431},[],"AWS calls and effect",{"_3461":1385,"_30106":1265,"_20907":53433,"_5":14363,"_27392":53092,"_2946":53434},[],"Where in this page",{"_3461":1386,"_30106":1265,"_20907":53436,"_5":14363,"_27392":53092,"_2946":53437},[],"`EventCreateCAKey` / `EventImportCAKey` / `EventUpdateCAMetadataKey`",{"_3461":1387,"_30106":1265,"_20907":53439,"_5":14363,"_27392":53092,"_2946":53440},[],"CA",{"_3461":1388,"_30106":1265,"_20907":53442,"_5":14363,"_27392":53092,"_2946":53443},[],"`IoTCore/CACertificate`",{"_3461":1389,"_30106":1265,"_20907":53445,"_5":14363,"_27392":53092,"_2946":53446},[],"`iot:GetRegistrationCode`, `iot:RegisterCACertificate`, `iot:DescribeCACertificate`, `iot:ListCACertificates`",{"_3461":1390,"_30106":1265,"_20907":53448,"_5":14363,"_27392":53092,"_2946":53449},[],"Loads the CA into connector state; a `registration.status = REQUESTED` write fires the registration flow (Primary with verification certificate, or SNI-only) and writes `SUCCEEDED` or `FAILED` back to the CA's metadata.",{"_3461":1391,"_30106":1265,"_20907":53451,"_5":14363,"_27392":53092,"_2946":53105},[],{"_3461":1392,"_30106":1265,"_20907":53453,"_5":14363,"_27392":53092,"_2946":53454},[],"`EventCreateDMSKey` / `EventUpdateDMSKey`",{"_3461":1393,"_30106":1265,"_20907":53456,"_5":14363,"_27392":53092,"_2946":53457},[],"DMS",{"_3461":1394,"_30106":1265,"_20907":53459,"_5":14363,"_27392":53092,"_2946":53460},[],"`IoTCore/ProvisioningTemplate`",{"_3461":1395,"_30106":1265,"_20907":53462,"_5":14363,"_27392":53092,"_2946":53463},[],"`iot:CreateProvisioningTemplate`, `iot:UpdateCACertificate`",{"_3461":1396,"_30106":1265,"_20907":53465,"_5":14363,"_27392":53092,"_2946":53466},[],"In `jitp` mode, attempts to create the provisioning template and attaches it to the registered CA. Non-idempotent: a `PUT /v1/dms/{id}` edit retries the creation and lands in `lamassu-dlq` after 3 retries. Idempotent for `none` and `auto` (configuration only).",{"_3461":1397,"_30106":1265,"_20907":53468,"_5":14363,"_27392":53092,"_2946":53133},[],{"_3461":1398,"_30106":1265,"_20907":53470,"_5":14363,"_27392":53092,"_2946":53471},[],"`EventBindDeviceIdentityKey`",{"_3461":1399,"_30106":1265,"_20907":53473,"_5":14363,"_27392":53092,"_2946":53474},[],"Device",{"_3461":1400,"_30106":1265,"_20907":53476,"_5":14363,"_27392":53092,"_2946":53477},[],"`IoTCore/Policy`, `IoTCore/ThingGroup`, `IoTCore/Thing`",{"_3461":1401,"_30106":1265,"_20907":53479,"_5":14363,"_27392":53092,"_2946":53480},[],"`iot:CreatePolicy` / `iot:DeletePolicyVersion`, `iot:GetPolicy` / `iot:ListPolicyVersions`, `iot:CreateThingGroup`, `iot:DescribeThing` / `iot:ListThingPrincipals`, `iot:RegisterThing`",{"_3461":1402,"_30106":1265,"_20907":53482,"_5":14363,"_27392":53092,"_2946":53483},[],"In `auto` mode: creates/updates policies, ensures Thing groups, revokes stale principals and provisions the Thing via `iot:RegisterThing`. In `jitp` mode: no AWS calls; AWS runs the JITP template on first connection.",{"_3461":1403,"_30106":1265,"_20907":53485,"_5":14363,"_27392":53092,"_2946":53141},[],{"_3461":1404,"_30106":1265,"_20907":53487,"_5":14363,"_27392":53092,"_2946":53488},[],"`EventUpdateCertificateStatusKey`",{"_3461":1405,"_30106":1265,"_20907":53490,"_5":14363,"_27392":53092,"_2946":53491},[],"Certificate",{"_3461":1406,"_30106":1265,"_20907":53493,"_5":14363,"_27392":53092,"_2946":53494},[],"`IoTCore/Certificate`",{"_3461":1407,"_30106":1265,"_20907":53496,"_5":14363,"_27392":53092,"_2946":53497},[],"`iot:UpdateCertificate`, `iot:Connect` (data plane)",{"_3461":1408,"_30106":1265,"_20907":53499,"_5":14363,"_27392":53092,"_2946":53500},[],"Maps status to AWS (`ACTIVE`, `INACTIVE`, `REVOKED`), calls `iot:UpdateCertificate` and forces an MQTT disconnect on revoke.",{"_3461":1409,"_30106":1265,"_20907":53502,"_5":14363,"_27392":53092,"_2946":53153},[],{"_3461":1410,"_30106":1265,"_20907":53504,"_5":14363,"_27392":53092,"_2946":53505},[],"`EventUpdateCertificateMetadataKey` / `EventUpdateDeviceMetadataKey`",{"_3461":1411,"_30106":1265,"_20907":53507,"_5":14363,"_27392":53092,"_2946":53508},[],"Certificate / Device",{"_3461":1412,"_30106":1265,"_20907":53510,"_5":14363,"_27392":53092,"_2946":53511},[],"`IoTCore/Certificate`, `IoTCore/Thing`",{"_3461":1413,"_30106":1265,"_20907":53513,"_5":14363,"_27392":53092,"_2946":49521},[],{"_3461":1414,"_30106":1265,"_20907":53515,"_5":14363,"_27392":53092,"_2946":53516},[],"Refreshes internal state; the connector ignores events whose CloudEvent `source` matches its own URI to avoid self-triggered loops.",{"_3461":1415,"_30106":1265,"_20907":53518,"_5":14363,"_27392":53092,"_2946":53161},[],{"_3461":1416,"_30106":1265,"_20907":53520,"_5":14363,"_27392":53096,"_2946":53521},[],"For devices to authenticate to AWS IoT Core with certificates issued by a Lamassu CA, that CA must first be registered in the AWS account. The connector handles this registration automatically in response to the `EventCreateCAKey`, `EventImportCAKey` and `EventUpdateCAMetadataKey` events, but the operation **only fires when the administrator explicitly requests it** through the CA metadata field.",{"_3461":1417,"_30106":1265,"_20907":53523,"_5":14363,"_27392":53100,"_2946":53524},[],"Registration is triggered by setting `registration.status = \"REQUESTED\"` on the `lamassu.io/iot/{connector_id}` key of the CA's metadata. This can be done from the Lamassu console in the CA management section or through the API.",{"_3461":1418,"_30106":1265,"_20907":53526,"_5":14363,"_27392":53100,"_2946":53527},[],"Once the event is received, the connector attempts to register the CA in AWS and updates the `registration.status` field in the CA's metadata with the result: `\"SUCCEEDED\"` if registration was successful, or `\"FAILED\"` with an error message otherwise. The process is asynchronous, so you must periodically check the metadata status until the operation completes.",{"_3461":1419,"_30106":1265,"_20907":53529,"_5":14363,"_27392":53104,"_2946":53530},[],"The CA registration flow is driven by the `registration.status` field of the CA's connector metadata:",{"_3461":1420,"_30106":1265,"_20907":53532,"_5":14363,"_27392":53104,"_2946":53533},[],"Transition",{"_3461":1421,"_30106":1265,"_20907":53535,"_5":14363,"_27392":53104,"_2946":53536},[],"AWS calls",{"_3461":1422,"_30106":1265,"_20907":53538,"_5":14363,"_27392":53104,"_2946":53539},[],"`NotRegistered` → `Requested`",{"_3461":1423,"_30106":1265,"_20907":53541,"_5":14363,"_27392":53104,"_2946":53542},[],"none (metadata write only)",{"_3461":1424,"_30106":1265,"_20907":53544,"_5":14363,"_27392":53104,"_2946":53545},[],"`Requested` → `Registering`",{"_3461":1425,"_30106":1265,"_20907":53547,"_5":14363,"_27392":53104,"_2946":53548},[],"`iot:GetRegistrationCode` (Primary Account only)",{"_3461":1426,"_30106":1265,"_20907":53550,"_5":14363,"_27392":53104,"_2946":53551},[],"`Registering` → `Succeeded`",{"_3461":1427,"_30106":1265,"_20907":53553,"_5":14363,"_27392":53104,"_2946":53554},[],"`iot:RegisterCACertificate` (Primary: proof-of-possession with an ephemeral key; SNI-only: `CertificateMode: SNI_ONLY`)",{"_3461":1428,"_30106":1265,"_20907":53556,"_5":14363,"_27392":53104,"_2946":53557},[],"`Registering` → `Failed`",{"_3461":1429,"_30106":1265,"_20907":53559,"_5":14363,"_27392":53104,"_2946":53560},[],"failed `iot:RegisterCACertificate`; the error detail is written to the CA's metadata",{"_3461":1430,"_30106":1265,"_20907":53562,"_5":14363,"_27392":53104,"_2946":53563},[],"`Failed` / `Succeeded` → `Requested`",{"_3461":1431,"_30106":1265,"_20907":53565,"_5":14363,"_27392":53104,"_2946":53566},[],"none (a new `REQUESTED` write re-runs the flow)",{"_3461":1432,"_30106":1265,"_20907":53568,"_5":14363,"_27392":53108,"_2946":53569},[],"When the `primary_account` parameter is `true`, the connector runs the full registration flow with proof-of-possession of the private key:",{"_3461":1433,"_30106":1265,"_20907":53571,"_5":14363,"_27392":53108,"_2946":53572},[],"It calls `iot:GetRegistrationCode` to obtain AWS's verification code.",{"_3461":1434,"_30106":1265,"_20907":53574,"_5":14363,"_27392":53108,"_2946":53575},[],"The connector internally generates an ephemeral RSA-2048 key pair and builds a CSR whose Common Name is exactly that registration code. It then calls Lamassu's signing service so the registered CA issues a real X.509 verification certificate signing that CSR. The ephemeral private key is used only for this purpose and is neither stored nor sent to AWS.",{"_3461":1435,"_30106":1265,"_20907":53577,"_5":14363,"_27392":53108,"_2946":53578},[],"It sends the CA (in PEM) and the verification certificate to AWS via `iot:RegisterCACertificate`, enabling registration with `AllowAutoRegistration: true`.",{"_3461":1436,"_30106":1265,"_20907":53580,"_5":14363,"_27392":53108,"_2946":53581},[],"Only one account can own a CA in a given AWS region. If the CA is already registered with the same serial number, the connector silently skips the step.",{"_3461":1437,"_30106":1265,"_20907":53583,"_5":14363,"_27392":53108,"_2946":53584},[],"The tags AWS IoT Core applies to the registered CA certificate are `LMS.CA.ID`, `LMS.CA.SN` and `LMS.CA.CN`.",{"_3461":1438,"_30106":1265,"_20907":53586,"_5":14363,"_27392":53112,"_2946":53587},[],"When `primary_account` is `false`, the connector registers the CA using `CertificateMode: SNI_ONLY`. This mode requires no verification code or access to the CA's private key, so it is the right choice when the CA is managed from another AWS account or when the administrator does not hold the private key. It is the usual method to register the same CA in several AWS accounts simultaneously.",{"_3461":1439,"_30106":1265,"_20907":53589,"_5":14363,"_27392":53116,"_2946":53590},[],"Each DMS participating in the AWS IoT Core integration must have the metadata key `lamassu.io/iot/{connector_id}` configured. The most important field of that configuration is `registration_mode`, which determines how devices are provisioned in AWS.",{"_3461":1440,"_30106":1265,"_20907":53592,"_5":14363,"_27392":53116,"_2946":53593},[],"There are three registration modes, and the choice among them depends on the fleet's provisioning strategy.",{"_3461":1441,"_30106":1265,"_20907":53595,"_5":14363,"_27392":53120,"_2946":53596},[],"In this mode the connector **creates no Things, groups or policies** in AWS IoT Core. It only syncs certificate status (active, revoked, suspended) as it changes in Lamassu. It is the right mode when Thing provisioning in AWS is managed by an external system and Lamassu only needs to keep certificate status up to date.",{"_3461":1442,"_30106":1265,"_20907":53598,"_5":14363,"_27392":53124,"_2946":53599},[],"`auto` mode delegates full device provisioning in AWS to Lamassu at enrollment time. When the device successfully completes its EST enrollment and Lamassu emits the `EventBindDeviceIdentityKey` event, the connector automatically executes the following sequence:",{"_3461":1443,"_30106":1265,"_20907":53601,"_5":14363,"_27392":53124,"_2946":53602},[],"Creates or updates the IoT policies configured in the DMS.",{"_3461":1444,"_30106":1265,"_20907":53604,"_5":14363,"_27392":53124,"_2946":53605},[],"Creates the root group `LAMASSU` in the AWS account (if it does not exist) and the child groups configured in the DMS as subgroups of `LAMASSU`. If the groups already exist, the `ResourceAlreadyExistsException` error is ignored, making the operation idempotent.",{"_3461":1445,"_30106":1265,"_20907":53607,"_5":14363,"_27392":53124,"_2946":53608},[],"If the Thing already existed in AWS IoT Core, the connector iterates all certificates (principals) currently attached to that Thing and marks them as `REVOKED` in AWS, ensuring previous certificates cannot keep being used to authenticate.",{"_3461":1446,"_30106":1265,"_20907":53610,"_5":14363,"_27392":53124,"_2946":53611},[],"Calls `iot:RegisterThing` with a CloudFormation-style provisioning template that creates the Thing, registers the device's certificate (PEM of the device certificate and of the issuing CA certificate) and attaches the configured policies.",{"_3461":1447,"_30106":1265,"_20907":53613,"_5":14363,"_27392":53124,"_2946":53614},[],"Once provisioning completes, the connector stores the resulting certificate's ARN in the Lamassu certificate's metadata under the key `lamassu.io/iot/{connector_id}` and marks the device as `Registered: true` in Device Manager.",{"_3461":1448,"_30106":1265,"_20907":53616,"_5":14363,"_27392":53124,"_2946":53617},[],"**The Thing name in AWS is the Common Name (CN) of the device's certificate.** This convention is fundamental for the firmware developer: the `/CN=` value the device includes in its CSR when enrolling becomes the ThingName it must identify itself with in all MQTT operations against AWS IoT Core.",{"_3461":1449,"_30106":1265,"_20907":53619,"_5":14363,"_27392":53128,"_2946":53620},[],"Just-In-Time Provisioning (JITP) mode delegates provisioning to AWS instead of the connector doing it directly. When the connector detects the DMS is in `jitp` mode, it creates a JITP provisioning template in AWS IoT Core and attaches it to the registered CA certificate. The connector attempts to create this template when the DMS is created and again on every full DMS edit (`PUT /v1/dms/{id}`) — not at device enrollment time. The attempt is not idempotent: when a template named after the DMS ID already exists, the creation call fails, the event is retried three times and finally lands in the `lamassu-dlq` poison queue (see Troubleshooting). The template is created once; later DMS edits never update its content. A DMS update that omits `metadata` or sends `null` keeps the stored metadata, so the connector key `lamassu.io/iot/{connector_id}` remains present and the attempt is still triggered. A body that supplies a `metadata` object replaces the stored metadata entirely: if that object does not carry the connector key, the key is dropped and the connector silently skips the DMS's future events. Once the template is attached, when a device with a certificate issued by that CA connects to AWS IoT Core for the first time, AWS executes the template automatically: it creates the Thing, registers the certificate and activates it.",{"_3461":1450,"_30106":1265,"_20907":53622,"_5":14363,"_27392":53128,"_2946":53623},[],"The connector creates the template, named after the DMS ID, only once. Each later edit of the DMS that keeps the connector key tries to create it again and fails, because the connector does not update existing templates. Later changes to `jitp_config.provisioning_role_arn`, `jitp_config.enable_template` or to the groups and policies the template references must be applied by hand in AWS IoT Core.",{"_3461":1451,"_30106":1265,"_20907":53625,"_5":14363,"_27392":53128,"_2946":53626},[],"The failed event is retried and ends in `lamassu-dlq`. Groups and policies are registered before the failure, but the assignment of the template to the registered CA, the write-back of the ARN to the DMS and the shadow update when `ManagedCAs` changes are skipped.",{"_3461":1452,"_30106":1265,"_20907":53628,"_5":14363,"_27392":53128,"_2946":53629},[],"The Thing name in the JITP template is derived from `AWS::IoT::Certificate::CommonName`, which corresponds to the device certificate's CN — the same convention as `auto` mode.",{"_3461":1453,"_30106":1265,"_20907":53631,"_5":14363,"_27392":53128,"_2946":53632},[],"This mode requires the `jitp_config.provisioning_role_arn` field to be configured with the ARN of an IAM role AWS IoT Core can assume to execute the template. If not configured, the connector uses the default `arn:aws:iam::{account}:role/JITPRole` and logs a warning. The administrator must ensure that role exists in the account and has the necessary permissions before enabling JITP mode.",{"_3461":1454,"_30106":1265,"_20907":53634,"_5":14363,"_27392":53132,"_2946":53635},[],"The DMS's `registration_mode` determines what the connector does on the AWS side when the DMS is created or fully edited:",{"_3461":1455,"_30106":1265,"_20907":53637,"_5":14363,"_27392":53132,"_2946":53533},[],{"_3461":1456,"_30106":1265,"_20907":53639,"_5":14363,"_27392":53132,"_2946":53536},[],{"_3461":1457,"_30106":1265,"_20907":53641,"_5":14363,"_27392":53132,"_2946":53642},[],"`Unconfigured` → `None` / `Auto`",{"_3461":1458,"_30106":1265,"_20907":53644,"_5":14363,"_27392":53132,"_2946":53645},[],"none (configuration only)",{"_3461":1459,"_30106":1265,"_20907":53647,"_5":14363,"_27392":53132,"_2946":53648},[],"`None` ↔ `Auto`",{"_3461":1460,"_30106":1265,"_20907":53650,"_5":14363,"_27392":53132,"_2946":53645},[],{"_3461":1461,"_30106":1265,"_20907":53652,"_5":14363,"_27392":53132,"_2946":53653},[],"Any → `Jitp`",{"_3461":1462,"_30106":1265,"_20907":53655,"_5":14363,"_27392":53132,"_2946":53656},[],"`iot:CreateProvisioningTemplate` (non-idempotent: it fails when the template already exists; after 3 retries the event lands in `lamassu-dlq`)",{"_3461":1463,"_30106":1265,"_20907":53658,"_5":14363,"_27392":53132,"_2946":53659},[],"`Jitp` → `None` / `Auto`",{"_3461":1464,"_30106":1265,"_20907":53661,"_5":14363,"_27392":53132,"_2946":53662},[],"none (the template stays in the AWS account)",{"_3461":1465,"_30106":1265,"_20907":53664,"_5":14363,"_27392":53136,"_2946":53665},[],"For the firmware developer, `auto` mode is transparent: the device performs its EST enrollment as usual and, as a side effect, it is provisioned in AWS IoT Core with no additional step.",{"_3461":1466,"_30106":1265,"_20907":53667,"_5":14363,"_27392":53136,"_2946":53668},[],"The full flow from the device's perspective is:",{"_3461":1467,"_30106":1265,"_20907":53670,"_5":14363,"_27392":53136,"_2946":53671},[],"Once the connector completes provisioning, the device can connect to the AWS IoT Core MQTT endpoint using its private key and the certificate issued by Lamassu. The ThingName it must identify itself with in AWS is exactly the certificate's CN.",{"_3461":1468,"_30106":1265,"_20907":53673,"_5":14363,"_27392":53140,"_2946":53674},[],"Things only exist under `auto` mode; in `jitp` mode AWS creates the Thing itself when the device first connects. The Thing name is always the device certificate's CN:",{"_3461":1469,"_30106":1265,"_20907":53676,"_5":14363,"_27392":53140,"_2946":53533},[],{"_3461":1470,"_30106":1265,"_20907":53678,"_5":14363,"_27392":53140,"_2946":53536},[],{"_3461":1471,"_30106":1265,"_20907":53680,"_5":14363,"_27392":53140,"_2946":53681},[],"`Absent` → `Provisioned`",{"_3461":1472,"_30106":1265,"_20907":53683,"_5":14363,"_27392":53140,"_2946":53684},[],"policies created/updated, Thing groups ensured, `iot:RegisterThing` (creates the Thing, registers the certificate, attaches policies)",{"_3461":1473,"_30106":1265,"_20907":53686,"_5":14363,"_27392":53140,"_2946":53687},[],"`Provisioned` → `Provisioned` (re-enrollment)",{"_3461":1474,"_30106":1265,"_20907":53689,"_5":14363,"_27392":53140,"_2946":53690},[],"stale principals marked `REVOKED`, new `iot:RegisterThing` run; the new certificate ARN replaces the old one in Lamassu metadata",{"_3461":1475,"_30106":1265,"_20907":53692,"_5":14363,"_27392":53140,"_2946":53693},[],"In `jitp` mode the connector makes no provisioning calls: AWS executes the JITP template on the device's first connection and creates the Thing, registers the certificate and activates it on its own.",{"_3461":1476,"_30106":1265,"_20907":53695,"_5":14363,"_27392":53144,"_2946":53696},[],"In JITP mode the device also performs its EST enrollment conventionally and obtains its certificate from Lamassu. The difference is that AWS IoT Core does not know the device until it attempts its first connection.",{"_3461":1477,"_30106":1265,"_20907":53698,"_5":14363,"_27392":53144,"_2946":53699},[],"When the device establishes its first MQTT connection to AWS IoT Core presenting the Lamassu-issued certificate, AWS detects that the certificate belongs to a CA registered with a JITP template, executes that template and creates the Thing automatically. The initial connection may fail or be delayed while the template runs; firmware must be prepared to retry the connection.",{"_3461":1478,"_30106":1265,"_20907":53701,"_5":14363,"_27392":53144,"_2946":53702},[],"For the JITP flow to work correctly:",{"_3461":1479,"_30106":1265,"_20907":53704,"_5":14363,"_27392":53144,"_2946":53705},[],"The CA must be registered in AWS in Primary Account mode (SNI-only mode does not support JITP).",{"_3461":1480,"_30106":1265,"_20907":53707,"_5":14363,"_27392":53144,"_2946":53708},[],"The IAM role configured in `jitp_config.provisioning_role_arn` must exist and have permissions to create Things, register certificates and attach policies in the AWS account.",{"_3461":1481,"_30106":1265,"_20907":53710,"_5":14363,"_27392":53144,"_2946":53711},[],"The device must present both its certificate and the issuing CA's certificate in the TLS handshake with AWS IoT Core.",{"_3461":1482,"_30106":1265,"_20907":53713,"_5":14363,"_27392":53144,"_2946":53714},[],"Certificates provisioned via JITP **do not have the connector's metadata key** (`lamassu.io/iot/{connector_id}`) in Lamassu. As a consequence, status changes of those certificates in Lamassu are not automatically synced to AWS through the state synchronization mechanism described in the next section.",{"_3461":1483,"_30106":1265,"_20907":53716,"_5":14363,"_27392":53148,"_2946":53717},[],"The connector listens for the `EventUpdateCertificateStatusKey` event and, when a certificate holding the connector's metadata key changes status in Lamassu, replicates that change in AWS IoT Core. The following table shows the status mapping:",{"_3461":1484,"_30106":1265,"_20907":53719,"_5":14363,"_27392":53148,"_2946":53720},[],"Status in Lamassu",{"_3461":1485,"_30106":1265,"_20907":53722,"_5":14363,"_27392":53148,"_2946":53723},[],"Revocation reason",{"_3461":1486,"_30106":1265,"_20907":53725,"_5":14363,"_27392":53148,"_2946":53726},[],"Status in AWS IoT Core",{"_3461":1487,"_30106":1265,"_20907":53728,"_5":14363,"_27392":53148,"_2946":53729},[],"`Active`",{"_3461":1488,"_30106":1265,"_20907":53731,"_5":14363,"_27392":53148,"_2946":53732},[],"None",{"_3461":1489,"_30106":1265,"_20907":53734,"_5":14363,"_27392":53148,"_2946":53735},[],"`ACTIVE`",{"_3461":1490,"_30106":1265,"_20907":53737,"_5":14363,"_27392":53148,"_2946":53738},[],"`Revoked`",{"_3461":1491,"_30106":1265,"_20907":53740,"_5":14363,"_27392":53148,"_2946":53741},[],"`certificateHold`",{"_3461":1492,"_30106":1265,"_20907":53743,"_5":14363,"_27392":53148,"_2946":53744},[],"`INACTIVE`",{"_3461":1493,"_30106":1265,"_20907":53746,"_5":14363,"_27392":53148,"_2946":53738},[],{"_3461":1494,"_30106":1265,"_20907":53748,"_5":14363,"_27392":53148,"_2946":53749},[],"Any other reason",{"_3461":1495,"_30106":1265,"_20907":53751,"_5":14363,"_27392":53148,"_2946":53752},[],"`REVOKED`",{"_3461":1496,"_30106":1265,"_20907":53754,"_5":14363,"_27392":53148,"_2946":53755},[],"Only the `Active` and `Revoked` states produce a call to `iot:UpdateCertificate`. The other lifecycle states of Lamassu (`RenewalWindow`, `AboutToExpire`, `Expired`) are not synced to AWS IoT Core; the certificate status in AWS remains unchanged until the status in Lamassu becomes `Active` or `Revoked`.",{"_3461":1497,"_30106":1265,"_20907":53757,"_5":14363,"_27392":53152,"_2946":53758},[],"Certificates holding the connector's metadata key sync their status; certificates provisioned via JITP have no metadata key and stay out of this machine:",{"_3461":1498,"_30106":1265,"_20907":53760,"_5":14363,"_27392":53152,"_2946":53533},[],{"_3461":1499,"_30106":1265,"_20907":53762,"_5":14363,"_27392":53152,"_2946":53536},[],{"_3461":1500,"_30106":1265,"_20907":53764,"_5":14363,"_27392":53152,"_2946":53765},[],"`NotSynced` → `Active`",{"_3461":1501,"_30106":1265,"_20907":53767,"_5":14363,"_27392":53152,"_2946":53244},[],{"_3461":1502,"_30106":1265,"_20907":53769,"_5":14363,"_27392":53152,"_2946":53770},[],"`Active` → `Inactive`",{"_3461":1503,"_30106":1265,"_20907":53772,"_5":14363,"_27392":53152,"_2946":53773},[],"`iot:UpdateCertificate` + forced MQTT disconnect",{"_3461":1504,"_30106":1265,"_20907":53775,"_5":14363,"_27392":53152,"_2946":53776},[],"`Active` → `Revoked`",{"_3461":1505,"_30106":1265,"_20907":53778,"_5":14363,"_27392":53152,"_2946":53773},[],{"_3461":1506,"_30106":1265,"_20907":53780,"_5":14363,"_27392":53152,"_2946":53781},[],"`Inactive` / `Revoked` → `Active`",{"_3461":1507,"_30106":1265,"_20907":53783,"_5":14363,"_27392":53152,"_2946":53244},[],{"_3461":1508,"_30106":1265,"_20907":53785,"_5":14363,"_27392":53152,"_2946":53786},[],"`RenewalWindow` / `AboutToExpire` / `Expired`",{"_3461":1509,"_30106":1265,"_20907":53788,"_5":14363,"_27392":53152,"_2946":53789},[],"none (these states are not synced to AWS)",{"_3461":1510,"_30106":1265,"_20907":53791,"_5":14363,"_27392":53156,"_2946":53792},[],"When the connector marks a certificate as `REVOKED` or `INACTIVE` in AWS, it additionally performs a forced disconnect of the device. To do so it opens an MQTT connection over WebSocket (with SigV4 authentication using the connector's credentials) to the AWS IoT Core data endpoint, using the certificate's CN as the MQTT client identifier, and closes it immediately. This terminates any active MQTT session the device may have at that moment.",{"_3461":1511,"_30106":1265,"_20907":53794,"_5":14363,"_27392":53156,"_2946":53795},[],"This forced disconnect happens at the moment Lamassu records the status change. If the device tries to reconnect after the disconnect, AWS IoT Core will reject the connection because the certificate is already listed as `REVOKED` or `INACTIVE`.",{"_3461":1512,"_30106":1265,"_20907":53797,"_5":14363,"_27392":53156,"_2946":53798},[],"Certificates provisioned in JITP mode do not have this automatic sync, since they lack the connector's metadata key.",{"_3461":1513,"_30106":1265,"_20907":53800,"_5":14363,"_27392":53160,"_2946":53801},[],"The connector can write to the AWS IoT Core Device Shadow to send action signals to the device firmware. This feature is enabled per DMS with `shadow_config.enable: true`.",{"_3461":1514,"_30106":1265,"_20907":53803,"_5":14363,"_27392":53160,"_2946":53804},[],"If `shadow_config.shadow_name` holds a value, the connector uses a Named Shadow with that name; otherwise it uses the Classic Shadow (the Thing's default shadow).",{"_3461":1515,"_30106":1265,"_20907":53806,"_5":14363,"_27392":53164,"_2946":53807},[],"The connector writes to the `desired.identity_actions` field of the shadow document. Each entry contains a Unix timestamp in milliseconds. The device firmware must read this field and act accordingly.",{"_3461":1516,"_30106":1265,"_20907":53809,"_5":14363,"_27392":53164,"_2946":53810},[],"There are two action types:",{"_3461":1517,"_30106":1265,"_20907":53812,"_5":14363,"_27392":53164,"_2946":53813},[],"**`UPDATE_CERTIFICATE`**: written when a certificate's preventive renewal window activates — that is, when the `triggered` field of the preventive renewal delta flips from `false` to `true`. This action tells the device it must start the re-enrollment process to renew its certificate before it expires.",{"_3461":1518,"_30106":1265,"_20907":53815,"_5":14363,"_27392":53164,"_2946":53816},[],"**`UPDATE_TRUST_ANCHOR_LIST`**: written to all devices of a DMS when the DMS's `ManagedCAs` list changes. This action tells the device it must update its trusted CA store.",{"_3461":1519,"_30106":1265,"_20907":53818,"_5":14363,"_27392":53164,"_2946":53819},[],"The shadow write process consists of reading the current shadow (`iotdata:GetThingShadow`), merging the new actions with the existing ones and writing the result (`iotdata:UpdateThingShadow`). If the shadow does not exist, the connector creates it. After a successful write, the list of pending actions in the device's metadata in Lamassu is cleared.",{"_3461":1520,"_30106":1265,"_20907":53821,"_5":14363,"_27392":53168,"_2946":53822},[],"The connector creates and attaches the policies configured in the DMS. A typical policy for a device using MQTT and the Device Shadow has this structure:",{"_3461":1521,"_30106":1265,"_20907":53824,"_5":14363,"_27392":53168,"_2946":53825},[],"In the policy above, the `<AWS_REGION>` and `<AWS_ACCOUNT_ID>` placeholders must be replaced with the AWS region and the twelve-digit account identifier of the target account before applying the policy. The `${iot:Connection.Thing.ThingName}` variable automatically limits each permission to the Thing the device is connected as, following the principle of least privilege. The `${ShadowName}` variable in the shadow ARNs is a placeholder that must be replaced with the `shadow_config.shadow_name` value configured in the DMS; if the Classic Shadow is used, it can be simplified by removing the `name/${ShadowName}/` segment. AWS IoT policies do not support regex alternation; the `[name/${ShadowName}/]*` notation represents the optionality of that segment within ARN syntax constraints.",{"_3461":1522,"_30106":1265,"_20907":53827,"_5":14363,"_27392":53168,"_2946":53828},[],"The first statement lets the device connect using its ThingName as the MQTT identifier. The second authorizes publishing to the Thing's generic MQTT topic and to the shadow topics, needed so the device can update its reported state. The last two statements grant subscribe and receive permissions over the same topics, letting the device receive shadow updates (for example, the `UPDATE_CERTIFICATE` and `UPDATE_TRUST_ANCHOR_LIST` actions written by the connector).",{"_3461":1523,"_30106":1265,"_20907":53830,"_5":14363,"_27392":53172,"_2946":53831},[],"**Symptom:** The CA registration stays in `REQUESTED` indefinitely.",{"_3461":1524,"_30106":1265,"_20907":53833,"_5":14363,"_27392":53172,"_2946":53834},[],"**Cause:** The connector is not running or is not subscribed to the event bus. It can also indicate incorrect IAM credentials, insufficient permissions or that the metadata key was written with a wrong `connector_id`.",{"_3461":1525,"_30106":1265,"_20907":53836,"_5":14363,"_27392":53172,"_2946":53837},[],"**Resolution:** Verify the connector process is active and the logs show no AWS communication errors. Check the metadata field was written under the exact key `lamassu.io/iot/{connector_id}`. If the error persists, the connector will update the status to `FAILED` with a descriptive message in the CA metadata.",{"_3461":1526,"_30106":1265,"_20907":53839,"_5":14363,"_27392":53172,"_2946":53840},[],"**Symptom:** A certificate's status is not synced to AWS after a revocation.",{"_3461":1527,"_30106":1265,"_20907":53842,"_5":14363,"_27392":53172,"_2946":53843},[],"**Cause:** Most commonly the certificate was provisioned in JITP mode. JITP certificates lack the connector's metadata key and are outside the state synchronization mechanism. If the DMS is in `auto` mode, it may indicate the initial provisioning did not complete correctly and the AWS ARN was not stored in the certificate metadata.",{"_3461":1528,"_30106":1265,"_20907":53845,"_5":14363,"_27392":53172,"_2946":53846},[],"**Resolution:** For JITP certificates, migrate the DMS to `auto` mode and re-provision the affected devices. For `auto` mode certificates, verify the certificate has the AWS ARN stored in its metadata; if not, repeat the provisioning.",{"_3461":1529,"_30106":1265,"_20907":53848,"_5":14363,"_27392":53172,"_2946":53849},[],"**Symptom:** The forced disconnect does not terminate the device's MQTT session after revocation.",{"_3461":1530,"_30106":1265,"_20907":53851,"_5":14363,"_27392":53172,"_2946":53852},[],"**Cause:** The device uses an MQTT client ID different from the certificate's CN. The forced disconnect opens a connection using the CN as client ID; if the firmware uses another identifier, the disconnect does not affect that session.",{"_3461":1531,"_30106":1265,"_20907":53854,"_5":14363,"_27392":53172,"_2946":53855},[],"**Resolution:** Make sure the firmware uses exactly the certificate's CN as the MQTT client identifier. That CN matches the ThingName in AWS IoT Core.",{"_3461":1532,"_30106":1265,"_20907":53857,"_5":14363,"_27392":53172,"_2946":53858},[],"**Symptom:** The device receives `CLIENT_ID_REJECTED` when connecting to AWS IoT Core.",{"_3461":1533,"_30106":1265,"_20907":53860,"_5":14363,"_27392":53172,"_2946":53861},[],"**Cause:** The MQTT client ID does not match the ThingName, which is always the CN of the certificate issued by Lamassu.",{"_3461":1534,"_30106":1265,"_20907":53863,"_5":14363,"_27392":53172,"_2946":53864},[],"**Resolution:** Verify the firmware uses exactly the value of the CN field included in the enrollment CSR as the MQTT client identifier.",{"_3461":1535,"_30106":1265,"_20907":53866,"_5":14363,"_27392":53172,"_2946":53867},[],"**Symptom:** The device's first MQTT connection in JITP mode fails or times out.",{"_3461":1536,"_30106":1265,"_20907":53869,"_5":14363,"_27392":53172,"_2946":53870},[],"**Cause:** This is expected behavior while AWS executes the JITP template on the device's first connection.",{"_3461":1537,"_30106":1265,"_20907":53872,"_5":14363,"_27392":53172,"_2946":53873},[],"**Resolution:** Firmware must implement retries with exponential backoff for the first connection. If the failure persists beyond a few minutes, verify the IAM role configured in `jitp_config.provisioning_role_arn` exists in the account and has permissions to create Things, register certificates and attach policies.",{"_3461":1538,"_30106":1265,"_20907":53875,"_5":14363,"_27392":53172,"_2946":53876},[],"**Symptom:** The Device Shadow is not updated when it should be.",{"_3461":1539,"_30106":1265,"_20907":53878,"_5":14363,"_27392":53172,"_2946":53879},[],"**Cause:** The shadow feature is disabled in the DMS configuration, the connector's credentials lack IoT data-plane permissions, or the firmware reads a different shadow than the configured one.",{"_3461":1540,"_30106":1265,"_20907":53881,"_5":14363,"_27392":53172,"_2946":53882},[],"**Resolution:** Check that `shadow_config.enable` is `true` in the connector metadata for the corresponding DMS. If a Named Shadow is used, verify `shadow_config.shadow_name` holds the correct name and that the firmware reads that Named Shadow and not the Classic Shadow. Confirm the connector's credentials have `iotdata:GetThingShadow` and `iotdata:UpdateThingShadow` permissions.",{"_3461":1541,"_30106":1265,"_20907":53884,"_5":14363,"_27392":53172,"_2946":53885},[],"**Symptom:** After editing a DMS in `jitp` mode, DMS update messages appear in `lamassu-dlq`, or JITP configuration changes have no effect in AWS.",{"_3461":1542,"_30106":1265,"_20907":53887,"_5":14363,"_27392":53172,"_2946":53888},[],"**Cause:** Every full DMS edit (`PUT /v1/dms/{id}`) triggers a `CreateProvisioningTemplate` attempt for the template named after the DMS ID, and the call is not idempotent: when the template already exists, it fails, the event is retried three times and finally lands in `lamassu-dlq`. The connector’s later steps are skipped.",{"_3461":1543,"_30106":1265,"_20907":53890,"_5":14363,"_27392":53172,"_2946":53891},[],"**Resolution:** Check that the template named with the DMS ID exists in AWS IoT Core and that JITP enrollment works. If the JITP configuration was changed, apply it by hand to the AWS template.",{"_3461":1544,"_30106":1265,"_20907":53893,"_5":14363,"_27392":53172,"_2946":53894},[],"<Card title=\"Configure a DMS\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_3461":1545,"_30106":1265,"_20907":53896,"_5":14363,"_27392":53172,"_2946":53897},[],"<Card title=\"Device enrollment (EST)\" href=\"/docs/platform/iot-fleets/enrollment/overview\" />",{"_3461":1546,"_30106":1265,"_20907":53899,"_5":14363,"_27392":53172,"_2946":53900},[],"<Card title=\"Certificate management\" href=\"/docs/platform/pki/certificates\" />",{"_3461":1547,"_30106":1547,"_5":14715,"_2946":51607,"_30438":53902,"_20907":53903,"_27392":1547},[49125,50593,51607],[],{"_3461":1548,"_30106":1547,"_20907":53905,"_5":14363,"_27392":1547,"_2946":53906},[],"Organize devices and their identities, prepare enrollment and integrate consumers.",{"_3461":1549,"_30106":1547,"_5":30435,"_20907":53908,"_27392":53909,"_2946":53910},[],"/docs/platform/iot-fleets/overview#start-here","Start here",{"_3461":1550,"_30106":1547,"_5":30435,"_20907":53912,"_27392":53913,"_2946":51605},[],"/docs/platform/iot-fleets/overview#devices-and-identities",{"_3461":1551,"_30106":1547,"_5":30435,"_20907":53915,"_27392":53916,"_2946":51788},[],"/docs/platform/iot-fleets/overview#enrollment-with-pki",{"_3461":1552,"_30106":1547,"_5":30435,"_20907":53918,"_27392":53919,"_2946":53069},[],"/docs/platform/iot-fleets/overview#integrations",{"_3461":1553,"_30106":1547,"_5":30435,"_20907":53921,"_27392":53922,"_2946":53923},[],"/docs/platform/iot-fleets/overview#who-prepares-each-part","Who prepares each part",{"_3461":1554,"_30106":1547,"_20907":53925,"_5":14363,"_27392":1547,"_2946":53926},[],"IoT Fleets applies PKI to the device lifecycle: registration, obtaining an identity, renewal and retirement. It is intended for those who administer a device population and those who integrate its enrollment client or the system that accepts it.",{"_3461":1555,"_30106":1547,"_20907":53928,"_5":14363,"_27392":53909,"_2946":53929},[],"Follow Enroll and connect your first device to prepare a DMS, obtain the identity from the client and demonstrate an mTLS connection. The automatic path includes initial trust, a CSR and result checks.",{"_3461":1556,"_30106":1547,"_20907":53931,"_5":14363,"_27392":53909,"_2946":53932},[],"To start with an existing certificate, use Register a device manually. You can then prepare enrollment and renewal for the next device.",{"_3461":1557,"_30106":1547,"_20907":53934,"_5":14363,"_27392":53913,"_2946":53935},[],"Resource",{"_3461":1558,"_30106":1547,"_20907":53937,"_5":14363,"_27392":53913,"_2946":53938},[],"What it represents",{"_3461":1559,"_30106":1547,"_20907":53940,"_5":14363,"_27392":53913,"_2946":53941},[],"**Device**",{"_3461":1560,"_30106":1547,"_20907":53943,"_5":14363,"_27392":53913,"_2946":53944},[],"An inventory entry with an identifier, owning DMS and classification.",{"_3461":1561,"_30106":1547,"_20907":53946,"_5":14363,"_27392":53913,"_2946":53947},[],"**Identity**",{"_3461":1562,"_30106":1547,"_20907":53949,"_5":14363,"_27392":53913,"_2946":53950},[],"The device's association with its certificates: an active version and a history.",{"_3461":1563,"_30106":1547,"_20907":53952,"_5":14363,"_27392":53913,"_2946":53953},[],"**DMS**",{"_3461":1564,"_30106":1547,"_20907":53955,"_5":14363,"_27392":53913,"_2946":53956},[],"The service that configures admission, enrollment, renewal and trust distribution.",{"_3461":1565,"_30106":1547,"_20907":53958,"_5":14363,"_27392":53913,"_2946":53959},[],"**Fleet**",{"_3461":1566,"_30106":1547,"_20907":53961,"_5":14363,"_27392":53913,"_2946":53962},[],"The population you operate, represented through devices, DMSs, tags and metadata.",{"_3461":1567,"_30106":1547,"_20907":53964,"_5":14363,"_27392":53913,"_2946":53965},[],"Each device has an owning DMS. You can organize a population through several DMSs when it needs different policies, and use tags to classify it. “Fleet” describes that operational context; the resources you create and query are DMSs and devices.",{"_3461":1568,"_30106":1547,"_20907":53967,"_5":14363,"_27392":53913,"_2946":53968},[],"Device management covers states, certificate history and identity actions. During renewal, retain the relationship with the device and check which certificate becomes the current identity.",{"_3461":1569,"_30106":1547,"_20907":53970,"_5":14363,"_27392":53916,"_2946":53971},[],"This section connects PKI rules to the device client. Preparation follows this order:",{"_3461":1570,"_30106":1547,"_20907":53973,"_5":14363,"_27392":53916,"_2946":53974},[],"**CA and profile:** prepare the issuer and certificate rules in PKI.",{"_3461":1571,"_30106":1547,"_20907":53976,"_5":14363,"_27392":53916,"_2946":53977},[],"**DMS policy:** define how the device is admitted, how requests authenticate and which trust is distributed.",{"_3461":1572,"_30106":1547,"_20907":53979,"_5":14363,"_27392":53916,"_2946":53980},[],"**Client:** prepare the initial credential, server trust, and key generation or custody.",{"_3461":1573,"_30106":1547,"_20907":53982,"_5":14363,"_27392":53916,"_2946":53983},[],"**Result:** request the certificate, install it and check its association with the device.",{"_3461":1574,"_30106":1547,"_20907":53985,"_5":14363,"_27392":53916,"_2946":53986},[],"**Continuity:** configure renewal, successor installation and recovery according to DMS policy.",{"_3461":1575,"_30106":1547,"_20907":53988,"_5":14363,"_27392":53916,"_2946":53989},[],"<Card title=\"Configure the DMS\" description=\"Prepare the CA, admission, authentication and renewal rules.\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_3461":1576,"_30106":1547,"_20907":53991,"_5":14363,"_27392":53916,"_2946":53992},[],"<Card title=\"Integrate the EST client\" description=\"Review the device endpoints, formats and checks.\" href=\"/docs/platform/iot-fleets/enrollment/est-client\" />",{"_3461":1577,"_30106":1547,"_20907":53994,"_5":14363,"_27392":53919,"_2946":53995},[],"An issued identity needs a consumer that trusts its issuer, validates the certificate and grants the device permissions. Prepare both the device's trust in the server and the server's trust in the device.",{"_3461":1578,"_30106":1547,"_20907":53997,"_5":14363,"_27392":53919,"_2946":53998},[],"The AWS IoT Core guide explains how to use the identity in that destination. Provisioning in Lamassu and provisioning in the destination are separate decisions; review the conditions of the chosen mode before expecting state synchronization.",{"_3461":1579,"_30106":1547,"_20907":54000,"_5":14363,"_27392":53922,"_2946":54001},[],"Participant",{"_3461":1580,"_30106":1547,"_20907":54003,"_5":14363,"_27392":53922,"_2946":54004},[],"Responsibility",{"_3461":1581,"_30106":1547,"_20907":54006,"_5":14363,"_27392":53922,"_2946":54007},[],"PKI administrator",{"_3461":1582,"_30106":1547,"_20907":54009,"_5":14363,"_27392":53922,"_2946":54010},[],"CA, issuance profile, chain and revocation publication.",{"_3461":1583,"_30106":1547,"_20907":54012,"_5":14363,"_27392":53922,"_2946":54013},[],"Provisioning administrator",{"_3461":1584,"_30106":1547,"_20907":54015,"_5":14363,"_27392":53922,"_2946":54016},[],"DMS, admission, authentication per operation and inventory.",{"_3461":1585,"_30106":1547,"_20907":54018,"_5":14363,"_27392":53922,"_2946":54019},[],"Device integrator",{"_3461":1586,"_30106":1547,"_20907":54021,"_5":14363,"_27392":53922,"_2946":54022},[],"Initial credential, key, EST client, trust and certificate installation.",{"_3461":1587,"_30106":1547,"_20907":54024,"_5":14363,"_27392":53922,"_2946":54025},[],"Consumer integrator",{"_3461":1588,"_30106":1547,"_20907":54027,"_5":14363,"_27392":53922,"_2946":54028},[],"Trusted issuers, validation and device permissions in the destination.",{"_3461":1589,"_30106":1547,"_20907":54030,"_5":14363,"_27392":53922,"_2946":54031},[],"Permissions and audit are shared with the rest of Platform. Prepare installation and instance connectivity in Deployment.",{"_3461":1590,"_30106":1590,"_5":14715,"_2946":54033,"_30438":54034,"_20907":54036,"_27392":1590},"Enroll and connect your first device",[49125,50593,51607,54035],"Getting started",[],{"_3461":1591,"_30106":1590,"_20907":54038,"_5":14363,"_27392":1590,"_2946":54039},[],"Obtain an identity through EST, verify its association and use it in an mTLS connection.",{"_3461":1592,"_30106":1590,"_5":30435,"_20907":54041,"_27392":54042,"_2946":49135},[],"/docs/platform/iot-fleets/quickstarts/enroll-device#before-you-begin",{"_3461":1593,"_30106":1590,"_5":30435,"_20907":54044,"_27392":54045,"_2946":54046},[],"/docs/platform/iot-fleets/quickstarts/enroll-device#prepare-the-bootstrap-credential","Prepare the bootstrap credential",{"_3461":1594,"_30106":1590,"_5":30435,"_20907":54048,"_27392":54049,"_2946":54050},[],"/docs/platform/iot-fleets/quickstarts/enroll-device#configure-the-evaluation-dms","Configure the evaluation DMS",{"_3461":1595,"_30106":1590,"_5":30435,"_20907":54052,"_27392":54053,"_2946":54054},[],"/docs/platform/iot-fleets/quickstarts/enroll-device#prepare-the-client-and-check-cacerts","Prepare the client and check cacerts",{"_3461":1596,"_30106":1590,"_5":30435,"_20907":54056,"_27392":54057,"_2946":54058},[],"/docs/platform/iot-fleets/quickstarts/enroll-device#enroll-the-device","Enroll the device",{"_3461":1597,"_30106":1590,"_5":30435,"_20907":54060,"_27392":54061,"_2946":54062},[],"/docs/platform/iot-fleets/quickstarts/enroll-device#verify-the-obtained-identity","Verify the obtained identity",{"_3461":1598,"_30106":1590,"_5":30435,"_20907":54064,"_27392":54065,"_2946":54066},[],"/docs/platform/iot-fleets/quickstarts/enroll-device#demonstrate-an-mtls-connection","Demonstrate an mTLS connection",{"_3461":1599,"_30106":1590,"_5":30435,"_20907":54068,"_27392":54069,"_2946":54070},[],"/docs/platform/iot-fleets/quickstarts/enroll-device#result-and-continuity","Result and continuity",{"_3461":1600,"_30106":1590,"_20907":54072,"_5":14363,"_27392":1590,"_2946":54073},[],"Prepare an evaluation DMS, enroll `est-device-001` from the client and use its identity with a local consumer that requires a certificate. The path connects administrator policy to the material the device actually installs.",{"_3461":1601,"_30106":1590,"_20907":54075,"_5":14363,"_27392":54042,"_2946":54076},[],"A Lamassu instance accessible through HTTPS and permissions for CAs, profiles, DMSs and reading devices/certificates.",{"_3461":1602,"_30106":1590,"_20907":54078,"_5":14363,"_27392":54042,"_2946":54079},[],"Bash, OpenSSL 3.x, curl with `--fail-with-body` and two terminals on your computer. Work in a new directory with restricted access.",{"_3461":1603,"_30106":1590,"_20907":54081,"_5":14363,"_27392":54042,"_2946":54082},[],"An active root CA that issues directly, with an available key and sufficient validity. Follow Create your first CA. Save its verified public certificate as `device-root.pem`.",{"_3461":1604,"_30106":1590,"_20907":54084,"_5":14363,"_27392":54042,"_2946":54085},[],"Available global identifier `est-device-001`. This path uses automatic registration: do not create the device in the console first.",{"_3461":1605,"_30106":1590,"_20907":54087,"_5":14363,"_27392":54042,"_2946":54088},[],"The approved root for Lamassu HTTPS in `est-trust.pem`, obtained through an independent channel. It can differ from the device CA; prepare networking/TLS in Deployment.",{"_3461":1606,"_30106":1590,"_20907":54090,"_5":14363,"_27392":54045,"_2946":54091},[],"Issue a bootstrap leaf certificate with `CN=est-device-001`, its own key and Client Authentication use. Follow Issue and verify a certificate, changing its CN and saving the result as `bootstrap.crt` and `bootstrap.key`. Choose validity that covers this test and check the pair and chain.",{"_3461":1607,"_30106":1590,"_20907":54093,"_5":14363,"_27392":54045,"_2946":54094},[],"The same root CA can issue it for this isolated evaluation. The operational identity will have a different key and certificate. The matching CN makes the example easier to read; initial certificate authentication does not itself bind the bootstrap CN to the requested ID. Review admission before applying the policy to a population.",{"_3461":1608,"_30106":1590,"_20907":54096,"_5":14363,"_27392":54049,"_2946":54097},[],"Create an explicit leaf profile compatible with EC P-256, with **Honor Subject**, CN from the CSR, **Digital Signature**, **Client Authentication** and **1 hour** validity within the root's validity. Do not enable CA signing. Rules and precedence are explained in Profiles.",{"_3461":1609,"_30106":1590,"_20907":54099,"_5":14363,"_27392":54049,"_2946":54100},[],"Create the `Acme EST Evaluation` DMS with this configuration:",{"_3461":1610,"_30106":1590,"_20907":54102,"_5":14363,"_27392":54049,"_2946":54103},[],"Setting",{"_3461":1611,"_30106":1590,"_20907":54105,"_5":14363,"_27392":54049,"_2946":54106},[],"Evaluation value",{"_3461":1612,"_30106":1590,"_20907":54108,"_5":14363,"_27392":54049,"_2946":54109},[],"Enrollment CA",{"_3461":1613,"_30106":1590,"_20907":54111,"_5":14363,"_27392":54049,"_2946":54112},[],"Issuing root from `device-root.pem`.",{"_3461":1614,"_30106":1590,"_20907":54114,"_5":14363,"_27392":54049,"_2946":51918},[],{"_3461":1615,"_30106":1590,"_20907":54116,"_5":14363,"_27392":54049,"_2946":54117},[],"The 1-hour leaf profile you just prepared.",{"_3461":1616,"_30106":1590,"_20907":54119,"_5":14363,"_27392":54049,"_2946":54120},[],"Protocol / Registration Mode",{"_3461":1617,"_30106":1590,"_20907":54122,"_5":14363,"_27392":54049,"_2946":54123},[],"`EST_RFC7030` / `JITP`.",{"_3461":1618,"_30106":1590,"_20907":54125,"_5":14363,"_27392":54049,"_2946":54126},[],"Verify CSR Signature",{"_3461":1619,"_30106":1590,"_20907":54128,"_5":14363,"_27392":54049,"_2946":54129},[],"Enabled.",{"_3461":1620,"_30106":1590,"_20907":54131,"_5":14363,"_27392":54049,"_2946":54132},[],"Enable Replaceable Enrollment",{"_3461":1621,"_30106":1590,"_20907":54134,"_5":14363,"_27392":54049,"_2946":54135},[],"Disabled; the ID must be new.",{"_3461":1622,"_30106":1590,"_20907":54137,"_5":14363,"_27392":54049,"_2946":54138},[],"Initial authentication",{"_3461":1623,"_30106":1590,"_20907":54140,"_5":14363,"_27392":54049,"_2946":54141},[],"`CLIENT_CERTIFICATE`; Validation CAs includes the direct bootstrap issuer; no expired certificates.",{"_3461":1624,"_30106":1590,"_20907":54143,"_5":14363,"_27392":54049,"_2946":54144},[],"Renewal authentication",{"_3461":1625,"_30106":1590,"_20907":54146,"_5":14363,"_27392":54049,"_2946":54147},[],"`CLIENT_CERTIFICATE`, configured in the independent re-enrollment block.",{"_3461":1626,"_30106":1590,"_20907":54149,"_5":14363,"_27392":54049,"_2946":54150},[],"Re-enrollment Validation CAs / Enable Expired Renewal",{"_3461":1627,"_30106":1590,"_20907":54152,"_5":14363,"_27392":54049,"_2946":54153},[],"Not needed for this direct issuance; the Enrollment CA is always trusted for re-enrollment / disabled.",{"_3461":1628,"_30106":1590,"_20907":54155,"_5":14363,"_27392":54049,"_2946":54156},[],"Re-enrollment Delta",{"_3461":1629,"_30106":1590,"_20907":54158,"_5":14363,"_27392":54049,"_2946":54159},[],"1 hour.",{"_3461":1630,"_30106":1590,"_20907":54161,"_5":14363,"_27392":54049,"_2946":54162},[],"Preventive / Critical Delta",{"_3461":1631,"_30106":1590,"_20907":54164,"_5":14363,"_27392":54049,"_2946":54165},[],"30 minutes / 10 minutes.",{"_3461":1632,"_30106":1590,"_20907":54167,"_5":14363,"_27392":54049,"_2946":54168},[],"Revoke on Re-enrollment",{"_3461":1633,"_30106":1590,"_20907":54170,"_5":14363,"_27392":54049,"_2946":54171},[],"Disabled to test the successor before retiring the previous identity.",{"_3461":1634,"_30106":1590,"_20907":54173,"_5":14363,"_27392":54049,"_2946":51926},[],{"_3461":1635,"_30106":1590,"_20907":54175,"_5":14363,"_27392":54049,"_2946":54176},[],"Disabled; the operational key is generated in the client.",{"_3461":1636,"_30106":1590,"_20907":54178,"_5":14363,"_27392":54049,"_2946":54179},[],"CA Distribution",{"_3461":1637,"_30106":1590,"_20907":54181,"_5":14363,"_27392":54049,"_2946":54182},[],"Include Enrollment CA enabled; Include Lamassu System CA disabled.",{"_3461":1638,"_30106":1590,"_20907":54184,"_5":14363,"_27392":54049,"_2946":54185},[],"Equal duration and window allow immediate renewal testing. These are evaluation values; size production settings according to connectivity and recovery times. Save, reread both authentication blocks and retain the DMS ID. The console exposes independent editors for the enrollment and re-enrollment authentication; the DMS guide describes their fields, and you can also check the resource through the DMS API.",{"_3461":1639,"_30106":1590,"_20907":54187,"_5":14363,"_27392":54053,"_2946":54188},[],"Place the four trust and bootstrap files in the new directory. Replace the URL with your installation's URL:",{"_3461":1640,"_30106":1590,"_20907":54190,"_5":14363,"_27392":54053,"_2946":54191},[],"The download must succeed and contain the expected enrollment root. Compare its fingerprint with `device-root.pem`. This check does not turn the response into initial trust or prove that you can issue.",{"_3461":1641,"_30106":1590,"_20907":54193,"_5":14363,"_27392":54057,"_2946":54194},[],"Generate a new key and CSR with the selected identifier:",{"_3461":1642,"_30106":1590,"_20907":54196,"_5":14363,"_27392":54057,"_2946":54197},[],"Request the identity with the bootstrap credential and extract the certificate from the default response:",{"_3461":1643,"_30106":1590,"_20907":54199,"_5":14363,"_27392":54057,"_2946":54200},[],"If curl fails, use Troubleshooting with the saved body. Do not convert it or repeat the request without querying inventory: a timeout or error can follow persisted issuance.",{"_3461":1644,"_30106":1590,"_20907":54202,"_5":14363,"_27392":54061,"_2946":54203},[],"Expect `device.crt: OK` and exit code 0 from `cmp`. Check the CN, serial, dates, Digital Signature and Client Authentication. The certificate must be a leaf: it must not declare `CA:TRUE` or Certificate Sign use. Check that its validity matches the one-hour profile.",{"_3461":1645,"_30106":1590,"_20907":54205,"_5":14363,"_27392":54061,"_2946":54206},[],"In Lamassu, open `est-device-001`. It must be created with the intended owning DMS, a current identity and the received certificate in its history. Compare the local serial with the slot; thresholds can show a renewal state rather than simply Active.",{"_3461":1646,"_30106":1590,"_20907":54208,"_5":14363,"_27392":54065,"_2946":54209},[],"In a second terminal, enter the same directory and run `umask 077`. Create a local server certificate and start a test consumer. This server trusts `device-root.pem` and requires a valid client identity:",{"_3461":1647,"_30106":1590,"_20907":54211,"_5":14363,"_27392":54065,"_2946":54212},[],"Leave it running. In the first terminal, connect using the obtained identity:",{"_3461":1648,"_30106":1590,"_20907":54214,"_5":14363,"_27392":54065,"_2946":54215},[],"Expect HTTP `200`. The client's trust in this local server is its self-signed `consumer.crt`; the server verifies the device against `device-root.pem`. The HTML file displays OpenSSL diagnostic information.",{"_3461":1649,"_30106":1590,"_20907":54217,"_5":14363,"_27392":54065,"_2946":54218},[],"With the same server still running, test that a request without a client certificate is rejected:",{"_3461":1650,"_30106":1590,"_20907":54220,"_5":14363,"_27392":54065,"_2946":54221},[],"Rejection must correspond to a missing certificate at the server, not a stopped server. Stop the consumer with Ctrl+C after the test. This exercise demonstrates TLS authentication and key possession; your application must also define authorization and revocation consumption. Server options are described in openssl-s\\_server.",{"_3461":1651,"_30106":1590,"_20907":54223,"_5":14363,"_27392":54069,"_2946":54224},[],"Check",{"_3461":1652,"_30106":1590,"_20907":54226,"_5":14363,"_27392":54069,"_2946":54227},[],"Expected result",{"_3461":1653,"_30106":1590,"_20907":54229,"_5":14363,"_27392":54069,"_2946":54230},[],"Registration",{"_3461":1654,"_30106":1590,"_20907":54232,"_5":14363,"_27392":54069,"_2946":54233},[],"ID created automatically and correct DMS.",{"_3461":1655,"_30106":1590,"_20907":54235,"_5":14363,"_27392":54069,"_2946":53491},[],{"_3461":1656,"_30106":1590,"_20907":54237,"_5":14363,"_27392":54069,"_2946":54238},[],"CN, profile, serial and key verified.",{"_3461":1657,"_30106":1590,"_20907":54240,"_5":14363,"_27392":54069,"_2946":54241},[],"Inventory",{"_3461":1658,"_30106":1590,"_20907":54243,"_5":14363,"_27392":54069,"_2946":54244},[],"Received serial visible as the current identity and in history.",{"_3461":1659,"_30106":1590,"_20907":54246,"_5":14363,"_27392":54069,"_2946":54247},[],"Consumer",{"_3461":1660,"_30106":1590,"_20907":54249,"_5":14363,"_27392":54069,"_2946":54250},[],"mTLS responds 200 with the identity and rejects a missing certificate.",{"_3461":1661,"_30106":1590,"_20907":54252,"_5":14363,"_27392":54069,"_2946":54253},[],"Continue with Renewal and recovery to request a successor pair within the window, install it and repeat the mTLS check. The consumer must use the new files in that test. After checking the successor, retire the previous certificate according to PKI policy; the example does not revoke it automatically.",{"_3461":1662,"_30106":1590,"_20907":54255,"_5":14363,"_27392":54069,"_2946":54256},[],"Devices and identities explains retirement and the limits of historical revocation. For a real destination, prepare consumer trust, validation and permissions; AWS IoT Core is an available integration.",{"_3461":1663,"_30106":1663,"_5":14715,"_2946":51623,"_30438":54258,"_20907":54259,"_27392":1663},[49125,50593,51607,54035],[],{"_3461":1664,"_30106":1663,"_20907":54261,"_5":14363,"_27392":1663,"_2946":54262},[],"Prepare a DMS, register a device and associate a verified certificate with its identity.",{"_3461":1665,"_30106":1663,"_5":30435,"_20907":54264,"_27392":54265,"_2946":49135},[],"/docs/platform/iot-fleets/quickstarts/register-device#before-you-begin",{"_3461":1666,"_30106":1663,"_5":30435,"_20907":54267,"_27392":54268,"_2946":54269},[],"/docs/platform/iot-fleets/quickstarts/register-device#prepare-the-dms","Prepare the DMS",{"_3461":1667,"_30106":1663,"_5":30435,"_20907":54271,"_27392":54272,"_2946":54273},[],"/docs/platform/iot-fleets/quickstarts/register-device#register-the-device","Register the device",{"_3461":1668,"_30106":1663,"_5":30435,"_20907":54275,"_27392":54276,"_2946":54277},[],"/docs/platform/iot-fleets/quickstarts/register-device#check-the-initial-status","Check the initial status",{"_3461":1669,"_30106":1663,"_5":30435,"_20907":54279,"_27392":54280,"_2946":54281},[],"/docs/platform/iot-fleets/quickstarts/register-device#assign-an-identity","Assign an identity",{"_3461":1670,"_30106":1663,"_5":30435,"_20907":54283,"_27392":54284,"_2946":54285},[],"/docs/platform/iot-fleets/quickstarts/register-device#verify-the-device","Verify the device",{"_3461":1671,"_30106":1663,"_5":30435,"_20907":54287,"_27392":54288,"_2946":54227},[],"/docs/platform/iot-fleets/quickstarts/register-device#expected-result",{"_3461":1672,"_30106":1663,"_5":30435,"_20907":54290,"_27392":54291,"_2946":54292},[],"/docs/platform/iot-fleets/quickstarts/register-device#if-the-result-fails","If the result fails",{"_3461":1673,"_30106":1663,"_5":30435,"_20907":54294,"_27392":54295,"_2946":54296},[],"/docs/platform/iot-fleets/quickstarts/register-device#automate-the-next-device","Automate the next device",{"_3461":1674,"_30106":1663,"_20907":54298,"_5":14363,"_27392":1663,"_2946":54299},[],"This path is intended for those starting to administer device identities. You will register `device-001` and assign an existing certificate to check the relationship between device, DMS and identity history.",{"_3461":1675,"_30106":1663,"_20907":54301,"_5":14363,"_27392":1663,"_2946":54302},[],"Assignment updates Lamassu's inventory. Install the key and certificate separately on the device; check the connection to a consumer in that destination's integration.",{"_3461":1676,"_30106":1663,"_20907":54304,"_5":14363,"_27392":54265,"_2946":54305},[],"An accessible instance and permission to administer DMSs, devices and certificate associations.",{"_3461":1677,"_30106":1663,"_20907":54307,"_5":14363,"_27392":54265,"_2946":54308},[],"An active CA with an available key. If one does not exist yet, follow Create your first CA.",{"_3461":1678,"_30106":1663,"_20907":54310,"_5":14363,"_27392":54265,"_2946":54311},[],"An active end-entity certificate from that CA whose `Common Name` is exactly `device-001`, together with its private key. Follow Issue and verify a certificate to obtain and check both.",{"_3461":1679,"_30106":1663,"_20907":54313,"_5":14363,"_27392":54265,"_2946":54314},[],"The identifier `device-001` available in the inventory. If you already used it, choose another and issue the certificate with that same `Common Name`.",{"_3461":1680,"_30106":1663,"_20907":54316,"_5":14363,"_27392":54268,"_2946":54317},[],"A DMS must exist before registering the device. If you already have a suitable one, check its CA and note its identifier; to create one:",{"_3461":1681,"_30106":1663,"_20907":54319,"_5":14363,"_27392":54268,"_2946":54320},[],"Open the DMS inventory and its creation action. Assign a recognizable name, such as `Acme Evaluation DMS`.",{"_3461":1682,"_30106":1663,"_20907":54322,"_5":14363,"_27392":54268,"_2946":54323},[],"In **Enrollment CA**, select the CA that issued `device.crt`.",{"_3461":1683,"_30106":1663,"_20907":54325,"_5":14363,"_27392":54268,"_2946":54326},[],"In **Registration Mode**, select `PRE_REGISTRATION` for the path that starts with explicit registration.",{"_3461":1684,"_30106":1663,"_20907":54328,"_5":14363,"_27392":54268,"_2946":54329},[],"In the authentication section, enable **Require client certificate** and leave **Call external webhook** off. Under **Require client certificate**, add the CA whose initial certificates you will accept to **Validation CAs**; for this evaluation, it can be the same CA. Keep **Verify CSR Signature** enabled and leave **Enable server-side key generation** off if you will not use it.",{"_3461":1685,"_30106":1663,"_20907":54331,"_5":14363,"_27392":54268,"_2946":54332},[],"Review renewal and trust distribution settings with the DMS guide, save the service and note its identifier.",{"_3461":1686,"_30106":1663,"_20907":54334,"_5":14363,"_27392":54268,"_2946":54335},[],"Reopen the DMS and confirm that the enrollment CA is the expected one and the service appears in inventory.",{"_3461":1687,"_30106":1663,"_20907":54337,"_5":14363,"_27392":54268,"_2946":54338},[],"These settings prepare DMS policy. The next steps register and assign through the console; they do not send an EST request or test admission through that protocol.",{"_3461":1688,"_30106":1663,"_20907":54340,"_5":14363,"_27392":54272,"_2946":54341},[],"Open **Managed Devices** and the registration action. Complete:",{"_3461":1689,"_30106":1663,"_20907":54343,"_5":14363,"_27392":54272,"_2946":54344},[],"**Device ID**: `device-001`.",{"_3461":1690,"_30106":1663,"_20907":54346,"_5":14363,"_27392":54272,"_2946":54347},[],"**Registration Authority**: the DMS you just prepared; this label identifies the service fulfilling the registration authority role.",{"_3461":1691,"_30106":1663,"_20907":54349,"_5":14363,"_27392":54272,"_2946":54350},[],"**Icon** and **Tags**: optional classification.",{"_3461":1692,"_30106":1663,"_20907":54352,"_5":14363,"_27392":54272,"_2946":54353},[],"Confirm registration.",{"_3461":1693,"_30106":1663,"_20907":54355,"_5":14363,"_27392":54276,"_2946":54356},[],"Open the device. It should appear in **No Identity** and show the selected owning DMS.",{"_3461":1694,"_30106":1663,"_20907":54358,"_5":14363,"_27392":54276,"_2946":54359},[],"Registration creates the inventory entry; the certificate must still be associated.",{"_3461":1695,"_30106":1663,"_20907":54361,"_5":14363,"_27392":54280,"_2946":54362},[],"Select **Assign Identity** and the existing certificate with `CN=device-001`. Check its serial number, issuer and validity against the certificate you verified in PKI.",{"_3461":1696,"_30106":1663,"_20907":54364,"_5":14363,"_27392":54280,"_2946":54365},[],"Confirm the association. The **Issue New Instead** alternative is explained in Devices and identities.",{"_3461":1697,"_30106":1663,"_20907":54367,"_5":14363,"_27392":54284,"_2946":54368},[],"Check that it has an active identity. In **Certificate History**, verify the associated serial number; in **Device Event Timeline**, find the assignment event.",{"_3461":1698,"_30106":1663,"_20907":54370,"_5":14363,"_27392":54284,"_2946":54371},[],"Keep the device identifier, owning DMS and serial number as references for the result.",{"_3461":1699,"_30106":1663,"_20907":54373,"_5":14363,"_27392":54288,"_2946":54224},[],{"_3461":1700,"_30106":1663,"_20907":54375,"_5":14363,"_27392":54288,"_2946":54376},[],"Result",{"_3461":1701,"_30106":1663,"_20907":54378,"_5":14363,"_27392":54288,"_2946":53474},[],{"_3461":1702,"_30106":1663,"_20907":54380,"_5":14363,"_27392":54288,"_2946":54381},[],"`device-001` appears in inventory with the expected DMS.",{"_3461":1703,"_30106":1663,"_20907":54383,"_5":14363,"_27392":54288,"_2946":54384},[],"Current identity",{"_3461":1704,"_30106":1663,"_20907":54386,"_5":14363,"_27392":54288,"_2946":54387},[],"The associated certificate matches the one you verified in PKI.",{"_3461":1705,"_30106":1663,"_20907":54389,"_5":14363,"_27392":54288,"_2946":54390},[],"History",{"_3461":1706,"_30106":1663,"_20907":54392,"_5":14363,"_27392":54288,"_2946":54393},[],"The associated issuance appears with its serial number and dates.",{"_3461":1707,"_30106":1663,"_20907":54395,"_5":14363,"_27392":54288,"_2946":54396},[],"Key and certificate",{"_3461":1708,"_30106":1663,"_20907":54398,"_5":14363,"_27392":54288,"_2946":54399},[],"You have the verified pair ready to install on the device.",{"_3461":1709,"_30106":1663,"_20907":54401,"_5":14363,"_27392":54291,"_2946":54402},[],"If you cannot select the DMS, confirm its creation and your read permissions.",{"_3461":1710,"_30106":1663,"_20907":54404,"_5":14363,"_27392":54291,"_2946":54405},[],"If no eligible certificate appears, check that its `Common Name` matches the `Device ID` exactly, it is active and it was issued by the expected CA.",{"_3461":1711,"_30106":1663,"_20907":54407,"_5":14363,"_27392":54291,"_2946":54408},[],"If assignment fails, review permissions and operation diagnostics before repeating it. Query the device and its history again to find the persisted result.",{"_3461":1712,"_30106":1663,"_20907":54410,"_5":14363,"_27392":54291,"_2946":54411},[],"If an expiration or renewal state appears, check certificate dates and DMS thresholds in Devices and identities.",{"_3461":1713,"_30106":1663,"_20907":54413,"_5":14363,"_27392":54295,"_2946":54414},[],"Continue with DMS and EST for the device to request and renew certificates. Prepare server trust, the initial credential and policies for each operation before implementing the client.",{"_3461":1714,"_30106":1663,"_20907":54416,"_5":14363,"_27392":54295,"_2946":54417},[],"For a path from the client through mTLS, follow Enroll and connect your first device with a new ID.",{"_3461":1715,"_30106":1663,"_20907":54419,"_5":14363,"_27392":54295,"_2946":54420},[],"To use the identity in AWS IoT Core, also prepare trust and permissions in the destination. Check the connection from the device after installing the required key, certificate and chain.",{"_3461":1716,"_30106":1716,"_5":14715,"_2946":54422,"_30438":54423,"_20907":54424,"_27392":1716},"Lamassu IoT Platform",[49125,50593],[],{"_3461":1717,"_30106":1716,"_20907":54426,"_5":14363,"_27392":1716,"_2946":54427},[],"Build a PKI and apply its certificates to your devices' lifecycle.",{"_3461":1718,"_30106":1716,"_5":30435,"_20907":54429,"_27392":54430,"_2946":53910},[],"/docs/platform/overview#start-here",{"_3461":1719,"_30106":1716,"_5":30435,"_20907":54432,"_27392":54433,"_2946":54434},[],"/docs/platform/overview#choose-your-path","Choose your path",{"_3461":1720,"_30106":1716,"_5":30435,"_20907":54436,"_27392":54437,"_2946":54438},[],"/docs/platform/overview#architecture-at-a-glance","Architecture at a glance",{"_3461":1721,"_30106":1716,"_5":30435,"_20907":54440,"_27392":54441,"_2946":54442},[],"/docs/platform/overview#core-capabilities","Core capabilities",{"_3461":1722,"_30106":1716,"_5":30435,"_20907":54444,"_27392":54445,"_2946":54446},[],"/docs/platform/overview#build-your-trust-hierarchy","Build your trust hierarchy",{"_3461":1723,"_30106":1716,"_5":30435,"_20907":54448,"_27392":54449,"_2946":54450},[],"/docs/platform/overview#protect-cryptographic-keys","Protect cryptographic keys",{"_3461":1724,"_30106":1716,"_5":30435,"_20907":54452,"_27392":54453,"_2946":54454},[],"/docs/platform/overview#issue-and-control-certificates","Issue and control certificates",{"_3461":1725,"_30106":1716,"_5":30435,"_20907":54456,"_27392":54457,"_2946":54458},[],"/docs/platform/overview#automate-device-identities","Automate device identities",{"_3461":1726,"_30106":1716,"_5":30435,"_20907":54460,"_27392":54461,"_2946":54462},[],"/docs/platform/overview#publish-validation-status","Publish validation status",{"_3461":1727,"_30106":1716,"_5":30435,"_20907":54464,"_27392":54465,"_2946":54466},[],"/docs/platform/overview#react-to-events","React to events",{"_3461":1728,"_30106":1716,"_5":30435,"_20907":54468,"_27392":54469,"_2946":54470},[],"/docs/platform/overview#operational-reference","Operational reference",{"_3461":1729,"_30106":1716,"_20907":54472,"_5":14363,"_27392":1716,"_2946":54473},[],"Lamassu IoT lets you administer a private PKI and use it to issue, renew and revoke X.509 device identities. The Platform documentation follows two paths: **PKI**, for authorities and certificates, and **IoT Fleets**, for applying those identities to a device population.",{"_3461":1730,"_30106":1716,"_20907":54475,"_5":14363,"_27392":54430,"_2946":54476},[],"Choose the result you need:",{"_3461":1731,"_30106":1716,"_20907":54478,"_5":14363,"_27392":54430,"_2946":54479},[],"<Card title=\"Issue and verify a certificate\" description=\"Prepare a CA, issue an X.509 identity and check its chain and key.\" href=\"/docs/platform/pki/quickstarts/overview\" />",{"_3461":1732,"_30106":1716,"_20907":54481,"_5":14363,"_27392":54430,"_2946":54482},[],"<Card title=\"Enroll and connect a device\" description=\"Prepare the DMS, request an identity through EST and check an mTLS connection.\" href=\"/docs/platform/iot-fleets/quickstarts/enroll-device\" />",{"_3461":1733,"_30106":1716,"_20907":54484,"_5":14363,"_27392":54430,"_2946":54485},[],"If you are still preparing the instance, start in Deployment. The Platform paths assume an accessible console and permission to perform the operations.",{"_3461":1734,"_30106":1716,"_20907":54487,"_5":14363,"_27392":54433,"_2946":54488},[],"Section",{"_3461":1735,"_30106":1716,"_20907":54490,"_5":14363,"_27392":54433,"_2946":54491},[],"What you manage",{"_3461":1736,"_30106":1716,"_20907":54493,"_5":14363,"_27392":54433,"_2946":54494},[],"Entry point",{"_3461":1737,"_30106":1716,"_20907":54496,"_5":14363,"_27392":54433,"_2946":54497},[],"**PKI**",{"_3461":1738,"_30106":1716,"_20907":54499,"_5":14363,"_27392":54433,"_2946":54500},[],"Keys, authorities, profiles, certificates and publication of revocation status.",{"_3461":1739,"_30106":1716,"_20907":54502,"_5":14363,"_27392":54433,"_2946":54503},[],"PKI overview",{"_3461":1740,"_30106":1716,"_20907":54505,"_5":14363,"_27392":54433,"_2946":54506},[],"**IoT Fleets**",{"_3461":1741,"_30106":1716,"_20907":54508,"_5":14363,"_27392":54433,"_2946":54509},[],"Devices, identity history, DMS policies, EST enrollment and integrations.",{"_3461":1742,"_30106":1716,"_20907":54511,"_5":14363,"_27392":54433,"_2946":54512},[],"IoT Fleets overview",{"_3461":1743,"_30106":1716,"_20907":54514,"_5":14363,"_27392":54433,"_2946":54515},[],"**Administration**",{"_3461":1744,"_30106":1716,"_20907":54517,"_5":14363,"_27392":54433,"_2946":54518},[],"Operator permissions, audit and event subscriptions.",{"_3461":1745,"_30106":1716,"_20907":54520,"_5":14363,"_27392":54433,"_2946":50591},[],{"_3461":1746,"_30106":1716,"_20907":54522,"_5":14363,"_27392":54433,"_2946":54523},[],"A CA determines who signs, and a profile defines what can be issued. The DMS applies admission and enrollment policy. The device retains its association with certificates, and the external consumer decides which identity it accepts.",{"_3461":1747,"_30106":1716,"_20907":54525,"_5":14363,"_27392":54437,"_2946":54526},[],"An identity's journey connects four responsibilities:",{"_3461":1748,"_30106":1716,"_20907":54528,"_5":14363,"_27392":54437,"_2946":54529},[],"The PKI administrator prepares the authority, its key and issuance rules.",{"_3461":1749,"_30106":1716,"_20907":54531,"_5":14363,"_27392":54437,"_2946":54532},[],"The provisioning administrator configures the DMS and initial trust.",{"_3461":1750,"_30106":1716,"_20907":54534,"_5":14363,"_27392":54437,"_2946":54535},[],"The device client requests a certificate and installs it with the matching key.",{"_3461":1751,"_30106":1716,"_20907":54537,"_5":14363,"_27392":54437,"_2946":54538},[],"The consumer validates the identity and applies its access permissions.",{"_3461":1752,"_30106":1716,"_20907":54540,"_5":14363,"_27392":54437,"_2946":54541},[],"See How Lamassu works to understand the resources and platform architecture for the services. Installation, network exposure and dependencies are explained in Deployment.",{"_3461":1753,"_30106":1716,"_20907":54543,"_5":14363,"_27392":54445,"_2946":54544},[],"Create or incorporate authorities and organize their relationships in PKI. The hierarchy and its rotation determine which chains consumers must recognize.",{"_3461":1754,"_30106":1716,"_20907":54546,"_5":14363,"_27392":54449,"_2946":54547},[],"Choose the engine that keeps authority keys and control who can use them. See Keys and engines; provider setup belongs to deployment.",{"_3461":1755,"_30106":1716,"_20907":54549,"_5":14363,"_27392":54453,"_2946":54550},[],"Define issuance profiles, sign requests and review the certificate inventory. Check the issued certificate from the client that will use it.",{"_3461":1756,"_30106":1716,"_20907":54552,"_5":14363,"_27392":54457,"_2946":54553},[],"Configure a DMS and use EST to request and renew certificates. Preparing the initial credential and installing the result belong to device integration.",{"_3461":1757,"_30106":1716,"_20907":54555,"_5":14363,"_27392":54461,"_2946":54556},[],"Use OCSP and CRL to publish revocation status. Each consumer must configure how it retrieves and applies that information.",{"_3461":1758,"_30106":1716,"_20907":54558,"_5":14363,"_27392":54465,"_2946":54559},[],"Use audit logs to investigate changes and configure alerts and subscriptions to react to lifecycle events.",{"_3461":1759,"_30106":1716,"_20907":54561,"_5":14363,"_27392":54469,"_2946":54004},[],{"_3461":1760,"_30106":1716,"_20907":54563,"_5":14363,"_27392":54469,"_2946":54564},[],"What it prepares or checks",{"_3461":1761,"_30106":1716,"_20907":54566,"_5":14363,"_27392":54469,"_2946":54007},[],{"_3461":1762,"_30106":1716,"_20907":54568,"_5":14363,"_27392":54469,"_2946":54569},[],"Key custody, CA hierarchy, profiles and validation.",{"_3461":1763,"_30106":1716,"_20907":54571,"_5":14363,"_27392":54469,"_2946":54572},[],"Fleet administrator",{"_3461":1764,"_30106":1716,"_20907":54574,"_5":14363,"_27392":54469,"_2946":54575},[],"DMS, device admission, renewal policy and inventory.",{"_3461":1765,"_30106":1716,"_20907":54577,"_5":14363,"_27392":54469,"_2946":54019},[],{"_3461":1766,"_30106":1716,"_20907":54579,"_5":14363,"_27392":54469,"_2946":54580},[],"Initial credential, server trust, EST client, and key and certificate storage.",{"_3461":1767,"_30106":1716,"_20907":54582,"_5":14363,"_27392":54469,"_2946":54025},[],{"_3461":1768,"_30106":1716,"_20907":54584,"_5":14363,"_27392":54469,"_2946":54585},[],"Issuer trust, certificate validation and permissions in the destination.",{"_3461":1769,"_30106":1716,"_20907":54587,"_5":14363,"_27392":54469,"_2946":54588},[],"Infrastructure operator",{"_3461":1770,"_30106":1716,"_20907":54590,"_5":14363,"_27392":54469,"_2946":54591},[],"Installation, network, availability, dependencies and deployment diagnosis.",{"_3461":1771,"_30106":1716,"_20907":54593,"_5":14363,"_27392":54469,"_2946":54594},[],"The API reference contains contracts for automating operations. To investigate a failure, start in the affected section: PKI, EST or Deployment.",{"_3461":1772,"_30106":1772,"_5":14715,"_2946":54596,"_30438":54597,"_20907":54600,"_27392":1772},"CA hierarchy and rotation",[49125,50593,54598,54599],"PKI","Keys, authorities and certificates",[],{"_3461":1773,"_30106":1772,"_20907":54602,"_5":14363,"_27392":1772,"_2946":54603},[],"Design root and intermediate authorities and replace certificates or keys without breaking trust.",{"_3461":1774,"_30106":1772,"_5":30435,"_20907":54605,"_27392":54606,"_2946":54607},[],"/docs/platform/pki/ca-hierarchy-and-rotation#design-the-hierarchy","Design the hierarchy",{"_3461":1775,"_30106":1772,"_5":30435,"_20907":54609,"_27392":54610,"_2946":54611},[],"/docs/platform/pki/ca-hierarchy-and-rotation#reissuance-and-rotation-are-not-the-same","Reissuance and rotation are not the same",{"_3461":1776,"_30106":1772,"_5":30435,"_20907":54613,"_27392":54614,"_2946":54615},[],"/docs/platform/pki/ca-hierarchy-and-rotation#when-to-choose-each-operation","When to choose each operation",{"_3461":1777,"_30106":1772,"_5":30435,"_20907":54617,"_27392":54618,"_2946":54619},[],"/docs/platform/pki/ca-hierarchy-and-rotation#key-rotation-procedure","Key rotation procedure",{"_3461":1778,"_30106":1772,"_5":30435,"_20907":54621,"_27392":54622,"_2946":54623},[],"/docs/platform/pki/ca-hierarchy-and-rotation#inventory-the-dependencies","Inventory the dependencies",{"_3461":1779,"_30106":1772,"_5":30435,"_20907":54625,"_27392":54626,"_2946":54627},[],"/docs/platform/pki/ca-hierarchy-and-rotation#create-the-successor-ca","Create the successor CA",{"_3461":1780,"_30106":1772,"_5":30435,"_20907":54629,"_27392":54630,"_2946":54631},[],"/docs/platform/pki/ca-hierarchy-and-rotation#distribute-the-new-trust","Distribute the new trust",{"_3461":1781,"_30106":1772,"_5":30435,"_20907":54633,"_27392":54634,"_2946":54635},[],"/docs/platform/pki/ca-hierarchy-and-rotation#switch-issuance","Switch issuance",{"_3461":1782,"_30106":1772,"_5":30435,"_20907":54637,"_27392":54638,"_2946":54639},[],"/docs/platform/pki/ca-hierarchy-and-rotation#renew-in-batches","Renew in batches",{"_3461":1783,"_30106":1772,"_5":30435,"_20907":54641,"_27392":54642,"_2946":54643},[],"/docs/platform/pki/ca-hierarchy-and-rotation#close-the-overlap","Close the overlap",{"_3461":1784,"_30106":1772,"_5":30435,"_20907":54645,"_27392":54646,"_2946":54647},[],"/docs/platform/pki/ca-hierarchy-and-rotation#cascading-revocation","Cascading revocation",{"_3461":1785,"_30106":1772,"_5":30435,"_20907":54649,"_27392":54650,"_2946":54651},[],"/docs/platform/pki/ca-hierarchy-and-rotation#checks-after-the-change","Checks after the change",{"_3461":1786,"_30106":1772,"_20907":54653,"_5":14363,"_27392":1772,"_2946":54654},[],"The hierarchy determines the blast radius of any error or compromise. A root signs intermediate CAs; intermediates issue the identities used by devices and services. This separation lets you isolate environments and rotate a branch without replacing all trust.",{"_3461":1787,"_30106":1772,"_20907":54656,"_5":14363,"_27392":1772,"_2946":54657},[],"This procedure is for the PKI operator replacing an authority in use. You need access to CAs, keys and profiles, a dependency inventory and coordination with trust-store and device owners. Before switching issuance, prepare a test cohort and decide the criterion for ending overlap.",{"_3461":1788,"_30106":1772,"_20907":54659,"_5":14363,"_27392":54606,"_2946":54660},[],"For a production installation, use a very restricted root and one or more operational intermediates. Separate intermediates when any of these boundaries change:",{"_3461":1789,"_30106":1772,"_20907":54662,"_5":14363,"_27392":54606,"_2946":54663},[],"environment, such as production and preproduction;",{"_3461":1790,"_30106":1772,"_20907":54665,"_5":14363,"_27392":54606,"_2946":54666},[],"owner or operating team;",{"_3461":1791,"_30106":1772,"_20907":54668,"_5":14363,"_27392":54606,"_2946":54669},[],"device family or manufacturing process;",{"_3461":1792,"_30106":1772,"_20907":54671,"_5":14363,"_27392":54606,"_2946":54672},[],"region or regulatory requirement;",{"_3461":1793,"_30106":1772,"_20907":54674,"_5":14363,"_27392":54606,"_2946":54675},[],"cryptographic engine or key policy;",{"_3461":1794,"_30106":1772,"_20907":54677,"_5":14363,"_27392":54606,"_2946":54678},[],"maintenance window and renewal cadence.",{"_3461":1795,"_30106":1772,"_20907":54680,"_5":14363,"_27392":54606,"_2946":54681},[],"Avoid deep hierarchies without a concrete need. Each level adds chain distribution, validation and one more certificate you must renew.",{"_3461":1796,"_30106":1772,"_20907":54683,"_5":14363,"_27392":54606,"_2946":54684},[],"A child CA and its end-entity certificates must expire before their issuer. Reserve a margin that allows distributing another chain and renewing dependent certificates.",{"_3461":1797,"_30106":1772,"_20907":54686,"_5":14363,"_27392":54610,"_2946":54687},[],"**Reissuing a CA** creates a new certificate over the existing key. Lamassu generates a CSR with that key, self-signs it if it is a root or asks the parent CA to sign it if it is subordinate. The new certificate becomes active and the CA points to its serial number; the old and new certificates are linked through metadata.",{"_3461":1798,"_30106":1772,"_20907":54689,"_5":14363,"_27392":54610,"_2946":54690},[],"If the CRL settings of the CA are signed by the superseded CA certificate, reissuing moves the signer to the new certificate — provided it carries `cRLSign` — and republishes the CRL. Otherwise, and for settings signed by a different certificate, the signer is kept, so check the new certificate’s key usage after reissuing; see the CRL guide.",{"_3461":1799,"_30106":1772,"_20907":54692,"_5":14363,"_27392":54610,"_2946":54693},[],"**Rotating a CA** creates a successor key and authority. It is the right choice in the face of compromise, a cryptographic change, an engine migration or non-exportable key policies.",{"_3461":1800,"_30106":1772,"_20907":54695,"_5":14363,"_27392":54610,"_2946":54696},[],"Lamassu does not allow reissuing an already-revoked CA or a CA whose expiration date has passed. Plan ahead for both conditions.",{"_3461":1801,"_30106":1772,"_20907":54698,"_5":14363,"_27392":54614,"_2946":54699},[],"Reissue if the key is still trustworthy and you only need another validity period or an updated certificate.",{"_3461":1802,"_30106":1772,"_20907":54701,"_5":14363,"_27392":54614,"_2946":54702},[],"Rotate the key if compromise is suspected, the algorithm changes or you want to move custody to another engine.",{"_3461":1803,"_30106":1772,"_20907":54704,"_5":14363,"_27392":54614,"_2946":54705},[],"Create a parallel branch if you cannot update all consumers at the same time.",{"_3461":1804,"_30106":1772,"_20907":54707,"_5":14363,"_27392":54614,"_2946":54708},[],"Revoke immediately only when the risk of keeping the CA outweighs the impact of interrupting the fleet.",{"_3461":1805,"_30106":1772,"_20907":54710,"_5":14363,"_27392":54622,"_2946":54711},[],"Locate child CAs, issued certificates, DMSs, connectors and external trust stores. Include devices that may stay offline for weeks or months.",{"_3461":1806,"_30106":1772,"_20907":54713,"_5":14363,"_27392":54626,"_2946":54714},[],"Generate a new key in the planned engine, create the CA and assign it an explicit profile. Do not reuse the operational identifier to hide that it is a different generation.",{"_3461":1807,"_30106":1772,"_20907":54716,"_5":14363,"_27392":54630,"_2946":54717},[],"Add the new root or chain to consumers before issuing with it. If distributing through EST `/cacerts`, explicitly include the required managed CAs and inspect the content; including the issuer does not automatically include every intermediate. Install the new trust in a cohort and verify that it still accepts the previous identity.",{"_3461":1808,"_30106":1772,"_20907":54719,"_5":14363,"_27392":54634,"_2946":54720},[],"Update the enrollment CA and profile of the DMSs. While old-CA cohorts still renew, add the previous enrollment CA to each DMS's re-enrollment validation CAs (`reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`): the new enrollment CA is trusted automatically, but the old one was the enrollment CA and appears in no re-enrollment trust list, so without that entry its certificates can no longer renew. The DMS guide documents the setting.",{"_3461":1809,"_30106":1772,"_20907":54722,"_5":14363,"_27392":54638,"_2946":54723},[],"Migrate a small cohort, validate mTLS, OCSP and CRL from the consumer and expand progressively. Monitor which devices still present the old chain.",{"_3461":1810,"_30106":1772,"_20907":54725,"_5":14363,"_27392":54642,"_2946":54726},[],"Once no legitimate consumer depends on the previous authority, remove it from issuance, from the re-enrollment validation CAs and from the distributed CAs. Revoke it if policy requires it.",{"_3461":1811,"_30106":1772,"_20907":54728,"_5":14363,"_27392":54646,"_2946":54729},[],"Lamassu saves the CA’s revocation, then attempts to revoke child CAs and issued certificates with `CessationOfOperation`. Propagation continues recursively through child CAs. This is not a transaction over the whole hierarchy: some resources may have changed while other updates failed.",{"_3461":1812,"_30106":1772,"_20907":54731,"_5":14363,"_27392":54646,"_2946":54732},[],"Resources in `EXPIRED` state and resources already revoked for a final reason reject further status transitions. Per-descendant failures are logged; review the inventory and logs even when the parent operation completes.",{"_3461":1813,"_30106":1772,"_20907":54734,"_5":14363,"_27392":54646,"_2946":54735},[],"`CertificateHold` allows reactivating the parent while it is not expired, but does not restore child CAs or certificates permanently revoked during the cascade. Holding a CA therefore does not provide a reversible pause for its entire branch.",{"_3461":1814,"_30106":1772,"_20907":54737,"_5":14363,"_27392":54646,"_2946":54738},[],"Before closing the change, compare the original dependency inventory with final states and verify revocation publication for each issuer. Do not use revocation as the ordinary mechanism to stop issuance: complete migration and remove the CA from operational flows.",{"_3461":1815,"_30106":1772,"_20907":54740,"_5":14363,"_27392":54650,"_2946":54741},[],"The new chain ends in an anchor installed by the consumer.",{"_3461":1816,"_30106":1772,"_20907":54743,"_5":14363,"_27392":54650,"_2946":54744},[],"New certificates contain the expected AKI, SKI, KU, EKU and SAN.",{"_3461":1817,"_30106":1772,"_20907":54746,"_5":14363,"_27392":54650,"_2946":54747},[],"The DMS delivers the correct chain through EST `/cacerts`.",{"_3461":1818,"_30106":1772,"_20907":54749,"_5":14363,"_27392":54650,"_2946":54750},[],"Re-enrollment accepts the old identity during the planned period.",{"_3461":1819,"_30106":1772,"_20907":54752,"_5":14363,"_27392":54650,"_2946":54753},[],"OCSP and CRL respond for the authorities that remain active.",{"_3461":1820,"_30106":1772,"_20907":54755,"_5":14363,"_27392":54650,"_2946":54756},[],"No DMS is left accidentally issuing from the old CA.",{"_3461":1821,"_30106":1772,"_20907":54758,"_5":14363,"_27392":54650,"_2946":54759},[],"See the Trust model to understand the DMS's CA sets and Certificate lifecycle for states and revocation effects.",{"_3461":1822,"_30106":1822,"_5":14715,"_2946":54761,"_30438":54762,"_20907":54763,"_27392":1822},"Certification authorities",[49125,50593,54598,54599],[],{"_3461":1823,"_30106":1822,"_20907":54765,"_5":14363,"_27392":1822,"_2946":54766},[],"Create, import and operate the authorities that establish your PKI's trust.",{"_3461":1824,"_30106":1822,"_5":30435,"_20907":54768,"_27392":54769,"_2946":54770},[],"/docs/platform/pki/certificate-authorities#choose-a-flow","Choose a flow",{"_3461":1825,"_30106":1822,"_5":30435,"_20907":54772,"_27392":54773,"_2946":54774},[],"/docs/platform/pki/certificate-authorities#create-a-new-authority","Create a new authority",{"_3461":1826,"_30106":1822,"_5":30435,"_20907":54776,"_27392":54777,"_2946":49135},[],"/docs/platform/pki/certificate-authorities#before-you-begin",{"_3461":1827,"_30106":1822,"_5":30435,"_20907":54779,"_27392":54780,"_2946":54781},[],"/docs/platform/pki/certificate-authorities#open-the-wizard","Open the wizard",{"_3461":1828,"_30106":1822,"_5":30435,"_20907":54783,"_27392":54784,"_2946":54785},[],"/docs/platform/pki/certificate-authorities#configure-the-key","Configure the key",{"_3461":1829,"_30106":1822,"_5":30435,"_20907":54787,"_27392":54788,"_2946":54789},[],"/docs/platform/pki/certificate-authorities#choose-the-ca-type","Choose the CA type",{"_3461":1830,"_30106":1822,"_5":30435,"_20907":54791,"_27392":54792,"_2946":54793},[],"/docs/platform/pki/certificate-authorities#define-the-identity","Define the identity",{"_3461":1831,"_30106":1822,"_5":30435,"_20907":54795,"_27392":54796,"_2946":54797},[],"/docs/platform/pki/certificate-authorities#configure-validity-and-uses","Configure validity and uses",{"_3461":1832,"_30106":1822,"_5":30435,"_20907":54799,"_27392":54800,"_2946":54801},[],"/docs/platform/pki/certificate-authorities#create-and-verify","Create and verify",{"_3461":1833,"_30106":1822,"_5":30435,"_20907":54803,"_27392":54804,"_2946":54805},[],"/docs/platform/pki/certificate-authorities#use-a-key-from-the-kms","Use a key from the KMS",{"_3461":1834,"_30106":1822,"_5":30435,"_20907":54807,"_27392":54808,"_2946":54809},[],"/docs/platform/pki/certificate-authorities#import-an-external-ca","Import an external CA",{"_3461":1835,"_30106":1822,"_5":30435,"_20907":54811,"_27392":54812,"_2946":54813},[],"/docs/platform/pki/certificate-authorities#select-the-engine","Select the engine",{"_3461":1836,"_30106":1822,"_5":30435,"_20907":54815,"_27392":54816,"_2946":54817},[],"/docs/platform/pki/certificate-authorities#load-the-material","Load the material",{"_3461":1837,"_30106":1822,"_5":30435,"_20907":54819,"_27392":54820,"_2946":54821},[],"/docs/platform/pki/certificate-authorities#define-the-default-issuance","Define the default issuance",{"_3461":1838,"_30106":1822,"_5":30435,"_20907":54823,"_27392":54824,"_2946":54825},[],"/docs/platform/pki/certificate-authorities#verify-the-import","Verify the import",{"_3461":1839,"_30106":1822,"_5":30435,"_20907":54827,"_27392":54828,"_2946":54829},[],"/docs/platform/pki/certificate-authorities#inspect-an-authority","Inspect an authority",{"_3461":1840,"_30106":1822,"_5":30435,"_20907":54831,"_27392":54832,"_2946":54833},[],"/docs/platform/pki/certificate-authorities#issue-certificates","Issue certificates",{"_3461":1841,"_30106":1822,"_5":30435,"_20907":54835,"_27392":54836,"_2946":54837},[],"/docs/platform/pki/certificate-authorities#revoke-a-ca","Revoke a CA",{"_3461":1842,"_30106":1822,"_5":30435,"_20907":54839,"_27392":54840,"_2946":54841},[],"/docs/platform/pki/certificate-authorities#assess-the-impact","Assess the impact",{"_3461":1843,"_30106":1822,"_5":30435,"_20907":54843,"_27392":54844,"_2946":54845},[],"/docs/platform/pki/certificate-authorities#start-the-revocation","Start the revocation",{"_3461":1844,"_30106":1822,"_5":30435,"_20907":54847,"_27392":54848,"_2946":54849},[],"/docs/platform/pki/certificate-authorities#confirm-the-identity","Confirm the identity",{"_3461":1845,"_30106":1822,"_5":30435,"_20907":54851,"_27392":54852,"_2946":54853},[],"/docs/platform/pki/certificate-authorities#check-the-publication","Check the publication",{"_3461":1846,"_30106":1822,"_5":30435,"_20907":54855,"_27392":54856,"_2946":54857},[],"/docs/platform/pki/certificate-authorities#delete-a-ca","Delete a CA",{"_3461":1847,"_30106":1822,"_20907":54859,"_5":14363,"_27392":1822,"_2946":54860},[],"A certification authority (CA) binds identities to public keys through signed certificates. In Lamassu you can create a new hierarchy, use a key already in the KMS or incorporate an external CA.",{"_3461":1848,"_30106":1822,"_20907":54862,"_5":14363,"_27392":1822,"_2946":54863},[],"To design a full chain or replace an authority in production, see CA hierarchy and rotation. If you need to standardize what each authority can sign, use Certificate profiles.",{"_3461":1849,"_30106":1822,"_20907":54865,"_5":14363,"_27392":1822,"_2946":54866},[],"To administer CAs, you need authority and key permissions, a reachable engine and a reviewed profile. An external consumer does not trust a CA merely because it appears in this inventory: agree root and chain distribution separately.",{"_3461":1850,"_30106":1822,"_20907":54868,"_5":14363,"_27392":54769,"_2946":54869},[],"**New CA with a new key:** create a root of trust from scratch. Lamassu generates and keeps the key pair.",{"_3461":1851,"_30106":1822,"_20907":54871,"_5":14363,"_27392":54769,"_2946":54872},[],"**New CA from the KMS:** reuse a key already registered in the platform.",{"_3461":1852,"_30106":1822,"_20907":54874,"_5":14363,"_27392":54769,"_2946":54875},[],"**Import a CA with its private key:** incorporate an external authority that Lamassu can issue with.",{"_3461":1853,"_30106":1822,"_20907":54877,"_5":14363,"_27392":54769,"_2946":54878},[],"**Import only the certificate:** register public material. If Lamassu finds its key in the KMS, it can associate it; otherwise, the CA has no usable key for issuance.",{"_3461":1854,"_30106":1822,"_20907":54880,"_5":14363,"_27392":54769,"_2946":54881},[],"First time here? Follow Create your first CA to complete the minimal journey.",{"_3461":1855,"_30106":1822,"_20907":54883,"_5":14363,"_27392":54777,"_2946":54884},[],"Decide whether the CA will be a root or an intermediate.",{"_3461":1856,"_30106":1822,"_20907":54886,"_5":14363,"_27392":54777,"_2946":54887},[],"Choose the engine that will keep the key.",{"_3461":1857,"_30106":1822,"_20907":54889,"_5":14363,"_27392":54777,"_2946":54890},[],"Define a validity longer than that of the certificates it will issue.",{"_3461":1858,"_30106":1822,"_20907":54892,"_5":14363,"_27392":54777,"_2946":54893},[],"For an intermediate CA, make sure the parent CA is active.",{"_3461":1859,"_30106":1822,"_20907":54895,"_5":14363,"_27392":54780,"_2946":54896},[],"In **Certification Authorities**, select **Create New CA** and choose to generate a new key pair.",{"_3461":1860,"_30106":1822,"_20907":54898,"_5":14363,"_27392":54784,"_2946":54899},[],"Select the cryptographic engine, the algorithm and the size or curve. Lamassu supports RSA and EC keys according to the engine's capabilities.",{"_3461":1861,"_30106":1822,"_20907":54901,"_5":14363,"_27392":54784,"_2946":54902},[],"Use only sizes and curves supported by the engine and the profile’s cryptographic policy. Read Keys and engines before reusing external material.",{"_3461":1862,"_30106":1822,"_20907":54904,"_5":14363,"_27392":54788,"_2946":54905},[],"Select **Root CA** for a self-signed authority or **Intermediate CA** for an authority signed by another CA. In the latter case, choose the issuing CA.",{"_3461":1863,"_30106":1822,"_20907":54907,"_5":14363,"_27392":54792,"_2946":54908},[],"Enter a unique **CA Name**. This name becomes the certificate's `Common Name`. Complete the Distinguished Name fields your policy requires:",{"_3461":1864,"_30106":1822,"_20907":54910,"_5":14363,"_27392":54792,"_2946":54911},[],"`C`: two-letter ISO 3166-1 country code.",{"_3461":1865,"_30106":1822,"_20907":54913,"_5":14363,"_27392":54792,"_2946":54914},[],"`ST`: state or province.",{"_3461":1866,"_30106":1822,"_20907":54916,"_5":14363,"_27392":54792,"_2946":54917},[],"`L`: locality.",{"_3461":1867,"_30106":1822,"_20907":54919,"_5":14363,"_27392":54792,"_2946":54920},[],"`O`: organization.",{"_3461":1868,"_30106":1822,"_20907":54922,"_5":14363,"_27392":54792,"_2946":54923},[],"`OU`: organizational unit.",{"_3461":1869,"_30106":1822,"_20907":54925,"_5":14363,"_27392":54792,"_2946":54926},[],"The CA's internal identifier is generated automatically and cannot be changed.",{"_3461":1870,"_30106":1822,"_20907":54928,"_5":14363,"_27392":54796,"_2946":54929},[],"Define **CA Certificate Expiration** and **Default End-Entity Certificate Issuance Expiration**. You can express a duration (`5y 8w 4d`), pick a date or use the maximum allowed date.",{"_3461":1871,"_30106":1822,"_20907":54931,"_5":14363,"_27392":54796,"_2946":54932},[],"Review the CA’s own certificate separately from the default profile for certificates it will issue later. Choose an explicit issuance policy; do not assume the form’s initial values suit your consumers.",{"_3461":1872,"_30106":1822,"_20907":54934,"_5":14363,"_27392":54800,"_2946":54935},[],"Confirm the form and open the CA. Check status, issuer, dates, associated engine and key. Download the certificate: it should contain `CA:TRUE` and a usage permitting certificate signing. Verify the self-signature for a root or the chain to your root for an intermediate. Complete a test issuance to check that the key can actually sign.",{"_3461":1873,"_30106":1822,"_20907":54937,"_5":14363,"_27392":54800,"_2946":54938},[],"Plan and verify expiration using the Profiles rules. Issuance does not automatically clamp validity to the issuer’s expiration; leave time to replace the authority and renew identities.",{"_3461":1874,"_30106":1822,"_20907":54940,"_5":14363,"_27392":54804,"_2946":54941},[],"Select &#x2A;*Create New CA (Existing Key)** when the key is already registered in Lamassu. The wizard first asks for the backing key and then shows the same configuration of type, identity, validity and profile.",{"_3461":1875,"_30106":1822,"_20907":54943,"_5":14363,"_27392":54804,"_2946":54944},[],"This flow is useful when the key was previously created in an HSM, imported through BYOK or must be reused under a specific custody policy.",{"_3461":1876,"_30106":1822,"_20907":54946,"_5":14363,"_27392":54808,"_2946":54947},[],"You need the CA certificate in PEM, its chain to a known root and, when importing it, an exportable private key. Before uploading material, verify signature, dates, `CA:TRUE`, signing usages (including `cRLSign`, without which the CA cannot publish its CRL) and public-key correspondence. The key verification procedure also compares a CA key and certificate.",{"_3461":1877,"_30106":1822,"_20907":54949,"_5":14363,"_27392":54808,"_2946":54950},[],"The backend rejects an import whose certificate lacks the CA basic constraint (`basicConstraints cA flag is not set`), whose serial number matches a stored certificate with different contents, or whose identical certificate already belongs to an existing CA. A deleted CA's certificate record is kept and can be reused when re-importing the same certificate, including its previous status. Re-importing a different certificate with that serial number is rejected; check the certificate and status after re-importing.",{"_3461":1878,"_30106":1822,"_20907":54952,"_5":14363,"_27392":54808,"_2946":54953},[],"Deleting a CA releases the key references of its own current certificate and linked reissued certificates, while keeping those records for its issuer's CRL and OCSP. It then attempts to delete the key; the KMS keeps it if other certificates still reference it, such as another CA sharing the key. Revoking certificates issued by the deleted CA does not release their own key references.",{"_3461":1879,"_30106":1822,"_20907":54955,"_5":14363,"_27392":54812,"_2946":54956},[],"Check the installation’s default engine before importing a CA with a key. CA import delegates key import to that engine; it does not guarantee arbitrary provider selection from the form. To select an engine while importing the key separately, use the KMS.",{"_3461":1880,"_30106":1822,"_20907":54958,"_5":14363,"_27392":54816,"_2946":54959},[],"Import the certificate and, when applicable, its PEM key. Register the CAs needed to identify the issuer. Registering a CA does not install it in external trust stores.",{"_3461":1881,"_30106":1822,"_20907":54961,"_5":14363,"_27392":54816,"_2946":54962},[],"The backend validates before importing any key: a duplicate CA ID and a certificate that is not a CA (missing `basicConstraints` `cA=TRUE`) are rejected, the latter with `400` `certificate is not a CA: basicConstraints cA flag is not set`. If a failure occurs after the key was imported, the key is kept in the KMS and a warning tells you to delete it manually.",{"_3461":1882,"_30106":1822,"_20907":54964,"_5":14363,"_27392":54820,"_2946":54965},[],"Associate an explicit issuance profile if the CA will sign. Check usages and dates using Profiles.",{"_3461":1883,"_30106":1822,"_20907":54967,"_5":14363,"_27392":54824,"_2946":54968},[],"Review the registered type, associated key and engine, and issuer relationship. Certificate-only import may associate an existing KMS key using the certificate’s key identifier. Without a usable key, the CA is public material and cannot sign.",{"_3461":1884,"_30106":1822,"_20907":54970,"_5":14363,"_27392":54824,"_2946":54971},[],"For an issuing CA, complete a test issuance and check OCSP and CRL. Creating the record alone does not establish key availability, complete chain consistency or status publication.",{"_3461":1885,"_30106":1822,"_20907":54973,"_5":14363,"_27392":54828,"_2946":54974},[],"Open a CA from the inventory to review:",{"_3461":1886,"_30106":1822,"_20907":54976,"_5":14363,"_27392":54828,"_2946":54977},[],"Status and validity period.",{"_3461":1887,"_30106":1822,"_20907":54979,"_5":14363,"_27392":54828,"_2946":54980},[],"Certificate and chain in PEM format.",{"_3461":1888,"_30106":1822,"_20907":54982,"_5":14363,"_27392":54828,"_2946":54983},[],"Number of active, expired and revoked certificates.",{"_3461":1889,"_30106":1822,"_20907":54985,"_5":14363,"_27392":54828,"_2946":54986},[],"Certificates issued in **Issued Certificates**.",{"_3461":1890,"_30106":1822,"_20907":54988,"_5":14363,"_27392":54828,"_2946":54989},[],"The CRL linked to the authority.",{"_3461":1891,"_30106":1822,"_20907":54991,"_5":14363,"_27392":54828,"_2946":54992},[],"Metadata and the associated cryptographic engine.",{"_3461":1892,"_30106":1822,"_20907":54994,"_5":14363,"_27392":54828,"_2946":54995},[],"You can filter the inventory by name, status and CA type.",{"_3461":1893,"_30106":1822,"_20907":54997,"_5":14363,"_27392":54832,"_2946":54998},[],"You can start an issuance from **Issued Certificates**, from a CA's action menu or from the global certificate inventory.",{"_3461":1894,"_30106":1822,"_20907":55000,"_5":14363,"_27392":54832,"_2946":55001},[],"**Generate Key & CSR in Browser** is useful for a manual operation or a quick test. The browser generates the key and you must download it at the end.",{"_3461":1895,"_30106":1822,"_20907":55003,"_5":14363,"_27392":54832,"_2946":55004},[],"**Upload Existing CSR** is the right option when the key must remain on the target system. Lamassu receives the request but never the private key.",{"_3461":1896,"_30106":1822,"_20907":55006,"_5":14363,"_27392":54832,"_2946":55007},[],"Follow Issue your first certificate for the guided flow. Certificate management explains the inventory, inspection and revocation.",{"_3461":1897,"_30106":1822,"_20907":55009,"_5":14363,"_27392":54836,"_2946":55010},[],"Revoking a CA prevents issuance and may interrupt its entire branch. Only `CertificateHold` allows reactivating the CA itself if it is not expired. Descendant revocation is attempted with `CessationOfOperation`; reactivating the parent does not restore those descendants. Follow the cascading revocation conditions.",{"_3461":1898,"_30106":1822,"_20907":55012,"_5":14363,"_27392":54840,"_2946":55013},[],"Identify the certificates, devices and consumers that depend on the CA. Prepare a replacement authority and chain when necessary.",{"_3461":1899,"_30106":1822,"_20907":55015,"_5":14363,"_27392":54844,"_2946":55016},[],"Open the authority and select **Revoke CA**. Choose the reason that describes the incident, for example `KeyCompromise`, `CACompromise`, `Superseded` or `CessationOfOperation`.",{"_3461":1900,"_30106":1822,"_20907":55018,"_5":14363,"_27392":54848,"_2946":55019},[],"Type the CA's name exactly to enable **Confirm Revocation**.",{"_3461":1901,"_30106":1822,"_20907":55021,"_5":14363,"_27392":54852,"_2946":55022},[],"Check **REVOKED** on the CA and review descendants individually; propagation permits partial failures. Independently verify OCSP and CRL publication and consumer rejection. A revoked record does not guarantee that an existing session closes.",{"_3461":1902,"_30106":1822,"_20907":55024,"_5":14363,"_27392":54856,"_2946":55025},[],"Permanent deletion is only available with the CA revoked or expired; a CA imported without a key can be deleted in any state. Delete the record only when your retention and audit policy allows it.",{"_3461":1903,"_30106":1822,"_20907":55027,"_5":14363,"_27392":54856,"_2946":55028},[],"The CA’s CRL settings are kept, and they cannot be removed through the API. The last CRL keeps being served but is never regenerated once the CA is gone, so adjust its validity and signer beforehand (see CRL). The CA’s key is released, but the KMS keeps it while other certificates still reference it.",{"_3461":1904,"_30106":1822,"_20907":55030,"_5":14363,"_27392":54856,"_2946":55031},[],"Lamassu keeps the certificate record of a deleted CA. If that same certificate is imported again, the import succeeds and reuses the record: it updates the type, issuer and key but keeps the status, so the CA reappears in the state it had when deleted (normally revoked or expired). A different certificate with the same serial number is rejected with a 400 error, and a certificate that already belongs to an existing CA with a 409 error. To avoid inheriting the previous status, use a certificate with a different serial number and check the result after importing. The reimported CA is registered under a new, backend-generated CA ID and does not inherit the CRL settings of the deleted CA: those keep serving their last CRL at the CA ID URL, and at `/crl/<ski>` — the URL that certificates issued before the 4.0.0 upgrade carry — when the settings were migrated by that upgrade; when they are archived, they can no longer be edited (see CRL).",{"_3461":1905,"_30106":1905,"_5":14715,"_2946":55033,"_30438":55034,"_20907":55035,"_27392":1905},"Certificate profiles",[49125,50593,54598,54599],[],{"_3461":1906,"_30106":1905,"_20907":55037,"_5":14363,"_27392":1905,"_2946":55038},[],"Define reusable policies to issue consistent certificates and constrain accepted keys.",{"_3461":1907,"_30106":1905,"_5":30435,"_20907":55040,"_27392":55041,"_2946":55042},[],"/docs/platform/pki/certificate-profiles#what-a-profile-controls","What a profile controls",{"_3461":1908,"_30106":1905,"_5":30435,"_20907":55044,"_27392":55045,"_2946":55046},[],"/docs/platform/pki/certificate-profiles#validity","Validity",{"_3461":1909,"_30106":1905,"_5":30435,"_20907":55048,"_27392":55049,"_2946":55050},[],"/docs/platform/pki/certificate-profiles#ca-certificate-or-end-entity-certificate","CA certificate or end-entity certificate",{"_3461":1910,"_30106":1905,"_5":30435,"_20907":55052,"_27392":55053,"_2946":55054},[],"/docs/platform/pki/certificate-profiles#key-usage-and-extended-key-usage","Key Usage and Extended Key Usage",{"_3461":1911,"_30106":1905,"_5":30435,"_20907":55056,"_27392":55057,"_2946":55058},[],"/docs/platform/pki/certificate-profiles#subject","Subject",{"_3461":1912,"_30106":1905,"_5":30435,"_20907":55060,"_27392":55061,"_2946":55062},[],"/docs/platform/pki/certificate-profiles#csr-extensions","CSR extensions",{"_3461":1913,"_30106":1905,"_5":30435,"_20907":55064,"_27392":55065,"_2946":55066},[],"/docs/platform/pki/certificate-profiles#cryptographic-constraints","Cryptographic constraints",{"_3461":1914,"_30106":1905,"_5":30435,"_20907":55068,"_27392":55069,"_2946":55070},[],"/docs/platform/pki/certificate-profiles#profile-precedence","Profile precedence",{"_3461":1915,"_30106":1905,"_5":30435,"_20907":55072,"_27392":55073,"_2946":55074},[],"/docs/platform/pki/certificate-profiles#create-a-profile","Create a profile",{"_3461":1916,"_30106":1905,"_5":30435,"_20907":55076,"_27392":55077,"_2946":55078},[],"/docs/platform/pki/certificate-profiles#define-a-single-purpose","Define a single purpose",{"_3461":1917,"_30106":1905,"_5":30435,"_20907":55080,"_27392":55081,"_2946":55082},[],"/docs/platform/pki/certificate-profiles#choose-the-validity","Choose the validity",{"_3461":1918,"_30106":1905,"_5":30435,"_20907":55084,"_27392":55085,"_2946":55086},[],"/docs/platform/pki/certificate-profiles#fix-usages-and-subject","Fix usages and subject",{"_3461":1919,"_30106":1905,"_5":30435,"_20907":55088,"_27392":55089,"_2946":55090},[],"/docs/platform/pki/certificate-profiles#constrain-the-keys","Constrain the keys",{"_3461":1920,"_30106":1905,"_5":30435,"_20907":55092,"_27392":55093,"_2946":55094},[],"/docs/platform/pki/certificate-profiles#attach-it-and-test","Attach it and test",{"_3461":1921,"_30106":1905,"_5":30435,"_20907":55096,"_27392":55097,"_2946":55098},[],"/docs/platform/pki/certificate-profiles#design-examples","Design examples",{"_3461":1922,"_30106":1905,"_5":30435,"_20907":55100,"_27392":55101,"_2946":55102},[],"/docs/platform/pki/certificate-profiles#changes-and-deletion","Changes and deletion",{"_3461":1923,"_30106":1905,"_20907":55104,"_5":14363,"_27392":1905,"_2946":55105},[],"An issuance profile turns a certificate policy into reusable configuration. Instead of deciding validity, subject, extensions and algorithms on every request, you define once what is allowed and attach the profile to a CA, a DMS or a specific issuance.",{"_3461":1924,"_30106":1905,"_20907":55107,"_5":14363,"_27392":1905,"_2946":55108},[],"This guide is for the PKI administrator defining issuance policy. You need permissions to manage profiles and associate them with the intended CA or DMS, plus a test consumer with known identity and purpose requirements.",{"_3461":1925,"_30106":1905,"_20907":55110,"_5":14363,"_27392":55045,"_2946":55111},[],"You can express the lifetime as a duration from the moment of issuance or as a fixed end date. A duration works well for recurring identities; a common date is useful to make a whole batch end before a migration or retirement.",{"_3461":1926,"_30106":1905,"_20907":55113,"_5":14363,"_27392":55045,"_2946":55114},[],"Plan the end date within the issuing CA’s validity and leave a renewal margin. The signer calculates the date from the profile; it does not automatically clamp validity to the issuer’s expiration. Check both dates in the resulting certificate. A fixed date in the past does not produce a usable identity either.",{"_3461":1927,"_30106":1905,"_20907":55116,"_5":14363,"_27392":55049,"_2946":55117},[],"`Sign as CA` sets `IsCA` and the basic constraints needed for an authority. Enable it only in profiles intended to create or reissue subordinate CAs.",{"_3461":1928,"_30106":1905,"_20907":55119,"_5":14363,"_27392":55053,"_2946":55120},[],"The profile can enforce usages such as `DigitalSignature`, `KeyEncipherment`, `CertSign`, `CRLSign`, `ClientAuth`, `ServerAuth` or `OCSPSigning`.",{"_3461":1929,"_30106":1905,"_20907":55122,"_5":14363,"_27392":55053,"_2946":55123},[],"If you enable **Honor Key Usage** or **Honor Extended Key Usages**, Lamassu keeps the values requested by the CSR. If you disable them, it replaces them with the ones defined in the profile.",{"_3461":1930,"_30106":1905,"_20907":55125,"_5":14363,"_27392":55053,"_2946":55126},[],"Do not enable the `Honor…` options for untrusted requests unless another component validates those fields. Otherwise, the requester may choose broader capabilities than intended.",{"_3461":1931,"_30106":1905,"_20907":55128,"_5":14363,"_27392":55057,"_2946":55129},[],"With **Honor Subject**, the certificate keeps the subject of the CSR. Without that option, Lamassu applies the profile's `CN`, `O`, `OU`, `C`, `ST` and `L`. If the profile does not define a `Common Name`, the requested CN is kept.",{"_3461":1932,"_30106":1905,"_20907":55131,"_5":14363,"_27392":55061,"_2946":55132},[],"With **Honor Extensions**, Lamassu filters the additional requested extensions and keeps only SAN. Without that option, it discards the CSR's additional extensions.",{"_3461":1933,"_30106":1905,"_20907":55134,"_5":14363,"_27392":55061,"_2946":55135},[],"This preserves SAN, but does not establish that the requester is entitled to those DNS names, IP addresses, emails or URIs. Validate that authorization before issuing. OCSP and CRL locations come from the issuance service configuration; `Honor Extensions` does not copy CSR distribution points.",{"_3461":1934,"_30106":1905,"_20907":55137,"_5":14363,"_27392":55065,"_2946":55138},[],"The cryptographic enforcement can:",{"_3461":1935,"_30106":1905,"_20907":55140,"_5":14363,"_27392":55065,"_2946":55141},[],"allow or block RSA keys;",{"_3461":1936,"_30106":1905,"_20907":55143,"_5":14363,"_27392":55065,"_2946":55144},[],"limit the supported RSA sizes;",{"_3461":1937,"_30106":1905,"_20907":55146,"_5":14363,"_27392":55065,"_2946":55147},[],"allow or block ECDSA keys;",{"_3461":1938,"_30106":1905,"_20907":55149,"_5":14363,"_27392":55065,"_2946":55150},[],"limit the supported ECDSA sizes or curves.",{"_3461":1939,"_30106":1905,"_20907":55152,"_5":14363,"_27392":55065,"_2946":55153},[],"When it is enabled, Lamassu checks the public key before creating a CA or signing a CSR. A key whose type or size is not listed in the profile is rejected.",{"_3461":1940,"_30106":1905,"_20907":55155,"_5":14363,"_27392":55069,"_2946":55156},[],"Resolution depends on the entry point. One complete profile is selected; its fields are not merged with the CA’s profile.",{"_3461":1941,"_30106":1905,"_20907":55158,"_5":14363,"_27392":55069,"_2946":52360},[],{"_3461":1942,"_30106":1905,"_20907":55160,"_5":14363,"_27392":55069,"_2946":55161},[],"First choice",{"_3461":1943,"_30106":1905,"_20907":55163,"_5":14363,"_27392":55069,"_2946":55164},[],"Second choice",{"_3461":1944,"_30106":1905,"_20907":55166,"_5":14363,"_27392":55069,"_2946":55167},[],"If neither is supplied",{"_3461":1945,"_30106":1905,"_20907":55169,"_5":14363,"_27392":55069,"_2946":55170},[],"Direct signing with a CA",{"_3461":1946,"_30106":1905,"_20907":55172,"_5":14363,"_27392":55069,"_2946":55173},[],"`issuance_profile` embedded in the request",{"_3461":1947,"_30106":1905,"_20907":55175,"_5":14363,"_27392":55069,"_2946":55176},[],"Request `issuance_profile_id`",{"_3461":1948,"_30106":1905,"_20907":55178,"_5":14363,"_27392":55069,"_2946":55179},[],"CA default profile (`profile_id`).",{"_3461":1949,"_30106":1905,"_20907":55181,"_5":14363,"_27392":55069,"_2946":55182},[],"Issuance through a DMS",{"_3461":1950,"_30106":1905,"_20907":55184,"_5":14363,"_27392":55069,"_2946":55185},[],"`settings.issuance_profile_id`",{"_3461":1951,"_30106":1905,"_20907":55187,"_5":14363,"_27392":55069,"_2946":55188},[],"`settings.issuance_profile` embedded in the DMS",{"_3461":1952,"_30106":1905,"_20907":55190,"_5":14363,"_27392":55069,"_2946":55191},[],"Enrollment CA default profile.",{"_3461":1953,"_30106":1905,"_20907":55193,"_5":14363,"_27392":55069,"_2946":55194},[],"If the selected identifier cannot be resolved, the operation fails; it does not silently fall back to the CA’s profile. Avoid setting both options at once. Recording which profile was selected helps explain why a certificate differs from its CSR.",{"_3461":1954,"_30106":1905,"_20907":55196,"_5":14363,"_27392":55069,"_2946":55197},[],"Several fleets can share a CA while keeping different profiles through their DMSs. Requester authentication and device registration policy are configured separately in DMS.",{"_3461":1955,"_30106":1905,"_20907":55199,"_5":14363,"_27392":55077,"_2946":55200},[],"Separate, for example, mTLS devices, servers and intermediate CAs. A small, specific profile is easier to review than one that allows every use.",{"_3461":1956,"_30106":1905,"_20907":55202,"_5":14363,"_27392":55081,"_2946":55203},[],"Align the duration with the fleet's real renewal capacity. Leave margin against the CA's expiration.",{"_3461":1957,"_30106":1905,"_20907":55205,"_5":14363,"_27392":55085,"_2946":55206},[],"For a device that authenticates as a client, the usual starting point is `DigitalSignature` and `ClientAuth`. Add `ServerAuth` or `KeyEncipherment` only if the protocol needs it.",{"_3461":1958,"_30106":1905,"_20907":55208,"_5":14363,"_27392":55089,"_2946":55209},[],"Enable cryptographic enforcement and list only algorithms and sizes compatible with your policy and your devices.",{"_3461":1959,"_30106":1905,"_20907":55211,"_5":14363,"_27392":55093,"_2946":55212},[],"Attach the profile to a CA or DMS and check the precedence above. Issue a CSR with known usages and SAN; inspect the result with `openssl x509 -in device.crt -noout -text`. Check subject, SAN, KU, EKU and dates. For an end-entity identity, disable `Sign as CA`, require no `CA:TRUE` or `Certificate Sign`, and require `CA:FALSE` if Basic Constraints is present.",{"_3461":1960,"_30106":1905,"_20907":55214,"_5":14363,"_27392":55093,"_2946":55215},[],"Also try a key excluded by policy: issuance should fail. Follow the certificate verification and test acceptance in the intended consumer.",{"_3461":1961,"_30106":1905,"_20907":55217,"_5":14363,"_27392":55097,"_2946":55218},[],"**mTLS device**\\\nEnd-entity certificate, short validity, `DigitalSignature`, `ClientAuth`, subject controlled by the DMS and SAN allowed when it identifies the device.",{"_3461":1962,"_30106":1905,"_20907":55220,"_5":14363,"_27392":55097,"_2946":55221},[],"**TLS server**\\\nEnd-entity certificate, `DigitalSignature`, `ServerAuth` and mandatory SAN with the names clients will use.",{"_3461":1963,"_30106":1905,"_20907":55223,"_5":14363,"_27392":55097,"_2946":55224},[],"**Intermediate CA**\\\n`Sign as CA`, `CertSign` and `CRLSign`, validity longer than its end-entity certificates and stricter cryptographic constraints.",{"_3461":1964,"_30106":1905,"_20907":55226,"_5":14363,"_27392":55097,"_2946":55227},[],"These patterns express design decisions. Enabling `Honor Extensions` does not require a CSR to contain SAN or validate its names; enforce that in the request workflow. A profile does not install trust or grant permissions in the consumer.",{"_3461":1965,"_30106":1905,"_20907":55229,"_5":14363,"_27392":55101,"_2946":55230},[],"Updating a profile affects future issuances; it does not modify already-signed certificates. Test changes before applying them to a CA in production and keep the operational justification.",{"_3461":1966,"_30106":1905,"_20907":55232,"_5":14363,"_27392":55101,"_2946":55233},[],"Before deleting a profile, check that no CA or DMS depends on it. If you want to replace it, create the new version, update the references and perform a test issuance before retiring the old one.",{"_3461":1967,"_30106":1967,"_5":14715,"_2946":55235,"_30438":55236,"_20907":55238,"_27392":1967},"Certificate validation",[49125,50593,54598,55237],"Validation",[],{"_3461":1968,"_30106":1967,"_20907":55240,"_5":14363,"_27392":1967,"_2946":55241},[],"Check chain, identity, purpose and revocation from the consumer.",{"_3461":1969,"_30106":1967,"_5":30435,"_20907":55243,"_27392":55244,"_2946":55245},[],"/docs/platform/pki/certificate-validation#before-querying-status","Before querying status",{"_3461":1970,"_30106":1967,"_5":30435,"_20907":55247,"_27392":55248,"_2946":55249},[],"/docs/platform/pki/certificate-validation#choose-a-mechanism","Choose a mechanism",{"_3461":1971,"_30106":1967,"_5":30435,"_20907":55251,"_27392":55252,"_2946":55253},[],"/docs/platform/pki/certificate-validation#check-consumer-behavior","Check consumer behavior",{"_3461":1972,"_30106":1967,"_20907":55255,"_5":14363,"_27392":1967,"_2946":55256},[],"This guide brings together the checks needed when integrating a certificate consumer. You need the presented certificate, intermediates and roots that your application has deliberately chosen to trust. Lamassu publishes status; the consumer applies acceptance policy.",{"_3461":1973,"_30106":1967,"_20907":55258,"_5":14363,"_27392":55244,"_2946":55259},[],"Verify these criteria together:",{"_3461":1974,"_30106":1967,"_20907":55261,"_5":14363,"_27392":55244,"_2946":54224},[],{"_3461":1975,"_30106":1967,"_20907":55263,"_5":14363,"_27392":55244,"_2946":55264},[],"Required result",{"_3461":1976,"_30106":1967,"_20907":55266,"_5":14363,"_27392":55244,"_2946":55267},[],"Chain and signature",{"_3461":1977,"_30106":1967,"_20907":55269,"_5":14363,"_27392":55244,"_2946":55270},[],"Valid chain to a root deliberately installed in the consumer.",{"_3461":1978,"_30106":1967,"_20907":55272,"_5":14363,"_27392":55244,"_2946":55273},[],"Dates",{"_3461":1979,"_30106":1967,"_20907":55275,"_5":14363,"_27392":55244,"_2946":55276},[],"Current time between `Not Before` and `Not After`, including the CAs in the chain.",{"_3461":1980,"_30106":1967,"_20907":55278,"_5":14363,"_27392":55244,"_2946":50262},[],{"_3461":1981,"_30106":1967,"_20907":55280,"_5":14363,"_27392":55244,"_2946":55281},[],"Name, SAN or identifier matches the expected peer.",{"_3461":1982,"_30106":1967,"_20907":55283,"_5":14363,"_27392":55244,"_2946":49515},[],{"_3461":1983,"_30106":1967,"_20907":55285,"_5":14363,"_27392":55244,"_2946":55286},[],"KU, EKU and constraints permit the specific operation.",{"_3461":1984,"_30106":1967,"_20907":55288,"_5":14363,"_27392":55244,"_2946":55289},[],"Revocation",{"_3461":1985,"_30106":1967,"_20907":55291,"_5":14363,"_27392":55244,"_2946":55292},[],"Signed, current evidence corresponding to the queried issuer and certificate.",{"_3461":1986,"_30106":1967,"_20907":55294,"_5":14363,"_27392":55244,"_2946":55295},[],"Authorization",{"_3461":1987,"_30106":1967,"_20907":55297,"_5":14363,"_27392":55244,"_2946":55298},[],"The application permits that identity to perform the action.",{"_3461":1988,"_30106":1967,"_20907":55300,"_5":14363,"_27392":55244,"_2946":55301},[],"The issuance walkthrough checks chain and purpose with OpenSSL. That check does not automatically query OCSP or download a CRL. Inventory presence or an OCSP `Good` response does not replace the other criteria.",{"_3461":1989,"_30106":1967,"_20907":55303,"_5":14363,"_27392":55248,"_2946":55304},[],"Mechanism",{"_3461":1990,"_30106":1967,"_20907":55306,"_5":14363,"_27392":55248,"_2946":55307},[],"When to use it",{"_3461":1991,"_30106":1967,"_20907":55309,"_5":14363,"_27392":55248,"_2946":55310},[],"What you must maintain",{"_3461":1992,"_30106":1967,"_20907":55312,"_5":14363,"_27392":55248,"_2946":55313},[],"OCSP",{"_3461":1993,"_30106":1967,"_20907":55315,"_5":14363,"_27392":55248,"_2946":55316},[],"Status query for a specific certificate.",{"_3461":1994,"_30106":1967,"_20907":55318,"_5":14363,"_27392":55248,"_2946":55319},[],"Responder access, signature verification and cache/freshness policy.",{"_3461":1995,"_30106":1967,"_20907":55321,"_5":14363,"_27392":55248,"_2946":55322},[],"CRL",{"_3461":1996,"_30106":1967,"_20907":55324,"_5":14363,"_27392":55248,"_2946":55325},[],"Local checks for many certificates or offline operation.",{"_3461":1997,"_30106":1967,"_20907":55327,"_5":14363,"_27392":55248,"_2946":55328},[],"Periodic download of an issuer-signed list and rejection of expired lists.",{"_3461":1998,"_30106":1967,"_20907":55330,"_5":14363,"_27392":55248,"_2946":55331},[],"OCSP can also return a response reusable until `nextUpdate`; a CRL changes when a new version is published. Neither mechanism alone guarantees that a consumer learns a revocation at the moment it is saved.",{"_3461":1999,"_30106":1967,"_20907":55333,"_5":14363,"_27392":55248,"_2946":55334},[],"If using both, define when fallback is allowed and what the client does when retrieval, signature or freshness checks fail, or the result is `Unknown`. Accepting an identity when its status cannot be checked must be an explicit application decision.",{"_3461":2000,"_30106":1967,"_20907":55336,"_5":14363,"_27392":55252,"_2946":55337},[],"Accept a current, authorized certificate with a known chain.",{"_3461":2001,"_30106":1967,"_20907":55339,"_5":14363,"_27392":55252,"_2946":55340},[],"Reject another certificate with an unknown root or incompatible purpose.",{"_3461":2002,"_30106":1967,"_20907":55342,"_5":14363,"_27392":55252,"_2946":55343},[],"Revoke a test certificate and verify the OCSP response or new CRL.",{"_3461":2003,"_30106":1967,"_20907":55345,"_5":14363,"_27392":55252,"_2946":55346},[],"Check that a new connection with that identity is rejected.",{"_3461":2004,"_30106":1967,"_20907":55348,"_5":14363,"_27392":55252,"_2946":55349},[],"Simulate an unreachable endpoint and expired evidence; observe whether the result matches policy.",{"_3461":2005,"_30106":1967,"_20907":55351,"_5":14363,"_27392":55252,"_2946":55352},[],"Keep the serial number, issuer, revocation reason, query time and evidence timestamps. An existing session may need explicit closure or reauthentication in the consumer; publishing revocation does not automatically close it.",{"_3461":2006,"_30106":1967,"_20907":55354,"_5":14363,"_27392":55252,"_2946":55355},[],"For a chain with intermediates, validate their status according to consumer policy as well. An end-entity issuer’s CRL does not replace checks on every CA in the chain.",{"_3461":2007,"_30106":1967,"_20907":55357,"_5":14363,"_27392":55252,"_2946":55358},[],"<Card title=\"Online validation with OCSP\" description=\"Generate a query and verify signature, status and timestamps.\" href=\"/docs/platform/pki/ocsp\" />",{"_3461":2008,"_30106":1967,"_20907":55360,"_5":14363,"_27392":55252,"_2946":55361},[],"<Card title=\"Revocation lists\" description=\"Download, inspect and use an issuer’s CRL.\" href=\"/docs/platform/pki/crl\" />",{"_3461":2009,"_30106":2009,"_5":14715,"_2946":55363,"_30438":55364,"_20907":55365,"_27392":2009},"Certificates",[49125,50593,54598,54599],[],{"_3461":2010,"_30106":2009,"_20907":55367,"_5":14363,"_27392":2009,"_2946":55368},[],"Inspect, download and revoke the certificates issued by Lamassu.",{"_3461":2011,"_30106":2009,"_5":30435,"_20907":55370,"_27392":55371,"_2946":55372},[],"/docs/platform/pki/certificates#find-a-certificate","Find a certificate",{"_3461":2012,"_30106":2009,"_5":30435,"_20907":55374,"_27392":55375,"_2946":55376},[],"/docs/platform/pki/certificates#download-the-certificate","Download the certificate",{"_3461":2013,"_30106":2009,"_5":30435,"_20907":55378,"_27392":55379,"_2946":55380},[],"/docs/platform/pki/certificates#issue-from-an-existing-csr","Issue from an existing CSR",{"_3461":2014,"_30106":2009,"_5":30435,"_20907":55382,"_27392":55383,"_2946":55384},[],"/docs/platform/pki/certificates#revoke-a-certificate","Revoke a certificate",{"_3461":2015,"_30106":2009,"_5":30435,"_20907":55386,"_27392":55387,"_2946":55388},[],"/docs/platform/pki/certificates#open-the-action","Open the action",{"_3461":2016,"_30106":2009,"_5":30435,"_20907":55390,"_27392":55391,"_2946":55392},[],"/docs/platform/pki/certificates#choose-a-reason","Choose a reason",{"_3461":2017,"_30106":2009,"_5":30435,"_20907":55394,"_27392":55395,"_2946":55396},[],"/docs/platform/pki/certificates#confirm-and-verify","Confirm and verify",{"_3461":2018,"_30106":2009,"_5":30435,"_20907":55398,"_27392":55399,"_2946":55400},[],"/docs/platform/pki/certificates#reactivate-a-hold","Reactivate a hold",{"_3461":2019,"_30106":2009,"_5":30435,"_20907":55402,"_27392":55403,"_2946":55404},[],"/docs/platform/pki/certificates#continue","Continue",{"_3461":2020,"_30106":2009,"_20907":55406,"_5":14363,"_27392":2009,"_2946":55407},[],"This guide is for a PKI operator inspecting or retiring an issued identity. You need inventory access and, to change states, permissions on the certificate. Open **Certificates** for a global view or **Issued Certificates** within a CA to restrict it to that issuer.",{"_3461":2021,"_30106":2009,"_20907":55409,"_5":14363,"_27392":55371,"_2946":55410},[],"Filter by `Common Name`, serial, status and issuer. A certificate does not contain its private key, so the private-key surfaces answer which certificates have their key held in Lamassu’s KMS:",{"_3461":2022,"_30106":2009,"_20907":55412,"_5":14363,"_27392":55371,"_2946":55413},[],"The advanced **Private Key** filter, available on the Certificates page and on a CA’s **Issued Certificates** tab, narrows the list to **All Certificates**, **With Private Key** or **Without Private Key**.",{"_3461":2023,"_30106":2009,"_20907":55415,"_5":14363,"_27392":55371,"_2946":55416},[],"The sortable **Private Key** column — shown by default, hidden on narrow screens — marks a key held in the KMS with a green check mark and otherwise shows `-`.",{"_3461":2024,"_30106":2009,"_20907":55418,"_5":14363,"_27392":55371,"_2946":55419},[],"In certificate details, the **Information** tab shows a **Private Key** row in the **Key & Signature** section. When the certificate reports a private key and its KMS engine and key IDs are available, the row links to the key (tooltip: **Open private key in KMS**). Otherwise, it shows **Present** if the certificate reports a private key, or **Not available** if it does not. This does not establish whether a key exists outside Lamassu.",{"_3461":2025,"_30106":2009,"_20907":55421,"_5":14363,"_27392":55371,"_2946":55422},[],"Use **Quick Inspect** for a quick review or **View Details** for subject, SAN, usages, chain, dates and metadata.",{"_3461":2026,"_30106":2009,"_20907":55424,"_5":14363,"_27392":55371,"_2946":55425},[],"Certificate records expose `key_id` (the KMS key that holds the private key, empty when the KMS does not hold it) and `has_private_key` (derived at read time from the KMS). Certificate and CA listings accept a `has_private_key` filter, which is useful, for example, to check the result of the CA-to-KMS migration of the 4.0.0 upgrade.",{"_3461":2027,"_30106":2009,"_20907":55427,"_5":14363,"_27392":55371,"_2946":55428},[],"Identify a certificate by issuer and serial; a name can correspond to several renewals. Check which certificate the consumer actually uses and which occupies the device’s active identity. Identity history and the certificate inventory answer different questions.",{"_3461":2028,"_30106":2009,"_20907":55430,"_5":14363,"_27392":55375,"_2946":55431},[],"Download the PEM and inspect it:",{"_3461":2029,"_30106":2009,"_20907":55433,"_5":14363,"_27392":55375,"_2946":55434},[],"Check issuance policy, chain and usages with the verification walkthrough. A certificate does not contain its private key. For an external CSR, the key remains where it was generated; for the browser flow, retain the file downloaded upon issuance. If the key is lost, plan a new identity rather than expecting recovery from the certificate.",{"_3461":2030,"_30106":2009,"_20907":55436,"_5":14363,"_27392":55379,"_2946":55437},[],"Use this flow when the identity’s key must remain on the system that generated it. You need an active CA with a usable key, a PEM CSR and a suitable profile.",{"_3461":2031,"_30106":2009,"_20907":55439,"_5":14363,"_27392":55379,"_2946":55440},[],"Verify the request with `openssl req -in request.csr -noout -verify -text`. Review subject, SAN and algorithm, and authorize the requested identity.",{"_3461":2032,"_30106":2009,"_20907":55442,"_5":14363,"_27392":55379,"_2946":55443},[],"Start issuance from the CA or inventory and select **Upload Existing CSR**.",{"_3461":2033,"_30106":2009,"_20907":55445,"_5":14363,"_27392":55379,"_2946":55446},[],"Confirm the CA and profile resolved according to Profiles; the request does not guarantee that every field is retained.",{"_3461":2034,"_30106":2009,"_20907":55448,"_5":14363,"_27392":55379,"_2946":55449},[],"Download the certificate and inspect dates, issuer, subject, SAN, KU and EKU. Check correspondence with the private key on the originating system.",{"_3461":2035,"_30106":2009,"_20907":55451,"_5":14363,"_27392":55379,"_2946":55452},[],"Install certificate and chain in the intended consumer and test a connection. Issuance alone does not register a device or grant access in an integration.",{"_3461":2036,"_30106":2009,"_20907":55454,"_5":14363,"_27392":55379,"_2946":55455},[],"For browser key generation, follow Issue your first certificate.",{"_3461":2037,"_30106":2009,"_20907":55457,"_5":14363,"_27392":55383,"_2946":55458},[],"Revoke when the key is compromised, the subject is no longer authorized or the identity must stop being accepted before expiration. Before changing status, identify consumers and prepare any required replacement.",{"_3461":2038,"_30106":2009,"_20907":55460,"_5":14363,"_27392":55387,"_2946":55461},[],"Locate the correct issuer and serial and select **Revoke Certificate**. `EXPIRED` records and records revoked for a final reason reject subsequent status changes.",{"_3461":2039,"_30106":2009,"_20907":55463,"_5":14363,"_27392":55391,"_2946":55464},[],"Select the incident reason. `CertificateHold` represents a reversible certificate suspension; other reasons block later changes. Do not use a suspension to address a compromised key.",{"_3461":2040,"_30106":2009,"_20907":55466,"_5":14363,"_27392":55395,"_2946":55467},[],"Save the change and read the record again: require **REVOKED**, reason and timestamp. Then verify a fresh OCSP query and, if using CRL, its published version and the serial’s presence. Finally check rejection of a new connection in the consumer.",{"_3461":2041,"_30106":2009,"_20907":55469,"_5":14363,"_27392":55395,"_2946":55470},[],"Revocation does not erase the certificate, delete the key or guarantee closure of existing sessions. Status and publication are separate steps.",{"_3461":2042,"_30106":2009,"_20907":55472,"_5":14363,"_27392":55395,"_2946":55473},[],"A certificate revoked with `CertificateHold` can be reactivated if it is not in `EXPIRED` state. Its dates and consumer trust remain mandatory.",{"_3461":2043,"_30106":2009,"_20907":55475,"_5":14363,"_27392":55399,"_2946":55476},[],"Check that the saved reason is `CertificateHold` and the identity still satisfies policy. Request `ACTIVE` through the status update operation exposed by your installation; consult the API reference. Do not assume changing consumer permissions also changes status in Lamassu.",{"_3461":2044,"_30106":2009,"_20907":55478,"_5":14363,"_27392":55399,"_2946":55479},[],"Read the record and query OCSP again. With `regenerate_on_revoke` enabled, the reactivation event requests CRL regeneration: check that the new list omits the serial. An earlier list can still mark it revoked until the client refreshes its copy.",{"_3461":2045,"_30106":2009,"_20907":55481,"_5":14363,"_27392":55399,"_2946":55482},[],"This does not undo permanent revocation or a cascade started by revoking a CA.",{"_3461":2046,"_30106":2009,"_20907":55484,"_5":14363,"_27392":55403,"_2946":55485},[],"<Card title=\"Validate with OCSP\" description=\"Query and verify a certificate’s signed status.\" href=\"/docs/platform/pki/ocsp\" />",{"_3461":2047,"_30106":2009,"_20907":55487,"_5":14363,"_27392":55403,"_2946":55488},[],"<Card title=\"Distribute a CRL\" description=\"Publish status for local validation.\" href=\"/docs/platform/pki/crl\" />",{"_3461":2048,"_30106":2048,"_5":14715,"_2946":55490,"_30438":55491,"_20907":55493,"_27392":2048},"Certificate lifecycle",[49125,50593,54598,55492],"Concepts",[],{"_3461":2049,"_30106":2048,"_20907":55495,"_5":14363,"_27392":2048,"_2946":55496},[],"Issuance, use, renewal, revocation and retirement of certificates in Lamassu.",{"_3461":2050,"_30106":2048,"_5":30435,"_20907":55498,"_27392":55499,"_2946":55500},[],"/docs/platform/pki/concepts/certificate-lifecycle#the-full-journey","The full journey",{"_3461":2051,"_30106":2048,"_5":30435,"_20907":55502,"_27392":55503,"_2946":55504},[],"/docs/platform/pki/concepts/certificate-lifecycle#request","Request",{"_3461":2052,"_30106":2048,"_5":30435,"_20907":55506,"_27392":55507,"_2946":55508},[],"/docs/platform/pki/concepts/certificate-lifecycle#issuance","Issuance",{"_3461":2053,"_30106":2048,"_5":30435,"_20907":55510,"_27392":55511,"_2946":55512},[],"/docs/platform/pki/concepts/certificate-lifecycle#use-and-monitoring","Use and monitoring",{"_3461":2054,"_30106":2048,"_5":30435,"_20907":55514,"_27392":55515,"_2946":55516},[],"/docs/platform/pki/concepts/certificate-lifecycle#renewal-or-re-enrollment","Renewal or re-enrollment",{"_3461":2055,"_30106":2048,"_5":30435,"_20907":55518,"_27392":55519,"_2946":55520},[],"/docs/platform/pki/concepts/certificate-lifecycle#revocation-or-retirement","Revocation or retirement",{"_3461":2056,"_30106":2048,"_5":30435,"_20907":55522,"_27392":55523,"_2946":55524},[],"/docs/platform/pki/concepts/certificate-lifecycle#certificate-states","Certificate states",{"_3461":2057,"_30106":2048,"_5":30435,"_20907":55526,"_27392":55527,"_2946":55528},[],"/docs/platform/pki/concepts/certificate-lifecycle#renewal-and-revocation-are-not-equivalent","Renewal and revocation are not equivalent",{"_3461":2058,"_30106":2048,"_5":30435,"_20907":55530,"_27392":55531,"_2946":55532},[],"/docs/platform/pki/concepts/certificate-lifecycle#effect-of-revoking-a-ca","Effect of revoking a CA",{"_3461":2059,"_30106":2048,"_5":30435,"_20907":55534,"_27392":55535,"_2946":55536},[],"/docs/platform/pki/concepts/certificate-lifecycle#what-you-should-watch","What you should watch",{"_3461":2060,"_30106":2048,"_20907":55538,"_5":14363,"_27392":2048,"_2946":55539},[],"Issuing a certificate is only the beginning. During its useful life you must check its validity, renew it before it expires and retire it when it stops being trustworthy. Lamassu keeps the certificate, its issuing CA, its status and, when it belongs to a device, the identity it is linked to.",{"_3461":2061,"_30106":2048,"_20907":55541,"_5":14363,"_27392":55503,"_2946":55542},[],"The requester generates a key and a CSR. In the recommended flows, the private key stays in the device, browser or cryptographic engine that created it.",{"_3461":2062,"_30106":2048,"_20907":55544,"_5":14363,"_27392":55507,"_2946":55545},[],"The CA signs the CSR. The issuance profile determines the validity, uses, subject, allowed extensions and cryptographic constraints.",{"_3461":2063,"_30106":2048,"_20907":55547,"_5":14363,"_27392":55511,"_2946":55548},[],"The certificate enters the `ACTIVE` state. Lamassu monitors its `Not After` date; the cryptographic monitoring job marks certificates that have expired as `EXPIRED`.",{"_3461":2064,"_30106":2048,"_20907":55550,"_5":14363,"_27392":55515,"_2946":55551},[],"A new certificate is issued before the previous one expires. In a DMS you can open preventive and critical windows so the device re-enrolls through EST.",{"_3461":2065,"_30106":2048,"_20907":55553,"_5":14363,"_27392":55519,"_2946":55554},[],"If the identity stops being trustworthy, Lamassu records the reason and time of revocation. OCSP and CRLs let consumers learn that status.",{"_3461":2066,"_30106":2048,"_20907":55556,"_5":14363,"_27392":55523,"_2946":55557},[],"Lamassu persists four X.509 states:",{"_3461":2067,"_30106":2048,"_20907":55559,"_5":14363,"_27392":55523,"_2946":55560},[],"**`ACTIVE`**: the record is enabled. Also check `Not Before` and `Not After`: this state does not establish time validity.",{"_3461":2068,"_30106":2048,"_20907":55562,"_5":14363,"_27392":55523,"_2946":55563},[],"**`EXPIRED`**: it has passed its expiration date. The monitor detects this periodically; it is not a state that should be assigned manually.",{"_3461":2069,"_30106":2048,"_20907":55565,"_5":14363,"_27392":55523,"_2946":55566},[],"**`REVOKED`**: it was invalidated before expiring, with a reason and a timestamp.",{"_3461":2070,"_30106":2048,"_20907":55568,"_5":14363,"_27392":55523,"_2946":55569},[],"**`INACTIVE`**: it is disabled without representing a definitive revocation.",{"_3461":2071,"_30106":2048,"_20907":55571,"_5":14363,"_27392":55523,"_2946":55572},[],"The device view may add operational states such as missing identity, pending renewal, expiring soon or decommissioned. These are an interpretation of the device's status and its certificates, not new X.509 states.",{"_3461":2072,"_30106":2048,"_20907":55574,"_5":14363,"_27392":55527,"_2946":55575},[],"**Renewal** creates a successor certificate for an identity that remains valid. **Revocation** communicates that the current certificate must no longer be accepted. Renew to maintain continuity; revoke in response to compromise, retirement or a change that invalidates the identity.",{"_3461":2073,"_30106":2048,"_20907":55577,"_5":14363,"_27392":55527,"_2946":55578},[],"Only `CertificateHold` allows reactivating a revoked certificate that is not in `EXPIRED` state. Revocation for another reason blocks subsequent status changes. `EXPIRED` records also reject changes; the consumer must check dates even before the monitor updates the state. Certificates explains how to verify revocation and reactivation.",{"_3461":2074,"_30106":2048,"_20907":55580,"_5":14363,"_27392":55527,"_2946":55581},[],"The **Reissue CA** operation generates another certificate for the same key and links both serial numbers through metadata. It is not a key rotation. To change the key, create a successor CA and perform a migration with an overlapping period.",{"_3461":2075,"_30106":2048,"_20907":55583,"_5":14363,"_27392":55531,"_2946":55584},[],"Revoking a CA starts a cascade that attempts to revoke descendants with `CessationOfOperation`. It may end with partial failures and is not undone by reactivating the parent. Read Hierarchy and rotation for conditions and checks.",{"_3461":2076,"_30106":2048,"_20907":55586,"_5":14363,"_27392":55531,"_2946":55587},[],"Before confirming:",{"_3461":2077,"_30106":2048,"_20907":55589,"_5":14363,"_27392":55531,"_2946":55590},[],"Identify DMSs, devices and services that trust that chain.",{"_3461":2078,"_30106":2048,"_20907":55592,"_5":14363,"_27392":55531,"_2946":55593},[],"Distribute the new chain of trust.",{"_3461":2079,"_30106":2048,"_20907":55595,"_5":14363,"_27392":55531,"_2946":55596},[],"Reissue the necessary identities.",{"_3461":2080,"_30106":2048,"_20907":55598,"_5":14363,"_27392":55531,"_2946":55599},[],"Check OCSP and CRL from a real consumer.",{"_3461":2081,"_30106":2048,"_20907":55601,"_5":14363,"_27392":55531,"_2946":55602},[],"Revoke the old CA once no legitimate traffic remains.",{"_3461":2082,"_30106":2048,"_20907":55604,"_5":14363,"_27392":55531,"_2946":55605},[],"Device retirement belongs to the IoT Fleets lifecycle. It affects the active identity; it does not automatically traverse and revoke every historical certificate. Review previous identities and consumer permissions separately in Device management.",{"_3461":2083,"_30106":2048,"_20907":55607,"_5":14363,"_27392":55535,"_2946":55608},[],"Certificates entering the preventive or critical renewal window.",{"_3461":2084,"_30106":2048,"_20907":55610,"_5":14363,"_27392":55535,"_2946":55611},[],"Repeated enrollment or re-enrollment failures.",{"_3461":2085,"_30106":2048,"_20907":55613,"_5":14363,"_27392":55535,"_2946":55614},[],"Status changes and revocation reasons.",{"_3461":2086,"_30106":2048,"_20907":55616,"_5":14363,"_27392":55535,"_2946":55617},[],"OCSP and CRL publication and validity.",{"_3461":2087,"_30106":2048,"_20907":55619,"_5":14363,"_27392":55535,"_2946":55620},[],"Dependencies still presenting a replaced certificate.",{"_3461":2088,"_30106":2048,"_20907":55622,"_5":14363,"_27392":55535,"_2946":55623},[],"The device history relates its previous and current identities. For administrative changes and mutation errors, see Audit logs.",{"_3461":2089,"_30106":2089,"_5":14715,"_2946":55625,"_30438":55626,"_20907":55627,"_27392":2089},"Trust model",[49125,50593,54598,55492],[],{"_3461":2090,"_30106":2089,"_20907":55629,"_5":14363,"_27392":2089,"_2946":55630},[],"Understand where trust originates, how it is distributed and what each component validates.",{"_3461":2091,"_30106":2089,"_5":30435,"_20907":55632,"_27392":55633,"_2946":55634},[],"/docs/platform/pki/concepts/trust-model#the-four-trust-decisions","The four trust decisions",{"_3461":2092,"_30106":2089,"_5":30435,"_20907":55636,"_27392":55637,"_2946":55638},[],"/docs/platform/pki/concepts/trust-model#who-can-issue","Who can issue",{"_3461":2093,"_30106":2089,"_5":30435,"_20907":55640,"_27392":55641,"_2946":55642},[],"/docs/platform/pki/concepts/trust-model#what-can-be-issued","What can be issued",{"_3461":2094,"_30106":2089,"_5":30435,"_20907":55644,"_27392":55645,"_2946":55646},[],"/docs/platform/pki/concepts/trust-model#who-can-request-it","Who can request it",{"_3461":2095,"_30106":2089,"_5":30435,"_20907":55648,"_27392":55649,"_2946":55650},[],"/docs/platform/pki/concepts/trust-model#who-accepts-the-result","Who accepts the result",{"_3461":2096,"_30106":2089,"_5":30435,"_20907":55652,"_27392":55653,"_2946":55654},[],"/docs/platform/pki/concepts/trust-model#identity-flow","Identity flow",{"_3461":2097,"_30106":2089,"_5":30435,"_20907":55656,"_27392":55657,"_2946":55658},[],"/docs/platform/pki/concepts/trust-model#enrollment-validation-and-distribution-cas","Enrollment, validation and distribution CAs",{"_3461":2098,"_30106":2089,"_5":30435,"_20907":55660,"_27392":55661,"_2946":55662},[],"/docs/platform/pki/concepts/trust-model#validation-and-revocation","Validation and revocation",{"_3461":2099,"_30106":2089,"_5":30435,"_20907":55664,"_27392":55665,"_2946":55666},[],"/docs/platform/pki/concepts/trust-model#custody-limits","Custody limits",{"_3461":2100,"_30106":2089,"_5":30435,"_20907":55668,"_27392":55669,"_2946":55670},[],"/docs/platform/pki/concepts/trust-model#recommended-pattern","Recommended pattern",{"_3461":2101,"_30106":2089,"_20907":55672,"_5":14363,"_27392":2089,"_2946":55673},[],"In Lamassu, trust does not simply mean that a certificate exists in the inventory. A consumer trusts an identity when it can build a chain to a root it recognizes, check that the certificate is fit for the intended use and verify that it is still valid.",{"_3461":2102,"_30106":2089,"_20907":55675,"_5":14363,"_27392":55637,"_2946":55676},[],"The CA hierarchy defines which authorities can sign. A root CA establishes the anchor of trust; intermediate CAs separate operating domains and avoid using the root for every issuance.",{"_3461":2103,"_30106":2089,"_20907":55678,"_5":14363,"_27392":55641,"_2946":55679},[],"Certificate profiles limit validity, subject, uses, extensions and cryptographic parameters. Possessing a CA does not replace an issuance policy.",{"_3461":2104,"_30106":2089,"_20907":55681,"_5":14363,"_27392":55645,"_2946":55682},[],"The DMS acts as the enrollment point. It can authenticate an EST request with a client certificate, an external webhook or a combination of both. CAs configured to validate the requester do not have to be the CA that will issue the new identity.",{"_3461":2105,"_30106":2089,"_20907":55684,"_5":14363,"_27392":55649,"_2946":55685},[],"The consumer keeps its own trust store. EST `/cacerts` can distribute the service TLS certificate, the enrollment CA and selected managed CAs. Initial trust for authenticating that service must come from an already trusted channel. Download and inspect the contents: do not assume they form a complete chain or install every entry as a root.",{"_3461":2106,"_30106":2089,"_20907":55687,"_5":14363,"_27392":55653,"_2946":55688},[],"The device proves it can enroll according to the DMS policy.",{"_3461":2107,"_30106":2089,"_20907":55690,"_5":14363,"_27392":55653,"_2946":55691},[],"The DMS validates the request and forwards the CSR to the enrollment CA.",{"_3461":2108,"_30106":2089,"_20907":55693,"_5":14363,"_27392":55653,"_2946":55694},[],"In the device-generated CSR flow, the CA applies the profile and signs without receiving the device’s private key.",{"_3461":2109,"_30106":2089,"_20907":55696,"_5":14363,"_27392":55653,"_2946":55697},[],"The device installs the certificate and the chain it needs.",{"_3461":2110,"_30106":2089,"_20907":55699,"_5":14363,"_27392":55653,"_2946":55700},[],"The system that trusts the device validates the chain, dates, uses and revocation status.",{"_3461":2111,"_30106":2089,"_20907":55702,"_5":14363,"_27392":55653,"_2946":55703},[],"OIDC or X.509 identifies the operator calling Lamassu. The authorization service decides which actions it may perform. The X.509 hierarchy, on the other hand, determines whether a certificate presented by a device is trustworthy.",{"_3461":2112,"_30106":2089,"_20907":55705,"_5":14363,"_27392":55657,"_2946":55706},[],"A DMS relates three sets that are worth designing separately:",{"_3461":2113,"_30106":2089,"_20907":55708,"_5":14363,"_27392":55657,"_2946":55709},[],"**Enrollment CA:** signs the new identities.",{"_3461":2114,"_30106":2089,"_20907":55711,"_5":14363,"_27392":55657,"_2946":55712},[],"**Validation CAs:** authenticate the client certificates used for enrollment or migration. During re-enrollment, the enrollment CA is always trusted and Lamassu then tries the validation CAs configured in the re-enrollment block; those are optional.",{"_3461":2115,"_30106":2089,"_20907":55714,"_5":14363,"_27392":55657,"_2946":55715},[],"**Distributed CAs:** form the content the device obtains through EST `/cacerts`. You can include the service TLS certificate, the enrollment CA and an explicit list of managed CAs. Including the issuer does not automatically add all its ancestors.",{"_3461":2116,"_30106":2089,"_20907":55717,"_5":14363,"_27392":55657,"_2946":55718},[],"This separation makes it possible to migrate a fleet: you temporarily accept certificates from the old hierarchy, issue with the new one and distribute both chains during the overlap.",{"_3461":2117,"_30106":2089,"_20907":55720,"_5":14363,"_27392":55661,"_2946":55721},[],"A valid chain does not by itself guarantee that a certificate should be accepted. The consumer must also check:",{"_3461":2118,"_30106":2089,"_20907":55723,"_5":14363,"_27392":55661,"_2946":55724},[],"that the current date is between `Not Before` and `Not After`;",{"_3461":2119,"_30106":2089,"_20907":55726,"_5":14363,"_27392":55661,"_2946":55727},[],"that `Key Usage` and `Extended Key Usage` allow the operation;",{"_3461":2120,"_30106":2089,"_20907":55729,"_5":14363,"_27392":55661,"_2946":55730},[],"that names, SANs and subject match the expected identity;",{"_3461":2121,"_30106":2089,"_20907":55732,"_5":14363,"_27392":55661,"_2946":55733},[],"that the certificate does not appear revoked in OCSP or a CRL.",{"_3461":2122,"_30106":2089,"_20907":55735,"_5":14363,"_27392":55661,"_2946":55736},[],"An OCSP `Good` status does not replace chain, date, usage and identity checks either; Validation brings those criteria together.",{"_3461":2123,"_30106":2089,"_20907":55738,"_5":14363,"_27392":55661,"_2946":55739},[],"During the mTLS authentication of a DMS, Lamassu attempts to check revocation. If the certificate does not contain enough information to perform that check, the backend logs a warning and continues treating it as not revoked. Design your profiles and distribution points to avoid that situation in production.",{"_3461":2124,"_30106":2089,"_20907":55741,"_5":14363,"_27392":55665,"_2946":55742},[],"The KMS keeps the reference to the key and delegates the operation to the configured engine. With an HSM or a cloud KMS, the private key can remain non-exportable. That protects custody, but it does not by itself prevent misuse: you still must restrict who can request a signature and audit those operations.",{"_3461":2125,"_30106":2089,"_20907":55744,"_5":14363,"_27392":55669,"_2946":55745},[],"Keep the root out of daily operations, or with very restricted access.",{"_3461":2126,"_30106":2089,"_20907":55747,"_5":14363,"_27392":55669,"_2946":55748},[],"Issue from intermediate CAs separated by environment or risk domain.",{"_3461":2127,"_30106":2089,"_20907":55750,"_5":14363,"_27392":55669,"_2946":55751},[],"Assign explicit profiles to every use case.",{"_3461":2128,"_30106":2089,"_20907":55753,"_5":14363,"_27392":55669,"_2946":55754},[],"Distribute the new trust before starting a rotation.",{"_3461":2129,"_30106":2089,"_20907":55756,"_5":14363,"_27392":55669,"_2946":55757},[],"Keep enough overlap to renew a disconnected fleet.",{"_3461":2130,"_30106":2089,"_20907":55759,"_5":14363,"_27392":55669,"_2946":55760},[],"Validate from the consuming system, not only from the Lamassu console.",{"_3461":2131,"_30106":2089,"_20907":55762,"_5":14363,"_27392":55669,"_2946":55763},[],"Continue with CA hierarchy and rotation to turn this model into an operating procedure.",{"_3461":2132,"_30106":2132,"_5":14715,"_2946":55765,"_30438":55766,"_20907":55767,"_27392":2132},"Revocation lists (CRL)",[49125,50593,54598,55237],[],{"_3461":2133,"_30106":2132,"_20907":55769,"_5":14363,"_27392":2132,"_2946":55770},[],"Generate and distribute signed lists to validate certificates offline.",{"_3461":2134,"_30106":2132,"_5":30435,"_20907":55772,"_27392":55773,"_2946":55774},[],"/docs/platform/pki/crl#crl-settings","CRL settings",{"_3461":2135,"_30106":2132,"_5":30435,"_20907":55776,"_27392":55777,"_2946":55778},[],"/docs/platform/pki/crl#cas-that-share-a-key","CAs that share a key",{"_3461":2136,"_30106":2132,"_5":30435,"_20907":55780,"_27392":55781,"_2946":55782},[],"/docs/platform/pki/crl#periodic-and-automatic-regeneration","Periodic and automatic regeneration",{"_3461":2137,"_30106":2132,"_5":30435,"_20907":55784,"_27392":55785,"_2946":55786},[],"/docs/platform/pki/crl#crl-contents","CRL contents",{"_3461":2138,"_30106":2132,"_5":30435,"_20907":55788,"_27392":55789,"_2946":55790},[],"/docs/platform/pki/crl#public-download-endpoint","Public download endpoint",{"_3461":2139,"_30106":2132,"_5":30435,"_20907":55792,"_27392":55793,"_2946":55794},[],"/docs/platform/pki/crl#crl-settings-api","CRL settings API",{"_3461":2140,"_30106":2132,"_5":30435,"_20907":55796,"_27392":55797,"_2946":55798},[],"/docs/platform/pki/crl#common-crl-settings-errors","Common CRL settings errors",{"_3461":2141,"_30106":2132,"_5":30435,"_20907":55800,"_27392":55801,"_2946":55802},[],"/docs/platform/pki/crl#from-the-interface","From the interface",{"_3461":2142,"_30106":2132,"_5":30435,"_20907":55804,"_27392":55805,"_2946":55806},[],"/docs/platform/pki/crl#references","References",{"_3461":2143,"_30106":2132,"_20907":55808,"_5":14363,"_27392":2132,"_2946":55809},[],"A CRL is an issuer-signed list of revoked certificates. This guide is for an operator publishing lists and an integrator using them locally. You need the issuing CA certificate, its CA ID and access to the published endpoint. The client must maintain a current copy: offline operation still requires refreshing evidence.",{"_3461":2144,"_30106":2132,"_20907":55811,"_5":14363,"_27392":55773,"_2946":55812},[],"The CRL settings of a CA store the configuration and metadata of its latest published list. Each CA has its own settings, keyed by its CA ID — even when two CAs share a key: they share the SKI, not the CRL. Generation requires a usable issuer key; do not assume an imported CA without a key has an available CRL.",{"_3461":2145,"_30106":2132,"_20907":55814,"_5":14363,"_27392":55773,"_2946":55815},[],"Field",{"_3461":2146,"_30106":2132,"_20907":55817,"_5":14363,"_27392":55773,"_2946":49515},[],{"_3461":2147,"_30106":2132,"_20907":55819,"_5":14363,"_27392":55773,"_2946":55820},[],"`ca_id`",{"_3461":2148,"_30106":2132,"_20907":55822,"_5":14363,"_27392":55773,"_2946":55823},[],"ID of the CA the settings belong to.",{"_3461":2149,"_30106":2132,"_20907":55825,"_5":14363,"_27392":55773,"_2946":55826},[],"`status`",{"_3461":2150,"_30106":2132,"_20907":55828,"_5":14363,"_27392":55773,"_2946":55829},[],"`ACTIVE` settings generate CRLs. `ARCHIVED` ones belong to a CA that no longer exists: their last CRL is still served, but never regenerated.",{"_3461":2151,"_30106":2132,"_20907":55831,"_5":14363,"_27392":55773,"_2946":55832},[],"`legacy_ski`",{"_3461":2152,"_30106":2132,"_20907":55834,"_5":14363,"_27392":55773,"_2946":55835},[],"Read-only. SKI the settings were keyed by before the 4.0.0 migration; only migrated settings have it, and `/crl/<ski>` keeps resolving to them.",{"_3461":2153,"_30106":2132,"_20907":55837,"_5":14363,"_27392":55773,"_2946":55838},[],"`latest_crl`",{"_3461":2154,"_30106":2132,"_20907":55840,"_5":14363,"_27392":55773,"_2946":55841},[],"Version, validity start and end of the last published list. Read-only.",{"_3461":2155,"_30106":2132,"_20907":55843,"_5":14363,"_27392":55773,"_2946":55844},[],"`crl_options` field",{"_3461":2156,"_30106":2132,"_20907":55846,"_5":14363,"_27392":55773,"_2946":49515},[],{"_3461":2157,"_30106":2132,"_20907":55848,"_5":14363,"_27392":55773,"_2946":55849},[],"Initial value",{"_3461":2158,"_30106":2132,"_20907":55851,"_5":14363,"_27392":55773,"_2946":55852},[],"`validity`",{"_3461":2159,"_30106":2132,"_20907":55854,"_5":14363,"_27392":55773,"_2946":55855},[],"Time from `thisUpdate` to `nextUpdate`.",{"_3461":2160,"_30106":2132,"_20907":55857,"_5":14363,"_27392":55773,"_2946":55858},[],"7 days.",{"_3461":2161,"_30106":2132,"_20907":55860,"_5":14363,"_27392":55773,"_2946":55861},[],"`refresh_interval`",{"_3461":2162,"_30106":2132,"_20907":55863,"_5":14363,"_27392":55773,"_2946":55864},[],"Time since the issuance of the latest published CRL that triggers scheduled renewal; `0` disables only this trigger. The effective granularity is bounded by the job frequency (see Periodic and automatic regeneration).",{"_3461":2163,"_30106":2132,"_20907":55866,"_5":14363,"_27392":55773,"_2946":55867},[],"6 days and 23 hours.",{"_3461":2164,"_30106":2132,"_20907":55869,"_5":14363,"_27392":55773,"_2946":55870},[],"`regenerate_on_revoke`",{"_3461":2165,"_30106":2132,"_20907":55872,"_5":14363,"_27392":55773,"_2946":55873},[],"Request regeneration on revocation or reactivation from `CertificateHold` events.",{"_3461":2166,"_30106":2132,"_20907":55875,"_5":14363,"_27392":55773,"_2946":55876},[],"`true`.",{"_3461":2167,"_30106":2132,"_20907":55878,"_5":14363,"_27392":55773,"_2946":55879},[],"`signer_serial_number`",{"_3461":2168,"_30106":2132,"_20907":55881,"_5":14363,"_27392":55773,"_2946":55882},[],"Serial number of the existing certificate that signs the CRL.",{"_3461":2169,"_30106":2132,"_20907":55884,"_5":14363,"_27392":55773,"_2946":55885},[],"Serial number of the CA’s current certificate.",{"_3461":2170,"_30106":2132,"_20907":55887,"_5":14363,"_27392":55773,"_2946":55888},[],"The signer must be an existing certificate with the `cRLSign` key usage and the same subject and public key as the CA. Certificates from before a reissue qualify. A delegated signer is not supported: a certificate with the CA’s subject but a different key is rejected.",{"_3461":2171,"_30106":2132,"_20907":55890,"_5":14363,"_27392":55773,"_2946":55891},[],"When a CA is reissued and the signer is the superseded CA certificate, the VA moves the signer to the new certificate — provided it carries `cRLSign` — and republishes the CRL. If the new certificate lacks `cRLSign`, the VA keeps the previous signer and logs a warning. If the signer is any other certificate with the CA’s subject and key, it is deliberately left unchanged; the previous certificate then cannot be deleted while the settings use it (the API returns `409` `certificate is in use`), and to retire it you update the signer with `PUT`.",{"_3461":2172,"_30106":2132,"_20907":55893,"_5":14363,"_27392":55773,"_2946":55894},[],"A CA whose signer lacks `cRLSign` cannot generate its CRL, and an update that selects a signer without `cRLSign` is rejected (400 error). Since 4.0 the VA requires this usage. Check before importing with `openssl x509 -noout -ext keyUsage` and, if it is missing, obtain a certificate for the same CA and key that includes it and update the settings to use it as the signer. After reissuing a CA, also check the key usage of the new certificate: it may not keep the original’s usages, and without `cRLSign` the settings keep their previous signer.",{"_3461":2173,"_30106":2132,"_20907":55896,"_5":14363,"_27392":55773,"_2946":55897},[],"Deleting a CA keeps its CRL settings, and they cannot be removed through the API. What happens next depends on when the CA was deleted:",{"_3461":2174,"_30106":2132,"_20907":55899,"_5":14363,"_27392":55773,"_2946":55900},[],"The 4.0.0 upgrade migration archives the settings of the CAs that had been deleted before the upgrade. Their `status` is `ARCHIVED` and their `ca_id` is `legacy-<ski>`: the last CRL keeps being served, but it is never regenerated, any `PUT` returns 409, and there is no API way back to `ACTIVE`.",{"_3461":2175,"_30106":2132,"_20907":55902,"_5":14363,"_27392":55773,"_2946":55903},[],"A CA deleted while running 4.0.0 leaves `ACTIVE` settings. The last CRL keeps being served, but once it expires nothing regenerates it: the renewal job logs `something went wrong while calculating CRL for CA <ca-id>` on every cycle because it can no longer resolve the CA. The options can still be edited while the signer is unchanged; changing the signer fails, because there is no CA left to match it.",{"_3461":2176,"_30106":2132,"_20907":55905,"_5":14363,"_27392":55773,"_2946":55906},[],"Adjust validity and signer before deleting a CA.",{"_3461":2177,"_30106":2132,"_20907":55908,"_5":14363,"_27392":55773,"_2946":55909},[],"`PUT` validates the signer only when the request changes it. If the stored signer is no longer valid, the other options can still be edited, but the CRL cannot be regenerated until a valid signer is set.",{"_3461":2178,"_30106":2132,"_20907":55911,"_5":14363,"_27392":55773,"_2946":55912},[],"Sharing a key between CAs is a migration blocker: the 4.0.0 upgrade aborts while an SKI belongs to more than one CA. See CAs that share a key.",{"_3461":2179,"_30106":2132,"_20907":55914,"_5":14363,"_27392":55773,"_2946":55915},[],"CRL versions are kept as PEM in object storage at `pki/va/crl/<ca-id>/<version>.crl`; the public endpoint returns DER. CRLs published before the 4.0.0 upgrade remain at `pki/va/crl/<ski>/<version>.crl` and keep being served.",{"_3461":2180,"_30106":2132,"_20907":55917,"_5":14363,"_27392":55777,"_2946":55918},[],"Since 4.0.0, each CA publishes its own CRL even when its key is shared: two CAs with the same key have the same SKI, but each has its own CRL settings and its own list, signed by a certificate with that CA’s identity.",{"_3461":2181,"_30106":2132,"_20907":55920,"_5":14363,"_27392":55777,"_2946":55921},[],"Certificates issued from now on carry `/crl/<ca-id>` distribution points, so each CA’s certificates resolve to its own list. Certificates issued before the upgrade keep their `/crl/<ski>` distribution points: that URL keeps resolving to the settings the upgrade migrated, and always serves the list of the CA that owned that SKI when the upgrade ran. It is never rebound to a CA created later with the same key. After regeneration, the migrated list includes both URLs in its *Issuing Distribution Point* (OID `2.5.29.28`), so a verifier that compares the IDP with the CDP of the certificate accepts either form. Until the VA scheduled CRL job successfully regenerates it, the pre-upgrade list contains only the legacy `/crl/<ski>` IDP; IDP-checking verifiers cannot validate newly issued certificates with `/crl/<ca-id>` CDPs. The first run can take up to about an hour with the default schedule, and failures can extend the window.",{"_3461":2182,"_30106":2132,"_20907":55923,"_5":14363,"_27392":55777,"_2946":55924},[],"Sharing an SKI between CAs blocks the upgrade: the migration aborts and names the SKIs. To detect the problem before upgrading, compare the SKI of the CAs in the inventory: two with the same SKI are affected. To fix it, create a CA with its own key and reissue its certificates; those already issued keep the old URL and are not corrected until reissued.",{"_3461":2183,"_30106":2132,"_20907":55926,"_5":14363,"_27392":55777,"_2946":55927},[],"Lamassu takes the SKI of an imported certificate as-is and does not check that it corresponds to its public key. Until Lamassu rejects imports whose SKI collides with an existing CA — proposed in lamassuiot#834, together with the per-CA CRL that 4.0.0 implements — restrict the permission to import CAs as an interim control; it covers only the import path. Creating a CA with &#x2A;*Create New CA (Existing Key)** on a KMS key another CA already uses produces the same SKI collision, so avoid reusing keys across CAs.",{"_3461":2184,"_30106":2132,"_20907":55929,"_5":14363,"_27392":55781,"_2946":55930},[],"The VA scheduled job checks the CRL settings of every CA on each run and requests a new list when either of these conditions is met:",{"_3461":2185,"_30106":2132,"_20907":55932,"_5":14363,"_27392":55781,"_2946":55933},[],"**The list is about to expire:** the remaining validity of `latest_crl` is less than the interval between job runs. This condition always applies and cannot be disabled.",{"_3461":2186,"_30106":2132,"_20907":55935,"_5":14363,"_27392":55781,"_2946":55936},[],"**The refresh interval has elapsed:** the time since the issuance of the latest published CRL reaches `refresh_interval`. Setting `refresh_interval` to `0` disables only this condition; the list is still regenerated when it is about to expire.",{"_3461":2187,"_30106":2132,"_20907":55938,"_5":14363,"_27392":55781,"_2946":55939},[],"Setting `refresh_interval` to `0` therefore does not freeze regeneration. With the default 7-day validity and an hourly job, a CRL is renewed up to an hour before it expires even if `refresh_interval` is `0`. Because the job runs on its own schedule, `refresh_interval` is honored only as precisely as the job frequency allows.",{"_3461":2188,"_30106":2132,"_20907":55941,"_5":14363,"_27392":55781,"_2946":55942},[],"The job frequency is set in Helm with `services.va.job.crl.frequency` (default `0 * * * *`) and accepts a duration (`1h`) or a cron expression. A cron expression is converted into a constant interval equal to the time left until its next firing when the service starts, so it is not aligned with the clock. Keep `validity` well above that interval: with a shorter validity, the list is regenerated on every cycle.",{"_3461":2189,"_30106":2132,"_20907":55944,"_5":14363,"_27392":55781,"_2946":55945},[],"If generation fails (for example, because the CA cannot be resolved or the signer is invalid), the job logs the warning `something went wrong while calculating CRL for CA <ca-id>` and retries on the next cycle. There is no other renewal path until the cause is fixed, and the last published list keeps being served until it expires. All of this depends on working jobs, storage and signing.",{"_3461":2190,"_30106":2132,"_20907":55947,"_5":14363,"_27392":55781,"_2946":55948},[],"Settings whose `status` is `ARCHIVED` are skipped: nothing regenerates their CRL.",{"_3461":2191,"_30106":2132,"_20907":55950,"_5":14363,"_27392":55781,"_2946":55951},[],"With `regenerate_on_revoke`, the event handler requests a new CRL upon revocation or reactivation from `CertificateHold` to `ACTIVE`. This happens after the status change and has its own failure paths: if generation fails (for example, because of an invalid signer), the event is retried and, once retries are exhausted, moves to the failed-events queue. If the issuing CA has no CRL settings, there is no CRL to regenerate: the event is acknowledged without retry, the VA logs a warning, and nothing appears in the failed-events queue. Confirming revocation does not establish that the new CRL is already published or that all clients have downloaded it.",{"_3461":2192,"_30106":2132,"_20907":55953,"_5":14363,"_27392":55781,"_2946":55954},[],"Compare CRL numbers and timestamps before and after a change. Monitor expired lists and generation failures; clients must apply policy when current evidence is unavailable.",{"_3461":2193,"_30106":2132,"_20907":55956,"_5":14363,"_27392":55785,"_2946":55957},[],"Each entry contains serial number, revocation time and reason. The generator queries certificates in `REVOKED` state for the selected CA. A reactivated certificate disappears when the list is recalculated; an earlier downloaded copy retains its contents.",{"_3461":2194,"_30106":2132,"_20907":55959,"_5":14363,"_27392":55785,"_2946":55960},[],"The list contains a critical *Issuing Distribution Point* (OID `2.5.29.28`) with configured distribution URLs. Check that your client interprets this extension and that it matches the list’s scope. If rejected, investigate format and scope; ignoring a critical extension is not successful validation.",{"_3461":2195,"_30106":2132,"_20907":55962,"_5":14363,"_27392":55789,"_2946":55963},[],"The VA service exposes `GET /crl/{id}` without management authorization. Use the **issuing CA’s** ID, not the end-entity certificate’s ID or serial. Certificates issued before the 4.0.0 upgrade carry `/crl/<ski>` URLs with the SKI of the CA key; that form keeps resolving. First inspect the certificate’s CDP:",{"_3461":2196,"_30106":2132,"_20907":55965,"_5":14363,"_27392":55789,"_2946":55966},[],"Replace the following URL with the CDP URL and review exposure in Deployment:",{"_3461":2197,"_30106":2132,"_20907":55968,"_5":14363,"_27392":55789,"_2946":55969},[],"You need OpenSSL 3.x and `issuer.pem` containing the direct issuer’s certificate. An accepted signer certificate has the same subject and public key as the CA, so this signature check also works when the settings point to an earlier certificate for that CA and key. Require a valid signature, current timestamps and the expected issuer. For a root that issues directly:",{"_3461":2198,"_30106":2132,"_20907":55971,"_5":14363,"_27392":55789,"_2946":55972},[],"`roots.pem` contains deliberately trusted roots. For intermediates, add `-untrusted intermediates.pem` before the `device.crt` argument. `-crl_check` checks the end-entity certificate’s revocation against the local list; it does not download other lists or establish the status of the whole chain. A complete chain check needs the corresponding CRLs and a policy requiring them.",{"_3461":2199,"_30106":2132,"_20907":55974,"_5":14363,"_27392":55789,"_2946":55975},[],"The test should accept an allowed certificate absent from the list and reject it with `certificate revoked` after publishing and using the list containing its serial.",{"_3461":2200,"_30106":2132,"_20907":55977,"_5":14363,"_27392":55793,"_2946":55978},[],"The following paths are relative to the VA service; confirm the public prefix in the Gateway. They are not the URLs of the public OCSP and CRL endpoints.",{"_3461":2201,"_30106":2132,"_20907":55980,"_5":14363,"_27392":55793,"_2946":52363},[],{"_3461":2202,"_30106":2132,"_20907":55982,"_5":14363,"_27392":55793,"_2946":55983},[],"Relative path",{"_3461":2203,"_30106":2132,"_20907":55985,"_5":14363,"_27392":55793,"_2946":52360},[],{"_3461":2204,"_30106":2132,"_20907":55987,"_5":14363,"_27392":55793,"_2946":55988},[],"`GET`",{"_3461":2205,"_30106":2132,"_20907":55990,"_5":14363,"_27392":55793,"_2946":55991},[],"`/v1/crl-settings`",{"_3461":2206,"_30106":2132,"_20907":55993,"_5":14363,"_27392":55793,"_2946":55994},[],"List the CRL settings; filterable at least by `ca_id`, `status` and `legacy_ski`.",{"_3461":2207,"_30106":2132,"_20907":55996,"_5":14363,"_27392":55793,"_2946":55988},[],{"_3461":2208,"_30106":2132,"_20907":55998,"_5":14363,"_27392":55793,"_2946":55999},[],"`/v1/crl-settings/{ca-id}`",{"_3461":2209,"_30106":2132,"_20907":56001,"_5":14363,"_27392":55793,"_2946":56002},[],"Read the `crl_options` and `latest_crl` of a CA.",{"_3461":2210,"_30106":2132,"_20907":56004,"_5":14363,"_27392":55793,"_2946":56005},[],"`PUT`",{"_3461":2211,"_30106":2132,"_20907":56007,"_5":14363,"_27392":55793,"_2946":55999},[],{"_3461":2212,"_30106":2132,"_20907":56009,"_5":14363,"_27392":55793,"_2946":56010},[],"Replace the CRL configuration of a CA.",{"_3461":2213,"_30106":2132,"_20907":56012,"_5":14363,"_27392":55793,"_2946":56013},[],"You need authentication and CRL settings read or update permissions. Consult your installation’s API reference and Access control. Read current configuration before updating and send the full object expected by the contract — `refresh_interval`, `validity`, `signer_serial_number` and `regenerate_on_revoke`: the backend replaces all four; it does not merge omitted fields. `status`, `legacy_ski` and `latest_crl` are read-only. A `PUT` returns 409 when the settings are not `ACTIVE`, validates the signer only when it changes, and does not regenerate the CRL.",{"_3461":2214,"_30106":2132,"_20907":56015,"_5":14363,"_27392":55793,"_2946":56016},[],"After a change, check saved configuration and the next list actually published. Updating the settings alone does not establish regeneration or client acceptance.",{"_3461":2215,"_30106":2132,"_20907":56018,"_5":14363,"_27392":55797,"_2946":56019},[],"Symptom",{"_3461":2216,"_30106":2132,"_20907":56021,"_5":14363,"_27392":55797,"_2946":56022},[],"Cause",{"_3461":2217,"_30106":2132,"_20907":56024,"_5":14363,"_27392":55797,"_2946":56025},[],"Action",{"_3461":2218,"_30106":2132,"_20907":56027,"_5":14363,"_27392":55797,"_2946":56028},[],"`PUT /v1/crl-settings/{ca-id}` returns 409.",{"_3461":2219,"_30106":2132,"_20907":56030,"_5":14363,"_27392":55797,"_2946":56031},[],"The settings are not `ACTIVE`: the migration archived them because their CA was deleted before the upgrade.",{"_3461":2220,"_30106":2132,"_20907":56033,"_5":14363,"_27392":55797,"_2946":56034},[],"There is no API way back to `ACTIVE`. The last CRL keeps being served.",{"_3461":2221,"_30106":2132,"_20907":56036,"_5":14363,"_27392":55797,"_2946":56037},[],"`PUT` returns 400.",{"_3461":2222,"_30106":2132,"_20907":56039,"_5":14363,"_27392":55797,"_2946":56040},[],"The new signer lacks `cRLSign`, or its subject and public key do not match the CA.",{"_3461":2223,"_30106":2132,"_20907":56042,"_5":14363,"_27392":55797,"_2946":56043},[],"Set the serial number of a valid certificate of that CA.",{"_3461":2224,"_30106":2132,"_20907":56045,"_5":14363,"_27392":55797,"_2946":56046},[],"`PUT` returns 404.",{"_3461":2225,"_30106":2132,"_20907":56048,"_5":14363,"_27392":55797,"_2946":56049},[],"The CA or the new signer certificate does not exist (for example, the CA was deleted), or the CA has no CRL settings (for example, an imported CA).",{"_3461":2226,"_30106":2132,"_20907":56051,"_5":14363,"_27392":55797,"_2946":56052},[],"Check the CA ID and the signer serial number.",{"_3461":2227,"_30106":2132,"_20907":56054,"_5":14363,"_27392":55797,"_2946":56055},[],"`PUT` returns 400 from a 3.x client.",{"_3461":2228,"_30106":2132,"_20907":56057,"_5":14363,"_27392":55797,"_2946":56058},[],"`crl_options.subject_key_id_signer` was replaced by `crl_options.signer_serial_number`, which is required.",{"_3461":2229,"_30106":2132,"_20907":56060,"_5":14363,"_27392":55797,"_2946":56061},[],"Update the client to send the new field.",{"_3461":2230,"_30106":2132,"_20907":56063,"_5":14363,"_27392":55797,"_2946":56064},[],"The CRL does not change after revoking a certificate.",{"_3461":2231,"_30106":2132,"_20907":56066,"_5":14363,"_27392":55797,"_2946":56067},[],"`regenerate_on_revoke` is `false`, the issuing CA has no CRL settings, or generation failed because of an invalid signer.",{"_3461":2232,"_30106":2132,"_20907":56069,"_5":14363,"_27392":55797,"_2946":56070},[],"Check the VA logs. Missing settings only produce a warning (no retry, no failed-events entry); an invalid signer also leaves the event in the failed-events queue, so fix the signer.",{"_3461":2233,"_30106":2132,"_20907":56072,"_5":14363,"_27392":55797,"_2946":56073},[],"A verifier rejects the CRL because of the issuer.",{"_3461":2234,"_30106":2132,"_20907":56075,"_5":14363,"_27392":55797,"_2946":56076},[],"The list was fetched through a legacy `/crl/<ski>` URL and belongs to the CA that owned that SKI when the upgrade ran.",{"_3461":2235,"_30106":2132,"_20907":56078,"_5":14363,"_27392":55797,"_2946":56079},[],"Use the CDP of the certificate being validated: certificates issued in 4.0.0 carry `/crl/<ca-id>` URLs.",{"_3461":2236,"_30106":2132,"_20907":56081,"_5":14363,"_27392":55801,"_2946":56082},[],"The CA view lets you inspect and download the available list. Compare version, issuer and timestamps with the copy downloaded from the public endpoint. The CA’s VA settings also let you select the CRL signer: the certificate picker only offers certificates that have a private key and carry the `cRLSign` key usage. If a configured signer’s certificate cannot be resolved, the interface shows `Unknown Certificate (Serial: X)` or `Certificate details unavailable (Serial: X)`. Diagnose differences using PKI troubleshooting.",{"_3461":2237,"_30106":2132,"_20907":56084,"_5":14363,"_27392":55805,"_2946":56085},[],"RFC 5280: X.509 and CRL profile.",{"_3461":2238,"_30106":2132,"_20907":56087,"_5":14363,"_27392":55805,"_2946":56088},[],"OpenSSL: openssl-crl.",{"_3461":2239,"_30106":2132,"_20907":56090,"_5":14363,"_27392":55805,"_2946":56091},[],"OpenSSL: openssl-verify.",{"_3461":2240,"_30106":2132,"_20907":56093,"_5":14363,"_27392":55805,"_2946":56094},[],"<Card title=\"OCSP service\" href=\"/docs/platform/pki/ocsp\" />",{"_3461":2241,"_30106":2132,"_20907":56096,"_5":14363,"_27392":55805,"_2946":56097},[],"<Card title=\"Certificate validation\" href=\"/docs/platform/pki/certificate-validation\" />",{"_3461":2242,"_30106":2242,"_5":14715,"_2946":56099,"_30438":56100,"_20907":56101,"_27392":2242},"Keys and cryptographic engines",[49125,50593,54598,54599],[],{"_3461":2243,"_30106":2242,"_20907":56103,"_5":14363,"_27392":2242,"_2946":56104},[],"Generate, import and operate keys without coupling the PKI to a specific provider.",{"_3461":2244,"_30106":2242,"_5":30435,"_20907":56106,"_27392":56107,"_2946":56108},[],"/docs/platform/pki/key-management#what-the-kms-solves","What the KMS solves",{"_3461":2245,"_30106":2242,"_5":30435,"_20907":56110,"_27392":56111,"_2946":56112},[],"/docs/platform/pki/key-management#cryptographic-engines","Cryptographic engines",{"_3461":2246,"_30106":2242,"_5":30435,"_20907":56114,"_27392":56115,"_2946":56116},[],"/docs/platform/pki/key-management#file-system","File System",{"_3461":2247,"_30106":2242,"_5":30435,"_20907":56118,"_27392":56119,"_2946":56120},[],"/docs/platform/pki/key-management#hashicorp-vault","HashiCorp Vault",{"_3461":2248,"_30106":2242,"_5":30435,"_20907":56122,"_27392":56123,"_2946":56124},[],"/docs/platform/pki/key-management#aws-secrets-manager","AWS Secrets Manager",{"_3461":2249,"_30106":2242,"_5":30435,"_20907":56126,"_27392":56127,"_2946":56128},[],"/docs/platform/pki/key-management#aws-kms","AWS KMS",{"_3461":2250,"_30106":2242,"_5":30435,"_20907":56130,"_27392":56131,"_2946":56132},[],"/docs/platform/pki/key-management#pkcs11","PKCS#11",{"_3461":2251,"_30106":2242,"_5":30435,"_20907":56134,"_27392":56135,"_2946":56136},[],"/docs/platform/pki/key-management#azure-key-vault","Azure Key Vault",{"_3461":2252,"_30106":2242,"_5":30435,"_20907":56138,"_27392":56139,"_2946":56140},[],"/docs/platform/pki/key-management#key-inventory","Key inventory",{"_3461":2253,"_30106":2242,"_5":30435,"_20907":56142,"_27392":56143,"_2946":56144},[],"/docs/platform/pki/key-management#create-or-import-keys","Create or import keys",{"_3461":2254,"_30106":2242,"_5":30435,"_20907":56146,"_27392":56147,"_2946":56148},[],"/docs/platform/pki/key-management#generate-a-new-key-pair","Generate a new key pair",{"_3461":2255,"_30106":2242,"_5":30435,"_20907":56150,"_27392":56151,"_2946":56152},[],"/docs/platform/pki/key-management#import-an-existing-pair","Import an existing pair",{"_3461":2256,"_30106":2242,"_5":30435,"_20907":56154,"_27392":56155,"_2946":56156},[],"/docs/platform/pki/key-management#operations-on-a-key","Operations on a key",{"_3461":2257,"_30106":2242,"_5":30435,"_20907":56158,"_27392":56159,"_2946":56160},[],"/docs/platform/pki/key-management#view-details","View details",{"_3461":2258,"_30106":2242,"_5":30435,"_20907":56162,"_27392":56163,"_2946":56164},[],"/docs/platform/pki/key-management#sign-and-verify","Sign and verify",{"_3461":2259,"_30106":2242,"_5":30435,"_20907":56166,"_27392":56167,"_2946":56168},[],"/docs/platform/pki/key-management#sign","Sign",{"_3461":2260,"_30106":2242,"_5":30435,"_20907":56170,"_27392":56171,"_2946":56172},[],"/docs/platform/pki/key-management#verify","Verify",{"_3461":2261,"_30106":2242,"_5":30435,"_20907":56174,"_27392":56175,"_2946":56176},[],"/docs/platform/pki/key-management#generate-a-csr","Generate a CSR",{"_3461":2262,"_30106":2242,"_5":30435,"_20907":56178,"_27392":56179,"_2946":56180},[],"/docs/platform/pki/key-management#sign-locally-with-pkcs11","Sign locally with PKCS#11",{"_3461":2263,"_30106":2242,"_5":30435,"_20907":56182,"_27392":56183,"_2946":56184},[],"/docs/platform/pki/key-management#before-deleting-a-key","Before deleting a key",{"_3461":2264,"_30106":2242,"_20907":56186,"_5":14363,"_27392":2242,"_2946":56187},[],"The Cryptographic Key Management Service (KMS) of Lamassu IoT centralizes the generation, import, custody and use of the platform's keys. This is where you manage the keys that support the CAs and the rest of the signing operations that depend on the PKI.",{"_3461":2265,"_30106":2242,"_20907":56189,"_5":14363,"_27392":2242,"_2946":56190},[],"In the current configuration, Lamassu IoT works exclusively with asymmetric keys, such as RSA and elliptic curves. These keys are used to issue X.509 certificates, sign requests and perform authentication and validation operations within the system.",{"_3461":2266,"_30106":2242,"_20907":56192,"_5":14363,"_27392":56107,"_2946":56193},[],"The KMS unifies key lifecycle management and prevents every service from having to integrate directly with a specific cryptographic provider.",{"_3461":2267,"_30106":2242,"_20907":56195,"_5":14363,"_27392":56107,"_2946":56196},[],"In practice, it lets you:",{"_3461":2268,"_30106":2242,"_20907":56198,"_5":14363,"_27392":56107,"_2946":56199},[],"Generate new key pairs from Lamassu IoT.",{"_3461":2269,"_30106":2242,"_20907":56201,"_5":14363,"_27392":56107,"_2946":56202},[],"Import keys created externally.",{"_3461":2270,"_30106":2242,"_20907":56204,"_5":14363,"_27392":56107,"_2946":56205},[],"Delegate custody and cryptographic operations to external engines.",{"_3461":2271,"_30106":2242,"_20907":56207,"_5":14363,"_27392":56107,"_2946":56208},[],"Reuse existing keys for CAs, CSRs and signing or verification tasks.",{"_3461":2272,"_30106":2242,"_20907":56210,"_5":14363,"_27392":56111,"_2946":56211},[],"Lamassu can work with different cryptographic engines depending on deployment requirements. In some environments a software engine is enough; in others custody must be delegated to an HSM, a cloud service or a specialized platform.",{"_3461":2273,"_30106":2242,"_20907":56213,"_5":14363,"_27392":56111,"_2946":56214},[],"A single instance can have several engines configured at the same time, including multiple instances of the same type. This lets you adapt operations to different security, cost and regulatory requirements.",{"_3461":2274,"_30106":2242,"_20907":56216,"_5":14363,"_27392":56111,"_2946":56217},[],"This guide is for the PKI operator: select and use an already enabled engine. Installation, credentials, persistent storage and connectivity belong to Deployment. Before generating a CA, check the default engine, advertised algorithms and a test signature. Availability in your installation depends on its version and configuration.",{"_3461":2275,"_30106":2242,"_20907":56219,"_5":14363,"_27392":56115,"_2946":56220},[],"Generates software keys and stores private material in files. Custody depends on installation permissions, storage and backups. Before using it for an operational CA, agree how the key will be recovered and how replicas will access it; the KMS record does not replace those files.",{"_3461":2276,"_30106":2242,"_20907":56222,"_5":14363,"_27392":56119,"_2946":56223},[],"The adapter uses KV storage for private material. This is not signing within Vault Transit: someone able to read the secret can recover the key. Review read permissions, availability and recovery with the deployment owner.",{"_3461":2277,"_30106":2242,"_20907":56225,"_5":14363,"_27392":56119,"_2946":56226},[],"The adapter reaches Vault over its configured HTTP(S) endpoint. The Vault server certificate is verified against the system trust store; a Vault signed by a private CA is trusted by adding its CA certificate to the engine's `ca_cert_file` (PEM-encoded). `insecure_skip_verify=true` disables verification and is a last resort; agree the transport settings with the deployment owner.",{"_3461":2278,"_30106":2242,"_20907":56228,"_5":14363,"_27392":56123,"_2946":56229},[],"Offers encrypted persistence in AWS at a cost. It protects the key at rest, but an authorized administrator can recover it; it does not provide the same extraction resistance as a KMS or HSM.",{"_3461":2279,"_30106":2242,"_20907":56231,"_5":14363,"_27392":56127,"_2946":56232},[],"Delegates signing to AWS KMS. The adapter also implements external material import, subject to provider capabilities and permissions. A key generated outside the service has already existed outside its custody; importing it does not remove those copies. Check generation, import and signing as separate operations.",{"_3461":2280,"_30106":2242,"_20907":56234,"_5":14363,"_27392":56131,"_2946":56235},[],"Allows integrating local HSMs, isolated environments and *Key as a Service* offerings. Generation, persistence and extraction resistance depend on the specific device or provider. It is the most flexible option when policy requires hardware custody.",{"_3461":2281,"_30106":2242,"_20907":56237,"_5":14363,"_27392":56135,"_2946":56238},[],"The backend also provides adapters for **Key Vault Keys** and **Key Vault Secrets**. The former delegates signing to the key service; the latter stores private material as secrets and signs using that material. These are different custody models. Confirm which adapter is enabled in your installation and test the required operations.",{"_3461":2282,"_30106":2242,"_20907":56240,"_5":14363,"_27392":56135,"_2946":56241},[],"Lamassu shows the enabled engines in the console.",{"_3461":2283,"_30106":2242,"_20907":56243,"_5":14363,"_27392":56135,"_2946":56244},[],"Each engine defines which algorithms it supports, such as RSA or ECC/ECDSA, and which key sizes it can generate.",{"_3461":2284,"_30106":2242,"_20907":56246,"_5":14363,"_27392":56135,"_2946":56247},[],"Confirm with the deployment operator which engine is configured as the default. That engine will be used when a process needs to create or persist a key and the user has not selected a specific one, for example when creating or importing a CA.",{"_3461":2285,"_30106":2242,"_20907":56249,"_5":14363,"_27392":56139,"_2946":56250},[],"The main KMS screen shows the complete inventory of keys registered in the system. It is the reference view for reviewing which keys exist, where they are kept and which entities they relate to.",{"_3461":2286,"_30106":2242,"_20907":56252,"_5":14363,"_27392":56139,"_2946":56253},[],"The table includes the following fields:",{"_3461":2287,"_30106":2242,"_20907":56255,"_5":14363,"_27392":56139,"_2946":56256},[],"**Name**: descriptive name of the key.",{"_3461":2288,"_30106":2242,"_20907":56258,"_5":14363,"_27392":56139,"_2946":56259},[],"**Type**: algorithm and key size, for example RSA 2048 or EC P-256.",{"_3461":2289,"_30106":2242,"_20907":56261,"_5":14363,"_27392":56139,"_2946":56262},[],"**Strength**: visual indicator of cryptographic strength.",{"_3461":2290,"_30106":2242,"_20907":56264,"_5":14363,"_27392":56139,"_2946":56265},[],"**Public/Private**: whether Lamassu manages the full pair or only the public key.",{"_3461":2291,"_30106":2242,"_20907":56267,"_5":14363,"_27392":56139,"_2946":56268},[],"**Crypto Engine**: cryptographic engine keeping the key.",{"_3461":2292,"_30106":2242,"_20907":56270,"_5":14363,"_27392":56139,"_2946":56271},[],"**Aliases**: alternative names associated with the key.",{"_3461":2293,"_30106":2242,"_20907":56273,"_5":14363,"_27392":56139,"_2946":56274},[],"**Tags**: labels for classification and search.",{"_3461":2294,"_30106":2242,"_20907":56276,"_5":14363,"_27392":56139,"_2946":56277},[],"**Related Entities**: certificates or other entities linked to that key.",{"_3461":2295,"_30106":2242,"_20907":56279,"_5":14363,"_27392":56139,"_2946":56280},[],"From this view you also reach the most common actions:",{"_3461":2296,"_30106":2242,"_20907":56282,"_5":14363,"_27392":56139,"_2946":56283},[],"**View Details** to inspect metadata, identifiers and relationships.",{"_3461":2297,"_30106":2242,"_20907":56285,"_5":14363,"_27392":56139,"_2946":56286},[],"**Generate CSR** to create a PKCS#10 request with the selected key.",{"_3461":2298,"_30106":2242,"_20907":56288,"_5":14363,"_27392":56139,"_2946":56289},[],"**Sign / Verify** to test cryptographic operations on the key.",{"_3461":2299,"_30106":2242,"_20907":56291,"_5":14363,"_27392":56139,"_2946":56292},[],"**Delete Key** to remove the key from the system.",{"_3461":2300,"_30106":2242,"_20907":56294,"_5":14363,"_27392":56143,"_2946":56295},[],"You need key administration permissions and a reachable engine. The issuance profile must allow the chosen algorithm if the key will be used in a CA or CSR. Open **Create New Key** and choose generation or import.",{"_3461":2301,"_30106":2242,"_20907":56297,"_5":14363,"_27392":56147,"_2946":56298},[],"If the key will be born inside Lamassu, the recommended flow is to generate a new pair managed directly by one of the configured engines.",{"_3461":2302,"_30106":2242,"_20907":56300,"_5":14363,"_27392":56147,"_2946":56301},[],"On the wizard's first screen, choose **Generate New Key Pair** and then define the main parameters:",{"_3461":2303,"_30106":2242,"_20907":56303,"_5":14363,"_27392":56147,"_2946":56304},[],"**Key Name**: unique and descriptive name.",{"_3461":2304,"_30106":2242,"_20907":56306,"_5":14363,"_27392":56147,"_2946":56307},[],"**Crypto Engine**: engine that will keep the key.",{"_3461":2305,"_30106":2242,"_20907":56309,"_5":14363,"_27392":56147,"_2946":56310},[],"**Key Type** and **Key Size**: algorithm and size or curve.",{"_3461":2306,"_30106":2242,"_20907":56312,"_5":14363,"_27392":56147,"_2946":56313},[],"**Tags**: metadata to classify the key.",{"_3461":2307,"_30106":2242,"_20907":56315,"_5":14363,"_27392":56147,"_2946":56316},[],"**Metadata**: additional information for advanced uses.",{"_3461":2308,"_30106":2242,"_20907":56318,"_5":14363,"_27392":56151,"_2946":56319},[],"Importing lets you register in Lamassu a key generated outside the platform. It is the usual flow in BYOK scenarios, migrations or integration with cryptographic material already in production.",{"_3461":2309,"_30106":2242,"_20907":56321,"_5":14363,"_27392":56151,"_2946":56322},[],"When you have an exportable private key and the destination engine supports import.",{"_3461":2310,"_30106":2242,"_20907":56324,"_5":14363,"_27392":56151,"_2946":56325},[],"When an existing PKI needs to be migrated without reissuing certificates.",{"_3461":2311,"_30106":2242,"_20907":56327,"_5":14363,"_27392":56151,"_2946":56328},[],"When Lamassu must operate with a root of trust created by a third party.",{"_3461":2312,"_30106":2242,"_20907":56330,"_5":14363,"_27392":56151,"_2946":56331},[],"In the wizard, choose **Import Existing Key Pair** and complete the requested fields:",{"_3461":2313,"_30106":2242,"_20907":56333,"_5":14363,"_27392":56151,"_2946":56334},[],"**Key Name**: descriptive name within Lamassu IoT.",{"_3461":2314,"_30106":2242,"_20907":56336,"_5":14363,"_27392":56151,"_2946":56337},[],"**Crypto Engine**: engine that will keep the imported key.",{"_3461":2315,"_30106":2242,"_20907":56339,"_5":14363,"_27392":56151,"_2946":56340},[],"**Tags**: labels for organization and search.",{"_3461":2316,"_30106":2242,"_20907":56342,"_5":14363,"_27392":56151,"_2946":56343},[],"**Metadata**: additional optional information.",{"_3461":2317,"_30106":2242,"_20907":56345,"_5":14363,"_27392":56151,"_2946":56346},[],"**Private Key (PEM)**: private key in PEM format.",{"_3461":2318,"_30106":2242,"_20907":56348,"_5":14363,"_27392":56151,"_2946":56349},[],"After a successful import, open the record, check the engine and public key, and perform a test signature. A non-exportable HSM key cannot be uploaded through this PEM form: configure engine access and check how the existing key is registered. Review dependencies and any provider resources already created if an operation fails partway through.",{"_3461":2319,"_30106":2242,"_20907":56351,"_5":14363,"_27392":56155,"_2946":56352},[],"Each registered key has a detail view and several operational actions.",{"_3461":2320,"_30106":2242,"_20907":56354,"_5":14363,"_27392":56159,"_2946":56355},[],"The **View Details** screen concentrates the technical and administrative information of the key.",{"_3461":2321,"_30106":2242,"_20907":56357,"_5":14363,"_27392":56159,"_2946":56358},[],"The **Overview** tab shows, among others, these fields:",{"_3461":2322,"_30106":2242,"_20907":56360,"_5":14363,"_27392":56159,"_2946":56361},[],"**Key Name**: descriptive name.",{"_3461":2323,"_30106":2242,"_20907":56363,"_5":14363,"_27392":56159,"_2946":56364},[],"**Key Identifier**: unique system identifier. Lamassu uses PKCS11-based ID formats.",{"_3461":2324,"_30106":2242,"_20907":56366,"_5":14363,"_27392":56159,"_2946":56367},[],"**Tags**: associated labels.",{"_3461":2325,"_30106":2242,"_20907":56369,"_5":14363,"_27392":56159,"_2946":56370},[],"**Aliases**: alternative names.",{"_3461":2326,"_30106":2242,"_20907":56372,"_5":14363,"_27392":56159,"_2946":56373},[],"**Crypto Engine**: engine where the key resides.",{"_3461":2327,"_30106":2242,"_20907":56375,"_5":14363,"_27392":56159,"_2946":56376},[],"**Algorithm, Key Size & Strength**: algorithm, parameters and strength level.",{"_3461":2328,"_30106":2242,"_20907":56378,"_5":14363,"_27392":56159,"_2946":56379},[],"The **Related Entities** section shows which Lamassu objects depend on that key.",{"_3461":2329,"_30106":2242,"_20907":56381,"_5":14363,"_27392":56159,"_2946":56382},[],"The **Public Key** tab shows public material in PEM. The record’s identifier and URI locate the key; a PKCS#11-formatted URI does not establish that the engine is an HSM or that a local module can access it.",{"_3461":2330,"_30106":2242,"_20907":56384,"_5":14363,"_27392":56163,"_2946":56385},[],"The **Sign / Verify** action validates that the key and the cryptographic engine work correctly.",{"_3461":2331,"_30106":2242,"_20907":56387,"_5":14363,"_27392":56163,"_2946":56388},[],"Sign a test message, save the signature and verify it using the same public key, algorithm and encoding. Then change the message: verification should fail. This tests one operation; it does not establish every engine capability or a CA’s chain.",{"_3461":2332,"_30106":2242,"_20907":56390,"_5":14363,"_27392":56163,"_2946":56391},[],"When you open it, two areas appear: **Sign** and **Verify**.",{"_3461":2333,"_30106":2242,"_20907":56393,"_5":14363,"_27392":56167,"_2946":56394},[],"This tab uses the private key to generate a digital signature over a message or an already computed *digest*.",{"_3461":2334,"_30106":2242,"_20907":56396,"_5":14363,"_27392":56167,"_2946":56397},[],"Main fields:",{"_3461":2335,"_30106":2242,"_20907":56399,"_5":14363,"_27392":56167,"_2946":56400},[],"**Algorithm**: signing algorithm available for the key type.",{"_3461":2336,"_30106":2242,"_20907":56402,"_5":14363,"_27392":56167,"_2946":56403},[],"**Message Type**: `Raw` for clear data or `Digest` for a precomputed hash.",{"_3461":2337,"_30106":2242,"_20907":56405,"_5":14363,"_27392":56167,"_2946":56406},[],"**Payload Encoding**: input encoding, such as UTF-8, Hex or Base64.",{"_3461":2338,"_30106":2242,"_20907":56408,"_5":14363,"_27392":56167,"_2946":56409},[],"**Message**: content to sign.",{"_3461":2339,"_30106":2242,"_20907":56411,"_5":14363,"_27392":56167,"_2946":56412},[],"**Signature**: result of the operation, shown in hexadecimal.",{"_3461":2340,"_30106":2242,"_20907":56414,"_5":14363,"_27392":56171,"_2946":56415},[],"This tab checks whether a signature corresponds to the associated public key.",{"_3461":2341,"_30106":2242,"_20907":56417,"_5":14363,"_27392":56171,"_2946":56397},[],{"_3461":2342,"_30106":2242,"_20907":56419,"_5":14363,"_27392":56171,"_2946":56420},[],"**Algorithm**: must match the algorithm used for the signature.",{"_3461":2343,"_30106":2242,"_20907":56422,"_5":14363,"_27392":56171,"_2946":56423},[],"**Message Type**: `Raw` or `Digest`.",{"_3461":2344,"_30106":2242,"_20907":56425,"_5":14363,"_27392":56171,"_2946":56426},[],"**Payload Encoding**: encoding of the message.",{"_3461":2345,"_30106":2242,"_20907":56428,"_5":14363,"_27392":56171,"_2946":56429},[],"**Message**: original message or hash.",{"_3461":2346,"_30106":2242,"_20907":56431,"_5":14363,"_27392":56171,"_2946":56432},[],"**Signature**: signature to check.",{"_3461":2347,"_30106":2242,"_20907":56434,"_5":14363,"_27392":56171,"_2946":56435},[],"**Result**: indicator of the validation result.",{"_3461":2348,"_30106":2242,"_20907":56437,"_5":14363,"_27392":56175,"_2946":56438},[],"The **Generate CSR** action creates a PKCS#10 request signed with the private key kept in Lamassu, without exposing it outside the cryptographic engine.",{"_3461":2349,"_30106":2242,"_20907":56440,"_5":14363,"_27392":56175,"_2946":56441},[],"This flow is useful for:",{"_3461":2350,"_30106":2242,"_20907":56443,"_5":14363,"_27392":56175,"_2946":56444},[],"Requesting certificates from an external CA.",{"_3461":2351,"_30106":2242,"_20907":56446,"_5":14363,"_27392":56175,"_2946":56447},[],"Renewing an identity while keeping the same key.",{"_3461":2352,"_30106":2242,"_20907":56449,"_5":14363,"_27392":56175,"_2946":56450},[],"When you open the form, it asks for the subject data and the main certificate attributes:",{"_3461":2353,"_30106":2242,"_20907":56452,"_5":14363,"_27392":56175,"_2946":56453},[],"**Common Name (CN)**: main name of the identity.",{"_3461":2354,"_30106":2242,"_20907":56455,"_5":14363,"_27392":56175,"_2946":56456},[],"**Organization (O)**: organization or company.",{"_3461":2355,"_30106":2242,"_20907":56458,"_5":14363,"_27392":56175,"_2946":56459},[],"**Organizational Unit (OU)**: department or unit.",{"_3461":2356,"_30106":2242,"_20907":56461,"_5":14363,"_27392":56175,"_2946":56462},[],"**Country (C)**: two-letter country code.",{"_3461":2357,"_30106":2242,"_20907":56464,"_5":14363,"_27392":56175,"_2946":56465},[],"**State / Province (ST)**: state or province.",{"_3461":2358,"_30106":2242,"_20907":56467,"_5":14363,"_27392":56175,"_2946":56468},[],"**Locality (L)**: city or locality.",{"_3461":2359,"_30106":2242,"_20907":56470,"_5":14363,"_27392":56175,"_2946":56471},[],"**Email Address**: contact email.",{"_3461":2360,"_30106":2242,"_20907":56473,"_5":14363,"_27392":56175,"_2946":56474},[],"**Subject Alternative Names (SANs)**: alternative names or identifiers, such as DNS or IP.",{"_3461":2361,"_30106":2242,"_20907":56476,"_5":14363,"_27392":56175,"_2946":56477},[],"Download the CSR and run `openssl req -in request.csr -noout -verify -text`. Check signature, subject and SAN before sending it. A CSR does not determine the final certificate by itself: issuance policy can replace its fields.",{"_3461":2362,"_30106":2242,"_20907":56479,"_5":14363,"_27392":56179,"_2946":56480},[],"Lamassu also offers specific help for local integrations through **Sign locally with OpenSSL & PKCS11 tools**.",{"_3461":2363,"_30106":2242,"_20907":56482,"_5":14363,"_27392":56179,"_2946":56483},[],"It requires the module, token and permissions of the corresponding provider. Check that the Lamassu identifier matches the object accessible from that module. Module configuration belongs to the client environment or Deployment.",{"_3461":2364,"_30106":2242,"_20907":56485,"_5":14363,"_27392":56183,"_2946":56486},[],"Review **Related Entities** and locate CAs, certificates and validation processes that still need signatures. Revoking a CA does not remove the need to publish status during its retention period. Deleting a key does not automatically revoke its certificates either. Plan replacement and retention before using **Delete Key**; provider deletion behavior depends on the engine.",{"_3461":2365,"_30106":2242,"_20907":56488,"_5":14363,"_27392":56183,"_2946":56489},[],"The KMS refuses to delete a key that certificates still reference, with `409` `key is in use`. Revoking a certificate or letting it expire does not release its key reference. Deleting a CA releases the references from its own current certificate and linked reissued certificates, which stay in place to back the CRL and OCSP, and then attempts to delete the key. If other certificates still reference the key, such as another CA sharing it, the KMS keeps it. The certificates the CA issued keep their own key references, even when revoked. The API lets you delete such a certificate only once its issuer CA no longer exists, and deleting it removes it from the CRL and OCSP responses, so keep revoked certificates for their retention period and delete only expired or superseded ones. Legacy references retained by the upgrade migration are described in the upgrade guide.",{"_3461":2366,"_30106":2366,"_5":14715,"_2946":56491,"_30438":56492,"_20907":56493,"_27392":2366},"Online validation with OCSP",[49125,50593,54598,55237],[],{"_3461":2367,"_30106":2366,"_20907":56495,"_5":14363,"_27392":2366,"_2946":56496},[],"Query signed status and verify the responder’s response.",{"_3461":2368,"_30106":2366,"_5":30435,"_20907":56498,"_27392":56499,"_2946":56500},[],"/docs/platform/pki/ocsp#how-the-responder-works-in-lamassu","How the responder works in Lamassu",{"_3461":2369,"_30106":2366,"_5":30435,"_20907":56502,"_27392":56503,"_2946":56504},[],"/docs/platform/pki/ocsp#embedding-in-issued-certificates","Embedding in issued certificates",{"_3461":2370,"_30106":2366,"_5":30435,"_20907":56506,"_27392":56507,"_2946":56508},[],"/docs/platform/pki/ocsp#http-endpoints","HTTP endpoints",{"_3461":2371,"_30106":2366,"_5":30435,"_20907":56510,"_27392":56511,"_2946":56512},[],"/docs/platform/pki/ocsp#generate-and-verify-a-query","Generate and verify a query",{"_3461":2372,"_30106":2366,"_5":30435,"_20907":56514,"_27392":56515,"_2946":56516},[],"/docs/platform/pki/ocsp#check-from-the-interface","Check from the interface",{"_3461":2373,"_30106":2366,"_5":30435,"_20907":56518,"_27392":56519,"_2946":55806},[],"/docs/platform/pki/ocsp#references",{"_3461":2374,"_30106":2366,"_20907":56521,"_5":14363,"_27392":2366,"_2946":56522},[],"OCSP queries a certificate’s status and returns a signed response. This guide is for an integrator checking what Lamassu publishes and how the consumer must verify it. For complete identity validation, follow Certificate validation.",{"_3461":2375,"_30106":2366,"_20907":56524,"_5":14363,"_27392":56499,"_2946":56525},[],"The responder retrieves the certificate by serial number and locates its issuing CA in the inventory. It translates persisted status as follows:",{"_3461":2376,"_30106":2366,"_20907":56527,"_5":14363,"_27392":56499,"_2946":56528},[],"Record status",{"_3461":2377,"_30106":2366,"_20907":56530,"_5":14363,"_27392":56499,"_2946":56531},[],"Signed response",{"_3461":2378,"_30106":2366,"_20907":56533,"_5":14363,"_27392":56499,"_2946":53735},[],{"_3461":2379,"_30106":2366,"_20907":56535,"_5":14363,"_27392":56499,"_2946":56536},[],"`Good`.",{"_3461":2380,"_30106":2366,"_20907":56538,"_5":14363,"_27392":56499,"_2946":53752},[],{"_3461":2381,"_30106":2366,"_20907":56540,"_5":14363,"_27392":56499,"_2946":56541},[],"`Revoked`, with revocation reason and timestamp.",{"_3461":2382,"_30106":2366,"_20907":56543,"_5":14363,"_27392":56499,"_2946":56544},[],"Other states, including `INACTIVE` and `EXPIRED`",{"_3461":2383,"_30106":2366,"_20907":56546,"_5":14363,"_27392":56499,"_2946":56547},[],"`Unknown` if the certificate and issuer can be retrieved.",{"_3461":2384,"_30106":2366,"_20907":56549,"_5":14363,"_27392":56499,"_2946":56550},[],"An absent serial number causes a lookup error; it does not guarantee a signed `Unknown` response. Lookup or signing errors produce an HTTP failure. Treat that as unavailable evidence according to consumer policy.",{"_3461":2385,"_30106":2366,"_20907":56552,"_5":14363,"_27392":56499,"_2946":56553},[],"The issuing CA itself signs the response through its KMS-associated key. A delegated OCSP signing certificate is not used. An imported CA without a usable key cannot sign responses.",{"_3461":2386,"_30106":2366,"_20907":56555,"_5":14363,"_27392":56499,"_2946":56556},[],"The implementation sets `thisUpdate` approximately one day before response generation and `nextUpdate` one day after: the declared window is about 48 hours. Inspect received values and apply your freshness policy. The response reflects stored status when queried; a previously cached copy does not change upon revocation.",{"_3461":2387,"_30106":2366,"_20907":56558,"_5":14363,"_27392":56503,"_2946":56559},[],"The signer constructs OCSP URLs from configured VA domains and adds them to AIA. Without domains, there is no URL to add; an imported certificate retains its original extensions. Inspect the actual certificate:",{"_3461":2388,"_30106":2366,"_20907":56561,"_5":14363,"_27392":56503,"_2946":56562},[],"Check that the consumer can reach this URL. DNS, endpoint exposure and domain configuration belong to Deployment. Changing configuration does not modify already signed certificates.",{"_3461":2389,"_30106":2366,"_20907":56564,"_5":14363,"_27392":56507,"_2946":56565},[],"The service accepts:",{"_3461":2390,"_30106":2366,"_20907":56567,"_5":14363,"_27392":56507,"_2946":52363},[],{"_3461":2391,"_30106":2366,"_20907":56569,"_5":14363,"_27392":56507,"_2946":56570},[],"VA service path",{"_3461":2392,"_30106":2366,"_20907":56572,"_5":14363,"_27392":56507,"_2946":56573},[],"Format",{"_3461":2393,"_30106":2366,"_20907":56575,"_5":14363,"_27392":56507,"_2946":56576},[],"`POST`",{"_3461":2394,"_30106":2366,"_20907":56578,"_5":14363,"_27392":56507,"_2946":56579},[],"`/ocsp`",{"_3461":2395,"_30106":2366,"_20907":56581,"_5":14363,"_27392":56507,"_2946":56582},[],"DER request, `Content-Type: application/ocsp-request`.",{"_3461":2396,"_30106":2366,"_20907":56584,"_5":14363,"_27392":56507,"_2946":55988},[],{"_3461":2397,"_30106":2366,"_20907":56586,"_5":14363,"_27392":56507,"_2946":56587},[],"`/ocsp/{ocsp_request}`",{"_3461":2398,"_30106":2366,"_20907":56589,"_5":14363,"_27392":56507,"_2946":56590},[],"DER request encoded using padded URL Base64.",{"_3461":2399,"_30106":2366,"_20907":56592,"_5":14363,"_27392":56507,"_2946":56593},[],"Use POST to avoid client encoding differences. A successful response has `Content-Type: application/ocsp-response` and a DER body. The public prefix depends on the Gateway; use the URL published in the certificate and checked by the operator.",{"_3461":2400,"_30106":2366,"_20907":56595,"_5":14363,"_27392":56511,"_2946":56596},[],"You need OpenSSL 3.x, `device.crt`, its direct issuer’s certificate `issuer.pem` and the consumer’s trusted roots in `roots.pem`. For an intermediate issuer, also prepare `intermediates.pem` containing the intermediate CAs.",{"_3461":2401,"_30106":2366,"_20907":56598,"_5":14363,"_27392":56511,"_2946":56599},[],"Generate the request:",{"_3461":2402,"_30106":2366,"_20907":56601,"_5":14363,"_27392":56511,"_2946":56602},[],"This example omits the nonce because the responder does not echo it. Verification relies on signature, response correspondence and timestamps; it does not demonstrate freshness through a nonce.",{"_3461":2403,"_30106":2366,"_20907":56604,"_5":14363,"_27392":56511,"_2946":56605},[],"Replace the example URL with the inspected endpoint:",{"_3461":2404,"_30106":2366,"_20907":56607,"_5":14363,"_27392":56511,"_2946":56608},[],"Verify the returned DER:",{"_3461":2405,"_30106":2366,"_20907":56610,"_5":14363,"_27392":56511,"_2946":56611},[],"For intermediates, add `-verify_other intermediates.pem`. Require successful response verification and inspect the status corresponding to `device.crt`, issuer, serial, `thisUpdate` and `nextUpdate`. `Response verify OK` validates the response only: also observe `good`, `revoked` or `unknown`. Do not accept an identity based only on the command’s exit code.",{"_3461":2406,"_30106":2366,"_20907":56613,"_5":14363,"_27392":56515,"_2946":56614},[],"**OCSP Check** shows what Lamassu returns for a selected certificate. Complete the check from the consumer’s network and trust store: a console query does not establish its validation configuration.",{"_3461":2407,"_30106":2366,"_20907":56616,"_5":14363,"_27392":56515,"_2946":56617},[],"To check a change, save an earlier response, revoke a test certificate and request another response. The new query should reflect persisted status; compare timestamps to rule out reuse of an earlier response. If it fails, follow PKI troubleshooting.",{"_3461":2408,"_30106":2366,"_20907":56619,"_5":14363,"_27392":56519,"_2946":56620},[],"RFC 6960: OCSP.",{"_3461":2409,"_30106":2366,"_20907":56622,"_5":14363,"_27392":56519,"_2946":56623},[],"OpenSSL: openssl-ocsp.",{"_3461":2410,"_30106":2366,"_20907":56625,"_5":14363,"_27392":56519,"_2946":56626},[],"<Card title=\"CRL service\" href=\"/docs/platform/pki/crl\" />",{"_3461":2411,"_30106":2366,"_20907":56628,"_5":14363,"_27392":56519,"_2946":56097},[],{"_3461":2412,"_30106":2412,"_5":14715,"_2946":54598,"_30438":56630,"_20907":56631,"_27392":2412},[49125,50593,54598],[],{"_3461":2413,"_30106":2412,"_20907":56633,"_5":14363,"_27392":2412,"_2946":56634},[],"Administer keys and authorities, define issuance and verify the resulting certificates.",{"_3461":2414,"_30106":2412,"_5":30435,"_20907":56636,"_27392":56637,"_2946":53910},[],"/docs/platform/pki/overview#start-here",{"_3461":2415,"_30106":2412,"_5":30435,"_20907":56639,"_27392":56640,"_2946":56641},[],"/docs/platform/pki/overview#what-you-need","What you need",{"_3461":2416,"_30106":2412,"_5":30435,"_20907":56643,"_27392":56644,"_2946":54442},[],"/docs/platform/pki/overview#core-capabilities",{"_3461":2417,"_30106":2412,"_5":30435,"_20907":56646,"_27392":56647,"_2946":54446},[],"/docs/platform/pki/overview#build-your-trust-hierarchy",{"_3461":2418,"_30106":2412,"_5":30435,"_20907":56649,"_27392":56650,"_2946":54450},[],"/docs/platform/pki/overview#protect-cryptographic-keys",{"_3461":2419,"_30106":2412,"_5":30435,"_20907":56652,"_27392":56653,"_2946":54454},[],"/docs/platform/pki/overview#issue-and-control-certificates",{"_3461":2420,"_30106":2412,"_5":30435,"_20907":56655,"_27392":56656,"_2946":54462},[],"/docs/platform/pki/overview#publish-validation-status",{"_3461":2421,"_30106":2412,"_5":30435,"_20907":56658,"_27392":56659,"_2946":56660},[],"/docs/platform/pki/overview#how-to-check-the-result","How to check the result",{"_3461":2422,"_30106":2412,"_5":30435,"_20907":56662,"_27392":56663,"_2946":55404},[],"/docs/platform/pki/overview#continue",{"_3461":2423,"_30106":2412,"_20907":56665,"_5":14363,"_27392":2412,"_2946":56666},[],"The PKI section explains how to build and operate X.509 trust in Lamassu: which authorities issue, which rules apply and how to check certificates. It is intended for PKI administrators and anyone who needs to use certificates in a consuming system.",{"_3461":2424,"_30106":2412,"_20907":56668,"_5":14363,"_27392":56637,"_2946":56669},[],"Follow PKI getting started to create a CA, issue a client certificate and verify it with OpenSSL. The result is a certificate, its private key and a verified chain.",{"_3461":2425,"_30106":2412,"_20907":56671,"_5":14363,"_27392":56637,"_2946":56672},[],"You can complete that path before managing devices. When you need to associate the identity with an inventory or automate its enrollment, continue in IoT Fleets.",{"_3461":2426,"_30106":2412,"_20907":56674,"_5":14363,"_27392":56640,"_2946":56675},[],"An accessible instance and permission to manage the keys, CAs and certificates you will use.",{"_3461":2427,"_30106":2412,"_20907":56677,"_5":14363,"_27392":56640,"_2946":56678},[],"An available cryptographic engine to keep the authority's key.",{"_3461":2428,"_30106":2412,"_20907":56680,"_5":14363,"_27392":56640,"_2946":56681},[],"The certificate's purpose, such as authenticating a client through mTLS.",{"_3461":2429,"_30106":2412,"_20907":56683,"_5":14363,"_27392":56640,"_2946":56684},[],"Consumer requirements: accepted issuers, algorithms, names and permitted usages.",{"_3461":2430,"_30106":2412,"_20907":56686,"_5":14363,"_27392":56640,"_2946":56687},[],"Prepare the instance and cryptographic provider in Deployment. The trust model explains hierarchy choices.",{"_3461":2431,"_30106":2412,"_20907":56689,"_5":14363,"_27392":56647,"_2946":56690},[],"Authorities sign certificates. A root establishes the trust anchor, and an intermediate separates issuance by environment or purpose. Hierarchy and rotation explains how to maintain trust when replacing an authority.",{"_3461":2432,"_30106":2412,"_20907":56692,"_5":14363,"_27392":56650,"_2946":56693},[],"CA signing keys are managed through KMS and cryptographic engines. A client that generates a CSR can keep its own key: preserve that custody when choosing the issuance method.",{"_3461":2433,"_30106":2412,"_20907":56695,"_5":14363,"_27392":56653,"_2946":56696},[],"A profile establishes subject, validity, usage and key restrictions. The CA applies issuance configuration and signs the certificate. In the inventory, you can inspect the result, download it and manage its status.",{"_3461":2434,"_30106":2412,"_20907":56698,"_5":14363,"_27392":56656,"_2946":56699},[],"Validation covers the chain, validity, usages and revocation status. Lamassu publishes status through OCSP and CRL; the consumer configures which issuers it recognizes and how it checks that status.",{"_3461":2435,"_30106":2412,"_20907":56701,"_5":14363,"_27392":56659,"_2946":56702},[],"An active certificate in the console is one part of the check. Also verify that:",{"_3461":2436,"_30106":2412,"_20907":56704,"_5":14363,"_27392":56659,"_2946":56705},[],"its subject and extensions identify the expected client;",{"_3461":2437,"_30106":2412,"_20907":56707,"_5":14363,"_27392":56659,"_2946":56708},[],"its public key matches the client's private key;",{"_3461":2438,"_30106":2412,"_20907":56710,"_5":14363,"_27392":56659,"_2946":56711},[],"its chain reaches a root trusted by the consumer;",{"_3461":2439,"_30106":2412,"_20907":56713,"_5":14363,"_27392":56659,"_2946":56714},[],"its dates and usages allow the operation;",{"_3461":2440,"_30106":2412,"_20907":56716,"_5":14363,"_27392":56659,"_2946":56717},[],"the consumer applies revocation checks and authorization.",{"_3461":2441,"_30106":2412,"_20907":56719,"_5":14363,"_27392":56659,"_2946":56720},[],"The issuance path includes the first independent checks.",{"_3461":2442,"_30106":2412,"_20907":56722,"_5":14363,"_27392":56663,"_2946":56723},[],"<Card title=\"PKI getting started\" description=\"Create a CA, then issue and verify a client certificate.\" href=\"/docs/platform/pki/quickstarts/overview\" />",{"_3461":2443,"_30106":2412,"_20907":56725,"_5":14363,"_27392":56663,"_2946":56726},[],"<Card title=\"Apply PKI to devices\" description=\"Associate certificates with inventory and prepare enrollment.\" href=\"/docs/platform/iot-fleets/overview\" />",{"_3461":2444,"_30106":2412,"_20907":56728,"_5":14363,"_27392":56663,"_2946":56729},[],"<Card title=\"PKI diagnostics\" description=\"Check issuance, OCSP and CRL when the result fails.\" href=\"/docs/platform/pki/troubleshooting\" />",{"_3461":2445,"_30106":2445,"_5":14715,"_2946":56731,"_30438":56732,"_20907":56733,"_27392":2445},"Create your first CA",[49125,50593,54598,54035],[],{"_3461":2446,"_30106":2445,"_20907":56735,"_5":14363,"_27392":2445,"_2946":56736},[],"Create an evaluation root and check its certificate before issuing.",{"_3461":2447,"_30106":2445,"_5":30435,"_20907":56738,"_27392":56739,"_2946":49135},[],"/docs/platform/pki/quickstarts/create-certificate-authority#before-you-begin",{"_3461":2448,"_30106":2445,"_5":30435,"_20907":56741,"_27392":56742,"_2946":56743},[],"/docs/platform/pki/quickstarts/create-certificate-authority#open-the-creation-wizard-toc","Open the creation wizard [!toc]",{"_3461":2449,"_30106":2445,"_5":30435,"_20907":56745,"_27392":56746,"_2946":56747},[],"/docs/platform/pki/quickstarts/create-certificate-authority#select-the-key-toc","Select the key [!toc]",{"_3461":2450,"_30106":2445,"_5":30435,"_20907":56749,"_27392":56750,"_2946":56751},[],"/docs/platform/pki/quickstarts/create-certificate-authority#define-the-authority-toc","Define the authority [!toc]",{"_3461":2451,"_30106":2445,"_5":30435,"_20907":56753,"_27392":56754,"_2946":56755},[],"/docs/platform/pki/quickstarts/create-certificate-authority#review-and-create-the-ca-toc","Review and create the CA [!toc]",{"_3461":2452,"_30106":2445,"_5":30435,"_20907":56757,"_27392":56758,"_2946":56759},[],"/docs/platform/pki/quickstarts/create-certificate-authority#verify-the-result-toc","Verify the result [!toc]",{"_3461":2453,"_30106":2445,"_5":30435,"_20907":56761,"_27392":56762,"_2946":56763},[],"/docs/platform/pki/quickstarts/create-certificate-authority#check-the-ca-certificate","Check the CA certificate",{"_3461":2454,"_30106":2445,"_5":30435,"_20907":56765,"_27392":56766,"_2946":54292},[],"/docs/platform/pki/quickstarts/create-certificate-authority#if-the-result-fails",{"_3461":2455,"_30106":2445,"_5":30435,"_20907":56768,"_27392":56769,"_2946":49159},[],"/docs/platform/pki/quickstarts/create-certificate-authority#next-step",{"_3461":2456,"_30106":2445,"_20907":56771,"_5":14363,"_27392":2445,"_2946":56772},[],"You will create a root authority with a new key kept by a Lamassu engine. The result is an active CA and its public certificate in `ca.pem`, ready to verify issuance in the next path.",{"_3461":2457,"_30106":2445,"_20907":56774,"_5":14363,"_27392":56739,"_2946":56775},[],"Console access and permission to create keys and authorities.",{"_3461":2458,"_30106":2445,"_20907":56777,"_5":14363,"_27392":56739,"_2946":56778},[],"An available cryptographic engine that supports the chosen algorithm.",{"_3461":2459,"_30106":2445,"_20907":56780,"_5":14363,"_27392":56739,"_2946":56781},[],"OpenSSL 3.x to check the downloaded certificate.",{"_3461":2460,"_30106":2445,"_20907":56783,"_5":14363,"_27392":56739,"_2946":56784},[],"Use an evaluation instance or an authority intended for these tests. The example creates a root that issues directly; to design an operational hierarchy, see Hierarchy and rotation.",{"_3461":2461,"_30106":2445,"_20907":56786,"_5":14363,"_27392":56742,"_2946":56787},[],"In **Certification Authorities**, select **Create New CA** and choose to create a CA with a new key pair.",{"_3461":2462,"_30106":2445,"_20907":56789,"_5":14363,"_27392":56742,"_2946":56790},[],"The &#x2A;*Create New CA (Existing Key)** flow is explained in the authorities guide.",{"_3461":2463,"_30106":2445,"_20907":56792,"_5":14363,"_27392":56746,"_2946":56793},[],"Choose the engine that will keep the key and an algorithm its capabilities allow. For this example, you can use **EC P-384** if available.",{"_3461":2464,"_30106":2445,"_20907":56795,"_5":14363,"_27392":56746,"_2946":56796},[],"The CA private key is used through the engine. In this path, you will download only the authority's public certificate.",{"_3461":2465,"_30106":2445,"_20907":56798,"_5":14363,"_27392":56750,"_2946":56799},[],"Select **Root CA** and complete:",{"_3461":2466,"_30106":2445,"_20907":56801,"_5":14363,"_27392":56750,"_2946":56802},[],"**CA Name**: `Acme Evaluation Root CA`.",{"_3461":2467,"_30106":2445,"_20907":56804,"_5":14363,"_27392":56750,"_2946":56805},[],"**Subject**: organization and country details for your evaluation.",{"_3461":2468,"_30106":2445,"_20907":56807,"_5":14363,"_27392":56750,"_2946":56808},[],"**CA Certificate Expiration**: for example, one year from creation.",{"_3461":2469,"_30106":2445,"_20907":56810,"_5":14363,"_27392":56750,"_2946":56811},[],"**Default End-Entity Certificate Issuance Expiration**: for example, 90 days, within the CA's lifetime.",{"_3461":2470,"_30106":2445,"_20907":56813,"_5":14363,"_27392":56750,"_2946":56814},[],"The CA name becomes its `Common Name`. Keep the CA usages needed to sign certificates and CRLs.",{"_3461":2471,"_30106":2445,"_20907":56816,"_5":14363,"_27392":56754,"_2946":56817},[],"Check the engine, algorithm, subject, root type and dates. Confirm creation and note the authority identifier so you can recognize it in the DMS or API.",{"_3461":2472,"_30106":2445,"_20907":56819,"_5":14363,"_27392":56758,"_2946":56820},[],"Open the new CA. It should appear active, show its certificate and allow access to **Issued Certificates**.",{"_3461":2473,"_30106":2445,"_20907":56822,"_5":14363,"_27392":56758,"_2946":56823},[],"Download or copy the authority's PEM certificate and save it as `ca.pem`. Check that the file contains the complete block, including `BEGIN CERTIFICATE` and `END CERTIFICATE`.",{"_3461":2474,"_30106":2445,"_20907":56825,"_5":14363,"_27392":56762,"_2946":56826},[],"Run from the directory where you saved `ca.pem`:",{"_3461":2475,"_30106":2445,"_20907":56828,"_5":14363,"_27392":56762,"_2946":56829},[],"Check that the subject and issuer match the root you created, the dates include the current time, **Basic Constraints** contains `CA:TRUE` and **Key Usage** allows certificate signing. The last command should return `ca.pem: OK`.",{"_3461":2476,"_30106":2445,"_20907":56831,"_5":14363,"_27392":56762,"_2946":56832},[],"You explicitly selected `ca.pem` as the trust anchor for this test. A valid self-signature does not install that trust in other consumers. See the openssl-verify reference for verification options.",{"_3461":2477,"_30106":2445,"_20907":56834,"_5":14363,"_27392":56766,"_2946":56835},[],"If creation fails, check permissions, engine availability and the selected algorithm.",{"_3461":2478,"_30106":2445,"_20907":56837,"_5":14363,"_27392":56766,"_2946":56838},[],"If OpenSSL cannot read the file, copy the complete PEM block again.",{"_3461":2479,"_30106":2445,"_20907":56840,"_5":14363,"_27392":56766,"_2946":56841},[],"If signature or date checks fail, check that you downloaded this CA's certificate and that your computer's clock is correct.",{"_3461":2480,"_30106":2445,"_20907":56843,"_5":14363,"_27392":56766,"_2946":56844},[],"PKI diagnostics covers issuance checks and cryptographic dependencies.",{"_3461":2481,"_30106":2445,"_20907":56846,"_5":14363,"_27392":56769,"_2946":56847},[],"Continue with Issue and verify a certificate, using this authority and `ca.pem`.",{"_3461":2482,"_30106":2482,"_5":14715,"_2946":56849,"_30438":56850,"_20907":56851,"_27392":2482},"Issue and verify a certificate",[49125,50593,54598,54035],[],{"_3461":2483,"_30106":2482,"_20907":56853,"_5":14363,"_27392":2482,"_2946":56854},[],"Issue a client certificate and check content, chain and key correspondence.",{"_3461":2484,"_30106":2482,"_5":30435,"_20907":56856,"_27392":56857,"_2946":49135},[],"/docs/platform/pki/quickstarts/issue-certificate#before-you-begin",{"_3461":2485,"_30106":2482,"_5":30435,"_20907":56859,"_27392":56860,"_2946":56861},[],"/docs/platform/pki/quickstarts/issue-certificate#start-the-issuance","Start the issuance",{"_3461":2486,"_30106":2482,"_5":30435,"_20907":56863,"_27392":56864,"_2946":56865},[],"/docs/platform/pki/quickstarts/issue-certificate#choose-the-method","Choose the method",{"_3461":2487,"_30106":2482,"_5":30435,"_20907":56867,"_27392":56868,"_2946":56869},[],"/docs/platform/pki/quickstarts/issue-certificate#identify-the-certificate","Identify the certificate",{"_3461":2488,"_30106":2482,"_5":30435,"_20907":56871,"_27392":56872,"_2946":56873},[],"/docs/platform/pki/quickstarts/issue-certificate#configure-key-and-uses","Configure key and uses",{"_3461":2489,"_30106":2482,"_5":30435,"_20907":56875,"_27392":56876,"_2946":56877},[],"/docs/platform/pki/quickstarts/issue-certificate#issue-and-download","Issue and download",{"_3461":2490,"_30106":2482,"_5":30435,"_20907":56879,"_27392":56880,"_2946":56881},[],"/docs/platform/pki/quickstarts/issue-certificate#verify-the-result","Verify the result",{"_3461":2491,"_30106":2482,"_5":30435,"_20907":56883,"_27392":56884,"_2946":56885},[],"/docs/platform/pki/quickstarts/issue-certificate#inspect-content-and-dates","Inspect content and dates",{"_3461":2492,"_30106":2482,"_5":30435,"_20907":56887,"_27392":56888,"_2946":56889},[],"/docs/platform/pki/quickstarts/issue-certificate#verify-the-chain","Verify the chain",{"_3461":2493,"_30106":2482,"_5":30435,"_20907":56891,"_27392":56892,"_2946":56893},[],"/docs/platform/pki/quickstarts/issue-certificate#check-that-the-key-matches","Check that the key matches",{"_3461":2494,"_30106":2482,"_5":30435,"_20907":56895,"_27392":56896,"_2946":54292},[],"/docs/platform/pki/quickstarts/issue-certificate#if-the-result-fails",{"_3461":2495,"_30106":2482,"_5":30435,"_20907":56898,"_27392":56899,"_2946":49159},[],"/docs/platform/pki/quickstarts/issue-certificate#next-step",{"_3461":2496,"_30106":2482,"_20907":56901,"_5":14363,"_27392":2482,"_2946":56902},[],"You will issue an end-entity certificate for `device-001` using browser key and CSR generation. The result is `device.crt`, `device.key` and the issuing root's public certificate, `ca.pem`.",{"_3461":2497,"_30106":2482,"_20907":56904,"_5":14363,"_27392":56857,"_2946":56905},[],"An active root CA with an available signing key and permission to issue. If one does not exist yet, follow Create your first CA.",{"_3461":2498,"_30106":2482,"_20907":56907,"_5":14363,"_27392":56857,"_2946":56908},[],"Its public certificate in `ca.pem`; this example uses the root created in the previous path.",{"_3461":2499,"_30106":2482,"_20907":56910,"_5":14363,"_27392":56857,"_2946":56911},[],"OpenSSL 3.x and a working directory with restricted access.",{"_3461":2500,"_30106":2482,"_20907":56913,"_5":14363,"_27392":56857,"_2946":56914},[],"A client identifier: here we use `device-001`.",{"_3461":2501,"_30106":2482,"_20907":56916,"_5":14363,"_27392":56857,"_2946":56917},[],"In this flow, the client's key is generated in the browser and must be downloaded when issuance finishes. If you lose it, you must generate a key and issue another certificate. The certificate inventory lets you download the public certificate, but cannot recover this key.",{"_3461":2502,"_30106":2482,"_20907":56919,"_5":14363,"_27392":56860,"_2946":56920},[],"Open the CA from the previous path, go to **Issued Certificates** and select **Issue New**.",{"_3461":2503,"_30106":2482,"_20907":56922,"_5":14363,"_27392":56864,"_2946":56923},[],"Select **Generate Key & CSR in Browser** to follow this example.",{"_3461":2504,"_30106":2482,"_20907":56925,"_5":14363,"_27392":56864,"_2946":56926},[],"If the key must be generated and kept on the destination system, use **Upload Existing CSR**, described in the authorities guide.",{"_3461":2505,"_30106":2482,"_20907":56928,"_5":14363,"_27392":56868,"_2946":56929},[],"Enter `device-001` as the `Common Name`. Add subject details required by your policy and SANs if the consumer uses them to identify the client.",{"_3461":2506,"_30106":2482,"_20907":56931,"_5":14363,"_27392":56868,"_2946":56932},[],"If you continue with manual registration, the `Device ID` will be exactly `device-001`.",{"_3461":2507,"_30106":2482,"_20907":56934,"_5":14363,"_27392":56872,"_2946":56935},[],"Choose an algorithm and size allowed by the profile; for example, ECDSA P-256 if permitted. For this client certificate, select **Digital Signature** and **Client Authentication**, and issue it as an end-entity certificate.",{"_3461":2508,"_30106":2482,"_20907":56937,"_5":14363,"_27392":56872,"_2946":56938},[],"Request, for example, 30 days of validity, always within the CA's lifetime. Review the issuance profile if the resulting content differs from the request.",{"_3461":2509,"_30106":2482,"_20907":56940,"_5":14363,"_27392":56876,"_2946":56941},[],"Confirm issuance. Save the PEM certificate as `device.crt` and the private key as `device.key` in your prepared directory.",{"_3461":2510,"_30106":2482,"_20907":56943,"_5":14363,"_27392":56880,"_2946":56944},[],"Check in **Issued Certificates** that the certificate appears active. Note its serial number and verify the downloaded material using the checks below.",{"_3461":2511,"_30106":2482,"_20907":56946,"_5":14363,"_27392":56884,"_2946":56947},[],"Check `CN=device-001`, the expected issuer, current validity, **Digital Signature** and the extended usage **TLS Web Client Authentication**. It must be an end-entity certificate: it must not declare `CA:TRUE` or enable **Certificate Sign**. If **Basic Constraints** is present, it must indicate `CA:FALSE`. If you requested SANs, check that the expected identifiers appear in the certificate.",{"_3461":2512,"_30106":2482,"_20907":56949,"_5":14363,"_27392":56888,"_2946":56950},[],"The expected result is `device.crt: OK`. This check uses your explicit root and evaluates the chain, dates and compatibility with the TLS client purpose. Also check for the expected usages and names through the inspection above.",{"_3461":2513,"_30106":2482,"_20907":56952,"_5":14363,"_27392":56888,"_2946":56953},[],"If you use an intermediate CA, the trusted root must be in `ca.pem` and you must supply the intermediates with `-untrusted intermediates.pem`. This variant is covered in the trust model.",{"_3461":2514,"_30106":2482,"_20907":56955,"_5":14363,"_27392":56888,"_2946":56956},[],"The command does not query OCSP or CRL. For revocation checks, continue with Certificate validation. See the openssl-verify reference for its options.",{"_3461":2515,"_30106":2482,"_20907":56958,"_5":14363,"_27392":56892,"_2946":56959},[],"In Bash, compare the two public-key digests:",{"_3461":2516,"_30106":2482,"_20907":56961,"_5":14363,"_27392":56892,"_2946":56962},[],"Both commands must finish successfully and show the same SHA-256 digest. If they differ, the private key does not match the selected certificate. Find the correct pair before installing it.",{"_3461":2517,"_30106":2482,"_20907":56964,"_5":14363,"_27392":56892,"_2946":56965},[],"The options used are documented in openssl-x509 and openssl-pkey.",{"_3461":2518,"_30106":2482,"_20907":56967,"_5":14363,"_27392":56896,"_2946":54376},[],{"_3461":2519,"_30106":2482,"_20907":56969,"_5":14363,"_27392":56896,"_2946":56970},[],"What to review",{"_3461":2520,"_30106":2482,"_20907":56972,"_5":14363,"_27392":56896,"_2946":56973},[],"The CA rejects issuance",{"_3461":2521,"_30106":2482,"_20907":56975,"_5":14363,"_27392":56896,"_2946":56976},[],"Permissions, CA state and key, algorithm and profile.",{"_3461":2522,"_30106":2482,"_20907":56978,"_5":14363,"_27392":56896,"_2946":56979},[],"Different subject or usages",{"_3461":2523,"_30106":2482,"_20907":56981,"_5":14363,"_27392":56896,"_2946":56982},[],"Applied profile and requested values.",{"_3461":2524,"_30106":2482,"_20907":56984,"_5":14363,"_27392":56896,"_2946":56985},[],"Issuer cannot be found",{"_3461":2525,"_30106":2482,"_20907":56987,"_5":14363,"_27392":56896,"_2946":56988},[],"Downloaded CA and required intermediate chain.",{"_3461":2526,"_30106":2482,"_20907":56990,"_5":14363,"_27392":56896,"_2946":56991},[],"Validity fails",{"_3461":2527,"_30106":2482,"_20907":56993,"_5":14363,"_27392":56896,"_2946":56994},[],"Certificate and CA dates, and the computer's clock.",{"_3461":2528,"_30106":2482,"_20907":56996,"_5":14363,"_27392":56896,"_2946":56997},[],"Public-key digests differ",{"_3461":2529,"_30106":2482,"_20907":56999,"_5":14363,"_27392":56896,"_2946":57000},[],"Certificate and key files from the same issuance.",{"_3461":2530,"_30106":2482,"_20907":57002,"_5":14363,"_27392":56896,"_2946":57003},[],"See PKI diagnostics to narrow an issuance failure.",{"_3461":2531,"_30106":2482,"_20907":57005,"_5":14363,"_27392":56899,"_2946":57006},[],"You have completed the PKI path when the certificate verifies and the key matches. Choose how to use it:",{"_3461":2532,"_30106":2482,"_20907":57008,"_5":14363,"_27392":56899,"_2946":57009},[],"Manage certificates for inspection, status and revocation.",{"_3461":2533,"_30106":2482,"_20907":57011,"_5":14363,"_27392":56899,"_2946":57012},[],"Register a device manually to associate this identity with Lamassu's inventory.",{"_3461":2534,"_30106":2482,"_20907":57014,"_5":14363,"_27392":56899,"_2946":57015},[],"Prepare EST for the device to request its next identities.",{"_3461":2535,"_30106":2482,"_20907":57017,"_5":14363,"_27392":56899,"_2946":57018},[],"Acceptance by a consumer requires configuring its trust, revocation checks and permissions granted to the identity.",{"_3461":2536,"_30106":2536,"_5":14715,"_2946":57020,"_30438":57021,"_20907":57022,"_27392":2536},"PKI getting started",[49125,50593,54598,54035],[],{"_3461":2537,"_30106":2536,"_20907":57024,"_5":14363,"_27392":2536,"_2946":57025},[],"Create a CA, issue a client certificate and check its chain and key.",{"_3461":2538,"_30106":2536,"_5":30435,"_20907":57027,"_27392":57028,"_2946":49135},[],"/docs/platform/pki/quickstarts/overview#before-you-begin",{"_3461":2539,"_30106":2536,"_5":30435,"_20907":57030,"_27392":57031,"_2946":57032},[],"/docs/platform/pki/quickstarts/overview#recommended-path","Recommended path",{"_3461":2540,"_30106":2536,"_5":30435,"_20907":57034,"_27392":57035,"_2946":54227},[],"/docs/platform/pki/quickstarts/overview#expected-result",{"_3461":2541,"_30106":2536,"_5":30435,"_20907":57037,"_27392":57038,"_2946":57039},[],"/docs/platform/pki/quickstarts/overview#continue-according-to-your-goal","Continue according to your goal",{"_3461":2542,"_30106":2536,"_20907":57041,"_5":14363,"_27392":2536,"_2946":57042},[],"This path is intended for those starting to administer PKI or needing a first X.509 client identity. It ends with three files: a root CA certificate, an end-entity certificate and the client's private key.",{"_3461":2543,"_30106":2536,"_20907":57044,"_5":14363,"_27392":57028,"_2946":57045},[],"A Lamassu instance accessible from your browser. To prepare one, see Deployment.",{"_3461":2544,"_30106":2536,"_20907":57047,"_5":14363,"_27392":57028,"_2946":57048},[],"Permission to manage keys, authorities and issuance. See Access control if an operation is blocked.",{"_3461":2545,"_30106":2536,"_20907":57050,"_5":14363,"_27392":57028,"_2946":57051},[],"An available cryptographic engine for the CA key; check the keys and engines inventory.",{"_3461":2546,"_30106":2536,"_20907":57053,"_5":14363,"_27392":57028,"_2946":57054},[],"OpenSSL 3.x on the computer where you will verify the files.",{"_3461":2547,"_30106":2536,"_20907":57056,"_5":14363,"_27392":57028,"_2946":57057},[],"A working directory with restricted access for the downloaded key.",{"_3461":2548,"_30106":2536,"_20907":57059,"_5":14363,"_27392":57031,"_2946":57060},[],"<Card title=\"1. Create your first CA\" description=\"Create an evaluation root and save its public certificate as ca.pem.\" href=\"/docs/platform/pki/quickstarts/create-certificate-authority\" />",{"_3461":2549,"_30106":2536,"_20907":57062,"_5":14363,"_27392":57031,"_2946":57063},[],"<Card title=\"2. Issue and verify a certificate\" description=\"Issue for device-001 and check content, chain and key correspondence.\" href=\"/docs/platform/pki/quickstarts/issue-certificate\" />",{"_3461":2550,"_30106":2536,"_20907":57065,"_5":14363,"_27392":57031,"_2946":57066},[],"We use `Acme Evaluation Root CA` and `device-001` as example names. If you replace them, keep the same client identifier in the steps you want to connect.",{"_3461":2551,"_30106":2536,"_20907":57068,"_5":14363,"_27392":57031,"_2946":57069},[],"The root in this path signs the end-entity certificate directly to simplify evaluation. Before designing an operational PKI, review the trust model and CA hierarchy.",{"_3461":2552,"_30106":2536,"_20907":57071,"_5":14363,"_27392":57035,"_2946":57072},[],"File or resource",{"_3461":2553,"_30106":2536,"_20907":57074,"_5":14363,"_27392":57035,"_2946":54224},[],{"_3461":2554,"_30106":2536,"_20907":57076,"_5":14363,"_27392":57035,"_2946":57077},[],"Active root CA and `ca.pem`",{"_3461":2555,"_30106":2536,"_20907":57079,"_5":14363,"_27392":57035,"_2946":57080},[],"It is a CA certificate, is currently valid and its self-signature verifies.",{"_3461":2556,"_30106":2536,"_20907":57082,"_5":14363,"_27392":57035,"_2946":57083},[],"End-entity certificate and `device.crt`",{"_3461":2557,"_30106":2536,"_20907":57085,"_5":14363,"_27392":57035,"_2946":57086},[],"It identifies `device-001`, supports client authentication and verifies against `ca.pem`.",{"_3461":2558,"_30106":2536,"_20907":57088,"_5":14363,"_27392":57035,"_2946":57089},[],"Private key `device.key`",{"_3461":2559,"_30106":2536,"_20907":57091,"_5":14363,"_27392":57035,"_2946":57092},[],"Its public key matches the one included in `device.crt`.",{"_3461":2560,"_30106":2536,"_20907":57094,"_5":14363,"_27392":57035,"_2946":57095},[],"These checks validate the issued material. Acceptance by a service also requires its trust, authorization and revocation configuration.",{"_3461":2561,"_30106":2536,"_20907":57097,"_5":14363,"_27392":57038,"_2946":57098},[],"To operate certificates, continue with Certificates and Validation.",{"_3461":2562,"_30106":2536,"_20907":57100,"_5":14363,"_27392":57038,"_2946":57101},[],"To manage a device identity in Lamassu, follow Manual registration. That path includes DMS preparation.",{"_3461":2563,"_30106":2536,"_20907":57103,"_5":14363,"_27392":57038,"_2946":57104},[],"For the device to request its certificate, prepare the DMS and EST client.",{"_3461":2564,"_30106":2564,"_5":14715,"_2946":57106,"_30438":57107,"_20907":57108,"_27392":2564},"PKI troubleshooting",[49125,50593,54598,53173],[],{"_3461":2565,"_30106":2564,"_20907":57110,"_5":14363,"_27392":2564,"_2946":57111},[],"Diagnose certificate issuance, OCSP and CRL.",{"_3461":2566,"_30106":2564,"_5":30435,"_20907":57113,"_27392":57114,"_2946":57115},[],"/docs/platform/pki/troubleshooting#issuance-fails","Issuance fails",{"_3461":2567,"_30106":2564,"_5":30435,"_20907":57117,"_27392":57118,"_2946":57119},[],"/docs/platform/pki/troubleshooting#ocsp-or-crl-do-not-reflect-a-change","OCSP or CRL do not reflect a change",{"_3461":2568,"_30106":2564,"_5":30435,"_20907":57121,"_27392":57122,"_2946":57123},[],"/docs/platform/pki/troubleshooting#the-chain-validates-but-the-connection-fails","The chain validates but the connection fails",{"_3461":2569,"_30106":2564,"_20907":57125,"_5":14363,"_27392":2564,"_2946":57126},[],"This guide helps a PKI operator locate issuance and status publication failures. Keep the Lamassu version, operation, CA, issuer, serial, time and returned error. Do not include private keys or tokens in diagnostics.",{"_3461":2570,"_30106":2564,"_20907":57128,"_5":14363,"_27392":2564,"_2946":57129},[],"For Gateway, sign-in, pods, dependencies and messaging, see Deployment troubleshooting. For device enrollment, see EST diagnostics.",{"_3461":2571,"_30106":2564,"_20907":57131,"_5":14363,"_27392":57114,"_2946":54224},[],{"_3461":2572,"_30106":2564,"_20907":57133,"_5":14363,"_27392":57114,"_2946":57134},[],"What to inspect",{"_3461":2573,"_30106":2564,"_20907":57136,"_5":14363,"_27392":57114,"_2946":49159},[],{"_3461":2574,"_30106":2564,"_20907":57138,"_5":14363,"_27392":57114,"_2946":53440},[],{"_3461":2575,"_30106":2564,"_20907":57140,"_5":14363,"_27392":57114,"_2946":57141},[],"Exists, is active and has usable dates.",{"_3461":2576,"_30106":2564,"_20907":57143,"_5":14363,"_27392":57114,"_2946":57144},[],"Authorities.",{"_3461":2577,"_30106":2564,"_20907":57146,"_5":14363,"_27392":57114,"_2946":57147},[],"Key",{"_3461":2578,"_30106":2564,"_20907":57149,"_5":14363,"_27392":57114,"_2946":57150},[],"The record has a usable private key and the engine can sign.",{"_3461":2579,"_30106":2564,"_20907":57152,"_5":14363,"_27392":57114,"_2946":57153},[],"Try **Sign / Verify** in KMS; check provider permissions and availability.",{"_3461":2580,"_30106":2564,"_20907":57155,"_5":14363,"_27392":57114,"_2946":57156},[],"CSR",{"_3461":2581,"_30106":2564,"_20907":57158,"_5":14363,"_27392":57114,"_2946":57159},[],"Correct PEM and verifiable signature.",{"_3461":2582,"_30106":2564,"_20907":57161,"_5":14363,"_27392":57114,"_2946":57162},[],"`openssl req -in request.csr -noout -verify -text`.",{"_3461":2583,"_30106":2564,"_20907":57164,"_5":14363,"_27392":57114,"_2946":57165},[],"Profile",{"_3461":2584,"_30106":2564,"_20907":57167,"_5":14363,"_27392":57114,"_2946":57168},[],"Selected source, existing ID, allowed algorithm and size.",{"_3461":2585,"_30106":2564,"_20907":57170,"_5":14363,"_27392":57114,"_2946":57171},[],"Check Profiles precedence; CA and DMS resolve differently.",{"_3461":2586,"_30106":2564,"_20907":57173,"_5":14363,"_27392":57114,"_2946":54376},[],{"_3461":2587,"_30106":2564,"_20907":57175,"_5":14363,"_27392":57114,"_2946":57176},[],"Appropriate subject, SAN, usages and dates.",{"_3461":2588,"_30106":2564,"_20907":57178,"_5":14363,"_27392":57114,"_2946":57179},[],"Compare CSR, profile and certificate; successful issuance does not establish consumer acceptance.",{"_3461":2589,"_30106":2564,"_20907":57181,"_5":14363,"_27392":57114,"_2946":57182},[],"For unexpected certificate fields, review `Honor Subject`, `Honor Key Usage`, `Honor Extended Key Usages` and `Honor Extensions`. The latter preserves SAN only, without validating entitlement to those names. Validity is not automatically clamped to CA expiration.",{"_3461":2590,"_30106":2564,"_20907":57184,"_5":14363,"_27392":57114,"_2946":57185},[],"For CA reissuance failures, check revocation and date: reissuance is not supported for a revoked or already expired CA. To change its key, use Hierarchy and rotation.",{"_3461":2591,"_30106":2564,"_20907":57187,"_5":14363,"_27392":57118,"_2946":57188},[],"Check each boundary independently:",{"_3461":2592,"_30106":2564,"_20907":57190,"_5":14363,"_27392":57118,"_2946":57191},[],"**Record:** read the correct certificate again by serial and issuer. Confirm status, reason and time; expired or permanently revoked records reject further transitions.",{"_3461":2593,"_30106":2564,"_20907":57193,"_5":14363,"_27392":57118,"_2946":57194},[],"**Endpoint:** inspect AIA and CDP. Query those URLs from the consumer’s network; an old route or incorrect issuer can explain a discrepancy.",{"_3461":2594,"_30106":2564,"_20907":57196,"_5":14363,"_27392":57118,"_2946":57197},[],"**OCSP:** save a fresh response, verify signature and timestamps, and observe status. An HTTP error for an absent serial does not mean `Good` or guarantee a signed `Unknown`.",{"_3461":2595,"_30106":2564,"_20907":57199,"_5":14363,"_27392":57118,"_2946":57200},[],"**CRL:** compare `latest_crl`, number and timestamps with the downloaded list. Check the serial in its contents. If unchanged, review `regenerate_on_revoke`, event delivery, jobs, signing and storage with the deployment operator.",{"_3461":2596,"_30106":2564,"_20907":57202,"_5":14363,"_27392":57118,"_2946":57203},[],"**Client:** check cache, policy for expired or unavailable evidence, critical IDP extension and rejection of a new connection.",{"_3461":2597,"_30106":2564,"_20907":57205,"_5":14363,"_27392":57118,"_2946":57206},[],"Reactivation from `CertificateHold` needs a new CRL for the client to stop seeing the hold. Reactivating a CA does not restore its descendant cascade; inspect every status and individual operation failure.",{"_3461":2598,"_30106":2564,"_20907":57208,"_5":14363,"_27392":57122,"_2946":57209},[],"Check expected identity, SAN, KU/EKU, matching key, presented intermediates and consumer permissions. Distinguish server TLS trust, client authentication and action authorization. Follow Validation for positive and rejection tests.",{"_3461":2599,"_30106":2564,"_20907":57211,"_5":14363,"_27392":57122,"_2946":57212},[],"When escalating a problem, provide identifiers, error and relevant public evidence, including query timestamps and version. This distinguishes issuance, publication and consumer application failures.",{"_3461":2600,"_30106":2600,"_5":14715,"_2946":57214,"_30438":57215,"_20907":57216,"_27392":2600},"Security",[49125],[],{"_3461":2601,"_30106":2600,"_20907":57218,"_5":14363,"_27392":2600,"_2946":57219},[],"How to report a security vulnerability in Lamassu privately, what to include in a report and which releases receive security fixes.",{"_3461":2602,"_30106":2600,"_5":30435,"_20907":57221,"_27392":57222,"_2946":57223},[],"/docs/security#report-a-vulnerability","Report a vulnerability",{"_3461":2603,"_30106":2600,"_5":30435,"_20907":57225,"_27392":57226,"_2946":57227},[],"/docs/security#what-to-include-in-a-report","What to include in a report",{"_3461":2604,"_30106":2600,"_5":30435,"_20907":57229,"_27392":57230,"_2946":57231},[],"/docs/security#supported-versions","Supported versions",{"_3461":2605,"_30106":2600,"_5":30435,"_20907":57233,"_27392":57234,"_2946":57235},[],"/docs/security#responsible-disclosure","Responsible disclosure",{"_3461":2606,"_30106":2600,"_20907":57237,"_5":14363,"_27392":2600,"_2946":57238},[],"Found a security vulnerability in lamassuiot, lamassu-dashboard, or lamassu-helm? This page explains how to report it privately, what to include in your report and which releases receive security fixes.",{"_3461":2607,"_30106":2600,"_20907":57240,"_5":14363,"_27392":57222,"_2946":57241},[],"Do not report security vulnerabilities through public GitHub issues, discussions, or pull requests. Public reports disclose the problem before maintainers can fix it.",{"_3461":2608,"_30106":2600,"_20907":57243,"_5":14363,"_27392":57222,"_2946":57244},[],"Instead, report privately using GitHub Security Advisories for the affected repository:",{"_3461":2609,"_30106":2600,"_20907":57246,"_5":14363,"_27392":57222,"_2946":14988},[],{"_3461":2610,"_30106":2600,"_20907":57248,"_5":14363,"_27392":57222,"_2946":14928},[],{"_3461":2611,"_30106":2600,"_20907":57250,"_5":14363,"_27392":57222,"_2946":14975},[],{"_3461":2612,"_30106":2600,"_20907":57252,"_5":14363,"_27392":57222,"_2946":57253},[],"This lets maintainers assess and address the issue before it is publicly disclosed.",{"_3461":2613,"_30106":2600,"_20907":57255,"_5":14363,"_27392":57222,"_2946":57256},[],"If private vulnerability reporting is not enabled for that repository, report the vulnerability privately to lamassuiot\\@lksnext.com before disclosing any details publicly.",{"_3461":2614,"_30106":2600,"_20907":57258,"_5":14363,"_27392":57226,"_2946":57259},[],"Describe the vulnerability, its potential impact, and steps to reproduce it using non-sensitive, redacted examples.",{"_3461":2615,"_30106":2600,"_20907":57261,"_5":14363,"_27392":57226,"_2946":57262},[],"Do not include in the report:",{"_3461":2616,"_30106":2600,"_20907":57264,"_5":14363,"_27392":57226,"_2946":57265},[],"Credentials, tokens, or private keys",{"_3461":2617,"_30106":2600,"_20907":57267,"_5":14363,"_27392":57226,"_2946":57268},[],"Customer data or customer-identifiable information",{"_3461":2618,"_30106":2600,"_20907":57270,"_5":14363,"_27392":57226,"_2946":57271},[],"Confidential architecture or internal infrastructure details",{"_3461":2619,"_30106":2600,"_20907":57273,"_5":14363,"_27392":57230,"_2946":57274},[],"Only the latest stable release receives security support. Support for a stable release ends when the next stable release is published. Older releases and pre-releases are not supported.",{"_3461":2620,"_30106":2600,"_20907":57276,"_5":14363,"_27392":57230,"_2946":57277},[],"For upgrade guidance, see Upgrades.",{"_3461":2621,"_30106":2600,"_20907":57279,"_5":14363,"_27392":57234,"_2946":57280},[],"Give maintainers reasonable time to investigate and address a reported vulnerability before any public disclosure.",{"_3461":2622,"_30106":2600,"_20907":57282,"_5":14363,"_27392":57234,"_2946":57283},[],"Avoid privacy violations, data destruction, and service disruption while researching a vulnerability.",{"_3461":2623,"_30106":2600,"_20907":57285,"_5":14363,"_27392":57234,"_2946":57286},[],"Only interact with accounts or data you own, or for which you have explicit permission.",{"_3461":2624,"_30106":2600,"_20907":57288,"_5":14363,"_27392":57234,"_2946":57289},[],"Maintainers acknowledge reports in a timely manner and keep you informed of remediation progress.",{"_3461":2625,"_30106":2600,"_20907":57291,"_5":14363,"_27392":57234,"_2946":57292},[],"This policy covers the source code, configuration, and CI/CD workflows of the lamassuiot, lamassu-dashboard, and lamassu-helm repositories.",{"_3461":2626,"_30106":2626,"_5":14715,"_2946":57294,"_30438":57295,"_20907":57297,"_27392":2626},"3.8.0 to 4.0.0",[49125,57296],"Upgrades",[],{"_3461":2627,"_30106":2626,"_20907":57299,"_5":14363,"_27392":2626,"_2946":57300},[],"What changes in the 4.0.0 architecture, which changes break a 3.8.0 deployment, how to upgrade a Helm release step by step and how to validate the result.",{"_3461":2628,"_30106":2626,"_5":30435,"_20907":57302,"_27392":57303,"_2946":57304},[],"/docs/upgrades/3-8-0-to-4-0-0#architecture-changes","Architecture changes",{"_3461":2629,"_30106":2626,"_5":30435,"_20907":57306,"_27392":57307,"_2946":57308},[],"/docs/upgrades/3-8-0-to-4-0-0#one-postgresql-database-with-schemas","One PostgreSQL database with schemas",{"_3461":2630,"_30106":2626,"_5":30435,"_20907":57310,"_27392":57311,"_2946":57312},[],"/docs/upgrades/3-8-0-to-4-0-0#authorization-moves-into-the-authz-service","Authorization moves into the authz service",{"_3461":2631,"_30106":2626,"_5":30435,"_20907":57314,"_27392":57315,"_2946":57316},[],"/docs/upgrades/3-8-0-to-4-0-0#device-events-get-their-own-store","Device events get their own store",{"_3461":2632,"_30106":2626,"_5":30435,"_20907":57318,"_27392":57319,"_2946":57320},[],"/docs/upgrades/3-8-0-to-4-0-0#a-hardened-helm-chart","A hardened Helm chart",{"_3461":2633,"_30106":2626,"_5":30435,"_20907":57322,"_27392":57323,"_2946":57324},[],"/docs/upgrades/3-8-0-to-4-0-0#what-the-upgrade-migrates-automatically","What the upgrade migrates automatically",{"_3461":2634,"_30106":2626,"_5":30435,"_20907":57326,"_27392":57327,"_2946":57328},[],"/docs/upgrades/3-8-0-to-4-0-0#breaking-changes","Breaking changes",{"_3461":2635,"_30106":2626,"_5":30435,"_20907":57330,"_27392":57331,"_2946":57332},[],"/docs/upgrades/3-8-0-to-4-0-0#helm-chart-and-values","Helm chart and values",{"_3461":2636,"_30106":2626,"_5":30435,"_20907":57334,"_27392":57335,"_2946":57336},[],"/docs/upgrades/3-8-0-to-4-0-0#release-scoped-resource-names","Release-scoped resource names",{"_3461":2637,"_30106":2626,"_5":30435,"_20907":57338,"_27392":57339,"_2946":57340},[],"/docs/upgrades/3-8-0-to-4-0-0#strict-values-validation","Strict values validation",{"_3461":2638,"_30106":2626,"_5":30435,"_20907":57342,"_27392":57343,"_2946":57344},[],"/docs/upgrades/3-8-0-to-4-0-0#required-authorization-configuration","Required authorization configuration",{"_3461":2639,"_30106":2626,"_5":30435,"_20907":57346,"_27392":57347,"_2946":57348},[],"/docs/upgrades/3-8-0-to-4-0-0#gateway-token-validation-removed","Gateway token validation removed",{"_3461":2640,"_30106":2626,"_5":30435,"_20907":57350,"_27392":57351,"_2946":57352},[],"/docs/upgrades/3-8-0-to-4-0-0#non-root-containers","Non-root containers",{"_3461":2641,"_30106":2626,"_5":30435,"_20907":57354,"_27392":57355,"_2946":57356},[],"/docs/upgrades/3-8-0-to-4-0-0#amqp-over-tls","AMQP over TLS",{"_3461":2642,"_30106":2626,"_5":30435,"_20907":57358,"_27392":57359,"_2946":57360},[],"/docs/upgrades/3-8-0-to-4-0-0#renamed-and-reshaped-values","Renamed and reshaped values",{"_3461":2643,"_30106":2626,"_5":30435,"_20907":57362,"_27392":57363,"_2946":57364},[],"/docs/upgrades/3-8-0-to-4-0-0#data-and-storage","Data and storage",{"_3461":2644,"_30106":2626,"_5":30435,"_20907":57366,"_27392":57367,"_2946":57368},[],"/docs/upgrades/3-8-0-to-4-0-0#postgresql-consolidation","PostgreSQL consolidation",{"_3461":2645,"_30106":2626,"_5":30435,"_20907":57370,"_27392":57371,"_2946":57372},[],"/docs/upgrades/3-8-0-to-4-0-0#sqlite-storage-removed","SQLite storage removed",{"_3461":2646,"_30106":2626,"_5":30435,"_20907":57374,"_27392":57375,"_2946":57376},[],"/docs/upgrades/3-8-0-to-4-0-0#legacy-ca-keys-in-the-kms","Legacy CA keys in the KMS",{"_3461":2647,"_30106":2626,"_5":30435,"_20907":57378,"_27392":57379,"_2946":57380},[],"/docs/upgrades/3-8-0-to-4-0-0#references-between-certificates-keys-and-crl-settings","References between certificates, keys and CRL settings",{"_3461":2648,"_30106":2626,"_5":30435,"_20907":57382,"_27392":57383,"_2946":57384},[],"/docs/upgrades/3-8-0-to-4-0-0#apis-and-stored-configuration","APIs and stored configuration",{"_3461":2649,"_30106":2626,"_5":30435,"_20907":57386,"_27392":57387,"_2946":57388},[],"/docs/upgrades/3-8-0-to-4-0-0#dms-webhooks","DMS webhooks",{"_3461":2650,"_30106":2626,"_5":30435,"_20907":57390,"_27392":57391,"_2946":57392},[],"/docs/upgrades/3-8-0-to-4-0-0#re-enrollment-trust-set","Re-enrollment trust set",{"_3461":2651,"_30106":2626,"_5":30435,"_20907":57394,"_27392":57395,"_2946":57396},[],"/docs/upgrades/3-8-0-to-4-0-0#independent-re-enrollment-authentication","Independent re-enrollment authentication",{"_3461":2652,"_30106":2626,"_5":30435,"_20907":57398,"_27392":57399,"_2946":57400},[],"/docs/upgrades/3-8-0-to-4-0-0#dms-update-api","DMS update API",{"_3461":2653,"_30106":2626,"_5":30435,"_20907":57402,"_27392":57403,"_2946":57404},[],"/docs/upgrades/3-8-0-to-4-0-0#certificate-type-values","Certificate type values",{"_3461":2654,"_30106":2626,"_5":30435,"_20907":57406,"_27392":57407,"_2946":57408},[],"/docs/upgrades/3-8-0-to-4-0-0#device-events","Device events",{"_3461":2655,"_30106":2626,"_5":30435,"_20907":57410,"_27392":57411,"_2946":57412},[],"/docs/upgrades/3-8-0-to-4-0-0#crl-signer-field","CRL signer field",{"_3461":2656,"_30106":2626,"_5":30435,"_20907":57414,"_27392":57415,"_2946":57416},[],"/docs/upgrades/3-8-0-to-4-0-0#crl-settings-keyed-by-ca-id","CRL settings keyed by CA ID",{"_3461":2657,"_30106":2626,"_5":30435,"_20907":57418,"_27392":57419,"_2946":57420},[],"/docs/upgrades/3-8-0-to-4-0-0#renamed-va-events","Renamed VA events",{"_3461":2658,"_30106":2626,"_5":30435,"_20907":57422,"_27392":57423,"_2946":57424},[],"/docs/upgrades/3-8-0-to-4-0-0#ca-ids-are-always-assigned-by-the-backend","CA IDs are always assigned by the backend",{"_3461":2659,"_30106":2626,"_5":30435,"_20907":57426,"_27392":57427,"_2946":57428},[],"/docs/upgrades/3-8-0-to-4-0-0#va-crl-signer","VA CRL signer",{"_3461":2660,"_30106":2626,"_5":30435,"_20907":57430,"_27392":57431,"_2946":57432},[],"/docs/upgrades/3-8-0-to-4-0-0#helm-migration-guide","Helm migration guide",{"_3461":2661,"_30106":2626,"_5":30435,"_20907":57434,"_27392":57435,"_2946":57436},[],"/docs/upgrades/3-8-0-to-4-0-0#step-1-prepare","Step 1: Prepare",{"_3461":2662,"_30106":2626,"_5":30435,"_20907":57438,"_27392":57439,"_2946":57440},[],"/docs/upgrades/3-8-0-to-4-0-0#pre-upgrade-check","Pre-upgrade check",{"_3461":2663,"_30106":2626,"_5":30435,"_20907":57442,"_27392":57443,"_2946":57444},[],"/docs/upgrades/3-8-0-to-4-0-0#step-2-update-the-values-file","Step 2: Update the values file",{"_3461":2664,"_30106":2626,"_5":30435,"_20907":57446,"_27392":57447,"_2946":57448},[],"/docs/upgrades/3-8-0-to-4-0-0#step-3-run-the-upgrade","Step 3: Run the upgrade",{"_3461":2665,"_30106":2626,"_5":30435,"_20907":57450,"_27392":57451,"_2946":57452},[],"/docs/upgrades/3-8-0-to-4-0-0#step-4-migrate-the-kms-and-va-data","Step 4: Migrate the KMS and VA data",{"_3461":2666,"_30106":2626,"_5":30435,"_20907":57454,"_27392":57455,"_2946":57456},[],"/docs/upgrades/3-8-0-to-4-0-0#step-5-remove-the-one-off-migration-values","Step 5: Remove the one-off migration values",{"_3461":2667,"_30106":2626,"_5":30435,"_20907":57458,"_27392":57459,"_2946":57460},[],"/docs/upgrades/3-8-0-to-4-0-0#deployments-without-helm","Deployments without Helm",{"_3461":2668,"_30106":2626,"_5":30435,"_20907":57462,"_27392":57463,"_2946":53173},[],"/docs/upgrades/3-8-0-to-4-0-0#troubleshooting",{"_3461":2669,"_30106":2626,"_5":30435,"_20907":57465,"_27392":57466,"_2946":57467},[],"/docs/upgrades/3-8-0-to-4-0-0#validation-checklist","Validation checklist",{"_3461":2670,"_30106":2626,"_5":30435,"_20907":57469,"_27392":57470,"_2946":57471},[],"/docs/upgrades/3-8-0-to-4-0-0#delete-the-old-volumes","Delete the old volumes",{"_3461":2671,"_30106":2626,"_20907":57473,"_5":14363,"_27392":2626,"_2946":57474},[],"Lamassu 4.0.0 is a major release. Storage consolidates into a single PostgreSQL database, a new `authz` service authorizes every request, the Helm chart is hardened, and several APIs and stored configurations change shape. Most data converts automatically during the upgrade, but some changes need operator action before, during or after it.",{"_3461":2672,"_30106":2626,"_20907":57476,"_5":14363,"_27392":2626,"_2946":57477},[],"This page is organized in four parts. Read them in order before you upgrade production:",{"_3461":2673,"_30106":2626,"_20907":57479,"_5":14363,"_27392":2626,"_2946":57480},[],"Architecture changes: what is different in 4.0.0 and what the upgrade migrates on its own.",{"_3461":2674,"_30106":2626,"_20907":57482,"_5":14363,"_27392":2626,"_2946":57483},[],"Breaking changes: every change that can break a 3.8.0 deployment, who it affects and what to do.",{"_3461":2675,"_30106":2626,"_20907":57485,"_5":14363,"_27392":2626,"_2946":57486},[],"Helm migration guide: the step-by-step procedure for a Helm-managed release.",{"_3461":2676,"_30106":2626,"_20907":57488,"_5":14363,"_27392":2626,"_2946":57489},[],"Validation checklist: how to confirm the upgrade worked before you remove the old data.",{"_3461":2677,"_30106":2626,"_20907":57491,"_5":14363,"_27392":2626,"_2946":57492},[],"The 4.0.0 release is upcoming and the backend migration steps on this page are provisional. Verify each procedure against the final release artifacts before upgrading production.",{"_3461":2678,"_30106":2626,"_20907":57494,"_5":14363,"_27392":57307,"_2946":57495},[],"3.8.0 gave each service its own database. The 4.0.0 backend connects to a single PostgreSQL database named `pki` and isolates each service in a schema: `kms`, `ca`, `va`, `devicemanager`, `dmsmanager` and `alerts`. The `authz` service keeps its principals, grants and policies in a separate `authz` database (the development monolith uses an `authz` schema inside `pki` instead), and WFX keeps its own `wfx` database.",{"_3461":2679,"_30106":2626,"_20907":57497,"_5":14363,"_27392":57307,"_2946":57498},[],"PostgreSQL is now the only storage engine. SQLite support is removed, and the `couch_db` and `dynamo_db` engines are not registered in 4.0.0.",{"_3461":2680,"_30106":2626,"_20907":57500,"_5":14363,"_27392":57311,"_2946":57501},[],"In 3.8.0 the API Gateway validated tokens: a JWT policy on every private route checked the signature and only let through tokens that carried the administrator role. Every route was open to any token that passed that check.",{"_3461":2681,"_30106":2626,"_20907":57503,"_5":14363,"_27392":57311,"_2946":57504},[],"4.0.0 removes the gateway policy. The `/api/*` routes reach the services directly, and each service authorizes every request through `authz`, which validates the token against the identity provider's JWKS endpoint and applies fine-grained, entity-level policies to CAs, certificates, devices, DMSs, KMS keys and CRL settings. There is no implicit superuser: the first administrator comes from a bootstrap principal that you configure. The access control page documents principals, policies and the first administrator.",{"_3461":2682,"_30106":2626,"_20907":57506,"_5":14363,"_27392":57315,"_2946":57507},[],"Historical device events move from the `devices.events` column to a dedicated `device_events` store with their own endpoints. The events endpoint can also stream events over Server-Sent Events (SSE); to fan events out across service instances, each Device Manager instance binds its own durable AMQP queue.",{"_3461":2683,"_30106":2626,"_20907":57509,"_5":14363,"_27392":57319,"_2946":57510},[],"Version 4.0.0 of the chart is a security-hardening release:",{"_3461":2684,"_30106":2626,"_20907":57512,"_5":14363,"_27392":57319,"_2946":57513},[],"**Release-scoped resource names.** Every chart-managed resource is named `<release>-lamassu-<component>` instead of the fixed names used in 3.8.0 (`kms`, `va`, `ca`, ...). With a release named `prod` the StatefulSets become `prod-lamassu-kms` and `prod-lamassu-va`. The `nameOverride` and `fullnameOverride` values change the prefix.",{"_3461":2685,"_30106":2626,"_20907":57515,"_5":14363,"_27392":57319,"_2946":57516},[],"**Non-root containers.** Every workload runs as the numeric user `65532:65532` with a `RuntimeDefault` seccomp profile and dropped capabilities. Pods do not mount the service-account token by default, and the chart creates a dedicated ServiceAccount.",{"_3461":2686,"_30106":2626,"_20907":57518,"_5":14363,"_27392":57319,"_2946":57519},[],"**Strict values validation.** `values.schema.json` rejects unknown keys, so leftover 3.8.0 blocks fail `helm lint` and `helm upgrade` instead of being silently ignored.",{"_3461":2687,"_30106":2626,"_20907":57521,"_5":14363,"_27392":57319,"_2946":57522},[],"**No injected scheduling rules.** The chart no longer adds pod anti-affinity or topology spread constraints on its own.",{"_3461":2688,"_30106":2626,"_20907":57524,"_5":14363,"_27392":57323,"_2946":57525},[],"Several migrations run without intervention when you upgrade a Helm release:",{"_3461":2689,"_30106":2626,"_20907":57527,"_5":14363,"_27392":57323,"_2946":57528},[],"Before any service starts, the chart's pre-install/pre-upgrade job prepares PostgreSQL. It creates the `pki`, `authz` and `wfx` databases when they do not exist, creates one schema per service inside `pki`, and imports each 3.8.0 per-service database into its schema. Each import runs as a single transaction, so a failed import leaves no partial schema and a retried job imports again. The job then runs the database migrations for every schema, migrates `authz`, preloads its policies and seeds the `services.authz.bootstrap` principals. It is idempotent and requires a PostgreSQL role allowed to create databases and schemas, as described in Install with Helm.",{"_3461":2690,"_30106":2626,"_20907":57530,"_5":14363,"_27392":57323,"_2946":57531},[],"Stored DMS configuration is rewritten to the 4.0.0 layout, and historical device events are transformed into the new store.",{"_3461":2691,"_30106":2626,"_20907":57533,"_5":14363,"_27392":57323,"_2946":57534},[],"The KMS migration removes the stale `lamassu.io/kms/binded-resources` key metadata, and the VA migration resolves each role's CRL signer (see VA CRL signer).",{"_3461":2692,"_30106":2626,"_20907":57536,"_5":14363,"_27392":57323,"_2946":57537},[],"When `migrations.caToKms.enabled` is set, a pre-upgrade hook registers legacy CA keys in the KMS.",{"_3461":2693,"_30106":2626,"_20907":57539,"_5":14363,"_27392":57323,"_2946":57540},[],"Two things never migrate on their own: the KMS and VA data on local volumes, which stays on volumes the upgraded pods no longer use, and the values file, which you update by hand. Deployments that do not use the Helm chart also have to move their database data themselves; see Deployments without Helm.",{"_3461":2694,"_30106":2626,"_20907":57542,"_5":14363,"_27392":57327,"_2946":57543},[],"Change",{"_3461":2695,"_30106":2626,"_20907":57545,"_5":14363,"_27392":57327,"_2946":57546},[],"Who is affected",{"_3461":2696,"_30106":2626,"_20907":57548,"_5":14363,"_27392":57327,"_2946":57549},[],"Severity",{"_3461":2697,"_30106":2626,"_20907":57551,"_5":14363,"_27392":57327,"_2946":56025},[],{"_3461":2698,"_30106":2626,"_20907":57553,"_5":14363,"_27392":57327,"_2946":57336},[],{"_3461":2699,"_30106":2626,"_20907":57555,"_5":14363,"_27392":57327,"_2946":57556},[],"Helm releases with a filesystem KMS engine or local VA CRL storage",{"_3461":2700,"_30106":2626,"_20907":57558,"_5":14363,"_27392":57327,"_2946":57559},[],"High: KMS and VA start on empty volumes",{"_3461":2701,"_30106":2626,"_20907":57561,"_5":14363,"_27392":57327,"_2946":57562},[],"Copy the data into the new volumes",{"_3461":2702,"_30106":2626,"_20907":57564,"_5":14363,"_27392":57327,"_2946":57340},[],{"_3461":2703,"_30106":2626,"_20907":57566,"_5":14363,"_27392":57327,"_2946":57567},[],"Every Helm release",{"_3461":2704,"_30106":2626,"_20907":57569,"_5":14363,"_27392":57327,"_2946":57570},[],"High: `helm upgrade` fails",{"_3461":2705,"_30106":2626,"_20907":57572,"_5":14363,"_27392":57327,"_2946":57573},[],"Remove or rename legacy keys",{"_3461":2706,"_30106":2626,"_20907":57575,"_5":14363,"_27392":57327,"_2946":57344},[],{"_3461":2707,"_30106":2626,"_20907":57577,"_5":14363,"_27392":57327,"_2946":57578},[],"Every deployment",{"_3461":2708,"_30106":2626,"_20907":57580,"_5":14363,"_27392":57327,"_2946":57581},[],"High: without a bootstrap principal there is no administrator",{"_3461":2709,"_30106":2626,"_20907":57583,"_5":14363,"_27392":57327,"_2946":57584},[],"Configure `services.authz`",{"_3461":2710,"_30106":2626,"_20907":57586,"_5":14363,"_27392":57327,"_2946":57348},[],{"_3461":2711,"_30106":2626,"_20907":57588,"_5":14363,"_27392":57327,"_2946":57567},[],{"_3461":2712,"_30106":2626,"_20907":57590,"_5":14363,"_27392":57327,"_2946":57591},[],"High: `helm upgrade` fails on the old keys",{"_3461":2713,"_30106":2626,"_20907":57593,"_5":14363,"_27392":57327,"_2946":57594},[],"Move JWKS and roles into `services.authz`",{"_3461":2714,"_30106":2626,"_20907":57596,"_5":14363,"_27392":57327,"_2946":57368},[],{"_3461":2715,"_30106":2626,"_20907":57598,"_5":14363,"_27392":57327,"_2946":57599},[],"3.8.0 deployments with per-service databases",{"_3461":2716,"_30106":2626,"_20907":57601,"_5":14363,"_27392":57327,"_2946":57602},[],"High: services find no data, or a migration aborts",{"_3461":2717,"_30106":2626,"_20907":57604,"_5":14363,"_27392":57327,"_2946":57605},[],"Clean duplicate CA IDs and empty `engine_id` values first; move data manually outside Helm",{"_3461":2718,"_30106":2626,"_20907":57607,"_5":14363,"_27392":57327,"_2946":57372},[],{"_3461":2719,"_30106":2626,"_20907":57609,"_5":14363,"_27392":57327,"_2946":57610},[],"Deployments on SQLite, `couch_db` or `dynamo_db`",{"_3461":2720,"_30106":2626,"_20907":57612,"_5":14363,"_27392":57327,"_2946":57613},[],"High: the backend no longer starts with them",{"_3461":2721,"_30106":2626,"_20907":57615,"_5":14363,"_27392":57327,"_2946":57616},[],"Move to PostgreSQL before upgrading",{"_3461":2722,"_30106":2626,"_20907":57618,"_5":14363,"_27392":57327,"_2946":57416},[],{"_3461":2723,"_30106":2626,"_20907":57620,"_5":14363,"_27392":57327,"_2946":57621},[],"Every deployment; API clients, custom policies and alert subscriptions are also affected",{"_3461":2724,"_30106":2626,"_20907":57623,"_5":14363,"_27392":57327,"_2946":57624},[],"High: the `/v1/roles` routes are removed and the migration is irreversible",{"_3461":2725,"_30106":2626,"_20907":57626,"_5":14363,"_27392":57327,"_2946":57627},[],"Fix the data the migration aborts on, and back up the database and the CRL bucket",{"_3461":2726,"_30106":2626,"_20907":57629,"_5":14363,"_27392":57327,"_2946":57630},[],"Webhooks with file references",{"_3461":2727,"_30106":2626,"_20907":57632,"_5":14363,"_27392":57327,"_2946":57633},[],"DMSs whose webhook mTLS certificate or key were file paths",{"_3461":2728,"_30106":2626,"_20907":57635,"_5":14363,"_27392":57327,"_2946":57636},[],"High: enrollments calling the webhook fail",{"_3461":2729,"_30106":2626,"_20907":57638,"_5":14363,"_27392":57327,"_2946":57639},[],"Re-enter certificate and key as PEM, or remove the file fields",{"_3461":2730,"_30106":2626,"_20907":57641,"_5":14363,"_27392":57327,"_2946":57352},[],{"_3461":2731,"_30106":2626,"_20907":57643,"_5":14363,"_27392":57327,"_2946":57644},[],"Releases with per-service identity overrides or mounted key material",{"_3461":2732,"_30106":2626,"_20907":57646,"_5":14363,"_27392":57327,"_2946":57647},[],"Medium: services cannot read their files",{"_3461":2733,"_30106":2626,"_20907":57649,"_5":14363,"_27392":57327,"_2946":57650},[],"Remove the overrides and fix volume ownership",{"_3461":2734,"_30106":2626,"_20907":57652,"_5":14363,"_27392":57327,"_2946":57356},[],{"_3461":2735,"_30106":2626,"_20907":57654,"_5":14363,"_27392":57327,"_2946":57655},[],"Releases that set `amqp.tls`",{"_3461":2736,"_30106":2626,"_20907":57657,"_5":14363,"_27392":57327,"_2946":57658},[],"Medium: clients connect to the wrong port",{"_3461":2737,"_30106":2626,"_20907":57660,"_5":14363,"_27392":57327,"_2946":57661},[],"Point `amqp.port` at the TLS listener, or disable TLS",{"_3461":2738,"_30106":2626,"_20907":57663,"_5":14363,"_27392":57327,"_2946":57376},[],{"_3461":2739,"_30106":2626,"_20907":57665,"_5":14363,"_27392":57327,"_2946":57666},[],"Installations whose CA keys predate the KMS",{"_3461":2740,"_30106":2626,"_20907":57668,"_5":14363,"_27392":57327,"_2946":57669},[],"Medium: CA keys stay unmanaged",{"_3461":2741,"_30106":2626,"_20907":57671,"_5":14363,"_27392":57327,"_2946":57672},[],"Run the CA-to-KMS migration",{"_3461":2742,"_30106":2626,"_20907":57674,"_5":14363,"_27392":57327,"_2946":57675},[],"Receiver certificate verification",{"_3461":2743,"_30106":2626,"_20907":57677,"_5":14363,"_27392":57327,"_2946":57678},[],"DMSs whose webhook had `validate_server_cert: false`",{"_3461":2744,"_30106":2626,"_20907":57680,"_5":14363,"_27392":57327,"_2946":57681},[],"Medium: credentials go to an unverified receiver",{"_3461":2745,"_30106":2626,"_20907":57683,"_5":14363,"_27392":57327,"_2946":57684},[],"Set `insecure_skip_verify` to `false`",{"_3461":2746,"_30106":2626,"_20907":57686,"_5":14363,"_27392":57327,"_2946":57392},[],{"_3461":2747,"_30106":2626,"_20907":57688,"_5":14363,"_27392":57327,"_2946":57689},[],"Scripts and consoles that edit DMSs through the API",{"_3461":2748,"_30106":2626,"_20907":57691,"_5":14363,"_27392":57327,"_2946":57692},[],"Medium: an old-layout edit silently empties `validation_cas`",{"_3461":2749,"_30106":2626,"_20907":57694,"_5":14363,"_27392":57327,"_2946":57695},[],"Read the DMS before editing and use the new field",{"_3461":2750,"_30106":2626,"_20907":57697,"_5":14363,"_27392":57327,"_2946":57412},[],{"_3461":2751,"_30106":2626,"_20907":57699,"_5":14363,"_27392":57327,"_2946":57700},[],"Clients that create or update CRL settings through the API",{"_3461":2752,"_30106":2626,"_20907":57702,"_5":14363,"_27392":57327,"_2946":57703},[],"Medium: requests with the old field return an error",{"_3461":2753,"_30106":2626,"_20907":57705,"_5":14363,"_27392":57327,"_2946":57706},[],"Replace `crl_options.subject_key_id_signer` with the required `crl_options.signer_serial_number`",{"_3461":2754,"_30106":2626,"_20907":57708,"_5":14363,"_27392":57327,"_2946":57420},[],{"_3461":2755,"_30106":2626,"_20907":57710,"_5":14363,"_27392":57327,"_2946":57711},[],"Alert subscriptions and consumers of the VA events",{"_3461":2756,"_30106":2626,"_20907":57713,"_5":14363,"_27392":57327,"_2946":57714},[],"Medium: subscription types are renamed automatically, their conditions are not",{"_3461":2757,"_30106":2626,"_20907":57716,"_5":14363,"_27392":57327,"_2946":57717},[],"Review conditions filtering on the old event payload or subject",{"_3461":2758,"_30106":2626,"_20907":57719,"_5":14363,"_27392":57327,"_2946":57408},[],{"_3461":2759,"_30106":2626,"_20907":57721,"_5":14363,"_27392":57327,"_2946":57722},[],"Consumers that read the device `events` field",{"_3461":2760,"_30106":2626,"_20907":57724,"_5":14363,"_27392":57327,"_2946":57725},[],"Medium: the field disappears",{"_3461":2761,"_30106":2626,"_20907":57727,"_5":14363,"_27392":57327,"_2946":57728},[],"Use the new event endpoints",{"_3461":2762,"_30106":2626,"_20907":57730,"_5":14363,"_27392":57327,"_2946":57428},[],{"_3461":2763,"_30106":2626,"_20907":57732,"_5":14363,"_27392":57327,"_2946":57733},[],"Deployments with VA roles whose signer cannot be resolved uniquely",{"_3461":2764,"_30106":2626,"_20907":57735,"_5":14363,"_27392":57327,"_2946":57736},[],"Medium: the VA migration aborts",{"_3461":2765,"_30106":2626,"_20907":57738,"_5":14363,"_27392":57327,"_2946":57739},[],"Fix the affected roles before upgrading",{"_3461":2766,"_30106":2626,"_20907":57741,"_5":14363,"_27392":57327,"_2946":57360},[],{"_3461":2767,"_30106":2626,"_20907":57743,"_5":14363,"_27392":57327,"_2946":57744},[],"Releases that override `toolbox`, `services.connectors`, ports, probes or scheduling",{"_3461":2768,"_30106":2626,"_20907":57746,"_5":14363,"_27392":57327,"_2946":57747},[],"Low to medium: validation errors or changed defaults",{"_3461":2769,"_30106":2626,"_20907":57749,"_5":14363,"_27392":57327,"_2946":57750},[],"Update the values file",{"_3461":2770,"_30106":2626,"_20907":57752,"_5":14363,"_27392":57327,"_2946":57400},[],{"_3461":2771,"_30106":2626,"_20907":57754,"_5":14363,"_27392":57327,"_2946":57755},[],"Clients that send the DMS ID in the update body",{"_3461":2772,"_30106":2626,"_20907":57757,"_5":14363,"_27392":57327,"_2946":57758},[],"Low: the ID in the URL wins",{"_3461":2773,"_30106":2626,"_20907":57760,"_5":14363,"_27392":57327,"_2946":57761},[],"Send the ID in the URL",{"_3461":2774,"_30106":2626,"_20907":57763,"_5":14363,"_27392":57327,"_2946":57424},[],{"_3461":2775,"_30106":2626,"_20907":57765,"_5":14363,"_27392":57327,"_2946":57766},[],"Clients that send an `id` when creating or importing CAs",{"_3461":2776,"_30106":2626,"_20907":57768,"_5":14363,"_27392":57327,"_2946":57769},[],"Low: the ID in the body is ignored, and the field is removed",{"_3461":2777,"_30106":2626,"_20907":57771,"_5":14363,"_27392":57327,"_2946":57772},[],"Let the backend assign the ID and use the returned one",{"_3461":2778,"_30106":2626,"_20907":57774,"_5":14363,"_27392":57327,"_2946":57404},[],{"_3461":2779,"_30106":2626,"_20907":57776,"_5":14363,"_27392":57327,"_2946":57777},[],"Consumers that match on certificate `type`",{"_3461":2780,"_30106":2626,"_20907":57779,"_5":14363,"_27392":57327,"_2946":57780},[],"Low: two values are renamed",{"_3461":2781,"_30106":2626,"_20907":57782,"_5":14363,"_27392":57327,"_2946":57783},[],"Adapt consumers",{"_3461":2782,"_30106":2626,"_20907":57785,"_5":14363,"_27392":57327,"_2946":57396},[],{"_3461":2783,"_30106":2626,"_20907":57787,"_5":14363,"_27392":57327,"_2946":57788},[],"Any DMS",{"_3461":2784,"_30106":2626,"_20907":57790,"_5":14363,"_27392":57327,"_2946":57791},[],"Low: informational",{"_3461":2785,"_30106":2626,"_20907":57793,"_5":14363,"_27392":57327,"_2946":57794},[],"Read both blocks before editing",{"_3461":2786,"_30106":2626,"_20907":57796,"_5":14363,"_27392":57335,"_2946":57797},[],"Kubernetes derives a StatefulSet's PVC name from its pod name (`<volumeClaimTemplate>-<pod-name>`). Renaming the `kms` and `va` StatefulSets means `helm upgrade` binds brand-new, empty PVCs instead of the existing ones. The KMS key material and VA CRLs are not deleted — the old PVCs are orphaned, not removed — but the upgraded pods fail with `no such file or directory` (KMS) or `code=NotFound` (VA) until you copy the data across. This affects KMS when `services.kms.cryptoEngines` uses a `filesystem` engine and VA when `services.va.fileStore.type` is `local`. Every other renamed resource is stateless and is recreated without data-loss risk.",{"_3461":2787,"_30106":2626,"_20907":57799,"_5":14363,"_27392":57335,"_2946":57800},[],"Step 4 of the migration guide copies the data.",{"_3461":2788,"_30106":2626,"_20907":57802,"_5":14363,"_27392":57339,"_2946":57803},[],"`values.schema.json` rejects unknown keys, so every block that 4.0.0 removed or renamed — `toolbox`, `auth.oidc.apiGateway`, `auth.authorization` and others — fails `helm lint` and `helm upgrade` outright. Step 2 lists every change.",{"_3461":2789,"_30106":2626,"_20907":57805,"_5":14363,"_27392":57343,"_2946":57806},[],"3.8.0 had no authorization service, so a 3.8.0 values file has nothing to migrate from: you must add the `services.authz` configuration yourself. It needs the JWKS endpoint of your identity provider, the database mappings the authorization engine uses, and a bootstrap principal that matches how your provider assigns the administrator role. Without a matching principal nobody can administer the PKI.",{"_3461":2790,"_30106":2626,"_20907":57808,"_5":14363,"_27392":57347,"_2946":57809},[],"`auth.oidc.apiGateway.jwks`, `auth.authorization.rolesClaim` and `auth.authorization.roles.admin` are removed with no compatibility aliases, and the schema rejects them. Their settings move into `services.authz`: the JWKS URL becomes `services.authz.jwkUrl`, and the role claim and administrator role become a claim rule of the bootstrap principal. `auth.oidc.frontend` is unchanged.",{"_3461":2791,"_30106":2626,"_20907":57811,"_5":14363,"_27392":57351,"_2946":57812},[],"Service images run on a distroless base as the numeric user `65532`; the `authz` image is Ubuntu with a non-root user that has the same UID. The per-service overrides `services.kms.securityContext.runAsGroup: 0` and `services.authz.securityContext.runAsUser`/`runAsGroup: 999` are removed; group access to the KMS volume and PKCS#11 socket is now handled by the pod-level `fsGroup: 65532`.",{"_3461":2792,"_30106":2626,"_20907":57814,"_5":14363,"_27392":57351,"_2946":57815},[],"3.8.0 did not pin a container identity, so existing files can carry any UID. Any volume that holds keys or CRLs must be owned by `65532:65532`, or at least readable (and, where needed, writable) by that identity.",{"_3461":2793,"_30106":2626,"_20907":57817,"_5":14363,"_27392":57355,"_2946":57818},[],"In 3.8.0 `amqp.tls` was not applied and event-bus clients always connected over plaintext. In 4.0.0 `amqp.tls: true` switches them to AMQPS. The default `amqp.port` stays `5672` and does not change when TLS is enabled, so a values file that already set `amqp.tls: true` must point `amqp.port` at the broker's TLS listener (`amqps`, commonly `5671`), or set `amqp.tls: false` to keep plaintext. Clients must also trust the broker's certificate.",{"_3461":2794,"_30106":2626,"_20907":57820,"_5":14363,"_27392":57359,"_2946":57821},[],"`toolbox` is renamed to `connectivityTest`, and the `helm test` hook uses the upstream `curlimages/curl` image pinned by digest.",{"_3461":2795,"_30106":2626,"_20907":57823,"_5":14363,"_27392":57359,"_2946":57824},[],"`services.connectors` is a map keyed by connector ID instead of a list.",{"_3461":2796,"_30106":2626,"_20907":57826,"_5":14363,"_27392":57359,"_2946":57827},[],"The `services.ui.port` default is `8085`, the unprivileged port of the rootless image.",{"_3461":2797,"_30106":2626,"_20907":57829,"_5":14363,"_27392":57359,"_2946":57830},[],"The shared `probes:` block is replaced by independent `livenessProbe`, `readinessProbe` and `startupProbe` blocks.",{"_3461":2798,"_30106":2626,"_20907":57832,"_5":14363,"_27392":57359,"_2946":57833},[],"With `tls.certManagerOptions.issuer` empty, the chart creates a release-scoped self-signed issuer, for example `lamassu-downstream-ca-selfsigned-issuer`. The legacy literal `downstream-ca-selfsigned-issuer` is still accepted and resolves to it.",{"_3461":2799,"_30106":2626,"_20907":57835,"_5":14363,"_27392":57359,"_2946":57836},[],"Anti-affinity and topology spread must be configured explicitly through `affinity` and `topologySpreadConstraints`.",{"_3461":2800,"_30106":2626,"_20907":57838,"_5":14363,"_27392":57367,"_2946":57839},[],"Every 3.8.0 per-service database must end up as a schema of `pki`, keeping its structure, indexes, constraints, data and migration history. The Helm chart does this automatically; deployments without Helm do it by hand (see Deployments without Helm).",{"_3461":2801,"_30106":2626,"_20907":57841,"_5":14363,"_27392":57367,"_2946":57842},[],"Two schema migrations abort on data that 3.8.0 allowed, so clean the data before upgrading:",{"_3461":2802,"_30106":2626,"_20907":57844,"_5":14363,"_27392":57367,"_2946":57845},[],"The CA migration adds a UNIQUE constraint on `ca_certificates.id` and aborts if duplicate CA IDs exist. Imports already reject duplicates with `409`, so new ones cannot normally appear.",{"_3461":2803,"_30106":2626,"_20907":57847,"_5":14363,"_27392":57367,"_2946":57848},[],"The KMS migration promotes the primary key to `(key_id, engine_id)` and aborts with `cannot promote (key_id, engine_id) to primary key: N row(s) have no engine_id; backfill them before migrating` when `kms_keys` rows lack `engine_id`. Backfill `engine_id` first.",{"_3461":2804,"_30106":2626,"_20907":57850,"_5":14363,"_27392":57367,"_2946":57851},[],"The same KMS migration deletes, with a `NOTICE`, aliases that equal an existing key ID, because identifiers now resolve as a key ID before an alias. Affected aliases are dropped, not redirected.",{"_3461":2805,"_30106":2626,"_20907":57853,"_5":14363,"_27392":57371,"_2946":57854},[],"The SQLite storage engine is removed, and the `couch_db` and `dynamo_db` engines are not registered in 4.0.0: their configuration constants remain, but they select no engine. Deployments on any of them must move to PostgreSQL and consolidate their data into the `pki` schemas before upgrading.",{"_3461":2806,"_30106":2626,"_20907":57856,"_5":14363,"_27392":57375,"_2946":57857},[],"CA certificates of type `MANAGED` or `IMPORTED_WITH_KEY` whose private keys predate the KMS service have the key stored only in the crypto engine, under the certificate's `subject_key_id`, with no KMS record. The `ca-to-kms-migration` tool registers them:",{"_3461":2807,"_30106":2626,"_20907":57859,"_5":14363,"_27392":57375,"_2946":57860},[],"The `key_id` is the certificate's `subject_key_id`; it matches the SHA-256 digest of the public key only when the SKI was computed that way.",{"_3461":2808,"_30106":2626,"_20907":57862,"_5":14363,"_27392":57375,"_2946":57863},[],"The tool is idempotent: keys already in the KMS are skipped, so it can be run several times.",{"_3461":2809,"_30106":2626,"_20907":57865,"_5":14363,"_27392":57375,"_2946":57866},[],"Certificates that cannot be read, or lack an engine or a subject key ID, are skipped with a warning. Review the logs and resolve the affected records.",{"_3461":2810,"_30106":2626,"_20907":57868,"_5":14363,"_27392":57375,"_2946":57869},[],"When CA certificates sharing a `subject_key_id` declare conflicting `engine_id`s, the tool fails that key and exits with code `1`, which fails a Helm pre-upgrade hook. Resolve the conflict manually before rerunning.",{"_3461":2811,"_30106":2626,"_20907":57871,"_5":14363,"_27392":57375,"_2946":57872},[],"Once the keys are registered, certificates reference them in the database and the KMS refuses to delete a key that a certificate still uses (`409` `key is in use`). Deleting a certificate record removes it from the CRL and OCSP, so read Before deleting a key before freeing a key.",{"_3461":2812,"_30106":2626,"_20907":57874,"_5":14363,"_27392":57375,"_2946":57875},[],"Optionally, installations with imported CAs from before 3.7 can start the KMS once with `crypto_engines.migrate_keys_format: true`: the KMS renames those SKI-named legacy keys to the SHA-256 digest of their public key (the old name is kept as an alias, and the certificate references follow automatically). Run it once and disable the option again; running it again is safe.",{"_3461":2813,"_30106":2626,"_20907":57877,"_5":14363,"_27392":57375,"_2946":57878},[],"With Helm, enable the hook for the upgrade in step 2; without Helm, run the tool by hand.",{"_3461":2814,"_30106":2626,"_20907":57880,"_5":14363,"_27392":57379,"_2946":57881},[],"Certificates now reference their KMS key, and CRL settings reference their signer certificate, so a key or certificate in use cannot be deleted. The KMS migration drops the legacy `lamassu.io/kms/binded-resources` key metadata. Before 4.0.0, deleting a CA could remove its key while leaving key references in its retained certificate records. The CA migration registers those missing keys in the KMS with only their public key to satisfy the retained references. These entries cannot be deleted while the retained certificates reference them; they do not restore the private key. In 4.0.0, deleting a CA releases the references from its own current certificate and linked reissued certificates before attempting to delete the key; other certificates that still reference it prevent deletion.",{"_3461":2815,"_30106":2626,"_20907":57883,"_5":14363,"_27392":57387,"_2946":57884},[],"Stored webhook configs are rewritten to the current layout and their fields renamed:",{"_3461":2816,"_30106":2626,"_20907":57886,"_5":14363,"_27392":57387,"_2946":57887},[],"Field in 3.8.0",{"_3461":2817,"_30106":2626,"_20907":57889,"_5":14363,"_27392":57387,"_2946":57890},[],"Field in 4.0.0",{"_3461":2818,"_30106":2626,"_20907":57892,"_5":14363,"_27392":57387,"_2946":57893},[],"`validate_server_cert`",{"_3461":2819,"_30106":2626,"_20907":57895,"_5":14363,"_27392":57387,"_2946":57896},[],"`insecure_skip_verify` (value negated)",{"_3461":2820,"_30106":2626,"_20907":57898,"_5":14363,"_27392":57387,"_2946":57899},[],"`oidc`",{"_3461":2821,"_30106":2626,"_20907":57901,"_5":14363,"_27392":57387,"_2946":57902},[],"`jwt_options`",{"_3461":2822,"_30106":2626,"_20907":57904,"_5":14363,"_27392":57387,"_2946":57905},[],"`apikey`",{"_3461":2823,"_30106":2626,"_20907":57907,"_5":14363,"_27392":57387,"_2946":57908},[],"`apikey_options`",{"_3461":2824,"_30106":2626,"_20907":57910,"_5":14363,"_27392":57387,"_2946":57911},[],"`mtls`",{"_3461":2825,"_30106":2626,"_20907":57913,"_5":14363,"_27392":57387,"_2946":57914},[],"`mtls_options`",{"_3461":2826,"_30106":2626,"_20907":57916,"_5":14363,"_27392":57387,"_2946":57917},[],"When the legacy mTLS certificate and key are both PEM, they move into `mtls_options.cert_content` and `mtls_options.key_content` and need no action. Two cases do need it.",{"_3461":2827,"_30106":2626,"_20907":57919,"_5":14363,"_27392":57387,"_2946":57920},[],"**Webhooks with file references.** A mixed config, with a PEM certificate and a file-path key, is migrated to `mtls_options.cert_file` and `mtls_options.key_file`. Webhook delivery rejects those fields on every call, whatever the configured authentication mode, so every enroll and re-enroll that calls that webhook fails until the config is fixed. If the webhook uses mTLS, re-enter the certificate and key as Base64-encoded or plain PEM; if it does not, remove the leftover file fields. Metadata-only updates keep working in the meantime (`PUT` or `PATCH` on `/v1/dms/:id/metadata`). In a variant of the same problem, a stored config with file paths inside `mtls_options.cert_content` or `mtls_options.key_content` makes every full settings update (`POST /v1/dms` or `PUT /v1/dms/:id`) fail validation; settings are replaced wholesale, so resend the config with the certificate and key as PEM.",{"_3461":2828,"_30106":2626,"_20907":57922,"_5":14363,"_27392":57387,"_2946":57923},[],"**Receiver certificate verification.** A config with `validate_server_cert: false` becomes `insecure_skip_verify: true`, so receiver verification stays skipped until that field is set to `false`. Correct it on every migrated config: the webhook authorization channel carries the API key or bearer token, and skipping verification exposes those credentials to a network-positioned attacker. Keep `insecure_skip_verify: true` only when the receiver certificate is deliberately unverifiable.",{"_3461":2829,"_30106":2626,"_20907":57925,"_5":14363,"_27392":57391,"_2946":57926},[],"The flat field `reenrollment_settings.additional_validation_cas` moves into the nested field `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`:",{"_3461":2830,"_30106":2626,"_20907":57928,"_5":14363,"_27392":57391,"_2946":57929},[],"The effective trust set does not change, because the nested value was never consulted when validating re-enrollments. If the flat list was missing or null, it becomes an empty list.",{"_3461":2831,"_30106":2626,"_20907":57931,"_5":14363,"_27392":57391,"_2946":57932},[],"What changes is how API requests are handled. Bodies that still carry `additional_validation_cas` are accepted, but the value is silently dropped because unknown JSON fields are ignored, and GET responses no longer include it. An update body built from the old layout therefore empties `validation_cas` without any error. Always read the DMS before sending an edit and reuse the layout the API returns.",{"_3461":2832,"_30106":2626,"_20907":57934,"_5":14363,"_27392":57395,"_2946":57935},[],"Re-enrollment authentication settings are now stored independently from initial authentication. Nothing needs migrating, but read both blocks before editing a DMS so that you do not modify one while believing you are editing the other. The console exposes independent editors for both blocks; the DMS guide describes their fields, and you can also edit them through the DMS API.",{"_3461":2833,"_30106":2626,"_20907":57937,"_5":14363,"_27392":57399,"_2946":57938},[],"`PUT /v1/dms/:id` takes the DMS ID from the URL and validates the request body. An ID in the body is ignored, so update clients that relied on it.",{"_3461":2834,"_30106":2626,"_20907":57940,"_5":14363,"_27392":57403,"_2946":57941},[],"Stored certificate type values are renamed: `IMPORTED` becomes `IMPORTED_WITH_KEY` and `EXTERNAL` becomes `IMPORTED_WITHOUT_KEY`. `MANAGED` is unchanged. Adapt consumers that read or match on those values.",{"_3461":2835,"_30106":2626,"_20907":57943,"_5":14363,"_27392":57407,"_2946":57944},[],"The `events` field no longer appears in the device representation. Point consumers at the new endpoints:",{"_3461":2836,"_30106":2626,"_20907":57946,"_5":14363,"_27392":57407,"_2946":57947},[],"`GET /v1/devices/:id/events` returns a device's events.",{"_3461":2837,"_30106":2626,"_20907":57949,"_5":14363,"_27392":57407,"_2946":57950},[],"`POST /v1/devices/:id/events` creates an event.",{"_3461":2838,"_30106":2626,"_20907":57952,"_5":14363,"_27392":57407,"_2946":57953},[],"When the request `Accept` header includes `text/event-stream`, the events endpoint streams over SSE with a keepalive every 15 seconds, and returns `501` when SSE is disabled in the deployment. Each Device Manager instance binds a durable AMQP queue named after its service ID, `device-manager-sse-<uuid>`. Queues from crashed or replaced instances linger until removed, so configure an expiration or cleanup policy on the broker.",{"_3461":2839,"_30106":2626,"_20907":57955,"_5":14363,"_27392":57411,"_2946":57956},[],"`crl_options.subject_key_id_signer` is replaced by the required `crl_options.signer_serial_number`, the serial number of the existing certificate that signs the CRL. A new CA's initial value is the serial number of its current certificate. Requests that still carry `subject_key_id_signer` return an error. The authorization entity that holds these settings is also renamed; see CRL settings keyed by CA ID.",{"_3461":2840,"_30106":2626,"_20907":57958,"_5":14363,"_27392":57415,"_2946":57959},[],"In 3.8.0 the VA keyed each CRL by the CA's SKI, and `GET`/`PUT /v1/roles/{ca-ski}` read and updated it. In 4.0.0 the CRL settings of a CA are keyed by its CA ID, and every CA has its own, even when two CAs share a key:",{"_3461":2841,"_30106":2626,"_20907":57961,"_5":14363,"_27392":57415,"_2946":57962},[],"Route",{"_3461":2842,"_30106":2626,"_20907":57964,"_5":14363,"_27392":57415,"_2946":52360},[],{"_3461":2843,"_30106":2626,"_20907":57966,"_5":14363,"_27392":57415,"_2946":57967},[],"`GET /v1/crl-settings`",{"_3461":2844,"_30106":2626,"_20907":57969,"_5":14363,"_27392":57415,"_2946":57970},[],"Lists the CRL settings; filterable at least by `ca_id`, `status` and `legacy_ski`.",{"_3461":2845,"_30106":2626,"_20907":57972,"_5":14363,"_27392":57415,"_2946":57973},[],"`GET /v1/crl-settings/{ca-id}`",{"_3461":2846,"_30106":2626,"_20907":57975,"_5":14363,"_27392":57415,"_2946":57976},[],"Reads the settings of a CA.",{"_3461":2847,"_30106":2626,"_20907":57978,"_5":14363,"_27392":57415,"_2946":57979},[],"`PUT /v1/crl-settings/{ca-id}`",{"_3461":2848,"_30106":2626,"_20907":57981,"_5":14363,"_27392":57415,"_2946":57982},[],"Replaces `crl_options`.",{"_3461":2849,"_30106":2626,"_20907":57984,"_5":14363,"_27392":57415,"_2946":57985},[],"The options keep their meaning and their defaults: 7 days of `validity`, 6 days and 23 hours of `refresh_interval`, and `regenerate_on_revoke` `true`. `status` (`ACTIVE` or `ARCHIVED`), `legacy_ski` and `latest_crl` are read-only. A `PUT` validates the signer only when it changes, does not regenerate the CRL, and returns `409` when the settings are not `ACTIVE`.",{"_3461":2850,"_30106":2626,"_20907":57987,"_5":14363,"_27392":57415,"_2946":57988},[],"The public endpoint `GET /crl/{id}` takes the CA ID — the form the CDPs of newly issued certificates use — and keeps resolving the SKI form of certificates issued before the upgrade. Certificates issued before the upgrade keep their `/crl/<ski>` distribution points; newly issued ones carry `/crl/<ca-id>`, and both resolve to the same settings. The VA scheduled CRL job requests a new list on its first run, and the new list includes both URLs in its *Issuing Distribution Point*. Until it succeeds, the old list has only the legacy `/crl/<ski>` IDP: verifiers that compare it with the CDP of newly issued certificates cannot validate those certificates. The default schedule can delay the first run by up to about an hour; failures can extend the window.",{"_3461":2851,"_30106":2626,"_20907":57990,"_5":14363,"_27392":57415,"_2946":57991},[],"The migration that turns VA roles into CRL settings cannot be rolled back: its rollback does nothing. CRLs generated after the upgrade are stored under the CA ID, where 3.8.0 does not look for them, and the archived settings of CAs deleted before the upgrade have no signer to go back to. Returning to 3.8.0 requires restoring both the database and the CRL bucket — the object storage that holds the published lists — from the backups taken before the upgrade.",{"_3461":2852,"_30106":2626,"_20907":57993,"_5":14363,"_27392":57415,"_2946":57994},[],"The migration aborts, and the upgrade fails, on five kinds of data:",{"_3461":2853,"_30106":2626,"_20907":57996,"_5":14363,"_27392":57415,"_2946":57997},[],"CA IDs containing `/`: they cannot be used in CRL URLs. Recreate those CAs with a different ID.",{"_3461":2854,"_30106":2626,"_20907":57999,"_5":14363,"_27392":57415,"_2946":58000},[],"An SKI shared by more than one CA: the error names the SKIs and asks you to recreate all but one of them on a different key.",{"_3461":2855,"_30106":2626,"_20907":58002,"_5":14363,"_27392":57415,"_2946":58003},[],"A VA role whose signer certificate has no key: point the role to a signer with a key, or fix the key reference of the certificate, before upgrading.",{"_3461":2856,"_30106":2626,"_20907":58005,"_5":14363,"_27392":57415,"_2946":58006},[],"A CA whose ID equals the `legacy-<ski>` ID the migration reserves for the archived settings of another role whose CA was deleted: recreate that CA with a different ID.",{"_3461":2857,"_30106":2626,"_20907":58008,"_5":14363,"_27392":57415,"_2946":58009},[],"A CA ID equal to the SKI of another VA role: their CRL URLs would be ambiguous.",{"_3461":2858,"_30106":2626,"_20907":58011,"_5":14363,"_27392":57415,"_2946":58012},[],"The settings of a CA deleted before the upgrade are migrated as `ARCHIVED`, with a `legacy-<ski>` ID and no signer: their last CRL is still served, but never regenerated, and `PUT` returns `409`. There is no API way back to `ACTIVE`. The CRL guide describes the full behavior.",{"_3461":2859,"_30106":2626,"_20907":58014,"_5":14363,"_27392":57415,"_2946":58015},[],"**Custom authorization policies.** The entity `va_role` is renamed to `crl_settings`, with `ca_id` as its primary key and `signer_serial_number` as its relation to certificates. Update policies referencing the old entity. Replace the 3.8.0 signer filter `crl_subject_key_id_signer` (or `crl_signer_certificate_serial_number` if used by an intermediate version) with `signer_serial_number`. Replace SKI filter values with the corresponding certificate serial numbers; renaming the filter alone is insufficient.",{"_3461":2860,"_30106":2626,"_20907":58017,"_5":14363,"_27392":57419,"_2946":58018},[],"`va.role.update` becomes `va.crl-settings.update` and `va.role.crl.init` becomes `va.crl-settings.init`; `va.role.crl.create` keeps its name and its payload. Every subject changes from `crl/<ski>` to `crl/<ca-id>`, and the payload of the renamed events changes from the old VA role to the CRL settings of the CA, with `ca_id` instead of `ca_ski`. The alerts migration renames the event types of existing subscriptions automatically, but it does not rewrite their conditions — JSON Path, JSON Schema or JavaScript: review conditions that filter on the old payload or on the old `crl/<ski>` subject, including those for `va.role.crl.create`. Direct event-bus consumers and audit searches must adopt the new names and payload themselves.",{"_3461":2861,"_30106":2626,"_20907":58020,"_5":14363,"_27392":57423,"_2946":58021},[],"Creating or importing a CA registers it under a backend-generated UUID. Any `id` sent in the request body is ignored, and the field is removed from the create and import bodies. Scripts that supplied their own IDs and addressed CAs by them must read the ID the backend returns instead.",{"_3461":2862,"_30106":2626,"_20907":58023,"_5":14363,"_27392":57427,"_2946":58024},[],"The VA migration resolves each role's signer from its stored SKI. It first looks for CA certificates with that SKI; if several match, it selects the oldest CA and logs a warning. If no CA certificate matches, it looks among all certificates with that SKI. The migration aborts with `cannot resolve signer certificate for VA role <ca-ski>, SKI <ski>` if that fallback finds zero or multiple candidates. Fix affected roles before upgrading.",{"_3461":2863,"_30106":2626,"_20907":58026,"_5":14363,"_27392":57431,"_2946":58027},[],"The upgrade runs in a fixed order: prepare the data and values, run `helm upgrade`, then copy the KMS and VA data into the new volumes. The copy must run after the upgrade, because the destination StatefulSets and PVCs do not exist before it. If you are not upgrading an existing release, go straight to Install with Helm.",{"_3461":2864,"_30106":2626,"_20907":58029,"_5":14363,"_27392":57435,"_2946":58030},[],"Take a verifiable backup of PostgreSQL and of the CRL object storage — the VA bucket, or the local volume that holds the CRLs — and schedule downtime. The upgrade moves every service's data into `pki`, and the VA migration is irreversible: returning to 3.8.0 needs both backups (see CRL settings keyed by CA ID).",{"_3461":2865,"_30106":2626,"_20907":58032,"_5":14363,"_27392":57435,"_2946":58033},[],"If the deployment runs on SQLite, `couch_db` or `dynamo_db`, move it to PostgreSQL first.",{"_3461":2866,"_30106":2626,"_20907":58035,"_5":14363,"_27392":57435,"_2946":58036},[],"Resolve duplicate CA IDs and backfill `engine_id` in `kms_keys`, as described in PostgreSQL consolidation.",{"_3461":2867,"_30106":2626,"_20907":58038,"_5":14363,"_27392":57435,"_2946":58039},[],"Optionally, run the pre-upgrade check against the consolidated 3.8.0 data before applying the migrations.",{"_3461":2868,"_30106":2626,"_20907":58041,"_5":14363,"_27392":57435,"_2946":58042},[],"Record the names of your local-storage PVCs:",{"_3461":2869,"_30106":2626,"_20907":58044,"_5":14363,"_27392":57435,"_2946":58045},[],"`helm upgrade` does not touch or delete the old PVCs, but nothing references them after the upgrade. You need their names to copy the data and to clean up later.",{"_3461":2870,"_30106":2626,"_20907":58047,"_5":14363,"_27392":57439,"_2946":58048},[],"The 4.0.0 database migrations refuse data they cannot migrate safely: they abort and name the offending objects. The `upgrade-check` tool reports all of those problems before the upgrade, in one run, with the same wording the migration would use. It is read-only: it never writes database rows or keys.",{"_3461":2871,"_30106":2626,"_20907":58050,"_5":14363,"_27392":57439,"_2946":58051},[],"Image: `ghcr.io/lamassuiot/lamassu-upgrade-check`. Configure it with a KMS-style YAML file passed through `LAMASSU_CONFIG_FILE`; only the `postgres` storage provider is supported.",{"_3461":2872,"_30106":2626,"_20907":58053,"_5":14363,"_27392":57439,"_2946":58054},[],"Run it on the 3.8.0 data after it has been consolidated into the `pki` schemas, and before any 4.0.0 migration runs or any 4.0.0 service starts.",{"_3461":2873,"_30106":2626,"_20907":58056,"_5":14363,"_27392":57439,"_2946":58057},[],"Exit codes: `0` means no problems were found, `1` means at least one problem was found, and `2` means the command could not run (bad configuration, unreachable database, or a database that is not a 3.8.0 one), or a check could not run.",{"_3461":2874,"_30106":2626,"_20907":58059,"_5":14363,"_27392":57439,"_2946":58060},[],"It covers the VA migrations only: an all-clear does not prove that the CA and KMS migration guards pass, so it does not replace the duplicate CA ID and `engine_id` checks described in PostgreSQL consolidation.",{"_3461":2875,"_30106":2626,"_20907":58062,"_5":14363,"_27392":57443,"_2946":58063},[],"**Add `services.authz`.** Configure the JWKS endpoint, the database mappings and the bootstrap principal:",{"_3461":2876,"_30106":2626,"_20907":58065,"_5":14363,"_27392":57443,"_2946":58066},[],"`jwkUrl` is fetched from the `authz` pod, not from the gateway, so a Service in the release namespace can be referenced by its short name. The default points at a Keycloak Service named `auth-keycloak`; set it explicitly if your identity provider lives anywhere else.",{"_3461":2877,"_30106":2626,"_20907":58068,"_5":14363,"_27392":57443,"_2946":58069},[],"`authz` is the authorization service's own storage for principals, grants and policies. `pki` is the database the authorization engine queries when it evaluates policies against entities. Only the `database` field of each entry is read; the connection always uses the global `postgres.hostname`, `postgres.port`, `postgres.username` and `postgres.password` values.",{"_3461":2878,"_30106":2626,"_20907":58071,"_5":14363,"_27392":57443,"_2946":58072},[],"If you kept the 3.8.0 role defaults (`realm_access.roles` and `pki-admin`), the default `services.authz.bootstrap` already matches them.",{"_3461":2879,"_30106":2626,"_20907":58074,"_5":14363,"_27392":57443,"_2946":58075},[],"**Delete the gateway token validation blocks.** Remove `auth.oidc.apiGateway` and `auth.authorization` once their settings are in `services.authz`:",{"_3461":2880,"_30106":2626,"_20907":58077,"_5":14363,"_27392":57443,"_2946":58078},[],"**Rename `toolbox` to `connectivityTest`:**",{"_3461":2881,"_30106":2626,"_20907":58080,"_5":14363,"_27392":57443,"_2946":58081},[],"**Remove the per-service identity overrides** `services.kms.securityContext.runAsGroup` and `services.authz.securityContext.runAsUser`/`runAsGroup`.",{"_3461":2882,"_30106":2626,"_20907":58083,"_5":14363,"_27392":57443,"_2946":58084},[],"**Convert `services.connectors` to a map** keyed by connector ID, each entry with its `type` and `image`:",{"_3461":2883,"_30106":2626,"_20907":58086,"_5":14363,"_27392":57443,"_2946":58087},[],"**Check AMQP.** If you set `amqp.tls: true`, also set `amqp.port` to the broker's TLS listener (commonly `5671`), or set `amqp.tls: false` to stay on plaintext.",{"_3461":2884,"_30106":2626,"_20907":58089,"_5":14363,"_27392":57443,"_2946":58090},[],"**Enable the CA-to-KMS migration** if your CA keys predate the KMS:",{"_3461":2885,"_30106":2626,"_20907":58092,"_5":14363,"_27392":57443,"_2946":58093},[],"**Review the remaining values:** overrides that pinned `services.ui.port` to `80`, the old `probes:` block, the TLS issuer, and explicit `affinity` and `topologySpreadConstraints` where your cluster needs them. Renamed and reshaped values describes each one.",{"_3461":2886,"_30106":2626,"_20907":58095,"_5":14363,"_27392":57443,"_2946":58096},[],"Run `helm lint` with the new values before upgrading; the strict schema reports any key that is still unknown.",{"_3461":2887,"_30106":2626,"_20907":58098,"_5":14363,"_27392":57447,"_2946":58099},[],"Helm runs the pre-upgrade hooks — the CA-to-KMS migration when enabled, and the database job — before applying any workload, so services never start against an unprepared database. If validation rejects unknown values, fix the values file and re-run.",{"_3461":2888,"_30106":2626,"_20907":58101,"_5":14363,"_27392":57447,"_2946":58102},[],"If the deployment uses local KMS or VA storage, those pods fail until you complete step 4, so `--wait` cannot succeed: Helm waits for them to become ready, times out, exits with an error and marks the release `failed`. The hooks have already run by then, and every manifest, including the new StatefulSets and their PVCs, has been applied. Helm does not roll anything back without `--atomic`. Continue with step 4, then re-run the same `helm upgrade` command so it completes and Helm records the release as `deployed`. Both hooks are idempotent, so they are safe to run again.",{"_3461":2889,"_30106":2626,"_20907":58104,"_5":14363,"_27392":57451,"_2946":58105},[],"Skip this step when `services.kms.cryptoEngines` never used a `filesystem` engine and `services.va.fileStore.type` was never `local`.",{"_3461":2890,"_30106":2626,"_20907":58107,"_5":14363,"_27392":57451,"_2946":58108},[],"**Find the new StatefulSets and PVCs.** Their names depend on the release name and any `nameOverride` or `fullnameOverride`; the PVC name is `<volumeClaimTemplate>-<StatefulSet name>-0`:",{"_3461":2891,"_30106":2626,"_20907":58110,"_5":14363,"_27392":57451,"_2946":58111},[],"With release `lamassu` and the default chart name, the new PVCs are `golang-engine-storage-lamassu-kms-0` and `local-crl-file-storage-lamassu-va-0`; with release `prod` they are `golang-engine-storage-prod-lamassu-kms-0` and `local-crl-file-storage-prod-lamassu-va-0`. Confirm both old and new PVCs exist before continuing. If `claims_ok` prints `ABORT`, the block stops before listing the claims: either a StatefulSet lookup failed, or a new claim resolves to the 3.8.0 claim. In the second case the copy would verify against itself and the final cleanup would delete the live volume. The chart always appends `-kms` and `-va` to the release-scoped name, so a collision means the claims are not what this guide expects; investigate before going on. Item 3 runs the same check and refuses to create the helper pod, so nothing touches the volumes. The check returns instead of calling `exit`, which would close your shell and lose the variables set so far. If you only migrate one of the two services, drop the other one's claims from the commands that follow.",{"_3461":2892,"_30106":2626,"_20907":58113,"_5":14363,"_27392":57451,"_2946":58114},[],"**Record the replica counts, scale the new StatefulSets down and wait for every pod that uses the claims to exit**, so nothing writes to either volume while you copy. Helm removes the 3.8.0 `kms` and `va` StatefulSets during the upgrade, but their pods `kms-0` and `va-0` can still be terminating and holding the old claims. While they run, the helper pod either cannot attach the claims or copies a volume that is still being written. The `wait` returns at once for pods that are already gone:",{"_3461":2893,"_30106":2626,"_20907":58116,"_5":14363,"_27392":57451,"_2946":58117},[],"**Run a short-lived helper pod** that mounts all four claims. It runs as root so it can change file ownership, so pin its image by digest and do not mount the service-account token:",{"_3461":2894,"_30106":2626,"_20907":58119,"_5":14363,"_27392":57451,"_2946":58120},[],"**Inspect before writing** so you do not clobber data the new pods may already have written:",{"_3461":2895,"_30106":2626,"_20907":58122,"_5":14363,"_27392":57451,"_2946":58123},[],"An empty result is the common case: a StatefulSet's own pod rarely gets far enough to write anything when its dependent data is missing. If the output is not empty, record the files and confirm with the service owner that they are disposable before you run the copy; do not overlay the 3.8.0 data onto an unknown store.",{"_3461":2896,"_30106":2626,"_20907":58125,"_5":14363,"_27392":57451,"_2946":58126},[],"**Copy the data, align ownership and verify the copy.** The second command must print `copy verified`; any `diff` output means the copy is incomplete, so do not continue:",{"_3461":2897,"_30106":2626,"_20907":58128,"_5":14363,"_27392":57451,"_2946":58129},[],"The `chown` is required even if the old files already look non-root-owned, because 4.0.0 requires exactly `65532:65532` and does not fall back to whatever the image declares.",{"_3461":2898,"_30106":2626,"_20907":58131,"_5":14363,"_27392":57451,"_2946":58132},[],"**Remove the helper and restore the recorded replica counts:**",{"_3461":2899,"_30106":2626,"_20907":58134,"_5":14363,"_27392":57451,"_2946":58135},[],"**Re-run the step 3 `helm upgrade` command.** The KMS and VA pods now start against the copied data, so `--wait` succeeds and the release moves from `failed` to `deployed`.",{"_3461":2900,"_30106":2626,"_20907":58137,"_5":14363,"_27392":57455,"_2946":58138},[],"After the upgrade that performed the CA-to-KMS migration succeeds, remove `migrations.caToKms.enabled` from your values (it defaults to `false`). The hook reads the legacy 3.8.0 `kms-config` ConfigMap while it still exists and falls back to the release-scoped `<release>-lamassu-kms-config` once it is gone.",{"_3461":2901,"_30106":2626,"_20907":58140,"_5":14363,"_27392":57455,"_2946":58141},[],"Then go through the validation checklist. Keep the old PVCs until it passes.",{"_3461":2902,"_30106":2626,"_20907":58143,"_5":14363,"_27392":57459,"_2946":58144},[],"Without the chart's database job, no tool moves data between databases: the migration tooling only applies migrations to a schema that already exists. Move each per-service database into its `pki` schema yourself, preserving structure, indexes, constraints, data and migration history, with writes stopped and a verified backup in hand.",{"_3461":2903,"_30106":2626,"_20907":58146,"_5":14363,"_27392":57459,"_2946":58147},[],"Run the migrations in the required order, one schema at a time: `kms` first, then the `ca-to-kms-migration` tool (needed only for legacy deployments whose CA keys are named by SKI), then `ca`, then `va`. The `devicemanager`, `dmsmanager` and `alerts` schemas are independent and can be migrated in any order. With Helm, the chart's pre-install job applies the schemas in the correct order automatically.",{"_3461":2904,"_30106":2626,"_20907":58149,"_5":14363,"_27392":57459,"_2946":58150},[],"If `kms` has not been migrated, the `ca` migration fails with `kms schema not found: migrate the kms schema before the ca schema`. The `va` migration likewise requires `ca` to be migrated first.",{"_3461":2905,"_30106":2626,"_20907":58152,"_5":14363,"_27392":57459,"_2946":58153},[],"The schemas reference each other, so the PostgreSQL role running the migrations needs cross-schema privileges: the `ca` schema needs `USAGE` on `kms` plus `SELECT`, `REFERENCES` and `INSERT` on `kms.kms_keys`, and the `va` schema needs `USAGE` on `ca` plus `SELECT` and `REFERENCES` on `ca.certificates` and `SELECT` on `ca.ca_certificates`. Without them the migration aborts; grant the missing privileges and rerun the failed schema. After migrating `ca`, if the CA service runs as a different user than the migration user, grant it `SELECT` on `ca.certificates_view` (`GRANT SELECT ON ca.certificates_view TO service_user`). Without this grant, certificate and CA reads fail with `permission denied for table certificates_view`.",{"_3461":2906,"_30106":2626,"_20907":58155,"_5":14363,"_27392":57459,"_2946":58156},[],"To apply migrations by hand, `goose-lamassu` must run against the `pki` database with `search_path=<schema>` in the connection string. The binary validates only `search_path`, not the database name, so check `dbname=pki` before running it, and repeat for `kms`, `ca`, `va`, `devicemanager`, `dmsmanager` and `alerts`:",{"_3461":2907,"_30106":2626,"_20907":58158,"_5":14363,"_27392":57459,"_2946":58159},[],"Run `ca-to-kms-migration` first with `--dry-run`, which reports without writing to KMS storage, and then for real:",{"_3461":2908,"_30106":2626,"_20907":58161,"_5":14363,"_27392":57459,"_2946":58162},[],"Point the tool's `storage` configuration at the `pki` database, where the CA and KMS data now live in the `ca` and `kms` schemas. The tool's options are described in `backend/cmd/ca-to-kms-migration/README.md` in the `lamassuiot` repository.",{"_3461":2909,"_30106":2626,"_20907":58164,"_5":14363,"_27392":57459,"_2946":58165},[],"Both tools' READMEs document the 4.0.0 `pki` layout and match this page: `goose-lamassu` uses `dbname=pki` examples and does not validate the database name, and the `ca-to-kms-migration` README describes the single `pki` database and the migration order.",{"_3461":2910,"_30106":2626,"_20907":58167,"_5":14363,"_27392":57463,"_2946":58168},[],"**KMS or VA pods crash with `no such file or directory` or `code=NotFound` right after the upgrade.** The pods are bound to the new, empty PVCs and the data migration has not run yet, or was copied into the wrong PVC. Follow step 4 and check that all four claims exist.",{"_3461":2911,"_30106":2626,"_20907":58170,"_5":14363,"_27392":57463,"_2946":58171},[],"**`helm upgrade --wait` times out and `helm status` reports the release as `failed`.** With local KMS or VA storage this is expected on the first run: the new pods cannot become ready before their data is copied. The hooks ran and the manifests and PVCs were applied, so complete step 4 and re-run the same `helm upgrade` command. If other pods are also not ready, check their logs, because something else is wrong.",{"_3461":2912,"_30106":2626,"_20907":58173,"_5":14363,"_27392":57463,"_2946":58174},[],"**The helper pod stays `Pending` or `ContainerCreating` and `kubectl wait` times out.** Another pod still holds one of the claims; on block storage `kubectl describe pod pvc-migrate-helper` shows a `Multi-Attach error`. Check with `kubectl get pods -n $NAMESPACE` that `kms-0`, `va-0` and the new KMS and VA pods are gone, then re-run the wait.",{"_3461":2913,"_30106":2626,"_20907":58176,"_5":14363,"_27392":57463,"_2946":58177},[],"**`helm upgrade` fails with an unknown-key validation error.** Remove or rename the legacy values — typically `toolbox`, `auth.oidc.apiGateway` or `auth.authorization` — because the strict schema rejects keys it does not know.",{"_3461":2914,"_30106":2626,"_20907":58179,"_5":14363,"_27392":57463,"_2946":58180},[],"**The upgrade fails at the database job.** The PostgreSQL role cannot create databases or schemas, or a schema migration aborted: on duplicate CA IDs or missing `engine_id` values, or in the VA schema on a CA ID containing `/`, an SKI shared by more than one CA (the error asks you to recreate all but one of them on a different key), a role whose signer certificate has no key, a CA ID reserved for the archived settings of another role, or a CA ID equal to another role's SKI. The abort message names the offending objects; fix them and re-run the upgrade.",{"_3461":2915,"_30106":2626,"_20907":58182,"_5":14363,"_27392":57463,"_2946":58183},[],"**The upgrade fails at the CA-to-KMS hook.** CA certificates that share a `subject_key_id` declare conflicting `engine_id`s. Resolve the conflict and re-run.",{"_3461":2916,"_30106":2626,"_20907":58185,"_5":14363,"_27392":57463,"_2946":58186},[],"**Nobody can log in after the upgrade.** Check that `services.authz.jwkUrl` is reachable from the `authz` pod, that `services.authz.bootstrap` matches a role your OIDC provider actually assigns, and that the database job completed.",{"_3461":2917,"_30106":2626,"_20907":58188,"_5":14363,"_27392":57463,"_2946":58189},[],"**A migration aborts with `kms schema not found`.** The schemas must be migrated in order: run the `kms` schema migration before the `ca` schema migration.",{"_3461":2918,"_30106":2626,"_20907":58191,"_5":14363,"_27392":57463,"_2946":58192},[],"**A migration aborts with `ca schema not found`.** Run the `ca` schema migration before the `va` schema migration.",{"_3461":2919,"_30106":2626,"_20907":58194,"_5":14363,"_27392":57463,"_2946":58195},[],"**The VA migration fails with `cannot resolve signer certificate for VA role ... N candidates`.** The migration cannot uniquely identify a signer certificate from the SKI stored on the role. Review the SKI and candidate certificates reported in the error; correct the pre-migration data with a verified backup and rerun the migration. The new `signer_serial_number` field is created during that migration, so it cannot be set through the VA API while the migration is failing.",{"_3461":2920,"_30106":2626,"_20907":58197,"_5":14363,"_27392":57463,"_2946":58198},[],"**A migration or service fails with `permission denied for table ...`.** The PostgreSQL role is missing the cross-schema privileges listed in Deployments without Helm; this includes `certificates_view` when the post-migration `GRANT SELECT` was skipped. Grant the missing privileges and re-run.",{"_3461":2921,"_30106":2626,"_20907":58200,"_5":14363,"_27392":57466,"_2946":58201},[],"After the upgrade, check in this order:",{"_3461":2922,"_30106":2626,"_20907":58203,"_5":14363,"_27392":57466,"_2946":58204},[],"**Databases.** Each service reads the `pki` database with its own schema, `authz` and `wfx` data are reachable, and the migration status is registered per schema, including the CA unique-ID and KMS composite-key migrations and the foreign-key migrations that run per schema in the required order.",{"_3461":2923,"_30106":2626,"_20907":58206,"_5":14363,"_27392":57466,"_2946":58207},[],"**KMS and VA start cleanly.** Their logs show no `no such file or directory` or `code=NotFound` errors.",{"_3461":2924,"_30106":2626,"_20907":58209,"_5":14363,"_27392":57466,"_2946":58210},[],"**Existing KMS keys work.** Issue a certificate from a CA that existed before the upgrade. None of the other checks reads a KMS key, so this is the only one that proves the key material was copied.",{"_3461":2925,"_30106":2626,"_20907":58212,"_5":14363,"_27392":57466,"_2946":58213},[],"**Existing CRLs are served.** `GET /crl/<ca-id>` on VA returns a previously issued CRL, and `GET /crl/<ca-ski>` with the legacy SKI of a certificate issued before the upgrade also resolves. The VA scheduled CRL job has issued a new list under the CA ID with both URLs in its IDP; check its logs if regeneration has not succeeded.",{"_3461":2926,"_30106":2626,"_20907":58215,"_5":14363,"_27392":57466,"_2946":58216},[],"**Renamed VA events.** Alert subscriptions to `va.role.update` and `va.role.crl.init` now subscribe to `va.crl-settings.update` and `va.crl-settings.init`, and conditions for all VA events, including `va.role.crl.create`, have been reviewed against the new payload (`ca_id` instead of `ca_ski`) and subject (`crl/<ca-id>` instead of `crl/<ski>`). Direct consumers and audit searches use the new event names.",{"_3461":2927,"_30106":2626,"_20907":58218,"_5":14363,"_27392":57466,"_2946":58219},[],"**Legacy CA keys.** If the CA-to-KMS migration ran, review its report and warnings and confirm the expected keys appear in the KMS. Migrated CA certificates now report `key_id` and `has_private_key`, which you can use to confirm the registration.",{"_3461":2928,"_30106":2626,"_20907":58221,"_5":14363,"_27392":57466,"_2946":58222},[],"**Connectivity.** `helm test \"$RELEASE\" -n $NAMESPACE --logs` passes; the hook checks the CA, DMS Manager, Device Manager and VA health endpoints and the UI response.",{"_3461":2929,"_30106":2626,"_20907":58224,"_5":14363,"_27392":57466,"_2946":58225},[],"**Authorization.** Sign in as the bootstrap principal and confirm administration works, check that an identity without permissions receives `403`, and review client and integration permissions.",{"_3461":2930,"_30106":2626,"_20907":58227,"_5":14363,"_27392":57466,"_2946":58228},[],"**AMQP.** The backend connects to the broker with the expected TLS settings, and the cleanup policy for SSE queues is in place.",{"_3461":2931,"_30106":2626,"_20907":58230,"_5":14363,"_27392":57466,"_2946":58231},[],"**Device events.** `GET /v1/devices/:id/events` returns the historical events of a device that had them.",{"_3461":2932,"_30106":2626,"_20907":58233,"_5":14363,"_27392":57466,"_2946":58234},[],"**Webhooks without file fields.** For each DMS that uses a webhook for enrollment or re-enrollment, the `config` block carries `insecure_skip_verify` and the expected option block (`apikey_options`, `jwt_options` or `mtls_options`), with the certificate and key as PEM and no `cert_file` or `key_file`.",{"_3461":2933,"_30106":2626,"_20907":58236,"_5":14363,"_27392":57466,"_2946":58237},[],"**Receiver verification.** `insecure_skip_verify` is `false`, unless the receiver certificate is intentionally unverified.",{"_3461":2934,"_30106":2626,"_20907":58239,"_5":14363,"_27392":57466,"_2946":58240},[],"**Webhook delivery.** One enroll or re-enroll through each migrated webhook completes its authorization call.",{"_3461":2935,"_30106":2626,"_20907":58242,"_5":14363,"_27392":57466,"_2946":58243},[],"**Trust set.** `est_rfc7030_settings.client_certificate_settings.validation_cas` holds the expected CAs, in particular those of the old CA during rotation overlaps.",{"_3461":2936,"_30106":2626,"_20907":58245,"_5":14363,"_27392":57466,"_2946":58246},[],"**API clients.** Scripts and consoles no longer use the old DMS layout (flat `additional_validation_cas`, or the legacy `mtls`, `apikey` and `oidc` fields), send DMS updates with the ID in the URL, and match on the new certificate `type` values.",{"_3461":2937,"_30106":2626,"_20907":58248,"_5":14363,"_27392":57470,"_2946":58249},[],"Only once every check passes, delete the orphaned 3.8.0 volumes to reclaim storage. The delete is irreversible and the old KMS volume may hold the last copy of your CA key material, so take a `VolumeSnapshot` or a backup of both old PVCs first and keep it until you are confident the upgraded deployment is healthy. These are the fixed 3.8.0 names recorded in step 1; before deleting, confirm that neither is mounted by a running pod, for example with `kubectl describe pvc -n $NAMESPACE golang-engine-storage-kms-0 local-crl-file-storage-va-0`, where `Used By` must be `<none>`:",{"_3461":2938,"_30106":2626,"_20907":58251,"_5":14363,"_27392":57470,"_2946":58252},[],"The 3.8.0 per-service databases are no longer used either. Drop them only after the same checks pass and your PostgreSQL backup is verified.",{"_3461":2939,"_30106":2626,"_20907":58254,"_5":14363,"_27392":57470,"_2946":58255},[],"<Card title=\"Install with Helm\" description=\"Prepare dependencies, configure values and install a controlled deployment.\" href=\"/docs/deployment/self-hosted/helm\" />",{"_3461":2940,"_30106":2626,"_20907":58257,"_5":14363,"_27392":57470,"_2946":58258},[],"<Card title=\"Access control\" description=\"Principals, policies and the first administrator.\" href=\"/docs/platform/administration/access-control\" />",{"_3461":2941,"_30106":2626,"_20907":58260,"_5":14363,"_27392":57470,"_2946":58261},[],"<Card title=\"Configure a DMS\" description=\"Enrollment, re-enrollment and webhook settings.\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />","sorting",{"_58264":58265,"_58266":58267,"_58268":58269,"_58270":58271,"_18124":2981,"_69993":2981},"language","english","sortableProperties",[2946,30106,5,27392],"sortablePropertiesWithTypes",{"_2946":24973,"_30106":24973,"_5":24973,"_27392":24973},"sorts",{"_2946":58272,"_30106":61203,"_5":64133,"_27392":67063},{"_4641":58273,"_58274":58275,"_5":24973},{"_14439":4179,"_14820":6978,"_14839":3201,"_29109":5141,"_14826":6957,"_19839":6460,"_14460":9362,"_14467":10962,"_29051":4617,"_29460":6992,"_29481":4076,"_29085":4706,"_34421":5953,"_29188":7493,"_29525":4932,"_34428":4783,"_34431":10475,"_34434":6981,"_34437":12429,"_29932":6078,"_34442":3998,"_34444":3250,"_29962":4571,"_14835":18138,"_34448":3427,"_34451":7528,"_34453":6187,"_29509":4578,"_29927":3921,"_29975":4982,"_34458":4763,"_34460":11585,"_34462":4745,"_29205":3046,"_34465":6615,"_34467":7541,"_34469":10449,"_34471":3651,"_34473":19433,"_29122":4403,"_34476":5840,"_34478":3524,"_29116":15966,"_29546":4700,"_34482":5552,"_34484":3405,"_34487":9171,"_29162":6955,"_34491":4033,"_29042":5432,"_34494":7018,"_29090":4009,"_34497":11281,"_34499":3450,"_34502":16723,"_14829":7538,"_34505":17619,"_34507":12169,"_345