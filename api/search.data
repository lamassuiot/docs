7307},{"_3394":15,"_29710":15,"_5":14491,"_2880":48367,"_30042":48368,"_20617":48372,"_27008":15},"Deploy from AWS Marketplace",[48369,48370,48371],"Docs","Deployment","Other models",[],{"_3394":16,"_29710":15,"_20617":48374,"_5":14139,"_27008":15,"_2880":48375},[],"Run a preconfigured Lamassu IoT instance on Amazon EC2.",{"_3394":17,"_29710":15,"_5":30039,"_20617":48377,"_27008":48378,"_2880":48379},[],"/docs/deployment/aws-marketplace#before-you-begin","Before you begin",{"_3394":18,"_29710":15,"_5":30039,"_20617":48381,"_27008":48382,"_2880":48383},[],"/docs/deployment/aws-marketplace#infrastructure-requirements","Infrastructure requirements",{"_3394":19,"_29710":15,"_5":30039,"_20617":48385,"_27008":48386,"_2880":48387},[],"/docs/deployment/aws-marketplace#open-the-offer","Open the offer",{"_3394":20,"_29710":15,"_5":30039,"_20617":48389,"_27008":48390,"_2880":48391},[],"/docs/deployment/aws-marketplace#configure-the-instance","Configure the instance",{"_3394":21,"_29710":15,"_5":30039,"_20617":48393,"_27008":48394,"_2880":48395},[],"/docs/deployment/aws-marketplace#limit-network-access","Limit network access",{"_3394":22,"_29710":15,"_5":30039,"_20617":48397,"_27008":48398,"_2880":48399},[],"/docs/deployment/aws-marketplace#launch-and-verify","Launch and verify",{"_3394":23,"_29710":15,"_5":30039,"_20617":48401,"_27008":48402,"_2880":48403},[],"/docs/deployment/aws-marketplace#next-step","Next step",{"_3394":24,"_29710":15,"_20617":48405,"_5":14139,"_27008":15,"_2880":48406},[],"The AWS Marketplace offering reduces initial setup to an EC2 instance inside your account. You keep control of the network, storage and operation of the machine.",{"_3394":25,"_29710":15,"_20617":48408,"_5":14139,"_27008":48378,"_2880":48409},[],"Permissions to subscribe to AWS Marketplace products and launch EC2 instances.",{"_3394":26,"_29710":15,"_20617":48411,"_5":14139,"_27008":48378,"_2880":48412},[],"A VPC and a subnet from which administrators and devices can reach the instance.",{"_3394":27,"_29710":15,"_20617":48414,"_5":14139,"_27008":48378,"_2880":48415},[],"A security group allowing the necessary endpoints.",{"_3394":28,"_29710":15,"_20617":48417,"_5":14139,"_27008":48382,"_2880":48418},[],"**Compute:** a `t3.large` instance at minimum. Use `t3.xlarge` or higher when the load requires it.",{"_3394":29,"_29710":15,"_20617":48420,"_5":14139,"_27008":48382,"_2880":48421},[],"**Storage:** an EBS `gp3` volume of at least 50 GB, sized to your inventory and retention needs.",{"_3394":30,"_29710":15,"_20617":48423,"_5":14139,"_27008":48382,"_2880":48424},[],"**Network:** HTTPS access from the necessary consumers, restricted to trusted networks.",{"_3394":31,"_29710":15,"_20617":48426,"_5":14139,"_27008":48386,"_2880":48427},[],"Go to Lamassu IoT on AWS Marketplace and review the terms before subscribing.",{"_3394":32,"_29710":15,"_20617":48429,"_5":14139,"_27008":48390,"_2880":48430},[],"Select `t3.large` or higher, assign at least 50 GB of `gp3` storage and choose the target VPC and subnet.",{"_3394":33,"_29710":15,"_20617":48432,"_5":14139,"_27008":48394,"_2880":48433},[],"Configure the security group for ports `443`, `8443` and `9443`. Restrict the origins to the administrative and device networks that really need to connect.",{"_3394":34,"_29710":15,"_20617":48435,"_5":14139,"_27008":48398,"_2880":48436},[],"Start the instance and open the console at `https://<public-ip>`. Check you can authenticate before continuing.",{"_3394":35,"_29710":15,"_20617":48438,"_5":14139,"_27008":48402,"_2880":48439},[],"Continue with Create your first CA to validate the instance's cryptographic configuration.",{"_3394":36,"_29710":36,"_5":14491,"_2880":48441,"_30042":48442,"_20617":48443,"_27008":36},"Deploy Lamassu",[48369,48370],[],{"_3394":37,"_29710":36,"_20617":48445,"_5":14139,"_27008":36,"_2880":48446},[],"Choose the operating model that fits your infrastructure and control requirements.",{"_3394":38,"_29710":36,"_5":30039,"_20617":48448,"_27008":48449,"_2880":48450},[],"/docs/deployment/overview#choose-a-model","Choose a model",{"_3394":39,"_29710":36,"_5":30039,"_20617":48452,"_27008":48453,"_2880":48454},[],"/docs/deployment/overview#just-want-to-evaluate-the-platform","Just want to evaluate the platform?",{"_3394":40,"_29710":36,"_5":30039,"_20617":48456,"_27008":48457,"_2880":48458},[],"/docs/deployment/overview#after-deployment","After deployment",{"_3394":41,"_29710":36,"_20617":48460,"_5":14139,"_27008":36,"_2880":48461},[],"You can run Lamassu on your own Kubernetes cluster, deploy a prebuilt image from AWS Marketplace or consume the platform as a managed service.",{"_3394":42,"_29710":36,"_20617":48463,"_5":14139,"_27008":48449,"_2880":48464},[],"Model",{"_3394":43,"_29710":36,"_20617":48466,"_5":14139,"_27008":48449,"_2880":48467},[],"Recommended for",{"_3394":44,"_29710":36,"_20617":48469,"_5":14139,"_27008":48449,"_2880":48470},[],"Who operates the infrastructure",{"_3394":45,"_29710":36,"_20617":48472,"_5":14139,"_27008":48449,"_2880":48473},[],"Starting point",{"_3394":46,"_29710":36,"_20617":48475,"_5":14139,"_27008":48449,"_2880":48476},[],"Kubernetes self-managed",{"_3394":47,"_29710":36,"_20617":48478,"_5":14139,"_27008":48449,"_2880":48479},[],"Production, regulated environments and custom deployments",{"_3394":48,"_29710":36,"_20617":48481,"_5":14139,"_27008":48449,"_2880":48482},[],"Your team",{"_3394":49,"_29710":36,"_20617":48484,"_5":14139,"_27008":48449,"_2880":48485},[],"Helm or Fastlane",{"_3394":50,"_29710":36,"_20617":48487,"_5":14139,"_27008":48449,"_2880":48488},[],"AWS Marketplace",{"_3394":51,"_29710":36,"_20617":48490,"_5":14139,"_27008":48449,"_2880":48491},[],"Evaluation or a dedicated deployment inside an AWS account",{"_3394":52,"_29710":36,"_20617":48493,"_5":14139,"_27008":48449,"_2880":48482},[],{"_3394":53,"_29710":36,"_20617":48495,"_5":14139,"_27008":48449,"_2880":48496},[],"Preconfigured image on EC2",{"_3394":54,"_29710":36,"_20617":48498,"_5":14139,"_27008":48449,"_2880":48499},[],"SaaS",{"_3394":55,"_29710":36,"_20617":48501,"_5":14139,"_27008":48449,"_2880":48502},[],"Teams that want to use the platform without operating it",{"_3394":56,"_29710":36,"_20617":48504,"_5":14139,"_27008":48449,"_2880":48505},[],"Lamassu",{"_3394":57,"_29710":36,"_20617":48507,"_5":14139,"_27008":48449,"_2880":48508},[],"Managed subscription",{"_3394":58,"_29710":36,"_20617":48510,"_5":14139,"_27008":48449,"_2880":48511},[],"<Card title=\"Kubernetes self-managed\" description=\"Control network, storage, keys, dependencies and the upgrade cycle.\" href=\"/docs/deployment/self-hosted/overview\" />",{"_3394":59,"_29710":36,"_20617":48513,"_5":14139,"_27008":48449,"_2880":48514},[],"<Card title=\"AWS Marketplace\" description=\"Launch a preconfigured Lamassu instance on AWS EC2.\" href=\"/docs/deployment/aws-marketplace\" />",{"_3394":60,"_29710":36,"_20617":48516,"_5":14139,"_27008":48449,"_2880":48517},[],"<Card title=\"Lamassu SaaS\" description=\"Use an operated and updated instance as a managed service.\" href=\"/docs/deployment/saas\" />",{"_3394":61,"_29710":36,"_20617":48519,"_5":14139,"_27008":48453,"_2880":48520},[],"Use Fastlane to bring up PostgreSQL, Keycloak, RabbitMQ and Lamassu on a Kubernetes cluster through a single flow. It is intended for labs, demos and bootstrap; for production, configure dependencies and Helm values explicitly.",{"_3394":62,"_29710":36,"_20617":48522,"_5":14139,"_27008":48457,"_2880":48523},[],"Once the console is available, continue with Create your first CA. That quickstart verifies the cryptographic engine and issuance work correctly.",{"_3394":63,"_29710":63,"_5":14491,"_2880":48525,"_30042":48526,"_20617":48527,"_27008":63},"Use Lamassu as SaaS",[48369,48370,48371],[],{"_3394":64,"_29710":63,"_20617":48529,"_5":14139,"_27008":63,"_2880":48530},[],"Consume Lamassu as a managed service without operating your own infrastructure.",{"_3394":65,"_29710":63,"_5":30039,"_20617":48532,"_27008":48533,"_2880":48534},[],"/docs/deployment/saas#what-the-service-manages","What the service manages",{"_3394":66,"_29710":63,"_5":30039,"_20617":48536,"_27008":48537,"_2880":48538},[],"/docs/deployment/saas#plans","Plans",{"_3394":67,"_29710":63,"_5":30039,"_20617":48540,"_27008":48541,"_2880":48542},[],"/docs/deployment/saas#request-access","Request access",{"_3394":68,"_29710":63,"_20617":48544,"_5":14139,"_27008":63,"_2880":48545},[],"Lamassu SaaS offers the platform's capabilities in a managed environment. It is the right option when your team wants to focus on PKI and device identities, not on maintaining the infrastructure that supports them.",{"_3394":69,"_29710":63,"_20617":48547,"_5":14139,"_27008":48533,"_2880":48548},[],"Platform availability and maintenance.",{"_3394":70,"_29710":63,"_20617":48550,"_5":14139,"_27008":48533,"_2880":48551},[],"Automatic backups.",{"_3394":71,"_29710":63,"_20617":48553,"_5":14139,"_27008":48533,"_2880":48554},[],"Version upgrades.",{"_3394":72,"_29710":63,"_20617":48556,"_5":14139,"_27008":48533,"_2880":48557},[],"Technical support and SLA according to your plan.",{"_3394":73,"_29710":63,"_20617":48559,"_5":14139,"_27008":48537,"_2880":48560},[],"Plan",{"_3394":74,"_29710":63,"_20617":48562,"_5":14139,"_27008":48537,"_2880":48563},[],"Devices",{"_3394":75,"_29710":63,"_20617":48565,"_5":14139,"_27008":48537,"_2880":48566},[],"Support",{"_3394":76,"_29710":63,"_20617":48568,"_5":14139,"_27008":48537,"_2880":48569},[],"SLA",{"_3394":77,"_29710":63,"_20617":48571,"_5":14139,"_27008":48537,"_2880":48572},[],"Starter",{"_3394":78,"_29710":63,"_20617":48574,"_5":14139,"_27008":48537,"_2880":48575},[],"Up to 1,000",{"_3394":79,"_29710":63,"_20617":48577,"_5":14139,"_27008":48537,"_2880":48578},[],"Email",{"_3394":80,"_29710":63,"_20617":48580,"_5":14139,"_27008":48537,"_2880":48581},[],"99.5 %",{"_3394":81,"_29710":63,"_20617":48583,"_5":14139,"_27008":48537,"_2880":48584},[],"Professional",{"_3394":82,"_29710":63,"_20617":48586,"_5":14139,"_27008":48537,"_2880":48587},[],"Up to 10,000",{"_3394":83,"_29710":63,"_20617":48589,"_5":14139,"_27008":48537,"_2880":48590},[],"Email and chat",{"_3394":84,"_29710":63,"_20617":48592,"_5":14139,"_27008":48537,"_2880":48593},[],"99.9 %",{"_3394":85,"_29710":63,"_20617":48595,"_5":14139,"_27008":48537,"_2880":48596},[],"Enterprise",{"_3394":86,"_29710":63,"_20617":48598,"_5":14139,"_27008":48537,"_2880":48599},[],"Unlimited",{"_3394":87,"_29710":63,"_20617":48601,"_5":14139,"_27008":48537,"_2880":48602},[],"Dedicated",{"_3394":88,"_29710":63,"_20617":48604,"_5":14139,"_27008":48537,"_2880":48605},[],"99.99 %",{"_3394":89,"_29710":63,"_20617":48607,"_5":14139,"_27008":48541,"_2880":48608},[],"Contact the Lamassu team through lamassu.io to request a demo or choose a plan.",{"_3394":90,"_29710":63,"_20617":48610,"_5":14139,"_27008":48541,"_2880":48611},[],"When you receive your instance's credentials, continue with Get started.",{"_3394":91,"_29710":91,"_5":14491,"_2880":48613,"_30042":48614,"_20617":48615,"_27008":91},"Fastlane",[48369,48370,48476],[],{"_3394":92,"_29710":91,"_20617":48617,"_5":14139,"_27008":91,"_2880":48618},[],"Bootstrap a complete Lamassu evaluation or lab environment on an existing Kubernetes cluster.",{"_3394":93,"_29710":91,"_5":30039,"_20617":48620,"_27008":48621,"_2880":48622},[],"/docs/deployment/self-hosted/fastlane#deploy-with-fastlane","Deploy with Fastlane",{"_3394":94,"_29710":91,"_5":30039,"_20617":48624,"_27008":48625,"_2880":48626},[],"/docs/deployment/self-hosted/fastlane#what-fastlane-adds","What Fastlane adds",{"_3394":95,"_29710":91,"_5":30039,"_20617":48628,"_27008":48629,"_2880":48379},[],"/docs/deployment/self-hosted/fastlane#before-you-begin",{"_3394":96,"_29710":91,"_5":30039,"_20617":48631,"_27008":48632,"_2880":48633},[],"/docs/deployment/self-hosted/fastlane#quick-start","Quick start",{"_3394":97,"_29710":91,"_5":30039,"_20617":48635,"_27008":48636,"_2880":48637},[],"/docs/deployment/self-hosted/fastlane#gateway-address-selection","Gateway address selection",{"_3394":98,"_29710":91,"_5":30039,"_20617":48639,"_27008":48640,"_2880":48641},[],"/docs/deployment/self-hosted/fastlane#command-line-options","Command-line options",{"_3394":99,"_29710":91,"_5":30039,"_20617":48643,"_27008":48644,"_2880":48645},[],"/docs/deployment/self-hosted/fastlane#development-mode","Development mode",{"_3394":100,"_29710":91,"_5":30039,"_20617":48647,"_27008":48648,"_2880":48649},[],"/docs/deployment/self-hosted/fastlane#what-the-script-configures","What the script configures",{"_3394":101,"_29710":91,"_5":30039,"_20617":48651,"_27008":48652,"_2880":48653},[],"/docs/deployment/self-hosted/fastlane#tls-behavior","TLS behavior",{"_3394":102,"_29710":91,"_5":30039,"_20617":48655,"_27008":48656,"_2880":48657},[],"/docs/deployment/self-hosted/fastlane#credentials-and-generated-files","Credentials and generated files",{"_3394":103,"_29710":91,"_5":30039,"_20617":48659,"_27008":48660,"_2880":48661},[],"/docs/deployment/self-hosted/fastlane#verify-the-installation","Verify the installation",{"_3394":104,"_29710":91,"_20617":48663,"_5":14139,"_27008":48621,"_2880":48664},[],"Fastlane is the automated path for evaluations, demos, CI and small lab clusters. It installs PostgreSQL, Keycloak, RabbitMQ, Envoy Gateway and Lamassu, then configures them to work together.",{"_3394":105,"_29710":91,"_20617":48666,"_5":14139,"_27008":48621,"_2880":48667},[],"For production, use Helm so database, identity, credentials, certificates, storage and upgrades remain explicit.",{"_3394":106,"_29710":91,"_20617":48669,"_5":14139,"_27008":48625,"_2880":48670},[],"Fastlane closes some of the gaps intentionally left by the application chart:",{"_3394":107,"_29710":91,"_20617":48672,"_5":14139,"_27008":48625,"_2880":48673},[],"Fastlane installs or configures",{"_3394":108,"_29710":91,"_20617":48675,"_5":14139,"_27008":48625,"_2880":48676},[],"You still provide",{"_3394":109,"_29710":91,"_20617":48678,"_5":14139,"_27008":48625,"_2880":48679},[],"PostgreSQL, RabbitMQ and Keycloak instances for evaluation",{"_3394":110,"_29710":91,"_20617":48681,"_5":14139,"_27008":48625,"_2880":48682},[],"The Kubernetes cluster, nodes and persistent storage",{"_3394":111,"_29710":91,"_20617":48684,"_5":14139,"_27008":48625,"_2880":48685},[],"Envoy Gateway 1.8 and the `eg` `GatewayClass`",{"_3394":112,"_29710":91,"_20617":48687,"_5":14139,"_27008":48625,"_2880":48688},[],"cert-manager, external network reachability, DNS and firewall/NAT rules",{"_3394":113,"_29710":91,"_20617":48690,"_5":14139,"_27008":48625,"_2880":48691},[],"A self-signed Lamassu certificate flow, generated dependency credentials and an initial user",{"_3394":114,"_29710":91,"_20617":48693,"_5":14139,"_27008":48625,"_2880":48694},[],"Client trust for the self-signed CA, or a trusted certificate passed to the script",{"_3394":115,"_29710":91,"_20617":48696,"_5":14139,"_27008":48625,"_2880":48697},[],"Optional observability and lab HSM components",{"_3394":116,"_29710":91,"_20617":48699,"_5":14139,"_27008":48625,"_2880":48700},[],"Production monitoring retention, backups, HA and a production HSM/key service",{"_3394":117,"_29710":91,"_20617":48702,"_5":14139,"_27008":48625,"_2880":48703},[],"Fastlane does not turn the resulting stack into a production service: it does not create the cluster, public DNS, firewall rules, backups, high availability or a trusted public certificate.",{"_3394":118,"_29710":91,"_20617":48705,"_5":14139,"_27008":48629,"_2880":48706},[],"You need:",{"_3394":119,"_29710":91,"_20617":48708,"_5":14139,"_27008":48629,"_2880":48709},[],"an existing Kubernetes cluster",{"_3394":120,"_29710":91,"_20617":48711,"_5":14139,"_27008":48629,"_2880":48712},[],"`kubectl` and Helm, or the MicroK8s CLI",{"_3394":121,"_29710":91,"_20617":48714,"_5":14139,"_27008":48629,"_2880":48715},[],"`yq`",{"_3394":122,"_29710":91,"_20617":48717,"_5":14139,"_27008":48629,"_2880":23295},[],{"_3394":123,"_29710":91,"_20617":48719,"_5":14139,"_27008":48629,"_2880":48720},[],"`jq` only when using `--sample-data` or `--development`",{"_3394":124,"_29710":91,"_20617":48722,"_5":14139,"_27008":48629,"_2880":48723},[],"`ssh-keygen` only when using `--with-hsm`",{"_3394":125,"_29710":91,"_20617":48725,"_5":14139,"_27008":48629,"_2880":48726},[],"free external ports 80 and 443 on a single-node K3s host",{"_3394":126,"_29710":91,"_20617":48728,"_5":14139,"_27008":48629,"_2880":48729},[],"Fastlane detects MicroK8s, K3s, kind or a standard kubeconfig. Use `--context` when the intended cluster is not the current context.",{"_3394":127,"_29710":91,"_20617":48731,"_5":14139,"_27008":48629,"_2880":48732},[],"Fastlane installs several components and creates credentials. Check `kubectl config current-context` or pass `--context` before running it.",{"_3394":128,"_29710":91,"_20617":48734,"_5":14139,"_27008":48632,"_2880":48735},[],"Run the script from a clone of the Helm repository:",{"_3394":129,"_29710":91,"_20617":48737,"_5":14139,"_27008":48632,"_2880":48738},[],"Create a DNS record for the chosen domain before testing from another machine. For a small VM, point it at the VM or load-balancer address that actually receives ports 80 and 443.",{"_3394":130,"_29710":91,"_20617":48740,"_5":14139,"_27008":48636,"_2880":48741},[],"By default, Fastlane runs `hostname -I` and writes the returned addresses to `gateway.addresses` and to the self-signed certificate's IP SANs.",{"_3394":131,"_29710":91,"_20617":48743,"_5":14139,"_27008":48636,"_2880":48744},[],"On a single-homed lab VM this can select the expected node address. On hosts with Docker, VPN, WireGuard or several interfaces it can also select addresses clients cannot reach. Override the result explicitly:",{"_3394":132,"_29710":91,"_20617":48746,"_5":14139,"_27008":48636,"_2880":48747},[],"The value must be an address handled on the Kubernetes side of the traffic path. If a public EC2 address forwards through WireGuard to the cluster, pass the reachable cluster/VM address, not the EC2 public address.",{"_3394":133,"_29710":91,"_20617":48749,"_5":14139,"_27008":48636,"_2880":48750},[],"See Expose the Gateway for K3s port conflicts, VIPs, external NAT and multi-Gateway designs.",{"_3394":134,"_29710":91,"_20617":48752,"_5":14139,"_27008":48640,"_2880":48753},[],"Option",{"_3394":135,"_29710":91,"_20617":48755,"_5":14139,"_27008":48640,"_2880":48756},[],"Default",{"_3394":136,"_29710":91,"_20617":48758,"_5":14139,"_27008":48640,"_2880":48759},[],"Purpose",{"_3394":137,"_29710":91,"_20617":48761,"_5":14139,"_27008":48640,"_2880":48762},[],"`-h`, `--help`",{"_3394":138,"_29710":91,"_20617":48764,"_5":14139,"_27008":48640,"_2880":48765},[],"—",{"_3394":139,"_29710":91,"_20617":48767,"_5":14139,"_27008":48640,"_2880":48768},[],"Show help",{"_3394":140,"_29710":91,"_20617":48770,"_5":14139,"_27008":48640,"_2880":48771},[],"`-c`, `--context`",{"_3394":141,"_29710":91,"_20617":48773,"_5":14139,"_27008":48640,"_2880":48774},[],"current context",{"_3394":142,"_29710":91,"_20617":48776,"_5":14139,"_27008":48640,"_2880":48777},[],"Select the kubeconfig context for kubectl and Helm",{"_3394":143,"_29710":91,"_20617":48779,"_5":14139,"_27008":48640,"_2880":48780},[],"`-n`, `--non-interactive`",{"_3394":144,"_29710":91,"_20617":48782,"_5":14139,"_27008":48640,"_2880":6425},[],{"_3394":145,"_29710":91,"_20617":48784,"_5":14139,"_27008":48640,"_2880":48785},[],"Skip prompts and generate dependency credentials",{"_3394":146,"_29710":91,"_20617":48787,"_5":14139,"_27008":48640,"_2880":48788},[],"`-ns`, `--namespace`",{"_3394":147,"_29710":91,"_20617":48790,"_5":14139,"_27008":48640,"_2880":48791},[],"`lamassu-dev`",{"_3394":148,"_29710":91,"_20617":48793,"_5":14139,"_27008":48640,"_2880":48794},[],"Namespace for the installation",{"_3394":149,"_29710":91,"_20617":48796,"_5":14139,"_27008":48640,"_2880":48797},[],"`-d`, `--domain`",{"_3394":150,"_29710":91,"_20617":48799,"_5":14139,"_27008":48640,"_2880":48800},[],"`dev.lamassu.io`",{"_3394":151,"_29710":91,"_20617":48802,"_5":14139,"_27008":48640,"_2880":48803},[],"Domain used by the UI, OIDC and certificate",{"_3394":152,"_29710":91,"_20617":48805,"_5":14139,"_27008":48640,"_2880":48806},[],"`-v`, `--version`",{"_3394":153,"_29710":91,"_20617":48808,"_5":14139,"_27008":48640,"_2880":14825},[],{"_3394":154,"_29710":91,"_20617":48810,"_5":14139,"_27008":48640,"_2880":48811},[],"Lamassu chart version",{"_3394":155,"_29710":91,"_20617":48813,"_5":14139,"_27008":48640,"_2880":48814},[],"`--https-port`",{"_3394":156,"_29710":91,"_20617":48816,"_5":14139,"_27008":48640,"_2880":48817},[],"`443`",{"_3394":157,"_29710":91,"_20617":48819,"_5":14139,"_27008":48640,"_2880":48820},[],"Gateway HTTPS listener port",{"_3394":158,"_29710":91,"_20617":48822,"_5":14139,"_27008":48640,"_2880":48823},[],"`--http-port`",{"_3394":159,"_29710":91,"_20617":48825,"_5":14139,"_27008":48640,"_2880":48826},[],"`80`",{"_3394":160,"_29710":91,"_20617":48828,"_5":14139,"_27008":48640,"_2880":48829},[],"Gateway HTTP listener port",{"_3394":161,"_29710":91,"_20617":48831,"_5":14139,"_27008":48640,"_2880":48832},[],"`--tls-crt`",{"_3394":162,"_29710":91,"_20617":48834,"_5":14139,"_27008":48640,"_2880":48765},[],{"_3394":163,"_29710":91,"_20617":48836,"_5":14139,"_27008":48640,"_2880":48837},[],"PEM certificate for downstream TLS",{"_3394":164,"_29710":91,"_20617":48839,"_5":14139,"_27008":48640,"_2880":48840},[],"`--tls-key`",{"_3394":165,"_29710":91,"_20617":48842,"_5":14139,"_27008":48640,"_2880":48765},[],{"_3394":166,"_29710":91,"_20617":48844,"_5":14139,"_27008":48640,"_2880":48845},[],"PEM private key for downstream TLS",{"_3394":167,"_29710":91,"_20617":48847,"_5":14139,"_27008":48640,"_2880":48848},[],"`-l`, `--local-chart-path`",{"_3394":168,"_29710":91,"_20617":48850,"_5":14139,"_27008":48640,"_2880":48851},[],"repository chart",{"_3394":169,"_29710":91,"_20617":48853,"_5":14139,"_27008":48640,"_2880":48854},[],"Use an unpacked local Lamassu chart",{"_3394":170,"_29710":91,"_20617":48856,"_5":14139,"_27008":48640,"_2880":48857},[],"`-ip`, `--gateway-ip`",{"_3394":171,"_29710":91,"_20617":48859,"_5":14139,"_27008":48640,"_2880":8596},[],{"_3394":172,"_29710":91,"_20617":48861,"_5":14139,"_27008":48640,"_2880":48862},[],"Override the address written to `gateway.addresses`",{"_3394":173,"_29710":91,"_20617":48864,"_5":14139,"_27008":48640,"_2880":48865},[],"`--otel`",{"_3394":174,"_29710":91,"_20617":48867,"_5":14139,"_27008":48640,"_2880":6425},[],{"_3394":175,"_29710":91,"_20617":48869,"_5":14139,"_27008":48640,"_2880":48870},[],"Install Victoria Logs, VictoriaTraces, Jaeger and an OpenTelemetry Collector",{"_3394":176,"_29710":91,"_20617":48872,"_5":14139,"_27008":48640,"_2880":48873},[],"`--development`",{"_3394":177,"_29710":91,"_20617":48875,"_5":14139,"_27008":48640,"_2880":6425},[],{"_3394":178,"_29710":91,"_20617":48877,"_5":14139,"_27008":48640,"_2880":48878},[],"Development mode: fully provisions the Keycloak `lamassu` user (fixed `lamassu`/`lamassu` password, no first-login steps) and lets the `frontend` client accept any redirect URI or web origin. Not for production",{"_3394":179,"_29710":91,"_20617":48880,"_5":14139,"_27008":48640,"_2880":48881},[],"`--sample-data`",{"_3394":180,"_29710":91,"_20617":48883,"_5":14139,"_27008":48640,"_2880":6425},[],{"_3394":181,"_29710":91,"_20617":48885,"_5":14139,"_27008":48640,"_2880":48886},[],"Create sample CAs, profiles, certificates, DMS data and devices",{"_3394":182,"_29710":91,"_20617":48888,"_5":14139,"_27008":48640,"_2880":48889},[],"`--with-hsm`",{"_3394":183,"_29710":91,"_20617":48891,"_5":14139,"_27008":48640,"_2880":6425},[],{"_3394":184,"_29710":91,"_20617":48893,"_5":14139,"_27008":48640,"_2880":48894},[],"Install lab HSM components and configure KMS for PKCS#11",{"_3394":185,"_29710":91,"_20617":48896,"_5":14139,"_27008":48640,"_2880":48897},[],"`--softhsm-chart-path`",{"_3394":186,"_29710":91,"_20617":48899,"_5":14139,"_27008":48640,"_2880":48900},[],"`./charts/softhsm`",{"_3394":187,"_29710":91,"_20617":48902,"_5":14139,"_27008":48640,"_2880":48903},[],"Use a different local SoftHSM chart",{"_3394":188,"_29710":91,"_20617":48905,"_5":14139,"_27008":48640,"_2880":48906},[],"Fastlane does not provide an offline mode. Use the manual Helm workflow and a prepared registry/chart mirror for disconnected environments.",{"_3394":189,"_29710":91,"_20617":48908,"_5":14139,"_27008":48644,"_2880":48909},[],"`--development` adjusts the Keycloak `lamassu` realm generated by Fastlane for a disposable evaluation environment:",{"_3394":190,"_29710":91,"_20617":48911,"_5":14139,"_27008":48644,"_2880":48912},[],"the `lamassu` user is fully provisioned (first name Lamassu, last name Admin, email `lamassu@lamassu.io`, verified): there are no profile setup or password change steps on first login",{"_3394":191,"_29710":91,"_20617":48914,"_5":14139,"_27008":48644,"_2880":48915},[],"the well-known `lamassu`/`lamassu` password is fixed and permanent: it is never rotated and grants the `pki-admin` role, including non-interactive tokens through the `frontend` client",{"_3394":192,"_29710":91,"_20617":48917,"_5":14139,"_27008":48644,"_2880":48918},[],"the `frontend` client accepts any redirect URI and any web origin (`*`) instead of the original `/*` patterns",{"_3394":193,"_29710":91,"_20617":48920,"_5":14139,"_27008":48644,"_2880":48921},[],"With `--development`, the fixed `lamassu`/`lamassu` password grants `pki-admin` access to anyone who can reach the installation. Never use it on anything exposed beyond a development machine or a network-reachable host.",{"_3394":194,"_29710":91,"_20617":48923,"_5":14139,"_27008":48644,"_2880":48924},[],"`--development` applies when the `lamassu` realm is first imported. It does not modify an existing cluster. It can be combined with `--sample-data`: the development transform runs first, then sample data is added to the same realm configuration.",{"_3394":195,"_29710":91,"_20617":48926,"_5":14139,"_27008":48648,"_2880":48927},[],"Fastlane:",{"_3394":196,"_29710":91,"_20617":48929,"_5":14139,"_27008":48648,"_2880":48930},[],"validates local tools and the selected cluster",{"_3394":197,"_29710":91,"_20617":48932,"_5":14139,"_27008":48648,"_2880":48933},[],"installs or upgrades Envoy Gateway 1.8 and creates the `eg` `GatewayClass`",{"_3394":198,"_29710":91,"_20617":48935,"_5":14139,"_27008":48648,"_2880":48936},[],"creates the namespace",{"_3394":199,"_29710":91,"_20617":48938,"_5":14139,"_27008":48648,"_2880":48939},[],"installs PostgreSQL and creates the required databases",{"_3394":200,"_29710":91,"_20617":48941,"_5":14139,"_27008":48648,"_2880":48942},[],"installs Keycloak and creates the `lamassu` realm, frontend client, admin role and initial user",{"_3394":201,"_29710":91,"_20617":48944,"_5":14139,"_27008":48648,"_2880":48945},[],"installs RabbitMQ",{"_3394":202,"_29710":91,"_20617":48947,"_5":14139,"_27008":48648,"_2880":48948},[],"optionally installs observability and lab HSM components",{"_3394":203,"_29710":91,"_20617":48950,"_5":14139,"_27008":48648,"_2880":48951},[],"generates `lamassu.yaml` and installs the Lamassu chart",{"_3394":204,"_29710":91,"_20617":48953,"_5":14139,"_27008":48648,"_2880":48954},[],"optionally loads sample data",{"_3394":205,"_29710":91,"_20617":48956,"_5":14139,"_27008":48648,"_2880":48957},[],"The generated configuration exposes Keycloak at `/auth` through the same Gateway and bootstraps the initial `lamassu` user as a Lamassu super administrator.",{"_3394":206,"_29710":91,"_20617":48959,"_5":14139,"_27008":48652,"_2880":48960},[],"With both `--tls-crt` and `--tls-key`, Fastlane creates the `downstream-provided-crt` Secret and configures `tls.type: external`.",{"_3394":207,"_29710":91,"_20617":48962,"_5":14139,"_27008":48652,"_2880":48963},[],"Without them, it configures cert-manager with a self-signed issuer. This is suitable for a lab but will not be trusted by clients until you distribute the CA. Use Helm when you need a corporate Issuer, public ACME issuer or an existing Secret managed by another system.",{"_3394":208,"_29710":91,"_20617":48965,"_5":14139,"_27008":48656,"_2880":48966},[],"Non-interactive mode generates random PostgreSQL, RabbitMQ and Keycloak administrator passwords. The initial Lamassu login is `lamassu` / `lamassu` and requires a password change on first use, unless `--development` was used: in that case the password stays fixed and permanent.",{"_3394":209,"_29710":91,"_20617":48968,"_5":14139,"_27008":48656,"_2880":48969},[],"Fastlane writes `lamassu.yaml` in the current directory and injects credentials into it.",{"_3394":210,"_29710":91,"_20617":48971,"_5":14139,"_27008":48656,"_2880":48972},[],"Protect the generated values file, record the generated credentials in an appropriate secret store and do not reuse the evaluation identity setup in production.",{"_3394":211,"_29710":91,"_20617":48974,"_5":14139,"_27008":48660,"_2880":48975},[],"Then open `https://pki.example.com` and sign in with the initial user. If the Gateway is programmed but the URL is unreachable, follow the checks in Expose the Gateway.",{"_3394":212,"_29710":212,"_5":14491,"_2880":48977,"_30042":48978,"_20617":48979,"_27008":212},"Install with Helm",[48369,48370,48476],[],{"_3394":213,"_29710":212,"_20617":48981,"_5":14139,"_27008":212,"_2880":48982},[],"Prepare dependencies, configure the Lamassu chart and verify a controlled Kubernetes deployment.",{"_3394":214,"_29710":212,"_5":30039,"_20617":48984,"_27008":48985,"_2880":48986},[],"/docs/deployment/self-hosted/helm#install-lamassu-with-helm","Install Lamassu with Helm",{"_3394":215,"_29710":212,"_5":30039,"_20617":48988,"_27008":48989,"_2880":48379},[],"/docs/deployment/self-hosted/helm#before-you-begin",{"_3394":216,"_29710":212,"_5":30039,"_20617":48991,"_27008":48992,"_2880":48993},[],"/docs/deployment/self-hosted/helm#1-install-the-gateway-prerequisites","1\\. Install the Gateway prerequisites",{"_3394":217,"_29710":212,"_5":30039,"_20617":48995,"_27008":48996,"_2880":48997},[],"/docs/deployment/self-hosted/helm#2-create-a-values-file","2\\. Create a values file",{"_3394":218,"_29710":212,"_5":30039,"_20617":48999,"_27008":49000,"_2880":49001},[],"/docs/deployment/self-hosted/helm#tls-with-an-existing-secret","TLS with an existing Secret",{"_3394":219,"_29710":212,"_5":30039,"_20617":49003,"_27008":49004,"_2880":49005},[],"/docs/deployment/self-hosted/helm#amqp-tls-amqps","AMQP TLS (AMQPS)",{"_3394":220,"_29710":212,"_5":30039,"_20617":49007,"_27008":49008,"_2880":49009},[],"/docs/deployment/self-hosted/helm#provision-the-first-administrator","Provision the first administrator",{"_3394":221,"_29710":212,"_5":30039,"_20617":49011,"_27008":49012,"_2880":49013},[],"/docs/deployment/self-hosted/helm#3-install-lamassu","3\\. Install Lamassu",{"_3394":222,"_29710":212,"_5":30039,"_20617":49015,"_27008":49016,"_2880":49017},[],"/docs/deployment/self-hosted/helm#4-verify-the-deployment","4\\. Verify the deployment",{"_3394":223,"_29710":212,"_5":30039,"_20617":49019,"_27008":49020,"_2880":49021},[],"/docs/deployment/self-hosted/helm#upgrading-lamassu","Upgrading Lamassu",{"_3394":224,"_29710":212,"_5":30039,"_20617":49023,"_27008":49024,"_2880":49025},[],"/docs/deployment/self-hosted/helm#production-decisions","Production decisions",{"_3394":225,"_29710":212,"_20617":49027,"_5":14139,"_27008":48985,"_2880":49028},[],"Use the Helm workflow when you need explicit control over identity, databases, messaging, certificates, storage and upgrades. For an evaluation environment where the script can make those choices for you, use Fastlane.",{"_3394":226,"_29710":212,"_20617":49030,"_5":14139,"_27008":48989,"_2880":49031},[],"Prepare the platform services that are deliberately outside the Lamassu chart:",{"_3394":227,"_29710":212,"_20617":49033,"_5":14139,"_27008":48989,"_2880":49034},[],"a Kubernetes 1.24+ cluster and Helm 3.2+",{"_3394":228,"_29710":212,"_20617":49036,"_5":14139,"_27008":48989,"_2880":49037},[],"a reachable PostgreSQL server and a role allowed to create databases and schemas",{"_3394":229,"_29710":212,"_20617":49039,"_5":14139,"_27008":48989,"_2880":49040},[],"a reachable RabbitMQ broker and credentials",{"_3394":230,"_29710":212,"_20617":49042,"_5":14139,"_27008":48989,"_2880":49043},[],"an OIDC provider, normally Keycloak, with a realm/tenant and client for Lamassu",{"_3394":231,"_29710":212,"_20617":49045,"_5":14139,"_27008":48989,"_2880":49046},[],"Envoy Gateway 1.8+ and a `GatewayClass`",{"_3394":232,"_29710":212,"_20617":49048,"_5":14139,"_27008":48989,"_2880":49049},[],"cert-manager 1.14+ (only for the default `tls.type: certManager` mode); for trusted TLS, either a trusted issuer or a Kubernetes TLS Secret",{"_3394":233,"_29710":212,"_20617":49051,"_5":14139,"_27008":48989,"_2880":49052},[],"a StorageClass and an external traffic design",{"_3394":234,"_29710":212,"_20617":49054,"_5":14139,"_27008":48989,"_2880":49055},[],"The chart defaults to a `GatewayClass` named `eg`. Change `gateway.className` if your platform team uses another name.",{"_3394":235,"_29710":212,"_20617":49057,"_5":14139,"_27008":48989,"_2880":49058},[],"You provide the PostgreSQL server. The chart's pre-install job connects with the supplied credentials, creates the required `pki`, `authz` and `wfx` databases and service schemas, runs migrations, and applies `services.authz.bootstrap`.",{"_3394":236,"_29710":212,"_20617":49060,"_5":14139,"_27008":48989,"_2880":49061},[],"The chart has no Helm dependencies that install PostgreSQL, RabbitMQ, an OIDC provider, Envoy Gateway or cert-manager.",{"_3394":237,"_29710":212,"_20617":49063,"_5":14139,"_27008":48992,"_2880":49064},[],"Install or upgrade the Envoy Gateway CRDs before its controller. The commands below match the version used by the Lamassu Helm repository:",{"_3394":238,"_29710":212,"_20617":49066,"_5":14139,"_27008":48992,"_2880":49067},[],"Create the default `GatewayClass` if it does not already exist. Save this manifest as `gateway-class.yaml`:",{"_3394":239,"_29710":212,"_20617":49069,"_5":14139,"_27008":48992,"_2880":49070},[],"Install cert-manager separately before Lamassu, but only for the default `tls.type: certManager` mode. In that mode the chart renders its self-signed Issuer and CA Certificate resources regardless of whether `tls.certManagerOptions.clusterIssuer` is set, so cert-manager stays a prerequisite. With `tls.type: external`, the chart renders no cert-manager resources and the Gateway terminates TLS with an existing Secret you provide instead.",{"_3394":240,"_29710":212,"_20617":49072,"_5":14139,"_27008":48996,"_2880":49073},[],"Start with the chart defaults and override the environment-specific values. This example assumes PostgreSQL, RabbitMQ and Keycloak are reachable through Kubernetes DNS, and exposes Keycloak at `/auth` through the shared Lamassu Gateway:",{"_3394":241,"_29710":212,"_20617":49075,"_5":14139,"_27008":48996,"_2880":49076},[],"Do not add `gateway.addresses` by default. Leave address assignment to the load-balancer implementation unless your network design requires a specific Kubernetes-side VIP. The public IP of an upstream NAT gateway or reverse proxy does not belong in this value.",{"_3394":242,"_29710":212,"_20617":49078,"_5":14139,"_27008":48996,"_2880":49079},[],"If Keycloak is external and already has its own reachable URL, point the OIDC settings at it and omit the `/auth` entry from `gateway.extraRouting`.",{"_3394":243,"_29710":212,"_20617":49081,"_5":14139,"_27008":48996,"_2880":49082},[],"If your values file still carries the legacy gateway JWT validation settings — `auth.oidc.apiGateway.jwks`, `auth.authorization.rolesClaim` or `auth.authorization.roles.admin` — remove them. The migration guide `charts/lamassu/CHANGELOG/3.8.0->4.0.0.md` documents their removal with no compatibility aliases, and `values.schema.json` rejects the leftover blocks instead of silently ignoring them. The replacements are `services.authz.jwkUrl` and `services.authz.bootstrap`, already shown in the example above.",{"_3394":244,"_29710":212,"_20617":49084,"_5":14139,"_27008":49000,"_2880":49085},[],"Create a Secret containing `tls.crt` and `tls.key`, then reference it. The Secret must already exist before installing: in `external` mode the chart renders no cert-manager resources and never creates this Secret.",{"_3394":245,"_29710":212,"_20617":49087,"_5":14139,"_27008":49004,"_2880":49088},[],"`amqp.tls: true` selects AMQPS in every event-bus configuration block. The default port stays `5672` and does not change automatically when TLS is enabled, so set `amqp.port` to the broker's TLS listener, commonly `5671`.",{"_3394":246,"_29710":212,"_20617":49090,"_5":14139,"_27008":49004,"_2880":49091},[],"With no CA Secret configured, the event-bus clients use the system-trusted CAs. To trust a private CA, create a Secret in the release namespace containing the CA certificate in PEM format and set `amqp.ca.secretName` (and `amqp.ca.certificateKey` if the data key is not `ca.crt`).",{"_3394":247,"_29710":212,"_20617":49093,"_5":14139,"_27008":49004,"_2880":49094},[],"For brokers that require mutual TLS, create a Secret containing the client certificate and private key and set `amqp.client.secretName` (with `amqp.client.certificateKey` and `amqp.client.privateKeyKey` if the data keys are not `tls.crt` and `tls.key`).",{"_3394":248,"_29710":212,"_20617":49096,"_5":14139,"_27008":49004,"_2880":49097},[],"The chart mounts configured Secrets read-only into every AMQP-consuming workload: the CA certificate under `/etc/lamassu/amqp/ca` and the client certificate and key under `/etc/lamassu/amqp/client`. The mounted file names are always `ca.crt`, `tls.crt` and `tls.key` — the `certificateKey` and `privateKeyKey` values rename only the Secret data keys, never the on-disk paths. The client private key is mounted with restrictive permissions (`defaultMode: 0440`; the CA volume uses `0444`), which works because the chart adds `fsGroup` to the pod security context when `amqp.client.secretName` is set — it uses the container `runAsGroup` (default `65532`) when `fsGroup` is not already set.",{"_3394":249,"_29710":212,"_20617":49099,"_5":14139,"_27008":49004,"_2880":49100},[],"Both Secret options require `amqp.tls: true`: `values.schema.json` rejects a non-empty `secretName` when `tls` is false, rejects unknown keys and rejects data-key names outside `^[A-Za-z0-9._-]+$`. The referenced Secret must exist in the release namespace or the consuming pods fail to start.",{"_3394":250,"_29710":212,"_20617":49102,"_5":14139,"_27008":49004,"_2880":49103},[],"The AMQP client loads certificates at startup, so restart the consuming pods after updating either Secret. Changing any `amqp` value rolls the consuming pods through the `checksum/config` annotation, but a change to Secret content alone does not trigger a rollout.",{"_3394":251,"_29710":212,"_20617":49105,"_5":14139,"_27008":49004,"_2880":49106},[],"Per the migration guide `charts/lamassu/CHANGELOG/3.8.0->4.0.0.md`: in 3.8.0 `amqp.tls` was not applied and event-bus clients used plaintext AMQP; from 4.0.0, `amqp.tls: true` switches them to AMQPS. Set `amqp.port` to the broker TLS listener before upgrading, or set `amqp.tls: false` to keep plaintext AMQP. `amqp.tls: false` sends the broker credentials and all event-bus traffic in cleartext.",{"_3394":252,"_29710":212,"_20617":49108,"_5":14139,"_27008":49008,"_2880":49109},[],"There is no implicit superuser. Create the role or group expected by `services.authz.bootstrap` in the OIDC provider and assign it to at least one administrator before exposing Lamassu.",{"_3394":253,"_29710":212,"_20617":49111,"_5":14139,"_27008":49008,"_2880":49112},[],"The pre-install and pre-upgrade job applies the bootstrap idempotently: existing principals are preserved and missing grants are added.",{"_3394":254,"_29710":212,"_20617":49114,"_5":14139,"_27008":49008,"_2880":49115},[],"Test both an authorized identity and a denied identity. If no token matches an active bootstrap principal, nobody can administer the PKI.",{"_3394":255,"_29710":212,"_20617":49117,"_5":14139,"_27008":49008,"_2880":49118},[],"See Access control for the principal and policy model.",{"_3394":256,"_29710":212,"_20617":49120,"_5":14139,"_27008":49012,"_2880":49121},[],"To install a local checkout instead:",{"_3394":257,"_29710":212,"_20617":49123,"_5":14139,"_27008":49016,"_2880":49124},[],"The Gateway should report `PROGRAMMED=True`. If it is programmed but has no usable address, continue with Expose the Gateway.",{"_3394":258,"_29710":212,"_20617":49126,"_5":14139,"_27008":49016,"_2880":49127},[],"The Helm test checks the CA, DMS Manager, Device Manager and VA health endpoints and verifies the UI response.",{"_3394":259,"_29710":212,"_20617":49129,"_5":14139,"_27008":49020,"_2880":49130},[],"Version-specific upgrade steps live in `charts/lamassu/CHANGELOG/` in the Helm repository. The chart also ships an optional pre-upgrade Job that migrates existing CA private keys into the KMS engine configured for the release. It is off by default (`migrations.caToKms.enabled: false`) and is only needed when upgrading from a version prior to 3.7.0.",{"_3394":260,"_29710":212,"_20617":49132,"_5":14139,"_27008":49020,"_2880":49133},[],"While the flag is enabled, every `helm upgrade` creates the `<chart fullname>-ca-to-kms-migration` Job (`lamassu-ca-to-kms-migration` for release `lamassu`); a fresh install does not create it. Its hook weight is `-10`, so it runs before the other pre-upgrade hooks: the authorization bootstrap configuration (weight `-4`) and the database-migration Job (weight `-3`).",{"_3394":261,"_29710":212,"_20617":49135,"_5":14139,"_27008":49020,"_2880":49136},[],"The Job consumes the same KMS service configuration the chart renders into the KMS ConfigMap, including the engines from `services.kms.cryptoEngines`, and runs the migration tool defined in `migrations.caToKms.image`. It mounts that configuration read-only at `/etc/lamassuiot/config.yml` from the ConfigMap key `config`, so configure the destination engine in your values before the upgrade that performs the migration.",{"_3394":262,"_29710":212,"_20617":49138,"_5":14139,"_27008":49020,"_2880":49139},[],"The Job resolves its configuration through a projected volume with two optional sources: the release-scoped `<chart fullname>-kms-config` (`lamassu-kms-config` for release `lamassu`, `prod-lamassu-kms-config` for release `prod`) and the legacy unscoped `kms-config` created by chart versions before release-scoped naming. The legacy configuration remains authoritative while it is still present, and the release-scoped one is used once the legacy one is gone. Both sources are optional, so a missing ConfigMap never leaves the upgrade pod in `ContainerCreating`.",{"_3394":263,"_29710":212,"_20617":49141,"_5":14139,"_27008":49020,"_2880":49142},[],"Keep `migrations.caToKms.enabled: true` for the upgrade that performs the migration, then remove the flag from your values once the migration completes; it defaults to `false`.",{"_3394":264,"_29710":212,"_20617":49144,"_5":14139,"_27008":49024,"_2880":49145},[],"Before going live, review:",{"_3394":265,"_29710":212,"_20617":49147,"_5":14139,"_27008":49024,"_2880":49148},[],"backup and recovery for PostgreSQL and persistent volumes",{"_3394":266,"_29710":212,"_20617":49150,"_5":14139,"_27008":49024,"_2880":49151},[],"a production KMS engine; the default filesystem engine is not an HA design",{"_3394":267,"_29710":212,"_20617":49153,"_5":14139,"_27008":49024,"_2880":49154},[],"shared VA storage before increasing VA replicas",{"_3394":268,"_29710":212,"_20617":49156,"_5":14139,"_27008":49024,"_2880":49157},[],"managed OIDC roles and removal of evaluation credentials",{"_3394":269,"_29710":212,"_20617":49159,"_5":14139,"_27008":49024,"_2880":49160},[],"a trusted TLS issuer or externally managed certificate",{"_3394":270,"_29710":212,"_20617":49162,"_5":14139,"_27008":49024,"_2880":49163},[],"resource requests, replicas, autoscaling, disruption budgets and placement",{"_3394":271,"_29710":212,"_20617":49165,"_5":14139,"_27008":49024,"_2880":49166},[],"SMTP, observability and alert delivery",{"_3394":272,"_29710":212,"_20617":49168,"_5":14139,"_27008":49024,"_2880":49169},[],"the version upgrade guides and migration notes in `charts/lamassu/CHANGELOG/` before every upgrade, including the optional CA-to-KMS migration hook described above",{"_3394":273,"_29710":212,"_20617":49171,"_5":14139,"_27008":49024,"_2880":49172},[],"The complete values reference is maintained in `charts/lamassu/VALUES.md` in the Helm repository.",{"_3394":274,"_29710":274,"_5":14491,"_2880":49174,"_30042":49175,"_20617":49176,"_27008":274},"Expose the Gateway",[48369,48370,48476],[],{"_3394":275,"_29710":274,"_20617":49178,"_5":14139,"_27008":274,"_2880":49179},[],"Choose how clients reach Lamassu, when to set gateway.addresses and how to design multiple Gateways.",{"_3394":276,"_29710":274,"_5":30039,"_20617":49181,"_27008":49182,"_2880":49183},[],"/docs/deployment/self-hosted/networking#expose-the-lamassu-gateway","Expose the Lamassu Gateway",{"_3394":277,"_29710":274,"_5":30039,"_20617":49185,"_27008":49186,"_2880":49187},[],"/docs/deployment/self-hosted/networking#do-you-need-gatewayaddresses","Do you need `gateway.addresses`?",{"_3394":278,"_29710":274,"_5":30039,"_20617":49189,"_27008":49190,"_2880":49191},[],"/docs/deployment/self-hosted/networking#recommended-single-node-design","Recommended single-node design",{"_3394":279,"_29710":274,"_5":30039,"_20617":49193,"_27008":49194,"_2880":49195},[],"/docs/deployment/self-hosted/networking#k3s","K3s",{"_3394":280,"_29710":274,"_5":30039,"_20617":49197,"_27008":49198,"_2880":49199},[],"/docs/deployment/self-hosted/networking#bare-metal-with-metallb-or-kube-vip","Bare metal with MetalLB or kube-vip",{"_3394":281,"_29710":274,"_5":30039,"_20617":49201,"_27008":49202,"_2880":49203},[],"/docs/deployment/self-hosted/networking#external-reverse-proxy-nat-or-vpn","External reverse proxy, NAT or VPN",{"_3394":282,"_29710":274,"_5":30039,"_20617":49205,"_27008":49206,"_2880":49207},[],"/docs/deployment/self-hosted/networking#what-if-you-need-three-gateways","What if you need three Gateways?",{"_3394":283,"_29710":274,"_5":30039,"_20617":49209,"_27008":49210,"_2880":49211},[],"/docs/deployment/self-hosted/networking#decision-guide","Decision guide",{"_3394":284,"_29710":274,"_5":30039,"_20617":49213,"_27008":49214,"_2880":49215},[],"/docs/deployment/self-hosted/networking#egress-proxy","Egress proxy",{"_3394":285,"_29710":274,"_5":30039,"_20617":49217,"_27008":49218,"_2880":49219},[],"/docs/deployment/self-hosted/networking#verify-the-traffic-path","Verify the traffic path",{"_3394":286,"_29710":274,"_20617":49221,"_5":14139,"_27008":49182,"_2880":49222},[],"The Lamassu chart creates one shared Gateway with HTTP and HTTPS listeners. Envoy Gateway normally creates a dedicated proxy deployment and a `LoadBalancer` Service for it.",{"_3394":287,"_29710":274,"_20617":49224,"_5":14139,"_27008":49182,"_2880":49225},[],"External reachability is the result of the whole path. A `Gateway` resource alone does not configure your router, firewall, DNS, cloud load balancer or upstream NAT.",{"_3394":288,"_29710":274,"_20617":49227,"_5":14139,"_27008":49186,"_2880":49228},[],"Usually, no. If you omit it, the Gateway controller and the cluster load-balancer implementation can assign an address and report it in `Gateway.status.addresses` and the generated Service status.",{"_3394":289,"_29710":274,"_20617":49230,"_5":14139,"_27008":49186,"_2880":49231},[],"Set it only when:",{"_3394":290,"_29710":274,"_20617":49233,"_5":14139,"_27008":49186,"_2880":49234},[],"your cloud or bare-metal load balancer supports requesting a specific address",{"_3394":291,"_29710":274,"_20617":49236,"_5":14139,"_27008":49186,"_2880":49237},[],"that address is allocated to this Gateway",{"_3394":292,"_29710":274,"_20617":49239,"_5":14139,"_27008":49186,"_2880":49240},[],"the surrounding network already routes traffic for it to the cluster",{"_3394":293,"_29710":274,"_20617":49242,"_5":14139,"_27008":49186,"_2880":49243},[],"This requests `192.168.1.50`; it does not claim the IP on your LAN or make it reachable.",{"_3394":294,"_29710":274,"_20617":49245,"_5":14139,"_27008":49186,"_2880":49246},[],"Keep these two settings separate:",{"_3394":295,"_29710":274,"_20617":49248,"_5":14139,"_27008":49186,"_2880":49249},[],"`gateway.addresses` requests an address for the Gateway.",{"_3394":296,"_29710":274,"_20617":49251,"_5":14139,"_27008":49186,"_2880":49252},[],"`tls.certManagerOptions.certSpec.addresses` adds IP subject alternative names to the TLS certificate.",{"_3394":297,"_29710":274,"_20617":49254,"_5":14139,"_27008":49186,"_2880":49255},[],"If users connect by DNS name, put that name in `tls.certManagerOptions.certSpec.hostnames`. Do not copy an upstream proxy's public IP into `gateway.addresses`.",{"_3394":298,"_29710":274,"_20617":49257,"_5":14139,"_27008":49190,"_2880":49258},[],"For a small VM running K3s or MicroK8s, use one external Lamassu Gateway and route every Lamassu endpoint through it:",{"_3394":299,"_29710":274,"_20617":49260,"_5":14139,"_27008":49190,"_2880":49261},[],"This design uses one IP, one TLS entry point and one pair of ports. The chart already creates the required routes.",{"_3394":300,"_29710":274,"_20617":49263,"_5":14139,"_27008":49194,"_2880":49264},[],"K3s ServiceLB implements each `LoadBalancer` Service with pods that reserve the Service ports on the node. On a single node, only one Service can therefore own port 80 and one can own port 443. The default K3s Traefik Service may already hold both ports.",{"_3394":301,"_29710":274,"_20617":49266,"_5":14139,"_27008":49194,"_2880":49267},[],"For the recommended design:",{"_3394":302,"_29710":274,"_20617":49269,"_5":14139,"_27008":49194,"_2880":49270},[],"Use only one externally exposed Lamassu Gateway.",{"_3394":303,"_29710":274,"_20617":49272,"_5":14139,"_27008":49194,"_2880":49273},[],"Ensure ports 80 and 443 are free. Disable or reconfigure Traefik if it is not part of your traffic path.",{"_3394":304,"_29710":274,"_20617":49275,"_5":14139,"_27008":49194,"_2880":49276},[],"Allow those ports through the VM firewall and any upstream security group.",{"_3394":305,"_29710":274,"_20617":49278,"_5":14139,"_27008":49194,"_2880":49279},[],"Point DNS at the VM's reachable address.",{"_3394":306,"_29710":274,"_20617":49281,"_5":14139,"_27008":49194,"_2880":49282},[],"See the K3s ServiceLB documentation for its host-port behavior and how to replace it with another load-balancer implementation.",{"_3394":307,"_29710":274,"_20617":49284,"_5":14139,"_27008":49198,"_2880":49285},[],"Allocate a VIP from an address pool reachable on your LAN. You may request that VIP with `gateway.addresses` if the selected implementation supports it. Confirm the assigned address in status rather than assuming the request succeeded.",{"_3394":308,"_29710":274,"_20617":49287,"_5":14139,"_27008":49202,"_2880":49288},[],"An external public address can forward TCP 80 and 443 to the VM or to a Kubernetes-side VIP:",{"_3394":309,"_29710":274,"_20617":49290,"_5":14139,"_27008":49202,"_2880":49291},[],"The public IP belongs to the external device. Leave `gateway.addresses` unset or set it to the actual Kubernetes-side address, never to an address that the cluster cannot bind.",{"_3394":310,"_29710":274,"_20617":49293,"_5":14139,"_27008":49206,"_2880":49294},[],"First decide whether you need three independent data planes or only three hostnames.",{"_3394":311,"_29710":274,"_20617":49296,"_5":14139,"_27008":49206,"_2880":49297},[],"Requirement",{"_3394":312,"_29710":274,"_20617":49299,"_5":14139,"_27008":49206,"_2880":49300},[],"Recommended design",{"_3394":313,"_29710":274,"_20617":49302,"_5":14139,"_27008":49206,"_2880":49303},[],"Consequence",{"_3394":314,"_29710":274,"_20617":49305,"_5":14139,"_27008":49206,"_2880":49306},[],"Several Lamassu URLs or services",{"_3394":315,"_29710":274,"_20617":49308,"_5":14139,"_27008":49206,"_2880":49309},[],"One Gateway with multiple routes",{"_3394":316,"_29710":274,"_20617":49311,"_5":14139,"_27008":49206,"_2880":49312},[],"One IP and one proxy fleet; this is the chart default",{"_3394":317,"_29710":274,"_20617":49314,"_5":14139,"_27008":49206,"_2880":49315},[],"Independent Gateways and separate external IPs",{"_3394":318,"_29710":274,"_20617":49317,"_5":14139,"_27008":49206,"_2880":49318},[],"One VIP per Gateway",{"_3394":319,"_29710":274,"_20617":49320,"_5":14139,"_27008":49206,"_2880":49321},[],"All Gateways can use 80/443; requires a load balancer with an address pool",{"_3394":320,"_29710":274,"_20617":49323,"_5":14139,"_27008":49206,"_2880":49324},[],"Independent Gateways on one node and one IP",{"_3394":321,"_29710":274,"_20617":49326,"_5":14139,"_27008":49206,"_2880":49327},[],"Use different external ports",{"_3394":322,"_29710":274,"_20617":49329,"_5":14139,"_27008":49206,"_2880":49330},[],"Clients must include non-standard ports",{"_3394":323,"_29710":274,"_20617":49332,"_5":14139,"_27008":49206,"_2880":49333},[],"Separate TLS/mTLS termination behind one IP",{"_3394":324,"_29710":274,"_20617":49335,"_5":14139,"_27008":49206,"_2880":49336},[],"Front-door SNI routing to internal Gateways",{"_3394":325,"_29710":274,"_20617":49338,"_5":14139,"_27008":49206,"_2880":49339},[],"Advanced design; the front door uses TLS passthrough and each internal Gateway terminates its own TLS",{"_3394":326,"_29710":274,"_20617":49341,"_5":14139,"_27008":49206,"_2880":49342},[],"Separate Gateway resources but shared proxy infrastructure",{"_3394":327,"_29710":274,"_20617":49344,"_5":14139,"_27008":49206,"_2880":49345},[],"Envoy merged-Gateway mode",{"_3394":328,"_29710":274,"_20617":49347,"_5":14139,"_27008":49206,"_2880":49348},[],"Logical separation only; listeners must have unique port, protocol and hostname tuples",{"_3394":329,"_29710":274,"_20617":49350,"_5":14139,"_27008":49206,"_2880":49351},[],"Three independent `LoadBalancer` Services cannot all reserve the same node ports 80 and 443 through K3s ServiceLB. Use one shared Gateway, allocate distinct VIPs with another load-balancer implementation, or use different ports.",{"_3394":330,"_29710":274,"_20617":49353,"_5":14139,"_27008":49206,"_2880":49354},[],"Envoy Gateway normally provisions a proxy fleet per `Gateway`. Its merged-Gateway mode can share one fleet and address, but it is not a drop-in switch for multiple Lamassu releases: the generated Lamassu listeners use the same ports and protocols without distinct hostnames, so they conflict unless you deliberately customize the listener design.",{"_3394":331,"_29710":274,"_20617":49356,"_5":14139,"_27008":49206,"_2880":49357},[],"Use a front-door SNI design only when the internal Gateways must retain independent TLS or mTLS policy:",{"_3394":332,"_29710":274,"_20617":49359,"_5":14139,"_27008":49206,"_2880":49360},[],"This requires distinct SNI hostnames and cluster networking outside the Lamassu chart.",{"_3394":333,"_29710":274,"_20617":49362,"_5":14139,"_27008":49210,"_2880":49363},[],"If one Gateway can own TLS and routing, use the chart default.",{"_3394":334,"_29710":274,"_20617":49365,"_5":14139,"_27008":49210,"_2880":49366},[],"If Gateways need independent policy and you can allocate IPs, use one VIP per Gateway.",{"_3394":335,"_29710":274,"_20617":49368,"_5":14139,"_27008":49210,"_2880":49369},[],"If only the Kubernetes resources need separation, evaluate merged-Gateway mode and make every listener tuple unique.",{"_3394":336,"_29710":274,"_20617":49371,"_5":14139,"_27008":49210,"_2880":49372},[],"If data planes and TLS termination must stay independent behind one IP, add a front-door SNI passthrough layer.",{"_3394":337,"_29710":274,"_20617":49374,"_5":14139,"_27008":49210,"_2880":49375},[],"If none of those are possible, use different external ports or change the external network design.",{"_3394":338,"_29710":274,"_20617":49377,"_5":14139,"_27008":49214,"_2880":49378},[],"Internal Lamassu clients — the Vault engine connection, service-to-service calls and webhook deliveries — honor the `HTTP_PROXY`, `HTTPS_PROXY` and `NO_PROXY` environment variables. The exception is the authorization-engine connector: it uses its own transport and does not consult these proxy variables. If your deployment routes egress through a proxy, list in-cluster service names in `NO_PROXY` (for example `.svc,.cluster.local`) so internal traffic stays inside the cluster. Loopback traffic is never sent through a proxy.",{"_3394":339,"_29710":274,"_20617":49380,"_5":14139,"_27008":49214,"_2880":49381},[],"The default transport of these clients bounds the dial timeout (30 seconds), the TLS handshake (10 seconds) and idle connection reuse (90 seconds) so an unreachable dependency fails fast instead of hanging; these values are Go transport defaults, not Lamassu settings. HTTP/2 is negotiated when the peer supports it. The authorization-engine connector keeps its own transport without these dial and handshake timeouts; only its overall 30-second request timeout bounds each call.",{"_3394":340,"_29710":274,"_20617":49383,"_5":14139,"_27008":49218,"_2880":49384},[],"Check, in order:",{"_3394":341,"_29710":274,"_20617":49386,"_5":14139,"_27008":49218,"_2880":49387},[],"`Gateway` has `Accepted=True` and `Programmed=True`.",{"_3394":342,"_29710":274,"_20617":49389,"_5":14139,"_27008":49218,"_2880":49390},[],"Its status contains the expected address.",{"_3394":343,"_29710":274,"_20617":49392,"_5":14139,"_27008":49218,"_2880":49393},[],"The generated `LoadBalancer` Service has a usable external address.",{"_3394":344,"_29710":274,"_20617":49395,"_5":14139,"_27008":49218,"_2880":49396},[],"Port 443 reaches that address from the client network.",{"_3394":345,"_29710":274,"_20617":49398,"_5":14139,"_27008":49218,"_2880":49399},[],"DNS resolves to the externally reachable endpoint.",{"_3394":346,"_29710":274,"_20617":49401,"_5":14139,"_27008":49218,"_2880":49402},[],"The certificate contains the DNS name or IP used by the client.",{"_3394":347,"_29710":274,"_20617":49404,"_5":14139,"_27008":49218,"_2880":49405},[],"The Gateway API treats addresses as desired state that a controller may assign or reject; see the Gateway API overview for the resource model.",{"_3394":348,"_29710":348,"_5":14491,"_2880":48476,"_30042":49407,"_20617":49408,"_27008":348},[48369,48370,48476],[],{"_3394":349,"_29710":348,"_20617":49410,"_5":14139,"_27008":348,"_2880":49411},[],"Choose an installation workflow and network architecture for Lamassu on your Kubernetes cluster.",{"_3394":350,"_29710":348,"_5":30039,"_20617":49413,"_27008":49414,"_2880":49415},[],"/docs/deployment/self-hosted/overview#self-managed-kubernetes-deployment","Self-managed Kubernetes deployment",{"_3394":351,"_29710":348,"_5":30039,"_20617":49417,"_27008":49418,"_2880":49419},[],"/docs/deployment/self-hosted/overview#choose-an-installation-workflow","Choose an installation workflow",{"_3394":352,"_29710":348,"_5":30039,"_20617":49421,"_27008":49422,"_2880":49423},[],"/docs/deployment/self-hosted/overview#what-the-lamassu-chart-provides","What the Lamassu chart provides",{"_3394":353,"_29710":348,"_5":30039,"_20617":49425,"_27008":49426,"_2880":49427},[],"/docs/deployment/self-hosted/overview#how-the-deployment-fits-together","How the deployment fits together",{"_3394":354,"_29710":348,"_5":30039,"_20617":49429,"_27008":49430,"_2880":49431},[],"/docs/deployment/self-hosted/overview#platform-requirements","Platform requirements",{"_3394":355,"_29710":348,"_5":30039,"_20617":49433,"_27008":49434,"_2880":49435},[],"/docs/deployment/self-hosted/overview#choose-the-next-page","Choose the next page",{"_3394":356,"_29710":348,"_20617":49437,"_5":14139,"_27008":49414,"_2880":49438},[],"Run Lamassu in a Kubernetes cluster operated by your team. The Helm chart deploys the Lamassu services and their routing resources; you provide the cluster, persistent storage, identity provider, PostgreSQL, RabbitMQ and the network path used by clients.",{"_3394":357,"_29710":348,"_20617":49440,"_5":14139,"_27008":49418,"_2880":49441},[],"Workflow",{"_3394":358,"_29710":348,"_20617":49443,"_5":14139,"_27008":49418,"_2880":49444},[],"Use it for",{"_3394":359,"_29710":348,"_20617":49446,"_5":14139,"_27008":49418,"_2880":49447},[],"What it installs",{"_3394":360,"_29710":348,"_20617":49449,"_5":14139,"_27008":49418,"_2880":49450},[],"Helm",{"_3394":361,"_29710":348,"_20617":49452,"_5":14139,"_27008":49418,"_2880":49453},[],"Production and controlled environments",{"_3394":362,"_29710":348,"_20617":49455,"_5":14139,"_27008":49418,"_2880":49456},[],"Lamassu services and Gateway API resources",{"_3394":363,"_29710":348,"_20617":49458,"_5":14139,"_27008":49418,"_2880":48613},[],{"_3394":364,"_29710":348,"_20617":49460,"_5":14139,"_27008":49418,"_2880":49461},[],"Evaluation, demos, CI and small lab clusters",{"_3394":365,"_29710":348,"_20617":49463,"_5":14139,"_27008":49418,"_2880":49464},[],"PostgreSQL, Keycloak, RabbitMQ, Envoy Gateway and Lamassu",{"_3394":366,"_29710":348,"_20617":49466,"_5":14139,"_27008":49422,"_2880":49467},[],"The Lamassu chart is an **application chart**, not a cluster bootstrap chart. It creates the Kubernetes resources that run and configure Lamassu, but it expects the platform services those resources depend on to exist.",{"_3394":367,"_29710":348,"_20617":49469,"_5":14139,"_27008":49422,"_2880":49470},[],"Area",{"_3394":368,"_29710":348,"_20617":49472,"_5":14139,"_27008":49422,"_2880":49473},[],"The Lamassu chart provides",{"_3394":369,"_29710":348,"_20617":49475,"_5":14139,"_27008":49422,"_2880":49476},[],"You provide",{"_3394":370,"_29710":348,"_20617":49478,"_5":14139,"_27008":49422,"_2880":49479},[],"Lamassu applications",{"_3394":371,"_29710":348,"_20617":49481,"_5":14139,"_27008":49422,"_2880":49482},[],"Deployments and StatefulSets for the UI and APIs, internal Services, ConfigMaps, a ServiceAccount, and optional HPAs and PDBs",{"_3394":372,"_29710":348,"_20617":49484,"_5":14139,"_27008":49422,"_2880":49485},[],"A working Kubernetes cluster, compute capacity and access to the container images",{"_3394":373,"_29710":348,"_20617":49487,"_5":14139,"_27008":49422,"_2880":49488},[],"PostgreSQL data",{"_3394":374,"_29710":348,"_20617":49490,"_5":14139,"_27008":49422,"_2880":49491},[],"A pre-install/pre-upgrade job that creates the required databases and schemas, runs migrations and applies the authorization bootstrap",{"_3394":375,"_29710":348,"_20617":49493,"_5":14139,"_27008":49422,"_2880":49494},[],"A reachable PostgreSQL server, credentials allowed to create databases and schemas, and backup/HA operations",{"_3394":376,"_29710":348,"_20617":49496,"_5":14139,"_27008":49422,"_2880":49497},[],"Messaging",{"_3394":377,"_29710":348,"_20617":49499,"_5":14139,"_27008":49422,"_2880":49500},[],"RabbitMQ connection configuration for the Lamassu services; the connection can use AMQPS, with an optional private CA and an optional client certificate, both set through chart values",{"_3394":378,"_29710":348,"_20617":49502,"_5":14139,"_27008":49422,"_2880":49503},[],"A reachable RabbitMQ broker, credentials and its lifecycle",{"_3394":379,"_29710":348,"_20617":49505,"_5":14139,"_27008":49422,"_2880":49506},[],"Identity",{"_3394":380,"_29710":348,"_20617":49508,"_5":14139,"_27008":49422,"_2880":49509},[],"OIDC/JWT and external-authorization configuration, plus initial Lamassu authorization principals",{"_3394":381,"_29710":348,"_20617":49511,"_5":14139,"_27008":49422,"_2880":49512},[],"An OIDC provider, realm/tenant, client, users, groups and roles",{"_3394":382,"_29710":348,"_20617":49514,"_5":14139,"_27008":49422,"_2880":49515},[],"External routing",{"_3394":383,"_29710":348,"_20617":49517,"_5":14139,"_27008":49422,"_2880":49518},[],"One `Gateway`, `HTTPRoute` resources, an `EnvoyProxy` configuration and Envoy security policies",{"_3394":384,"_29710":348,"_20617":49520,"_5":14139,"_27008":49422,"_2880":49521},[],"Gateway API and Envoy CRDs, the Envoy Gateway controller, a `GatewayClass`, a load-balancer implementation and the external network path",{"_3394":385,"_29710":348,"_20617":49523,"_5":14139,"_27008":49422,"_2880":49524},[],"TLS",{"_3394":386,"_29710":348,"_20617":49526,"_5":14139,"_27008":49422,"_2880":49527},[],"In the default `tls.type: certManager` mode, cert-manager `Issuer` and CA `Certificate` resources and a chart-managed downstream `Certificate`; in the `tls.type: external` mode, a reference to your TLS Secret",{"_3394":387,"_29710":348,"_20617":49529,"_5":14139,"_27008":49422,"_2880":49530},[],"cert-manager only for the default `tls.type: certManager` mode; for trusted TLS, a trusted issuer or a populated TLS Secret",{"_3394":388,"_29710":348,"_20617":49532,"_5":14139,"_27008":49422,"_2880":49533},[],"Persistent application data",{"_3394":389,"_29710":348,"_20617":49535,"_5":14139,"_27008":49422,"_2880":49536},[],"PersistentVolumeClaims required by the default local KMS and VA storage",{"_3394":390,"_29710":348,"_20617":49538,"_5":14139,"_27008":49422,"_2880":49539},[],"A StorageClass, physical storage, backups and a shared/external backend when scaling requires one",{"_3394":391,"_29710":348,"_20617":49541,"_5":14139,"_27008":49422,"_2880":49542},[],"Optional integrations",{"_3394":392,"_29710":348,"_20617":49544,"_5":14139,"_27008":49422,"_2880":49545},[],"Configuration hooks for observability, AWS connectors and PKCS#11/HSM connectivity",{"_3394":393,"_29710":348,"_20617":49547,"_5":14139,"_27008":49422,"_2880":49548},[],"The observability backends, cloud credentials and production HSM or external key service",{"_3394":394,"_29710":348,"_20617":49550,"_5":14139,"_27008":49422,"_2880":49551},[],"The chart creates Lamassu's `Gateway` and routes. It does not install the Envoy Gateway controller or make the generated `LoadBalancer` Service reachable from your network.",{"_3394":395,"_29710":348,"_20617":49553,"_5":14139,"_27008":49422,"_2880":49554},[],"Use one Lamassu Gateway on ports 80 and 443 and let its HTTPRoutes dispatch traffic to every Lamassu service. Give that Gateway one externally reachable endpoint through the cluster load balancer, or forward traffic to it from an external proxy or NAT device. You do not need one Gateway per service.",{"_3394":396,"_29710":348,"_20617":49556,"_5":14139,"_27008":49426,"_2880":49557},[],"The chart creates one shared `Gateway` per Helm release. All chart-managed `HTTPRoute` resources attach to it. Envoy Gateway provisions the proxy data plane and a Kubernetes `LoadBalancer` Service for that Gateway.",{"_3394":397,"_29710":348,"_20617":49559,"_5":14139,"_27008":49426,"_2880":49560},[],"The `gateway.addresses` value is only an address request to the Gateway controller. It does not make an IP routable, open a firewall, configure DNS or create NAT. See Expose the Gateway before setting it.",{"_3394":398,"_29710":348,"_20617":49562,"_5":14139,"_27008":49430,"_2880":49563},[],"Kubernetes 1.24 or newer",{"_3394":399,"_29710":348,"_20617":49565,"_5":14139,"_27008":49430,"_2880":49566},[],"Helm 3.2 or newer",{"_3394":400,"_29710":348,"_20617":49568,"_5":14139,"_27008":49430,"_2880":49569},[],"Envoy Gateway 1.8 or newer and a `GatewayClass`",{"_3394":401,"_29710":348,"_20617":49571,"_5":14139,"_27008":49430,"_2880":49572},[],"cert-manager 1.14 or newer; required only for the default `tls.type: certManager` TLS mode, not for `tls.type: external`",{"_3394":402,"_29710":348,"_20617":49574,"_5":14139,"_27008":49430,"_2880":49575},[],"persistent storage suitable for the selected PostgreSQL, RabbitMQ, VA and KMS configuration",{"_3394":403,"_29710":348,"_20617":49577,"_5":14139,"_27008":49430,"_2880":49578},[],"a load-balancer implementation or another deliberate path from clients to the Gateway",{"_3394":404,"_29710":348,"_20617":49580,"_5":14139,"_27008":49430,"_2880":49581},[],"KMS deployments using the native PKCS#11 sidecar require Kubernetes 1.29 or newer. Prebuilt Lamassu container images are published for `linux/amd64` and `linux/arm64`, and the KMS PKCS#11 client module (`p11-kit-client.so`) is installed at the target architecture's Debian library path: `/usr/lib/x86_64-linux-gnu/pkcs11/p11-kit-client.so` on amd64 and `/usr/lib/aarch64-linux-gnu/pkcs11/p11-kit-client.so` on arm64. The x86\\_64 path is retained as a compatibility alias for existing configurations.",{"_3394":405,"_29710":348,"_20617":49583,"_5":14139,"_27008":49434,"_2880":49584},[],"<Card title=\"Install with Helm\" description=\"Prepare dependencies, configure values, install and verify a controlled deployment.\" href=\"/docs/deployment/self-hosted/helm\" />",{"_3394":406,"_29710":348,"_20617":49586,"_5":14139,"_27008":49434,"_2880":49587},[],"<Card title=\"Upgrade from 3.8.0\" description=\"Upgrade an existing Helm release to 4.0.0: architecture changes, breaking changes, migration steps and validation.\" href=\"/docs/upgrades/3-8-0-to-4-0-0\" />",{"_3394":407,"_29710":348,"_20617":49589,"_5":14139,"_27008":49434,"_2880":49590},[],"<Card title=\"Expose the Gateway\" description=\"Choose an external traffic design, understand gateway.addresses and handle multiple Gateways.\" href=\"/docs/deployment/self-hosted/networking\" />",{"_3394":408,"_29710":348,"_20617":49592,"_5":14139,"_27008":49434,"_2880":49593},[],"<Card title=\"Use Fastlane\" description=\"Bootstrap a complete evaluation or lab environment with one script.\" href=\"/docs/deployment/self-hosted/fastlane\" />",{"_3394":409,"_29710":409,"_5":14491,"_2880":49595,"_30042":49596,"_20617":49598,"_27008":409},"Deployment troubleshooting",[48369,48370,49597],"Operations",[],{"_3394":410,"_29710":409,"_20617":49600,"_5":14139,"_27008":409,"_2880":49601},[],"Diagnose access, service health and infrastructure dependencies.",{"_3394":411,"_29710":409,"_5":30039,"_20617":49603,"_27008":49604,"_2880":49605},[],"/docs/deployment/troubleshooting#diagnostic-sequence","Diagnostic sequence",{"_3394":412,"_29710":409,"_5":30039,"_20617":49607,"_27008":49608,"_2880":49609},[],"/docs/deployment/troubleshooting#reproduce-a-single-operation","Reproduce a single operation",{"_3394":413,"_29710":409,"_5":30039,"_20617":49611,"_27008":49612,"_2880":49613},[],"/docs/deployment/troubleshooting#separate-client-gateway-and-service","Separate client, Gateway and service",{"_3394":414,"_29710":409,"_5":30039,"_20617":49615,"_27008":49616,"_2880":49617},[],"/docs/deployment/troubleshooting#review-kubernetes-status","Review Kubernetes status",{"_3394":415,"_29710":409,"_5":30039,"_20617":49619,"_27008":49620,"_2880":49621},[],"/docs/deployment/troubleshooting#query-the-affected-service","Query the affected service",{"_3394":416,"_29710":409,"_5":30039,"_20617":49623,"_27008":49624,"_2880":49625},[],"/docs/deployment/troubleshooting#validate-the-result-from-outside","Validate the result from outside",{"_3394":417,"_29710":409,"_5":30039,"_20617":49627,"_27008":49628,"_2880":49629},[],"/docs/deployment/troubleshooting#minimal-evidence-collection","Minimal evidence collection",{"_3394":418,"_29710":409,"_5":30039,"_20617":49631,"_27008":49632,"_2880":49633},[],"/docs/deployment/troubleshooting#i-cannot-sign-in","I cannot sign in",{"_3394":419,"_29710":409,"_5":30039,"_20617":49635,"_27008":49636,"_2880":49637},[],"/docs/deployment/troubleshooting#everything-returns-403-or-5xx","Everything returns 403 or 5xx",{"_3394":420,"_29710":409,"_5":30039,"_20617":49639,"_27008":49640,"_2880":49641},[],"/docs/deployment/troubleshooting#api-500-errors","API 500 errors",{"_3394":421,"_29710":409,"_5":30039,"_20617":49643,"_27008":49644,"_2880":49645},[],"/docs/deployment/troubleshooting#a-pod-is-not-ready","A pod is not Ready",{"_3394":422,"_29710":409,"_5":30039,"_20617":49647,"_27008":49648,"_2880":49649},[],"/docs/deployment/troubleshooting#events-are-not-arriving","Events are not arriving",{"_3394":423,"_29710":409,"_5":30039,"_20617":49651,"_27008":49652,"_2880":49653},[],"/docs/deployment/troubleshooting#observability","Observability",{"_3394":424,"_29710":409,"_20617":49655,"_5":14139,"_27008":409,"_2880":49656},[],"Start by locating the failing layer. A Gateway response and an unready pod require different evidence. For rejected issuance or validation results, see PKI troubleshooting; for enrollment, see EST diagnostics.",{"_3394":425,"_29710":409,"_20617":49658,"_5":14139,"_27008":49608,"_2880":49659},[],"Note the time in UTC, user or principal, resource, endpoint and result. Avoid repeating a destructive action such as revocation or deletion.",{"_3394":426,"_29710":409,"_20617":49661,"_5":14139,"_27008":49612,"_2880":49662},[],"Check the HTTP status. A 401 points to authentication; a 403, to authorization; a 404, to route or resource; a 5xx, to the service or a dependency.",{"_3394":427,"_29710":409,"_20617":49664,"_5":14139,"_27008":49616,"_2880":49665},[],"Locate unready pods, restarts, recent events and the state of the release.",{"_3394":428,"_29710":409,"_20617":49667,"_5":14139,"_27008":49620,"_2880":49668},[],"Review its /health endpoint and its logs in the same time window. Then follow the indicated dependency: PostgreSQL, RabbitMQ, the OIDC provider or the cryptographic engine.",{"_3394":429,"_29710":409,"_20617":49670,"_5":14139,"_27008":49624,"_2880":49671},[],"For PKI, check the certificate, the chain, OCSP or CRL with the same type of client production uses.",{"_3394":430,"_29710":409,"_20617":49673,"_5":14139,"_27008":49628,"_2880":49674},[],"Replace the placeholders with your real release, namespace and deployment.",{"_3394":431,"_29710":409,"_20617":49676,"_5":14139,"_27008":49628,"_2880":49677},[],"Also run the chart's connectivity test:",{"_3394":432,"_29710":409,"_20617":49679,"_5":14139,"_27008":49628,"_2880":49680},[],"The test checks the health of CA, DMS Manager, Device Manager and VA, and verifies that the UI returns HTML. A passing test confirms basic connectivity, not a full issuance flow.",{"_3394":433,"_29710":409,"_20617":49682,"_5":14139,"_27008":49628,"_2880":49683},[],"The chart's services expose startup, readiness and liveness probes over /health. A pod can be running but receive no traffic if the readiness probe fails.",{"_3394":434,"_29710":409,"_20617":49685,"_5":14139,"_27008":49632,"_2880":49686},[],"If you receive a 401:",{"_3394":435,"_29710":409,"_20617":49688,"_5":14139,"_27008":49632,"_2880":49689},[],"check that the UI's OIDC authority is reachable from the browser;",{"_3394":436,"_29710":409,"_20617":49691,"_5":14139,"_27008":49632,"_2880":49692},[],"verify issuer, audience and expiration of the token;",{"_3394":437,"_29710":409,"_20617":49694,"_5":14139,"_27008":49632,"_2880":49695},[],"confirm the Gateway can fetch the keys from the JWKS URI;",{"_3394":438,"_29710":409,"_20617":49697,"_5":14139,"_27008":49632,"_2880":49698},[],"check that the provider's public and internal routes point to the same realm.",{"_3394":439,"_29710":409,"_20617":49700,"_5":14139,"_27008":49632,"_2880":49701},[],"If login succeeds but the APIs return 403:",{"_3394":440,"_29710":409,"_20617":49703,"_5":14139,"_27008":49632,"_2880":49704},[],"inspect the token's real claims;",{"_3394":441,"_29710":409,"_20617":49706,"_5":14139,"_27008":49632,"_2880":49707},[],"confirm they match an active principal;",{"_3394":442,"_29710":409,"_20617":49709,"_5":14139,"_27008":49632,"_2880":49710},[],"review the policies granted to that principal;",{"_3394":443,"_29710":409,"_20617":49712,"_5":14139,"_27008":49632,"_2880":49713},[],"verify that authz reaches PostgreSQL and its JWKS.",{"_3394":444,"_29710":409,"_20617":49715,"_5":14139,"_27008":49632,"_2880":49716},[],"On a fresh installation, confirm the migration Job finished. That Job creates schemas, migrates authz, preloads policies and provisions the principals defined in services.authz.bootstrap.",{"_3394":445,"_29710":409,"_20617":49718,"_5":14139,"_27008":49636,"_2880":49719},[],"External authorization fails closed by default. If authz is unavailable, protected routes are blocked.",{"_3394":446,"_29710":409,"_20617":49721,"_5":14139,"_27008":49636,"_2880":49722},[],"Locate the authz pod and Service.",{"_3394":447,"_29710":409,"_20617":49724,"_5":14139,"_27008":49636,"_2880":49725},[],"Check /health, logs and its database connection.",{"_3394":448,"_29710":409,"_20617":49727,"_5":14139,"_27008":49636,"_2880":49728},[],"Verify the DNS and port configured in externalAuthorization.",{"_3394":449,"_29710":409,"_20617":49730,"_5":14139,"_27008":49636,"_2880":49731},[],"Check the check route is /v1/ext\\_authz/check.",{"_3394":450,"_29710":409,"_20617":49733,"_5":14139,"_27008":49636,"_2880":49734},[],"Do not switch to failOpen: true as a permanent workaround: it would allow traffic without authorization during the outage.",{"_3394":451,"_29710":409,"_20617":49736,"_5":14139,"_27008":49640,"_2880":49737},[],"A 500 indicates an internal failure, such as an unavailable database. The `{\"err\": ...}` body currently includes the text of the internal error, which can contain schema, table and constraint names and, on connection failures, the database host and user (not the password). Find the cause in the service log using the request time, and do not forward the body to third parties or show it to end users. This is a known information-disclosure defect: generic messages are planned for 500 responses, keeping the detail only in the service log (tracked in lamassuiot#814). The authorization connector also returns the internal error, in the `details.error` field. Some request errors, such as a key size the engine does not support, are also returned as 500.",{"_3394":452,"_29710":409,"_20617":49739,"_5":14139,"_27008":49644,"_2880":49740},[],"Review kubectl describe pod first. Common causes are:",{"_3394":453,"_29710":409,"_20617":49742,"_5":14139,"_27008":49644,"_2880":49743},[],"wrong credentials or DNS for PostgreSQL or RabbitMQ;",{"_3394":454,"_29710":409,"_20617":49745,"_5":14139,"_27008":49644,"_2880":49746},[],"a missing AMQP CA or client certificate Secret referenced by `amqp.ca.secretName` or `amqp.client.secretName`;",{"_3394":455,"_29710":409,"_20617":49748,"_5":14139,"_27008":49644,"_2880":49749},[],"unbound persistent volume;",{"_3394":456,"_29710":409,"_20617":49751,"_5":14139,"_27008":49644,"_2880":49752},[],"inaccessible image or incorrect pull policy;",{"_3394":457,"_29710":409,"_20617":49754,"_5":14139,"_27008":49644,"_2880":49755},[],"invalid cryptographic engine configuration;",{"_3394":458,"_29710":409,"_20617":49757,"_5":14139,"_27008":49644,"_2880":49758},[],"CPU or memory limits set too low;",{"_3394":459,"_29710":409,"_20617":49760,"_5":14139,"_27008":49644,"_2880":49761},[],"an incomplete prior migration.",{"_3394":460,"_29710":409,"_20617":49763,"_5":14139,"_27008":49644,"_2880":49764},[],"Generic values request 100 mCPU and 128 MiB and limit to 500 mCPU and 512 MiB. Tune per service when you see OOMKills, throttling or slow startups.",{"_3394":461,"_29710":409,"_20617":49766,"_5":14139,"_27008":49644,"_2880":49767},[],"Filesystem-based KMS engines and VA local storage use exclusive-access volumes. Keep a single replica or migrate to shared backends before enabling autoscaling.",{"_3394":462,"_29710":409,"_20617":49769,"_5":14139,"_27008":49644,"_2880":49770},[],"Internal calls now fail fast instead of hanging for the clients covered by Egress proxy: connection attempts time out after 30 seconds and TLS handshakes after 10 seconds. The authorization-engine connector keeps its own transport without these dial and handshake timeouts; only its overall 30-second request timeout bounds each call. If an egress proxy handles the cluster's outbound traffic, check the pod's `HTTP_PROXY`, `HTTPS_PROXY` and `NO_PROXY` environment variables and list in-cluster service names in `NO_PROXY`.",{"_3394":463,"_29710":409,"_20617":49772,"_5":14139,"_27008":49648,"_2880":49773},[],"Domain and audit events depend on the bus publisher:",{"_3394":464,"_29710":409,"_20617":49775,"_5":14139,"_27008":49648,"_2880":49776},[],"verify it is enabled in the emitting service;",{"_3394":465,"_29710":409,"_20617":49778,"_5":14139,"_27008":49648,"_2880":49779},[],"check AMQP connectivity and credentials;",{"_3394":466,"_29710":409,"_20617":49781,"_5":14139,"_27008":49648,"_2880":49782},[],"review exchange, routing key, queues and consumers;",{"_3394":467,"_29710":409,"_20617":49784,"_5":14139,"_27008":49648,"_2880":49785},[],"inspect dead-letter queues;",{"_3394":468,"_29710":409,"_20617":49787,"_5":14139,"_27008":49648,"_2880":49788},[],"alert on orphan durable queues and backlog growth.",{"_3394":469,"_29710":409,"_20617":49790,"_5":14139,"_27008":49648,"_2880":49791},[],"If `amqp.tls` is enabled, verify the TLS side as well:",{"_3394":470,"_29710":409,"_20617":49793,"_5":14139,"_27008":49648,"_2880":49794},[],"confirm the broker listener speaks AMQPS on the configured port — the default port stays `5672` and does not follow TLS automatically;",{"_3394":471,"_29710":409,"_20617":49796,"_5":14139,"_27008":49648,"_2880":49797},[],"if you set `amqp.ca.secretName`, confirm the Secret exists in the release namespace and its data key matches `amqp.ca.certificateKey` (default `ca.crt`); if `amqp.ca.secretName` is not set, the clients trust the system CAs;",{"_3394":472,"_29710":409,"_20617":49799,"_5":14139,"_27008":49648,"_2880":49800},[],"remember that a missing referenced Secret prevents the consuming pods from starting;",{"_3394":473,"_29710":409,"_20617":49802,"_5":14139,"_27008":49648,"_2880":49803},[],"after updating the CA or client certificate Secret, restart the consuming pods: the AMQP client loads certificates at startup.",{"_3394":474,"_29710":409,"_20617":49805,"_5":14139,"_27008":49648,"_2880":49806},[],"See AMQP TLS (AMQPS) for the full configuration.",{"_3394":475,"_29710":409,"_20617":49808,"_5":14139,"_27008":49648,"_2880":49809},[],"A consumer outage does not always prevent the main operation from completing. That is why you must monitor RabbitMQ and independently verify the persistence of audit logs.",{"_3394":476,"_29710":409,"_20617":49811,"_5":14139,"_27008":49652,"_2880":49812},[],"The chart can enable OpenTelemetry instrumentation for the services that support it, including authz; it does not configure OpenTelemetry for AWS Connector, wfx or the UI. Traces are exported over OTLP HTTP and logs can be directed to a compatible endpoint, such as VictoriaLogs. Use a correlation identifier and the same time window to join Gateway, service and dependency.",{"_3394":477,"_29710":409,"_20617":49814,"_5":14139,"_27008":49652,"_2880":49815},[],"Before closing an incident, record:",{"_3394":478,"_29710":409,"_20617":49817,"_5":14139,"_27008":49652,"_2880":49818},[],"the confirmed cause;",{"_3394":479,"_29710":409,"_20617":49820,"_5":14139,"_27008":49652,"_2880":49821},[],"the time scope and affected resources;",{"_3394":480,"_29710":409,"_20617":49823,"_5":14139,"_27008":49652,"_2880":49824},[],"the commands or queries used;",{"_3394":481,"_29710":409,"_20617":49826,"_5":14139,"_27008":49652,"_2880":49827},[],"the applied change and how to revert it;",{"_3394":482,"_29710":409,"_20617":49829,"_5":14139,"_27008":49652,"_2880":49830},[],"validation from a consumer;",{"_3394":483,"_29710":409,"_20617":49832,"_5":14139,"_27008":49652,"_2880":49833},[],"the preventive action and its owner.",{"_3394":484,"_29710":484,"_5":14491,"_2880":49835,"_30042":49836,"_20617":49839,"_27008":484},"Access control",[48369,49837,49838],"Platform","Administration",[],{"_3394":485,"_29710":484,"_20617":49841,"_5":14139,"_27008":484,"_2880":49842},[],"Design who can access Lamassu through principals, policies, resource permissions and HTTP route authorization.",{"_3394":486,"_29710":484,"_5":30039,"_20617":49844,"_27008":49845,"_2880":49846},[],"/docs/platform/administration/access-control#essential-concepts","Essential concepts",{"_3394":487,"_29710":484,"_5":30039,"_20617":49848,"_27008":49849,"_2880":49850},[],"/docs/platform/administration/access-control#two-decision-systems","Two decision systems",{"_3394":488,"_29710":484,"_5":30039,"_20617":49852,"_27008":49853,"_2880":49854},[],"/docs/platform/administration/access-control#integrated-or-external-http-services","Integrated or external HTTP services",{"_3394":489,"_29710":484,"_5":30039,"_20617":49856,"_27008":49857,"_2880":49858},[],"/docs/platform/administration/access-control#authentication-only-routes-and-unmapped-paths","Authentication-only routes and unmapped paths",{"_3394":490,"_29710":484,"_5":30039,"_20617":49860,"_27008":49861,"_2880":49862},[],"/docs/platform/administration/access-control#services-developed-by-lamassu","Services developed by Lamassu",{"_3394":491,"_29710":484,"_5":30039,"_20617":49864,"_27008":49865,"_2880":49866},[],"/docs/platform/administration/access-control#how-the-two-paths-relate","How the two paths relate",{"_3394":492,"_29710":484,"_5":30039,"_20617":49868,"_27008":49869,"_2880":49870},[],"/docs/platform/administration/access-control#oidc-principals","OIDC principals",{"_3394":493,"_29710":484,"_5":30039,"_20617":49872,"_27008":49873,"_2880":49874},[],"/docs/platform/administration/access-control#x509-principals","X.509 principals",{"_3394":494,"_29710":484,"_5":30039,"_20617":49876,"_27008":49877,"_2880":49878},[],"/docs/platform/administration/access-control#when-several-principals-match","When several principals match",{"_3394":495,"_29710":484,"_5":30039,"_20617":49880,"_27008":49881,"_2880":49882},[],"/docs/platform/administration/access-control#how-policies-express-access","How policies express access",{"_3394":496,"_29710":484,"_5":30039,"_20617":49884,"_27008":49885,"_2880":49886},[],"/docs/platform/administration/access-control#global-and-direct-access","Global and direct access",{"_3394":497,"_29710":484,"_5":30039,"_20617":49888,"_27008":49889,"_2880":49890},[],"/docs/platform/administration/access-control#access-inherited-through-relations","Access inherited through relations",{"_3394":498,"_29710":484,"_5":30039,"_20617":49892,"_27008":49893,"_2880":49894},[],"/docs/platform/administration/access-control#attribute-filtered-access","Attribute-filtered access",{"_3394":499,"_29710":484,"_5":30039,"_20617":49896,"_27008":49897,"_2880":49898},[],"/docs/platform/administration/access-control#http-rules","HTTP rules",{"_3394":500,"_29710":484,"_5":30039,"_20617":49900,"_27008":49901,"_2880":49902},[],"/docs/platform/administration/access-control#included-policies","Included policies",{"_3394":501,"_29710":484,"_5":30039,"_20617":49904,"_27008":49905,"_2880":49009},[],"/docs/platform/administration/access-control#provision-the-first-administrator",{"_3394":502,"_29710":484,"_5":30039,"_20617":49907,"_27008":49908,"_2880":49909},[],"/docs/platform/administration/access-control#prepare-the-identity-provider","Prepare the identity provider",{"_3394":503,"_29710":484,"_5":30039,"_20617":49911,"_27008":49912,"_2880":49913},[],"/docs/platform/administration/access-control#configure-token-validation","Configure token validation",{"_3394":504,"_29710":484,"_5":30039,"_20617":49915,"_27008":49916,"_2880":49917},[],"/docs/platform/administration/access-control#install-and-verify-administrative-access","Install and verify administrative access",{"_3394":505,"_29710":484,"_5":30039,"_20617":49919,"_27008":49920,"_2880":49921},[],"/docs/platform/administration/access-control#test-an-unprivileged-identity","Test an unprivileged identity",{"_3394":506,"_29710":484,"_5":30039,"_20617":49923,"_27008":49924,"_2880":49925},[],"/docs/platform/administration/access-control#reduce-use-of-the-bootstrap-administrator","Reduce use of the bootstrap administrator",{"_3394":507,"_29710":484,"_5":30039,"_20617":49927,"_27008":49928,"_2880":49929},[],"/docs/platform/administration/access-control#fastlane-bootstrap","Fastlane bootstrap",{"_3394":508,"_29710":484,"_5":30039,"_20617":49931,"_27008":49932,"_2880":49933},[],"/docs/platform/administration/access-control#design-least-privilege-roles","Design least-privilege roles",{"_3394":509,"_29710":484,"_5":30039,"_20617":49935,"_27008":49936,"_2880":49937},[],"/docs/platform/administration/access-control#changes-and-access-revocation","Changes and access revocation",{"_3394":510,"_29710":484,"_5":30039,"_20617":49939,"_27008":49940,"_2880":49941},[],"/docs/platform/administration/access-control#operational-checklist","Operational checklist",{"_3394":511,"_29710":484,"_5":30039,"_20617":49943,"_27008":49944,"_2880":49945},[],"/docs/platform/administration/access-control#diagnostics","Diagnostics",{"_3394":512,"_29710":484,"_5":30039,"_20617":49947,"_27008":49948,"_2880":49949},[],"/docs/platform/administration/access-control#the-response-is-401","The response is 401",{"_3394":513,"_29710":484,"_5":30039,"_20617":49951,"_27008":49952,"_2880":49953},[],"/docs/platform/administration/access-control#the-response-is-403","The response is 403",{"_3394":514,"_29710":484,"_5":30039,"_20617":49955,"_27008":49956,"_2880":49957},[],"/docs/platform/administration/access-control#everything-returns-403","Everything returns 403",{"_3394":515,"_29710":484,"_5":30039,"_20617":49959,"_27008":49960,"_2880":49961},[],"/docs/platform/administration/access-control#access-appears-without-a-policy-grant","Access appears without a policy grant",{"_3394":516,"_29710":484,"_5":30039,"_20617":49963,"_27008":49964,"_2880":49965},[],"/docs/platform/administration/access-control#everything-fails-when-authz-is-unavailable","Everything fails when authz is unavailable",{"_3394":517,"_29710":484,"_20617":49967,"_5":14139,"_27008":484,"_2880":49968},[],"Lamassu access control turns an authenticated identity into concrete permissions. The OIDC provider or the client certificate proves **who** makes a request; the `authz` service decides **what that identity can do** and **over which resources**.",{"_3394":518,"_29710":484,"_20617":49970,"_5":14139,"_27008":484,"_2880":49971},[],"Lamassu does not assign permissions directly to users. The full chain is:",{"_3394":519,"_29710":484,"_20617":49973,"_5":14139,"_27008":484,"_2880":49974},[],"This model lets you represent people, identity-provider groups, service accounts and devices without coupling authorization to a specific provider.",{"_3394":520,"_29710":484,"_20617":49976,"_5":14139,"_27008":49845,"_2880":49977},[],"A **principal** connects a credential to Lamassu. It defines how to recognize an OIDC or X.509 identity and can be active or disabled.",{"_3394":521,"_29710":484,"_20617":49979,"_5":14139,"_27008":49845,"_2880":49980},[],"A **policy** groups reusable permissions. It can be granted to several principals and can contain rules about Lamassu entities, rules about HTTP routes or both.",{"_3394":522,"_29710":484,"_20617":49982,"_5":14139,"_27008":49845,"_2880":49983},[],"An **entity rule** grants actions over resources such as certification authorities, certificates, issuance profiles, devices, DMSs, keys or alert subscriptions. It can cover all resources of a type or be limited by identifier, relation or attribute.",{"_3394":523,"_29710":484,"_20617":49985,"_5":14139,"_27008":49845,"_2880":49986},[],"An **HTTP rule** grants actions associated with API routes. It is the mechanism the Gateway uses to decide whether a request may cross the perimeter.",{"_3394":524,"_29710":484,"_20617":49988,"_5":14139,"_27008":49845,"_2880":49989},[],"A **grant** is the association between a principal and a policy. Removing the grant removes all permissions contributed by that policy, without modifying it for other principals.",{"_3394":525,"_29710":484,"_20617":49991,"_5":14139,"_27008":49845,"_2880":49992},[],"A valid JWT or a valid client certificate does not grant access by itself. The credential must match at least one active principal and, unless the HTTP schema exempts the route, one of its policies must allow the requested operation. See *Authentication-only routes and unmapped paths* for those exemptions.",{"_3394":526,"_29710":484,"_20617":49994,"_5":14139,"_27008":49849,"_2880":49995},[],"Lamassu uses two authorization paths depending on who implements the protected service. They share principals, policies and grants, but they do not interpret the rules the same way.",{"_3394":527,"_29710":484,"_20617":49997,"_5":14139,"_27008":49849,"_2880":49998},[],"An external service can be protected without knowing Lamassu's internal authorization model. A service developed by Lamassu embeds the authorization engine and can decide on concrete resources and filter its queries.",{"_3394":528,"_29710":484,"_20617":50000,"_5":14139,"_27008":49853,"_2880":50001},[],"This path protects APIs that join the platform through the Gateway but do not natively implement Lamassu's authorization SDK. Job Manager is the current example. The same pattern allows integrating other HTTP services as long as their routes are described in an `authz` HTTP schema.",{"_3394":529,"_29710":484,"_20617":50003,"_5":14139,"_27008":49853,"_2880":50004},[],"The decision is made **before forwarding the request to the service**:",{"_3394":530,"_29710":484,"_20617":50006,"_5":14139,"_27008":49853,"_2880":50007},[],"Envoy Gateway authenticates the request, usually validating a JWT against the OIDC provider's JWKS.",{"_3394":531,"_29710":484,"_20617":50009,"_5":14139,"_27008":49853,"_2880":50010},[],"For a protected route, Envoy sends the method, URL, headers and required data to `/v1/ext_authz/check`.",{"_3394":532,"_29710":484,"_20617":50012,"_5":14139,"_27008":49853,"_2880":50013},[],"`authz` extracts the credential and resolves all active principals matching it.",{"_3394":533,"_29710":484,"_20617":50015,"_5":14139,"_27008":49853,"_2880":50016},[],"It separately loads the policies granted to each principal.",{"_3394":534,"_29710":484,"_20617":50018,"_5":14139,"_27008":49853,"_2880":50019},[],"The HTTP schema translates the method and route combination into a logical action, such as `nbi-job-read` or `nbi-workflow-create`.",{"_3394":535,"_29710":484,"_20617":50021,"_5":14139,"_27008":49853,"_2880":50022},[],"`authz` looks for an HTTP rule granting that action.",{"_3394":536,"_29710":484,"_20617":50024,"_5":14139,"_27008":49853,"_2880":50025},[],"If the route declares constraints, it compares request data with the normalized attributes of the same principal contributing the policy; the policy's own `param_constraints` also pin the granted action to literal request values.",{"_3394":537,"_29710":484,"_20617":50027,"_5":14139,"_27008":49853,"_2880":50028},[],"A satisfying result lets Envoy forward the request; any other response blocks it at the Gateway.",{"_3394":538,"_29710":484,"_20617":50030,"_5":14139,"_27008":49853,"_2880":50031},[],"When it allows access, `authz` returns the selected principal in the `X-Principal-ID` response header. The Gateway can propagate that header to the service to preserve the identity context.",{"_3394":539,"_29710":484,"_20617":50033,"_5":14139,"_27008":49853,"_2880":50034},[],"HTTP rules primarily answer &#x2A;*\"can this identity call this API operation?\"**. On their own they do not produce filters over the external service's database. To limit a route to a specific device, tenant or client, either the schema declares a constraint relating a request value to a normalized attribute of the principal, or the policy pins the request value to a literal with `param_constraints`. The first scopes each identity to its own resources through a single grant; the second restricts a grant to a fixed value regardless of who holds it.",{"_3394":540,"_29710":484,"_20617":50036,"_5":14139,"_27008":49857,"_2880":50037},[],"Two schema-level settings cover endpoints that policies do not mention:",{"_3394":541,"_29710":484,"_20617":50039,"_5":14139,"_27008":49857,"_2880":50040},[],"**`skip_authz: true` on a route** allows any identity that matches an active principal to reach it, even one with no granted policies. Use it for paths such as `/openapi.json` or `/health` that every authenticated caller should be able to access. The request still has to authenticate successfully: a credential that fails validation or matches no active principal is rejected before this setting is considered. A `skip_authz` route cannot declare constraints, and it wins over any other schema's route or default action for the same request.",{"_3394":542,"_29710":484,"_20617":50042,"_5":14139,"_27008":49857,"_2880":50043},[],"**`default_action` with `base_paths`** decides what happens when a request falls under a path prefix the schema owns but no explicit route matches. `deny` — the value the Job Manager schema ships with — turns the implicit denial of unmapped paths into an explicit, auditable statement; `allow` opens unmapped endpoints under that prefix to any identity that matches an active principal.",{"_3394":543,"_29710":484,"_20617":50045,"_5":14139,"_27008":49857,"_2880":50046},[],"These are decisions of the schema, not of a policy: `skip_authz` removes the grant check for that route, even when another schema maps the same request to an action that requires a grant, and `default_action` only covers requests that no explicit route in any schema matches. Keep three rules in mind:",{"_3394":544,"_29710":484,"_20617":50048,"_5":14139,"_27008":49857,"_2880":50049},[],"`default_action` requires at least one `base_paths` entry, and base paths are absolute paths such as `/api/wfx/nbi/v1`.",{"_3394":545,"_29710":484,"_20617":50051,"_5":14139,"_27008":49857,"_2880":50052},[],"An explicit route in any schema takes precedence: the fallback only decides requests that no schema's routes cover. When the prefixes of two schemas overlap, the longest matching prefix decides.",{"_3394":546,"_29710":484,"_20617":50054,"_5":14139,"_27008":49857,"_2880":50055},[],"Two schemas cannot claim the same base path with different default actions; the conflicting schema fails to load.",{"_3394":547,"_29710":484,"_20617":50057,"_5":14139,"_27008":49857,"_2880":50058},[],"A `skip_authz` route and a `default_action: \"allow\"` prefix grant access without consulting any policy. Every identity that matches an active principal can reach what they open, including identities with no granted policies. A `skip_authz` route in one schema also opens a request that another schema maps to a grant-protected action. Review these settings whenever you add or upgrade an integrated service.",{"_3394":548,"_29710":484,"_20617":50060,"_5":14139,"_27008":49861,"_2880":50061},[],"Lamassu's native services embed authorization in their middleware and know the entities they operate on: certificates, CAs, issuance profiles, keys, devices, DMSs or subscriptions, among others.",{"_3394":549,"_29710":484,"_20617":50063,"_5":14139,"_27008":49861,"_2880":50064},[],"The decision is made with the domain operation context:",{"_3394":550,"_29710":484,"_20617":50066,"_5":14139,"_27008":49861,"_2880":50067},[],"The middleware extracts the credential and resolves the matching principals.",{"_3394":551,"_29710":484,"_20617":50069,"_5":14139,"_27008":49861,"_2880":50070},[],"The endpoint identifies the action, the entity type and, when applicable, the key of the requested resource.",{"_3394":552,"_29710":484,"_20617":50072,"_5":14139,"_27008":49861,"_2880":50073},[],"`authz` gathers the entity rules of the granted policies.",{"_3394":553,"_29710":484,"_20617":50075,"_5":14139,"_27008":49861,"_2880":50076},[],"The engine evaluates direct grants, attribute filters and relations with other entities.",{"_3394":554,"_29710":484,"_20617":50078,"_5":14139,"_27008":49861,"_2880":50079},[],"For an individual operation, it checks that the concrete resource satisfies the computed scope.",{"_3394":555,"_29710":484,"_20617":50081,"_5":14139,"_27008":49861,"_2880":50082},[],"For a listing, it generates a SQL filter that the service adds to its own query.",{"_3394":556,"_29710":484,"_20617":50084,"_5":14139,"_27008":49861,"_2880":50085},[],"Here the engine answers &#x2A;*\"can this identity perform this action on this concrete resource?\"**.",{"_3394":557,"_29710":484,"_20617":50087,"_5":14139,"_27008":49861,"_2880":50088},[],"Actions fall into two groups:",{"_3394":558,"_29710":484,"_20617":50090,"_5":14139,"_27008":49861,"_2880":50091},[],"**Global actions** do not need a resource identifier. `create`, `import` or access to a console section are common examples.",{"_3394":559,"_29710":484,"_20617":50093,"_5":14139,"_27008":49861,"_2880":50094},[],"**Atomic actions** are evaluated on a concrete instance. For certificates these include `read`, `metadata-update`, `status-update` and `delete`; for a CA there are also `sign`, `reissue` and other lifecycle operations.",{"_3394":560,"_29710":484,"_20617":50096,"_5":14139,"_27008":49861,"_2880":50097},[],"Filtering inside the service prevents leaks in listings: unauthorized resources are excluded from the SQL query instead of being fetched and hidden later in the interface.",{"_3394":561,"_29710":484,"_20617":50099,"_5":14139,"_27008":49865,"_2880":50100},[],"They are not two equivalent controls applied twice. HTTP rules protect the perimeter of an integrated service; entity rules express permissions over the data model of the native services.",{"_3394":562,"_29710":484,"_20617":50102,"_5":14139,"_27008":49865,"_2880":50103},[],"A policy can contain both rule types when an identity needs to operate Lamassu resources and also call an integrated API. Granting an entity rule does not automatically grant an HTTP action, nor does an HTTP rule create access over an entity.",{"_3394":563,"_29710":484,"_20617":50105,"_5":14139,"_27008":49865,"_2880":50106},[],"If no combination of principal, policy and rule allows the operation, Lamassu denies it, unless the HTTP schema declares `skip_authz` on the route or `default_action: allow` on a base path that covers it (see *Authentication-only routes and unmapped paths*). Additionally, `auth.externalAuthorization.failOpen` is `false` by default: if `authz` is unavailable, the Gateway blocks protected routes.",{"_3394":564,"_29710":484,"_20617":50108,"_5":14139,"_27008":49869,"_2880":50109},[],"An OIDC principal matches the claims of a validated JWT. It is appropriate for human users, corporate groups, IdP roles and service accounts that obtain tokens.",{"_3394":565,"_29710":484,"_20617":50111,"_5":14139,"_27008":49869,"_2880":50112},[],"The following principal represents any identity holding the `pki-operators` role in Keycloak:",{"_3394":566,"_29710":484,"_20617":50114,"_5":14139,"_27008":49869,"_2880":50115},[],"Claim paths can be nested, such as `realm_access.roles`. Within a single principal, **all** conditions must hold. This lets you require, for example, a group and an organizational audience at the same time.",{"_3394":567,"_29710":484,"_20617":50117,"_5":14139,"_27008":49869,"_2880":50118},[],"The implemented operators are:",{"_3394":568,"_29710":484,"_20617":50120,"_5":14139,"_27008":49869,"_2880":50121},[],"`equals`, for exact equality;",{"_3394":569,"_29710":484,"_20617":50123,"_5":14139,"_27008":49869,"_2880":50124},[],"`contains`, to check membership in a list or the presence of text in a scalar value.",{"_3394":570,"_29710":484,"_20617":50126,"_5":14139,"_27008":49869,"_2880":50127},[],"Design matching with stable attributes. For people, it is usually better to bind permissions to centrally managed groups or roles than to the email or username. For a service account, a stable `sub` keeps its permissions from mixing with a human operator's.",{"_3394":571,"_29710":484,"_20617":50129,"_5":14139,"_27008":49869,"_2880":50130},[],"Although the model recognizes the operator name `matches`, the current implementation does not evaluate regular expressions and the condition never matches. Use `equals` or `contains`.",{"_3394":572,"_29710":484,"_20617":50132,"_5":14139,"_27008":49873,"_2880":50133},[],"An X.509 principal lets you recognize a workload or a device by its client certificate. Lamassu checks the certificate signature against the configured CA and, depending on the mode, also its serial number or Common Name.",{"_3394":573,"_29710":484,"_20617":50135,"_5":14139,"_27008":49873,"_2880":50136},[],"The available modes are:",{"_3394":574,"_29710":484,"_20617":50138,"_5":14139,"_27008":49873,"_2880":50139},[],"`serial_and_ca`: an exact certificate, identified by serial number and CA;",{"_3394":575,"_29710":484,"_20617":50141,"_5":14139,"_27008":49873,"_2880":50142},[],"`cn_and_ca`: an exact or wildcard Common Name and a specific CA;",{"_3394":576,"_29710":484,"_20617":50144,"_5":14139,"_27008":49873,"_2880":50145},[],"`any_from_ca`: any certificate issued directly by the given CA.",{"_3394":577,"_29710":484,"_20617":50147,"_5":14139,"_27008":49873,"_2880":50148},[],"This example recognizes certificates whose CN starts with `factory-a-` and that are signed by the configured CA:",{"_3394":578,"_29710":484,"_20617":50150,"_5":14139,"_27008":49873,"_2880":50151},[],"`ca_trust.identity_type` accepts `fingerprint` or `authority_key_id`. In both cases you must provide the CA certificate in `ca_trust.pem`; Lamassu verifies both the signature and the expected identity of the CA.",{"_3394":579,"_29710":484,"_20617":50153,"_5":14139,"_27008":49873,"_2880":50154},[],"Use `any_from_ca` only when every identity issued by that CA should share the same permissions. If a CA issues certificates for different populations, separate access by serial or CN, or use different issuing CAs.",{"_3394":580,"_29710":484,"_20617":50156,"_5":14139,"_27008":49877,"_2880":50157},[],"A single credential can match more than one principal. It is common for a user to match a principal of their team and another of their operational function.",{"_3394":581,"_29710":484,"_20617":50159,"_5":14139,"_27008":49877,"_2880":50160},[],"For entity permissions, Lamassu combines permissions with OR logic: it is enough that one policy of one of the principals allows the action. Listings contain the union of the resources visible to all of them.",{"_3394":582,"_29710":484,"_20617":50162,"_5":14139,"_27008":49877,"_2880":50163},[],"HTTP routes with constraints are stricter. The same principal contributing the policy must also satisfy the attributes required by the route. Lamassu does not combine one principal's policy with an attribute belonging to another.",{"_3394":583,"_29710":484,"_20617":50165,"_5":14139,"_27008":49877,"_2880":50166},[],"For this reason, adding a matching principal can only broaden access. Before creating overlapping rules, review the full set of policies a real identity will receive.",{"_3394":584,"_29710":484,"_20617":50168,"_5":14139,"_27008":49885,"_2880":50169},[],"A rule identifies the domain (`namespace`), the data schema (`schema_name`) and the entity type (`entity_type`). `actions` lists the allowed operations.",{"_3394":585,"_29710":484,"_20617":50171,"_5":14139,"_27008":49885,"_2880":50172},[],"`direct_grants` limits the rule to concrete identifiers. The value `*` covers all instances of the type. A superadministrator policy uses wildcards in schema, entity, actions and grants; a least-privilege policy should avoid them whenever possible.",{"_3394":586,"_29710":484,"_20617":50174,"_5":14139,"_27008":49889,"_2880":50175},[],"Rules can follow relations declared between entities. For example, the schema knows the relation of a certificate to its issuing CA and of a device to its DMS. A policy can grant access to a parent resource and propagate selected actions to its related resources.",{"_3394":587,"_29710":484,"_20617":50177,"_5":14139,"_27008":49889,"_2880":50178},[],"This lets you express models like \"can operate the devices of this DMS\" without maintaining an individual list of every device. When a resource is added under that relation, it inherits the scope planned by the policy.",{"_3394":588,"_29710":484,"_20617":50180,"_5":14139,"_27008":49893,"_2880":50181},[],"`column_filters` applies conditions to columns the schema has declared filterable. All filters of the same rule are combined with AND.",{"_3394":589,"_29710":484,"_20617":50183,"_5":14139,"_27008":49893,"_2880":50184},[],"For example, this rule allows reading active certificates issued by a specific CA:",{"_3394":590,"_29710":484,"_20617":50186,"_5":14139,"_27008":49893,"_2880":50187},[],"The available operators are `eq`, `neq`, `gt`, `gte`, `lt`, `lte`, `in` and `like`. Use comparisons consistent with the column type: `like` for text, ordering comparisons for numbers or dates and `in` when there is a collection of accepted values.",{"_3394":591,"_29710":484,"_20617":50189,"_5":14139,"_27008":49897,"_2880":50190},[],"HTTP rules do not point directly at tables. They reference a route schema and grant its logical actions. Job Manager's policies are an example: they distinguish reading, creating, updating and deleting workflows or jobs.",{"_3394":592,"_29710":484,"_20617":50192,"_5":14139,"_27008":49897,"_2880":50193},[],"Some routes also compare a request value — taken from the path, query, header or JSON body — with a normalized attribute of the principal. This way you can verify that a device only queries jobs addressed to its own `client_id`.",{"_3394":593,"_29710":484,"_20617":50195,"_5":14139,"_27008":49897,"_2880":50196},[],"Normalized attributes decouple the policy from the authentication mechanism. `subject_attribute_mappings` can derive, for example, `device_id` from `oidc.claim.device_id` or from `x509.subject.cn`. The rule consumes `device_id` in both cases.",{"_3394":594,"_29710":484,"_20617":50198,"_5":14139,"_27008":49897,"_2880":50199},[],"An HTTP rule can also pin a granted action to a literal value carried by the request itself through `param_constraints`. It extracts the value with the same sources as route constraints — `path_regex_group`, `query`, `header` or `json_body` — but compares it against an `equals` literal written into the policy rather than against a subject attribute. The grant then depends only on the request, not on who holds the policy:",{"_3394":595,"_29710":484,"_20617":50201,"_5":14139,"_27008":49897,"_2880":50202},[],"Combined with a schema route such as `^/api/mysvc/system/([^/]+)/info$`, this grants `GET /api/mysvc/system/1/info` and denies the same call for system `2`, regardless of the principal's attributes. The same mechanism pins query parameters, headers or JSON body fields, for example `{ \"source\": \"query\", \"name\": \"tenant_id\" }` with `\"equals\": \"1\"` to accept only requests carrying `?tenant_id=1`.",{"_3394":596,"_29710":484,"_20617":50204,"_5":14139,"_27008":49897,"_2880":50205},[],"Note that:",{"_3394":597,"_29710":484,"_20617":50207,"_5":14139,"_27008":49897,"_2880":50208},[],"`action` must be one of the actions granted by the rule; `equals` is required; `path_regex_group` needs an `index` greater than zero, `query` and `header` need a `name`, and `json_body` needs a `path` such as `$.tenant_id`.",{"_3394":598,"_29710":484,"_20617":50210,"_5":14139,"_27008":49897,"_2880":50211},[],"`param_constraints` are not cross-checked against the schema when the policy is loaded. A reference the route cannot satisfy — for instance a `path_regex_group` on a route without capture groups — simply never matches, and the request is denied.",{"_3394":599,"_29710":484,"_20617":50213,"_5":14139,"_27008":49897,"_2880":50214},[],"Several `param_constraints` for the same action combine with AND. A rule without them keeps the usual behavior: the action is granted wherever the route matches and the subject constraints pass.",{"_3394":600,"_29710":484,"_20617":50216,"_5":14139,"_27008":49901,"_2880":50217},[],"The `authz` preload installs reusable policies for the main domains. Among them are:",{"_3394":601,"_29710":484,"_20617":50219,"_5":14139,"_27008":49901,"_2880":50220},[],"full and read-only access to certificates and authorities;",{"_3394":602,"_29710":484,"_20617":50222,"_5":14139,"_27008":49901,"_2880":50223},[],"full and read-only access to the KMS;",{"_3394":603,"_29710":484,"_20617":50225,"_5":14139,"_27008":49901,"_2880":50226},[],"full and read-only access to Device Manager, DMS Manager, Validation Authority and alerts;",{"_3394":604,"_29710":484,"_20617":50228,"_5":14139,"_27008":49901,"_2880":50229},[],"an `Auditor` policy with PKI read access and authorization visibility;",{"_3394":605,"_29710":484,"_20617":50231,"_5":14139,"_27008":49901,"_2880":50232},[],"console access;",{"_3394":606,"_29710":484,"_20617":50234,"_5":14139,"_27008":49901,"_2880":50235},[],"administration and observation policies for the Job Manager NBI and SBI APIs;",{"_3394":607,"_29710":484,"_20617":50237,"_5":14139,"_27008":49901,"_2880":50238},[],"`SUPER ADMIN`, which grants all actions over the `authz` and `pki` domains.",{"_3394":608,"_29710":484,"_20617":50240,"_5":14139,"_27008":49901,"_2880":50241},[],"Start with these policies before creating others. If none reflects the boundary you need, create a specific, small policy instead of copying `SUPER ADMIN` and informally removing permissions.",{"_3394":609,"_29710":484,"_20617":50243,"_5":14139,"_27008":49905,"_2880":50244},[],"An installation without a principal matching your identity is left with nobody able to administer authorization. Configure the IdP and the bootstrap before exposing the platform.",{"_3394":610,"_29710":484,"_20617":50246,"_5":14139,"_27008":49905,"_2880":50247},[],"The chart includes a bootstrap principal that looks for the OIDC role `pki-admin` in `realm_access.roles`. It grants it `SUPER ADMIN` and, when Job Manager is enabled, the administrative policy of its NBI API.",{"_3394":611,"_29710":484,"_20617":50249,"_5":14139,"_27008":49905,"_2880":50250},[],"The pre-install and pre-upgrade Helm Job runs the `authz` migrations, preloads the policies and creates the bootstrap principals before the services start. If the principal already exists, it does not replace it: it only adds the configured grants that are still missing. You can keep the entry in `values.yaml` across upgrades.",{"_3394":612,"_29710":484,"_20617":50252,"_5":14139,"_27008":49908,"_2880":50253},[],"Create the role or group you will use to administer Lamassu. Assign it to at least two controlled human identities. If your provider does not use `realm_access.roles`, adapt the claim path in both the frontend and `auth_config.claims`.",{"_3394":613,"_29710":484,"_20617":50255,"_5":14139,"_27008":49912,"_2880":50256},[],"`authz` validates every token against `services.authz.jwkUrl`, which is fetched from the `authz` pod. The Gateway does not validate tokens itself: Lamassu services authorize each request through `authz`, and routes labeled `auth=external`, such as the Job Manager ones, are checked by the Gateway through `authz` when `auth.externalAuthorization` is enabled. The endpoint must serve the keys of the issuer configured in `auth.oidc.frontend.authority`.",{"_3394":614,"_29710":484,"_20617":50258,"_5":14139,"_27008":49912,"_2880":50259},[],"Releases upgraded from 3.8.0 must remove `auth.oidc.apiGateway` and `auth.authorization`, which the 4.0.0 chart rejects. See 3.8.0 to 4.0.0.",{"_3394":615,"_29710":484,"_20617":50261,"_5":14139,"_27008":49916,"_2880":50262},[],"Sign in with an identity holding `pki-admin`. Confirm it can access authorization administration and perform a non-destructive read operation.",{"_3394":616,"_29710":484,"_20617":50264,"_5":14139,"_27008":49920,"_2880":50265},[],"Use a second user without the role and confirm the same operation is denied. This test catches misread claims, overly broad policies and accidental `failOpen` configurations.",{"_3394":617,"_29710":484,"_20617":50267,"_5":14139,"_27008":49924,"_2880":50268},[],"Create operational principals with narrower policies. Reserve `pki-admin` for authorization administration and recovery, not for daily work.",{"_3394":618,"_29710":484,"_20617":50270,"_5":14139,"_27008":49928,"_2880":50271},[],"Fastlane installs a Keycloak realm for the lab and creates the user `lamassu` with the temporary password `lamassu`, the role `pki-admin` and a mandatory password change. Its bootstrap principal matches through `preferred_username=lamassu`.",{"_3394":619,"_29710":484,"_20617":50273,"_5":14139,"_27008":49928,"_2880":50274},[],"Change the password on first login. Do not reuse the Fastlane user, password or IdP as a production design.",{"_3394":620,"_29710":484,"_20617":50276,"_5":14139,"_27008":49932,"_2880":50277},[],"Avoid reproducing your company's internal structure with dozens of nearly identical policies. Start from the responsibilities that actually need access:",{"_3394":621,"_29710":484,"_20617":50279,"_5":14139,"_27008":49932,"_2880":50280},[],"**Authorization administration**: manages principals, policies and grants. It should belong to a small, separate group.",{"_3394":622,"_29710":484,"_20617":50282,"_5":14139,"_27008":49932,"_2880":50283},[],"**PKI operation**: administers CAs, profiles and certificates, but not necessarily who gets access.",{"_3394":623,"_29710":484,"_20617":50285,"_5":14139,"_27008":49932,"_2880":50286},[],"**Device registration**: operates devices and DMSs without receiving permissions over keys or authorization configuration.",{"_3394":624,"_29710":484,"_20617":50288,"_5":14139,"_27008":49932,"_2880":50289},[],"**Audit**: reviews configuration and activity without creating, modifying, signing, revoking or deleting.",{"_3394":625,"_29710":484,"_20617":50291,"_5":14139,"_27008":49932,"_2880":50292},[],"**Automation**: uses a technical account or a separate certificate, with permissions limited to the flow and resources it controls.",{"_3394":626,"_29710":484,"_20617":50294,"_5":14139,"_27008":49932,"_2880":50295},[],"For each role, separate \"view\" from \"change\", limit resources through grants, relations or attributes and avoid `*` unless the role must automatically cover future actions.",{"_3394":627,"_29710":484,"_20617":50297,"_5":14139,"_27008":49932,"_2880":50298},[],"A rule with `actions: [\"*\"]` expands to every action defined by the schema. When a new version adds an action, a wildcard policy may start granting it. Review these policies on every upgrade.",{"_3394":628,"_29710":484,"_20617":50300,"_5":14139,"_27008":49936,"_2880":50301},[],"To revoke access immediately, disable the principal or revoke its grants. Disabling a principal keeps its configuration and associations for investigation or restoration, but it stops taking part in matching.",{"_3394":629,"_29710":484,"_20617":50303,"_5":14139,"_27008":49936,"_2880":50304},[],"Deleting a role or group in the IdP prevents new tokens from containing the claim, but an already-issued token may remain valid until it expires. If removal is urgent, combine the IdP change with disabling the principal in Lamassu and revoking sessions or tokens at the provider.",{"_3394":630,"_29710":484,"_20617":50306,"_5":14139,"_27008":49936,"_2880":50307},[],"When you edit a shared policy, remember the change affects all its principals. To test a new scope, create a separate policy, grant it to a test identity and validate allowed and denied operations before replacing the old one.",{"_3394":631,"_29710":484,"_20617":50309,"_5":14139,"_27008":49940,"_2880":50310},[],"Keep `failOpen: false` unless a documented risk assessment justifies otherwise.",{"_3394":632,"_29710":484,"_20617":50312,"_5":14139,"_27008":49940,"_2880":50313},[],"Use groups or stable roles for people and independent identities for automations.",{"_3394":633,"_29710":484,"_20617":50315,"_5":14139,"_27008":49940,"_2880":50316},[],"Keep at least two recovery administrators and test their access periodically.",{"_3394":634,"_29710":484,"_20617":50318,"_5":14139,"_27008":49940,"_2880":50319},[],"Review active principals, their matches and their grants after IdP changes.",{"_3394":635,"_29710":484,"_20617":50321,"_5":14139,"_27008":49940,"_2880":50322},[],"Search for wildcards in policies before upgrading Lamassu.",{"_3394":636,"_29710":484,"_20617":50324,"_5":14139,"_27008":49940,"_2880":50325},[],"Review `skip_authz` routes and `default_action` settings in HTTP schemas when integrating or upgrading a service.",{"_3394":637,"_29710":484,"_20617":50327,"_5":14139,"_27008":49940,"_2880":50328},[],"Always test one allowed and one denied operation for each role.",{"_3394":638,"_29710":484,"_20617":50330,"_5":14139,"_27008":49940,"_2880":50331},[],"Correlate changes to principals, policies and grants with the audit logs.",{"_3394":639,"_29710":484,"_20617":50333,"_5":14139,"_27008":49948,"_2880":50334},[],"Authentication failed before permissions were evaluated. Check the JWT signature and expiration, issuer, audience and the availability of the JWKS configured in the Gateway. For X.509, check that the client certificate reaches the point that extracts the credential.",{"_3394":640,"_29710":484,"_20617":50336,"_5":14139,"_27008":49952,"_2880":50337},[],"The credential could be processed but did not produce a positive authorization. Review in this order:",{"_3394":641,"_29710":484,"_20617":50339,"_5":14139,"_27008":49952,"_2880":50340},[],"that an active principal of the correct type exists;",{"_3394":642,"_29710":484,"_20617":50342,"_5":14139,"_27008":49952,"_2880":50343},[],"that the claim paths and values match the real token exactly;",{"_3394":643,"_29710":484,"_20617":50345,"_5":14139,"_27008":49952,"_2880":50346},[],"that all of the principal's conditions hold;",{"_3394":644,"_29710":484,"_20617":50348,"_5":14139,"_27008":49952,"_2880":50349},[],"that the principal has the expected policy granted;",{"_3394":645,"_29710":484,"_20617":50351,"_5":14139,"_27008":49952,"_2880":50352},[],"that the policy includes the action and the requested resource type or route;",{"_3394":646,"_29710":484,"_20617":50354,"_5":14139,"_27008":49952,"_2880":50355},[],"that the identifier, relation, column filter or HTTP constraint includes the real resource.",{"_3394":647,"_29710":484,"_20617":50357,"_5":14139,"_27008":49952,"_2880":50358},[],"In the `authz` logs, an external endpoint decision includes `allowed`, `reason`, `matched_principals`, `evaluated_policy_ids`, `matched_policy_id` and the status code. These fields let you separate a matching failure from a permissions failure. With OpenTelemetry tracing enabled, a request that reaches the policy engine produces an `engine.CheckHTTPRequest` span whose attributes record `authz.allowed`, the matched policy and the matched principal. Correlation with the Gateway trace requires trace context to be propagated to authz.",{"_3394":648,"_29710":484,"_20617":50360,"_5":14139,"_27008":49956,"_2880":50361},[],"Check that the bootstrap principal was created and that the policies were preloaded by the migration Job. Also verify that `services.authz.jwkUrl` is reachable from the `authz` pod; do not assume that a URL accessible from the browser also works inside the cluster.",{"_3394":649,"_29710":484,"_20617":50363,"_5":14139,"_27008":49960,"_2880":50364},[],"The path may be covered by a schema-level decision rather than by a policy: routes marked `skip_authz` allow any identity that matches an active principal, and a request under a `base_paths` prefix whose schema sets `default_action: allow` is likewise allowed without consulting policies. Confirm which of the two applies before looking for missing or misassigned grants.",{"_3394":650,"_29710":484,"_20617":50366,"_5":14139,"_27008":49964,"_2880":50367},[],"This is the expected behavior with `failOpen: false`. Restore the service, its PostgreSQL connection and its JWKS connectivity. Do not temporarily switch to `failOpen: true` without accepting that protected routes could become accessible without an authorization decision.",{"_3394":651,"_29710":484,"_20617":50369,"_5":14139,"_27008":49964,"_2880":50370},[],"Continue with Audit logs to investigate configuration changes or with Troubleshooting to diagnose the deployment.",{"_3394":652,"_29710":652,"_5":14491,"_2880":50372,"_30042":50373,"_20617":50374,"_27008":652},"Alerts and subscriptions",[48369,49837,49838],[],{"_3394":653,"_29710":652,"_20617":50376,"_5":14139,"_27008":652,"_2880":50377},[],"Send PKI events to people and external systems.",{"_3394":654,"_29710":652,"_5":30039,"_20617":50379,"_27008":50380,"_2880":50381},[],"/docs/platform/administration/alerts#how-it-works","How it works",{"_3394":655,"_29710":652,"_5":30039,"_20617":50383,"_27008":50384,"_2880":50385},[],"/docs/platform/administration/alerts#available-channels","Available channels",{"_3394":656,"_29710":652,"_5":30039,"_20617":50387,"_27008":50388,"_2880":50389},[],"/docs/platform/administration/alerts#create-a-subscription","Create a subscription",{"_3394":657,"_29710":652,"_5":30039,"_20617":50391,"_27008":50392,"_2880":50393},[],"/docs/platform/administration/alerts#choose-the-event","Choose the event",{"_3394":658,"_29710":652,"_5":30039,"_20617":50395,"_27008":50396,"_2880":50397},[],"/docs/platform/administration/alerts#configure-the-destination","Configure the destination",{"_3394":659,"_29710":652,"_5":30039,"_20617":50399,"_27008":50400,"_2880":50401},[],"/docs/platform/administration/alerts#limit-the-notifications","Limit the notifications",{"_3394":660,"_29710":652,"_5":30039,"_20617":50403,"_27008":50404,"_2880":50405},[],"/docs/platform/administration/alerts#review-and-activate","Review and activate",{"_3394":661,"_29710":652,"_5":30039,"_20617":50407,"_27008":50408,"_2880":50409},[],"/docs/platform/administration/alerts#configure-the-webhook-http-client","Configure the webhook HTTP client",{"_3394":662,"_29710":652,"_5":30039,"_20617":50411,"_27008":50412,"_2880":50413},[],"/docs/platform/administration/alerts#webhook-delivery-rules","Webhook delivery rules",{"_3394":663,"_29710":652,"_5":30039,"_20617":50415,"_27008":50416,"_2880":50417},[],"/docs/platform/administration/alerts#manage-a-subscription","Manage a subscription",{"_3394":664,"_29710":652,"_5":30039,"_20617":50419,"_27008":50420,"_2880":50421},[],"/docs/platform/administration/alerts#event-families","Event families",{"_3394":665,"_29710":652,"_20617":50423,"_5":14139,"_27008":652,"_2880":50424},[],"Subscriptions turn Lamassu events into actionable notifications. You can alert a team, feed an incident system or trigger an automation when a CA, certificate or device changes.",{"_3394":666,"_29710":652,"_20617":50426,"_5":14139,"_27008":50380,"_2880":50427},[],"A service publishes a domain event.",{"_3394":667,"_29710":652,"_20617":50429,"_5":14139,"_27008":50380,"_2880":50430},[],"Lamassu evaluates the subscriptions associated with that event type.",{"_3394":668,"_29710":652,"_20617":50432,"_5":14139,"_27008":50380,"_2880":50433},[],"Each subscription's filter decides whether it should be notified.",{"_3394":669,"_29710":652,"_20617":50435,"_5":14139,"_27008":50380,"_2880":50436},[],"Lamassu delivers the event to the configured channel.",{"_3394":670,"_29710":652,"_20617":50438,"_5":14139,"_27008":50380,"_2880":50439},[],"The event inventory shows when each type was last observed, how many times it has occurred and how many subscriptions it has. You can expand an event to inspect an example of its JSON payload before creating the filter.",{"_3394":671,"_29710":652,"_20617":50441,"_5":14139,"_27008":50384,"_2880":50442},[],"**Email** sends alerts to a person or an operational list. It only requires the destination address. Event content is rendered as HTML-escaped text, never as markup.",{"_3394":672,"_29710":652,"_20617":50444,"_5":14139,"_27008":50384,"_2880":50445},[],"**Microsoft Teams** posts the notification to a channel through its webhook URL.",{"_3394":673,"_29710":652,"_20617":50447,"_5":14139,"_27008":50384,"_2880":50448},[],"**Webhook** delivers the event to an automation, SIEM or incident system via `POST` or `PUT`.",{"_3394":674,"_29710":652,"_20617":50450,"_5":14139,"_27008":50384,"_2880":50451},[],"The Microsoft Teams and Webhook channels accept an optional `http_client` block that authenticates the call to the receiver. `auth_mode` selects `noauth` (the default), `apikey`, `jwt` or `mtls`; each mode requires its own options:",{"_3394":675,"_29710":652,"_20617":50453,"_5":14139,"_27008":50384,"_2880":50454},[],"`apikey_options` requires `header` and `key`.",{"_3394":676,"_29710":652,"_20617":50456,"_5":14139,"_27008":50384,"_2880":50457},[],"`jwt_options` requires `oidc_client_id`, `oidc_client_secret` and an absolute `http` or `https` `oidc_well_known`.",{"_3394":677,"_29710":652,"_20617":50459,"_5":14139,"_27008":50384,"_2880":50460},[],"`mtls_options` requires `cert_content` and `key_content` as Base64-encoded PEM, like certificates elsewhere in the API; plain PEM is also accepted. Values that reference files on the server are rejected, and the pair must decode to a matching certificate and private key.",{"_3394":678,"_29710":652,"_20617":50462,"_5":14139,"_27008":50384,"_2880":50463},[],"The alerts API reference documents the full `http_client` schema.",{"_3394":679,"_29710":652,"_20617":50465,"_5":14139,"_27008":50392,"_2880":50466},[],"Open **Alerts**, locate the event type and select **Subscribe**. Review the latest JSON example to identify the fields you will need to filter on.",{"_3394":680,"_29710":652,"_20617":50468,"_5":14139,"_27008":50396,"_2880":50469},[],"Select Email, Microsoft Teams or Webhook and enter the channel details.",{"_3394":681,"_29710":652,"_20617":50471,"_5":14139,"_27008":50400,"_2880":50472},[],"Add a filter if you don't want to receive every instance of the event.",{"_3394":682,"_29710":652,"_20617":50474,"_5":14139,"_27008":50400,"_2880":50475},[],"**None** notifies all instances of the event.",{"_3394":683,"_29710":652,"_20617":50477,"_5":14139,"_27008":50400,"_2880":50478},[],"**JSON Path** evaluates one or more specific fields.",{"_3394":684,"_29710":652,"_20617":50480,"_5":14139,"_27008":50400,"_2880":50481},[],"**JSON Schema** accepts only payloads with a particular structure.",{"_3394":685,"_29710":652,"_20617":50483,"_5":14139,"_27008":50400,"_2880":50484},[],"**JavaScript** lets you express custom logic. Each filter runs for at most 100 milliseconds; a filter that exceeds this limit fails the condition and the notification is skipped with the error `javascript filter execution timed out`.",{"_3394":686,"_29710":652,"_20617":50486,"_5":14139,"_27008":50400,"_2880":50487},[],"For example, `function (event) { return event.data.status == \"NO_IDENTITY\"; }` limits a subscription to devices without an identity.",{"_3394":687,"_29710":652,"_20617":50489,"_5":14139,"_27008":50400,"_2880":50490},[],"The console evaluates the filter against the JSON shown in the **Input Event** editor, which is prefilled with the latest event, and reports whether it matches. For JSON Path and JavaScript filters, it shows **The filter matches this Cloud Event** or **The filter does not match this Cloud Event**. JSON Path expressions are evaluated against the full Cloud Event, so the default `$.data` selects the event's `data` field, and the expression must start with `$`.",{"_3394":688,"_29710":652,"_20617":50492,"_5":14139,"_27008":50404,"_2880":50493},[],"Check the event, channel and filter in the summary. Select **Confirm Subscription** to start delivery.",{"_3394":689,"_29710":652,"_20617":50495,"_5":14139,"_27008":50408,"_2880":50496},[],"The Webhook and Microsoft Teams channels show this configuration in the subscribe form, at the channel step, and again when editing a subscription; Email does not use it. The fields map to the optional `http_client` block described above:",{"_3394":690,"_29710":652,"_20617":50498,"_5":14139,"_27008":50408,"_2880":50499},[],"**Log Level** selects `debug`, `info`, `warn` or `error`; `info` is the default.",{"_3394":691,"_29710":652,"_20617":50501,"_5":14139,"_27008":50408,"_2880":50502},[],"**Call Timeout** defaults to 10 seconds. The console rejects a value above 30 seconds with `Webhook timeout must be at most 30s.`; the API clamps the same value to the cap instead (see Calls are bounded).",{"_3394":692,"_29710":652,"_20617":50504,"_5":14139,"_27008":50408,"_2880":50505},[],"There is no TLS-verification switch for these channels, because the service always verifies the receiver certificate (see TLS is always verified).",{"_3394":693,"_29710":652,"_20617":50507,"_5":14139,"_27008":50408,"_2880":50508},[],"**HTTP Authentication** selects `No Authentication` (the default), `API Key` (API key value and Header Name, `X-API-Key` by default), `OIDC Client Credentials` (Client ID, Client Secret and Well-Known URL) or `Mutual TLS` (Client Certificate and Client Private Key pasted as PEM). A stored private key stays hidden until you select **Show**.",{"_3394":694,"_29710":652,"_20617":50510,"_5":14139,"_27008":50408,"_2880":50511},[],"A `http://` URL shows the console warning `Unencrypted HTTP connection` (see the Credentials over http\\:// callout below).",{"_3394":695,"_29710":652,"_20617":50513,"_5":14139,"_27008":50408,"_2880":50514},[],"The form validates inline against the same delivery rules: the webhook URL and the OIDC Well-Known URL must be absolute `http` or `https` URLs, an API-key header may not use a reserved name, and the mTLS certificate and key must be PEM content, not file paths.",{"_3394":696,"_29710":652,"_20617":50516,"_5":14139,"_27008":50408,"_2880":50517},[],"The summary in the Confirm step shows the authentication as `None`, `OIDC client credentials`, `API key` or `Mutual TLS`. The subscription details show the authentication, the API key header name (never the value), the OIDC issuer URL, mTLS as `Configured` and a fixed `TLS verification: Verified` row. The API key, client secret and private key are not shown in the subscription details.",{"_3394":697,"_29710":652,"_20617":50519,"_5":14139,"_27008":50412,"_2880":50520},[],"Notifications delivered through the Microsoft Teams and Webhook channels follow a fixed HTTP policy:",{"_3394":698,"_29710":652,"_20617":50522,"_5":14139,"_27008":50412,"_2880":50523},[],"**TLS is always verified.** The receiver certificate is checked against the system trust store. `insecure_skip_verify` is enforced as `false` — including when it is set to `true` — so self-signed or otherwise untrusted receivers fail delivery.",{"_3394":699,"_29710":652,"_20617":50525,"_5":14139,"_27008":50412,"_2880":50526},[],"**Redirects are not followed.** A `3xx` response fails with `unexpected status code: <n>: redirects are not followed`. Configure `webhook_url` with the final absolute `http` or `https` URL: an `http://` address that an ingress redirects to `https://` stops working.",{"_3394":700,"_29710":652,"_20617":50528,"_5":14139,"_27008":50412,"_2880":50529},[],"**Calls are bounded.** A call defaults to a 10 second timeout; a configured `call_timeout` is capped at 30 seconds. Values above the cap are clamped, not rejected.",{"_3394":701,"_29710":652,"_20617":50531,"_5":14139,"_27008":50412,"_2880":50532},[],"**The response body is ignored.** Delivery checks the status code only, so the receiver may answer with any body.",{"_3394":702,"_29710":652,"_20617":50534,"_5":14139,"_27008":50412,"_2880":50535},[],"**API-key headers are restricted.** A custom `apikey_options.header` may not use names that the platform or receiving services trust — for example `X-Principal-Id`, `X-Request-Id`, `Host`, `Content-Type` or `Forwarded` — and no name may start with `X-Forwarded-`, `X-Envoy-` or `X-Lms-`. Comparisons are case-insensitive.",{"_3394":703,"_29710":652,"_20617":50537,"_5":14139,"_27008":50412,"_2880":50538},[],"**Invalid configurations are rejected at subscribe time.** A channel configuration that would fail on every delivery returns HTTP 400 with a body that starts with `struct validation error:`, and the subscription is not created.",{"_3394":704,"_29710":652,"_20617":50540,"_5":14139,"_27008":50412,"_2880":50541},[],"Credentials are sent regardless of the URL scheme. With an `http://` `webhook_url`, the API key or bearer token travels in cleartext and mTLS has no effect. Prefer `https://` for `webhook_url`, `oidc_well_known` and the token endpoint it advertises.",{"_3394":705,"_29710":652,"_20617":50543,"_5":14139,"_27008":50416,"_2880":50544},[],"Open an existing subscription to review its destination and filter, modify the configuration or select **Unsubscribe**. Remove subscriptions that no longer have an operational owner to avoid ignored deliveries or stale endpoints.",{"_3394":706,"_29710":652,"_20617":50546,"_5":14139,"_27008":50416,"_2880":50547},[],"Subscriptions created with older console versions may store the webhook target under `url` and `method` instead of `webhook_url` and `webhook_method`. The service delivers only through `webhook_url` and `webhook_method`, so such a subscription does not deliver even though the subscription details show the stored target. Open the subscription and save it again: the edit form prefills the stored target, and saving rewrites the channel configuration in the current layout.",{"_3394":707,"_29710":652,"_20617":50549,"_5":14139,"_27008":50420,"_2880":50550},[],"**Authorities:** `ca.create`, `ca.import`, `ca.reissue` and `ca.delete`.",{"_3394":708,"_29710":652,"_20617":50552,"_5":14139,"_27008":50420,"_2880":50553},[],"**Certificates:** `ca.sign.certificate` and `certificate.delete`.",{"_3394":709,"_29710":652,"_20617":50555,"_5":14139,"_27008":50420,"_2880":50556},[],"**Profiles:** `profile.issuance.create`, `profile.issuance.update` and `profile.issuance.delete`.",{"_3394":710,"_29710":652,"_20617":50558,"_5":14139,"_27008":50420,"_2880":50559},[],"**Enrollment:** `dms.create`, `dms.update`, `dms.enroll` and `dms.reenroll`.",{"_3394":711,"_29710":652,"_20617":50561,"_5":14139,"_27008":50420,"_2880":50562},[],"**Devices:** `device.create`, `device.identity.update` and `device.status.update`.",{"_3394":712,"_29710":652,"_20617":50564,"_5":14139,"_27008":50420,"_2880":50565},[],"**Validation:** `va.role.crl.create`.",{"_3394":713,"_29710":652,"_20617":50567,"_5":14139,"_27008":50420,"_2880":50568},[],"**Keys:** `kms.create`, `kms.import`, `kms.sign` and `kms.delete`.",{"_3394":714,"_29710":652,"_20617":50570,"_5":14139,"_27008":50420,"_2880":50571},[],"Use the catalog shown in the console as the source for the types available in your deployed version.",{"_3394":715,"_29710":715,"_5":14491,"_2880":50573,"_30042":50574,"_20617":50575,"_27008":715},"Audit logs",[48369,49837,49838],[],{"_3394":716,"_29710":715,"_20617":50577,"_5":14139,"_27008":715,"_2880":50578},[],"Understand which audit events Lamassu generates and how to turn them into a durable trail.",{"_3394":717,"_29710":715,"_5":30039,"_20617":50580,"_27008":50581,"_2880":50582},[],"/docs/platform/administration/audit-logs#what-an-event-contains","What an event contains",{"_3394":718,"_29710":715,"_5":30039,"_20617":50584,"_27008":50585,"_2880":50586},[],"/docs/platform/administration/audit-logs#coverage","Coverage",{"_3394":719,"_29710":715,"_5":30039,"_20617":50588,"_27008":50589,"_2880":50590},[],"/docs/platform/administration/audit-logs#publication-and-persistence","Publication and persistence",{"_3394":720,"_29710":715,"_5":30039,"_20617":50592,"_27008":50593,"_2880":50594},[],"/docs/platform/administration/audit-logs#sensitive-data","Sensitive data",{"_3394":721,"_29710":715,"_5":30039,"_20617":50596,"_27008":50597,"_2880":50598},[],"/docs/platform/administration/audit-logs#a-reproducible-investigation","A reproducible investigation",{"_3394":722,"_29710":715,"_5":30039,"_20617":50600,"_27008":50601,"_2880":50602},[],"/docs/platform/administration/audit-logs#bound-the-interval","Bound the interval",{"_3394":723,"_29710":715,"_5":30039,"_20617":50604,"_27008":50605,"_2880":50606},[],"/docs/platform/administration/audit-logs#identify-the-operation","Identify the operation",{"_3394":724,"_29710":715,"_5":30039,"_20617":50608,"_27008":50609,"_2880":50610},[],"/docs/platform/administration/audit-logs#attribute-the-principal","Attribute the principal",{"_3394":725,"_29710":715,"_5":30039,"_20617":50612,"_27008":50613,"_2880":50614},[],"/docs/platform/administration/audit-logs#compare-intent-and-result","Compare intent and result",{"_3394":726,"_29710":715,"_5":30039,"_20617":50616,"_27008":50617,"_2880":50618},[],"/docs/platform/administration/audit-logs#follow-the-effect","Follow the effect",{"_3394":727,"_29710":715,"_5":30039,"_20617":50620,"_27008":50621,"_2880":50622},[],"/docs/platform/administration/audit-logs#periodic-verification","Periodic verification",{"_3394":728,"_29710":715,"_20617":50624,"_5":14139,"_27008":715,"_2880":50625},[],"Lamassu instruments the mutable operations of its services with audit events. Each event describes the operation, the principals that matched, the input, the result and whether it ended in error.",{"_3394":729,"_29710":715,"_20617":50627,"_5":14139,"_27008":50581,"_2880":50628},[],"The audit body includes:",{"_3394":730,"_29710":715,"_20617":50630,"_5":14139,"_27008":50581,"_2880":50631},[],"input: data received by the operation;",{"_3394":731,"_29710":715,"_20617":50633,"_5":14139,"_27008":50581,"_2880":50634},[],"has\\_error: whether the service returned an error;",{"_3394":732,"_29710":715,"_20617":50636,"_5":14139,"_27008":50581,"_2880":50637},[],"output: produced result or error message;",{"_3394":733,"_29710":715,"_20617":50639,"_5":14139,"_27008":50581,"_2880":50640},[],"principals: identifiers of the principals that matched the request.",{"_3394":734,"_29710":715,"_20617":50642,"_5":14139,"_27008":50581,"_2880":50643},[],"Successful operations use a type prefixed with audit.. Failures publish the operation type suffixed with .error. The CloudEvents event additionally adds source, identifier, date and type.",{"_3394":735,"_29710":715,"_20617":50645,"_5":14139,"_27008":50581,"_2880":50646},[],"The middlewares publish the record after executing the operation, whether it succeeded or returned an error. This lets you investigate attempts as well as confirmed changes.",{"_3394":736,"_29710":715,"_20617":50648,"_5":14139,"_27008":50585,"_2880":50649},[],"The backend applies auditing to mutations of:",{"_3394":737,"_29710":715,"_20617":50651,"_5":14139,"_27008":50585,"_2880":50652},[],"authorities, certificates and issuance profiles;",{"_3394":738,"_29710":715,"_20617":50654,"_5":14139,"_27008":50585,"_2880":50655},[],"keys and KMS engines;",{"_3394":739,"_29710":715,"_20617":50657,"_5":14139,"_27008":50585,"_2880":50658},[],"devices and identities;",{"_3394":740,"_29710":715,"_20617":50660,"_5":14139,"_27008":50585,"_2880":50661},[],"DMSs and enrollment operations;",{"_3394":741,"_29710":715,"_20617":50663,"_5":14139,"_27008":50585,"_2880":50664},[],"validation functions and CRL;",{"_3394":742,"_29710":715,"_20617":50666,"_5":14139,"_27008":50585,"_2880":50667},[],"principals, policies and authorization grants.",{"_3394":743,"_29710":715,"_20617":50669,"_5":14139,"_27008":50585,"_2880":50670},[],"Do not confuse these events with domain events. A domain event announces that a resource changed so another component can react; the audit event keeps input, output and principal context for investigation.",{"_3394":744,"_29710":715,"_20617":50672,"_5":14139,"_27008":50589,"_2880":50673},[],"Services publish audit records to the event bus when their PublisherEventBus is enabled. The backend code does not, by itself, implement a queryable, durable audit file.",{"_3394":745,"_29710":715,"_20617":50675,"_5":14139,"_27008":50589,"_2880":50676},[],"If you need retention, search, tamper protection or regulatory export, connect a consumer that persists the events into the system approved by your organization.",{"_3394":746,"_29710":715,"_20617":50678,"_5":14139,"_27008":50589,"_2880":50679},[],"Design the consumer to:",{"_3394":747,"_29710":715,"_20617":50681,"_5":14139,"_27008":50589,"_2880":50682},[],"subscribe to the audit.# types and also to operation types ending in .error;",{"_3394":748,"_29710":715,"_20617":50684,"_5":14139,"_27008":50589,"_2880":50685},[],"keep the complete CloudEvent unmodified;",{"_3394":749,"_29710":715,"_20617":50687,"_5":14139,"_27008":50589,"_2880":50688},[],"record the ingestion time and detect duplicates by ID;",{"_3394":750,"_29710":715,"_20617":50690,"_5":14139,"_27008":50589,"_2880":50691},[],"encrypt in transit and at rest;",{"_3394":751,"_29710":715,"_20617":50693,"_5":14139,"_27008":50589,"_2880":50694},[],"restrict reading and deletion to a role separate from the PKI operator;",{"_3394":752,"_29710":715,"_20617":50696,"_5":14139,"_27008":50589,"_2880":50697},[],"apply an explicit retention and legal hold policy;",{"_3394":753,"_29710":715,"_20617":50699,"_5":14139,"_27008":50589,"_2880":50700},[],"alert if it stops consuming or the pending queue grows.",{"_3394":754,"_29710":715,"_20617":50702,"_5":14139,"_27008":50593,"_2880":50703},[],"The input and output fields can contain subjects, metadata, public material, configuration or error messages. Evaluate their classification before sending them to an external platform.",{"_3394":755,"_29710":715,"_20617":50705,"_5":14139,"_27008":50593,"_2880":50706},[],"Do not log private keys, provider secrets or full tokens in automations around Lamassu. Restrict export and apply redaction at the destination without destroying the fields needed for attribution.",{"_3394":756,"_29710":715,"_20617":50708,"_5":14139,"_27008":50601,"_2880":50709},[],"Start from the reported time and normalize every source to UTC.",{"_3394":757,"_29710":715,"_20617":50711,"_5":14139,"_27008":50605,"_2880":50712},[],"Filter by event type, service source and resource identifier.",{"_3394":758,"_29710":715,"_20617":50714,"_5":14139,"_27008":50609,"_2880":50715},[],"Review principals and correlate them with the OIDC provider or the X.509 identity valid at that moment.",{"_3394":759,"_29710":715,"_20617":50717,"_5":14139,"_27008":50613,"_2880":50718},[],"Contrast input, has\\_error and output. A failed attempt does not mean the resource changed.",{"_3394":760,"_29710":715,"_20617":50720,"_5":14139,"_27008":50617,"_2880":50721},[],"Look for the domain events and service records that share resource and time window. In a CA revocation, include the cascading operations.",{"_3394":761,"_29710":715,"_20617":50723,"_5":14139,"_27008":50621,"_2880":50724},[],"Generate a controlled mutation in a test environment and check that:",{"_3394":762,"_29710":715,"_20617":50726,"_5":14139,"_27008":50621,"_2880":50727},[],"a successful audit event appears;",{"_3394":763,"_29710":715,"_20617":50729,"_5":14139,"_27008":50621,"_2880":50730},[],"the principal matches the identity used;",{"_3394":764,"_29710":715,"_20617":50732,"_5":14139,"_27008":50621,"_2880":50733},[],"the consumer persists it exactly once;",{"_3394":765,"_29710":715,"_20617":50735,"_5":14139,"_27008":50621,"_2880":50736},[],"it can be retrieved by resource, actor and period;",{"_3394":766,"_29710":715,"_20617":50738,"_5":14139,"_27008":50621,"_2880":50739},[],"a consumer outage raises an alert.",{"_3394":767,"_29710":715,"_20617":50741,"_5":14139,"_27008":50621,"_2880":50742},[],"For metrics, traces and technical logs of the deployment, see Troubleshooting. Audit answers \"who tried to change what\"; observability explains how the system behaved.",{"_3394":768,"_29710":768,"_5":14491,"_2880":50744,"_30042":50745,"_20617":50746,"_27008":768},"Platform architecture",[48369,49837],[],{"_3394":769,"_29710":768,"_20617":50748,"_5":14139,"_27008":768,"_2880":50749},[],"Lamassu components and how control, keys, issuance and devices relate.",{"_3394":770,"_29710":768,"_5":30039,"_20617":50751,"_27008":50752,"_2880":50753},[],"/docs/platform/concepts/architecture#control-plane","Control plane",{"_3394":771,"_29710":768,"_5":30039,"_20617":50755,"_27008":50756,"_2880":50757},[],"/docs/platform/concepts/architecture#key-custody-and-cryptographic-operations","Key custody and cryptographic operations",{"_3394":772,"_29710":768,"_5":30039,"_20617":50759,"_27008":50760,"_2880":50761},[],"/docs/platform/concepts/architecture#issuance-and-enrollment","Issuance and enrollment",{"_3394":773,"_29710":768,"_5":30039,"_20617":50763,"_27008":50764,"_2880":50765},[],"/docs/platform/concepts/architecture#status-and-validation","Status and validation",{"_3394":774,"_29710":768,"_5":30039,"_20617":50767,"_27008":50768,"_2880":50769},[],"/docs/platform/concepts/architecture#platform-dependencies","Platform dependencies",{"_3394":775,"_29710":768,"_20617":50771,"_5":14139,"_27008":768,"_2880":50772},[],"Lamassu deploys as a set of independent services. This separation keeps every component from needing direct access to private keys and lets each capability scale according to load.",{"_3394":776,"_29710":768,"_20617":50774,"_5":14139,"_27008":768,"_2880":50775},[],"Switch to the low level to see the internals of the Lamassu platform box (CA, KMS, DMS, Device Manager, VA, Alerts, AWS IoT connector, Job Manager and the console/API), and to medium to see it as a single platform alongside its external dependencies.",{"_3394":777,"_29710":768,"_20617":50777,"_5":14139,"_27008":50752,"_2880":50778},[],"The console and the APIs manage authorities, certificates, DMSs, devices, alerts and configuration. Domain events allow connectors and automations to react to changes without continuously polling the platform.",{"_3394":778,"_29710":768,"_20617":50780,"_5":14139,"_27008":50756,"_2880":50781},[],"The KMS offers a common interface over software engines, PKCS#11 and cloud providers. The selected engine keeps the key or delegates the cryptographic operation without the other services knowing its implementation.",{"_3394":779,"_29710":768,"_20617":50783,"_5":14139,"_27008":50760,"_2880":50784},[],"The CA service issues certificates and maintains the relationship with its authority. The DMS applies the enrollment rules and exposes the EST flows so a device can request or renew an identity.",{"_3394":780,"_29710":768,"_20617":50786,"_5":14139,"_27008":50764,"_2880":50787},[],"Device Manager keeps the operational view of the device and its history. The Validation Authority publishes OCSP and CRLs so other systems can decide whether to trust a presented certificate.",{"_3394":781,"_29710":768,"_20617":50789,"_5":14139,"_27008":50768,"_2880":50790},[],"In a self-managed deployment, Lamassu uses PostgreSQL for persistence, RabbitMQ for messaging and an OIDC provider for authentication. See the deployment architecture for how the services are published on Kubernetes.",{"_3394":782,"_29710":782,"_5":14491,"_2880":50792,"_30042":50793,"_20617":50794,"_27008":782},"How Lamassu works",[48369,49837],[],{"_3394":783,"_29710":782,"_20617":50796,"_5":14139,"_27008":782,"_2880":50797},[],"The mental model of trust, keys, certificates and devices.",{"_3394":784,"_29710":782,"_5":30039,"_20617":50799,"_27008":50800,"_2880":50801},[],"/docs/platform/concepts/overview#the-model-in-five-pieces","The model in five pieces",{"_3394":785,"_29710":782,"_5":30039,"_20617":50803,"_27008":50804,"_2880":50805},[],"/docs/platform/concepts/overview#from-onboarding-to-operation","From onboarding to operation",{"_3394":786,"_29710":782,"_20617":50807,"_5":14139,"_27008":782,"_2880":50808},[],"Lamassu connects three elements: a **root of trust**, an **issuance policy** and an **entity that needs to prove its identity**. The platform coordinates these elements throughout the certificate lifecycle.",{"_3394":787,"_29710":782,"_20617":50810,"_5":14139,"_27008":50800,"_2880":50811},[],"**Cryptographic engine.** Generates or safeguards keys and executes private-key operations without exposing key material to the rest of the services.",{"_3394":788,"_29710":782,"_20617":50813,"_5":14139,"_27008":50800,"_2880":50814},[],"**Certification Authority (CA).** Signs certificates and establishes the chain of trust.",{"_3394":789,"_29710":782,"_20617":50816,"_5":14139,"_27008":50800,"_2880":50817},[],"**Device Management Service (DMS).** Defines how the devices of a fleet are registered, authenticated and renewed.",{"_3394":790,"_29710":782,"_20617":50819,"_5":14139,"_27008":50800,"_2880":50820},[],"**Device.** Keeps its private key and presents the certificate to prove its identity.",{"_3394":791,"_29710":782,"_20617":50822,"_5":14139,"_27008":50800,"_2880":50823},[],"**Validation Authority (VA).** Publishes the status of certificates through OCSP and CRL.",{"_3394":792,"_29710":782,"_20617":50825,"_5":14139,"_27008":50804,"_2880":50826},[],"An administrator configures a cryptographic engine and creates or imports a CA.",{"_3394":793,"_29710":782,"_20617":50828,"_5":14139,"_27008":50804,"_2880":50829},[],"A DMS relates that CA to an enrollment policy.",{"_3394":794,"_29710":782,"_20617":50831,"_5":14139,"_27008":50804,"_2880":50832},[],"The device generates a key and requests a certificate through EST, or an operator assigns it an identity.",{"_3394":795,"_29710":782,"_20617":50834,"_5":14139,"_27008":50804,"_2880":50835},[],"Lamassu keeps the inventory, history and status of the identity.",{"_3394":796,"_29710":782,"_20617":50837,"_5":14139,"_27008":50804,"_2880":50838},[],"Consumers check the chain and query OCSP or a CRL when they need to know whether it is still valid.",{"_3394":797,"_29710":782,"_20617":50840,"_5":14139,"_27008":50804,"_2880":50841},[],"<Card title=\"Architecture\" description=\"Get to know the components and where each one's responsibility ends.\" href=\"/docs/platform/concepts/architecture\" />",{"_3394":798,"_29710":782,"_20617":50843,"_5":14139,"_27008":50804,"_2880":50844},[],"<Card title=\"Identity lifecycle\" description=\"Follow a certificate from enrollment to renewal or revocation.\" href=\"/docs/platform/pki/concepts/certificate-lifecycle\" />",{"_3394":799,"_29710":799,"_5":14491,"_2880":50846,"_30042":50847,"_20617":50849,"_27008":799},"Devices and identities",[48369,49837,50848,50846],"IoT Fleets",[],{"_3394":800,"_29710":799,"_20617":50851,"_5":14139,"_27008":799,"_2880":50852},[],"Register, inspect and retire devices while checking their current identity and history.",{"_3394":801,"_29710":799,"_5":30039,"_20617":50854,"_27008":50855,"_2880":50856},[],"/docs/platform/iot-fleets/device-management#device-states","Device states",{"_3394":802,"_29710":799,"_5":30039,"_20617":50858,"_27008":50859,"_2880":50860},[],"/docs/platform/iot-fleets/device-management#inspect-a-device","Inspect a device",{"_3394":803,"_29710":799,"_5":30039,"_20617":50862,"_27008":50863,"_2880":50864},[],"/docs/platform/iot-fleets/device-management#register-a-device-manually","Register a device manually",{"_3394":804,"_29710":799,"_5":30039,"_20617":50866,"_27008":50867,"_2880":50868},[],"/docs/platform/iot-fleets/device-management#create-the-device","Create the device",{"_3394":805,"_29710":799,"_5":30039,"_20617":50870,"_27008":50871,"_2880":50872},[],"/docs/platform/iot-fleets/device-management#define-its-membership","Define its membership",{"_3394":806,"_29710":799,"_5":30039,"_20617":50874,"_27008":50875,"_2880":50876},[],"/docs/platform/iot-fleets/device-management#classify-the-device","Classify the device",{"_3394":807,"_29710":799,"_5":30039,"_20617":50878,"_27008":50879,"_2880":50880},[],"/docs/platform/iot-fleets/device-management#verify-the-registration","Verify the registration",{"_3394":808,"_29710":799,"_5":30039,"_20617":50882,"_27008":50883,"_2880":50884},[],"/docs/platform/iot-fleets/device-management#assign-an-identity-manually","Assign an identity manually",{"_3394":809,"_29710":799,"_5":30039,"_20617":50886,"_27008":50887,"_2880":50888},[],"/docs/platform/iot-fleets/device-management#revoke-the-current-identity","Revoke the current identity",{"_3394":810,"_29710":799,"_5":30039,"_20617":50890,"_27008":50891,"_2880":50892},[],"/docs/platform/iot-fleets/device-management#decommission-a-device","Decommission a device",{"_3394":811,"_29710":799,"_5":30039,"_20617":50894,"_27008":50895,"_2880":50896},[],"/docs/platform/iot-fleets/device-management#automate-enrollment","Automate enrollment",{"_3394":812,"_29710":799,"_20617":50898,"_5":14139,"_27008":799,"_2880":50899},[],"This guide is for a fleet operator. You need device, DMS and certificate permissions for the intended actions. A fleet is organized through these resources, tags and metadata; there is no separate “fleet” object to create.",{"_3394":813,"_29710":799,"_20617":50901,"_5":14139,"_27008":799,"_2880":50902},[],"Each device has a `Device ID`, one owning DMS (`dms_owner`) and, once provisioned, an identity slot with an active version and previous versions. In these flows, keep the CSR and certificate `Common Name` equal to `Device ID`: binding uses that CN to update the device.",{"_3394":814,"_29710":799,"_20617":50904,"_5":14139,"_27008":50855,"_2880":50905},[],"Operational view",{"_3394":815,"_29710":799,"_20617":50907,"_5":14139,"_27008":50855,"_2880":50908},[],"Meaning",{"_3394":816,"_29710":799,"_20617":50910,"_5":14139,"_27008":50855,"_2880":50911},[],"**No Identity**",{"_3394":817,"_29710":799,"_20617":50913,"_5":14139,"_27008":50855,"_2880":50914},[],"A record exists without an associated identity.",{"_3394":818,"_29710":799,"_20617":50916,"_5":14139,"_27008":50855,"_2880":50917},[],"**Active**",{"_3394":819,"_29710":799,"_20617":50919,"_5":14139,"_27008":50855,"_2880":50920},[],"The slot is active; also check certificate dates, status and usages.",{"_3394":820,"_29710":799,"_20617":50922,"_5":14139,"_27008":50855,"_2880":50923},[],"**Renewal Pending**",{"_3394":821,"_29710":799,"_20617":50925,"_5":14139,"_27008":50855,"_2880":50926},[],"The identity is in the operational renewal window.",{"_3394":822,"_29710":799,"_20617":50928,"_5":14139,"_27008":50855,"_2880":50929},[],"**Expiring Soon**",{"_3394":823,"_29710":799,"_20617":50931,"_5":14139,"_27008":50855,"_2880":50932},[],"Expiration is approaching according to configured thresholds.",{"_3394":824,"_29710":799,"_20617":50934,"_5":14139,"_27008":50855,"_2880":50935},[],"**Expired**",{"_3394":825,"_29710":799,"_20617":50937,"_5":14139,"_27008":50855,"_2880":50938},[],"The identity has expired.",{"_3394":826,"_29710":799,"_20617":50940,"_5":14139,"_27008":50855,"_2880":50941},[],"**Revoked**",{"_3394":827,"_29710":799,"_20617":50943,"_5":14139,"_27008":50855,"_2880":50944},[],"The identity is marked revoked.",{"_3394":828,"_29710":799,"_20617":50946,"_5":14139,"_27008":50855,"_2880":50947},[],"**Decommissioned**",{"_3394":829,"_29710":799,"_20617":50949,"_5":14139,"_27008":50855,"_2880":50950},[],"The record is retired and ordinary updates do not restore operation.",{"_3394":830,"_29710":799,"_20617":50952,"_5":14139,"_27008":50855,"_2880":50953},[],"Device, slot and certificate states are distinct. Events and jobs can update the view after saving a certificate; an **Active** label does not establish consumer acceptance.",{"_3394":831,"_29710":799,"_20617":50955,"_5":14139,"_27008":50859,"_2880":50956},[],"Filter the inventory by ID, tags and status. Open details and record the owning DMS, active version and current certificate serial.",{"_3394":832,"_29710":799,"_20617":50958,"_5":14139,"_27008":50859,"_2880":50959},[],"**Certificate History** relates previous and current versions. Replacing the slot does not by itself revoke every previous version.",{"_3394":833,"_29710":799,"_20617":50961,"_5":14139,"_27008":50859,"_2880":50962},[],"**Device Event Timeline** helps reconstruct registration, provisioning, renewal and status changes. A change may be saved even if event persistence fails; also inspect the record and certificates.",{"_3394":834,"_29710":799,"_20617":50964,"_5":14139,"_27008":50859,"_2880":50965},[],"Compare these values with the identity installed on the device. Updating a Lamassu slot does not install files on the remote equipment.",{"_3394":835,"_29710":799,"_20617":50967,"_5":14139,"_27008":50863,"_2880":50968},[],"Use this flow to prepare inventory or assign an identity through the console. You need an existing DMS.",{"_3394":836,"_29710":799,"_20617":50970,"_5":14139,"_27008":50867,"_2880":50971},[],"Open registration in **Managed Devices**. Confirm the ID does not already exist in another DMS: ID lookup is not restricted to a fleet.",{"_3394":837,"_29710":799,"_20617":50973,"_5":14139,"_27008":50871,"_2880":50974},[],"Enter **Device ID** and select its owning DMS. The console’s **Registration Authority** label refers to that DMS.",{"_3394":838,"_29710":799,"_20617":50976,"_5":14139,"_27008":50875,"_2880":50977},[],"Add model, environment or location tags and an icon according to your inventory.",{"_3394":839,"_29710":799,"_20617":50979,"_5":14139,"_27008":50879,"_2880":50980},[],"Read the device again: require the intended DMS and **No Identity**. Follow Manual registration to complete assignment.",{"_3394":840,"_29710":799,"_20617":50982,"_5":14139,"_27008":50879,"_2880":50983},[],"Preregistration does not establish that `/simpleenroll` will admit the request. Review its interaction with `enable_replaceable_enrollment` in Provisioning strategies.",{"_3394":841,"_29710":799,"_20617":50985,"_5":14139,"_27008":50883,"_2880":50986},[],"From **No Identity**, use **Assign Identity**:",{"_3394":842,"_29710":799,"_20617":50988,"_5":14139,"_27008":50883,"_2880":50989},[],"Select an active, current certificate suitable for the consumer, with `CN` exactly equal to `Device ID`.",{"_3394":843,"_29710":799,"_20617":50991,"_5":14139,"_27008":50883,"_2880":50992},[],"If unavailable, **Issue New Instead** starts issuance using the intended CA. Review the profile first.",{"_3394":844,"_29710":799,"_20617":50994,"_5":14139,"_27008":50883,"_2880":50995},[],"Confirm and read the serial, active version and history again.",{"_3394":845,"_29710":799,"_20617":50997,"_5":14139,"_27008":50883,"_2880":50998},[],"Install the key/certificate pair and required intermediates on the device and test usage.",{"_3394":846,"_29710":799,"_20617":51000,"_5":14139,"_27008":50883,"_2880":51001},[],"Issuing, binding and installing are separate steps. If an operation fails, check which steps persisted before repeating it.",{"_3394":847,"_29710":799,"_20617":51003,"_5":14139,"_27008":50887,"_2880":51004},[],"Locate the active serial in history and revoke it with an appropriate reason. Verify the record, OCSP/CRL publication and rejection of a new consumer connection using the certificate guide.",{"_3394":848,"_29710":799,"_20617":51006,"_5":14139,"_27008":50887,"_2880":51007},[],"Revocation does not remove the device. It does not automatically enable another enrollment either: recovery depends on its credential, status and DMS policy. `CertificateHold` can be reactivated under PKI conditions; other reasons block subsequent certificate changes.",{"_3394":849,"_29710":799,"_20617":51009,"_5":14139,"_27008":50891,"_2880":51010},[],"Before **Decommission**, inventory active and previous identities, connections and destination permissions. Prepare retirement in the consumer.",{"_3394":850,"_29710":799,"_20617":51012,"_5":14139,"_27008":50891,"_2880":51013},[],"The backend saves **Decommissioned** and attempts to revoke the active version’s certificate with `CessationOfOperation` if the slot was not expired or revoked. It does not traverse all history. Deferred revocation can fail after retirement is saved; check the result by serial.",{"_3394":851,"_29710":799,"_20617":51015,"_5":14139,"_27008":50891,"_2880":51016},[],"Retired status protects ordinary device and slot updates. It does not guarantee that every EST request is rejected before issuance: binding can skip a retired device without returning an error. Check for remaining usable certificates or permissions and block new admission in the relevant control.",{"_3394":852,"_29710":799,"_20617":51018,"_5":14139,"_27008":50891,"_2880":51019},[],"Retain records according to audit policy. Do not reuse a retired ID to hide an equipment change.",{"_3394":853,"_29710":799,"_20617":51021,"_5":14139,"_27008":50895,"_2880":51022},[],"<Card title=\"Enroll and connect a device\" description=\"Obtain an identity from the client and test mTLS.\" href=\"/docs/platform/iot-fleets/quickstarts/enroll-device\" />",{"_3394":854,"_29710":799,"_20617":51024,"_5":14139,"_27008":50895,"_2880":51025},[],"<Card title=\"Renewal and recovery\" description=\"Install the successor and handle failures without losing known state.\" href=\"/docs/platform/iot-fleets/enrollment/renewal-and-recovery\" />",{"_3394":855,"_29710":855,"_5":14491,"_2880":51027,"_30042":51028,"_20617":51030,"_27008":855},"Bootstrap identity and authentication",[48369,49837,50848,50846,51029],"Enrollment with PKI",[],{"_3394":856,"_29710":855,"_20617":51032,"_5":14139,"_27008":855,"_2880":51033},[],"Prepare server trust and admission proofs for enroll and reenroll.",{"_3394":857,"_29710":855,"_5":30039,"_20617":51035,"_27008":51036,"_2880":51037},[],"/docs/platform/iot-fleets/enrollment/bootstrap-identity#initial-server-trust","Initial server trust",{"_3394":858,"_29710":855,"_5":30039,"_20617":51039,"_27008":51040,"_2880":51041},[],"/docs/platform/iot-fleets/enrollment/bootstrap-identity#bootstrap-credential","Bootstrap credential",{"_3394":859,"_29710":855,"_5":30039,"_20617":51043,"_27008":51044,"_2880":51045},[],"/docs/platform/iot-fleets/enrollment/bootstrap-identity#modes-per-operation","Modes per operation",{"_3394":860,"_29710":855,"_5":30039,"_20617":51047,"_27008":51048,"_2880":51049},[],"/docs/platform/iot-fleets/enrollment/bootstrap-identity#webhook-contract","Webhook contract",{"_3394":861,"_29710":855,"_5":30039,"_20617":51051,"_27008":51052,"_2880":51053},[],"/docs/platform/iot-fleets/enrollment/bootstrap-identity#revocation-and-checks","Revocation and checks",{"_3394":862,"_29710":855,"_20617":51055,"_5":14139,"_27008":855,"_2880":51056},[],"This guide connects the DMS administrator with device manufacturing and integration. Before requesting an operational identity, the client must authenticate the EST server and establish entitlement to request the intended ID.",{"_3394":863,"_29710":855,"_20617":51058,"_5":14139,"_27008":51036,"_2880":51059},[],"Install a previously verified root, chain or pin through a trusted channel: manufacturing, approved configuration or authenticated distribution. It enables TLS and server-name verification before downloading `/cacerts`.",{"_3394":864,"_29710":855,"_20617":51061,"_5":14139,"_27008":51036,"_2880":51062},[],"Your only trust proof cannot come from the same unauthenticated server. The EST server TLS certificate, bootstrap certificate and operational identity issuer may belong to different hierarchies.",{"_3394":865,"_29710":855,"_20617":51064,"_5":14139,"_27008":51040,"_2880":51065},[],"With `CLIENT_CERTIFICATE`, the device presents its initial certificate and proves key possession through TLS. The DMS validates it against admission CAs. In the inspected flow, the validator receives one leaf credential: configure and test the direct issuer for the simple case; sending more intermediates does not establish delivery to the service.",{"_3394":866,"_29710":855,"_20617":51067,"_5":14139,"_27008":51040,"_2880":51068},[],"Check dates, matching certificate/key and revocation before provisioning. A credential shared across equipment identifies that shared credential, not an individual device.",{"_3394":867,"_29710":855,"_20617":51070,"_5":14139,"_27008":51040,"_2880":51071},[],"Initial mTLS validation does not by itself compare bootstrap CN with the requested CSR CN. If a requester should only request its own `Device ID`, add a control binding credential to ID, such as the combined webhook, and test a request with another CN. Certificate re-enrollment does compare its CN to the CSR; subsequent checks use the registered active identity.",{"_3394":868,"_29710":855,"_20617":51073,"_5":14139,"_27008":51044,"_2880":51074},[],"Select the four modes independently for enrollment and re-enrollment in DMS. Renewal credentials depend on that block; do not assume the bootstrap is always used or the webhook disappears.",{"_3394":869,"_29710":855,"_20617":51076,"_5":14139,"_27008":51044,"_2880":51077},[],"An administrative OIDC token is not a native EST mode. A webhook may interpret an agreed credential header; that service then performs authorization. In NO\\_AUTH, sending a token does not add DMS authentication.",{"_3394":870,"_29710":855,"_20617":51079,"_5":14139,"_27008":51048,"_2880":51080},[],"The DMS sends operation context to the configured service. Method comes from configuration; agree the contract before selecting POST or PUT. Authorization wait defaults to 10 seconds, replaced by a configured positive timeout. The DMS verifies the receiver certificate unless `insecure_skip_verify` is enabled in the webhook config — verification is on by default — and does not follow redirects, so the configured URL must be the final one. The authorization response must be JSON of at most 1 MiB. With Lamassu-to-webhook authentication configured over `http://`, the API key or bearer token travels in cleartext, and mTLS has no effect because no TLS handshake takes place, so the client certificate is never presented; prefer `https://`. Configure those options in the webhook settings of the DMS guide.",{"_3394":871,"_29710":855,"_20617":51082,"_5":14139,"_27008":51048,"_2880":51083},[],"Example body:",{"_3394":872,"_29710":855,"_20617":51085,"_5":14139,"_27008":51048,"_2880":51086},[],"`csr` is **base64 of PEM**, unlike the EST body, which is base64 of DER. `http_request` contains URL and first header entries from available HTTP context. This body does not include an `operation` field; distinguish enroll and reenroll through the path and configured policy.",{"_3394":873,"_29710":855,"_20617":51088,"_5":14139,"_27008":51048,"_2880":51089},[],"The webhook should verify credential, its relationship to `device_cn`, DMS, operation and admission policy. Forwarded headers are not themselves trusted evidence. **Lamassu-to-webhook authentication** is a separate relationship configured in the server’s HTTP client.",{"_3394":874,"_29710":855,"_20617":51091,"_5":14139,"_27008":51048,"_2880":51092},[],"Continuation requires a successful HTTP response and JSON:",{"_3394":875,"_29710":855,"_20617":51094,"_5":14139,"_27008":51048,"_2880":51095},[],"A bodyless `204` does not satisfy the contract. Denial, transport error, uninterpretable response or timeout abort authorization. Combined mode validates the certificate first, then queries the webhook. See the webhook specification.",{"_3394":876,"_29710":855,"_20617":51097,"_5":14139,"_27008":51052,"_2880":51098},[],"The DMS first looks up the certificate in Lamassu; for external certificates it attempts OCSP and CRL. If revocation cannot be checked, validators can continue treating it as not revoked. The code also does not establish rejection of every external status other than Good. Test required behavior with your actual credential and endpoint; do not present this as guaranteed strict enforcement across every source.",{"_3394":877,"_29710":855,"_20617":51100,"_5":14139,"_27008":51052,"_2880":51101},[],"Test an allowed certificate, an incorrect one, another CN, webhook denial, timeout and re-enrollment under its own policy. Keep results and schedule bootstrap credential retirement where appropriate. Continue with EST client.",{"_3394":878,"_29710":878,"_5":14491,"_2880":51103,"_30042":51104,"_20617":51105,"_27008":878},"Configure and operate the DMS",[48369,49837,50848,50846,51029],[],{"_3394":879,"_29710":878,"_20617":51107,"_5":14139,"_27008":878,"_2880":51108},[],"Define registration, authentication per operation, issuance, renewal and distributed trust.",{"_3394":880,"_29710":878,"_5":30039,"_20617":51110,"_27008":51111,"_2880":48379},[],"/docs/platform/iot-fleets/enrollment/dms#before-you-begin",{"_3394":881,"_29710":878,"_5":30039,"_20617":51113,"_27008":51114,"_2880":51115},[],"/docs/platform/iot-fleets/enrollment/dms#configure-a-dms","Configure a DMS",{"_3394":882,"_29710":878,"_5":30039,"_20617":51117,"_27008":51118,"_2880":51119},[],"/docs/platform/iot-fleets/enrollment/dms#identify-the-fleet","Identify the fleet",{"_3394":883,"_29710":878,"_5":30039,"_20617":51121,"_27008":51122,"_2880":51123},[],"/docs/platform/iot-fleets/enrollment/dms#select-the-enrollment-ca","Select the enrollment CA",{"_3394":884,"_29710":878,"_5":30039,"_20617":51125,"_27008":51126,"_2880":51127},[],"/docs/platform/iot-fleets/enrollment/dms#configure-est","Configure EST",{"_3394":885,"_29710":878,"_5":30039,"_20617":51129,"_27008":51130,"_2880":51131},[],"/docs/platform/iot-fleets/enrollment/dms#distribute-trust","Distribute trust",{"_3394":886,"_29710":878,"_5":30039,"_20617":51133,"_27008":51134,"_2880":51135},[],"/docs/platform/iot-fleets/enrollment/dms#verify-the-endpoints","Verify the endpoints",{"_3394":887,"_29710":878,"_5":30039,"_20617":51137,"_27008":51138,"_2880":51139},[],"/docs/platform/iot-fleets/enrollment/dms#enrollment-configuration","Enrollment configuration",{"_3394":888,"_29710":878,"_5":30039,"_20617":51141,"_27008":51142,"_2880":51143},[],"/docs/platform/iot-fleets/enrollment/dms#enrollment-device-registration","Enrollment Device Registration",{"_3394":889,"_29710":878,"_5":30039,"_20617":51145,"_27008":51146,"_2880":51147},[],"/docs/platform/iot-fleets/enrollment/dms#enrollment-settings","Enrollment Settings",{"_3394":890,"_29710":878,"_5":30039,"_20617":51149,"_27008":51150,"_2880":51151},[],"/docs/platform/iot-fleets/enrollment/dms#authentication-per-operation","Authentication per operation",{"_3394":891,"_29710":878,"_5":30039,"_20617":51153,"_27008":51154,"_2880":51155},[],"/docs/platform/iot-fleets/enrollment/dms#external-webhook-settings","External webhook settings",{"_3394":892,"_29710":878,"_5":30039,"_20617":51157,"_27008":51158,"_2880":51159},[],"/docs/platform/iot-fleets/enrollment/dms#issuance-profile","Issuance profile",{"_3394":893,"_29710":878,"_5":30039,"_20617":51161,"_27008":51162,"_2880":51163},[],"/docs/platform/iot-fleets/enrollment/dms#re-enrollment-configuration","Re-enrollment configuration",{"_3394":894,"_29710":878,"_5":30039,"_20617":51165,"_27008":51166,"_2880":51167},[],"/docs/platform/iot-fleets/enrollment/dms#serverkeygen","ServerKeyGen",{"_3394":895,"_29710":878,"_5":30039,"_20617":51169,"_27008":51170,"_2880":51171},[],"/docs/platform/iot-fleets/enrollment/dms#trust-distribution","Trust distribution",{"_3394":896,"_29710":878,"_5":30039,"_20617":51173,"_27008":51174,"_2880":51175},[],"/docs/platform/iot-fleets/enrollment/dms#operate-the-dms-inventory","Operate the DMS inventory",{"_3394":897,"_29710":878,"_5":30039,"_20617":51177,"_27008":51178,"_2880":51179},[],"/docs/platform/iot-fleets/enrollment/dms#integrate-the-devices","Integrate the devices",{"_3394":898,"_29710":878,"_20617":51181,"_5":14139,"_27008":878,"_2880":51182},[],"A &#x2A;*Device Management Service (DMS)** configures admission and identity lifecycle for its devices. It acts as a registration authority; the CA selected in `Enrollment CA` signs certificates. This guide is for the policy administrator.",{"_3394":899,"_29710":878,"_20617":51184,"_5":14139,"_27008":51111,"_2880":51185},[],"You need DMS management permissions, an active CA with a usable key and a tested issuance profile. Agree device ID, initial credential, consumer and renewal window with the integrator. Review Provisioning strategies before choosing registration and replacement.",{"_3394":900,"_29710":878,"_20617":51187,"_5":14139,"_27008":51111,"_2880":51188},[],"Prepare EST server trust and device connectivity through Deployment. Your operator’s administrative authentication does not replace device EST authentication.",{"_3394":901,"_29710":878,"_20617":51190,"_5":14139,"_27008":51118,"_2880":51191},[],"Create the DMS with a recognizable name and retain its ID. EST URLs use this identifier, not the display name. Each device retains one owning DMS.",{"_3394":902,"_29710":878,"_20617":51193,"_5":14139,"_27008":51122,"_2880":51194},[],"Choose **Enrollment CA** and an explicit profile appropriate for the end-entity identity. Keep CN compatible with `Device ID`. The test certificate should allow its intended purpose and expire within issuer validity.",{"_3394":903,"_29710":878,"_20617":51196,"_5":14139,"_27008":51126,"_2880":51197},[],"Select initial enrollment registration and authentication. Separately configure re-enrollment authentication, thresholds and previous certificate retirement. Leave ServerKeyGen disabled if the client generates its key.",{"_3394":904,"_29710":878,"_20617":51199,"_5":14139,"_27008":51130,"_2880":51200},[],"Select certificates returned by `/cacerts`. Explicitly include required intermediates and roots, keeping distribution distinct from automatic trust installation.",{"_3394":905,"_29710":878,"_20617":51202,"_5":14139,"_27008":51134,"_2880":51203},[],"Save and read configuration again. Query `/cacerts`, perform an allowed and a rejected enrollment, and inspect device, serial and history. Creating the DMS or downloading cacerts does not establish working authentication and issuance.",{"_3394":906,"_29710":878,"_20617":51205,"_5":14139,"_27008":51142,"_2880":51206},[],"`settings.enrollment_settings.registration_mode` accepts `JITP` or `PRE_REGISTRATION`. JITP creates an unknown device with the CSR CN as ID and the DMS as owner. `device_provisioning_profile` supplies tags, metadata and icon for that registration.",{"_3394":907,"_29710":878,"_20617":51208,"_5":14139,"_27008":51142,"_2880":51209},[],"PRE\\_REGISTRATION requires an existing ID. In the inspected code, an existing device encounters replacement checks first, even without an identity. Review preregistration conditions before using this mode.",{"_3394":908,"_29710":878,"_20617":51211,"_5":14139,"_27008":51146,"_2880":51212},[],"`settings.enrollment_settings` field",{"_3394":909,"_29710":878,"_20617":51214,"_5":14139,"_27008":51146,"_2880":51215},[],"Decision",{"_3394":910,"_29710":878,"_20617":51217,"_5":14139,"_27008":51146,"_2880":51218},[],"`protocol`",{"_3394":911,"_29710":878,"_20617":51220,"_5":14139,"_27008":51146,"_2880":51221},[],"`EST_RFC7030` for these operations.",{"_3394":912,"_29710":878,"_20617":51223,"_5":14139,"_27008":51146,"_2880":51224},[],"`enrollment_ca`",{"_3394":913,"_29710":878,"_20617":51226,"_5":14139,"_27008":51146,"_2880":51227},[],"ID of the signing CA.",{"_3394":914,"_29710":878,"_20617":51229,"_5":14139,"_27008":51146,"_2880":51230},[],"`verify_csr_signature`",{"_3394":915,"_29710":878,"_20617":51232,"_5":14139,"_27008":51146,"_2880":51233},[],"Keep `true` to verify CSR key possession.",{"_3394":916,"_29710":878,"_20617":51235,"_5":14139,"_27008":51146,"_2880":51236},[],"`enable_replaceable_enrollment`",{"_3394":917,"_29710":878,"_20617":51238,"_5":14139,"_27008":51146,"_2880":51239},[],"Allows `/simpleenroll` for an existing ID in the same DMS. It can attempt previous certificate revocation even if a later phase fails; this is not atomic.",{"_3394":918,"_29710":878,"_20617":51241,"_5":14139,"_27008":51146,"_2880":51242},[],"`est_rfc7030_settings.auth_mode`",{"_3394":919,"_29710":878,"_20617":51244,"_5":14139,"_27008":51146,"_2880":51245},[],"One of the four authentication modes.",{"_3394":920,"_29710":878,"_20617":51247,"_5":14139,"_27008":51146,"_2880":51248},[],"Initial enrollment rejects an ID owned by another DMS. Do not automatically enable replacement in response to an error; Troubleshooting distinguishes repeated IDs, ownership and partial changes.",{"_3394":921,"_29710":878,"_20617":51250,"_5":14139,"_27008":51150,"_2880":51251},[],"The blocks are independent:",{"_3394":922,"_29710":878,"_20617":51253,"_5":14139,"_27008":51150,"_2880":51254},[],"`settings.enrollment_settings.est_rfc7030_settings` for `/simpleenroll` and `/serverkeygen`.",{"_3394":923,"_29710":878,"_20617":51256,"_5":14139,"_27008":51150,"_2880":51257},[],"`settings.reenrollment_settings.est_rfc7030_settings` for `/simplereenroll`.",{"_3394":924,"_29710":878,"_20617":51259,"_5":14139,"_27008":51150,"_2880":51260},[],"`auth_mode`",{"_3394":925,"_29710":878,"_20617":51262,"_5":14139,"_27008":51150,"_2880":51263},[],"Control applied in the configured operation",{"_3394":926,"_29710":878,"_20617":51265,"_5":14139,"_27008":51150,"_2880":51266},[],"`CLIENT_CERTIFICATE`",{"_3394":927,"_29710":878,"_20617":51268,"_5":14139,"_27008":51150,"_2880":51269},[],"Presented certificate validation.",{"_3394":928,"_29710":878,"_20617":51271,"_5":14139,"_27008":51150,"_2880":51272},[],"`EXTERNAL_WEBHOOK`",{"_3394":929,"_29710":878,"_20617":51274,"_5":14139,"_27008":51150,"_2880":51275},[],"Configured webhook authorization.",{"_3394":930,"_29710":878,"_20617":51277,"_5":14139,"_27008":51150,"_2880":51278},[],"`CLIENT_CERTIFICATE_AND_EXTERNAL_WEBHOOK`",{"_3394":931,"_29710":878,"_20617":51280,"_5":14139,"_27008":51150,"_2880":51281},[],"Certificate validation followed by webhook approval.",{"_3394":932,"_29710":878,"_20617":51283,"_5":14139,"_27008":51150,"_2880":51284},[],"`NO_AUTH`",{"_3394":933,"_29710":878,"_20617":51286,"_5":14139,"_27008":51150,"_2880":51287},[],"No DMS requester authentication.",{"_3394":934,"_29710":878,"_20617":51289,"_5":14139,"_27008":51150,"_2880":51290},[],"Webhook and combined modes also execute during re-enrollment when configured in its block. They do not implicitly degrade to NO\\_AUTH. An absent or unrecognized mode fails.",{"_3394":935,"_29710":878,"_20617":51292,"_5":14139,"_27008":51150,"_2880":51293},[],"For initial mTLS, `client_certificate_settings` contains `validation_cas`, `allow_expired` and `chain_level_validation`. The inspected flow receives one certificate credential; it does not guarantee forwarding every handshake intermediate to the validator. For a direct case, configure the bootstrap’s direct issuer as validation CA and test the actual Gateway path.",{"_3394":936,"_29710":878,"_20617":51295,"_5":14139,"_27008":51150,"_2880":51296},[],"For certificate re-enrollment, the validator tries the enrollment CA first and then the CAs listed in `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`; those are the re-enrollment validation CAs. That list is optional because the enrollment CA is always trusted for re-enrollment, and each settings block consults only its own `validation_cas`. CAs listed only in the initial block's `validation_cas` do not extend re-enrollment acceptance; during a CA rotation, add the old issuance CA to the re-enrollment block's list. The re-enrollment validator compares the presented TLS leaf against those CAs; the re-enrollment block's `chain_level_validation` and `allow_expired` values are stored but not consulted, and expiry is governed by `enable_expired_renewal`.",{"_3394":937,"_29710":878,"_20617":51298,"_5":14139,"_27008":51150,"_2880":51299},[],"For a webhook, configure destination, Lamassu-to-service authentication, method and timeout. The authentication contract explains the device credential and request body. `NO_AUTH` does not establish ownership of the requested ID.",{"_3394":938,"_29710":878,"_20617":51301,"_5":14139,"_27008":51154,"_2880":51302},[],"The webhook authentication modes read `external_webhook_settings` in the same `est_rfc7030_settings` block:",{"_3394":939,"_29710":878,"_20617":51304,"_5":14139,"_27008":51154,"_2880":51305},[],"`external_webhook_settings` field",{"_3394":940,"_29710":878,"_20617":51307,"_5":14139,"_27008":51154,"_2880":51215},[],{"_3394":941,"_29710":878,"_20617":51309,"_5":14139,"_27008":51154,"_2880":51310},[],"`url`",{"_3394":942,"_29710":878,"_20617":51312,"_5":14139,"_27008":51154,"_2880":51313},[],"Absolute `http` or `https` URL of the receiver. It must be the final URL; redirects are not followed.",{"_3394":943,"_29710":878,"_20617":51315,"_5":14139,"_27008":51154,"_2880":51316},[],"`method`",{"_3394":944,"_29710":878,"_20617":51318,"_5":14139,"_27008":51154,"_2880":51319},[],"`POST` or `PUT`; `POST` by default.",{"_3394":945,"_29710":878,"_20617":51321,"_5":14139,"_27008":51154,"_2880":51322},[],"`name`",{"_3394":946,"_29710":878,"_20617":51324,"_5":14139,"_27008":51154,"_2880":51325},[],"Label used in service logs.",{"_3394":947,"_29710":878,"_20617":51327,"_5":14139,"_27008":51154,"_2880":51328},[],"`config.auth_mode`",{"_3394":948,"_29710":878,"_20617":51330,"_5":14139,"_27008":51154,"_2880":51331},[],"`noauth`, `apikey`, `jwt` or `mtls`. An absent or unknown value behaves as `noauth`.",{"_3394":949,"_29710":878,"_20617":51333,"_5":14139,"_27008":51154,"_2880":51334},[],"`config.log_level`",{"_3394":950,"_29710":878,"_20617":51336,"_5":14139,"_27008":51154,"_2880":51337},[],"Log level of the webhook call: `debug`, `info`, `warn` or `error`; `info` by default.",{"_3394":951,"_29710":878,"_20617":51339,"_5":14139,"_27008":51154,"_2880":51340},[],"`config.apikey_options`",{"_3394":952,"_29710":878,"_20617":51342,"_5":14139,"_27008":51154,"_2880":51343},[],"Required for `apikey`: `header` and `key`. Reserved header names are rejected.",{"_3394":953,"_29710":878,"_20617":51345,"_5":14139,"_27008":51154,"_2880":51346},[],"`config.jwt_options`",{"_3394":954,"_29710":878,"_20617":51348,"_5":14139,"_27008":51154,"_2880":51349},[],"Required for `jwt`: `oidc_client_id`, `oidc_client_secret` and an absolute `http` or `https` `oidc_well_known`.",{"_3394":955,"_29710":878,"_20617":51351,"_5":14139,"_27008":51154,"_2880":51352},[],"`config.mtls_options`",{"_3394":956,"_29710":878,"_20617":51354,"_5":14139,"_27008":51154,"_2880":51355},[],"Required for `mtls`: `cert_content` and `key_content` as Base64-encoded PEM, like certificates elsewhere in the API; plain PEM is also accepted.",{"_3394":957,"_29710":878,"_20617":51357,"_5":14139,"_27008":51154,"_2880":51358},[],"`config.insecure_skip_verify`",{"_3394":958,"_29710":878,"_20617":51360,"_5":14139,"_27008":51154,"_2880":51361},[],"Skips verification of the receiver certificate when `true`. Verification is on by default. Unlike alert channels, this flag is honored here.",{"_3394":959,"_29710":878,"_20617":51363,"_5":14139,"_27008":51154,"_2880":51364},[],"`config.call_timeout`",{"_3394":960,"_29710":878,"_20617":51366,"_5":14139,"_27008":51154,"_2880":51367},[],"Maximum duration of the authorization call (for example `10s`); 10 seconds by default.",{"_3394":961,"_29710":878,"_20617":51369,"_5":14139,"_27008":51154,"_2880":51370},[],"Rules for that configuration:",{"_3394":962,"_29710":878,"_20617":51372,"_5":14139,"_27008":51154,"_2880":51373},[],"Creating or updating a DMS whose enrollment or reenrollment `auth_mode` uses the webhook validates the block and returns HTTP 400 — the body starts with `struct validation error:` and continues with `invalid enrollment external webhook config` or `invalid reenrollment external webhook config` — when the URL, method or options are invalid. That includes an `mtls_options.cert_content`/`key_content` pair that does not decode to a matching certificate and private key. File references (`ca_cert_file`, `mtls_options.cert_file`, `mtls_options.key_file`) are always invalid: the service does not read files, so enter the certificate and key as Base64-encoded PEM in `mtls_options.cert_content` and `key_content`, or as plain PEM.",{"_3394":963,"_29710":878,"_20617":51375,"_5":14139,"_27008":51154,"_2880":51376},[],"A custom `apikey_options.header` may not use names that the platform or the receiving service trusts — for example `X-Principal-Id`, `X-Request-Id`, `Host`, `Content-Type` or `Forwarded` — and no name may start with `X-Forwarded-`, `X-Envoy-` or `X-Lms-` (case-insensitive). The DMS API reference documents the `WebhookCall` and `WebhookCallHttpClient` schemas and that reserved API-key headers are rejected.",{"_3394":964,"_29710":878,"_20617":51378,"_5":14139,"_27008":51154,"_2880":51379},[],"The nested `http_client` key exists only in alert channel configurations; in a DMS body it is ignored. The DMS key is `external_webhook_settings.config`.",{"_3394":965,"_29710":878,"_20617":51381,"_5":14139,"_27008":51154,"_2880":51382},[],"A body with `config.auth_mode` set to `apikey`, `jwt` or `mtls` must carry its corresponding option block (`apikey_options`, `jwt_options` or `mtls_options`) — and nothing else. Bodies with those auth modes carrying only `apikey`, `oidc` or `mtls` fail validation with 400, and `validate_server_cert` is always ignored: use `insecure_skip_verify`. Only bodies without option blocks are accepted as `noauth`, and their credentials are dropped.",{"_3394":966,"_29710":878,"_20617":51384,"_5":14139,"_27008":51154,"_2880":51385},[],"The authorization response must be JSON of at most 1 MiB; a larger body fails the call.",{"_3394":967,"_29710":878,"_20617":51387,"_5":14139,"_27008":51154,"_2880":51388},[],"With credentials configured, they are sent regardless of the URL scheme: an `http://` webhook receives the API key or bearer token in cleartext, and mTLS has no effect because no TLS handshake takes place, so the client certificate is never presented. Prefer `https://` for `url`, `oidc_well_known` and the token endpoint it advertises.",{"_3394":968,"_29710":878,"_20617":51390,"_5":14139,"_27008":51154,"_2880":51391},[],"Initial authentication and renewal settings are stored independently. If a DMS only has the initial authentication block, renewal reuses it: read both blocks before editing. The console exposes independent editors for the enrollment and re-enrollment authentication, with the same Log Level, Call Timeout, HTTP Authentication and credential fields as the webhook channels, plus a **Skip TLS Verification** switch (off by default, so verification stays on; the console warns when you enable it).",{"_3394":969,"_29710":878,"_20617":51393,"_5":14139,"_27008":51154,"_2880":51394},[],"Webhook credentials must be stored as PEM content. File references (`ca_cert_file`, `mtls_options.cert_file`, `mtls_options.key_file`) are never valid in a stored webhook config: delivery rejects any webhook config that references files, whatever its auth mode, so every enroll and reenroll that calls that webhook fails until the certificate and key are entered as Base64-encoded or plain PEM in `mtls_options.cert_content` and `key_content`, or the file fields are removed if the webhook does not use mTLS. If a stored config holds file paths in `mtls_options.cert_content` or `key_content`, every full settings update (`POST /v1/dms`, `PUT /v1/dms/:id`) fails validation — settings are replaced wholesale, so the stored config must be resent — until the values are replaced by PEM content or the webhook stops being used. Meanwhile, delivery of that webhook fails on every call; a metadata-only update through `PUT` or `PATCH` on `/v1/dms/:id/metadata` still succeeds. To fix it in the console, open the DMS, replace any file-path value with PEM content — the editor rejects file paths with an inline field error — and save. Saving rewrites `external_webhook_settings.config` with the current keys, and the console reads both plain and Base64-encoded PEM from migrated configurations and stores the material Base64-encoded. If your stored config previously relied on `validate_server_cert: false`, it now carries `insecure_skip_verify: true`: receiver-certificate verification stays skipped until you set that flag to `false`. See 3.8.0 to 4.0.0 for the upgrade notes and the operator checklist.",{"_3394":970,"_29710":878,"_20617":51396,"_5":14139,"_27008":51154,"_2880":51397},[],"The re-enrollment trust set lives in `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`. The flat field `reenrollment_settings.additional_validation_cas` is not part of the API: bodies that carry it are accepted but the value is silently ignored — unknown JSON fields are dropped — and GET responses do not include it. Read the DMS before sending API edits: an update body built with that flat field silently empties `validation_cas`.",{"_3394":971,"_29710":878,"_20617":51399,"_5":14139,"_27008":51158,"_2880":51400},[],"`settings.issuance_profile_id` takes precedence over `settings.issuance_profile`; without either, the CA default profile is used. Rules are documented once in Profiles. DMS changes affect future requests; they do not modify signed certificates or install client trust.",{"_3394":972,"_29710":878,"_20617":51402,"_5":14139,"_27008":51162,"_2880":51403},[],"`settings.reenrollment_settings` field",{"_3394":973,"_29710":878,"_20617":51405,"_5":14139,"_27008":51162,"_2880":48759},[],{"_3394":974,"_29710":878,"_20617":51407,"_5":14139,"_27008":51162,"_2880":51408},[],"`reenrollment_delta`",{"_3394":975,"_29710":878,"_20617":51410,"_5":14139,"_27008":51162,"_2880":51411},[],"Opens the window at the active certificate’s `NotAfter` minus this delta.",{"_3394":976,"_29710":878,"_20617":51413,"_5":14139,"_27008":51162,"_2880":51414},[],"`preventive_delta`",{"_3394":977,"_29710":878,"_20617":51416,"_5":14139,"_27008":51162,"_2880":51417},[],"Preventive operational monitoring threshold.",{"_3394":978,"_29710":878,"_20617":51419,"_5":14139,"_27008":51162,"_2880":51420},[],"`critical_delta`",{"_3394":979,"_29710":878,"_20617":51422,"_5":14139,"_27008":51162,"_2880":51423},[],"Critical operational monitoring threshold.",{"_3394":980,"_29710":878,"_20617":51425,"_5":14139,"_27008":51162,"_2880":51426},[],"`enable_expired_renewal`",{"_3394":981,"_29710":878,"_20617":51428,"_5":14139,"_27008":51162,"_2880":51429},[],"Accepts an expired presented certificate in the renewal mTLS validator. Does not authorize another mode or remove Gateway constraints by itself.",{"_3394":982,"_29710":878,"_20617":51431,"_5":14139,"_27008":51162,"_2880":51432},[],"`est_rfc7030_settings.client_certificate_settings.validation_cas`",{"_3394":983,"_29710":878,"_20617":51434,"_5":14139,"_27008":51162,"_2880":51435},[],"Re-enrollment validation CAs for the renewal mTLS credential, tried after the enrollment CA; optional, because the enrollment CA is always trusted. Typically populated during CA rotation while old-CA cohorts renew.",{"_3394":984,"_29710":878,"_20617":51437,"_5":14139,"_27008":51162,"_2880":51438},[],"`revoke_on_reenrollment`",{"_3394":985,"_29710":878,"_20617":51440,"_5":14139,"_27008":51162,"_2880":51441},[],"If the previous certificate is ACTIVE, attempts Superseded revocation before binding its successor.",{"_3394":986,"_29710":878,"_20617":51443,"_5":14139,"_27008":51162,"_2880":51444},[],"Monitoring does not renew: the client must schedule the request and installation. Webhook and NO\\_AUTH modes do not use the same mTLS expired-credential validator; the webhook must explicitly authorize permitted recovery. Review Renewal and recovery for operation order and partial failures.",{"_3394":987,"_29710":878,"_20617":51446,"_5":14139,"_27008":51166,"_2880":51447},[],"`settings.server_keygen_settings.enabled` enables software key generation on the server. The console exposes it through an **Enable server-side key generation** switch and a **Key type** selection: `ECDSA` P-256, P-384 or P-521, or `RSA` with 2048, 3072 or 4096 bits; the defaults are P-256 for `ECDSA` and 4096 bit for `RSA`. Algorithm and size come from its `key` field, stored as `{type,bits}` where P-256, P-384 and P-521 map to `bits` 256, 384 and 521; `key` is omitted when disabled. The profile must permit them. The response contains an unencrypted PKCS#8 key inside TLS alongside the certificate. See format and extraction in EST reference.",{"_3394":988,"_29710":878,"_20617":51449,"_5":14139,"_27008":51170,"_2880":48753},[],{"_3394":989,"_29710":878,"_20617":51451,"_5":14139,"_27008":51170,"_2880":51452},[],"Published material",{"_3394":990,"_29710":878,"_20617":51454,"_5":14139,"_27008":51170,"_2880":51455},[],"**Include Lamassu System CA**",{"_3394":991,"_29710":878,"_20617":51457,"_5":14139,"_27008":51170,"_2880":51458},[],"Available downstream TLS certificate; it can be a leaf, not an issuing CA.",{"_3394":992,"_29710":878,"_20617":51460,"_5":14139,"_27008":51170,"_2880":51461},[],"**Include Enrollment CA**",{"_3394":993,"_29710":878,"_20617":51463,"_5":14139,"_27008":51170,"_2880":51464},[],"Selected issuing CA certificate.",{"_3394":994,"_29710":878,"_20617":51466,"_5":14139,"_27008":51170,"_2880":51467},[],"**Managed CAs**",{"_3394":995,"_29710":878,"_20617":51469,"_5":14139,"_27008":51170,"_2880":51470},[],"Explicitly selected CA certificates.",{"_3394":996,"_29710":878,"_20617":51472,"_5":14139,"_27008":51170,"_2880":51473},[],"All ancestors are not added automatically. Trust distribution distinguishes trusted roots, intermediates and initial server trust.",{"_3394":997,"_29710":878,"_20617":51475,"_5":14139,"_27008":51174,"_2880":51476},[],"**Edit** changes name, settings and metadata. Updates go through the DMS API. `PUT /v1/dms/{id}` always targets the DMS identified by the URL path: the body carries no `id` field, and any `id` or `creation_ts` in it is silently ignored — authorization is evaluated against the same URL identifier. The body must include a non-empty `name` and a `settings` object; missing either returns HTTP 400 and leaves the stored DMS unchanged. `name` and `settings` are always full replacements, so read the DMS before sending API edits to avoid losing fields. `metadata` is optional: omitting it or sending `null` keeps the stored metadata, a supplied object replaces it entirely, and `{}` clears it (a later GET returns an empty object, not `null`). Old-style bodies that carry the full DMS object keep working while they include `name` and `settings`; unknown fields are ignored. Updates reject an empty `name` with HTTP 400: a DMS whose stored name was zeroed by an earlier update must be renamed before any client round-trips it — the AWS IoT connector’s JITP writeback included. If the object does not include the AWS IoT connector key (`lamassu.io/iot/{connector_id}`), the connector ignores the DMS's later events.",{"_3394":998,"_29710":878,"_20617":51478,"_5":14139,"_27008":51174,"_2880":51479},[],"**Go to DMS owned devices** restricts inventory by owner. **Show/Edit Metadata** contains operational and integration data; consult the integration guide before changing it. &#x2A;*EST (RFC-7030)** helps locate URLs.",{"_3394":999,"_29710":878,"_20617":51481,"_5":14139,"_27008":51174,"_2880":51482},[],"**Delete** removes the DMS record and configuration; it does not itself cascade revocation across every device and certificate. Migrate dependencies and retain audit references before retirement.",{"_3394":1000,"_29710":878,"_20617":51484,"_5":14139,"_27008":51178,"_2880":51485},[],"Continue with EST client or the enrollment and mTLS tutorial. EST reference covers formats; Troubleshooting covers failures.",{"_3394":1001,"_29710":1001,"_5":14491,"_2880":51487,"_30042":51488,"_20617":51489,"_27008":1001},"Integrate the EST client",[48369,49837,50848,50846,51029],[],{"_3394":1002,"_29710":1001,"_20617":51491,"_5":14139,"_27008":1001,"_2880":51492},[],"Prepare trust, send a CSR and check the identity you receive.",{"_3394":1003,"_29710":1001,"_5":30039,"_20617":51494,"_27008":51495,"_2880":48379},[],"/docs/platform/iot-fleets/enrollment/est-client#before-you-begin",{"_3394":1004,"_29710":1001,"_5":30039,"_20617":51497,"_27008":51498,"_2880":51499},[],"/docs/platform/iot-fleets/enrollment/est-client#download-and-inspect-cacerts","Download and inspect cacerts",{"_3394":1005,"_29710":1001,"_5":30039,"_20617":51501,"_27008":51502,"_2880":51503},[],"/docs/platform/iot-fleets/enrollment/est-client#prepare-the-csr","Prepare the CSR",{"_3394":1006,"_29710":1001,"_5":30039,"_20617":51505,"_27008":51506,"_2880":51507},[],"/docs/platform/iot-fleets/enrollment/est-client#request-the-identity","Request the identity",{"_3394":1007,"_29710":1001,"_5":30039,"_20617":51509,"_27008":51510,"_2880":51511},[],"/docs/platform/iot-fleets/enrollment/est-client#check-and-install-the-result","Check and install the result",{"_3394":1008,"_29710":1001,"_5":30039,"_20617":51513,"_27008":51514,"_2880":51515},[],"/docs/platform/iot-fleets/enrollment/est-client#next-steps","Next steps",{"_3394":1009,"_29710":1001,"_20617":51517,"_5":14139,"_27008":1001,"_2880":51518},[],"This guide is for those implementing the device client. The administrator must have prepared the DMS policy. For a complete first run, follow Enroll and connect your first device.",{"_3394":1010,"_29710":1001,"_20617":51520,"_5":14139,"_27008":51495,"_2880":51521},[],"You need the public HTTPS DMS URL, server trust obtained through an approved channel, the operation's authentication mode and an admitted identifier. The examples use Bash, OpenSSL 3.x and curl with `--fail-with-body`; use a private working directory and compatible versions of these tools.",{"_3394":1011,"_29710":1001,"_20617":51523,"_5":14139,"_27008":51495,"_2880":51524},[],"Prepare `est-trust.pem` to verify the EST server, `bootstrap.crt` and `bootstrap.key` for initial certificate authentication, and `device-root.pem` as the approved root of the device issuer. The two trust files can contain different roots. For another authentication mode, adapt the credentials according to Bootstrap identity.",{"_3394":1012,"_29710":1001,"_20617":51526,"_5":14139,"_27008":51495,"_2880":51527},[],"Replace the host and `REPLACE_DMS_ID` with those of your installation. The URL's APS is the DMS identifier, not its display name.",{"_3394":1013,"_29710":1001,"_20617":51529,"_5":14139,"_27008":51498,"_2880":51530},[],"The default content is Base64-encoded DER PKCS#7. It is not a direct PEM file.",{"_3394":1014,"_29710":1001,"_20617":51532,"_5":14139,"_27008":51498,"_2880":51533},[],"Check fingerprints, issuers and dates against the trust distribution policy. The response can contain a selection of CAs and Lamassu's TLS certificate. Do not turn the entire bundle into trusted roots or use it to authenticate its own initial download. HTTP 200 here does not prove that authentication or issuance works.",{"_3394":1015,"_29710":1001,"_20617":51535,"_5":14139,"_27008":51502,"_2880":51536},[],"The example generates a new EC P-256 key and uses `est-device-001`, which must be available if the DMS registers automatically. The `Common Name` becomes the device identifier. Check that the profile permits the selected key and subject.",{"_3394":1016,"_29710":1001,"_20617":51538,"_5":14139,"_27008":51502,"_2880":51539},[],"An implementation using hardware or its own store must produce the CSR through its resident key. `simpleenroll` sends the request and retains the key in the client. Honor Extensions does not authorize every requested attribute: see Profiles.",{"_3394":1017,"_29710":1001,"_20617":51541,"_5":14139,"_27008":51506,"_2880":51542},[],"With initial `CLIENT_CERTIFICATE` authentication, send the Base64-encoded DER CSR using `Content-Type: application/pkcs10`:",{"_3394":1018,"_29710":1001,"_20617":51544,"_5":14139,"_27008":51506,"_2880":51545},[],"Stop if curl fails. Retain the HTTP code, headers and body for diagnosis; an error response is not decoded as a certificate. The Bash example stops before that conversion. A timeout leaves the operation's result to be checked in Lamassu: do not automatically repeat issuance.",{"_3394":1019,"_29710":1001,"_20617":51547,"_5":14139,"_27008":51510,"_2880":51548},[],"For a root that issues directly:",{"_3394":1020,"_29710":1001,"_20617":51550,"_5":14139,"_27008":51510,"_2880":51551},[],"Also verify that the CN is correct, the certificate is a leaf, its uses permit your application and its dates satisfy the profile. `cmp` must exit with code 0. With intermediates, provide the chain through `-untrusted` as described in PKI validation.",{"_3394":1021,"_29710":1001,"_20617":51553,"_5":14139,"_27008":51510,"_2880":51554},[],"Query the device: the owning DMS, current serial number and history must match the result. Protect the key/certificate pair and install both using the device's mechanism. Association in Lamassu does not install files in the client. Check a real connection before considering the process complete.",{"_3394":1022,"_29710":1001,"_20617":51556,"_5":14139,"_27008":51514,"_2880":51557},[],"Implement renewal and recovery and trust updates. The EST reference covers endpoints, formats and ServerKeyGen; troubleshooting helps distinguish transport, admission and persistence failures.",{"_3394":1023,"_29710":1023,"_5":14491,"_2880":51559,"_30042":51560,"_20617":51561,"_27008":1023},"EST reference",[48369,49837,50848,50846,51029],[],{"_3394":1024,"_29710":1023,"_20617":51563,"_5":14139,"_27008":1023,"_2880":51564},[],"Look up Lamassu routes, formats, authentication and multipart responses.",{"_3394":1025,"_29710":1023,"_5":30039,"_20617":51566,"_27008":51567,"_2880":51568},[],"/docs/platform/iot-fleets/enrollment/est-reference#endpoint-reference","Endpoint reference",{"_3394":1026,"_29710":1023,"_5":30039,"_20617":51570,"_27008":51571,"_2880":22340},[],"/docs/platform/iot-fleets/enrollment/est-reference#cacerts",{"_3394":1027,"_29710":1023,"_5":30039,"_20617":51573,"_27008":51574,"_2880":25638},[],"/docs/platform/iot-fleets/enrollment/est-reference#simpleenroll",{"_3394":1028,"_29710":1023,"_5":30039,"_20617":51576,"_27008":51577,"_2880":25645},[],"/docs/platform/iot-fleets/enrollment/est-reference#simplereenroll",{"_3394":1029,"_29710":1023,"_5":30039,"_20617":51579,"_27008":51580,"_2880":24968},[],"/docs/platform/iot-fleets/enrollment/est-reference#serverkeygen",{"_3394":1030,"_29710":1023,"_5":30039,"_20617":51582,"_27008":51583,"_2880":51584},[],"/docs/platform/iot-fleets/enrollment/est-reference#response-format","Response format",{"_3394":1031,"_29710":1023,"_5":30039,"_20617":51586,"_27008":51587,"_2880":51588},[],"/docs/platform/iot-fleets/enrollment/est-reference#request-and-extraction","Request and extraction",{"_3394":1032,"_29710":1023,"_5":30039,"_20617":51590,"_27008":51591,"_2880":51592},[],"/docs/platform/iot-fleets/enrollment/est-reference#compatibility-notes","Compatibility notes",{"_3394":1033,"_29710":1023,"_20617":51594,"_5":14139,"_27008":1023,"_2880":51595},[],"Reference for the examined backend, based on RFC 7030. Use EST client for the procedure and DMS to configure policy.",{"_3394":1034,"_29710":1023,"_20617":51597,"_5":14139,"_27008":51567,"_2880":51598},[],"Public route in the examples: `/.well-known/est/{APS}/{operation}`. `APS` is the DMS ID. The router admits routes without that segment, but the controller requires it; do not use them as a default service. Gateway configuration determines the public host and route.",{"_3394":1035,"_29710":1023,"_20617":51600,"_5":14139,"_27008":51567,"_2880":51601},[],"Operation",{"_3394":1036,"_29710":1023,"_20617":51603,"_5":14139,"_27008":51567,"_2880":51604},[],"Method",{"_3394":1037,"_29710":1023,"_20617":51606,"_5":14139,"_27008":51567,"_2880":51607},[],"Authentication and condition",{"_3394":1038,"_29710":1023,"_20617":51609,"_5":14139,"_27008":51567,"_2880":51610},[],"`/cacerts`",{"_3394":1039,"_29710":1023,"_20617":51612,"_5":14139,"_27008":51567,"_2880":51613},[],"GET",{"_3394":1040,"_29710":1023,"_20617":51615,"_5":14139,"_27008":51567,"_2880":51616},[],"DMS reading does not require an EST credential; HTTPS and infrastructure controls still apply.",{"_3394":1041,"_29710":1023,"_20617":51618,"_5":14139,"_27008":51567,"_2880":51619},[],"`/simpleenroll`",{"_3394":1042,"_29710":1023,"_20617":51621,"_5":14139,"_27008":51567,"_2880":51622},[],"POST",{"_3394":1043,"_29710":1023,"_20617":51624,"_5":14139,"_27008":51567,"_2880":51625},[],"Initial authentication and DMS registration/replacement policy.",{"_3394":1044,"_29710":1023,"_20617":51627,"_5":14139,"_27008":51567,"_2880":51628},[],"`/simplereenroll`",{"_3394":1045,"_29710":1023,"_20617":51630,"_5":14139,"_27008":51567,"_2880":51622},[],{"_3394":1046,"_29710":1023,"_20617":51632,"_5":14139,"_27008":51567,"_2880":51633},[],"Renewal authentication, existing identity, subject, revocation and window.",{"_3394":1047,"_29710":1023,"_20617":51635,"_5":14139,"_27008":51567,"_2880":51636},[],"`/serverkeygen`",{"_3394":1048,"_29710":1023,"_20617":51638,"_5":14139,"_27008":51567,"_2880":51622},[],{"_3394":1049,"_29710":1023,"_20617":51640,"_5":14139,"_27008":51567,"_2880":51641},[],"Initial authentication and admission; server generation enabled.",{"_3394":1050,"_29710":1023,"_20617":51643,"_5":14139,"_27008":51567,"_2880":51644},[],"These routes do not implement `/csrattrs` or `/fullcmc`. There is no native JWT EST authentication mode; a webhook can interpret a request credential according to its own contract.",{"_3394":1051,"_29710":1023,"_20617":51646,"_5":14139,"_27008":51571,"_2880":51647},[],"The default response has `Content-Type: application/pkcs7-mime; smime-type=certs-only` and `Content-Transfer-Encoding: base64`. The body is Base64-encoded DER PKCS#7 with lines of up to 76 characters. It includes the certificates selected by the DMS, not necessarily every ancestor.",{"_3394":1052,"_29710":1023,"_20617":51649,"_5":14139,"_27008":51571,"_2880":51650},[],"`Accept: application/x-pem-file` requests the bundle in PEM through a Lamassu extension. Inspect and approve its contents before modifying trusted roots.",{"_3394":1053,"_29710":1023,"_20617":51652,"_5":14139,"_27008":51574,"_2880":51653},[],"Send a Base64-encoded DER PKCS#10 CSR with `Content-Type: application/pkcs10`. The examined controller compares that media type literally; avoid adding parameters such as charset. The CN identifies the device and the CSR signature must be verified through DMS policy.",{"_3394":1054,"_29710":1023,"_20617":51655,"_5":14139,"_27008":51574,"_2880":51656},[],"The default response uses the PKCS#7/Base64 format described for cacerts, but contains the issued certificate; do not assume it includes its entire chain. `Accept: application/x-pem-file` returns that certificate in PEM. The client retains the key that signed the CSR.",{"_3394":1055,"_29710":1023,"_20617":51658,"_5":14139,"_27008":51577,"_2880":51659},[],"Use the same request and certificate response formats. Authentication comes from the independent `reenrollment_settings.est_rfc7030_settings` block. With a client certificate, its CN must match the CSR CN; the subject is also checked against the current certificate.",{"_3394":1056,"_29710":1023,"_20617":51661,"_5":14139,"_27008":51577,"_2880":51662},[],"In mTLS mode, the enrollment CA always validates the re-enrollment credential; certificates from other issuers are accepted only if they are listed as validation CAs in the re-enrollment block. The expiry check through `enable_expired_renewal` belongs to that validator. A revoked current certificate and a request before the window are rejected. See Renewal for installation and recovery.",{"_3394":1057,"_29710":1023,"_20617":51664,"_5":14139,"_27008":51580,"_2880":51665},[],"The server generates a software key, rebuilds the CSR with that key and performs initial enrollment. The flag must be enabled and the algorithm permitted by the profile. This operation's key does not become a hardware key because the CA is hosted in an HSM.",{"_3394":1058,"_29710":1023,"_20617":51667,"_5":14139,"_27008":51580,"_2880":51668},[],"The code supports RSA and ECDSA, and the `bits` value of the DMS key setting means something different for each. For ECDSA it selects the curve: 224, 256, 384 or 521 map to P-224, P-256, P-384 and P-521, and an unrecognized size falls back to P-256, so explicitly select a compatible size and check the resulting key. For RSA it is used directly as the modulus size; the console offers 2048, 3072 and 4096 bits. Do not reuse an enrolled ID to test this operation without reviewing replacement.",{"_3394":1059,"_29710":1023,"_20617":51670,"_5":14139,"_27008":51583,"_2880":51671},[],"The body is **MIME multipart/mixed**, with the boundary specified in `Content-Type`. It contains two parts:",{"_3394":1060,"_29710":1023,"_20617":51673,"_5":14139,"_27008":51583,"_2880":51674},[],"Part",{"_3394":1061,"_29710":1023,"_20617":51676,"_5":14139,"_27008":51583,"_2880":51677},[],"Content after decoding its Base64",{"_3394":1062,"_29710":1023,"_20617":51679,"_5":14139,"_27008":51583,"_2880":51680},[],"`application/pkcs8`",{"_3394":1063,"_29710":1023,"_20617":51682,"_5":14139,"_27008":51583,"_2880":51683},[],"Unencrypted DER PKCS#8 private key.",{"_3394":1064,"_29710":1023,"_20617":51685,"_5":14139,"_27008":51583,"_2880":51686},[],"`application/pkcs7-mime; smime-type=certs-only`",{"_3394":1065,"_29710":1023,"_20617":51688,"_5":14139,"_27008":51583,"_2880":51689},[],"DER PKCS#7 containing the issued certificate.",{"_3394":1066,"_29710":1023,"_20617":51691,"_5":14139,"_27008":51583,"_2880":51692},[],"The controller also adds `Content-Transfer-Encoding: base64` to the outer header, although the outer body is MIME text. &#x2A;*Do not Base64-decode the entire body.** Read the actual boundary and decode each part according to its headers.",{"_3394":1067,"_29710":1023,"_20617":51694,"_5":14139,"_27008":51587,"_2880":51695},[],"In a Bash session with `set -euo pipefail` and `umask 077`, use `EST_BASE` and the trust/bootstrap files from EST client. Select an available and admitted `est-serverkeygen-001`. The `server-request.key` only signs the input CSR; the received identity uses the server-generated key.",{"_3394":1068,"_29710":1023,"_20617":51697,"_5":14139,"_27008":51587,"_2880":51698},[],"Save this Python 3 extractor. It validates both parts before writing and rejects existing output files:",{"_3394":1069,"_29710":1023,"_20617":51700,"_5":14139,"_27008":51587,"_2880":51701},[],"Convert and check the result:",{"_3394":1070,"_29710":1023,"_20617":51703,"_5":14139,"_27008":51587,"_2880":51704},[],"Inspect the CN, serial, dates and uses; check association in Lamassu before installing. Protect the DER and PEM files containing the key and remove temporary copies according to the device's storage mechanism. See openssl-pkcs8 and the Python MIME parser.",{"_3394":1071,"_29710":1023,"_20617":51706,"_5":14139,"_27008":51591,"_2880":51707},[],"Do not interpret every 500 as a transient failure. Invalid input typically produces 400; service denials and errors typically produce 500 with a JSON `err` body. Gateway errors and some controller paths can have another format. Retain headers and body before decoding and see troubleshooting.",{"_3394":1072,"_29710":1023,"_20617":51709,"_5":14139,"_27008":51591,"_2880":51710},[],"The examples use openssl-pkcs7 to extract certificates and openssl-x509 to prepare renewal. Check your version's capabilities and responses before integrating a generic EST client.",{"_3394":1073,"_29710":1073,"_5":14491,"_2880":51029,"_30042":51712,"_20617":51713,"_27008":1073},[48369,49837,50848,50846,51029],[],{"_3394":1074,"_29710":1073,"_20617":51715,"_5":14139,"_27008":1073,"_2880":51716},[],"Choose admission policy and connect DMS, initial trust and the EST client.",{"_3394":1075,"_29710":1073,"_5":30039,"_20617":51718,"_27008":51719,"_2880":51720},[],"/docs/platform/iot-fleets/enrollment/overview#the-journey","The journey",{"_3394":1076,"_29710":1073,"_5":30039,"_20617":51722,"_27008":51723,"_2880":51724},[],"/docs/platform/iot-fleets/enrollment/overview#for-the-administrator","For the administrator",{"_3394":1077,"_29710":1073,"_5":30039,"_20617":51726,"_27008":51727,"_2880":51728},[],"/docs/platform/iot-fleets/enrollment/overview#for-the-integrator","For the integrator",{"_3394":1078,"_29710":1073,"_5":30039,"_20617":51730,"_27008":51731,"_2880":51732},[],"/docs/platform/iot-fleets/enrollment/overview#contract-version","Contract version",{"_3394":1079,"_29710":1073,"_20617":51734,"_5":14139,"_27008":1073,"_2880":51735},[],"Enrollment with PKI covers the path from device admission to identity installation and renewal. The DMS acts as a registration authority: it authenticates the request, applies registration policy and asks the CA to sign. The client keeps or receives the key, installs the result and presents it to the consumer.",{"_3394":1080,"_29710":1073,"_20617":51737,"_5":14139,"_27008":51719,"_2880":51738},[],"The administrator prepares the CA, issuance profile and DMS.",{"_3394":1081,"_29710":1073,"_20617":51740,"_5":14139,"_27008":51719,"_2880":51741},[],"The integrator installs initial EST server trust and an admission credential.",{"_3394":1082,"_29710":1073,"_20617":51743,"_5":14139,"_27008":51719,"_2880":51744},[],"The client requests an identity for its `Device ID` through EST.",{"_3394":1083,"_29710":1073,"_20617":51746,"_5":14139,"_27008":51719,"_2880":51747},[],"Certificate, device binding and key/certificate installation are checked.",{"_3394":1084,"_29710":1073,"_20617":51749,"_5":14139,"_27008":51719,"_2880":51750},[],"The consumer validates and authorizes the identity; the client schedules renewal and recovery.",{"_3394":1085,"_29710":1073,"_20617":51752,"_5":14139,"_27008":51719,"_2880":51753},[],"EST uses `/.well-known/est/{DMS_ID}`. Administrative APIs and manual assignment remain separate paths. Enroll and connect a device completes an initial mTLS test.",{"_3394":1086,"_29710":1073,"_20617":51755,"_5":14139,"_27008":51723,"_2880":51756},[],"<Card title=\"Provisioning strategies\" description=\"Choose automatic registration, preregistration or manual assignment.\" href=\"/docs/platform/iot-fleets/enrollment/provisioning-strategies\" />",{"_3394":1087,"_29710":1073,"_20617":51758,"_5":14139,"_27008":51723,"_2880":51759},[],"<Card title=\"Configure the DMS\" description=\"Separate admission, authentication per operation, profiles and distribution.\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_3394":1088,"_29710":1073,"_20617":51761,"_5":14139,"_27008":51723,"_2880":51762},[],"<Card title=\"Bootstrap identity and authentication\" description=\"Decide which proof allows requesting the first identity.\" href=\"/docs/platform/iot-fleets/enrollment/bootstrap-identity\" />",{"_3394":1089,"_29710":1073,"_20617":51764,"_5":14139,"_27008":51723,"_2880":51765},[],"<Card title=\"Trust distribution\" description=\"Update roots and chains with verified overlap.\" href=\"/docs/platform/iot-fleets/enrollment/trust-distribution\" />",{"_3394":1090,"_29710":1073,"_20617":51767,"_5":14139,"_27008":51727,"_2880":51768},[],"<Card title=\"EST client\" description=\"Prepare the request, verify the response and install the identity.\" href=\"/docs/platform/iot-fleets/enrollment/est-client\" />",{"_3394":1091,"_29710":1073,"_20617":51770,"_5":14139,"_27008":51727,"_2880":51771},[],"<Card title=\"Renewal and recovery\" description=\"Generate the successor and handle expired or lost credentials.\" href=\"/docs/platform/iot-fleets/enrollment/renewal-and-recovery\" />",{"_3394":1092,"_29710":1073,"_20617":51773,"_5":14139,"_27008":51727,"_2880":51774},[],"<Card title=\"EST reference\" description=\"Look up paths, formats, authentication and ServerKeyGen.\" href=\"/docs/platform/iot-fleets/enrollment/est-reference\" />",{"_3394":1093,"_29710":1073,"_20617":51776,"_5":14139,"_27008":51727,"_2880":51777},[],"<Card title=\"Troubleshooting\" description=\"Distinguish transport, policy, issuance and installation failures.\" href=\"/docs/platform/iot-fleets/enrollment/troubleshooting\" />",{"_3394":1094,"_29710":1073,"_20617":51779,"_5":14139,"_27008":51731,"_2880":51780},[],"This block describes `main` code inspected at commit `8f42c47157f9a36bac3ed5caa3692aebebe19c4b`. The site catalog publishes `main (unstable)`; this behavior is not attributed to a stable release. Before using another version, check its contract, particularly independent re-enrollment authentication. Client checks and live-instance tests are distinguished in the revision plan.",{"_3394":1095,"_29710":1073,"_20617":51782,"_5":14139,"_27008":51731,"_2880":51783},[],"Gateway, TLS, provider and service configuration belongs to Deployment. Identity use in AWS or other destinations belongs to Integrations.",{"_3394":1096,"_29710":1096,"_5":14491,"_2880":51785,"_30042":51786,"_20617":51787,"_27008":1096},"Provisioning strategies",[48369,49837,50848,50846,51029],[],{"_3394":1097,"_29710":1096,"_20617":51789,"_5":14139,"_27008":1096,"_2880":51790},[],"Choose device registration, identity authorization and key generation.",{"_3394":1098,"_29710":1096,"_5":30039,"_20617":51792,"_27008":51793,"_2880":51794},[],"/docs/platform/iot-fleets/enrollment/provisioning-strategies#choose-registration","Choose registration",{"_3394":1099,"_29710":1096,"_5":30039,"_20617":51796,"_27008":51797,"_2880":51798},[],"/docs/platform/iot-fleets/enrollment/provisioning-strategies#preregistration-and-replacement","Preregistration and replacement",{"_3394":1100,"_29710":1096,"_5":30039,"_20617":51800,"_27008":51801,"_2880":51802},[],"/docs/platform/iot-fleets/enrollment/provisioning-strategies#choose-authentication","Choose authentication",{"_3394":1101,"_29710":1096,"_5":30039,"_20617":51804,"_27008":51805,"_2880":51806},[],"/docs/platform/iot-fleets/enrollment/provisioning-strategies#choose-custody","Choose custody",{"_3394":1102,"_29710":1096,"_5":30039,"_20617":51808,"_27008":51809,"_2880":51810},[],"/docs/platform/iot-fleets/enrollment/provisioning-strategies#check-the-decision","Check the decision",{"_3394":1103,"_29710":1096,"_20617":51812,"_5":14139,"_27008":1096,"_2880":51813},[],"This guide helps the provisioning administrator choose a path before configuring the DMS. Separate three decisions: when the device exists, how its request is authorized and who generates its key. None grants destination access by itself.",{"_3394":1104,"_29710":1096,"_20617":51815,"_5":14139,"_27008":51793,"_2880":51816},[],"Path",{"_3394":1105,"_29710":1096,"_20617":51818,"_5":14139,"_27008":51793,"_2880":51819},[],"When the device exists",{"_3394":1106,"_29710":1096,"_20617":51821,"_5":14139,"_27008":51793,"_2880":51822},[],"What to check",{"_3394":1107,"_29710":1096,"_20617":51824,"_5":14139,"_27008":51793,"_2880":51825},[],"Manual assignment",{"_3394":1108,"_29710":1096,"_20617":51827,"_5":14139,"_27008":51793,"_2880":51828},[],"An operator creates it before associating a certificate.",{"_3394":1109,"_29710":1096,"_20617":51830,"_5":14139,"_27008":51793,"_2880":51831},[],"ID, owning DMS, certificate CN and bound serial.",{"_3394":1110,"_29710":1096,"_20617":51833,"_5":14139,"_27008":51793,"_2880":51834},[],"EST with `JITP`",{"_3394":1111,"_29710":1096,"_20617":51836,"_5":14139,"_27008":51793,"_2880":51837},[],"Created for an unknown CN during `/simpleenroll`.",{"_3394":1112,"_29710":1096,"_20617":51839,"_5":14139,"_27008":51793,"_2880":51840},[],"Authorized credential, unused ID, profile, resulting registration and identity.",{"_3394":1113,"_29710":1096,"_20617":51842,"_5":14139,"_27008":51793,"_2880":51843},[],"EST with `PRE_REGISTRATION`",{"_3394":1114,"_29710":1096,"_20617":51845,"_5":14139,"_27008":51793,"_2880":51846},[],"Must exist before `/simpleenroll`.",{"_3394":1115,"_29710":1096,"_20617":51848,"_5":14139,"_27008":51793,"_2880":51849},[],"Approved record, same DMS and replacement conditions for your version.",{"_3394":1116,"_29710":1096,"_20617":51851,"_5":14139,"_27008":51793,"_2880":51852},[],"Lamassu `JITP` creates inventory and identity in Lamassu. AWS JITP provisions a destination in AWS; these are separate decisions.",{"_3394":1117,"_29710":1096,"_20617":51854,"_5":14139,"_27008":51793,"_2880":51855},[],"For an initial client test, use Enroll and connect a device. To prepare inventory without EST, follow Manual registration.",{"_3394":1118,"_29710":1096,"_20617":51857,"_5":14139,"_27008":51797,"_2880":51858},[],"In the inspected code, finding any device owned by the same DMS triggers the `enable_replaceable_enrollment` check before PRE\\_REGISTRATION. With the flag disabled, a preregistered device can receive `forbiddenNewEnrollment` even in **No Identity**. Selecting PRE\\_REGISTRATION alone therefore does not establish a working path.",{"_3394":1119,"_29710":1096,"_20617":51860,"_5":14139,"_27008":51797,"_2880":51861},[],"Enabling the flag permits repeated `/simpleenroll` for an existing ID. The backend schedules a deferred attempt to revoke the previous certificate with `Superseded`; it can also run if later issuance or binding fails. Without an identity, that attempt can fail because no serial exists. The flag does not provide a replacement transaction or guarantee restoration of previous state.",{"_3394":1120,"_29710":1096,"_20617":51863,"_5":14139,"_27008":51797,"_2880":51864},[],"Test the exact case on your version before enabling it for a population. For an operational identity with authorized renewal, use `/simplereenroll`; for recovery, follow Renewal and recovery and check persisted state before retrying.",{"_3394":1121,"_29710":1096,"_20617":51866,"_5":14139,"_27008":51801,"_2880":51867},[],"Decide initial enrollment and re-enrollment separately:",{"_3394":1122,"_29710":1096,"_20617":51869,"_5":14139,"_27008":51801,"_2880":51870},[],"**Client certificate:** useful when each device has an initial credential whose key it controls.",{"_3394":1123,"_29710":1096,"_20617":51872,"_5":14139,"_27008":51801,"_2880":51873},[],"**Webhook:** useful when another authority knows inventory, credentials or entitlement to a requested ID.",{"_3394":1124,"_29710":1096,"_20617":51875,"_5":14139,"_27008":51801,"_2880":51876},[],"**Certificate and webhook:** requires both controls in the configured operation.",{"_3394":1125,"_29710":1096,"_20617":51878,"_5":14139,"_27008":51801,"_2880":51879},[],"**NO\\_AUTH:** does not establish requester identity; appropriate only when admission is deliberately controlled outside that DMS.",{"_3394":1126,"_29710":1096,"_20617":51881,"_5":14139,"_27008":51801,"_2880":51882},[],"Authenticating an initial certificate does not itself establish entitlement to choose any CSR CN. Define that authorization in Bootstrap identity and authentication.",{"_3394":1127,"_29710":1096,"_20617":51884,"_5":14139,"_27008":51805,"_2880":48753},[],{"_3394":1128,"_29710":1096,"_20617":51886,"_5":14139,"_27008":51805,"_2880":51887},[],"Material crossing EST",{"_3394":1129,"_29710":1096,"_20617":51889,"_5":14139,"_27008":51805,"_2880":51890},[],"Device-generated key",{"_3394":1130,"_29710":1096,"_20617":51892,"_5":14139,"_27008":51805,"_2880":51893},[],"Public CSR and certificate; the key stays on the client.",{"_3394":1131,"_29710":1096,"_20617":51895,"_5":14139,"_27008":51805,"_2880":51896},[],"Existing device key",{"_3394":1132,"_29710":1096,"_20617":51898,"_5":14139,"_27008":51805,"_2880":51899},[],"CSR signed with that key and a new certificate.",{"_3394":1133,"_29710":1096,"_20617":51901,"_5":14139,"_27008":51805,"_2880":51167},[],{"_3394":1134,"_29710":1096,"_20617":51903,"_5":14139,"_27008":51805,"_2880":51904},[],"Private PKCS#8 key and certificate in a TLS-protected multipart response.",{"_3394":1135,"_29710":1096,"_20617":51906,"_5":14139,"_27008":51805,"_2880":51907},[],"ServerKeyGen does not automatically use the CA’s HSM or KMS for the device key. Review its contract and extraction and the device’s ability to install the material.",{"_3394":1136,"_29710":1096,"_20617":51909,"_5":14139,"_27008":51809,"_2880":51910},[],"Before expanding the flow, test allowed registration, incorrect credentials, an ID owned by another DMS, repeated requests and recovery after failure. Keep ID, serial, active version and error. Also test consumer acceptance and rejection; issuance does not imply destination registration or permission to operate.",{"_3394":1137,"_29710":1137,"_5":14491,"_2880":51912,"_30042":51913,"_20617":51914,"_27008":1137},"Renewal and recovery",[48369,49837,50848,50846,51029],[],{"_3394":1138,"_29710":1137,"_20617":51916,"_5":14139,"_27008":1137,"_2880":51917},[],"Renew without losing the identity and recover devices according to their actual state.",{"_3394":1139,"_29710":1137,"_5":30039,"_20617":51919,"_27008":51920,"_2880":51921},[],"/docs/platform/iot-fleets/enrollment/renewal-and-recovery#prepare-renewal","Prepare renewal",{"_3394":1140,"_29710":1137,"_5":30039,"_20617":51923,"_27008":51924,"_2880":51925},[],"/docs/platform/iot-fleets/enrollment/renewal-and-recovery#request-the-successor-certificate","Request the successor certificate",{"_3394":1141,"_29710":1137,"_5":30039,"_20617":51927,"_27008":51928,"_2880":51929},[],"/docs/platform/iot-fleets/enrollment/renewal-and-recovery#install-and-check-the-new-pair","Install and check the new pair",{"_3394":1142,"_29710":1137,"_5":30039,"_20617":51931,"_27008":51932,"_2880":51933},[],"/docs/platform/iot-fleets/enrollment/renewal-and-recovery#recover-according-to-state","Recover according to state",{"_3394":1143,"_29710":1137,"_5":30039,"_20617":51935,"_27008":51936,"_2880":51937},[],"/docs/platform/iot-fleets/enrollment/renewal-and-recovery#continuous-operation","Continuous operation",{"_3394":1144,"_29710":1137,"_20617":51939,"_5":14139,"_27008":1137,"_2880":51940},[],"Renewal retains the device identifier and requests a successor certificate. The client must complete the process: check the response, install the matching pair and demonstrate that the consumer accepts it. Lamassu alerts notify you; they do not perform those steps.",{"_3394":1145,"_29710":1137,"_20617":51942,"_5":14139,"_27008":51920,"_2880":51943},[],"Query the current certificate in Lamassu and compare it with the installed certificate. You need its subject, serial and dates, as well as the client key.",{"_3394":1146,"_29710":1137,"_20617":51945,"_5":14139,"_27008":51920,"_2880":51946},[],"Check the **re-enrollment** authentication mode: it is independent of initial authentication. With `CLIENT_CERTIFICATE`, use the current identity; do not assume the bootstrap credential is admitted.",{"_3394":1147,"_29710":1137,"_20617":51948,"_5":14139,"_27008":51920,"_2880":51949},[],"Calculate the window's start: the current certificate's `NotAfter` minus `reenrollment_delta`. Preventive and critical thresholds produce states/notifications; they do not extend that window.",{"_3394":1148,"_29710":1137,"_20617":51951,"_5":14139,"_27008":51920,"_2880":51952},[],"Review **Revoke on Re-enrollment** and recovery if installation fails. When enabled, Lamassu can revoke the previous identity before the client installs the new one.",{"_3394":1149,"_29710":1137,"_20617":51954,"_5":14139,"_27008":51924,"_2880":51955},[],"The example continues the EST tutorial, in the same Bash session with `set -euo pipefail`, `umask 077` and `EST_BASE`. Use a new key compatible with the profile. Conversion from the certificate preserves the subject and copies only SAN when present; check the subject and requested names before sending it. The backend checks the subject against the current identity: it attempts RawSubject equality and then compares CN, OU, O, L, ST and C. Rebuilding only the CN can lose required attributes.",{"_3394":1150,"_29710":1137,"_20617":51957,"_5":14139,"_27008":51924,"_2880":51958},[],"The request authenticates with `device.crt` and `device.key`; the CSR contains the new public key. Also check extensions, dates and correspondence of the serial with the current slot in Lamassu. Do not resubmit a failed request without querying that state: issuance, previous revocation and successor binding can have partial results.",{"_3394":1151,"_29710":1137,"_20617":51960,"_5":14139,"_27008":51928,"_2880":51961},[],"Keep the result as `device.next.crt` and `device.next.key` until verified. Switch the pair through a coordinated operation in the device store or configuration; avoid temporarily exposing a certificate with another version's key.",{"_3394":1152,"_29710":1137,"_20617":51963,"_5":14139,"_27008":51928,"_2880":51964},[],"Test mTLS with the consumer and verify that it uses the new serial. Confirm the history and current certificate in Lamassu. If **Revoke on Re-enrollment** was disabled, the previous identity can remain valid: retire it according to PKI policy after testing the successor, and check revocation publication and consumption.",{"_3394":1153,"_29710":1137,"_20617":51966,"_5":14139,"_27008":51928,"_2880":51967},[],"If the previous identity is already revoked, retaining its files does not restore a valid connection. Recovery requires an admitted credential and authorized intervention according to the situation.",{"_3394":1154,"_29710":1137,"_20617":51969,"_5":14139,"_27008":51932,"_2880":51970},[],"Situation",{"_3394":1155,"_29710":1137,"_20617":51972,"_5":14139,"_27008":51932,"_2880":51973},[],"Procedure",{"_3394":1156,"_29710":1137,"_20617":51975,"_5":14139,"_27008":51932,"_2880":51976},[],"Valid certificate, outside the window",{"_3394":1157,"_29710":1137,"_20617":51978,"_5":14139,"_27008":51932,"_2880":51979},[],"Schedule the request within the window. Do not use `simpleenroll` to bypass it.",{"_3394":1158,"_29710":1137,"_20617":51981,"_5":14139,"_27008":51932,"_2880":51982},[],"Expired certificate, key available",{"_3394":1159,"_29710":1137,"_20617":51984,"_5":14139,"_27008":51932,"_2880":51985},[],"With certificate authentication, review `enable_expired_renewal` and whether Gateway permits presenting that credential. Revocation, subject and the remaining checks still apply.",{"_3394":1160,"_29710":1137,"_20617":51987,"_5":14139,"_27008":51932,"_2880":51988},[],"Renewal through webhook or `NO_AUTH`",{"_3394":1161,"_29710":1137,"_20617":51990,"_5":14139,"_27008":51932,"_2880":51991},[],"The mTLS expiry check does not run in these modes. Define expiry and authorization policy in the corresponding admission process; the flag is not a universal prohibition.",{"_3394":1162,"_29710":1137,"_20617":51993,"_5":14139,"_27008":51932,"_2880":51994},[],"Lost or inaccessible key",{"_3394":1163,"_29710":1137,"_20617":51996,"_5":14139,"_27008":51932,"_2880":51997},[],"You cannot prove possession of the previous identity. Authorize new admission and, if appropriate, controlled replacement; revoke the compromised identity.",{"_3394":1164,"_29710":1137,"_20617":51999,"_5":14139,"_27008":51932,"_2880":52000},[],"Current identity revoked",{"_3394":1165,"_29710":1137,"_20617":52002,"_5":14139,"_27008":51932,"_2880":52003},[],"`simplereenroll` rejects the revoked current certificate. Investigate the reason and prepare an authorized readmission procedure; do not disable authentication to force it.",{"_3394":1166,"_29710":1137,"_20617":52005,"_5":14139,"_27008":51932,"_2880":52006},[],"Device without an identity",{"_3394":1167,"_29710":1137,"_20617":52008,"_5":14139,"_27008":51932,"_2880":52009},[],"Use initial enrollment. For an existing entry, check the replacement restriction in provisioning.",{"_3394":1168,"_29710":1137,"_20617":52011,"_5":14139,"_27008":51932,"_2880":52012},[],"Retired device",{"_3394":1169,"_29710":1137,"_20617":52014,"_5":14139,"_27008":51932,"_2880":52015},[],"Review the operational decision before readmission. Decommissioned state and revocation of the entire history are not equivalent.",{"_3394":1170,"_29710":1137,"_20617":52017,"_5":14139,"_27008":51932,"_2880":52018},[],"Timeout, HTTP 500 or installation failure",{"_3394":1171,"_29710":1137,"_20617":52020,"_5":14139,"_27008":51932,"_2880":52021},[],"Inspect the device, issued certificates and history before retrying. A successor may have been issued or the previous identity revoked.",{"_3394":1172,"_29710":1137,"_20617":52023,"_5":14139,"_27008":51936,"_2880":52024},[],"Schedule renewal with time for disconnections, trust distribution and consumer checks. Stagger requests across the population and bound retries within the window; authentication, subject and policy errors require correcting their cause. Maintain an admitted and tested recovery mechanism for lost keys and pairs that could not be installed.",{"_3394":1173,"_29710":1137,"_20617":52026,"_5":14139,"_27008":51936,"_2880":52027},[],"Continue with Trust distribution, Devices and identities and Troubleshooting.",{"_3394":1174,"_29710":1174,"_5":14491,"_2880":52029,"_30042":52030,"_20617":52031,"_27008":1174},"Enrollment troubleshooting",[48369,49837,50848,50846,51029],[],{"_3394":1175,"_29710":1174,"_20617":52033,"_5":14139,"_27008":1174,"_2880":52034},[],"Locate transport, authentication, registration, issuance and installation failures.",{"_3394":1176,"_29710":1174,"_5":30039,"_20617":52036,"_27008":52037,"_2880":52038},[],"/docs/platform/iot-fleets/enrollment/troubleshooting#diagnostics-and-compatibility","Diagnostics and compatibility",{"_3394":1177,"_29710":1174,"_5":30039,"_20617":52040,"_27008":52041,"_2880":52042},[],"/docs/platform/iot-fleets/enrollment/troubleshooting#error-codes-and-diagnostics","Error codes and diagnostics",{"_3394":1178,"_29710":1174,"_5":30039,"_20617":52044,"_27008":52045,"_2880":51592},[],"/docs/platform/iot-fleets/enrollment/troubleshooting#compatibility-notes",{"_3394":1179,"_29710":1174,"_5":30039,"_20617":52047,"_27008":52048,"_2880":52049},[],"/docs/platform/iot-fleets/enrollment/troubleshooting#est-enrollment-fails","EST enrollment fails",{"_3394":1180,"_29710":1174,"_20617":52051,"_5":14139,"_27008":1174,"_2880":52052},[],"Diagnose one operation and device at a time. Record the DMS/APS, endpoint, time, HTTP code, presented serial and CSR CN. Retain the response without including private keys or webhook credentials in the report.",{"_3394":1181,"_29710":1174,"_20617":52054,"_5":14139,"_27008":52041,"_2880":52055},[],"The EST controller normally returns 400 when rejecting input and 500 when the service rejects or fails the operation. A 500 can also represent a policy denial; it does not mean retrying is safe. Gateway can produce its own codes and bodies. Examine the actual body and persisted result.",{"_3394":1182,"_29710":1174,"_20617":52057,"_5":14139,"_27008":52041,"_2880":52058},[],"Symptom or message",{"_3394":1183,"_29710":1174,"_20617":52060,"_5":14139,"_27008":52041,"_2880":51822},[],{"_3394":1184,"_29710":1174,"_20617":52062,"_5":14139,"_27008":52041,"_2880":52063},[],"curl rejects TLS, name or issuer",{"_3394":1185,"_29710":1174,"_20617":52065,"_5":14139,"_27008":52041,"_2880":52066},[],"URL, clock, server SAN and approved root in `est-trust.pem`. Resolve trust in Deployment; do not skip verification.",{"_3394":1186,"_29710":1174,"_20617":52068,"_5":14139,"_27008":52041,"_2880":52069},[],"404 or missing APS",{"_3394":1187,"_29710":1174,"_20617":52071,"_5":14139,"_27008":52041,"_2880":52072},[],"Public route `/.well-known/est/{DMS_ID}/{operation}` and existing DMS. APS is not the service name.",{"_3394":1188,"_29710":1174,"_20617":52074,"_5":14139,"_27008":52041,"_2880":52075},[],"400, CSR or format error",{"_3394":1189,"_29710":1174,"_20617":52077,"_5":14139,"_27008":52041,"_2880":52078},[],"`Content-Type: application/pkcs10`, Base64 of DER, valid signature and a body preserved without double encoding.",{"_3394":1190,"_29710":1174,"_20617":52080,"_5":14139,"_27008":52041,"_2880":52081},[],"Missing credential or invalid certificate",{"_3394":1191,"_29710":1174,"_20617":52083,"_5":14139,"_27008":52041,"_2880":52084},[],"Operation mode, validating CA, dates, revocation and credential delivery by Gateway. Do not confuse server TLS trust with the bootstrap CA.",{"_3394":1192,"_29710":1174,"_20617":52086,"_5":14139,"_27008":52041,"_2880":52087},[],"Webhook denies, times out or responds without authorization",{"_3394":1193,"_29710":1174,"_20617":52089,"_5":14139,"_27008":52041,"_2880":52090},[],"Configuration, connectivity and JSON response with `authorized: true`. There is no automatic fallback to `NO_AUTH`.",{"_3394":1194,"_29710":1174,"_20617":52092,"_5":14139,"_27008":52041,"_2880":52093},[],"`unexpected status code: <n>: redirects are not followed`",{"_3394":1195,"_29710":1174,"_20617":52095,"_5":14139,"_27008":52041,"_2880":52096},[],"The webhook answered with a redirect. Configure the final absolute `http` or `https` URL in the webhook config; redirects are never followed.",{"_3394":1196,"_29710":1174,"_20617":52098,"_5":14139,"_27008":52041,"_2880":52099},[],"`webhook response exceeds 1048576 bytes`",{"_3394":1197,"_29710":1174,"_20617":52101,"_5":14139,"_27008":52041,"_2880":52102},[],"The receiver returned more than 1 MiB of JSON. Reduce the response of the authorization webhook.",{"_3394":1198,"_29710":1174,"_20617":52104,"_5":14139,"_27008":52041,"_2880":52105},[],"`webhook config must not reference files`",{"_3394":1199,"_29710":1174,"_20617":52107,"_5":14139,"_27008":52041,"_2880":52108},[],"The webhook config points to files (`ca_cert_file`, `mtls_options.cert_file`, `mtls_options.key_file`). For mTLS, enter the certificate and key as Base64-encoded PEM in `cert_content` and `key_content`, or as plain PEM; remove any other file field, including `ca_cert_file`, which has no inline equivalent (the receiver certificate must chain to the system trust store). See the webhook credentials guidance in DMS.",{"_3394":1200,"_29710":1174,"_20617":52110,"_5":14139,"_27008":52041,"_2880":52111},[],"`mtls_options.cert_content must be base64-encoded PEM`",{"_3394":1201,"_29710":1174,"_20617":52113,"_5":14139,"_27008":52041,"_2880":52114},[],"The value is neither Base64-encoded PEM nor plain PEM: it is a file path or Base64 of non-PEM data. Enter the certificate and key as Base64-encoded PEM, like certificates elsewhere in the API, or as plain PEM (see the webhook settings in DMS). The same message names `mtls_options.key_content` when the key is the offending value.",{"_3394":1202,"_29710":1174,"_20617":52116,"_5":14139,"_27008":52041,"_2880":52117},[],"`webhook mTLS certificate and key are invalid: …`",{"_3394":1203,"_29710":1174,"_20617":52119,"_5":14139,"_27008":52041,"_2880":52120},[],"The certificate and key do not form a matching pair. Enter both values from the same pair; the check runs when the DMS is saved and again on every webhook call.",{"_3394":1204,"_29710":1174,"_20617":52122,"_5":14139,"_27008":52041,"_2880":52123},[],"400 `struct validation error` creating or updating a DMS",{"_3394":1205,"_29710":1174,"_20617":52125,"_5":14139,"_27008":52041,"_2880":52126},[],"The webhook config of the operation that uses it is invalid. Review `external_webhook_settings` in DMS.",{"_3394":1206,"_29710":1174,"_20617":52128,"_5":14139,"_27008":52041,"_2880":52129},[],"HTTP 500 with an `err` body on enroll or reenroll",{"_3394":1207,"_29710":1174,"_20617":52131,"_5":14139,"_27008":52041,"_2880":52132},[],"Service failures reach the EST client as 500 with a body of `err` plus the message; webhook authorization errors are named there.",{"_3394":1208,"_29710":1174,"_20617":52134,"_5":14139,"_27008":52041,"_2880":52135},[],"`device not preregistered`",{"_3394":1209,"_29710":1174,"_20617":52137,"_5":14139,"_27008":52041,"_2880":52138},[],"PRE\\_REGISTRATION requires an existing inventory entry.",{"_3394":1210,"_29710":1174,"_20617":52140,"_5":14139,"_27008":52041,"_2880":52141},[],"`forbiddenNewEnrollment`",{"_3394":1211,"_29710":1174,"_20617":52143,"_5":14139,"_27008":52041,"_2880":52144},[],"An existing device requires replacement to be enabled, even in No Identity. Investigate before enabling the flag.",{"_3394":1212,"_29710":1174,"_20617":52146,"_5":14139,"_27008":52041,"_2880":52147},[],"Different owning DMS",{"_3394":1213,"_29710":1174,"_20617":52149,"_5":14139,"_27008":52041,"_2880":52150},[],"CN/ID, global inventory and owning DMS; do not reuse an ID from another context.",{"_3394":1214,"_29710":1174,"_20617":52152,"_5":14139,"_27008":52041,"_2880":52153},[],"`invalid RawSubject bytes`",{"_3394":1215,"_29710":1174,"_20617":52155,"_5":14139,"_27008":52041,"_2880":52156},[],"CSR subject versus the current certificate. Preserve its attributes as well as its CN.",{"_3394":1216,"_29710":1174,"_20617":52158,"_5":14139,"_27008":52041,"_2880":52159},[],"`invalid reenroll window`",{"_3394":1217,"_29710":1174,"_20617":52161,"_5":14139,"_27008":52041,"_2880":52162},[],"Current identity's NotAfter and reenrollment\\_delta. Alert thresholds do not change that window.",{"_3394":1218,"_29710":1174,"_20617":52164,"_5":14139,"_27008":52041,"_2880":52165},[],"Current certificate revoked",{"_3394":1219,"_29710":1174,"_20617":52167,"_5":14139,"_27008":52041,"_2880":52168},[],"Renewal rejected; prepare authorized recovery according to the cause.",{"_3394":1220,"_29710":1174,"_20617":52170,"_5":14139,"_27008":52041,"_2880":52171},[],"CA, profile or signing error",{"_3394":1221,"_29710":1174,"_20617":52173,"_5":14139,"_27008":52041,"_2880":52174},[],"Active CA, available key, selected profile and restrictions. Successful cacerts does not prove issuance.",{"_3394":1222,"_29710":1174,"_20617":52176,"_5":14139,"_27008":52041,"_2880":52177},[],"HTTP 200 without a device connection",{"_3394":1223,"_29710":1174,"_20617":52179,"_5":14139,"_27008":52041,"_2880":52180},[],"Installed pair, chain, uses, consumer trust and permissions. Also check the slot and history.",{"_3394":1224,"_29710":1174,"_20617":52182,"_5":14139,"_27008":52041,"_2880":52183},[],"Timeout or error after issuance",{"_3394":1225,"_29710":1174,"_20617":52185,"_5":14139,"_27008":52041,"_2880":52186},[],"New certificates, current slot and previous identity's state before retrying.",{"_3394":1226,"_29710":1174,"_20617":52188,"_5":14139,"_27008":52045,"_2880":52189},[],"The examples use the contract of the examined backend. Do not automatically attribute that behavior to another release. Check the saved renewal mode and Gateway behavior with expired certificates and the bootstrap CA.",{"_3394":1227,"_29710":1174,"_20617":52191,"_5":14139,"_27008":52045,"_2880":52192},[],"The default response is Base64-encoded DER PKCS#7; PEM through `Accept: application/x-pem-file` is a Lamassu extension. ServerKeyGen returns multipart and requires handling each part separately. See the EST reference.",{"_3394":1228,"_29710":1174,"_20617":52194,"_5":14139,"_27008":52048,"_2880":52195},[],"Check HTTPS with the approved root and query cacerts for the correct APS.",{"_3394":1229,"_29710":1174,"_20617":52197,"_5":14139,"_27008":52048,"_2880":52198},[],"Review the saved DMS: protocol, registration, authentication for that operation, CA, profile and window.",{"_3394":1230,"_29710":1174,"_20617":52200,"_5":14139,"_27008":52048,"_2880":52201},[],"Verify the CSR locally and relate its CN to the inventory.",{"_3394":1231,"_29710":1174,"_20617":52203,"_5":14139,"_27008":52048,"_2880":52204},[],"Make one request, save headers/body and query the device and certificates.",{"_3394":1232,"_29710":1174,"_20617":52206,"_5":14139,"_27008":52048,"_2880":52207},[],"If you receive an identity, check the key, subject, use and connection with the consumer.",{"_3394":1233,"_29710":1174,"_20617":52209,"_5":14139,"_27008":52048,"_2880":52210},[],"External bootstrap revocation checks have limitations: absence of evidence can be accepted, and OCSP Unknown does not cause the same rejection as Revoked. Do not assume a policy that rejects every uncertainty. An intermediate CA in the TLS chain does not prove that the entire chain reached the DMS validator either.",{"_3394":1234,"_29710":1174,"_20617":52212,"_5":14139,"_27008":52048,"_2880":52213},[],"For logs, networking, pods or Gateway headers, continue in Deployment troubleshooting. For identities issued, revoked or bound partially, use Renewal and recovery and Devices and identities.",{"_3394":1235,"_29710":1235,"_5":14491,"_2880":52215,"_30042":52216,"_20617":52217,"_27008":1235},"Trust distribution and updates",[48369,49837,50848,50846,51029],[],{"_3394":1236,"_29710":1235,"_20617":52219,"_5":14139,"_27008":1235,"_2880":52220},[],"Separate roots, intermediates and initial TLS trust when distributing or migrating certificates.",{"_3394":1237,"_29710":1235,"_5":30039,"_20617":52222,"_27008":52223,"_2880":52224},[],"/docs/platform/iot-fleets/enrollment/trust-distribution#three-trust-relationships","Three trust relationships",{"_3394":1238,"_29710":1235,"_5":30039,"_20617":52226,"_27008":52227,"_2880":52228},[],"/docs/platform/iot-fleets/enrollment/trust-distribution#what-cacerts-returns","What cacerts returns",{"_3394":1239,"_29710":1235,"_5":30039,"_20617":52230,"_27008":52231,"_2880":52232},[],"/docs/platform/iot-fleets/enrollment/trust-distribution#install-the-required-material","Install the required material",{"_3394":1240,"_29710":1235,"_5":30039,"_20617":52234,"_27008":52235,"_2880":52236},[],"/docs/platform/iot-fleets/enrollment/trust-distribution#migrate-trust","Migrate trust",{"_3394":1241,"_29710":1235,"_5":30039,"_20617":52238,"_27008":52239,"_2880":52240},[],"/docs/platform/iot-fleets/enrollment/trust-distribution#check-the-update","Check the update",{"_3394":1242,"_29710":1235,"_20617":52242,"_5":14139,"_27008":1235,"_2880":52243},[],"This guide is for device and consumer trust administrators. You need issuer inventory, trust-store access and an authenticated update channel. Distributing certificates is separate from choosing trusted anchors.",{"_3394":1243,"_29710":1235,"_20617":52245,"_5":14139,"_27008":52223,"_2880":52246},[],"Relationship",{"_3394":1244,"_29710":1235,"_20617":52248,"_5":14139,"_27008":52223,"_2880":52249},[],"Material prepared by its owner",{"_3394":1245,"_29710":1235,"_20617":52251,"_5":14139,"_27008":52223,"_2880":52252},[],"Device → EST server",{"_3394":1246,"_29710":1235,"_20617":52254,"_5":14139,"_27008":52223,"_2880":52255},[],"Previously verified server root, chain or pin and TLS name.",{"_3394":1247,"_29710":1235,"_20617":52257,"_5":14139,"_27008":52223,"_2880":52258},[],"DMS → requester",{"_3394":1248,"_29710":1235,"_20617":52260,"_5":14139,"_27008":52223,"_2880":52261},[],"CAs and rules authorizing initial or renewal credentials.",{"_3394":1249,"_29710":1235,"_20617":52263,"_5":14139,"_27008":52223,"_2880":52264},[],"Consumer → device",{"_3394":1250,"_29710":1235,"_20617":52266,"_5":14139,"_27008":52223,"_2880":52267},[],"Operational identity roots, intermediates, validation and permissions.",{"_3394":1251,"_29710":1235,"_20617":52269,"_5":14139,"_27008":52223,"_2880":52270},[],"Obtaining a certificate does not automatically configure these relationships in third parties. Review the Trust model.",{"_3394":1252,"_29710":1235,"_20617":52272,"_5":14139,"_27008":52227,"_2880":52273},[],"The DMS may include the available downstream TLS certificate, selected Managed CAs and enrollment CA. Selecting the issuer does not include every ancestor. The set may contain leaves, roots and intermediates, including multiple hierarchies during migration.",{"_3394":1253,"_29710":1235,"_20617":52275,"_5":14139,"_27008":52227,"_2880":52276},[],"Position does not define the chain. Identify certificates by subject, issuer, AKI/SKI, signature and constraints. Download and inspect using EST client.",{"_3394":1254,"_29710":1235,"_20617":52278,"_5":14139,"_27008":52231,"_2880":52279},[],"Keep initial EST server trust separate from identity consumer trust.",{"_3394":1255,"_29710":1235,"_20617":52281,"_5":14139,"_27008":52231,"_2880":52282},[],"Select policy-approved roots as anchors.",{"_3394":1256,"_29710":1235,"_20617":52284,"_5":14139,"_27008":52231,"_2880":52285},[],"Retain intermediates for chain building or presentation; do not automatically turn them into roots.",{"_3394":1257,"_29710":1235,"_20617":52287,"_5":14139,"_27008":52231,"_2880":52288},[],"Present the leaf and required intermediates in mTLS. Normally the peer already trusts its root and does not need it sent.",{"_3394":1258,"_29710":1235,"_20617":52290,"_5":14139,"_27008":52231,"_2880":52291},[],"Verify chain, dates, names, usages and revocation from the consumer.",{"_3394":1259,"_29710":1235,"_20617":52293,"_5":14139,"_27008":52231,"_2880":52294},[],"Do not indiscriminately use all of `cacerts.pem` as `-CAfile`: this can expand trusted authorities, hide missing intermediates or trust a TLS leaf intended for another purpose.",{"_3394":1260,"_29710":1235,"_20617":52296,"_5":14139,"_27008":52235,"_2880":52297},[],"Before changing Enrollment CA, inventory disconnected equipment, bootstrap and operational certificates, and consumers. Distribute the new root and required intermediates; check that a cohort accepts both old and new chains.",{"_3394":1261,"_29710":1235,"_20617":52299,"_5":14139,"_27008":52235,"_2880":52300},[],"In the DMS, separate distributed CAs from the re-enrollment validation CAs at `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`, used for re-enrollment credentials. That list is optional because the enrollment CA always validates re-enrollment credentials, but when switching the enrollment CA, add the previous issuance CA to it so old-CA identities keep re-enrolling during overlap. The inspected validator tries the enrollment CA followed by those CAs against the received leaf; accepting a multilevel chain requires checking what reaches the service and which issuer is configured.",{"_3394":1262,"_29710":1235,"_20617":52302,"_5":14139,"_27008":52235,"_2880":52303},[],"Switch issuance, renew in cohorts and compare the installed serial with the active slot. Remove previous trust once no legitimate equipment needs it and policy permits ending overlap. Follow Hierarchy and rotation for the PKI operation.",{"_3394":1263,"_29710":1235,"_20617":52305,"_5":14139,"_27008":52239,"_2880":52306},[],"Test an old identity allowed during overlap, a new one, an unknown chain and the result after removing old trust. Keep trust-store version, approved set, date and result. Reachable `/cacerts` establishes distribution only; it does not establish installation or acceptance across every device.",{"_3394":1264,"_29710":1264,"_5":14491,"_2880":52308,"_30042":52309,"_20617":52311,"_27008":1264},"AWS IoT Core",[48369,49837,50848,50846,52310],"Integrations",[],{"_3394":1265,"_29710":1264,"_20617":52313,"_5":14139,"_27008":1264,"_2880":52314},[],"Lamassu's connector for AWS IoT Core syncs device identities with the AWS platform, handling CA registration, Thing provisioning and certificate lifecycle automatically and event-driven.",{"_3394":1266,"_29710":1264,"_5":30039,"_20617":52316,"_27008":52317,"_2880":52318},[],"/docs/platform/iot-fleets/integrations/aws-iot-core#connector-architecture","Connector architecture",{"_3394":1267,"_29710":1264,"_5":30039,"_20617":52320,"_27008":52321,"_2880":52322},[],"/docs/platform/iot-fleets/integrations/aws-iot-core#prerequisites","Prerequisites",{"_3394":1268,"_29710":1264,"_5":30039,"_20617":52324,"_27008":52325,"_2880":52326},[],"/docs/platform/iot-fleets/integrations/aws-iot-core#required-iam-permissions","Required IAM permissions",{"_3394":1269,"_29710":1264,"_5":30039,"_20617":52328,"_27008":52329,"_2880":52330},[],"/docs/platform/iot-fleets/integrations/aws-iot-core#configuration-parameters","Configuration parameters",{"_3394":1270,"_29710":1264,"_5":30039,"_20617":52332,"_27008":52333,"_2880":52334},[],"/docs/platform/iot-fleets/integrations/aws-iot-core#events-and-aws-resources","Events and AWS resources",{"_3394":1271,"_29710":1264,"_5":30039,"_20617":52336,"_27008":52337,"_2880":52338},[],"/docs/platform/iot-fleets/integrations/aws-iot-core#ca-registration-in-aws-iot-core","CA registration in AWS IoT Core",{"_3394":1272,"_29710":1264,"_5":30039,"_20617":52340,"_27008":52341,"_2880":52342},[],"/docs/platform/iot-fleets/integrations/aws-iot-core#how-to-request-registration","How to request registration",{"_3394":1273,"_29710":1264,"_5":30039,"_20617":52344,"_27008":52345,"_2880":52346},[],"/docs/platform/iot-fleets/integrations/aws-iot-core#ca-registration-states","CA registration states",{"_3394":1274,"_29710":1264,"_5":30039,"_20617":52348,"_27008":52349,"_2880":52350},[],"/docs/platform/iot-fleets/integrations/aws-iot-core#primary-account","Primary Account",{"_3394":1275,"_29710":1264,"_5":30039,"_20617":52352,"_27008":52353,"_2880":52354},[],"/docs/platform/iot-fleets/integrations/aws-iot-core#secondary-account-sni-only","Secondary Account (SNI-only)",{"_3394":1276,"_29710":1264,"_5":30039,"_20617":52356,"_27008":52357,"_2880":52358},[],"/docs/platform/iot-fleets/integrations/aws-iot-core#dms-configuration","DMS configuration",{"_3394":1277,"_29710":1264,"_5":30039,"_20617":52360,"_27008":52361,"_2880":52362},[],"/docs/platform/iot-fleets/integrations/aws-iot-core#none-mode","`none` mode",{"_3394":1278,"_29710":1264,"_5":30039,"_20617":52364,"_27008":52365,"_2880":52366},[],"/docs/platform/iot-fleets/integrations/aws-iot-core#auto-mode","`auto` mode",{"_3394":1279,"_29710":1264,"_5":30039,"_20617":52368,"_27008":52369,"_2880":52370},[],"/docs/platform/iot-fleets/integrations/aws-iot-core#jitp-mode","`jitp` mode",{"_3394":1280,"_29710":1264,"_5":30039,"_20617":52372,"_27008":52373,"_2880":52374},[],"/docs/platform/iot-fleets/integrations/aws-iot-core#dms-registration-mode-states","DMS registration-mode states",{"_3394":1281,"_29710":1264,"_5":30039,"_20617":52376,"_27008":52377,"_2880":52378},[],"/docs/platform/iot-fleets/integrations/aws-iot-core#device-provisioning-automatic-mode","Device provisioning (automatic mode)",{"_3394":1282,"_29710":1264,"_5":30039,"_20617":52380,"_27008":52381,"_2880":52382},[],"/docs/platform/iot-fleets/integrations/aws-iot-core#thing-lifecycle","Thing lifecycle",{"_3394":1283,"_29710":1264,"_5":30039,"_20617":52384,"_27008":52385,"_2880":52386},[],"/docs/platform/iot-fleets/integrations/aws-iot-core#device-provisioning-jitp-mode","Device provisioning (JITP mode)",{"_3394":1284,"_29710":1264,"_5":30039,"_20617":52388,"_27008":52389,"_2880":52390},[],"/docs/platform/iot-fleets/integrations/aws-iot-core#certificate-status-synchronization","Certificate status synchronization",{"_3394":1285,"_29710":1264,"_5":30039,"_20617":52392,"_27008":52393,"_2880":52394},[],"/docs/platform/iot-fleets/integrations/aws-iot-core#certificate-status-states","Certificate status states",{"_3394":1286,"_29710":1264,"_5":30039,"_20617":52396,"_27008":52397,"_2880":52398},[],"/docs/platform/iot-fleets/integrations/aws-iot-core#forced-disconnect-on-revocation","Forced disconnect on revocation",{"_3394":1287,"_29710":1264,"_5":30039,"_20617":52400,"_27008":52401,"_2880":52402},[],"/docs/platform/iot-fleets/integrations/aws-iot-core#device-shadow-and-automation","Device Shadow and automation",{"_3394":1288,"_29710":1264,"_5":30039,"_20617":52404,"_27008":52405,"_2880":52406},[],"/docs/platform/iot-fleets/integrations/aws-iot-core#what-the-connector-writes-to-the-shadow","What the connector writes to the shadow",{"_3394":1289,"_29710":1264,"_5":30039,"_20617":52408,"_27008":52409,"_2880":52410},[],"/docs/platform/iot-fleets/integrations/aws-iot-core#aws-iot-policies","AWS IoT policies",{"_3394":1290,"_29710":1264,"_5":30039,"_20617":52412,"_27008":52413,"_2880":52414},[],"/docs/platform/iot-fleets/integrations/aws-iot-core#troubleshooting","Troubleshooting",{"_3394":1291,"_29710":1264,"_20617":52416,"_5":14139,"_27008":1264,"_2880":52417},[],"Lamassu's integration with AWS IoT Core bridges the PKI managed by Lamassu and AWS's connectivity platform. When a device obtains its certificate through the EST enrollment process, the connector ensures that certificate and its associated identity are recognized in AWS IoT Core without manual intervention. The result is that the device can authenticate directly to AWS with the same X.509 certificate Lamassu issued.",{"_3394":1292,"_29710":1264,"_20617":52419,"_5":14139,"_27008":1264,"_2880":52420},[],"From a protocol standpoint, the device authenticates to AWS IoT Core via mutual TLS (mTLS): it presents its Lamassu-issued X.509 certificate as the client certificate, and AWS IoT Core verifies the certificate chain up to the CA registered in the account. Lamassu acts as the certification authority (CA); the connector ensures that CA is registered in AWS and that the device's certificate is known to the platform before the device attempts to connect (in `auto` mode) or on its first connection (in JITP mode).",{"_3394":1293,"_29710":1264,"_20617":52422,"_5":14139,"_27008":1264,"_2880":52423},[],"This document is aimed both at the PKI administrator, who needs to configure the connector and register CAs, and at the device firmware developer, who needs to understand how Things are named, how the Device Shadow works and what happens when a certificate is revoked. For the firmware developer, the most important fact is that **the AWS Thing name (ThingName) always corresponds to the Common Name (CN) of the certificate issued by Lamassu**, regardless of the provisioning mode.",{"_3394":1294,"_29710":1264,"_20617":52425,"_5":14139,"_27008":52317,"_2880":52426},[],"The AWS IoT Core connector is an independent Go process, a binary or container separate from Lamassu's core. In a monolithic deployment it is compiled by default (build tag `!noaws`) and activated with `aws_iot_manager.enabled: true` in the configuration file. In distributed deployments, it runs as its own container with access to Lamassu's CA, DMS Manager and Device Manager services over HTTP.",{"_3394":1295,"_29710":1264,"_20617":52428,"_5":14139,"_27008":52317,"_2880":52429},[],"The connector does not poll Lamassu's services periodically. Instead, it **subscribes to Lamassu's internal event bus** (AMQP or AWS SQS/SNS, configurable) and reacts to the events it cares about: CA creation or update, DMS creation or update, device identity binding, certificate status change, certificate metadata update and device metadata update. This event-driven model ensures synchronization with AWS is nearly immediate and produces no polling load.",{"_3394":1296,"_29710":1264,"_20617":52431,"_5":14139,"_27008":52317,"_2880":52432},[],"To avoid infinite loops, the connector ignores any event whose CloudEvent `source` field matches its own origin URI. This prevents the metadata writes the connector itself performs from re-triggering the same flow.",{"_3394":1297,"_29710":1264,"_20617":52434,"_5":14139,"_27008":52317,"_2880":52435},[],"When several connectors run in parallel, for example for different AWS accounts, each instance has its own `connector_id`. All metadata the connector writes to Lamassu is stored under the key `lamassu.io/iot/{connector_id}`, allowing coexistence without collisions.",{"_3394":1298,"_29710":1264,"_20617":52437,"_5":14139,"_27008":52321,"_2880":52438},[],"Before enabling the connector you need an AWS account with the proper IAM permissions and the connector correctly configured. The deployment process (Docker Compose, Kubernetes or binary) is described in the deployment documentation.",{"_3394":1299,"_29710":1264,"_20617":52440,"_5":14139,"_27008":52325,"_2880":52441},[],"The IAM identity operating the connector needs at minimum the following permissions on the target account's resources:",{"_3394":1300,"_29710":1264,"_20617":52443,"_5":14139,"_27008":52325,"_2880":52444},[],"IAM action",{"_3394":1301,"_29710":1264,"_20617":52446,"_5":14139,"_27008":52325,"_2880":48759},[],{"_3394":1302,"_29710":1264,"_20617":52448,"_5":14139,"_27008":52325,"_2880":52449},[],"`iot:GetRegistrationCode`",{"_3394":1303,"_29710":1264,"_20617":52451,"_5":14139,"_27008":52325,"_2880":52452},[],"Obtain the verification code for CA registration in the Primary Account",{"_3394":1304,"_29710":1264,"_20617":52454,"_5":14139,"_27008":52325,"_2880":52455},[],"`iot:RegisterCACertificate`",{"_3394":1305,"_29710":1264,"_20617":52457,"_5":14139,"_27008":52325,"_2880":52458},[],"Register the CA in AWS IoT",{"_3394":1306,"_29710":1264,"_20617":52460,"_5":14139,"_27008":52325,"_2880":52461},[],"`iot:DescribeCACertificate`",{"_3394":1307,"_29710":1264,"_20617":52463,"_5":14139,"_27008":52325,"_2880":52464},[],"Check the CA registration status",{"_3394":1308,"_29710":1264,"_20617":52466,"_5":14139,"_27008":52325,"_2880":52467},[],"`iot:CreateThing` / `iot:UpdateThing`",{"_3394":1309,"_29710":1264,"_20617":52469,"_5":14139,"_27008":52325,"_2880":52470},[],"Create or update Things in IoT Core",{"_3394":1310,"_29710":1264,"_20617":52472,"_5":14139,"_27008":52325,"_2880":52473},[],"`iot:RegisterThing`",{"_3394":1311,"_29710":1264,"_20617":52475,"_5":14139,"_27008":52325,"_2880":52476},[],"Provision Things through a template",{"_3394":1312,"_29710":1264,"_20617":52478,"_5":14139,"_27008":52325,"_2880":52479},[],"`iot:RegisterCertificate`",{"_3394":1313,"_29710":1264,"_20617":52481,"_5":14139,"_27008":52325,"_2880":52482},[],"Register device certificates",{"_3394":1314,"_29710":1264,"_20617":52484,"_5":14139,"_27008":52325,"_2880":52485},[],"`iot:UpdateCertificate`",{"_3394":1315,"_29710":1264,"_20617":52487,"_5":14139,"_27008":52325,"_2880":52488},[],"Change a certificate's status (ACTIVE / INACTIVE / REVOKED)",{"_3394":1316,"_29710":1264,"_20617":52490,"_5":14139,"_27008":52325,"_2880":52491},[],"`iot:CreatePolicy` / `iot:AttachPolicy`",{"_3394":1317,"_29710":1264,"_20617":52493,"_5":14139,"_27008":52325,"_2880":52494},[],"Create and attach IoT policies",{"_3394":1318,"_29710":1264,"_20617":52496,"_5":14139,"_27008":52325,"_2880":52497},[],"`iot:CreateThingGroup` / `iot:AddThingToThingGroup`",{"_3394":1319,"_29710":1264,"_20617":52499,"_5":14139,"_27008":52325,"_2880":52500},[],"Manage Thing groups",{"_3394":1320,"_29710":1264,"_20617":52502,"_5":14139,"_27008":52325,"_2880":52503},[],"`iot:CreateProvisioningTemplate`",{"_3394":1321,"_29710":1264,"_20617":52505,"_5":14139,"_27008":52325,"_2880":52506},[],"Create JITP templates",{"_3394":1322,"_29710":1264,"_20617":52508,"_5":14139,"_27008":52325,"_2880":52509},[],"`iotdata:GetThingShadow` / `iotdata:UpdateThingShadow`",{"_3394":1323,"_29710":1264,"_20617":52511,"_5":14139,"_27008":52325,"_2880":52512},[],"Read and write the Device Shadow",{"_3394":1324,"_29710":1264,"_20617":52514,"_5":14139,"_27008":52325,"_2880":52515},[],"The forced-disconnect mechanism after revocation also requires access to the AWS IoT data plane API (`iot:Connect` with SigV4 over WebSocket), negotiated implicitly with the connector's credentials.",{"_3394":1325,"_29710":1264,"_20617":52517,"_5":14139,"_27008":52329,"_2880":52518},[],"Parameter",{"_3394":1326,"_29710":1264,"_20617":52520,"_5":14139,"_27008":52329,"_2880":52521},[],"Type",{"_3394":1327,"_29710":1264,"_20617":52523,"_5":14139,"_27008":52329,"_2880":52524},[],"Required",{"_3394":1328,"_29710":1264,"_20617":52526,"_5":14139,"_27008":52329,"_2880":52527},[],"Description",{"_3394":1329,"_29710":1264,"_20617":52529,"_5":14139,"_27008":52329,"_2880":52530},[],"`connector_id`",{"_3394":1330,"_29710":1264,"_20617":52532,"_5":14139,"_27008":52329,"_2880":24618},[],{"_3394":1331,"_29710":1264,"_20617":52534,"_5":14139,"_27008":52329,"_2880":52535},[],"Yes",{"_3394":1332,"_29710":1264,"_20617":52537,"_5":14139,"_27008":52329,"_2880":52538},[],"Unique identifier of this connector instance. Used as the metadata namespace: `lamassu.io/iot/{connector_id}`.",{"_3394":1333,"_29710":1264,"_20617":52540,"_5":14139,"_27008":52329,"_2880":52541},[],"`aws_config.region`",{"_3394":1334,"_29710":1264,"_20617":52543,"_5":14139,"_27008":52329,"_2880":24618},[],{"_3394":1335,"_29710":1264,"_20617":52545,"_5":14139,"_27008":52329,"_2880":52535},[],{"_3394":1336,"_29710":1264,"_20617":52547,"_5":14139,"_27008":52329,"_2880":52548},[],"AWS region where the connector operates.",{"_3394":1337,"_29710":1264,"_20617":52550,"_5":14139,"_27008":52329,"_2880":52551},[],"`aws_config.auth_method`",{"_3394":1338,"_29710":1264,"_20617":52553,"_5":14139,"_27008":52329,"_2880":24618},[],{"_3394":1339,"_29710":1264,"_20617":52555,"_5":14139,"_27008":52329,"_2880":52535},[],{"_3394":1340,"_29710":1264,"_20617":52557,"_5":14139,"_27008":52329,"_2880":52558},[],"Authentication method: `static`, `role` or empty (SDK default credential chain).",{"_3394":1341,"_29710":1264,"_20617":52560,"_5":14139,"_27008":52329,"_2880":52561},[],"`aws_config.access_key_id`",{"_3394":1342,"_29710":1264,"_20617":52563,"_5":14139,"_27008":52329,"_2880":24618},[],{"_3394":1343,"_29710":1264,"_20617":52565,"_5":14139,"_27008":52329,"_2880":52566},[],"Only with `auth_method=static`",{"_3394":1344,"_29710":1264,"_20617":52568,"_5":14139,"_27008":52329,"_2880":52569},[],"AWS access key.",{"_3394":1345,"_29710":1264,"_20617":52571,"_5":14139,"_27008":52329,"_2880":52572},[],"`aws_config.secret_access_key`",{"_3394":1346,"_29710":1264,"_20617":52574,"_5":14139,"_27008":52329,"_2880":24618},[],{"_3394":1347,"_29710":1264,"_20617":52576,"_5":14139,"_27008":52329,"_2880":52566},[],{"_3394":1348,"_29710":1264,"_20617":52578,"_5":14139,"_27008":52329,"_2880":52579},[],"AWS secret key.",{"_3394":1349,"_29710":1264,"_20617":52581,"_5":14139,"_27008":52329,"_2880":52582},[],"`aws_config.session_token`",{"_3394":1350,"_29710":1264,"_20617":52584,"_5":14139,"_27008":52329,"_2880":24618},[],{"_3394":1351,"_29710":1264,"_20617":52586,"_5":14139,"_27008":52329,"_2880":52587},[],"No",{"_3394":1352,"_29710":1264,"_20617":52589,"_5":14139,"_27008":52329,"_2880":52590},[],"Session token (with `auth_method=static`).",{"_3394":1353,"_29710":1264,"_20617":52592,"_5":14139,"_27008":52329,"_2880":52593},[],"`aws_config.role_arn`",{"_3394":1354,"_29710":1264,"_20617":52595,"_5":14139,"_27008":52329,"_2880":24618},[],{"_3394":1355,"_29710":1264,"_20617":52597,"_5":14139,"_27008":52329,"_2880":52598},[],"Only with `auth_method=role`",{"_3394":1356,"_29710":1264,"_20617":52600,"_5":14139,"_27008":52329,"_2880":52601},[],"ARN of the role to assume.",{"_3394":1357,"_29710":1264,"_20617":52603,"_5":14139,"_27008":52329,"_2880":52604},[],"`aws_config.endpoint_url`",{"_3394":1358,"_29710":1264,"_20617":52606,"_5":14139,"_27008":52329,"_2880":24618},[],{"_3394":1359,"_29710":1264,"_20617":52608,"_5":14139,"_27008":52329,"_2880":52587},[],{"_3394":1360,"_29710":1264,"_20617":52610,"_5":14139,"_27008":52329,"_2880":52611},[],"Alternative URL for all AWS services (useful with LocalStack in tests).",{"_3394":1361,"_29710":1264,"_20617":52613,"_5":14139,"_27008":52329,"_2880":52614},[],"`subscriber_event_bus`",{"_3394":1362,"_29710":1264,"_20617":52616,"_5":14139,"_27008":52329,"_2880":17335},[],{"_3394":1363,"_29710":1264,"_20617":52618,"_5":14139,"_27008":52329,"_2880":52535},[],{"_3394":1364,"_29710":1264,"_20617":52620,"_5":14139,"_27008":52329,"_2880":52621},[],"Configuration of the event bus the connector subscribes to (AMQP or AWS SQS/SNS).",{"_3394":1365,"_29710":1264,"_20617":52623,"_5":14139,"_27008":52329,"_2880":52624},[],"`dms_manager_client`",{"_3394":1366,"_29710":1264,"_20617":52626,"_5":14139,"_27008":52329,"_2880":24618},[],{"_3394":1367,"_29710":1264,"_20617":52628,"_5":14139,"_27008":52329,"_2880":52535},[],{"_3394":1368,"_29710":1264,"_20617":52630,"_5":14139,"_27008":52329,"_2880":52631},[],"HTTP URL of Lamassu's DMS Manager service.",{"_3394":1369,"_29710":1264,"_20617":52633,"_5":14139,"_27008":52329,"_2880":52634},[],"`device_manager_client`",{"_3394":1370,"_29710":1264,"_20617":52636,"_5":14139,"_27008":52329,"_2880":24618},[],{"_3394":1371,"_29710":1264,"_20617":52638,"_5":14139,"_27008":52329,"_2880":52535},[],{"_3394":1372,"_29710":1264,"_20617":52640,"_5":14139,"_27008":52329,"_2880":52641},[],"HTTP URL of Lamassu's Device Manager.",{"_3394":1373,"_29710":1264,"_20617":52643,"_5":14139,"_27008":52329,"_2880":52644},[],"`ca_client`",{"_3394":1374,"_29710":1264,"_20617":52646,"_5":14139,"_27008":52329,"_2880":24618},[],{"_3394":1375,"_29710":1264,"_20617":52648,"_5":14139,"_27008":52329,"_2880":52535},[],{"_3394":1376,"_29710":1264,"_20617":52650,"_5":14139,"_27008":52329,"_2880":52651},[],"HTTP URL of Lamassu's CA service.",{"_3394":1377,"_29710":1264,"_20617":52653,"_5":14139,"_27008":52333,"_2880":52654},[],"The connector owns the AWS side of four resource types — CAs, DMS provisioning templates (JITP), device certificates and Things. This section maps the bus events the connector consumes to the AWS resources they touch and to the AWS calls each flow performs. The state machine of each resource lives next to its detailed explanation; the last column links to it. AWS resources are referenced with the notation `IoTCore/<resource>`.",{"_3394":1378,"_29710":1264,"_20617":52656,"_5":14139,"_27008":52333,"_2880":52657},[],"The **CloudEvent type** column lists the event name on Lamassu's internal event bus; the **IAM actions** column lists the exact AWS SDK operations each flow invokes, so the required permissions can be derived directly from this table.",{"_3394":1379,"_29710":1264,"_20617":52659,"_5":14139,"_27008":52333,"_2880":52660},[],"CloudEvent type",{"_3394":1380,"_29710":1264,"_20617":52662,"_5":14139,"_27008":52333,"_2880":52663},[],"Lamassu resource",{"_3394":1381,"_29710":1264,"_20617":52665,"_5":14139,"_27008":52333,"_2880":52666},[],"AWS Resource",{"_3394":1382,"_29710":1264,"_20617":52668,"_5":14139,"_27008":52333,"_2880":52669},[],"IAM actions",{"_3394":1383,"_29710":1264,"_20617":52671,"_5":14139,"_27008":52333,"_2880":52672},[],"AWS calls and effect",{"_3394":1384,"_29710":1264,"_20617":52674,"_5":14139,"_27008":52333,"_2880":52675},[],"Where in this page",{"_3394":1385,"_29710":1264,"_20617":52677,"_5":14139,"_27008":52333,"_2880":52678},[],"`EventCreateCAKey` / `EventImportCAKey` / `EventUpdateCAMetadataKey`",{"_3394":1386,"_29710":1264,"_20617":52680,"_5":14139,"_27008":52333,"_2880":52681},[],"CA",{"_3394":1387,"_29710":1264,"_20617":52683,"_5":14139,"_27008":52333,"_2880":52684},[],"`IoTCore/CACertificate`",{"_3394":1388,"_29710":1264,"_20617":52686,"_5":14139,"_27008":52333,"_2880":52687},[],"`iot:GetRegistrationCode`, `iot:RegisterCACertificate`, `iot:DescribeCACertificate`, `iot:ListCACertificates`",{"_3394":1389,"_29710":1264,"_20617":52689,"_5":14139,"_27008":52333,"_2880":52690},[],"Loads the CA into connector state; a `registration.status = REQUESTED` write fires the registration flow (Primary with verification certificate, or SNI-only) and writes `SUCCEEDED` or `FAILED` back to the CA's metadata.",{"_3394":1390,"_29710":1264,"_20617":52692,"_5":14139,"_27008":52333,"_2880":52346},[],{"_3394":1391,"_29710":1264,"_20617":52694,"_5":14139,"_27008":52333,"_2880":52695},[],"`EventCreateDMSKey` / `EventUpdateDMSKey`",{"_3394":1392,"_29710":1264,"_20617":52697,"_5":14139,"_27008":52333,"_2880":52698},[],"DMS",{"_3394":1393,"_29710":1264,"_20617":52700,"_5":14139,"_27008":52333,"_2880":52701},[],"`IoTCore/ProvisioningTemplate`",{"_3394":1394,"_29710":1264,"_20617":52703,"_5":14139,"_27008":52333,"_2880":52704},[],"`iot:CreateProvisioningTemplate`, `iot:UpdateCACertificate`",{"_3394":1395,"_29710":1264,"_20617":52706,"_5":14139,"_27008":52333,"_2880":52707},[],"In `jitp` mode, attempts to create the provisioning template and attaches it to the registered CA. Non-idempotent: a `PUT /v1/dms/{id}` edit retries the creation and lands in `lamassu-dlq` after 3 retries. Idempotent for `none` and `auto` (configuration only).",{"_3394":1396,"_29710":1264,"_20617":52709,"_5":14139,"_27008":52333,"_2880":52374},[],{"_3394":1397,"_29710":1264,"_20617":52711,"_5":14139,"_27008":52333,"_2880":52712},[],"`EventBindDeviceIdentityKey`",{"_3394":1398,"_29710":1264,"_20617":52714,"_5":14139,"_27008":52333,"_2880":52715},[],"Device",{"_3394":1399,"_29710":1264,"_20617":52717,"_5":14139,"_27008":52333,"_2880":52718},[],"`IoTCore/Policy`, `IoTCore/ThingGroup`, `IoTCore/Thing`",{"_3394":1400,"_29710":1264,"_20617":52720,"_5":14139,"_27008":52333,"_2880":52721},[],"`iot:CreatePolicy` / `iot:DeletePolicyVersion`, `iot:GetPolicy` / `iot:ListPolicyVersions`, `iot:CreateThingGroup`, `iot:DescribeThing` / `iot:ListThingPrincipals`, `iot:RegisterThing`",{"_3394":1401,"_29710":1264,"_20617":52723,"_5":14139,"_27008":52333,"_2880":52724},[],"In `auto` mode: creates/updates policies, ensures Thing groups, revokes stale principals and provisions the Thing via `iot:RegisterThing`. In `jitp` mode: no AWS calls; AWS runs the JITP template on first connection.",{"_3394":1402,"_29710":1264,"_20617":52726,"_5":14139,"_27008":52333,"_2880":52382},[],{"_3394":1403,"_29710":1264,"_20617":52728,"_5":14139,"_27008":52333,"_2880":52729},[],"`EventUpdateCertificateStatusKey`",{"_3394":1404,"_29710":1264,"_20617":52731,"_5":14139,"_27008":52333,"_2880":52732},[],"Certificate",{"_3394":1405,"_29710":1264,"_20617":52734,"_5":14139,"_27008":52333,"_2880":52735},[],"`IoTCore/Certificate`",{"_3394":1406,"_29710":1264,"_20617":52737,"_5":14139,"_27008":52333,"_2880":52738},[],"`iot:UpdateCertificate`, `iot:Connect` (data plane)",{"_3394":1407,"_29710":1264,"_20617":52740,"_5":14139,"_27008":52333,"_2880":52741},[],"Maps status to AWS (`ACTIVE`, `INACTIVE`, `REVOKED`), calls `iot:UpdateCertificate` and forces an MQTT disconnect on revoke.",{"_3394":1408,"_29710":1264,"_20617":52743,"_5":14139,"_27008":52333,"_2880":52394},[],{"_3394":1409,"_29710":1264,"_20617":52745,"_5":14139,"_27008":52333,"_2880":52746},[],"`EventUpdateCertificateMetadataKey` / `EventUpdateDeviceMetadataKey`",{"_3394":1410,"_29710":1264,"_20617":52748,"_5":14139,"_27008":52333,"_2880":52749},[],"Certificate / Device",{"_3394":1411,"_29710":1264,"_20617":52751,"_5":14139,"_27008":52333,"_2880":52752},[],"`IoTCore/Certificate`, `IoTCore/Thing`",{"_3394":1412,"_29710":1264,"_20617":52754,"_5":14139,"_27008":52333,"_2880":48765},[],{"_3394":1413,"_29710":1264,"_20617":52756,"_5":14139,"_27008":52333,"_2880":52757},[],"Refreshes internal state; the connector ignores events whose CloudEvent `source` matches its own URI to avoid self-triggered loops.",{"_3394":1414,"_29710":1264,"_20617":52759,"_5":14139,"_27008":52333,"_2880":52402},[],{"_3394":1415,"_29710":1264,"_20617":52761,"_5":14139,"_27008":52337,"_2880":52762},[],"For devices to authenticate to AWS IoT Core with certificates issued by a Lamassu CA, that CA must first be registered in the AWS account. The connector handles this registration automatically in response to the `EventCreateCAKey`, `EventImportCAKey` and `EventUpdateCAMetadataKey` events, but the operation **only fires when the administrator explicitly requests it** through the CA metadata field.",{"_3394":1416,"_29710":1264,"_20617":52764,"_5":14139,"_27008":52341,"_2880":52765},[],"Registration is triggered by setting `registration.status = \"REQUESTED\"` on the `lamassu.io/iot/{connector_id}` key of the CA's metadata. This can be done from the Lamassu console in the CA management section or through the API.",{"_3394":1417,"_29710":1264,"_20617":52767,"_5":14139,"_27008":52341,"_2880":52768},[],"Once the event is received, the connector attempts to register the CA in AWS and updates the `registration.status` field in the CA's metadata with the result: `\"SUCCEEDED\"` if registration was successful, or `\"FAILED\"` with an error message otherwise. The process is asynchronous, so you must periodically check the metadata status until the operation completes.",{"_3394":1418,"_29710":1264,"_20617":52770,"_5":14139,"_27008":52345,"_2880":52771},[],"The CA registration flow is driven by the `registration.status` field of the CA's connector metadata:",{"_3394":1419,"_29710":1264,"_20617":52773,"_5":14139,"_27008":52345,"_2880":52774},[],"Transition",{"_3394":1420,"_29710":1264,"_20617":52776,"_5":14139,"_27008":52345,"_2880":52777},[],"AWS calls",{"_3394":1421,"_29710":1264,"_20617":52779,"_5":14139,"_27008":52345,"_2880":52780},[],"`NotRegistered` → `Requested`",{"_3394":1422,"_29710":1264,"_20617":52782,"_5":14139,"_27008":52345,"_2880":52783},[],"none (metadata write only)",{"_3394":1423,"_29710":1264,"_20617":52785,"_5":14139,"_27008":52345,"_2880":52786},[],"`Requested` → `Registering`",{"_3394":1424,"_29710":1264,"_20617":52788,"_5":14139,"_27008":52345,"_2880":52789},[],"`iot:GetRegistrationCode` (Primary Account only)",{"_3394":1425,"_29710":1264,"_20617":52791,"_5":14139,"_27008":52345,"_2880":52792},[],"`Registering` → `Succeeded`",{"_3394":1426,"_29710":1264,"_20617":52794,"_5":14139,"_27008":52345,"_2880":52795},[],"`iot:RegisterCACertificate` (Primary: proof-of-possession with an ephemeral key; SNI-only: `CertificateMode: SNI_ONLY`)",{"_3394":1427,"_29710":1264,"_20617":52797,"_5":14139,"_27008":52345,"_2880":52798},[],"`Registering` → `Failed`",{"_3394":1428,"_29710":1264,"_20617":52800,"_5":14139,"_27008":52345,"_2880":52801},[],"failed `iot:RegisterCACertificate`; the error detail is written to the CA's metadata",{"_3394":1429,"_29710":1264,"_20617":52803,"_5":14139,"_27008":52345,"_2880":52804},[],"`Failed` / `Succeeded` → `Requested`",{"_3394":1430,"_29710":1264,"_20617":52806,"_5":14139,"_27008":52345,"_2880":52807},[],"none (a new `REQUESTED` write re-runs the flow)",{"_3394":1431,"_29710":1264,"_20617":52809,"_5":14139,"_27008":52349,"_2880":52810},[],"When the `primary_account` parameter is `true`, the connector runs the full registration flow with proof-of-possession of the private key:",{"_3394":1432,"_29710":1264,"_20617":52812,"_5":14139,"_27008":52349,"_2880":52813},[],"It calls `iot:GetRegistrationCode` to obtain AWS's verification code.",{"_3394":1433,"_29710":1264,"_20617":52815,"_5":14139,"_27008":52349,"_2880":52816},[],"The connector internally generates an ephemeral RSA-2048 key pair and builds a CSR whose Common Name is exactly that registration code. It then calls Lamassu's signing service so the registered CA issues a real X.509 verification certificate signing that CSR. The ephemeral private key is used only for this purpose and is neither stored nor sent to AWS.",{"_3394":1434,"_29710":1264,"_20617":52818,"_5":14139,"_27008":52349,"_2880":52819},[],"It sends the CA (in PEM) and the verification certificate to AWS via `iot:RegisterCACertificate`, enabling registration with `AllowAutoRegistration: true`.",{"_3394":1435,"_29710":1264,"_20617":52821,"_5":14139,"_27008":52349,"_2880":52822},[],"Only one account can own a CA in a given AWS region. If the CA is already registered with the same serial number, the connector silently skips the step.",{"_3394":1436,"_29710":1264,"_20617":52824,"_5":14139,"_27008":52349,"_2880":52825},[],"The tags AWS IoT Core applies to the registered CA certificate are `LMS.CA.ID`, `LMS.CA.SN` and `LMS.CA.CN`.",{"_3394":1437,"_29710":1264,"_20617":52827,"_5":14139,"_27008":52353,"_2880":52828},[],"When `primary_account` is `false`, the connector registers the CA using `CertificateMode: SNI_ONLY`. This mode requires no verification code or access to the CA's private key, so it is the right choice when the CA is managed from another AWS account or when the administrator does not hold the private key. It is the usual method to register the same CA in several AWS accounts simultaneously.",{"_3394":1438,"_29710":1264,"_20617":52830,"_5":14139,"_27008":52357,"_2880":52831},[],"Each DMS participating in the AWS IoT Core integration must have the metadata key `lamassu.io/iot/{connector_id}` configured. The most important field of that configuration is `registration_mode`, which determines how devices are provisioned in AWS.",{"_3394":1439,"_29710":1264,"_20617":52833,"_5":14139,"_27008":52357,"_2880":52834},[],"There are three registration modes, and the choice among them depends on the fleet's provisioning strategy.",{"_3394":1440,"_29710":1264,"_20617":52836,"_5":14139,"_27008":52361,"_2880":52837},[],"In this mode the connector **creates no Things, groups or policies** in AWS IoT Core. It only syncs certificate status (active, revoked, suspended) as it changes in Lamassu. It is the right mode when Thing provisioning in AWS is managed by an external system and Lamassu only needs to keep certificate status up to date.",{"_3394":1441,"_29710":1264,"_20617":52839,"_5":14139,"_27008":52365,"_2880":52840},[],"`auto` mode delegates full device provisioning in AWS to Lamassu at enrollment time. When the device successfully completes its EST enrollment and Lamassu emits the `EventBindDeviceIdentityKey` event, the connector automatically executes the following sequence:",{"_3394":1442,"_29710":1264,"_20617":52842,"_5":14139,"_27008":52365,"_2880":52843},[],"Creates or updates the IoT policies configured in the DMS.",{"_3394":1443,"_29710":1264,"_20617":52845,"_5":14139,"_27008":52365,"_2880":52846},[],"Creates the root group `LAMASSU` in the AWS account (if it does not exist) and the child groups configured in the DMS as subgroups of `LAMASSU`. If the groups already exist, the `ResourceAlreadyExistsException` error is ignored, making the operation idempotent.",{"_3394":1444,"_29710":1264,"_20617":52848,"_5":14139,"_27008":52365,"_2880":52849},[],"If the Thing already existed in AWS IoT Core, the connector iterates all certificates (principals) currently attached to that Thing and marks them as `REVOKED` in AWS, ensuring previous certificates cannot keep being used to authenticate.",{"_3394":1445,"_29710":1264,"_20617":52851,"_5":14139,"_27008":52365,"_2880":52852},[],"Calls `iot:RegisterThing` with a CloudFormation-style provisioning template that creates the Thing, registers the device's certificate (PEM of the device certificate and of the issuing CA certificate) and attaches the configured policies.",{"_3394":1446,"_29710":1264,"_20617":52854,"_5":14139,"_27008":52365,"_2880":52855},[],"Once provisioning completes, the connector stores the resulting certificate's ARN in the Lamassu certificate's metadata under the key `lamassu.io/iot/{connector_id}` and marks the device as `Registered: true` in Device Manager.",{"_3394":1447,"_29710":1264,"_20617":52857,"_5":14139,"_27008":52365,"_2880":52858},[],"**The Thing name in AWS is the Common Name (CN) of the device's certificate.** This convention is fundamental for the firmware developer: the `/CN=` value the device includes in its CSR when enrolling becomes the ThingName it must identify itself with in all MQTT operations against AWS IoT Core.",{"_3394":1448,"_29710":1264,"_20617":52860,"_5":14139,"_27008":52369,"_2880":52861},[],"Just-In-Time Provisioning (JITP) mode delegates provisioning to AWS instead of the connector doing it directly. When the connector detects the DMS is in `jitp` mode, it creates a JITP provisioning template in AWS IoT Core and attaches it to the registered CA certificate. The connector attempts to create this template when the DMS is created and again on every full DMS edit (`PUT /v1/dms/{id}`) — not at device enrollment time. The attempt is not idempotent: when a template named after the DMS ID already exists, the creation call fails, the event is retried three times and finally lands in the `lamassu-dlq` poison queue (see Troubleshooting). The template is created once; later DMS edits never update its content. A DMS update that omits `metadata` or sends `null` keeps the stored metadata, so the connector key `lamassu.io/iot/{connector_id}` remains present and the attempt is still triggered. A body that supplies a `metadata` object replaces the stored metadata entirely: if that object does not carry the connector key, the key is dropped and the connector silently skips the DMS's future events. Once the template is attached, when a device with a certificate issued by that CA connects to AWS IoT Core for the first time, AWS executes the template automatically: it creates the Thing, registers the certificate and activates it.",{"_3394":1449,"_29710":1264,"_20617":52863,"_5":14139,"_27008":52369,"_2880":52864},[],"The connector creates the template, named after the DMS ID, only once. Each later edit of the DMS that keeps the connector key tries to create it again and fails, because the connector does not update existing templates. Later changes to `jitp_config.provisioning_role_arn`, `jitp_config.enable_template` or to the groups and policies the template references must be applied by hand in AWS IoT Core.",{"_3394":1450,"_29710":1264,"_20617":52866,"_5":14139,"_27008":52369,"_2880":52867},[],"The failed event is retried and ends in `lamassu-dlq`. Groups and policies are registered before the failure, but the assignment of the template to the registered CA, the write-back of the ARN to the DMS and the shadow update when `ManagedCAs` changes are skipped.",{"_3394":1451,"_29710":1264,"_20617":52869,"_5":14139,"_27008":52369,"_2880":52870},[],"The Thing name in the JITP template is derived from `AWS::IoT::Certificate::CommonName`, which corresponds to the device certificate's CN — the same convention as `auto` mode.",{"_3394":1452,"_29710":1264,"_20617":52872,"_5":14139,"_27008":52369,"_2880":52873},[],"This mode requires the `jitp_config.provisioning_role_arn` field to be configured with the ARN of an IAM role AWS IoT Core can assume to execute the template. If not configured, the connector uses the default `arn:aws:iam::{account}:role/JITPRole` and logs a warning. The administrator must ensure that role exists in the account and has the necessary permissions before enabling JITP mode.",{"_3394":1453,"_29710":1264,"_20617":52875,"_5":14139,"_27008":52373,"_2880":52876},[],"The DMS's `registration_mode` determines what the connector does on the AWS side when the DMS is created or fully edited:",{"_3394":1454,"_29710":1264,"_20617":52878,"_5":14139,"_27008":52373,"_2880":52774},[],{"_3394":1455,"_29710":1264,"_20617":52880,"_5":14139,"_27008":52373,"_2880":52777},[],{"_3394":1456,"_29710":1264,"_20617":52882,"_5":14139,"_27008":52373,"_2880":52883},[],"`Unconfigured` → `None` / `Auto`",{"_3394":1457,"_29710":1264,"_20617":52885,"_5":14139,"_27008":52373,"_2880":52886},[],"none (configuration only)",{"_3394":1458,"_29710":1264,"_20617":52888,"_5":14139,"_27008":52373,"_2880":52889},[],"`None` ↔ `Auto`",{"_3394":1459,"_29710":1264,"_20617":52891,"_5":14139,"_27008":52373,"_2880":52886},[],{"_3394":1460,"_29710":1264,"_20617":52893,"_5":14139,"_27008":52373,"_2880":52894},[],"Any → `Jitp`",{"_3394":1461,"_29710":1264,"_20617":52896,"_5":14139,"_27008":52373,"_2880":52897},[],"`iot:CreateProvisioningTemplate` (non-idempotent: it fails when the template already exists; after 3 retries the event lands in `lamassu-dlq`)",{"_3394":1462,"_29710":1264,"_20617":52899,"_5":14139,"_27008":52373,"_2880":52900},[],"`Jitp` → `None` / `Auto`",{"_3394":1463,"_29710":1264,"_20617":52902,"_5":14139,"_27008":52373,"_2880":52903},[],"none (the template stays in the AWS account)",{"_3394":1464,"_29710":1264,"_20617":52905,"_5":14139,"_27008":52377,"_2880":52906},[],"For the firmware developer, `auto` mode is transparent: the device performs its EST enrollment as usual and, as a side effect, it is provisioned in AWS IoT Core with no additional step.",{"_3394":1465,"_29710":1264,"_20617":52908,"_5":14139,"_27008":52377,"_2880":52909},[],"The full flow from the device's perspective is:",{"_3394":1466,"_29710":1264,"_20617":52911,"_5":14139,"_27008":52377,"_2880":52912},[],"Once the connector completes provisioning, the device can connect to the AWS IoT Core MQTT endpoint using its private key and the certificate issued by Lamassu. The ThingName it must identify itself with in AWS is exactly the certificate's CN.",{"_3394":1467,"_29710":1264,"_20617":52914,"_5":14139,"_27008":52381,"_2880":52915},[],"Things only exist under `auto` mode; in `jitp` mode AWS creates the Thing itself when the device first connects. The Thing name is always the device certificate's CN:",{"_3394":1468,"_29710":1264,"_20617":52917,"_5":14139,"_27008":52381,"_2880":52774},[],{"_3394":1469,"_29710":1264,"_20617":52919,"_5":14139,"_27008":52381,"_2880":52777},[],{"_3394":1470,"_29710":1264,"_20617":52921,"_5":14139,"_27008":52381,"_2880":52922},[],"`Absent` → `Provisioned`",{"_3394":1471,"_29710":1264,"_20617":52924,"_5":14139,"_27008":52381,"_2880":52925},[],"policies created/updated, Thing groups ensured, `iot:RegisterThing` (creates the Thing, registers the certificate, attaches policies)",{"_3394":1472,"_29710":1264,"_20617":52927,"_5":14139,"_27008":52381,"_2880":52928},[],"`Provisioned` → `Provisioned` (re-enrollment)",{"_3394":1473,"_29710":1264,"_20617":52930,"_5":14139,"_27008":52381,"_2880":52931},[],"stale principals marked `REVOKED`, new `iot:RegisterThing` run; the new certificate ARN replaces the old one in Lamassu metadata",{"_3394":1474,"_29710":1264,"_20617":52933,"_5":14139,"_27008":52381,"_2880":52934},[],"In `jitp` mode the connector makes no provisioning calls: AWS executes the JITP template on the device's first connection and creates the Thing, registers the certificate and activates it on its own.",{"_3394":1475,"_29710":1264,"_20617":52936,"_5":14139,"_27008":52385,"_2880":52937},[],"In JITP mode the device also performs its EST enrollment conventionally and obtains its certificate from Lamassu. The difference is that AWS IoT Core does not know the device until it attempts its first connection.",{"_3394":1476,"_29710":1264,"_20617":52939,"_5":14139,"_27008":52385,"_2880":52940},[],"When the device establishes its first MQTT connection to AWS IoT Core presenting the Lamassu-issued certificate, AWS detects that the certificate belongs to a CA registered with a JITP template, executes that template and creates the Thing automatically. The initial connection may fail or be delayed while the template runs; firmware must be prepared to retry the connection.",{"_3394":1477,"_29710":1264,"_20617":52942,"_5":14139,"_27008":52385,"_2880":52943},[],"For the JITP flow to work correctly:",{"_3394":1478,"_29710":1264,"_20617":52945,"_5":14139,"_27008":52385,"_2880":52946},[],"The CA must be registered in AWS in Primary Account mode (SNI-only mode does not support JITP).",{"_3394":1479,"_29710":1264,"_20617":52948,"_5":14139,"_27008":52385,"_2880":52949},[],"The IAM role configured in `jitp_config.provisioning_role_arn` must exist and have permissions to create Things, register certificates and attach policies in the AWS account.",{"_3394":1480,"_29710":1264,"_20617":52951,"_5":14139,"_27008":52385,"_2880":52952},[],"The device must present both its certificate and the issuing CA's certificate in the TLS handshake with AWS IoT Core.",{"_3394":1481,"_29710":1264,"_20617":52954,"_5":14139,"_27008":52385,"_2880":52955},[],"Certificates provisioned via JITP **do not have the connector's metadata key** (`lamassu.io/iot/{connector_id}`) in Lamassu. As a consequence, status changes of those certificates in Lamassu are not automatically synced to AWS through the state synchronization mechanism described in the next section.",{"_3394":1482,"_29710":1264,"_20617":52957,"_5":14139,"_27008":52389,"_2880":52958},[],"The connector listens for the `EventUpdateCertificateStatusKey` event and, when a certificate holding the connector's metadata key changes status in Lamassu, replicates that change in AWS IoT Core. The following table shows the status mapping:",{"_3394":1483,"_29710":1264,"_20617":52960,"_5":14139,"_27008":52389,"_2880":52961},[],"Status in Lamassu",{"_3394":1484,"_29710":1264,"_20617":52963,"_5":14139,"_27008":52389,"_2880":52964},[],"Revocation reason",{"_3394":1485,"_29710":1264,"_20617":52966,"_5":14139,"_27008":52389,"_2880":52967},[],"Status in AWS IoT Core",{"_3394":1486,"_29710":1264,"_20617":52969,"_5":14139,"_27008":52389,"_2880":52970},[],"`Active`",{"_3394":1487,"_29710":1264,"_20617":52972,"_5":14139,"_27008":52389,"_2880":52973},[],"None",{"_3394":1488,"_29710":1264,"_20617":52975,"_5":14139,"_27008":52389,"_2880":52976},[],"`ACTIVE`",{"_3394":1489,"_29710":1264,"_20617":52978,"_5":14139,"_27008":52389,"_2880":52979},[],"`Revoked`",{"_3394":1490,"_29710":1264,"_20617":52981,"_5":14139,"_27008":52389,"_2880":52982},[],"`certificateHold`",{"_3394":1491,"_29710":1264,"_20617":52984,"_5":14139,"_27008":52389,"_2880":52985},[],"`INACTIVE`",{"_3394":1492,"_29710":1264,"_20617":52987,"_5":14139,"_27008":52389,"_2880":52979},[],{"_3394":1493,"_29710":1264,"_20617":52989,"_5":14139,"_27008":52389,"_2880":52990},[],"Any other reason",{"_3394":1494,"_29710":1264,"_20617":52992,"_5":14139,"_27008":52389,"_2880":52993},[],"`REVOKED`",{"_3394":1495,"_29710":1264,"_20617":52995,"_5":14139,"_27008":52389,"_2880":52996},[],"Only the `Active` and `Revoked` states produce a call to `iot:UpdateCertificate`. The other lifecycle states of Lamassu (`RenewalWindow`, `AboutToExpire`, `Expired`) are not synced to AWS IoT Core; the certificate status in AWS remains unchanged until the status in Lamassu becomes `Active` or `Revoked`.",{"_3394":1496,"_29710":1264,"_20617":52998,"_5":14139,"_27008":52393,"_2880":52999},[],"Certificates holding the connector's metadata key sync their status; certificates provisioned via JITP have no metadata key and stay out of this machine:",{"_3394":1497,"_29710":1264,"_20617":53001,"_5":14139,"_27008":52393,"_2880":52774},[],{"_3394":1498,"_29710":1264,"_20617":53003,"_5":14139,"_27008":52393,"_2880":52777},[],{"_3394":1499,"_29710":1264,"_20617":53005,"_5":14139,"_27008":52393,"_2880":53006},[],"`NotSynced` → `Active`",{"_3394":1500,"_29710":1264,"_20617":53008,"_5":14139,"_27008":52393,"_2880":52485},[],{"_3394":1501,"_29710":1264,"_20617":53010,"_5":14139,"_27008":52393,"_2880":53011},[],"`Active` → `Inactive`",{"_3394":1502,"_29710":1264,"_20617":53013,"_5":14139,"_27008":52393,"_2880":53014},[],"`iot:UpdateCertificate` + forced MQTT disconnect",{"_3394":1503,"_29710":1264,"_20617":53016,"_5":14139,"_27008":52393,"_2880":53017},[],"`Active` → `Revoked`",{"_3394":1504,"_29710":1264,"_20617":53019,"_5":14139,"_27008":52393,"_2880":53014},[],{"_3394":1505,"_29710":1264,"_20617":53021,"_5":14139,"_27008":52393,"_2880":53022},[],"`Inactive` / `Revoked` → `Active`",{"_3394":1506,"_29710":1264,"_20617":53024,"_5":14139,"_27008":52393,"_2880":52485},[],{"_3394":1507,"_29710":1264,"_20617":53026,"_5":14139,"_27008":52393,"_2880":53027},[],"`RenewalWindow` / `AboutToExpire` / `Expired`",{"_3394":1508,"_29710":1264,"_20617":53029,"_5":14139,"_27008":52393,"_2880":53030},[],"none (these states are not synced to AWS)",{"_3394":1509,"_29710":1264,"_20617":53032,"_5":14139,"_27008":52397,"_2880":53033},[],"When the connector marks a certificate as `REVOKED` or `INACTIVE` in AWS, it additionally performs a forced disconnect of the device. To do so it opens an MQTT connection over WebSocket (with SigV4 authentication using the connector's credentials) to the AWS IoT Core data endpoint, using the certificate's CN as the MQTT client identifier, and closes it immediately. This terminates any active MQTT session the device may have at that moment.",{"_3394":1510,"_29710":1264,"_20617":53035,"_5":14139,"_27008":52397,"_2880":53036},[],"This forced disconnect happens at the moment Lamassu records the status change. If the device tries to reconnect after the disconnect, AWS IoT Core will reject the connection because the certificate is already listed as `REVOKED` or `INACTIVE`.",{"_3394":1511,"_29710":1264,"_20617":53038,"_5":14139,"_27008":52397,"_2880":53039},[],"Certificates provisioned in JITP mode do not have this automatic sync, since they lack the connector's metadata key.",{"_3394":1512,"_29710":1264,"_20617":53041,"_5":14139,"_27008":52401,"_2880":53042},[],"The connector can write to the AWS IoT Core Device Shadow to send action signals to the device firmware. This feature is enabled per DMS with `shadow_config.enable: true`.",{"_3394":1513,"_29710":1264,"_20617":53044,"_5":14139,"_27008":52401,"_2880":53045},[],"If `shadow_config.shadow_name` holds a value, the connector uses a Named Shadow with that name; otherwise it uses the Classic Shadow (the Thing's default shadow).",{"_3394":1514,"_29710":1264,"_20617":53047,"_5":14139,"_27008":52405,"_2880":53048},[],"The connector writes to the `desired.identity_actions` field of the shadow document. Each entry contains a Unix timestamp in milliseconds. The device firmware must read this field and act accordingly.",{"_3394":1515,"_29710":1264,"_20617":53050,"_5":14139,"_27008":52405,"_2880":53051},[],"There are two action types:",{"_3394":1516,"_29710":1264,"_20617":53053,"_5":14139,"_27008":52405,"_2880":53054},[],"**`UPDATE_CERTIFICATE`**: written when a certificate's preventive renewal window activates — that is, when the `triggered` field of the preventive renewal delta flips from `false` to `true`. This action tells the device it must start the re-enrollment process to renew its certificate before it expires.",{"_3394":1517,"_29710":1264,"_20617":53056,"_5":14139,"_27008":52405,"_2880":53057},[],"**`UPDATE_TRUST_ANCHOR_LIST`**: written to all devices of a DMS when the DMS's `ManagedCAs` list changes. This action tells the device it must update its trusted CA store.",{"_3394":1518,"_29710":1264,"_20617":53059,"_5":14139,"_27008":52405,"_2880":53060},[],"The shadow write process consists of reading the current shadow (`iotdata:GetThingShadow`), merging the new actions with the existing ones and writing the result (`iotdata:UpdateThingShadow`). If the shadow does not exist, the connector creates it. After a successful write, the list of pending actions in the device's metadata in Lamassu is cleared.",{"_3394":1519,"_29710":1264,"_20617":53062,"_5":14139,"_27008":52409,"_2880":53063},[],"The connector creates and attaches the policies configured in the DMS. A typical policy for a device using MQTT and the Device Shadow has this structure:",{"_3394":1520,"_29710":1264,"_20617":53065,"_5":14139,"_27008":52409,"_2880":53066},[],"In the policy above, the `<AWS_REGION>` and `<AWS_ACCOUNT_ID>` placeholders must be replaced with the AWS region and the twelve-digit account identifier of the target account before applying the policy. The `${iot:Connection.Thing.ThingName}` variable automatically limits each permission to the Thing the device is connected as, following the principle of least privilege. The `${ShadowName}` variable in the shadow ARNs is a placeholder that must be replaced with the `shadow_config.shadow_name` value configured in the DMS; if the Classic Shadow is used, it can be simplified by removing the `name/${ShadowName}/` segment. AWS IoT policies do not support regex alternation; the `[name/${ShadowName}/]*` notation represents the optionality of that segment within ARN syntax constraints.",{"_3394":1521,"_29710":1264,"_20617":53068,"_5":14139,"_27008":52409,"_2880":53069},[],"The first statement lets the device connect using its ThingName as the MQTT identifier. The second authorizes publishing to the Thing's generic MQTT topic and to the shadow topics, needed so the device can update its reported state. The last two statements grant subscribe and receive permissions over the same topics, letting the device receive shadow updates (for example, the `UPDATE_CERTIFICATE` and `UPDATE_TRUST_ANCHOR_LIST` actions written by the connector).",{"_3394":1522,"_29710":1264,"_20617":53071,"_5":14139,"_27008":52413,"_2880":53072},[],"**Symptom:** The CA registration stays in `REQUESTED` indefinitely.",{"_3394":1523,"_29710":1264,"_20617":53074,"_5":14139,"_27008":52413,"_2880":53075},[],"**Cause:** The connector is not running or is not subscribed to the event bus. It can also indicate incorrect IAM credentials, insufficient permissions or that the metadata key was written with a wrong `connector_id`.",{"_3394":1524,"_29710":1264,"_20617":53077,"_5":14139,"_27008":52413,"_2880":53078},[],"**Resolution:** Verify the connector process is active and the logs show no AWS communication errors. Check the metadata field was written under the exact key `lamassu.io/iot/{connector_id}`. If the error persists, the connector will update the status to `FAILED` with a descriptive message in the CA metadata.",{"_3394":1525,"_29710":1264,"_20617":53080,"_5":14139,"_27008":52413,"_2880":53081},[],"**Symptom:** A certificate's status is not synced to AWS after a revocation.",{"_3394":1526,"_29710":1264,"_20617":53083,"_5":14139,"_27008":52413,"_2880":53084},[],"**Cause:** Most commonly the certificate was provisioned in JITP mode. JITP certificates lack the connector's metadata key and are outside the state synchronization mechanism. If the DMS is in `auto` mode, it may indicate the initial provisioning did not complete correctly and the AWS ARN was not stored in the certificate metadata.",{"_3394":1527,"_29710":1264,"_20617":53086,"_5":14139,"_27008":52413,"_2880":53087},[],"**Resolution:** For JITP certificates, migrate the DMS to `auto` mode and re-provision the affected devices. For `auto` mode certificates, verify the certificate has the AWS ARN stored in its metadata; if not, repeat the provisioning.",{"_3394":1528,"_29710":1264,"_20617":53089,"_5":14139,"_27008":52413,"_2880":53090},[],"**Symptom:** The forced disconnect does not terminate the device's MQTT session after revocation.",{"_3394":1529,"_29710":1264,"_20617":53092,"_5":14139,"_27008":52413,"_2880":53093},[],"**Cause:** The device uses an MQTT client ID different from the certificate's CN. The forced disconnect opens a connection using the CN as client ID; if the firmware uses another identifier, the disconnect does not affect that session.",{"_3394":1530,"_29710":1264,"_20617":53095,"_5":14139,"_27008":52413,"_2880":53096},[],"**Resolution:** Make sure the firmware uses exactly the certificate's CN as the MQTT client identifier. That CN matches the ThingName in AWS IoT Core.",{"_3394":1531,"_29710":1264,"_20617":53098,"_5":14139,"_27008":52413,"_2880":53099},[],"**Symptom:** The device receives `CLIENT_ID_REJECTED` when connecting to AWS IoT Core.",{"_3394":1532,"_29710":1264,"_20617":53101,"_5":14139,"_27008":52413,"_2880":53102},[],"**Cause:** The MQTT client ID does not match the ThingName, which is always the CN of the certificate issued by Lamassu.",{"_3394":1533,"_29710":1264,"_20617":53104,"_5":14139,"_27008":52413,"_2880":53105},[],"**Resolution:** Verify the firmware uses exactly the value of the CN field included in the enrollment CSR as the MQTT client identifier.",{"_3394":1534,"_29710":1264,"_20617":53107,"_5":14139,"_27008":52413,"_2880":53108},[],"**Symptom:** The device's first MQTT connection in JITP mode fails or times out.",{"_3394":1535,"_29710":1264,"_20617":53110,"_5":14139,"_27008":52413,"_2880":53111},[],"**Cause:** This is expected behavior while AWS executes the JITP template on the device's first connection.",{"_3394":1536,"_29710":1264,"_20617":53113,"_5":14139,"_27008":52413,"_2880":53114},[],"**Resolution:** Firmware must implement retries with exponential backoff for the first connection. If the failure persists beyond a few minutes, verify the IAM role configured in `jitp_config.provisioning_role_arn` exists in the account and has permissions to create Things, register certificates and attach policies.",{"_3394":1537,"_29710":1264,"_20617":53116,"_5":14139,"_27008":52413,"_2880":53117},[],"**Symptom:** The Device Shadow is not updated when it should be.",{"_3394":1538,"_29710":1264,"_20617":53119,"_5":14139,"_27008":52413,"_2880":53120},[],"**Cause:** The shadow feature is disabled in the DMS configuration, the connector's credentials lack IoT data-plane permissions, or the firmware reads a different shadow than the configured one.",{"_3394":1539,"_29710":1264,"_20617":53122,"_5":14139,"_27008":52413,"_2880":53123},[],"**Resolution:** Check that `shadow_config.enable` is `true` in the connector metadata for the corresponding DMS. If a Named Shadow is used, verify `shadow_config.shadow_name` holds the correct name and that the firmware reads that Named Shadow and not the Classic Shadow. Confirm the connector's credentials have `iotdata:GetThingShadow` and `iotdata:UpdateThingShadow` permissions.",{"_3394":1540,"_29710":1264,"_20617":53125,"_5":14139,"_27008":52413,"_2880":53126},[],"**Symptom:** After editing a DMS in `jitp` mode, DMS update messages appear in `lamassu-dlq`, or JITP configuration changes have no effect in AWS.",{"_3394":1541,"_29710":1264,"_20617":53128,"_5":14139,"_27008":52413,"_2880":53129},[],"**Cause:** Every full DMS edit (`PUT /v1/dms/{id}`) triggers a `CreateProvisioningTemplate` attempt for the template named after the DMS ID, and the call is not idempotent: when the template already exists, it fails, the event is retried three times and finally lands in `lamassu-dlq`. The connector’s later steps are skipped.",{"_3394":1542,"_29710":1264,"_20617":53131,"_5":14139,"_27008":52413,"_2880":53132},[],"**Resolution:** Check that the template named with the DMS ID exists in AWS IoT Core and that JITP enrollment works. If the JITP configuration was changed, apply it by hand to the AWS template.",{"_3394":1543,"_29710":1264,"_20617":53134,"_5":14139,"_27008":52413,"_2880":53135},[],"<Card title=\"Configure a DMS\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_3394":1544,"_29710":1264,"_20617":53137,"_5":14139,"_27008":52413,"_2880":53138},[],"<Card title=\"Device enrollment (EST)\" href=\"/docs/platform/iot-fleets/enrollment/overview\" />",{"_3394":1545,"_29710":1264,"_20617":53140,"_5":14139,"_27008":52413,"_2880":53141},[],"<Card title=\"Certificate management\" href=\"/docs/platform/pki/certificates\" />",{"_3394":1546,"_29710":1546,"_5":14491,"_2880":50848,"_30042":53143,"_20617":53144,"_27008":1546},[48369,49837,50848],[],{"_3394":1547,"_29710":1546,"_20617":53146,"_5":14139,"_27008":1546,"_2880":53147},[],"Organize devices and their identities, prepare enrollment and integrate consumers.",{"_3394":1548,"_29710":1546,"_5":30039,"_20617":53149,"_27008":53150,"_2880":53151},[],"/docs/platform/iot-fleets/overview#start-here","Start here",{"_3394":1549,"_29710":1546,"_5":30039,"_20617":53153,"_27008":53154,"_2880":50846},[],"/docs/platform/iot-fleets/overview#devices-and-identities",{"_3394":1550,"_29710":1546,"_5":30039,"_20617":53156,"_27008":53157,"_2880":51029},[],"/docs/platform/iot-fleets/overview#enrollment-with-pki",{"_3394":1551,"_29710":1546,"_5":30039,"_20617":53159,"_27008":53160,"_2880":52310},[],"/docs/platform/iot-fleets/overview#integrations",{"_3394":1552,"_29710":1546,"_5":30039,"_20617":53162,"_27008":53163,"_2880":53164},[],"/docs/platform/iot-fleets/overview#who-prepares-each-part","Who prepares each part",{"_3394":1553,"_29710":1546,"_20617":53166,"_5":14139,"_27008":1546,"_2880":53167},[],"IoT Fleets applies PKI to the device lifecycle: registration, obtaining an identity, renewal and retirement. It is intended for those who administer a device population and those who integrate its enrollment client or the system that accepts it.",{"_3394":1554,"_29710":1546,"_20617":53169,"_5":14139,"_27008":53150,"_2880":53170},[],"Follow Enroll and connect your first device to prepare a DMS, obtain the identity from the client and demonstrate an mTLS connection. The automatic path includes initial trust, a CSR and result checks.",{"_3394":1555,"_29710":1546,"_20617":53172,"_5":14139,"_27008":53150,"_2880":53173},[],"To start with an existing certificate, use Register a device manually. You can then prepare enrollment and renewal for the next device.",{"_3394":1556,"_29710":1546,"_20617":53175,"_5":14139,"_27008":53154,"_2880":53176},[],"Resource",{"_3394":1557,"_29710":1546,"_20617":53178,"_5":14139,"_27008":53154,"_2880":53179},[],"What it represents",{"_3394":1558,"_29710":1546,"_20617":53181,"_5":14139,"_27008":53154,"_2880":53182},[],"**Device**",{"_3394":1559,"_29710":1546,"_20617":53184,"_5":14139,"_27008":53154,"_2880":53185},[],"An inventory entry with an identifier, owning DMS and classification.",{"_3394":1560,"_29710":1546,"_20617":53187,"_5":14139,"_27008":53154,"_2880":53188},[],"**Identity**",{"_3394":1561,"_29710":1546,"_20617":53190,"_5":14139,"_27008":53154,"_2880":53191},[],"The device's association with its certificates: an active version and a history.",{"_3394":1562,"_29710":1546,"_20617":53193,"_5":14139,"_27008":53154,"_2880":53194},[],"**DMS**",{"_3394":1563,"_29710":1546,"_20617":53196,"_5":14139,"_27008":53154,"_2880":53197},[],"The service that configures admission, enrollment, renewal and trust distribution.",{"_3394":1564,"_29710":1546,"_20617":53199,"_5":14139,"_27008":53154,"_2880":53200},[],"**Fleet**",{"_3394":1565,"_29710":1546,"_20617":53202,"_5":14139,"_27008":53154,"_2880":53203},[],"The population you operate, represented through devices, DMSs, tags and metadata.",{"_3394":1566,"_29710":1546,"_20617":53205,"_5":14139,"_27008":53154,"_2880":53206},[],"Each device has an owning DMS. You can organize a population through several DMSs when it needs different policies, and use tags to classify it. “Fleet” describes that operational context; the resources you create and query are DMSs and devices.",{"_3394":1567,"_29710":1546,"_20617":53208,"_5":14139,"_27008":53154,"_2880":53209},[],"Device management covers states, certificate history and identity actions. During renewal, retain the relationship with the device and check which certificate becomes the current identity.",{"_3394":1568,"_29710":1546,"_20617":53211,"_5":14139,"_27008":53157,"_2880":53212},[],"This section connects PKI rules to the device client. Preparation follows this order:",{"_3394":1569,"_29710":1546,"_20617":53214,"_5":14139,"_27008":53157,"_2880":53215},[],"**CA and profile:** prepare the issuer and certificate rules in PKI.",{"_3394":1570,"_29710":1546,"_20617":53217,"_5":14139,"_27008":53157,"_2880":53218},[],"**DMS policy:** define how the device is admitted, how requests authenticate and which trust is distributed.",{"_3394":1571,"_29710":1546,"_20617":53220,"_5":14139,"_27008":53157,"_2880":53221},[],"**Client:** prepare the initial credential, server trust, and key generation or custody.",{"_3394":1572,"_29710":1546,"_20617":53223,"_5":14139,"_27008":53157,"_2880":53224},[],"**Result:** request the certificate, install it and check its association with the device.",{"_3394":1573,"_29710":1546,"_20617":53226,"_5":14139,"_27008":53157,"_2880":53227},[],"**Continuity:** configure renewal, successor installation and recovery according to DMS policy.",{"_3394":1574,"_29710":1546,"_20617":53229,"_5":14139,"_27008":53157,"_2880":53230},[],"<Card title=\"Configure the DMS\" description=\"Prepare the CA, admission, authentication and renewal rules.\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_3394":1575,"_29710":1546,"_20617":53232,"_5":14139,"_27008":53157,"_2880":53233},[],"<Card title=\"Integrate the EST client\" description=\"Review the device endpoints, formats and checks.\" href=\"/docs/platform/iot-fleets/enrollment/est-client\" />",{"_3394":1576,"_29710":1546,"_20617":53235,"_5":14139,"_27008":53160,"_2880":53236},[],"An issued identity needs a consumer that trusts its issuer, validates the certificate and grants the device permissions. Prepare both the device's trust in the server and the server's trust in the device.",{"_3394":1577,"_29710":1546,"_20617":53238,"_5":14139,"_27008":53160,"_2880":53239},[],"The AWS IoT Core guide explains how to use the identity in that destination. Provisioning in Lamassu and provisioning in the destination are separate decisions; review the conditions of the chosen mode before expecting state synchronization.",{"_3394":1578,"_29710":1546,"_20617":53241,"_5":14139,"_27008":53163,"_2880":53242},[],"Participant",{"_3394":1579,"_29710":1546,"_20617":53244,"_5":14139,"_27008":53163,"_2880":53245},[],"Responsibility",{"_3394":1580,"_29710":1546,"_20617":53247,"_5":14139,"_27008":53163,"_2880":53248},[],"PKI administrator",{"_3394":1581,"_29710":1546,"_20617":53250,"_5":14139,"_27008":53163,"_2880":53251},[],"CA, issuance profile, chain and revocation publication.",{"_3394":1582,"_29710":1546,"_20617":53253,"_5":14139,"_27008":53163,"_2880":53254},[],"Provisioning administrator",{"_3394":1583,"_29710":1546,"_20617":53256,"_5":14139,"_27008":53163,"_2880":53257},[],"DMS, admission, authentication per operation and inventory.",{"_3394":1584,"_29710":1546,"_20617":53259,"_5":14139,"_27008":53163,"_2880":53260},[],"Device integrator",{"_3394":1585,"_29710":1546,"_20617":53262,"_5":14139,"_27008":53163,"_2880":53263},[],"Initial credential, key, EST client, trust and certificate installation.",{"_3394":1586,"_29710":1546,"_20617":53265,"_5":14139,"_27008":53163,"_2880":53266},[],"Consumer integrator",{"_3394":1587,"_29710":1546,"_20617":53268,"_5":14139,"_27008":53163,"_2880":53269},[],"Trusted issuers, validation and device permissions in the destination.",{"_3394":1588,"_29710":1546,"_20617":53271,"_5":14139,"_27008":53163,"_2880":53272},[],"Permissions and audit are shared with the rest of Platform. Prepare installation and instance connectivity in Deployment.",{"_3394":1589,"_29710":1589,"_5":14491,"_2880":53274,"_30042":53275,"_20617":53277,"_27008":1589},"Enroll and connect your first device",[48369,49837,50848,53276],"Getting started",[],{"_3394":1590,"_29710":1589,"_20617":53279,"_5":14139,"_27008":1589,"_2880":53280},[],"Obtain an identity through EST, verify its association and use it in an mTLS connection.",{"_3394":1591,"_29710":1589,"_5":30039,"_20617":53282,"_27008":53283,"_2880":48379},[],"/docs/platform/iot-fleets/quickstarts/enroll-device#before-you-begin",{"_3394":1592,"_29710":1589,"_5":30039,"_20617":53285,"_27008":53286,"_2880":53287},[],"/docs/platform/iot-fleets/quickstarts/enroll-device#prepare-the-bootstrap-credential","Prepare the bootstrap credential",{"_3394":1593,"_29710":1589,"_5":30039,"_20617":53289,"_27008":53290,"_2880":53291},[],"/docs/platform/iot-fleets/quickstarts/enroll-device#configure-the-evaluation-dms","Configure the evaluation DMS",{"_3394":1594,"_29710":1589,"_5":30039,"_20617":53293,"_27008":53294,"_2880":53295},[],"/docs/platform/iot-fleets/quickstarts/enroll-device#prepare-the-client-and-check-cacerts","Prepare the client and check cacerts",{"_3394":1595,"_29710":1589,"_5":30039,"_20617":53297,"_27008":53298,"_2880":53299},[],"/docs/platform/iot-fleets/quickstarts/enroll-device#enroll-the-device","Enroll the device",{"_3394":1596,"_29710":1589,"_5":30039,"_20617":53301,"_27008":53302,"_2880":53303},[],"/docs/platform/iot-fleets/quickstarts/enroll-device#verify-the-obtained-identity","Verify the obtained identity",{"_3394":1597,"_29710":1589,"_5":30039,"_20617":53305,"_27008":53306,"_2880":53307},[],"/docs/platform/iot-fleets/quickstarts/enroll-device#demonstrate-an-mtls-connection","Demonstrate an mTLS connection",{"_3394":1598,"_29710":1589,"_5":30039,"_20617":53309,"_27008":53310,"_2880":53311},[],"/docs/platform/iot-fleets/quickstarts/enroll-device#result-and-continuity","Result and continuity",{"_3394":1599,"_29710":1589,"_20617":53313,"_5":14139,"_27008":1589,"_2880":53314},[],"Prepare an evaluation DMS, enroll `est-device-001` from the client and use its identity with a local consumer that requires a certificate. The path connects administrator policy to the material the device actually installs.",{"_3394":1600,"_29710":1589,"_20617":53316,"_5":14139,"_27008":53283,"_2880":53317},[],"A Lamassu instance accessible through HTTPS and permissions for CAs, profiles, DMSs and reading devices/certificates.",{"_3394":1601,"_29710":1589,"_20617":53319,"_5":14139,"_27008":53283,"_2880":53320},[],"Bash, OpenSSL 3.x, curl with `--fail-with-body` and two terminals on your computer. Work in a new directory with restricted access.",{"_3394":1602,"_29710":1589,"_20617":53322,"_5":14139,"_27008":53283,"_2880":53323},[],"An active root CA that issues directly, with an available key and sufficient validity. Follow Create your first CA. Save its verified public certificate as `device-root.pem`.",{"_3394":1603,"_29710":1589,"_20617":53325,"_5":14139,"_27008":53283,"_2880":53326},[],"Available global identifier `est-device-001`. This path uses automatic registration: do not create the device in the console first.",{"_3394":1604,"_29710":1589,"_20617":53328,"_5":14139,"_27008":53283,"_2880":53329},[],"The approved root for Lamassu HTTPS in `est-trust.pem`, obtained through an independent channel. It can differ from the device CA; prepare networking/TLS in Deployment.",{"_3394":1605,"_29710":1589,"_20617":53331,"_5":14139,"_27008":53286,"_2880":53332},[],"Issue a bootstrap leaf certificate with `CN=est-device-001`, its own key and Client Authentication use. Follow Issue and verify a certificate, changing its CN and saving the result as `bootstrap.crt` and `bootstrap.key`. Choose validity that covers this test and check the pair and chain.",{"_3394":1606,"_29710":1589,"_20617":53334,"_5":14139,"_27008":53286,"_2880":53335},[],"The same root CA can issue it for this isolated evaluation. The operational identity will have a different key and certificate. The matching CN makes the example easier to read; initial certificate authentication does not itself bind the bootstrap CN to the requested ID. Review admission before applying the policy to a population.",{"_3394":1607,"_29710":1589,"_20617":53337,"_5":14139,"_27008":53290,"_2880":53338},[],"Create an explicit leaf profile compatible with EC P-256, with **Honor Subject**, CN from the CSR, **Digital Signature**, **Client Authentication** and **1 hour** validity within the root's validity. Do not enable CA signing. Rules and precedence are explained in Profiles.",{"_3394":1608,"_29710":1589,"_20617":53340,"_5":14139,"_27008":53290,"_2880":53341},[],"Create the `Acme EST Evaluation` DMS with this configuration:",{"_3394":1609,"_29710":1589,"_20617":53343,"_5":14139,"_27008":53290,"_2880":53344},[],"Setting",{"_3394":1610,"_29710":1589,"_20617":53346,"_5":14139,"_27008":53290,"_2880":53347},[],"Evaluation value",{"_3394":1611,"_29710":1589,"_20617":53349,"_5":14139,"_27008":53290,"_2880":53350},[],"Enrollment CA",{"_3394":1612,"_29710":1589,"_20617":53352,"_5":14139,"_27008":53290,"_2880":53353},[],"Issuing root from `device-root.pem`.",{"_3394":1613,"_29710":1589,"_20617":53355,"_5":14139,"_27008":53290,"_2880":51159},[],{"_3394":1614,"_29710":1589,"_20617":53357,"_5":14139,"_27008":53290,"_2880":53358},[],"The 1-hour leaf profile you just prepared.",{"_3394":1615,"_29710":1589,"_20617":53360,"_5":14139,"_27008":53290,"_2880":53361},[],"Protocol / Registration Mode",{"_3394":1616,"_29710":1589,"_20617":53363,"_5":14139,"_27008":53290,"_2880":53364},[],"`EST_RFC7030` / `JITP`.",{"_3394":1617,"_29710":1589,"_20617":53366,"_5":14139,"_27008":53290,"_2880":53367},[],"Verify CSR Signature",{"_3394":1618,"_29710":1589,"_20617":53369,"_5":14139,"_27008":53290,"_2880":53370},[],"Enabled.",{"_3394":1619,"_29710":1589,"_20617":53372,"_5":14139,"_27008":53290,"_2880":53373},[],"Enable Replaceable Enrollment",{"_3394":1620,"_29710":1589,"_20617":53375,"_5":14139,"_27008":53290,"_2880":53376},[],"Disabled; the ID must be new.",{"_3394":1621,"_29710":1589,"_20617":53378,"_5":14139,"_27008":53290,"_2880":53379},[],"Initial authentication",{"_3394":1622,"_29710":1589,"_20617":53381,"_5":14139,"_27008":53290,"_2880":53382},[],"`CLIENT_CERTIFICATE`; Validation CAs includes the direct bootstrap issuer; no expired certificates.",{"_3394":1623,"_29710":1589,"_20617":53384,"_5":14139,"_27008":53290,"_2880":53385},[],"Renewal authentication",{"_3394":1624,"_29710":1589,"_20617":53387,"_5":14139,"_27008":53290,"_2880":53388},[],"`CLIENT_CERTIFICATE`, configured in the independent re-enrollment block.",{"_3394":1625,"_29710":1589,"_20617":53390,"_5":14139,"_27008":53290,"_2880":53391},[],"Re-enrollment Validation CAs / Enable Expired Renewal",{"_3394":1626,"_29710":1589,"_20617":53393,"_5":14139,"_27008":53290,"_2880":53394},[],"Not needed for this direct issuance; the Enrollment CA is always trusted for re-enrollment / disabled.",{"_3394":1627,"_29710":1589,"_20617":53396,"_5":14139,"_27008":53290,"_2880":53397},[],"Re-enrollment Delta",{"_3394":1628,"_29710":1589,"_20617":53399,"_5":14139,"_27008":53290,"_2880":53400},[],"1 hour.",{"_3394":1629,"_29710":1589,"_20617":53402,"_5":14139,"_27008":53290,"_2880":53403},[],"Preventive / Critical Delta",{"_3394":1630,"_29710":1589,"_20617":53405,"_5":14139,"_27008":53290,"_2880":53406},[],"30 minutes / 10 minutes.",{"_3394":1631,"_29710":1589,"_20617":53408,"_5":14139,"_27008":53290,"_2880":53409},[],"Revoke on Re-enrollment",{"_3394":1632,"_29710":1589,"_20617":53411,"_5":14139,"_27008":53290,"_2880":53412},[],"Disabled to test the successor before retiring the previous identity.",{"_3394":1633,"_29710":1589,"_20617":53414,"_5":14139,"_27008":53290,"_2880":51167},[],{"_3394":1634,"_29710":1589,"_20617":53416,"_5":14139,"_27008":53290,"_2880":53417},[],"Disabled; the operational key is generated in the client.",{"_3394":1635,"_29710":1589,"_20617":53419,"_5":14139,"_27008":53290,"_2880":53420},[],"CA Distribution",{"_3394":1636,"_29710":1589,"_20617":53422,"_5":14139,"_27008":53290,"_2880":53423},[],"Include Enrollment CA enabled; Include Lamassu System CA disabled.",{"_3394":1637,"_29710":1589,"_20617":53425,"_5":14139,"_27008":53290,"_2880":53426},[],"Equal duration and window allow immediate renewal testing. These are evaluation values; size production settings according to connectivity and recovery times. Save, reread both authentication blocks and retain the DMS ID. The console exposes independent editors for the enrollment and re-enrollment authentication; the DMS guide describes their fields, and you can also check the resource through the DMS API.",{"_3394":1638,"_29710":1589,"_20617":53428,"_5":14139,"_27008":53294,"_2880":53429},[],"Place the four trust and bootstrap files in the new directory. Replace the URL with your installation's URL:",{"_3394":1639,"_29710":1589,"_20617":53431,"_5":14139,"_27008":53294,"_2880":53432},[],"The download must succeed and contain the expected enrollment root. Compare its fingerprint with `device-root.pem`. This check does not turn the response into initial trust or prove that you can issue.",{"_3394":1640,"_29710":1589,"_20617":53434,"_5":14139,"_27008":53298,"_2880":53435},[],"Generate a new key and CSR with the selected identifier:",{"_3394":1641,"_29710":1589,"_20617":53437,"_5":14139,"_27008":53298,"_2880":53438},[],"Request the identity with the bootstrap credential and extract the certificate from the default response:",{"_3394":1642,"_29710":1589,"_20617":53440,"_5":14139,"_27008":53298,"_2880":53441},[],"If curl fails, use Troubleshooting with the saved body. Do not convert it or repeat the request without querying inventory: a timeout or error can follow persisted issuance.",{"_3394":1643,"_29710":1589,"_20617":53443,"_5":14139,"_27008":53302,"_2880":53444},[],"Expect `device.crt: OK` and exit code 0 from `cmp`. Check the CN, serial, dates, Digital Signature and Client Authentication. The certificate must be a leaf: it must not declare `CA:TRUE` or Certificate Sign use. Check that its validity matches the one-hour profile.",{"_3394":1644,"_29710":1589,"_20617":53446,"_5":14139,"_27008":53302,"_2880":53447},[],"In Lamassu, open `est-device-001`. It must be created with the intended owning DMS, a current identity and the received certificate in its history. Compare the local serial with the slot; thresholds can show a renewal state rather than simply Active.",{"_3394":1645,"_29710":1589,"_20617":53449,"_5":14139,"_27008":53306,"_2880":53450},[],"In a second terminal, enter the same directory and run `umask 077`. Create a local server certificate and start a test consumer. This server trusts `device-root.pem` and requires a valid client identity:",{"_3394":1646,"_29710":1589,"_20617":53452,"_5":14139,"_27008":53306,"_2880":53453},[],"Leave it running. In the first terminal, connect using the obtained identity:",{"_3394":1647,"_29710":1589,"_20617":53455,"_5":14139,"_27008":53306,"_2880":53456},[],"Expect HTTP `200`. The client's trust in this local server is its self-signed `consumer.crt`; the server verifies the device against `device-root.pem`. The HTML file displays OpenSSL diagnostic information.",{"_3394":1648,"_29710":1589,"_20617":53458,"_5":14139,"_27008":53306,"_2880":53459},[],"With the same server still running, test that a request without a client certificate is rejected:",{"_3394":1649,"_29710":1589,"_20617":53461,"_5":14139,"_27008":53306,"_2880":53462},[],"Rejection must correspond to a missing certificate at the server, not a stopped server. Stop the consumer with Ctrl+C after the test. This exercise demonstrates TLS authentication and key possession; your application must also define authorization and revocation consumption. Server options are described in openssl-s\\_server.",{"_3394":1650,"_29710":1589,"_20617":53464,"_5":14139,"_27008":53310,"_2880":53465},[],"Check",{"_3394":1651,"_29710":1589,"_20617":53467,"_5":14139,"_27008":53310,"_2880":53468},[],"Expected result",{"_3394":1652,"_29710":1589,"_20617":53470,"_5":14139,"_27008":53310,"_2880":53471},[],"Registration",{"_3394":1653,"_29710":1589,"_20617":53473,"_5":14139,"_27008":53310,"_2880":53474},[],"ID created automatically and correct DMS.",{"_3394":1654,"_29710":1589,"_20617":53476,"_5":14139,"_27008":53310,"_2880":52732},[],{"_3394":1655,"_29710":1589,"_20617":53478,"_5":14139,"_27008":53310,"_2880":53479},[],"CN, profile, serial and key verified.",{"_3394":1656,"_29710":1589,"_20617":53481,"_5":14139,"_27008":53310,"_2880":53482},[],"Inventory",{"_3394":1657,"_29710":1589,"_20617":53484,"_5":14139,"_27008":53310,"_2880":53485},[],"Received serial visible as the current identity and in history.",{"_3394":1658,"_29710":1589,"_20617":53487,"_5":14139,"_27008":53310,"_2880":53488},[],"Consumer",{"_3394":1659,"_29710":1589,"_20617":53490,"_5":14139,"_27008":53310,"_2880":53491},[],"mTLS responds 200 with the identity and rejects a missing certificate.",{"_3394":1660,"_29710":1589,"_20617":53493,"_5":14139,"_27008":53310,"_2880":53494},[],"Continue with Renewal and recovery to request a successor pair within the window, install it and repeat the mTLS check. The consumer must use the new files in that test. After checking the successor, retire the previous certificate according to PKI policy; the example does not revoke it automatically.",{"_3394":1661,"_29710":1589,"_20617":53496,"_5":14139,"_27008":53310,"_2880":53497},[],"Devices and identities explains retirement and the limits of historical revocation. For a real destination, prepare consumer trust, validation and permissions; AWS IoT Core is an available integration.",{"_3394":1662,"_29710":1662,"_5":14491,"_2880":50864,"_30042":53499,"_20617":53500,"_27008":1662},[48369,49837,50848,53276],[],{"_3394":1663,"_29710":1662,"_20617":53502,"_5":14139,"_27008":1662,"_2880":53503},[],"Prepare a DMS, register a device and associate a verified certificate with its identity.",{"_3394":1664,"_29710":1662,"_5":30039,"_20617":53505,"_27008":53506,"_2880":48379},[],"/docs/platform/iot-fleets/quickstarts/register-device#before-you-begin",{"_3394":1665,"_29710":1662,"_5":30039,"_20617":53508,"_27008":53509,"_2880":53510},[],"/docs/platform/iot-fleets/quickstarts/register-device#prepare-the-dms","Prepare the DMS",{"_3394":1666,"_29710":1662,"_5":30039,"_20617":53512,"_27008":53513,"_2880":53514},[],"/docs/platform/iot-fleets/quickstarts/register-device#register-the-device","Register the device",{"_3394":1667,"_29710":1662,"_5":30039,"_20617":53516,"_27008":53517,"_2880":53518},[],"/docs/platform/iot-fleets/quickstarts/register-device#check-the-initial-status","Check the initial status",{"_3394":1668,"_29710":1662,"_5":30039,"_20617":53520,"_27008":53521,"_2880":53522},[],"/docs/platform/iot-fleets/quickstarts/register-device#assign-an-identity","Assign an identity",{"_3394":1669,"_29710":1662,"_5":30039,"_20617":53524,"_27008":53525,"_2880":53526},[],"/docs/platform/iot-fleets/quickstarts/register-device#verify-the-device","Verify the device",{"_3394":1670,"_29710":1662,"_5":30039,"_20617":53528,"_27008":53529,"_2880":53468},[],"/docs/platform/iot-fleets/quickstarts/register-device#expected-result",{"_3394":1671,"_29710":1662,"_5":30039,"_20617":53531,"_27008":53532,"_2880":53533},[],"/docs/platform/iot-fleets/quickstarts/register-device#if-the-result-fails","If the result fails",{"_3394":1672,"_29710":1662,"_5":30039,"_20617":53535,"_27008":53536,"_2880":53537},[],"/docs/platform/iot-fleets/quickstarts/register-device#automate-the-next-device","Automate the next device",{"_3394":1673,"_29710":1662,"_20617":53539,"_5":14139,"_27008":1662,"_2880":53540},[],"This path is intended for those starting to administer device identities. You will register `device-001` and assign an existing certificate to check the relationship between device, DMS and identity history.",{"_3394":1674,"_29710":1662,"_20617":53542,"_5":14139,"_27008":1662,"_2880":53543},[],"Assignment updates Lamassu's inventory. Install the key and certificate separately on the device; check the connection to a consumer in that destination's integration.",{"_3394":1675,"_29710":1662,"_20617":53545,"_5":14139,"_27008":53506,"_2880":53546},[],"An accessible instance and permission to administer DMSs, devices and certificate associations.",{"_3394":1676,"_29710":1662,"_20617":53548,"_5":14139,"_27008":53506,"_2880":53549},[],"An active CA with an available key. If one does not exist yet, follow Create your first CA.",{"_3394":1677,"_29710":1662,"_20617":53551,"_5":14139,"_27008":53506,"_2880":53552},[],"An active end-entity certificate from that CA whose `Common Name` is exactly `device-001`, together with its private key. Follow Issue and verify a certificate to obtain and check both.",{"_3394":1678,"_29710":1662,"_20617":53554,"_5":14139,"_27008":53506,"_2880":53555},[],"The identifier `device-001` available in the inventory. If you already used it, choose another and issue the certificate with that same `Common Name`.",{"_3394":1679,"_29710":1662,"_20617":53557,"_5":14139,"_27008":53509,"_2880":53558},[],"A DMS must exist before registering the device. If you already have a suitable one, check its CA and note its identifier; to create one:",{"_3394":1680,"_29710":1662,"_20617":53560,"_5":14139,"_27008":53509,"_2880":53561},[],"Open the DMS inventory and its creation action. Assign a recognizable name, such as `Acme Evaluation DMS`.",{"_3394":1681,"_29710":1662,"_20617":53563,"_5":14139,"_27008":53509,"_2880":53564},[],"In **Enrollment CA**, select the CA that issued `device.crt`.",{"_3394":1682,"_29710":1662,"_20617":53566,"_5":14139,"_27008":53509,"_2880":53567},[],"In **Registration Mode**, select `PRE_REGISTRATION` for the path that starts with explicit registration.",{"_3394":1683,"_29710":1662,"_20617":53569,"_5":14139,"_27008":53509,"_2880":53570},[],"In the authentication section, enable **Require client certificate** and leave **Call external webhook** off. Under **Require client certificate**, add the CA whose initial certificates you will accept to **Validation CAs**; for this evaluation, it can be the same CA. Keep **Verify CSR Signature** enabled and leave **Enable server-side key generation** off if you will not use it.",{"_3394":1684,"_29710":1662,"_20617":53572,"_5":14139,"_27008":53509,"_2880":53573},[],"Review renewal and trust distribution settings with the DMS guide, save the service and note its identifier.",{"_3394":1685,"_29710":1662,"_20617":53575,"_5":14139,"_27008":53509,"_2880":53576},[],"Reopen the DMS and confirm that the enrollment CA is the expected one and the service appears in inventory.",{"_3394":1686,"_29710":1662,"_20617":53578,"_5":14139,"_27008":53509,"_2880":53579},[],"These settings prepare DMS policy. The next steps register and assign through the console; they do not send an EST request or test admission through that protocol.",{"_3394":1687,"_29710":1662,"_20617":53581,"_5":14139,"_27008":53513,"_2880":53582},[],"Open **Managed Devices** and the registration action. Complete:",{"_3394":1688,"_29710":1662,"_20617":53584,"_5":14139,"_27008":53513,"_2880":53585},[],"**Device ID**: `device-001`.",{"_3394":1689,"_29710":1662,"_20617":53587,"_5":14139,"_27008":53513,"_2880":53588},[],"**Registration Authority**: the DMS you just prepared; this label identifies the service fulfilling the registration authority role.",{"_3394":1690,"_29710":1662,"_20617":53590,"_5":14139,"_27008":53513,"_2880":53591},[],"**Icon** and **Tags**: optional classification.",{"_3394":1691,"_29710":1662,"_20617":53593,"_5":14139,"_27008":53513,"_2880":53594},[],"Confirm registration.",{"_3394":1692,"_29710":1662,"_20617":53596,"_5":14139,"_27008":53517,"_2880":53597},[],"Open the device. It should appear in **No Identity** and show the selected owning DMS.",{"_3394":1693,"_29710":1662,"_20617":53599,"_5":14139,"_27008":53517,"_2880":53600},[],"Registration creates the inventory entry; the certificate must still be associated.",{"_3394":1694,"_29710":1662,"_20617":53602,"_5":14139,"_27008":53521,"_2880":53603},[],"Select **Assign Identity** and the existing certificate with `CN=device-001`. Check its serial number, issuer and validity against the certificate you verified in PKI.",{"_3394":1695,"_29710":1662,"_20617":53605,"_5":14139,"_27008":53521,"_2880":53606},[],"Confirm the association. The **Issue New Instead** alternative is explained in Devices and identities.",{"_3394":1696,"_29710":1662,"_20617":53608,"_5":14139,"_27008":53525,"_2880":53609},[],"Check that it has an active identity. In **Certificate History**, verify the associated serial number; in **Device Event Timeline**, find the assignment event.",{"_3394":1697,"_29710":1662,"_20617":53611,"_5":14139,"_27008":53525,"_2880":53612},[],"Keep the device identifier, owning DMS and serial number as references for the result.",{"_3394":1698,"_29710":1662,"_20617":53614,"_5":14139,"_27008":53529,"_2880":53465},[],{"_3394":1699,"_29710":1662,"_20617":53616,"_5":14139,"_27008":53529,"_2880":53617},[],"Result",{"_3394":1700,"_29710":1662,"_20617":53619,"_5":14139,"_27008":53529,"_2880":52715},[],{"_3394":1701,"_29710":1662,"_20617":53621,"_5":14139,"_27008":53529,"_2880":53622},[],"`device-001` appears in inventory with the expected DMS.",{"_3394":1702,"_29710":1662,"_20617":53624,"_5":14139,"_27008":53529,"_2880":53625},[],"Current identity",{"_3394":1703,"_29710":1662,"_20617":53627,"_5":14139,"_27008":53529,"_2880":53628},[],"The associated certificate matches the one you verified in PKI.",{"_3394":1704,"_29710":1662,"_20617":53630,"_5":14139,"_27008":53529,"_2880":53631},[],"History",{"_3394":1705,"_29710":1662,"_20617":53633,"_5":14139,"_27008":53529,"_2880":53634},[],"The associated issuance appears with its serial number and dates.",{"_3394":1706,"_29710":1662,"_20617":53636,"_5":14139,"_27008":53529,"_2880":53637},[],"Key and certificate",{"_3394":1707,"_29710":1662,"_20617":53639,"_5":14139,"_27008":53529,"_2880":53640},[],"You have the verified pair ready to install on the device.",{"_3394":1708,"_29710":1662,"_20617":53642,"_5":14139,"_27008":53532,"_2880":53643},[],"If you cannot select the DMS, confirm its creation and your read permissions.",{"_3394":1709,"_29710":1662,"_20617":53645,"_5":14139,"_27008":53532,"_2880":53646},[],"If no eligible certificate appears, check that its `Common Name` matches the `Device ID` exactly, it is active and it was issued by the expected CA.",{"_3394":1710,"_29710":1662,"_20617":53648,"_5":14139,"_27008":53532,"_2880":53649},[],"If assignment fails, review permissions and operation diagnostics before repeating it. Query the device and its history again to find the persisted result.",{"_3394":1711,"_29710":1662,"_20617":53651,"_5":14139,"_27008":53532,"_2880":53652},[],"If an expiration or renewal state appears, check certificate dates and DMS thresholds in Devices and identities.",{"_3394":1712,"_29710":1662,"_20617":53654,"_5":14139,"_27008":53536,"_2880":53655},[],"Continue with DMS and EST for the device to request and renew certificates. Prepare server trust, the initial credential and policies for each operation before implementing the client.",{"_3394":1713,"_29710":1662,"_20617":53657,"_5":14139,"_27008":53536,"_2880":53658},[],"For a path from the client through mTLS, follow Enroll and connect your first device with a new ID.",{"_3394":1714,"_29710":1662,"_20617":53660,"_5":14139,"_27008":53536,"_2880":53661},[],"To use the identity in AWS IoT Core, also prepare trust and permissions in the destination. Check the connection from the device after installing the required key, certificate and chain.",{"_3394":1715,"_29710":1715,"_5":14491,"_2880":53663,"_30042":53664,"_20617":53665,"_27008":1715},"Lamassu IoT Platform",[48369,49837],[],{"_3394":1716,"_29710":1715,"_20617":53667,"_5":14139,"_27008":1715,"_2880":53668},[],"Build a PKI and apply its certificates to your devices' lifecycle.",{"_3394":1717,"_29710":1715,"_5":30039,"_20617":53670,"_27008":53671,"_2880":53151},[],"/docs/platform/overview#start-here",{"_3394":1718,"_29710":1715,"_5":30039,"_20617":53673,"_27008":53674,"_2880":53675},[],"/docs/platform/overview#choose-your-path","Choose your path",{"_3394":1719,"_29710":1715,"_5":30039,"_20617":53677,"_27008":53678,"_2880":53679},[],"/docs/platform/overview#architecture-at-a-glance","Architecture at a glance",{"_3394":1720,"_29710":1715,"_5":30039,"_20617":53681,"_27008":53682,"_2880":53683},[],"/docs/platform/overview#core-capabilities","Core capabilities",{"_3394":1721,"_29710":1715,"_5":30039,"_20617":53685,"_27008":53686,"_2880":53687},[],"/docs/platform/overview#build-your-trust-hierarchy","Build your trust hierarchy",{"_3394":1722,"_29710":1715,"_5":30039,"_20617":53689,"_27008":53690,"_2880":53691},[],"/docs/platform/overview#protect-cryptographic-keys","Protect cryptographic keys",{"_3394":1723,"_29710":1715,"_5":30039,"_20617":53693,"_27008":53694,"_2880":53695},[],"/docs/platform/overview#issue-and-control-certificates","Issue and control certificates",{"_3394":1724,"_29710":1715,"_5":30039,"_20617":53697,"_27008":53698,"_2880":53699},[],"/docs/platform/overview#automate-device-identities","Automate device identities",{"_3394":1725,"_29710":1715,"_5":30039,"_20617":53701,"_27008":53702,"_2880":53703},[],"/docs/platform/overview#publish-validation-status","Publish validation status",{"_3394":1726,"_29710":1715,"_5":30039,"_20617":53705,"_27008":53706,"_2880":53707},[],"/docs/platform/overview#react-to-events","React to events",{"_3394":1727,"_29710":1715,"_5":30039,"_20617":53709,"_27008":53710,"_2880":53711},[],"/docs/platform/overview#operational-reference","Operational reference",{"_3394":1728,"_29710":1715,"_20617":53713,"_5":14139,"_27008":1715,"_2880":53714},[],"Lamassu IoT lets you administer a private PKI and use it to issue, renew and revoke X.509 device identities. The Platform documentation follows two paths: **PKI**, for authorities and certificates, and **IoT Fleets**, for applying those identities to a device population.",{"_3394":1729,"_29710":1715,"_20617":53716,"_5":14139,"_27008":53671,"_2880":53717},[],"Choose the result you need:",{"_3394":1730,"_29710":1715,"_20617":53719,"_5":14139,"_27008":53671,"_2880":53720},[],"<Card title=\"Issue and verify a certificate\" description=\"Prepare a CA, issue an X.509 identity and check its chain and key.\" href=\"/docs/platform/pki/quickstarts/overview\" />",{"_3394":1731,"_29710":1715,"_20617":53722,"_5":14139,"_27008":53671,"_2880":53723},[],"<Card title=\"Enroll and connect a device\" description=\"Prepare the DMS, request an identity through EST and check an mTLS connection.\" href=\"/docs/platform/iot-fleets/quickstarts/enroll-device\" />",{"_3394":1732,"_29710":1715,"_20617":53725,"_5":14139,"_27008":53671,"_2880":53726},[],"If you are still preparing the instance, start in Deployment. The Platform paths assume an accessible console and permission to perform the operations.",{"_3394":1733,"_29710":1715,"_20617":53728,"_5":14139,"_27008":53674,"_2880":53729},[],"Section",{"_3394":1734,"_29710":1715,"_20617":53731,"_5":14139,"_27008":53674,"_2880":53732},[],"What you manage",{"_3394":1735,"_29710":1715,"_20617":53734,"_5":14139,"_27008":53674,"_2880":53735},[],"Entry point",{"_3394":1736,"_29710":1715,"_20617":53737,"_5":14139,"_27008":53674,"_2880":53738},[],"**PKI**",{"_3394":1737,"_29710":1715,"_20617":53740,"_5":14139,"_27008":53674,"_2880":53741},[],"Keys, authorities, profiles, certificates and publication of revocation status.",{"_3394":1738,"_29710":1715,"_20617":53743,"_5":14139,"_27008":53674,"_2880":53744},[],"PKI overview",{"_3394":1739,"_29710":1715,"_20617":53746,"_5":14139,"_27008":53674,"_2880":53747},[],"**IoT Fleets**",{"_3394":1740,"_29710":1715,"_20617":53749,"_5":14139,"_27008":53674,"_2880":53750},[],"Devices, identity history, DMS policies, EST enrollment and integrations.",{"_3394":1741,"_29710":1715,"_20617":53752,"_5":14139,"_27008":53674,"_2880":53753},[],"IoT Fleets overview",{"_3394":1742,"_29710":1715,"_20617":53755,"_5":14139,"_27008":53674,"_2880":53756},[],"**Administration**",{"_3394":1743,"_29710":1715,"_20617":53758,"_5":14139,"_27008":53674,"_2880":53759},[],"Operator permissions, audit and event subscriptions.",{"_3394":1744,"_29710":1715,"_20617":53761,"_5":14139,"_27008":53674,"_2880":49835},[],{"_3394":1745,"_29710":1715,"_20617":53763,"_5":14139,"_27008":53674,"_2880":53764},[],"A CA determines who signs, and a profile defines what can be issued. The DMS applies admission and enrollment policy. The device retains its association with certificates, and the external consumer decides which identity it accepts.",{"_3394":1746,"_29710":1715,"_20617":53766,"_5":14139,"_27008":53678,"_2880":53767},[],"An identity's journey connects four responsibilities:",{"_3394":1747,"_29710":1715,"_20617":53769,"_5":14139,"_27008":53678,"_2880":53770},[],"The PKI administrator prepares the authority, its key and issuance rules.",{"_3394":1748,"_29710":1715,"_20617":53772,"_5":14139,"_27008":53678,"_2880":53773},[],"The provisioning administrator configures the DMS and initial trust.",{"_3394":1749,"_29710":1715,"_20617":53775,"_5":14139,"_27008":53678,"_2880":53776},[],"The device client requests a certificate and installs it with the matching key.",{"_3394":1750,"_29710":1715,"_20617":53778,"_5":14139,"_27008":53678,"_2880":53779},[],"The consumer validates the identity and applies its access permissions.",{"_3394":1751,"_29710":1715,"_20617":53781,"_5":14139,"_27008":53678,"_2880":53782},[],"See How Lamassu works to understand the resources and platform architecture for the services. Installation, network exposure and dependencies are explained in Deployment.",{"_3394":1752,"_29710":1715,"_20617":53784,"_5":14139,"_27008":53686,"_2880":53785},[],"Create or incorporate authorities and organize their relationships in PKI. The hierarchy and its rotation determine which chains consumers must recognize.",{"_3394":1753,"_29710":1715,"_20617":53787,"_5":14139,"_27008":53690,"_2880":53788},[],"Choose the engine that keeps authority keys and control who can use them. See Keys and engines; provider setup belongs to deployment.",{"_3394":1754,"_29710":1715,"_20617":53790,"_5":14139,"_27008":53694,"_2880":53791},[],"Define issuance profiles, sign requests and review the certificate inventory. Check the issued certificate from the client that will use it.",{"_3394":1755,"_29710":1715,"_20617":53793,"_5":14139,"_27008":53698,"_2880":53794},[],"Configure a DMS and use EST to request and renew certificates. Preparing the initial credential and installing the result belong to device integration.",{"_3394":1756,"_29710":1715,"_20617":53796,"_5":14139,"_27008":53702,"_2880":53797},[],"Use OCSP and CRL to publish revocation status. Each consumer must configure how it retrieves and applies that information.",{"_3394":1757,"_29710":1715,"_20617":53799,"_5":14139,"_27008":53706,"_2880":53800},[],"Use audit logs to investigate changes and configure alerts and subscriptions to react to lifecycle events.",{"_3394":1758,"_29710":1715,"_20617":53802,"_5":14139,"_27008":53710,"_2880":53245},[],{"_3394":1759,"_29710":1715,"_20617":53804,"_5":14139,"_27008":53710,"_2880":53805},[],"What it prepares or checks",{"_3394":1760,"_29710":1715,"_20617":53807,"_5":14139,"_27008":53710,"_2880":53248},[],{"_3394":1761,"_29710":1715,"_20617":53809,"_5":14139,"_27008":53710,"_2880":53810},[],"Key custody, CA hierarchy, profiles and validation.",{"_3394":1762,"_29710":1715,"_20617":53812,"_5":14139,"_27008":53710,"_2880":53813},[],"Fleet administrator",{"_3394":1763,"_29710":1715,"_20617":53815,"_5":14139,"_27008":53710,"_2880":53816},[],"DMS, device admission, renewal policy and inventory.",{"_3394":1764,"_29710":1715,"_20617":53818,"_5":14139,"_27008":53710,"_2880":53260},[],{"_3394":1765,"_29710":1715,"_20617":53820,"_5":14139,"_27008":53710,"_2880":53821},[],"Initial credential, server trust, EST client, and key and certificate storage.",{"_3394":1766,"_29710":1715,"_20617":53823,"_5":14139,"_27008":53710,"_2880":53266},[],{"_3394":1767,"_29710":1715,"_20617":53825,"_5":14139,"_27008":53710,"_2880":53826},[],"Issuer trust, certificate validation and permissions in the destination.",{"_3394":1768,"_29710":1715,"_20617":53828,"_5":14139,"_27008":53710,"_2880":53829},[],"Infrastructure operator",{"_3394":1769,"_29710":1715,"_20617":53831,"_5":14139,"_27008":53710,"_2880":53832},[],"Installation, network, availability, dependencies and deployment diagnosis.",{"_3394":1770,"_29710":1715,"_20617":53834,"_5":14139,"_27008":53710,"_2880":53835},[],"The API reference contains contracts for automating operations. To investigate a failure, start in the affected section: PKI, EST or Deployment.",{"_3394":1771,"_29710":1771,"_5":14491,"_2880":53837,"_30042":53838,"_20617":53841,"_27008":1771},"CA hierarchy and rotation",[48369,49837,53839,53840],"PKI","Keys, authorities and certificates",[],{"_3394":1772,"_29710":1771,"_20617":53843,"_5":14139,"_27008":1771,"_2880":53844},[],"Design root and intermediate authorities and replace certificates or keys without breaking trust.",{"_3394":1773,"_29710":1771,"_5":30039,"_20617":53846,"_27008":53847,"_2880":53848},[],"/docs/platform/pki/ca-hierarchy-and-rotation#design-the-hierarchy","Design the hierarchy",{"_3394":1774,"_29710":1771,"_5":30039,"_20617":53850,"_27008":53851,"_2880":53852},[],"/docs/platform/pki/ca-hierarchy-and-rotation#reissuance-and-rotation-are-not-the-same","Reissuance and rotation are not the same",{"_3394":1775,"_29710":1771,"_5":30039,"_20617":53854,"_27008":53855,"_2880":53856},[],"/docs/platform/pki/ca-hierarchy-and-rotation#when-to-choose-each-operation","When to choose each operation",{"_3394":1776,"_29710":1771,"_5":30039,"_20617":53858,"_27008":53859,"_2880":53860},[],"/docs/platform/pki/ca-hierarchy-and-rotation#key-rotation-procedure","Key rotation procedure",{"_3394":1777,"_29710":1771,"_5":30039,"_20617":53862,"_27008":53863,"_2880":53864},[],"/docs/platform/pki/ca-hierarchy-and-rotation#inventory-the-dependencies","Inventory the dependencies",{"_3394":1778,"_29710":1771,"_5":30039,"_20617":53866,"_27008":53867,"_2880":53868},[],"/docs/platform/pki/ca-hierarchy-and-rotation#create-the-successor-ca","Create the successor CA",{"_3394":1779,"_29710":1771,"_5":30039,"_20617":53870,"_27008":53871,"_2880":53872},[],"/docs/platform/pki/ca-hierarchy-and-rotation#distribute-the-new-trust","Distribute the new trust",{"_3394":1780,"_29710":1771,"_5":30039,"_20617":53874,"_27008":53875,"_2880":53876},[],"/docs/platform/pki/ca-hierarchy-and-rotation#switch-issuance","Switch issuance",{"_3394":1781,"_29710":1771,"_5":30039,"_20617":53878,"_27008":53879,"_2880":53880},[],"/docs/platform/pki/ca-hierarchy-and-rotation#renew-in-batches","Renew in batches",{"_3394":1782,"_29710":1771,"_5":30039,"_20617":53882,"_27008":53883,"_2880":53884},[],"/docs/platform/pki/ca-hierarchy-and-rotation#close-the-overlap","Close the overlap",{"_3394":1783,"_29710":1771,"_5":30039,"_20617":53886,"_27008":53887,"_2880":53888},[],"/docs/platform/pki/ca-hierarchy-and-rotation#cascading-revocation","Cascading revocation",{"_3394":1784,"_29710":1771,"_5":30039,"_20617":53890,"_27008":53891,"_2880":53892},[],"/docs/platform/pki/ca-hierarchy-and-rotation#checks-after-the-change","Checks after the change",{"_3394":1785,"_29710":1771,"_20617":53894,"_5":14139,"_27008":1771,"_2880":53895},[],"The hierarchy determines the blast radius of any error or compromise. A root signs intermediate CAs; intermediates issue the identities used by devices and services. This separation lets you isolate environments and rotate a branch without replacing all trust.",{"_3394":1786,"_29710":1771,"_20617":53897,"_5":14139,"_27008":1771,"_2880":53898},[],"This procedure is for the PKI operator replacing an authority in use. You need access to CAs, keys and profiles, a dependency inventory and coordination with trust-store and device owners. Before switching issuance, prepare a test cohort and decide the criterion for ending overlap.",{"_3394":1787,"_29710":1771,"_20617":53900,"_5":14139,"_27008":53847,"_2880":53901},[],"For a production installation, use a very restricted root and one or more operational intermediates. Separate intermediates when any of these boundaries change:",{"_3394":1788,"_29710":1771,"_20617":53903,"_5":14139,"_27008":53847,"_2880":53904},[],"environment, such as production and preproduction;",{"_3394":1789,"_29710":1771,"_20617":53906,"_5":14139,"_27008":53847,"_2880":53907},[],"owner or operating team;",{"_3394":1790,"_29710":1771,"_20617":53909,"_5":14139,"_27008":53847,"_2880":53910},[],"device family or manufacturing process;",{"_3394":1791,"_29710":1771,"_20617":53912,"_5":14139,"_27008":53847,"_2880":53913},[],"region or regulatory requirement;",{"_3394":1792,"_29710":1771,"_20617":53915,"_5":14139,"_27008":53847,"_2880":53916},[],"cryptographic engine or key policy;",{"_3394":1793,"_29710":1771,"_20617":53918,"_5":14139,"_27008":53847,"_2880":53919},[],"maintenance window and renewal cadence.",{"_3394":1794,"_29710":1771,"_20617":53921,"_5":14139,"_27008":53847,"_2880":53922},[],"Avoid deep hierarchies without a concrete need. Each level adds chain distribution, validation and one more certificate you must renew.",{"_3394":1795,"_29710":1771,"_20617":53924,"_5":14139,"_27008":53847,"_2880":53925},[],"A child CA and its end-entity certificates must expire before their issuer. Reserve a margin that allows distributing another chain and renewing dependent certificates.",{"_3394":1796,"_29710":1771,"_20617":53927,"_5":14139,"_27008":53851,"_2880":53928},[],"**Reissuing a CA** creates a new certificate over the existing key. Lamassu generates a CSR with that key, self-signs it if it is a root or asks the parent CA to sign it if it is subordinate. The new certificate becomes active and the CA points to its serial number; the old and new certificates are linked through metadata.",{"_3394":1797,"_29710":1771,"_20617":53930,"_5":14139,"_27008":53851,"_2880":53931},[],"If a VA CRL role for the CA is signed by the superseded CA certificate, reissuing moves the signer to the new certificate — provided it carries `cRLSign` — and republishes the CRL. Otherwise, and for a role signed by a different certificate, the role keeps its signer, so check the new certificate’s key usage after reissuing; see the CRL guide.",{"_3394":1798,"_29710":1771,"_20617":53933,"_5":14139,"_27008":53851,"_2880":53934},[],"**Rotating a CA** creates a successor key and authority. It is the right choice in the face of compromise, a cryptographic change, an engine migration or non-exportable key policies.",{"_3394":1799,"_29710":1771,"_20617":53936,"_5":14139,"_27008":53851,"_2880":53937},[],"Lamassu does not allow reissuing an already-revoked CA or a CA whose expiration date has passed. Plan ahead for both conditions.",{"_3394":1800,"_29710":1771,"_20617":53939,"_5":14139,"_27008":53855,"_2880":53940},[],"Reissue if the key is still trustworthy and you only need another validity period or an updated certificate.",{"_3394":1801,"_29710":1771,"_20617":53942,"_5":14139,"_27008":53855,"_2880":53943},[],"Rotate the key if compromise is suspected, the algorithm changes or you want to move custody to another engine.",{"_3394":1802,"_29710":1771,"_20617":53945,"_5":14139,"_27008":53855,"_2880":53946},[],"Create a parallel branch if you cannot update all consumers at the same time.",{"_3394":1803,"_29710":1771,"_20617":53948,"_5":14139,"_27008":53855,"_2880":53949},[],"Revoke immediately only when the risk of keeping the CA outweighs the impact of interrupting the fleet.",{"_3394":1804,"_29710":1771,"_20617":53951,"_5":14139,"_27008":53863,"_2880":53952},[],"Locate child CAs, issued certificates, DMSs, connectors and external trust stores. Include devices that may stay offline for weeks or months.",{"_3394":1805,"_29710":1771,"_20617":53954,"_5":14139,"_27008":53867,"_2880":53955},[],"Generate a new key in the planned engine, create the CA and assign it an explicit profile. Do not reuse the operational identifier to hide that it is a different generation.",{"_3394":1806,"_29710":1771,"_20617":53957,"_5":14139,"_27008":53871,"_2880":53958},[],"Add the new root or chain to consumers before issuing with it. If distributing through EST `/cacerts`, explicitly include the required managed CAs and inspect the content; including the issuer does not automatically include every intermediate. Install the new trust in a cohort and verify that it still accepts the previous identity.",{"_3394":1807,"_29710":1771,"_20617":53960,"_5":14139,"_27008":53875,"_2880":53961},[],"Update the enrollment CA and profile of the DMSs. While old-CA cohorts still renew, add the previous enrollment CA to each DMS's re-enrollment validation CAs (`reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`): the new enrollment CA is trusted automatically, but the old one was the enrollment CA and appears in no re-enrollment trust list, so without that entry its certificates can no longer renew. The DMS guide documents the setting.",{"_3394":1808,"_29710":1771,"_20617":53963,"_5":14139,"_27008":53879,"_2880":53964},[],"Migrate a small cohort, validate mTLS, OCSP and CRL from the consumer and expand progressively. Monitor which devices still present the old chain.",{"_3394":1809,"_29710":1771,"_20617":53966,"_5":14139,"_27008":53883,"_2880":53967},[],"Once no legitimate consumer depends on the previous authority, remove it from issuance, from the re-enrollment validation CAs and from the distributed CAs. Revoke it if policy requires it.",{"_3394":1810,"_29710":1771,"_20617":53969,"_5":14139,"_27008":53887,"_2880":53970},[],"Lamassu saves the CA’s revocation, then attempts to revoke child CAs and issued certificates with `CessationOfOperation`. Propagation continues recursively through child CAs. This is not a transaction over the whole hierarchy: some resources may have changed while other updates failed.",{"_3394":1811,"_29710":1771,"_20617":53972,"_5":14139,"_27008":53887,"_2880":53973},[],"Resources in `EXPIRED` state and resources already revoked for a final reason reject further status transitions. Per-descendant failures are logged; review the inventory and logs even when the parent operation completes.",{"_3394":1812,"_29710":1771,"_20617":53975,"_5":14139,"_27008":53887,"_2880":53976},[],"`CertificateHold` allows reactivating the parent while it is not expired, but does not restore child CAs or certificates permanently revoked during the cascade. Holding a CA therefore does not provide a reversible pause for its entire branch.",{"_3394":1813,"_29710":1771,"_20617":53978,"_5":14139,"_27008":53887,"_2880":53979},[],"Before closing the change, compare the original dependency inventory with final states and verify revocation publication for each issuer. Do not use revocation as the ordinary mechanism to stop issuance: complete migration and remove the CA from operational flows.",{"_3394":1814,"_29710":1771,"_20617":53981,"_5":14139,"_27008":53891,"_2880":53982},[],"The new chain ends in an anchor installed by the consumer.",{"_3394":1815,"_29710":1771,"_20617":53984,"_5":14139,"_27008":53891,"_2880":53985},[],"New certificates contain the expected AKI, SKI, KU, EKU and SAN.",{"_3394":1816,"_29710":1771,"_20617":53987,"_5":14139,"_27008":53891,"_2880":53988},[],"The DMS delivers the correct chain through EST `/cacerts`.",{"_3394":1817,"_29710":1771,"_20617":53990,"_5":14139,"_27008":53891,"_2880":53991},[],"Re-enrollment accepts the old identity during the planned period.",{"_3394":1818,"_29710":1771,"_20617":53993,"_5":14139,"_27008":53891,"_2880":53994},[],"OCSP and CRL respond for the authorities that remain active.",{"_3394":1819,"_29710":1771,"_20617":53996,"_5":14139,"_27008":53891,"_2880":53997},[],"No DMS is left accidentally issuing from the old CA.",{"_3394":1820,"_29710":1771,"_20617":53999,"_5":14139,"_27008":53891,"_2880":54000},[],"See the Trust model to understand the DMS's CA sets and Certificate lifecycle for states and revocation effects.",{"_3394":1821,"_29710":1821,"_5":14491,"_2880":54002,"_30042":54003,"_20617":54004,"_27008":1821},"Certification authorities",[48369,49837,53839,53840],[],{"_3394":1822,"_29710":1821,"_20617":54006,"_5":14139,"_27008":1821,"_2880":54007},[],"Create, import and operate the authorities that establish your PKI's trust.",{"_3394":1823,"_29710":1821,"_5":30039,"_20617":54009,"_27008":54010,"_2880":54011},[],"/docs/platform/pki/certificate-authorities#choose-a-flow","Choose a flow",{"_3394":1824,"_29710":1821,"_5":30039,"_20617":54013,"_27008":54014,"_2880":54015},[],"/docs/platform/pki/certificate-authorities#create-a-new-authority","Create a new authority",{"_3394":1825,"_29710":1821,"_5":30039,"_20617":54017,"_27008":54018,"_2880":48379},[],"/docs/platform/pki/certificate-authorities#before-you-begin",{"_3394":1826,"_29710":1821,"_5":30039,"_20617":54020,"_27008":54021,"_2880":54022},[],"/docs/platform/pki/certificate-authorities#open-the-wizard","Open the wizard",{"_3394":1827,"_29710":1821,"_5":30039,"_20617":54024,"_27008":54025,"_2880":54026},[],"/docs/platform/pki/certificate-authorities#configure-the-key","Configure the key",{"_3394":1828,"_29710":1821,"_5":30039,"_20617":54028,"_27008":54029,"_2880":54030},[],"/docs/platform/pki/certificate-authorities#choose-the-ca-type","Choose the CA type",{"_3394":1829,"_29710":1821,"_5":30039,"_20617":54032,"_27008":54033,"_2880":54034},[],"/docs/platform/pki/certificate-authorities#define-the-identity","Define the identity",{"_3394":1830,"_29710":1821,"_5":30039,"_20617":54036,"_27008":54037,"_2880":54038},[],"/docs/platform/pki/certificate-authorities#configure-validity-and-uses","Configure validity and uses",{"_3394":1831,"_29710":1821,"_5":30039,"_20617":54040,"_27008":54041,"_2880":54042},[],"/docs/platform/pki/certificate-authorities#create-and-verify","Create and verify",{"_3394":1832,"_29710":1821,"_5":30039,"_20617":54044,"_27008":54045,"_2880":54046},[],"/docs/platform/pki/certificate-authorities#use-a-key-from-the-kms","Use a key from the KMS",{"_3394":1833,"_29710":1821,"_5":30039,"_20617":54048,"_27008":54049,"_2880":54050},[],"/docs/platform/pki/certificate-authorities#import-an-external-ca","Import an external CA",{"_3394":1834,"_29710":1821,"_5":30039,"_20617":54052,"_27008":54053,"_2880":54054},[],"/docs/platform/pki/certificate-authorities#select-the-engine","Select the engine",{"_3394":1835,"_29710":1821,"_5":30039,"_20617":54056,"_27008":54057,"_2880":54058},[],"/docs/platform/pki/certificate-authorities#load-the-material","Load the material",{"_3394":1836,"_29710":1821,"_5":30039,"_20617":54060,"_27008":54061,"_2880":54062},[],"/docs/platform/pki/certificate-authorities#define-the-default-issuance","Define the default issuance",{"_3394":1837,"_29710":1821,"_5":30039,"_20617":54064,"_27008":54065,"_2880":54066},[],"/docs/platform/pki/certificate-authorities#verify-the-import","Verify the import",{"_3394":1838,"_29710":1821,"_5":30039,"_20617":54068,"_27008":54069,"_2880":54070},[],"/docs/platform/pki/certificate-authorities#inspect-an-authority","Inspect an authority",{"_3394":1839,"_29710":1821,"_5":30039,"_20617":54072,"_27008":54073,"_2880":54074},[],"/docs/platform/pki/certificate-authorities#issue-certificates","Issue certificates",{"_3394":1840,"_29710":1821,"_5":30039,"_20617":54076,"_27008":54077,"_2880":54078},[],"/docs/platform/pki/certificate-authorities#revoke-a-ca","Revoke a CA",{"_3394":1841,"_29710":1821,"_5":30039,"_20617":54080,"_27008":54081,"_2880":54082},[],"/docs/platform/pki/certificate-authorities#assess-the-impact","Assess the impact",{"_3394":1842,"_29710":1821,"_5":30039,"_20617":54084,"_27008":54085,"_2880":54086},[],"/docs/platform/pki/certificate-authorities#start-the-revocation","Start the revocation",{"_3394":1843,"_29710":1821,"_5":30039,"_20617":54088,"_27008":54089,"_2880":54090},[],"/docs/platform/pki/certificate-authorities#confirm-the-identity","Confirm the identity",{"_3394":1844,"_29710":1821,"_5":30039,"_20617":54092,"_27008":54093,"_2880":54094},[],"/docs/platform/pki/certificate-authorities#check-the-publication","Check the publication",{"_3394":1845,"_29710":1821,"_5":30039,"_20617":54096,"_27008":54097,"_2880":54098},[],"/docs/platform/pki/certificate-authorities#delete-a-ca","Delete a CA",{"_3394":1846,"_29710":1821,"_20617":54100,"_5":14139,"_27008":1821,"_2880":54101},[],"A certification authority (CA) binds identities to public keys through signed certificates. In Lamassu you can create a new hierarchy, use a key already in the KMS or incorporate an external CA.",{"_3394":1847,"_29710":1821,"_20617":54103,"_5":14139,"_27008":1821,"_2880":54104},[],"To design a full chain or replace an authority in production, see CA hierarchy and rotation. If you need to standardize what each authority can sign, use Certificate profiles.",{"_3394":1848,"_29710":1821,"_20617":54106,"_5":14139,"_27008":1821,"_2880":54107},[],"To administer CAs, you need authority and key permissions, a reachable engine and a reviewed profile. An external consumer does not trust a CA merely because it appears in this inventory: agree root and chain distribution separately.",{"_3394":1849,"_29710":1821,"_20617":54109,"_5":14139,"_27008":54010,"_2880":54110},[],"**New CA with a new key:** create a root of trust from scratch. Lamassu generates and keeps the key pair.",{"_3394":1850,"_29710":1821,"_20617":54112,"_5":14139,"_27008":54010,"_2880":54113},[],"**New CA from the KMS:** reuse a key already registered in the platform.",{"_3394":1851,"_29710":1821,"_20617":54115,"_5":14139,"_27008":54010,"_2880":54116},[],"**Import a CA with its private key:** incorporate an external authority that Lamassu can issue with.",{"_3394":1852,"_29710":1821,"_20617":54118,"_5":14139,"_27008":54010,"_2880":54119},[],"**Import only the certificate:** register public material. If Lamassu finds its key in the KMS, it can associate it; otherwise, the CA has no usable key for issuance.",{"_3394":1853,"_29710":1821,"_20617":54121,"_5":14139,"_27008":54010,"_2880":54122},[],"First time here? Follow Create your first CA to complete the minimal journey.",{"_3394":1854,"_29710":1821,"_20617":54124,"_5":14139,"_27008":54018,"_2880":54125},[],"Decide whether the CA will be a root or an intermediate.",{"_3394":1855,"_29710":1821,"_20617":54127,"_5":14139,"_27008":54018,"_2880":54128},[],"Choose the engine that will keep the key.",{"_3394":1856,"_29710":1821,"_20617":54130,"_5":14139,"_27008":54018,"_2880":54131},[],"Define a validity longer than that of the certificates it will issue.",{"_3394":1857,"_29710":1821,"_20617":54133,"_5":14139,"_27008":54018,"_2880":54134},[],"For an intermediate CA, make sure the parent CA is active.",{"_3394":1858,"_29710":1821,"_20617":54136,"_5":14139,"_27008":54021,"_2880":54137},[],"In **Certification Authorities**, select **Create New CA** and choose to generate a new key pair.",{"_3394":1859,"_29710":1821,"_20617":54139,"_5":14139,"_27008":54025,"_2880":54140},[],"Select the cryptographic engine, the algorithm and the size or curve. Lamassu supports RSA and EC keys according to the engine's capabilities.",{"_3394":1860,"_29710":1821,"_20617":54142,"_5":14139,"_27008":54025,"_2880":54143},[],"Use only sizes and curves supported by the engine and the profile’s cryptographic policy. Read Keys and engines before reusing external material.",{"_3394":1861,"_29710":1821,"_20617":54145,"_5":14139,"_27008":54029,"_2880":54146},[],"Select **Root CA** for a self-signed authority or **Intermediate CA** for an authority signed by another CA. In the latter case, choose the issuing CA.",{"_3394":1862,"_29710":1821,"_20617":54148,"_5":14139,"_27008":54033,"_2880":54149},[],"Enter a unique **CA Name**. This name becomes the certificate's `Common Name`. Complete the Distinguished Name fields your policy requires:",{"_3394":1863,"_29710":1821,"_20617":54151,"_5":14139,"_27008":54033,"_2880":54152},[],"`C`: two-letter ISO 3166-1 country code.",{"_3394":1864,"_29710":1821,"_20617":54154,"_5":14139,"_27008":54033,"_2880":54155},[],"`ST`: state or province.",{"_3394":1865,"_29710":1821,"_20617":54157,"_5":14139,"_27008":54033,"_2880":54158},[],"`L`: locality.",{"_3394":1866,"_29710":1821,"_20617":54160,"_5":14139,"_27008":54033,"_2880":54161},[],"`O`: organization.",{"_3394":1867,"_29710":1821,"_20617":54163,"_5":14139,"_27008":54033,"_2880":54164},[],"`OU`: organizational unit.",{"_3394":1868,"_29710":1821,"_20617":54166,"_5":14139,"_27008":54033,"_2880":54167},[],"The CA's internal identifier is generated automatically and cannot be changed.",{"_3394":1869,"_29710":1821,"_20617":54169,"_5":14139,"_27008":54037,"_2880":54170},[],"Define **CA Certificate Expiration** and **Default End-Entity Certificate Issuance Expiration**. You can express a duration (`5y 8w 4d`), pick a date or use the maximum allowed date.",{"_3394":1870,"_29710":1821,"_20617":54172,"_5":14139,"_27008":54037,"_2880":54173},[],"Review the CA’s own certificate separately from the default profile for certificates it will issue later. Choose an explicit issuance policy; do not assume the form’s initial values suit your consumers.",{"_3394":1871,"_29710":1821,"_20617":54175,"_5":14139,"_27008":54041,"_2880":54176},[],"Confirm the form and open the CA. Check status, issuer, dates, associated engine and key. Download the certificate: it should contain `CA:TRUE` and a usage permitting certificate signing. Verify the self-signature for a root or the chain to your root for an intermediate. Complete a test issuance to check that the key can actually sign.",{"_3394":1872,"_29710":1821,"_20617":54178,"_5":14139,"_27008":54041,"_2880":54179},[],"Plan and verify expiration using the Profiles rules. Issuance does not automatically clamp validity to the issuer’s expiration; leave time to replace the authority and renew identities.",{"_3394":1873,"_29710":1821,"_20617":54181,"_5":14139,"_27008":54045,"_2880":54182},[],"Select &#x2A;*Create New CA (Existing Key)** when the key is already registered in Lamassu. The wizard first asks for the backing key and then shows the same configuration of type, identity, validity and profile.",{"_3394":1874,"_29710":1821,"_20617":54184,"_5":14139,"_27008":54045,"_2880":54185},[],"This flow is useful when the key was previously created in an HSM, imported through BYOK or must be reused under a specific custody policy.",{"_3394":1875,"_29710":1821,"_20617":54187,"_5":14139,"_27008":54049,"_2880":54188},[],"You need the CA certificate in PEM, its chain to a known root and, when importing it, an exportable private key. Before uploading material, verify signature, dates, `CA:TRUE`, signing usages (including `cRLSign`, without which the CA cannot publish its CRL) and public-key correspondence. The key verification procedure also compares a CA key and certificate.",{"_3394":1876,"_29710":1821,"_20617":54190,"_5":14139,"_27008":54049,"_2880":54191},[],"The backend rejects an import whose certificate lacks the CA basic constraint (`basicConstraints cA flag is not set`), whose serial number matches a stored certificate with different contents, or whose identical certificate already belongs to an existing CA. A deleted CA's certificate record is kept and can be reused when re-importing the same certificate, including its previous status. Re-importing a different certificate with that serial number is rejected; check the certificate and status after re-importing.",{"_3394":1877,"_29710":1821,"_20617":54193,"_5":14139,"_27008":54049,"_2880":54194},[],"Deleting a CA releases the key references of its own current certificate and linked reissued certificates, while keeping those records for its issuer's CRL and OCSP. It then attempts to delete the key; the KMS keeps it if other certificates still reference it, such as another CA sharing the key. Revoking certificates issued by the deleted CA does not release their own key references.",{"_3394":1878,"_29710":1821,"_20617":54196,"_5":14139,"_27008":54053,"_2880":54197},[],"Check the installation’s default engine before importing a CA with a key. CA import delegates key import to that engine; it does not guarantee arbitrary provider selection from the form. To select an engine while importing the key separately, use the KMS.",{"_3394":1879,"_29710":1821,"_20617":54199,"_5":14139,"_27008":54057,"_2880":54200},[],"Import the certificate and, when applicable, its PEM key. Register the CAs needed to identify the issuer. Registering a CA does not install it in external trust stores.",{"_3394":1880,"_29710":1821,"_20617":54202,"_5":14139,"_27008":54057,"_2880":54203},[],"The backend validates before importing any key: a duplicate CA ID and a certificate that is not a CA (missing `basicConstraints` `cA=TRUE`) are rejected, the latter with `400` `certificate is not a CA: basicConstraints cA flag is not set`. If a failure occurs after the key was imported, the key is kept in the KMS and a warning tells you to delete it manually.",{"_3394":1881,"_29710":1821,"_20617":54205,"_5":14139,"_27008":54061,"_2880":54206},[],"Associate an explicit issuance profile if the CA will sign. Check usages and dates using Profiles.",{"_3394":1882,"_29710":1821,"_20617":54208,"_5":14139,"_27008":54065,"_2880":54209},[],"Review the registered type, associated key and engine, and issuer relationship. Certificate-only import may associate an existing KMS key using the certificate’s key identifier. Without a usable key, the CA is public material and cannot sign.",{"_3394":1883,"_29710":1821,"_20617":54211,"_5":14139,"_27008":54065,"_2880":54212},[],"For an issuing CA, complete a test issuance and check OCSP and CRL. Creating the record alone does not establish key availability, complete chain consistency or status publication.",{"_3394":1884,"_29710":1821,"_20617":54214,"_5":14139,"_27008":54069,"_2880":54215},[],"Open a CA from the inventory to review:",{"_3394":1885,"_29710":1821,"_20617":54217,"_5":14139,"_27008":54069,"_2880":54218},[],"Status and validity period.",{"_3394":1886,"_29710":1821,"_20617":54220,"_5":14139,"_27008":54069,"_2880":54221},[],"Certificate and chain in PEM format.",{"_3394":1887,"_29710":1821,"_20617":54223,"_5":14139,"_27008":54069,"_2880":54224},[],"Number of active, expired and revoked certificates.",{"_3394":1888,"_29710":1821,"_20617":54226,"_5":14139,"_27008":54069,"_2880":54227},[],"Certificates issued in **Issued Certificates**.",{"_3394":1889,"_29710":1821,"_20617":54229,"_5":14139,"_27008":54069,"_2880":54230},[],"The CRL linked to the authority.",{"_3394":1890,"_29710":1821,"_20617":54232,"_5":14139,"_27008":54069,"_2880":54233},[],"Metadata and the associated cryptographic engine.",{"_3394":1891,"_29710":1821,"_20617":54235,"_5":14139,"_27008":54069,"_2880":54236},[],"You can filter the inventory by name, status and CA type.",{"_3394":1892,"_29710":1821,"_20617":54238,"_5":14139,"_27008":54073,"_2880":54239},[],"You can start an issuance from **Issued Certificates**, from a CA's action menu or from the global certificate inventory.",{"_3394":1893,"_29710":1821,"_20617":54241,"_5":14139,"_27008":54073,"_2880":54242},[],"**Generate Key & CSR in Browser** is useful for a manual operation or a quick test. The browser generates the key and you must download it at the end.",{"_3394":1894,"_29710":1821,"_20617":54244,"_5":14139,"_27008":54073,"_2880":54245},[],"**Upload Existing CSR** is the right option when the key must remain on the target system. Lamassu receives the request but never the private key.",{"_3394":1895,"_29710":1821,"_20617":54247,"_5":14139,"_27008":54073,"_2880":54248},[],"Follow Issue your first certificate for the guided flow. Certificate management explains the inventory, inspection and revocation.",{"_3394":1896,"_29710":1821,"_20617":54250,"_5":14139,"_27008":54077,"_2880":54251},[],"Revoking a CA prevents issuance and may interrupt its entire branch. Only `CertificateHold` allows reactivating the CA itself if it is not expired. Descendant revocation is attempted with `CessationOfOperation`; reactivating the parent does not restore those descendants. Follow the cascading revocation conditions.",{"_3394":1897,"_29710":1821,"_20617":54253,"_5":14139,"_27008":54081,"_2880":54254},[],"Identify the certificates, devices and consumers that depend on the CA. Prepare a replacement authority and chain when necessary.",{"_3394":1898,"_29710":1821,"_20617":54256,"_5":14139,"_27008":54085,"_2880":54257},[],"Open the authority and select **Revoke CA**. Choose the reason that describes the incident, for example `KeyCompromise`, `CACompromise`, `Superseded` or `CessationOfOperation`.",{"_3394":1899,"_29710":1821,"_20617":54259,"_5":14139,"_27008":54089,"_2880":54260},[],"Type the CA's name exactly to enable **Confirm Revocation**.",{"_3394":1900,"_29710":1821,"_20617":54262,"_5":14139,"_27008":54093,"_2880":54263},[],"Check **REVOKED** on the CA and review descendants individually; propagation permits partial failures. Independently verify OCSP and CRL publication and consumer rejection. A revoked record does not guarantee that an existing session closes.",{"_3394":1901,"_29710":1821,"_20617":54265,"_5":14139,"_27008":54097,"_2880":54266},[],"Permanent deletion is only available with the CA revoked or expired; a CA imported without a key can be deleted in any state. Delete the record only when your retention and audit policy allows it.",{"_3394":1902,"_29710":1821,"_20617":54268,"_5":14139,"_27008":54097,"_2880":54269},[],"The CA’s VA role is kept. If no other CA with the same SKI remains, it can no longer be edited (see CRL), so adjust its validity and signer beforehand. The CA’s key is released, but the KMS keeps it while other certificates still reference it.",{"_3394":1903,"_29710":1821,"_20617":54271,"_5":14139,"_27008":54097,"_2880":54272},[],"Lamassu keeps the certificate record of a deleted CA. If that same certificate is imported again, the import succeeds and reuses the record: it updates the type, issuer and key but keeps the status, so the CA reappears in the state it had when deleted (normally revoked or expired). A different certificate with the same serial number is rejected with a 400 error, and a certificate that already belongs to an existing CA with a 409 error. To avoid inheriting the previous status, use a certificate with a different serial number and check the result after importing. If the new certificate uses the same key, it shares the SKI with the retained VA role of the deleted CA, whose signer is the old certificate: check that the CRL is generated and, if it is not, use `PUT` to set a signer of the new CA (see CRL).",{"_3394":1904,"_29710":1904,"_5":14491,"_2880":54274,"_30042":54275,"_20617":54276,"_27008":1904},"Certificate profiles",[48369,49837,53839,53840],[],{"_3394":1905,"_29710":1904,"_20617":54278,"_5":14139,"_27008":1904,"_2880":54279},[],"Define reusable policies to issue consistent certificates and constrain accepted keys.",{"_3394":1906,"_29710":1904,"_5":30039,"_20617":54281,"_27008":54282,"_2880":54283},[],"/docs/platform/pki/certificate-profiles#what-a-profile-controls","What a profile controls",{"_3394":1907,"_29710":1904,"_5":30039,"_20617":54285,"_27008":54286,"_2880":54287},[],"/docs/platform/pki/certificate-profiles#validity","Validity",{"_3394":1908,"_29710":1904,"_5":30039,"_20617":54289,"_27008":54290,"_2880":54291},[],"/docs/platform/pki/certificate-profiles#ca-certificate-or-end-entity-certificate","CA certificate or end-entity certificate",{"_3394":1909,"_29710":1904,"_5":30039,"_20617":54293,"_27008":54294,"_2880":54295},[],"/docs/platform/pki/certificate-profiles#key-usage-and-extended-key-usage","Key Usage and Extended Key Usage",{"_3394":1910,"_29710":1904,"_5":30039,"_20617":54297,"_27008":54298,"_2880":54299},[],"/docs/platform/pki/certificate-profiles#subject","Subject",{"_3394":1911,"_29710":1904,"_5":30039,"_20617":54301,"_27008":54302,"_2880":54303},[],"/docs/platform/pki/certificate-profiles#csr-extensions","CSR extensions",{"_3394":1912,"_29710":1904,"_5":30039,"_20617":54305,"_27008":54306,"_2880":54307},[],"/docs/platform/pki/certificate-profiles#cryptographic-constraints","Cryptographic constraints",{"_3394":1913,"_29710":1904,"_5":30039,"_20617":54309,"_27008":54310,"_2880":54311},[],"/docs/platform/pki/certificate-profiles#profile-precedence","Profile precedence",{"_3394":1914,"_29710":1904,"_5":30039,"_20617":54313,"_27008":54314,"_2880":54315},[],"/docs/platform/pki/certificate-profiles#create-a-profile","Create a profile",{"_3394":1915,"_29710":1904,"_5":30039,"_20617":54317,"_27008":54318,"_2880":54319},[],"/docs/platform/pki/certificate-profiles#define-a-single-purpose","Define a single purpose",{"_3394":1916,"_29710":1904,"_5":30039,"_20617":54321,"_27008":54322,"_2880":54323},[],"/docs/platform/pki/certificate-profiles#choose-the-validity","Choose the validity",{"_3394":1917,"_29710":1904,"_5":30039,"_20617":54325,"_27008":54326,"_2880":54327},[],"/docs/platform/pki/certificate-profiles#fix-usages-and-subject","Fix usages and subject",{"_3394":1918,"_29710":1904,"_5":30039,"_20617":54329,"_27008":54330,"_2880":54331},[],"/docs/platform/pki/certificate-profiles#constrain-the-keys","Constrain the keys",{"_3394":1919,"_29710":1904,"_5":30039,"_20617":54333,"_27008":54334,"_2880":54335},[],"/docs/platform/pki/certificate-profiles#attach-it-and-test","Attach it and test",{"_3394":1920,"_29710":1904,"_5":30039,"_20617":54337,"_27008":54338,"_2880":54339},[],"/docs/platform/pki/certificate-profiles#design-examples","Design examples",{"_3394":1921,"_29710":1904,"_5":30039,"_20617":54341,"_27008":54342,"_2880":54343},[],"/docs/platform/pki/certificate-profiles#changes-and-deletion","Changes and deletion",{"_3394":1922,"_29710":1904,"_20617":54345,"_5":14139,"_27008":1904,"_2880":54346},[],"An issuance profile turns a certificate policy into reusable configuration. Instead of deciding validity, subject, extensions and algorithms on every request, you define once what is allowed and attach the profile to a CA, a DMS or a specific issuance.",{"_3394":1923,"_29710":1904,"_20617":54348,"_5":14139,"_27008":1904,"_2880":54349},[],"This guide is for the PKI administrator defining issuance policy. You need permissions to manage profiles and associate them with the intended CA or DMS, plus a test consumer with known identity and purpose requirements.",{"_3394":1924,"_29710":1904,"_20617":54351,"_5":14139,"_27008":54286,"_2880":54352},[],"You can express the lifetime as a duration from the moment of issuance or as a fixed end date. A duration works well for recurring identities; a common date is useful to make a whole batch end before a migration or retirement.",{"_3394":1925,"_29710":1904,"_20617":54354,"_5":14139,"_27008":54286,"_2880":54355},[],"Plan the end date within the issuing CA’s validity and leave a renewal margin. The signer calculates the date from the profile; it does not automatically clamp validity to the issuer’s expiration. Check both dates in the resulting certificate. A fixed date in the past does not produce a usable identity either.",{"_3394":1926,"_29710":1904,"_20617":54357,"_5":14139,"_27008":54290,"_2880":54358},[],"`Sign as CA` sets `IsCA` and the basic constraints needed for an authority. Enable it only in profiles intended to create or reissue subordinate CAs.",{"_3394":1927,"_29710":1904,"_20617":54360,"_5":14139,"_27008":54294,"_2880":54361},[],"The profile can enforce usages such as `DigitalSignature`, `KeyEncipherment`, `CertSign`, `CRLSign`, `ClientAuth`, `ServerAuth` or `OCSPSigning`.",{"_3394":1928,"_29710":1904,"_20617":54363,"_5":14139,"_27008":54294,"_2880":54364},[],"If you enable **Honor Key Usage** or **Honor Extended Key Usages**, Lamassu keeps the values requested by the CSR. If you disable them, it replaces them with the ones defined in the profile.",{"_3394":1929,"_29710":1904,"_20617":54366,"_5":14139,"_27008":54294,"_2880":54367},[],"Do not enable the `Honor…` options for untrusted requests unless another component validates those fields. Otherwise, the requester may choose broader capabilities than intended.",{"_3394":1930,"_29710":1904,"_20617":54369,"_5":14139,"_27008":54298,"_2880":54370},[],"With **Honor Subject**, the certificate keeps the subject of the CSR. Without that option, Lamassu applies the profile's `CN`, `O`, `OU`, `C`, `ST` and `L`. If the profile does not define a `Common Name`, the requested CN is kept.",{"_3394":1931,"_29710":1904,"_20617":54372,"_5":14139,"_27008":54302,"_2880":54373},[],"With **Honor Extensions**, Lamassu filters the additional requested extensions and keeps only SAN. Without that option, it discards the CSR's additional extensions.",{"_3394":1932,"_29710":1904,"_20617":54375,"_5":14139,"_27008":54302,"_2880":54376},[],"This preserves SAN, but does not establish that the requester is entitled to those DNS names, IP addresses, emails or URIs. Validate that authorization before issuing. OCSP and CRL locations come from the issuance service configuration; `Honor Extensions` does not copy CSR distribution points.",{"_3394":1933,"_29710":1904,"_20617":54378,"_5":14139,"_27008":54306,"_2880":54379},[],"The cryptographic enforcement can:",{"_3394":1934,"_29710":1904,"_20617":54381,"_5":14139,"_27008":54306,"_2880":54382},[],"allow or block RSA keys;",{"_3394":1935,"_29710":1904,"_20617":54384,"_5":14139,"_27008":54306,"_2880":54385},[],"limit the supported RSA sizes;",{"_3394":1936,"_29710":1904,"_20617":54387,"_5":14139,"_27008":54306,"_2880":54388},[],"allow or block ECDSA keys;",{"_3394":1937,"_29710":1904,"_20617":54390,"_5":14139,"_27008":54306,"_2880":54391},[],"limit the supported ECDSA sizes or curves.",{"_3394":1938,"_29710":1904,"_20617":54393,"_5":14139,"_27008":54306,"_2880":54394},[],"When it is enabled, Lamassu checks the public key before creating a CA or signing a CSR. A key whose type or size is not listed in the profile is rejected.",{"_3394":1939,"_29710":1904,"_20617":54396,"_5":14139,"_27008":54310,"_2880":54397},[],"Resolution depends on the entry point. One complete profile is selected; its fields are not merged with the CA’s profile.",{"_3394":1940,"_29710":1904,"_20617":54399,"_5":14139,"_27008":54310,"_2880":51601},[],{"_3394":1941,"_29710":1904,"_20617":54401,"_5":14139,"_27008":54310,"_2880":54402},[],"First choice",{"_3394":1942,"_29710":1904,"_20617":54404,"_5":14139,"_27008":54310,"_2880":54405},[],"Second choice",{"_3394":1943,"_29710":1904,"_20617":54407,"_5":14139,"_27008":54310,"_2880":54408},[],"If neither is supplied",{"_3394":1944,"_29710":1904,"_20617":54410,"_5":14139,"_27008":54310,"_2880":54411},[],"Direct signing with a CA",{"_3394":1945,"_29710":1904,"_20617":54413,"_5":14139,"_27008":54310,"_2880":54414},[],"`issuance_profile` embedded in the request",{"_3394":1946,"_29710":1904,"_20617":54416,"_5":14139,"_27008":54310,"_2880":54417},[],"Request `issuance_profile_id`",{"_3394":1947,"_29710":1904,"_20617":54419,"_5":14139,"_27008":54310,"_2880":54420},[],"CA default profile (`profile_id`).",{"_3394":1948,"_29710":1904,"_20617":54422,"_5":14139,"_27008":54310,"_2880":54423},[],"Issuance through a DMS",{"_3394":1949,"_29710":1904,"_20617":54425,"_5":14139,"_27008":54310,"_2880":54426},[],"`settings.issuance_profile_id`",{"_3394":1950,"_29710":1904,"_20617":54428,"_5":14139,"_27008":54310,"_2880":54429},[],"`settings.issuance_profile` embedded in the DMS",{"_3394":1951,"_29710":1904,"_20617":54431,"_5":14139,"_27008":54310,"_2880":54432},[],"Enrollment CA default profile.",{"_3394":1952,"_29710":1904,"_20617":54434,"_5":14139,"_27008":54310,"_2880":54435},[],"If the selected identifier cannot be resolved, the operation fails; it does not silently fall back to the CA’s profile. Avoid setting both options at once. Recording which profile was selected helps explain why a certificate differs from its CSR.",{"_3394":1953,"_29710":1904,"_20617":54437,"_5":14139,"_27008":54310,"_2880":54438},[],"Several fleets can share a CA while keeping different profiles through their DMSs. Requester authentication and device registration policy are configured separately in DMS.",{"_3394":1954,"_29710":1904,"_20617":54440,"_5":14139,"_27008":54318,"_2880":54441},[],"Separate, for example, mTLS devices, servers and intermediate CAs. A small, specific profile is easier to review than one that allows every use.",{"_3394":1955,"_29710":1904,"_20617":54443,"_5":14139,"_27008":54322,"_2880":54444},[],"Align the duration with the fleet's real renewal capacity. Leave margin against the CA's expiration.",{"_3394":1956,"_29710":1904,"_20617":54446,"_5":14139,"_27008":54326,"_2880":54447},[],"For a device that authenticates as a client, the usual starting point is `DigitalSignature` and `ClientAuth`. Add `ServerAuth` or `KeyEncipherment` only if the protocol needs it.",{"_3394":1957,"_29710":1904,"_20617":54449,"_5":14139,"_27008":54330,"_2880":54450},[],"Enable cryptographic enforcement and list only algorithms and sizes compatible with your policy and your devices.",{"_3394":1958,"_29710":1904,"_20617":54452,"_5":14139,"_27008":54334,"_2880":54453},[],"Attach the profile to a CA or DMS and check the precedence above. Issue a CSR with known usages and SAN; inspect the result with `openssl x509 -in device.crt -noout -text`. Check subject, SAN, KU, EKU and dates. For an end-entity identity, disable `Sign as CA`, require no `CA:TRUE` or `Certificate Sign`, and require `CA:FALSE` if Basic Constraints is present.",{"_3394":1959,"_29710":1904,"_20617":54455,"_5":14139,"_27008":54334,"_2880":54456},[],"Also try a key excluded by policy: issuance should fail. Follow the certificate verification and test acceptance in the intended consumer.",{"_3394":1960,"_29710":1904,"_20617":54458,"_5":14139,"_27008":54338,"_2880":54459},[],"**mTLS device**\\\nEnd-entity certificate, short validity, `DigitalSignature`, `ClientAuth`, subject controlled by the DMS and SAN allowed when it identifies the device.",{"_3394":1961,"_29710":1904,"_20617":54461,"_5":14139,"_27008":54338,"_2880":54462},[],"**TLS server**\\\nEnd-entity certificate, `DigitalSignature`, `ServerAuth` and mandatory SAN with the names clients will use.",{"_3394":1962,"_29710":1904,"_20617":54464,"_5":14139,"_27008":54338,"_2880":54465},[],"**Intermediate CA**\\\n`Sign as CA`, `CertSign` and `CRLSign`, validity longer than its end-entity certificates and stricter cryptographic constraints.",{"_3394":1963,"_29710":1904,"_20617":54467,"_5":14139,"_27008":54338,"_2880":54468},[],"These patterns express design decisions. Enabling `Honor Extensions` does not require a CSR to contain SAN or validate its names; enforce that in the request workflow. A profile does not install trust or grant permissions in the consumer.",{"_3394":1964,"_29710":1904,"_20617":54470,"_5":14139,"_27008":54342,"_2880":54471},[],"Updating a profile affects future issuances; it does not modify already-signed certificates. Test changes before applying them to a CA in production and keep the operational justification.",{"_3394":1965,"_29710":1904,"_20617":54473,"_5":14139,"_27008":54342,"_2880":54474},[],"Before deleting a profile, check that no CA or DMS depends on it. If you want to replace it, create the new version, update the references and perform a test issuance before retiring the old one.",{"_3394":1966,"_29710":1966,"_5":14491,"_2880":54476,"_30042":54477,"_20617":54479,"_27008":1966},"Certificate validation",[48369,49837,53839,54478],"Validation",[],{"_3394":1967,"_29710":1966,"_20617":54481,"_5":14139,"_27008":1966,"_2880":54482},[],"Check chain, identity, purpose and revocation from the consumer.",{"_3394":1968,"_29710":1966,"_5":30039,"_20617":54484,"_27008":54485,"_2880":54486},[],"/docs/platform/pki/certificate-validation#before-querying-status","Before querying status",{"_3394":1969,"_29710":1966,"_5":30039,"_20617":54488,"_27008":54489,"_2880":54490},[],"/docs/platform/pki/certificate-validation#choose-a-mechanism","Choose a mechanism",{"_3394":1970,"_29710":1966,"_5":30039,"_20617":54492,"_27008":54493,"_2880":54494},[],"/docs/platform/pki/certificate-validation#check-consumer-behavior","Check consumer behavior",{"_3394":1971,"_29710":1966,"_20617":54496,"_5":14139,"_27008":1966,"_2880":54497},[],"This guide brings together the checks needed when integrating a certificate consumer. You need the presented certificate, intermediates and roots that your application has deliberately chosen to trust. Lamassu publishes status; the consumer applies acceptance policy.",{"_3394":1972,"_29710":1966,"_20617":54499,"_5":14139,"_27008":54485,"_2880":54500},[],"Verify these criteria together:",{"_3394":1973,"_29710":1966,"_20617":54502,"_5":14139,"_27008":54485,"_2880":53465},[],{"_3394":1974,"_29710":1966,"_20617":54504,"_5":14139,"_27008":54485,"_2880":54505},[],"Required result",{"_3394":1975,"_29710":1966,"_20617":54507,"_5":14139,"_27008":54485,"_2880":54508},[],"Chain and signature",{"_3394":1976,"_29710":1966,"_20617":54510,"_5":14139,"_27008":54485,"_2880":54511},[],"Valid chain to a root deliberately installed in the consumer.",{"_3394":1977,"_29710":1966,"_20617":54513,"_5":14139,"_27008":54485,"_2880":54514},[],"Dates",{"_3394":1978,"_29710":1966,"_20617":54516,"_5":14139,"_27008":54485,"_2880":54517},[],"Current time between `Not Before` and `Not After`, including the CAs in the chain.",{"_3394":1979,"_29710":1966,"_20617":54519,"_5":14139,"_27008":54485,"_2880":49506},[],{"_3394":1980,"_29710":1966,"_20617":54521,"_5":14139,"_27008":54485,"_2880":54522},[],"Name, SAN or identifier matches the expected peer.",{"_3394":1981,"_29710":1966,"_20617":54524,"_5":14139,"_27008":54485,"_2880":48759},[],{"_3394":1982,"_29710":1966,"_20617":54526,"_5":14139,"_27008":54485,"_2880":54527},[],"KU, EKU and constraints permit the specific operation.",{"_3394":1983,"_29710":1966,"_20617":54529,"_5":14139,"_27008":54485,"_2880":54530},[],"Revocation",{"_3394":1984,"_29710":1966,"_20617":54532,"_5":14139,"_27008":54485,"_2880":54533},[],"Signed, current evidence corresponding to the queried issuer and certificate.",{"_3394":1985,"_29710":1966,"_20617":54535,"_5":14139,"_27008":54485,"_2880":54536},[],"Authorization",{"_3394":1986,"_29710":1966,"_20617":54538,"_5":14139,"_27008":54485,"_2880":54539},[],"The application permits that identity to perform the action.",{"_3394":1987,"_29710":1966,"_20617":54541,"_5":14139,"_27008":54485,"_2880":54542},[],"The issuance walkthrough checks chain and purpose with OpenSSL. That check does not automatically query OCSP or download a CRL. Inventory presence or an OCSP `Good` response does not replace the other criteria.",{"_3394":1988,"_29710":1966,"_20617":54544,"_5":14139,"_27008":54489,"_2880":54545},[],"Mechanism",{"_3394":1989,"_29710":1966,"_20617":54547,"_5":14139,"_27008":54489,"_2880":54548},[],"When to use it",{"_3394":1990,"_29710":1966,"_20617":54550,"_5":14139,"_27008":54489,"_2880":54551},[],"What you must maintain",{"_3394":1991,"_29710":1966,"_20617":54553,"_5":14139,"_27008":54489,"_2880":54554},[],"OCSP",{"_3394":1992,"_29710":1966,"_20617":54556,"_5":14139,"_27008":54489,"_2880":54557},[],"Status query for a specific certificate.",{"_3394":1993,"_29710":1966,"_20617":54559,"_5":14139,"_27008":54489,"_2880":54560},[],"Responder access, signature verification and cache/freshness policy.",{"_3394":1994,"_29710":1966,"_20617":54562,"_5":14139,"_27008":54489,"_2880":54563},[],"CRL",{"_3394":1995,"_29710":1966,"_20617":54565,"_5":14139,"_27008":54489,"_2880":54566},[],"Local checks for many certificates or offline operation.",{"_3394":1996,"_29710":1966,"_20617":54568,"_5":14139,"_27008":54489,"_2880":54569},[],"Periodic download of an issuer-signed list and rejection of expired lists.",{"_3394":1997,"_29710":1966,"_20617":54571,"_5":14139,"_27008":54489,"_2880":54572},[],"OCSP can also return a response reusable until `nextUpdate`; a CRL changes when a new version is published. Neither mechanism alone guarantees that a consumer learns a revocation at the moment it is saved.",{"_3394":1998,"_29710":1966,"_20617":54574,"_5":14139,"_27008":54489,"_2880":54575},[],"If using both, define when fallback is allowed and what the client does when retrieval, signature or freshness checks fail, or the result is `Unknown`. Accepting an identity when its status cannot be checked must be an explicit application decision.",{"_3394":1999,"_29710":1966,"_20617":54577,"_5":14139,"_27008":54493,"_2880":54578},[],"Accept a current, authorized certificate with a known chain.",{"_3394":2000,"_29710":1966,"_20617":54580,"_5":14139,"_27008":54493,"_2880":54581},[],"Reject another certificate with an unknown root or incompatible purpose.",{"_3394":2001,"_29710":1966,"_20617":54583,"_5":14139,"_27008":54493,"_2880":54584},[],"Revoke a test certificate and verify the OCSP response or new CRL.",{"_3394":2002,"_29710":1966,"_20617":54586,"_5":14139,"_27008":54493,"_2880":54587},[],"Check that a new connection with that identity is rejected.",{"_3394":2003,"_29710":1966,"_20617":54589,"_5":14139,"_27008":54493,"_2880":54590},[],"Simulate an unreachable endpoint and expired evidence; observe whether the result matches policy.",{"_3394":2004,"_29710":1966,"_20617":54592,"_5":14139,"_27008":54493,"_2880":54593},[],"Keep the serial number, issuer, revocation reason, query time and evidence timestamps. An existing session may need explicit closure or reauthentication in the consumer; publishing revocation does not automatically close it.",{"_3394":2005,"_29710":1966,"_20617":54595,"_5":14139,"_27008":54493,"_2880":54596},[],"For a chain with intermediates, validate their status according to consumer policy as well. An end-entity issuer’s CRL does not replace checks on every CA in the chain.",{"_3394":2006,"_29710":1966,"_20617":54598,"_5":14139,"_27008":54493,"_2880":54599},[],"<Card title=\"Online validation with OCSP\" description=\"Generate a query and verify signature, status and timestamps.\" href=\"/docs/platform/pki/ocsp\" />",{"_3394":2007,"_29710":1966,"_20617":54601,"_5":14139,"_27008":54493,"_2880":54602},[],"<Card title=\"Revocation lists\" description=\"Download, inspect and use an issuer’s CRL.\" href=\"/docs/platform/pki/crl\" />",{"_3394":2008,"_29710":2008,"_5":14491,"_2880":54604,"_30042":54605,"_20617":54606,"_27008":2008},"Certificates",[48369,49837,53839,53840],[],{"_3394":2009,"_29710":2008,"_20617":54608,"_5":14139,"_27008":2008,"_2880":54609},[],"Inspect, download and revoke the certificates issued by Lamassu.",{"_3394":2010,"_29710":2008,"_5":30039,"_20617":54611,"_27008":54612,"_2880":54613},[],"/docs/platform/pki/certificates#find-a-certificate","Find a certificate",{"_3394":2011,"_29710":2008,"_5":30039,"_20617":54615,"_27008":54616,"_2880":54617},[],"/docs/platform/pki/certificates#download-the-certificate","Download the certificate",{"_3394":2012,"_29710":2008,"_5":30039,"_20617":54619,"_27008":54620,"_2880":54621},[],"/docs/platform/pki/certificates#issue-from-an-existing-csr","Issue from an existing CSR",{"_3394":2013,"_29710":2008,"_5":30039,"_20617":54623,"_27008":54624,"_2880":54625},[],"/docs/platform/pki/certificates#revoke-a-certificate","Revoke a certificate",{"_3394":2014,"_29710":2008,"_5":30039,"_20617":54627,"_27008":54628,"_2880":54629},[],"/docs/platform/pki/certificates#open-the-action","Open the action",{"_3394":2015,"_29710":2008,"_5":30039,"_20617":54631,"_27008":54632,"_2880":54633},[],"/docs/platform/pki/certificates#choose-a-reason","Choose a reason",{"_3394":2016,"_29710":2008,"_5":30039,"_20617":54635,"_27008":54636,"_2880":54637},[],"/docs/platform/pki/certificates#confirm-and-verify","Confirm and verify",{"_3394":2017,"_29710":2008,"_5":30039,"_20617":54639,"_27008":54640,"_2880":54641},[],"/docs/platform/pki/certificates#reactivate-a-hold","Reactivate a hold",{"_3394":2018,"_29710":2008,"_5":30039,"_20617":54643,"_27008":54644,"_2880":54645},[],"/docs/platform/pki/certificates#continue","Continue",{"_3394":2019,"_29710":2008,"_20617":54647,"_5":14139,"_27008":2008,"_2880":54648},[],"This guide is for a PKI operator inspecting or retiring an issued identity. You need inventory access and, to change states, permissions on the certificate. Open **Certificates** for a global view or **Issued Certificates** within a CA to restrict it to that issuer.",{"_3394":2020,"_29710":2008,"_20617":54650,"_5":14139,"_27008":54612,"_2880":54651},[],"Filter by `Common Name`, serial, status and issuer. A certificate does not contain its private key, so the private-key surfaces answer which certificates have their key held in Lamassu’s KMS:",{"_3394":2021,"_29710":2008,"_20617":54653,"_5":14139,"_27008":54612,"_2880":54654},[],"The advanced **Private Key** filter, available on the Certificates page and on a CA’s **Issued Certificates** tab, narrows the list to **All Certificates**, **With Private Key** or **Without Private Key**.",{"_3394":2022,"_29710":2008,"_20617":54656,"_5":14139,"_27008":54612,"_2880":54657},[],"The sortable **Private Key** column — shown by default, hidden on narrow screens — marks a key held in the KMS with a green check mark and otherwise shows `-`.",{"_3394":2023,"_29710":2008,"_20617":54659,"_5":14139,"_27008":54612,"_2880":54660},[],"In certificate details, the **Information** tab shows a **Private Key** row in the **Key & Signature** section. When the certificate reports a private key and its KMS engine and key IDs are available, the row links to the key (tooltip: **Open private key in KMS**). Otherwise, it shows **Present** if the certificate reports a private key, or **Not available** if it does not. This does not establish whether a key exists outside Lamassu.",{"_3394":2024,"_29710":2008,"_20617":54662,"_5":14139,"_27008":54612,"_2880":54663},[],"Use **Quick Inspect** for a quick review or **View Details** for subject, SAN, usages, chain, dates and metadata.",{"_3394":2025,"_29710":2008,"_20617":54665,"_5":14139,"_27008":54612,"_2880":54666},[],"Certificate records expose `key_id` (the KMS key that holds the private key, empty when the KMS does not hold it) and `has_private_key` (derived at read time from the KMS). Certificate and CA listings accept a `has_private_key` filter, which is useful, for example, to check the result of the CA-to-KMS migration of the 4.0.0 upgrade.",{"_3394":2026,"_29710":2008,"_20617":54668,"_5":14139,"_27008":54612,"_2880":54669},[],"Identify a certificate by issuer and serial; a name can correspond to several renewals. Check which certificate the consumer actually uses and which occupies the device’s active identity. Identity history and the certificate inventory answer different questions.",{"_3394":2027,"_29710":2008,"_20617":54671,"_5":14139,"_27008":54616,"_2880":54672},[],"Download the PEM and inspect it:",{"_3394":2028,"_29710":2008,"_20617":54674,"_5":14139,"_27008":54616,"_2880":54675},[],"Check issuance policy, chain and usages with the verification walkthrough. A certificate does not contain its private key. For an external CSR, the key remains where it was generated; for the browser flow, retain the file downloaded upon issuance. If the key is lost, plan a new identity rather than expecting recovery from the certificate.",{"_3394":2029,"_29710":2008,"_20617":54677,"_5":14139,"_27008":54620,"_2880":54678},[],"Use this flow when the identity’s key must remain on the system that generated it. You need an active CA with a usable key, a PEM CSR and a suitable profile.",{"_3394":2030,"_29710":2008,"_20617":54680,"_5":14139,"_27008":54620,"_2880":54681},[],"Verify the request with `openssl req -in request.csr -noout -verify -text`. Review subject, SAN and algorithm, and authorize the requested identity.",{"_3394":2031,"_29710":2008,"_20617":54683,"_5":14139,"_27008":54620,"_2880":54684},[],"Start issuance from the CA or inventory and select **Upload Existing CSR**.",{"_3394":2032,"_29710":2008,"_20617":54686,"_5":14139,"_27008":54620,"_2880":54687},[],"Confirm the CA and profile resolved according to Profiles; the request does not guarantee that every field is retained.",{"_3394":2033,"_29710":2008,"_20617":54689,"_5":14139,"_27008":54620,"_2880":54690},[],"Download the certificate and inspect dates, issuer, subject, SAN, KU and EKU. Check correspondence with the private key on the originating system.",{"_3394":2034,"_29710":2008,"_20617":54692,"_5":14139,"_27008":54620,"_2880":54693},[],"Install certificate and chain in the intended consumer and test a connection. Issuance alone does not register a device or grant access in an integration.",{"_3394":2035,"_29710":2008,"_20617":54695,"_5":14139,"_27008":54620,"_2880":54696},[],"For browser key generation, follow Issue your first certificate.",{"_3394":2036,"_29710":2008,"_20617":54698,"_5":14139,"_27008":54624,"_2880":54699},[],"Revoke when the key is compromised, the subject is no longer authorized or the identity must stop being accepted before expiration. Before changing status, identify consumers and prepare any required replacement.",{"_3394":2037,"_29710":2008,"_20617":54701,"_5":14139,"_27008":54628,"_2880":54702},[],"Locate the correct issuer and serial and select **Revoke Certificate**. `EXPIRED` records and records revoked for a final reason reject subsequent status changes.",{"_3394":2038,"_29710":2008,"_20617":54704,"_5":14139,"_27008":54632,"_2880":54705},[],"Select the incident reason. `CertificateHold` represents a reversible certificate suspension; other reasons block later changes. Do not use a suspension to address a compromised key.",{"_3394":2039,"_29710":2008,"_20617":54707,"_5":14139,"_27008":54636,"_2880":54708},[],"Save the change and read the record again: require **REVOKED**, reason and timestamp. Then verify a fresh OCSP query and, if using CRL, its published version and the serial’s presence. Finally check rejection of a new connection in the consumer.",{"_3394":2040,"_29710":2008,"_20617":54710,"_5":14139,"_27008":54636,"_2880":54711},[],"Revocation does not erase the certificate, delete the key or guarantee closure of existing sessions. Status and publication are separate steps.",{"_3394":2041,"_29710":2008,"_20617":54713,"_5":14139,"_27008":54636,"_2880":54714},[],"A certificate revoked with `CertificateHold` can be reactivated if it is not in `EXPIRED` state. Its dates and consumer trust remain mandatory.",{"_3394":2042,"_29710":2008,"_20617":54716,"_5":14139,"_27008":54640,"_2880":54717},[],"Check that the saved reason is `CertificateHold` and the identity still satisfies policy. Request `ACTIVE` through the status update operation exposed by your installation; consult the API reference. Do not assume changing consumer permissions also changes status in Lamassu.",{"_3394":2043,"_29710":2008,"_20617":54719,"_5":14139,"_27008":54640,"_2880":54720},[],"Read the record and query OCSP again. With `regenerate_on_revoke` enabled, the reactivation event requests CRL regeneration: check that the new list omits the serial. An earlier list can still mark it revoked until the client refreshes its copy.",{"_3394":2044,"_29710":2008,"_20617":54722,"_5":14139,"_27008":54640,"_2880":54723},[],"This does not undo permanent revocation or a cascade started by revoking a CA.",{"_3394":2045,"_29710":2008,"_20617":54725,"_5":14139,"_27008":54644,"_2880":54726},[],"<Card title=\"Validate with OCSP\" description=\"Query and verify a certificate’s signed status.\" href=\"/docs/platform/pki/ocsp\" />",{"_3394":2046,"_29710":2008,"_20617":54728,"_5":14139,"_27008":54644,"_2880":54729},[],"<Card title=\"Distribute a CRL\" description=\"Publish status for local validation.\" href=\"/docs/platform/pki/crl\" />",{"_3394":2047,"_29710":2047,"_5":14491,"_2880":54731,"_30042":54732,"_20617":54734,"_27008":2047},"Certificate lifecycle",[48369,49837,53839,54733],"Concepts",[],{"_3394":2048,"_29710":2047,"_20617":54736,"_5":14139,"_27008":2047,"_2880":54737},[],"Issuance, use, renewal, revocation and retirement of certificates in Lamassu.",{"_3394":2049,"_29710":2047,"_5":30039,"_20617":54739,"_27008":54740,"_2880":54741},[],"/docs/platform/pki/concepts/certificate-lifecycle#the-full-journey","The full journey",{"_3394":2050,"_29710":2047,"_5":30039,"_20617":54743,"_27008":54744,"_2880":54745},[],"/docs/platform/pki/concepts/certificate-lifecycle#request","Request",{"_3394":2051,"_29710":2047,"_5":30039,"_20617":54747,"_27008":54748,"_2880":54749},[],"/docs/platform/pki/concepts/certificate-lifecycle#issuance","Issuance",{"_3394":2052,"_29710":2047,"_5":30039,"_20617":54751,"_27008":54752,"_2880":54753},[],"/docs/platform/pki/concepts/certificate-lifecycle#use-and-monitoring","Use and monitoring",{"_3394":2053,"_29710":2047,"_5":30039,"_20617":54755,"_27008":54756,"_2880":54757},[],"/docs/platform/pki/concepts/certificate-lifecycle#renewal-or-re-enrollment","Renewal or re-enrollment",{"_3394":2054,"_29710":2047,"_5":30039,"_20617":54759,"_27008":54760,"_2880":54761},[],"/docs/platform/pki/concepts/certificate-lifecycle#revocation-or-retirement","Revocation or retirement",{"_3394":2055,"_29710":2047,"_5":30039,"_20617":54763,"_27008":54764,"_2880":54765},[],"/docs/platform/pki/concepts/certificate-lifecycle#certificate-states","Certificate states",{"_3394":2056,"_29710":2047,"_5":30039,"_20617":54767,"_27008":54768,"_2880":54769},[],"/docs/platform/pki/concepts/certificate-lifecycle#renewal-and-revocation-are-not-equivalent","Renewal and revocation are not equivalent",{"_3394":2057,"_29710":2047,"_5":30039,"_20617":54771,"_27008":54772,"_2880":54773},[],"/docs/platform/pki/concepts/certificate-lifecycle#effect-of-revoking-a-ca","Effect of revoking a CA",{"_3394":2058,"_29710":2047,"_5":30039,"_20617":54775,"_27008":54776,"_2880":54777},[],"/docs/platform/pki/concepts/certificate-lifecycle#what-you-should-watch","What you should watch",{"_3394":2059,"_29710":2047,"_20617":54779,"_5":14139,"_27008":2047,"_2880":54780},[],"Issuing a certificate is only the beginning. During its useful life you must check its validity, renew it before it expires and retire it when it stops being trustworthy. Lamassu keeps the certificate, its issuing CA, its status and, when it belongs to a device, the identity it is linked to.",{"_3394":2060,"_29710":2047,"_20617":54782,"_5":14139,"_27008":54744,"_2880":54783},[],"The requester generates a key and a CSR. In the recommended flows, the private key stays in the device, browser or cryptographic engine that created it.",{"_3394":2061,"_29710":2047,"_20617":54785,"_5":14139,"_27008":54748,"_2880":54786},[],"The CA signs the CSR. The issuance profile determines the validity, uses, subject, allowed extensions and cryptographic constraints.",{"_3394":2062,"_29710":2047,"_20617":54788,"_5":14139,"_27008":54752,"_2880":54789},[],"The certificate enters the `ACTIVE` state. Lamassu monitors its `Not After` date; the cryptographic monitoring job marks certificates that have expired as `EXPIRED`.",{"_3394":2063,"_29710":2047,"_20617":54791,"_5":14139,"_27008":54756,"_2880":54792},[],"A new certificate is issued before the previous one expires. In a DMS you can open preventive and critical windows so the device re-enrolls through EST.",{"_3394":2064,"_29710":2047,"_20617":54794,"_5":14139,"_27008":54760,"_2880":54795},[],"If the identity stops being trustworthy, Lamassu records the reason and time of revocation. OCSP and CRLs let consumers learn that status.",{"_3394":2065,"_29710":2047,"_20617":54797,"_5":14139,"_27008":54764,"_2880":54798},[],"Lamassu persists four X.509 states:",{"_3394":2066,"_29710":2047,"_20617":54800,"_5":14139,"_27008":54764,"_2880":54801},[],"**`ACTIVE`**: the record is enabled. Also check `Not Before` and `Not After`: this state does not establish time validity.",{"_3394":2067,"_29710":2047,"_20617":54803,"_5":14139,"_27008":54764,"_2880":54804},[],"**`EXPIRED`**: it has passed its expiration date. The monitor detects this periodically; it is not a state that should be assigned manually.",{"_3394":2068,"_29710":2047,"_20617":54806,"_5":14139,"_27008":54764,"_2880":54807},[],"**`REVOKED`**: it was invalidated before expiring, with a reason and a timestamp.",{"_3394":2069,"_29710":2047,"_20617":54809,"_5":14139,"_27008":54764,"_2880":54810},[],"**`INACTIVE`**: it is disabled without representing a definitive revocation.",{"_3394":2070,"_29710":2047,"_20617":54812,"_5":14139,"_27008":54764,"_2880":54813},[],"The device view may add operational states such as missing identity, pending renewal, expiring soon or decommissioned. These are an interpretation of the device's status and its certificates, not new X.509 states.",{"_3394":2071,"_29710":2047,"_20617":54815,"_5":14139,"_27008":54768,"_2880":54816},[],"**Renewal** creates a successor certificate for an identity that remains valid. **Revocation** communicates that the current certificate must no longer be accepted. Renew to maintain continuity; revoke in response to compromise, retirement or a change that invalidates the identity.",{"_3394":2072,"_29710":2047,"_20617":54818,"_5":14139,"_27008":54768,"_2880":54819},[],"Only `CertificateHold` allows reactivating a revoked certificate that is not in `EXPIRED` state. Revocation for another reason blocks subsequent status changes. `EXPIRED` records also reject changes; the consumer must check dates even before the monitor updates the state. Certificates explains how to verify revocation and reactivation.",{"_3394":2073,"_29710":2047,"_20617":54821,"_5":14139,"_27008":54768,"_2880":54822},[],"The **Reissue CA** operation generates another certificate for the same key and links both serial numbers through metadata. It is not a key rotation. To change the key, create a successor CA and perform a migration with an overlapping period.",{"_3394":2074,"_29710":2047,"_20617":54824,"_5":14139,"_27008":54772,"_2880":54825},[],"Revoking a CA starts a cascade that attempts to revoke descendants with `CessationOfOperation`. It may end with partial failures and is not undone by reactivating the parent. Read Hierarchy and rotation for conditions and checks.",{"_3394":2075,"_29710":2047,"_20617":54827,"_5":14139,"_27008":54772,"_2880":54828},[],"Before confirming:",{"_3394":2076,"_29710":2047,"_20617":54830,"_5":14139,"_27008":54772,"_2880":54831},[],"Identify DMSs, devices and services that trust that chain.",{"_3394":2077,"_29710":2047,"_20617":54833,"_5":14139,"_27008":54772,"_2880":54834},[],"Distribute the new chain of trust.",{"_3394":2078,"_29710":2047,"_20617":54836,"_5":14139,"_27008":54772,"_2880":54837},[],"Reissue the necessary identities.",{"_3394":2079,"_29710":2047,"_20617":54839,"_5":14139,"_27008":54772,"_2880":54840},[],"Check OCSP and CRL from a real consumer.",{"_3394":2080,"_29710":2047,"_20617":54842,"_5":14139,"_27008":54772,"_2880":54843},[],"Revoke the old CA once no legitimate traffic remains.",{"_3394":2081,"_29710":2047,"_20617":54845,"_5":14139,"_27008":54772,"_2880":54846},[],"Device retirement belongs to the IoT Fleets lifecycle. It affects the active identity; it does not automatically traverse and revoke every historical certificate. Review previous identities and consumer permissions separately in Device management.",{"_3394":2082,"_29710":2047,"_20617":54848,"_5":14139,"_27008":54776,"_2880":54849},[],"Certificates entering the preventive or critical renewal window.",{"_3394":2083,"_29710":2047,"_20617":54851,"_5":14139,"_27008":54776,"_2880":54852},[],"Repeated enrollment or re-enrollment failures.",{"_3394":2084,"_29710":2047,"_20617":54854,"_5":14139,"_27008":54776,"_2880":54855},[],"Status changes and revocation reasons.",{"_3394":2085,"_29710":2047,"_20617":54857,"_5":14139,"_27008":54776,"_2880":54858},[],"OCSP and CRL publication and validity.",{"_3394":2086,"_29710":2047,"_20617":54860,"_5":14139,"_27008":54776,"_2880":54861},[],"Dependencies still presenting a replaced certificate.",{"_3394":2087,"_29710":2047,"_20617":54863,"_5":14139,"_27008":54776,"_2880":54864},[],"The device history relates its previous and current identities. For administrative changes and mutation errors, see Audit logs.",{"_3394":2088,"_29710":2088,"_5":14491,"_2880":54866,"_30042":54867,"_20617":54868,"_27008":2088},"Trust model",[48369,49837,53839,54733],[],{"_3394":2089,"_29710":2088,"_20617":54870,"_5":14139,"_27008":2088,"_2880":54871},[],"Understand where trust originates, how it is distributed and what each component validates.",{"_3394":2090,"_29710":2088,"_5":30039,"_20617":54873,"_27008":54874,"_2880":54875},[],"/docs/platform/pki/concepts/trust-model#the-four-trust-decisions","The four trust decisions",{"_3394":2091,"_29710":2088,"_5":30039,"_20617":54877,"_27008":54878,"_2880":54879},[],"/docs/platform/pki/concepts/trust-model#who-can-issue","Who can issue",{"_3394":2092,"_29710":2088,"_5":30039,"_20617":54881,"_27008":54882,"_2880":54883},[],"/docs/platform/pki/concepts/trust-model#what-can-be-issued","What can be issued",{"_3394":2093,"_29710":2088,"_5":30039,"_20617":54885,"_27008":54886,"_2880":54887},[],"/docs/platform/pki/concepts/trust-model#who-can-request-it","Who can request it",{"_3394":2094,"_29710":2088,"_5":30039,"_20617":54889,"_27008":54890,"_2880":54891},[],"/docs/platform/pki/concepts/trust-model#who-accepts-the-result","Who accepts the result",{"_3394":2095,"_29710":2088,"_5":30039,"_20617":54893,"_27008":54894,"_2880":54895},[],"/docs/platform/pki/concepts/trust-model#identity-flow","Identity flow",{"_3394":2096,"_29710":2088,"_5":30039,"_20617":54897,"_27008":54898,"_2880":54899},[],"/docs/platform/pki/concepts/trust-model#enrollment-validation-and-distribution-cas","Enrollment, validation and distribution CAs",{"_3394":2097,"_29710":2088,"_5":30039,"_20617":54901,"_27008":54902,"_2880":54903},[],"/docs/platform/pki/concepts/trust-model#validation-and-revocation","Validation and revocation",{"_3394":2098,"_29710":2088,"_5":30039,"_20617":54905,"_27008":54906,"_2880":54907},[],"/docs/platform/pki/concepts/trust-model#custody-limits","Custody limits",{"_3394":2099,"_29710":2088,"_5":30039,"_20617":54909,"_27008":54910,"_2880":54911},[],"/docs/platform/pki/concepts/trust-model#recommended-pattern","Recommended pattern",{"_3394":2100,"_29710":2088,"_20617":54913,"_5":14139,"_27008":2088,"_2880":54914},[],"In Lamassu, trust does not simply mean that a certificate exists in the inventory. A consumer trusts an identity when it can build a chain to a root it recognizes, check that the certificate is fit for the intended use and verify that it is still valid.",{"_3394":2101,"_29710":2088,"_20617":54916,"_5":14139,"_27008":54878,"_2880":54917},[],"The CA hierarchy defines which authorities can sign. A root CA establishes the anchor of trust; intermediate CAs separate operating domains and avoid using the root for every issuance.",{"_3394":2102,"_29710":2088,"_20617":54919,"_5":14139,"_27008":54882,"_2880":54920},[],"Certificate profiles limit validity, subject, uses, extensions and cryptographic parameters. Possessing a CA does not replace an issuance policy.",{"_3394":2103,"_29710":2088,"_20617":54922,"_5":14139,"_27008":54886,"_2880":54923},[],"The DMS acts as the enrollment point. It can authenticate an EST request with a client certificate, an external webhook or a combination of both. CAs configured to validate the requester do not have to be the CA that will issue the new identity.",{"_3394":2104,"_29710":2088,"_20617":54925,"_5":14139,"_27008":54890,"_2880":54926},[],"The consumer keeps its own trust store. EST `/cacerts` can distribute the service TLS certificate, the enrollment CA and selected managed CAs. Initial trust for authenticating that service must come from an already trusted channel. Download and inspect the contents: do not assume they form a complete chain or install every entry as a root.",{"_3394":2105,"_29710":2088,"_20617":54928,"_5":14139,"_27008":54894,"_2880":54929},[],"The device proves it can enroll according to the DMS policy.",{"_3394":2106,"_29710":2088,"_20617":54931,"_5":14139,"_27008":54894,"_2880":54932},[],"The DMS validates the request and forwards the CSR to the enrollment CA.",{"_3394":2107,"_29710":2088,"_20617":54934,"_5":14139,"_27008":54894,"_2880":54935},[],"In the device-generated CSR flow, the CA applies the profile and signs without receiving the device’s private key.",{"_3394":2108,"_29710":2088,"_20617":54937,"_5":14139,"_27008":54894,"_2880":54938},[],"The device installs the certificate and the chain it needs.",{"_3394":2109,"_29710":2088,"_20617":54940,"_5":14139,"_27008":54894,"_2880":54941},[],"The system that trusts the device validates the chain, dates, uses and revocation status.",{"_3394":2110,"_29710":2088,"_20617":54943,"_5":14139,"_27008":54894,"_2880":54944},[],"OIDC or X.509 identifies the operator calling Lamassu. The authorization service decides which actions it may perform. The X.509 hierarchy, on the other hand, determines whether a certificate presented by a device is trustworthy.",{"_3394":2111,"_29710":2088,"_20617":54946,"_5":14139,"_27008":54898,"_2880":54947},[],"A DMS relates three sets that are worth designing separately:",{"_3394":2112,"_29710":2088,"_20617":54949,"_5":14139,"_27008":54898,"_2880":54950},[],"**Enrollment CA:** signs the new identities.",{"_3394":2113,"_29710":2088,"_20617":54952,"_5":14139,"_27008":54898,"_2880":54953},[],"**Validation CAs:** authenticate the client certificates used for enrollment or migration. During re-enrollment, the enrollment CA is always trusted and Lamassu then tries the validation CAs configured in the re-enrollment block; those are optional.",{"_3394":2114,"_29710":2088,"_20617":54955,"_5":14139,"_27008":54898,"_2880":54956},[],"**Distributed CAs:** form the content the device obtains through EST `/cacerts`. You can include the service TLS certificate, the enrollment CA and an explicit list of managed CAs. Including the issuer does not automatically add all its ancestors.",{"_3394":2115,"_29710":2088,"_20617":54958,"_5":14139,"_27008":54898,"_2880":54959},[],"This separation makes it possible to migrate a fleet: you temporarily accept certificates from the old hierarchy, issue with the new one and distribute both chains during the overlap.",{"_3394":2116,"_29710":2088,"_20617":54961,"_5":14139,"_27008":54902,"_2880":54962},[],"A valid chain does not by itself guarantee that a certificate should be accepted. The consumer must also check:",{"_3394":2117,"_29710":2088,"_20617":54964,"_5":14139,"_27008":54902,"_2880":54965},[],"that the current date is between `Not Before` and `Not After`;",{"_3394":2118,"_29710":2088,"_20617":54967,"_5":14139,"_27008":54902,"_2880":54968},[],"that `Key Usage` and `Extended Key Usage` allow the operation;",{"_3394":2119,"_29710":2088,"_20617":54970,"_5":14139,"_27008":54902,"_2880":54971},[],"that names, SANs and subject match the expected identity;",{"_3394":2120,"_29710":2088,"_20617":54973,"_5":14139,"_27008":54902,"_2880":54974},[],"that the certificate does not appear revoked in OCSP or a CRL.",{"_3394":2121,"_29710":2088,"_20617":54976,"_5":14139,"_27008":54902,"_2880":54977},[],"An OCSP `Good` status does not replace chain, date, usage and identity checks either; Validation brings those criteria together.",{"_3394":2122,"_29710":2088,"_20617":54979,"_5":14139,"_27008":54902,"_2880":54980},[],"During the mTLS authentication of a DMS, Lamassu attempts to check revocation. If the certificate does not contain enough information to perform that check, the backend logs a warning and continues treating it as not revoked. Design your profiles and distribution points to avoid that situation in production.",{"_3394":2123,"_29710":2088,"_20617":54982,"_5":14139,"_27008":54906,"_2880":54983},[],"The KMS keeps the reference to the key and delegates the operation to the configured engine. With an HSM or a cloud KMS, the private key can remain non-exportable. That protects custody, but it does not by itself prevent misuse: you still must restrict who can request a signature and audit those operations.",{"_3394":2124,"_29710":2088,"_20617":54985,"_5":14139,"_27008":54910,"_2880":54986},[],"Keep the root out of daily operations, or with very restricted access.",{"_3394":2125,"_29710":2088,"_20617":54988,"_5":14139,"_27008":54910,"_2880":54989},[],"Issue from intermediate CAs separated by environment or risk domain.",{"_3394":2126,"_29710":2088,"_20617":54991,"_5":14139,"_27008":54910,"_2880":54992},[],"Assign explicit profiles to every use case.",{"_3394":2127,"_29710":2088,"_20617":54994,"_5":14139,"_27008":54910,"_2880":54995},[],"Distribute the new trust before starting a rotation.",{"_3394":2128,"_29710":2088,"_20617":54997,"_5":14139,"_27008":54910,"_2880":54998},[],"Keep enough overlap to renew a disconnected fleet.",{"_3394":2129,"_29710":2088,"_20617":55000,"_5":14139,"_27008":54910,"_2880":55001},[],"Validate from the consuming system, not only from the Lamassu console.",{"_3394":2130,"_29710":2088,"_20617":55003,"_5":14139,"_27008":54910,"_2880":55004},[],"Continue with CA hierarchy and rotation to turn this model into an operating procedure.",{"_3394":2131,"_29710":2131,"_5":14491,"_2880":55006,"_30042":55007,"_20617":55008,"_27008":2131},"Revocation lists (CRL)",[48369,49837,53839,54478],[],{"_3394":2132,"_29710":2131,"_20617":55010,"_5":14139,"_27008":2131,"_2880":55011},[],"Generate and distribute signed lists to validate certificates offline.",{"_3394":2133,"_29710":2131,"_5":30039,"_20617":55013,"_27008":55014,"_2880":55015},[],"/docs/platform/pki/crl#va-role-and-per-ca-configuration","VA role and per-CA configuration",{"_3394":2134,"_29710":2131,"_5":30039,"_20617":55017,"_27008":55018,"_2880":55019},[],"/docs/platform/pki/crl#cas-that-share-a-key","CAs that share a key",{"_3394":2135,"_29710":2131,"_5":30039,"_20617":55021,"_27008":55022,"_2880":55023},[],"/docs/platform/pki/crl#periodic-and-automatic-regeneration","Periodic and automatic regeneration",{"_3394":2136,"_29710":2131,"_5":30039,"_20617":55025,"_27008":55026,"_2880":55027},[],"/docs/platform/pki/crl#crl-contents","CRL contents",{"_3394":2137,"_29710":2131,"_5":30039,"_20617":55029,"_27008":55030,"_2880":55031},[],"/docs/platform/pki/crl#public-download-endpoint","Public download endpoint",{"_3394":2138,"_29710":2131,"_5":30039,"_20617":55033,"_27008":55034,"_2880":55035},[],"/docs/platform/pki/crl#va-role-management-api","VA role management API",{"_3394":2139,"_29710":2131,"_5":30039,"_20617":55037,"_27008":55038,"_2880":55039},[],"/docs/platform/pki/crl#common-va-role-errors","Common VA role errors",{"_3394":2140,"_29710":2131,"_5":30039,"_20617":55041,"_27008":55042,"_2880":55043},[],"/docs/platform/pki/crl#from-the-interface","From the interface",{"_3394":2141,"_29710":2131,"_5":30039,"_20617":55045,"_27008":55046,"_2880":55047},[],"/docs/platform/pki/crl#references","References",{"_3394":2142,"_29710":2131,"_20617":55049,"_5":14139,"_27008":2131,"_2880":55050},[],"A CRL is an issuer-signed list of revoked certificates. This guide is for an operator publishing lists and an integrator using them locally. You need the issuing CA certificate, its SKI and access to the published endpoint. The client must maintain a current copy: offline operation still requires refreshing evidence.",{"_3394":2143,"_29710":2131,"_20617":55052,"_5":14139,"_27008":55014,"_2880":55053},[],"The VA role stores configuration and metadata for the latest list published for a CA’s SKI. Generation requires a usable issuer key; do not assume an imported CA without a key has an available CRL.",{"_3394":2144,"_29710":2131,"_20617":55055,"_5":14139,"_27008":55014,"_2880":55056},[],"`crl_options` field",{"_3394":2145,"_29710":2131,"_20617":55058,"_5":14139,"_27008":55014,"_2880":48759},[],{"_3394":2146,"_29710":2131,"_20617":55060,"_5":14139,"_27008":55014,"_2880":55061},[],"Backend initial value",{"_3394":2147,"_29710":2131,"_20617":55063,"_5":14139,"_27008":55014,"_2880":55064},[],"`validity`",{"_3394":2148,"_29710":2131,"_20617":55066,"_5":14139,"_27008":55014,"_2880":55067},[],"Time from `thisUpdate` to `nextUpdate`.",{"_3394":2149,"_29710":2131,"_20617":55069,"_5":14139,"_27008":55014,"_2880":55070},[],"7 days.",{"_3394":2150,"_29710":2131,"_20617":55072,"_5":14139,"_27008":55014,"_2880":55073},[],"`refresh_interval`",{"_3394":2151,"_29710":2131,"_20617":55075,"_5":14139,"_27008":55014,"_2880":55076},[],"Time since the issuance of the latest published CRL that triggers scheduled renewal; `0` disables only this trigger. The effective granularity is bounded by the job frequency (see Periodic and automatic regeneration).",{"_3394":2152,"_29710":2131,"_20617":55078,"_5":14139,"_27008":55014,"_2880":55079},[],"6 days and 23 hours.",{"_3394":2153,"_29710":2131,"_20617":55081,"_5":14139,"_27008":55014,"_2880":55082},[],"`regenerate_on_revoke`",{"_3394":2154,"_29710":2131,"_20617":55084,"_5":14139,"_27008":55014,"_2880":55085},[],"Request regeneration on revocation or reactivation from `CertificateHold` events.",{"_3394":2155,"_29710":2131,"_20617":55087,"_5":14139,"_27008":55014,"_2880":55088},[],"`true`.",{"_3394":2156,"_29710":2131,"_20617":55090,"_5":14139,"_27008":55014,"_2880":55091},[],"`signer_certificate_serial_number`",{"_3394":2157,"_29710":2131,"_20617":55093,"_5":14139,"_27008":55014,"_2880":55094},[],"Serial number of the existing certificate that signs the CRL.",{"_3394":2158,"_29710":2131,"_20617":55096,"_5":14139,"_27008":55014,"_2880":55097},[],"Serial number of the CA’s current certificate.",{"_3394":2159,"_29710":2131,"_20617":55099,"_5":14139,"_27008":55014,"_2880":55100},[],"The signer must be an existing certificate with the `cRLSign` key usage and the same subject and public key as the CA. Certificates from before a reissue qualify. A delegated signer is not supported: a certificate with the CA’s subject but a different key is rejected.",{"_3394":2160,"_29710":2131,"_20617":55102,"_5":14139,"_27008":55014,"_2880":55103},[],"When a CA is reissued and the role’s signer is the superseded CA certificate, the VA moves the signer to the new certificate — provided it carries `cRLSign` — and republishes the CRL. If the new certificate lacks `cRLSign`, the VA keeps the previous signer and logs a warning. If the signer is any other certificate with the CA’s subject and key, it is deliberately left unchanged; the previous certificate then cannot be deleted while the role uses it (the API rejects it with `409` `certificate is in use`), and to retire it you update the signer with `PUT`.",{"_3394":2161,"_29710":2131,"_20617":55105,"_5":14139,"_27008":55014,"_2880":55106},[],"When a CA is deleted, its VA role is kept and cannot be removed through the API. If no other CA with the same SKI remains, the role can be read but any `PUT` returns 404, and the renewal job logs a warning on every cycle because it no longer finds the CA. The API offers no way out; it can only be fixed by editing the database. If another CA with that SKI remains, the role is still editable (see CAs that share a key). Adjust validity and signer before deleting the CA.",{"_3394":2162,"_29710":2131,"_20617":55108,"_5":14139,"_27008":55014,"_2880":55109},[],"A CA whose certificate lacks `cRLSign` cannot generate its CRL or edit its role (400 error). Since 4.0 the VA requires this usage. Check before importing with `openssl x509 -noout -ext keyUsage` and, if it is missing, obtain a certificate for the same CA and key that includes it and set it as the signer with `PUT`. After reissuing a CA, check the key usage of the new certificate: if it lacks `cRLSign`, the VA keeps the previous signer and logs a warning, so the lists keep being signed by the superseded certificate until you fix the usage.",{"_3394":2163,"_29710":2131,"_20617":55111,"_5":14139,"_27008":55014,"_2880":55112},[],"`PUT` always validates the signer, even when the request does not change it. If the stored signer is no longer valid, no field of the role can be modified, not even the validity, until a valid one is set.",{"_3394":2164,"_29710":2131,"_20617":55114,"_5":14139,"_27008":55014,"_2880":55115},[],"Sharing a key between CAs can prevent CRL validation. See CAs that share a key.",{"_3394":2165,"_29710":2131,"_20617":55117,"_5":14139,"_27008":55014,"_2880":55118},[],"`latest_crl` contains version, validity start and end. Versions are kept as PEM in object storage at `pki/va/crl/{subject_key_id}/{version}.crl`; the public endpoint returns DER.",{"_3394":2166,"_29710":2131,"_20617":55120,"_5":14139,"_27008":55018,"_2880":55121},[],"The VA identifies each CRL by the CA’s SKI, and the SKI is derived from its key. Two CAs with the same key have the same SKI and share a single VA role and a single CRL. This happens when a CA is created on an existing KMS key, or when a CA is imported whose certificate declares an SKI already in use. Lamassu takes the SKI of an imported certificate as-is and does not check that it corresponds to its public key. The first CA creates the role and the others keep it.",{"_3394":2167,"_29710":2131,"_20617":55123,"_5":14139,"_27008":55018,"_2880":55124},[],"The certificates of all of them point to `/crl/{ski}`, but the published list has the first CA as issuer and only includes its revocations. A verifier compares the CRL issuer with the issuer of the certificate it validates (RFC 5280, §6.3.2) and rejects the list if they differ. Depending on its policy, the certificate is blocked (*hard-fail*) or accepted even though it is revoked (*soft-fail*). Revocations of the secondary CAs do not appear in any list.",{"_3394":2168,"_29710":2131,"_20617":55126,"_5":14139,"_27008":55018,"_2880":55127},[],"If the first CA is deleted, CRL generation for the remaining one fails because the configured signer no longer matches a CA with that name. Until the role’s signer is updated to a certificate of the remaining CA, the last published list keeps being served until it expires (7 days by default).",{"_3394":2169,"_29710":2131,"_20617":55129,"_5":14139,"_27008":55018,"_2880":55130},[],"Before upgrading, review CAs that share a key. To detect the problem, compare the SKI of the CAs in the inventory: two with the same SKI are affected. To fix it, create a CA with its own key and reissue its certificates; those already issued keep the old URL and are not corrected until reissued. A CA imported with an SKI already in use does not replace the existing one as CRL issuer, because the issuer is resolved from the role’s signer. However, its own certificates point to that same URL and its revocations are not published. Until Lamassu rejects these imports, restrict the permission to import CAs as an interim control; it covers only the import path. Creating a CA with &#x2A;*Create New CA (Existing Key)** on a KMS key another CA already uses produces the same collision, so also avoid reusing keys across CAs. A per-CA CRL and the rejection of imports whose SKI collides with an existing CA are both proposed in lamassuiot#834, and neither is implemented yet.",{"_3394":2170,"_29710":2131,"_20617":55132,"_5":14139,"_27008":55022,"_2880":55133},[],"The VA scheduled job checks every role on each run and requests a new list when either of these conditions is met:",{"_3394":2171,"_29710":2131,"_20617":55135,"_5":14139,"_27008":55022,"_2880":55136},[],"**The list is about to expire:** the remaining validity of `latest_crl` is less than the interval between job runs. This condition always applies and cannot be disabled.",{"_3394":2172,"_29710":2131,"_20617":55138,"_5":14139,"_27008":55022,"_2880":55139},[],"**The refresh interval has elapsed:** the time since the issuance of the latest published CRL reaches `refresh_interval`. Setting `refresh_interval` to `0` disables only this condition; the list is still regenerated when it is about to expire.",{"_3394":2173,"_29710":2131,"_20617":55141,"_5":14139,"_27008":55022,"_2880":55142},[],"Setting `refresh_interval` to `0` therefore does not freeze regeneration. With the default 7-day validity and an hourly job, a CRL is renewed up to an hour before it expires even if `refresh_interval` is `0`. Because the job runs on its own schedule, `refresh_interval` is honored only as precisely as the job frequency allows.",{"_3394":2174,"_29710":2131,"_20617":55144,"_5":14139,"_27008":55022,"_2880":55145},[],"The job frequency is set in Helm with `services.va.job.crl.frequency` (default `0 * * * *`) and accepts a duration (`1h`) or a cron expression. A cron expression is converted into a constant interval equal to the time left until its next firing when the service starts, so it is not aligned with the clock. Keep `validity` well above that interval: with a shorter validity, the list is regenerated on every cycle.",{"_3394":2175,"_29710":2131,"_20617":55147,"_5":14139,"_27008":55022,"_2880":55148},[],"If generation fails (for example, because of a role without a CA or an invalid signer), the job logs the warning `something went wrong while calculating CRL for CA <ski>` and retries on the next cycle. There is no other renewal path until the cause is fixed, and the last published list keeps being served until it expires. All of this depends on working jobs, storage and signing.",{"_3394":2176,"_29710":2131,"_20617":55150,"_5":14139,"_27008":55022,"_2880":55151},[],"With `regenerate_on_revoke`, the event handler requests a new CRL upon revocation or reactivation from `CertificateHold` to `ACTIVE`. This happens after the status change and has its own failure paths: if generation fails (for example, because of an invalid signer), the event is retried and, once retries are exhausted, moves to the failed-events queue. If the issuing CA has no VA role, there is no CRL to regenerate: the event is acknowledged without retry, the VA logs a warning, and nothing appears in the failed-events queue. Confirming revocation does not establish that the new CRL is already published or that all clients have downloaded it.",{"_3394":2177,"_29710":2131,"_20617":55153,"_5":14139,"_27008":55022,"_2880":55154},[],"Compare CRL numbers and timestamps before and after a change. Monitor expired lists and generation failures; clients must apply policy when current evidence is unavailable.",{"_3394":2178,"_29710":2131,"_20617":55156,"_5":14139,"_27008":55026,"_2880":55157},[],"Each entry contains serial number, revocation time and reason. The generator queries certificates in `REVOKED` state for the selected CA. A reactivated certificate disappears when the list is recalculated; an earlier downloaded copy retains its contents.",{"_3394":2179,"_29710":2131,"_20617":55159,"_5":14139,"_27008":55026,"_2880":55160},[],"The list contains a critical *Issuing Distribution Point* (OID `2.5.29.28`) with configured distribution URLs. Check that your client interprets this extension and that it matches the list’s scope. If rejected, investigate format and scope; ignoring a critical extension is not successful validation.",{"_3394":2180,"_29710":2131,"_20617":55162,"_5":14139,"_27008":55030,"_2880":55163},[],"The VA service exposes `GET /crl/{subject_key_id}` without management authorization. Use the **issuing CA’s** SKI, not the end-entity certificate’s SKI or serial. First inspect the certificate’s CDP:",{"_3394":2181,"_29710":2131,"_20617":55165,"_5":14139,"_27008":55030,"_2880":55166},[],"Replace the following URL with the CDP URL and review exposure in Deployment:",{"_3394":2182,"_29710":2131,"_20617":55168,"_5":14139,"_27008":55030,"_2880":55169},[],"You need OpenSSL 3.x and `issuer.pem` containing the direct issuer’s certificate. An accepted signer certificate has the same subject and public key as the CA, so this signature check also works when the role points to an earlier certificate for that CA and key. Require a valid signature, current timestamps and the expected issuer. For a root that issues directly:",{"_3394":2183,"_29710":2131,"_20617":55171,"_5":14139,"_27008":55030,"_2880":55172},[],"`roots.pem` contains deliberately trusted roots. For intermediates, add `-untrusted intermediates.pem` before the `device.crt` argument. `-crl_check` checks the end-entity certificate’s revocation against the local list; it does not download other lists or establish the status of the whole chain. A complete chain check needs the corresponding CRLs and a policy requiring them.",{"_3394":2184,"_29710":2131,"_20617":55174,"_5":14139,"_27008":55030,"_2880":55175},[],"The test should accept an allowed certificate absent from the list and reject it with `certificate revoked` after publishing and using the list containing its serial.",{"_3394":2185,"_29710":2131,"_20617":55177,"_5":14139,"_27008":55034,"_2880":55178},[],"The following paths are relative to the VA service; confirm the public prefix in the Gateway. They are not the URLs of the public OCSP and CRL endpoints.",{"_3394":2186,"_29710":2131,"_20617":55180,"_5":14139,"_27008":55034,"_2880":51604},[],{"_3394":2187,"_29710":2131,"_20617":55182,"_5":14139,"_27008":55034,"_2880":55183},[],"Relative path",{"_3394":2188,"_29710":2131,"_20617":55185,"_5":14139,"_27008":55034,"_2880":51601},[],{"_3394":2189,"_29710":2131,"_20617":55187,"_5":14139,"_27008":55034,"_2880":55188},[],"`GET`",{"_3394":2190,"_29710":2131,"_20617":55190,"_5":14139,"_27008":55034,"_2880":55191},[],"`/v1/roles/{ca-ski}`",{"_3394":2191,"_29710":2131,"_20617":55193,"_5":14139,"_27008":55034,"_2880":55194},[],"Read `crl_options` and `latest_crl`.",{"_3394":2192,"_29710":2131,"_20617":55196,"_5":14139,"_27008":55034,"_2880":55197},[],"`PUT`",{"_3394":2193,"_29710":2131,"_20617":55199,"_5":14139,"_27008":55034,"_2880":55191},[],{"_3394":2194,"_29710":2131,"_20617":55201,"_5":14139,"_27008":55034,"_2880":55202},[],"Replace CRL configuration.",{"_3394":2195,"_29710":2131,"_20617":55204,"_5":14139,"_27008":55034,"_2880":55205},[],"You need authentication and role read or update permissions. Consult your installation’s API reference and Access control. Read current configuration before updating and send the full object expected by the contract: the backend replaces `crl_options`; it does not merge omitted fields.",{"_3394":2196,"_29710":2131,"_20617":55207,"_5":14139,"_27008":55034,"_2880":55208},[],"After a change, check saved configuration and the next list actually published. Updating the role alone does not establish regeneration or client acceptance.",{"_3394":2197,"_29710":2131,"_20617":55210,"_5":14139,"_27008":55038,"_2880":55211},[],"Symptom",{"_3394":2198,"_29710":2131,"_20617":55213,"_5":14139,"_27008":55038,"_2880":55214},[],"Cause",{"_3394":2199,"_29710":2131,"_20617":55216,"_5":14139,"_27008":55038,"_2880":55217},[],"Action",{"_3394":2200,"_29710":2131,"_20617":55219,"_5":14139,"_27008":55038,"_2880":55220},[],"`PUT /v1/roles/{ca-ski}` returns 404 and `GET` returns 200.",{"_3394":2201,"_29710":2131,"_20617":55222,"_5":14139,"_27008":55038,"_2880":55223},[],"The role’s CA was deleted and no other CA with the same SKI remains.",{"_3394":2202,"_29710":2131,"_20617":55225,"_5":14139,"_27008":55038,"_2880":55226},[],"There is no API way out; it requires database intervention. Avoid it by adjusting the role before deleting the CA.",{"_3394":2203,"_29710":2131,"_20617":55228,"_5":14139,"_27008":55038,"_2880":55229},[],"`PUT` returns 400.",{"_3394":2204,"_29710":2131,"_20617":55231,"_5":14139,"_27008":55038,"_2880":55232},[],"The signer lacks `cRLSign`, or its subject and key match no CA with that SKI (for example, after deleting the first of two CAs that share a key).",{"_3394":2205,"_29710":2131,"_20617":55234,"_5":14139,"_27008":55038,"_2880":55235},[],"Use `PUT` to set the serial number of a valid certificate of the remaining CA.",{"_3394":2206,"_29710":2131,"_20617":55237,"_5":14139,"_27008":55038,"_2880":55238},[],"`PUT` returns 400 from a 3.x client.",{"_3394":2207,"_29710":2131,"_20617":55240,"_5":14139,"_27008":55038,"_2880":55241},[],"`crl_options.subject_key_id_signer` was replaced by `signer_certificate_serial_number`, which is required.",{"_3394":2208,"_29710":2131,"_20617":55243,"_5":14139,"_27008":55038,"_2880":55244},[],"Update the client to send the new field.",{"_3394":2209,"_29710":2131,"_20617":55246,"_5":14139,"_27008":55038,"_2880":55247},[],"The CRL does not change after revoking a certificate.",{"_3394":2210,"_29710":2131,"_20617":55249,"_5":14139,"_27008":55038,"_2880":55250},[],"`regenerate_on_revoke` is `false`, the issuing CA has no VA role, or generation failed because of an invalid signer.",{"_3394":2211,"_29710":2131,"_20617":55252,"_5":14139,"_27008":55038,"_2880":55253},[],"Check the VA logs. A missing role only produces a warning (no retry, no failed-events entry); an invalid signer also leaves the event in the failed-events queue, so fix the signer.",{"_3394":2212,"_29710":2131,"_20617":55255,"_5":14139,"_27008":55038,"_2880":55256},[],"A verifier rejects the CRL because of the issuer.",{"_3394":2213,"_29710":2131,"_20617":55258,"_5":14139,"_27008":55038,"_2880":55259},[],"Several CAs share an SKI.",{"_3394":2214,"_29710":2131,"_20617":55261,"_5":14139,"_27008":55038,"_2880":55262},[],"See CAs that share a key.",{"_3394":2215,"_29710":2131,"_20617":55264,"_5":14139,"_27008":55042,"_2880":55265},[],"The CA view lets you inspect and download the available list. Compare version, issuer and timestamps with the copy downloaded from the public endpoint. The CA’s VA settings also let you select the CRL signer: the certificate picker only offers certificates that have a private key and carry the `cRLSign` key usage. If a configured signer’s certificate cannot be resolved, the interface shows `Unknown Certificate (Serial: X)` or `Certificate details unavailable (Serial: X)`. Diagnose differences using PKI troubleshooting.",{"_3394":2216,"_29710":2131,"_20617":55267,"_5":14139,"_27008":55046,"_2880":55268},[],"RFC 5280: X.509 and CRL profile.",{"_3394":2217,"_29710":2131,"_20617":55270,"_5":14139,"_27008":55046,"_2880":55271},[],"OpenSSL: openssl-crl.",{"_3394":2218,"_29710":2131,"_20617":55273,"_5":14139,"_27008":55046,"_2880":55274},[],"OpenSSL: openssl-verify.",{"_3394":2219,"_29710":2131,"_20617":55276,"_5":14139,"_27008":55046,"_2880":55277},[],"<Card title=\"OCSP service\" href=\"/docs/platform/pki/ocsp\" />",{"_3394":2220,"_29710":2131,"_20617":55279,"_5":14139,"_27008":55046,"_2880":55280},[],"<Card title=\"Certificate validation\" href=\"/docs/platform/pki/certificate-validation\" />",{"_3394":2221,"_29710":2221,"_5":14491,"_2880":55282,"_30042":55283,"_20617":55284,"_27008":2221},"Keys and cryptographic engines",[48369,49837,53839,53840],[],{"_3394":2222,"_29710":2221,"_20617":55286,"_5":14139,"_27008":2221,"_2880":55287},[],"Generate, import and operate keys without coupling the PKI to a specific provider.",{"_3394":2223,"_29710":2221,"_5":30039,"_20617":55289,"_27008":55290,"_2880":55291},[],"/docs/platform/pki/key-management#what-the-kms-solves","What the KMS solves",{"_3394":2224,"_29710":2221,"_5":30039,"_20617":55293,"_27008":55294,"_2880":55295},[],"/docs/platform/pki/key-management#cryptographic-engines","Cryptographic engines",{"_3394":2225,"_29710":2221,"_5":30039,"_20617":55297,"_27008":55298,"_2880":55299},[],"/docs/platform/pki/key-management#file-system","File System",{"_3394":2226,"_29710":2221,"_5":30039,"_20617":55301,"_27008":55302,"_2880":55303},[],"/docs/platform/pki/key-management#hashicorp-vault","HashiCorp Vault",{"_3394":2227,"_29710":2221,"_5":30039,"_20617":55305,"_27008":55306,"_2880":55307},[],"/docs/platform/pki/key-management#aws-secrets-manager","AWS Secrets Manager",{"_3394":2228,"_29710":2221,"_5":30039,"_20617":55309,"_27008":55310,"_2880":55311},[],"/docs/platform/pki/key-management#aws-kms","AWS KMS",{"_3394":2229,"_29710":2221,"_5":30039,"_20617":55313,"_27008":55314,"_2880":55315},[],"/docs/platform/pki/key-management#pkcs11","PKCS#11",{"_3394":2230,"_29710":2221,"_5":30039,"_20617":55317,"_27008":55318,"_2880":55319},[],"/docs/platform/pki/key-management#azure-key-vault","Azure Key Vault",{"_3394":2231,"_29710":2221,"_5":30039,"_20617":55321,"_27008":55322,"_2880":55323},[],"/docs/platform/pki/key-management#key-inventory","Key inventory",{"_3394":2232,"_29710":2221,"_5":30039,"_20617":55325,"_27008":55326,"_2880":55327},[],"/docs/platform/pki/key-management#create-or-import-keys","Create or import keys",{"_3394":2233,"_29710":2221,"_5":30039,"_20617":55329,"_27008":55330,"_2880":55331},[],"/docs/platform/pki/key-management#generate-a-new-key-pair","Generate a new key pair",{"_3394":2234,"_29710":2221,"_5":30039,"_20617":55333,"_27008":55334,"_2880":55335},[],"/docs/platform/pki/key-management#import-an-existing-pair","Import an existing pair",{"_3394":2235,"_29710":2221,"_5":30039,"_20617":55337,"_27008":55338,"_2880":55339},[],"/docs/platform/pki/key-management#operations-on-a-key","Operations on a key",{"_3394":2236,"_29710":2221,"_5":30039,"_20617":55341,"_27008":55342,"_2880":55343},[],"/docs/platform/pki/key-management#view-details","View details",{"_3394":2237,"_29710":2221,"_5":30039,"_20617":55345,"_27008":55346,"_2880":55347},[],"/docs/platform/pki/key-management#sign-and-verify","Sign and verify",{"_3394":2238,"_29710":2221,"_5":30039,"_20617":55349,"_27008":55350,"_2880":55351},[],"/docs/platform/pki/key-management#sign","Sign",{"_3394":2239,"_29710":2221,"_5":30039,"_20617":55353,"_27008":55354,"_2880":55355},[],"/docs/platform/pki/key-management#verify","Verify",{"_3394":2240,"_29710":2221,"_5":30039,"_20617":55357,"_27008":55358,"_2880":55359},[],"/docs/platform/pki/key-management#generate-a-csr","Generate a CSR",{"_3394":2241,"_29710":2221,"_5":30039,"_20617":55361,"_27008":55362,"_2880":55363},[],"/docs/platform/pki/key-management#sign-locally-with-pkcs11","Sign locally with PKCS#11",{"_3394":2242,"_29710":2221,"_5":30039,"_20617":55365,"_27008":55366,"_2880":55367},[],"/docs/platform/pki/key-management#before-deleting-a-key","Before deleting a key",{"_3394":2243,"_29710":2221,"_20617":55369,"_5":14139,"_27008":2221,"_2880":55370},[],"The Cryptographic Key Management Service (KMS) of Lamassu IoT centralizes the generation, import, custody and use of the platform's keys. This is where you manage the keys that support the CAs and the rest of the signing operations that depend on the PKI.",{"_3394":2244,"_29710":2221,"_20617":55372,"_5":14139,"_27008":2221,"_2880":55373},[],"In the current configuration, Lamassu IoT works exclusively with asymmetric keys, such as RSA and elliptic curves. These keys are used to issue X.509 certificates, sign requests and perform authentication and validation operations within the system.",{"_3394":2245,"_29710":2221,"_20617":55375,"_5":14139,"_27008":55290,"_2880":55376},[],"The KMS unifies key lifecycle management and prevents every service from having to integrate directly with a specific cryptographic provider.",{"_3394":2246,"_29710":2221,"_20617":55378,"_5":14139,"_27008":55290,"_2880":55379},[],"In practice, it lets you:",{"_3394":2247,"_29710":2221,"_20617":55381,"_5":14139,"_27008":55290,"_2880":55382},[],"Generate new key pairs from Lamassu IoT.",{"_3394":2248,"_29710":2221,"_20617":55384,"_5":14139,"_27008":55290,"_2880":55385},[],"Import keys created externally.",{"_3394":2249,"_29710":2221,"_20617":55387,"_5":14139,"_27008":55290,"_2880":55388},[],"Delegate custody and cryptographic operations to external engines.",{"_3394":2250,"_29710":2221,"_20617":55390,"_5":14139,"_27008":55290,"_2880":55391},[],"Reuse existing keys for CAs, CSRs and signing or verification tasks.",{"_3394":2251,"_29710":2221,"_20617":55393,"_5":14139,"_27008":55294,"_2880":55394},[],"Lamassu can work with different cryptographic engines depending on deployment requirements. In some environments a software engine is enough; in others custody must be delegated to an HSM, a cloud service or a specialized platform.",{"_3394":2252,"_29710":2221,"_20617":55396,"_5":14139,"_27008":55294,"_2880":55397},[],"A single instance can have several engines configured at the same time, including multiple instances of the same type. This lets you adapt operations to different security, cost and regulatory requirements.",{"_3394":2253,"_29710":2221,"_20617":55399,"_5":14139,"_27008":55294,"_2880":55400},[],"This guide is for the PKI operator: select and use an already enabled engine. Installation, credentials, persistent storage and connectivity belong to Deployment. Before generating a CA, check the default engine, advertised algorithms and a test signature. Availability in your installation depends on its version and configuration.",{"_3394":2254,"_29710":2221,"_20617":55402,"_5":14139,"_27008":55298,"_2880":55403},[],"Generates software keys and stores private material in files. Custody depends on installation permissions, storage and backups. Before using it for an operational CA, agree how the key will be recovered and how replicas will access it; the KMS record does not replace those files.",{"_3394":2255,"_29710":2221,"_20617":55405,"_5":14139,"_27008":55302,"_2880":55406},[],"The adapter uses KV storage for private material. This is not signing within Vault Transit: someone able to read the secret can recover the key. Review read permissions, availability and recovery with the deployment owner.",{"_3394":2256,"_29710":2221,"_20617":55408,"_5":14139,"_27008":55302,"_2880":55409},[],"The adapter reaches Vault over its configured HTTP(S) endpoint. The Vault server certificate is verified against the system trust store; a Vault signed by a private CA is trusted by adding its CA certificate to the engine's `ca_cert_file` (PEM-encoded). `insecure_skip_verify=true` disables verification and is a last resort; agree the transport settings with the deployment owner.",{"_3394":2257,"_29710":2221,"_20617":55411,"_5":14139,"_27008":55306,"_2880":55412},[],"Offers encrypted persistence in AWS at a cost. It protects the key at rest, but an authorized administrator can recover it; it does not provide the same extraction resistance as a KMS or HSM.",{"_3394":2258,"_29710":2221,"_20617":55414,"_5":14139,"_27008":55310,"_2880":55415},[],"Delegates signing to AWS KMS. The adapter also implements external material import, subject to provider capabilities and permissions. A key generated outside the service has already existed outside its custody; importing it does not remove those copies. Check generation, import and signing as separate operations.",{"_3394":2259,"_29710":2221,"_20617":55417,"_5":14139,"_27008":55314,"_2880":55418},[],"Allows integrating local HSMs, isolated environments and *Key as a Service* offerings. Generation, persistence and extraction resistance depend on the specific device or provider. It is the most flexible option when policy requires hardware custody.",{"_3394":2260,"_29710":2221,"_20617":55420,"_5":14139,"_27008":55318,"_2880":55421},[],"The backend also provides adapters for **Key Vault Keys** and **Key Vault Secrets**. The former delegates signing to the key service; the latter stores private material as secrets and signs using that material. These are different custody models. Confirm which adapter is enabled in your installation and test the required operations.",{"_3394":2261,"_29710":2221,"_20617":55423,"_5":14139,"_27008":55318,"_2880":55424},[],"Lamassu shows the enabled engines in the console.",{"_3394":2262,"_29710":2221,"_20617":55426,"_5":14139,"_27008":55318,"_2880":55427},[],"Each engine defines which algorithms it supports, such as RSA or ECC/ECDSA, and which key sizes it can generate.",{"_3394":2263,"_29710":2221,"_20617":55429,"_5":14139,"_27008":55318,"_2880":55430},[],"Confirm with the deployment operator which engine is configured as the default. That engine will be used when a process needs to create or persist a key and the user has not selected a specific one, for example when creating or importing a CA.",{"_3394":2264,"_29710":2221,"_20617":55432,"_5":14139,"_27008":55322,"_2880":55433},[],"The main KMS screen shows the complete inventory of keys registered in the system. It is the reference view for reviewing which keys exist, where they are kept and which entities they relate to.",{"_3394":2265,"_29710":2221,"_20617":55435,"_5":14139,"_27008":55322,"_2880":55436},[],"The table includes the following fields:",{"_3394":2266,"_29710":2221,"_20617":55438,"_5":14139,"_27008":55322,"_2880":55439},[],"**Name**: descriptive name of the key.",{"_3394":2267,"_29710":2221,"_20617":55441,"_5":14139,"_27008":55322,"_2880":55442},[],"**Type**: algorithm and key size, for example RSA 2048 or EC P-256.",{"_3394":2268,"_29710":2221,"_20617":55444,"_5":14139,"_27008":55322,"_2880":55445},[],"**Strength**: visual indicator of cryptographic strength.",{"_3394":2269,"_29710":2221,"_20617":55447,"_5":14139,"_27008":55322,"_2880":55448},[],"**Public/Private**: whether Lamassu manages the full pair or only the public key.",{"_3394":2270,"_29710":2221,"_20617":55450,"_5":14139,"_27008":55322,"_2880":55451},[],"**Crypto Engine**: cryptographic engine keeping the key.",{"_3394":2271,"_29710":2221,"_20617":55453,"_5":14139,"_27008":55322,"_2880":55454},[],"**Aliases**: alternative names associated with the key.",{"_3394":2272,"_29710":2221,"_20617":55456,"_5":14139,"_27008":55322,"_2880":55457},[],"**Tags**: labels for classification and search.",{"_3394":2273,"_29710":2221,"_20617":55459,"_5":14139,"_27008":55322,"_2880":55460},[],"**Related Entities**: certificates or other entities linked to that key.",{"_3394":2274,"_29710":2221,"_20617":55462,"_5":14139,"_27008":55322,"_2880":55463},[],"From this view you also reach the most common actions:",{"_3394":2275,"_29710":2221,"_20617":55465,"_5":14139,"_27008":55322,"_2880":55466},[],"**View Details** to inspect metadata, identifiers and relationships.",{"_3394":2276,"_29710":2221,"_20617":55468,"_5":14139,"_27008":55322,"_2880":55469},[],"**Generate CSR** to create a PKCS#10 request with the selected key.",{"_3394":2277,"_29710":2221,"_20617":55471,"_5":14139,"_27008":55322,"_2880":55472},[],"**Sign / Verify** to test cryptographic operations on the key.",{"_3394":2278,"_29710":2221,"_20617":55474,"_5":14139,"_27008":55322,"_2880":55475},[],"**Delete Key** to remove the key from the system.",{"_3394":2279,"_29710":2221,"_20617":55477,"_5":14139,"_27008":55326,"_2880":55478},[],"You need key administration permissions and a reachable engine. The issuance profile must allow the chosen algorithm if the key will be used in a CA or CSR. Open **Create New Key** and choose generation or import.",{"_3394":2280,"_29710":2221,"_20617":55480,"_5":14139,"_27008":55330,"_2880":55481},[],"If the key will be born inside Lamassu, the recommended flow is to generate a new pair managed directly by one of the configured engines.",{"_3394":2281,"_29710":2221,"_20617":55483,"_5":14139,"_27008":55330,"_2880":55484},[],"On the wizard's first screen, choose **Generate New Key Pair** and then define the main parameters:",{"_3394":2282,"_29710":2221,"_20617":55486,"_5":14139,"_27008":55330,"_2880":55487},[],"**Key Name**: unique and descriptive name.",{"_3394":2283,"_29710":2221,"_20617":55489,"_5":14139,"_27008":55330,"_2880":55490},[],"**Crypto Engine**: engine that will keep the key.",{"_3394":2284,"_29710":2221,"_20617":55492,"_5":14139,"_27008":55330,"_2880":55493},[],"**Key Type** and **Key Size**: algorithm and size or curve.",{"_3394":2285,"_29710":2221,"_20617":55495,"_5":14139,"_27008":55330,"_2880":55496},[],"**Tags**: metadata to classify the key.",{"_3394":2286,"_29710":2221,"_20617":55498,"_5":14139,"_27008":55330,"_2880":55499},[],"**Metadata**: additional information for advanced uses.",{"_3394":2287,"_29710":2221,"_20617":55501,"_5":14139,"_27008":55334,"_2880":55502},[],"Importing lets you register in Lamassu a key generated outside the platform. It is the usual flow in BYOK scenarios, migrations or integration with cryptographic material already in production.",{"_3394":2288,"_29710":2221,"_20617":55504,"_5":14139,"_27008":55334,"_2880":55505},[],"When you have an exportable private key and the destination engine supports import.",{"_3394":2289,"_29710":2221,"_20617":55507,"_5":14139,"_27008":55334,"_2880":55508},[],"When an existing PKI needs to be migrated without reissuing certificates.",{"_3394":2290,"_29710":2221,"_20617":55510,"_5":14139,"_27008":55334,"_2880":55511},[],"When Lamassu must operate with a root of trust created by a third party.",{"_3394":2291,"_29710":2221,"_20617":55513,"_5":14139,"_27008":55334,"_2880":55514},[],"In the wizard, choose **Import Existing Key Pair** and complete the requested fields:",{"_3394":2292,"_29710":2221,"_20617":55516,"_5":14139,"_27008":55334,"_2880":55517},[],"**Key Name**: descriptive name within Lamassu IoT.",{"_3394":2293,"_29710":2221,"_20617":55519,"_5":14139,"_27008":55334,"_2880":55520},[],"**Crypto Engine**: engine that will keep the imported key.",{"_3394":2294,"_29710":2221,"_20617":55522,"_5":14139,"_27008":55334,"_2880":55523},[],"**Tags**: labels for organization and search.",{"_3394":2295,"_29710":2221,"_20617":55525,"_5":14139,"_27008":55334,"_2880":55526},[],"**Metadata**: additional optional information.",{"_3394":2296,"_29710":2221,"_20617":55528,"_5":14139,"_27008":55334,"_2880":55529},[],"**Private Key (PEM)**: private key in PEM format.",{"_3394":2297,"_29710":2221,"_20617":55531,"_5":14139,"_27008":55334,"_2880":55532},[],"After a successful import, open the record, check the engine and public key, and perform a test signature. A non-exportable HSM key cannot be uploaded through this PEM form: configure engine access and check how the existing key is registered. Review dependencies and any provider resources already created if an operation fails partway through.",{"_3394":2298,"_29710":2221,"_20617":55534,"_5":14139,"_27008":55338,"_2880":55535},[],"Each registered key has a detail view and several operational actions.",{"_3394":2299,"_29710":2221,"_20617":55537,"_5":14139,"_27008":55342,"_2880":55538},[],"The **View Details** screen concentrates the technical and administrative information of the key.",{"_3394":2300,"_29710":2221,"_20617":55540,"_5":14139,"_27008":55342,"_2880":55541},[],"The **Overview** tab shows, among others, these fields:",{"_3394":2301,"_29710":2221,"_20617":55543,"_5":14139,"_27008":55342,"_2880":55544},[],"**Key Name**: descriptive name.",{"_3394":2302,"_29710":2221,"_20617":55546,"_5":14139,"_27008":55342,"_2880":55547},[],"**Key Identifier**: unique system identifier. Lamassu uses PKCS11-based ID formats.",{"_3394":2303,"_29710":2221,"_20617":55549,"_5":14139,"_27008":55342,"_2880":55550},[],"**Tags**: associated labels.",{"_3394":2304,"_29710":2221,"_20617":55552,"_5":14139,"_27008":55342,"_2880":55553},[],"**Aliases**: alternative names.",{"_3394":2305,"_29710":2221,"_20617":55555,"_5":14139,"_27008":55342,"_2880":55556},[],"**Crypto Engine**: engine where the key resides.",{"_3394":2306,"_29710":2221,"_20617":55558,"_5":14139,"_27008":55342,"_2880":55559},[],"**Algorithm, Key Size & Strength**: algorithm, parameters and strength level.",{"_3394":2307,"_29710":2221,"_20617":55561,"_5":14139,"_27008":55342,"_2880":55562},[],"The **Related Entities** section shows which Lamassu objects depend on that key.",{"_3394":2308,"_29710":2221,"_20617":55564,"_5":14139,"_27008":55342,"_2880":55565},[],"The **Public Key** tab shows public material in PEM. The record’s identifier and URI locate the key; a PKCS#11-formatted URI does not establish that the engine is an HSM or that a local module can access it.",{"_3394":2309,"_29710":2221,"_20617":55567,"_5":14139,"_27008":55346,"_2880":55568},[],"The **Sign / Verify** action validates that the key and the cryptographic engine work correctly.",{"_3394":2310,"_29710":2221,"_20617":55570,"_5":14139,"_27008":55346,"_2880":55571},[],"Sign a test message, save the signature and verify it using the same public key, algorithm and encoding. Then change the message: verification should fail. This tests one operation; it does not establish every engine capability or a CA’s chain.",{"_3394":2311,"_29710":2221,"_20617":55573,"_5":14139,"_27008":55346,"_2880":55574},[],"When you open it, two areas appear: **Sign** and **Verify**.",{"_3394":2312,"_29710":2221,"_20617":55576,"_5":14139,"_27008":55350,"_2880":55577},[],"This tab uses the private key to generate a digital signature over a message or an already computed *digest*.",{"_3394":2313,"_29710":2221,"_20617":55579,"_5":14139,"_27008":55350,"_2880":55580},[],"Main fields:",{"_3394":2314,"_29710":2221,"_20617":55582,"_5":14139,"_27008":55350,"_2880":55583},[],"**Algorithm**: signing algorithm available for the key type.",{"_3394":2315,"_29710":2221,"_20617":55585,"_5":14139,"_27008":55350,"_2880":55586},[],"**Message Type**: `Raw` for clear data or `Digest` for a precomputed hash.",{"_3394":2316,"_29710":2221,"_20617":55588,"_5":14139,"_27008":55350,"_2880":55589},[],"**Payload Encoding**: input encoding, such as UTF-8, Hex or Base64.",{"_3394":2317,"_29710":2221,"_20617":55591,"_5":14139,"_27008":55350,"_2880":55592},[],"**Message**: content to sign.",{"_3394":2318,"_29710":2221,"_20617":55594,"_5":14139,"_27008":55350,"_2880":55595},[],"**Signature**: result of the operation, shown in hexadecimal.",{"_3394":2319,"_29710":2221,"_20617":55597,"_5":14139,"_27008":55354,"_2880":55598},[],"This tab checks whether a signature corresponds to the associated public key.",{"_3394":2320,"_29710":2221,"_20617":55600,"_5":14139,"_27008":55354,"_2880":55580},[],{"_3394":2321,"_29710":2221,"_20617":55602,"_5":14139,"_27008":55354,"_2880":55603},[],"**Algorithm**: must match the algorithm used for the signature.",{"_3394":2322,"_29710":2221,"_20617":55605,"_5":14139,"_27008":55354,"_2880":55606},[],"**Message Type**: `Raw` or `Digest`.",{"_3394":2323,"_29710":2221,"_20617":55608,"_5":14139,"_27008":55354,"_2880":55609},[],"**Payload Encoding**: encoding of the message.",{"_3394":2324,"_29710":2221,"_20617":55611,"_5":14139,"_27008":55354,"_2880":55612},[],"**Message**: original message or hash.",{"_3394":2325,"_29710":2221,"_20617":55614,"_5":14139,"_27008":55354,"_2880":55615},[],"**Signature**: signature to check.",{"_3394":2326,"_29710":2221,"_20617":55617,"_5":14139,"_27008":55354,"_2880":55618},[],"**Result**: indicator of the validation result.",{"_3394":2327,"_29710":2221,"_20617":55620,"_5":14139,"_27008":55358,"_2880":55621},[],"The **Generate CSR** action creates a PKCS#10 request signed with the private key kept in Lamassu, without exposing it outside the cryptographic engine.",{"_3394":2328,"_29710":2221,"_20617":55623,"_5":14139,"_27008":55358,"_2880":55624},[],"This flow is useful for:",{"_3394":2329,"_29710":2221,"_20617":55626,"_5":14139,"_27008":55358,"_2880":55627},[],"Requesting certificates from an external CA.",{"_3394":2330,"_29710":2221,"_20617":55629,"_5":14139,"_27008":55358,"_2880":55630},[],"Renewing an identity while keeping the same key.",{"_3394":2331,"_29710":2221,"_20617":55632,"_5":14139,"_27008":55358,"_2880":55633},[],"When you open the form, it asks for the subject data and the main certificate attributes:",{"_3394":2332,"_29710":2221,"_20617":55635,"_5":14139,"_27008":55358,"_2880":55636},[],"**Common Name (CN)**: main name of the identity.",{"_3394":2333,"_29710":2221,"_20617":55638,"_5":14139,"_27008":55358,"_2880":55639},[],"**Organization (O)**: organization or company.",{"_3394":2334,"_29710":2221,"_20617":55641,"_5":14139,"_27008":55358,"_2880":55642},[],"**Organizational Unit (OU)**: department or unit.",{"_3394":2335,"_29710":2221,"_20617":55644,"_5":14139,"_27008":55358,"_2880":55645},[],"**Country (C)**: two-letter country code.",{"_3394":2336,"_29710":2221,"_20617":55647,"_5":14139,"_27008":55358,"_2880":55648},[],"**State / Province (ST)**: state or province.",{"_3394":2337,"_29710":2221,"_20617":55650,"_5":14139,"_27008":55358,"_2880":55651},[],"**Locality (L)**: city or locality.",{"_3394":2338,"_29710":2221,"_20617":55653,"_5":14139,"_27008":55358,"_2880":55654},[],"**Email Address**: contact email.",{"_3394":2339,"_29710":2221,"_20617":55656,"_5":14139,"_27008":55358,"_2880":55657},[],"**Subject Alternative Names (SANs)**: alternative names or identifiers, such as DNS or IP.",{"_3394":2340,"_29710":2221,"_20617":55659,"_5":14139,"_27008":55358,"_2880":55660},[],"Download the CSR and run `openssl req -in request.csr -noout -verify -text`. Check signature, subject and SAN before sending it. A CSR does not determine the final certificate by itself: issuance policy can replace its fields.",{"_3394":2341,"_29710":2221,"_20617":55662,"_5":14139,"_27008":55362,"_2880":55663},[],"Lamassu also offers specific help for local integrations through **Sign locally with OpenSSL & PKCS11 tools**.",{"_3394":2342,"_29710":2221,"_20617":55665,"_5":14139,"_27008":55362,"_2880":55666},[],"It requires the module, token and permissions of the corresponding provider. Check that the Lamassu identifier matches the object accessible from that module. Module configuration belongs to the client environment or Deployment.",{"_3394":2343,"_29710":2221,"_20617":55668,"_5":14139,"_27008":55366,"_2880":55669},[],"Review **Related Entities** and locate CAs, certificates and validation processes that still need signatures. Revoking a CA does not remove the need to publish status during its retention period. Deleting a key does not automatically revoke its certificates either. Plan replacement and retention before using **Delete Key**; provider deletion behavior depends on the engine.",{"_3394":2344,"_29710":2221,"_20617":55671,"_5":14139,"_27008":55366,"_2880":55672},[],"The KMS refuses to delete a key that certificates still reference, with `409` `key is in use`. Revoking a certificate or letting it expire does not release its key reference. Deleting a CA releases the references from its own current certificate and linked reissued certificates, which stay in place to back the CRL and OCSP, and then attempts to delete the key. If other certificates still reference the key, such as another CA sharing it, the KMS keeps it. The certificates the CA issued keep their own key references, even when revoked. The API lets you delete such a certificate only once its issuer CA no longer exists, and deleting it removes it from the CRL and OCSP responses, so keep revoked certificates for their retention period and delete only expired or superseded ones. Legacy references retained by the upgrade migration are described in the upgrade guide.",{"_3394":2345,"_29710":2345,"_5":14491,"_2880":55674,"_30042":55675,"_20617":55676,"_27008":2345},"Online validation with OCSP",[48369,49837,53839,54478],[],{"_3394":2346,"_29710":2345,"_20617":55678,"_5":14139,"_27008":2345,"_2880":55679},[],"Query signed status and verify the responder’s response.",{"_3394":2347,"_29710":2345,"_5":30039,"_20617":55681,"_27008":55682,"_2880":55683},[],"/docs/platform/pki/ocsp#how-the-responder-works-in-lamassu","How the responder works in Lamassu",{"_3394":2348,"_29710":2345,"_5":30039,"_20617":55685,"_27008":55686,"_2880":55687},[],"/docs/platform/pki/ocsp#embedding-in-issued-certificates","Embedding in issued certificates",{"_3394":2349,"_29710":2345,"_5":30039,"_20617":55689,"_27008":55690,"_2880":55691},[],"/docs/platform/pki/ocsp#http-endpoints","HTTP endpoints",{"_3394":2350,"_29710":2345,"_5":30039,"_20617":55693,"_27008":55694,"_2880":55695},[],"/docs/platform/pki/ocsp#generate-and-verify-a-query","Generate and verify a query",{"_3394":2351,"_29710":2345,"_5":30039,"_20617":55697,"_27008":55698,"_2880":55699},[],"/docs/platform/pki/ocsp#check-from-the-interface","Check from the interface",{"_3394":2352,"_29710":2345,"_5":30039,"_20617":55701,"_27008":55702,"_2880":55047},[],"/docs/platform/pki/ocsp#references",{"_3394":2353,"_29710":2345,"_20617":55704,"_5":14139,"_27008":2345,"_2880":55705},[],"OCSP queries a certificate’s status and returns a signed response. This guide is for an integrator checking what Lamassu publishes and how the consumer must verify it. For complete identity validation, follow Certificate validation.",{"_3394":2354,"_29710":2345,"_20617":55707,"_5":14139,"_27008":55682,"_2880":55708},[],"The responder retrieves the certificate by serial number and locates its issuing CA in the inventory. It translates persisted status as follows:",{"_3394":2355,"_29710":2345,"_20617":55710,"_5":14139,"_27008":55682,"_2880":55711},[],"Record status",{"_3394":2356,"_29710":2345,"_20617":55713,"_5":14139,"_27008":55682,"_2880":55714},[],"Signed response",{"_3394":2357,"_29710":2345,"_20617":55716,"_5":14139,"_27008":55682,"_2880":52976},[],{"_3394":2358,"_29710":2345,"_20617":55718,"_5":14139,"_27008":55682,"_2880":55719},[],"`Good`.",{"_3394":2359,"_29710":2345,"_20617":55721,"_5":14139,"_27008":55682,"_2880":52993},[],{"_3394":2360,"_29710":2345,"_20617":55723,"_5":14139,"_27008":55682,"_2880":55724},[],"`Revoked`, with revocation reason and timestamp.",{"_3394":2361,"_29710":2345,"_20617":55726,"_5":14139,"_27008":55682,"_2880":55727},[],"Other states, including `INACTIVE` and `EXPIRED`",{"_3394":2362,"_29710":2345,"_20617":55729,"_5":14139,"_27008":55682,"_2880":55730},[],"`Unknown` if the certificate and issuer can be retrieved.",{"_3394":2363,"_29710":2345,"_20617":55732,"_5":14139,"_27008":55682,"_2880":55733},[],"An absent serial number causes a lookup error; it does not guarantee a signed `Unknown` response. Lookup or signing errors produce an HTTP failure. Treat that as unavailable evidence according to consumer policy.",{"_3394":2364,"_29710":2345,"_20617":55735,"_5":14139,"_27008":55682,"_2880":55736},[],"The issuing CA itself signs the response through its KMS-associated key. A delegated OCSP signing certificate is not used. An imported CA without a usable key cannot sign responses.",{"_3394":2365,"_29710":2345,"_20617":55738,"_5":14139,"_27008":55682,"_2880":55739},[],"The implementation sets `thisUpdate` approximately one day before response generation and `nextUpdate` one day after: the declared window is about 48 hours. Inspect received values and apply your freshness policy. The response reflects stored status when queried; a previously cached copy does not change upon revocation.",{"_3394":2366,"_29710":2345,"_20617":55741,"_5":14139,"_27008":55686,"_2880":55742},[],"The signer constructs OCSP URLs from configured VA domains and adds them to AIA. Without domains, there is no URL to add; an imported certificate retains its original extensions. Inspect the actual certificate:",{"_3394":2367,"_29710":2345,"_20617":55744,"_5":14139,"_27008":55686,"_2880":55745},[],"Check that the consumer can reach this URL. DNS, endpoint exposure and domain configuration belong to Deployment. Changing configuration does not modify already signed certificates.",{"_3394":2368,"_29710":2345,"_20617":55747,"_5":14139,"_27008":55690,"_2880":55748},[],"The service accepts:",{"_3394":2369,"_29710":2345,"_20617":55750,"_5":14139,"_27008":55690,"_2880":51604},[],{"_3394":2370,"_29710":2345,"_20617":55752,"_5":14139,"_27008":55690,"_2880":55753},[],"VA service path",{"_3394":2371,"_29710":2345,"_20617":55755,"_5":14139,"_27008":55690,"_2880":55756},[],"Format",{"_3394":2372,"_29710":2345,"_20617":55758,"_5":14139,"_27008":55690,"_2880":55759},[],"`POST`",{"_3394":2373,"_29710":2345,"_20617":55761,"_5":14139,"_27008":55690,"_2880":55762},[],"`/ocsp`",{"_3394":2374,"_29710":2345,"_20617":55764,"_5":14139,"_27008":55690,"_2880":55765},[],"DER request, `Content-Type: application/ocsp-request`.",{"_3394":2375,"_29710":2345,"_20617":55767,"_5":14139,"_27008":55690,"_2880":55188},[],{"_3394":2376,"_29710":2345,"_20617":55769,"_5":14139,"_27008":55690,"_2880":55770},[],"`/ocsp/{ocsp_request}`",{"_3394":2377,"_29710":2345,"_20617":55772,"_5":14139,"_27008":55690,"_2880":55773},[],"DER request encoded using padded URL Base64.",{"_3394":2378,"_29710":2345,"_20617":55775,"_5":14139,"_27008":55690,"_2880":55776},[],"Use POST to avoid client encoding differences. A successful response has `Content-Type: application/ocsp-response` and a DER body. The public prefix depends on the Gateway; use the URL published in the certificate and checked by the operator.",{"_3394":2379,"_29710":2345,"_20617":55778,"_5":14139,"_27008":55694,"_2880":55779},[],"You need OpenSSL 3.x, `device.crt`, its direct issuer’s certificate `issuer.pem` and the consumer’s trusted roots in `roots.pem`. For an intermediate issuer, also prepare `intermediates.pem` containing the intermediate CAs.",{"_3394":2380,"_29710":2345,"_20617":55781,"_5":14139,"_27008":55694,"_2880":55782},[],"Generate the request:",{"_3394":2381,"_29710":2345,"_20617":55784,"_5":14139,"_27008":55694,"_2880":55785},[],"This example omits the nonce because the responder does not echo it. Verification relies on signature, response correspondence and timestamps; it does not demonstrate freshness through a nonce.",{"_3394":2382,"_29710":2345,"_20617":55787,"_5":14139,"_27008":55694,"_2880":55788},[],"Replace the example URL with the inspected endpoint:",{"_3394":2383,"_29710":2345,"_20617":55790,"_5":14139,"_27008":55694,"_2880":55791},[],"Verify the returned DER:",{"_3394":2384,"_29710":2345,"_20617":55793,"_5":14139,"_27008":55694,"_2880":55794},[],"For intermediates, add `-verify_other intermediates.pem`. Require successful response verification and inspect the status corresponding to `device.crt`, issuer, serial, `thisUpdate` and `nextUpdate`. `Response verify OK` validates the response only: also observe `good`, `revoked` or `unknown`. Do not accept an identity based only on the command’s exit code.",{"_3394":2385,"_29710":2345,"_20617":55796,"_5":14139,"_27008":55698,"_2880":55797},[],"**OCSP Check** shows what Lamassu returns for a selected certificate. Complete the check from the consumer’s network and trust store: a console query does not establish its validation configuration.",{"_3394":2386,"_29710":2345,"_20617":55799,"_5":14139,"_27008":55698,"_2880":55800},[],"To check a change, save an earlier response, revoke a test certificate and request another response. The new query should reflect persisted status; compare timestamps to rule out reuse of an earlier response. If it fails, follow PKI troubleshooting.",{"_3394":2387,"_29710":2345,"_20617":55802,"_5":14139,"_27008":55702,"_2880":55803},[],"RFC 6960: OCSP.",{"_3394":2388,"_29710":2345,"_20617":55805,"_5":14139,"_27008":55702,"_2880":55806},[],"OpenSSL: openssl-ocsp.",{"_3394":2389,"_29710":2345,"_20617":55808,"_5":14139,"_27008":55702,"_2880":55809},[],"<Card title=\"CRL service\" href=\"/docs/platform/pki/crl\" />",{"_3394":2390,"_29710":2345,"_20617":55811,"_5":14139,"_27008":55702,"_2880":55280},[],{"_3394":2391,"_29710":2391,"_5":14491,"_2880":53839,"_30042":55813,"_20617":55814,"_27008":2391},[48369,49837,53839],[],{"_3394":2392,"_29710":2391,"_20617":55816,"_5":14139,"_27008":2391,"_2880":55817},[],"Administer keys and authorities, define issuance and verify the resulting certificates.",{"_3394":2393,"_29710":2391,"_5":30039,"_20617":55819,"_27008":55820,"_2880":53151},[],"/docs/platform/pki/overview#start-here",{"_3394":2394,"_29710":2391,"_5":30039,"_20617":55822,"_27008":55823,"_2880":55824},[],"/docs/platform/pki/overview#what-you-need","What you need",{"_3394":2395,"_29710":2391,"_5":30039,"_20617":55826,"_27008":55827,"_2880":53683},[],"/docs/platform/pki/overview#core-capabilities",{"_3394":2396,"_29710":2391,"_5":30039,"_20617":55829,"_27008":55830,"_2880":53687},[],"/docs/platform/pki/overview#build-your-trust-hierarchy",{"_3394":2397,"_29710":2391,"_5":30039,"_20617":55832,"_27008":55833,"_2880":53691},[],"/docs/platform/pki/overview#protect-cryptographic-keys",{"_3394":2398,"_29710":2391,"_5":30039,"_20617":55835,"_27008":55836,"_2880":53695},[],"/docs/platform/pki/overview#issue-and-control-certificates",{"_3394":2399,"_29710":2391,"_5":30039,"_20617":55838,"_27008":55839,"_2880":53703},[],"/docs/platform/pki/overview#publish-validation-status",{"_3394":2400,"_29710":2391,"_5":30039,"_20617":55841,"_27008":55842,"_2880":55843},[],"/docs/platform/pki/overview#how-to-check-the-result","How to check the result",{"_3394":2401,"_29710":2391,"_5":30039,"_20617":55845,"_27008":55846,"_2880":54645},[],"/docs/platform/pki/overview#continue",{"_3394":2402,"_29710":2391,"_20617":55848,"_5":14139,"_27008":2391,"_2880":55849},[],"The PKI section explains how to build and operate X.509 trust in Lamassu: which authorities issue, which rules apply and how to check certificates. It is intended for PKI administrators and anyone who needs to use certificates in a consuming system.",{"_3394":2403,"_29710":2391,"_20617":55851,"_5":14139,"_27008":55820,"_2880":55852},[],"Follow PKI getting started to create a CA, issue a client certificate and verify it with OpenSSL. The result is a certificate, its private key and a verified chain.",{"_3394":2404,"_29710":2391,"_20617":55854,"_5":14139,"_27008":55820,"_2880":55855},[],"You can complete that path before managing devices. When you need to associate the identity with an inventory or automate its enrollment, continue in IoT Fleets.",{"_3394":2405,"_29710":2391,"_20617":55857,"_5":14139,"_27008":55823,"_2880":55858},[],"An accessible instance and permission to manage the keys, CAs and certificates you will use.",{"_3394":2406,"_29710":2391,"_20617":55860,"_5":14139,"_27008":55823,"_2880":55861},[],"An available cryptographic engine to keep the authority's key.",{"_3394":2407,"_29710":2391,"_20617":55863,"_5":14139,"_27008":55823,"_2880":55864},[],"The certificate's purpose, such as authenticating a client through mTLS.",{"_3394":2408,"_29710":2391,"_20617":55866,"_5":14139,"_27008":55823,"_2880":55867},[],"Consumer requirements: accepted issuers, algorithms, names and permitted usages.",{"_3394":2409,"_29710":2391,"_20617":55869,"_5":14139,"_27008":55823,"_2880":55870},[],"Prepare the instance and cryptographic provider in Deployment. The trust model explains hierarchy choices.",{"_3394":2410,"_29710":2391,"_20617":55872,"_5":14139,"_27008":55830,"_2880":55873},[],"Authorities sign certificates. A root establishes the trust anchor, and an intermediate separates issuance by environment or purpose. Hierarchy and rotation explains how to maintain trust when replacing an authority.",{"_3394":2411,"_29710":2391,"_20617":55875,"_5":14139,"_27008":55833,"_2880":55876},[],"CA signing keys are managed through KMS and cryptographic engines. A client that generates a CSR can keep its own key: preserve that custody when choosing the issuance method.",{"_3394":2412,"_29710":2391,"_20617":55878,"_5":14139,"_27008":55836,"_2880":55879},[],"A profile establishes subject, validity, usage and key restrictions. The CA applies issuance configuration and signs the certificate. In the inventory, you can inspect the result, download it and manage its status.",{"_3394":2413,"_29710":2391,"_20617":55881,"_5":14139,"_27008":55839,"_2880":55882},[],"Validation covers the chain, validity, usages and revocation status. Lamassu publishes status through OCSP and CRL; the consumer configures which issuers it recognizes and how it checks that status.",{"_3394":2414,"_29710":2391,"_20617":55884,"_5":14139,"_27008":55842,"_2880":55885},[],"An active certificate in the console is one part of the check. Also verify that:",{"_3394":2415,"_29710":2391,"_20617":55887,"_5":14139,"_27008":55842,"_2880":55888},[],"its subject and extensions identify the expected client;",{"_3394":2416,"_29710":2391,"_20617":55890,"_5":14139,"_27008":55842,"_2880":55891},[],"its public key matches the client's private key;",{"_3394":2417,"_29710":2391,"_20617":55893,"_5":14139,"_27008":55842,"_2880":55894},[],"its chain reaches a root trusted by the consumer;",{"_3394":2418,"_29710":2391,"_20617":55896,"_5":14139,"_27008":55842,"_2880":55897},[],"its dates and usages allow the operation;",{"_3394":2419,"_29710":2391,"_20617":55899,"_5":14139,"_27008":55842,"_2880":55900},[],"the consumer applies revocation checks and authorization.",{"_3394":2420,"_29710":2391,"_20617":55902,"_5":14139,"_27008":55842,"_2880":55903},[],"The issuance path includes the first independent checks.",{"_3394":2421,"_29710":2391,"_20617":55905,"_5":14139,"_27008":55846,"_2880":55906},[],"<Card title=\"PKI getting started\" description=\"Create a CA, then issue and verify a client certificate.\" href=\"/docs/platform/pki/quickstarts/overview\" />",{"_3394":2422,"_29710":2391,"_20617":55908,"_5":14139,"_27008":55846,"_2880":55909},[],"<Card title=\"Apply PKI to devices\" description=\"Associate certificates with inventory and prepare enrollment.\" href=\"/docs/platform/iot-fleets/overview\" />",{"_3394":2423,"_29710":2391,"_20617":55911,"_5":14139,"_27008":55846,"_2880":55912},[],"<Card title=\"PKI diagnostics\" description=\"Check issuance, OCSP and CRL when the result fails.\" href=\"/docs/platform/pki/troubleshooting\" />",{"_3394":2424,"_29710":2424,"_5":14491,"_2880":55914,"_30042":55915,"_20617":55916,"_27008":2424},"Create your first CA",[48369,49837,53839,53276],[],{"_3394":2425,"_29710":2424,"_20617":55918,"_5":14139,"_27008":2424,"_2880":55919},[],"Create an evaluation root and check its certificate before issuing.",{"_3394":2426,"_29710":2424,"_5":30039,"_20617":55921,"_27008":55922,"_2880":48379},[],"/docs/platform/pki/quickstarts/create-certificate-authority#before-you-begin",{"_3394":2427,"_29710":2424,"_5":30039,"_20617":55924,"_27008":55925,"_2880":55926},[],"/docs/platform/pki/quickstarts/create-certificate-authority#open-the-creation-wizard-toc","Open the creation wizard [!toc]",{"_3394":2428,"_29710":2424,"_5":30039,"_20617":55928,"_27008":55929,"_2880":55930},[],"/docs/platform/pki/quickstarts/create-certificate-authority#select-the-key-toc","Select the key [!toc]",{"_3394":2429,"_29710":2424,"_5":30039,"_20617":55932,"_27008":55933,"_2880":55934},[],"/docs/platform/pki/quickstarts/create-certificate-authority#define-the-authority-toc","Define the authority [!toc]",{"_3394":2430,"_29710":2424,"_5":30039,"_20617":55936,"_27008":55937,"_2880":55938},[],"/docs/platform/pki/quickstarts/create-certificate-authority#review-and-create-the-ca-toc","Review and create the CA [!toc]",{"_3394":2431,"_29710":2424,"_5":30039,"_20617":55940,"_27008":55941,"_2880":55942},[],"/docs/platform/pki/quickstarts/create-certificate-authority#verify-the-result-toc","Verify the result [!toc]",{"_3394":2432,"_29710":2424,"_5":30039,"_20617":55944,"_27008":55945,"_2880":55946},[],"/docs/platform/pki/quickstarts/create-certificate-authority#check-the-ca-certificate","Check the CA certificate",{"_3394":2433,"_29710":2424,"_5":30039,"_20617":55948,"_27008":55949,"_2880":53533},[],"/docs/platform/pki/quickstarts/create-certificate-authority#if-the-result-fails",{"_3394":2434,"_29710":2424,"_5":30039,"_20617":55951,"_27008":55952,"_2880":48403},[],"/docs/platform/pki/quickstarts/create-certificate-authority#next-step",{"_3394":2435,"_29710":2424,"_20617":55954,"_5":14139,"_27008":2424,"_2880":55955},[],"You will create a root authority with a new key kept by a Lamassu engine. The result is an active CA and its public certificate in `ca.pem`, ready to verify issuance in the next path.",{"_3394":2436,"_29710":2424,"_20617":55957,"_5":14139,"_27008":55922,"_2880":55958},[],"Console access and permission to create keys and authorities.",{"_3394":2437,"_29710":2424,"_20617":55960,"_5":14139,"_27008":55922,"_2880":55961},[],"An available cryptographic engine that supports the chosen algorithm.",{"_3394":2438,"_29710":2424,"_20617":55963,"_5":14139,"_27008":55922,"_2880":55964},[],"OpenSSL 3.x to check the downloaded certificate.",{"_3394":2439,"_29710":2424,"_20617":55966,"_5":14139,"_27008":55922,"_2880":55967},[],"Use an evaluation instance or an authority intended for these tests. The example creates a root that issues directly; to design an operational hierarchy, see Hierarchy and rotation.",{"_3394":2440,"_29710":2424,"_20617":55969,"_5":14139,"_27008":55925,"_2880":55970},[],"In **Certification Authorities**, select **Create New CA** and choose to create a CA with a new key pair.",{"_3394":2441,"_29710":2424,"_20617":55972,"_5":14139,"_27008":55925,"_2880":55973},[],"The &#x2A;*Create New CA (Existing Key)** flow is explained in the authorities guide.",{"_3394":2442,"_29710":2424,"_20617":55975,"_5":14139,"_27008":55929,"_2880":55976},[],"Choose the engine that will keep the key and an algorithm its capabilities allow. For this example, you can use **EC P-384** if available.",{"_3394":2443,"_29710":2424,"_20617":55978,"_5":14139,"_27008":55929,"_2880":55979},[],"The CA private key is used through the engine. In this path, you will download only the authority's public certificate.",{"_3394":2444,"_29710":2424,"_20617":55981,"_5":14139,"_27008":55933,"_2880":55982},[],"Select **Root CA** and complete:",{"_3394":2445,"_29710":2424,"_20617":55984,"_5":14139,"_27008":55933,"_2880":55985},[],"**CA Name**: `Acme Evaluation Root CA`.",{"_3394":2446,"_29710":2424,"_20617":55987,"_5":14139,"_27008":55933,"_2880":55988},[],"**Subject**: organization and country details for your evaluation.",{"_3394":2447,"_29710":2424,"_20617":55990,"_5":14139,"_27008":55933,"_2880":55991},[],"**CA Certificate Expiration**: for example, one year from creation.",{"_3394":2448,"_29710":2424,"_20617":55993,"_5":14139,"_27008":55933,"_2880":55994},[],"**Default End-Entity Certificate Issuance Expiration**: for example, 90 days, within the CA's lifetime.",{"_3394":2449,"_29710":2424,"_20617":55996,"_5":14139,"_27008":55933,"_2880":55997},[],"The CA name becomes its `Common Name`. Keep the CA usages needed to sign certificates and CRLs.",{"_3394":2450,"_29710":2424,"_20617":55999,"_5":14139,"_27008":55937,"_2880":56000},[],"Check the engine, algorithm, subject, root type and dates. Confirm creation and note the authority identifier so you can recognize it in the DMS or API.",{"_3394":2451,"_29710":2424,"_20617":56002,"_5":14139,"_27008":55941,"_2880":56003},[],"Open the new CA. It should appear active, show its certificate and allow access to **Issued Certificates**.",{"_3394":2452,"_29710":2424,"_20617":56005,"_5":14139,"_27008":55941,"_2880":56006},[],"Download or copy the authority's PEM certificate and save it as `ca.pem`. Check that the file contains the complete block, including `BEGIN CERTIFICATE` and `END CERTIFICATE`.",{"_3394":2453,"_29710":2424,"_20617":56008,"_5":14139,"_27008":55945,"_2880":56009},[],"Run from the directory where you saved `ca.pem`:",{"_3394":2454,"_29710":2424,"_20617":56011,"_5":14139,"_27008":55945,"_2880":56012},[],"Check that the subject and issuer match the root you created, the dates include the current time, **Basic Constraints** contains `CA:TRUE` and **Key Usage** allows certificate signing. The last command should return `ca.pem: OK`.",{"_3394":2455,"_29710":2424,"_20617":56014,"_5":14139,"_27008":55945,"_2880":56015},[],"You explicitly selected `ca.pem` as the trust anchor for this test. A valid self-signature does not install that trust in other consumers. See the openssl-verify reference for verification options.",{"_3394":2456,"_29710":2424,"_20617":56017,"_5":14139,"_27008":55949,"_2880":56018},[],"If creation fails, check permissions, engine availability and the selected algorithm.",{"_3394":2457,"_29710":2424,"_20617":56020,"_5":14139,"_27008":55949,"_2880":56021},[],"If OpenSSL cannot read the file, copy the complete PEM block again.",{"_3394":2458,"_29710":2424,"_20617":56023,"_5":14139,"_27008":55949,"_2880":56024},[],"If signature or date checks fail, check that you downloaded this CA's certificate and that your computer's clock is correct.",{"_3394":2459,"_29710":2424,"_20617":56026,"_5":14139,"_27008":55949,"_2880":56027},[],"PKI diagnostics covers issuance checks and cryptographic dependencies.",{"_3394":2460,"_29710":2424,"_20617":56029,"_5":14139,"_27008":55952,"_2880":56030},[],"Continue with Issue and verify a certificate, using this authority and `ca.pem`.",{"_3394":2461,"_29710":2461,"_5":14491,"_2880":56032,"_30042":56033,"_20617":56034,"_27008":2461},"Issue and verify a certificate",[48369,49837,53839,53276],[],{"_3394":2462,"_29710":2461,"_20617":56036,"_5":14139,"_27008":2461,"_2880":56037},[],"Issue a client certificate and check content, chain and key correspondence.",{"_3394":2463,"_29710":2461,"_5":30039,"_20617":56039,"_27008":56040,"_2880":48379},[],"/docs/platform/pki/quickstarts/issue-certificate#before-you-begin",{"_3394":2464,"_29710":2461,"_5":30039,"_20617":56042,"_27008":56043,"_2880":56044},[],"/docs/platform/pki/quickstarts/issue-certificate#start-the-issuance","Start the issuance",{"_3394":2465,"_29710":2461,"_5":30039,"_20617":56046,"_27008":56047,"_2880":56048},[],"/docs/platform/pki/quickstarts/issue-certificate#choose-the-method","Choose the method",{"_3394":2466,"_29710":2461,"_5":30039,"_20617":56050,"_27008":56051,"_2880":56052},[],"/docs/platform/pki/quickstarts/issue-certificate#identify-the-certificate","Identify the certificate",{"_3394":2467,"_29710":2461,"_5":30039,"_20617":56054,"_27008":56055,"_2880":56056},[],"/docs/platform/pki/quickstarts/issue-certificate#configure-key-and-uses","Configure key and uses",{"_3394":2468,"_29710":2461,"_5":30039,"_20617":56058,"_27008":56059,"_2880":56060},[],"/docs/platform/pki/quickstarts/issue-certificate#issue-and-download","Issue and download",{"_3394":2469,"_29710":2461,"_5":30039,"_20617":56062,"_27008":56063,"_2880":56064},[],"/docs/platform/pki/quickstarts/issue-certificate#verify-the-result","Verify the result",{"_3394":2470,"_29710":2461,"_5":30039,"_20617":56066,"_27008":56067,"_2880":56068},[],"/docs/platform/pki/quickstarts/issue-certificate#inspect-content-and-dates","Inspect content and dates",{"_3394":2471,"_29710":2461,"_5":30039,"_20617":56070,"_27008":56071,"_2880":56072},[],"/docs/platform/pki/quickstarts/issue-certificate#verify-the-chain","Verify the chain",{"_3394":2472,"_29710":2461,"_5":30039,"_20617":56074,"_27008":56075,"_2880":56076},[],"/docs/platform/pki/quickstarts/issue-certificate#check-that-the-key-matches","Check that the key matches",{"_3394":2473,"_29710":2461,"_5":30039,"_20617":56078,"_27008":56079,"_2880":53533},[],"/docs/platform/pki/quickstarts/issue-certificate#if-the-result-fails",{"_3394":2474,"_29710":2461,"_5":30039,"_20617":56081,"_27008":56082,"_2880":48403},[],"/docs/platform/pki/quickstarts/issue-certificate#next-step",{"_3394":2475,"_29710":2461,"_20617":56084,"_5":14139,"_27008":2461,"_2880":56085},[],"You will issue an end-entity certificate for `device-001` using browser key and CSR generation. The result is `device.crt`, `device.key` and the issuing root's public certificate, `ca.pem`.",{"_3394":2476,"_29710":2461,"_20617":56087,"_5":14139,"_27008":56040,"_2880":56088},[],"An active root CA with an available signing key and permission to issue. If one does not exist yet, follow Create your first CA.",{"_3394":2477,"_29710":2461,"_20617":56090,"_5":14139,"_27008":56040,"_2880":56091},[],"Its public certificate in `ca.pem`; this example uses the root created in the previous path.",{"_3394":2478,"_29710":2461,"_20617":56093,"_5":14139,"_27008":56040,"_2880":56094},[],"OpenSSL 3.x and a working directory with restricted access.",{"_3394":2479,"_29710":2461,"_20617":56096,"_5":14139,"_27008":56040,"_2880":56097},[],"A client identifier: here we use `device-001`.",{"_3394":2480,"_29710":2461,"_20617":56099,"_5":14139,"_27008":56040,"_2880":56100},[],"In this flow, the client's key is generated in the browser and must be downloaded when issuance finishes. If you lose it, you must generate a key and issue another certificate. The certificate inventory lets you download the public certificate, but cannot recover this key.",{"_3394":2481,"_29710":2461,"_20617":56102,"_5":14139,"_27008":56043,"_2880":56103},[],"Open the CA from the previous path, go to **Issued Certificates** and select **Issue New**.",{"_3394":2482,"_29710":2461,"_20617":56105,"_5":14139,"_27008":56047,"_2880":56106},[],"Select **Generate Key & CSR in Browser** to follow this example.",{"_3394":2483,"_29710":2461,"_20617":56108,"_5":14139,"_27008":56047,"_2880":56109},[],"If the key must be generated and kept on the destination system, use **Upload Existing CSR**, described in the authorities guide.",{"_3394":2484,"_29710":2461,"_20617":56111,"_5":14139,"_27008":56051,"_2880":56112},[],"Enter `device-001` as the `Common Name`. Add subject details required by your policy and SANs if the consumer uses them to identify the client.",{"_3394":2485,"_29710":2461,"_20617":56114,"_5":14139,"_27008":56051,"_2880":56115},[],"If you continue with manual registration, the `Device ID` will be exactly `device-001`.",{"_3394":2486,"_29710":2461,"_20617":56117,"_5":14139,"_27008":56055,"_2880":56118},[],"Choose an algorithm and size allowed by the profile; for example, ECDSA P-256 if permitted. For this client certificate, select **Digital Signature** and **Client Authentication**, and issue it as an end-entity certificate.",{"_3394":2487,"_29710":2461,"_20617":56120,"_5":14139,"_27008":56055,"_2880":56121},[],"Request, for example, 30 days of validity, always within the CA's lifetime. Review the issuance profile if the resulting content differs from the request.",{"_3394":2488,"_29710":2461,"_20617":56123,"_5":14139,"_27008":56059,"_2880":56124},[],"Confirm issuance. Save the PEM certificate as `device.crt` and the private key as `device.key` in your prepared directory.",{"_3394":2489,"_29710":2461,"_20617":56126,"_5":14139,"_27008":56063,"_2880":56127},[],"Check in **Issued Certificates** that the certificate appears active. Note its serial number and verify the downloaded material using the checks below.",{"_3394":2490,"_29710":2461,"_20617":56129,"_5":14139,"_27008":56067,"_2880":56130},[],"Check `CN=device-001`, the expected issuer, current validity, **Digital Signature** and the extended usage **TLS Web Client Authentication**. It must be an end-entity certificate: it must not declare `CA:TRUE` or enable **Certificate Sign**. If **Basic Constraints** is present, it must indicate `CA:FALSE`. If you requested SANs, check that the expected identifiers appear in the certificate.",{"_3394":2491,"_29710":2461,"_20617":56132,"_5":14139,"_27008":56071,"_2880":56133},[],"The expected result is `device.crt: OK`. This check uses your explicit root and evaluates the chain, dates and compatibility with the TLS client purpose. Also check for the expected usages and names through the inspection above.",{"_3394":2492,"_29710":2461,"_20617":56135,"_5":14139,"_27008":56071,"_2880":56136},[],"If you use an intermediate CA, the trusted root must be in `ca.pem` and you must supply the intermediates with `-untrusted intermediates.pem`. This variant is covered in the trust model.",{"_3394":2493,"_29710":2461,"_20617":56138,"_5":14139,"_27008":56071,"_2880":56139},[],"The command does not query OCSP or CRL. For revocation checks, continue with Certificate validation. See the openssl-verify reference for its options.",{"_3394":2494,"_29710":2461,"_20617":56141,"_5":14139,"_27008":56075,"_2880":56142},[],"In Bash, compare the two public-key digests:",{"_3394":2495,"_29710":2461,"_20617":56144,"_5":14139,"_27008":56075,"_2880":56145},[],"Both commands must finish successfully and show the same SHA-256 digest. If they differ, the private key does not match the selected certificate. Find the correct pair before installing it.",{"_3394":2496,"_29710":2461,"_20617":56147,"_5":14139,"_27008":56075,"_2880":56148},[],"The options used are documented in openssl-x509 and openssl-pkey.",{"_3394":2497,"_29710":2461,"_20617":56150,"_5":14139,"_27008":56079,"_2880":53617},[],{"_3394":2498,"_29710":2461,"_20617":56152,"_5":14139,"_27008":56079,"_2880":56153},[],"What to review",{"_3394":2499,"_29710":2461,"_20617":56155,"_5":14139,"_27008":56079,"_2880":56156},[],"The CA rejects issuance",{"_3394":2500,"_29710":2461,"_20617":56158,"_5":14139,"_27008":56079,"_2880":56159},[],"Permissions, CA state and key, algorithm and profile.",{"_3394":2501,"_29710":2461,"_20617":56161,"_5":14139,"_27008":56079,"_2880":56162},[],"Different subject or usages",{"_3394":2502,"_29710":2461,"_20617":56164,"_5":14139,"_27008":56079,"_2880":56165},[],"Applied profile and requested values.",{"_3394":2503,"_29710":2461,"_20617":56167,"_5":14139,"_27008":56079,"_2880":56168},[],"Issuer cannot be found",{"_3394":2504,"_29710":2461,"_20617":56170,"_5":14139,"_27008":56079,"_2880":56171},[],"Downloaded CA and required intermediate chain.",{"_3394":2505,"_29710":2461,"_20617":56173,"_5":14139,"_27008":56079,"_2880":56174},[],"Validity fails",{"_3394":2506,"_29710":2461,"_20617":56176,"_5":14139,"_27008":56079,"_2880":56177},[],"Certificate and CA dates, and the computer's clock.",{"_3394":2507,"_29710":2461,"_20617":56179,"_5":14139,"_27008":56079,"_2880":56180},[],"Public-key digests differ",{"_3394":2508,"_29710":2461,"_20617":56182,"_5":14139,"_27008":56079,"_2880":56183},[],"Certificate and key files from the same issuance.",{"_3394":2509,"_29710":2461,"_20617":56185,"_5":14139,"_27008":56079,"_2880":56186},[],"See PKI diagnostics to narrow an issuance failure.",{"_3394":2510,"_29710":2461,"_20617":56188,"_5":14139,"_27008":56082,"_2880":56189},[],"You have completed the PKI path when the certificate verifies and the key matches. Choose how to use it:",{"_3394":2511,"_29710":2461,"_20617":56191,"_5":14139,"_27008":56082,"_2880":56192},[],"Manage certificates for inspection, status and revocation.",{"_3394":2512,"_29710":2461,"_20617":56194,"_5":14139,"_27008":56082,"_2880":56195},[],"Register a device manually to associate this identity with Lamassu's inventory.",{"_3394":2513,"_29710":2461,"_20617":56197,"_5":14139,"_27008":56082,"_2880":56198},[],"Prepare EST for the device to request its next identities.",{"_3394":2514,"_29710":2461,"_20617":56200,"_5":14139,"_27008":56082,"_2880":56201},[],"Acceptance by a consumer requires configuring its trust, revocation checks and permissions granted to the identity.",{"_3394":2515,"_29710":2515,"_5":14491,"_2880":56203,"_30042":56204,"_20617":56205,"_27008":2515},"PKI getting started",[48369,49837,53839,53276],[],{"_3394":2516,"_29710":2515,"_20617":56207,"_5":14139,"_27008":2515,"_2880":56208},[],"Create a CA, issue a client certificate and check its chain and key.",{"_3394":2517,"_29710":2515,"_5":30039,"_20617":56210,"_27008":56211,"_2880":48379},[],"/docs/platform/pki/quickstarts/overview#before-you-begin",{"_3394":2518,"_29710":2515,"_5":30039,"_20617":56213,"_27008":56214,"_2880":56215},[],"/docs/platform/pki/quickstarts/overview#recommended-path","Recommended path",{"_3394":2519,"_29710":2515,"_5":30039,"_20617":56217,"_27008":56218,"_2880":53468},[],"/docs/platform/pki/quickstarts/overview#expected-result",{"_3394":2520,"_29710":2515,"_5":30039,"_20617":56220,"_27008":56221,"_2880":56222},[],"/docs/platform/pki/quickstarts/overview#continue-according-to-your-goal","Continue according to your goal",{"_3394":2521,"_29710":2515,"_20617":56224,"_5":14139,"_27008":2515,"_2880":56225},[],"This path is intended for those starting to administer PKI or needing a first X.509 client identity. It ends with three files: a root CA certificate, an end-entity certificate and the client's private key.",{"_3394":2522,"_29710":2515,"_20617":56227,"_5":14139,"_27008":56211,"_2880":56228},[],"A Lamassu instance accessible from your browser. To prepare one, see Deployment.",{"_3394":2523,"_29710":2515,"_20617":56230,"_5":14139,"_27008":56211,"_2880":56231},[],"Permission to manage keys, authorities and issuance. See Access control if an operation is blocked.",{"_3394":2524,"_29710":2515,"_20617":56233,"_5":14139,"_27008":56211,"_2880":56234},[],"An available cryptographic engine for the CA key; check the keys and engines inventory.",{"_3394":2525,"_29710":2515,"_20617":56236,"_5":14139,"_27008":56211,"_2880":56237},[],"OpenSSL 3.x on the computer where you will verify the files.",{"_3394":2526,"_29710":2515,"_20617":56239,"_5":14139,"_27008":56211,"_2880":56240},[],"A working directory with restricted access for the downloaded key.",{"_3394":2527,"_29710":2515,"_20617":56242,"_5":14139,"_27008":56214,"_2880":56243},[],"<Card title=\"1. Create your first CA\" description=\"Create an evaluation root and save its public certificate as ca.pem.\" href=\"/docs/platform/pki/quickstarts/create-certificate-authority\" />",{"_3394":2528,"_29710":2515,"_20617":56245,"_5":14139,"_27008":56214,"_2880":56246},[],"<Card title=\"2. Issue and verify a certificate\" description=\"Issue for device-001 and check content, chain and key correspondence.\" href=\"/docs/platform/pki/quickstarts/issue-certificate\" />",{"_3394":2529,"_29710":2515,"_20617":56248,"_5":14139,"_27008":56214,"_2880":56249},[],"We use `Acme Evaluation Root CA` and `device-001` as example names. If you replace them, keep the same client identifier in the steps you want to connect.",{"_3394":2530,"_29710":2515,"_20617":56251,"_5":14139,"_27008":56214,"_2880":56252},[],"The root in this path signs the end-entity certificate directly to simplify evaluation. Before designing an operational PKI, review the trust model and CA hierarchy.",{"_3394":2531,"_29710":2515,"_20617":56254,"_5":14139,"_27008":56218,"_2880":56255},[],"File or resource",{"_3394":2532,"_29710":2515,"_20617":56257,"_5":14139,"_27008":56218,"_2880":53465},[],{"_3394":2533,"_29710":2515,"_20617":56259,"_5":14139,"_27008":56218,"_2880":56260},[],"Active root CA and `ca.pem`",{"_3394":2534,"_29710":2515,"_20617":56262,"_5":14139,"_27008":56218,"_2880":56263},[],"It is a CA certificate, is currently valid and its self-signature verifies.",{"_3394":2535,"_29710":2515,"_20617":56265,"_5":14139,"_27008":56218,"_2880":56266},[],"End-entity certificate and `device.crt`",{"_3394":2536,"_29710":2515,"_20617":56268,"_5":14139,"_27008":56218,"_2880":56269},[],"It identifies `device-001`, supports client authentication and verifies against `ca.pem`.",{"_3394":2537,"_29710":2515,"_20617":56271,"_5":14139,"_27008":56218,"_2880":56272},[],"Private key `device.key`",{"_3394":2538,"_29710":2515,"_20617":56274,"_5":14139,"_27008":56218,"_2880":56275},[],"Its public key matches the one included in `device.crt`.",{"_3394":2539,"_29710":2515,"_20617":56277,"_5":14139,"_27008":56218,"_2880":56278},[],"These checks validate the issued material. Acceptance by a service also requires its trust, authorization and revocation configuration.",{"_3394":2540,"_29710":2515,"_20617":56280,"_5":14139,"_27008":56221,"_2880":56281},[],"To operate certificates, continue with Certificates and Validation.",{"_3394":2541,"_29710":2515,"_20617":56283,"_5":14139,"_27008":56221,"_2880":56284},[],"To manage a device identity in Lamassu, follow Manual registration. That path includes DMS preparation.",{"_3394":2542,"_29710":2515,"_20617":56286,"_5":14139,"_27008":56221,"_2880":56287},[],"For the device to request its certificate, prepare the DMS and EST client.",{"_3394":2543,"_29710":2543,"_5":14491,"_2880":56289,"_30042":56290,"_20617":56291,"_27008":2543},"PKI troubleshooting",[48369,49837,53839,52414],[],{"_3394":2544,"_29710":2543,"_20617":56293,"_5":14139,"_27008":2543,"_2880":56294},[],"Diagnose certificate issuance, OCSP and CRL.",{"_3394":2545,"_29710":2543,"_5":30039,"_20617":56296,"_27008":56297,"_2880":56298},[],"/docs/platform/pki/troubleshooting#issuance-fails","Issuance fails",{"_3394":2546,"_29710":2543,"_5":30039,"_20617":56300,"_27008":56301,"_2880":56302},[],"/docs/platform/pki/troubleshooting#ocsp-or-crl-do-not-reflect-a-change","OCSP or CRL do not reflect a change",{"_3394":2547,"_29710":2543,"_5":30039,"_20617":56304,"_27008":56305,"_2880":56306},[],"/docs/platform/pki/troubleshooting#the-chain-validates-but-the-connection-fails","The chain validates but the connection fails",{"_3394":2548,"_29710":2543,"_20617":56308,"_5":14139,"_27008":2543,"_2880":56309},[],"This guide helps a PKI operator locate issuance and status publication failures. Keep the Lamassu version, operation, CA, issuer, serial, time and returned error. Do not include private keys or tokens in diagnostics.",{"_3394":2549,"_29710":2543,"_20617":56311,"_5":14139,"_27008":2543,"_2880":56312},[],"For Gateway, sign-in, pods, dependencies and messaging, see Deployment troubleshooting. For device enrollment, see EST diagnostics.",{"_3394":2550,"_29710":2543,"_20617":56314,"_5":14139,"_27008":56297,"_2880":53465},[],{"_3394":2551,"_29710":2543,"_20617":56316,"_5":14139,"_27008":56297,"_2880":56317},[],"What to inspect",{"_3394":2552,"_29710":2543,"_20617":56319,"_5":14139,"_27008":56297,"_2880":48403},[],{"_3394":2553,"_29710":2543,"_20617":56321,"_5":14139,"_27008":56297,"_2880":52681},[],{"_3394":2554,"_29710":2543,"_20617":56323,"_5":14139,"_27008":56297,"_2880":56324},[],"Exists, is active and has usable dates.",{"_3394":2555,"_29710":2543,"_20617":56326,"_5":14139,"_27008":56297,"_2880":56327},[],"Authorities.",{"_3394":2556,"_29710":2543,"_20617":56329,"_5":14139,"_27008":56297,"_2880":56330},[],"Key",{"_3394":2557,"_29710":2543,"_20617":56332,"_5":14139,"_27008":56297,"_2880":56333},[],"The record has a usable private key and the engine can sign.",{"_3394":2558,"_29710":2543,"_20617":56335,"_5":14139,"_27008":56297,"_2880":56336},[],"Try **Sign / Verify** in KMS; check provider permissions and availability.",{"_3394":2559,"_29710":2543,"_20617":56338,"_5":14139,"_27008":56297,"_2880":56339},[],"CSR",{"_3394":2560,"_29710":2543,"_20617":56341,"_5":14139,"_27008":56297,"_2880":56342},[],"Correct PEM and verifiable signature.",{"_3394":2561,"_29710":2543,"_20617":56344,"_5":14139,"_27008":56297,"_2880":56345},[],"`openssl req -in request.csr -noout -verify -text`.",{"_3394":2562,"_29710":2543,"_20617":56347,"_5":14139,"_27008":56297,"_2880":56348},[],"Profile",{"_3394":2563,"_29710":2543,"_20617":56350,"_5":14139,"_27008":56297,"_2880":56351},[],"Selected source, existing ID, allowed algorithm and size.",{"_3394":2564,"_29710":2543,"_20617":56353,"_5":14139,"_27008":56297,"_2880":56354},[],"Check Profiles precedence; CA and DMS resolve differently.",{"_3394":2565,"_29710":2543,"_20617":56356,"_5":14139,"_27008":56297,"_2880":53617},[],{"_3394":2566,"_29710":2543,"_20617":56358,"_5":14139,"_27008":56297,"_2880":56359},[],"Appropriate subject, SAN, usages and dates.",{"_3394":2567,"_29710":2543,"_20617":56361,"_5":14139,"_27008":56297,"_2880":56362},[],"Compare CSR, profile and certificate; successful issuance does not establish consumer acceptance.",{"_3394":2568,"_29710":2543,"_20617":56364,"_5":14139,"_27008":56297,"_2880":56365},[],"For unexpected certificate fields, review `Honor Subject`, `Honor Key Usage`, `Honor Extended Key Usages` and `Honor Extensions`. The latter preserves SAN only, without validating entitlement to those names. Validity is not automatically clamped to CA expiration.",{"_3394":2569,"_29710":2543,"_20617":56367,"_5":14139,"_27008":56297,"_2880":56368},[],"For CA reissuance failures, check revocation and date: reissuance is not supported for a revoked or already expired CA. To change its key, use Hierarchy and rotation.",{"_3394":2570,"_29710":2543,"_20617":56370,"_5":14139,"_27008":56301,"_2880":56371},[],"Check each boundary independently:",{"_3394":2571,"_29710":2543,"_20617":56373,"_5":14139,"_27008":56301,"_2880":56374},[],"**Record:** read the correct certificate again by serial and issuer. Confirm status, reason and time; expired or permanently revoked records reject further transitions.",{"_3394":2572,"_29710":2543,"_20617":56376,"_5":14139,"_27008":56301,"_2880":56377},[],"**Endpoint:** inspect AIA and CDP. Query those URLs from the consumer’s network; an old route or incorrect issuer can explain a discrepancy.",{"_3394":2573,"_29710":2543,"_20617":56379,"_5":14139,"_27008":56301,"_2880":56380},[],"**OCSP:** save a fresh response, verify signature and timestamps, and observe status. An HTTP error for an absent serial does not mean `Good` or guarantee a signed `Unknown`.",{"_3394":2574,"_29710":2543,"_20617":56382,"_5":14139,"_27008":56301,"_2880":56383},[],"**CRL:** compare `latest_crl`, number and timestamps with the downloaded list. Check the serial in its contents. If unchanged, review `regenerate_on_revoke`, event delivery, jobs, signing and storage with the deployment operator.",{"_3394":2575,"_29710":2543,"_20617":56385,"_5":14139,"_27008":56301,"_2880":56386},[],"**Client:** check cache, policy for expired or unavailable evidence, critical IDP extension and rejection of a new connection.",{"_3394":2576,"_29710":2543,"_20617":56388,"_5":14139,"_27008":56301,"_2880":56389},[],"Reactivation from `CertificateHold` needs a new CRL for the client to stop seeing the hold. Reactivating a CA does not restore its descendant cascade; inspect every status and individual operation failure.",{"_3394":2577,"_29710":2543,"_20617":56391,"_5":14139,"_27008":56305,"_2880":56392},[],"Check expected identity, SAN, KU/EKU, matching key, presented intermediates and consumer permissions. Distinguish server TLS trust, client authentication and action authorization. Follow Validation for positive and rejection tests.",{"_3394":2578,"_29710":2543,"_20617":56394,"_5":14139,"_27008":56305,"_2880":56395},[],"When escalating a problem, provide identifiers, error and relevant public evidence, including query timestamps and version. This distinguishes issuance, publication and consumer application failures.",{"_3394":2579,"_29710":2579,"_5":14491,"_2880":56397,"_30042":56398,"_20617":56399,"_27008":2579},"Security",[48369],[],{"_3394":2580,"_29710":2579,"_20617":56401,"_5":14139,"_27008":2579,"_2880":56402},[],"How to report a security vulnerability in Lamassu privately, what to include in a report and which releases receive security fixes.",{"_3394":2581,"_29710":2579,"_5":30039,"_20617":56404,"_27008":56405,"_2880":56406},[],"/docs/security#report-a-vulnerability","Report a vulnerability",{"_3394":2582,"_29710":2579,"_5":30039,"_20617":56408,"_27008":56409,"_2880":56410},[],"/docs/security#what-to-include-in-a-report","What to include in a report",{"_3394":2583,"_29710":2579,"_5":30039,"_20617":56412,"_27008":56413,"_2880":56414},[],"/docs/security#supported-versions","Supported versions",{"_3394":2584,"_29710":2579,"_5":30039,"_20617":56416,"_27008":56417,"_2880":56418},[],"/docs/security#responsible-disclosure","Responsible disclosure",{"_3394":2585,"_29710":2579,"_20617":56420,"_5":14139,"_27008":2579,"_2880":56421},[],"Found a security vulnerability in lamassuiot, lamassu-dashboard, or lamassu-helm? This page explains how to report it privately, what to include in your report and which releases receive security fixes.",{"_3394":2586,"_29710":2579,"_20617":56423,"_5":14139,"_27008":56405,"_2880":56424},[],"Do not report security vulnerabilities through public GitHub issues, discussions, or pull requests. Public reports disclose the problem before maintainers can fix it.",{"_3394":2587,"_29710":2579,"_20617":56426,"_5":14139,"_27008":56405,"_2880":56427},[],"Instead, report privately using GitHub Security Advisories for the affected repository:",{"_3394":2588,"_29710":2579,"_20617":56429,"_5":14139,"_27008":56405,"_2880":14758},[],{"_3394":2589,"_29710":2579,"_20617":56431,"_5":14139,"_27008":56405,"_2880":14704},[],{"_3394":2590,"_29710":2579,"_20617":56433,"_5":14139,"_27008":56405,"_2880":14751},[],{"_3394":2591,"_29710":2579,"_20617":56435,"_5":14139,"_27008":56405,"_2880":56436},[],"This lets maintainers assess and address the issue before it is publicly disclosed.",{"_3394":2592,"_29710":2579,"_20617":56438,"_5":14139,"_27008":56405,"_2880":56439},[],"If private vulnerability reporting is not enabled for that repository, report the vulnerability privately to lamassuiot\\@lksnext.com before disclosing any details publicly.",{"_3394":2593,"_29710":2579,"_20617":56441,"_5":14139,"_27008":56409,"_2880":56442},[],"Describe the vulnerability, its potential impact, and steps to reproduce it using non-sensitive, redacted examples.",{"_3394":2594,"_29710":2579,"_20617":56444,"_5":14139,"_27008":56409,"_2880":56445},[],"Do not include in the report:",{"_3394":2595,"_29710":2579,"_20617":56447,"_5":14139,"_27008":56409,"_2880":56448},[],"Credentials, tokens, or private keys",{"_3394":2596,"_29710":2579,"_20617":56450,"_5":14139,"_27008":56409,"_2880":56451},[],"Customer data or customer-identifiable information",{"_3394":2597,"_29710":2579,"_20617":56453,"_5":14139,"_27008":56409,"_2880":56454},[],"Confidential architecture or internal infrastructure details",{"_3394":2598,"_29710":2579,"_20617":56456,"_5":14139,"_27008":56413,"_2880":56457},[],"Only the latest stable release receives security support. Support for a stable release ends when the next stable release is published. Older releases and pre-releases are not supported.",{"_3394":2599,"_29710":2579,"_20617":56459,"_5":14139,"_27008":56413,"_2880":56460},[],"For upgrade guidance, see Upgrades.",{"_3394":2600,"_29710":2579,"_20617":56462,"_5":14139,"_27008":56417,"_2880":56463},[],"Give maintainers reasonable time to investigate and address a reported vulnerability before any public disclosure.",{"_3394":2601,"_29710":2579,"_20617":56465,"_5":14139,"_27008":56417,"_2880":56466},[],"Avoid privacy violations, data destruction, and service disruption while researching a vulnerability.",{"_3394":2602,"_29710":2579,"_20617":56468,"_5":14139,"_27008":56417,"_2880":56469},[],"Only interact with accounts or data you own, or for which you have explicit permission.",{"_3394":2603,"_29710":2579,"_20617":56471,"_5":14139,"_27008":56417,"_2880":56472},[],"Maintainers acknowledge reports in a timely manner and keep you informed of remediation progress.",{"_3394":2604,"_29710":2579,"_20617":56474,"_5":14139,"_27008":56417,"_2880":56475},[],"This policy covers the source code, configuration, and CI/CD workflows of the lamassuiot, lamassu-dashboard, and lamassu-helm repositories.",{"_3394":2605,"_29710":2605,"_5":14491,"_2880":56477,"_30042":56478,"_20617":56480,"_27008":2605},"3.8.0 to 4.0.0",[48369,56479],"Upgrades",[],{"_3394":2606,"_29710":2605,"_20617":56482,"_5":14139,"_27008":2605,"_2880":56483},[],"What changes in the 4.0.0 architecture, which changes break a 3.8.0 deployment, how to upgrade a Helm release step by step and how to validate the result.",{"_3394":2607,"_29710":2605,"_5":30039,"_20617":56485,"_27008":56486,"_2880":56487},[],"/docs/upgrades/3-8-0-to-4-0-0#architecture-changes","Architecture changes",{"_3394":2608,"_29710":2605,"_5":30039,"_20617":56489,"_27008":56490,"_2880":56491},[],"/docs/upgrades/3-8-0-to-4-0-0#one-postgresql-database-with-schemas","One PostgreSQL database with schemas",{"_3394":2609,"_29710":2605,"_5":30039,"_20617":56493,"_27008":56494,"_2880":56495},[],"/docs/upgrades/3-8-0-to-4-0-0#authorization-moves-into-the-authz-service","Authorization moves into the authz service",{"_3394":2610,"_29710":2605,"_5":30039,"_20617":56497,"_27008":56498,"_2880":56499},[],"/docs/upgrades/3-8-0-to-4-0-0#device-events-get-their-own-store","Device events get their own store",{"_3394":2611,"_29710":2605,"_5":30039,"_20617":56501,"_27008":56502,"_2880":56503},[],"/docs/upgrades/3-8-0-to-4-0-0#a-hardened-helm-chart","A hardened Helm chart",{"_3394":2612,"_29710":2605,"_5":30039,"_20617":56505,"_27008":56506,"_2880":56507},[],"/docs/upgrades/3-8-0-to-4-0-0#what-the-upgrade-migrates-automatically","What the upgrade migrates automatically",{"_3394":2613,"_29710":2605,"_5":30039,"_20617":56509,"_27008":56510,"_2880":56511},[],"/docs/upgrades/3-8-0-to-4-0-0#breaking-changes","Breaking changes",{"_3394":2614,"_29710":2605,"_5":30039,"_20617":56513,"_27008":56514,"_2880":56515},[],"/docs/upgrades/3-8-0-to-4-0-0#helm-chart-and-values","Helm chart and values",{"_3394":2615,"_29710":2605,"_5":30039,"_20617":56517,"_27008":56518,"_2880":56519},[],"/docs/upgrades/3-8-0-to-4-0-0#release-scoped-resource-names","Release-scoped resource names",{"_3394":2616,"_29710":2605,"_5":30039,"_20617":56521,"_27008":56522,"_2880":56523},[],"/docs/upgrades/3-8-0-to-4-0-0#strict-values-validation","Strict values validation",{"_3394":2617,"_29710":2605,"_5":30039,"_20617":56525,"_27008":56526,"_2880":56527},[],"/docs/upgrades/3-8-0-to-4-0-0#required-authorization-configuration","Required authorization configuration",{"_3394":2618,"_29710":2605,"_5":30039,"_20617":56529,"_27008":56530,"_2880":56531},[],"/docs/upgrades/3-8-0-to-4-0-0#gateway-token-validation-removed","Gateway token validation removed",{"_3394":2619,"_29710":2605,"_5":30039,"_20617":56533,"_27008":56534,"_2880":56535},[],"/docs/upgrades/3-8-0-to-4-0-0#non-root-containers","Non-root containers",{"_3394":2620,"_29710":2605,"_5":30039,"_20617":56537,"_27008":56538,"_2880":56539},[],"/docs/upgrades/3-8-0-to-4-0-0#amqp-over-tls","AMQP over TLS",{"_3394":2621,"_29710":2605,"_5":30039,"_20617":56541,"_27008":56542,"_2880":56543},[],"/docs/upgrades/3-8-0-to-4-0-0#renamed-and-reshaped-values","Renamed and reshaped values",{"_3394":2622,"_29710":2605,"_5":30039,"_20617":56545,"_27008":56546,"_2880":56547},[],"/docs/upgrades/3-8-0-to-4-0-0#data-and-storage","Data and storage",{"_3394":2623,"_29710":2605,"_5":30039,"_20617":56549,"_27008":56550,"_2880":56551},[],"/docs/upgrades/3-8-0-to-4-0-0#postgresql-consolidation","PostgreSQL consolidation",{"_3394":2624,"_29710":2605,"_5":30039,"_20617":56553,"_27008":56554,"_2880":56555},[],"/docs/upgrades/3-8-0-to-4-0-0#sqlite-storage-removed","SQLite storage removed",{"_3394":2625,"_29710":2605,"_5":30039,"_20617":56557,"_27008":56558,"_2880":56559},[],"/docs/upgrades/3-8-0-to-4-0-0#legacy-ca-keys-in-the-kms","Legacy CA keys in the KMS",{"_3394":2626,"_29710":2605,"_5":30039,"_20617":56561,"_27008":56562,"_2880":56563},[],"/docs/upgrades/3-8-0-to-4-0-0#references-between-certificates-keys-and-va-roles","References between certificates, keys and VA roles",{"_3394":2627,"_29710":2605,"_5":30039,"_20617":56565,"_27008":56566,"_2880":56567},[],"/docs/upgrades/3-8-0-to-4-0-0#apis-and-stored-configuration","APIs and stored configuration",{"_3394":2628,"_29710":2605,"_5":30039,"_20617":56569,"_27008":56570,"_2880":56571},[],"/docs/upgrades/3-8-0-to-4-0-0#dms-webhooks","DMS webhooks",{"_3394":2629,"_29710":2605,"_5":30039,"_20617":56573,"_27008":56574,"_2880":56575},[],"/docs/upgrades/3-8-0-to-4-0-0#re-enrollment-trust-set","Re-enrollment trust set",{"_3394":2630,"_29710":2605,"_5":30039,"_20617":56577,"_27008":56578,"_2880":56579},[],"/docs/upgrades/3-8-0-to-4-0-0#independent-re-enrollment-authentication","Independent re-enrollment authentication",{"_3394":2631,"_29710":2605,"_5":30039,"_20617":56581,"_27008":56582,"_2880":56583},[],"/docs/upgrades/3-8-0-to-4-0-0#dms-update-api","DMS update API",{"_3394":2632,"_29710":2605,"_5":30039,"_20617":56585,"_27008":56586,"_2880":56587},[],"/docs/upgrades/3-8-0-to-4-0-0#certificate-type-values","Certificate type values",{"_3394":2633,"_29710":2605,"_5":30039,"_20617":56589,"_27008":56590,"_2880":56591},[],"/docs/upgrades/3-8-0-to-4-0-0#device-events","Device events",{"_3394":2634,"_29710":2605,"_5":30039,"_20617":56593,"_27008":56594,"_2880":56595},[],"/docs/upgrades/3-8-0-to-4-0-0#va-role-signer-field","VA role signer field",{"_3394":2635,"_29710":2605,"_5":30039,"_20617":56597,"_27008":56598,"_2880":56599},[],"/docs/upgrades/3-8-0-to-4-0-0#va-crl-signer","VA CRL signer",{"_3394":2636,"_29710":2605,"_5":30039,"_20617":56601,"_27008":56602,"_2880":56603},[],"/docs/upgrades/3-8-0-to-4-0-0#helm-migration-guide","Helm migration guide",{"_3394":2637,"_29710":2605,"_5":30039,"_20617":56605,"_27008":56606,"_2880":56607},[],"/docs/upgrades/3-8-0-to-4-0-0#step-1-prepare","Step 1: Prepare",{"_3394":2638,"_29710":2605,"_5":30039,"_20617":56609,"_27008":56610,"_2880":56611},[],"/docs/upgrades/3-8-0-to-4-0-0#step-2-update-the-values-file","Step 2: Update the values file",{"_3394":2639,"_29710":2605,"_5":30039,"_20617":56613,"_27008":56614,"_2880":56615},[],"/docs/upgrades/3-8-0-to-4-0-0#step-3-run-the-upgrade","Step 3: Run the upgrade",{"_3394":2640,"_29710":2605,"_5":30039,"_20617":56617,"_27008":56618,"_2880":56619},[],"/docs/upgrades/3-8-0-to-4-0-0#step-4-migrate-the-kms-and-va-data","Step 4: Migrate the KMS and VA data",{"_3394":2641,"_29710":2605,"_5":30039,"_20617":56621,"_27008":56622,"_2880":56623},[],"/docs/upgrades/3-8-0-to-4-0-0#step-5-remove-the-one-off-migration-values","Step 5: Remove the one-off migration values",{"_3394":2642,"_29710":2605,"_5":30039,"_20617":56625,"_27008":56626,"_2880":56627},[],"/docs/upgrades/3-8-0-to-4-0-0#deployments-without-helm","Deployments without Helm",{"_3394":2643,"_29710":2605,"_5":30039,"_20617":56629,"_27008":56630,"_2880":52414},[],"/docs/upgrades/3-8-0-to-4-0-0#troubleshooting",{"_3394":2644,"_29710":2605,"_5":30039,"_20617":56632,"_27008":56633,"_2880":56634},[],"/docs/upgrades/3-8-0-to-4-0-0#validation-checklist","Validation checklist",{"_3394":2645,"_29710":2605,"_5":30039,"_20617":56636,"_27008":56637,"_2880":56638},[],"/docs/upgrades/3-8-0-to-4-0-0#delete-the-old-volumes","Delete the old volumes",{"_3394":2646,"_29710":2605,"_20617":56640,"_5":14139,"_27008":2605,"_2880":56641},[],"Lamassu 4.0.0 is a major release. Storage consolidates into a single PostgreSQL database, a new `authz` service authorizes every request, the Helm chart is hardened, and several APIs and stored configurations change shape. Most data converts automatically during the upgrade, but some changes need operator action before, during or after it.",{"_3394":2647,"_29710":2605,"_20617":56643,"_5":14139,"_27008":2605,"_2880":56644},[],"This page is organized in four parts. Read them in order before you upgrade production:",{"_3394":2648,"_29710":2605,"_20617":56646,"_5":14139,"_27008":2605,"_2880":56647},[],"Architecture changes: what is different in 4.0.0 and what the upgrade migrates on its own.",{"_3394":2649,"_29710":2605,"_20617":56649,"_5":14139,"_27008":2605,"_2880":56650},[],"Breaking changes: every change that can break a 3.8.0 deployment, who it affects and what to do.",{"_3394":2650,"_29710":2605,"_20617":56652,"_5":14139,"_27008":2605,"_2880":56653},[],"Helm migration guide: the step-by-step procedure for a Helm-managed release.",{"_3394":2651,"_29710":2605,"_20617":56655,"_5":14139,"_27008":2605,"_2880":56656},[],"Validation checklist: how to confirm the upgrade worked before you remove the old data.",{"_3394":2652,"_29710":2605,"_20617":56658,"_5":14139,"_27008":2605,"_2880":56659},[],"The 4.0.0 release is upcoming and the backend migration steps on this page are provisional. Verify each procedure against the final release artifacts before upgrading production.",{"_3394":2653,"_29710":2605,"_20617":56661,"_5":14139,"_27008":56490,"_2880":56662},[],"3.8.0 gave each service its own database. The 4.0.0 backend connects to a single PostgreSQL database named `pki` and isolates each service in a schema: `kms`, `ca`, `va`, `devicemanager`, `dmsmanager` and `alerts`. The `authz` service keeps its principals, grants and policies in a separate `authz` database (the development monolith uses an `authz` schema inside `pki` instead), and WFX keeps its own `wfx` database.",{"_3394":2654,"_29710":2605,"_20617":56664,"_5":14139,"_27008":56490,"_2880":56665},[],"PostgreSQL is now the only storage engine. SQLite support is removed, and the `couch_db` and `dynamo_db` engines are not registered in 4.0.0.",{"_3394":2655,"_29710":2605,"_20617":56667,"_5":14139,"_27008":56494,"_2880":56668},[],"In 3.8.0 the API Gateway validated tokens: a JWT policy on every private route checked the signature and only let through tokens that carried the administrator role. Every route was open to any token that passed that check.",{"_3394":2656,"_29710":2605,"_20617":56670,"_5":14139,"_27008":56494,"_2880":56671},[],"4.0.0 removes the gateway policy. The `/api/*` routes reach the services directly, and each service authorizes every request through `authz`, which validates the token against the identity provider's JWKS endpoint and applies fine-grained, entity-level policies to CAs, certificates, devices, DMSs, KMS keys and VA roles. There is no implicit superuser: the first administrator comes from a bootstrap principal that you configure. The access control page documents principals, policies and the first administrator.",{"_3394":2657,"_29710":2605,"_20617":56673,"_5":14139,"_27008":56498,"_2880":56674},[],"Historical device events move from the `devices.events` column to a dedicated `device_events` store with their own endpoints. The events endpoint can also stream events over Server-Sent Events (SSE); to fan events out across service instances, each Device Manager instance binds its own durable AMQP queue.",{"_3394":2658,"_29710":2605,"_20617":56676,"_5":14139,"_27008":56502,"_2880":56677},[],"Version 4.0.0 of the chart is a security-hardening release:",{"_3394":2659,"_29710":2605,"_20617":56679,"_5":14139,"_27008":56502,"_2880":56680},[],"**Release-scoped resource names.** Every chart-managed resource is named `<release>-lamassu-<component>` instead of the fixed names used in 3.8.0 (`kms`, `va`, `ca`, ...). With a release named `prod` the StatefulSets become `prod-lamassu-kms` and `prod-lamassu-va`. The `nameOverride` and `fullnameOverride` values change the prefix.",{"_3394":2660,"_29710":2605,"_20617":56682,"_5":14139,"_27008":56502,"_2880":56683},[],"**Non-root containers.** Every workload runs as the numeric user `65532:65532` with a `RuntimeDefault` seccomp profile and dropped capabilities. Pods do not mount the service-account token by default, and the chart creates a dedicated ServiceAccount.",{"_3394":2661,"_29710":2605,"_20617":56685,"_5":14139,"_27008":56502,"_2880":56686},[],"**Strict values validation.** `values.schema.json` rejects unknown keys, so leftover 3.8.0 blocks fail `helm lint` and `helm upgrade` instead of being silently ignored.",{"_3394":2662,"_29710":2605,"_20617":56688,"_5":14139,"_27008":56502,"_2880":56689},[],"**No injected scheduling rules.** The chart no longer adds pod anti-affinity or topology spread constraints on its own.",{"_3394":2663,"_29710":2605,"_20617":56691,"_5":14139,"_27008":56506,"_2880":56692},[],"Several migrations run without intervention when you upgrade a Helm release:",{"_3394":2664,"_29710":2605,"_20617":56694,"_5":14139,"_27008":56506,"_2880":56695},[],"Before any service starts, the chart's pre-install/pre-upgrade job prepares PostgreSQL. It creates the `pki`, `authz` and `wfx` databases when they do not exist, creates one schema per service inside `pki`, and imports each 3.8.0 per-service database into its schema. Each import runs as a single transaction, so a failed import leaves no partial schema and a retried job imports again. The job then runs the database migrations for every schema, migrates `authz`, preloads its policies and seeds the `services.authz.bootstrap` principals. It is idempotent and requires a PostgreSQL role allowed to create databases and schemas, as described in Install with Helm.",{"_3394":2665,"_29710":2605,"_20617":56697,"_5":14139,"_27008":56506,"_2880":56698},[],"Stored DMS configuration is rewritten to the 4.0.0 layout, and historical device events are transformed into the new store.",{"_3394":2666,"_29710":2605,"_20617":56700,"_5":14139,"_27008":56506,"_2880":56701},[],"The KMS migration removes the stale `lamassu.io/kms/binded-resources` key metadata, and the VA migration resolves each role's CRL signer (see VA CRL signer).",{"_3394":2667,"_29710":2605,"_20617":56703,"_5":14139,"_27008":56506,"_2880":56704},[],"When `migrations.caToKms.enabled` is set, a pre-upgrade hook registers legacy CA keys in the KMS.",{"_3394":2668,"_29710":2605,"_20617":56706,"_5":14139,"_27008":56506,"_2880":56707},[],"Two things never migrate on their own: the KMS and VA data on local volumes, which stays on volumes the upgraded pods no longer use, and the values file, which you update by hand. Deployments that do not use the Helm chart also have to move their database data themselves; see Deployments without Helm.",{"_3394":2669,"_29710":2605,"_20617":56709,"_5":14139,"_27008":56510,"_2880":56710},[],"Change",{"_3394":2670,"_29710":2605,"_20617":56712,"_5":14139,"_27008":56510,"_2880":56713},[],"Who is affected",{"_3394":2671,"_29710":2605,"_20617":56715,"_5":14139,"_27008":56510,"_2880":56716},[],"Severity",{"_3394":2672,"_29710":2605,"_20617":56718,"_5":14139,"_27008":56510,"_2880":55217},[],{"_3394":2673,"_29710":2605,"_20617":56720,"_5":14139,"_27008":56510,"_2880":56519},[],{"_3394":2674,"_29710":2605,"_20617":56722,"_5":14139,"_27008":56510,"_2880":56723},[],"Helm releases with a filesystem KMS engine or local VA CRL storage",{"_3394":2675,"_29710":2605,"_20617":56725,"_5":14139,"_27008":56510,"_2880":56726},[],"High: KMS and VA start on empty volumes",{"_3394":2676,"_29710":2605,"_20617":56728,"_5":14139,"_27008":56510,"_2880":56729},[],"Copy the data into the new volumes",{"_3394":2677,"_29710":2605,"_20617":56731,"_5":14139,"_27008":56510,"_2880":56523},[],{"_3394":2678,"_29710":2605,"_20617":56733,"_5":14139,"_27008":56510,"_2880":56734},[],"Every Helm release",{"_3394":2679,"_29710":2605,"_20617":56736,"_5":14139,"_27008":56510,"_2880":56737},[],"High: `helm upgrade` fails",{"_3394":2680,"_29710":2605,"_20617":56739,"_5":14139,"_27008":56510,"_2880":56740},[],"Remove or rename legacy keys",{"_3394":2681,"_29710":2605,"_20617":56742,"_5":14139,"_27008":56510,"_2880":56527},[],{"_3394":2682,"_29710":2605,"_20617":56744,"_5":14139,"_27008":56510,"_2880":56745},[],"Every deployment",{"_3394":2683,"_29710":2605,"_20617":56747,"_5":14139,"_27008":56510,"_2880":56748},[],"High: without a bootstrap principal there is no administrator",{"_3394":2684,"_29710":2605,"_20617":56750,"_5":14139,"_27008":56510,"_2880":56751},[],"Configure `services.authz`",{"_3394":2685,"_29710":2605,"_20617":56753,"_5":14139,"_27008":56510,"_2880":56531},[],{"_3394":2686,"_29710":2605,"_20617":56755,"_5":14139,"_27008":56510,"_2880":56734},[],{"_3394":2687,"_29710":2605,"_20617":56757,"_5":14139,"_27008":56510,"_2880":56758},[],"High: `helm upgrade` fails on the old keys",{"_3394":2688,"_29710":2605,"_20617":56760,"_5":14139,"_27008":56510,"_2880":56761},[],"Move JWKS and roles into `services.authz`",{"_3394":2689,"_29710":2605,"_20617":56763,"_5":14139,"_27008":56510,"_2880":56551},[],{"_3394":2690,"_29710":2605,"_20617":56765,"_5":14139,"_27008":56510,"_2880":56766},[],"3.8.0 deployments with per-service databases",{"_3394":2691,"_29710":2605,"_20617":56768,"_5":14139,"_27008":56510,"_2880":56769},[],"High: services find no data, or a migration aborts",{"_3394":2692,"_29710":2605,"_20617":56771,"_5":14139,"_27008":56510,"_2880":56772},[],"Clean duplicate CA IDs and empty `engine_id` values first; move data manually outside Helm",{"_3394":2693,"_29710":2605,"_20617":56774,"_5":14139,"_27008":56510,"_2880":56555},[],{"_3394":2694,"_29710":2605,"_20617":56776,"_5":14139,"_27008":56510,"_2880":56777},[],"Deployments on SQLite, `couch_db` or `dynamo_db`",{"_3394":2695,"_29710":2605,"_20617":56779,"_5":14139,"_27008":56510,"_2880":56780},[],"High: the backend no longer starts with them",{"_3394":2696,"_29710":2605,"_20617":56782,"_5":14139,"_27008":56510,"_2880":56783},[],"Move to PostgreSQL before upgrading",{"_3394":2697,"_29710":2605,"_20617":56785,"_5":14139,"_27008":56510,"_2880":56786},[],"Webhooks with file references",{"_3394":2698,"_29710":2605,"_20617":56788,"_5":14139,"_27008":56510,"_2880":56789},[],"DMSs whose webhook mTLS certificate or key were file paths",{"_3394":2699,"_29710":2605,"_20617":56791,"_5":14139,"_27008":56510,"_2880":56792},[],"High: enrollments calling the webhook fail",{"_3394":2700,"_29710":2605,"_20617":56794,"_5":14139,"_27008":56510,"_2880":56795},[],"Re-enter certificate and key as PEM, or remove the file fields",{"_3394":2701,"_29710":2605,"_20617":56797,"_5":14139,"_27008":56510,"_2880":56535},[],{"_3394":2702,"_29710":2605,"_20617":56799,"_5":14139,"_27008":56510,"_2880":56800},[],"Releases with per-service identity overrides or mounted key material",{"_3394":2703,"_29710":2605,"_20617":56802,"_5":14139,"_27008":56510,"_2880":56803},[],"Medium: services cannot read their files",{"_3394":2704,"_29710":2605,"_20617":56805,"_5":14139,"_27008":56510,"_2880":56806},[],"Remove the overrides and fix volume ownership",{"_3394":2705,"_29710":2605,"_20617":56808,"_5":14139,"_27008":56510,"_2880":56539},[],{"_3394":2706,"_29710":2605,"_20617":56810,"_5":14139,"_27008":56510,"_2880":56811},[],"Releases that set `amqp.tls`",{"_3394":2707,"_29710":2605,"_20617":56813,"_5":14139,"_27008":56510,"_2880":56814},[],"Medium: clients connect to the wrong port",{"_3394":2708,"_29710":2605,"_20617":56816,"_5":14139,"_27008":56510,"_2880":56817},[],"Point `amqp.port` at the TLS listener, or disable TLS",{"_3394":2709,"_29710":2605,"_20617":56819,"_5":14139,"_27008":56510,"_2880":56559},[],{"_3394":2710,"_29710":2605,"_20617":56821,"_5":14139,"_27008":56510,"_2880":56822},[],"Installations whose CA keys predate the KMS",{"_3394":2711,"_29710":2605,"_20617":56824,"_5":14139,"_27008":56510,"_2880":56825},[],"Medium: CA keys stay unmanaged",{"_3394":2712,"_29710":2605,"_20617":56827,"_5":14139,"_27008":56510,"_2880":56828},[],"Run the CA-to-KMS migration",{"_3394":2713,"_29710":2605,"_20617":56830,"_5":14139,"_27008":56510,"_2880":56831},[],"Receiver certificate verification",{"_3394":2714,"_29710":2605,"_20617":56833,"_5":14139,"_27008":56510,"_2880":56834},[],"DMSs whose webhook had `validate_server_cert: false`",{"_3394":2715,"_29710":2605,"_20617":56836,"_5":14139,"_27008":56510,"_2880":56837},[],"Medium: credentials go to an unverified receiver",{"_3394":2716,"_29710":2605,"_20617":56839,"_5":14139,"_27008":56510,"_2880":56840},[],"Set `insecure_skip_verify` to `false`",{"_3394":2717,"_29710":2605,"_20617":56842,"_5":14139,"_27008":56510,"_2880":56575},[],{"_3394":2718,"_29710":2605,"_20617":56844,"_5":14139,"_27008":56510,"_2880":56845},[],"Scripts and consoles that edit DMSs through the API",{"_3394":2719,"_29710":2605,"_20617":56847,"_5":14139,"_27008":56510,"_2880":56848},[],"Medium: an old-layout edit silently empties `validation_cas`",{"_3394":2720,"_29710":2605,"_20617":56850,"_5":14139,"_27008":56510,"_2880":56851},[],"Read the DMS before editing and use the new field",{"_3394":2721,"_29710":2605,"_20617":56853,"_5":14139,"_27008":56510,"_2880":56595},[],{"_3394":2722,"_29710":2605,"_20617":56855,"_5":14139,"_27008":56510,"_2880":56856},[],"Clients that create or update VA roles through the API",{"_3394":2723,"_29710":2605,"_20617":56858,"_5":14139,"_27008":56510,"_2880":56859},[],"Medium: requests with the old field return an error",{"_3394":2724,"_29710":2605,"_20617":56861,"_5":14139,"_27008":56510,"_2880":56862},[],"Replace `crl_options.subject_key_id_signer` with the required `crl_options.signer_certificate_serial_number`",{"_3394":2725,"_29710":2605,"_20617":56864,"_5":14139,"_27008":56510,"_2880":56591},[],{"_3394":2726,"_29710":2605,"_20617":56866,"_5":14139,"_27008":56510,"_2880":56867},[],"Consumers that read the device `events` field",{"_3394":2727,"_29710":2605,"_20617":56869,"_5":14139,"_27008":56510,"_2880":56870},[],"Medium: the field disappears",{"_3394":2728,"_29710":2605,"_20617":56872,"_5":14139,"_27008":56510,"_2880":56873},[],"Use the new event endpoints",{"_3394":2729,"_29710":2605,"_20617":56875,"_5":14139,"_27008":56510,"_2880":56599},[],{"_3394":2730,"_29710":2605,"_20617":56877,"_5":14139,"_27008":56510,"_2880":56878},[],"Deployments with VA roles whose signer cannot be resolved uniquely",{"_3394":2731,"_29710":2605,"_20617":56880,"_5":14139,"_27008":56510,"_2880":56881},[],"Medium: the VA migration aborts",{"_3394":2732,"_29710":2605,"_20617":56883,"_5":14139,"_27008":56510,"_2880":56884},[],"Fix the affected roles before upgrading",{"_3394":2733,"_29710":2605,"_20617":56886,"_5":14139,"_27008":56510,"_2880":56543},[],{"_3394":2734,"_29710":2605,"_20617":56888,"_5":14139,"_27008":56510,"_2880":56889},[],"Releases that override `toolbox`, `services.connectors`, ports, probes or scheduling",{"_3394":2735,"_29710":2605,"_20617":56891,"_5":14139,"_27008":56510,"_2880":56892},[],"Low to medium: validation errors or changed defaults",{"_3394":2736,"_29710":2605,"_20617":56894,"_5":14139,"_27008":56510,"_2880":56895},[],"Update the values file",{"_3394":2737,"_29710":2605,"_20617":56897,"_5":14139,"_27008":56510,"_2880":56583},[],{"_3394":2738,"_29710":2605,"_20617":56899,"_5":14139,"_27008":56510,"_2880":56900},[],"Clients that send the DMS ID in the update body",{"_3394":2739,"_29710":2605,"_20617":56902,"_5":14139,"_27008":56510,"_2880":56903},[],"Low: the ID in the URL wins",{"_3394":2740,"_29710":2605,"_20617":56905,"_5":14139,"_27008":56510,"_2880":56906},[],"Send the ID in the URL",{"_3394":2741,"_29710":2605,"_20617":56908,"_5":14139,"_27008":56510,"_2880":56587},[],{"_3394":2742,"_29710":2605,"_20617":56910,"_5":14139,"_27008":56510,"_2880":56911},[],"Consumers that match on certificate `type`",{"_3394":2743,"_29710":2605,"_20617":56913,"_5":14139,"_27008":56510,"_2880":56914},[],"Low: two values are renamed",{"_3394":2744,"_29710":2605,"_20617":56916,"_5":14139,"_27008":56510,"_2880":56917},[],"Adapt consumers",{"_3394":2745,"_29710":2605,"_20617":56919,"_5":14139,"_27008":56510,"_2880":56579},[],{"_3394":2746,"_29710":2605,"_20617":56921,"_5":14139,"_27008":56510,"_2880":56922},[],"Any DMS",{"_3394":2747,"_29710":2605,"_20617":56924,"_5":14139,"_27008":56510,"_2880":56925},[],"Low: informational",{"_3394":2748,"_29710":2605,"_20617":56927,"_5":14139,"_27008":56510,"_2880":56928},[],"Read both blocks before editing",{"_3394":2749,"_29710":2605,"_20617":56930,"_5":14139,"_27008":56518,"_2880":56931},[],"Kubernetes derives a StatefulSet's PVC name from its pod name (`<volumeClaimTemplate>-<pod-name>`). Renaming the `kms` and `va` StatefulSets means `helm upgrade` binds brand-new, empty PVCs instead of the existing ones. The KMS key material and VA CRLs are not deleted — the old PVCs are orphaned, not removed — but the upgraded pods fail with `no such file or directory` (KMS) or `code=NotFound` (VA) until you copy the data across. This affects KMS when `services.kms.cryptoEngines` uses a `filesystem` engine and VA when `services.va.fileStore.type` is `local`. Every other renamed resource is stateless and is recreated without data-loss risk.",{"_3394":2750,"_29710":2605,"_20617":56933,"_5":14139,"_27008":56518,"_2880":56934},[],"Step 4 of the migration guide copies the data.",{"_3394":2751,"_29710":2605,"_20617":56936,"_5":14139,"_27008":56522,"_2880":56937},[],"`values.schema.json` rejects unknown keys, so every block that 4.0.0 removed or renamed — `toolbox`, `auth.oidc.apiGateway`, `auth.authorization` and others — fails `helm lint` and `helm upgrade` outright. Step 2 lists every change.",{"_3394":2752,"_29710":2605,"_20617":56939,"_5":14139,"_27008":56526,"_2880":56940},[],"3.8.0 had no authorization service, so a 3.8.0 values file has nothing to migrate from: you must add the `services.authz` configuration yourself. It needs the JWKS endpoint of your identity provider, the database mappings the authorization engine uses, and a bootstrap principal that matches how your provider assigns the administrator role. Without a matching principal nobody can administer the PKI.",{"_3394":2753,"_29710":2605,"_20617":56942,"_5":14139,"_27008":56530,"_2880":56943},[],"`auth.oidc.apiGateway.jwks`, `auth.authorization.rolesClaim` and `auth.authorization.roles.admin` are removed with no compatibility aliases, and the schema rejects them. Their settings move into `services.authz`: the JWKS URL becomes `services.authz.jwkUrl`, and the role claim and administrator role become a claim rule of the bootstrap principal. `auth.oidc.frontend` is unchanged.",{"_3394":2754,"_29710":2605,"_20617":56945,"_5":14139,"_27008":56534,"_2880":56946},[],"Service images run on a distroless base as the numeric user `65532`; the `authz` image is Ubuntu with a non-root user that has the same UID. The per-service overrides `services.kms.securityContext.runAsGroup: 0` and `services.authz.securityContext.runAsUser`/`runAsGroup: 999` are removed; group access to the KMS volume and PKCS#11 socket is now handled by the pod-level `fsGroup: 65532`.",{"_3394":2755,"_29710":2605,"_20617":56948,"_5":14139,"_27008":56534,"_2880":56949},[],"3.8.0 did not pin a container identity, so existing files can carry any UID. Any volume that holds keys or CRLs must be owned by `65532:65532`, or at least readable (and, where needed, writable) by that identity.",{"_3394":2756,"_29710":2605,"_20617":56951,"_5":14139,"_27008":56538,"_2880":56952},[],"In 3.8.0 `amqp.tls` was not applied and event-bus clients always connected over plaintext. In 4.0.0 `amqp.tls: true` switches them to AMQPS. The default `amqp.port` stays `5672` and does not change when TLS is enabled, so a values file that already set `amqp.tls: true` must point `amqp.port` at the broker's TLS listener (`amqps`, commonly `5671`), or set `amqp.tls: false` to keep plaintext. Clients must also trust the broker's certificate.",{"_3394":2757,"_29710":2605,"_20617":56954,"_5":14139,"_27008":56542,"_2880":56955},[],"`toolbox` is renamed to `connectivityTest`, and the `helm test` hook uses the upstream `curlimages/curl` image pinned by digest.",{"_3394":2758,"_29710":2605,"_20617":56957,"_5":14139,"_27008":56542,"_2880":56958},[],"`services.connectors` is a map keyed by connector ID instead of a list.",{"_3394":2759,"_29710":2605,"_20617":56960,"_5":14139,"_27008":56542,"_2880":56961},[],"The `services.ui.port` default is `8085`, the unprivileged port of the rootless image.",{"_3394":2760,"_29710":2605,"_20617":56963,"_5":14139,"_27008":56542,"_2880":56964},[],"The shared `probes:` block is replaced by independent `livenessProbe`, `readinessProbe` and `startupProbe` blocks.",{"_3394":2761,"_29710":2605,"_20617":56966,"_5":14139,"_27008":56542,"_2880":56967},[],"With `tls.certManagerOptions.issuer` empty, the chart creates a release-scoped self-signed issuer, for example `lamassu-downstream-ca-selfsigned-issuer`. The legacy literal `downstream-ca-selfsigned-issuer` is still accepted and resolves to it.",{"_3394":2762,"_29710":2605,"_20617":56969,"_5":14139,"_27008":56542,"_2880":56970},[],"Anti-affinity and topology spread must be configured explicitly through `affinity` and `topologySpreadConstraints`.",{"_3394":2763,"_29710":2605,"_20617":56972,"_5":14139,"_27008":56550,"_2880":56973},[],"Every 3.8.0 per-service database must end up as a schema of `pki`, keeping its structure, indexes, constraints, data and migration history. The Helm chart does this automatically; deployments without Helm do it by hand (see Deployments without Helm).",{"_3394":2764,"_29710":2605,"_20617":56975,"_5":14139,"_27008":56550,"_2880":56976},[],"Two schema migrations abort on data that 3.8.0 allowed, so clean the data before upgrading:",{"_3394":2765,"_29710":2605,"_20617":56978,"_5":14139,"_27008":56550,"_2880":56979},[],"The CA migration adds a UNIQUE constraint on `ca_certificates.id` and aborts if duplicate CA IDs exist. Imports already reject duplicates with `409`, so new ones cannot normally appear.",{"_3394":2766,"_29710":2605,"_20617":56981,"_5":14139,"_27008":56550,"_2880":56982},[],"The KMS migration promotes the primary key to `(key_id, engine_id)` and aborts with `cannot promote (key_id, engine_id) to primary key: N row(s) have no engine_id; backfill them before migrating` when `kms_keys` rows lack `engine_id`. Backfill `engine_id` first.",{"_3394":2767,"_29710":2605,"_20617":56984,"_5":14139,"_27008":56550,"_2880":56985},[],"The same KMS migration deletes, with a `NOTICE`, aliases that equal an existing key ID, because identifiers now resolve as a key ID before an alias. Affected aliases are dropped, not redirected.",{"_3394":2768,"_29710":2605,"_20617":56987,"_5":14139,"_27008":56554,"_2880":56988},[],"The SQLite storage engine is removed, and the `couch_db` and `dynamo_db` engines are not registered in 4.0.0: their configuration constants remain, but they select no engine. Deployments on any of them must move to PostgreSQL and consolidate their data into the `pki` schemas before upgrading.",{"_3394":2769,"_29710":2605,"_20617":56990,"_5":14139,"_27008":56558,"_2880":56991},[],"CA certificates of type `MANAGED` or `IMPORTED_WITH_KEY` whose private keys predate the KMS service have the key stored only in the crypto engine, under the certificate's `subject_key_id`, with no KMS record. The `ca-to-kms-migration` tool registers them:",{"_3394":2770,"_29710":2605,"_20617":56993,"_5":14139,"_27008":56558,"_2880":56994},[],"The `key_id` is the certificate's `subject_key_id`; it matches the SHA-256 digest of the public key only when the SKI was computed that way.",{"_3394":2771,"_29710":2605,"_20617":56996,"_5":14139,"_27008":56558,"_2880":56997},[],"The tool is idempotent: keys already in the KMS are skipped, so it can be run several times.",{"_3394":2772,"_29710":2605,"_20617":56999,"_5":14139,"_27008":56558,"_2880":57000},[],"Certificates that cannot be read, or lack an engine or a subject key ID, are skipped with a warning. Review the logs and resolve the affected records.",{"_3394":2773,"_29710":2605,"_20617":57002,"_5":14139,"_27008":56558,"_2880":57003},[],"When CA certificates sharing a `subject_key_id` declare conflicting `engine_id`s, the tool fails that key and exits with code `1`, which fails a Helm pre-upgrade hook. Resolve the conflict manually before rerunning.",{"_3394":2774,"_29710":2605,"_20617":57005,"_5":14139,"_27008":56558,"_2880":57006},[],"Once the keys are registered, certificates reference them in the database and the KMS refuses to delete a key that a certificate still uses (`409` `key is in use`). Deleting a certificate record removes it from the CRL and OCSP, so read Before deleting a key before freeing a key.",{"_3394":2775,"_29710":2605,"_20617":57008,"_5":14139,"_27008":56558,"_2880":57009},[],"Optionally, installations with imported CAs from before 3.7 can start the KMS once with `crypto_engines.migrate_keys_format: true`: the KMS renames those SKI-named legacy keys to the SHA-256 digest of their public key (the old name is kept as an alias, and the certificate references follow automatically). Run it once and disable the option again; running it again is safe.",{"_3394":2776,"_29710":2605,"_20617":57011,"_5":14139,"_27008":56558,"_2880":57012},[],"With Helm, enable the hook for the upgrade in step 2; without Helm, run the tool by hand.",{"_3394":2777,"_29710":2605,"_20617":57014,"_5":14139,"_27008":56562,"_2880":57015},[],"Certificates now reference their KMS key, and VA roles reference their signer certificate, so a key or certificate in use cannot be deleted. The KMS migration drops the legacy `lamassu.io/kms/binded-resources` key metadata. Before 4.0.0, deleting a CA could remove its key while leaving key references in its retained certificate records. The CA migration registers those missing keys in the KMS with only their public key to satisfy the retained references. These entries cannot be deleted while the retained certificates reference them; they do not restore the private key. In 4.0.0, deleting a CA releases the references from its own current certificate and linked reissued certificates before attempting to delete the key; other certificates that still reference it prevent deletion.",{"_3394":2778,"_29710":2605,"_20617":57017,"_5":14139,"_27008":56570,"_2880":57018},[],"Stored webhook configs are rewritten to the current layout and their fields renamed:",{"_3394":2779,"_29710":2605,"_20617":57020,"_5":14139,"_27008":56570,"_2880":57021},[],"Field in 3.8.0",{"_3394":2780,"_29710":2605,"_20617":57023,"_5":14139,"_27008":56570,"_2880":57024},[],"Field in 4.0.0",{"_3394":2781,"_29710":2605,"_20617":57026,"_5":14139,"_27008":56570,"_2880":57027},[],"`validate_server_cert`",{"_3394":2782,"_29710":2605,"_20617":57029,"_5":14139,"_27008":56570,"_2880":57030},[],"`insecure_skip_verify` (value negated)",{"_3394":2783,"_29710":2605,"_20617":57032,"_5":14139,"_27008":56570,"_2880":57033},[],"`oidc`",{"_3394":2784,"_29710":2605,"_20617":57035,"_5":14139,"_27008":56570,"_2880":57036},[],"`jwt_options`",{"_3394":2785,"_29710":2605,"_20617":57038,"_5":14139,"_27008":56570,"_2880":57039},[],"`apikey`",{"_3394":2786,"_29710":2605,"_20617":57041,"_5":14139,"_27008":56570,"_2880":57042},[],"`apikey_options`",{"_3394":2787,"_29710":2605,"_20617":57044,"_5":14139,"_27008":56570,"_2880":57045},[],"`mtls`",{"_3394":2788,"_29710":2605,"_20617":57047,"_5":14139,"_27008":56570,"_2880":57048},[],"`mtls_options`",{"_3394":2789,"_29710":2605,"_20617":57050,"_5":14139,"_27008":56570,"_2880":57051},[],"When the legacy mTLS certificate and key are both PEM, they move into `mtls_options.cert_content` and `mtls_options.key_content` and need no action. Two cases do need it.",{"_3394":2790,"_29710":2605,"_20617":57053,"_5":14139,"_27008":56570,"_2880":57054},[],"**Webhooks with file references.** A mixed config, with a PEM certificate and a file-path key, is migrated to `mtls_options.cert_file` and `mtls_options.key_file`. Webhook delivery rejects those fields on every call, whatever the configured authentication mode, so every enroll and re-enroll that calls that webhook fails until the config is fixed. If the webhook uses mTLS, re-enter the certificate and key as Base64-encoded or plain PEM; if it does not, remove the leftover file fields. Metadata-only updates keep working in the meantime (`PUT` or `PATCH` on `/v1/dms/:id/metadata`). In a variant of the same problem, a stored config with file paths inside `mtls_options.cert_content` or `mtls_options.key_content` makes every full settings update (`POST /v1/dms` or `PUT /v1/dms/:id`) fail validation; settings are replaced wholesale, so resend the config with the certificate and key as PEM.",{"_3394":2791,"_29710":2605,"_20617":57056,"_5":14139,"_27008":56570,"_2880":57057},[],"**Receiver certificate verification.** A config with `validate_server_cert: false` becomes `insecure_skip_verify: true`, so receiver verification stays skipped until that field is set to `false`. Correct it on every migrated config: the webhook authorization channel carries the API key or bearer token, and skipping verification exposes those credentials to a network-positioned attacker. Keep `insecure_skip_verify: true` only when the receiver certificate is deliberately unverifiable.",{"_3394":2792,"_29710":2605,"_20617":57059,"_5":14139,"_27008":56574,"_2880":57060},[],"The flat field `reenrollment_settings.additional_validation_cas` moves into the nested field `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`:",{"_3394":2793,"_29710":2605,"_20617":57062,"_5":14139,"_27008":56574,"_2880":57063},[],"The effective trust set does not change, because the nested value was never consulted when validating re-enrollments. If the flat list was missing or null, it becomes an empty list.",{"_3394":2794,"_29710":2605,"_20617":57065,"_5":14139,"_27008":56574,"_2880":57066},[],"What changes is how API requests are handled. Bodies that still carry `additional_validation_cas` are accepted, but the value is silently dropped because unknown JSON fields are ignored, and GET responses no longer include it. An update body built from the old layout therefore empties `validation_cas` without any error. Always read the DMS before sending an edit and reuse the layout the API returns.",{"_3394":2795,"_29710":2605,"_20617":57068,"_5":14139,"_27008":56578,"_2880":57069},[],"Re-enrollment authentication settings are now stored independently from initial authentication. Nothing needs migrating, but read both blocks before editing a DMS so that you do not modify one while believing you are editing the other. The console exposes independent editors for both blocks; the DMS guide describes their fields, and you can also edit them through the DMS API.",{"_3394":2796,"_29710":2605,"_20617":57071,"_5":14139,"_27008":56582,"_2880":57072},[],"`PUT /v1/dms/:id` takes the DMS ID from the URL and validates the request body. An ID in the body is ignored, so update clients that relied on it.",{"_3394":2797,"_29710":2605,"_20617":57074,"_5":14139,"_27008":56586,"_2880":57075},[],"Stored certificate type values are renamed: `IMPORTED` becomes `IMPORTED_WITH_KEY` and `EXTERNAL` becomes `IMPORTED_WITHOUT_KEY`. `MANAGED` is unchanged. Adapt consumers that read or match on those values.",{"_3394":2798,"_29710":2605,"_20617":57077,"_5":14139,"_27008":56590,"_2880":57078},[],"The `events` field no longer appears in the device representation. Point consumers at the new endpoints:",{"_3394":2799,"_29710":2605,"_20617":57080,"_5":14139,"_27008":56590,"_2880":57081},[],"`GET /v1/devices/:id/events` returns a device's events.",{"_3394":2800,"_29710":2605,"_20617":57083,"_5":14139,"_27008":56590,"_2880":57084},[],"`POST /v1/devices/:id/events` creates an event.",{"_3394":2801,"_29710":2605,"_20617":57086,"_5":14139,"_27008":56590,"_2880":57087},[],"When the request `Accept` header includes `text/event-stream`, the events endpoint streams over SSE with a keepalive every 15 seconds, and returns `501` when SSE is disabled in the deployment. Each Device Manager instance binds a durable AMQP queue named after its service ID, `device-manager-sse-<uuid>`. Queues from crashed or replaced instances linger until removed, so configure an expiration or cleanup policy on the broker.",{"_3394":2802,"_29710":2605,"_20617":57089,"_5":14139,"_27008":56594,"_2880":57090},[],"`crl_options.subject_key_id_signer` is replaced by the required `crl_options.signer_certificate_serial_number`, the serial number of the existing certificate that signs the CRL. A new role's initial value is the CA's current certificate serial number. Requests that still carry `subject_key_id_signer` return an error. Custom authorization policies that filter on the old field must be updated: the filter `crl_subject_key_id_signer` is renamed to `crl_signer_certificate_serial_number` and takes serial-number values.",{"_3394":2803,"_29710":2605,"_20617":57092,"_5":14139,"_27008":56598,"_2880":57093},[],"The VA migration resolves each role's signer from its stored SKI. It first looks for CA certificates with that SKI; if several match, it selects the oldest CA and logs a warning. If no CA certificate matches, it looks among all certificates with that SKI. The migration aborts with `cannot resolve signer certificate for VA role <ca-ski>, SKI <ski>` if that fallback finds zero or multiple candidates. Fix affected roles before upgrading.",{"_3394":2804,"_29710":2605,"_20617":57095,"_5":14139,"_27008":56602,"_2880":57096},[],"The upgrade runs in a fixed order: prepare the data and values, run `helm upgrade`, then copy the KMS and VA data into the new volumes. The copy must run after the upgrade, because the destination StatefulSets and PVCs do not exist before it. If you are not upgrading an existing release, go straight to Install with Helm.",{"_3394":2805,"_29710":2605,"_20617":57098,"_5":14139,"_27008":56606,"_2880":57099},[],"Take a verifiable backup of PostgreSQL and schedule downtime. The upgrade moves every service's data into `pki`.",{"_3394":2806,"_29710":2605,"_20617":57101,"_5":14139,"_27008":56606,"_2880":57102},[],"If the deployment runs on SQLite, `couch_db` or `dynamo_db`, move it to PostgreSQL first.",{"_3394":2807,"_29710":2605,"_20617":57104,"_5":14139,"_27008":56606,"_2880":57105},[],"Resolve duplicate CA IDs and backfill `engine_id` in `kms_keys`, as described in PostgreSQL consolidation.",{"_3394":2808,"_29710":2605,"_20617":57107,"_5":14139,"_27008":56606,"_2880":57108},[],"Record the names of your local-storage PVCs:",{"_3394":2809,"_29710":2605,"_20617":57110,"_5":14139,"_27008":56606,"_2880":57111},[],"`helm upgrade` does not touch or delete the old PVCs, but nothing references them after the upgrade. You need their names to copy the data and to clean up later.",{"_3394":2810,"_29710":2605,"_20617":57113,"_5":14139,"_27008":56610,"_2880":57114},[],"**Add `services.authz`.** Configure the JWKS endpoint, the database mappings and the bootstrap principal:",{"_3394":2811,"_29710":2605,"_20617":57116,"_5":14139,"_27008":56610,"_2880":57117},[],"`jwkUrl` is fetched from the `authz` pod, not from the gateway, so a Service in the release namespace can be referenced by its short name. The default points at a Keycloak Service named `auth-keycloak`; set it explicitly if your identity provider lives anywhere else.",{"_3394":2812,"_29710":2605,"_20617":57119,"_5":14139,"_27008":56610,"_2880":57120},[],"`authz` is the authorization service's own storage for principals, grants and policies. `pki` is the database the authorization engine queries when it evaluates policies against entities. Only the `database` field of each entry is read; the connection always uses the global `postgres.hostname`, `postgres.port`, `postgres.username` and `postgres.password` values.",{"_3394":2813,"_29710":2605,"_20617":57122,"_5":14139,"_27008":56610,"_2880":57123},[],"If you kept the 3.8.0 role defaults (`realm_access.roles` and `pki-admin`), the default `services.authz.bootstrap` already matches them.",{"_3394":2814,"_29710":2605,"_20617":57125,"_5":14139,"_27008":56610,"_2880":57126},[],"**Delete the gateway token validation blocks.** Remove `auth.oidc.apiGateway` and `auth.authorization` once their settings are in `services.authz`:",{"_3394":2815,"_29710":2605,"_20617":57128,"_5":14139,"_27008":56610,"_2880":57129},[],"**Rename `toolbox` to `connectivityTest`:**",{"_3394":2816,"_29710":2605,"_20617":57131,"_5":14139,"_27008":56610,"_2880":57132},[],"**Remove the per-service identity overrides** `services.kms.securityContext.runAsGroup` and `services.authz.securityContext.runAsUser`/`runAsGroup`.",{"_3394":2817,"_29710":2605,"_20617":57134,"_5":14139,"_27008":56610,"_2880":57135},[],"**Convert `services.connectors` to a map** keyed by connector ID, each entry with its `type` and `image`:",{"_3394":2818,"_29710":2605,"_20617":57137,"_5":14139,"_27008":56610,"_2880":57138},[],"**Check AMQP.** If you set `amqp.tls: true`, also set `amqp.port` to the broker's TLS listener (commonly `5671`), or set `amqp.tls: false` to stay on plaintext.",{"_3394":2819,"_29710":2605,"_20617":57140,"_5":14139,"_27008":56610,"_2880":57141},[],"**Enable the CA-to-KMS migration** if your CA keys predate the KMS:",{"_3394":2820,"_29710":2605,"_20617":57143,"_5":14139,"_27008":56610,"_2880":57144},[],"**Review the remaining values:** overrides that pinned `services.ui.port` to `80`, the old `probes:` block, the TLS issuer, and explicit `affinity` and `topologySpreadConstraints` where your cluster needs them. Renamed and reshaped values describes each one.",{"_3394":2821,"_29710":2605,"_20617":57146,"_5":14139,"_27008":56610,"_2880":57147},[],"Run `helm lint` with the new values before upgrading; the strict schema reports any key that is still unknown.",{"_3394":2822,"_29710":2605,"_20617":57149,"_5":14139,"_27008":56614,"_2880":57150},[],"Helm runs the pre-upgrade hooks — the CA-to-KMS migration when enabled, and the database job — before applying any workload, so services never start against an unprepared database. If validation rejects unknown values, fix the values file and re-run.",{"_3394":2823,"_29710":2605,"_20617":57152,"_5":14139,"_27008":56614,"_2880":57153},[],"If the deployment uses local KMS or VA storage, those pods fail until you complete step 4, so `--wait` cannot succeed: Helm waits for them to become ready, times out, exits with an error and marks the release `failed`. The hooks have already run by then, and every manifest, including the new StatefulSets and their PVCs, has been applied. Helm does not roll anything back without `--atomic`. Continue with step 4, then re-run the same `helm upgrade` command so it completes and Helm records the release as `deployed`. Both hooks are idempotent, so they are safe to run again.",{"_3394":2824,"_29710":2605,"_20617":57155,"_5":14139,"_27008":56618,"_2880":57156},[],"Skip this step when `services.kms.cryptoEngines` never used a `filesystem` engine and `services.va.fileStore.type` was never `local`.",{"_3394":2825,"_29710":2605,"_20617":57158,"_5":14139,"_27008":56618,"_2880":57159},[],"**Find the new StatefulSets and PVCs.** Their names depend on the release name and any `nameOverride` or `fullnameOverride`; the PVC name is `<volumeClaimTemplate>-<StatefulSet name>-0`:",{"_3394":2826,"_29710":2605,"_20617":57161,"_5":14139,"_27008":56618,"_2880":57162},[],"With release `lamassu` and the default chart name, the new PVCs are `golang-engine-storage-lamassu-kms-0` and `local-crl-file-storage-lamassu-va-0`; with release `prod` they are `golang-engine-storage-prod-lamassu-kms-0` and `local-crl-file-storage-prod-lamassu-va-0`. Confirm both old and new PVCs exist before continuing. If `claims_ok` prints `ABORT`, the block stops before listing the claims: either a StatefulSet lookup failed, or a new claim resolves to the 3.8.0 claim. In the second case the copy would verify against itself and the final cleanup would delete the live volume. The chart always appends `-kms` and `-va` to the release-scoped name, so a collision means the claims are not what this guide expects; investigate before going on. Item 3 runs the same check and refuses to create the helper pod, so nothing touches the volumes. The check returns instead of calling `exit`, which would close your shell and lose the variables set so far. If you only migrate one of the two services, drop the other one's claims from the commands that follow.",{"_3394":2827,"_29710":2605,"_20617":57164,"_5":14139,"_27008":56618,"_2880":57165},[],"**Record the replica counts, scale the new StatefulSets down and wait for every pod that uses the claims to exit**, so nothing writes to either volume while you copy. Helm removes the 3.8.0 `kms` and `va` StatefulSets during the upgrade, but their pods `kms-0` and `va-0` can still be terminating and holding the old claims. While they run, the helper pod either cannot attach the claims or copies a volume that is still being written. The `wait` returns at once for pods that are already gone:",{"_3394":2828,"_29710":2605,"_20617":57167,"_5":14139,"_27008":56618,"_2880":57168},[],"**Run a short-lived helper pod** that mounts all four claims. It runs as root so it can change file ownership, so pin its image by digest and do not mount the service-account token:",{"_3394":2829,"_29710":2605,"_20617":57170,"_5":14139,"_27008":56618,"_2880":57171},[],"**Inspect before writing** so you do not clobber data the new pods may already have written:",{"_3394":2830,"_29710":2605,"_20617":57173,"_5":14139,"_27008":56618,"_2880":57174},[],"An empty result is the common case: a StatefulSet's own pod rarely gets far enough to write anything when its dependent data is missing. If the output is not empty, record the files and confirm with the service owner that they are disposable before you run the copy; do not overlay the 3.8.0 data onto an unknown store.",{"_3394":2831,"_29710":2605,"_20617":57176,"_5":14139,"_27008":56618,"_2880":57177},[],"**Copy the data, align ownership and verify the copy.** The second command must print `copy verified`; any `diff` output means the copy is incomplete, so do not continue:",{"_3394":2832,"_29710":2605,"_20617":57179,"_5":14139,"_27008":56618,"_2880":57180},[],"The `chown` is required even if the old files already look non-root-owned, because 4.0.0 requires exactly `65532:65532` and does not fall back to whatever the image declares.",{"_3394":2833,"_29710":2605,"_20617":57182,"_5":14139,"_27008":56618,"_2880":57183},[],"**Remove the helper and restore the recorded replica counts:**",{"_3394":2834,"_29710":2605,"_20617":57185,"_5":14139,"_27008":56618,"_2880":57186},[],"**Re-run the step 3 `helm upgrade` command.** The KMS and VA pods now start against the copied data, so `--wait` succeeds and the release moves from `failed` to `deployed`.",{"_3394":2835,"_29710":2605,"_20617":57188,"_5":14139,"_27008":56622,"_2880":57189},[],"After the upgrade that performed the CA-to-KMS migration succeeds, remove `migrations.caToKms.enabled` from your values (it defaults to `false`). The hook reads the legacy 3.8.0 `kms-config` ConfigMap while it still exists and falls back to the release-scoped `<release>-lamassu-kms-config` once it is gone.",{"_3394":2836,"_29710":2605,"_20617":57191,"_5":14139,"_27008":56622,"_2880":57192},[],"Then go through the validation checklist. Keep the old PVCs until it passes.",{"_3394":2837,"_29710":2605,"_20617":57194,"_5":14139,"_27008":56626,"_2880":57195},[],"Without the chart's database job, no tool moves data between databases: the migration tooling only applies migrations to a schema that already exists. Move each per-service database into its `pki` schema yourself, preserving structure, indexes, constraints, data and migration history, with writes stopped and a verified backup in hand.",{"_3394":2838,"_29710":2605,"_20617":57197,"_5":14139,"_27008":56626,"_2880":57198},[],"Run the migrations in the required order, one schema at a time: `kms` first, then the `ca-to-kms-migration` tool (needed only for legacy deployments whose CA keys are named by SKI), then `ca`, then `va`. The `devicemanager`, `dmsmanager` and `alerts` schemas are independent and can be migrated in any order. With Helm, the chart's pre-install job applies the schemas in the correct order automatically.",{"_3394":2839,"_29710":2605,"_20617":57200,"_5":14139,"_27008":56626,"_2880":57201},[],"If `kms` has not been migrated, the `ca` migration fails with `kms schema not found: migrate the kms schema before the ca schema`. The `va` migration likewise requires `ca` to be migrated first.",{"_3394":2840,"_29710":2605,"_20617":57203,"_5":14139,"_27008":56626,"_2880":57204},[],"The schemas reference each other, so the PostgreSQL role running the migrations needs cross-schema privileges: the `ca` schema needs `USAGE` on `kms` plus `SELECT`, `REFERENCES` and `INSERT` on `kms.kms_keys`, and the `va` schema needs `USAGE` on `ca` plus `SELECT` and `REFERENCES` on `ca.certificates` and `SELECT` on `ca.ca_certificates`. Without them the migration aborts; grant the missing privileges and rerun the failed schema. After migrating `ca`, if the CA service runs as a different user than the migration user, grant it `SELECT` on `ca.certificates_view` (`GRANT SELECT ON ca.certificates_view TO service_user`). Without this grant, certificate and CA reads fail with `permission denied for table certificates_view`.",{"_3394":2841,"_29710":2605,"_20617":57206,"_5":14139,"_27008":56626,"_2880":57207},[],"To apply migrations by hand, `goose-lamassu` must run against the `pki` database with `search_path=<schema>` in the connection string. The binary validates only `search_path`, not the database name, so check `dbname=pki` before running it, and repeat for `kms`, `ca`, `va`, `devicemanager`, `dmsmanager` and `alerts`:",{"_3394":2842,"_29710":2605,"_20617":57209,"_5":14139,"_27008":56626,"_2880":57210},[],"Run `ca-to-kms-migration` first with `--dry-run`, which reports without writing to KMS storage, and then for real:",{"_3394":2843,"_29710":2605,"_20617":57212,"_5":14139,"_27008":56626,"_2880":57213},[],"Point the tool's `storage` configuration at the `pki` database, where the CA and KMS data now live in the `ca` and `kms` schemas. The tool's options are described in `backend/cmd/ca-to-kms-migration/README.md` in the `lamassuiot` repository.",{"_3394":2844,"_29710":2605,"_20617":57215,"_5":14139,"_27008":56626,"_2880":57216},[],"Both tools' READMEs document the 4.0.0 `pki` layout and match this page: `goose-lamassu` uses `dbname=pki` examples and does not validate the database name, and the `ca-to-kms-migration` README describes the single `pki` database and the migration order.",{"_3394":2845,"_29710":2605,"_20617":57218,"_5":14139,"_27008":56630,"_2880":57219},[],"**KMS or VA pods crash with `no such file or directory` or `code=NotFound` right after the upgrade.** The pods are bound to the new, empty PVCs and the data migration has not run yet, or was copied into the wrong PVC. Follow step 4 and check that all four claims exist.",{"_3394":2846,"_29710":2605,"_20617":57221,"_5":14139,"_27008":56630,"_2880":57222},[],"**`helm upgrade --wait` times out and `helm status` reports the release as `failed`.** With local KMS or VA storage this is expected on the first run: the new pods cannot become ready before their data is copied. The hooks ran and the manifests and PVCs were applied, so complete step 4 and re-run the same `helm upgrade` command. If other pods are also not ready, check their logs, because something else is wrong.",{"_3394":2847,"_29710":2605,"_20617":57224,"_5":14139,"_27008":56630,"_2880":57225},[],"**The helper pod stays `Pending` or `ContainerCreating` and `kubectl wait` times out.** Another pod still holds one of the claims; on block storage `kubectl describe pod pvc-migrate-helper` shows a `Multi-Attach error`. Check with `kubectl get pods -n $NAMESPACE` that `kms-0`, `va-0` and the new KMS and VA pods are gone, then re-run the wait.",{"_3394":2848,"_29710":2605,"_20617":57227,"_5":14139,"_27008":56630,"_2880":57228},[],"**`helm upgrade` fails with an unknown-key validation error.** Remove or rename the legacy values — typically `toolbox`, `auth.oidc.apiGateway` or `auth.authorization` — because the strict schema rejects keys it does not know.",{"_3394":2849,"_29710":2605,"_20617":57230,"_5":14139,"_27008":56630,"_2880":57231},[],"**The upgrade fails at the database job.** The PostgreSQL role cannot create databases or schemas, or a schema migration aborted on duplicate CA IDs or missing `engine_id` values. Check the job logs, fix the privileges or the data, and re-run the upgrade.",{"_3394":2850,"_29710":2605,"_20617":57233,"_5":14139,"_27008":56630,"_2880":57234},[],"**The upgrade fails at the CA-to-KMS hook.** CA certificates that share a `subject_key_id` declare conflicting `engine_id`s. Resolve the conflict and re-run.",{"_3394":2851,"_29710":2605,"_20617":57236,"_5":14139,"_27008":56630,"_2880":57237},[],"**Nobody can log in after the upgrade.** Check that `services.authz.jwkUrl` is reachable from the `authz` pod, that `services.authz.bootstrap` matches a role your OIDC provider actually assigns, and that the database job completed.",{"_3394":2852,"_29710":2605,"_20617":57239,"_5":14139,"_27008":56630,"_2880":57240},[],"**A migration aborts with `kms schema not found`.** The schemas must be migrated in order: run the `kms` schema migration before the `ca` schema migration.",{"_3394":2853,"_29710":2605,"_20617":57242,"_5":14139,"_27008":56630,"_2880":57243},[],"**A migration aborts with `ca schema not found`.** Run the `ca` schema migration before the `va` schema migration.",{"_3394":2854,"_29710":2605,"_20617":57245,"_5":14139,"_27008":56630,"_2880":57246},[],"**The VA migration fails with `cannot resolve signer certificate for VA role ... N candidates`.** No CA certificate matched the stored signer SKI, and the fallback search found zero or multiple certificates. Review the SKI and candidates reported in the error; correct the pre-migration data with a verified backup and rerun the migration. The new `signer_certificate_serial_number` field is created during that migration, so it cannot be set through the VA API while the migration is failing.",{"_3394":2855,"_29710":2605,"_20617":57248,"_5":14139,"_27008":56630,"_2880":57249},[],"**A migration or service fails with `permission denied for table ...`.** The PostgreSQL role is missing the cross-schema privileges listed in Deployments without Helm; this includes `certificates_view` when the post-migration `GRANT SELECT` was skipped. Grant the missing privileges and re-run.",{"_3394":2856,"_29710":2605,"_20617":57251,"_5":14139,"_27008":56633,"_2880":57252},[],"After the upgrade, check in this order:",{"_3394":2857,"_29710":2605,"_20617":57254,"_5":14139,"_27008":56633,"_2880":57255},[],"**Databases.** Each service reads the `pki` database with its own schema, `authz` and `wfx` data are reachable, and the migration status is registered per schema, including the CA unique-ID and KMS composite-key migrations and the foreign-key migrations that run per schema in the required order.",{"_3394":2858,"_29710":2605,"_20617":57257,"_5":14139,"_27008":56633,"_2880":57258},[],"**KMS and VA start cleanly.** Their logs show no `no such file or directory` or `code=NotFound` errors.",{"_3394":2859,"_29710":2605,"_20617":57260,"_5":14139,"_27008":56633,"_2880":57261},[],"**Existing KMS keys work.** Issue a certificate from a CA that existed before the upgrade. None of the other checks reads a KMS key, so this is the only one that proves the key material was copied.",{"_3394":2860,"_29710":2605,"_20617":57263,"_5":14139,"_27008":56633,"_2880":57264},[],"**Existing CRLs are served.** `GET /crl/<ca-ski>` on VA returns a previously issued CRL, and new CRLs are issued.",{"_3394":2861,"_29710":2605,"_20617":57266,"_5":14139,"_27008":56633,"_2880":57267},[],"**Legacy CA keys.** If the CA-to-KMS migration ran, review its report and warnings and confirm the expected keys appear in the KMS. Migrated CA certificates now report `key_id` and `has_private_key`, which you can use to confirm the registration.",{"_3394":2862,"_29710":2605,"_20617":57269,"_5":14139,"_27008":56633,"_2880":57270},[],"**Connectivity.** `helm test \"$RELEASE\" -n $NAMESPACE --logs` passes; the hook checks the CA, DMS Manager, Device Manager and VA health endpoints and the UI response.",{"_3394":2863,"_29710":2605,"_20617":57272,"_5":14139,"_27008":56633,"_2880":57273},[],"**Authorization.** Sign in as the bootstrap principal and confirm administration works, check that an identity without permissions receives `403`, and review client and integration permissions.",{"_3394":2864,"_29710":2605,"_20617":57275,"_5":14139,"_27008":56633,"_2880":57276},[],"**AMQP.** The backend connects to the broker with the expected TLS settings, and the cleanup policy for SSE queues is in place.",{"_3394":2865,"_29710":2605,"_20617":57278,"_5":14139,"_27008":56633,"_2880":57279},[],"**Device events.** `GET /v1/devices/:id/events` returns the historical events of a device that had them.",{"_3394":2866,"_29710":2605,"_20617":57281,"_5":14139,"_27008":56633,"_2880":57282},[],"**Webhooks without file fields.** For each DMS that uses a webhook for enrollment or re-enrollment, the `config` block carries `insecure_skip_verify` and the expected option block (`apikey_options`, `jwt_options` or `mtls_options`), with the certificate and key as PEM and no `cert_file` or `key_file`.",{"_3394":2867,"_29710":2605,"_20617":57284,"_5":14139,"_27008":56633,"_2880":57285},[],"**Receiver verification.** `insecure_skip_verify` is `false`, unless the receiver certificate is intentionally unverified.",{"_3394":2868,"_29710":2605,"_20617":57287,"_5":14139,"_27008":56633,"_2880":57288},[],"**Webhook delivery.** One enroll or re-enroll through each migrated webhook completes its authorization call.",{"_3394":2869,"_29710":2605,"_20617":57290,"_5":14139,"_27008":56633,"_2880":57291},[],"**Trust set.** `est_rfc7030_settings.client_certificate_settings.validation_cas` holds the expected CAs, in particular those of the old CA during rotation overlaps.",{"_3394":2870,"_29710":2605,"_20617":57293,"_5":14139,"_27008":56633,"_2880":57294},[],"**API clients.** Scripts and consoles no longer use the old DMS layout (flat `additional_validation_cas`, or the legacy `mtls`, `apikey` and `oidc` fields), send DMS updates with the ID in the URL, and match on the new certificate `type` values.",{"_3394":2871,"_29710":2605,"_20617":57296,"_5":14139,"_27008":56637,"_2880":57297},[],"Only once every check passes, delete the orphaned 3.8.0 volumes to reclaim storage. The delete is irreversible and the old KMS volume may hold the last copy of your CA key material, so take a `VolumeSnapshot` or a backup of both old PVCs first and keep it until you are confident the upgraded deployment is healthy. These are the fixed 3.8.0 names recorded in step 1; before deleting, confirm that neither is mounted by a running pod, for example with `kubectl describe pvc -n $NAMESPACE golang-engine-storage-kms-0 local-crl-file-storage-va-0`, where `Used By` must be `<none>`:",{"_3394":2872,"_29710":2605,"_20617":57299,"_5":14139,"_27008":56637,"_2880":57300},[],"The 3.8.0 per-service databases are no longer used either. Drop them only after the same checks pass and your PostgreSQL backup is verified.",{"_3394":2873,"_29710":2605,"_20617":57302,"_5":14139,"_27008":56637,"_2880":57303},[],"<Card title=\"Install with Helm\" description=\"Prepare dependencies, configure values and install a controlled deployment.\" href=\"/docs/deployment/self-hosted/helm\" />",{"_3394":2874,"_29710":2605,"_20617":57305,"_5":14139,"_27008":56637,"_2880":57306},[],"<Card title=\"Access control\" description=\"Principals, policies and the first administrator.\" href=\"/docs/platform/administration/access-control\" />",{"_3394":2875,"_29710":2605,"_20617":57308,"_5":14139,"_27008":56637,"_2880":57309},[],"<Card title=\"Configure a DMS\" description=\"Enrollment, re-enrollment and webhook settings.\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />","sorting",{"_57312":57313,"_57314":57315,"_57316":57317,"_57318":57319,"_17857":2915,"_68777":2915},"language","english","sortableProperties",[2880,29710,5,27008],"sortablePropertiesWithTypes",{"_2880":24618,"_29710":24618,"_5":24618,"_27008":24618},"sorts",{"_2880":57320,"_29710":60185,"_5":63049,"_27008":65913},{"_4562":57321,"_57322":57323,"_5":24618},{"_14215":3569,"_14596":11520,"_14615":6826,"_28713":3482,"_14602":9436,"_19571":15266,"_14236":11424,"_14243":3362,"_28655":10947,"_29064":4714,"_29085":4963,"_28689":4410,"_33996":5860,"_28792":7379,"_29129":7387,"_34003":3113,"_34006":18152,"_34009":5745,"_34012":8883,"_29536":4356,"_34017":14675,"_34019":3570,"_29566":17949,"_14611":24971,"_34023":5432,"_34026":4807,"_34028":6094,"_29113":7473,"_29531":23237,"_29579":7568,"_34033":3593,"_34035":22431,"_34037":3369,"_28809":2979,"_34040":13154,"_34042":3342,"_34044":9588,"_34046":3584,"_34048":3697,"_28726":4362,"_34051":7272,"_34053":5059,"_28720":13216,"_29150":7336,"_34057":7263,"_34059":7695,"_34062":15340,"_28766":3367,"_34066":6462,"_28646":14063,"_34069":6371,"_28694":3632,"_34072":19134,"_34074":3361,"_34077":36