8017":15,"_5":13637,"_2665":45391,"_28339":45392,"_19412":45396,"_25509":15},"Deploy from AWS Marketplace",[45393,45394,45395],"Docs","Deployment","Other models",[],{"_3170":16,"_28017":15,"_19412":45398,"_5":13306,"_25509":15,"_2665":45399},[],"Run a preconfigured Lamassu IoT instance on Amazon EC2.",{"_3170":17,"_28017":15,"_5":28336,"_19412":45401,"_25509":45402,"_2665":45403},[],"/docs/deployment/aws-marketplace#before-you-begin","Before you begin",{"_3170":18,"_28017":15,"_5":28336,"_19412":45405,"_25509":45406,"_2665":45407},[],"/docs/deployment/aws-marketplace#infrastructure-requirements","Infrastructure requirements",{"_3170":19,"_28017":15,"_5":28336,"_19412":45409,"_25509":45410,"_2665":45411},[],"/docs/deployment/aws-marketplace#open-the-offer","Open the offer",{"_3170":20,"_28017":15,"_5":28336,"_19412":45413,"_25509":45414,"_2665":45415},[],"/docs/deployment/aws-marketplace#configure-the-instance","Configure the instance",{"_3170":21,"_28017":15,"_5":28336,"_19412":45417,"_25509":45418,"_2665":45419},[],"/docs/deployment/aws-marketplace#limit-network-access","Limit network access",{"_3170":22,"_28017":15,"_5":28336,"_19412":45421,"_25509":45422,"_2665":45423},[],"/docs/deployment/aws-marketplace#launch-and-verify","Launch and verify",{"_3170":23,"_28017":15,"_5":28336,"_19412":45425,"_25509":45426,"_2665":45427},[],"/docs/deployment/aws-marketplace#next-step","Next step",{"_3170":24,"_28017":15,"_19412":45429,"_5":13306,"_25509":15,"_2665":45430},[],"The AWS Marketplace offering reduces initial setup to an EC2 instance inside your account. You keep control of the network, storage and operation of the machine.",{"_3170":25,"_28017":15,"_19412":45432,"_5":13306,"_25509":45402,"_2665":45433},[],"Permissions to subscribe to AWS Marketplace products and launch EC2 instances.",{"_3170":26,"_28017":15,"_19412":45435,"_5":13306,"_25509":45402,"_2665":45436},[],"A VPC and a subnet from which administrators and devices can reach the instance.",{"_3170":27,"_28017":15,"_19412":45438,"_5":13306,"_25509":45402,"_2665":45439},[],"A security group allowing the necessary endpoints.",{"_3170":28,"_28017":15,"_19412":45441,"_5":13306,"_25509":45406,"_2665":45442},[],"**Compute:** a `t3.large` instance at minimum. Use `t3.xlarge` or higher when the load requires it.",{"_3170":29,"_28017":15,"_19412":45444,"_5":13306,"_25509":45406,"_2665":45445},[],"**Storage:** an EBS `gp3` volume of at least 50 GB, sized to your inventory and retention needs.",{"_3170":30,"_28017":15,"_19412":45447,"_5":13306,"_25509":45406,"_2665":45448},[],"**Network:** HTTPS access from the necessary consumers, restricted to trusted networks.",{"_3170":31,"_28017":15,"_19412":45450,"_5":13306,"_25509":45410,"_2665":45451},[],"Go to Lamassu IoT on AWS Marketplace and review the terms before subscribing.",{"_3170":32,"_28017":15,"_19412":45453,"_5":13306,"_25509":45414,"_2665":45454},[],"Select `t3.large` or higher, assign at least 50 GB of `gp3` storage and choose the target VPC and subnet.",{"_3170":33,"_28017":15,"_19412":45456,"_5":13306,"_25509":45418,"_2665":45457},[],"Configure the security group for ports `443`, `8443` and `9443`. Restrict the origins to the administrative and device networks that really need to connect.",{"_3170":34,"_28017":15,"_19412":45459,"_5":13306,"_25509":45422,"_2665":45460},[],"Start the instance and open the console at `https://<public-ip>`. Check you can authenticate before continuing.",{"_3170":35,"_28017":15,"_19412":45462,"_5":13306,"_25509":45426,"_2665":45463},[],"Continue with Create your first CA to validate the instance's cryptographic configuration.",{"_3170":36,"_28017":36,"_5":13637,"_2665":45465,"_28339":45466,"_19412":45467,"_25509":36},"Deploy Lamassu",[45393,45394],[],{"_3170":37,"_28017":36,"_19412":45469,"_5":13306,"_25509":36,"_2665":45470},[],"Choose the operating model that fits your infrastructure and control requirements.",{"_3170":38,"_28017":36,"_5":28336,"_19412":45472,"_25509":45473,"_2665":45474},[],"/docs/deployment/overview#choose-a-model","Choose a model",{"_3170":39,"_28017":36,"_5":28336,"_19412":45476,"_25509":45477,"_2665":45478},[],"/docs/deployment/overview#just-want-to-evaluate-the-platform","Just want to evaluate the platform?",{"_3170":40,"_28017":36,"_5":28336,"_19412":45480,"_25509":45481,"_2665":45482},[],"/docs/deployment/overview#after-deployment","After deployment",{"_3170":41,"_28017":36,"_19412":45484,"_5":13306,"_25509":36,"_2665":45485},[],"You can run Lamassu on your own Kubernetes cluster, deploy a prebuilt image from AWS Marketplace or consume the platform as a managed service.",{"_3170":42,"_28017":36,"_19412":45487,"_5":13306,"_25509":45473,"_2665":45488},[],"Model",{"_3170":43,"_28017":36,"_19412":45490,"_5":13306,"_25509":45473,"_2665":45491},[],"Recommended for",{"_3170":44,"_28017":36,"_19412":45493,"_5":13306,"_25509":45473,"_2665":45494},[],"Who operates the infrastructure",{"_3170":45,"_28017":36,"_19412":45496,"_5":13306,"_25509":45473,"_2665":45497},[],"Starting point",{"_3170":46,"_28017":36,"_19412":45499,"_5":13306,"_25509":45473,"_2665":45500},[],"Kubernetes self-managed",{"_3170":47,"_28017":36,"_19412":45502,"_5":13306,"_25509":45473,"_2665":45503},[],"Production, regulated environments and custom deployments",{"_3170":48,"_28017":36,"_19412":45505,"_5":13306,"_25509":45473,"_2665":45506},[],"Your team",{"_3170":49,"_28017":36,"_19412":45508,"_5":13306,"_25509":45473,"_2665":45509},[],"Helm or Fastlane",{"_3170":50,"_28017":36,"_19412":45511,"_5":13306,"_25509":45473,"_2665":45512},[],"AWS Marketplace",{"_3170":51,"_28017":36,"_19412":45514,"_5":13306,"_25509":45473,"_2665":45515},[],"Evaluation or a dedicated deployment inside an AWS account",{"_3170":52,"_28017":36,"_19412":45517,"_5":13306,"_25509":45473,"_2665":45506},[],{"_3170":53,"_28017":36,"_19412":45519,"_5":13306,"_25509":45473,"_2665":45520},[],"Preconfigured image on EC2",{"_3170":54,"_28017":36,"_19412":45522,"_5":13306,"_25509":45473,"_2665":45523},[],"SaaS",{"_3170":55,"_28017":36,"_19412":45525,"_5":13306,"_25509":45473,"_2665":45526},[],"Teams that want to use the platform without operating it",{"_3170":56,"_28017":36,"_19412":45528,"_5":13306,"_25509":45473,"_2665":45529},[],"Lamassu",{"_3170":57,"_28017":36,"_19412":45531,"_5":13306,"_25509":45473,"_2665":45532},[],"Managed subscription",{"_3170":58,"_28017":36,"_19412":45534,"_5":13306,"_25509":45473,"_2665":45535},[],"<Card title=\"Kubernetes self-managed\" description=\"Control network, storage, keys, dependencies and the upgrade cycle.\" href=\"/docs/deployment/self-hosted/overview\" />",{"_3170":59,"_28017":36,"_19412":45537,"_5":13306,"_25509":45473,"_2665":45538},[],"<Card title=\"AWS Marketplace\" description=\"Launch a preconfigured Lamassu instance on AWS EC2.\" href=\"/docs/deployment/aws-marketplace\" />",{"_3170":60,"_28017":36,"_19412":45540,"_5":13306,"_25509":45473,"_2665":45541},[],"<Card title=\"Lamassu SaaS\" description=\"Use an operated and updated instance as a managed service.\" href=\"/docs/deployment/saas\" />",{"_3170":61,"_28017":36,"_19412":45543,"_5":13306,"_25509":45477,"_2665":45544},[],"Use Fastlane to bring up PostgreSQL, Keycloak, RabbitMQ and Lamassu on a Kubernetes cluster through a single flow. It is intended for labs, demos and bootstrap; for production, configure dependencies and Helm values explicitly.",{"_3170":62,"_28017":36,"_19412":45546,"_5":13306,"_25509":45481,"_2665":45547},[],"Once the console is available, continue with Create your first CA. That quickstart verifies the cryptographic engine and issuance work correctly.",{"_3170":63,"_28017":63,"_5":13637,"_2665":45549,"_28339":45550,"_19412":45551,"_25509":63},"Use Lamassu as SaaS",[45393,45394,45395],[],{"_3170":64,"_28017":63,"_19412":45553,"_5":13306,"_25509":63,"_2665":45554},[],"Consume Lamassu as a managed service without operating your own infrastructure.",{"_3170":65,"_28017":63,"_5":28336,"_19412":45556,"_25509":45557,"_2665":45558},[],"/docs/deployment/saas#what-the-service-manages","What the service manages",{"_3170":66,"_28017":63,"_5":28336,"_19412":45560,"_25509":45561,"_2665":45562},[],"/docs/deployment/saas#plans","Plans",{"_3170":67,"_28017":63,"_5":28336,"_19412":45564,"_25509":45565,"_2665":45566},[],"/docs/deployment/saas#request-access","Request access",{"_3170":68,"_28017":63,"_19412":45568,"_5":13306,"_25509":63,"_2665":45569},[],"Lamassu SaaS offers the platform's capabilities in a managed environment. It is the right option when your team wants to focus on PKI and device identities, not on maintaining the infrastructure that supports them.",{"_3170":69,"_28017":63,"_19412":45571,"_5":13306,"_25509":45557,"_2665":45572},[],"Platform availability and maintenance.",{"_3170":70,"_28017":63,"_19412":45574,"_5":13306,"_25509":45557,"_2665":45575},[],"Automatic backups.",{"_3170":71,"_28017":63,"_19412":45577,"_5":13306,"_25509":45557,"_2665":45578},[],"Version upgrades.",{"_3170":72,"_28017":63,"_19412":45580,"_5":13306,"_25509":45557,"_2665":45581},[],"Technical support and SLA according to your plan.",{"_3170":73,"_28017":63,"_19412":45583,"_5":13306,"_25509":45561,"_2665":45584},[],"Plan",{"_3170":74,"_28017":63,"_19412":45586,"_5":13306,"_25509":45561,"_2665":45587},[],"Devices",{"_3170":75,"_28017":63,"_19412":45589,"_5":13306,"_25509":45561,"_2665":45590},[],"Support",{"_3170":76,"_28017":63,"_19412":45592,"_5":13306,"_25509":45561,"_2665":45593},[],"SLA",{"_3170":77,"_28017":63,"_19412":45595,"_5":13306,"_25509":45561,"_2665":45596},[],"Starter",{"_3170":78,"_28017":63,"_19412":45598,"_5":13306,"_25509":45561,"_2665":45599},[],"Up to 1,000",{"_3170":79,"_28017":63,"_19412":45601,"_5":13306,"_25509":45561,"_2665":45602},[],"Email",{"_3170":80,"_28017":63,"_19412":45604,"_5":13306,"_25509":45561,"_2665":45605},[],"99.5 %",{"_3170":81,"_28017":63,"_19412":45607,"_5":13306,"_25509":45561,"_2665":45608},[],"Professional",{"_3170":82,"_28017":63,"_19412":45610,"_5":13306,"_25509":45561,"_2665":45611},[],"Up to 10,000",{"_3170":83,"_28017":63,"_19412":45613,"_5":13306,"_25509":45561,"_2665":45614},[],"Email and chat",{"_3170":84,"_28017":63,"_19412":45616,"_5":13306,"_25509":45561,"_2665":45617},[],"99.9 %",{"_3170":85,"_28017":63,"_19412":45619,"_5":13306,"_25509":45561,"_2665":45620},[],"Enterprise",{"_3170":86,"_28017":63,"_19412":45622,"_5":13306,"_25509":45561,"_2665":45623},[],"Unlimited",{"_3170":87,"_28017":63,"_19412":45625,"_5":13306,"_25509":45561,"_2665":45626},[],"Dedicated",{"_3170":88,"_28017":63,"_19412":45628,"_5":13306,"_25509":45561,"_2665":45629},[],"99.99 %",{"_3170":89,"_28017":63,"_19412":45631,"_5":13306,"_25509":45565,"_2665":45632},[],"Contact the Lamassu team through lamassu.io to request a demo or choose a plan.",{"_3170":90,"_28017":63,"_19412":45634,"_5":13306,"_25509":45565,"_2665":45635},[],"When you receive your instance's credentials, continue with Get started.",{"_3170":91,"_28017":91,"_5":13637,"_2665":45637,"_28339":45638,"_19412":45639,"_25509":91},"Fastlane",[45393,45394,45500],[],{"_3170":92,"_28017":91,"_19412":45641,"_5":13306,"_25509":91,"_2665":45642},[],"Bootstrap a complete Lamassu evaluation or lab environment on an existing Kubernetes cluster.",{"_3170":93,"_28017":91,"_5":28336,"_19412":45644,"_25509":45645,"_2665":45646},[],"/docs/deployment/self-hosted/fastlane#deploy-with-fastlane","Deploy with Fastlane",{"_3170":94,"_28017":91,"_5":28336,"_19412":45648,"_25509":45649,"_2665":45650},[],"/docs/deployment/self-hosted/fastlane#what-fastlane-adds","What Fastlane adds",{"_3170":95,"_28017":91,"_5":28336,"_19412":45652,"_25509":45653,"_2665":45403},[],"/docs/deployment/self-hosted/fastlane#before-you-begin",{"_3170":96,"_28017":91,"_5":28336,"_19412":45655,"_25509":45656,"_2665":45657},[],"/docs/deployment/self-hosted/fastlane#quick-start","Quick start",{"_3170":97,"_28017":91,"_5":28336,"_19412":45659,"_25509":45660,"_2665":45661},[],"/docs/deployment/self-hosted/fastlane#gateway-address-selection","Gateway address selection",{"_3170":98,"_28017":91,"_5":28336,"_19412":45663,"_25509":45664,"_2665":45665},[],"/docs/deployment/self-hosted/fastlane#command-line-options","Command-line options",{"_3170":99,"_28017":91,"_5":28336,"_19412":45667,"_25509":45668,"_2665":45669},[],"/docs/deployment/self-hosted/fastlane#development-mode","Development mode",{"_3170":100,"_28017":91,"_5":28336,"_19412":45671,"_25509":45672,"_2665":45673},[],"/docs/deployment/self-hosted/fastlane#what-the-script-configures","What the script configures",{"_3170":101,"_28017":91,"_5":28336,"_19412":45675,"_25509":45676,"_2665":45677},[],"/docs/deployment/self-hosted/fastlane#tls-behavior","TLS behavior",{"_3170":102,"_28017":91,"_5":28336,"_19412":45679,"_25509":45680,"_2665":45681},[],"/docs/deployment/self-hosted/fastlane#credentials-and-generated-files","Credentials and generated files",{"_3170":103,"_28017":91,"_5":28336,"_19412":45683,"_25509":45684,"_2665":45685},[],"/docs/deployment/self-hosted/fastlane#verify-the-installation","Verify the installation",{"_3170":104,"_28017":91,"_19412":45687,"_5":13306,"_25509":45645,"_2665":45688},[],"Fastlane is the automated path for evaluations, demos, CI and small lab clusters. It installs PostgreSQL, Keycloak, RabbitMQ, Envoy Gateway and Lamassu, then configures them to work together.",{"_3170":105,"_28017":91,"_19412":45690,"_5":13306,"_25509":45645,"_2665":45691},[],"For production, use Helm so database, identity, credentials, certificates, storage and upgrades remain explicit.",{"_3170":106,"_28017":91,"_19412":45693,"_5":13306,"_25509":45649,"_2665":45694},[],"Fastlane closes some of the gaps intentionally left by the application chart:",{"_3170":107,"_28017":91,"_19412":45696,"_5":13306,"_25509":45649,"_2665":45697},[],"Fastlane installs or configures",{"_3170":108,"_28017":91,"_19412":45699,"_5":13306,"_25509":45649,"_2665":45700},[],"You still provide",{"_3170":109,"_28017":91,"_19412":45702,"_5":13306,"_25509":45649,"_2665":45703},[],"PostgreSQL, RabbitMQ and Keycloak instances for evaluation",{"_3170":110,"_28017":91,"_19412":45705,"_5":13306,"_25509":45649,"_2665":45706},[],"The Kubernetes cluster, nodes and persistent storage",{"_3170":111,"_28017":91,"_19412":45708,"_5":13306,"_25509":45649,"_2665":45709},[],"Envoy Gateway 1.8 and the `eg` `GatewayClass`",{"_3170":112,"_28017":91,"_19412":45711,"_5":13306,"_25509":45649,"_2665":45712},[],"cert-manager, external network reachability, DNS and firewall/NAT rules",{"_3170":113,"_28017":91,"_19412":45714,"_5":13306,"_25509":45649,"_2665":45715},[],"A self-signed Lamassu certificate flow, generated dependency credentials and an initial user",{"_3170":114,"_28017":91,"_19412":45717,"_5":13306,"_25509":45649,"_2665":45718},[],"Client trust for the self-signed CA, or a trusted certificate passed to the script",{"_3170":115,"_28017":91,"_19412":45720,"_5":13306,"_25509":45649,"_2665":45721},[],"Optional observability and lab HSM components",{"_3170":116,"_28017":91,"_19412":45723,"_5":13306,"_25509":45649,"_2665":45724},[],"Production monitoring retention, backups, HA and a production HSM/key service",{"_3170":117,"_28017":91,"_19412":45726,"_5":13306,"_25509":45649,"_2665":45727},[],"Fastlane does not turn the resulting stack into a production service: it does not create the cluster, public DNS, firewall rules, backups, high availability or a trusted public certificate.",{"_3170":118,"_28017":91,"_19412":45729,"_5":13306,"_25509":45653,"_2665":45730},[],"You need:",{"_3170":119,"_28017":91,"_19412":45732,"_5":13306,"_25509":45653,"_2665":45733},[],"an existing Kubernetes cluster",{"_3170":120,"_28017":91,"_19412":45735,"_5":13306,"_25509":45653,"_2665":45736},[],"`kubectl` and Helm, or the MicroK8s CLI",{"_3170":121,"_28017":91,"_19412":45738,"_5":13306,"_25509":45653,"_2665":45739},[],"`yq`",{"_3170":122,"_28017":91,"_19412":45741,"_5":13306,"_25509":45653,"_2665":21988},[],{"_3170":123,"_28017":91,"_19412":45743,"_5":13306,"_25509":45653,"_2665":45744},[],"`jq` only when using `--sample-data` or `--development`",{"_3170":124,"_28017":91,"_19412":45746,"_5":13306,"_25509":45653,"_2665":45747},[],"`ssh-keygen` only when using `--with-hsm`",{"_3170":125,"_28017":91,"_19412":45749,"_5":13306,"_25509":45653,"_2665":45750},[],"free external ports 80 and 443 on a single-node K3s host",{"_3170":126,"_28017":91,"_19412":45752,"_5":13306,"_25509":45653,"_2665":45753},[],"Fastlane detects MicroK8s, K3s, kind or a standard kubeconfig. Use `--context` when the intended cluster is not the current context.",{"_3170":127,"_28017":91,"_19412":45755,"_5":13306,"_25509":45653,"_2665":45756},[],"Fastlane installs several components and creates credentials. Check `kubectl config current-context` or pass `--context` before running it.",{"_3170":128,"_28017":91,"_19412":45758,"_5":13306,"_25509":45656,"_2665":45759},[],"Run the script from a clone of the Helm repository:",{"_3170":129,"_28017":91,"_19412":45761,"_5":13306,"_25509":45656,"_2665":45762},[],"Create a DNS record for the chosen domain before testing from another machine. For a small VM, point it at the VM or load-balancer address that actually receives ports 80 and 443.",{"_3170":130,"_28017":91,"_19412":45764,"_5":13306,"_25509":45660,"_2665":45765},[],"By default, Fastlane runs `hostname -I` and writes the returned addresses to `gateway.addresses` and to the self-signed certificate's IP SANs.",{"_3170":131,"_28017":91,"_19412":45767,"_5":13306,"_25509":45660,"_2665":45768},[],"On a single-homed lab VM this can select the expected node address. On hosts with Docker, VPN, WireGuard or several interfaces it can also select addresses clients cannot reach. Override the result explicitly:",{"_3170":132,"_28017":91,"_19412":45770,"_5":13306,"_25509":45660,"_2665":45771},[],"The value must be an address handled on the Kubernetes side of the traffic path. If a public EC2 address forwards through WireGuard to the cluster, pass the reachable cluster/VM address, not the EC2 public address.",{"_3170":133,"_28017":91,"_19412":45773,"_5":13306,"_25509":45660,"_2665":45774},[],"See Expose the Gateway for K3s port conflicts, VIPs, external NAT and multi-Gateway designs.",{"_3170":134,"_28017":91,"_19412":45776,"_5":13306,"_25509":45664,"_2665":45777},[],"Option",{"_3170":135,"_28017":91,"_19412":45779,"_5":13306,"_25509":45664,"_2665":45780},[],"Default",{"_3170":136,"_28017":91,"_19412":45782,"_5":13306,"_25509":45664,"_2665":45783},[],"Purpose",{"_3170":137,"_28017":91,"_19412":45785,"_5":13306,"_25509":45664,"_2665":45786},[],"`-h`, `--help`",{"_3170":138,"_28017":91,"_19412":45788,"_5":13306,"_25509":45664,"_2665":45789},[],"—",{"_3170":139,"_28017":91,"_19412":45791,"_5":13306,"_25509":45664,"_2665":45792},[],"Show help",{"_3170":140,"_28017":91,"_19412":45794,"_5":13306,"_25509":45664,"_2665":45795},[],"`-c`, `--context`",{"_3170":141,"_28017":91,"_19412":45797,"_5":13306,"_25509":45664,"_2665":45798},[],"current context",{"_3170":142,"_28017":91,"_19412":45800,"_5":13306,"_25509":45664,"_2665":45801},[],"Select the kubeconfig context for kubectl and Helm",{"_3170":143,"_28017":91,"_19412":45803,"_5":13306,"_25509":45664,"_2665":45804},[],"`-n`, `--non-interactive`",{"_3170":144,"_28017":91,"_19412":45806,"_5":13306,"_25509":45664,"_2665":5961},[],{"_3170":145,"_28017":91,"_19412":45808,"_5":13306,"_25509":45664,"_2665":45809},[],"Skip prompts and generate dependency credentials",{"_3170":146,"_28017":91,"_19412":45811,"_5":13306,"_25509":45664,"_2665":45812},[],"`-ns`, `--namespace`",{"_3170":147,"_28017":91,"_19412":45814,"_5":13306,"_25509":45664,"_2665":45815},[],"`lamassu-dev`",{"_3170":148,"_28017":91,"_19412":45817,"_5":13306,"_25509":45664,"_2665":45818},[],"Namespace for the installation",{"_3170":149,"_28017":91,"_19412":45820,"_5":13306,"_25509":45664,"_2665":45821},[],"`-d`, `--domain`",{"_3170":150,"_28017":91,"_19412":45823,"_5":13306,"_25509":45664,"_2665":45824},[],"`dev.lamassu.io`",{"_3170":151,"_28017":91,"_19412":45826,"_5":13306,"_25509":45664,"_2665":45827},[],"Domain used by the UI, OIDC and certificate",{"_3170":152,"_28017":91,"_19412":45829,"_5":13306,"_25509":45664,"_2665":45830},[],"`-v`, `--version`",{"_3170":153,"_28017":91,"_19412":45832,"_5":13306,"_25509":45664,"_2665":13931},[],{"_3170":154,"_28017":91,"_19412":45834,"_5":13306,"_25509":45664,"_2665":45835},[],"Lamassu chart version",{"_3170":155,"_28017":91,"_19412":45837,"_5":13306,"_25509":45664,"_2665":45838},[],"`--https-port`",{"_3170":156,"_28017":91,"_19412":45840,"_5":13306,"_25509":45664,"_2665":45841},[],"`443`",{"_3170":157,"_28017":91,"_19412":45843,"_5":13306,"_25509":45664,"_2665":45844},[],"Gateway HTTPS listener port",{"_3170":158,"_28017":91,"_19412":45846,"_5":13306,"_25509":45664,"_2665":45847},[],"`--http-port`",{"_3170":159,"_28017":91,"_19412":45849,"_5":13306,"_25509":45664,"_2665":45850},[],"`80`",{"_3170":160,"_28017":91,"_19412":45852,"_5":13306,"_25509":45664,"_2665":45853},[],"Gateway HTTP listener port",{"_3170":161,"_28017":91,"_19412":45855,"_5":13306,"_25509":45664,"_2665":45856},[],"`--tls-crt`",{"_3170":162,"_28017":91,"_19412":45858,"_5":13306,"_25509":45664,"_2665":45789},[],{"_3170":163,"_28017":91,"_19412":45860,"_5":13306,"_25509":45664,"_2665":45861},[],"PEM certificate for downstream TLS",{"_3170":164,"_28017":91,"_19412":45863,"_5":13306,"_25509":45664,"_2665":45864},[],"`--tls-key`",{"_3170":165,"_28017":91,"_19412":45866,"_5":13306,"_25509":45664,"_2665":45789},[],{"_3170":166,"_28017":91,"_19412":45868,"_5":13306,"_25509":45664,"_2665":45869},[],"PEM private key for downstream TLS",{"_3170":167,"_28017":91,"_19412":45871,"_5":13306,"_25509":45664,"_2665":45872},[],"`-l`, `--local-chart-path`",{"_3170":168,"_28017":91,"_19412":45874,"_5":13306,"_25509":45664,"_2665":45875},[],"repository chart",{"_3170":169,"_28017":91,"_19412":45877,"_5":13306,"_25509":45664,"_2665":45878},[],"Use an unpacked local Lamassu chart",{"_3170":170,"_28017":91,"_19412":45880,"_5":13306,"_25509":45664,"_2665":45881},[],"`-ip`, `--gateway-ip`",{"_3170":171,"_28017":91,"_19412":45883,"_5":13306,"_25509":45664,"_2665":8019},[],{"_3170":172,"_28017":91,"_19412":45885,"_5":13306,"_25509":45664,"_2665":45886},[],"Override the address written to `gateway.addresses`",{"_3170":173,"_28017":91,"_19412":45888,"_5":13306,"_25509":45664,"_2665":45889},[],"`--otel`",{"_3170":174,"_28017":91,"_19412":45891,"_5":13306,"_25509":45664,"_2665":5961},[],{"_3170":175,"_28017":91,"_19412":45893,"_5":13306,"_25509":45664,"_2665":45894},[],"Install Victoria Logs, VictoriaTraces, Jaeger and an OpenTelemetry Collector",{"_3170":176,"_28017":91,"_19412":45896,"_5":13306,"_25509":45664,"_2665":45897},[],"`--development`",{"_3170":177,"_28017":91,"_19412":45899,"_5":13306,"_25509":45664,"_2665":5961},[],{"_3170":178,"_28017":91,"_19412":45901,"_5":13306,"_25509":45664,"_2665":45902},[],"Development mode: fully provisions the Keycloak `lamassu` user (fixed `lamassu`/`lamassu` password, no first-login steps) and lets the `frontend` client accept any redirect URI or web origin. Not for production",{"_3170":179,"_28017":91,"_19412":45904,"_5":13306,"_25509":45664,"_2665":45905},[],"`--sample-data`",{"_3170":180,"_28017":91,"_19412":45907,"_5":13306,"_25509":45664,"_2665":5961},[],{"_3170":181,"_28017":91,"_19412":45909,"_5":13306,"_25509":45664,"_2665":45910},[],"Create sample CAs, profiles, certificates, DMS data and devices",{"_3170":182,"_28017":91,"_19412":45912,"_5":13306,"_25509":45664,"_2665":45913},[],"`--with-hsm`",{"_3170":183,"_28017":91,"_19412":45915,"_5":13306,"_25509":45664,"_2665":5961},[],{"_3170":184,"_28017":91,"_19412":45917,"_5":13306,"_25509":45664,"_2665":45918},[],"Install lab HSM components and configure KMS for PKCS#11",{"_3170":185,"_28017":91,"_19412":45920,"_5":13306,"_25509":45664,"_2665":45921},[],"`--softhsm-chart-path`",{"_3170":186,"_28017":91,"_19412":45923,"_5":13306,"_25509":45664,"_2665":45924},[],"`./charts/softhsm`",{"_3170":187,"_28017":91,"_19412":45926,"_5":13306,"_25509":45664,"_2665":45927},[],"Use a different local SoftHSM chart",{"_3170":188,"_28017":91,"_19412":45929,"_5":13306,"_25509":45664,"_2665":45930},[],"Fastlane does not provide an offline mode. Use the manual Helm workflow and a prepared registry/chart mirror for disconnected environments.",{"_3170":189,"_28017":91,"_19412":45932,"_5":13306,"_25509":45668,"_2665":45933},[],"`--development` adjusts the Keycloak `lamassu` realm generated by Fastlane for a disposable evaluation environment:",{"_3170":190,"_28017":91,"_19412":45935,"_5":13306,"_25509":45668,"_2665":45936},[],"the `lamassu` user is fully provisioned (first name Lamassu, last name Admin, email `lamassu@lamassu.io`, verified): there are no profile setup or password change steps on first login",{"_3170":191,"_28017":91,"_19412":45938,"_5":13306,"_25509":45668,"_2665":45939},[],"the well-known `lamassu`/`lamassu` password is fixed and permanent: it is never rotated and grants the `pki-admin` role, including non-interactive tokens through the `frontend` client",{"_3170":192,"_28017":91,"_19412":45941,"_5":13306,"_25509":45668,"_2665":45942},[],"the `frontend` client accepts any redirect URI and any web origin (`*`) instead of the original `/*` patterns",{"_3170":193,"_28017":91,"_19412":45944,"_5":13306,"_25509":45668,"_2665":45945},[],"With `--development`, the fixed `lamassu`/`lamassu` password grants `pki-admin` access to anyone who can reach the installation. Never use it on anything exposed beyond a development machine or a network-reachable host.",{"_3170":194,"_28017":91,"_19412":45947,"_5":13306,"_25509":45668,"_2665":45948},[],"`--development` applies when the `lamassu` realm is first imported. It does not modify an existing cluster. It can be combined with `--sample-data`: the development transform runs first, then sample data is added to the same realm configuration.",{"_3170":195,"_28017":91,"_19412":45950,"_5":13306,"_25509":45672,"_2665":45951},[],"Fastlane:",{"_3170":196,"_28017":91,"_19412":45953,"_5":13306,"_25509":45672,"_2665":45954},[],"validates local tools and the selected cluster",{"_3170":197,"_28017":91,"_19412":45956,"_5":13306,"_25509":45672,"_2665":45957},[],"installs or upgrades Envoy Gateway 1.8 and creates the `eg` `GatewayClass`",{"_3170":198,"_28017":91,"_19412":45959,"_5":13306,"_25509":45672,"_2665":45960},[],"creates the namespace",{"_3170":199,"_28017":91,"_19412":45962,"_5":13306,"_25509":45672,"_2665":45963},[],"installs PostgreSQL and creates the required databases",{"_3170":200,"_28017":91,"_19412":45965,"_5":13306,"_25509":45672,"_2665":45966},[],"installs Keycloak and creates the `lamassu` realm, frontend client, admin role and initial user",{"_3170":201,"_28017":91,"_19412":45968,"_5":13306,"_25509":45672,"_2665":45969},[],"installs RabbitMQ",{"_3170":202,"_28017":91,"_19412":45971,"_5":13306,"_25509":45672,"_2665":45972},[],"optionally installs observability and lab HSM components",{"_3170":203,"_28017":91,"_19412":45974,"_5":13306,"_25509":45672,"_2665":45975},[],"generates `lamassu.yaml` and installs the Lamassu chart",{"_3170":204,"_28017":91,"_19412":45977,"_5":13306,"_25509":45672,"_2665":45978},[],"optionally loads sample data",{"_3170":205,"_28017":91,"_19412":45980,"_5":13306,"_25509":45672,"_2665":45981},[],"The generated configuration exposes Keycloak at `/auth` through the same Gateway and bootstraps the initial `lamassu` user as a Lamassu super administrator.",{"_3170":206,"_28017":91,"_19412":45983,"_5":13306,"_25509":45676,"_2665":45984},[],"With both `--tls-crt` and `--tls-key`, Fastlane creates the `downstream-provided-crt` Secret and configures `tls.type: external`.",{"_3170":207,"_28017":91,"_19412":45986,"_5":13306,"_25509":45676,"_2665":45987},[],"Without them, it configures cert-manager with a self-signed issuer. This is suitable for a lab but will not be trusted by clients until you distribute the CA. Use Helm when you need a corporate Issuer, public ACME issuer or an existing Secret managed by another system.",{"_3170":208,"_28017":91,"_19412":45989,"_5":13306,"_25509":45680,"_2665":45990},[],"Non-interactive mode generates random PostgreSQL, RabbitMQ and Keycloak administrator passwords. The initial Lamassu login is `lamassu` / `lamassu` and requires a password change on first use, unless `--development` was used: in that case the password stays fixed and permanent.",{"_3170":209,"_28017":91,"_19412":45992,"_5":13306,"_25509":45680,"_2665":45993},[],"Fastlane writes `lamassu.yaml` in the current directory and injects credentials into it.",{"_3170":210,"_28017":91,"_19412":45995,"_5":13306,"_25509":45680,"_2665":45996},[],"Protect the generated values file, record the generated credentials in an appropriate secret store and do not reuse the evaluation identity setup in production.",{"_3170":211,"_28017":91,"_19412":45998,"_5":13306,"_25509":45684,"_2665":45999},[],"Then open `https://pki.example.com` and sign in with the initial user. If the Gateway is programmed but the URL is unreachable, follow the checks in Expose the Gateway.",{"_3170":212,"_28017":212,"_5":13637,"_2665":46001,"_28339":46002,"_19412":46003,"_25509":212},"Install with Helm",[45393,45394,45500],[],{"_3170":213,"_28017":212,"_19412":46005,"_5":13306,"_25509":212,"_2665":46006},[],"Prepare dependencies, configure the Lamassu chart and verify a controlled Kubernetes deployment.",{"_3170":214,"_28017":212,"_5":28336,"_19412":46008,"_25509":46009,"_2665":46010},[],"/docs/deployment/self-hosted/helm#install-lamassu-with-helm","Install Lamassu with Helm",{"_3170":215,"_28017":212,"_5":28336,"_19412":46012,"_25509":46013,"_2665":45403},[],"/docs/deployment/self-hosted/helm#before-you-begin",{"_3170":216,"_28017":212,"_5":28336,"_19412":46015,"_25509":46016,"_2665":46017},[],"/docs/deployment/self-hosted/helm#1-install-the-gateway-prerequisites","1\\. Install the Gateway prerequisites",{"_3170":217,"_28017":212,"_5":28336,"_19412":46019,"_25509":46020,"_2665":46021},[],"/docs/deployment/self-hosted/helm#2-create-a-values-file","2\\. Create a values file",{"_3170":218,"_28017":212,"_5":28336,"_19412":46023,"_25509":46024,"_2665":46025},[],"/docs/deployment/self-hosted/helm#tls-with-an-existing-secret","TLS with an existing Secret",{"_3170":219,"_28017":212,"_5":28336,"_19412":46027,"_25509":46028,"_2665":46029},[],"/docs/deployment/self-hosted/helm#provision-the-first-administrator","Provision the first administrator",{"_3170":220,"_28017":212,"_5":28336,"_19412":46031,"_25509":46032,"_2665":46033},[],"/docs/deployment/self-hosted/helm#3-install-lamassu","3\\. Install Lamassu",{"_3170":221,"_28017":212,"_5":28336,"_19412":46035,"_25509":46036,"_2665":46037},[],"/docs/deployment/self-hosted/helm#4-verify-the-deployment","4\\. Verify the deployment",{"_3170":222,"_28017":212,"_5":28336,"_19412":46039,"_25509":46040,"_2665":46041},[],"/docs/deployment/self-hosted/helm#production-decisions","Production decisions",{"_3170":223,"_28017":212,"_19412":46043,"_5":13306,"_25509":46009,"_2665":46044},[],"Use the Helm workflow when you need explicit control over identity, databases, messaging, certificates, storage and upgrades. For an evaluation environment where the script can make those choices for you, use Fastlane.",{"_3170":224,"_28017":212,"_19412":46046,"_5":13306,"_25509":46013,"_2665":46047},[],"Prepare the platform services that are deliberately outside the Lamassu chart:",{"_3170":225,"_28017":212,"_19412":46049,"_5":13306,"_25509":46013,"_2665":46050},[],"a Kubernetes 1.24+ cluster and Helm 3.2+",{"_3170":226,"_28017":212,"_19412":46052,"_5":13306,"_25509":46013,"_2665":46053},[],"a reachable PostgreSQL server and a role allowed to create databases and schemas",{"_3170":227,"_28017":212,"_19412":46055,"_5":13306,"_25509":46013,"_2665":46056},[],"a reachable RabbitMQ broker and credentials",{"_3170":228,"_28017":212,"_19412":46058,"_5":13306,"_25509":46013,"_2665":46059},[],"an OIDC provider, normally Keycloak, with a realm/tenant and client for Lamassu",{"_3170":229,"_28017":212,"_19412":46061,"_5":13306,"_25509":46013,"_2665":46062},[],"Envoy Gateway 1.8+ and a `GatewayClass`",{"_3170":230,"_28017":212,"_19412":46064,"_5":13306,"_25509":46013,"_2665":46065},[],"cert-manager 1.14+ (only for the default `tls.type: certManager` mode); for trusted TLS, either a trusted issuer or a Kubernetes TLS Secret",{"_3170":231,"_28017":212,"_19412":46067,"_5":13306,"_25509":46013,"_2665":46068},[],"a StorageClass and an external traffic design",{"_3170":232,"_28017":212,"_19412":46070,"_5":13306,"_25509":46013,"_2665":46071},[],"The chart defaults to a `GatewayClass` named `eg`. Change `gateway.className` if your platform team uses another name.",{"_3170":233,"_28017":212,"_19412":46073,"_5":13306,"_25509":46013,"_2665":46074},[],"You provide the PostgreSQL server. The chart's pre-install job connects with the supplied credentials, creates the required `pki`, `authz` and `wfx` databases and service schemas, runs migrations, and applies `services.authz.bootstrap`.",{"_3170":234,"_28017":212,"_19412":46076,"_5":13306,"_25509":46013,"_2665":46077},[],"The chart has no Helm dependencies that install PostgreSQL, RabbitMQ, an OIDC provider, Envoy Gateway or cert-manager.",{"_3170":235,"_28017":212,"_19412":46079,"_5":13306,"_25509":46016,"_2665":46080},[],"Install or upgrade the Envoy Gateway CRDs before its controller. The commands below match the version used by the Lamassu Helm repository:",{"_3170":236,"_28017":212,"_19412":46082,"_5":13306,"_25509":46016,"_2665":46083},[],"Create the default `GatewayClass` if it does not already exist. Save this manifest as `gateway-class.yaml`:",{"_3170":237,"_28017":212,"_19412":46085,"_5":13306,"_25509":46016,"_2665":46086},[],"Install cert-manager separately before Lamassu, but only for the default `tls.type: certManager` mode. In that mode the chart renders its self-signed Issuer and CA Certificate resources regardless of whether `tls.certManagerOptions.clusterIssuer` is set, so cert-manager stays a prerequisite. With `tls.type: external`, the chart renders no cert-manager resources and the Gateway terminates TLS with an existing Secret you provide instead.",{"_3170":238,"_28017":212,"_19412":46088,"_5":13306,"_25509":46020,"_2665":46089},[],"Start with the chart defaults and override the environment-specific values. This example assumes PostgreSQL, RabbitMQ and Keycloak are reachable through Kubernetes DNS, and exposes Keycloak at `/auth` through the shared Lamassu Gateway:",{"_3170":239,"_28017":212,"_19412":46091,"_5":13306,"_25509":46020,"_2665":46092},[],"Do not add `gateway.addresses` by default. Leave address assignment to the load-balancer implementation unless your network design requires a specific Kubernetes-side VIP. The public IP of an upstream NAT gateway or reverse proxy does not belong in this value.",{"_3170":240,"_28017":212,"_19412":46094,"_5":13306,"_25509":46020,"_2665":46095},[],"If Keycloak is external and already has its own reachable URL, point the OIDC settings at it and omit the `/auth` entry from `gateway.extraRouting`.",{"_3170":241,"_28017":212,"_19412":46097,"_5":13306,"_25509":46024,"_2665":46098},[],"Create a Secret containing `tls.crt` and `tls.key`, then reference it. The Secret must already exist before installing: in `external` mode the chart renders no cert-manager resources and never creates this Secret.",{"_3170":242,"_28017":212,"_19412":46100,"_5":13306,"_25509":46028,"_2665":46101},[],"There is no implicit superuser. Create the role or group expected by `services.authz.bootstrap` in the OIDC provider and assign it to at least one administrator before exposing Lamassu.",{"_3170":243,"_28017":212,"_19412":46103,"_5":13306,"_25509":46028,"_2665":46104},[],"The pre-install and pre-upgrade job applies the bootstrap idempotently: existing principals are preserved and missing grants are added.",{"_3170":244,"_28017":212,"_19412":46106,"_5":13306,"_25509":46028,"_2665":46107},[],"Test both an authorized identity and a denied identity. If no token matches an active bootstrap principal, nobody can administer the PKI.",{"_3170":245,"_28017":212,"_19412":46109,"_5":13306,"_25509":46028,"_2665":46110},[],"See Access control for the principal and policy model.",{"_3170":246,"_28017":212,"_19412":46112,"_5":13306,"_25509":46032,"_2665":46113},[],"To install a local checkout instead:",{"_3170":247,"_28017":212,"_19412":46115,"_5":13306,"_25509":46036,"_2665":46116},[],"The Gateway should report `PROGRAMMED=True`. If it is programmed but has no usable address, continue with Expose the Gateway.",{"_3170":248,"_28017":212,"_19412":46118,"_5":13306,"_25509":46036,"_2665":46119},[],"The Helm test checks the CA, DMS Manager, Device Manager and VA health endpoints and verifies the UI response.",{"_3170":249,"_28017":212,"_19412":46121,"_5":13306,"_25509":46040,"_2665":46122},[],"Before going live, review:",{"_3170":250,"_28017":212,"_19412":46124,"_5":13306,"_25509":46040,"_2665":46125},[],"backup and recovery for PostgreSQL and persistent volumes",{"_3170":251,"_28017":212,"_19412":46127,"_5":13306,"_25509":46040,"_2665":46128},[],"a production KMS engine; the default filesystem engine is not an HA design",{"_3170":252,"_28017":212,"_19412":46130,"_5":13306,"_25509":46040,"_2665":46131},[],"shared VA storage before increasing VA replicas",{"_3170":253,"_28017":212,"_19412":46133,"_5":13306,"_25509":46040,"_2665":46134},[],"managed OIDC roles and removal of evaluation credentials",{"_3170":254,"_28017":212,"_19412":46136,"_5":13306,"_25509":46040,"_2665":46137},[],"a trusted TLS issuer or externally managed certificate",{"_3170":255,"_28017":212,"_19412":46139,"_5":13306,"_25509":46040,"_2665":46140},[],"resource requests, replicas, autoscaling, disruption budgets and placement",{"_3170":256,"_28017":212,"_19412":46142,"_5":13306,"_25509":46040,"_2665":46143},[],"SMTP, observability and alert delivery",{"_3170":257,"_28017":212,"_19412":46145,"_5":13306,"_25509":46040,"_2665":46146},[],"the version upgrade guides and the notes in `charts/lamassu/CHANGELOG/` before every upgrade",{"_3170":258,"_28017":212,"_19412":46148,"_5":13306,"_25509":46040,"_2665":46149},[],"The complete values reference is maintained in `charts/lamassu/VALUES.md` in the Helm repository.",{"_3170":259,"_28017":259,"_5":13637,"_2665":46151,"_28339":46152,"_19412":46153,"_25509":259},"Expose the Gateway",[45393,45394,45500],[],{"_3170":260,"_28017":259,"_19412":46155,"_5":13306,"_25509":259,"_2665":46156},[],"Choose how clients reach Lamassu, when to set gateway.addresses and how to design multiple Gateways.",{"_3170":261,"_28017":259,"_5":28336,"_19412":46158,"_25509":46159,"_2665":46160},[],"/docs/deployment/self-hosted/networking#expose-the-lamassu-gateway","Expose the Lamassu Gateway",{"_3170":262,"_28017":259,"_5":28336,"_19412":46162,"_25509":46163,"_2665":46164},[],"/docs/deployment/self-hosted/networking#do-you-need-gatewayaddresses","Do you need `gateway.addresses`?",{"_3170":263,"_28017":259,"_5":28336,"_19412":46166,"_25509":46167,"_2665":46168},[],"/docs/deployment/self-hosted/networking#recommended-single-node-design","Recommended single-node design",{"_3170":264,"_28017":259,"_5":28336,"_19412":46170,"_25509":46171,"_2665":46172},[],"/docs/deployment/self-hosted/networking#k3s","K3s",{"_3170":265,"_28017":259,"_5":28336,"_19412":46174,"_25509":46175,"_2665":46176},[],"/docs/deployment/self-hosted/networking#bare-metal-with-metallb-or-kube-vip","Bare metal with MetalLB or kube-vip",{"_3170":266,"_28017":259,"_5":28336,"_19412":46178,"_25509":46179,"_2665":46180},[],"/docs/deployment/self-hosted/networking#external-reverse-proxy-nat-or-vpn","External reverse proxy, NAT or VPN",{"_3170":267,"_28017":259,"_5":28336,"_19412":46182,"_25509":46183,"_2665":46184},[],"/docs/deployment/self-hosted/networking#what-if-you-need-three-gateways","What if you need three Gateways?",{"_3170":268,"_28017":259,"_5":28336,"_19412":46186,"_25509":46187,"_2665":46188},[],"/docs/deployment/self-hosted/networking#decision-guide","Decision guide",{"_3170":269,"_28017":259,"_5":28336,"_19412":46190,"_25509":46191,"_2665":46192},[],"/docs/deployment/self-hosted/networking#egress-proxy","Egress proxy",{"_3170":270,"_28017":259,"_5":28336,"_19412":46194,"_25509":46195,"_2665":46196},[],"/docs/deployment/self-hosted/networking#verify-the-traffic-path","Verify the traffic path",{"_3170":271,"_28017":259,"_19412":46198,"_5":13306,"_25509":46159,"_2665":46199},[],"The Lamassu chart creates one shared Gateway with HTTP and HTTPS listeners. Envoy Gateway normally creates a dedicated proxy deployment and a `LoadBalancer` Service for it.",{"_3170":272,"_28017":259,"_19412":46201,"_5":13306,"_25509":46159,"_2665":46202},[],"External reachability is the result of the whole path. A `Gateway` resource alone does not configure your router, firewall, DNS, cloud load balancer or upstream NAT.",{"_3170":273,"_28017":259,"_19412":46204,"_5":13306,"_25509":46163,"_2665":46205},[],"Usually, no. If you omit it, the Gateway controller and the cluster load-balancer implementation can assign an address and report it in `Gateway.status.addresses` and the generated Service status.",{"_3170":274,"_28017":259,"_19412":46207,"_5":13306,"_25509":46163,"_2665":46208},[],"Set it only when:",{"_3170":275,"_28017":259,"_19412":46210,"_5":13306,"_25509":46163,"_2665":46211},[],"your cloud or bare-metal load balancer supports requesting a specific address",{"_3170":276,"_28017":259,"_19412":46213,"_5":13306,"_25509":46163,"_2665":46214},[],"that address is allocated to this Gateway",{"_3170":277,"_28017":259,"_19412":46216,"_5":13306,"_25509":46163,"_2665":46217},[],"the surrounding network already routes traffic for it to the cluster",{"_3170":278,"_28017":259,"_19412":46219,"_5":13306,"_25509":46163,"_2665":46220},[],"This requests `192.168.1.50`; it does not claim the IP on your LAN or make it reachable.",{"_3170":279,"_28017":259,"_19412":46222,"_5":13306,"_25509":46163,"_2665":46223},[],"Keep these two settings separate:",{"_3170":280,"_28017":259,"_19412":46225,"_5":13306,"_25509":46163,"_2665":46226},[],"`gateway.addresses` requests an address for the Gateway.",{"_3170":281,"_28017":259,"_19412":46228,"_5":13306,"_25509":46163,"_2665":46229},[],"`tls.certManagerOptions.certSpec.addresses` adds IP subject alternative names to the TLS certificate.",{"_3170":282,"_28017":259,"_19412":46231,"_5":13306,"_25509":46163,"_2665":46232},[],"If users connect by DNS name, put that name in `tls.certManagerOptions.certSpec.hostnames`. Do not copy an upstream proxy's public IP into `gateway.addresses`.",{"_3170":283,"_28017":259,"_19412":46234,"_5":13306,"_25509":46167,"_2665":46235},[],"For a small VM running K3s or MicroK8s, use one external Lamassu Gateway and route every Lamassu endpoint through it:",{"_3170":284,"_28017":259,"_19412":46237,"_5":13306,"_25509":46167,"_2665":46238},[],"This design uses one IP, one TLS entry point and one pair of ports. The chart already creates the required routes.",{"_3170":285,"_28017":259,"_19412":46240,"_5":13306,"_25509":46171,"_2665":46241},[],"K3s ServiceLB implements each `LoadBalancer` Service with pods that reserve the Service ports on the node. On a single node, only one Service can therefore own port 80 and one can own port 443. The default K3s Traefik Service may already hold both ports.",{"_3170":286,"_28017":259,"_19412":46243,"_5":13306,"_25509":46171,"_2665":46244},[],"For the recommended design:",{"_3170":287,"_28017":259,"_19412":46246,"_5":13306,"_25509":46171,"_2665":46247},[],"Use only one externally exposed Lamassu Gateway.",{"_3170":288,"_28017":259,"_19412":46249,"_5":13306,"_25509":46171,"_2665":46250},[],"Ensure ports 80 and 443 are free. Disable or reconfigure Traefik if it is not part of your traffic path.",{"_3170":289,"_28017":259,"_19412":46252,"_5":13306,"_25509":46171,"_2665":46253},[],"Allow those ports through the VM firewall and any upstream security group.",{"_3170":290,"_28017":259,"_19412":46255,"_5":13306,"_25509":46171,"_2665":46256},[],"Point DNS at the VM's reachable address.",{"_3170":291,"_28017":259,"_19412":46258,"_5":13306,"_25509":46171,"_2665":46259},[],"See the K3s ServiceLB documentation for its host-port behavior and how to replace it with another load-balancer implementation.",{"_3170":292,"_28017":259,"_19412":46261,"_5":13306,"_25509":46175,"_2665":46262},[],"Allocate a VIP from an address pool reachable on your LAN. You may request that VIP with `gateway.addresses` if the selected implementation supports it. Confirm the assigned address in status rather than assuming the request succeeded.",{"_3170":293,"_28017":259,"_19412":46264,"_5":13306,"_25509":46179,"_2665":46265},[],"An external public address can forward TCP 80 and 443 to the VM or to a Kubernetes-side VIP:",{"_3170":294,"_28017":259,"_19412":46267,"_5":13306,"_25509":46179,"_2665":46268},[],"The public IP belongs to the external device. Leave `gateway.addresses` unset or set it to the actual Kubernetes-side address, never to an address that the cluster cannot bind.",{"_3170":295,"_28017":259,"_19412":46270,"_5":13306,"_25509":46183,"_2665":46271},[],"First decide whether you need three independent data planes or only three hostnames.",{"_3170":296,"_28017":259,"_19412":46273,"_5":13306,"_25509":46183,"_2665":46274},[],"Requirement",{"_3170":297,"_28017":259,"_19412":46276,"_5":13306,"_25509":46183,"_2665":46277},[],"Recommended design",{"_3170":298,"_28017":259,"_19412":46279,"_5":13306,"_25509":46183,"_2665":46280},[],"Consequence",{"_3170":299,"_28017":259,"_19412":46282,"_5":13306,"_25509":46183,"_2665":46283},[],"Several Lamassu URLs or services",{"_3170":300,"_28017":259,"_19412":46285,"_5":13306,"_25509":46183,"_2665":46286},[],"One Gateway with multiple routes",{"_3170":301,"_28017":259,"_19412":46288,"_5":13306,"_25509":46183,"_2665":46289},[],"One IP and one proxy fleet; this is the chart default",{"_3170":302,"_28017":259,"_19412":46291,"_5":13306,"_25509":46183,"_2665":46292},[],"Independent Gateways and separate external IPs",{"_3170":303,"_28017":259,"_19412":46294,"_5":13306,"_25509":46183,"_2665":46295},[],"One VIP per Gateway",{"_3170":304,"_28017":259,"_19412":46297,"_5":13306,"_25509":46183,"_2665":46298},[],"All Gateways can use 80/443; requires a load balancer with an address pool",{"_3170":305,"_28017":259,"_19412":46300,"_5":13306,"_25509":46183,"_2665":46301},[],"Independent Gateways on one node and one IP",{"_3170":306,"_28017":259,"_19412":46303,"_5":13306,"_25509":46183,"_2665":46304},[],"Use different external ports",{"_3170":307,"_28017":259,"_19412":46306,"_5":13306,"_25509":46183,"_2665":46307},[],"Clients must include non-standard ports",{"_3170":308,"_28017":259,"_19412":46309,"_5":13306,"_25509":46183,"_2665":46310},[],"Separate TLS/mTLS termination behind one IP",{"_3170":309,"_28017":259,"_19412":46312,"_5":13306,"_25509":46183,"_2665":46313},[],"Front-door SNI routing to internal Gateways",{"_3170":310,"_28017":259,"_19412":46315,"_5":13306,"_25509":46183,"_2665":46316},[],"Advanced design; the front door uses TLS passthrough and each internal Gateway terminates its own TLS",{"_3170":311,"_28017":259,"_19412":46318,"_5":13306,"_25509":46183,"_2665":46319},[],"Separate Gateway resources but shared proxy infrastructure",{"_3170":312,"_28017":259,"_19412":46321,"_5":13306,"_25509":46183,"_2665":46322},[],"Envoy merged-Gateway mode",{"_3170":313,"_28017":259,"_19412":46324,"_5":13306,"_25509":46183,"_2665":46325},[],"Logical separation only; listeners must have unique port, protocol and hostname tuples",{"_3170":314,"_28017":259,"_19412":46327,"_5":13306,"_25509":46183,"_2665":46328},[],"Three independent `LoadBalancer` Services cannot all reserve the same node ports 80 and 443 through K3s ServiceLB. Use one shared Gateway, allocate distinct VIPs with another load-balancer implementation, or use different ports.",{"_3170":315,"_28017":259,"_19412":46330,"_5":13306,"_25509":46183,"_2665":46331},[],"Envoy Gateway normally provisions a proxy fleet per `Gateway`. Its merged-Gateway mode can share one fleet and address, but it is not a drop-in switch for multiple Lamassu releases: the generated Lamassu listeners use the same ports and protocols without distinct hostnames, so they conflict unless you deliberately customize the listener design.",{"_3170":316,"_28017":259,"_19412":46333,"_5":13306,"_25509":46183,"_2665":46334},[],"Use a front-door SNI design only when the internal Gateways must retain independent TLS or mTLS policy:",{"_3170":317,"_28017":259,"_19412":46336,"_5":13306,"_25509":46183,"_2665":46337},[],"This requires distinct SNI hostnames and cluster networking outside the Lamassu chart.",{"_3170":318,"_28017":259,"_19412":46339,"_5":13306,"_25509":46187,"_2665":46340},[],"If one Gateway can own TLS and routing, use the chart default.",{"_3170":319,"_28017":259,"_19412":46342,"_5":13306,"_25509":46187,"_2665":46343},[],"If Gateways need independent policy and you can allocate IPs, use one VIP per Gateway.",{"_3170":320,"_28017":259,"_19412":46345,"_5":13306,"_25509":46187,"_2665":46346},[],"If only the Kubernetes resources need separation, evaluate merged-Gateway mode and make every listener tuple unique.",{"_3170":321,"_28017":259,"_19412":46348,"_5":13306,"_25509":46187,"_2665":46349},[],"If data planes and TLS termination must stay independent behind one IP, add a front-door SNI passthrough layer.",{"_3170":322,"_28017":259,"_19412":46351,"_5":13306,"_25509":46187,"_2665":46352},[],"If none of those are possible, use different external ports or change the external network design.",{"_3170":323,"_28017":259,"_19412":46354,"_5":13306,"_25509":46191,"_2665":46355},[],"Internal Lamassu clients — the Vault engine connection, service-to-service calls and webhook deliveries — honor the `HTTP_PROXY`, `HTTPS_PROXY` and `NO_PROXY` environment variables. The exception is the authorization-engine connector: it uses its own transport and does not consult these proxy variables. If your deployment routes egress through a proxy, list in-cluster service names in `NO_PROXY` (for example `.svc,.cluster.local`) so internal traffic stays inside the cluster. Loopback traffic is never sent through a proxy.",{"_3170":324,"_28017":259,"_19412":46357,"_5":13306,"_25509":46191,"_2665":46358},[],"The default transport of these clients bounds the dial timeout (30 seconds), the TLS handshake (10 seconds) and idle connection reuse (90 seconds) so an unreachable dependency fails fast instead of hanging; these values are Go transport defaults, not Lamassu settings. HTTP/2 is negotiated when the peer supports it. The authorization-engine connector keeps its own transport without these dial and handshake timeouts; only its overall 30-second request timeout bounds each call.",{"_3170":325,"_28017":259,"_19412":46360,"_5":13306,"_25509":46195,"_2665":46361},[],"Check, in order:",{"_3170":326,"_28017":259,"_19412":46363,"_5":13306,"_25509":46195,"_2665":46364},[],"`Gateway` has `Accepted=True` and `Programmed=True`.",{"_3170":327,"_28017":259,"_19412":46366,"_5":13306,"_25509":46195,"_2665":46367},[],"Its status contains the expected address.",{"_3170":328,"_28017":259,"_19412":46369,"_5":13306,"_25509":46195,"_2665":46370},[],"The generated `LoadBalancer` Service has a usable external address.",{"_3170":329,"_28017":259,"_19412":46372,"_5":13306,"_25509":46195,"_2665":46373},[],"Port 443 reaches that address from the client network.",{"_3170":330,"_28017":259,"_19412":46375,"_5":13306,"_25509":46195,"_2665":46376},[],"DNS resolves to the externally reachable endpoint.",{"_3170":331,"_28017":259,"_19412":46378,"_5":13306,"_25509":46195,"_2665":46379},[],"The certificate contains the DNS name or IP used by the client.",{"_3170":332,"_28017":259,"_19412":46381,"_5":13306,"_25509":46195,"_2665":46382},[],"The Gateway API treats addresses as desired state that a controller may assign or reject; see the Gateway API overview for the resource model.",{"_3170":333,"_28017":333,"_5":13637,"_2665":45500,"_28339":46384,"_19412":46385,"_25509":333},[45393,45394,45500],[],{"_3170":334,"_28017":333,"_19412":46387,"_5":13306,"_25509":333,"_2665":46388},[],"Choose an installation workflow and network architecture for Lamassu on your Kubernetes cluster.",{"_3170":335,"_28017":333,"_5":28336,"_19412":46390,"_25509":46391,"_2665":46392},[],"/docs/deployment/self-hosted/overview#self-managed-kubernetes-deployment","Self-managed Kubernetes deployment",{"_3170":336,"_28017":333,"_5":28336,"_19412":46394,"_25509":46395,"_2665":46396},[],"/docs/deployment/self-hosted/overview#choose-an-installation-workflow","Choose an installation workflow",{"_3170":337,"_28017":333,"_5":28336,"_19412":46398,"_25509":46399,"_2665":46400},[],"/docs/deployment/self-hosted/overview#what-the-lamassu-chart-provides","What the Lamassu chart provides",{"_3170":338,"_28017":333,"_5":28336,"_19412":46402,"_25509":46403,"_2665":46404},[],"/docs/deployment/self-hosted/overview#how-the-deployment-fits-together","How the deployment fits together",{"_3170":339,"_28017":333,"_5":28336,"_19412":46406,"_25509":46407,"_2665":46408},[],"/docs/deployment/self-hosted/overview#platform-requirements","Platform requirements",{"_3170":340,"_28017":333,"_5":28336,"_19412":46410,"_25509":46411,"_2665":46412},[],"/docs/deployment/self-hosted/overview#choose-the-next-page","Choose the next page",{"_3170":341,"_28017":333,"_19412":46414,"_5":13306,"_25509":46391,"_2665":46415},[],"Run Lamassu in a Kubernetes cluster operated by your team. The Helm chart deploys the Lamassu services and their routing resources; you provide the cluster, persistent storage, identity provider, PostgreSQL, RabbitMQ and the network path used by clients.",{"_3170":342,"_28017":333,"_19412":46417,"_5":13306,"_25509":46395,"_2665":46418},[],"Workflow",{"_3170":343,"_28017":333,"_19412":46420,"_5":13306,"_25509":46395,"_2665":46421},[],"Use it for",{"_3170":344,"_28017":333,"_19412":46423,"_5":13306,"_25509":46395,"_2665":46424},[],"What it installs",{"_3170":345,"_28017":333,"_19412":46426,"_5":13306,"_25509":46395,"_2665":46427},[],"Helm",{"_3170":346,"_28017":333,"_19412":46429,"_5":13306,"_25509":46395,"_2665":46430},[],"Production and controlled environments",{"_3170":347,"_28017":333,"_19412":46432,"_5":13306,"_25509":46395,"_2665":46433},[],"Lamassu services and Gateway API resources",{"_3170":348,"_28017":333,"_19412":46435,"_5":13306,"_25509":46395,"_2665":45637},[],{"_3170":349,"_28017":333,"_19412":46437,"_5":13306,"_25509":46395,"_2665":46438},[],"Evaluation, demos, CI and small lab clusters",{"_3170":350,"_28017":333,"_19412":46440,"_5":13306,"_25509":46395,"_2665":46441},[],"PostgreSQL, Keycloak, RabbitMQ, Envoy Gateway and Lamassu",{"_3170":351,"_28017":333,"_19412":46443,"_5":13306,"_25509":46399,"_2665":46444},[],"The Lamassu chart is an **application chart**, not a cluster bootstrap chart. It creates the Kubernetes resources that run and configure Lamassu, but it expects the platform services those resources depend on to exist.",{"_3170":352,"_28017":333,"_19412":46446,"_5":13306,"_25509":46399,"_2665":46447},[],"Area",{"_3170":353,"_28017":333,"_19412":46449,"_5":13306,"_25509":46399,"_2665":46450},[],"The Lamassu chart provides",{"_3170":354,"_28017":333,"_19412":46452,"_5":13306,"_25509":46399,"_2665":46453},[],"You provide",{"_3170":355,"_28017":333,"_19412":46455,"_5":13306,"_25509":46399,"_2665":46456},[],"Lamassu applications",{"_3170":356,"_28017":333,"_19412":46458,"_5":13306,"_25509":46399,"_2665":46459},[],"Deployments and StatefulSets for the UI and APIs, internal Services, ConfigMaps, a ServiceAccount, and optional HPAs and PDBs",{"_3170":357,"_28017":333,"_19412":46461,"_5":13306,"_25509":46399,"_2665":46462},[],"A working Kubernetes cluster, compute capacity and access to the container images",{"_3170":358,"_28017":333,"_19412":46464,"_5":13306,"_25509":46399,"_2665":46465},[],"PostgreSQL data",{"_3170":359,"_28017":333,"_19412":46467,"_5":13306,"_25509":46399,"_2665":46468},[],"A pre-install/pre-upgrade job that creates the required databases and schemas, runs migrations and applies the authorization bootstrap",{"_3170":360,"_28017":333,"_19412":46470,"_5":13306,"_25509":46399,"_2665":46471},[],"A reachable PostgreSQL server, credentials allowed to create databases and schemas, and backup/HA operations",{"_3170":361,"_28017":333,"_19412":46473,"_5":13306,"_25509":46399,"_2665":46474},[],"Messaging",{"_3170":362,"_28017":333,"_19412":46476,"_5":13306,"_25509":46399,"_2665":46477},[],"RabbitMQ connection configuration for the Lamassu services",{"_3170":363,"_28017":333,"_19412":46479,"_5":13306,"_25509":46399,"_2665":46480},[],"A reachable RabbitMQ broker, credentials and its lifecycle",{"_3170":364,"_28017":333,"_19412":46482,"_5":13306,"_25509":46399,"_2665":46483},[],"Identity",{"_3170":365,"_28017":333,"_19412":46485,"_5":13306,"_25509":46399,"_2665":46486},[],"OIDC/JWT and external-authorization configuration, plus initial Lamassu authorization principals",{"_3170":366,"_28017":333,"_19412":46488,"_5":13306,"_25509":46399,"_2665":46489},[],"An OIDC provider, realm/tenant, client, users, groups and roles",{"_3170":367,"_28017":333,"_19412":46491,"_5":13306,"_25509":46399,"_2665":46492},[],"External routing",{"_3170":368,"_28017":333,"_19412":46494,"_5":13306,"_25509":46399,"_2665":46495},[],"One `Gateway`, `HTTPRoute` resources, an `EnvoyProxy` configuration and Envoy security policies",{"_3170":369,"_28017":333,"_19412":46497,"_5":13306,"_25509":46399,"_2665":46498},[],"Gateway API and Envoy CRDs, the Envoy Gateway controller, a `GatewayClass`, a load-balancer implementation and the external network path",{"_3170":370,"_28017":333,"_19412":46500,"_5":13306,"_25509":46399,"_2665":46501},[],"TLS",{"_3170":371,"_28017":333,"_19412":46503,"_5":13306,"_25509":46399,"_2665":46504},[],"In the default `tls.type: certManager` mode, cert-manager `Issuer` and CA `Certificate` resources and a chart-managed downstream `Certificate`; in the `tls.type: external` mode, a reference to your TLS Secret",{"_3170":372,"_28017":333,"_19412":46506,"_5":13306,"_25509":46399,"_2665":46507},[],"cert-manager only for the default `tls.type: certManager` mode; for trusted TLS, a trusted issuer or a populated TLS Secret",{"_3170":373,"_28017":333,"_19412":46509,"_5":13306,"_25509":46399,"_2665":46510},[],"Persistent application data",{"_3170":374,"_28017":333,"_19412":46512,"_5":13306,"_25509":46399,"_2665":46513},[],"PersistentVolumeClaims required by the default local KMS and VA storage",{"_3170":375,"_28017":333,"_19412":46515,"_5":13306,"_25509":46399,"_2665":46516},[],"A StorageClass, physical storage, backups and a shared/external backend when scaling requires one",{"_3170":376,"_28017":333,"_19412":46518,"_5":13306,"_25509":46399,"_2665":46519},[],"Optional integrations",{"_3170":377,"_28017":333,"_19412":46521,"_5":13306,"_25509":46399,"_2665":46522},[],"Configuration hooks for observability, AWS connectors and PKCS#11/HSM connectivity",{"_3170":378,"_28017":333,"_19412":46524,"_5":13306,"_25509":46399,"_2665":46525},[],"The observability backends, cloud credentials and production HSM or external key service",{"_3170":379,"_28017":333,"_19412":46527,"_5":13306,"_25509":46399,"_2665":46528},[],"The chart creates Lamassu's `Gateway` and routes. It does not install the Envoy Gateway controller or make the generated `LoadBalancer` Service reachable from your network.",{"_3170":380,"_28017":333,"_19412":46530,"_5":13306,"_25509":46399,"_2665":46531},[],"Use one Lamassu Gateway on ports 80 and 443 and let its HTTPRoutes dispatch traffic to every Lamassu service. Give that Gateway one externally reachable endpoint through the cluster load balancer, or forward traffic to it from an external proxy or NAT device. You do not need one Gateway per service.",{"_3170":381,"_28017":333,"_19412":46533,"_5":13306,"_25509":46403,"_2665":46534},[],"The chart creates one shared `Gateway` per Helm release. All chart-managed `HTTPRoute` resources attach to it. Envoy Gateway provisions the proxy data plane and a Kubernetes `LoadBalancer` Service for that Gateway.",{"_3170":382,"_28017":333,"_19412":46536,"_5":13306,"_25509":46403,"_2665":46537},[],"The `gateway.addresses` value is only an address request to the Gateway controller. It does not make an IP routable, open a firewall, configure DNS or create NAT. See Expose the Gateway before setting it.",{"_3170":383,"_28017":333,"_19412":46539,"_5":13306,"_25509":46407,"_2665":46540},[],"Kubernetes 1.24 or newer",{"_3170":384,"_28017":333,"_19412":46542,"_5":13306,"_25509":46407,"_2665":46543},[],"Helm 3.2 or newer",{"_3170":385,"_28017":333,"_19412":46545,"_5":13306,"_25509":46407,"_2665":46546},[],"Envoy Gateway 1.8 or newer and a `GatewayClass`",{"_3170":386,"_28017":333,"_19412":46548,"_5":13306,"_25509":46407,"_2665":46549},[],"cert-manager 1.14 or newer; required only for the default `tls.type: certManager` TLS mode, not for `tls.type: external`",{"_3170":387,"_28017":333,"_19412":46551,"_5":13306,"_25509":46407,"_2665":46552},[],"persistent storage suitable for the selected PostgreSQL, RabbitMQ, VA and KMS configuration",{"_3170":388,"_28017":333,"_19412":46554,"_5":13306,"_25509":46407,"_2665":46555},[],"a load-balancer implementation or another deliberate path from clients to the Gateway",{"_3170":389,"_28017":333,"_19412":46557,"_5":13306,"_25509":46407,"_2665":46558},[],"KMS deployments using the native PKCS#11 sidecar require Kubernetes 1.29 or newer. Prebuilt Lamassu container images are published for `linux/amd64` and `linux/arm64`, and the KMS PKCS#11 client module (`p11-kit-client.so`) is installed at the target architecture's Debian library path: `/usr/lib/x86_64-linux-gnu/pkcs11/p11-kit-client.so` on amd64 and `/usr/lib/aarch64-linux-gnu/pkcs11/p11-kit-client.so` on arm64. The x86\\_64 path is retained as a compatibility alias for existing configurations.",{"_3170":390,"_28017":333,"_19412":46560,"_5":13306,"_25509":46411,"_2665":46561},[],"<Card title=\"Install with Helm\" description=\"Prepare dependencies, configure values, install and verify a controlled deployment.\" href=\"/docs/deployment/self-hosted/helm\" />",{"_3170":391,"_28017":333,"_19412":46563,"_5":13306,"_25509":46411,"_2665":46564},[],"<Card title=\"Upgrade from 3.8.0\" description=\"Upgrade an existing Helm release to 4.0.0: architecture changes, breaking changes, migration steps and validation.\" href=\"/docs/upgrades/3-8-0-to-4-0-0\" />",{"_3170":392,"_28017":333,"_19412":46566,"_5":13306,"_25509":46411,"_2665":46567},[],"<Card title=\"Expose the Gateway\" description=\"Choose an external traffic design, understand gateway.addresses and handle multiple Gateways.\" href=\"/docs/deployment/self-hosted/networking\" />",{"_3170":393,"_28017":333,"_19412":46569,"_5":13306,"_25509":46411,"_2665":46570},[],"<Card title=\"Use Fastlane\" description=\"Bootstrap a complete evaluation or lab environment with one script.\" href=\"/docs/deployment/self-hosted/fastlane\" />",{"_3170":394,"_28017":394,"_5":13637,"_2665":46572,"_28339":46573,"_19412":46575,"_25509":394},"Deployment troubleshooting",[45393,45394,46574],"Operations",[],{"_3170":395,"_28017":394,"_19412":46577,"_5":13306,"_25509":394,"_2665":46578},[],"Diagnose access, service health and infrastructure dependencies.",{"_3170":396,"_28017":394,"_5":28336,"_19412":46580,"_25509":46581,"_2665":46582},[],"/docs/deployment/troubleshooting#diagnostic-sequence","Diagnostic sequence",{"_3170":397,"_28017":394,"_5":28336,"_19412":46584,"_25509":46585,"_2665":46586},[],"/docs/deployment/troubleshooting#reproduce-a-single-operation","Reproduce a single operation",{"_3170":398,"_28017":394,"_5":28336,"_19412":46588,"_25509":46589,"_2665":46590},[],"/docs/deployment/troubleshooting#separate-client-gateway-and-service","Separate client, Gateway and service",{"_3170":399,"_28017":394,"_5":28336,"_19412":46592,"_25509":46593,"_2665":46594},[],"/docs/deployment/troubleshooting#review-kubernetes-status","Review Kubernetes status",{"_3170":400,"_28017":394,"_5":28336,"_19412":46596,"_25509":46597,"_2665":46598},[],"/docs/deployment/troubleshooting#query-the-affected-service","Query the affected service",{"_3170":401,"_28017":394,"_5":28336,"_19412":46600,"_25509":46601,"_2665":46602},[],"/docs/deployment/troubleshooting#validate-the-result-from-outside","Validate the result from outside",{"_3170":402,"_28017":394,"_5":28336,"_19412":46604,"_25509":46605,"_2665":46606},[],"/docs/deployment/troubleshooting#minimal-evidence-collection","Minimal evidence collection",{"_3170":403,"_28017":394,"_5":28336,"_19412":46608,"_25509":46609,"_2665":46610},[],"/docs/deployment/troubleshooting#i-cannot-sign-in","I cannot sign in",{"_3170":404,"_28017":394,"_5":28336,"_19412":46612,"_25509":46613,"_2665":46614},[],"/docs/deployment/troubleshooting#everything-returns-403-or-5xx","Everything returns 403 or 5xx",{"_3170":405,"_28017":394,"_5":28336,"_19412":46616,"_25509":46617,"_2665":46618},[],"/docs/deployment/troubleshooting#a-pod-is-not-ready","A pod is not Ready",{"_3170":406,"_28017":394,"_5":28336,"_19412":46620,"_25509":46621,"_2665":46622},[],"/docs/deployment/troubleshooting#events-are-not-arriving","Events are not arriving",{"_3170":407,"_28017":394,"_5":28336,"_19412":46624,"_25509":46625,"_2665":46626},[],"/docs/deployment/troubleshooting#observability","Observability",{"_3170":408,"_28017":394,"_19412":46628,"_5":13306,"_25509":394,"_2665":46629},[],"Start by locating the failing layer. A Gateway response and an unready pod require different evidence. For rejected issuance or validation results, see PKI troubleshooting; for enrollment, see EST diagnostics.",{"_3170":409,"_28017":394,"_19412":46631,"_5":13306,"_25509":46585,"_2665":46632},[],"Note the time in UTC, user or principal, resource, endpoint and result. Avoid repeating a destructive action such as revocation or deletion.",{"_3170":410,"_28017":394,"_19412":46634,"_5":13306,"_25509":46589,"_2665":46635},[],"Check the HTTP status. A 401 points to authentication; a 403, to authorization; a 404, to route or resource; a 5xx, to the service or a dependency.",{"_3170":411,"_28017":394,"_19412":46637,"_5":13306,"_25509":46593,"_2665":46638},[],"Locate unready pods, restarts, recent events and the state of the release.",{"_3170":412,"_28017":394,"_19412":46640,"_5":13306,"_25509":46597,"_2665":46641},[],"Review its /health endpoint and its logs in the same time window. Then follow the indicated dependency: PostgreSQL, RabbitMQ, the OIDC provider or the cryptographic engine.",{"_3170":413,"_28017":394,"_19412":46643,"_5":13306,"_25509":46601,"_2665":46644},[],"For PKI, check the certificate, the chain, OCSP or CRL with the same type of client production uses.",{"_3170":414,"_28017":394,"_19412":46646,"_5":13306,"_25509":46605,"_2665":46647},[],"Replace the placeholders with your real release, namespace and deployment.",{"_3170":415,"_28017":394,"_19412":46649,"_5":13306,"_25509":46605,"_2665":46650},[],"Also run the chart's connectivity test:",{"_3170":416,"_28017":394,"_19412":46652,"_5":13306,"_25509":46605,"_2665":46653},[],"The test checks the health of CA, DMS Manager, Device Manager and VA, and verifies that the UI returns HTML. A passing test confirms basic connectivity, not a full issuance flow.",{"_3170":417,"_28017":394,"_19412":46655,"_5":13306,"_25509":46605,"_2665":46656},[],"The chart's services expose startup, readiness and liveness probes over /health. A pod can be running but receive no traffic if the readiness probe fails.",{"_3170":418,"_28017":394,"_19412":46658,"_5":13306,"_25509":46609,"_2665":46659},[],"If you receive a 401:",{"_3170":419,"_28017":394,"_19412":46661,"_5":13306,"_25509":46609,"_2665":46662},[],"check that the UI's OIDC authority is reachable from the browser;",{"_3170":420,"_28017":394,"_19412":46664,"_5":13306,"_25509":46609,"_2665":46665},[],"verify issuer, audience and expiration of the token;",{"_3170":421,"_28017":394,"_19412":46667,"_5":13306,"_25509":46609,"_2665":46668},[],"confirm the Gateway can fetch the keys from the JWKS URI;",{"_3170":422,"_28017":394,"_19412":46670,"_5":13306,"_25509":46609,"_2665":46671},[],"check that the provider's public and internal routes point to the same realm.",{"_3170":423,"_28017":394,"_19412":46673,"_5":13306,"_25509":46609,"_2665":46674},[],"If login succeeds but the APIs return 403:",{"_3170":424,"_28017":394,"_19412":46676,"_5":13306,"_25509":46609,"_2665":46677},[],"inspect the token's real claims;",{"_3170":425,"_28017":394,"_19412":46679,"_5":13306,"_25509":46609,"_2665":46680},[],"confirm they match an active principal;",{"_3170":426,"_28017":394,"_19412":46682,"_5":13306,"_25509":46609,"_2665":46683},[],"review the policies granted to that principal;",{"_3170":427,"_28017":394,"_19412":46685,"_5":13306,"_25509":46609,"_2665":46686},[],"verify that authz reaches PostgreSQL and its JWKS.",{"_3170":428,"_28017":394,"_19412":46688,"_5":13306,"_25509":46609,"_2665":46689},[],"On a fresh installation, confirm the migration Job finished. That Job creates schemas, migrates authz, preloads policies and provisions the principals defined in services.authz.bootstrap.",{"_3170":429,"_28017":394,"_19412":46691,"_5":13306,"_25509":46613,"_2665":46692},[],"External authorization fails closed by default. If authz is unavailable, protected routes are blocked.",{"_3170":430,"_28017":394,"_19412":46694,"_5":13306,"_25509":46613,"_2665":46695},[],"Locate the authz pod and Service.",{"_3170":431,"_28017":394,"_19412":46697,"_5":13306,"_25509":46613,"_2665":46698},[],"Check /health, logs and its database connection.",{"_3170":432,"_28017":394,"_19412":46700,"_5":13306,"_25509":46613,"_2665":46701},[],"Verify the DNS and port configured in externalAuthorization.",{"_3170":433,"_28017":394,"_19412":46703,"_5":13306,"_25509":46613,"_2665":46704},[],"Check the check route is /v1/ext\\_authz/check.",{"_3170":434,"_28017":394,"_19412":46706,"_5":13306,"_25509":46613,"_2665":46707},[],"Do not switch to failOpen: true as a permanent workaround: it would allow traffic without authorization during the outage.",{"_3170":435,"_28017":394,"_19412":46709,"_5":13306,"_25509":46617,"_2665":46710},[],"Review kubectl describe pod first. Common causes are:",{"_3170":436,"_28017":394,"_19412":46712,"_5":13306,"_25509":46617,"_2665":46713},[],"wrong credentials or DNS for PostgreSQL or RabbitMQ;",{"_3170":437,"_28017":394,"_19412":46715,"_5":13306,"_25509":46617,"_2665":46716},[],"unbound persistent volume;",{"_3170":438,"_28017":394,"_19412":46718,"_5":13306,"_25509":46617,"_2665":46719},[],"inaccessible image or incorrect pull policy;",{"_3170":439,"_28017":394,"_19412":46721,"_5":13306,"_25509":46617,"_2665":46722},[],"invalid cryptographic engine configuration;",{"_3170":440,"_28017":394,"_19412":46724,"_5":13306,"_25509":46617,"_2665":46725},[],"CPU or memory limits set too low;",{"_3170":441,"_28017":394,"_19412":46727,"_5":13306,"_25509":46617,"_2665":46728},[],"an incomplete prior migration.",{"_3170":442,"_28017":394,"_19412":46730,"_5":13306,"_25509":46617,"_2665":46731},[],"Generic values request 100 mCPU and 128 MiB and limit to 500 mCPU and 512 MiB. Tune per service when you see OOMKills, throttling or slow startups.",{"_3170":443,"_28017":394,"_19412":46733,"_5":13306,"_25509":46617,"_2665":46734},[],"Filesystem-based KMS engines and VA local storage use exclusive-access volumes. Keep a single replica or migrate to shared backends before enabling autoscaling.",{"_3170":444,"_28017":394,"_19412":46736,"_5":13306,"_25509":46617,"_2665":46737},[],"Internal calls now fail fast instead of hanging for the clients covered by Egress proxy: connection attempts time out after 30 seconds and TLS handshakes after 10 seconds. The authorization-engine connector keeps its own transport without these dial and handshake timeouts; only its overall 30-second request timeout bounds each call. If an egress proxy handles the cluster's outbound traffic, check the pod's `HTTP_PROXY`, `HTTPS_PROXY` and `NO_PROXY` environment variables and list in-cluster service names in `NO_PROXY`.",{"_3170":445,"_28017":394,"_19412":46739,"_5":13306,"_25509":46621,"_2665":46740},[],"Domain and audit events depend on the bus publisher:",{"_3170":446,"_28017":394,"_19412":46742,"_5":13306,"_25509":46621,"_2665":46743},[],"verify it is enabled in the emitting service;",{"_3170":447,"_28017":394,"_19412":46745,"_5":13306,"_25509":46621,"_2665":46746},[],"check AMQP connectivity and credentials;",{"_3170":448,"_28017":394,"_19412":46748,"_5":13306,"_25509":46621,"_2665":46749},[],"review exchange, routing key, queues and consumers;",{"_3170":449,"_28017":394,"_19412":46751,"_5":13306,"_25509":46621,"_2665":46752},[],"inspect dead-letter queues;",{"_3170":450,"_28017":394,"_19412":46754,"_5":13306,"_25509":46621,"_2665":46755},[],"alert on orphan durable queues and backlog growth.",{"_3170":451,"_28017":394,"_19412":46757,"_5":13306,"_25509":46621,"_2665":46758},[],"A consumer outage does not always prevent the main operation from completing. That is why you must monitor RabbitMQ and independently verify the persistence of audit logs.",{"_3170":452,"_28017":394,"_19412":46760,"_5":13306,"_25509":46625,"_2665":46761},[],"The chart can enable OpenTelemetry instrumentation. Traces are exported over OTLP HTTP and logs can be directed to a compatible endpoint, such as VictoriaLogs. Use a correlation identifier and the same time window to join Gateway, authz, service and dependency.",{"_3170":453,"_28017":394,"_19412":46763,"_5":13306,"_25509":46625,"_2665":46764},[],"Before closing an incident, record:",{"_3170":454,"_28017":394,"_19412":46766,"_5":13306,"_25509":46625,"_2665":46767},[],"the confirmed cause;",{"_3170":455,"_28017":394,"_19412":46769,"_5":13306,"_25509":46625,"_2665":46770},[],"the time scope and affected resources;",{"_3170":456,"_28017":394,"_19412":46772,"_5":13306,"_25509":46625,"_2665":46773},[],"the commands or queries used;",{"_3170":457,"_28017":394,"_19412":46775,"_5":13306,"_25509":46625,"_2665":46776},[],"the applied change and how to revert it;",{"_3170":458,"_28017":394,"_19412":46778,"_5":13306,"_25509":46625,"_2665":46779},[],"validation from a consumer;",{"_3170":459,"_28017":394,"_19412":46781,"_5":13306,"_25509":46625,"_2665":46782},[],"the preventive action and its owner.",{"_3170":460,"_28017":460,"_5":13637,"_2665":46784,"_28339":46785,"_19412":46788,"_25509":460},"Access control",[45393,46786,46787],"Platform","Administration",[],{"_3170":461,"_28017":460,"_19412":46790,"_5":13306,"_25509":460,"_2665":46791},[],"Design who can access Lamassu through principals, policies, resource permissions and HTTP route authorization.",{"_3170":462,"_28017":460,"_5":28336,"_19412":46793,"_25509":46794,"_2665":46795},[],"/docs/platform/administration/access-control#essential-concepts","Essential concepts",{"_3170":463,"_28017":460,"_5":28336,"_19412":46797,"_25509":46798,"_2665":46799},[],"/docs/platform/administration/access-control#two-decision-systems","Two decision systems",{"_3170":464,"_28017":460,"_5":28336,"_19412":46801,"_25509":46802,"_2665":46803},[],"/docs/platform/administration/access-control#integrated-or-external-http-services","Integrated or external HTTP services",{"_3170":465,"_28017":460,"_5":28336,"_19412":46805,"_25509":46806,"_2665":46807},[],"/docs/platform/administration/access-control#authentication-only-routes-and-unmapped-paths","Authentication-only routes and unmapped paths",{"_3170":466,"_28017":460,"_5":28336,"_19412":46809,"_25509":46810,"_2665":46811},[],"/docs/platform/administration/access-control#services-developed-by-lamassu","Services developed by Lamassu",{"_3170":467,"_28017":460,"_5":28336,"_19412":46813,"_25509":46814,"_2665":46815},[],"/docs/platform/administration/access-control#how-the-two-paths-relate","How the two paths relate",{"_3170":468,"_28017":460,"_5":28336,"_19412":46817,"_25509":46818,"_2665":46819},[],"/docs/platform/administration/access-control#oidc-principals","OIDC principals",{"_3170":469,"_28017":460,"_5":28336,"_19412":46821,"_25509":46822,"_2665":46823},[],"/docs/platform/administration/access-control#x509-principals","X.509 principals",{"_3170":470,"_28017":460,"_5":28336,"_19412":46825,"_25509":46826,"_2665":46827},[],"/docs/platform/administration/access-control#when-several-principals-match","When several principals match",{"_3170":471,"_28017":460,"_5":28336,"_19412":46829,"_25509":46830,"_2665":46831},[],"/docs/platform/administration/access-control#how-policies-express-access","How policies express access",{"_3170":472,"_28017":460,"_5":28336,"_19412":46833,"_25509":46834,"_2665":46835},[],"/docs/platform/administration/access-control#global-and-direct-access","Global and direct access",{"_3170":473,"_28017":460,"_5":28336,"_19412":46837,"_25509":46838,"_2665":46839},[],"/docs/platform/administration/access-control#access-inherited-through-relations","Access inherited through relations",{"_3170":474,"_28017":460,"_5":28336,"_19412":46841,"_25509":46842,"_2665":46843},[],"/docs/platform/administration/access-control#attribute-filtered-access","Attribute-filtered access",{"_3170":475,"_28017":460,"_5":28336,"_19412":46845,"_25509":46846,"_2665":46847},[],"/docs/platform/administration/access-control#http-rules","HTTP rules",{"_3170":476,"_28017":460,"_5":28336,"_19412":46849,"_25509":46850,"_2665":46851},[],"/docs/platform/administration/access-control#included-policies","Included policies",{"_3170":477,"_28017":460,"_5":28336,"_19412":46853,"_25509":46854,"_2665":46029},[],"/docs/platform/administration/access-control#provision-the-first-administrator",{"_3170":478,"_28017":460,"_5":28336,"_19412":46856,"_25509":46857,"_2665":46858},[],"/docs/platform/administration/access-control#prepare-the-identity-provider","Prepare the identity provider",{"_3170":479,"_28017":460,"_5":28336,"_19412":46860,"_25509":46861,"_2665":46862},[],"/docs/platform/administration/access-control#configure-token-validation","Configure token validation",{"_3170":480,"_28017":460,"_5":28336,"_19412":46864,"_25509":46865,"_2665":46866},[],"/docs/platform/administration/access-control#install-and-verify-administrative-access","Install and verify administrative access",{"_3170":481,"_28017":460,"_5":28336,"_19412":46868,"_25509":46869,"_2665":46870},[],"/docs/platform/administration/access-control#test-an-unprivileged-identity","Test an unprivileged identity",{"_3170":482,"_28017":460,"_5":28336,"_19412":46872,"_25509":46873,"_2665":46874},[],"/docs/platform/administration/access-control#reduce-use-of-the-bootstrap-administrator","Reduce use of the bootstrap administrator",{"_3170":483,"_28017":460,"_5":28336,"_19412":46876,"_25509":46877,"_2665":46878},[],"/docs/platform/administration/access-control#fastlane-bootstrap","Fastlane bootstrap",{"_3170":484,"_28017":460,"_5":28336,"_19412":46880,"_25509":46881,"_2665":46882},[],"/docs/platform/administration/access-control#design-least-privilege-roles","Design least-privilege roles",{"_3170":485,"_28017":460,"_5":28336,"_19412":46884,"_25509":46885,"_2665":46886},[],"/docs/platform/administration/access-control#changes-and-access-revocation","Changes and access revocation",{"_3170":486,"_28017":460,"_5":28336,"_19412":46888,"_25509":46889,"_2665":46890},[],"/docs/platform/administration/access-control#operational-checklist","Operational checklist",{"_3170":487,"_28017":460,"_5":28336,"_19412":46892,"_25509":46893,"_2665":46894},[],"/docs/platform/administration/access-control#diagnostics","Diagnostics",{"_3170":488,"_28017":460,"_5":28336,"_19412":46896,"_25509":46897,"_2665":46898},[],"/docs/platform/administration/access-control#the-response-is-401","The response is 401",{"_3170":489,"_28017":460,"_5":28336,"_19412":46900,"_25509":46901,"_2665":46902},[],"/docs/platform/administration/access-control#the-response-is-403","The response is 403",{"_3170":490,"_28017":460,"_5":28336,"_19412":46904,"_25509":46905,"_2665":46906},[],"/docs/platform/administration/access-control#everything-returns-403","Everything returns 403",{"_3170":491,"_28017":460,"_5":28336,"_19412":46908,"_25509":46909,"_2665":46910},[],"/docs/platform/administration/access-control#access-appears-without-a-policy-grant","Access appears without a policy grant",{"_3170":492,"_28017":460,"_5":28336,"_19412":46912,"_25509":46913,"_2665":46914},[],"/docs/platform/administration/access-control#everything-fails-when-authz-is-unavailable","Everything fails when authz is unavailable",{"_3170":493,"_28017":460,"_19412":46916,"_5":13306,"_25509":460,"_2665":46917},[],"Lamassu access control turns an authenticated identity into concrete permissions. The OIDC provider or the client certificate proves **who** makes a request; the `authz` service decides **what that identity can do** and **over which resources**.",{"_3170":494,"_28017":460,"_19412":46919,"_5":13306,"_25509":460,"_2665":46920},[],"Lamassu does not assign permissions directly to users. The full chain is:",{"_3170":495,"_28017":460,"_19412":46922,"_5":13306,"_25509":460,"_2665":46923},[],"This model lets you represent people, identity-provider groups, service accounts and devices without coupling authorization to a specific provider.",{"_3170":496,"_28017":460,"_19412":46925,"_5":13306,"_25509":46794,"_2665":46926},[],"A **principal** connects a credential to Lamassu. It defines how to recognize an OIDC or X.509 identity and can be active or disabled.",{"_3170":497,"_28017":460,"_19412":46928,"_5":13306,"_25509":46794,"_2665":46929},[],"A **policy** groups reusable permissions. It can be granted to several principals and can contain rules about Lamassu entities, rules about HTTP routes or both.",{"_3170":498,"_28017":460,"_19412":46931,"_5":13306,"_25509":46794,"_2665":46932},[],"An **entity rule** grants actions over resources such as certification authorities, certificates, issuance profiles, devices, DMSs, keys or alert subscriptions. It can cover all resources of a type or be limited by identifier, relation or attribute.",{"_3170":499,"_28017":460,"_19412":46934,"_5":13306,"_25509":46794,"_2665":46935},[],"An **HTTP rule** grants actions associated with API routes. It is the mechanism the Gateway uses to decide whether a request may cross the perimeter.",{"_3170":500,"_28017":460,"_19412":46937,"_5":13306,"_25509":46794,"_2665":46938},[],"A **grant** is the association between a principal and a policy. Removing the grant removes all permissions contributed by that policy, without modifying it for other principals.",{"_3170":501,"_28017":460,"_19412":46940,"_5":13306,"_25509":46794,"_2665":46941},[],"A valid JWT or a valid client certificate does not grant access by itself. The credential must match at least one active principal and, unless the HTTP schema exempts the route, one of its policies must allow the requested operation. See *Authentication-only routes and unmapped paths* for those exemptions.",{"_3170":502,"_28017":460,"_19412":46943,"_5":13306,"_25509":46798,"_2665":46944},[],"Lamassu uses two authorization paths depending on who implements the protected service. They share principals, policies and grants, but they do not interpret the rules the same way.",{"_3170":503,"_28017":460,"_19412":46946,"_5":13306,"_25509":46798,"_2665":46947},[],"An external service can be protected without knowing Lamassu's internal authorization model. A service developed by Lamassu embeds the authorization engine and can decide on concrete resources and filter its queries.",{"_3170":504,"_28017":460,"_19412":46949,"_5":13306,"_25509":46802,"_2665":46950},[],"This path protects APIs that join the platform through the Gateway but do not natively implement Lamassu's authorization SDK. Job Manager is the current example. The same pattern allows integrating other HTTP services as long as their routes are described in an `authz` HTTP schema.",{"_3170":505,"_28017":460,"_19412":46952,"_5":13306,"_25509":46802,"_2665":46953},[],"The decision is made **before forwarding the request to the service**:",{"_3170":506,"_28017":460,"_19412":46955,"_5":13306,"_25509":46802,"_2665":46956},[],"Envoy Gateway authenticates the request, usually validating a JWT against the OIDC provider's JWKS.",{"_3170":507,"_28017":460,"_19412":46958,"_5":13306,"_25509":46802,"_2665":46959},[],"For a protected route, Envoy sends the method, URL, headers and required data to `/v1/ext_authz/check`.",{"_3170":508,"_28017":460,"_19412":46961,"_5":13306,"_25509":46802,"_2665":46962},[],"`authz` extracts the credential and resolves all active principals matching it.",{"_3170":509,"_28017":460,"_19412":46964,"_5":13306,"_25509":46802,"_2665":46965},[],"It separately loads the policies granted to each principal.",{"_3170":510,"_28017":460,"_19412":46967,"_5":13306,"_25509":46802,"_2665":46968},[],"The HTTP schema translates the method and route combination into a logical action, such as `nbi-job-read` or `nbi-workflow-create`.",{"_3170":511,"_28017":460,"_19412":46970,"_5":13306,"_25509":46802,"_2665":46971},[],"`authz` looks for an HTTP rule granting that action.",{"_3170":512,"_28017":460,"_19412":46973,"_5":13306,"_25509":46802,"_2665":46974},[],"If the route declares constraints, it compares request data with the normalized attributes of the same principal contributing the policy; the policy's own `param_constraints` also pin the granted action to literal request values.",{"_3170":513,"_28017":460,"_19412":46976,"_5":13306,"_25509":46802,"_2665":46977},[],"A satisfying result lets Envoy forward the request; any other response blocks it at the Gateway.",{"_3170":514,"_28017":460,"_19412":46979,"_5":13306,"_25509":46802,"_2665":46980},[],"When it allows access, `authz` returns the selected principal in the `X-Principal-ID` response header. The Gateway can propagate that header to the service to preserve the identity context.",{"_3170":515,"_28017":460,"_19412":46982,"_5":13306,"_25509":46802,"_2665":46983},[],"HTTP rules primarily answer &#x2A;*\"can this identity call this API operation?\"**. On their own they do not produce filters over the external service's database. To limit a route to a specific device, tenant or client, either the schema declares a constraint relating a request value to a normalized attribute of the principal, or the policy pins the request value to a literal with `param_constraints`. The first scopes each identity to its own resources through a single grant; the second restricts a grant to a fixed value regardless of who holds it.",{"_3170":516,"_28017":460,"_19412":46985,"_5":13306,"_25509":46806,"_2665":46986},[],"Two schema-level settings cover endpoints that policies do not mention:",{"_3170":517,"_28017":460,"_19412":46988,"_5":13306,"_25509":46806,"_2665":46989},[],"**`skip_authz: true` on a route** allows any identity that matches an active principal to reach it, even one with no granted policies. Use it for paths such as `/openapi.json` or `/health` that every authenticated caller should be able to access. The request still has to authenticate successfully: a credential that fails validation or matches no active principal is rejected before this setting is considered. A `skip_authz` route cannot declare constraints, and it wins over any other schema's route or default action for the same request.",{"_3170":518,"_28017":460,"_19412":46991,"_5":13306,"_25509":46806,"_2665":46992},[],"**`default_action` with `base_paths`** decides what happens when a request falls under a path prefix the schema owns but no explicit route matches. `deny` — the value the Job Manager schema ships with — turns the implicit denial of unmapped paths into an explicit, auditable statement; `allow` opens unmapped endpoints under that prefix to any identity that matches an active principal.",{"_3170":519,"_28017":460,"_19412":46994,"_5":13306,"_25509":46806,"_2665":46995},[],"These are decisions of the schema, not of a policy: `skip_authz` removes the grant check for that route, even when another schema maps the same request to an action that requires a grant, and `default_action` only covers requests that no explicit route in any schema matches. Keep three rules in mind:",{"_3170":520,"_28017":460,"_19412":46997,"_5":13306,"_25509":46806,"_2665":46998},[],"`default_action` requires at least one `base_paths` entry, and base paths are absolute paths such as `/api/wfx/nbi/v1`.",{"_3170":521,"_28017":460,"_19412":47000,"_5":13306,"_25509":46806,"_2665":47001},[],"An explicit route in any schema takes precedence: the fallback only decides requests that no schema's routes cover. When the prefixes of two schemas overlap, the longest matching prefix decides.",{"_3170":522,"_28017":460,"_19412":47003,"_5":13306,"_25509":46806,"_2665":47004},[],"Two schemas cannot claim the same base path with different default actions; the conflicting schema fails to load.",{"_3170":523,"_28017":460,"_19412":47006,"_5":13306,"_25509":46806,"_2665":47007},[],"A `skip_authz` route and a `default_action: \"allow\"` prefix grant access without consulting any policy. Every identity that matches an active principal can reach what they open, including identities with no granted policies. A `skip_authz` route in one schema also opens a request that another schema maps to a grant-protected action. Review these settings whenever you add or upgrade an integrated service.",{"_3170":524,"_28017":460,"_19412":47009,"_5":13306,"_25509":46810,"_2665":47010},[],"Lamassu's native services embed authorization in their middleware and know the entities they operate on: certificates, CAs, issuance profiles, keys, devices, DMSs or subscriptions, among others.",{"_3170":525,"_28017":460,"_19412":47012,"_5":13306,"_25509":46810,"_2665":47013},[],"The decision is made with the domain operation context:",{"_3170":526,"_28017":460,"_19412":47015,"_5":13306,"_25509":46810,"_2665":47016},[],"The middleware extracts the credential and resolves the matching principals.",{"_3170":527,"_28017":460,"_19412":47018,"_5":13306,"_25509":46810,"_2665":47019},[],"The endpoint identifies the action, the entity type and, when applicable, the key of the requested resource.",{"_3170":528,"_28017":460,"_19412":47021,"_5":13306,"_25509":46810,"_2665":47022},[],"`authz` gathers the entity rules of the granted policies.",{"_3170":529,"_28017":460,"_19412":47024,"_5":13306,"_25509":46810,"_2665":47025},[],"The engine evaluates direct grants, attribute filters and relations with other entities.",{"_3170":530,"_28017":460,"_19412":47027,"_5":13306,"_25509":46810,"_2665":47028},[],"For an individual operation, it checks that the concrete resource satisfies the computed scope.",{"_3170":531,"_28017":460,"_19412":47030,"_5":13306,"_25509":46810,"_2665":47031},[],"For a listing, it generates a SQL filter that the service adds to its own query.",{"_3170":532,"_28017":460,"_19412":47033,"_5":13306,"_25509":46810,"_2665":47034},[],"Here the engine answers &#x2A;*\"can this identity perform this action on this concrete resource?\"**.",{"_3170":533,"_28017":460,"_19412":47036,"_5":13306,"_25509":46810,"_2665":47037},[],"Actions fall into two groups:",{"_3170":534,"_28017":460,"_19412":47039,"_5":13306,"_25509":46810,"_2665":47040},[],"**Global actions** do not need a resource identifier. `create`, `import` or access to a console section are common examples.",{"_3170":535,"_28017":460,"_19412":47042,"_5":13306,"_25509":46810,"_2665":47043},[],"**Atomic actions** are evaluated on a concrete instance. For certificates these include `read`, `metadata-update`, `status-update` and `delete`; for a CA there are also `sign`, `reissue` and other lifecycle operations.",{"_3170":536,"_28017":460,"_19412":47045,"_5":13306,"_25509":46810,"_2665":47046},[],"Filtering inside the service prevents leaks in listings: unauthorized resources are excluded from the SQL query instead of being fetched and hidden later in the interface.",{"_3170":537,"_28017":460,"_19412":47048,"_5":13306,"_25509":46814,"_2665":47049},[],"They are not two equivalent controls applied twice. HTTP rules protect the perimeter of an integrated service; entity rules express permissions over the data model of the native services.",{"_3170":538,"_28017":460,"_19412":47051,"_5":13306,"_25509":46814,"_2665":47052},[],"A policy can contain both rule types when an identity needs to operate Lamassu resources and also call an integrated API. Granting an entity rule does not automatically grant an HTTP action, nor does an HTTP rule create access over an entity.",{"_3170":539,"_28017":460,"_19412":47054,"_5":13306,"_25509":46814,"_2665":47055},[],"If no combination of principal, policy and rule allows the operation, Lamassu denies it, unless the HTTP schema declares `skip_authz` on the route or `default_action: allow` on a base path that covers it (see *Authentication-only routes and unmapped paths*). Additionally, `auth.externalAuthorization.failOpen` is `false` by default: if `authz` is unavailable, the Gateway blocks protected routes.",{"_3170":540,"_28017":460,"_19412":47057,"_5":13306,"_25509":46818,"_2665":47058},[],"An OIDC principal matches the claims of a validated JWT. It is appropriate for human users, corporate groups, IdP roles and service accounts that obtain tokens.",{"_3170":541,"_28017":460,"_19412":47060,"_5":13306,"_25509":46818,"_2665":47061},[],"The following principal represents any identity holding the `pki-operators` role in Keycloak:",{"_3170":542,"_28017":460,"_19412":47063,"_5":13306,"_25509":46818,"_2665":47064},[],"Claim paths can be nested, such as `realm_access.roles`. Within a single principal, **all** conditions must hold. This lets you require, for example, a group and an organizational audience at the same time.",{"_3170":543,"_28017":460,"_19412":47066,"_5":13306,"_25509":46818,"_2665":47067},[],"The implemented operators are:",{"_3170":544,"_28017":460,"_19412":47069,"_5":13306,"_25509":46818,"_2665":47070},[],"`equals`, for exact equality;",{"_3170":545,"_28017":460,"_19412":47072,"_5":13306,"_25509":46818,"_2665":47073},[],"`contains`, to check membership in a list or the presence of text in a scalar value.",{"_3170":546,"_28017":460,"_19412":47075,"_5":13306,"_25509":46818,"_2665":47076},[],"Design matching with stable attributes. For people, it is usually better to bind permissions to centrally managed groups or roles than to the email or username. For a service account, a stable `sub` keeps its permissions from mixing with a human operator's.",{"_3170":547,"_28017":460,"_19412":47078,"_5":13306,"_25509":46818,"_2665":47079},[],"Although the model recognizes the operator name `matches`, the current implementation does not evaluate regular expressions and the condition never matches. Use `equals` or `contains`.",{"_3170":548,"_28017":460,"_19412":47081,"_5":13306,"_25509":46822,"_2665":47082},[],"An X.509 principal lets you recognize a workload or a device by its client certificate. Lamassu checks the certificate signature against the configured CA and, depending on the mode, also its serial number or Common Name.",{"_3170":549,"_28017":460,"_19412":47084,"_5":13306,"_25509":46822,"_2665":47085},[],"The available modes are:",{"_3170":550,"_28017":460,"_19412":47087,"_5":13306,"_25509":46822,"_2665":47088},[],"`serial_and_ca`: an exact certificate, identified by serial number and CA;",{"_3170":551,"_28017":460,"_19412":47090,"_5":13306,"_25509":46822,"_2665":47091},[],"`cn_and_ca`: an exact or wildcard Common Name and a specific CA;",{"_3170":552,"_28017":460,"_19412":47093,"_5":13306,"_25509":46822,"_2665":47094},[],"`any_from_ca`: any certificate issued directly by the given CA.",{"_3170":553,"_28017":460,"_19412":47096,"_5":13306,"_25509":46822,"_2665":47097},[],"This example recognizes certificates whose CN starts with `factory-a-` and that are signed by the configured CA:",{"_3170":554,"_28017":460,"_19412":47099,"_5":13306,"_25509":46822,"_2665":47100},[],"`ca_trust.identity_type` accepts `fingerprint` or `authority_key_id`. In both cases you must provide the CA certificate in `ca_trust.pem`; Lamassu verifies both the signature and the expected identity of the CA.",{"_3170":555,"_28017":460,"_19412":47102,"_5":13306,"_25509":46822,"_2665":47103},[],"Use `any_from_ca` only when every identity issued by that CA should share the same permissions. If a CA issues certificates for different populations, separate access by serial or CN, or use different issuing CAs.",{"_3170":556,"_28017":460,"_19412":47105,"_5":13306,"_25509":46826,"_2665":47106},[],"A single credential can match more than one principal. It is common for a user to match a principal of their team and another of their operational function.",{"_3170":557,"_28017":460,"_19412":47108,"_5":13306,"_25509":46826,"_2665":47109},[],"For entity permissions, Lamassu combines permissions with OR logic: it is enough that one policy of one of the principals allows the action. Listings contain the union of the resources visible to all of them.",{"_3170":558,"_28017":460,"_19412":47111,"_5":13306,"_25509":46826,"_2665":47112},[],"HTTP routes with constraints are stricter. The same principal contributing the policy must also satisfy the attributes required by the route. Lamassu does not combine one principal's policy with an attribute belonging to another.",{"_3170":559,"_28017":460,"_19412":47114,"_5":13306,"_25509":46826,"_2665":47115},[],"For this reason, adding a matching principal can only broaden access. Before creating overlapping rules, review the full set of policies a real identity will receive.",{"_3170":560,"_28017":460,"_19412":47117,"_5":13306,"_25509":46834,"_2665":47118},[],"A rule identifies the domain (`namespace`), the data schema (`schema_name`) and the entity type (`entity_type`). `actions` lists the allowed operations.",{"_3170":561,"_28017":460,"_19412":47120,"_5":13306,"_25509":46834,"_2665":47121},[],"`direct_grants` limits the rule to concrete identifiers. The value `*` covers all instances of the type. A superadministrator policy uses wildcards in schema, entity, actions and grants; a least-privilege policy should avoid them whenever possible.",{"_3170":562,"_28017":460,"_19412":47123,"_5":13306,"_25509":46838,"_2665":47124},[],"Rules can follow relations declared between entities. For example, the schema knows the relation of a certificate to its issuing CA and of a device to its DMS. A policy can grant access to a parent resource and propagate selected actions to its related resources.",{"_3170":563,"_28017":460,"_19412":47126,"_5":13306,"_25509":46838,"_2665":47127},[],"This lets you express models like \"can operate the devices of this DMS\" without maintaining an individual list of every device. When a resource is added under that relation, it inherits the scope planned by the policy.",{"_3170":564,"_28017":460,"_19412":47129,"_5":13306,"_25509":46842,"_2665":47130},[],"`column_filters` applies conditions to columns the schema has declared filterable. All filters of the same rule are combined with AND.",{"_3170":565,"_28017":460,"_19412":47132,"_5":13306,"_25509":46842,"_2665":47133},[],"For example, this rule allows reading active certificates issued by a specific CA:",{"_3170":566,"_28017":460,"_19412":47135,"_5":13306,"_25509":46842,"_2665":47136},[],"The available operators are `eq`, `neq`, `gt`, `gte`, `lt`, `lte`, `in` and `like`. Use comparisons consistent with the column type: `like` for text, ordering comparisons for numbers or dates and `in` when there is a collection of accepted values.",{"_3170":567,"_28017":460,"_19412":47138,"_5":13306,"_25509":46846,"_2665":47139},[],"HTTP rules do not point directly at tables. They reference a route schema and grant its logical actions. Job Manager's policies are an example: they distinguish reading, creating, updating and deleting workflows or jobs.",{"_3170":568,"_28017":460,"_19412":47141,"_5":13306,"_25509":46846,"_2665":47142},[],"Some routes also compare a request value — taken from the path, query, header or JSON body — with a normalized attribute of the principal. This way you can verify that a device only queries jobs addressed to its own `client_id`.",{"_3170":569,"_28017":460,"_19412":47144,"_5":13306,"_25509":46846,"_2665":47145},[],"Normalized attributes decouple the policy from the authentication mechanism. `subject_attribute_mappings` can derive, for example, `device_id` from `oidc.claim.device_id` or from `x509.subject.cn`. The rule consumes `device_id` in both cases.",{"_3170":570,"_28017":460,"_19412":47147,"_5":13306,"_25509":46846,"_2665":47148},[],"An HTTP rule can also pin a granted action to a literal value carried by the request itself through `param_constraints`. It extracts the value with the same sources as route constraints — `path_regex_group`, `query`, `header` or `json_body` — but compares it against an `equals` literal written into the policy rather than against a subject attribute. The grant then depends only on the request, not on who holds the policy:",{"_3170":571,"_28017":460,"_19412":47150,"_5":13306,"_25509":46846,"_2665":47151},[],"Combined with a schema route such as `^/api/mysvc/system/([^/]+)/info$`, this grants `GET /api/mysvc/system/1/info` and denies the same call for system `2`, regardless of the principal's attributes. The same mechanism pins query parameters, headers or JSON body fields, for example `{ \"source\": \"query\", \"name\": \"tenant_id\" }` with `\"equals\": \"1\"` to accept only requests carrying `?tenant_id=1`.",{"_3170":572,"_28017":460,"_19412":47153,"_5":13306,"_25509":46846,"_2665":47154},[],"Note that:",{"_3170":573,"_28017":460,"_19412":47156,"_5":13306,"_25509":46846,"_2665":47157},[],"`action` must be one of the actions granted by the rule; `equals` is required; `path_regex_group` needs an `index` greater than zero, `query` and `header` need a `name`, and `json_body` needs a `path` such as `$.tenant_id`.",{"_3170":574,"_28017":460,"_19412":47159,"_5":13306,"_25509":46846,"_2665":47160},[],"`param_constraints` are not cross-checked against the schema when the policy is loaded. A reference the route cannot satisfy — for instance a `path_regex_group` on a route without capture groups — simply never matches, and the request is denied.",{"_3170":575,"_28017":460,"_19412":47162,"_5":13306,"_25509":46846,"_2665":47163},[],"Several `param_constraints` for the same action combine with AND. A rule without them keeps the usual behavior: the action is granted wherever the route matches and the subject constraints pass.",{"_3170":576,"_28017":460,"_19412":47165,"_5":13306,"_25509":46850,"_2665":47166},[],"The `authz` preload installs reusable policies for the main domains. Among them are:",{"_3170":577,"_28017":460,"_19412":47168,"_5":13306,"_25509":46850,"_2665":47169},[],"full and read-only access to certificates and authorities;",{"_3170":578,"_28017":460,"_19412":47171,"_5":13306,"_25509":46850,"_2665":47172},[],"full and read-only access to the KMS;",{"_3170":579,"_28017":460,"_19412":47174,"_5":13306,"_25509":46850,"_2665":47175},[],"full and read-only access to Device Manager, DMS Manager, Validation Authority and alerts;",{"_3170":580,"_28017":460,"_19412":47177,"_5":13306,"_25509":46850,"_2665":47178},[],"an `Auditor` policy with PKI read access and authorization visibility;",{"_3170":581,"_28017":460,"_19412":47180,"_5":13306,"_25509":46850,"_2665":47181},[],"console access;",{"_3170":582,"_28017":460,"_19412":47183,"_5":13306,"_25509":46850,"_2665":47184},[],"administration and observation policies for the Job Manager NBI and SBI APIs;",{"_3170":583,"_28017":460,"_19412":47186,"_5":13306,"_25509":46850,"_2665":47187},[],"`SUPER ADMIN`, which grants all actions over the `authz` and `pki` domains.",{"_3170":584,"_28017":460,"_19412":47189,"_5":13306,"_25509":46850,"_2665":47190},[],"Start with these policies before creating others. If none reflects the boundary you need, create a specific, small policy instead of copying `SUPER ADMIN` and informally removing permissions.",{"_3170":585,"_28017":460,"_19412":47192,"_5":13306,"_25509":46854,"_2665":47193},[],"An installation without a principal matching your identity is left with nobody able to administer authorization. Configure the IdP and the bootstrap before exposing the platform.",{"_3170":586,"_28017":460,"_19412":47195,"_5":13306,"_25509":46854,"_2665":47196},[],"The chart includes a bootstrap principal that looks for the OIDC role `pki-admin` in `realm_access.roles`. It grants it `SUPER ADMIN` and, when Job Manager is enabled, the administrative policy of its NBI API.",{"_3170":587,"_28017":460,"_19412":47198,"_5":13306,"_25509":46854,"_2665":47199},[],"The pre-install and pre-upgrade Helm Job runs the `authz` migrations, preloads the policies and creates the bootstrap principals before the services start. If the principal already exists, it does not replace it: it only adds the configured grants that are still missing. You can keep the entry in `values.yaml` across upgrades.",{"_3170":588,"_28017":460,"_19412":47201,"_5":13306,"_25509":46857,"_2665":47202},[],"Create the role or group you will use to administer Lamassu. Assign it to at least two controlled human identities. If your provider does not use `realm_access.roles`, adapt the claim path in both the frontend and `auth_config.claims`.",{"_3170":589,"_28017":460,"_19412":47204,"_5":13306,"_25509":46861,"_2665":47205},[],"`authz` validates every token against `services.authz.jwkUrl`, which is fetched from the `authz` pod. The Gateway does not validate tokens itself: Lamassu services authorize each request through `authz`, and routes labeled `auth=external`, such as the Job Manager ones, are checked by the Gateway through `authz` when `auth.externalAuthorization` is enabled. The endpoint must serve the keys of the issuer configured in `auth.oidc.frontend.authority`.",{"_3170":590,"_28017":460,"_19412":47207,"_5":13306,"_25509":46861,"_2665":47208},[],"Releases upgraded from 3.8.0 must remove `auth.oidc.apiGateway` and `auth.authorization`, which the 4.0.0 chart rejects. See 3.8.0 to 4.0.0.",{"_3170":591,"_28017":460,"_19412":47210,"_5":13306,"_25509":46865,"_2665":47211},[],"Sign in with an identity holding `pki-admin`. Confirm it can access authorization administration and perform a non-destructive read operation.",{"_3170":592,"_28017":460,"_19412":47213,"_5":13306,"_25509":46869,"_2665":47214},[],"Use a second user without the role and confirm the same operation is denied. This test catches misread claims, overly broad policies and accidental `failOpen` configurations.",{"_3170":593,"_28017":460,"_19412":47216,"_5":13306,"_25509":46873,"_2665":47217},[],"Create operational principals with narrower policies. Reserve `pki-admin` for authorization administration and recovery, not for daily work.",{"_3170":594,"_28017":460,"_19412":47219,"_5":13306,"_25509":46877,"_2665":47220},[],"Fastlane installs a Keycloak realm for the lab and creates the user `lamassu` with the temporary password `lamassu`, the role `pki-admin` and a mandatory password change. Its bootstrap principal matches through `preferred_username=lamassu`.",{"_3170":595,"_28017":460,"_19412":47222,"_5":13306,"_25509":46877,"_2665":47223},[],"Change the password on first login. Do not reuse the Fastlane user, password or IdP as a production design.",{"_3170":596,"_28017":460,"_19412":47225,"_5":13306,"_25509":46881,"_2665":47226},[],"Avoid reproducing your company's internal structure with dozens of nearly identical policies. Start from the responsibilities that actually need access:",{"_3170":597,"_28017":460,"_19412":47228,"_5":13306,"_25509":46881,"_2665":47229},[],"**Authorization administration**: manages principals, policies and grants. It should belong to a small, separate group.",{"_3170":598,"_28017":460,"_19412":47231,"_5":13306,"_25509":46881,"_2665":47232},[],"**PKI operation**: administers CAs, profiles and certificates, but not necessarily who gets access.",{"_3170":599,"_28017":460,"_19412":47234,"_5":13306,"_25509":46881,"_2665":47235},[],"**Device registration**: operates devices and DMSs without receiving permissions over keys or authorization configuration.",{"_3170":600,"_28017":460,"_19412":47237,"_5":13306,"_25509":46881,"_2665":47238},[],"**Audit**: reviews configuration and activity without creating, modifying, signing, revoking or deleting.",{"_3170":601,"_28017":460,"_19412":47240,"_5":13306,"_25509":46881,"_2665":47241},[],"**Automation**: uses a technical account or a separate certificate, with permissions limited to the flow and resources it controls.",{"_3170":602,"_28017":460,"_19412":47243,"_5":13306,"_25509":46881,"_2665":47244},[],"For each role, separate \"view\" from \"change\", limit resources through grants, relations or attributes and avoid `*` unless the role must automatically cover future actions.",{"_3170":603,"_28017":460,"_19412":47246,"_5":13306,"_25509":46881,"_2665":47247},[],"A rule with `actions: [\"*\"]` expands to every action defined by the schema. When a new version adds an action, a wildcard policy may start granting it. Review these policies on every upgrade.",{"_3170":604,"_28017":460,"_19412":47249,"_5":13306,"_25509":46885,"_2665":47250},[],"To revoke access immediately, disable the principal or revoke its grants. Disabling a principal keeps its configuration and associations for investigation or restoration, but it stops taking part in matching.",{"_3170":605,"_28017":460,"_19412":47252,"_5":13306,"_25509":46885,"_2665":47253},[],"Deleting a role or group in the IdP prevents new tokens from containing the claim, but an already-issued token may remain valid until it expires. If removal is urgent, combine the IdP change with disabling the principal in Lamassu and revoking sessions or tokens at the provider.",{"_3170":606,"_28017":460,"_19412":47255,"_5":13306,"_25509":46885,"_2665":47256},[],"When you edit a shared policy, remember the change affects all its principals. To test a new scope, create a separate policy, grant it to a test identity and validate allowed and denied operations before replacing the old one.",{"_3170":607,"_28017":460,"_19412":47258,"_5":13306,"_25509":46889,"_2665":47259},[],"Keep `failOpen: false` unless a documented risk assessment justifies otherwise.",{"_3170":608,"_28017":460,"_19412":47261,"_5":13306,"_25509":46889,"_2665":47262},[],"Use groups or stable roles for people and independent identities for automations.",{"_3170":609,"_28017":460,"_19412":47264,"_5":13306,"_25509":46889,"_2665":47265},[],"Keep at least two recovery administrators and test their access periodically.",{"_3170":610,"_28017":460,"_19412":47267,"_5":13306,"_25509":46889,"_2665":47268},[],"Review active principals, their matches and their grants after IdP changes.",{"_3170":611,"_28017":460,"_19412":47270,"_5":13306,"_25509":46889,"_2665":47271},[],"Search for wildcards in policies before upgrading Lamassu.",{"_3170":612,"_28017":460,"_19412":47273,"_5":13306,"_25509":46889,"_2665":47274},[],"Review `skip_authz` routes and `default_action` settings in HTTP schemas when integrating or upgrading a service.",{"_3170":613,"_28017":460,"_19412":47276,"_5":13306,"_25509":46889,"_2665":47277},[],"Always test one allowed and one denied operation for each role.",{"_3170":614,"_28017":460,"_19412":47279,"_5":13306,"_25509":46889,"_2665":47280},[],"Correlate changes to principals, policies and grants with the audit logs.",{"_3170":615,"_28017":460,"_19412":47282,"_5":13306,"_25509":46897,"_2665":47283},[],"Authentication failed before permissions were evaluated. Check the JWT signature and expiration, issuer, audience and the availability of the JWKS configured in the Gateway. For X.509, check that the client certificate reaches the point that extracts the credential.",{"_3170":616,"_28017":460,"_19412":47285,"_5":13306,"_25509":46901,"_2665":47286},[],"The credential could be processed but did not produce a positive authorization. Review in this order:",{"_3170":617,"_28017":460,"_19412":47288,"_5":13306,"_25509":46901,"_2665":47289},[],"that an active principal of the correct type exists;",{"_3170":618,"_28017":460,"_19412":47291,"_5":13306,"_25509":46901,"_2665":47292},[],"that the claim paths and values match the real token exactly;",{"_3170":619,"_28017":460,"_19412":47294,"_5":13306,"_25509":46901,"_2665":47295},[],"that all of the principal's conditions hold;",{"_3170":620,"_28017":460,"_19412":47297,"_5":13306,"_25509":46901,"_2665":47298},[],"that the principal has the expected policy granted;",{"_3170":621,"_28017":460,"_19412":47300,"_5":13306,"_25509":46901,"_2665":47301},[],"that the policy includes the action and the requested resource type or route;",{"_3170":622,"_28017":460,"_19412":47303,"_5":13306,"_25509":46901,"_2665":47304},[],"that the identifier, relation, column filter or HTTP constraint includes the real resource.",{"_3170":623,"_28017":460,"_19412":47306,"_5":13306,"_25509":46901,"_2665":47307},[],"In the `authz` logs, an external endpoint decision includes `allowed`, `reason`, `matched_principals`, `evaluated_policy_ids`, `matched_policy_id` and the status code. These fields let you separate a matching failure from a permissions failure. With OpenTelemetry instrumentation enabled, each decision also produces a span — `engine.CheckHTTP` on the Gateway path — whose attributes record `authz.allowed`, the matched policy and the matched principal, so you can correlate the denial with the Gateway trace.",{"_3170":624,"_28017":460,"_19412":47309,"_5":13306,"_25509":46905,"_2665":47310},[],"Check that the bootstrap principal was created and that the policies were preloaded by the migration Job. Also verify that `services.authz.jwkUrl` is reachable from the `authz` pod; do not assume that a URL accessible from the browser also works inside the cluster.",{"_3170":625,"_28017":460,"_19412":47312,"_5":13306,"_25509":46909,"_2665":47313},[],"The path may be covered by a schema-level decision rather than by a policy: routes marked `skip_authz` allow any identity that matches an active principal, and a request under a `base_paths` prefix whose schema sets `default_action: allow` is likewise allowed without consulting policies. Confirm which of the two applies before looking for missing or misassigned grants.",{"_3170":626,"_28017":460,"_19412":47315,"_5":13306,"_25509":46913,"_2665":47316},[],"This is the expected behavior with `failOpen: false`. Restore the service, its PostgreSQL connection and its JWKS connectivity. Do not temporarily switch to `failOpen: true` without accepting that protected routes could become accessible without an authorization decision.",{"_3170":627,"_28017":460,"_19412":47318,"_5":13306,"_25509":46913,"_2665":47319},[],"Continue with Audit logs to investigate configuration changes or with Troubleshooting to diagnose the deployment.",{"_3170":628,"_28017":628,"_5":13637,"_2665":47321,"_28339":47322,"_19412":47323,"_25509":628},"Alerts and subscriptions",[45393,46786,46787],[],{"_3170":629,"_28017":628,"_19412":47325,"_5":13306,"_25509":628,"_2665":47326},[],"Send PKI events to people and external systems.",{"_3170":630,"_28017":628,"_5":28336,"_19412":47328,"_25509":47329,"_2665":47330},[],"/docs/platform/administration/alerts#how-it-works","How it works",{"_3170":631,"_28017":628,"_5":28336,"_19412":47332,"_25509":47333,"_2665":47334},[],"/docs/platform/administration/alerts#available-channels","Available channels",{"_3170":632,"_28017":628,"_5":28336,"_19412":47336,"_25509":47337,"_2665":47338},[],"/docs/platform/administration/alerts#create-a-subscription","Create a subscription",{"_3170":633,"_28017":628,"_5":28336,"_19412":47340,"_25509":47341,"_2665":47342},[],"/docs/platform/administration/alerts#choose-the-event","Choose the event",{"_3170":634,"_28017":628,"_5":28336,"_19412":47344,"_25509":47345,"_2665":47346},[],"/docs/platform/administration/alerts#configure-the-destination","Configure the destination",{"_3170":635,"_28017":628,"_5":28336,"_19412":47348,"_25509":47349,"_2665":47350},[],"/docs/platform/administration/alerts#limit-the-notifications","Limit the notifications",{"_3170":636,"_28017":628,"_5":28336,"_19412":47352,"_25509":47353,"_2665":47354},[],"/docs/platform/administration/alerts#review-and-activate","Review and activate",{"_3170":637,"_28017":628,"_5":28336,"_19412":47356,"_25509":47357,"_2665":47358},[],"/docs/platform/administration/alerts#configure-the-webhook-http-client","Configure the webhook HTTP client",{"_3170":638,"_28017":628,"_5":28336,"_19412":47360,"_25509":47361,"_2665":47362},[],"/docs/platform/administration/alerts#webhook-delivery-rules","Webhook delivery rules",{"_3170":639,"_28017":628,"_5":28336,"_19412":47364,"_25509":47365,"_2665":47366},[],"/docs/platform/administration/alerts#manage-a-subscription","Manage a subscription",{"_3170":640,"_28017":628,"_5":28336,"_19412":47368,"_25509":47369,"_2665":47370},[],"/docs/platform/administration/alerts#event-families","Event families",{"_3170":641,"_28017":628,"_19412":47372,"_5":13306,"_25509":628,"_2665":47373},[],"Subscriptions turn Lamassu events into actionable notifications. You can alert a team, feed an incident system or trigger an automation when a CA, certificate or device changes.",{"_3170":642,"_28017":628,"_19412":47375,"_5":13306,"_25509":47329,"_2665":47376},[],"A service publishes a domain event.",{"_3170":643,"_28017":628,"_19412":47378,"_5":13306,"_25509":47329,"_2665":47379},[],"Lamassu evaluates the subscriptions associated with that event type.",{"_3170":644,"_28017":628,"_19412":47381,"_5":13306,"_25509":47329,"_2665":47382},[],"Each subscription's filter decides whether it should be notified.",{"_3170":645,"_28017":628,"_19412":47384,"_5":13306,"_25509":47329,"_2665":47385},[],"Lamassu delivers the event to the configured channel.",{"_3170":646,"_28017":628,"_19412":47387,"_5":13306,"_25509":47329,"_2665":47388},[],"The event inventory shows when each type was last observed, how many times it has occurred and how many subscriptions it has. You can expand an event to inspect an example of its JSON payload before creating the filter.",{"_3170":647,"_28017":628,"_19412":47390,"_5":13306,"_25509":47333,"_2665":47391},[],"**Email** sends alerts to a person or an operational list. It only requires the destination address. Event content is rendered as HTML-escaped text, never as markup.",{"_3170":648,"_28017":628,"_19412":47393,"_5":13306,"_25509":47333,"_2665":47394},[],"**Microsoft Teams** posts the notification to a channel through its webhook URL.",{"_3170":649,"_28017":628,"_19412":47396,"_5":13306,"_25509":47333,"_2665":47397},[],"**Webhook** delivers the event to an automation, SIEM or incident system via `POST` or `PUT`.",{"_3170":650,"_28017":628,"_19412":47399,"_5":13306,"_25509":47333,"_2665":47400},[],"The Microsoft Teams and Webhook channels accept an optional `http_client` block that authenticates the call to the receiver. `auth_mode` selects `noauth` (the default), `apikey`, `jwt` or `mtls`; each mode requires its own options:",{"_3170":651,"_28017":628,"_19412":47402,"_5":13306,"_25509":47333,"_2665":47403},[],"`apikey_options` requires `header` and `key`.",{"_3170":652,"_28017":628,"_19412":47405,"_5":13306,"_25509":47333,"_2665":47406},[],"`jwt_options` requires `oidc_client_id`, `oidc_client_secret` and an absolute `http` or `https` `oidc_well_known`.",{"_3170":653,"_28017":628,"_19412":47408,"_5":13306,"_25509":47333,"_2665":47409},[],"`mtls_options` requires `cert_content` and `key_content` as Base64-encoded PEM, like certificates elsewhere in the API; plain PEM is also accepted. Values that reference files on the server are rejected, and the pair must decode to a matching certificate and private key.",{"_3170":654,"_28017":628,"_19412":47411,"_5":13306,"_25509":47333,"_2665":47412},[],"The alerts API reference documents the full `http_client` schema.",{"_3170":655,"_28017":628,"_19412":47414,"_5":13306,"_25509":47341,"_2665":47415},[],"Open **Alerts**, locate the event type and select **Subscribe**. Review the latest JSON example to identify the fields you will need to filter on.",{"_3170":656,"_28017":628,"_19412":47417,"_5":13306,"_25509":47345,"_2665":47418},[],"Select Email, Microsoft Teams or Webhook and enter the channel details.",{"_3170":657,"_28017":628,"_19412":47420,"_5":13306,"_25509":47349,"_2665":47421},[],"Add a filter if you don't want to receive every instance of the event.",{"_3170":658,"_28017":628,"_19412":47423,"_5":13306,"_25509":47349,"_2665":47424},[],"**None** notifies all instances of the event.",{"_3170":659,"_28017":628,"_19412":47426,"_5":13306,"_25509":47349,"_2665":47427},[],"**JSON Path** evaluates one or more specific fields.",{"_3170":660,"_28017":628,"_19412":47429,"_5":13306,"_25509":47349,"_2665":47430},[],"**JSON Schema** accepts only payloads with a particular structure.",{"_3170":661,"_28017":628,"_19412":47432,"_5":13306,"_25509":47349,"_2665":47433},[],"**JavaScript** lets you express custom logic. Each filter runs for at most 100 milliseconds; a filter that exceeds this limit fails the condition and the notification is skipped with the error `javascript filter execution timed out`.",{"_3170":662,"_28017":628,"_19412":47435,"_5":13306,"_25509":47349,"_2665":47436},[],"For example, `function (event) { return event.data.status == \"NO_IDENTITY\"; }` limits a subscription to devices without an identity.",{"_3170":663,"_28017":628,"_19412":47438,"_5":13306,"_25509":47353,"_2665":47439},[],"Check the event, channel and filter in the summary. Select **Confirm Subscription** to start delivery.",{"_3170":664,"_28017":628,"_19412":47441,"_5":13306,"_25509":47357,"_2665":47442},[],"The Webhook and Microsoft Teams channels show this configuration in the subscribe form, at the channel step, and again when editing a subscription; Email does not use it. The fields map to the optional `http_client` block described above:",{"_3170":665,"_28017":628,"_19412":47444,"_5":13306,"_25509":47357,"_2665":47445},[],"**Log Level** selects `debug`, `info`, `warn` or `error`; `info` is the default.",{"_3170":666,"_28017":628,"_19412":47447,"_5":13306,"_25509":47357,"_2665":47448},[],"**Call Timeout** defaults to 10 seconds. The console rejects a value above 30 seconds with `Webhook timeout must be at most 30s.`; the API clamps the same value to the cap instead (see Calls are bounded).",{"_3170":667,"_28017":628,"_19412":47450,"_5":13306,"_25509":47357,"_2665":47451},[],"There is no TLS-verification switch for these channels, because the service always verifies the receiver certificate (see TLS is always verified).",{"_3170":668,"_28017":628,"_19412":47453,"_5":13306,"_25509":47357,"_2665":47454},[],"**HTTP Authentication** selects `No Authentication` (the default), `API Key` (API key value and Header Name, `X-API-Key` by default), `OIDC Client Credentials` (Client ID, Client Secret and Well-Known URL) or `Mutual TLS` (Client Certificate and Client Private Key pasted as PEM). A stored private key stays hidden until you select **Show**.",{"_3170":669,"_28017":628,"_19412":47456,"_5":13306,"_25509":47357,"_2665":47457},[],"A `http://` URL shows the console warning `Unencrypted HTTP connection` (see the Credentials over http\\:// callout below).",{"_3170":670,"_28017":628,"_19412":47459,"_5":13306,"_25509":47357,"_2665":47460},[],"The form validates inline against the same delivery rules: the webhook URL and the OIDC Well-Known URL must be absolute `http` or `https` URLs, an API-key header may not use a reserved name, and the mTLS certificate and key must be PEM content, not file paths.",{"_3170":671,"_28017":628,"_19412":47462,"_5":13306,"_25509":47357,"_2665":47463},[],"The summary in the Confirm step shows the authentication as `None`, `OIDC client credentials`, `API key` or `Mutual TLS`. The subscription details show the authentication, the API key header name (never the value), the OIDC issuer URL, mTLS as `Configured` and a fixed `TLS verification: Verified` row. The API key, client secret and private key are not shown in the subscription details.",{"_3170":672,"_28017":628,"_19412":47465,"_5":13306,"_25509":47361,"_2665":47466},[],"Notifications delivered through the Microsoft Teams and Webhook channels follow a fixed HTTP policy:",{"_3170":673,"_28017":628,"_19412":47468,"_5":13306,"_25509":47361,"_2665":47469},[],"**TLS is always verified.** The receiver certificate is checked against the system trust store. `insecure_skip_verify` is enforced as `false` — including when it is set to `true` — so self-signed or otherwise untrusted receivers fail delivery.",{"_3170":674,"_28017":628,"_19412":47471,"_5":13306,"_25509":47361,"_2665":47472},[],"**Redirects are not followed.** A `3xx` response fails with `unexpected status code: <n>: redirects are not followed`. Configure `webhook_url` with the final absolute `http` or `https` URL: an `http://` address that an ingress redirects to `https://` stops working.",{"_3170":675,"_28017":628,"_19412":47474,"_5":13306,"_25509":47361,"_2665":47475},[],"**Calls are bounded.** A call defaults to a 10 second timeout; a configured `call_timeout` is capped at 30 seconds. Values above the cap are clamped, not rejected.",{"_3170":676,"_28017":628,"_19412":47477,"_5":13306,"_25509":47361,"_2665":47478},[],"**The response body is ignored.** Delivery checks the status code only, so the receiver may answer with any body.",{"_3170":677,"_28017":628,"_19412":47480,"_5":13306,"_25509":47361,"_2665":47481},[],"**API-key headers are restricted.** A custom `apikey_options.header` may not use names that the platform or receiving services trust — for example `X-Principal-Id`, `X-Request-Id`, `Host`, `Content-Type` or `Forwarded` — and no name may start with `X-Forwarded-`, `X-Envoy-` or `X-Lms-`. Comparisons are case-insensitive.",{"_3170":678,"_28017":628,"_19412":47483,"_5":13306,"_25509":47361,"_2665":47484},[],"**Invalid configurations are rejected at subscribe time.** A channel configuration that would fail on every delivery returns HTTP 400 with a body that starts with `struct validation error:`, and the subscription is not created.",{"_3170":679,"_28017":628,"_19412":47486,"_5":13306,"_25509":47361,"_2665":47487},[],"Credentials are sent regardless of the URL scheme. With an `http://` `webhook_url`, the API key or bearer token travels in cleartext and mTLS has no effect. Prefer `https://` for `webhook_url`, `oidc_well_known` and the token endpoint it advertises.",{"_3170":680,"_28017":628,"_19412":47489,"_5":13306,"_25509":47365,"_2665":47490},[],"Open an existing subscription to review its destination and filter, modify the configuration or select **Unsubscribe**. Remove subscriptions that no longer have an operational owner to avoid ignored deliveries or stale endpoints.",{"_3170":681,"_28017":628,"_19412":47492,"_5":13306,"_25509":47365,"_2665":47493},[],"Subscriptions created with older console versions may store the webhook target under `url` and `method` instead of `webhook_url` and `webhook_method`. The service delivers only through `webhook_url` and `webhook_method`, so such a subscription does not deliver even though the subscription details show the stored target. Open the subscription and save it again: the edit form prefills the stored target, and saving rewrites the channel configuration in the current layout.",{"_3170":682,"_28017":628,"_19412":47495,"_5":13306,"_25509":47369,"_2665":47496},[],"**Authorities:** `ca.create`, `ca.import`, `ca.reissue` and `ca.delete`.",{"_3170":683,"_28017":628,"_19412":47498,"_5":13306,"_25509":47369,"_2665":47499},[],"**Certificates:** `ca.sign.certificate` and `certificate.delete`.",{"_3170":684,"_28017":628,"_19412":47501,"_5":13306,"_25509":47369,"_2665":47502},[],"**Profiles:** `profile.issuance.create`, `profile.issuance.update` and `profile.issuance.delete`.",{"_3170":685,"_28017":628,"_19412":47504,"_5":13306,"_25509":47369,"_2665":47505},[],"**Enrollment:** `dms.create`, `dms.update`, `dms.enroll` and `dms.reenroll`.",{"_3170":686,"_28017":628,"_19412":47507,"_5":13306,"_25509":47369,"_2665":47508},[],"**Devices:** `device.create`, `device.identity.update` and `device.status.update`.",{"_3170":687,"_28017":628,"_19412":47510,"_5":13306,"_25509":47369,"_2665":47511},[],"**Validation:** `va.role.crl.create`.",{"_3170":688,"_28017":628,"_19412":47513,"_5":13306,"_25509":47369,"_2665":47514},[],"**Keys:** `kms.create`, `kms.import`, `kms.sign` and `kms.delete`.",{"_3170":689,"_28017":628,"_19412":47516,"_5":13306,"_25509":47369,"_2665":47517},[],"Use the catalog shown in the console as the source for the types available in your deployed version.",{"_3170":690,"_28017":690,"_5":13637,"_2665":47519,"_28339":47520,"_19412":47521,"_25509":690},"Audit logs",[45393,46786,46787],[],{"_3170":691,"_28017":690,"_19412":47523,"_5":13306,"_25509":690,"_2665":47524},[],"Understand which audit events Lamassu generates and how to turn them into a durable trail.",{"_3170":692,"_28017":690,"_5":28336,"_19412":47526,"_25509":47527,"_2665":47528},[],"/docs/platform/administration/audit-logs#what-an-event-contains","What an event contains",{"_3170":693,"_28017":690,"_5":28336,"_19412":47530,"_25509":47531,"_2665":47532},[],"/docs/platform/administration/audit-logs#coverage","Coverage",{"_3170":694,"_28017":690,"_5":28336,"_19412":47534,"_25509":47535,"_2665":47536},[],"/docs/platform/administration/audit-logs#publication-and-persistence","Publication and persistence",{"_3170":695,"_28017":690,"_5":28336,"_19412":47538,"_25509":47539,"_2665":47540},[],"/docs/platform/administration/audit-logs#sensitive-data","Sensitive data",{"_3170":696,"_28017":690,"_5":28336,"_19412":47542,"_25509":47543,"_2665":47544},[],"/docs/platform/administration/audit-logs#a-reproducible-investigation","A reproducible investigation",{"_3170":697,"_28017":690,"_5":28336,"_19412":47546,"_25509":47547,"_2665":47548},[],"/docs/platform/administration/audit-logs#bound-the-interval","Bound the interval",{"_3170":698,"_28017":690,"_5":28336,"_19412":47550,"_25509":47551,"_2665":47552},[],"/docs/platform/administration/audit-logs#identify-the-operation","Identify the operation",{"_3170":699,"_28017":690,"_5":28336,"_19412":47554,"_25509":47555,"_2665":47556},[],"/docs/platform/administration/audit-logs#attribute-the-principal","Attribute the principal",{"_3170":700,"_28017":690,"_5":28336,"_19412":47558,"_25509":47559,"_2665":47560},[],"/docs/platform/administration/audit-logs#compare-intent-and-result","Compare intent and result",{"_3170":701,"_28017":690,"_5":28336,"_19412":47562,"_25509":47563,"_2665":47564},[],"/docs/platform/administration/audit-logs#follow-the-effect","Follow the effect",{"_3170":702,"_28017":690,"_5":28336,"_19412":47566,"_25509":47567,"_2665":47568},[],"/docs/platform/administration/audit-logs#periodic-verification","Periodic verification",{"_3170":703,"_28017":690,"_19412":47570,"_5":13306,"_25509":690,"_2665":47571},[],"Lamassu instruments the mutable operations of its services with audit events. Each event describes the operation, the principals that matched, the input, the result and whether it ended in error.",{"_3170":704,"_28017":690,"_19412":47573,"_5":13306,"_25509":47527,"_2665":47574},[],"The audit body includes:",{"_3170":705,"_28017":690,"_19412":47576,"_5":13306,"_25509":47527,"_2665":47577},[],"input: data received by the operation;",{"_3170":706,"_28017":690,"_19412":47579,"_5":13306,"_25509":47527,"_2665":47580},[],"has\\_error: whether the service returned an error;",{"_3170":707,"_28017":690,"_19412":47582,"_5":13306,"_25509":47527,"_2665":47583},[],"output: produced result or error message;",{"_3170":708,"_28017":690,"_19412":47585,"_5":13306,"_25509":47527,"_2665":47586},[],"principals: identifiers of the principals that matched the request.",{"_3170":709,"_28017":690,"_19412":47588,"_5":13306,"_25509":47527,"_2665":47589},[],"Successful operations use a type prefixed with audit.. Failures publish the operation type suffixed with .error. The CloudEvents event additionally adds source, identifier, date and type.",{"_3170":710,"_28017":690,"_19412":47591,"_5":13306,"_25509":47527,"_2665":47592},[],"The middlewares publish the record after executing the operation, whether it succeeded or returned an error. This lets you investigate attempts as well as confirmed changes.",{"_3170":711,"_28017":690,"_19412":47594,"_5":13306,"_25509":47531,"_2665":47595},[],"The backend applies auditing to mutations of:",{"_3170":712,"_28017":690,"_19412":47597,"_5":13306,"_25509":47531,"_2665":47598},[],"authorities, certificates and issuance profiles;",{"_3170":713,"_28017":690,"_19412":47600,"_5":13306,"_25509":47531,"_2665":47601},[],"keys and KMS engines;",{"_3170":714,"_28017":690,"_19412":47603,"_5":13306,"_25509":47531,"_2665":47604},[],"devices and identities;",{"_3170":715,"_28017":690,"_19412":47606,"_5":13306,"_25509":47531,"_2665":47607},[],"DMSs and enrollment operations;",{"_3170":716,"_28017":690,"_19412":47609,"_5":13306,"_25509":47531,"_2665":47610},[],"validation functions and CRL;",{"_3170":717,"_28017":690,"_19412":47612,"_5":13306,"_25509":47531,"_2665":47613},[],"principals, policies and authorization grants.",{"_3170":718,"_28017":690,"_19412":47615,"_5":13306,"_25509":47531,"_2665":47616},[],"Do not confuse these events with domain events. A domain event announces that a resource changed so another component can react; the audit event keeps input, output and principal context for investigation.",{"_3170":719,"_28017":690,"_19412":47618,"_5":13306,"_25509":47535,"_2665":47619},[],"Services publish audit records to the event bus when their PublisherEventBus is enabled. The backend code does not, by itself, implement a queryable, durable audit file.",{"_3170":720,"_28017":690,"_19412":47621,"_5":13306,"_25509":47535,"_2665":47622},[],"If you need retention, search, tamper protection or regulatory export, connect a consumer that persists the events into the system approved by your organization.",{"_3170":721,"_28017":690,"_19412":47624,"_5":13306,"_25509":47535,"_2665":47625},[],"Design the consumer to:",{"_3170":722,"_28017":690,"_19412":47627,"_5":13306,"_25509":47535,"_2665":47628},[],"subscribe to the audit.# types and also to operation types ending in .error;",{"_3170":723,"_28017":690,"_19412":47630,"_5":13306,"_25509":47535,"_2665":47631},[],"keep the complete CloudEvent unmodified;",{"_3170":724,"_28017":690,"_19412":47633,"_5":13306,"_25509":47535,"_2665":47634},[],"record the ingestion time and detect duplicates by ID;",{"_3170":725,"_28017":690,"_19412":47636,"_5":13306,"_25509":47535,"_2665":47637},[],"encrypt in transit and at rest;",{"_3170":726,"_28017":690,"_19412":47639,"_5":13306,"_25509":47535,"_2665":47640},[],"restrict reading and deletion to a role separate from the PKI operator;",{"_3170":727,"_28017":690,"_19412":47642,"_5":13306,"_25509":47535,"_2665":47643},[],"apply an explicit retention and legal hold policy;",{"_3170":728,"_28017":690,"_19412":47645,"_5":13306,"_25509":47535,"_2665":47646},[],"alert if it stops consuming or the pending queue grows.",{"_3170":729,"_28017":690,"_19412":47648,"_5":13306,"_25509":47539,"_2665":47649},[],"The input and output fields can contain subjects, metadata, public material, configuration or error messages. Evaluate their classification before sending them to an external platform.",{"_3170":730,"_28017":690,"_19412":47651,"_5":13306,"_25509":47539,"_2665":47652},[],"Do not log private keys, provider secrets or full tokens in automations around Lamassu. Restrict export and apply redaction at the destination without destroying the fields needed for attribution.",{"_3170":731,"_28017":690,"_19412":47654,"_5":13306,"_25509":47547,"_2665":47655},[],"Start from the reported time and normalize every source to UTC.",{"_3170":732,"_28017":690,"_19412":47657,"_5":13306,"_25509":47551,"_2665":47658},[],"Filter by event type, service source and resource identifier.",{"_3170":733,"_28017":690,"_19412":47660,"_5":13306,"_25509":47555,"_2665":47661},[],"Review principals and correlate them with the OIDC provider or the X.509 identity valid at that moment.",{"_3170":734,"_28017":690,"_19412":47663,"_5":13306,"_25509":47559,"_2665":47664},[],"Contrast input, has\\_error and output. A failed attempt does not mean the resource changed.",{"_3170":735,"_28017":690,"_19412":47666,"_5":13306,"_25509":47563,"_2665":47667},[],"Look for the domain events and service records that share resource and time window. In a CA revocation, include the cascading operations.",{"_3170":736,"_28017":690,"_19412":47669,"_5":13306,"_25509":47567,"_2665":47670},[],"Generate a controlled mutation in a test environment and check that:",{"_3170":737,"_28017":690,"_19412":47672,"_5":13306,"_25509":47567,"_2665":47673},[],"a successful audit event appears;",{"_3170":738,"_28017":690,"_19412":47675,"_5":13306,"_25509":47567,"_2665":47676},[],"the principal matches the identity used;",{"_3170":739,"_28017":690,"_19412":47678,"_5":13306,"_25509":47567,"_2665":47679},[],"the consumer persists it exactly once;",{"_3170":740,"_28017":690,"_19412":47681,"_5":13306,"_25509":47567,"_2665":47682},[],"it can be retrieved by resource, actor and period;",{"_3170":741,"_28017":690,"_19412":47684,"_5":13306,"_25509":47567,"_2665":47685},[],"a consumer outage raises an alert.",{"_3170":742,"_28017":690,"_19412":47687,"_5":13306,"_25509":47567,"_2665":47688},[],"For metrics, traces and technical logs of the deployment, see Troubleshooting. Audit answers \"who tried to change what\"; observability explains how the system behaved.",{"_3170":743,"_28017":743,"_5":13637,"_2665":47690,"_28339":47691,"_19412":47692,"_25509":743},"Platform architecture",[45393,46786],[],{"_3170":744,"_28017":743,"_19412":47694,"_5":13306,"_25509":743,"_2665":47695},[],"Lamassu components and how control, keys, issuance and devices relate.",{"_3170":745,"_28017":743,"_5":28336,"_19412":47697,"_25509":47698,"_2665":47699},[],"/docs/platform/concepts/architecture#control-plane","Control plane",{"_3170":746,"_28017":743,"_5":28336,"_19412":47701,"_25509":47702,"_2665":47703},[],"/docs/platform/concepts/architecture#key-custody-and-cryptographic-operations","Key custody and cryptographic operations",{"_3170":747,"_28017":743,"_5":28336,"_19412":47705,"_25509":47706,"_2665":47707},[],"/docs/platform/concepts/architecture#issuance-and-enrollment","Issuance and enrollment",{"_3170":748,"_28017":743,"_5":28336,"_19412":47709,"_25509":47710,"_2665":47711},[],"/docs/platform/concepts/architecture#status-and-validation","Status and validation",{"_3170":749,"_28017":743,"_5":28336,"_19412":47713,"_25509":47714,"_2665":47715},[],"/docs/platform/concepts/architecture#platform-dependencies","Platform dependencies",{"_3170":750,"_28017":743,"_19412":47717,"_5":13306,"_25509":743,"_2665":47718},[],"Lamassu deploys as a set of independent services. This separation keeps every component from needing direct access to private keys and lets each capability scale according to load.",{"_3170":751,"_28017":743,"_19412":47720,"_5":13306,"_25509":743,"_2665":47721},[],"Switch to the low level to see the internals of the Lamassu platform box (CA, KMS, DMS, Device Manager, VA, Alerts, AWS IoT connector, Job Manager and the console/API), and to medium to see it as a single platform alongside its external dependencies.",{"_3170":752,"_28017":743,"_19412":47723,"_5":13306,"_25509":47698,"_2665":47724},[],"The console and the APIs manage authorities, certificates, DMSs, devices, alerts and configuration. Domain events allow connectors and automations to react to changes without continuously polling the platform.",{"_3170":753,"_28017":743,"_19412":47726,"_5":13306,"_25509":47702,"_2665":47727},[],"The KMS offers a common interface over software engines, PKCS#11 and cloud providers. The selected engine keeps the key or delegates the cryptographic operation without the other services knowing its implementation.",{"_3170":754,"_28017":743,"_19412":47729,"_5":13306,"_25509":47706,"_2665":47730},[],"The CA service issues certificates and maintains the relationship with its authority. The DMS applies the enrollment rules and exposes the EST flows so a device can request or renew an identity.",{"_3170":755,"_28017":743,"_19412":47732,"_5":13306,"_25509":47710,"_2665":47733},[],"Device Manager keeps the operational view of the device and its history. The Validation Authority publishes OCSP and CRLs so other systems can decide whether to trust a presented certificate.",{"_3170":756,"_28017":743,"_19412":47735,"_5":13306,"_25509":47714,"_2665":47736},[],"In a self-managed deployment, Lamassu uses PostgreSQL for persistence, RabbitMQ for messaging and an OIDC provider for authentication. See the deployment architecture for how the services are published on Kubernetes.",{"_3170":757,"_28017":757,"_5":13637,"_2665":47738,"_28339":47739,"_19412":47740,"_25509":757},"How Lamassu works",[45393,46786],[],{"_3170":758,"_28017":757,"_19412":47742,"_5":13306,"_25509":757,"_2665":47743},[],"The mental model of trust, keys, certificates and devices.",{"_3170":759,"_28017":757,"_5":28336,"_19412":47745,"_25509":47746,"_2665":47747},[],"/docs/platform/concepts/overview#the-model-in-five-pieces","The model in five pieces",{"_3170":760,"_28017":757,"_5":28336,"_19412":47749,"_25509":47750,"_2665":47751},[],"/docs/platform/concepts/overview#from-onboarding-to-operation","From onboarding to operation",{"_3170":761,"_28017":757,"_19412":47753,"_5":13306,"_25509":757,"_2665":47754},[],"Lamassu connects three elements: a **root of trust**, an **issuance policy** and an **entity that needs to prove its identity**. The platform coordinates these elements throughout the certificate lifecycle.",{"_3170":762,"_28017":757,"_19412":47756,"_5":13306,"_25509":47746,"_2665":47757},[],"**Cryptographic engine.** Generates or safeguards keys and executes private-key operations without exposing key material to the rest of the services.",{"_3170":763,"_28017":757,"_19412":47759,"_5":13306,"_25509":47746,"_2665":47760},[],"**Certification Authority (CA).** Signs certificates and establishes the chain of trust.",{"_3170":764,"_28017":757,"_19412":47762,"_5":13306,"_25509":47746,"_2665":47763},[],"**Device Management Service (DMS).** Defines how the devices of a fleet are registered, authenticated and renewed.",{"_3170":765,"_28017":757,"_19412":47765,"_5":13306,"_25509":47746,"_2665":47766},[],"**Device.** Keeps its private key and presents the certificate to prove its identity.",{"_3170":766,"_28017":757,"_19412":47768,"_5":13306,"_25509":47746,"_2665":47769},[],"**Validation Authority (VA).** Publishes the status of certificates through OCSP and CRL.",{"_3170":767,"_28017":757,"_19412":47771,"_5":13306,"_25509":47750,"_2665":47772},[],"An administrator configures a cryptographic engine and creates or imports a CA.",{"_3170":768,"_28017":757,"_19412":47774,"_5":13306,"_25509":47750,"_2665":47775},[],"A DMS relates that CA to an enrollment policy.",{"_3170":769,"_28017":757,"_19412":47777,"_5":13306,"_25509":47750,"_2665":47778},[],"The device generates a key and requests a certificate through EST, or an operator assigns it an identity.",{"_3170":770,"_28017":757,"_19412":47780,"_5":13306,"_25509":47750,"_2665":47781},[],"Lamassu keeps the inventory, history and status of the identity.",{"_3170":771,"_28017":757,"_19412":47783,"_5":13306,"_25509":47750,"_2665":47784},[],"Consumers check the chain and query OCSP or a CRL when they need to know whether it is still valid.",{"_3170":772,"_28017":757,"_19412":47786,"_5":13306,"_25509":47750,"_2665":47787},[],"<Card title=\"Architecture\" description=\"Get to know the components and where each one's responsibility ends.\" href=\"/docs/platform/concepts/architecture\" />",{"_3170":773,"_28017":757,"_19412":47789,"_5":13306,"_25509":47750,"_2665":47790},[],"<Card title=\"Identity lifecycle\" description=\"Follow a certificate from enrollment to renewal or revocation.\" href=\"/docs/platform/pki/concepts/certificate-lifecycle\" />",{"_3170":774,"_28017":774,"_5":13637,"_2665":47792,"_28339":47793,"_19412":47795,"_25509":774},"Devices and identities",[45393,46786,47794,47792],"IoT Fleets",[],{"_3170":775,"_28017":774,"_19412":47797,"_5":13306,"_25509":774,"_2665":47798},[],"Register, inspect and retire devices while checking their current identity and history.",{"_3170":776,"_28017":774,"_5":28336,"_19412":47800,"_25509":47801,"_2665":47802},[],"/docs/platform/iot-fleets/device-management#device-states","Device states",{"_3170":777,"_28017":774,"_5":28336,"_19412":47804,"_25509":47805,"_2665":47806},[],"/docs/platform/iot-fleets/device-management#inspect-a-device","Inspect a device",{"_3170":778,"_28017":774,"_5":28336,"_19412":47808,"_25509":47809,"_2665":47810},[],"/docs/platform/iot-fleets/device-management#register-a-device-manually","Register a device manually",{"_3170":779,"_28017":774,"_5":28336,"_19412":47812,"_25509":47813,"_2665":47814},[],"/docs/platform/iot-fleets/device-management#create-the-device","Create the device",{"_3170":780,"_28017":774,"_5":28336,"_19412":47816,"_25509":47817,"_2665":47818},[],"/docs/platform/iot-fleets/device-management#define-its-membership","Define its membership",{"_3170":781,"_28017":774,"_5":28336,"_19412":47820,"_25509":47821,"_2665":47822},[],"/docs/platform/iot-fleets/device-management#classify-the-device","Classify the device",{"_3170":782,"_28017":774,"_5":28336,"_19412":47824,"_25509":47825,"_2665":47826},[],"/docs/platform/iot-fleets/device-management#verify-the-registration","Verify the registration",{"_3170":783,"_28017":774,"_5":28336,"_19412":47828,"_25509":47829,"_2665":47830},[],"/docs/platform/iot-fleets/device-management#assign-an-identity-manually","Assign an identity manually",{"_3170":784,"_28017":774,"_5":28336,"_19412":47832,"_25509":47833,"_2665":47834},[],"/docs/platform/iot-fleets/device-management#revoke-the-current-identity","Revoke the current identity",{"_3170":785,"_28017":774,"_5":28336,"_19412":47836,"_25509":47837,"_2665":47838},[],"/docs/platform/iot-fleets/device-management#decommission-a-device","Decommission a device",{"_3170":786,"_28017":774,"_5":28336,"_19412":47840,"_25509":47841,"_2665":47842},[],"/docs/platform/iot-fleets/device-management#automate-enrollment","Automate enrollment",{"_3170":787,"_28017":774,"_19412":47844,"_5":13306,"_25509":774,"_2665":47845},[],"This guide is for a fleet operator. You need device, DMS and certificate permissions for the intended actions. A fleet is organized through these resources, tags and metadata; there is no separate “fleet” object to create.",{"_3170":788,"_28017":774,"_19412":47847,"_5":13306,"_25509":774,"_2665":47848},[],"Each device has a `Device ID`, one owning DMS (`dms_owner`) and, once provisioned, an identity slot with an active version and previous versions. In these flows, keep the CSR and certificate `Common Name` equal to `Device ID`: binding uses that CN to update the device.",{"_3170":789,"_28017":774,"_19412":47850,"_5":13306,"_25509":47801,"_2665":47851},[],"Operational view",{"_3170":790,"_28017":774,"_19412":47853,"_5":13306,"_25509":47801,"_2665":47854},[],"Meaning",{"_3170":791,"_28017":774,"_19412":47856,"_5":13306,"_25509":47801,"_2665":47857},[],"**No Identity**",{"_3170":792,"_28017":774,"_19412":47859,"_5":13306,"_25509":47801,"_2665":47860},[],"A record exists without an associated identity.",{"_3170":793,"_28017":774,"_19412":47862,"_5":13306,"_25509":47801,"_2665":47863},[],"**Active**",{"_3170":794,"_28017":774,"_19412":47865,"_5":13306,"_25509":47801,"_2665":47866},[],"The slot is active; also check certificate dates, status and usages.",{"_3170":795,"_28017":774,"_19412":47868,"_5":13306,"_25509":47801,"_2665":47869},[],"**Renewal Pending**",{"_3170":796,"_28017":774,"_19412":47871,"_5":13306,"_25509":47801,"_2665":47872},[],"The identity is in the operational renewal window.",{"_3170":797,"_28017":774,"_19412":47874,"_5":13306,"_25509":47801,"_2665":47875},[],"**Expiring Soon**",{"_3170":798,"_28017":774,"_19412":47877,"_5":13306,"_25509":47801,"_2665":47878},[],"Expiration is approaching according to configured thresholds.",{"_3170":799,"_28017":774,"_19412":47880,"_5":13306,"_25509":47801,"_2665":47881},[],"**Expired**",{"_3170":800,"_28017":774,"_19412":47883,"_5":13306,"_25509":47801,"_2665":47884},[],"The identity has expired.",{"_3170":801,"_28017":774,"_19412":47886,"_5":13306,"_25509":47801,"_2665":47887},[],"**Revoked**",{"_3170":802,"_28017":774,"_19412":47889,"_5":13306,"_25509":47801,"_2665":47890},[],"The identity is marked revoked.",{"_3170":803,"_28017":774,"_19412":47892,"_5":13306,"_25509":47801,"_2665":47893},[],"**Decommissioned**",{"_3170":804,"_28017":774,"_19412":47895,"_5":13306,"_25509":47801,"_2665":47896},[],"The record is retired and ordinary updates do not restore operation.",{"_3170":805,"_28017":774,"_19412":47898,"_5":13306,"_25509":47801,"_2665":47899},[],"Device, slot and certificate states are distinct. Events and jobs can update the view after saving a certificate; an **Active** label does not establish consumer acceptance.",{"_3170":806,"_28017":774,"_19412":47901,"_5":13306,"_25509":47805,"_2665":47902},[],"Filter the inventory by ID, tags and status. Open details and record the owning DMS, active version and current certificate serial.",{"_3170":807,"_28017":774,"_19412":47904,"_5":13306,"_25509":47805,"_2665":47905},[],"**Certificate History** relates previous and current versions. Replacing the slot does not by itself revoke every previous version.",{"_3170":808,"_28017":774,"_19412":47907,"_5":13306,"_25509":47805,"_2665":47908},[],"**Device Event Timeline** helps reconstruct registration, provisioning, renewal and status changes. A change may be saved even if event persistence fails; also inspect the record and certificates.",{"_3170":809,"_28017":774,"_19412":47910,"_5":13306,"_25509":47805,"_2665":47911},[],"Compare these values with the identity installed on the device. Updating a Lamassu slot does not install files on the remote equipment.",{"_3170":810,"_28017":774,"_19412":47913,"_5":13306,"_25509":47809,"_2665":47914},[],"Use this flow to prepare inventory or assign an identity through the console. You need an existing DMS.",{"_3170":811,"_28017":774,"_19412":47916,"_5":13306,"_25509":47813,"_2665":47917},[],"Open registration in **Managed Devices**. Confirm the ID does not already exist in another DMS: ID lookup is not restricted to a fleet.",{"_3170":812,"_28017":774,"_19412":47919,"_5":13306,"_25509":47817,"_2665":47920},[],"Enter **Device ID** and select its owning DMS. The console’s **Registration Authority** label refers to that DMS.",{"_3170":813,"_28017":774,"_19412":47922,"_5":13306,"_25509":47821,"_2665":47923},[],"Add model, environment or location tags and an icon according to your inventory.",{"_3170":814,"_28017":774,"_19412":47925,"_5":13306,"_25509":47825,"_2665":47926},[],"Read the device again: require the intended DMS and **No Identity**. Follow Manual registration to complete assignment.",{"_3170":815,"_28017":774,"_19412":47928,"_5":13306,"_25509":47825,"_2665":47929},[],"Preregistration does not establish that `/simpleenroll` will admit the request. Review its interaction with `enable_replaceable_enrollment` in Provisioning strategies.",{"_3170":816,"_28017":774,"_19412":47931,"_5":13306,"_25509":47829,"_2665":47932},[],"From **No Identity**, use **Assign Identity**:",{"_3170":817,"_28017":774,"_19412":47934,"_5":13306,"_25509":47829,"_2665":47935},[],"Select an active, current certificate suitable for the consumer, with `CN` exactly equal to `Device ID`.",{"_3170":818,"_28017":774,"_19412":47937,"_5":13306,"_25509":47829,"_2665":47938},[],"If unavailable, **Issue New Instead** starts issuance using the intended CA. Review the profile first.",{"_3170":819,"_28017":774,"_19412":47940,"_5":13306,"_25509":47829,"_2665":47941},[],"Confirm and read the serial, active version and history again.",{"_3170":820,"_28017":774,"_19412":47943,"_5":13306,"_25509":47829,"_2665":47944},[],"Install the key/certificate pair and required intermediates on the device and test usage.",{"_3170":821,"_28017":774,"_19412":47946,"_5":13306,"_25509":47829,"_2665":47947},[],"Issuing, binding and installing are separate steps. If an operation fails, check which steps persisted before repeating it.",{"_3170":822,"_28017":774,"_19412":47949,"_5":13306,"_25509":47833,"_2665":47950},[],"Locate the active serial in history and revoke it with an appropriate reason. Verify the record, OCSP/CRL publication and rejection of a new consumer connection using the certificate guide.",{"_3170":823,"_28017":774,"_19412":47952,"_5":13306,"_25509":47833,"_2665":47953},[],"Revocation does not remove the device. It does not automatically enable another enrollment either: recovery depends on its credential, status and DMS policy. `CertificateHold` can be reactivated under PKI conditions; other reasons block subsequent certificate changes.",{"_3170":824,"_28017":774,"_19412":47955,"_5":13306,"_25509":47837,"_2665":47956},[],"Before **Decommission**, inventory active and previous identities, connections and destination permissions. Prepare retirement in the consumer.",{"_3170":825,"_28017":774,"_19412":47958,"_5":13306,"_25509":47837,"_2665":47959},[],"The backend saves **Decommissioned** and attempts to revoke the active version’s certificate with `CessationOfOperation` if the slot was not expired or revoked. It does not traverse all history. Deferred revocation can fail after retirement is saved; check the result by serial.",{"_3170":826,"_28017":774,"_19412":47961,"_5":13306,"_25509":47837,"_2665":47962},[],"Retired status protects ordinary device and slot updates. It does not guarantee that every EST request is rejected before issuance: binding can skip a retired device without returning an error. Check for remaining usable certificates or permissions and block new admission in the relevant control.",{"_3170":827,"_28017":774,"_19412":47964,"_5":13306,"_25509":47837,"_2665":47965},[],"Retain records according to audit policy. Do not reuse a retired ID to hide an equipment change.",{"_3170":828,"_28017":774,"_19412":47967,"_5":13306,"_25509":47841,"_2665":47968},[],"<Card title=\"Enroll and connect a device\" description=\"Obtain an identity from the client and test mTLS.\" href=\"/docs/platform/iot-fleets/quickstarts/enroll-device\" />",{"_3170":829,"_28017":774,"_19412":47970,"_5":13306,"_25509":47841,"_2665":47971},[],"<Card title=\"Renewal and recovery\" description=\"Install the successor and handle failures without losing known state.\" href=\"/docs/platform/iot-fleets/enrollment/renewal-and-recovery\" />",{"_3170":830,"_28017":830,"_5":13637,"_2665":47973,"_28339":47974,"_19412":47976,"_25509":830},"Bootstrap identity and authentication",[45393,46786,47794,47792,47975],"Enrollment with PKI",[],{"_3170":831,"_28017":830,"_19412":47978,"_5":13306,"_25509":830,"_2665":47979},[],"Prepare server trust and admission proofs for enroll and reenroll.",{"_3170":832,"_28017":830,"_5":28336,"_19412":47981,"_25509":47982,"_2665":47983},[],"/docs/platform/iot-fleets/enrollment/bootstrap-identity#initial-server-trust","Initial server trust",{"_3170":833,"_28017":830,"_5":28336,"_19412":47985,"_25509":47986,"_2665":47987},[],"/docs/platform/iot-fleets/enrollment/bootstrap-identity#bootstrap-credential","Bootstrap credential",{"_3170":834,"_28017":830,"_5":28336,"_19412":47989,"_25509":47990,"_2665":47991},[],"/docs/platform/iot-fleets/enrollment/bootstrap-identity#modes-per-operation","Modes per operation",{"_3170":835,"_28017":830,"_5":28336,"_19412":47993,"_25509":47994,"_2665":47995},[],"/docs/platform/iot-fleets/enrollment/bootstrap-identity#webhook-contract","Webhook contract",{"_3170":836,"_28017":830,"_5":28336,"_19412":47997,"_25509":47998,"_2665":47999},[],"/docs/platform/iot-fleets/enrollment/bootstrap-identity#revocation-and-checks","Revocation and checks",{"_3170":837,"_28017":830,"_19412":48001,"_5":13306,"_25509":830,"_2665":48002},[],"This guide connects the DMS administrator with device manufacturing and integration. Before requesting an operational identity, the client must authenticate the EST server and establish entitlement to request the intended ID.",{"_3170":838,"_28017":830,"_19412":48004,"_5":13306,"_25509":47982,"_2665":48005},[],"Install a previously verified root, chain or pin through a trusted channel: manufacturing, approved configuration or authenticated distribution. It enables TLS and server-name verification before downloading `/cacerts`.",{"_3170":839,"_28017":830,"_19412":48007,"_5":13306,"_25509":47982,"_2665":48008},[],"Your only trust proof cannot come from the same unauthenticated server. The EST server TLS certificate, bootstrap certificate and operational identity issuer may belong to different hierarchies.",{"_3170":840,"_28017":830,"_19412":48010,"_5":13306,"_25509":47986,"_2665":48011},[],"With `CLIENT_CERTIFICATE`, the device presents its initial certificate and proves key possession through TLS. The DMS validates it against admission CAs. In the inspected flow, the validator receives one leaf credential: configure and test the direct issuer for the simple case; sending more intermediates does not establish delivery to the service.",{"_3170":841,"_28017":830,"_19412":48013,"_5":13306,"_25509":47986,"_2665":48014},[],"Check dates, matching certificate/key and revocation before provisioning. A credential shared across equipment identifies that shared credential, not an individual device.",{"_3170":842,"_28017":830,"_19412":48016,"_5":13306,"_25509":47986,"_2665":48017},[],"Initial mTLS validation does not by itself compare bootstrap CN with the requested CSR CN. If a requester should only request its own `Device ID`, add a control binding credential to ID, such as the combined webhook, and test a request with another CN. Certificate re-enrollment does compare its CN to the CSR; subsequent checks use the registered active identity.",{"_3170":843,"_28017":830,"_19412":48019,"_5":13306,"_25509":47990,"_2665":48020},[],"Select the four modes independently for enrollment and re-enrollment in DMS. Renewal credentials depend on that block; do not assume the bootstrap is always used or the webhook disappears.",{"_3170":844,"_28017":830,"_19412":48022,"_5":13306,"_25509":47990,"_2665":48023},[],"An administrative OIDC token is not a native EST mode. A webhook may interpret an agreed credential header; that service then performs authorization. In NO\\_AUTH, sending a token does not add DMS authentication.",{"_3170":845,"_28017":830,"_19412":48025,"_5":13306,"_25509":47994,"_2665":48026},[],"The DMS sends operation context to the configured service. Method comes from configuration; agree the contract before selecting POST or PUT. Authorization wait defaults to 10 seconds, replaced by a configured positive timeout. The DMS verifies the receiver certificate unless `insecure_skip_verify` is enabled in the webhook config — verification is on by default — and does not follow redirects, so the configured URL must be the final one. The authorization response must be JSON of at most 1 MiB. With Lamassu-to-webhook authentication configured over `http://`, the API key or bearer token travels in cleartext, and mTLS has no effect because no TLS handshake takes place, so the client certificate is never presented; prefer `https://`. Configure those options in the webhook settings of the DMS guide.",{"_3170":846,"_28017":830,"_19412":48028,"_5":13306,"_25509":47994,"_2665":48029},[],"Example body:",{"_3170":847,"_28017":830,"_19412":48031,"_5":13306,"_25509":47994,"_2665":48032},[],"`csr` is **base64 of PEM**, unlike the EST body, which is base64 of DER. `http_request` contains URL and first header entries from available HTTP context. This body does not include an `operation` field; distinguish enroll and reenroll through the path and configured policy.",{"_3170":848,"_28017":830,"_19412":48034,"_5":13306,"_25509":47994,"_2665":48035},[],"The webhook should verify credential, its relationship to `device_cn`, DMS, operation and admission policy. Forwarded headers are not themselves trusted evidence. **Lamassu-to-webhook authentication** is a separate relationship configured in the server’s HTTP client.",{"_3170":849,"_28017":830,"_19412":48037,"_5":13306,"_25509":47994,"_2665":48038},[],"Continuation requires a successful HTTP response and JSON:",{"_3170":850,"_28017":830,"_19412":48040,"_5":13306,"_25509":47994,"_2665":48041},[],"A bodyless `204` does not satisfy the contract. Denial, transport error, uninterpretable response or timeout abort authorization. Combined mode validates the certificate first, then queries the webhook. See the webhook specification.",{"_3170":851,"_28017":830,"_19412":48043,"_5":13306,"_25509":47998,"_2665":48044},[],"The DMS first looks up the certificate in Lamassu; for external certificates it attempts OCSP and CRL. If revocation cannot be checked, validators can continue treating it as not revoked. The code also does not establish rejection of every external status other than Good. Test required behavior with your actual credential and endpoint; do not present this as guaranteed strict enforcement across every source.",{"_3170":852,"_28017":830,"_19412":48046,"_5":13306,"_25509":47998,"_2665":48047},[],"Test an allowed certificate, an incorrect one, another CN, webhook denial, timeout and re-enrollment under its own policy. Keep results and schedule bootstrap credential retirement where appropriate. Continue with EST client.",{"_3170":853,"_28017":853,"_5":13637,"_2665":48049,"_28339":48050,"_19412":48051,"_25509":853},"Configure and operate the DMS",[45393,46786,47794,47792,47975],[],{"_3170":854,"_28017":853,"_19412":48053,"_5":13306,"_25509":853,"_2665":48054},[],"Define registration, authentication per operation, issuance, renewal and distributed trust.",{"_3170":855,"_28017":853,"_5":28336,"_19412":48056,"_25509":48057,"_2665":45403},[],"/docs/platform/iot-fleets/enrollment/dms#before-you-begin",{"_3170":856,"_28017":853,"_5":28336,"_19412":48059,"_25509":48060,"_2665":48061},[],"/docs/platform/iot-fleets/enrollment/dms#configure-a-dms","Configure a DMS",{"_3170":857,"_28017":853,"_5":28336,"_19412":48063,"_25509":48064,"_2665":48065},[],"/docs/platform/iot-fleets/enrollment/dms#identify-the-fleet","Identify the fleet",{"_3170":858,"_28017":853,"_5":28336,"_19412":48067,"_25509":48068,"_2665":48069},[],"/docs/platform/iot-fleets/enrollment/dms#select-the-enrollment-ca","Select the enrollment CA",{"_3170":859,"_28017":853,"_5":28336,"_19412":48071,"_25509":48072,"_2665":48073},[],"/docs/platform/iot-fleets/enrollment/dms#configure-est","Configure EST",{"_3170":860,"_28017":853,"_5":28336,"_19412":48075,"_25509":48076,"_2665":48077},[],"/docs/platform/iot-fleets/enrollment/dms#distribute-trust","Distribute trust",{"_3170":861,"_28017":853,"_5":28336,"_19412":48079,"_25509":48080,"_2665":48081},[],"/docs/platform/iot-fleets/enrollment/dms#verify-the-endpoints","Verify the endpoints",{"_3170":862,"_28017":853,"_5":28336,"_19412":48083,"_25509":48084,"_2665":48085},[],"/docs/platform/iot-fleets/enrollment/dms#enrollment-configuration","Enrollment configuration",{"_3170":863,"_28017":853,"_5":28336,"_19412":48087,"_25509":48088,"_2665":48089},[],"/docs/platform/iot-fleets/enrollment/dms#enrollment-device-registration","Enrollment Device Registration",{"_3170":864,"_28017":853,"_5":28336,"_19412":48091,"_25509":48092,"_2665":48093},[],"/docs/platform/iot-fleets/enrollment/dms#enrollment-settings","Enrollment Settings",{"_3170":865,"_28017":853,"_5":28336,"_19412":48095,"_25509":48096,"_2665":48097},[],"/docs/platform/iot-fleets/enrollment/dms#authentication-per-operation","Authentication per operation",{"_3170":866,"_28017":853,"_5":28336,"_19412":48099,"_25509":48100,"_2665":48101},[],"/docs/platform/iot-fleets/enrollment/dms#external-webhook-settings","External webhook settings",{"_3170":867,"_28017":853,"_5":28336,"_19412":48103,"_25509":48104,"_2665":48105},[],"/docs/platform/iot-fleets/enrollment/dms#issuance-profile","Issuance profile",{"_3170":868,"_28017":853,"_5":28336,"_19412":48107,"_25509":48108,"_2665":48109},[],"/docs/platform/iot-fleets/enrollment/dms#re-enrollment-configuration","Re-enrollment configuration",{"_3170":869,"_28017":853,"_5":28336,"_19412":48111,"_25509":48112,"_2665":48113},[],"/docs/platform/iot-fleets/enrollment/dms#serverkeygen","ServerKeyGen",{"_3170":870,"_28017":853,"_5":28336,"_19412":48115,"_25509":48116,"_2665":48117},[],"/docs/platform/iot-fleets/enrollment/dms#trust-distribution","Trust distribution",{"_3170":871,"_28017":853,"_5":28336,"_19412":48119,"_25509":48120,"_2665":48121},[],"/docs/platform/iot-fleets/enrollment/dms#operate-the-dms-inventory","Operate the DMS inventory",{"_3170":872,"_28017":853,"_5":28336,"_19412":48123,"_25509":48124,"_2665":48125},[],"/docs/platform/iot-fleets/enrollment/dms#integrate-the-devices","Integrate the devices",{"_3170":873,"_28017":853,"_19412":48127,"_5":13306,"_25509":853,"_2665":48128},[],"A &#x2A;*Device Management Service (DMS)** configures admission and identity lifecycle for its devices. It acts as a registration authority; the CA selected in `Enrollment CA` signs certificates. This guide is for the policy administrator.",{"_3170":874,"_28017":853,"_19412":48130,"_5":13306,"_25509":48057,"_2665":48131},[],"You need DMS management permissions, an active CA with a usable key and a tested issuance profile. Agree device ID, initial credential, consumer and renewal window with the integrator. Review Provisioning strategies before choosing registration and replacement.",{"_3170":875,"_28017":853,"_19412":48133,"_5":13306,"_25509":48057,"_2665":48134},[],"Prepare EST server trust and device connectivity through Deployment. Your operator’s administrative authentication does not replace device EST authentication.",{"_3170":876,"_28017":853,"_19412":48136,"_5":13306,"_25509":48064,"_2665":48137},[],"Create the DMS with a recognizable name and retain its ID. EST URLs use this identifier, not the display name. Each device retains one owning DMS.",{"_3170":877,"_28017":853,"_19412":48139,"_5":13306,"_25509":48068,"_2665":48140},[],"Choose **Enrollment CA** and an explicit profile appropriate for the end-entity identity. Keep CN compatible with `Device ID`. The test certificate should allow its intended purpose and expire within issuer validity.",{"_3170":878,"_28017":853,"_19412":48142,"_5":13306,"_25509":48072,"_2665":48143},[],"Select initial enrollment registration and authentication. Separately configure re-enrollment authentication, thresholds and previous certificate retirement. Leave ServerKeyGen disabled if the client generates its key.",{"_3170":879,"_28017":853,"_19412":48145,"_5":13306,"_25509":48076,"_2665":48146},[],"Select certificates returned by `/cacerts`. Explicitly include required intermediates and roots, keeping distribution distinct from automatic trust installation.",{"_3170":880,"_28017":853,"_19412":48148,"_5":13306,"_25509":48080,"_2665":48149},[],"Save and read configuration again. Query `/cacerts`, perform an allowed and a rejected enrollment, and inspect device, serial and history. Creating the DMS or downloading cacerts does not establish working authentication and issuance.",{"_3170":881,"_28017":853,"_19412":48151,"_5":13306,"_25509":48088,"_2665":48152},[],"`settings.enrollment_settings.registration_mode` accepts `JITP` or `PRE_REGISTRATION`. JITP creates an unknown device with the CSR CN as ID and the DMS as owner. `device_provisioning_profile` supplies tags, metadata and icon for that registration.",{"_3170":882,"_28017":853,"_19412":48154,"_5":13306,"_25509":48088,"_2665":48155},[],"PRE\\_REGISTRATION requires an existing ID. In the inspected code, an existing device encounters replacement checks first, even without an identity. Review preregistration conditions before using this mode.",{"_3170":883,"_28017":853,"_19412":48157,"_5":13306,"_25509":48092,"_2665":48158},[],"`settings.enrollment_settings` field",{"_3170":884,"_28017":853,"_19412":48160,"_5":13306,"_25509":48092,"_2665":48161},[],"Decision",{"_3170":885,"_28017":853,"_19412":48163,"_5":13306,"_25509":48092,"_2665":48164},[],"`protocol`",{"_3170":886,"_28017":853,"_19412":48166,"_5":13306,"_25509":48092,"_2665":48167},[],"`EST_RFC7030` for these operations.",{"_3170":887,"_28017":853,"_19412":48169,"_5":13306,"_25509":48092,"_2665":48170},[],"`enrollment_ca`",{"_3170":888,"_28017":853,"_19412":48172,"_5":13306,"_25509":48092,"_2665":48173},[],"ID of the signing CA.",{"_3170":889,"_28017":853,"_19412":48175,"_5":13306,"_25509":48092,"_2665":48176},[],"`verify_csr_signature`",{"_3170":890,"_28017":853,"_19412":48178,"_5":13306,"_25509":48092,"_2665":48179},[],"Keep `true` to verify CSR key possession.",{"_3170":891,"_28017":853,"_19412":48181,"_5":13306,"_25509":48092,"_2665":48182},[],"`enable_replaceable_enrollment`",{"_3170":892,"_28017":853,"_19412":48184,"_5":13306,"_25509":48092,"_2665":48185},[],"Allows `/simpleenroll` for an existing ID in the same DMS. It can attempt previous certificate revocation even if a later phase fails; this is not atomic.",{"_3170":893,"_28017":853,"_19412":48187,"_5":13306,"_25509":48092,"_2665":48188},[],"`est_rfc7030_settings.auth_mode`",{"_3170":894,"_28017":853,"_19412":48190,"_5":13306,"_25509":48092,"_2665":48191},[],"One of the four authentication modes.",{"_3170":895,"_28017":853,"_19412":48193,"_5":13306,"_25509":48092,"_2665":48194},[],"Initial enrollment rejects an ID owned by another DMS. Do not automatically enable replacement in response to an error; Troubleshooting distinguishes repeated IDs, ownership and partial changes.",{"_3170":896,"_28017":853,"_19412":48196,"_5":13306,"_25509":48096,"_2665":48197},[],"The blocks are independent:",{"_3170":897,"_28017":853,"_19412":48199,"_5":13306,"_25509":48096,"_2665":48200},[],"`settings.enrollment_settings.est_rfc7030_settings` for `/simpleenroll` and `/serverkeygen`.",{"_3170":898,"_28017":853,"_19412":48202,"_5":13306,"_25509":48096,"_2665":48203},[],"`settings.reenrollment_settings.est_rfc7030_settings` for `/simplereenroll`.",{"_3170":899,"_28017":853,"_19412":48205,"_5":13306,"_25509":48096,"_2665":48206},[],"`auth_mode`",{"_3170":900,"_28017":853,"_19412":48208,"_5":13306,"_25509":48096,"_2665":48209},[],"Control applied in the configured operation",{"_3170":901,"_28017":853,"_19412":48211,"_5":13306,"_25509":48096,"_2665":48212},[],"`CLIENT_CERTIFICATE`",{"_3170":902,"_28017":853,"_19412":48214,"_5":13306,"_25509":48096,"_2665":48215},[],"Presented certificate validation.",{"_3170":903,"_28017":853,"_19412":48217,"_5":13306,"_25509":48096,"_2665":48218},[],"`EXTERNAL_WEBHOOK`",{"_3170":904,"_28017":853,"_19412":48220,"_5":13306,"_25509":48096,"_2665":48221},[],"Configured webhook authorization.",{"_3170":905,"_28017":853,"_19412":48223,"_5":13306,"_25509":48096,"_2665":48224},[],"`CLIENT_CERTIFICATE_AND_EXTERNAL_WEBHOOK`",{"_3170":906,"_28017":853,"_19412":48226,"_5":13306,"_25509":48096,"_2665":48227},[],"Certificate validation followed by webhook approval.",{"_3170":907,"_28017":853,"_19412":48229,"_5":13306,"_25509":48096,"_2665":48230},[],"`NO_AUTH`",{"_3170":908,"_28017":853,"_19412":48232,"_5":13306,"_25509":48096,"_2665":48233},[],"No DMS requester authentication.",{"_3170":909,"_28017":853,"_19412":48235,"_5":13306,"_25509":48096,"_2665":48236},[],"Webhook and combined modes also execute during re-enrollment when configured in its block. They do not implicitly degrade to NO\\_AUTH. An absent or unrecognized mode fails.",{"_3170":910,"_28017":853,"_19412":48238,"_5":13306,"_25509":48096,"_2665":48239},[],"For initial mTLS, `client_certificate_settings` contains `validation_cas`, `allow_expired` and `chain_level_validation`. The inspected flow receives one certificate credential; it does not guarantee forwarding every handshake intermediate to the validator. For a direct case, configure the bootstrap’s direct issuer as validation CA and test the actual Gateway path.",{"_3170":911,"_28017":853,"_19412":48241,"_5":13306,"_25509":48096,"_2665":48242},[],"For certificate re-enrollment, the validator tries the enrollment CA first and then the CAs listed in `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`; those are the re-enrollment validation CAs. That list is optional because the enrollment CA is always trusted for re-enrollment, and each settings block consults only its own `validation_cas`. CAs listed only in the initial block's `validation_cas` do not extend re-enrollment acceptance; during a CA rotation, add the old issuance CA to the re-enrollment block's list. The re-enrollment validator compares the presented TLS leaf against those CAs; the re-enrollment block's `chain_level_validation` and `allow_expired` values are stored but not consulted, and expiry is governed by `enable_expired_renewal`.",{"_3170":912,"_28017":853,"_19412":48244,"_5":13306,"_25509":48096,"_2665":48245},[],"For a webhook, configure destination, Lamassu-to-service authentication, method and timeout. The authentication contract explains the device credential and request body. `NO_AUTH` does not establish ownership of the requested ID.",{"_3170":913,"_28017":853,"_19412":48247,"_5":13306,"_25509":48100,"_2665":48248},[],"The webhook authentication modes read `external_webhook_settings` in the same `est_rfc7030_settings` block:",{"_3170":914,"_28017":853,"_19412":48250,"_5":13306,"_25509":48100,"_2665":48251},[],"`external_webhook_settings` field",{"_3170":915,"_28017":853,"_19412":48253,"_5":13306,"_25509":48100,"_2665":48161},[],{"_3170":916,"_28017":853,"_19412":48255,"_5":13306,"_25509":48100,"_2665":48256},[],"`url`",{"_3170":917,"_28017":853,"_19412":48258,"_5":13306,"_25509":48100,"_2665":48259},[],"Absolute `http` or `https` URL of the receiver. It must be the final URL; redirects are not followed.",{"_3170":918,"_28017":853,"_19412":48261,"_5":13306,"_25509":48100,"_2665":48262},[],"`method`",{"_3170":919,"_28017":853,"_19412":48264,"_5":13306,"_25509":48100,"_2665":48265},[],"`POST` or `PUT`; `POST` by default.",{"_3170":920,"_28017":853,"_19412":48267,"_5":13306,"_25509":48100,"_2665":48268},[],"`name`",{"_3170":921,"_28017":853,"_19412":48270,"_5":13306,"_25509":48100,"_2665":48271},[],"Label used in service logs.",{"_3170":922,"_28017":853,"_19412":48273,"_5":13306,"_25509":48100,"_2665":48274},[],"`config.auth_mode`",{"_3170":923,"_28017":853,"_19412":48276,"_5":13306,"_25509":48100,"_2665":48277},[],"`noauth`, `apikey`, `jwt` or `mtls`. An absent or unknown value behaves as `noauth`.",{"_3170":924,"_28017":853,"_19412":48279,"_5":13306,"_25509":48100,"_2665":48280},[],"`config.log_level`",{"_3170":925,"_28017":853,"_19412":48282,"_5":13306,"_25509":48100,"_2665":48283},[],"Log level of the webhook call: `debug`, `info`, `warn` or `error`; `info` by default.",{"_3170":926,"_28017":853,"_19412":48285,"_5":13306,"_25509":48100,"_2665":48286},[],"`config.apikey_options`",{"_3170":927,"_28017":853,"_19412":48288,"_5":13306,"_25509":48100,"_2665":48289},[],"Required for `apikey`: `header` and `key`. Reserved header names are rejected.",{"_3170":928,"_28017":853,"_19412":48291,"_5":13306,"_25509":48100,"_2665":48292},[],"`config.jwt_options`",{"_3170":929,"_28017":853,"_19412":48294,"_5":13306,"_25509":48100,"_2665":48295},[],"Required for `jwt`: `oidc_client_id`, `oidc_client_secret` and an absolute `http` or `https` `oidc_well_known`.",{"_3170":930,"_28017":853,"_19412":48297,"_5":13306,"_25509":48100,"_2665":48298},[],"`config.mtls_options`",{"_3170":931,"_28017":853,"_19412":48300,"_5":13306,"_25509":48100,"_2665":48301},[],"Required for `mtls`: `cert_content` and `key_content` as Base64-encoded PEM, like certificates elsewhere in the API; plain PEM is also accepted.",{"_3170":932,"_28017":853,"_19412":48303,"_5":13306,"_25509":48100,"_2665":48304},[],"`config.insecure_skip_verify`",{"_3170":933,"_28017":853,"_19412":48306,"_5":13306,"_25509":48100,"_2665":48307},[],"Skips verification of the receiver certificate when `true`. Verification is on by default. Unlike alert channels, this flag is honored here.",{"_3170":934,"_28017":853,"_19412":48309,"_5":13306,"_25509":48100,"_2665":48310},[],"`config.call_timeout`",{"_3170":935,"_28017":853,"_19412":48312,"_5":13306,"_25509":48100,"_2665":48313},[],"Maximum duration of the authorization call (for example `10s`); 10 seconds by default.",{"_3170":936,"_28017":853,"_19412":48315,"_5":13306,"_25509":48100,"_2665":48316},[],"Rules for that configuration:",{"_3170":937,"_28017":853,"_19412":48318,"_5":13306,"_25509":48100,"_2665":48319},[],"Creating or updating a DMS whose enrollment or reenrollment `auth_mode` uses the webhook validates the block and returns HTTP 400 — the body starts with `struct validation error:` and continues with `invalid enrollment external webhook config` or `invalid reenrollment external webhook config` — when the URL, method or options are invalid. That includes an `mtls_options.cert_content`/`key_content` pair that does not decode to a matching certificate and private key. File references (`ca_cert_file`, `mtls_options.cert_file`, `mtls_options.key_file`) are always invalid: the service does not read files, so enter the certificate and key as Base64-encoded PEM in `mtls_options.cert_content` and `key_content`, or as plain PEM.",{"_3170":938,"_28017":853,"_19412":48321,"_5":13306,"_25509":48100,"_2665":48322},[],"A custom `apikey_options.header` may not use names that the platform or the receiving service trusts — for example `X-Principal-Id`, `X-Request-Id`, `Host`, `Content-Type` or `Forwarded` — and no name may start with `X-Forwarded-`, `X-Envoy-` or `X-Lms-` (case-insensitive). The DMS API reference documents the `WebhookCall` and `WebhookCallHttpClient` schemas and that reserved API-key headers are rejected.",{"_3170":939,"_28017":853,"_19412":48324,"_5":13306,"_25509":48100,"_2665":48325},[],"The nested `http_client` key exists only in alert channel configurations; in a DMS body it is ignored. The DMS key is `external_webhook_settings.config`.",{"_3170":940,"_28017":853,"_19412":48327,"_5":13306,"_25509":48100,"_2665":48328},[],"A body with `config.auth_mode` set to `apikey`, `jwt` or `mtls` must carry its corresponding option block (`apikey_options`, `jwt_options` or `mtls_options`) — and nothing else. Bodies with those auth modes carrying only `apikey`, `oidc` or `mtls` fail validation with 400, and `validate_server_cert` is always ignored: use `insecure_skip_verify`. Only bodies without option blocks are accepted as `noauth`, and their credentials are dropped.",{"_3170":941,"_28017":853,"_19412":48330,"_5":13306,"_25509":48100,"_2665":48331},[],"The authorization response must be JSON of at most 1 MiB; a larger body fails the call.",{"_3170":942,"_28017":853,"_19412":48333,"_5":13306,"_25509":48100,"_2665":48334},[],"With credentials configured, they are sent regardless of the URL scheme: an `http://` webhook receives the API key or bearer token in cleartext, and mTLS has no effect because no TLS handshake takes place, so the client certificate is never presented. Prefer `https://` for `url`, `oidc_well_known` and the token endpoint it advertises.",{"_3170":943,"_28017":853,"_19412":48336,"_5":13306,"_25509":48100,"_2665":48337},[],"Initial authentication and renewal settings are stored independently. If a DMS only has the initial authentication block, renewal reuses it: read both blocks before editing. The console exposes independent editors for the enrollment and re-enrollment authentication, with the same Log Level, Call Timeout, HTTP Authentication and credential fields as the webhook channels, plus a **Skip TLS Verification** switch (off by default, so verification stays on; the console warns when you enable it).",{"_3170":944,"_28017":853,"_19412":48339,"_5":13306,"_25509":48100,"_2665":48340},[],"Webhook credentials must be stored as PEM content. File references (`ca_cert_file`, `mtls_options.cert_file`, `mtls_options.key_file`) are never valid in a stored webhook config: delivery rejects any webhook config that references files, whatever its auth mode, so every enroll and reenroll that calls that webhook fails until the certificate and key are entered as Base64-encoded or plain PEM in `mtls_options.cert_content` and `key_content`, or the file fields are removed if the webhook does not use mTLS. If a stored config holds file paths in `mtls_options.cert_content` or `key_content`, every full settings update (`POST /v1/dms`, `PUT /v1/dms/:id`) fails validation — settings are replaced wholesale, so the stored config must be resent — until the values are replaced by PEM content or the webhook stops being used. Meanwhile, delivery of that webhook fails on every call; a metadata-only update through `PUT` or `PATCH` on `/v1/dms/:id/metadata` still succeeds. To fix it in the console, open the DMS, replace any file-path value with PEM content — the editor rejects file paths with an inline field error — and save. Saving rewrites `external_webhook_settings.config` with the current keys, and the console reads both plain and Base64-encoded PEM from migrated configurations and stores the material Base64-encoded. If your stored config previously relied on `validate_server_cert: false`, it now carries `insecure_skip_verify: true`: receiver-certificate verification stays skipped until you set that flag to `false`. See 3.8.0 to 4.0.0 for the upgrade notes and the operator checklist.",{"_3170":945,"_28017":853,"_19412":48342,"_5":13306,"_25509":48100,"_2665":48343},[],"The re-enrollment trust set lives in `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`. The flat field `reenrollment_settings.additional_validation_cas` is not part of the API: bodies that carry it are accepted but the value is silently ignored — unknown JSON fields are dropped — and GET responses do not include it. Read the DMS before sending API edits: an update body built with that flat field silently empties `validation_cas`.",{"_3170":946,"_28017":853,"_19412":48345,"_5":13306,"_25509":48104,"_2665":48346},[],"`settings.issuance_profile_id` takes precedence over `settings.issuance_profile`; without either, the CA default profile is used. Rules are documented once in Profiles. DMS changes affect future requests; they do not modify signed certificates or install client trust.",{"_3170":947,"_28017":853,"_19412":48348,"_5":13306,"_25509":48108,"_2665":48349},[],"`settings.reenrollment_settings` field",{"_3170":948,"_28017":853,"_19412":48351,"_5":13306,"_25509":48108,"_2665":45783},[],{"_3170":949,"_28017":853,"_19412":48353,"_5":13306,"_25509":48108,"_2665":48354},[],"`reenrollment_delta`",{"_3170":950,"_28017":853,"_19412":48356,"_5":13306,"_25509":48108,"_2665":48357},[],"Opens the window at the active certificate’s `NotAfter` minus this delta.",{"_3170":951,"_28017":853,"_19412":48359,"_5":13306,"_25509":48108,"_2665":48360},[],"`preventive_delta`",{"_3170":952,"_28017":853,"_19412":48362,"_5":13306,"_25509":48108,"_2665":48363},[],"Preventive operational monitoring threshold.",{"_3170":953,"_28017":853,"_19412":48365,"_5":13306,"_25509":48108,"_2665":48366},[],"`critical_delta`",{"_3170":954,"_28017":853,"_19412":48368,"_5":13306,"_25509":48108,"_2665":48369},[],"Critical operational monitoring threshold.",{"_3170":955,"_28017":853,"_19412":48371,"_5":13306,"_25509":48108,"_2665":48372},[],"`enable_expired_renewal`",{"_3170":956,"_28017":853,"_19412":48374,"_5":13306,"_25509":48108,"_2665":48375},[],"Accepts an expired presented certificate in the renewal mTLS validator. Does not authorize another mode or remove Gateway constraints by itself.",{"_3170":957,"_28017":853,"_19412":48377,"_5":13306,"_25509":48108,"_2665":48378},[],"`est_rfc7030_settings.client_certificate_settings.validation_cas`",{"_3170":958,"_28017":853,"_19412":48380,"_5":13306,"_25509":48108,"_2665":48381},[],"Re-enrollment validation CAs for the renewal mTLS credential, tried after the enrollment CA; optional, because the enrollment CA is always trusted. Typically populated during CA rotation while old-CA cohorts renew.",{"_3170":959,"_28017":853,"_19412":48383,"_5":13306,"_25509":48108,"_2665":48384},[],"`revoke_on_reenrollment`",{"_3170":960,"_28017":853,"_19412":48386,"_5":13306,"_25509":48108,"_2665":48387},[],"If the previous certificate is ACTIVE, attempts Superseded revocation before binding its successor.",{"_3170":961,"_28017":853,"_19412":48389,"_5":13306,"_25509":48108,"_2665":48390},[],"Monitoring does not renew: the client must schedule the request and installation. Webhook and NO\\_AUTH modes do not use the same mTLS expired-credential validator; the webhook must explicitly authorize permitted recovery. Review Renewal and recovery for operation order and partial failures.",{"_3170":962,"_28017":853,"_19412":48392,"_5":13306,"_25509":48112,"_2665":48393},[],"`settings.server_keygen_settings.enabled` enables software key generation on the server. The console exposes it through an **Enable server-side key generation** switch and a **Key type** selection: `ECDSA` P-256, P-384 or P-521, or `RSA` with 2048, 3072 or 4096 bits; the defaults are P-256 for `ECDSA` and 4096 bit for `RSA`. Algorithm and size come from its `key` field, stored as `{type,bits}` where P-256, P-384 and P-521 map to `bits` 256, 384 and 521; `key` is omitted when disabled. The profile must permit them. The response contains an unencrypted PKCS#8 key inside TLS alongside the certificate. See format and extraction in EST reference.",{"_3170":963,"_28017":853,"_19412":48395,"_5":13306,"_25509":48116,"_2665":45777},[],{"_3170":964,"_28017":853,"_19412":48397,"_5":13306,"_25509":48116,"_2665":48398},[],"Published material",{"_3170":965,"_28017":853,"_19412":48400,"_5":13306,"_25509":48116,"_2665":48401},[],"**Include Lamassu System CA**",{"_3170":966,"_28017":853,"_19412":48403,"_5":13306,"_25509":48116,"_2665":48404},[],"Available downstream TLS certificate; it can be a leaf, not an issuing CA.",{"_3170":967,"_28017":853,"_19412":48406,"_5":13306,"_25509":48116,"_2665":48407},[],"**Include Enrollment CA**",{"_3170":968,"_28017":853,"_19412":48409,"_5":13306,"_25509":48116,"_2665":48410},[],"Selected issuing CA certificate.",{"_3170":969,"_28017":853,"_19412":48412,"_5":13306,"_25509":48116,"_2665":48413},[],"**Managed CAs**",{"_3170":970,"_28017":853,"_19412":48415,"_5":13306,"_25509":48116,"_2665":48416},[],"Explicitly selected CA certificates.",{"_3170":971,"_28017":853,"_19412":48418,"_5":13306,"_25509":48116,"_2665":48419},[],"All ancestors are not added automatically. Trust distribution distinguishes trusted roots, intermediates and initial server trust.",{"_3170":972,"_28017":853,"_19412":48421,"_5":13306,"_25509":48120,"_2665":48422},[],"**Edit** changes name, settings and metadata. Backend updates replace these complete blocks; read the DMS before sending API edits to avoid losing fields.",{"_3170":973,"_28017":853,"_19412":48424,"_5":13306,"_25509":48120,"_2665":48425},[],"**Go to DMS owned devices** restricts inventory by owner. **Show/Edit Metadata** contains operational and integration data; consult the integration guide before changing it. &#x2A;*EST (RFC-7030)** helps locate URLs.",{"_3170":974,"_28017":853,"_19412":48427,"_5":13306,"_25509":48120,"_2665":48428},[],"**Delete** removes the DMS record and configuration; it does not itself cascade revocation across every device and certificate. Migrate dependencies and retain audit references before retirement.",{"_3170":975,"_28017":853,"_19412":48430,"_5":13306,"_25509":48124,"_2665":48431},[],"Continue with EST client or the enrollment and mTLS tutorial. EST reference covers formats; Troubleshooting covers failures.",{"_3170":976,"_28017":976,"_5":13637,"_2665":48433,"_28339":48434,"_19412":48435,"_25509":976},"Integrate the EST client",[45393,46786,47794,47792,47975],[],{"_3170":977,"_28017":976,"_19412":48437,"_5":13306,"_25509":976,"_2665":48438},[],"Prepare trust, send a CSR and check the identity you receive.",{"_3170":978,"_28017":976,"_5":28336,"_19412":48440,"_25509":48441,"_2665":45403},[],"/docs/platform/iot-fleets/enrollment/est-client#before-you-begin",{"_3170":979,"_28017":976,"_5":28336,"_19412":48443,"_25509":48444,"_2665":48445},[],"/docs/platform/iot-fleets/enrollment/est-client#download-and-inspect-cacerts","Download and inspect cacerts",{"_3170":980,"_28017":976,"_5":28336,"_19412":48447,"_25509":48448,"_2665":48449},[],"/docs/platform/iot-fleets/enrollment/est-client#prepare-the-csr","Prepare the CSR",{"_3170":981,"_28017":976,"_5":28336,"_19412":48451,"_25509":48452,"_2665":48453},[],"/docs/platform/iot-fleets/enrollment/est-client#request-the-identity","Request the identity",{"_3170":982,"_28017":976,"_5":28336,"_19412":48455,"_25509":48456,"_2665":48457},[],"/docs/platform/iot-fleets/enrollment/est-client#check-and-install-the-result","Check and install the result",{"_3170":983,"_28017":976,"_5":28336,"_19412":48459,"_25509":48460,"_2665":48461},[],"/docs/platform/iot-fleets/enrollment/est-client#next-steps","Next steps",{"_3170":984,"_28017":976,"_19412":48463,"_5":13306,"_25509":976,"_2665":48464},[],"This guide is for those implementing the device client. The administrator must have prepared the DMS policy. For a complete first run, follow Enroll and connect your first device.",{"_3170":985,"_28017":976,"_19412":48466,"_5":13306,"_25509":48441,"_2665":48467},[],"You need the public HTTPS DMS URL, server trust obtained through an approved channel, the operation's authentication mode and an admitted identifier. The examples use Bash, OpenSSL 3.x and curl with `--fail-with-body`; use a private working directory and compatible versions of these tools.",{"_3170":986,"_28017":976,"_19412":48469,"_5":13306,"_25509":48441,"_2665":48470},[],"Prepare `est-trust.pem` to verify the EST server, `bootstrap.crt` and `bootstrap.key` for initial certificate authentication, and `device-root.pem` as the approved root of the device issuer. The two trust files can contain different roots. For another authentication mode, adapt the credentials according to Bootstrap identity.",{"_3170":987,"_28017":976,"_19412":48472,"_5":13306,"_25509":48441,"_2665":48473},[],"Replace the host and `REPLACE_DMS_ID` with those of your installation. The URL's APS is the DMS identifier, not its display name.",{"_3170":988,"_28017":976,"_19412":48475,"_5":13306,"_25509":48444,"_2665":48476},[],"The default content is Base64-encoded DER PKCS#7. It is not a direct PEM file.",{"_3170":989,"_28017":976,"_19412":48478,"_5":13306,"_25509":48444,"_2665":48479},[],"Check fingerprints, issuers and dates against the trust distribution policy. The response can contain a selection of CAs and Lamassu's TLS certificate. Do not turn the entire bundle into trusted roots or use it to authenticate its own initial download. HTTP 200 here does not prove that authentication or issuance works.",{"_3170":990,"_28017":976,"_19412":48481,"_5":13306,"_25509":48448,"_2665":48482},[],"The example generates a new EC P-256 key and uses `est-device-001`, which must be available if the DMS registers automatically. The `Common Name` becomes the device identifier. Check that the profile permits the selected key and subject.",{"_3170":991,"_28017":976,"_19412":48484,"_5":13306,"_25509":48448,"_2665":48485},[],"An implementation using hardware or its own store must produce the CSR through its resident key. `simpleenroll` sends the request and retains the key in the client. Honor Extensions does not authorize every requested attribute: see Profiles.",{"_3170":992,"_28017":976,"_19412":48487,"_5":13306,"_25509":48452,"_2665":48488},[],"With initial `CLIENT_CERTIFICATE` authentication, send the Base64-encoded DER CSR using `Content-Type: application/pkcs10`:",{"_3170":993,"_28017":976,"_19412":48490,"_5":13306,"_25509":48452,"_2665":48491},[],"Stop if curl fails. Retain the HTTP code, headers and body for diagnosis; an error response is not decoded as a certificate. The Bash example stops before that conversion. A timeout leaves the operation's result to be checked in Lamassu: do not automatically repeat issuance.",{"_3170":994,"_28017":976,"_19412":48493,"_5":13306,"_25509":48456,"_2665":48494},[],"For a root that issues directly:",{"_3170":995,"_28017":976,"_19412":48496,"_5":13306,"_25509":48456,"_2665":48497},[],"Also verify that the CN is correct, the certificate is a leaf, its uses permit your application and its dates satisfy the profile. `cmp` must exit with code 0. With intermediates, provide the chain through `-untrusted` as described in PKI validation.",{"_3170":996,"_28017":976,"_19412":48499,"_5":13306,"_25509":48456,"_2665":48500},[],"Query the device: the owning DMS, current serial number and history must match the result. Protect the key/certificate pair and install both using the device's mechanism. Association in Lamassu does not install files in the client. Check a real connection before considering the process complete.",{"_3170":997,"_28017":976,"_19412":48502,"_5":13306,"_25509":48460,"_2665":48503},[],"Implement renewal and recovery and trust updates. The EST reference covers endpoints, formats and ServerKeyGen; troubleshooting helps distinguish transport, admission and persistence failures.",{"_3170":998,"_28017":998,"_5":13637,"_2665":48505,"_28339":48506,"_19412":48507,"_25509":998},"EST reference",[45393,46786,47794,47792,47975],[],{"_3170":999,"_28017":998,"_19412":48509,"_5":13306,"_25509":998,"_2665":48510},[],"Look up Lamassu routes, formats, authentication and multipart responses.",{"_3170":1000,"_28017":998,"_5":28336,"_19412":48512,"_25509":48513,"_2665":48514},[],"/docs/platform/iot-fleets/enrollment/est-reference#endpoint-reference","Endpoint reference",{"_3170":1001,"_28017":998,"_5":28336,"_19412":48516,"_25509":48517,"_2665":21097},[],"/docs/platform/iot-fleets/enrollment/est-reference#cacerts",{"_3170":1002,"_28017":998,"_5":28336,"_19412":48519,"_25509":48520,"_2665":24195},[],"/docs/platform/iot-fleets/enrollment/est-reference#simpleenroll",{"_3170":1003,"_28017":998,"_5":28336,"_19412":48522,"_25509":48523,"_2665":24202},[],"/docs/platform/iot-fleets/enrollment/est-reference#simplereenroll",{"_3170":1004,"_28017":998,"_5":28336,"_19412":48525,"_25509":48526,"_2665":23547},[],"/docs/platform/iot-fleets/enrollment/est-reference#serverkeygen",{"_3170":1005,"_28017":998,"_5":28336,"_19412":48528,"_25509":48529,"_2665":48530},[],"/docs/platform/iot-fleets/enrollment/est-reference#response-format","Response format",{"_3170":1006,"_28017":998,"_5":28336,"_19412":48532,"_25509":48533,"_2665":48534},[],"/docs/platform/iot-fleets/enrollment/est-reference#request-and-extraction","Request and extraction",{"_3170":1007,"_28017":998,"_5":28336,"_19412":48536,"_25509":48537,"_2665":48538},[],"/docs/platform/iot-fleets/enrollment/est-reference#compatibility-notes","Compatibility notes",{"_3170":1008,"_28017":998,"_19412":48540,"_5":13306,"_25509":998,"_2665":48541},[],"Reference for the examined backend, based on RFC 7030. Use EST client for the procedure and DMS to configure policy.",{"_3170":1009,"_28017":998,"_19412":48543,"_5":13306,"_25509":48513,"_2665":48544},[],"Public route in the examples: `/.well-known/est/{APS}/{operation}`. `APS` is the DMS ID. The router admits routes without that segment, but the controller requires it; do not use them as a default service. Gateway configuration determines the public host and route.",{"_3170":1010,"_28017":998,"_19412":48546,"_5":13306,"_25509":48513,"_2665":48547},[],"Operation",{"_3170":1011,"_28017":998,"_19412":48549,"_5":13306,"_25509":48513,"_2665":48550},[],"Method",{"_3170":1012,"_28017":998,"_19412":48552,"_5":13306,"_25509":48513,"_2665":48553},[],"Authentication and condition",{"_3170":1013,"_28017":998,"_19412":48555,"_5":13306,"_25509":48513,"_2665":48556},[],"`/cacerts`",{"_3170":1014,"_28017":998,"_19412":48558,"_5":13306,"_25509":48513,"_2665":48559},[],"GET",{"_3170":1015,"_28017":998,"_19412":48561,"_5":13306,"_25509":48513,"_2665":48562},[],"DMS reading does not require an EST credential; HTTPS and infrastructure controls still apply.",{"_3170":1016,"_28017":998,"_19412":48564,"_5":13306,"_25509":48513,"_2665":48565},[],"`/simpleenroll`",{"_3170":1017,"_28017":998,"_19412":48567,"_5":13306,"_25509":48513,"_2665":48568},[],"POST",{"_3170":1018,"_28017":998,"_19412":48570,"_5":13306,"_25509":48513,"_2665":48571},[],"Initial authentication and DMS registration/replacement policy.",{"_3170":1019,"_28017":998,"_19412":48573,"_5":13306,"_25509":48513,"_2665":48574},[],"`/simplereenroll`",{"_3170":1020,"_28017":998,"_19412":48576,"_5":13306,"_25509":48513,"_2665":48568},[],{"_3170":1021,"_28017":998,"_19412":48578,"_5":13306,"_25509":48513,"_2665":48579},[],"Renewal authentication, existing identity, subject, revocation and window.",{"_3170":1022,"_28017":998,"_19412":48581,"_5":13306,"_25509":48513,"_2665":48582},[],"`/serverkeygen`",{"_3170":1023,"_28017":998,"_19412":48584,"_5":13306,"_25509":48513,"_2665":48568},[],{"_3170":1024,"_28017":998,"_19412":48586,"_5":13306,"_25509":48513,"_2665":48587},[],"Initial authentication and admission; server generation enabled.",{"_3170":1025,"_28017":998,"_19412":48589,"_5":13306,"_25509":48513,"_2665":48590},[],"These routes do not implement `/csrattrs` or `/fullcmc`. There is no native JWT EST authentication mode; a webhook can interpret a request credential according to its own contract.",{"_3170":1026,"_28017":998,"_19412":48592,"_5":13306,"_25509":48517,"_2665":48593},[],"The default response has `Content-Type: application/pkcs7-mime; smime-type=certs-only` and `Content-Transfer-Encoding: base64`. The body is Base64-encoded DER PKCS#7 with lines of up to 76 characters. It includes the certificates selected by the DMS, not necessarily every ancestor.",{"_3170":1027,"_28017":998,"_19412":48595,"_5":13306,"_25509":48517,"_2665":48596},[],"`Accept: application/x-pem-file` requests the bundle in PEM through a Lamassu extension. Inspect and approve its contents before modifying trusted roots.",{"_3170":1028,"_28017":998,"_19412":48598,"_5":13306,"_25509":48520,"_2665":48599},[],"Send a Base64-encoded DER PKCS#10 CSR with `Content-Type: application/pkcs10`. The examined controller compares that media type literally; avoid adding parameters such as charset. The CN identifies the device and the CSR signature must be verified through DMS policy.",{"_3170":1029,"_28017":998,"_19412":48601,"_5":13306,"_25509":48520,"_2665":48602},[],"The default response uses the PKCS#7/Base64 format described for cacerts, but contains the issued certificate; do not assume it includes its entire chain. `Accept: application/x-pem-file` returns that certificate in PEM. The client retains the key that signed the CSR.",{"_3170":1030,"_28017":998,"_19412":48604,"_5":13306,"_25509":48523,"_2665":48605},[],"Use the same request and certificate response formats. Authentication comes from the independent `reenrollment_settings.est_rfc7030_settings` block. With a client certificate, its CN must match the CSR CN; the subject is also checked against the current certificate.",{"_3170":1031,"_28017":998,"_19412":48607,"_5":13306,"_25509":48523,"_2665":48608},[],"In mTLS mode, the enrollment CA always validates the re-enrollment credential; certificates from other issuers are accepted only if they are listed as validation CAs in the re-enrollment block. The expiry check through `enable_expired_renewal` belongs to that validator. A revoked current certificate and a request before the window are rejected. See Renewal for installation and recovery.",{"_3170":1032,"_28017":998,"_19412":48610,"_5":13306,"_25509":48526,"_2665":48611},[],"The server generates a software key, rebuilds the CSR with that key and performs initial enrollment. The flag must be enabled and the algorithm permitted by the profile. This operation's key does not become a hardware key because the CA is hosted in an HSM.",{"_3170":1033,"_28017":998,"_19412":48613,"_5":13306,"_25509":48526,"_2665":48614},[],"The code supports RSA and ECDSA, and the `bits` value of the DMS key setting means something different for each. For ECDSA it selects the curve: 224, 256, 384 or 521 map to P-224, P-256, P-384 and P-521, and an unrecognized size falls back to P-256, so explicitly select a compatible size and check the resulting key. For RSA it is used directly as the modulus size; the console offers 2048, 3072 and 4096 bits. Do not reuse an enrolled ID to test this operation without reviewing replacement.",{"_3170":1034,"_28017":998,"_19412":48616,"_5":13306,"_25509":48529,"_2665":48617},[],"The body is **MIME multipart/mixed**, with the boundary specified in `Content-Type`. It contains two parts:",{"_3170":1035,"_28017":998,"_19412":48619,"_5":13306,"_25509":48529,"_2665":48620},[],"Part",{"_3170":1036,"_28017":998,"_19412":48622,"_5":13306,"_25509":48529,"_2665":48623},[],"Content after decoding its Base64",{"_3170":1037,"_28017":998,"_19412":48625,"_5":13306,"_25509":48529,"_2665":48626},[],"`application/pkcs8`",{"_3170":1038,"_28017":998,"_19412":48628,"_5":13306,"_25509":48529,"_2665":48629},[],"Unencrypted DER PKCS#8 private key.",{"_3170":1039,"_28017":998,"_19412":48631,"_5":13306,"_25509":48529,"_2665":48632},[],"`application/pkcs7-mime; smime-type=certs-only`",{"_3170":1040,"_28017":998,"_19412":48634,"_5":13306,"_25509":48529,"_2665":48635},[],"DER PKCS#7 containing the issued certificate.",{"_3170":1041,"_28017":998,"_19412":48637,"_5":13306,"_25509":48529,"_2665":48638},[],"The controller also adds `Content-Transfer-Encoding: base64` to the outer header, although the outer body is MIME text. &#x2A;*Do not Base64-decode the entire body.** Read the actual boundary and decode each part according to its headers.",{"_3170":1042,"_28017":998,"_19412":48640,"_5":13306,"_25509":48533,"_2665":48641},[],"In a Bash session with `set -euo pipefail` and `umask 077`, use `EST_BASE` and the trust/bootstrap files from EST client. Select an available and admitted `est-serverkeygen-001`. The `server-request.key` only signs the input CSR; the received identity uses the server-generated key.",{"_3170":1043,"_28017":998,"_19412":48643,"_5":13306,"_25509":48533,"_2665":48644},[],"Save this Python 3 extractor. It validates both parts before writing and rejects existing output files:",{"_3170":1044,"_28017":998,"_19412":48646,"_5":13306,"_25509":48533,"_2665":48647},[],"Convert and check the result:",{"_3170":1045,"_28017":998,"_19412":48649,"_5":13306,"_25509":48533,"_2665":48650},[],"Inspect the CN, serial, dates and uses; check association in Lamassu before installing. Protect the DER and PEM files containing the key and remove temporary copies according to the device's storage mechanism. See openssl-pkcs8 and the Python MIME parser.",{"_3170":1046,"_28017":998,"_19412":48652,"_5":13306,"_25509":48537,"_2665":48653},[],"Do not interpret every 500 as a transient failure. Invalid input typically produces 400; service denials and errors typically produce 500 with a JSON `err` body. Gateway errors and some controller paths can have another format. Retain headers and body before decoding and see troubleshooting.",{"_3170":1047,"_28017":998,"_19412":48655,"_5":13306,"_25509":48537,"_2665":48656},[],"The examples use openssl-pkcs7 to extract certificates and openssl-x509 to prepare renewal. Check your version's capabilities and responses before integrating a generic EST client.",{"_3170":1048,"_28017":1048,"_5":13637,"_2665":47975,"_28339":48658,"_19412":48659,"_25509":1048},[45393,46786,47794,47792,47975],[],{"_3170":1049,"_28017":1048,"_19412":48661,"_5":13306,"_25509":1048,"_2665":48662},[],"Choose admission policy and connect DMS, initial trust and the EST client.",{"_3170":1050,"_28017":1048,"_5":28336,"_19412":48664,"_25509":48665,"_2665":48666},[],"/docs/platform/iot-fleets/enrollment/overview#the-journey","The journey",{"_3170":1051,"_28017":1048,"_5":28336,"_19412":48668,"_25509":48669,"_2665":48670},[],"/docs/platform/iot-fleets/enrollment/overview#for-the-administrator","For the administrator",{"_3170":1052,"_28017":1048,"_5":28336,"_19412":48672,"_25509":48673,"_2665":48674},[],"/docs/platform/iot-fleets/enrollment/overview#for-the-integrator","For the integrator",{"_3170":1053,"_28017":1048,"_5":28336,"_19412":48676,"_25509":48677,"_2665":48678},[],"/docs/platform/iot-fleets/enrollment/overview#contract-version","Contract version",{"_3170":1054,"_28017":1048,"_19412":48680,"_5":13306,"_25509":1048,"_2665":48681},[],"Enrollment with PKI covers the path from device admission to identity installation and renewal. The DMS acts as a registration authority: it authenticates the request, applies registration policy and asks the CA to sign. The client keeps or receives the key, installs the result and presents it to the consumer.",{"_3170":1055,"_28017":1048,"_19412":48683,"_5":13306,"_25509":48665,"_2665":48684},[],"The administrator prepares the CA, issuance profile and DMS.",{"_3170":1056,"_28017":1048,"_19412":48686,"_5":13306,"_25509":48665,"_2665":48687},[],"The integrator installs initial EST server trust and an admission credential.",{"_3170":1057,"_28017":1048,"_19412":48689,"_5":13306,"_25509":48665,"_2665":48690},[],"The client requests an identity for its `Device ID` through EST.",{"_3170":1058,"_28017":1048,"_19412":48692,"_5":13306,"_25509":48665,"_2665":48693},[],"Certificate, device binding and key/certificate installation are checked.",{"_3170":1059,"_28017":1048,"_19412":48695,"_5":13306,"_25509":48665,"_2665":48696},[],"The consumer validates and authorizes the identity; the client schedules renewal and recovery.",{"_3170":1060,"_28017":1048,"_19412":48698,"_5":13306,"_25509":48665,"_2665":48699},[],"EST uses `/.well-known/est/{DMS_ID}`. Administrative APIs and manual assignment remain separate paths. Enroll and connect a device completes an initial mTLS test.",{"_3170":1061,"_28017":1048,"_19412":48701,"_5":13306,"_25509":48669,"_2665":48702},[],"<Card title=\"Provisioning strategies\" description=\"Choose automatic registration, preregistration or manual assignment.\" href=\"/docs/platform/iot-fleets/enrollment/provisioning-strategies\" />",{"_3170":1062,"_28017":1048,"_19412":48704,"_5":13306,"_25509":48669,"_2665":48705},[],"<Card title=\"Configure the DMS\" description=\"Separate admission, authentication per operation, profiles and distribution.\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_3170":1063,"_28017":1048,"_19412":48707,"_5":13306,"_25509":48669,"_2665":48708},[],"<Card title=\"Bootstrap identity and authentication\" description=\"Decide which proof allows requesting the first identity.\" href=\"/docs/platform/iot-fleets/enrollment/bootstrap-identity\" />",{"_3170":1064,"_28017":1048,"_19412":48710,"_5":13306,"_25509":48669,"_2665":48711},[],"<Card title=\"Trust distribution\" description=\"Update roots and chains with verified overlap.\" href=\"/docs/platform/iot-fleets/enrollment/trust-distribution\" />",{"_3170":1065,"_28017":1048,"_19412":48713,"_5":13306,"_25509":48673,"_2665":48714},[],"<Card title=\"EST client\" description=\"Prepare the request, verify the response and install the identity.\" href=\"/docs/platform/iot-fleets/enrollment/est-client\" />",{"_3170":1066,"_28017":1048,"_19412":48716,"_5":13306,"_25509":48673,"_2665":48717},[],"<Card title=\"Renewal and recovery\" description=\"Generate the successor and handle expired or lost credentials.\" href=\"/docs/platform/iot-fleets/enrollment/renewal-and-recovery\" />",{"_3170":1067,"_28017":1048,"_19412":48719,"_5":13306,"_25509":48673,"_2665":48720},[],"<Card title=\"EST reference\" description=\"Look up paths, formats, authentication and ServerKeyGen.\" href=\"/docs/platform/iot-fleets/enrollment/est-reference\" />",{"_3170":1068,"_28017":1048,"_19412":48722,"_5":13306,"_25509":48673,"_2665":48723},[],"<Card title=\"Troubleshooting\" description=\"Distinguish transport, policy, issuance and installation failures.\" href=\"/docs/platform/iot-fleets/enrollment/troubleshooting\" />",{"_3170":1069,"_28017":1048,"_19412":48725,"_5":13306,"_25509":48677,"_2665":48726},[],"This block describes `main` code inspected at commit `8f42c47157f9a36bac3ed5caa3692aebebe19c4b`. The site catalog publishes `main (unstable)`; this behavior is not attributed to a stable release. Before using another version, check its contract, particularly independent re-enrollment authentication. Client checks and live-instance tests are distinguished in the revision plan.",{"_3170":1070,"_28017":1048,"_19412":48728,"_5":13306,"_25509":48677,"_2665":48729},[],"Gateway, TLS, provider and service configuration belongs to Deployment. Identity use in AWS or other destinations belongs to Integrations.",{"_3170":1071,"_28017":1071,"_5":13637,"_2665":48731,"_28339":48732,"_19412":48733,"_25509":1071},"Provisioning strategies",[45393,46786,47794,47792,47975],[],{"_3170":1072,"_28017":1071,"_19412":48735,"_5":13306,"_25509":1071,"_2665":48736},[],"Choose device registration, identity authorization and key generation.",{"_3170":1073,"_28017":1071,"_5":28336,"_19412":48738,"_25509":48739,"_2665":48740},[],"/docs/platform/iot-fleets/enrollment/provisioning-strategies#choose-registration","Choose registration",{"_3170":1074,"_28017":1071,"_5":28336,"_19412":48742,"_25509":48743,"_2665":48744},[],"/docs/platform/iot-fleets/enrollment/provisioning-strategies#preregistration-and-replacement","Preregistration and replacement",{"_3170":1075,"_28017":1071,"_5":28336,"_19412":48746,"_25509":48747,"_2665":48748},[],"/docs/platform/iot-fleets/enrollment/provisioning-strategies#choose-authentication","Choose authentication",{"_3170":1076,"_28017":1071,"_5":28336,"_19412":48750,"_25509":48751,"_2665":48752},[],"/docs/platform/iot-fleets/enrollment/provisioning-strategies#choose-custody","Choose custody",{"_3170":1077,"_28017":1071,"_5":28336,"_19412":48754,"_25509":48755,"_2665":48756},[],"/docs/platform/iot-fleets/enrollment/provisioning-strategies#check-the-decision","Check the decision",{"_3170":1078,"_28017":1071,"_19412":48758,"_5":13306,"_25509":1071,"_2665":48759},[],"This guide helps the provisioning administrator choose a path before configuring the DMS. Separate three decisions: when the device exists, how its request is authorized and who generates its key. None grants destination access by itself.",{"_3170":1079,"_28017":1071,"_19412":48761,"_5":13306,"_25509":48739,"_2665":48762},[],"Path",{"_3170":1080,"_28017":1071,"_19412":48764,"_5":13306,"_25509":48739,"_2665":48765},[],"When the device exists",{"_3170":1081,"_28017":1071,"_19412":48767,"_5":13306,"_25509":48739,"_2665":48768},[],"What to check",{"_3170":1082,"_28017":1071,"_19412":48770,"_5":13306,"_25509":48739,"_2665":48771},[],"Manual assignment",{"_3170":1083,"_28017":1071,"_19412":48773,"_5":13306,"_25509":48739,"_2665":48774},[],"An operator creates it before associating a certificate.",{"_3170":1084,"_28017":1071,"_19412":48776,"_5":13306,"_25509":48739,"_2665":48777},[],"ID, owning DMS, certificate CN and bound serial.",{"_3170":1085,"_28017":1071,"_19412":48779,"_5":13306,"_25509":48739,"_2665":48780},[],"EST with `JITP`",{"_3170":1086,"_28017":1071,"_19412":48782,"_5":13306,"_25509":48739,"_2665":48783},[],"Created for an unknown CN during `/simpleenroll`.",{"_3170":1087,"_28017":1071,"_19412":48785,"_5":13306,"_25509":48739,"_2665":48786},[],"Authorized credential, unused ID, profile, resulting registration and identity.",{"_3170":1088,"_28017":1071,"_19412":48788,"_5":13306,"_25509":48739,"_2665":48789},[],"EST with `PRE_REGISTRATION`",{"_3170":1089,"_28017":1071,"_19412":48791,"_5":13306,"_25509":48739,"_2665":48792},[],"Must exist before `/simpleenroll`.",{"_3170":1090,"_28017":1071,"_19412":48794,"_5":13306,"_25509":48739,"_2665":48795},[],"Approved record, same DMS and replacement conditions for your version.",{"_3170":1091,"_28017":1071,"_19412":48797,"_5":13306,"_25509":48739,"_2665":48798},[],"Lamassu `JITP` creates inventory and identity in Lamassu. AWS JITP provisions a destination in AWS; these are separate decisions.",{"_3170":1092,"_28017":1071,"_19412":48800,"_5":13306,"_25509":48739,"_2665":48801},[],"For an initial client test, use Enroll and connect a device. To prepare inventory without EST, follow Manual registration.",{"_3170":1093,"_28017":1071,"_19412":48803,"_5":13306,"_25509":48743,"_2665":48804},[],"In the inspected code, finding any device owned by the same DMS triggers the `enable_replaceable_enrollment` check before PRE\\_REGISTRATION. With the flag disabled, a preregistered device can receive `forbiddenNewEnrollment` even in **No Identity**. Selecting PRE\\_REGISTRATION alone therefore does not establish a working path.",{"_3170":1094,"_28017":1071,"_19412":48806,"_5":13306,"_25509":48743,"_2665":48807},[],"Enabling the flag permits repeated `/simpleenroll` for an existing ID. The backend schedules a deferred attempt to revoke the previous certificate with `Superseded`; it can also run if later issuance or binding fails. Without an identity, that attempt can fail because no serial exists. The flag does not provide a replacement transaction or guarantee restoration of previous state.",{"_3170":1095,"_28017":1071,"_19412":48809,"_5":13306,"_25509":48743,"_2665":48810},[],"Test the exact case on your version before enabling it for a population. For an operational identity with authorized renewal, use `/simplereenroll`; for recovery, follow Renewal and recovery and check persisted state before retrying.",{"_3170":1096,"_28017":1071,"_19412":48812,"_5":13306,"_25509":48747,"_2665":48813},[],"Decide initial enrollment and re-enrollment separately:",{"_3170":1097,"_28017":1071,"_19412":48815,"_5":13306,"_25509":48747,"_2665":48816},[],"**Client certificate:** useful when each device has an initial credential whose key it controls.",{"_3170":1098,"_28017":1071,"_19412":48818,"_5":13306,"_25509":48747,"_2665":48819},[],"**Webhook:** useful when another authority knows inventory, credentials or entitlement to a requested ID.",{"_3170":1099,"_28017":1071,"_19412":48821,"_5":13306,"_25509":48747,"_2665":48822},[],"**Certificate and webhook:** requires both controls in the configured operation.",{"_3170":1100,"_28017":1071,"_19412":48824,"_5":13306,"_25509":48747,"_2665":48825},[],"**NO\\_AUTH:** does not establish requester identity; appropriate only when admission is deliberately controlled outside that DMS.",{"_3170":1101,"_28017":1071,"_19412":48827,"_5":13306,"_25509":48747,"_2665":48828},[],"Authenticating an initial certificate does not itself establish entitlement to choose any CSR CN. Define that authorization in Bootstrap identity and authentication.",{"_3170":1102,"_28017":1071,"_19412":48830,"_5":13306,"_25509":48751,"_2665":45777},[],{"_3170":1103,"_28017":1071,"_19412":48832,"_5":13306,"_25509":48751,"_2665":48833},[],"Material crossing EST",{"_3170":1104,"_28017":1071,"_19412":48835,"_5":13306,"_25509":48751,"_2665":48836},[],"Device-generated key",{"_3170":1105,"_28017":1071,"_19412":48838,"_5":13306,"_25509":48751,"_2665":48839},[],"Public CSR and certificate; the key stays on the client.",{"_3170":1106,"_28017":1071,"_19412":48841,"_5":13306,"_25509":48751,"_2665":48842},[],"Existing device key",{"_3170":1107,"_28017":1071,"_19412":48844,"_5":13306,"_25509":48751,"_2665":48845},[],"CSR signed with that key and a new certificate.",{"_3170":1108,"_28017":1071,"_19412":48847,"_5":13306,"_25509":48751,"_2665":48113},[],{"_3170":1109,"_28017":1071,"_19412":48849,"_5":13306,"_25509":48751,"_2665":48850},[],"Private PKCS#8 key and certificate in a TLS-protected multipart response.",{"_3170":1110,"_28017":1071,"_19412":48852,"_5":13306,"_25509":48751,"_2665":48853},[],"ServerKeyGen does not automatically use the CA’s HSM or KMS for the device key. Review its contract and extraction and the device’s ability to install the material.",{"_3170":1111,"_28017":1071,"_19412":48855,"_5":13306,"_25509":48755,"_2665":48856},[],"Before expanding the flow, test allowed registration, incorrect credentials, an ID owned by another DMS, repeated requests and recovery after failure. Keep ID, serial, active version and error. Also test consumer acceptance and rejection; issuance does not imply destination registration or permission to operate.",{"_3170":1112,"_28017":1112,"_5":13637,"_2665":48858,"_28339":48859,"_19412":48860,"_25509":1112},"Renewal and recovery",[45393,46786,47794,47792,47975],[],{"_3170":1113,"_28017":1112,"_19412":48862,"_5":13306,"_25509":1112,"_2665":48863},[],"Renew without losing the identity and recover devices according to their actual state.",{"_3170":1114,"_28017":1112,"_5":28336,"_19412":48865,"_25509":48866,"_2665":48867},[],"/docs/platform/iot-fleets/enrollment/renewal-and-recovery#prepare-renewal","Prepare renewal",{"_3170":1115,"_28017":1112,"_5":28336,"_19412":48869,"_25509":48870,"_2665":48871},[],"/docs/platform/iot-fleets/enrollment/renewal-and-recovery#request-the-successor-certificate","Request the successor certificate",{"_3170":1116,"_28017":1112,"_5":28336,"_19412":48873,"_25509":48874,"_2665":48875},[],"/docs/platform/iot-fleets/enrollment/renewal-and-recovery#install-and-check-the-new-pair","Install and check the new pair",{"_3170":1117,"_28017":1112,"_5":28336,"_19412":48877,"_25509":48878,"_2665":48879},[],"/docs/platform/iot-fleets/enrollment/renewal-and-recovery#recover-according-to-state","Recover according to state",{"_3170":1118,"_28017":1112,"_5":28336,"_19412":48881,"_25509":48882,"_2665":48883},[],"/docs/platform/iot-fleets/enrollment/renewal-and-recovery#continuous-operation","Continuous operation",{"_3170":1119,"_28017":1112,"_19412":48885,"_5":13306,"_25509":1112,"_2665":48886},[],"Renewal retains the device identifier and requests a successor certificate. The client must complete the process: check the response, install the matching pair and demonstrate that the consumer accepts it. Lamassu alerts notify you; they do not perform those steps.",{"_3170":1120,"_28017":1112,"_19412":48888,"_5":13306,"_25509":48866,"_2665":48889},[],"Query the current certificate in Lamassu and compare it with the installed certificate. You need its subject, serial and dates, as well as the client key.",{"_3170":1121,"_28017":1112,"_19412":48891,"_5":13306,"_25509":48866,"_2665":48892},[],"Check the **re-enrollment** authentication mode: it is independent of initial authentication. With `CLIENT_CERTIFICATE`, use the current identity; do not assume the bootstrap credential is admitted.",{"_3170":1122,"_28017":1112,"_19412":48894,"_5":13306,"_25509":48866,"_2665":48895},[],"Calculate the window's start: the current certificate's `NotAfter` minus `reenrollment_delta`. Preventive and critical thresholds produce states/notifications; they do not extend that window.",{"_3170":1123,"_28017":1112,"_19412":48897,"_5":13306,"_25509":48866,"_2665":48898},[],"Review **Revoke on Re-enrollment** and recovery if installation fails. When enabled, Lamassu can revoke the previous identity before the client installs the new one.",{"_3170":1124,"_28017":1112,"_19412":48900,"_5":13306,"_25509":48870,"_2665":48901},[],"The example continues the EST tutorial, in the same Bash session with `set -euo pipefail`, `umask 077` and `EST_BASE`. Use a new key compatible with the profile. Conversion from the certificate preserves the subject and copies only SAN when present; check the subject and requested names before sending it. The backend checks the subject against the current identity: it attempts RawSubject equality and then compares CN, OU, O, L, ST and C. Rebuilding only the CN can lose required attributes.",{"_3170":1125,"_28017":1112,"_19412":48903,"_5":13306,"_25509":48870,"_2665":48904},[],"The request authenticates with `device.crt` and `device.key`; the CSR contains the new public key. Also check extensions, dates and correspondence of the serial with the current slot in Lamassu. Do not resubmit a failed request without querying that state: issuance, previous revocation and successor binding can have partial results.",{"_3170":1126,"_28017":1112,"_19412":48906,"_5":13306,"_25509":48874,"_2665":48907},[],"Keep the result as `device.next.crt` and `device.next.key` until verified. Switch the pair through a coordinated operation in the device store or configuration; avoid temporarily exposing a certificate with another version's key.",{"_3170":1127,"_28017":1112,"_19412":48909,"_5":13306,"_25509":48874,"_2665":48910},[],"Test mTLS with the consumer and verify that it uses the new serial. Confirm the history and current certificate in Lamassu. If **Revoke on Re-enrollment** was disabled, the previous identity can remain valid: retire it according to PKI policy after testing the successor, and check revocation publication and consumption.",{"_3170":1128,"_28017":1112,"_19412":48912,"_5":13306,"_25509":48874,"_2665":48913},[],"If the previous identity is already revoked, retaining its files does not restore a valid connection. Recovery requires an admitted credential and authorized intervention according to the situation.",{"_3170":1129,"_28017":1112,"_19412":48915,"_5":13306,"_25509":48878,"_2665":48916},[],"Situation",{"_3170":1130,"_28017":1112,"_19412":48918,"_5":13306,"_25509":48878,"_2665":48919},[],"Procedure",{"_3170":1131,"_28017":1112,"_19412":48921,"_5":13306,"_25509":48878,"_2665":48922},[],"Valid certificate, outside the window",{"_3170":1132,"_28017":1112,"_19412":48924,"_5":13306,"_25509":48878,"_2665":48925},[],"Schedule the request within the window. Do not use `simpleenroll` to bypass it.",{"_3170":1133,"_28017":1112,"_19412":48927,"_5":13306,"_25509":48878,"_2665":48928},[],"Expired certificate, key available",{"_3170":1134,"_28017":1112,"_19412":48930,"_5":13306,"_25509":48878,"_2665":48931},[],"With certificate authentication, review `enable_expired_renewal` and whether Gateway permits presenting that credential. Revocation, subject and the remaining checks still apply.",{"_3170":1135,"_28017":1112,"_19412":48933,"_5":13306,"_25509":48878,"_2665":48934},[],"Renewal through webhook or `NO_AUTH`",{"_3170":1136,"_28017":1112,"_19412":48936,"_5":13306,"_25509":48878,"_2665":48937},[],"The mTLS expiry check does not run in these modes. Define expiry and authorization policy in the corresponding admission process; the flag is not a universal prohibition.",{"_3170":1137,"_28017":1112,"_19412":48939,"_5":13306,"_25509":48878,"_2665":48940},[],"Lost or inaccessible key",{"_3170":1138,"_28017":1112,"_19412":48942,"_5":13306,"_25509":48878,"_2665":48943},[],"You cannot prove possession of the previous identity. Authorize new admission and, if appropriate, controlled replacement; revoke the compromised identity.",{"_3170":1139,"_28017":1112,"_19412":48945,"_5":13306,"_25509":48878,"_2665":48946},[],"Current identity revoked",{"_3170":1140,"_28017":1112,"_19412":48948,"_5":13306,"_25509":48878,"_2665":48949},[],"`simplereenroll` rejects the revoked current certificate. Investigate the reason and prepare an authorized readmission procedure; do not disable authentication to force it.",{"_3170":1141,"_28017":1112,"_19412":48951,"_5":13306,"_25509":48878,"_2665":48952},[],"Device without an identity",{"_3170":1142,"_28017":1112,"_19412":48954,"_5":13306,"_25509":48878,"_2665":48955},[],"Use initial enrollment. For an existing entry, check the replacement restriction in provisioning.",{"_3170":1143,"_28017":1112,"_19412":48957,"_5":13306,"_25509":48878,"_2665":48958},[],"Retired device",{"_3170":1144,"_28017":1112,"_19412":48960,"_5":13306,"_25509":48878,"_2665":48961},[],"Review the operational decision before readmission. Decommissioned state and revocation of the entire history are not equivalent.",{"_3170":1145,"_28017":1112,"_19412":48963,"_5":13306,"_25509":48878,"_2665":48964},[],"Timeout, HTTP 500 or installation failure",{"_3170":1146,"_28017":1112,"_19412":48966,"_5":13306,"_25509":48878,"_2665":48967},[],"Inspect the device, issued certificates and history before retrying. A successor may have been issued or the previous identity revoked.",{"_3170":1147,"_28017":1112,"_19412":48969,"_5":13306,"_25509":48882,"_2665":48970},[],"Schedule renewal with time for disconnections, trust distribution and consumer checks. Stagger requests across the population and bound retries within the window; authentication, subject and policy errors require correcting their cause. Maintain an admitted and tested recovery mechanism for lost keys and pairs that could not be installed.",{"_3170":1148,"_28017":1112,"_19412":48972,"_5":13306,"_25509":48882,"_2665":48973},[],"Continue with Trust distribution, Devices and identities and Troubleshooting.",{"_3170":1149,"_28017":1149,"_5":13637,"_2665":48975,"_28339":48976,"_19412":48977,"_25509":1149},"Enrollment troubleshooting",[45393,46786,47794,47792,47975],[],{"_3170":1150,"_28017":1149,"_19412":48979,"_5":13306,"_25509":1149,"_2665":48980},[],"Locate transport, authentication, registration, issuance and installation failures.",{"_3170":1151,"_28017":1149,"_5":28336,"_19412":48982,"_25509":48983,"_2665":48984},[],"/docs/platform/iot-fleets/enrollment/troubleshooting#diagnostics-and-compatibility","Diagnostics and compatibility",{"_3170":1152,"_28017":1149,"_5":28336,"_19412":48986,"_25509":48987,"_2665":48988},[],"/docs/platform/iot-fleets/enrollment/troubleshooting#error-codes-and-diagnostics","Error codes and diagnostics",{"_3170":1153,"_28017":1149,"_5":28336,"_19412":48990,"_25509":48991,"_2665":48538},[],"/docs/platform/iot-fleets/enrollment/troubleshooting#compatibility-notes",{"_3170":1154,"_28017":1149,"_5":28336,"_19412":48993,"_25509":48994,"_2665":48995},[],"/docs/platform/iot-fleets/enrollment/troubleshooting#est-enrollment-fails","EST enrollment fails",{"_3170":1155,"_28017":1149,"_19412":48997,"_5":13306,"_25509":1149,"_2665":48998},[],"Diagnose one operation and device at a time. Record the DMS/APS, endpoint, time, HTTP code, presented serial and CSR CN. Retain the response without including private keys or webhook credentials in the report.",{"_3170":1156,"_28017":1149,"_19412":49000,"_5":13306,"_25509":48987,"_2665":49001},[],"The EST controller normally returns 400 when rejecting input and 500 when the service rejects or fails the operation. A 500 can also represent a policy denial; it does not mean retrying is safe. Gateway can produce its own codes and bodies. Examine the actual body and persisted result.",{"_3170":1157,"_28017":1149,"_19412":49003,"_5":13306,"_25509":48987,"_2665":49004},[],"Symptom or message",{"_3170":1158,"_28017":1149,"_19412":49006,"_5":13306,"_25509":48987,"_2665":48768},[],{"_3170":1159,"_28017":1149,"_19412":49008,"_5":13306,"_25509":48987,"_2665":49009},[],"curl rejects TLS, name or issuer",{"_3170":1160,"_28017":1149,"_19412":49011,"_5":13306,"_25509":48987,"_2665":49012},[],"URL, clock, server SAN and approved root in `est-trust.pem`. Resolve trust in Deployment; do not skip verification.",{"_3170":1161,"_28017":1149,"_19412":49014,"_5":13306,"_25509":48987,"_2665":49015},[],"404 or missing APS",{"_3170":1162,"_28017":1149,"_19412":49017,"_5":13306,"_25509":48987,"_2665":49018},[],"Public route `/.well-known/est/{DMS_ID}/{operation}` and existing DMS. APS is not the service name.",{"_3170":1163,"_28017":1149,"_19412":49020,"_5":13306,"_25509":48987,"_2665":49021},[],"400, CSR or format error",{"_3170":1164,"_28017":1149,"_19412":49023,"_5":13306,"_25509":48987,"_2665":49024},[],"`Content-Type: application/pkcs10`, Base64 of DER, valid signature and a body preserved without double encoding.",{"_3170":1165,"_28017":1149,"_19412":49026,"_5":13306,"_25509":48987,"_2665":49027},[],"Missing credential or invalid certificate",{"_3170":1166,"_28017":1149,"_19412":49029,"_5":13306,"_25509":48987,"_2665":49030},[],"Operation mode, validating CA, dates, revocation and credential delivery by Gateway. Do not confuse server TLS trust with the bootstrap CA.",{"_3170":1167,"_28017":1149,"_19412":49032,"_5":13306,"_25509":48987,"_2665":49033},[],"Webhook denies, times out or responds without authorization",{"_3170":1168,"_28017":1149,"_19412":49035,"_5":13306,"_25509":48987,"_2665":49036},[],"Configuration, connectivity and JSON response with `authorized: true`. There is no automatic fallback to `NO_AUTH`.",{"_3170":1169,"_28017":1149,"_19412":49038,"_5":13306,"_25509":48987,"_2665":49039},[],"`unexpected status code: <n>: redirects are not followed`",{"_3170":1170,"_28017":1149,"_19412":49041,"_5":13306,"_25509":48987,"_2665":49042},[],"The webhook answered with a redirect. Configure the final absolute `http` or `https` URL in the webhook config; redirects are never followed.",{"_3170":1171,"_28017":1149,"_19412":49044,"_5":13306,"_25509":48987,"_2665":49045},[],"`webhook response exceeds 1048576 bytes`",{"_3170":1172,"_28017":1149,"_19412":49047,"_5":13306,"_25509":48987,"_2665":49048},[],"The receiver returned more than 1 MiB of JSON. Reduce the response of the authorization webhook.",{"_3170":1173,"_28017":1149,"_19412":49050,"_5":13306,"_25509":48987,"_2665":49051},[],"`webhook config must not reference files`",{"_3170":1174,"_28017":1149,"_19412":49053,"_5":13306,"_25509":48987,"_2665":49054},[],"The webhook config points to files (`ca_cert_file`, `mtls_options.cert_file`, `mtls_options.key_file`). For mTLS, enter the certificate and key as Base64-encoded PEM in `cert_content` and `key_content`, or as plain PEM; remove any other file field, including `ca_cert_file`, which has no inline equivalent (the receiver certificate must chain to the system trust store). See the webhook credentials guidance in DMS.",{"_3170":1175,"_28017":1149,"_19412":49056,"_5":13306,"_25509":48987,"_2665":49057},[],"`mtls_options.cert_content must be base64-encoded PEM`",{"_3170":1176,"_28017":1149,"_19412":49059,"_5":13306,"_25509":48987,"_2665":49060},[],"The value is neither Base64-encoded PEM nor plain PEM: it is a file path or Base64 of non-PEM data. Enter the certificate and key as Base64-encoded PEM, like certificates elsewhere in the API, or as plain PEM (see the webhook settings in DMS). The same message names `mtls_options.key_content` when the key is the offending value.",{"_3170":1177,"_28017":1149,"_19412":49062,"_5":13306,"_25509":48987,"_2665":49063},[],"`webhook mTLS certificate and key are invalid: …`",{"_3170":1178,"_28017":1149,"_19412":49065,"_5":13306,"_25509":48987,"_2665":49066},[],"The certificate and key do not form a matching pair. Enter both values from the same pair; the check runs when the DMS is saved and again on every webhook call.",{"_3170":1179,"_28017":1149,"_19412":49068,"_5":13306,"_25509":48987,"_2665":49069},[],"400 `struct validation error` creating or updating a DMS",{"_3170":1180,"_28017":1149,"_19412":49071,"_5":13306,"_25509":48987,"_2665":49072},[],"The webhook config of the operation that uses it is invalid. Review `external_webhook_settings` in DMS.",{"_3170":1181,"_28017":1149,"_19412":49074,"_5":13306,"_25509":48987,"_2665":49075},[],"HTTP 500 with an `err` body on enroll or reenroll",{"_3170":1182,"_28017":1149,"_19412":49077,"_5":13306,"_25509":48987,"_2665":49078},[],"Service failures reach the EST client as 500 with a body of `err` plus the message; webhook authorization errors are named there.",{"_3170":1183,"_28017":1149,"_19412":49080,"_5":13306,"_25509":48987,"_2665":49081},[],"`device not preregistered`",{"_3170":1184,"_28017":1149,"_19412":49083,"_5":13306,"_25509":48987,"_2665":49084},[],"PRE\\_REGISTRATION requires an existing inventory entry.",{"_3170":1185,"_28017":1149,"_19412":49086,"_5":13306,"_25509":48987,"_2665":49087},[],"`forbiddenNewEnrollment`",{"_3170":1186,"_28017":1149,"_19412":49089,"_5":13306,"_25509":48987,"_2665":49090},[],"An existing device requires replacement to be enabled, even in No Identity. Investigate before enabling the flag.",{"_3170":1187,"_28017":1149,"_19412":49092,"_5":13306,"_25509":48987,"_2665":49093},[],"Different owning DMS",{"_3170":1188,"_28017":1149,"_19412":49095,"_5":13306,"_25509":48987,"_2665":49096},[],"CN/ID, global inventory and owning DMS; do not reuse an ID from another context.",{"_3170":1189,"_28017":1149,"_19412":49098,"_5":13306,"_25509":48987,"_2665":49099},[],"`invalid RawSubject bytes`",{"_3170":1190,"_28017":1149,"_19412":49101,"_5":13306,"_25509":48987,"_2665":49102},[],"CSR subject versus the current certificate. Preserve its attributes as well as its CN.",{"_3170":1191,"_28017":1149,"_19412":49104,"_5":13306,"_25509":48987,"_2665":49105},[],"`invalid reenroll window`",{"_3170":1192,"_28017":1149,"_19412":49107,"_5":13306,"_25509":48987,"_2665":49108},[],"Current identity's NotAfter and reenrollment\\_delta. Alert thresholds do not change that window.",{"_3170":1193,"_28017":1149,"_19412":49110,"_5":13306,"_25509":48987,"_2665":49111},[],"Current certificate revoked",{"_3170":1194,"_28017":1149,"_19412":49113,"_5":13306,"_25509":48987,"_2665":49114},[],"Renewal rejected; prepare authorized recovery according to the cause.",{"_3170":1195,"_28017":1149,"_19412":49116,"_5":13306,"_25509":48987,"_2665":49117},[],"CA, profile or signing error",{"_3170":1196,"_28017":1149,"_19412":49119,"_5":13306,"_25509":48987,"_2665":49120},[],"Active CA, available key, selected profile and restrictions. Successful cacerts does not prove issuance.",{"_3170":1197,"_28017":1149,"_19412":49122,"_5":13306,"_25509":48987,"_2665":49123},[],"HTTP 200 without a device connection",{"_3170":1198,"_28017":1149,"_19412":49125,"_5":13306,"_25509":48987,"_2665":49126},[],"Installed pair, chain, uses, consumer trust and permissions. Also check the slot and history.",{"_3170":1199,"_28017":1149,"_19412":49128,"_5":13306,"_25509":48987,"_2665":49129},[],"Timeout or error after issuance",{"_3170":1200,"_28017":1149,"_19412":49131,"_5":13306,"_25509":48987,"_2665":49132},[],"New certificates, current slot and previous identity's state before retrying.",{"_3170":1201,"_28017":1149,"_19412":49134,"_5":13306,"_25509":48991,"_2665":49135},[],"The examples use the contract of the examined backend. Do not automatically attribute that behavior to another release. Check the saved renewal mode and Gateway behavior with expired certificates and the bootstrap CA.",{"_3170":1202,"_28017":1149,"_19412":49137,"_5":13306,"_25509":48991,"_2665":49138},[],"The default response is Base64-encoded DER PKCS#7; PEM through `Accept: application/x-pem-file` is a Lamassu extension. ServerKeyGen returns multipart and requires handling each part separately. See the EST reference.",{"_3170":1203,"_28017":1149,"_19412":49140,"_5":13306,"_25509":48994,"_2665":49141},[],"Check HTTPS with the approved root and query cacerts for the correct APS.",{"_3170":1204,"_28017":1149,"_19412":49143,"_5":13306,"_25509":48994,"_2665":49144},[],"Review the saved DMS: protocol, registration, authentication for that operation, CA, profile and window.",{"_3170":1205,"_28017":1149,"_19412":49146,"_5":13306,"_25509":48994,"_2665":49147},[],"Verify the CSR locally and relate its CN to the inventory.",{"_3170":1206,"_28017":1149,"_19412":49149,"_5":13306,"_25509":48994,"_2665":49150},[],"Make one request, save headers/body and query the device and certificates.",{"_3170":1207,"_28017":1149,"_19412":49152,"_5":13306,"_25509":48994,"_2665":49153},[],"If you receive an identity, check the key, subject, use and connection with the consumer.",{"_3170":1208,"_28017":1149,"_19412":49155,"_5":13306,"_25509":48994,"_2665":49156},[],"External bootstrap revocation checks have limitations: absence of evidence can be accepted, and OCSP Unknown does not cause the same rejection as Revoked. Do not assume a policy that rejects every uncertainty. An intermediate CA in the TLS chain does not prove that the entire chain reached the DMS validator either.",{"_3170":1209,"_28017":1149,"_19412":49158,"_5":13306,"_25509":48994,"_2665":49159},[],"For logs, networking, pods or Gateway headers, continue in Deployment troubleshooting. For identities issued, revoked or bound partially, use Renewal and recovery and Devices and identities.",{"_3170":1210,"_28017":1210,"_5":13637,"_2665":49161,"_28339":49162,"_19412":49163,"_25509":1210},"Trust distribution and updates",[45393,46786,47794,47792,47975],[],{"_3170":1211,"_28017":1210,"_19412":49165,"_5":13306,"_25509":1210,"_2665":49166},[],"Separate roots, intermediates and initial TLS trust when distributing or migrating certificates.",{"_3170":1212,"_28017":1210,"_5":28336,"_19412":49168,"_25509":49169,"_2665":49170},[],"/docs/platform/iot-fleets/enrollment/trust-distribution#three-trust-relationships","Three trust relationships",{"_3170":1213,"_28017":1210,"_5":28336,"_19412":49172,"_25509":49173,"_2665":49174},[],"/docs/platform/iot-fleets/enrollment/trust-distribution#what-cacerts-returns","What cacerts returns",{"_3170":1214,"_28017":1210,"_5":28336,"_19412":49176,"_25509":49177,"_2665":49178},[],"/docs/platform/iot-fleets/enrollment/trust-distribution#install-the-required-material","Install the required material",{"_3170":1215,"_28017":1210,"_5":28336,"_19412":49180,"_25509":49181,"_2665":49182},[],"/docs/platform/iot-fleets/enrollment/trust-distribution#migrate-trust","Migrate trust",{"_3170":1216,"_28017":1210,"_5":28336,"_19412":49184,"_25509":49185,"_2665":49186},[],"/docs/platform/iot-fleets/enrollment/trust-distribution#check-the-update","Check the update",{"_3170":1217,"_28017":1210,"_19412":49188,"_5":13306,"_25509":1210,"_2665":49189},[],"This guide is for device and consumer trust administrators. You need issuer inventory, trust-store access and an authenticated update channel. Distributing certificates is separate from choosing trusted anchors.",{"_3170":1218,"_28017":1210,"_19412":49191,"_5":13306,"_25509":49169,"_2665":49192},[],"Relationship",{"_3170":1219,"_28017":1210,"_19412":49194,"_5":13306,"_25509":49169,"_2665":49195},[],"Material prepared by its owner",{"_3170":1220,"_28017":1210,"_19412":49197,"_5":13306,"_25509":49169,"_2665":49198},[],"Device → EST server",{"_3170":1221,"_28017":1210,"_19412":49200,"_5":13306,"_25509":49169,"_2665":49201},[],"Previously verified server root, chain or pin and TLS name.",{"_3170":1222,"_28017":1210,"_19412":49203,"_5":13306,"_25509":49169,"_2665":49204},[],"DMS → requester",{"_3170":1223,"_28017":1210,"_19412":49206,"_5":13306,"_25509":49169,"_2665":49207},[],"CAs and rules authorizing initial or renewal credentials.",{"_3170":1224,"_28017":1210,"_19412":49209,"_5":13306,"_25509":49169,"_2665":49210},[],"Consumer → device",{"_3170":1225,"_28017":1210,"_19412":49212,"_5":13306,"_25509":49169,"_2665":49213},[],"Operational identity roots, intermediates, validation and permissions.",{"_3170":1226,"_28017":1210,"_19412":49215,"_5":13306,"_25509":49169,"_2665":49216},[],"Obtaining a certificate does not automatically configure these relationships in third parties. Review the Trust model.",{"_3170":1227,"_28017":1210,"_19412":49218,"_5":13306,"_25509":49173,"_2665":49219},[],"The DMS may include the available downstream TLS certificate, selected Managed CAs and enrollment CA. Selecting the issuer does not include every ancestor. The set may contain leaves, roots and intermediates, including multiple hierarchies during migration.",{"_3170":1228,"_28017":1210,"_19412":49221,"_5":13306,"_25509":49173,"_2665":49222},[],"Position does not define the chain. Identify certificates by subject, issuer, AKI/SKI, signature and constraints. Download and inspect using EST client.",{"_3170":1229,"_28017":1210,"_19412":49224,"_5":13306,"_25509":49177,"_2665":49225},[],"Keep initial EST server trust separate from identity consumer trust.",{"_3170":1230,"_28017":1210,"_19412":49227,"_5":13306,"_25509":49177,"_2665":49228},[],"Select policy-approved roots as anchors.",{"_3170":1231,"_28017":1210,"_19412":49230,"_5":13306,"_25509":49177,"_2665":49231},[],"Retain intermediates for chain building or presentation; do not automatically turn them into roots.",{"_3170":1232,"_28017":1210,"_19412":49233,"_5":13306,"_25509":49177,"_2665":49234},[],"Present the leaf and required intermediates in mTLS. Normally the peer already trusts its root and does not need it sent.",{"_3170":1233,"_28017":1210,"_19412":49236,"_5":13306,"_25509":49177,"_2665":49237},[],"Verify chain, dates, names, usages and revocation from the consumer.",{"_3170":1234,"_28017":1210,"_19412":49239,"_5":13306,"_25509":49177,"_2665":49240},[],"Do not indiscriminately use all of `cacerts.pem` as `-CAfile`: this can expand trusted authorities, hide missing intermediates or trust a TLS leaf intended for another purpose.",{"_3170":1235,"_28017":1210,"_19412":49242,"_5":13306,"_25509":49181,"_2665":49243},[],"Before changing Enrollment CA, inventory disconnected equipment, bootstrap and operational certificates, and consumers. Distribute the new root and required intermediates; check that a cohort accepts both old and new chains.",{"_3170":1236,"_28017":1210,"_19412":49245,"_5":13306,"_25509":49181,"_2665":49246},[],"In the DMS, separate distributed CAs from the re-enrollment validation CAs at `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`, used for re-enrollment credentials. That list is optional because the enrollment CA always validates re-enrollment credentials, but when switching the enrollment CA, add the previous issuance CA to it so old-CA identities keep re-enrolling during overlap. The inspected validator tries the enrollment CA followed by those CAs against the received leaf; accepting a multilevel chain requires checking what reaches the service and which issuer is configured.",{"_3170":1237,"_28017":1210,"_19412":49248,"_5":13306,"_25509":49181,"_2665":49249},[],"Switch issuance, renew in cohorts and compare the installed serial with the active slot. Remove previous trust once no legitimate equipment needs it and policy permits ending overlap. Follow Hierarchy and rotation for the PKI operation.",{"_3170":1238,"_28017":1210,"_19412":49251,"_5":13306,"_25509":49185,"_2665":49252},[],"Test an old identity allowed during overlap, a new one, an unknown chain and the result after removing old trust. Keep trust-store version, approved set, date and result. Reachable `/cacerts` establishes distribution only; it does not establish installation or acceptance across every device.",{"_3170":1239,"_28017":1239,"_5":13637,"_2665":49254,"_28339":49255,"_19412":49257,"_25509":1239},"AWS IoT Core",[45393,46786,47794,47792,49256],"Integrations",[],{"_3170":1240,"_28017":1239,"_19412":49259,"_5":13306,"_25509":1239,"_2665":49260},[],"Lamassu's connector for AWS IoT Core syncs device identities with the AWS platform, handling CA registration, Thing provisioning and certificate lifecycle automatically and event-driven.",{"_3170":1241,"_28017":1239,"_5":28336,"_19412":49262,"_25509":49263,"_2665":49264},[],"/docs/platform/iot-fleets/integrations/aws-iot-core#connector-architecture","Connector architecture",{"_3170":1242,"_28017":1239,"_5":28336,"_19412":49266,"_25509":49267,"_2665":49268},[],"/docs/platform/iot-fleets/integrations/aws-iot-core#prerequisites","Prerequisites",{"_3170":1243,"_28017":1239,"_5":28336,"_19412":49270,"_25509":49271,"_2665":49272},[],"/docs/platform/iot-fleets/integrations/aws-iot-core#required-iam-permissions","Required IAM permissions",{"_3170":1244,"_28017":1239,"_5":28336,"_19412":49274,"_25509":49275,"_2665":49276},[],"/docs/platform/iot-fleets/integrations/aws-iot-core#configuration-parameters","Configuration parameters",{"_3170":1245,"_28017":1239,"_5":28336,"_19412":49278,"_25509":49279,"_2665":49280},[],"/docs/platform/iot-fleets/integrations/aws-iot-core#ca-registration-in-aws-iot-core","CA registration in AWS IoT Core",{"_3170":1246,"_28017":1239,"_5":28336,"_19412":49282,"_25509":49283,"_2665":49284},[],"/docs/platform/iot-fleets/integrations/aws-iot-core#how-to-request-registration","How to request registration",{"_3170":1247,"_28017":1239,"_5":28336,"_19412":49286,"_25509":49287,"_2665":49288},[],"/docs/platform/iot-fleets/integrations/aws-iot-core#primary-account","Primary Account",{"_3170":1248,"_28017":1239,"_5":28336,"_19412":49290,"_25509":49291,"_2665":49292},[],"/docs/platform/iot-fleets/integrations/aws-iot-core#secondary-account-sni-only","Secondary Account (SNI-only)",{"_3170":1249,"_28017":1239,"_5":28336,"_19412":49294,"_25509":49295,"_2665":49296},[],"/docs/platform/iot-fleets/integrations/aws-iot-core#dms-configuration","DMS configuration",{"_3170":1250,"_28017":1239,"_5":28336,"_19412":49298,"_25509":49299,"_2665":49300},[],"/docs/platform/iot-fleets/integrations/aws-iot-core#none-mode","`none` mode",{"_3170":1251,"_28017":1239,"_5":28336,"_19412":49302,"_25509":49303,"_2665":49304},[],"/docs/platform/iot-fleets/integrations/aws-iot-core#auto-mode","`auto` mode",{"_3170":1252,"_28017":1239,"_5":28336,"_19412":49306,"_25509":49307,"_2665":49308},[],"/docs/platform/iot-fleets/integrations/aws-iot-core#jitp-mode","`jitp` mode",{"_3170":1253,"_28017":1239,"_5":28336,"_19412":49310,"_25509":49311,"_2665":49312},[],"/docs/platform/iot-fleets/integrations/aws-iot-core#device-provisioning-automatic-mode","Device provisioning (automatic mode)",{"_3170":1254,"_28017":1239,"_5":28336,"_19412":49314,"_25509":49315,"_2665":49316},[],"/docs/platform/iot-fleets/integrations/aws-iot-core#device-provisioning-jitp-mode","Device provisioning (JITP mode)",{"_3170":1255,"_28017":1239,"_5":28336,"_19412":49318,"_25509":49319,"_2665":49320},[],"/docs/platform/iot-fleets/integrations/aws-iot-core#certificate-status-synchronization","Certificate status synchronization",{"_3170":1256,"_28017":1239,"_5":28336,"_19412":49322,"_25509":49323,"_2665":49324},[],"/docs/platform/iot-fleets/integrations/aws-iot-core#forced-disconnect-on-revocation","Forced disconnect on revocation",{"_3170":1257,"_28017":1239,"_5":28336,"_19412":49326,"_25509":49327,"_2665":49328},[],"/docs/platform/iot-fleets/integrations/aws-iot-core#device-shadow-and-automation","Device Shadow and automation",{"_3170":1258,"_28017":1239,"_5":28336,"_19412":49330,"_25509":49331,"_2665":49332},[],"/docs/platform/iot-fleets/integrations/aws-iot-core#what-the-connector-writes-to-the-shadow","What the connector writes to the shadow",{"_3170":1259,"_28017":1239,"_5":28336,"_19412":49334,"_25509":49335,"_2665":49336},[],"/docs/platform/iot-fleets/integrations/aws-iot-core#aws-iot-policies","AWS IoT policies",{"_3170":1260,"_28017":1239,"_5":28336,"_19412":49338,"_25509":49339,"_2665":49340},[],"/docs/platform/iot-fleets/integrations/aws-iot-core#troubleshooting","Troubleshooting",{"_3170":1261,"_28017":1239,"_19412":49342,"_5":13306,"_25509":1239,"_2665":49343},[],"Lamassu's integration with AWS IoT Core bridges the PKI managed by Lamassu and AWS's connectivity platform. When a device obtains its certificate through the EST enrollment process, the connector ensures that certificate and its associated identity are recognized in AWS IoT Core without manual intervention. The result is that the device can authenticate directly to AWS with the same X.509 certificate Lamassu issued.",{"_3170":1262,"_28017":1239,"_19412":49345,"_5":13306,"_25509":1239,"_2665":49346},[],"From a protocol standpoint, the device authenticates to AWS IoT Core via mutual TLS (mTLS): it presents its Lamassu-issued X.509 certificate as the client certificate, and AWS IoT Core verifies the certificate chain up to the CA registered in the account. Lamassu acts as the certification authority (CA); the connector ensures that CA is registered in AWS and that the device's certificate is known to the platform before the device attempts to connect (in `auto` mode) or on its first connection (in JITP mode).",{"_3170":1263,"_28017":1239,"_19412":49348,"_5":13306,"_25509":1239,"_2665":49349},[],"This document is aimed both at the PKI administrator, who needs to configure the connector and register CAs, and at the device firmware developer, who needs to understand how Things are named, how the Device Shadow works and what happens when a certificate is revoked. For the firmware developer, the most important fact is that **the AWS Thing name (ThingName) always corresponds to the Common Name (CN) of the certificate issued by Lamassu**, regardless of the provisioning mode.",{"_3170":1264,"_28017":1239,"_19412":49351,"_5":13306,"_25509":49263,"_2665":49352},[],"The AWS IoT Core connector is an independent Go process, a binary or container separate from Lamassu's core. In a monolithic deployment it is compiled by default (build tag `!noaws`) and activated with `aws_iot_manager.enabled: true` in the configuration file. In distributed deployments, it runs as its own container with access to Lamassu's CA, DMS Manager and Device Manager services over HTTP.",{"_3170":1265,"_28017":1239,"_19412":49354,"_5":13306,"_25509":49263,"_2665":49355},[],"The connector does not poll Lamassu's services periodically. Instead, it **subscribes to Lamassu's internal event bus** (AMQP or AWS SQS/SNS, configurable) and reacts to the events it cares about: CA creation or update, DMS creation or update, device identity binding, certificate status change, certificate metadata update and device metadata update. This event-driven model ensures synchronization with AWS is nearly immediate and produces no polling load.",{"_3170":1266,"_28017":1239,"_19412":49357,"_5":13306,"_25509":49263,"_2665":49358},[],"To avoid infinite loops, the connector ignores any event whose CloudEvent `source` field matches its own origin URI. This prevents the metadata writes the connector itself performs from re-triggering the same flow.",{"_3170":1267,"_28017":1239,"_19412":49360,"_5":13306,"_25509":49263,"_2665":49361},[],"When several connectors run in parallel, for example for different AWS accounts, each instance has its own `connector_id`. All metadata the connector writes to Lamassu is stored under the key `lamassu.io/iot/{connector_id}`, allowing coexistence without collisions.",{"_3170":1268,"_28017":1239,"_19412":49363,"_5":13306,"_25509":49267,"_2665":49364},[],"Before enabling the connector you need an AWS account with the proper IAM permissions and the connector correctly configured. The deployment process (Docker Compose, Kubernetes or binary) is described in the deployment documentation.",{"_3170":1269,"_28017":1239,"_19412":49366,"_5":13306,"_25509":49271,"_2665":49367},[],"The IAM identity operating the connector needs at minimum the following permissions on the target account's resources:",{"_3170":1270,"_28017":1239,"_19412":49369,"_5":13306,"_25509":49271,"_2665":49370},[],"IAM action",{"_3170":1271,"_28017":1239,"_19412":49372,"_5":13306,"_25509":49271,"_2665":45783},[],{"_3170":1272,"_28017":1239,"_19412":49374,"_5":13306,"_25509":49271,"_2665":49375},[],"`iot:GetRegistrationCode`",{"_3170":1273,"_28017":1239,"_19412":49377,"_5":13306,"_25509":49271,"_2665":49378},[],"Obtain the verification code for CA registration in the Primary Account",{"_3170":1274,"_28017":1239,"_19412":49380,"_5":13306,"_25509":49271,"_2665":49381},[],"`iot:RegisterCACertificate`",{"_3170":1275,"_28017":1239,"_19412":49383,"_5":13306,"_25509":49271,"_2665":49384},[],"Register the CA in AWS IoT",{"_3170":1276,"_28017":1239,"_19412":49386,"_5":13306,"_25509":49271,"_2665":49387},[],"`iot:DescribeCACertificate`",{"_3170":1277,"_28017":1239,"_19412":49389,"_5":13306,"_25509":49271,"_2665":49390},[],"Check the CA registration status",{"_3170":1278,"_28017":1239,"_19412":49392,"_5":13306,"_25509":49271,"_2665":49393},[],"`iot:CreateThing` / `iot:UpdateThing`",{"_3170":1279,"_28017":1239,"_19412":49395,"_5":13306,"_25509":49271,"_2665":49396},[],"Create or update Things in IoT Core",{"_3170":1280,"_28017":1239,"_19412":49398,"_5":13306,"_25509":49271,"_2665":49399},[],"`iot:RegisterThing`",{"_3170":1281,"_28017":1239,"_19412":49401,"_5":13306,"_25509":49271,"_2665":49402},[],"Provision Things through a template",{"_3170":1282,"_28017":1239,"_19412":49404,"_5":13306,"_25509":49271,"_2665":49405},[],"`iot:RegisterCertificate`",{"_3170":1283,"_28017":1239,"_19412":49407,"_5":13306,"_25509":49271,"_2665":49408},[],"Register device certificates",{"_3170":1284,"_28017":1239,"_19412":49410,"_5":13306,"_25509":49271,"_2665":49411},[],"`iot:UpdateCertificate`",{"_3170":1285,"_28017":1239,"_19412":49413,"_5":13306,"_25509":49271,"_2665":49414},[],"Change a certificate's status (ACTIVE / INACTIVE / REVOKED)",{"_3170":1286,"_28017":1239,"_19412":49416,"_5":13306,"_25509":49271,"_2665":49417},[],"`iot:CreatePolicy` / `iot:AttachPolicy`",{"_3170":1287,"_28017":1239,"_19412":49419,"_5":13306,"_25509":49271,"_2665":49420},[],"Create and attach IoT policies",{"_3170":1288,"_28017":1239,"_19412":49422,"_5":13306,"_25509":49271,"_2665":49423},[],"`iot:CreateThingGroup` / `iot:AddThingToThingGroup`",{"_3170":1289,"_28017":1239,"_19412":49425,"_5":13306,"_25509":49271,"_2665":49426},[],"Manage Thing groups",{"_3170":1290,"_28017":1239,"_19412":49428,"_5":13306,"_25509":49271,"_2665":49429},[],"`iot:CreateProvisioningTemplate`",{"_3170":1291,"_28017":1239,"_19412":49431,"_5":13306,"_25509":49271,"_2665":49432},[],"Create JITP templates",{"_3170":1292,"_28017":1239,"_19412":49434,"_5":13306,"_25509":49271,"_2665":49435},[],"`iotdata:GetThingShadow` / `iotdata:UpdateThingShadow`",{"_3170":1293,"_28017":1239,"_19412":49437,"_5":13306,"_25509":49271,"_2665":49438},[],"Read and write the Device Shadow",{"_3170":1294,"_28017":1239,"_19412":49440,"_5":13306,"_25509":49271,"_2665":49441},[],"The forced-disconnect mechanism after revocation also requires access to the AWS IoT data plane API (`iot:Connect` with SigV4 over WebSocket), negotiated implicitly with the connector's credentials.",{"_3170":1295,"_28017":1239,"_19412":49443,"_5":13306,"_25509":49275,"_2665":49444},[],"Parameter",{"_3170":1296,"_28017":1239,"_19412":49446,"_5":13306,"_25509":49275,"_2665":49447},[],"Type",{"_3170":1297,"_28017":1239,"_19412":49449,"_5":13306,"_25509":49275,"_2665":49450},[],"Required",{"_3170":1298,"_28017":1239,"_19412":49452,"_5":13306,"_25509":49275,"_2665":49453},[],"Description",{"_3170":1299,"_28017":1239,"_19412":49455,"_5":13306,"_25509":49275,"_2665":49456},[],"`connector_id`",{"_3170":1300,"_28017":1239,"_19412":49458,"_5":13306,"_25509":49275,"_2665":23214},[],{"_3170":1301,"_28017":1239,"_19412":49460,"_5":13306,"_25509":49275,"_2665":49461},[],"Yes",{"_3170":1302,"_28017":1239,"_19412":49463,"_5":13306,"_25509":49275,"_2665":49464},[],"Unique identifier of this connector instance. Used as the metadata namespace: `lamassu.io/iot/{connector_id}`.",{"_3170":1303,"_28017":1239,"_19412":49466,"_5":13306,"_25509":49275,"_2665":49467},[],"`aws_config.region`",{"_3170":1304,"_28017":1239,"_19412":49469,"_5":13306,"_25509":49275,"_2665":23214},[],{"_3170":1305,"_28017":1239,"_19412":49471,"_5":13306,"_25509":49275,"_2665":49461},[],{"_3170":1306,"_28017":1239,"_19412":49473,"_5":13306,"_25509":49275,"_2665":49474},[],"AWS region where the connector operates.",{"_3170":1307,"_28017":1239,"_19412":49476,"_5":13306,"_25509":49275,"_2665":49477},[],"`aws_config.auth_method`",{"_3170":1308,"_28017":1239,"_19412":49479,"_5":13306,"_25509":49275,"_2665":23214},[],{"_3170":1309,"_28017":1239,"_19412":49481,"_5":13306,"_25509":49275,"_2665":49461},[],{"_3170":1310,"_28017":1239,"_19412":49483,"_5":13306,"_25509":49275,"_2665":49484},[],"Authentication method: `static`, `role` or empty (SDK default credential chain).",{"_3170":1311,"_28017":1239,"_19412":49486,"_5":13306,"_25509":49275,"_2665":49487},[],"`aws_config.access_key_id`",{"_3170":1312,"_28017":1239,"_19412":49489,"_5":13306,"_25509":49275,"_2665":23214},[],{"_3170":1313,"_28017":1239,"_19412":49491,"_5":13306,"_25509":49275,"_2665":49492},[],"Only with `auth_method=static`",{"_3170":1314,"_28017":1239,"_19412":49494,"_5":13306,"_25509":49275,"_2665":49495},[],"AWS access key.",{"_3170":1315,"_28017":1239,"_19412":49497,"_5":13306,"_25509":49275,"_2665":49498},[],"`aws_config.secret_access_key`",{"_3170":1316,"_28017":1239,"_19412":49500,"_5":13306,"_25509":49275,"_2665":23214},[],{"_3170":1317,"_28017":1239,"_19412":49502,"_5":13306,"_25509":49275,"_2665":49492},[],{"_3170":1318,"_28017":1239,"_19412":49504,"_5":13306,"_25509":49275,"_2665":49505},[],"AWS secret key.",{"_3170":1319,"_28017":1239,"_19412":49507,"_5":13306,"_25509":49275,"_2665":49508},[],"`aws_config.session_token`",{"_3170":1320,"_28017":1239,"_19412":49510,"_5":13306,"_25509":49275,"_2665":23214},[],{"_3170":1321,"_28017":1239,"_19412":49512,"_5":13306,"_25509":49275,"_2665":49513},[],"No",{"_3170":1322,"_28017":1239,"_19412":49515,"_5":13306,"_25509":49275,"_2665":49516},[],"Session token (with `auth_method=static`).",{"_3170":1323,"_28017":1239,"_19412":49518,"_5":13306,"_25509":49275,"_2665":49519},[],"`aws_config.role_arn`",{"_3170":1324,"_28017":1239,"_19412":49521,"_5":13306,"_25509":49275,"_2665":23214},[],{"_3170":1325,"_28017":1239,"_19412":49523,"_5":13306,"_25509":49275,"_2665":49524},[],"Only with `auth_method=role`",{"_3170":1326,"_28017":1239,"_19412":49526,"_5":13306,"_25509":49275,"_2665":49527},[],"ARN of the role to assume.",{"_3170":1327,"_28017":1239,"_19412":49529,"_5":13306,"_25509":49275,"_2665":49530},[],"`aws_config.endpoint_url`",{"_3170":1328,"_28017":1239,"_19412":49532,"_5":13306,"_25509":49275,"_2665":23214},[],{"_3170":1329,"_28017":1239,"_19412":49534,"_5":13306,"_25509":49275,"_2665":49513},[],{"_3170":1330,"_28017":1239,"_19412":49536,"_5":13306,"_25509":49275,"_2665":49537},[],"Alternative URL for all AWS services (useful with LocalStack in tests).",{"_3170":1331,"_28017":1239,"_19412":49539,"_5":13306,"_25509":49275,"_2665":49540},[],"`subscriber_event_bus`",{"_3170":1332,"_28017":1239,"_19412":49542,"_5":13306,"_25509":49275,"_2665":16340},[],{"_3170":1333,"_28017":1239,"_19412":49544,"_5":13306,"_25509":49275,"_2665":49461},[],{"_3170":1334,"_28017":1239,"_19412":49546,"_5":13306,"_25509":49275,"_2665":49547},[],"Configuration of the event bus the connector subscribes to (AMQP or AWS SQS/SNS).",{"_3170":1335,"_28017":1239,"_19412":49549,"_5":13306,"_25509":49275,"_2665":49550},[],"`dms_manager_client`",{"_3170":1336,"_28017":1239,"_19412":49552,"_5":13306,"_25509":49275,"_2665":23214},[],{"_3170":1337,"_28017":1239,"_19412":49554,"_5":13306,"_25509":49275,"_2665":49461},[],{"_3170":1338,"_28017":1239,"_19412":49556,"_5":13306,"_25509":49275,"_2665":49557},[],"HTTP URL of Lamassu's DMS Manager service.",{"_3170":1339,"_28017":1239,"_19412":49559,"_5":13306,"_25509":49275,"_2665":49560},[],"`device_manager_client`",{"_3170":1340,"_28017":1239,"_19412":49562,"_5":13306,"_25509":49275,"_2665":23214},[],{"_3170":1341,"_28017":1239,"_19412":49564,"_5":13306,"_25509":49275,"_2665":49461},[],{"_3170":1342,"_28017":1239,"_19412":49566,"_5":13306,"_25509":49275,"_2665":49567},[],"HTTP URL of Lamassu's Device Manager.",{"_3170":1343,"_28017":1239,"_19412":49569,"_5":13306,"_25509":49275,"_2665":49570},[],"`ca_client`",{"_3170":1344,"_28017":1239,"_19412":49572,"_5":13306,"_25509":49275,"_2665":23214},[],{"_3170":1345,"_28017":1239,"_19412":49574,"_5":13306,"_25509":49275,"_2665":49461},[],{"_3170":1346,"_28017":1239,"_19412":49576,"_5":13306,"_25509":49275,"_2665":49577},[],"HTTP URL of Lamassu's CA service.",{"_3170":1347,"_28017":1239,"_19412":49579,"_5":13306,"_25509":49279,"_2665":49580},[],"For devices to authenticate to AWS IoT Core with certificates issued by a Lamassu CA, that CA must first be registered in the AWS account. The connector handles this registration automatically in response to the `EventCreateCAKey`, `EventImportCAKey` and `EventUpdateCAMetadataKey` events, but the operation **only fires when the administrator explicitly requests it** through the CA metadata field.",{"_3170":1348,"_28017":1239,"_19412":49582,"_5":13306,"_25509":49283,"_2665":49583},[],"Registration is triggered by setting `registration.status = \"REQUESTED\"` on the `lamassu.io/iot/{connector_id}` key of the CA's metadata. This can be done from the Lamassu console in the CA management section or through the API.",{"_3170":1349,"_28017":1239,"_19412":49585,"_5":13306,"_25509":49283,"_2665":49586},[],"Once the event is received, the connector attempts to register the CA in AWS and updates the `registration.status` field in the CA's metadata with the result: `\"SUCCEEDED\"` if registration was successful, or `\"FAILED\"` with an error message otherwise. The process is asynchronous, so you must periodically check the metadata status until the operation completes.",{"_3170":1350,"_28017":1239,"_19412":49588,"_5":13306,"_25509":49287,"_2665":49589},[],"When the `primary_account` parameter is `true`, the connector runs the full registration flow with proof-of-possession of the private key:",{"_3170":1351,"_28017":1239,"_19412":49591,"_5":13306,"_25509":49287,"_2665":49592},[],"It calls `iot:GetRegistrationCode` to obtain AWS's verification code.",{"_3170":1352,"_28017":1239,"_19412":49594,"_5":13306,"_25509":49287,"_2665":49595},[],"The connector internally generates an ephemeral RSA-2048 key pair and builds a CSR whose Common Name is exactly that registration code. It then calls Lamassu's signing service so the registered CA issues a real X.509 verification certificate signing that CSR. The ephemeral private key is used only for this purpose and is neither stored nor sent to AWS.",{"_3170":1353,"_28017":1239,"_19412":49597,"_5":13306,"_25509":49287,"_2665":49598},[],"It sends the CA (in PEM) and the verification certificate to AWS via `iot:RegisterCACertificate`, enabling registration with `AllowAutoRegistration: true`.",{"_3170":1354,"_28017":1239,"_19412":49600,"_5":13306,"_25509":49287,"_2665":49601},[],"Only one account can own a CA in a given AWS region. If the CA is already registered with the same serial number, the connector silently skips the step.",{"_3170":1355,"_28017":1239,"_19412":49603,"_5":13306,"_25509":49287,"_2665":49604},[],"The tags AWS IoT Core applies to the registered CA certificate are `LMS.CA.ID`, `LMS.CA.SN` and `LMS.CA.CN`.",{"_3170":1356,"_28017":1239,"_19412":49606,"_5":13306,"_25509":49291,"_2665":49607},[],"When `primary_account` is `false`, the connector registers the CA using `CertificateMode: SNI_ONLY`. This mode requires no verification code or access to the CA's private key, so it is the right choice when the CA is managed from another AWS account or when the administrator does not hold the private key. It is the usual method to register the same CA in several AWS accounts simultaneously.",{"_3170":1357,"_28017":1239,"_19412":49609,"_5":13306,"_25509":49295,"_2665":49610},[],"Each DMS participating in the AWS IoT Core integration must have the metadata key `lamassu.io/iot/{connector_id}` configured. The most important field of that configuration is `registration_mode`, which determines how devices are provisioned in AWS.",{"_3170":1358,"_28017":1239,"_19412":49612,"_5":13306,"_25509":49295,"_2665":49613},[],"There are three registration modes, and the choice among them depends on the fleet's provisioning strategy.",{"_3170":1359,"_28017":1239,"_19412":49615,"_5":13306,"_25509":49299,"_2665":49616},[],"In this mode the connector **creates no Things, groups or policies** in AWS IoT Core. It only syncs certificate status (active, revoked, suspended) as it changes in Lamassu. It is the right mode when Thing provisioning in AWS is managed by an external system and Lamassu only needs to keep certificate status up to date.",{"_3170":1360,"_28017":1239,"_19412":49618,"_5":13306,"_25509":49303,"_2665":49619},[],"`auto` mode delegates full device provisioning in AWS to Lamassu at enrollment time. When the device successfully completes its EST enrollment and Lamassu emits the `EventBindDeviceIdentityKey` event, the connector automatically executes the following sequence:",{"_3170":1361,"_28017":1239,"_19412":49621,"_5":13306,"_25509":49303,"_2665":49622},[],"Creates or updates the IoT policies configured in the DMS.",{"_3170":1362,"_28017":1239,"_19412":49624,"_5":13306,"_25509":49303,"_2665":49625},[],"Creates the root group `LAMASSU` in the AWS account (if it does not exist) and the child groups configured in the DMS as subgroups of `LAMASSU`. If the groups already exist, the `ResourceAlreadyExistsException` error is ignored, making the operation idempotent.",{"_3170":1363,"_28017":1239,"_19412":49627,"_5":13306,"_25509":49303,"_2665":49628},[],"If the Thing already existed in AWS IoT Core, the connector iterates all certificates (principals) currently attached to that Thing and marks them as `REVOKED` in AWS, ensuring previous certificates cannot keep being used to authenticate.",{"_3170":1364,"_28017":1239,"_19412":49630,"_5":13306,"_25509":49303,"_2665":49631},[],"Calls `iot:RegisterThing` with a CloudFormation-style provisioning template that creates the Thing, registers the device's certificate (PEM of the device certificate and of the issuing CA certificate) and attaches the configured policies.",{"_3170":1365,"_28017":1239,"_19412":49633,"_5":13306,"_25509":49303,"_2665":49634},[],"Once provisioning completes, the connector stores the resulting certificate's ARN in the Lamassu certificate's metadata under the key `lamassu.io/iot/{connector_id}` and marks the device as `Registered: true` in Device Manager.",{"_3170":1366,"_28017":1239,"_19412":49636,"_5":13306,"_25509":49303,"_2665":49637},[],"**The Thing name in AWS is the Common Name (CN) of the device's certificate.** This convention is fundamental for the firmware developer: the `/CN=` value the device includes in its CSR when enrolling becomes the ThingName it must identify itself with in all MQTT operations against AWS IoT Core.",{"_3170":1367,"_28017":1239,"_19412":49639,"_5":13306,"_25509":49307,"_2665":49640},[],"Just-In-Time Provisioning (JITP) mode delegates provisioning to AWS instead of the connector doing it directly. When the connector detects the DMS is in `jitp` mode, it creates a JITP provisioning template in AWS IoT Core and attaches it to the registered CA certificate. This template is created or updated at the moment the DMS is created or updated in Lamassu — not at device enrollment time. From then on, when a device with a certificate issued by that CA connects to AWS IoT Core for the first time, AWS executes the template automatically: it creates the Thing, registers the certificate and activates it.",{"_3170":1368,"_28017":1239,"_19412":49642,"_5":13306,"_25509":49307,"_2665":49643},[],"The Thing name in the JITP template is derived from `AWS::IoT::Certificate::CommonName`, which corresponds to the device certificate's CN — the same convention as `auto` mode.",{"_3170":1369,"_28017":1239,"_19412":49645,"_5":13306,"_25509":49307,"_2665":49646},[],"This mode requires the `jitp_config.provisioning_role_arn` field to be configured with the ARN of an IAM role AWS IoT Core can assume to execute the template. If not configured, the connector uses the default `arn:aws:iam::{account}:role/JITPRole` and logs a warning. The administrator must ensure that role exists in the account and has the necessary permissions before enabling JITP mode.",{"_3170":1370,"_28017":1239,"_19412":49648,"_5":13306,"_25509":49311,"_2665":49649},[],"For the firmware developer, `auto` mode is transparent: the device performs its EST enrollment as usual and, as a side effect, it is provisioned in AWS IoT Core with no additional step.",{"_3170":1371,"_28017":1239,"_19412":49651,"_5":13306,"_25509":49311,"_2665":49652},[],"The full flow from the device's perspective is:",{"_3170":1372,"_28017":1239,"_19412":49654,"_5":13306,"_25509":49311,"_2665":49655},[],"Once the connector completes provisioning, the device can connect to the AWS IoT Core MQTT endpoint using its private key and the certificate issued by Lamassu. The ThingName it must identify itself with in AWS is exactly the certificate's CN.",{"_3170":1373,"_28017":1239,"_19412":49657,"_5":13306,"_25509":49315,"_2665":49658},[],"In JITP mode the device also performs its EST enrollment conventionally and obtains its certificate from Lamassu. The difference is that AWS IoT Core does not know the device until it attempts its first connection.",{"_3170":1374,"_28017":1239,"_19412":49660,"_5":13306,"_25509":49315,"_2665":49661},[],"When the device establishes its first MQTT connection to AWS IoT Core presenting the Lamassu-issued certificate, AWS detects that the certificate belongs to a CA registered with a JITP template, executes that template and creates the Thing automatically. The initial connection may fail or be delayed while the template runs; firmware must be prepared to retry the connection.",{"_3170":1375,"_28017":1239,"_19412":49663,"_5":13306,"_25509":49315,"_2665":49664},[],"For the JITP flow to work correctly:",{"_3170":1376,"_28017":1239,"_19412":49666,"_5":13306,"_25509":49315,"_2665":49667},[],"The CA must be registered in AWS in Primary Account mode (SNI-only mode does not support JITP).",{"_3170":1377,"_28017":1239,"_19412":49669,"_5":13306,"_25509":49315,"_2665":49670},[],"The IAM role configured in `jitp_config.provisioning_role_arn` must exist and have permissions to create Things, register certificates and attach policies in the AWS account.",{"_3170":1378,"_28017":1239,"_19412":49672,"_5":13306,"_25509":49315,"_2665":49673},[],"The device must present both its certificate and the issuing CA's certificate in the TLS handshake with AWS IoT Core.",{"_3170":1379,"_28017":1239,"_19412":49675,"_5":13306,"_25509":49315,"_2665":49676},[],"Certificates provisioned via JITP **do not have the connector's metadata key** (`lamassu.io/iot/{connector_id}`) in Lamassu. As a consequence, status changes of those certificates in Lamassu are not automatically synced to AWS through the state synchronization mechanism described in the next section.",{"_3170":1380,"_28017":1239,"_19412":49678,"_5":13306,"_25509":49319,"_2665":49679},[],"The connector listens for the `EventUpdateCertificateStatusKey` event and, when a certificate holding the connector's metadata key changes status in Lamassu, replicates that change in AWS IoT Core. The following table shows the status mapping:",{"_3170":1381,"_28017":1239,"_19412":49681,"_5":13306,"_25509":49319,"_2665":49682},[],"Status in Lamassu",{"_3170":1382,"_28017":1239,"_19412":49684,"_5":13306,"_25509":49319,"_2665":49685},[],"Revocation reason",{"_3170":1383,"_28017":1239,"_19412":49687,"_5":13306,"_25509":49319,"_2665":49688},[],"Status in AWS IoT Core",{"_3170":1384,"_28017":1239,"_19412":49690,"_5":13306,"_25509":49319,"_2665":49691},[],"`Active`",{"_3170":1385,"_28017":1239,"_19412":49693,"_5":13306,"_25509":49319,"_2665":49694},[],"None",{"_3170":1386,"_28017":1239,"_19412":49696,"_5":13306,"_25509":49319,"_2665":49697},[],"`ACTIVE`",{"_3170":1387,"_28017":1239,"_19412":49699,"_5":13306,"_25509":49319,"_2665":49700},[],"`Revoked`",{"_3170":1388,"_28017":1239,"_19412":49702,"_5":13306,"_25509":49319,"_2665":49703},[],"`certificateHold`",{"_3170":1389,"_28017":1239,"_19412":49705,"_5":13306,"_25509":49319,"_2665":49706},[],"`INACTIVE`",{"_3170":1390,"_28017":1239,"_19412":49708,"_5":13306,"_25509":49319,"_2665":49700},[],{"_3170":1391,"_28017":1239,"_19412":49710,"_5":13306,"_25509":49319,"_2665":49711},[],"Any other reason",{"_3170":1392,"_28017":1239,"_19412":49713,"_5":13306,"_25509":49319,"_2665":49714},[],"`REVOKED`",{"_3170":1393,"_28017":1239,"_19412":49716,"_5":13306,"_25509":49319,"_2665":49717},[],"Only the `Active` and `Revoked` states produce a call to `iot:UpdateCertificate`. The other lifecycle states of Lamassu (`RenewalWindow`, `AboutToExpire`, `Expired`) are not synced to AWS IoT Core; the certificate status in AWS remains unchanged until the status in Lamassu becomes `Active` or `Revoked`.",{"_3170":1394,"_28017":1239,"_19412":49719,"_5":13306,"_25509":49323,"_2665":49720},[],"When the connector marks a certificate as `REVOKED` or `INACTIVE` in AWS, it additionally performs a forced disconnect of the device. To do so it opens an MQTT connection over WebSocket (with SigV4 authentication using the connector's credentials) to the AWS IoT Core data endpoint, using the certificate's CN as the MQTT client identifier, and closes it immediately. This terminates any active MQTT session the device may have at that moment.",{"_3170":1395,"_28017":1239,"_19412":49722,"_5":13306,"_25509":49323,"_2665":49723},[],"This forced disconnect happens at the moment Lamassu records the status change. If the device tries to reconnect after the disconnect, AWS IoT Core will reject the connection because the certificate is already listed as `REVOKED` or `INACTIVE`.",{"_3170":1396,"_28017":1239,"_19412":49725,"_5":13306,"_25509":49323,"_2665":49726},[],"Certificates provisioned in JITP mode do not have this automatic sync, since they lack the connector's metadata key.",{"_3170":1397,"_28017":1239,"_19412":49728,"_5":13306,"_25509":49327,"_2665":49729},[],"The connector can write to the AWS IoT Core Device Shadow to send action signals to the device firmware. This feature is enabled per DMS with `shadow_config.enable: true`.",{"_3170":1398,"_28017":1239,"_19412":49731,"_5":13306,"_25509":49327,"_2665":49732},[],"If `shadow_config.shadow_name` holds a value, the connector uses a Named Shadow with that name; otherwise it uses the Classic Shadow (the Thing's default shadow).",{"_3170":1399,"_28017":1239,"_19412":49734,"_5":13306,"_25509":49331,"_2665":49735},[],"The connector writes to the `desired.identity_actions` field of the shadow document. Each entry contains a Unix timestamp in milliseconds. The device firmware must read this field and act accordingly.",{"_3170":1400,"_28017":1239,"_19412":49737,"_5":13306,"_25509":49331,"_2665":49738},[],"There are two action types:",{"_3170":1401,"_28017":1239,"_19412":49740,"_5":13306,"_25509":49331,"_2665":49741},[],"**`UPDATE_CERTIFICATE`**: written when a certificate's preventive renewal window activates — that is, when the `triggered` field of the preventive renewal delta flips from `false` to `true`. This action tells the device it must start the re-enrollment process to renew its certificate before it expires.",{"_3170":1402,"_28017":1239,"_19412":49743,"_5":13306,"_25509":49331,"_2665":49744},[],"**`UPDATE_TRUST_ANCHOR_LIST`**: written to all devices of a DMS when the DMS's `ManagedCAs` list changes. This action tells the device it must update its trusted CA store.",{"_3170":1403,"_28017":1239,"_19412":49746,"_5":13306,"_25509":49331,"_2665":49747},[],"The shadow write process consists of reading the current shadow (`iotdata:GetThingShadow`), merging the new actions with the existing ones and writing the result (`iotdata:UpdateThingShadow`). If the shadow does not exist, the connector creates it. After a successful write, the list of pending actions in the device's metadata in Lamassu is cleared.",{"_3170":1404,"_28017":1239,"_19412":49749,"_5":13306,"_25509":49335,"_2665":49750},[],"The connector creates and attaches the policies configured in the DMS. A typical policy for a device using MQTT and the Device Shadow has this structure:",{"_3170":1405,"_28017":1239,"_19412":49752,"_5":13306,"_25509":49335,"_2665":49753},[],"In the policy above, the `<AWS_REGION>` and `<AWS_ACCOUNT_ID>` placeholders must be replaced with the AWS region and the twelve-digit account identifier of the target account before applying the policy. The `${iot:Connection.Thing.ThingName}` variable automatically limits each permission to the Thing the device is connected as, following the principle of least privilege. The `${ShadowName}` variable in the shadow ARNs is a placeholder that must be replaced with the `shadow_config.shadow_name` value configured in the DMS; if the Classic Shadow is used, it can be simplified by removing the `name/${ShadowName}/` segment. AWS IoT policies do not support regex alternation; the `[name/${ShadowName}/]*` notation represents the optionality of that segment within ARN syntax constraints.",{"_3170":1406,"_28017":1239,"_19412":49755,"_5":13306,"_25509":49335,"_2665":49756},[],"The first statement lets the device connect using its ThingName as the MQTT identifier. The second authorizes publishing to the Thing's generic MQTT topic and to the shadow topics, needed so the device can update its reported state. The last two statements grant subscribe and receive permissions over the same topics, letting the device receive shadow updates (for example, the `UPDATE_CERTIFICATE` and `UPDATE_TRUST_ANCHOR_LIST` actions written by the connector).",{"_3170":1407,"_28017":1239,"_19412":49758,"_5":13306,"_25509":49339,"_2665":49759},[],"**Symptom:** The CA registration stays in `REQUESTED` indefinitely.",{"_3170":1408,"_28017":1239,"_19412":49761,"_5":13306,"_25509":49339,"_2665":49762},[],"**Cause:** The connector is not running or is not subscribed to the event bus. It can also indicate incorrect IAM credentials, insufficient permissions or that the metadata key was written with a wrong `connector_id`.",{"_3170":1409,"_28017":1239,"_19412":49764,"_5":13306,"_25509":49339,"_2665":49765},[],"**Resolution:** Verify the connector process is active and the logs show no AWS communication errors. Check the metadata field was written under the exact key `lamassu.io/iot/{connector_id}`. If the error persists, the connector will update the status to `FAILED` with a descriptive message in the CA metadata.",{"_3170":1410,"_28017":1239,"_19412":49767,"_5":13306,"_25509":49339,"_2665":49768},[],"**Symptom:** A certificate's status is not synced to AWS after a revocation.",{"_3170":1411,"_28017":1239,"_19412":49770,"_5":13306,"_25509":49339,"_2665":49771},[],"**Cause:** Most commonly the certificate was provisioned in JITP mode. JITP certificates lack the connector's metadata key and are outside the state synchronization mechanism. If the DMS is in `auto` mode, it may indicate the initial provisioning did not complete correctly and the AWS ARN was not stored in the certificate metadata.",{"_3170":1412,"_28017":1239,"_19412":49773,"_5":13306,"_25509":49339,"_2665":49774},[],"**Resolution:** For JITP certificates, migrate the DMS to `auto` mode and re-provision the affected devices. For `auto` mode certificates, verify the certificate has the AWS ARN stored in its metadata; if not, repeat the provisioning.",{"_3170":1413,"_28017":1239,"_19412":49776,"_5":13306,"_25509":49339,"_2665":49777},[],"**Symptom:** The forced disconnect does not terminate the device's MQTT session after revocation.",{"_3170":1414,"_28017":1239,"_19412":49779,"_5":13306,"_25509":49339,"_2665":49780},[],"**Cause:** The device uses an MQTT client ID different from the certificate's CN. The forced disconnect opens a connection using the CN as client ID; if the firmware uses another identifier, the disconnect does not affect that session.",{"_3170":1415,"_28017":1239,"_19412":49782,"_5":13306,"_25509":49339,"_2665":49783},[],"**Resolution:** Make sure the firmware uses exactly the certificate's CN as the MQTT client identifier. That CN matches the ThingName in AWS IoT Core.",{"_3170":1416,"_28017":1239,"_19412":49785,"_5":13306,"_25509":49339,"_2665":49786},[],"**Symptom:** The device receives `CLIENT_ID_REJECTED` when connecting to AWS IoT Core.",{"_3170":1417,"_28017":1239,"_19412":49788,"_5":13306,"_25509":49339,"_2665":49789},[],"**Cause:** The MQTT client ID does not match the ThingName, which is always the CN of the certificate issued by Lamassu.",{"_3170":1418,"_28017":1239,"_19412":49791,"_5":13306,"_25509":49339,"_2665":49792},[],"**Resolution:** Verify the firmware uses exactly the value of the CN field included in the enrollment CSR as the MQTT client identifier.",{"_3170":1419,"_28017":1239,"_19412":49794,"_5":13306,"_25509":49339,"_2665":49795},[],"**Symptom:** The device's first MQTT connection in JITP mode fails or times out.",{"_3170":1420,"_28017":1239,"_19412":49797,"_5":13306,"_25509":49339,"_2665":49798},[],"**Cause:** This is expected behavior while AWS executes the JITP template on the device's first connection.",{"_3170":1421,"_28017":1239,"_19412":49800,"_5":13306,"_25509":49339,"_2665":49801},[],"**Resolution:** Firmware must implement retries with exponential backoff for the first connection. If the failure persists beyond a few minutes, verify the IAM role configured in `jitp_config.provisioning_role_arn` exists in the account and has permissions to create Things, register certificates and attach policies.",{"_3170":1422,"_28017":1239,"_19412":49803,"_5":13306,"_25509":49339,"_2665":49804},[],"**Symptom:** The Device Shadow is not updated when it should be.",{"_3170":1423,"_28017":1239,"_19412":49806,"_5":13306,"_25509":49339,"_2665":49807},[],"**Cause:** The shadow feature is disabled in the DMS configuration, the connector's credentials lack IoT data-plane permissions, or the firmware reads a different shadow than the configured one.",{"_3170":1424,"_28017":1239,"_19412":49809,"_5":13306,"_25509":49339,"_2665":49810},[],"**Resolution:** Check that `shadow_config.enable` is `true` in the connector metadata for the corresponding DMS. If a Named Shadow is used, verify `shadow_config.shadow_name` holds the correct name and that the firmware reads that Named Shadow and not the Classic Shadow. Confirm the connector's credentials have `iotdata:GetThingShadow` and `iotdata:UpdateThingShadow` permissions.",{"_3170":1425,"_28017":1239,"_19412":49812,"_5":13306,"_25509":49339,"_2665":49813},[],"<Card title=\"Configure a DMS\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_3170":1426,"_28017":1239,"_19412":49815,"_5":13306,"_25509":49339,"_2665":49816},[],"<Card title=\"Device enrollment (EST)\" href=\"/docs/platform/iot-fleets/enrollment/overview\" />",{"_3170":1427,"_28017":1239,"_19412":49818,"_5":13306,"_25509":49339,"_2665":49819},[],"<Card title=\"Certificate management\" href=\"/docs/platform/pki/certificates\" />",{"_3170":1428,"_28017":1428,"_5":13637,"_2665":47794,"_28339":49821,"_19412":49822,"_25509":1428},[45393,46786,47794],[],{"_3170":1429,"_28017":1428,"_19412":49824,"_5":13306,"_25509":1428,"_2665":49825},[],"Organize devices and their identities, prepare enrollment and integrate consumers.",{"_3170":1430,"_28017":1428,"_5":28336,"_19412":49827,"_25509":49828,"_2665":49829},[],"/docs/platform/iot-fleets/overview#start-here","Start here",{"_3170":1431,"_28017":1428,"_5":28336,"_19412":49831,"_25509":49832,"_2665":47792},[],"/docs/platform/iot-fleets/overview#devices-and-identities",{"_3170":1432,"_28017":1428,"_5":28336,"_19412":49834,"_25509":49835,"_2665":47975},[],"/docs/platform/iot-fleets/overview#enrollment-with-pki",{"_3170":1433,"_28017":1428,"_5":28336,"_19412":49837,"_25509":49838,"_2665":49256},[],"/docs/platform/iot-fleets/overview#integrations",{"_3170":1434,"_28017":1428,"_5":28336,"_19412":49840,"_25509":49841,"_2665":49842},[],"/docs/platform/iot-fleets/overview#who-prepares-each-part","Who prepares each part",{"_3170":1435,"_28017":1428,"_19412":49844,"_5":13306,"_25509":1428,"_2665":49845},[],"IoT Fleets applies PKI to the device lifecycle: registration, obtaining an identity, renewal and retirement. It is intended for those who administer a device population and those who integrate its enrollment client or the system that accepts it.",{"_3170":1436,"_28017":1428,"_19412":49847,"_5":13306,"_25509":49828,"_2665":49848},[],"Follow Enroll and connect your first device to prepare a DMS, obtain the identity from the client and demonstrate an mTLS connection. The automatic path includes initial trust, a CSR and result checks.",{"_3170":1437,"_28017":1428,"_19412":49850,"_5":13306,"_25509":49828,"_2665":49851},[],"To start with an existing certificate, use Register a device manually. You can then prepare enrollment and renewal for the next device.",{"_3170":1438,"_28017":1428,"_19412":49853,"_5":13306,"_25509":49832,"_2665":49854},[],"Resource",{"_3170":1439,"_28017":1428,"_19412":49856,"_5":13306,"_25509":49832,"_2665":49857},[],"What it represents",{"_3170":1440,"_28017":1428,"_19412":49859,"_5":13306,"_25509":49832,"_2665":49860},[],"**Device**",{"_3170":1441,"_28017":1428,"_19412":49862,"_5":13306,"_25509":49832,"_2665":49863},[],"An inventory entry with an identifier, owning DMS and classification.",{"_3170":1442,"_28017":1428,"_19412":49865,"_5":13306,"_25509":49832,"_2665":49866},[],"**Identity**",{"_3170":1443,"_28017":1428,"_19412":49868,"_5":13306,"_25509":49832,"_2665":49869},[],"The device's association with its certificates: an active version and a history.",{"_3170":1444,"_28017":1428,"_19412":49871,"_5":13306,"_25509":49832,"_2665":49872},[],"**DMS**",{"_3170":1445,"_28017":1428,"_19412":49874,"_5":13306,"_25509":49832,"_2665":49875},[],"The service that configures admission, enrollment, renewal and trust distribution.",{"_3170":1446,"_28017":1428,"_19412":49877,"_5":13306,"_25509":49832,"_2665":49878},[],"**Fleet**",{"_3170":1447,"_28017":1428,"_19412":49880,"_5":13306,"_25509":49832,"_2665":49881},[],"The population you operate, represented through devices, DMSs, tags and metadata.",{"_3170":1448,"_28017":1428,"_19412":49883,"_5":13306,"_25509":49832,"_2665":49884},[],"Each device has an owning DMS. You can organize a population through several DMSs when it needs different policies, and use tags to classify it. “Fleet” describes that operational context; the resources you create and query are DMSs and devices.",{"_3170":1449,"_28017":1428,"_19412":49886,"_5":13306,"_25509":49832,"_2665":49887},[],"Device management covers states, certificate history and identity actions. During renewal, retain the relationship with the device and check which certificate becomes the current identity.",{"_3170":1450,"_28017":1428,"_19412":49889,"_5":13306,"_25509":49835,"_2665":49890},[],"This section connects PKI rules to the device client. Preparation follows this order:",{"_3170":1451,"_28017":1428,"_19412":49892,"_5":13306,"_25509":49835,"_2665":49893},[],"**CA and profile:** prepare the issuer and certificate rules in PKI.",{"_3170":1452,"_28017":1428,"_19412":49895,"_5":13306,"_25509":49835,"_2665":49896},[],"**DMS policy:** define how the device is admitted, how requests authenticate and which trust is distributed.",{"_3170":1453,"_28017":1428,"_19412":49898,"_5":13306,"_25509":49835,"_2665":49899},[],"**Client:** prepare the initial credential, server trust, and key generation or custody.",{"_3170":1454,"_28017":1428,"_19412":49901,"_5":13306,"_25509":49835,"_2665":49902},[],"**Result:** request the certificate, install it and check its association with the device.",{"_3170":1455,"_28017":1428,"_19412":49904,"_5":13306,"_25509":49835,"_2665":49905},[],"**Continuity:** configure renewal, successor installation and recovery according to DMS policy.",{"_3170":1456,"_28017":1428,"_19412":49907,"_5":13306,"_25509":49835,"_2665":49908},[],"<Card title=\"Configure the DMS\" description=\"Prepare the CA, admission, authentication and renewal rules.\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_3170":1457,"_28017":1428,"_19412":49910,"_5":13306,"_25509":49835,"_2665":49911},[],"<Card title=\"Integrate the EST client\" description=\"Review the device endpoints, formats and checks.\" href=\"/docs/platform/iot-fleets/enrollment/est-client\" />",{"_3170":1458,"_28017":1428,"_19412":49913,"_5":13306,"_25509":49838,"_2665":49914},[],"An issued identity needs a consumer that trusts its issuer, validates the certificate and grants the device permissions. Prepare both the device's trust in the server and the server's trust in the device.",{"_3170":1459,"_28017":1428,"_19412":49916,"_5":13306,"_25509":49838,"_2665":49917},[],"The AWS IoT Core guide explains how to use the identity in that destination. Provisioning in Lamassu and provisioning in the destination are separate decisions; review the conditions of the chosen mode before expecting state synchronization.",{"_3170":1460,"_28017":1428,"_19412":49919,"_5":13306,"_25509":49841,"_2665":49920},[],"Participant",{"_3170":1461,"_28017":1428,"_19412":49922,"_5":13306,"_25509":49841,"_2665":49923},[],"Responsibility",{"_3170":1462,"_28017":1428,"_19412":49925,"_5":13306,"_25509":49841,"_2665":49926},[],"PKI administrator",{"_3170":1463,"_28017":1428,"_19412":49928,"_5":13306,"_25509":49841,"_2665":49929},[],"CA, issuance profile, chain and revocation publication.",{"_3170":1464,"_28017":1428,"_19412":49931,"_5":13306,"_25509":49841,"_2665":49932},[],"Provisioning administrator",{"_3170":1465,"_28017":1428,"_19412":49934,"_5":13306,"_25509":49841,"_2665":49935},[],"DMS, admission, authentication per operation and inventory.",{"_3170":1466,"_28017":1428,"_19412":49937,"_5":13306,"_25509":49841,"_2665":49938},[],"Device integrator",{"_3170":1467,"_28017":1428,"_19412":49940,"_5":13306,"_25509":49841,"_2665":49941},[],"Initial credential, key, EST client, trust and certificate installation.",{"_3170":1468,"_28017":1428,"_19412":49943,"_5":13306,"_25509":49841,"_2665":49944},[],"Consumer integrator",{"_3170":1469,"_28017":1428,"_19412":49946,"_5":13306,"_25509":49841,"_2665":49947},[],"Trusted issuers, validation and device permissions in the destination.",{"_3170":1470,"_28017":1428,"_19412":49949,"_5":13306,"_25509":49841,"_2665":49950},[],"Permissions and audit are shared with the rest of Platform. Prepare installation and instance connectivity in Deployment.",{"_3170":1471,"_28017":1471,"_5":13637,"_2665":49952,"_28339":49953,"_19412":49955,"_25509":1471},"Enroll and connect your first device",[45393,46786,47794,49954],"Getting started",[],{"_3170":1472,"_28017":1471,"_19412":49957,"_5":13306,"_25509":1471,"_2665":49958},[],"Obtain an identity through EST, verify its association and use it in an mTLS connection.",{"_3170":1473,"_28017":1471,"_5":28336,"_19412":49960,"_25509":49961,"_2665":45403},[],"/docs/platform/iot-fleets/quickstarts/enroll-device#before-you-begin",{"_3170":1474,"_28017":1471,"_5":28336,"_19412":49963,"_25509":49964,"_2665":49965},[],"/docs/platform/iot-fleets/quickstarts/enroll-device#prepare-the-bootstrap-credential","Prepare the bootstrap credential",{"_3170":1475,"_28017":1471,"_5":28336,"_19412":49967,"_25509":49968,"_2665":49969},[],"/docs/platform/iot-fleets/quickstarts/enroll-device#configure-the-evaluation-dms","Configure the evaluation DMS",{"_3170":1476,"_28017":1471,"_5":28336,"_19412":49971,"_25509":49972,"_2665":49973},[],"/docs/platform/iot-fleets/quickstarts/enroll-device#prepare-the-client-and-check-cacerts","Prepare the client and check cacerts",{"_3170":1477,"_28017":1471,"_5":28336,"_19412":49975,"_25509":49976,"_2665":49977},[],"/docs/platform/iot-fleets/quickstarts/enroll-device#enroll-the-device","Enroll the device",{"_3170":1478,"_28017":1471,"_5":28336,"_19412":49979,"_25509":49980,"_2665":49981},[],"/docs/platform/iot-fleets/quickstarts/enroll-device#verify-the-obtained-identity","Verify the obtained identity",{"_3170":1479,"_28017":1471,"_5":28336,"_19412":49983,"_25509":49984,"_2665":49985},[],"/docs/platform/iot-fleets/quickstarts/enroll-device#demonstrate-an-mtls-connection","Demonstrate an mTLS connection",{"_3170":1480,"_28017":1471,"_5":28336,"_19412":49987,"_25509":49988,"_2665":49989},[],"/docs/platform/iot-fleets/quickstarts/enroll-device#result-and-continuity","Result and continuity",{"_3170":1481,"_28017":1471,"_19412":49991,"_5":13306,"_25509":1471,"_2665":49992},[],"Prepare an evaluation DMS, enroll `est-device-001` from the client and use its identity with a local consumer that requires a certificate. The path connects administrator policy to the material the device actually installs.",{"_3170":1482,"_28017":1471,"_19412":49994,"_5":13306,"_25509":49961,"_2665":49995},[],"A Lamassu instance accessible through HTTPS and permissions for CAs, profiles, DMSs and reading devices/certificates.",{"_3170":1483,"_28017":1471,"_19412":49997,"_5":13306,"_25509":49961,"_2665":49998},[],"Bash, OpenSSL 3.x, curl with `--fail-with-body` and two terminals on your computer. Work in a new directory with restricted access.",{"_3170":1484,"_28017":1471,"_19412":50000,"_5":13306,"_25509":49961,"_2665":50001},[],"An active root CA that issues directly, with an available key and sufficient validity. Follow Create your first CA. Save its verified public certificate as `device-root.pem`.",{"_3170":1485,"_28017":1471,"_19412":50003,"_5":13306,"_25509":49961,"_2665":50004},[],"Available global identifier `est-device-001`. This path uses automatic registration: do not create the device in the console first.",{"_3170":1486,"_28017":1471,"_19412":50006,"_5":13306,"_25509":49961,"_2665":50007},[],"The approved root for Lamassu HTTPS in `est-trust.pem`, obtained through an independent channel. It can differ from the device CA; prepare networking/TLS in Deployment.",{"_3170":1487,"_28017":1471,"_19412":50009,"_5":13306,"_25509":49964,"_2665":50010},[],"Issue a bootstrap leaf certificate with `CN=est-device-001`, its own key and Client Authentication use. Follow Issue and verify a certificate, changing its CN and saving the result as `bootstrap.crt` and `bootstrap.key`. Choose validity that covers this test and check the pair and chain.",{"_3170":1488,"_28017":1471,"_19412":50012,"_5":13306,"_25509":49964,"_2665":50013},[],"The same root CA can issue it for this isolated evaluation. The operational identity will have a different key and certificate. The matching CN makes the example easier to read; initial certificate authentication does not itself bind the bootstrap CN to the requested ID. Review admission before applying the policy to a population.",{"_3170":1489,"_28017":1471,"_19412":50015,"_5":13306,"_25509":49968,"_2665":50016},[],"Create an explicit leaf profile compatible with EC P-256, with **Honor Subject**, CN from the CSR, **Digital Signature**, **Client Authentication** and **1 hour** validity within the root's validity. Do not enable CA signing. Rules and precedence are explained in Profiles.",{"_3170":1490,"_28017":1471,"_19412":50018,"_5":13306,"_25509":49968,"_2665":50019},[],"Create the `Acme EST Evaluation` DMS with this configuration:",{"_3170":1491,"_28017":1471,"_19412":50021,"_5":13306,"_25509":49968,"_2665":50022},[],"Setting",{"_3170":1492,"_28017":1471,"_19412":50024,"_5":13306,"_25509":49968,"_2665":50025},[],"Evaluation value",{"_3170":1493,"_28017":1471,"_19412":50027,"_5":13306,"_25509":49968,"_2665":50028},[],"Enrollment CA",{"_3170":1494,"_28017":1471,"_19412":50030,"_5":13306,"_25509":49968,"_2665":50031},[],"Issuing root from `device-root.pem`.",{"_3170":1495,"_28017":1471,"_19412":50033,"_5":13306,"_25509":49968,"_2665":48105},[],{"_3170":1496,"_28017":1471,"_19412":50035,"_5":13306,"_25509":49968,"_2665":50036},[],"The 1-hour leaf profile you just prepared.",{"_3170":1497,"_28017":1471,"_19412":50038,"_5":13306,"_25509":49968,"_2665":50039},[],"Protocol / Registration Mode",{"_3170":1498,"_28017":1471,"_19412":50041,"_5":13306,"_25509":49968,"_2665":50042},[],"`EST_RFC7030` / `JITP`.",{"_3170":1499,"_28017":1471,"_19412":50044,"_5":13306,"_25509":49968,"_2665":50045},[],"Verify CSR Signature",{"_3170":1500,"_28017":1471,"_19412":50047,"_5":13306,"_25509":49968,"_2665":50048},[],"Enabled.",{"_3170":1501,"_28017":1471,"_19412":50050,"_5":13306,"_25509":49968,"_2665":50051},[],"Enable Replaceable Enrollment",{"_3170":1502,"_28017":1471,"_19412":50053,"_5":13306,"_25509":49968,"_2665":50054},[],"Disabled; the ID must be new.",{"_3170":1503,"_28017":1471,"_19412":50056,"_5":13306,"_25509":49968,"_2665":50057},[],"Initial authentication",{"_3170":1504,"_28017":1471,"_19412":50059,"_5":13306,"_25509":49968,"_2665":50060},[],"`CLIENT_CERTIFICATE`; Validation CAs includes the direct bootstrap issuer; no expired certificates.",{"_3170":1505,"_28017":1471,"_19412":50062,"_5":13306,"_25509":49968,"_2665":50063},[],"Renewal authentication",{"_3170":1506,"_28017":1471,"_19412":50065,"_5":13306,"_25509":49968,"_2665":50066},[],"`CLIENT_CERTIFICATE`, configured in the independent re-enrollment block.",{"_3170":1507,"_28017":1471,"_19412":50068,"_5":13306,"_25509":49968,"_2665":50069},[],"Re-enrollment Validation CAs / Enable Expired Renewal",{"_3170":1508,"_28017":1471,"_19412":50071,"_5":13306,"_25509":49968,"_2665":50072},[],"Not needed for this direct issuance; the Enrollment CA is always trusted for re-enrollment / disabled.",{"_3170":1509,"_28017":1471,"_19412":50074,"_5":13306,"_25509":49968,"_2665":50075},[],"Re-enrollment Delta",{"_3170":1510,"_28017":1471,"_19412":50077,"_5":13306,"_25509":49968,"_2665":50078},[],"1 hour.",{"_3170":1511,"_28017":1471,"_19412":50080,"_5":13306,"_25509":49968,"_2665":50081},[],"Preventive / Critical Delta",{"_3170":1512,"_28017":1471,"_19412":50083,"_5":13306,"_25509":49968,"_2665":50084},[],"30 minutes / 10 minutes.",{"_3170":1513,"_28017":1471,"_19412":50086,"_5":13306,"_25509":49968,"_2665":50087},[],"Revoke on Re-enrollment",{"_3170":1514,"_28017":1471,"_19412":50089,"_5":13306,"_25509":49968,"_2665":50090},[],"Disabled to test the successor before retiring the previous identity.",{"_3170":1515,"_28017":1471,"_19412":50092,"_5":13306,"_25509":49968,"_2665":48113},[],{"_3170":1516,"_28017":1471,"_19412":50094,"_5":13306,"_25509":49968,"_2665":50095},[],"Disabled; the operational key is generated in the client.",{"_3170":1517,"_28017":1471,"_19412":50097,"_5":13306,"_25509":49968,"_2665":50098},[],"CA Distribution",{"_3170":1518,"_28017":1471,"_19412":50100,"_5":13306,"_25509":49968,"_2665":50101},[],"Include Enrollment CA enabled; Include Lamassu System CA disabled.",{"_3170":1519,"_28017":1471,"_19412":50103,"_5":13306,"_25509":49968,"_2665":50104},[],"Equal duration and window allow immediate renewal testing. These are evaluation values; size production settings according to connectivity and recovery times. Save, reread both authentication blocks and retain the DMS ID. The console exposes independent editors for the enrollment and re-enrollment authentication; the DMS guide describes their fields, and you can also check the resource through the DMS API.",{"_3170":1520,"_28017":1471,"_19412":50106,"_5":13306,"_25509":49972,"_2665":50107},[],"Place the four trust and bootstrap files in the new directory. Replace the URL with your installation's URL:",{"_3170":1521,"_28017":1471,"_19412":50109,"_5":13306,"_25509":49972,"_2665":50110},[],"The download must succeed and contain the expected enrollment root. Compare its fingerprint with `device-root.pem`. This check does not turn the response into initial trust or prove that you can issue.",{"_3170":1522,"_28017":1471,"_19412":50112,"_5":13306,"_25509":49976,"_2665":50113},[],"Generate a new key and CSR with the selected identifier:",{"_3170":1523,"_28017":1471,"_19412":50115,"_5":13306,"_25509":49976,"_2665":50116},[],"Request the identity with the bootstrap credential and extract the certificate from the default response:",{"_3170":1524,"_28017":1471,"_19412":50118,"_5":13306,"_25509":49976,"_2665":50119},[],"If curl fails, use Troubleshooting with the saved body. Do not convert it or repeat the request without querying inventory: a timeout or error can follow persisted issuance.",{"_3170":1525,"_28017":1471,"_19412":50121,"_5":13306,"_25509":49980,"_2665":50122},[],"Expect `device.crt: OK` and exit code 0 from `cmp`. Check the CN, serial, dates, Digital Signature and Client Authentication. The certificate must be a leaf: it must not declare `CA:TRUE` or Certificate Sign use. Check that its validity matches the one-hour profile.",{"_3170":1526,"_28017":1471,"_19412":50124,"_5":13306,"_25509":49980,"_2665":50125},[],"In Lamassu, open `est-device-001`. It must be created with the intended owning DMS, a current identity and the received certificate in its history. Compare the local serial with the slot; thresholds can show a renewal state rather than simply Active.",{"_3170":1527,"_28017":1471,"_19412":50127,"_5":13306,"_25509":49984,"_2665":50128},[],"In a second terminal, enter the same directory and run `umask 077`. Create a local server certificate and start a test consumer. This server trusts `device-root.pem` and requires a valid client identity:",{"_3170":1528,"_28017":1471,"_19412":50130,"_5":13306,"_25509":49984,"_2665":50131},[],"Leave it running. In the first terminal, connect using the obtained identity:",{"_3170":1529,"_28017":1471,"_19412":50133,"_5":13306,"_25509":49984,"_2665":50134},[],"Expect HTTP `200`. The client's trust in this local server is its self-signed `consumer.crt`; the server verifies the device against `device-root.pem`. The HTML file displays OpenSSL diagnostic information.",{"_3170":1530,"_28017":1471,"_19412":50136,"_5":13306,"_25509":49984,"_2665":50137},[],"With the same server still running, test that a request without a client certificate is rejected:",{"_3170":1531,"_28017":1471,"_19412":50139,"_5":13306,"_25509":49984,"_2665":50140},[],"Rejection must correspond to a missing certificate at the server, not a stopped server. Stop the consumer with Ctrl+C after the test. This exercise demonstrates TLS authentication and key possession; your application must also define authorization and revocation consumption. Server options are described in openssl-s\\_server.",{"_3170":1532,"_28017":1471,"_19412":50142,"_5":13306,"_25509":49988,"_2665":50143},[],"Check",{"_3170":1533,"_28017":1471,"_19412":50145,"_5":13306,"_25509":49988,"_2665":50146},[],"Expected result",{"_3170":1534,"_28017":1471,"_19412":50148,"_5":13306,"_25509":49988,"_2665":50149},[],"Registration",{"_3170":1535,"_28017":1471,"_19412":50151,"_5":13306,"_25509":49988,"_2665":50152},[],"ID created automatically and correct DMS.",{"_3170":1536,"_28017":1471,"_19412":50154,"_5":13306,"_25509":49988,"_2665":50155},[],"Certificate",{"_3170":1537,"_28017":1471,"_19412":50157,"_5":13306,"_25509":49988,"_2665":50158},[],"CN, profile, serial and key verified.",{"_3170":1538,"_28017":1471,"_19412":50160,"_5":13306,"_25509":49988,"_2665":50161},[],"Inventory",{"_3170":1539,"_28017":1471,"_19412":50163,"_5":13306,"_25509":49988,"_2665":50164},[],"Received serial visible as the current identity and in history.",{"_3170":1540,"_28017":1471,"_19412":50166,"_5":13306,"_25509":49988,"_2665":50167},[],"Consumer",{"_3170":1541,"_28017":1471,"_19412":50169,"_5":13306,"_25509":49988,"_2665":50170},[],"mTLS responds 200 with the identity and rejects a missing certificate.",{"_3170":1542,"_28017":1471,"_19412":50172,"_5":13306,"_25509":49988,"_2665":50173},[],"Continue with Renewal and recovery to request a successor pair within the window, install it and repeat the mTLS check. The consumer must use the new files in that test. After checking the successor, retire the previous certificate according to PKI policy; the example does not revoke it automatically.",{"_3170":1543,"_28017":1471,"_19412":50175,"_5":13306,"_25509":49988,"_2665":50176},[],"Devices and identities explains retirement and the limits of historical revocation. For a real destination, prepare consumer trust, validation and permissions; AWS IoT Core is an available integration.",{"_3170":1544,"_28017":1544,"_5":13637,"_2665":47810,"_28339":50178,"_19412":50179,"_25509":1544},[45393,46786,47794,49954],[],{"_3170":1545,"_28017":1544,"_19412":50181,"_5":13306,"_25509":1544,"_2665":50182},[],"Prepare a DMS, register a device and associate a verified certificate with its identity.",{"_3170":1546,"_28017":1544,"_5":28336,"_19412":50184,"_25509":50185,"_2665":45403},[],"/docs/platform/iot-fleets/quickstarts/register-device#before-you-begin",{"_3170":1547,"_28017":1544,"_5":28336,"_19412":50187,"_25509":50188,"_2665":50189},[],"/docs/platform/iot-fleets/quickstarts/register-device#prepare-the-dms","Prepare the DMS",{"_3170":1548,"_28017":1544,"_5":28336,"_19412":50191,"_25509":50192,"_2665":50193},[],"/docs/platform/iot-fleets/quickstarts/register-device#register-the-device","Register the device",{"_3170":1549,"_28017":1544,"_5":28336,"_19412":50195,"_25509":50196,"_2665":50197},[],"/docs/platform/iot-fleets/quickstarts/register-device#check-the-initial-status","Check the initial status",{"_3170":1550,"_28017":1544,"_5":28336,"_19412":50199,"_25509":50200,"_2665":50201},[],"/docs/platform/iot-fleets/quickstarts/register-device#assign-an-identity","Assign an identity",{"_3170":1551,"_28017":1544,"_5":28336,"_19412":50203,"_25509":50204,"_2665":50205},[],"/docs/platform/iot-fleets/quickstarts/register-device#verify-the-device","Verify the device",{"_3170":1552,"_28017":1544,"_5":28336,"_19412":50207,"_25509":50208,"_2665":50146},[],"/docs/platform/iot-fleets/quickstarts/register-device#expected-result",{"_3170":1553,"_28017":1544,"_5":28336,"_19412":50210,"_25509":50211,"_2665":50212},[],"/docs/platform/iot-fleets/quickstarts/register-device#if-the-result-fails","If the result fails",{"_3170":1554,"_28017":1544,"_5":28336,"_19412":50214,"_25509":50215,"_2665":50216},[],"/docs/platform/iot-fleets/quickstarts/register-device#automate-the-next-device","Automate the next device",{"_3170":1555,"_28017":1544,"_19412":50218,"_5":13306,"_25509":1544,"_2665":50219},[],"This path is intended for those starting to administer device identities. You will register `device-001` and assign an existing certificate to check the relationship between device, DMS and identity history.",{"_3170":1556,"_28017":1544,"_19412":50221,"_5":13306,"_25509":1544,"_2665":50222},[],"Assignment updates Lamassu's inventory. Install the key and certificate separately on the device; check the connection to a consumer in that destination's integration.",{"_3170":1557,"_28017":1544,"_19412":50224,"_5":13306,"_25509":50185,"_2665":50225},[],"An accessible instance and permission to administer DMSs, devices and certificate associations.",{"_3170":1558,"_28017":1544,"_19412":50227,"_5":13306,"_25509":50185,"_2665":50228},[],"An active CA with an available key. If one does not exist yet, follow Create your first CA.",{"_3170":1559,"_28017":1544,"_19412":50230,"_5":13306,"_25509":50185,"_2665":50231},[],"An active end-entity certificate from that CA whose `Common Name` is exactly `device-001`, together with its private key. Follow Issue and verify a certificate to obtain and check both.",{"_3170":1560,"_28017":1544,"_19412":50233,"_5":13306,"_25509":50185,"_2665":50234},[],"The identifier `device-001` available in the inventory. If you already used it, choose another and issue the certificate with that same `Common Name`.",{"_3170":1561,"_28017":1544,"_19412":50236,"_5":13306,"_25509":50188,"_2665":50237},[],"A DMS must exist before registering the device. If you already have a suitable one, check its CA and note its identifier; to create one:",{"_3170":1562,"_28017":1544,"_19412":50239,"_5":13306,"_25509":50188,"_2665":50240},[],"Open the DMS inventory and its creation action. Assign a recognizable name, such as `Acme Evaluation DMS`.",{"_3170":1563,"_28017":1544,"_19412":50242,"_5":13306,"_25509":50188,"_2665":50243},[],"In **Enrollment CA**, select the CA that issued `device.crt`.",{"_3170":1564,"_28017":1544,"_19412":50245,"_5":13306,"_25509":50188,"_2665":50246},[],"In **Registration Mode**, select `PRE_REGISTRATION` for the path that starts with explicit registration.",{"_3170":1565,"_28017":1544,"_19412":50248,"_5":13306,"_25509":50188,"_2665":50249},[],"In the authentication section, enable **Require client certificate** and leave **Call external webhook** off. Under **Require client certificate**, add the CA whose initial certificates you will accept to **Validation CAs**; for this evaluation, it can be the same CA. Keep **Verify CSR Signature** enabled and leave **Enable server-side key generation** off if you will not use it.",{"_3170":1566,"_28017":1544,"_19412":50251,"_5":13306,"_25509":50188,"_2665":50252},[],"Review renewal and trust distribution settings with the DMS guide, save the service and note its identifier.",{"_3170":1567,"_28017":1544,"_19412":50254,"_5":13306,"_25509":50188,"_2665":50255},[],"Reopen the DMS and confirm that the enrollment CA is the expected one and the service appears in inventory.",{"_3170":1568,"_28017":1544,"_19412":50257,"_5":13306,"_25509":50188,"_2665":50258},[],"These settings prepare DMS policy. The next steps register and assign through the console; they do not send an EST request or test admission through that protocol.",{"_3170":1569,"_28017":1544,"_19412":50260,"_5":13306,"_25509":50192,"_2665":50261},[],"Open **Managed Devices** and the registration action. Complete:",{"_3170":1570,"_28017":1544,"_19412":50263,"_5":13306,"_25509":50192,"_2665":50264},[],"**Device ID**: `device-001`.",{"_3170":1571,"_28017":1544,"_19412":50266,"_5":13306,"_25509":50192,"_2665":50267},[],"**Registration Authority**: the DMS you just prepared; this label identifies the service fulfilling the registration authority role.",{"_3170":1572,"_28017":1544,"_19412":50269,"_5":13306,"_25509":50192,"_2665":50270},[],"**Icon** and **Tags**: optional classification.",{"_3170":1573,"_28017":1544,"_19412":50272,"_5":13306,"_25509":50192,"_2665":50273},[],"Confirm registration.",{"_3170":1574,"_28017":1544,"_19412":50275,"_5":13306,"_25509":50196,"_2665":50276},[],"Open the device. It should appear in **No Identity** and show the selected owning DMS.",{"_3170":1575,"_28017":1544,"_19412":50278,"_5":13306,"_25509":50196,"_2665":50279},[],"Registration creates the inventory entry; the certificate must still be associated.",{"_3170":1576,"_28017":1544,"_19412":50281,"_5":13306,"_25509":50200,"_2665":50282},[],"Select **Assign Identity** and the existing certificate with `CN=device-001`. Check its serial number, issuer and validity against the certificate you verified in PKI.",{"_3170":1577,"_28017":1544,"_19412":50284,"_5":13306,"_25509":50200,"_2665":50285},[],"Confirm the association. The **Issue New Instead** alternative is explained in Devices and identities.",{"_3170":1578,"_28017":1544,"_19412":50287,"_5":13306,"_25509":50204,"_2665":50288},[],"Check that it has an active identity. In **Certificate History**, verify the associated serial number; in **Device Event Timeline**, find the assignment event.",{"_3170":1579,"_28017":1544,"_19412":50290,"_5":13306,"_25509":50204,"_2665":50291},[],"Keep the device identifier, owning DMS and serial number as references for the result.",{"_3170":1580,"_28017":1544,"_19412":50293,"_5":13306,"_25509":50208,"_2665":50143},[],{"_3170":1581,"_28017":1544,"_19412":50295,"_5":13306,"_25509":50208,"_2665":50296},[],"Result",{"_3170":1582,"_28017":1544,"_19412":50298,"_5":13306,"_25509":50208,"_2665":50299},[],"Device",{"_3170":1583,"_28017":1544,"_19412":50301,"_5":13306,"_25509":50208,"_2665":50302},[],"`device-001` appears in inventory with the expected DMS.",{"_3170":1584,"_28017":1544,"_19412":50304,"_5":13306,"_25509":50208,"_2665":50305},[],"Current identity",{"_3170":1585,"_28017":1544,"_19412":50307,"_5":13306,"_25509":50208,"_2665":50308},[],"The associated certificate matches the one you verified in PKI.",{"_3170":1586,"_28017":1544,"_19412":50310,"_5":13306,"_25509":50208,"_2665":50311},[],"History",{"_3170":1587,"_28017":1544,"_19412":50313,"_5":13306,"_25509":50208,"_2665":50314},[],"The associated issuance appears with its serial number and dates.",{"_3170":1588,"_28017":1544,"_19412":50316,"_5":13306,"_25509":50208,"_2665":50317},[],"Key and certificate",{"_3170":1589,"_28017":1544,"_19412":50319,"_5":13306,"_25509":50208,"_2665":50320},[],"You have the verified pair ready to install on the device.",{"_3170":1590,"_28017":1544,"_19412":50322,"_5":13306,"_25509":50211,"_2665":50323},[],"If you cannot select the DMS, confirm its creation and your read permissions.",{"_3170":1591,"_28017":1544,"_19412":50325,"_5":13306,"_25509":50211,"_2665":50326},[],"If no eligible certificate appears, check that its `Common Name` matches the `Device ID` exactly, it is active and it was issued by the expected CA.",{"_3170":1592,"_28017":1544,"_19412":50328,"_5":13306,"_25509":50211,"_2665":50329},[],"If assignment fails, review permissions and operation diagnostics before repeating it. Query the device and its history again to find the persisted result.",{"_3170":1593,"_28017":1544,"_19412":50331,"_5":13306,"_25509":50211,"_2665":50332},[],"If an expiration or renewal state appears, check certificate dates and DMS thresholds in Devices and identities.",{"_3170":1594,"_28017":1544,"_19412":50334,"_5":13306,"_25509":50215,"_2665":50335},[],"Continue with DMS and EST for the device to request and renew certificates. Prepare server trust, the initial credential and policies for each operation before implementing the client.",{"_3170":1595,"_28017":1544,"_19412":50337,"_5":13306,"_25509":50215,"_2665":50338},[],"For a path from the client through mTLS, follow Enroll and connect your first device with a new ID.",{"_3170":1596,"_28017":1544,"_19412":50340,"_5":13306,"_25509":50215,"_2665":50341},[],"To use the identity in AWS IoT Core, also prepare trust and permissions in the destination. Check the connection from the device after installing the required key, certificate and chain.",{"_3170":1597,"_28017":1597,"_5":13637,"_2665":50343,"_28339":50344,"_19412":50345,"_25509":1597},"Lamassu IoT Platform",[45393,46786],[],{"_3170":1598,"_28017":1597,"_19412":50347,"_5":13306,"_25509":1597,"_2665":50348},[],"Build a PKI and apply its certificates to your devices' lifecycle.",{"_3170":1599,"_28017":1597,"_5":28336,"_19412":50350,"_25509":50351,"_2665":49829},[],"/docs/platform/overview#start-here",{"_3170":1600,"_28017":1597,"_5":28336,"_19412":50353,"_25509":50354,"_2665":50355},[],"/docs/platform/overview#choose-your-path","Choose your path",{"_3170":1601,"_28017":1597,"_5":28336,"_19412":50357,"_25509":50358,"_2665":50359},[],"/docs/platform/overview#architecture-at-a-glance","Architecture at a glance",{"_3170":1602,"_28017":1597,"_5":28336,"_19412":50361,"_25509":50362,"_2665":50363},[],"/docs/platform/overview#core-capabilities","Core capabilities",{"_3170":1603,"_28017":1597,"_5":28336,"_19412":50365,"_25509":50366,"_2665":50367},[],"/docs/platform/overview#build-your-trust-hierarchy","Build your trust hierarchy",{"_3170":1604,"_28017":1597,"_5":28336,"_19412":50369,"_25509":50370,"_2665":50371},[],"/docs/platform/overview#protect-cryptographic-keys","Protect cryptographic keys",{"_3170":1605,"_28017":1597,"_5":28336,"_19412":50373,"_25509":50374,"_2665":50375},[],"/docs/platform/overview#issue-and-control-certificates","Issue and control certificates",{"_3170":1606,"_28017":1597,"_5":28336,"_19412":50377,"_25509":50378,"_2665":50379},[],"/docs/platform/overview#automate-device-identities","Automate device identities",{"_3170":1607,"_28017":1597,"_5":28336,"_19412":50381,"_25509":50382,"_2665":50383},[],"/docs/platform/overview#publish-validation-status","Publish validation status",{"_3170":1608,"_28017":1597,"_5":28336,"_19412":50385,"_25509":50386,"_2665":50387},[],"/docs/platform/overview#react-to-events","React to events",{"_3170":1609,"_28017":1597,"_5":28336,"_19412":50389,"_25509":50390,"_2665":50391},[],"/docs/platform/overview#operational-reference","Operational reference",{"_3170":1610,"_28017":1597,"_19412":50393,"_5":13306,"_25509":1597,"_2665":50394},[],"Lamassu IoT lets you administer a private PKI and use it to issue, renew and revoke X.509 device identities. The Platform documentation follows two paths: **PKI**, for authorities and certificates, and **IoT Fleets**, for applying those identities to a device population.",{"_3170":1611,"_28017":1597,"_19412":50396,"_5":13306,"_25509":50351,"_2665":50397},[],"Choose the result you need:",{"_3170":1612,"_28017":1597,"_19412":50399,"_5":13306,"_25509":50351,"_2665":50400},[],"<Card title=\"Issue and verify a certificate\" description=\"Prepare a CA, issue an X.509 identity and check its chain and key.\" href=\"/docs/platform/pki/quickstarts/overview\" />",{"_3170":1613,"_28017":1597,"_19412":50402,"_5":13306,"_25509":50351,"_2665":50403},[],"<Card title=\"Enroll and connect a device\" description=\"Prepare the DMS, request an identity through EST and check an mTLS connection.\" href=\"/docs/platform/iot-fleets/quickstarts/enroll-device\" />",{"_3170":1614,"_28017":1597,"_19412":50405,"_5":13306,"_25509":50351,"_2665":50406},[],"If you are still preparing the instance, start in Deployment. The Platform paths assume an accessible console and permission to perform the operations.",{"_3170":1615,"_28017":1597,"_19412":50408,"_5":13306,"_25509":50354,"_2665":50409},[],"Section",{"_3170":1616,"_28017":1597,"_19412":50411,"_5":13306,"_25509":50354,"_2665":50412},[],"What you manage",{"_3170":1617,"_28017":1597,"_19412":50414,"_5":13306,"_25509":50354,"_2665":50415},[],"Entry point",{"_3170":1618,"_28017":1597,"_19412":50417,"_5":13306,"_25509":50354,"_2665":50418},[],"**PKI**",{"_3170":1619,"_28017":1597,"_19412":50420,"_5":13306,"_25509":50354,"_2665":50421},[],"Keys, authorities, profiles, certificates and publication of revocation status.",{"_3170":1620,"_28017":1597,"_19412":50423,"_5":13306,"_25509":50354,"_2665":50424},[],"PKI overview",{"_3170":1621,"_28017":1597,"_19412":50426,"_5":13306,"_25509":50354,"_2665":50427},[],"**IoT Fleets**",{"_3170":1622,"_28017":1597,"_19412":50429,"_5":13306,"_25509":50354,"_2665":50430},[],"Devices, identity history, DMS policies, EST enrollment and integrations.",{"_3170":1623,"_28017":1597,"_19412":50432,"_5":13306,"_25509":50354,"_2665":50433},[],"IoT Fleets overview",{"_3170":1624,"_28017":1597,"_19412":50435,"_5":13306,"_25509":50354,"_2665":50436},[],"**Administration**",{"_3170":1625,"_28017":1597,"_19412":50438,"_5":13306,"_25509":50354,"_2665":50439},[],"Operator permissions, audit and event subscriptions.",{"_3170":1626,"_28017":1597,"_19412":50441,"_5":13306,"_25509":50354,"_2665":46784},[],{"_3170":1627,"_28017":1597,"_19412":50443,"_5":13306,"_25509":50354,"_2665":50444},[],"A CA determines who signs, and a profile defines what can be issued. The DMS applies admission and enrollment policy. The device retains its association with certificates, and the external consumer decides which identity it accepts.",{"_3170":1628,"_28017":1597,"_19412":50446,"_5":13306,"_25509":50358,"_2665":50447},[],"An identity's journey connects four responsibilities:",{"_3170":1629,"_28017":1597,"_19412":50449,"_5":13306,"_25509":50358,"_2665":50450},[],"The PKI administrator prepares the authority, its key and issuance rules.",{"_3170":1630,"_28017":1597,"_19412":50452,"_5":13306,"_25509":50358,"_2665":50453},[],"The provisioning administrator configures the DMS and initial trust.",{"_3170":1631,"_28017":1597,"_19412":50455,"_5":13306,"_25509":50358,"_2665":50456},[],"The device client requests a certificate and installs it with the matching key.",{"_3170":1632,"_28017":1597,"_19412":50458,"_5":13306,"_25509":50358,"_2665":50459},[],"The consumer validates the identity and applies its access permissions.",{"_3170":1633,"_28017":1597,"_19412":50461,"_5":13306,"_25509":50358,"_2665":50462},[],"See How Lamassu works to understand the resources and platform architecture for the services. Installation, network exposure and dependencies are explained in Deployment.",{"_3170":1634,"_28017":1597,"_19412":50464,"_5":13306,"_25509":50366,"_2665":50465},[],"Create or incorporate authorities and organize their relationships in PKI. The hierarchy and its rotation determine which chains consumers must recognize.",{"_3170":1635,"_28017":1597,"_19412":50467,"_5":13306,"_25509":50370,"_2665":50468},[],"Choose the engine that keeps authority keys and control who can use them. See Keys and engines; provider setup belongs to deployment.",{"_3170":1636,"_28017":1597,"_19412":50470,"_5":13306,"_25509":50374,"_2665":50471},[],"Define issuance profiles, sign requests and review the certificate inventory. Check the issued certificate from the client that will use it.",{"_3170":1637,"_28017":1597,"_19412":50473,"_5":13306,"_25509":50378,"_2665":50474},[],"Configure a DMS and use EST to request and renew certificates. Preparing the initial credential and installing the result belong to device integration.",{"_3170":1638,"_28017":1597,"_19412":50476,"_5":13306,"_25509":50382,"_2665":50477},[],"Use OCSP and CRL to publish revocation status. Each consumer must configure how it retrieves and applies that information.",{"_3170":1639,"_28017":1597,"_19412":50479,"_5":13306,"_25509":50386,"_2665":50480},[],"Use audit logs to investigate changes and configure alerts and subscriptions to react to lifecycle events.",{"_3170":1640,"_28017":1597,"_19412":50482,"_5":13306,"_25509":50390,"_2665":49923},[],{"_3170":1641,"_28017":1597,"_19412":50484,"_5":13306,"_25509":50390,"_2665":50485},[],"What it prepares or checks",{"_3170":1642,"_28017":1597,"_19412":50487,"_5":13306,"_25509":50390,"_2665":49926},[],{"_3170":1643,"_28017":1597,"_19412":50489,"_5":13306,"_25509":50390,"_2665":50490},[],"Key custody, CA hierarchy, profiles and validation.",{"_3170":1644,"_28017":1597,"_19412":50492,"_5":13306,"_25509":50390,"_2665":50493},[],"Fleet administrator",{"_3170":1645,"_28017":1597,"_19412":50495,"_5":13306,"_25509":50390,"_2665":50496},[],"DMS, device admission, renewal policy and inventory.",{"_3170":1646,"_28017":1597,"_19412":50498,"_5":13306,"_25509":50390,"_2665":49938},[],{"_3170":1647,"_28017":1597,"_19412":50500,"_5":13306,"_25509":50390,"_2665":50501},[],"Initial credential, server trust, EST client, and key and certificate storage.",{"_3170":1648,"_28017":1597,"_19412":50503,"_5":13306,"_25509":50390,"_2665":49944},[],{"_3170":1649,"_28017":1597,"_19412":50505,"_5":13306,"_25509":50390,"_2665":50506},[],"Issuer trust, certificate validation and permissions in the destination.",{"_3170":1650,"_28017":1597,"_19412":50508,"_5":13306,"_25509":50390,"_2665":50509},[],"Infrastructure operator",{"_3170":1651,"_28017":1597,"_19412":50511,"_5":13306,"_25509":50390,"_2665":50512},[],"Installation, network, availability, dependencies and deployment diagnosis.",{"_3170":1652,"_28017":1597,"_19412":50514,"_5":13306,"_25509":50390,"_2665":50515},[],"The API reference contains contracts for automating operations. To investigate a failure, start in the affected section: PKI, EST or Deployment.",{"_3170":1653,"_28017":1653,"_5":13637,"_2665":50517,"_28339":50518,"_19412":50521,"_25509":1653},"CA hierarchy and rotation",[45393,46786,50519,50520],"PKI","Keys, authorities and certificates",[],{"_3170":1654,"_28017":1653,"_19412":50523,"_5":13306,"_25509":1653,"_2665":50524},[],"Design root and intermediate authorities and replace certificates or keys without breaking trust.",{"_3170":1655,"_28017":1653,"_5":28336,"_19412":50526,"_25509":50527,"_2665":50528},[],"/docs/platform/pki/ca-hierarchy-and-rotation#design-the-hierarchy","Design the hierarchy",{"_3170":1656,"_28017":1653,"_5":28336,"_19412":50530,"_25509":50531,"_2665":50532},[],"/docs/platform/pki/ca-hierarchy-and-rotation#reissuance-and-rotation-are-not-the-same","Reissuance and rotation are not the same",{"_3170":1657,"_28017":1653,"_5":28336,"_19412":50534,"_25509":50535,"_2665":50536},[],"/docs/platform/pki/ca-hierarchy-and-rotation#when-to-choose-each-operation","When to choose each operation",{"_3170":1658,"_28017":1653,"_5":28336,"_19412":50538,"_25509":50539,"_2665":50540},[],"/docs/platform/pki/ca-hierarchy-and-rotation#key-rotation-procedure","Key rotation procedure",{"_3170":1659,"_28017":1653,"_5":28336,"_19412":50542,"_25509":50543,"_2665":50544},[],"/docs/platform/pki/ca-hierarchy-and-rotation#inventory-the-dependencies","Inventory the dependencies",{"_3170":1660,"_28017":1653,"_5":28336,"_19412":50546,"_25509":50547,"_2665":50548},[],"/docs/platform/pki/ca-hierarchy-and-rotation#create-the-successor-ca","Create the successor CA",{"_3170":1661,"_28017":1653,"_5":28336,"_19412":50550,"_25509":50551,"_2665":50552},[],"/docs/platform/pki/ca-hierarchy-and-rotation#distribute-the-new-trust","Distribute the new trust",{"_3170":1662,"_28017":1653,"_5":28336,"_19412":50554,"_25509":50555,"_2665":50556},[],"/docs/platform/pki/ca-hierarchy-and-rotation#switch-issuance","Switch issuance",{"_3170":1663,"_28017":1653,"_5":28336,"_19412":50558,"_25509":50559,"_2665":50560},[],"/docs/platform/pki/ca-hierarchy-and-rotation#renew-in-batches","Renew in batches",{"_3170":1664,"_28017":1653,"_5":28336,"_19412":50562,"_25509":50563,"_2665":50564},[],"/docs/platform/pki/ca-hierarchy-and-rotation#close-the-overlap","Close the overlap",{"_3170":1665,"_28017":1653,"_5":28336,"_19412":50566,"_25509":50567,"_2665":50568},[],"/docs/platform/pki/ca-hierarchy-and-rotation#cascading-revocation","Cascading revocation",{"_3170":1666,"_28017":1653,"_5":28336,"_19412":50570,"_25509":50571,"_2665":50572},[],"/docs/platform/pki/ca-hierarchy-and-rotation#checks-after-the-change","Checks after the change",{"_3170":1667,"_28017":1653,"_19412":50574,"_5":13306,"_25509":1653,"_2665":50575},[],"The hierarchy determines the blast radius of any error or compromise. A root signs intermediate CAs; intermediates issue the identities used by devices and services. This separation lets you isolate environments and rotate a branch without replacing all trust.",{"_3170":1668,"_28017":1653,"_19412":50577,"_5":13306,"_25509":1653,"_2665":50578},[],"This procedure is for the PKI operator replacing an authority in use. You need access to CAs, keys and profiles, a dependency inventory and coordination with trust-store and device owners. Before switching issuance, prepare a test cohort and decide the criterion for ending overlap.",{"_3170":1669,"_28017":1653,"_19412":50580,"_5":13306,"_25509":50527,"_2665":50581},[],"For a production installation, use a very restricted root and one or more operational intermediates. Separate intermediates when any of these boundaries change:",{"_3170":1670,"_28017":1653,"_19412":50583,"_5":13306,"_25509":50527,"_2665":50584},[],"environment, such as production and preproduction;",{"_3170":1671,"_28017":1653,"_19412":50586,"_5":13306,"_25509":50527,"_2665":50587},[],"owner or operating team;",{"_3170":1672,"_28017":1653,"_19412":50589,"_5":13306,"_25509":50527,"_2665":50590},[],"device family or manufacturing process;",{"_3170":1673,"_28017":1653,"_19412":50592,"_5":13306,"_25509":50527,"_2665":50593},[],"region or regulatory requirement;",{"_3170":1674,"_28017":1653,"_19412":50595,"_5":13306,"_25509":50527,"_2665":50596},[],"cryptographic engine or key policy;",{"_3170":1675,"_28017":1653,"_19412":50598,"_5":13306,"_25509":50527,"_2665":50599},[],"maintenance window and renewal cadence.",{"_3170":1676,"_28017":1653,"_19412":50601,"_5":13306,"_25509":50527,"_2665":50602},[],"Avoid deep hierarchies without a concrete need. Each level adds chain distribution, validation and one more certificate you must renew.",{"_3170":1677,"_28017":1653,"_19412":50604,"_5":13306,"_25509":50527,"_2665":50605},[],"A child CA and its end-entity certificates must expire before their issuer. Reserve a margin that allows distributing another chain and renewing dependent certificates.",{"_3170":1678,"_28017":1653,"_19412":50607,"_5":13306,"_25509":50531,"_2665":50608},[],"**Reissuing a CA** creates a new certificate over the existing key. Lamassu generates a CSR with that key, self-signs it if it is a root or asks the parent CA to sign it if it is subordinate. The new certificate becomes active and the CA points to its serial number; the old and new certificates are linked through metadata.",{"_3170":1679,"_28017":1653,"_19412":50610,"_5":13306,"_25509":50531,"_2665":50611},[],"**Rotating a CA** creates a successor key and authority. It is the right choice in the face of compromise, a cryptographic change, an engine migration or non-exportable key policies.",{"_3170":1680,"_28017":1653,"_19412":50613,"_5":13306,"_25509":50531,"_2665":50614},[],"Lamassu does not allow reissuing an already-revoked CA or a CA whose expiration date has passed. Plan ahead for both conditions.",{"_3170":1681,"_28017":1653,"_19412":50616,"_5":13306,"_25509":50535,"_2665":50617},[],"Reissue if the key is still trustworthy and you only need another validity period or an updated certificate.",{"_3170":1682,"_28017":1653,"_19412":50619,"_5":13306,"_25509":50535,"_2665":50620},[],"Rotate the key if compromise is suspected, the algorithm changes or you want to move custody to another engine.",{"_3170":1683,"_28017":1653,"_19412":50622,"_5":13306,"_25509":50535,"_2665":50623},[],"Create a parallel branch if you cannot update all consumers at the same time.",{"_3170":1684,"_28017":1653,"_19412":50625,"_5":13306,"_25509":50535,"_2665":50626},[],"Revoke immediately only when the risk of keeping the CA outweighs the impact of interrupting the fleet.",{"_3170":1685,"_28017":1653,"_19412":50628,"_5":13306,"_25509":50543,"_2665":50629},[],"Locate child CAs, issued certificates, DMSs, connectors and external trust stores. Include devices that may stay offline for weeks or months.",{"_3170":1686,"_28017":1653,"_19412":50631,"_5":13306,"_25509":50547,"_2665":50632},[],"Generate a new key in the planned engine, create the CA and assign it an explicit profile. Do not reuse the operational identifier to hide that it is a different generation.",{"_3170":1687,"_28017":1653,"_19412":50634,"_5":13306,"_25509":50551,"_2665":50635},[],"Add the new root or chain to consumers before issuing with it. If distributing through EST `/cacerts`, explicitly include the required managed CAs and inspect the content; including the issuer does not automatically include every intermediate. Install the new trust in a cohort and verify that it still accepts the previous identity.",{"_3170":1688,"_28017":1653,"_19412":50637,"_5":13306,"_25509":50555,"_2665":50638},[],"Update the enrollment CA and profile of the DMSs. While old-CA cohorts still renew, add the previous enrollment CA to each DMS's re-enrollment validation CAs (`reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`): the new enrollment CA is trusted automatically, but the old one was the enrollment CA and appears in no re-enrollment trust list, so without that entry its certificates can no longer renew. The DMS guide documents the setting.",{"_3170":1689,"_28017":1653,"_19412":50640,"_5":13306,"_25509":50559,"_2665":50641},[],"Migrate a small cohort, validate mTLS, OCSP and CRL from the consumer and expand progressively. Monitor which devices still present the old chain.",{"_3170":1690,"_28017":1653,"_19412":50643,"_5":13306,"_25509":50563,"_2665":50644},[],"Once no legitimate consumer depends on the previous authority, remove it from issuance, from the re-enrollment validation CAs and from the distributed CAs. Revoke it if policy requires it.",{"_3170":1691,"_28017":1653,"_19412":50646,"_5":13306,"_25509":50567,"_2665":50647},[],"Lamassu saves the CA’s revocation, then attempts to revoke child CAs and issued certificates with `CessationOfOperation`. Propagation continues recursively through child CAs. This is not a transaction over the whole hierarchy: some resources may have changed while other updates failed.",{"_3170":1692,"_28017":1653,"_19412":50649,"_5":13306,"_25509":50567,"_2665":50650},[],"Resources in `EXPIRED` state and resources already revoked for a final reason reject further status transitions. Per-descendant failures are logged; review the inventory and logs even when the parent operation completes.",{"_3170":1693,"_28017":1653,"_19412":50652,"_5":13306,"_25509":50567,"_2665":50653},[],"`CertificateHold` allows reactivating the parent while it is not expired, but does not restore child CAs or certificates permanently revoked during the cascade. Holding a CA therefore does not provide a reversible pause for its entire branch.",{"_3170":1694,"_28017":1653,"_19412":50655,"_5":13306,"_25509":50567,"_2665":50656},[],"Before closing the change, compare the original dependency inventory with final states and verify revocation publication for each issuer. Do not use revocation as the ordinary mechanism to stop issuance: complete migration and remove the CA from operational flows.",{"_3170":1695,"_28017":1653,"_19412":50658,"_5":13306,"_25509":50571,"_2665":50659},[],"The new chain ends in an anchor installed by the consumer.",{"_3170":1696,"_28017":1653,"_19412":50661,"_5":13306,"_25509":50571,"_2665":50662},[],"New certificates contain the expected AKI, SKI, KU, EKU and SAN.",{"_3170":1697,"_28017":1653,"_19412":50664,"_5":13306,"_25509":50571,"_2665":50665},[],"The DMS delivers the correct chain through EST `/cacerts`.",{"_3170":1698,"_28017":1653,"_19412":50667,"_5":13306,"_25509":50571,"_2665":50668},[],"Re-enrollment accepts the old identity during the planned period.",{"_3170":1699,"_28017":1653,"_19412":50670,"_5":13306,"_25509":50571,"_2665":50671},[],"OCSP and CRL respond for the authorities that remain active.",{"_3170":1700,"_28017":1653,"_19412":50673,"_5":13306,"_25509":50571,"_2665":50674},[],"No DMS is left accidentally issuing from the old CA.",{"_3170":1701,"_28017":1653,"_19412":50676,"_5":13306,"_25509":50571,"_2665":50677},[],"See the Trust model to understand the DMS's CA sets and Certificate lifecycle for states and revocation effects.",{"_3170":1702,"_28017":1702,"_5":13637,"_2665":50679,"_28339":50680,"_19412":50681,"_25509":1702},"Certification authorities",[45393,46786,50519,50520],[],{"_3170":1703,"_28017":1702,"_19412":50683,"_5":13306,"_25509":1702,"_2665":50684},[],"Create, import and operate the authorities that establish your PKI's trust.",{"_3170":1704,"_28017":1702,"_5":28336,"_19412":50686,"_25509":50687,"_2665":50688},[],"/docs/platform/pki/certificate-authorities#choose-a-flow","Choose a flow",{"_3170":1705,"_28017":1702,"_5":28336,"_19412":50690,"_25509":50691,"_2665":50692},[],"/docs/platform/pki/certificate-authorities#create-a-new-authority","Create a new authority",{"_3170":1706,"_28017":1702,"_5":28336,"_19412":50694,"_25509":50695,"_2665":45403},[],"/docs/platform/pki/certificate-authorities#before-you-begin",{"_3170":1707,"_28017":1702,"_5":28336,"_19412":50697,"_25509":50698,"_2665":50699},[],"/docs/platform/pki/certificate-authorities#open-the-wizard","Open the wizard",{"_3170":1708,"_28017":1702,"_5":28336,"_19412":50701,"_25509":50702,"_2665":50703},[],"/docs/platform/pki/certificate-authorities#configure-the-key","Configure the key",{"_3170":1709,"_28017":1702,"_5":28336,"_19412":50705,"_25509":50706,"_2665":50707},[],"/docs/platform/pki/certificate-authorities#choose-the-ca-type","Choose the CA type",{"_3170":1710,"_28017":1702,"_5":28336,"_19412":50709,"_25509":50710,"_2665":50711},[],"/docs/platform/pki/certificate-authorities#define-the-identity","Define the identity",{"_3170":1711,"_28017":1702,"_5":28336,"_19412":50713,"_25509":50714,"_2665":50715},[],"/docs/platform/pki/certificate-authorities#configure-validity-and-uses","Configure validity and uses",{"_3170":1712,"_28017":1702,"_5":28336,"_19412":50717,"_25509":50718,"_2665":50719},[],"/docs/platform/pki/certificate-authorities#create-and-verify","Create and verify",{"_3170":1713,"_28017":1702,"_5":28336,"_19412":50721,"_25509":50722,"_2665":50723},[],"/docs/platform/pki/certificate-authorities#use-a-key-from-the-kms","Use a key from the KMS",{"_3170":1714,"_28017":1702,"_5":28336,"_19412":50725,"_25509":50726,"_2665":50727},[],"/docs/platform/pki/certificate-authorities#import-an-external-ca","Import an external CA",{"_3170":1715,"_28017":1702,"_5":28336,"_19412":50729,"_25509":50730,"_2665":50731},[],"/docs/platform/pki/certificate-authorities#select-the-engine","Select the engine",{"_3170":1716,"_28017":1702,"_5":28336,"_19412":50733,"_25509":50734,"_2665":50735},[],"/docs/platform/pki/certificate-authorities#load-the-material","Load the material",{"_3170":1717,"_28017":1702,"_5":28336,"_19412":50737,"_25509":50738,"_2665":50739},[],"/docs/platform/pki/certificate-authorities#define-the-default-issuance","Define the default issuance",{"_3170":1718,"_28017":1702,"_5":28336,"_19412":50741,"_25509":50742,"_2665":50743},[],"/docs/platform/pki/certificate-authorities#verify-the-import","Verify the import",{"_3170":1719,"_28017":1702,"_5":28336,"_19412":50745,"_25509":50746,"_2665":50747},[],"/docs/platform/pki/certificate-authorities#inspect-an-authority","Inspect an authority",{"_3170":1720,"_28017":1702,"_5":28336,"_19412":50749,"_25509":50750,"_2665":50751},[],"/docs/platform/pki/certificate-authorities#issue-certificates","Issue certificates",{"_3170":1721,"_28017":1702,"_5":28336,"_19412":50753,"_25509":50754,"_2665":50755},[],"/docs/platform/pki/certificate-authorities#revoke-a-ca","Revoke a CA",{"_3170":1722,"_28017":1702,"_5":28336,"_19412":50757,"_25509":50758,"_2665":50759},[],"/docs/platform/pki/certificate-authorities#assess-the-impact","Assess the impact",{"_3170":1723,"_28017":1702,"_5":28336,"_19412":50761,"_25509":50762,"_2665":50763},[],"/docs/platform/pki/certificate-authorities#start-the-revocation","Start the revocation",{"_3170":1724,"_28017":1702,"_5":28336,"_19412":50765,"_25509":50766,"_2665":50767},[],"/docs/platform/pki/certificate-authorities#confirm-the-identity","Confirm the identity",{"_3170":1725,"_28017":1702,"_5":28336,"_19412":50769,"_25509":50770,"_2665":50771},[],"/docs/platform/pki/certificate-authorities#check-the-publication","Check the publication",{"_3170":1726,"_28017":1702,"_19412":50773,"_5":13306,"_25509":1702,"_2665":50774},[],"A certification authority (CA) binds identities to public keys through signed certificates. In Lamassu you can create a new hierarchy, use a key already in the KMS or incorporate an external CA.",{"_3170":1727,"_28017":1702,"_19412":50776,"_5":13306,"_25509":1702,"_2665":50777},[],"To design a full chain or replace an authority in production, see CA hierarchy and rotation. If you need to standardize what each authority can sign, use Certificate profiles.",{"_3170":1728,"_28017":1702,"_19412":50779,"_5":13306,"_25509":1702,"_2665":50780},[],"To administer CAs, you need authority and key permissions, a reachable engine and a reviewed profile. An external consumer does not trust a CA merely because it appears in this inventory: agree root and chain distribution separately.",{"_3170":1729,"_28017":1702,"_19412":50782,"_5":13306,"_25509":50687,"_2665":50783},[],"**New CA with a new key:** create a root of trust from scratch. Lamassu generates and keeps the key pair.",{"_3170":1730,"_28017":1702,"_19412":50785,"_5":13306,"_25509":50687,"_2665":50786},[],"**New CA from the KMS:** reuse a key already registered in the platform.",{"_3170":1731,"_28017":1702,"_19412":50788,"_5":13306,"_25509":50687,"_2665":50789},[],"**Import a CA with its private key:** incorporate an external authority that Lamassu can issue with.",{"_3170":1732,"_28017":1702,"_19412":50791,"_5":13306,"_25509":50687,"_2665":50792},[],"**Import only the certificate:** register public material. If Lamassu finds its key in the KMS, it can associate it; otherwise, the CA has no usable key for issuance.",{"_3170":1733,"_28017":1702,"_19412":50794,"_5":13306,"_25509":50687,"_2665":50795},[],"First time here? Follow Create your first CA to complete the minimal journey.",{"_3170":1734,"_28017":1702,"_19412":50797,"_5":13306,"_25509":50695,"_2665":50798},[],"Decide whether the CA will be a root or an intermediate.",{"_3170":1735,"_28017":1702,"_19412":50800,"_5":13306,"_25509":50695,"_2665":50801},[],"Choose the engine that will keep the key.",{"_3170":1736,"_28017":1702,"_19412":50803,"_5":13306,"_25509":50695,"_2665":50804},[],"Define a validity longer than that of the certificates it will issue.",{"_3170":1737,"_28017":1702,"_19412":50806,"_5":13306,"_25509":50695,"_2665":50807},[],"For an intermediate CA, make sure the parent CA is active.",{"_3170":1738,"_28017":1702,"_19412":50809,"_5":13306,"_25509":50698,"_2665":50810},[],"In **Certification Authorities**, select **Create New CA** and choose to generate a new key pair.",{"_3170":1739,"_28017":1702,"_19412":50812,"_5":13306,"_25509":50702,"_2665":50813},[],"Select the cryptographic engine, the algorithm and the size or curve. Lamassu supports RSA and EC keys according to the engine's capabilities.",{"_3170":1740,"_28017":1702,"_19412":50815,"_5":13306,"_25509":50702,"_2665":50816},[],"Use only sizes and curves supported by the engine and the profile’s cryptographic policy. Read Keys and engines before reusing external material.",{"_3170":1741,"_28017":1702,"_19412":50818,"_5":13306,"_25509":50706,"_2665":50819},[],"Select **Root CA** for a self-signed authority or **Intermediate CA** for an authority signed by another CA. In the latter case, choose the issuing CA.",{"_3170":1742,"_28017":1702,"_19412":50821,"_5":13306,"_25509":50710,"_2665":50822},[],"Enter a unique **CA Name**. This name becomes the certificate's `Common Name`. Complete the Distinguished Name fields your policy requires:",{"_3170":1743,"_28017":1702,"_19412":50824,"_5":13306,"_25509":50710,"_2665":50825},[],"`C`: two-letter ISO 3166-1 country code.",{"_3170":1744,"_28017":1702,"_19412":50827,"_5":13306,"_25509":50710,"_2665":50828},[],"`ST`: state or province.",{"_3170":1745,"_28017":1702,"_19412":50830,"_5":13306,"_25509":50710,"_2665":50831},[],"`L`: locality.",{"_3170":1746,"_28017":1702,"_19412":50833,"_5":13306,"_25509":50710,"_2665":50834},[],"`O`: organization.",{"_3170":1747,"_28017":1702,"_19412":50836,"_5":13306,"_25509":50710,"_2665":50837},[],"`OU`: organizational unit.",{"_3170":1748,"_28017":1702,"_19412":50839,"_5":13306,"_25509":50710,"_2665":50840},[],"The CA's internal identifier is generated automatically and cannot be changed.",{"_3170":1749,"_28017":1702,"_19412":50842,"_5":13306,"_25509":50714,"_2665":50843},[],"Define **CA Certificate Expiration** and **Default End-Entity Certificate Issuance Expiration**. You can express a duration (`5y 8w 4d`), pick a date or use the maximum allowed date.",{"_3170":1750,"_28017":1702,"_19412":50845,"_5":13306,"_25509":50714,"_2665":50846},[],"Review the CA’s own certificate separately from the default profile for certificates it will issue later. Choose an explicit issuance policy; do not assume the form’s initial values suit your consumers.",{"_3170":1751,"_28017":1702,"_19412":50848,"_5":13306,"_25509":50718,"_2665":50849},[],"Confirm the form and open the CA. Check status, issuer, dates, associated engine and key. Download the certificate: it should contain `CA:TRUE` and a usage permitting certificate signing. Verify the self-signature for a root or the chain to your root for an intermediate. Complete a test issuance to check that the key can actually sign.",{"_3170":1752,"_28017":1702,"_19412":50851,"_5":13306,"_25509":50718,"_2665":50852},[],"Plan and verify expiration using the Profiles rules. Issuance does not automatically clamp validity to the issuer’s expiration; leave time to replace the authority and renew identities.",{"_3170":1753,"_28017":1702,"_19412":50854,"_5":13306,"_25509":50722,"_2665":50855},[],"Select &#x2A;*Create New CA (Existing Key)** when the key is already registered in Lamassu. The wizard first asks for the backing key and then shows the same configuration of type, identity, validity and profile.",{"_3170":1754,"_28017":1702,"_19412":50857,"_5":13306,"_25509":50722,"_2665":50858},[],"This flow is useful when the key was previously created in an HSM, imported through BYOK or must be reused under a specific custody policy.",{"_3170":1755,"_28017":1702,"_19412":50860,"_5":13306,"_25509":50726,"_2665":50861},[],"You need the CA certificate in PEM, its chain to a known root and, when importing it, an exportable private key. Before uploading material, verify signature, dates, `CA:TRUE`, signing usages and public-key correspondence. The key verification procedure also compares a CA key and certificate.",{"_3170":1756,"_28017":1702,"_19412":50863,"_5":13306,"_25509":50730,"_2665":50864},[],"Check the installation’s default engine before importing a CA with a key. CA import delegates key import to that engine; it does not guarantee arbitrary provider selection from the form. To select an engine while importing the key separately, use the KMS.",{"_3170":1757,"_28017":1702,"_19412":50866,"_5":13306,"_25509":50734,"_2665":50867},[],"Import the certificate and, when applicable, its PEM key. Register the CAs needed to identify the issuer. Registering a CA does not install it in external trust stores.",{"_3170":1758,"_28017":1702,"_19412":50869,"_5":13306,"_25509":50738,"_2665":50870},[],"Associate an explicit issuance profile if the CA will sign. Check usages and dates using Profiles.",{"_3170":1759,"_28017":1702,"_19412":50872,"_5":13306,"_25509":50742,"_2665":50873},[],"Review the registered type, associated key and engine, and issuer relationship. Certificate-only import may associate an existing KMS key using the certificate’s key identifier. Without a usable key, the CA is public material and cannot sign.",{"_3170":1760,"_28017":1702,"_19412":50875,"_5":13306,"_25509":50742,"_2665":50876},[],"For an issuing CA, complete a test issuance and check OCSP and CRL. Creating the record alone does not establish key availability, complete chain consistency or status publication.",{"_3170":1761,"_28017":1702,"_19412":50878,"_5":13306,"_25509":50746,"_2665":50879},[],"Open a CA from the inventory to review:",{"_3170":1762,"_28017":1702,"_19412":50881,"_5":13306,"_25509":50746,"_2665":50882},[],"Status and validity period.",{"_3170":1763,"_28017":1702,"_19412":50884,"_5":13306,"_25509":50746,"_2665":50885},[],"Certificate and chain in PEM format.",{"_3170":1764,"_28017":1702,"_19412":50887,"_5":13306,"_25509":50746,"_2665":50888},[],"Number of active, expired and revoked certificates.",{"_3170":1765,"_28017":1702,"_19412":50890,"_5":13306,"_25509":50746,"_2665":50891},[],"Certificates issued in **Issued Certificates**.",{"_3170":1766,"_28017":1702,"_19412":50893,"_5":13306,"_25509":50746,"_2665":50894},[],"The CRL linked to the authority.",{"_3170":1767,"_28017":1702,"_19412":50896,"_5":13306,"_25509":50746,"_2665":50897},[],"Metadata and the associated cryptographic engine.",{"_3170":1768,"_28017":1702,"_19412":50899,"_5":13306,"_25509":50746,"_2665":50900},[],"You can filter the inventory by name, status and CA type.",{"_3170":1769,"_28017":1702,"_19412":50902,"_5":13306,"_25509":50750,"_2665":50903},[],"You can start an issuance from **Issued Certificates**, from a CA's action menu or from the global certificate inventory.",{"_3170":1770,"_28017":1702,"_19412":50905,"_5":13306,"_25509":50750,"_2665":50906},[],"**Generate Key & CSR in Browser** is useful for a manual operation or a quick test. The browser generates the key and you must download it at the end.",{"_3170":1771,"_28017":1702,"_19412":50908,"_5":13306,"_25509":50750,"_2665":50909},[],"**Upload Existing CSR** is the right option when the key must remain on the target system. Lamassu receives the request but never the private key.",{"_3170":1772,"_28017":1702,"_19412":50911,"_5":13306,"_25509":50750,"_2665":50912},[],"Follow Issue your first certificate for the guided flow. Certificate management explains the inventory, inspection and revocation.",{"_3170":1773,"_28017":1702,"_19412":50914,"_5":13306,"_25509":50754,"_2665":50915},[],"Revoking a CA prevents issuance and may interrupt its entire branch. Only `CertificateHold` allows reactivating the CA itself if it is not expired. Descendant revocation is attempted with `CessationOfOperation`; reactivating the parent does not restore those descendants. Follow the cascading revocation conditions.",{"_3170":1774,"_28017":1702,"_19412":50917,"_5":13306,"_25509":50758,"_2665":50918},[],"Identify the certificates, devices and consumers that depend on the CA. Prepare a replacement authority and chain when necessary.",{"_3170":1775,"_28017":1702,"_19412":50920,"_5":13306,"_25509":50762,"_2665":50921},[],"Open the authority and select **Revoke CA**. Choose the reason that describes the incident, for example `KeyCompromise`, `CACompromise`, `Superseded` or `CessationOfOperation`.",{"_3170":1776,"_28017":1702,"_19412":50923,"_5":13306,"_25509":50766,"_2665":50924},[],"Type the CA's name exactly to enable **Confirm Revocation**.",{"_3170":1777,"_28017":1702,"_19412":50926,"_5":13306,"_25509":50770,"_2665":50927},[],"Check **REVOKED** on the CA and review descendants individually; propagation permits partial failures. Independently verify OCSP and CRL publication and consumer rejection. A revoked record does not guarantee that an existing session closes.",{"_3170":1778,"_28017":1702,"_19412":50929,"_5":13306,"_25509":50770,"_2665":50930},[],"Permanent deletion is only available after revoking. Delete the record only when your retention and audit policy allows it.",{"_3170":1779,"_28017":1779,"_5":13637,"_2665":50932,"_28339":50933,"_19412":50934,"_25509":1779},"Certificate profiles",[45393,46786,50519,50520],[],{"_3170":1780,"_28017":1779,"_19412":50936,"_5":13306,"_25509":1779,"_2665":50937},[],"Define reusable policies to issue consistent certificates and constrain accepted keys.",{"_3170":1781,"_28017":1779,"_5":28336,"_19412":50939,"_25509":50940,"_2665":50941},[],"/docs/platform/pki/certificate-profiles#what-a-profile-controls","What a profile controls",{"_3170":1782,"_28017":1779,"_5":28336,"_19412":50943,"_25509":50944,"_2665":50945},[],"/docs/platform/pki/certificate-profiles#validity","Validity",{"_3170":1783,"_28017":1779,"_5":28336,"_19412":50947,"_25509":50948,"_2665":50949},[],"/docs/platform/pki/certificate-profiles#ca-certificate-or-end-entity-certificate","CA certificate or end-entity certificate",{"_3170":1784,"_28017":1779,"_5":28336,"_19412":50951,"_25509":50952,"_2665":50953},[],"/docs/platform/pki/certificate-profiles#key-usage-and-extended-key-usage","Key Usage and Extended Key Usage",{"_3170":1785,"_28017":1779,"_5":28336,"_19412":50955,"_25509":50956,"_2665":50957},[],"/docs/platform/pki/certificate-profiles#subject","Subject",{"_3170":1786,"_28017":1779,"_5":28336,"_19412":50959,"_25509":50960,"_2665":50961},[],"/docs/platform/pki/certificate-profiles#csr-extensions","CSR extensions",{"_3170":1787,"_28017":1779,"_5":28336,"_19412":50963,"_25509":50964,"_2665":50965},[],"/docs/platform/pki/certificate-profiles#cryptographic-constraints","Cryptographic constraints",{"_3170":1788,"_28017":1779,"_5":28336,"_19412":50967,"_25509":50968,"_2665":50969},[],"/docs/platform/pki/certificate-profiles#profile-precedence","Profile precedence",{"_3170":1789,"_28017":1779,"_5":28336,"_19412":50971,"_25509":50972,"_2665":50973},[],"/docs/platform/pki/certificate-profiles#create-a-profile","Create a profile",{"_3170":1790,"_28017":1779,"_5":28336,"_19412":50975,"_25509":50976,"_2665":50977},[],"/docs/platform/pki/certificate-profiles#define-a-single-purpose","Define a single purpose",{"_3170":1791,"_28017":1779,"_5":28336,"_19412":50979,"_25509":50980,"_2665":50981},[],"/docs/platform/pki/certificate-profiles#choose-the-validity","Choose the validity",{"_3170":1792,"_28017":1779,"_5":28336,"_19412":50983,"_25509":50984,"_2665":50985},[],"/docs/platform/pki/certificate-profiles#fix-usages-and-subject","Fix usages and subject",{"_3170":1793,"_28017":1779,"_5":28336,"_19412":50987,"_25509":50988,"_2665":50989},[],"/docs/platform/pki/certificate-profiles#constrain-the-keys","Constrain the keys",{"_3170":1794,"_28017":1779,"_5":28336,"_19412":50991,"_25509":50992,"_2665":50993},[],"/docs/platform/pki/certificate-profiles#attach-it-and-test","Attach it and test",{"_3170":1795,"_28017":1779,"_5":28336,"_19412":50995,"_25509":50996,"_2665":50997},[],"/docs/platform/pki/certificate-profiles#design-examples","Design examples",{"_3170":1796,"_28017":1779,"_5":28336,"_19412":50999,"_25509":51000,"_2665":51001},[],"/docs/platform/pki/certificate-profiles#changes-and-deletion","Changes and deletion",{"_3170":1797,"_28017":1779,"_19412":51003,"_5":13306,"_25509":1779,"_2665":51004},[],"An issuance profile turns a certificate policy into reusable configuration. Instead of deciding validity, subject, extensions and algorithms on every request, you define once what is allowed and attach the profile to a CA, a DMS or a specific issuance.",{"_3170":1798,"_28017":1779,"_19412":51006,"_5":13306,"_25509":1779,"_2665":51007},[],"This guide is for the PKI administrator defining issuance policy. You need permissions to manage profiles and associate them with the intended CA or DMS, plus a test consumer with known identity and purpose requirements.",{"_3170":1799,"_28017":1779,"_19412":51009,"_5":13306,"_25509":50944,"_2665":51010},[],"You can express the lifetime as a duration from the moment of issuance or as a fixed end date. A duration works well for recurring identities; a common date is useful to make a whole batch end before a migration or retirement.",{"_3170":1800,"_28017":1779,"_19412":51012,"_5":13306,"_25509":50944,"_2665":51013},[],"Plan the end date within the issuing CA’s validity and leave a renewal margin. The signer calculates the date from the profile; it does not automatically clamp validity to the issuer’s expiration. Check both dates in the resulting certificate. A fixed date in the past does not produce a usable identity either.",{"_3170":1801,"_28017":1779,"_19412":51015,"_5":13306,"_25509":50948,"_2665":51016},[],"`Sign as CA` sets `IsCA` and the basic constraints needed for an authority. Enable it only in profiles intended to create or reissue subordinate CAs.",{"_3170":1802,"_28017":1779,"_19412":51018,"_5":13306,"_25509":50952,"_2665":51019},[],"The profile can enforce usages such as `DigitalSignature`, `KeyEncipherment`, `CertSign`, `CRLSign`, `ClientAuth`, `ServerAuth` or `OCSPSigning`.",{"_3170":1803,"_28017":1779,"_19412":51021,"_5":13306,"_25509":50952,"_2665":51022},[],"If you enable **Honor Key Usage** or **Honor Extended Key Usages**, Lamassu keeps the values requested by the CSR. If you disable them, it replaces them with the ones defined in the profile.",{"_3170":1804,"_28017":1779,"_19412":51024,"_5":13306,"_25509":50952,"_2665":51025},[],"Do not enable the `Honor…` options for untrusted requests unless another component validates those fields. Otherwise, the requester may choose broader capabilities than intended.",{"_3170":1805,"_28017":1779,"_19412":51027,"_5":13306,"_25509":50956,"_2665":51028},[],"With **Honor Subject**, the certificate keeps the subject of the CSR. Without that option, Lamassu applies the profile's `CN`, `O`, `OU`, `C`, `ST` and `L`. If the profile does not define a `Common Name`, the requested CN is kept.",{"_3170":1806,"_28017":1779,"_19412":51030,"_5":13306,"_25509":50960,"_2665":51031},[],"With **Honor Extensions**, Lamassu filters the additional requested extensions and keeps only SAN. Without that option, it discards the CSR's additional extensions.",{"_3170":1807,"_28017":1779,"_19412":51033,"_5":13306,"_25509":50960,"_2665":51034},[],"This preserves SAN, but does not establish that the requester is entitled to those DNS names, IP addresses, emails or URIs. Validate that authorization before issuing. OCSP and CRL locations come from the issuance service configuration; `Honor Extensions` does not copy CSR distribution points.",{"_3170":1808,"_28017":1779,"_19412":51036,"_5":13306,"_25509":50964,"_2665":51037},[],"The cryptographic enforcement can:",{"_3170":1809,"_28017":1779,"_19412":51039,"_5":13306,"_25509":50964,"_2665":51040},[],"allow or block RSA keys;",{"_3170":1810,"_28017":1779,"_19412":51042,"_5":13306,"_25509":50964,"_2665":51043},[],"limit the supported RSA sizes;",{"_3170":1811,"_28017":1779,"_19412":51045,"_5":13306,"_25509":50964,"_2665":51046},[],"allow or block ECDSA keys;",{"_3170":1812,"_28017":1779,"_19412":51048,"_5":13306,"_25509":50964,"_2665":51049},[],"limit the supported ECDSA sizes or curves.",{"_3170":1813,"_28017":1779,"_19412":51051,"_5":13306,"_25509":50964,"_2665":51052},[],"When it is enabled, Lamassu checks the public key before creating a CA or signing a CSR. A key whose type or size is not listed in the profile is rejected.",{"_3170":1814,"_28017":1779,"_19412":51054,"_5":13306,"_25509":50968,"_2665":51055},[],"Resolution depends on the entry point. One complete profile is selected; its fields are not merged with the CA’s profile.",{"_3170":1815,"_28017":1779,"_19412":51057,"_5":13306,"_25509":50968,"_2665":48547},[],{"_3170":1816,"_28017":1779,"_19412":51059,"_5":13306,"_25509":50968,"_2665":51060},[],"First choice",{"_3170":1817,"_28017":1779,"_19412":51062,"_5":13306,"_25509":50968,"_2665":51063},[],"Second choice",{"_3170":1818,"_28017":1779,"_19412":51065,"_5":13306,"_25509":50968,"_2665":51066},[],"If neither is supplied",{"_3170":1819,"_28017":1779,"_19412":51068,"_5":13306,"_25509":50968,"_2665":51069},[],"Direct signing with a CA",{"_3170":1820,"_28017":1779,"_19412":51071,"_5":13306,"_25509":50968,"_2665":51072},[],"`issuance_profile` embedded in the request",{"_3170":1821,"_28017":1779,"_19412":51074,"_5":13306,"_25509":50968,"_2665":51075},[],"Request `issuance_profile_id`",{"_3170":1822,"_28017":1779,"_19412":51077,"_5":13306,"_25509":50968,"_2665":51078},[],"CA default profile (`profile_id`).",{"_3170":1823,"_28017":1779,"_19412":51080,"_5":13306,"_25509":50968,"_2665":51081},[],"Issuance through a DMS",{"_3170":1824,"_28017":1779,"_19412":51083,"_5":13306,"_25509":50968,"_2665":51084},[],"`settings.issuance_profile_id`",{"_3170":1825,"_28017":1779,"_19412":51086,"_5":13306,"_25509":50968,"_2665":51087},[],"`settings.issuance_profile` embedded in the DMS",{"_3170":1826,"_28017":1779,"_19412":51089,"_5":13306,"_25509":50968,"_2665":51090},[],"Enrollment CA default profile.",{"_3170":1827,"_28017":1779,"_19412":51092,"_5":13306,"_25509":50968,"_2665":51093},[],"If the selected identifier cannot be resolved, the operation fails; it does not silently fall back to the CA’s profile. Avoid setting both options at once. Recording which profile was selected helps explain why a certificate differs from its CSR.",{"_3170":1828,"_28017":1779,"_19412":51095,"_5":13306,"_25509":50968,"_2665":51096},[],"Several fleets can share a CA while keeping different profiles through their DMSs. Requester authentication and device registration policy are configured separately in DMS.",{"_3170":1829,"_28017":1779,"_19412":51098,"_5":13306,"_25509":50976,"_2665":51099},[],"Separate, for example, mTLS devices, servers and intermediate CAs. A small, specific profile is easier to review than one that allows every use.",{"_3170":1830,"_28017":1779,"_19412":51101,"_5":13306,"_25509":50980,"_2665":51102},[],"Align the duration with the fleet's real renewal capacity. Leave margin against the CA's expiration.",{"_3170":1831,"_28017":1779,"_19412":51104,"_5":13306,"_25509":50984,"_2665":51105},[],"For a device that authenticates as a client, the usual starting point is `DigitalSignature` and `ClientAuth`. Add `ServerAuth` or `KeyEncipherment` only if the protocol needs it.",{"_3170":1832,"_28017":1779,"_19412":51107,"_5":13306,"_25509":50988,"_2665":51108},[],"Enable cryptographic enforcement and list only algorithms and sizes compatible with your policy and your devices.",{"_3170":1833,"_28017":1779,"_19412":51110,"_5":13306,"_25509":50992,"_2665":51111},[],"Attach the profile to a CA or DMS and check the precedence above. Issue a CSR with known usages and SAN; inspect the result with `openssl x509 -in device.crt -noout -text`. Check subject, SAN, KU, EKU and dates. For an end-entity identity, disable `Sign as CA`, require no `CA:TRUE` or `Certificate Sign`, and require `CA:FALSE` if Basic Constraints is present.",{"_3170":1834,"_28017":1779,"_19412":51113,"_5":13306,"_25509":50992,"_2665":51114},[],"Also try a key excluded by policy: issuance should fail. Follow the certificate verification and test acceptance in the intended consumer.",{"_3170":1835,"_28017":1779,"_19412":51116,"_5":13306,"_25509":50996,"_2665":51117},[],"**mTLS device**\\\nEnd-entity certificate, short validity, `DigitalSignature`, `ClientAuth`, subject controlled by the DMS and SAN allowed when it identifies the device.",{"_3170":1836,"_28017":1779,"_19412":51119,"_5":13306,"_25509":50996,"_2665":51120},[],"**TLS server**\\\nEnd-entity certificate, `DigitalSignature`, `ServerAuth` and mandatory SAN with the names clients will use.",{"_3170":1837,"_28017":1779,"_19412":51122,"_5":13306,"_25509":50996,"_2665":51123},[],"**Intermediate CA**\\\n`Sign as CA`, `CertSign` and `CRLSign`, validity longer than its end-entity certificates and stricter cryptographic constraints.",{"_3170":1838,"_28017":1779,"_19412":51125,"_5":13306,"_25509":50996,"_2665":51126},[],"These patterns express design decisions. Enabling `Honor Extensions` does not require a CSR to contain SAN or validate its names; enforce that in the request workflow. A profile does not install trust or grant permissions in the consumer.",{"_3170":1839,"_28017":1779,"_19412":51128,"_5":13306,"_25509":51000,"_2665":51129},[],"Updating a profile affects future issuances; it does not modify already-signed certificates. Test changes before applying them to a CA in production and keep the operational justification.",{"_3170":1840,"_28017":1779,"_19412":51131,"_5":13306,"_25509":51000,"_2665":51132},[],"Before deleting a profile, check that no CA or DMS depends on it. If you want to replace it, create the new version, update the references and perform a test issuance before retiring the old one.",{"_3170":1841,"_28017":1841,"_5":13637,"_2665":51134,"_28339":51135,"_19412":51137,"_25509":1841},"Certificate validation",[45393,46786,50519,51136],"Validation",[],{"_3170":1842,"_28017":1841,"_19412":51139,"_5":13306,"_25509":1841,"_2665":51140},[],"Check chain, identity, purpose and revocation from the consumer.",{"_3170":1843,"_28017":1841,"_5":28336,"_19412":51142,"_25509":51143,"_2665":51144},[],"/docs/platform/pki/certificate-validation#before-querying-status","Before querying status",{"_3170":1844,"_28017":1841,"_5":28336,"_19412":51146,"_25509":51147,"_2665":51148},[],"/docs/platform/pki/certificate-validation#choose-a-mechanism","Choose a mechanism",{"_3170":1845,"_28017":1841,"_5":28336,"_19412":51150,"_25509":51151,"_2665":51152},[],"/docs/platform/pki/certificate-validation#check-consumer-behavior","Check consumer behavior",{"_3170":1846,"_28017":1841,"_19412":51154,"_5":13306,"_25509":1841,"_2665":51155},[],"This guide brings together the checks needed when integrating a certificate consumer. You need the presented certificate, intermediates and roots that your application has deliberately chosen to trust. Lamassu publishes status; the consumer applies acceptance policy.",{"_3170":1847,"_28017":1841,"_19412":51157,"_5":13306,"_25509":51143,"_2665":51158},[],"Verify these criteria together:",{"_3170":1848,"_28017":1841,"_19412":51160,"_5":13306,"_25509":51143,"_2665":50143},[],{"_3170":1849,"_28017":1841,"_19412":51162,"_5":13306,"_25509":51143,"_2665":51163},[],"Required result",{"_3170":1850,"_28017":1841,"_19412":51165,"_5":13306,"_25509":51143,"_2665":51166},[],"Chain and signature",{"_3170":1851,"_28017":1841,"_19412":51168,"_5":13306,"_25509":51143,"_2665":51169},[],"Valid chain to a root deliberately installed in the consumer.",{"_3170":1852,"_28017":1841,"_19412":51171,"_5":13306,"_25509":51143,"_2665":51172},[],"Dates",{"_3170":1853,"_28017":1841,"_19412":51174,"_5":13306,"_25509":51143,"_2665":51175},[],"Current time between `Not Before` and `Not After`, including the CAs in the chain.",{"_3170":1854,"_28017":1841,"_19412":51177,"_5":13306,"_25509":51143,"_2665":46483},[],{"_3170":1855,"_28017":1841,"_19412":51179,"_5":13306,"_25509":51143,"_2665":51180},[],"Name, SAN or identifier matches the expected peer.",{"_3170":1856,"_28017":1841,"_19412":51182,"_5":13306,"_25509":51143,"_2665":45783},[],{"_3170":1857,"_28017":1841,"_19412":51184,"_5":13306,"_25509":51143,"_2665":51185},[],"KU, EKU and constraints permit the specific operation.",{"_3170":1858,"_28017":1841,"_19412":51187,"_5":13306,"_25509":51143,"_2665":51188},[],"Revocation",{"_3170":1859,"_28017":1841,"_19412":51190,"_5":13306,"_25509":51143,"_2665":51191},[],"Signed, current evidence corresponding to the queried issuer and certificate.",{"_3170":1860,"_28017":1841,"_19412":51193,"_5":13306,"_25509":51143,"_2665":51194},[],"Authorization",{"_3170":1861,"_28017":1841,"_19412":51196,"_5":13306,"_25509":51143,"_2665":51197},[],"The application permits that identity to perform the action.",{"_3170":1862,"_28017":1841,"_19412":51199,"_5":13306,"_25509":51143,"_2665":51200},[],"The issuance walkthrough checks chain and purpose with OpenSSL. That check does not automatically query OCSP or download a CRL. Inventory presence or an OCSP `Good` response does not replace the other criteria.",{"_3170":1863,"_28017":1841,"_19412":51202,"_5":13306,"_25509":51147,"_2665":51203},[],"Mechanism",{"_3170":1864,"_28017":1841,"_19412":51205,"_5":13306,"_25509":51147,"_2665":51206},[],"When to use it",{"_3170":1865,"_28017":1841,"_19412":51208,"_5":13306,"_25509":51147,"_2665":51209},[],"What you must maintain",{"_3170":1866,"_28017":1841,"_19412":51211,"_5":13306,"_25509":51147,"_2665":51212},[],"OCSP",{"_3170":1867,"_28017":1841,"_19412":51214,"_5":13306,"_25509":51147,"_2665":51215},[],"Status query for a specific certificate.",{"_3170":1868,"_28017":1841,"_19412":51217,"_5":13306,"_25509":51147,"_2665":51218},[],"Responder access, signature verification and cache/freshness policy.",{"_3170":1869,"_28017":1841,"_19412":51220,"_5":13306,"_25509":51147,"_2665":51221},[],"CRL",{"_3170":1870,"_28017":1841,"_19412":51223,"_5":13306,"_25509":51147,"_2665":51224},[],"Local checks for many certificates or offline operation.",{"_3170":1871,"_28017":1841,"_19412":51226,"_5":13306,"_25509":51147,"_2665":51227},[],"Periodic download of an issuer-signed list and rejection of expired lists.",{"_3170":1872,"_28017":1841,"_19412":51229,"_5":13306,"_25509":51147,"_2665":51230},[],"OCSP can also return a response reusable until `nextUpdate`; a CRL changes when a new version is published. Neither mechanism alone guarantees that a consumer learns a revocation at the moment it is saved.",{"_3170":1873,"_28017":1841,"_19412":51232,"_5":13306,"_25509":51147,"_2665":51233},[],"If using both, define when fallback is allowed and what the client does when retrieval, signature or freshness checks fail, or the result is `Unknown`. Accepting an identity when its status cannot be checked must be an explicit application decision.",{"_3170":1874,"_28017":1841,"_19412":51235,"_5":13306,"_25509":51151,"_2665":51236},[],"Accept a current, authorized certificate with a known chain.",{"_3170":1875,"_28017":1841,"_19412":51238,"_5":13306,"_25509":51151,"_2665":51239},[],"Reject another certificate with an unknown root or incompatible purpose.",{"_3170":1876,"_28017":1841,"_19412":51241,"_5":13306,"_25509":51151,"_2665":51242},[],"Revoke a test certificate and verify the OCSP response or new CRL.",{"_3170":1877,"_28017":1841,"_19412":51244,"_5":13306,"_25509":51151,"_2665":51245},[],"Check that a new connection with that identity is rejected.",{"_3170":1878,"_28017":1841,"_19412":51247,"_5":13306,"_25509":51151,"_2665":51248},[],"Simulate an unreachable endpoint and expired evidence; observe whether the result matches policy.",{"_3170":1879,"_28017":1841,"_19412":51250,"_5":13306,"_25509":51151,"_2665":51251},[],"Keep the serial number, issuer, revocation reason, query time and evidence timestamps. An existing session may need explicit closure or reauthentication in the consumer; publishing revocation does not automatically close it.",{"_3170":1880,"_28017":1841,"_19412":51253,"_5":13306,"_25509":51151,"_2665":51254},[],"For a chain with intermediates, validate their status according to consumer policy as well. An end-entity issuer’s CRL does not replace checks on every CA in the chain.",{"_3170":1881,"_28017":1841,"_19412":51256,"_5":13306,"_25509":51151,"_2665":51257},[],"<Card title=\"Online validation with OCSP\" description=\"Generate a query and verify signature, status and timestamps.\" href=\"/docs/platform/pki/ocsp\" />",{"_3170":1882,"_28017":1841,"_19412":51259,"_5":13306,"_25509":51151,"_2665":51260},[],"<Card title=\"Revocation lists\" description=\"Download, inspect and use an issuer’s CRL.\" href=\"/docs/platform/pki/crl\" />",{"_3170":1883,"_28017":1883,"_5":13637,"_2665":51262,"_28339":51263,"_19412":51264,"_25509":1883},"Certificates",[45393,46786,50519,50520],[],{"_3170":1884,"_28017":1883,"_19412":51266,"_5":13306,"_25509":1883,"_2665":51267},[],"Inspect, download and revoke the certificates issued by Lamassu.",{"_3170":1885,"_28017":1883,"_5":28336,"_19412":51269,"_25509":51270,"_2665":51271},[],"/docs/platform/pki/certificates#find-a-certificate","Find a certificate",{"_3170":1886,"_28017":1883,"_5":28336,"_19412":51273,"_25509":51274,"_2665":51275},[],"/docs/platform/pki/certificates#download-the-certificate","Download the certificate",{"_3170":1887,"_28017":1883,"_5":28336,"_19412":51277,"_25509":51278,"_2665":51279},[],"/docs/platform/pki/certificates#issue-from-an-existing-csr","Issue from an existing CSR",{"_3170":1888,"_28017":1883,"_5":28336,"_19412":51281,"_25509":51282,"_2665":51283},[],"/docs/platform/pki/certificates#revoke-a-certificate","Revoke a certificate",{"_3170":1889,"_28017":1883,"_5":28336,"_19412":51285,"_25509":51286,"_2665":51287},[],"/docs/platform/pki/certificates#open-the-action","Open the action",{"_3170":1890,"_28017":1883,"_5":28336,"_19412":51289,"_25509":51290,"_2665":51291},[],"/docs/platform/pki/certificates#choose-a-reason","Choose a reason",{"_3170":1891,"_28017":1883,"_5":28336,"_19412":51293,"_25509":51294,"_2665":51295},[],"/docs/platform/pki/certificates#confirm-and-verify","Confirm and verify",{"_3170":1892,"_28017":1883,"_5":28336,"_19412":51297,"_25509":51298,"_2665":51299},[],"/docs/platform/pki/certificates#reactivate-a-hold","Reactivate a hold",{"_3170":1893,"_28017":1883,"_5":28336,"_19412":51301,"_25509":51302,"_2665":51303},[],"/docs/platform/pki/certificates#continue","Continue",{"_3170":1894,"_28017":1883,"_19412":51305,"_5":13306,"_25509":1883,"_2665":51306},[],"This guide is for a PKI operator inspecting or retiring an issued identity. You need inventory access and, to change states, permissions on the certificate. Open **Certificates** for a global view or **Issued Certificates** within a CA to restrict it to that issuer.",{"_3170":1895,"_28017":1883,"_19412":51308,"_5":13306,"_25509":51270,"_2665":51309},[],"Filter by `Common Name`, serial, status and issuer. Use **Quick Inspect** for a quick review or **View Details** for subject, SAN, usages, chain, dates and metadata.",{"_3170":1896,"_28017":1883,"_19412":51311,"_5":13306,"_25509":51270,"_2665":51312},[],"Identify a certificate by issuer and serial; a name can correspond to several renewals. Check which certificate the consumer actually uses and which occupies the device’s active identity. Identity history and the certificate inventory answer different questions.",{"_3170":1897,"_28017":1883,"_19412":51314,"_5":13306,"_25509":51274,"_2665":51315},[],"Download the PEM and inspect it:",{"_3170":1898,"_28017":1883,"_19412":51317,"_5":13306,"_25509":51274,"_2665":51318},[],"Check issuance policy, chain and usages with the verification walkthrough. A certificate does not contain its private key. For an external CSR, the key remains where it was generated; for the browser flow, retain the file downloaded upon issuance. If the key is lost, plan a new identity rather than expecting recovery from the certificate.",{"_3170":1899,"_28017":1883,"_19412":51320,"_5":13306,"_25509":51278,"_2665":51321},[],"Use this flow when the identity’s key must remain on the system that generated it. You need an active CA with a usable key, a PEM CSR and a suitable profile.",{"_3170":1900,"_28017":1883,"_19412":51323,"_5":13306,"_25509":51278,"_2665":51324},[],"Verify the request with `openssl req -in request.csr -noout -verify -text`. Review subject, SAN and algorithm, and authorize the requested identity.",{"_3170":1901,"_28017":1883,"_19412":51326,"_5":13306,"_25509":51278,"_2665":51327},[],"Start issuance from the CA or inventory and select **Upload Existing CSR**.",{"_3170":1902,"_28017":1883,"_19412":51329,"_5":13306,"_25509":51278,"_2665":51330},[],"Confirm the CA and profile resolved according to Profiles; the request does not guarantee that every field is retained.",{"_3170":1903,"_28017":1883,"_19412":51332,"_5":13306,"_25509":51278,"_2665":51333},[],"Download the certificate and inspect dates, issuer, subject, SAN, KU and EKU. Check correspondence with the private key on the originating system.",{"_3170":1904,"_28017":1883,"_19412":51335,"_5":13306,"_25509":51278,"_2665":51336},[],"Install certificate and chain in the intended consumer and test a connection. Issuance alone does not register a device or grant access in an integration.",{"_3170":1905,"_28017":1883,"_19412":51338,"_5":13306,"_25509":51278,"_2665":51339},[],"For browser key generation, follow Issue your first certificate.",{"_3170":1906,"_28017":1883,"_19412":51341,"_5":13306,"_25509":51282,"_2665":51342},[],"Revoke when the key is compromised, the subject is no longer authorized or the identity must stop being accepted before expiration. Before changing status, identify consumers and prepare any required replacement.",{"_3170":1907,"_28017":1883,"_19412":51344,"_5":13306,"_25509":51286,"_2665":51345},[],"Locate the correct issuer and serial and select **Revoke Certificate**. `EXPIRED` records and records revoked for a final reason reject subsequent status changes.",{"_3170":1908,"_28017":1883,"_19412":51347,"_5":13306,"_25509":51290,"_2665":51348},[],"Select the incident reason. `CertificateHold` represents a reversible certificate suspension; other reasons block later changes. Do not use a suspension to address a compromised key.",{"_3170":1909,"_28017":1883,"_19412":51350,"_5":13306,"_25509":51294,"_2665":51351},[],"Save the change and read the record again: require **REVOKED**, reason and timestamp. Then verify a fresh OCSP query and, if using CRL, its published version and the serial’s presence. Finally check rejection of a new connection in the consumer.",{"_3170":1910,"_28017":1883,"_19412":51353,"_5":13306,"_25509":51294,"_2665":51354},[],"Revocation does not erase the certificate, delete the key or guarantee closure of existing sessions. Status and publication are separate steps.",{"_3170":1911,"_28017":1883,"_19412":51356,"_5":13306,"_25509":51294,"_2665":51357},[],"A certificate revoked with `CertificateHold` can be reactivated if it is not in `EXPIRED` state. Its dates and consumer trust remain mandatory.",{"_3170":1912,"_28017":1883,"_19412":51359,"_5":13306,"_25509":51298,"_2665":51360},[],"Check that the saved reason is `CertificateHold` and the identity still satisfies policy. Request `ACTIVE` through the status update operation exposed by your installation; consult the API reference. Do not assume changing consumer permissions also changes status in Lamassu.",{"_3170":1913,"_28017":1883,"_19412":51362,"_5":13306,"_25509":51298,"_2665":51363},[],"Read the record and query OCSP again. With `regenerate_on_revoke` enabled, the reactivation event requests CRL regeneration: check that the new list omits the serial. An earlier list can still mark it revoked until the client refreshes its copy.",{"_3170":1914,"_28017":1883,"_19412":51365,"_5":13306,"_25509":51298,"_2665":51366},[],"This does not undo permanent revocation or a cascade started by revoking a CA.",{"_3170":1915,"_28017":1883,"_19412":51368,"_5":13306,"_25509":51302,"_2665":51369},[],"<Card title=\"Validate with OCSP\" description=\"Query and verify a certificate’s signed status.\" href=\"/docs/platform/pki/ocsp\" />",{"_3170":1916,"_28017":1883,"_19412":51371,"_5":13306,"_25509":51302,"_2665":51372},[],"<Card title=\"Distribute a CRL\" description=\"Publish status for local validation.\" href=\"/docs/platform/pki/crl\" />",{"_3170":1917,"_28017":1917,"_5":13637,"_2665":51374,"_28339":51375,"_19412":51377,"_25509":1917},"Certificate lifecycle",[45393,46786,50519,51376],"Concepts",[],{"_3170":1918,"_28017":1917,"_19412":51379,"_5":13306,"_25509":1917,"_2665":51380},[],"Issuance, use, renewal, revocation and retirement of certificates in Lamassu.",{"_3170":1919,"_28017":1917,"_5":28336,"_19412":51382,"_25509":51383,"_2665":51384},[],"/docs/platform/pki/concepts/certificate-lifecycle#the-full-journey","The full journey",{"_3170":1920,"_28017":1917,"_5":28336,"_19412":51386,"_25509":51387,"_2665":51388},[],"/docs/platform/pki/concepts/certificate-lifecycle#request","Request",{"_3170":1921,"_28017":1917,"_5":28336,"_19412":51390,"_25509":51391,"_2665":51392},[],"/docs/platform/pki/concepts/certificate-lifecycle#issuance","Issuance",{"_3170":1922,"_28017":1917,"_5":28336,"_19412":51394,"_25509":51395,"_2665":51396},[],"/docs/platform/pki/concepts/certificate-lifecycle#use-and-monitoring","Use and monitoring",{"_3170":1923,"_28017":1917,"_5":28336,"_19412":51398,"_25509":51399,"_2665":51400},[],"/docs/platform/pki/concepts/certificate-lifecycle#renewal-or-re-enrollment","Renewal or re-enrollment",{"_3170":1924,"_28017":1917,"_5":28336,"_19412":51402,"_25509":51403,"_2665":51404},[],"/docs/platform/pki/concepts/certificate-lifecycle#revocation-or-retirement","Revocation or retirement",{"_3170":1925,"_28017":1917,"_5":28336,"_19412":51406,"_25509":51407,"_2665":51408},[],"/docs/platform/pki/concepts/certificate-lifecycle#certificate-states","Certificate states",{"_3170":1926,"_28017":1917,"_5":28336,"_19412":51410,"_25509":51411,"_2665":51412},[],"/docs/platform/pki/concepts/certificate-lifecycle#renewal-and-revocation-are-not-equivalent","Renewal and revocation are not equivalent",{"_3170":1927,"_28017":1917,"_5":28336,"_19412":51414,"_25509":51415,"_2665":51416},[],"/docs/platform/pki/concepts/certificate-lifecycle#effect-of-revoking-a-ca","Effect of revoking a CA",{"_3170":1928,"_28017":1917,"_5":28336,"_19412":51418,"_25509":51419,"_2665":51420},[],"/docs/platform/pki/concepts/certificate-lifecycle#what-you-should-watch","What you should watch",{"_3170":1929,"_28017":1917,"_19412":51422,"_5":13306,"_25509":1917,"_2665":51423},[],"Issuing a certificate is only the beginning. During its useful life you must check its validity, renew it before it expires and retire it when it stops being trustworthy. Lamassu keeps the certificate, its issuing CA, its status and, when it belongs to a device, the identity it is linked to.",{"_3170":1930,"_28017":1917,"_19412":51425,"_5":13306,"_25509":51387,"_2665":51426},[],"The requester generates a key and a CSR. In the recommended flows, the private key stays in the device, browser or cryptographic engine that created it.",{"_3170":1931,"_28017":1917,"_19412":51428,"_5":13306,"_25509":51391,"_2665":51429},[],"The CA signs the CSR. The issuance profile determines the validity, uses, subject, allowed extensions and cryptographic constraints.",{"_3170":1932,"_28017":1917,"_19412":51431,"_5":13306,"_25509":51395,"_2665":51432},[],"The certificate enters the `ACTIVE` state. Lamassu monitors its `Not After` date; the cryptographic monitoring job marks certificates that have expired as `EXPIRED`.",{"_3170":1933,"_28017":1917,"_19412":51434,"_5":13306,"_25509":51399,"_2665":51435},[],"A new certificate is issued before the previous one expires. In a DMS you can open preventive and critical windows so the device re-enrolls through EST.",{"_3170":1934,"_28017":1917,"_19412":51437,"_5":13306,"_25509":51403,"_2665":51438},[],"If the identity stops being trustworthy, Lamassu records the reason and time of revocation. OCSP and CRLs let consumers learn that status.",{"_3170":1935,"_28017":1917,"_19412":51440,"_5":13306,"_25509":51407,"_2665":51441},[],"Lamassu persists four X.509 states:",{"_3170":1936,"_28017":1917,"_19412":51443,"_5":13306,"_25509":51407,"_2665":51444},[],"**`ACTIVE`**: the record is enabled. Also check `Not Before` and `Not After`: this state does not establish time validity.",{"_3170":1937,"_28017":1917,"_19412":51446,"_5":13306,"_25509":51407,"_2665":51447},[],"**`EXPIRED`**: it has passed its expiration date. The monitor detects this periodically; it is not a state that should be assigned manually.",{"_3170":1938,"_28017":1917,"_19412":51449,"_5":13306,"_25509":51407,"_2665":51450},[],"**`REVOKED`**: it was invalidated before expiring, with a reason and a timestamp.",{"_3170":1939,"_28017":1917,"_19412":51452,"_5":13306,"_25509":51407,"_2665":51453},[],"**`INACTIVE`**: it is disabled without representing a definitive revocation.",{"_3170":1940,"_28017":1917,"_19412":51455,"_5":13306,"_25509":51407,"_2665":51456},[],"The device view may add operational states such as missing identity, pending renewal, expiring soon or decommissioned. These are an interpretation of the device's status and its certificates, not new X.509 states.",{"_3170":1941,"_28017":1917,"_19412":51458,"_5":13306,"_25509":51411,"_2665":51459},[],"**Renewal** creates a successor certificate for an identity that remains valid. **Revocation** communicates that the current certificate must no longer be accepted. Renew to maintain continuity; revoke in response to compromise, retirement or a change that invalidates the identity.",{"_3170":1942,"_28017":1917,"_19412":51461,"_5":13306,"_25509":51411,"_2665":51462},[],"Only `CertificateHold` allows reactivating a revoked certificate that is not in `EXPIRED` state. Revocation for another reason blocks subsequent status changes. `EXPIRED` records also reject changes; the consumer must check dates even before the monitor updates the state. Certificates explains how to verify revocation and reactivation.",{"_3170":1943,"_28017":1917,"_19412":51464,"_5":13306,"_25509":51411,"_2665":51465},[],"The **Reissue CA** operation generates another certificate for the same key and links both serial numbers through metadata. It is not a key rotation. To change the key, create a successor CA and perform a migration with an overlapping period.",{"_3170":1944,"_28017":1917,"_19412":51467,"_5":13306,"_25509":51415,"_2665":51468},[],"Revoking a CA starts a cascade that attempts to revoke descendants with `CessationOfOperation`. It may end with partial failures and is not undone by reactivating the parent. Read Hierarchy and rotation for conditions and checks.",{"_3170":1945,"_28017":1917,"_19412":51470,"_5":13306,"_25509":51415,"_2665":51471},[],"Before confirming:",{"_3170":1946,"_28017":1917,"_19412":51473,"_5":13306,"_25509":51415,"_2665":51474},[],"Identify DMSs, devices and services that trust that chain.",{"_3170":1947,"_28017":1917,"_19412":51476,"_5":13306,"_25509":51415,"_2665":51477},[],"Distribute the new chain of trust.",{"_3170":1948,"_28017":1917,"_19412":51479,"_5":13306,"_25509":51415,"_2665":51480},[],"Reissue the necessary identities.",{"_3170":1949,"_28017":1917,"_19412":51482,"_5":13306,"_25509":51415,"_2665":51483},[],"Check OCSP and CRL from a real consumer.",{"_3170":1950,"_28017":1917,"_19412":51485,"_5":13306,"_25509":51415,"_2665":51486},[],"Revoke the old CA once no legitimate traffic remains.",{"_3170":1951,"_28017":1917,"_19412":51488,"_5":13306,"_25509":51415,"_2665":51489},[],"Device retirement belongs to the IoT Fleets lifecycle. It affects the active identity; it does not automatically traverse and revoke every historical certificate. Review previous identities and consumer permissions separately in Device management.",{"_3170":1952,"_28017":1917,"_19412":51491,"_5":13306,"_25509":51419,"_2665":51492},[],"Certificates entering the preventive or critical renewal window.",{"_3170":1953,"_28017":1917,"_19412":51494,"_5":13306,"_25509":51419,"_2665":51495},[],"Repeated enrollment or re-enrollment failures.",{"_3170":1954,"_28017":1917,"_19412":51497,"_5":13306,"_25509":51419,"_2665":51498},[],"Status changes and revocation reasons.",{"_3170":1955,"_28017":1917,"_19412":51500,"_5":13306,"_25509":51419,"_2665":51501},[],"OCSP and CRL publication and validity.",{"_3170":1956,"_28017":1917,"_19412":51503,"_5":13306,"_25509":51419,"_2665":51504},[],"Dependencies still presenting a replaced certificate.",{"_3170":1957,"_28017":1917,"_19412":51506,"_5":13306,"_25509":51419,"_2665":51507},[],"The device history relates its previous and current identities. For administrative changes and mutation errors, see Audit logs.",{"_3170":1958,"_28017":1958,"_5":13637,"_2665":51509,"_28339":51510,"_19412":51511,"_25509":1958},"Trust model",[45393,46786,50519,51376],[],{"_3170":1959,"_28017":1958,"_19412":51513,"_5":13306,"_25509":1958,"_2665":51514},[],"Understand where trust originates, how it is distributed and what each component validates.",{"_3170":1960,"_28017":1958,"_5":28336,"_19412":51516,"_25509":51517,"_2665":51518},[],"/docs/platform/pki/concepts/trust-model#the-four-trust-decisions","The four trust decisions",{"_3170":1961,"_28017":1958,"_5":28336,"_19412":51520,"_25509":51521,"_2665":51522},[],"/docs/platform/pki/concepts/trust-model#who-can-issue","Who can issue",{"_3170":1962,"_28017":1958,"_5":28336,"_19412":51524,"_25509":51525,"_2665":51526},[],"/docs/platform/pki/concepts/trust-model#what-can-be-issued","What can be issued",{"_3170":1963,"_28017":1958,"_5":28336,"_19412":51528,"_25509":51529,"_2665":51530},[],"/docs/platform/pki/concepts/trust-model#who-can-request-it","Who can request it",{"_3170":1964,"_28017":1958,"_5":28336,"_19412":51532,"_25509":51533,"_2665":51534},[],"/docs/platform/pki/concepts/trust-model#who-accepts-the-result","Who accepts the result",{"_3170":1965,"_28017":1958,"_5":28336,"_19412":51536,"_25509":51537,"_2665":51538},[],"/docs/platform/pki/concepts/trust-model#identity-flow","Identity flow",{"_3170":1966,"_28017":1958,"_5":28336,"_19412":51540,"_25509":51541,"_2665":51542},[],"/docs/platform/pki/concepts/trust-model#enrollment-validation-and-distribution-cas","Enrollment, validation and distribution CAs",{"_3170":1967,"_28017":1958,"_5":28336,"_19412":51544,"_25509":51545,"_2665":51546},[],"/docs/platform/pki/concepts/trust-model#validation-and-revocation","Validation and revocation",{"_3170":1968,"_28017":1958,"_5":28336,"_19412":51548,"_25509":51549,"_2665":51550},[],"/docs/platform/pki/concepts/trust-model#custody-limits","Custody limits",{"_3170":1969,"_28017":1958,"_5":28336,"_19412":51552,"_25509":51553,"_2665":51554},[],"/docs/platform/pki/concepts/trust-model#recommended-pattern","Recommended pattern",{"_3170":1970,"_28017":1958,"_19412":51556,"_5":13306,"_25509":1958,"_2665":51557},[],"In Lamassu, trust does not simply mean that a certificate exists in the inventory. A consumer trusts an identity when it can build a chain to a root it recognizes, check that the certificate is fit for the intended use and verify that it is still valid.",{"_3170":1971,"_28017":1958,"_19412":51559,"_5":13306,"_25509":51521,"_2665":51560},[],"The CA hierarchy defines which authorities can sign. A root CA establishes the anchor of trust; intermediate CAs separate operating domains and avoid using the root for every issuance.",{"_3170":1972,"_28017":1958,"_19412":51562,"_5":13306,"_25509":51525,"_2665":51563},[],"Certificate profiles limit validity, subject, uses, extensions and cryptographic parameters. Possessing a CA does not replace an issuance policy.",{"_3170":1973,"_28017":1958,"_19412":51565,"_5":13306,"_25509":51529,"_2665":51566},[],"The DMS acts as the enrollment point. It can authenticate an EST request with a client certificate, an external webhook or a combination of both. CAs configured to validate the requester do not have to be the CA that will issue the new identity.",{"_3170":1974,"_28017":1958,"_19412":51568,"_5":13306,"_25509":51533,"_2665":51569},[],"The consumer keeps its own trust store. EST `/cacerts` can distribute the service TLS certificate, the enrollment CA and selected managed CAs. Initial trust for authenticating that service must come from an already trusted channel. Download and inspect the contents: do not assume they form a complete chain or install every entry as a root.",{"_3170":1975,"_28017":1958,"_19412":51571,"_5":13306,"_25509":51537,"_2665":51572},[],"The device proves it can enroll according to the DMS policy.",{"_3170":1976,"_28017":1958,"_19412":51574,"_5":13306,"_25509":51537,"_2665":51575},[],"The DMS validates the request and forwards the CSR to the enrollment CA.",{"_3170":1977,"_28017":1958,"_19412":51577,"_5":13306,"_25509":51537,"_2665":51578},[],"In the device-generated CSR flow, the CA applies the profile and signs without receiving the device’s private key.",{"_3170":1978,"_28017":1958,"_19412":51580,"_5":13306,"_25509":51537,"_2665":51581},[],"The device installs the certificate and the chain it needs.",{"_3170":1979,"_28017":1958,"_19412":51583,"_5":13306,"_25509":51537,"_2665":51584},[],"The system that trusts the device validates the chain, dates, uses and revocation status.",{"_3170":1980,"_28017":1958,"_19412":51586,"_5":13306,"_25509":51537,"_2665":51587},[],"OIDC or X.509 identifies the operator calling Lamassu. The authorization service decides which actions it may perform. The X.509 hierarchy, on the other hand, determines whether a certificate presented by a device is trustworthy.",{"_3170":1981,"_28017":1958,"_19412":51589,"_5":13306,"_25509":51541,"_2665":51590},[],"A DMS relates three sets that are worth designing separately:",{"_3170":1982,"_28017":1958,"_19412":51592,"_5":13306,"_25509":51541,"_2665":51593},[],"**Enrollment CA:** signs the new identities.",{"_3170":1983,"_28017":1958,"_19412":51595,"_5":13306,"_25509":51541,"_2665":51596},[],"**Validation CAs:** authenticate the client certificates used for enrollment or migration. During re-enrollment, the enrollment CA is always trusted and Lamassu then tries the validation CAs configured in the re-enrollment block; those are optional.",{"_3170":1984,"_28017":1958,"_19412":51598,"_5":13306,"_25509":51541,"_2665":51599},[],"**Distributed CAs:** form the content the device obtains through EST `/cacerts`. You can include the service TLS certificate, the enrollment CA and an explicit list of managed CAs. Including the issuer does not automatically add all its ancestors.",{"_3170":1985,"_28017":1958,"_19412":51601,"_5":13306,"_25509":51541,"_2665":51602},[],"This separation makes it possible to migrate a fleet: you temporarily accept certificates from the old hierarchy, issue with the new one and distribute both chains during the overlap.",{"_3170":1986,"_28017":1958,"_19412":51604,"_5":13306,"_25509":51545,"_2665":51605},[],"A valid chain does not by itself guarantee that a certificate should be accepted. The consumer must also check:",{"_3170":1987,"_28017":1958,"_19412":51607,"_5":13306,"_25509":51545,"_2665":51608},[],"that the current date is between `Not Before` and `Not After`;",{"_3170":1988,"_28017":1958,"_19412":51610,"_5":13306,"_25509":51545,"_2665":51611},[],"that `Key Usage` and `Extended Key Usage` allow the operation;",{"_3170":1989,"_28017":1958,"_19412":51613,"_5":13306,"_25509":51545,"_2665":51614},[],"that names, SANs and subject match the expected identity;",{"_3170":1990,"_28017":1958,"_19412":51616,"_5":13306,"_25509":51545,"_2665":51617},[],"that the certificate does not appear revoked in OCSP or a CRL.",{"_3170":1991,"_28017":1958,"_19412":51619,"_5":13306,"_25509":51545,"_2665":51620},[],"An OCSP `Good` status does not replace chain, date, usage and identity checks either; Validation brings those criteria together.",{"_3170":1992,"_28017":1958,"_19412":51622,"_5":13306,"_25509":51545,"_2665":51623},[],"During the mTLS authentication of a DMS, Lamassu attempts to check revocation. If the certificate does not contain enough information to perform that check, the backend logs a warning and continues treating it as not revoked. Design your profiles and distribution points to avoid that situation in production.",{"_3170":1993,"_28017":1958,"_19412":51625,"_5":13306,"_25509":51549,"_2665":51626},[],"The KMS keeps the reference to the key and delegates the operation to the configured engine. With an HSM or a cloud KMS, the private key can remain non-exportable. That protects custody, but it does not by itself prevent misuse: you still must restrict who can request a signature and audit those operations.",{"_3170":1994,"_28017":1958,"_19412":51628,"_5":13306,"_25509":51553,"_2665":51629},[],"Keep the root out of daily operations, or with very restricted access.",{"_3170":1995,"_28017":1958,"_19412":51631,"_5":13306,"_25509":51553,"_2665":51632},[],"Issue from intermediate CAs separated by environment or risk domain.",{"_3170":1996,"_28017":1958,"_19412":51634,"_5":13306,"_25509":51553,"_2665":51635},[],"Assign explicit profiles to every use case.",{"_3170":1997,"_28017":1958,"_19412":51637,"_5":13306,"_25509":51553,"_2665":51638},[],"Distribute the new trust before starting a rotation.",{"_3170":1998,"_28017":1958,"_19412":51640,"_5":13306,"_25509":51553,"_2665":51641},[],"Keep enough overlap to renew a disconnected fleet.",{"_3170":1999,"_28017":1958,"_19412":51643,"_5":13306,"_25509":51553,"_2665":51644},[],"Validate from the consuming system, not only from the Lamassu console.",{"_3170":2000,"_28017":1958,"_19412":51646,"_5":13306,"_25509":51553,"_2665":51647},[],"Continue with CA hierarchy and rotation to turn this model into an operating procedure.",{"_3170":2001,"_28017":2001,"_5":13637,"_2665":51649,"_28339":51650,"_19412":51651,"_25509":2001},"Revocation lists (CRL)",[45393,46786,50519,51136],[],{"_3170":2002,"_28017":2001,"_19412":51653,"_5":13306,"_25509":2001,"_2665":51654},[],"Generate and distribute signed lists to validate certificates offline.",{"_3170":2003,"_28017":2001,"_5":28336,"_19412":51656,"_25509":51657,"_2665":51658},[],"/docs/platform/pki/crl#va-role-and-per-ca-configuration","VA role and per-CA configuration",{"_3170":2004,"_28017":2001,"_5":28336,"_19412":51660,"_25509":51661,"_2665":51662},[],"/docs/platform/pki/crl#periodic-and-automatic-regeneration","Periodic and automatic regeneration",{"_3170":2005,"_28017":2001,"_5":28336,"_19412":51664,"_25509":51665,"_2665":51666},[],"/docs/platform/pki/crl#crl-contents","CRL contents",{"_3170":2006,"_28017":2001,"_5":28336,"_19412":51668,"_25509":51669,"_2665":51670},[],"/docs/platform/pki/crl#public-download-endpoint","Public download endpoint",{"_3170":2007,"_28017":2001,"_5":28336,"_19412":51672,"_25509":51673,"_2665":51674},[],"/docs/platform/pki/crl#va-role-management-api","VA role management API",{"_3170":2008,"_28017":2001,"_5":28336,"_19412":51676,"_25509":51677,"_2665":51678},[],"/docs/platform/pki/crl#from-the-interface","From the interface",{"_3170":2009,"_28017":2001,"_5":28336,"_19412":51680,"_25509":51681,"_2665":51682},[],"/docs/platform/pki/crl#references","References",{"_3170":2010,"_28017":2001,"_19412":51684,"_5":13306,"_25509":2001,"_2665":51685},[],"A CRL is an issuer-signed list of revoked certificates. This guide is for an operator publishing lists and an integrator using them locally. You need the issuing CA certificate, its SKI and access to the published endpoint. The client must maintain a current copy: offline operation still requires refreshing evidence.",{"_3170":2011,"_28017":2001,"_19412":51687,"_5":13306,"_25509":51657,"_2665":51688},[],"The VA role stores configuration and metadata for the latest list published for a CA’s SKI. Generation requires a usable issuer key; do not assume an imported CA without a key has an available CRL.",{"_3170":2012,"_28017":2001,"_19412":51690,"_5":13306,"_25509":51657,"_2665":51691},[],"`crl_options` field",{"_3170":2013,"_28017":2001,"_19412":51693,"_5":13306,"_25509":51657,"_2665":45783},[],{"_3170":2014,"_28017":2001,"_19412":51695,"_5":13306,"_25509":51657,"_2665":51696},[],"Backend initial value",{"_3170":2015,"_28017":2001,"_19412":51698,"_5":13306,"_25509":51657,"_2665":51699},[],"`validity`",{"_3170":2016,"_28017":2001,"_19412":51701,"_5":13306,"_25509":51657,"_2665":51702},[],"Time from `thisUpdate` to `nextUpdate`.",{"_3170":2017,"_28017":2001,"_19412":51704,"_5":13306,"_25509":51657,"_2665":51705},[],"7 days.",{"_3170":2018,"_28017":2001,"_19412":51707,"_5":13306,"_25509":51657,"_2665":51708},[],"`refresh_interval`",{"_3170":2019,"_28017":2001,"_19412":51710,"_5":13306,"_25509":51657,"_2665":51711},[],"Time since publication that triggers scheduled renewal.",{"_3170":2020,"_28017":2001,"_19412":51713,"_5":13306,"_25509":51657,"_2665":51714},[],"6 days and 23 hours.",{"_3170":2021,"_28017":2001,"_19412":51716,"_5":13306,"_25509":51657,"_2665":51717},[],"`regenerate_on_revoke`",{"_3170":2022,"_28017":2001,"_19412":51719,"_5":13306,"_25509":51657,"_2665":51720},[],"Request regeneration on revocation or reactivation from `CertificateHold` events.",{"_3170":2023,"_28017":2001,"_19412":51722,"_5":13306,"_25509":51657,"_2665":51723},[],"`true`.",{"_3170":2024,"_28017":2001,"_19412":51725,"_5":13306,"_25509":51657,"_2665":51726},[],"`subject_key_id_signer`",{"_3170":2025,"_28017":2001,"_19412":51728,"_5":13306,"_25509":51657,"_2665":51729},[],"Configuration field initialized with the CA’s SKI.",{"_3170":2026,"_28017":2001,"_19412":51731,"_5":13306,"_25509":51657,"_2665":51732},[],"CA SKI.",{"_3170":2027,"_28017":2001,"_19412":51734,"_5":13306,"_25509":51657,"_2665":51735},[],"The generator uses the key of the CA identified by the requested SKI. Do not interpret `subject_key_id_signer` as verified support for a different delegated CA: changing that field does not change the signer in this flow.",{"_3170":2028,"_28017":2001,"_19412":51737,"_5":13306,"_25509":51657,"_2665":51738},[],"`latest_crl` contains version, validity start and end. Versions are kept as PEM in object storage at `pki/va/crl/{subject_key_id}/{version}.crl`; the public endpoint returns DER.",{"_3170":2029,"_28017":2001,"_19412":51740,"_5":13306,"_25509":51661,"_2665":51741},[],"The scheduled job requests another list when `refresh_interval` is reached or when the list approaches expiration within the configured watch period. This depends on working jobs, storage and signing; it does not guarantee renewal during a service failure.",{"_3170":2030,"_28017":2001,"_19412":51743,"_5":13306,"_25509":51661,"_2665":51744},[],"With `regenerate_on_revoke`, the event handler requests a new CRL upon revocation or reactivation from `CertificateHold` to `ACTIVE`. This happens after the status change and has its own failure paths. Confirming revocation does not establish that the new CRL is already published or that all clients have downloaded it.",{"_3170":2031,"_28017":2001,"_19412":51746,"_5":13306,"_25509":51661,"_2665":51747},[],"Compare CRL numbers and timestamps before and after a change. Monitor expired lists and generation failures; clients must apply policy when current evidence is unavailable.",{"_3170":2032,"_28017":2001,"_19412":51749,"_5":13306,"_25509":51665,"_2665":51750},[],"Each entry contains serial number, revocation time and reason. The generator queries certificates in `REVOKED` state for the selected CA. A reactivated certificate disappears when the list is recalculated; an earlier downloaded copy retains its contents.",{"_3170":2033,"_28017":2001,"_19412":51752,"_5":13306,"_25509":51665,"_2665":51753},[],"The list contains a critical *Issuing Distribution Point* (OID `2.5.29.28`) with configured distribution URLs. Check that your client interprets this extension and that it matches the list’s scope. If rejected, investigate format and scope; ignoring a critical extension is not successful validation.",{"_3170":2034,"_28017":2001,"_19412":51755,"_5":13306,"_25509":51669,"_2665":51756},[],"The VA service exposes `GET /crl/{subject_key_id}` without management authorization. Use the **issuing CA’s** SKI, not the end-entity certificate’s SKI or serial. First inspect the certificate’s CDP:",{"_3170":2035,"_28017":2001,"_19412":51758,"_5":13306,"_25509":51669,"_2665":51759},[],"Replace the following URL with the CDP URL and review exposure in Deployment:",{"_3170":2036,"_28017":2001,"_19412":51761,"_5":13306,"_25509":51669,"_2665":51762},[],"You need OpenSSL 3.x and `issuer.pem` containing the direct issuer’s certificate. Require a valid signature, current timestamps and the expected issuer. For a root that issues directly:",{"_3170":2037,"_28017":2001,"_19412":51764,"_5":13306,"_25509":51669,"_2665":51765},[],"`roots.pem` contains deliberately trusted roots. For intermediates, add `-untrusted intermediates.pem` before the `device.crt` argument. `-crl_check` checks the end-entity certificate’s revocation against the local list; it does not download other lists or establish the status of the whole chain. A complete chain check needs the corresponding CRLs and a policy requiring them.",{"_3170":2038,"_28017":2001,"_19412":51767,"_5":13306,"_25509":51669,"_2665":51768},[],"The test should accept an allowed certificate absent from the list and reject it with `certificate revoked` after publishing and using the list containing its serial.",{"_3170":2039,"_28017":2001,"_19412":51770,"_5":13306,"_25509":51673,"_2665":51771},[],"The following paths are relative to the VA service; confirm the public prefix in the Gateway. They are not the URLs of the public OCSP and CRL endpoints.",{"_3170":2040,"_28017":2001,"_19412":51773,"_5":13306,"_25509":51673,"_2665":48550},[],{"_3170":2041,"_28017":2001,"_19412":51775,"_5":13306,"_25509":51673,"_2665":51776},[],"Relative path",{"_3170":2042,"_28017":2001,"_19412":51778,"_5":13306,"_25509":51673,"_2665":48547},[],{"_3170":2043,"_28017":2001,"_19412":51780,"_5":13306,"_25509":51673,"_2665":51781},[],"`GET`",{"_3170":2044,"_28017":2001,"_19412":51783,"_5":13306,"_25509":51673,"_2665":51784},[],"`/v1/roles/{ca-ski}`",{"_3170":2045,"_28017":2001,"_19412":51786,"_5":13306,"_25509":51673,"_2665":51787},[],"Read `crl_options` and `latest_crl`.",{"_3170":2046,"_28017":2001,"_19412":51789,"_5":13306,"_25509":51673,"_2665":51790},[],"`PUT`",{"_3170":2047,"_28017":2001,"_19412":51792,"_5":13306,"_25509":51673,"_2665":51784},[],{"_3170":2048,"_28017":2001,"_19412":51794,"_5":13306,"_25509":51673,"_2665":51795},[],"Replace CRL configuration.",{"_3170":2049,"_28017":2001,"_19412":51797,"_5":13306,"_25509":51673,"_2665":51798},[],"You need authentication and role read or update permissions. Consult your installation’s API reference and Access control. Read current configuration before updating and send the full object expected by the contract: the backend replaces `crl_options`; it does not merge omitted fields.",{"_3170":2050,"_28017":2001,"_19412":51800,"_5":13306,"_25509":51673,"_2665":51801},[],"After a change, check saved configuration and the next list actually published. Updating the role alone does not establish regeneration or client acceptance.",{"_3170":2051,"_28017":2001,"_19412":51803,"_5":13306,"_25509":51677,"_2665":51804},[],"The CA view lets you inspect and download the available list. Compare version, issuer and timestamps with the copy downloaded from the public endpoint. Diagnose differences using PKI troubleshooting.",{"_3170":2052,"_28017":2001,"_19412":51806,"_5":13306,"_25509":51681,"_2665":51807},[],"RFC 5280: X.509 and CRL profile.",{"_3170":2053,"_28017":2001,"_19412":51809,"_5":13306,"_25509":51681,"_2665":51810},[],"OpenSSL: openssl-crl.",{"_3170":2054,"_28017":2001,"_19412":51812,"_5":13306,"_25509":51681,"_2665":51813},[],"OpenSSL: openssl-verify.",{"_3170":2055,"_28017":2001,"_19412":51815,"_5":13306,"_25509":51681,"_2665":51816},[],"<Card title=\"OCSP service\" href=\"/docs/platform/pki/ocsp\" />",{"_3170":2056,"_28017":2001,"_19412":51818,"_5":13306,"_25509":51681,"_2665":51819},[],"<Card title=\"Certificate validation\" href=\"/docs/platform/pki/certificate-validation\" />",{"_3170":2057,"_28017":2057,"_5":13637,"_2665":51821,"_28339":51822,"_19412":51823,"_25509":2057},"Keys and cryptographic engines",[45393,46786,50519,50520],[],{"_3170":2058,"_28017":2057,"_19412":51825,"_5":13306,"_25509":2057,"_2665":51826},[],"Generate, import and operate keys without coupling the PKI to a specific provider.",{"_3170":2059,"_28017":2057,"_5":28336,"_19412":51828,"_25509":51829,"_2665":51830},[],"/docs/platform/pki/key-management#what-the-kms-solves","What the KMS solves",{"_3170":2060,"_28017":2057,"_5":28336,"_19412":51832,"_25509":51833,"_2665":51834},[],"/docs/platform/pki/key-management#cryptographic-engines","Cryptographic engines",{"_3170":2061,"_28017":2057,"_5":28336,"_19412":51836,"_25509":51837,"_2665":51838},[],"/docs/platform/pki/key-management#file-system","File System",{"_3170":2062,"_28017":2057,"_5":28336,"_19412":51840,"_25509":51841,"_2665":51842},[],"/docs/platform/pki/key-management#hashicorp-vault","HashiCorp Vault",{"_3170":2063,"_28017":2057,"_5":28336,"_19412":51844,"_25509":51845,"_2665":51846},[],"/docs/platform/pki/key-management#aws-secrets-manager","AWS Secrets Manager",{"_3170":2064,"_28017":2057,"_5":28336,"_19412":51848,"_25509":51849,"_2665":51850},[],"/docs/platform/pki/key-management#aws-kms","AWS KMS",{"_3170":2065,"_28017":2057,"_5":28336,"_19412":51852,"_25509":51853,"_2665":51854},[],"/docs/platform/pki/key-management#pkcs11","PKCS#11",{"_3170":2066,"_28017":2057,"_5":28336,"_19412":51856,"_25509":51857,"_2665":51858},[],"/docs/platform/pki/key-management#azure-key-vault","Azure Key Vault",{"_3170":2067,"_28017":2057,"_5":28336,"_19412":51860,"_25509":51861,"_2665":51862},[],"/docs/platform/pki/key-management#key-inventory","Key inventory",{"_3170":2068,"_28017":2057,"_5":28336,"_19412":51864,"_25509":51865,"_2665":51866},[],"/docs/platform/pki/key-management#create-or-import-keys","Create or import keys",{"_3170":2069,"_28017":2057,"_5":28336,"_19412":51868,"_25509":51869,"_2665":51870},[],"/docs/platform/pki/key-management#generate-a-new-key-pair","Generate a new key pair",{"_3170":2070,"_28017":2057,"_5":28336,"_19412":51872,"_25509":51873,"_2665":51874},[],"/docs/platform/pki/key-management#import-an-existing-pair","Import an existing pair",{"_3170":2071,"_28017":2057,"_5":28336,"_19412":51876,"_25509":51877,"_2665":51878},[],"/docs/platform/pki/key-management#operations-on-a-key","Operations on a key",{"_3170":2072,"_28017":2057,"_5":28336,"_19412":51880,"_25509":51881,"_2665":51882},[],"/docs/platform/pki/key-management#view-details","View details",{"_3170":2073,"_28017":2057,"_5":28336,"_19412":51884,"_25509":51885,"_2665":51886},[],"/docs/platform/pki/key-management#sign-and-verify","Sign and verify",{"_3170":2074,"_28017":2057,"_5":28336,"_19412":51888,"_25509":51889,"_2665":51890},[],"/docs/platform/pki/key-management#sign","Sign",{"_3170":2075,"_28017":2057,"_5":28336,"_19412":51892,"_25509":51893,"_2665":51894},[],"/docs/platform/pki/key-management#verify","Verify",{"_3170":2076,"_28017":2057,"_5":28336,"_19412":51896,"_25509":51897,"_2665":51898},[],"/docs/platform/pki/key-management#generate-a-csr","Generate a CSR",{"_3170":2077,"_28017":2057,"_5":28336,"_19412":51900,"_25509":51901,"_2665":51902},[],"/docs/platform/pki/key-management#sign-locally-with-pkcs11","Sign locally with PKCS#11",{"_3170":2078,"_28017":2057,"_5":28336,"_19412":51904,"_25509":51905,"_2665":51906},[],"/docs/platform/pki/key-management#before-deleting-a-key","Before deleting a key",{"_3170":2079,"_28017":2057,"_19412":51908,"_5":13306,"_25509":2057,"_2665":51909},[],"The Cryptographic Key Management Service (KMS) of Lamassu IoT centralizes the generation, import, custody and use of the platform's keys. This is where you manage the keys that support the CAs and the rest of the signing operations that depend on the PKI.",{"_3170":2080,"_28017":2057,"_19412":51911,"_5":13306,"_25509":2057,"_2665":51912},[],"In the current configuration, Lamassu IoT works exclusively with asymmetric keys, such as RSA and elliptic curves. These keys are used to issue X.509 certificates, sign requests and perform authentication and validation operations within the system.",{"_3170":2081,"_28017":2057,"_19412":51914,"_5":13306,"_25509":51829,"_2665":51915},[],"The KMS unifies key lifecycle management and prevents every service from having to integrate directly with a specific cryptographic provider.",{"_3170":2082,"_28017":2057,"_19412":51917,"_5":13306,"_25509":51829,"_2665":51918},[],"In practice, it lets you:",{"_3170":2083,"_28017":2057,"_19412":51920,"_5":13306,"_25509":51829,"_2665":51921},[],"Generate new key pairs from Lamassu IoT.",{"_3170":2084,"_28017":2057,"_19412":51923,"_5":13306,"_25509":51829,"_2665":51924},[],"Import keys created externally.",{"_3170":2085,"_28017":2057,"_19412":51926,"_5":13306,"_25509":51829,"_2665":51927},[],"Delegate custody and cryptographic operations to external engines.",{"_3170":2086,"_28017":2057,"_19412":51929,"_5":13306,"_25509":51829,"_2665":51930},[],"Reuse existing keys for CAs, CSRs and signing or verification tasks.",{"_3170":2087,"_28017":2057,"_19412":51932,"_5":13306,"_25509":51833,"_2665":51933},[],"Lamassu can work with different cryptographic engines depending on deployment requirements. In some environments a software engine is enough; in others custody must be delegated to an HSM, a cloud service or a specialized platform.",{"_3170":2088,"_28017":2057,"_19412":51935,"_5":13306,"_25509":51833,"_2665":51936},[],"A single instance can have several engines configured at the same time, including multiple instances of the same type. This lets you adapt operations to different security, cost and regulatory requirements.",{"_3170":2089,"_28017":2057,"_19412":51938,"_5":13306,"_25509":51833,"_2665":51939},[],"This guide is for the PKI operator: select and use an already enabled engine. Installation, credentials, persistent storage and connectivity belong to Deployment. Before generating a CA, check the default engine, advertised algorithms and a test signature. Availability in your installation depends on its version and configuration.",{"_3170":2090,"_28017":2057,"_19412":51941,"_5":13306,"_25509":51837,"_2665":51942},[],"Generates software keys and stores private material in files. Custody depends on installation permissions, storage and backups. Before using it for an operational CA, agree how the key will be recovered and how replicas will access it; the KMS record does not replace those files.",{"_3170":2091,"_28017":2057,"_19412":51944,"_5":13306,"_25509":51841,"_2665":51945},[],"The adapter uses KV storage for private material. This is not signing within Vault Transit: someone able to read the secret can recover the key. Review read permissions, availability and recovery with the deployment owner.",{"_3170":2092,"_28017":2057,"_19412":51947,"_5":13306,"_25509":51841,"_2665":51948},[],"The adapter reaches Vault over its configured HTTP(S) endpoint. The Vault server certificate is verified against the system trust store; a Vault signed by a private CA is trusted by adding its CA certificate to the engine's `ca_cert_file` (PEM-encoded). `insecure_skip_verify=true` disables verification and is a last resort; agree the transport settings with the deployment owner.",{"_3170":2093,"_28017":2057,"_19412":51950,"_5":13306,"_25509":51845,"_2665":51951},[],"Offers encrypted persistence in AWS at a cost. It protects the key at rest, but an authorized administrator can recover it; it does not provide the same extraction resistance as a KMS or HSM.",{"_3170":2094,"_28017":2057,"_19412":51953,"_5":13306,"_25509":51849,"_2665":51954},[],"Delegates signing to AWS KMS. The adapter also implements external material import, subject to provider capabilities and permissions. A key generated outside the service has already existed outside its custody; importing it does not remove those copies. Check generation, import and signing as separate operations.",{"_3170":2095,"_28017":2057,"_19412":51956,"_5":13306,"_25509":51853,"_2665":51957},[],"Allows integrating local HSMs, isolated environments and *Key as a Service* offerings. Generation, persistence and extraction resistance depend on the specific device or provider. It is the most flexible option when policy requires hardware custody.",{"_3170":2096,"_28017":2057,"_19412":51959,"_5":13306,"_25509":51857,"_2665":51960},[],"The backend also provides adapters for **Key Vault Keys** and **Key Vault Secrets**. The former delegates signing to the key service; the latter stores private material as secrets and signs using that material. These are different custody models. Confirm which adapter is enabled in your installation and test the required operations.",{"_3170":2097,"_28017":2057,"_19412":51962,"_5":13306,"_25509":51857,"_2665":51963},[],"Lamassu shows the enabled engines in the console.",{"_3170":2098,"_28017":2057,"_19412":51965,"_5":13306,"_25509":51857,"_2665":51966},[],"Each engine defines which algorithms it supports, such as RSA or ECC/ECDSA, and which key sizes it can generate.",{"_3170":2099,"_28017":2057,"_19412":51968,"_5":13306,"_25509":51857,"_2665":51969},[],"Confirm with the deployment operator which engine is configured as the default. That engine will be used when a process needs to create or persist a key and the user has not selected a specific one, for example when creating or importing a CA.",{"_3170":2100,"_28017":2057,"_19412":51971,"_5":13306,"_25509":51861,"_2665":51972},[],"The main KMS screen shows the complete inventory of keys registered in the system. It is the reference view for reviewing which keys exist, where they are kept and which entities they relate to.",{"_3170":2101,"_28017":2057,"_19412":51974,"_5":13306,"_25509":51861,"_2665":51975},[],"The table includes the following fields:",{"_3170":2102,"_28017":2057,"_19412":51977,"_5":13306,"_25509":51861,"_2665":51978},[],"**Name**: descriptive name of the key.",{"_3170":2103,"_28017":2057,"_19412":51980,"_5":13306,"_25509":51861,"_2665":51981},[],"**Type**: algorithm and key size, for example RSA 2048 or EC P-256.",{"_3170":2104,"_28017":2057,"_19412":51983,"_5":13306,"_25509":51861,"_2665":51984},[],"**Strength**: visual indicator of cryptographic strength.",{"_3170":2105,"_28017":2057,"_19412":51986,"_5":13306,"_25509":51861,"_2665":51987},[],"**Public/Private**: whether Lamassu manages the full pair or only the public key.",{"_3170":2106,"_28017":2057,"_19412":51989,"_5":13306,"_25509":51861,"_2665":51990},[],"**Crypto Engine**: cryptographic engine keeping the key.",{"_3170":2107,"_28017":2057,"_19412":51992,"_5":13306,"_25509":51861,"_2665":51993},[],"**Aliases**: alternative names associated with the key.",{"_3170":2108,"_28017":2057,"_19412":51995,"_5":13306,"_25509":51861,"_2665":51996},[],"**Tags**: labels for classification and search.",{"_3170":2109,"_28017":2057,"_19412":51998,"_5":13306,"_25509":51861,"_2665":51999},[],"**Related Entities**: certificates or other entities linked to that key.",{"_3170":2110,"_28017":2057,"_19412":52001,"_5":13306,"_25509":51861,"_2665":52002},[],"From this view you also reach the most common actions:",{"_3170":2111,"_28017":2057,"_19412":52004,"_5":13306,"_25509":51861,"_2665":52005},[],"**View Details** to inspect metadata, identifiers and relationships.",{"_3170":2112,"_28017":2057,"_19412":52007,"_5":13306,"_25509":51861,"_2665":52008},[],"**Generate CSR** to create a PKCS#10 request with the selected key.",{"_3170":2113,"_28017":2057,"_19412":52010,"_5":13306,"_25509":51861,"_2665":52011},[],"**Sign / Verify** to test cryptographic operations on the key.",{"_3170":2114,"_28017":2057,"_19412":52013,"_5":13306,"_25509":51861,"_2665":52014},[],"**Delete Key** to remove the key from the system.",{"_3170":2115,"_28017":2057,"_19412":52016,"_5":13306,"_25509":51865,"_2665":52017},[],"You need key administration permissions and a reachable engine. The issuance profile must allow the chosen algorithm if the key will be used in a CA or CSR. Open **Create New Key** and choose generation or import.",{"_3170":2116,"_28017":2057,"_19412":52019,"_5":13306,"_25509":51869,"_2665":52020},[],"If the key will be born inside Lamassu, the recommended flow is to generate a new pair managed directly by one of the configured engines.",{"_3170":2117,"_28017":2057,"_19412":52022,"_5":13306,"_25509":51869,"_2665":52023},[],"On the wizard's first screen, choose **Generate New Key Pair** and then define the main parameters:",{"_3170":2118,"_28017":2057,"_19412":52025,"_5":13306,"_25509":51869,"_2665":52026},[],"**Key Name**: unique and descriptive name.",{"_3170":2119,"_28017":2057,"_19412":52028,"_5":13306,"_25509":51869,"_2665":52029},[],"**Crypto Engine**: engine that will keep the key.",{"_3170":2120,"_28017":2057,"_19412":52031,"_5":13306,"_25509":51869,"_2665":52032},[],"**Key Type** and **Key Size**: algorithm and size or curve.",{"_3170":2121,"_28017":2057,"_19412":52034,"_5":13306,"_25509":51869,"_2665":52035},[],"**Tags**: metadata to classify the key.",{"_3170":2122,"_28017":2057,"_19412":52037,"_5":13306,"_25509":51869,"_2665":52038},[],"**Metadata**: additional information for advanced uses.",{"_3170":2123,"_28017":2057,"_19412":52040,"_5":13306,"_25509":51873,"_2665":52041},[],"Importing lets you register in Lamassu a key generated outside the platform. It is the usual flow in BYOK scenarios, migrations or integration with cryptographic material already in production.",{"_3170":2124,"_28017":2057,"_19412":52043,"_5":13306,"_25509":51873,"_2665":52044},[],"When you have an exportable private key and the destination engine supports import.",{"_3170":2125,"_28017":2057,"_19412":52046,"_5":13306,"_25509":51873,"_2665":52047},[],"When an existing PKI needs to be migrated without reissuing certificates.",{"_3170":2126,"_28017":2057,"_19412":52049,"_5":13306,"_25509":51873,"_2665":52050},[],"When Lamassu must operate with a root of trust created by a third party.",{"_3170":2127,"_28017":2057,"_19412":52052,"_5":13306,"_25509":51873,"_2665":52053},[],"In the wizard, choose **Import Existing Key Pair** and complete the requested fields:",{"_3170":2128,"_28017":2057,"_19412":52055,"_5":13306,"_25509":51873,"_2665":52056},[],"**Key Name**: descriptive name within Lamassu IoT.",{"_3170":2129,"_28017":2057,"_19412":52058,"_5":13306,"_25509":51873,"_2665":52059},[],"**Crypto Engine**: engine that will keep the imported key.",{"_3170":2130,"_28017":2057,"_19412":52061,"_5":13306,"_25509":51873,"_2665":52062},[],"**Tags**: labels for organization and search.",{"_3170":2131,"_28017":2057,"_19412":52064,"_5":13306,"_25509":51873,"_2665":52065},[],"**Metadata**: additional optional information.",{"_3170":2132,"_28017":2057,"_19412":52067,"_5":13306,"_25509":51873,"_2665":52068},[],"**Private Key (PEM)**: private key in PEM format.",{"_3170":2133,"_28017":2057,"_19412":52070,"_5":13306,"_25509":51873,"_2665":52071},[],"After a successful import, open the record, check the engine and public key, and perform a test signature. A non-exportable HSM key cannot be uploaded through this PEM form: configure engine access and check how the existing key is registered. Review dependencies and any provider resources already created if an operation fails partway through.",{"_3170":2134,"_28017":2057,"_19412":52073,"_5":13306,"_25509":51877,"_2665":52074},[],"Each registered key has a detail view and several operational actions.",{"_3170":2135,"_28017":2057,"_19412":52076,"_5":13306,"_25509":51881,"_2665":52077},[],"The **View Details** screen concentrates the technical and administrative information of the key.",{"_3170":2136,"_28017":2057,"_19412":52079,"_5":13306,"_25509":51881,"_2665":52080},[],"The **Overview** tab shows, among others, these fields:",{"_3170":2137,"_28017":2057,"_19412":52082,"_5":13306,"_25509":51881,"_2665":52083},[],"**Key Name**: descriptive name.",{"_3170":2138,"_28017":2057,"_19412":52085,"_5":13306,"_25509":51881,"_2665":52086},[],"**Key Identifier**: unique system identifier. Lamassu uses PKCS11-based ID formats.",{"_3170":2139,"_28017":2057,"_19412":52088,"_5":13306,"_25509":51881,"_2665":52089},[],"**Tags**: associated labels.",{"_3170":2140,"_28017":2057,"_19412":52091,"_5":13306,"_25509":51881,"_2665":52092},[],"**Aliases**: alternative names.",{"_3170":2141,"_28017":2057,"_19412":52094,"_5":13306,"_25509":51881,"_2665":52095},[],"**Crypto Engine**: engine where the key resides.",{"_3170":2142,"_28017":2057,"_19412":52097,"_5":13306,"_25509":51881,"_2665":52098},[],"**Algorithm, Key Size & Strength**: algorithm, parameters and strength level.",{"_3170":2143,"_28017":2057,"_19412":52100,"_5":13306,"_25509":51881,"_2665":52101},[],"The **Related Entities** section shows which Lamassu objects depend on that key.",{"_3170":2144,"_28017":2057,"_19412":52103,"_5":13306,"_25509":51881,"_2665":52104},[],"The **Public Key** tab shows public material in PEM. The record’s identifier and URI locate the key; a PKCS#11-formatted URI does not establish that the engine is an HSM or that a local module can access it.",{"_3170":2145,"_28017":2057,"_19412":52106,"_5":13306,"_25509":51885,"_2665":52107},[],"The **Sign / Verify** action validates that the key and the cryptographic engine work correctly.",{"_3170":2146,"_28017":2057,"_19412":52109,"_5":13306,"_25509":51885,"_2665":52110},[],"Sign a test message, save the signature and verify it using the same public key, algorithm and encoding. Then change the message: verification should fail. This tests one operation; it does not establish every engine capability or a CA’s chain.",{"_3170":2147,"_28017":2057,"_19412":52112,"_5":13306,"_25509":51885,"_2665":52113},[],"When you open it, two areas appear: **Sign** and **Verify**.",{"_3170":2148,"_28017":2057,"_19412":52115,"_5":13306,"_25509":51889,"_2665":52116},[],"This tab uses the private key to generate a digital signature over a message or an already computed *digest*.",{"_3170":2149,"_28017":2057,"_19412":52118,"_5":13306,"_25509":51889,"_2665":52119},[],"Main fields:",{"_3170":2150,"_28017":2057,"_19412":52121,"_5":13306,"_25509":51889,"_2665":52122},[],"**Algorithm**: signing algorithm available for the key type.",{"_3170":2151,"_28017":2057,"_19412":52124,"_5":13306,"_25509":51889,"_2665":52125},[],"**Message Type**: `Raw` for clear data or `Digest` for a precomputed hash.",{"_3170":2152,"_28017":2057,"_19412":52127,"_5":13306,"_25509":51889,"_2665":52128},[],"**Payload Encoding**: input encoding, such as UTF-8, Hex or Base64.",{"_3170":2153,"_28017":2057,"_19412":52130,"_5":13306,"_25509":51889,"_2665":52131},[],"**Message**: content to sign.",{"_3170":2154,"_28017":2057,"_19412":52133,"_5":13306,"_25509":51889,"_2665":52134},[],"**Signature**: result of the operation, shown in hexadecimal.",{"_3170":2155,"_28017":2057,"_19412":52136,"_5":13306,"_25509":51893,"_2665":52137},[],"This tab checks whether a signature corresponds to the associated public key.",{"_3170":2156,"_28017":2057,"_19412":52139,"_5":13306,"_25509":51893,"_2665":52119},[],{"_3170":2157,"_28017":2057,"_19412":52141,"_5":13306,"_25509":51893,"_2665":52142},[],"**Algorithm**: must match the algorithm used for the signature.",{"_3170":2158,"_28017":2057,"_19412":52144,"_5":13306,"_25509":51893,"_2665":52145},[],"**Message Type**: `Raw` or `Digest`.",{"_3170":2159,"_28017":2057,"_19412":52147,"_5":13306,"_25509":51893,"_2665":52148},[],"**Payload Encoding**: encoding of the message.",{"_3170":2160,"_28017":2057,"_19412":52150,"_5":13306,"_25509":51893,"_2665":52151},[],"**Message**: original message or hash.",{"_3170":2161,"_28017":2057,"_19412":52153,"_5":13306,"_25509":51893,"_2665":52154},[],"**Signature**: signature to check.",{"_3170":2162,"_28017":2057,"_19412":52156,"_5":13306,"_25509":51893,"_2665":52157},[],"**Result**: indicator of the validation result.",{"_3170":2163,"_28017":2057,"_19412":52159,"_5":13306,"_25509":51897,"_2665":52160},[],"The **Generate CSR** action creates a PKCS#10 request signed with the private key kept in Lamassu, without exposing it outside the cryptographic engine.",{"_3170":2164,"_28017":2057,"_19412":52162,"_5":13306,"_25509":51897,"_2665":52163},[],"This flow is useful for:",{"_3170":2165,"_28017":2057,"_19412":52165,"_5":13306,"_25509":51897,"_2665":52166},[],"Requesting certificates from an external CA.",{"_3170":2166,"_28017":2057,"_19412":52168,"_5":13306,"_25509":51897,"_2665":52169},[],"Renewing an identity while keeping the same key.",{"_3170":2167,"_28017":2057,"_19412":52171,"_5":13306,"_25509":51897,"_2665":52172},[],"When you open the form, it asks for the subject data and the main certificate attributes:",{"_3170":2168,"_28017":2057,"_19412":52174,"_5":13306,"_25509":51897,"_2665":52175},[],"**Common Name (CN)**: main name of the identity.",{"_3170":2169,"_28017":2057,"_19412":52177,"_5":13306,"_25509":51897,"_2665":52178},[],"**Organization (O)**: organization or company.",{"_3170":2170,"_28017":2057,"_19412":52180,"_5":13306,"_25509":51897,"_2665":52181},[],"**Organizational Unit (OU)**: department or unit.",{"_3170":2171,"_28017":2057,"_19412":52183,"_5":13306,"_25509":51897,"_2665":52184},[],"**Country (C)**: two-letter country code.",{"_3170":2172,"_28017":2057,"_19412":52186,"_5":13306,"_25509":51897,"_2665":52187},[],"**State / Province (ST)**: state or province.",{"_3170":2173,"_28017":2057,"_19412":52189,"_5":13306,"_25509":51897,"_2665":52190},[],"**Locality (L)**: city or locality.",{"_3170":2174,"_28017":2057,"_19412":52192,"_5":13306,"_25509":51897,"_2665":52193},[],"**Email Address**: contact email.",{"_3170":2175,"_28017":2057,"_19412":52195,"_5":13306,"_25509":51897,"_2665":52196},[],"**Subject Alternative Names (SANs)**: alternative names or identifiers, such as DNS or IP.",{"_3170":2176,"_28017":2057,"_19412":52198,"_5":13306,"_25509":51897,"_2665":52199},[],"Download the CSR and run `openssl req -in request.csr -noout -verify -text`. Check signature, subject and SAN before sending it. A CSR does not determine the final certificate by itself: issuance policy can replace its fields.",{"_3170":2177,"_28017":2057,"_19412":52201,"_5":13306,"_25509":51901,"_2665":52202},[],"Lamassu also offers specific help for local integrations through **Sign locally with OpenSSL & PKCS11 tools**.",{"_3170":2178,"_28017":2057,"_19412":52204,"_5":13306,"_25509":51901,"_2665":52205},[],"Requiere el módulo, token y permisos del proveedor correspondiente. Comprueba que el identificador de Lamassu se corresponde con el objeto accesible desde ese módulo. La configuración del módulo pertenece al entorno del cliente o al Despliegue.",{"_3170":2179,"_28017":2057,"_19412":52207,"_5":13306,"_25509":51905,"_2665":52208},[],"Review **Related Entities** and locate CAs, certificates and validation processes that still need signatures. Revoking a CA does not remove the need to publish status during its retention period. Deleting a key does not automatically revoke its certificates either. Plan replacement and retention before using **Delete Key**; provider deletion behavior depends on the engine.",{"_3170":2180,"_28017":2180,"_5":13637,"_2665":52210,"_28339":52211,"_19412":52212,"_25509":2180},"Online validation with OCSP",[45393,46786,50519,51136],[],{"_3170":2181,"_28017":2180,"_19412":52214,"_5":13306,"_25509":2180,"_2665":52215},[],"Query signed status and verify the responder’s response.",{"_3170":2182,"_28017":2180,"_5":28336,"_19412":52217,"_25509":52218,"_2665":52219},[],"/docs/platform/pki/ocsp#how-the-responder-works-in-lamassu","How the responder works in Lamassu",{"_3170":2183,"_28017":2180,"_5":28336,"_19412":52221,"_25509":52222,"_2665":52223},[],"/docs/platform/pki/ocsp#embedding-in-issued-certificates","Embedding in issued certificates",{"_3170":2184,"_28017":2180,"_5":28336,"_19412":52225,"_25509":52226,"_2665":52227},[],"/docs/platform/pki/ocsp#http-endpoints","HTTP endpoints",{"_3170":2185,"_28017":2180,"_5":28336,"_19412":52229,"_25509":52230,"_2665":52231},[],"/docs/platform/pki/ocsp#generate-and-verify-a-query","Generate and verify a query",{"_3170":2186,"_28017":2180,"_5":28336,"_19412":52233,"_25509":52234,"_2665":52235},[],"/docs/platform/pki/ocsp#check-from-the-interface","Check from the interface",{"_3170":2187,"_28017":2180,"_5":28336,"_19412":52237,"_25509":52238,"_2665":51682},[],"/docs/platform/pki/ocsp#references",{"_3170":2188,"_28017":2180,"_19412":52240,"_5":13306,"_25509":2180,"_2665":52241},[],"OCSP queries a certificate’s status and returns a signed response. This guide is for an integrator checking what Lamassu publishes and how the consumer must verify it. For complete identity validation, follow Certificate validation.",{"_3170":2189,"_28017":2180,"_19412":52243,"_5":13306,"_25509":52218,"_2665":52244},[],"The responder retrieves the certificate by serial number and locates its issuing CA in the inventory. It translates persisted status as follows:",{"_3170":2190,"_28017":2180,"_19412":52246,"_5":13306,"_25509":52218,"_2665":52247},[],"Record status",{"_3170":2191,"_28017":2180,"_19412":52249,"_5":13306,"_25509":52218,"_2665":52250},[],"Signed response",{"_3170":2192,"_28017":2180,"_19412":52252,"_5":13306,"_25509":52218,"_2665":49697},[],{"_3170":2193,"_28017":2180,"_19412":52254,"_5":13306,"_25509":52218,"_2665":52255},[],"`Good`.",{"_3170":2194,"_28017":2180,"_19412":52257,"_5":13306,"_25509":52218,"_2665":49714},[],{"_3170":2195,"_28017":2180,"_19412":52259,"_5":13306,"_25509":52218,"_2665":52260},[],"`Revoked`, with revocation reason and timestamp.",{"_3170":2196,"_28017":2180,"_19412":52262,"_5":13306,"_25509":52218,"_2665":52263},[],"Other states, including `INACTIVE` and `EXPIRED`",{"_3170":2197,"_28017":2180,"_19412":52265,"_5":13306,"_25509":52218,"_2665":52266},[],"`Unknown` if the certificate and issuer can be retrieved.",{"_3170":2198,"_28017":2180,"_19412":52268,"_5":13306,"_25509":52218,"_2665":52269},[],"An absent serial number causes a lookup error; it does not guarantee a signed `Unknown` response. Lookup or signing errors produce an HTTP failure. Treat that as unavailable evidence according to consumer policy.",{"_3170":2199,"_28017":2180,"_19412":52271,"_5":13306,"_25509":52218,"_2665":52272},[],"The issuing CA itself signs the response through its KMS-associated key. A delegated OCSP signing certificate is not used. An imported CA without a usable key cannot sign responses.",{"_3170":2200,"_28017":2180,"_19412":52274,"_5":13306,"_25509":52218,"_2665":52275},[],"The implementation sets `thisUpdate` approximately one day before response generation and `nextUpdate` one day after: the declared window is about 48 hours. Inspect received values and apply your freshness policy. The response reflects stored status when queried; a previously cached copy does not change upon revocation.",{"_3170":2201,"_28017":2180,"_19412":52277,"_5":13306,"_25509":52222,"_2665":52278},[],"The signer constructs OCSP URLs from configured VA domains and adds them to AIA. Without domains, there is no URL to add; an imported certificate retains its original extensions. Inspect the actual certificate:",{"_3170":2202,"_28017":2180,"_19412":52280,"_5":13306,"_25509":52222,"_2665":52281},[],"Check that the consumer can reach this URL. DNS, endpoint exposure and domain configuration belong to Deployment. Changing configuration does not modify already signed certificates.",{"_3170":2203,"_28017":2180,"_19412":52283,"_5":13306,"_25509":52226,"_2665":52284},[],"The service accepts:",{"_3170":2204,"_28017":2180,"_19412":52286,"_5":13306,"_25509":52226,"_2665":48550},[],{"_3170":2205,"_28017":2180,"_19412":52288,"_5":13306,"_25509":52226,"_2665":52289},[],"VA service path",{"_3170":2206,"_28017":2180,"_19412":52291,"_5":13306,"_25509":52226,"_2665":52292},[],"Format",{"_3170":2207,"_28017":2180,"_19412":52294,"_5":13306,"_25509":52226,"_2665":52295},[],"`POST`",{"_3170":2208,"_28017":2180,"_19412":52297,"_5":13306,"_25509":52226,"_2665":52298},[],"`/ocsp`",{"_3170":2209,"_28017":2180,"_19412":52300,"_5":13306,"_25509":52226,"_2665":52301},[],"DER request, `Content-Type: application/ocsp-request`.",{"_3170":2210,"_28017":2180,"_19412":52303,"_5":13306,"_25509":52226,"_2665":51781},[],{"_3170":2211,"_28017":2180,"_19412":52305,"_5":13306,"_25509":52226,"_2665":52306},[],"`/ocsp/{ocsp_request}`",{"_3170":2212,"_28017":2180,"_19412":52308,"_5":13306,"_25509":52226,"_2665":52309},[],"DER request encoded using padded URL Base64.",{"_3170":2213,"_28017":2180,"_19412":52311,"_5":13306,"_25509":52226,"_2665":52312},[],"Use POST to avoid client encoding differences. A successful response has `Content-Type: application/ocsp-response` and a DER body. The public prefix depends on the Gateway; use the URL published in the certificate and checked by the operator.",{"_3170":2214,"_28017":2180,"_19412":52314,"_5":13306,"_25509":52230,"_2665":52315},[],"You need OpenSSL 3.x, `device.crt`, its direct issuer’s certificate `issuer.pem` and the consumer’s trusted roots in `roots.pem`. For an intermediate issuer, also prepare `intermediates.pem` containing the intermediate CAs.",{"_3170":2215,"_28017":2180,"_19412":52317,"_5":13306,"_25509":52230,"_2665":52318},[],"Generate the request:",{"_3170":2216,"_28017":2180,"_19412":52320,"_5":13306,"_25509":52230,"_2665":52321},[],"This example omits the nonce because the responder does not echo it. Verification relies on signature, response correspondence and timestamps; it does not demonstrate freshness through a nonce.",{"_3170":2217,"_28017":2180,"_19412":52323,"_5":13306,"_25509":52230,"_2665":52324},[],"Replace the example URL with the inspected endpoint:",{"_3170":2218,"_28017":2180,"_19412":52326,"_5":13306,"_25509":52230,"_2665":52327},[],"Verify the returned DER:",{"_3170":2219,"_28017":2180,"_19412":52329,"_5":13306,"_25509":52230,"_2665":52330},[],"For intermediates, add `-verify_other intermediates.pem`. Require successful response verification and inspect the status corresponding to `device.crt`, issuer, serial, `thisUpdate` and `nextUpdate`. `Response verify OK` validates the response only: also observe `good`, `revoked` or `unknown`. Do not accept an identity based only on the command’s exit code.",{"_3170":2220,"_28017":2180,"_19412":52332,"_5":13306,"_25509":52234,"_2665":52333},[],"**OCSP Check** shows what Lamassu returns for a selected certificate. Complete the check from the consumer’s network and trust store: a console query does not establish its validation configuration.",{"_3170":2221,"_28017":2180,"_19412":52335,"_5":13306,"_25509":52234,"_2665":52336},[],"To check a change, save an earlier response, revoke a test certificate and request another response. The new query should reflect persisted status; compare timestamps to rule out reuse of an earlier response. If it fails, follow PKI troubleshooting.",{"_3170":2222,"_28017":2180,"_19412":52338,"_5":13306,"_25509":52238,"_2665":52339},[],"RFC 6960: OCSP.",{"_3170":2223,"_28017":2180,"_19412":52341,"_5":13306,"_25509":52238,"_2665":52342},[],"OpenSSL: openssl-ocsp.",{"_3170":2224,"_28017":2180,"_19412":52344,"_5":13306,"_25509":52238,"_2665":52345},[],"<Card title=\"CRL service\" href=\"/docs/platform/pki/crl\" />",{"_3170":2225,"_28017":2180,"_19412":52347,"_5":13306,"_25509":52238,"_2665":51819},[],{"_3170":2226,"_28017":2226,"_5":13637,"_2665":50519,"_28339":52349,"_19412":52350,"_25509":2226},[45393,46786,50519],[],{"_3170":2227,"_28017":2226,"_19412":52352,"_5":13306,"_25509":2226,"_2665":52353},[],"Administer keys and authorities, define issuance and verify the resulting certificates.",{"_3170":2228,"_28017":2226,"_5":28336,"_19412":52355,"_25509":52356,"_2665":49829},[],"/docs/platform/pki/overview#start-here",{"_3170":2229,"_28017":2226,"_5":28336,"_19412":52358,"_25509":52359,"_2665":52360},[],"/docs/platform/pki/overview#what-you-need","What you need",{"_3170":2230,"_28017":2226,"_5":28336,"_19412":52362,"_25509":52363,"_2665":50363},[],"/docs/platform/pki/overview#core-capabilities",{"_3170":2231,"_28017":2226,"_5":28336,"_19412":52365,"_25509":52366,"_2665":50367},[],"/docs/platform/pki/overview#build-your-trust-hierarchy",{"_3170":2232,"_28017":2226,"_5":28336,"_19412":52368,"_25509":52369,"_2665":50371},[],"/docs/platform/pki/overview#protect-cryptographic-keys",{"_3170":2233,"_28017":2226,"_5":28336,"_19412":52371,"_25509":52372,"_2665":50375},[],"/docs/platform/pki/overview#issue-and-control-certificates",{"_3170":2234,"_28017":2226,"_5":28336,"_19412":52374,"_25509":52375,"_2665":50383},[],"/docs/platform/pki/overview#publish-validation-status",{"_3170":2235,"_28017":2226,"_5":28336,"_19412":52377,"_25509":52378,"_2665":52379},[],"/docs/platform/pki/overview#how-to-check-the-result","How to check the result",{"_3170":2236,"_28017":2226,"_5":28336,"_19412":52381,"_25509":52382,"_2665":51303},[],"/docs/platform/pki/overview#continue",{"_3170":2237,"_28017":2226,"_19412":52384,"_5":13306,"_25509":2226,"_2665":52385},[],"The PKI section explains how to build and operate X.509 trust in Lamassu: which authorities issue, which rules apply and how to check certificates. It is intended for PKI administrators and anyone who needs to use certificates in a consuming system.",{"_3170":2238,"_28017":2226,"_19412":52387,"_5":13306,"_25509":52356,"_2665":52388},[],"Follow PKI getting started to create a CA, issue a client certificate and verify it with OpenSSL. The result is a certificate, its private key and a verified chain.",{"_3170":2239,"_28017":2226,"_19412":52390,"_5":13306,"_25509":52356,"_2665":52391},[],"You can complete that path before managing devices. When you need to associate the identity with an inventory or automate its enrollment, continue in IoT Fleets.",{"_3170":2240,"_28017":2226,"_19412":52393,"_5":13306,"_25509":52359,"_2665":52394},[],"An accessible instance and permission to manage the keys, CAs and certificates you will use.",{"_3170":2241,"_28017":2226,"_19412":52396,"_5":13306,"_25509":52359,"_2665":52397},[],"An available cryptographic engine to keep the authority's key.",{"_3170":2242,"_28017":2226,"_19412":52399,"_5":13306,"_25509":52359,"_2665":52400},[],"The certificate's purpose, such as authenticating a client through mTLS.",{"_3170":2243,"_28017":2226,"_19412":52402,"_5":13306,"_25509":52359,"_2665":52403},[],"Consumer requirements: accepted issuers, algorithms, names and permitted usages.",{"_3170":2244,"_28017":2226,"_19412":52405,"_5":13306,"_25509":52359,"_2665":52406},[],"Prepare the instance and cryptographic provider in Deployment. The trust model explains hierarchy choices.",{"_3170":2245,"_28017":2226,"_19412":52408,"_5":13306,"_25509":52366,"_2665":52409},[],"Authorities sign certificates. A root establishes the trust anchor, and an intermediate separates issuance by environment or purpose. Hierarchy and rotation explains how to maintain trust when replacing an authority.",{"_3170":2246,"_28017":2226,"_19412":52411,"_5":13306,"_25509":52369,"_2665":52412},[],"CA signing keys are managed through KMS and cryptographic engines. A client that generates a CSR can keep its own key: preserve that custody when choosing the issuance method.",{"_3170":2247,"_28017":2226,"_19412":52414,"_5":13306,"_25509":52372,"_2665":52415},[],"A profile establishes subject, validity, usage and key restrictions. The CA applies issuance configuration and signs the certificate. In the inventory, you can inspect the result, download it and manage its status.",{"_3170":2248,"_28017":2226,"_19412":52417,"_5":13306,"_25509":52375,"_2665":52418},[],"Validation covers the chain, validity, usages and revocation status. Lamassu publishes status through OCSP and CRL; the consumer configures which issuers it recognizes and how it checks that status.",{"_3170":2249,"_28017":2226,"_19412":52420,"_5":13306,"_25509":52378,"_2665":52421},[],"An active certificate in the console is one part of the check. Also verify that:",{"_3170":2250,"_28017":2226,"_19412":52423,"_5":13306,"_25509":52378,"_2665":52424},[],"its subject and extensions identify the expected client;",{"_3170":2251,"_28017":2226,"_19412":52426,"_5":13306,"_25509":52378,"_2665":52427},[],"its public key matches the client's private key;",{"_3170":2252,"_28017":2226,"_19412":52429,"_5":13306,"_25509":52378,"_2665":52430},[],"its chain reaches a root trusted by the consumer;",{"_3170":2253,"_28017":2226,"_19412":52432,"_5":13306,"_25509":52378,"_2665":52433},[],"its dates and usages allow the operation;",{"_3170":2254,"_28017":2226,"_19412":52435,"_5":13306,"_25509":52378,"_2665":52436},[],"the consumer applies revocation checks and authorization.",{"_3170":2255,"_28017":2226,"_19412":52438,"_5":13306,"_25509":52378,"_2665":52439},[],"The issuance path includes the first independent checks.",{"_3170":2256,"_28017":2226,"_19412":52441,"_5":13306,"_25509":52382,"_2665":52442},[],"<Card title=\"PKI getting started\" description=\"Create a CA, then issue and verify a client certificate.\" href=\"/docs/platform/pki/quickstarts/overview\" />",{"_3170":2257,"_28017":2226,"_19412":52444,"_5":13306,"_25509":52382,"_2665":52445},[],"<Card title=\"Apply PKI to devices\" description=\"Associate certificates with inventory and prepare enrollment.\" href=\"/docs/platform/iot-fleets/overview\" />",{"_3170":2258,"_28017":2226,"_19412":52447,"_5":13306,"_25509":52382,"_2665":52448},[],"<Card title=\"PKI diagnostics\" description=\"Check issuance, OCSP and CRL when the result fails.\" href=\"/docs/platform/pki/troubleshooting\" />",{"_3170":2259,"_28017":2259,"_5":13637,"_2665":52450,"_28339":52451,"_19412":52452,"_25509":2259},"Create your first CA",[45393,46786,50519,49954],[],{"_3170":2260,"_28017":2259,"_19412":52454,"_5":13306,"_25509":2259,"_2665":52455},[],"Create an evaluation root and check its certificate before issuing.",{"_3170":2261,"_28017":2259,"_5":28336,"_19412":52457,"_25509":52458,"_2665":45403},[],"/docs/platform/pki/quickstarts/create-certificate-authority#before-you-begin",{"_3170":2262,"_28017":2259,"_5":28336,"_19412":52460,"_25509":52461,"_2665":52462},[],"/docs/platform/pki/quickstarts/create-certificate-authority#open-the-creation-wizard","Open the creation wizard",{"_3170":2263,"_28017":2259,"_5":28336,"_19412":52464,"_25509":52465,"_2665":52466},[],"/docs/platform/pki/quickstarts/create-certificate-authority#select-the-key","Select the key",{"_3170":2264,"_28017":2259,"_5":28336,"_19412":52468,"_25509":52469,"_2665":52470},[],"/docs/platform/pki/quickstarts/create-certificate-authority#define-the-authority","Define the authority",{"_3170":2265,"_28017":2259,"_5":28336,"_19412":52472,"_25509":52473,"_2665":52474},[],"/docs/platform/pki/quickstarts/create-certificate-authority#review-and-create-the-ca","Review and create the CA",{"_3170":2266,"_28017":2259,"_5":28336,"_19412":52476,"_25509":52477,"_2665":52478},[],"/docs/platform/pki/quickstarts/create-certificate-authority#verify-the-result","Verify the result",{"_3170":2267,"_28017":2259,"_5":28336,"_19412":52480,"_25509":52481,"_2665":52482},[],"/docs/platform/pki/quickstarts/create-certificate-authority#check-the-ca-certificate","Check the CA certificate",{"_3170":2268,"_28017":2259,"_5":28336,"_19412":52484,"_25509":52485,"_2665":50212},[],"/docs/platform/pki/quickstarts/create-certificate-authority#if-the-result-fails",{"_3170":2269,"_28017":2259,"_5":28336,"_19412":52487,"_25509":52488,"_2665":45427},[],"/docs/platform/pki/quickstarts/create-certificate-authority#next-step",{"_3170":2270,"_28017":2259,"_19412":52490,"_5":13306,"_25509":2259,"_2665":52491},[],"You will create a root authority with a new key kept by a Lamassu engine. The result is an active CA and its public certificate in `ca.pem`, ready to verify issuance in the next path.",{"_3170":2271,"_28017":2259,"_19412":52493,"_5":13306,"_25509":52458,"_2665":52494},[],"Console access and permission to create keys and authorities.",{"_3170":2272,"_28017":2259,"_19412":52496,"_5":13306,"_25509":52458,"_2665":52497},[],"An available cryptographic engine that supports the chosen algorithm.",{"_3170":2273,"_28017":2259,"_19412":52499,"_5":13306,"_25509":52458,"_2665":52500},[],"OpenSSL 3.x to check the downloaded certificate.",{"_3170":2274,"_28017":2259,"_19412":52502,"_5":13306,"_25509":52458,"_2665":52503},[],"Use an evaluation instance or an authority intended for these tests. The example creates a root that issues directly; to design an operational hierarchy, see Hierarchy and rotation.",{"_3170":2275,"_28017":2259,"_19412":52505,"_5":13306,"_25509":52461,"_2665":52506},[],"In **Certification Authorities**, select **Create New CA** and choose to create a CA with a new key pair.",{"_3170":2276,"_28017":2259,"_19412":52508,"_5":13306,"_25509":52461,"_2665":52509},[],"The &#x2A;*Create New CA (Existing Key)** flow is explained in the authorities guide.",{"_3170":2277,"_28017":2259,"_19412":52511,"_5":13306,"_25509":52465,"_2665":52512},[],"Choose the engine that will keep the key and an algorithm its capabilities allow. For this example, you can use **EC P-384** if available.",{"_3170":2278,"_28017":2259,"_19412":52514,"_5":13306,"_25509":52465,"_2665":52515},[],"The CA private key is used through the engine. In this path, you will download only the authority's public certificate.",{"_3170":2279,"_28017":2259,"_19412":52517,"_5":13306,"_25509":52469,"_2665":52518},[],"Select **Root CA** and complete:",{"_3170":2280,"_28017":2259,"_19412":52520,"_5":13306,"_25509":52469,"_2665":52521},[],"**CA Name**: `Acme Evaluation Root CA`.",{"_3170":2281,"_28017":2259,"_19412":52523,"_5":13306,"_25509":52469,"_2665":52524},[],"**Subject**: organization and country details for your evaluation.",{"_3170":2282,"_28017":2259,"_19412":52526,"_5":13306,"_25509":52469,"_2665":52527},[],"**CA Certificate Expiration**: for example, one year from creation.",{"_3170":2283,"_28017":2259,"_19412":52529,"_5":13306,"_25509":52469,"_2665":52530},[],"**Default End-Entity Certificate Issuance Expiration**: for example, 90 days, within the CA's lifetime.",{"_3170":2284,"_28017":2259,"_19412":52532,"_5":13306,"_25509":52469,"_2665":52533},[],"The CA name becomes its `Common Name`. Keep the CA usages needed to sign certificates and CRLs.",{"_3170":2285,"_28017":2259,"_19412":52535,"_5":13306,"_25509":52473,"_2665":52536},[],"Check the engine, algorithm, subject, root type and dates. Confirm creation and note the authority identifier so you can recognize it in the DMS or API.",{"_3170":2286,"_28017":2259,"_19412":52538,"_5":13306,"_25509":52477,"_2665":52539},[],"Open the new CA. It should appear active, show its certificate and allow access to **Issued Certificates**.",{"_3170":2287,"_28017":2259,"_19412":52541,"_5":13306,"_25509":52477,"_2665":52542},[],"Download or copy the authority's PEM certificate and save it as `ca.pem`. Check that the file contains the complete block, including `BEGIN CERTIFICATE` and `END CERTIFICATE`.",{"_3170":2288,"_28017":2259,"_19412":52544,"_5":13306,"_25509":52481,"_2665":52545},[],"Run from the directory where you saved `ca.pem`:",{"_3170":2289,"_28017":2259,"_19412":52547,"_5":13306,"_25509":52481,"_2665":52548},[],"Check that the subject and issuer match the root you created, the dates include the current time, **Basic Constraints** contains `CA:TRUE` and **Key Usage** allows certificate signing. The last command should return `ca.pem: OK`.",{"_3170":2290,"_28017":2259,"_19412":52550,"_5":13306,"_25509":52481,"_2665":52551},[],"You explicitly selected `ca.pem` as the trust anchor for this test. A valid self-signature does not install that trust in other consumers. See the openssl-verify reference for verification options.",{"_3170":2291,"_28017":2259,"_19412":52553,"_5":13306,"_25509":52485,"_2665":52554},[],"If creation fails, check permissions, engine availability and the selected algorithm.",{"_3170":2292,"_28017":2259,"_19412":52556,"_5":13306,"_25509":52485,"_2665":52557},[],"If OpenSSL cannot read the file, copy the complete PEM block again.",{"_3170":2293,"_28017":2259,"_19412":52559,"_5":13306,"_25509":52485,"_2665":52560},[],"If signature or date checks fail, check that you downloaded this CA's certificate and that your computer's clock is correct.",{"_3170":2294,"_28017":2259,"_19412":52562,"_5":13306,"_25509":52485,"_2665":52563},[],"PKI diagnostics covers issuance checks and cryptographic dependencies.",{"_3170":2295,"_28017":2259,"_19412":52565,"_5":13306,"_25509":52488,"_2665":52566},[],"Continue with Issue and verify a certificate, using this authority and `ca.pem`.",{"_3170":2296,"_28017":2296,"_5":13637,"_2665":52568,"_28339":52569,"_19412":52570,"_25509":2296},"Issue and verify a certificate",[45393,46786,50519,49954],[],{"_3170":2297,"_28017":2296,"_19412":52572,"_5":13306,"_25509":2296,"_2665":52573},[],"Issue a client certificate and check content, chain and key correspondence.",{"_3170":2298,"_28017":2296,"_5":28336,"_19412":52575,"_25509":52576,"_2665":45403},[],"/docs/platform/pki/quickstarts/issue-certificate#before-you-begin",{"_3170":2299,"_28017":2296,"_5":28336,"_19412":52578,"_25509":52579,"_2665":52580},[],"/docs/platform/pki/quickstarts/issue-certificate#start-the-issuance","Start the issuance",{"_3170":2300,"_28017":2296,"_5":28336,"_19412":52582,"_25509":52583,"_2665":52584},[],"/docs/platform/pki/quickstarts/issue-certificate#choose-the-method","Choose the method",{"_3170":2301,"_28017":2296,"_5":28336,"_19412":52586,"_25509":52587,"_2665":52588},[],"/docs/platform/pki/quickstarts/issue-certificate#identify-the-certificate","Identify the certificate",{"_3170":2302,"_28017":2296,"_5":28336,"_19412":52590,"_25509":52591,"_2665":52592},[],"/docs/platform/pki/quickstarts/issue-certificate#configure-key-and-uses","Configure key and uses",{"_3170":2303,"_28017":2296,"_5":28336,"_19412":52594,"_25509":52595,"_2665":52596},[],"/docs/platform/pki/quickstarts/issue-certificate#issue-and-download","Issue and download",{"_3170":2304,"_28017":2296,"_5":28336,"_19412":52598,"_25509":52599,"_2665":52478},[],"/docs/platform/pki/quickstarts/issue-certificate#verify-the-result",{"_3170":2305,"_28017":2296,"_5":28336,"_19412":52601,"_25509":52602,"_2665":52603},[],"/docs/platform/pki/quickstarts/issue-certificate#inspect-content-and-dates","Inspect content and dates",{"_3170":2306,"_28017":2296,"_5":28336,"_19412":52605,"_25509":52606,"_2665":52607},[],"/docs/platform/pki/quickstarts/issue-certificate#verify-the-chain","Verify the chain",{"_3170":2307,"_28017":2296,"_5":28336,"_19412":52609,"_25509":52610,"_2665":52611},[],"/docs/platform/pki/quickstarts/issue-certificate#check-that-the-key-matches","Check that the key matches",{"_3170":2308,"_28017":2296,"_5":28336,"_19412":52613,"_25509":52614,"_2665":50212},[],"/docs/platform/pki/quickstarts/issue-certificate#if-the-result-fails",{"_3170":2309,"_28017":2296,"_5":28336,"_19412":52616,"_25509":52617,"_2665":45427},[],"/docs/platform/pki/quickstarts/issue-certificate#next-step",{"_3170":2310,"_28017":2296,"_19412":52619,"_5":13306,"_25509":2296,"_2665":52620},[],"You will issue an end-entity certificate for `device-001` using browser key and CSR generation. The result is `device.crt`, `device.key` and the issuing root's public certificate, `ca.pem`.",{"_3170":2311,"_28017":2296,"_19412":52622,"_5":13306,"_25509":52576,"_2665":52623},[],"An active root CA with an available signing key and permission to issue. If one does not exist yet, follow Create your first CA.",{"_3170":2312,"_28017":2296,"_19412":52625,"_5":13306,"_25509":52576,"_2665":52626},[],"Its public certificate in `ca.pem`; this example uses the root created in the previous path.",{"_3170":2313,"_28017":2296,"_19412":52628,"_5":13306,"_25509":52576,"_2665":52629},[],"OpenSSL 3.x and a working directory with restricted access.",{"_3170":2314,"_28017":2296,"_19412":52631,"_5":13306,"_25509":52576,"_2665":52632},[],"A client identifier: here we use `device-001`.",{"_3170":2315,"_28017":2296,"_19412":52634,"_5":13306,"_25509":52576,"_2665":52635},[],"In this flow, the client's key is generated in the browser and must be downloaded when issuance finishes. If you lose it, you must generate a key and issue another certificate. The certificate inventory lets you download the public certificate, but cannot recover this key.",{"_3170":2316,"_28017":2296,"_19412":52637,"_5":13306,"_25509":52579,"_2665":52638},[],"Open the CA from the previous path, go to **Issued Certificates** and select **Issue New**.",{"_3170":2317,"_28017":2296,"_19412":52640,"_5":13306,"_25509":52583,"_2665":52641},[],"Select **Generate Key & CSR in Browser** to follow this example.",{"_3170":2318,"_28017":2296,"_19412":52643,"_5":13306,"_25509":52583,"_2665":52644},[],"If the key must be generated and kept on the destination system, use **Upload Existing CSR**, described in the authorities guide.",{"_3170":2319,"_28017":2296,"_19412":52646,"_5":13306,"_25509":52587,"_2665":52647},[],"Enter `device-001` as the `Common Name`. Add subject details required by your policy and SANs if the consumer uses them to identify the client.",{"_3170":2320,"_28017":2296,"_19412":52649,"_5":13306,"_25509":52587,"_2665":52650},[],"If you continue with manual registration, the `Device ID` will be exactly `device-001`.",{"_3170":2321,"_28017":2296,"_19412":52652,"_5":13306,"_25509":52591,"_2665":52653},[],"Choose an algorithm and size allowed by the profile; for example, ECDSA P-256 if permitted. For this client certificate, select **Digital Signature** and **Client Authentication**, and issue it as an end-entity certificate.",{"_3170":2322,"_28017":2296,"_19412":52655,"_5":13306,"_25509":52591,"_2665":52656},[],"Request, for example, 30 days of validity, always within the CA's lifetime. Review the issuance profile if the resulting content differs from the request.",{"_3170":2323,"_28017":2296,"_19412":52658,"_5":13306,"_25509":52595,"_2665":52659},[],"Confirm issuance. Save the PEM certificate as `device.crt` and the private key as `device.key` in your prepared directory.",{"_3170":2324,"_28017":2296,"_19412":52661,"_5":13306,"_25509":52599,"_2665":52662},[],"Check in **Issued Certificates** that the certificate appears active. Note its serial number and verify the downloaded material using the checks below.",{"_3170":2325,"_28017":2296,"_19412":52664,"_5":13306,"_25509":52602,"_2665":52665},[],"Check `CN=device-001`, the expected issuer, current validity, **Digital Signature** and the extended usage **TLS Web Client Authentication**. It must be an end-entity certificate: it must not declare `CA:TRUE` or enable **Certificate Sign**. If **Basic Constraints** is present, it must indicate `CA:FALSE`. If you requested SANs, check that the expected identifiers appear in the certificate.",{"_3170":2326,"_28017":2296,"_19412":52667,"_5":13306,"_25509":52606,"_2665":52668},[],"The expected result is `device.crt: OK`. This check uses your explicit root and evaluates the chain, dates and compatibility with the TLS client purpose. Also check for the expected usages and names through the inspection above.",{"_3170":2327,"_28017":2296,"_19412":52670,"_5":13306,"_25509":52606,"_2665":52671},[],"If you use an intermediate CA, the trusted root must be in `ca.pem` and you must supply the intermediates with `-untrusted intermediates.pem`. This variant is covered in the trust model.",{"_3170":2328,"_28017":2296,"_19412":52673,"_5":13306,"_25509":52606,"_2665":52674},[],"The command does not query OCSP or CRL. For revocation checks, continue with Certificate validation. See the openssl-verify reference for its options.",{"_3170":2329,"_28017":2296,"_19412":52676,"_5":13306,"_25509":52610,"_2665":52677},[],"In Bash, compare the two public-key digests:",{"_3170":2330,"_28017":2296,"_19412":52679,"_5":13306,"_25509":52610,"_2665":52680},[],"Both commands must finish successfully and show the same SHA-256 digest. If they differ, the private key does not match the selected certificate. Find the correct pair before installing it.",{"_3170":2331,"_28017":2296,"_19412":52682,"_5":13306,"_25509":52610,"_2665":52683},[],"The options used are documented in openssl-x509 and openssl-pkey.",{"_3170":2332,"_28017":2296,"_19412":52685,"_5":13306,"_25509":52614,"_2665":50296},[],{"_3170":2333,"_28017":2296,"_19412":52687,"_5":13306,"_25509":52614,"_2665":52688},[],"What to review",{"_3170":2334,"_28017":2296,"_19412":52690,"_5":13306,"_25509":52614,"_2665":52691},[],"The CA rejects issuance",{"_3170":2335,"_28017":2296,"_19412":52693,"_5":13306,"_25509":52614,"_2665":52694},[],"Permissions, CA state and key, algorithm and profile.",{"_3170":2336,"_28017":2296,"_19412":52696,"_5":13306,"_25509":52614,"_2665":52697},[],"Different subject or usages",{"_3170":2337,"_28017":2296,"_19412":52699,"_5":13306,"_25509":52614,"_2665":52700},[],"Applied profile and requested values.",{"_3170":2338,"_28017":2296,"_19412":52702,"_5":13306,"_25509":52614,"_2665":52703},[],"Issuer cannot be found",{"_3170":2339,"_28017":2296,"_19412":52705,"_5":13306,"_25509":52614,"_2665":52706},[],"Downloaded CA and required intermediate chain.",{"_3170":2340,"_28017":2296,"_19412":52708,"_5":13306,"_25509":52614,"_2665":52709},[],"Validity fails",{"_3170":2341,"_28017":2296,"_19412":52711,"_5":13306,"_25509":52614,"_2665":52712},[],"Certificate and CA dates, and the computer's clock.",{"_3170":2342,"_28017":2296,"_19412":52714,"_5":13306,"_25509":52614,"_2665":52715},[],"Public-key digests differ",{"_3170":2343,"_28017":2296,"_19412":52717,"_5":13306,"_25509":52614,"_2665":52718},[],"Certificate and key files from the same issuance.",{"_3170":2344,"_28017":2296,"_19412":52720,"_5":13306,"_25509":52614,"_2665":52721},[],"See PKI diagnostics to narrow an issuance failure.",{"_3170":2345,"_28017":2296,"_19412":52723,"_5":13306,"_25509":52617,"_2665":52724},[],"You have completed the PKI path when the certificate verifies and the key matches. Choose how to use it:",{"_3170":2346,"_28017":2296,"_19412":52726,"_5":13306,"_25509":52617,"_2665":52727},[],"Manage certificates for inspection, status and revocation.",{"_3170":2347,"_28017":2296,"_19412":52729,"_5":13306,"_25509":52617,"_2665":52730},[],"Register a device manually to associate this identity with Lamassu's inventory.",{"_3170":2348,"_28017":2296,"_19412":52732,"_5":13306,"_25509":52617,"_2665":52733},[],"Prepare EST for the device to request its next identities.",{"_3170":2349,"_28017":2296,"_19412":52735,"_5":13306,"_25509":52617,"_2665":52736},[],"Acceptance by a consumer requires configuring its trust, revocation checks and permissions granted to the identity.",{"_3170":2350,"_28017":2350,"_5":13637,"_2665":52738,"_28339":52739,"_19412":52740,"_25509":2350},"PKI getting started",[45393,46786,50519,49954],[],{"_3170":2351,"_28017":2350,"_19412":52742,"_5":13306,"_25509":2350,"_2665":52743},[],"Create a CA, issue a client certificate and check its chain and key.",{"_3170":2352,"_28017":2350,"_5":28336,"_19412":52745,"_25509":52746,"_2665":45403},[],"/docs/platform/pki/quickstarts/overview#before-you-begin",{"_3170":2353,"_28017":2350,"_5":28336,"_19412":52748,"_25509":52749,"_2665":52750},[],"/docs/platform/pki/quickstarts/overview#recommended-path","Recommended path",{"_3170":2354,"_28017":2350,"_5":28336,"_19412":52752,"_25509":52753,"_2665":50146},[],"/docs/platform/pki/quickstarts/overview#expected-result",{"_3170":2355,"_28017":2350,"_5":28336,"_19412":52755,"_25509":52756,"_2665":52757},[],"/docs/platform/pki/quickstarts/overview#continue-according-to-your-goal","Continue according to your goal",{"_3170":2356,"_28017":2350,"_19412":52759,"_5":13306,"_25509":2350,"_2665":52760},[],"This path is intended for those starting to administer PKI or needing a first X.509 client identity. It ends with three files: a root CA certificate, an end-entity certificate and the client's private key.",{"_3170":2357,"_28017":2350,"_19412":52762,"_5":13306,"_25509":52746,"_2665":52763},[],"A Lamassu instance accessible from your browser. To prepare one, see Deployment.",{"_3170":2358,"_28017":2350,"_19412":52765,"_5":13306,"_25509":52746,"_2665":52766},[],"Permission to manage keys, authorities and issuance. See Access control if an operation is blocked.",{"_3170":2359,"_28017":2350,"_19412":52768,"_5":13306,"_25509":52746,"_2665":52769},[],"An available cryptographic engine for the CA key; check the keys and engines inventory.",{"_3170":2360,"_28017":2350,"_19412":52771,"_5":13306,"_25509":52746,"_2665":52772},[],"OpenSSL 3.x on the computer where you will verify the files.",{"_3170":2361,"_28017":2350,"_19412":52774,"_5":13306,"_25509":52746,"_2665":52775},[],"A working directory with restricted access for the downloaded key.",{"_3170":2362,"_28017":2350,"_19412":52777,"_5":13306,"_25509":52749,"_2665":52778},[],"<Card title=\"1. Create your first CA\" description=\"Create an evaluation root and save its public certificate as ca.pem.\" href=\"/docs/platform/pki/quickstarts/create-certificate-authority\" />",{"_3170":2363,"_28017":2350,"_19412":52780,"_5":13306,"_25509":52749,"_2665":52781},[],"<Card title=\"2. Issue and verify a certificate\" description=\"Issue for device-001 and check content, chain and key correspondence.\" href=\"/docs/platform/pki/quickstarts/issue-certificate\" />",{"_3170":2364,"_28017":2350,"_19412":52783,"_5":13306,"_25509":52749,"_2665":52784},[],"We use `Acme Evaluation Root CA` and `device-001` as example names. If you replace them, keep the same client identifier in the steps you want to connect.",{"_3170":2365,"_28017":2350,"_19412":52786,"_5":13306,"_25509":52749,"_2665":52787},[],"The root in this path signs the end-entity certificate directly to simplify evaluation. Before designing an operational PKI, review the trust model and CA hierarchy.",{"_3170":2366,"_28017":2350,"_19412":52789,"_5":13306,"_25509":52753,"_2665":52790},[],"File or resource",{"_3170":2367,"_28017":2350,"_19412":52792,"_5":13306,"_25509":52753,"_2665":50143},[],{"_3170":2368,"_28017":2350,"_19412":52794,"_5":13306,"_25509":52753,"_2665":52795},[],"Active root CA and `ca.pem`",{"_3170":2369,"_28017":2350,"_19412":52797,"_5":13306,"_25509":52753,"_2665":52798},[],"It is a CA certificate, is currently valid and its self-signature verifies.",{"_3170":2370,"_28017":2350,"_19412":52800,"_5":13306,"_25509":52753,"_2665":52801},[],"End-entity certificate and `device.crt`",{"_3170":2371,"_28017":2350,"_19412":52803,"_5":13306,"_25509":52753,"_2665":52804},[],"It identifies `device-001`, supports client authentication and verifies against `ca.pem`.",{"_3170":2372,"_28017":2350,"_19412":52806,"_5":13306,"_25509":52753,"_2665":52807},[],"Private key `device.key`",{"_3170":2373,"_28017":2350,"_19412":52809,"_5":13306,"_25509":52753,"_2665":52810},[],"Its public key matches the one included in `device.crt`.",{"_3170":2374,"_28017":2350,"_19412":52812,"_5":13306,"_25509":52753,"_2665":52813},[],"These checks validate the issued material. Acceptance by a service also requires its trust, authorization and revocation configuration.",{"_3170":2375,"_28017":2350,"_19412":52815,"_5":13306,"_25509":52756,"_2665":52816},[],"To operate certificates, continue with Certificates and Validation.",{"_3170":2376,"_28017":2350,"_19412":52818,"_5":13306,"_25509":52756,"_2665":52819},[],"To manage a device identity in Lamassu, follow Manual registration. That path includes DMS preparation.",{"_3170":2377,"_28017":2350,"_19412":52821,"_5":13306,"_25509":52756,"_2665":52822},[],"For the device to request its certificate, prepare the DMS and EST client.",{"_3170":2378,"_28017":2378,"_5":13637,"_2665":52824,"_28339":52825,"_19412":52826,"_25509":2378},"PKI troubleshooting",[45393,46786,50519,49340],[],{"_3170":2379,"_28017":2378,"_19412":52828,"_5":13306,"_25509":2378,"_2665":52829},[],"Diagnose certificate issuance, OCSP and CRL.",{"_3170":2380,"_28017":2378,"_5":28336,"_19412":52831,"_25509":52832,"_2665":52833},[],"/docs/platform/pki/troubleshooting#issuance-fails","Issuance fails",{"_3170":2381,"_28017":2378,"_5":28336,"_19412":52835,"_25509":52836,"_2665":52837},[],"/docs/platform/pki/troubleshooting#ocsp-or-crl-do-not-reflect-a-change","OCSP or CRL do not reflect a change",{"_3170":2382,"_28017":2378,"_5":28336,"_19412":52839,"_25509":52840,"_2665":52841},[],"/docs/platform/pki/troubleshooting#the-chain-validates-but-the-connection-fails","The chain validates but the connection fails",{"_3170":2383,"_28017":2378,"_19412":52843,"_5":13306,"_25509":2378,"_2665":52844},[],"This guide helps a PKI operator locate issuance and status publication failures. Keep the Lamassu version, operation, CA, issuer, serial, time and returned error. Do not include private keys or tokens in diagnostics.",{"_3170":2384,"_28017":2378,"_19412":52846,"_5":13306,"_25509":2378,"_2665":52847},[],"For Gateway, sign-in, pods, dependencies and messaging, see Deployment troubleshooting. For device enrollment, see EST diagnostics.",{"_3170":2385,"_28017":2378,"_19412":52849,"_5":13306,"_25509":52832,"_2665":50143},[],{"_3170":2386,"_28017":2378,"_19412":52851,"_5":13306,"_25509":52832,"_2665":52852},[],"What to inspect",{"_3170":2387,"_28017":2378,"_19412":52854,"_5":13306,"_25509":52832,"_2665":45427},[],{"_3170":2388,"_28017":2378,"_19412":52856,"_5":13306,"_25509":52832,"_2665":52857},[],"CA",{"_3170":2389,"_28017":2378,"_19412":52859,"_5":13306,"_25509":52832,"_2665":52860},[],"Exists, is active and has usable dates.",{"_3170":2390,"_28017":2378,"_19412":52862,"_5":13306,"_25509":52832,"_2665":52863},[],"Authorities.",{"_3170":2391,"_28017":2378,"_19412":52865,"_5":13306,"_25509":52832,"_2665":52866},[],"Key",{"_3170":2392,"_28017":2378,"_19412":52868,"_5":13306,"_25509":52832,"_2665":52869},[],"The record has a usable private key and the engine can sign.",{"_3170":2393,"_28017":2378,"_19412":52871,"_5":13306,"_25509":52832,"_2665":52872},[],"Try **Sign / Verify** in KMS; check provider permissions and availability.",{"_3170":2394,"_28017":2378,"_19412":52874,"_5":13306,"_25509":52832,"_2665":52875},[],"CSR",{"_3170":2395,"_28017":2378,"_19412":52877,"_5":13306,"_25509":52832,"_2665":52878},[],"Correct PEM and verifiable signature.",{"_3170":2396,"_28017":2378,"_19412":52880,"_5":13306,"_25509":52832,"_2665":52881},[],"`openssl req -in request.csr -noout -verify -text`.",{"_3170":2397,"_28017":2378,"_19412":52883,"_5":13306,"_25509":52832,"_2665":52884},[],"Profile",{"_3170":2398,"_28017":2378,"_19412":52886,"_5":13306,"_25509":52832,"_2665":52887},[],"Selected source, existing ID, allowed algorithm and size.",{"_3170":2399,"_28017":2378,"_19412":52889,"_5":13306,"_25509":52832,"_2665":52890},[],"Check Profiles precedence; CA and DMS resolve differently.",{"_3170":2400,"_28017":2378,"_19412":52892,"_5":13306,"_25509":52832,"_2665":50296},[],{"_3170":2401,"_28017":2378,"_19412":52894,"_5":13306,"_25509":52832,"_2665":52895},[],"Appropriate subject, SAN, usages and dates.",{"_3170":2402,"_28017":2378,"_19412":52897,"_5":13306,"_25509":52832,"_2665":52898},[],"Compare CSR, profile and certificate; successful issuance does not establish consumer acceptance.",{"_3170":2403,"_28017":2378,"_19412":52900,"_5":13306,"_25509":52832,"_2665":52901},[],"For unexpected certificate fields, review `Honor Subject`, `Honor Key Usage`, `Honor Extended Key Usages` and `Honor Extensions`. The latter preserves SAN only, without validating entitlement to those names. Validity is not automatically clamped to CA expiration.",{"_3170":2404,"_28017":2378,"_19412":52903,"_5":13306,"_25509":52832,"_2665":52904},[],"For CA reissuance failures, check revocation and date: reissuance is not supported for a revoked or already expired CA. To change its key, use Hierarchy and rotation.",{"_3170":2405,"_28017":2378,"_19412":52906,"_5":13306,"_25509":52836,"_2665":52907},[],"Check each boundary independently:",{"_3170":2406,"_28017":2378,"_19412":52909,"_5":13306,"_25509":52836,"_2665":52910},[],"**Record:** read the correct certificate again by serial and issuer. Confirm status, reason and time; expired or permanently revoked records reject further transitions.",{"_3170":2407,"_28017":2378,"_19412":52912,"_5":13306,"_25509":52836,"_2665":52913},[],"**Endpoint:** inspect AIA and CDP. Query those URLs from the consumer’s network; an old route or incorrect issuer can explain a discrepancy.",{"_3170":2408,"_28017":2378,"_19412":52915,"_5":13306,"_25509":52836,"_2665":52916},[],"**OCSP:** save a fresh response, verify signature and timestamps, and observe status. An HTTP error for an absent serial does not mean `Good` or guarantee a signed `Unknown`.",{"_3170":2409,"_28017":2378,"_19412":52918,"_5":13306,"_25509":52836,"_2665":52919},[],"**CRL:** compare `latest_crl`, number and timestamps with the downloaded list. Check the serial in its contents. If unchanged, review `regenerate_on_revoke`, event delivery, jobs, signing and storage with the deployment operator.",{"_3170":2410,"_28017":2378,"_19412":52921,"_5":13306,"_25509":52836,"_2665":52922},[],"**Client:** check cache, policy for expired or unavailable evidence, critical IDP extension and rejection of a new connection.",{"_3170":2411,"_28017":2378,"_19412":52924,"_5":13306,"_25509":52836,"_2665":52925},[],"Reactivation from `CertificateHold` needs a new CRL for the client to stop seeing the hold. Reactivating a CA does not restore its descendant cascade; inspect every status and individual operation failure.",{"_3170":2412,"_28017":2378,"_19412":52927,"_5":13306,"_25509":52840,"_2665":52928},[],"Check expected identity, SAN, KU/EKU, matching key, presented intermediates and consumer permissions. Distinguish server TLS trust, client authentication and action authorization. Follow Validation for positive and rejection tests.",{"_3170":2413,"_28017":2378,"_19412":52930,"_5":13306,"_25509":52840,"_2665":52931},[],"When escalating a problem, provide identifiers, error and relevant public evidence, including query timestamps and version. This distinguishes issuance, publication and consumer application failures.",{"_3170":2414,"_28017":2414,"_5":13637,"_2665":52933,"_28339":52934,"_19412":52936,"_25509":2414},"3.8.0 to 4.0.0",[45393,52935],"Upgrades",[],{"_3170":2415,"_28017":2414,"_19412":52938,"_5":13306,"_25509":2414,"_2665":52939},[],"What changes in the 4.0.0 architecture, which changes break a 3.8.0 deployment, how to upgrade a Helm release step by step and how to validate the result.",{"_3170":2416,"_28017":2414,"_5":28336,"_19412":52941,"_25509":52942,"_2665":52943},[],"/docs/upgrades/3-8-0-to-4-0-0#architecture-changes","Architecture changes",{"_3170":2417,"_28017":2414,"_5":28336,"_19412":52945,"_25509":52946,"_2665":52947},[],"/docs/upgrades/3-8-0-to-4-0-0#one-postgresql-database-with-schemas","One PostgreSQL database with schemas",{"_3170":2418,"_28017":2414,"_5":28336,"_19412":52949,"_25509":52950,"_2665":52951},[],"/docs/upgrades/3-8-0-to-4-0-0#authorization-moves-into-the-authz-service","Authorization moves into the authz service",{"_3170":2419,"_28017":2414,"_5":28336,"_19412":52953,"_25509":52954,"_2665":52955},[],"/docs/upgrades/3-8-0-to-4-0-0#device-events-get-their-own-store","Device events get their own store",{"_3170":2420,"_28017":2414,"_5":28336,"_19412":52957,"_25509":52958,"_2665":52959},[],"/docs/upgrades/3-8-0-to-4-0-0#a-hardened-helm-chart","A hardened Helm chart",{"_3170":2421,"_28017":2414,"_5":28336,"_19412":52961,"_25509":52962,"_2665":52963},[],"/docs/upgrades/3-8-0-to-4-0-0#what-the-upgrade-migrates-automatically","What the upgrade migrates automatically",{"_3170":2422,"_28017":2414,"_5":28336,"_19412":52965,"_25509":52966,"_2665":52967},[],"/docs/upgrades/3-8-0-to-4-0-0#breaking-changes","Breaking changes",{"_3170":2423,"_28017":2414,"_5":28336,"_19412":52969,"_25509":52970,"_2665":52971},[],"/docs/upgrades/3-8-0-to-4-0-0#helm-chart-and-values","Helm chart and values",{"_3170":2424,"_28017":2414,"_5":28336,"_19412":52973,"_25509":52974,"_2665":52975},[],"/docs/upgrades/3-8-0-to-4-0-0#release-scoped-resource-names","Release-scoped resource names",{"_3170":2425,"_28017":2414,"_5":28336,"_19412":52977,"_25509":52978,"_2665":52979},[],"/docs/upgrades/3-8-0-to-4-0-0#strict-values-validation","Strict values validation",{"_3170":2426,"_28017":2414,"_5":28336,"_19412":52981,"_25509":52982,"_2665":52983},[],"/docs/upgrades/3-8-0-to-4-0-0#required-authorization-configuration","Required authorization configuration",{"_3170":2427,"_28017":2414,"_5":28336,"_19412":52985,"_25509":52986,"_2665":52987},[],"/docs/upgrades/3-8-0-to-4-0-0#gateway-token-validation-removed","Gateway token validation removed",{"_3170":2428,"_28017":2414,"_5":28336,"_19412":52989,"_25509":52990,"_2665":52991},[],"/docs/upgrades/3-8-0-to-4-0-0#non-root-containers","Non-root containers",{"_3170":2429,"_28017":2414,"_5":28336,"_19412":52993,"_25509":52994,"_2665":52995},[],"/docs/upgrades/3-8-0-to-4-0-0#amqp-over-tls","AMQP over TLS",{"_3170":2430,"_28017":2414,"_5":28336,"_19412":52997,"_25509":52998,"_2665":52999},[],"/docs/upgrades/3-8-0-to-4-0-0#renamed-and-reshaped-values","Renamed and reshaped values",{"_3170":2431,"_28017":2414,"_5":28336,"_19412":53001,"_25509":53002,"_2665":53003},[],"/docs/upgrades/3-8-0-to-4-0-0#data-and-storage","Data and storage",{"_3170":2432,"_28017":2414,"_5":28336,"_19412":53005,"_25509":53006,"_2665":53007},[],"/docs/upgrades/3-8-0-to-4-0-0#postgresql-consolidation","PostgreSQL consolidation",{"_3170":2433,"_28017":2414,"_5":28336,"_19412":53009,"_25509":53010,"_2665":53011},[],"/docs/upgrades/3-8-0-to-4-0-0#sqlite-storage-removed","SQLite storage removed",{"_3170":2434,"_28017":2414,"_5":28336,"_19412":53013,"_25509":53014,"_2665":53015},[],"/docs/upgrades/3-8-0-to-4-0-0#legacy-ca-keys-in-the-kms","Legacy CA keys in the KMS",{"_3170":2435,"_28017":2414,"_5":28336,"_19412":53017,"_25509":53018,"_2665":53019},[],"/docs/upgrades/3-8-0-to-4-0-0#apis-and-stored-configuration","APIs and stored configuration",{"_3170":2436,"_28017":2414,"_5":28336,"_19412":53021,"_25509":53022,"_2665":53023},[],"/docs/upgrades/3-8-0-to-4-0-0#dms-webhooks","DMS webhooks",{"_3170":2437,"_28017":2414,"_5":28336,"_19412":53025,"_25509":53026,"_2665":53027},[],"/docs/upgrades/3-8-0-to-4-0-0#re-enrollment-trust-set","Re-enrollment trust set",{"_3170":2438,"_28017":2414,"_5":28336,"_19412":53029,"_25509":53030,"_2665":53031},[],"/docs/upgrades/3-8-0-to-4-0-0#independent-re-enrollment-authentication","Independent re-enrollment authentication",{"_3170":2439,"_28017":2414,"_5":28336,"_19412":53033,"_25509":53034,"_2665":53035},[],"/docs/upgrades/3-8-0-to-4-0-0#dms-update-api","DMS update API",{"_3170":2440,"_28017":2414,"_5":28336,"_19412":53037,"_25509":53038,"_2665":53039},[],"/docs/upgrades/3-8-0-to-4-0-0#certificate-type-values","Certificate type values",{"_3170":2441,"_28017":2414,"_5":28336,"_19412":53041,"_25509":53042,"_2665":53043},[],"/docs/upgrades/3-8-0-to-4-0-0#device-events","Device events",{"_3170":2442,"_28017":2414,"_5":28336,"_19412":53045,"_25509":53046,"_2665":53047},[],"/docs/upgrades/3-8-0-to-4-0-0#helm-migration-guide","Helm migration guide",{"_3170":2443,"_28017":2414,"_5":28336,"_19412":53049,"_25509":53050,"_2665":53051},[],"/docs/upgrades/3-8-0-to-4-0-0#step-1-prepare","Step 1: Prepare",{"_3170":2444,"_28017":2414,"_5":28336,"_19412":53053,"_25509":53054,"_2665":53055},[],"/docs/upgrades/3-8-0-to-4-0-0#step-2-update-the-values-file","Step 2: Update the values file",{"_3170":2445,"_28017":2414,"_5":28336,"_19412":53057,"_25509":53058,"_2665":53059},[],"/docs/upgrades/3-8-0-to-4-0-0#step-3-run-the-upgrade","Step 3: Run the upgrade",{"_3170":2446,"_28017":2414,"_5":28336,"_19412":53061,"_25509":53062,"_2665":53063},[],"/docs/upgrades/3-8-0-to-4-0-0#step-4-migrate-the-kms-and-va-data","Step 4: Migrate the KMS and VA data",{"_3170":2447,"_28017":2414,"_5":28336,"_19412":53065,"_25509":53066,"_2665":53067},[],"/docs/upgrades/3-8-0-to-4-0-0#step-5-remove-the-one-off-migration-values","Step 5: Remove the one-off migration values",{"_3170":2448,"_28017":2414,"_5":28336,"_19412":53069,"_25509":53070,"_2665":53071},[],"/docs/upgrades/3-8-0-to-4-0-0#deployments-without-helm","Deployments without Helm",{"_3170":2449,"_28017":2414,"_5":28336,"_19412":53073,"_25509":53074,"_2665":49340},[],"/docs/upgrades/3-8-0-to-4-0-0#troubleshooting",{"_3170":2450,"_28017":2414,"_5":28336,"_19412":53076,"_25509":53077,"_2665":53078},[],"/docs/upgrades/3-8-0-to-4-0-0#validation-checklist","Validation checklist",{"_3170":2451,"_28017":2414,"_5":28336,"_19412":53080,"_25509":53081,"_2665":53082},[],"/docs/upgrades/3-8-0-to-4-0-0#delete-the-old-volumes","Delete the old volumes",{"_3170":2452,"_28017":2414,"_19412":53084,"_5":13306,"_25509":2414,"_2665":53085},[],"Lamassu 4.0.0 is a major release. Storage consolidates into a single PostgreSQL database, a new `authz` service authorizes every request, the Helm chart is hardened, and several APIs and stored configurations change shape. Most data converts automatically during the upgrade, but some changes need operator action before, during or after it.",{"_3170":2453,"_28017":2414,"_19412":53087,"_5":13306,"_25509":2414,"_2665":53088},[],"This page is organized in four parts. Read them in order before you upgrade production:",{"_3170":2454,"_28017":2414,"_19412":53090,"_5":13306,"_25509":2414,"_2665":53091},[],"Architecture changes: what is different in 4.0.0 and what the upgrade migrates on its own.",{"_3170":2455,"_28017":2414,"_19412":53093,"_5":13306,"_25509":2414,"_2665":53094},[],"Breaking changes: every change that can break a 3.8.0 deployment, who it affects and what to do.",{"_3170":2456,"_28017":2414,"_19412":53096,"_5":13306,"_25509":2414,"_2665":53097},[],"Helm migration guide: the step-by-step procedure for a Helm-managed release.",{"_3170":2457,"_28017":2414,"_19412":53099,"_5":13306,"_25509":2414,"_2665":53100},[],"Validation checklist: how to confirm the upgrade worked before you remove the old data.",{"_3170":2458,"_28017":2414,"_19412":53102,"_5":13306,"_25509":2414,"_2665":53103},[],"The 4.0.0 release is upcoming and the backend migration steps on this page are provisional. Verify each procedure against the final release artifacts before upgrading production.",{"_3170":2459,"_28017":2414,"_19412":53105,"_5":13306,"_25509":52946,"_2665":53106},[],"3.8.0 gave each service its own database. The 4.0.0 backend connects to a single PostgreSQL database named `pki` and isolates each service in a schema: `kms`, `ca`, `va`, `devicemanager`, `dmsmanager` and `alerts`. The `authz` service keeps its principals, grants and policies in a separate `authz` database (the development monolith uses an `authz` schema inside `pki` instead), and WFX keeps its own `wfx` database.",{"_3170":2460,"_28017":2414,"_19412":53108,"_5":13306,"_25509":52946,"_2665":53109},[],"PostgreSQL is now the only storage engine. SQLite support is removed, and the `couch_db` and `dynamo_db` engines are not registered in 4.0.0.",{"_3170":2461,"_28017":2414,"_19412":53111,"_5":13306,"_25509":52950,"_2665":53112},[],"In 3.8.0 the API Gateway validated tokens: a JWT policy on every private route checked the signature and only let through tokens that carried the administrator role. Every route was open to any token that passed that check.",{"_3170":2462,"_28017":2414,"_19412":53114,"_5":13306,"_25509":52950,"_2665":53115},[],"4.0.0 removes the gateway policy. The `/api/*` routes reach the services directly, and each service authorizes every request through `authz`, which validates the token against the identity provider's JWKS endpoint and applies fine-grained, entity-level policies to CAs, certificates, devices, DMSs, KMS keys and VA roles. There is no implicit superuser: the first administrator comes from a bootstrap principal that you configure. The access control page documents principals, policies and the first administrator.",{"_3170":2463,"_28017":2414,"_19412":53117,"_5":13306,"_25509":52954,"_2665":53118},[],"Historical device events move from the `devices.events` column to a dedicated `device_events` store with their own endpoints. The events endpoint can also stream events over Server-Sent Events (SSE); to fan events out across service instances, each Device Manager instance binds its own durable AMQP queue.",{"_3170":2464,"_28017":2414,"_19412":53120,"_5":13306,"_25509":52958,"_2665":53121},[],"Version 4.0.0 of the chart is a security-hardening release:",{"_3170":2465,"_28017":2414,"_19412":53123,"_5":13306,"_25509":52958,"_2665":53124},[],"**Release-scoped resource names.** Every chart-managed resource is named `<release>-lamassu-<component>` instead of the fixed names used in 3.8.0 (`kms`, `va`, `ca`, ...). With a release named `prod` the StatefulSets become `prod-lamassu-kms` and `prod-lamassu-va`. The `nameOverride` and `fullnameOverride` values change the prefix.",{"_3170":2466,"_28017":2414,"_19412":53126,"_5":13306,"_25509":52958,"_2665":53127},[],"**Non-root containers.** Every workload runs as the numeric user `65532:65532` with a `RuntimeDefault` seccomp profile and dropped capabilities. Pods do not mount the service-account token by default, and the chart creates a dedicated ServiceAccount.",{"_3170":2467,"_28017":2414,"_19412":53129,"_5":13306,"_25509":52958,"_2665":53130},[],"**Strict values validation.** `values.schema.json` rejects unknown keys, so leftover 3.8.0 blocks fail `helm lint` and `helm upgrade` instead of being silently ignored.",{"_3170":2468,"_28017":2414,"_19412":53132,"_5":13306,"_25509":52958,"_2665":53133},[],"**No injected scheduling rules.** The chart no longer adds pod anti-affinity or topology spread constraints on its own.",{"_3170":2469,"_28017":2414,"_19412":53135,"_5":13306,"_25509":52962,"_2665":53136},[],"Several migrations run without intervention when you upgrade a Helm release:",{"_3170":2470,"_28017":2414,"_19412":53138,"_5":13306,"_25509":52962,"_2665":53139},[],"Before any service starts, the chart's pre-install/pre-upgrade job prepares PostgreSQL. It creates the `pki`, `authz` and `wfx` databases when they do not exist, creates one schema per service inside `pki`, and imports each 3.8.0 per-service database into its schema. Each import runs as a single transaction, so a failed import leaves no partial schema and a retried job imports again. The job then runs the database migrations for every schema, migrates `authz`, preloads its policies and seeds the `services.authz.bootstrap` principals. It is idempotent and requires a PostgreSQL role allowed to create databases and schemas, as described in Install with Helm.",{"_3170":2471,"_28017":2414,"_19412":53141,"_5":13306,"_25509":52962,"_2665":53142},[],"Stored DMS configuration is rewritten to the 4.0.0 layout, and historical device events are transformed into the new store.",{"_3170":2472,"_28017":2414,"_19412":53144,"_5":13306,"_25509":52962,"_2665":53145},[],"When `migrations.caToKms.enabled` is set, a pre-upgrade hook registers legacy CA keys in the KMS.",{"_3170":2473,"_28017":2414,"_19412":53147,"_5":13306,"_25509":52962,"_2665":53148},[],"Two things never migrate on their own: the KMS and VA data on local volumes, which stays on volumes the upgraded pods no longer use, and the values file, which you update by hand. Deployments that do not use the Helm chart also have to move their database data themselves; see Deployments without Helm.",{"_3170":2474,"_28017":2414,"_19412":53150,"_5":13306,"_25509":52966,"_2665":53151},[],"Change",{"_3170":2475,"_28017":2414,"_19412":53153,"_5":13306,"_25509":52966,"_2665":53154},[],"Who is affected",{"_3170":2476,"_28017":2414,"_19412":53156,"_5":13306,"_25509":52966,"_2665":53157},[],"Severity",{"_3170":2477,"_28017":2414,"_19412":53159,"_5":13306,"_25509":52966,"_2665":53160},[],"Action",{"_3170":2478,"_28017":2414,"_19412":53162,"_5":13306,"_25509":52966,"_2665":52975},[],{"_3170":2479,"_28017":2414,"_19412":53164,"_5":13306,"_25509":52966,"_2665":53165},[],"Helm releases with a filesystem KMS engine or local VA CRL storage",{"_3170":2480,"_28017":2414,"_19412":53167,"_5":13306,"_25509":52966,"_2665":53168},[],"High: KMS and VA start on empty volumes",{"_3170":2481,"_28017":2414,"_19412":53170,"_5":13306,"_25509":52966,"_2665":53171},[],"Copy the data into the new volumes",{"_3170":2482,"_28017":2414,"_19412":53173,"_5":13306,"_25509":52966,"_2665":52979},[],{"_3170":2483,"_28017":2414,"_19412":53175,"_5":13306,"_25509":52966,"_2665":53176},[],"Every Helm release",{"_3170":2484,"_28017":2414,"_19412":53178,"_5":13306,"_25509":52966,"_2665":53179},[],"High: `helm upgrade` fails",{"_3170":2485,"_28017":2414,"_19412":53181,"_5":13306,"_25509":52966,"_2665":53182},[],"Remove or rename legacy keys",{"_3170":2486,"_28017":2414,"_19412":53184,"_5":13306,"_25509":52966,"_2665":52983},[],{"_3170":2487,"_28017":2414,"_19412":53186,"_5":13306,"_25509":52966,"_2665":53187},[],"Every deployment",{"_3170":2488,"_28017":2414,"_19412":53189,"_5":13306,"_25509":52966,"_2665":53190},[],"High: without a bootstrap principal there is no administrator",{"_3170":2489,"_28017":2414,"_19412":53192,"_5":13306,"_25509":52966,"_2665":53193},[],"Configure `services.authz`",{"_3170":2490,"_28017":2414,"_19412":53195,"_5":13306,"_25509":52966,"_2665":52987},[],{"_3170":2491,"_28017":2414,"_19412":53197,"_5":13306,"_25509":52966,"_2665":53176},[],{"_3170":2492,"_28017":2414,"_19412":53199,"_5":13306,"_25509":52966,"_2665":53200},[],"High: `helm upgrade` fails on the old keys",{"_3170":2493,"_28017":2414,"_19412":53202,"_5":13306,"_25509":52966,"_2665":53203},[],"Move JWKS and roles into `services.authz`",{"_3170":2494,"_28017":2414,"_19412":53205,"_5":13306,"_25509":52966,"_2665":53007},[],{"_3170":2495,"_28017":2414,"_19412":53207,"_5":13306,"_25509":52966,"_2665":53208},[],"3.8.0 deployments with per-service databases",{"_3170":2496,"_28017":2414,"_19412":53210,"_5":13306,"_25509":52966,"_2665":53211},[],"High: services find no data, or a migration aborts",{"_3170":2497,"_28017":2414,"_19412":53213,"_5":13306,"_25509":52966,"_2665":53214},[],"Clean duplicate CA IDs and empty `engine_id` values first; move data manually outside Helm",{"_3170":2498,"_28017":2414,"_19412":53216,"_5":13306,"_25509":52966,"_2665":53011},[],{"_3170":2499,"_28017":2414,"_19412":53218,"_5":13306,"_25509":52966,"_2665":53219},[],"Deployments on SQLite, `couch_db` or `dynamo_db`",{"_3170":2500,"_28017":2414,"_19412":53221,"_5":13306,"_25509":52966,"_2665":53222},[],"High: the backend no longer starts with them",{"_3170":2501,"_28017":2414,"_19412":53224,"_5":13306,"_25509":52966,"_2665":53225},[],"Move to PostgreSQL before upgrading",{"_3170":2502,"_28017":2414,"_19412":53227,"_5":13306,"_25509":52966,"_2665":53228},[],"Webhooks with file references",{"_3170":2503,"_28017":2414,"_19412":53230,"_5":13306,"_25509":52966,"_2665":53231},[],"DMSs whose webhook mTLS certificate or key were file paths",{"_3170":2504,"_28017":2414,"_19412":53233,"_5":13306,"_25509":52966,"_2665":53234},[],"High: enrollments calling the webhook fail",{"_3170":2505,"_28017":2414,"_19412":53236,"_5":13306,"_25509":52966,"_2665":53237},[],"Re-enter certificate and key as PEM, or remove the file fields",{"_3170":2506,"_28017":2414,"_19412":53239,"_5":13306,"_25509":52966,"_2665":52991},[],{"_3170":2507,"_28017":2414,"_19412":53241,"_5":13306,"_25509":52966,"_2665":53242},[],"Releases with per-service identity overrides or mounted key material",{"_3170":2508,"_28017":2414,"_19412":53244,"_5":13306,"_25509":52966,"_2665":53245},[],"Medium: services cannot read their files",{"_3170":2509,"_28017":2414,"_19412":53247,"_5":13306,"_25509":52966,"_2665":53248},[],"Remove the overrides and fix volume ownership",{"_3170":2510,"_28017":2414,"_19412":53250,"_5":13306,"_25509":52966,"_2665":52995},[],{"_3170":2511,"_28017":2414,"_19412":53252,"_5":13306,"_25509":52966,"_2665":53253},[],"Releases that set `amqp.tls`",{"_3170":2512,"_28017":2414,"_19412":53255,"_5":13306,"_25509":52966,"_2665":53256},[],"Medium: clients connect to the wrong port",{"_3170":2513,"_28017":2414,"_19412":53258,"_5":13306,"_25509":52966,"_2665":53259},[],"Point `amqp.port` at the TLS listener, or disable TLS",{"_3170":2514,"_28017":2414,"_19412":53261,"_5":13306,"_25509":52966,"_2665":53015},[],{"_3170":2515,"_28017":2414,"_19412":53263,"_5":13306,"_25509":52966,"_2665":53264},[],"Installations whose CA keys predate the KMS",{"_3170":2516,"_28017":2414,"_19412":53266,"_5":13306,"_25509":52966,"_2665":53267},[],"Medium: CA keys stay unmanaged",{"_3170":2517,"_28017":2414,"_19412":53269,"_5":13306,"_25509":52966,"_2665":53270},[],"Run the CA-to-KMS migration",{"_3170":2518,"_28017":2414,"_19412":53272,"_5":13306,"_25509":52966,"_2665":53273},[],"Receiver certificate verification",{"_3170":2519,"_28017":2414,"_19412":53275,"_5":13306,"_25509":52966,"_2665":53276},[],"DMSs whose webhook had `validate_server_cert: false`",{"_3170":2520,"_28017":2414,"_19412":53278,"_5":13306,"_25509":52966,"_2665":53279},[],"Medium: credentials go to an unverified receiver",{"_3170":2521,"_28017":2414,"_19412":53281,"_5":13306,"_25509":52966,"_2665":53282},[],"Set `insecure_skip_verify` to `false`",{"_3170":2522,"_28017":2414,"_19412":53284,"_5":13306,"_25509":52966,"_2665":53027},[],{"_3170":2523,"_28017":2414,"_19412":53286,"_5":13306,"_25509":52966,"_2665":53287},[],"Scripts and consoles that edit DMSs through the API",{"_3170":2524,"_28017":2414,"_19412":53289,"_5":13306,"_25509":52966,"_2665":53290},[],"Medium: an old-layout edit silently empties `validation_cas`",{"_3170":2525,"_28017":2414,"_19412":53292,"_5":13306,"_25509":52966,"_2665":53293},[],"Read the DMS before editing and use the new field",{"_3170":2526,"_28017":2414,"_19412":53295,"_5":13306,"_25509":52966,"_2665":53043},[],{"_3170":2527,"_28017":2414,"_19412":53297,"_5":13306,"_25509":52966,"_2665":53298},[],"Consumers that read the device `events` field",{"_3170":2528,"_28017":2414,"_19412":53300,"_5":13306,"_25509":52966,"_2665":53301},[],"Medium: the field disappears",{"_3170":2529,"_28017":2414,"_19412":53303,"_5":13306,"_25509":52966,"_2665":53304},[],"Use the new event endpoints",{"_3170":2530,"_28017":2414,"_19412":53306,"_5":13306,"_25509":52966,"_2665":52999},[],{"_3170":2531,"_28017":2414,"_19412":53308,"_5":13306,"_25509":52966,"_2665":53309},[],"Releases that override `toolbox`, `services.connectors`, ports, probes or scheduling",{"_3170":2532,"_28017":2414,"_19412":53311,"_5":13306,"_25509":52966,"_2665":53312},[],"Low to medium: validation errors or changed defaults",{"_3170":2533,"_28017":2414,"_19412":53314,"_5":13306,"_25509":52966,"_2665":53315},[],"Update the values file",{"_3170":2534,"_28017":2414,"_19412":53317,"_5":13306,"_25509":52966,"_2665":53035},[],{"_3170":2535,"_28017":2414,"_19412":53319,"_5":13306,"_25509":52966,"_2665":53320},[],"Clients that send the DMS ID in the update body",{"_3170":2536,"_28017":2414,"_19412":53322,"_5":13306,"_25509":52966,"_2665":53323},[],"Low: the ID in the URL wins",{"_3170":2537,"_28017":2414,"_19412":53325,"_5":13306,"_25509":52966,"_2665":53326},[],"Send the ID in the URL",{"_3170":2538,"_28017":2414,"_19412":53328,"_5":13306,"_25509":52966,"_2665":53039},[],{"_3170":2539,"_28017":2414,"_19412":53330,"_5":13306,"_25509":52966,"_2665":53331},[],"Consumers that match on certificate `type`",{"_3170":2540,"_28017":2414,"_19412":53333,"_5":13306,"_25509":52966,"_2665":53334},[],"Low: two values are renamed",{"_3170":2541,"_28017":2414,"_19412":53336,"_5":13306,"_25509":52966,"_2665":53337},[],"Adapt consumers",{"_3170":2542,"_28017":2414,"_19412":53339,"_5":13306,"_25509":52966,"_2665":53031},[],{"_3170":2543,"_28017":2414,"_19412":53341,"_5":13306,"_25509":52966,"_2665":53342},[],"Any DMS",{"_3170":2544,"_28017":2414,"_19412":53344,"_5":13306,"_25509":52966,"_2665":53345},[],"Low: informational",{"_3170":2545,"_28017":2414,"_19412":53347,"_5":13306,"_25509":52966,"_2665":53348},[],"Read both blocks before editing",{"_3170":2546,"_28017":2414,"_19412":53350,"_5":13306,"_25509":52974,"_2665":53351},[],"Kubernetes derives a StatefulSet's PVC name from its pod name (`<volumeClaimTemplate>-<pod-name>`). Renaming the `kms` and `va` StatefulSets means `helm upgrade` binds brand-new, empty PVCs instead of the existing ones. The KMS key material and VA CRLs are not deleted — the old PVCs are orphaned, not removed — but the upgraded pods fail with `no such file or directory` (KMS) or `code=NotFound` (VA) until you copy the data across. This affects KMS when `services.kms.cryptoEngines` uses a `filesystem` engine and VA when `services.va.fileStore.type` is `local`. Every other renamed resource is stateless and is recreated without data-loss risk.",{"_3170":2547,"_28017":2414,"_19412":53353,"_5":13306,"_25509":52974,"_2665":53354},[],"Step 4 of the migration guide copies the data.",{"_3170":2548,"_28017":2414,"_19412":53356,"_5":13306,"_25509":52978,"_2665":53357},[],"`values.schema.json` rejects unknown keys, so every block that 4.0.0 removed or renamed — `toolbox`, `auth.oidc.apiGateway`, `auth.authorization` and others — fails `helm lint` and `helm upgrade` outright. Step 2 lists every change.",{"_3170":2549,"_28017":2414,"_19412":53359,"_5":13306,"_25509":52982,"_2665":53360},[],"3.8.0 had no authorization service, so a 3.8.0 values file has nothing to migrate from: you must add the `services.authz` configuration yourself. It needs the JWKS endpoint of your identity provider, the database mappings the authorization engine uses, and a bootstrap principal that matches how your provider assigns the administrator role. Without a matching principal nobody can administer the PKI.",{"_3170":2550,"_28017":2414,"_19412":53362,"_5":13306,"_25509":52986,"_2665":53363},[],"`auth.oidc.apiGateway.jwks`, `auth.authorization.rolesClaim` and `auth.authorization.roles.admin` are removed with no compatibility aliases, and the schema rejects them. Their settings move into `services.authz`: the JWKS URL becomes `services.authz.jwkUrl`, and the role claim and administrator role become a claim rule of the bootstrap principal. `auth.oidc.frontend` is unchanged.",{"_3170":2551,"_28017":2414,"_19412":53365,"_5":13306,"_25509":52990,"_2665":53366},[],"Service images run on a distroless base as the numeric user `65532`; the `authz` image is Ubuntu with a non-root user that has the same UID. The per-service overrides `services.kms.securityContext.runAsGroup: 0` and `services.authz.securityContext.runAsUser`/`runAsGroup: 999` are removed; group access to the KMS volume and PKCS#11 socket is now handled by the pod-level `fsGroup: 65532`.",{"_3170":2552,"_28017":2414,"_19412":53368,"_5":13306,"_25509":52990,"_2665":53369},[],"3.8.0 did not pin a container identity, so existing files can carry any UID. Any volume that holds keys or CRLs must be owned by `65532:65532`, or at least readable (and, where needed, writable) by that identity.",{"_3170":2553,"_28017":2414,"_19412":53371,"_5":13306,"_25509":52994,"_2665":53372},[],"In 3.8.0 `amqp.tls` was not applied and event-bus clients always connected over plaintext. In 4.0.0 `amqp.tls: true` switches them to AMQPS. The default `amqp.port` stays `5672` and does not change when TLS is enabled, so a values file that already set `amqp.tls: true` must point `amqp.port` at the broker's TLS listener (`amqps`, commonly `5671`), or set `amqp.tls: false` to keep plaintext. Clients must also trust the broker's certificate.",{"_3170":2554,"_28017":2414,"_19412":53374,"_5":13306,"_25509":52998,"_2665":53375},[],"`toolbox` is renamed to `connectivityTest`, and the `helm test` hook uses the upstream `curlimages/curl` image pinned by digest.",{"_3170":2555,"_28017":2414,"_19412":53377,"_5":13306,"_25509":52998,"_2665":53378},[],"`services.connectors` is a map keyed by connector ID instead of a list.",{"_3170":2556,"_28017":2414,"_19412":53380,"_5":13306,"_25509":52998,"_2665":53381},[],"The `services.ui.port` default is `8085`, the unprivileged port of the rootless image.",{"_3170":2557,"_28017":2414,"_19412":53383,"_5":13306,"_25509":52998,"_2665":53384},[],"The shared `probes:` block is replaced by independent `livenessProbe`, `readinessProbe` and `startupProbe` blocks.",{"_3170":2558,"_28017":2414,"_19412":53386,"_5":13306,"_25509":52998,"_2665":53387},[],"With `tls.certManagerOptions.issuer` empty, the chart creates a release-scoped self-signed issuer, for example `lamassu-downstream-ca-selfsigned-issuer`. The legacy literal `downstream-ca-selfsigned-issuer` is still accepted and resolves to it.",{"_3170":2559,"_28017":2414,"_19412":53389,"_5":13306,"_25509":52998,"_2665":53390},[],"Anti-affinity and topology spread must be configured explicitly through `affinity` and `topologySpreadConstraints`.",{"_3170":2560,"_28017":2414,"_19412":53392,"_5":13306,"_25509":53006,"_2665":53393},[],"Every 3.8.0 per-service database must end up as a schema of `pki`, keeping its structure, indexes, constraints, data and migration history. The Helm chart does this automatically; deployments without Helm do it by hand (see Deployments without Helm).",{"_3170":2561,"_28017":2414,"_19412":53395,"_5":13306,"_25509":53006,"_2665":53396},[],"Two schema migrations abort on data that 3.8.0 allowed, so clean the data before upgrading:",{"_3170":2562,"_28017":2414,"_19412":53398,"_5":13306,"_25509":53006,"_2665":53399},[],"The CA migration adds a UNIQUE constraint on `ca_certificates.id` and aborts if duplicate CA IDs exist. Imports already reject duplicates with `409`, so new ones cannot normally appear.",{"_3170":2563,"_28017":2414,"_19412":53401,"_5":13306,"_25509":53006,"_2665":53402},[],"The KMS migration promotes the primary key to `(key_id, engine_id)` and aborts with `cannot promote (key_id, engine_id) to primary key: N row(s) have no engine_id; backfill them before migrating` when `kms_keys` rows lack `engine_id`. Backfill `engine_id` first.",{"_3170":2564,"_28017":2414,"_19412":53404,"_5":13306,"_25509":53006,"_2665":53405},[],"The same KMS migration deletes, with a `NOTICE`, aliases that equal an existing key ID, because identifiers now resolve as a key ID before an alias. Affected aliases are dropped, not redirected.",{"_3170":2565,"_28017":2414,"_19412":53407,"_5":13306,"_25509":53010,"_2665":53408},[],"The SQLite storage engine is removed, and the `couch_db` and `dynamo_db` engines are not registered in 4.0.0: their configuration constants remain, but they select no engine. Deployments on any of them must move to PostgreSQL and consolidate their data into the `pki` schemas before upgrading.",{"_3170":2566,"_28017":2414,"_19412":53410,"_5":13306,"_25509":53014,"_2665":53411},[],"CA certificates of type `MANAGED` or `IMPORTED_WITH_KEY` whose private keys predate the KMS service have the key stored only in the crypto engine, under the certificate's `subject_key_id`, with no KMS record. The `ca-to-kms-migration` tool registers them:",{"_3170":2567,"_28017":2414,"_19412":53413,"_5":13306,"_25509":53014,"_2665":53414},[],"The `key_id` is the certificate's `subject_key_id` (SHA-256 of the public key).",{"_3170":2568,"_28017":2414,"_19412":53416,"_5":13306,"_25509":53014,"_2665":53417},[],"The tool is idempotent: keys already in the KMS are skipped, so it can be run several times.",{"_3170":2569,"_28017":2414,"_19412":53419,"_5":13306,"_25509":53014,"_2665":53420},[],"Certificates that cannot be read, or lack an engine or a subject key ID, are skipped with a warning. Review the logs and resolve the affected records.",{"_3170":2570,"_28017":2414,"_19412":53422,"_5":13306,"_25509":53014,"_2665":53423},[],"When CA certificates sharing a `subject_key_id` declare conflicting `engine_id`s, the tool fails that key and exits with code `1`, which fails a Helm pre-upgrade hook. Resolve the conflict manually before rerunning.",{"_3170":2571,"_28017":2414,"_19412":53425,"_5":13306,"_25509":53014,"_2665":53426},[],"With Helm, enable the hook for the upgrade in step 2; without Helm, run the tool by hand.",{"_3170":2572,"_28017":2414,"_19412":53428,"_5":13306,"_25509":53022,"_2665":53429},[],"Stored webhook configs are rewritten to the current layout and their fields renamed:",{"_3170":2573,"_28017":2414,"_19412":53431,"_5":13306,"_25509":53022,"_2665":53432},[],"Field in 3.8.0",{"_3170":2574,"_28017":2414,"_19412":53434,"_5":13306,"_25509":53022,"_2665":53435},[],"Field in 4.0.0",{"_3170":2575,"_28017":2414,"_19412":53437,"_5":13306,"_25509":53022,"_2665":53438},[],"`validate_server_cert`",{"_3170":2576,"_28017":2414,"_19412":53440,"_5":13306,"_25509":53022,"_2665":53441},[],"`insecure_skip_verify` (value negated)",{"_3170":2577,"_28017":2414,"_19412":53443,"_5":13306,"_25509":53022,"_2665":53444},[],"`oidc`",{"_3170":2578,"_28017":2414,"_19412":53446,"_5":13306,"_25509":53022,"_2665":53447},[],"`jwt_options`",{"_3170":2579,"_28017":2414,"_19412":53449,"_5":13306,"_25509":53022,"_2665":53450},[],"`apikey`",{"_3170":2580,"_28017":2414,"_19412":53452,"_5":13306,"_25509":53022,"_2665":53453},[],"`apikey_options`",{"_3170":2581,"_28017":2414,"_19412":53455,"_5":13306,"_25509":53022,"_2665":53456},[],"`mtls`",{"_3170":2582,"_28017":2414,"_19412":53458,"_5":13306,"_25509":53022,"_2665":53459},[],"`mtls_options`",{"_3170":2583,"_28017":2414,"_19412":53461,"_5":13306,"_25509":53022,"_2665":53462},[],"When the legacy mTLS certificate and key are both PEM, they move into `mtls_options.cert_content` and `mtls_options.key_content` and need no action. Two cases do need it.",{"_3170":2584,"_28017":2414,"_19412":53464,"_5":13306,"_25509":53022,"_2665":53465},[],"**Webhooks with file references.** A mixed config, with a PEM certificate and a file-path key, is migrated to `mtls_options.cert_file` and `mtls_options.key_file`. Webhook delivery rejects those fields on every call, whatever the configured authentication mode, so every enroll and re-enroll that calls that webhook fails until the config is fixed. If the webhook uses mTLS, re-enter the certificate and key as Base64-encoded or plain PEM; if it does not, remove the leftover file fields. Metadata-only updates keep working in the meantime (`PUT` or `PATCH` on `/v1/dms/:id/metadata`). In a variant of the same problem, a stored config with file paths inside `mtls_options.cert_content` or `mtls_options.key_content` makes every full settings update (`POST /v1/dms` or `PUT /v1/dms/:id`) fail validation; settings are replaced wholesale, so resend the config with the certificate and key as PEM.",{"_3170":2585,"_28017":2414,"_19412":53467,"_5":13306,"_25509":53022,"_2665":53468},[],"**Receiver certificate verification.** A config with `validate_server_cert: false` becomes `insecure_skip_verify: true`, so receiver verification stays skipped until that field is set to `false`. Correct it on every migrated config: the webhook authorization channel carries the API key or bearer token, and skipping verification exposes those credentials to a network-positioned attacker. Keep `insecure_skip_verify: true` only when the receiver certificate is deliberately unverifiable.",{"_3170":2586,"_28017":2414,"_19412":53470,"_5":13306,"_25509":53026,"_2665":53471},[],"The flat field `reenrollment_settings.additional_validation_cas` moves into the nested field `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`:",{"_3170":2587,"_28017":2414,"_19412":53473,"_5":13306,"_25509":53026,"_2665":53474},[],"The effective trust set does not change, because the nested value was never consulted when validating re-enrollments. If the flat list was missing or null, it becomes an empty list.",{"_3170":2588,"_28017":2414,"_19412":53476,"_5":13306,"_25509":53026,"_2665":53477},[],"What changes is how API requests are handled. Bodies that still carry `additional_validation_cas` are accepted, but the value is silently dropped because unknown JSON fields are ignored, and GET responses no longer include it. An update body built from the old layout therefore empties `validation_cas` without any error. Always read the DMS before sending an edit and reuse the layout the API returns.",{"_3170":2589,"_28017":2414,"_19412":53479,"_5":13306,"_25509":53030,"_2665":53480},[],"Re-enrollment authentication settings are now stored independently from initial authentication. Nothing needs migrating, but read both blocks before editing a DMS so that you do not modify one while believing you are editing the other. The console exposes independent editors for both blocks; the DMS guide describes their fields, and you can also edit them through the DMS API.",{"_3170":2590,"_28017":2414,"_19412":53482,"_5":13306,"_25509":53034,"_2665":53483},[],"`PUT /v1/dms/:id` takes the DMS ID from the URL and validates the request body. An ID in the body is ignored, so update clients that relied on it.",{"_3170":2591,"_28017":2414,"_19412":53485,"_5":13306,"_25509":53038,"_2665":53486},[],"Stored certificate type values are renamed: `IMPORTED` becomes `IMPORTED_WITH_KEY` and `EXTERNAL` becomes `IMPORTED_WITHOUT_KEY`. `MANAGED` is unchanged. Adapt consumers that read or match on those values.",{"_3170":2592,"_28017":2414,"_19412":53488,"_5":13306,"_25509":53042,"_2665":53489},[],"The `events` field no longer appears in the device representation. Point consumers at the new endpoints:",{"_3170":2593,"_28017":2414,"_19412":53491,"_5":13306,"_25509":53042,"_2665":53492},[],"`GET /v1/devices/:id/events` returns a device's events.",{"_3170":2594,"_28017":2414,"_19412":53494,"_5":13306,"_25509":53042,"_2665":53495},[],"`POST /v1/devices/:id/events` creates an event.",{"_3170":2595,"_28017":2414,"_19412":53497,"_5":13306,"_25509":53042,"_2665":53498},[],"When the request `Accept` header includes `text/event-stream`, the events endpoint streams over SSE with a keepalive every 15 seconds, and returns `501` when SSE is disabled in the deployment. Each Device Manager instance binds a durable AMQP queue named after its service ID, `device-manager-sse-<uuid>`. Queues from crashed or replaced instances linger until removed, so configure an expiration or cleanup policy on the broker.",{"_3170":2596,"_28017":2414,"_19412":53500,"_5":13306,"_25509":53046,"_2665":53501},[],"The upgrade runs in a fixed order: prepare the data and values, run `helm upgrade`, then copy the KMS and VA data into the new volumes. The copy must run after the upgrade, because the destination StatefulSets and PVCs do not exist before it. If you are not upgrading an existing release, go straight to Install with Helm.",{"_3170":2597,"_28017":2414,"_19412":53503,"_5":13306,"_25509":53050,"_2665":53504},[],"Take a verifiable backup of PostgreSQL and schedule downtime. The upgrade moves every service's data into `pki`.",{"_3170":2598,"_28017":2414,"_19412":53506,"_5":13306,"_25509":53050,"_2665":53507},[],"If the deployment runs on SQLite, `couch_db` or `dynamo_db`, move it to PostgreSQL first.",{"_3170":2599,"_28017":2414,"_19412":53509,"_5":13306,"_25509":53050,"_2665":53510},[],"Resolve duplicate CA IDs and backfill `engine_id` in `kms_keys`, as described in PostgreSQL consolidation.",{"_3170":2600,"_28017":2414,"_19412":53512,"_5":13306,"_25509":53050,"_2665":53513},[],"Record the names of your local-storage PVCs:",{"_3170":2601,"_28017":2414,"_19412":53515,"_5":13306,"_25509":53050,"_2665":53516},[],"`helm upgrade` does not touch or delete the old PVCs, but nothing references them after the upgrade. You need their names to copy the data and to clean up later.",{"_3170":2602,"_28017":2414,"_19412":53518,"_5":13306,"_25509":53054,"_2665":53519},[],"**Add `services.authz`.** Configure the JWKS endpoint, the database mappings and the bootstrap principal:",{"_3170":2603,"_28017":2414,"_19412":53521,"_5":13306,"_25509":53054,"_2665":53522},[],"`jwkUrl` is fetched from the `authz` pod, not from the gateway, so a Service in the release namespace can be referenced by its short name. The default points at a Keycloak Service named `auth-keycloak`; set it explicitly if your identity provider lives anywhere else.",{"_3170":2604,"_28017":2414,"_19412":53524,"_5":13306,"_25509":53054,"_2665":53525},[],"`authz` is the authorization service's own storage for principals, grants and policies. `pki` is the database the authorization engine queries when it evaluates policies against entities. Only the `database` field of each entry is read; the connection always uses the global `postgres.hostname`, `postgres.port`, `postgres.username` and `postgres.password` values.",{"_3170":2605,"_28017":2414,"_19412":53527,"_5":13306,"_25509":53054,"_2665":53528},[],"If you kept the 3.8.0 role defaults (`realm_access.roles` and `pki-admin`), the default `services.authz.bootstrap` already matches them.",{"_3170":2606,"_28017":2414,"_19412":53530,"_5":13306,"_25509":53054,"_2665":53531},[],"**Delete the gateway token validation blocks.** Remove `auth.oidc.apiGateway` and `auth.authorization` once their settings are in `services.authz`:",{"_3170":2607,"_28017":2414,"_19412":53533,"_5":13306,"_25509":53054,"_2665":53534},[],"**Rename `toolbox` to `connectivityTest`:**",{"_3170":2608,"_28017":2414,"_19412":53536,"_5":13306,"_25509":53054,"_2665":53537},[],"**Remove the per-service identity overrides** `services.kms.securityContext.runAsGroup` and `services.authz.securityContext.runAsUser`/`runAsGroup`.",{"_3170":2609,"_28017":2414,"_19412":53539,"_5":13306,"_25509":53054,"_2665":53540},[],"**Convert `services.connectors` to a map** keyed by connector ID, each entry with its `type` and `image`:",{"_3170":2610,"_28017":2414,"_19412":53542,"_5":13306,"_25509":53054,"_2665":53543},[],"**Check AMQP.** If you set `amqp.tls: true`, also set `amqp.port` to the broker's TLS listener (commonly `5671`), or set `amqp.tls: false` to stay on plaintext.",{"_3170":2611,"_28017":2414,"_19412":53545,"_5":13306,"_25509":53054,"_2665":53546},[],"**Enable the CA-to-KMS migration** if your CA keys predate the KMS:",{"_3170":2612,"_28017":2414,"_19412":53548,"_5":13306,"_25509":53054,"_2665":53549},[],"**Review the remaining values:** overrides that pinned `services.ui.port` to `80`, the old `probes:` block, the TLS issuer, and explicit `affinity` and `topologySpreadConstraints` where your cluster needs them. Renamed and reshaped values describes each one.",{"_3170":2613,"_28017":2414,"_19412":53551,"_5":13306,"_25509":53054,"_2665":53552},[],"Run `helm lint` with the new values before upgrading; the strict schema reports any key that is still unknown.",{"_3170":2614,"_28017":2414,"_19412":53554,"_5":13306,"_25509":53058,"_2665":53555},[],"Helm runs the pre-upgrade hooks — the CA-to-KMS migration when enabled, and the database job — before applying any workload, so services never start against an unprepared database. If validation rejects unknown values, fix the values file and re-run.",{"_3170":2615,"_28017":2414,"_19412":53557,"_5":13306,"_25509":53058,"_2665":53558},[],"If the deployment uses local KMS or VA storage, those pods fail until you complete step 4, so `--wait` cannot succeed: Helm waits for them to become ready, times out, exits with an error and marks the release `failed`. The hooks have already run by then, and every manifest, including the new StatefulSets and their PVCs, has been applied. Helm does not roll anything back without `--atomic`. Continue with step 4, then re-run the same `helm upgrade` command so it completes and Helm records the release as `deployed`. Both hooks are idempotent, so they are safe to run again.",{"_3170":2616,"_28017":2414,"_19412":53560,"_5":13306,"_25509":53062,"_2665":53561},[],"Skip this step when `services.kms.cryptoEngines` never used a `filesystem` engine and `services.va.fileStore.type` was never `local`.",{"_3170":2617,"_28017":2414,"_19412":53563,"_5":13306,"_25509":53062,"_2665":53564},[],"**Find the new StatefulSets and PVCs.** Their names depend on the release name and any `nameOverride` or `fullnameOverride`; the PVC name is `<volumeClaimTemplate>-<StatefulSet name>-0`:",{"_3170":2618,"_28017":2414,"_19412":53566,"_5":13306,"_25509":53062,"_2665":53567},[],"With release `lamassu` and the default chart name, the new PVCs are `golang-engine-storage-lamassu-kms-0` and `local-crl-file-storage-lamassu-va-0`; with release `prod` they are `golang-engine-storage-prod-lamassu-kms-0` and `local-crl-file-storage-prod-lamassu-va-0`. Confirm both old and new PVCs exist before continuing. If `claims_ok` prints `ABORT`, the block stops before listing the claims: either a StatefulSet lookup failed, or a new claim resolves to the 3.8.0 claim. In the second case the copy would verify against itself and the final cleanup would delete the live volume. The chart always appends `-kms` and `-va` to the release-scoped name, so a collision means the claims are not what this guide expects; investigate before going on. Item 3 runs the same check and refuses to create the helper pod, so nothing touches the volumes. The check returns instead of calling `exit`, which would close your shell and lose the variables set so far. If you only migrate one of the two services, drop the other one's claims from the commands that follow.",{"_3170":2619,"_28017":2414,"_19412":53569,"_5":13306,"_25509":53062,"_2665":53570},[],"**Record the replica counts, scale the new StatefulSets down and wait for every pod that uses the claims to exit**, so nothing writes to either volume while you copy. Helm removes the 3.8.0 `kms` and `va` StatefulSets during the upgrade, but their pods `kms-0` and `va-0` can still be terminating and holding the old claims. While they run, the helper pod either cannot attach the claims or copies a volume that is still being written. The `wait` returns at once for pods that are already gone:",{"_3170":2620,"_28017":2414,"_19412":53572,"_5":13306,"_25509":53062,"_2665":53573},[],"**Run a short-lived helper pod** that mounts all four claims. It runs as root so it can change file ownership, so pin its image by digest and do not mount the service-account token:",{"_3170":2621,"_28017":2414,"_19412":53575,"_5":13306,"_25509":53062,"_2665":53576},[],"**Inspect before writing** so you do not clobber data the new pods may already have written:",{"_3170":2622,"_28017":2414,"_19412":53578,"_5":13306,"_25509":53062,"_2665":53579},[],"An empty result is the common case: a StatefulSet's own pod rarely gets far enough to write anything when its dependent data is missing. If the output is not empty, record the files and confirm with the service owner that they are disposable before you run the copy; do not overlay the 3.8.0 data onto an unknown store.",{"_3170":2623,"_28017":2414,"_19412":53581,"_5":13306,"_25509":53062,"_2665":53582},[],"**Copy the data, align ownership and verify the copy.** The second command must print `copy verified`; any `diff` output means the copy is incomplete, so do not continue:",{"_3170":2624,"_28017":2414,"_19412":53584,"_5":13306,"_25509":53062,"_2665":53585},[],"The `chown` is required even if the old files already look non-root-owned, because 4.0.0 requires exactly `65532:65532` and does not fall back to whatever the image declares.",{"_3170":2625,"_28017":2414,"_19412":53587,"_5":13306,"_25509":53062,"_2665":53588},[],"**Remove the helper and restore the recorded replica counts:**",{"_3170":2626,"_28017":2414,"_19412":53590,"_5":13306,"_25509":53062,"_2665":53591},[],"**Re-run the step 3 `helm upgrade` command.** The KMS and VA pods now start against the copied data, so `--wait` succeeds and the release moves from `failed` to `deployed`.",{"_3170":2627,"_28017":2414,"_19412":53593,"_5":13306,"_25509":53066,"_2665":53594},[],"After the upgrade that performed the CA-to-KMS migration succeeds, remove `migrations.caToKms.enabled` from your values (it defaults to `false`). The hook reads the legacy 3.8.0 `kms-config` ConfigMap while it still exists and falls back to the release-scoped `<release>-lamassu-kms-config` once it is gone.",{"_3170":2628,"_28017":2414,"_19412":53596,"_5":13306,"_25509":53066,"_2665":53597},[],"Then go through the validation checklist. Keep the old PVCs until it passes.",{"_3170":2629,"_28017":2414,"_19412":53599,"_5":13306,"_25509":53070,"_2665":53600},[],"Without the chart's database job, no tool moves data between databases: the migration tooling only applies migrations to a schema that already exists. Move each per-service database into its `pki` schema yourself, preserving structure, indexes, constraints, data and migration history, with writes stopped and a verified backup in hand.",{"_3170":2630,"_28017":2414,"_19412":53602,"_5":13306,"_25509":53070,"_2665":53603},[],"To apply migrations by hand, `goose-lamassu` must run against the `pki` database with `search_path=<schema>` in the connection string. The binary validates only `search_path`, not the database name, so check `dbname=pki` before running it, and repeat for `kms`, `ca`, `va`, `devicemanager`, `dmsmanager` and `alerts`:",{"_3170":2631,"_28017":2414,"_19412":53605,"_5":13306,"_25509":53070,"_2665":53606},[],"Run `ca-to-kms-migration` first with `--dry-run`, which reports without writing to KMS storage, and then for real:",{"_3170":2632,"_28017":2414,"_19412":53608,"_5":13306,"_25509":53070,"_2665":53609},[],"Point the tool's `storage` configuration at the `pki` database, where the CA and KMS data now live in the `ca` and `kms` schemas. The tool's options are described in `backend/cmd/ca-to-kms-migration/README.md` in the `lamassuiot` repository.",{"_3170":2633,"_28017":2414,"_19412":53611,"_5":13306,"_25509":53070,"_2665":53612},[],"The `goose-lamassu` README still shows per-database examples (`dbname=ca`, `dbname=kms`) and claims the tool validates the database name, and the `ca-to-kms-migration` README still describes the pre-4.0.0 two-database layout. Follow the `dbname=pki` form on this page instead of their examples.",{"_3170":2634,"_28017":2414,"_19412":53614,"_5":13306,"_25509":53074,"_2665":53615},[],"**KMS or VA pods crash with `no such file or directory` or `code=NotFound` right after the upgrade.** The pods are bound to the new, empty PVCs and the data migration has not run yet, or was copied into the wrong PVC. Follow step 4 and check that all four claims exist.",{"_3170":2635,"_28017":2414,"_19412":53617,"_5":13306,"_25509":53074,"_2665":53618},[],"**`helm upgrade --wait` times out and `helm status` reports the release as `failed`.** With local KMS or VA storage this is expected on the first run: the new pods cannot become ready before their data is copied. The hooks ran and the manifests and PVCs were applied, so complete step 4 and re-run the same `helm upgrade` command. If other pods are also not ready, check their logs, because something else is wrong.",{"_3170":2636,"_28017":2414,"_19412":53620,"_5":13306,"_25509":53074,"_2665":53621},[],"**The helper pod stays `Pending` or `ContainerCreating` and `kubectl wait` times out.** Another pod still holds one of the claims; on block storage `kubectl describe pod pvc-migrate-helper` shows a `Multi-Attach error`. Check with `kubectl get pods -n $NAMESPACE` that `kms-0`, `va-0` and the new KMS and VA pods are gone, then re-run the wait.",{"_3170":2637,"_28017":2414,"_19412":53623,"_5":13306,"_25509":53074,"_2665":53624},[],"**`helm upgrade` fails with an unknown-key validation error.** Remove or rename the legacy values — typically `toolbox`, `auth.oidc.apiGateway` or `auth.authorization` — because the strict schema rejects keys it does not know.",{"_3170":2638,"_28017":2414,"_19412":53626,"_5":13306,"_25509":53074,"_2665":53627},[],"**The upgrade fails at the database job.** The PostgreSQL role cannot create databases or schemas, or a schema migration aborted on duplicate CA IDs or missing `engine_id` values. Check the job logs, fix the privileges or the data, and re-run the upgrade.",{"_3170":2639,"_28017":2414,"_19412":53629,"_5":13306,"_25509":53074,"_2665":53630},[],"**The upgrade fails at the CA-to-KMS hook.** CA certificates that share a `subject_key_id` declare conflicting `engine_id`s. Resolve the conflict and re-run.",{"_3170":2640,"_28017":2414,"_19412":53632,"_5":13306,"_25509":53074,"_2665":53633},[],"**Nobody can log in after the upgrade.** Check that `services.authz.jwkUrl` is reachable from the `authz` pod, that `services.authz.bootstrap` matches a role your OIDC provider actually assigns, and that the database job completed.",{"_3170":2641,"_28017":2414,"_19412":53635,"_5":13306,"_25509":53077,"_2665":53636},[],"After the upgrade, check in this order:",{"_3170":2642,"_28017":2414,"_19412":53638,"_5":13306,"_25509":53077,"_2665":53639},[],"**Databases.** Each service reads the `pki` database with its own schema, `authz` and `wfx` data are reachable, and the migration status is registered per schema, including the CA unique-ID and KMS composite-key migrations.",{"_3170":2643,"_28017":2414,"_19412":53641,"_5":13306,"_25509":53077,"_2665":53642},[],"**KMS and VA start cleanly.** Their logs show no `no such file or directory` or `code=NotFound` errors.",{"_3170":2644,"_28017":2414,"_19412":53644,"_5":13306,"_25509":53077,"_2665":53645},[],"**Existing KMS keys work.** Issue a certificate from a CA that existed before the upgrade. None of the other checks reads a KMS key, so this is the only one that proves the key material was copied.",{"_3170":2645,"_28017":2414,"_19412":53647,"_5":13306,"_25509":53077,"_2665":53648},[],"**Existing CRLs are served.** `GET /crl/<ca-ski>` on VA returns a previously issued CRL, and new CRLs are issued.",{"_3170":2646,"_28017":2414,"_19412":53650,"_5":13306,"_25509":53077,"_2665":53651},[],"**Legacy CA keys.** If the CA-to-KMS migration ran, review its report and warnings and confirm the expected keys appear in the KMS.",{"_3170":2647,"_28017":2414,"_19412":53653,"_5":13306,"_25509":53077,"_2665":53654},[],"**Connectivity.** `helm test \"$RELEASE\" -n $NAMESPACE --logs` passes; the hook checks the CA, DMS Manager, Device Manager and VA health endpoints and the UI response.",{"_3170":2648,"_28017":2414,"_19412":53656,"_5":13306,"_25509":53077,"_2665":53657},[],"**Authorization.** Sign in as the bootstrap principal and confirm administration works, check that an identity without permissions receives `403`, and review client and integration permissions.",{"_3170":2649,"_28017":2414,"_19412":53659,"_5":13306,"_25509":53077,"_2665":53660},[],"**AMQP.** The backend connects to the broker with the expected TLS settings, and the cleanup policy for SSE queues is in place.",{"_3170":2650,"_28017":2414,"_19412":53662,"_5":13306,"_25509":53077,"_2665":53663},[],"**Device events.** `GET /v1/devices/:id/events` returns the historical events of a device that had them.",{"_3170":2651,"_28017":2414,"_19412":53665,"_5":13306,"_25509":53077,"_2665":53666},[],"**Webhooks without file fields.** For each DMS that uses a webhook for enrollment or re-enrollment, the `config` block carries `insecure_skip_verify` and the expected option block (`apikey_options`, `jwt_options` or `mtls_options`), with the certificate and key as PEM and no `cert_file` or `key_file`.",{"_3170":2652,"_28017":2414,"_19412":53668,"_5":13306,"_25509":53077,"_2665":53669},[],"**Receiver verification.** `insecure_skip_verify` is `false`, unless the receiver certificate is intentionally unverified.",{"_3170":2653,"_28017":2414,"_19412":53671,"_5":13306,"_25509":53077,"_2665":53672},[],"**Webhook delivery.** One enroll or re-enroll through each migrated webhook completes its authorization call.",{"_3170":2654,"_28017":2414,"_19412":53674,"_5":13306,"_25509":53077,"_2665":53675},[],"**Trust set.** `est_rfc7030_settings.client_certificate_settings.validation_cas` holds the expected CAs, in particular those of the old CA during rotation overlaps.",{"_3170":2655,"_28017":2414,"_19412":53677,"_5":13306,"_25509":53077,"_2665":53678},[],"**API clients.** Scripts and consoles no longer use the old DMS layout (flat `additional_validation_cas`, or the legacy `mtls`, `apikey` and `oidc` fields), send DMS updates with the ID in the URL, and match on the new certificate `type` values.",{"_3170":2656,"_28017":2414,"_19412":53680,"_5":13306,"_25509":53081,"_2665":53681},[],"Only once every check passes, delete the orphaned 3.8.0 volumes to reclaim storage. The delete is irreversible and the old KMS volume may hold the last copy of your CA key material, so take a `VolumeSnapshot` or a backup of both old PVCs first and keep it until you are confident the upgraded deployment is healthy. These are the fixed 3.8.0 names recorded in step 1; before deleting, confirm that neither is mounted by a running pod, for example with `kubectl describe pvc -n $NAMESPACE golang-engine-storage-kms-0 local-crl-file-storage-va-0`, where `Used By` must be `<none>`:",{"_3170":2657,"_28017":2414,"_19412":53683,"_5":13306,"_25509":53081,"_2665":53684},[],"The 3.8.0 per-service databases are no longer used either. Drop them only after the same checks pass and your PostgreSQL backup is verified.",{"_3170":2658,"_28017":2414,"_19412":53686,"_5":13306,"_25509":53081,"_2665":53687},[],"<Card title=\"Install with Helm\" description=\"Prepare dependencies, configure values and install a controlled deployment.\" href=\"/docs/deployment/self-hosted/helm\" />",{"_3170":2659,"_28017":2414,"_19412":53689,"_5":13306,"_25509":53081,"_2665":53690},[],"<Card title=\"Access control\" description=\"Principals, policies and the first administrator.\" href=\"/docs/platform/administration/access-control\" />",{"_3170":2660,"_28017":2414,"_19412":53692,"_5":13306,"_25509":53081,"_2665":53693},[],"<Card title=\"Configure a DMS\" description=\"Enrollment, re-enrollment and webhook settings.\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />","sorting",{"_53696":53697,"_53698":53699,"_53700":53701,"_53702":53703,"_16910":2687,"_64301":2687},"language","english","sortableProperties",[2665,28017,5,25509],"sortablePropertiesWithTypes",{"_2665":23214,"_28017":23214,"_5":23214,"_25509":23214},"sorts",{"_2665":53704,"_28017":56354,"_5":59003,"_25509":61652},{"_4261":53705,"_53706":53707,"_5":23214},{"_13361":2953,"_13736":6842,"_13755":5261,"_11980":4716,"_13742":2873,"_18428":16626,"_13382":3232,"_13389":3042,"_27061":3141,"_27452":4067,"_27473":3832,"_27079":4549,"_32103":6896,"_27484":6305,"_27513":6867,"_32110":2842,"_32113":3414,"_32116":4066,"_32119":2941,"_27859":13816,"_32124":21691,"_32126":5005,"_27889":4216,"_13751":2930,"_32130":12249,"_32133":5122,"_32135":4385,"_27502":10175,"_27854":7878,"_27902":11193,"_32140":5495,"_32142":4238,"_32144":4886,"_32146":2764,"_32148":