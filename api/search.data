132,"_38926":56135,"_38928":56138,"_38930":56141},{"_3328":15,"_29138":15,"_5":14177,"_2816":47395,"_29461":47396,"_20209":47400,"_26493":15},"Deploy from AWS Marketplace",[47397,47398,47399],"Docs","Deployment","Other models",[],{"_3328":16,"_29138":15,"_20209":47402,"_5":13819,"_26493":15,"_2816":47403},[],"Run a preconfigured Lamassu IoT instance on Amazon EC2.",{"_3328":17,"_29138":15,"_5":29458,"_20209":47405,"_26493":47406,"_2816":47407},[],"/docs/deployment/aws-marketplace#before-you-begin","Before you begin",{"_3328":18,"_29138":15,"_5":29458,"_20209":47409,"_26493":47410,"_2816":47411},[],"/docs/deployment/aws-marketplace#infrastructure-requirements","Infrastructure requirements",{"_3328":19,"_29138":15,"_5":29458,"_20209":47413,"_26493":47414,"_2816":47415},[],"/docs/deployment/aws-marketplace#open-the-offer","Open the offer",{"_3328":20,"_29138":15,"_5":29458,"_20209":47417,"_26493":47418,"_2816":47419},[],"/docs/deployment/aws-marketplace#configure-the-instance","Configure the instance",{"_3328":21,"_29138":15,"_5":29458,"_20209":47421,"_26493":47422,"_2816":47423},[],"/docs/deployment/aws-marketplace#limit-network-access","Limit network access",{"_3328":22,"_29138":15,"_5":29458,"_20209":47425,"_26493":47426,"_2816":47427},[],"/docs/deployment/aws-marketplace#launch-and-verify","Launch and verify",{"_3328":23,"_29138":15,"_5":29458,"_20209":47429,"_26493":47430,"_2816":47431},[],"/docs/deployment/aws-marketplace#next-step","Next step",{"_3328":24,"_29138":15,"_20209":47433,"_5":13819,"_26493":15,"_2816":47434},[],"The AWS Marketplace offering reduces initial setup to an EC2 instance inside your account. You keep control of the network, storage and operation of the machine.",{"_3328":25,"_29138":15,"_20209":47436,"_5":13819,"_26493":47406,"_2816":47437},[],"Permissions to subscribe to AWS Marketplace products and launch EC2 instances.",{"_3328":26,"_29138":15,"_20209":47439,"_5":13819,"_26493":47406,"_2816":47440},[],"A VPC and a subnet from which administrators and devices can reach the instance.",{"_3328":27,"_29138":15,"_20209":47442,"_5":13819,"_26493":47406,"_2816":47443},[],"A security group allowing the necessary endpoints.",{"_3328":28,"_29138":15,"_20209":47445,"_5":13819,"_26493":47410,"_2816":47446},[],"**Compute:** a `t3.large` instance at minimum. Use `t3.xlarge` or higher when the load requires it.",{"_3328":29,"_29138":15,"_20209":47448,"_5":13819,"_26493":47410,"_2816":47449},[],"**Storage:** an EBS `gp3` volume of at least 50 GB, sized to your inventory and retention needs.",{"_3328":30,"_29138":15,"_20209":47451,"_5":13819,"_26493":47410,"_2816":47452},[],"**Network:** HTTPS access from the necessary consumers, restricted to trusted networks.",{"_3328":31,"_29138":15,"_20209":47454,"_5":13819,"_26493":47414,"_2816":47455},[],"Go to Lamassu IoT on AWS Marketplace and review the terms before subscribing.",{"_3328":32,"_29138":15,"_20209":47457,"_5":13819,"_26493":47418,"_2816":47458},[],"Select `t3.large` or higher, assign at least 50 GB of `gp3` storage and choose the target VPC and subnet.",{"_3328":33,"_29138":15,"_20209":47460,"_5":13819,"_26493":47422,"_2816":47461},[],"Configure the security group for ports `443`, `8443` and `9443`. Restrict the origins to the administrative and device networks that really need to connect.",{"_3328":34,"_29138":15,"_20209":47463,"_5":13819,"_26493":47426,"_2816":47464},[],"Start the instance and open the console at `https://<public-ip>`. Check you can authenticate before continuing.",{"_3328":35,"_29138":15,"_20209":47466,"_5":13819,"_26493":47430,"_2816":47467},[],"Continue with Create your first CA to validate the instance's cryptographic configuration.",{"_3328":36,"_29138":36,"_5":14177,"_2816":47469,"_29461":47470,"_20209":47471,"_26493":36},"Deploy Lamassu",[47397,47398],[],{"_3328":37,"_29138":36,"_20209":47473,"_5":13819,"_26493":36,"_2816":47474},[],"Choose the operating model that fits your infrastructure and control requirements.",{"_3328":38,"_29138":36,"_5":29458,"_20209":47476,"_26493":47477,"_2816":47478},[],"/docs/deployment/overview#choose-a-model","Choose a model",{"_3328":39,"_29138":36,"_5":29458,"_20209":47480,"_26493":47481,"_2816":47482},[],"/docs/deployment/overview#just-want-to-evaluate-the-platform","Just want to evaluate the platform?",{"_3328":40,"_29138":36,"_5":29458,"_20209":47484,"_26493":47485,"_2816":47486},[],"/docs/deployment/overview#after-deployment","After deployment",{"_3328":41,"_29138":36,"_20209":47488,"_5":13819,"_26493":36,"_2816":47489},[],"You can run Lamassu on your own Kubernetes cluster, deploy a prebuilt image from AWS Marketplace or consume the platform as a managed service.",{"_3328":42,"_29138":36,"_20209":47491,"_5":13819,"_26493":47477,"_2816":47492},[],"Model",{"_3328":43,"_29138":36,"_20209":47494,"_5":13819,"_26493":47477,"_2816":47495},[],"Recommended for",{"_3328":44,"_29138":36,"_20209":47497,"_5":13819,"_26493":47477,"_2816":47498},[],"Who operates the infrastructure",{"_3328":45,"_29138":36,"_20209":47500,"_5":13819,"_26493":47477,"_2816":47501},[],"Starting point",{"_3328":46,"_29138":36,"_20209":47503,"_5":13819,"_26493":47477,"_2816":47504},[],"Kubernetes self-managed",{"_3328":47,"_29138":36,"_20209":47506,"_5":13819,"_26493":47477,"_2816":47507},[],"Production, regulated environments and custom deployments",{"_3328":48,"_29138":36,"_20209":47509,"_5":13819,"_26493":47477,"_2816":47510},[],"Your team",{"_3328":49,"_29138":36,"_20209":47512,"_5":13819,"_26493":47477,"_2816":47513},[],"Helm or Fastlane",{"_3328":50,"_29138":36,"_20209":47515,"_5":13819,"_26493":47477,"_2816":47516},[],"AWS Marketplace",{"_3328":51,"_29138":36,"_20209":47518,"_5":13819,"_26493":47477,"_2816":47519},[],"Evaluation or a dedicated deployment inside an AWS account",{"_3328":52,"_29138":36,"_20209":47521,"_5":13819,"_26493":47477,"_2816":47510},[],{"_3328":53,"_29138":36,"_20209":47523,"_5":13819,"_26493":47477,"_2816":47524},[],"Preconfigured image on EC2",{"_3328":54,"_29138":36,"_20209":47526,"_5":13819,"_26493":47477,"_2816":47527},[],"SaaS",{"_3328":55,"_29138":36,"_20209":47529,"_5":13819,"_26493":47477,"_2816":47530},[],"Teams that want to use the platform without operating it",{"_3328":56,"_29138":36,"_20209":47532,"_5":13819,"_26493":47477,"_2816":47533},[],"Lamassu",{"_3328":57,"_29138":36,"_20209":47535,"_5":13819,"_26493":47477,"_2816":47536},[],"Managed subscription",{"_3328":58,"_29138":36,"_20209":47538,"_5":13819,"_26493":47477,"_2816":47539},[],"<Card title=\"Kubernetes self-managed\" description=\"Control network, storage, keys, dependencies and the upgrade cycle.\" href=\"/docs/deployment/self-hosted/overview\" />",{"_3328":59,"_29138":36,"_20209":47541,"_5":13819,"_26493":47477,"_2816":47542},[],"<Card title=\"AWS Marketplace\" description=\"Launch a preconfigured Lamassu instance on AWS EC2.\" href=\"/docs/deployment/aws-marketplace\" />",{"_3328":60,"_29138":36,"_20209":47544,"_5":13819,"_26493":47477,"_2816":47545},[],"<Card title=\"Lamassu SaaS\" description=\"Use an operated and updated instance as a managed service.\" href=\"/docs/deployment/saas\" />",{"_3328":61,"_29138":36,"_20209":47547,"_5":13819,"_26493":47481,"_2816":47548},[],"Use Fastlane to bring up PostgreSQL, Keycloak, RabbitMQ and Lamassu on a Kubernetes cluster through a single flow. It is intended for labs, demos and bootstrap; for production, configure dependencies and Helm values explicitly.",{"_3328":62,"_29138":36,"_20209":47550,"_5":13819,"_26493":47485,"_2816":47551},[],"Once the console is available, continue with Create your first CA. That quickstart verifies the cryptographic engine and issuance work correctly.",{"_3328":63,"_29138":63,"_5":14177,"_2816":47553,"_29461":47554,"_20209":47555,"_26493":63},"Use Lamassu as SaaS",[47397,47398,47399],[],{"_3328":64,"_29138":63,"_20209":47557,"_5":13819,"_26493":63,"_2816":47558},[],"Consume Lamassu as a managed service without operating your own infrastructure.",{"_3328":65,"_29138":63,"_5":29458,"_20209":47560,"_26493":47561,"_2816":47562},[],"/docs/deployment/saas#what-the-service-manages","What the service manages",{"_3328":66,"_29138":63,"_5":29458,"_20209":47564,"_26493":47565,"_2816":47566},[],"/docs/deployment/saas#plans","Plans",{"_3328":67,"_29138":63,"_5":29458,"_20209":47568,"_26493":47569,"_2816":47570},[],"/docs/deployment/saas#request-access","Request access",{"_3328":68,"_29138":63,"_20209":47572,"_5":13819,"_26493":63,"_2816":47573},[],"Lamassu SaaS offers the platform's capabilities in a managed environment. It is the right option when your team wants to focus on PKI and device identities, not on maintaining the infrastructure that supports them.",{"_3328":69,"_29138":63,"_20209":47575,"_5":13819,"_26493":47561,"_2816":47576},[],"Platform availability and maintenance.",{"_3328":70,"_29138":63,"_20209":47578,"_5":13819,"_26493":47561,"_2816":47579},[],"Automatic backups.",{"_3328":71,"_29138":63,"_20209":47581,"_5":13819,"_26493":47561,"_2816":47582},[],"Version upgrades.",{"_3328":72,"_29138":63,"_20209":47584,"_5":13819,"_26493":47561,"_2816":47585},[],"Technical support and SLA according to your plan.",{"_3328":73,"_29138":63,"_20209":47587,"_5":13819,"_26493":47565,"_2816":47588},[],"Plan",{"_3328":74,"_29138":63,"_20209":47590,"_5":13819,"_26493":47565,"_2816":47591},[],"Devices",{"_3328":75,"_29138":63,"_20209":47593,"_5":13819,"_26493":47565,"_2816":47594},[],"Support",{"_3328":76,"_29138":63,"_20209":47596,"_5":13819,"_26493":47565,"_2816":47597},[],"SLA",{"_3328":77,"_29138":63,"_20209":47599,"_5":13819,"_26493":47565,"_2816":47600},[],"Starter",{"_3328":78,"_29138":63,"_20209":47602,"_5":13819,"_26493":47565,"_2816":47603},[],"Up to 1,000",{"_3328":79,"_29138":63,"_20209":47605,"_5":13819,"_26493":47565,"_2816":47606},[],"Email",{"_3328":80,"_29138":63,"_20209":47608,"_5":13819,"_26493":47565,"_2816":47609},[],"99.5 %",{"_3328":81,"_29138":63,"_20209":47611,"_5":13819,"_26493":47565,"_2816":47612},[],"Professional",{"_3328":82,"_29138":63,"_20209":47614,"_5":13819,"_26493":47565,"_2816":47615},[],"Up to 10,000",{"_3328":83,"_29138":63,"_20209":47617,"_5":13819,"_26493":47565,"_2816":47618},[],"Email and chat",{"_3328":84,"_29138":63,"_20209":47620,"_5":13819,"_26493":47565,"_2816":47621},[],"99.9 %",{"_3328":85,"_29138":63,"_20209":47623,"_5":13819,"_26493":47565,"_2816":47624},[],"Enterprise",{"_3328":86,"_29138":63,"_20209":47626,"_5":13819,"_26493":47565,"_2816":47627},[],"Unlimited",{"_3328":87,"_29138":63,"_20209":47629,"_5":13819,"_26493":47565,"_2816":47630},[],"Dedicated",{"_3328":88,"_29138":63,"_20209":47632,"_5":13819,"_26493":47565,"_2816":47633},[],"99.99 %",{"_3328":89,"_29138":63,"_20209":47635,"_5":13819,"_26493":47569,"_2816":47636},[],"Contact the Lamassu team through lamassu.io to request a demo or choose a plan.",{"_3328":90,"_29138":63,"_20209":47638,"_5":13819,"_26493":47569,"_2816":47639},[],"When you receive your instance's credentials, continue with Get started.",{"_3328":91,"_29138":91,"_5":14177,"_2816":47641,"_29461":47642,"_20209":47643,"_26493":91},"Fastlane",[47397,47398,47504],[],{"_3328":92,"_29138":91,"_20209":47645,"_5":13819,"_26493":91,"_2816":47646},[],"Bootstrap a complete Lamassu evaluation or lab environment on an existing Kubernetes cluster.",{"_3328":93,"_29138":91,"_5":29458,"_20209":47648,"_26493":47649,"_2816":47650},[],"/docs/deployment/self-hosted/fastlane#deploy-with-fastlane","Deploy with Fastlane",{"_3328":94,"_29138":91,"_5":29458,"_20209":47652,"_26493":47653,"_2816":47654},[],"/docs/deployment/self-hosted/fastlane#what-fastlane-adds","What Fastlane adds",{"_3328":95,"_29138":91,"_5":29458,"_20209":47656,"_26493":47657,"_2816":47407},[],"/docs/deployment/self-hosted/fastlane#before-you-begin",{"_3328":96,"_29138":91,"_5":29458,"_20209":47659,"_26493":47660,"_2816":47661},[],"/docs/deployment/self-hosted/fastlane#quick-start","Quick start",{"_3328":97,"_29138":91,"_5":29458,"_20209":47663,"_26493":47664,"_2816":47665},[],"/docs/deployment/self-hosted/fastlane#gateway-address-selection","Gateway address selection",{"_3328":98,"_29138":91,"_5":29458,"_20209":47667,"_26493":47668,"_2816":47669},[],"/docs/deployment/self-hosted/fastlane#command-line-options","Command-line options",{"_3328":99,"_29138":91,"_5":29458,"_20209":47671,"_26493":47672,"_2816":47673},[],"/docs/deployment/self-hosted/fastlane#development-mode","Development mode",{"_3328":100,"_29138":91,"_5":29458,"_20209":47675,"_26493":47676,"_2816":47677},[],"/docs/deployment/self-hosted/fastlane#what-the-script-configures","What the script configures",{"_3328":101,"_29138":91,"_5":29458,"_20209":47679,"_26493":47680,"_2816":47681},[],"/docs/deployment/self-hosted/fastlane#tls-behavior","TLS behavior",{"_3328":102,"_29138":91,"_5":29458,"_20209":47683,"_26493":47684,"_2816":47685},[],"/docs/deployment/self-hosted/fastlane#credentials-and-generated-files","Credentials and generated files",{"_3328":103,"_29138":91,"_5":29458,"_20209":47687,"_26493":47688,"_2816":47689},[],"/docs/deployment/self-hosted/fastlane#verify-the-installation","Verify the installation",{"_3328":104,"_29138":91,"_20209":47691,"_5":13819,"_26493":47649,"_2816":47692},[],"Fastlane is the automated path for evaluations, demos, CI and small lab clusters. It installs PostgreSQL, Keycloak, RabbitMQ, Envoy Gateway and Lamassu, then configures them to work together.",{"_3328":105,"_29138":91,"_20209":47694,"_5":13819,"_26493":47649,"_2816":47695},[],"For production, use Helm so database, identity, credentials, certificates, storage and upgrades remain explicit.",{"_3328":106,"_29138":91,"_20209":47697,"_5":13819,"_26493":47653,"_2816":47698},[],"Fastlane closes some of the gaps intentionally left by the application chart:",{"_3328":107,"_29138":91,"_20209":47700,"_5":13819,"_26493":47653,"_2816":47701},[],"Fastlane installs or configures",{"_3328":108,"_29138":91,"_20209":47703,"_5":13819,"_26493":47653,"_2816":47704},[],"You still provide",{"_3328":109,"_29138":91,"_20209":47706,"_5":13819,"_26493":47653,"_2816":47707},[],"PostgreSQL, RabbitMQ and Keycloak instances for evaluation",{"_3328":110,"_29138":91,"_20209":47709,"_5":13819,"_26493":47653,"_2816":47710},[],"The Kubernetes cluster, nodes and persistent storage",{"_3328":111,"_29138":91,"_20209":47712,"_5":13819,"_26493":47653,"_2816":47713},[],"Envoy Gateway 1.8 and the `eg` `GatewayClass`",{"_3328":112,"_29138":91,"_20209":47715,"_5":13819,"_26493":47653,"_2816":47716},[],"cert-manager, external network reachability, DNS and firewall/NAT rules",{"_3328":113,"_29138":91,"_20209":47718,"_5":13819,"_26493":47653,"_2816":47719},[],"A self-signed Lamassu certificate flow, generated dependency credentials and an initial user",{"_3328":114,"_29138":91,"_20209":47721,"_5":13819,"_26493":47653,"_2816":47722},[],"Client trust for the self-signed CA, or a trusted certificate passed to the script",{"_3328":115,"_29138":91,"_20209":47724,"_5":13819,"_26493":47653,"_2816":47725},[],"Optional observability and lab HSM components",{"_3328":116,"_29138":91,"_20209":47727,"_5":13819,"_26493":47653,"_2816":47728},[],"Production monitoring retention, backups, HA and a production HSM/key service",{"_3328":117,"_29138":91,"_20209":47730,"_5":13819,"_26493":47653,"_2816":47731},[],"Fastlane does not turn the resulting stack into a production service: it does not create the cluster, public DNS, firewall rules, backups, high availability or a trusted public certificate.",{"_3328":118,"_29138":91,"_20209":47733,"_5":13819,"_26493":47657,"_2816":47734},[],"You need:",{"_3328":119,"_29138":91,"_20209":47736,"_5":13819,"_26493":47657,"_2816":47737},[],"an existing Kubernetes cluster",{"_3328":120,"_29138":91,"_20209":47739,"_5":13819,"_26493":47657,"_2816":47740},[],"`kubectl` and Helm, or the MicroK8s CLI",{"_3328":121,"_29138":91,"_20209":47742,"_5":13819,"_26493":47657,"_2816":47743},[],"`yq`",{"_3328":122,"_29138":91,"_20209":47745,"_5":13819,"_26493":47657,"_2816":22856},[],{"_3328":123,"_29138":91,"_20209":47747,"_5":13819,"_26493":47657,"_2816":47748},[],"`jq` only when using `--sample-data` or `--development`",{"_3328":124,"_29138":91,"_20209":47750,"_5":13819,"_26493":47657,"_2816":47751},[],"`ssh-keygen` only when using `--with-hsm`",{"_3328":125,"_29138":91,"_20209":47753,"_5":13819,"_26493":47657,"_2816":47754},[],"free external ports 80 and 443 on a single-node K3s host",{"_3328":126,"_29138":91,"_20209":47756,"_5":13819,"_26493":47657,"_2816":47757},[],"Fastlane detects MicroK8s, K3s, kind or a standard kubeconfig. Use `--context` when the intended cluster is not the current context.",{"_3328":127,"_29138":91,"_20209":47759,"_5":13819,"_26493":47657,"_2816":47760},[],"Fastlane installs several components and creates credentials. Check `kubectl config current-context` or pass `--context` before running it.",{"_3328":128,"_29138":91,"_20209":47762,"_5":13819,"_26493":47660,"_2816":47763},[],"Run the script from a clone of the Helm repository:",{"_3328":129,"_29138":91,"_20209":47765,"_5":13819,"_26493":47660,"_2816":47766},[],"Create a DNS record for the chosen domain before testing from another machine. For a small VM, point it at the VM or load-balancer address that actually receives ports 80 and 443.",{"_3328":130,"_29138":91,"_20209":47768,"_5":13819,"_26493":47664,"_2816":47769},[],"By default, Fastlane runs `hostname -I` and writes the returned addresses to `gateway.addresses` and to the self-signed certificate's IP SANs.",{"_3328":131,"_29138":91,"_20209":47771,"_5":13819,"_26493":47664,"_2816":47772},[],"On a single-homed lab VM this can select the expected node address. On hosts with Docker, VPN, WireGuard or several interfaces it can also select addresses clients cannot reach. Override the result explicitly:",{"_3328":132,"_29138":91,"_20209":47774,"_5":13819,"_26493":47664,"_2816":47775},[],"The value must be an address handled on the Kubernetes side of the traffic path. If a public EC2 address forwards through WireGuard to the cluster, pass the reachable cluster/VM address, not the EC2 public address.",{"_3328":133,"_29138":91,"_20209":47777,"_5":13819,"_26493":47664,"_2816":47778},[],"See Expose the Gateway for K3s port conflicts, VIPs, external NAT and multi-Gateway designs.",{"_3328":134,"_29138":91,"_20209":47780,"_5":13819,"_26493":47668,"_2816":47781},[],"Option",{"_3328":135,"_29138":91,"_20209":47783,"_5":13819,"_26493":47668,"_2816":47784},[],"Default",{"_3328":136,"_29138":91,"_20209":47786,"_5":13819,"_26493":47668,"_2816":47787},[],"Purpose",{"_3328":137,"_29138":91,"_20209":47789,"_5":13819,"_26493":47668,"_2816":47790},[],"`-h`, `--help`",{"_3328":138,"_29138":91,"_20209":47792,"_5":13819,"_26493":47668,"_2816":47793},[],"—",{"_3328":139,"_29138":91,"_20209":47795,"_5":13819,"_26493":47668,"_2816":47796},[],"Show help",{"_3328":140,"_29138":91,"_20209":47798,"_5":13819,"_26493":47668,"_2816":47799},[],"`-c`, `--context`",{"_3328":141,"_29138":91,"_20209":47801,"_5":13819,"_26493":47668,"_2816":47802},[],"current context",{"_3328":142,"_29138":91,"_20209":47804,"_5":13819,"_26493":47668,"_2816":47805},[],"Select the kubeconfig context for kubectl and Helm",{"_3328":143,"_29138":91,"_20209":47807,"_5":13819,"_26493":47668,"_2816":47808},[],"`-n`, `--non-interactive`",{"_3328":144,"_29138":91,"_20209":47810,"_5":13819,"_26493":47668,"_2816":6245},[],{"_3328":145,"_29138":91,"_20209":47812,"_5":13819,"_26493":47668,"_2816":47813},[],"Skip prompts and generate dependency credentials",{"_3328":146,"_29138":91,"_20209":47815,"_5":13819,"_26493":47668,"_2816":47816},[],"`-ns`, `--namespace`",{"_3328":147,"_29138":91,"_20209":47818,"_5":13819,"_26493":47668,"_2816":47819},[],"`lamassu-dev`",{"_3328":148,"_29138":91,"_20209":47821,"_5":13819,"_26493":47668,"_2816":47822},[],"Namespace for the installation",{"_3328":149,"_29138":91,"_20209":47824,"_5":13819,"_26493":47668,"_2816":47825},[],"`-d`, `--domain`",{"_3328":150,"_29138":91,"_20209":47827,"_5":13819,"_26493":47668,"_2816":47828},[],"`dev.lamassu.io`",{"_3328":151,"_29138":91,"_20209":47830,"_5":13819,"_26493":47668,"_2816":47831},[],"Domain used by the UI, OIDC and certificate",{"_3328":152,"_29138":91,"_20209":47833,"_5":13819,"_26493":47668,"_2816":47834},[],"`-v`, `--version`",{"_3328":153,"_29138":91,"_20209":47836,"_5":13819,"_26493":47668,"_2816":14491},[],{"_3328":154,"_29138":91,"_20209":47838,"_5":13819,"_26493":47668,"_2816":47839},[],"Lamassu chart version",{"_3328":155,"_29138":91,"_20209":47841,"_5":13819,"_26493":47668,"_2816":47842},[],"`--https-port`",{"_3328":156,"_29138":91,"_20209":47844,"_5":13819,"_26493":47668,"_2816":47845},[],"`443`",{"_3328":157,"_29138":91,"_20209":47847,"_5":13819,"_26493":47668,"_2816":47848},[],"Gateway HTTPS listener port",{"_3328":158,"_29138":91,"_20209":47850,"_5":13819,"_26493":47668,"_2816":47851},[],"`--http-port`",{"_3328":159,"_29138":91,"_20209":47853,"_5":13819,"_26493":47668,"_2816":47854},[],"`80`",{"_3328":160,"_29138":91,"_20209":47856,"_5":13819,"_26493":47668,"_2816":47857},[],"Gateway HTTP listener port",{"_3328":161,"_29138":91,"_20209":47859,"_5":13819,"_26493":47668,"_2816":47860},[],"`--tls-crt`",{"_3328":162,"_29138":91,"_20209":47862,"_5":13819,"_26493":47668,"_2816":47793},[],{"_3328":163,"_29138":91,"_20209":47864,"_5":13819,"_26493":47668,"_2816":47865},[],"PEM certificate for downstream TLS",{"_3328":164,"_29138":91,"_20209":47867,"_5":13819,"_26493":47668,"_2816":47868},[],"`--tls-key`",{"_3328":165,"_29138":91,"_20209":47870,"_5":13819,"_26493":47668,"_2816":47793},[],{"_3328":166,"_29138":91,"_20209":47872,"_5":13819,"_26493":47668,"_2816":47873},[],"PEM private key for downstream TLS",{"_3328":167,"_29138":91,"_20209":47875,"_5":13819,"_26493":47668,"_2816":47876},[],"`-l`, `--local-chart-path`",{"_3328":168,"_29138":91,"_20209":47878,"_5":13819,"_26493":47668,"_2816":47879},[],"repository chart",{"_3328":169,"_29138":91,"_20209":47881,"_5":13819,"_26493":47668,"_2816":47882},[],"Use an unpacked local Lamassu chart",{"_3328":170,"_29138":91,"_20209":47884,"_5":13819,"_26493":47668,"_2816":47885},[],"`-ip`, `--gateway-ip`",{"_3328":171,"_29138":91,"_20209":47887,"_5":13819,"_26493":47668,"_2816":8395},[],{"_3328":172,"_29138":91,"_20209":47889,"_5":13819,"_26493":47668,"_2816":47890},[],"Override the address written to `gateway.addresses`",{"_3328":173,"_29138":91,"_20209":47892,"_5":13819,"_26493":47668,"_2816":47893},[],"`--otel`",{"_3328":174,"_29138":91,"_20209":47895,"_5":13819,"_26493":47668,"_2816":6245},[],{"_3328":175,"_29138":91,"_20209":47897,"_5":13819,"_26493":47668,"_2816":47898},[],"Install Victoria Logs, VictoriaTraces, Jaeger and an OpenTelemetry Collector",{"_3328":176,"_29138":91,"_20209":47900,"_5":13819,"_26493":47668,"_2816":47901},[],"`--development`",{"_3328":177,"_29138":91,"_20209":47903,"_5":13819,"_26493":47668,"_2816":6245},[],{"_3328":178,"_29138":91,"_20209":47905,"_5":13819,"_26493":47668,"_2816":47906},[],"Development mode: fully provisions the Keycloak `lamassu` user (fixed `lamassu`/`lamassu` password, no first-login steps) and lets the `frontend` client accept any redirect URI or web origin. Not for production",{"_3328":179,"_29138":91,"_20209":47908,"_5":13819,"_26493":47668,"_2816":47909},[],"`--sample-data`",{"_3328":180,"_29138":91,"_20209":47911,"_5":13819,"_26493":47668,"_2816":6245},[],{"_3328":181,"_29138":91,"_20209":47913,"_5":13819,"_26493":47668,"_2816":47914},[],"Create sample CAs, profiles, certificates, DMS data and devices",{"_3328":182,"_29138":91,"_20209":47916,"_5":13819,"_26493":47668,"_2816":47917},[],"`--with-hsm`",{"_3328":183,"_29138":91,"_20209":47919,"_5":13819,"_26493":47668,"_2816":6245},[],{"_3328":184,"_29138":91,"_20209":47921,"_5":13819,"_26493":47668,"_2816":47922},[],"Install lab HSM components and configure KMS for PKCS#11",{"_3328":185,"_29138":91,"_20209":47924,"_5":13819,"_26493":47668,"_2816":47925},[],"`--softhsm-chart-path`",{"_3328":186,"_29138":91,"_20209":47927,"_5":13819,"_26493":47668,"_2816":47928},[],"`./charts/softhsm`",{"_3328":187,"_29138":91,"_20209":47930,"_5":13819,"_26493":47668,"_2816":47931},[],"Use a different local SoftHSM chart",{"_3328":188,"_29138":91,"_20209":47933,"_5":13819,"_26493":47668,"_2816":47934},[],"Fastlane does not provide an offline mode. Use the manual Helm workflow and a prepared registry/chart mirror for disconnected environments.",{"_3328":189,"_29138":91,"_20209":47936,"_5":13819,"_26493":47672,"_2816":47937},[],"`--development` adjusts the Keycloak `lamassu` realm generated by Fastlane for a disposable evaluation environment:",{"_3328":190,"_29138":91,"_20209":47939,"_5":13819,"_26493":47672,"_2816":47940},[],"the `lamassu` user is fully provisioned (first name Lamassu, last name Admin, email `lamassu@lamassu.io`, verified): there are no profile setup or password change steps on first login",{"_3328":191,"_29138":91,"_20209":47942,"_5":13819,"_26493":47672,"_2816":47943},[],"the well-known `lamassu`/`lamassu` password is fixed and permanent: it is never rotated and grants the `pki-admin` role, including non-interactive tokens through the `frontend` client",{"_3328":192,"_29138":91,"_20209":47945,"_5":13819,"_26493":47672,"_2816":47946},[],"the `frontend` client accepts any redirect URI and any web origin (`*`) instead of the original `/*` patterns",{"_3328":193,"_29138":91,"_20209":47948,"_5":13819,"_26493":47672,"_2816":47949},[],"With `--development`, the fixed `lamassu`/`lamassu` password grants `pki-admin` access to anyone who can reach the installation. Never use it on anything exposed beyond a development machine or a network-reachable host.",{"_3328":194,"_29138":91,"_20209":47951,"_5":13819,"_26493":47672,"_2816":47952},[],"`--development` applies when the `lamassu` realm is first imported. It does not modify an existing cluster. It can be combined with `--sample-data`: the development transform runs first, then sample data is added to the same realm configuration.",{"_3328":195,"_29138":91,"_20209":47954,"_5":13819,"_26493":47676,"_2816":47955},[],"Fastlane:",{"_3328":196,"_29138":91,"_20209":47957,"_5":13819,"_26493":47676,"_2816":47958},[],"validates local tools and the selected cluster",{"_3328":197,"_29138":91,"_20209":47960,"_5":13819,"_26493":47676,"_2816":47961},[],"installs or upgrades Envoy Gateway 1.8 and creates the `eg` `GatewayClass`",{"_3328":198,"_29138":91,"_20209":47963,"_5":13819,"_26493":47676,"_2816":47964},[],"creates the namespace",{"_3328":199,"_29138":91,"_20209":47966,"_5":13819,"_26493":47676,"_2816":47967},[],"installs PostgreSQL and creates the required databases",{"_3328":200,"_29138":91,"_20209":47969,"_5":13819,"_26493":47676,"_2816":47970},[],"installs Keycloak and creates the `lamassu` realm, frontend client, admin role and initial user",{"_3328":201,"_29138":91,"_20209":47972,"_5":13819,"_26493":47676,"_2816":47973},[],"installs RabbitMQ",{"_3328":202,"_29138":91,"_20209":47975,"_5":13819,"_26493":47676,"_2816":47976},[],"optionally installs observability and lab HSM components",{"_3328":203,"_29138":91,"_20209":47978,"_5":13819,"_26493":47676,"_2816":47979},[],"generates `lamassu.yaml` and installs the Lamassu chart",{"_3328":204,"_29138":91,"_20209":47981,"_5":13819,"_26493":47676,"_2816":47982},[],"optionally loads sample data",{"_3328":205,"_29138":91,"_20209":47984,"_5":13819,"_26493":47676,"_2816":47985},[],"The generated configuration exposes Keycloak at `/auth` through the same Gateway and bootstraps the initial `lamassu` user as a Lamassu super administrator.",{"_3328":206,"_29138":91,"_20209":47987,"_5":13819,"_26493":47680,"_2816":47988},[],"With both `--tls-crt` and `--tls-key`, Fastlane creates the `downstream-provided-crt` Secret and configures `tls.type: external`.",{"_3328":207,"_29138":91,"_20209":47990,"_5":13819,"_26493":47680,"_2816":47991},[],"Without them, it configures cert-manager with a self-signed issuer. This is suitable for a lab but will not be trusted by clients until you distribute the CA. Use Helm when you need a corporate Issuer, public ACME issuer or an existing Secret managed by another system.",{"_3328":208,"_29138":91,"_20209":47993,"_5":13819,"_26493":47684,"_2816":47994},[],"Non-interactive mode generates random PostgreSQL, RabbitMQ and Keycloak administrator passwords. The initial Lamassu login is `lamassu` / `lamassu` and requires a password change on first use, unless `--development` was used: in that case the password stays fixed and permanent.",{"_3328":209,"_29138":91,"_20209":47996,"_5":13819,"_26493":47684,"_2816":47997},[],"Fastlane writes `lamassu.yaml` in the current directory and injects credentials into it.",{"_3328":210,"_29138":91,"_20209":47999,"_5":13819,"_26493":47684,"_2816":48000},[],"Protect the generated values file, record the generated credentials in an appropriate secret store and do not reuse the evaluation identity setup in production.",{"_3328":211,"_29138":91,"_20209":48002,"_5":13819,"_26493":47688,"_2816":48003},[],"Then open `https://pki.example.com` and sign in with the initial user. If the Gateway is programmed but the URL is unreachable, follow the checks in Expose the Gateway.",{"_3328":212,"_29138":212,"_5":14177,"_2816":48005,"_29461":48006,"_20209":48007,"_26493":212},"Install with Helm",[47397,47398,47504],[],{"_3328":213,"_29138":212,"_20209":48009,"_5":13819,"_26493":212,"_2816":48010},[],"Prepare dependencies, configure the Lamassu chart and verify a controlled Kubernetes deployment.",{"_3328":214,"_29138":212,"_5":29458,"_20209":48012,"_26493":48013,"_2816":48014},[],"/docs/deployment/self-hosted/helm#install-lamassu-with-helm","Install Lamassu with Helm",{"_3328":215,"_29138":212,"_5":29458,"_20209":48016,"_26493":48017,"_2816":47407},[],"/docs/deployment/self-hosted/helm#before-you-begin",{"_3328":216,"_29138":212,"_5":29458,"_20209":48019,"_26493":48020,"_2816":48021},[],"/docs/deployment/self-hosted/helm#1-install-the-gateway-prerequisites","1\\. Install the Gateway prerequisites",{"_3328":217,"_29138":212,"_5":29458,"_20209":48023,"_26493":48024,"_2816":48025},[],"/docs/deployment/self-hosted/helm#2-create-a-values-file","2\\. Create a values file",{"_3328":218,"_29138":212,"_5":29458,"_20209":48027,"_26493":48028,"_2816":48029},[],"/docs/deployment/self-hosted/helm#tls-with-an-existing-secret","TLS with an existing Secret",{"_3328":219,"_29138":212,"_5":29458,"_20209":48031,"_26493":48032,"_2816":48033},[],"/docs/deployment/self-hosted/helm#amqp-tls-amqps","AMQP TLS (AMQPS)",{"_3328":220,"_29138":212,"_5":29458,"_20209":48035,"_26493":48036,"_2816":48037},[],"/docs/deployment/self-hosted/helm#provision-the-first-administrator","Provision the first administrator",{"_3328":221,"_29138":212,"_5":29458,"_20209":48039,"_26493":48040,"_2816":48041},[],"/docs/deployment/self-hosted/helm#3-install-lamassu","3\\. Install Lamassu",{"_3328":222,"_29138":212,"_5":29458,"_20209":48043,"_26493":48044,"_2816":48045},[],"/docs/deployment/self-hosted/helm#4-verify-the-deployment","4\\. Verify the deployment",{"_3328":223,"_29138":212,"_5":29458,"_20209":48047,"_26493":48048,"_2816":48049},[],"/docs/deployment/self-hosted/helm#upgrading-lamassu","Upgrading Lamassu",{"_3328":224,"_29138":212,"_5":29458,"_20209":48051,"_26493":48052,"_2816":48053},[],"/docs/deployment/self-hosted/helm#production-decisions","Production decisions",{"_3328":225,"_29138":212,"_20209":48055,"_5":13819,"_26493":48013,"_2816":48056},[],"Use the Helm workflow when you need explicit control over identity, databases, messaging, certificates, storage and upgrades. For an evaluation environment where the script can make those choices for you, use Fastlane.",{"_3328":226,"_29138":212,"_20209":48058,"_5":13819,"_26493":48017,"_2816":48059},[],"Prepare the platform services that are deliberately outside the Lamassu chart:",{"_3328":227,"_29138":212,"_20209":48061,"_5":13819,"_26493":48017,"_2816":48062},[],"a Kubernetes 1.24+ cluster and Helm 3.2+",{"_3328":228,"_29138":212,"_20209":48064,"_5":13819,"_26493":48017,"_2816":48065},[],"a reachable PostgreSQL server and a role allowed to create databases and schemas",{"_3328":229,"_29138":212,"_20209":48067,"_5":13819,"_26493":48017,"_2816":48068},[],"a reachable RabbitMQ broker and credentials",{"_3328":230,"_29138":212,"_20209":48070,"_5":13819,"_26493":48017,"_2816":48071},[],"an OIDC provider, normally Keycloak, with a realm/tenant and client for Lamassu",{"_3328":231,"_29138":212,"_20209":48073,"_5":13819,"_26493":48017,"_2816":48074},[],"Envoy Gateway 1.8+ and a `GatewayClass`",{"_3328":232,"_29138":212,"_20209":48076,"_5":13819,"_26493":48017,"_2816":48077},[],"cert-manager 1.14+ (only for the default `tls.type: certManager` mode); for trusted TLS, either a trusted issuer or a Kubernetes TLS Secret",{"_3328":233,"_29138":212,"_20209":48079,"_5":13819,"_26493":48017,"_2816":48080},[],"a StorageClass and an external traffic design",{"_3328":234,"_29138":212,"_20209":48082,"_5":13819,"_26493":48017,"_2816":48083},[],"The chart defaults to a `GatewayClass` named `eg`. Change `gateway.className` if your platform team uses another name.",{"_3328":235,"_29138":212,"_20209":48085,"_5":13819,"_26493":48017,"_2816":48086},[],"You provide the PostgreSQL server. The chart's pre-install job connects with the supplied credentials, creates the required `pki`, `authz` and `wfx` databases and service schemas, runs migrations, and applies `services.authz.bootstrap`.",{"_3328":236,"_29138":212,"_20209":48088,"_5":13819,"_26493":48017,"_2816":48089},[],"The chart has no Helm dependencies that install PostgreSQL, RabbitMQ, an OIDC provider, Envoy Gateway or cert-manager.",{"_3328":237,"_29138":212,"_20209":48091,"_5":13819,"_26493":48020,"_2816":48092},[],"Install or upgrade the Envoy Gateway CRDs before its controller. The commands below match the version used by the Lamassu Helm repository:",{"_3328":238,"_29138":212,"_20209":48094,"_5":13819,"_26493":48020,"_2816":48095},[],"Create the default `GatewayClass` if it does not already exist. Save this manifest as `gateway-class.yaml`:",{"_3328":239,"_29138":212,"_20209":48097,"_5":13819,"_26493":48020,"_2816":48098},[],"Install cert-manager separately before Lamassu, but only for the default `tls.type: certManager` mode. In that mode the chart renders its self-signed Issuer and CA Certificate resources regardless of whether `tls.certManagerOptions.clusterIssuer` is set, so cert-manager stays a prerequisite. With `tls.type: external`, the chart renders no cert-manager resources and the Gateway terminates TLS with an existing Secret you provide instead.",{"_3328":240,"_29138":212,"_20209":48100,"_5":13819,"_26493":48024,"_2816":48101},[],"Start with the chart defaults and override the environment-specific values. This example assumes PostgreSQL, RabbitMQ and Keycloak are reachable through Kubernetes DNS, and exposes Keycloak at `/auth` through the shared Lamassu Gateway:",{"_3328":241,"_29138":212,"_20209":48103,"_5":13819,"_26493":48024,"_2816":48104},[],"Do not add `gateway.addresses` by default. Leave address assignment to the load-balancer implementation unless your network design requires a specific Kubernetes-side VIP. The public IP of an upstream NAT gateway or reverse proxy does not belong in this value.",{"_3328":242,"_29138":212,"_20209":48106,"_5":13819,"_26493":48024,"_2816":48107},[],"If Keycloak is external and already has its own reachable URL, point the OIDC settings at it and omit the `/auth` entry from `gateway.extraRouting`.",{"_3328":243,"_29138":212,"_20209":48109,"_5":13819,"_26493":48024,"_2816":48110},[],"If your values file still carries the legacy gateway JWT validation settings — `auth.oidc.apiGateway.jwks`, `auth.authorization.rolesClaim` or `auth.authorization.roles.admin` — remove them. The migration guide `charts/lamassu/CHANGELOG/3.8.0->4.0.0.md` documents their removal with no compatibility aliases, and `values.schema.json` rejects the leftover blocks instead of silently ignoring them. The replacements are `services.authz.jwkUrl` and `services.authz.bootstrap`, already shown in the example above.",{"_3328":244,"_29138":212,"_20209":48112,"_5":13819,"_26493":48028,"_2816":48113},[],"Create a Secret containing `tls.crt` and `tls.key`, then reference it. The Secret must already exist before installing: in `external` mode the chart renders no cert-manager resources and never creates this Secret.",{"_3328":245,"_29138":212,"_20209":48115,"_5":13819,"_26493":48032,"_2816":48116},[],"`amqp.tls: true` selects AMQPS in every event-bus configuration block. The default port stays `5672` and does not change automatically when TLS is enabled, so set `amqp.port` to the broker's TLS listener, commonly `5671`.",{"_3328":246,"_29138":212,"_20209":48118,"_5":13819,"_26493":48032,"_2816":48119},[],"With no CA Secret configured, the event-bus clients use the system-trusted CAs. To trust a private CA, create a Secret in the release namespace containing the CA certificate in PEM format and set `amqp.ca.secretName` (and `amqp.ca.certificateKey` if the data key is not `ca.crt`).",{"_3328":247,"_29138":212,"_20209":48121,"_5":13819,"_26493":48032,"_2816":48122},[],"For brokers that require mutual TLS, create a Secret containing the client certificate and private key and set `amqp.client.secretName` (with `amqp.client.certificateKey` and `amqp.client.privateKeyKey` if the data keys are not `tls.crt` and `tls.key`).",{"_3328":248,"_29138":212,"_20209":48124,"_5":13819,"_26493":48032,"_2816":48125},[],"The chart mounts configured Secrets read-only into every AMQP-consuming workload: the CA certificate under `/etc/lamassu/amqp/ca` and the client certificate and key under `/etc/lamassu/amqp/client`. The mounted file names are always `ca.crt`, `tls.crt` and `tls.key` — the `certificateKey` and `privateKeyKey` values rename only the Secret data keys, never the on-disk paths. The client private key is mounted with restrictive permissions (`defaultMode: 0440`; the CA volume uses `0444`), which works because the chart adds `fsGroup` to the pod security context when `amqp.client.secretName` is set — it uses the container `runAsGroup` (default `65532`) when `fsGroup` is not already set.",{"_3328":249,"_29138":212,"_20209":48127,"_5":13819,"_26493":48032,"_2816":48128},[],"Both Secret options require `amqp.tls: true`: `values.schema.json` rejects a non-empty `secretName` when `tls` is false, rejects unknown keys and rejects data-key names outside `^[A-Za-z0-9._-]+$`. The referenced Secret must exist in the release namespace or the consuming pods fail to start.",{"_3328":250,"_29138":212,"_20209":48130,"_5":13819,"_26493":48032,"_2816":48131},[],"The AMQP client loads certificates at startup, so restart the consuming pods after updating either Secret. Changing any `amqp` value rolls the consuming pods through the `checksum/config` annotation, but a change to Secret content alone does not trigger a rollout.",{"_3328":251,"_29138":212,"_20209":48133,"_5":13819,"_26493":48032,"_2816":48134},[],"Per the migration guide `charts/lamassu/CHANGELOG/3.8.0->4.0.0.md`: in 3.8.0 `amqp.tls` was not applied and event-bus clients used plaintext AMQP; from 4.0.0, `amqp.tls: true` switches them to AMQPS. Set `amqp.port` to the broker TLS listener before upgrading, or set `amqp.tls: false` to keep plaintext AMQP. `amqp.tls: false` sends the broker credentials and all event-bus traffic in cleartext.",{"_3328":252,"_29138":212,"_20209":48136,"_5":13819,"_26493":48036,"_2816":48137},[],"There is no implicit superuser. Create the role or group expected by `services.authz.bootstrap` in the OIDC provider and assign it to at least one administrator before exposing Lamassu.",{"_3328":253,"_29138":212,"_20209":48139,"_5":13819,"_26493":48036,"_2816":48140},[],"The pre-install and pre-upgrade job applies the bootstrap idempotently: existing principals are preserved and missing grants are added.",{"_3328":254,"_29138":212,"_20209":48142,"_5":13819,"_26493":48036,"_2816":48143},[],"Test both an authorized identity and a denied identity. If no token matches an active bootstrap principal, nobody can administer the PKI.",{"_3328":255,"_29138":212,"_20209":48145,"_5":13819,"_26493":48036,"_2816":48146},[],"See Access control for the principal and policy model.",{"_3328":256,"_29138":212,"_20209":48148,"_5":13819,"_26493":48040,"_2816":48149},[],"To install a local checkout instead:",{"_3328":257,"_29138":212,"_20209":48151,"_5":13819,"_26493":48044,"_2816":48152},[],"The Gateway should report `PROGRAMMED=True`. If it is programmed but has no usable address, continue with Expose the Gateway.",{"_3328":258,"_29138":212,"_20209":48154,"_5":13819,"_26493":48044,"_2816":48155},[],"The Helm test checks the CA, DMS Manager, Device Manager and VA health endpoints and verifies the UI response.",{"_3328":259,"_29138":212,"_20209":48157,"_5":13819,"_26493":48048,"_2816":48158},[],"Version-specific upgrade steps live in `charts/lamassu/CHANGELOG/` in the Helm repository. The chart also ships an optional pre-upgrade Job that migrates existing CA private keys into the KMS engine configured for the release. It is off by default (`migrations.caToKms.enabled: false`) and is only needed when upgrading from a version prior to 3.7.0.",{"_3328":260,"_29138":212,"_20209":48160,"_5":13819,"_26493":48048,"_2816":48161},[],"While the flag is enabled, every `helm upgrade` creates the `<chart fullname>-ca-to-kms-migration` Job (`lamassu-ca-to-kms-migration` for release `lamassu`); a fresh install does not create it. Its hook weight is `-10`, so it runs before the other pre-upgrade hooks: the authorization bootstrap configuration (weight `-4`) and the database-migration Job (weight `-3`).",{"_3328":261,"_29138":212,"_20209":48163,"_5":13819,"_26493":48048,"_2816":48164},[],"The Job consumes the same KMS service configuration the chart renders into the KMS ConfigMap, including the engines from `services.kms.cryptoEngines`, and runs the migration tool defined in `migrations.caToKms.image`. It mounts that configuration read-only at `/etc/lamassuiot/config.yml` from the ConfigMap key `config`, so configure the destination engine in your values before the upgrade that performs the migration.",{"_3328":262,"_29138":212,"_20209":48166,"_5":13819,"_26493":48048,"_2816":48167},[],"The Job resolves its configuration through a projected volume with two optional sources: the release-scoped `<chart fullname>-kms-config` (`lamassu-kms-config` for release `lamassu`, `prod-lamassu-kms-config` for release `prod`) and the legacy unscoped `kms-config` created by chart versions before release-scoped naming. The legacy configuration remains authoritative while it is still present, and the release-scoped one is used once the legacy one is gone. Both sources are optional, so a missing ConfigMap never leaves the upgrade pod in `ContainerCreating`.",{"_3328":263,"_29138":212,"_20209":48169,"_5":13819,"_26493":48048,"_2816":48170},[],"Keep `migrations.caToKms.enabled: true` for the upgrade that performs the migration, then remove the flag from your values once the migration completes; it defaults to `false`.",{"_3328":264,"_29138":212,"_20209":48172,"_5":13819,"_26493":48052,"_2816":48173},[],"Before going live, review:",{"_3328":265,"_29138":212,"_20209":48175,"_5":13819,"_26493":48052,"_2816":48176},[],"backup and recovery for PostgreSQL and persistent volumes",{"_3328":266,"_29138":212,"_20209":48178,"_5":13819,"_26493":48052,"_2816":48179},[],"a production KMS engine; the default filesystem engine is not an HA design",{"_3328":267,"_29138":212,"_20209":48181,"_5":13819,"_26493":48052,"_2816":48182},[],"shared VA storage before increasing VA replicas",{"_3328":268,"_29138":212,"_20209":48184,"_5":13819,"_26493":48052,"_2816":48185},[],"managed OIDC roles and removal of evaluation credentials",{"_3328":269,"_29138":212,"_20209":48187,"_5":13819,"_26493":48052,"_2816":48188},[],"a trusted TLS issuer or externally managed certificate",{"_3328":270,"_29138":212,"_20209":48190,"_5":13819,"_26493":48052,"_2816":48191},[],"resource requests, replicas, autoscaling, disruption budgets and placement",{"_3328":271,"_29138":212,"_20209":48193,"_5":13819,"_26493":48052,"_2816":48194},[],"SMTP, observability and alert delivery",{"_3328":272,"_29138":212,"_20209":48196,"_5":13819,"_26493":48052,"_2816":48197},[],"the version upgrade guides and migration notes in `charts/lamassu/CHANGELOG/` before every upgrade, including the optional CA-to-KMS migration hook described above",{"_3328":273,"_29138":212,"_20209":48199,"_5":13819,"_26493":48052,"_2816":48200},[],"The complete values reference is maintained in `charts/lamassu/VALUES.md` in the Helm repository.",{"_3328":274,"_29138":274,"_5":14177,"_2816":48202,"_29461":48203,"_20209":48204,"_26493":274},"Expose the Gateway",[47397,47398,47504],[],{"_3328":275,"_29138":274,"_20209":48206,"_5":13819,"_26493":274,"_2816":48207},[],"Choose how clients reach Lamassu, when to set gateway.addresses and how to design multiple Gateways.",{"_3328":276,"_29138":274,"_5":29458,"_20209":48209,"_26493":48210,"_2816":48211},[],"/docs/deployment/self-hosted/networking#expose-the-lamassu-gateway","Expose the Lamassu Gateway",{"_3328":277,"_29138":274,"_5":29458,"_20209":48213,"_26493":48214,"_2816":48215},[],"/docs/deployment/self-hosted/networking#do-you-need-gatewayaddresses","Do you need `gateway.addresses`?",{"_3328":278,"_29138":274,"_5":29458,"_20209":48217,"_26493":48218,"_2816":48219},[],"/docs/deployment/self-hosted/networking#recommended-single-node-design","Recommended single-node design",{"_3328":279,"_29138":274,"_5":29458,"_20209":48221,"_26493":48222,"_2816":48223},[],"/docs/deployment/self-hosted/networking#k3s","K3s",{"_3328":280,"_29138":274,"_5":29458,"_20209":48225,"_26493":48226,"_2816":48227},[],"/docs/deployment/self-hosted/networking#bare-metal-with-metallb-or-kube-vip","Bare metal with MetalLB or kube-vip",{"_3328":281,"_29138":274,"_5":29458,"_20209":48229,"_26493":48230,"_2816":48231},[],"/docs/deployment/self-hosted/networking#external-reverse-proxy-nat-or-vpn","External reverse proxy, NAT or VPN",{"_3328":282,"_29138":274,"_5":29458,"_20209":48233,"_26493":48234,"_2816":48235},[],"/docs/deployment/self-hosted/networking#what-if-you-need-three-gateways","What if you need three Gateways?",{"_3328":283,"_29138":274,"_5":29458,"_20209":48237,"_26493":48238,"_2816":48239},[],"/docs/deployment/self-hosted/networking#decision-guide","Decision guide",{"_3328":284,"_29138":274,"_5":29458,"_20209":48241,"_26493":48242,"_2816":48243},[],"/docs/deployment/self-hosted/networking#egress-proxy","Egress proxy",{"_3328":285,"_29138":274,"_5":29458,"_20209":48245,"_26493":48246,"_2816":48247},[],"/docs/deployment/self-hosted/networking#verify-the-traffic-path","Verify the traffic path",{"_3328":286,"_29138":274,"_20209":48249,"_5":13819,"_26493":48210,"_2816":48250},[],"The Lamassu chart creates one shared Gateway with HTTP and HTTPS listeners. Envoy Gateway normally creates a dedicated proxy deployment and a `LoadBalancer` Service for it.",{"_3328":287,"_29138":274,"_20209":48252,"_5":13819,"_26493":48210,"_2816":48253},[],"External reachability is the result of the whole path. A `Gateway` resource alone does not configure your router, firewall, DNS, cloud load balancer or upstream NAT.",{"_3328":288,"_29138":274,"_20209":48255,"_5":13819,"_26493":48214,"_2816":48256},[],"Usually, no. If you omit it, the Gateway controller and the cluster load-balancer implementation can assign an address and report it in `Gateway.status.addresses` and the generated Service status.",{"_3328":289,"_29138":274,"_20209":48258,"_5":13819,"_26493":48214,"_2816":48259},[],"Set it only when:",{"_3328":290,"_29138":274,"_20209":48261,"_5":13819,"_26493":48214,"_2816":48262},[],"your cloud or bare-metal load balancer supports requesting a specific address",{"_3328":291,"_29138":274,"_20209":48264,"_5":13819,"_26493":48214,"_2816":48265},[],"that address is allocated to this Gateway",{"_3328":292,"_29138":274,"_20209":48267,"_5":13819,"_26493":48214,"_2816":48268},[],"the surrounding network already routes traffic for it to the cluster",{"_3328":293,"_29138":274,"_20209":48270,"_5":13819,"_26493":48214,"_2816":48271},[],"This requests `192.168.1.50`; it does not claim the IP on your LAN or make it reachable.",{"_3328":294,"_29138":274,"_20209":48273,"_5":13819,"_26493":48214,"_2816":48274},[],"Keep these two settings separate:",{"_3328":295,"_29138":274,"_20209":48276,"_5":13819,"_26493":48214,"_2816":48277},[],"`gateway.addresses` requests an address for the Gateway.",{"_3328":296,"_29138":274,"_20209":48279,"_5":13819,"_26493":48214,"_2816":48280},[],"`tls.certManagerOptions.certSpec.addresses` adds IP subject alternative names to the TLS certificate.",{"_3328":297,"_29138":274,"_20209":48282,"_5":13819,"_26493":48214,"_2816":48283},[],"If users connect by DNS name, put that name in `tls.certManagerOptions.certSpec.hostnames`. Do not copy an upstream proxy's public IP into `gateway.addresses`.",{"_3328":298,"_29138":274,"_20209":48285,"_5":13819,"_26493":48218,"_2816":48286},[],"For a small VM running K3s or MicroK8s, use one external Lamassu Gateway and route every Lamassu endpoint through it:",{"_3328":299,"_29138":274,"_20209":48288,"_5":13819,"_26493":48218,"_2816":48289},[],"This design uses one IP, one TLS entry point and one pair of ports. The chart already creates the required routes.",{"_3328":300,"_29138":274,"_20209":48291,"_5":13819,"_26493":48222,"_2816":48292},[],"K3s ServiceLB implements each `LoadBalancer` Service with pods that reserve the Service ports on the node. On a single node, only one Service can therefore own port 80 and one can own port 443. The default K3s Traefik Service may already hold both ports.",{"_3328":301,"_29138":274,"_20209":48294,"_5":13819,"_26493":48222,"_2816":48295},[],"For the recommended design:",{"_3328":302,"_29138":274,"_20209":48297,"_5":13819,"_26493":48222,"_2816":48298},[],"Use only one externally exposed Lamassu Gateway.",{"_3328":303,"_29138":274,"_20209":48300,"_5":13819,"_26493":48222,"_2816":48301},[],"Ensure ports 80 and 443 are free. Disable or reconfigure Traefik if it is not part of your traffic path.",{"_3328":304,"_29138":274,"_20209":48303,"_5":13819,"_26493":48222,"_2816":48304},[],"Allow those ports through the VM firewall and any upstream security group.",{"_3328":305,"_29138":274,"_20209":48306,"_5":13819,"_26493":48222,"_2816":48307},[],"Point DNS at the VM's reachable address.",{"_3328":306,"_29138":274,"_20209":48309,"_5":13819,"_26493":48222,"_2816":48310},[],"See the K3s ServiceLB documentation for its host-port behavior and how to replace it with another load-balancer implementation.",{"_3328":307,"_29138":274,"_20209":48312,"_5":13819,"_26493":48226,"_2816":48313},[],"Allocate a VIP from an address pool reachable on your LAN. You may request that VIP with `gateway.addresses` if the selected implementation supports it. Confirm the assigned address in status rather than assuming the request succeeded.",{"_3328":308,"_29138":274,"_20209":48315,"_5":13819,"_26493":48230,"_2816":48316},[],"An external public address can forward TCP 80 and 443 to the VM or to a Kubernetes-side VIP:",{"_3328":309,"_29138":274,"_20209":48318,"_5":13819,"_26493":48230,"_2816":48319},[],"The public IP belongs to the external device. Leave `gateway.addresses` unset or set it to the actual Kubernetes-side address, never to an address that the cluster cannot bind.",{"_3328":310,"_29138":274,"_20209":48321,"_5":13819,"_26493":48234,"_2816":48322},[],"First decide whether you need three independent data planes or only three hostnames.",{"_3328":311,"_29138":274,"_20209":48324,"_5":13819,"_26493":48234,"_2816":48325},[],"Requirement",{"_3328":312,"_29138":274,"_20209":48327,"_5":13819,"_26493":48234,"_2816":48328},[],"Recommended design",{"_3328":313,"_29138":274,"_20209":48330,"_5":13819,"_26493":48234,"_2816":48331},[],"Consequence",{"_3328":314,"_29138":274,"_20209":48333,"_5":13819,"_26493":48234,"_2816":48334},[],"Several Lamassu URLs or services",{"_3328":315,"_29138":274,"_20209":48336,"_5":13819,"_26493":48234,"_2816":48337},[],"One Gateway with multiple routes",{"_3328":316,"_29138":274,"_20209":48339,"_5":13819,"_26493":48234,"_2816":48340},[],"One IP and one proxy fleet; this is the chart default",{"_3328":317,"_29138":274,"_20209":48342,"_5":13819,"_26493":48234,"_2816":48343},[],"Independent Gateways and separate external IPs",{"_3328":318,"_29138":274,"_20209":48345,"_5":13819,"_26493":48234,"_2816":48346},[],"One VIP per Gateway",{"_3328":319,"_29138":274,"_20209":48348,"_5":13819,"_26493":48234,"_2816":48349},[],"All Gateways can use 80/443; requires a load balancer with an address pool",{"_3328":320,"_29138":274,"_20209":48351,"_5":13819,"_26493":48234,"_2816":48352},[],"Independent Gateways on one node and one IP",{"_3328":321,"_29138":274,"_20209":48354,"_5":13819,"_26493":48234,"_2816":48355},[],"Use different external ports",{"_3328":322,"_29138":274,"_20209":48357,"_5":13819,"_26493":48234,"_2816":48358},[],"Clients must include non-standard ports",{"_3328":323,"_29138":274,"_20209":48360,"_5":13819,"_26493":48234,"_2816":48361},[],"Separate TLS/mTLS termination behind one IP",{"_3328":324,"_29138":274,"_20209":48363,"_5":13819,"_26493":48234,"_2816":48364},[],"Front-door SNI routing to internal Gateways",{"_3328":325,"_29138":274,"_20209":48366,"_5":13819,"_26493":48234,"_2816":48367},[],"Advanced design; the front door uses TLS passthrough and each internal Gateway terminates its own TLS",{"_3328":326,"_29138":274,"_20209":48369,"_5":13819,"_26493":48234,"_2816":48370},[],"Separate Gateway resources but shared proxy infrastructure",{"_3328":327,"_29138":274,"_20209":48372,"_5":13819,"_26493":48234,"_2816":48373},[],"Envoy merged-Gateway mode",{"_3328":328,"_29138":274,"_20209":48375,"_5":13819,"_26493":48234,"_2816":48376},[],"Logical separation only; listeners must have unique port, protocol and hostname tuples",{"_3328":329,"_29138":274,"_20209":48378,"_5":13819,"_26493":48234,"_2816":48379},[],"Three independent `LoadBalancer` Services cannot all reserve the same node ports 80 and 443 through K3s ServiceLB. Use one shared Gateway, allocate distinct VIPs with another load-balancer implementation, or use different ports.",{"_3328":330,"_29138":274,"_20209":48381,"_5":13819,"_26493":48234,"_2816":48382},[],"Envoy Gateway normally provisions a proxy fleet per `Gateway`. Its merged-Gateway mode can share one fleet and address, but it is not a drop-in switch for multiple Lamassu releases: the generated Lamassu listeners use the same ports and protocols without distinct hostnames, so they conflict unless you deliberately customize the listener design.",{"_3328":331,"_29138":274,"_20209":48384,"_5":13819,"_26493":48234,"_2816":48385},[],"Use a front-door SNI design only when the internal Gateways must retain independent TLS or mTLS policy:",{"_3328":332,"_29138":274,"_20209":48387,"_5":13819,"_26493":48234,"_2816":48388},[],"This requires distinct SNI hostnames and cluster networking outside the Lamassu chart.",{"_3328":333,"_29138":274,"_20209":48390,"_5":13819,"_26493":48238,"_2816":48391},[],"If one Gateway can own TLS and routing, use the chart default.",{"_3328":334,"_29138":274,"_20209":48393,"_5":13819,"_26493":48238,"_2816":48394},[],"If Gateways need independent policy and you can allocate IPs, use one VIP per Gateway.",{"_3328":335,"_29138":274,"_20209":48396,"_5":13819,"_26493":48238,"_2816":48397},[],"If only the Kubernetes resources need separation, evaluate merged-Gateway mode and make every listener tuple unique.",{"_3328":336,"_29138":274,"_20209":48399,"_5":13819,"_26493":48238,"_2816":48400},[],"If data planes and TLS termination must stay independent behind one IP, add a front-door SNI passthrough layer.",{"_3328":337,"_29138":274,"_20209":48402,"_5":13819,"_26493":48238,"_2816":48403},[],"If none of those are possible, use different external ports or change the external network design.",{"_3328":338,"_29138":274,"_20209":48405,"_5":13819,"_26493":48242,"_2816":48406},[],"Internal Lamassu clients — the Vault engine connection, service-to-service calls and webhook deliveries — honor the `HTTP_PROXY`, `HTTPS_PROXY` and `NO_PROXY` environment variables. The exception is the authorization-engine connector: it uses its own transport and does not consult these proxy variables. If your deployment routes egress through a proxy, list in-cluster service names in `NO_PROXY` (for example `.svc,.cluster.local`) so internal traffic stays inside the cluster. Loopback traffic is never sent through a proxy.",{"_3328":339,"_29138":274,"_20209":48408,"_5":13819,"_26493":48242,"_2816":48409},[],"The default transport of these clients bounds the dial timeout (30 seconds), the TLS handshake (10 seconds) and idle connection reuse (90 seconds) so an unreachable dependency fails fast instead of hanging; these values are Go transport defaults, not Lamassu settings. HTTP/2 is negotiated when the peer supports it. The authorization-engine connector keeps its own transport without these dial and handshake timeouts; only its overall 30-second request timeout bounds each call.",{"_3328":340,"_29138":274,"_20209":48411,"_5":13819,"_26493":48246,"_2816":48412},[],"Check, in order:",{"_3328":341,"_29138":274,"_20209":48414,"_5":13819,"_26493":48246,"_2816":48415},[],"`Gateway` has `Accepted=True` and `Programmed=True`.",{"_3328":342,"_29138":274,"_20209":48417,"_5":13819,"_26493":48246,"_2816":48418},[],"Its status contains the expected address.",{"_3328":343,"_29138":274,"_20209":48420,"_5":13819,"_26493":48246,"_2816":48421},[],"The generated `LoadBalancer` Service has a usable external address.",{"_3328":344,"_29138":274,"_20209":48423,"_5":13819,"_26493":48246,"_2816":48424},[],"Port 443 reaches that address from the client network.",{"_3328":345,"_29138":274,"_20209":48426,"_5":13819,"_26493":48246,"_2816":48427},[],"DNS resolves to the externally reachable endpoint.",{"_3328":346,"_29138":274,"_20209":48429,"_5":13819,"_26493":48246,"_2816":48430},[],"The certificate contains the DNS name or IP used by the client.",{"_3328":347,"_29138":274,"_20209":48432,"_5":13819,"_26493":48246,"_2816":48433},[],"The Gateway API treats addresses as desired state that a controller may assign or reject; see the Gateway API overview for the resource model.",{"_3328":348,"_29138":348,"_5":14177,"_2816":47504,"_29461":48435,"_20209":48436,"_26493":348},[47397,47398,47504],[],{"_3328":349,"_29138":348,"_20209":48438,"_5":13819,"_26493":348,"_2816":48439},[],"Choose an installation workflow and network architecture for Lamassu on your Kubernetes cluster.",{"_3328":350,"_29138":348,"_5":29458,"_20209":48441,"_26493":48442,"_2816":48443},[],"/docs/deployment/self-hosted/overview#self-managed-kubernetes-deployment","Self-managed Kubernetes deployment",{"_3328":351,"_29138":348,"_5":29458,"_20209":48445,"_26493":48446,"_2816":48447},[],"/docs/deployment/self-hosted/overview#choose-an-installation-workflow","Choose an installation workflow",{"_3328":352,"_29138":348,"_5":29458,"_20209":48449,"_26493":48450,"_2816":48451},[],"/docs/deployment/self-hosted/overview#what-the-lamassu-chart-provides","What the Lamassu chart provides",{"_3328":353,"_29138":348,"_5":29458,"_20209":48453,"_26493":48454,"_2816":48455},[],"/docs/deployment/self-hosted/overview#how-the-deployment-fits-together","How the deployment fits together",{"_3328":354,"_29138":348,"_5":29458,"_20209":48457,"_26493":48458,"_2816":48459},[],"/docs/deployment/self-hosted/overview#platform-requirements","Platform requirements",{"_3328":355,"_29138":348,"_5":29458,"_20209":48461,"_26493":48462,"_2816":48463},[],"/docs/deployment/self-hosted/overview#choose-the-next-page","Choose the next page",{"_3328":356,"_29138":348,"_20209":48465,"_5":13819,"_26493":48442,"_2816":48466},[],"Run Lamassu in a Kubernetes cluster operated by your team. The Helm chart deploys the Lamassu services and their routing resources; you provide the cluster, persistent storage, identity provider, PostgreSQL, RabbitMQ and the network path used by clients.",{"_3328":357,"_29138":348,"_20209":48468,"_5":13819,"_26493":48446,"_2816":48469},[],"Workflow",{"_3328":358,"_29138":348,"_20209":48471,"_5":13819,"_26493":48446,"_2816":48472},[],"Use it for",{"_3328":359,"_29138":348,"_20209":48474,"_5":13819,"_26493":48446,"_2816":48475},[],"What it installs",{"_3328":360,"_29138":348,"_20209":48477,"_5":13819,"_26493":48446,"_2816":48478},[],"Helm",{"_3328":361,"_29138":348,"_20209":48480,"_5":13819,"_26493":48446,"_2816":48481},[],"Production and controlled environments",{"_3328":362,"_29138":348,"_20209":48483,"_5":13819,"_26493":48446,"_2816":48484},[],"Lamassu services and Gateway API resources",{"_3328":363,"_29138":348,"_20209":48486,"_5":13819,"_26493":48446,"_2816":47641},[],{"_3328":364,"_29138":348,"_20209":48488,"_5":13819,"_26493":48446,"_2816":48489},[],"Evaluation, demos, CI and small lab clusters",{"_3328":365,"_29138":348,"_20209":48491,"_5":13819,"_26493":48446,"_2816":48492},[],"PostgreSQL, Keycloak, RabbitMQ, Envoy Gateway and Lamassu",{"_3328":366,"_29138":348,"_20209":48494,"_5":13819,"_26493":48450,"_2816":48495},[],"The Lamassu chart is an **application chart**, not a cluster bootstrap chart. It creates the Kubernetes resources that run and configure Lamassu, but it expects the platform services those resources depend on to exist.",{"_3328":367,"_29138":348,"_20209":48497,"_5":13819,"_26493":48450,"_2816":48498},[],"Area",{"_3328":368,"_29138":348,"_20209":48500,"_5":13819,"_26493":48450,"_2816":48501},[],"The Lamassu chart provides",{"_3328":369,"_29138":348,"_20209":48503,"_5":13819,"_26493":48450,"_2816":48504},[],"You provide",{"_3328":370,"_29138":348,"_20209":48506,"_5":13819,"_26493":48450,"_2816":48507},[],"Lamassu applications",{"_3328":371,"_29138":348,"_20209":48509,"_5":13819,"_26493":48450,"_2816":48510},[],"Deployments and StatefulSets for the UI and APIs, internal Services, ConfigMaps, a ServiceAccount, and optional HPAs and PDBs",{"_3328":372,"_29138":348,"_20209":48512,"_5":13819,"_26493":48450,"_2816":48513},[],"A working Kubernetes cluster, compute capacity and access to the container images",{"_3328":373,"_29138":348,"_20209":48515,"_5":13819,"_26493":48450,"_2816":48516},[],"PostgreSQL data",{"_3328":374,"_29138":348,"_20209":48518,"_5":13819,"_26493":48450,"_2816":48519},[],"A pre-install/pre-upgrade job that creates the required databases and schemas, runs migrations and applies the authorization bootstrap",{"_3328":375,"_29138":348,"_20209":48521,"_5":13819,"_26493":48450,"_2816":48522},[],"A reachable PostgreSQL server, credentials allowed to create databases and schemas, and backup/HA operations",{"_3328":376,"_29138":348,"_20209":48524,"_5":13819,"_26493":48450,"_2816":48525},[],"Messaging",{"_3328":377,"_29138":348,"_20209":48527,"_5":13819,"_26493":48450,"_2816":48528},[],"RabbitMQ connection configuration for the Lamassu services; the connection can use AMQPS, with an optional private CA and an optional client certificate, both set through chart values",{"_3328":378,"_29138":348,"_20209":48530,"_5":13819,"_26493":48450,"_2816":48531},[],"A reachable RabbitMQ broker, credentials and its lifecycle",{"_3328":379,"_29138":348,"_20209":48533,"_5":13819,"_26493":48450,"_2816":48534},[],"Identity",{"_3328":380,"_29138":348,"_20209":48536,"_5":13819,"_26493":48450,"_2816":48537},[],"OIDC/JWT and external-authorization configuration, plus initial Lamassu authorization principals",{"_3328":381,"_29138":348,"_20209":48539,"_5":13819,"_26493":48450,"_2816":48540},[],"An OIDC provider, realm/tenant, client, users, groups and roles",{"_3328":382,"_29138":348,"_20209":48542,"_5":13819,"_26493":48450,"_2816":48543},[],"External routing",{"_3328":383,"_29138":348,"_20209":48545,"_5":13819,"_26493":48450,"_2816":48546},[],"One `Gateway`, `HTTPRoute` resources, an `EnvoyProxy` configuration and Envoy security policies",{"_3328":384,"_29138":348,"_20209":48548,"_5":13819,"_26493":48450,"_2816":48549},[],"Gateway API and Envoy CRDs, the Envoy Gateway controller, a `GatewayClass`, a load-balancer implementation and the external network path",{"_3328":385,"_29138":348,"_20209":48551,"_5":13819,"_26493":48450,"_2816":48552},[],"TLS",{"_3328":386,"_29138":348,"_20209":48554,"_5":13819,"_26493":48450,"_2816":48555},[],"In the default `tls.type: certManager` mode, cert-manager `Issuer` and CA `Certificate` resources and a chart-managed downstream `Certificate`; in the `tls.type: external` mode, a reference to your TLS Secret",{"_3328":387,"_29138":348,"_20209":48557,"_5":13819,"_26493":48450,"_2816":48558},[],"cert-manager only for the default `tls.type: certManager` mode; for trusted TLS, a trusted issuer or a populated TLS Secret",{"_3328":388,"_29138":348,"_20209":48560,"_5":13819,"_26493":48450,"_2816":48561},[],"Persistent application data",{"_3328":389,"_29138":348,"_20209":48563,"_5":13819,"_26493":48450,"_2816":48564},[],"PersistentVolumeClaims required by the default local KMS and VA storage",{"_3328":390,"_29138":348,"_20209":48566,"_5":13819,"_26493":48450,"_2816":48567},[],"A StorageClass, physical storage, backups and a shared/external backend when scaling requires one",{"_3328":391,"_29138":348,"_20209":48569,"_5":13819,"_26493":48450,"_2816":48570},[],"Optional integrations",{"_3328":392,"_29138":348,"_20209":48572,"_5":13819,"_26493":48450,"_2816":48573},[],"Configuration hooks for observability, AWS connectors and PKCS#11/HSM connectivity",{"_3328":393,"_29138":348,"_20209":48575,"_5":13819,"_26493":48450,"_2816":48576},[],"The observability backends, cloud credentials and production HSM or external key service",{"_3328":394,"_29138":348,"_20209":48578,"_5":13819,"_26493":48450,"_2816":48579},[],"The chart creates Lamassu's `Gateway` and routes. It does not install the Envoy Gateway controller or make the generated `LoadBalancer` Service reachable from your network.",{"_3328":395,"_29138":348,"_20209":48581,"_5":13819,"_26493":48450,"_2816":48582},[],"Use one Lamassu Gateway on ports 80 and 443 and let its HTTPRoutes dispatch traffic to every Lamassu service. Give that Gateway one externally reachable endpoint through the cluster load balancer, or forward traffic to it from an external proxy or NAT device. You do not need one Gateway per service.",{"_3328":396,"_29138":348,"_20209":48584,"_5":13819,"_26493":48454,"_2816":48585},[],"The chart creates one shared `Gateway` per Helm release. All chart-managed `HTTPRoute` resources attach to it. Envoy Gateway provisions the proxy data plane and a Kubernetes `LoadBalancer` Service for that Gateway.",{"_3328":397,"_29138":348,"_20209":48587,"_5":13819,"_26493":48454,"_2816":48588},[],"The `gateway.addresses` value is only an address request to the Gateway controller. It does not make an IP routable, open a firewall, configure DNS or create NAT. See Expose the Gateway before setting it.",{"_3328":398,"_29138":348,"_20209":48590,"_5":13819,"_26493":48458,"_2816":48591},[],"Kubernetes 1.24 or newer",{"_3328":399,"_29138":348,"_20209":48593,"_5":13819,"_26493":48458,"_2816":48594},[],"Helm 3.2 or newer",{"_3328":400,"_29138":348,"_20209":48596,"_5":13819,"_26493":48458,"_2816":48597},[],"Envoy Gateway 1.8 or newer and a `GatewayClass`",{"_3328":401,"_29138":348,"_20209":48599,"_5":13819,"_26493":48458,"_2816":48600},[],"cert-manager 1.14 or newer; required only for the default `tls.type: certManager` TLS mode, not for `tls.type: external`",{"_3328":402,"_29138":348,"_20209":48602,"_5":13819,"_26493":48458,"_2816":48603},[],"persistent storage suitable for the selected PostgreSQL, RabbitMQ, VA and KMS configuration",{"_3328":403,"_29138":348,"_20209":48605,"_5":13819,"_26493":48458,"_2816":48606},[],"a load-balancer implementation or another deliberate path from clients to the Gateway",{"_3328":404,"_29138":348,"_20209":48608,"_5":13819,"_26493":48458,"_2816":48609},[],"KMS deployments using the native PKCS#11 sidecar require Kubernetes 1.29 or newer. Prebuilt Lamassu container images are published for `linux/amd64` and `linux/arm64`, and the KMS PKCS#11 client module (`p11-kit-client.so`) is installed at the target architecture's Debian library path: `/usr/lib/x86_64-linux-gnu/pkcs11/p11-kit-client.so` on amd64 and `/usr/lib/aarch64-linux-gnu/pkcs11/p11-kit-client.so` on arm64. The x86\\_64 path is retained as a compatibility alias for existing configurations.",{"_3328":405,"_29138":348,"_20209":48611,"_5":13819,"_26493":48462,"_2816":48612},[],"<Card title=\"Install with Helm\" description=\"Prepare dependencies, configure values, install and verify a controlled deployment.\" href=\"/docs/deployment/self-hosted/helm\" />",{"_3328":406,"_29138":348,"_20209":48614,"_5":13819,"_26493":48462,"_2816":48615},[],"<Card title=\"Upgrade from 3.8.0\" description=\"Upgrade an existing Helm release to 4.0.0: architecture changes, breaking changes, migration steps and validation.\" href=\"/docs/upgrades/3-8-0-to-4-0-0\" />",{"_3328":407,"_29138":348,"_20209":48617,"_5":13819,"_26493":48462,"_2816":48618},[],"<Card title=\"Expose the Gateway\" description=\"Choose an external traffic design, understand gateway.addresses and handle multiple Gateways.\" href=\"/docs/deployment/self-hosted/networking\" />",{"_3328":408,"_29138":348,"_20209":48620,"_5":13819,"_26493":48462,"_2816":48621},[],"<Card title=\"Use Fastlane\" description=\"Bootstrap a complete evaluation or lab environment with one script.\" href=\"/docs/deployment/self-hosted/fastlane\" />",{"_3328":409,"_29138":409,"_5":14177,"_2816":48623,"_29461":48624,"_20209":48626,"_26493":409},"Deployment troubleshooting",[47397,47398,48625],"Operations",[],{"_3328":410,"_29138":409,"_20209":48628,"_5":13819,"_26493":409,"_2816":48629},[],"Diagnose access, service health and infrastructure dependencies.",{"_3328":411,"_29138":409,"_5":29458,"_20209":48631,"_26493":48632,"_2816":48633},[],"/docs/deployment/troubleshooting#diagnostic-sequence","Diagnostic sequence",{"_3328":412,"_29138":409,"_5":29458,"_20209":48635,"_26493":48636,"_2816":48637},[],"/docs/deployment/troubleshooting#reproduce-a-single-operation","Reproduce a single operation",{"_3328":413,"_29138":409,"_5":29458,"_20209":48639,"_26493":48640,"_2816":48641},[],"/docs/deployment/troubleshooting#separate-client-gateway-and-service","Separate client, Gateway and service",{"_3328":414,"_29138":409,"_5":29458,"_20209":48643,"_26493":48644,"_2816":48645},[],"/docs/deployment/troubleshooting#review-kubernetes-status","Review Kubernetes status",{"_3328":415,"_29138":409,"_5":29458,"_20209":48647,"_26493":48648,"_2816":48649},[],"/docs/deployment/troubleshooting#query-the-affected-service","Query the affected service",{"_3328":416,"_29138":409,"_5":29458,"_20209":48651,"_26493":48652,"_2816":48653},[],"/docs/deployment/troubleshooting#validate-the-result-from-outside","Validate the result from outside",{"_3328":417,"_29138":409,"_5":29458,"_20209":48655,"_26493":48656,"_2816":48657},[],"/docs/deployment/troubleshooting#minimal-evidence-collection","Minimal evidence collection",{"_3328":418,"_29138":409,"_5":29458,"_20209":48659,"_26493":48660,"_2816":48661},[],"/docs/deployment/troubleshooting#i-cannot-sign-in","I cannot sign in",{"_3328":419,"_29138":409,"_5":29458,"_20209":48663,"_26493":48664,"_2816":48665},[],"/docs/deployment/troubleshooting#everything-returns-403-or-5xx","Everything returns 403 or 5xx",{"_3328":420,"_29138":409,"_5":29458,"_20209":48667,"_26493":48668,"_2816":48669},[],"/docs/deployment/troubleshooting#api-500-errors","API 500 errors",{"_3328":421,"_29138":409,"_5":29458,"_20209":48671,"_26493":48672,"_2816":48673},[],"/docs/deployment/troubleshooting#a-pod-is-not-ready","A pod is not Ready",{"_3328":422,"_29138":409,"_5":29458,"_20209":48675,"_26493":48676,"_2816":48677},[],"/docs/deployment/troubleshooting#events-are-not-arriving","Events are not arriving",{"_3328":423,"_29138":409,"_5":29458,"_20209":48679,"_26493":48680,"_2816":48681},[],"/docs/deployment/troubleshooting#observability","Observability",{"_3328":424,"_29138":409,"_20209":48683,"_5":13819,"_26493":409,"_2816":48684},[],"Start by locating the failing layer. A Gateway response and an unready pod require different evidence. For rejected issuance or validation results, see PKI troubleshooting; for enrollment, see EST diagnostics.",{"_3328":425,"_29138":409,"_20209":48686,"_5":13819,"_26493":48636,"_2816":48687},[],"Note the time in UTC, user or principal, resource, endpoint and result. Avoid repeating a destructive action such as revocation or deletion.",{"_3328":426,"_29138":409,"_20209":48689,"_5":13819,"_26493":48640,"_2816":48690},[],"Check the HTTP status. A 401 points to authentication; a 403, to authorization; a 404, to route or resource; a 5xx, to the service or a dependency.",{"_3328":427,"_29138":409,"_20209":48692,"_5":13819,"_26493":48644,"_2816":48693},[],"Locate unready pods, restarts, recent events and the state of the release.",{"_3328":428,"_29138":409,"_20209":48695,"_5":13819,"_26493":48648,"_2816":48696},[],"Review its /health endpoint and its logs in the same time window. Then follow the indicated dependency: PostgreSQL, RabbitMQ, the OIDC provider or the cryptographic engine.",{"_3328":429,"_29138":409,"_20209":48698,"_5":13819,"_26493":48652,"_2816":48699},[],"For PKI, check the certificate, the chain, OCSP or CRL with the same type of client production uses.",{"_3328":430,"_29138":409,"_20209":48701,"_5":13819,"_26493":48656,"_2816":48702},[],"Replace the placeholders with your real release, namespace and deployment.",{"_3328":431,"_29138":409,"_20209":48704,"_5":13819,"_26493":48656,"_2816":48705},[],"Also run the chart's connectivity test:",{"_3328":432,"_29138":409,"_20209":48707,"_5":13819,"_26493":48656,"_2816":48708},[],"The test checks the health of CA, DMS Manager, Device Manager and VA, and verifies that the UI returns HTML. A passing test confirms basic connectivity, not a full issuance flow.",{"_3328":433,"_29138":409,"_20209":48710,"_5":13819,"_26493":48656,"_2816":48711},[],"The chart's services expose startup, readiness and liveness probes over /health. A pod can be running but receive no traffic if the readiness probe fails.",{"_3328":434,"_29138":409,"_20209":48713,"_5":13819,"_26493":48660,"_2816":48714},[],"If you receive a 401:",{"_3328":435,"_29138":409,"_20209":48716,"_5":13819,"_26493":48660,"_2816":48717},[],"check that the UI's OIDC authority is reachable from the browser;",{"_3328":436,"_29138":409,"_20209":48719,"_5":13819,"_26493":48660,"_2816":48720},[],"verify issuer, audience and expiration of the token;",{"_3328":437,"_29138":409,"_20209":48722,"_5":13819,"_26493":48660,"_2816":48723},[],"confirm the Gateway can fetch the keys from the JWKS URI;",{"_3328":438,"_29138":409,"_20209":48725,"_5":13819,"_26493":48660,"_2816":48726},[],"check that the provider's public and internal routes point to the same realm.",{"_3328":439,"_29138":409,"_20209":48728,"_5":13819,"_26493":48660,"_2816":48729},[],"If login succeeds but the APIs return 403:",{"_3328":440,"_29138":409,"_20209":48731,"_5":13819,"_26493":48660,"_2816":48732},[],"inspect the token's real claims;",{"_3328":441,"_29138":409,"_20209":48734,"_5":13819,"_26493":48660,"_2816":48735},[],"confirm they match an active principal;",{"_3328":442,"_29138":409,"_20209":48737,"_5":13819,"_26493":48660,"_2816":48738},[],"review the policies granted to that principal;",{"_3328":443,"_29138":409,"_20209":48740,"_5":13819,"_26493":48660,"_2816":48741},[],"verify that authz reaches PostgreSQL and its JWKS.",{"_3328":444,"_29138":409,"_20209":48743,"_5":13819,"_26493":48660,"_2816":48744},[],"On a fresh installation, confirm the migration Job finished. That Job creates schemas, migrates authz, preloads policies and provisions the principals defined in services.authz.bootstrap.",{"_3328":445,"_29138":409,"_20209":48746,"_5":13819,"_26493":48664,"_2816":48747},[],"External authorization fails closed by default. If authz is unavailable, protected routes are blocked.",{"_3328":446,"_29138":409,"_20209":48749,"_5":13819,"_26493":48664,"_2816":48750},[],"Locate the authz pod and Service.",{"_3328":447,"_29138":409,"_20209":48752,"_5":13819,"_26493":48664,"_2816":48753},[],"Check /health, logs and its database connection.",{"_3328":448,"_29138":409,"_20209":48755,"_5":13819,"_26493":48664,"_2816":48756},[],"Verify the DNS and port configured in externalAuthorization.",{"_3328":449,"_29138":409,"_20209":48758,"_5":13819,"_26493":48664,"_2816":48759},[],"Check the check route is /v1/ext\\_authz/check.",{"_3328":450,"_29138":409,"_20209":48761,"_5":13819,"_26493":48664,"_2816":48762},[],"Do not switch to failOpen: true as a permanent workaround: it would allow traffic without authorization during the outage.",{"_3328":451,"_29138":409,"_20209":48764,"_5":13819,"_26493":48668,"_2816":48765},[],"A 500 indicates an internal failure, such as an unavailable database. The `{\"err\": ...}` body currently includes the text of the internal error, which can contain schema, table and constraint names and, on connection failures, the database host and user (not the password). Find the cause in the service log using the request time, and do not forward the body to third parties or show it to end users. This is a known information-disclosure defect: generic messages are planned for 500 responses, keeping the detail only in the service log (tracked in lamassuiot#814). The authorization connector also returns the internal error, in the `details.error` field. Some request errors, such as a key size the engine does not support, are also returned as 500.",{"_3328":452,"_29138":409,"_20209":48767,"_5":13819,"_26493":48672,"_2816":48768},[],"Review kubectl describe pod first. Common causes are:",{"_3328":453,"_29138":409,"_20209":48770,"_5":13819,"_26493":48672,"_2816":48771},[],"wrong credentials or DNS for PostgreSQL or RabbitMQ;",{"_3328":454,"_29138":409,"_20209":48773,"_5":13819,"_26493":48672,"_2816":48774},[],"a missing AMQP CA or client certificate Secret referenced by `amqp.ca.secretName` or `amqp.client.secretName`;",{"_3328":455,"_29138":409,"_20209":48776,"_5":13819,"_26493":48672,"_2816":48777},[],"unbound persistent volume;",{"_3328":456,"_29138":409,"_20209":48779,"_5":13819,"_26493":48672,"_2816":48780},[],"inaccessible image or incorrect pull policy;",{"_3328":457,"_29138":409,"_20209":48782,"_5":13819,"_26493":48672,"_2816":48783},[],"invalid cryptographic engine configuration;",{"_3328":458,"_29138":409,"_20209":48785,"_5":13819,"_26493":48672,"_2816":48786},[],"CPU or memory limits set too low;",{"_3328":459,"_29138":409,"_20209":48788,"_5":13819,"_26493":48672,"_2816":48789},[],"an incomplete prior migration.",{"_3328":460,"_29138":409,"_20209":48791,"_5":13819,"_26493":48672,"_2816":48792},[],"Generic values request 100 mCPU and 128 MiB and limit to 500 mCPU and 512 MiB. Tune per service when you see OOMKills, throttling or slow startups.",{"_3328":461,"_29138":409,"_20209":48794,"_5":13819,"_26493":48672,"_2816":48795},[],"Filesystem-based KMS engines and VA local storage use exclusive-access volumes. Keep a single replica or migrate to shared backends before enabling autoscaling.",{"_3328":462,"_29138":409,"_20209":48797,"_5":13819,"_26493":48672,"_2816":48798},[],"Internal calls now fail fast instead of hanging for the clients covered by Egress proxy: connection attempts time out after 30 seconds and TLS handshakes after 10 seconds. The authorization-engine connector keeps its own transport without these dial and handshake timeouts; only its overall 30-second request timeout bounds each call. If an egress proxy handles the cluster's outbound traffic, check the pod's `HTTP_PROXY`, `HTTPS_PROXY` and `NO_PROXY` environment variables and list in-cluster service names in `NO_PROXY`.",{"_3328":463,"_29138":409,"_20209":48800,"_5":13819,"_26493":48676,"_2816":48801},[],"Domain and audit events depend on the bus publisher:",{"_3328":464,"_29138":409,"_20209":48803,"_5":13819,"_26493":48676,"_2816":48804},[],"verify it is enabled in the emitting service;",{"_3328":465,"_29138":409,"_20209":48806,"_5":13819,"_26493":48676,"_2816":48807},[],"check AMQP connectivity and credentials;",{"_3328":466,"_29138":409,"_20209":48809,"_5":13819,"_26493":48676,"_2816":48810},[],"review exchange, routing key, queues and consumers;",{"_3328":467,"_29138":409,"_20209":48812,"_5":13819,"_26493":48676,"_2816":48813},[],"inspect dead-letter queues;",{"_3328":468,"_29138":409,"_20209":48815,"_5":13819,"_26493":48676,"_2816":48816},[],"alert on orphan durable queues and backlog growth.",{"_3328":469,"_29138":409,"_20209":48818,"_5":13819,"_26493":48676,"_2816":48819},[],"If `amqp.tls` is enabled, verify the TLS side as well:",{"_3328":470,"_29138":409,"_20209":48821,"_5":13819,"_26493":48676,"_2816":48822},[],"confirm the broker listener speaks AMQPS on the configured port — the default port stays `5672` and does not follow TLS automatically;",{"_3328":471,"_29138":409,"_20209":48824,"_5":13819,"_26493":48676,"_2816":48825},[],"if you set `amqp.ca.secretName`, confirm the Secret exists in the release namespace and its data key matches `amqp.ca.certificateKey` (default `ca.crt`); if `amqp.ca.secretName` is not set, the clients trust the system CAs;",{"_3328":472,"_29138":409,"_20209":48827,"_5":13819,"_26493":48676,"_2816":48828},[],"remember that a missing referenced Secret prevents the consuming pods from starting;",{"_3328":473,"_29138":409,"_20209":48830,"_5":13819,"_26493":48676,"_2816":48831},[],"after updating the CA or client certificate Secret, restart the consuming pods: the AMQP client loads certificates at startup.",{"_3328":474,"_29138":409,"_20209":48833,"_5":13819,"_26493":48676,"_2816":48834},[],"See AMQP TLS (AMQPS) for the full configuration.",{"_3328":475,"_29138":409,"_20209":48836,"_5":13819,"_26493":48676,"_2816":48837},[],"A consumer outage does not always prevent the main operation from completing. That is why you must monitor RabbitMQ and independently verify the persistence of audit logs.",{"_3328":476,"_29138":409,"_20209":48839,"_5":13819,"_26493":48680,"_2816":48840},[],"The chart can enable OpenTelemetry instrumentation for the services that support it, including authz; it does not configure OpenTelemetry for AWS Connector, wfx or the UI. Traces are exported over OTLP HTTP and logs can be directed to a compatible endpoint, such as VictoriaLogs. Use a correlation identifier and the same time window to join Gateway, service and dependency.",{"_3328":477,"_29138":409,"_20209":48842,"_5":13819,"_26493":48680,"_2816":48843},[],"Before closing an incident, record:",{"_3328":478,"_29138":409,"_20209":48845,"_5":13819,"_26493":48680,"_2816":48846},[],"the confirmed cause;",{"_3328":479,"_29138":409,"_20209":48848,"_5":13819,"_26493":48680,"_2816":48849},[],"the time scope and affected resources;",{"_3328":480,"_29138":409,"_20209":48851,"_5":13819,"_26493":48680,"_2816":48852},[],"the commands or queries used;",{"_3328":481,"_29138":409,"_20209":48854,"_5":13819,"_26493":48680,"_2816":48855},[],"the applied change and how to revert it;",{"_3328":482,"_29138":409,"_20209":48857,"_5":13819,"_26493":48680,"_2816":48858},[],"validation from a consumer;",{"_3328":483,"_29138":409,"_20209":48860,"_5":13819,"_26493":48680,"_2816":48861},[],"the preventive action and its owner.",{"_3328":484,"_29138":484,"_5":14177,"_2816":48863,"_29461":48864,"_20209":48867,"_26493":484},"Access control",[47397,48865,48866],"Platform","Administration",[],{"_3328":485,"_29138":484,"_20209":48869,"_5":13819,"_26493":484,"_2816":48870},[],"Design who can access Lamassu through principals, policies, resource permissions and HTTP route authorization.",{"_3328":486,"_29138":484,"_5":29458,"_20209":48872,"_26493":48873,"_2816":48874},[],"/docs/platform/administration/access-control#essential-concepts","Essential concepts",{"_3328":487,"_29138":484,"_5":29458,"_20209":48876,"_26493":48877,"_2816":48878},[],"/docs/platform/administration/access-control#two-decision-systems","Two decision systems",{"_3328":488,"_29138":484,"_5":29458,"_20209":48880,"_26493":48881,"_2816":48882},[],"/docs/platform/administration/access-control#integrated-or-external-http-services","Integrated or external HTTP services",{"_3328":489,"_29138":484,"_5":29458,"_20209":48884,"_26493":48885,"_2816":48886},[],"/docs/platform/administration/access-control#authentication-only-routes-and-unmapped-paths","Authentication-only routes and unmapped paths",{"_3328":490,"_29138":484,"_5":29458,"_20209":48888,"_26493":48889,"_2816":48890},[],"/docs/platform/administration/access-control#services-developed-by-lamassu","Services developed by Lamassu",{"_3328":491,"_29138":484,"_5":29458,"_20209":48892,"_26493":48893,"_2816":48894},[],"/docs/platform/administration/access-control#how-the-two-paths-relate","How the two paths relate",{"_3328":492,"_29138":484,"_5":29458,"_20209":48896,"_26493":48897,"_2816":48898},[],"/docs/platform/administration/access-control#oidc-principals","OIDC principals",{"_3328":493,"_29138":484,"_5":29458,"_20209":48900,"_26493":48901,"_2816":48902},[],"/docs/platform/administration/access-control#x509-principals","X.509 principals",{"_3328":494,"_29138":484,"_5":29458,"_20209":48904,"_26493":48905,"_2816":48906},[],"/docs/platform/administration/access-control#when-several-principals-match","When several principals match",{"_3328":495,"_29138":484,"_5":29458,"_20209":48908,"_26493":48909,"_2816":48910},[],"/docs/platform/administration/access-control#how-policies-express-access","How policies express access",{"_3328":496,"_29138":484,"_5":29458,"_20209":48912,"_26493":48913,"_2816":48914},[],"/docs/platform/administration/access-control#global-and-direct-access","Global and direct access",{"_3328":497,"_29138":484,"_5":29458,"_20209":48916,"_26493":48917,"_2816":48918},[],"/docs/platform/administration/access-control#access-inherited-through-relations","Access inherited through relations",{"_3328":498,"_29138":484,"_5":29458,"_20209":48920,"_26493":48921,"_2816":48922},[],"/docs/platform/administration/access-control#attribute-filtered-access","Attribute-filtered access",{"_3328":499,"_29138":484,"_5":29458,"_20209":48924,"_26493":48925,"_2816":48926},[],"/docs/platform/administration/access-control#http-rules","HTTP rules",{"_3328":500,"_29138":484,"_5":29458,"_20209":48928,"_26493":48929,"_2816":48930},[],"/docs/platform/administration/access-control#included-policies","Included policies",{"_3328":501,"_29138":484,"_5":29458,"_20209":48932,"_26493":48933,"_2816":48037},[],"/docs/platform/administration/access-control#provision-the-first-administrator",{"_3328":502,"_29138":484,"_5":29458,"_20209":48935,"_26493":48936,"_2816":48937},[],"/docs/platform/administration/access-control#prepare-the-identity-provider","Prepare the identity provider",{"_3328":503,"_29138":484,"_5":29458,"_20209":48939,"_26493":48940,"_2816":48941},[],"/docs/platform/administration/access-control#configure-token-validation","Configure token validation",{"_3328":504,"_29138":484,"_5":29458,"_20209":48943,"_26493":48944,"_2816":48945},[],"/docs/platform/administration/access-control#install-and-verify-administrative-access","Install and verify administrative access",{"_3328":505,"_29138":484,"_5":29458,"_20209":48947,"_26493":48948,"_2816":48949},[],"/docs/platform/administration/access-control#test-an-unprivileged-identity","Test an unprivileged identity",{"_3328":506,"_29138":484,"_5":29458,"_20209":48951,"_26493":48952,"_2816":48953},[],"/docs/platform/administration/access-control#reduce-use-of-the-bootstrap-administrator","Reduce use of the bootstrap administrator",{"_3328":507,"_29138":484,"_5":29458,"_20209":48955,"_26493":48956,"_2816":48957},[],"/docs/platform/administration/access-control#fastlane-bootstrap","Fastlane bootstrap",{"_3328":508,"_29138":484,"_5":29458,"_20209":48959,"_26493":48960,"_2816":48961},[],"/docs/platform/administration/access-control#design-least-privilege-roles","Design least-privilege roles",{"_3328":509,"_29138":484,"_5":29458,"_20209":48963,"_26493":48964,"_2816":48965},[],"/docs/platform/administration/access-control#changes-and-access-revocation","Changes and access revocation",{"_3328":510,"_29138":484,"_5":29458,"_20209":48967,"_26493":48968,"_2816":48969},[],"/docs/platform/administration/access-control#operational-checklist","Operational checklist",{"_3328":511,"_29138":484,"_5":29458,"_20209":48971,"_26493":48972,"_2816":48973},[],"/docs/platform/administration/access-control#diagnostics","Diagnostics",{"_3328":512,"_29138":484,"_5":29458,"_20209":48975,"_26493":48976,"_2816":48977},[],"/docs/platform/administration/access-control#the-response-is-401","The response is 401",{"_3328":513,"_29138":484,"_5":29458,"_20209":48979,"_26493":48980,"_2816":48981},[],"/docs/platform/administration/access-control#the-response-is-403","The response is 403",{"_3328":514,"_29138":484,"_5":29458,"_20209":48983,"_26493":48984,"_2816":48985},[],"/docs/platform/administration/access-control#everything-returns-403","Everything returns 403",{"_3328":515,"_29138":484,"_5":29458,"_20209":48987,"_26493":48988,"_2816":48989},[],"/docs/platform/administration/access-control#access-appears-without-a-policy-grant","Access appears without a policy grant",{"_3328":516,"_29138":484,"_5":29458,"_20209":48991,"_26493":48992,"_2816":48993},[],"/docs/platform/administration/access-control#everything-fails-when-authz-is-unavailable","Everything fails when authz is unavailable",{"_3328":517,"_29138":484,"_20209":48995,"_5":13819,"_26493":484,"_2816":48996},[],"Lamassu access control turns an authenticated identity into concrete permissions. The OIDC provider or the client certificate proves **who** makes a request; the `authz` service decides **what that identity can do** and **over which resources**.",{"_3328":518,"_29138":484,"_20209":48998,"_5":13819,"_26493":484,"_2816":48999},[],"Lamassu does not assign permissions directly to users. The full chain is:",{"_3328":519,"_29138":484,"_20209":49001,"_5":13819,"_26493":484,"_2816":49002},[],"This model lets you represent people, identity-provider groups, service accounts and devices without coupling authorization to a specific provider.",{"_3328":520,"_29138":484,"_20209":49004,"_5":13819,"_26493":48873,"_2816":49005},[],"A **principal** connects a credential to Lamassu. It defines how to recognize an OIDC or X.509 identity and can be active or disabled.",{"_3328":521,"_29138":484,"_20209":49007,"_5":13819,"_26493":48873,"_2816":49008},[],"A **policy** groups reusable permissions. It can be granted to several principals and can contain rules about Lamassu entities, rules about HTTP routes or both.",{"_3328":522,"_29138":484,"_20209":49010,"_5":13819,"_26493":48873,"_2816":49011},[],"An **entity rule** grants actions over resources such as certification authorities, certificates, issuance profiles, devices, DMSs, keys or alert subscriptions. It can cover all resources of a type or be limited by identifier, relation or attribute.",{"_3328":523,"_29138":484,"_20209":49013,"_5":13819,"_26493":48873,"_2816":49014},[],"An **HTTP rule** grants actions associated with API routes. It is the mechanism the Gateway uses to decide whether a request may cross the perimeter.",{"_3328":524,"_29138":484,"_20209":49016,"_5":13819,"_26493":48873,"_2816":49017},[],"A **grant** is the association between a principal and a policy. Removing the grant removes all permissions contributed by that policy, without modifying it for other principals.",{"_3328":525,"_29138":484,"_20209":49019,"_5":13819,"_26493":48873,"_2816":49020},[],"A valid JWT or a valid client certificate does not grant access by itself. The credential must match at least one active principal and, unless the HTTP schema exempts the route, one of its policies must allow the requested operation. See *Authentication-only routes and unmapped paths* for those exemptions.",{"_3328":526,"_29138":484,"_20209":49022,"_5":13819,"_26493":48877,"_2816":49023},[],"Lamassu uses two authorization paths depending on who implements the protected service. They share principals, policies and grants, but they do not interpret the rules the same way.",{"_3328":527,"_29138":484,"_20209":49025,"_5":13819,"_26493":48877,"_2816":49026},[],"An external service can be protected without knowing Lamassu's internal authorization model. A service developed by Lamassu embeds the authorization engine and can decide on concrete resources and filter its queries.",{"_3328":528,"_29138":484,"_20209":49028,"_5":13819,"_26493":48881,"_2816":49029},[],"This path protects APIs that join the platform through the Gateway but do not natively implement Lamassu's authorization SDK. Job Manager is the current example. The same pattern allows integrating other HTTP services as long as their routes are described in an `authz` HTTP schema.",{"_3328":529,"_29138":484,"_20209":49031,"_5":13819,"_26493":48881,"_2816":49032},[],"The decision is made **before forwarding the request to the service**:",{"_3328":530,"_29138":484,"_20209":49034,"_5":13819,"_26493":48881,"_2816":49035},[],"Envoy Gateway authenticates the request, usually validating a JWT against the OIDC provider's JWKS.",{"_3328":531,"_29138":484,"_20209":49037,"_5":13819,"_26493":48881,"_2816":49038},[],"For a protected route, Envoy sends the method, URL, headers and required data to `/v1/ext_authz/check`.",{"_3328":532,"_29138":484,"_20209":49040,"_5":13819,"_26493":48881,"_2816":49041},[],"`authz` extracts the credential and resolves all active principals matching it.",{"_3328":533,"_29138":484,"_20209":49043,"_5":13819,"_26493":48881,"_2816":49044},[],"It separately loads the policies granted to each principal.",{"_3328":534,"_29138":484,"_20209":49046,"_5":13819,"_26493":48881,"_2816":49047},[],"The HTTP schema translates the method and route combination into a logical action, such as `nbi-job-read` or `nbi-workflow-create`.",{"_3328":535,"_29138":484,"_20209":49049,"_5":13819,"_26493":48881,"_2816":49050},[],"`authz` looks for an HTTP rule granting that action.",{"_3328":536,"_29138":484,"_20209":49052,"_5":13819,"_26493":48881,"_2816":49053},[],"If the route declares constraints, it compares request data with the normalized attributes of the same principal contributing the policy; the policy's own `param_constraints` also pin the granted action to literal request values.",{"_3328":537,"_29138":484,"_20209":49055,"_5":13819,"_26493":48881,"_2816":49056},[],"A satisfying result lets Envoy forward the request; any other response blocks it at the Gateway.",{"_3328":538,"_29138":484,"_20209":49058,"_5":13819,"_26493":48881,"_2816":49059},[],"When it allows access, `authz` returns the selected principal in the `X-Principal-ID` response header. The Gateway can propagate that header to the service to preserve the identity context.",{"_3328":539,"_29138":484,"_20209":49061,"_5":13819,"_26493":48881,"_2816":49062},[],"HTTP rules primarily answer &#x2A;*\"can this identity call this API operation?\"**. On their own they do not produce filters over the external service's database. To limit a route to a specific device, tenant or client, either the schema declares a constraint relating a request value to a normalized attribute of the principal, or the policy pins the request value to a literal with `param_constraints`. The first scopes each identity to its own resources through a single grant; the second restricts a grant to a fixed value regardless of who holds it.",{"_3328":540,"_29138":484,"_20209":49064,"_5":13819,"_26493":48885,"_2816":49065},[],"Two schema-level settings cover endpoints that policies do not mention:",{"_3328":541,"_29138":484,"_20209":49067,"_5":13819,"_26493":48885,"_2816":49068},[],"**`skip_authz: true` on a route** allows any identity that matches an active principal to reach it, even one with no granted policies. Use it for paths such as `/openapi.json` or `/health` that every authenticated caller should be able to access. The request still has to authenticate successfully: a credential that fails validation or matches no active principal is rejected before this setting is considered. A `skip_authz` route cannot declare constraints, and it wins over any other schema's route or default action for the same request.",{"_3328":542,"_29138":484,"_20209":49070,"_5":13819,"_26493":48885,"_2816":49071},[],"**`default_action` with `base_paths`** decides what happens when a request falls under a path prefix the schema owns but no explicit route matches. `deny` — the value the Job Manager schema ships with — turns the implicit denial of unmapped paths into an explicit, auditable statement; `allow` opens unmapped endpoints under that prefix to any identity that matches an active principal.",{"_3328":543,"_29138":484,"_20209":49073,"_5":13819,"_26493":48885,"_2816":49074},[],"These are decisions of the schema, not of a policy: `skip_authz` removes the grant check for that route, even when another schema maps the same request to an action that requires a grant, and `default_action` only covers requests that no explicit route in any schema matches. Keep three rules in mind:",{"_3328":544,"_29138":484,"_20209":49076,"_5":13819,"_26493":48885,"_2816":49077},[],"`default_action` requires at least one `base_paths` entry, and base paths are absolute paths such as `/api/wfx/nbi/v1`.",{"_3328":545,"_29138":484,"_20209":49079,"_5":13819,"_26493":48885,"_2816":49080},[],"An explicit route in any schema takes precedence: the fallback only decides requests that no schema's routes cover. When the prefixes of two schemas overlap, the longest matching prefix decides.",{"_3328":546,"_29138":484,"_20209":49082,"_5":13819,"_26493":48885,"_2816":49083},[],"Two schemas cannot claim the same base path with different default actions; the conflicting schema fails to load.",{"_3328":547,"_29138":484,"_20209":49085,"_5":13819,"_26493":48885,"_2816":49086},[],"A `skip_authz` route and a `default_action: \"allow\"` prefix grant access without consulting any policy. Every identity that matches an active principal can reach what they open, including identities with no granted policies. A `skip_authz` route in one schema also opens a request that another schema maps to a grant-protected action. Review these settings whenever you add or upgrade an integrated service.",{"_3328":548,"_29138":484,"_20209":49088,"_5":13819,"_26493":48889,"_2816":49089},[],"Lamassu's native services embed authorization in their middleware and know the entities they operate on: certificates, CAs, issuance profiles, keys, devices, DMSs or subscriptions, among others.",{"_3328":549,"_29138":484,"_20209":49091,"_5":13819,"_26493":48889,"_2816":49092},[],"The decision is made with the domain operation context:",{"_3328":550,"_29138":484,"_20209":49094,"_5":13819,"_26493":48889,"_2816":49095},[],"The middleware extracts the credential and resolves the matching principals.",{"_3328":551,"_29138":484,"_20209":49097,"_5":13819,"_26493":48889,"_2816":49098},[],"The endpoint identifies the action, the entity type and, when applicable, the key of the requested resource.",{"_3328":552,"_29138":484,"_20209":49100,"_5":13819,"_26493":48889,"_2816":49101},[],"`authz` gathers the entity rules of the granted policies.",{"_3328":553,"_29138":484,"_20209":49103,"_5":13819,"_26493":48889,"_2816":49104},[],"The engine evaluates direct grants, attribute filters and relations with other entities.",{"_3328":554,"_29138":484,"_20209":49106,"_5":13819,"_26493":48889,"_2816":49107},[],"For an individual operation, it checks that the concrete resource satisfies the computed scope.",{"_3328":555,"_29138":484,"_20209":49109,"_5":13819,"_26493":48889,"_2816":49110},[],"For a listing, it generates a SQL filter that the service adds to its own query.",{"_3328":556,"_29138":484,"_20209":49112,"_5":13819,"_26493":48889,"_2816":49113},[],"Here the engine answers &#x2A;*\"can this identity perform this action on this concrete resource?\"**.",{"_3328":557,"_29138":484,"_20209":49115,"_5":13819,"_26493":48889,"_2816":49116},[],"Actions fall into two groups:",{"_3328":558,"_29138":484,"_20209":49118,"_5":13819,"_26493":48889,"_2816":49119},[],"**Global actions** do not need a resource identifier. `create`, `import` or access to a console section are common examples.",{"_3328":559,"_29138":484,"_20209":49121,"_5":13819,"_26493":48889,"_2816":49122},[],"**Atomic actions** are evaluated on a concrete instance. For certificates these include `read`, `metadata-update`, `status-update` and `delete`; for a CA there are also `sign`, `reissue` and other lifecycle operations.",{"_3328":560,"_29138":484,"_20209":49124,"_5":13819,"_26493":48889,"_2816":49125},[],"Filtering inside the service prevents leaks in listings: unauthorized resources are excluded from the SQL query instead of being fetched and hidden later in the interface.",{"_3328":561,"_29138":484,"_20209":49127,"_5":13819,"_26493":48893,"_2816":49128},[],"They are not two equivalent controls applied twice. HTTP rules protect the perimeter of an integrated service; entity rules express permissions over the data model of the native services.",{"_3328":562,"_29138":484,"_20209":49130,"_5":13819,"_26493":48893,"_2816":49131},[],"A policy can contain both rule types when an identity needs to operate Lamassu resources and also call an integrated API. Granting an entity rule does not automatically grant an HTTP action, nor does an HTTP rule create access over an entity.",{"_3328":563,"_29138":484,"_20209":49133,"_5":13819,"_26493":48893,"_2816":49134},[],"If no combination of principal, policy and rule allows the operation, Lamassu denies it, unless the HTTP schema declares `skip_authz` on the route or `default_action: allow` on a base path that covers it (see *Authentication-only routes and unmapped paths*). Additionally, `auth.externalAuthorization.failOpen` is `false` by default: if `authz` is unavailable, the Gateway blocks protected routes.",{"_3328":564,"_29138":484,"_20209":49136,"_5":13819,"_26493":48897,"_2816":49137},[],"An OIDC principal matches the claims of a validated JWT. It is appropriate for human users, corporate groups, IdP roles and service accounts that obtain tokens.",{"_3328":565,"_29138":484,"_20209":49139,"_5":13819,"_26493":48897,"_2816":49140},[],"The following principal represents any identity holding the `pki-operators` role in Keycloak:",{"_3328":566,"_29138":484,"_20209":49142,"_5":13819,"_26493":48897,"_2816":49143},[],"Claim paths can be nested, such as `realm_access.roles`. Within a single principal, **all** conditions must hold. This lets you require, for example, a group and an organizational audience at the same time.",{"_3328":567,"_29138":484,"_20209":49145,"_5":13819,"_26493":48897,"_2816":49146},[],"The implemented operators are:",{"_3328":568,"_29138":484,"_20209":49148,"_5":13819,"_26493":48897,"_2816":49149},[],"`equals`, for exact equality;",{"_3328":569,"_29138":484,"_20209":49151,"_5":13819,"_26493":48897,"_2816":49152},[],"`contains`, to check membership in a list or the presence of text in a scalar value.",{"_3328":570,"_29138":484,"_20209":49154,"_5":13819,"_26493":48897,"_2816":49155},[],"Design matching with stable attributes. For people, it is usually better to bind permissions to centrally managed groups or roles than to the email or username. For a service account, a stable `sub` keeps its permissions from mixing with a human operator's.",{"_3328":571,"_29138":484,"_20209":49157,"_5":13819,"_26493":48897,"_2816":49158},[],"Although the model recognizes the operator name `matches`, the current implementation does not evaluate regular expressions and the condition never matches. Use `equals` or `contains`.",{"_3328":572,"_29138":484,"_20209":49160,"_5":13819,"_26493":48901,"_2816":49161},[],"An X.509 principal lets you recognize a workload or a device by its client certificate. Lamassu checks the certificate signature against the configured CA and, depending on the mode, also its serial number or Common Name.",{"_3328":573,"_29138":484,"_20209":49163,"_5":13819,"_26493":48901,"_2816":49164},[],"The available modes are:",{"_3328":574,"_29138":484,"_20209":49166,"_5":13819,"_26493":48901,"_2816":49167},[],"`serial_and_ca`: an exact certificate, identified by serial number and CA;",{"_3328":575,"_29138":484,"_20209":49169,"_5":13819,"_26493":48901,"_2816":49170},[],"`cn_and_ca`: an exact or wildcard Common Name and a specific CA;",{"_3328":576,"_29138":484,"_20209":49172,"_5":13819,"_26493":48901,"_2816":49173},[],"`any_from_ca`: any certificate issued directly by the given CA.",{"_3328":577,"_29138":484,"_20209":49175,"_5":13819,"_26493":48901,"_2816":49176},[],"This example recognizes certificates whose CN starts with `factory-a-` and that are signed by the configured CA:",{"_3328":578,"_29138":484,"_20209":49178,"_5":13819,"_26493":48901,"_2816":49179},[],"`ca_trust.identity_type` accepts `fingerprint` or `authority_key_id`. In both cases you must provide the CA certificate in `ca_trust.pem`; Lamassu verifies both the signature and the expected identity of the CA.",{"_3328":579,"_29138":484,"_20209":49181,"_5":13819,"_26493":48901,"_2816":49182},[],"Use `any_from_ca` only when every identity issued by that CA should share the same permissions. If a CA issues certificates for different populations, separate access by serial or CN, or use different issuing CAs.",{"_3328":580,"_29138":484,"_20209":49184,"_5":13819,"_26493":48905,"_2816":49185},[],"A single credential can match more than one principal. It is common for a user to match a principal of their team and another of their operational function.",{"_3328":581,"_29138":484,"_20209":49187,"_5":13819,"_26493":48905,"_2816":49188},[],"For entity permissions, Lamassu combines permissions with OR logic: it is enough that one policy of one of the principals allows the action. Listings contain the union of the resources visible to all of them.",{"_3328":582,"_29138":484,"_20209":49190,"_5":13819,"_26493":48905,"_2816":49191},[],"HTTP routes with constraints are stricter. The same principal contributing the policy must also satisfy the attributes required by the route. Lamassu does not combine one principal's policy with an attribute belonging to another.",{"_3328":583,"_29138":484,"_20209":49193,"_5":13819,"_26493":48905,"_2816":49194},[],"For this reason, adding a matching principal can only broaden access. Before creating overlapping rules, review the full set of policies a real identity will receive.",{"_3328":584,"_29138":484,"_20209":49196,"_5":13819,"_26493":48913,"_2816":49197},[],"A rule identifies the domain (`namespace`), the data schema (`schema_name`) and the entity type (`entity_type`). `actions` lists the allowed operations.",{"_3328":585,"_29138":484,"_20209":49199,"_5":13819,"_26493":48913,"_2816":49200},[],"`direct_grants` limits the rule to concrete identifiers. The value `*` covers all instances of the type. A superadministrator policy uses wildcards in schema, entity, actions and grants; a least-privilege policy should avoid them whenever possible.",{"_3328":586,"_29138":484,"_20209":49202,"_5":13819,"_26493":48917,"_2816":49203},[],"Rules can follow relations declared between entities. For example, the schema knows the relation of a certificate to its issuing CA and of a device to its DMS. A policy can grant access to a parent resource and propagate selected actions to its related resources.",{"_3328":587,"_29138":484,"_20209":49205,"_5":13819,"_26493":48917,"_2816":49206},[],"This lets you express models like \"can operate the devices of this DMS\" without maintaining an individual list of every device. When a resource is added under that relation, it inherits the scope planned by the policy.",{"_3328":588,"_29138":484,"_20209":49208,"_5":13819,"_26493":48921,"_2816":49209},[],"`column_filters` applies conditions to columns the schema has declared filterable. All filters of the same rule are combined with AND.",{"_3328":589,"_29138":484,"_20209":49211,"_5":13819,"_26493":48921,"_2816":49212},[],"For example, this rule allows reading active certificates issued by a specific CA:",{"_3328":590,"_29138":484,"_20209":49214,"_5":13819,"_26493":48921,"_2816":49215},[],"The available operators are `eq`, `neq`, `gt`, `gte`, `lt`, `lte`, `in` and `like`. Use comparisons consistent with the column type: `like` for text, ordering comparisons for numbers or dates and `in` when there is a collection of accepted values.",{"_3328":591,"_29138":484,"_20209":49217,"_5":13819,"_26493":48925,"_2816":49218},[],"HTTP rules do not point directly at tables. They reference a route schema and grant its logical actions. Job Manager's policies are an example: they distinguish reading, creating, updating and deleting workflows or jobs.",{"_3328":592,"_29138":484,"_20209":49220,"_5":13819,"_26493":48925,"_2816":49221},[],"Some routes also compare a request value — taken from the path, query, header or JSON body — with a normalized attribute of the principal. This way you can verify that a device only queries jobs addressed to its own `client_id`.",{"_3328":593,"_29138":484,"_20209":49223,"_5":13819,"_26493":48925,"_2816":49224},[],"Normalized attributes decouple the policy from the authentication mechanism. `subject_attribute_mappings` can derive, for example, `device_id` from `oidc.claim.device_id` or from `x509.subject.cn`. The rule consumes `device_id` in both cases.",{"_3328":594,"_29138":484,"_20209":49226,"_5":13819,"_26493":48925,"_2816":49227},[],"An HTTP rule can also pin a granted action to a literal value carried by the request itself through `param_constraints`. It extracts the value with the same sources as route constraints — `path_regex_group`, `query`, `header` or `json_body` — but compares it against an `equals` literal written into the policy rather than against a subject attribute. The grant then depends only on the request, not on who holds the policy:",{"_3328":595,"_29138":484,"_20209":49229,"_5":13819,"_26493":48925,"_2816":49230},[],"Combined with a schema route such as `^/api/mysvc/system/([^/]+)/info$`, this grants `GET /api/mysvc/system/1/info` and denies the same call for system `2`, regardless of the principal's attributes. The same mechanism pins query parameters, headers or JSON body fields, for example `{ \"source\": \"query\", \"name\": \"tenant_id\" }` with `\"equals\": \"1\"` to accept only requests carrying `?tenant_id=1`.",{"_3328":596,"_29138":484,"_20209":49232,"_5":13819,"_26493":48925,"_2816":49233},[],"Note that:",{"_3328":597,"_29138":484,"_20209":49235,"_5":13819,"_26493":48925,"_2816":49236},[],"`action` must be one of the actions granted by the rule; `equals` is required; `path_regex_group` needs an `index` greater than zero, `query` and `header` need a `name`, and `json_body` needs a `path` such as `$.tenant_id`.",{"_3328":598,"_29138":484,"_20209":49238,"_5":13819,"_26493":48925,"_2816":49239},[],"`param_constraints` are not cross-checked against the schema when the policy is loaded. A reference the route cannot satisfy — for instance a `path_regex_group` on a route without capture groups — simply never matches, and the request is denied.",{"_3328":599,"_29138":484,"_20209":49241,"_5":13819,"_26493":48925,"_2816":49242},[],"Several `param_constraints` for the same action combine with AND. A rule without them keeps the usual behavior: the action is granted wherever the route matches and the subject constraints pass.",{"_3328":600,"_29138":484,"_20209":49244,"_5":13819,"_26493":48929,"_2816":49245},[],"The `authz` preload installs reusable policies for the main domains. Among them are:",{"_3328":601,"_29138":484,"_20209":49247,"_5":13819,"_26493":48929,"_2816":49248},[],"full and read-only access to certificates and authorities;",{"_3328":602,"_29138":484,"_20209":49250,"_5":13819,"_26493":48929,"_2816":49251},[],"full and read-only access to the KMS;",{"_3328":603,"_29138":484,"_20209":49253,"_5":13819,"_26493":48929,"_2816":49254},[],"full and read-only access to Device Manager, DMS Manager, Validation Authority and alerts;",{"_3328":604,"_29138":484,"_20209":49256,"_5":13819,"_26493":48929,"_2816":49257},[],"an `Auditor` policy with PKI read access and authorization visibility;",{"_3328":605,"_29138":484,"_20209":49259,"_5":13819,"_26493":48929,"_2816":49260},[],"console access;",{"_3328":606,"_29138":484,"_20209":49262,"_5":13819,"_26493":48929,"_2816":49263},[],"administration and observation policies for the Job Manager NBI and SBI APIs;",{"_3328":607,"_29138":484,"_20209":49265,"_5":13819,"_26493":48929,"_2816":49266},[],"`SUPER ADMIN`, which grants all actions over the `authz` and `pki` domains.",{"_3328":608,"_29138":484,"_20209":49268,"_5":13819,"_26493":48929,"_2816":49269},[],"Start with these policies before creating others. If none reflects the boundary you need, create a specific, small policy instead of copying `SUPER ADMIN` and informally removing permissions.",{"_3328":609,"_29138":484,"_20209":49271,"_5":13819,"_26493":48933,"_2816":49272},[],"An installation without a principal matching your identity is left with nobody able to administer authorization. Configure the IdP and the bootstrap before exposing the platform.",{"_3328":610,"_29138":484,"_20209":49274,"_5":13819,"_26493":48933,"_2816":49275},[],"The chart includes a bootstrap principal that looks for the OIDC role `pki-admin` in `realm_access.roles`. It grants it `SUPER ADMIN` and, when Job Manager is enabled, the administrative policy of its NBI API.",{"_3328":611,"_29138":484,"_20209":49277,"_5":13819,"_26493":48933,"_2816":49278},[],"The pre-install and pre-upgrade Helm Job runs the `authz` migrations, preloads the policies and creates the bootstrap principals before the services start. If the principal already exists, it does not replace it: it only adds the configured grants that are still missing. You can keep the entry in `values.yaml` across upgrades.",{"_3328":612,"_29138":484,"_20209":49280,"_5":13819,"_26493":48936,"_2816":49281},[],"Create the role or group you will use to administer Lamassu. Assign it to at least two controlled human identities. If your provider does not use `realm_access.roles`, adapt the claim path in both the frontend and `auth_config.claims`.",{"_3328":613,"_29138":484,"_20209":49283,"_5":13819,"_26493":48940,"_2816":49284},[],"`authz` validates every token against `services.authz.jwkUrl`, which is fetched from the `authz` pod. The Gateway does not validate tokens itself: Lamassu services authorize each request through `authz`, and routes labeled `auth=external`, such as the Job Manager ones, are checked by the Gateway through `authz` when `auth.externalAuthorization` is enabled. The endpoint must serve the keys of the issuer configured in `auth.oidc.frontend.authority`.",{"_3328":614,"_29138":484,"_20209":49286,"_5":13819,"_26493":48940,"_2816":49287},[],"Releases upgraded from 3.8.0 must remove `auth.oidc.apiGateway` and `auth.authorization`, which the 4.0.0 chart rejects. See 3.8.0 to 4.0.0.",{"_3328":615,"_29138":484,"_20209":49289,"_5":13819,"_26493":48944,"_2816":49290},[],"Sign in with an identity holding `pki-admin`. Confirm it can access authorization administration and perform a non-destructive read operation.",{"_3328":616,"_29138":484,"_20209":49292,"_5":13819,"_26493":48948,"_2816":49293},[],"Use a second user without the role and confirm the same operation is denied. This test catches misread claims, overly broad policies and accidental `failOpen` configurations.",{"_3328":617,"_29138":484,"_20209":49295,"_5":13819,"_26493":48952,"_2816":49296},[],"Create operational principals with narrower policies. Reserve `pki-admin` for authorization administration and recovery, not for daily work.",{"_3328":618,"_29138":484,"_20209":49298,"_5":13819,"_26493":48956,"_2816":49299},[],"Fastlane installs a Keycloak realm for the lab and creates the user `lamassu` with the temporary password `lamassu`, the role `pki-admin` and a mandatory password change. Its bootstrap principal matches through `preferred_username=lamassu`.",{"_3328":619,"_29138":484,"_20209":49301,"_5":13819,"_26493":48956,"_2816":49302},[],"Change the password on first login. Do not reuse the Fastlane user, password or IdP as a production design.",{"_3328":620,"_29138":484,"_20209":49304,"_5":13819,"_26493":48960,"_2816":49305},[],"Avoid reproducing your company's internal structure with dozens of nearly identical policies. Start from the responsibilities that actually need access:",{"_3328":621,"_29138":484,"_20209":49307,"_5":13819,"_26493":48960,"_2816":49308},[],"**Authorization administration**: manages principals, policies and grants. It should belong to a small, separate group.",{"_3328":622,"_29138":484,"_20209":49310,"_5":13819,"_26493":48960,"_2816":49311},[],"**PKI operation**: administers CAs, profiles and certificates, but not necessarily who gets access.",{"_3328":623,"_29138":484,"_20209":49313,"_5":13819,"_26493":48960,"_2816":49314},[],"**Device registration**: operates devices and DMSs without receiving permissions over keys or authorization configuration.",{"_3328":624,"_29138":484,"_20209":49316,"_5":13819,"_26493":48960,"_2816":49317},[],"**Audit**: reviews configuration and activity without creating, modifying, signing, revoking or deleting.",{"_3328":625,"_29138":484,"_20209":49319,"_5":13819,"_26493":48960,"_2816":49320},[],"**Automation**: uses a technical account or a separate certificate, with permissions limited to the flow and resources it controls.",{"_3328":626,"_29138":484,"_20209":49322,"_5":13819,"_26493":48960,"_2816":49323},[],"For each role, separate \"view\" from \"change\", limit resources through grants, relations or attributes and avoid `*` unless the role must automatically cover future actions.",{"_3328":627,"_29138":484,"_20209":49325,"_5":13819,"_26493":48960,"_2816":49326},[],"A rule with `actions: [\"*\"]` expands to every action defined by the schema. When a new version adds an action, a wildcard policy may start granting it. Review these policies on every upgrade.",{"_3328":628,"_29138":484,"_20209":49328,"_5":13819,"_26493":48964,"_2816":49329},[],"To revoke access immediately, disable the principal or revoke its grants. Disabling a principal keeps its configuration and associations for investigation or restoration, but it stops taking part in matching.",{"_3328":629,"_29138":484,"_20209":49331,"_5":13819,"_26493":48964,"_2816":49332},[],"Deleting a role or group in the IdP prevents new tokens from containing the claim, but an already-issued token may remain valid until it expires. If removal is urgent, combine the IdP change with disabling the principal in Lamassu and revoking sessions or tokens at the provider.",{"_3328":630,"_29138":484,"_20209":49334,"_5":13819,"_26493":48964,"_2816":49335},[],"When you edit a shared policy, remember the change affects all its principals. To test a new scope, create a separate policy, grant it to a test identity and validate allowed and denied operations before replacing the old one.",{"_3328":631,"_29138":484,"_20209":49337,"_5":13819,"_26493":48968,"_2816":49338},[],"Keep `failOpen: false` unless a documented risk assessment justifies otherwise.",{"_3328":632,"_29138":484,"_20209":49340,"_5":13819,"_26493":48968,"_2816":49341},[],"Use groups or stable roles for people and independent identities for automations.",{"_3328":633,"_29138":484,"_20209":49343,"_5":13819,"_26493":48968,"_2816":49344},[],"Keep at least two recovery administrators and test their access periodically.",{"_3328":634,"_29138":484,"_20209":49346,"_5":13819,"_26493":48968,"_2816":49347},[],"Review active principals, their matches and their grants after IdP changes.",{"_3328":635,"_29138":484,"_20209":49349,"_5":13819,"_26493":48968,"_2816":49350},[],"Search for wildcards in policies before upgrading Lamassu.",{"_3328":636,"_29138":484,"_20209":49352,"_5":13819,"_26493":48968,"_2816":49353},[],"Review `skip_authz` routes and `default_action` settings in HTTP schemas when integrating or upgrading a service.",{"_3328":637,"_29138":484,"_20209":49355,"_5":13819,"_26493":48968,"_2816":49356},[],"Always test one allowed and one denied operation for each role.",{"_3328":638,"_29138":484,"_20209":49358,"_5":13819,"_26493":48968,"_2816":49359},[],"Correlate changes to principals, policies and grants with the audit logs.",{"_3328":639,"_29138":484,"_20209":49361,"_5":13819,"_26493":48976,"_2816":49362},[],"Authentication failed before permissions were evaluated. Check the JWT signature and expiration, issuer, audience and the availability of the JWKS configured in the Gateway. For X.509, check that the client certificate reaches the point that extracts the credential.",{"_3328":640,"_29138":484,"_20209":49364,"_5":13819,"_26493":48980,"_2816":49365},[],"The credential could be processed but did not produce a positive authorization. Review in this order:",{"_3328":641,"_29138":484,"_20209":49367,"_5":13819,"_26493":48980,"_2816":49368},[],"that an active principal of the correct type exists;",{"_3328":642,"_29138":484,"_20209":49370,"_5":13819,"_26493":48980,"_2816":49371},[],"that the claim paths and values match the real token exactly;",{"_3328":643,"_29138":484,"_20209":49373,"_5":13819,"_26493":48980,"_2816":49374},[],"that all of the principal's conditions hold;",{"_3328":644,"_29138":484,"_20209":49376,"_5":13819,"_26493":48980,"_2816":49377},[],"that the principal has the expected policy granted;",{"_3328":645,"_29138":484,"_20209":49379,"_5":13819,"_26493":48980,"_2816":49380},[],"that the policy includes the action and the requested resource type or route;",{"_3328":646,"_29138":484,"_20209":49382,"_5":13819,"_26493":48980,"_2816":49383},[],"that the identifier, relation, column filter or HTTP constraint includes the real resource.",{"_3328":647,"_29138":484,"_20209":49385,"_5":13819,"_26493":48980,"_2816":49386},[],"In the `authz` logs, an external endpoint decision includes `allowed`, `reason`, `matched_principals`, `evaluated_policy_ids`, `matched_policy_id` and the status code. These fields let you separate a matching failure from a permissions failure. With OpenTelemetry tracing enabled, a request that reaches the policy engine produces an `engine.CheckHTTPRequest` span whose attributes record `authz.allowed`, the matched policy and the matched principal. Correlation with the Gateway trace requires trace context to be propagated to authz.",{"_3328":648,"_29138":484,"_20209":49388,"_5":13819,"_26493":48984,"_2816":49389},[],"Check that the bootstrap principal was created and that the policies were preloaded by the migration Job. Also verify that `services.authz.jwkUrl` is reachable from the `authz` pod; do not assume that a URL accessible from the browser also works inside the cluster.",{"_3328":649,"_29138":484,"_20209":49391,"_5":13819,"_26493":48988,"_2816":49392},[],"The path may be covered by a schema-level decision rather than by a policy: routes marked `skip_authz` allow any identity that matches an active principal, and a request under a `base_paths` prefix whose schema sets `default_action: allow` is likewise allowed without consulting policies. Confirm which of the two applies before looking for missing or misassigned grants.",{"_3328":650,"_29138":484,"_20209":49394,"_5":13819,"_26493":48992,"_2816":49395},[],"This is the expected behavior with `failOpen: false`. Restore the service, its PostgreSQL connection and its JWKS connectivity. Do not temporarily switch to `failOpen: true` without accepting that protected routes could become accessible without an authorization decision.",{"_3328":651,"_29138":484,"_20209":49397,"_5":13819,"_26493":48992,"_2816":49398},[],"Continue with Audit logs to investigate configuration changes or with Troubleshooting to diagnose the deployment.",{"_3328":652,"_29138":652,"_5":14177,"_2816":49400,"_29461":49401,"_20209":49402,"_26493":652},"Alerts and subscriptions",[47397,48865,48866],[],{"_3328":653,"_29138":652,"_20209":49404,"_5":13819,"_26493":652,"_2816":49405},[],"Send PKI events to people and external systems.",{"_3328":654,"_29138":652,"_5":29458,"_20209":49407,"_26493":49408,"_2816":49409},[],"/docs/platform/administration/alerts#how-it-works","How it works",{"_3328":655,"_29138":652,"_5":29458,"_20209":49411,"_26493":49412,"_2816":49413},[],"/docs/platform/administration/alerts#available-channels","Available channels",{"_3328":656,"_29138":652,"_5":29458,"_20209":49415,"_26493":49416,"_2816":49417},[],"/docs/platform/administration/alerts#create-a-subscription","Create a subscription",{"_3328":657,"_29138":652,"_5":29458,"_20209":49419,"_26493":49420,"_2816":49421},[],"/docs/platform/administration/alerts#choose-the-event","Choose the event",{"_3328":658,"_29138":652,"_5":29458,"_20209":49423,"_26493":49424,"_2816":49425},[],"/docs/platform/administration/alerts#configure-the-destination","Configure the destination",{"_3328":659,"_29138":652,"_5":29458,"_20209":49427,"_26493":49428,"_2816":49429},[],"/docs/platform/administration/alerts#limit-the-notifications","Limit the notifications",{"_3328":660,"_29138":652,"_5":29458,"_20209":49431,"_26493":49432,"_2816":49433},[],"/docs/platform/administration/alerts#review-and-activate","Review and activate",{"_3328":661,"_29138":652,"_5":29458,"_20209":49435,"_26493":49436,"_2816":49437},[],"/docs/platform/administration/alerts#configure-the-webhook-http-client","Configure the webhook HTTP client",{"_3328":662,"_29138":652,"_5":29458,"_20209":49439,"_26493":49440,"_2816":49441},[],"/docs/platform/administration/alerts#webhook-delivery-rules","Webhook delivery rules",{"_3328":663,"_29138":652,"_5":29458,"_20209":49443,"_26493":49444,"_2816":49445},[],"/docs/platform/administration/alerts#manage-a-subscription","Manage a subscription",{"_3328":664,"_29138":652,"_5":29458,"_20209":49447,"_26493":49448,"_2816":49449},[],"/docs/platform/administration/alerts#event-families","Event families",{"_3328":665,"_29138":652,"_20209":49451,"_5":13819,"_26493":652,"_2816":49452},[],"Subscriptions turn Lamassu events into actionable notifications. You can alert a team, feed an incident system or trigger an automation when a CA, certificate or device changes.",{"_3328":666,"_29138":652,"_20209":49454,"_5":13819,"_26493":49408,"_2816":49455},[],"A service publishes a domain event.",{"_3328":667,"_29138":652,"_20209":49457,"_5":13819,"_26493":49408,"_2816":49458},[],"Lamassu evaluates the subscriptions associated with that event type.",{"_3328":668,"_29138":652,"_20209":49460,"_5":13819,"_26493":49408,"_2816":49461},[],"Each subscription's filter decides whether it should be notified.",{"_3328":669,"_29138":652,"_20209":49463,"_5":13819,"_26493":49408,"_2816":49464},[],"Lamassu delivers the event to the configured channel.",{"_3328":670,"_29138":652,"_20209":49466,"_5":13819,"_26493":49408,"_2816":49467},[],"The event inventory shows when each type was last observed, how many times it has occurred and how many subscriptions it has. You can expand an event to inspect an example of its JSON payload before creating the filter.",{"_3328":671,"_29138":652,"_20209":49469,"_5":13819,"_26493":49412,"_2816":49470},[],"**Email** sends alerts to a person or an operational list. It only requires the destination address. Event content is rendered as HTML-escaped text, never as markup.",{"_3328":672,"_29138":652,"_20209":49472,"_5":13819,"_26493":49412,"_2816":49473},[],"**Microsoft Teams** posts the notification to a channel through its webhook URL.",{"_3328":673,"_29138":652,"_20209":49475,"_5":13819,"_26493":49412,"_2816":49476},[],"**Webhook** delivers the event to an automation, SIEM or incident system via `POST` or `PUT`.",{"_3328":674,"_29138":652,"_20209":49478,"_5":13819,"_26493":49412,"_2816":49479},[],"The Microsoft Teams and Webhook channels accept an optional `http_client` block that authenticates the call to the receiver. `auth_mode` selects `noauth` (the default), `apikey`, `jwt` or `mtls`; each mode requires its own options:",{"_3328":675,"_29138":652,"_20209":49481,"_5":13819,"_26493":49412,"_2816":49482},[],"`apikey_options` requires `header` and `key`.",{"_3328":676,"_29138":652,"_20209":49484,"_5":13819,"_26493":49412,"_2816":49485},[],"`jwt_options` requires `oidc_client_id`, `oidc_client_secret` and an absolute `http` or `https` `oidc_well_known`.",{"_3328":677,"_29138":652,"_20209":49487,"_5":13819,"_26493":49412,"_2816":49488},[],"`mtls_options` requires `cert_content` and `key_content` as Base64-encoded PEM, like certificates elsewhere in the API; plain PEM is also accepted. Values that reference files on the server are rejected, and the pair must decode to a matching certificate and private key.",{"_3328":678,"_29138":652,"_20209":49490,"_5":13819,"_26493":49412,"_2816":49491},[],"The alerts API reference documents the full `http_client` schema.",{"_3328":679,"_29138":652,"_20209":49493,"_5":13819,"_26493":49420,"_2816":49494},[],"Open **Alerts**, locate the event type and select **Subscribe**. Review the latest JSON example to identify the fields you will need to filter on.",{"_3328":680,"_29138":652,"_20209":49496,"_5":13819,"_26493":49424,"_2816":49497},[],"Select Email, Microsoft Teams or Webhook and enter the channel details.",{"_3328":681,"_29138":652,"_20209":49499,"_5":13819,"_26493":49428,"_2816":49500},[],"Add a filter if you don't want to receive every instance of the event.",{"_3328":682,"_29138":652,"_20209":49502,"_5":13819,"_26493":49428,"_2816":49503},[],"**None** notifies all instances of the event.",{"_3328":683,"_29138":652,"_20209":49505,"_5":13819,"_26493":49428,"_2816":49506},[],"**JSON Path** evaluates one or more specific fields.",{"_3328":684,"_29138":652,"_20209":49508,"_5":13819,"_26493":49428,"_2816":49509},[],"**JSON Schema** accepts only payloads with a particular structure.",{"_3328":685,"_29138":652,"_20209":49511,"_5":13819,"_26493":49428,"_2816":49512},[],"**JavaScript** lets you express custom logic. Each filter runs for at most 100 milliseconds; a filter that exceeds this limit fails the condition and the notification is skipped with the error `javascript filter execution timed out`.",{"_3328":686,"_29138":652,"_20209":49514,"_5":13819,"_26493":49428,"_2816":49515},[],"For example, `function (event) { return event.data.status == \"NO_IDENTITY\"; }` limits a subscription to devices without an identity.",{"_3328":687,"_29138":652,"_20209":49517,"_5":13819,"_26493":49432,"_2816":49518},[],"Check the event, channel and filter in the summary. Select **Confirm Subscription** to start delivery.",{"_3328":688,"_29138":652,"_20209":49520,"_5":13819,"_26493":49436,"_2816":49521},[],"The Webhook and Microsoft Teams channels show this configuration in the subscribe form, at the channel step, and again when editing a subscription; Email does not use it. The fields map to the optional `http_client` block described above:",{"_3328":689,"_29138":652,"_20209":49523,"_5":13819,"_26493":49436,"_2816":49524},[],"**Log Level** selects `debug`, `info`, `warn` or `error`; `info` is the default.",{"_3328":690,"_29138":652,"_20209":49526,"_5":13819,"_26493":49436,"_2816":49527},[],"**Call Timeout** defaults to 10 seconds. The console rejects a value above 30 seconds with `Webhook timeout must be at most 30s.`; the API clamps the same value to the cap instead (see Calls are bounded).",{"_3328":691,"_29138":652,"_20209":49529,"_5":13819,"_26493":49436,"_2816":49530},[],"There is no TLS-verification switch for these channels, because the service always verifies the receiver certificate (see TLS is always verified).",{"_3328":692,"_29138":652,"_20209":49532,"_5":13819,"_26493":49436,"_2816":49533},[],"**HTTP Authentication** selects `No Authentication` (the default), `API Key` (API key value and Header Name, `X-API-Key` by default), `OIDC Client Credentials` (Client ID, Client Secret and Well-Known URL) or `Mutual TLS` (Client Certificate and Client Private Key pasted as PEM). A stored private key stays hidden until you select **Show**.",{"_3328":693,"_29138":652,"_20209":49535,"_5":13819,"_26493":49436,"_2816":49536},[],"A `http://` URL shows the console warning `Unencrypted HTTP connection` (see the Credentials over http\\:// callout below).",{"_3328":694,"_29138":652,"_20209":49538,"_5":13819,"_26493":49436,"_2816":49539},[],"The form validates inline against the same delivery rules: the webhook URL and the OIDC Well-Known URL must be absolute `http` or `https` URLs, an API-key header may not use a reserved name, and the mTLS certificate and key must be PEM content, not file paths.",{"_3328":695,"_29138":652,"_20209":49541,"_5":13819,"_26493":49436,"_2816":49542},[],"The summary in the Confirm step shows the authentication as `None`, `OIDC client credentials`, `API key` or `Mutual TLS`. The subscription details show the authentication, the API key header name (never the value), the OIDC issuer URL, mTLS as `Configured` and a fixed `TLS verification: Verified` row. The API key, client secret and private key are not shown in the subscription details.",{"_3328":696,"_29138":652,"_20209":49544,"_5":13819,"_26493":49440,"_2816":49545},[],"Notifications delivered through the Microsoft Teams and Webhook channels follow a fixed HTTP policy:",{"_3328":697,"_29138":652,"_20209":49547,"_5":13819,"_26493":49440,"_2816":49548},[],"**TLS is always verified.** The receiver certificate is checked against the system trust store. `insecure_skip_verify` is enforced as `false` — including when it is set to `true` — so self-signed or otherwise untrusted receivers fail delivery.",{"_3328":698,"_29138":652,"_20209":49550,"_5":13819,"_26493":49440,"_2816":49551},[],"**Redirects are not followed.** A `3xx` response fails with `unexpected status code: <n>: redirects are not followed`. Configure `webhook_url` with the final absolute `http` or `https` URL: an `http://` address that an ingress redirects to `https://` stops working.",{"_3328":699,"_29138":652,"_20209":49553,"_5":13819,"_26493":49440,"_2816":49554},[],"**Calls are bounded.** A call defaults to a 10 second timeout; a configured `call_timeout` is capped at 30 seconds. Values above the cap are clamped, not rejected.",{"_3328":700,"_29138":652,"_20209":49556,"_5":13819,"_26493":49440,"_2816":49557},[],"**The response body is ignored.** Delivery checks the status code only, so the receiver may answer with any body.",{"_3328":701,"_29138":652,"_20209":49559,"_5":13819,"_26493":49440,"_2816":49560},[],"**API-key headers are restricted.** A custom `apikey_options.header` may not use names that the platform or receiving services trust — for example `X-Principal-Id`, `X-Request-Id`, `Host`, `Content-Type` or `Forwarded` — and no name may start with `X-Forwarded-`, `X-Envoy-` or `X-Lms-`. Comparisons are case-insensitive.",{"_3328":702,"_29138":652,"_20209":49562,"_5":13819,"_26493":49440,"_2816":49563},[],"**Invalid configurations are rejected at subscribe time.** A channel configuration that would fail on every delivery returns HTTP 400 with a body that starts with `struct validation error:`, and the subscription is not created.",{"_3328":703,"_29138":652,"_20209":49565,"_5":13819,"_26493":49440,"_2816":49566},[],"Credentials are sent regardless of the URL scheme. With an `http://` `webhook_url`, the API key or bearer token travels in cleartext and mTLS has no effect. Prefer `https://` for `webhook_url`, `oidc_well_known` and the token endpoint it advertises.",{"_3328":704,"_29138":652,"_20209":49568,"_5":13819,"_26493":49444,"_2816":49569},[],"Open an existing subscription to review its destination and filter, modify the configuration or select **Unsubscribe**. Remove subscriptions that no longer have an operational owner to avoid ignored deliveries or stale endpoints.",{"_3328":705,"_29138":652,"_20209":49571,"_5":13819,"_26493":49444,"_2816":49572},[],"Subscriptions created with older console versions may store the webhook target under `url` and `method` instead of `webhook_url` and `webhook_method`. The service delivers only through `webhook_url` and `webhook_method`, so such a subscription does not deliver even though the subscription details show the stored target. Open the subscription and save it again: the edit form prefills the stored target, and saving rewrites the channel configuration in the current layout.",{"_3328":706,"_29138":652,"_20209":49574,"_5":13819,"_26493":49448,"_2816":49575},[],"**Authorities:** `ca.create`, `ca.import`, `ca.reissue` and `ca.delete`.",{"_3328":707,"_29138":652,"_20209":49577,"_5":13819,"_26493":49448,"_2816":49578},[],"**Certificates:** `ca.sign.certificate` and `certificate.delete`.",{"_3328":708,"_29138":652,"_20209":49580,"_5":13819,"_26493":49448,"_2816":49581},[],"**Profiles:** `profile.issuance.create`, `profile.issuance.update` and `profile.issuance.delete`.",{"_3328":709,"_29138":652,"_20209":49583,"_5":13819,"_26493":49448,"_2816":49584},[],"**Enrollment:** `dms.create`, `dms.update`, `dms.enroll` and `dms.reenroll`.",{"_3328":710,"_29138":652,"_20209":49586,"_5":13819,"_26493":49448,"_2816":49587},[],"**Devices:** `device.create`, `device.identity.update` and `device.status.update`.",{"_3328":711,"_29138":652,"_20209":49589,"_5":13819,"_26493":49448,"_2816":49590},[],"**Validation:** `va.role.crl.create`.",{"_3328":712,"_29138":652,"_20209":49592,"_5":13819,"_26493":49448,"_2816":49593},[],"**Keys:** `kms.create`, `kms.import`, `kms.sign` and `kms.delete`.",{"_3328":713,"_29138":652,"_20209":49595,"_5":13819,"_26493":49448,"_2816":49596},[],"Use the catalog shown in the console as the source for the types available in your deployed version.",{"_3328":714,"_29138":714,"_5":14177,"_2816":49598,"_29461":49599,"_20209":49600,"_26493":714},"Audit logs",[47397,48865,48866],[],{"_3328":715,"_29138":714,"_20209":49602,"_5":13819,"_26493":714,"_2816":49603},[],"Understand which audit events Lamassu generates and how to turn them into a durable trail.",{"_3328":716,"_29138":714,"_5":29458,"_20209":49605,"_26493":49606,"_2816":49607},[],"/docs/platform/administration/audit-logs#what-an-event-contains","What an event contains",{"_3328":717,"_29138":714,"_5":29458,"_20209":49609,"_26493":49610,"_2816":49611},[],"/docs/platform/administration/audit-logs#coverage","Coverage",{"_3328":718,"_29138":714,"_5":29458,"_20209":49613,"_26493":49614,"_2816":49615},[],"/docs/platform/administration/audit-logs#publication-and-persistence","Publication and persistence",{"_3328":719,"_29138":714,"_5":29458,"_20209":49617,"_26493":49618,"_2816":49619},[],"/docs/platform/administration/audit-logs#sensitive-data","Sensitive data",{"_3328":720,"_29138":714,"_5":29458,"_20209":49621,"_26493":49622,"_2816":49623},[],"/docs/platform/administration/audit-logs#a-reproducible-investigation","A reproducible investigation",{"_3328":721,"_29138":714,"_5":29458,"_20209":49625,"_26493":49626,"_2816":49627},[],"/docs/platform/administration/audit-logs#bound-the-interval","Bound the interval",{"_3328":722,"_29138":714,"_5":29458,"_20209":49629,"_26493":49630,"_2816":49631},[],"/docs/platform/administration/audit-logs#identify-the-operation","Identify the operation",{"_3328":723,"_29138":714,"_5":29458,"_20209":49633,"_26493":49634,"_2816":49635},[],"/docs/platform/administration/audit-logs#attribute-the-principal","Attribute the principal",{"_3328":724,"_29138":714,"_5":29458,"_20209":49637,"_26493":49638,"_2816":49639},[],"/docs/platform/administration/audit-logs#compare-intent-and-result","Compare intent and result",{"_3328":725,"_29138":714,"_5":29458,"_20209":49641,"_26493":49642,"_2816":49643},[],"/docs/platform/administration/audit-logs#follow-the-effect","Follow the effect",{"_3328":726,"_29138":714,"_5":29458,"_20209":49645,"_26493":49646,"_2816":49647},[],"/docs/platform/administration/audit-logs#periodic-verification","Periodic verification",{"_3328":727,"_29138":714,"_20209":49649,"_5":13819,"_26493":714,"_2816":49650},[],"Lamassu instruments the mutable operations of its services with audit events. Each event describes the operation, the principals that matched, the input, the result and whether it ended in error.",{"_3328":728,"_29138":714,"_20209":49652,"_5":13819,"_26493":49606,"_2816":49653},[],"The audit body includes:",{"_3328":729,"_29138":714,"_20209":49655,"_5":13819,"_26493":49606,"_2816":49656},[],"input: data received by the operation;",{"_3328":730,"_29138":714,"_20209":49658,"_5":13819,"_26493":49606,"_2816":49659},[],"has\\_error: whether the service returned an error;",{"_3328":731,"_29138":714,"_20209":49661,"_5":13819,"_26493":49606,"_2816":49662},[],"output: produced result or error message;",{"_3328":732,"_29138":714,"_20209":49664,"_5":13819,"_26493":49606,"_2816":49665},[],"principals: identifiers of the principals that matched the request.",{"_3328":733,"_29138":714,"_20209":49667,"_5":13819,"_26493":49606,"_2816":49668},[],"Successful operations use a type prefixed with audit.. Failures publish the operation type suffixed with .error. The CloudEvents event additionally adds source, identifier, date and type.",{"_3328":734,"_29138":714,"_20209":49670,"_5":13819,"_26493":49606,"_2816":49671},[],"The middlewares publish the record after executing the operation, whether it succeeded or returned an error. This lets you investigate attempts as well as confirmed changes.",{"_3328":735,"_29138":714,"_20209":49673,"_5":13819,"_26493":49610,"_2816":49674},[],"The backend applies auditing to mutations of:",{"_3328":736,"_29138":714,"_20209":49676,"_5":13819,"_26493":49610,"_2816":49677},[],"authorities, certificates and issuance profiles;",{"_3328":737,"_29138":714,"_20209":49679,"_5":13819,"_26493":49610,"_2816":49680},[],"keys and KMS engines;",{"_3328":738,"_29138":714,"_20209":49682,"_5":13819,"_26493":49610,"_2816":49683},[],"devices and identities;",{"_3328":739,"_29138":714,"_20209":49685,"_5":13819,"_26493":49610,"_2816":49686},[],"DMSs and enrollment operations;",{"_3328":740,"_29138":714,"_20209":49688,"_5":13819,"_26493":49610,"_2816":49689},[],"validation functions and CRL;",{"_3328":741,"_29138":714,"_20209":49691,"_5":13819,"_26493":49610,"_2816":49692},[],"principals, policies and authorization grants.",{"_3328":742,"_29138":714,"_20209":49694,"_5":13819,"_26493":49610,"_2816":49695},[],"Do not confuse these events with domain events. A domain event announces that a resource changed so another component can react; the audit event keeps input, output and principal context for investigation.",{"_3328":743,"_29138":714,"_20209":49697,"_5":13819,"_26493":49614,"_2816":49698},[],"Services publish audit records to the event bus when their PublisherEventBus is enabled. The backend code does not, by itself, implement a queryable, durable audit file.",{"_3328":744,"_29138":714,"_20209":49700,"_5":13819,"_26493":49614,"_2816":49701},[],"If you need retention, search, tamper protection or regulatory export, connect a consumer that persists the events into the system approved by your organization.",{"_3328":745,"_29138":714,"_20209":49703,"_5":13819,"_26493":49614,"_2816":49704},[],"Design the consumer to:",{"_3328":746,"_29138":714,"_20209":49706,"_5":13819,"_26493":49614,"_2816":49707},[],"subscribe to the audit.# types and also to operation types ending in .error;",{"_3328":747,"_29138":714,"_20209":49709,"_5":13819,"_26493":49614,"_2816":49710},[],"keep the complete CloudEvent unmodified;",{"_3328":748,"_29138":714,"_20209":49712,"_5":13819,"_26493":49614,"_2816":49713},[],"record the ingestion time and detect duplicates by ID;",{"_3328":749,"_29138":714,"_20209":49715,"_5":13819,"_26493":49614,"_2816":49716},[],"encrypt in transit and at rest;",{"_3328":750,"_29138":714,"_20209":49718,"_5":13819,"_26493":49614,"_2816":49719},[],"restrict reading and deletion to a role separate from the PKI operator;",{"_3328":751,"_29138":714,"_20209":49721,"_5":13819,"_26493":49614,"_2816":49722},[],"apply an explicit retention and legal hold policy;",{"_3328":752,"_29138":714,"_20209":49724,"_5":13819,"_26493":49614,"_2816":49725},[],"alert if it stops consuming or the pending queue grows.",{"_3328":753,"_29138":714,"_20209":49727,"_5":13819,"_26493":49618,"_2816":49728},[],"The input and output fields can contain subjects, metadata, public material, configuration or error messages. Evaluate their classification before sending them to an external platform.",{"_3328":754,"_29138":714,"_20209":49730,"_5":13819,"_26493":49618,"_2816":49731},[],"Do not log private keys, provider secrets or full tokens in automations around Lamassu. Restrict export and apply redaction at the destination without destroying the fields needed for attribution.",{"_3328":755,"_29138":714,"_20209":49733,"_5":13819,"_26493":49626,"_2816":49734},[],"Start from the reported time and normalize every source to UTC.",{"_3328":756,"_29138":714,"_20209":49736,"_5":13819,"_26493":49630,"_2816":49737},[],"Filter by event type, service source and resource identifier.",{"_3328":757,"_29138":714,"_20209":49739,"_5":13819,"_26493":49634,"_2816":49740},[],"Review principals and correlate them with the OIDC provider or the X.509 identity valid at that moment.",{"_3328":758,"_29138":714,"_20209":49742,"_5":13819,"_26493":49638,"_2816":49743},[],"Contrast input, has\\_error and output. A failed attempt does not mean the resource changed.",{"_3328":759,"_29138":714,"_20209":49745,"_5":13819,"_26493":49642,"_2816":49746},[],"Look for the domain events and service records that share resource and time window. In a CA revocation, include the cascading operations.",{"_3328":760,"_29138":714,"_20209":49748,"_5":13819,"_26493":49646,"_2816":49749},[],"Generate a controlled mutation in a test environment and check that:",{"_3328":761,"_29138":714,"_20209":49751,"_5":13819,"_26493":49646,"_2816":49752},[],"a successful audit event appears;",{"_3328":762,"_29138":714,"_20209":49754,"_5":13819,"_26493":49646,"_2816":49755},[],"the principal matches the identity used;",{"_3328":763,"_29138":714,"_20209":49757,"_5":13819,"_26493":49646,"_2816":49758},[],"the consumer persists it exactly once;",{"_3328":764,"_29138":714,"_20209":49760,"_5":13819,"_26493":49646,"_2816":49761},[],"it can be retrieved by resource, actor and period;",{"_3328":765,"_29138":714,"_20209":49763,"_5":13819,"_26493":49646,"_2816":49764},[],"a consumer outage raises an alert.",{"_3328":766,"_29138":714,"_20209":49766,"_5":13819,"_26493":49646,"_2816":49767},[],"For metrics, traces and technical logs of the deployment, see Troubleshooting. Audit answers \"who tried to change what\"; observability explains how the system behaved.",{"_3328":767,"_29138":767,"_5":14177,"_2816":49769,"_29461":49770,"_20209":49771,"_26493":767},"Platform architecture",[47397,48865],[],{"_3328":768,"_29138":767,"_20209":49773,"_5":13819,"_26493":767,"_2816":49774},[],"Lamassu components and how control, keys, issuance and devices relate.",{"_3328":769,"_29138":767,"_5":29458,"_20209":49776,"_26493":49777,"_2816":49778},[],"/docs/platform/concepts/architecture#control-plane","Control plane",{"_3328":770,"_29138":767,"_5":29458,"_20209":49780,"_26493":49781,"_2816":49782},[],"/docs/platform/concepts/architecture#key-custody-and-cryptographic-operations","Key custody and cryptographic operations",{"_3328":771,"_29138":767,"_5":29458,"_20209":49784,"_26493":49785,"_2816":49786},[],"/docs/platform/concepts/architecture#issuance-and-enrollment","Issuance and enrollment",{"_3328":772,"_29138":767,"_5":29458,"_20209":49788,"_26493":49789,"_2816":49790},[],"/docs/platform/concepts/architecture#status-and-validation","Status and validation",{"_3328":773,"_29138":767,"_5":29458,"_20209":49792,"_26493":49793,"_2816":49794},[],"/docs/platform/concepts/architecture#platform-dependencies","Platform dependencies",{"_3328":774,"_29138":767,"_20209":49796,"_5":13819,"_26493":767,"_2816":49797},[],"Lamassu deploys as a set of independent services. This separation keeps every component from needing direct access to private keys and lets each capability scale according to load.",{"_3328":775,"_29138":767,"_20209":49799,"_5":13819,"_26493":767,"_2816":49800},[],"Switch to the low level to see the internals of the Lamassu platform box (CA, KMS, DMS, Device Manager, VA, Alerts, AWS IoT connector, Job Manager and the console/API), and to medium to see it as a single platform alongside its external dependencies.",{"_3328":776,"_29138":767,"_20209":49802,"_5":13819,"_26493":49777,"_2816":49803},[],"The console and the APIs manage authorities, certificates, DMSs, devices, alerts and configuration. Domain events allow connectors and automations to react to changes without continuously polling the platform.",{"_3328":777,"_29138":767,"_20209":49805,"_5":13819,"_26493":49781,"_2816":49806},[],"The KMS offers a common interface over software engines, PKCS#11 and cloud providers. The selected engine keeps the key or delegates the cryptographic operation without the other services knowing its implementation.",{"_3328":778,"_29138":767,"_20209":49808,"_5":13819,"_26493":49785,"_2816":49809},[],"The CA service issues certificates and maintains the relationship with its authority. The DMS applies the enrollment rules and exposes the EST flows so a device can request or renew an identity.",{"_3328":779,"_29138":767,"_20209":49811,"_5":13819,"_26493":49789,"_2816":49812},[],"Device Manager keeps the operational view of the device and its history. The Validation Authority publishes OCSP and CRLs so other systems can decide whether to trust a presented certificate.",{"_3328":780,"_29138":767,"_20209":49814,"_5":13819,"_26493":49793,"_2816":49815},[],"In a self-managed deployment, Lamassu uses PostgreSQL for persistence, RabbitMQ for messaging and an OIDC provider for authentication. See the deployment architecture for how the services are published on Kubernetes.",{"_3328":781,"_29138":781,"_5":14177,"_2816":49817,"_29461":49818,"_20209":49819,"_26493":781},"How Lamassu works",[47397,48865],[],{"_3328":782,"_29138":781,"_20209":49821,"_5":13819,"_26493":781,"_2816":49822},[],"The mental model of trust, keys, certificates and devices.",{"_3328":783,"_29138":781,"_5":29458,"_20209":49824,"_26493":49825,"_2816":49826},[],"/docs/platform/concepts/overview#the-model-in-five-pieces","The model in five pieces",{"_3328":784,"_29138":781,"_5":29458,"_20209":49828,"_26493":49829,"_2816":49830},[],"/docs/platform/concepts/overview#from-onboarding-to-operation","From onboarding to operation",{"_3328":785,"_29138":781,"_20209":49832,"_5":13819,"_26493":781,"_2816":49833},[],"Lamassu connects three elements: a **root of trust**, an **issuance policy** and an **entity that needs to prove its identity**. The platform coordinates these elements throughout the certificate lifecycle.",{"_3328":786,"_29138":781,"_20209":49835,"_5":13819,"_26493":49825,"_2816":49836},[],"**Cryptographic engine.** Generates or safeguards keys and executes private-key operations without exposing key material to the rest of the services.",{"_3328":787,"_29138":781,"_20209":49838,"_5":13819,"_26493":49825,"_2816":49839},[],"**Certification Authority (CA).** Signs certificates and establishes the chain of trust.",{"_3328":788,"_29138":781,"_20209":49841,"_5":13819,"_26493":49825,"_2816":49842},[],"**Device Management Service (DMS).** Defines how the devices of a fleet are registered, authenticated and renewed.",{"_3328":789,"_29138":781,"_20209":49844,"_5":13819,"_26493":49825,"_2816":49845},[],"**Device.** Keeps its private key and presents the certificate to prove its identity.",{"_3328":790,"_29138":781,"_20209":49847,"_5":13819,"_26493":49825,"_2816":49848},[],"**Validation Authority (VA).** Publishes the status of certificates through OCSP and CRL.",{"_3328":791,"_29138":781,"_20209":49850,"_5":13819,"_26493":49829,"_2816":49851},[],"An administrator configures a cryptographic engine and creates or imports a CA.",{"_3328":792,"_29138":781,"_20209":49853,"_5":13819,"_26493":49829,"_2816":49854},[],"A DMS relates that CA to an enrollment policy.",{"_3328":793,"_29138":781,"_20209":49856,"_5":13819,"_26493":49829,"_2816":49857},[],"The device generates a key and requests a certificate through EST, or an operator assigns it an identity.",{"_3328":794,"_29138":781,"_20209":49859,"_5":13819,"_26493":49829,"_2816":49860},[],"Lamassu keeps the inventory, history and status of the identity.",{"_3328":795,"_29138":781,"_20209":49862,"_5":13819,"_26493":49829,"_2816":49863},[],"Consumers check the chain and query OCSP or a CRL when they need to know whether it is still valid.",{"_3328":796,"_29138":781,"_20209":49865,"_5":13819,"_26493":49829,"_2816":49866},[],"<Card title=\"Architecture\" description=\"Get to know the components and where each one's responsibility ends.\" href=\"/docs/platform/concepts/architecture\" />",{"_3328":797,"_29138":781,"_20209":49868,"_5":13819,"_26493":49829,"_2816":49869},[],"<Card title=\"Identity lifecycle\" description=\"Follow a certificate from enrollment to renewal or revocation.\" href=\"/docs/platform/pki/concepts/certificate-lifecycle\" />",{"_3328":798,"_29138":798,"_5":14177,"_2816":49871,"_29461":49872,"_20209":49874,"_26493":798},"Devices and identities",[47397,48865,49873,49871],"IoT Fleets",[],{"_3328":799,"_29138":798,"_20209":49876,"_5":13819,"_26493":798,"_2816":49877},[],"Register, inspect and retire devices while checking their current identity and history.",{"_3328":800,"_29138":798,"_5":29458,"_20209":49879,"_26493":49880,"_2816":49881},[],"/docs/platform/iot-fleets/device-management#device-states","Device states",{"_3328":801,"_29138":798,"_5":29458,"_20209":49883,"_26493":49884,"_2816":49885},[],"/docs/platform/iot-fleets/device-management#inspect-a-device","Inspect a device",{"_3328":802,"_29138":798,"_5":29458,"_20209":49887,"_26493":49888,"_2816":49889},[],"/docs/platform/iot-fleets/device-management#register-a-device-manually","Register a device manually",{"_3328":803,"_29138":798,"_5":29458,"_20209":49891,"_26493":49892,"_2816":49893},[],"/docs/platform/iot-fleets/device-management#create-the-device","Create the device",{"_3328":804,"_29138":798,"_5":29458,"_20209":49895,"_26493":49896,"_2816":49897},[],"/docs/platform/iot-fleets/device-management#define-its-membership","Define its membership",{"_3328":805,"_29138":798,"_5":29458,"_20209":49899,"_26493":49900,"_2816":49901},[],"/docs/platform/iot-fleets/device-management#classify-the-device","Classify the device",{"_3328":806,"_29138":798,"_5":29458,"_20209":49903,"_26493":49904,"_2816":49905},[],"/docs/platform/iot-fleets/device-management#verify-the-registration","Verify the registration",{"_3328":807,"_29138":798,"_5":29458,"_20209":49907,"_26493":49908,"_2816":49909},[],"/docs/platform/iot-fleets/device-management#assign-an-identity-manually","Assign an identity manually",{"_3328":808,"_29138":798,"_5":29458,"_20209":49911,"_26493":49912,"_2816":49913},[],"/docs/platform/iot-fleets/device-management#revoke-the-current-identity","Revoke the current identity",{"_3328":809,"_29138":798,"_5":29458,"_20209":49915,"_26493":49916,"_2816":49917},[],"/docs/platform/iot-fleets/device-management#decommission-a-device","Decommission a device",{"_3328":810,"_29138":798,"_5":29458,"_20209":49919,"_26493":49920,"_2816":49921},[],"/docs/platform/iot-fleets/device-management#automate-enrollment","Automate enrollment",{"_3328":811,"_29138":798,"_20209":49923,"_5":13819,"_26493":798,"_2816":49924},[],"This guide is for a fleet operator. You need device, DMS and certificate permissions for the intended actions. A fleet is organized through these resources, tags and metadata; there is no separate “fleet” object to create.",{"_3328":812,"_29138":798,"_20209":49926,"_5":13819,"_26493":798,"_2816":49927},[],"Each device has a `Device ID`, one owning DMS (`dms_owner`) and, once provisioned, an identity slot with an active version and previous versions. In these flows, keep the CSR and certificate `Common Name` equal to `Device ID`: binding uses that CN to update the device.",{"_3328":813,"_29138":798,"_20209":49929,"_5":13819,"_26493":49880,"_2816":49930},[],"Operational view",{"_3328":814,"_29138":798,"_20209":49932,"_5":13819,"_26493":49880,"_2816":49933},[],"Meaning",{"_3328":815,"_29138":798,"_20209":49935,"_5":13819,"_26493":49880,"_2816":49936},[],"**No Identity**",{"_3328":816,"_29138":798,"_20209":49938,"_5":13819,"_26493":49880,"_2816":49939},[],"A record exists without an associated identity.",{"_3328":817,"_29138":798,"_20209":49941,"_5":13819,"_26493":49880,"_2816":49942},[],"**Active**",{"_3328":818,"_29138":798,"_20209":49944,"_5":13819,"_26493":49880,"_2816":49945},[],"The slot is active; also check certificate dates, status and usages.",{"_3328":819,"_29138":798,"_20209":49947,"_5":13819,"_26493":49880,"_2816":49948},[],"**Renewal Pending**",{"_3328":820,"_29138":798,"_20209":49950,"_5":13819,"_26493":49880,"_2816":49951},[],"The identity is in the operational renewal window.",{"_3328":821,"_29138":798,"_20209":49953,"_5":13819,"_26493":49880,"_2816":49954},[],"**Expiring Soon**",{"_3328":822,"_29138":798,"_20209":49956,"_5":13819,"_26493":49880,"_2816":49957},[],"Expiration is approaching according to configured thresholds.",{"_3328":823,"_29138":798,"_20209":49959,"_5":13819,"_26493":49880,"_2816":49960},[],"**Expired**",{"_3328":824,"_29138":798,"_20209":49962,"_5":13819,"_26493":49880,"_2816":49963},[],"The identity has expired.",{"_3328":825,"_29138":798,"_20209":49965,"_5":13819,"_26493":49880,"_2816":49966},[],"**Revoked**",{"_3328":826,"_29138":798,"_20209":49968,"_5":13819,"_26493":49880,"_2816":49969},[],"The identity is marked revoked.",{"_3328":827,"_29138":798,"_20209":49971,"_5":13819,"_26493":49880,"_2816":49972},[],"**Decommissioned**",{"_3328":828,"_29138":798,"_20209":49974,"_5":13819,"_26493":49880,"_2816":49975},[],"The record is retired and ordinary updates do not restore operation.",{"_3328":829,"_29138":798,"_20209":49977,"_5":13819,"_26493":49880,"_2816":49978},[],"Device, slot and certificate states are distinct. Events and jobs can update the view after saving a certificate; an **Active** label does not establish consumer acceptance.",{"_3328":830,"_29138":798,"_20209":49980,"_5":13819,"_26493":49884,"_2816":49981},[],"Filter the inventory by ID, tags and status. Open details and record the owning DMS, active version and current certificate serial.",{"_3328":831,"_29138":798,"_20209":49983,"_5":13819,"_26493":49884,"_2816":49984},[],"**Certificate History** relates previous and current versions. Replacing the slot does not by itself revoke every previous version.",{"_3328":832,"_29138":798,"_20209":49986,"_5":13819,"_26493":49884,"_2816":49987},[],"**Device Event Timeline** helps reconstruct registration, provisioning, renewal and status changes. A change may be saved even if event persistence fails; also inspect the record and certificates.",{"_3328":833,"_29138":798,"_20209":49989,"_5":13819,"_26493":49884,"_2816":49990},[],"Compare these values with the identity installed on the device. Updating a Lamassu slot does not install files on the remote equipment.",{"_3328":834,"_29138":798,"_20209":49992,"_5":13819,"_26493":49888,"_2816":49993},[],"Use this flow to prepare inventory or assign an identity through the console. You need an existing DMS.",{"_3328":835,"_29138":798,"_20209":49995,"_5":13819,"_26493":49892,"_2816":49996},[],"Open registration in **Managed Devices**. Confirm the ID does not already exist in another DMS: ID lookup is not restricted to a fleet.",{"_3328":836,"_29138":798,"_20209":49998,"_5":13819,"_26493":49896,"_2816":49999},[],"Enter **Device ID** and select its owning DMS. The console’s **Registration Authority** label refers to that DMS.",{"_3328":837,"_29138":798,"_20209":50001,"_5":13819,"_26493":49900,"_2816":50002},[],"Add model, environment or location tags and an icon according to your inventory.",{"_3328":838,"_29138":798,"_20209":50004,"_5":13819,"_26493":49904,"_2816":50005},[],"Read the device again: require the intended DMS and **No Identity**. Follow Manual registration to complete assignment.",{"_3328":839,"_29138":798,"_20209":50007,"_5":13819,"_26493":49904,"_2816":50008},[],"Preregistration does not establish that `/simpleenroll` will admit the request. Review its interaction with `enable_replaceable_enrollment` in Provisioning strategies.",{"_3328":840,"_29138":798,"_20209":50010,"_5":13819,"_26493":49908,"_2816":50011},[],"From **No Identity**, use **Assign Identity**:",{"_3328":841,"_29138":798,"_20209":50013,"_5":13819,"_26493":49908,"_2816":50014},[],"Select an active, current certificate suitable for the consumer, with `CN` exactly equal to `Device ID`.",{"_3328":842,"_29138":798,"_20209":50016,"_5":13819,"_26493":49908,"_2816":50017},[],"If unavailable, **Issue New Instead** starts issuance using the intended CA. Review the profile first.",{"_3328":843,"_29138":798,"_20209":50019,"_5":13819,"_26493":49908,"_2816":50020},[],"Confirm and read the serial, active version and history again.",{"_3328":844,"_29138":798,"_20209":50022,"_5":13819,"_26493":49908,"_2816":50023},[],"Install the key/certificate pair and required intermediates on the device and test usage.",{"_3328":845,"_29138":798,"_20209":50025,"_5":13819,"_26493":49908,"_2816":50026},[],"Issuing, binding and installing are separate steps. If an operation fails, check which steps persisted before repeating it.",{"_3328":846,"_29138":798,"_20209":50028,"_5":13819,"_26493":49912,"_2816":50029},[],"Locate the active serial in history and revoke it with an appropriate reason. Verify the record, OCSP/CRL publication and rejection of a new consumer connection using the certificate guide.",{"_3328":847,"_29138":798,"_20209":50031,"_5":13819,"_26493":49912,"_2816":50032},[],"Revocation does not remove the device. It does not automatically enable another enrollment either: recovery depends on its credential, status and DMS policy. `CertificateHold` can be reactivated under PKI conditions; other reasons block subsequent certificate changes.",{"_3328":848,"_29138":798,"_20209":50034,"_5":13819,"_26493":49916,"_2816":50035},[],"Before **Decommission**, inventory active and previous identities, connections and destination permissions. Prepare retirement in the consumer.",{"_3328":849,"_29138":798,"_20209":50037,"_5":13819,"_26493":49916,"_2816":50038},[],"The backend saves **Decommissioned** and attempts to revoke the active version’s certificate with `CessationOfOperation` if the slot was not expired or revoked. It does not traverse all history. Deferred revocation can fail after retirement is saved; check the result by serial.",{"_3328":850,"_29138":798,"_20209":50040,"_5":13819,"_26493":49916,"_2816":50041},[],"Retired status protects ordinary device and slot updates. It does not guarantee that every EST request is rejected before issuance: binding can skip a retired device without returning an error. Check for remaining usable certificates or permissions and block new admission in the relevant control.",{"_3328":851,"_29138":798,"_20209":50043,"_5":13819,"_26493":49916,"_2816":50044},[],"Retain records according to audit policy. Do not reuse a retired ID to hide an equipment change.",{"_3328":852,"_29138":798,"_20209":50046,"_5":13819,"_26493":49920,"_2816":50047},[],"<Card title=\"Enroll and connect a device\" description=\"Obtain an identity from the client and test mTLS.\" href=\"/docs/platform/iot-fleets/quickstarts/enroll-device\" />",{"_3328":853,"_29138":798,"_20209":50049,"_5":13819,"_26493":49920,"_2816":50050},[],"<Card title=\"Renewal and recovery\" description=\"Install the successor and handle failures without losing known state.\" href=\"/docs/platform/iot-fleets/enrollment/renewal-and-recovery\" />",{"_3328":854,"_29138":854,"_5":14177,"_2816":50052,"_29461":50053,"_20209":50055,"_26493":854},"Bootstrap identity and authentication",[47397,48865,49873,49871,50054],"Enrollment with PKI",[],{"_3328":855,"_29138":854,"_20209":50057,"_5":13819,"_26493":854,"_2816":50058},[],"Prepare server trust and admission proofs for enroll and reenroll.",{"_3328":856,"_29138":854,"_5":29458,"_20209":50060,"_26493":50061,"_2816":50062},[],"/docs/platform/iot-fleets/enrollment/bootstrap-identity#initial-server-trust","Initial server trust",{"_3328":857,"_29138":854,"_5":29458,"_20209":50064,"_26493":50065,"_2816":50066},[],"/docs/platform/iot-fleets/enrollment/bootstrap-identity#bootstrap-credential","Bootstrap credential",{"_3328":858,"_29138":854,"_5":29458,"_20209":50068,"_26493":50069,"_2816":50070},[],"/docs/platform/iot-fleets/enrollment/bootstrap-identity#modes-per-operation","Modes per operation",{"_3328":859,"_29138":854,"_5":29458,"_20209":50072,"_26493":50073,"_2816":50074},[],"/docs/platform/iot-fleets/enrollment/bootstrap-identity#webhook-contract","Webhook contract",{"_3328":860,"_29138":854,"_5":29458,"_20209":50076,"_26493":50077,"_2816":50078},[],"/docs/platform/iot-fleets/enrollment/bootstrap-identity#revocation-and-checks","Revocation and checks",{"_3328":861,"_29138":854,"_20209":50080,"_5":13819,"_26493":854,"_2816":50081},[],"This guide connects the DMS administrator with device manufacturing and integration. Before requesting an operational identity, the client must authenticate the EST server and establish entitlement to request the intended ID.",{"_3328":862,"_29138":854,"_20209":50083,"_5":13819,"_26493":50061,"_2816":50084},[],"Install a previously verified root, chain or pin through a trusted channel: manufacturing, approved configuration or authenticated distribution. It enables TLS and server-name verification before downloading `/cacerts`.",{"_3328":863,"_29138":854,"_20209":50086,"_5":13819,"_26493":50061,"_2816":50087},[],"Your only trust proof cannot come from the same unauthenticated server. The EST server TLS certificate, bootstrap certificate and operational identity issuer may belong to different hierarchies.",{"_3328":864,"_29138":854,"_20209":50089,"_5":13819,"_26493":50065,"_2816":50090},[],"With `CLIENT_CERTIFICATE`, the device presents its initial certificate and proves key possession through TLS. The DMS validates it against admission CAs. In the inspected flow, the validator receives one leaf credential: configure and test the direct issuer for the simple case; sending more intermediates does not establish delivery to the service.",{"_3328":865,"_29138":854,"_20209":50092,"_5":13819,"_26493":50065,"_2816":50093},[],"Check dates, matching certificate/key and revocation before provisioning. A credential shared across equipment identifies that shared credential, not an individual device.",{"_3328":866,"_29138":854,"_20209":50095,"_5":13819,"_26493":50065,"_2816":50096},[],"Initial mTLS validation does not by itself compare bootstrap CN with the requested CSR CN. If a requester should only request its own `Device ID`, add a control binding credential to ID, such as the combined webhook, and test a request with another CN. Certificate re-enrollment does compare its CN to the CSR; subsequent checks use the registered active identity.",{"_3328":867,"_29138":854,"_20209":50098,"_5":13819,"_26493":50069,"_2816":50099},[],"Select the four modes independently for enrollment and re-enrollment in DMS. Renewal credentials depend on that block; do not assume the bootstrap is always used or the webhook disappears.",{"_3328":868,"_29138":854,"_20209":50101,"_5":13819,"_26493":50069,"_2816":50102},[],"An administrative OIDC token is not a native EST mode. A webhook may interpret an agreed credential header; that service then performs authorization. In NO\\_AUTH, sending a token does not add DMS authentication.",{"_3328":869,"_29138":854,"_20209":50104,"_5":13819,"_26493":50073,"_2816":50105},[],"The DMS sends operation context to the configured service. Method comes from configuration; agree the contract before selecting POST or PUT. Authorization wait defaults to 10 seconds, replaced by a configured positive timeout. The DMS verifies the receiver certificate unless `insecure_skip_verify` is enabled in the webhook config — verification is on by default — and does not follow redirects, so the configured URL must be the final one. The authorization response must be JSON of at most 1 MiB. With Lamassu-to-webhook authentication configured over `http://`, the API key or bearer token travels in cleartext, and mTLS has no effect because no TLS handshake takes place, so the client certificate is never presented; prefer `https://`. Configure those options in the webhook settings of the DMS guide.",{"_3328":870,"_29138":854,"_20209":50107,"_5":13819,"_26493":50073,"_2816":50108},[],"Example body:",{"_3328":871,"_29138":854,"_20209":50110,"_5":13819,"_26493":50073,"_2816":50111},[],"`csr` is **base64 of PEM**, unlike the EST body, which is base64 of DER. `http_request` contains URL and first header entries from available HTTP context. This body does not include an `operation` field; distinguish enroll and reenroll through the path and configured policy.",{"_3328":872,"_29138":854,"_20209":50113,"_5":13819,"_26493":50073,"_2816":50114},[],"The webhook should verify credential, its relationship to `device_cn`, DMS, operation and admission policy. Forwarded headers are not themselves trusted evidence. **Lamassu-to-webhook authentication** is a separate relationship configured in the server’s HTTP client.",{"_3328":873,"_29138":854,"_20209":50116,"_5":13819,"_26493":50073,"_2816":50117},[],"Continuation requires a successful HTTP response and JSON:",{"_3328":874,"_29138":854,"_20209":50119,"_5":13819,"_26493":50073,"_2816":50120},[],"A bodyless `204` does not satisfy the contract. Denial, transport error, uninterpretable response or timeout abort authorization. Combined mode validates the certificate first, then queries the webhook. See the webhook specification.",{"_3328":875,"_29138":854,"_20209":50122,"_5":13819,"_26493":50077,"_2816":50123},[],"The DMS first looks up the certificate in Lamassu; for external certificates it attempts OCSP and CRL. If revocation cannot be checked, validators can continue treating it as not revoked. The code also does not establish rejection of every external status other than Good. Test required behavior with your actual credential and endpoint; do not present this as guaranteed strict enforcement across every source.",{"_3328":876,"_29138":854,"_20209":50125,"_5":13819,"_26493":50077,"_2816":50126},[],"Test an allowed certificate, an incorrect one, another CN, webhook denial, timeout and re-enrollment under its own policy. Keep results and schedule bootstrap credential retirement where appropriate. Continue with EST client.",{"_3328":877,"_29138":877,"_5":14177,"_2816":50128,"_29461":50129,"_20209":50130,"_26493":877},"Configure and operate the DMS",[47397,48865,49873,49871,50054],[],{"_3328":878,"_29138":877,"_20209":50132,"_5":13819,"_26493":877,"_2816":50133},[],"Define registration, authentication per operation, issuance, renewal and distributed trust.",{"_3328":879,"_29138":877,"_5":29458,"_20209":50135,"_26493":50136,"_2816":47407},[],"/docs/platform/iot-fleets/enrollment/dms#before-you-begin",{"_3328":880,"_29138":877,"_5":29458,"_20209":50138,"_26493":50139,"_2816":50140},[],"/docs/platform/iot-fleets/enrollment/dms#configure-a-dms","Configure a DMS",{"_3328":881,"_29138":877,"_5":29458,"_20209":50142,"_26493":50143,"_2816":50144},[],"/docs/platform/iot-fleets/enrollment/dms#identify-the-fleet","Identify the fleet",{"_3328":882,"_29138":877,"_5":29458,"_20209":50146,"_26493":50147,"_2816":50148},[],"/docs/platform/iot-fleets/enrollment/dms#select-the-enrollment-ca","Select the enrollment CA",{"_3328":883,"_29138":877,"_5":29458,"_20209":50150,"_26493":50151,"_2816":50152},[],"/docs/platform/iot-fleets/enrollment/dms#configure-est","Configure EST",{"_3328":884,"_29138":877,"_5":29458,"_20209":50154,"_26493":50155,"_2816":50156},[],"/docs/platform/iot-fleets/enrollment/dms#distribute-trust","Distribute trust",{"_3328":885,"_29138":877,"_5":29458,"_20209":50158,"_26493":50159,"_2816":50160},[],"/docs/platform/iot-fleets/enrollment/dms#verify-the-endpoints","Verify the endpoints",{"_3328":886,"_29138":877,"_5":29458,"_20209":50162,"_26493":50163,"_2816":50164},[],"/docs/platform/iot-fleets/enrollment/dms#enrollment-configuration","Enrollment configuration",{"_3328":887,"_29138":877,"_5":29458,"_20209":50166,"_26493":50167,"_2816":50168},[],"/docs/platform/iot-fleets/enrollment/dms#enrollment-device-registration","Enrollment Device Registration",{"_3328":888,"_29138":877,"_5":29458,"_20209":50170,"_26493":50171,"_2816":50172},[],"/docs/platform/iot-fleets/enrollment/dms#enrollment-settings","Enrollment Settings",{"_3328":889,"_29138":877,"_5":29458,"_20209":50174,"_26493":50175,"_2816":50176},[],"/docs/platform/iot-fleets/enrollment/dms#authentication-per-operation","Authentication per operation",{"_3328":890,"_29138":877,"_5":29458,"_20209":50178,"_26493":50179,"_2816":50180},[],"/docs/platform/iot-fleets/enrollment/dms#external-webhook-settings","External webhook settings",{"_3328":891,"_29138":877,"_5":29458,"_20209":50182,"_26493":50183,"_2816":50184},[],"/docs/platform/iot-fleets/enrollment/dms#issuance-profile","Issuance profile",{"_3328":892,"_29138":877,"_5":29458,"_20209":50186,"_26493":50187,"_2816":50188},[],"/docs/platform/iot-fleets/enrollment/dms#re-enrollment-configuration","Re-enrollment configuration",{"_3328":893,"_29138":877,"_5":29458,"_20209":50190,"_26493":50191,"_2816":50192},[],"/docs/platform/iot-fleets/enrollment/dms#serverkeygen","ServerKeyGen",{"_3328":894,"_29138":877,"_5":29458,"_20209":50194,"_26493":50195,"_2816":50196},[],"/docs/platform/iot-fleets/enrollment/dms#trust-distribution","Trust distribution",{"_3328":895,"_29138":877,"_5":29458,"_20209":50198,"_26493":50199,"_2816":50200},[],"/docs/platform/iot-fleets/enrollment/dms#operate-the-dms-inventory","Operate the DMS inventory",{"_3328":896,"_29138":877,"_5":29458,"_20209":50202,"_26493":50203,"_2816":50204},[],"/docs/platform/iot-fleets/enrollment/dms#integrate-the-devices","Integrate the devices",{"_3328":897,"_29138":877,"_20209":50206,"_5":13819,"_26493":877,"_2816":50207},[],"A &#x2A;*Device Management Service (DMS)** configures admission and identity lifecycle for its devices. It acts as a registration authority; the CA selected in `Enrollment CA` signs certificates. This guide is for the policy administrator.",{"_3328":898,"_29138":877,"_20209":50209,"_5":13819,"_26493":50136,"_2816":50210},[],"You need DMS management permissions, an active CA with a usable key and a tested issuance profile. Agree device ID, initial credential, consumer and renewal window with the integrator. Review Provisioning strategies before choosing registration and replacement.",{"_3328":899,"_29138":877,"_20209":50212,"_5":13819,"_26493":50136,"_2816":50213},[],"Prepare EST server trust and device connectivity through Deployment. Your operator’s administrative authentication does not replace device EST authentication.",{"_3328":900,"_29138":877,"_20209":50215,"_5":13819,"_26493":50143,"_2816":50216},[],"Create the DMS with a recognizable name and retain its ID. EST URLs use this identifier, not the display name. Each device retains one owning DMS.",{"_3328":901,"_29138":877,"_20209":50218,"_5":13819,"_26493":50147,"_2816":50219},[],"Choose **Enrollment CA** and an explicit profile appropriate for the end-entity identity. Keep CN compatible with `Device ID`. The test certificate should allow its intended purpose and expire within issuer validity.",{"_3328":902,"_29138":877,"_20209":50221,"_5":13819,"_26493":50151,"_2816":50222},[],"Select initial enrollment registration and authentication. Separately configure re-enrollment authentication, thresholds and previous certificate retirement. Leave ServerKeyGen disabled if the client generates its key.",{"_3328":903,"_29138":877,"_20209":50224,"_5":13819,"_26493":50155,"_2816":50225},[],"Select certificates returned by `/cacerts`. Explicitly include required intermediates and roots, keeping distribution distinct from automatic trust installation.",{"_3328":904,"_29138":877,"_20209":50227,"_5":13819,"_26493":50159,"_2816":50228},[],"Save and read configuration again. Query `/cacerts`, perform an allowed and a rejected enrollment, and inspect device, serial and history. Creating the DMS or downloading cacerts does not establish working authentication and issuance.",{"_3328":905,"_29138":877,"_20209":50230,"_5":13819,"_26493":50167,"_2816":50231},[],"`settings.enrollment_settings.registration_mode` accepts `JITP` or `PRE_REGISTRATION`. JITP creates an unknown device with the CSR CN as ID and the DMS as owner. `device_provisioning_profile` supplies tags, metadata and icon for that registration.",{"_3328":906,"_29138":877,"_20209":50233,"_5":13819,"_26493":50167,"_2816":50234},[],"PRE\\_REGISTRATION requires an existing ID. In the inspected code, an existing device encounters replacement checks first, even without an identity. Review preregistration conditions before using this mode.",{"_3328":907,"_29138":877,"_20209":50236,"_5":13819,"_26493":50171,"_2816":50237},[],"`settings.enrollment_settings` field",{"_3328":908,"_29138":877,"_20209":50239,"_5":13819,"_26493":50171,"_2816":50240},[],"Decision",{"_3328":909,"_29138":877,"_20209":50242,"_5":13819,"_26493":50171,"_2816":50243},[],"`protocol`",{"_3328":910,"_29138":877,"_20209":50245,"_5":13819,"_26493":50171,"_2816":50246},[],"`EST_RFC7030` for these operations.",{"_3328":911,"_29138":877,"_20209":50248,"_5":13819,"_26493":50171,"_2816":50249},[],"`enrollment_ca`",{"_3328":912,"_29138":877,"_20209":50251,"_5":13819,"_26493":50171,"_2816":50252},[],"ID of the signing CA.",{"_3328":913,"_29138":877,"_20209":50254,"_5":13819,"_26493":50171,"_2816":50255},[],"`verify_csr_signature`",{"_3328":914,"_29138":877,"_20209":50257,"_5":13819,"_26493":50171,"_2816":50258},[],"Keep `true` to verify CSR key possession.",{"_3328":915,"_29138":877,"_20209":50260,"_5":13819,"_26493":50171,"_2816":50261},[],"`enable_replaceable_enrollment`",{"_3328":916,"_29138":877,"_20209":50263,"_5":13819,"_26493":50171,"_2816":50264},[],"Allows `/simpleenroll` for an existing ID in the same DMS. It can attempt previous certificate revocation even if a later phase fails; this is not atomic.",{"_3328":917,"_29138":877,"_20209":50266,"_5":13819,"_26493":50171,"_2816":50267},[],"`est_rfc7030_settings.auth_mode`",{"_3328":918,"_29138":877,"_20209":50269,"_5":13819,"_26493":50171,"_2816":50270},[],"One of the four authentication modes.",{"_3328":919,"_29138":877,"_20209":50272,"_5":13819,"_26493":50171,"_2816":50273},[],"Initial enrollment rejects an ID owned by another DMS. Do not automatically enable replacement in response to an error; Troubleshooting distinguishes repeated IDs, ownership and partial changes.",{"_3328":920,"_29138":877,"_20209":50275,"_5":13819,"_26493":50175,"_2816":50276},[],"The blocks are independent:",{"_3328":921,"_29138":877,"_20209":50278,"_5":13819,"_26493":50175,"_2816":50279},[],"`settings.enrollment_settings.est_rfc7030_settings` for `/simpleenroll` and `/serverkeygen`.",{"_3328":922,"_29138":877,"_20209":50281,"_5":13819,"_26493":50175,"_2816":50282},[],"`settings.reenrollment_settings.est_rfc7030_settings` for `/simplereenroll`.",{"_3328":923,"_29138":877,"_20209":50284,"_5":13819,"_26493":50175,"_2816":50285},[],"`auth_mode`",{"_3328":924,"_29138":877,"_20209":50287,"_5":13819,"_26493":50175,"_2816":50288},[],"Control applied in the configured operation",{"_3328":925,"_29138":877,"_20209":50290,"_5":13819,"_26493":50175,"_2816":50291},[],"`CLIENT_CERTIFICATE`",{"_3328":926,"_29138":877,"_20209":50293,"_5":13819,"_26493":50175,"_2816":50294},[],"Presented certificate validation.",{"_3328":927,"_29138":877,"_20209":50296,"_5":13819,"_26493":50175,"_2816":50297},[],"`EXTERNAL_WEBHOOK`",{"_3328":928,"_29138":877,"_20209":50299,"_5":13819,"_26493":50175,"_2816":50300},[],"Configured webhook authorization.",{"_3328":929,"_29138":877,"_20209":50302,"_5":13819,"_26493":50175,"_2816":50303},[],"`CLIENT_CERTIFICATE_AND_EXTERNAL_WEBHOOK`",{"_3328":930,"_29138":877,"_20209":50305,"_5":13819,"_26493":50175,"_2816":50306},[],"Certificate validation followed by webhook approval.",{"_3328":931,"_29138":877,"_20209":50308,"_5":13819,"_26493":50175,"_2816":50309},[],"`NO_AUTH`",{"_3328":932,"_29138":877,"_20209":50311,"_5":13819,"_26493":50175,"_2816":50312},[],"No DMS requester authentication.",{"_3328":933,"_29138":877,"_20209":50314,"_5":13819,"_26493":50175,"_2816":50315},[],"Webhook and combined modes also execute during re-enrollment when configured in its block. They do not implicitly degrade to NO\\_AUTH. An absent or unrecognized mode fails.",{"_3328":934,"_29138":877,"_20209":50317,"_5":13819,"_26493":50175,"_2816":50318},[],"For initial mTLS, `client_certificate_settings` contains `validation_cas`, `allow_expired` and `chain_level_validation`. The inspected flow receives one certificate credential; it does not guarantee forwarding every handshake intermediate to the validator. For a direct case, configure the bootstrap’s direct issuer as validation CA and test the actual Gateway path.",{"_3328":935,"_29138":877,"_20209":50320,"_5":13819,"_26493":50175,"_2816":50321},[],"For certificate re-enrollment, the validator tries the enrollment CA first and then the CAs listed in `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`; those are the re-enrollment validation CAs. That list is optional because the enrollment CA is always trusted for re-enrollment, and each settings block consults only its own `validation_cas`. CAs listed only in the initial block's `validation_cas` do not extend re-enrollment acceptance; during a CA rotation, add the old issuance CA to the re-enrollment block's list. The re-enrollment validator compares the presented TLS leaf against those CAs; the re-enrollment block's `chain_level_validation` and `allow_expired` values are stored but not consulted, and expiry is governed by `enable_expired_renewal`.",{"_3328":936,"_29138":877,"_20209":50323,"_5":13819,"_26493":50175,"_2816":50324},[],"For a webhook, configure destination, Lamassu-to-service authentication, method and timeout. The authentication contract explains the device credential and request body. `NO_AUTH` does not establish ownership of the requested ID.",{"_3328":937,"_29138":877,"_20209":50326,"_5":13819,"_26493":50179,"_2816":50327},[],"The webhook authentication modes read `external_webhook_settings` in the same `est_rfc7030_settings` block:",{"_3328":938,"_29138":877,"_20209":50329,"_5":13819,"_26493":50179,"_2816":50330},[],"`external_webhook_settings` field",{"_3328":939,"_29138":877,"_20209":50332,"_5":13819,"_26493":50179,"_2816":50240},[],{"_3328":940,"_29138":877,"_20209":50334,"_5":13819,"_26493":50179,"_2816":50335},[],"`url`",{"_3328":941,"_29138":877,"_20209":50337,"_5":13819,"_26493":50179,"_2816":50338},[],"Absolute `http` or `https` URL of the receiver. It must be the final URL; redirects are not followed.",{"_3328":942,"_29138":877,"_20209":50340,"_5":13819,"_26493":50179,"_2816":50341},[],"`method`",{"_3328":943,"_29138":877,"_20209":50343,"_5":13819,"_26493":50179,"_2816":50344},[],"`POST` or `PUT`; `POST` by default.",{"_3328":944,"_29138":877,"_20209":50346,"_5":13819,"_26493":50179,"_2816":50347},[],"`name`",{"_3328":945,"_29138":877,"_20209":50349,"_5":13819,"_26493":50179,"_2816":50350},[],"Label used in service logs.",{"_3328":946,"_29138":877,"_20209":50352,"_5":13819,"_26493":50179,"_2816":50353},[],"`config.auth_mode`",{"_3328":947,"_29138":877,"_20209":50355,"_5":13819,"_26493":50179,"_2816":50356},[],"`noauth`, `apikey`, `jwt` or `mtls`. An absent or unknown value behaves as `noauth`.",{"_3328":948,"_29138":877,"_20209":50358,"_5":13819,"_26493":50179,"_2816":50359},[],"`config.log_level`",{"_3328":949,"_29138":877,"_20209":50361,"_5":13819,"_26493":50179,"_2816":50362},[],"Log level of the webhook call: `debug`, `info`, `warn` or `error`; `info` by default.",{"_3328":950,"_29138":877,"_20209":50364,"_5":13819,"_26493":50179,"_2816":50365},[],"`config.apikey_options`",{"_3328":951,"_29138":877,"_20209":50367,"_5":13819,"_26493":50179,"_2816":50368},[],"Required for `apikey`: `header` and `key`. Reserved header names are rejected.",{"_3328":952,"_29138":877,"_20209":50370,"_5":13819,"_26493":50179,"_2816":50371},[],"`config.jwt_options`",{"_3328":953,"_29138":877,"_20209":50373,"_5":13819,"_26493":50179,"_2816":50374},[],"Required for `jwt`: `oidc_client_id`, `oidc_client_secret` and an absolute `http` or `https` `oidc_well_known`.",{"_3328":954,"_29138":877,"_20209":50376,"_5":13819,"_26493":50179,"_2816":50377},[],"`config.mtls_options`",{"_3328":955,"_29138":877,"_20209":50379,"_5":13819,"_26493":50179,"_2816":50380},[],"Required for `mtls`: `cert_content` and `key_content` as Base64-encoded PEM, like certificates elsewhere in the API; plain PEM is also accepted.",{"_3328":956,"_29138":877,"_20209":50382,"_5":13819,"_26493":50179,"_2816":50383},[],"`config.insecure_skip_verify`",{"_3328":957,"_29138":877,"_20209":50385,"_5":13819,"_26493":50179,"_2816":50386},[],"Skips verification of the receiver certificate when `true`. Verification is on by default. Unlike alert channels, this flag is honored here.",{"_3328":958,"_29138":877,"_20209":50388,"_5":13819,"_26493":50179,"_2816":50389},[],"`config.call_timeout`",{"_3328":959,"_29138":877,"_20209":50391,"_5":13819,"_26493":50179,"_2816":50392},[],"Maximum duration of the authorization call (for example `10s`); 10 seconds by default.",{"_3328":960,"_29138":877,"_20209":50394,"_5":13819,"_26493":50179,"_2816":50395},[],"Rules for that configuration:",{"_3328":961,"_29138":877,"_20209":50397,"_5":13819,"_26493":50179,"_2816":50398},[],"Creating or updating a DMS whose enrollment or reenrollment `auth_mode` uses the webhook validates the block and returns HTTP 400 — the body starts with `struct validation error:` and continues with `invalid enrollment external webhook config` or `invalid reenrollment external webhook config` — when the URL, method or options are invalid. That includes an `mtls_options.cert_content`/`key_content` pair that does not decode to a matching certificate and private key. File references (`ca_cert_file`, `mtls_options.cert_file`, `mtls_options.key_file`) are always invalid: the service does not read files, so enter the certificate and key as Base64-encoded PEM in `mtls_options.cert_content` and `key_content`, or as plain PEM.",{"_3328":962,"_29138":877,"_20209":50400,"_5":13819,"_26493":50179,"_2816":50401},[],"A custom `apikey_options.header` may not use names that the platform or the receiving service trusts — for example `X-Principal-Id`, `X-Request-Id`, `Host`, `Content-Type` or `Forwarded` — and no name may start with `X-Forwarded-`, `X-Envoy-` or `X-Lms-` (case-insensitive). The DMS API reference documents the `WebhookCall` and `WebhookCallHttpClient` schemas and that reserved API-key headers are rejected.",{"_3328":963,"_29138":877,"_20209":50403,"_5":13819,"_26493":50179,"_2816":50404},[],"The nested `http_client` key exists only in alert channel configurations; in a DMS body it is ignored. The DMS key is `external_webhook_settings.config`.",{"_3328":964,"_29138":877,"_20209":50406,"_5":13819,"_26493":50179,"_2816":50407},[],"A body with `config.auth_mode` set to `apikey`, `jwt` or `mtls` must carry its corresponding option block (`apikey_options`, `jwt_options` or `mtls_options`) — and nothing else. Bodies with those auth modes carrying only `apikey`, `oidc` or `mtls` fail validation with 400, and `validate_server_cert` is always ignored: use `insecure_skip_verify`. Only bodies without option blocks are accepted as `noauth`, and their credentials are dropped.",{"_3328":965,"_29138":877,"_20209":50409,"_5":13819,"_26493":50179,"_2816":50410},[],"The authorization response must be JSON of at most 1 MiB; a larger body fails the call.",{"_3328":966,"_29138":877,"_20209":50412,"_5":13819,"_26493":50179,"_2816":50413},[],"With credentials configured, they are sent regardless of the URL scheme: an `http://` webhook receives the API key or bearer token in cleartext, and mTLS has no effect because no TLS handshake takes place, so the client certificate is never presented. Prefer `https://` for `url`, `oidc_well_known` and the token endpoint it advertises.",{"_3328":967,"_29138":877,"_20209":50415,"_5":13819,"_26493":50179,"_2816":50416},[],"Initial authentication and renewal settings are stored independently. If a DMS only has the initial authentication block, renewal reuses it: read both blocks before editing. The console exposes independent editors for the enrollment and re-enrollment authentication, with the same Log Level, Call Timeout, HTTP Authentication and credential fields as the webhook channels, plus a **Skip TLS Verification** switch (off by default, so verification stays on; the console warns when you enable it).",{"_3328":968,"_29138":877,"_20209":50418,"_5":13819,"_26493":50179,"_2816":50419},[],"Webhook credentials must be stored as PEM content. File references (`ca_cert_file`, `mtls_options.cert_file`, `mtls_options.key_file`) are never valid in a stored webhook config: delivery rejects any webhook config that references files, whatever its auth mode, so every enroll and reenroll that calls that webhook fails until the certificate and key are entered as Base64-encoded or plain PEM in `mtls_options.cert_content` and `key_content`, or the file fields are removed if the webhook does not use mTLS. If a stored config holds file paths in `mtls_options.cert_content` or `key_content`, every full settings update (`POST /v1/dms`, `PUT /v1/dms/:id`) fails validation — settings are replaced wholesale, so the stored config must be resent — until the values are replaced by PEM content or the webhook stops being used. Meanwhile, delivery of that webhook fails on every call; a metadata-only update through `PUT` or `PATCH` on `/v1/dms/:id/metadata` still succeeds. To fix it in the console, open the DMS, replace any file-path value with PEM content — the editor rejects file paths with an inline field error — and save. Saving rewrites `external_webhook_settings.config` with the current keys, and the console reads both plain and Base64-encoded PEM from migrated configurations and stores the material Base64-encoded. If your stored config previously relied on `validate_server_cert: false`, it now carries `insecure_skip_verify: true`: receiver-certificate verification stays skipped until you set that flag to `false`. See 3.8.0 to 4.0.0 for the upgrade notes and the operator checklist.",{"_3328":969,"_29138":877,"_20209":50421,"_5":13819,"_26493":50179,"_2816":50422},[],"The re-enrollment trust set lives in `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`. The flat field `reenrollment_settings.additional_validation_cas` is not part of the API: bodies that carry it are accepted but the value is silently ignored — unknown JSON fields are dropped — and GET responses do not include it. Read the DMS before sending API edits: an update body built with that flat field silently empties `validation_cas`.",{"_3328":970,"_29138":877,"_20209":50424,"_5":13819,"_26493":50183,"_2816":50425},[],"`settings.issuance_profile_id` takes precedence over `settings.issuance_profile`; without either, the CA default profile is used. Rules are documented once in Profiles. DMS changes affect future requests; they do not modify signed certificates or install client trust.",{"_3328":971,"_29138":877,"_20209":50427,"_5":13819,"_26493":50187,"_2816":50428},[],"`settings.reenrollment_settings` field",{"_3328":972,"_29138":877,"_20209":50430,"_5":13819,"_26493":50187,"_2816":47787},[],{"_3328":973,"_29138":877,"_20209":50432,"_5":13819,"_26493":50187,"_2816":50433},[],"`reenrollment_delta`",{"_3328":974,"_29138":877,"_20209":50435,"_5":13819,"_26493":50187,"_2816":50436},[],"Opens the window at the active certificate’s `NotAfter` minus this delta.",{"_3328":975,"_29138":877,"_20209":50438,"_5":13819,"_26493":50187,"_2816":50439},[],"`preventive_delta`",{"_3328":976,"_29138":877,"_20209":50441,"_5":13819,"_26493":50187,"_2816":50442},[],"Preventive operational monitoring threshold.",{"_3328":977,"_29138":877,"_20209":50444,"_5":13819,"_26493":50187,"_2816":50445},[],"`critical_delta`",{"_3328":978,"_29138":877,"_20209":50447,"_5":13819,"_26493":50187,"_2816":50448},[],"Critical operational monitoring threshold.",{"_3328":979,"_29138":877,"_20209":50450,"_5":13819,"_26493":50187,"_2816":50451},[],"`enable_expired_renewal`",{"_3328":980,"_29138":877,"_20209":50453,"_5":13819,"_26493":50187,"_2816":50454},[],"Accepts an expired presented certificate in the renewal mTLS validator. Does not authorize another mode or remove Gateway constraints by itself.",{"_3328":981,"_29138":877,"_20209":50456,"_5":13819,"_26493":50187,"_2816":50457},[],"`est_rfc7030_settings.client_certificate_settings.validation_cas`",{"_3328":982,"_29138":877,"_20209":50459,"_5":13819,"_26493":50187,"_2816":50460},[],"Re-enrollment validation CAs for the renewal mTLS credential, tried after the enrollment CA; optional, because the enrollment CA is always trusted. Typically populated during CA rotation while old-CA cohorts renew.",{"_3328":983,"_29138":877,"_20209":50462,"_5":13819,"_26493":50187,"_2816":50463},[],"`revoke_on_reenrollment`",{"_3328":984,"_29138":877,"_20209":50465,"_5":13819,"_26493":50187,"_2816":50466},[],"If the previous certificate is ACTIVE, attempts Superseded revocation before binding its successor.",{"_3328":985,"_29138":877,"_20209":50468,"_5":13819,"_26493":50187,"_2816":50469},[],"Monitoring does not renew: the client must schedule the request and installation. Webhook and NO\\_AUTH modes do not use the same mTLS expired-credential validator; the webhook must explicitly authorize permitted recovery. Review Renewal and recovery for operation order and partial failures.",{"_3328":986,"_29138":877,"_20209":50471,"_5":13819,"_26493":50191,"_2816":50472},[],"`settings.server_keygen_settings.enabled` enables software key generation on the server. The console exposes it through an **Enable server-side key generation** switch and a **Key type** selection: `ECDSA` P-256, P-384 or P-521, or `RSA` with 2048, 3072 or 4096 bits; the defaults are P-256 for `ECDSA` and 4096 bit for `RSA`. Algorithm and size come from its `key` field, stored as `{type,bits}` where P-256, P-384 and P-521 map to `bits` 256, 384 and 521; `key` is omitted when disabled. The profile must permit them. The response contains an unencrypted PKCS#8 key inside TLS alongside the certificate. See format and extraction in EST reference.",{"_3328":987,"_29138":877,"_20209":50474,"_5":13819,"_26493":50195,"_2816":47781},[],{"_3328":988,"_29138":877,"_20209":50476,"_5":13819,"_26493":50195,"_2816":50477},[],"Published material",{"_3328":989,"_29138":877,"_20209":50479,"_5":13819,"_26493":50195,"_2816":50480},[],"**Include Lamassu System CA**",{"_3328":990,"_29138":877,"_20209":50482,"_5":13819,"_26493":50195,"_2816":50483},[],"Available downstream TLS certificate; it can be a leaf, not an issuing CA.",{"_3328":991,"_29138":877,"_20209":50485,"_5":13819,"_26493":50195,"_2816":50486},[],"**Include Enrollment CA**",{"_3328":992,"_29138":877,"_20209":50488,"_5":13819,"_26493":50195,"_2816":50489},[],"Selected issuing CA certificate.",{"_3328":993,"_29138":877,"_20209":50491,"_5":13819,"_26493":50195,"_2816":50492},[],"**Managed CAs**",{"_3328":994,"_29138":877,"_20209":50494,"_5":13819,"_26493":50195,"_2816":50495},[],"Explicitly selected CA certificates.",{"_3328":995,"_29138":877,"_20209":50497,"_5":13819,"_26493":50195,"_2816":50498},[],"All ancestors are not added automatically. Trust distribution distinguishes trusted roots, intermediates and initial server trust.",{"_3328":996,"_29138":877,"_20209":50500,"_5":13819,"_26493":50199,"_2816":50501},[],"**Edit** changes name, settings and metadata. Updates go through the DMS API. `PUT /v1/dms/{id}` always targets the DMS identified by the URL path: the body carries no `id` field, and any `id` or `creation_ts` in it is silently ignored — authorization is evaluated against the same URL identifier. The body must include a non-empty `name` and a `settings` object; missing either returns HTTP 400 and leaves the stored DMS unchanged. `name` and `settings` are always full replacements, so read the DMS before sending API edits to avoid losing fields. `metadata` is optional: omitting it or sending `null` keeps the stored metadata, a supplied object replaces it entirely, and `{}` clears it (a later GET returns an empty object, not `null`). Old-style bodies that carry the full DMS object keep working while they include `name` and `settings`; unknown fields are ignored. Updates reject an empty `name` with HTTP 400: a DMS whose stored name was zeroed by an earlier update must be renamed before any client round-trips it — the AWS IoT connector’s JITP writeback included. If the object does not include the AWS IoT connector key (`lamassu.io/iot/{connector_id}`), the connector ignores the DMS's later events.",{"_3328":997,"_29138":877,"_20209":50503,"_5":13819,"_26493":50199,"_2816":50504},[],"**Go to DMS owned devices** restricts inventory by owner. **Show/Edit Metadata** contains operational and integration data; consult the integration guide before changing it. &#x2A;*EST (RFC-7030)** helps locate URLs.",{"_3328":998,"_29138":877,"_20209":50506,"_5":13819,"_26493":50199,"_2816":50507},[],"**Delete** removes the DMS record and configuration; it does not itself cascade revocation across every device and certificate. Migrate dependencies and retain audit references before retirement.",{"_3328":999,"_29138":877,"_20209":50509,"_5":13819,"_26493":50203,"_2816":50510},[],"Continue with EST client or the enrollment and mTLS tutorial. EST reference covers formats; Troubleshooting covers failures.",{"_3328":1000,"_29138":1000,"_5":14177,"_2816":50512,"_29461":50513,"_20209":50514,"_26493":1000},"Integrate the EST client",[47397,48865,49873,49871,50054],[],{"_3328":1001,"_29138":1000,"_20209":50516,"_5":13819,"_26493":1000,"_2816":50517},[],"Prepare trust, send a CSR and check the identity you receive.",{"_3328":1002,"_29138":1000,"_5":29458,"_20209":50519,"_26493":50520,"_2816":47407},[],"/docs/platform/iot-fleets/enrollment/est-client#before-you-begin",{"_3328":1003,"_29138":1000,"_5":29458,"_20209":50522,"_26493":50523,"_2816":50524},[],"/docs/platform/iot-fleets/enrollment/est-client#download-and-inspect-cacerts","Download and inspect cacerts",{"_3328":1004,"_29138":1000,"_5":29458,"_20209":50526,"_26493":50527,"_2816":50528},[],"/docs/platform/iot-fleets/enrollment/est-client#prepare-the-csr","Prepare the CSR",{"_3328":1005,"_29138":1000,"_5":29458,"_20209":50530,"_26493":50531,"_2816":50532},[],"/docs/platform/iot-fleets/enrollment/est-client#request-the-identity","Request the identity",{"_3328":1006,"_29138":1000,"_5":29458,"_20209":50534,"_26493":50535,"_2816":50536},[],"/docs/platform/iot-fleets/enrollment/est-client#check-and-install-the-result","Check and install the result",{"_3328":1007,"_29138":1000,"_5":29458,"_20209":50538,"_26493":50539,"_2816":50540},[],"/docs/platform/iot-fleets/enrollment/est-client#next-steps","Next steps",{"_3328":1008,"_29138":1000,"_20209":50542,"_5":13819,"_26493":1000,"_2816":50543},[],"This guide is for those implementing the device client. The administrator must have prepared the DMS policy. For a complete first run, follow Enroll and connect your first device.",{"_3328":1009,"_29138":1000,"_20209":50545,"_5":13819,"_26493":50520,"_2816":50546},[],"You need the public HTTPS DMS URL, server trust obtained through an approved channel, the operation's authentication mode and an admitted identifier. The examples use Bash, OpenSSL 3.x and curl with `--fail-with-body`; use a private working directory and compatible versions of these tools.",{"_3328":1010,"_29138":1000,"_20209":50548,"_5":13819,"_26493":50520,"_2816":50549},[],"Prepare `est-trust.pem` to verify the EST server, `bootstrap.crt` and `bootstrap.key` for initial certificate authentication, and `device-root.pem` as the approved root of the device issuer. The two trust files can contain different roots. For another authentication mode, adapt the credentials according to Bootstrap identity.",{"_3328":1011,"_29138":1000,"_20209":50551,"_5":13819,"_26493":50520,"_2816":50552},[],"Replace the host and `REPLACE_DMS_ID` with those of your installation. The URL's APS is the DMS identifier, not its display name.",{"_3328":1012,"_29138":1000,"_20209":50554,"_5":13819,"_26493":50523,"_2816":50555},[],"The default content is Base64-encoded DER PKCS#7. It is not a direct PEM file.",{"_3328":1013,"_29138":1000,"_20209":50557,"_5":13819,"_26493":50523,"_2816":50558},[],"Check fingerprints, issuers and dates against the trust distribution policy. The response can contain a selection of CAs and Lamassu's TLS certificate. Do not turn the entire bundle into trusted roots or use it to authenticate its own initial download. HTTP 200 here does not prove that authentication or issuance works.",{"_3328":1014,"_29138":1000,"_20209":50560,"_5":13819,"_26493":50527,"_2816":50561},[],"The example generates a new EC P-256 key and uses `est-device-001`, which must be available if the DMS registers automatically. The `Common Name` becomes the device identifier. Check that the profile permits the selected key and subject.",{"_3328":1015,"_29138":1000,"_20209":50563,"_5":13819,"_26493":50527,"_2816":50564},[],"An implementation using hardware or its own store must produce the CSR through its resident key. `simpleenroll` sends the request and retains the key in the client. Honor Extensions does not authorize every requested attribute: see Profiles.",{"_3328":1016,"_29138":1000,"_20209":50566,"_5":13819,"_26493":50531,"_2816":50567},[],"With initial `CLIENT_CERTIFICATE` authentication, send the Base64-encoded DER CSR using `Content-Type: application/pkcs10`:",{"_3328":1017,"_29138":1000,"_20209":50569,"_5":13819,"_26493":50531,"_2816":50570},[],"Stop if curl fails. Retain the HTTP code, headers and body for diagnosis; an error response is not decoded as a certificate. The Bash example stops before that conversion. A timeout leaves the operation's result to be checked in Lamassu: do not automatically repeat issuance.",{"_3328":1018,"_29138":1000,"_20209":50572,"_5":13819,"_26493":50535,"_2816":50573},[],"For a root that issues directly:",{"_3328":1019,"_29138":1000,"_20209":50575,"_5":13819,"_26493":50535,"_2816":50576},[],"Also verify that the CN is correct, the certificate is a leaf, its uses permit your application and its dates satisfy the profile. `cmp` must exit with code 0. With intermediates, provide the chain through `-untrusted` as described in PKI validation.",{"_3328":1020,"_29138":1000,"_20209":50578,"_5":13819,"_26493":50535,"_2816":50579},[],"Query the device: the owning DMS, current serial number and history must match the result. Protect the key/certificate pair and install both using the device's mechanism. Association in Lamassu does not install files in the client. Check a real connection before considering the process complete.",{"_3328":1021,"_29138":1000,"_20209":50581,"_5":13819,"_26493":50539,"_2816":50582},[],"Implement renewal and recovery and trust updates. The EST reference covers endpoints, formats and ServerKeyGen; troubleshooting helps distinguish transport, admission and persistence failures.",{"_3328":1022,"_29138":1022,"_5":14177,"_2816":50584,"_29461":50585,"_20209":50586,"_26493":1022},"EST reference",[47397,48865,49873,49871,50054],[],{"_3328":1023,"_29138":1022,"_20209":50588,"_5":13819,"_26493":1022,"_2816":50589},[],"Look up Lamassu routes, formats, authentication and multipart responses.",{"_3328":1024,"_29138":1022,"_5":29458,"_20209":50591,"_26493":50592,"_2816":50593},[],"/docs/platform/iot-fleets/enrollment/est-reference#endpoint-reference","Endpoint reference",{"_3328":1025,"_29138":1022,"_5":29458,"_20209":50595,"_26493":50596,"_2816":21954},[],"/docs/platform/iot-fleets/enrollment/est-reference#cacerts",{"_3328":1026,"_29138":1022,"_5":29458,"_20209":50598,"_26493":50599,"_2816":25139},[],"/docs/platform/iot-fleets/enrollment/est-reference#simpleenroll",{"_3328":1027,"_29138":1022,"_5":29458,"_20209":50601,"_26493":50602,"_2816":25146},[],"/docs/platform/iot-fleets/enrollment/est-reference#simplereenroll",{"_3328":1028,"_29138":1022,"_5":29458,"_20209":50604,"_26493":50605,"_2816":24479},[],"/docs/platform/iot-fleets/enrollment/est-reference#serverkeygen",{"_3328":1029,"_29138":1022,"_5":29458,"_20209":50607,"_26493":50608,"_2816":50609},[],"/docs/platform/iot-fleets/enrollment/est-reference#response-format","Response format",{"_3328":1030,"_29138":1022,"_5":29458,"_20209":50611,"_26493":50612,"_2816":50613},[],"/docs/platform/iot-fleets/enrollment/est-reference#request-and-extraction","Request and extraction",{"_3328":1031,"_29138":1022,"_5":29458,"_20209":50615,"_26493":50616,"_2816":50617},[],"/docs/platform/iot-fleets/enrollment/est-reference#compatibility-notes","Compatibility notes",{"_3328":1032,"_29138":1022,"_20209":50619,"_5":13819,"_26493":1022,"_2816":50620},[],"Reference for the examined backend, based on RFC 7030. Use EST client for the procedure and DMS to configure policy.",{"_3328":1033,"_29138":1022,"_20209":50622,"_5":13819,"_26493":50592,"_2816":50623},[],"Public route in the examples: `/.well-known/est/{APS}/{operation}`. `APS` is the DMS ID. The router admits routes without that segment, but the controller requires it; do not use them as a default service. Gateway configuration determines the public host and route.",{"_3328":1034,"_29138":1022,"_20209":50625,"_5":13819,"_26493":50592,"_2816":50626},[],"Operation",{"_3328":1035,"_29138":1022,"_20209":50628,"_5":13819,"_26493":50592,"_2816":50629},[],"Method",{"_3328":1036,"_29138":1022,"_20209":50631,"_5":13819,"_26493":50592,"_2816":50632},[],"Authentication and condition",{"_3328":1037,"_29138":1022,"_20209":50634,"_5":13819,"_26493":50592,"_2816":50635},[],"`/cacerts`",{"_3328":1038,"_29138":1022,"_20209":50637,"_5":13819,"_26493":50592,"_2816":50638},[],"GET",{"_3328":1039,"_29138":1022,"_20209":50640,"_5":13819,"_26493":50592,"_2816":50641},[],"DMS reading does not require an EST credential; HTTPS and infrastructure controls still apply.",{"_3328":1040,"_29138":1022,"_20209":50643,"_5":13819,"_26493":50592,"_2816":50644},[],"`/simpleenroll`",{"_3328":1041,"_29138":1022,"_20209":50646,"_5":13819,"_26493":50592,"_2816":50647},[],"POST",{"_3328":1042,"_29138":1022,"_20209":50649,"_5":13819,"_26493":50592,"_2816":50650},[],"Initial authentication and DMS registration/replacement policy.",{"_3328":1043,"_29138":1022,"_20209":50652,"_5":13819,"_26493":50592,"_2816":50653},[],"`/simplereenroll`",{"_3328":1044,"_29138":1022,"_20209":50655,"_5":13819,"_26493":50592,"_2816":50647},[],{"_3328":1045,"_29138":1022,"_20209":50657,"_5":13819,"_26493":50592,"_2816":50658},[],"Renewal authentication, existing identity, subject, revocation and window.",{"_3328":1046,"_29138":1022,"_20209":50660,"_5":13819,"_26493":50592,"_2816":50661},[],"`/serverkeygen`",{"_3328":1047,"_29138":1022,"_20209":50663,"_5":13819,"_26493":50592,"_2816":50647},[],{"_3328":1048,"_29138":1022,"_20209":50665,"_5":13819,"_26493":50592,"_2816":50666},[],"Initial authentication and admission; server generation enabled.",{"_3328":1049,"_29138":1022,"_20209":50668,"_5":13819,"_26493":50592,"_2816":50669},[],"These routes do not implement `/csrattrs` or `/fullcmc`. There is no native JWT EST authentication mode; a webhook can interpret a request credential according to its own contract.",{"_3328":1050,"_29138":1022,"_20209":50671,"_5":13819,"_26493":50596,"_2816":50672},[],"The default response has `Content-Type: application/pkcs7-mime; smime-type=certs-only` and `Content-Transfer-Encoding: base64`. The body is Base64-encoded DER PKCS#7 with lines of up to 76 characters. It includes the certificates selected by the DMS, not necessarily every ancestor.",{"_3328":1051,"_29138":1022,"_20209":50674,"_5":13819,"_26493":50596,"_2816":50675},[],"`Accept: application/x-pem-file` requests the bundle in PEM through a Lamassu extension. Inspect and approve its contents before modifying trusted roots.",{"_3328":1052,"_29138":1022,"_20209":50677,"_5":13819,"_26493":50599,"_2816":50678},[],"Send a Base64-encoded DER PKCS#10 CSR with `Content-Type: application/pkcs10`. The examined controller compares that media type literally; avoid adding parameters such as charset. The CN identifies the device and the CSR signature must be verified through DMS policy.",{"_3328":1053,"_29138":1022,"_20209":50680,"_5":13819,"_26493":50599,"_2816":50681},[],"The default response uses the PKCS#7/Base64 format described for cacerts, but contains the issued certificate; do not assume it includes its entire chain. `Accept: application/x-pem-file` returns that certificate in PEM. The client retains the key that signed the CSR.",{"_3328":1054,"_29138":1022,"_20209":50683,"_5":13819,"_26493":50602,"_2816":50684},[],"Use the same request and certificate response formats. Authentication comes from the independent `reenrollment_settings.est_rfc7030_settings` block. With a client certificate, its CN must match the CSR CN; the subject is also checked against the current certificate.",{"_3328":1055,"_29138":1022,"_20209":50686,"_5":13819,"_26493":50602,"_2816":50687},[],"In mTLS mode, the enrollment CA always validates the re-enrollment credential; certificates from other issuers are accepted only if they are listed as validation CAs in the re-enrollment block. The expiry check through `enable_expired_renewal` belongs to that validator. A revoked current certificate and a request before the window are rejected. See Renewal for installation and recovery.",{"_3328":1056,"_29138":1022,"_20209":50689,"_5":13819,"_26493":50605,"_2816":50690},[],"The server generates a software key, rebuilds the CSR with that key and performs initial enrollment. The flag must be enabled and the algorithm permitted by the profile. This operation's key does not become a hardware key because the CA is hosted in an HSM.",{"_3328":1057,"_29138":1022,"_20209":50692,"_5":13819,"_26493":50605,"_2816":50693},[],"The code supports RSA and ECDSA, and the `bits` value of the DMS key setting means something different for each. For ECDSA it selects the curve: 224, 256, 384 or 521 map to P-224, P-256, P-384 and P-521, and an unrecognized size falls back to P-256, so explicitly select a compatible size and check the resulting key. For RSA it is used directly as the modulus size; the console offers 2048, 3072 and 4096 bits. Do not reuse an enrolled ID to test this operation without reviewing replacement.",{"_3328":1058,"_29138":1022,"_20209":50695,"_5":13819,"_26493":50608,"_2816":50696},[],"The body is **MIME multipart/mixed**, with the boundary specified in `Content-Type`. It contains two parts:",{"_3328":1059,"_29138":1022,"_20209":50698,"_5":13819,"_26493":50608,"_2816":50699},[],"Part",{"_3328":1060,"_29138":1022,"_20209":50701,"_5":13819,"_26493":50608,"_2816":50702},[],"Content after decoding its Base64",{"_3328":1061,"_29138":1022,"_20209":50704,"_5":13819,"_26493":50608,"_2816":50705},[],"`application/pkcs8`",{"_3328":1062,"_29138":1022,"_20209":50707,"_5":13819,"_26493":50608,"_2816":50708},[],"Unencrypted DER PKCS#8 private key.",{"_3328":1063,"_29138":1022,"_20209":50710,"_5":13819,"_26493":50608,"_2816":50711},[],"`application/pkcs7-mime; smime-type=certs-only`",{"_3328":1064,"_29138":1022,"_20209":50713,"_5":13819,"_26493":50608,"_2816":50714},[],"DER PKCS#7 containing the issued certificate.",{"_3328":1065,"_29138":1022,"_20209":50716,"_5":13819,"_26493":50608,"_2816":50717},[],"The controller also adds `Content-Transfer-Encoding: base64` to the outer header, although the outer body is MIME text. &#x2A;*Do not Base64-decode the entire body.** Read the actual boundary and decode each part according to its headers.",{"_3328":1066,"_29138":1022,"_20209":50719,"_5":13819,"_26493":50612,"_2816":50720},[],"In a Bash session with `set -euo pipefail` and `umask 077`, use `EST_BASE` and the trust/bootstrap files from EST client. Select an available and admitted `est-serverkeygen-001`. The `server-request.key` only signs the input CSR; the received identity uses the server-generated key.",{"_3328":1067,"_29138":1022,"_20209":50722,"_5":13819,"_26493":50612,"_2816":50723},[],"Save this Python 3 extractor. It validates both parts before writing and rejects existing output files:",{"_3328":1068,"_29138":1022,"_20209":50725,"_5":13819,"_26493":50612,"_2816":50726},[],"Convert and check the result:",{"_3328":1069,"_29138":1022,"_20209":50728,"_5":13819,"_26493":50612,"_2816":50729},[],"Inspect the CN, serial, dates and uses; check association in Lamassu before installing. Protect the DER and PEM files containing the key and remove temporary copies according to the device's storage mechanism. See openssl-pkcs8 and the Python MIME parser.",{"_3328":1070,"_29138":1022,"_20209":50731,"_5":13819,"_26493":50616,"_2816":50732},[],"Do not interpret every 500 as a transient failure. Invalid input typically produces 400; service denials and errors typically produce 500 with a JSON `err` body. Gateway errors and some controller paths can have another format. Retain headers and body before decoding and see troubleshooting.",{"_3328":1071,"_29138":1022,"_20209":50734,"_5":13819,"_26493":50616,"_2816":50735},[],"The examples use openssl-pkcs7 to extract certificates and openssl-x509 to prepare renewal. Check your version's capabilities and responses before integrating a generic EST client.",{"_3328":1072,"_29138":1072,"_5":14177,"_2816":50054,"_29461":50737,"_20209":50738,"_26493":1072},[47397,48865,49873,49871,50054],[],{"_3328":1073,"_29138":1072,"_20209":50740,"_5":13819,"_26493":1072,"_2816":50741},[],"Choose admission policy and connect DMS, initial trust and the EST client.",{"_3328":1074,"_29138":1072,"_5":29458,"_20209":50743,"_26493":50744,"_2816":50745},[],"/docs/platform/iot-fleets/enrollment/overview#the-journey","The journey",{"_3328":1075,"_29138":1072,"_5":29458,"_20209":50747,"_26493":50748,"_2816":50749},[],"/docs/platform/iot-fleets/enrollment/overview#for-the-administrator","For the administrator",{"_3328":1076,"_29138":1072,"_5":29458,"_20209":50751,"_26493":50752,"_2816":50753},[],"/docs/platform/iot-fleets/enrollment/overview#for-the-integrator","For the integrator",{"_3328":1077,"_29138":1072,"_5":29458,"_20209":50755,"_26493":50756,"_2816":50757},[],"/docs/platform/iot-fleets/enrollment/overview#contract-version","Contract version",{"_3328":1078,"_29138":1072,"_20209":50759,"_5":13819,"_26493":1072,"_2816":50760},[],"Enrollment with PKI covers the path from device admission to identity installation and renewal. The DMS acts as a registration authority: it authenticates the request, applies registration policy and asks the CA to sign. The client keeps or receives the key, installs the result and presents it to the consumer.",{"_3328":1079,"_29138":1072,"_20209":50762,"_5":13819,"_26493":50744,"_2816":50763},[],"The administrator prepares the CA, issuance profile and DMS.",{"_3328":1080,"_29138":1072,"_20209":50765,"_5":13819,"_26493":50744,"_2816":50766},[],"The integrator installs initial EST server trust and an admission credential.",{"_3328":1081,"_29138":1072,"_20209":50768,"_5":13819,"_26493":50744,"_2816":50769},[],"The client requests an identity for its `Device ID` through EST.",{"_3328":1082,"_29138":1072,"_20209":50771,"_5":13819,"_26493":50744,"_2816":50772},[],"Certificate, device binding and key/certificate installation are checked.",{"_3328":1083,"_29138":1072,"_20209":50774,"_5":13819,"_26493":50744,"_2816":50775},[],"The consumer validates and authorizes the identity; the client schedules renewal and recovery.",{"_3328":1084,"_29138":1072,"_20209":50777,"_5":13819,"_26493":50744,"_2816":50778},[],"EST uses `/.well-known/est/{DMS_ID}`. Administrative APIs and manual assignment remain separate paths. Enroll and connect a device completes an initial mTLS test.",{"_3328":1085,"_29138":1072,"_20209":50780,"_5":13819,"_26493":50748,"_2816":50781},[],"<Card title=\"Provisioning strategies\" description=\"Choose automatic registration, preregistration or manual assignment.\" href=\"/docs/platform/iot-fleets/enrollment/provisioning-strategies\" />",{"_3328":1086,"_29138":1072,"_20209":50783,"_5":13819,"_26493":50748,"_2816":50784},[],"<Card title=\"Configure the DMS\" description=\"Separate admission, authentication per operation, profiles and distribution.\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_3328":1087,"_29138":1072,"_20209":50786,"_5":13819,"_26493":50748,"_2816":50787},[],"<Card title=\"Bootstrap identity and authentication\" description=\"Decide which proof allows requesting the first identity.\" href=\"/docs/platform/iot-fleets/enrollment/bootstrap-identity\" />",{"_3328":1088,"_29138":1072,"_20209":50789,"_5":13819,"_26493":50748,"_2816":50790},[],"<Card title=\"Trust distribution\" description=\"Update roots and chains with verified overlap.\" href=\"/docs/platform/iot-fleets/enrollment/trust-distribution\" />",{"_3328":1089,"_29138":1072,"_20209":50792,"_5":13819,"_26493":50752,"_2816":50793},[],"<Card title=\"EST client\" description=\"Prepare the request, verify the response and install the identity.\" href=\"/docs/platform/iot-fleets/enrollment/est-client\" />",{"_3328":1090,"_29138":1072,"_20209":50795,"_5":13819,"_26493":50752,"_2816":50796},[],"<Card title=\"Renewal and recovery\" description=\"Generate the successor and handle expired or lost credentials.\" href=\"/docs/platform/iot-fleets/enrollment/renewal-and-recovery\" />",{"_3328":1091,"_29138":1072,"_20209":50798,"_5":13819,"_26493":50752,"_2816":50799},[],"<Card title=\"EST reference\" description=\"Look up paths, formats, authentication and ServerKeyGen.\" href=\"/docs/platform/iot-fleets/enrollment/est-reference\" />",{"_3328":1092,"_29138":1072,"_20209":50801,"_5":13819,"_26493":50752,"_2816":50802},[],"<Card title=\"Troubleshooting\" description=\"Distinguish transport, policy, issuance and installation failures.\" href=\"/docs/platform/iot-fleets/enrollment/troubleshooting\" />",{"_3328":1093,"_29138":1072,"_20209":50804,"_5":13819,"_26493":50756,"_2816":50805},[],"This block describes `main` code inspected at commit `8f42c47157f9a36bac3ed5caa3692aebebe19c4b`. The site catalog publishes `main (unstable)`; this behavior is not attributed to a stable release. Before using another version, check its contract, particularly independent re-enrollment authentication. Client checks and live-instance tests are distinguished in the revision plan.",{"_3328":1094,"_29138":1072,"_20209":50807,"_5":13819,"_26493":50756,"_2816":50808},[],"Gateway, TLS, provider and service configuration belongs to Deployment. Identity use in AWS or other destinations belongs to Integrations.",{"_3328":1095,"_29138":1095,"_5":14177,"_2816":50810,"_29461":50811,"_20209":50812,"_26493":1095},"Provisioning strategies",[47397,48865,49873,49871,50054],[],{"_3328":1096,"_29138":1095,"_20209":50814,"_5":13819,"_26493":1095,"_2816":50815},[],"Choose device registration, identity authorization and key generation.",{"_3328":1097,"_29138":1095,"_5":29458,"_20209":50817,"_26493":50818,"_2816":50819},[],"/docs/platform/iot-fleets/enrollment/provisioning-strategies#choose-registration","Choose registration",{"_3328":1098,"_29138":1095,"_5":29458,"_20209":50821,"_26493":50822,"_2816":50823},[],"/docs/platform/iot-fleets/enrollment/provisioning-strategies#preregistration-and-replacement","Preregistration and replacement",{"_3328":1099,"_29138":1095,"_5":29458,"_20209":50825,"_26493":50826,"_2816":50827},[],"/docs/platform/iot-fleets/enrollment/provisioning-strategies#choose-authentication","Choose authentication",{"_3328":1100,"_29138":1095,"_5":29458,"_20209":50829,"_26493":50830,"_2816":50831},[],"/docs/platform/iot-fleets/enrollment/provisioning-strategies#choose-custody","Choose custody",{"_3328":1101,"_29138":1095,"_5":29458,"_20209":50833,"_26493":50834,"_2816":50835},[],"/docs/platform/iot-fleets/enrollment/provisioning-strategies#check-the-decision","Check the decision",{"_3328":1102,"_29138":1095,"_20209":50837,"_5":13819,"_26493":1095,"_2816":50838},[],"This guide helps the provisioning administrator choose a path before configuring the DMS. Separate three decisions: when the device exists, how its request is authorized and who generates its key. None grants destination access by itself.",{"_3328":1103,"_29138":1095,"_20209":50840,"_5":13819,"_26493":50818,"_2816":50841},[],"Path",{"_3328":1104,"_29138":1095,"_20209":50843,"_5":13819,"_26493":50818,"_2816":50844},[],"When the device exists",{"_3328":1105,"_29138":1095,"_20209":50846,"_5":13819,"_26493":50818,"_2816":50847},[],"What to check",{"_3328":1106,"_29138":1095,"_20209":50849,"_5":13819,"_26493":50818,"_2816":50850},[],"Manual assignment",{"_3328":1107,"_29138":1095,"_20209":50852,"_5":13819,"_26493":50818,"_2816":50853},[],"An operator creates it before associating a certificate.",{"_3328":1108,"_29138":1095,"_20209":50855,"_5":13819,"_26493":50818,"_2816":50856},[],"ID, owning DMS, certificate CN and bound serial.",{"_3328":1109,"_29138":1095,"_20209":50858,"_5":13819,"_26493":50818,"_2816":50859},[],"EST with `JITP`",{"_3328":1110,"_29138":1095,"_20209":50861,"_5":13819,"_26493":50818,"_2816":50862},[],"Created for an unknown CN during `/simpleenroll`.",{"_3328":1111,"_29138":1095,"_20209":50864,"_5":13819,"_26493":50818,"_2816":50865},[],"Authorized credential, unused ID, profile, resulting registration and identity.",{"_3328":1112,"_29138":1095,"_20209":50867,"_5":13819,"_26493":50818,"_2816":50868},[],"EST with `PRE_REGISTRATION`",{"_3328":1113,"_29138":1095,"_20209":50870,"_5":13819,"_26493":50818,"_2816":50871},[],"Must exist before `/simpleenroll`.",{"_3328":1114,"_29138":1095,"_20209":50873,"_5":13819,"_26493":50818,"_2816":50874},[],"Approved record, same DMS and replacement conditions for your version.",{"_3328":1115,"_29138":1095,"_20209":50876,"_5":13819,"_26493":50818,"_2816":50877},[],"Lamassu `JITP` creates inventory and identity in Lamassu. AWS JITP provisions a destination in AWS; these are separate decisions.",{"_3328":1116,"_29138":1095,"_20209":50879,"_5":13819,"_26493":50818,"_2816":50880},[],"For an initial client test, use Enroll and connect a device. To prepare inventory without EST, follow Manual registration.",{"_3328":1117,"_29138":1095,"_20209":50882,"_5":13819,"_26493":50822,"_2816":50883},[],"In the inspected code, finding any device owned by the same DMS triggers the `enable_replaceable_enrollment` check before PRE\\_REGISTRATION. With the flag disabled, a preregistered device can receive `forbiddenNewEnrollment` even in **No Identity**. Selecting PRE\\_REGISTRATION alone therefore does not establish a working path.",{"_3328":1118,"_29138":1095,"_20209":50885,"_5":13819,"_26493":50822,"_2816":50886},[],"Enabling the flag permits repeated `/simpleenroll` for an existing ID. The backend schedules a deferred attempt to revoke the previous certificate with `Superseded`; it can also run if later issuance or binding fails. Without an identity, that attempt can fail because no serial exists. The flag does not provide a replacement transaction or guarantee restoration of previous state.",{"_3328":1119,"_29138":1095,"_20209":50888,"_5":13819,"_26493":50822,"_2816":50889},[],"Test the exact case on your version before enabling it for a population. For an operational identity with authorized renewal, use `/simplereenroll`; for recovery, follow Renewal and recovery and check persisted state before retrying.",{"_3328":1120,"_29138":1095,"_20209":50891,"_5":13819,"_26493":50826,"_2816":50892},[],"Decide initial enrollment and re-enrollment separately:",{"_3328":1121,"_29138":1095,"_20209":50894,"_5":13819,"_26493":50826,"_2816":50895},[],"**Client certificate:** useful when each device has an initial credential whose key it controls.",{"_3328":1122,"_29138":1095,"_20209":50897,"_5":13819,"_26493":50826,"_2816":50898},[],"**Webhook:** useful when another authority knows inventory, credentials or entitlement to a requested ID.",{"_3328":1123,"_29138":1095,"_20209":50900,"_5":13819,"_26493":50826,"_2816":50901},[],"**Certificate and webhook:** requires both controls in the configured operation.",{"_3328":1124,"_29138":1095,"_20209":50903,"_5":13819,"_26493":50826,"_2816":50904},[],"**NO\\_AUTH:** does not establish requester identity; appropriate only when admission is deliberately controlled outside that DMS.",{"_3328":1125,"_29138":1095,"_20209":50906,"_5":13819,"_26493":50826,"_2816":50907},[],"Authenticating an initial certificate does not itself establish entitlement to choose any CSR CN. Define that authorization in Bootstrap identity and authentication.",{"_3328":1126,"_29138":1095,"_20209":50909,"_5":13819,"_26493":50830,"_2816":47781},[],{"_3328":1127,"_29138":1095,"_20209":50911,"_5":13819,"_26493":50830,"_2816":50912},[],"Material crossing EST",{"_3328":1128,"_29138":1095,"_20209":50914,"_5":13819,"_26493":50830,"_2816":50915},[],"Device-generated key",{"_3328":1129,"_29138":1095,"_20209":50917,"_5":13819,"_26493":50830,"_2816":50918},[],"Public CSR and certificate; the key stays on the client.",{"_3328":1130,"_29138":1095,"_20209":50920,"_5":13819,"_26493":50830,"_2816":50921},[],"Existing device key",{"_3328":1131,"_29138":1095,"_20209":50923,"_5":13819,"_26493":50830,"_2816":50924},[],"CSR signed with that key and a new certificate.",{"_3328":1132,"_29138":1095,"_20209":50926,"_5":13819,"_26493":50830,"_2816":50192},[],{"_3328":1133,"_29138":1095,"_20209":50928,"_5":13819,"_26493":50830,"_2816":50929},[],"Private PKCS#8 key and certificate in a TLS-protected multipart response.",{"_3328":1134,"_29138":1095,"_20209":50931,"_5":13819,"_26493":50830,"_2816":50932},[],"ServerKeyGen does not automatically use the CA’s HSM or KMS for the device key. Review its contract and extraction and the device’s ability to install the material.",{"_3328":1135,"_29138":1095,"_20209":50934,"_5":13819,"_26493":50834,"_2816":50935},[],"Before expanding the flow, test allowed registration, incorrect credentials, an ID owned by another DMS, repeated requests and recovery after failure. Keep ID, serial, active version and error. Also test consumer acceptance and rejection; issuance does not imply destination registration or permission to operate.",{"_3328":1136,"_29138":1136,"_5":14177,"_2816":50937,"_29461":50938,"_20209":50939,"_26493":1136},"Renewal and recovery",[47397,48865,49873,49871,50054],[],{"_3328":1137,"_29138":1136,"_20209":50941,"_5":13819,"_26493":1136,"_2816":50942},[],"Renew without losing the identity and recover devices according to their actual state.",{"_3328":1138,"_29138":1136,"_5":29458,"_20209":50944,"_26493":50945,"_2816":50946},[],"/docs/platform/iot-fleets/enrollment/renewal-and-recovery#prepare-renewal","Prepare renewal",{"_3328":1139,"_29138":1136,"_5":29458,"_20209":50948,"_26493":50949,"_2816":50950},[],"/docs/platform/iot-fleets/enrollment/renewal-and-recovery#request-the-successor-certificate","Request the successor certificate",{"_3328":1140,"_29138":1136,"_5":29458,"_20209":50952,"_26493":50953,"_2816":50954},[],"/docs/platform/iot-fleets/enrollment/renewal-and-recovery#install-and-check-the-new-pair","Install and check the new pair",{"_3328":1141,"_29138":1136,"_5":29458,"_20209":50956,"_26493":50957,"_2816":50958},[],"/docs/platform/iot-fleets/enrollment/renewal-and-recovery#recover-according-to-state","Recover according to state",{"_3328":1142,"_29138":1136,"_5":29458,"_20209":50960,"_26493":50961,"_2816":50962},[],"/docs/platform/iot-fleets/enrollment/renewal-and-recovery#continuous-operation","Continuous operation",{"_3328":1143,"_29138":1136,"_20209":50964,"_5":13819,"_26493":1136,"_2816":50965},[],"Renewal retains the device identifier and requests a successor certificate. The client must complete the process: check the response, install the matching pair and demonstrate that the consumer accepts it. Lamassu alerts notify you; they do not perform those steps.",{"_3328":1144,"_29138":1136,"_20209":50967,"_5":13819,"_26493":50945,"_2816":50968},[],"Query the current certificate in Lamassu and compare it with the installed certificate. You need its subject, serial and dates, as well as the client key.",{"_3328":1145,"_29138":1136,"_20209":50970,"_5":13819,"_26493":50945,"_2816":50971},[],"Check the **re-enrollment** authentication mode: it is independent of initial authentication. With `CLIENT_CERTIFICATE`, use the current identity; do not assume the bootstrap credential is admitted.",{"_3328":1146,"_29138":1136,"_20209":50973,"_5":13819,"_26493":50945,"_2816":50974},[],"Calculate the window's start: the current certificate's `NotAfter` minus `reenrollment_delta`. Preventive and critical thresholds produce states/notifications; they do not extend that window.",{"_3328":1147,"_29138":1136,"_20209":50976,"_5":13819,"_26493":50945,"_2816":50977},[],"Review **Revoke on Re-enrollment** and recovery if installation fails. When enabled, Lamassu can revoke the previous identity before the client installs the new one.",{"_3328":1148,"_29138":1136,"_20209":50979,"_5":13819,"_26493":50949,"_2816":50980},[],"The example continues the EST tutorial, in the same Bash session with `set -euo pipefail`, `umask 077` and `EST_BASE`. Use a new key compatible with the profile. Conversion from the certificate preserves the subject and copies only SAN when present; check the subject and requested names before sending it. The backend checks the subject against the current identity: it attempts RawSubject equality and then compares CN, OU, O, L, ST and C. Rebuilding only the CN can lose required attributes.",{"_3328":1149,"_29138":1136,"_20209":50982,"_5":13819,"_26493":50949,"_2816":50983},[],"The request authenticates with `device.crt` and `device.key`; the CSR contains the new public key. Also check extensions, dates and correspondence of the serial with the current slot in Lamassu. Do not resubmit a failed request without querying that state: issuance, previous revocation and successor binding can have partial results.",{"_3328":1150,"_29138":1136,"_20209":50985,"_5":13819,"_26493":50953,"_2816":50986},[],"Keep the result as `device.next.crt` and `device.next.key` until verified. Switch the pair through a coordinated operation in the device store or configuration; avoid temporarily exposing a certificate with another version's key.",{"_3328":1151,"_29138":1136,"_20209":50988,"_5":13819,"_26493":50953,"_2816":50989},[],"Test mTLS with the consumer and verify that it uses the new serial. Confirm the history and current certificate in Lamassu. If **Revoke on Re-enrollment** was disabled, the previous identity can remain valid: retire it according to PKI policy after testing the successor, and check revocation publication and consumption.",{"_3328":1152,"_29138":1136,"_20209":50991,"_5":13819,"_26493":50953,"_2816":50992},[],"If the previous identity is already revoked, retaining its files does not restore a valid connection. Recovery requires an admitted credential and authorized intervention according to the situation.",{"_3328":1153,"_29138":1136,"_20209":50994,"_5":13819,"_26493":50957,"_2816":50995},[],"Situation",{"_3328":1154,"_29138":1136,"_20209":50997,"_5":13819,"_26493":50957,"_2816":50998},[],"Procedure",{"_3328":1155,"_29138":1136,"_20209":51000,"_5":13819,"_26493":50957,"_2816":51001},[],"Valid certificate, outside the window",{"_3328":1156,"_29138":1136,"_20209":51003,"_5":13819,"_26493":50957,"_2816":51004},[],"Schedule the request within the window. Do not use `simpleenroll` to bypass it.",{"_3328":1157,"_29138":1136,"_20209":51006,"_5":13819,"_26493":50957,"_2816":51007},[],"Expired certificate, key available",{"_3328":1158,"_29138":1136,"_20209":51009,"_5":13819,"_26493":50957,"_2816":51010},[],"With certificate authentication, review `enable_expired_renewal` and whether Gateway permits presenting that credential. Revocation, subject and the remaining checks still apply.",{"_3328":1159,"_29138":1136,"_20209":51012,"_5":13819,"_26493":50957,"_2816":51013},[],"Renewal through webhook or `NO_AUTH`",{"_3328":1160,"_29138":1136,"_20209":51015,"_5":13819,"_26493":50957,"_2816":51016},[],"The mTLS expiry check does not run in these modes. Define expiry and authorization policy in the corresponding admission process; the flag is not a universal prohibition.",{"_3328":1161,"_29138":1136,"_20209":51018,"_5":13819,"_26493":50957,"_2816":51019},[],"Lost or inaccessible key",{"_3328":1162,"_29138":1136,"_20209":51021,"_5":13819,"_26493":50957,"_2816":51022},[],"You cannot prove possession of the previous identity. Authorize new admission and, if appropriate, controlled replacement; revoke the compromised identity.",{"_3328":1163,"_29138":1136,"_20209":51024,"_5":13819,"_26493":50957,"_2816":51025},[],"Current identity revoked",{"_3328":1164,"_29138":1136,"_20209":51027,"_5":13819,"_26493":50957,"_2816":51028},[],"`simplereenroll` rejects the revoked current certificate. Investigate the reason and prepare an authorized readmission procedure; do not disable authentication to force it.",{"_3328":1165,"_29138":1136,"_20209":51030,"_5":13819,"_26493":50957,"_2816":51031},[],"Device without an identity",{"_3328":1166,"_29138":1136,"_20209":51033,"_5":13819,"_26493":50957,"_2816":51034},[],"Use initial enrollment. For an existing entry, check the replacement restriction in provisioning.",{"_3328":1167,"_29138":1136,"_20209":51036,"_5":13819,"_26493":50957,"_2816":51037},[],"Retired device",{"_3328":1168,"_29138":1136,"_20209":51039,"_5":13819,"_26493":50957,"_2816":51040},[],"Review the operational decision before readmission. Decommissioned state and revocation of the entire history are not equivalent.",{"_3328":1169,"_29138":1136,"_20209":51042,"_5":13819,"_26493":50957,"_2816":51043},[],"Timeout, HTTP 500 or installation failure",{"_3328":1170,"_29138":1136,"_20209":51045,"_5":13819,"_26493":50957,"_2816":51046},[],"Inspect the device, issued certificates and history before retrying. A successor may have been issued or the previous identity revoked.",{"_3328":1171,"_29138":1136,"_20209":51048,"_5":13819,"_26493":50961,"_2816":51049},[],"Schedule renewal with time for disconnections, trust distribution and consumer checks. Stagger requests across the population and bound retries within the window; authentication, subject and policy errors require correcting their cause. Maintain an admitted and tested recovery mechanism for lost keys and pairs that could not be installed.",{"_3328":1172,"_29138":1136,"_20209":51051,"_5":13819,"_26493":50961,"_2816":51052},[],"Continue with Trust distribution, Devices and identities and Troubleshooting.",{"_3328":1173,"_29138":1173,"_5":14177,"_2816":51054,"_29461":51055,"_20209":51056,"_26493":1173},"Enrollment troubleshooting",[47397,48865,49873,49871,50054],[],{"_3328":1174,"_29138":1173,"_20209":51058,"_5":13819,"_26493":1173,"_2816":51059},[],"Locate transport, authentication, registration, issuance and installation failures.",{"_3328":1175,"_29138":1173,"_5":29458,"_20209":51061,"_26493":51062,"_2816":51063},[],"/docs/platform/iot-fleets/enrollment/troubleshooting#diagnostics-and-compatibility","Diagnostics and compatibility",{"_3328":1176,"_29138":1173,"_5":29458,"_20209":51065,"_26493":51066,"_2816":51067},[],"/docs/platform/iot-fleets/enrollment/troubleshooting#error-codes-and-diagnostics","Error codes and diagnostics",{"_3328":1177,"_29138":1173,"_5":29458,"_20209":51069,"_26493":51070,"_2816":50617},[],"/docs/platform/iot-fleets/enrollment/troubleshooting#compatibility-notes",{"_3328":1178,"_29138":1173,"_5":29458,"_20209":51072,"_26493":51073,"_2816":51074},[],"/docs/platform/iot-fleets/enrollment/troubleshooting#est-enrollment-fails","EST enrollment fails",{"_3328":1179,"_29138":1173,"_20209":51076,"_5":13819,"_26493":1173,"_2816":51077},[],"Diagnose one operation and device at a time. Record the DMS/APS, endpoint, time, HTTP code, presented serial and CSR CN. Retain the response without including private keys or webhook credentials in the report.",{"_3328":1180,"_29138":1173,"_20209":51079,"_5":13819,"_26493":51066,"_2816":51080},[],"The EST controller normally returns 400 when rejecting input and 500 when the service rejects or fails the operation. A 500 can also represent a policy denial; it does not mean retrying is safe. Gateway can produce its own codes and bodies. Examine the actual body and persisted result.",{"_3328":1181,"_29138":1173,"_20209":51082,"_5":13819,"_26493":51066,"_2816":51083},[],"Symptom or message",{"_3328":1182,"_29138":1173,"_20209":51085,"_5":13819,"_26493":51066,"_2816":50847},[],{"_3328":1183,"_29138":1173,"_20209":51087,"_5":13819,"_26493":51066,"_2816":51088},[],"curl rejects TLS, name or issuer",{"_3328":1184,"_29138":1173,"_20209":51090,"_5":13819,"_26493":51066,"_2816":51091},[],"URL, clock, server SAN and approved root in `est-trust.pem`. Resolve trust in Deployment; do not skip verification.",{"_3328":1185,"_29138":1173,"_20209":51093,"_5":13819,"_26493":51066,"_2816":51094},[],"404 or missing APS",{"_3328":1186,"_29138":1173,"_20209":51096,"_5":13819,"_26493":51066,"_2816":51097},[],"Public route `/.well-known/est/{DMS_ID}/{operation}` and existing DMS. APS is not the service name.",{"_3328":1187,"_29138":1173,"_20209":51099,"_5":13819,"_26493":51066,"_2816":51100},[],"400, CSR or format error",{"_3328":1188,"_29138":1173,"_20209":51102,"_5":13819,"_26493":51066,"_2816":51103},[],"`Content-Type: application/pkcs10`, Base64 of DER, valid signature and a body preserved without double encoding.",{"_3328":1189,"_29138":1173,"_20209":51105,"_5":13819,"_26493":51066,"_2816":51106},[],"Missing credential or invalid certificate",{"_3328":1190,"_29138":1173,"_20209":51108,"_5":13819,"_26493":51066,"_2816":51109},[],"Operation mode, validating CA, dates, revocation and credential delivery by Gateway. Do not confuse server TLS trust with the bootstrap CA.",{"_3328":1191,"_29138":1173,"_20209":51111,"_5":13819,"_26493":51066,"_2816":51112},[],"Webhook denies, times out or responds without authorization",{"_3328":1192,"_29138":1173,"_20209":51114,"_5":13819,"_26493":51066,"_2816":51115},[],"Configuration, connectivity and JSON response with `authorized: true`. There is no automatic fallback to `NO_AUTH`.",{"_3328":1193,"_29138":1173,"_20209":51117,"_5":13819,"_26493":51066,"_2816":51118},[],"`unexpected status code: <n>: redirects are not followed`",{"_3328":1194,"_29138":1173,"_20209":51120,"_5":13819,"_26493":51066,"_2816":51121},[],"The webhook answered with a redirect. Configure the final absolute `http` or `https` URL in the webhook config; redirects are never followed.",{"_3328":1195,"_29138":1173,"_20209":51123,"_5":13819,"_26493":51066,"_2816":51124},[],"`webhook response exceeds 1048576 bytes`",{"_3328":1196,"_29138":1173,"_20209":51126,"_5":13819,"_26493":51066,"_2816":51127},[],"The receiver returned more than 1 MiB of JSON. Reduce the response of the authorization webhook.",{"_3328":1197,"_29138":1173,"_20209":51129,"_5":13819,"_26493":51066,"_2816":51130},[],"`webhook config must not reference files`",{"_3328":1198,"_29138":1173,"_20209":51132,"_5":13819,"_26493":51066,"_2816":51133},[],"The webhook config points to files (`ca_cert_file`, `mtls_options.cert_file`, `mtls_options.key_file`). For mTLS, enter the certificate and key as Base64-encoded PEM in `cert_content` and `key_content`, or as plain PEM; remove any other file field, including `ca_cert_file`, which has no inline equivalent (the receiver certificate must chain to the system trust store). See the webhook credentials guidance in DMS.",{"_3328":1199,"_29138":1173,"_20209":51135,"_5":13819,"_26493":51066,"_2816":51136},[],"`mtls_options.cert_content must be base64-encoded PEM`",{"_3328":1200,"_29138":1173,"_20209":51138,"_5":13819,"_26493":51066,"_2816":51139},[],"The value is neither Base64-encoded PEM nor plain PEM: it is a file path or Base64 of non-PEM data. Enter the certificate and key as Base64-encoded PEM, like certificates elsewhere in the API, or as plain PEM (see the webhook settings in DMS). The same message names `mtls_options.key_content` when the key is the offending value.",{"_3328":1201,"_29138":1173,"_20209":51141,"_5":13819,"_26493":51066,"_2816":51142},[],"`webhook mTLS certificate and key are invalid: …`",{"_3328":1202,"_29138":1173,"_20209":51144,"_5":13819,"_26493":51066,"_2816":51145},[],"The certificate and key do not form a matching pair. Enter both values from the same pair; the check runs when the DMS is saved and again on every webhook call.",{"_3328":1203,"_29138":1173,"_20209":51147,"_5":13819,"_26493":51066,"_2816":51148},[],"400 `struct validation error` creating or updating a DMS",{"_3328":1204,"_29138":1173,"_20209":51150,"_5":13819,"_26493":51066,"_2816":51151},[],"The webhook config of the operation that uses it is invalid. Review `external_webhook_settings` in DMS.",{"_3328":1205,"_29138":1173,"_20209":51153,"_5":13819,"_26493":51066,"_2816":51154},[],"HTTP 500 with an `err` body on enroll or reenroll",{"_3328":1206,"_29138":1173,"_20209":51156,"_5":13819,"_26493":51066,"_2816":51157},[],"Service failures reach the EST client as 500 with a body of `err` plus the message; webhook authorization errors are named there.",{"_3328":1207,"_29138":1173,"_20209":51159,"_5":13819,"_26493":51066,"_2816":51160},[],"`device not preregistered`",{"_3328":1208,"_29138":1173,"_20209":51162,"_5":13819,"_26493":51066,"_2816":51163},[],"PRE\\_REGISTRATION requires an existing inventory entry.",{"_3328":1209,"_29138":1173,"_20209":51165,"_5":13819,"_26493":51066,"_2816":51166},[],"`forbiddenNewEnrollment`",{"_3328":1210,"_29138":1173,"_20209":51168,"_5":13819,"_26493":51066,"_2816":51169},[],"An existing device requires replacement to be enabled, even in No Identity. Investigate before enabling the flag.",{"_3328":1211,"_29138":1173,"_20209":51171,"_5":13819,"_26493":51066,"_2816":51172},[],"Different owning DMS",{"_3328":1212,"_29138":1173,"_20209":51174,"_5":13819,"_26493":51066,"_2816":51175},[],"CN/ID, global inventory and owning DMS; do not reuse an ID from another context.",{"_3328":1213,"_29138":1173,"_20209":51177,"_5":13819,"_26493":51066,"_2816":51178},[],"`invalid RawSubject bytes`",{"_3328":1214,"_29138":1173,"_20209":51180,"_5":13819,"_26493":51066,"_2816":51181},[],"CSR subject versus the current certificate. Preserve its attributes as well as its CN.",{"_3328":1215,"_29138":1173,"_20209":51183,"_5":13819,"_26493":51066,"_2816":51184},[],"`invalid reenroll window`",{"_3328":1216,"_29138":1173,"_20209":51186,"_5":13819,"_26493":51066,"_2816":51187},[],"Current identity's NotAfter and reenrollment\\_delta. Alert thresholds do not change that window.",{"_3328":1217,"_29138":1173,"_20209":51189,"_5":13819,"_26493":51066,"_2816":51190},[],"Current certificate revoked",{"_3328":1218,"_29138":1173,"_20209":51192,"_5":13819,"_26493":51066,"_2816":51193},[],"Renewal rejected; prepare authorized recovery according to the cause.",{"_3328":1219,"_29138":1173,"_20209":51195,"_5":13819,"_26493":51066,"_2816":51196},[],"CA, profile or signing error",{"_3328":1220,"_29138":1173,"_20209":51198,"_5":13819,"_26493":51066,"_2816":51199},[],"Active CA, available key, selected profile and restrictions. Successful cacerts does not prove issuance.",{"_3328":1221,"_29138":1173,"_20209":51201,"_5":13819,"_26493":51066,"_2816":51202},[],"HTTP 200 without a device connection",{"_3328":1222,"_29138":1173,"_20209":51204,"_5":13819,"_26493":51066,"_2816":51205},[],"Installed pair, chain, uses, consumer trust and permissions. Also check the slot and history.",{"_3328":1223,"_29138":1173,"_20209":51207,"_5":13819,"_26493":51066,"_2816":51208},[],"Timeout or error after issuance",{"_3328":1224,"_29138":1173,"_20209":51210,"_5":13819,"_26493":51066,"_2816":51211},[],"New certificates, current slot and previous identity's state before retrying.",{"_3328":1225,"_29138":1173,"_20209":51213,"_5":13819,"_26493":51070,"_2816":51214},[],"The examples use the contract of the examined backend. Do not automatically attribute that behavior to another release. Check the saved renewal mode and Gateway behavior with expired certificates and the bootstrap CA.",{"_3328":1226,"_29138":1173,"_20209":51216,"_5":13819,"_26493":51070,"_2816":51217},[],"The default response is Base64-encoded DER PKCS#7; PEM through `Accept: application/x-pem-file` is a Lamassu extension. ServerKeyGen returns multipart and requires handling each part separately. See the EST reference.",{"_3328":1227,"_29138":1173,"_20209":51219,"_5":13819,"_26493":51073,"_2816":51220},[],"Check HTTPS with the approved root and query cacerts for the correct APS.",{"_3328":1228,"_29138":1173,"_20209":51222,"_5":13819,"_26493":51073,"_2816":51223},[],"Review the saved DMS: protocol, registration, authentication for that operation, CA, profile and window.",{"_3328":1229,"_29138":1173,"_20209":51225,"_5":13819,"_26493":51073,"_2816":51226},[],"Verify the CSR locally and relate its CN to the inventory.",{"_3328":1230,"_29138":1173,"_20209":51228,"_5":13819,"_26493":51073,"_2816":51229},[],"Make one request, save headers/body and query the device and certificates.",{"_3328":1231,"_29138":1173,"_20209":51231,"_5":13819,"_26493":51073,"_2816":51232},[],"If you receive an identity, check the key, subject, use and connection with the consumer.",{"_3328":1232,"_29138":1173,"_20209":51234,"_5":13819,"_26493":51073,"_2816":51235},[],"External bootstrap revocation checks have limitations: absence of evidence can be accepted, and OCSP Unknown does not cause the same rejection as Revoked. Do not assume a policy that rejects every uncertainty. An intermediate CA in the TLS chain does not prove that the entire chain reached the DMS validator either.",{"_3328":1233,"_29138":1173,"_20209":51237,"_5":13819,"_26493":51073,"_2816":51238},[],"For logs, networking, pods or Gateway headers, continue in Deployment troubleshooting. For identities issued, revoked or bound partially, use Renewal and recovery and Devices and identities.",{"_3328":1234,"_29138":1234,"_5":14177,"_2816":51240,"_29461":51241,"_20209":51242,"_26493":1234},"Trust distribution and updates",[47397,48865,49873,49871,50054],[],{"_3328":1235,"_29138":1234,"_20209":51244,"_5":13819,"_26493":1234,"_2816":51245},[],"Separate roots, intermediates and initial TLS trust when distributing or migrating certificates.",{"_3328":1236,"_29138":1234,"_5":29458,"_20209":51247,"_26493":51248,"_2816":51249},[],"/docs/platform/iot-fleets/enrollment/trust-distribution#three-trust-relationships","Three trust relationships",{"_3328":1237,"_29138":1234,"_5":29458,"_20209":51251,"_26493":51252,"_2816":51253},[],"/docs/platform/iot-fleets/enrollment/trust-distribution#what-cacerts-returns","What cacerts returns",{"_3328":1238,"_29138":1234,"_5":29458,"_20209":51255,"_26493":51256,"_2816":51257},[],"/docs/platform/iot-fleets/enrollment/trust-distribution#install-the-required-material","Install the required material",{"_3328":1239,"_29138":1234,"_5":29458,"_20209":51259,"_26493":51260,"_2816":51261},[],"/docs/platform/iot-fleets/enrollment/trust-distribution#migrate-trust","Migrate trust",{"_3328":1240,"_29138":1234,"_5":29458,"_20209":51263,"_26493":51264,"_2816":51265},[],"/docs/platform/iot-fleets/enrollment/trust-distribution#check-the-update","Check the update",{"_3328":1241,"_29138":1234,"_20209":51267,"_5":13819,"_26493":1234,"_2816":51268},[],"This guide is for device and consumer trust administrators. You need issuer inventory, trust-store access and an authenticated update channel. Distributing certificates is separate from choosing trusted anchors.",{"_3328":1242,"_29138":1234,"_20209":51270,"_5":13819,"_26493":51248,"_2816":51271},[],"Relationship",{"_3328":1243,"_29138":1234,"_20209":51273,"_5":13819,"_26493":51248,"_2816":51274},[],"Material prepared by its owner",{"_3328":1244,"_29138":1234,"_20209":51276,"_5":13819,"_26493":51248,"_2816":51277},[],"Device → EST server",{"_3328":1245,"_29138":1234,"_20209":51279,"_5":13819,"_26493":51248,"_2816":51280},[],"Previously verified server root, chain or pin and TLS name.",{"_3328":1246,"_29138":1234,"_20209":51282,"_5":13819,"_26493":51248,"_2816":51283},[],"DMS → requester",{"_3328":1247,"_29138":1234,"_20209":51285,"_5":13819,"_26493":51248,"_2816":51286},[],"CAs and rules authorizing initial or renewal credentials.",{"_3328":1248,"_29138":1234,"_20209":51288,"_5":13819,"_26493":51248,"_2816":51289},[],"Consumer → device",{"_3328":1249,"_29138":1234,"_20209":51291,"_5":13819,"_26493":51248,"_2816":51292},[],"Operational identity roots, intermediates, validation and permissions.",{"_3328":1250,"_29138":1234,"_20209":51294,"_5":13819,"_26493":51248,"_2816":51295},[],"Obtaining a certificate does not automatically configure these relationships in third parties. Review the Trust model.",{"_3328":1251,"_29138":1234,"_20209":51297,"_5":13819,"_26493":51252,"_2816":51298},[],"The DMS may include the available downstream TLS certificate, selected Managed CAs and enrollment CA. Selecting the issuer does not include every ancestor. The set may contain leaves, roots and intermediates, including multiple hierarchies during migration.",{"_3328":1252,"_29138":1234,"_20209":51300,"_5":13819,"_26493":51252,"_2816":51301},[],"Position does not define the chain. Identify certificates by subject, issuer, AKI/SKI, signature and constraints. Download and inspect using EST client.",{"_3328":1253,"_29138":1234,"_20209":51303,"_5":13819,"_26493":51256,"_2816":51304},[],"Keep initial EST server trust separate from identity consumer trust.",{"_3328":1254,"_29138":1234,"_20209":51306,"_5":13819,"_26493":51256,"_2816":51307},[],"Select policy-approved roots as anchors.",{"_3328":1255,"_29138":1234,"_20209":51309,"_5":13819,"_26493":51256,"_2816":51310},[],"Retain intermediates for chain building or presentation; do not automatically turn them into roots.",{"_3328":1256,"_29138":1234,"_20209":51312,"_5":13819,"_26493":51256,"_2816":51313},[],"Present the leaf and required intermediates in mTLS. Normally the peer already trusts its root and does not need it sent.",{"_3328":1257,"_29138":1234,"_20209":51315,"_5":13819,"_26493":51256,"_2816":51316},[],"Verify chain, dates, names, usages and revocation from the consumer.",{"_3328":1258,"_29138":1234,"_20209":51318,"_5":13819,"_26493":51256,"_2816":51319},[],"Do not indiscriminately use all of `cacerts.pem` as `-CAfile`: this can expand trusted authorities, hide missing intermediates or trust a TLS leaf intended for another purpose.",{"_3328":1259,"_29138":1234,"_20209":51321,"_5":13819,"_26493":51260,"_2816":51322},[],"Before changing Enrollment CA, inventory disconnected equipment, bootstrap and operational certificates, and consumers. Distribute the new root and required intermediates; check that a cohort accepts both old and new chains.",{"_3328":1260,"_29138":1234,"_20209":51324,"_5":13819,"_26493":51260,"_2816":51325},[],"In the DMS, separate distributed CAs from the re-enrollment validation CAs at `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`, used for re-enrollment credentials. That list is optional because the enrollment CA always validates re-enrollment credentials, but when switching the enrollment CA, add the previous issuance CA to it so old-CA identities keep re-enrolling during overlap. The inspected validator tries the enrollment CA followed by those CAs against the received leaf; accepting a multilevel chain requires checking what reaches the service and which issuer is configured.",{"_3328":1261,"_29138":1234,"_20209":51327,"_5":13819,"_26493":51260,"_2816":51328},[],"Switch issuance, renew in cohorts and compare the installed serial with the active slot. Remove previous trust once no legitimate equipment needs it and policy permits ending overlap. Follow Hierarchy and rotation for the PKI operation.",{"_3328":1262,"_29138":1234,"_20209":51330,"_5":13819,"_26493":51264,"_2816":51331},[],"Test an old identity allowed during overlap, a new one, an unknown chain and the result after removing old trust. Keep trust-store version, approved set, date and result. Reachable `/cacerts` establishes distribution only; it does not establish installation or acceptance across every device.",{"_3328":1263,"_29138":1263,"_5":14177,"_2816":51333,"_29461":51334,"_20209":51336,"_26493":1263},"AWS IoT Core",[47397,48865,49873,49871,51335],"Integrations",[],{"_3328":1264,"_29138":1263,"_20209":51338,"_5":13819,"_26493":1263,"_2816":51339},[],"Lamassu's connector for AWS IoT Core syncs device identities with the AWS platform, handling CA registration, Thing provisioning and certificate lifecycle automatically and event-driven.",{"_3328":1265,"_29138":1263,"_5":29458,"_20209":51341,"_26493":51342,"_2816":51343},[],"/docs/platform/iot-fleets/integrations/aws-iot-core#connector-architecture","Connector architecture",{"_3328":1266,"_29138":1263,"_5":29458,"_20209":51345,"_26493":51346,"_2816":51347},[],"/docs/platform/iot-fleets/integrations/aws-iot-core#prerequisites","Prerequisites",{"_3328":1267,"_29138":1263,"_5":29458,"_20209":51349,"_26493":51350,"_2816":51351},[],"/docs/platform/iot-fleets/integrations/aws-iot-core#required-iam-permissions","Required IAM permissions",{"_3328":1268,"_29138":1263,"_5":29458,"_20209":51353,"_26493":51354,"_2816":51355},[],"/docs/platform/iot-fleets/integrations/aws-iot-core#configuration-parameters","Configuration parameters",{"_3328":1269,"_29138":1263,"_5":29458,"_20209":51357,"_26493":51358,"_2816":51359},[],"/docs/platform/iot-fleets/integrations/aws-iot-core#resource-state-machine","Resource state machine",{"_3328":1270,"_29138":1263,"_5":29458,"_20209":51361,"_26493":51362,"_2816":51363},[],"/docs/platform/iot-fleets/integrations/aws-iot-core#events-the-connector-handles","Events the connector handles",{"_3328":1271,"_29138":1263,"_5":29458,"_20209":51365,"_26493":51366,"_2816":51367},[],"/docs/platform/iot-fleets/integrations/aws-iot-core#ca-registration-states","CA registration states",{"_3328":1272,"_29138":1263,"_5":29458,"_20209":51369,"_26493":51370,"_2816":51371},[],"/docs/platform/iot-fleets/integrations/aws-iot-core#dms-registration-mode-states","DMS registration-mode states",{"_3328":1273,"_29138":1263,"_5":29458,"_20209":51373,"_26493":51374,"_2816":51375},[],"/docs/platform/iot-fleets/integrations/aws-iot-core#certificate-status-states","Certificate status states",{"_3328":1274,"_29138":1263,"_5":29458,"_20209":51377,"_26493":51378,"_2816":51379},[],"/docs/platform/iot-fleets/integrations/aws-iot-core#thing-lifecycle","Thing lifecycle",{"_3328":1275,"_29138":1263,"_5":29458,"_20209":51381,"_26493":51382,"_2816":51383},[],"/docs/platform/iot-fleets/integrations/aws-iot-core#ca-registration-in-aws-iot-core","CA registration in AWS IoT Core",{"_3328":1276,"_29138":1263,"_5":29458,"_20209":51385,"_26493":51386,"_2816":51387},[],"/docs/platform/iot-fleets/integrations/aws-iot-core#how-to-request-registration","How to request registration",{"_3328":1277,"_29138":1263,"_5":29458,"_20209":51389,"_26493":51390,"_2816":51391},[],"/docs/platform/iot-fleets/integrations/aws-iot-core#primary-account","Primary Account",{"_3328":1278,"_29138":1263,"_5":29458,"_20209":51393,"_26493":51394,"_2816":51395},[],"/docs/platform/iot-fleets/integrations/aws-iot-core#secondary-account-sni-only","Secondary Account (SNI-only)",{"_3328":1279,"_29138":1263,"_5":29458,"_20209":51397,"_26493":51398,"_2816":51399},[],"/docs/platform/iot-fleets/integrations/aws-iot-core#dms-configuration","DMS configuration",{"_3328":1280,"_29138":1263,"_5":29458,"_20209":51401,"_26493":51402,"_2816":51403},[],"/docs/platform/iot-fleets/integrations/aws-iot-core#none-mode","`none` mode",{"_3328":1281,"_29138":1263,"_5":29458,"_20209":51405,"_26493":51406,"_2816":51407},[],"/docs/platform/iot-fleets/integrations/aws-iot-core#auto-mode","`auto` mode",{"_3328":1282,"_29138":1263,"_5":29458,"_20209":51409,"_26493":51410,"_2816":51411},[],"/docs/platform/iot-fleets/integrations/aws-iot-core#jitp-mode","`jitp` mode",{"_3328":1283,"_29138":1263,"_5":29458,"_20209":51413,"_26493":51414,"_2816":51415},[],"/docs/platform/iot-fleets/integrations/aws-iot-core#device-provisioning-automatic-mode","Device provisioning (automatic mode)",{"_3328":1284,"_29138":1263,"_5":29458,"_20209":51417,"_26493":51418,"_2816":51419},[],"/docs/platform/iot-fleets/integrations/aws-iot-core#device-provisioning-jitp-mode","Device provisioning (JITP mode)",{"_3328":1285,"_29138":1263,"_5":29458,"_20209":51421,"_26493":51422,"_2816":51423},[],"/docs/platform/iot-fleets/integrations/aws-iot-core#certificate-status-synchronization","Certificate status synchronization",{"_3328":1286,"_29138":1263,"_5":29458,"_20209":51425,"_26493":51426,"_2816":51427},[],"/docs/platform/iot-fleets/integrations/aws-iot-core#forced-disconnect-on-revocation","Forced disconnect on revocation",{"_3328":1287,"_29138":1263,"_5":29458,"_20209":51429,"_26493":51430,"_2816":51431},[],"/docs/platform/iot-fleets/integrations/aws-iot-core#device-shadow-and-automation","Device Shadow and automation",{"_3328":1288,"_29138":1263,"_5":29458,"_20209":51433,"_26493":51434,"_2816":51435},[],"/docs/platform/iot-fleets/integrations/aws-iot-core#what-the-connector-writes-to-the-shadow","What the connector writes to the shadow",{"_3328":1289,"_29138":1263,"_5":29458,"_20209":51437,"_26493":51438,"_2816":51439},[],"/docs/platform/iot-fleets/integrations/aws-iot-core#aws-iot-policies","AWS IoT policies",{"_3328":1290,"_29138":1263,"_5":29458,"_20209":51441,"_26493":51442,"_2816":51443},[],"/docs/platform/iot-fleets/integrations/aws-iot-core#troubleshooting","Troubleshooting",{"_3328":1291,"_29138":1263,"_20209":51445,"_5":13819,"_26493":1263,"_2816":51446},[],"Lamassu's integration with AWS IoT Core bridges the PKI managed by Lamassu and AWS's connectivity platform. When a device obtains its certificate through the EST enrollment process, the connector ensures that certificate and its associated identity are recognized in AWS IoT Core without manual intervention. The result is that the device can authenticate directly to AWS with the same X.509 certificate Lamassu issued.",{"_3328":1292,"_29138":1263,"_20209":51448,"_5":13819,"_26493":1263,"_2816":51449},[],"From a protocol standpoint, the device authenticates to AWS IoT Core via mutual TLS (mTLS): it presents its Lamassu-issued X.509 certificate as the client certificate, and AWS IoT Core verifies the certificate chain up to the CA registered in the account. Lamassu acts as the certification authority (CA); the connector ensures that CA is registered in AWS and that the device's certificate is known to the platform before the device attempts to connect (in `auto` mode) or on its first connection (in JITP mode).",{"_3328":1293,"_29138":1263,"_20209":51451,"_5":13819,"_26493":1263,"_2816":51452},[],"This document is aimed both at the PKI administrator, who needs to configure the connector and register CAs, and at the device firmware developer, who needs to understand how Things are named, how the Device Shadow works and what happens when a certificate is revoked. For the firmware developer, the most important fact is that **the AWS Thing name (ThingName) always corresponds to the Common Name (CN) of the certificate issued by Lamassu**, regardless of the provisioning mode.",{"_3328":1294,"_29138":1263,"_20209":51454,"_5":13819,"_26493":51342,"_2816":51455},[],"The AWS IoT Core connector is an independent Go process, a binary or container separate from Lamassu's core. In a monolithic deployment it is compiled by default (build tag `!noaws`) and activated with `aws_iot_manager.enabled: true` in the configuration file. In distributed deployments, it runs as its own container with access to Lamassu's CA, DMS Manager and Device Manager services over HTTP.",{"_3328":1295,"_29138":1263,"_20209":51457,"_5":13819,"_26493":51342,"_2816":51458},[],"The connector does not poll Lamassu's services periodically. Instead, it **subscribes to Lamassu's internal event bus** (AMQP or AWS SQS/SNS, configurable) and reacts to the events it cares about: CA creation or update, DMS creation or update, device identity binding, certificate status change, certificate metadata update and device metadata update. This event-driven model ensures synchronization with AWS is nearly immediate and produces no polling load.",{"_3328":1296,"_29138":1263,"_20209":51460,"_5":13819,"_26493":51342,"_2816":51461},[],"To avoid infinite loops, the connector ignores any event whose CloudEvent `source` field matches its own origin URI. This prevents the metadata writes the connector itself performs from re-triggering the same flow.",{"_3328":1297,"_29138":1263,"_20209":51463,"_5":13819,"_26493":51342,"_2816":51464},[],"When several connectors run in parallel, for example for different AWS accounts, each instance has its own `connector_id`. All metadata the connector writes to Lamassu is stored under the key `lamassu.io/iot/{connector_id}`, allowing coexistence without collisions.",{"_3328":1298,"_29138":1263,"_20209":51466,"_5":13819,"_26493":51346,"_2816":51467},[],"Before enabling the connector you need an AWS account with the proper IAM permissions and the connector correctly configured. The deployment process (Docker Compose, Kubernetes or binary) is described in the deployment documentation.",{"_3328":1299,"_29138":1263,"_20209":51469,"_5":13819,"_26493":51350,"_2816":51470},[],"The IAM identity operating the connector needs at minimum the following permissions on the target account's resources:",{"_3328":1300,"_29138":1263,"_20209":51472,"_5":13819,"_26493":51350,"_2816":51473},[],"IAM action",{"_3328":1301,"_29138":1263,"_20209":51475,"_5":13819,"_26493":51350,"_2816":47787},[],{"_3328":1302,"_29138":1263,"_20209":51477,"_5":13819,"_26493":51350,"_2816":51478},[],"`iot:GetRegistrationCode`",{"_3328":1303,"_29138":1263,"_20209":51480,"_5":13819,"_26493":51350,"_2816":51481},[],"Obtain the verification code for CA registration in the Primary Account",{"_3328":1304,"_29138":1263,"_20209":51483,"_5":13819,"_26493":51350,"_2816":51484},[],"`iot:RegisterCACertificate`",{"_3328":1305,"_29138":1263,"_20209":51486,"_5":13819,"_26493":51350,"_2816":51487},[],"Register the CA in AWS IoT",{"_3328":1306,"_29138":1263,"_20209":51489,"_5":13819,"_26493":51350,"_2816":51490},[],"`iot:DescribeCACertificate`",{"_3328":1307,"_29138":1263,"_20209":51492,"_5":13819,"_26493":51350,"_2816":51493},[],"Check the CA registration status",{"_3328":1308,"_29138":1263,"_20209":51495,"_5":13819,"_26493":51350,"_2816":51496},[],"`iot:CreateThing` / `iot:UpdateThing`",{"_3328":1309,"_29138":1263,"_20209":51498,"_5":13819,"_26493":51350,"_2816":51499},[],"Create or update Things in IoT Core",{"_3328":1310,"_29138":1263,"_20209":51501,"_5":13819,"_26493":51350,"_2816":51502},[],"`iot:RegisterThing`",{"_3328":1311,"_29138":1263,"_20209":51504,"_5":13819,"_26493":51350,"_2816":51505},[],"Provision Things through a template",{"_3328":1312,"_29138":1263,"_20209":51507,"_5":13819,"_26493":51350,"_2816":51508},[],"`iot:RegisterCertificate`",{"_3328":1313,"_29138":1263,"_20209":51510,"_5":13819,"_26493":51350,"_2816":51511},[],"Register device certificates",{"_3328":1314,"_29138":1263,"_20209":51513,"_5":13819,"_26493":51350,"_2816":51514},[],"`iot:UpdateCertificate`",{"_3328":1315,"_29138":1263,"_20209":51516,"_5":13819,"_26493":51350,"_2816":51517},[],"Change a certificate's status (ACTIVE / INACTIVE / REVOKED)",{"_3328":1316,"_29138":1263,"_20209":51519,"_5":13819,"_26493":51350,"_2816":51520},[],"`iot:CreatePolicy` / `iot:AttachPolicy`",{"_3328":1317,"_29138":1263,"_20209":51522,"_5":13819,"_26493":51350,"_2816":51523},[],"Create and attach IoT policies",{"_3328":1318,"_29138":1263,"_20209":51525,"_5":13819,"_26493":51350,"_2816":51526},[],"`iot:CreateThingGroup` / `iot:AddThingToThingGroup`",{"_3328":1319,"_29138":1263,"_20209":51528,"_5":13819,"_26493":51350,"_2816":51529},[],"Manage Thing groups",{"_3328":1320,"_29138":1263,"_20209":51531,"_5":13819,"_26493":51350,"_2816":51532},[],"`iot:CreateProvisioningTemplate`",{"_3328":1321,"_29138":1263,"_20209":51534,"_5":13819,"_26493":51350,"_2816":51535},[],"Create JITP templates",{"_3328":1322,"_29138":1263,"_20209":51537,"_5":13819,"_26493":51350,"_2816":51538},[],"`iotdata:GetThingShadow` / `iotdata:UpdateThingShadow`",{"_3328":1323,"_29138":1263,"_20209":51540,"_5":13819,"_26493":51350,"_2816":51541},[],"Read and write the Device Shadow",{"_3328":1324,"_29138":1263,"_20209":51543,"_5":13819,"_26493":51350,"_2816":51544},[],"The forced-disconnect mechanism after revocation also requires access to the AWS IoT data plane API (`iot:Connect` with SigV4 over WebSocket), negotiated implicitly with the connector's credentials.",{"_3328":1325,"_29138":1263,"_20209":51546,"_5":13819,"_26493":51354,"_2816":51547},[],"Parameter",{"_3328":1326,"_29138":1263,"_20209":51549,"_5":13819,"_26493":51354,"_2816":51550},[],"Type",{"_3328":1327,"_29138":1263,"_20209":51552,"_5":13819,"_26493":51354,"_2816":51553},[],"Required",{"_3328":1328,"_29138":1263,"_20209":51555,"_5":13819,"_26493":51354,"_2816":51556},[],"Description",{"_3328":1329,"_29138":1263,"_20209":51558,"_5":13819,"_26493":51354,"_2816":51559},[],"`connector_id`",{"_3328":1330,"_29138":1263,"_20209":51561,"_5":13819,"_26493":51354,"_2816":24136},[],{"_3328":1331,"_29138":1263,"_20209":51563,"_5":13819,"_26493":51354,"_2816":51564},[],"Yes",{"_3328":1332,"_29138":1263,"_20209":51566,"_5":13819,"_26493":51354,"_2816":51567},[],"Unique identifier of this connector instance. Used as the metadata namespace: `lamassu.io/iot/{connector_id}`.",{"_3328":1333,"_29138":1263,"_20209":51569,"_5":13819,"_26493":51354,"_2816":51570},[],"`aws_config.region`",{"_3328":1334,"_29138":1263,"_20209":51572,"_5":13819,"_26493":51354,"_2816":24136},[],{"_3328":1335,"_29138":1263,"_20209":51574,"_5":13819,"_26493":51354,"_2816":51564},[],{"_3328":1336,"_29138":1263,"_20209":51576,"_5":13819,"_26493":51354,"_2816":51577},[],"AWS region where the connector operates.",{"_3328":1337,"_29138":1263,"_20209":51579,"_5":13819,"_26493":51354,"_2816":51580},[],"`aws_config.auth_method`",{"_3328":1338,"_29138":1263,"_20209":51582,"_5":13819,"_26493":51354,"_2816":24136},[],{"_3328":1339,"_29138":1263,"_20209":51584,"_5":13819,"_26493":51354,"_2816":51564},[],{"_3328":1340,"_29138":1263,"_20209":51586,"_5":13819,"_26493":51354,"_2816":51587},[],"Authentication method: `static`, `role` or empty (SDK default credential chain).",{"_3328":1341,"_29138":1263,"_20209":51589,"_5":13819,"_26493":51354,"_2816":51590},[],"`aws_config.access_key_id`",{"_3328":1342,"_29138":1263,"_20209":51592,"_5":13819,"_26493":51354,"_2816":24136},[],{"_3328":1343,"_29138":1263,"_20209":51594,"_5":13819,"_26493":51354,"_2816":51595},[],"Only with `auth_method=static`",{"_3328":1344,"_29138":1263,"_20209":51597,"_5":13819,"_26493":51354,"_2816":51598},[],"AWS access key.",{"_3328":1345,"_29138":1263,"_20209":51600,"_5":13819,"_26493":51354,"_2816":51601},[],"`aws_config.secret_access_key`",{"_3328":1346,"_29138":1263,"_20209":51603,"_5":13819,"_26493":51354,"_2816":24136},[],{"_3328":1347,"_29138":1263,"_20209":51605,"_5":13819,"_26493":51354,"_2816":51595},[],{"_3328":1348,"_29138":1263,"_20209":51607,"_5":13819,"_26493":51354,"_2816":51608},[],"AWS secret key.",{"_3328":1349,"_29138":1263,"_20209":51610,"_5":13819,"_26493":51354,"_2816":51611},[],"`aws_config.session_token`",{"_3328":1350,"_29138":1263,"_20209":51613,"_5":13819,"_26493":51354,"_2816":24136},[],{"_3328":1351,"_29138":1263,"_20209":51615,"_5":13819,"_26493":51354,"_2816":51616},[],"No",{"_3328":1352,"_29138":1263,"_20209":51618,"_5":13819,"_26493":51354,"_2816":51619},[],"Session token (with `auth_method=static`).",{"_3328":1353,"_29138":1263,"_20209":51621,"_5":13819,"_26493":51354,"_2816":51622},[],"`aws_config.role_arn`",{"_3328":1354,"_29138":1263,"_20209":51624,"_5":13819,"_26493":51354,"_2816":24136},[],{"_3328":1355,"_29138":1263,"_20209":51626,"_5":13819,"_26493":51354,"_2816":51627},[],"Only with `auth_method=role`",{"_3328":1356,"_29138":1263,"_20209":51629,"_5":13819,"_26493":51354,"_2816":51630},[],"ARN of the role to assume.",{"_3328":1357,"_29138":1263,"_20209":51632,"_5":13819,"_26493":51354,"_2816":51633},[],"`aws_config.endpoint_url`",{"_3328":1358,"_29138":1263,"_20209":51635,"_5":13819,"_26493":51354,"_2816":24136},[],{"_3328":1359,"_29138":1263,"_20209":51637,"_5":13819,"_26493":51354,"_2816":51616},[],{"_3328":1360,"_29138":1263,"_20209":51639,"_5":13819,"_26493":51354,"_2816":51640},[],"Alternative URL for all AWS services (useful with LocalStack in tests).",{"_3328":1361,"_29138":1263,"_20209":51642,"_5":13819,"_26493":51354,"_2816":51643},[],"`subscriber_event_bus`",{"_3328":1362,"_29138":1263,"_20209":51645,"_5":13819,"_26493":51354,"_2816":16975},[],{"_3328":1363,"_29138":1263,"_20209":51647,"_5":13819,"_26493":51354,"_2816":51564},[],{"_3328":1364,"_29138":1263,"_20209":51649,"_5":13819,"_26493":51354,"_2816":51650},[],"Configuration of the event bus the connector subscribes to (AMQP or AWS SQS/SNS).",{"_3328":1365,"_29138":1263,"_20209":51652,"_5":13819,"_26493":51354,"_2816":51653},[],"`dms_manager_client`",{"_3328":1366,"_29138":1263,"_20209":51655,"_5":13819,"_26493":51354,"_2816":24136},[],{"_3328":1367,"_29138":1263,"_20209":51657,"_5":13819,"_26493":51354,"_2816":51564},[],{"_3328":1368,"_29138":1263,"_20209":51659,"_5":13819,"_26493":51354,"_2816":51660},[],"HTTP URL of Lamassu's DMS Manager service.",{"_3328":1369,"_29138":1263,"_20209":51662,"_5":13819,"_26493":51354,"_2816":51663},[],"`device_manager_client`",{"_3328":1370,"_29138":1263,"_20209":51665,"_5":13819,"_26493":51354,"_2816":24136},[],{"_3328":1371,"_29138":1263,"_20209":51667,"_5":13819,"_26493":51354,"_2816":51564},[],{"_3328":1372,"_29138":1263,"_20209":51669,"_5":13819,"_26493":51354,"_2816":51670},[],"HTTP URL of Lamassu's Device Manager.",{"_3328":1373,"_29138":1263,"_20209":51672,"_5":13819,"_26493":51354,"_2816":51673},[],"`ca_client`",{"_3328":1374,"_29138":1263,"_20209":51675,"_5":13819,"_26493":51354,"_2816":24136},[],{"_3328":1375,"_29138":1263,"_20209":51677,"_5":13819,"_26493":51354,"_2816":51564},[],{"_3328":1376,"_29138":1263,"_20209":51679,"_5":13819,"_26493":51354,"_2816":51680},[],"HTTP URL of Lamassu's CA service.",{"_3328":1377,"_29138":1263,"_20209":51682,"_5":13819,"_26493":51358,"_2816":51683},[],"The connector owns the AWS side of four resource types — CAs, DMS provisioning templates (JITP), device certificates and Things. This section maps the bus events the connector consumes to the AWS resources they touch and to the AWS calls each transition performs. AWS resources are referenced with the notation `IoTCore/<resource>`.",{"_3328":1378,"_29138":1263,"_20209":51685,"_5":13819,"_26493":51362,"_2816":51686},[],"The **CloudEvent type** column lists the event name on Lamassu's internal event bus; the **IAM actions** column lists the exact AWS SDK operations each flow invokes, so the required permissions can be derived directly from this table.",{"_3328":1379,"_29138":1263,"_20209":51688,"_5":13819,"_26493":51362,"_2816":51689},[],"CloudEvent type",{"_3328":1380,"_29138":1263,"_20209":51691,"_5":13819,"_26493":51362,"_2816":51692},[],"Lamassu resource",{"_3328":1381,"_29138":1263,"_20209":51694,"_5":13819,"_26493":51362,"_2816":51695},[],"AWS Resource",{"_3328":1382,"_29138":1263,"_20209":51697,"_5":13819,"_26493":51362,"_2816":51698},[],"IAM actions",{"_3328":1383,"_29138":1263,"_20209":51700,"_5":13819,"_26493":51362,"_2816":51701},[],"AWS calls and effect",{"_3328":1384,"_29138":1263,"_20209":51703,"_5":13819,"_26493":51362,"_2816":51704},[],"Where in this page",{"_3328":1385,"_29138":1263,"_20209":51706,"_5":13819,"_26493":51362,"_2816":51707},[],"`EventCreateCAKey` / `EventImportCAKey` / `EventUpdateCAMetadataKey`",{"_3328":1386,"_29138":1263,"_20209":51709,"_5":13819,"_26493":51362,"_2816":51710},[],"CA",{"_3328":1387,"_29138":1263,"_20209":51712,"_5":13819,"_26493":51362,"_2816":51713},[],"`IoTCore/CACertificate`",{"_3328":1388,"_29138":1263,"_20209":51715,"_5":13819,"_26493":51362,"_2816":51716},[],"`iot:GetRegistrationCode`, `iot:RegisterCACertificate`, `iot:DescribeCACertificate`, `iot:ListCACertificates`",{"_3328":1389,"_29138":1263,"_20209":51718,"_5":13819,"_26493":51362,"_2816":51719},[],"Loads the CA into connector state; a `registration.status = REQUESTED` write fires the registration flow (Primary with verification certificate, or SNI-only) and writes `SUCCEEDED` or `FAILED` back to the CA's metadata.",{"_3328":1390,"_29138":1263,"_20209":51721,"_5":13819,"_26493":51362,"_2816":51367},[],{"_3328":1391,"_29138":1263,"_20209":51723,"_5":13819,"_26493":51362,"_2816":51724},[],"`EventCreateDMSKey` / `EventUpdateDMSKey`",{"_3328":1392,"_29138":1263,"_20209":51726,"_5":13819,"_26493":51362,"_2816":51727},[],"DMS",{"_3328":1393,"_29138":1263,"_20209":51729,"_5":13819,"_26493":51362,"_2816":51730},[],"`IoTCore/ProvisioningTemplate`",{"_3328":1394,"_29138":1263,"_20209":51732,"_5":13819,"_26493":51362,"_2816":51733},[],"`iot:CreateProvisioningTemplate`, `iot:UpdateCACertificate`",{"_3328":1395,"_29138":1263,"_20209":51735,"_5":13819,"_26493":51362,"_2816":51736},[],"In `jitp` mode, attempts to create the provisioning template and attaches it to the registered CA. Non-idempotent: a `PUT /v1/dms/{id}` edit retries the creation and lands in `lamassu-dlq` after 3 retries. Idempotent for `none` and `auto` (configuration only).",{"_3328":1396,"_29138":1263,"_20209":51738,"_5":13819,"_26493":51362,"_2816":51371},[],{"_3328":1397,"_29138":1263,"_20209":51740,"_5":13819,"_26493":51362,"_2816":51741},[],"`EventBindDeviceIdentityKey`",{"_3328":1398,"_29138":1263,"_20209":51743,"_5":13819,"_26493":51362,"_2816":51744},[],"Device",{"_3328":1399,"_29138":1263,"_20209":51746,"_5":13819,"_26493":51362,"_2816":51747},[],"`IoTCore/Policy`, `IoTCore/ThingGroup`, `IoTCore/Thing`",{"_3328":1400,"_29138":1263,"_20209":51749,"_5":13819,"_26493":51362,"_2816":51750},[],"`iot:CreatePolicy` / `iot:DeletePolicyVersion`, `iot:GetPolicy` / `iot:ListPolicyVersions`, `iot:CreateThingGroup`, `iot:DescribeThing` / `iot:ListThingPrincipals`, `iot:RegisterThing`",{"_3328":1401,"_29138":1263,"_20209":51752,"_5":13819,"_26493":51362,"_2816":51753},[],"In `auto` mode: creates/updates policies, ensures Thing groups, revokes stale principals and provisions the Thing via `iot:RegisterThing`. In `jitp` mode: no AWS calls; AWS runs the JITP template on first connection.",{"_3328":1402,"_29138":1263,"_20209":51755,"_5":13819,"_26493":51362,"_2816":51379},[],{"_3328":1403,"_29138":1263,"_20209":51757,"_5":13819,"_26493":51362,"_2816":51758},[],"`EventUpdateCertificateStatusKey`",{"_3328":1404,"_29138":1263,"_20209":51760,"_5":13819,"_26493":51362,"_2816":51761},[],"Certificate",{"_3328":1405,"_29138":1263,"_20209":51763,"_5":13819,"_26493":51362,"_2816":51764},[],"`IoTCore/Certificate`",{"_3328":1406,"_29138":1263,"_20209":51766,"_5":13819,"_26493":51362,"_2816":51767},[],"`iot:UpdateCertificate`, `iot:Connect` (data plane)",{"_3328":1407,"_29138":1263,"_20209":51769,"_5":13819,"_26493":51362,"_2816":51770},[],"Maps status to AWS (`ACTIVE`, `INACTIVE`, `REVOKED`), calls `iot:UpdateCertificate` and forces an MQTT disconnect on revoke.",{"_3328":1408,"_29138":1263,"_20209":51772,"_5":13819,"_26493":51362,"_2816":51375},[],{"_3328":1409,"_29138":1263,"_20209":51774,"_5":13819,"_26493":51362,"_2816":51775},[],"`EventUpdateCertificateMetadataKey` / `EventUpdateDeviceMetadataKey`",{"_3328":1410,"_29138":1263,"_20209":51777,"_5":13819,"_26493":51362,"_2816":51778},[],"Certificate / Device",{"_3328":1411,"_29138":1263,"_20209":51780,"_5":13819,"_26493":51362,"_2816":51781},[],"`IoTCore/Certificate`, `IoTCore/Thing`",{"_3328":1412,"_29138":1263,"_20209":51783,"_5":13819,"_26493":51362,"_2816":47793},[],{"_3328":1413,"_29138":1263,"_20209":51785,"_5":13819,"_26493":51362,"_2816":51786},[],"Refreshes internal state; the connector ignores events whose CloudEvent `source` matches its own URI to avoid self-triggered loops.",{"_3328":1414,"_29138":1263,"_20209":51788,"_5":13819,"_26493":51362,"_2816":51431},[],{"_3328":1415,"_29138":1263,"_20209":51790,"_5":13819,"_26493":51366,"_2816":51791},[],"The CA registration flow is driven by the `registration.status` field of the CA's connector metadata:",{"_3328":1416,"_29138":1263,"_20209":51793,"_5":13819,"_26493":51366,"_2816":51794},[],"by the `registration.status` field of the CA's connector metadata:",{"_3328":1417,"_29138":1263,"_20209":51796,"_5":13819,"_26493":51366,"_2816":51797},[],"Transition",{"_3328":1418,"_29138":1263,"_20209":51799,"_5":13819,"_26493":51366,"_2816":51800},[],"AWS calls",{"_3328":1419,"_29138":1263,"_20209":51802,"_5":13819,"_26493":51366,"_2816":51803},[],"`NotRegistered` → `Requested`",{"_3328":1420,"_29138":1263,"_20209":51805,"_5":13819,"_26493":51366,"_2816":51806},[],"none (metadata write only)",{"_3328":1421,"_29138":1263,"_20209":51808,"_5":13819,"_26493":51366,"_2816":51809},[],"`Requested` → `Registering`",{"_3328":1422,"_29138":1263,"_20209":51811,"_5":13819,"_26493":51366,"_2816":51812},[],"`iot:GetRegistrationCode` (Primary Account only)",{"_3328":1423,"_29138":1263,"_20209":51814,"_5":13819,"_26493":51366,"_2816":51815},[],"`Registering` → `Succeeded`",{"_3328":1424,"_29138":1263,"_20209":51817,"_5":13819,"_26493":51366,"_2816":51818},[],"`iot:RegisterCACertificate` (Primary: proof-of-possession with an ephemeral key; SNI-only: `CertificateMode: SNI_ONLY`)",{"_3328":1425,"_29138":1263,"_20209":51820,"_5":13819,"_26493":51366,"_2816":51821},[],"`Registering` → `Failed`",{"_3328":1426,"_29138":1263,"_20209":51823,"_5":13819,"_26493":51366,"_2816":51824},[],"failed `iot:RegisterCACertificate`; the error detail is written to the CA's metadata",{"_3328":1427,"_29138":1263,"_20209":51826,"_5":13819,"_26493":51366,"_2816":51827},[],"`Failed` / `Succeeded` → `Requested`",{"_3328":1428,"_29138":1263,"_20209":51829,"_5":13819,"_26493":51366,"_2816":51830},[],"none (a new `REQUESTED` write re-runs the flow)",{"_3328":1429,"_29138":1263,"_20209":51832,"_5":13819,"_26493":51370,"_2816":51833},[],"The DMS's `registration_mode` determines what the connector does on the AWS side when the DMS is created or fully edited:",{"_3328":1430,"_29138":1263,"_20209":51835,"_5":13819,"_26493":51370,"_2816":51797},[],{"_3328":1431,"_29138":1263,"_20209":51837,"_5":13819,"_26493":51370,"_2816":51800},[],{"_3328":1432,"_29138":1263,"_20209":51839,"_5":13819,"_26493":51370,"_2816":51840},[],"`Unconfigured` → `None` / `Auto`",{"_3328":1433,"_29138":1263,"_20209":51842,"_5":13819,"_26493":51370,"_2816":51843},[],"none (configuration only)",{"_3328":1434,"_29138":1263,"_20209":51845,"_5":13819,"_26493":51370,"_2816":51846},[],"`None` ↔ `Auto`",{"_3328":1435,"_29138":1263,"_20209":51848,"_5":13819,"_26493":51370,"_2816":51843},[],{"_3328":1436,"_29138":1263,"_20209":51850,"_5":13819,"_26493":51370,"_2816":51851},[],"Any → `Jitp`",{"_3328":1437,"_29138":1263,"_20209":51853,"_5":13819,"_26493":51370,"_2816":51854},[],"`iot:CreateProvisioningTemplate` (non-idempotent: it fails when the template already exists; after 3 retries the event lands in `lamassu-dlq`)",{"_3328":1438,"_29138":1263,"_20209":51856,"_5":13819,"_26493":51370,"_2816":51857},[],"`Jitp` → `None` / `Auto`",{"_3328":1439,"_29138":1263,"_20209":51859,"_5":13819,"_26493":51370,"_2816":51860},[],"none (the template stays in the AWS account)",{"_3328":1440,"_29138":1263,"_20209":51862,"_5":13819,"_26493":51374,"_2816":51863},[],"Certificates holding the connector's metadata key sync their status; certificates provisioned via JITP have no metadata key and stay out of this machine:",{"_3328":1441,"_29138":1263,"_20209":51865,"_5":13819,"_26493":51374,"_2816":51797},[],{"_3328":1442,"_29138":1263,"_20209":51867,"_5":13819,"_26493":51374,"_2816":51800},[],{"_3328":1443,"_29138":1263,"_20209":51869,"_5":13819,"_26493":51374,"_2816":51870},[],"`NotSynced` → `Active`",{"_3328":1444,"_29138":1263,"_20209":51872,"_5":13819,"_26493":51374,"_2816":51514},[],{"_3328":1445,"_29138":1263,"_20209":51874,"_5":13819,"_26493":51374,"_2816":51875},[],"`Active` → `Inactive`",{"_3328":1446,"_29138":1263,"_20209":51877,"_5":13819,"_26493":51374,"_2816":51878},[],"`iot:UpdateCertificate` + forced MQTT disconnect",{"_3328":1447,"_29138":1263,"_20209":51880,"_5":13819,"_26493":51374,"_2816":51881},[],"`Active` → `Revoked`",{"_3328":1448,"_29138":1263,"_20209":51883,"_5":13819,"_26493":51374,"_2816":51878},[],{"_3328":1449,"_29138":1263,"_20209":51885,"_5":13819,"_26493":51374,"_2816":51886},[],"`Inactive` / `Revoked` → `Active`",{"_3328":1450,"_29138":1263,"_20209":51888,"_5":13819,"_26493":51374,"_2816":51514},[],{"_3328":1451,"_29138":1263,"_20209":51890,"_5":13819,"_26493":51374,"_2816":51891},[],"`RenewalWindow` / `AboutToExpire` / `Expired`",{"_3328":1452,"_29138":1263,"_20209":51893,"_5":13819,"_26493":51374,"_2816":51894},[],"none (these states are not synced to AWS)",{"_3328":1453,"_29138":1263,"_20209":51896,"_5":13819,"_26493":51378,"_2816":51897},[],"Things only exist under `auto` mode; in `jitp` mode AWS creates the Thing itself when the device first connects. The Thing name is always the device certificate's CN:",{"_3328":1454,"_29138":1263,"_20209":51899,"_5":13819,"_26493":51378,"_2816":51797},[],{"_3328":1455,"_29138":1263,"_20209":51901,"_5":13819,"_26493":51378,"_2816":51800},[],{"_3328":1456,"_29138":1263,"_20209":51903,"_5":13819,"_26493":51378,"_2816":51904},[],"`Absent` → `Provisioned`",{"_3328":1457,"_29138":1263,"_20209":51906,"_5":13819,"_26493":51378,"_2816":51907},[],"policies created/updated, Thing groups ensured, `iot:RegisterThing` (creates the Thing, registers the certificate, attaches policies)",{"_3328":1458,"_29138":1263,"_20209":51909,"_5":13819,"_26493":51378,"_2816":51910},[],"`Provisioned` → `Provisioned` (re-enrollment)",{"_3328":1459,"_29138":1263,"_20209":51912,"_5":13819,"_26493":51378,"_2816":51913},[],"stale principals marked `REVOKED`, new `iot:RegisterThing` run; the new certificate ARN replaces the old one in Lamassu metadata",{"_3328":1460,"_29138":1263,"_20209":51915,"_5":13819,"_26493":51378,"_2816":51916},[],"In `jitp` mode the connector makes no provisioning calls: AWS executes the JITP template on the device's first connection and creates the Thing, registers the certificate and activates it on its own.",{"_3328":1461,"_29138":1263,"_20209":51918,"_5":13819,"_26493":51382,"_2816":51919},[],"For devices to authenticate to AWS IoT Core with certificates issued by a Lamassu CA, that CA must first be registered in the AWS account. The connector handles this registration automatically in response to the `EventCreateCAKey`, `EventImportCAKey` and `EventUpdateCAMetadataKey` events, but the operation **only fires when the administrator explicitly requests it** through the CA metadata field.",{"_3328":1462,"_29138":1263,"_20209":51921,"_5":13819,"_26493":51386,"_2816":51922},[],"Registration is triggered by setting `registration.status = \"REQUESTED\"` on the `lamassu.io/iot/{connector_id}` key of the CA's metadata. This can be done from the Lamassu console in the CA management section or through the API.",{"_3328":1463,"_29138":1263,"_20209":51924,"_5":13819,"_26493":51386,"_2816":51925},[],"Once the event is received, the connector attempts to register the CA in AWS and updates the `registration.status` field in the CA's metadata with the result: `\"SUCCEEDED\"` if registration was successful, or `\"FAILED\"` with an error message otherwise. The process is asynchronous, so you must periodically check the metadata status until the operation completes.",{"_3328":1464,"_29138":1263,"_20209":51927,"_5":13819,"_26493":51390,"_2816":51928},[],"When the `primary_account` parameter is `true`, the connector runs the full registration flow with proof-of-possession of the private key:",{"_3328":1465,"_29138":1263,"_20209":51930,"_5":13819,"_26493":51390,"_2816":51931},[],"It calls `iot:GetRegistrationCode` to obtain AWS's verification code.",{"_3328":1466,"_29138":1263,"_20209":51933,"_5":13819,"_26493":51390,"_2816":51934},[],"The connector internally generates an ephemeral RSA-2048 key pair and builds a CSR whose Common Name is exactly that registration code. It then calls Lamassu's signing service so the registered CA issues a real X.509 verification certificate signing that CSR. The ephemeral private key is used only for this purpose and is neither stored nor sent to AWS.",{"_3328":1467,"_29138":1263,"_20209":51936,"_5":13819,"_26493":51390,"_2816":51937},[],"It sends the CA (in PEM) and the verification certificate to AWS via `iot:RegisterCACertificate`, enabling registration with `AllowAutoRegistration: true`.",{"_3328":1468,"_29138":1263,"_20209":51939,"_5":13819,"_26493":51390,"_2816":51940},[],"Only one account can own a CA in a given AWS region. If the CA is already registered with the same serial number, the connector silently skips the step.",{"_3328":1469,"_29138":1263,"_20209":51942,"_5":13819,"_26493":51390,"_2816":51943},[],"The tags AWS IoT Core applies to the registered CA certificate are `LMS.CA.ID`, `LMS.CA.SN` and `LMS.CA.CN`.",{"_3328":1470,"_29138":1263,"_20209":51945,"_5":13819,"_26493":51394,"_2816":51946},[],"When `primary_account` is `false`, the connector registers the CA using `CertificateMode: SNI_ONLY`. This mode requires no verification code or access to the CA's private key, so it is the right choice when the CA is managed from another AWS account or when the administrator does not hold the private key. It is the usual method to register the same CA in several AWS accounts simultaneously.",{"_3328":1471,"_29138":1263,"_20209":51948,"_5":13819,"_26493":51398,"_2816":51949},[],"Each DMS participating in the AWS IoT Core integration must have the metadata key `lamassu.io/iot/{connector_id}` configured. The most important field of that configuration is `registration_mode`, which determines how devices are provisioned in AWS.",{"_3328":1472,"_29138":1263,"_20209":51951,"_5":13819,"_26493":51398,"_2816":51952},[],"There are three registration modes, and the choice among them depends on the fleet's provisioning strategy.",{"_3328":1473,"_29138":1263,"_20209":51954,"_5":13819,"_26493":51402,"_2816":51955},[],"In this mode the connector **creates no Things, groups or policies** in AWS IoT Core. It only syncs certificate status (active, revoked, suspended) as it changes in Lamassu. It is the right mode when Thing provisioning in AWS is managed by an external system and Lamassu only needs to keep certificate status up to date.",{"_3328":1474,"_29138":1263,"_20209":51957,"_5":13819,"_26493":51406,"_2816":51958},[],"`auto` mode delegates full device provisioning in AWS to Lamassu at enrollment time. When the device successfully completes its EST enrollment and Lamassu emits the `EventBindDeviceIdentityKey` event, the connector automatically executes the following sequence:",{"_3328":1475,"_29138":1263,"_20209":51960,"_5":13819,"_26493":51406,"_2816":51961},[],"Creates or updates the IoT policies configured in the DMS.",{"_3328":1476,"_29138":1263,"_20209":51963,"_5":13819,"_26493":51406,"_2816":51964},[],"Creates the root group `LAMASSU` in the AWS account (if it does not exist) and the child groups configured in the DMS as subgroups of `LAMASSU`. If the groups already exist, the `ResourceAlreadyExistsException` error is ignored, making the operation idempotent.",{"_3328":1477,"_29138":1263,"_20209":51966,"_5":13819,"_26493":51406,"_2816":51967},[],"If the Thing already existed in AWS IoT Core, the connector iterates all certificates (principals) currently attached to that Thing and marks them as `REVOKED` in AWS, ensuring previous certificates cannot keep being used to authenticate.",{"_3328":1478,"_29138":1263,"_20209":51969,"_5":13819,"_26493":51406,"_2816":51970},[],"Calls `iot:RegisterThing` with a CloudFormation-style provisioning template that creates the Thing, registers the device's certificate (PEM of the device certificate and of the issuing CA certificate) and attaches the configured policies.",{"_3328":1479,"_29138":1263,"_20209":51972,"_5":13819,"_26493":51406,"_2816":51973},[],"Once provisioning completes, the connector stores the resulting certificate's ARN in the Lamassu certificate's metadata under the key `lamassu.io/iot/{connector_id}` and marks the device as `Registered: true` in Device Manager.",{"_3328":1480,"_29138":1263,"_20209":51975,"_5":13819,"_26493":51406,"_2816":51976},[],"**The Thing name in AWS is the Common Name (CN) of the device's certificate.** This convention is fundamental for the firmware developer: the `/CN=` value the device includes in its CSR when enrolling becomes the ThingName it must identify itself with in all MQTT operations against AWS IoT Core.",{"_3328":1481,"_29138":1263,"_20209":51978,"_5":13819,"_26493":51410,"_2816":51979},[],"Just-In-Time Provisioning (JITP) mode delegates provisioning to AWS instead of the connector doing it directly. When the connector detects the DMS is in `jitp` mode, it creates a JITP provisioning template in AWS IoT Core and attaches it to the registered CA certificate. The connector attempts to create this template when the DMS is created and again on every full DMS edit (`PUT /v1/dms/{id}`) — not at device enrollment time. The attempt is not idempotent: when a template named after the DMS ID already exists, the creation call fails, the event is retried three times and finally lands in the `lamassu-dlq` poison queue (see Troubleshooting). The template is created once; later DMS edits never update its content. A DMS update that omits `metadata` or sends `null` keeps the stored metadata, so the connector key `lamassu.io/iot/{connector_id}` remains present and the attempt is still triggered. A body that supplies a `metadata` object replaces the stored metadata entirely: if that object does not carry the connector key, the key is dropped and the connector silently skips the DMS's future events. Once the template is attached, when a device with a certificate issued by that CA connects to AWS IoT Core for the first time, AWS executes the template automatically: it creates the Thing, registers the certificate and activates it.",{"_3328":1482,"_29138":1263,"_20209":51981,"_5":13819,"_26493":51410,"_2816":51982},[],"The connector creates the template, named after the DMS ID, only once. Each later edit of the DMS that keeps the connector key tries to create it again and fails, because the connector does not update existing templates. Later changes to `jitp_config.provisioning_role_arn`, `jitp_config.enable_template` or to the groups and policies the template references must be applied by hand in AWS IoT Core.",{"_3328":1483,"_29138":1263,"_20209":51984,"_5":13819,"_26493":51410,"_2816":51985},[],"The failed event is retried and ends in `lamassu-dlq`. Groups and policies are registered before the failure, but the assignment of the template to the registered CA, the write-back of the ARN to the DMS and the shadow update when `ManagedCAs` changes are skipped.",{"_3328":1484,"_29138":1263,"_20209":51987,"_5":13819,"_26493":51410,"_2816":51988},[],"The Thing name in the JITP template is derived from `AWS::IoT::Certificate::CommonName`, which corresponds to the device certificate's CN — the same convention as `auto` mode.",{"_3328":1485,"_29138":1263,"_20209":51990,"_5":13819,"_26493":51410,"_2816":51991},[],"This mode requires the `jitp_config.provisioning_role_arn` field to be configured with the ARN of an IAM role AWS IoT Core can assume to execute the template. If not configured, the connector uses the default `arn:aws:iam::{account}:role/JITPRole` and logs a warning. The administrator must ensure that role exists in the account and has the necessary permissions before enabling JITP mode.",{"_3328":1486,"_29138":1263,"_20209":51993,"_5":13819,"_26493":51414,"_2816":51994},[],"For the firmware developer, `auto` mode is transparent: the device performs its EST enrollment as usual and, as a side effect, it is provisioned in AWS IoT Core with no additional step.",{"_3328":1487,"_29138":1263,"_20209":51996,"_5":13819,"_26493":51414,"_2816":51997},[],"The full flow from the device's perspective is:",{"_3328":1488,"_29138":1263,"_20209":51999,"_5":13819,"_26493":51414,"_2816":52000},[],"Once the connector completes provisioning, the device can connect to the AWS IoT Core MQTT endpoint using its private key and the certificate issued by Lamassu. The ThingName it must identify itself with in AWS is exactly the certificate's CN.",{"_3328":1489,"_29138":1263,"_20209":52002,"_5":13819,"_26493":51418,"_2816":52003},[],"In JITP mode the device also performs its EST enrollment conventionally and obtains its certificate from Lamassu. The difference is that AWS IoT Core does not know the device until it attempts its first connection.",{"_3328":1490,"_29138":1263,"_20209":52005,"_5":13819,"_26493":51418,"_2816":52006},[],"When the device establishes its first MQTT connection to AWS IoT Core presenting the Lamassu-issued certificate, AWS detects that the certificate belongs to a CA registered with a JITP template, executes that template and creates the Thing automatically. The initial connection may fail or be delayed while the template runs; firmware must be prepared to retry the connection.",{"_3328":1491,"_29138":1263,"_20209":52008,"_5":13819,"_26493":51418,"_2816":52009},[],"For the JITP flow to work correctly:",{"_3328":1492,"_29138":1263,"_20209":52011,"_5":13819,"_26493":51418,"_2816":52012},[],"The CA must be registered in AWS in Primary Account mode (SNI-only mode does not support JITP).",{"_3328":1493,"_29138":1263,"_20209":52014,"_5":13819,"_26493":51418,"_2816":52015},[],"The IAM role configured in `jitp_config.provisioning_role_arn` must exist and have permissions to create Things, register certificates and attach policies in the AWS account.",{"_3328":1494,"_29138":1263,"_20209":52017,"_5":13819,"_26493":51418,"_2816":52018},[],"The device must present both its certificate and the issuing CA's certificate in the TLS handshake with AWS IoT Core.",{"_3328":1495,"_29138":1263,"_20209":52020,"_5":13819,"_26493":51418,"_2816":52021},[],"Certificates provisioned via JITP **do not have the connector's metadata key** (`lamassu.io/iot/{connector_id}`) in Lamassu. As a consequence, status changes of those certificates in Lamassu are not automatically synced to AWS through the state synchronization mechanism described in the next section.",{"_3328":1496,"_29138":1263,"_20209":52023,"_5":13819,"_26493":51422,"_2816":52024},[],"The connector listens for the `EventUpdateCertificateStatusKey` event and, when a certificate holding the connector's metadata key changes status in Lamassu, replicates that change in AWS IoT Core. The following table shows the status mapping:",{"_3328":1497,"_29138":1263,"_20209":52026,"_5":13819,"_26493":51422,"_2816":52027},[],"Status in Lamassu",{"_3328":1498,"_29138":1263,"_20209":52029,"_5":13819,"_26493":51422,"_2816":52030},[],"Revocation reason",{"_3328":1499,"_29138":1263,"_20209":52032,"_5":13819,"_26493":51422,"_2816":52033},[],"Status in AWS IoT Core",{"_3328":1500,"_29138":1263,"_20209":52035,"_5":13819,"_26493":51422,"_2816":52036},[],"`Active`",{"_3328":1501,"_29138":1263,"_20209":52038,"_5":13819,"_26493":51422,"_2816":52039},[],"None",{"_3328":1502,"_29138":1263,"_20209":52041,"_5":13819,"_26493":51422,"_2816":52042},[],"`ACTIVE`",{"_3328":1503,"_29138":1263,"_20209":52044,"_5":13819,"_26493":51422,"_2816":52045},[],"`Revoked`",{"_3328":1504,"_29138":1263,"_20209":52047,"_5":13819,"_26493":51422,"_2816":52048},[],"`certificateHold`",{"_3328":1505,"_29138":1263,"_20209":52050,"_5":13819,"_26493":51422,"_2816":52051},[],"`INACTIVE`",{"_3328":1506,"_29138":1263,"_20209":52053,"_5":13819,"_26493":51422,"_2816":52045},[],{"_3328":1507,"_29138":1263,"_20209":52055,"_5":13819,"_26493":51422,"_2816":52056},[],"Any other reason",{"_3328":1508,"_29138":1263,"_20209":52058,"_5":13819,"_26493":51422,"_2816":52059},[],"`REVOKED`",{"_3328":1509,"_29138":1263,"_20209":52061,"_5":13819,"_26493":51422,"_2816":52062},[],"Only the `Active` and `Revoked` states produce a call to `iot:UpdateCertificate`. The other lifecycle states of Lamassu (`RenewalWindow`, `AboutToExpire`, `Expired`) are not synced to AWS IoT Core; the certificate status in AWS remains unchanged until the status in Lamassu becomes `Active` or `Revoked`.",{"_3328":1510,"_29138":1263,"_20209":52064,"_5":13819,"_26493":51426,"_2816":52065},[],"When the connector marks a certificate as `REVOKED` or `INACTIVE` in AWS, it additionally performs a forced disconnect of the device. To do so it opens an MQTT connection over WebSocket (with SigV4 authentication using the connector's credentials) to the AWS IoT Core data endpoint, using the certificate's CN as the MQTT client identifier, and closes it immediately. This terminates any active MQTT session the device may have at that moment.",{"_3328":1511,"_29138":1263,"_20209":52067,"_5":13819,"_26493":51426,"_2816":52068},[],"This forced disconnect happens at the moment Lamassu records the status change. If the device tries to reconnect after the disconnect, AWS IoT Core will reject the connection because the certificate is already listed as `REVOKED` or `INACTIVE`.",{"_3328":1512,"_29138":1263,"_20209":52070,"_5":13819,"_26493":51426,"_2816":52071},[],"Certificates provisioned in JITP mode do not have this automatic sync, since they lack the connector's metadata key.",{"_3328":1513,"_29138":1263,"_20209":52073,"_5":13819,"_26493":51430,"_2816":52074},[],"The connector can write to the AWS IoT Core Device Shadow to send action signals to the device firmware. This feature is enabled per DMS with `shadow_config.enable: true`.",{"_3328":1514,"_29138":1263,"_20209":52076,"_5":13819,"_26493":51430,"_2816":52077},[],"If `shadow_config.shadow_name` holds a value, the connector uses a Named Shadow with that name; otherwise it uses the Classic Shadow (the Thing's default shadow).",{"_3328":1515,"_29138":1263,"_20209":52079,"_5":13819,"_26493":51434,"_2816":52080},[],"The connector writes to the `desired.identity_actions` field of the shadow document. Each entry contains a Unix timestamp in milliseconds. The device firmware must read this field and act accordingly.",{"_3328":1516,"_29138":1263,"_20209":52082,"_5":13819,"_26493":51434,"_2816":52083},[],"There are two action types:",{"_3328":1517,"_29138":1263,"_20209":52085,"_5":13819,"_26493":51434,"_2816":52086},[],"**`UPDATE_CERTIFICATE`**: written when a certificate's preventive renewal window activates — that is, when the `triggered` field of the preventive renewal delta flips from `false` to `true`. This action tells the device it must start the re-enrollment process to renew its certificate before it expires.",{"_3328":1518,"_29138":1263,"_20209":52088,"_5":13819,"_26493":51434,"_2816":52089},[],"**`UPDATE_TRUST_ANCHOR_LIST`**: written to all devices of a DMS when the DMS's `ManagedCAs` list changes. This action tells the device it must update its trusted CA store.",{"_3328":1519,"_29138":1263,"_20209":52091,"_5":13819,"_26493":51434,"_2816":52092},[],"The shadow write process consists of reading the current shadow (`iotdata:GetThingShadow`), merging the new actions with the existing ones and writing the result (`iotdata:UpdateThingShadow`). If the shadow does not exist, the connector creates it. After a successful write, the list of pending actions in the device's metadata in Lamassu is cleared.",{"_3328":1520,"_29138":1263,"_20209":52094,"_5":13819,"_26493":51438,"_2816":52095},[],"The connector creates and attaches the policies configured in the DMS. A typical policy for a device using MQTT and the Device Shadow has this structure:",{"_3328":1521,"_29138":1263,"_20209":52097,"_5":13819,"_26493":51438,"_2816":52098},[],"In the policy above, the `<AWS_REGION>` and `<AWS_ACCOUNT_ID>` placeholders must be replaced with the AWS region and the twelve-digit account identifier of the target account before applying the policy. The `${iot:Connection.Thing.ThingName}` variable automatically limits each permission to the Thing the device is connected as, following the principle of least privilege. The `${ShadowName}` variable in the shadow ARNs is a placeholder that must be replaced with the `shadow_config.shadow_name` value configured in the DMS; if the Classic Shadow is used, it can be simplified by removing the `name/${ShadowName}/` segment. AWS IoT policies do not support regex alternation; the `[name/${ShadowName}/]*` notation represents the optionality of that segment within ARN syntax constraints.",{"_3328":1522,"_29138":1263,"_20209":52100,"_5":13819,"_26493":51438,"_2816":52101},[],"The first statement lets the device connect using its ThingName as the MQTT identifier. The second authorizes publishing to the Thing's generic MQTT topic and to the shadow topics, needed so the device can update its reported state. The last two statements grant subscribe and receive permissions over the same topics, letting the device receive shadow updates (for example, the `UPDATE_CERTIFICATE` and `UPDATE_TRUST_ANCHOR_LIST` actions written by the connector).",{"_3328":1523,"_29138":1263,"_20209":52103,"_5":13819,"_26493":51442,"_2816":52104},[],"**Symptom:** The CA registration stays in `REQUESTED` indefinitely.",{"_3328":1524,"_29138":1263,"_20209":52106,"_5":13819,"_26493":51442,"_2816":52107},[],"**Cause:** The connector is not running or is not subscribed to the event bus. It can also indicate incorrect IAM credentials, insufficient permissions or that the metadata key was written with a wrong `connector_id`.",{"_3328":1525,"_29138":1263,"_20209":52109,"_5":13819,"_26493":51442,"_2816":52110},[],"**Resolution:** Verify the connector process is active and the logs show no AWS communication errors. Check the metadata field was written under the exact key `lamassu.io/iot/{connector_id}`. If the error persists, the connector will update the status to `FAILED` with a descriptive message in the CA metadata.",{"_3328":1526,"_29138":1263,"_20209":52112,"_5":13819,"_26493":51442,"_2816":52113},[],"**Symptom:** A certificate's status is not synced to AWS after a revocation.",{"_3328":1527,"_29138":1263,"_20209":52115,"_5":13819,"_26493":51442,"_2816":52116},[],"**Cause:** Most commonly the certificate was provisioned in JITP mode. JITP certificates lack the connector's metadata key and are outside the state synchronization mechanism. If the DMS is in `auto` mode, it may indicate the initial provisioning did not complete correctly and the AWS ARN was not stored in the certificate metadata.",{"_3328":1528,"_29138":1263,"_20209":52118,"_5":13819,"_26493":51442,"_2816":52119},[],"**Resolution:** For JITP certificates, migrate the DMS to `auto` mode and re-provision the affected devices. For `auto` mode certificates, verify the certificate has the AWS ARN stored in its metadata; if not, repeat the provisioning.",{"_3328":1529,"_29138":1263,"_20209":52121,"_5":13819,"_26493":51442,"_2816":52122},[],"**Symptom:** The forced disconnect does not terminate the device's MQTT session after revocation.",{"_3328":1530,"_29138":1263,"_20209":52124,"_5":13819,"_26493":51442,"_2816":52125},[],"**Cause:** The device uses an MQTT client ID different from the certificate's CN. The forced disconnect opens a connection using the CN as client ID; if the firmware uses another identifier, the disconnect does not affect that session.",{"_3328":1531,"_29138":1263,"_20209":52127,"_5":13819,"_26493":51442,"_2816":52128},[],"**Resolution:** Make sure the firmware uses exactly the certificate's CN as the MQTT client identifier. That CN matches the ThingName in AWS IoT Core.",{"_3328":1532,"_29138":1263,"_20209":52130,"_5":13819,"_26493":51442,"_2816":52131},[],"**Symptom:** The device receives `CLIENT_ID_REJECTED` when connecting to AWS IoT Core.",{"_3328":1533,"_29138":1263,"_20209":52133,"_5":13819,"_26493":51442,"_2816":52134},[],"**Cause:** The MQTT client ID does not match the ThingName, which is always the CN of the certificate issued by Lamassu.",{"_3328":1534,"_29138":1263,"_20209":52136,"_5":13819,"_26493":51442,"_2816":52137},[],"**Resolution:** Verify the firmware uses exactly the value of the CN field included in the enrollment CSR as the MQTT client identifier.",{"_3328":1535,"_29138":1263,"_20209":52139,"_5":13819,"_26493":51442,"_2816":52140},[],"**Symptom:** The device's first MQTT connection in JITP mode fails or times out.",{"_3328":1536,"_29138":1263,"_20209":52142,"_5":13819,"_26493":51442,"_2816":52143},[],"**Cause:** This is expected behavior while AWS executes the JITP template on the device's first connection.",{"_3328":1537,"_29138":1263,"_20209":52145,"_5":13819,"_26493":51442,"_2816":52146},[],"**Resolution:** Firmware must implement retries with exponential backoff for the first connection. If the failure persists beyond a few minutes, verify the IAM role configured in `jitp_config.provisioning_role_arn` exists in the account and has permissions to create Things, register certificates and attach policies.",{"_3328":1538,"_29138":1263,"_20209":52148,"_5":13819,"_26493":51442,"_2816":52149},[],"**Symptom:** The Device Shadow is not updated when it should be.",{"_3328":1539,"_29138":1263,"_20209":52151,"_5":13819,"_26493":51442,"_2816":52152},[],"**Cause:** The shadow feature is disabled in the DMS configuration, the connector's credentials lack IoT data-plane permissions, or the firmware reads a different shadow than the configured one.",{"_3328":1540,"_29138":1263,"_20209":52154,"_5":13819,"_26493":51442,"_2816":52155},[],"**Resolution:** Check that `shadow_config.enable` is `true` in the connector metadata for the corresponding DMS. If a Named Shadow is used, verify `shadow_config.shadow_name` holds the correct name and that the firmware reads that Named Shadow and not the Classic Shadow. Confirm the connector's credentials have `iotdata:GetThingShadow` and `iotdata:UpdateThingShadow` permissions.",{"_3328":1541,"_29138":1263,"_20209":52157,"_5":13819,"_26493":51442,"_2816":52158},[],"**Symptom:** After editing a DMS in `jitp` mode, DMS update messages appear in `lamassu-dlq`, or JITP configuration changes have no effect in AWS.",{"_3328":1542,"_29138":1263,"_20209":52160,"_5":13819,"_26493":51442,"_2816":52161},[],"**Cause:** Every full DMS edit (`PUT /v1/dms/{id}`) triggers a `CreateProvisioningTemplate` attempt for the template named after the DMS ID, and the call is not idempotent: when the template already exists, it fails, the event is retried three times and finally lands in `lamassu-dlq`. The connector’s later steps are skipped.",{"_3328":1543,"_29138":1263,"_20209":52163,"_5":13819,"_26493":51442,"_2816":52164},[],"**Resolution:** Check that the template named with the DMS ID exists in AWS IoT Core and that JITP enrollment works. If the JITP configuration was changed, apply it by hand to the AWS template.",{"_3328":1544,"_29138":1263,"_20209":52166,"_5":13819,"_26493":51442,"_2816":52167},[],"<Card title=\"Configure a DMS\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_3328":1545,"_29138":1263,"_20209":52169,"_5":13819,"_26493":51442,"_2816":52170},[],"<Card title=\"Device enrollment (EST)\" href=\"/docs/platform/iot-fleets/enrollment/overview\" />",{"_3328":1546,"_29138":1263,"_20209":52172,"_5":13819,"_26493":51442,"_2816":52173},[],"<Card title=\"Certificate management\" href=\"/docs/platform/pki/certificates\" />",{"_3328":1547,"_29138":1547,"_5":14177,"_2816":49873,"_29461":52175,"_20209":52176,"_26493":1547},[47397,48865,49873],[],{"_3328":1548,"_29138":1547,"_20209":52178,"_5":13819,"_26493":1547,"_2816":52179},[],"Organize devices and their identities, prepare enrollment and integrate consumers.",{"_3328":1549,"_29138":1547,"_5":29458,"_20209":52181,"_26493":52182,"_2816":52183},[],"/docs/platform/iot-fleets/overview#start-here","Start here",{"_3328":1550,"_29138":1547,"_5":29458,"_20209":52185,"_26493":52186,"_2816":49871},[],"/docs/platform/iot-fleets/overview#devices-and-identities",{"_3328":1551,"_29138":1547,"_5":29458,"_20209":52188,"_26493":52189,"_2816":50054},[],"/docs/platform/iot-fleets/overview#enrollment-with-pki",{"_3328":1552,"_29138":1547,"_5":29458,"_20209":52191,"_26493":52192,"_2816":51335},[],"/docs/platform/iot-fleets/overview#integrations",{"_3328":1553,"_29138":1547,"_5":29458,"_20209":52194,"_26493":52195,"_2816":52196},[],"/docs/platform/iot-fleets/overview#who-prepares-each-part","Who prepares each part",{"_3328":1554,"_29138":1547,"_20209":52198,"_5":13819,"_26493":1547,"_2816":52199},[],"IoT Fleets applies PKI to the device lifecycle: registration, obtaining an identity, renewal and retirement. It is intended for those who administer a device population and those who integrate its enrollment client or the system that accepts it.",{"_3328":1555,"_29138":1547,"_20209":52201,"_5":13819,"_26493":52182,"_2816":52202},[],"Follow Enroll and connect your first device to prepare a DMS, obtain the identity from the client and demonstrate an mTLS connection. The automatic path includes initial trust, a CSR and result checks.",{"_3328":1556,"_29138":1547,"_20209":52204,"_5":13819,"_26493":52182,"_2816":52205},[],"To start with an existing certificate, use Register a device manually. You can then prepare enrollment and renewal for the next device.",{"_3328":1557,"_29138":1547,"_20209":52207,"_5":13819,"_26493":52186,"_2816":52208},[],"Resource",{"_3328":1558,"_29138":1547,"_20209":52210,"_5":13819,"_26493":52186,"_2816":52211},[],"What it represents",{"_3328":1559,"_29138":1547,"_20209":52213,"_5":13819,"_26493":52186,"_2816":52214},[],"**Device**",{"_3328":1560,"_29138":1547,"_20209":52216,"_5":13819,"_26493":52186,"_2816":52217},[],"An inventory entry with an identifier, owning DMS and classification.",{"_3328":1561,"_29138":1547,"_20209":52219,"_5":13819,"_26493":52186,"_2816":52220},[],"**Identity**",{"_3328":1562,"_29138":1547,"_20209":52222,"_5":13819,"_26493":52186,"_2816":52223},[],"The device's association with its certificates: an active version and a history.",{"_3328":1563,"_29138":1547,"_20209":52225,"_5":13819,"_26493":52186,"_2816":52226},[],"**DMS**",{"_3328":1564,"_29138":1547,"_20209":52228,"_5":13819,"_26493":52186,"_2816":52229},[],"The service that configures admission, enrollment, renewal and trust distribution.",{"_3328":1565,"_29138":1547,"_20209":52231,"_5":13819,"_26493":52186,"_2816":52232},[],"**Fleet**",{"_3328":1566,"_29138":1547,"_20209":52234,"_5":13819,"_26493":52186,"_2816":52235},[],"The population you operate, represented through devices, DMSs, tags and metadata.",{"_3328":1567,"_29138":1547,"_20209":52237,"_5":13819,"_26493":52186,"_2816":52238},[],"Each device has an owning DMS. You can organize a population through several DMSs when it needs different policies, and use tags to classify it. “Fleet” describes that operational context; the resources you create and query are DMSs and devices.",{"_3328":1568,"_29138":1547,"_20209":52240,"_5":13819,"_26493":52186,"_2816":52241},[],"Device management covers states, certificate history and identity actions. During renewal, retain the relationship with the device and check which certificate becomes the current identity.",{"_3328":1569,"_29138":1547,"_20209":52243,"_5":13819,"_26493":52189,"_2816":52244},[],"This section connects PKI rules to the device client. Preparation follows this order:",{"_3328":1570,"_29138":1547,"_20209":52246,"_5":13819,"_26493":52189,"_2816":52247},[],"**CA and profile:** prepare the issuer and certificate rules in PKI.",{"_3328":1571,"_29138":1547,"_20209":52249,"_5":13819,"_26493":52189,"_2816":52250},[],"**DMS policy:** define how the device is admitted, how requests authenticate and which trust is distributed.",{"_3328":1572,"_29138":1547,"_20209":52252,"_5":13819,"_26493":52189,"_2816":52253},[],"**Client:** prepare the initial credential, server trust, and key generation or custody.",{"_3328":1573,"_29138":1547,"_20209":52255,"_5":13819,"_26493":52189,"_2816":52256},[],"**Result:** request the certificate, install it and check its association with the device.",{"_3328":1574,"_29138":1547,"_20209":52258,"_5":13819,"_26493":52189,"_2816":52259},[],"**Continuity:** configure renewal, successor installation and recovery according to DMS policy.",{"_3328":1575,"_29138":1547,"_20209":52261,"_5":13819,"_26493":52189,"_2816":52262},[],"<Card title=\"Configure the DMS\" description=\"Prepare the CA, admission, authentication and renewal rules.\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_3328":1576,"_29138":1547,"_20209":52264,"_5":13819,"_26493":52189,"_2816":52265},[],"<Card title=\"Integrate the EST client\" description=\"Review the device endpoints, formats and checks.\" href=\"/docs/platform/iot-fleets/enrollment/est-client\" />",{"_3328":1577,"_29138":1547,"_20209":52267,"_5":13819,"_26493":52192,"_2816":52268},[],"An issued identity needs a consumer that trusts its issuer, validates the certificate and grants the device permissions. Prepare both the device's trust in the server and the server's trust in the device.",{"_3328":1578,"_29138":1547,"_20209":52270,"_5":13819,"_26493":52192,"_2816":52271},[],"The AWS IoT Core guide explains how to use the identity in that destination. Provisioning in Lamassu and provisioning in the destination are separate decisions; review the conditions of the chosen mode before expecting state synchronization.",{"_3328":1579,"_29138":1547,"_20209":52273,"_5":13819,"_26493":52195,"_2816":52274},[],"Participant",{"_3328":1580,"_29138":1547,"_20209":52276,"_5":13819,"_26493":52195,"_2816":52277},[],"Responsibility",{"_3328":1581,"_29138":1547,"_20209":52279,"_5":13819,"_26493":52195,"_2816":52280},[],"PKI administrator",{"_3328":1582,"_29138":1547,"_20209":52282,"_5":13819,"_26493":52195,"_2816":52283},[],"CA, issuance profile, chain and revocation publication.",{"_3328":1583,"_29138":1547,"_20209":52285,"_5":13819,"_26493":52195,"_2816":52286},[],"Provisioning administrator",{"_3328":1584,"_29138":1547,"_20209":52288,"_5":13819,"_26493":52195,"_2816":52289},[],"DMS, admission, authentication per operation and inventory.",{"_3328":1585,"_29138":1547,"_20209":52291,"_5":13819,"_26493":52195,"_2816":52292},[],"Device integrator",{"_3328":1586,"_29138":1547,"_20209":52294,"_5":13819,"_26493":52195,"_2816":52295},[],"Initial credential, key, EST client, trust and certificate installation.",{"_3328":1587,"_29138":1547,"_20209":52297,"_5":13819,"_26493":52195,"_2816":52298},[],"Consumer integrator",{"_3328":1588,"_29138":1547,"_20209":52300,"_5":13819,"_26493":52195,"_2816":52301},[],"Trusted issuers, validation and device permissions in the destination.",{"_3328":1589,"_29138":1547,"_20209":52303,"_5":13819,"_26493":52195,"_2816":52304},[],"Permissions and audit are shared with the rest of Platform. Prepare installation and instance connectivity in Deployment.",{"_3328":1590,"_29138":1590,"_5":14177,"_2816":52306,"_29461":52307,"_20209":52309,"_26493":1590},"Enroll and connect your first device",[47397,48865,49873,52308],"Getting started",[],{"_3328":1591,"_29138":1590,"_20209":52311,"_5":13819,"_26493":1590,"_2816":52312},[],"Obtain an identity through EST, verify its association and use it in an mTLS connection.",{"_3328":1592,"_29138":1590,"_5":29458,"_20209":52314,"_26493":52315,"_2816":47407},[],"/docs/platform/iot-fleets/quickstarts/enroll-device#before-you-begin",{"_3328":1593,"_29138":1590,"_5":29458,"_20209":52317,"_26493":52318,"_2816":52319},[],"/docs/platform/iot-fleets/quickstarts/enroll-device#prepare-the-bootstrap-credential","Prepare the bootstrap credential",{"_3328":1594,"_29138":1590,"_5":29458,"_20209":52321,"_26493":52322,"_2816":52323},[],"/docs/platform/iot-fleets/quickstarts/enroll-device#configure-the-evaluation-dms","Configure the evaluation DMS",{"_3328":1595,"_29138":1590,"_5":29458,"_20209":52325,"_26493":52326,"_2816":52327},[],"/docs/platform/iot-fleets/quickstarts/enroll-device#prepare-the-client-and-check-cacerts","Prepare the client and check cacerts",{"_3328":1596,"_29138":1590,"_5":29458,"_20209":52329,"_26493":52330,"_2816":52331},[],"/docs/platform/iot-fleets/quickstarts/enroll-device#enroll-the-device","Enroll the device",{"_3328":1597,"_29138":1590,"_5":29458,"_20209":52333,"_26493":52334,"_2816":52335},[],"/docs/platform/iot-fleets/quickstarts/enroll-device#verify-the-obtained-identity","Verify the obtained identity",{"_3328":1598,"_29138":1590,"_5":29458,"_20209":52337,"_26493":52338,"_2816":52339},[],"/docs/platform/iot-fleets/quickstarts/enroll-device#demonstrate-an-mtls-connection","Demonstrate an mTLS connection",{"_3328":1599,"_29138":1590,"_5":29458,"_20209":52341,"_26493":52342,"_2816":52343},[],"/docs/platform/iot-fleets/quickstarts/enroll-device#result-and-continuity","Result and continuity",{"_3328":1600,"_29138":1590,"_20209":52345,"_5":13819,"_26493":1590,"_2816":52346},[],"Prepare an evaluation DMS, enroll `est-device-001` from the client and use its identity with a local consumer that requires a certificate. The path connects administrator policy to the material the device actually installs.",{"_3328":1601,"_29138":1590,"_20209":52348,"_5":13819,"_26493":52315,"_2816":52349},[],"A Lamassu instance accessible through HTTPS and permissions for CAs, profiles, DMSs and reading devices/certificates.",{"_3328":1602,"_29138":1590,"_20209":52351,"_5":13819,"_26493":52315,"_2816":52352},[],"Bash, OpenSSL 3.x, curl with `--fail-with-body` and two terminals on your computer. Work in a new directory with restricted access.",{"_3328":1603,"_29138":1590,"_20209":52354,"_5":13819,"_26493":52315,"_2816":52355},[],"An active root CA that issues directly, with an available key and sufficient validity. Follow Create your first CA. Save its verified public certificate as `device-root.pem`.",{"_3328":1604,"_29138":1590,"_20209":52357,"_5":13819,"_26493":52315,"_2816":52358},[],"Available global identifier `est-device-001`. This path uses automatic registration: do not create the device in the console first.",{"_3328":1605,"_29138":1590,"_20209":52360,"_5":13819,"_26493":52315,"_2816":52361},[],"The approved root for Lamassu HTTPS in `est-trust.pem`, obtained through an independent channel. It can differ from the device CA; prepare networking/TLS in Deployment.",{"_3328":1606,"_29138":1590,"_20209":52363,"_5":13819,"_26493":52318,"_2816":52364},[],"Issue a bootstrap leaf certificate with `CN=est-device-001`, its own key and Client Authentication use. Follow Issue and verify a certificate, changing its CN and saving the result as `bootstrap.crt` and `bootstrap.key`. Choose validity that covers this test and check the pair and chain.",{"_3328":1607,"_29138":1590,"_20209":52366,"_5":13819,"_26493":52318,"_2816":52367},[],"The same root CA can issue it for this isolated evaluation. The operational identity will have a different key and certificate. The matching CN makes the example easier to read; initial certificate authentication does not itself bind the bootstrap CN to the requested ID. Review admission before applying the policy to a population.",{"_3328":1608,"_29138":1590,"_20209":52369,"_5":13819,"_26493":52322,"_2816":52370},[],"Create an explicit leaf profile compatible with EC P-256, with **Honor Subject**, CN from the CSR, **Digital Signature**, **Client Authentication** and **1 hour** validity within the root's validity. Do not enable CA signing. Rules and precedence are explained in Profiles.",{"_3328":1609,"_29138":1590,"_20209":52372,"_5":13819,"_26493":52322,"_2816":52373},[],"Create the `Acme EST Evaluation` DMS with this configuration:",{"_3328":1610,"_29138":1590,"_20209":52375,"_5":13819,"_26493":52322,"_2816":52376},[],"Setting",{"_3328":1611,"_29138":1590,"_20209":52378,"_5":13819,"_26493":52322,"_2816":52379},[],"Evaluation value",{"_3328":1612,"_29138":1590,"_20209":52381,"_5":13819,"_26493":52322,"_2816":52382},[],"Enrollment CA",{"_3328":1613,"_29138":1590,"_20209":52384,"_5":13819,"_26493":52322,"_2816":52385},[],"Issuing root from `device-root.pem`.",{"_3328":1614,"_29138":1590,"_20209":52387,"_5":13819,"_26493":52322,"_2816":50184},[],{"_3328":1615,"_29138":1590,"_20209":52389,"_5":13819,"_26493":52322,"_2816":52390},[],"The 1-hour leaf profile you just prepared.",{"_3328":1616,"_29138":1590,"_20209":52392,"_5":13819,"_26493":52322,"_2816":52393},[],"Protocol / Registration Mode",{"_3328":1617,"_29138":1590,"_20209":52395,"_5":13819,"_26493":52322,"_2816":52396},[],"`EST_RFC7030` / `JITP`.",{"_3328":1618,"_29138":1590,"_20209":52398,"_5":13819,"_26493":52322,"_2816":52399},[],"Verify CSR Signature",{"_3328":1619,"_29138":1590,"_20209":52401,"_5":13819,"_26493":52322,"_2816":52402},[],"Enabled.",{"_3328":1620,"_29138":1590,"_20209":52404,"_5":13819,"_26493":52322,"_2816":52405},[],"Enable Replaceable Enrollment",{"_3328":1621,"_29138":1590,"_20209":52407,"_5":13819,"_26493":52322,"_2816":52408},[],"Disabled; the ID must be new.",{"_3328":1622,"_29138":1590,"_20209":52410,"_5":13819,"_26493":52322,"_2816":52411},[],"Initial authentication",{"_3328":1623,"_29138":1590,"_20209":52413,"_5":13819,"_26493":52322,"_2816":52414},[],"`CLIENT_CERTIFICATE`; Validation CAs includes the direct bootstrap issuer; no expired certificates.",{"_3328":1624,"_29138":1590,"_20209":52416,"_5":13819,"_26493":52322,"_2816":52417},[],"Renewal authentication",{"_3328":1625,"_29138":1590,"_20209":52419,"_5":13819,"_26493":52322,"_2816":52420},[],"`CLIENT_CERTIFICATE`, configured in the independent re-enrollment block.",{"_3328":1626,"_29138":1590,"_20209":52422,"_5":13819,"_26493":52322,"_2816":52423},[],"Re-enrollment Validation CAs / Enable Expired Renewal",{"_3328":1627,"_29138":1590,"_20209":52425,"_5":13819,"_26493":52322,"_2816":52426},[],"Not needed for this direct issuance; the Enrollment CA is always trusted for re-enrollment / disabled.",{"_3328":1628,"_29138":1590,"_20209":52428,"_5":13819,"_26493":52322,"_2816":52429},[],"Re-enrollment Delta",{"_3328":1629,"_29138":1590,"_20209":52431,"_5":13819,"_26493":52322,"_2816":52432},[],"1 hour.",{"_3328":1630,"_29138":1590,"_20209":52434,"_5":13819,"_26493":52322,"_2816":52435},[],"Preventive / Critical Delta",{"_3328":1631,"_29138":1590,"_20209":52437,"_5":13819,"_26493":52322,"_2816":52438},[],"30 minutes / 10 minutes.",{"_3328":1632,"_29138":1590,"_20209":52440,"_5":13819,"_26493":52322,"_2816":52441},[],"Revoke on Re-enrollment",{"_3328":1633,"_29138":1590,"_20209":52443,"_5":13819,"_26493":52322,"_2816":52444},[],"Disabled to test the successor before retiring the previous identity.",{"_3328":1634,"_29138":1590,"_20209":52446,"_5":13819,"_26493":52322,"_2816":50192},[],{"_3328":1635,"_29138":1590,"_20209":52448,"_5":13819,"_26493":52322,"_2816":52449},[],"Disabled; the operational key is generated in the client.",{"_3328":1636,"_29138":1590,"_20209":52451,"_5":13819,"_26493":52322,"_2816":52452},[],"CA Distribution",{"_3328":1637,"_29138":1590,"_20209":52454,"_5":13819,"_26493":52322,"_2816":52455},[],"Include Enrollment CA enabled; Include Lamassu System CA disabled.",{"_3328":1638,"_29138":1590,"_20209":52457,"_5":13819,"_26493":52322,"_2816":52458},[],"Equal duration and window allow immediate renewal testing. These are evaluation values; size production settings according to connectivity and recovery times. Save, reread both authentication blocks and retain the DMS ID. The console exposes independent editors for the enrollment and re-enrollment authentication; the DMS guide describes their fields, and you can also check the resource through the DMS API.",{"_3328":1639,"_29138":1590,"_20209":52460,"_5":13819,"_26493":52326,"_2816":52461},[],"Place the four trust and bootstrap files in the new directory. Replace the URL with your installation's URL:",{"_3328":1640,"_29138":1590,"_20209":52463,"_5":13819,"_26493":52326,"_2816":52464},[],"The download must succeed and contain the expected enrollment root. Compare its fingerprint with `device-root.pem`. This check does not turn the response into initial trust or prove that you can issue.",{"_3328":1641,"_29138":1590,"_20209":52466,"_5":13819,"_26493":52330,"_2816":52467},[],"Generate a new key and CSR with the selected identifier:",{"_3328":1642,"_29138":1590,"_20209":52469,"_5":13819,"_26493":52330,"_2816":52470},[],"Request the identity with the bootstrap credential and extract the certificate from the default response:",{"_3328":1643,"_29138":1590,"_20209":52472,"_5":13819,"_26493":52330,"_2816":52473},[],"If curl fails, use Troubleshooting with the saved body. Do not convert it or repeat the request without querying inventory: a timeout or error can follow persisted issuance.",{"_3328":1644,"_29138":1590,"_20209":52475,"_5":13819,"_26493":52334,"_2816":52476},[],"Expect `device.crt: OK` and exit code 0 from `cmp`. Check the CN, serial, dates, Digital Signature and Client Authentication. The certificate must be a leaf: it must not declare `CA:TRUE` or Certificate Sign use. Check that its validity matches the one-hour profile.",{"_3328":1645,"_29138":1590,"_20209":52478,"_5":13819,"_26493":52334,"_2816":52479},[],"In Lamassu, open `est-device-001`. It must be created with the intended owning DMS, a current identity and the received certificate in its history. Compare the local serial with the slot; thresholds can show a renewal state rather than simply Active.",{"_3328":1646,"_29138":1590,"_20209":52481,"_5":13819,"_26493":52338,"_2816":52482},[],"In a second terminal, enter the same directory and run `umask 077`. Create a local server certificate and start a test consumer. This server trusts `device-root.pem` and requires a valid client identity:",{"_3328":1647,"_29138":1590,"_20209":52484,"_5":13819,"_26493":52338,"_2816":52485},[],"Leave it running. In the first terminal, connect using the obtained identity:",{"_3328":1648,"_29138":1590,"_20209":52487,"_5":13819,"_26493":52338,"_2816":52488},[],"Expect HTTP `200`. The client's trust in this local server is its self-signed `consumer.crt`; the server verifies the device against `device-root.pem`. The HTML file displays OpenSSL diagnostic information.",{"_3328":1649,"_29138":1590,"_20209":52490,"_5":13819,"_26493":52338,"_2816":52491},[],"With the same server still running, test that a request without a client certificate is rejected:",{"_3328":1650,"_29138":1590,"_20209":52493,"_5":13819,"_26493":52338,"_2816":52494},[],"Rejection must correspond to a missing certificate at the server, not a stopped server. Stop the consumer with Ctrl+C after the test. This exercise demonstrates TLS authentication and key possession; your application must also define authorization and revocation consumption. Server options are described in openssl-s\\_server.",{"_3328":1651,"_29138":1590,"_20209":52496,"_5":13819,"_26493":52342,"_2816":52497},[],"Check",{"_3328":1652,"_29138":1590,"_20209":52499,"_5":13819,"_26493":52342,"_2816":52500},[],"Expected result",{"_3328":1653,"_29138":1590,"_20209":52502,"_5":13819,"_26493":52342,"_2816":52503},[],"Registration",{"_3328":1654,"_29138":1590,"_20209":52505,"_5":13819,"_26493":52342,"_2816":52506},[],"ID created automatically and correct DMS.",{"_3328":1655,"_29138":1590,"_20209":52508,"_5":13819,"_26493":52342,"_2816":51761},[],{"_3328":1656,"_29138":1590,"_20209":52510,"_5":13819,"_26493":52342,"_2816":52511},[],"CN, profile, serial and key verified.",{"_3328":1657,"_29138":1590,"_20209":52513,"_5":13819,"_26493":52342,"_2816":52514},[],"Inventory",{"_3328":1658,"_29138":1590,"_20209":52516,"_5":13819,"_26493":52342,"_2816":52517},[],"Received serial visible as the current identity and in history.",{"_3328":1659,"_29138":1590,"_20209":52519,"_5":13819,"_26493":52342,"_2816":52520},[],"Consumer",{"_3328":1660,"_29138":1590,"_20209":52522,"_5":13819,"_26493":52342,"_2816":52523},[],"mTLS responds 200 with the identity and rejects a missing certificate.",{"_3328":1661,"_29138":1590,"_20209":52525,"_5":13819,"_26493":52342,"_2816":52526},[],"Continue with Renewal and recovery to request a successor pair within the window, install it and repeat the mTLS check. The consumer must use the new files in that test. After checking the successor, retire the previous certificate according to PKI policy; the example does not revoke it automatically.",{"_3328":1662,"_29138":1590,"_20209":52528,"_5":13819,"_26493":52342,"_2816":52529},[],"Devices and identities explains retirement and the limits of historical revocation. For a real destination, prepare consumer trust, validation and permissions; AWS IoT Core is an available integration.",{"_3328":1663,"_29138":1663,"_5":14177,"_2816":49889,"_29461":52531,"_20209":52532,"_26493":1663},[47397,48865,49873,52308],[],{"_3328":1664,"_29138":1663,"_20209":52534,"_5":13819,"_26493":1663,"_2816":52535},[],"Prepare a DMS, register a device and associate a verified certificate with its identity.",{"_3328":1665,"_29138":1663,"_5":29458,"_20209":52537,"_26493":52538,"_2816":47407},[],"/docs/platform/iot-fleets/quickstarts/register-device#before-you-begin",{"_3328":1666,"_29138":1663,"_5":29458,"_20209":52540,"_26493":52541,"_2816":52542},[],"/docs/platform/iot-fleets/quickstarts/register-device#prepare-the-dms","Prepare the DMS",{"_3328":1667,"_29138":1663,"_5":29458,"_20209":52544,"_26493":52545,"_2816":52546},[],"/docs/platform/iot-fleets/quickstarts/register-device#register-the-device","Register the device",{"_3328":1668,"_29138":1663,"_5":29458,"_20209":52548,"_26493":52549,"_2816":52550},[],"/docs/platform/iot-fleets/quickstarts/register-device#check-the-initial-status","Check the initial status",{"_3328":1669,"_29138":1663,"_5":29458,"_20209":52552,"_26493":52553,"_2816":52554},[],"/docs/platform/iot-fleets/quickstarts/register-device#assign-an-identity","Assign an identity",{"_3328":1670,"_29138":1663,"_5":29458,"_20209":52556,"_26493":52557,"_2816":52558},[],"/docs/platform/iot-fleets/quickstarts/register-device#verify-the-device","Verify the device",{"_3328":1671,"_29138":1663,"_5":29458,"_20209":52560,"_26493":52561,"_2816":52500},[],"/docs/platform/iot-fleets/quickstarts/register-device#expected-result",{"_3328":1672,"_29138":1663,"_5":29458,"_20209":52563,"_26493":52564,"_2816":52565},[],"/docs/platform/iot-fleets/quickstarts/register-device#if-the-result-fails","If the result fails",{"_3328":1673,"_29138":1663,"_5":29458,"_20209":52567,"_26493":52568,"_2816":52569},[],"/docs/platform/iot-fleets/quickstarts/register-device#automate-the-next-device","Automate the next device",{"_3328":1674,"_29138":1663,"_20209":52571,"_5":13819,"_26493":1663,"_2816":52572},[],"This path is intended for those starting to administer device identities. You will register `device-001` and assign an existing certificate to check the relationship between device, DMS and identity history.",{"_3328":1675,"_29138":1663,"_20209":52574,"_5":13819,"_26493":1663,"_2816":52575},[],"Assignment updates Lamassu's inventory. Install the key and certificate separately on the device; check the connection to a consumer in that destination's integration.",{"_3328":1676,"_29138":1663,"_20209":52577,"_5":13819,"_26493":52538,"_2816":52578},[],"An accessible instance and permission to administer DMSs, devices and certificate associations.",{"_3328":1677,"_29138":1663,"_20209":52580,"_5":13819,"_26493":52538,"_2816":52581},[],"An active CA with an available key. If one does not exist yet, follow Create your first CA.",{"_3328":1678,"_29138":1663,"_20209":52583,"_5":13819,"_26493":52538,"_2816":52584},[],"An active end-entity certificate from that CA whose `Common Name` is exactly `device-001`, together with its private key. Follow Issue and verify a certificate to obtain and check both.",{"_3328":1679,"_29138":1663,"_20209":52586,"_5":13819,"_26493":52538,"_2816":52587},[],"The identifier `device-001` available in the inventory. If you already used it, choose another and issue the certificate with that same `Common Name`.",{"_3328":1680,"_29138":1663,"_20209":52589,"_5":13819,"_26493":52541,"_2816":52590},[],"A DMS must exist before registering the device. If you already have a suitable one, check its CA and note its identifier; to create one:",{"_3328":1681,"_29138":1663,"_20209":52592,"_5":13819,"_26493":52541,"_2816":52593},[],"Open the DMS inventory and its creation action. Assign a recognizable name, such as `Acme Evaluation DMS`.",{"_3328":1682,"_29138":1663,"_20209":52595,"_5":13819,"_26493":52541,"_2816":52596},[],"In **Enrollment CA**, select the CA that issued `device.crt`.",{"_3328":1683,"_29138":1663,"_20209":52598,"_5":13819,"_26493":52541,"_2816":52599},[],"In **Registration Mode**, select `PRE_REGISTRATION` for the path that starts with explicit registration.",{"_3328":1684,"_29138":1663,"_20209":52601,"_5":13819,"_26493":52541,"_2816":52602},[],"In the authentication section, enable **Require client certificate** and leave **Call external webhook** off. Under **Require client certificate**, add the CA whose initial certificates you will accept to **Validation CAs**; for this evaluation, it can be the same CA. Keep **Verify CSR Signature** enabled and leave **Enable server-side key generation** off if you will not use it.",{"_3328":1685,"_29138":1663,"_20209":52604,"_5":13819,"_26493":52541,"_2816":52605},[],"Review renewal and trust distribution settings with the DMS guide, save the service and note its identifier.",{"_3328":1686,"_29138":1663,"_20209":52607,"_5":13819,"_26493":52541,"_2816":52608},[],"Reopen the DMS and confirm that the enrollment CA is the expected one and the service appears in inventory.",{"_3328":1687,"_29138":1663,"_20209":52610,"_5":13819,"_26493":52541,"_2816":52611},[],"These settings prepare DMS policy. The next steps register and assign through the console; they do not send an EST request or test admission through that protocol.",{"_3328":1688,"_29138":1663,"_20209":52613,"_5":13819,"_26493":52545,"_2816":52614},[],"Open **Managed Devices** and the registration action. Complete:",{"_3328":1689,"_29138":1663,"_20209":52616,"_5":13819,"_26493":52545,"_2816":52617},[],"**Device ID**: `device-001`.",{"_3328":1690,"_29138":1663,"_20209":52619,"_5":13819,"_26493":52545,"_2816":52620},[],"**Registration Authority**: the DMS you just prepared; this label identifies the service fulfilling the registration authority role.",{"_3328":1691,"_29138":1663,"_20209":52622,"_5":13819,"_26493":52545,"_2816":52623},[],"**Icon** and **Tags**: optional classification.",{"_3328":1692,"_29138":1663,"_20209":52625,"_5":13819,"_26493":52545,"_2816":52626},[],"Confirm registration.",{"_3328":1693,"_29138":1663,"_20209":52628,"_5":13819,"_26493":52549,"_2816":52629},[],"Open the device. It should appear in **No Identity** and show the selected owning DMS.",{"_3328":1694,"_29138":1663,"_20209":52631,"_5":13819,"_26493":52549,"_2816":52632},[],"Registration creates the inventory entry; the certificate must still be associated.",{"_3328":1695,"_29138":1663,"_20209":52634,"_5":13819,"_26493":52553,"_2816":52635},[],"Select **Assign Identity** and the existing certificate with `CN=device-001`. Check its serial number, issuer and validity against the certificate you verified in PKI.",{"_3328":1696,"_29138":1663,"_20209":52637,"_5":13819,"_26493":52553,"_2816":52638},[],"Confirm the association. The **Issue New Instead** alternative is explained in Devices and identities.",{"_3328":1697,"_29138":1663,"_20209":52640,"_5":13819,"_26493":52557,"_2816":52641},[],"Check that it has an active identity. In **Certificate History**, verify the associated serial number; in **Device Event Timeline**, find the assignment event.",{"_3328":1698,"_29138":1663,"_20209":52643,"_5":13819,"_26493":52557,"_2816":52644},[],"Keep the device identifier, owning DMS and serial number as references for the result.",{"_3328":1699,"_29138":1663,"_20209":52646,"_5":13819,"_26493":52561,"_2816":52497},[],{"_3328":1700,"_29138":1663,"_20209":52648,"_5":13819,"_26493":52561,"_2816":52649},[],"Result",{"_3328":1701,"_29138":1663,"_20209":52651,"_5":13819,"_26493":52561,"_2816":51744},[],{"_3328":1702,"_29138":1663,"_20209":52653,"_5":13819,"_26493":52561,"_2816":52654},[],"`device-001` appears in inventory with the expected DMS.",{"_3328":1703,"_29138":1663,"_20209":52656,"_5":13819,"_26493":52561,"_2816":52657},[],"Current identity",{"_3328":1704,"_29138":1663,"_20209":52659,"_5":13819,"_26493":52561,"_2816":52660},[],"The associated certificate matches the one you verified in PKI.",{"_3328":1705,"_29138":1663,"_20209":52662,"_5":13819,"_26493":52561,"_2816":52663},[],"History",{"_3328":1706,"_29138":1663,"_20209":52665,"_5":13819,"_26493":52561,"_2816":52666},[],"The associated issuance appears with its serial number and dates.",{"_3328":1707,"_29138":1663,"_20209":52668,"_5":13819,"_26493":52561,"_2816":52669},[],"Key and certificate",{"_3328":1708,"_29138":1663,"_20209":52671,"_5":13819,"_26493":52561,"_2816":52672},[],"You have the verified pair ready to install on the device.",{"_3328":1709,"_29138":1663,"_20209":52674,"_5":13819,"_26493":52564,"_2816":52675},[],"If you cannot select the DMS, confirm its creation and your read permissions.",{"_3328":1710,"_29138":1663,"_20209":52677,"_5":13819,"_26493":52564,"_2816":52678},[],"If no eligible certificate appears, check that its `Common Name` matches the `Device ID` exactly, it is active and it was issued by the expected CA.",{"_3328":1711,"_29138":1663,"_20209":52680,"_5":13819,"_26493":52564,"_2816":52681},[],"If assignment fails, review permissions and operation diagnostics before repeating it. Query the device and its history again to find the persisted result.",{"_3328":1712,"_29138":1663,"_20209":52683,"_5":13819,"_26493":52564,"_2816":52684},[],"If an expiration or renewal state appears, check certificate dates and DMS thresholds in Devices and identities.",{"_3328":1713,"_29138":1663,"_20209":52686,"_5":13819,"_26493":52568,"_2816":52687},[],"Continue with DMS and EST for the device to request and renew certificates. Prepare server trust, the initial credential and policies for each operation before implementing the client.",{"_3328":1714,"_29138":1663,"_20209":52689,"_5":13819,"_26493":52568,"_2816":52690},[],"For a path from the client through mTLS, follow Enroll and connect your first device with a new ID.",{"_3328":1715,"_29138":1663,"_20209":52692,"_5":13819,"_26493":52568,"_2816":52693},[],"To use the identity in AWS IoT Core, also prepare trust and permissions in the destination. Check the connection from the device after installing the required key, certificate and chain.",{"_3328":1716,"_29138":1716,"_5":14177,"_2816":52695,"_29461":52696,"_20209":52697,"_26493":1716},"Lamassu IoT Platform",[47397,48865],[],{"_3328":1717,"_29138":1716,"_20209":52699,"_5":13819,"_26493":1716,"_2816":52700},[],"Build a PKI and apply its certificates to your devices' lifecycle.",{"_3328":1718,"_29138":1716,"_5":29458,"_20209":52702,"_26493":52703,"_2816":52183},[],"/docs/platform/overview#start-here",{"_3328":1719,"_29138":1716,"_5":29458,"_20209":52705,"_26493":52706,"_2816":52707},[],"/docs/platform/overview#choose-your-path","Choose your path",{"_3328":1720,"_29138":1716,"_5":29458,"_20209":52709,"_26493":52710,"_2816":52711},[],"/docs/platform/overview#architecture-at-a-glance","Architecture at a glance",{"_3328":1721,"_29138":1716,"_5":29458,"_20209":52713,"_26493":52714,"_2816":52715},[],"/docs/platform/overview#core-capabilities","Core capabilities",{"_3328":1722,"_29138":1716,"_5":29458,"_20209":52717,"_26493":52718,"_2816":52719},[],"/docs/platform/overview#build-your-trust-hierarchy","Build your trust hierarchy",{"_3328":1723,"_29138":1716,"_5":29458,"_20209":52721,"_26493":52722,"_2816":52723},[],"/docs/platform/overview#protect-cryptographic-keys","Protect cryptographic keys",{"_3328":1724,"_29138":1716,"_5":29458,"_20209":52725,"_26493":52726,"_2816":52727},[],"/docs/platform/overview#issue-and-control-certificates","Issue and control certificates",{"_3328":1725,"_29138":1716,"_5":29458,"_20209":52729,"_26493":52730,"_2816":52731},[],"/docs/platform/overview#automate-device-identities","Automate device identities",{"_3328":1726,"_29138":1716,"_5":29458,"_20209":52733,"_26493":52734,"_2816":52735},[],"/docs/platform/overview#publish-validation-status","Publish validation status",{"_3328":1727,"_29138":1716,"_5":29458,"_20209":52737,"_26493":52738,"_2816":52739},[],"/docs/platform/overview#react-to-events","React to events",{"_3328":1728,"_29138":1716,"_5":29458,"_20209":52741,"_26493":52742,"_2816":52743},[],"/docs/platform/overview#operational-reference","Operational reference",{"_3328":1729,"_29138":1716,"_20209":52745,"_5":13819,"_26493":1716,"_2816":52746},[],"Lamassu IoT lets you administer a private PKI and use it to issue, renew and revoke X.509 device identities. The Platform documentation follows two paths: **PKI**, for authorities and certificates, and **IoT Fleets**, for applying those identities to a device population.",{"_3328":1730,"_29138":1716,"_20209":52748,"_5":13819,"_26493":52703,"_2816":52749},[],"Choose the result you need:",{"_3328":1731,"_29138":1716,"_20209":52751,"_5":13819,"_26493":52703,"_2816":52752},[],"<Card title=\"Issue and verify a certificate\" description=\"Prepare a CA, issue an X.509 identity and check its chain and key.\" href=\"/docs/platform/pki/quickstarts/overview\" />",{"_3328":1732,"_29138":1716,"_20209":52754,"_5":13819,"_26493":52703,"_2816":52755},[],"<Card title=\"Enroll and connect a device\" description=\"Prepare the DMS, request an identity through EST and check an mTLS connection.\" href=\"/docs/platform/iot-fleets/quickstarts/enroll-device\" />",{"_3328":1733,"_29138":1716,"_20209":52757,"_5":13819,"_26493":52703,"_2816":52758},[],"If you are still preparing the instance, start in Deployment. The Platform paths assume an accessible console and permission to perform the operations.",{"_3328":1734,"_29138":1716,"_20209":52760,"_5":13819,"_26493":52706,"_2816":52761},[],"Section",{"_3328":1735,"_29138":1716,"_20209":52763,"_5":13819,"_26493":52706,"_2816":52764},[],"What you manage",{"_3328":1736,"_29138":1716,"_20209":52766,"_5":13819,"_26493":52706,"_2816":52767},[],"Entry point",{"_3328":1737,"_29138":1716,"_20209":52769,"_5":13819,"_26493":52706,"_2816":52770},[],"**PKI**",{"_3328":1738,"_29138":1716,"_20209":52772,"_5":13819,"_26493":52706,"_2816":52773},[],"Keys, authorities, profiles, certificates and publication of revocation status.",{"_3328":1739,"_29138":1716,"_20209":52775,"_5":13819,"_26493":52706,"_2816":52776},[],"PKI overview",{"_3328":1740,"_29138":1716,"_20209":52778,"_5":13819,"_26493":52706,"_2816":52779},[],"**IoT Fleets**",{"_3328":1741,"_29138":1716,"_20209":52781,"_5":13819,"_26493":52706,"_2816":52782},[],"Devices, identity history, DMS policies, EST enrollment and integrations.",{"_3328":1742,"_29138":1716,"_20209":52784,"_5":13819,"_26493":52706,"_2816":52785},[],"IoT Fleets overview",{"_3328":1743,"_29138":1716,"_20209":52787,"_5":13819,"_26493":52706,"_2816":52788},[],"**Administration**",{"_3328":1744,"_29138":1716,"_20209":52790,"_5":13819,"_26493":52706,"_2816":52791},[],"Operator permissions, audit and event subscriptions.",{"_3328":1745,"_29138":1716,"_20209":52793,"_5":13819,"_26493":52706,"_2816":48863},[],{"_3328":1746,"_29138":1716,"_20209":52795,"_5":13819,"_26493":52706,"_2816":52796},[],"A CA determines who signs, and a profile defines what can be issued. The DMS applies admission and enrollment policy. The device retains its association with certificates, and the external consumer decides which identity it accepts.",{"_3328":1747,"_29138":1716,"_20209":52798,"_5":13819,"_26493":52710,"_2816":52799},[],"An identity's journey connects four responsibilities:",{"_3328":1748,"_29138":1716,"_20209":52801,"_5":13819,"_26493":52710,"_2816":52802},[],"The PKI administrator prepares the authority, its key and issuance rules.",{"_3328":1749,"_29138":1716,"_20209":52804,"_5":13819,"_26493":52710,"_2816":52805},[],"The provisioning administrator configures the DMS and initial trust.",{"_3328":1750,"_29138":1716,"_20209":52807,"_5":13819,"_26493":52710,"_2816":52808},[],"The device client requests a certificate and installs it with the matching key.",{"_3328":1751,"_29138":1716,"_20209":52810,"_5":13819,"_26493":52710,"_2816":52811},[],"The consumer validates the identity and applies its access permissions.",{"_3328":1752,"_29138":1716,"_20209":52813,"_5":13819,"_26493":52710,"_2816":52814},[],"See How Lamassu works to understand the resources and platform architecture for the services. Installation, network exposure and dependencies are explained in Deployment.",{"_3328":1753,"_29138":1716,"_20209":52816,"_5":13819,"_26493":52718,"_2816":52817},[],"Create or incorporate authorities and organize their relationships in PKI. The hierarchy and its rotation determine which chains consumers must recognize.",{"_3328":1754,"_29138":1716,"_20209":52819,"_5":13819,"_26493":52722,"_2816":52820},[],"Choose the engine that keeps authority keys and control who can use them. See Keys and engines; provider setup belongs to deployment.",{"_3328":1755,"_29138":1716,"_20209":52822,"_5":13819,"_26493":52726,"_2816":52823},[],"Define issuance profiles, sign requests and review the certificate inventory. Check the issued certificate from the client that will use it.",{"_3328":1756,"_29138":1716,"_20209":52825,"_5":13819,"_26493":52730,"_2816":52826},[],"Configure a DMS and use EST to request and renew certificates. Preparing the initial credential and installing the result belong to device integration.",{"_3328":1757,"_29138":1716,"_20209":52828,"_5":13819,"_26493":52734,"_2816":52829},[],"Use OCSP and CRL to publish revocation status. Each consumer must configure how it retrieves and applies that information.",{"_3328":1758,"_29138":1716,"_20209":52831,"_5":13819,"_26493":52738,"_2816":52832},[],"Use audit logs to investigate changes and configure alerts and subscriptions to react to lifecycle events.",{"_3328":1759,"_29138":1716,"_20209":52834,"_5":13819,"_26493":52742,"_2816":52277},[],{"_3328":1760,"_29138":1716,"_20209":52836,"_5":13819,"_26493":52742,"_2816":52837},[],"What it prepares or checks",{"_3328":1761,"_29138":1716,"_20209":52839,"_5":13819,"_26493":52742,"_2816":52280},[],{"_3328":1762,"_29138":1716,"_20209":52841,"_5":13819,"_26493":52742,"_2816":52842},[],"Key custody, CA hierarchy, profiles and validation.",{"_3328":1763,"_29138":1716,"_20209":52844,"_5":13819,"_26493":52742,"_2816":52845},[],"Fleet administrator",{"_3328":1764,"_29138":1716,"_20209":52847,"_5":13819,"_26493":52742,"_2816":52848},[],"DMS, device admission, renewal policy and inventory.",{"_3328":1765,"_29138":1716,"_20209":52850,"_5":13819,"_26493":52742,"_2816":52292},[],{"_3328":1766,"_29138":1716,"_20209":52852,"_5":13819,"_26493":52742,"_2816":52853},[],"Initial credential, server trust, EST client, and key and certificate storage.",{"_3328":1767,"_29138":1716,"_20209":52855,"_5":13819,"_26493":52742,"_2816":52298},[],{"_3328":1768,"_29138":1716,"_20209":52857,"_5":13819,"_26493":52742,"_2816":52858},[],"Issuer trust, certificate validation and permissions in the destination.",{"_3328":1769,"_29138":1716,"_20209":52860,"_5":13819,"_26493":52742,"_2816":52861},[],"Infrastructure operator",{"_3328":1770,"_29138":1716,"_20209":52863,"_5":13819,"_26493":52742,"_2816":52864},[],"Installation, network, availability, dependencies and deployment diagnosis.",{"_3328":1771,"_29138":1716,"_20209":52866,"_5":13819,"_26493":52742,"_2816":52867},[],"The API reference contains contracts for automating operations. To investigate a failure, start in the affected section: PKI, EST or Deployment.",{"_3328":1772,"_29138":1772,"_5":14177,"_2816":52869,"_29461":52870,"_20209":52873,"_26493":1772},"CA hierarchy and rotation",[47397,48865,52871,52872],"PKI","Keys, authorities and certificates",[],{"_3328":1773,"_29138":1772,"_20209":52875,"_5":13819,"_26493":1772,"_2816":52876},[],"Design root and intermediate authorities and replace certificates or keys without breaking trust.",{"_3328":1774,"_29138":1772,"_5":29458,"_20209":52878,"_26493":52879,"_2816":52880},[],"/docs/platform/pki/ca-hierarchy-and-rotation#design-the-hierarchy","Design the hierarchy",{"_3328":1775,"_29138":1772,"_5":29458,"_20209":52882,"_26493":52883,"_2816":52884},[],"/docs/platform/pki/ca-hierarchy-and-rotation#reissuance-and-rotation-are-not-the-same","Reissuance and rotation are not the same",{"_3328":1776,"_29138":1772,"_5":29458,"_20209":52886,"_26493":52887,"_2816":52888},[],"/docs/platform/pki/ca-hierarchy-and-rotation#when-to-choose-each-operation","When to choose each operation",{"_3328":1777,"_29138":1772,"_5":29458,"_20209":52890,"_26493":52891,"_2816":52892},[],"/docs/platform/pki/ca-hierarchy-and-rotation#key-rotation-procedure","Key rotation procedure",{"_3328":1778,"_29138":1772,"_5":29458,"_20209":52894,"_26493":52895,"_2816":52896},[],"/docs/platform/pki/ca-hierarchy-and-rotation#inventory-the-dependencies","Inventory the dependencies",{"_3328":1779,"_29138":1772,"_5":29458,"_20209":52898,"_26493":52899,"_2816":52900},[],"/docs/platform/pki/ca-hierarchy-and-rotation#create-the-successor-ca","Create the successor CA",{"_3328":1780,"_29138":1772,"_5":29458,"_20209":52902,"_26493":52903,"_2816":52904},[],"/docs/platform/pki/ca-hierarchy-and-rotation#distribute-the-new-trust","Distribute the new trust",{"_3328":1781,"_29138":1772,"_5":29458,"_20209":52906,"_26493":52907,"_2816":52908},[],"/docs/platform/pki/ca-hierarchy-and-rotation#switch-issuance","Switch issuance",{"_3328":1782,"_29138":1772,"_5":29458,"_20209":52910,"_26493":52911,"_2816":52912},[],"/docs/platform/pki/ca-hierarchy-and-rotation#renew-in-batches","Renew in batches",{"_3328":1783,"_29138":1772,"_5":29458,"_20209":52914,"_26493":52915,"_2816":52916},[],"/docs/platform/pki/ca-hierarchy-and-rotation#close-the-overlap","Close the overlap",{"_3328":1784,"_29138":1772,"_5":29458,"_20209":52918,"_26493":52919,"_2816":52920},[],"/docs/platform/pki/ca-hierarchy-and-rotation#cascading-revocation","Cascading revocation",{"_3328":1785,"_29138":1772,"_5":29458,"_20209":52922,"_26493":52923,"_2816":52924},[],"/docs/platform/pki/ca-hierarchy-and-rotation#checks-after-the-change","Checks after the change",{"_3328":1786,"_29138":1772,"_20209":52926,"_5":13819,"_26493":1772,"_2816":52927},[],"The hierarchy determines the blast radius of any error or compromise. A root signs intermediate CAs; intermediates issue the identities used by devices and services. This separation lets you isolate environments and rotate a branch without replacing all trust.",{"_3328":1787,"_29138":1772,"_20209":52929,"_5":13819,"_26493":1772,"_2816":52930},[],"This procedure is for the PKI operator replacing an authority in use. You need access to CAs, keys and profiles, a dependency inventory and coordination with trust-store and device owners. Before switching issuance, prepare a test cohort and decide the criterion for ending overlap.",{"_3328":1788,"_29138":1772,"_20209":52932,"_5":13819,"_26493":52879,"_2816":52933},[],"For a production installation, use a very restricted root and one or more operational intermediates. Separate intermediates when any of these boundaries change:",{"_3328":1789,"_29138":1772,"_20209":52935,"_5":13819,"_26493":52879,"_2816":52936},[],"environment, such as production and preproduction;",{"_3328":1790,"_29138":1772,"_20209":52938,"_5":13819,"_26493":52879,"_2816":52939},[],"owner or operating team;",{"_3328":1791,"_29138":1772,"_20209":52941,"_5":13819,"_26493":52879,"_2816":52942},[],"device family or manufacturing process;",{"_3328":1792,"_29138":1772,"_20209":52944,"_5":13819,"_26493":52879,"_2816":52945},[],"region or regulatory requirement;",{"_3328":1793,"_29138":1772,"_20209":52947,"_5":13819,"_26493":52879,"_2816":52948},[],"cryptographic engine or key policy;",{"_3328":1794,"_29138":1772,"_20209":52950,"_5":13819,"_26493":52879,"_2816":52951},[],"maintenance window and renewal cadence.",{"_3328":1795,"_29138":1772,"_20209":52953,"_5":13819,"_26493":52879,"_2816":52954},[],"Avoid deep hierarchies without a concrete need. Each level adds chain distribution, validation and one more certificate you must renew.",{"_3328":1796,"_29138":1772,"_20209":52956,"_5":13819,"_26493":52879,"_2816":52957},[],"A child CA and its end-entity certificates must expire before their issuer. Reserve a margin that allows distributing another chain and renewing dependent certificates.",{"_3328":1797,"_29138":1772,"_20209":52959,"_5":13819,"_26493":52883,"_2816":52960},[],"**Reissuing a CA** creates a new certificate over the existing key. Lamassu generates a CSR with that key, self-signs it if it is a root or asks the parent CA to sign it if it is subordinate. The new certificate becomes active and the CA points to its serial number; the old and new certificates are linked through metadata.",{"_3328":1798,"_29138":1772,"_20209":52962,"_5":13819,"_26493":52883,"_2816":52963},[],"**Rotating a CA** creates a successor key and authority. It is the right choice in the face of compromise, a cryptographic change, an engine migration or non-exportable key policies.",{"_3328":1799,"_29138":1772,"_20209":52965,"_5":13819,"_26493":52883,"_2816":52966},[],"Lamassu does not allow reissuing an already-revoked CA or a CA whose expiration date has passed. Plan ahead for both conditions.",{"_3328":1800,"_29138":1772,"_20209":52968,"_5":13819,"_26493":52887,"_2816":52969},[],"Reissue if the key is still trustworthy and you only need another validity period or an updated certificate.",{"_3328":1801,"_29138":1772,"_20209":52971,"_5":13819,"_26493":52887,"_2816":52972},[],"Rotate the key if compromise is suspected, the algorithm changes or you want to move custody to another engine.",{"_3328":1802,"_29138":1772,"_20209":52974,"_5":13819,"_26493":52887,"_2816":52975},[],"Create a parallel branch if you cannot update all consumers at the same time.",{"_3328":1803,"_29138":1772,"_20209":52977,"_5":13819,"_26493":52887,"_2816":52978},[],"Revoke immediately only when the risk of keeping the CA outweighs the impact of interrupting the fleet.",{"_3328":1804,"_29138":1772,"_20209":52980,"_5":13819,"_26493":52895,"_2816":52981},[],"Locate child CAs, issued certificates, DMSs, connectors and external trust stores. Include devices that may stay offline for weeks or months.",{"_3328":1805,"_29138":1772,"_20209":52983,"_5":13819,"_26493":52899,"_2816":52984},[],"Generate a new key in the planned engine, create the CA and assign it an explicit profile. Do not reuse the operational identifier to hide that it is a different generation.",{"_3328":1806,"_29138":1772,"_20209":52986,"_5":13819,"_26493":52903,"_2816":52987},[],"Add the new root or chain to consumers before issuing with it. If distributing through EST `/cacerts`, explicitly include the required managed CAs and inspect the content; including the issuer does not automatically include every intermediate. Install the new trust in a cohort and verify that it still accepts the previous identity.",{"_3328":1807,"_29138":1772,"_20209":52989,"_5":13819,"_26493":52907,"_2816":52990},[],"Update the enrollment CA and profile of the DMSs. While old-CA cohorts still renew, add the previous enrollment CA to each DMS's re-enrollment validation CAs (`reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`): the new enrollment CA is trusted automatically, but the old one was the enrollment CA and appears in no re-enrollment trust list, so without that entry its certificates can no longer renew. The DMS guide documents the setting.",{"_3328":1808,"_29138":1772,"_20209":52992,"_5":13819,"_26493":52911,"_2816":52993},[],"Migrate a small cohort, validate mTLS, OCSP and CRL from the consumer and expand progressively. Monitor which devices still present the old chain.",{"_3328":1809,"_29138":1772,"_20209":52995,"_5":13819,"_26493":52915,"_2816":52996},[],"Once no legitimate consumer depends on the previous authority, remove it from issuance, from the re-enrollment validation CAs and from the distributed CAs. Revoke it if policy requires it.",{"_3328":1810,"_29138":1772,"_20209":52998,"_5":13819,"_26493":52919,"_2816":52999},[],"Lamassu saves the CA’s revocation, then attempts to revoke child CAs and issued certificates with `CessationOfOperation`. Propagation continues recursively through child CAs. This is not a transaction over the whole hierarchy: some resources may have changed while other updates failed.",{"_3328":1811,"_29138":1772,"_20209":53001,"_5":13819,"_26493":52919,"_2816":53002},[],"Resources in `EXPIRED` state and resources already revoked for a final reason reject further status transitions. Per-descendant failures are logged; review the inventory and logs even when the parent operation completes.",{"_3328":1812,"_29138":1772,"_20209":53004,"_5":13819,"_26493":52919,"_2816":53005},[],"`CertificateHold` allows reactivating the parent while it is not expired, but does not restore child CAs or certificates permanently revoked during the cascade. Holding a CA therefore does not provide a reversible pause for its entire branch.",{"_3328":1813,"_29138":1772,"_20209":53007,"_5":13819,"_26493":52919,"_2816":53008},[],"Before closing the change, compare the original dependency inventory with final states and verify revocation publication for each issuer. Do not use revocation as the ordinary mechanism to stop issuance: complete migration and remove the CA from operational flows.",{"_3328":1814,"_29138":1772,"_20209":53010,"_5":13819,"_26493":52923,"_2816":53011},[],"The new chain ends in an anchor installed by the consumer.",{"_3328":1815,"_29138":1772,"_20209":53013,"_5":13819,"_26493":52923,"_2816":53014},[],"New certificates contain the expected AKI, SKI, KU, EKU and SAN.",{"_3328":1816,"_29138":1772,"_20209":53016,"_5":13819,"_26493":52923,"_2816":53017},[],"The DMS delivers the correct chain through EST `/cacerts`.",{"_3328":1817,"_29138":1772,"_20209":53019,"_5":13819,"_26493":52923,"_2816":53020},[],"Re-enrollment accepts the old identity during the planned period.",{"_3328":1818,"_29138":1772,"_20209":53022,"_5":13819,"_26493":52923,"_2816":53023},[],"OCSP and CRL respond for the authorities that remain active.",{"_3328":1819,"_29138":1772,"_20209":53025,"_5":13819,"_26493":52923,"_2816":53026},[],"No DMS is left accidentally issuing from the old CA.",{"_3328":1820,"_29138":1772,"_20209":53028,"_5":13819,"_26493":52923,"_2816":53029},[],"See the Trust model to understand the DMS's CA sets and Certificate lifecycle for states and revocation effects.",{"_3328":1821,"_29138":1821,"_5":14177,"_2816":53031,"_29461":53032,"_20209":53033,"_26493":1821},"Certification authorities",[47397,48865,52871,52872],[],{"_3328":1822,"_29138":1821,"_20209":53035,"_5":13819,"_26493":1821,"_2816":53036},[],"Create, import and operate the authorities that establish your PKI's trust.",{"_3328":1823,"_29138":1821,"_5":29458,"_20209":53038,"_26493":53039,"_2816":53040},[],"/docs/platform/pki/certificate-authorities#choose-a-flow","Choose a flow",{"_3328":1824,"_29138":1821,"_5":29458,"_20209":53042,"_26493":53043,"_2816":53044},[],"/docs/platform/pki/certificate-authorities#create-a-new-authority","Create a new authority",{"_3328":1825,"_29138":1821,"_5":29458,"_20209":53046,"_26493":53047,"_2816":47407},[],"/docs/platform/pki/certificate-authorities#before-you-begin",{"_3328":1826,"_29138":1821,"_5":29458,"_20209":53049,"_26493":53050,"_2816":53051},[],"/docs/platform/pki/certificate-authorities#open-the-wizard","Open the wizard",{"_3328":1827,"_29138":1821,"_5":29458,"_20209":53053,"_26493":53054,"_2816":53055},[],"/docs/platform/pki/certificate-authorities#configure-the-key","Configure the key",{"_3328":1828,"_29138":1821,"_5":29458,"_20209":53057,"_26493":53058,"_2816":53059},[],"/docs/platform/pki/certificate-authorities#choose-the-ca-type","Choose the CA type",{"_3328":1829,"_29138":1821,"_5":29458,"_20209":53061,"_26493":53062,"_2816":53063},[],"/docs/platform/pki/certificate-authorities#define-the-identity","Define the identity",{"_3328":1830,"_29138":1821,"_5":29458,"_20209":53065,"_26493":53066,"_2816":53067},[],"/docs/platform/pki/certificate-authorities#configure-validity-and-uses","Configure validity and uses",{"_3328":1831,"_29138":1821,"_5":29458,"_20209":53069,"_26493":53070,"_2816":53071},[],"/docs/platform/pki/certificate-authorities#create-and-verify","Create and verify",{"_3328":1832,"_29138":1821,"_5":29458,"_20209":53073,"_26493":53074,"_2816":53075},[],"/docs/platform/pki/certificate-authorities#use-a-key-from-the-kms","Use a key from the KMS",{"_3328":1833,"_29138":1821,"_5":29458,"_20209":53077,"_26493":53078,"_2816":53079},[],"/docs/platform/pki/certificate-authorities#import-an-external-ca","Import an external CA",{"_3328":1834,"_29138":1821,"_5":29458,"_20209":53081,"_26493":53082,"_2816":53083},[],"/docs/platform/pki/certificate-authorities#select-the-engine","Select the engine",{"_3328":1835,"_29138":1821,"_5":29458,"_20209":53085,"_26493":53086,"_2816":53087},[],"/docs/platform/pki/certificate-authorities#load-the-material","Load the material",{"_3328":1836,"_29138":1821,"_5":29458,"_20209":53089,"_26493":53090,"_2816":53091},[],"/docs/platform/pki/certificate-authorities#define-the-default-issuance","Define the default issuance",{"_3328":1837,"_29138":1821,"_5":29458,"_20209":53093,"_26493":53094,"_2816":53095},[],"/docs/platform/pki/certificate-authorities#verify-the-import","Verify the import",{"_3328":1838,"_29138":1821,"_5":29458,"_20209":53097,"_26493":53098,"_2816":53099},[],"/docs/platform/pki/certificate-authorities#inspect-an-authority","Inspect an authority",{"_3328":1839,"_29138":1821,"_5":29458,"_20209":53101,"_26493":53102,"_2816":53103},[],"/docs/platform/pki/certificate-authorities#issue-certificates","Issue certificates",{"_3328":1840,"_29138":1821,"_5":29458,"_20209":53105,"_26493":53106,"_2816":53107},[],"/docs/platform/pki/certificate-authorities#revoke-a-ca","Revoke a CA",{"_3328":1841,"_29138":1821,"_5":29458,"_20209":53109,"_26493":53110,"_2816":53111},[],"/docs/platform/pki/certificate-authorities#assess-the-impact","Assess the impact",{"_3328":1842,"_29138":1821,"_5":29458,"_20209":53113,"_26493":53114,"_2816":53115},[],"/docs/platform/pki/certificate-authorities#start-the-revocation","Start the revocation",{"_3328":1843,"_29138":1821,"_5":29458,"_20209":53117,"_26493":53118,"_2816":53119},[],"/docs/platform/pki/certificate-authorities#confirm-the-identity","Confirm the identity",{"_3328":1844,"_29138":1821,"_5":29458,"_20209":53121,"_26493":53122,"_2816":53123},[],"/docs/platform/pki/certificate-authorities#check-the-publication","Check the publication",{"_3328":1845,"_29138":1821,"_5":29458,"_20209":53125,"_26493":53126,"_2816":53127},[],"/docs/platform/pki/certificate-authorities#delete-a-ca","Delete a CA",{"_3328":1846,"_29138":1821,"_20209":53129,"_5":13819,"_26493":1821,"_2816":53130},[],"A certification authority (CA) binds identities to public keys through signed certificates. In Lamassu you can create a new hierarchy, use a key already in the KMS or incorporate an external CA.",{"_3328":1847,"_29138":1821,"_20209":53132,"_5":13819,"_26493":1821,"_2816":53133},[],"To design a full chain or replace an authority in production, see CA hierarchy and rotation. If you need to standardize what each authority can sign, use Certificate profiles.",{"_3328":1848,"_29138":1821,"_20209":53135,"_5":13819,"_26493":1821,"_2816":53136},[],"To administer CAs, you need authority and key permissions, a reachable engine and a reviewed profile. An external consumer does not trust a CA merely because it appears in this inventory: agree root and chain distribution separately.",{"_3328":1849,"_29138":1821,"_20209":53138,"_5":13819,"_26493":53039,"_2816":53139},[],"**New CA with a new key:** create a root of trust from scratch. Lamassu generates and keeps the key pair.",{"_3328":1850,"_29138":1821,"_20209":53141,"_5":13819,"_26493":53039,"_2816":53142},[],"**New CA from the KMS:** reuse a key already registered in the platform.",{"_3328":1851,"_29138":1821,"_20209":53144,"_5":13819,"_26493":53039,"_2816":53145},[],"**Import a CA with its private key:** incorporate an external authority that Lamassu can issue with.",{"_3328":1852,"_29138":1821,"_20209":53147,"_5":13819,"_26493":53039,"_2816":53148},[],"**Import only the certificate:** register public material. If Lamassu finds its key in the KMS, it can associate it; otherwise, the CA has no usable key for issuance.",{"_3328":1853,"_29138":1821,"_20209":53150,"_5":13819,"_26493":53039,"_2816":53151},[],"First time here? Follow Create your first CA to complete the minimal journey.",{"_3328":1854,"_29138":1821,"_20209":53153,"_5":13819,"_26493":53047,"_2816":53154},[],"Decide whether the CA will be a root or an intermediate.",{"_3328":1855,"_29138":1821,"_20209":53156,"_5":13819,"_26493":53047,"_2816":53157},[],"Choose the engine that will keep the key.",{"_3328":1856,"_29138":1821,"_20209":53159,"_5":13819,"_26493":53047,"_2816":53160},[],"Define a validity longer than that of the certificates it will issue.",{"_3328":1857,"_29138":1821,"_20209":53162,"_5":13819,"_26493":53047,"_2816":53163},[],"For an intermediate CA, make sure the parent CA is active.",{"_3328":1858,"_29138":1821,"_20209":53165,"_5":13819,"_26493":53050,"_2816":53166},[],"In **Certification Authorities**, select **Create New CA** and choose to generate a new key pair.",{"_3328":1859,"_29138":1821,"_20209":53168,"_5":13819,"_26493":53054,"_2816":53169},[],"Select the cryptographic engine, the algorithm and the size or curve. Lamassu supports RSA and EC keys according to the engine's capabilities.",{"_3328":1860,"_29138":1821,"_20209":53171,"_5":13819,"_26493":53054,"_2816":53172},[],"Use only sizes and curves supported by the engine and the profile’s cryptographic policy. Read Keys and engines before reusing external material.",{"_3328":1861,"_29138":1821,"_20209":53174,"_5":13819,"_26493":53058,"_2816":53175},[],"Select **Root CA** for a self-signed authority or **Intermediate CA** for an authority signed by another CA. In the latter case, choose the issuing CA.",{"_3328":1862,"_29138":1821,"_20209":53177,"_5":13819,"_26493":53062,"_2816":53178},[],"Enter a unique **CA Name**. This name becomes the certificate's `Common Name`. Complete the Distinguished Name fields your policy requires:",{"_3328":1863,"_29138":1821,"_20209":53180,"_5":13819,"_26493":53062,"_2816":53181},[],"`C`: two-letter ISO 3166-1 country code.",{"_3328":1864,"_29138":1821,"_20209":53183,"_5":13819,"_26493":53062,"_2816":53184},[],"`ST`: state or province.",{"_3328":1865,"_29138":1821,"_20209":53186,"_5":13819,"_26493":53062,"_2816":53187},[],"`L`: locality.",{"_3328":1866,"_29138":1821,"_20209":53189,"_5":13819,"_26493":53062,"_2816":53190},[],"`O`: organization.",{"_3328":1867,"_29138":1821,"_20209":53192,"_5":13819,"_26493":53062,"_2816":53193},[],"`OU`: organizational unit.",{"_3328":1868,"_29138":1821,"_20209":53195,"_5":13819,"_26493":53062,"_2816":53196},[],"The CA's internal identifier is generated automatically and cannot be changed.",{"_3328":1869,"_29138":1821,"_20209":53198,"_5":13819,"_26493":53066,"_2816":53199},[],"Define **CA Certificate Expiration** and **Default End-Entity Certificate Issuance Expiration**. You can express a duration (`5y 8w 4d`), pick a date or use the maximum allowed date.",{"_3328":1870,"_29138":1821,"_20209":53201,"_5":13819,"_26493":53066,"_2816":53202},[],"Review the CA’s own certificate separately from the default profile for certificates it will issue later. Choose an explicit issuance policy; do not assume the form’s initial values suit your consumers.",{"_3328":1871,"_29138":1821,"_20209":53204,"_5":13819,"_26493":53070,"_2816":53205},[],"Confirm the form and open the CA. Check status, issuer, dates, associated engine and key. Download the certificate: it should contain `CA:TRUE` and a usage permitting certificate signing. Verify the self-signature for a root or the chain to your root for an intermediate. Complete a test issuance to check that the key can actually sign.",{"_3328":1872,"_29138":1821,"_20209":53207,"_5":13819,"_26493":53070,"_2816":53208},[],"Plan and verify expiration using the Profiles rules. Issuance does not automatically clamp validity to the issuer’s expiration; leave time to replace the authority and renew identities.",{"_3328":1873,"_29138":1821,"_20209":53210,"_5":13819,"_26493":53074,"_2816":53211},[],"Select &#x2A;*Create New CA (Existing Key)** when the key is already registered in Lamassu. The wizard first asks for the backing key and then shows the same configuration of type, identity, validity and profile.",{"_3328":1874,"_29138":1821,"_20209":53213,"_5":13819,"_26493":53074,"_2816":53214},[],"This flow is useful when the key was previously created in an HSM, imported through BYOK or must be reused under a specific custody policy.",{"_3328":1875,"_29138":1821,"_20209":53216,"_5":13819,"_26493":53078,"_2816":53217},[],"You need the CA certificate in PEM, its chain to a known root and, when importing it, an exportable private key. Before uploading material, verify signature, dates, `CA:TRUE`, signing usages (including `cRLSign`, without which the CA cannot publish its CRL) and public-key correspondence. The key verification procedure also compares a CA key and certificate.",{"_3328":1876,"_29138":1821,"_20209":53219,"_5":13819,"_26493":53082,"_2816":53220},[],"Check the installation’s default engine before importing a CA with a key. CA import delegates key import to that engine; it does not guarantee arbitrary provider selection from the form. To select an engine while importing the key separately, use the KMS.",{"_3328":1877,"_29138":1821,"_20209":53222,"_5":13819,"_26493":53086,"_2816":53223},[],"Import the certificate and, when applicable, its PEM key. Register the CAs needed to identify the issuer. Registering a CA does not install it in external trust stores.",{"_3328":1878,"_29138":1821,"_20209":53225,"_5":13819,"_26493":53090,"_2816":53226},[],"Associate an explicit issuance profile if the CA will sign. Check usages and dates using Profiles.",{"_3328":1879,"_29138":1821,"_20209":53228,"_5":13819,"_26493":53094,"_2816":53229},[],"Review the registered type, associated key and engine, and issuer relationship. Certificate-only import may associate an existing KMS key using the certificate’s key identifier. Without a usable key, the CA is public material and cannot sign.",{"_3328":1880,"_29138":1821,"_20209":53231,"_5":13819,"_26493":53094,"_2816":53232},[],"For an issuing CA, complete a test issuance and check OCSP and CRL. Creating the record alone does not establish key availability, complete chain consistency or status publication.",{"_3328":1881,"_29138":1821,"_20209":53234,"_5":13819,"_26493":53098,"_2816":53235},[],"Open a CA from the inventory to review:",{"_3328":1882,"_29138":1821,"_20209":53237,"_5":13819,"_26493":53098,"_2816":53238},[],"Status and validity period.",{"_3328":1883,"_29138":1821,"_20209":53240,"_5":13819,"_26493":53098,"_2816":53241},[],"Certificate and chain in PEM format.",{"_3328":1884,"_29138":1821,"_20209":53243,"_5":13819,"_26493":53098,"_2816":53244},[],"Number of active, expired and revoked certificates.",{"_3328":1885,"_29138":1821,"_20209":53246,"_5":13819,"_26493":53098,"_2816":53247},[],"Certificates issued in **Issued Certificates**.",{"_3328":1886,"_29138":1821,"_20209":53249,"_5":13819,"_26493":53098,"_2816":53250},[],"The CRL linked to the authority.",{"_3328":1887,"_29138":1821,"_20209":53252,"_5":13819,"_26493":53098,"_2816":53253},[],"Metadata and the associated cryptographic engine.",{"_3328":1888,"_29138":1821,"_20209":53255,"_5":13819,"_26493":53098,"_2816":53256},[],"You can filter the inventory by name, status and CA type.",{"_3328":1889,"_29138":1821,"_20209":53258,"_5":13819,"_26493":53102,"_2816":53259},[],"You can start an issuance from **Issued Certificates**, from a CA's action menu or from the global certificate inventory.",{"_3328":1890,"_29138":1821,"_20209":53261,"_5":13819,"_26493":53102,"_2816":53262},[],"**Generate Key & CSR in Browser** is useful for a manual operation or a quick test. The browser generates the key and you must download it at the end.",{"_3328":1891,"_29138":1821,"_20209":53264,"_5":13819,"_26493":53102,"_2816":53265},[],"**Upload Existing CSR** is the right option when the key must remain on the target system. Lamassu receives the request but never the private key.",{"_3328":1892,"_29138":1821,"_20209":53267,"_5":13819,"_26493":53102,"_2816":53268},[],"Follow Issue your first certificate for the guided flow. Certificate management explains the inventory, inspection and revocation.",{"_3328":1893,"_29138":1821,"_20209":53270,"_5":13819,"_26493":53106,"_2816":53271},[],"Revoking a CA prevents issuance and may interrupt its entire branch. Only `CertificateHold` allows reactivating the CA itself if it is not expired. Descendant revocation is attempted with `CessationOfOperation`; reactivating the parent does not restore those descendants. Follow the cascading revocation conditions.",{"_3328":1894,"_29138":1821,"_20209":53273,"_5":13819,"_26493":53110,"_2816":53274},[],"Identify the certificates, devices and consumers that depend on the CA. Prepare a replacement authority and chain when necessary.",{"_3328":1895,"_29138":1821,"_20209":53276,"_5":13819,"_26493":53114,"_2816":53277},[],"Open the authority and select **Revoke CA**. Choose the reason that describes the incident, for example `KeyCompromise`, `CACompromise`, `Superseded` or `CessationOfOperation`.",{"_3328":1896,"_29138":1821,"_20209":53279,"_5":13819,"_26493":53118,"_2816":53280},[],"Type the CA's name exactly to enable **Confirm Revocation**.",{"_3328":1897,"_29138":1821,"_20209":53282,"_5":13819,"_26493":53122,"_2816":53283},[],"Check **REVOKED** on the CA and review descendants individually; propagation permits partial failures. Independently verify OCSP and CRL publication and consumer rejection. A revoked record does not guarantee that an existing session closes.",{"_3328":1898,"_29138":1821,"_20209":53285,"_5":13819,"_26493":53126,"_2816":53286},[],"Permanent deletion is only available with the CA revoked or expired; a CA imported without a key can be deleted in any state. Delete the record only when your retention and audit policy allows it.",{"_3328":1899,"_29138":1821,"_20209":53288,"_5":13819,"_26493":53126,"_2816":53289},[],"The CA’s VA role is kept. If no other CA with the same SKI remains, it can no longer be edited (see CRL), so adjust its validity and signer beforehand. The CA’s key is released, but the KMS keeps it while other certificates still reference it.",{"_3328":1900,"_29138":1821,"_20209":53291,"_5":13819,"_26493":53126,"_2816":53292},[],"Lamassu keeps the certificate record of a deleted CA. If that same certificate is imported again, the import succeeds and reuses the record: it updates the type, issuer and key but keeps the status, so the CA reappears in the state it had when deleted (normally revoked or expired). A different certificate with the same serial number is rejected with a 400 error, and a certificate that already belongs to an existing CA with a 409 error. To avoid inheriting the previous status, use a certificate with a different serial number and check the result after importing. If the new certificate uses the same key, it shares the SKI with the retained VA role of the deleted CA, whose signer is the old certificate: check that the CRL is generated and, if it is not, use `PUT` to set a signer of the new CA (see CRL).",{"_3328":1901,"_29138":1901,"_5":14177,"_2816":53294,"_29461":53295,"_20209":53296,"_26493":1901},"Certificate profiles",[47397,48865,52871,52872],[],{"_3328":1902,"_29138":1901,"_20209":53298,"_5":13819,"_26493":1901,"_2816":53299},[],"Define reusable policies to issue consistent certificates and constrain accepted keys.",{"_3328":1903,"_29138":1901,"_5":29458,"_20209":53301,"_26493":53302,"_2816":53303},[],"/docs/platform/pki/certificate-profiles#what-a-profile-controls","What a profile controls",{"_3328":1904,"_29138":1901,"_5":29458,"_20209":53305,"_26493":53306,"_2816":53307},[],"/docs/platform/pki/certificate-profiles#validity","Validity",{"_3328":1905,"_29138":1901,"_5":29458,"_20209":53309,"_26493":53310,"_2816":53311},[],"/docs/platform/pki/certificate-profiles#ca-certificate-or-end-entity-certificate","CA certificate or end-entity certificate",{"_3328":1906,"_29138":1901,"_5":29458,"_20209":53313,"_26493":53314,"_2816":53315},[],"/docs/platform/pki/certificate-profiles#key-usage-and-extended-key-usage","Key Usage and Extended Key Usage",{"_3328":1907,"_29138":1901,"_5":29458,"_20209":53317,"_26493":53318,"_2816":53319},[],"/docs/platform/pki/certificate-profiles#subject","Subject",{"_3328":1908,"_29138":1901,"_5":29458,"_20209":53321,"_26493":53322,"_2816":53323},[],"/docs/platform/pki/certificate-profiles#csr-extensions","CSR extensions",{"_3328":1909,"_29138":1901,"_5":29458,"_20209":53325,"_26493":53326,"_2816":53327},[],"/docs/platform/pki/certificate-profiles#cryptographic-constraints","Cryptographic constraints",{"_3328":1910,"_29138":1901,"_5":29458,"_20209":53329,"_26493":53330,"_2816":53331},[],"/docs/platform/pki/certificate-profiles#profile-precedence","Profile precedence",{"_3328":1911,"_29138":1901,"_5":29458,"_20209":53333,"_26493":53334,"_2816":53335},[],"/docs/platform/pki/certificate-profiles#create-a-profile","Create a profile",{"_3328":1912,"_29138":1901,"_5":29458,"_20209":53337,"_26493":53338,"_2816":53339},[],"/docs/platform/pki/certificate-profiles#define-a-single-purpose","Define a single purpose",{"_3328":1913,"_29138":1901,"_5":29458,"_20209":53341,"_26493":53342,"_2816":53343},[],"/docs/platform/pki/certificate-profiles#choose-the-validity","Choose the validity",{"_3328":1914,"_29138":1901,"_5":29458,"_20209":53345,"_26493":53346,"_2816":53347},[],"/docs/platform/pki/certificate-profiles#fix-usages-and-subject","Fix usages and subject",{"_3328":1915,"_29138":1901,"_5":29458,"_20209":53349,"_26493":53350,"_2816":53351},[],"/docs/platform/pki/certificate-profiles#constrain-the-keys","Constrain the keys",{"_3328":1916,"_29138":1901,"_5":29458,"_20209":53353,"_26493":53354,"_2816":53355},[],"/docs/platform/pki/certificate-profiles#attach-it-and-test","Attach it and test",{"_3328":1917,"_29138":1901,"_5":29458,"_20209":53357,"_26493":53358,"_2816":53359},[],"/docs/platform/pki/certificate-profiles#design-examples","Design examples",{"_3328":1918,"_29138":1901,"_5":29458,"_20209":53361,"_26493":53362,"_2816":53363},[],"/docs/platform/pki/certificate-profiles#changes-and-deletion","Changes and deletion",{"_3328":1919,"_29138":1901,"_20209":53365,"_5":13819,"_26493":1901,"_2816":53366},[],"An issuance profile turns a certificate policy into reusable configuration. Instead of deciding validity, subject, extensions and algorithms on every request, you define once what is allowed and attach the profile to a CA, a DMS or a specific issuance.",{"_3328":1920,"_29138":1901,"_20209":53368,"_5":13819,"_26493":1901,"_2816":53369},[],"This guide is for the PKI administrator defining issuance policy. You need permissions to manage profiles and associate them with the intended CA or DMS, plus a test consumer with known identity and purpose requirements.",{"_3328":1921,"_29138":1901,"_20209":53371,"_5":13819,"_26493":53306,"_2816":53372},[],"You can express the lifetime as a duration from the moment of issuance or as a fixed end date. A duration works well for recurring identities; a common date is useful to make a whole batch end before a migration or retirement.",{"_3328":1922,"_29138":1901,"_20209":53374,"_5":13819,"_26493":53306,"_2816":53375},[],"Plan the end date within the issuing CA’s validity and leave a renewal margin. The signer calculates the date from the profile; it does not automatically clamp validity to the issuer’s expiration. Check both dates in the resulting certificate. A fixed date in the past does not produce a usable identity either.",{"_3328":1923,"_29138":1901,"_20209":53377,"_5":13819,"_26493":53310,"_2816":53378},[],"`Sign as CA` sets `IsCA` and the basic constraints needed for an authority. Enable it only in profiles intended to create or reissue subordinate CAs.",{"_3328":1924,"_29138":1901,"_20209":53380,"_5":13819,"_26493":53314,"_2816":53381},[],"The profile can enforce usages such as `DigitalSignature`, `KeyEncipherment`, `CertSign`, `CRLSign`, `ClientAuth`, `ServerAuth` or `OCSPSigning`.",{"_3328":1925,"_29138":1901,"_20209":53383,"_5":13819,"_26493":53314,"_2816":53384},[],"If you enable **Honor Key Usage** or **Honor Extended Key Usages**, Lamassu keeps the values requested by the CSR. If you disable them, it replaces them with the ones defined in the profile.",{"_3328":1926,"_29138":1901,"_20209":53386,"_5":13819,"_26493":53314,"_2816":53387},[],"Do not enable the `Honor…` options for untrusted requests unless another component validates those fields. Otherwise, the requester may choose broader capabilities than intended.",{"_3328":1927,"_29138":1901,"_20209":53389,"_5":13819,"_26493":53318,"_2816":53390},[],"With **Honor Subject**, the certificate keeps the subject of the CSR. Without that option, Lamassu applies the profile's `CN`, `O`, `OU`, `C`, `ST` and `L`. If the profile does not define a `Common Name`, the requested CN is kept.",{"_3328":1928,"_29138":1901,"_20209":53392,"_5":13819,"_26493":53322,"_2816":53393},[],"With **Honor Extensions**, Lamassu filters the additional requested extensions and keeps only SAN. Without that option, it discards the CSR's additional extensions.",{"_3328":1929,"_29138":1901,"_20209":53395,"_5":13819,"_26493":53322,"_2816":53396},[],"This preserves SAN, but does not establish that the requester is entitled to those DNS names, IP addresses, emails or URIs. Validate that authorization before issuing. OCSP and CRL locations come from the issuance service configuration; `Honor Extensions` does not copy CSR distribution points.",{"_3328":1930,"_29138":1901,"_20209":53398,"_5":13819,"_26493":53326,"_2816":53399},[],"The cryptographic enforcement can:",{"_3328":1931,"_29138":1901,"_20209":53401,"_5":13819,"_26493":53326,"_2816":53402},[],"allow or block RSA keys;",{"_3328":1932,"_29138":1901,"_20209":53404,"_5":13819,"_26493":53326,"_2816":53405},[],"limit the supported RSA sizes;",{"_3328":1933,"_29138":1901,"_20209":53407,"_5":13819,"_26493":53326,"_2816":53408},[],"allow or block ECDSA keys;",{"_3328":1934,"_29138":1901,"_20209":53410,"_5":13819,"_26493":53326,"_2816":53411},[],"limit the supported ECDSA sizes or curves.",{"_3328":1935,"_29138":1901,"_20209":53413,"_5":13819,"_26493":53326,"_2816":53414},[],"When it is enabled, Lamassu checks the public key before creating a CA or signing a CSR. A key whose type or size is not listed in the profile is rejected.",{"_3328":1936,"_29138":1901,"_20209":53416,"_5":13819,"_26493":53330,"_2816":53417},[],"Resolution depends on the entry point. One complete profile is selected; its fields are not merged with the CA’s profile.",{"_3328":1937,"_29138":1901,"_20209":53419,"_5":13819,"_26493":53330,"_2816":50626},[],{"_3328":1938,"_29138":1901,"_20209":53421,"_5":13819,"_26493":53330,"_2816":53422},[],"First choice",{"_3328":1939,"_29138":1901,"_20209":53424,"_5":13819,"_26493":53330,"_2816":53425},[],"Second choice",{"_3328":1940,"_29138":1901,"_20209":53427,"_5":13819,"_26493":53330,"_2816":53428},[],"If neither is supplied",{"_3328":1941,"_29138":1901,"_20209":53430,"_5":13819,"_26493":53330,"_2816":53431},[],"Direct signing with a CA",{"_3328":1942,"_29138":1901,"_20209":53433,"_5":13819,"_26493":53330,"_2816":53434},[],"`issuance_profile` embedded in the request",{"_3328":1943,"_29138":1901,"_20209":53436,"_5":13819,"_26493":53330,"_2816":53437},[],"Request `issuance_profile_id`",{"_3328":1944,"_29138":1901,"_20209":53439,"_5":13819,"_26493":53330,"_2816":53440},[],"CA default profile (`profile_id`).",{"_3328":1945,"_29138":1901,"_20209":53442,"_5":13819,"_26493":53330,"_2816":53443},[],"Issuance through a DMS",{"_3328":1946,"_29138":1901,"_20209":53445,"_5":13819,"_26493":53330,"_2816":53446},[],"`settings.issuance_profile_id`",{"_3328":1947,"_29138":1901,"_20209":53448,"_5":13819,"_26493":53330,"_2816":53449},[],"`settings.issuance_profile` embedded in the DMS",{"_3328":1948,"_29138":1901,"_20209":53451,"_5":13819,"_26493":53330,"_2816":53452},[],"Enrollment CA default profile.",{"_3328":1949,"_29138":1901,"_20209":53454,"_5":13819,"_26493":53330,"_2816":53455},[],"If the selected identifier cannot be resolved, the operation fails; it does not silently fall back to the CA’s profile. Avoid setting both options at once. Recording which profile was selected helps explain why a certificate differs from its CSR.",{"_3328":1950,"_29138":1901,"_20209":53457,"_5":13819,"_26493":53330,"_2816":53458},[],"Several fleets can share a CA while keeping different profiles through their DMSs. Requester authentication and device registration policy are configured separately in DMS.",{"_3328":1951,"_29138":1901,"_20209":53460,"_5":13819,"_26493":53338,"_2816":53461},[],"Separate, for example, mTLS devices, servers and intermediate CAs. A small, specific profile is easier to review than one that allows every use.",{"_3328":1952,"_29138":1901,"_20209":53463,"_5":13819,"_26493":53342,"_2816":53464},[],"Align the duration with the fleet's real renewal capacity. Leave margin against the CA's expiration.",{"_3328":1953,"_29138":1901,"_20209":53466,"_5":13819,"_26493":53346,"_2816":53467},[],"For a device that authenticates as a client, the usual starting point is `DigitalSignature` and `ClientAuth`. Add `ServerAuth` or `KeyEncipherment` only if the protocol needs it.",{"_3328":1954,"_29138":1901,"_20209":53469,"_5":13819,"_26493":53350,"_2816":53470},[],"Enable cryptographic enforcement and list only algorithms and sizes compatible with your policy and your devices.",{"_3328":1955,"_29138":1901,"_20209":53472,"_5":13819,"_26493":53354,"_2816":53473},[],"Attach the profile to a CA or DMS and check the precedence above. Issue a CSR with known usages and SAN; inspect the result with `openssl x509 -in device.crt -noout -text`. Check subject, SAN, KU, EKU and dates. For an end-entity identity, disable `Sign as CA`, require no `CA:TRUE` or `Certificate Sign`, and require `CA:FALSE` if Basic Constraints is present.",{"_3328":1956,"_29138":1901,"_20209":53475,"_5":13819,"_26493":53354,"_2816":53476},[],"Also try a key excluded by policy: issuance should fail. Follow the certificate verification and test acceptance in the intended consumer.",{"_3328":1957,"_29138":1901,"_20209":53478,"_5":13819,"_26493":53358,"_2816":53479},[],"**mTLS device**\\\nEnd-entity certificate, short validity, `DigitalSignature`, `ClientAuth`, subject controlled by the DMS and SAN allowed when it identifies the device.",{"_3328":1958,"_29138":1901,"_20209":53481,"_5":13819,"_26493":53358,"_2816":53482},[],"**TLS server**\\\nEnd-entity certificate, `DigitalSignature`, `ServerAuth` and mandatory SAN with the names clients will use.",{"_3328":1959,"_29138":1901,"_20209":53484,"_5":13819,"_26493":53358,"_2816":53485},[],"**Intermediate CA**\\\n`Sign as CA`, `CertSign` and `CRLSign`, validity longer than its end-entity certificates and stricter cryptographic constraints.",{"_3328":1960,"_29138":1901,"_20209":53487,"_5":13819,"_26493":53358,"_2816":53488},[],"These patterns express design decisions. Enabling `Honor Extensions` does not require a CSR to contain SAN or validate its names; enforce that in the request workflow. A profile does not install trust or grant permissions in the consumer.",{"_3328":1961,"_29138":1901,"_20209":53490,"_5":13819,"_26493":53362,"_2816":53491},[],"Updating a profile affects future issuances; it does not modify already-signed certificates. Test changes before applying them to a CA in production and keep the operational justification.",{"_3328":1962,"_29138":1901,"_20209":53493,"_5":13819,"_26493":53362,"_2816":53494},[],"Before deleting a profile, check that no CA or DMS depends on it. If you want to replace it, create the new version, update the references and perform a test issuance before retiring the old one.",{"_3328":1963,"_29138":1963,"_5":14177,"_2816":53496,"_29461":53497,"_20209":53499,"_26493":1963},"Certificate validation",[47397,48865,52871,53498],"Validation",[],{"_3328":1964,"_29138":1963,"_20209":53501,"_5":13819,"_26493":1963,"_2816":53502},[],"Check chain, identity, purpose and revocation from the consumer.",{"_3328":1965,"_29138":1963,"_5":29458,"_20209":53504,"_26493":53505,"_2816":53506},[],"/docs/platform/pki/certificate-validation#before-querying-status","Before querying status",{"_3328":1966,"_29138":1963,"_5":29458,"_20209":53508,"_26493":53509,"_2816":53510},[],"/docs/platform/pki/certificate-validation#choose-a-mechanism","Choose a mechanism",{"_3328":1967,"_29138":1963,"_5":29458,"_20209":53512,"_26493":53513,"_2816":53514},[],"/docs/platform/pki/certificate-validation#check-consumer-behavior","Check consumer behavior",{"_3328":1968,"_29138":1963,"_20209":53516,"_5":13819,"_26493":1963,"_2816":53517},[],"This guide brings together the checks needed when integrating a certificate consumer. You need the presented certificate, intermediates and roots that your application has deliberately chosen to trust. Lamassu publishes status; the consumer applies acceptance policy.",{"_3328":1969,"_29138":1963,"_20209":53519,"_5":13819,"_26493":53505,"_2816":53520},[],"Verify these criteria together:",{"_3328":1970,"_29138":1963,"_20209":53522,"_5":13819,"_26493":53505,"_2816":52497},[],{"_3328":1971,"_29138":1963,"_20209":53524,"_5":13819,"_26493":53505,"_2816":53525},[],"Required result",{"_3328":1972,"_29138":1963,"_20209":53527,"_5":13819,"_26493":53505,"_2816":53528},[],"Chain and signature",{"_3328":1973,"_29138":1963,"_20209":53530,"_5":13819,"_26493":53505,"_2816":53531},[],"Valid chain to a root deliberately installed in the consumer.",{"_3328":1974,"_29138":1963,"_20209":53533,"_5":13819,"_26493":53505,"_2816":53534},[],"Dates",{"_3328":1975,"_29138":1963,"_20209":53536,"_5":13819,"_26493":53505,"_2816":53537},[],"Current time between `Not Before` and `Not After`, including the CAs in the chain.",{"_3328":1976,"_29138":1963,"_20209":53539,"_5":13819,"_26493":53505,"_2816":48534},[],{"_3328":1977,"_29138":1963,"_20209":53541,"_5":13819,"_26493":53505,"_2816":53542},[],"Name, SAN or identifier matches the expected peer.",{"_3328":1978,"_29138":1963,"_20209":53544,"_5":13819,"_26493":53505,"_2816":47787},[],{"_3328":1979,"_29138":1963,"_20209":53546,"_5":13819,"_26493":53505,"_2816":53547},[],"KU, EKU and constraints permit the specific operation.",{"_3328":1980,"_29138":1963,"_20209":53549,"_5":13819,"_26493":53505,"_2816":53550},[],"Revocation",{"_3328":1981,"_29138":1963,"_20209":53552,"_5":13819,"_26493":53505,"_2816":53553},[],"Signed, current evidence corresponding to the queried issuer and certificate.",{"_3328":1982,"_29138":1963,"_20209":53555,"_5":13819,"_26493":53505,"_2816":53556},[],"Authorization",{"_3328":1983,"_29138":1963,"_20209":53558,"_5":13819,"_26493":53505,"_2816":53559},[],"The application permits that identity to perform the action.",{"_3328":1984,"_29138":1963,"_20209":53561,"_5":13819,"_26493":53505,"_2816":53562},[],"The issuance walkthrough checks chain and purpose with OpenSSL. That check does not automatically query OCSP or download a CRL. Inventory presence or an OCSP `Good` response does not replace the other criteria.",{"_3328":1985,"_29138":1963,"_20209":53564,"_5":13819,"_26493":53509,"_2816":53565},[],"Mechanism",{"_3328":1986,"_29138":1963,"_20209":53567,"_5":13819,"_26493":53509,"_2816":53568},[],"When to use it",{"_3328":1987,"_29138":1963,"_20209":53570,"_5":13819,"_26493":53509,"_2816":53571},[],"What you must maintain",{"_3328":1988,"_29138":1963,"_20209":53573,"_5":13819,"_26493":53509,"_2816":53574},[],"OCSP",{"_3328":1989,"_29138":1963,"_20209":53576,"_5":13819,"_26493":53509,"_2816":53577},[],"Status query for a specific certificate.",{"_3328":1990,"_29138":1963,"_20209":53579,"_5":13819,"_26493":53509,"_2816":53580},[],"Responder access, signature verification and cache/freshness policy.",{"_3328":1991,"_29138":1963,"_20209":53582,"_5":13819,"_26493":53509,"_2816":53583},[],"CRL",{"_3328":1992,"_29138":1963,"_20209":53585,"_5":13819,"_26493":53509,"_2816":53586},[],"Local checks for many certificates or offline operation.",{"_3328":1993,"_29138":1963,"_20209":53588,"_5":13819,"_26493":53509,"_2816":53589},[],"Periodic download of an issuer-signed list and rejection of expired lists.",{"_3328":1994,"_29138":1963,"_20209":53591,"_5":13819,"_26493":53509,"_2816":53592},[],"OCSP can also return a response reusable until `nextUpdate`; a CRL changes when a new version is published. Neither mechanism alone guarantees that a consumer learns a revocation at the moment it is saved.",{"_3328":1995,"_29138":1963,"_20209":53594,"_5":13819,"_26493":53509,"_2816":53595},[],"If using both, define when fallback is allowed and what the client does when retrieval, signature or freshness checks fail, or the result is `Unknown`. Accepting an identity when its status cannot be checked must be an explicit application decision.",{"_3328":1996,"_29138":1963,"_20209":53597,"_5":13819,"_26493":53513,"_2816":53598},[],"Accept a current, authorized certificate with a known chain.",{"_3328":1997,"_29138":1963,"_20209":53600,"_5":13819,"_26493":53513,"_2816":53601},[],"Reject another certificate with an unknown root or incompatible purpose.",{"_3328":1998,"_29138":1963,"_20209":53603,"_5":13819,"_26493":53513,"_2816":53604},[],"Revoke a test certificate and verify the OCSP response or new CRL.",{"_3328":1999,"_29138":1963,"_20209":53606,"_5":13819,"_26493":53513,"_2816":53607},[],"Check that a new connection with that identity is rejected.",{"_3328":2000,"_29138":1963,"_20209":53609,"_5":13819,"_26493":53513,"_2816":53610},[],"Simulate an unreachable endpoint and expired evidence; observe whether the result matches policy.",{"_3328":2001,"_29138":1963,"_20209":53612,"_5":13819,"_26493":53513,"_2816":53613},[],"Keep the serial number, issuer, revocation reason, query time and evidence timestamps. An existing session may need explicit closure or reauthentication in the consumer; publishing revocation does not automatically close it.",{"_3328":2002,"_29138":1963,"_20209":53615,"_5":13819,"_26493":53513,"_2816":53616},[],"For a chain with intermediates, validate their status according to consumer policy as well. An end-entity issuer’s CRL does not replace checks on every CA in the chain.",{"_3328":2003,"_29138":1963,"_20209":53618,"_5":13819,"_26493":53513,"_2816":53619},[],"<Card title=\"Online validation with OCSP\" description=\"Generate a query and verify signature, status and timestamps.\" href=\"/docs/platform/pki/ocsp\" />",{"_3328":2004,"_29138":1963,"_20209":53621,"_5":13819,"_26493":53513,"_2816":53622},[],"<Card title=\"Revocation lists\" description=\"Download, inspect and use an issuer’s CRL.\" href=\"/docs/platform/pki/crl\" />",{"_3328":2005,"_29138":2005,"_5":14177,"_2816":53624,"_29461":53625,"_20209":53626,"_26493":2005},"Certificates",[47397,48865,52871,52872],[],{"_3328":2006,"_29138":2005,"_20209":53628,"_5":13819,"_26493":2005,"_2816":53629},[],"Inspect, download and revoke the certificates issued by Lamassu.",{"_3328":2007,"_29138":2005,"_5":29458,"_20209":53631,"_26493":53632,"_2816":53633},[],"/docs/platform/pki/certificates#find-a-certificate","Find a certificate",{"_3328":2008,"_29138":2005,"_5":29458,"_20209":53635,"_26493":53636,"_2816":53637},[],"/docs/platform/pki/certificates#download-the-certificate","Download the certificate",{"_3328":2009,"_29138":2005,"_5":29458,"_20209":53639,"_26493":53640,"_2816":53641},[],"/docs/platform/pki/certificates#issue-from-an-existing-csr","Issue from an existing CSR",{"_3328":2010,"_29138":2005,"_5":29458,"_20209":53643,"_26493":53644,"_2816":53645},[],"/docs/platform/pki/certificates#revoke-a-certificate","Revoke a certificate",{"_3328":2011,"_29138":2005,"_5":29458,"_20209":53647,"_26493":53648,"_2816":53649},[],"/docs/platform/pki/certificates#open-the-action","Open the action",{"_3328":2012,"_29138":2005,"_5":29458,"_20209":53651,"_26493":53652,"_2816":53653},[],"/docs/platform/pki/certificates#choose-a-reason","Choose a reason",{"_3328":2013,"_29138":2005,"_5":29458,"_20209":53655,"_26493":53656,"_2816":53657},[],"/docs/platform/pki/certificates#confirm-and-verify","Confirm and verify",{"_3328":2014,"_29138":2005,"_5":29458,"_20209":53659,"_26493":53660,"_2816":53661},[],"/docs/platform/pki/certificates#reactivate-a-hold","Reactivate a hold",{"_3328":2015,"_29138":2005,"_5":29458,"_20209":53663,"_26493":53664,"_2816":53665},[],"/docs/platform/pki/certificates#continue","Continue",{"_3328":2016,"_29138":2005,"_20209":53667,"_5":13819,"_26493":2005,"_2816":53668},[],"This guide is for a PKI operator inspecting or retiring an issued identity. You need inventory access and, to change states, permissions on the certificate. Open **Certificates** for a global view or **Issued Certificates** within a CA to restrict it to that issuer.",{"_3328":2017,"_29138":2005,"_20209":53670,"_5":13819,"_26493":53632,"_2816":53671},[],"Filter by `Common Name`, serial, status and issuer. Use **Quick Inspect** for a quick review or **View Details** for subject, SAN, usages, chain, dates and metadata.",{"_3328":2018,"_29138":2005,"_20209":53673,"_5":13819,"_26493":53632,"_2816":53674},[],"Identify a certificate by issuer and serial; a name can correspond to several renewals. Check which certificate the consumer actually uses and which occupies the device’s active identity. Identity history and the certificate inventory answer different questions.",{"_3328":2019,"_29138":2005,"_20209":53676,"_5":13819,"_26493":53636,"_2816":53677},[],"Download the PEM and inspect it:",{"_3328":2020,"_29138":2005,"_20209":53679,"_5":13819,"_26493":53636,"_2816":53680},[],"Check issuance policy, chain and usages with the verification walkthrough. A certificate does not contain its private key. For an external CSR, the key remains where it was generated; for the browser flow, retain the file downloaded upon issuance. If the key is lost, plan a new identity rather than expecting recovery from the certificate.",{"_3328":2021,"_29138":2005,"_20209":53682,"_5":13819,"_26493":53640,"_2816":53683},[],"Use this flow when the identity’s key must remain on the system that generated it. You need an active CA with a usable key, a PEM CSR and a suitable profile.",{"_3328":2022,"_29138":2005,"_20209":53685,"_5":13819,"_26493":53640,"_2816":53686},[],"Verify the request with `openssl req -in request.csr -noout -verify -text`. Review subject, SAN and algorithm, and authorize the requested identity.",{"_3328":2023,"_29138":2005,"_20209":53688,"_5":13819,"_26493":53640,"_2816":53689},[],"Start issuance from the CA or inventory and select **Upload Existing CSR**.",{"_3328":2024,"_29138":2005,"_20209":53691,"_5":13819,"_26493":53640,"_2816":53692},[],"Confirm the CA and profile resolved according to Profiles; the request does not guarantee that every field is retained.",{"_3328":2025,"_29138":2005,"_20209":53694,"_5":13819,"_26493":53640,"_2816":53695},[],"Download the certificate and inspect dates, issuer, subject, SAN, KU and EKU. Check correspondence with the private key on the originating system.",{"_3328":2026,"_29138":2005,"_20209":53697,"_5":13819,"_26493":53640,"_2816":53698},[],"Install certificate and chain in the intended consumer and test a connection. Issuance alone does not register a device or grant access in an integration.",{"_3328":2027,"_29138":2005,"_20209":53700,"_5":13819,"_26493":53640,"_2816":53701},[],"For browser key generation, follow Issue your first certificate.",{"_3328":2028,"_29138":2005,"_20209":53703,"_5":13819,"_26493":53644,"_2816":53704},[],"Revoke when the key is compromised, the subject is no longer authorized or the identity must stop being accepted before expiration. Before changing status, identify consumers and prepare any required replacement.",{"_3328":2029,"_29138":2005,"_20209":53706,"_5":13819,"_26493":53648,"_2816":53707},[],"Locate the correct issuer and serial and select **Revoke Certificate**. `EXPIRED` records and records revoked for a final reason reject subsequent status changes.",{"_3328":2030,"_29138":2005,"_20209":53709,"_5":13819,"_26493":53652,"_2816":53710},[],"Select the incident reason. `CertificateHold` represents a reversible certificate suspension; other reasons block later changes. Do not use a suspension to address a compromised key.",{"_3328":2031,"_29138":2005,"_20209":53712,"_5":13819,"_26493":53656,"_2816":53713},[],"Save the change and read the record again: require **REVOKED**, reason and timestamp. Then verify a fresh OCSP query and, if using CRL, its published version and the serial’s presence. Finally check rejection of a new connection in the consumer.",{"_3328":2032,"_29138":2005,"_20209":53715,"_5":13819,"_26493":53656,"_2816":53716},[],"Revocation does not erase the certificate, delete the key or guarantee closure of existing sessions. Status and publication are separate steps.",{"_3328":2033,"_29138":2005,"_20209":53718,"_5":13819,"_26493":53656,"_2816":53719},[],"A certificate revoked with `CertificateHold` can be reactivated if it is not in `EXPIRED` state. Its dates and consumer trust remain mandatory.",{"_3328":2034,"_29138":2005,"_20209":53721,"_5":13819,"_26493":53660,"_2816":53722},[],"Check that the saved reason is `CertificateHold` and the identity still satisfies policy. Request `ACTIVE` through the status update operation exposed by your installation; consult the API reference. Do not assume changing consumer permissions also changes status in Lamassu.",{"_3328":2035,"_29138":2005,"_20209":53724,"_5":13819,"_26493":53660,"_2816":53725},[],"Read the record and query OCSP again. With `regenerate_on_revoke` enabled, the reactivation event requests CRL regeneration: check that the new list omits the serial. An earlier list can still mark it revoked until the client refreshes its copy.",{"_3328":2036,"_29138":2005,"_20209":53727,"_5":13819,"_26493":53660,"_2816":53728},[],"This does not undo permanent revocation or a cascade started by revoking a CA.",{"_3328":2037,"_29138":2005,"_20209":53730,"_5":13819,"_26493":53664,"_2816":53731},[],"<Card title=\"Validate with OCSP\" description=\"Query and verify a certificate’s signed status.\" href=\"/docs/platform/pki/ocsp\" />",{"_3328":2038,"_29138":2005,"_20209":53733,"_5":13819,"_26493":53664,"_2816":53734},[],"<Card title=\"Distribute a CRL\" description=\"Publish status for local validation.\" href=\"/docs/platform/pki/crl\" />",{"_3328":2039,"_29138":2039,"_5":14177,"_2816":53736,"_29461":53737,"_20209":53739,"_26493":2039},"Certificate lifecycle",[47397,48865,52871,53738],"Concepts",[],{"_3328":2040,"_29138":2039,"_20209":53741,"_5":13819,"_26493":2039,"_2816":53742},[],"Issuance, use, renewal, revocation and retirement of certificates in Lamassu.",{"_3328":2041,"_29138":2039,"_5":29458,"_20209":53744,"_26493":53745,"_2816":53746},[],"/docs/platform/pki/concepts/certificate-lifecycle#the-full-journey","The full journey",{"_3328":2042,"_29138":2039,"_5":29458,"_20209":53748,"_26493":53749,"_2816":53750},[],"/docs/platform/pki/concepts/certificate-lifecycle#request","Request",{"_3328":2043,"_29138":2039,"_5":29458,"_20209":53752,"_26493":53753,"_2816":53754},[],"/docs/platform/pki/concepts/certificate-lifecycle#issuance","Issuance",{"_3328":2044,"_29138":2039,"_5":29458,"_20209":53756,"_26493":53757,"_2816":53758},[],"/docs/platform/pki/concepts/certificate-lifecycle#use-and-monitoring","Use and monitoring",{"_3328":2045,"_29138":2039,"_5":29458,"_20209":53760,"_26493":53761,"_2816":53762},[],"/docs/platform/pki/concepts/certificate-lifecycle#renewal-or-re-enrollment","Renewal or re-enrollment",{"_3328":2046,"_29138":2039,"_5":29458,"_20209":53764,"_26493":53765,"_2816":53766},[],"/docs/platform/pki/concepts/certificate-lifecycle#revocation-or-retirement","Revocation or retirement",{"_3328":2047,"_29138":2039,"_5":29458,"_20209":53768,"_26493":53769,"_2816":53770},[],"/docs/platform/pki/concepts/certificate-lifecycle#certificate-states","Certificate states",{"_3328":2048,"_29138":2039,"_5":29458,"_20209":53772,"_26493":53773,"_2816":53774},[],"/docs/platform/pki/concepts/certificate-lifecycle#renewal-and-revocation-are-not-equivalent","Renewal and revocation are not equivalent",{"_3328":2049,"_29138":2039,"_5":29458,"_20209":53776,"_26493":53777,"_2816":53778},[],"/docs/platform/pki/concepts/certificate-lifecycle#effect-of-revoking-a-ca","Effect of revoking a CA",{"_3328":2050,"_29138":2039,"_5":29458,"_20209":53780,"_26493":53781,"_2816":53782},[],"/docs/platform/pki/concepts/certificate-lifecycle#what-you-should-watch","What you should watch",{"_3328":2051,"_29138":2039,"_20209":53784,"_5":13819,"_26493":2039,"_2816":53785},[],"Issuing a certificate is only the beginning. During its useful life you must check its validity, renew it before it expires and retire it when it stops being trustworthy. Lamassu keeps the certificate, its issuing CA, its status and, when it belongs to a device, the identity it is linked to.",{"_3328":2052,"_29138":2039,"_20209":53787,"_5":13819,"_26493":53749,"_2816":53788},[],"The requester generates a key and a CSR. In the recommended flows, the private key stays in the device, browser or cryptographic engine that created it.",{"_3328":2053,"_29138":2039,"_20209":53790,"_5":13819,"_26493":53753,"_2816":53791},[],"The CA signs the CSR. The issuance profile determines the validity, uses, subject, allowed extensions and cryptographic constraints.",{"_3328":2054,"_29138":2039,"_20209":53793,"_5":13819,"_26493":53757,"_2816":53794},[],"The certificate enters the `ACTIVE` state. Lamassu monitors its `Not After` date; the cryptographic monitoring job marks certificates that have expired as `EXPIRED`.",{"_3328":2055,"_29138":2039,"_20209":53796,"_5":13819,"_26493":53761,"_2816":53797},[],"A new certificate is issued before the previous one expires. In a DMS you can open preventive and critical windows so the device re-enrolls through EST.",{"_3328":2056,"_29138":2039,"_20209":53799,"_5":13819,"_26493":53765,"_2816":53800},[],"If the identity stops being trustworthy, Lamassu records the reason and time of revocation. OCSP and CRLs let consumers learn that status.",{"_3328":2057,"_29138":2039,"_20209":53802,"_5":13819,"_26493":53769,"_2816":53803},[],"Lamassu persists four X.509 states:",{"_3328":2058,"_29138":2039,"_20209":53805,"_5":13819,"_26493":53769,"_2816":53806},[],"**`ACTIVE`**: the record is enabled. Also check `Not Before` and `Not After`: this state does not establish time validity.",{"_3328":2059,"_29138":2039,"_20209":53808,"_5":13819,"_26493":53769,"_2816":53809},[],"**`EXPIRED`**: it has passed its expiration date. The monitor detects this periodically; it is not a state that should be assigned manually.",{"_3328":2060,"_29138":2039,"_20209":53811,"_5":13819,"_26493":53769,"_2816":53812},[],"**`REVOKED`**: it was invalidated before expiring, with a reason and a timestamp.",{"_3328":2061,"_29138":2039,"_20209":53814,"_5":13819,"_26493":53769,"_2816":53815},[],"**`INACTIVE`**: it is disabled without representing a definitive revocation.",{"_3328":2062,"_29138":2039,"_20209":53817,"_5":13819,"_26493":53769,"_2816":53818},[],"The device view may add operational states such as missing identity, pending renewal, expiring soon or decommissioned. These are an interpretation of the device's status and its certificates, not new X.509 states.",{"_3328":2063,"_29138":2039,"_20209":53820,"_5":13819,"_26493":53773,"_2816":53821},[],"**Renewal** creates a successor certificate for an identity that remains valid. **Revocation** communicates that the current certificate must no longer be accepted. Renew to maintain continuity; revoke in response to compromise, retirement or a change that invalidates the identity.",{"_3328":2064,"_29138":2039,"_20209":53823,"_5":13819,"_26493":53773,"_2816":53824},[],"Only `CertificateHold` allows reactivating a revoked certificate that is not in `EXPIRED` state. Revocation for another reason blocks subsequent status changes. `EXPIRED` records also reject changes; the consumer must check dates even before the monitor updates the state. Certificates explains how to verify revocation and reactivation.",{"_3328":2065,"_29138":2039,"_20209":53826,"_5":13819,"_26493":53773,"_2816":53827},[],"The **Reissue CA** operation generates another certificate for the same key and links both serial numbers through metadata. It is not a key rotation. To change the key, create a successor CA and perform a migration with an overlapping period.",{"_3328":2066,"_29138":2039,"_20209":53829,"_5":13819,"_26493":53777,"_2816":53830},[],"Revoking a CA starts a cascade that attempts to revoke descendants with `CessationOfOperation`. It may end with partial failures and is not undone by reactivating the parent. Read Hierarchy and rotation for conditions and checks.",{"_3328":2067,"_29138":2039,"_20209":53832,"_5":13819,"_26493":53777,"_2816":53833},[],"Before confirming:",{"_3328":2068,"_29138":2039,"_20209":53835,"_5":13819,"_26493":53777,"_2816":53836},[],"Identify DMSs, devices and services that trust that chain.",{"_3328":2069,"_29138":2039,"_20209":53838,"_5":13819,"_26493":53777,"_2816":53839},[],"Distribute the new chain of trust.",{"_3328":2070,"_29138":2039,"_20209":53841,"_5":13819,"_26493":53777,"_2816":53842},[],"Reissue the necessary identities.",{"_3328":2071,"_29138":2039,"_20209":53844,"_5":13819,"_26493":53777,"_2816":53845},[],"Check OCSP and CRL from a real consumer.",{"_3328":2072,"_29138":2039,"_20209":53847,"_5":13819,"_26493":53777,"_2816":53848},[],"Revoke the old CA once no legitimate traffic remains.",{"_3328":2073,"_29138":2039,"_20209":53850,"_5":13819,"_26493":53777,"_2816":53851},[],"Device retirement belongs to the IoT Fleets lifecycle. It affects the active identity; it does not automatically traverse and revoke every historical certificate. Review previous identities and consumer permissions separately in Device management.",{"_3328":2074,"_29138":2039,"_20209":53853,"_5":13819,"_26493":53781,"_2816":53854},[],"Certificates entering the preventive or critical renewal window.",{"_3328":2075,"_29138":2039,"_20209":53856,"_5":13819,"_26493":53781,"_2816":53857},[],"Repeated enrollment or re-enrollment failures.",{"_3328":2076,"_29138":2039,"_20209":53859,"_5":13819,"_26493":53781,"_2816":53860},[],"Status changes and revocation reasons.",{"_3328":2077,"_29138":2039,"_20209":53862,"_5":13819,"_26493":53781,"_2816":53863},[],"OCSP and CRL publication and validity.",{"_3328":2078,"_29138":2039,"_20209":53865,"_5":13819,"_26493":53781,"_2816":53866},[],"Dependencies still presenting a replaced certificate.",{"_3328":2079,"_29138":2039,"_20209":53868,"_5":13819,"_26493":53781,"_2816":53869},[],"The device history relates its previous and current identities. For administrative changes and mutation errors, see Audit logs.",{"_3328":2080,"_29138":2080,"_5":14177,"_2816":53871,"_29461":53872,"_20209":53873,"_26493":2080},"Trust model",[47397,48865,52871,53738],[],{"_3328":2081,"_29138":2080,"_20209":53875,"_5":13819,"_26493":2080,"_2816":53876},[],"Understand where trust originates, how it is distributed and what each component validates.",{"_3328":2082,"_29138":2080,"_5":29458,"_20209":53878,"_26493":53879,"_2816":53880},[],"/docs/platform/pki/concepts/trust-model#the-four-trust-decisions","The four trust decisions",{"_3328":2083,"_29138":2080,"_5":29458,"_20209":53882,"_26493":53883,"_2816":53884},[],"/docs/platform/pki/concepts/trust-model#who-can-issue","Who can issue",{"_3328":2084,"_29138":2080,"_5":29458,"_20209":53886,"_26493":53887,"_2816":53888},[],"/docs/platform/pki/concepts/trust-model#what-can-be-issued","What can be issued",{"_3328":2085,"_29138":2080,"_5":29458,"_20209":53890,"_26493":53891,"_2816":53892},[],"/docs/platform/pki/concepts/trust-model#who-can-request-it","Who can request it",{"_3328":2086,"_29138":2080,"_5":29458,"_20209":53894,"_26493":53895,"_2816":53896},[],"/docs/platform/pki/concepts/trust-model#who-accepts-the-result","Who accepts the result",{"_3328":2087,"_29138":2080,"_5":29458,"_20209":53898,"_26493":53899,"_2816":53900},[],"/docs/platform/pki/concepts/trust-model#identity-flow","Identity flow",{"_3328":2088,"_29138":2080,"_5":29458,"_20209":53902,"_26493":53903,"_2816":53904},[],"/docs/platform/pki/concepts/trust-model#enrollment-validation-and-distribution-cas","Enrollment, validation and distribution CAs",{"_3328":2089,"_29138":2080,"_5":29458,"_20209":53906,"_26493":53907,"_2816":53908},[],"/docs/platform/pki/concepts/trust-model#validation-and-revocation","Validation and revocation",{"_3328":2090,"_29138":2080,"_5":29458,"_20209":53910,"_26493":53911,"_2816":53912},[],"/docs/platform/pki/concepts/trust-model#custody-limits","Custody limits",{"_3328":2091,"_29138":2080,"_5":29458,"_20209":53914,"_26493":53915,"_2816":53916},[],"/docs/platform/pki/concepts/trust-model#recommended-pattern","Recommended pattern",{"_3328":2092,"_29138":2080,"_20209":53918,"_5":13819,"_26493":2080,"_2816":53919},[],"In Lamassu, trust does not simply mean that a certificate exists in the inventory. A consumer trusts an identity when it can build a chain to a root it recognizes, check that the certificate is fit for the intended use and verify that it is still valid.",{"_3328":2093,"_29138":2080,"_20209":53921,"_5":13819,"_26493":53883,"_2816":53922},[],"The CA hierarchy defines which authorities can sign. A root CA establishes the anchor of trust; intermediate CAs separate operating domains and avoid using the root for every issuance.",{"_3328":2094,"_29138":2080,"_20209":53924,"_5":13819,"_26493":53887,"_2816":53925},[],"Certificate profiles limit validity, subject, uses, extensions and cryptographic parameters. Possessing a CA does not replace an issuance policy.",{"_3328":2095,"_29138":2080,"_20209":53927,"_5":13819,"_26493":53891,"_2816":53928},[],"The DMS acts as the enrollment point. It can authenticate an EST request with a client certificate, an external webhook or a combination of both. CAs configured to validate the requester do not have to be the CA that will issue the new identity.",{"_3328":2096,"_29138":2080,"_20209":53930,"_5":13819,"_26493":53895,"_2816":53931},[],"The consumer keeps its own trust store. EST `/cacerts` can distribute the service TLS certificate, the enrollment CA and selected managed CAs. Initial trust for authenticating that service must come from an already trusted channel. Download and inspect the contents: do not assume they form a complete chain or install every entry as a root.",{"_3328":2097,"_29138":2080,"_20209":53933,"_5":13819,"_26493":53899,"_2816":53934},[],"The device proves it can enroll according to the DMS policy.",{"_3328":2098,"_29138":2080,"_20209":53936,"_5":13819,"_26493":53899,"_2816":53937},[],"The DMS validates the request and forwards the CSR to the enrollment CA.",{"_3328":2099,"_29138":2080,"_20209":53939,"_5":13819,"_26493":53899,"_2816":53940},[],"In the device-generated CSR flow, the CA applies the profile and signs without receiving the device’s private key.",{"_3328":2100,"_29138":2080,"_20209":53942,"_5":13819,"_26493":53899,"_2816":53943},[],"The device installs the certificate and the chain it needs.",{"_3328":2101,"_29138":2080,"_20209":53945,"_5":13819,"_26493":53899,"_2816":53946},[],"The system that trusts the device validates the chain, dates, uses and revocation status.",{"_3328":2102,"_29138":2080,"_20209":53948,"_5":13819,"_26493":53899,"_2816":53949},[],"OIDC or X.509 identifies the operator calling Lamassu. The authorization service decides which actions it may perform. The X.509 hierarchy, on the other hand, determines whether a certificate presented by a device is trustworthy.",{"_3328":2103,"_29138":2080,"_20209":53951,"_5":13819,"_26493":53903,"_2816":53952},[],"A DMS relates three sets that are worth designing separately:",{"_3328":2104,"_29138":2080,"_20209":53954,"_5":13819,"_26493":53903,"_2816":53955},[],"**Enrollment CA:** signs the new identities.",{"_3328":2105,"_29138":2080,"_20209":53957,"_5":13819,"_26493":53903,"_2816":53958},[],"**Validation CAs:** authenticate the client certificates used for enrollment or migration. During re-enrollment, the enrollment CA is always trusted and Lamassu then tries the validation CAs configured in the re-enrollment block; those are optional.",{"_3328":2106,"_29138":2080,"_20209":53960,"_5":13819,"_26493":53903,"_2816":53961},[],"**Distributed CAs:** form the content the device obtains through EST `/cacerts`. You can include the service TLS certificate, the enrollment CA and an explicit list of managed CAs. Including the issuer does not automatically add all its ancestors.",{"_3328":2107,"_29138":2080,"_20209":53963,"_5":13819,"_26493":53903,"_2816":53964},[],"This separation makes it possible to migrate a fleet: you temporarily accept certificates from the old hierarchy, issue with the new one and distribute both chains during the overlap.",{"_3328":2108,"_29138":2080,"_20209":53966,"_5":13819,"_26493":53907,"_2816":53967},[],"A valid chain does not by itself guarantee that a certificate should be accepted. The consumer must also check:",{"_3328":2109,"_29138":2080,"_20209":53969,"_5":13819,"_26493":53907,"_2816":53970},[],"that the current date is between `Not Before` and `Not After`;",{"_3328":2110,"_29138":2080,"_20209":53972,"_5":13819,"_26493":53907,"_2816":53973},[],"that `Key Usage` and `Extended Key Usage` allow the operation;",{"_3328":2111,"_29138":2080,"_20209":53975,"_5":13819,"_26493":53907,"_2816":53976},[],"that names, SANs and subject match the expected identity;",{"_3328":2112,"_29138":2080,"_20209":53978,"_5":13819,"_26493":53907,"_2816":53979},[],"that the certificate does not appear revoked in OCSP or a CRL.",{"_3328":2113,"_29138":2080,"_20209":53981,"_5":13819,"_26493":53907,"_2816":53982},[],"An OCSP `Good` status does not replace chain, date, usage and identity checks either; Validation brings those criteria together.",{"_3328":2114,"_29138":2080,"_20209":53984,"_5":13819,"_26493":53907,"_2816":53985},[],"During the mTLS authentication of a DMS, Lamassu attempts to check revocation. If the certificate does not contain enough information to perform that check, the backend logs a warning and continues treating it as not revoked. Design your profiles and distribution points to avoid that situation in production.",{"_3328":2115,"_29138":2080,"_20209":53987,"_5":13819,"_26493":53911,"_2816":53988},[],"The KMS keeps the reference to the key and delegates the operation to the configured engine. With an HSM or a cloud KMS, the private key can remain non-exportable. That protects custody, but it does not by itself prevent misuse: you still must restrict who can request a signature and audit those operations.",{"_3328":2116,"_29138":2080,"_20209":53990,"_5":13819,"_26493":53915,"_2816":53991},[],"Keep the root out of daily operations, or with very restricted access.",{"_3328":2117,"_29138":2080,"_20209":53993,"_5":13819,"_26493":53915,"_2816":53994},[],"Issue from intermediate CAs separated by environment or risk domain.",{"_3328":2118,"_29138":2080,"_20209":53996,"_5":13819,"_26493":53915,"_2816":53997},[],"Assign explicit profiles to every use case.",{"_3328":2119,"_29138":2080,"_20209":53999,"_5":13819,"_26493":53915,"_2816":54000},[],"Distribute the new trust before starting a rotation.",{"_3328":2120,"_29138":2080,"_20209":54002,"_5":13819,"_26493":53915,"_2816":54003},[],"Keep enough overlap to renew a disconnected fleet.",{"_3328":2121,"_29138":2080,"_20209":54005,"_5":13819,"_26493":53915,"_2816":54006},[],"Validate from the consuming system, not only from the Lamassu console.",{"_3328":2122,"_29138":2080,"_20209":54008,"_5":13819,"_26493":53915,"_2816":54009},[],"Continue with CA hierarchy and rotation to turn this model into an operating procedure.",{"_3328":2123,"_29138":2123,"_5":14177,"_2816":54011,"_29461":54012,"_20209":54013,"_26493":2123},"Revocation lists (CRL)",[47397,48865,52871,53498],[],{"_3328":2124,"_29138":2123,"_20209":54015,"_5":13819,"_26493":2123,"_2816":54016},[],"Generate and distribute signed lists to validate certificates offline.",{"_3328":2125,"_29138":2123,"_5":29458,"_20209":54018,"_26493":54019,"_2816":54020},[],"/docs/platform/pki/crl#va-role-and-per-ca-configuration","VA role and per-CA configuration",{"_3328":2126,"_29138":2123,"_5":29458,"_20209":54022,"_26493":54023,"_2816":54024},[],"/docs/platform/pki/crl#cas-that-share-a-key","CAs that share a key",{"_3328":2127,"_29138":2123,"_5":29458,"_20209":54026,"_26493":54027,"_2816":54028},[],"/docs/platform/pki/crl#periodic-and-automatic-regeneration","Periodic and automatic regeneration",{"_3328":2128,"_29138":2123,"_5":29458,"_20209":54030,"_26493":54031,"_2816":54032},[],"/docs/platform/pki/crl#crl-contents","CRL contents",{"_3328":2129,"_29138":2123,"_5":29458,"_20209":54034,"_26493":54035,"_2816":54036},[],"/docs/platform/pki/crl#public-download-endpoint","Public download endpoint",{"_3328":2130,"_29138":2123,"_5":29458,"_20209":54038,"_26493":54039,"_2816":54040},[],"/docs/platform/pki/crl#va-role-management-api","VA role management API",{"_3328":2131,"_29138":2123,"_5":29458,"_20209":54042,"_26493":54043,"_2816":54044},[],"/docs/platform/pki/crl#common-va-role-errors","Common VA role errors",{"_3328":2132,"_29138":2123,"_5":29458,"_20209":54046,"_26493":54047,"_2816":54048},[],"/docs/platform/pki/crl#from-the-interface","From the interface",{"_3328":2133,"_29138":2123,"_5":29458,"_20209":54050,"_26493":54051,"_2816":54052},[],"/docs/platform/pki/crl#references","References",{"_3328":2134,"_29138":2123,"_20209":54054,"_5":13819,"_26493":2123,"_2816":54055},[],"A CRL is an issuer-signed list of revoked certificates. This guide is for an operator publishing lists and an integrator using them locally. You need the issuing CA certificate, its SKI and access to the published endpoint. The client must maintain a current copy: offline operation still requires refreshing evidence.",{"_3328":2135,"_29138":2123,"_20209":54057,"_5":13819,"_26493":54019,"_2816":54058},[],"The VA role stores configuration and metadata for the latest list published for a CA’s SKI. Generation requires a usable issuer key; do not assume an imported CA without a key has an available CRL.",{"_3328":2136,"_29138":2123,"_20209":54060,"_5":13819,"_26493":54019,"_2816":54061},[],"`crl_options` field",{"_3328":2137,"_29138":2123,"_20209":54063,"_5":13819,"_26493":54019,"_2816":47787},[],{"_3328":2138,"_29138":2123,"_20209":54065,"_5":13819,"_26493":54019,"_2816":54066},[],"Backend initial value",{"_3328":2139,"_29138":2123,"_20209":54068,"_5":13819,"_26493":54019,"_2816":54069},[],"`validity`",{"_3328":2140,"_29138":2123,"_20209":54071,"_5":13819,"_26493":54019,"_2816":54072},[],"Time from `thisUpdate` to `nextUpdate`.",{"_3328":2141,"_29138":2123,"_20209":54074,"_5":13819,"_26493":54019,"_2816":54075},[],"7 days.",{"_3328":2142,"_29138":2123,"_20209":54077,"_5":13819,"_26493":54019,"_2816":54078},[],"`refresh_interval`",{"_3328":2143,"_29138":2123,"_20209":54080,"_5":13819,"_26493":54019,"_2816":54081},[],"Stored and returned by the API, but the VA does not use it: scheduled renewal does not depend on it (see Periodic and automatic regeneration).",{"_3328":2144,"_29138":2123,"_20209":54083,"_5":13819,"_26493":54019,"_2816":54084},[],"6 days and 23 hours.",{"_3328":2145,"_29138":2123,"_20209":54086,"_5":13819,"_26493":54019,"_2816":54087},[],"`regenerate_on_revoke`",{"_3328":2146,"_29138":2123,"_20209":54089,"_5":13819,"_26493":54019,"_2816":54090},[],"Request regeneration on revocation or reactivation from `CertificateHold` events.",{"_3328":2147,"_29138":2123,"_20209":54092,"_5":13819,"_26493":54019,"_2816":54093},[],"`true`.",{"_3328":2148,"_29138":2123,"_20209":54095,"_5":13819,"_26493":54019,"_2816":54096},[],"`signer_certificate_serial_number`",{"_3328":2149,"_29138":2123,"_20209":54098,"_5":13819,"_26493":54019,"_2816":54099},[],"Serial number of the existing certificate that signs the CRL.",{"_3328":2150,"_29138":2123,"_20209":54101,"_5":13819,"_26493":54019,"_2816":54102},[],"Serial number of the CA’s current certificate.",{"_3328":2151,"_29138":2123,"_20209":54104,"_5":13819,"_26493":54019,"_2816":54105},[],"The signer must be an existing certificate with the `cRLSign` key usage and the same subject and public key as the CA. Certificates from before a reissue qualify. A delegated signer is not supported: a certificate with the CA’s subject but a different key is rejected.",{"_3328":2152,"_29138":2123,"_20209":54107,"_5":13819,"_26493":54019,"_2816":54108},[],"When a CA is reissued, the role keeps pointing at the previous certificate. CRLs remain valid because both certificates share subject and key, but the previous certificate cannot be deleted while the role uses it. To retire it, update the role’s signer.",{"_3328":2153,"_29138":2123,"_20209":54110,"_5":13819,"_26493":54019,"_2816":54111},[],"When a CA is deleted, its VA role is kept and cannot be removed through the API. If no other CA with the same SKI remains, the role can be read but any `PUT` returns 404, and the renewal job logs a warning on every cycle because it no longer finds the CA. The API offers no way out; it can only be fixed by editing the database. If another CA with that SKI remains, the role is still editable (see CAs that share a key). Adjust validity and signer before deleting the CA.",{"_3328":2154,"_29138":2123,"_20209":54113,"_5":13819,"_26493":54019,"_2816":54114},[],"A CA whose certificate lacks `cRLSign` cannot generate its CRL or edit its role (400 error). Since 4.0 the VA requires this usage. Check before importing with `openssl x509 -noout -ext keyUsage` and, if it is missing, obtain a certificate for the same CA and key that includes it and set it as the signer with `PUT`. After reissuing a CA, also check the key usage of the new certificate: it may not keep the original’s usages.",{"_3328":2155,"_29138":2123,"_20209":54116,"_5":13819,"_26493":54019,"_2816":54117},[],"`PUT` always validates the signer, even when the request does not change it. If the stored signer is no longer valid, no field of the role can be modified, not even the validity, until a valid one is set.",{"_3328":2156,"_29138":2123,"_20209":54119,"_5":13819,"_26493":54019,"_2816":54120},[],"`latest_crl` contains version, validity start and end. Versions are kept as PEM in object storage at `pki/va/crl/{subject_key_id}/{version}.crl`; the public endpoint returns DER.",{"_3328":2157,"_29138":2123,"_20209":54122,"_5":13819,"_26493":54023,"_2816":54123},[],"The VA identifies each CRL by the CA’s SKI, and the SKI is derived from its key. Two CAs with the same key have the same SKI and share a single VA role and a single CRL. This happens when a CA is created on an existing KMS key, or when a CA is imported whose certificate declares an SKI already in use. Lamassu takes the SKI of an imported certificate as-is and does not check that it corresponds to its public key. The first CA creates the role and the others keep it.",{"_3328":2158,"_29138":2123,"_20209":54125,"_5":13819,"_26493":54023,"_2816":54126},[],"The certificates of all of them point to `/crl/{ski}`, but the published list has the first CA as issuer and only includes its revocations. A verifier compares the CRL issuer with the issuer of the certificate it validates (RFC 5280, §6.3.2) and rejects the list if they differ. Depending on its policy, the certificate is blocked (*hard-fail*) or accepted even though it is revoked (*soft-fail*). Revocations of the secondary CAs do not appear in any list.",{"_3328":2159,"_29138":2123,"_20209":54128,"_5":13819,"_26493":54023,"_2816":54129},[],"If the first CA is deleted, CRL generation for the remaining one fails because the configured signer no longer matches a CA with that name. Until the role’s signer is updated to a certificate of the remaining CA, the last published list keeps being served until it expires (7 days by default).",{"_3328":2160,"_29138":2123,"_20209":54131,"_5":13819,"_26493":54023,"_2816":54132},[],"To detect the problem, compare the SKI of the CAs in the inventory: two with the same SKI are affected. To fix it, create a CA with its own key and reissue its certificates; those already issued keep the old URL and are not corrected until reissued. A CA imported with an SKI already in use does not replace the existing one as CRL issuer, because the issuer is resolved from the role’s signer. However, its own certificates point to that same URL and its revocations are not published. Until Lamassu rejects these imports, restrict the permission to import CAs as an interim control; it covers only the import path. Creating a CA with &#x2A;*Create New CA (Existing Key)** on a KMS key another CA already uses produces the same collision, so also avoid reusing keys across CAs. A per-CA CRL and the rejection of imports whose SKI collides with an existing CA are both proposed in lamassuiot#834, and neither is implemented yet.",{"_3328":2161,"_29138":2123,"_20209":54134,"_5":13819,"_26493":54027,"_2816":54135},[],"The VA scheduled job checks every role on each run and requests another list when the remaining validity of `latest_crl` is less than the interval between runs. The frequency is set in Helm with `services.va.job.crl.frequency` (default `0 * * * *`) and accepts a duration (`1h`) or a cron expression. A cron expression is converted into a constant interval equal to the time left until its next firing when the service starts, so it is not aligned with the clock. `refresh_interval` plays no part. Keep `validity` well above the interval: with a shorter validity, the list is regenerated on every cycle.",{"_3328":2162,"_29138":2123,"_20209":54137,"_5":13819,"_26493":54027,"_2816":54138},[],"If generation fails (for example, because of a role without a CA or an invalid signer), the job logs the warning `something went wrong while calculating CRL for CA <ski>` and retries on the next cycle. There is no other renewal path until the cause is fixed, and the last published list keeps being served until it expires. All of this depends on working jobs, storage and signing.",{"_3328":2163,"_29138":2123,"_20209":54140,"_5":13819,"_26493":54027,"_2816":54141},[],"With `regenerate_on_revoke`, the event handler requests a new CRL upon revocation or reactivation from `CertificateHold` to `ACTIVE`. This happens after the status change and has its own failure paths: if it fails (missing role, invalid signer), the event is retried and, once retries are exhausted, moves to the failed-events queue. Confirming revocation does not establish that the new CRL is already published or that all clients have downloaded it.",{"_3328":2164,"_29138":2123,"_20209":54143,"_5":13819,"_26493":54027,"_2816":54144},[],"Compare CRL numbers and timestamps before and after a change. Monitor expired lists and generation failures; clients must apply policy when current evidence is unavailable.",{"_3328":2165,"_29138":2123,"_20209":54146,"_5":13819,"_26493":54031,"_2816":54147},[],"Each entry contains serial number, revocation time and reason. The generator queries certificates in `REVOKED` state for the selected CA. A reactivated certificate disappears when the list is recalculated; an earlier downloaded copy retains its contents.",{"_3328":2166,"_29138":2123,"_20209":54149,"_5":13819,"_26493":54031,"_2816":54150},[],"The list contains a critical *Issuing Distribution Point* (OID `2.5.29.28`) with configured distribution URLs. Check that your client interprets this extension and that it matches the list’s scope. If rejected, investigate format and scope; ignoring a critical extension is not successful validation.",{"_3328":2167,"_29138":2123,"_20209":54152,"_5":13819,"_26493":54035,"_2816":54153},[],"The VA service exposes `GET /crl/{subject_key_id}` without management authorization. Use the **issuing CA’s** SKI, not the end-entity certificate’s SKI or serial. First inspect the certificate’s CDP:",{"_3328":2168,"_29138":2123,"_20209":54155,"_5":13819,"_26493":54035,"_2816":54156},[],"Replace the following URL with the CDP URL and review exposure in Deployment:",{"_3328":2169,"_29138":2123,"_20209":54158,"_5":13819,"_26493":54035,"_2816":54159},[],"You need OpenSSL 3.x and `issuer.pem` containing the direct issuer’s certificate. Require a valid signature, current timestamps and the expected issuer. For a root that issues directly:",{"_3328":2170,"_29138":2123,"_20209":54161,"_5":13819,"_26493":54035,"_2816":54162},[],"`roots.pem` contains deliberately trusted roots. For intermediates, add `-untrusted intermediates.pem` before the `device.crt` argument. `-crl_check` checks the end-entity certificate’s revocation against the local list; it does not download other lists or establish the status of the whole chain. A complete chain check needs the corresponding CRLs and a policy requiring them.",{"_3328":2171,"_29138":2123,"_20209":54164,"_5":13819,"_26493":54035,"_2816":54165},[],"The test should accept an allowed certificate absent from the list and reject it with `certificate revoked` after publishing and using the list containing its serial.",{"_3328":2172,"_29138":2123,"_20209":54167,"_5":13819,"_26493":54039,"_2816":54168},[],"The following paths are relative to the VA service; confirm the public prefix in the Gateway. They are not the URLs of the public OCSP and CRL endpoints.",{"_3328":2173,"_29138":2123,"_20209":54170,"_5":13819,"_26493":54039,"_2816":50629},[],{"_3328":2174,"_29138":2123,"_20209":54172,"_5":13819,"_26493":54039,"_2816":54173},[],"Relative path",{"_3328":2175,"_29138":2123,"_20209":54175,"_5":13819,"_26493":54039,"_2816":50626},[],{"_3328":2176,"_29138":2123,"_20209":54177,"_5":13819,"_26493":54039,"_2816":54178},[],"`GET`",{"_3328":2177,"_29138":2123,"_20209":54180,"_5":13819,"_26493":54039,"_2816":54181},[],"`/v1/roles/{ca-ski}`",{"_3328":2178,"_29138":2123,"_20209":54183,"_5":13819,"_26493":54039,"_2816":54184},[],"Read `crl_options` and `latest_crl`.",{"_3328":2179,"_29138":2123,"_20209":54186,"_5":13819,"_26493":54039,"_2816":54187},[],"`PUT`",{"_3328":2180,"_29138":2123,"_20209":54189,"_5":13819,"_26493":54039,"_2816":54181},[],{"_3328":2181,"_29138":2123,"_20209":54191,"_5":13819,"_26493":54039,"_2816":54192},[],"Replace CRL configuration.",{"_3328":2182,"_29138":2123,"_20209":54194,"_5":13819,"_26493":54039,"_2816":54195},[],"You need authentication and role read or update permissions. Consult your installation’s API reference and Access control. Read current configuration before updating and send the full object expected by the contract: the backend replaces `crl_options`; it does not merge omitted fields.",{"_3328":2183,"_29138":2123,"_20209":54197,"_5":13819,"_26493":54039,"_2816":54198},[],"After a change, check saved configuration and the next list actually published. Updating the role alone does not establish regeneration or client acceptance.",{"_3328":2184,"_29138":2123,"_20209":54200,"_5":13819,"_26493":54043,"_2816":54201},[],"Symptom",{"_3328":2185,"_29138":2123,"_20209":54203,"_5":13819,"_26493":54043,"_2816":54204},[],"Cause",{"_3328":2186,"_29138":2123,"_20209":54206,"_5":13819,"_26493":54043,"_2816":54207},[],"Action",{"_3328":2187,"_29138":2123,"_20209":54209,"_5":13819,"_26493":54043,"_2816":54210},[],"`PUT /v1/roles/{ca-ski}` returns 404 and `GET` returns 200.",{"_3328":2188,"_29138":2123,"_20209":54212,"_5":13819,"_26493":54043,"_2816":54213},[],"The role’s CA was deleted and no other CA with the same SKI remains.",{"_3328":2189,"_29138":2123,"_20209":54215,"_5":13819,"_26493":54043,"_2816":54216},[],"There is no API way out; it requires database intervention. Avoid it by adjusting the role before deleting the CA.",{"_3328":2190,"_29138":2123,"_20209":54218,"_5":13819,"_26493":54043,"_2816":54219},[],"`PUT` returns 400.",{"_3328":2191,"_29138":2123,"_20209":54221,"_5":13819,"_26493":54043,"_2816":54222},[],"The signer lacks `cRLSign`, or its subject and key match no CA with that SKI (for example, after deleting the first of two CAs that share a key).",{"_3328":2192,"_29138":2123,"_20209":54224,"_5":13819,"_26493":54043,"_2816":54225},[],"Use `PUT` to set the serial number of a valid certificate of the remaining CA.",{"_3328":2193,"_29138":2123,"_20209":54227,"_5":13819,"_26493":54043,"_2816":54228},[],"`PUT` returns 400 from a 3.x client.",{"_3328":2194,"_29138":2123,"_20209":54230,"_5":13819,"_26493":54043,"_2816":54231},[],"`crl_options.subject_key_id_signer` was replaced by `signer_certificate_serial_number`, which is required.",{"_3328":2195,"_29138":2123,"_20209":54233,"_5":13819,"_26493":54043,"_2816":54234},[],"Update the client to send the new field.",{"_3328":2196,"_29138":2123,"_20209":54236,"_5":13819,"_26493":54043,"_2816":54237},[],"The CRL does not change after revoking a certificate.",{"_3328":2197,"_29138":2123,"_20209":54239,"_5":13819,"_26493":54043,"_2816":54240},[],"`regenerate_on_revoke` is `false`, or the event failed because of a missing role or an invalid signer.",{"_3328":2198,"_29138":2123,"_20209":54242,"_5":13819,"_26493":54043,"_2816":54243},[],"Check the VA logs and the failed-events queue; fix the signer.",{"_3328":2199,"_29138":2123,"_20209":54245,"_5":13819,"_26493":54043,"_2816":54246},[],"A verifier rejects the CRL because of the issuer.",{"_3328":2200,"_29138":2123,"_20209":54248,"_5":13819,"_26493":54043,"_2816":54249},[],"Several CAs share an SKI.",{"_3328":2201,"_29138":2123,"_20209":54251,"_5":13819,"_26493":54043,"_2816":54252},[],"See CAs that share a key.",{"_3328":2202,"_29138":2123,"_20209":54254,"_5":13819,"_26493":54047,"_2816":54255},[],"The CA view lets you inspect and download the available list. Compare version, issuer and timestamps with the copy downloaded from the public endpoint. Diagnose differences using PKI troubleshooting.",{"_3328":2203,"_29138":2123,"_20209":54257,"_5":13819,"_26493":54051,"_2816":54258},[],"RFC 5280: X.509 and CRL profile.",{"_3328":2204,"_29138":2123,"_20209":54260,"_5":13819,"_26493":54051,"_2816":54261},[],"OpenSSL: openssl-crl.",{"_3328":2205,"_29138":2123,"_20209":54263,"_5":13819,"_26493":54051,"_2816":54264},[],"OpenSSL: openssl-verify.",{"_3328":2206,"_29138":2123,"_20209":54266,"_5":13819,"_26493":54051,"_2816":54267},[],"<Card title=\"OCSP service\" href=\"/docs/platform/pki/ocsp\" />",{"_3328":2207,"_29138":2123,"_20209":54269,"_5":13819,"_26493":54051,"_2816":54270},[],"<Card title=\"Certificate validation\" href=\"/docs/platform/pki/certificate-validation\" />",{"_3328":2208,"_29138":2208,"_5":14177,"_2816":54272,"_29461":54273,"_20209":54274,"_26493":2208},"Keys and cryptographic engines",[47397,48865,52871,52872],[],{"_3328":2209,"_29138":2208,"_20209":54276,"_5":13819,"_26493":2208,"_2816":54277},[],"Generate, import and operate keys without coupling the PKI to a specific provider.",{"_3328":2210,"_29138":2208,"_5":29458,"_20209":54279,"_26493":54280,"_2816":54281},[],"/docs/platform/pki/key-management#what-the-kms-solves","What the KMS solves",{"_3328":2211,"_29138":2208,"_5":29458,"_20209":54283,"_26493":54284,"_2816":54285},[],"/docs/platform/pki/key-management#cryptographic-engines","Cryptographic engines",{"_3328":2212,"_29138":2208,"_5":29458,"_20209":54287,"_26493":54288,"_2816":54289},[],"/docs/platform/pki/key-management#file-system","File System",{"_3328":2213,"_29138":2208,"_5":29458,"_20209":54291,"_26493":54292,"_2816":54293},[],"/docs/platform/pki/key-management#hashicorp-vault","HashiCorp Vault",{"_3328":2214,"_29138":2208,"_5":29458,"_20209":54295,"_26493":54296,"_2816":54297},[],"/docs/platform/pki/key-management#aws-secrets-manager","AWS Secrets Manager",{"_3328":2215,"_29138":2208,"_5":29458,"_20209":54299,"_26493":54300,"_2816":54301},[],"/docs/platform/pki/key-management#aws-kms","AWS KMS",{"_3328":2216,"_29138":2208,"_5":29458,"_20209":54303,"_26493":54304,"_2816":54305},[],"/docs/platform/pki/key-management#pkcs11","PKCS#11",{"_3328":2217,"_29138":2208,"_5":29458,"_20209":54307,"_26493":54308,"_2816":54309},[],"/docs/platform/pki/key-management#azure-key-vault","Azure Key Vault",{"_3328":2218,"_29138":2208,"_5":29458,"_20209":54311,"_26493":54312,"_2816":54313},[],"/docs/platform/pki/key-management#key-inventory","Key inventory",{"_3328":2219,"_29138":2208,"_5":29458,"_20209":54315,"_26493":54316,"_2816":54317},[],"/docs/platform/pki/key-management#create-or-import-keys","Create or import keys",{"_3328":2220,"_29138":2208,"_5":29458,"_20209":54319,"_26493":54320,"_2816":54321},[],"/docs/platform/pki/key-management#generate-a-new-key-pair","Generate a new key pair",{"_3328":2221,"_29138":2208,"_5":29458,"_20209":54323,"_26493":54324,"_2816":54325},[],"/docs/platform/pki/key-management#import-an-existing-pair","Import an existing pair",{"_3328":2222,"_29138":2208,"_5":29458,"_20209":54327,"_26493":54328,"_2816":54329},[],"/docs/platform/pki/key-management#operations-on-a-key","Operations on a key",{"_3328":2223,"_29138":2208,"_5":29458,"_20209":54331,"_26493":54332,"_2816":54333},[],"/docs/platform/pki/key-management#view-details","View details",{"_3328":2224,"_29138":2208,"_5":29458,"_20209":54335,"_26493":54336,"_2816":54337},[],"/docs/platform/pki/key-management#sign-and-verify","Sign and verify",{"_3328":2225,"_29138":2208,"_5":29458,"_20209":54339,"_26493":54340,"_2816":54341},[],"/docs/platform/pki/key-management#sign","Sign",{"_3328":2226,"_29138":2208,"_5":29458,"_20209":54343,"_26493":54344,"_2816":54345},[],"/docs/platform/pki/key-management#verify","Verify",{"_3328":2227,"_29138":2208,"_5":29458,"_20209":54347,"_26493":54348,"_2816":54349},[],"/docs/platform/pki/key-management#generate-a-csr","Generate a CSR",{"_3328":2228,"_29138":2208,"_5":29458,"_20209":54351,"_26493":54352,"_2816":54353},[],"/docs/platform/pki/key-management#sign-locally-with-pkcs11","Sign locally with PKCS#11",{"_3328":2229,"_29138":2208,"_5":29458,"_20209":54355,"_26493":54356,"_2816":54357},[],"/docs/platform/pki/key-management#before-deleting-a-key","Before deleting a key",{"_3328":2230,"_29138":2208,"_20209":54359,"_5":13819,"_26493":2208,"_2816":54360},[],"The Cryptographic Key Management Service (KMS) of Lamassu IoT centralizes the generation, import, custody and use of the platform's keys. This is where you manage the keys that support the CAs and the rest of the signing operations that depend on the PKI.",{"_3328":2231,"_29138":2208,"_20209":54362,"_5":13819,"_26493":2208,"_2816":54363},[],"In the current configuration, Lamassu IoT works exclusively with asymmetric keys, such as RSA and elliptic curves. These keys are used to issue X.509 certificates, sign requests and perform authentication and validation operations within the system.",{"_3328":2232,"_29138":2208,"_20209":54365,"_5":13819,"_26493":54280,"_2816":54366},[],"The KMS unifies key lifecycle management and prevents every service from having to integrate directly with a specific cryptographic provider.",{"_3328":2233,"_29138":2208,"_20209":54368,"_5":13819,"_26493":54280,"_2816":54369},[],"In practice, it lets you:",{"_3328":2234,"_29138":2208,"_20209":54371,"_5":13819,"_26493":54280,"_2816":54372},[],"Generate new key pairs from Lamassu IoT.",{"_3328":2235,"_29138":2208,"_20209":54374,"_5":13819,"_26493":54280,"_2816":54375},[],"Import keys created externally.",{"_3328":2236,"_29138":2208,"_20209":54377,"_5":13819,"_26493":54280,"_2816":54378},[],"Delegate custody and cryptographic operations to external engines.",{"_3328":2237,"_29138":2208,"_20209":54380,"_5":13819,"_26493":54280,"_2816":54381},[],"Reuse existing keys for CAs, CSRs and signing or verification tasks.",{"_3328":2238,"_29138":2208,"_20209":54383,"_5":13819,"_26493":54284,"_2816":54384},[],"Lamassu can work with different cryptographic engines depending on deployment requirements. In some environments a software engine is enough; in others custody must be delegated to an HSM, a cloud service or a specialized platform.",{"_3328":2239,"_29138":2208,"_20209":54386,"_5":13819,"_26493":54284,"_2816":54387},[],"A single instance can have several engines configured at the same time, including multiple instances of the same type. This lets you adapt operations to different security, cost and regulatory requirements.",{"_3328":2240,"_29138":2208,"_20209":54389,"_5":13819,"_26493":54284,"_2816":54390},[],"This guide is for the PKI operator: select and use an already enabled engine. Installation, credentials, persistent storage and connectivity belong to Deployment. Before generating a CA, check the default engine, advertised algorithms and a test signature. Availability in your installation depends on its version and configuration.",{"_3328":2241,"_29138":2208,"_20209":54392,"_5":13819,"_26493":54288,"_2816":54393},[],"Generates software keys and stores private material in files. Custody depends on installation permissions, storage and backups. Before using it for an operational CA, agree how the key will be recovered and how replicas will access it; the KMS record does not replace those files.",{"_3328":2242,"_29138":2208,"_20209":54395,"_5":13819,"_26493":54292,"_2816":54396},[],"The adapter uses KV storage for private material. This is not signing within Vault Transit: someone able to read the secret can recover the key. Review read permissions, availability and recovery with the deployment owner.",{"_3328":2243,"_29138":2208,"_20209":54398,"_5":13819,"_26493":54292,"_2816":54399},[],"The adapter reaches Vault over its configured HTTP(S) endpoint. The Vault server certificate is verified against the system trust store; a Vault signed by a private CA is trusted by adding its CA certificate to the engine's `ca_cert_file` (PEM-encoded). `insecure_skip_verify=true` disables verification and is a last resort; agree the transport settings with the deployment owner.",{"_3328":2244,"_29138":2208,"_20209":54401,"_5":13819,"_26493":54296,"_2816":54402},[],"Offers encrypted persistence in AWS at a cost. It protects the key at rest, but an authorized administrator can recover it; it does not provide the same extraction resistance as a KMS or HSM.",{"_3328":2245,"_29138":2208,"_20209":54404,"_5":13819,"_26493":54300,"_2816":54405},[],"Delegates signing to AWS KMS. The adapter also implements external material import, subject to provider capabilities and permissions. A key generated outside the service has already existed outside its custody; importing it does not remove those copies. Check generation, import and signing as separate operations.",{"_3328":2246,"_29138":2208,"_20209":54407,"_5":13819,"_26493":54304,"_2816":54408},[],"Allows integrating local HSMs, isolated environments and *Key as a Service* offerings. Generation, persistence and extraction resistance depend on the specific device or provider. It is the most flexible option when policy requires hardware custody.",{"_3328":2247,"_29138":2208,"_20209":54410,"_5":13819,"_26493":54308,"_2816":54411},[],"The backend also provides adapters for **Key Vault Keys** and **Key Vault Secrets**. The former delegates signing to the key service; the latter stores private material as secrets and signs using that material. These are different custody models. Confirm which adapter is enabled in your installation and test the required operations.",{"_3328":2248,"_29138":2208,"_20209":54413,"_5":13819,"_26493":54308,"_2816":54414},[],"Lamassu shows the enabled engines in the console.",{"_3328":2249,"_29138":2208,"_20209":54416,"_5":13819,"_26493":54308,"_2816":54417},[],"Each engine defines which algorithms it supports, such as RSA or ECC/ECDSA, and which key sizes it can generate.",{"_3328":2250,"_29138":2208,"_20209":54419,"_5":13819,"_26493":54308,"_2816":54420},[],"Confirm with the deployment operator which engine is configured as the default. That engine will be used when a process needs to create or persist a key and the user has not selected a specific one, for example when creating or importing a CA.",{"_3328":2251,"_29138":2208,"_20209":54422,"_5":13819,"_26493":54312,"_2816":54423},[],"The main KMS screen shows the complete inventory of keys registered in the system. It is the reference view for reviewing which keys exist, where they are kept and which entities they relate to.",{"_3328":2252,"_29138":2208,"_20209":54425,"_5":13819,"_26493":54312,"_2816":54426},[],"The table includes the following fields:",{"_3328":2253,"_29138":2208,"_20209":54428,"_5":13819,"_26493":54312,"_2816":54429},[],"**Name**: descriptive name of the key.",{"_3328":2254,"_29138":2208,"_20209":54431,"_5":13819,"_26493":54312,"_2816":54432},[],"**Type**: algorithm and key size, for example RSA 2048 or EC P-256.",{"_3328":2255,"_29138":2208,"_20209":54434,"_5":13819,"_26493":54312,"_2816":54435},[],"**Strength**: visual indicator of cryptographic strength.",{"_3328":2256,"_29138":2208,"_20209":54437,"_5":13819,"_26493":54312,"_2816":54438},[],"**Public/Private**: whether Lamassu manages the full pair or only the public key.",{"_3328":2257,"_29138":2208,"_20209":54440,"_5":13819,"_26493":54312,"_2816":54441},[],"**Crypto Engine**: cryptographic engine keeping the key.",{"_3328":2258,"_29138":2208,"_20209":54443,"_5":13819,"_26493":54312,"_2816":54444},[],"**Aliases**: alternative names associated with the key.",{"_3328":2259,"_29138":2208,"_20209":54446,"_5":13819,"_26493":54312,"_2816":54447},[],"**Tags**: labels for classification and search.",{"_3328":2260,"_29138":2208,"_20209":54449,"_5":13819,"_26493":54312,"_2816":54450},[],"**Related Entities**: certificates or other entities linked to that key.",{"_3328":2261,"_29138":2208,"_20209":54452,"_5":13819,"_26493":54312,"_2816":54453},[],"From this view you also reach the most common actions:",{"_3328":2262,"_29138":2208,"_20209":54455,"_5":13819,"_26493":54312,"_2816":54456},[],"**View Details** to inspect metadata, identifiers and relationships.",{"_3328":2263,"_29138":2208,"_20209":54458,"_5":13819,"_26493":54312,"_2816":54459},[],"**Generate CSR** to create a PKCS#10 request with the selected key.",{"_3328":2264,"_29138":2208,"_20209":54461,"_5":13819,"_26493":54312,"_2816":54462},[],"**Sign / Verify** to test cryptographic operations on the key.",{"_3328":2265,"_29138":2208,"_20209":54464,"_5":13819,"_26493":54312,"_2816":54465},[],"**Delete Key** to remove the key from the system.",{"_3328":2266,"_29138":2208,"_20209":54467,"_5":13819,"_26493":54316,"_2816":54468},[],"You need key administration permissions and a reachable engine. The issuance profile must allow the chosen algorithm if the key will be used in a CA or CSR. Open **Create New Key** and choose generation or import.",{"_3328":2267,"_29138":2208,"_20209":54470,"_5":13819,"_26493":54320,"_2816":54471},[],"If the key will be born inside Lamassu, the recommended flow is to generate a new pair managed directly by one of the configured engines.",{"_3328":2268,"_29138":2208,"_20209":54473,"_5":13819,"_26493":54320,"_2816":54474},[],"On the wizard's first screen, choose **Generate New Key Pair** and then define the main parameters:",{"_3328":2269,"_29138":2208,"_20209":54476,"_5":13819,"_26493":54320,"_2816":54477},[],"**Key Name**: unique and descriptive name.",{"_3328":2270,"_29138":2208,"_20209":54479,"_5":13819,"_26493":54320,"_2816":54480},[],"**Crypto Engine**: engine that will keep the key.",{"_3328":2271,"_29138":2208,"_20209":54482,"_5":13819,"_26493":54320,"_2816":54483},[],"**Key Type** and **Key Size**: algorithm and size or curve.",{"_3328":2272,"_29138":2208,"_20209":54485,"_5":13819,"_26493":54320,"_2816":54486},[],"**Tags**: metadata to classify the key.",{"_3328":2273,"_29138":2208,"_20209":54488,"_5":13819,"_26493":54320,"_2816":54489},[],"**Metadata**: additional information for advanced uses.",{"_3328":2274,"_29138":2208,"_20209":54491,"_5":13819,"_26493":54324,"_2816":54492},[],"Importing lets you register in Lamassu a key generated outside the platform. It is the usual flow in BYOK scenarios, migrations or integration with cryptographic material already in production.",{"_3328":2275,"_29138":2208,"_20209":54494,"_5":13819,"_26493":54324,"_2816":54495},[],"When you have an exportable private key and the destination engine supports import.",{"_3328":2276,"_29138":2208,"_20209":54497,"_5":13819,"_26493":54324,"_2816":54498},[],"When an existing PKI needs to be migrated without reissuing certificates.",{"_3328":2277,"_29138":2208,"_20209":54500,"_5":13819,"_26493":54324,"_2816":54501},[],"When Lamassu must operate with a root of trust created by a third party.",{"_3328":2278,"_29138":2208,"_20209":54503,"_5":13819,"_26493":54324,"_2816":54504},[],"In the wizard, choose **Import Existing Key Pair** and complete the requested fields:",{"_3328":2279,"_29138":2208,"_20209":54506,"_5":13819,"_26493":54324,"_2816":54507},[],"**Key Name**: descriptive name within Lamassu IoT.",{"_3328":2280,"_29138":2208,"_20209":54509,"_5":13819,"_26493":54324,"_2816":54510},[],"**Crypto Engine**: engine that will keep the imported key.",{"_3328":2281,"_29138":2208,"_20209":54512,"_5":13819,"_26493":54324,"_2816":54513},[],"**Tags**: labels for organization and search.",{"_3328":2282,"_29138":2208,"_20209":54515,"_5":13819,"_26493":54324,"_2816":54516},[],"**Metadata**: additional optional information.",{"_3328":2283,"_29138":2208,"_20209":54518,"_5":13819,"_26493":54324,"_2816":54519},[],"**Private Key (PEM)**: private key in PEM format.",{"_3328":2284,"_29138":2208,"_20209":54521,"_5":13819,"_26493":54324,"_2816":54522},[],"After a successful import, open the record, check the engine and public key, and perform a test signature. A non-exportable HSM key cannot be uploaded through this PEM form: configure engine access and check how the existing key is registered. Review dependencies and any provider resources already created if an operation fails partway through.",{"_3328":2285,"_29138":2208,"_20209":54524,"_5":13819,"_26493":54328,"_2816":54525},[],"Each registered key has a detail view and several operational actions.",{"_3328":2286,"_29138":2208,"_20209":54527,"_5":13819,"_26493":54332,"_2816":54528},[],"The **View Details** screen concentrates the technical and administrative information of the key.",{"_3328":2287,"_29138":2208,"_20209":54530,"_5":13819,"_26493":54332,"_2816":54531},[],"The **Overview** tab shows, among others, these fields:",{"_3328":2288,"_29138":2208,"_20209":54533,"_5":13819,"_26493":54332,"_2816":54534},[],"**Key Name**: descriptive name.",{"_3328":2289,"_29138":2208,"_20209":54536,"_5":13819,"_26493":54332,"_2816":54537},[],"**Key Identifier**: unique system identifier. Lamassu uses PKCS11-based ID formats.",{"_3328":2290,"_29138":2208,"_20209":54539,"_5":13819,"_26493":54332,"_2816":54540},[],"**Tags**: associated labels.",{"_3328":2291,"_29138":2208,"_20209":54542,"_5":13819,"_26493":54332,"_2816":54543},[],"**Aliases**: alternative names.",{"_3328":2292,"_29138":2208,"_20209":54545,"_5":13819,"_26493":54332,"_2816":54546},[],"**Crypto Engine**: engine where the key resides.",{"_3328":2293,"_29138":2208,"_20209":54548,"_5":13819,"_26493":54332,"_2816":54549},[],"**Algorithm, Key Size & Strength**: algorithm, parameters and strength level.",{"_3328":2294,"_29138":2208,"_20209":54551,"_5":13819,"_26493":54332,"_2816":54552},[],"The **Related Entities** section shows which Lamassu objects depend on that key.",{"_3328":2295,"_29138":2208,"_20209":54554,"_5":13819,"_26493":54332,"_2816":54555},[],"The **Public Key** tab shows public material in PEM. The record’s identifier and URI locate the key; a PKCS#11-formatted URI does not establish that the engine is an HSM or that a local module can access it.",{"_3328":2296,"_29138":2208,"_20209":54557,"_5":13819,"_26493":54336,"_2816":54558},[],"The **Sign / Verify** action validates that the key and the cryptographic engine work correctly.",{"_3328":2297,"_29138":2208,"_20209":54560,"_5":13819,"_26493":54336,"_2816":54561},[],"Sign a test message, save the signature and verify it using the same public key, algorithm and encoding. Then change the message: verification should fail. This tests one operation; it does not establish every engine capability or a CA’s chain.",{"_3328":2298,"_29138":2208,"_20209":54563,"_5":13819,"_26493":54336,"_2816":54564},[],"When you open it, two areas appear: **Sign** and **Verify**.",{"_3328":2299,"_29138":2208,"_20209":54566,"_5":13819,"_26493":54340,"_2816":54567},[],"This tab uses the private key to generate a digital signature over a message or an already computed *digest*.",{"_3328":2300,"_29138":2208,"_20209":54569,"_5":13819,"_26493":54340,"_2816":54570},[],"Main fields:",{"_3328":2301,"_29138":2208,"_20209":54572,"_5":13819,"_26493":54340,"_2816":54573},[],"**Algorithm**: signing algorithm available for the key type.",{"_3328":2302,"_29138":2208,"_20209":54575,"_5":13819,"_26493":54340,"_2816":54576},[],"**Message Type**: `Raw` for clear data or `Digest` for a precomputed hash.",{"_3328":2303,"_29138":2208,"_20209":54578,"_5":13819,"_26493":54340,"_2816":54579},[],"**Payload Encoding**: input encoding, such as UTF-8, Hex or Base64.",{"_3328":2304,"_29138":2208,"_20209":54581,"_5":13819,"_26493":54340,"_2816":54582},[],"**Message**: content to sign.",{"_3328":2305,"_29138":2208,"_20209":54584,"_5":13819,"_26493":54340,"_2816":54585},[],"**Signature**: result of the operation, shown in hexadecimal.",{"_3328":2306,"_29138":2208,"_20209":54587,"_5":13819,"_26493":54344,"_2816":54588},[],"This tab checks whether a signature corresponds to the associated public key.",{"_3328":2307,"_29138":2208,"_20209":54590,"_5":13819,"_26493":54344,"_2816":54570},[],{"_3328":2308,"_29138":2208,"_20209":54592,"_5":13819,"_26493":54344,"_2816":54593},[],"**Algorithm**: must match the algorithm used for the signature.",{"_3328":2309,"_29138":2208,"_20209":54595,"_5":13819,"_26493":54344,"_2816":54596},[],"**Message Type**: `Raw` or `Digest`.",{"_3328":2310,"_29138":2208,"_20209":54598,"_5":13819,"_26493":54344,"_2816":54599},[],"**Payload Encoding**: encoding of the message.",{"_3328":2311,"_29138":2208,"_20209":54601,"_5":13819,"_26493":54344,"_2816":54602},[],"**Message**: original message or hash.",{"_3328":2312,"_29138":2208,"_20209":54604,"_5":13819,"_26493":54344,"_2816":54605},[],"**Signature**: signature to check.",{"_3328":2313,"_29138":2208,"_20209":54607,"_5":13819,"_26493":54344,"_2816":54608},[],"**Result**: indicator of the validation result.",{"_3328":2314,"_29138":2208,"_20209":54610,"_5":13819,"_26493":54348,"_2816":54611},[],"The **Generate CSR** action creates a PKCS#10 request signed with the private key kept in Lamassu, without exposing it outside the cryptographic engine.",{"_3328":2315,"_29138":2208,"_20209":54613,"_5":13819,"_26493":54348,"_2816":54614},[],"This flow is useful for:",{"_3328":2316,"_29138":2208,"_20209":54616,"_5":13819,"_26493":54348,"_2816":54617},[],"Requesting certificates from an external CA.",{"_3328":2317,"_29138":2208,"_20209":54619,"_5":13819,"_26493":54348,"_2816":54620},[],"Renewing an identity while keeping the same key.",{"_3328":2318,"_29138":2208,"_20209":54622,"_5":13819,"_26493":54348,"_2816":54623},[],"When you open the form, it asks for the subject data and the main certificate attributes:",{"_3328":2319,"_29138":2208,"_20209":54625,"_5":13819,"_26493":54348,"_2816":54626},[],"**Common Name (CN)**: main name of the identity.",{"_3328":2320,"_29138":2208,"_20209":54628,"_5":13819,"_26493":54348,"_2816":54629},[],"**Organization (O)**: organization or company.",{"_3328":2321,"_29138":2208,"_20209":54631,"_5":13819,"_26493":54348,"_2816":54632},[],"**Organizational Unit (OU)**: department or unit.",{"_3328":2322,"_29138":2208,"_20209":54634,"_5":13819,"_26493":54348,"_2816":54635},[],"**Country (C)**: two-letter country code.",{"_3328":2323,"_29138":2208,"_20209":54637,"_5":13819,"_26493":54348,"_2816":54638},[],"**State / Province (ST)**: state or province.",{"_3328":2324,"_29138":2208,"_20209":54640,"_5":13819,"_26493":54348,"_2816":54641},[],"**Locality (L)**: city or locality.",{"_3328":2325,"_29138":2208,"_20209":54643,"_5":13819,"_26493":54348,"_2816":54644},[],"**Email Address**: contact email.",{"_3328":2326,"_29138":2208,"_20209":54646,"_5":13819,"_26493":54348,"_2816":54647},[],"**Subject Alternative Names (SANs)**: alternative names or identifiers, such as DNS or IP.",{"_3328":2327,"_29138":2208,"_20209":54649,"_5":13819,"_26493":54348,"_2816":54650},[],"Download the CSR and run `openssl req -in request.csr -noout -verify -text`. Check signature, subject and SAN before sending it. A CSR does not determine the final certificate by itself: issuance policy can replace its fields.",{"_3328":2328,"_29138":2208,"_20209":54652,"_5":13819,"_26493":54352,"_2816":54653},[],"Lamassu also offers specific help for local integrations through **Sign locally with OpenSSL & PKCS11 tools**.",{"_3328":2329,"_29138":2208,"_20209":54655,"_5":13819,"_26493":54352,"_2816":54656},[],"Requiere el módulo, token y permisos del proveedor correspondiente. Comprueba que el identificador de Lamassu se corresponde con el objeto accesible desde ese módulo. La configuración del módulo pertenece al entorno del cliente o al Despliegue.",{"_3328":2330,"_29138":2208,"_20209":54658,"_5":13819,"_26493":54356,"_2816":54659},[],"Review **Related Entities** and locate CAs, certificates and validation processes that still need signatures. Revoking a CA does not remove the need to publish status during its retention period. Deleting a key does not automatically revoke its certificates either. Plan replacement and retention before using **Delete Key**; provider deletion behavior depends on the engine.",{"_3328":2331,"_29138":2331,"_5":14177,"_2816":54661,"_29461":54662,"_20209":54663,"_26493":2331},"Online validation with OCSP",[47397,48865,52871,53498],[],{"_3328":2332,"_29138":2331,"_20209":54665,"_5":13819,"_26493":2331,"_2816":54666},[],"Query signed status and verify the responder’s response.",{"_3328":2333,"_29138":2331,"_5":29458,"_20209":54668,"_26493":54669,"_2816":54670},[],"/docs/platform/pki/ocsp#how-the-responder-works-in-lamassu","How the responder works in Lamassu",{"_3328":2334,"_29138":2331,"_5":29458,"_20209":54672,"_26493":54673,"_2816":54674},[],"/docs/platform/pki/ocsp#embedding-in-issued-certificates","Embedding in issued certificates",{"_3328":2335,"_29138":2331,"_5":29458,"_20209":54676,"_26493":54677,"_2816":54678},[],"/docs/platform/pki/ocsp#http-endpoints","HTTP endpoints",{"_3328":2336,"_29138":2331,"_5":29458,"_20209":54680,"_26493":54681,"_2816":54682},[],"/docs/platform/pki/ocsp#generate-and-verify-a-query","Generate and verify a query",{"_3328":2337,"_29138":2331,"_5":29458,"_20209":54684,"_26493":54685,"_2816":54686},[],"/docs/platform/pki/ocsp#check-from-the-interface","Check from the interface",{"_3328":2338,"_29138":2331,"_5":29458,"_20209":54688,"_26493":54689,"_2816":54052},[],"/docs/platform/pki/ocsp#references",{"_3328":2339,"_29138":2331,"_20209":54691,"_5":13819,"_26493":2331,"_2816":54692},[],"OCSP queries a certificate’s status and returns a signed response. This guide is for an integrator checking what Lamassu publishes and how the consumer must verify it. For complete identity validation, follow Certificate validation.",{"_3328":2340,"_29138":2331,"_20209":54694,"_5":13819,"_26493":54669,"_2816":54695},[],"The responder retrieves the certificate by serial number and locates its issuing CA in the inventory. It translates persisted status as follows:",{"_3328":2341,"_29138":2331,"_20209":54697,"_5":13819,"_26493":54669,"_2816":54698},[],"Record status",{"_3328":2342,"_29138":2331,"_20209":54700,"_5":13819,"_26493":54669,"_2816":54701},[],"Signed response",{"_3328":2343,"_29138":2331,"_20209":54703,"_5":13819,"_26493":54669,"_2816":52042},[],{"_3328":2344,"_29138":2331,"_20209":54705,"_5":13819,"_26493":54669,"_2816":54706},[],"`Good`.",{"_3328":2345,"_29138":2331,"_20209":54708,"_5":13819,"_26493":54669,"_2816":52059},[],{"_3328":2346,"_29138":2331,"_20209":54710,"_5":13819,"_26493":54669,"_2816":54711},[],"`Revoked`, with revocation reason and timestamp.",{"_3328":2347,"_29138":2331,"_20209":54713,"_5":13819,"_26493":54669,"_2816":54714},[],"Other states, including `INACTIVE` and `EXPIRED`",{"_3328":2348,"_29138":2331,"_20209":54716,"_5":13819,"_26493":54669,"_2816":54717},[],"`Unknown` if the certificate and issuer can be retrieved.",{"_3328":2349,"_29138":2331,"_20209":54719,"_5":13819,"_26493":54669,"_2816":54720},[],"An absent serial number causes a lookup error; it does not guarantee a signed `Unknown` response. Lookup or signing errors produce an HTTP failure. Treat that as unavailable evidence according to consumer policy.",{"_3328":2350,"_29138":2331,"_20209":54722,"_5":13819,"_26493":54669,"_2816":54723},[],"The issuing CA itself signs the response through its KMS-associated key. A delegated OCSP signing certificate is not used. An imported CA without a usable key cannot sign responses.",{"_3328":2351,"_29138":2331,"_20209":54725,"_5":13819,"_26493":54669,"_2816":54726},[],"The implementation sets `thisUpdate` approximately one day before response generation and `nextUpdate` one day after: the declared window is about 48 hours. Inspect received values and apply your freshness policy. The response reflects stored status when queried; a previously cached copy does not change upon revocation.",{"_3328":2352,"_29138":2331,"_20209":54728,"_5":13819,"_26493":54673,"_2816":54729},[],"The signer constructs OCSP URLs from configured VA domains and adds them to AIA. Without domains, there is no URL to add; an imported certificate retains its original extensions. Inspect the actual certificate:",{"_3328":2353,"_29138":2331,"_20209":54731,"_5":13819,"_26493":54673,"_2816":54732},[],"Check that the consumer can reach this URL. DNS, endpoint exposure and domain configuration belong to Deployment. Changing configuration does not modify already signed certificates.",{"_3328":2354,"_29138":2331,"_20209":54734,"_5":13819,"_26493":54677,"_2816":54735},[],"The service accepts:",{"_3328":2355,"_29138":2331,"_20209":54737,"_5":13819,"_26493":54677,"_2816":50629},[],{"_3328":2356,"_29138":2331,"_20209":54739,"_5":13819,"_26493":54677,"_2816":54740},[],"VA service path",{"_3328":2357,"_29138":2331,"_20209":54742,"_5":13819,"_26493":54677,"_2816":54743},[],"Format",{"_3328":2358,"_29138":2331,"_20209":54745,"_5":13819,"_26493":54677,"_2816":54746},[],"`POST`",{"_3328":2359,"_29138":2331,"_20209":54748,"_5":13819,"_26493":54677,"_2816":54749},[],"`/ocsp`",{"_3328":2360,"_29138":2331,"_20209":54751,"_5":13819,"_26493":54677,"_2816":54752},[],"DER request, `Content-Type: application/ocsp-request`.",{"_3328":2361,"_29138":2331,"_20209":54754,"_5":13819,"_26493":54677,"_2816":54178},[],{"_3328":2362,"_29138":2331,"_20209":54756,"_5":13819,"_26493":54677,"_2816":54757},[],"`/ocsp/{ocsp_request}`",{"_3328":2363,"_29138":2331,"_20209":54759,"_5":13819,"_26493":54677,"_2816":54760},[],"DER request encoded using padded URL Base64.",{"_3328":2364,"_29138":2331,"_20209":54762,"_5":13819,"_26493":54677,"_2816":54763},[],"Use POST to avoid client encoding differences. A successful response has `Content-Type: application/ocsp-response` and a DER body. The public prefix depends on the Gateway; use the URL published in the certificate and checked by the operator.",{"_3328":2365,"_29138":2331,"_20209":54765,"_5":13819,"_26493":54681,"_2816":54766},[],"You need OpenSSL 3.x, `device.crt`, its direct issuer’s certificate `issuer.pem` and the consumer’s trusted roots in `roots.pem`. For an intermediate issuer, also prepare `intermediates.pem` containing the intermediate CAs.",{"_3328":2366,"_29138":2331,"_20209":54768,"_5":13819,"_26493":54681,"_2816":54769},[],"Generate the request:",{"_3328":2367,"_29138":2331,"_20209":54771,"_5":13819,"_26493":54681,"_2816":54772},[],"This example omits the nonce because the responder does not echo it. Verification relies on signature, response correspondence and timestamps; it does not demonstrate freshness through a nonce.",{"_3328":2368,"_29138":2331,"_20209":54774,"_5":13819,"_26493":54681,"_2816":54775},[],"Replace the example URL with the inspected endpoint:",{"_3328":2369,"_29138":2331,"_20209":54777,"_5":13819,"_26493":54681,"_2816":54778},[],"Verify the returned DER:",{"_3328":2370,"_29138":2331,"_20209":54780,"_5":13819,"_26493":54681,"_2816":54781},[],"For intermediates, add `-verify_other intermediates.pem`. Require successful response verification and inspect the status corresponding to `device.crt`, issuer, serial, `thisUpdate` and `nextUpdate`. `Response verify OK` validates the response only: also observe `good`, `revoked` or `unknown`. Do not accept an identity based only on the command’s exit code.",{"_3328":2371,"_29138":2331,"_20209":54783,"_5":13819,"_26493":54685,"_2816":54784},[],"**OCSP Check** shows what Lamassu returns for a selected certificate. Complete the check from the consumer’s network and trust store: a console query does not establish its validation configuration.",{"_3328":2372,"_29138":2331,"_20209":54786,"_5":13819,"_26493":54685,"_2816":54787},[],"To check a change, save an earlier response, revoke a test certificate and request another response. The new query should reflect persisted status; compare timestamps to rule out reuse of an earlier response. If it fails, follow PKI troubleshooting.",{"_3328":2373,"_29138":2331,"_20209":54789,"_5":13819,"_26493":54689,"_2816":54790},[],"RFC 6960: OCSP.",{"_3328":2374,"_29138":2331,"_20209":54792,"_5":13819,"_26493":54689,"_2816":54793},[],"OpenSSL: openssl-ocsp.",{"_3328":2375,"_29138":2331,"_20209":54795,"_5":13819,"_26493":54689,"_2816":54796},[],"<Card title=\"CRL service\" href=\"/docs/platform/pki/crl\" />",{"_3328":2376,"_29138":2331,"_20209":54798,"_5":13819,"_26493":54689,"_2816":54270},[],{"_3328":2377,"_29138":2377,"_5":14177,"_2816":52871,"_29461":54800,"_20209":54801,"_26493":2377},[47397,48865,52871],[],{"_3328":2378,"_29138":2377,"_20209":54803,"_5":13819,"_26493":2377,"_2816":54804},[],"Administer keys and authorities, define issuance and verify the resulting certificates.",{"_3328":2379,"_29138":2377,"_5":29458,"_20209":54806,"_26493":54807,"_2816":52183},[],"/docs/platform/pki/overview#start-here",{"_3328":2380,"_29138":2377,"_5":29458,"_20209":54809,"_26493":54810,"_2816":54811},[],"/docs/platform/pki/overview#what-you-need","What you need",{"_3328":2381,"_29138":2377,"_5":29458,"_20209":54813,"_26493":54814,"_2816":52715},[],"/docs/platform/pki/overview#core-capabilities",{"_3328":2382,"_29138":2377,"_5":29458,"_20209":54816,"_26493":54817,"_2816":52719},[],"/docs/platform/pki/overview#build-your-trust-hierarchy",{"_3328":2383,"_29138":2377,"_5":29458,"_20209":54819,"_26493":54820,"_2816":52723},[],"/docs/platform/pki/overview#protect-cryptographic-keys",{"_3328":2384,"_29138":2377,"_5":29458,"_20209":54822,"_26493":54823,"_2816":52727},[],"/docs/platform/pki/overview#issue-and-control-certificates",{"_3328":2385,"_29138":2377,"_5":29458,"_20209":54825,"_26493":54826,"_2816":52735},[],"/docs/platform/pki/overview#publish-validation-status",{"_3328":2386,"_29138":2377,"_5":29458,"_20209":54828,"_26493":54829,"_2816":54830},[],"/docs/platform/pki/overview#how-to-check-the-result","How to check the result",{"_3328":2387,"_29138":2377,"_5":29458,"_20209":54832,"_26493":54833,"_2816":53665},[],"/docs/platform/pki/overview#continue",{"_3328":2388,"_29138":2377,"_20209":54835,"_5":13819,"_26493":2377,"_2816":54836},[],"The PKI section explains how to build and operate X.509 trust in Lamassu: which authorities issue, which rules apply and how to check certificates. It is intended for PKI administrators and anyone who needs to use certificates in a consuming system.",{"_3328":2389,"_29138":2377,"_20209":54838,"_5":13819,"_26493":54807,"_2816":54839},[],"Follow PKI getting started to create a CA, issue a client certificate and verify it with OpenSSL. The result is a certificate, its private key and a verified chain.",{"_3328":2390,"_29138":2377,"_20209":54841,"_5":13819,"_26493":54807,"_2816":54842},[],"You can complete that path before managing devices. When you need to associate the identity with an inventory or automate its enrollment, continue in IoT Fleets.",{"_3328":2391,"_29138":2377,"_20209":54844,"_5":13819,"_26493":54810,"_2816":54845},[],"An accessible instance and permission to manage the keys, CAs and certificates you will use.",{"_3328":2392,"_29138":2377,"_20209":54847,"_5":13819,"_26493":54810,"_2816":54848},[],"An available cryptographic engine to keep the authority's key.",{"_3328":2393,"_29138":2377,"_20209":54850,"_5":13819,"_26493":54810,"_2816":54851},[],"The certificate's purpose, such as authenticating a client through mTLS.",{"_3328":2394,"_29138":2377,"_20209":54853,"_5":13819,"_26493":54810,"_2816":54854},[],"Consumer requirements: accepted issuers, algorithms, names and permitted usages.",{"_3328":2395,"_29138":2377,"_20209":54856,"_5":13819,"_26493":54810,"_2816":54857},[],"Prepare the instance and cryptographic provider in Deployment. The trust model explains hierarchy choices.",{"_3328":2396,"_29138":2377,"_20209":54859,"_5":13819,"_26493":54817,"_2816":54860},[],"Authorities sign certificates. A root establishes the trust anchor, and an intermediate separates issuance by environment or purpose. Hierarchy and rotation explains how to maintain trust when replacing an authority.",{"_3328":2397,"_29138":2377,"_20209":54862,"_5":13819,"_26493":54820,"_2816":54863},[],"CA signing keys are managed through KMS and cryptographic engines. A client that generates a CSR can keep its own key: preserve that custody when choosing the issuance method.",{"_3328":2398,"_29138":2377,"_20209":54865,"_5":13819,"_26493":54823,"_2816":54866},[],"A profile establishes subject, validity, usage and key restrictions. The CA applies issuance configuration and signs the certificate. In the inventory, you can inspect the result, download it and manage its status.",{"_3328":2399,"_29138":2377,"_20209":54868,"_5":13819,"_26493":54826,"_2816":54869},[],"Validation covers the chain, validity, usages and revocation status. Lamassu publishes status through OCSP and CRL; the consumer configures which issuers it recognizes and how it checks that status.",{"_3328":2400,"_29138":2377,"_20209":54871,"_5":13819,"_26493":54829,"_2816":54872},[],"An active certificate in the console is one part of the check. Also verify that:",{"_3328":2401,"_29138":2377,"_20209":54874,"_5":13819,"_26493":54829,"_2816":54875},[],"its subject and extensions identify the expected client;",{"_3328":2402,"_29138":2377,"_20209":54877,"_5":13819,"_26493":54829,"_2816":54878},[],"its public key matches the client's private key;",{"_3328":2403,"_29138":2377,"_20209":54880,"_5":13819,"_26493":54829,"_2816":54881},[],"its chain reaches a root trusted by the consumer;",{"_3328":2404,"_29138":2377,"_20209":54883,"_5":13819,"_26493":54829,"_2816":54884},[],"its dates and usages allow the operation;",{"_3328":2405,"_29138":2377,"_20209":54886,"_5":13819,"_26493":54829,"_2816":54887},[],"the consumer applies revocation checks and authorization.",{"_3328":2406,"_29138":2377,"_20209":54889,"_5":13819,"_26493":54829,"_2816":54890},[],"The issuance path includes the first independent checks.",{"_3328":2407,"_29138":2377,"_20209":54892,"_5":13819,"_26493":54833,"_2816":54893},[],"<Card title=\"PKI getting started\" description=\"Create a CA, then issue and verify a client certificate.\" href=\"/docs/platform/pki/quickstarts/overview\" />",{"_3328":2408,"_29138":2377,"_20209":54895,"_5":13819,"_26493":54833,"_2816":54896},[],"<Card title=\"Apply PKI to devices\" description=\"Associate certificates with inventory and prepare enrollment.\" href=\"/docs/platform/iot-fleets/overview\" />",{"_3328":2409,"_29138":2377,"_20209":54898,"_5":13819,"_26493":54833,"_2816":54899},[],"<Card title=\"PKI diagnostics\" description=\"Check issuance, OCSP and CRL when the result fails.\" href=\"/docs/platform/pki/troubleshooting\" />",{"_3328":2410,"_29138":2410,"_5":14177,"_2816":54901,"_29461":54902,"_20209":54903,"_26493":2410},"Create your first CA",[47397,48865,52871,52308],[],{"_3328":2411,"_29138":2410,"_20209":54905,"_5":13819,"_26493":2410,"_2816":54906},[],"Create an evaluation root and check its certificate before issuing.",{"_3328":2412,"_29138":2410,"_5":29458,"_20209":54908,"_26493":54909,"_2816":47407},[],"/docs/platform/pki/quickstarts/create-certificate-authority#before-you-begin",{"_3328":2413,"_29138":2410,"_5":29458,"_20209":54911,"_26493":54912,"_2816":54913},[],"/docs/platform/pki/quickstarts/create-certificate-authority#open-the-creation-wizard-toc","Open the creation wizard [!toc]",{"_3328":2414,"_29138":2410,"_5":29458,"_20209":54915,"_26493":54916,"_2816":54917},[],"/docs/platform/pki/quickstarts/create-certificate-authority#select-the-key-toc","Select the key [!toc]",{"_3328":2415,"_29138":2410,"_5":29458,"_20209":54919,"_26493":54920,"_2816":54921},[],"/docs/platform/pki/quickstarts/create-certificate-authority#define-the-authority-toc","Define the authority [!toc]",{"_3328":2416,"_29138":2410,"_5":29458,"_20209":54923,"_26493":54924,"_2816":54925},[],"/docs/platform/pki/quickstarts/create-certificate-authority#review-and-create-the-ca-toc","Review and create the CA [!toc]",{"_3328":2417,"_29138":2410,"_5":29458,"_20209":54927,"_26493":54928,"_2816":54929},[],"/docs/platform/pki/quickstarts/create-certificate-authority#verify-the-result-toc","Verify the result [!toc]",{"_3328":2418,"_29138":2410,"_5":29458,"_20209":54931,"_26493":54932,"_2816":54933},[],"/docs/platform/pki/quickstarts/create-certificate-authority#check-the-ca-certificate","Check the CA certificate",{"_3328":2419,"_29138":2410,"_5":29458,"_20209":54935,"_26493":54936,"_2816":52565},[],"/docs/platform/pki/quickstarts/create-certificate-authority#if-the-result-fails",{"_3328":2420,"_29138":2410,"_5":29458,"_20209":54938,"_26493":54939,"_2816":47431},[],"/docs/platform/pki/quickstarts/create-certificate-authority#next-step",{"_3328":2421,"_29138":2410,"_20209":54941,"_5":13819,"_26493":2410,"_2816":54942},[],"You will create a root authority with a new key kept by a Lamassu engine. The result is an active CA and its public certificate in `ca.pem`, ready to verify issuance in the next path.",{"_3328":2422,"_29138":2410,"_20209":54944,"_5":13819,"_26493":54909,"_2816":54945},[],"Console access and permission to create keys and authorities.",{"_3328":2423,"_29138":2410,"_20209":54947,"_5":13819,"_26493":54909,"_2816":54948},[],"An available cryptographic engine that supports the chosen algorithm.",{"_3328":2424,"_29138":2410,"_20209":54950,"_5":13819,"_26493":54909,"_2816":54951},[],"OpenSSL 3.x to check the downloaded certificate.",{"_3328":2425,"_29138":2410,"_20209":54953,"_5":13819,"_26493":54909,"_2816":54954},[],"Use an evaluation instance or an authority intended for these tests. The example creates a root that issues directly; to design an operational hierarchy, see Hierarchy and rotation.",{"_3328":2426,"_29138":2410,"_20209":54956,"_5":13819,"_26493":54912,"_2816":54957},[],"In **Certification Authorities**, select **Create New CA** and choose to create a CA with a new key pair.",{"_3328":2427,"_29138":2410,"_20209":54959,"_5":13819,"_26493":54912,"_2816":54960},[],"The &#x2A;*Create New CA (Existing Key)** flow is explained in the authorities guide.",{"_3328":2428,"_29138":2410,"_20209":54962,"_5":13819,"_26493":54916,"_2816":54963},[],"Choose the engine that will keep the key and an algorithm its capabilities allow. For this example, you can use **EC P-384** if available.",{"_3328":2429,"_29138":2410,"_20209":54965,"_5":13819,"_26493":54916,"_2816":54966},[],"The CA private key is used through the engine. In this path, you will download only the authority's public certificate.",{"_3328":2430,"_29138":2410,"_20209":54968,"_5":13819,"_26493":54920,"_2816":54969},[],"Select **Root CA** and complete:",{"_3328":2431,"_29138":2410,"_20209":54971,"_5":13819,"_26493":54920,"_2816":54972},[],"**CA Name**: `Acme Evaluation Root CA`.",{"_3328":2432,"_29138":2410,"_20209":54974,"_5":13819,"_26493":54920,"_2816":54975},[],"**Subject**: organization and country details for your evaluation.",{"_3328":2433,"_29138":2410,"_20209":54977,"_5":13819,"_26493":54920,"_2816":54978},[],"**CA Certificate Expiration**: for example, one year from creation.",{"_3328":2434,"_29138":2410,"_20209":54980,"_5":13819,"_26493":54920,"_2816":54981},[],"**Default End-Entity Certificate Issuance Expiration**: for example, 90 days, within the CA's lifetime.",{"_3328":2435,"_29138":2410,"_20209":54983,"_5":13819,"_26493":54920,"_2816":54984},[],"The CA name becomes its `Common Name`. Keep the CA usages needed to sign certificates and CRLs.",{"_3328":2436,"_29138":2410,"_20209":54986,"_5":13819,"_26493":54924,"_2816":54987},[],"Check the engine, algorithm, subject, root type and dates. Confirm creation and note the authority identifier so you can recognize it in the DMS or API.",{"_3328":2437,"_29138":2410,"_20209":54989,"_5":13819,"_26493":54928,"_2816":54990},[],"Open the new CA. It should appear active, show its certificate and allow access to **Issued Certificates**.",{"_3328":2438,"_29138":2410,"_20209":54992,"_5":13819,"_26493":54928,"_2816":54993},[],"Download or copy the authority's PEM certificate and save it as `ca.pem`. Check that the file contains the complete block, including `BEGIN CERTIFICATE` and `END CERTIFICATE`.",{"_3328":2439,"_29138":2410,"_20209":54995,"_5":13819,"_26493":54932,"_2816":54996},[],"Run from the directory where you saved `ca.pem`:",{"_3328":2440,"_29138":2410,"_20209":54998,"_5":13819,"_26493":54932,"_2816":54999},[],"Check that the subject and issuer match the root you created, the dates include the current time, **Basic Constraints** contains `CA:TRUE` and **Key Usage** allows certificate signing. The last command should return `ca.pem: OK`.",{"_3328":2441,"_29138":2410,"_20209":55001,"_5":13819,"_26493":54932,"_2816":55002},[],"You explicitly selected `ca.pem` as the trust anchor for this test. A valid self-signature does not install that trust in other consumers. See the openssl-verify reference for verification options.",{"_3328":2442,"_29138":2410,"_20209":55004,"_5":13819,"_26493":54936,"_2816":55005},[],"If creation fails, check permissions, engine availability and the selected algorithm.",{"_3328":2443,"_29138":2410,"_20209":55007,"_5":13819,"_26493":54936,"_2816":55008},[],"If OpenSSL cannot read the file, copy the complete PEM block again.",{"_3328":2444,"_29138":2410,"_20209":55010,"_5":13819,"_26493":54936,"_2816":55011},[],"If signature or date checks fail, check that you downloaded this CA's certificate and that your computer's clock is correct.",{"_3328":2445,"_29138":2410,"_20209":55013,"_5":13819,"_26493":54936,"_2816":55014},[],"PKI diagnostics covers issuance checks and cryptographic dependencies.",{"_3328":2446,"_29138":2410,"_20209":55016,"_5":13819,"_26493":54939,"_2816":55017},[],"Continue with Issue and verify a certificate, using this authority and `ca.pem`.",{"_3328":2447,"_29138":2447,"_5":14177,"_2816":55019,"_29461":55020,"_20209":55021,"_26493":2447},"Issue and verify a certificate",[47397,48865,52871,52308],[],{"_3328":2448,"_29138":2447,"_20209":55023,"_5":13819,"_26493":2447,"_2816":55024},[],"Issue a client certificate and check content, chain and key correspondence.",{"_3328":2449,"_29138":2447,"_5":29458,"_20209":55026,"_26493":55027,"_2816":47407},[],"/docs/platform/pki/quickstarts/issue-certificate#before-you-begin",{"_3328":2450,"_29138":2447,"_5":29458,"_20209":55029,"_26493":55030,"_2816":55031},[],"/docs/platform/pki/quickstarts/issue-certificate#start-the-issuance","Start the issuance",{"_3328":2451,"_29138":2447,"_5":29458,"_20209":55033,"_26493":55034,"_2816":55035},[],"/docs/platform/pki/quickstarts/issue-certificate#choose-the-method","Choose the method",{"_3328":2452,"_29138":2447,"_5":29458,"_20209":55037,"_26493":55038,"_2816":55039},[],"/docs/platform/pki/quickstarts/issue-certificate#identify-the-certificate","Identify the certificate",{"_3328":2453,"_29138":2447,"_5":29458,"_20209":55041,"_26493":55042,"_2816":55043},[],"/docs/platform/pki/quickstarts/issue-certificate#configure-key-and-uses","Configure key and uses",{"_3328":2454,"_29138":2447,"_5":29458,"_20209":55045,"_26493":55046,"_2816":55047},[],"/docs/platform/pki/quickstarts/issue-certificate#issue-and-download","Issue and download",{"_3328":2455,"_29138":2447,"_5":29458,"_20209":55049,"_26493":55050,"_2816":55051},[],"/docs/platform/pki/quickstarts/issue-certificate#verify-the-result","Verify the result",{"_3328":2456,"_29138":2447,"_5":29458,"_20209":55053,"_26493":55054,"_2816":55055},[],"/docs/platform/pki/quickstarts/issue-certificate#inspect-content-and-dates","Inspect content and dates",{"_3328":2457,"_29138":2447,"_5":29458,"_20209":55057,"_26493":55058,"_2816":55059},[],"/docs/platform/pki/quickstarts/issue-certificate#verify-the-chain","Verify the chain",{"_3328":2458,"_29138":2447,"_5":29458,"_20209":55061,"_26493":55062,"_2816":55063},[],"/docs/platform/pki/quickstarts/issue-certificate#check-that-the-key-matches","Check that the key matches",{"_3328":2459,"_29138":2447,"_5":29458,"_20209":55065,"_26493":55066,"_2816":52565},[],"/docs/platform/pki/quickstarts/issue-certificate#if-the-result-fails",{"_3328":2460,"_29138":2447,"_5":29458,"_20209":55068,"_26493":55069,"_2816":47431},[],"/docs/platform/pki/quickstarts/issue-certificate#next-step",{"_3328":2461,"_29138":2447,"_20209":55071,"_5":13819,"_26493":2447,"_2816":55072},[],"You will issue an end-entity certificate for `device-001` using browser key and CSR generation. The result is `device.crt`, `device.key` and the issuing root's public certificate, `ca.pem`.",{"_3328":2462,"_29138":2447,"_20209":55074,"_5":13819,"_26493":55027,"_2816":55075},[],"An active root CA with an available signing key and permission to issue. If one does not exist yet, follow Create your first CA.",{"_3328":2463,"_29138":2447,"_20209":55077,"_5":13819,"_26493":55027,"_2816":55078},[],"Its public certificate in `ca.pem`; this example uses the root created in the previous path.",{"_3328":2464,"_29138":2447,"_20209":55080,"_5":13819,"_26493":55027,"_2816":55081},[],"OpenSSL 3.x and a working directory with restricted access.",{"_3328":2465,"_29138":2447,"_20209":55083,"_5":13819,"_26493":55027,"_2816":55084},[],"A client identifier: here we use `device-001`.",{"_3328":2466,"_29138":2447,"_20209":55086,"_5":13819,"_26493":55027,"_2816":55087},[],"In this flow, the client's key is generated in the browser and must be downloaded when issuance finishes. If you lose it, you must generate a key and issue another certificate. The certificate inventory lets you download the public certificate, but cannot recover this key.",{"_3328":2467,"_29138":2447,"_20209":55089,"_5":13819,"_26493":55030,"_2816":55090},[],"Open the CA from the previous path, go to **Issued Certificates** and select **Issue New**.",{"_3328":2468,"_29138":2447,"_20209":55092,"_5":13819,"_26493":55034,"_2816":55093},[],"Select **Generate Key & CSR in Browser** to follow this example.",{"_3328":2469,"_29138":2447,"_20209":55095,"_5":13819,"_26493":55034,"_2816":55096},[],"If the key must be generated and kept on the destination system, use **Upload Existing CSR**, described in the authorities guide.",{"_3328":2470,"_29138":2447,"_20209":55098,"_5":13819,"_26493":55038,"_2816":55099},[],"Enter `device-001` as the `Common Name`. Add subject details required by your policy and SANs if the consumer uses them to identify the client.",{"_3328":2471,"_29138":2447,"_20209":55101,"_5":13819,"_26493":55038,"_2816":55102},[],"If you continue with manual registration, the `Device ID` will be exactly `device-001`.",{"_3328":2472,"_29138":2447,"_20209":55104,"_5":13819,"_26493":55042,"_2816":55105},[],"Choose an algorithm and size allowed by the profile; for example, ECDSA P-256 if permitted. For this client certificate, select **Digital Signature** and **Client Authentication**, and issue it as an end-entity certificate.",{"_3328":2473,"_29138":2447,"_20209":55107,"_5":13819,"_26493":55042,"_2816":55108},[],"Request, for example, 30 days of validity, always within the CA's lifetime. Review the issuance profile if the resulting content differs from the request.",{"_3328":2474,"_29138":2447,"_20209":55110,"_5":13819,"_26493":55046,"_2816":55111},[],"Confirm issuance. Save the PEM certificate as `device.crt` and the private key as `device.key` in your prepared directory.",{"_3328":2475,"_29138":2447,"_20209":55113,"_5":13819,"_26493":55050,"_2816":55114},[],"Check in **Issued Certificates** that the certificate appears active. Note its serial number and verify the downloaded material using the checks below.",{"_3328":2476,"_29138":2447,"_20209":55116,"_5":13819,"_26493":55054,"_2816":55117},[],"Check `CN=device-001`, the expected issuer, current validity, **Digital Signature** and the extended usage **TLS Web Client Authentication**. It must be an end-entity certificate: it must not declare `CA:TRUE` or enable **Certificate Sign**. If **Basic Constraints** is present, it must indicate `CA:FALSE`. If you requested SANs, check that the expected identifiers appear in the certificate.",{"_3328":2477,"_29138":2447,"_20209":55119,"_5":13819,"_26493":55058,"_2816":55120},[],"The expected result is `device.crt: OK`. This check uses your explicit root and evaluates the chain, dates and compatibility with the TLS client purpose. Also check for the expected usages and names through the inspection above.",{"_3328":2478,"_29138":2447,"_20209":55122,"_5":13819,"_26493":55058,"_2816":55123},[],"If you use an intermediate CA, the trusted root must be in `ca.pem` and you must supply the intermediates with `-untrusted intermediates.pem`. This variant is covered in the trust model.",{"_3328":2479,"_29138":2447,"_20209":55125,"_5":13819,"_26493":55058,"_2816":55126},[],"The command does not query OCSP or CRL. For revocation checks, continue with Certificate validation. See the openssl-verify reference for its options.",{"_3328":2480,"_29138":2447,"_20209":55128,"_5":13819,"_26493":55062,"_2816":55129},[],"In Bash, compare the two public-key digests:",{"_3328":2481,"_29138":2447,"_20209":55131,"_5":13819,"_26493":55062,"_2816":55132},[],"Both commands must finish successfully and show the same SHA-256 digest. If they differ, the private key does not match the selected certificate. Find the correct pair before installing it.",{"_3328":2482,"_29138":2447,"_20209":55134,"_5":13819,"_26493":55062,"_2816":55135},[],"The options used are documented in openssl-x509 and openssl-pkey.",{"_3328":2483,"_29138":2447,"_20209":55137,"_5":13819,"_26493":55066,"_2816":52649},[],{"_3328":2484,"_29138":2447,"_20209":55139,"_5":13819,"_26493":55066,"_2816":55140},[],"What to review",{"_3328":2485,"_29138":2447,"_20209":55142,"_5":13819,"_26493":55066,"_2816":55143},[],"The CA rejects issuance",{"_3328":2486,"_29138":2447,"_20209":55145,"_5":13819,"_26493":55066,"_2816":55146},[],"Permissions, CA state and key, algorithm and profile.",{"_3328":2487,"_29138":2447,"_20209":55148,"_5":13819,"_26493":55066,"_2816":55149},[],"Different subject or usages",{"_3328":2488,"_29138":2447,"_20209":55151,"_5":13819,"_26493":55066,"_2816":55152},[],"Applied profile and requested values.",{"_3328":2489,"_29138":2447,"_20209":55154,"_5":13819,"_26493":55066,"_2816":55155},[],"Issuer cannot be found",{"_3328":2490,"_29138":2447,"_20209":55157,"_5":13819,"_26493":55066,"_2816":55158},[],"Downloaded CA and required intermediate chain.",{"_3328":2491,"_29138":2447,"_20209":55160,"_5":13819,"_26493":55066,"_2816":55161},[],"Validity fails",{"_3328":2492,"_29138":2447,"_20209":55163,"_5":13819,"_26493":55066,"_2816":55164},[],"Certificate and CA dates, and the computer's clock.",{"_3328":2493,"_29138":2447,"_20209":55166,"_5":13819,"_26493":55066,"_2816":55167},[],"Public-key digests differ",{"_3328":2494,"_29138":2447,"_20209":55169,"_5":13819,"_26493":55066,"_2816":55170},[],"Certificate and key files from the same issuance.",{"_3328":2495,"_29138":2447,"_20209":55172,"_5":13819,"_26493":55066,"_2816":55173},[],"See PKI diagnostics to narrow an issuance failure.",{"_3328":2496,"_29138":2447,"_20209":55175,"_5":13819,"_26493":55069,"_2816":55176},[],"You have completed the PKI path when the certificate verifies and the key matches. Choose how to use it:",{"_3328":2497,"_29138":2447,"_20209":55178,"_5":13819,"_26493":55069,"_2816":55179},[],"Manage certificates for inspection, status and revocation.",{"_3328":2498,"_29138":2447,"_20209":55181,"_5":13819,"_26493":55069,"_2816":55182},[],"Register a device manually to associate this identity with Lamassu's inventory.",{"_3328":2499,"_29138":2447,"_20209":55184,"_5":13819,"_26493":55069,"_2816":55185},[],"Prepare EST for the device to request its next identities.",{"_3328":2500,"_29138":2447,"_20209":55187,"_5":13819,"_26493":55069,"_2816":55188},[],"Acceptance by a consumer requires configuring its trust, revocation checks and permissions granted to the identity.",{"_3328":2501,"_29138":2501,"_5":14177,"_2816":55190,"_29461":55191,"_20209":55192,"_26493":2501},"PKI getting started",[47397,48865,52871,52308],[],{"_3328":2502,"_29138":2501,"_20209":55194,"_5":13819,"_26493":2501,"_2816":55195},[],"Create a CA, issue a client certificate and check its chain and key.",{"_3328":2503,"_29138":2501,"_5":29458,"_20209":55197,"_26493":55198,"_2816":47407},[],"/docs/platform/pki/quickstarts/overview#before-you-begin",{"_3328":2504,"_29138":2501,"_5":29458,"_20209":55200,"_26493":55201,"_2816":55202},[],"/docs/platform/pki/quickstarts/overview#recommended-path","Recommended path",{"_3328":2505,"_29138":2501,"_5":29458,"_20209":55204,"_26493":55205,"_2816":52500},[],"/docs/platform/pki/quickstarts/overview#expected-result",{"_3328":2506,"_29138":2501,"_5":29458,"_20209":55207,"_26493":55208,"_2816":55209},[],"/docs/platform/pki/quickstarts/overview#continue-according-to-your-goal","Continue according to your goal",{"_3328":2507,"_29138":2501,"_20209":55211,"_5":13819,"_26493":2501,"_2816":55212},[],"This path is intended for those starting to administer PKI or needing a first X.509 client identity. It ends with three files: a root CA certificate, an end-entity certificate and the client's private key.",{"_3328":2508,"_29138":2501,"_20209":55214,"_5":13819,"_26493":55198,"_2816":55215},[],"A Lamassu instance accessible from your browser. To prepare one, see Deployment.",{"_3328":2509,"_29138":2501,"_20209":55217,"_5":13819,"_26493":55198,"_2816":55218},[],"Permission to manage keys, authorities and issuance. See Access control if an operation is blocked.",{"_3328":2510,"_29138":2501,"_20209":55220,"_5":13819,"_26493":55198,"_2816":55221},[],"An available cryptographic engine for the CA key; check the keys and engines inventory.",{"_3328":2511,"_29138":2501,"_20209":55223,"_5":13819,"_26493":55198,"_2816":55224},[],"OpenSSL 3.x on the computer where you will verify the files.",{"_3328":2512,"_29138":2501,"_20209":55226,"_5":13819,"_26493":55198,"_2816":55227},[],"A working directory with restricted access for the downloaded key.",{"_3328":2513,"_29138":2501,"_20209":55229,"_5":13819,"_26493":55201,"_2816":55230},[],"<Card title=\"1. Create your first CA\" description=\"Create an evaluation root and save its public certificate as ca.pem.\" href=\"/docs/platform/pki/quickstarts/create-certificate-authority\" />",{"_3328":2514,"_29138":2501,"_20209":55232,"_5":13819,"_26493":55201,"_2816":55233},[],"<Card title=\"2. Issue and verify a certificate\" description=\"Issue for device-001 and check content, chain and key correspondence.\" href=\"/docs/platform/pki/quickstarts/issue-certificate\" />",{"_3328":2515,"_29138":2501,"_20209":55235,"_5":13819,"_26493":55201,"_2816":55236},[],"We use `Acme Evaluation Root CA` and `device-001` as example names. If you replace them, keep the same client identifier in the steps you want to connect.",{"_3328":2516,"_29138":2501,"_20209":55238,"_5":13819,"_26493":55201,"_2816":55239},[],"The root in this path signs the end-entity certificate directly to simplify evaluation. Before designing an operational PKI, review the trust model and CA hierarchy.",{"_3328":2517,"_29138":2501,"_20209":55241,"_5":13819,"_26493":55205,"_2816":55242},[],"File or resource",{"_3328":2518,"_29138":2501,"_20209":55244,"_5":13819,"_26493":55205,"_2816":52497},[],{"_3328":2519,"_29138":2501,"_20209":55246,"_5":13819,"_26493":55205,"_2816":55247},[],"Active root CA and `ca.pem`",{"_3328":2520,"_29138":2501,"_20209":55249,"_5":13819,"_26493":55205,"_2816":55250},[],"It is a CA certificate, is currently valid and its self-signature verifies.",{"_3328":2521,"_29138":2501,"_20209":55252,"_5":13819,"_26493":55205,"_2816":55253},[],"End-entity certificate and `device.crt`",{"_3328":2522,"_29138":2501,"_20209":55255,"_5":13819,"_26493":55205,"_2816":55256},[],"It identifies `device-001`, supports client authentication and verifies against `ca.pem`.",{"_3328":2523,"_29138":2501,"_20209":55258,"_5":13819,"_26493":55205,"_2816":55259},[],"Private key `device.key`",{"_3328":2524,"_29138":2501,"_20209":55261,"_5":13819,"_26493":55205,"_2816":55262},[],"Its public key matches the one included in `device.crt`.",{"_3328":2525,"_29138":2501,"_20209":55264,"_5":13819,"_26493":55205,"_2816":55265},[],"These checks validate the issued material. Acceptance by a service also requires its trust, authorization and revocation configuration.",{"_3328":2526,"_29138":2501,"_20209":55267,"_5":13819,"_26493":55208,"_2816":55268},[],"To operate certificates, continue with Certificates and Validation.",{"_3328":2527,"_29138":2501,"_20209":55270,"_5":13819,"_26493":55208,"_2816":55271},[],"To manage a device identity in Lamassu, follow Manual registration. That path includes DMS preparation.",{"_3328":2528,"_29138":2501,"_20209":55273,"_5":13819,"_26493":55208,"_2816":55274},[],"For the device to request its certificate, prepare the DMS and EST client.",{"_3328":2529,"_29138":2529,"_5":14177,"_2816":55276,"_29461":55277,"_20209":55278,"_26493":2529},"PKI troubleshooting",[47397,48865,52871,51443],[],{"_3328":2530,"_29138":2529,"_20209":55280,"_5":13819,"_26493":2529,"_2816":55281},[],"Diagnose certificate issuance, OCSP and CRL.",{"_3328":2531,"_29138":2529,"_5":29458,"_20209":55283,"_26493":55284,"_2816":55285},[],"/docs/platform/pki/troubleshooting#issuance-fails","Issuance fails",{"_3328":2532,"_29138":2529,"_5":29458,"_20209":55287,"_26493":55288,"_2816":55289},[],"/docs/platform/pki/troubleshooting#ocsp-or-crl-do-not-reflect-a-change","OCSP or CRL do not reflect a change",{"_3328":2533,"_29138":2529,"_5":29458,"_20209":55291,"_26493":55292,"_2816":55293},[],"/docs/platform/pki/troubleshooting#the-chain-validates-but-the-connection-fails","The chain validates but the connection fails",{"_3328":2534,"_29138":2529,"_20209":55295,"_5":13819,"_26493":2529,"_2816":55296},[],"This guide helps a PKI operator locate issuance and status publication failures. Keep the Lamassu version, operation, CA, issuer, serial, time and returned error. Do not include private keys or tokens in diagnostics.",{"_3328":2535,"_29138":2529,"_20209":55298,"_5":13819,"_26493":2529,"_2816":55299},[],"For Gateway, sign-in, pods, dependencies and messaging, see Deployment troubleshooting. For device enrollment, see EST diagnostics.",{"_3328":2536,"_29138":2529,"_20209":55301,"_5":13819,"_26493":55284,"_2816":52497},[],{"_3328":2537,"_29138":2529,"_20209":55303,"_5":13819,"_26493":55284,"_2816":55304},[],"What to inspect",{"_3328":2538,"_29138":2529,"_20209":55306,"_5":13819,"_26493":55284,"_2816":47431},[],{"_3328":2539,"_29138":2529,"_20209":55308,"_5":13819,"_26493":55284,"_2816":51710},[],{"_3328":2540,"_29138":2529,"_20209":55310,"_5":13819,"_26493":55284,"_2816":55311},[],"Exists, is active and has usable dates.",{"_3328":2541,"_29138":2529,"_20209":55313,"_5":13819,"_26493":55284,"_2816":55314},[],"Authorities.",{"_3328":2542,"_29138":2529,"_20209":55316,"_5":13819,"_26493":55284,"_2816":55317},[],"Key",{"_3328":2543,"_29138":2529,"_20209":55319,"_5":13819,"_26493":55284,"_2816":55320},[],"The record has a usable private key and the engine can sign.",{"_3328":2544,"_29138":2529,"_20209":55322,"_5":13819,"_26493":55284,"_2816":55323},[],"Try **Sign / Verify** in KMS; check provider permissions and availability.",{"_3328":2545,"_29138":2529,"_20209":55325,"_5":13819,"_26493":55284,"_2816":55326},[],"CSR",{"_3328":2546,"_29138":2529,"_20209":55328,"_5":13819,"_26493":55284,"_2816":55329},[],"Correct PEM and verifiable signature.",{"_3328":2547,"_29138":2529,"_20209":55331,"_5":13819,"_26493":55284,"_2816":55332},[],"`openssl req -in request.csr -noout -verify -text`.",{"_3328":2548,"_29138":2529,"_20209":55334,"_5":13819,"_26493":55284,"_2816":55335},[],"Profile",{"_3328":2549,"_29138":2529,"_20209":55337,"_5":13819,"_26493":55284,"_2816":55338},[],"Selected source, existing ID, allowed algorithm and size.",{"_3328":2550,"_29138":2529,"_20209":55340,"_5":13819,"_26493":55284,"_2816":55341},[],"Check Profiles precedence; CA and DMS resolve differently.",{"_3328":2551,"_29138":2529,"_20209":55343,"_5":13819,"_26493":55284,"_2816":52649},[],{"_3328":2552,"_29138":2529,"_20209":55345,"_5":13819,"_26493":55284,"_2816":55346},[],"Appropriate subject, SAN, usages and dates.",{"_3328":2553,"_29138":2529,"_20209":55348,"_5":13819,"_26493":55284,"_2816":55349},[],"Compare CSR, profile and certificate; successful issuance does not establish consumer acceptance.",{"_3328":2554,"_29138":2529,"_20209":55351,"_5":13819,"_26493":55284,"_2816":55352},[],"For unexpected certificate fields, review `Honor Subject`, `Honor Key Usage`, `Honor Extended Key Usages` and `Honor Extensions`. The latter preserves SAN only, without validating entitlement to those names. Validity is not automatically clamped to CA expiration.",{"_3328":2555,"_29138":2529,"_20209":55354,"_5":13819,"_26493":55284,"_2816":55355},[],"For CA reissuance failures, check revocation and date: reissuance is not supported for a revoked or already expired CA. To change its key, use Hierarchy and rotation.",{"_3328":2556,"_29138":2529,"_20209":55357,"_5":13819,"_26493":55288,"_2816":55358},[],"Check each boundary independently:",{"_3328":2557,"_29138":2529,"_20209":55360,"_5":13819,"_26493":55288,"_2816":55361},[],"**Record:** read the correct certificate again by serial and issuer. Confirm status, reason and time; expired or permanently revoked records reject further transitions.",{"_3328":2558,"_29138":2529,"_20209":55363,"_5":13819,"_26493":55288,"_2816":55364},[],"**Endpoint:** inspect AIA and CDP. Query those URLs from the consumer’s network; an old route or incorrect issuer can explain a discrepancy.",{"_3328":2559,"_29138":2529,"_20209":55366,"_5":13819,"_26493":55288,"_2816":55367},[],"**OCSP:** save a fresh response, verify signature and timestamps, and observe status. An HTTP error for an absent serial does not mean `Good` or guarantee a signed `Unknown`.",{"_3328":2560,"_29138":2529,"_20209":55369,"_5":13819,"_26493":55288,"_2816":55370},[],"**CRL:** compare `latest_crl`, number and timestamps with the downloaded list. Check the serial in its contents. If unchanged, review `regenerate_on_revoke`, event delivery, jobs, signing and storage with the deployment operator.",{"_3328":2561,"_29138":2529,"_20209":55372,"_5":13819,"_26493":55288,"_2816":55373},[],"**Client:** check cache, policy for expired or unavailable evidence, critical IDP extension and rejection of a new connection.",{"_3328":2562,"_29138":2529,"_20209":55375,"_5":13819,"_26493":55288,"_2816":55376},[],"Reactivation from `CertificateHold` needs a new CRL for the client to stop seeing the hold. Reactivating a CA does not restore its descendant cascade; inspect every status and individual operation failure.",{"_3328":2563,"_29138":2529,"_20209":55378,"_5":13819,"_26493":55292,"_2816":55379},[],"Check expected identity, SAN, KU/EKU, matching key, presented intermediates and consumer permissions. Distinguish server TLS trust, client authentication and action authorization. Follow Validation for positive and rejection tests.",{"_3328":2564,"_29138":2529,"_20209":55381,"_5":13819,"_26493":55292,"_2816":55382},[],"When escalating a problem, provide identifiers, error and relevant public evidence, including query timestamps and version. This distinguishes issuance, publication and consumer application failures.",{"_3328":2565,"_29138":2565,"_5":14177,"_2816":55384,"_29461":55385,"_20209":55387,"_26493":2565},"3.8.0 to 4.0.0",[47397,55386],"Upgrades",[],{"_3328":2566,"_29138":2565,"_20209":55389,"_5":13819,"_26493":2565,"_2816":55390},[],"What changes in the 4.0.0 architecture, which changes break a 3.8.0 deployment, how to upgrade a Helm release step by step and how to validate the result.",{"_3328":2567,"_29138":2565,"_5":29458,"_20209":55392,"_26493":55393,"_2816":55394},[],"/docs/upgrades/3-8-0-to-4-0-0#architecture-changes","Architecture changes",{"_3328":2568,"_29138":2565,"_5":29458,"_20209":55396,"_26493":55397,"_2816":55398},[],"/docs/upgrades/3-8-0-to-4-0-0#one-postgresql-database-with-schemas","One PostgreSQL database with schemas",{"_3328":2569,"_29138":2565,"_5":29458,"_20209":55400,"_26493":55401,"_2816":55402},[],"/docs/upgrades/3-8-0-to-4-0-0#authorization-moves-into-the-authz-service","Authorization moves into the authz service",{"_3328":2570,"_29138":2565,"_5":29458,"_20209":55404,"_26493":55405,"_2816":55406},[],"/docs/upgrades/3-8-0-to-4-0-0#device-events-get-their-own-store","Device events get their own store",{"_3328":2571,"_29138":2565,"_5":29458,"_20209":55408,"_26493":55409,"_2816":55410},[],"/docs/upgrades/3-8-0-to-4-0-0#a-hardened-helm-chart","A hardened Helm chart",{"_3328":2572,"_29138":2565,"_5":29458,"_20209":55412,"_26493":55413,"_2816":55414},[],"/docs/upgrades/3-8-0-to-4-0-0#what-the-upgrade-migrates-automatically","What the upgrade migrates automatically",{"_3328":2573,"_29138":2565,"_5":29458,"_20209":55416,"_26493":55417,"_2816":55418},[],"/docs/upgrades/3-8-0-to-4-0-0#breaking-changes","Breaking changes",{"_3328":2574,"_29138":2565,"_5":29458,"_20209":55420,"_26493":55421,"_2816":55422},[],"/docs/upgrades/3-8-0-to-4-0-0#helm-chart-and-values","Helm chart and values",{"_3328":2575,"_29138":2565,"_5":29458,"_20209":55424,"_26493":55425,"_2816":55426},[],"/docs/upgrades/3-8-0-to-4-0-0#release-scoped-resource-names","Release-scoped resource names",{"_3328":2576,"_29138":2565,"_5":29458,"_20209":55428,"_26493":55429,"_2816":55430},[],"/docs/upgrades/3-8-0-to-4-0-0#strict-values-validation","Strict values validation",{"_3328":2577,"_29138":2565,"_5":29458,"_20209":55432,"_26493":55433,"_2816":55434},[],"/docs/upgrades/3-8-0-to-4-0-0#required-authorization-configuration","Required authorization configuration",{"_3328":2578,"_29138":2565,"_5":29458,"_20209":55436,"_26493":55437,"_2816":55438},[],"/docs/upgrades/3-8-0-to-4-0-0#gateway-token-validation-removed","Gateway token validation removed",{"_3328":2579,"_29138":2565,"_5":29458,"_20209":55440,"_26493":55441,"_2816":55442},[],"/docs/upgrades/3-8-0-to-4-0-0#non-root-containers","Non-root containers",{"_3328":2580,"_29138":2565,"_5":29458,"_20209":55444,"_26493":55445,"_2816":55446},[],"/docs/upgrades/3-8-0-to-4-0-0#amqp-over-tls","AMQP over TLS",{"_3328":2581,"_29138":2565,"_5":29458,"_20209":55448,"_26493":55449,"_2816":55450},[],"/docs/upgrades/3-8-0-to-4-0-0#renamed-and-reshaped-values","Renamed and reshaped values",{"_3328":2582,"_29138":2565,"_5":29458,"_20209":55452,"_26493":55453,"_2816":55454},[],"/docs/upgrades/3-8-0-to-4-0-0#data-and-storage","Data and storage",{"_3328":2583,"_29138":2565,"_5":29458,"_20209":55456,"_26493":55457,"_2816":55458},[],"/docs/upgrades/3-8-0-to-4-0-0#postgresql-consolidation","PostgreSQL consolidation",{"_3328":2584,"_29138":2565,"_5":29458,"_20209":55460,"_26493":55461,"_2816":55462},[],"/docs/upgrades/3-8-0-to-4-0-0#sqlite-storage-removed","SQLite storage removed",{"_3328":2585,"_29138":2565,"_5":29458,"_20209":55464,"_26493":55465,"_2816":55466},[],"/docs/upgrades/3-8-0-to-4-0-0#legacy-ca-keys-in-the-kms","Legacy CA keys in the KMS",{"_3328":2586,"_29138":2565,"_5":29458,"_20209":55468,"_26493":55469,"_2816":55470},[],"/docs/upgrades/3-8-0-to-4-0-0#apis-and-stored-configuration","APIs and stored configuration",{"_3328":2587,"_29138":2565,"_5":29458,"_20209":55472,"_26493":55473,"_2816":55474},[],"/docs/upgrades/3-8-0-to-4-0-0#dms-webhooks","DMS webhooks",{"_3328":2588,"_29138":2565,"_5":29458,"_20209":55476,"_26493":55477,"_2816":55478},[],"/docs/upgrades/3-8-0-to-4-0-0#re-enrollment-trust-set","Re-enrollment trust set",{"_3328":2589,"_29138":2565,"_5":29458,"_20209":55480,"_26493":55481,"_2816":55482},[],"/docs/upgrades/3-8-0-to-4-0-0#independent-re-enrollment-authentication","Independent re-enrollment authentication",{"_3328":2590,"_29138":2565,"_5":29458,"_20209":55484,"_26493":55485,"_2816":55486},[],"/docs/upgrades/3-8-0-to-4-0-0#dms-update-api","DMS update API",{"_3328":2591,"_29138":2565,"_5":29458,"_20209":55488,"_26493":55489,"_2816":55490},[],"/docs/upgrades/3-8-0-to-4-0-0#certificate-type-values","Certificate type values",{"_3328":2592,"_29138":2565,"_5":29458,"_20209":55492,"_26493":55493,"_2816":55494},[],"/docs/upgrades/3-8-0-to-4-0-0#device-events","Device events",{"_3328":2593,"_29138":2565,"_5":29458,"_20209":55496,"_26493":55497,"_2816":55498},[],"/docs/upgrades/3-8-0-to-4-0-0#helm-migration-guide","Helm migration guide",{"_3328":2594,"_29138":2565,"_5":29458,"_20209":55500,"_26493":55501,"_2816":55502},[],"/docs/upgrades/3-8-0-to-4-0-0#step-1-prepare","Step 1: Prepare",{"_3328":2595,"_29138":2565,"_5":29458,"_20209":55504,"_26493":55505,"_2816":55506},[],"/docs/upgrades/3-8-0-to-4-0-0#step-2-update-the-values-file","Step 2: Update the values file",{"_3328":2596,"_29138":2565,"_5":29458,"_20209":55508,"_26493":55509,"_2816":55510},[],"/docs/upgrades/3-8-0-to-4-0-0#step-3-run-the-upgrade","Step 3: Run the upgrade",{"_3328":2597,"_29138":2565,"_5":29458,"_20209":55512,"_26493":55513,"_2816":55514},[],"/docs/upgrades/3-8-0-to-4-0-0#step-4-migrate-the-kms-and-va-data","Step 4: Migrate the KMS and VA data",{"_3328":2598,"_29138":2565,"_5":29458,"_20209":55516,"_26493":55517,"_2816":55518},[],"/docs/upgrades/3-8-0-to-4-0-0#step-5-remove-the-one-off-migration-values","Step 5: Remove the one-off migration values",{"_3328":2599,"_29138":2565,"_5":29458,"_20209":55520,"_26493":55521,"_2816":55522},[],"/docs/upgrades/3-8-0-to-4-0-0#deployments-without-helm","Deployments without Helm",{"_3328":2600,"_29138":2565,"_5":29458,"_20209":55524,"_26493":55525,"_2816":51443},[],"/docs/upgrades/3-8-0-to-4-0-0#troubleshooting",{"_3328":2601,"_29138":2565,"_5":29458,"_20209":55527,"_26493":55528,"_2816":55529},[],"/docs/upgrades/3-8-0-to-4-0-0#validation-checklist","Validation checklist",{"_3328":2602,"_29138":2565,"_5":29458,"_20209":55531,"_26493":55532,"_2816":55533},[],"/docs/upgrades/3-8-0-to-4-0-0#delete-the-old-volumes","Delete the old volumes",{"_3328":2603,"_29138":2565,"_20209":55535,"_5":13819,"_26493":2565,"_2816":55536},[],"Lamassu 4.0.0 is a major release. Storage consolidates into a single PostgreSQL database, a new `authz` service authorizes every request, the Helm chart is hardened, and several APIs and stored configurations change shape. Most data converts automatically during the upgrade, but some changes need operator action before, during or after it.",{"_3328":2604,"_29138":2565,"_20209":55538,"_5":13819,"_26493":2565,"_2816":55539},[],"This page is organized in four parts. Read them in order before you upgrade production:",{"_3328":2605,"_29138":2565,"_20209":55541,"_5":13819,"_26493":2565,"_2816":55542},[],"Architecture changes: what is different in 4.0.0 and what the upgrade migrates on its own.",{"_3328":2606,"_29138":2565,"_20209":55544,"_5":13819,"_26493":2565,"_2816":55545},[],"Breaking changes: every change that can break a 3.8.0 deployment, who it affects and what to do.",{"_3328":2607,"_29138":2565,"_20209":55547,"_5":13819,"_26493":2565,"_2816":55548},[],"Helm migration guide: the step-by-step procedure for a Helm-managed release.",{"_3328":2608,"_29138":2565,"_20209":55550,"_5":13819,"_26493":2565,"_2816":55551},[],"Validation checklist: how to confirm the upgrade worked before you remove the old data.",{"_3328":2609,"_29138":2565,"_20209":55553,"_5":13819,"_26493":2565,"_2816":55554},[],"The 4.0.0 release is upcoming and the backend migration steps on this page are provisional. Verify each procedure against the final release artifacts before upgrading production.",{"_3328":2610,"_29138":2565,"_20209":55556,"_5":13819,"_26493":55397,"_2816":55557},[],"3.8.0 gave each service its own database. The 4.0.0 backend connects to a single PostgreSQL database named `pki` and isolates each service in a schema: `kms`, `ca`, `va`, `devicemanager`, `dmsmanager` and `alerts`. The `authz` service keeps its principals, grants and policies in a separate `authz` database (the development monolith uses an `authz` schema inside `pki` instead), and WFX keeps its own `wfx` database.",{"_3328":2611,"_29138":2565,"_20209":55559,"_5":13819,"_26493":55397,"_2816":55560},[],"PostgreSQL is now the only storage engine. SQLite support is removed, and the `couch_db` and `dynamo_db` engines are not registered in 4.0.0.",{"_3328":2612,"_29138":2565,"_20209":55562,"_5":13819,"_26493":55401,"_2816":55563},[],"In 3.8.0 the API Gateway validated tokens: a JWT policy on every private route checked the signature and only let through tokens that carried the administrator role. Every route was open to any token that passed that check.",{"_3328":2613,"_29138":2565,"_20209":55565,"_5":13819,"_26493":55401,"_2816":55566},[],"4.0.0 removes the gateway policy. The `/api/*` routes reach the services directly, and each service authorizes every request through `authz`, which validates the token against the identity provider's JWKS endpoint and applies fine-grained, entity-level policies to CAs, certificates, devices, DMSs, KMS keys and VA roles. There is no implicit superuser: the first administrator comes from a bootstrap principal that you configure. The access control page documents principals, policies and the first administrator.",{"_3328":2614,"_29138":2565,"_20209":55568,"_5":13819,"_26493":55405,"_2816":55569},[],"Historical device events move from the `devices.events` column to a dedicated `device_events` store with their own endpoints. The events endpoint can also stream events over Server-Sent Events (SSE); to fan events out across service instances, each Device Manager instance binds its own durable AMQP queue.",{"_3328":2615,"_29138":2565,"_20209":55571,"_5":13819,"_26493":55409,"_2816":55572},[],"Version 4.0.0 of the chart is a security-hardening release:",{"_3328":2616,"_29138":2565,"_20209":55574,"_5":13819,"_26493":55409,"_2816":55575},[],"**Release-scoped resource names.** Every chart-managed resource is named `<release>-lamassu-<component>` instead of the fixed names used in 3.8.0 (`kms`, `va`, `ca`, ...). With a release named `prod` the StatefulSets become `prod-lamassu-kms` and `prod-lamassu-va`. The `nameOverride` and `fullnameOverride` values change the prefix.",{"_3328":2617,"_29138":2565,"_20209":55577,"_5":13819,"_26493":55409,"_2816":55578},[],"**Non-root containers.** Every workload runs as the numeric user `65532:65532` with a `RuntimeDefault` seccomp profile and dropped capabilities. Pods do not mount the service-account token by default, and the chart creates a dedicated ServiceAccount.",{"_3328":2618,"_29138":2565,"_20209":55580,"_5":13819,"_26493":55409,"_2816":55581},[],"**Strict values validation.** `values.schema.json` rejects unknown keys, so leftover 3.8.0 blocks fail `helm lint` and `helm upgrade` instead of being silently ignored.",{"_3328":2619,"_29138":2565,"_20209":55583,"_5":13819,"_26493":55409,"_2816":55584},[],"**No injected scheduling rules.** The chart no longer adds pod anti-affinity or topology spread constraints on its own.",{"_3328":2620,"_29138":2565,"_20209":55586,"_5":13819,"_26493":55413,"_2816":55587},[],"Several migrations run without intervention when you upgrade a Helm release:",{"_3328":2621,"_29138":2565,"_20209":55589,"_5":13819,"_26493":55413,"_2816":55590},[],"Before any service starts, the chart's pre-install/pre-upgrade job prepares PostgreSQL. It creates the `pki`, `authz` and `wfx` databases when they do not exist, creates one schema per service inside `pki`, and imports each 3.8.0 per-service database into its schema. Each import runs as a single transaction, so a failed import leaves no partial schema and a retried job imports again. The job then runs the database migrations for every schema, migrates `authz`, preloads its policies and seeds the `services.authz.bootstrap` principals. It is idempotent and requires a PostgreSQL role allowed to create databases and schemas, as described in Install with Helm.",{"_3328":2622,"_29138":2565,"_20209":55592,"_5":13819,"_26493":55413,"_2816":55593},[],"Stored DMS configuration is rewritten to the 4.0.0 layout, and historical device events are transformed into the new store.",{"_3328":2623,"_29138":2565,"_20209":55595,"_5":13819,"_26493":55413,"_2816":55596},[],"When `migrations.caToKms.enabled` is set, a pre-upgrade hook registers legacy CA keys in the KMS.",{"_3328":2624,"_29138":2565,"_20209":55598,"_5":13819,"_26493":55413,"_2816":55599},[],"Two things never migrate on their own: the KMS and VA data on local volumes, which stays on volumes the upgraded pods no longer use, and the values file, which you update by hand. Deployments that do not use the Helm chart also have to move their database data themselves; see Deployments without Helm.",{"_3328":2625,"_29138":2565,"_20209":55601,"_5":13819,"_26493":55417,"_2816":55602},[],"Change",{"_3328":2626,"_29138":2565,"_20209":55604,"_5":13819,"_26493":55417,"_2816":55605},[],"Who is affected",{"_3328":2627,"_29138":2565,"_20209":55607,"_5":13819,"_26493":55417,"_2816":55608},[],"Severity",{"_3328":2628,"_29138":2565,"_20209":55610,"_5":13819,"_26493":55417,"_2816":54207},[],{"_3328":2629,"_29138":2565,"_20209":55612,"_5":13819,"_26493":55417,"_2816":55426},[],{"_3328":2630,"_29138":2565,"_20209":55614,"_5":13819,"_26493":55417,"_2816":55615},[],"Helm releases with a filesystem KMS engine or local VA CRL storage",{"_3328":2631,"_29138":2565,"_20209":55617,"_5":13819,"_26493":55417,"_2816":55618},[],"High: KMS and VA start on empty volumes",{"_3328":2632,"_29138":2565,"_20209":55620,"_5":13819,"_26493":55417,"_2816":55621},[],"Copy the data into the new volumes",{"_3328":2633,"_29138":2565,"_20209":55623,"_5":13819,"_26493":55417,"_2816":55430},[],{"_3328":2634,"_29138":2565,"_20209":55625,"_5":13819,"_26493":55417,"_2816":55626},[],"Every Helm release",{"_3328":2635,"_29138":2565,"_20209":55628,"_5":13819,"_26493":55417,"_2816":55629},[],"High: `helm upgrade` fails",{"_3328":2636,"_29138":2565,"_20209":55631,"_5":13819,"_26493":55417,"_2816":55632},[],"Remove or rename legacy keys",{"_3328":2637,"_29138":2565,"_20209":55634,"_5":13819,"_26493":55417,"_2816":55434},[],{"_3328":2638,"_29138":2565,"_20209":55636,"_5":13819,"_26493":55417,"_2816":55637},[],"Every deployment",{"_3328":2639,"_29138":2565,"_20209":55639,"_5":13819,"_26493":55417,"_2816":55640},[],"High: without a bootstrap principal there is no administrator",{"_3328":2640,"_29138":2565,"_20209":55642,"_5":13819,"_26493":55417,"_2816":55643},[],"Configure `services.authz`",{"_3328":2641,"_29138":2565,"_20209":55645,"_5":13819,"_26493":55417,"_2816":55438},[],{"_3328":2642,"_29138":2565,"_20209":55647,"_5":13819,"_26493":55417,"_2816":55626},[],{"_3328":2643,"_29138":2565,"_20209":55649,"_5":13819,"_26493":55417,"_2816":55650},[],"High: `helm upgrade` fails on the old keys",{"_3328":2644,"_29138":2565,"_20209":55652,"_5":13819,"_26493":55417,"_2816":55653},[],"Move JWKS and roles into `services.authz`",{"_3328":2645,"_29138":2565,"_20209":55655,"_5":13819,"_26493":55417,"_2816":55458},[],{"_3328":2646,"_29138":2565,"_20209":55657,"_5":13819,"_26493":55417,"_2816":55658},[],"3.8.0 deployments with per-service databases",{"_3328":2647,"_29138":2565,"_20209":55660,"_5":13819,"_26493":55417,"_2816":55661},[],"High: services find no data, or a migration aborts",{"_3328":2648,"_29138":2565,"_20209":55663,"_5":13819,"_26493":55417,"_2816":55664},[],"Clean duplicate CA IDs and empty `engine_id` values first; move data manually outside Helm",{"_3328":2649,"_29138":2565,"_20209":55666,"_5":13819,"_26493":55417,"_2816":55462},[],{"_3328":2650,"_29138":2565,"_20209":55668,"_5":13819,"_26493":55417,"_2816":55669},[],"Deployments on SQLite, `couch_db` or `dynamo_db`",{"_3328":2651,"_29138":2565,"_20209":55671,"_5":13819,"_26493":55417,"_2816":55672},[],"High: the backend no longer starts with them",{"_3328":2652,"_29138":2565,"_20209":55674,"_5":13819,"_26493":55417,"_2816":55675},[],"Move to PostgreSQL before upgrading",{"_3328":2653,"_29138":2565,"_20209":55677,"_5":13819,"_26493":55417,"_2816":55678},[],"Webhooks with file references",{"_3328":2654,"_29138":2565,"_20209":55680,"_5":13819,"_26493":55417,"_2816":55681},[],"DMSs whose webhook mTLS certificate or key were file paths",{"_3328":2655,"_29138":2565,"_20209":55683,"_5":13819,"_26493":55417,"_2816":55684},[],"High: enrollments calling the webhook fail",{"_3328":2656,"_29138":2565,"_20209":55686,"_5":13819,"_26493":55417,"_2816":55687},[],"Re-enter certificate and key as PEM, or remove the file fields",{"_3328":2657,"_29138":2565,"_20209":55689,"_5":13819,"_26493":55417,"_2816":55442},[],{"_3328":2658,"_29138":2565,"_20209":55691,"_5":13819,"_26493":55417,"_2816":55692},[],"Releases with per-service identity overrides or mounted key material",{"_3328":2659,"_29138":2565,"_20209":55694,"_5":13819,"_26493":55417,"_2816":55695},[],"Medium: services cannot read their files",{"_3328":2660,"_29138":2565,"_20209":55697,"_5":13819,"_26493":55417,"_2816":55698},[],"Remove the overrides and fix volume ownership",{"_3328":2661,"_29138":2565,"_20209":55700,"_5":13819,"_26493":55417,"_2816":55446},[],{"_3328":2662,"_29138":2565,"_20209":55702,"_5":13819,"_26493":55417,"_2816":55703},[],"Releases that set `amqp.tls`",{"_3328":2663,"_29138":2565,"_20209":55705,"_5":13819,"_26493":55417,"_2816":55706},[],"Medium: clients connect to the wrong port",{"_3328":2664,"_29138":2565,"_20209":55708,"_5":13819,"_26493":55417,"_2816":55709},[],"Point `amqp.port` at the TLS listener, or disable TLS",{"_3328":2665,"_29138":2565,"_20209":55711,"_5":13819,"_26493":55417,"_2816":55466},[],{"_3328":2666,"_29138":2565,"_20209":55713,"_5":13819,"_26493":55417,"_2816":55714},[],"Installations whose CA keys predate the KMS",{"_3328":2667,"_29138":2565,"_20209":55716,"_5":13819,"_26493":55417,"_2816":55717},[],"Medium: CA keys stay unmanaged",{"_3328":2668,"_29138":2565,"_20209":55719,"_5":13819,"_26493":55417,"_2816":55720},[],"Run the CA-to-KMS migration",{"_3328":2669,"_29138":2565,"_20209":55722,"_5":13819,"_26493":55417,"_2816":55723},[],"Receiver certificate verification",{"_3328":2670,"_29138":2565,"_20209":55725,"_5":13819,"_26493":55417,"_2816":55726},[],"DMSs whose webhook had `validate_server_cert: false`",{"_3328":2671,"_29138":2565,"_20209":55728,"_5":13819,"_26493":55417,"_2816":55729},[],"Medium: credentials go to an unverified receiver",{"_3328":2672,"_29138":2565,"_20209":55731,"_5":13819,"_26493":55417,"_2816":55732},[],"Set `insecure_skip_verify` to `false`",{"_3328":2673,"_29138":2565,"_20209":55734,"_5":13819,"_26493":55417,"_2816":55478},[],{"_3328":2674,"_29138":2565,"_20209":55736,"_5":13819,"_26493":55417,"_2816":55737},[],"Scripts and consoles that edit DMSs through the API",{"_3328":2675,"_29138":2565,"_20209":55739,"_5":13819,"_26493":55417,"_2816":55740},[],"Medium: an old-layout edit silently empties `validation_cas`",{"_3328":2676,"_29138":2565,"_20209":55742,"_5":13819,"_26493":55417,"_2816":55743},[],"Read the DMS before editing and use the new field",{"_3328":2677,"_29138":2565,"_20209":55745,"_5":13819,"_26493":55417,"_2816":55494},[],{"_3328":2678,"_29138":2565,"_20209":55747,"_5":13819,"_26493":55417,"_2816":55748},[],"Consumers that read the device `events` field",{"_3328":2679,"_29138":2565,"_20209":55750,"_5":13819,"_26493":55417,"_2816":55751},[],"Medium: the field disappears",{"_3328":2680,"_29138":2565,"_20209":55753,"_5":13819,"_26493":55417,"_2816":55754},[],"Use the new event endpoints",{"_3328":2681,"_29138":2565,"_20209":55756,"_5":13819,"_26493":55417,"_2816":55450},[],{"_3328":2682,"_29138":2565,"_20209":55758,"_5":13819,"_26493":55417,"_2816":55759},[],"Releases that override `toolbox`, `services.connectors`, ports, probes or scheduling",{"_3328":2683,"_29138":2565,"_20209":55761,"_5":13819,"_26493":55417,"_2816":55762},[],"Low to medium: validation errors or changed defaults",{"_3328":2684,"_29138":2565,"_20209":55764,"_5":13819,"_26493":55417,"_2816":55765},[],"Update the values file",{"_3328":2685,"_29138":2565,"_20209":55767,"_5":13819,"_26493":55417,"_2816":55486},[],{"_3328":2686,"_29138":2565,"_20209":55769,"_5":13819,"_26493":55417,"_2816":55770},[],"Clients that send the DMS ID in the update body",{"_3328":2687,"_29138":2565,"_20209":55772,"_5":13819,"_26493":55417,"_2816":55773},[],"Low: the ID in the URL wins",{"_3328":2688,"_29138":2565,"_20209":55775,"_5":13819,"_26493":55417,"_2816":55776},[],"Send the ID in the URL",{"_3328":2689,"_29138":2565,"_20209":55778,"_5":13819,"_26493":55417,"_2816":55490},[],{"_3328":2690,"_29138":2565,"_20209":55780,"_5":13819,"_26493":55417,"_2816":55781},[],"Consumers that match on certificate `type`",{"_3328":2691,"_29138":2565,"_20209":55783,"_5":13819,"_26493":55417,"_2816":55784},[],"Low: two values are renamed",{"_3328":2692,"_29138":2565,"_20209":55786,"_5":13819,"_26493":55417,"_2816":55787},[],"Adapt consumers",{"_3328":2693,"_29138":2565,"_20209":55789,"_5":13819,"_26493":55417,"_2816":55482},[],{"_3328":2694,"_29138":2565,"_20209":55791,"_5":13819,"_26493":55417,"_2816":55792},[],"Any DMS",{"_3328":2695,"_29138":2565,"_20209":55794,"_5":13819,"_26493":55417,"_2816":55795},[],"Low: informational",{"_3328":2696,"_29138":2565,"_20209":55797,"_5":13819,"_26493":55417,"_2816":55798},[],"Read both blocks before editing",{"_3328":2697,"_29138":2565,"_20209":55800,"_5":13819,"_26493":55425,"_2816":55801},[],"Kubernetes derives a StatefulSet's PVC name from its pod name (`<volumeClaimTemplate>-<pod-name>`). Renaming the `kms` and `va` StatefulSets means `helm upgrade` binds brand-new, empty PVCs instead of the existing ones. The KMS key material and VA CRLs are not deleted — the old PVCs are orphaned, not removed — but the upgraded pods fail with `no such file or directory` (KMS) or `code=NotFound` (VA) until you copy the data across. This affects KMS when `services.kms.cryptoEngines` uses a `filesystem` engine and VA when `services.va.fileStore.type` is `local`. Every other renamed resource is stateless and is recreated without data-loss risk.",{"_3328":2698,"_29138":2565,"_20209":55803,"_5":13819,"_26493":55425,"_2816":55804},[],"Step 4 of the migration guide copies the data.",{"_3328":2699,"_29138":2565,"_20209":55806,"_5":13819,"_26493":55429,"_2816":55807},[],"`values.schema.json` rejects unknown keys, so every block that 4.0.0 removed or renamed — `toolbox`, `auth.oidc.apiGateway`, `auth.authorization` and others — fails `helm lint` and `helm upgrade` outright. Step 2 lists every change.",{"_3328":2700,"_29138":2565,"_20209":55809,"_5":13819,"_26493":55433,"_2816":55810},[],"3.8.0 had no authorization service, so a 3.8.0 values file has nothing to migrate from: you must add the `services.authz` configuration yourself. It needs the JWKS endpoint of your identity provider, the database mappings the authorization engine uses, and a bootstrap principal that matches how your provider assigns the administrator role. Without a matching principal nobody can administer the PKI.",{"_3328":2701,"_29138":2565,"_20209":55812,"_5":13819,"_26493":55437,"_2816":55813},[],"`auth.oidc.apiGateway.jwks`, `auth.authorization.rolesClaim` and `auth.authorization.roles.admin` are removed with no compatibility aliases, and the schema rejects them. Their settings move into `services.authz`: the JWKS URL becomes `services.authz.jwkUrl`, and the role claim and administrator role become a claim rule of the bootstrap principal. `auth.oidc.frontend` is unchanged.",{"_3328":2702,"_29138":2565,"_20209":55815,"_5":13819,"_26493":55441,"_2816":55816},[],"Service images run on a distroless base as the numeric user `65532`; the `authz` image is Ubuntu with a non-root user that has the same UID. The per-service overrides `services.kms.securityContext.runAsGroup: 0` and `services.authz.securityContext.runAsUser`/`runAsGroup: 999` are removed; group access to the KMS volume and PKCS#11 socket is now handled by the pod-level `fsGroup: 65532`.",{"_3328":2703,"_29138":2565,"_20209":55818,"_5":13819,"_26493":55441,"_2816":55819},[],"3.8.0 did not pin a container identity, so existing files can carry any UID. Any volume that holds keys or CRLs must be owned by `65532:65532`, or at least readable (and, where needed, writable) by that identity.",{"_3328":2704,"_29138":2565,"_20209":55821,"_5":13819,"_26493":55445,"_2816":55822},[],"In 3.8.0 `amqp.tls` was not applied and event-bus clients always connected over plaintext. In 4.0.0 `amqp.tls: true` switches them to AMQPS. The default `amqp.port` stays `5672` and does not change when TLS is enabled, so a values file that already set `amqp.tls: true` must point `amqp.port` at the broker's TLS listener (`amqps`, commonly `5671`), or set `amqp.tls: false` to keep plaintext. Clients must also trust the broker's certificate.",{"_3328":2705,"_29138":2565,"_20209":55824,"_5":13819,"_26493":55449,"_2816":55825},[],"`toolbox` is renamed to `connectivityTest`, and the `helm test` hook uses the upstream `curlimages/curl` image pinned by digest.",{"_3328":2706,"_29138":2565,"_20209":55827,"_5":13819,"_26493":55449,"_2816":55828},[],"`services.connectors` is a map keyed by connector ID instead of a list.",{"_3328":2707,"_29138":2565,"_20209":55830,"_5":13819,"_26493":55449,"_2816":55831},[],"The `services.ui.port` default is `8085`, the unprivileged port of the rootless image.",{"_3328":2708,"_29138":2565,"_20209":55833,"_5":13819,"_26493":55449,"_2816":55834},[],"The shared `probes:` block is replaced by independent `livenessProbe`, `readinessProbe` and `startupProbe` blocks.",{"_3328":2709,"_29138":2565,"_20209":55836,"_5":13819,"_26493":55449,"_2816":55837},[],"With `tls.certManagerOptions.issuer` empty, the chart creates a release-scoped self-signed issuer, for example `lamassu-downstream-ca-selfsigned-issuer`. The legacy literal `downstream-ca-selfsigned-issuer` is still accepted and resolves to it.",{"_3328":2710,"_29138":2565,"_20209":55839,"_5":13819,"_26493":55449,"_2816":55840},[],"Anti-affinity and topology spread must be configured explicitly through `affinity` and `topologySpreadConstraints`.",{"_3328":2711,"_29138":2565,"_20209":55842,"_5":13819,"_26493":55457,"_2816":55843},[],"Every 3.8.0 per-service database must end up as a schema of `pki`, keeping its structure, indexes, constraints, data and migration history. The Helm chart does this automatically; deployments without Helm do it by hand (see Deployments without Helm).",{"_3328":2712,"_29138":2565,"_20209":55845,"_5":13819,"_26493":55457,"_2816":55846},[],"Two schema migrations abort on data that 3.8.0 allowed, so clean the data before upgrading:",{"_3328":2713,"_29138":2565,"_20209":55848,"_5":13819,"_26493":55457,"_2816":55849},[],"The CA migration adds a UNIQUE constraint on `ca_certificates.id` and aborts if duplicate CA IDs exist. Imports already reject duplicates with `409`, so new ones cannot normally appear.",{"_3328":2714,"_29138":2565,"_20209":55851,"_5":13819,"_26493":55457,"_2816":55852},[],"The KMS migration promotes the primary key to `(key_id, engine_id)` and aborts with `cannot promote (key_id, engine_id) to primary key: N row(s) have no engine_id; backfill them before migrating` when `kms_keys` rows lack `engine_id`. Backfill `engine_id` first.",{"_3328":2715,"_29138":2565,"_20209":55854,"_5":13819,"_26493":55457,"_2816":55855},[],"The same KMS migration deletes, with a `NOTICE`, aliases that equal an existing key ID, because identifiers now resolve as a key ID before an alias. Affected aliases are dropped, not redirected.",{"_3328":2716,"_29138":2565,"_20209":55857,"_5":13819,"_26493":55461,"_2816":55858},[],"The SQLite storage engine is removed, and the `couch_db` and `dynamo_db` engines are not registered in 4.0.0: their configuration constants remain, but they select no engine. Deployments on any of them must move to PostgreSQL and consolidate their data into the `pki` schemas before upgrading.",{"_3328":2717,"_29138":2565,"_20209":55860,"_5":13819,"_26493":55465,"_2816":55861},[],"CA certificates of type `MANAGED` or `IMPORTED_WITH_KEY` whose private keys predate the KMS service have the key stored only in the crypto engine, under the certificate's `subject_key_id`, with no KMS record. The `ca-to-kms-migration` tool registers them:",{"_3328":2718,"_29138":2565,"_20209":55863,"_5":13819,"_26493":55465,"_2816":55864},[],"The `key_id` is the certificate's `subject_key_id` (SHA-256 of the public key).",{"_3328":2719,"_29138":2565,"_20209":55866,"_5":13819,"_26493":55465,"_2816":55867},[],"The tool is idempotent: keys already in the KMS are skipped, so it can be run several times.",{"_3328":2720,"_29138":2565,"_20209":55869,"_5":13819,"_26493":55465,"_2816":55870},[],"Certificates that cannot be read, or lack an engine or a subject key ID, are skipped with a warning. Review the logs and resolve the affected records.",{"_3328":2721,"_29138":2565,"_20209":55872,"_5":13819,"_26493":55465,"_2816":55873},[],"When CA certificates sharing a `subject_key_id` declare conflicting `engine_id`s, the tool fails that key and exits with code `1`, which fails a Helm pre-upgrade hook. Resolve the conflict manually before rerunning.",{"_3328":2722,"_29138":2565,"_20209":55875,"_5":13819,"_26493":55465,"_2816":55876},[],"With Helm, enable the hook for the upgrade in step 2; without Helm, run the tool by hand.",{"_3328":2723,"_29138":2565,"_20209":55878,"_5":13819,"_26493":55473,"_2816":55879},[],"Stored webhook configs are rewritten to the current layout and their fields renamed:",{"_3328":2724,"_29138":2565,"_20209":55881,"_5":13819,"_26493":55473,"_2816":55882},[],"Field in 3.8.0",{"_3328":2725,"_29138":2565,"_20209":55884,"_5":13819,"_26493":55473,"_2816":55885},[],"Field in 4.0.0",{"_3328":2726,"_29138":2565,"_20209":55887,"_5":13819,"_26493":55473,"_2816":55888},[],"`validate_server_cert`",{"_3328":2727,"_29138":2565,"_20209":55890,"_5":13819,"_26493":55473,"_2816":55891},[],"`insecure_skip_verify` (value negated)",{"_3328":2728,"_29138":2565,"_20209":55893,"_5":13819,"_26493":55473,"_2816":55894},[],"`oidc`",{"_3328":2729,"_29138":2565,"_20209":55896,"_5":13819,"_26493":55473,"_2816":55897},[],"`jwt_options`",{"_3328":2730,"_29138":2565,"_20209":55899,"_5":13819,"_26493":55473,"_2816":55900},[],"`apikey`",{"_3328":2731,"_29138":2565,"_20209":55902,"_5":13819,"_26493":55473,"_2816":55903},[],"`apikey_options`",{"_3328":2732,"_29138":2565,"_20209":55905,"_5":13819,"_26493":55473,"_2816":55906},[],"`mtls`",{"_3328":2733,"_29138":2565,"_20209":55908,"_5":13819,"_26493":55473,"_2816":55909},[],"`mtls_options`",{"_3328":2734,"_29138":2565,"_20209":55911,"_5":13819,"_26493":55473,"_2816":55912},[],"When the legacy mTLS certificate and key are both PEM, they move into `mtls_options.cert_content` and `mtls_options.key_content` and need no action. Two cases do need it.",{"_3328":2735,"_29138":2565,"_20209":55914,"_5":13819,"_26493":55473,"_2816":55915},[],"**Webhooks with file references.** A mixed config, with a PEM certificate and a file-path key, is migrated to `mtls_options.cert_file` and `mtls_options.key_file`. Webhook delivery rejects those fields on every call, whatever the configured authentication mode, so every enroll and re-enroll that calls that webhook fails until the config is fixed. If the webhook uses mTLS, re-enter the certificate and key as Base64-encoded or plain PEM; if it does not, remove the leftover file fields. Metadata-only updates keep working in the meantime (`PUT` or `PATCH` on `/v1/dms/:id/metadata`). In a variant of the same problem, a stored config with file paths inside `mtls_options.cert_content` or `mtls_options.key_content` makes every full settings update (`POST /v1/dms` or `PUT /v1/dms/:id`) fail validation; settings are replaced wholesale, so resend the config with the certificate and key as PEM.",{"_3328":2736,"_29138":2565,"_20209":55917,"_5":13819,"_26493":55473,"_2816":55918},[],"**Receiver certificate verification.** A config with `validate_server_cert: false` becomes `insecure_skip_verify: true`, so receiver verification stays skipped until that field is set to `false`. Correct it on every migrated config: the webhook authorization channel carries the API key or bearer token, and skipping verification exposes those credentials to a network-positioned attacker. Keep `insecure_skip_verify: true` only when the receiver certificate is deliberately unverifiable.",{"_3328":2737,"_29138":2565,"_20209":55920,"_5":13819,"_26493":55477,"_2816":55921},[],"The flat field `reenrollment_settings.additional_validation_cas` moves into the nested field `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`:",{"_3328":2738,"_29138":2565,"_20209":55923,"_5":13819,"_26493":55477,"_2816":55924},[],"The effective trust set does not change, because the nested value was never consulted when validating re-enrollments. If the flat list was missing or null, it becomes an empty list.",{"_3328":2739,"_29138":2565,"_20209":55926,"_5":13819,"_26493":55477,"_2816":55927},[],"What changes is how API requests are handled. Bodies that still carry `additional_validation_cas` are accepted, but the value is silently dropped because unknown JSON fields are ignored, and GET responses no longer include it. An update body built from the old layout therefore empties `validation_cas` without any error. Always read the DMS before sending an edit and reuse the layout the API returns.",{"_3328":2740,"_29138":2565,"_20209":55929,"_5":13819,"_26493":55481,"_2816":55930},[],"Re-enrollment authentication settings are now stored independently from initial authentication. Nothing needs migrating, but read both blocks before editing a DMS so that you do not modify one while believing you are editing the other. The console exposes independent editors for both blocks; the DMS guide describes their fields, and you can also edit them through the DMS API.",{"_3328":2741,"_29138":2565,"_20209":55932,"_5":13819,"_26493":55485,"_2816":55933},[],"`PUT /v1/dms/:id` takes the DMS ID from the URL and validates the request body. An ID in the body is ignored, so update clients that relied on it.",{"_3328":2742,"_29138":2565,"_20209":55935,"_5":13819,"_26493":55489,"_2816":55936},[],"Stored certificate type values are renamed: `IMPORTED` becomes `IMPORTED_WITH_KEY` and `EXTERNAL` becomes `IMPORTED_WITHOUT_KEY`. `MANAGED` is unchanged. Adapt consumers that read or match on those values.",{"_3328":2743,"_29138":2565,"_20209":55938,"_5":13819,"_26493":55493,"_2816":55939},[],"The `events` field no longer appears in the device representation. Point consumers at the new endpoints:",{"_3328":2744,"_29138":2565,"_20209":55941,"_5":13819,"_26493":55493,"_2816":55942},[],"`GET /v1/devices/:id/events` returns a device's events.",{"_3328":2745,"_29138":2565,"_20209":55944,"_5":13819,"_26493":55493,"_2816":55945},[],"`POST /v1/devices/:id/events` creates an event.",{"_3328":2746,"_29138":2565,"_20209":55947,"_5":13819,"_26493":55493,"_2816":55948},[],"When the request `Accept` header includes `text/event-stream`, the events endpoint streams over SSE with a keepalive every 15 seconds, and returns `501` when SSE is disabled in the deployment. Each Device Manager instance binds a durable AMQP queue named after its service ID, `device-manager-sse-<uuid>`. Queues from crashed or replaced instances linger until removed, so configure an expiration or cleanup policy on the broker.",{"_3328":2747,"_29138":2565,"_20209":55950,"_5":13819,"_26493":55497,"_2816":55951},[],"The upgrade runs in a fixed order: prepare the data and values, run `helm upgrade`, then copy the KMS and VA data into the new volumes. The copy must run after the upgrade, because the destination StatefulSets and PVCs do not exist before it. If you are not upgrading an existing release, go straight to Install with Helm.",{"_3328":2748,"_29138":2565,"_20209":55953,"_5":13819,"_26493":55501,"_2816":55954},[],"Take a verifiable backup of PostgreSQL and schedule downtime. The upgrade moves every service's data into `pki`.",{"_3328":2749,"_29138":2565,"_20209":55956,"_5":13819,"_26493":55501,"_2816":55957},[],"If the deployment runs on SQLite, `couch_db` or `dynamo_db`, move it to PostgreSQL first.",{"_3328":2750,"_29138":2565,"_20209":55959,"_5":13819,"_26493":55501,"_2816":55960},[],"Resolve duplicate CA IDs and backfill `engine_id` in `kms_keys`, as described in PostgreSQL consolidation.",{"_3328":2751,"_29138":2565,"_20209":55962,"_5":13819,"_26493":55501,"_2816":55963},[],"Record the names of your local-storage PVCs:",{"_3328":2752,"_29138":2565,"_20209":55965,"_5":13819,"_26493":55501,"_2816":55966},[],"`helm upgrade` does not touch or delete the old PVCs, but nothing references them after the upgrade. You need their names to copy the data and to clean up later.",{"_3328":2753,"_29138":2565,"_20209":55968,"_5":13819,"_26493":55505,"_2816":55969},[],"**Add `services.authz`.** Configure the JWKS endpoint, the database mappings and the bootstrap principal:",{"_3328":2754,"_29138":2565,"_20209":55971,"_5":13819,"_26493":55505,"_2816":55972},[],"`jwkUrl` is fetched from the `authz` pod, not from the gateway, so a Service in the release namespace can be referenced by its short name. The default points at a Keycloak Service named `auth-keycloak`; set it explicitly if your identity provider lives anywhere else.",{"_3328":2755,"_29138":2565,"_20209":55974,"_5":13819,"_26493":55505,"_2816":55975},[],"`authz` is the authorization service's own storage for principals, grants and policies. `pki` is the database the authorization engine queries when it evaluates policies against entities. Only the `database` field of each entry is read; the connection always uses the global `postgres.hostname`, `postgres.port`, `postgres.username` and `postgres.password` values.",{"_3328":2756,"_29138":2565,"_20209":55977,"_5":13819,"_26493":55505,"_2816":55978},[],"If you kept the 3.8.0 role defaults (`realm_access.roles` and `pki-admin`), the default `services.authz.bootstrap` already matches them.",{"_3328":2757,"_29138":2565,"_20209":55980,"_5":13819,"_26493":55505,"_2816":55981},[],"**Delete the gateway token validation blocks.** Remove `auth.oidc.apiGateway` and `auth.authorization` once their settings are in `services.authz`:",{"_3328":2758,"_29138":2565,"_20209":55983,"_5":13819,"_26493":55505,"_2816":55984},[],"**Rename `toolbox` to `connectivityTest`:**",{"_3328":2759,"_29138":2565,"_20209":55986,"_5":13819,"_26493":55505,"_2816":55987},[],"**Remove the per-service identity overrides** `services.kms.securityContext.runAsGroup` and `services.authz.securityContext.runAsUser`/`runAsGroup`.",{"_3328":2760,"_29138":2565,"_20209":55989,"_5":13819,"_26493":55505,"_2816":55990},[],"**Convert `services.connectors` to a map** keyed by connector ID, each entry with its `type` and `image`:",{"_3328":2761,"_29138":2565,"_20209":55992,"_5":13819,"_26493":55505,"_2816":55993},[],"**Check AMQP.** If you set `amqp.tls: true`, also set `amqp.port` to the broker's TLS listener (commonly `5671`), or set `amqp.tls: false` to stay on plaintext.",{"_3328":2762,"_29138":2565,"_20209":55995,"_5":13819,"_26493":55505,"_2816":55996},[],"**Enable the CA-to-KMS migration** if your CA keys predate the KMS:",{"_3328":2763,"_29138":2565,"_20209":55998,"_5":13819,"_26493":55505,"_2816":55999},[],"**Review the remaining values:** overrides that pinned `services.ui.port` to `80`, the old `probes:` block, the TLS issuer, and explicit `affinity` and `topologySpreadConstraints` where your cluster needs them. Renamed and reshaped values describes each one.",{"_3328":2764,"_29138":2565,"_20209":56001,"_5":13819,"_26493":55505,"_2816":56002},[],"Run `helm lint` with the new values before upgrading; the strict schema reports any key that is still unknown.",{"_3328":2765,"_29138":2565,"_20209":56004,"_5":13819,"_26493":55509,"_2816":56005},[],"Helm runs the pre-upgrade hooks — the CA-to-KMS migration when enabled, and the database job — before applying any workload, so services never start against an unprepared database. If validation rejects unknown values, fix the values file and re-run.",{"_3328":2766,"_29138":2565,"_20209":56007,"_5":13819,"_26493":55509,"_2816":56008},[],"If the deployment uses local KMS or VA storage, those pods fail until you complete step 4, so `--wait` cannot succeed: Helm waits for them to become ready, times out, exits with an error and marks the release `failed`. The hooks have already run by then, and every manifest, including the new StatefulSets and their PVCs, has been applied. Helm does not roll anything back without `--atomic`. Continue with step 4, then re-run the same `helm upgrade` command so it completes and Helm records the release as `deployed`. Both hooks are idempotent, so they are safe to run again.",{"_3328":2767,"_29138":2565,"_20209":56010,"_5":13819,"_26493":55513,"_2816":56011},[],"Skip this step when `services.kms.cryptoEngines` never used a `filesystem` engine and `services.va.fileStore.type` was never `local`.",{"_3328":2768,"_29138":2565,"_20209":56013,"_5":13819,"_26493":55513,"_2816":56014},[],"**Find the new StatefulSets and PVCs.** Their names depend on the release name and any `nameOverride` or `fullnameOverride`; the PVC name is `<volumeClaimTemplate>-<StatefulSet name>-0`:",{"_3328":2769,"_29138":2565,"_20209":56016,"_5":13819,"_26493":55513,"_2816":56017},[],"With release `lamassu` and the default chart name, the new PVCs are `golang-engine-storage-lamassu-kms-0` and `local-crl-file-storage-lamassu-va-0`; with release `prod` they are `golang-engine-storage-prod-lamassu-kms-0` and `local-crl-file-storage-prod-lamassu-va-0`. Confirm both old and new PVCs exist before continuing. If `claims_ok` prints `ABORT`, the block stops before listing the claims: either a StatefulSet lookup failed, or a new claim resolves to the 3.8.0 claim. In the second case the copy would verify against itself and the final cleanup would delete the live volume. The chart always appends `-kms` and `-va` to the release-scoped name, so a collision means the claims are not what this guide expects; investigate before going on. Item 3 runs the same check and refuses to create the helper pod, so nothing touches the volumes. The check returns instead of calling `exit`, which would close your shell and lose the variables set so far. If you only migrate one of the two services, drop the other one's claims from the commands that follow.",{"_3328":2770,"_29138":2565,"_20209":56019,"_5":13819,"_26493":55513,"_2816":56020},[],"**Record the replica counts, scale the new StatefulSets down and wait for every pod that uses the claims to exit**, so nothing writes to either volume while you copy. Helm removes the 3.8.0 `kms` and `va` StatefulSets during the upgrade, but their pods `kms-0` and `va-0` can still be terminating and holding the old claims. While they run, the helper pod either cannot attach the claims or copies a volume that is still being written. The `wait` returns at once for pods that are already gone:",{"_3328":2771,"_29138":2565,"_20209":56022,"_5":13819,"_26493":55513,"_2816":56023},[],"**Run a short-lived helper pod** that mounts all four claims. It runs as root so it can change file ownership, so pin its image by digest and do not mount the service-account token:",{"_3328":2772,"_29138":2565,"_20209":56025,"_5":13819,"_26493":55513,"_2816":56026},[],"**Inspect before writing** so you do not clobber data the new pods may already have written:",{"_3328":2773,"_29138":2565,"_20209":56028,"_5":13819,"_26493":55513,"_2816":56029},[],"An empty result is the common case: a StatefulSet's own pod rarely gets far enough to write anything when its dependent data is missing. If the output is not empty, record the files and confirm with the service owner that they are disposable before you run the copy; do not overlay the 3.8.0 data onto an unknown store.",{"_3328":2774,"_29138":2565,"_20209":56031,"_5":13819,"_26493":55513,"_2816":56032},[],"**Copy the data, align ownership and verify the copy.** The second command must print `copy verified`; any `diff` output means the copy is incomplete, so do not continue:",{"_3328":2775,"_29138":2565,"_20209":56034,"_5":13819,"_26493":55513,"_2816":56035},[],"The `chown` is required even if the old files already look non-root-owned, because 4.0.0 requires exactly `65532:65532` and does not fall back to whatever the image declares.",{"_3328":2776,"_29138":2565,"_20209":56037,"_5":13819,"_26493":55513,"_2816":56038},[],"**Remove the helper and restore the recorded replica counts:**",{"_3328":2777,"_29138":2565,"_20209":56040,"_5":13819,"_26493":55513,"_2816":56041},[],"**Re-run the step 3 `helm upgrade` command.** The KMS and VA pods now start against the copied data, so `--wait` succeeds and the release moves from `failed` to `deployed`.",{"_3328":2778,"_29138":2565,"_20209":56043,"_5":13819,"_26493":55517,"_2816":56044},[],"After the upgrade that performed the CA-to-KMS migration succeeds, remove `migrations.caToKms.enabled` from your values (it defaults to `false`). The hook reads the legacy 3.8.0 `kms-config` ConfigMap while it still exists and falls back to the release-scoped `<release>-lamassu-kms-config` once it is gone.",{"_3328":2779,"_29138":2565,"_20209":56046,"_5":13819,"_26493":55517,"_2816":56047},[],"Then go through the validation checklist. Keep the old PVCs until it passes.",{"_3328":2780,"_29138":2565,"_20209":56049,"_5":13819,"_26493":55521,"_2816":56050},[],"Without the chart's database job, no tool moves data between databases: the migration tooling only applies migrations to a schema that already exists. Move each per-service database into its `pki` schema yourself, preserving structure, indexes, constraints, data and migration history, with writes stopped and a verified backup in hand.",{"_3328":2781,"_29138":2565,"_20209":56052,"_5":13819,"_26493":55521,"_2816":56053},[],"To apply migrations by hand, `goose-lamassu` must run against the `pki` database with `search_path=<schema>` in the connection string. The binary validates only `search_path`, not the database name, so check `dbname=pki` before running it, and repeat for `kms`, `ca`, `va`, `devicemanager`, `dmsmanager` and `alerts`:",{"_3328":2782,"_29138":2565,"_20209":56055,"_5":13819,"_26493":55521,"_2816":56056},[],"Run `ca-to-kms-migration` first with `--dry-run`, which reports without writing to KMS storage, and then for real:",{"_3328":2783,"_29138":2565,"_20209":56058,"_5":13819,"_26493":55521,"_2816":56059},[],"Point the tool's `storage` configuration at the `pki` database, where the CA and KMS data now live in the `ca` and `kms` schemas. The tool's options are described in `backend/cmd/ca-to-kms-migration/README.md` in the `lamassuiot` repository.",{"_3328":2784,"_29138":2565,"_20209":56061,"_5":13819,"_26493":55521,"_2816":56062},[],"The `goose-lamassu` README still shows per-database examples (`dbname=ca`, `dbname=kms`) and claims the tool validates the database name, and the `ca-to-kms-migration` README still describes the pre-4.0.0 two-database layout. Follow the `dbname=pki` form on this page instead of their examples.",{"_3328":2785,"_29138":2565,"_20209":56064,"_5":13819,"_26493":55525,"_2816":56065},[],"**KMS or VA pods crash with `no such file or directory` or `code=NotFound` right after the upgrade.** The pods are bound to the new, empty PVCs and the data migration has not run yet, or was copied into the wrong PVC. Follow step 4 and check that all four claims exist.",{"_3328":2786,"_29138":2565,"_20209":56067,"_5":13819,"_26493":55525,"_2816":56068},[],"**`helm upgrade --wait` times out and `helm status` reports the release as `failed`.** With local KMS or VA storage this is expected on the first run: the new pods cannot become ready before their data is copied. The hooks ran and the manifests and PVCs were applied, so complete step 4 and re-run the same `helm upgrade` command. If other pods are also not ready, check their logs, because something else is wrong.",{"_3328":2787,"_29138":2565,"_20209":56070,"_5":13819,"_26493":55525,"_2816":56071},[],"**The helper pod stays `Pending` or `ContainerCreating` and `kubectl wait` times out.** Another pod still holds one of the claims; on block storage `kubectl describe pod pvc-migrate-helper` shows a `Multi-Attach error`. Check with `kubectl get pods -n $NAMESPACE` that `kms-0`, `va-0` and the new KMS and VA pods are gone, then re-run the wait.",{"_3328":2788,"_29138":2565,"_20209":56073,"_5":13819,"_26493":55525,"_2816":56074},[],"**`helm upgrade` fails with an unknown-key validation error.** Remove or rename the legacy values — typically `toolbox`, `auth.oidc.apiGateway` or `auth.authorization` — because the strict schema rejects keys it does not know.",{"_3328":2789,"_29138":2565,"_20209":56076,"_5":13819,"_26493":55525,"_2816":56077},[],"**The upgrade fails at the database job.** The PostgreSQL role cannot create databases or schemas, or a schema migration aborted on duplicate CA IDs or missing `engine_id` values. Check the job logs, fix the privileges or the data, and re-run the upgrade.",{"_3328":2790,"_29138":2565,"_20209":56079,"_5":13819,"_26493":55525,"_2816":56080},[],"**The upgrade fails at the CA-to-KMS hook.** CA certificates that share a `subject_key_id` declare conflicting `engine_id`s. Resolve the conflict and re-run.",{"_3328":2791,"_29138":2565,"_20209":56082,"_5":13819,"_26493":55525,"_2816":56083},[],"**Nobody can log in after the upgrade.** Check that `services.authz.jwkUrl` is reachable from the `authz` pod, that `services.authz.bootstrap` matches a role your OIDC provider actually assigns, and that the database job completed.",{"_3328":2792,"_29138":2565,"_20209":56085,"_5":13819,"_26493":55528,"_2816":56086},[],"After the upgrade, check in this order:",{"_3328":2793,"_29138":2565,"_20209":56088,"_5":13819,"_26493":55528,"_2816":56089},[],"**Databases.** Each service reads the `pki` database with its own schema, `authz` and `wfx` data are reachable, and the migration status is registered per schema, including the CA unique-ID and KMS composite-key migrations.",{"_3328":2794,"_29138":2565,"_20209":56091,"_5":13819,"_26493":55528,"_2816":56092},[],"**KMS and VA start cleanly.** Their logs show no `no such file or directory` or `code=NotFound` errors.",{"_3328":2795,"_29138":2565,"_20209":56094,"_5":13819,"_26493":55528,"_2816":56095},[],"**Existing KMS keys work.** Issue a certificate from a CA that existed before the upgrade. None of the other checks reads a KMS key, so this is the only one that proves the key material was copied.",{"_3328":2796,"_29138":2565,"_20209":56097,"_5":13819,"_26493":55528,"_2816":56098},[],"**Existing CRLs are served.** `GET /crl/<ca-ski>` on VA returns a previously issued CRL, and new CRLs are issued.",{"_3328":2797,"_29138":2565,"_20209":56100,"_5":13819,"_26493":55528,"_2816":56101},[],"**Legacy CA keys.** If the CA-to-KMS migration ran, review its report and warnings and confirm the expected keys appear in the KMS.",{"_3328":2798,"_29138":2565,"_20209":56103,"_5":13819,"_26493":55528,"_2816":56104},[],"**Connectivity.** `helm test \"$RELEASE\" -n $NAMESPACE --logs` passes; the hook checks the CA, DMS Manager, Device Manager and VA health endpoints and the UI response.",{"_3328":2799,"_29138":2565,"_20209":56106,"_5":13819,"_26493":55528,"_2816":56107},[],"**Authorization.** Sign in as the bootstrap principal and confirm administration works, check that an identity without permissions receives `403`, and review client and integration permissions.",{"_3328":2800,"_29138":2565,"_20209":56109,"_5":13819,"_26493":55528,"_2816":56110},[],"**AMQP.** The backend connects to the broker with the expected TLS settings, and the cleanup policy for SSE queues is in place.",{"_3328":2801,"_29138":2565,"_20209":56112,"_5":13819,"_26493":55528,"_2816":56113},[],"**Device events.** `GET /v1/devices/:id/events` returns the historical events of a device that had them.",{"_3328":2802,"_29138":2565,"_20209":56115,"_5":13819,"_26493":55528,"_2816":56116},[],"**Webhooks without file fields.** For each DMS that uses a webhook for enrollment or re-enrollment, the `config` block carries `insecure_skip_verify` and the expected option block (`apikey_options`, `jwt_options` or `mtls_options`), with the certificate and key as PEM and no `cert_file` or `key_file`.",{"_3328":2803,"_29138":2565,"_20209":56118,"_5":13819,"_26493":55528,"_2816":56119},[],"**Receiver verification.** `insecure_skip_verify` is `false`, unless the receiver certificate is intentionally unverified.",{"_3328":2804,"_29138":2565,"_20209":56121,"_5":13819,"_26493":55528,"_2816":56122},[],"**Webhook delivery.** One enroll or re-enroll through each migrated webhook completes its authorization call.",{"_3328":2805,"_29138":2565,"_20209":56124,"_5":13819,"_26493":55528,"_2816":56125},[],"**Trust set.** `est_rfc7030_settings.client_certificate_settings.validation_cas` holds the expected CAs, in particular those of the old CA during rotation overlaps.",{"_3328":2806,"_29138":2565,"_20209":56127,"_5":13819,"_26493":55528,"_2816":56128},[],"**API clients.** Scripts and consoles no longer use the old DMS layout (flat `additional_validation_cas`, or the legacy `mtls`, `apikey` and `oidc` fields), send DMS updates with the ID in the URL, and match on the new certificate `type` values.",{"_3328":2807,"_29138":2565,"_20209":56130,"_5":13819,"_26493":55532,"_2816":56131},[],"Only once every check passes, delete the orphaned 3.8.0 volumes to reclaim storage. The delete is irreversible and the old KMS volume may hold the last copy of your CA key material, so take a `VolumeSnapshot` or a backup of both old PVCs first and keep it until you are confident the upgraded deployment is healthy. These are the fixed 3.8.0 names recorded in step 1; before deleting, confirm that neither is mounted by a running pod, for example with `kubectl describe pvc -n $NAMESPACE golang-engine-storage-kms-0 local-crl-file-storage-va-0`, where `Used By` must be `<none>`:",{"_3328":2808,"_29138":2565,"_20209":56133,"_5":13819,"_26493":55532,"_2816":56134},[],"The 3.8.0 per-service databases are no longer used either. Drop them only after the same checks pass and your PostgreSQL backup is verified.",{"_3328":2809,"_29138":2565,"_20209":56136,"_5":13819,"_26493":55532,"_2816":56137},[],"<Card title=\"Install with Helm\" description=\"Prepare dependencies, configure values and install a controlled deployment.\" href=\"/docs/deployment/self-hosted/helm\" />",{"_3328":2810,"_29138":2565,"_20209":56139,"_5":13819,"_26493":55532,"_2816":56140},[],"<Card title=\"Access control\" description=\"Principals, policies and the first administrator.\" href=\"/docs/platform/administration/access-control\" />",{"_3328":2811,"_29138":2565,"_20209":56142,"_5":13819,"_26493":55532,"_2816":56143},[],"<Card title=\"Configure a DMS\" description=\"Enrollment, re-enrollment and webhook settings.\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />","sorting",{"_56146":56147,"_56148":56149,"_56150":56151,"_56152":56153,"_17488":2838,"_67355":2838},"language","english","sortableProperties",[2816,29138,5,26493],"sortablePropertiesWithTypes",{"_2816":24136,"_29138":24136,"_5":24136,"_26493":24136},"sorts",{"_2816":56154,"_29138":58955,"_5":61755,"_26493":64555},{"_4473":56155,"_56156":56157,"_5":24136},{"_13901":4935,"_14277":7320,"_14296":6200,"_12464":15852,"_14283":4413,"_19180":3102,"_13922":15423,"_13929":11176,"_28090":21442,"_28498":9097,"_28519":6675,"_28124":4064,"_33348":5357,"_28226":13793,"_28563":4811,"_33355":14375,"_33358":24697,"_33361":23744,"_33364":6185,"_28970":23762,"_33369":22384,"_33371":19451,"_29000":3098,"_14292":18501,"_33375":2890,"_33378":4539,"_33380":4604,"_28547":3209,"_28965":18786,"_29013":4234,"_33385":15962,"_33387":17490,"_33389":19457,"_28243":2915,"_33392":3350,"_33394":9723,"_33396":4552,"_33398":3518,"_33400":6679,"_28160":4269,"_33403":3805,"_33405":8189,"_28154":4451,"_28584":6889,"_33409":2998,"_33411":10022