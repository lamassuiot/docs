":35165,"_1890":35196},[],"Permissions to subscribe to AWS Marketplace products and launch EC2 instances.",{"_2299":26,"_22571":15,"_15405":35198,"_5":15294,"_21315":35165,"_1890":35199},[],"A VPC and a subnet from which administrators and devices can reach the instance.",{"_2299":27,"_22571":15,"_15405":35201,"_5":15294,"_21315":35165,"_1890":35202},[],"A security group allowing the necessary endpoints.",{"_2299":28,"_22571":15,"_15405":35204,"_5":15294,"_21315":35169,"_1890":35205},[],"**Compute:** a `t3.large` instance at minimum. Use `t3.xlarge` or higher when the load requires it.",{"_2299":29,"_22571":15,"_15405":35207,"_5":15294,"_21315":35169,"_1890":35208},[],"**Storage:** an EBS `gp3` volume of at least 50 GB, sized to your inventory and retention needs.",{"_2299":30,"_22571":15,"_15405":35210,"_5":15294,"_21315":35169,"_1890":35211},[],"**Network:** HTTPS access from the necessary consumers, restricted to trusted networks.",{"_2299":31,"_22571":15,"_15405":35213,"_5":15294,"_21315":35173,"_1890":35214},[],"Go to Lamassu IoT on AWS Marketplace and review the terms before subscribing.",{"_2299":32,"_22571":15,"_15405":35216,"_5":15294,"_21315":35177,"_1890":35217},[],"Select `t3.large` or higher, assign at least 50 GB of `gp3` storage and choose the target VPC and subnet.",{"_2299":33,"_22571":15,"_15405":35219,"_5":15294,"_21315":35181,"_1890":35220},[],"Configure the security group for ports `443`, `8443` and `9443`. Restrict the origins to the administrative and device networks that really need to connect.",{"_2299":34,"_22571":15,"_15405":35222,"_5":15294,"_21315":35185,"_1890":35223},[],"Start the instance and open the console at `https://<public-ip>`. Check you can authenticate before continuing.",{"_2299":35,"_22571":15,"_15405":35225,"_5":15294,"_21315":35189,"_1890":35226},[],"Continue with Create your first CA to validate the instance's cryptographic configuration.",{"_2299":36,"_22571":36,"_5":10616,"_1890":35228,"_22830":35229,"_15405":35230,"_21315":36},"Deploy Lamassu",[35156,35157],[],{"_2299":37,"_22571":36,"_15405":35232,"_5":15294,"_21315":36,"_1890":35233},[],"Choose the operating model that fits your infrastructure and control requirements.",{"_2299":38,"_22571":36,"_5":22827,"_15405":35235,"_21315":35236,"_1890":35237},[],"/docs/deployment/overview#choose-a-model","Choose a model",{"_2299":39,"_22571":36,"_5":22827,"_15405":35239,"_21315":35240,"_1890":35241},[],"/docs/deployment/overview#just-want-to-evaluate-the-platform","Just want to evaluate the platform?",{"_2299":40,"_22571":36,"_5":22827,"_15405":35243,"_21315":35244,"_1890":35245},[],"/docs/deployment/overview#after-deployment","After deployment",{"_2299":41,"_22571":36,"_15405":35247,"_5":15294,"_21315":36,"_1890":35248},[],"You can run Lamassu on your own Kubernetes cluster, deploy a prebuilt image from AWS Marketplace or consume the platform as a managed service.",{"_2299":42,"_22571":36,"_15405":35250,"_5":15294,"_21315":35236,"_1890":35251},[],"Model",{"_2299":43,"_22571":36,"_15405":35253,"_5":15294,"_21315":35236,"_1890":35254},[],"Recommended for",{"_2299":44,"_22571":36,"_15405":35256,"_5":15294,"_21315":35236,"_1890":35257},[],"Who operates the infrastructure",{"_2299":45,"_22571":36,"_15405":35259,"_5":15294,"_21315":35236,"_1890":35260},[],"Starting point",{"_2299":46,"_22571":36,"_15405":35262,"_5":15294,"_21315":35236,"_1890":35263},[],"Kubernetes self-managed",{"_2299":47,"_22571":36,"_15405":35265,"_5":15294,"_21315":35236,"_1890":35266},[],"Production, regulated environments and custom deployments",{"_2299":48,"_22571":36,"_15405":35268,"_5":15294,"_21315":35236,"_1890":35269},[],"Your team",{"_2299":49,"_22571":36,"_15405":35271,"_5":15294,"_21315":35236,"_1890":35272},[],"Helm or Fastlane",{"_2299":50,"_22571":36,"_15405":35274,"_5":15294,"_21315":35236,"_1890":35275},[],"AWS Marketplace",{"_2299":51,"_22571":36,"_15405":35277,"_5":15294,"_21315":35236,"_1890":35278},[],"Evaluation or a dedicated deployment inside an AWS account",{"_2299":52,"_22571":36,"_15405":35280,"_5":15294,"_21315":35236,"_1890":35269},[],{"_2299":53,"_22571":36,"_15405":35282,"_5":15294,"_21315":35236,"_1890":35283},[],"Preconfigured image on EC2",{"_2299":54,"_22571":36,"_15405":35285,"_5":15294,"_21315":35236,"_1890":35286},[],"SaaS",{"_2299":55,"_22571":36,"_15405":35288,"_5":15294,"_21315":35236,"_1890":35289},[],"Teams that want to use the platform without operating it",{"_2299":56,"_22571":36,"_15405":35291,"_5":15294,"_21315":35236,"_1890":35292},[],"Lamassu",{"_2299":57,"_22571":36,"_15405":35294,"_5":15294,"_21315":35236,"_1890":35295},[],"Managed subscription",{"_2299":58,"_22571":36,"_15405":35297,"_5":15294,"_21315":35236,"_1890":35298},[],"<Card title=\"Kubernetes self-managed\" description=\"Control network, storage, keys, dependencies and the upgrade cycle.\" href=\"/docs/deployment/self-hosted/overview\" />",{"_2299":59,"_22571":36,"_15405":35300,"_5":15294,"_21315":35236,"_1890":35301},[],"<Card title=\"AWS Marketplace\" description=\"Launch a preconfigured Lamassu instance on AWS EC2.\" href=\"/docs/deployment/aws-marketplace\" />",{"_2299":60,"_22571":36,"_15405":35303,"_5":15294,"_21315":35236,"_1890":35304},[],"<Card title=\"Lamassu SaaS\" description=\"Use an operated and updated instance as a managed service.\" href=\"/docs/deployment/saas\" />",{"_2299":61,"_22571":36,"_15405":35306,"_5":15294,"_21315":35240,"_1890":35307},[],"Use Fastlane to bring up PostgreSQL, Keycloak, RabbitMQ and Lamassu on a Kubernetes cluster through a single flow. It is intended for labs, demos and bootstrap; for production, configure dependencies and Helm values explicitly.",{"_2299":62,"_22571":36,"_15405":35309,"_5":15294,"_21315":35244,"_1890":35310},[],"Once the console is available, continue with Create your first CA. That quickstart verifies the cryptographic engine and issuance work correctly.",{"_2299":63,"_22571":63,"_5":10616,"_1890":35312,"_22830":35313,"_15405":35314,"_21315":63},"Use Lamassu as SaaS",[35156,35157,35158],[],{"_2299":64,"_22571":63,"_15405":35316,"_5":15294,"_21315":63,"_1890":35317},[],"Consume Lamassu as a managed service without operating your own infrastructure.",{"_2299":65,"_22571":63,"_5":22827,"_15405":35319,"_21315":35320,"_1890":35321},[],"/docs/deployment/saas#what-the-service-manages","What the service manages",{"_2299":66,"_22571":63,"_5":22827,"_15405":35323,"_21315":35324,"_1890":35325},[],"/docs/deployment/saas#plans","Plans",{"_2299":67,"_22571":63,"_5":22827,"_15405":35327,"_21315":35328,"_1890":35329},[],"/docs/deployment/saas#request-access","Request access",{"_2299":68,"_22571":63,"_15405":35331,"_5":15294,"_21315":63,"_1890":35332},[],"Lamassu SaaS offers the platform's capabilities in a managed environment. It is the right option when your team wants to focus on PKI and device identities, not on maintaining the infrastructure that supports them.",{"_2299":69,"_22571":63,"_15405":35334,"_5":15294,"_21315":35320,"_1890":35335},[],"Platform availability and maintenance.",{"_2299":70,"_22571":63,"_15405":35337,"_5":15294,"_21315":35320,"_1890":35338},[],"Automatic backups.",{"_2299":71,"_22571":63,"_15405":35340,"_5":15294,"_21315":35320,"_1890":35341},[],"Version upgrades.",{"_2299":72,"_22571":63,"_15405":35343,"_5":15294,"_21315":35320,"_1890":35344},[],"Technical support and SLA according to your plan.",{"_2299":73,"_22571":63,"_15405":35346,"_5":15294,"_21315":35324,"_1890":35347},[],"Plan",{"_2299":74,"_22571":63,"_15405":35349,"_5":15294,"_21315":35324,"_1890":35350},[],"Devices",{"_2299":75,"_22571":63,"_15405":35352,"_5":15294,"_21315":35324,"_1890":35353},[],"Support",{"_2299":76,"_22571":63,"_15405":35355,"_5":15294,"_21315":35324,"_1890":35356},[],"SLA",{"_2299":77,"_22571":63,"_15405":35358,"_5":15294,"_21315":35324,"_1890":35359},[],"Starter",{"_2299":78,"_22571":63,"_15405":35361,"_5":15294,"_21315":35324,"_1890":35362},[],"Up to 1,000",{"_2299":79,"_22571":63,"_15405":35364,"_5":15294,"_21315":35324,"_1890":35365},[],"Email",{"_2299":80,"_22571":63,"_15405":35367,"_5":15294,"_21315":35324,"_1890":35368},[],"99.5 %",{"_2299":81,"_22571":63,"_15405":35370,"_5":15294,"_21315":35324,"_1890":35371},[],"Professional",{"_2299":82,"_22571":63,"_15405":35373,"_5":15294,"_21315":35324,"_1890":35374},[],"Up to 10,000",{"_2299":83,"_22571":63,"_15405":35376,"_5":15294,"_21315":35324,"_1890":35377},[],"Email and chat",{"_2299":84,"_22571":63,"_15405":35379,"_5":15294,"_21315":35324,"_1890":35380},[],"99.9 %",{"_2299":85,"_22571":63,"_15405":35382,"_5":15294,"_21315":35324,"_1890":35383},[],"Enterprise",{"_2299":86,"_22571":63,"_15405":35385,"_5":15294,"_21315":35324,"_1890":35386},[],"Unlimited",{"_2299":87,"_22571":63,"_15405":35388,"_5":15294,"_21315":35324,"_1890":35389},[],"Dedicated",{"_2299":88,"_22571":63,"_15405":35391,"_5":15294,"_21315":35324,"_1890":35392},[],"99.99 %",{"_2299":89,"_22571":63,"_15405":35394,"_5":15294,"_21315":35328,"_1890":35395},[],"Contact the Lamassu team through lamassu.io to request a demo or choose a plan.",{"_2299":90,"_22571":63,"_15405":35397,"_5":15294,"_21315":35328,"_1890":35398},[],"When you receive your instance's credentials, continue with Get started.",{"_2299":91,"_22571":91,"_5":10616,"_1890":35400,"_22830":35401,"_15405":35402,"_21315":91},"Fastlane",[35156,35157,35263],[],{"_2299":92,"_22571":91,"_15405":35404,"_5":15294,"_21315":91,"_1890":35405},[],"Bootstrap a complete Lamassu evaluation or lab environment on an existing Kubernetes cluster.",{"_2299":93,"_22571":91,"_5":22827,"_15405":35407,"_21315":35408,"_1890":35409},[],"/docs/deployment/self-hosted/fastlane#deploy-with-fastlane","Deploy with Fastlane",{"_2299":94,"_22571":91,"_5":22827,"_15405":35411,"_21315":35412,"_1890":35413},[],"/docs/deployment/self-hosted/fastlane#what-fastlane-adds","What Fastlane adds",{"_2299":95,"_22571":91,"_5":22827,"_15405":35415,"_21315":35416,"_1890":35166},[],"/docs/deployment/self-hosted/fastlane#before-you-begin",{"_2299":96,"_22571":91,"_5":22827,"_15405":35418,"_21315":35419,"_1890":35420},[],"/docs/deployment/self-hosted/fastlane#quick-start","Quick start",{"_2299":97,"_22571":91,"_5":22827,"_15405":35422,"_21315":35423,"_1890":35424},[],"/docs/deployment/self-hosted/fastlane#gateway-address-selection","Gateway address selection",{"_2299":98,"_22571":91,"_5":22827,"_15405":35426,"_21315":35427,"_1890":35428},[],"/docs/deployment/self-hosted/fastlane#command-line-options","Command-line options",{"_2299":99,"_22571":91,"_5":22827,"_15405":35430,"_21315":35431,"_1890":35432},[],"/docs/deployment/self-hosted/fastlane#what-the-script-configures","What the script configures",{"_2299":100,"_22571":91,"_5":22827,"_15405":35434,"_21315":35435,"_1890":35436},[],"/docs/deployment/self-hosted/fastlane#tls-behavior","TLS behavior",{"_2299":101,"_22571":91,"_5":22827,"_15405":35438,"_21315":35439,"_1890":35440},[],"/docs/deployment/self-hosted/fastlane#credentials-and-generated-files","Credentials and generated files",{"_2299":102,"_22571":91,"_5":22827,"_15405":35442,"_21315":35443,"_1890":35444},[],"/docs/deployment/self-hosted/fastlane#verify-the-installation","Verify the installation",{"_2299":103,"_22571":91,"_15405":35446,"_5":15294,"_21315":35408,"_1890":35447},[],"Fastlane is the automated path for evaluations, demos, CI and small lab clusters. It installs PostgreSQL, Keycloak, RabbitMQ, Envoy Gateway and Lamassu, then configures them to work together.",{"_2299":104,"_22571":91,"_15405":35449,"_5":15294,"_21315":35408,"_1890":35450},[],"For production, use Helm so database, identity, credentials, certificates, storage and upgrades remain explicit.",{"_2299":105,"_22571":91,"_15405":35452,"_5":15294,"_21315":35412,"_1890":35453},[],"Fastlane closes some of the gaps intentionally left by the application chart:",{"_2299":106,"_22571":91,"_15405":35455,"_5":15294,"_21315":35412,"_1890":35456},[],"Fastlane installs or configures",{"_2299":107,"_22571":91,"_15405":35458,"_5":15294,"_21315":35412,"_1890":35459},[],"You still provide",{"_2299":108,"_22571":91,"_15405":35461,"_5":15294,"_21315":35412,"_1890":35462},[],"PostgreSQL, RabbitMQ and Keycloak instances for evaluation",{"_2299":109,"_22571":91,"_15405":35464,"_5":15294,"_21315":35412,"_1890":35465},[],"The Kubernetes cluster, nodes and persistent storage",{"_2299":110,"_22571":91,"_15405":35467,"_5":15294,"_21315":35412,"_1890":35468},[],"Envoy Gateway 1.8 and the `eg` `GatewayClass`",{"_2299":111,"_22571":91,"_15405":35470,"_5":15294,"_21315":35412,"_1890":35471},[],"cert-manager, external network reachability, DNS and firewall/NAT rules",{"_2299":112,"_22571":91,"_15405":35473,"_5":15294,"_21315":35412,"_1890":35474},[],"A self-signed Lamassu certificate flow, generated dependency credentials and an initial user",{"_2299":113,"_22571":91,"_15405":35476,"_5":15294,"_21315":35412,"_1890":35477},[],"Client trust for the self-signed CA, or a trusted certificate passed to the script",{"_2299":114,"_22571":91,"_15405":35479,"_5":15294,"_21315":35412,"_1890":35480},[],"Optional observability and lab HSM components",{"_2299":115,"_22571":91,"_15405":35482,"_5":15294,"_21315":35412,"_1890":35483},[],"Production monitoring retention, backups, HA and a production HSM/key service",{"_2299":116,"_22571":91,"_15405":35485,"_5":15294,"_21315":35412,"_1890":35486},[],"Fastlane does not turn the resulting stack into a production service: it does not create the cluster, public DNS, firewall rules, backups, high availability or a trusted public certificate.",{"_2299":117,"_22571":91,"_15405":35488,"_5":15294,"_21315":35416,"_1890":35489},[],"You need:",{"_2299":118,"_22571":91,"_15405":35491,"_5":15294,"_21315":35416,"_1890":35492},[],"an existing Kubernetes cluster",{"_2299":119,"_22571":91,"_15405":35494,"_5":15294,"_21315":35416,"_1890":35495},[],"`kubectl` and Helm, or the MicroK8s CLI",{"_2299":120,"_22571":91,"_15405":35497,"_5":15294,"_21315":35416,"_1890":35498},[],"`yq`",{"_2299":121,"_22571":91,"_15405":35500,"_5":15294,"_21315":35416,"_1890":17518},[],{"_2299":122,"_22571":91,"_15405":35502,"_5":15294,"_21315":35416,"_1890":35503},[],"`jq` only when using `--sample-data`",{"_2299":123,"_22571":91,"_15405":35505,"_5":15294,"_21315":35416,"_1890":35506},[],"free external ports 80 and 443 on a single-node K3s host",{"_2299":124,"_22571":91,"_15405":35508,"_5":15294,"_21315":35416,"_1890":35509},[],"Fastlane detects MicroK8s, K3s, kind or a standard kubeconfig. Use `--context` when the intended cluster is not the current context.",{"_2299":125,"_22571":91,"_15405":35511,"_5":15294,"_21315":35416,"_1890":35512},[],"Fastlane installs several components and creates credentials. Check `kubectl config current-context` or pass `--context` before running it.",{"_2299":126,"_22571":91,"_15405":35514,"_5":15294,"_21315":35419,"_1890":35515},[],"Run the script from a clone of the Helm repository:",{"_2299":127,"_22571":91,"_15405":35517,"_5":15294,"_21315":35419,"_1890":35518},[],"Create a DNS record for the chosen domain before testing from another machine. For a small VM, point it at the VM or load-balancer address that actually receives ports 80 and 443.",{"_2299":128,"_22571":91,"_15405":35520,"_5":15294,"_21315":35423,"_1890":35521},[],"By default, Fastlane runs `hostname -I` and writes the returned addresses to `gateway.addresses` and to the self-signed certificate's IP SANs.",{"_2299":129,"_22571":91,"_15405":35523,"_5":15294,"_21315":35423,"_1890":35524},[],"On a single-homed lab VM this can select the expected node address. On hosts with Docker, VPN, WireGuard or several interfaces it can also select addresses clients cannot reach. Override the result explicitly:",{"_2299":130,"_22571":91,"_15405":35526,"_5":15294,"_21315":35423,"_1890":35527},[],"The value must be an address handled on the Kubernetes side of the traffic path. If a public EC2 address forwards through WireGuard to the cluster, pass the reachable cluster/VM address, not the EC2 public address.",{"_2299":131,"_22571":91,"_15405":35529,"_5":15294,"_21315":35423,"_1890":35530},[],"See Expose the Gateway for K3s port conflicts, VIPs, external NAT and multi-Gateway designs.",{"_2299":132,"_22571":91,"_15405":35532,"_5":15294,"_21315":35427,"_1890":35533},[],"Option",{"_2299":133,"_22571":91,"_15405":35535,"_5":15294,"_21315":35427,"_1890":35536},[],"Default",{"_2299":134,"_22571":91,"_15405":35538,"_5":15294,"_21315":35427,"_1890":35539},[],"Purpose",{"_2299":135,"_22571":91,"_15405":35541,"_5":15294,"_21315":35427,"_1890":35542},[],"`-h`, `--help`",{"_2299":136,"_22571":91,"_15405":35544,"_5":15294,"_21315":35427,"_1890":35545},[],"—",{"_2299":137,"_22571":91,"_15405":35547,"_5":15294,"_21315":35427,"_1890":35548},[],"Show help",{"_2299":138,"_22571":91,"_15405":35550,"_5":15294,"_21315":35427,"_1890":35551},[],"`-c`, `--context`",{"_2299":139,"_22571":91,"_15405":35553,"_5":15294,"_21315":35427,"_1890":35554},[],"current context",{"_2299":140,"_22571":91,"_15405":35556,"_5":15294,"_21315":35427,"_1890":35557},[],"Select the kubeconfig context for kubectl and Helm",{"_2299":141,"_22571":91,"_15405":35559,"_5":15294,"_21315":35427,"_1890":35560},[],"`-n`, `--non-interactive`",{"_2299":142,"_22571":91,"_15405":35562,"_5":15294,"_21315":35427,"_1890":4389},[],{"_2299":143,"_22571":91,"_15405":35564,"_5":15294,"_21315":35427,"_1890":35565},[],"Skip prompts and generate dependency credentials",{"_2299":144,"_22571":91,"_15405":35567,"_5":15294,"_21315":35427,"_1890":35568},[],"`-ns`, `--namespace`",{"_2299":145,"_22571":91,"_15405":35570,"_5":15294,"_21315":35427,"_1890":35571},[],"`lamassu-dev`",{"_2299":146,"_22571":91,"_15405":35573,"_5":15294,"_21315":35427,"_1890":35574},[],"Namespace for the installation",{"_2299":147,"_22571":91,"_15405":35576,"_5":15294,"_21315":35427,"_1890":35577},[],"`-d`, `--domain`",{"_2299":148,"_22571":91,"_15405":35579,"_5":15294,"_21315":35427,"_1890":35580},[],"`dev.lamassu.io`",{"_2299":149,"_22571":91,"_15405":35582,"_5":15294,"_21315":35427,"_1890":35583},[],"Domain used by the UI, OIDC and certificate",{"_2299":150,"_22571":91,"_15405":35585,"_5":15294,"_21315":35427,"_1890":35586},[],"`-v`, `--version`",{"_2299":151,"_22571":91,"_15405":35588,"_5":15294,"_21315":35427,"_1890":10818},[],{"_2299":152,"_22571":91,"_15405":35590,"_5":15294,"_21315":35427,"_1890":35591},[],"Lamassu chart version",{"_2299":153,"_22571":91,"_15405":35593,"_5":15294,"_21315":35427,"_1890":35594},[],"`--https-port`",{"_2299":154,"_22571":91,"_15405":35596,"_5":15294,"_21315":35427,"_1890":35597},[],"`443`",{"_2299":155,"_22571":91,"_15405":35599,"_5":15294,"_21315":35427,"_1890":35600},[],"Gateway HTTPS listener port",{"_2299":156,"_22571":91,"_15405":35602,"_5":15294,"_21315":35427,"_1890":35603},[],"`--http-port`",{"_2299":157,"_22571":91,"_15405":35605,"_5":15294,"_21315":35427,"_1890":35606},[],"`80`",{"_2299":158,"_22571":91,"_15405":35608,"_5":15294,"_21315":35427,"_1890":35609},[],"Gateway HTTP listener port",{"_2299":159,"_22571":91,"_15405":35611,"_5":15294,"_21315":35427,"_1890":35612},[],"`--tls-crt`",{"_2299":160,"_22571":91,"_15405":35614,"_5":15294,"_21315":35427,"_1890":35545},[],{"_2299":161,"_22571":91,"_15405":35616,"_5":15294,"_21315":35427,"_1890":35617},[],"PEM certificate for downstream TLS",{"_2299":162,"_22571":91,"_15405":35619,"_5":15294,"_21315":35427,"_1890":35620},[],"`--tls-key`",{"_2299":163,"_22571":91,"_15405":35622,"_5":15294,"_21315":35427,"_1890":35545},[],{"_2299":164,"_22571":91,"_15405":35624,"_5":15294,"_21315":35427,"_1890":35625},[],"PEM private key for downstream TLS",{"_2299":165,"_22571":91,"_15405":35627,"_5":15294,"_21315":35427,"_1890":35628},[],"`-l`, `--local-chart-path`",{"_2299":166,"_22571":91,"_15405":35630,"_5":15294,"_21315":35427,"_1890":35631},[],"repository chart",{"_2299":167,"_22571":91,"_15405":35633,"_5":15294,"_21315":35427,"_1890":35634},[],"Use an unpacked local Lamassu chart",{"_2299":168,"_22571":91,"_15405":35636,"_5":15294,"_21315":35427,"_1890":35637},[],"`-ip`, `--gateway-ip`",{"_2299":169,"_22571":91,"_15405":35639,"_5":15294,"_21315":35427,"_1890":6184},[],{"_2299":170,"_22571":91,"_15405":35641,"_5":15294,"_21315":35427,"_1890":35642},[],"Override the address written to `gateway.addresses`",{"_2299":171,"_22571":91,"_15405":35644,"_5":15294,"_21315":35427,"_1890":35645},[],"`--otel`",{"_2299":172,"_22571":91,"_15405":35647,"_5":15294,"_21315":35427,"_1890":4389},[],{"_2299":173,"_22571":91,"_15405":35649,"_5":15294,"_21315":35427,"_1890":35650},[],"Install Victoria Logs, VictoriaTraces, Jaeger and an OpenTelemetry Collector",{"_2299":174,"_22571":91,"_15405":35652,"_5":15294,"_21315":35427,"_1890":35653},[],"`--sample-data`",{"_2299":175,"_22571":91,"_15405":35655,"_5":15294,"_21315":35427,"_1890":4389},[],{"_2299":176,"_22571":91,"_15405":35657,"_5":15294,"_21315":35427,"_1890":35658},[],"Create sample CAs, profiles, certificates, DMS data and devices",{"_2299":177,"_22571":91,"_15405":35660,"_5":15294,"_21315":35427,"_1890":35661},[],"`--with-hsm`",{"_2299":178,"_22571":91,"_15405":35663,"_5":15294,"_21315":35427,"_1890":4389},[],{"_2299":179,"_22571":91,"_15405":35665,"_5":15294,"_21315":35427,"_1890":35666},[],"Install lab HSM components and configure KMS for PKCS#11",{"_2299":180,"_22571":91,"_15405":35668,"_5":15294,"_21315":35427,"_1890":35669},[],"`--softhsm-chart-path`",{"_2299":181,"_22571":91,"_15405":35671,"_5":15294,"_21315":35427,"_1890":35672},[],"`./charts/softhsm`",{"_2299":182,"_22571":91,"_15405":35674,"_5":15294,"_21315":35427,"_1890":35675},[],"Use a different local SoftHSM chart",{"_2299":183,"_22571":91,"_15405":35677,"_5":15294,"_21315":35427,"_1890":35678},[],"Fastlane does not provide an offline mode. Use the manual Helm workflow and a prepared registry/chart mirror for disconnected environments.",{"_2299":184,"_22571":91,"_15405":35680,"_5":15294,"_21315":35431,"_1890":35681},[],"Fastlane:",{"_2299":185,"_22571":91,"_15405":35683,"_5":15294,"_21315":35431,"_1890":35684},[],"validates local tools and the selected cluster",{"_2299":186,"_22571":91,"_15405":35686,"_5":15294,"_21315":35431,"_1890":35687},[],"installs or upgrades Envoy Gateway 1.8 and creates the `eg` `GatewayClass`",{"_2299":187,"_22571":91,"_15405":35689,"_5":15294,"_21315":35431,"_1890":35690},[],"creates the namespace",{"_2299":188,"_22571":91,"_15405":35692,"_5":15294,"_21315":35431,"_1890":35693},[],"installs PostgreSQL and creates the required databases",{"_2299":189,"_22571":91,"_15405":35695,"_5":15294,"_21315":35431,"_1890":35696},[],"installs Keycloak and creates the `lamassu` realm, frontend client, admin role and initial user",{"_2299":190,"_22571":91,"_15405":35698,"_5":15294,"_21315":35431,"_1890":35699},[],"installs RabbitMQ",{"_2299":191,"_22571":91,"_15405":35701,"_5":15294,"_21315":35431,"_1890":35702},[],"optionally installs observability and lab HSM components",{"_2299":192,"_22571":91,"_15405":35704,"_5":15294,"_21315":35431,"_1890":35705},[],"generates `lamassu.yaml` and installs the Lamassu chart",{"_2299":193,"_22571":91,"_15405":35707,"_5":15294,"_21315":35431,"_1890":35708},[],"optionally loads sample data",{"_2299":194,"_22571":91,"_15405":35710,"_5":15294,"_21315":35431,"_1890":35711},[],"The generated configuration exposes Keycloak at `/auth` through the same Gateway and bootstraps the initial `lamassu` user as a Lamassu super administrator.",{"_2299":195,"_22571":91,"_15405":35713,"_5":15294,"_21315":35435,"_1890":35714},[],"With both `--tls-crt` and `--tls-key`, Fastlane creates the `downstream-provided-crt` Secret and configures `tls.type: external`.",{"_2299":196,"_22571":91,"_15405":35716,"_5":15294,"_21315":35435,"_1890":35717},[],"Without them, it configures cert-manager with a self-signed issuer. This is suitable for a lab but will not be trusted by clients until you distribute the CA. Use Helm when you need a corporate Issuer, public ACME issuer or an existing Secret managed by another system.",{"_2299":197,"_22571":91,"_15405":35719,"_5":15294,"_21315":35439,"_1890":35720},[],"Non-interactive mode generates random PostgreSQL, RabbitMQ and Keycloak administrator passwords. The initial Lamassu login is `lamassu` / `lamassu` and requires a password change on first use.",{"_2299":198,"_22571":91,"_15405":35722,"_5":15294,"_21315":35439,"_1890":35723},[],"Fastlane writes `lamassu.yaml` in the current directory and injects credentials into it.",{"_2299":199,"_22571":91,"_15405":35725,"_5":15294,"_21315":35439,"_1890":35726},[],"Protect the generated values file, record the generated credentials in an appropriate secret store and do not reuse the evaluation identity setup in production.",{"_2299":200,"_22571":91,"_15405":35728,"_5":15294,"_21315":35443,"_1890":35729},[],"Then open `https://pki.example.com` and sign in with the initial user. If the Gateway is programmed but the URL is unreachable, follow the checks in Expose the Gateway.",{"_2299":201,"_22571":201,"_5":10616,"_1890":35731,"_22830":35732,"_15405":35733,"_21315":201},"Install with Helm",[35156,35157,35263],[],{"_2299":202,"_22571":201,"_15405":35735,"_5":15294,"_21315":201,"_1890":35736},[],"Prepare dependencies, configure the Lamassu chart and verify a controlled Kubernetes deployment.",{"_2299":203,"_22571":201,"_5":22827,"_15405":35738,"_21315":35739,"_1890":35740},[],"/docs/deployment/self-hosted/helm#install-lamassu-with-helm","Install Lamassu with Helm",{"_2299":204,"_22571":201,"_5":22827,"_15405":35742,"_21315":35743,"_1890":35166},[],"/docs/deployment/self-hosted/helm#before-you-begin",{"_2299":205,"_22571":201,"_5":22827,"_15405":35745,"_21315":35746,"_1890":35747},[],"/docs/deployment/self-hosted/helm#1-install-the-gateway-prerequisites","1\\. Install the Gateway prerequisites",{"_2299":206,"_22571":201,"_5":22827,"_15405":35749,"_21315":35750,"_1890":35751},[],"/docs/deployment/self-hosted/helm#2-create-a-values-file","2\\. Create a values file",{"_2299":207,"_22571":201,"_5":22827,"_15405":35753,"_21315":35754,"_1890":35755},[],"/docs/deployment/self-hosted/helm#tls-with-an-existing-secret","TLS with an existing Secret",{"_2299":208,"_22571":201,"_5":22827,"_15405":35757,"_21315":35758,"_1890":35759},[],"/docs/deployment/self-hosted/helm#provision-the-first-administrator","Provision the first administrator",{"_2299":209,"_22571":201,"_5":22827,"_15405":35761,"_21315":35762,"_1890":35763},[],"/docs/deployment/self-hosted/helm#3-install-lamassu","3\\. Install Lamassu",{"_2299":210,"_22571":201,"_5":22827,"_15405":35765,"_21315":35766,"_1890":35767},[],"/docs/deployment/self-hosted/helm#4-verify-the-deployment","4\\. Verify the deployment",{"_2299":211,"_22571":201,"_5":22827,"_15405":35769,"_21315":35770,"_1890":35771},[],"/docs/deployment/self-hosted/helm#production-decisions","Production decisions",{"_2299":212,"_22571":201,"_15405":35773,"_5":15294,"_21315":35739,"_1890":35774},[],"Use the Helm workflow when you need explicit control over identity, databases, messaging, certificates, storage and upgrades. For an evaluation environment where the script can make those choices for you, use Fastlane.",{"_2299":213,"_22571":201,"_15405":35776,"_5":15294,"_21315":35743,"_1890":35777},[],"Prepare the platform services that are deliberately outside the Lamassu chart:",{"_2299":214,"_22571":201,"_15405":35779,"_5":15294,"_21315":35743,"_1890":35780},[],"a Kubernetes 1.24+ cluster and Helm 3.2+",{"_2299":215,"_22571":201,"_15405":35782,"_5":15294,"_21315":35743,"_1890":35783},[],"a reachable PostgreSQL server and a role allowed to create databases and schemas",{"_2299":216,"_22571":201,"_15405":35785,"_5":15294,"_21315":35743,"_1890":35786},[],"a reachable RabbitMQ broker and credentials",{"_2299":217,"_22571":201,"_15405":35788,"_5":15294,"_21315":35743,"_1890":35789},[],"an OIDC provider, normally Keycloak, with a realm/tenant and client for Lamassu",{"_2299":218,"_22571":201,"_15405":35791,"_5":15294,"_21315":35743,"_1890":35792},[],"Envoy Gateway 1.8+ and a `GatewayClass`",{"_2299":219,"_22571":201,"_15405":35794,"_5":15294,"_21315":35743,"_1890":35795},[],"cert-manager 1.14+; for trusted TLS, either a trusted issuer or a Kubernetes TLS Secret",{"_2299":220,"_22571":201,"_15405":35797,"_5":15294,"_21315":35743,"_1890":35798},[],"a StorageClass and an external traffic design",{"_2299":221,"_22571":201,"_15405":35800,"_5":15294,"_21315":35743,"_1890":35801},[],"The chart defaults to a `GatewayClass` named `eg`. Change `gateway.className` if your platform team uses another name.",{"_2299":222,"_22571":201,"_15405":35803,"_5":15294,"_21315":35743,"_1890":35804},[],"You provide the PostgreSQL server. The chart's pre-install job connects with the supplied credentials, creates the required `pki`, `authz` and `wfx` databases and service schemas, runs migrations, and applies `services.authz.bootstrap`.",{"_2299":223,"_22571":201,"_15405":35806,"_5":15294,"_21315":35743,"_1890":35807},[],"The chart has no Helm dependencies that install PostgreSQL, RabbitMQ, an OIDC provider, Envoy Gateway or cert-manager.",{"_2299":224,"_22571":201,"_15405":35809,"_5":15294,"_21315":35746,"_1890":35810},[],"Install or upgrade the Envoy Gateway CRDs before its controller. The commands below match the version used by the Lamassu Helm repository:",{"_2299":225,"_22571":201,"_15405":35812,"_5":15294,"_21315":35746,"_1890":35813},[],"Create the default `GatewayClass` if it does not already exist. Save this manifest as `gateway-class.yaml`:",{"_2299":226,"_22571":201,"_15405":35815,"_5":15294,"_21315":35746,"_1890":35816},[],"Install cert-manager separately before Lamassu. The current chart renders its self-signed issuer and CA certificate resources even when `tls.type: external` makes the Gateway use an existing TLS Secret. Selecting external TLS therefore does not remove the cert-manager prerequisite.",{"_2299":227,"_22571":201,"_15405":35818,"_5":15294,"_21315":35750,"_1890":35819},[],"Start with the chart defaults and override the environment-specific values. This example assumes PostgreSQL, RabbitMQ and Keycloak are reachable through Kubernetes DNS, and exposes Keycloak at `/auth` through the shared Lamassu Gateway:",{"_2299":228,"_22571":201,"_15405":35821,"_5":15294,"_21315":35750,"_1890":35822},[],"Do not add `gateway.addresses` by default. Leave address assignment to the load-balancer implementation unless your network design requires a specific Kubernetes-side VIP. The public IP of an upstream NAT gateway or reverse proxy does not belong in this value.",{"_2299":229,"_22571":201,"_15405":35824,"_5":15294,"_21315":35750,"_1890":35825},[],"If Keycloak is external and already has its own reachable URL, point the OIDC settings at it and omit the `/auth` entry from `gateway.extraRouting`.",{"_2299":230,"_22571":201,"_15405":35827,"_5":15294,"_21315":35754,"_1890":35828},[],"Create a Secret containing `tls.crt` and `tls.key`, then reference it:",{"_2299":231,"_22571":201,"_15405":35830,"_5":15294,"_21315":35758,"_1890":35831},[],"There is no implicit superuser. Create the role or group expected by `services.authz.bootstrap` in the OIDC provider and assign it to at least one administrator before exposing Lamassu.",{"_2299":232,"_22571":201,"_15405":35833,"_5":15294,"_21315":35758,"_1890":35834},[],"The pre-install and pre-upgrade job applies the bootstrap idempotently: existing principals are preserved and missing grants are added.",{"_2299":233,"_22571":201,"_15405":35836,"_5":15294,"_21315":35758,"_1890":35837},[],"Test both an authorized identity and a denied identity. If no token matches an active bootstrap principal, nobody can administer the PKI.",{"_2299":234,"_22571":201,"_15405":35839,"_5":15294,"_21315":35758,"_1890":35840},[],"See Access control for the principal and policy model.",{"_2299":235,"_22571":201,"_15405":35842,"_5":15294,"_21315":35762,"_1890":35843},[],"To install a local checkout instead:",{"_2299":236,"_22571":201,"_15405":35845,"_5":15294,"_21315":35766,"_1890":35846},[],"The Gateway should report `PROGRAMMED=True`. If it is programmed but has no usable address, continue with Expose the Gateway.",{"_2299":237,"_22571":201,"_15405":35848,"_5":15294,"_21315":35766,"_1890":35849},[],"The Helm test checks the CA, DMS Manager, Device Manager and VA health endpoints and verifies the UI response.",{"_2299":238,"_22571":201,"_15405":35851,"_5":15294,"_21315":35770,"_1890":35852},[],"Before going live, review:",{"_2299":239,"_22571":201,"_15405":35854,"_5":15294,"_21315":35770,"_1890":35855},[],"backup and recovery for PostgreSQL and persistent volumes",{"_2299":240,"_22571":201,"_15405":35857,"_5":15294,"_21315":35770,"_1890":35858},[],"a production KMS engine; the default filesystem engine is not an HA design",{"_2299":241,"_22571":201,"_15405":35860,"_5":15294,"_21315":35770,"_1890":35861},[],"shared VA storage before increasing VA replicas",{"_2299":242,"_22571":201,"_15405":35863,"_5":15294,"_21315":35770,"_1890":35864},[],"managed OIDC roles and removal of evaluation credentials",{"_2299":243,"_22571":201,"_15405":35866,"_5":15294,"_21315":35770,"_1890":35867},[],"a trusted TLS issuer or externally managed certificate",{"_2299":244,"_22571":201,"_15405":35869,"_5":15294,"_21315":35770,"_1890":35870},[],"resource requests, replicas, autoscaling, disruption budgets and placement",{"_2299":245,"_22571":201,"_15405":35872,"_5":15294,"_21315":35770,"_1890":35873},[],"SMTP, observability and alert delivery",{"_2299":246,"_22571":201,"_15405":35875,"_5":15294,"_21315":35770,"_1890":35876},[],"the migration notes in `charts/lamassu/CHANGELOG/` before every upgrade",{"_2299":247,"_22571":201,"_15405":35878,"_5":15294,"_21315":35770,"_1890":35879},[],"The complete values reference is maintained in `charts/lamassu/VALUES.md` in the Helm repository.",{"_2299":248,"_22571":248,"_5":10616,"_1890":35881,"_22830":35882,"_15405":35883,"_21315":248},"Expose the Gateway",[35156,35157,35263],[],{"_2299":249,"_22571":248,"_15405":35885,"_5":15294,"_21315":248,"_1890":35886},[],"Choose how clients reach Lamassu, when to set gateway.addresses and how to design multiple Gateways.",{"_2299":250,"_22571":248,"_5":22827,"_15405":35888,"_21315":35889,"_1890":35890},[],"/docs/deployment/self-hosted/networking#expose-the-lamassu-gateway","Expose the Lamassu Gateway",{"_2299":251,"_22571":248,"_5":22827,"_15405":35892,"_21315":35893,"_1890":35894},[],"/docs/deployment/self-hosted/networking#do-you-need-gatewayaddresses","Do you need `gateway.addresses`?",{"_2299":252,"_22571":248,"_5":22827,"_15405":35896,"_21315":35897,"_1890":35898},[],"/docs/deployment/self-hosted/networking#recommended-single-node-design","Recommended single-node design",{"_2299":253,"_22571":248,"_5":22827,"_15405":35900,"_21315":35901,"_1890":35902},[],"/docs/deployment/self-hosted/networking#k3s","K3s",{"_2299":254,"_22571":248,"_5":22827,"_15405":35904,"_21315":35905,"_1890":35906},[],"/docs/deployment/self-hosted/networking#bare-metal-with-metallb-or-kube-vip","Bare metal with MetalLB or kube-vip",{"_2299":255,"_22571":248,"_5":22827,"_15405":35908,"_21315":35909,"_1890":35910},[],"/docs/deployment/self-hosted/networking#external-reverse-proxy-nat-or-vpn","External reverse proxy, NAT or VPN",{"_2299":256,"_22571":248,"_5":22827,"_15405":35912,"_21315":35913,"_1890":35914},[],"/docs/deployment/self-hosted/networking#what-if-you-need-three-gateways","What if you need three Gateways?",{"_2299":257,"_22571":248,"_5":22827,"_15405":35916,"_21315":35917,"_1890":35918},[],"/docs/deployment/self-hosted/networking#decision-guide","Decision guide",{"_2299":258,"_22571":248,"_5":22827,"_15405":35920,"_21315":35921,"_1890":35922},[],"/docs/deployment/self-hosted/networking#verify-the-traffic-path","Verify the traffic path",{"_2299":259,"_22571":248,"_15405":35924,"_5":15294,"_21315":35889,"_1890":35925},[],"The Lamassu chart creates one shared Gateway with HTTP and HTTPS listeners. Envoy Gateway normally creates a dedicated proxy deployment and a `LoadBalancer` Service for it.",{"_2299":260,"_22571":248,"_15405":35927,"_5":15294,"_21315":35889,"_1890":35928},[],"External reachability is the result of the whole path. A `Gateway` resource alone does not configure your router, firewall, DNS, cloud load balancer or upstream NAT.",{"_2299":261,"_22571":248,"_15405":35930,"_5":15294,"_21315":35893,"_1890":35931},[],"Usually, no. If you omit it, the Gateway controller and the cluster load-balancer implementation can assign an address and report it in `Gateway.status.addresses` and the generated Service status.",{"_2299":262,"_22571":248,"_15405":35933,"_5":15294,"_21315":35893,"_1890":35934},[],"Set it only when:",{"_2299":263,"_22571":248,"_15405":35936,"_5":15294,"_21315":35893,"_1890":35937},[],"your cloud or bare-metal load balancer supports requesting a specific address",{"_2299":264,"_22571":248,"_15405":35939,"_5":15294,"_21315":35893,"_1890":35940},[],"that address is allocated to this Gateway",{"_2299":265,"_22571":248,"_15405":35942,"_5":15294,"_21315":35893,"_1890":35943},[],"the surrounding network already routes traffic for it to the cluster",{"_2299":266,"_22571":248,"_15405":35945,"_5":15294,"_21315":35893,"_1890":35946},[],"This requests `192.168.1.50`; it does not claim the IP on your LAN or make it reachable.",{"_2299":267,"_22571":248,"_15405":35948,"_5":15294,"_21315":35893,"_1890":35949},[],"Keep these two settings separate:",{"_2299":268,"_22571":248,"_15405":35951,"_5":15294,"_21315":35893,"_1890":35952},[],"`gateway.addresses` requests an address for the Gateway.",{"_2299":269,"_22571":248,"_15405":35954,"_5":15294,"_21315":35893,"_1890":35955},[],"`tls.certManagerOptions.certSpec.addresses` adds IP subject alternative names to the TLS certificate.",{"_2299":270,"_22571":248,"_15405":35957,"_5":15294,"_21315":35893,"_1890":35958},[],"If users connect by DNS name, put that name in `tls.certManagerOptions.certSpec.hostnames`. Do not copy an upstream proxy's public IP into `gateway.addresses`.",{"_2299":271,"_22571":248,"_15405":35960,"_5":15294,"_21315":35897,"_1890":35961},[],"For a small VM running K3s or MicroK8s, use one external Lamassu Gateway and route every Lamassu endpoint through it:",{"_2299":272,"_22571":248,"_15405":35963,"_5":15294,"_21315":35897,"_1890":35964},[],"This design uses one IP, one TLS entry point and one pair of ports. The chart already creates the required routes.",{"_2299":273,"_22571":248,"_15405":35966,"_5":15294,"_21315":35901,"_1890":35967},[],"K3s ServiceLB implements each `LoadBalancer` Service with pods that reserve the Service ports on the node. On a single node, only one Service can therefore own port 80 and one can own port 443. The default K3s Traefik Service may already hold both ports.",{"_2299":274,"_22571":248,"_15405":35969,"_5":15294,"_21315":35901,"_1890":35970},[],"For the recommended design:",{"_2299":275,"_22571":248,"_15405":35972,"_5":15294,"_21315":35901,"_1890":35973},[],"Use only one externally exposed Lamassu Gateway.",{"_2299":276,"_22571":248,"_15405":35975,"_5":15294,"_21315":35901,"_1890":35976},[],"Ensure ports 80 and 443 are free. Disable or reconfigure Traefik if it is not part of your traffic path.",{"_2299":277,"_22571":248,"_15405":35978,"_5":15294,"_21315":35901,"_1890":35979},[],"Allow those ports through the VM firewall and any upstream security group.",{"_2299":278,"_22571":248,"_15405":35981,"_5":15294,"_21315":35901,"_1890":35982},[],"Point DNS at the VM's reachable address.",{"_2299":279,"_22571":248,"_15405":35984,"_5":15294,"_21315":35901,"_1890":35985},[],"See the K3s ServiceLB documentation for its host-port behavior and how to replace it with another load-balancer implementation.",{"_2299":280,"_22571":248,"_15405":35987,"_5":15294,"_21315":35905,"_1890":35988},[],"Allocate a VIP from an address pool reachable on your LAN. You may request that VIP with `gateway.addresses` if the selected implementation supports it. Confirm the assigned address in status rather than assuming the request succeeded.",{"_2299":281,"_22571":248,"_15405":35990,"_5":15294,"_21315":35909,"_1890":35991},[],"An external public address can forward TCP 80 and 443 to the VM or to a Kubernetes-side VIP:",{"_2299":282,"_22571":248,"_15405":35993,"_5":15294,"_21315":35909,"_1890":35994},[],"The public IP belongs to the external device. Leave `gateway.addresses` unset or set it to the actual Kubernetes-side address, never to an address that the cluster cannot bind.",{"_2299":283,"_22571":248,"_15405":35996,"_5":15294,"_21315":35913,"_1890":35997},[],"First decide whether you need three independent data planes or only three hostnames.",{"_2299":284,"_22571":248,"_15405":35999,"_5":15294,"_21315":35913,"_1890":36000},[],"Requirement",{"_2299":285,"_22571":248,"_15405":36002,"_5":15294,"_21315":35913,"_1890":36003},[],"Recommended design",{"_2299":286,"_22571":248,"_15405":36005,"_5":15294,"_21315":35913,"_1890":36006},[],"Consequence",{"_2299":287,"_22571":248,"_15405":36008,"_5":15294,"_21315":35913,"_1890":36009},[],"Several Lamassu URLs or services",{"_2299":288,"_22571":248,"_15405":36011,"_5":15294,"_21315":35913,"_1890":36012},[],"One Gateway with multiple routes",{"_2299":289,"_22571":248,"_15405":36014,"_5":15294,"_21315":35913,"_1890":36015},[],"One IP and one proxy fleet; this is the chart default",{"_2299":290,"_22571":248,"_15405":36017,"_5":15294,"_21315":35913,"_1890":36018},[],"Independent Gateways and separate external IPs",{"_2299":291,"_22571":248,"_15405":36020,"_5":15294,"_21315":35913,"_1890":36021},[],"One VIP per Gateway",{"_2299":292,"_22571":248,"_15405":36023,"_5":15294,"_21315":35913,"_1890":36024},[],"All Gateways can use 80/443; requires a load balancer with an address pool",{"_2299":293,"_22571":248,"_15405":36026,"_5":15294,"_21315":35913,"_1890":36027},[],"Independent Gateways on one node and one IP",{"_2299":294,"_22571":248,"_15405":36029,"_5":15294,"_21315":35913,"_1890":36030},[],"Use different external ports",{"_2299":295,"_22571":248,"_15405":36032,"_5":15294,"_21315":35913,"_1890":36033},[],"Clients must include non-standard ports",{"_2299":296,"_22571":248,"_15405":36035,"_5":15294,"_21315":35913,"_1890":36036},[],"Separate TLS/mTLS termination behind one IP",{"_2299":297,"_22571":248,"_15405":36038,"_5":15294,"_21315":35913,"_1890":36039},[],"Front-door SNI routing to internal Gateways",{"_2299":298,"_22571":248,"_15405":36041,"_5":15294,"_21315":35913,"_1890":36042},[],"Advanced design; the front door uses TLS passthrough and each internal Gateway terminates its own TLS",{"_2299":299,"_22571":248,"_15405":36044,"_5":15294,"_21315":35913,"_1890":36045},[],"Separate Gateway resources but shared proxy infrastructure",{"_2299":300,"_22571":248,"_15405":36047,"_5":15294,"_21315":35913,"_1890":36048},[],"Envoy merged-Gateway mode",{"_2299":301,"_22571":248,"_15405":36050,"_5":15294,"_21315":35913,"_1890":36051},[],"Logical separation only; listeners must have unique port, protocol and hostname tuples",{"_2299":302,"_22571":248,"_15405":36053,"_5":15294,"_21315":35913,"_1890":36054},[],"Three independent `LoadBalancer` Services cannot all reserve the same node ports 80 and 443 through K3s ServiceLB. Use one shared Gateway, allocate distinct VIPs with another load-balancer implementation, or use different ports.",{"_2299":303,"_22571":248,"_15405":36056,"_5":15294,"_21315":35913,"_1890":36057},[],"Envoy Gateway normally provisions a proxy fleet per `Gateway`. Its merged-Gateway mode can share one fleet and address, but it is not a drop-in switch for multiple Lamassu releases: the generated Lamassu listeners use the same ports and protocols without distinct hostnames, so they conflict unless you deliberately customize the listener design.",{"_2299":304,"_22571":248,"_15405":36059,"_5":15294,"_21315":35913,"_1890":36060},[],"Use a front-door SNI design only when the internal Gateways must retain independent TLS or mTLS policy:",{"_2299":305,"_22571":248,"_15405":36062,"_5":15294,"_21315":35913,"_1890":36063},[],"This requires distinct SNI hostnames and cluster networking outside the Lamassu chart.",{"_2299":306,"_22571":248,"_15405":36065,"_5":15294,"_21315":35917,"_1890":36066},[],"If one Gateway can own TLS and routing, use the chart default.",{"_2299":307,"_22571":248,"_15405":36068,"_5":15294,"_21315":35917,"_1890":36069},[],"If Gateways need independent policy and you can allocate IPs, use one VIP per Gateway.",{"_2299":308,"_22571":248,"_15405":36071,"_5":15294,"_21315":35917,"_1890":36072},[],"If only the Kubernetes resources need separation, evaluate merged-Gateway mode and make every listener tuple unique.",{"_2299":309,"_22571":248,"_15405":36074,"_5":15294,"_21315":35917,"_1890":36075},[],"If data planes and TLS termination must stay independent behind one IP, add a front-door SNI passthrough layer.",{"_2299":310,"_22571":248,"_15405":36077,"_5":15294,"_21315":35917,"_1890":36078},[],"If none of those are possible, use different external ports or change the external network design.",{"_2299":311,"_22571":248,"_15405":36080,"_5":15294,"_21315":35921,"_1890":36081},[],"Check, in order:",{"_2299":312,"_22571":248,"_15405":36083,"_5":15294,"_21315":35921,"_1890":36084},[],"`Gateway` has `Accepted=True` and `Programmed=True`.",{"_2299":313,"_22571":248,"_15405":36086,"_5":15294,"_21315":35921,"_1890":36087},[],"Its status contains the expected address.",{"_2299":314,"_22571":248,"_15405":36089,"_5":15294,"_21315":35921,"_1890":36090},[],"The generated `LoadBalancer` Service has a usable external address.",{"_2299":315,"_22571":248,"_15405":36092,"_5":15294,"_21315":35921,"_1890":36093},[],"Port 443 reaches that address from the client network.",{"_2299":316,"_22571":248,"_15405":36095,"_5":15294,"_21315":35921,"_1890":36096},[],"DNS resolves to the externally reachable endpoint.",{"_2299":317,"_22571":248,"_15405":36098,"_5":15294,"_21315":35921,"_1890":36099},[],"The certificate contains the DNS name or IP used by the client.",{"_2299":318,"_22571":248,"_15405":36101,"_5":15294,"_21315":35921,"_1890":36102},[],"The Gateway API treats addresses as desired state that a controller may assign or reject; see the Gateway API overview for the resource model.",{"_2299":319,"_22571":319,"_5":10616,"_1890":35263,"_22830":36104,"_15405":36105,"_21315":319},[35156,35157,35263],[],{"_2299":320,"_22571":319,"_15405":36107,"_5":15294,"_21315":319,"_1890":36108},[],"Choose an installation workflow and network architecture for Lamassu on your Kubernetes cluster.",{"_2299":321,"_22571":319,"_5":22827,"_15405":36110,"_21315":36111,"_1890":36112},[],"/docs/deployment/self-hosted/overview#self-managed-kubernetes-deployment","Self-managed Kubernetes deployment",{"_2299":322,"_22571":319,"_5":22827,"_15405":36114,"_21315":36115,"_1890":36116},[],"/docs/deployment/self-hosted/overview#choose-an-installation-workflow","Choose an installation workflow",{"_2299":323,"_22571":319,"_5":22827,"_15405":36118,"_21315":36119,"_1890":36120},[],"/docs/deployment/self-hosted/overview#what-the-lamassu-chart-provides","What the Lamassu chart provides",{"_2299":324,"_22571":319,"_5":22827,"_15405":36122,"_21315":36123,"_1890":36124},[],"/docs/deployment/self-hosted/overview#how-the-deployment-fits-together","How the deployment fits together",{"_2299":325,"_22571":319,"_5":22827,"_15405":36126,"_21315":36127,"_1890":36128},[],"/docs/deployment/self-hosted/overview#platform-requirements","Platform requirements",{"_2299":326,"_22571":319,"_5":22827,"_15405":36130,"_21315":36131,"_1890":36132},[],"/docs/deployment/self-hosted/overview#choose-the-next-page","Choose the next page",{"_2299":327,"_22571":319,"_15405":36134,"_5":15294,"_21315":36111,"_1890":36135},[],"Run Lamassu in a Kubernetes cluster operated by your team. The Helm chart deploys the Lamassu services and their routing resources; you provide the cluster, persistent storage, identity provider, PostgreSQL, RabbitMQ and the network path used by clients.",{"_2299":328,"_22571":319,"_15405":36137,"_5":15294,"_21315":36115,"_1890":36138},[],"Workflow",{"_2299":329,"_22571":319,"_15405":36140,"_5":15294,"_21315":36115,"_1890":36141},[],"Use it for",{"_2299":330,"_22571":319,"_15405":36143,"_5":15294,"_21315":36115,"_1890":36144},[],"What it installs",{"_2299":331,"_22571":319,"_15405":36146,"_5":15294,"_21315":36115,"_1890":36147},[],"Helm",{"_2299":332,"_22571":319,"_15405":36149,"_5":15294,"_21315":36115,"_1890":36150},[],"Production and controlled environments",{"_2299":333,"_22571":319,"_15405":36152,"_5":15294,"_21315":36115,"_1890":36153},[],"Lamassu services and Gateway API resources",{"_2299":334,"_22571":319,"_15405":36155,"_5":15294,"_21315":36115,"_1890":35400},[],{"_2299":335,"_22571":319,"_15405":36157,"_5":15294,"_21315":36115,"_1890":36158},[],"Evaluation, demos, CI and small lab clusters",{"_2299":336,"_22571":319,"_15405":36160,"_5":15294,"_21315":36115,"_1890":36161},[],"PostgreSQL, Keycloak, RabbitMQ, Envoy Gateway and Lamassu",{"_2299":337,"_22571":319,"_15405":36163,"_5":15294,"_21315":36119,"_1890":36164},[],"The Lamassu chart is an **application chart**, not a cluster bootstrap chart. It creates the Kubernetes resources that run and configure Lamassu, but it expects the platform services those resources depend on to exist.",{"_2299":338,"_22571":319,"_15405":36166,"_5":15294,"_21315":36119,"_1890":36167},[],"Area",{"_2299":339,"_22571":319,"_15405":36169,"_5":15294,"_21315":36119,"_1890":36170},[],"The Lamassu chart provides",{"_2299":340,"_22571":319,"_15405":36172,"_5":15294,"_21315":36119,"_1890":36173},[],"You provide",{"_2299":341,"_22571":319,"_15405":36175,"_5":15294,"_21315":36119,"_1890":36176},[],"Lamassu applications",{"_2299":342,"_22571":319,"_15405":36178,"_5":15294,"_21315":36119,"_1890":36179},[],"Deployments and StatefulSets for the UI and APIs, internal Services, ConfigMaps, a ServiceAccount, and optional HPAs and PDBs",{"_2299":343,"_22571":319,"_15405":36181,"_5":15294,"_21315":36119,"_1890":36182},[],"A working Kubernetes cluster, compute capacity and access to the container images",{"_2299":344,"_22571":319,"_15405":36184,"_5":15294,"_21315":36119,"_1890":36185},[],"PostgreSQL data",{"_2299":345,"_22571":319,"_15405":36187,"_5":15294,"_21315":36119,"_1890":36188},[],"A pre-install/pre-upgrade job that creates the required databases and schemas, runs migrations and applies the authorization bootstrap",{"_2299":346,"_22571":319,"_15405":36190,"_5":15294,"_21315":36119,"_1890":36191},[],"A reachable PostgreSQL server, credentials allowed to create databases and schemas, and backup/HA operations",{"_2299":347,"_22571":319,"_15405":36193,"_5":15294,"_21315":36119,"_1890":36194},[],"Messaging",{"_2299":348,"_22571":319,"_15405":36196,"_5":15294,"_21315":36119,"_1890":36197},[],"RabbitMQ connection configuration for the Lamassu services",{"_2299":349,"_22571":319,"_15405":36199,"_5":15294,"_21315":36119,"_1890":36200},[],"A reachable RabbitMQ broker, credentials and its lifecycle",{"_2299":350,"_22571":319,"_15405":36202,"_5":15294,"_21315":36119,"_1890":36203},[],"Identity",{"_2299":351,"_22571":319,"_15405":36205,"_5":15294,"_21315":36119,"_1890":36206},[],"OIDC/JWT and external-authorization configuration, plus initial Lamassu authorization principals",{"_2299":352,"_22571":319,"_15405":36208,"_5":15294,"_21315":36119,"_1890":36209},[],"An OIDC provider, realm/tenant, client, users, groups and roles",{"_2299":353,"_22571":319,"_15405":36211,"_5":15294,"_21315":36119,"_1890":36212},[],"External routing",{"_2299":354,"_22571":319,"_15405":36214,"_5":15294,"_21315":36119,"_1890":36215},[],"One `Gateway`, `HTTPRoute` resources, an `EnvoyProxy` configuration and Envoy security policies",{"_2299":355,"_22571":319,"_15405":36217,"_5":15294,"_21315":36119,"_1890":36218},[],"Gateway API and Envoy CRDs, the Envoy Gateway controller, a `GatewayClass`, a load-balancer implementation and the external network path",{"_2299":356,"_22571":319,"_15405":36220,"_5":15294,"_21315":36119,"_1890":36221},[],"TLS",{"_2299":357,"_22571":319,"_15405":36223,"_5":15294,"_21315":36119,"_1890":36224},[],"cert-manager `Issuer` and CA `Certificate` resources; either a chart-managed downstream `Certificate` or a reference to your TLS Secret",{"_2299":358,"_22571":319,"_15405":36226,"_5":15294,"_21315":36119,"_1890":36227},[],"cert-manager itself; for trusted TLS, a trusted issuer or a populated TLS Secret",{"_2299":359,"_22571":319,"_15405":36229,"_5":15294,"_21315":36119,"_1890":36230},[],"Persistent application data",{"_2299":360,"_22571":319,"_15405":36232,"_5":15294,"_21315":36119,"_1890":36233},[],"PersistentVolumeClaims required by the default local KMS and VA storage",{"_2299":361,"_22571":319,"_15405":36235,"_5":15294,"_21315":36119,"_1890":36236},[],"A StorageClass, physical storage, backups and a shared/external backend when scaling requires one",{"_2299":362,"_22571":319,"_15405":36238,"_5":15294,"_21315":36119,"_1890":36239},[],"Optional integrations",{"_2299":363,"_22571":319,"_15405":36241,"_5":15294,"_21315":36119,"_1890":36242},[],"Configuration hooks for observability, AWS connectors and PKCS#11/HSM connectivity",{"_2299":364,"_22571":319,"_15405":36244,"_5":15294,"_21315":36119,"_1890":36245},[],"The observability backends, cloud credentials and production HSM or external key service",{"_2299":365,"_22571":319,"_15405":36247,"_5":15294,"_21315":36119,"_1890":36248},[],"The chart creates Lamassu's `Gateway` and routes. It does not install the Envoy Gateway controller or make the generated `LoadBalancer` Service reachable from your network.",{"_2299":366,"_22571":319,"_15405":36250,"_5":15294,"_21315":36119,"_1890":36251},[],"Use one Lamassu Gateway on ports 80 and 443 and let its HTTPRoutes dispatch traffic to every Lamassu service. Give that Gateway one externally reachable endpoint through the cluster load balancer, or forward traffic to it from an external proxy or NAT device. You do not need one Gateway per service.",{"_2299":367,"_22571":319,"_15405":36253,"_5":15294,"_21315":36123,"_1890":36254},[],"The chart creates one shared `Gateway` per Helm release. All chart-managed `HTTPRoute` resources attach to it. Envoy Gateway provisions the proxy data plane and a Kubernetes `LoadBalancer` Service for that Gateway.",{"_2299":368,"_22571":319,"_15405":36256,"_5":15294,"_21315":36123,"_1890":36257},[],"The `gateway.addresses` value is only an address request to the Gateway controller. It does not make an IP routable, open a firewall, configure DNS or create NAT. See Expose the Gateway before setting it.",{"_2299":369,"_22571":319,"_15405":36259,"_5":15294,"_21315":36127,"_1890":36260},[],"Kubernetes 1.24 or newer",{"_2299":370,"_22571":319,"_15405":36262,"_5":15294,"_21315":36127,"_1890":36263},[],"Helm 3.2 or newer",{"_2299":371,"_22571":319,"_15405":36265,"_5":15294,"_21315":36127,"_1890":36266},[],"Envoy Gateway 1.8 or newer and a `GatewayClass`",{"_2299":372,"_22571":319,"_15405":36268,"_5":15294,"_21315":36127,"_1890":36269},[],"cert-manager 1.14 or newer; the current chart renders cert-manager issuer and certificate resources",{"_2299":373,"_22571":319,"_15405":36271,"_5":15294,"_21315":36127,"_1890":36272},[],"persistent storage suitable for the selected PostgreSQL, RabbitMQ, VA and KMS configuration",{"_2299":374,"_22571":319,"_15405":36274,"_5":15294,"_21315":36127,"_1890":36275},[],"a load-balancer implementation or another deliberate path from clients to the Gateway",{"_2299":375,"_22571":319,"_15405":36277,"_5":15294,"_21315":36127,"_1890":36278},[],"KMS deployments using the native PKCS#11 sidecar require Kubernetes 1.29 or newer.",{"_2299":376,"_22571":319,"_15405":36280,"_5":15294,"_21315":36131,"_1890":36281},[],"<Card title=\"Install with Helm\" description=\"Prepare dependencies, configure values, install and verify a controlled deployment.\" href=\"/docs/deployment/self-hosted/helm\" />",{"_2299":377,"_22571":319,"_15405":36283,"_5":15294,"_21315":36131,"_1890":36284},[],"<Card title=\"Expose the Gateway\" description=\"Choose an external traffic design, understand gateway.addresses and handle multiple Gateways.\" href=\"/docs/deployment/self-hosted/networking\" />",{"_2299":378,"_22571":319,"_15405":36286,"_5":15294,"_21315":36131,"_1890":36287},[],"<Card title=\"Use Fastlane\" description=\"Bootstrap a complete evaluation or lab environment with one script.\" href=\"/docs/deployment/self-hosted/fastlane\" />",{"_2299":379,"_22571":379,"_5":10616,"_1890":36289,"_22830":36290,"_15405":36293,"_21315":379},"Access control",[35156,36291,36292],"Platform","Administer Lamassu",[],{"_2299":380,"_22571":379,"_15405":36295,"_5":15294,"_21315":379,"_1890":36296},[],"Design who can access Lamassu through principals, policies, resource permissions and HTTP route authorization.",{"_2299":381,"_22571":379,"_5":22827,"_15405":36298,"_21315":36299,"_1890":36300},[],"/docs/platform/pki/access-control#essential-concepts","Essential concepts",{"_2299":382,"_22571":379,"_5":22827,"_15405":36302,"_21315":36303,"_1890":36304},[],"/docs/platform/pki/access-control#two-decision-systems","Two decision systems",{"_2299":383,"_22571":379,"_5":22827,"_15405":36306,"_21315":36307,"_1890":36308},[],"/docs/platform/pki/access-control#integrated-or-external-http-services","Integrated or external HTTP services",{"_2299":384,"_22571":379,"_5":22827,"_15405":36310,"_21315":36311,"_1890":36312},[],"/docs/platform/pki/access-control#services-developed-by-lamassu","Services developed by Lamassu",{"_2299":385,"_22571":379,"_5":22827,"_15405":36314,"_21315":36315,"_1890":36316},[],"/docs/platform/pki/access-control#how-the-two-paths-relate","How the two paths relate",{"_2299":386,"_22571":379,"_5":22827,"_15405":36318,"_21315":36319,"_1890":36320},[],"/docs/platform/pki/access-control#oidc-principals","OIDC principals",{"_2299":387,"_22571":379,"_5":22827,"_15405":36322,"_21315":36323,"_1890":36324},[],"/docs/platform/pki/access-control#x509-principals","X.509 principals",{"_2299":388,"_22571":379,"_5":22827,"_15405":36326,"_21315":36327,"_1890":36328},[],"/docs/platform/pki/access-control#when-several-principals-match","When several principals match",{"_2299":389,"_22571":379,"_5":22827,"_15405":36330,"_21315":36331,"_1890":36332},[],"/docs/platform/pki/access-control#how-policies-express-access","How policies express access",{"_2299":390,"_22571":379,"_5":22827,"_15405":36334,"_21315":36335,"_1890":36336},[],"/docs/platform/pki/access-control#global-and-direct-access","Global and direct access",{"_2299":391,"_22571":379,"_5":22827,"_15405":36338,"_21315":36339,"_1890":36340},[],"/docs/platform/pki/access-control#access-inherited-through-relations","Access inherited through relations",{"_2299":392,"_22571":379,"_5":22827,"_15405":36342,"_21315":36343,"_1890":36344},[],"/docs/platform/pki/access-control#attribute-filtered-access","Attribute-filtered access",{"_2299":393,"_22571":379,"_5":22827,"_15405":36346,"_21315":36347,"_1890":36348},[],"/docs/platform/pki/access-control#http-rules","HTTP rules",{"_2299":394,"_22571":379,"_5":22827,"_15405":36350,"_21315":36351,"_1890":36352},[],"/docs/platform/pki/access-control#included-policies","Included policies",{"_2299":395,"_22571":379,"_5":22827,"_15405":36354,"_21315":36355,"_1890":35759},[],"/docs/platform/pki/access-control#provision-the-first-administrator",{"_2299":396,"_22571":379,"_5":22827,"_15405":36357,"_21315":36358,"_1890":36359},[],"/docs/platform/pki/access-control#prepare-the-identity-provider","Prepare the identity provider",{"_2299":397,"_22571":379,"_5":22827,"_15405":36361,"_21315":36362,"_1890":36363},[],"/docs/platform/pki/access-control#configure-the-two-jwt-validations","Configure the two JWT validations",{"_2299":398,"_22571":379,"_5":22827,"_15405":36365,"_21315":36366,"_1890":36367},[],"/docs/platform/pki/access-control#install-and-verify-administrative-access","Install and verify administrative access",{"_2299":399,"_22571":379,"_5":22827,"_15405":36369,"_21315":36370,"_1890":36371},[],"/docs/platform/pki/access-control#test-an-unprivileged-identity","Test an unprivileged identity",{"_2299":400,"_22571":379,"_5":22827,"_15405":36373,"_21315":36374,"_1890":36375},[],"/docs/platform/pki/access-control#reduce-use-of-the-bootstrap-administrator","Reduce use of the bootstrap administrator",{"_2299":401,"_22571":379,"_5":22827,"_15405":36377,"_21315":36378,"_1890":36379},[],"/docs/platform/pki/access-control#fastlane-bootstrap","Fastlane bootstrap",{"_2299":402,"_22571":379,"_5":22827,"_15405":36381,"_21315":36382,"_1890":36383},[],"/docs/platform/pki/access-control#design-least-privilege-roles","Design least-privilege roles",{"_2299":403,"_22571":379,"_5":22827,"_15405":36385,"_21315":36386,"_1890":36387},[],"/docs/platform/pki/access-control#changes-and-access-revocation","Changes and access revocation",{"_2299":404,"_22571":379,"_5":22827,"_15405":36389,"_21315":36390,"_1890":36391},[],"/docs/platform/pki/access-control#operational-checklist","Operational checklist",{"_2299":405,"_22571":379,"_5":22827,"_15405":36393,"_21315":36394,"_1890":36395},[],"/docs/platform/pki/access-control#diagnostics","Diagnostics",{"_2299":406,"_22571":379,"_5":22827,"_15405":36397,"_21315":36398,"_1890":36399},[],"/docs/platform/pki/access-control#the-response-is-401","The response is 401",{"_2299":407,"_22571":379,"_5":22827,"_15405":36401,"_21315":36402,"_1890":36403},[],"/docs/platform/pki/access-control#the-response-is-403","The response is 403",{"_2299":408,"_22571":379,"_5":22827,"_15405":36405,"_21315":36406,"_1890":36407},[],"/docs/platform/pki/access-control#everything-returns-403","Everything returns 403",{"_2299":409,"_22571":379,"_5":22827,"_15405":36409,"_21315":36410,"_1890":36411},[],"/docs/platform/pki/access-control#everything-fails-when-authz-is-unavailable","Everything fails when authz is unavailable",{"_2299":410,"_22571":379,"_15405":36413,"_5":15294,"_21315":379,"_1890":36414},[],"Lamassu access control turns an authenticated identity into concrete permissions. The OIDC provider or the client certificate proves **who** makes a request; the `authz` service decides **what that identity can do** and **over which resources**.",{"_2299":411,"_22571":379,"_15405":36416,"_5":15294,"_21315":379,"_1890":36417},[],"Lamassu does not assign permissions directly to users. The full chain is:",{"_2299":412,"_22571":379,"_15405":36419,"_5":15294,"_21315":379,"_1890":36420},[],"This model lets you represent people, identity-provider groups, service accounts and devices without coupling authorization to a specific provider.",{"_2299":413,"_22571":379,"_15405":36422,"_5":15294,"_21315":36299,"_1890":36423},[],"A **principal** connects a credential to Lamassu. It defines how to recognize an OIDC or X.509 identity and can be active or disabled.",{"_2299":414,"_22571":379,"_15405":36425,"_5":15294,"_21315":36299,"_1890":36426},[],"A **policy** groups reusable permissions. It can be granted to several principals and can contain rules about Lamassu entities, rules about HTTP routes or both.",{"_2299":415,"_22571":379,"_15405":36428,"_5":15294,"_21315":36299,"_1890":36429},[],"An **entity rule** grants actions over resources such as certification authorities, certificates, issuance profiles, devices, DMSs, keys or alert subscriptions. It can cover all resources of a type or be limited by identifier, relation or attribute.",{"_2299":416,"_22571":379,"_15405":36431,"_5":15294,"_21315":36299,"_1890":36432},[],"An **HTTP rule** grants actions associated with API routes. It is the mechanism the Gateway uses to decide whether a request may cross the perimeter.",{"_2299":417,"_22571":379,"_15405":36434,"_5":15294,"_21315":36299,"_1890":36435},[],"A **grant** is the association between a principal and a policy. Removing the grant removes all permissions contributed by that policy, without modifying it for other principals.",{"_2299":418,"_22571":379,"_15405":36437,"_5":15294,"_21315":36299,"_1890":36438},[],"A valid JWT or a valid client certificate does not grant access by itself. The credential must match at least one active principal and one of its policies must allow the requested operation.",{"_2299":419,"_22571":379,"_15405":36440,"_5":15294,"_21315":36303,"_1890":36441},[],"Lamassu uses two authorization paths depending on who implements the protected service. They share principals, policies and grants, but they do not interpret the rules the same way.",{"_2299":420,"_22571":379,"_15405":36443,"_5":15294,"_21315":36303,"_1890":36444},[],"An external service can be protected without knowing Lamassu's internal authorization model. A service developed by Lamassu embeds the authorization engine and can decide on concrete resources and filter its queries.",{"_2299":421,"_22571":379,"_15405":36446,"_5":15294,"_21315":36307,"_1890":36447},[],"This path protects APIs that join the platform through the Gateway but do not natively implement Lamassu's authorization SDK. Job Manager is the current example. The same pattern allows integrating other HTTP services as long as their routes are described in an `authz` HTTP schema.",{"_2299":422,"_22571":379,"_15405":36449,"_5":15294,"_21315":36307,"_1890":36450},[],"The decision is made **before forwarding the request to the service**:",{"_2299":423,"_22571":379,"_15405":36452,"_5":15294,"_21315":36307,"_1890":36453},[],"Envoy Gateway authenticates the request, usually validating a JWT against the OIDC provider's JWKS.",{"_2299":424,"_22571":379,"_15405":36455,"_5":15294,"_21315":36307,"_1890":36456},[],"For a protected route, Envoy sends the method, URL, headers and required data to `/v1/ext_authz/check`.",{"_2299":425,"_22571":379,"_15405":36458,"_5":15294,"_21315":36307,"_1890":36459},[],"`authz` extracts the credential and resolves all active principals matching it.",{"_2299":426,"_22571":379,"_15405":36461,"_5":15294,"_21315":36307,"_1890":36462},[],"It separately loads the policies granted to each principal.",{"_2299":427,"_22571":379,"_15405":36464,"_5":15294,"_21315":36307,"_1890":36465},[],"The HTTP schema translates the method and route combination into a logical action, such as `nbi-job-read` or `nbi-workflow-create`.",{"_2299":428,"_22571":379,"_15405":36467,"_5":15294,"_21315":36307,"_1890":36468},[],"`authz` looks for an HTTP rule granting that action.",{"_2299":429,"_22571":379,"_15405":36470,"_5":15294,"_21315":36307,"_1890":36471},[],"If the route declares constraints, it compares request data with the normalized attributes of the same principal contributing the policy.",{"_2299":430,"_22571":379,"_15405":36473,"_5":15294,"_21315":36307,"_1890":36474},[],"A satisfying result lets Envoy forward the request; any other response blocks it at the Gateway.",{"_2299":431,"_22571":379,"_15405":36476,"_5":15294,"_21315":36307,"_1890":36477},[],"When it allows access, `authz` returns the selected principal in `x-current-user`. The Gateway can propagate that header to the service to preserve the identity context.",{"_2299":432,"_22571":379,"_15405":36479,"_5":15294,"_21315":36307,"_1890":36480},[],"HTTP rules primarily answer &#x2A;*\"can this identity call this API operation?\"**. On their own they do not produce filters over the external service's database. To limit a route to a specific device, tenant or client, the schema must declare a constraint relating a request value to a normalized attribute of the principal.",{"_2299":433,"_22571":379,"_15405":36482,"_5":15294,"_21315":36311,"_1890":36483},[],"Lamassu's native services embed authorization in their middleware and know the entities they operate on: certificates, CAs, issuance profiles, keys, devices, DMSs or subscriptions, among others.",{"_2299":434,"_22571":379,"_15405":36485,"_5":15294,"_21315":36311,"_1890":36486},[],"The decision is made with the domain operation context:",{"_2299":435,"_22571":379,"_15405":36488,"_5":15294,"_21315":36311,"_1890":36489},[],"The middleware extracts the credential and resolves the matching principals.",{"_2299":436,"_22571":379,"_15405":36491,"_5":15294,"_21315":36311,"_1890":36492},[],"The endpoint identifies the action, the entity type and, when applicable, the key of the requested resource.",{"_2299":437,"_22571":379,"_15405":36494,"_5":15294,"_21315":36311,"_1890":36495},[],"`authz` gathers the entity rules of the granted policies.",{"_2299":438,"_22571":379,"_15405":36497,"_5":15294,"_21315":36311,"_1890":36498},[],"The engine evaluates direct grants, attribute filters and relations with other entities.",{"_2299":439,"_22571":379,"_15405":36500,"_5":15294,"_21315":36311,"_1890":36501},[],"For an individual operation, it checks that the concrete resource satisfies the computed scope.",{"_2299":440,"_22571":379,"_15405":36503,"_5":15294,"_21315":36311,"_1890":36504},[],"For a listing, it generates a SQL filter that the service adds to its own query.",{"_2299":441,"_22571":379,"_15405":36506,"_5":15294,"_21315":36311,"_1890":36507},[],"Here the engine answers &#x2A;*\"can this identity perform this action on this concrete resource?\"**.",{"_2299":442,"_22571":379,"_15405":36509,"_5":15294,"_21315":36311,"_1890":36510},[],"Actions fall into two groups:",{"_2299":443,"_22571":379,"_15405":36512,"_5":15294,"_21315":36311,"_1890":36513},[],"**Global actions** do not need a resource identifier. `create`, `import` or access to a console section are common examples.",{"_2299":444,"_22571":379,"_15405":36515,"_5":15294,"_21315":36311,"_1890":36516},[],"**Atomic actions** are evaluated on a concrete instance. For certificates these include `read`, `metadata-update`, `status-update` and `delete`; for a CA there are also `sign`, `reissue` and other lifecycle operations.",{"_2299":445,"_22571":379,"_15405":36518,"_5":15294,"_21315":36311,"_1890":36519},[],"Filtering inside the service prevents leaks in listings: unauthorized resources are excluded from the SQL query instead of being fetched and hidden later in the interface.",{"_2299":446,"_22571":379,"_15405":36521,"_5":15294,"_21315":36315,"_1890":36522},[],"They are not two equivalent controls applied twice. HTTP rules protect the perimeter of an integrated service; entity rules express permissions over the data model of the native services.",{"_2299":447,"_22571":379,"_15405":36524,"_5":15294,"_21315":36315,"_1890":36525},[],"A policy can contain both rule types when an identity needs to operate Lamassu resources and also call an integrated API. Granting an entity rule does not automatically grant an HTTP action, nor does an HTTP rule create access over an entity.",{"_2299":448,"_22571":379,"_15405":36527,"_5":15294,"_21315":36315,"_1890":36528},[],"If no combination of principal, policy and rule allows the operation, Lamassu denies it. Additionally, `auth.externalAuthorization.failOpen` is `false` by default: if `authz` is unavailable, the Gateway blocks protected routes.",{"_2299":449,"_22571":379,"_15405":36530,"_5":15294,"_21315":36319,"_1890":36531},[],"An OIDC principal matches the claims of a validated JWT. It is appropriate for human users, corporate groups, IdP roles and service accounts that obtain tokens.",{"_2299":450,"_22571":379,"_15405":36533,"_5":15294,"_21315":36319,"_1890":36534},[],"The following principal represents any identity holding the `pki-operators` role in Keycloak:",{"_2299":451,"_22571":379,"_15405":36536,"_5":15294,"_21315":36319,"_1890":36537},[],"Claim paths can be nested, such as `realm_access.roles`. Within a single principal, **all** conditions must hold. This lets you require, for example, a group and an organizational audience at the same time.",{"_2299":452,"_22571":379,"_15405":36539,"_5":15294,"_21315":36319,"_1890":36540},[],"The implemented operators are:",{"_2299":453,"_22571":379,"_15405":36542,"_5":15294,"_21315":36319,"_1890":36543},[],"`equals`, for exact equality;",{"_2299":454,"_22571":379,"_15405":36545,"_5":15294,"_21315":36319,"_1890":36546},[],"`contains`, to check membership in a list or the presence of text in a scalar value.",{"_2299":455,"_22571":379,"_15405":36548,"_5":15294,"_21315":36319,"_1890":36549},[],"Design matching with stable attributes. For people, it is usually better to bind permissions to centrally managed groups or roles than to the email or username. For a service account, a stable `sub` keeps its permissions from mixing with a human operator's.",{"_2299":456,"_22571":379,"_15405":36551,"_5":15294,"_21315":36319,"_1890":36552},[],"Although the model recognizes the operator name `matches`, the current implementation does not evaluate regular expressions and the condition never matches. Use `equals` or `contains`.",{"_2299":457,"_22571":379,"_15405":36554,"_5":15294,"_21315":36323,"_1890":36555},[],"An X.509 principal lets you recognize a workload or a device by its client certificate. Lamassu checks the certificate signature against the configured CA and, depending on the mode, also its serial number or Common Name.",{"_2299":458,"_22571":379,"_15405":36557,"_5":15294,"_21315":36323,"_1890":36558},[],"The available modes are:",{"_2299":459,"_22571":379,"_15405":36560,"_5":15294,"_21315":36323,"_1890":36561},[],"`serial_and_ca`: an exact certificate, identified by serial number and CA;",{"_2299":460,"_22571":379,"_15405":36563,"_5":15294,"_21315":36323,"_1890":36564},[],"`cn_and_ca`: an exact or wildcard Common Name and a specific CA;",{"_2299":461,"_22571":379,"_15405":36566,"_5":15294,"_21315":36323,"_1890":36567},[],"`any_from_ca`: any certificate issued directly by the given CA.",{"_2299":462,"_22571":379,"_15405":36569,"_5":15294,"_21315":36323,"_1890":36570},[],"This example recognizes certificates whose CN starts with `factory-a-` and that are signed by the configured CA:",{"_2299":463,"_22571":379,"_15405":36572,"_5":15294,"_21315":36323,"_1890":36573},[],"`ca_trust.identity_type` accepts `fingerprint` or `authority_key_id`. In both cases you must provide the CA certificate in `ca_trust.pem`; Lamassu verifies both the signature and the expected identity of the CA.",{"_2299":464,"_22571":379,"_15405":36575,"_5":15294,"_21315":36323,"_1890":36576},[],"Use `any_from_ca` only when every identity issued by that CA should share the same permissions. If a CA issues certificates for different populations, separate access by serial or CN, or use different issuing CAs.",{"_2299":465,"_22571":379,"_15405":36578,"_5":15294,"_21315":36327,"_1890":36579},[],"A single credential can match more than one principal. It is common for a user to match a principal of their team and another of their operational function.",{"_2299":466,"_22571":379,"_15405":36581,"_5":15294,"_21315":36327,"_1890":36582},[],"For entity permissions, Lamassu combines permissions with OR logic: it is enough that one policy of one of the principals allows the action. Listings contain the union of the resources visible to all of them.",{"_2299":467,"_22571":379,"_15405":36584,"_5":15294,"_21315":36327,"_1890":36585},[],"HTTP routes with constraints are stricter. The same principal contributing the policy must also satisfy the attributes required by the route. Lamassu does not combine one principal's policy with an attribute belonging to another.",{"_2299":468,"_22571":379,"_15405":36587,"_5":15294,"_21315":36327,"_1890":36588},[],"For this reason, adding a matching principal can only broaden access. Before creating overlapping rules, review the full set of policies a real identity will receive.",{"_2299":469,"_22571":379,"_15405":36590,"_5":15294,"_21315":36335,"_1890":36591},[],"A rule identifies the domain (`namespace`), the data schema (`schema_name`) and the entity type (`entity_type`). `actions` lists the allowed operations.",{"_2299":470,"_22571":379,"_15405":36593,"_5":15294,"_21315":36335,"_1890":36594},[],"`direct_grants` limits the rule to concrete identifiers. The value `*` covers all instances of the type. A superadministrator policy uses wildcards in schema, entity, actions and grants; a least-privilege policy should avoid them whenever possible.",{"_2299":471,"_22571":379,"_15405":36596,"_5":15294,"_21315":36339,"_1890":36597},[],"Rules can follow relations declared between entities. For example, the schema knows the relation of a certificate to its issuing CA and of a device to its DMS. A policy can grant access to a parent resource and propagate selected actions to its related resources.",{"_2299":472,"_22571":379,"_15405":36599,"_5":15294,"_21315":36339,"_1890":36600},[],"This lets you express models like \"can operate the devices of this DMS\" without maintaining an individual list of every device. When a resource is added under that relation, it inherits the scope planned by the policy.",{"_2299":473,"_22571":379,"_15405":36602,"_5":15294,"_21315":36343,"_1890":36603},[],"`column_filters` applies conditions to columns the schema has declared filterable. All filters of the same rule are combined with AND.",{"_2299":474,"_22571":379,"_15405":36605,"_5":15294,"_21315":36343,"_1890":36606},[],"For example, this rule allows reading active certificates issued by a specific CA:",{"_2299":475,"_22571":379,"_15405":36608,"_5":15294,"_21315":36343,"_1890":36609},[],"The available operators are `eq`, `neq`, `gt`, `gte`, `lt`, `lte`, `in` and `like`. Use comparisons consistent with the column type: `like` for text, ordering comparisons for numbers or dates and `in` when there is a collection of accepted values.",{"_2299":476,"_22571":379,"_15405":36611,"_5":15294,"_21315":36347,"_1890":36612},[],"HTTP rules do not point directly at tables. They reference a route schema and grant its logical actions. Job Manager's policies are an example: they distinguish reading, creating, updating and deleting workflows or jobs.",{"_2299":477,"_22571":379,"_15405":36614,"_5":15294,"_21315":36347,"_1890":36615},[],"Some routes also compare a request value — taken from the path, query, header or JSON body — with a normalized attribute of the principal. This way you can verify that a device only queries jobs addressed to its own `client_id`.",{"_2299":478,"_22571":379,"_15405":36617,"_5":15294,"_21315":36347,"_1890":36618},[],"Normalized attributes decouple the policy from the authentication mechanism. `subject_attribute_mappings` can derive, for example, `device_id` from `oidc.claim.device_id` or from `x509.subject.cn`. The rule consumes `device_id` in both cases.",{"_2299":479,"_22571":379,"_15405":36620,"_5":15294,"_21315":36351,"_1890":36621},[],"The `authz` preload installs reusable policies for the main domains. Among them are:",{"_2299":480,"_22571":379,"_15405":36623,"_5":15294,"_21315":36351,"_1890":36624},[],"full and read-only access to certificates and authorities;",{"_2299":481,"_22571":379,"_15405":36626,"_5":15294,"_21315":36351,"_1890":36627},[],"full and read-only access to the KMS;",{"_2299":482,"_22571":379,"_15405":36629,"_5":15294,"_21315":36351,"_1890":36630},[],"full and read-only access to Device Manager, DMS Manager, Validation Authority and alerts;",{"_2299":483,"_22571":379,"_15405":36632,"_5":15294,"_21315":36351,"_1890":36633},[],"an `Auditor` policy with PKI read access and authorization visibility;",{"_2299":484,"_22571":379,"_15405":36635,"_5":15294,"_21315":36351,"_1890":36636},[],"console access;",{"_2299":485,"_22571":379,"_15405":36638,"_5":15294,"_21315":36351,"_1890":36639},[],"administration and observation policies for the Job Manager NBI and SBI APIs;",{"_2299":486,"_22571":379,"_15405":36641,"_5":15294,"_21315":36351,"_1890":36642},[],"`SUPER ADMIN`, which grants all actions over the `authz` and `pki` domains.",{"_2299":487,"_22571":379,"_15405":36644,"_5":15294,"_21315":36351,"_1890":36645},[],"Start with these policies before creating others. If none reflects the boundary you need, create a specific, small policy instead of copying `SUPER ADMIN` and informally removing permissions.",{"_2299":488,"_22571":379,"_15405":36647,"_5":15294,"_21315":36355,"_1890":36648},[],"An installation without a principal matching your identity is left with nobody able to administer authorization. Configure the IdP and the bootstrap before exposing the platform.",{"_2299":489,"_22571":379,"_15405":36650,"_5":15294,"_21315":36355,"_1890":36651},[],"The chart includes a bootstrap principal that looks for the OIDC role `pki-admin` in `realm_access.roles`. It grants it `SUPER ADMIN` and, when Job Manager is enabled, the administrative policy of its NBI API.",{"_2299":490,"_22571":379,"_15405":36653,"_5":15294,"_21315":36355,"_1890":36654},[],"The pre-install and pre-upgrade Helm Job runs the `authz` migrations, preloads the policies and creates the bootstrap principals before the services start. If the principal already exists, it does not replace it: it only adds the configured grants that are still missing. You can keep the entry in `values.yaml` across upgrades.",{"_2299":491,"_22571":379,"_15405":36656,"_5":15294,"_21315":36358,"_1890":36657},[],"Create the role or group you will use to administer Lamassu. Assign it to at least two controlled human identities. If your provider does not use `realm_access.roles`, adapt the claim path in both the frontend and `auth_config.claims`.",{"_2299":492,"_22571":379,"_15405":36659,"_5":15294,"_21315":36362,"_1890":36660},[],"The Gateway uses `auth.authentication.apiGateway.jwks` to authenticate requests. `authz` uses `services.authz.jwkUrl` to resolve OIDC principals. Both endpoints must contain the keys of the same issuer and be reachable from their respective components.",{"_2299":493,"_22571":379,"_15405":36662,"_5":15294,"_21315":36366,"_1890":36663},[],"Sign in with an identity holding `pki-admin`. Confirm it can access authorization administration and perform a non-destructive read operation.",{"_2299":494,"_22571":379,"_15405":36665,"_5":15294,"_21315":36370,"_1890":36666},[],"Use a second user without the role and confirm the same operation is denied. This test catches misread claims, overly broad policies and accidental `failOpen` configurations.",{"_2299":495,"_22571":379,"_15405":36668,"_5":15294,"_21315":36374,"_1890":36669},[],"Create operational principals with narrower policies. Reserve `pki-admin` for authorization administration and recovery, not for daily work.",{"_2299":496,"_22571":379,"_15405":36671,"_5":15294,"_21315":36378,"_1890":36672},[],"Fastlane installs a Keycloak realm for the lab and creates the user `lamassu` with the temporary password `lamassu`, the role `pki-admin` and a mandatory password change. Its bootstrap principal matches through `preferred_username=lamassu`.",{"_2299":497,"_22571":379,"_15405":36674,"_5":15294,"_21315":36378,"_1890":36675},[],"Change the password on first login. Do not reuse the Fastlane user, password or IdP as a production design.",{"_2299":498,"_22571":379,"_15405":36677,"_5":15294,"_21315":36382,"_1890":36678},[],"Avoid reproducing your company's internal structure with dozens of nearly identical policies. Start from the responsibilities that actually need access:",{"_2299":499,"_22571":379,"_15405":36680,"_5":15294,"_21315":36382,"_1890":36681},[],"**Authorization administration**: manages principals, policies and grants. It should belong to a small, separate group.",{"_2299":500,"_22571":379,"_15405":36683,"_5":15294,"_21315":36382,"_1890":36684},[],"**PKI operation**: administers CAs, profiles and certificates, but not necessarily who gets access.",{"_2299":501,"_22571":379,"_15405":36686,"_5":15294,"_21315":36382,"_1890":36687},[],"**Device registration**: operates devices and DMSs without receiving permissions over keys or authorization configuration.",{"_2299":502,"_22571":379,"_15405":36689,"_5":15294,"_21315":36382,"_1890":36690},[],"**Audit**: reviews configuration and activity without creating, modifying, signing, revoking or deleting.",{"_2299":503,"_22571":379,"_15405":36692,"_5":15294,"_21315":36382,"_1890":36693},[],"**Automation**: uses a technical account or a separate certificate, with permissions limited to the flow and resources it controls.",{"_2299":504,"_22571":379,"_15405":36695,"_5":15294,"_21315":36382,"_1890":36696},[],"For each role, separate \"view\" from \"change\", limit resources through grants, relations or attributes and avoid `*` unless the role must automatically cover future actions.",{"_2299":505,"_22571":379,"_15405":36698,"_5":15294,"_21315":36382,"_1890":36699},[],"A rule with `actions: [\"*\"]` expands to every action defined by the schema. When a new version adds an action, a wildcard policy may start granting it. Review these policies on every upgrade.",{"_2299":506,"_22571":379,"_15405":36701,"_5":15294,"_21315":36386,"_1890":36702},[],"To revoke access immediately, disable the principal or revoke its grants. Disabling a principal keeps its configuration and associations for investigation or restoration, but it stops taking part in matching.",{"_2299":507,"_22571":379,"_15405":36704,"_5":15294,"_21315":36386,"_1890":36705},[],"Deleting a role or group in the IdP prevents new tokens from containing the claim, but an already-issued token may remain valid until it expires. If removal is urgent, combine the IdP change with disabling the principal in Lamassu and revoking sessions or tokens at the provider.",{"_2299":508,"_22571":379,"_15405":36707,"_5":15294,"_21315":36386,"_1890":36708},[],"When you edit a shared policy, remember the change affects all its principals. To test a new scope, create a separate policy, grant it to a test identity and validate allowed and denied operations before replacing the old one.",{"_2299":509,"_22571":379,"_15405":36710,"_5":15294,"_21315":36390,"_1890":36711},[],"Keep `failOpen: false` unless a documented risk assessment justifies otherwise.",{"_2299":510,"_22571":379,"_15405":36713,"_5":15294,"_21315":36390,"_1890":36714},[],"Use groups or stable roles for people and independent identities for automations.",{"_2299":511,"_22571":379,"_15405":36716,"_5":15294,"_21315":36390,"_1890":36717},[],"Keep at least two recovery administrators and test their access periodically.",{"_2299":512,"_22571":379,"_15405":36719,"_5":15294,"_21315":36390,"_1890":36720},[],"Review active principals, their matches and their grants after IdP changes.",{"_2299":513,"_22571":379,"_15405":36722,"_5":15294,"_21315":36390,"_1890":36723},[],"Search for wildcards in policies before upgrading Lamassu.",{"_2299":514,"_22571":379,"_15405":36725,"_5":15294,"_21315":36390,"_1890":36726},[],"Always test one allowed and one denied operation for each role.",{"_2299":515,"_22571":379,"_15405":36728,"_5":15294,"_21315":36390,"_1890":36729},[],"Correlate changes to principals, policies and grants with the audit logs.",{"_2299":516,"_22571":379,"_15405":36731,"_5":15294,"_21315":36398,"_1890":36732},[],"Authentication failed before permissions were evaluated. Check the JWT signature and expiration, issuer, audience and the availability of the JWKS configured in the Gateway. For X.509, check that the client certificate reaches the point that extracts the credential.",{"_2299":517,"_22571":379,"_15405":36734,"_5":15294,"_21315":36402,"_1890":36735},[],"The credential could be processed but did not produce a positive authorization. Review in this order:",{"_2299":518,"_22571":379,"_15405":36737,"_5":15294,"_21315":36402,"_1890":36738},[],"that an active principal of the correct type exists;",{"_2299":519,"_22571":379,"_15405":36740,"_5":15294,"_21315":36402,"_1890":36741},[],"that the claim paths and values match the real token exactly;",{"_2299":520,"_22571":379,"_15405":36743,"_5":15294,"_21315":36402,"_1890":36744},[],"that all of the principal's conditions hold;",{"_2299":521,"_22571":379,"_15405":36746,"_5":15294,"_21315":36402,"_1890":36747},[],"that the principal has the expected policy granted;",{"_2299":522,"_22571":379,"_15405":36749,"_5":15294,"_21315":36402,"_1890":36750},[],"that the policy includes the action and the requested resource type or route;",{"_2299":523,"_22571":379,"_15405":36752,"_5":15294,"_21315":36402,"_1890":36753},[],"that the identifier, relation, column filter or HTTP constraint includes the real resource.",{"_2299":524,"_22571":379,"_15405":36755,"_5":15294,"_21315":36402,"_1890":36756},[],"In the `authz` logs, an external endpoint decision includes `allowed`, `reason`, `matched_principals`, `evaluated_policy_ids`, `matched_policy_id` and the status code. These fields let you separate a matching failure from a permissions failure.",{"_2299":525,"_22571":379,"_15405":36758,"_5":15294,"_21315":36406,"_1890":36759},[],"Check that the bootstrap principal was created and that the policies were preloaded by the migration Job. Also verify that `services.authz.jwkUrl` is reachable from the `authz` pod; do not assume that a URL accessible from the browser also works inside the cluster.",{"_2299":526,"_22571":379,"_15405":36761,"_5":15294,"_21315":36410,"_1890":36762},[],"This is the expected behavior with `failOpen: false`. Restore the service, its PostgreSQL connection and its JWKS connectivity. Do not temporarily switch to `failOpen: true` without accepting that protected routes could become accessible without an authorization decision.",{"_2299":527,"_22571":379,"_15405":36764,"_5":15294,"_21315":36410,"_1890":36765},[],"Continue with Audit logs to investigate configuration changes or with Troubleshooting to diagnose the deployment.",{"_2299":528,"_22571":528,"_5":10616,"_1890":36767,"_22830":36768,"_15405":36770,"_21315":528},"Alerts and subscriptions",[35156,36291,36769],"Operate Lamassu",[],{"_2299":529,"_22571":528,"_15405":36772,"_5":15294,"_21315":528,"_1890":36773},[],"Send PKI events to people and external systems.",{"_2299":530,"_22571":528,"_5":22827,"_15405":36775,"_21315":36776,"_1890":36777},[],"/docs/platform/pki/alerts#how-it-works","How it works",{"_2299":531,"_22571":528,"_5":22827,"_15405":36779,"_21315":36780,"_1890":36781},[],"/docs/platform/pki/alerts#available-channels","Available channels",{"_2299":532,"_22571":528,"_5":22827,"_15405":36783,"_21315":36784,"_1890":36785},[],"/docs/platform/pki/alerts#create-a-subscription","Create a subscription",{"_2299":533,"_22571":528,"_5":22827,"_15405":36787,"_21315":36788,"_1890":36789},[],"/docs/platform/pki/alerts#choose-the-event","Choose the event",{"_2299":534,"_22571":528,"_5":22827,"_15405":36791,"_21315":36792,"_1890":36793},[],"/docs/platform/pki/alerts#configure-the-destination","Configure the destination",{"_2299":535,"_22571":528,"_5":22827,"_15405":36795,"_21315":36796,"_1890":36797},[],"/docs/platform/pki/alerts#limit-the-notifications","Limit the notifications",{"_2299":536,"_22571":528,"_5":22827,"_15405":36799,"_21315":36800,"_1890":36801},[],"/docs/platform/pki/alerts#review-and-activate","Review and activate",{"_2299":537,"_22571":528,"_5":22827,"_15405":36803,"_21315":36804,"_1890":36805},[],"/docs/platform/pki/alerts#manage-a-subscription","Manage a subscription",{"_2299":538,"_22571":528,"_5":22827,"_15405":36807,"_21315":36808,"_1890":36809},[],"/docs/platform/pki/alerts#event-families","Event families",{"_2299":539,"_22571":528,"_15405":36811,"_5":15294,"_21315":528,"_1890":36812},[],"Subscriptions turn Lamassu events into actionable notifications. You can alert a team, feed an incident system or trigger an automation when a CA, certificate or device changes.",{"_2299":540,"_22571":528,"_15405":36814,"_5":15294,"_21315":36776,"_1890":36815},[],"A service publishes a domain event.",{"_2299":541,"_22571":528,"_15405":36817,"_5":15294,"_21315":36776,"_1890":36818},[],"Lamassu evaluates the subscriptions associated with that event type.",{"_2299":542,"_22571":528,"_15405":36820,"_5":15294,"_21315":36776,"_1890":36821},[],"Each subscription's filter decides whether it should be notified.",{"_2299":543,"_22571":528,"_15405":36823,"_5":15294,"_21315":36776,"_1890":36824},[],"Lamassu delivers the event to the configured channel.",{"_2299":544,"_22571":528,"_15405":36826,"_5":15294,"_21315":36776,"_1890":36827},[],"The event inventory shows when each type was last observed, how many times it has occurred and how many subscriptions it has. You can expand an event to inspect an example of its JSON payload before creating the filter.",{"_2299":545,"_22571":528,"_15405":36829,"_5":15294,"_21315":36780,"_1890":36830},[],"**Email** sends alerts to a person or an operational list. It only requires the destination address.",{"_2299":546,"_22571":528,"_15405":36832,"_5":15294,"_21315":36780,"_1890":36833},[],"**Microsoft Teams** posts the notification to a channel through its webhook URL.",{"_2299":547,"_22571":528,"_15405":36835,"_5":15294,"_21315":36780,"_1890":36836},[],"**Webhook** delivers the event to an automation, SIEM or incident system via `POST` or `PUT`.",{"_2299":548,"_22571":528,"_15405":36838,"_5":15294,"_21315":36788,"_1890":36839},[],"Open **Alerts**, locate the event type and select **Subscribe**. Review the latest JSON example to identify the fields you will need to filter on.",{"_2299":549,"_22571":528,"_15405":36841,"_5":15294,"_21315":36792,"_1890":36842},[],"Select Email, Microsoft Teams or Webhook and enter the channel details.",{"_2299":550,"_22571":528,"_15405":36844,"_5":15294,"_21315":36796,"_1890":36845},[],"Add a filter if you don't want to receive every instance of the event.",{"_2299":551,"_22571":528,"_15405":36847,"_5":15294,"_21315":36796,"_1890":36848},[],"**None** notifies all instances of the event.",{"_2299":552,"_22571":528,"_15405":36850,"_5":15294,"_21315":36796,"_1890":36851},[],"**JSON Path** evaluates one or more specific fields.",{"_2299":553,"_22571":528,"_15405":36853,"_5":15294,"_21315":36796,"_1890":36854},[],"**JSON Schema** accepts only payloads with a particular structure.",{"_2299":554,"_22571":528,"_15405":36856,"_5":15294,"_21315":36796,"_1890":36857},[],"**JavaScript** lets you express custom logic.",{"_2299":555,"_22571":528,"_15405":36859,"_5":15294,"_21315":36796,"_1890":36860},[],"For example, `function (event) { return event.data.status == \"NO_IDENTITY\"; }` limits a subscription to devices without an identity.",{"_2299":556,"_22571":528,"_15405":36862,"_5":15294,"_21315":36800,"_1890":36863},[],"Check the event, channel and filter in the summary. Select **Confirm Subscription** to start delivery.",{"_2299":557,"_22571":528,"_15405":36865,"_5":15294,"_21315":36804,"_1890":36866},[],"Open an existing subscription to review its destination and filter, modify the configuration or select **Unsubscribe**. Remove subscriptions that no longer have an operational owner to avoid ignored deliveries or stale endpoints.",{"_2299":558,"_22571":528,"_15405":36868,"_5":15294,"_21315":36808,"_1890":36869},[],"**Authorities:** `ca.create`, `ca.import`, `ca.reissue` and `ca.delete`.",{"_2299":559,"_22571":528,"_15405":36871,"_5":15294,"_21315":36808,"_1890":36872},[],"**Certificates:** `ca.sign.certificate` and `certificate.delete`.",{"_2299":560,"_22571":528,"_15405":36874,"_5":15294,"_21315":36808,"_1890":36875},[],"**Profiles:** `profile.create`, `profile.update` and `profile.delete`.",{"_2299":561,"_22571":528,"_15405":36877,"_5":15294,"_21315":36808,"_1890":36878},[],"**Enrollment:** `dms.create`, `dms.update`, `dms.enroll` and `dms.reenroll`.",{"_2299":562,"_22571":528,"_15405":36880,"_5":15294,"_21315":36808,"_1890":36881},[],"**Devices:** `device.create`, `device.identity.update` and `device.status.update`.",{"_2299":563,"_22571":528,"_15405":36883,"_5":15294,"_21315":36808,"_1890":36884},[],"**Validation:** `va.role.crl.create`.",{"_2299":564,"_22571":528,"_15405":36886,"_5":15294,"_21315":36808,"_1890":36887},[],"**Keys:** `kms.create`, `kms.import`, `kms.sign.message` and `kms.delete`.",{"_2299":565,"_22571":528,"_15405":36889,"_5":15294,"_21315":36808,"_1890":36890},[],"Use the catalog shown in the console as the source for the types available in your deployed version.",{"_2299":566,"_22571":566,"_5":10616,"_1890":36892,"_22830":36893,"_15405":36894,"_21315":566},"Audit logs",[35156,36291,36292],[],{"_2299":567,"_22571":566,"_15405":36896,"_5":15294,"_21315":566,"_1890":36897},[],"Understand which audit events Lamassu generates and how to turn them into a durable trail.",{"_2299":568,"_22571":566,"_5":22827,"_15405":36899,"_21315":36900,"_1890":36901},[],"/docs/platform/pki/audit-logs#what-an-event-contains","What an event contains",{"_2299":569,"_22571":566,"_5":22827,"_15405":36903,"_21315":36904,"_1890":36905},[],"/docs/platform/pki/audit-logs#coverage","Coverage",{"_2299":570,"_22571":566,"_5":22827,"_15405":36907,"_21315":36908,"_1890":36909},[],"/docs/platform/pki/audit-logs#publication-and-persistence","Publication and persistence",{"_2299":571,"_22571":566,"_5":22827,"_15405":36911,"_21315":36912,"_1890":36913},[],"/docs/platform/pki/audit-logs#sensitive-data","Sensitive data",{"_2299":572,"_22571":566,"_5":22827,"_15405":36915,"_21315":36916,"_1890":36917},[],"/docs/platform/pki/audit-logs#a-reproducible-investigation","A reproducible investigation",{"_2299":573,"_22571":566,"_5":22827,"_15405":36919,"_21315":36920,"_1890":36921},[],"/docs/platform/pki/audit-logs#bound-the-interval","Bound the interval",{"_2299":574,"_22571":566,"_5":22827,"_15405":36923,"_21315":36924,"_1890":36925},[],"/docs/platform/pki/audit-logs#identify-the-operation","Identify the operation",{"_2299":575,"_22571":566,"_5":22827,"_15405":36927,"_21315":36928,"_1890":36929},[],"/docs/platform/pki/audit-logs#attribute-the-principal","Attribute the principal",{"_2299":576,"_22571":566,"_5":22827,"_15405":36931,"_21315":36932,"_1890":36933},[],"/docs/platform/pki/audit-logs#compare-intent-and-result","Compare intent and result",{"_2299":577,"_22571":566,"_5":22827,"_15405":36935,"_21315":36936,"_1890":36937},[],"/docs/platform/pki/audit-logs#follow-the-effect","Follow the effect",{"_2299":578,"_22571":566,"_5":22827,"_15405":36939,"_21315":36940,"_1890":36941},[],"/docs/platform/pki/audit-logs#periodic-verification","Periodic verification",{"_2299":579,"_22571":566,"_15405":36943,"_5":15294,"_21315":566,"_1890":36944},[],"Lamassu instruments the mutable operations of its services with audit events. Each event describes the operation, the principals that matched, the input, the result and whether it ended in error.",{"_2299":580,"_22571":566,"_15405":36946,"_5":15294,"_21315":36900,"_1890":36947},[],"The audit body includes:",{"_2299":581,"_22571":566,"_15405":36949,"_5":15294,"_21315":36900,"_1890":36950},[],"input: data received by the operation;",{"_2299":582,"_22571":566,"_15405":36952,"_5":15294,"_21315":36900,"_1890":36953},[],"has\\_error: whether the service returned an error;",{"_2299":583,"_22571":566,"_15405":36955,"_5":15294,"_21315":36900,"_1890":36956},[],"output: produced result or error message;",{"_2299":584,"_22571":566,"_15405":36958,"_5":15294,"_21315":36900,"_1890":36959},[],"principals: identifiers of the principals that matched the request.",{"_2299":585,"_22571":566,"_15405":36961,"_5":15294,"_21315":36900,"_1890":36962},[],"Successful operations use a type prefixed with audit.. Failures publish the operation type suffixed with .error. The CloudEvents event additionally adds source, identifier, date and type.",{"_2299":586,"_22571":566,"_15405":36964,"_5":15294,"_21315":36900,"_1890":36965},[],"The middlewares publish the record after executing the operation, whether it succeeded or returned an error. This lets you investigate attempts as well as confirmed changes.",{"_2299":587,"_22571":566,"_15405":36967,"_5":15294,"_21315":36904,"_1890":36968},[],"The backend applies auditing to mutations of:",{"_2299":588,"_22571":566,"_15405":36970,"_5":15294,"_21315":36904,"_1890":36971},[],"authorities, certificates and issuance profiles;",{"_2299":589,"_22571":566,"_15405":36973,"_5":15294,"_21315":36904,"_1890":36974},[],"keys and KMS engines;",{"_2299":590,"_22571":566,"_15405":36976,"_5":15294,"_21315":36904,"_1890":36977},[],"devices and identities;",{"_2299":591,"_22571":566,"_15405":36979,"_5":15294,"_21315":36904,"_1890":36980},[],"DMSs and enrollment operations;",{"_2299":592,"_22571":566,"_15405":36982,"_5":15294,"_21315":36904,"_1890":36983},[],"validation functions and CRL;",{"_2299":593,"_22571":566,"_15405":36985,"_5":15294,"_21315":36904,"_1890":36986},[],"principals, policies and authorization grants.",{"_2299":594,"_22571":566,"_15405":36988,"_5":15294,"_21315":36904,"_1890":36989},[],"Do not confuse these events with domain events. A domain event announces that a resource changed so another component can react; the audit event keeps input, output and principal context for investigation.",{"_2299":595,"_22571":566,"_15405":36991,"_5":15294,"_21315":36908,"_1890":36992},[],"Services publish audit records to the event bus when their PublisherEventBus is enabled. The backend code does not, by itself, implement a queryable, durable audit file.",{"_2299":596,"_22571":566,"_15405":36994,"_5":15294,"_21315":36908,"_1890":36995},[],"If you need retention, search, tamper protection or regulatory export, connect a consumer that persists the events into the system approved by your organization.",{"_2299":597,"_22571":566,"_15405":36997,"_5":15294,"_21315":36908,"_1890":36998},[],"Design the consumer to:",{"_2299":598,"_22571":566,"_15405":37000,"_5":15294,"_21315":36908,"_1890":37001},[],"subscribe to the audit.# types and also to operation types ending in .error;",{"_2299":599,"_22571":566,"_15405":37003,"_5":15294,"_21315":36908,"_1890":37004},[],"keep the complete CloudEvent unmodified;",{"_2299":600,"_22571":566,"_15405":37006,"_5":15294,"_21315":36908,"_1890":37007},[],"record the ingestion time and detect duplicates by ID;",{"_2299":601,"_22571":566,"_15405":37009,"_5":15294,"_21315":36908,"_1890":37010},[],"encrypt in transit and at rest;",{"_2299":602,"_22571":566,"_15405":37012,"_5":15294,"_21315":36908,"_1890":37013},[],"restrict reading and deletion to a role separate from the PKI operator;",{"_2299":603,"_22571":566,"_15405":37015,"_5":15294,"_21315":36908,"_1890":37016},[],"apply an explicit retention and legal hold policy;",{"_2299":604,"_22571":566,"_15405":37018,"_5":15294,"_21315":36908,"_1890":37019},[],"alert if it stops consuming or the pending queue grows.",{"_2299":605,"_22571":566,"_15405":37021,"_5":15294,"_21315":36912,"_1890":37022},[],"The input and output fields can contain subjects, metadata, public material, configuration or error messages. Evaluate their classification before sending them to an external platform.",{"_2299":606,"_22571":566,"_15405":37024,"_5":15294,"_21315":36912,"_1890":37025},[],"Do not log private keys, provider secrets or full tokens in automations around Lamassu. Restrict export and apply redaction at the destination without destroying the fields needed for attribution.",{"_2299":607,"_22571":566,"_15405":37027,"_5":15294,"_21315":36920,"_1890":37028},[],"Start from the reported time and normalize every source to UTC.",{"_2299":608,"_22571":566,"_15405":37030,"_5":15294,"_21315":36924,"_1890":37031},[],"Filter by event type, service source and resource identifier.",{"_2299":609,"_22571":566,"_15405":37033,"_5":15294,"_21315":36928,"_1890":37034},[],"Review principals and correlate them with the OIDC provider or the X.509 identity valid at that moment.",{"_2299":610,"_22571":566,"_15405":37036,"_5":15294,"_21315":36932,"_1890":37037},[],"Contrast input, has\\_error and output. A failed attempt does not mean the resource changed.",{"_2299":611,"_22571":566,"_15405":37039,"_5":15294,"_21315":36936,"_1890":37040},[],"Look for the domain events and service records that share resource and time window. In a CA revocation, include the cascading operations.",{"_2299":612,"_22571":566,"_15405":37042,"_5":15294,"_21315":36940,"_1890":37043},[],"Generate a controlled mutation in a test environment and check that:",{"_2299":613,"_22571":566,"_15405":37045,"_5":15294,"_21315":36940,"_1890":37046},[],"a successful audit event appears;",{"_2299":614,"_22571":566,"_15405":37048,"_5":15294,"_21315":36940,"_1890":37049},[],"the principal matches the identity used;",{"_2299":615,"_22571":566,"_15405":37051,"_5":15294,"_21315":36940,"_1890":37052},[],"the consumer persists it exactly once;",{"_2299":616,"_22571":566,"_15405":37054,"_5":15294,"_21315":36940,"_1890":37055},[],"it can be retrieved by resource, actor and period;",{"_2299":617,"_22571":566,"_15405":37057,"_5":15294,"_21315":36940,"_1890":37058},[],"a consumer outage raises an alert.",{"_2299":618,"_22571":566,"_15405":37060,"_5":15294,"_21315":36940,"_1890":37061},[],"For metrics, traces and technical logs of the deployment, see Troubleshooting. Audit answers \"who tried to change what\"; observability explains how the system behaved.",{"_2299":619,"_22571":619,"_5":10616,"_1890":37063,"_22830":37064,"_15405":37065,"_21315":619},"CA hierarchy and rotation",[35156,36291,36769],[],{"_2299":620,"_22571":619,"_15405":37067,"_5":15294,"_21315":619,"_1890":37068},[],"Design root and intermediate authorities and replace certificates or keys without breaking trust.",{"_2299":621,"_22571":619,"_5":22827,"_15405":37070,"_21315":37071,"_1890":37072},[],"/docs/platform/pki/ca-hierarchy-and-rotation#design-the-hierarchy","Design the hierarchy",{"_2299":622,"_22571":619,"_5":22827,"_15405":37074,"_21315":37075,"_1890":37076},[],"/docs/platform/pki/ca-hierarchy-and-rotation#reissuance-and-rotation-are-not-the-same","Reissuance and rotation are not the same",{"_2299":623,"_22571":619,"_5":22827,"_15405":37078,"_21315":37079,"_1890":37080},[],"/docs/platform/pki/ca-hierarchy-and-rotation#when-to-choose-each-operation","When to choose each operation",{"_2299":624,"_22571":619,"_5":22827,"_15405":37082,"_21315":37083,"_1890":37084},[],"/docs/platform/pki/ca-hierarchy-and-rotation#key-rotation-procedure","Key rotation procedure",{"_2299":625,"_22571":619,"_5":22827,"_15405":37086,"_21315":37087,"_1890":37088},[],"/docs/platform/pki/ca-hierarchy-and-rotation#inventory-the-dependencies","Inventory the dependencies",{"_2299":626,"_22571":619,"_5":22827,"_15405":37090,"_21315":37091,"_1890":37092},[],"/docs/platform/pki/ca-hierarchy-and-rotation#create-the-successor-ca","Create the successor CA",{"_2299":627,"_22571":619,"_5":22827,"_15405":37094,"_21315":37095,"_1890":37096},[],"/docs/platform/pki/ca-hierarchy-and-rotation#distribute-the-new-trust","Distribute the new trust",{"_2299":628,"_22571":619,"_5":22827,"_15405":37098,"_21315":37099,"_1890":37100},[],"/docs/platform/pki/ca-hierarchy-and-rotation#switch-issuance","Switch issuance",{"_2299":629,"_22571":619,"_5":22827,"_15405":37102,"_21315":37103,"_1890":37104},[],"/docs/platform/pki/ca-hierarchy-and-rotation#renew-in-batches","Renew in batches",{"_2299":630,"_22571":619,"_5":22827,"_15405":37106,"_21315":37107,"_1890":37108},[],"/docs/platform/pki/ca-hierarchy-and-rotation#close-the-overlap","Close the overlap",{"_2299":631,"_22571":619,"_5":22827,"_15405":37110,"_21315":37111,"_1890":37112},[],"/docs/platform/pki/ca-hierarchy-and-rotation#cascading-revocation","Cascading revocation",{"_2299":632,"_22571":619,"_5":22827,"_15405":37114,"_21315":37115,"_1890":37116},[],"/docs/platform/pki/ca-hierarchy-and-rotation#checks-after-the-change","Checks after the change",{"_2299":633,"_22571":619,"_15405":37118,"_5":15294,"_21315":619,"_1890":37119},[],"The hierarchy determines the blast radius of any error or compromise. A root signs intermediate CAs; intermediates issue the identities used by devices and services. This separation lets you isolate environments and rotate a branch without replacing all trust.",{"_2299":634,"_22571":619,"_15405":37121,"_5":15294,"_21315":37071,"_1890":37122},[],"For a production installation, use a very restricted root and one or more operational intermediates. Separate intermediates when any of these boundaries change:",{"_2299":635,"_22571":619,"_15405":37124,"_5":15294,"_21315":37071,"_1890":37125},[],"environment, such as production and preproduction;",{"_2299":636,"_22571":619,"_15405":37127,"_5":15294,"_21315":37071,"_1890":37128},[],"owner or operating team;",{"_2299":637,"_22571":619,"_15405":37130,"_5":15294,"_21315":37071,"_1890":37131},[],"device family or manufacturing process;",{"_2299":638,"_22571":619,"_15405":37133,"_5":15294,"_21315":37071,"_1890":37134},[],"region or regulatory requirement;",{"_2299":639,"_22571":619,"_15405":37136,"_5":15294,"_21315":37071,"_1890":37137},[],"cryptographic engine or key policy;",{"_2299":640,"_22571":619,"_15405":37139,"_5":15294,"_21315":37071,"_1890":37140},[],"maintenance window and renewal cadence.",{"_2299":641,"_22571":619,"_15405":37142,"_5":15294,"_21315":37071,"_1890":37143},[],"Avoid deep hierarchies without a concrete need. Each level adds chain distribution, validation and one more certificate you must renew.",{"_2299":642,"_22571":619,"_15405":37145,"_5":15294,"_21315":37071,"_1890":37146},[],"A child CA and its end-entity certificates must expire before their issuer. Reserve a margin that allows distributing another chain and renewing dependent certificates.",{"_2299":643,"_22571":619,"_15405":37148,"_5":15294,"_21315":37075,"_1890":37149},[],"**Reissuing a CA** creates a new certificate over the existing key. Lamassu generates a CSR with that key, self-signs it if it is a root or asks the parent CA to sign it if it is subordinate. The new certificate becomes active and the CA points to its serial number; the old and new certificates are linked through metadata.",{"_2299":644,"_22571":619,"_15405":37151,"_5":15294,"_21315":37075,"_1890":37152},[],"**Rotating a CA** creates a successor key and authority. It is the right choice in the face of compromise, a cryptographic change, an engine migration or non-exportable key policies.",{"_2299":645,"_22571":619,"_15405":37154,"_5":15294,"_21315":37075,"_1890":37155},[],"Lamassu does not allow reissuing an already-revoked CA or a CA whose expiration date has passed. Plan ahead for both conditions.",{"_2299":646,"_22571":619,"_15405":37157,"_5":15294,"_21315":37079,"_1890":37158},[],"Reissue if the key is still trustworthy and you only need another validity period or an updated certificate.",{"_2299":647,"_22571":619,"_15405":37160,"_5":15294,"_21315":37079,"_1890":37161},[],"Rotate the key if compromise is suspected, the algorithm changes or you want to move custody to another engine.",{"_2299":648,"_22571":619,"_15405":37163,"_5":15294,"_21315":37079,"_1890":37164},[],"Create a parallel branch if you cannot update all consumers at the same time.",{"_2299":649,"_22571":619,"_15405":37166,"_5":15294,"_21315":37079,"_1890":37167},[],"Revoke immediately only when the risk of keeping the CA outweighs the impact of interrupting the fleet.",{"_2299":650,"_22571":619,"_15405":37169,"_5":15294,"_21315":37087,"_1890":37170},[],"Locate child CAs, issued certificates, DMSs, connectors and external trust stores. Include devices that may stay offline for weeks or months.",{"_2299":651,"_22571":619,"_15405":37172,"_5":15294,"_21315":37091,"_1890":37173},[],"Generate a new key in the planned engine, create the CA and assign it an explicit profile. Do not reuse the operational identifier to hide that it is a different generation.",{"_2299":652,"_22571":619,"_15405":37175,"_5":15294,"_21315":37095,"_1890":37176},[],"Add the new root or chain to consumers before issuing with it. In a DMS, use the managed CAs of `/cacerts` to temporarily keep both the old and new chains.",{"_2299":653,"_22571":619,"_15405":37178,"_5":15294,"_21315":37099,"_1890":37179},[],"Update the enrollment CA and profile of the DMSs. Keep the additional validation CAs if old certificates still need to be accepted during re-enrollment.",{"_2299":654,"_22571":619,"_15405":37181,"_5":15294,"_21315":37103,"_1890":37182},[],"Migrate a small cohort, validate mTLS, OCSP and CRL from the consumer and expand progressively. Monitor which devices still present the old chain.",{"_2299":655,"_22571":619,"_15405":37184,"_5":15294,"_21315":37107,"_1890":37185},[],"Once no legitimate consumer depends on the previous authority, remove it from issuance and from the distributed CAs. Revoke it if policy requires it.",{"_2299":656,"_22571":619,"_15405":37187,"_5":15294,"_21315":37111,"_1890":37188},[],"When you revoke a CA, Lamassu also updates its child CAs and issued certificates to `REVOKED` with the reason `CessationOfOperation`. The children's revocations propagate the effect to their own branches.",{"_2299":657,"_22571":619,"_15405":37190,"_5":15294,"_21315":37111,"_1890":37191},[],"This protects the coherence of the hierarchy, but it makes revocation a high-impact action. Do not use it as the ordinary mechanism to stop issuing: first complete the migration and remove the CA from operational flows.",{"_2299":658,"_22571":619,"_15405":37193,"_5":15294,"_21315":37115,"_1890":37194},[],"The new chain ends in an anchor installed by the consumer.",{"_2299":659,"_22571":619,"_15405":37196,"_5":15294,"_21315":37115,"_1890":37197},[],"New certificates contain the expected AKI, SKI, KU, EKU and SAN.",{"_2299":660,"_22571":619,"_15405":37199,"_5":15294,"_21315":37115,"_1890":37200},[],"The DMS delivers the correct chain through EST `/cacerts`.",{"_2299":661,"_22571":619,"_15405":37202,"_5":15294,"_21315":37115,"_1890":37203},[],"Re-enrollment accepts the old identity during the planned period.",{"_2299":662,"_22571":619,"_15405":37205,"_5":15294,"_21315":37115,"_1890":37206},[],"OCSP and CRL respond for the authorities that remain active.",{"_2299":663,"_22571":619,"_15405":37208,"_5":15294,"_21315":37115,"_1890":37209},[],"No DMS is left accidentally issuing from the old CA.",{"_2299":664,"_22571":619,"_15405":37211,"_5":15294,"_21315":37115,"_1890":37212},[],"See the Trust model to understand the DMS's CA sets and Certificate lifecycle for states and revocation effects.",{"_2299":665,"_22571":665,"_5":10616,"_1890":37214,"_22830":37215,"_15405":37216,"_21315":665},"Certification authorities",[35156,36291,36769],[],{"_2299":666,"_22571":665,"_15405":37218,"_5":15294,"_21315":665,"_1890":37219},[],"Create, import and operate the authorities that establish your PKI's trust.",{"_2299":667,"_22571":665,"_5":22827,"_15405":37221,"_21315":37222,"_1890":37223},[],"/docs/platform/pki/certificate-authorities#choose-a-flow","Choose a flow",{"_2299":668,"_22571":665,"_5":22827,"_15405":37225,"_21315":37226,"_1890":37227},[],"/docs/platform/pki/certificate-authorities#create-a-new-authority","Create a new authority",{"_2299":669,"_22571":665,"_5":22827,"_15405":37229,"_21315":37230,"_1890":35166},[],"/docs/platform/pki/certificate-authorities#before-you-begin",{"_2299":670,"_22571":665,"_5":22827,"_15405":37232,"_21315":37233,"_1890":37234},[],"/docs/platform/pki/certificate-authorities#open-the-wizard","Open the wizard",{"_2299":671,"_22571":665,"_5":22827,"_15405":37236,"_21315":37237,"_1890":37238},[],"/docs/platform/pki/certificate-authorities#configure-the-key","Configure the key",{"_2299":672,"_22571":665,"_5":22827,"_15405":37240,"_21315":37241,"_1890":37242},[],"/docs/platform/pki/certificate-authorities#choose-the-ca-type","Choose the CA type",{"_2299":673,"_22571":665,"_5":22827,"_15405":37244,"_21315":37245,"_1890":37246},[],"/docs/platform/pki/certificate-authorities#define-the-identity","Define the identity",{"_2299":674,"_22571":665,"_5":22827,"_15405":37248,"_21315":37249,"_1890":37250},[],"/docs/platform/pki/certificate-authorities#configure-validity-and-uses","Configure validity and uses",{"_2299":675,"_22571":665,"_5":22827,"_15405":37252,"_21315":37253,"_1890":37254},[],"/docs/platform/pki/certificate-authorities#create-and-verify","Create and verify",{"_2299":676,"_22571":665,"_5":22827,"_15405":37256,"_21315":37257,"_1890":37258},[],"/docs/platform/pki/certificate-authorities#use-a-key-from-the-kms","Use a key from the KMS",{"_2299":677,"_22571":665,"_5":22827,"_15405":37260,"_21315":37261,"_1890":37262},[],"/docs/platform/pki/certificate-authorities#import-an-external-ca","Import an external CA",{"_2299":678,"_22571":665,"_5":22827,"_15405":37264,"_21315":37265,"_1890":37266},[],"/docs/platform/pki/certificate-authorities#select-the-engine","Select the engine",{"_2299":679,"_22571":665,"_5":22827,"_15405":37268,"_21315":37269,"_1890":37270},[],"/docs/platform/pki/certificate-authorities#load-the-material","Load the material",{"_2299":680,"_22571":665,"_5":22827,"_15405":37272,"_21315":37273,"_1890":37274},[],"/docs/platform/pki/certificate-authorities#define-the-default-issuance","Define the default issuance",{"_2299":681,"_22571":665,"_5":22827,"_15405":37276,"_21315":37277,"_1890":37278},[],"/docs/platform/pki/certificate-authorities#verify-the-import","Verify the import",{"_2299":682,"_22571":665,"_5":22827,"_15405":37280,"_21315":37281,"_1890":37282},[],"/docs/platform/pki/certificate-authorities#inspect-an-authority","Inspect an authority",{"_2299":683,"_22571":665,"_5":22827,"_15405":37284,"_21315":37285,"_1890":37286},[],"/docs/platform/pki/certificate-authorities#issue-certificates","Issue certificates",{"_2299":684,"_22571":665,"_5":22827,"_15405":37288,"_21315":37289,"_1890":37290},[],"/docs/platform/pki/certificate-authorities#revoke-a-ca","Revoke a CA",{"_2299":685,"_22571":665,"_5":22827,"_15405":37292,"_21315":37293,"_1890":37294},[],"/docs/platform/pki/certificate-authorities#assess-the-impact","Assess the impact",{"_2299":686,"_22571":665,"_5":22827,"_15405":37296,"_21315":37297,"_1890":37298},[],"/docs/platform/pki/certificate-authorities#start-the-revocation","Start the revocation",{"_2299":687,"_22571":665,"_5":22827,"_15405":37300,"_21315":37301,"_1890":37302},[],"/docs/platform/pki/certificate-authorities#confirm-the-identity","Confirm the identity",{"_2299":688,"_22571":665,"_5":22827,"_15405":37304,"_21315":37305,"_1890":37306},[],"/docs/platform/pki/certificate-authorities#check-the-publication","Check the publication",{"_2299":689,"_22571":665,"_15405":37308,"_5":15294,"_21315":665,"_1890":37309},[],"A certification authority (CA) binds identities to public keys through signed certificates. In Lamassu you can create a new hierarchy, use a key already in the KMS or incorporate an external CA.",{"_2299":690,"_22571":665,"_15405":37311,"_5":15294,"_21315":665,"_1890":37312},[],"To design a full chain or replace an authority in production, see CA hierarchy and rotation. If you need to standardize what each authority can sign, use Certificate profiles.",{"_2299":691,"_22571":665,"_15405":37314,"_5":15294,"_21315":37222,"_1890":37315},[],"**New CA with a new key:** create a root of trust from scratch. Lamassu generates and keeps the key pair.",{"_2299":692,"_22571":665,"_15405":37317,"_5":15294,"_21315":37222,"_1890":37318},[],"**New CA from the KMS:** reuse a key already registered in the platform.",{"_2299":693,"_22571":665,"_15405":37320,"_5":15294,"_21315":37222,"_1890":37321},[],"**Import a CA with its private key:** incorporate an external authority that Lamassu can issue with.",{"_2299":694,"_22571":665,"_15405":37323,"_5":15294,"_21315":37222,"_1890":37324},[],"**Import only the certificate:** add an authority for building chains and validating, but not for issuing.",{"_2299":695,"_22571":665,"_15405":37326,"_5":15294,"_21315":37222,"_1890":37327},[],"First time here? Follow Create your first CA to complete the minimal journey.",{"_2299":696,"_22571":665,"_15405":37329,"_5":15294,"_21315":37230,"_1890":37330},[],"Decide whether the CA will be a root or an intermediate.",{"_2299":697,"_22571":665,"_15405":37332,"_5":15294,"_21315":37230,"_1890":37333},[],"Choose the engine that will keep the key.",{"_2299":698,"_22571":665,"_15405":37335,"_5":15294,"_21315":37230,"_1890":37336},[],"Define a validity longer than that of the certificates it will issue.",{"_2299":699,"_22571":665,"_15405":37338,"_5":15294,"_21315":37230,"_1890":37339},[],"For an intermediate CA, make sure the parent CA is active.",{"_2299":700,"_22571":665,"_15405":37341,"_5":15294,"_21315":37233,"_1890":37342},[],"In **Certification Authorities**, select **Create New CA** and choose to generate a new key pair.",{"_2299":701,"_22571":665,"_15405":37344,"_5":15294,"_21315":37237,"_1890":37345},[],"Select the cryptographic engine, the algorithm and the size or curve. Lamassu supports RSA and EC keys according to the engine's capabilities.",{"_2299":702,"_22571":665,"_15405":37347,"_5":15294,"_21315":37237,"_1890":37348},[],"For RSA you can choose 1024, 2048, 3072 or 4096 bits. For EC, the P-256, P-384 and P-521 curves are available.",{"_2299":703,"_22571":665,"_15405":37350,"_5":15294,"_21315":37241,"_1890":37351},[],"Select **Root CA** for a self-signed authority or **Intermediate CA** for an authority signed by another CA. In the latter case, choose the issuing CA.",{"_2299":704,"_22571":665,"_15405":37353,"_5":15294,"_21315":37245,"_1890":37354},[],"Enter a unique **CA Name**. This name becomes the certificate's `Common Name`. Complete the Distinguished Name fields your policy requires:",{"_2299":705,"_22571":665,"_15405":37356,"_5":15294,"_21315":37245,"_1890":37357},[],"`C`: two-letter ISO 3166-1 country code.",{"_2299":706,"_22571":665,"_15405":37359,"_5":15294,"_21315":37245,"_1890":37360},[],"`ST`: state or province.",{"_2299":707,"_22571":665,"_15405":37362,"_5":15294,"_21315":37245,"_1890":37363},[],"`L`: locality.",{"_2299":708,"_22571":665,"_15405":37365,"_5":15294,"_21315":37245,"_1890":37366},[],"`O`: organization.",{"_2299":709,"_22571":665,"_15405":37368,"_5":15294,"_21315":37245,"_1890":37369},[],"`OU`: organizational unit.",{"_2299":710,"_22571":665,"_15405":37371,"_5":15294,"_21315":37245,"_1890":37372},[],"The CA's internal identifier is generated automatically and cannot be changed.",{"_2299":711,"_22571":665,"_15405":37374,"_5":15294,"_21315":37249,"_1890":37375},[],"Define **CA Certificate Expiration** and **Default End-Entity Certificate Issuance Expiration**. You can express a duration (`5y 8w 4d`), pick a date or use the maximum allowed date.",{"_2299":712,"_22571":665,"_15405":37377,"_5":15294,"_21315":37249,"_1890":37378},[],"Select an existing issuance profile or configure the `Key Usage` and `Extended Key Usage` in the form. If you don't choose a profile, Lamassu applies the default basic usages.",{"_2299":713,"_22571":665,"_15405":37380,"_5":15294,"_21315":37253,"_1890":37381},[],"Confirm the form. The CA should appear in the inventory with its PEM certificate, status, expiration date and list of issued certificates.",{"_2299":714,"_22571":665,"_15405":37383,"_5":15294,"_21315":37253,"_1890":37384},[],"A CA cannot issue certificates that outlive its own expiration date. Leave enough margin to renew or replace the authority without interrupting consumers.",{"_2299":715,"_22571":665,"_15405":37386,"_5":15294,"_21315":37257,"_1890":37387},[],"Select &#x2A;*Create New CA (Existing Key)** when the key is already registered in Lamassu. The wizard first asks for the backing key and then shows the same configuration of type, identity, validity and profile.",{"_2299":716,"_22571":665,"_15405":37389,"_5":15294,"_21315":37257,"_1890":37390},[],"This flow is useful when the key was previously created in an HSM, imported through BYOK or must be reused under a specific custody policy.",{"_2299":717,"_22571":665,"_15405":37392,"_5":15294,"_21315":37261,"_1890":37393},[],"Importing preserves an authority created outside Lamassu.",{"_2299":718,"_22571":665,"_15405":37395,"_5":15294,"_21315":37265,"_1890":37396},[],"Choose the engine that will keep the imported key.",{"_2299":719,"_22571":665,"_15405":37398,"_5":15294,"_21315":37269,"_1890":37399},[],"Provide the CA certificate and the private key in PEM format. For a subordinate CA, optionally add the validation chain.",{"_2299":720,"_22571":665,"_15405":37401,"_5":15294,"_21315":37273,"_1890":37402},[],"Configure the validity that end-entity certificates will receive when a request does not specify another duration.",{"_2299":721,"_22571":665,"_15405":37404,"_5":15294,"_21315":37277,"_1890":37405},[],"Lamassu checks that the certificate belongs to a CA and that the material is coherent before registering it.",{"_2299":722,"_22571":665,"_15405":37407,"_5":15294,"_21315":37277,"_1890":37408},[],"If you don't have the private key, import only the certificate. The authority can take part in chains of trust and validation processes, but it cannot issue certificates from Lamassu.",{"_2299":723,"_22571":665,"_15405":37410,"_5":15294,"_21315":37281,"_1890":37411},[],"Open a CA from the inventory to review:",{"_2299":724,"_22571":665,"_15405":37413,"_5":15294,"_21315":37281,"_1890":37414},[],"Status and validity period.",{"_2299":725,"_22571":665,"_15405":37416,"_5":15294,"_21315":37281,"_1890":37417},[],"Certificate and chain in PEM format.",{"_2299":726,"_22571":665,"_15405":37419,"_5":15294,"_21315":37281,"_1890":37420},[],"Number of active, expired and revoked certificates.",{"_2299":727,"_22571":665,"_15405":37422,"_5":15294,"_21315":37281,"_1890":37423},[],"Certificates issued in **Issued Certificates**.",{"_2299":728,"_22571":665,"_15405":37425,"_5":15294,"_21315":37281,"_1890":37426},[],"The CRL linked to the authority.",{"_2299":729,"_22571":665,"_15405":37428,"_5":15294,"_21315":37281,"_1890":37429},[],"Metadata and the associated cryptographic engine.",{"_2299":730,"_22571":665,"_15405":37431,"_5":15294,"_21315":37281,"_1890":37432},[],"You can filter the inventory by name, status and CA type.",{"_2299":731,"_22571":665,"_15405":37434,"_5":15294,"_21315":37285,"_1890":37435},[],"You can start an issuance from **Issued Certificates**, from a CA's action menu or from the global certificate inventory.",{"_2299":732,"_22571":665,"_15405":37437,"_5":15294,"_21315":37285,"_1890":37438},[],"**Generate Key & CSR in Browser** is useful for a manual operation or a quick test. The browser generates the key and you must download it at the end.",{"_2299":733,"_22571":665,"_15405":37440,"_5":15294,"_21315":37285,"_1890":37441},[],"**Upload Existing CSR** is the right option when the key must remain on the target system. Lamassu receives the request but never the private key.",{"_2299":734,"_22571":665,"_15405":37443,"_5":15294,"_21315":37285,"_1890":37444},[],"Follow Issue your first certificate for the guided flow. Certificate management explains the inventory, inspection and revocation.",{"_2299":735,"_22571":665,"_15405":37446,"_5":15294,"_21315":37289,"_1890":37447},[],"Revoking a CA invalidates trust in the certificates it issued and can interrupt devices and services. The action is irreversible.",{"_2299":736,"_22571":665,"_15405":37449,"_5":15294,"_21315":37293,"_1890":37450},[],"Identify the certificates, devices and consumers that depend on the CA. Prepare a replacement authority and chain when necessary.",{"_2299":737,"_22571":665,"_15405":37452,"_5":15294,"_21315":37297,"_1890":37453},[],"Open the authority and select **Revoke CA**. Choose the reason that describes the incident, for example `KeyCompromise`, `CACompromise`, `Superseded` or `CessationOfOperation`.",{"_2299":738,"_22571":665,"_15405":37455,"_5":15294,"_21315":37301,"_1890":37456},[],"Type the CA's name exactly to enable **Confirm Revocation**.",{"_2299":739,"_22571":665,"_15405":37458,"_5":15294,"_21315":37305,"_1890":37459},[],"The status should change to **REVOKED** and the CRL should reflect the new information. The CA can no longer issue certificates.",{"_2299":740,"_22571":665,"_15405":37461,"_5":15294,"_21315":37305,"_1890":37462},[],"Permanent deletion is only available after revoking. Delete the record only when your retention and audit policy allows it.",{"_2299":741,"_22571":741,"_5":10616,"_1890":37464,"_22830":37465,"_15405":37466,"_21315":741},"Certificate profiles",[35156,36291,36769],[],{"_2299":742,"_22571":741,"_15405":37468,"_5":15294,"_21315":741,"_1890":37469},[],"Define reusable policies to issue consistent certificates and constrain accepted keys.",{"_2299":743,"_22571":741,"_5":22827,"_15405":37471,"_21315":37472,"_1890":37473},[],"/docs/platform/pki/certificate-profiles#what-a-profile-controls","What a profile controls",{"_2299":744,"_22571":741,"_5":22827,"_15405":37475,"_21315":37476,"_1890":37477},[],"/docs/platform/pki/certificate-profiles#validity","Validity",{"_2299":745,"_22571":741,"_5":22827,"_15405":37479,"_21315":37480,"_1890":37481},[],"/docs/platform/pki/certificate-profiles#ca-certificate-or-end-entity-certificate","CA certificate or end-entity certificate",{"_2299":746,"_22571":741,"_5":22827,"_15405":37483,"_21315":37484,"_1890":37485},[],"/docs/platform/pki/certificate-profiles#key-usage-and-extended-key-usage","Key Usage and Extended Key Usage",{"_2299":747,"_22571":741,"_5":22827,"_15405":37487,"_21315":37488,"_1890":37489},[],"/docs/platform/pki/certificate-profiles#subject","Subject",{"_2299":748,"_22571":741,"_5":22827,"_15405":37491,"_21315":37492,"_1890":37493},[],"/docs/platform/pki/certificate-profiles#csr-extensions","CSR extensions",{"_2299":749,"_22571":741,"_5":22827,"_15405":37495,"_21315":37496,"_1890":37497},[],"/docs/platform/pki/certificate-profiles#cryptographic-constraints","Cryptographic constraints",{"_2299":750,"_22571":741,"_5":22827,"_15405":37499,"_21315":37500,"_1890":37501},[],"/docs/platform/pki/certificate-profiles#profile-precedence","Profile precedence",{"_2299":751,"_22571":741,"_5":22827,"_15405":37503,"_21315":37504,"_1890":37505},[],"/docs/platform/pki/certificate-profiles#create-a-profile","Create a profile",{"_2299":752,"_22571":741,"_5":22827,"_15405":37507,"_21315":37508,"_1890":37509},[],"/docs/platform/pki/certificate-profiles#define-a-single-purpose","Define a single purpose",{"_2299":753,"_22571":741,"_5":22827,"_15405":37511,"_21315":37512,"_1890":37513},[],"/docs/platform/pki/certificate-profiles#choose-the-validity","Choose the validity",{"_2299":754,"_22571":741,"_5":22827,"_15405":37515,"_21315":37516,"_1890":37517},[],"/docs/platform/pki/certificate-profiles#fix-usages-and-subject","Fix usages and subject",{"_2299":755,"_22571":741,"_5":22827,"_15405":37519,"_21315":37520,"_1890":37521},[],"/docs/platform/pki/certificate-profiles#constrain-the-keys","Constrain the keys",{"_2299":756,"_22571":741,"_5":22827,"_15405":37523,"_21315":37524,"_1890":37525},[],"/docs/platform/pki/certificate-profiles#attach-it-and-test","Attach it and test",{"_2299":757,"_22571":741,"_5":22827,"_15405":37527,"_21315":37528,"_1890":37529},[],"/docs/platform/pki/certificate-profiles#design-examples","Design examples",{"_2299":758,"_22571":741,"_5":22827,"_15405":37531,"_21315":37532,"_1890":37533},[],"/docs/platform/pki/certificate-profiles#changes-and-deletion","Changes and deletion",{"_2299":759,"_22571":741,"_15405":37535,"_5":15294,"_21315":741,"_1890":37536},[],"An issuance profile turns a certificate policy into reusable configuration. Instead of deciding validity, subject, extensions and algorithms on every request, you define once what is allowed and attach the profile to a CA, a DMS or a specific issuance.",{"_2299":760,"_22571":741,"_15405":37538,"_5":15294,"_21315":37476,"_1890":37539},[],"You can express the lifetime as a duration from the moment of issuance or as a fixed end date. A duration works well for recurring identities; a common date is useful to make a whole batch end before a migration or retirement.",{"_2299":761,"_22571":741,"_15405":37541,"_5":15294,"_21315":37476,"_1890":37542},[],"The end date must never outlive the issuing CA.",{"_2299":762,"_22571":741,"_15405":37544,"_5":15294,"_21315":37480,"_1890":37545},[],"`Sign as CA` sets `IsCA` and the basic constraints needed for an authority. Enable it only in profiles intended to create or reissue subordinate CAs.",{"_2299":763,"_22571":741,"_15405":37547,"_5":15294,"_21315":37484,"_1890":37548},[],"The profile can enforce usages such as `DigitalSignature`, `KeyEncipherment`, `CertSign`, `CRLSign`, `ClientAuth`, `ServerAuth` or `OCSPSigning`.",{"_2299":764,"_22571":741,"_15405":37550,"_5":15294,"_21315":37484,"_1890":37551},[],"If you enable **Honor Key Usage** or **Honor Extended Key Usages**, Lamassu keeps the values requested by the CSR. If you disable them, it replaces them with the ones defined in the profile.",{"_2299":765,"_22571":741,"_15405":37553,"_5":15294,"_21315":37484,"_1890":37554},[],"Do not enable the `Honor…` options for untrusted requests unless another component validates those fields. Otherwise, the requester may choose broader capabilities than intended.",{"_2299":766,"_22571":741,"_15405":37556,"_5":15294,"_21315":37488,"_1890":37557},[],"With **Honor Subject**, the certificate keeps the subject of the CSR. Without that option, Lamassu applies the profile's `CN`, `O`, `OU`, `C`, `ST` and `L`. If the profile does not define a `Common Name`, the requested CN is kept.",{"_2299":767,"_22571":741,"_15405":37559,"_5":15294,"_21315":37492,"_1890":37560},[],"With **Honor Extensions**, Lamassu filters the additional requested extensions and keeps only SAN. Without that option, it discards the CSR's additional extensions.",{"_2299":768,"_22571":741,"_15405":37562,"_5":15294,"_21315":37492,"_1890":37563},[],"This behavior allows accepting DNS, IP, email or URI as alternative identities without accepting arbitrary extensions.",{"_2299":769,"_22571":741,"_15405":37565,"_5":15294,"_21315":37496,"_1890":37566},[],"The cryptographic enforcement can:",{"_2299":770,"_22571":741,"_15405":37568,"_5":15294,"_21315":37496,"_1890":37569},[],"allow or block RSA keys;",{"_2299":771,"_22571":741,"_15405":37571,"_5":15294,"_21315":37496,"_1890":37572},[],"limit the supported RSA sizes;",{"_2299":772,"_22571":741,"_15405":37574,"_5":15294,"_21315":37496,"_1890":37575},[],"allow or block ECDSA keys;",{"_2299":773,"_22571":741,"_15405":37577,"_5":15294,"_21315":37496,"_1890":37578},[],"limit the supported ECDSA sizes or curves.",{"_2299":774,"_22571":741,"_15405":37580,"_5":15294,"_21315":37496,"_1890":37581},[],"When it is enabled, Lamassu checks the public key before creating a CA or signing a CSR. A key whose type or size is not listed in the profile is rejected.",{"_2299":775,"_22571":741,"_15405":37583,"_5":15294,"_21315":37500,"_1890":37584},[],"In operations that accept multiple sources, Lamassu resolves the profile in this order:",{"_2299":776,"_22571":741,"_15405":37586,"_5":15294,"_21315":37500,"_1890":37587},[],"The profile sent within the operation.",{"_2299":777,"_22571":741,"_15405":37589,"_5":15294,"_21315":37500,"_1890":37590},[],"The profile identifier sent in the operation.",{"_2299":778,"_22571":741,"_15405":37592,"_5":15294,"_21315":37500,"_1890":37593},[],"The default profile associated with the CA.",{"_2299":779,"_22571":741,"_15405":37595,"_5":15294,"_21315":37500,"_1890":37596},[],"A DMS can also reference its own issuance profile. This way, several fleets can use the same CA with different policies.",{"_2299":780,"_22571":741,"_15405":37598,"_5":15294,"_21315":37508,"_1890":37599},[],"Separate, for example, mTLS devices, servers and intermediate CAs. A small, specific profile is easier to review than one that allows every use.",{"_2299":781,"_22571":741,"_15405":37601,"_5":15294,"_21315":37512,"_1890":37602},[],"Align the duration with the fleet's real renewal capacity. Leave margin against the CA's expiration.",{"_2299":782,"_22571":741,"_15405":37604,"_5":15294,"_21315":37516,"_1890":37605},[],"For a device that authenticates as a client, the usual starting point is `DigitalSignature` and `ClientAuth`. Add `ServerAuth` or `KeyEncipherment` only if the protocol needs it.",{"_2299":783,"_22571":741,"_15405":37607,"_5":15294,"_21315":37520,"_1890":37608},[],"Enable cryptographic enforcement and list only algorithms and sizes compatible with your policy and your devices.",{"_2299":784,"_22571":741,"_15405":37610,"_5":15294,"_21315":37524,"_1890":37611},[],"Attach the profile to a CA or DMS. Issue a test certificate and check subject, SAN, KU, EKU, basic constraints and dates with an independent X.509 tool.",{"_2299":785,"_22571":741,"_15405":37613,"_5":15294,"_21315":37528,"_1890":37614},[],"**mTLS device**\\\nEnd-entity certificate, short validity, `DigitalSignature`, `ClientAuth`, subject controlled by the DMS and SAN allowed when it identifies the device.",{"_2299":786,"_22571":741,"_15405":37616,"_5":15294,"_21315":37528,"_1890":37617},[],"**TLS server**\\\nEnd-entity certificate, `DigitalSignature`, `ServerAuth` and mandatory SAN with the names clients will use.",{"_2299":787,"_22571":741,"_15405":37619,"_5":15294,"_21315":37528,"_1890":37620},[],"**Intermediate CA**\\\n`Sign as CA`, `CertSign` and `CRLSign`, validity longer than its end-entity certificates and stricter cryptographic constraints.",{"_2299":788,"_22571":741,"_15405":37622,"_5":15294,"_21315":37528,"_1890":37623},[],"These are starting patterns, not a universal policy. Always verify the requirements of the protocol, the consumer and the applicable regulatory framework.",{"_2299":789,"_22571":741,"_15405":37625,"_5":15294,"_21315":37532,"_1890":37626},[],"Updating a profile affects future issuances; it does not modify already-signed certificates. Test changes before applying them to a CA in production and keep the operational justification.",{"_2299":790,"_22571":741,"_15405":37628,"_5":15294,"_21315":37532,"_1890":37629},[],"Before deleting a profile, check that no CA or DMS depends on it. If you want to replace it, create the new version, update the references and perform a test issuance before retiring the old one.",{"_2299":791,"_22571":791,"_5":10616,"_1890":37631,"_22830":37632,"_15405":37633,"_21315":791},"Certificate validation",[35156,36291,36769],[],{"_2299":792,"_22571":791,"_15405":37635,"_5":15294,"_21315":791,"_1890":37636},[],"Publish the status of identities through OCSP and CRL.",{"_2299":793,"_22571":791,"_5":22827,"_15405":37638,"_21315":37639,"_1890":37640},[],"/docs/platform/pki/certificate-validation#choose-a-mechanism","Choose a mechanism",{"_2299":794,"_22571":791,"_15405":37642,"_5":15294,"_21315":791,"_1890":37643},[],"Issuance proves who signed a certificate; validation tells you whether it should still be accepted. Lamassu publishes status through two complementary mechanisms.",{"_2299":795,"_22571":791,"_15405":37645,"_5":15294,"_21315":37639,"_1890":37646},[],"Use **OCSP** when the consumer is online and needs to check the latest status of a specific certificate.",{"_2299":796,"_22571":791,"_15405":37648,"_5":15294,"_21315":37639,"_1890":37649},[],"Use a **CRL** when validation must happen locally, offline or over a high volume of certificates. The consumer periodically downloads a signed list and keeps it until the next update.",{"_2299":797,"_22571":791,"_15405":37651,"_5":15294,"_21315":37639,"_1890":37652},[],"Many environments use both: OCSP as the primary check and a CRL as the local or fallback mechanism.",{"_2299":798,"_22571":791,"_15405":37654,"_5":15294,"_21315":37639,"_1890":37655},[],"<Card title=\"Online validation with OCSP\" description=\"Query Good, Revoked and Unknown statuses in real time.\" href=\"/docs/platform/pki/ocsp\" />",{"_2299":799,"_22571":791,"_15405":37657,"_5":15294,"_21315":37639,"_1890":37658},[],"<Card title=\"Revocation lists\" description=\"Generate, publish and distribute CRLs per authority.\" href=\"/docs/platform/pki/crl\" />",{"_2299":800,"_22571":800,"_5":10616,"_1890":37660,"_22830":37661,"_15405":37662,"_21315":800},"Certificates",[35156,36291,36769],[],{"_2299":801,"_22571":800,"_15405":37664,"_5":15294,"_21315":800,"_1890":37665},[],"Inspect, download and revoke the certificates issued by Lamassu.",{"_2299":802,"_22571":800,"_5":22827,"_15405":37667,"_21315":37668,"_1890":37669},[],"/docs/platform/pki/certificates#find-a-certificate","Find a certificate",{"_2299":803,"_22571":800,"_5":22827,"_15405":37671,"_21315":37672,"_1890":37673},[],"/docs/platform/pki/certificates#download-the-certificate","Download the certificate",{"_2299":804,"_22571":800,"_5":22827,"_15405":37675,"_21315":37676,"_1890":37677},[],"/docs/platform/pki/certificates#revoke-a-certificate","Revoke a certificate",{"_2299":805,"_22571":800,"_5":22827,"_15405":37679,"_21315":37680,"_1890":37681},[],"/docs/platform/pki/certificates#open-the-action","Open the action",{"_2299":806,"_22571":800,"_5":22827,"_15405":37683,"_21315":37684,"_1890":37685},[],"/docs/platform/pki/certificates#choose-a-reason","Choose a reason",{"_2299":807,"_22571":800,"_5":22827,"_15405":37687,"_21315":37688,"_1890":37689},[],"/docs/platform/pki/certificates#confirm-and-verify","Confirm and verify",{"_2299":808,"_22571":800,"_5":22827,"_15405":37691,"_21315":37692,"_1890":37693},[],"/docs/platform/pki/certificates#continue","Continue",{"_2299":809,"_22571":800,"_15405":37695,"_5":15294,"_21315":800,"_1890":37696},[],"The certificate inventory offers a global view of the identities issued by all authorities. You can also open **Issued Certificates** inside a CA to limit the view to that issuer.",{"_2299":810,"_22571":800,"_15405":37698,"_5":15294,"_21315":37668,"_1890":37699},[],"Open **Certificates** and filter by:",{"_2299":811,"_22571":800,"_15405":37701,"_5":15294,"_21315":37668,"_1890":37702},[],"Subject's `Common Name`.",{"_2299":812,"_22571":800,"_15405":37704,"_5":15294,"_21315":37668,"_1890":37705},[],"Serial number.",{"_2299":813,"_22571":800,"_15405":37707,"_5":15294,"_21315":37668,"_1890":37708},[],"Status.",{"_2299":814,"_22571":800,"_15405":37710,"_5":15294,"_21315":37668,"_1890":37711},[],"Issuing authority.",{"_2299":815,"_22571":800,"_15405":37713,"_5":15294,"_21315":37668,"_1890":37714},[],"Use **Quick Inspect** for a quick check or **View Details** to see the subject, SANs, usages, chain, validity period and full metadata.",{"_2299":816,"_22571":800,"_15405":37716,"_5":15294,"_21315":37672,"_1890":37717},[],"The download action delivers the certificate in PEM format. If the certificate was issued from an external CSR, the private key stays on the system that generated that CSR. If it was generated in the browser, the key was only available when the issuance finished.",{"_2299":817,"_22571":800,"_15405":37719,"_5":15294,"_21315":37676,"_1890":37720},[],"Revoke an identity when the key has been compromised, the subject is no longer authorized or the certificate must stop being accepted before it expires.",{"_2299":818,"_22571":800,"_15405":37722,"_5":15294,"_21315":37680,"_1890":37723},[],"In the inventory or detail view, select **Revoke Certificate**.",{"_2299":819,"_22571":800,"_15405":37725,"_5":15294,"_21315":37684,"_1890":37726},[],"Select the reason that represents the incident. This information is published in OCSP and in the CRL.",{"_2299":820,"_22571":800,"_15405":37728,"_5":15294,"_21315":37688,"_1890":37729},[],"Confirm the operation and check that the status is **Revoked**. If the CA regenerates the CRL upon revocation, also verify that a new version exists.",{"_2299":821,"_22571":800,"_15405":37731,"_5":15294,"_21315":37688,"_1890":37732},[],"A revocation with the reason `CertificateHold` can be reactivated. All other reasons produce a final revocation.",{"_2299":822,"_22571":800,"_15405":37734,"_5":15294,"_21315":37692,"_1890":37735},[],"<Card title=\"Validate with OCSP\" description=\"Query the status of a certificate in real time.\" href=\"/docs/platform/pki/ocsp\" />",{"_2299":823,"_22571":800,"_15405":37737,"_5":15294,"_21315":37692,"_1890":37738},[],"<Card title=\"Distribute a CRL\" description=\"Publish the status for offline validation.\" href=\"/docs/platform/pki/crl\" />",{"_2299":824,"_22571":824,"_5":10616,"_1890":37740,"_22830":37741,"_15405":37743,"_21315":824},"Platform architecture",[35156,36291,37742],"Concepts",[],{"_2299":825,"_22571":824,"_15405":37745,"_5":15294,"_21315":824,"_1890":37746},[],"Lamassu components and how control, keys, issuance and devices relate.",{"_2299":826,"_22571":824,"_5":22827,"_15405":37748,"_21315":37749,"_1890":37750},[],"/docs/platform/pki/concepts/architecture#control-plane","Control plane",{"_2299":827,"_22571":824,"_5":22827,"_15405":37752,"_21315":37753,"_1890":37754},[],"/docs/platform/pki/concepts/architecture#key-custody-and-cryptographic-operations","Key custody and cryptographic operations",{"_2299":828,"_22571":824,"_5":22827,"_15405":37756,"_21315":37757,"_1890":37758},[],"/docs/platform/pki/concepts/architecture#issuance-and-enrollment","Issuance and enrollment",{"_2299":829,"_22571":824,"_5":22827,"_15405":37760,"_21315":37761,"_1890":37762},[],"/docs/platform/pki/concepts/architecture#status-and-validation","Status and validation",{"_2299":830,"_22571":824,"_5":22827,"_15405":37764,"_21315":37765,"_1890":37766},[],"/docs/platform/pki/concepts/architecture#platform-dependencies","Platform dependencies",{"_2299":831,"_22571":824,"_15405":37768,"_5":15294,"_21315":824,"_1890":37769},[],"Lamassu deploys as a set of independent services. This separation keeps every component from needing direct access to private keys and lets each capability scale according to load.",{"_2299":832,"_22571":824,"_15405":37771,"_5":15294,"_21315":37749,"_1890":37772},[],"The console and the APIs manage authorities, certificates, DMSs, devices, alerts and configuration. Domain events allow connectors and automations to react to changes without continuously polling the platform.",{"_2299":833,"_22571":824,"_15405":37774,"_5":15294,"_21315":37753,"_1890":37775},[],"The KMS offers a common interface over software engines, PKCS#11 and cloud providers. The selected engine keeps the key or delegates the cryptographic operation without the other services knowing its implementation.",{"_2299":834,"_22571":824,"_15405":37777,"_5":15294,"_21315":37757,"_1890":37778},[],"The CA service issues certificates and maintains the relationship with its authority. The DMS applies the enrollment rules and exposes the EST flows so a device can request or renew an identity.",{"_2299":835,"_22571":824,"_15405":37780,"_5":15294,"_21315":37761,"_1890":37781},[],"Device Manager keeps the operational view of the device and its history. The Validation Authority publishes OCSP and CRLs so other systems can decide whether to trust a presented certificate.",{"_2299":836,"_22571":824,"_15405":37783,"_5":15294,"_21315":37765,"_1890":37784},[],"In a self-managed deployment, Lamassu uses PostgreSQL for persistence, RabbitMQ for messaging and an OIDC provider for authentication. See the deployment architecture for how the services are published on Kubernetes.",{"_2299":837,"_22571":837,"_5":10616,"_1890":37786,"_22830":37787,"_15405":37788,"_21315":837},"Certificate lifecycle",[35156,36291,37742],[],{"_2299":838,"_22571":837,"_15405":37790,"_5":15294,"_21315":837,"_1890":37791},[],"Issuance, use, renewal, revocation and retirement of certificates in Lamassu.",{"_2299":839,"_22571":837,"_5":22827,"_15405":37793,"_21315":37794,"_1890":37795},[],"/docs/platform/pki/concepts/certificate-lifecycle#the-full-journey","The full journey",{"_2299":840,"_22571":837,"_5":22827,"_15405":37797,"_21315":37798,"_1890":37799},[],"/docs/platform/pki/concepts/certificate-lifecycle#request","Request",{"_2299":841,"_22571":837,"_5":22827,"_15405":37801,"_21315":37802,"_1890":37803},[],"/docs/platform/pki/concepts/certificate-lifecycle#issuance","Issuance",{"_2299":842,"_22571":837,"_5":22827,"_15405":37805,"_21315":37806,"_1890":37807},[],"/docs/platform/pki/concepts/certificate-lifecycle#use-and-monitoring","Use and monitoring",{"_2299":843,"_22571":837,"_5":22827,"_15405":37809,"_21315":37810,"_1890":37811},[],"/docs/platform/pki/concepts/certificate-lifecycle#renewal-or-re-enrollment","Renewal or re-enrollment",{"_2299":844,"_22571":837,"_5":22827,"_15405":37813,"_21315":37814,"_1890":37815},[],"/docs/platform/pki/concepts/certificate-lifecycle#revocation-or-retirement","Revocation or retirement",{"_2299":845,"_22571":837,"_5":22827,"_15405":37817,"_21315":37818,"_1890":37819},[],"/docs/platform/pki/concepts/certificate-lifecycle#certificate-states","Certificate states",{"_2299":846,"_22571":837,"_5":22827,"_15405":37821,"_21315":37822,"_1890":37823},[],"/docs/platform/pki/concepts/certificate-lifecycle#renewal-and-revocation-are-not-equivalent","Renewal and revocation are not equivalent",{"_2299":847,"_22571":837,"_5":22827,"_15405":37825,"_21315":37826,"_1890":37827},[],"/docs/platform/pki/concepts/certificate-lifecycle#effect-of-revoking-a-ca","Effect of revoking a CA",{"_2299":848,"_22571":837,"_5":22827,"_15405":37829,"_21315":37830,"_1890":37831},[],"/docs/platform/pki/concepts/certificate-lifecycle#what-you-should-watch","What you should watch",{"_2299":849,"_22571":837,"_15405":37833,"_5":15294,"_21315":837,"_1890":37834},[],"Issuing a certificate is only the beginning. During its useful life you must check its validity, renew it before it expires and retire it when it stops being trustworthy. Lamassu keeps the certificate, its issuing CA, its status and, when it belongs to a device, the identity it is linked to.",{"_2299":850,"_22571":837,"_15405":37836,"_5":15294,"_21315":37798,"_1890":37837},[],"The requester generates a key and a CSR. In the recommended flows, the private key stays in the device, browser or cryptographic engine that created it.",{"_2299":851,"_22571":837,"_15405":37839,"_5":15294,"_21315":37802,"_1890":37840},[],"The CA signs the CSR. The issuance profile determines the validity, uses, subject, allowed extensions and cryptographic constraints.",{"_2299":852,"_22571":837,"_15405":37842,"_5":15294,"_21315":37806,"_1890":37843},[],"The certificate enters the `ACTIVE` state. Lamassu monitors its `Not After` date; the cryptographic monitoring job marks certificates that have expired as `EXPIRED`.",{"_2299":853,"_22571":837,"_15405":37845,"_5":15294,"_21315":37810,"_1890":37846},[],"A new certificate is issued before the previous one expires. In a DMS you can open preventive and critical windows so the device re-enrolls through EST.",{"_2299":854,"_22571":837,"_15405":37848,"_5":15294,"_21315":37814,"_1890":37849},[],"If the identity stops being trustworthy, Lamassu records the reason and time of revocation. OCSP and CRLs let consumers learn that status.",{"_2299":855,"_22571":837,"_15405":37851,"_5":15294,"_21315":37818,"_1890":37852},[],"Lamassu persists four X.509 states:",{"_2299":856,"_22571":837,"_15405":37854,"_5":15294,"_21315":37818,"_1890":37855},[],"**`ACTIVE`**: the certificate is enabled and within its validity period.",{"_2299":857,"_22571":837,"_15405":37857,"_5":15294,"_21315":37818,"_1890":37858},[],"**`EXPIRED`**: it has passed its expiration date. The monitor detects this periodically; it is not a state that should be assigned manually.",{"_2299":858,"_22571":837,"_15405":37860,"_5":15294,"_21315":37818,"_1890":37861},[],"**`REVOKED`**: it was invalidated before expiring, with a reason and a timestamp.",{"_2299":859,"_22571":837,"_15405":37863,"_5":15294,"_21315":37818,"_1890":37864},[],"**`INACTIVE`**: it is disabled without representing a definitive revocation.",{"_2299":860,"_22571":837,"_15405":37866,"_5":15294,"_21315":37818,"_1890":37867},[],"The device view may add operational states such as missing identity, pending renewal, expiring soon or decommissioned. These are an interpretation of the device's status and its certificates, not new X.509 states.",{"_2299":861,"_22571":837,"_15405":37869,"_5":15294,"_21315":37822,"_1890":37870},[],"**Renewal** creates a successor certificate for an identity that remains valid. **Revocation** communicates that the current certificate must no longer be accepted. Renew to maintain continuity; revoke in response to compromise, retirement or a change that invalidates the identity.",{"_2299":862,"_22571":837,"_15405":37872,"_5":15294,"_21315":37822,"_1890":37873},[],"Only a revocation with the reason `CertificateHold` can be undone. A revocation with any other reason is final in Lamassu.",{"_2299":863,"_22571":837,"_15405":37875,"_5":15294,"_21315":37822,"_1890":37876},[],"The **Reissue CA** operation generates another certificate for the same key and links both serial numbers through metadata. It is not a key rotation. To change the key, create a successor CA and perform a migration with an overlapping period.",{"_2299":864,"_22571":837,"_15405":37878,"_5":15294,"_21315":37826,"_1890":37879},[],"Revoking a CA is a cascading operation. Lamassu revokes its child CAs and the certificates it issued, with the reason `CessationOfOperation`. The propagation continues down the hierarchy.",{"_2299":865,"_22571":837,"_15405":37881,"_5":15294,"_21315":37826,"_1890":37882},[],"Before confirming:",{"_2299":866,"_22571":837,"_15405":37884,"_5":15294,"_21315":37826,"_1890":37885},[],"Identify DMSs, devices and services that trust that chain.",{"_2299":867,"_22571":837,"_15405":37887,"_5":15294,"_21315":37826,"_1890":37888},[],"Distribute the new chain of trust.",{"_2299":868,"_22571":837,"_15405":37890,"_5":15294,"_21315":37826,"_1890":37891},[],"Reissue the necessary identities.",{"_2299":869,"_22571":837,"_15405":37893,"_5":15294,"_21315":37826,"_1890":37894},[],"Check OCSP and CRL from a real consumer.",{"_2299":870,"_22571":837,"_15405":37896,"_5":15294,"_21315":37826,"_1890":37897},[],"Revoke the old CA once no legitimate traffic remains.",{"_2299":871,"_22571":837,"_15405":37899,"_5":15294,"_21315":37826,"_1890":37900},[],"Decommissioning a device revokes its certificates and prevents it from obtaining new identities. Use this action only when the device is being retired permanently.",{"_2299":872,"_22571":837,"_15405":37902,"_5":15294,"_21315":37830,"_1890":37903},[],"Certificates entering the preventive or critical renewal window.",{"_2299":873,"_22571":837,"_15405":37905,"_5":15294,"_21315":37830,"_1890":37906},[],"Repeated enrollment or re-enrollment failures.",{"_2299":874,"_22571":837,"_15405":37908,"_5":15294,"_21315":37830,"_1890":37909},[],"Status changes and revocation reasons.",{"_2299":875,"_22571":837,"_15405":37911,"_5":15294,"_21315":37830,"_1890":37912},[],"OCSP and CRL publication and validity.",{"_2299":876,"_22571":837,"_15405":37914,"_5":15294,"_21315":37830,"_1890":37915},[],"Dependencies still presenting a replaced certificate.",{"_2299":877,"_22571":837,"_15405":37917,"_5":15294,"_21315":37830,"_1890":37918},[],"The device history relates its previous and current identities. For administrative changes and mutation errors, see Audit logs.",{"_2299":878,"_22571":878,"_5":10616,"_1890":37920,"_22830":37921,"_15405":37922,"_21315":878},"Glossary",[35156,36291,37742],[],{"_2299":879,"_22571":878,"_15405":37924,"_5":15294,"_21315":878,"_1890":37925},[],"PKI, certificate and identity management terms used in Lamassu.",{"_2299":880,"_22571":878,"_5":22827,"_15405":37927,"_21315":37928,"_1890":37929},[],"/docs/platform/pki/concepts/glossary#ac","A–C",{"_2299":881,"_22571":878,"_5":22827,"_15405":37931,"_21315":37932,"_1890":37933},[],"/docs/platform/pki/concepts/glossary#dk","D–K",{"_2299":882,"_22571":878,"_5":22827,"_15405":37935,"_21315":37936,"_1890":37937},[],"/docs/platform/pki/concepts/glossary#mr","M–R",{"_2299":883,"_22571":878,"_5":22827,"_15405":37939,"_21315":37940,"_1890":37941},[],"/docs/platform/pki/concepts/glossary#sz","S–Z",{"_2299":884,"_22571":878,"_15405":37943,"_5":15294,"_21315":37928,"_1890":37944},[],"**AKI (Authority Key Identifier)**\\\nIdentifier of the public key of the authority that signed a certificate. It helps build the chain toward the correct issuer.",{"_2299":885,"_22571":878,"_15405":37946,"_5":15294,"_21315":37928,"_1890":37947},[],"**Anchor of trust**\\\nA certificate, usually from a root CA, that a consumer explicitly accepts as the endpoint of a chain.",{"_2299":886,"_22571":878,"_15405":37949,"_5":15294,"_21315":37928,"_1890":37950},[],"**CA (Certification Authority)**\\\nAuthority that signs certificates and binds an identity to a public key.",{"_2299":887,"_22571":878,"_15405":37952,"_5":15294,"_21315":37928,"_1890":37953},[],"**Intermediate CA**\\\nA CA signed by another authority. Used to issue without exposing the root to daily operation.",{"_2299":888,"_22571":878,"_15405":37955,"_5":15294,"_21315":37928,"_1890":37956},[],"**Root CA**\\\nA self-signed CA that starts a hierarchy of trust.",{"_2299":889,"_22571":878,"_15405":37958,"_5":15294,"_21315":37928,"_1890":37959},[],"**X.509 certificate**\\\nA signed document containing a public key, a subject, an issuer, a validity period and extensions that constrain its use.",{"_2299":890,"_22571":878,"_15405":37961,"_5":15294,"_21315":37928,"_1890":37962},[],"**CRL (Certificate Revocation List)**\\\nSigned list of revoked certificates published by a CA.",{"_2299":891,"_22571":878,"_15405":37964,"_5":15294,"_21315":37928,"_1890":37965},[],"**CSR (Certificate Signing Request)**\\\nPKCS#10 request containing a public key and requested attributes. Signing the CSR proves possession of the corresponding private key.",{"_2299":892,"_22571":878,"_15405":37967,"_5":15294,"_21315":37932,"_1890":37968},[],"**DMS (Device Management Service)**\\\nConfiguration that groups registration, enrollment, re-enrollment, issuance and CA distribution rules for a fleet.",{"_2299":893,"_22571":878,"_15405":37970,"_5":15294,"_21315":37932,"_1890":37971},[],"**Distinguished Name (DN)**\\\nSet of subject or issuer attributes, such as `CN`, `O`, `OU`, `C`, `ST` and `L`.",{"_2299":894,"_22571":878,"_15405":37973,"_5":15294,"_21315":37932,"_1890":37974},[],"**EST (Enrollment over Secure Transport)**\\\nProtocol defined in RFC 7030 to obtain CAs, enroll and re-enroll certificates over HTTPS.",{"_2299":895,"_22571":878,"_15405":37976,"_5":15294,"_21315":37932,"_1890":37977},[],"**Extended Key Usage (EKU)**\\\nExtension that constrains purposes such as client authentication, server authentication, code signing or OCSP.",{"_2299":896,"_22571":878,"_15405":37979,"_5":15294,"_21315":37932,"_1890":37980},[],"**Device identity**\\\nRelationship between a device and one of its certificates. A device can keep a history of identities.",{"_2299":897,"_22571":878,"_15405":37982,"_5":15294,"_21315":37932,"_1890":37983},[],"**Identity slot**\\\nLogical position on a device where Lamassu binds an active or historical identity.",{"_2299":898,"_22571":878,"_15405":37985,"_5":15294,"_21315":37932,"_1890":37986},[],"**JITP (Just-in-Time Provisioning)**\\\nAutomatic registration of a device when it successfully completes its first enrollment.",{"_2299":899,"_22571":878,"_15405":37988,"_5":15294,"_21315":37932,"_1890":37989},[],"**KMS (Key Management Service)**\\\nLamassu service that normalizes key generation, import and use across different cryptographic engines.",{"_2299":900,"_22571":878,"_15405":37991,"_5":15294,"_21315":37932,"_1890":37992},[],"**Key Usage**\\\nX.509 extension that allows basic operations such as digital signature, key encryption or certificate signing.",{"_2299":901,"_22571":878,"_15405":37994,"_5":15294,"_21315":37936,"_1890":37995},[],"**mTLS (Mutual TLS)**\\\nTLS where both client and server present certificates. A DMS can use the client certificate as an authentication method.",{"_2299":902,"_22571":878,"_15405":37997,"_5":15294,"_21315":37936,"_1890":37998},[],"**OCSP (Online Certificate Status Protocol)**\\\nProtocol for querying online whether a certificate is valid, revoked or unknown.",{"_2299":903,"_22571":878,"_15405":38000,"_5":15294,"_21315":37936,"_1890":38001},[],"**Issuance profile**\\\nReusable policy that defines how Lamassu builds a certificate and which keys it accepts.",{"_2299":904,"_22571":878,"_15405":38003,"_5":15294,"_21315":37936,"_1890":38004},[],"**Principal**\\\nOperator or API client identity recognized by the authorization service. Lamassu supports OIDC and X.509 principals.",{"_2299":905,"_22571":878,"_15405":38006,"_5":15294,"_21315":37936,"_1890":38007},[],"**Policy**\\\nSet of permissions assignable to one or more principals.",{"_2299":906,"_22571":878,"_15405":38009,"_5":15294,"_21315":37936,"_1890":38010},[],"**RA (Registration Authority)**\\\nComponent that verifies the requester before asking a CA to issue. The DMS plays this role in device enrollment flows.",{"_2299":907,"_22571":878,"_15405":38012,"_5":15294,"_21315":37936,"_1890":38013},[],"**Relying party**\\\nConsuming system that decides whether to accept a presented certificate.",{"_2299":908,"_22571":878,"_15405":38015,"_5":15294,"_21315":37936,"_1890":38016},[],"**Revocation**\\\nInvalidation of a certificate before its expiration date.",{"_2299":909,"_22571":878,"_15405":38018,"_5":15294,"_21315":37940,"_1890":38019},[],"**SAN (Subject Alternative Name)**\\\nExtension that adds identities such as DNS names, IP addresses, emails or URIs.",{"_2299":910,"_22571":878,"_15405":38021,"_5":15294,"_21315":37940,"_1890":38022},[],"**SKI (Subject Key Identifier)**\\\nIdentifier derived from the public key of the certificate itself.",{"_2299":911,"_22571":878,"_15405":38024,"_5":15294,"_21315":37940,"_1890":38025},[],"**VA (Validation Authority)**\\\nLamassu service responsible for OCSP responses and the generation or publication of CRLs.",{"_2299":912,"_22571":878,"_15405":38027,"_5":15294,"_21315":37940,"_1890":38028},[],"**Renewal window**\\\nPeriod before expiration during which a device may or must request another identity.",{"_2299":913,"_22571":878,"_15405":38030,"_5":15294,"_21315":37940,"_1890":38031},[],"Missing an operational term? Check How Lamassu works and the Trust model first, where these concepts appear connected.",{"_2299":914,"_22571":914,"_5":10616,"_1890":38033,"_22830":38034,"_15405":38035,"_21315":914},"How Lamassu works",[35156,36291,37742],[],{"_2299":915,"_22571":914,"_15405":38037,"_5":15294,"_21315":914,"_1890":38038},[],"The mental model of trust, keys, certificates and devices.",{"_2299":916,"_22571":914,"_5":22827,"_15405":38040,"_21315":38041,"_1890":38042},[],"/docs/platform/pki/concepts/overview#the-model-in-five-pieces","The model in five pieces",{"_2299":917,"_22571":914,"_5":22827,"_15405":38044,"_21315":38045,"_1890":38046},[],"/docs/platform/pki/concepts/overview#from-onboarding-to-operation","From onboarding to operation",{"_2299":918,"_22571":914,"_15405":38048,"_5":15294,"_21315":914,"_1890":38049},[],"Lamassu connects three elements: a **root of trust**, an **issuance policy** and an **entity that needs to prove its identity**. The platform coordinates these elements throughout the certificate lifecycle.",{"_2299":919,"_22571":914,"_15405":38051,"_5":15294,"_21315":38041,"_1890":38052},[],"**Cryptographic engine.** Generates or safeguards keys and executes private-key operations without exposing key material to the rest of the services.",{"_2299":920,"_22571":914,"_15405":38054,"_5":15294,"_21315":38041,"_1890":38055},[],"**Certification Authority (CA).** Signs certificates and establishes the chain of trust.",{"_2299":921,"_22571":914,"_15405":38057,"_5":15294,"_21315":38041,"_1890":38058},[],"**Device Management Service (DMS).** Defines how the devices of a fleet are registered, authenticated and renewed.",{"_2299":922,"_22571":914,"_15405":38060,"_5":15294,"_21315":38041,"_1890":38061},[],"**Device.** Keeps its private key and presents the certificate to prove its identity.",{"_2299":923,"_22571":914,"_15405":38063,"_5":15294,"_21315":38041,"_1890":38064},[],"**Validation Authority (VA).** Publishes the status of certificates through OCSP and CRL.",{"_2299":924,"_22571":914,"_15405":38066,"_5":15294,"_21315":38045,"_1890":38067},[],"An administrator configures a cryptographic engine and creates or imports a CA.",{"_2299":925,"_22571":914,"_15405":38069,"_5":15294,"_21315":38045,"_1890":38070},[],"A DMS relates that CA to an enrollment policy.",{"_2299":926,"_22571":914,"_15405":38072,"_5":15294,"_21315":38045,"_1890":38073},[],"The device generates a key and requests a certificate through EST, or an operator assigns it an identity.",{"_2299":927,"_22571":914,"_15405":38075,"_5":15294,"_21315":38045,"_1890":38076},[],"Lamassu keeps the inventory, history and status of the identity.",{"_2299":928,"_22571":914,"_15405":38078,"_5":15294,"_21315":38045,"_1890":38079},[],"Consumers check the chain and query OCSP or a CRL when they need to know whether it is still valid.",{"_2299":929,"_22571":914,"_15405":38081,"_5":15294,"_21315":38045,"_1890":38082},[],"<Card title=\"Architecture\" description=\"Get to know the components and where each one's responsibility ends.\" href=\"/docs/platform/pki/concepts/architecture\" />",{"_2299":930,"_22571":914,"_15405":38084,"_5":15294,"_21315":38045,"_1890":38085},[],"<Card title=\"Identity lifecycle\" description=\"Follow a certificate from enrollment to renewal or revocation.\" href=\"/docs/platform/pki/concepts/certificate-lifecycle\" />",{"_2299":931,"_22571":931,"_5":10616,"_1890":38087,"_22830":38088,"_15405":38089,"_21315":931},"Trust model",[35156,36291,37742],[],{"_2299":932,"_22571":931,"_15405":38091,"_5":15294,"_21315":931,"_1890":38092},[],"Understand where trust originates, how it is distributed and what each component validates.",{"_2299":933,"_22571":931,"_5":22827,"_15405":38094,"_21315":38095,"_1890":38096},[],"/docs/platform/pki/concepts/trust-model#the-four-trust-decisions","The four trust decisions",{"_2299":934,"_22571":931,"_5":22827,"_15405":38098,"_21315":38099,"_1890":38100},[],"/docs/platform/pki/concepts/trust-model#who-can-issue","Who can issue",{"_2299":935,"_22571":931,"_5":22827,"_15405":38102,"_21315":38103,"_1890":38104},[],"/docs/platform/pki/concepts/trust-model#what-can-be-issued","What can be issued",{"_2299":936,"_22571":931,"_5":22827,"_15405":38106,"_21315":38107,"_1890":38108},[],"/docs/platform/pki/concepts/trust-model#who-can-request-it","Who can request it",{"_2299":937,"_22571":931,"_5":22827,"_15405":38110,"_21315":38111,"_1890":38112},[],"/docs/platform/pki/concepts/trust-model#who-accepts-the-result","Who accepts the result",{"_2299":938,"_22571":931,"_5":22827,"_15405":38114,"_21315":38115,"_1890":38116},[],"/docs/platform/pki/concepts/trust-model#identity-flow","Identity flow",{"_2299":939,"_22571":931,"_5":22827,"_15405":38118,"_21315":38119,"_1890":38120},[],"/docs/platform/pki/concepts/trust-model#enrollment-validation-and-distribution-cas","Enrollment, validation and distribution CAs",{"_2299":940,"_22571":931,"_5":22827,"_15405":38122,"_21315":38123,"_1890":38124},[],"/docs/platform/pki/concepts/trust-model#validation-and-revocation","Validation and revocation",{"_2299":941,"_22571":931,"_5":22827,"_15405":38126,"_21315":38127,"_1890":38128},[],"/docs/platform/pki/concepts/trust-model#custody-limits","Custody limits",{"_2299":942,"_22571":931,"_5":22827,"_15405":38130,"_21315":38131,"_1890":38132},[],"/docs/platform/pki/concepts/trust-model#recommended-pattern","Recommended pattern",{"_2299":943,"_22571":931,"_15405":38134,"_5":15294,"_21315":931,"_1890":38135},[],"In Lamassu, trust does not simply mean that a certificate exists in the inventory. A consumer trusts an identity when it can build a chain to a root it recognizes, check that the certificate is fit for the intended use and verify that it is still valid.",{"_2299":944,"_22571":931,"_15405":38137,"_5":15294,"_21315":38099,"_1890":38138},[],"The CA hierarchy defines which authorities can sign. A root CA establishes the anchor of trust; intermediate CAs separate operating domains and avoid using the root for every issuance.",{"_2299":945,"_22571":931,"_15405":38140,"_5":15294,"_21315":38103,"_1890":38141},[],"Certificate profiles limit validity, subject, uses, extensions and cryptographic parameters. Possessing a CA does not replace an issuance policy.",{"_2299":946,"_22571":931,"_15405":38143,"_5":15294,"_21315":38107,"_1890":38144},[],"The DMS acts as the enrollment point. It can authenticate an EST request with a client certificate, an external webhook or a combination of both. CAs configured to validate the requester do not have to be the CA that will issue the new identity.",{"_2299":947,"_22571":931,"_15405":38146,"_5":15294,"_21315":38111,"_1890":38147},[],"The consuming service or device keeps its own trust store. Lamassu can distribute the system CA, the enrollment CA and other managed CAs through `/cacerts`, but the consumer decides which ones it installs and how it applies validation.",{"_2299":948,"_22571":931,"_15405":38149,"_5":15294,"_21315":38115,"_1890":38150},[],"The device proves it can enroll according to the DMS policy.",{"_2299":949,"_22571":931,"_15405":38152,"_5":15294,"_21315":38115,"_1890":38153},[],"The DMS validates the request and forwards the CSR to the enrollment CA.",{"_2299":950,"_22571":931,"_15405":38155,"_5":15294,"_21315":38115,"_1890":38156},[],"The CA applies the profile and signs without ever receiving the device's private key.",{"_2299":951,"_22571":931,"_15405":38158,"_5":15294,"_21315":38115,"_1890":38159},[],"The device installs the certificate and the chain it needs.",{"_2299":952,"_22571":931,"_15405":38161,"_5":15294,"_21315":38115,"_1890":38162},[],"The system that trusts the device validates the chain, dates, uses and revocation status.",{"_2299":953,"_22571":931,"_15405":38164,"_5":15294,"_21315":38115,"_1890":38165},[],"OIDC or X.509 identifies the operator calling Lamassu. The authorization service decides which actions it may perform. The X.509 hierarchy, on the other hand, determines whether a certificate presented by a device is trustworthy.",{"_2299":954,"_22571":931,"_15405":38167,"_5":15294,"_21315":38119,"_1890":38168},[],"A DMS relates three sets that are worth designing separately:",{"_2299":955,"_22571":931,"_15405":38170,"_5":15294,"_21315":38119,"_1890":38171},[],"**Enrollment CA:** signs the new identities.",{"_2299":956,"_22571":931,"_15405":38173,"_5":15294,"_21315":38119,"_1890":38174},[],"**Validation CAs:** authenticate the client certificates used for enrollment or migration. During re-enrollment, Lamassu tries the enrollment CA first and then the additional validation CAs.",{"_2299":957,"_22571":931,"_15405":38176,"_5":15294,"_21315":38119,"_1890":38177},[],"**Distributed CAs:** form the content the device obtains through EST `/cacerts`. You can include the system CA, the enrollment CA and a list of managed CAs.",{"_2299":958,"_22571":931,"_15405":38179,"_5":15294,"_21315":38119,"_1890":38180},[],"This separation makes it possible to migrate a fleet: you temporarily accept certificates from the old hierarchy, issue with the new one and distribute both chains during the overlap.",{"_2299":959,"_22571":931,"_15405":38182,"_5":15294,"_21315":38123,"_1890":38183},[],"A valid chain does not by itself guarantee that a certificate should be accepted. The consumer must also check:",{"_2299":960,"_22571":931,"_15405":38185,"_5":15294,"_21315":38123,"_1890":38186},[],"that the current date is between `Not Before` and `Not After`;",{"_2299":961,"_22571":931,"_15405":38188,"_5":15294,"_21315":38123,"_1890":38189},[],"that `Key Usage` and `Extended Key Usage` allow the operation;",{"_2299":962,"_22571":931,"_15405":38191,"_5":15294,"_21315":38123,"_1890":38192},[],"that names, SANs and subject match the expected identity;",{"_2299":963,"_22571":931,"_15405":38194,"_5":15294,"_21315":38123,"_1890":38195},[],"that the certificate does not appear revoked in OCSP or a CRL.",{"_2299":964,"_22571":931,"_15405":38197,"_5":15294,"_21315":38123,"_1890":38198},[],"During the mTLS authentication of a DMS, Lamassu attempts to check revocation. If the certificate does not contain enough information to perform that check, the backend logs a warning and continues treating it as not revoked. Design your profiles and distribution points to avoid that situation in production.",{"_2299":965,"_22571":931,"_15405":38200,"_5":15294,"_21315":38127,"_1890":38201},[],"The KMS keeps the reference to the key and delegates the operation to the configured engine. With an HSM or a cloud KMS, the private key can remain non-exportable. That protects custody, but it does not by itself prevent misuse: you still must restrict who can request a signature and audit those operations.",{"_2299":966,"_22571":931,"_15405":38203,"_5":15294,"_21315":38131,"_1890":38204},[],"Keep the root out of daily operations, or with very restricted access.",{"_2299":967,"_22571":931,"_15405":38206,"_5":15294,"_21315":38131,"_1890":38207},[],"Issue from intermediate CAs separated by environment or risk domain.",{"_2299":968,"_22571":931,"_15405":38209,"_5":15294,"_21315":38131,"_1890":38210},[],"Assign explicit profiles to every use case.",{"_2299":969,"_22571":931,"_15405":38212,"_5":15294,"_21315":38131,"_1890":38213},[],"Distribute the new trust before starting a rotation.",{"_2299":970,"_22571":931,"_15405":38215,"_5":15294,"_21315":38131,"_1890":38216},[],"Keep enough overlap to renew a disconnected fleet.",{"_2299":971,"_22571":931,"_15405":38218,"_5":15294,"_21315":38131,"_1890":38219},[],"Validate from the consuming system, not only from the Lamassu console.",{"_2299":972,"_22571":931,"_15405":38221,"_5":15294,"_21315":38131,"_1890":38222},[],"Continue with CA hierarchy and rotation to turn this model into an operating procedure.",{"_2299":973,"_22571":973,"_5":10616,"_1890":38224,"_22830":38225,"_15405":38226,"_21315":973},"Revocation lists (CRL)",[35156,36291,36769],[],{"_2299":974,"_22571":973,"_15405":38228,"_5":15294,"_21315":973,"_1890":38229},[],"Generate and distribute signed lists to validate certificates offline.",{"_2299":975,"_22571":973,"_5":22827,"_15405":38231,"_21315":38232,"_1890":38233},[],"/docs/platform/pki/crl#crl-service","CRL service",{"_2299":976,"_22571":973,"_5":22827,"_15405":38235,"_21315":38236,"_1890":38237},[],"/docs/platform/pki/crl#va-role-and-per-ca-configuration","VA role and per-CA configuration",{"_2299":977,"_22571":973,"_5":22827,"_15405":38239,"_21315":38240,"_1890":38241},[],"/docs/platform/pki/crl#periodic-and-automatic-regeneration","Periodic and automatic regeneration",{"_2299":978,"_22571":973,"_5":22827,"_15405":38243,"_21315":38244,"_1890":38245},[],"/docs/platform/pki/crl#crl-contents","CRL contents",{"_2299":979,"_22571":973,"_5":22827,"_15405":38247,"_21315":38248,"_1890":38249},[],"/docs/platform/pki/crl#public-download-endpoint","Public download endpoint",{"_2299":980,"_22571":973,"_5":22827,"_15405":38251,"_21315":38252,"_1890":38253},[],"/docs/platform/pki/crl#va-role-management-api","VA role management API",{"_2299":981,"_22571":973,"_5":22827,"_15405":38255,"_21315":38256,"_1890":38257},[],"/docs/platform/pki/crl#from-the-interface","From the interface",{"_2299":982,"_22571":973,"_5":22827,"_15405":38259,"_21315":38260,"_1890":38261},[],"/docs/platform/pki/crl#references","References",{"_2299":983,"_22571":973,"_15405":38263,"_5":15294,"_21315":38232,"_1890":38264},[],"A CRL (*Certificate Revocation List*) is a signed list containing the serial numbers of certificates revoked before their expiration date. Unlike OCSP, it does not require a real-time query: the relying party downloads the list periodically and consults it locally.",{"_2299":984,"_22571":973,"_15405":38266,"_5":15294,"_21315":38232,"_1890":38267},[],"Lamassu generates and maintains one CRL per CA it manages. Each CRL is signed with the private key of the issuing CA itself and is stored in the object storage configured on the platform.",{"_2299":985,"_22571":973,"_15405":38269,"_5":15294,"_21315":38236,"_1890":38270},[],"The publication of each CA's CRL is controlled by a *VA role*. This object defines how it is generated, when it is regenerated and which key signs it.",{"_2299":986,"_22571":973,"_15405":38272,"_5":15294,"_21315":38236,"_1890":38273},[],"The main parameters are:",{"_2299":987,"_22571":973,"_15405":38275,"_5":15294,"_21315":38236,"_1890":38276},[],"**`validity`** defines the validity period reflected in `nextUpdate`. Its default value is 7 days.",{"_2299":988,"_22571":973,"_15405":38278,"_5":15294,"_21315":38236,"_1890":38279},[],"**`refresh_interval`** sets the minimum interval between scheduled regenerations. By default it is approximately 6 days and 23 hours.",{"_2299":989,"_22571":973,"_15405":38281,"_5":15294,"_21315":38236,"_1890":38282},[],"**`regenerate_on_revoke`** orders publishing a new version immediately after a revocation. It is enabled by default.",{"_2299":990,"_22571":973,"_15405":38284,"_5":15294,"_21315":38236,"_1890":38285},[],"The `subject_key_id_signer` field identifies the CA whose private key signs the CRL. By default, each CA signs its own CRL.",{"_2299":991,"_22571":973,"_15405":38287,"_5":15294,"_21315":38236,"_1890":38288},[],"Each CRL carries an incremental version number. Lamassu stores all versions under the path `pki/va/crl/{subject_key_id}/{version}.crl` in object storage.",{"_2299":992,"_22571":973,"_15405":38290,"_5":15294,"_21315":38240,"_1890":38291},[],"A background process monitors active VA roles. When the remaining validity of the current CRL falls below the configured watch period (*blind period*), the system requests the generation of a new CRL. This prevents the published CRL from expiring without a valid version available.",{"_2299":993,"_22571":973,"_15405":38293,"_5":15294,"_21315":38240,"_1890":38294},[],"Additionally, when `regenerate_on_revoke` is enabled, which is the default behavior, any certificate revocation immediately triggers the generation of a new CRL for the affected CA. This minimizes the time between revocation and its publication.",{"_2299":994,"_22571":973,"_15405":38296,"_5":15294,"_21315":38244,"_1890":38297},[],"Each entry of the CRL includes the serial number of the revoked certificate, the revocation date and the RFC 5280 reason code.",{"_2299":995,"_22571":973,"_15405":38299,"_5":15294,"_21315":38244,"_1890":38300},[],"The CRL also includes the *Issuing Distribution Point* (IDP, OID 2.5.29.28) extension, marked as critical, which indicates the public URL from which it can be downloaded. That URL points to the `/crl/{subject_key_id}` endpoint of each configured VA domain.",{"_2299":996,"_22571":973,"_15405":38302,"_5":15294,"_21315":38248,"_1890":38303},[],"The latest CRL of a CA can be obtained directly without authentication:",{"_2299":997,"_22571":973,"_15405":38305,"_5":15294,"_21315":38248,"_1890":38306},[],"The response has `Content-Type: application/pkix-crl` and contains the CRL in DER format.",{"_2299":998,"_22571":973,"_15405":38308,"_5":15294,"_21315":38252,"_1890":38309},[],"The VA role of a CA can be queried and updated through the API:",{"_2299":999,"_22571":973,"_15405":38311,"_5":15294,"_21315":38252,"_1890":38312},[],"Method",{"_2299":1000,"_22571":973,"_15405":38314,"_5":15294,"_21315":38252,"_1890":38315},[],"Path",{"_2299":1001,"_22571":973,"_15405":38317,"_5":15294,"_21315":38252,"_1890":38318},[],"Description",{"_2299":1002,"_22571":973,"_15405":38320,"_5":15294,"_21315":38252,"_1890":38321},[],"`GET`",{"_2299":1003,"_22571":973,"_15405":38323,"_5":15294,"_21315":38252,"_1890":38324},[],"`/v1/roles/{ca-ski}`",{"_2299":1004,"_22571":973,"_15405":38326,"_5":15294,"_21315":38252,"_1890":38327},[],"Returns the VA role configuration and the metadata of the last issued CRL.",{"_2299":1005,"_22571":973,"_15405":38329,"_5":15294,"_21315":38252,"_1890":38330},[],"`PUT`",{"_2299":1006,"_22571":973,"_15405":38332,"_5":15294,"_21315":38252,"_1890":38324},[],{"_2299":1007,"_22571":973,"_15405":38334,"_5":15294,"_21315":38252,"_1890":38335},[],"Updates the VA role configuration parameters (`validity`, `refresh_interval`, `regenerate_on_revoke`).",{"_2299":1008,"_22571":973,"_15405":38337,"_5":15294,"_21315":38252,"_1890":38338},[],"Example of querying the VA role:",{"_2299":1009,"_22571":973,"_15405":38340,"_5":15294,"_21315":38252,"_1890":38341},[],"The response includes the `latest_crl` field with the version, the start of validity and the expiration date of the currently published CRL.",{"_2299":1010,"_22571":973,"_15405":38343,"_5":15294,"_21315":38256,"_1890":38344},[],"From a CA's detail panel you can preview the content of the active CRL and download it directly for offline use or for importing into applications that perform local validation.",{"_2299":1011,"_22571":973,"_15405":38346,"_5":15294,"_21315":38260,"_1890":38347},[],"RFC 5280 - *Internet X.509 Public Key Infrastructure Certificate and Certificate Revocation List (CRL) Profile*",{"_2299":1012,"_22571":973,"_15405":38349,"_5":15294,"_21315":38260,"_1890":38350},[],"<Card title=\"OCSP service\" href=\"/docs/platform/pki/ocsp\" />",{"_2299":1013,"_22571":973,"_15405":38352,"_5":15294,"_21315":38260,"_1890":38353},[],"<Card title=\"Certificate validation\" href=\"/docs/platform/pki/certificate-validation\" />",{"_2299":1014,"_22571":1014,"_5":10616,"_1890":38355,"_22830":38356,"_15405":38357,"_21315":1014},"Device Management Service",[35156,36291,36769],[],{"_2299":1015,"_22571":1014,"_15405":38359,"_5":15294,"_21315":1014,"_1890":38360},[],"Define how a fleet receives, renews and uses its identities.",{"_2299":1016,"_22571":1014,"_5":22827,"_15405":38362,"_21315":38363,"_1890":35166},[],"/docs/platform/pki/device-enrollment#before-you-begin",{"_2299":1017,"_22571":1014,"_5":22827,"_15405":38365,"_21315":38366,"_1890":38367},[],"/docs/platform/pki/device-enrollment#configure-a-dms","Configure a DMS",{"_2299":1018,"_22571":1014,"_5":22827,"_15405":38369,"_21315":38370,"_1890":38371},[],"/docs/platform/pki/device-enrollment#identify-the-fleet","Identify the fleet",{"_2299":1019,"_22571":1014,"_5":22827,"_15405":38373,"_21315":38374,"_1890":38375},[],"/docs/platform/pki/device-enrollment#select-the-enrollment-ca","Select the enrollment CA",{"_2299":1020,"_22571":1014,"_5":22827,"_15405":38377,"_21315":38378,"_1890":38379},[],"/docs/platform/pki/device-enrollment#configure-est","Configure EST",{"_2299":1021,"_22571":1014,"_5":22827,"_15405":38381,"_21315":38382,"_1890":38383},[],"/docs/platform/pki/device-enrollment#distribute-trust","Distribute trust",{"_2299":1022,"_22571":1014,"_5":22827,"_15405":38385,"_21315":38386,"_1890":38387},[],"/docs/platform/pki/device-enrollment#verify-the-endpoints","Verify the endpoints",{"_2299":1023,"_22571":1014,"_5":22827,"_15405":38389,"_21315":38390,"_1890":38391},[],"/docs/platform/pki/device-enrollment#trust-distribution","Trust distribution",{"_2299":1024,"_22571":1014,"_5":22827,"_15405":38393,"_21315":38394,"_1890":38395},[],"/docs/platform/pki/device-enrollment#operate-the-dms-inventory","Operate the DMS inventory",{"_2299":1025,"_22571":1014,"_5":22827,"_15405":38397,"_21315":38398,"_1890":38399},[],"/docs/platform/pki/device-enrollment#integrate-the-devices","Integrate the devices",{"_2299":1026,"_22571":1014,"_15405":38401,"_5":15294,"_21315":1014,"_1890":38402},[],"A &#x2A;*Device Management Service (DMS)** acts as the registration authority facing a fleet. It receives requests, applies the authentication policy and delegates issuance to the configured CA.",{"_2299":1027,"_22571":1014,"_15405":38404,"_5":15294,"_21315":1014,"_1890":38405},[],"Each DMS is an independent operational boundary: it can represent a product line, an environment or a device type with its own CA, authentication rules, distributed trust and renewal window.",{"_2299":1028,"_22571":1014,"_15405":38407,"_5":15294,"_21315":38363,"_1890":38408},[],"Create or import at least one active CA.",{"_2299":1029,"_22571":1014,"_15405":38410,"_5":15294,"_21315":38363,"_1890":38411},[],"Decide how devices will authenticate during initial enrollment.",{"_2299":1030,"_22571":1014,"_15405":38413,"_5":15294,"_21315":38363,"_1890":38414},[],"Define which authorities the device should receive as anchors of trust.",{"_2299":1031,"_22571":1014,"_15405":38416,"_5":15294,"_21315":38363,"_1890":38417},[],"Make sure you have permissions to administer DMSs.",{"_2299":1032,"_22571":1014,"_15405":38419,"_5":15294,"_21315":38370,"_1890":38420},[],"Give the DMS a name that describes its scope, for example a device family or an environment.",{"_2299":1033,"_22571":1014,"_15405":38422,"_5":15294,"_21315":38374,"_1890":38423},[],"Choose the authority that will issue the identities. Its policy and validity period constrain the certificates the fleet can obtain.",{"_2299":1034,"_22571":1014,"_15405":38425,"_5":15294,"_21315":38378,"_1890":38426},[],"Define the authentication of `enroll`, the `reenroll` policy, the renewal window and, if needed, `serverkeygen`.",{"_2299":1035,"_22571":1014,"_15405":38428,"_5":15294,"_21315":38382,"_1890":38429},[],"Configure **CA Distribution** to control the response of the `cacerts` endpoint.",{"_2299":1036,"_22571":1014,"_15405":38431,"_5":15294,"_21315":38386,"_1890":38432},[],"From the DMS menu, open &#x2A;*EST (RFC-7030)** and check the base URL and the invocation examples before integrating the firmware.",{"_2299":1037,"_22571":1014,"_15405":38434,"_5":15294,"_21315":38390,"_1890":38435},[],"**Include Lamassu System CA** distributes the TLS certificate of the Lamassu server, useful for *pinning*. It does not represent an issuing CA.",{"_2299":1038,"_22571":1014,"_15405":38437,"_5":15294,"_21315":38390,"_1890":38438},[],"**Include Enrollment CA** adds the authority configured to issue the DMS's identities.",{"_2299":1039,"_22571":1014,"_15405":38440,"_5":15294,"_21315":38390,"_1890":38441},[],"**Managed CAs** lets you include additional authorities the device must consider trusted.",{"_2299":1040,"_22571":1014,"_15405":38443,"_5":15294,"_21315":38394,"_1890":38444},[],"**Edit** modifies the DMS policy.",{"_2299":1041,"_22571":1014,"_15405":38446,"_5":15294,"_21315":38394,"_1890":38447},[],"**Go to DMS owned devices** opens only the devices of that fleet.",{"_2299":1042,"_22571":1014,"_15405":38449,"_5":15294,"_21315":38394,"_1890":38450},[],"**Show/Edit Metadata** manages advanced configuration and integration data.",{"_2299":1043,"_22571":1014,"_15405":38452,"_5":15294,"_21315":38394,"_1890":38453},[],"**EST (RFC-7030)** shows the endpoints and examples specific to the DMS.",{"_2299":1044,"_22571":1014,"_15405":38455,"_5":15294,"_21315":38394,"_1890":38456},[],"**Delete** removes the DMS and its configuration. The action is irreversible.",{"_2299":1045,"_22571":1014,"_15405":38458,"_5":15294,"_21315":38398,"_1890":38459},[],"<Card title=\"EST enrollment\" description=\"Configure authentication, endpoints and flows for firmware.\" href=\"/docs/platform/pki/est-enrollment\" />",{"_2299":1046,"_22571":1014,"_15405":38461,"_5":15294,"_21315":38398,"_1890":38462},[],"<Card title=\"Devices and identities\" description=\"Review statuses, history and operational actions.\" href=\"/docs/platform/pki/device-management\" />",{"_2299":1047,"_22571":1047,"_5":10616,"_1890":38464,"_22830":38465,"_15405":38466,"_21315":1047},"Devices and identities",[35156,36291,36769],[],{"_2299":1048,"_22571":1047,"_15405":38468,"_5":15294,"_21315":1047,"_1890":38469},[],"Register devices and control their identities throughout the lifecycle.",{"_2299":1049,"_22571":1047,"_5":22827,"_15405":38471,"_21315":38472,"_1890":38473},[],"/docs/platform/pki/device-management#device-states","Device states",{"_2299":1050,"_22571":1047,"_5":22827,"_15405":38475,"_21315":38476,"_1890":38477},[],"/docs/platform/pki/device-management#inspect-a-device","Inspect a device",{"_2299":1051,"_22571":1047,"_5":22827,"_15405":38479,"_21315":38480,"_1890":38481},[],"/docs/platform/pki/device-management#register-a-device-manually","Register a device manually",{"_2299":1052,"_22571":1047,"_5":22827,"_15405":38483,"_21315":38484,"_1890":38485},[],"/docs/platform/pki/device-management#create-the-device","Create the device",{"_2299":1053,"_22571":1047,"_5":22827,"_15405":38487,"_21315":38488,"_1890":38489},[],"/docs/platform/pki/device-management#define-its-membership","Define its membership",{"_2299":1054,"_22571":1047,"_5":22827,"_15405":38491,"_21315":38492,"_1890":38493},[],"/docs/platform/pki/device-management#classify-the-device","Classify the device",{"_2299":1055,"_22571":1047,"_5":22827,"_15405":38495,"_21315":38496,"_1890":38497},[],"/docs/platform/pki/device-management#verify-the-registration","Verify the registration",{"_2299":1056,"_22571":1047,"_5":22827,"_15405":38499,"_21315":38500,"_1890":38501},[],"/docs/platform/pki/device-management#assign-an-identity-manually","Assign an identity manually",{"_2299":1057,"_22571":1047,"_5":22827,"_15405":38503,"_21315":38504,"_1890":38505},[],"/docs/platform/pki/device-management#revoke-the-current-identity","Revoke the current identity",{"_2299":1058,"_22571":1047,"_5":22827,"_15405":38507,"_21315":38508,"_1890":38509},[],"/docs/platform/pki/device-management#decommission-a-device","Decommission a device",{"_2299":1059,"_22571":1047,"_5":22827,"_15405":38511,"_21315":38512,"_1890":38513},[],"/docs/platform/pki/device-management#automate-enrollment","Automate enrollment",{"_2299":1060,"_22571":1047,"_15405":38515,"_5":15294,"_21315":1047,"_1890":38516},[],"A managed device represents an entity in your fleet and keeps the history of the certificates it has used. Lamassu separates the device from its current identity so you can renew or replace certificates without losing traceability.",{"_2299":1061,"_22571":1047,"_15405":38518,"_5":15294,"_21315":38472,"_1890":38519},[],"**Active** indicates the device has a valid identity.",{"_2299":1062,"_22571":1047,"_15405":38521,"_5":15294,"_21315":38472,"_1890":38522},[],"**No Identity** appears when it is registered but does not yet have an associated certificate.",{"_2299":1063,"_22571":1047,"_15405":38524,"_5":15294,"_21315":38472,"_1890":38525},[],"**Renewal Pending** signals that it has entered the renewal window.",{"_2299":1064,"_22571":1047,"_15405":38527,"_5":15294,"_21315":38472,"_1890":38528},[],"**Expiring Soon** warns that the certificate is close to expiring.",{"_2299":1065,"_22571":1047,"_15405":38530,"_5":15294,"_21315":38472,"_1890":38531},[],"**Expired** indicates the identity has passed its validity date.",{"_2299":1066,"_22571":1047,"_15405":38533,"_5":15294,"_21315":38472,"_1890":38534},[],"**Revoked** identifies a certificate invalidated before its expiration.",{"_2299":1067,"_22571":1047,"_15405":38536,"_5":15294,"_21315":38472,"_1890":38537},[],"**Decommissioned** corresponds to a device permanently retired.",{"_2299":1068,"_22571":1047,"_15405":38539,"_5":15294,"_21315":38472,"_1890":38540},[],"The inventory lets you filter by `Device ID`, tags and status.",{"_2299":1069,"_22571":1047,"_15405":38542,"_5":15294,"_21315":38476,"_1890":38543},[],"The detail view separates two perspectives:",{"_2299":1070,"_22571":1047,"_15405":38545,"_5":15294,"_21315":38476,"_1890":38546},[],"**Certificate History** keeps every certificate associated with the device, with its serial number, issuer, status and validity period.",{"_2299":1071,"_22571":1047,"_15405":38548,"_5":15294,"_21315":38476,"_1890":38549},[],"**Device Event Timeline** orders registrations, enrollments, renewals and status changes chronologically.",{"_2299":1072,"_22571":1047,"_15405":38551,"_5":15294,"_21315":38476,"_1890":38552},[],"Use the history for audit and the timeline to reconstruct an incident or diagnose an unexpected transition.",{"_2299":1073,"_22571":1047,"_15405":38554,"_5":15294,"_21315":38480,"_1890":38555},[],"Pre-registration is useful when policy requires the device to exist before requesting its first certificate.",{"_2299":1074,"_22571":1047,"_15405":38557,"_5":15294,"_21315":38484,"_1890":38558},[],"From **Managed Devices**, open the registration form.",{"_2299":1075,"_22571":1047,"_15405":38560,"_5":15294,"_21315":38488,"_1890":38561},[],"Enter a unique **Device ID** and select the DMS that will apply the enrollment and renewal policies.",{"_2299":1076,"_22571":1047,"_15405":38563,"_5":15294,"_21315":38492,"_1890":38564},[],"Add an icon and tags if you need to group devices by model, location, environment or another operational criterion.",{"_2299":1077,"_22571":1047,"_15405":38566,"_5":15294,"_21315":38496,"_1890":38567},[],"The device should appear with status **No Identity** until it completes enrollment or receives a manually assigned identity.",{"_2299":1078,"_22571":1047,"_15405":38569,"_5":15294,"_21315":38500,"_1890":38570},[],"The **Assign Identity** action is available while the device remains in **No Identity**.",{"_2299":1079,"_22571":1047,"_15405":38572,"_5":15294,"_21315":38500,"_1890":38573},[],"Open the device and select **Assign Identity**.",{"_2299":1080,"_22571":1047,"_15405":38575,"_5":15294,"_21315":38500,"_1890":38576},[],"Choose an active certificate whose `Common Name` matches the `Device ID`.",{"_2299":1081,"_22571":1047,"_15405":38578,"_5":15294,"_21315":38500,"_1890":38579},[],"If none exists, select **Issue New Instead** and choose a CA linked to the DMS.",{"_2299":1082,"_22571":1047,"_15405":38581,"_5":15294,"_21315":38500,"_1890":38582},[],"Confirm the assignment.",{"_2299":1083,"_22571":1047,"_15405":38584,"_5":15294,"_21315":38500,"_1890":38585},[],"The device should change to **Active** and the certificate should appear in its history.",{"_2299":1084,"_22571":1047,"_15405":38587,"_5":15294,"_21315":38504,"_1890":38588},[],"In **Device Event Timeline**, locate the latest active certificate and select **Revoke**. Choose a reason consistent with your policy and confirm the operation.",{"_2299":1085,"_22571":1047,"_15405":38590,"_5":15294,"_21315":38504,"_1890":38591},[],"Revocation invalidates the certificate but does not delete the device. You can restore its operation by assigning it a new identity. `CertificateHold` allows reactivating the retained certificate; all other reasons are final.",{"_2299":1086,"_22571":1047,"_15405":38593,"_5":15294,"_21315":38508,"_1890":38594},[],"This action revokes all the device's certificates and prevents it from obtaining an identity again.",{"_2299":1087,"_22571":1047,"_15405":38596,"_5":15294,"_21315":38508,"_1890":38597},[],"Use **Decommission** only when the device has stopped operating or is no longer trustworthy. After confirming, Lamassu revokes the active identity with `CessationOfOperation` and changes the status to **Decommissioned**.",{"_2299":1088,"_22571":1047,"_15405":38599,"_5":15294,"_21315":38512,"_1890":38600},[],"<Card title=\"Configure a DMS\" description=\"Define the CA, trust and policies of the fleet.\" href=\"/docs/platform/pki/device-enrollment\" />",{"_2299":1089,"_22571":1047,"_15405":38602,"_5":15294,"_21315":38512,"_1890":38603},[],"<Card title=\"Integrate EST\" description=\"Let the device request and renew its identity.\" href=\"/docs/platform/pki/est-enrollment\" />",{"_2299":1090,"_22571":1090,"_5":10616,"_1890":38605,"_22830":38606,"_15405":38607,"_21315":1090},"Device enrollment with EST",[35156,36291,36769],[],{"_2299":1091,"_22571":1090,"_15405":38609,"_5":15294,"_21315":1090,"_1890":38610},[],"EST protocol guide for Lamassu IoT, with DMS configuration for the PKI administrator and the endpoint reference for device integrators.",{"_2299":1092,"_22571":1090,"_5":22827,"_15405":38612,"_21315":38613,"_1890":38614},[],"/docs/platform/pki/est-enrollment#est-enrollment-over-secure-transport","EST: Enrollment over Secure Transport",{"_2299":1093,"_22571":1090,"_5":22827,"_15405":38616,"_21315":38617,"_1890":38618},[],"/docs/platform/pki/est-enrollment#dms-configuration","DMS configuration",{"_2299":1094,"_22571":1090,"_5":22827,"_15405":38620,"_21315":38621,"_1890":38622},[],"/docs/platform/pki/est-enrollment#prerequisites","Prerequisites",{"_2299":1095,"_22571":1090,"_5":22827,"_15405":38624,"_21315":38625,"_1890":38626},[],"/docs/platform/pki/est-enrollment#enrollment-configuration","Enrollment configuration",{"_2299":1096,"_22571":1090,"_5":22827,"_15405":38628,"_21315":38629,"_1890":38630},[],"/docs/platform/pki/est-enrollment#enrollment-device-registration","Enrollment Device Registration",{"_2299":1097,"_22571":1090,"_5":22827,"_15405":38632,"_21315":38633,"_1890":38634},[],"/docs/platform/pki/est-enrollment#enrollment-settings","Enrollment Settings",{"_2299":1098,"_22571":1090,"_5":22827,"_15405":38636,"_21315":38637,"_1890":38638},[],"/docs/platform/pki/est-enrollment#issuance-profile","Issuance profile",{"_2299":1099,"_22571":1090,"_5":22827,"_15405":38640,"_21315":38641,"_1890":38642},[],"/docs/platform/pki/est-enrollment#re-enrollment-configuration","Re-enrollment configuration",{"_2299":1100,"_22571":1090,"_5":22827,"_15405":38644,"_21315":38645,"_1890":38646},[],"/docs/platform/pki/est-enrollment#serverkeygen-configuration","ServerKeyGen configuration",{"_2299":1101,"_22571":1090,"_5":22827,"_15405":38648,"_21315":38649,"_1890":38650},[],"/docs/platform/pki/est-enrollment#verify-the-configuration","Verify the configuration",{"_2299":1102,"_22571":1090,"_5":22827,"_15405":38652,"_21315":38653,"_1890":38654},[],"/docs/platform/pki/est-enrollment#device-integration","Device integration",{"_2299":1103,"_22571":1090,"_5":22827,"_15405":38656,"_21315":38657,"_1890":35166},[],"/docs/platform/pki/est-enrollment#before-you-begin",{"_2299":1104,"_22571":1090,"_5":22827,"_15405":38659,"_21315":38660,"_1890":38661},[],"/docs/platform/pki/est-enrollment#flow-overview","Flow overview",{"_2299":1105,"_22571":1090,"_5":22827,"_15405":38663,"_21315":38664,"_1890":38665},[],"/docs/platform/pki/est-enrollment#client-authentication-model","Client authentication model",{"_2299":1106,"_22571":1090,"_5":22827,"_15405":38667,"_21315":38668,"_1890":38669},[],"/docs/platform/pki/est-enrollment#endpoint-reference","Endpoint reference",{"_2299":1107,"_22571":1090,"_5":22827,"_15405":38671,"_21315":38672,"_1890":38673},[],"/docs/platform/pki/est-enrollment#cacerts","`/cacerts`",{"_2299":1108,"_22571":1090,"_5":22827,"_15405":38675,"_21315":38676,"_1890":38677},[],"/docs/platform/pki/est-enrollment#simpleenroll","`/simpleenroll`",{"_2299":1109,"_22571":1090,"_5":22827,"_15405":38679,"_21315":38680,"_1890":38681},[],"/docs/platform/pki/est-enrollment#simplereenroll","`/simplereenroll`",{"_2299":1110,"_22571":1090,"_5":22827,"_15405":38683,"_21315":38684,"_1890":38685},[],"/docs/platform/pki/est-enrollment#serverkeygen","`/serverkeygen`",{"_2299":1111,"_22571":1090,"_5":22827,"_15405":38687,"_21315":38688,"_1890":38689},[],"/docs/platform/pki/est-enrollment#full-flows","Full flows",{"_2299":1112,"_22571":1090,"_5":22827,"_15405":38691,"_21315":38692,"_1890":38693},[],"/docs/platform/pki/est-enrollment#end-to-end-example-enroll","End-to-end example: enroll",{"_2299":1113,"_22571":1090,"_5":22827,"_15405":38695,"_21315":38696,"_1890":38697},[],"/docs/platform/pki/est-enrollment#end-to-end-example-reenroll","End-to-end example: reenroll",{"_2299":1114,"_22571":1090,"_5":22827,"_15405":38699,"_21315":38700,"_1890":38701},[],"/docs/platform/pki/est-enrollment#next-steps-after-enrollment","Next steps after enrollment",{"_2299":1115,"_22571":1090,"_5":22827,"_15405":38703,"_21315":38704,"_1890":38705},[],"/docs/platform/pki/est-enrollment#diagnostics-and-compatibility","Diagnostics and compatibility",{"_2299":1116,"_22571":1090,"_5":22827,"_15405":38707,"_21315":38708,"_1890":38709},[],"/docs/platform/pki/est-enrollment#error-codes-and-diagnostics","Error codes and diagnostics",{"_2299":1117,"_22571":1090,"_5":22827,"_15405":38711,"_21315":38712,"_1890":38713},[],"/docs/platform/pki/est-enrollment#compatibility-notes","Compatibility notes",{"_2299":1118,"_22571":1090,"_15405":38715,"_5":15294,"_21315":38613,"_1890":38716},[],"Lamassu IoT implements the &#x2A;*EST (Enrollment over Secure Transport)** protocol described in RFC 7030 as its only certificate enrollment mechanism for devices. Each DMS exposes the EST endpoints, validates the device and applies its own authentication, registration and renewal policies. In doing so, it acts as the Registration Authority (RA) facing the client.",{"_2299":1119,"_22571":1090,"_15405":38718,"_5":15294,"_21315":38613,"_1890":38719},[],"The entity that issues and cryptographically signs the certificate is always the **CA associated with the DMS**, not the DMS. The DMS coordinates the process: it receives the CSR, authenticates the device and applies the issuance policy. This distinction matters for the PKI administrator when selecting the `EnrollmentCA` and for the integrator when interpreting the chain of trust received from `/cacerts`.",{"_2299":1120,"_22571":1090,"_15405":38721,"_5":15294,"_21315":38613,"_1890":38722},[],"This guide is split in two parts:",{"_2299":1121,"_22571":1090,"_15405":38724,"_5":15294,"_21315":38613,"_1890":38725},[],"DMS configuration, for the PKI administrator.",{"_2299":1122,"_22571":1090,"_15405":38727,"_5":15294,"_21315":38613,"_1890":38728},[],"Device integration, for anyone consuming the EST endpoints from firmware, scripts or provisioning services.",{"_2299":1123,"_22571":1090,"_15405":38730,"_5":15294,"_21315":38613,"_1890":38731},[],"If you only need a quick orientation, this is the recommended route:",{"_2299":1124,"_22571":1090,"_15405":38733,"_5":15294,"_21315":38613,"_1890":38734},[],"**PKI administrator:** start with DMS configuration and finish with Diagnostics and compatibility.",{"_2299":1125,"_22571":1090,"_15405":38736,"_5":15294,"_21315":38613,"_1890":38737},[],"**Device integrator:** start with Before you begin and continue with `/cacerts`, `/simpleenroll`, `/simplereenroll` or `/serverkeygen`, depending on the flow you will implement.",{"_2299":1126,"_22571":1090,"_15405":38739,"_5":15294,"_21315":38621,"_1890":38740},[],"Before configuring a DMS for EST, the following resources must exist on the platform:",{"_2299":1127,"_22571":1090,"_15405":38742,"_5":15294,"_21315":38621,"_1890":38743},[],"**An available CA**: the CA acting as `EnrollmentCA` must be created and active in Lamassu. If the authentication mode is `CLIENT_CERTIFICATE`, the validation CAs for the bootstrap certificate must also have been created.",{"_2299":1128,"_22571":1090,"_15405":38745,"_5":15294,"_21315":38621,"_1890":38746},[],"**A created DMS**: the DMS this configuration applies to must already exist. The EST configuration is applied over an existing DMS, it does not create one.",{"_2299":1129,"_22571":1090,"_15405":38748,"_5":15294,"_21315":38621,"_1890":38749},[],"It is worth separating four configuration blocks:",{"_2299":1130,"_22571":1090,"_15405":38751,"_5":15294,"_21315":38621,"_1890":38752},[],"How the initial enrollment will be performed, including the registration mode and client authentication.",{"_2299":1131,"_22571":1090,"_15405":38754,"_5":15294,"_21315":38621,"_1890":38755},[],"How the re-enrollment of already-issued certificates will be handled.",{"_2299":1132,"_22571":1090,"_15405":38757,"_5":15294,"_21315":38621,"_1890":38758},[],"How the cacerts endpoint will be configured to distribute the CAs devices use as trust anchors.",{"_2299":1133,"_22571":1090,"_15405":38760,"_5":15294,"_21315":38621,"_1890":38761},[],"Whether server-side key generation through `ServerKeyGen` will be enabled.",{"_2299":1134,"_22571":1090,"_15405":38763,"_5":15294,"_21315":38629,"_1890":38764},[],"This section defines how new devices are registered and with which credentials they authenticate.",{"_2299":1135,"_22571":1090,"_15405":38766,"_5":15294,"_21315":38629,"_1890":38767},[],"**Registration Mode**: determines the behavior when receiving an initial enrollment. In `JITP` (*Just-In-Time Provisioning*) mode, the device is created automatically the first time it presents itself, applying the tags, metadata and icon defined in the provisioning profile. In `PRE_REGISTRATION` mode, the device must already exist on the platform; if it does not, the request is rejected with `device not preregistered`. JITP mode suits large fleets where the inventory is built during deployment; `PRE_REGISTRATION` fits high-security environments where each device is explicitly approved before receiving a certificate.",{"_2299":1136,"_22571":1090,"_15405":38769,"_5":15294,"_21315":38629,"_1890":38770},[],"**Tags**: applied to each device automatically created by this DMS. They are optional and only take effect in JITP mode. Tags improve device search.",{"_2299":1137,"_22571":1090,"_15405":38772,"_5":15294,"_21315":38629,"_1890":38773},[],"**Icon**: applied to each device automatically created by this DMS. It is optional and only takes effect in JITP mode. Purely visual.",{"_2299":1138,"_22571":1090,"_15405":38775,"_5":15294,"_21315":38633,"_1890":38776},[],"**Enrollment CA**: identifies the CA that will sign the identity certificates issued through this DMS. Its choice determines the chain of trust the device will receive and the root against which backend systems will validate fleet certificates.",{"_2299":1139,"_22571":1090,"_15405":38778,"_5":15294,"_21315":38633,"_1890":38779},[],"**Allow Override Enrollment** (`enable_replaceable_enrollment`): allows an already-enrolled device to enroll again through `/simpleenroll`. When active, the previous certificate is revoked with the reason `superseded` and the identity slot is updated. When inactive, a second `simpleenroll` attempt is rejected with `forbiddenNewEnrollment`. This option must be enabled with care in production environments, since it lets you replace a device's identity without going through the re-enrollment flow.",{"_2299":1140,"_22571":1090,"_15405":38781,"_5":15294,"_21315":38633,"_1890":38782},[],"**Verify CSR Signature** (`verify_csr_signature`): controls whether the server validates the CSR signature against the public key declared in it (PKCS#10 proof of possession). When inactive, a requester could submit a CSR with a public key it does not control and obtain a certificate bound to it. For IoT fleets on open networks it must be enabled.",{"_2299":1141,"_22571":1090,"_15405":38784,"_5":15294,"_21315":38633,"_1890":38785},[],"**Authentication Mode**: defines how the DMS validates the device identity during enrollment. It can require an mTLS certificate (`CLIENT_CERTIFICATE`), delegate authorization to a webhook (`EXTERNAL_WEBHOOK`), combine both controls (`CLIENT_CERTIFICATE_AND_EXTERNAL_WEBHOOK`) or accept unauthenticated requests (`NO_AUTH`). The latter must be limited to isolated labs or provisioning networks.",{"_2299":1142,"_22571":1090,"_15405":38787,"_5":15294,"_21315":38633,"_1890":38788},[],"When the mode is `CLIENT_CERTIFICATE` or `CLIENT_CERTIFICATE_AND_EXTERNAL_WEBHOOK`, these parameters are also configured:",{"_2299":1143,"_22571":1090,"_15405":38790,"_5":15294,"_21315":38633,"_1890":38791},[],"**Validation CAs**: list of trusted CAs to validate the bootstrap certificate presented by the device.",{"_2299":1144,"_22571":1090,"_15405":38793,"_5":15294,"_21315":38633,"_1890":38794},[],"**Chain Validation Level**: maximum depth of the validation chain. The value `-1` validates the full chain up to the root CA.",{"_2299":1145,"_22571":1090,"_15405":38796,"_5":15294,"_21315":38633,"_1890":38797},[],"**Allow Authenticating Expired Certificates**: if active, accepts expired client certificates. Useful in recovery scenarios where the device could not renew its certificate in time.",{"_2299":1146,"_22571":1090,"_15405":38799,"_5":15294,"_21315":38633,"_1890":38800},[],"When the mode includes `EXTERNAL_WEBHOOK`, these parameters are also configured:",{"_2299":1147,"_22571":1090,"_15405":38802,"_5":15294,"_21315":38633,"_1890":38803},[],"**Webhook URL**: address of the external service that will decide authorization.",{"_2299":1148,"_22571":1090,"_15405":38805,"_5":15294,"_21315":38633,"_1890":38806},[],"**HTTP Method**: HTTP method used to invoke the webhook. Supports `POST` (default) or `PUT`; both are equivalent for the webhook, only the verb Lamassu uses changes.",{"_2299":1149,"_22571":1090,"_15405":38808,"_5":15294,"_21315":38633,"_1890":38809},[],"**Timeout**: maximum wait time for the webhook call. If not specified, the default is **10 seconds**; after that without a response, Lamassu denies the operation.",{"_2299":1150,"_22571":1090,"_15405":38811,"_5":15294,"_21315":38633,"_1890":38812},[],"**Webhook Authentication Mode**: authentication mode of the webhook toward the external service, for example `ApiKey`, `OIDC` or `mTLS`.",{"_2299":1151,"_22571":1090,"_15405":38814,"_5":15294,"_21315":38633,"_1890":38815},[],"The exact contract the webhook service must implement (request and response schema, examples) is published as an OpenAPI specification: authorization webhook reference.",{"_2299":1152,"_22571":1090,"_15405":38817,"_5":15294,"_21315":38637,"_1890":38818},[],"The behavior of the issued certificate is not determined solely by the device's CSR, but by the **issuance profile** (`IssuanceProfile`) associated with the DMS. The integrator does not configure this profile, but its rules affect the content of the final certificate:",{"_2299":1153,"_22571":1090,"_15405":38820,"_5":15294,"_21315":38637,"_1890":38821},[],"**`HonorSubject`** controls whether the CSR's subject is copied verbatim into the certificate. If disabled, the CA applies the profile's template and ignores the received subject.",{"_2299":1154,"_22571":1090,"_15405":38823,"_5":15294,"_21315":38637,"_1890":38824},[],"**`HonorKeyUsage`** decides whether the CSR's `KeyUsage` is respected or replaced by the one defined in the template.",{"_2299":1155,"_22571":1090,"_15405":38826,"_5":15294,"_21315":38637,"_1890":38827},[],"**`HonorExtendedKeyUsages`** applies the same rule to `ExtKeyUsage`.",{"_2299":1156,"_22571":1090,"_15405":38829,"_5":15294,"_21315":38637,"_1890":38830},[],"**`HonorExtensions`** controls whether the rest of the CSR's extensions, such as SAN or CDP, are included in the certificate.",{"_2299":1157,"_22571":1090,"_15405":38832,"_5":15294,"_21315":38637,"_1890":38833},[],"This matters for the integrator: the `KeyUsage`, `ExtKeyUsage` and SANs declared in the CSR may not appear as-is in the final certificate if the profile decides otherwise. Check with the PKI administrator if the issued certificate does not contain the expected extensions.",{"_2299":1158,"_22571":1090,"_15405":38835,"_5":15294,"_21315":38641,"_1890":38836},[],"The **Re-Enrollment Settings** section controls the certificate renewal process. Re-enrollment can only be performed while the certificate is within the configured window, and optionally also when the certificate has already expired.",{"_2299":1159,"_22571":1090,"_15405":38838,"_5":15294,"_21315":38641,"_1890":38839},[],"**Revoke On Re-Enroll**: if active, the previous certificate is automatically revoked with the reason `superseded` once the new one is issued.",{"_2299":1160,"_22571":1090,"_15405":38841,"_5":15294,"_21315":38641,"_1890":38842},[],"**Allow Expired Renewal**: allows renewing an already-expired certificate. Useful when a device has been offline and could not renew within the window.",{"_2299":1161,"_22571":1090,"_15405":38844,"_5":15294,"_21315":38641,"_1890":38845},[],"**Allowed Renewal Delta**: time window before expiration during which re-enrollment is allowed. Before this window opens, the request is rejected with `invalid reenroll window`.",{"_2299":1162,"_22571":1090,"_15405":38847,"_5":15294,"_21315":38641,"_1890":38848},[],"**Preventive Renewal Delta**: time before expiration from which preventive renewal alerts are raised.",{"_2299":1163,"_22571":1090,"_15405":38850,"_5":15294,"_21315":38641,"_1890":38851},[],"**Critical Renewal Delta**: threshold closest to expiration that triggers critical status alerts.",{"_2299":1164,"_22571":1090,"_15405":38853,"_5":15294,"_21315":38641,"_1890":38854},[],"**Additional Validation CAs**: additional CAs accepted as issuers of the active certificate during re-enrollment. It allows migrating to a new enrollment CA without interrupting the renewal of devices already enrolled with the previous CA.",{"_2299":1165,"_22571":1090,"_15405":38856,"_5":15294,"_21315":38645,"_1890":38857},[],"The **Server Key Generation** section lets Lamassu generate the device's key pair on the server and return it together with the issued certificate. It is useful for devices with limited cryptographic capability.",{"_2299":1166,"_22571":1090,"_15405":38859,"_5":15294,"_21315":38645,"_1890":38860},[],"The **Enable Server-Side Key Generation** option activates the `/serverkeygen` endpoint. When inactive, any call to that endpoint is rejected with `server key generation not enabled`.",{"_2299":1167,"_22571":1090,"_15405":38862,"_5":15294,"_21315":38645,"_1890":38863},[],"**Key Type** selects the algorithm: `RSA` or `ECDSA`. The &#x2A;*Key Size (bits)** field determines the key size. For ECDSA, the size in bits also determines the curve: 256 corresponds to P-256, 384 to P-384 and 521 to P-521.",{"_2299":1168,"_22571":1090,"_15405":38865,"_5":15294,"_21315":38645,"_1890":38866},[],"The key is generated in the server's software engine, not in a hardware Crypto Engine such as AWS KMS or PKCS#11. The only protection of the key in transit is the TLS channel; no additional encryption (CMS EnvelopedData) is applied to the key before sending it to the device. See the `/serverkeygen` section of the integrator reference for the exact response format and security considerations.",{"_2299":1169,"_22571":1090,"_15405":38868,"_5":15294,"_21315":38649,"_1890":38869},[],"Once the enrollment, re-enrollment and ServerKeyGen settings are applied, you can confirm the DMS is operational as follows:",{"_2299":1170,"_22571":1090,"_15405":38871,"_5":15294,"_21315":38649,"_1890":38872},[],"**From the console**: open the DMS detail and check that the EST section shows the assigned enrollment CA and the configured authentication mode.",{"_2299":1171,"_22571":1090,"_15405":38874,"_5":15294,"_21315":38649,"_1890":38875},[],"**With a test request**: invoke the DMS's `/cacerts` endpoint from a `curl` client with server trust. A `200 OK` response with base64 content confirms the DMS is active and the enrollment CA is reachable.",{"_2299":1172,"_22571":1090,"_15405":38877,"_5":15294,"_21315":38649,"_1890":38878},[],"If the DMS does not exist or the CA is not available, the server responds with `DMS not found` or another error message. See the Diagnostics and compatibility section to interpret error messages.",{"_2299":1173,"_22571":1090,"_15405":38880,"_5":15294,"_21315":38653,"_1890":38881},[],"*This section is aimed at device integrators.*",{"_2299":1174,"_22571":1090,"_15405":38883,"_5":15294,"_21315":38653,"_1890":38884},[],"Lamassu's EST endpoints are published under the `/.well-known/est` prefix and always require the presence of the `{aps}` path segment, interpreted as the identifier of the DMS the operation targets. The association is direct: the `{aps}` value received in the URL is used as the DMS ID when querying the internal store. Variants registered without `{aps}` (for example `/.well-known/est/cacerts`) are routed in the code, but their handler requires the `APS` field and returns `400 Bad Request` with the message `Field validation for 'APS' failed` when the segment is not provided.",{"_2299":1175,"_22571":1090,"_15405":38886,"_5":15294,"_21315":38653,"_1890":38887},[],"This part follows the integrator's usual working order: first the prerequisites and the authentication model, then the reference for each endpoint and, finally, complete examples and diagnostic material.",{"_2299":1176,"_22571":1090,"_15405":38889,"_5":15294,"_21315":38657,"_1890":38890},[],"The PKI administrator must have configured a DMS with the `EST_RFC7030` protocol, an assigned enrollment CA and at least one authentication mode. Without that prior configuration, Lamassu rejects any enrollment request. The details of that configuration are in the DMS configuration section of this same page.",{"_2299":1177,"_22571":1090,"_15405":38892,"_5":15294,"_21315":38657,"_1890":38893},[],"Before making the first call, make sure you have:",{"_2299":1178,"_22571":1090,"_15405":38895,"_5":15294,"_21315":38657,"_1890":38896},[],"**The EST host URL**, for example `https://est.lamassu.example`, provided by the PKI administrator.",{"_2299":1179,"_22571":1090,"_15405":38898,"_5":15294,"_21315":38657,"_1890":38899},[],"**The server trust anchor** (`lamassu-trust.pem`), root or intermediate, with which the client will validate Lamassu's TLS.",{"_2299":1180,"_22571":1090,"_15405":38901,"_5":15294,"_21315":38657,"_1890":38902},[],"**The bootstrap certificate and its private key** if the DMS uses `CLIENT_CERTIFICATE` or `CLIENT_CERTIFICATE_AND_EXTERNAL_WEBHOOK`. This identity must come from one of the configured `ValidationCAs`, usually a provisioning CA different from the enrollment CA.",{"_2299":1181,"_22571":1090,"_15405":38904,"_5":15294,"_21315":38657,"_1890":38905},[],"**The DMS ID** (`{aps}`), which must appear in every EST route.",{"_2299":1182,"_22571":1090,"_15405":38907,"_5":15294,"_21315":38660,"_1890":38908},[],"**Download trust with `/cacerts`:** the client validates the server's TLS and receives the certificates in PKCS#7 or PEM.",{"_2299":1183,"_22571":1090,"_15405":38910,"_5":15294,"_21315":38660,"_1890":38911},[],"**Perform initial enrollment with `/simpleenroll`:** present the bootstrap certificate or the credential defined by `AuthMode` to obtain the device certificate.",{"_2299":1184,"_22571":1090,"_15405":38913,"_5":15294,"_21315":38660,"_1890":38914},[],"**Renew with `/simplereenroll`:** authenticate with the device's current certificate to obtain a new one.",{"_2299":1185,"_22571":1090,"_15405":38916,"_5":15294,"_21315":38660,"_1890":38917},[],"**Use `/serverkeygen` only if you need server-side key generation:** it applies the same authentication as `/simpleenroll` and returns the PKCS#8 private key together with the certificate.",{"_2299":1186,"_22571":1090,"_15405":38919,"_5":15294,"_21315":38664,"_1890":38920},[],"Lamassu's implementation recognizes four authentication configurations for `/simpleenroll`, expressed through the DMS's `EnrollmentOptionsESTRFC7030.AuthMode` field. Three are simple modes (`CLIENT_CERTIFICATE`, `EXTERNAL_WEBHOOK`, `NO_AUTH`) and one combines two controls (`CLIENT_CERTIFICATE_AND_EXTERNAL_WEBHOOK`). The client must present itself in the mode the DMS expects; any other combination fails the enrollment.",{"_2299":1187,"_22571":1090,"_15405":38922,"_5":15294,"_21315":38664,"_1890":38923},[],"Mode (`AuthMode`)",{"_2299":1188,"_22571":1090,"_15405":38925,"_5":15294,"_21315":38664,"_1890":38318},[],{"_2299":1189,"_22571":1090,"_15405":38927,"_5":15294,"_21315":38664,"_1890":38928},[],"Expected credential",{"_2299":1190,"_22571":1090,"_15405":38930,"_5":15294,"_21315":38664,"_1890":38931},[],"Applies in enroll",{"_2299":1191,"_22571":1090,"_15405":38933,"_5":15294,"_21315":38664,"_1890":38934},[],"Applies in reenroll",{"_2299":1192,"_22571":1090,"_15405":38936,"_5":15294,"_21315":38664,"_1890":38937},[],"`CLIENT_CERTIFICATE`",{"_2299":1193,"_22571":1090,"_15405":38939,"_5":15294,"_21315":38664,"_1890":38940},[],"mTLS with X.509 certificate",{"_2299":1194,"_22571":1090,"_15405":38942,"_5":15294,"_21315":38664,"_1890":38943},[],"Client certificate and private key",{"_2299":1195,"_22571":1090,"_15405":38945,"_5":15294,"_21315":38664,"_1890":38946},[],"Yes",{"_2299":1196,"_22571":1090,"_15405":38948,"_5":15294,"_21315":38664,"_1890":38949},[],"Yes (with the active certificate)",{"_2299":1197,"_22571":1090,"_15405":38951,"_5":15294,"_21315":38664,"_1890":38952},[],"`CLIENT_CERTIFICATE_AND_EXTERNAL_WEBHOOK`",{"_2299":1198,"_22571":1090,"_15405":38954,"_5":15294,"_21315":38664,"_1890":38955},[],"mTLS plus webhook validation",{"_2299":1199,"_22571":1090,"_15405":38957,"_5":15294,"_21315":38664,"_1890":38958},[],"Client certificate and private key, plus webhook approval",{"_2299":1200,"_22571":1090,"_15405":38960,"_5":15294,"_21315":38664,"_1890":38946},[],{"_2299":1201,"_22571":1090,"_15405":38962,"_5":15294,"_21315":38664,"_1890":38963},[],"Not as a combination; in reenroll both controls are not kept",{"_2299":1202,"_22571":1090,"_15405":38965,"_5":15294,"_21315":38664,"_1890":38966},[],"`EXTERNAL_WEBHOOK`",{"_2299":1203,"_22571":1090,"_15405":38968,"_5":15294,"_21315":38664,"_1890":38969},[],"External authorization webhook",{"_2299":1204,"_22571":1090,"_15405":38971,"_5":15294,"_21315":38664,"_1890":38972},[],"None on the TLS channel",{"_2299":1205,"_22571":1090,"_15405":38974,"_5":15294,"_21315":38664,"_1890":38946},[],{"_2299":1206,"_22571":1090,"_15405":38976,"_5":15294,"_21315":38664,"_1890":38977},[],"No, degrades to `NO_AUTH`",{"_2299":1207,"_22571":1090,"_15405":38979,"_5":15294,"_21315":38664,"_1890":38980},[],"`NO_AUTH`",{"_2299":1208,"_22571":1090,"_15405":38982,"_5":15294,"_21315":38664,"_1890":38983},[],"No authentication",{"_2299":1209,"_22571":1090,"_15405":38985,"_5":15294,"_21315":38664,"_1890":38986},[],"None",{"_2299":1210,"_22571":1090,"_15405":38988,"_5":15294,"_21315":38664,"_1890":38989},[],"Yes (restricted use)",{"_2299":1211,"_22571":1090,"_15405":38991,"_5":15294,"_21315":38664,"_1890":38989},[],{"_2299":1212,"_22571":1090,"_15405":38993,"_5":15294,"_21315":38664,"_1890":38994},[],"JWT **is not a valid authentication mode in EST**. The JWT identity extractor exists in the code but is only evaluated in Lamassu's administration API. Any *Bearer token* sent to `/.well-known/est/...` is silently ignored. When the DMS is configured with `AuthMode: CLIENT_CERTIFICATE`, a request carrying only a JWT is rejected for lack of a client certificate. When the DMS is in `AuthMode: NO_AUTH`, the request is processed as such and the JWT neither adds nor removes authorization.",{"_2299":1213,"_22571":1090,"_15405":38996,"_5":15294,"_21315":38664,"_1890":38997},[],"**`CLIENT_CERTIFICATE`**: the client presents an X.509 certificate issued by one of the CAs declared in `AuthOptionsMTLS.ValidationCAs`. The process validates the certificate chain against those CAs through the `ValidationCAs`, `AllowExpired` and `ChainLevelValidation` parameters. In addition, the service checks the revocation status in three steps: first it looks up the cert in Lamassu's local database; if not found, it queries the OCSP responders listed in the AIA extension; if OCSP fails, it tries the CRL Distribution Points (CDP). A revoked certificate interrupts the enrollment with `certificate is revoked`.",{"_2299":1214,"_22571":1090,"_15405":38999,"_5":15294,"_21315":38664,"_1890":39000},[],"Its main parameters are `ValidationCAs`, the list of CAs that can validate the bootstrap certificate or the active certificate; `AllowExpired`, which allows accepting expired client certificates; and `ChainLevelValidation`, which limits the chain depth when its value is greater than zero.",{"_2299":1215,"_22571":1090,"_15405":39002,"_5":15294,"_21315":38664,"_1890":39003},[],"**`EXTERNAL_WEBHOOK`**: Lamassu delegates the authorization decision to an external HTTP service. The EST server builds a `POST` request to the configured webhook with a JSON body reproducing the enrollment context.",{"_2299":1216,"_22571":1090,"_15405":39005,"_5":15294,"_21315":38664,"_1890":39006},[],"The value of the `csr` field is the **base64 encoding of the CSR's PEM** (not the DER, and not the plain PEM). The webhook must respond with `2xx` and a JSON body `{\"authorized\": true}` to continue; any other response aborts the enrollment with `external webhook denied enrollment`. A `204 No Content` **is not a valid response** even though it is a `2xx` code: Lamassu requires a JSON body with the `authorized` field, so a webhook responding without a body denies the operation just like an error.",{"_2299":1217,"_22571":1090,"_15405":39008,"_5":15294,"_21315":38664,"_1890":39009},[],"**`CLIENT_CERTIFICATE_AND_EXTERNAL_WEBHOOK`**: combines the two previous modes during `/simpleenroll`. The client must present a valid mTLS certificate and the webhook must return `authorized: true`. In `/simplereenroll` the combination is not preserved: the joint mTLS + webhook check is not maintained, so the integrator must not assume the same guarantees of the initial enrollment apply in reenroll.",{"_2299":1218,"_22571":1090,"_15405":39011,"_5":15294,"_21315":38664,"_1890":39012},[],"**`NO_AUTH`**: the DMS accepts any CSR without validating the client's identity. Lamassu logs a warning (`DMS is configured with NoAuth, allowing enrollment`) and proceeds with the registration. It must be restricted to controlled environments (an isolated provisioning network); any network exposed to the internet with a DMS in `NO_AUTH` is open to certificate issuance by unauthorized third parties.",{"_2299":1219,"_22571":1090,"_15405":39014,"_5":15294,"_21315":38668,"_1890":39015},[],"The following sections describe the endpoints in the usual order of use within the device lifecycle:",{"_2299":1220,"_22571":1090,"_15405":39017,"_5":15294,"_21315":38668,"_1890":39018},[],"`/cacerts`: download of the trust chain.",{"_2299":1221,"_22571":1090,"_15405":39020,"_5":15294,"_21315":38668,"_1890":39021},[],"`/simpleenroll`: initial certificate enrollment.",{"_2299":1222,"_22571":1090,"_15405":39023,"_5":15294,"_21315":38668,"_1890":39024},[],"`/simplereenroll`: renewal of an already-issued certificate.",{"_2299":1223,"_22571":1090,"_15405":39026,"_5":15294,"_21315":38668,"_1890":39027},[],"`/serverkeygen`: enrollment with server-side key generation.",{"_2299":1224,"_22571":1090,"_15405":39029,"_5":15294,"_21315":38672,"_1890":39030},[],"The endpoint `GET /.well-known/est/{aps}/cacerts` distributes the certificates the device needs to validate the EST server and the rest of the CAs managed by the DMS. Lamassu inserts the certificates in this order: first the **downstream** certificate of the Lamassu server, which is the server's TLS leaf and not a CA, useful for pinning if `IncludeLamassuSystemCA` is enabled; then the `ManagedCAs` list declared in the DMS; and last the enrollment CA, if `IncludeEnrollmentCA` is enabled.",{"_2299":1225,"_22571":1090,"_15405":39032,"_5":15294,"_21315":38672,"_1890":39033},[],"`CADistributionSettings` lets you decide what is published:",{"_2299":1226,"_22571":1090,"_15405":39035,"_5":15294,"_21315":38672,"_1890":39036},[],"**`IncludeLamassuSystemCA`** adds the *downstream* certificate of the Lamassu server. It is the TLS leaf the client can use to pin the connection, not a CA.",{"_2299":1227,"_22571":1090,"_15405":39038,"_5":15294,"_21315":38672,"_1890":39039},[],"**`IncludeEnrollmentCA`** adds the DMS's issuing CA, responsible for signing device certificates.",{"_2299":1228,"_22571":1090,"_15405":39041,"_5":15294,"_21315":38672,"_1890":39042},[],"**`ManagedCAs`** publishes additional CAs as trust anchors.",{"_2299":1229,"_22571":1090,"_15405":39044,"_5":15294,"_21315":38672,"_1890":39045},[],"The default format is *degenerate* PKCS#7 (certificates only) base64-encoded. The response declares `Content-Type: application/pkcs7-mime; smime-type=certs-only` and `Content-Transfer-Encoding: base64`. The base64 is wrapped in lines of **76 characters** terminated with CRLF, a width compliant with S/MIME (RFC 5751), not the 64 that some RFC 7030 guides suggest. This wrapping applies only to `/cacerts` and `/simpleenroll`; the internal parts of `/serverkeygen` carry no wrap, as explained below.",{"_2299":1230,"_22571":1090,"_15405":39047,"_5":15294,"_21315":38672,"_1890":39048},[],"*Degenerate* PKCS#7 is a **set** of certificates with no defined semantic order. Although Lamassu inserts them in the order stated, the integrator must not assume that order when validating chains: the chain must be built by `Subject`/`Issuer` matching (or by AKI/SKI), not by position in the response.",{"_2299":1231,"_22571":1090,"_15405":39050,"_5":15294,"_21315":38672,"_1890":39051},[],"The `-i` flag (ignore garbage) helps tolerate the CRLF Lamassu adds and is necessary on some `base64` implementations (BusyBox, BSD); on GNU coreutils it is ignored.",{"_2299":1232,"_22571":1090,"_15405":39053,"_5":15294,"_21315":38672,"_1890":39054},[],"Lamassu additionally adds an extension over the RFC: if the client sends the `Accept: application/x-pem-file` header, the server responds with the PEM concatenation of the same certificates, without the PKCS#7 wrapper. This makes consumption from scripts easier. The extension also works on `/simpleenroll` and `/simplereenroll`.",{"_2299":1233,"_22571":1090,"_15405":39056,"_5":15294,"_21315":38676,"_1890":39057},[],"The endpoint `POST /.well-known/est/{aps}/simpleenroll` receives a CSR and returns the issued certificate. The request body must be the **PKCS#10 (CSR) in DER, base64-encoded** without line breaks. The base64 wraps the DER directly, not a PEM. The `Content-Type` header must be `application/pkcs10`. If the `Content-Type` is different, the server responds `400` with `content-type must be application/pkcs10`; if the body is not valid base64, it responds `400` with `body payload must be base64 encoded`.",{"_2299":1234,"_22571":1090,"_15405":39059,"_5":15294,"_21315":38676,"_1890":39060},[],"The response follows the same wrapper as `/cacerts`: *degenerate* PKCS#7 in base64, with `Content-Type: application/pkcs7-mime; smime-type=certs-only`. The PKCS#7 contains **only the newly issued leaf certificate**; it does not include the issuing CA or intermediates. This complies with RFC 7030 §4.2.3 (where the chain is optional) but implies the integrator must combine this certificate with the chain obtained from `/cacerts` before presenting it to any relying party that validates the full chain (for example, an MQTT broker with strict mTLS).",{"_2299":1235,"_22571":1090,"_15405":39062,"_5":15294,"_21315":38676,"_1890":39063},[],"Several DMS fields govern the behavior of `/simpleenroll`. The integrator does not configure them, but it helps to know them to interpret rejections:",{"_2299":1236,"_22571":1090,"_15405":39065,"_5":15294,"_21315":38676,"_1890":39066},[],"**`EnrollmentSettings.RegistrationMode`** decides whether the device is created during the first enrollment (`JITP`) or must exist beforehand (`PRE_REGISTRATION`).",{"_2299":1237,"_22571":1090,"_15405":39068,"_5":15294,"_21315":38676,"_1890":39069},[],"**`EnrollmentSettings.EnableReplaceableEnrollment`** allows repeating `/simpleenroll` for an already-enrolled device. When doing so, it revokes the previous certificate as `superseded`; if disabled, the server responds with `forbiddenNewEnrollment`.",{"_2299":1238,"_22571":1090,"_15405":39071,"_5":15294,"_21315":38676,"_1890":39072},[],"**`EnrollmentSettings.VerifyCSRSignature`** validates that whoever submits the CSR controls the declared private key. For IoT fleets on open networks it must be enabled.",{"_2299":1239,"_22571":1090,"_15405":39074,"_5":15294,"_21315":38676,"_1890":39075},[],"In `JITP` mode, the first `simpleenroll` with a `CommonName` that does not yet exist in Lamassu creates the device automatically. In `PRE_REGISTRATION` mode, the device must exist beforehand; an unknown `CommonName` is rejected with `device not preregistered`. See Enrollment configuration for more details on both modes and the behavior of the issuance profile.",{"_2299":1240,"_22571":1090,"_15405":39077,"_5":15294,"_21315":38680,"_1890":39078},[],"The endpoint `POST /.well-known/est/{aps}/simplereenroll` renews the certificate of an already-enrolled device. The body format is identical to `/simpleenroll` (DER base64 without line breaks, `Content-Type: application/pkcs10`). The difference lies in authentication: the client must present **the device's active certificate** (not the bootstrap) as the mTLS credential.",{"_2299":1241,"_22571":1090,"_15405":39080,"_5":15294,"_21315":38680,"_1890":39081},[],"If the DMS is configured with `AuthMode: EXTERNAL_WEBHOOK`, the webhook is **not invoked** during `/simplereenroll`. The renewal flow silently degrades to `NO_AUTH`: any client that knows a valid `CommonName` can request reenroll for that device without authentication (`allowing reenroll: using NO AUTH mode` in the log). A DMS with `EXTERNAL_WEBHOOK` must not be used in production for reenroll flows unless access to the endpoint is network-controlled.",{"_2299":1242,"_22571":1090,"_15405":39083,"_5":15294,"_21315":38680,"_1890":39084},[],"The behavior of reenroll is governed by several `ReEnrollmentSettings` fields:",{"_2299":1243,"_22571":1090,"_15405":39086,"_5":15294,"_21315":38680,"_1890":39087},[],"**`ReEnrollmentDelta`** opens the renewal window at `NotAfter - ReEnrollmentDelta`. Before that instant, the server responds with `invalid reenroll window`.",{"_2299":1244,"_22571":1090,"_15405":39089,"_5":15294,"_21315":38680,"_1890":39090},[],"**`EnableExpiredRenewal`** allows using an already-expired certificate as proof of identity; if disabled, the server responds with `expired certificate`.",{"_2299":1245,"_22571":1090,"_15405":39092,"_5":15294,"_21315":38680,"_1890":39093},[],"**`RevokeOnReEnrollment`** revokes the previous certificate as `superseded` after issuing the new one.",{"_2299":1246,"_22571":1090,"_15405":39095,"_5":15294,"_21315":38680,"_1890":39096},[],"**`AdditionalValidationCAs`** adds valid issuers for the current certificate, in addition to the DMS's enrollment CA.",{"_2299":1247,"_22571":1090,"_15405":39098,"_5":15294,"_21315":38680,"_1890":39099},[],"**Subject immutability**: the renewal CSR must have exactly the same subject as the active certificate. Lamassu compares, byte by byte, the `RawSubject` of the CSR with the certificate's (`slices.Compare`). If the bytes differ, the server falls back to a semantic comparison over the `CommonName`, `OrganizationalUnit`, `Organization`, `Locality`, `Province` and `Country` attributes. If all those attributes match, the reenroll continues despite the byte difference (rescuing cases where only the encoding changes, `PrintableString` versus `UTF8String`). If any attribute differs, the reenroll aborts with `invalid RawSubject bytes`. The integrator must regenerate the CSR with exactly the same subject as in the initial enrollment to avoid depending on fallback behavior.",{"_2299":1248,"_22571":1090,"_15405":39101,"_5":15294,"_21315":38680,"_1890":39102},[],"**Validation of the presented certificate's chain**: validation is first attempted against the DMS's enrollment CA; if it fails, it walks the `AdditionalValidationCAs`. Validation is \"shallow\": each CA is tested as an anchor, no multi-level chain is composed. The client must present the complete chain in the mTLS handshake. A revoked certificate aborts the reenroll with `certificate is revoked`.",{"_2299":1249,"_22571":1090,"_15405":39104,"_5":15294,"_21315":38684,"_1890":39105},[],"The endpoint `POST /.well-known/est/{aps}/serverkeygen` lets Lamassu generate the device's key pair on the server and return, in the same response, the private key and the issued certificate. It is useful for devices with limited cryptographic capability or flows where the key is provisioned during manufacturing.",{"_2299":1250,"_22571":1090,"_15405":39107,"_5":15294,"_21315":38684,"_1890":39108},[],"This endpoint requires `ServerKeyGen.Enabled` to be `true` in the DMS. If it is not enabled, the server responds with `server key generation not enabled`. Authentication applies the same way as in `/simpleenroll`: the integrator presents the credential matching the DMS's `AuthMode`.",{"_2299":1251,"_22571":1090,"_15405":39110,"_5":15294,"_21315":38684,"_1890":39111},[],"The algorithm and size of the generated key are decided by the DMS, not by the client.",{"_2299":1252,"_22571":1090,"_15405":39113,"_5":15294,"_21315":38684,"_1890":39114},[],"**RSA** supports any size accepted by `crypto/rsa`; common values are 2048, 3072 and 4096 bits. An invalid value fails generation with a `500` error.",{"_2299":1253,"_22571":1090,"_15405":39116,"_5":15294,"_21315":38684,"_1890":39117},[],"**ECDSA** supports 224, 256, 384 and 521 bits, equivalent to P-224, P-256 (`prime256v1`), P-384 and P-521. Any other value **silently** degrades to P-256 and only leaves a warning in the log: the client receives no error and may obtain a curve different from the expected one.",{"_2299":1254,"_22571":1090,"_15405":39119,"_5":15294,"_21315":38684,"_1890":39120},[],"The CSR sent by the client serves only to carry the subject and extensions; the PKCS#10 proof of possession does not apply here because the client is not the one who generated the key. Lamassu discards the original CSR's public key, generates a new key pair with its internal entropy, in a software engine and not in a hardware Crypto Engine such as AWS KMS or PKCS#11, builds a new CSR with that key and proceeds with an internal enrollment equivalent to `/simpleenroll`.",{"_2299":1255,"_22571":1090,"_15405":39122,"_5":15294,"_21315":38684,"_1890":39123},[],"The response is a `multipart/mixed` with the literal boundary `estServerLamassuBoundary`. It contains two parts:",{"_2299":1256,"_22571":1090,"_15405":39125,"_5":15294,"_21315":38684,"_1890":39126},[],"The private key in **unencrypted PKCS#8** format, base64-encoded inside a part with `Content-Type: application/pkcs8`.",{"_2299":1257,"_22571":1090,"_15405":39128,"_5":15294,"_21315":38684,"_1890":39129},[],"The issued certificate in *degenerate* PKCS#7 base64, inside a part with `Content-Type: application/pkcs7-mime; smime-type=certs-only`.",{"_2299":1258,"_22571":1090,"_15405":39131,"_5":15294,"_21315":38684,"_1890":39132},[],"Unlike `/cacerts` and `/simpleenroll`, where the base64 is wrapped in 76-character lines, each part of `/serverkeygen` travels as **a single base64 line without breaks**. Any reverse proxy that rewrites the body (for example, normalizing line endings) can break the parsing.",{"_2299":1259,"_22571":1090,"_15405":39134,"_5":15294,"_21315":38684,"_1890":39135},[],"This endpoint reverses the PKI principle whereby the subscriber controls its own private key. The key is serialized as unencrypted PKCS#8 (`PrivateKeyInfo`, without `EncryptedPrivateKeyInfo`). The CMS `EnvelopedData` wrapper contemplated in RFC 7030 §4.4.2 is not applied; no AES key wrap or password-based symmetric encryption is used. The only protection is the channel's TLS. The integrator must guarantee that: (a) no reverse proxy terminates TLS and logs the response body; (b) the key is encrypted at rest immediately after receipt; (c) the audit account on the Lamassu server remains the single point of origin of the key.",{"_2299":1260,"_22571":1090,"_15405":39137,"_5":15294,"_21315":38684,"_1890":39138},[],"To separate the two parts, the following snippet uses `awk` with the literal boundary. It works with Lamassu's exact structure (each part = headers + blank line + a single base64 line); any intermediate proxy rewriting the body will break it.",{"_2299":1261,"_22571":1090,"_15405":39140,"_5":15294,"_21315":38688,"_1890":39141},[],"Once the endpoints have been reviewed individually, these examples show how to chain them in two common scenarios: the initial enrollment of a device and the renewal of an already-issued certificate.",{"_2299":1262,"_22571":1090,"_15405":39143,"_5":15294,"_21315":38692,"_1890":39144},[],"The following script illustrates the complete process of enrolling a device with a locally generated EC P-256 key and mTLS authentication against a bootstrap certificate.",{"_2299":1263,"_22571":1090,"_15405":39146,"_5":15294,"_21315":38696,"_1890":39147},[],"The following script reproduces a renewal process: it detects the expiration of the current certificate, regenerates the CSR with the **same subject** and authenticates with the active certificate.",{"_2299":1264,"_22571":1090,"_15405":39149,"_5":15294,"_21315":38700,"_1890":39150},[],"Once the device has obtained its identity certificate, the usual steps are:",{"_2299":1265,"_22571":1090,"_15405":39152,"_5":15294,"_21315":38700,"_1890":39153},[],"**Install the trust chain** (`cacerts.pem`) into the device's trust store. The MQTT broker, the HTTPS server or any relying party validating mTLS will need this chain.",{"_2299":1266,"_22571":1090,"_15405":39155,"_5":15294,"_21315":38700,"_1890":39156},[],"**Combine the leaf certificate with the chain** before presenting it in mTLS connections. The `/simpleenroll` response contains only the leaf certificate; the relying party may reject the connection if it does not receive the full chain.",{"_2299":1267,"_22571":1090,"_15405":39158,"_5":15294,"_21315":38700,"_1890":39159},[],"**Plan renewal**: configure a timer on the device that invokes `/simplereenroll` within the `ReEnrollmentDelta` window before the certificate expires. Do not wait for expiry unless `EnableExpiredRenewal` is enabled.",{"_2299":1268,"_22571":1090,"_15405":39161,"_5":15294,"_21315":38708,"_1890":39162},[],"Lamassu maps almost every business error to `500 Internal Server Error`, not to `4xx`. The HTTP status code is not enough to distinguish a network error from a policy error. The integrator must inspect the `err` field of the JSON body (`{\"err\": \"<message>\"}`) to determine the exact cause of the failure.",{"_2299":1269,"_22571":1090,"_15405":39164,"_5":15294,"_21315":38708,"_1890":39165},[],"HTTP",{"_2299":1270,"_22571":1090,"_15405":39167,"_5":15294,"_21315":38708,"_1890":39168},[],"Message",{"_2299":1271,"_22571":1090,"_15405":39170,"_5":15294,"_21315":38708,"_1890":39171},[],"Cause",{"_2299":1272,"_22571":1090,"_15405":39173,"_5":15294,"_21315":38708,"_1890":39174},[],"Integrator action",{"_2299":1273,"_22571":1090,"_15405":39176,"_5":15294,"_21315":38708,"_1890":21907},[],{"_2299":1274,"_22571":1090,"_15405":39178,"_5":15294,"_21315":38708,"_1890":39179},[],"`Field validation for 'APS' failed`",{"_2299":1275,"_22571":1090,"_15405":39181,"_5":15294,"_21315":38708,"_1890":39182},[],"The `{aps}` segment is missing from the URL.",{"_2299":1276,"_22571":1090,"_15405":39184,"_5":15294,"_21315":38708,"_1890":39185},[],"Include the DMS ID in the path.",{"_2299":1277,"_22571":1090,"_15405":39187,"_5":15294,"_21315":38708,"_1890":21907},[],{"_2299":1278,"_22571":1090,"_15405":39189,"_5":15294,"_21315":38708,"_1890":39190},[],"`content-type must be application/pkcs10`",{"_2299":1279,"_22571":1090,"_15405":39192,"_5":15294,"_21315":38708,"_1890":39193},[],"`Content-Type` header missing or incorrect.",{"_2299":1280,"_22571":1090,"_15405":39195,"_5":15294,"_21315":38708,"_1890":39196},[],"Set `Content-Type: application/pkcs10`.",{"_2299":1281,"_22571":1090,"_15405":39198,"_5":15294,"_21315":38708,"_1890":21907},[],{"_2299":1282,"_22571":1090,"_15405":39200,"_5":15294,"_21315":38708,"_1890":39201},[],"`body payload must be base64 encoded`",{"_2299":1283,"_22571":1090,"_15405":39203,"_5":15294,"_21315":38708,"_1890":39204},[],"The body is not valid base64.",{"_2299":1284,"_22571":1090,"_15405":39206,"_5":15294,"_21315":38708,"_1890":39207},[],"Use `base64 -w 0` to avoid line breaks.",{"_2299":1285,"_22571":1090,"_15405":39209,"_5":15294,"_21315":38708,"_1890":21820},[],{"_2299":1286,"_22571":1090,"_15405":39211,"_5":15294,"_21315":38708,"_1890":39212},[],"`DMS not found`",{"_2299":1287,"_22571":1090,"_15405":39214,"_5":15294,"_21315":38708,"_1890":39215},[],"The `{aps}` value does not match any DMS.",{"_2299":1288,"_22571":1090,"_15405":39217,"_5":15294,"_21315":38708,"_1890":39218},[],"Verify the identifier with the PKI administrator.",{"_2299":1289,"_22571":1090,"_15405":39220,"_5":15294,"_21315":38708,"_1890":21820},[],{"_2299":1290,"_22571":1090,"_15405":39222,"_5":15294,"_21315":38708,"_1890":39223},[],"`invalid certificate`",{"_2299":1291,"_22571":1090,"_15405":39225,"_5":15294,"_21315":38708,"_1890":39226},[],"The client certificate is not valid against `ValidationCAs`.",{"_2299":1292,"_22571":1090,"_15405":39228,"_5":15294,"_21315":38708,"_1890":39229},[],"Check the bootstrap certificate chain.",{"_2299":1293,"_22571":1090,"_15405":39231,"_5":15294,"_21315":38708,"_1890":21820},[],{"_2299":1294,"_22571":1090,"_15405":39233,"_5":15294,"_21315":38708,"_1890":39234},[],"`certificate is revoked`",{"_2299":1295,"_22571":1090,"_15405":39236,"_5":15294,"_21315":38708,"_1890":39237},[],"The certificate **presented as the mTLS credential** is revoked in Lamassu or via external OCSP/CRL.",{"_2299":1296,"_22571":1090,"_15405":39239,"_5":15294,"_21315":38708,"_1890":39240},[],"Request a new bootstrap certificate or investigate the revocation.",{"_2299":1297,"_22571":1090,"_15405":39242,"_5":15294,"_21315":38708,"_1890":21820},[],{"_2299":1298,"_22571":1090,"_15405":39244,"_5":15294,"_21315":38708,"_1890":39245},[],"`revoked certificate`",{"_2299":1299,"_22571":1090,"_15405":39247,"_5":15294,"_21315":38708,"_1890":39248},[],"In reenroll, the device's **active certificate in the database** is listed as revoked.",{"_2299":1300,"_22571":1090,"_15405":39250,"_5":15294,"_21315":38708,"_1890":39251},[],"Review the identity slot status; if the revocation was intentional, issue a new enroll instead of reenroll.",{"_2299":1301,"_22571":1090,"_15405":39253,"_5":15294,"_21315":38708,"_1890":21820},[],{"_2299":1302,"_22571":1090,"_15405":39255,"_5":15294,"_21315":38708,"_1890":39256},[],"`expired certificate`",{"_2299":1303,"_22571":1090,"_15405":39258,"_5":15294,"_21315":38708,"_1890":39259},[],"The presented certificate has expired and the DMS does not allow `AllowExpired`/`EnableExpiredRenewal`.",{"_2299":1304,"_22571":1090,"_15405":39261,"_5":15294,"_21315":38708,"_1890":39262},[],"Renew before expiration or request `EnableExpiredRenewal` to be enabled.",{"_2299":1305,"_22571":1090,"_15405":39264,"_5":15294,"_21315":38708,"_1890":21820},[],{"_2299":1306,"_22571":1090,"_15405":39266,"_5":15294,"_21315":38708,"_1890":39267},[],"`forbiddenNewEnrollment`",{"_2299":1307,"_22571":1090,"_15405":39269,"_5":15294,"_21315":38708,"_1890":39270},[],"The device is already enrolled and `EnableReplaceableEnrollment` is `false`.",{"_2299":1308,"_22571":1090,"_15405":39272,"_5":15294,"_21315":38708,"_1890":39273},[],"Use `/simplereenroll` or ask the administrator to enable the flag.",{"_2299":1309,"_22571":1090,"_15405":39275,"_5":15294,"_21315":38708,"_1890":21820},[],{"_2299":1310,"_22571":1090,"_15405":39277,"_5":15294,"_21315":38708,"_1890":39278},[],"`device not preregistered`",{"_2299":1311,"_22571":1090,"_15405":39280,"_5":15294,"_21315":38708,"_1890":39281},[],"The DMS is in `PRE_REGISTRATION` and the device does not exist.",{"_2299":1312,"_22571":1090,"_15405":39283,"_5":15294,"_21315":38708,"_1890":39284},[],"Register the device before enrolling it.",{"_2299":1313,"_22571":1090,"_15405":39286,"_5":15294,"_21315":38708,"_1890":21820},[],{"_2299":1314,"_22571":1090,"_15405":39288,"_5":15294,"_21315":38708,"_1890":39289},[],"`invalid reenroll window`",{"_2299":1315,"_22571":1090,"_15405":39291,"_5":15294,"_21315":38708,"_1890":39292},[],"Renewal attempted before `NotAfter - ReEnrollmentDelta`.",{"_2299":1316,"_22571":1090,"_15405":39294,"_5":15294,"_21315":38708,"_1890":39295},[],"Wait for the window to open or request a larger `ReEnrollmentDelta`.",{"_2299":1317,"_22571":1090,"_15405":39297,"_5":15294,"_21315":38708,"_1890":21820},[],{"_2299":1318,"_22571":1090,"_15405":39299,"_5":15294,"_21315":38708,"_1890":39300},[],"`invalid RawSubject bytes`",{"_2299":1319,"_22571":1090,"_15405":39302,"_5":15294,"_21315":38708,"_1890":39303},[],"The renewal CSR's subject does not match the active certificate's.",{"_2299":1320,"_22571":1090,"_15405":39305,"_5":15294,"_21315":38708,"_1890":39306},[],"Regenerate the CSR with the exact subject of the previous cert.",{"_2299":1321,"_22571":1090,"_15405":39308,"_5":15294,"_21315":38708,"_1890":21820},[],{"_2299":1322,"_22571":1090,"_15405":39310,"_5":15294,"_21315":38708,"_1890":39311},[],"`external webhook denied enrollment`",{"_2299":1323,"_22571":1090,"_15405":39313,"_5":15294,"_21315":38708,"_1890":39314},[],"The webhook returned a non-`2xx` code or `authorized != true`.",{"_2299":1324,"_22571":1090,"_15405":39316,"_5":15294,"_21315":38708,"_1890":39317},[],"Review the webhook service logs.",{"_2299":1325,"_22571":1090,"_15405":39319,"_5":15294,"_21315":38708,"_1890":21820},[],{"_2299":1326,"_22571":1090,"_15405":39321,"_5":15294,"_21315":38708,"_1890":39322},[],"`server key generation not enabled`",{"_2299":1327,"_22571":1090,"_15405":39324,"_5":15294,"_21315":38708,"_1890":39325},[],"`/serverkeygen` is disabled on the DMS.",{"_2299":1328,"_22571":1090,"_15405":39327,"_5":15294,"_21315":38708,"_1890":39328},[],"Ask the administrator to enable `ServerKeyGen.Enabled`.",{"_2299":1329,"_22571":1090,"_15405":39330,"_5":15294,"_21315":38708,"_1890":39331},[],"For messages not listed in this table, the Lamassu server logs (with the fields `func`, `dms`, `device-cn`, `step`, `auth-method`, `auth-status`) are the first place to look for the cause.",{"_2299":1330,"_22571":1090,"_15405":39333,"_5":15294,"_21315":38712,"_1890":39334},[],"Lamassu's implementation follows RFC 7030 in its essentials but introduces several quirks that can affect strict EST clients or third-party libraries:",{"_2299":1331,"_22571":1090,"_15405":39336,"_5":15294,"_21315":38712,"_1890":39337},[],"The `/csrattrs` and `/fullcmc` endpoints of RFC 7030 are **not implemented** in Lamassu. A client invoking `/.well-known/est/<DMS_ID>/csrattrs` receives `404 Not Found` instead of the `204 No Content` the RFC suggests for \"no attributes\". Strict EST libraries must be configured not to attempt `csrattrs`.",{"_2299":1332,"_22571":1090,"_15405":39339,"_5":15294,"_21315":38712,"_1890":39340},[],"The base64 of the `/cacerts` and `/simpleenroll` responses is wrapped in lines of **76 characters** terminated with CRLF (S/MIME compliant, RFC 5751). The parts of `/serverkeygen` apply no wrap.",{"_2299":1333,"_22571":1090,"_15405":39342,"_5":15294,"_21315":38712,"_1890":39343},[],"The `multipart/mixed` boundary in `/serverkeygen` is fixed and cannot be negotiated.",{"_2299":1334,"_22571":1090,"_15405":39345,"_5":15294,"_21315":38712,"_1890":39346},[],"The `{aps}` segment is **mandatory** in all EST routes. Routes registered without `{aps}` are in the code but respond `400`.",{"_2299":1335,"_22571":1090,"_15405":39348,"_5":15294,"_21315":38712,"_1890":39349},[],"The body of `/cacerts`, `/simpleenroll` and `/simplereenroll` can be returned as concatenated PEM if the client sends `Accept: application/x-pem-file`. This is a Lamassu-specific extension and does not appear in the RFC.",{"_2299":1336,"_22571":1090,"_15405":39351,"_5":15294,"_21315":38712,"_1890":39352},[],"The server does not explicitly reject CSRs signed with SHA-1 or MD5; the integrator must generate the CSR with SHA-256 or higher.",{"_2299":1337,"_22571":1090,"_15405":39354,"_5":15294,"_21315":38712,"_1890":39355},[],"<Card title=\"DMS overview\" href=\"/docs/platform/pki/device-enrollment\" />",{"_2299":1338,"_22571":1090,"_15405":39357,"_5":15294,"_21315":38712,"_1890":39358},[],"<Card title=\"OCSP validation\" href=\"/docs/platform/pki/ocsp\" />",{"_2299":1339,"_22571":1090,"_15405":39360,"_5":15294,"_21315":38712,"_1890":39361},[],"<Card title=\"Manage devices\" href=\"/docs/platform/pki/device-management\" />",{"_2299":1340,"_22571":1340,"_5":10616,"_1890":39363,"_22830":39364,"_15405":39366,"_21315":1340},"AWS IoT Core",[35156,36291,39365],"Integrations",[],{"_2299":1341,"_22571":1340,"_15405":39368,"_5":15294,"_21315":1340,"_1890":39369},[],"Lamassu's connector for AWS IoT Core syncs device identities with the AWS platform, handling CA registration, Thing provisioning and certificate lifecycle automatically and event-driven.",{"_2299":1342,"_22571":1340,"_5":22827,"_15405":39371,"_21315":39372,"_1890":39373},[],"/docs/platform/pki/integrations/aws-iot-core#connector-architecture","Connector architecture",{"_2299":1343,"_22571":1340,"_5":22827,"_15405":39375,"_21315":39376,"_1890":38622},[],"/docs/platform/pki/integrations/aws-iot-core#prerequisites",{"_2299":1344,"_22571":1340,"_5":22827,"_15405":39378,"_21315":39379,"_1890":39380},[],"/docs/platform/pki/integrations/aws-iot-core#required-iam-permissions","Required IAM permissions",{"_2299":1345,"_22571":1340,"_5":22827,"_15405":39382,"_21315":39383,"_1890":39384},[],"/docs/platform/pki/integrations/aws-iot-core#configuration-parameters","Configuration parameters",{"_2299":1346,"_22571":1340,"_5":22827,"_15405":39386,"_21315":39387,"_1890":39388},[],"/docs/platform/pki/integrations/aws-iot-core#ca-registration-in-aws-iot-core","CA registration in AWS IoT Core",{"_2299":1347,"_22571":1340,"_5":22827,"_15405":39390,"_21315":39391,"_1890":39392},[],"/docs/platform/pki/integrations/aws-iot-core#how-to-request-registration","How to request registration",{"_2299":1348,"_22571":1340,"_5":22827,"_15405":39394,"_21315":39395,"_1890":39396},[],"/docs/platform/pki/integrations/aws-iot-core#primary-account","Primary Account",{"_2299":1349,"_22571":1340,"_5":22827,"_15405":39398,"_21315":39399,"_1890":39400},[],"/docs/platform/pki/integrations/aws-iot-core#secondary-account-sni-only","Secondary Account (SNI-only)",{"_2299":1350,"_22571":1340,"_5":22827,"_15405":39402,"_21315":39403,"_1890":38618},[],"/docs/platform/pki/integrations/aws-iot-core#dms-configuration",{"_2299":1351,"_22571":1340,"_5":22827,"_15405":39405,"_21315":39406,"_1890":39407},[],"/docs/platform/pki/integrations/aws-iot-core#none-mode","`none` mode",{"_2299":1352,"_22571":1340,"_5":22827,"_15405":39409,"_21315":39410,"_1890":39411},[],"/docs/platform/pki/integrations/aws-iot-core#auto-mode","`auto` mode",{"_2299":1353,"_22571":1340,"_5":22827,"_15405":39413,"_21315":39414,"_1890":39415},[],"/docs/platform/pki/integrations/aws-iot-core#jitp-mode","`jitp` mode",{"_2299":1354,"_22571":1340,"_5":22827,"_15405":39417,"_21315":39418,"_1890":39419},[],"/docs/platform/pki/integrations/aws-iot-core#device-provisioning-automatic-mode","Device provisioning (automatic mode)",{"_2299":1355,"_22571":1340,"_5":22827,"_15405":39421,"_21315":39422,"_1890":39423},[],"/docs/platform/pki/integrations/aws-iot-core#device-provisioning-jitp-mode","Device provisioning (JITP mode)",{"_2299":1356,"_22571":1340,"_5":22827,"_15405":39425,"_21315":39426,"_1890":39427},[],"/docs/platform/pki/integrations/aws-iot-core#certificate-status-synchronization","Certificate status synchronization",{"_2299":1357,"_22571":1340,"_5":22827,"_15405":39429,"_21315":39430,"_1890":39431},[],"/docs/platform/pki/integrations/aws-iot-core#forced-disconnect-on-revocation","Forced disconnect on revocation",{"_2299":1358,"_22571":1340,"_5":22827,"_15405":39433,"_21315":39434,"_1890":39435},[],"/docs/platform/pki/integrations/aws-iot-core#device-shadow-and-automation","Device Shadow and automation",{"_2299":1359,"_22571":1340,"_5":22827,"_15405":39437,"_21315":39438,"_1890":39439},[],"/docs/platform/pki/integrations/aws-iot-core#what-the-connector-writes-to-the-shadow","What the connector writes to the shadow",{"_2299":1360,"_22571":1340,"_5":22827,"_15405":39441,"_21315":39442,"_1890":39443},[],"/docs/platform/pki/integrations/aws-iot-core#aws-iot-policies","AWS IoT policies",{"_2299":1361,"_22571":1340,"_5":22827,"_15405":39445,"_21315":39446,"_1890":39447},[],"/docs/platform/pki/integrations/aws-iot-core#troubleshooting","Troubleshooting",{"_2299":1362,"_22571":1340,"_15405":39449,"_5":15294,"_21315":1340,"_1890":39450},[],"Lamassu's integration with AWS IoT Core bridges the PKI managed by Lamassu and AWS's connectivity platform. When a device obtains its certificate through the EST enrollment process, the connector ensures that certificate and its associated identity are recognized in AWS IoT Core without manual intervention. The result is that the device can authenticate directly to AWS with the same X.509 certificate Lamassu issued.",{"_2299":1363,"_22571":1340,"_15405":39452,"_5":15294,"_21315":1340,"_1890":39453},[],"From a protocol standpoint, the device authenticates to AWS IoT Core via mutual TLS (mTLS): it presents its Lamassu-issued X.509 certificate as the client certificate, and AWS IoT Core verifies the certificate chain up to the CA registered in the account. Lamassu acts as the certification authority (CA); the connector ensures that CA is registered in AWS and that the device's certificate is known to the platform before the device attempts to connect (in `auto` mode) or on its first connection (in JITP mode).",{"_2299":1364,"_22571":1340,"_15405":39455,"_5":15294,"_21315":1340,"_1890":39456},[],"This document is aimed both at the PKI administrator, who needs to configure the connector and register CAs, and at the device firmware developer, who needs to understand how Things are named, how the Device Shadow works and what happens when a certificate is revoked. For the firmware developer, the most important fact is that **the AWS Thing name (ThingName) always corresponds to the Common Name (CN) of the certificate issued by Lamassu**, regardless of the provisioning mode.",{"_2299":1365,"_22571":1340,"_15405":39458,"_5":15294,"_21315":39372,"_1890":39459},[],"The AWS IoT Core connector is an independent Go process, a binary or container separate from Lamassu's core. In a monolithic deployment it is compiled by default (build tag `!noaws`) and activated with `aws_iot_manager.enabled: true` in the configuration file. In distributed deployments, it runs as its own container with access to Lamassu's CA, DMS Manager and Device Manager services over HTTP.",{"_2299":1366,"_22571":1340,"_15405":39461,"_5":15294,"_21315":39372,"_1890":39462},[],"The connector does not poll Lamassu's services periodically. Instead, it **subscribes to Lamassu's internal event bus** (AMQP or AWS SQS/SNS, configurable) and reacts to the events it cares about: CA creation or update, DMS creation or update, device identity binding, certificate status change, certificate metadata update and device metadata update. This event-driven model ensures synchronization with AWS is nearly immediate and produces no polling load.",{"_2299":1367,"_22571":1340,"_15405":39464,"_5":15294,"_21315":39372,"_1890":39465},[],"To avoid infinite loops, the connector ignores any event whose CloudEvent `source` field matches its own origin URI. This prevents the metadata writes the connector itself performs from re-triggering the same flow.",{"_2299":1368,"_22571":1340,"_15405":39467,"_5":15294,"_21315":39372,"_1890":39468},[],"When several connectors run in parallel, for example for different AWS accounts, each instance has its own `connector_id`. All metadata the connector writes to Lamassu is stored under the key `lamassu.io/iot/{connector_id}`, allowing coexistence without collisions.",{"_2299":1369,"_22571":1340,"_15405":39470,"_5":15294,"_21315":39376,"_1890":39471},[],"Before enabling the connector you need an AWS account with the proper IAM permissions and the connector correctly configured. The deployment process (Docker Compose, Kubernetes or binary) is described in the deployment documentation.",{"_2299":1370,"_22571":1340,"_15405":39473,"_5":15294,"_21315":39379,"_1890":39474},[],"The IAM identity operating the connector needs at minimum the following permissions on the target account's resources:",{"_2299":1371,"_22571":1340,"_15405":39476,"_5":15294,"_21315":39379,"_1890":39477},[],"IAM action",{"_2299":1372,"_22571":1340,"_15405":39479,"_5":15294,"_21315":39379,"_1890":35539},[],{"_2299":1373,"_22571":1340,"_15405":39481,"_5":15294,"_21315":39379,"_1890":39482},[],"`iot:GetRegistrationCode`",{"_2299":1374,"_22571":1340,"_15405":39484,"_5":15294,"_21315":39379,"_1890":39485},[],"Obtain the verification code for CA registration in the Primary Account",{"_2299":1375,"_22571":1340,"_15405":39487,"_5":15294,"_21315":39379,"_1890":39488},[],"`iot:RegisterCACertificate`",{"_2299":1376,"_22571":1340,"_15405":39490,"_5":15294,"_21315":39379,"_1890":39491},[],"Register the CA in AWS IoT",{"_2299":1377,"_22571":1340,"_15405":39493,"_5":15294,"_21315":39379,"_1890":39494},[],"`iot:DescribeCACertificate`",{"_2299":1378,"_22571":1340,"_15405":39496,"_5":15294,"_21315":39379,"_1890":39497},[],"Check the CA registration status",{"_2299":1379,"_22571":1340,"_15405":39499,"_5":15294,"_21315":39379,"_1890":39500},[],"`iot:CreateThing` / `iot:UpdateThing`",{"_2299":1380,"_22571":1340,"_15405":39502,"_5":15294,"_21315":39379,"_1890":39503},[],"Create or update Things in IoT Core",{"_2299":1381,"_22571":1340,"_15405":39505,"_5":15294,"_21315":39379,"_1890":39506},[],"`iot:RegisterThing`",{"_2299":1382,"_22571":1340,"_15405":39508,"_5":15294,"_21315":39379,"_1890":39509},[],"Provision Things through a template",{"_2299":1383,"_22571":1340,"_15405":39511,"_5":15294,"_21315":39379,"_1890":39512},[],"`iot:RegisterCertificate`",{"_2299":1384,"_22571":1340,"_15405":39514,"_5":15294,"_21315":39379,"_1890":39515},[],"Register device certificates",{"_2299":1385,"_22571":1340,"_15405":39517,"_5":15294,"_21315":39379,"_1890":39518},[],"`iot:UpdateCertificate`",{"_2299":1386,"_22571":1340,"_15405":39520,"_5":15294,"_21315":39379,"_1890":39521},[],"Change a certificate's status (ACTIVE / INACTIVE / REVOKED)",{"_2299":1387,"_22571":1340,"_15405":39523,"_5":15294,"_21315":39379,"_1890":39524},[],"`iot:CreatePolicy` / `iot:AttachPolicy`",{"_2299":1388,"_22571":1340,"_15405":39526,"_5":15294,"_21315":39379,"_1890":39527},[],"Create and attach IoT policies",{"_2299":1389,"_22571":1340,"_15405":39529,"_5":15294,"_21315":39379,"_1890":39530},[],"`iot:CreateThingGroup` / `iot:AddThingToThingGroup`",{"_2299":1390,"_22571":1340,"_15405":39532,"_5":15294,"_21315":39379,"_1890":39533},[],"Manage Thing groups",{"_2299":1391,"_22571":1340,"_15405":39535,"_5":15294,"_21315":39379,"_1890":39536},[],"`iot:CreateProvisioningTemplate`",{"_2299":1392,"_22571":1340,"_15405":39538,"_5":15294,"_21315":39379,"_1890":39539},[],"Create JITP templates",{"_2299":1393,"_22571":1340,"_15405":39541,"_5":15294,"_21315":39379,"_1890":39542},[],"`iotdata:GetThingShadow` / `iotdata:UpdateThingShadow`",{"_2299":1394,"_22571":1340,"_15405":39544,"_5":15294,"_21315":39379,"_1890":39545},[],"Read and write the Device Shadow",{"_2299":1395,"_22571":1340,"_15405":39547,"_5":15294,"_21315":39379,"_1890":39548},[],"The forced-disconnect mechanism after revocation also requires access to the AWS IoT data plane API (`iot:Connect` with SigV4 over WebSocket), negotiated implicitly with the connector's credentials.",{"_2299":1396,"_22571":1340,"_15405":39550,"_5":15294,"_21315":39383,"_1890":39551},[],"Parameter",{"_2299":1397,"_22571":1340,"_15405":39553,"_5":15294,"_21315":39383,"_1890":39554},[],"Type",{"_2299":1398,"_22571":1340,"_15405":39556,"_5":15294,"_21315":39383,"_1890":39557},[],"Required",{"_2299":1399,"_22571":1340,"_15405":39559,"_5":15294,"_21315":39383,"_1890":38318},[],{"_2299":1400,"_22571":1340,"_15405":39561,"_5":15294,"_21315":39383,"_1890":39562},[],"`connector_id`",{"_2299":1401,"_22571":1340,"_15405":39564,"_5":15294,"_21315":39383,"_1890":18572},[],{"_2299":1402,"_22571":1340,"_15405":39566,"_5":15294,"_21315":39383,"_1890":38946},[],{"_2299":1403,"_22571":1340,"_15405":39568,"_5":15294,"_21315":39383,"_1890":39569},[],"Unique identifier of this connector instance. Used as the metadata namespace: `lamassu.io/iot/{connector_id}`.",{"_2299":1404,"_22571":1340,"_15405":39571,"_5":15294,"_21315":39383,"_1890":39572},[],"`aws_config.region`",{"_2299":1405,"_22571":1340,"_15405":39574,"_5":15294,"_21315":39383,"_1890":18572},[],{"_2299":1406,"_22571":1340,"_15405":39576,"_5":15294,"_21315":39383,"_1890":38946},[],{"_2299":1407,"_22571":1340,"_15405":39578,"_5":15294,"_21315":39383,"_1890":39579},[],"AWS region where the connector operates.",{"_2299":1408,"_22571":1340,"_15405":39581,"_5":15294,"_21315":39383,"_1890":39582},[],"`aws_config.auth_method`",{"_2299":1409,"_22571":1340,"_15405":39584,"_5":15294,"_21315":39383,"_1890":18572},[],{"_2299":1410,"_22571":1340,"_15405":39586,"_5":15294,"_21315":39383,"_1890":38946},[],{"_2299":1411,"_22571":1340,"_15405":39588,"_5":15294,"_21315":39383,"_1890":39589},[],"Authentication method: `static`, `role` or empty (SDK default credential chain).",{"_2299":1412,"_22571":1340,"_15405":39591,"_5":15294,"_21315":39383,"_1890":39592},[],"`aws_config.access_key_id`",{"_2299":1413,"_22571":1340,"_15405":39594,"_5":15294,"_21315":39383,"_1890":18572},[],{"_2299":1414,"_22571":1340,"_15405":39596,"_5":15294,"_21315":39383,"_1890":39597},[],"Only with `auth_method=static`",{"_2299":1415,"_22571":1340,"_15405":39599,"_5":15294,"_21315":39383,"_1890":39600},[],"AWS access key.",{"_2299":1416,"_22571":1340,"_15405":39602,"_5":15294,"_21315":39383,"_1890":39603},[],"`aws_config.secret_access_key`",{"_2299":1417,"_22571":1340,"_15405":39605,"_5":15294,"_21315":39383,"_1890":18572},[],{"_2299":1418,"_22571":1340,"_15405":39607,"_5":15294,"_21315":39383,"_1890":39597},[],{"_2299":1419,"_22571":1340,"_15405":39609,"_5":15294,"_21315":39383,"_1890":39610},[],"AWS secret key.",{"_2299":1420,"_22571":1340,"_15405":39612,"_5":15294,"_21315":39383,"_1890":39613},[],"`aws_config.session_token`",{"_2299":1421,"_22571":1340,"_15405":39615,"_5":15294,"_21315":39383,"_1890":18572},[],{"_2299":1422,"_22571":1340,"_15405":39617,"_5":15294,"_21315":39383,"_1890":39618},[],"No",{"_2299":1423,"_22571":1340,"_15405":39620,"_5":15294,"_21315":39383,"_1890":39621},[],"Session token (with `auth_method=static`).",{"_2299":1424,"_22571":1340,"_15405":39623,"_5":15294,"_21315":39383,"_1890":39624},[],"`aws_config.role_arn`",{"_2299":1425,"_22571":1340,"_15405":39626,"_5":15294,"_21315":39383,"_1890":18572},[],{"_2299":1426,"_22571":1340,"_15405":39628,"_5":15294,"_21315":39383,"_1890":39629},[],"Only with `auth_method=role`",{"_2299":1427,"_22571":1340,"_15405":39631,"_5":15294,"_21315":39383,"_1890":39632},[],"ARN of the role to assume.",{"_2299":1428,"_22571":1340,"_15405":39634,"_5":15294,"_21315":39383,"_1890":39635},[],"`aws_config.endpoint_url`",{"_2299":1429,"_22571":1340,"_15405":39637,"_5":15294,"_21315":39383,"_1890":18572},[],{"_2299":1430,"_22571":1340,"_15405":39639,"_5":15294,"_21315":39383,"_1890":39618},[],{"_2299":1431,"_22571":1340,"_15405":39641,"_5":15294,"_21315":39383,"_1890":39642},[],"Alternative URL for all AWS services (useful with LocalStack in tests).",{"_2299":1432,"_22571":1340,"_15405":39644,"_5":15294,"_21315":39383,"_1890":39645},[],"`subscriber_event_bus`",{"_2299":1433,"_22571":1340,"_15405":39647,"_5":15294,"_21315":39383,"_1890":12849},[],{"_2299":1434,"_22571":1340,"_15405":39649,"_5":15294,"_21315":39383,"_1890":38946},[],{"_2299":1435,"_22571":1340,"_15405":39651,"_5":15294,"_21315":39383,"_1890":39652},[],"Configuration of the event bus the connector subscribes to (AMQP or AWS SQS/SNS).",{"_2299":1436,"_22571":1340,"_15405":39654,"_5":15294,"_21315":39383,"_1890":39655},[],"`dms_manager_client`",{"_2299":1437,"_22571":1340,"_15405":39657,"_5":15294,"_21315":39383,"_1890":18572},[],{"_2299":1438,"_22571":1340,"_15405":39659,"_5":15294,"_21315":39383,"_1890":38946},[],{"_2299":1439,"_22571":1340,"_15405":39661,"_5":15294,"_21315":39383,"_1890":39662},[],"HTTP URL of Lamassu's DMS Manager service.",{"_2299":1440,"_22571":1340,"_15405":39664,"_5":15294,"_21315":39383,"_1890":39665},[],"`device_manager_client`",{"_2299":1441,"_22571":1340,"_15405":39667,"_5":15294,"_21315":39383,"_1890":18572},[],{"_2299":1442,"_22571":1340,"_15405":39669,"_5":15294,"_21315":39383,"_1890":38946},[],{"_2299":1443,"_22571":1340,"_15405":39671,"_5":15294,"_21315":39383,"_1890":39672},[],"HTTP URL of Lamassu's Device Manager.",{"_2299":1444,"_22571":1340,"_15405":39674,"_5":15294,"_21315":39383,"_1890":39675},[],"`ca_client`",{"_2299":1445,"_22571":1340,"_15405":39677,"_5":15294,"_21315":39383,"_1890":18572},[],{"_2299":1446,"_22571":1340,"_15405":39679,"_5":15294,"_21315":39383,"_1890":38946},[],{"_2299":1447,"_22571":1340,"_15405":39681,"_5":15294,"_21315":39383,"_1890":39682},[],"HTTP URL of Lamassu's CA service.",{"_2299":1448,"_22571":1340,"_15405":39684,"_5":15294,"_21315":39387,"_1890":39685},[],"For devices to authenticate to AWS IoT Core with certificates issued by a Lamassu CA, that CA must first be registered in the AWS account. The connector handles this registration automatically in response to the `EventCreateCAKey`, `EventImportCAKey` and `EventUpdateCAMetadataKey` events, but the operation **only fires when the administrator explicitly requests it** through the CA metadata field.",{"_2299":1449,"_22571":1340,"_15405":39687,"_5":15294,"_21315":39391,"_1890":39688},[],"Registration is triggered by setting `registration.status = \"REQUESTED\"` on the `lamassu.io/iot/{connector_id}` key of the CA's metadata. This can be done from the Lamassu console in the CA management section or through the API.",{"_2299":1450,"_22571":1340,"_15405":39690,"_5":15294,"_21315":39391,"_1890":39691},[],"Once the event is received, the connector attempts to register the CA in AWS and updates the `registration.status` field in the CA's metadata with the result: `\"SUCCEEDED\"` if registration was successful, or `\"FAILED\"` with an error message otherwise. The process is asynchronous, so you must periodically check the metadata status until the operation completes.",{"_2299":1451,"_22571":1340,"_15405":39693,"_5":15294,"_21315":39395,"_1890":39694},[],"When the `primary_account` parameter is `true`, the connector runs the full registration flow with proof-of-possession of the private key:",{"_2299":1452,"_22571":1340,"_15405":39696,"_5":15294,"_21315":39395,"_1890":39697},[],"It calls `iot:GetRegistrationCode` to obtain AWS's verification code.",{"_2299":1453,"_22571":1340,"_15405":39699,"_5":15294,"_21315":39395,"_1890":39700},[],"The connector internally generates an ephemeral RSA-2048 key pair and builds a CSR whose Common Name is exactly that registration code. It then calls Lamassu's signing service so the registered CA issues a real X.509 verification certificate signing that CSR. The ephemeral private key is used only for this purpose and is neither stored nor sent to AWS.",{"_2299":1454,"_22571":1340,"_15405":39702,"_5":15294,"_21315":39395,"_1890":39703},[],"It sends the CA (in PEM) and the verification certificate to AWS via `iot:RegisterCACertificate`, enabling registration with `AllowAutoRegistration: true`.",{"_2299":1455,"_22571":1340,"_15405":39705,"_5":15294,"_21315":39395,"_1890":39706},[],"Only one account can own a CA in a given AWS region. If the CA is already registered with the same serial number, the connector silently skips the step.",{"_2299":1456,"_22571":1340,"_15405":39708,"_5":15294,"_21315":39395,"_1890":39709},[],"The tags AWS IoT Core applies to the registered CA certificate are `LMS.CA.ID`, `LMS.CA.SN` and `LMS.CA.CN`.",{"_2299":1457,"_22571":1340,"_15405":39711,"_5":15294,"_21315":39399,"_1890":39712},[],"When `primary_account` is `false`, the connector registers the CA using `CertificateMode: SNI_ONLY`. This mode requires no verification code or access to the CA's private key, so it is the right choice when the CA is managed from another AWS account or when the administrator does not hold the private key. It is the usual method to register the same CA in several AWS accounts simultaneously.",{"_2299":1458,"_22571":1340,"_15405":39714,"_5":15294,"_21315":39403,"_1890":39715},[],"Each DMS participating in the AWS IoT Core integration must have the metadata key `lamassu.io/iot/{connector_id}` configured. The most important field of that configuration is `registration_mode`, which determines how devices are provisioned in AWS.",{"_2299":1459,"_22571":1340,"_15405":39717,"_5":15294,"_21315":39403,"_1890":39718},[],"There are three registration modes, and the choice among them depends on the fleet's provisioning strategy.",{"_2299":1460,"_22571":1340,"_15405":39720,"_5":15294,"_21315":39406,"_1890":39721},[],"In this mode the connector **creates no Things, groups or policies** in AWS IoT Core. It only syncs certificate status (active, revoked, suspended) as it changes in Lamassu. It is the right mode when Thing provisioning in AWS is managed by an external system and Lamassu only needs to keep certificate status up to date.",{"_2299":1461,"_22571":1340,"_15405":39723,"_5":15294,"_21315":39410,"_1890":39724},[],"`auto` mode delegates full device provisioning in AWS to Lamassu at enrollment time. When the device successfully completes its EST enrollment and Lamassu emits the `EventBindDeviceIdentityKey` event, the connector automatically executes the following sequence:",{"_2299":1462,"_22571":1340,"_15405":39726,"_5":15294,"_21315":39410,"_1890":39727},[],"Creates or updates the IoT policies configured in the DMS.",{"_2299":1463,"_22571":1340,"_15405":39729,"_5":15294,"_21315":39410,"_1890":39730},[],"Creates the root group `LAMASSU` in the AWS account (if it does not exist) and the child groups configured in the DMS as subgroups of `LAMASSU`. If the groups already exist, the `ResourceAlreadyExistsException` error is ignored, making the operation idempotent.",{"_2299":1464,"_22571":1340,"_15405":39732,"_5":15294,"_21315":39410,"_1890":39733},[],"If the Thing already existed in AWS IoT Core, the connector iterates all certificates (principals) currently attached to that Thing and marks them as `REVOKED` in AWS, ensuring previous certificates cannot keep being used to authenticate.",{"_2299":1465,"_22571":1340,"_15405":39735,"_5":15294,"_21315":39410,"_1890":39736},[],"Calls `iot:RegisterThing` with a CloudFormation-style provisioning template that creates the Thing, registers the device's certificate (PEM of the device certificate and of the issuing CA certificate) and attaches the configured policies.",{"_2299":1466,"_22571":1340,"_15405":39738,"_5":15294,"_21315":39410,"_1890":39739},[],"Once provisioning completes, the connector stores the resulting certificate's ARN in the Lamassu certificate's metadata under the key `lamassu.io/iot/{connector_id}` and marks the device as `Registered: true` in Device Manager.",{"_2299":1467,"_22571":1340,"_15405":39741,"_5":15294,"_21315":39410,"_1890":39742},[],"**The Thing name in AWS is the Common Name (CN) of the device's certificate.** This convention is fundamental for the firmware developer: the `/CN=` value the device includes in its CSR when enrolling becomes the ThingName it must identify itself with in all MQTT operations against AWS IoT Core.",{"_2299":1468,"_22571":1340,"_15405":39744,"_5":15294,"_21315":39414,"_1890":39745},[],"Just-In-Time Provisioning (JITP) mode delegates provisioning to AWS instead of the connector doing it directly. When the connector detects the DMS is in `jitp` mode, it creates a JITP provisioning template in AWS IoT Core and attaches it to the registered CA certificate. This template is created or updated at the moment the DMS is created or updated in Lamassu — not at device enrollment time. From then on, when a device with a certificate issued by that CA connects to AWS IoT Core for the first time, AWS executes the template automatically: it creates the Thing, registers the certificate and activates it.",{"_2299":1469,"_22571":1340,"_15405":39747,"_5":15294,"_21315":39414,"_1890":39748},[],"The Thing name in the JITP template is derived from `AWS::IoT::Certificate::CommonName`, which corresponds to the device certificate's CN — the same convention as `auto` mode.",{"_2299":1470,"_22571":1340,"_15405":39750,"_5":15294,"_21315":39414,"_1890":39751},[],"This mode requires the `jitp_config.provisioning_role_arn` field to be configured with the ARN of an IAM role AWS IoT Core can assume to execute the template. If not configured, the connector uses the default `arn:aws:iam::{account}:role/JITPRole` and logs a warning. The administrator must ensure that role exists in the account and has the necessary permissions before enabling JITP mode.",{"_2299":1471,"_22571":1340,"_15405":39753,"_5":15294,"_21315":39418,"_1890":39754},[],"For the firmware developer, `auto` mode is transparent: the device performs its EST enrollment as usual and, as a side effect, it is provisioned in AWS IoT Core with no additional step.",{"_2299":1472,"_22571":1340,"_15405":39756,"_5":15294,"_21315":39418,"_1890":39757},[],"The full flow from the device's perspective is:",{"_2299":1473,"_22571":1340,"_15405":39759,"_5":15294,"_21315":39418,"_1890":39760},[],"Once the connector completes provisioning, the device can connect to the AWS IoT Core MQTT endpoint using its private key and the certificate issued by Lamassu. The ThingName it must identify itself with in AWS is exactly the certificate's CN.",{"_2299":1474,"_22571":1340,"_15405":39762,"_5":15294,"_21315":39422,"_1890":39763},[],"In JITP mode the device also performs its EST enrollment conventionally and obtains its certificate from Lamassu. The difference is that AWS IoT Core does not know the device until it attempts its first connection.",{"_2299":1475,"_22571":1340,"_15405":39765,"_5":15294,"_21315":39422,"_1890":39766},[],"When the device establishes its first MQTT connection to AWS IoT Core presenting the Lamassu-issued certificate, AWS detects that the certificate belongs to a CA registered with a JITP template, executes that template and creates the Thing automatically. The initial connection may fail or be delayed while the template runs; firmware must be prepared to retry the connection.",{"_2299":1476,"_22571":1340,"_15405":39768,"_5":15294,"_21315":39422,"_1890":39769},[],"For the JITP flow to work correctly:",{"_2299":1477,"_22571":1340,"_15405":39771,"_5":15294,"_21315":39422,"_1890":39772},[],"The CA must be registered in AWS in Primary Account mode (SNI-only mode does not support JITP).",{"_2299":1478,"_22571":1340,"_15405":39774,"_5":15294,"_21315":39422,"_1890":39775},[],"The IAM role configured in `jitp_config.provisioning_role_arn` must exist and have permissions to create Things, register certificates and attach policies in the AWS account.",{"_2299":1479,"_22571":1340,"_15405":39777,"_5":15294,"_21315":39422,"_1890":39778},[],"The device must present both its certificate and the issuing CA's certificate in the TLS handshake with AWS IoT Core.",{"_2299":1480,"_22571":1340,"_15405":39780,"_5":15294,"_21315":39422,"_1890":39781},[],"Certificates provisioned via JITP **do not have the connector's metadata key** (`lamassu.io/iot/{connector_id}`) in Lamassu. As a consequence, status changes of those certificates in Lamassu are not automatically synced to AWS through the state synchronization mechanism described in the next section.",{"_2299":1481,"_22571":1340,"_15405":39783,"_5":15294,"_21315":39426,"_1890":39784},[],"The connector listens for the `EventUpdateCertificateStatusKey` event and, when a certificate holding the connector's metadata key changes status in Lamassu, replicates that change in AWS IoT Core. The following table shows the status mapping:",{"_2299":1482,"_22571":1340,"_15405":39786,"_5":15294,"_21315":39426,"_1890":39787},[],"Status in Lamassu",{"_2299":1483,"_22571":1340,"_15405":39789,"_5":15294,"_21315":39426,"_1890":39790},[],"Revocation reason",{"_2299":1484,"_22571":1340,"_15405":39792,"_5":15294,"_21315":39426,"_1890":39793},[],"Status in AWS IoT Core",{"_2299":1485,"_22571":1340,"_15405":39795,"_5":15294,"_21315":39426,"_1890":39796},[],"`Active`",{"_2299":1486,"_22571":1340,"_15405":39798,"_5":15294,"_21315":39426,"_1890":38986},[],{"_2299":1487,"_22571":1340,"_15405":39800,"_5":15294,"_21315":39426,"_1890":39801},[],"`ACTIVE`",{"_2299":1488,"_22571":1340,"_15405":39803,"_5":15294,"_21315":39426,"_1890":39804},[],"`Revoked`",{"_2299":1489,"_22571":1340,"_15405":39806,"_5":15294,"_21315":39426,"_1890":39807},[],"`certificateHold`",{"_2299":1490,"_22571":1340,"_15405":39809,"_5":15294,"_21315":39426,"_1890":39810},[],"`INACTIVE`",{"_2299":1491,"_22571":1340,"_15405":39812,"_5":15294,"_21315":39426,"_1890":39804},[],{"_2299":1492,"_22571":1340,"_15405":39814,"_5":15294,"_21315":39426,"_1890":39815},[],"Any other reason",{"_2299":1493,"_22571":1340,"_15405":39817,"_5":15294,"_21315":39426,"_1890":39818},[],"`REVOKED`",{"_2299":1494,"_22571":1340,"_15405":39820,"_5":15294,"_21315":39426,"_1890":39821},[],"Only the `Active` and `Revoked` states produce a call to `iot:UpdateCertificate`. The other lifecycle states of Lamassu (`RenewalWindow`, `AboutToExpire`, `Expired`) are not synced to AWS IoT Core; the certificate status in AWS remains unchanged until the status in Lamassu becomes `Active` or `Revoked`.",{"_2299":1495,"_22571":1340,"_15405":39823,"_5":15294,"_21315":39430,"_1890":39824},[],"When the connector marks a certificate as `REVOKED` or `INACTIVE` in AWS, it additionally performs a forced disconnect of the device. To do so it opens an MQTT connection over WebSocket (with SigV4 authentication using the connector's credentials) to the AWS IoT Core data endpoint, using the certificate's CN as the MQTT client identifier, and closes it immediately. This terminates any active MQTT session the device may have at that moment.",{"_2299":1496,"_22571":1340,"_15405":39826,"_5":15294,"_21315":39430,"_1890":39827},[],"This forced disconnect happens at the moment Lamassu records the status change. If the device tries to reconnect after the disconnect, AWS IoT Core will reject the connection because the certificate is already listed as `REVOKED` or `INACTIVE`.",{"_2299":1497,"_22571":1340,"_15405":39829,"_5":15294,"_21315":39430,"_1890":39830},[],"Certificates provisioned in JITP mode do not have this automatic sync, since they lack the connector's metadata key.",{"_2299":1498,"_22571":1340,"_15405":39832,"_5":15294,"_21315":39434,"_1890":39833},[],"The connector can write to the AWS IoT Core Device Shadow to send action signals to the device firmware. This feature is enabled per DMS with `shadow_config.enable: true`.",{"_2299":1499,"_22571":1340,"_15405":39835,"_5":15294,"_21315":39434,"_1890":39836},[],"If `shadow_config.shadow_name` holds a value, the connector uses a Named Shadow with that name; otherwise it uses the Classic Shadow (the Thing's default shadow).",{"_2299":1500,"_22571":1340,"_15405":39838,"_5":15294,"_21315":39438,"_1890":39839},[],"The connector writes to the `desired.identity_actions` field of the shadow document. Each entry contains a Unix timestamp in milliseconds. The device firmware must read this field and act accordingly.",{"_2299":1501,"_22571":1340,"_15405":39841,"_5":15294,"_21315":39438,"_1890":39842},[],"There are two action types:",{"_2299":1502,"_22571":1340,"_15405":39844,"_5":15294,"_21315":39438,"_1890":39845},[],"**`UPDATE_CERTIFICATE`**: written when a certificate's preventive renewal window activates — that is, when the `triggered` field of the preventive renewal delta flips from `false` to `true`. This action tells the device it must start the re-enrollment process to renew its certificate before it expires.",{"_2299":1503,"_22571":1340,"_15405":39847,"_5":15294,"_21315":39438,"_1890":39848},[],"**`UPDATE_TRUST_ANCHOR_LIST`**: written to all devices of a DMS when the DMS's `ManagedCAs` list changes. This action tells the device it must update its trusted CA store.",{"_2299":1504,"_22571":1340,"_15405":39850,"_5":15294,"_21315":39438,"_1890":39851},[],"The shadow write process consists of reading the current shadow (`iotdata:GetThingShadow`), merging the new actions with the existing ones and writing the result (`iotdata:UpdateThingShadow`). If the shadow does not exist, the connector creates it. After a successful write, the list of pending actions in the device's metadata in Lamassu is cleared.",{"_2299":1505,"_22571":1340,"_15405":39853,"_5":15294,"_21315":39442,"_1890":39854},[],"The connector creates and attaches the policies configured in the DMS. A typical policy for a device using MQTT and the Device Shadow has this structure:",{"_2299":1506,"_22571":1340,"_15405":39856,"_5":15294,"_21315":39442,"_1890":39857},[],"In the policy above, the `<AWS_REGION>` and `<AWS_ACCOUNT_ID>` placeholders must be replaced with the AWS region and the twelve-digit account identifier of the target account before applying the policy. The `${iot:Connection.Thing.ThingName}` variable automatically limits each permission to the Thing the device is connected as, following the principle of least privilege. The `${ShadowName}` variable in the shadow ARNs is a placeholder that must be replaced with the `shadow_config.shadow_name` value configured in the DMS; if the Classic Shadow is used, it can be simplified by removing the `name/${ShadowName}/` segment. AWS IoT policies do not support regex alternation; the `[name/${ShadowName}/]*` notation represents the optionality of that segment within ARN syntax constraints.",{"_2299":1507,"_22571":1340,"_15405":39859,"_5":15294,"_21315":39442,"_1890":39860},[],"The first statement lets the device connect using its ThingName as the MQTT identifier. The second authorizes publishing to the Thing's generic MQTT topic and to the shadow topics, needed so the device can update its reported state. The last two statements grant subscribe and receive permissions over the same topics, letting the device receive shadow updates (for example, the `UPDATE_CERTIFICATE` and `UPDATE_TRUST_ANCHOR_LIST` actions written by the connector).",{"_2299":1508,"_22571":1340,"_15405":39862,"_5":15294,"_21315":39446,"_1890":39863},[],"**Symptom:** The CA registration stays in `REQUESTED` indefinitely.",{"_2299":1509,"_22571":1340,"_15405":39865,"_5":15294,"_21315":39446,"_1890":39866},[],"**Cause:** The connector is not running or is not subscribed to the event bus. It can also indicate incorrect IAM credentials, insufficient permissions or that the metadata key was written with a wrong `connector_id`.",{"_2299":1510,"_22571":1340,"_15405":39868,"_5":15294,"_21315":39446,"_1890":39869},[],"**Resolution:** Verify the connector process is active and the logs show no AWS communication errors. Check the metadata field was written under the exact key `lamassu.io/iot/{connector_id}`. If the error persists, the connector will update the status to `FAILED` with a descriptive message in the CA metadata.",{"_2299":1511,"_22571":1340,"_15405":39871,"_5":15294,"_21315":39446,"_1890":39872},[],"**Symptom:** A certificate's status is not synced to AWS after a revocation.",{"_2299":1512,"_22571":1340,"_15405":39874,"_5":15294,"_21315":39446,"_1890":39875},[],"**Cause:** Most commonly the certificate was provisioned in JITP mode. JITP certificates lack the connector's metadata key and are outside the state synchronization mechanism. If the DMS is in `auto` mode, it may indicate the initial provisioning did not complete correctly and the AWS ARN was not stored in the certificate metadata.",{"_2299":1513,"_22571":1340,"_15405":39877,"_5":15294,"_21315":39446,"_1890":39878},[],"**Resolution:** For JITP certificates, migrate the DMS to `auto` mode and re-provision the affected devices. For `auto` mode certificates, verify the certificate has the AWS ARN stored in its metadata; if not, repeat the provisioning.",{"_2299":1514,"_22571":1340,"_15405":39880,"_5":15294,"_21315":39446,"_1890":39881},[],"**Symptom:** The forced disconnect does not terminate the device's MQTT session after revocation.",{"_2299":1515,"_22571":1340,"_15405":39883,"_5":15294,"_21315":39446,"_1890":39884},[],"**Cause:** The device uses an MQTT client ID different from the certificate's CN. The forced disconnect opens a connection using the CN as client ID; if the firmware uses another identifier, the disconnect does not affect that session.",{"_2299":1516,"_22571":1340,"_15405":39886,"_5":15294,"_21315":39446,"_1890":39887},[],"**Resolution:** Make sure the firmware uses exactly the certificate's CN as the MQTT client identifier. That CN matches the ThingName in AWS IoT Core.",{"_2299":1517,"_22571":1340,"_15405":39889,"_5":15294,"_21315":39446,"_1890":39890},[],"**Symptom:** The device receives `CLIENT_ID_REJECTED` when connecting to AWS IoT Core.",{"_2299":1518,"_22571":1340,"_15405":39892,"_5":15294,"_21315":39446,"_1890":39893},[],"**Cause:** The MQTT client ID does not match the ThingName, which is always the CN of the certificate issued by Lamassu.",{"_2299":1519,"_22571":1340,"_15405":39895,"_5":15294,"_21315":39446,"_1890":39896},[],"**Resolution:** Verify the firmware uses exactly the value of the CN field included in the enrollment CSR as the MQTT client identifier.",{"_2299":1520,"_22571":1340,"_15405":39898,"_5":15294,"_21315":39446,"_1890":39899},[],"**Symptom:** The device's first MQTT connection in JITP mode fails or times out.",{"_2299":1521,"_22571":1340,"_15405":39901,"_5":15294,"_21315":39446,"_1890":39902},[],"**Cause:** This is expected behavior while AWS executes the JITP template on the device's first connection.",{"_2299":1522,"_22571":1340,"_15405":39904,"_5":15294,"_21315":39446,"_1890":39905},[],"**Resolution:** Firmware must implement retries with exponential backoff for the first connection. If the failure persists beyond a few minutes, verify the IAM role configured in `jitp_config.provisioning_role_arn` exists in the account and has permissions to create Things, register certificates and attach policies.",{"_2299":1523,"_22571":1340,"_15405":39907,"_5":15294,"_21315":39446,"_1890":39908},[],"**Symptom:** The Device Shadow is not updated when it should be.",{"_2299":1524,"_22571":1340,"_15405":39910,"_5":15294,"_21315":39446,"_1890":39911},[],"**Cause:** The shadow feature is disabled in the DMS configuration, the connector's credentials lack IoT data-plane permissions, or the firmware reads a different shadow than the configured one.",{"_2299":1525,"_22571":1340,"_15405":39913,"_5":15294,"_21315":39446,"_1890":39914},[],"**Resolution:** Check that `shadow_config.enable` is `true` in the connector metadata for the corresponding DMS. If a Named Shadow is used, verify `shadow_config.shadow_name` holds the correct name and that the firmware reads that Named Shadow and not the Classic Shadow. Confirm the connector's credentials have `iotdata:GetThingShadow` and `iotdata:UpdateThingShadow` permissions.",{"_2299":1526,"_22571":1340,"_15405":39916,"_5":15294,"_21315":39446,"_1890":39917},[],"<Card title=\"Configure a DMS\" href=\"/docs/platform/pki/device-enrollment\" />",{"_2299":1527,"_22571":1340,"_15405":39919,"_5":15294,"_21315":39446,"_1890":39920},[],"<Card title=\"Device enrollment (EST)\" href=\"/docs/platform/pki/est-enrollment\" />",{"_2299":1528,"_22571":1340,"_15405":39922,"_5":15294,"_21315":39446,"_1890":39923},[],"<Card title=\"Certificate management\" href=\"/docs/platform/pki/certificates\" />",{"_2299":1529,"_22571":1529,"_5":10616,"_1890":39925,"_22830":39926,"_15405":39927,"_21315":1529},"Keys and cryptographic engines",[35156,36291,36769],[],{"_2299":1530,"_22571":1529,"_15405":39929,"_5":15294,"_21315":1529,"_1890":39930},[],"Generate, import and operate keys without coupling the PKI to a specific provider.",{"_2299":1531,"_22571":1529,"_5":22827,"_15405":39932,"_21315":39933,"_1890":39934},[],"/docs/platform/pki/key-management#cryptographic-key-management","Cryptographic key management",{"_2299":1532,"_22571":1529,"_5":22827,"_15405":39936,"_21315":39937,"_1890":39938},[],"/docs/platform/pki/key-management#what-the-kms-solves","What the KMS solves",{"_2299":1533,"_22571":1529,"_5":22827,"_15405":39940,"_21315":39941,"_1890":39942},[],"/docs/platform/pki/key-management#cryptographic-engines","Cryptographic engines",{"_2299":1534,"_22571":1529,"_5":22827,"_15405":39944,"_21315":39945,"_1890":39946},[],"/docs/platform/pki/key-management#file-system","File System",{"_2299":1535,"_22571":1529,"_5":22827,"_15405":39948,"_21315":39949,"_1890":39950},[],"/docs/platform/pki/key-management#hashicorp-vault","HashiCorp Vault",{"_2299":1536,"_22571":1529,"_5":22827,"_15405":39952,"_21315":39953,"_1890":39954},[],"/docs/platform/pki/key-management#aws-secrets-manager","AWS Secrets Manager",{"_2299":1537,"_22571":1529,"_5":22827,"_15405":39956,"_21315":39957,"_1890":39958},[],"/docs/platform/pki/key-management#aws-kms","AWS KMS",{"_2299":1538,"_22571":1529,"_5":22827,"_15405":39960,"_21315":39961,"_1890":39962},[],"/docs/platform/pki/key-management#pkcs11","PKCS#11",{"_2299":1539,"_22571":1529,"_5":22827,"_15405":39964,"_21315":39965,"_1890":39966},[],"/docs/platform/pki/key-management#key-inventory","Key inventory",{"_2299":1540,"_22571":1529,"_5":22827,"_15405":39968,"_21315":39969,"_1890":39970},[],"/docs/platform/pki/key-management#create-or-import-keys","Create or import keys",{"_2299":1541,"_22571":1529,"_5":22827,"_15405":39972,"_21315":39973,"_1890":39974},[],"/docs/platform/pki/key-management#generate-a-new-key-pair","Generate a new key pair",{"_2299":1542,"_22571":1529,"_5":22827,"_15405":39976,"_21315":39977,"_1890":39978},[],"/docs/platform/pki/key-management#import-an-existing-pair","Import an existing pair",{"_2299":1543,"_22571":1529,"_5":22827,"_15405":39980,"_21315":39981,"_1890":39982},[],"/docs/platform/pki/key-management#operations-on-a-key","Operations on a key",{"_2299":1544,"_22571":1529,"_5":22827,"_15405":39984,"_21315":39985,"_1890":39986},[],"/docs/platform/pki/key-management#view-details","View details",{"_2299":1545,"_22571":1529,"_5":22827,"_15405":39988,"_21315":39989,"_1890":39990},[],"/docs/platform/pki/key-management#sign-and-verify","Sign and verify",{"_2299":1546,"_22571":1529,"_5":22827,"_15405":39992,"_21315":39993,"_1890":39994},[],"/docs/platform/pki/key-management#sign","Sign",{"_2299":1547,"_22571":1529,"_5":22827,"_15405":39996,"_21315":39997,"_1890":39998},[],"/docs/platform/pki/key-management#verify","Verify",{"_2299":1548,"_22571":1529,"_5":22827,"_15405":40000,"_21315":40001,"_1890":40002},[],"/docs/platform/pki/key-management#generate-a-csr","Generate a CSR",{"_2299":1549,"_22571":1529,"_5":22827,"_15405":40004,"_21315":40005,"_1890":40006},[],"/docs/platform/pki/key-management#sign-locally-with-pkcs11","Sign locally with PKCS#11",{"_2299":1550,"_22571":1529,"_15405":40008,"_5":15294,"_21315":39933,"_1890":40009},[],"The Cryptographic Key Management Service (KMS) of Lamassu IoT centralizes the generation, import, custody and use of the platform's keys. This is where you manage the keys that support the CAs and the rest of the signing operations that depend on the PKI.",{"_2299":1551,"_22571":1529,"_15405":40011,"_5":15294,"_21315":39933,"_1890":40012},[],"In the current configuration, Lamassu IoT works exclusively with asymmetric keys, such as RSA and elliptic curves. These keys are used to issue X.509 certificates, sign requests and perform authentication and validation operations within the system.",{"_2299":1552,"_22571":1529,"_15405":40014,"_5":15294,"_21315":39937,"_1890":40015},[],"The KMS unifies key lifecycle management and prevents every service from having to integrate directly with a specific cryptographic provider.",{"_2299":1553,"_22571":1529,"_15405":40017,"_5":15294,"_21315":39937,"_1890":40018},[],"In practice, it lets you:",{"_2299":1554,"_22571":1529,"_15405":40020,"_5":15294,"_21315":39937,"_1890":40021},[],"Generate new key pairs from Lamassu IoT.",{"_2299":1555,"_22571":1529,"_15405":40023,"_5":15294,"_21315":39937,"_1890":40024},[],"Import keys created externally.",{"_2299":1556,"_22571":1529,"_15405":40026,"_5":15294,"_21315":39937,"_1890":40027},[],"Delegate custody and cryptographic operations to external engines.",{"_2299":1557,"_22571":1529,"_15405":40029,"_5":15294,"_21315":39937,"_1890":40030},[],"Reuse existing keys for CAs, CSRs and signing or verification tasks.",{"_2299":1558,"_22571":1529,"_15405":40032,"_5":15294,"_21315":39941,"_1890":40033},[],"Lamassu can work with different cryptographic engines depending on deployment requirements. In some environments a software engine is enough; in others custody must be delegated to an HSM, a cloud service or a specialized platform.",{"_2299":1559,"_22571":1529,"_15405":40035,"_5":15294,"_21315":39941,"_1890":40036},[],"A single instance can have several engines configured at the same time, including multiple instances of the same type. This lets you adapt operations to different security, cost and regulatory requirements.",{"_2299":1560,"_22571":1529,"_15405":40038,"_5":15294,"_21315":39941,"_1890":40039},[],"Currently, Lamassu supports five engine types. Choose according to the isolation level you need and who should be able to access private material.",{"_2299":1561,"_22571":1529,"_15405":40041,"_5":15294,"_21315":39945,"_1890":40042},[],"Generates keys with Go's cryptographic libraries and delegates their protection to the file system. It works both on-premise and in the cloud, but it does not prevent key extraction and is not recommended for production.",{"_2299":1562,"_22571":1529,"_15405":40044,"_5":15294,"_21315":39949,"_1890":40045},[],"Protects keys at rest and can run on-premise or in the cloud. An administrator with sufficient permissions can still view private material, so it is wise to limit administrative access and safeguard the *unseal* keys.",{"_2299":1563,"_22571":1529,"_15405":40047,"_5":15294,"_21315":39953,"_1890":40048},[],"Offers encrypted persistence in AWS at a cost. It protects the key at rest, but an authorized administrator can recover it; it does not provide the same extraction resistance as a KMS or HSM.",{"_2299":1564,"_22571":1529,"_15405":40050,"_5":15294,"_21315":39957,"_1890":40051},[],"Generates keys with hardware entropy and never exposes the private key. Operations run inside the service. Even so, an identity with sufficient permissions could use the key to sign, so IAM policy remains critical.",{"_2299":1565,"_22571":1529,"_15405":40053,"_5":15294,"_21315":39961,"_1890":40054},[],"Allows integrating local HSMs, isolated environments and *Key as a Service* offerings. Generation, persistence and extraction resistance depend on the specific device or provider. It is the most flexible option when policy requires hardware custody.",{"_2299":1566,"_22571":1529,"_15405":40056,"_5":15294,"_21315":39961,"_1890":40057},[],"Lamassu shows the full list of enabled engines in the console.",{"_2299":1567,"_22571":1529,"_15405":40059,"_5":15294,"_21315":39961,"_1890":40060},[],"Each engine defines which algorithms it supports, such as RSA or ECC/ECDSA, and which key sizes it can generate.",{"_2299":1568,"_22571":1529,"_15405":40062,"_5":15294,"_21315":39961,"_1890":40063},[],"During deployment it is mandatory to define a default engine. That engine will be used when a process needs to create or persist a key and the user has not selected a specific one, for example when creating or importing a CA.",{"_2299":1569,"_22571":1529,"_15405":40065,"_5":15294,"_21315":39965,"_1890":40066},[],"The main KMS screen shows the complete inventory of keys registered in the system. It is the reference view for reviewing which keys exist, where they are kept and which entities they relate to.",{"_2299":1570,"_22571":1529,"_15405":40068,"_5":15294,"_21315":39965,"_1890":40069},[],"The table includes the following fields:",{"_2299":1571,"_22571":1529,"_15405":40071,"_5":15294,"_21315":39965,"_1890":40072},[],"**Name**: descriptive name of the key.",{"_2299":1572,"_22571":1529,"_15405":40074,"_5":15294,"_21315":39965,"_1890":40075},[],"**Type**: algorithm and key size, for example RSA 2048 or EC P-256.",{"_2299":1573,"_22571":1529,"_15405":40077,"_5":15294,"_21315":39965,"_1890":40078},[],"**Strength**: visual indicator of cryptographic strength.",{"_2299":1574,"_22571":1529,"_15405":40080,"_5":15294,"_21315":39965,"_1890":40081},[],"**Public/Private**: whether Lamassu manages the full pair or only the public key.",{"_2299":1575,"_22571":1529,"_15405":40083,"_5":15294,"_21315":39965,"_1890":40084},[],"**Crypto Engine**: cryptographic engine keeping the key.",{"_2299":1576,"_22571":1529,"_15405":40086,"_5":15294,"_21315":39965,"_1890":40087},[],"**Aliases**: alternative names associated with the key.",{"_2299":1577,"_22571":1529,"_15405":40089,"_5":15294,"_21315":39965,"_1890":40090},[],"**Tags**: labels for classification and search.",{"_2299":1578,"_22571":1529,"_15405":40092,"_5":15294,"_21315":39965,"_1890":40093},[],"**Related Entities**: certificates or other entities linked to that key.",{"_2299":1579,"_22571":1529,"_15405":40095,"_5":15294,"_21315":39965,"_1890":40096},[],"From this view you also reach the most common actions:",{"_2299":1580,"_22571":1529,"_15405":40098,"_5":15294,"_21315":39965,"_1890":40099},[],"**View Details** to inspect metadata, identifiers and relationships.",{"_2299":1581,"_22571":1529,"_15405":40101,"_5":15294,"_21315":39965,"_1890":40102},[],"**Generate CSR** to create a PKCS#10 request with the selected key.",{"_2299":1582,"_22571":1529,"_15405":40104,"_5":15294,"_21315":39965,"_1890":40105},[],"**Sign / Verify** to test cryptographic operations on the key.",{"_2299":1583,"_22571":1529,"_15405":40107,"_5":15294,"_21315":39965,"_1890":40108},[],"**Delete Key** to remove the key from the system.",{"_2299":1584,"_22571":1529,"_15405":40110,"_5":15294,"_21315":39969,"_1890":40111},[],"Keys are registered from the wizard opened with **Create New Key**.",{"_2299":1585,"_22571":1529,"_15405":40113,"_5":15294,"_21315":39973,"_1890":40114},[],"If the key will be born inside Lamassu, the recommended flow is to generate a new pair managed directly by one of the configured engines.",{"_2299":1586,"_22571":1529,"_15405":40116,"_5":15294,"_21315":39973,"_1890":40117},[],"On the wizard's first screen, choose **Generate New Key Pair** and then define the main parameters:",{"_2299":1587,"_22571":1529,"_15405":40119,"_5":15294,"_21315":39973,"_1890":40120},[],"**Key Name**: unique and descriptive name.",{"_2299":1588,"_22571":1529,"_15405":40122,"_5":15294,"_21315":39973,"_1890":40123},[],"**Crypto Engine**: engine that will keep the key.",{"_2299":1589,"_22571":1529,"_15405":40125,"_5":15294,"_21315":39973,"_1890":40126},[],"**Key Type** and **Key Size**: algorithm and size or curve.",{"_2299":1590,"_22571":1529,"_15405":40128,"_5":15294,"_21315":39973,"_1890":40129},[],"**Tags**: metadata to classify the key.",{"_2299":1591,"_22571":1529,"_15405":40131,"_5":15294,"_21315":39973,"_1890":40132},[],"**Metadata**: additional information for advanced uses.",{"_2299":1592,"_22571":1529,"_15405":40134,"_5":15294,"_21315":39977,"_1890":40135},[],"Importing lets you register in Lamassu a key generated outside the platform. It is the usual flow in BYOK scenarios, migrations or integration with cryptographic material already in production.",{"_2299":1593,"_22571":1529,"_15405":40137,"_5":15294,"_21315":39977,"_1890":40138},[],"When the key was generated in an isolated environment or an external HSM.",{"_2299":1594,"_22571":1529,"_15405":40140,"_5":15294,"_21315":39977,"_1890":40141},[],"When an existing PKI needs to be migrated without reissuing certificates.",{"_2299":1595,"_22571":1529,"_15405":40143,"_5":15294,"_21315":39977,"_1890":40144},[],"When Lamassu must operate with a root of trust created by a third party.",{"_2299":1596,"_22571":1529,"_15405":40146,"_5":15294,"_21315":39977,"_1890":40147},[],"In the wizard, choose **Import Existing Key Pair** and complete the requested fields:",{"_2299":1597,"_22571":1529,"_15405":40149,"_5":15294,"_21315":39977,"_1890":40150},[],"**Key Name**: descriptive name within Lamassu IoT.",{"_2299":1598,"_22571":1529,"_15405":40152,"_5":15294,"_21315":39977,"_1890":40153},[],"**Crypto Engine**: engine that will keep the imported key.",{"_2299":1599,"_22571":1529,"_15405":40155,"_5":15294,"_21315":39977,"_1890":40156},[],"**Tags**: labels for organization and search.",{"_2299":1600,"_22571":1529,"_15405":40158,"_5":15294,"_21315":39977,"_1890":40159},[],"**Metadata**: additional optional information.",{"_2299":1601,"_22571":1529,"_15405":40161,"_5":15294,"_21315":39977,"_1890":40162},[],"**Private Key (PEM)**: private key in PEM format.",{"_2299":1602,"_22571":1529,"_15405":40164,"_5":15294,"_21315":39977,"_1890":40165},[],"Once the wizard is complete, the key is stored in the selected engine and can be used for signing, CSR generation and the rest of the operations supported by the KMS.",{"_2299":1603,"_22571":1529,"_15405":40167,"_5":15294,"_21315":39981,"_1890":40168},[],"Each registered key has a detail view and several operational actions.",{"_2299":1604,"_22571":1529,"_15405":40170,"_5":15294,"_21315":39985,"_1890":40171},[],"The **View Details** screen concentrates the technical and administrative information of the key.",{"_2299":1605,"_22571":1529,"_15405":40173,"_5":15294,"_21315":39985,"_1890":40174},[],"The **Overview** tab shows, among others, these fields:",{"_2299":1606,"_22571":1529,"_15405":40176,"_5":15294,"_21315":39985,"_1890":40177},[],"**Key Name**: descriptive name.",{"_2299":1607,"_22571":1529,"_15405":40179,"_5":15294,"_21315":39985,"_1890":40180},[],"**Key Identifier**: unique system identifier. Lamassu uses PKCS11-based ID formats.",{"_2299":1608,"_22571":1529,"_15405":40182,"_5":15294,"_21315":39985,"_1890":40183},[],"**Tags**: associated labels.",{"_2299":1609,"_22571":1529,"_15405":40185,"_5":15294,"_21315":39985,"_1890":40186},[],"**Aliases**: alternative names.",{"_2299":1610,"_22571":1529,"_15405":40188,"_5":15294,"_21315":39985,"_1890":40189},[],"**Crypto Engine**: engine where the key resides.",{"_2299":1611,"_22571":1529,"_15405":40191,"_5":15294,"_21315":39985,"_1890":40192},[],"**Algorithm, Key Size & Strength**: algorithm, parameters and strength level.",{"_2299":1612,"_22571":1529,"_15405":40194,"_5":15294,"_21315":39985,"_1890":40195},[],"The **Related Entities** section shows which Lamassu objects depend on that key.",{"_2299":1613,"_22571":1529,"_15405":40197,"_5":15294,"_21315":39985,"_1890":40198},[],"The **Public Key** tab presents the public key in PEM format, ready to consult or copy.",{"_2299":1614,"_22571":1529,"_15405":40200,"_5":15294,"_21315":39989,"_1890":40201},[],"The **Sign / Verify** action validates that the key and the cryptographic engine work correctly.",{"_2299":1615,"_22571":1529,"_15405":40203,"_5":15294,"_21315":39989,"_1890":40204},[],"When you open it, two areas appear: **Sign** and **Verify**.",{"_2299":1616,"_22571":1529,"_15405":40206,"_5":15294,"_21315":39993,"_1890":40207},[],"This tab uses the private key to generate a digital signature over a message or an already computed *digest*.",{"_2299":1617,"_22571":1529,"_15405":40209,"_5":15294,"_21315":39993,"_1890":40210},[],"Main fields:",{"_2299":1618,"_22571":1529,"_15405":40212,"_5":15294,"_21315":39993,"_1890":40213},[],"**Algorithm**: signing algorithm available for the key type.",{"_2299":1619,"_22571":1529,"_15405":40215,"_5":15294,"_21315":39993,"_1890":40216},[],"**Message Type**: `Raw` for clear data or `Digest` for a precomputed hash.",{"_2299":1620,"_22571":1529,"_15405":40218,"_5":15294,"_21315":39993,"_1890":40219},[],"**Payload Encoding**: input encoding, such as UTF-8, Hex or Base64.",{"_2299":1621,"_22571":1529,"_15405":40221,"_5":15294,"_21315":39993,"_1890":40222},[],"**Message**: content to sign.",{"_2299":1622,"_22571":1529,"_15405":40224,"_5":15294,"_21315":39993,"_1890":40225},[],"**Signature**: result of the operation, shown in hexadecimal.",{"_2299":1623,"_22571":1529,"_15405":40227,"_5":15294,"_21315":39997,"_1890":40228},[],"This tab checks whether a signature corresponds to the associated public key.",{"_2299":1624,"_22571":1529,"_15405":40230,"_5":15294,"_21315":39997,"_1890":40210},[],{"_2299":1625,"_22571":1529,"_15405":40232,"_5":15294,"_21315":39997,"_1890":40233},[],"**Algorithm**: must match the algorithm used for the signature.",{"_2299":1626,"_22571":1529,"_15405":40235,"_5":15294,"_21315":39997,"_1890":40236},[],"**Message Type**: `Raw` or `Digest`.",{"_2299":1627,"_22571":1529,"_15405":40238,"_5":15294,"_21315":39997,"_1890":40239},[],"**Payload Encoding**: encoding of the message.",{"_2299":1628,"_22571":1529,"_15405":40241,"_5":15294,"_21315":39997,"_1890":40242},[],"**Message**: original message or hash.",{"_2299":1629,"_22571":1529,"_15405":40244,"_5":15294,"_21315":39997,"_1890":40245},[],"**Signature**: signature to check.",{"_2299":1630,"_22571":1529,"_15405":40247,"_5":15294,"_21315":39997,"_1890":40248},[],"**Result**: indicator of the validation result.",{"_2299":1631,"_22571":1529,"_15405":40250,"_5":15294,"_21315":40001,"_1890":40251},[],"The **Generate CSR** action creates a PKCS#10 request signed with the private key kept in Lamassu, without exposing it outside the cryptographic engine.",{"_2299":1632,"_22571":1529,"_15405":40253,"_5":15294,"_21315":40001,"_1890":40254},[],"This flow is useful for:",{"_2299":1633,"_22571":1529,"_15405":40256,"_5":15294,"_21315":40001,"_1890":40257},[],"Requesting certificates from an external CA.",{"_2299":1634,"_22571":1529,"_15405":40259,"_5":15294,"_21315":40001,"_1890":40260},[],"Renewing an identity while keeping the same key.",{"_2299":1635,"_22571":1529,"_15405":40262,"_5":15294,"_21315":40001,"_1890":40263},[],"When you open the form, it asks for the subject data and the main certificate attributes:",{"_2299":1636,"_22571":1529,"_15405":40265,"_5":15294,"_21315":40001,"_1890":40266},[],"**Common Name (CN)**: main name of the identity.",{"_2299":1637,"_22571":1529,"_15405":40268,"_5":15294,"_21315":40001,"_1890":40269},[],"**Organization (O)**: organization or company.",{"_2299":1638,"_22571":1529,"_15405":40271,"_5":15294,"_21315":40001,"_1890":40272},[],"**Organizational Unit (OU)**: department or unit.",{"_2299":1639,"_22571":1529,"_15405":40274,"_5":15294,"_21315":40001,"_1890":40275},[],"**Country (C)**: two-letter country code.",{"_2299":1640,"_22571":1529,"_15405":40277,"_5":15294,"_21315":40001,"_1890":40278},[],"**State / Province (ST)**: state or province.",{"_2299":1641,"_22571":1529,"_15405":40280,"_5":15294,"_21315":40001,"_1890":40281},[],"**Locality (L)**: city or locality.",{"_2299":1642,"_22571":1529,"_15405":40283,"_5":15294,"_21315":40001,"_1890":40284},[],"**Email Address**: contact email.",{"_2299":1643,"_22571":1529,"_15405":40286,"_5":15294,"_21315":40001,"_1890":40287},[],"**Subject Alternative Names (SANs)**: alternative names or identifiers, such as DNS or IP.",{"_2299":1644,"_22571":1529,"_15405":40289,"_5":15294,"_21315":40001,"_1890":40290},[],"Once the form is complete, Lamassu generates the CSR and presents it for download or copy.",{"_2299":1645,"_22571":1529,"_15405":40292,"_5":15294,"_21315":40005,"_1890":40293},[],"Lamassu also offers specific help for local integrations through **Sign locally with OpenSSL & PKCS11 tools**.",{"_2299":1646,"_22571":1529,"_15405":40295,"_5":15294,"_21315":40005,"_1890":40296},[],"This option shows the steps needed to configure the local environment, load the PKCS#11 module and perform signatures with tools like OpenSSL without extracting the private key from the secured environment.",{"_2299":1647,"_22571":1647,"_5":10616,"_1890":40298,"_22830":40299,"_15405":40300,"_21315":1647},"Online validation with OCSP",[35156,36291,36769],[],{"_2299":1648,"_22571":1647,"_15405":40302,"_5":15294,"_21315":1647,"_1890":40303},[],"Check in real time whether a certificate is still valid or has been revoked.",{"_2299":1649,"_22571":1647,"_5":22827,"_15405":40305,"_21315":40306,"_1890":40307},[],"/docs/platform/pki/ocsp#ocsp-service","OCSP service",{"_2299":1650,"_22571":1647,"_5":22827,"_15405":40309,"_21315":40310,"_1890":40311},[],"/docs/platform/pki/ocsp#how-the-responder-works-in-lamassu","How the responder works in Lamassu",{"_2299":1651,"_22571":1647,"_5":22827,"_15405":40313,"_21315":40314,"_1890":40315},[],"/docs/platform/pki/ocsp#embedding-in-issued-certificates","Embedding in issued certificates",{"_2299":1652,"_22571":1647,"_5":22827,"_15405":40317,"_21315":40318,"_1890":40319},[],"/docs/platform/pki/ocsp#http-endpoints","HTTP endpoints",{"_2299":1653,"_22571":1647,"_5":22827,"_15405":40321,"_21315":40322,"_1890":40323},[],"/docs/platform/pki/ocsp#check-from-the-interface","Check from the interface",{"_2299":1654,"_22571":1647,"_5":22827,"_15405":40325,"_21315":40326,"_1890":38261},[],"/docs/platform/pki/ocsp#references",{"_2299":1655,"_22571":1647,"_15405":40328,"_5":15294,"_21315":40306,"_1890":40329},[],"OCSP (Online Certificate Status Protocol) is the mechanism that lets a relying party check, in real time, whether a specific certificate is valid or has been revoked. Instead of downloading a full list of revoked certificates, the client sends a query with the certificate's serial number and receives a signed response with the current status.",{"_2299":1656,"_22571":1647,"_15405":40331,"_5":15294,"_21315":40306,"_1890":40332},[],"Lamassu integrates its own OCSP responder that serves these queries by consulting the internal certificate database directly. No external component is required.",{"_2299":1657,"_22571":1647,"_15405":40334,"_5":15294,"_21315":40310,"_1890":40335},[],"When a client requests the status of a certificate, the responder locates the certificate by its serial number and determines its status from the internal record:",{"_2299":1658,"_22571":1647,"_15405":40337,"_5":15294,"_21315":40310,"_1890":40338},[],"If the certificate is active, the response indicates `Good`.",{"_2299":1659,"_22571":1647,"_15405":40340,"_5":15294,"_21315":40310,"_1890":40341},[],"If the certificate has been revoked, the response indicates `Revoked` and includes the revocation timestamp and the RFC 5280 reason code.",{"_2299":1660,"_22571":1647,"_15405":40343,"_5":15294,"_21315":40310,"_1890":40344},[],"If the serial number is not found or the status is not recognizable, the response indicates `Unknown`.",{"_2299":1661,"_22571":1647,"_15405":40346,"_5":15294,"_21315":40310,"_1890":40347},[],"The OCSP response is signed by the issuing CA of the queried certificate, using the cryptographic engine associated with that CA. Lamassu does not use a delegated OCSP signing certificate: the CA acts directly as the responder.",{"_2299":1662,"_22571":1647,"_15405":40349,"_5":15294,"_21315":40310,"_1890":40350},[],"Each response has a validity window of 24 hours, reflected in the response's `thisUpdate` and `nextUpdate` fields. Clients that cache responses must take this window into account when determining how long a response remains valid.",{"_2299":1663,"_22571":1647,"_15405":40352,"_5":15294,"_21315":40314,"_1890":40353},[],"The OCSP responder URL is automatically embedded in the AIA (*Authority Information Access*) extension of every certificate issued by Lamassu. Clients that verify certificates can read this URL directly from the certificate without additional configuration.",{"_2299":1664,"_22571":1647,"_15405":40355,"_5":15294,"_21315":40318,"_1890":40356},[],"The responder accepts both formats defined in RFC 6960:",{"_2299":1665,"_22571":1647,"_15405":40358,"_5":15294,"_21315":40318,"_1890":40359},[],"`GET /ocsp/{ocsp_request}` includes the OCSP request Base64url-encoded within the URL itself.",{"_2299":1666,"_22571":1647,"_15405":40361,"_5":15294,"_21315":40318,"_1890":40362},[],"`POST /ocsp` sends the request in the body with `Content-Type: application/ocsp-request`.",{"_2299":1667,"_22571":1647,"_15405":40364,"_5":15294,"_21315":40318,"_1890":40365},[],"Example query with `curl` using POST:",{"_2299":1668,"_22571":1647,"_15405":40367,"_5":15294,"_21315":40318,"_1890":40368},[],"The response has `Content-Type: application/ocsp-response` and contains the OCSP response in DER format.",{"_2299":1669,"_22571":1647,"_15405":40370,"_5":15294,"_21315":40322,"_1890":40371},[],"From the certificates screen of Lamassu you can launch an OCSP request directly against the selected certificate with the **OCSP Check** action. This action shows the status returned by the responder without needing external tools.",{"_2299":1670,"_22571":1647,"_15405":40373,"_5":15294,"_21315":40326,"_1890":40374},[],"RFC 6960 - *X.509 Internet Public Key Infrastructure Online Certificate Status Protocol – OCSP*",{"_2299":1671,"_22571":1647,"_15405":40376,"_5":15294,"_21315":40326,"_1890":40377},[],"RFC 5280 - *Internet X.509 Public Key Infrastructure Certificate and Certificate Revocation List (CRL) Profile* (revocation reasons, section 5.3.1)",{"_2299":1672,"_22571":1647,"_15405":40379,"_5":15294,"_21315":40326,"_1890":40380},[],"<Card title=\"CRL service\" href=\"/docs/platform/pki/crl\" />",{"_2299":1673,"_22571":1647,"_15405":40382,"_5":15294,"_21315":40326,"_1890":38353},[],{"_2299":1674,"_22571":1674,"_5":10616,"_1890":40384,"_22830":40385,"_15405":40386,"_21315":1674},"Lamassu IoT Platform",[35156,36291],[],{"_2299":1675,"_22571":1674,"_15405":40388,"_5":15294,"_21315":1674,"_1890":40389},[],"Manage PKI and digital identities for your devices from a single platform.",{"_2299":1676,"_22571":1674,"_5":22827,"_15405":40391,"_21315":40392,"_1890":40393},[],"/docs/platform/pki/overview#start-here","Start here",{"_2299":1677,"_22571":1674,"_5":22827,"_15405":40395,"_21315":40396,"_1890":40397},[],"/docs/platform/pki/overview#core-capabilities","Core capabilities",{"_2299":1678,"_22571":1674,"_5":22827,"_15405":40399,"_21315":40400,"_1890":40401},[],"/docs/platform/pki/overview#build-your-trust-hierarchy","Build your trust hierarchy",{"_2299":1679,"_22571":1674,"_5":22827,"_15405":40403,"_21315":40404,"_1890":40405},[],"/docs/platform/pki/overview#protect-cryptographic-keys","Protect cryptographic keys",{"_2299":1680,"_22571":1674,"_5":22827,"_15405":40407,"_21315":40408,"_1890":40409},[],"/docs/platform/pki/overview#issue-and-control-certificates","Issue and control certificates",{"_2299":1681,"_22571":1674,"_5":22827,"_15405":40411,"_21315":40412,"_1890":40413},[],"/docs/platform/pki/overview#automate-device-identities","Automate device identities",{"_2299":1682,"_22571":1674,"_5":22827,"_15405":40415,"_21315":40416,"_1890":40417},[],"/docs/platform/pki/overview#publish-validation-status","Publish validation status",{"_2299":1683,"_22571":1674,"_5":22827,"_15405":40419,"_21315":40420,"_1890":40421},[],"/docs/platform/pki/overview#react-to-events","React to events",{"_2299":1684,"_22571":1674,"_5":22827,"_15405":40423,"_21315":40424,"_1890":40425},[],"/docs/platform/pki/overview#choose-your-path","Choose your path",{"_2299":1685,"_22571":1674,"_5":22827,"_15405":40427,"_21315":40428,"_1890":40429},[],"/docs/platform/pki/overview#operational-reference","Operational reference",{"_2299":1686,"_22571":1674,"_15405":40431,"_5":15294,"_21315":1674,"_1890":40432},[],"Lamassu IoT centralizes the issuance, distribution, renewal and revocation of X.509 identities for connected devices. You can build a private PKI, protect its keys and automate the enrollment of a fleet without losing visibility into every certificate.",{"_2299":1687,"_22571":1674,"_15405":40434,"_5":15294,"_21315":40392,"_1890":40435},[],"<Card title=\"Get started\" description=\"Create a CA, issue a certificate and register your first device.\" href=\"/docs/platform/pki/quickstarts/overview\" />",{"_2299":1688,"_22571":1674,"_15405":40437,"_5":15294,"_21315":40392,"_1890":40438},[],"<Card title=\"How Lamassu works\" description=\"Build the mental model of authorities, keys, identities and validation.\" href=\"/docs/platform/pki/concepts/overview\" />",{"_2299":1689,"_22571":1674,"_15405":40440,"_5":15294,"_21315":40400,"_1890":40441},[],"Create root and intermediate authorities or import an existing PKI. Define which authority can issue each identity and keep the full chain of trust.",{"_2299":1690,"_22571":1674,"_15405":40443,"_5":15294,"_21315":40404,"_1890":40444},[],"Generate and safeguard keys using software engines, PKCS#11 HSMs or cloud services. Lamassu decouples operations from the physical location of the key.",{"_2299":1691,"_22571":1674,"_15405":40446,"_5":15294,"_21315":40408,"_1890":40447},[],"Issue certificates from the console or from a CSR, check their status and revoke them when they stop being trustworthy.",{"_2299":1692,"_22571":1674,"_15405":40449,"_5":15294,"_21315":40412,"_1890":40450},[],"Define enrollment policies with a Device Management Service (DMS) and let devices request or renew their identity through EST.",{"_2299":1693,"_22571":1674,"_15405":40452,"_5":15294,"_21315":40416,"_1890":40453},[],"Offer online validation through OCSP and distribute CRLs for consumers that need to check certificates offline.",{"_2299":1694,"_22571":1674,"_15405":40455,"_5":15294,"_21315":40420,"_1890":40456},[],"Subscribe to lifecycle changes and send notifications by email, Microsoft Teams or webhooks.",{"_2299":1695,"_22571":1674,"_15405":40458,"_5":15294,"_21315":40424,"_1890":40459},[],"<Card title=\"I administer the PKI\" description=\"Configure engines, authorities, issuance and validation.\" href=\"/docs/platform/pki/key-management\" />",{"_2299":1696,"_22571":1674,"_15405":40461,"_5":15294,"_21315":40424,"_1890":40462},[],"<Card title=\"I integrate a device\" description=\"Configure the DMS and use EST to obtain an identity.\" href=\"/docs/platform/pki/device-enrollment\" />",{"_2299":1697,"_22571":1674,"_15405":40464,"_5":15294,"_21315":40424,"_1890":40465},[],"<Card title=\"I operate the platform\" description=\"Deploy Lamassu and prepare its dependencies.\" href=\"/docs/deployment/overview\" />",{"_2299":1698,"_22571":1674,"_15405":40467,"_5":15294,"_21315":40424,"_1890":40468},[],"<Card title=\"I integrate another system\" description=\"Connect Lamassu with AWS IoT Core and other destinations.\" href=\"/docs/platform/pki/integrations/aws-iot-core\" />",{"_2299":1699,"_22571":1674,"_15405":40470,"_5":15294,"_21315":40428,"_1890":40471},[],"<Card title=\"Certificate profiles\" description=\"Turn issuance policy into reusable constraints.\" href=\"/docs/platform/pki/certificate-profiles\" />",{"_2299":1700,"_22571":1674,"_15405":40473,"_5":15294,"_21315":40428,"_1890":40474},[],"<Card title=\"Hierarchy and rotation\" description=\"Replace CA certificates or keys without breaking trust.\" href=\"/docs/platform/pki/ca-hierarchy-and-rotation\" />",{"_2299":1701,"_22571":1674,"_15405":40476,"_5":15294,"_21315":40428,"_1890":40477},[],"<Card title=\"Access control\" description=\"Configure principals, policies and the first administrator.\" href=\"/docs/platform/pki/access-control\" />",{"_2299":1702,"_22571":1674,"_15405":40479,"_5":15294,"_21315":40428,"_1890":40480},[],"<Card title=\"Troubleshooting\" description=\"Diagnose the Gateway, services, issuance and enrollment.\" href=\"/docs/platform/pki/troubleshooting\" />",{"_2299":1703,"_22571":1703,"_5":10616,"_1890":40482,"_22830":40483,"_15405":40485,"_21315":1703},"Create your first CA",[35156,36291,40484],"Getting started",[],{"_2299":1704,"_22571":1703,"_15405":40487,"_5":15294,"_21315":1703,"_1890":40488},[],"Create a root authority and check that it is ready to issue certificates.",{"_2299":1705,"_22571":1703,"_5":22827,"_15405":40490,"_21315":40491,"_1890":35166},[],"/docs/platform/pki/quickstarts/create-certificate-authority#before-you-begin",{"_2299":1706,"_22571":1703,"_5":22827,"_15405":40493,"_21315":40494,"_1890":40495},[],"/docs/platform/pki/quickstarts/create-certificate-authority#open-the-creation-wizard","Open the creation wizard",{"_2299":1707,"_22571":1703,"_5":22827,"_15405":40497,"_21315":40498,"_1890":40499},[],"/docs/platform/pki/quickstarts/create-certificate-authority#select-the-key","Select the key",{"_2299":1708,"_22571":1703,"_5":22827,"_15405":40501,"_21315":40502,"_1890":40503},[],"/docs/platform/pki/quickstarts/create-certificate-authority#define-the-authority","Define the authority",{"_2299":1709,"_22571":1703,"_5":22827,"_15405":40505,"_21315":40506,"_1890":40507},[],"/docs/platform/pki/quickstarts/create-certificate-authority#review-and-create-the-ca","Review and create the CA",{"_2299":1710,"_22571":1703,"_5":22827,"_15405":40509,"_21315":40510,"_1890":40511},[],"/docs/platform/pki/quickstarts/create-certificate-authority#verify-the-result","Verify the result",{"_2299":1711,"_22571":1703,"_5":22827,"_15405":40513,"_21315":40514,"_1890":35190},[],"/docs/platform/pki/quickstarts/create-certificate-authority#next-step",{"_2299":1712,"_22571":1703,"_15405":40516,"_5":15294,"_21315":1703,"_1890":40517},[],"In this quickstart you will create a root certification authority with a new key pair. When you finish you will have an active CA that you can use in the next quickstart.",{"_2299":1713,"_22571":1703,"_15405":40519,"_5":15294,"_21315":40491,"_1890":40520},[],"Console access with permissions to manage authorities.",{"_2299":1714,"_22571":1703,"_15405":40522,"_5":15294,"_21315":40491,"_1890":40523},[],"At least one cryptographic engine available.",{"_2299":1715,"_22571":1703,"_15405":40525,"_5":15294,"_21315":40491,"_1890":40526},[],"A name that identifies the purpose of the CA, for example `Acme Device Root CA`.",{"_2299":1716,"_22571":1703,"_15405":40528,"_5":15294,"_21315":40491,"_1890":40529},[],"A root CA is self-signed and acts as the anchor of trust. For production it is usually preferable to keep the root more protected and issue from an intermediate CA.",{"_2299":1717,"_22571":1703,"_15405":40531,"_5":15294,"_21315":40494,"_1890":40532},[],"In the side menu, open **Certification Authorities** and select **Create New CA**.",{"_2299":1718,"_22571":1703,"_15405":40534,"_5":15294,"_21315":40494,"_1890":40535},[],"Choose to create a CA with a new key pair. If you already have the key in the KMS, use &#x2A;*Create New CA (Existing Key)**.",{"_2299":1719,"_22571":1703,"_15405":40537,"_5":15294,"_21315":40498,"_1890":40538},[],"Choose the cryptographic engine that will keep the key and configure the algorithm. For a first CA you can use **EC P-384**, as long as it is compatible with your consumers.",{"_2299":1720,"_22571":1703,"_15405":40540,"_5":15294,"_21315":40498,"_1890":40541},[],"The private key will remain under the control of the selected engine.",{"_2299":1721,"_22571":1703,"_15405":40543,"_5":15294,"_21315":40502,"_1890":40544},[],"Select **Root CA** and complete:",{"_2299":1722,"_22571":1703,"_15405":40546,"_5":15294,"_21315":40502,"_1890":40547},[],"**CA Name**: a unique, recognizable name.",{"_2299":1723,"_22571":1703,"_15405":40549,"_5":15294,"_21315":40502,"_1890":40550},[],"**Subject**: at least the organization and country that will identify the authority.",{"_2299":1724,"_22571":1703,"_15405":40552,"_5":15294,"_21315":40502,"_1890":40553},[],"**CA Certificate Expiration**: a validity longer than that of the certificates it will issue.",{"_2299":1725,"_22571":1703,"_15405":40555,"_5":15294,"_21315":40502,"_1890":40556},[],"**Default End-Entity Certificate Issuance Expiration**: the default validity of end-entity certificates.",{"_2299":1726,"_22571":1703,"_15405":40558,"_5":15294,"_21315":40502,"_1890":40559},[],"The CA name will be used as the certificate's `Common Name`.",{"_2299":1727,"_22571":1703,"_15405":40561,"_5":15294,"_21315":40506,"_1890":40562},[],"Check the algorithm, subject and dates before confirming. These values define the anchor of trust and should not be chosen as throwaway test data in a production environment.",{"_2299":1728,"_22571":1703,"_15405":40564,"_5":15294,"_21315":40510,"_1890":40565},[],"Open the new CA from the list. It should appear active and show its PEM certificate, the expiration date and the **Issued Certificates** tab.",{"_2299":1729,"_22571":1703,"_15405":40567,"_5":15294,"_21315":40514,"_1890":40568},[],"Use the authority to issue your first certificate, or see the full authorities guide to create an intermediate CA, import a CA or define advanced profiles.",{"_2299":1730,"_22571":1730,"_5":10616,"_1890":40570,"_22830":40571,"_15405":40572,"_21315":1730},"Issue your first certificate",[35156,36291,40484],[],{"_2299":1731,"_22571":1730,"_15405":40574,"_5":15294,"_21315":1730,"_1890":40575},[],"Issue an X.509 identity from the console and verify the result.",{"_2299":1732,"_22571":1730,"_5":22827,"_15405":40577,"_21315":40578,"_1890":35166},[],"/docs/platform/pki/quickstarts/issue-certificate#before-you-begin",{"_2299":1733,"_22571":1730,"_5":22827,"_15405":40580,"_21315":40581,"_1890":40582},[],"/docs/platform/pki/quickstarts/issue-certificate#start-the-issuance","Start the issuance",{"_2299":1734,"_22571":1730,"_5":22827,"_15405":40584,"_21315":40585,"_1890":40586},[],"/docs/platform/pki/quickstarts/issue-certificate#choose-the-method","Choose the method",{"_2299":1735,"_22571":1730,"_5":22827,"_15405":40588,"_21315":40589,"_1890":40590},[],"/docs/platform/pki/quickstarts/issue-certificate#identify-the-certificate","Identify the certificate",{"_2299":1736,"_22571":1730,"_5":22827,"_15405":40592,"_21315":40593,"_1890":40594},[],"/docs/platform/pki/quickstarts/issue-certificate#configure-key-and-uses","Configure key and uses",{"_2299":1737,"_22571":1730,"_5":22827,"_15405":40596,"_21315":40597,"_1890":40598},[],"/docs/platform/pki/quickstarts/issue-certificate#issue-and-download","Issue and download",{"_2299":1738,"_22571":1730,"_5":22827,"_15405":40600,"_21315":40601,"_1890":40511},[],"/docs/platform/pki/quickstarts/issue-certificate#verify-the-result",{"_2299":1739,"_22571":1730,"_5":22827,"_15405":40603,"_21315":40604,"_1890":35190},[],"/docs/platform/pki/quickstarts/issue-certificate#next-step",{"_2299":1740,"_22571":1730,"_15405":40606,"_5":15294,"_21315":1730,"_1890":40607},[],"In this quickstart Lamassu will generate the key and the CSR in the browser, and the CA will issue the certificate. When you finish you will download the certificate and its private key.",{"_2299":1741,"_22571":1730,"_15405":40609,"_5":15294,"_21315":40578,"_1890":40610},[],"An active CA with permission to issue certificates.",{"_2299":1742,"_22571":1730,"_15405":40612,"_5":15294,"_21315":40578,"_1890":40613},[],"A name for the identity, for example `device-001.example.internal`.",{"_2299":1743,"_22571":1730,"_15405":40615,"_5":15294,"_21315":40578,"_1890":40616},[],"A safe place to keep the downloaded private key.",{"_2299":1744,"_22571":1730,"_15405":40618,"_5":15294,"_21315":40578,"_1890":40619},[],"In this flow the key is generated in the browser and Lamassu does not store it. Download it and protect it before closing the operation result.",{"_2299":1745,"_22571":1730,"_15405":40621,"_5":15294,"_21315":40581,"_1890":40622},[],"Open the CA created in the previous quickstart, go to **Issued Certificates** and select **Issue New**.",{"_2299":1746,"_22571":1730,"_15405":40624,"_5":15294,"_21315":40585,"_1890":40625},[],"Select **Generate Key & CSR in Browser**. Use **Upload Existing CSR** when the private key must be generated and kept on the target system.",{"_2299":1747,"_22571":1730,"_15405":40627,"_5":15294,"_21315":40589,"_1890":40628},[],"Enter the `Common Name` and, if applicable, the organization, organizational unit and location. Add SANs for each DNS name, IP address, email or URI the identity will be validated with.",{"_2299":1748,"_22571":1730,"_15405":40630,"_5":15294,"_21315":40593,"_1890":40631},[],"Choose RSA or ECDSA, define the validity and select the key usages. For a device identity that uses mTLS, enable **Digital Signature** and **Client Authentication**.",{"_2299":1749,"_22571":1730,"_15405":40633,"_5":15294,"_21315":40593,"_1890":40634},[],"The validity cannot exceed the expiration date of the issuing CA.",{"_2299":1750,"_22571":1730,"_15405":40636,"_5":15294,"_21315":40597,"_1890":40637},[],"Confirm the issuance and immediately download the certificate and the private key in PEM format.",{"_2299":1751,"_22571":1730,"_15405":40639,"_5":15294,"_21315":40601,"_1890":40640},[],"The certificate should appear in **Issued Certificates** with an active status. Check its subject, SANs, issuer, usages and validity period.",{"_2299":1752,"_22571":1730,"_15405":40642,"_5":15294,"_21315":40604,"_1890":40643},[],"Register your first device to associate the identity with a managed entity, or see certificate management.",{"_2299":1753,"_22571":1753,"_5":10616,"_1890":40645,"_22830":40646,"_15405":40647,"_21315":1753},"Get started",[35156,36291,40484],[],{"_2299":1754,"_22571":1753,"_15405":40649,"_5":15294,"_21315":1753,"_1890":40650},[],"Get a first result with Lamassu and continue from a working base.",{"_2299":1755,"_22571":1753,"_5":22827,"_15405":40652,"_21315":40653,"_1890":40654},[],"/docs/platform/pki/quickstarts/overview#recommended-path","Recommended path",{"_2299":1756,"_22571":1753,"_5":22827,"_15405":40656,"_21315":40657,"_1890":35166},[],"/docs/platform/pki/quickstarts/overview#before-you-begin",{"_2299":1757,"_22571":1753,"_15405":40659,"_5":15294,"_21315":1753,"_1890":40660},[],"The quickstarts take you from a prepared instance to an active device identity. Each guide produces a verifiable result and links the detailed explanation when you need to go deeper.",{"_2299":1758,"_22571":1753,"_15405":40662,"_5":15294,"_21315":40653,"_1890":40663},[],"<Card title=\"1. Create your first CA\" description=\"Establish a root of trust capable of issuing certificates.\" href=\"/docs/platform/pki/quickstarts/create-certificate-authority\" />",{"_2299":1759,"_22571":1753,"_15405":40665,"_5":15294,"_21315":40653,"_1890":40666},[],"<Card title=\"2. Issue a certificate\" description=\"Create an X.509 identity and verify its contents.\" href=\"/docs/platform/pki/quickstarts/issue-certificate\" />",{"_2299":1760,"_22571":1753,"_15405":40668,"_5":15294,"_21315":40653,"_1890":40669},[],"<Card title=\"3. Register a device\" description=\"Add a device and assign it its first identity.\" href=\"/docs/platform/pki/quickstarts/register-device\" />",{"_2299":1761,"_22571":1753,"_15405":40671,"_5":15294,"_21315":40657,"_1890":40672},[],"You need access to the Lamassu IoT console and permissions to administer keys, authorities and devices. The instance must have at least one cryptographic engine configured.",{"_2299":1762,"_22571":1753,"_15405":40674,"_5":15294,"_21315":40657,"_1890":40675},[],"If you don't have an instance yet, first choose a deployment model.",{"_2299":1763,"_22571":1763,"_5":10616,"_1890":40677,"_22830":40678,"_15405":40679,"_21315":1763},"Register your first device",[35156,36291,40484],[],{"_2299":1764,"_22571":1763,"_15405":40681,"_5":15294,"_21315":1763,"_1890":40682},[],"Add a device to Lamassu and assign it an active identity.",{"_2299":1765,"_22571":1763,"_5":22827,"_15405":40684,"_21315":40685,"_1890":35166},[],"/docs/platform/pki/quickstarts/register-device#before-you-begin",{"_2299":1766,"_22571":1763,"_5":22827,"_15405":40687,"_21315":40688,"_1890":40689},[],"/docs/platform/pki/quickstarts/register-device#register-the-device","Register the device",{"_2299":1767,"_22571":1763,"_5":22827,"_15405":40691,"_21315":40692,"_1890":40693},[],"/docs/platform/pki/quickstarts/register-device#check-the-initial-status","Check the initial status",{"_2299":1768,"_22571":1763,"_5":22827,"_15405":40695,"_21315":40696,"_1890":40697},[],"/docs/platform/pki/quickstarts/register-device#assign-an-identity","Assign an identity",{"_2299":1769,"_22571":1763,"_5":22827,"_15405":40699,"_21315":40700,"_1890":40701},[],"/docs/platform/pki/quickstarts/register-device#verify-the-device","Verify the device",{"_2299":1770,"_22571":1763,"_5":22827,"_15405":40703,"_21315":40704,"_1890":40705},[],"/docs/platform/pki/quickstarts/register-device#automate-the-next-device","Automate the next device",{"_2299":1771,"_22571":1763,"_15405":40707,"_5":15294,"_21315":1763,"_1890":40708},[],"In this quickstart you will manually register a device and assign it its first certificate. It is the shortest path to understanding how Lamassu relates a physical entity to its identity history.",{"_2299":1772,"_22571":1763,"_15405":40710,"_5":15294,"_21315":40685,"_1890":40711},[],"A configured DMS.",{"_2299":1773,"_22571":1763,"_15405":40713,"_5":15294,"_21315":40685,"_1890":40714},[],"A CA associated with the DMS.",{"_2299":1774,"_22571":1763,"_15405":40716,"_5":15294,"_21315":40685,"_1890":40717},[],"A unique identifier for the device.",{"_2299":1775,"_22571":1763,"_15405":40719,"_5":15294,"_21315":40688,"_1890":40720},[],"Open **Managed Devices**, select the action to register a device and complete:",{"_2299":1776,"_22571":1763,"_15405":40722,"_5":15294,"_21315":40688,"_1890":40723},[],"**Device ID**: unique identifier of the device.",{"_2299":1777,"_22571":1763,"_15405":40725,"_5":15294,"_21315":40688,"_1890":40726},[],"**Registration Authority**: the DMS that will apply the enrollment policies.",{"_2299":1778,"_22571":1763,"_15405":40728,"_5":15294,"_21315":40688,"_1890":40729},[],"**Icon** and **Tags**: optional classification to locate it later.",{"_2299":1779,"_22571":1763,"_15405":40731,"_5":15294,"_21315":40692,"_1890":40732},[],"Open the newly created device. It should appear with status **No Identity**: it exists in the inventory but does not yet have an associated certificate.",{"_2299":1780,"_22571":1763,"_15405":40734,"_5":15294,"_21315":40696,"_1890":40735},[],"Select **Assign Identity**. Lamassu will search for active certificates whose `Common Name` matches the `Device ID`.",{"_2299":1781,"_22571":1763,"_15405":40737,"_5":15294,"_21315":40696,"_1890":40738},[],"Select an existing certificate or use **Issue New Instead** to issue one from a CA linked to the DMS.",{"_2299":1782,"_22571":1763,"_15405":40740,"_5":15294,"_21315":40700,"_1890":40741},[],"After confirming, the status should change to **Active**. Review **Certificate History** to check the associated identity and **Device Event Timeline** to see the assignment event.",{"_2299":1783,"_22571":1763,"_15405":40743,"_5":15294,"_21315":40704,"_1890":40744},[],"Manual registration helps you understand the model, but a fleet should use automated enrollment. Continue with Device Management Service and the EST integration.",{"_2299":1784,"_22571":1784,"_5":10616,"_1890":39447,"_22830":40746,"_15405":40747,"_21315":1784},[35156,36291,36292],[],{"_2299":1785,"_22571":1784,"_15405":40749,"_5":15294,"_21315":1784,"_1890":40750},[],"Diagnose access, health, issuance, enrollment and dependencies in a Lamassu deployment.",{"_2299":1786,"_22571":1784,"_5":22827,"_15405":40752,"_21315":40753,"_1890":40754},[],"/docs/platform/pki/troubleshooting#diagnostic-sequence","Diagnostic sequence",{"_2299":1787,"_22571":1784,"_5":22827,"_15405":40756,"_21315":40757,"_1890":40758},[],"/docs/platform/pki/troubleshooting#reproduce-a-single-operation","Reproduce a single operation",{"_2299":1788,"_22571":1784,"_5":22827,"_15405":40760,"_21315":40761,"_1890":40762},[],"/docs/platform/pki/troubleshooting#separate-client-gateway-and-service","Separate client, Gateway and service",{"_2299":1789,"_22571":1784,"_5":22827,"_15405":40764,"_21315":40765,"_1890":40766},[],"/docs/platform/pki/troubleshooting#review-kubernetes-status","Review Kubernetes status",{"_2299":1790,"_22571":1784,"_5":22827,"_15405":40768,"_21315":40769,"_1890":40770},[],"/docs/platform/pki/troubleshooting#query-the-affected-service","Query the affected service",{"_2299":1791,"_22571":1784,"_5":22827,"_15405":40772,"_21315":40773,"_1890":40774},[],"/docs/platform/pki/troubleshooting#validate-the-result-from-outside","Validate the result from outside",{"_2299":1792,"_22571":1784,"_5":22827,"_15405":40776,"_21315":40777,"_1890":40778},[],"/docs/platform/pki/troubleshooting#minimal-evidence-collection","Minimal evidence collection",{"_2299":1793,"_22571":1784,"_5":22827,"_15405":40780,"_21315":40781,"_1890":40782},[],"/docs/platform/pki/troubleshooting#i-cannot-sign-in","I cannot sign in",{"_2299":1794,"_22571":1784,"_5":22827,"_15405":40784,"_21315":40785,"_1890":40786},[],"/docs/platform/pki/troubleshooting#everything-returns-403-or-5xx","Everything returns 403 or 5xx",{"_2299":1795,"_22571":1784,"_5":22827,"_15405":40788,"_21315":40789,"_1890":40790},[],"/docs/platform/pki/troubleshooting#a-pod-is-not-ready","A pod is not Ready",{"_2299":1796,"_22571":1784,"_5":22827,"_15405":40792,"_21315":40793,"_1890":40794},[],"/docs/platform/pki/troubleshooting#issuance-fails","Issuance fails",{"_2299":1797,"_22571":1784,"_5":22827,"_15405":40796,"_21315":40797,"_1890":40798},[],"/docs/platform/pki/troubleshooting#est-enrollment-fails","EST enrollment fails",{"_2299":1798,"_22571":1784,"_5":22827,"_15405":40800,"_21315":40801,"_1890":40802},[],"/docs/platform/pki/troubleshooting#ocsp-or-crl-do-not-reflect-a-change","OCSP or CRL do not reflect a change",{"_2299":1799,"_22571":1784,"_5":22827,"_15405":40804,"_21315":40805,"_1890":40806},[],"/docs/platform/pki/troubleshooting#events-are-not-arriving","Events are not arriving",{"_2299":1800,"_22571":1784,"_5":22827,"_15405":40808,"_21315":40809,"_1890":40810},[],"/docs/platform/pki/troubleshooting#observability","Observability",{"_2299":1801,"_22571":1784,"_15405":40812,"_5":15294,"_21315":1784,"_1890":40813},[],"Start by locating the failing layer. A Gateway response, an unready pod and a rejected issuance can look like the same problem from the console, but they require different evidence.",{"_2299":1802,"_22571":1784,"_15405":40815,"_5":15294,"_21315":40757,"_1890":40816},[],"Note the time in UTC, user or principal, resource, endpoint and result. Avoid repeating a destructive action such as revocation or deletion.",{"_2299":1803,"_22571":1784,"_15405":40818,"_5":15294,"_21315":40761,"_1890":40819},[],"Check the HTTP status. A 401 points to authentication; a 403, to authorization; a 404, to route or resource; a 5xx, to the service or a dependency.",{"_2299":1804,"_22571":1784,"_15405":40821,"_5":15294,"_21315":40765,"_1890":40822},[],"Locate unready pods, restarts, recent events and the state of the release.",{"_2299":1805,"_22571":1784,"_15405":40824,"_5":15294,"_21315":40769,"_1890":40825},[],"Review its /health endpoint and its logs in the same time window. Then follow the indicated dependency: PostgreSQL, RabbitMQ, the OIDC provider or the cryptographic engine.",{"_2299":1806,"_22571":1784,"_15405":40827,"_5":15294,"_21315":40773,"_1890":40828},[],"For PKI, check the certificate, the chain, OCSP or CRL with the same type of client production uses.",{"_2299":1807,"_22571":1784,"_15405":40830,"_5":15294,"_21315":40777,"_1890":40831},[],"Replace the placeholders with your real release, namespace and deployment.",{"_2299":1808,"_22571":1784,"_15405":40833,"_5":15294,"_21315":40777,"_1890":40834},[],"Also run the chart's connectivity test:",{"_2299":1809,"_22571":1784,"_15405":40836,"_5":15294,"_21315":40777,"_1890":40837},[],"The test checks the health of CA, DMS Manager, Device Manager and VA, and verifies that the UI returns HTML. A passing test confirms basic connectivity, not a full issuance flow.",{"_2299":1810,"_22571":1784,"_15405":40839,"_5":15294,"_21315":40777,"_1890":40840},[],"The chart's services expose startup, readiness and liveness probes over /health. A pod can be running but receive no traffic if the readiness probe fails.",{"_2299":1811,"_22571":1784,"_15405":40842,"_5":15294,"_21315":40781,"_1890":40843},[],"If you receive a 401:",{"_2299":1812,"_22571":1784,"_15405":40845,"_5":15294,"_21315":40781,"_1890":40846},[],"check that the UI's OIDC authority is reachable from the browser;",{"_2299":1813,"_22571":1784,"_15405":40848,"_5":15294,"_21315":40781,"_1890":40849},[],"verify issuer, audience and expiration of the token;",{"_2299":1814,"_22571":1784,"_15405":40851,"_5":15294,"_21315":40781,"_1890":40852},[],"confirm the Gateway can fetch the keys from the JWKS URI;",{"_2299":1815,"_22571":1784,"_15405":40854,"_5":15294,"_21315":40781,"_1890":40855},[],"check that the provider's public and internal routes point to the same realm.",{"_2299":1816,"_22571":1784,"_15405":40857,"_5":15294,"_21315":40781,"_1890":40858},[],"If login succeeds but the APIs return 403:",{"_2299":1817,"_22571":1784,"_15405":40860,"_5":15294,"_21315":40781,"_1890":40861},[],"inspect the token's real claims;",{"_2299":1818,"_22571":1784,"_15405":40863,"_5":15294,"_21315":40781,"_1890":40864},[],"confirm they match an active principal;",{"_2299":1819,"_22571":1784,"_15405":40866,"_5":15294,"_21315":40781,"_1890":40867},[],"review the policies granted to that principal;",{"_2299":1820,"_22571":1784,"_15405":40869,"_5":15294,"_21315":40781,"_1890":40870},[],"verify that authz reaches PostgreSQL and its JWKS.",{"_2299":1821,"_22571":1784,"_15405":40872,"_5":15294,"_21315":40781,"_1890":40873},[],"On a fresh installation, confirm the migration Job finished. That Job creates schemas, migrates authz, preloads policies and provisions the principals defined in services.authz.bootstrap.",{"_2299":1822,"_22571":1784,"_15405":40875,"_5":15294,"_21315":40785,"_1890":40876},[],"External authorization fails closed by default. If authz is unavailable, protected routes are blocked.",{"_2299":1823,"_22571":1784,"_15405":40878,"_5":15294,"_21315":40785,"_1890":40879},[],"Locate the authz pod and Service.",{"_2299":1824,"_22571":1784,"_15405":40881,"_5":15294,"_21315":40785,"_1890":40882},[],"Check /health, logs and its database connection.",{"_2299":1825,"_22571":1784,"_15405":40884,"_5":15294,"_21315":40785,"_1890":40885},[],"Verify the DNS and port configured in externalAuthorization.",{"_2299":1826,"_22571":1784,"_15405":40887,"_5":15294,"_21315":40785,"_1890":40888},[],"Check the check route is /v1/ext\\_authz/check.",{"_2299":1827,"_22571":1784,"_15405":40890,"_5":15294,"_21315":40785,"_1890":40891},[],"Do not switch to failOpen: true as a permanent workaround: it would allow traffic without authorization during the outage.",{"_2299":1828,"_22571":1784,"_15405":40893,"_5":15294,"_21315":40789,"_1890":40894},[],"Review kubectl describe pod first. Common causes are:",{"_2299":1829,"_22571":1784,"_15405":40896,"_5":15294,"_21315":40789,"_1890":40897},[],"wrong credentials or DNS for PostgreSQL or RabbitMQ;",{"_2299":1830,"_22571":1784,"_15405":40899,"_5":15294,"_21315":40789,"_1890":40900},[],"unbound persistent volume;",{"_2299":1831,"_22571":1784,"_15405":40902,"_5":15294,"_21315":40789,"_1890":40903},[],"inaccessible image or incorrect pull policy;",{"_2299":1832,"_22571":1784,"_15405":40905,"_5":15294,"_21315":40789,"_1890":40906},[],"invalid cryptographic engine configuration;",{"_2299":1833,"_22571":1784,"_15405":40908,"_5":15294,"_21315":40789,"_1890":40909},[],"CPU or memory limits set too low;",{"_2299":1834,"_22571":1784,"_15405":40911,"_5":15294,"_21315":40789,"_1890":40912},[],"an incomplete prior migration.",{"_2299":1835,"_22571":1784,"_15405":40914,"_5":15294,"_21315":40789,"_1890":40915},[],"Generic values request 100 mCPU and 128 MiB and limit to 500 mCPU and 512 MiB. Tune per service when you see OOMKills, throttling or slow startups.",{"_2299":1836,"_22571":1784,"_15405":40917,"_5":15294,"_21315":40789,"_1890":40918},[],"Filesystem-based KMS engines and VA local storage use exclusive-access volumes. Keep a single replica or migrate to shared backends before enabling autoscaling.",{"_2299":1837,"_22571":1784,"_15405":40920,"_5":15294,"_21315":40793,"_1890":40921},[],"Narrow the error following this order:",{"_2299":1838,"_22571":1784,"_15405":40923,"_5":15294,"_21315":40793,"_1890":40924},[],"The CA exists, is active and has not expired.",{"_2299":1839,"_22571":1784,"_15405":40926,"_5":15294,"_21315":40793,"_1890":40927},[],"The CA has a usable private key and the engine is available.",{"_2299":1840,"_22571":1784,"_15405":40929,"_5":15294,"_21315":40793,"_1890":40930},[],"The CSR has a valid signature.",{"_2299":1841,"_22571":1784,"_15405":40932,"_5":15294,"_21315":40793,"_1890":40933},[],"The profile allows the key type and size.",{"_2299":1842,"_22571":1784,"_15405":40935,"_5":15294,"_21315":40793,"_1890":40936},[],"The requested validity fits within the CA's lifetime.",{"_2299":1843,"_22571":1784,"_15405":40938,"_5":15294,"_21315":40793,"_1890":40939},[],"KU, EKU, subject and extensions comply with the profile.",{"_2299":1844,"_22571":1784,"_15405":40941,"_5":15294,"_21315":40793,"_1890":40942},[],"If the reissuance of a CA fails, remember it is not supported for a revoked or already-expired CA. To change its key, follow CA hierarchy and rotation.",{"_2299":1845,"_22571":1784,"_15405":40944,"_5":15294,"_21315":40797,"_1890":40945},[],"Check:",{"_2299":1846,"_22571":1784,"_15405":40947,"_5":15294,"_21315":40797,"_1890":40948},[],"the DMS identifier in the EST path;",{"_2299":1847,"_22571":1784,"_15405":40950,"_5":15294,"_21315":40797,"_1890":40951},[],"the configured authentication method;",{"_2299":1848,"_22571":1784,"_15405":40953,"_5":15294,"_21315":40797,"_1890":40954},[],"the chain presented by the client;",{"_2299":1849,"_22571":1784,"_15405":40956,"_5":15294,"_21315":40797,"_1890":40957},[],"the validation CAs and the level limit;",{"_2299":1850,"_22571":1784,"_15405":40959,"_5":15294,"_21315":40797,"_1890":40960},[],"the revocation status of the client certificate;",{"_2299":1851,"_22571":1784,"_15405":40962,"_5":15294,"_21315":40797,"_1890":40963},[],"the CSR signature;",{"_2299":1852,"_22571":1784,"_15405":40965,"_5":15294,"_21315":40797,"_1890":40966},[],"the CA and profile used for issuance;",{"_2299":1853,"_22571":1784,"_15405":40968,"_5":15294,"_21315":40797,"_1890":40969},[],"the re-enrollment window.",{"_2299":1854,"_22571":1784,"_15405":40971,"_5":15294,"_21315":40797,"_1890":40972},[],"During re-enrollment, Lamassu first tries to validate with the enrollment CA and then with the additional CAs. During a migration, keep the old CA in that second set until the overlap ends.",{"_2299":1855,"_22571":1784,"_15405":40974,"_5":15294,"_21315":40801,"_1890":40975},[],"Confirm the revocation was persisted and has reason and timestamp.",{"_2299":1856,"_22571":1784,"_15405":40977,"_5":15294,"_21315":40801,"_1890":40978},[],"Review VA configuration and logs.",{"_2299":1857,"_22571":1784,"_15405":40980,"_5":15294,"_21315":40801,"_1890":40981},[],"Check the CRL's periodicity and next update.",{"_2299":1858,"_22571":1784,"_15405":40983,"_5":15294,"_21315":40801,"_1890":40984},[],"Rule out intermediate caches in proxy and client.",{"_2299":1859,"_22571":1784,"_15405":40986,"_5":15294,"_21315":40801,"_1890":40987},[],"Verify the certificate points to the endpoint you are querying.",{"_2299":1860,"_22571":1784,"_15405":40989,"_5":15294,"_21315":40801,"_1890":40990},[],"Query by the correct serial number and issuer.",{"_2299":1861,"_22571":1784,"_15405":40992,"_5":15294,"_21315":40805,"_1890":40993},[],"Domain and audit events depend on the bus publisher:",{"_2299":1862,"_22571":1784,"_15405":40995,"_5":15294,"_21315":40805,"_1890":40996},[],"verify it is enabled in the emitting service;",{"_2299":1863,"_22571":1784,"_15405":40998,"_5":15294,"_21315":40805,"_1890":40999},[],"check AMQP connectivity and credentials;",{"_2299":1864,"_22571":1784,"_15405":41001,"_5":15294,"_21315":40805,"_1890":41002},[],"review exchange, routing key, queues and consumers;",{"_2299":1865,"_22571":1784,"_15405":41004,"_5":15294,"_21315":40805,"_1890":41005},[],"inspect dead-letter queues;",{"_2299":1866,"_22571":1784,"_15405":41007,"_5":15294,"_21315":40805,"_1890":41008},[],"alert on orphan durable queues and backlog growth.",{"_2299":1867,"_22571":1784,"_15405":41010,"_5":15294,"_21315":40805,"_1890":41011},[],"A consumer outage does not always prevent the main operation from completing. That is why you must monitor RabbitMQ and independently verify the persistence of audit logs.",{"_2299":1868,"_22571":1784,"_15405":41013,"_5":15294,"_21315":40809,"_1890":41014},[],"The chart can enable OpenTelemetry instrumentation. Traces are exported over OTLP HTTP and logs can be directed to a compatible endpoint, such as VictoriaLogs. Use a correlation identifier and the same time window to join Gateway, authz, service and dependency.",{"_2299":1869,"_22571":1784,"_15405":41016,"_5":15294,"_21315":40809,"_1890":41017},[],"Before closing an incident, record:",{"_2299":1870,"_22571":1784,"_15405":41019,"_5":15294,"_21315":40809,"_1890":41020},[],"the confirmed cause;",{"_2299":1871,"_22571":1784,"_15405":41022,"_5":15294,"_21315":40809,"_1890":41023},[],"the time scope and affected resources;",{"_2299":1872,"_22571":1784,"_15405":41025,"_5":15294,"_21315":40809,"_1890":41026},[],"the commands or queries used;",{"_2299":1873,"_22571":1784,"_15405":41028,"_5":15294,"_21315":40809,"_1890":41029},[],"the applied change and how to revert it;",{"_2299":1874,"_22571":1784,"_15405":41031,"_5":15294,"_21315":40809,"_1890":41032},[],"validation from a consumer;",{"_2299":1875,"_22571":1784,"_15405":41034,"_5":15294,"_21315":40809,"_1890":41035},[],"the preventive action and its owner.",{"_2299":1876,"_22571":1876,"_5":10616,"_1890":41037,"_15405":41038,"_21315":1876},"Test",[],{"_2299":1877,"_22571":1876,"_15405":41040,"_5":15294,"_21315":1876,"_1890":41041},[],"A document to test Fumadocs",{"_2299":1878,"_22571":1876,"_5":22827,"_15405":41043,"_21315":41044,"_1890":41045},[],"/docs/test#cards","Cards",{"_2299":1879,"_22571":1876,"_5":22827,"_15405":41047,"_21315":41048,"_1890":41049},[],"/docs/test#codeblock","Code