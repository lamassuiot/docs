:15,"_30605":15,"_5":14934,"_3006":49961,"_30943":49962,"_21201":49966,"_27821":15},"Deploy from AWS Marketplace",[49963,49964,49965],"Docs","Deployment","Other models",[],{"_3550":16,"_30605":15,"_21201":49968,"_5":14582,"_27821":15,"_3006":49969},[],"Run a preconfigured Lamassu IoT instance on Amazon EC2.",{"_3550":17,"_30605":15,"_5":30940,"_21201":49971,"_27821":49972,"_3006":49973},[],"/docs/deployment/aws-marketplace#before-you-begin","Before you begin",{"_3550":18,"_30605":15,"_5":30940,"_21201":49975,"_27821":49976,"_3006":49977},[],"/docs/deployment/aws-marketplace#infrastructure-requirements","Infrastructure requirements",{"_3550":19,"_30605":15,"_5":30940,"_21201":49979,"_27821":49980,"_3006":49981},[],"/docs/deployment/aws-marketplace#open-the-offer","Open the offer",{"_3550":20,"_30605":15,"_5":30940,"_21201":49983,"_27821":49984,"_3006":49985},[],"/docs/deployment/aws-marketplace#configure-the-instance","Configure the instance",{"_3550":21,"_30605":15,"_5":30940,"_21201":49987,"_27821":49988,"_3006":49989},[],"/docs/deployment/aws-marketplace#limit-network-access","Limit network access",{"_3550":22,"_30605":15,"_5":30940,"_21201":49991,"_27821":49992,"_3006":49993},[],"/docs/deployment/aws-marketplace#launch-and-verify","Launch and verify",{"_3550":23,"_30605":15,"_5":30940,"_21201":49995,"_27821":49996,"_3006":49997},[],"/docs/deployment/aws-marketplace#next-step","Next step",{"_3550":24,"_30605":15,"_21201":49999,"_5":14582,"_27821":15,"_3006":50000},[],"The AWS Marketplace offering reduces initial setup to an EC2 instance inside your account. You keep control of the network, storage and operation of the machine.",{"_3550":25,"_30605":15,"_21201":50002,"_5":14582,"_27821":49972,"_3006":50003},[],"Permissions to subscribe to AWS Marketplace products and launch EC2 instances.",{"_3550":26,"_30605":15,"_21201":50005,"_5":14582,"_27821":49972,"_3006":50006},[],"A VPC and a subnet from which administrators and devices can reach the instance.",{"_3550":27,"_30605":15,"_21201":50008,"_5":14582,"_27821":49972,"_3006":50009},[],"A security group allowing the necessary endpoints.",{"_3550":28,"_30605":15,"_21201":50011,"_5":14582,"_27821":49976,"_3006":50012},[],"**Compute:** a `t3.large` instance at minimum. Use `t3.xlarge` or higher when the load requires it.",{"_3550":29,"_30605":15,"_21201":50014,"_5":14582,"_27821":49976,"_3006":50015},[],"**Storage:** an EBS `gp3` volume of at least 50 GB, sized to your inventory and retention needs.",{"_3550":30,"_30605":15,"_21201":50017,"_5":14582,"_27821":49976,"_3006":50018},[],"**Network:** HTTPS access from the necessary consumers, restricted to trusted networks.",{"_3550":31,"_30605":15,"_21201":50020,"_5":14582,"_27821":49980,"_3006":50021},[],"Go to Lamassu IoT on AWS Marketplace and review the terms before subscribing.",{"_3550":32,"_30605":15,"_21201":50023,"_5":14582,"_27821":49984,"_3006":50024},[],"Select `t3.large` or higher, assign at least 50 GB of `gp3` storage and choose the target VPC and subnet.",{"_3550":33,"_30605":15,"_21201":50026,"_5":14582,"_27821":49988,"_3006":50027},[],"Configure the security group for ports `443`, `8443` and `9443`. Restrict the origins to the administrative and device networks that really need to connect.",{"_3550":34,"_30605":15,"_21201":50029,"_5":14582,"_27821":49992,"_3006":50030},[],"Start the instance and open the console at `https://<public-ip>`. Check you can authenticate before continuing.",{"_3550":35,"_30605":15,"_21201":50032,"_5":14582,"_27821":49996,"_3006":50033},[],"Continue with Create your first CA to validate the instance's cryptographic configuration.",{"_3550":36,"_30605":36,"_5":14934,"_3006":50035,"_30943":50036,"_21201":50037,"_27821":36},"Deploy Lamassu",[49963,49964],[],{"_3550":37,"_30605":36,"_21201":50039,"_5":14582,"_27821":36,"_3006":50040},[],"Choose the operating model that fits your infrastructure and control requirements.",{"_3550":38,"_30605":36,"_5":30940,"_21201":50042,"_27821":50043,"_3006":50044},[],"/docs/deployment/overview#choose-a-model","Choose a model",{"_3550":39,"_30605":36,"_5":30940,"_21201":50046,"_27821":50047,"_3006":50048},[],"/docs/deployment/overview#just-want-to-evaluate-the-platform","Just want to evaluate the platform?",{"_3550":40,"_30605":36,"_5":30940,"_21201":50050,"_27821":50051,"_3006":50052},[],"/docs/deployment/overview#after-deployment","After deployment",{"_3550":41,"_30605":36,"_21201":50054,"_5":14582,"_27821":36,"_3006":50055},[],"You can run Lamassu on your own Kubernetes cluster, deploy a prebuilt image from AWS Marketplace or consume the platform as a managed service.",{"_3550":42,"_30605":36,"_21201":50057,"_5":14582,"_27821":50043,"_3006":50058},[],"Model",{"_3550":43,"_30605":36,"_21201":50060,"_5":14582,"_27821":50043,"_3006":50061},[],"Recommended for",{"_3550":44,"_30605":36,"_21201":50063,"_5":14582,"_27821":50043,"_3006":50064},[],"Who operates the infrastructure",{"_3550":45,"_30605":36,"_21201":50066,"_5":14582,"_27821":50043,"_3006":50067},[],"Starting point",{"_3550":46,"_30605":36,"_21201":50069,"_5":14582,"_27821":50043,"_3006":50070},[],"Kubernetes self-managed",{"_3550":47,"_30605":36,"_21201":50072,"_5":14582,"_27821":50043,"_3006":50073},[],"Production, regulated environments and custom deployments",{"_3550":48,"_30605":36,"_21201":50075,"_5":14582,"_27821":50043,"_3006":50076},[],"Your team",{"_3550":49,"_30605":36,"_21201":50078,"_5":14582,"_27821":50043,"_3006":50079},[],"Helm or Fastlane",{"_3550":50,"_30605":36,"_21201":50081,"_5":14582,"_27821":50043,"_3006":50082},[],"AWS Marketplace",{"_3550":51,"_30605":36,"_21201":50084,"_5":14582,"_27821":50043,"_3006":50085},[],"Evaluation or a dedicated deployment inside an AWS account",{"_3550":52,"_30605":36,"_21201":50087,"_5":14582,"_27821":50043,"_3006":50076},[],{"_3550":53,"_30605":36,"_21201":50089,"_5":14582,"_27821":50043,"_3006":50090},[],"Preconfigured image on EC2",{"_3550":54,"_30605":36,"_21201":50092,"_5":14582,"_27821":50043,"_3006":50093},[],"SaaS",{"_3550":55,"_30605":36,"_21201":50095,"_5":14582,"_27821":50043,"_3006":50096},[],"Teams that want to use the platform without operating it",{"_3550":56,"_30605":36,"_21201":50098,"_5":14582,"_27821":50043,"_3006":50099},[],"Lamassu",{"_3550":57,"_30605":36,"_21201":50101,"_5":14582,"_27821":50043,"_3006":50102},[],"Managed subscription",{"_3550":58,"_30605":36,"_21201":50104,"_5":14582,"_27821":50043,"_3006":50105},[],"<Card title=\"Kubernetes self-managed\" description=\"Control network, storage, keys, dependencies and the upgrade cycle.\" href=\"/docs/deployment/self-hosted/overview\" />",{"_3550":59,"_30605":36,"_21201":50107,"_5":14582,"_27821":50043,"_3006":50108},[],"<Card title=\"AWS Marketplace\" description=\"Launch a preconfigured Lamassu instance on AWS EC2.\" href=\"/docs/deployment/aws-marketplace\" />",{"_3550":60,"_30605":36,"_21201":50110,"_5":14582,"_27821":50043,"_3006":50111},[],"<Card title=\"Lamassu SaaS\" description=\"Use an operated and updated instance as a managed service.\" href=\"/docs/deployment/saas\" />",{"_3550":61,"_30605":36,"_21201":50113,"_5":14582,"_27821":50047,"_3006":50114},[],"Use Fastlane to bring up PostgreSQL, Keycloak, RabbitMQ and Lamassu on a Kubernetes cluster through a single flow. It is intended for labs, demos and bootstrap; for production, configure dependencies and Helm values explicitly.",{"_3550":62,"_30605":36,"_21201":50116,"_5":14582,"_27821":50051,"_3006":50117},[],"Once the console is available, continue with Create your first CA. That quickstart verifies the cryptographic engine and issuance work correctly.",{"_3550":63,"_30605":63,"_5":14934,"_3006":50119,"_30943":50120,"_21201":50121,"_27821":63},"Use Lamassu as SaaS",[49963,49964,49965],[],{"_3550":64,"_30605":63,"_21201":50123,"_5":14582,"_27821":63,"_3006":50124},[],"Consume Lamassu as a managed service without operating your own infrastructure.",{"_3550":65,"_30605":63,"_5":30940,"_21201":50126,"_27821":50127,"_3006":50128},[],"/docs/deployment/saas#what-the-service-manages","What the service manages",{"_3550":66,"_30605":63,"_5":30940,"_21201":50130,"_27821":50131,"_3006":50132},[],"/docs/deployment/saas#plans","Plans",{"_3550":67,"_30605":63,"_5":30940,"_21201":50134,"_27821":50135,"_3006":50136},[],"/docs/deployment/saas#request-access","Request access",{"_3550":68,"_30605":63,"_21201":50138,"_5":14582,"_27821":63,"_3006":50139},[],"Lamassu SaaS offers the platform's capabilities in a managed environment. It is the right option when your team wants to focus on PKI and device identities, not on maintaining the infrastructure that supports them.",{"_3550":69,"_30605":63,"_21201":50141,"_5":14582,"_27821":50127,"_3006":50142},[],"Platform availability and maintenance.",{"_3550":70,"_30605":63,"_21201":50144,"_5":14582,"_27821":50127,"_3006":50145},[],"Automatic backups.",{"_3550":71,"_30605":63,"_21201":50147,"_5":14582,"_27821":50127,"_3006":50148},[],"Version upgrades.",{"_3550":72,"_30605":63,"_21201":50150,"_5":14582,"_27821":50127,"_3006":50151},[],"Technical support and SLA according to your plan.",{"_3550":73,"_30605":63,"_21201":50153,"_5":14582,"_27821":50131,"_3006":50154},[],"Plan",{"_3550":74,"_30605":63,"_21201":50156,"_5":14582,"_27821":50131,"_3006":50157},[],"Devices",{"_3550":75,"_30605":63,"_21201":50159,"_5":14582,"_27821":50131,"_3006":50160},[],"Support",{"_3550":76,"_30605":63,"_21201":50162,"_5":14582,"_27821":50131,"_3006":50163},[],"SLA",{"_3550":77,"_30605":63,"_21201":50165,"_5":14582,"_27821":50131,"_3006":50166},[],"Starter",{"_3550":78,"_30605":63,"_21201":50168,"_5":14582,"_27821":50131,"_3006":50169},[],"Up to 1,000",{"_3550":79,"_30605":63,"_21201":50171,"_5":14582,"_27821":50131,"_3006":50172},[],"Email",{"_3550":80,"_30605":63,"_21201":50174,"_5":14582,"_27821":50131,"_3006":50175},[],"99.5 %",{"_3550":81,"_30605":63,"_21201":50177,"_5":14582,"_27821":50131,"_3006":50178},[],"Professional",{"_3550":82,"_30605":63,"_21201":50180,"_5":14582,"_27821":50131,"_3006":50181},[],"Up to 10,000",{"_3550":83,"_30605":63,"_21201":50183,"_5":14582,"_27821":50131,"_3006":50184},[],"Email and chat",{"_3550":84,"_30605":63,"_21201":50186,"_5":14582,"_27821":50131,"_3006":50187},[],"99.9 %",{"_3550":85,"_30605":63,"_21201":50189,"_5":14582,"_27821":50131,"_3006":50190},[],"Enterprise",{"_3550":86,"_30605":63,"_21201":50192,"_5":14582,"_27821":50131,"_3006":50193},[],"Unlimited",{"_3550":87,"_30605":63,"_21201":50195,"_5":14582,"_27821":50131,"_3006":50196},[],"Dedicated",{"_3550":88,"_30605":63,"_21201":50198,"_5":14582,"_27821":50131,"_3006":50199},[],"99.99 %",{"_3550":89,"_30605":63,"_21201":50201,"_5":14582,"_27821":50135,"_3006":50202},[],"Contact the Lamassu team through lamassu.io to request a demo or choose a plan.",{"_3550":90,"_30605":63,"_21201":50204,"_5":14582,"_27821":50135,"_3006":50205},[],"When you receive your instance's credentials, continue with Get started.",{"_3550":91,"_30605":91,"_5":14934,"_3006":50207,"_30943":50208,"_21201":50209,"_27821":91},"Fastlane",[49963,49964,50070],[],{"_3550":92,"_30605":91,"_21201":50211,"_5":14582,"_27821":91,"_3006":50212},[],"Bootstrap a complete Lamassu evaluation or lab environment on an existing Kubernetes cluster.",{"_3550":93,"_30605":91,"_5":30940,"_21201":50214,"_27821":50215,"_3006":50216},[],"/docs/deployment/self-hosted/fastlane#deploy-with-fastlane","Deploy with Fastlane",{"_3550":94,"_30605":91,"_5":30940,"_21201":50218,"_27821":50219,"_3006":50220},[],"/docs/deployment/self-hosted/fastlane#what-fastlane-adds","What Fastlane adds",{"_3550":95,"_30605":91,"_5":30940,"_21201":50222,"_27821":50223,"_3006":49973},[],"/docs/deployment/self-hosted/fastlane#before-you-begin",{"_3550":96,"_30605":91,"_5":30940,"_21201":50225,"_27821":50226,"_3006":50227},[],"/docs/deployment/self-hosted/fastlane#quick-start","Quick start",{"_3550":97,"_30605":91,"_5":30940,"_21201":50229,"_27821":50230,"_3006":50231},[],"/docs/deployment/self-hosted/fastlane#gateway-address-selection","Gateway address selection",{"_3550":98,"_30605":91,"_5":30940,"_21201":50233,"_27821":50234,"_3006":50235},[],"/docs/deployment/self-hosted/fastlane#command-line-options","Command-line options",{"_3550":99,"_30605":91,"_5":30940,"_21201":50237,"_27821":50238,"_3006":50239},[],"/docs/deployment/self-hosted/fastlane#development-mode","Development mode",{"_3550":100,"_30605":91,"_5":30940,"_21201":50241,"_27821":50242,"_3006":50243},[],"/docs/deployment/self-hosted/fastlane#what-the-script-configures","What the script configures",{"_3550":101,"_30605":91,"_5":30940,"_21201":50245,"_27821":50246,"_3006":50247},[],"/docs/deployment/self-hosted/fastlane#tls-behavior","TLS behavior",{"_3550":102,"_30605":91,"_5":30940,"_21201":50249,"_27821":50250,"_3006":50251},[],"/docs/deployment/self-hosted/fastlane#credentials-and-generated-files","Credentials and generated files",{"_3550":103,"_30605":91,"_5":30940,"_21201":50253,"_27821":50254,"_3006":50255},[],"/docs/deployment/self-hosted/fastlane#verify-the-installation","Verify the installation",{"_3550":104,"_30605":91,"_21201":50257,"_5":14582,"_27821":50215,"_3006":50258},[],"Fastlane is the automated path for evaluations, demos, CI and small lab clusters. It installs PostgreSQL, Keycloak, RabbitMQ, Envoy Gateway and Lamassu, then configures them to work together.",{"_3550":105,"_30605":91,"_21201":50260,"_5":14582,"_27821":50215,"_3006":50261},[],"For production, use Helm so database, identity, credentials, certificates, storage and upgrades remain explicit.",{"_3550":106,"_30605":91,"_21201":50263,"_5":14582,"_27821":50219,"_3006":50264},[],"Fastlane closes some of the gaps intentionally left by the application chart:",{"_3550":107,"_30605":91,"_21201":50266,"_5":14582,"_27821":50219,"_3006":50267},[],"Fastlane installs or configures",{"_3550":108,"_30605":91,"_21201":50269,"_5":14582,"_27821":50219,"_3006":50270},[],"You still provide",{"_3550":109,"_30605":91,"_21201":50272,"_5":14582,"_27821":50219,"_3006":50273},[],"PostgreSQL, RabbitMQ and Keycloak instances for evaluation",{"_3550":110,"_30605":91,"_21201":50275,"_5":14582,"_27821":50219,"_3006":50276},[],"The Kubernetes cluster, nodes and persistent storage",{"_3550":111,"_30605":91,"_21201":50278,"_5":14582,"_27821":50219,"_3006":50279},[],"Envoy Gateway 1.8 and the `eg` `GatewayClass`",{"_3550":112,"_30605":91,"_21201":50281,"_5":14582,"_27821":50219,"_3006":50282},[],"cert-manager, external network reachability, DNS and firewall/NAT rules",{"_3550":113,"_30605":91,"_21201":50284,"_5":14582,"_27821":50219,"_3006":50285},[],"A self-signed Lamassu certificate flow, generated dependency credentials and an initial user",{"_3550":114,"_30605":91,"_21201":50287,"_5":14582,"_27821":50219,"_3006":50288},[],"Client trust for the self-signed CA, or a trusted certificate passed to the script",{"_3550":115,"_30605":91,"_21201":50290,"_5":14582,"_27821":50219,"_3006":50291},[],"Optional observability and lab HSM components",{"_3550":116,"_30605":91,"_21201":50293,"_5":14582,"_27821":50219,"_3006":50294},[],"Production monitoring retention, backups, HA and a production HSM/key service",{"_3550":117,"_30605":91,"_21201":50296,"_5":14582,"_27821":50219,"_3006":50297},[],"Fastlane does not turn the resulting stack into a production service: it does not create the cluster, public DNS, firewall rules, backups, high availability or a trusted public certificate.",{"_3550":118,"_30605":91,"_21201":50299,"_5":14582,"_27821":50223,"_3006":50300},[],"You need:",{"_3550":119,"_30605":91,"_21201":50302,"_5":14582,"_27821":50223,"_3006":50303},[],"an existing Kubernetes cluster",{"_3550":120,"_30605":91,"_21201":50305,"_5":14582,"_27821":50223,"_3006":50306},[],"`kubectl` and Helm, or the MicroK8s CLI",{"_3550":121,"_30605":91,"_21201":50308,"_5":14582,"_27821":50223,"_3006":50309},[],"`yq`",{"_3550":122,"_30605":91,"_21201":50311,"_5":14582,"_27821":50223,"_3006":23959},[],{"_3550":123,"_30605":91,"_21201":50313,"_5":14582,"_27821":50223,"_3006":50314},[],"`jq` only when using `--sample-data` or `--development`",{"_3550":124,"_30605":91,"_21201":50316,"_5":14582,"_27821":50223,"_3006":50317},[],"`ssh-keygen` only when using `--with-hsm`",{"_3550":125,"_30605":91,"_21201":50319,"_5":14582,"_27821":50223,"_3006":50320},[],"free external ports 80 and 443 on a single-node K3s host",{"_3550":126,"_30605":91,"_21201":50322,"_5":14582,"_27821":50223,"_3006":50323},[],"Fastlane detects MicroK8s, K3s, kind or a standard kubeconfig. Use `--context` when the intended cluster is not the current context.",{"_3550":127,"_30605":91,"_21201":50325,"_5":14582,"_27821":50223,"_3006":50326},[],"Fastlane installs several components and creates credentials. Check `kubectl config current-context` or pass `--context` before running it.",{"_3550":128,"_30605":91,"_21201":50328,"_5":14582,"_27821":50226,"_3006":50329},[],"Run the script from a clone of the Helm repository:",{"_3550":129,"_30605":91,"_21201":50331,"_5":14582,"_27821":50226,"_3006":50332},[],"Create a DNS record for the chosen domain before testing from another machine. For a small VM, point it at the VM or load-balancer address that actually receives ports 80 and 443.",{"_3550":130,"_30605":91,"_21201":50334,"_5":14582,"_27821":50230,"_3006":50335},[],"By default, Fastlane runs `hostname -I` and writes the returned addresses to `gateway.addresses` and to the self-signed certificate's IP SANs.",{"_3550":131,"_30605":91,"_21201":50337,"_5":14582,"_27821":50230,"_3006":50338},[],"On a single-homed lab VM this can select the expected node address. On hosts with Docker, VPN, WireGuard or several interfaces it can also select addresses clients cannot reach. Override the result explicitly:",{"_3550":132,"_30605":91,"_21201":50340,"_5":14582,"_27821":50230,"_3006":50341},[],"The value must be an address handled on the Kubernetes side of the traffic path. If a public EC2 address forwards through WireGuard to the cluster, pass the reachable cluster/VM address, not the EC2 public address.",{"_3550":133,"_30605":91,"_21201":50343,"_5":14582,"_27821":50230,"_3006":50344},[],"See Expose the Gateway for K3s port conflicts, VIPs, external NAT and multi-Gateway designs.",{"_3550":134,"_30605":91,"_21201":50346,"_5":14582,"_27821":50234,"_3006":50347},[],"Option",{"_3550":135,"_30605":91,"_21201":50349,"_5":14582,"_27821":50234,"_3006":50350},[],"Default",{"_3550":136,"_30605":91,"_21201":50352,"_5":14582,"_27821":50234,"_3006":50353},[],"Purpose",{"_3550":137,"_30605":91,"_21201":50355,"_5":14582,"_27821":50234,"_3006":50356},[],"`-h`, `--help`",{"_3550":138,"_30605":91,"_21201":50358,"_5":14582,"_27821":50234,"_3006":50359},[],"—",{"_3550":139,"_30605":91,"_21201":50361,"_5":14582,"_27821":50234,"_3006":50362},[],"Show help",{"_3550":140,"_30605":91,"_21201":50364,"_5":14582,"_27821":50234,"_3006":50365},[],"`-c`, `--context`",{"_3550":141,"_30605":91,"_21201":50367,"_5":14582,"_27821":50234,"_3006":50368},[],"current context",{"_3550":142,"_30605":91,"_21201":50370,"_5":14582,"_27821":50234,"_3006":50371},[],"Select the kubeconfig context for kubectl and Helm",{"_3550":143,"_30605":91,"_21201":50373,"_5":14582,"_27821":50234,"_3006":50374},[],"`-n`, `--non-interactive`",{"_3550":144,"_30605":91,"_21201":50376,"_5":14582,"_27821":50234,"_3006":6671},[],{"_3550":145,"_30605":91,"_21201":50378,"_5":14582,"_27821":50234,"_3006":50379},[],"Skip prompts and generate dependency credentials",{"_3550":146,"_30605":91,"_21201":50381,"_5":14582,"_27821":50234,"_3006":50382},[],"`-ns`, `--namespace`",{"_3550":147,"_30605":91,"_21201":50384,"_5":14582,"_27821":50234,"_3006":50385},[],"`lamassu-dev`",{"_3550":148,"_30605":91,"_21201":50387,"_5":14582,"_27821":50234,"_3006":50388},[],"Namespace for the installation",{"_3550":149,"_30605":91,"_21201":50390,"_5":14582,"_27821":50234,"_3006":50391},[],"`-d`, `--domain`",{"_3550":150,"_30605":91,"_21201":50393,"_5":14582,"_27821":50234,"_3006":50394},[],"`dev.lamassu.io`",{"_3550":151,"_30605":91,"_21201":50396,"_5":14582,"_27821":50234,"_3006":50397},[],"Domain used by the UI, OIDC and certificate",{"_3550":152,"_30605":91,"_21201":50399,"_5":14582,"_27821":50234,"_3006":50400},[],"`-v`, `--version`",{"_3550":153,"_30605":91,"_21201":50402,"_5":14582,"_27821":50234,"_3006":15274},[],{"_3550":154,"_30605":91,"_21201":50404,"_5":14582,"_27821":50234,"_3006":50405},[],"Lamassu chart version",{"_3550":155,"_30605":91,"_21201":50407,"_5":14582,"_27821":50234,"_3006":50408},[],"`--https-port`",{"_3550":156,"_30605":91,"_21201":50410,"_5":14582,"_27821":50234,"_3006":50411},[],"`443`",{"_3550":157,"_30605":91,"_21201":50413,"_5":14582,"_27821":50234,"_3006":50414},[],"Gateway HTTPS listener port",{"_3550":158,"_30605":91,"_21201":50416,"_5":14582,"_27821":50234,"_3006":50417},[],"`--http-port`",{"_3550":159,"_30605":91,"_21201":50419,"_5":14582,"_27821":50234,"_3006":50420},[],"`80`",{"_3550":160,"_30605":91,"_21201":50422,"_5":14582,"_27821":50234,"_3006":50423},[],"Gateway HTTP listener port",{"_3550":161,"_30605":91,"_21201":50425,"_5":14582,"_27821":50234,"_3006":50426},[],"`--tls-crt`",{"_3550":162,"_30605":91,"_21201":50428,"_5":14582,"_27821":50234,"_3006":50359},[],{"_3550":163,"_30605":91,"_21201":50430,"_5":14582,"_27821":50234,"_3006":50431},[],"PEM certificate for downstream TLS",{"_3550":164,"_30605":91,"_21201":50433,"_5":14582,"_27821":50234,"_3006":50434},[],"`--tls-key`",{"_3550":165,"_30605":91,"_21201":50436,"_5":14582,"_27821":50234,"_3006":50359},[],{"_3550":166,"_30605":91,"_21201":50438,"_5":14582,"_27821":50234,"_3006":50439},[],"PEM private key for downstream TLS",{"_3550":167,"_30605":91,"_21201":50441,"_5":14582,"_27821":50234,"_3006":50442},[],"`-l`, `--local-chart-path`",{"_3550":168,"_30605":91,"_21201":50444,"_5":14582,"_27821":50234,"_3006":50445},[],"repository chart",{"_3550":169,"_30605":91,"_21201":50447,"_5":14582,"_27821":50234,"_3006":50448},[],"Use an unpacked local Lamassu chart",{"_3550":170,"_30605":91,"_21201":50450,"_5":14582,"_27821":50234,"_3006":50451},[],"`-ip`, `--gateway-ip`",{"_3550":171,"_30605":91,"_21201":50453,"_5":14582,"_27821":50234,"_3006":8904},[],{"_3550":172,"_30605":91,"_21201":50455,"_5":14582,"_27821":50234,"_3006":50456},[],"Override the address written to `gateway.addresses`",{"_3550":173,"_30605":91,"_21201":50458,"_5":14582,"_27821":50234,"_3006":50459},[],"`--otel`",{"_3550":174,"_30605":91,"_21201":50461,"_5":14582,"_27821":50234,"_3006":6671},[],{"_3550":175,"_30605":91,"_21201":50463,"_5":14582,"_27821":50234,"_3006":50464},[],"Install Victoria Logs, VictoriaTraces, Jaeger and an OpenTelemetry Collector",{"_3550":176,"_30605":91,"_21201":50466,"_5":14582,"_27821":50234,"_3006":50467},[],"`--development`",{"_3550":177,"_30605":91,"_21201":50469,"_5":14582,"_27821":50234,"_3006":6671},[],{"_3550":178,"_30605":91,"_21201":50471,"_5":14582,"_27821":50234,"_3006":50472},[],"Development mode: fully provisions the Keycloak `lamassu` user (fixed `lamassu`/`lamassu` password, no first-login steps) and lets the `frontend` client accept any redirect URI or web origin. Not for production",{"_3550":179,"_30605":91,"_21201":50474,"_5":14582,"_27821":50234,"_3006":50475},[],"`--sample-data`",{"_3550":180,"_30605":91,"_21201":50477,"_5":14582,"_27821":50234,"_3006":6671},[],{"_3550":181,"_30605":91,"_21201":50479,"_5":14582,"_27821":50234,"_3006":50480},[],"Create sample CAs, profiles, certificates, DMS data and devices",{"_3550":182,"_30605":91,"_21201":50482,"_5":14582,"_27821":50234,"_3006":50483},[],"`--with-hsm`",{"_3550":183,"_30605":91,"_21201":50485,"_5":14582,"_27821":50234,"_3006":6671},[],{"_3550":184,"_30605":91,"_21201":50487,"_5":14582,"_27821":50234,"_3006":50488},[],"Install lab HSM components and configure KMS for PKCS#11",{"_3550":185,"_30605":91,"_21201":50490,"_5":14582,"_27821":50234,"_3006":50491},[],"`--softhsm-chart-path`",{"_3550":186,"_30605":91,"_21201":50493,"_5":14582,"_27821":50234,"_3006":50494},[],"`./charts/softhsm`",{"_3550":187,"_30605":91,"_21201":50496,"_5":14582,"_27821":50234,"_3006":50497},[],"Use a different local SoftHSM chart",{"_3550":188,"_30605":91,"_21201":50499,"_5":14582,"_27821":50234,"_3006":50500},[],"Fastlane does not provide an offline mode. Use the manual Helm workflow and a prepared registry/chart mirror for disconnected environments.",{"_3550":189,"_30605":91,"_21201":50502,"_5":14582,"_27821":50238,"_3006":50503},[],"`--development` adjusts the Keycloak `lamassu` realm generated by Fastlane for a disposable evaluation environment:",{"_3550":190,"_30605":91,"_21201":50505,"_5":14582,"_27821":50238,"_3006":50506},[],"the `lamassu` user is fully provisioned (first name Lamassu, last name Admin, email `lamassu@lamassu.io`, verified): there are no profile setup or password change steps on first login",{"_3550":191,"_30605":91,"_21201":50508,"_5":14582,"_27821":50238,"_3006":50509},[],"the well-known `lamassu`/`lamassu` password is fixed and permanent: it is never rotated and grants the `pki-admin` role, including non-interactive tokens through the `frontend` client",{"_3550":192,"_30605":91,"_21201":50511,"_5":14582,"_27821":50238,"_3006":50512},[],"the `frontend` client accepts any redirect URI and any web origin (`*`) instead of the original `/*` patterns",{"_3550":193,"_30605":91,"_21201":50514,"_5":14582,"_27821":50238,"_3006":50515},[],"With `--development`, the fixed `lamassu`/`lamassu` password grants `pki-admin` access to anyone who can reach the installation. Never use it on anything exposed beyond a development machine or a network-reachable host.",{"_3550":194,"_30605":91,"_21201":50517,"_5":14582,"_27821":50238,"_3006":50518},[],"`--development` applies when the `lamassu` realm is first imported. It does not modify an existing cluster. It can be combined with `--sample-data`: the development transform runs first, then sample data is added to the same realm configuration.",{"_3550":195,"_30605":91,"_21201":50520,"_5":14582,"_27821":50242,"_3006":50521},[],"Fastlane:",{"_3550":196,"_30605":91,"_21201":50523,"_5":14582,"_27821":50242,"_3006":50524},[],"validates local tools and the selected cluster",{"_3550":197,"_30605":91,"_21201":50526,"_5":14582,"_27821":50242,"_3006":50527},[],"installs or upgrades Envoy Gateway 1.8 and creates the `eg` `GatewayClass`",{"_3550":198,"_30605":91,"_21201":50529,"_5":14582,"_27821":50242,"_3006":50530},[],"creates the namespace",{"_3550":199,"_30605":91,"_21201":50532,"_5":14582,"_27821":50242,"_3006":50533},[],"installs PostgreSQL and creates the required databases",{"_3550":200,"_30605":91,"_21201":50535,"_5":14582,"_27821":50242,"_3006":50536},[],"installs Keycloak and creates the `lamassu` realm, frontend client, admin role and initial user",{"_3550":201,"_30605":91,"_21201":50538,"_5":14582,"_27821":50242,"_3006":50539},[],"installs RabbitMQ",{"_3550":202,"_30605":91,"_21201":50541,"_5":14582,"_27821":50242,"_3006":50542},[],"optionally installs observability and lab HSM components",{"_3550":203,"_30605":91,"_21201":50544,"_5":14582,"_27821":50242,"_3006":50545},[],"generates `lamassu.yaml` and installs the Lamassu chart",{"_3550":204,"_30605":91,"_21201":50547,"_5":14582,"_27821":50242,"_3006":50548},[],"optionally loads sample data",{"_3550":205,"_30605":91,"_21201":50550,"_5":14582,"_27821":50242,"_3006":50551},[],"The generated configuration exposes Keycloak at `/auth` through the same Gateway and bootstraps the initial `lamassu` user as a Lamassu super administrator.",{"_3550":206,"_30605":91,"_21201":50553,"_5":14582,"_27821":50246,"_3006":50554},[],"With both `--tls-crt` and `--tls-key`, Fastlane creates the `downstream-provided-crt` Secret and configures `tls.type: external`.",{"_3550":207,"_30605":91,"_21201":50556,"_5":14582,"_27821":50246,"_3006":50557},[],"Without them, it configures cert-manager with a self-signed issuer. This is suitable for a lab but will not be trusted by clients until you distribute the CA. Use Helm when you need a corporate Issuer, public ACME issuer or an existing Secret managed by another system.",{"_3550":208,"_30605":91,"_21201":50559,"_5":14582,"_27821":50250,"_3006":50560},[],"Non-interactive mode generates random PostgreSQL, RabbitMQ and Keycloak administrator passwords. The initial Lamassu login is `lamassu` / `lamassu` and requires a password change on first use, unless `--development` was used: in that case the password stays fixed and permanent.",{"_3550":209,"_30605":91,"_21201":50562,"_5":14582,"_27821":50250,"_3006":50563},[],"Fastlane writes `lamassu.yaml` in the current directory and injects credentials into it.",{"_3550":210,"_30605":91,"_21201":50565,"_5":14582,"_27821":50250,"_3006":50566},[],"Protect the generated values file, record the generated credentials in an appropriate secret store and do not reuse the evaluation identity setup in production.",{"_3550":211,"_30605":91,"_21201":50568,"_5":14582,"_27821":50254,"_3006":50569},[],"Then open `https://pki.example.com` and sign in with the initial user. If the Gateway is programmed but the URL is unreachable, follow the checks in Expose the Gateway.",{"_3550":212,"_30605":212,"_5":14934,"_3006":50571,"_30943":50572,"_21201":50573,"_27821":212},"Install with Helm",[49963,49964,50070],[],{"_3550":213,"_30605":212,"_21201":50575,"_5":14582,"_27821":212,"_3006":50576},[],"Prepare dependencies, configure the Lamassu chart and verify a controlled Kubernetes deployment.",{"_3550":214,"_30605":212,"_5":30940,"_21201":50578,"_27821":50579,"_3006":50580},[],"/docs/deployment/self-hosted/helm#install-lamassu-with-helm","Install Lamassu with Helm",{"_3550":215,"_30605":212,"_5":30940,"_21201":50582,"_27821":50583,"_3006":49973},[],"/docs/deployment/self-hosted/helm#before-you-begin",{"_3550":216,"_30605":212,"_5":30940,"_21201":50585,"_27821":50586,"_3006":50587},[],"/docs/deployment/self-hosted/helm#1-install-the-gateway-prerequisites","1\\. Install the Gateway prerequisites",{"_3550":217,"_30605":212,"_5":30940,"_21201":50589,"_27821":50590,"_3006":50591},[],"/docs/deployment/self-hosted/helm#2-create-a-values-file","2\\. Create a values file",{"_3550":218,"_30605":212,"_5":30940,"_21201":50593,"_27821":50594,"_3006":50595},[],"/docs/deployment/self-hosted/helm#tls-with-an-existing-secret","TLS with an existing Secret",{"_3550":219,"_30605":212,"_5":30940,"_21201":50597,"_27821":50598,"_3006":50599},[],"/docs/deployment/self-hosted/helm#amqp-tls-amqps","AMQP TLS (AMQPS)",{"_3550":220,"_30605":212,"_5":30940,"_21201":50601,"_27821":50602,"_3006":50603},[],"/docs/deployment/self-hosted/helm#provision-the-first-administrator","Provision the first administrator",{"_3550":221,"_30605":212,"_5":30940,"_21201":50605,"_27821":50606,"_3006":50607},[],"/docs/deployment/self-hosted/helm#3-install-lamassu","3\\. Install Lamassu",{"_3550":222,"_30605":212,"_5":30940,"_21201":50609,"_27821":50610,"_3006":50611},[],"/docs/deployment/self-hosted/helm#4-verify-the-deployment","4\\. Verify the deployment",{"_3550":223,"_30605":212,"_5":30940,"_21201":50613,"_27821":50614,"_3006":50615},[],"/docs/deployment/self-hosted/helm#upgrading-lamassu","Upgrading Lamassu",{"_3550":224,"_30605":212,"_5":30940,"_21201":50617,"_27821":50618,"_3006":50619},[],"/docs/deployment/self-hosted/helm#production-decisions","Production decisions",{"_3550":225,"_30605":212,"_21201":50621,"_5":14582,"_27821":50579,"_3006":50622},[],"Use the Helm workflow when you need explicit control over identity, databases, messaging, certificates, storage and upgrades. For an evaluation environment where the script can make those choices for you, use Fastlane.",{"_3550":226,"_30605":212,"_21201":50624,"_5":14582,"_27821":50583,"_3006":50625},[],"Prepare the platform services that are deliberately outside the Lamassu chart:",{"_3550":227,"_30605":212,"_21201":50627,"_5":14582,"_27821":50583,"_3006":50628},[],"a Kubernetes 1.24+ cluster and Helm 3.2+",{"_3550":228,"_30605":212,"_21201":50630,"_5":14582,"_27821":50583,"_3006":50631},[],"a reachable PostgreSQL server and a role allowed to create databases and schemas",{"_3550":229,"_30605":212,"_21201":50633,"_5":14582,"_27821":50583,"_3006":50634},[],"a reachable RabbitMQ broker and credentials",{"_3550":230,"_30605":212,"_21201":50636,"_5":14582,"_27821":50583,"_3006":50637},[],"an OIDC provider, normally Keycloak, with a realm/tenant and client for Lamassu",{"_3550":231,"_30605":212,"_21201":50639,"_5":14582,"_27821":50583,"_3006":50640},[],"Envoy Gateway 1.8+ and a `GatewayClass`",{"_3550":232,"_30605":212,"_21201":50642,"_5":14582,"_27821":50583,"_3006":50643},[],"cert-manager 1.14+ (only for the default `tls.type: certManager` mode); for trusted TLS, either a trusted issuer or a Kubernetes TLS Secret",{"_3550":233,"_30605":212,"_21201":50645,"_5":14582,"_27821":50583,"_3006":50646},[],"a StorageClass and an external traffic design",{"_3550":234,"_30605":212,"_21201":50648,"_5":14582,"_27821":50583,"_3006":50649},[],"The chart defaults to a `GatewayClass` named `eg`. Change `gateway.className` if your platform team uses another name.",{"_3550":235,"_30605":212,"_21201":50651,"_5":14582,"_27821":50583,"_3006":50652},[],"You provide the PostgreSQL server. The chart's pre-install job connects with the supplied credentials, creates the required `pki`, `authz` and `wfx` databases and service schemas, runs migrations, and applies `services.authz.bootstrap`.",{"_3550":236,"_30605":212,"_21201":50654,"_5":14582,"_27821":50583,"_3006":50655},[],"The chart has no Helm dependencies that install PostgreSQL, RabbitMQ, an OIDC provider, Envoy Gateway or cert-manager.",{"_3550":237,"_30605":212,"_21201":50657,"_5":14582,"_27821":50586,"_3006":50658},[],"Install or upgrade the Envoy Gateway CRDs before its controller. The commands below match the version used by the Lamassu Helm repository:",{"_3550":238,"_30605":212,"_21201":50660,"_5":14582,"_27821":50586,"_3006":50661},[],"Create the default `GatewayClass` if it does not already exist. Save this manifest as `gateway-class.yaml`:",{"_3550":239,"_30605":212,"_21201":50663,"_5":14582,"_27821":50586,"_3006":50664},[],"Install cert-manager separately before Lamassu, but only for the default `tls.type: certManager` mode. In that mode the chart renders its self-signed Issuer and CA Certificate resources regardless of whether `tls.certManagerOptions.clusterIssuer` is set, so cert-manager stays a prerequisite. With `tls.type: external`, the chart renders no cert-manager resources and the Gateway terminates TLS with an existing Secret you provide instead.",{"_3550":240,"_30605":212,"_21201":50666,"_5":14582,"_27821":50590,"_3006":50667},[],"Start with the chart defaults and override the environment-specific values. This example assumes PostgreSQL, RabbitMQ and Keycloak are reachable through Kubernetes DNS, and exposes Keycloak at `/auth` through the shared Lamassu Gateway:",{"_3550":241,"_30605":212,"_21201":50669,"_5":14582,"_27821":50590,"_3006":50670},[],"Do not add `gateway.addresses` by default. Leave address assignment to the load-balancer implementation unless your network design requires a specific Kubernetes-side VIP. The public IP of an upstream NAT gateway or reverse proxy does not belong in this value.",{"_3550":242,"_30605":212,"_21201":50672,"_5":14582,"_27821":50590,"_3006":50673},[],"If Keycloak is external and already has its own reachable URL, point the OIDC settings at it and omit the `/auth` entry from `gateway.extraRouting`.",{"_3550":243,"_30605":212,"_21201":50675,"_5":14582,"_27821":50590,"_3006":50676},[],"If your values file still carries the legacy gateway JWT validation settings — `auth.oidc.apiGateway.jwks`, `auth.authorization.rolesClaim` or `auth.authorization.roles.admin` — remove them. The migration guide `charts/lamassu/CHANGELOG/3.8.0->4.0.0.md` documents their removal with no compatibility aliases, and `values.schema.json` rejects the leftover blocks instead of silently ignoring them. The replacements are `services.authz.jwkUrl` and `services.authz.bootstrap`, already shown in the example above.",{"_3550":244,"_30605":212,"_21201":50678,"_5":14582,"_27821":50594,"_3006":50679},[],"Create a Secret containing `tls.crt` and `tls.key`, then reference it. The Secret must already exist before installing: in `external` mode the chart renders no cert-manager resources and never creates this Secret.",{"_3550":245,"_30605":212,"_21201":50681,"_5":14582,"_27821":50598,"_3006":50682},[],"`amqp.tls: true` selects AMQPS in every event-bus configuration block. The default port stays `5672` and does not change automatically when TLS is enabled, so set `amqp.port` to the broker's TLS listener, commonly `5671`.",{"_3550":246,"_30605":212,"_21201":50684,"_5":14582,"_27821":50598,"_3006":50685},[],"With no CA Secret configured, the event-bus clients use the system-trusted CAs. To trust a private CA, create a Secret in the release namespace containing the CA certificate in PEM format and set `amqp.ca.secretName` (and `amqp.ca.certificateKey` if the data key is not `ca.crt`).",{"_3550":247,"_30605":212,"_21201":50687,"_5":14582,"_27821":50598,"_3006":50688},[],"For brokers that require mutual TLS, create a Secret containing the client certificate and private key and set `amqp.client.secretName` (with `amqp.client.certificateKey` and `amqp.client.privateKeyKey` if the data keys are not `tls.crt` and `tls.key`).",{"_3550":248,"_30605":212,"_21201":50690,"_5":14582,"_27821":50598,"_3006":50691},[],"The chart mounts configured Secrets read-only into every AMQP-consuming workload: the CA certificate under `/etc/lamassu/amqp/ca` and the client certificate and key under `/etc/lamassu/amqp/client`. The mounted file names are always `ca.crt`, `tls.crt` and `tls.key` — the `certificateKey` and `privateKeyKey` values rename only the Secret data keys, never the on-disk paths. The client private key is mounted with restrictive permissions (`defaultMode: 0440`; the CA volume uses `0444`), which works because the chart adds `fsGroup` to the pod security context when `amqp.client.secretName` is set — it uses the container `runAsGroup` (default `65532`) when `fsGroup` is not already set.",{"_3550":249,"_30605":212,"_21201":50693,"_5":14582,"_27821":50598,"_3006":50694},[],"Both Secret options require `amqp.tls: true`: `values.schema.json` rejects a non-empty `secretName` when `tls` is false, rejects unknown keys and rejects data-key names outside `^[A-Za-z0-9._-]+$`. The referenced Secret must exist in the release namespace or the consuming pods fail to start.",{"_3550":250,"_30605":212,"_21201":50696,"_5":14582,"_27821":50598,"_3006":50697},[],"The AMQP client loads certificates at startup, so restart the consuming pods after updating either Secret. Changing any `amqp` value rolls the consuming pods through the `checksum/config` annotation, but a change to Secret content alone does not trigger a rollout.",{"_3550":251,"_30605":212,"_21201":50699,"_5":14582,"_27821":50598,"_3006":50700},[],"Per the migration guide `charts/lamassu/CHANGELOG/3.8.0->4.0.0.md`: in 3.8.0 `amqp.tls` was not applied and event-bus clients used plaintext AMQP; from 4.0.0, `amqp.tls: true` switches them to AMQPS. Set `amqp.port` to the broker TLS listener before upgrading, or set `amqp.tls: false` to keep plaintext AMQP. `amqp.tls: false` sends the broker credentials and all event-bus traffic in cleartext.",{"_3550":252,"_30605":212,"_21201":50702,"_5":14582,"_27821":50602,"_3006":50703},[],"There is no implicit superuser. Create the role or group expected by `services.authz.bootstrap` in the OIDC provider and assign it to at least one administrator before exposing Lamassu.",{"_3550":253,"_30605":212,"_21201":50705,"_5":14582,"_27821":50602,"_3006":50706},[],"The pre-install and pre-upgrade job applies the bootstrap idempotently: existing principals are preserved and missing grants are added.",{"_3550":254,"_30605":212,"_21201":50708,"_5":14582,"_27821":50602,"_3006":50709},[],"Test both an authorized identity and a denied identity. If no token matches an active bootstrap principal, nobody can administer the PKI.",{"_3550":255,"_30605":212,"_21201":50711,"_5":14582,"_27821":50602,"_3006":50712},[],"See Access control for the principal and policy model.",{"_3550":256,"_30605":212,"_21201":50714,"_5":14582,"_27821":50606,"_3006":50715},[],"To install a local checkout instead:",{"_3550":257,"_30605":212,"_21201":50717,"_5":14582,"_27821":50610,"_3006":50718},[],"The Gateway should report `PROGRAMMED=True`. If it is programmed but has no usable address, continue with Expose the Gateway.",{"_3550":258,"_30605":212,"_21201":50720,"_5":14582,"_27821":50610,"_3006":50721},[],"The Helm test checks the CA, DMS Manager, Device Manager and VA health endpoints and verifies the UI response.",{"_3550":259,"_30605":212,"_21201":50723,"_5":14582,"_27821":50614,"_3006":50724},[],"Version-specific upgrade steps live in `charts/lamassu/CHANGELOG/` in the Helm repository. The chart also ships an optional pre-upgrade Job that migrates existing CA private keys into the KMS engine configured for the release. It is off by default (`migrations.caToKms.enabled: false`) and is only needed when upgrading from a version prior to 3.7.0.",{"_3550":260,"_30605":212,"_21201":50726,"_5":14582,"_27821":50614,"_3006":50727},[],"While the flag is enabled, every `helm upgrade` creates the `<chart fullname>-ca-to-kms-migration` Job (`lamassu-ca-to-kms-migration` for release `lamassu`); a fresh install does not create it. Its hook weight is `-10`, so it runs before the other pre-upgrade hooks: the authorization bootstrap configuration (weight `-4`) and the database-migration Job (weight `-3`).",{"_3550":261,"_30605":212,"_21201":50729,"_5":14582,"_27821":50614,"_3006":50730},[],"The Job consumes the same KMS service configuration the chart renders into the KMS ConfigMap, including the engines from `services.kms.cryptoEngines`, and runs the migration tool defined in `migrations.caToKms.image`. It mounts that configuration read-only at `/etc/lamassuiot/config.yml` from the ConfigMap key `config`, so configure the destination engine in your values before the upgrade that performs the migration.",{"_3550":262,"_30605":212,"_21201":50732,"_5":14582,"_27821":50614,"_3006":50733},[],"The Job resolves its configuration through a projected volume with two optional sources: the release-scoped `<chart fullname>-kms-config` (`lamassu-kms-config` for release `lamassu`, `prod-lamassu-kms-config` for release `prod`) and the legacy unscoped `kms-config` created by chart versions before release-scoped naming. The legacy configuration remains authoritative while it is still present, and the release-scoped one is used once the legacy one is gone. Both sources are optional, so a missing ConfigMap never leaves the upgrade pod in `ContainerCreating`.",{"_3550":263,"_30605":212,"_21201":50735,"_5":14582,"_27821":50614,"_3006":50736},[],"Keep `migrations.caToKms.enabled: true` for the upgrade that performs the migration, then remove the flag from your values once the migration completes; it defaults to `false`.",{"_3550":264,"_30605":212,"_21201":50738,"_5":14582,"_27821":50618,"_3006":50739},[],"Before going live, review:",{"_3550":265,"_30605":212,"_21201":50741,"_5":14582,"_27821":50618,"_3006":50742},[],"backup and recovery for PostgreSQL and persistent volumes",{"_3550":266,"_30605":212,"_21201":50744,"_5":14582,"_27821":50618,"_3006":50745},[],"a production KMS engine; the default filesystem engine is not an HA design",{"_3550":267,"_30605":212,"_21201":50747,"_5":14582,"_27821":50618,"_3006":50748},[],"shared VA storage before increasing VA replicas",{"_3550":268,"_30605":212,"_21201":50750,"_5":14582,"_27821":50618,"_3006":50751},[],"managed OIDC roles and removal of evaluation credentials",{"_3550":269,"_30605":212,"_21201":50753,"_5":14582,"_27821":50618,"_3006":50754},[],"a trusted TLS issuer or externally managed certificate",{"_3550":270,"_30605":212,"_21201":50756,"_5":14582,"_27821":50618,"_3006":50757},[],"resource requests, replicas, autoscaling, disruption budgets and placement",{"_3550":271,"_30605":212,"_21201":50759,"_5":14582,"_27821":50618,"_3006":50760},[],"SMTP, observability and alert delivery",{"_3550":272,"_30605":212,"_21201":50762,"_5":14582,"_27821":50618,"_3006":50763},[],"the version upgrade guides and migration notes in `charts/lamassu/CHANGELOG/` before every upgrade, including the optional CA-to-KMS migration hook described above",{"_3550":273,"_30605":212,"_21201":50765,"_5":14582,"_27821":50618,"_3006":50766},[],"The complete values reference is maintained in `charts/lamassu/VALUES.md` in the Helm repository.",{"_3550":274,"_30605":274,"_5":14934,"_3006":50768,"_30943":50769,"_21201":50770,"_27821":274},"Expose the Gateway",[49963,49964,50070],[],{"_3550":275,"_30605":274,"_21201":50772,"_5":14582,"_27821":274,"_3006":50773},[],"Choose how clients reach Lamassu, when to set gateway.addresses and how to design multiple Gateways.",{"_3550":276,"_30605":274,"_5":30940,"_21201":50775,"_27821":50776,"_3006":50777},[],"/docs/deployment/self-hosted/networking#expose-the-lamassu-gateway","Expose the Lamassu Gateway",{"_3550":277,"_30605":274,"_5":30940,"_21201":50779,"_27821":50780,"_3006":50781},[],"/docs/deployment/self-hosted/networking#do-you-need-gatewayaddresses","Do you need `gateway.addresses`?",{"_3550":278,"_30605":274,"_5":30940,"_21201":50783,"_27821":50784,"_3006":50785},[],"/docs/deployment/self-hosted/networking#recommended-single-node-design","Recommended single-node design",{"_3550":279,"_30605":274,"_5":30940,"_21201":50787,"_27821":50788,"_3006":50789},[],"/docs/deployment/self-hosted/networking#k3s","K3s",{"_3550":280,"_30605":274,"_5":30940,"_21201":50791,"_27821":50792,"_3006":50793},[],"/docs/deployment/self-hosted/networking#bare-metal-with-metallb-or-kube-vip","Bare metal with MetalLB or kube-vip",{"_3550":281,"_30605":274,"_5":30940,"_21201":50795,"_27821":50796,"_3006":50797},[],"/docs/deployment/self-hosted/networking#external-reverse-proxy-nat-or-vpn","External reverse proxy, NAT or VPN",{"_3550":282,"_30605":274,"_5":30940,"_21201":50799,"_27821":50800,"_3006":50801},[],"/docs/deployment/self-hosted/networking#what-if-you-need-three-gateways","What if you need three Gateways?",{"_3550":283,"_30605":274,"_5":30940,"_21201":50803,"_27821":50804,"_3006":50805},[],"/docs/deployment/self-hosted/networking#client-certificates-and-identity-headers","Client certificates and identity headers",{"_3550":284,"_30605":274,"_5":30940,"_21201":50807,"_27821":50808,"_3006":50809},[],"/docs/deployment/self-hosted/networking#decision-guide","Decision guide",{"_3550":285,"_30605":274,"_5":30940,"_21201":50811,"_27821":50812,"_3006":50813},[],"/docs/deployment/self-hosted/networking#egress-proxy","Egress proxy",{"_3550":286,"_30605":274,"_5":30940,"_21201":50815,"_27821":50816,"_3006":50817},[],"/docs/deployment/self-hosted/networking#verify-the-traffic-path","Verify the traffic path",{"_3550":287,"_30605":274,"_21201":50819,"_5":14582,"_27821":50776,"_3006":50820},[],"The Lamassu chart creates one shared Gateway with HTTP and HTTPS listeners. Envoy Gateway normally creates a dedicated proxy deployment and a `LoadBalancer` Service for it.",{"_3550":288,"_30605":274,"_21201":50822,"_5":14582,"_27821":50776,"_3006":50823},[],"External reachability is the result of the whole path. A `Gateway` resource alone does not configure your router, firewall, DNS, cloud load balancer or upstream NAT.",{"_3550":289,"_30605":274,"_21201":50825,"_5":14582,"_27821":50780,"_3006":50826},[],"Usually, no. If you omit it, the Gateway controller and the cluster load-balancer implementation can assign an address and report it in `Gateway.status.addresses` and the generated Service status.",{"_3550":290,"_30605":274,"_21201":50828,"_5":14582,"_27821":50780,"_3006":50829},[],"Set it only when:",{"_3550":291,"_30605":274,"_21201":50831,"_5":14582,"_27821":50780,"_3006":50832},[],"your cloud or bare-metal load balancer supports requesting a specific address",{"_3550":292,"_30605":274,"_21201":50834,"_5":14582,"_27821":50780,"_3006":50835},[],"that address is allocated to this Gateway",{"_3550":293,"_30605":274,"_21201":50837,"_5":14582,"_27821":50780,"_3006":50838},[],"the surrounding network already routes traffic for it to the cluster",{"_3550":294,"_30605":274,"_21201":50840,"_5":14582,"_27821":50780,"_3006":50841},[],"This requests `192.168.1.50`; it does not claim the IP on your LAN or make it reachable.",{"_3550":295,"_30605":274,"_21201":50843,"_5":14582,"_27821":50780,"_3006":50844},[],"Keep these two settings separate:",{"_3550":296,"_30605":274,"_21201":50846,"_5":14582,"_27821":50780,"_3006":50847},[],"`gateway.addresses` requests an address for the Gateway.",{"_3550":297,"_30605":274,"_21201":50849,"_5":14582,"_27821":50780,"_3006":50850},[],"`tls.certManagerOptions.certSpec.addresses` adds IP subject alternative names to the TLS certificate.",{"_3550":298,"_30605":274,"_21201":50852,"_5":14582,"_27821":50780,"_3006":50853},[],"If users connect by DNS name, put that name in `tls.certManagerOptions.certSpec.hostnames`. Do not copy an upstream proxy's public IP into `gateway.addresses`.",{"_3550":299,"_30605":274,"_21201":50855,"_5":14582,"_27821":50784,"_3006":50856},[],"For a small VM running K3s or MicroK8s, use one external Lamassu Gateway and route every Lamassu endpoint through it:",{"_3550":300,"_30605":274,"_21201":50858,"_5":14582,"_27821":50784,"_3006":50859},[],"This design uses one IP, one TLS entry point and one pair of ports. The chart already creates the required routes.",{"_3550":301,"_30605":274,"_21201":50861,"_5":14582,"_27821":50788,"_3006":50862},[],"K3s ServiceLB implements each `LoadBalancer` Service with pods that reserve the Service ports on the node. On a single node, only one Service can therefore own port 80 and one can own port 443. The default K3s Traefik Service may already hold both ports.",{"_3550":302,"_30605":274,"_21201":50864,"_5":14582,"_27821":50788,"_3006":50865},[],"For the recommended design:",{"_3550":303,"_30605":274,"_21201":50867,"_5":14582,"_27821":50788,"_3006":50868},[],"Use only one externally exposed Lamassu Gateway.",{"_3550":304,"_30605":274,"_21201":50870,"_5":14582,"_27821":50788,"_3006":50871},[],"Ensure ports 80 and 443 are free. Disable or reconfigure Traefik if it is not part of your traffic path.",{"_3550":305,"_30605":274,"_21201":50873,"_5":14582,"_27821":50788,"_3006":50874},[],"Allow those ports through the VM firewall and any upstream security group.",{"_3550":306,"_30605":274,"_21201":50876,"_5":14582,"_27821":50788,"_3006":50877},[],"Point DNS at the VM's reachable address.",{"_3550":307,"_30605":274,"_21201":50879,"_5":14582,"_27821":50788,"_3006":50880},[],"See the K3s ServiceLB documentation for its host-port behavior and how to replace it with another load-balancer implementation.",{"_3550":308,"_30605":274,"_21201":50882,"_5":14582,"_27821":50792,"_3006":50883},[],"Allocate a VIP from an address pool reachable on your LAN. You may request that VIP with `gateway.addresses` if the selected implementation supports it. Confirm the assigned address in status rather than assuming the request succeeded.",{"_3550":309,"_30605":274,"_21201":50885,"_5":14582,"_27821":50796,"_3006":50886},[],"An external public address can forward TCP 80 and 443 to the VM or to a Kubernetes-side VIP:",{"_3550":310,"_30605":274,"_21201":50888,"_5":14582,"_27821":50796,"_3006":50889},[],"The public IP belongs to the external device. Leave `gateway.addresses` unset or set it to the actual Kubernetes-side address, never to an address that the cluster cannot bind.",{"_3550":311,"_30605":274,"_21201":50891,"_5":14582,"_27821":50800,"_3006":50892},[],"First decide whether you need three independent data planes or only three hostnames.",{"_3550":312,"_30605":274,"_21201":50894,"_5":14582,"_27821":50800,"_3006":50895},[],"Requirement",{"_3550":313,"_30605":274,"_21201":50897,"_5":14582,"_27821":50800,"_3006":50898},[],"Recommended design",{"_3550":314,"_30605":274,"_21201":50900,"_5":14582,"_27821":50800,"_3006":50901},[],"Consequence",{"_3550":315,"_30605":274,"_21201":50903,"_5":14582,"_27821":50800,"_3006":50904},[],"Several Lamassu URLs or services",{"_3550":316,"_30605":274,"_21201":50906,"_5":14582,"_27821":50800,"_3006":50907},[],"One Gateway with multiple routes",{"_3550":317,"_30605":274,"_21201":50909,"_5":14582,"_27821":50800,"_3006":50910},[],"One IP and one proxy fleet; this is the chart default",{"_3550":318,"_30605":274,"_21201":50912,"_5":14582,"_27821":50800,"_3006":50913},[],"Independent Gateways and separate external IPs",{"_3550":319,"_30605":274,"_21201":50915,"_5":14582,"_27821":50800,"_3006":50916},[],"One VIP per Gateway",{"_3550":320,"_30605":274,"_21201":50918,"_5":14582,"_27821":50800,"_3006":50919},[],"All Gateways can use 80/443; requires a load balancer with an address pool",{"_3550":321,"_30605":274,"_21201":50921,"_5":14582,"_27821":50800,"_3006":50922},[],"Independent Gateways on one node and one IP",{"_3550":322,"_30605":274,"_21201":50924,"_5":14582,"_27821":50800,"_3006":50925},[],"Use different external ports",{"_3550":323,"_30605":274,"_21201":50927,"_5":14582,"_27821":50800,"_3006":50928},[],"Clients must include non-standard ports",{"_3550":324,"_30605":274,"_21201":50930,"_5":14582,"_27821":50800,"_3006":50931},[],"Separate TLS/mTLS termination behind one IP",{"_3550":325,"_30605":274,"_21201":50933,"_5":14582,"_27821":50800,"_3006":50934},[],"Front-door SNI routing to internal Gateways",{"_3550":326,"_30605":274,"_21201":50936,"_5":14582,"_27821":50800,"_3006":50937},[],"Advanced design; the front door uses TLS passthrough and each internal Gateway terminates its own TLS",{"_3550":327,"_30605":274,"_21201":50939,"_5":14582,"_27821":50800,"_3006":50940},[],"Separate Gateway resources but shared proxy infrastructure",{"_3550":328,"_30605":274,"_21201":50942,"_5":14582,"_27821":50800,"_3006":50943},[],"Envoy merged-Gateway mode",{"_3550":329,"_30605":274,"_21201":50945,"_5":14582,"_27821":50800,"_3006":50946},[],"Logical separation only; listeners must have unique port, protocol and hostname tuples",{"_3550":330,"_30605":274,"_21201":50948,"_5":14582,"_27821":50800,"_3006":50949},[],"Three independent `LoadBalancer` Services cannot all reserve the same node ports 80 and 443 through K3s ServiceLB. Use one shared Gateway, allocate distinct VIPs with another load-balancer implementation, or use different ports.",{"_3550":331,"_30605":274,"_21201":50951,"_5":14582,"_27821":50800,"_3006":50952},[],"Envoy Gateway normally provisions a proxy fleet per `Gateway`. Its merged-Gateway mode can share one fleet and address, but it is not a drop-in switch for multiple Lamassu releases: the generated Lamassu listeners use the same ports and protocols without distinct hostnames, so they conflict unless you deliberately customize the listener design.",{"_3550":332,"_30605":274,"_21201":50954,"_5":14582,"_27821":50800,"_3006":50955},[],"Use a front-door SNI design only when the internal Gateways must retain independent TLS or mTLS policy:",{"_3550":333,"_30605":274,"_21201":50957,"_5":14582,"_27821":50800,"_3006":50958},[],"This requires distinct SNI hostnames and cluster networking outside the Lamassu chart.",{"_3550":334,"_30605":274,"_21201":50960,"_5":14582,"_27821":50804,"_3006":50961},[],"The chart renders a `ClientTrafficPolicy` named `enable-mtls` on its shared Gateway automatically; no Helm value enables or disables it. TLS termination accepts requests with or without a client certificate: devices may present one, but they are not required to. Before forwarding a request, the Gateway removes identity and certificate headers that a client could otherwise supply itself: `X-Principal-Id`, `X-Lms-Source`, `X-Forwarded-Client-Cert`, `X-Forwarded-Cert`, `X-Forwarded-Tls-Client-Cert` (the Traefik spelling), `Ssl-Client-Cert` and `X-Amzn-Mtls-Clientcert`. The Traefik spelling is included because backends that accept `X-Forwarded-Tls-Client-Cert` directly would otherwise receive certificate identity data supplied by the client itself, without a client certificate having been presented. After stripping, Envoy adds its own `X-Forwarded-Client-Cert` carrying the presented certificate and its chain, so services that read certificate identity receive only gateway-generated values. No Helm value changes the list of stripped headers. The Access control page describes how `authz` uses this protection to keep `X-Principal-ID` out of reach of clients.",{"_3550":335,"_30605":274,"_21201":50963,"_5":14582,"_27821":50808,"_3006":50964},[],"If one Gateway can own TLS and routing, use the chart default.",{"_3550":336,"_30605":274,"_21201":50966,"_5":14582,"_27821":50808,"_3006":50967},[],"If Gateways need independent policy and you can allocate IPs, use one VIP per Gateway.",{"_3550":337,"_30605":274,"_21201":50969,"_5":14582,"_27821":50808,"_3006":50970},[],"If only the Kubernetes resources need separation, evaluate merged-Gateway mode and make every listener tuple unique.",{"_3550":338,"_30605":274,"_21201":50972,"_5":14582,"_27821":50808,"_3006":50973},[],"If data planes and TLS termination must stay independent behind one IP, add a front-door SNI passthrough layer.",{"_3550":339,"_30605":274,"_21201":50975,"_5":14582,"_27821":50808,"_3006":50976},[],"If none of those are possible, use different external ports or change the external network design.",{"_3550":340,"_30605":274,"_21201":50978,"_5":14582,"_27821":50812,"_3006":50979},[],"Internal Lamassu clients — the Vault engine connection, service-to-service calls and webhook deliveries — honor the `HTTP_PROXY`, `HTTPS_PROXY` and `NO_PROXY` environment variables. The exception is the authorization-engine connector: it uses its own transport and does not consult these proxy variables. If your deployment routes egress through a proxy, list in-cluster service names in `NO_PROXY` (for example `.svc,.cluster.local`) so internal traffic stays inside the cluster. Loopback traffic is never sent through a proxy.",{"_3550":341,"_30605":274,"_21201":50981,"_5":14582,"_27821":50812,"_3006":50982},[],"The default transport of these clients bounds the dial timeout (30 seconds), the TLS handshake (10 seconds) and idle connection reuse (90 seconds) so an unreachable dependency fails fast instead of hanging; these values are Go transport defaults, not Lamassu settings. HTTP/2 is negotiated when the peer supports it. The authorization-engine connector keeps its own transport without these dial and handshake timeouts; only its overall 30-second request timeout bounds each call.",{"_3550":342,"_30605":274,"_21201":50984,"_5":14582,"_27821":50816,"_3006":50985},[],"Check, in order:",{"_3550":343,"_30605":274,"_21201":50987,"_5":14582,"_27821":50816,"_3006":50988},[],"`Gateway` has `Accepted=True` and `Programmed=True`.",{"_3550":344,"_30605":274,"_21201":50990,"_5":14582,"_27821":50816,"_3006":50991},[],"Its status contains the expected address.",{"_3550":345,"_30605":274,"_21201":50993,"_5":14582,"_27821":50816,"_3006":50994},[],"The generated `LoadBalancer` Service has a usable external address.",{"_3550":346,"_30605":274,"_21201":50996,"_5":14582,"_27821":50816,"_3006":50997},[],"Port 443 reaches that address from the client network.",{"_3550":347,"_30605":274,"_21201":50999,"_5":14582,"_27821":50816,"_3006":51000},[],"DNS resolves to the externally reachable endpoint.",{"_3550":348,"_30605":274,"_21201":51002,"_5":14582,"_27821":50816,"_3006":51003},[],"The certificate contains the DNS name or IP used by the client.",{"_3550":349,"_30605":274,"_21201":51005,"_5":14582,"_27821":50816,"_3006":51006},[],"The Gateway API treats addresses as desired state that a controller may assign or reject; see the Gateway API overview for the resource model.",{"_3550":350,"_30605":350,"_5":14934,"_3006":50070,"_30943":51008,"_21201":51009,"_27821":350},[49963,49964,50070],[],{"_3550":351,"_30605":350,"_21201":51011,"_5":14582,"_27821":350,"_3006":51012},[],"Choose an installation workflow and network architecture for Lamassu on your Kubernetes cluster.",{"_3550":352,"_30605":350,"_5":30940,"_21201":51014,"_27821":51015,"_3006":51016},[],"/docs/deployment/self-hosted/overview#self-managed-kubernetes-deployment","Self-managed Kubernetes deployment",{"_3550":353,"_30605":350,"_5":30940,"_21201":51018,"_27821":51019,"_3006":51020},[],"/docs/deployment/self-hosted/overview#choose-an-installation-workflow","Choose an installation workflow",{"_3550":354,"_30605":350,"_5":30940,"_21201":51022,"_27821":51023,"_3006":51024},[],"/docs/deployment/self-hosted/overview#what-the-lamassu-chart-provides","What the Lamassu chart provides",{"_3550":355,"_30605":350,"_5":30940,"_21201":51026,"_27821":51027,"_3006":51028},[],"/docs/deployment/self-hosted/overview#how-the-deployment-fits-together","How the deployment fits together",{"_3550":356,"_30605":350,"_5":30940,"_21201":51030,"_27821":51031,"_3006":51032},[],"/docs/deployment/self-hosted/overview#platform-requirements","Platform requirements",{"_3550":357,"_30605":350,"_5":30940,"_21201":51034,"_27821":51035,"_3006":51036},[],"/docs/deployment/self-hosted/overview#choose-the-next-page","Choose the next page",{"_3550":358,"_30605":350,"_21201":51038,"_5":14582,"_27821":51015,"_3006":51039},[],"Run Lamassu in a Kubernetes cluster operated by your team. The Helm chart deploys the Lamassu services and their routing resources; you provide the cluster, persistent storage, identity provider, PostgreSQL, RabbitMQ and the network path used by clients.",{"_3550":359,"_30605":350,"_21201":51041,"_5":14582,"_27821":51019,"_3006":51042},[],"Workflow",{"_3550":360,"_30605":350,"_21201":51044,"_5":14582,"_27821":51019,"_3006":51045},[],"Use it for",{"_3550":361,"_30605":350,"_21201":51047,"_5":14582,"_27821":51019,"_3006":51048},[],"What it installs",{"_3550":362,"_30605":350,"_21201":51050,"_5":14582,"_27821":51019,"_3006":51051},[],"Helm",{"_3550":363,"_30605":350,"_21201":51053,"_5":14582,"_27821":51019,"_3006":51054},[],"Production and controlled environments",{"_3550":364,"_30605":350,"_21201":51056,"_5":14582,"_27821":51019,"_3006":51057},[],"Lamassu services and Gateway API resources",{"_3550":365,"_30605":350,"_21201":51059,"_5":14582,"_27821":51019,"_3006":50207},[],{"_3550":366,"_30605":350,"_21201":51061,"_5":14582,"_27821":51019,"_3006":51062},[],"Evaluation, demos, CI and small lab clusters",{"_3550":367,"_30605":350,"_21201":51064,"_5":14582,"_27821":51019,"_3006":51065},[],"PostgreSQL, Keycloak, RabbitMQ, Envoy Gateway and Lamassu",{"_3550":368,"_30605":350,"_21201":51067,"_5":14582,"_27821":51023,"_3006":51068},[],"The Lamassu chart is an **application chart**, not a cluster bootstrap chart. It creates the Kubernetes resources that run and configure Lamassu, but it expects the platform services those resources depend on to exist.",{"_3550":369,"_30605":350,"_21201":51070,"_5":14582,"_27821":51023,"_3006":51071},[],"Area",{"_3550":370,"_30605":350,"_21201":51073,"_5":14582,"_27821":51023,"_3006":51074},[],"The Lamassu chart provides",{"_3550":371,"_30605":350,"_21201":51076,"_5":14582,"_27821":51023,"_3006":51077},[],"You provide",{"_3550":372,"_30605":350,"_21201":51079,"_5":14582,"_27821":51023,"_3006":51080},[],"Lamassu applications",{"_3550":373,"_30605":350,"_21201":51082,"_5":14582,"_27821":51023,"_3006":51083},[],"Deployments and StatefulSets for the UI and APIs, internal Services, ConfigMaps, a ServiceAccount, and optional HPAs and PDBs",{"_3550":374,"_30605":350,"_21201":51085,"_5":14582,"_27821":51023,"_3006":51086},[],"A working Kubernetes cluster, compute capacity and access to the container images",{"_3550":375,"_30605":350,"_21201":51088,"_5":14582,"_27821":51023,"_3006":51089},[],"PostgreSQL data",{"_3550":376,"_30605":350,"_21201":51091,"_5":14582,"_27821":51023,"_3006":51092},[],"A pre-install/pre-upgrade job that creates the required databases and schemas, runs migrations and applies the authorization bootstrap",{"_3550":377,"_30605":350,"_21201":51094,"_5":14582,"_27821":51023,"_3006":51095},[],"A reachable PostgreSQL server, credentials allowed to create databases and schemas, and backup/HA operations",{"_3550":378,"_30605":350,"_21201":51097,"_5":14582,"_27821":51023,"_3006":51098},[],"Messaging",{"_3550":379,"_30605":350,"_21201":51100,"_5":14582,"_27821":51023,"_3006":51101},[],"RabbitMQ connection configuration for the Lamassu services; the connection can use AMQPS, with an optional private CA and an optional client certificate, both set through chart values",{"_3550":380,"_30605":350,"_21201":51103,"_5":14582,"_27821":51023,"_3006":51104},[],"A reachable RabbitMQ broker, credentials and its lifecycle",{"_3550":381,"_30605":350,"_21201":51106,"_5":14582,"_27821":51023,"_3006":51107},[],"Identity",{"_3550":382,"_30605":350,"_21201":51109,"_5":14582,"_27821":51023,"_3006":51110},[],"OIDC/JWT and external-authorization configuration, plus initial Lamassu authorization principals",{"_3550":383,"_30605":350,"_21201":51112,"_5":14582,"_27821":51023,"_3006":51113},[],"An OIDC provider, realm/tenant, client, users, groups and roles",{"_3550":384,"_30605":350,"_21201":51115,"_5":14582,"_27821":51023,"_3006":51116},[],"External routing",{"_3550":385,"_30605":350,"_21201":51118,"_5":14582,"_27821":51023,"_3006":51119},[],"One `Gateway`, `HTTPRoute` resources, an `EnvoyProxy` configuration and Envoy security policies",{"_3550":386,"_30605":350,"_21201":51121,"_5":14582,"_27821":51023,"_3006":51122},[],"Gateway API and Envoy CRDs, the Envoy Gateway controller, a `GatewayClass`, a load-balancer implementation and the external network path",{"_3550":387,"_30605":350,"_21201":51124,"_5":14582,"_27821":51023,"_3006":51125},[],"TLS",{"_3550":388,"_30605":350,"_21201":51127,"_5":14582,"_27821":51023,"_3006":51128},[],"In the default `tls.type: certManager` mode, cert-manager `Issuer` and CA `Certificate` resources and a chart-managed downstream `Certificate`; in the `tls.type: external` mode, a reference to your TLS Secret",{"_3550":389,"_30605":350,"_21201":51130,"_5":14582,"_27821":51023,"_3006":51131},[],"cert-manager only for the default `tls.type: certManager` mode; for trusted TLS, a trusted issuer or a populated TLS Secret",{"_3550":390,"_30605":350,"_21201":51133,"_5":14582,"_27821":51023,"_3006":51134},[],"Persistent application data",{"_3550":391,"_30605":350,"_21201":51136,"_5":14582,"_27821":51023,"_3006":51137},[],"PersistentVolumeClaims required by the default local KMS and VA storage",{"_3550":392,"_30605":350,"_21201":51139,"_5":14582,"_27821":51023,"_3006":51140},[],"A StorageClass, physical storage, backups and a shared/external backend when scaling requires one",{"_3550":393,"_30605":350,"_21201":51142,"_5":14582,"_27821":51023,"_3006":51143},[],"Optional integrations",{"_3550":394,"_30605":350,"_21201":51145,"_5":14582,"_27821":51023,"_3006":51146},[],"Configuration hooks for observability, AWS connectors and PKCS#11/HSM connectivity",{"_3550":395,"_30605":350,"_21201":51148,"_5":14582,"_27821":51023,"_3006":51149},[],"The observability backends, cloud credentials and production HSM or external key service",{"_3550":396,"_30605":350,"_21201":51151,"_5":14582,"_27821":51023,"_3006":51152},[],"The chart creates Lamassu's `Gateway` and routes. It does not install the Envoy Gateway controller or make the generated `LoadBalancer` Service reachable from your network.",{"_3550":397,"_30605":350,"_21201":51154,"_5":14582,"_27821":51023,"_3006":51155},[],"Use one Lamassu Gateway on ports 80 and 443 and let its HTTPRoutes dispatch traffic to every Lamassu service. Give that Gateway one externally reachable endpoint through the cluster load balancer, or forward traffic to it from an external proxy or NAT device. You do not need one Gateway per service.",{"_3550":398,"_30605":350,"_21201":51157,"_5":14582,"_27821":51027,"_3006":51158},[],"The chart creates one shared `Gateway` per Helm release. All chart-managed `HTTPRoute` resources attach to it. Envoy Gateway provisions the proxy data plane and a Kubernetes `LoadBalancer` Service for that Gateway.",{"_3550":399,"_30605":350,"_21201":51160,"_5":14582,"_27821":51027,"_3006":51161},[],"The `gateway.addresses` value is only an address request to the Gateway controller. It does not make an IP routable, open a firewall, configure DNS or create NAT. See Expose the Gateway before setting it.",{"_3550":400,"_30605":350,"_21201":51163,"_5":14582,"_27821":51031,"_3006":51164},[],"Kubernetes 1.24 or newer",{"_3550":401,"_30605":350,"_21201":51166,"_5":14582,"_27821":51031,"_3006":51167},[],"Helm 3.2 or newer",{"_3550":402,"_30605":350,"_21201":51169,"_5":14582,"_27821":51031,"_3006":51170},[],"Envoy Gateway 1.8 or newer and a `GatewayClass`",{"_3550":403,"_30605":350,"_21201":51172,"_5":14582,"_27821":51031,"_3006":51173},[],"cert-manager 1.14 or newer; required only for the default `tls.type: certManager` TLS mode, not for `tls.type: external`",{"_3550":404,"_30605":350,"_21201":51175,"_5":14582,"_27821":51031,"_3006":51176},[],"persistent storage suitable for the selected PostgreSQL, RabbitMQ, VA and KMS configuration",{"_3550":405,"_30605":350,"_21201":51178,"_5":14582,"_27821":51031,"_3006":51179},[],"a load-balancer implementation or another deliberate path from clients to the Gateway",{"_3550":406,"_30605":350,"_21201":51181,"_5":14582,"_27821":51031,"_3006":51182},[],"KMS deployments using the native PKCS#11 sidecar require Kubernetes 1.29 or newer. Prebuilt Lamassu container images are published for `linux/amd64` and `linux/arm64`, and the KMS PKCS#11 client module (`p11-kit-client.so`) is installed at the target architecture's Debian library path: `/usr/lib/x86_64-linux-gnu/pkcs11/p11-kit-client.so` on amd64 and `/usr/lib/aarch64-linux-gnu/pkcs11/p11-kit-client.so` on arm64. The x86\\_64 path is retained as a compatibility alias for existing configurations.",{"_3550":407,"_30605":350,"_21201":51184,"_5":14582,"_27821":51035,"_3006":51185},[],"<Card title=\"Install with Helm\" description=\"Prepare dependencies, configure values, install and verify a controlled deployment.\" href=\"/docs/deployment/self-hosted/helm\" />",{"_3550":408,"_30605":350,"_21201":51187,"_5":14582,"_27821":51035,"_3006":51188},[],"<Card title=\"Upgrade from 3.8.0\" description=\"Upgrade an existing Helm release to 4.0.0: architecture changes, breaking changes, migration steps and validation.\" href=\"/docs/upgrades/3-8-0-to-4-0-0\" />",{"_3550":409,"_30605":350,"_21201":51190,"_5":14582,"_27821":51035,"_3006":51191},[],"<Card title=\"Expose the Gateway\" description=\"Choose an external traffic design, understand gateway.addresses and handle multiple Gateways.\" href=\"/docs/deployment/self-hosted/networking\" />",{"_3550":410,"_30605":350,"_21201":51193,"_5":14582,"_27821":51035,"_3006":51194},[],"<Card title=\"Use Fastlane\" description=\"Bootstrap a complete evaluation or lab environment with one script.\" href=\"/docs/deployment/self-hosted/fastlane\" />",{"_3550":411,"_30605":411,"_5":14934,"_3006":51196,"_30943":51197,"_21201":51199,"_27821":411},"Deployment troubleshooting",[49963,49964,51198],"Operations",[],{"_3550":412,"_30605":411,"_21201":51201,"_5":14582,"_27821":411,"_3006":51202},[],"Diagnose access, service health and infrastructure dependencies.",{"_3550":413,"_30605":411,"_5":30940,"_21201":51204,"_27821":51205,"_3006":51206},[],"/docs/deployment/troubleshooting#diagnostic-sequence","Diagnostic sequence",{"_3550":414,"_30605":411,"_5":30940,"_21201":51208,"_27821":51209,"_3006":51210},[],"/docs/deployment/troubleshooting#reproduce-a-single-operation","Reproduce a single operation",{"_3550":415,"_30605":411,"_5":30940,"_21201":51212,"_27821":51213,"_3006":51214},[],"/docs/deployment/troubleshooting#separate-client-gateway-and-service","Separate client, Gateway and service",{"_3550":416,"_30605":411,"_5":30940,"_21201":51216,"_27821":51217,"_3006":51218},[],"/docs/deployment/troubleshooting#review-kubernetes-status","Review Kubernetes status",{"_3550":417,"_30605":411,"_5":30940,"_21201":51220,"_27821":51221,"_3006":51222},[],"/docs/deployment/troubleshooting#query-the-affected-service","Query the affected service",{"_3550":418,"_30605":411,"_5":30940,"_21201":51224,"_27821":51225,"_3006":51226},[],"/docs/deployment/troubleshooting#validate-the-result-from-outside","Validate the result from outside",{"_3550":419,"_30605":411,"_5":30940,"_21201":51228,"_27821":51229,"_3006":51230},[],"/docs/deployment/troubleshooting#minimal-evidence-collection","Minimal evidence collection",{"_3550":420,"_30605":411,"_5":30940,"_21201":51232,"_27821":51233,"_3006":51234},[],"/docs/deployment/troubleshooting#i-cannot-sign-in","I cannot sign in",{"_3550":421,"_30605":411,"_5":30940,"_21201":51236,"_27821":51237,"_3006":51238},[],"/docs/deployment/troubleshooting#everything-returns-403-or-5xx","Everything returns 403 or 5xx",{"_3550":422,"_30605":411,"_5":30940,"_21201":51240,"_27821":51241,"_3006":51242},[],"/docs/deployment/troubleshooting#api-500-errors","API 500 errors",{"_3550":423,"_30605":411,"_5":30940,"_21201":51244,"_27821":51245,"_3006":51246},[],"/docs/deployment/troubleshooting#a-pod-is-not-ready","A pod is not Ready",{"_3550":424,"_30605":411,"_5":30940,"_21201":51248,"_27821":51249,"_3006":51250},[],"/docs/deployment/troubleshooting#events-are-not-arriving","Events are not arriving",{"_3550":425,"_30605":411,"_5":30940,"_21201":51252,"_27821":51253,"_3006":51254},[],"/docs/deployment/troubleshooting#observability","Observability",{"_3550":426,"_30605":411,"_21201":51256,"_5":14582,"_27821":411,"_3006":51257},[],"Start by locating the failing layer. A Gateway response and an unready pod require different evidence. For rejected issuance or validation results, see PKI troubleshooting; for enrollment, see EST diagnostics.",{"_3550":427,"_30605":411,"_21201":51259,"_5":14582,"_27821":51209,"_3006":51260},[],"Note the time in UTC, user or principal, resource, endpoint and result. Avoid repeating a destructive action such as revocation or deletion.",{"_3550":428,"_30605":411,"_21201":51262,"_5":14582,"_27821":51213,"_3006":51263},[],"Check the HTTP status. A 401 points to authentication; a 403, to authorization; a 404, to route or resource; a 5xx, to the service or a dependency.",{"_3550":429,"_30605":411,"_21201":51265,"_5":14582,"_27821":51217,"_3006":51266},[],"Locate unready pods, restarts, recent events and the state of the release.",{"_3550":430,"_30605":411,"_21201":51268,"_5":14582,"_27821":51221,"_3006":51269},[],"Review its /health endpoint and its logs in the same time window. Then follow the indicated dependency: PostgreSQL, RabbitMQ, the OIDC provider or the cryptographic engine.",{"_3550":431,"_30605":411,"_21201":51271,"_5":14582,"_27821":51225,"_3006":51272},[],"For PKI, check the certificate, the chain, OCSP or CRL with the same type of client production uses.",{"_3550":432,"_30605":411,"_21201":51274,"_5":14582,"_27821":51229,"_3006":51275},[],"Replace the placeholders with your real release, namespace and deployment.",{"_3550":433,"_30605":411,"_21201":51277,"_5":14582,"_27821":51229,"_3006":51278},[],"Also run the chart's connectivity test:",{"_3550":434,"_30605":411,"_21201":51280,"_5":14582,"_27821":51229,"_3006":51281},[],"The test checks the health of CA, DMS Manager, Device Manager and VA, and verifies that the UI returns HTML. A passing test confirms basic connectivity, not a full issuance flow.",{"_3550":435,"_30605":411,"_21201":51283,"_5":14582,"_27821":51229,"_3006":51284},[],"The chart's services expose startup, readiness and liveness probes over /health. A pod can be running but receive no traffic if the readiness probe fails.",{"_3550":436,"_30605":411,"_21201":51286,"_5":14582,"_27821":51233,"_3006":51287},[],"If you receive a 401:",{"_3550":437,"_30605":411,"_21201":51289,"_5":14582,"_27821":51233,"_3006":51290},[],"check that the UI's OIDC authority is reachable from the browser;",{"_3550":438,"_30605":411,"_21201":51292,"_5":14582,"_27821":51233,"_3006":51293},[],"verify issuer, audience and expiration of the token;",{"_3550":439,"_30605":411,"_21201":51295,"_5":14582,"_27821":51233,"_3006":51296},[],"confirm the Gateway can fetch the keys from the JWKS URI;",{"_3550":440,"_30605":411,"_21201":51298,"_5":14582,"_27821":51233,"_3006":51299},[],"check that the provider's public and internal routes point to the same realm.",{"_3550":441,"_30605":411,"_21201":51301,"_5":14582,"_27821":51233,"_3006":51302},[],"If login succeeds but the APIs return 403:",{"_3550":442,"_30605":411,"_21201":51304,"_5":14582,"_27821":51233,"_3006":51305},[],"inspect the token's real claims;",{"_3550":443,"_30605":411,"_21201":51307,"_5":14582,"_27821":51233,"_3006":51308},[],"confirm they match an active principal;",{"_3550":444,"_30605":411,"_21201":51310,"_5":14582,"_27821":51233,"_3006":51311},[],"review the policies granted to that principal;",{"_3550":445,"_30605":411,"_21201":51313,"_5":14582,"_27821":51233,"_3006":51314},[],"verify that authz reaches PostgreSQL and its JWKS.",{"_3550":446,"_30605":411,"_21201":51316,"_5":14582,"_27821":51233,"_3006":51317},[],"On a fresh installation, confirm the migration Job finished. That Job creates schemas, migrates authz, preloads policies and provisions the principals defined in services.authz.bootstrap.",{"_3550":447,"_30605":411,"_21201":51319,"_5":14582,"_27821":51237,"_3006":51320},[],"External authorization fails closed by default. If authz is unavailable, protected routes are blocked.",{"_3550":448,"_30605":411,"_21201":51322,"_5":14582,"_27821":51237,"_3006":51323},[],"Locate the authz pod and Service.",{"_3550":449,"_30605":411,"_21201":51325,"_5":14582,"_27821":51237,"_3006":51326},[],"Check /health, logs and its database connection.",{"_3550":450,"_30605":411,"_21201":51328,"_5":14582,"_27821":51237,"_3006":51329},[],"Verify the DNS and port configured in externalAuthorization.",{"_3550":451,"_30605":411,"_21201":51331,"_5":14582,"_27821":51237,"_3006":51332},[],"Check the check route is /v1/ext\\_authz/check.",{"_3550":452,"_30605":411,"_21201":51334,"_5":14582,"_27821":51237,"_3006":51335},[],"Do not switch to failOpen: true as a permanent workaround: it would allow traffic without authorization during the outage.",{"_3550":453,"_30605":411,"_21201":51337,"_5":14582,"_27821":51241,"_3006":51338},[],"A 500 indicates an internal failure, such as an unavailable database. The `{\"err\": ...}` body currently includes the text of the internal error, which can contain schema, table and constraint names and, on connection failures, the database host and user (not the password). Find the cause in the service log using the request time, and do not forward the body to third parties or show it to end users. This is a known information-disclosure defect: generic messages are planned for 500 responses, keeping the detail only in the service log (tracked in lamassuiot#814). The authorization connector also returns the internal error, in the `details.error` field. Some request errors, such as a key size the engine does not support, are also returned as 500.",{"_3550":454,"_30605":411,"_21201":51340,"_5":14582,"_27821":51245,"_3006":51341},[],"Review kubectl describe pod first. Common causes are:",{"_3550":455,"_30605":411,"_21201":51343,"_5":14582,"_27821":51245,"_3006":51344},[],"wrong credentials or DNS for PostgreSQL or RabbitMQ;",{"_3550":456,"_30605":411,"_21201":51346,"_5":14582,"_27821":51245,"_3006":51347},[],"a missing AMQP CA or client certificate Secret referenced by `amqp.ca.secretName` or `amqp.client.secretName`;",{"_3550":457,"_30605":411,"_21201":51349,"_5":14582,"_27821":51245,"_3006":51350},[],"unbound persistent volume;",{"_3550":458,"_30605":411,"_21201":51352,"_5":14582,"_27821":51245,"_3006":51353},[],"inaccessible image or incorrect pull policy;",{"_3550":459,"_30605":411,"_21201":51355,"_5":14582,"_27821":51245,"_3006":51356},[],"invalid cryptographic engine configuration;",{"_3550":460,"_30605":411,"_21201":51358,"_5":14582,"_27821":51245,"_3006":51359},[],"CPU or memory limits set too low;",{"_3550":461,"_30605":411,"_21201":51361,"_5":14582,"_27821":51245,"_3006":51362},[],"an incomplete prior migration.",{"_3550":462,"_30605":411,"_21201":51364,"_5":14582,"_27821":51245,"_3006":51365},[],"Generic values request 100 mCPU and 128 MiB and limit to 500 mCPU and 512 MiB. Tune per service when you see OOMKills, throttling or slow startups.",{"_3550":463,"_30605":411,"_21201":51367,"_5":14582,"_27821":51245,"_3006":51368},[],"Filesystem-based KMS engines and VA local storage use exclusive-access volumes. Keep a single replica or migrate to shared backends before enabling autoscaling.",{"_3550":464,"_30605":411,"_21201":51370,"_5":14582,"_27821":51245,"_3006":51371},[],"Internal calls now fail fast instead of hanging for the clients covered by Egress proxy: connection attempts time out after 30 seconds and TLS handshakes after 10 seconds. The authorization-engine connector keeps its own transport without these dial and handshake timeouts; only its overall 30-second request timeout bounds each call. If an egress proxy handles the cluster's outbound traffic, check the pod's `HTTP_PROXY`, `HTTPS_PROXY` and `NO_PROXY` environment variables and list in-cluster service names in `NO_PROXY`.",{"_3550":465,"_30605":411,"_21201":51373,"_5":14582,"_27821":51249,"_3006":51374},[],"Domain and audit events depend on the bus publisher:",{"_3550":466,"_30605":411,"_21201":51376,"_5":14582,"_27821":51249,"_3006":51377},[],"verify it is enabled in the emitting service;",{"_3550":467,"_30605":411,"_21201":51379,"_5":14582,"_27821":51249,"_3006":51380},[],"check AMQP connectivity and credentials;",{"_3550":468,"_30605":411,"_21201":51382,"_5":14582,"_27821":51249,"_3006":51383},[],"review exchange, routing key, queues and consumers;",{"_3550":469,"_30605":411,"_21201":51385,"_5":14582,"_27821":51249,"_3006":51386},[],"inspect dead-letter queues;",{"_3550":470,"_30605":411,"_21201":51388,"_5":14582,"_27821":51249,"_3006":51389},[],"alert on orphan durable queues and backlog growth.",{"_3550":471,"_30605":411,"_21201":51391,"_5":14582,"_27821":51249,"_3006":51392},[],"If `amqp.tls` is enabled, verify the TLS side as well:",{"_3550":472,"_30605":411,"_21201":51394,"_5":14582,"_27821":51249,"_3006":51395},[],"confirm the broker listener speaks AMQPS on the configured port — the default port stays `5672` and does not follow TLS automatically;",{"_3550":473,"_30605":411,"_21201":51397,"_5":14582,"_27821":51249,"_3006":51398},[],"if you set `amqp.ca.secretName`, confirm the Secret exists in the release namespace and its data key matches `amqp.ca.certificateKey` (default `ca.crt`); if `amqp.ca.secretName` is not set, the clients trust the system CAs;",{"_3550":474,"_30605":411,"_21201":51400,"_5":14582,"_27821":51249,"_3006":51401},[],"remember that a missing referenced Secret prevents the consuming pods from starting;",{"_3550":475,"_30605":411,"_21201":51403,"_5":14582,"_27821":51249,"_3006":51404},[],"after updating the CA or client certificate Secret, restart the consuming pods: the AMQP client loads certificates at startup.",{"_3550":476,"_30605":411,"_21201":51406,"_5":14582,"_27821":51249,"_3006":51407},[],"See AMQP TLS (AMQPS) for the full configuration.",{"_3550":477,"_30605":411,"_21201":51409,"_5":14582,"_27821":51249,"_3006":51410},[],"A consumer outage does not always prevent the main operation from completing. That is why you must monitor RabbitMQ and independently verify the persistence of audit logs.",{"_3550":478,"_30605":411,"_21201":51412,"_5":14582,"_27821":51253,"_3006":51413},[],"The chart can enable OpenTelemetry instrumentation for the services that support it, including authz; it does not configure OpenTelemetry for AWS Connector, wfx or the UI. Traces are exported over OTLP HTTP and logs can be directed to a compatible endpoint, such as VictoriaLogs. Use a correlation identifier and the same time window to join Gateway, service and dependency.",{"_3550":479,"_30605":411,"_21201":51415,"_5":14582,"_27821":51253,"_3006":51416},[],"Before closing an incident, record:",{"_3550":480,"_30605":411,"_21201":51418,"_5":14582,"_27821":51253,"_3006":51419},[],"the confirmed cause;",{"_3550":481,"_30605":411,"_21201":51421,"_5":14582,"_27821":51253,"_3006":51422},[],"the time scope and affected resources;",{"_3550":482,"_30605":411,"_21201":51424,"_5":14582,"_27821":51253,"_3006":51425},[],"the commands or queries used;",{"_3550":483,"_30605":411,"_21201":51427,"_5":14582,"_27821":51253,"_3006":51428},[],"the applied change and how to revert it;",{"_3550":484,"_30605":411,"_21201":51430,"_5":14582,"_27821":51253,"_3006":51431},[],"validation from a consumer;",{"_3550":485,"_30605":411,"_21201":51433,"_5":14582,"_27821":51253,"_3006":51434},[],"the preventive action and its owner.",{"_3550":486,"_30605":486,"_5":14934,"_3006":51436,"_30943":51437,"_21201":51441,"_27821":486},"Data model",[49963,51438,51439,51440],"Platform","Administration","Access control",[],{"_3550":487,"_30605":486,"_21201":51443,"_5":14582,"_27821":486,"_3006":51444},[],"Entities and relationships from the pki.json schema that authz uses to evaluate access policies.",{"_3550":488,"_30605":486,"_5":30940,"_21201":51446,"_27821":51447,"_3006":51448},[],"/docs/platform/administration/access-control/data-model#schema-relationships","Schema relationships",{"_3550":489,"_30605":486,"_5":30940,"_21201":51450,"_27821":51451,"_3006":51452},[],"/docs/platform/administration/access-control/data-model#schema-entities","Schema entities",{"_3550":490,"_30605":486,"_21201":51454,"_5":14582,"_27821":486,"_3006":51455},[],"The `connectors/authz/pki.json` schema defines the entities in the `pki` authorization namespace. A policy identifies a resource type through `namespace: pki`, `schema_name` and `entity_type`. For example, `ca.certificate` identifies the `certificate` entity type in the `ca` schema.",{"_3550":491,"_30605":486,"_21201":51457,"_5":14582,"_27821":51447,"_3006":51458},[],"Each arrow starts at the entity that declares the relationship and points to its `target_entity`. The value of `foreign_key`, the source column, appears below the label. In `pki.json`, each relationship's `name` matches that column. Select the diagram to enlarge it and scroll through it.",{"_3550":492,"_30605":486,"_21201":51460,"_5":14582,"_27821":51447,"_3006":51461},[],"A policy can propagate actions from the referenced entity to the one that declares the relationship. For example, to grant read access to a DMS's devices, a rule starts from `dmsmanager.dms`, targets `devicemanager.device` and specifies `via: dms_owner`.",{"_3550":493,"_30605":486,"_21201":51463,"_5":14582,"_27821":51447,"_3006":51464},[],"When filtering inherited access, `authz` matches the `foreign_key` column against the first `primary_key` column of the referenced entity. For example, it matches `subject_common_name` to `device.id`, `issuer_meta_serial_number` to `ca_certificate.id` and the links to `kms_key` to `kms_key.key_id`.",{"_3550":494,"_30605":486,"_21201":51466,"_5":14582,"_27821":51451,"_3006":51467},[],"Entity (`schema_name.entity_type`)",{"_3550":495,"_30605":486,"_21201":51469,"_5":14582,"_27821":51451,"_3006":51470},[],"Table (`table_name`)",{"_3550":496,"_30605":486,"_21201":51472,"_5":14582,"_27821":51451,"_3006":51473},[],"Key (`primary_key`)",{"_3550":497,"_30605":486,"_21201":51475,"_5":14582,"_27821":51451,"_3006":51476},[],"`alerts.event`",{"_3550":498,"_30605":486,"_21201":51478,"_5":14582,"_27821":51451,"_3006":51479},[],"`events`",{"_3550":499,"_30605":486,"_21201":51481,"_5":14582,"_27821":51451,"_3006":51482},[],"`event_type`",{"_3550":500,"_30605":486,"_21201":51484,"_5":14582,"_27821":51451,"_3006":51485},[],"`alerts.subscription`",{"_3550":501,"_30605":486,"_21201":51487,"_5":14582,"_27821":51451,"_3006":51488},[],"`subscriptions`",{"_3550":502,"_30605":486,"_21201":51490,"_5":14582,"_27821":51451,"_3006":51491},[],"`id`",{"_3550":503,"_30605":486,"_21201":51493,"_5":14582,"_27821":51451,"_3006":51494},[],"`ca.ca_certificate`",{"_3550":504,"_30605":486,"_21201":51496,"_5":14582,"_27821":51451,"_3006":51497},[],"`ca_certificates`",{"_3550":505,"_30605":486,"_21201":51499,"_5":14582,"_27821":51451,"_3006":51491},[],{"_3550":506,"_30605":486,"_21201":51501,"_5":14582,"_27821":51451,"_3006":51502},[],"`ca.certificate`",{"_3550":507,"_30605":486,"_21201":51504,"_5":14582,"_27821":51451,"_3006":51505},[],"`certificates`",{"_3550":508,"_30605":486,"_21201":51507,"_5":14582,"_27821":51451,"_3006":51508},[],"`serial_number`",{"_3550":509,"_30605":486,"_21201":51510,"_5":14582,"_27821":51451,"_3006":51511},[],"`ca.issuance_profile`",{"_3550":510,"_30605":486,"_21201":51513,"_5":14582,"_27821":51451,"_3006":51514},[],"`issuance_profiles`",{"_3550":511,"_30605":486,"_21201":51516,"_5":14582,"_27821":51451,"_3006":51491},[],{"_3550":512,"_30605":486,"_21201":51518,"_5":14582,"_27821":51451,"_3006":51519},[],"`devicemanager.device_group`",{"_3550":513,"_30605":486,"_21201":51521,"_5":14582,"_27821":51451,"_3006":51522},[],"`device_groups`",{"_3550":514,"_30605":486,"_21201":51524,"_5":14582,"_27821":51451,"_3006":51491},[],{"_3550":515,"_30605":486,"_21201":51526,"_5":14582,"_27821":51451,"_3006":51527},[],"`devicemanager.device`",{"_3550":516,"_30605":486,"_21201":51529,"_5":14582,"_27821":51451,"_3006":51530},[],"`devices`",{"_3550":517,"_30605":486,"_21201":51532,"_5":14582,"_27821":51451,"_3006":51491},[],{"_3550":518,"_30605":486,"_21201":51534,"_5":14582,"_27821":51451,"_3006":51535},[],"`dmsmanager.dms`",{"_3550":519,"_30605":486,"_21201":51537,"_5":14582,"_27821":51451,"_3006":51538},[],"`dms`",{"_3550":520,"_30605":486,"_21201":51540,"_5":14582,"_27821":51451,"_3006":51491},[],{"_3550":521,"_30605":486,"_21201":51542,"_5":14582,"_27821":51451,"_3006":51543},[],"`kms.kms_key`",{"_3550":522,"_30605":486,"_21201":51545,"_5":14582,"_27821":51451,"_3006":51546},[],"`kms_keys`",{"_3550":523,"_30605":486,"_21201":51548,"_5":14582,"_27821":51451,"_3006":51549},[],"`key_id`, `engine_id`",{"_3550":524,"_30605":486,"_21201":51551,"_5":14582,"_27821":51451,"_3006":51552},[],"`va.crl_settings`",{"_3550":525,"_30605":486,"_21201":51554,"_5":14582,"_27821":51451,"_3006":51555},[],"`crl_settings`",{"_3550":526,"_30605":486,"_21201":51557,"_5":14582,"_27821":51451,"_3006":51558},[],"`ca_id`",{"_3550":527,"_30605":486,"_21201":51560,"_5":14582,"_27821":51451,"_3006":51561},[],"Events, subscriptions and device groups have their own actions and filters. Their `relations` lists are empty and they have zero incoming references in the schema. For `ca.certificate`, `view_tables` also lists `certificates_view`.",{"_3550":528,"_30605":486,"_21201":51563,"_5":14582,"_27821":51451,"_3006":51564},[],"Each entity declares instance-level operations in `atomic_actions`, operations that require no resource ID in `global_actions`, and the columns and types accepted by `column_filters` in `filterable`.",{"_3550":529,"_30605":486,"_21201":51566,"_5":14582,"_27821":51451,"_3006":51567},[],"<Card title=\"Access inherited through relations\" href=\"/docs/platform/administration/access-control#access-inherited-through-relations\" />",{"_3550":530,"_30605":530,"_5":14934,"_3006":51569,"_30943":51570,"_21201":51571,"_27821":530},"Access control overview",[49963,51438,51439,51440],[],{"_3550":531,"_30605":530,"_21201":51573,"_5":14582,"_27821":530,"_3006":51574},[],"Design who can access Lamassu through principals, policies, resource permissions and HTTP route authorization.",{"_3550":532,"_30605":530,"_5":30940,"_21201":51576,"_27821":51577,"_3006":51578},[],"/docs/platform/administration/access-control#essential-concepts","Essential concepts",{"_3550":533,"_30605":530,"_5":30940,"_21201":51580,"_27821":51581,"_3006":51582},[],"/docs/platform/administration/access-control#two-decision-systems","Two decision systems",{"_3550":534,"_30605":530,"_5":30940,"_21201":51584,"_27821":51585,"_3006":51586},[],"/docs/platform/administration/access-control#integrated-or-external-http-services","Integrated or external HTTP services",{"_3550":535,"_30605":530,"_5":30940,"_21201":51588,"_27821":51589,"_3006":51590},[],"/docs/platform/administration/access-control#authentication-only-routes-and-unmapped-paths","Authentication-only routes and unmapped paths",{"_3550":536,"_30605":530,"_5":30940,"_21201":51592,"_27821":51593,"_3006":51594},[],"/docs/platform/administration/access-control#services-developed-by-lamassu","Services developed by Lamassu",{"_3550":537,"_30605":530,"_5":30940,"_21201":51596,"_27821":51597,"_3006":51598},[],"/docs/platform/administration/access-control#how-the-two-paths-relate","How the two paths relate",{"_3550":538,"_30605":530,"_5":30940,"_21201":51600,"_27821":51601,"_3006":51602},[],"/docs/platform/administration/access-control#oidc-principals","OIDC principals",{"_3550":539,"_30605":530,"_5":30940,"_21201":51604,"_27821":51605,"_3006":51606},[],"/docs/platform/administration/access-control#x509-principals","X.509 principals",{"_3550":540,"_30605":530,"_5":30940,"_21201":51608,"_27821":51609,"_3006":51610},[],"/docs/platform/administration/access-control#when-several-principals-match","When several principals match",{"_3550":541,"_30605":530,"_5":30940,"_21201":51612,"_27821":51613,"_3006":51614},[],"/docs/platform/administration/access-control#how-policies-express-access","How policies express access",{"_3550":542,"_30605":530,"_5":30940,"_21201":51616,"_27821":51617,"_3006":51618},[],"/docs/platform/administration/access-control#global-and-direct-access","Global and direct access",{"_3550":543,"_30605":530,"_5":30940,"_21201":51620,"_27821":51621,"_3006":51622},[],"/docs/platform/administration/access-control#access-inherited-through-relations","Access inherited through relations",{"_3550":544,"_30605":530,"_5":30940,"_21201":51624,"_27821":51625,"_3006":51626},[],"/docs/platform/administration/access-control#attribute-filtered-access","Attribute-filtered access",{"_3550":545,"_30605":530,"_5":30940,"_21201":51628,"_27821":51629,"_3006":51630},[],"/docs/platform/administration/access-control#http-rules","HTTP rules",{"_3550":546,"_30605":530,"_5":30940,"_21201":51632,"_27821":51633,"_3006":51634},[],"/docs/platform/administration/access-control#included-policies","Included policies",{"_3550":547,"_30605":530,"_5":30940,"_21201":51636,"_27821":51637,"_3006":50603},[],"/docs/platform/administration/access-control#provision-the-first-administrator",{"_3550":548,"_30605":530,"_5":30940,"_21201":51639,"_27821":51640,"_3006":51641},[],"/docs/platform/administration/access-control#prepare-the-identity-provider","Prepare the identity provider",{"_3550":549,"_30605":530,"_5":30940,"_21201":51643,"_27821":51644,"_3006":51645},[],"/docs/platform/administration/access-control#configure-token-validation","Configure token validation",{"_3550":550,"_30605":530,"_5":30940,"_21201":51647,"_27821":51648,"_3006":51649},[],"/docs/platform/administration/access-control#install-and-verify-administrative-access","Install and verify administrative access",{"_3550":551,"_30605":530,"_5":30940,"_21201":51651,"_27821":51652,"_3006":51653},[],"/docs/platform/administration/access-control#test-an-unprivileged-identity","Test an unprivileged identity",{"_3550":552,"_30605":530,"_5":30940,"_21201":51655,"_27821":51656,"_3006":51657},[],"/docs/platform/administration/access-control#reduce-use-of-the-bootstrap-administrator","Reduce use of the bootstrap administrator",{"_3550":553,"_30605":530,"_5":30940,"_21201":51659,"_27821":51660,"_3006":51661},[],"/docs/platform/administration/access-control#fastlane-bootstrap","Fastlane bootstrap",{"_3550":554,"_30605":530,"_5":30940,"_21201":51663,"_27821":51664,"_3006":51665},[],"/docs/platform/administration/access-control#design-least-privilege-roles","Design least-privilege roles",{"_3550":555,"_30605":530,"_5":30940,"_21201":51667,"_27821":51668,"_3006":51669},[],"/docs/platform/administration/access-control#changes-and-access-revocation","Changes and access revocation",{"_3550":556,"_30605":530,"_5":30940,"_21201":51671,"_27821":51672,"_3006":51673},[],"/docs/platform/administration/access-control#operational-checklist","Operational checklist",{"_3550":557,"_30605":530,"_5":30940,"_21201":51675,"_27821":51676,"_3006":51677},[],"/docs/platform/administration/access-control#diagnostics","Diagnostics",{"_3550":558,"_30605":530,"_5":30940,"_21201":51679,"_27821":51680,"_3006":51681},[],"/docs/platform/administration/access-control#the-response-is-401","The response is 401",{"_3550":559,"_30605":530,"_5":30940,"_21201":51683,"_27821":51684,"_3006":51685},[],"/docs/platform/administration/access-control#the-response-is-403","The response is 403",{"_3550":560,"_30605":530,"_5":30940,"_21201":51687,"_27821":51688,"_3006":51689},[],"/docs/platform/administration/access-control#everything-returns-403","Everything returns 403",{"_3550":561,"_30605":530,"_5":30940,"_21201":51691,"_27821":51692,"_3006":51693},[],"/docs/platform/administration/access-control#access-appears-without-a-policy-grant","Access appears without a policy grant",{"_3550":562,"_30605":530,"_5":30940,"_21201":51695,"_27821":51696,"_3006":51697},[],"/docs/platform/administration/access-control#everything-fails-when-authz-is-unavailable","Everything fails when authz is unavailable",{"_3550":563,"_30605":530,"_21201":51699,"_5":14582,"_27821":530,"_3006":51700},[],"Lamassu access control turns an authenticated identity into concrete permissions. The OIDC provider or the client certificate proves **who** makes a request; the `authz` service decides **what that identity can do** and **over which resources**.",{"_3550":564,"_30605":530,"_21201":51702,"_5":14582,"_27821":530,"_3006":51703},[],"Lamassu does not assign permissions directly to users. The full chain is:",{"_3550":565,"_30605":530,"_21201":51705,"_5":14582,"_27821":530,"_3006":51706},[],"This model lets you represent people, identity-provider groups, service accounts and devices without coupling authorization to a specific provider.",{"_3550":566,"_30605":530,"_21201":51708,"_5":14582,"_27821":51577,"_3006":51709},[],"A **principal** connects a credential to Lamassu. It defines how to recognize an OIDC or X.509 identity and can be active or disabled.",{"_3550":567,"_30605":530,"_21201":51711,"_5":14582,"_27821":51577,"_3006":51712},[],"A **policy** groups reusable permissions. It can be granted to several principals and can contain rules about Lamassu entities, rules about HTTP routes or both.",{"_3550":568,"_30605":530,"_21201":51714,"_5":14582,"_27821":51577,"_3006":51715},[],"An **entity rule** grants actions over resources such as certification authorities, certificates, issuance profiles, devices, DMSs, keys or alert subscriptions. It can cover all resources of a type or be limited by identifier, relation or attribute.",{"_3550":569,"_30605":530,"_21201":51717,"_5":14582,"_27821":51577,"_3006":51718},[],"An **HTTP rule** grants actions associated with API routes. It is the mechanism the Gateway uses to decide whether a request may cross the perimeter.",{"_3550":570,"_30605":530,"_21201":51720,"_5":14582,"_27821":51577,"_3006":51721},[],"A **grant** is the association between a principal and a policy. Removing the grant removes all permissions contributed by that policy, without modifying it for other principals.",{"_3550":571,"_30605":530,"_21201":51723,"_5":14582,"_27821":51577,"_3006":51724},[],"A valid JWT or a valid client certificate does not grant access by itself. The credential must match at least one active principal and, unless the HTTP schema exempts the route, one of its policies must allow the requested operation. See *Authentication-only routes and unmapped paths* for those exemptions.",{"_3550":572,"_30605":530,"_21201":51726,"_5":14582,"_27821":51581,"_3006":51727},[],"Lamassu uses two authorization paths depending on who implements the protected service. They share principals, policies and grants, but they do not interpret the rules the same way.",{"_3550":573,"_30605":530,"_21201":51729,"_5":14582,"_27821":51581,"_3006":51730},[],"An external service can be protected without knowing Lamassu's internal authorization model. A service developed by Lamassu embeds the authorization engine and can decide on concrete resources and filter its queries.",{"_3550":574,"_30605":530,"_21201":51732,"_5":14582,"_27821":51585,"_3006":51733},[],"This path protects APIs that join the platform through the Gateway but do not natively implement Lamassu's authorization SDK. Job Manager is the current example. The same pattern allows integrating other HTTP services as long as their routes are described in an `authz` HTTP schema.",{"_3550":575,"_30605":530,"_21201":51735,"_5":14582,"_27821":51585,"_3006":51736},[],"The decision is made **before forwarding the request to the service**:",{"_3550":576,"_30605":530,"_21201":51738,"_5":14582,"_27821":51585,"_3006":51739},[],"Envoy Gateway authenticates the request, usually validating a JWT against the OIDC provider's JWKS.",{"_3550":577,"_30605":530,"_21201":51741,"_5":14582,"_27821":51585,"_3006":51742},[],"For a protected route, Envoy sends the method, URL, headers and required data to `/v1/ext_authz/check`.",{"_3550":578,"_30605":530,"_21201":51744,"_5":14582,"_27821":51585,"_3006":51745},[],"`authz` extracts the credential and resolves all active principals matching it.",{"_3550":579,"_30605":530,"_21201":51747,"_5":14582,"_27821":51585,"_3006":51748},[],"It separately loads the policies granted to each principal.",{"_3550":580,"_30605":530,"_21201":51750,"_5":14582,"_27821":51585,"_3006":51751},[],"The HTTP schema translates the method and route combination into a logical action, such as `nbi-job-read` or `nbi-workflow-create`.",{"_3550":581,"_30605":530,"_21201":51753,"_5":14582,"_27821":51585,"_3006":51754},[],"`authz` looks for an HTTP rule granting that action.",{"_3550":582,"_30605":530,"_21201":51756,"_5":14582,"_27821":51585,"_3006":51757},[],"If the route declares constraints, it compares request data with the normalized attributes of the same principal contributing the policy; the policy's own `param_constraints` also pin the granted action to literal request values.",{"_3550":583,"_30605":530,"_21201":51759,"_5":14582,"_27821":51585,"_3006":51760},[],"A satisfying result lets Envoy forward the request; any other response blocks it at the Gateway.",{"_3550":584,"_30605":530,"_21201":51762,"_5":14582,"_27821":51585,"_3006":51763},[],"When it allows access, `authz` returns the selected principal in the `X-Principal-ID` response header. The Gateway can propagate that header to the service to preserve the identity context. Clients cannot forge this header: the Gateway removes client-supplied `X-Principal-Id` (and the other forwarded identity and certificate headers) before forwarding, so only `authz` can set it. See Expose the Gateway for the full list of stripped headers.",{"_3550":585,"_30605":530,"_21201":51765,"_5":14582,"_27821":51585,"_3006":51766},[],"HTTP rules primarily answer &#x2A;*\"can this identity call this API operation?\"**. On their own they do not produce filters over the external service's database. To limit a route to a specific device, tenant or client, either the schema declares a constraint relating a request value to a normalized attribute of the principal, or the policy pins the request value to a literal with `param_constraints`. The first scopes each identity to its own resources through a single grant; the second restricts a grant to a fixed value regardless of who holds it.",{"_3550":586,"_30605":530,"_21201":51768,"_5":14582,"_27821":51589,"_3006":51769},[],"Two schema-level settings cover endpoints that policies do not mention:",{"_3550":587,"_30605":530,"_21201":51771,"_5":14582,"_27821":51589,"_3006":51772},[],"**`skip_authz: true` on a route** allows any identity that matches an active principal to reach it, even one with no granted policies. Use it for paths such as `/openapi.json` or `/health` that every authenticated caller should be able to access. The request still has to authenticate successfully: a credential that fails validation or matches no active principal is rejected before this setting is considered. A `skip_authz` route cannot declare constraints, and it wins over any other schema's route or default action for the same request.",{"_3550":588,"_30605":530,"_21201":51774,"_5":14582,"_27821":51589,"_3006":51775},[],"**`default_action` with `base_paths`** decides what happens when a request falls under a path prefix the schema owns but no explicit route matches. `deny` — the value the Job Manager schema ships with — turns the implicit denial of unmapped paths into an explicit, auditable statement; `allow` opens unmapped endpoints under that prefix to any identity that matches an active principal.",{"_3550":589,"_30605":530,"_21201":51777,"_5":14582,"_27821":51589,"_3006":51778},[],"These are decisions of the schema, not of a policy: `skip_authz` removes the grant check for that route, even when another schema maps the same request to an action that requires a grant, and `default_action` only covers requests that no explicit route in any schema matches. Keep three rules in mind:",{"_3550":590,"_30605":530,"_21201":51780,"_5":14582,"_27821":51589,"_3006":51781},[],"`default_action` requires at least one `base_paths` entry, and base paths are absolute paths such as `/api/wfx/nbi/v1`.",{"_3550":591,"_30605":530,"_21201":51783,"_5":14582,"_27821":51589,"_3006":51784},[],"An explicit route in any schema takes precedence: the fallback only decides requests that no schema's routes cover. When the prefixes of two schemas overlap, the longest matching prefix decides.",{"_3550":592,"_30605":530,"_21201":51786,"_5":14582,"_27821":51589,"_3006":51787},[],"Two schemas cannot claim the same base path with different default actions; the conflicting schema fails to load.",{"_3550":593,"_30605":530,"_21201":51789,"_5":14582,"_27821":51589,"_3006":51790},[],"A `skip_authz` route and a `default_action: \"allow\"` prefix grant access without consulting any policy. Every identity that matches an active principal can reach what they open, including identities with no granted policies. A `skip_authz` route in one schema also opens a request that another schema maps to a grant-protected action. Review these settings whenever you add or upgrade an integrated service.",{"_3550":594,"_30605":530,"_21201":51792,"_5":14582,"_27821":51593,"_3006":51793},[],"Lamassu's native services embed authorization in their middleware and know the entities they operate on: certificates, CAs, issuance profiles, keys, devices, DMSs or subscriptions, among others.",{"_3550":595,"_30605":530,"_21201":51795,"_5":14582,"_27821":51593,"_3006":51796},[],"The decision is made with the domain operation context:",{"_3550":596,"_30605":530,"_21201":51798,"_5":14582,"_27821":51593,"_3006":51799},[],"The middleware extracts the credential and resolves the matching principals.",{"_3550":597,"_30605":530,"_21201":51801,"_5":14582,"_27821":51593,"_3006":51802},[],"The endpoint identifies the action, the entity type and, when applicable, the key of the requested resource.",{"_3550":598,"_30605":530,"_21201":51804,"_5":14582,"_27821":51593,"_3006":51805},[],"`authz` gathers the entity rules of the granted policies.",{"_3550":599,"_30605":530,"_21201":51807,"_5":14582,"_27821":51593,"_3006":51808},[],"The engine evaluates direct grants, attribute filters and relations with other entities.",{"_3550":600,"_30605":530,"_21201":51810,"_5":14582,"_27821":51593,"_3006":51811},[],"For an individual operation, it checks that the concrete resource satisfies the computed scope.",{"_3550":601,"_30605":530,"_21201":51813,"_5":14582,"_27821":51593,"_3006":51814},[],"For a listing, it generates a SQL filter that the service adds to its own query.",{"_3550":602,"_30605":530,"_21201":51816,"_5":14582,"_27821":51593,"_3006":51817},[],"Here the engine answers &#x2A;*\"can this identity perform this action on this concrete resource?\"**.",{"_3550":603,"_30605":530,"_21201":51819,"_5":14582,"_27821":51593,"_3006":51820},[],"Actions fall into two groups:",{"_3550":604,"_30605":530,"_21201":51822,"_5":14582,"_27821":51593,"_3006":51823},[],"**Global actions** do not need a resource identifier. `create`, `import` or access to a console section are common examples.",{"_3550":605,"_30605":530,"_21201":51825,"_5":14582,"_27821":51593,"_3006":51826},[],"**Atomic actions** are evaluated on a concrete instance. For certificates these include `read`, `metadata-update`, `status-update` and `delete`; for a CA there are also `sign`, `reissue` and other lifecycle operations.",{"_3550":606,"_30605":530,"_21201":51828,"_5":14582,"_27821":51593,"_3006":51829},[],"Filtering inside the service prevents leaks in listings: unauthorized resources are excluded from the SQL query instead of being fetched and hidden later in the interface.",{"_3550":607,"_30605":530,"_21201":51831,"_5":14582,"_27821":51597,"_3006":51832},[],"They are not two equivalent controls applied twice. HTTP rules protect the perimeter of an integrated service; entity rules express permissions over the data model of the native services.",{"_3550":608,"_30605":530,"_21201":51834,"_5":14582,"_27821":51597,"_3006":51835},[],"A policy can contain both rule types when an identity needs to operate Lamassu resources and also call an integrated API. Granting an entity rule does not automatically grant an HTTP action, nor does an HTTP rule create access over an entity.",{"_3550":609,"_30605":530,"_21201":51837,"_5":14582,"_27821":51597,"_3006":51838},[],"If no combination of principal, policy and rule allows the operation, Lamassu denies it, unless the HTTP schema declares `skip_authz` on the route or `default_action: allow` on a base path that covers it (see *Authentication-only routes and unmapped paths*). Additionally, `auth.externalAuthorization.failOpen` is `false` by default: if `authz` is unavailable, the Gateway blocks protected routes.",{"_3550":610,"_30605":530,"_21201":51840,"_5":14582,"_27821":51601,"_3006":51841},[],"An OIDC principal matches the claims of a validated JWT. It is appropriate for human users, corporate groups, IdP roles and service accounts that obtain tokens.",{"_3550":611,"_30605":530,"_21201":51843,"_5":14582,"_27821":51601,"_3006":51844},[],"The following principal represents any identity holding the `pki-operators` role in Keycloak:",{"_3550":612,"_30605":530,"_21201":51846,"_5":14582,"_27821":51601,"_3006":51847},[],"Claim paths can be nested, such as `realm_access.roles`. Within a single principal, **all** conditions must hold. This lets you require, for example, a group and an organizational audience at the same time.",{"_3550":613,"_30605":530,"_21201":51849,"_5":14582,"_27821":51601,"_3006":51850},[],"The implemented operators are:",{"_3550":614,"_30605":530,"_21201":51852,"_5":14582,"_27821":51601,"_3006":51853},[],"`equals`, for exact equality;",{"_3550":615,"_30605":530,"_21201":51855,"_5":14582,"_27821":51601,"_3006":51856},[],"`contains`, to check membership in a list or the presence of text in a scalar value.",{"_3550":616,"_30605":530,"_21201":51858,"_5":14582,"_27821":51601,"_3006":51859},[],"Design matching with stable attributes. For people, it is usually better to bind permissions to centrally managed groups or roles than to the email or username. For a service account, a stable `sub` keeps its permissions from mixing with a human operator's.",{"_3550":617,"_30605":530,"_21201":51861,"_5":14582,"_27821":51601,"_3006":51862},[],"Although the model recognizes the operator name `matches`, the current implementation does not evaluate regular expressions and the condition never matches. Use `equals` or `contains`.",{"_3550":618,"_30605":530,"_21201":51864,"_5":14582,"_27821":51605,"_3006":51865},[],"An X.509 principal lets you recognize a workload or a device by its client certificate. Lamassu checks the certificate signature against the configured CA and, depending on the mode, also its serial number or Common Name.",{"_3550":619,"_30605":530,"_21201":51867,"_5":14582,"_27821":51605,"_3006":51868},[],"The available modes are:",{"_3550":620,"_30605":530,"_21201":51870,"_5":14582,"_27821":51605,"_3006":51871},[],"`serial_and_ca`: an exact certificate, identified by serial number and CA;",{"_3550":621,"_30605":530,"_21201":51873,"_5":14582,"_27821":51605,"_3006":51874},[],"`cn_and_ca`: an exact or wildcard Common Name and a specific CA;",{"_3550":622,"_30605":530,"_21201":51876,"_5":14582,"_27821":51605,"_3006":51877},[],"`any_from_ca`: any certificate issued directly by the given CA.",{"_3550":623,"_30605":530,"_21201":51879,"_5":14582,"_27821":51605,"_3006":51880},[],"This example recognizes certificates whose CN starts with `factory-a-` and that are signed by the configured CA:",{"_3550":624,"_30605":530,"_21201":51882,"_5":14582,"_27821":51605,"_3006":51883},[],"`ca_trust.identity_type` accepts `fingerprint` or `authority_key_id`. In both cases you must provide the CA certificate in `ca_trust.pem`; Lamassu verifies both the signature and the expected identity of the CA.",{"_3550":625,"_30605":530,"_21201":51885,"_5":14582,"_27821":51605,"_3006":51886},[],"Use `any_from_ca` only when every identity issued by that CA should share the same permissions. If a CA issues certificates for different populations, separate access by serial or CN, or use different issuing CAs.",{"_3550":626,"_30605":530,"_21201":51888,"_5":14582,"_27821":51609,"_3006":51889},[],"A single credential can match more than one principal. It is common for a user to match a principal of their team and another of their operational function.",{"_3550":627,"_30605":530,"_21201":51891,"_5":14582,"_27821":51609,"_3006":51892},[],"For entity permissions, Lamassu combines permissions with OR logic: it is enough that one policy of one of the principals allows the action. Listings contain the union of the resources visible to all of them.",{"_3550":628,"_30605":530,"_21201":51894,"_5":14582,"_27821":51609,"_3006":51895},[],"HTTP routes with constraints are stricter. The same principal contributing the policy must also satisfy the attributes required by the route. Lamassu does not combine one principal's policy with an attribute belonging to another.",{"_3550":629,"_30605":530,"_21201":51897,"_5":14582,"_27821":51609,"_3006":51898},[],"For this reason, adding a matching principal can only broaden access. Before creating overlapping rules, review the full set of policies a real identity will receive.",{"_3550":630,"_30605":530,"_21201":51900,"_5":14582,"_27821":51617,"_3006":51901},[],"A rule identifies the domain (`namespace`), the data schema (`schema_name`) and the entity type (`entity_type`). `actions` lists the allowed operations.",{"_3550":631,"_30605":530,"_21201":51903,"_5":14582,"_27821":51617,"_3006":51904},[],"`direct_grants` limits the rule to concrete identifiers. The value `*` covers all instances of the type. A superadministrator policy uses wildcards in schema, entity, actions and grants; a least-privilege policy should avoid them whenever possible.",{"_3550":632,"_30605":530,"_21201":51906,"_5":14582,"_27821":51621,"_3006":51907},[],"Rules can follow relations declared between entities. For example, the schema knows the relation of a certificate to its issuing CA, of a device to its DMS and of a certificate to the KMS key that stores its private key, so a grant on the key also covers the certificates that use it. A policy can grant access to a parent resource and propagate selected actions to its related resources.",{"_3550":633,"_30605":530,"_21201":51909,"_5":14582,"_27821":51621,"_3006":51910},[],"This lets you express models like \"can operate the devices of this DMS\" without maintaining an individual list of every device. When a resource is added under that relation, it inherits the scope planned by the policy.",{"_3550":634,"_30605":530,"_21201":51912,"_5":14582,"_27821":51621,"_3006":51913},[],"The data model shows how the resources used in entity rules are connected.",{"_3550":635,"_30605":530,"_21201":51915,"_5":14582,"_27821":51621,"_3006":51916},[],"A rule can only follow relations that the data schema declares between its two entities. You can reference the relation by its name or by its foreign-key column — both spellings are equivalent, and it is the schema that decides which column the query uses. When you save a policy, `authz` checks every relation against the loaded schemas: one that no schema declares, or one pointing at an entity that is not loaded, is rejected at that moment.",{"_3550":636,"_30605":530,"_21201":51918,"_5":14582,"_27821":51621,"_3006":51919},[],"Policies stored before this validation may still carry relations the schemas do not declare. Such a relation grants nothing: `authz` logs a warning, `skipping relation that grants nothing`, naming the policy and the relation, and continues evaluating the rest of the policy. The reference is always resolved against the schema before any query is built, so an undeclared relation can never alter it. If inherited access narrows after an upgrade, check the `authz` logs for this warning and correct the relation of the affected policy.",{"_3550":637,"_30605":530,"_21201":51921,"_5":14582,"_27821":51625,"_3006":51922},[],"`column_filters` applies conditions to columns the schema has declared filterable. All filters of the same rule are combined with AND.",{"_3550":638,"_30605":530,"_21201":51924,"_5":14582,"_27821":51625,"_3006":51925},[],"For example, this rule allows reading active certificates issued by a specific CA:",{"_3550":639,"_30605":530,"_21201":51927,"_5":14582,"_27821":51625,"_3006":51928},[],"The available operators are `eq`, `neq`, `gt`, `gte`, `lt`, `lte`, `in` and `like`. Use comparisons consistent with the column type: `like` for text, ordering comparisons for numbers or dates and `in` when there is a collection of accepted values.",{"_3550":640,"_30605":530,"_21201":51930,"_5":14582,"_27821":51629,"_3006":51931},[],"HTTP rules do not point directly at tables. They reference a route schema and grant its logical actions. Job Manager's policies are an example: they distinguish reading, creating, updating and deleting workflows or jobs.",{"_3550":641,"_30605":530,"_21201":51933,"_5":14582,"_27821":51629,"_3006":51934},[],"Some routes also compare a request value — taken from the path, query, header or JSON body — with a normalized attribute of the principal. This way you can verify that a device only queries jobs addressed to its own `client_id`.",{"_3550":642,"_30605":530,"_21201":51936,"_5":14582,"_27821":51629,"_3006":51937},[],"Normalized attributes decouple the policy from the authentication mechanism. `subject_attribute_mappings` can derive, for example, `device_id` from `oidc.claim.device_id` or from `x509.subject.cn`. The rule consumes `device_id` in both cases.",{"_3550":643,"_30605":530,"_21201":51939,"_5":14582,"_27821":51629,"_3006":51940},[],"An HTTP rule can also pin a granted action to a literal value carried by the request itself through `param_constraints`. It extracts the value with the same sources as route constraints — `path_regex_group`, `query`, `header` or `json_body` — but compares it against an `equals` literal written into the policy rather than against a subject attribute. The grant then depends only on the request, not on who holds the policy:",{"_3550":644,"_30605":530,"_21201":51942,"_5":14582,"_27821":51629,"_3006":51943},[],"Combined with a schema route such as `^/api/mysvc/system/([^/]+)/info$`, this grants `GET /api/mysvc/system/1/info` and denies the same call for system `2`, regardless of the principal's attributes. The same mechanism pins query parameters, headers or JSON body fields, for example `{ \"source\": \"query\", \"name\": \"tenant_id\" }` with `\"equals\": \"1\"` to accept only requests carrying `?tenant_id=1`.",{"_3550":645,"_30605":530,"_21201":51945,"_5":14582,"_27821":51629,"_3006":51946},[],"Note that:",{"_3550":646,"_30605":530,"_21201":51948,"_5":14582,"_27821":51629,"_3006":51949},[],"`action` must be one of the actions granted by the rule; `equals` is required; `path_regex_group` needs an `index` greater than zero, `query` and `header` need a `name`, and `json_body` needs a `path` such as `$.tenant_id`.",{"_3550":647,"_30605":530,"_21201":51951,"_5":14582,"_27821":51629,"_3006":51952},[],"`param_constraints` are not cross-checked against the schema when the policy is loaded. A reference the route cannot satisfy — for instance a `path_regex_group` on a route without capture groups — simply never matches, and the request is denied.",{"_3550":648,"_30605":530,"_21201":51954,"_5":14582,"_27821":51629,"_3006":51955},[],"Several `param_constraints` for the same action combine with AND. A rule without them keeps the usual behavior: the action is granted wherever the route matches and the subject constraints pass.",{"_3550":649,"_30605":530,"_21201":51957,"_5":14582,"_27821":51633,"_3006":51958},[],"The `authz` preload installs reusable policies for the main domains. Among them are:",{"_3550":650,"_30605":530,"_21201":51960,"_5":14582,"_27821":51633,"_3006":51961},[],"full and read-only access to certificates and authorities;",{"_3550":651,"_30605":530,"_21201":51963,"_5":14582,"_27821":51633,"_3006":51964},[],"full and read-only access to the KMS;",{"_3550":652,"_30605":530,"_21201":51966,"_5":14582,"_27821":51633,"_3006":51967},[],"full and read-only access to Device Manager, DMS Manager, Validation Authority and alerts;",{"_3550":653,"_30605":530,"_21201":51969,"_5":14582,"_27821":51633,"_3006":51970},[],"an `Auditor` policy with PKI read access and authorization visibility;",{"_3550":654,"_30605":530,"_21201":51972,"_5":14582,"_27821":51633,"_3006":51973},[],"console access;",{"_3550":655,"_30605":530,"_21201":51975,"_5":14582,"_27821":51633,"_3006":51976},[],"administration and observation policies for the Job Manager NBI and SBI APIs;",{"_3550":656,"_30605":530,"_21201":51978,"_5":14582,"_27821":51633,"_3006":51979},[],"`SUPER ADMIN`, which grants all actions over the `authz` and `pki` domains.",{"_3550":657,"_30605":530,"_21201":51981,"_5":14582,"_27821":51633,"_3006":51982},[],"Start with these policies before creating others. If none reflects the boundary you need, create a specific, small policy instead of copying `SUPER ADMIN` and informally removing permissions.",{"_3550":658,"_30605":530,"_21201":51984,"_5":14582,"_27821":51637,"_3006":51985},[],"An installation without a principal matching your identity is left with nobody able to administer authorization. Configure the IdP and the bootstrap before exposing the platform.",{"_3550":659,"_30605":530,"_21201":51987,"_5":14582,"_27821":51637,"_3006":51988},[],"The chart includes a bootstrap principal that looks for the OIDC role `pki-admin` in `realm_access.roles`. It grants it `SUPER ADMIN` and, when Job Manager is enabled, the administrative policy of its NBI API.",{"_3550":660,"_30605":530,"_21201":51990,"_5":14582,"_27821":51637,"_3006":51991},[],"The pre-install and pre-upgrade Helm Job runs the `authz` migrations, preloads the policies and creates the bootstrap principals before the services start. If the principal already exists, it does not replace it: it only adds the configured grants that are still missing. You can keep the entry in `values.yaml` across upgrades.",{"_3550":661,"_30605":530,"_21201":51993,"_5":14582,"_27821":51640,"_3006":51994},[],"Create the role or group you will use to administer Lamassu. Assign it to at least two controlled human identities. If your provider does not use `realm_access.roles`, adapt the claim path in both the frontend and `auth_config.claims`.",{"_3550":662,"_30605":530,"_21201":51996,"_5":14582,"_27821":51644,"_3006":51997},[],"`authz` validates every token against `services.authz.jwkUrl`, which is fetched from the `authz` pod. The Gateway does not validate tokens itself: Lamassu services authorize each request through `authz`, and routes labeled `auth=external`, such as the Job Manager ones, are checked by the Gateway through `authz` when `auth.externalAuthorization` is enabled. The endpoint must serve the keys of the issuer configured in `auth.oidc.frontend.authority`.",{"_3550":663,"_30605":530,"_21201":51999,"_5":14582,"_27821":51644,"_3006":52000},[],"Releases upgraded from 3.8.0 must remove `auth.oidc.apiGateway` and `auth.authorization`, which the 4.0.0 chart rejects. See 3.8.0 to 4.0.0.",{"_3550":664,"_30605":530,"_21201":52002,"_5":14582,"_27821":51648,"_3006":52003},[],"Sign in with an identity holding `pki-admin`. Confirm it can access authorization administration and perform a non-destructive read operation.",{"_3550":665,"_30605":530,"_21201":52005,"_5":14582,"_27821":51652,"_3006":52006},[],"Use a second user without the role and confirm the same operation is denied. This test catches misread claims, overly broad policies and accidental `failOpen` configurations.",{"_3550":666,"_30605":530,"_21201":52008,"_5":14582,"_27821":51656,"_3006":52009},[],"Create operational principals with narrower policies. Reserve `pki-admin` for authorization administration and recovery, not for daily work.",{"_3550":667,"_30605":530,"_21201":52011,"_5":14582,"_27821":51660,"_3006":52012},[],"Fastlane installs a Keycloak realm for the lab and creates the user `lamassu` with the temporary password `lamassu`, the role `pki-admin` and a mandatory password change. Its bootstrap principal matches through `preferred_username=lamassu`.",{"_3550":668,"_30605":530,"_21201":52014,"_5":14582,"_27821":51660,"_3006":52015},[],"Change the password on first login. Do not reuse the Fastlane user, password or IdP as a production design.",{"_3550":669,"_30605":530,"_21201":52017,"_5":14582,"_27821":51664,"_3006":52018},[],"Avoid reproducing your company's internal structure with dozens of nearly identical policies. Start from the responsibilities that actually need access:",{"_3550":670,"_30605":530,"_21201":52020,"_5":14582,"_27821":51664,"_3006":52021},[],"**Authorization administration**: manages principals, policies and grants. It should belong to a small, separate group.",{"_3550":671,"_30605":530,"_21201":52023,"_5":14582,"_27821":51664,"_3006":52024},[],"**PKI operation**: administers CAs, profiles and certificates, but not necessarily who gets access.",{"_3550":672,"_30605":530,"_21201":52026,"_5":14582,"_27821":51664,"_3006":52027},[],"**Device registration**: operates devices and DMSs without receiving permissions over keys or authorization configuration.",{"_3550":673,"_30605":530,"_21201":52029,"_5":14582,"_27821":51664,"_3006":52030},[],"**Audit**: reviews configuration and activity without creating, modifying, signing, revoking or deleting.",{"_3550":674,"_30605":530,"_21201":52032,"_5":14582,"_27821":51664,"_3006":52033},[],"**Automation**: uses a technical account or a separate certificate, with permissions limited to the flow and resources it controls.",{"_3550":675,"_30605":530,"_21201":52035,"_5":14582,"_27821":51664,"_3006":52036},[],"For each role, separate \"view\" from \"change\", limit resources through grants, relations or attributes and avoid `*` unless the role must automatically cover future actions.",{"_3550":676,"_30605":530,"_21201":52038,"_5":14582,"_27821":51664,"_3006":52039},[],"A rule with `actions: [\"*\"]` expands to every action defined by the schema. When a new version adds an action, a wildcard policy may start granting it. Review these policies on every upgrade.",{"_3550":677,"_30605":530,"_21201":52041,"_5":14582,"_27821":51668,"_3006":52042},[],"To revoke access immediately, disable the principal or revoke its grants. Disabling a principal keeps its configuration and associations for investigation or restoration, but it stops taking part in matching.",{"_3550":678,"_30605":530,"_21201":52044,"_5":14582,"_27821":51668,"_3006":52045},[],"Deleting a role or group in the IdP prevents new tokens from containing the claim, but an already-issued token may remain valid until it expires. If removal is urgent, combine the IdP change with disabling the principal in Lamassu and revoking sessions or tokens at the provider.",{"_3550":679,"_30605":530,"_21201":52047,"_5":14582,"_27821":51668,"_3006":52048},[],"When you edit a shared policy, remember the change affects all its principals. To test a new scope, create a separate policy, grant it to a test identity and validate allowed and denied operations before replacing the old one.",{"_3550":680,"_30605":530,"_21201":52050,"_5":14582,"_27821":51672,"_3006":52051},[],"Keep `failOpen: false` unless a documented risk assessment justifies otherwise.",{"_3550":681,"_30605":530,"_21201":52053,"_5":14582,"_27821":51672,"_3006":52054},[],"Use groups or stable roles for people and independent identities for automations.",{"_3550":682,"_30605":530,"_21201":52056,"_5":14582,"_27821":51672,"_3006":52057},[],"Keep at least two recovery administrators and test their access periodically.",{"_3550":683,"_30605":530,"_21201":52059,"_5":14582,"_27821":51672,"_3006":52060},[],"Review active principals, their matches and their grants after IdP changes.",{"_3550":684,"_30605":530,"_21201":52062,"_5":14582,"_27821":51672,"_3006":52063},[],"Search for wildcards in policies before upgrading Lamassu.",{"_3550":685,"_30605":530,"_21201":52065,"_5":14582,"_27821":51672,"_3006":52066},[],"Review `skip_authz` routes and `default_action` settings in HTTP schemas when integrating or upgrading a service.",{"_3550":686,"_30605":530,"_21201":52068,"_5":14582,"_27821":51672,"_3006":52069},[],"Always test one allowed and one denied operation for each role.",{"_3550":687,"_30605":530,"_21201":52071,"_5":14582,"_27821":51672,"_3006":52072},[],"Correlate changes to principals, policies and grants with the audit logs.",{"_3550":688,"_30605":530,"_21201":52074,"_5":14582,"_27821":51680,"_3006":52075},[],"Authentication failed before permissions were evaluated. Check the JWT signature and expiration, issuer, audience and the availability of the JWKS configured in the Gateway. For X.509, check that the client certificate reaches the point that extracts the credential.",{"_3550":689,"_30605":530,"_21201":52077,"_5":14582,"_27821":51684,"_3006":52078},[],"The credential could be processed but did not produce a positive authorization. Review in this order:",{"_3550":690,"_30605":530,"_21201":52080,"_5":14582,"_27821":51684,"_3006":52081},[],"that an active principal of the correct type exists;",{"_3550":691,"_30605":530,"_21201":52083,"_5":14582,"_27821":51684,"_3006":52084},[],"that the claim paths and values match the real token exactly;",{"_3550":692,"_30605":530,"_21201":52086,"_5":14582,"_27821":51684,"_3006":52087},[],"that all of the principal's conditions hold;",{"_3550":693,"_30605":530,"_21201":52089,"_5":14582,"_27821":51684,"_3006":52090},[],"that the principal has the expected policy granted;",{"_3550":694,"_30605":530,"_21201":52092,"_5":14582,"_27821":51684,"_3006":52093},[],"that the policy includes the action and the requested resource type or route;",{"_3550":695,"_30605":530,"_21201":52095,"_5":14582,"_27821":51684,"_3006":52096},[],"that the identifier, relation, column filter or HTTP constraint includes the real resource.",{"_3550":696,"_30605":530,"_21201":52098,"_5":14582,"_27821":51684,"_3006":52099},[],"In the `authz` logs, an external endpoint decision includes `allowed`, `reason`, `matched_principals`, `evaluated_policy_ids`, `matched_policy_id` and the status code. These fields let you separate a matching failure from a permissions failure. With OpenTelemetry tracing enabled, a request that reaches the policy engine produces an `engine.CheckHTTPRequest` span whose attributes record `authz.allowed`, the matched policy and the matched principal. Correlation with the Gateway trace requires trace context to be propagated to authz.",{"_3550":697,"_30605":530,"_21201":52101,"_5":14582,"_27821":51684,"_3006":52102},[],"If a policy that relied on inherited access stopped granting it after an upgrade, look in the `authz` logs for `skipping relation that grants nothing`: the warning names the policy and the relation the schemas no longer declare. Correct that policy's relation so it matches the current schemas.",{"_3550":698,"_30605":530,"_21201":52104,"_5":14582,"_27821":51688,"_3006":52105},[],"Check that the bootstrap principal was created and that the policies were preloaded by the migration Job. Also verify that `services.authz.jwkUrl` is reachable from the `authz` pod; do not assume that a URL accessible from the browser also works inside the cluster.",{"_3550":699,"_30605":530,"_21201":52107,"_5":14582,"_27821":51692,"_3006":52108},[],"The path may be covered by a schema-level decision rather than by a policy: routes marked `skip_authz` allow any identity that matches an active principal, and a request under a `base_paths` prefix whose schema sets `default_action: allow` is likewise allowed without consulting policies. Confirm which of the two applies before looking for missing or misassigned grants.",{"_3550":700,"_30605":530,"_21201":52110,"_5":14582,"_27821":51696,"_3006":52111},[],"This is the expected behavior with `failOpen: false`. Restore the service, its PostgreSQL connection and its JWKS connectivity. Do not temporarily switch to `failOpen: true` without accepting that protected routes could become accessible without an authorization decision.",{"_3550":701,"_30605":530,"_21201":52113,"_5":14582,"_27821":51696,"_3006":52114},[],"Continue with Audit logs to investigate configuration changes or with Troubleshooting to diagnose the deployment.",{"_3550":702,"_30605":702,"_5":14934,"_3006":52116,"_30943":52117,"_21201":52118,"_27821":702},"Alerts and subscriptions",[49963,51438,51439],[],{"_3550":703,"_30605":702,"_21201":52120,"_5":14582,"_27821":702,"_3006":52121},[],"Send PKI events to people and external systems.",{"_3550":704,"_30605":702,"_5":30940,"_21201":52123,"_27821":52124,"_3006":52125},[],"/docs/platform/administration/alerts#how-it-works","How it works",{"_3550":705,"_30605":702,"_5":30940,"_21201":52127,"_27821":52128,"_3006":52129},[],"/docs/platform/administration/alerts#available-channels","Available channels",{"_3550":706,"_30605":702,"_5":30940,"_21201":52131,"_27821":52132,"_3006":52133},[],"/docs/platform/administration/alerts#create-a-subscription","Create a subscription",{"_3550":707,"_30605":702,"_5":30940,"_21201":52135,"_27821":52136,"_3006":52137},[],"/docs/platform/administration/alerts#choose-the-event","Choose the event",{"_3550":708,"_30605":702,"_5":30940,"_21201":52139,"_27821":52140,"_3006":52141},[],"/docs/platform/administration/alerts#configure-the-destination","Configure the destination",{"_3550":709,"_30605":702,"_5":30940,"_21201":52143,"_27821":52144,"_3006":52145},[],"/docs/platform/administration/alerts#limit-the-notifications","Limit the notifications",{"_3550":710,"_30605":702,"_5":30940,"_21201":52147,"_27821":52148,"_3006":52149},[],"/docs/platform/administration/alerts#review-and-activate","Review and activate",{"_3550":711,"_30605":702,"_5":30940,"_21201":52151,"_27821":52152,"_3006":52153},[],"/docs/platform/administration/alerts#configure-the-webhook-http-client","Configure the webhook HTTP client",{"_3550":712,"_30605":702,"_5":30940,"_21201":52155,"_27821":52156,"_3006":52157},[],"/docs/platform/administration/alerts#webhook-delivery-rules","Webhook delivery rules",{"_3550":713,"_30605":702,"_5":30940,"_21201":52159,"_27821":52160,"_3006":52161},[],"/docs/platform/administration/alerts#manage-a-subscription","Manage a subscription",{"_3550":714,"_30605":702,"_5":30940,"_21201":52163,"_27821":52164,"_3006":52165},[],"/docs/platform/administration/alerts#event-families","Event families",{"_3550":715,"_30605":702,"_21201":52167,"_5":14582,"_27821":702,"_3006":52168},[],"Subscriptions turn Lamassu events into actionable notifications. You can alert a team, feed an incident system or trigger an automation when a CA, certificate or device changes.",{"_3550":716,"_30605":702,"_21201":52170,"_5":14582,"_27821":52124,"_3006":52171},[],"A service publishes a domain event.",{"_3550":717,"_30605":702,"_21201":52173,"_5":14582,"_27821":52124,"_3006":52174},[],"Lamassu evaluates the subscriptions associated with that event type.",{"_3550":718,"_30605":702,"_21201":52176,"_5":14582,"_27821":52124,"_3006":52177},[],"Each subscription's filter decides whether it should be notified.",{"_3550":719,"_30605":702,"_21201":52179,"_5":14582,"_27821":52124,"_3006":52180},[],"Lamassu delivers the event to the configured channel.",{"_3550":720,"_30605":702,"_21201":52182,"_5":14582,"_27821":52124,"_3006":52183},[],"The event inventory shows when each type was last observed, how many times it has occurred and how many subscriptions it has. You can expand an event to inspect an example of its JSON payload before creating the filter.",{"_3550":721,"_30605":702,"_21201":52185,"_5":14582,"_27821":52128,"_3006":52186},[],"**Email** sends alerts to a person or an operational list. It only requires the destination address. Event content is rendered as HTML-escaped text, never as markup.",{"_3550":722,"_30605":702,"_21201":52188,"_5":14582,"_27821":52128,"_3006":52189},[],"**Microsoft Teams** posts the notification to a channel through its webhook URL.",{"_3550":723,"_30605":702,"_21201":52191,"_5":14582,"_27821":52128,"_3006":52192},[],"**Webhook** delivers the event to an automation, SIEM or incident system via `POST` or `PUT`.",{"_3550":724,"_30605":702,"_21201":52194,"_5":14582,"_27821":52128,"_3006":52195},[],"The Microsoft Teams and Webhook channels accept an optional `http_client` block that authenticates the call to the receiver. `auth_mode` selects `noauth` (the default), `apikey`, `jwt` or `mtls`; each mode requires its own options:",{"_3550":725,"_30605":702,"_21201":52197,"_5":14582,"_27821":52128,"_3006":52198},[],"`apikey_options` requires `header` and `key`.",{"_3550":726,"_30605":702,"_21201":52200,"_5":14582,"_27821":52128,"_3006":52201},[],"`jwt_options` requires `oidc_client_id`, `oidc_client_secret` and an absolute `http` or `https` `oidc_well_known`.",{"_3550":727,"_30605":702,"_21201":52203,"_5":14582,"_27821":52128,"_3006":52204},[],"`mtls_options` requires `cert_content` and `key_content` as Base64-encoded PEM, like certificates elsewhere in the API; plain PEM is also accepted. Values that reference files on the server are rejected, and the pair must decode to a matching certificate and private key.",{"_3550":728,"_30605":702,"_21201":52206,"_5":14582,"_27821":52128,"_3006":52207},[],"The alerts API reference documents the full `http_client` schema.",{"_3550":729,"_30605":702,"_21201":52209,"_5":14582,"_27821":52136,"_3006":52210},[],"Open **Alerts**, locate the event type and select **Subscribe**. Review the latest JSON example to identify the fields you will need to filter on.",{"_3550":730,"_30605":702,"_21201":52212,"_5":14582,"_27821":52140,"_3006":52213},[],"Select Email, Microsoft Teams or Webhook and enter the channel details.",{"_3550":731,"_30605":702,"_21201":52215,"_5":14582,"_27821":52144,"_3006":52216},[],"Add a filter if you don't want to receive every instance of the event.",{"_3550":732,"_30605":702,"_21201":52218,"_5":14582,"_27821":52144,"_3006":52219},[],"**None** notifies all instances of the event.",{"_3550":733,"_30605":702,"_21201":52221,"_5":14582,"_27821":52144,"_3006":52222},[],"**JSON Path** evaluates one or more specific fields.",{"_3550":734,"_30605":702,"_21201":52224,"_5":14582,"_27821":52144,"_3006":52225},[],"**JSON Schema** accepts only payloads with a particular structure.",{"_3550":735,"_30605":702,"_21201":52227,"_5":14582,"_27821":52144,"_3006":52228},[],"**JavaScript** lets you express custom logic. Each filter runs for at most 100 milliseconds; a filter that exceeds this limit fails the condition and the notification is skipped with the error `javascript filter execution timed out`.",{"_3550":736,"_30605":702,"_21201":52230,"_5":14582,"_27821":52144,"_3006":52231},[],"For example, `function (event) { return event.data.status == \"NO_IDENTITY\"; }` limits a subscription to devices without an identity.",{"_3550":737,"_30605":702,"_21201":52233,"_5":14582,"_27821":52144,"_3006":52234},[],"The console evaluates the filter against the JSON shown in the **Input Event** editor, which is prefilled with the latest event, and reports whether it matches. For JSON Path and JavaScript filters, it shows **The filter matches this Cloud Event** or **The filter does not match this Cloud Event**. JSON Path expressions are evaluated against the full Cloud Event, so the default `$.data` selects the event's `data` field, and the expression must start with `$`.",{"_3550":738,"_30605":702,"_21201":52236,"_5":14582,"_27821":52148,"_3006":52237},[],"Check the event, channel and filter in the summary. Select **Confirm Subscription** to start delivery.",{"_3550":739,"_30605":702,"_21201":52239,"_5":14582,"_27821":52152,"_3006":52240},[],"The Webhook and Microsoft Teams channels show this configuration in the subscribe form, at the channel step, and again when editing a subscription; Email does not use it. The fields map to the optional `http_client` block described above:",{"_3550":740,"_30605":702,"_21201":52242,"_5":14582,"_27821":52152,"_3006":52243},[],"**Log Level** selects `debug`, `info`, `warn` or `error`; `info` is the default.",{"_3550":741,"_30605":702,"_21201":52245,"_5":14582,"_27821":52152,"_3006":52246},[],"**Call Timeout** defaults to 10 seconds. The console rejects a value above 30 seconds with `Webhook timeout must be at most 30s.`; the API clamps the same value to the cap instead (see Calls are bounded).",{"_3550":742,"_30605":702,"_21201":52248,"_5":14582,"_27821":52152,"_3006":52249},[],"There is no TLS-verification switch for these channels, because the service always verifies the receiver certificate (see TLS is always verified).",{"_3550":743,"_30605":702,"_21201":52251,"_5":14582,"_27821":52152,"_3006":52252},[],"**HTTP Authentication** selects `No Authentication` (the default), `API Key` (API key value and Header Name, `X-API-Key` by default), `OIDC Client Credentials` (Client ID, Client Secret and Well-Known URL) or `Mutual TLS` (Client Certificate and Client Private Key pasted as PEM). A stored private key stays hidden until you select **Show**.",{"_3550":744,"_30605":702,"_21201":52254,"_5":14582,"_27821":52152,"_3006":52255},[],"A `http://` URL shows the console warning `Unencrypted HTTP connection` (see the Credentials over http\\:// callout below).",{"_3550":745,"_30605":702,"_21201":52257,"_5":14582,"_27821":52152,"_3006":52258},[],"The form validates inline against the same delivery rules: the webhook URL and the OIDC Well-Known URL must be absolute `http` or `https` URLs, an API-key header may not use a reserved name, and the mTLS certificate and key must be PEM content, not file paths.",{"_3550":746,"_30605":702,"_21201":52260,"_5":14582,"_27821":52152,"_3006":52261},[],"The summary in the Confirm step shows the authentication as `None`, `OIDC client credentials`, `API key` or `Mutual TLS`. The subscription details show the authentication, the API key header name (never the value), the OIDC issuer URL, mTLS as `Configured` and a fixed `TLS verification: Verified` row. The API key, client secret and private key are not shown in the subscription details.",{"_3550":747,"_30605":702,"_21201":52263,"_5":14582,"_27821":52156,"_3006":52264},[],"Notifications delivered through the Microsoft Teams and Webhook channels follow a fixed HTTP policy:",{"_3550":748,"_30605":702,"_21201":52266,"_5":14582,"_27821":52156,"_3006":52267},[],"**TLS is always verified.** The receiver certificate is checked against the system trust store. `insecure_skip_verify` is enforced as `false` — including when it is set to `true` — so self-signed or otherwise untrusted receivers fail delivery.",{"_3550":749,"_30605":702,"_21201":52269,"_5":14582,"_27821":52156,"_3006":52270},[],"**Redirects are not followed.** A `3xx` response fails with `unexpected status code: <n>: redirects are not followed`. Configure `webhook_url` with the final absolute `http` or `https` URL: an `http://` address that an ingress redirects to `https://` stops working.",{"_3550":750,"_30605":702,"_21201":52272,"_5":14582,"_27821":52156,"_3006":52273},[],"**Calls are bounded.** A call defaults to a 10 second timeout; a configured `call_timeout` is capped at 30 seconds. Values above the cap are clamped, not rejected.",{"_3550":751,"_30605":702,"_21201":52275,"_5":14582,"_27821":52156,"_3006":52276},[],"**The response body is ignored.** Delivery checks the status code only, so the receiver may answer with any body.",{"_3550":752,"_30605":702,"_21201":52278,"_5":14582,"_27821":52156,"_3006":52279},[],"**API-key headers are restricted.** A custom `apikey_options.header` may not use names that the platform or receiving services trust — for example `X-Principal-Id`, `X-Request-Id`, `Host`, `Content-Type` or `Forwarded` — and no name may start with `X-Forwarded-`, `X-Envoy-` or `X-Lms-`. Comparisons are case-insensitive.",{"_3550":753,"_30605":702,"_21201":52281,"_5":14582,"_27821":52156,"_3006":52282},[],"**Invalid configurations are rejected at subscribe time.** A channel configuration that would fail on every delivery returns HTTP 400 with a body that starts with `struct validation error:`, and the subscription is not created.",{"_3550":754,"_30605":702,"_21201":52284,"_5":14582,"_27821":52156,"_3006":52285},[],"Credentials are sent regardless of the URL scheme. With an `http://` `webhook_url`, the API key or bearer token travels in cleartext and mTLS has no effect. Prefer `https://` for `webhook_url`, `oidc_well_known` and the token endpoint it advertises.",{"_3550":755,"_30605":702,"_21201":52287,"_5":14582,"_27821":52160,"_3006":52288},[],"Open an existing subscription to review its destination and filter, modify the configuration or select **Unsubscribe**. Remove subscriptions that no longer have an operational owner to avoid ignored deliveries or stale endpoints.",{"_3550":756,"_30605":702,"_21201":52290,"_5":14582,"_27821":52160,"_3006":52291},[],"Subscriptions created with older console versions may store the webhook target under `url` and `method` instead of `webhook_url` and `webhook_method`. The service delivers only through `webhook_url` and `webhook_method`, so such a subscription does not deliver even though the subscription details show the stored target. Open the subscription and save it again: the edit form prefills the stored target, and saving rewrites the channel configuration in the current layout.",{"_3550":757,"_30605":702,"_21201":52293,"_5":14582,"_27821":52164,"_3006":52294},[],"**Authorities:** `ca.create`, `ca.import`, `ca.reissue` and `ca.delete`.",{"_3550":758,"_30605":702,"_21201":52296,"_5":14582,"_27821":52164,"_3006":52297},[],"**Certificates:** `ca.sign.certificate` and `certificate.delete`.",{"_3550":759,"_30605":702,"_21201":52299,"_5":14582,"_27821":52164,"_3006":52300},[],"**Profiles:** `profile.issuance.create`, `profile.issuance.update` and `profile.issuance.delete`.",{"_3550":760,"_30605":702,"_21201":52302,"_5":14582,"_27821":52164,"_3006":52303},[],"**Enrollment:** `dms.create`, `dms.update`, `dms.enroll` and `dms.reenroll`.",{"_3550":761,"_30605":702,"_21201":52305,"_5":14582,"_27821":52164,"_3006":52306},[],"**Devices:** `device.create`, `device.identity.update` and `device.status.update`.",{"_3550":762,"_30605":702,"_21201":52308,"_5":14582,"_27821":52164,"_3006":52309},[],"**Validation:** `va.role.crl.create`, `va.crl-settings.init`, `va.crl-settings.update`, `va.crl-settings.finalize`, `va.crl-settings.archive` and `va.crl-settings.delete`.",{"_3550":763,"_30605":702,"_21201":52311,"_5":14582,"_27821":52164,"_3006":52312},[],"**Keys:** `kms.create`, `kms.import`, `kms.sign` and `kms.delete`.",{"_3550":764,"_30605":702,"_21201":52314,"_5":14582,"_27821":52164,"_3006":52315},[],"Use the catalog shown in the console as the source for the types available in your deployed version.",{"_3550":765,"_30605":702,"_21201":52317,"_5":14582,"_27821":52164,"_3006":52318},[],"Since 4.0.0, `va.crl-settings.init` and `va.crl-settings.update` carry the CRL settings of a CA (`ca_id`) and replace `va.role.crl.init` and `va.role.update`. The upgrade migration renames the types of existing subscriptions automatically, but it does not rewrite their conditions: review filters that read the old payload or the old `crl/<ski>` subject, including filters for `va.role.crl.create` (see 3.8.0 to 4.0.0).",{"_3550":766,"_30605":702,"_21201":52320,"_5":14582,"_27821":52164,"_3006":52321},[],"The VA also publishes `va.crl-settings.finalize` when a CA is revoked permanently or expires, `va.crl-settings.archive` when the CA is deleted, and `va.crl-settings.delete` when archived settings are removed.",{"_3550":767,"_30605":767,"_5":14934,"_3006":52323,"_30943":52324,"_21201":52325,"_27821":767},"Audit logs",[49963,51438,51439],[],{"_3550":768,"_30605":767,"_21201":52327,"_5":14582,"_27821":767,"_3006":52328},[],"Understand which audit events Lamassu generates and how to turn them into a durable trail.",{"_3550":769,"_30605":767,"_5":30940,"_21201":52330,"_27821":52331,"_3006":52332},[],"/docs/platform/administration/audit-logs#what-an-event-contains","What an event contains",{"_3550":770,"_30605":767,"_5":30940,"_21201":52334,"_27821":52335,"_3006":52336},[],"/docs/platform/administration/audit-logs#coverage","Coverage",{"_3550":771,"_30605":767,"_5":30940,"_21201":52338,"_27821":52339,"_3006":52340},[],"/docs/platform/administration/audit-logs#publication-and-persistence","Publication and persistence",{"_3550":772,"_30605":767,"_5":30940,"_21201":52342,"_27821":52343,"_3006":52344},[],"/docs/platform/administration/audit-logs#sensitive-data","Sensitive data",{"_3550":773,"_30605":767,"_5":30940,"_21201":52346,"_27821":52347,"_3006":52348},[],"/docs/platform/administration/audit-logs#a-reproducible-investigation","A reproducible investigation",{"_3550":774,"_30605":767,"_5":30940,"_21201":52350,"_27821":52351,"_3006":52352},[],"/docs/platform/administration/audit-logs#bound-the-interval","Bound the interval",{"_3550":775,"_30605":767,"_5":30940,"_21201":52354,"_27821":52355,"_3006":52356},[],"/docs/platform/administration/audit-logs#identify-the-operation","Identify the operation",{"_3550":776,"_30605":767,"_5":30940,"_21201":52358,"_27821":52359,"_3006":52360},[],"/docs/platform/administration/audit-logs#attribute-the-principal","Attribute the principal",{"_3550":777,"_30605":767,"_5":30940,"_21201":52362,"_27821":52363,"_3006":52364},[],"/docs/platform/administration/audit-logs#compare-intent-and-result","Compare intent and result",{"_3550":778,"_30605":767,"_5":30940,"_21201":52366,"_27821":52367,"_3006":52368},[],"/docs/platform/administration/audit-logs#follow-the-effect","Follow the effect",{"_3550":779,"_30605":767,"_5":30940,"_21201":52370,"_27821":52371,"_3006":52372},[],"/docs/platform/administration/audit-logs#periodic-verification","Periodic verification",{"_3550":780,"_30605":767,"_21201":52374,"_5":14582,"_27821":767,"_3006":52375},[],"Lamassu instruments the mutable operations of its services with audit events. Each event describes the operation, the principals that matched, the input, the result and whether it ended in error.",{"_3550":781,"_30605":767,"_21201":52377,"_5":14582,"_27821":52331,"_3006":52378},[],"The audit body includes:",{"_3550":782,"_30605":767,"_21201":52380,"_5":14582,"_27821":52331,"_3006":52381},[],"input: data received by the operation;",{"_3550":783,"_30605":767,"_21201":52383,"_5":14582,"_27821":52331,"_3006":52384},[],"has\\_error: whether the service returned an error;",{"_3550":784,"_30605":767,"_21201":52386,"_5":14582,"_27821":52331,"_3006":52387},[],"output: produced result or error message;",{"_3550":785,"_30605":767,"_21201":52389,"_5":14582,"_27821":52331,"_3006":52390},[],"principals: identifiers of the principals that matched the request.",{"_3550":786,"_30605":767,"_21201":52392,"_5":14582,"_27821":52331,"_3006":52393},[],"Successful operations use a type prefixed with audit.. Failures publish the operation type suffixed with .error. The CloudEvents event additionally adds source, identifier, date and type.",{"_3550":787,"_30605":767,"_21201":52395,"_5":14582,"_27821":52331,"_3006":52396},[],"The middlewares publish the record after executing the operation, whether it succeeded or returned an error. This lets you investigate attempts as well as confirmed changes.",{"_3550":788,"_30605":767,"_21201":52398,"_5":14582,"_27821":52335,"_3006":52399},[],"The backend applies auditing to mutations of:",{"_3550":789,"_30605":767,"_21201":52401,"_5":14582,"_27821":52335,"_3006":52402},[],"authorities, certificates and issuance profiles;",{"_3550":790,"_30605":767,"_21201":52404,"_5":14582,"_27821":52335,"_3006":52405},[],"keys and KMS engines;",{"_3550":791,"_30605":767,"_21201":52407,"_5":14582,"_27821":52335,"_3006":52408},[],"devices and identities;",{"_3550":792,"_30605":767,"_21201":52410,"_5":14582,"_27821":52335,"_3006":52411},[],"DMSs and enrollment operations;",{"_3550":793,"_30605":767,"_21201":52413,"_5":14582,"_27821":52335,"_3006":52414},[],"validation functions and CRL;",{"_3550":794,"_30605":767,"_21201":52416,"_5":14582,"_27821":52335,"_3006":52417},[],"principals, policies and authorization grants.",{"_3550":795,"_30605":767,"_21201":52419,"_5":14582,"_27821":52335,"_3006":52420},[],"Do not confuse these events with domain events. A domain event announces that a resource changed so another component can react; the audit event keeps input, output and principal context for investigation.",{"_3550":796,"_30605":767,"_21201":52422,"_5":14582,"_27821":52339,"_3006":52423},[],"Services publish audit records to the event bus when their PublisherEventBus is enabled. The backend code does not, by itself, implement a queryable, durable audit file.",{"_3550":797,"_30605":767,"_21201":52425,"_5":14582,"_27821":52339,"_3006":52426},[],"If you need retention, search, tamper protection or regulatory export, connect a consumer that persists the events into the system approved by your organization.",{"_3550":798,"_30605":767,"_21201":52428,"_5":14582,"_27821":52339,"_3006":52429},[],"Design the consumer to:",{"_3550":799,"_30605":767,"_21201":52431,"_5":14582,"_27821":52339,"_3006":52432},[],"subscribe to the audit.# types and also to operation types ending in .error;",{"_3550":800,"_30605":767,"_21201":52434,"_5":14582,"_27821":52339,"_3006":52435},[],"keep the complete CloudEvent unmodified;",{"_3550":801,"_30605":767,"_21201":52437,"_5":14582,"_27821":52339,"_3006":52438},[],"record the ingestion time and detect duplicates by ID;",{"_3550":802,"_30605":767,"_21201":52440,"_5":14582,"_27821":52339,"_3006":52441},[],"encrypt in transit and at rest;",{"_3550":803,"_30605":767,"_21201":52443,"_5":14582,"_27821":52339,"_3006":52444},[],"restrict reading and deletion to a role separate from the PKI operator;",{"_3550":804,"_30605":767,"_21201":52446,"_5":14582,"_27821":52339,"_3006":52447},[],"apply an explicit retention and legal hold policy;",{"_3550":805,"_30605":767,"_21201":52449,"_5":14582,"_27821":52339,"_3006":52450},[],"alert if it stops consuming or the pending queue grows.",{"_3550":806,"_30605":767,"_21201":52452,"_5":14582,"_27821":52343,"_3006":52453},[],"The input and output fields can contain subjects, metadata, public material, configuration or error messages. Evaluate their classification before sending them to an external platform.",{"_3550":807,"_30605":767,"_21201":52455,"_5":14582,"_27821":52343,"_3006":52456},[],"Do not log private keys, provider secrets or full tokens in automations around Lamassu. Restrict export and apply redaction at the destination without destroying the fields needed for attribution.",{"_3550":808,"_30605":767,"_21201":52458,"_5":14582,"_27821":52351,"_3006":52459},[],"Start from the reported time and normalize every source to UTC.",{"_3550":809,"_30605":767,"_21201":52461,"_5":14582,"_27821":52355,"_3006":52462},[],"Filter by event type, service source and resource identifier.",{"_3550":810,"_30605":767,"_21201":52464,"_5":14582,"_27821":52359,"_3006":52465},[],"Review principals and correlate them with the OIDC provider or the X.509 identity valid at that moment.",{"_3550":811,"_30605":767,"_21201":52467,"_5":14582,"_27821":52363,"_3006":52468},[],"Contrast input, has\\_error and output. A failed attempt does not mean the resource changed.",{"_3550":812,"_30605":767,"_21201":52470,"_5":14582,"_27821":52367,"_3006":52471},[],"Look for the domain events and service records that share resource and time window. In a CA revocation, include the cascading operations.",{"_3550":813,"_30605":767,"_21201":52473,"_5":14582,"_27821":52371,"_3006":52474},[],"Generate a controlled mutation in a test environment and check that:",{"_3550":814,"_30605":767,"_21201":52476,"_5":14582,"_27821":52371,"_3006":52477},[],"a successful audit event appears;",{"_3550":815,"_30605":767,"_21201":52479,"_5":14582,"_27821":52371,"_3006":52480},[],"the principal matches the identity used;",{"_3550":816,"_30605":767,"_21201":52482,"_5":14582,"_27821":52371,"_3006":52483},[],"the consumer persists it exactly once;",{"_3550":817,"_30605":767,"_21201":52485,"_5":14582,"_27821":52371,"_3006":52486},[],"it can be retrieved by resource, actor and period;",{"_3550":818,"_30605":767,"_21201":52488,"_5":14582,"_27821":52371,"_3006":52489},[],"a consumer outage raises an alert.",{"_3550":819,"_30605":767,"_21201":52491,"_5":14582,"_27821":52371,"_3006":52492},[],"For metrics, traces and technical logs of the deployment, see Troubleshooting. Audit answers \"who tried to change what\"; observability explains how the system behaved.",{"_3550":820,"_30605":820,"_5":14934,"_3006":52494,"_30943":52495,"_21201":52496,"_27821":820},"Platform architecture",[49963,51438],[],{"_3550":821,"_30605":820,"_21201":52498,"_5":14582,"_27821":820,"_3006":52499},[],"Lamassu components and how control, keys, issuance and devices relate.",{"_3550":822,"_30605":820,"_5":30940,"_21201":52501,"_27821":52502,"_3006":52503},[],"/docs/platform/concepts/architecture#control-plane","Control plane",{"_3550":823,"_30605":820,"_5":30940,"_21201":52505,"_27821":52506,"_3006":52507},[],"/docs/platform/concepts/architecture#key-custody-and-cryptographic-operations","Key custody and cryptographic operations",{"_3550":824,"_30605":820,"_5":30940,"_21201":52509,"_27821":52510,"_3006":52511},[],"/docs/platform/concepts/architecture#issuance-and-enrollment","Issuance and enrollment",{"_3550":825,"_30605":820,"_5":30940,"_21201":52513,"_27821":52514,"_3006":52515},[],"/docs/platform/concepts/architecture#status-and-validation","Status and validation",{"_3550":826,"_30605":820,"_5":30940,"_21201":52517,"_27821":52518,"_3006":52519},[],"/docs/platform/concepts/architecture#platform-dependencies","Platform dependencies",{"_3550":827,"_30605":820,"_21201":52521,"_5":14582,"_27821":820,"_3006":52522},[],"Lamassu deploys as a set of independent services. This separation keeps every component from needing direct access to private keys and lets each capability scale according to load.",{"_3550":828,"_30605":820,"_21201":52524,"_5":14582,"_27821":820,"_3006":52525},[],"Switch to the low level to see the internals of the Lamassu platform box (CA, KMS, DMS, Device Manager, VA, Alerts, AWS IoT connector, Job Manager and the console/API), and to medium to see it as a single platform alongside its external dependencies.",{"_3550":829,"_30605":820,"_21201":52527,"_5":14582,"_27821":52502,"_3006":52528},[],"The console and the APIs manage authorities, certificates, DMSs, devices, alerts and configuration. Domain events allow connectors and automations to react to changes without continuously polling the platform.",{"_3550":830,"_30605":820,"_21201":52530,"_5":14582,"_27821":52506,"_3006":52531},[],"The KMS offers a common interface over software engines, PKCS#11 and cloud providers. The selected engine keeps the key or delegates the cryptographic operation without the other services knowing its implementation.",{"_3550":831,"_30605":820,"_21201":52533,"_5":14582,"_27821":52510,"_3006":52534},[],"The CA service issues certificates and maintains the relationship with its authority. The DMS applies the enrollment rules and exposes the EST flows so a device can request or renew an identity.",{"_3550":832,"_30605":820,"_21201":52536,"_5":14582,"_27821":52514,"_3006":52537},[],"Device Manager keeps the operational view of the device and its history. The Validation Authority publishes OCSP and CRLs so other systems can decide whether to trust a presented certificate.",{"_3550":833,"_30605":820,"_21201":52539,"_5":14582,"_27821":52518,"_3006":52540},[],"In a self-managed deployment, Lamassu uses PostgreSQL for persistence, RabbitMQ for messaging and an OIDC provider for authentication. See the deployment architecture for how the services are published on Kubernetes.",{"_3550":834,"_30605":834,"_5":14934,"_3006":52542,"_30943":52543,"_21201":52544,"_27821":834},"How Lamassu works",[49963,51438],[],{"_3550":835,"_30605":834,"_21201":52546,"_5":14582,"_27821":834,"_3006":52547},[],"The mental model of trust, keys, certificates and devices.",{"_3550":836,"_30605":834,"_5":30940,"_21201":52549,"_27821":52550,"_3006":52551},[],"/docs/platform/concepts/overview#the-model-in-five-pieces","The model in five pieces",{"_3550":837,"_30605":834,"_5":30940,"_21201":52553,"_27821":52554,"_3006":52555},[],"/docs/platform/concepts/overview#from-onboarding-to-operation","From onboarding to operation",{"_3550":838,"_30605":834,"_21201":52557,"_5":14582,"_27821":834,"_3006":52558},[],"Lamassu connects three elements: a **root of trust**, an **issuance policy** and an **entity that needs to prove its identity**. The platform coordinates these elements throughout the certificate lifecycle.",{"_3550":839,"_30605":834,"_21201":52560,"_5":14582,"_27821":52550,"_3006":52561},[],"**Cryptographic engine.** Generates or safeguards keys and executes private-key operations without exposing key material to the rest of the services.",{"_3550":840,"_30605":834,"_21201":52563,"_5":14582,"_27821":52550,"_3006":52564},[],"**Certification Authority (CA).** Signs certificates and establishes the chain of trust.",{"_3550":841,"_30605":834,"_21201":52566,"_5":14582,"_27821":52550,"_3006":52567},[],"**Device Management Service (DMS).** Defines how the devices of a fleet are registered, authenticated and renewed.",{"_3550":842,"_30605":834,"_21201":52569,"_5":14582,"_27821":52550,"_3006":52570},[],"**Device.** Keeps its private key and presents the certificate to prove its identity.",{"_3550":843,"_30605":834,"_21201":52572,"_5":14582,"_27821":52550,"_3006":52573},[],"**Validation Authority (VA).** Publishes the status of certificates through OCSP and CRL.",{"_3550":844,"_30605":834,"_21201":52575,"_5":14582,"_27821":52554,"_3006":52576},[],"An administrator configures a cryptographic engine and creates or imports a CA.",{"_3550":845,"_30605":834,"_21201":52578,"_5":14582,"_27821":52554,"_3006":52579},[],"A DMS relates that CA to an enrollment policy.",{"_3550":846,"_30605":834,"_21201":52581,"_5":14582,"_27821":52554,"_3006":52582},[],"The device generates a key and requests a certificate through EST, or an operator assigns it an identity.",{"_3550":847,"_30605":834,"_21201":52584,"_5":14582,"_27821":52554,"_3006":52585},[],"Lamassu keeps the inventory, history and status of the identity.",{"_3550":848,"_30605":834,"_21201":52587,"_5":14582,"_27821":52554,"_3006":52588},[],"Consumers check the chain and query OCSP or a CRL when they need to know whether it is still valid.",{"_3550":849,"_30605":834,"_21201":52590,"_5":14582,"_27821":52554,"_3006":52591},[],"<Card title=\"Architecture\" description=\"Get to know the components and where each one's responsibility ends.\" href=\"/docs/platform/concepts/architecture\" />",{"_3550":850,"_30605":834,"_21201":52593,"_5":14582,"_27821":52554,"_3006":52594},[],"<Card title=\"Identity lifecycle\" description=\"Follow a certificate from enrollment to renewal or revocation.\" href=\"/docs/platform/pki/concepts/certificate-lifecycle\" />",{"_3550":851,"_30605":851,"_5":14934,"_3006":52596,"_30943":52597,"_21201":52599,"_27821":851},"Devices and identities",[49963,51438,52598,52596],"IoT Fleets",[],{"_3550":852,"_30605":851,"_21201":52601,"_5":14582,"_27821":851,"_3006":52602},[],"Register, inspect and retire devices while checking their current identity and history.",{"_3550":853,"_30605":851,"_5":30940,"_21201":52604,"_27821":52605,"_3006":52606},[],"/docs/platform/iot-fleets/device-management#device-states","Device states",{"_3550":854,"_30605":851,"_5":30940,"_21201":52608,"_27821":52609,"_3006":52610},[],"/docs/platform/iot-fleets/device-management#inspect-a-device","Inspect a device",{"_3550":855,"_30605":851,"_5":30940,"_21201":52612,"_27821":52613,"_3006":52614},[],"/docs/platform/iot-fleets/device-management#register-a-device-manually","Register a device manually",{"_3550":856,"_30605":851,"_5":30940,"_21201":52616,"_27821":52617,"_3006":52618},[],"/docs/platform/iot-fleets/device-management#create-the-device","Create the device",{"_3550":857,"_30605":851,"_5":30940,"_21201":52620,"_27821":52621,"_3006":52622},[],"/docs/platform/iot-fleets/device-management#define-its-membership","Define its membership",{"_3550":858,"_30605":851,"_5":30940,"_21201":52624,"_27821":52625,"_3006":52626},[],"/docs/platform/iot-fleets/device-management#classify-the-device","Classify the device",{"_3550":859,"_30605":851,"_5":30940,"_21201":52628,"_27821":52629,"_3006":52630},[],"/docs/platform/iot-fleets/device-management#verify-the-registration","Verify the registration",{"_3550":860,"_30605":851,"_5":30940,"_21201":52632,"_27821":52633,"_3006":52634},[],"/docs/platform/iot-fleets/device-management#assign-an-identity-manually","Assign an identity manually",{"_3550":861,"_30605":851,"_5":30940,"_21201":52636,"_27821":52637,"_3006":52638},[],"/docs/platform/iot-fleets/device-management#revoke-the-current-identity","Revoke the current identity",{"_3550":862,"_30605":851,"_5":30940,"_21201":52640,"_27821":52641,"_3006":52642},[],"/docs/platform/iot-fleets/device-management#decommission-a-device","Decommission a device",{"_3550":863,"_30605":851,"_5":30940,"_21201":52644,"_27821":52645,"_3006":52646},[],"/docs/platform/iot-fleets/device-management#automate-enrollment","Automate enrollment",{"_3550":864,"_30605":851,"_21201":52648,"_5":14582,"_27821":851,"_3006":52649},[],"This guide is for a fleet operator. You need device, DMS and certificate permissions for the intended actions. A fleet is organized through these resources, tags and metadata; there is no separate “fleet” object to create.",{"_3550":865,"_30605":851,"_21201":52651,"_5":14582,"_27821":851,"_3006":52652},[],"Each device has a `Device ID`, one owning DMS (`dms_owner`) and, once provisioned, an identity slot with an active version and previous versions. In these flows, keep the CSR and certificate `Common Name` equal to `Device ID`: binding uses that CN to update the device.",{"_3550":866,"_30605":851,"_21201":52654,"_5":14582,"_27821":52605,"_3006":52655},[],"Operational view",{"_3550":867,"_30605":851,"_21201":52657,"_5":14582,"_27821":52605,"_3006":52658},[],"Meaning",{"_3550":868,"_30605":851,"_21201":52660,"_5":14582,"_27821":52605,"_3006":52661},[],"**No Identity**",{"_3550":869,"_30605":851,"_21201":52663,"_5":14582,"_27821":52605,"_3006":52664},[],"A record exists without an associated identity.",{"_3550":870,"_30605":851,"_21201":52666,"_5":14582,"_27821":52605,"_3006":52667},[],"**Active**",{"_3550":871,"_30605":851,"_21201":52669,"_5":14582,"_27821":52605,"_3006":52670},[],"The slot is active; also check certificate dates, status and usages.",{"_3550":872,"_30605":851,"_21201":52672,"_5":14582,"_27821":52605,"_3006":52673},[],"**Renewal Pending**",{"_3550":873,"_30605":851,"_21201":52675,"_5":14582,"_27821":52605,"_3006":52676},[],"The identity is in the operational renewal window.",{"_3550":874,"_30605":851,"_21201":52678,"_5":14582,"_27821":52605,"_3006":52679},[],"**Expiring Soon**",{"_3550":875,"_30605":851,"_21201":52681,"_5":14582,"_27821":52605,"_3006":52682},[],"Expiration is approaching according to configured thresholds.",{"_3550":876,"_30605":851,"_21201":52684,"_5":14582,"_27821":52605,"_3006":52685},[],"**Expired**",{"_3550":877,"_30605":851,"_21201":52687,"_5":14582,"_27821":52605,"_3006":52688},[],"The identity has expired.",{"_3550":878,"_30605":851,"_21201":52690,"_5":14582,"_27821":52605,"_3006":52691},[],"**Revoked**",{"_3550":879,"_30605":851,"_21201":52693,"_5":14582,"_27821":52605,"_3006":52694},[],"The identity is marked revoked.",{"_3550":880,"_30605":851,"_21201":52696,"_5":14582,"_27821":52605,"_3006":52697},[],"**Decommissioned**",{"_3550":881,"_30605":851,"_21201":52699,"_5":14582,"_27821":52605,"_3006":52700},[],"The record is retired and ordinary updates do not restore operation.",{"_3550":882,"_30605":851,"_21201":52702,"_5":14582,"_27821":52605,"_3006":52703},[],"Device, slot and certificate states are distinct. Events and jobs can update the view after saving a certificate; an **Active** label does not establish consumer acceptance.",{"_3550":883,"_30605":851,"_21201":52705,"_5":14582,"_27821":52609,"_3006":52706},[],"Filter the inventory by ID, tags and status. Open details and record the owning DMS, active version and current certificate serial.",{"_3550":884,"_30605":851,"_21201":52708,"_5":14582,"_27821":52609,"_3006":52709},[],"**Certificate History** relates previous and current versions. Replacing the slot does not by itself revoke every previous version.",{"_3550":885,"_30605":851,"_21201":52711,"_5":14582,"_27821":52609,"_3006":52712},[],"**Device Event Timeline** helps reconstruct registration, provisioning, renewal and status changes. A change may be saved even if event persistence fails; also inspect the record and certificates.",{"_3550":886,"_30605":851,"_21201":52714,"_5":14582,"_27821":52609,"_3006":52715},[],"Compare these values with the identity installed on the device. Updating a Lamassu slot does not install files on the remote equipment.",{"_3550":887,"_30605":851,"_21201":52717,"_5":14582,"_27821":52613,"_3006":52718},[],"Use this flow to prepare inventory or assign an identity through the console. You need an existing DMS.",{"_3550":888,"_30605":851,"_21201":52720,"_5":14582,"_27821":52617,"_3006":52721},[],"Open registration in **Managed Devices**. Confirm the ID does not already exist in another DMS: ID lookup is not restricted to a fleet.",{"_3550":889,"_30605":851,"_21201":52723,"_5":14582,"_27821":52621,"_3006":52724},[],"Enter **Device ID** and select its owning DMS. The console’s **Registration Authority** label refers to that DMS.",{"_3550":890,"_30605":851,"_21201":52726,"_5":14582,"_27821":52625,"_3006":52727},[],"Add model, environment or location tags and an icon according to your inventory.",{"_3550":891,"_30605":851,"_21201":52729,"_5":14582,"_27821":52629,"_3006":52730},[],"Read the device again: require the intended DMS and **No Identity**. Follow Manual registration to complete assignment.",{"_3550":892,"_30605":851,"_21201":52732,"_5":14582,"_27821":52629,"_3006":52733},[],"Preregistration does not establish that `/simpleenroll` will admit the request. Review its interaction with `enable_replaceable_enrollment` in Provisioning strategies.",{"_3550":893,"_30605":851,"_21201":52735,"_5":14582,"_27821":52633,"_3006":52736},[],"From **No Identity**, use **Assign Identity**:",{"_3550":894,"_30605":851,"_21201":52738,"_5":14582,"_27821":52633,"_3006":52739},[],"Select an active, current certificate suitable for the consumer, with `CN` exactly equal to `Device ID`.",{"_3550":895,"_30605":851,"_21201":52741,"_5":14582,"_27821":52633,"_3006":52742},[],"If unavailable, **Issue New Instead** starts issuance using the intended CA. Review the profile first.",{"_3550":896,"_30605":851,"_21201":52744,"_5":14582,"_27821":52633,"_3006":52745},[],"Confirm and read the serial, active version and history again.",{"_3550":897,"_30605":851,"_21201":52747,"_5":14582,"_27821":52633,"_3006":52748},[],"Install the key/certificate pair and required intermediates on the device and test usage.",{"_3550":898,"_30605":851,"_21201":52750,"_5":14582,"_27821":52633,"_3006":52751},[],"Issuing, binding and installing are separate steps. If an operation fails, check which steps persisted before repeating it.",{"_3550":899,"_30605":851,"_21201":52753,"_5":14582,"_27821":52637,"_3006":52754},[],"Locate the active serial in history and revoke it with an appropriate reason. Verify the record, OCSP/CRL publication and rejection of a new consumer connection using the certificate guide.",{"_3550":900,"_30605":851,"_21201":52756,"_5":14582,"_27821":52637,"_3006":52757},[],"Revocation does not remove the device. It does not automatically enable another enrollment either: recovery depends on its credential, status and DMS policy. `CertificateHold` can be reactivated under PKI conditions; other reasons block subsequent certificate changes.",{"_3550":901,"_30605":851,"_21201":52759,"_5":14582,"_27821":52641,"_3006":52760},[],"Before **Decommission**, inventory active and previous identities, connections and destination permissions. Prepare retirement in the consumer.",{"_3550":902,"_30605":851,"_21201":52762,"_5":14582,"_27821":52641,"_3006":52763},[],"The backend saves **Decommissioned** and attempts to revoke the active version’s certificate with `CessationOfOperation` if the slot was not expired or revoked. It does not traverse all history. Deferred revocation can fail after retirement is saved; check the result by serial.",{"_3550":903,"_30605":851,"_21201":52765,"_5":14582,"_27821":52641,"_3006":52766},[],"Retired status protects ordinary device and slot updates. It does not guarantee that every EST request is rejected before issuance: binding can skip a retired device without returning an error. Check for remaining usable certificates or permissions and block new admission in the relevant control.",{"_3550":904,"_30605":851,"_21201":52768,"_5":14582,"_27821":52641,"_3006":52769},[],"Retain records according to audit policy. Do not reuse a retired ID to hide an equipment change.",{"_3550":905,"_30605":851,"_21201":52771,"_5":14582,"_27821":52645,"_3006":52772},[],"<Card title=\"Enroll and connect a device\" description=\"Obtain an identity from the client and test mTLS.\" href=\"/docs/platform/iot-fleets/quickstarts/enroll-device\" />",{"_3550":906,"_30605":851,"_21201":52774,"_5":14582,"_27821":52645,"_3006":52775},[],"<Card title=\"Renewal and recovery\" description=\"Install the successor and handle failures without losing known state.\" href=\"/docs/platform/iot-fleets/enrollment/renewal-and-recovery\" />",{"_3550":907,"_30605":907,"_5":14934,"_3006":52777,"_30943":52778,"_21201":52780,"_27821":907},"Bootstrap identity and authentication",[49963,51438,52598,52596,52779],"Enrollment with PKI",[],{"_3550":908,"_30605":907,"_21201":52782,"_5":14582,"_27821":907,"_3006":52783},[],"Prepare server trust and admission proofs for enroll and reenroll.",{"_3550":909,"_30605":907,"_5":30940,"_21201":52785,"_27821":52786,"_3006":52787},[],"/docs/platform/iot-fleets/enrollment/bootstrap-identity#initial-server-trust","Initial server trust",{"_3550":910,"_30605":907,"_5":30940,"_21201":52789,"_27821":52790,"_3006":52791},[],"/docs/platform/iot-fleets/enrollment/bootstrap-identity#bootstrap-credential","Bootstrap credential",{"_3550":911,"_30605":907,"_5":30940,"_21201":52793,"_27821":52794,"_3006":52795},[],"/docs/platform/iot-fleets/enrollment/bootstrap-identity#modes-per-operation","Modes per operation",{"_3550":912,"_30605":907,"_5":30940,"_21201":52797,"_27821":52798,"_3006":52799},[],"/docs/platform/iot-fleets/enrollment/bootstrap-identity#webhook-contract","Webhook contract",{"_3550":913,"_30605":907,"_5":30940,"_21201":52801,"_27821":52802,"_3006":52803},[],"/docs/platform/iot-fleets/enrollment/bootstrap-identity#revocation-and-checks","Revocation and checks",{"_3550":914,"_30605":907,"_21201":52805,"_5":14582,"_27821":907,"_3006":52806},[],"This guide connects the DMS administrator with device manufacturing and integration. Before requesting an operational identity, the client must authenticate the EST server and establish entitlement to request the intended ID.",{"_3550":915,"_30605":907,"_21201":52808,"_5":14582,"_27821":52786,"_3006":52809},[],"Install a previously verified root, chain or pin through a trusted channel: manufacturing, approved configuration or authenticated distribution. It enables TLS and server-name verification before downloading `/cacerts`.",{"_3550":916,"_30605":907,"_21201":52811,"_5":14582,"_27821":52786,"_3006":52812},[],"Your only trust proof cannot come from the same unauthenticated server. The EST server TLS certificate, bootstrap certificate and operational identity issuer may belong to different hierarchies.",{"_3550":917,"_30605":907,"_21201":52814,"_5":14582,"_27821":52790,"_3006":52815},[],"With `CLIENT_CERTIFICATE`, the device presents its initial certificate and proves key possession through TLS. The DMS validates it against admission CAs. In the inspected flow, the validator receives one leaf credential: configure and test the direct issuer for the simple case; sending more intermediates does not establish delivery to the service.",{"_3550":918,"_30605":907,"_21201":52817,"_5":14582,"_27821":52790,"_3006":52818},[],"Check dates, matching certificate/key and revocation before provisioning. A credential shared across equipment identifies that shared credential, not an individual device.",{"_3550":919,"_30605":907,"_21201":52820,"_5":14582,"_27821":52790,"_3006":52821},[],"Initial mTLS validation does not by itself compare bootstrap CN with the requested CSR CN. If a requester should only request its own `Device ID`, add a control binding credential to ID, such as the combined webhook, and test a request with another CN. Certificate re-enrollment does compare its CN to the CSR; subsequent checks use the registered active identity.",{"_3550":920,"_30605":907,"_21201":52823,"_5":14582,"_27821":52794,"_3006":52824},[],"Select the four modes independently for enrollment and re-enrollment in DMS. Renewal credentials depend on that block; do not assume the bootstrap is always used or the webhook disappears.",{"_3550":921,"_30605":907,"_21201":52826,"_5":14582,"_27821":52794,"_3006":52827},[],"An administrative OIDC token is not a native EST mode. A webhook may interpret an agreed credential header; that service then performs authorization. In NO\\_AUTH, sending a token does not add DMS authentication.",{"_3550":922,"_30605":907,"_21201":52829,"_5":14582,"_27821":52798,"_3006":52830},[],"The DMS sends operation context to the configured service. Method comes from configuration; agree the contract before selecting POST or PUT. Authorization wait defaults to 10 seconds, replaced by a configured positive timeout. The DMS verifies the receiver certificate unless `insecure_skip_verify` is enabled in the webhook config — verification is on by default — and does not follow redirects, so the configured URL must be the final one. The authorization response must be JSON of at most 1 MiB. With Lamassu-to-webhook authentication configured over `http://`, the API key or bearer token travels in cleartext, and mTLS has no effect because no TLS handshake takes place, so the client certificate is never presented; prefer `https://`. Configure those options in the webhook settings of the DMS guide.",{"_3550":923,"_30605":907,"_21201":52832,"_5":14582,"_27821":52798,"_3006":52833},[],"Example body:",{"_3550":924,"_30605":907,"_21201":52835,"_5":14582,"_27821":52798,"_3006":52836},[],"`csr` is **base64 of PEM**, unlike the EST body, which is base64 of DER. `http_request` contains URL and first header entries from available HTTP context. This body does not include an `operation` field; distinguish enroll and reenroll through the path and configured policy.",{"_3550":925,"_30605":907,"_21201":52838,"_5":14582,"_27821":52798,"_3006":52839},[],"The webhook should verify credential, its relationship to `device_cn`, DMS, operation and admission policy. Forwarded headers are not themselves trusted evidence. **Lamassu-to-webhook authentication** is a separate relationship configured in the server’s HTTP client.",{"_3550":926,"_30605":907,"_21201":52841,"_5":14582,"_27821":52798,"_3006":52842},[],"Continuation requires a successful HTTP response and JSON:",{"_3550":927,"_30605":907,"_21201":52844,"_5":14582,"_27821":52798,"_3006":52845},[],"A bodyless `204` does not satisfy the contract. Denial, transport error, uninterpretable response or timeout abort authorization. Combined mode validates the certificate first, then queries the webhook. See the webhook specification.",{"_3550":928,"_30605":907,"_21201":52847,"_5":14582,"_27821":52802,"_3006":52848},[],"The DMS first looks up the certificate in Lamassu; for external certificates it attempts OCSP and CRL. If revocation cannot be checked, validators can continue treating it as not revoked. The code also does not establish rejection of every external status other than Good. Test required behavior with your actual credential and endpoint; do not present this as guaranteed strict enforcement across every source.",{"_3550":929,"_30605":907,"_21201":52850,"_5":14582,"_27821":52802,"_3006":52851},[],"Test an allowed certificate, an incorrect one, another CN, webhook denial, timeout and re-enrollment under its own policy. Keep results and schedule bootstrap credential retirement where appropriate. Continue with EST client.",{"_3550":930,"_30605":930,"_5":14934,"_3006":52853,"_30943":52854,"_21201":52855,"_27821":930},"Configure and operate the DMS",[49963,51438,52598,52596,52779],[],{"_3550":931,"_30605":930,"_21201":52857,"_5":14582,"_27821":930,"_3006":52858},[],"Define registration, authentication per operation, issuance, renewal and distributed trust.",{"_3550":932,"_30605":930,"_5":30940,"_21201":52860,"_27821":52861,"_3006":49973},[],"/docs/platform/iot-fleets/enrollment/dms#before-you-begin",{"_3550":933,"_30605":930,"_5":30940,"_21201":52863,"_27821":52864,"_3006":52865},[],"/docs/platform/iot-fleets/enrollment/dms#configure-a-dms","Configure a DMS",{"_3550":934,"_30605":930,"_5":30940,"_21201":52867,"_27821":52868,"_3006":52869},[],"/docs/platform/iot-fleets/enrollment/dms#identify-the-fleet","Identify the fleet",{"_3550":935,"_30605":930,"_5":30940,"_21201":52871,"_27821":52872,"_3006":52873},[],"/docs/platform/iot-fleets/enrollment/dms#select-the-enrollment-ca","Select the enrollment CA",{"_3550":936,"_30605":930,"_5":30940,"_21201":52875,"_27821":52876,"_3006":52877},[],"/docs/platform/iot-fleets/enrollment/dms#configure-est","Configure EST",{"_3550":937,"_30605":930,"_5":30940,"_21201":52879,"_27821":52880,"_3006":52881},[],"/docs/platform/iot-fleets/enrollment/dms#distribute-trust","Distribute trust",{"_3550":938,"_30605":930,"_5":30940,"_21201":52883,"_27821":52884,"_3006":52885},[],"/docs/platform/iot-fleets/enrollment/dms#verify-the-endpoints","Verify the endpoints",{"_3550":939,"_30605":930,"_5":30940,"_21201":52887,"_27821":52888,"_3006":52889},[],"/docs/platform/iot-fleets/enrollment/dms#enrollment-configuration","Enrollment configuration",{"_3550":940,"_30605":930,"_5":30940,"_21201":52891,"_27821":52892,"_3006":52893},[],"/docs/platform/iot-fleets/enrollment/dms#enrollment-device-registration","Enrollment Device Registration",{"_3550":941,"_30605":930,"_5":30940,"_21201":52895,"_27821":52896,"_3006":52897},[],"/docs/platform/iot-fleets/enrollment/dms#enrollment-settings","Enrollment Settings",{"_3550":942,"_30605":930,"_5":30940,"_21201":52899,"_27821":52900,"_3006":52901},[],"/docs/platform/iot-fleets/enrollment/dms#authentication-per-operation","Authentication per operation",{"_3550":943,"_30605":930,"_5":30940,"_21201":52903,"_27821":52904,"_3006":52905},[],"/docs/platform/iot-fleets/enrollment/dms#external-webhook-settings","External webhook settings",{"_3550":944,"_30605":930,"_5":30940,"_21201":52907,"_27821":52908,"_3006":52909},[],"/docs/platform/iot-fleets/enrollment/dms#issuance-profile","Issuance profile",{"_3550":945,"_30605":930,"_5":30940,"_21201":52911,"_27821":52912,"_3006":52913},[],"/docs/platform/iot-fleets/enrollment/dms#re-enrollment-configuration","Re-enrollment configuration",{"_3550":946,"_30605":930,"_5":30940,"_21201":52915,"_27821":52916,"_3006":52917},[],"/docs/platform/iot-fleets/enrollment/dms#serverkeygen","ServerKeyGen",{"_3550":947,"_30605":930,"_5":30940,"_21201":52919,"_27821":52920,"_3006":52921},[],"/docs/platform/iot-fleets/enrollment/dms#trust-distribution","Trust distribution",{"_3550":948,"_30605":930,"_5":30940,"_21201":52923,"_27821":52924,"_3006":52925},[],"/docs/platform/iot-fleets/enrollment/dms#operate-the-dms-inventory","Operate the DMS inventory",{"_3550":949,"_30605":930,"_5":30940,"_21201":52927,"_27821":52928,"_3006":52929},[],"/docs/platform/iot-fleets/enrollment/dms#integrate-the-devices","Integrate the devices",{"_3550":950,"_30605":930,"_21201":52931,"_5":14582,"_27821":930,"_3006":52932},[],"A &#x2A;*Device Management Service (DMS)** configures admission and identity lifecycle for its devices. It acts as a registration authority; the CA selected in `Enrollment CA` signs certificates. This guide is for the policy administrator.",{"_3550":951,"_30605":930,"_21201":52934,"_5":14582,"_27821":52861,"_3006":52935},[],"You need DMS management permissions, an active CA with a usable key and a tested issuance profile. Agree device ID, initial credential, consumer and renewal window with the integrator. Review Provisioning strategies before choosing registration and replacement.",{"_3550":952,"_30605":930,"_21201":52937,"_5":14582,"_27821":52861,"_3006":52938},[],"Prepare EST server trust and device connectivity through Deployment. Your operator’s administrative authentication does not replace device EST authentication.",{"_3550":953,"_30605":930,"_21201":52940,"_5":14582,"_27821":52868,"_3006":52941},[],"Create the DMS with a recognizable name and retain its ID. EST URLs use this identifier, not the display name. Each device retains one owning DMS.",{"_3550":954,"_30605":930,"_21201":52943,"_5":14582,"_27821":52872,"_3006":52944},[],"Choose **Enrollment CA** and an explicit profile appropriate for the end-entity identity. Keep CN compatible with `Device ID`. The test certificate should allow its intended purpose and expire within issuer validity.",{"_3550":955,"_30605":930,"_21201":52946,"_5":14582,"_27821":52876,"_3006":52947},[],"Select initial enrollment registration and authentication. Separately configure re-enrollment authentication, thresholds and previous certificate retirement. Leave ServerKeyGen disabled if the client generates its key.",{"_3550":956,"_30605":930,"_21201":52949,"_5":14582,"_27821":52880,"_3006":52950},[],"Select certificates returned by `/cacerts`. Explicitly include required intermediates and roots, keeping distribution distinct from automatic trust installation.",{"_3550":957,"_30605":930,"_21201":52952,"_5":14582,"_27821":52884,"_3006":52953},[],"Save and read configuration again. Query `/cacerts`, perform an allowed and a rejected enrollment, and inspect device, serial and history. Creating the DMS or downloading cacerts does not establish working authentication and issuance.",{"_3550":958,"_30605":930,"_21201":52955,"_5":14582,"_27821":52892,"_3006":52956},[],"`settings.enrollment_settings.registration_mode` accepts `JITP` or `PRE_REGISTRATION`. JITP creates an unknown device with the CSR CN as ID and the DMS as owner. `device_provisioning_profile` supplies tags, metadata and icon for that registration.",{"_3550":959,"_30605":930,"_21201":52958,"_5":14582,"_27821":52892,"_3006":52959},[],"PRE\\_REGISTRATION requires an existing ID. In the inspected code, an existing device encounters replacement checks first, even without an identity. Review preregistration conditions before using this mode.",{"_3550":960,"_30605":930,"_21201":52961,"_5":14582,"_27821":52896,"_3006":52962},[],"`settings.enrollment_settings` field",{"_3550":961,"_30605":930,"_21201":52964,"_5":14582,"_27821":52896,"_3006":52965},[],"Decision",{"_3550":962,"_30605":930,"_21201":52967,"_5":14582,"_27821":52896,"_3006":52968},[],"`protocol`",{"_3550":963,"_30605":930,"_21201":52970,"_5":14582,"_27821":52896,"_3006":52971},[],"`EST_RFC7030` for these operations.",{"_3550":964,"_30605":930,"_21201":52973,"_5":14582,"_27821":52896,"_3006":52974},[],"`enrollment_ca`",{"_3550":965,"_30605":930,"_21201":52976,"_5":14582,"_27821":52896,"_3006":52977},[],"ID of the signing CA.",{"_3550":966,"_30605":930,"_21201":52979,"_5":14582,"_27821":52896,"_3006":52980},[],"`verify_csr_signature`",{"_3550":967,"_30605":930,"_21201":52982,"_5":14582,"_27821":52896,"_3006":52983},[],"Keep `true` to verify CSR key possession.",{"_3550":968,"_30605":930,"_21201":52985,"_5":14582,"_27821":52896,"_3006":52986},[],"`enable_replaceable_enrollment`",{"_3550":969,"_30605":930,"_21201":52988,"_5":14582,"_27821":52896,"_3006":52989},[],"Allows `/simpleenroll` for an existing ID in the same DMS. It can attempt previous certificate revocation even if a later phase fails; this is not atomic.",{"_3550":970,"_30605":930,"_21201":52991,"_5":14582,"_27821":52896,"_3006":52992},[],"`est_rfc7030_settings.auth_mode`",{"_3550":971,"_30605":930,"_21201":52994,"_5":14582,"_27821":52896,"_3006":52995},[],"One of the four authentication modes.",{"_3550":972,"_30605":930,"_21201":52997,"_5":14582,"_27821":52896,"_3006":52998},[],"Initial enrollment rejects an ID owned by another DMS. Do not automatically enable replacement in response to an error; Troubleshooting distinguishes repeated IDs, ownership and partial changes.",{"_3550":973,"_30605":930,"_21201":53000,"_5":14582,"_27821":52900,"_3006":53001},[],"The blocks are independent:",{"_3550":974,"_30605":930,"_21201":53003,"_5":14582,"_27821":52900,"_3006":53004},[],"`settings.enrollment_settings.est_rfc7030_settings` for `/simpleenroll` and `/serverkeygen`.",{"_3550":975,"_30605":930,"_21201":53006,"_5":14582,"_27821":52900,"_3006":53007},[],"`settings.reenrollment_settings.est_rfc7030_settings` for `/simplereenroll`.",{"_3550":976,"_30605":930,"_21201":53009,"_5":14582,"_27821":52900,"_3006":53010},[],"`auth_mode`",{"_3550":977,"_30605":930,"_21201":53012,"_5":14582,"_27821":52900,"_3006":53013},[],"Control applied in the configured operation",{"_3550":978,"_30605":930,"_21201":53015,"_5":14582,"_27821":52900,"_3006":53016},[],"`CLIENT_CERTIFICATE`",{"_3550":979,"_30605":930,"_21201":53018,"_5":14582,"_27821":52900,"_3006":53019},[],"Presented certificate validation.",{"_3550":980,"_30605":930,"_21201":53021,"_5":14582,"_27821":52900,"_3006":53022},[],"`EXTERNAL_WEBHOOK`",{"_3550":981,"_30605":930,"_21201":53024,"_5":14582,"_27821":52900,"_3006":53025},[],"Configured webhook authorization.",{"_3550":982,"_30605":930,"_21201":53027,"_5":14582,"_27821":52900,"_3006":53028},[],"`CLIENT_CERTIFICATE_AND_EXTERNAL_WEBHOOK`",{"_3550":983,"_30605":930,"_21201":53030,"_5":14582,"_27821":52900,"_3006":53031},[],"Certificate validation followed by webhook approval.",{"_3550":984,"_30605":930,"_21201":53033,"_5":14582,"_27821":52900,"_3006":53034},[],"`NO_AUTH`",{"_3550":985,"_30605":930,"_21201":53036,"_5":14582,"_27821":52900,"_3006":53037},[],"No DMS requester authentication.",{"_3550":986,"_30605":930,"_21201":53039,"_5":14582,"_27821":52900,"_3006":53040},[],"Webhook and combined modes also execute during re-enrollment when configured in its block. They do not implicitly degrade to NO\\_AUTH. An absent or unrecognized mode fails.",{"_3550":987,"_30605":930,"_21201":53042,"_5":14582,"_27821":52900,"_3006":53043},[],"For initial mTLS, `client_certificate_settings` contains `validation_cas`, `allow_expired` and `chain_level_validation`. The inspected flow receives one certificate credential; it does not guarantee forwarding every handshake intermediate to the validator. For a direct case, configure the bootstrap’s direct issuer as validation CA and test the actual Gateway path.",{"_3550":988,"_30605":930,"_21201":53045,"_5":14582,"_27821":52900,"_3006":53046},[],"For certificate re-enrollment, the validator tries the enrollment CA first and then the CAs listed in `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`; those are the re-enrollment validation CAs. That list is optional because the enrollment CA is always trusted for re-enrollment, and each settings block consults only its own `validation_cas`. CAs listed only in the initial block's `validation_cas` do not extend re-enrollment acceptance; during a CA rotation, add the old issuance CA to the re-enrollment block's list. The re-enrollment validator compares the presented TLS leaf against those CAs; the re-enrollment block's `chain_level_validation` and `allow_expired` values are stored but not consulted, and expiry is governed by `enable_expired_renewal`.",{"_3550":989,"_30605":930,"_21201":53048,"_5":14582,"_27821":52900,"_3006":53049},[],"For a webhook, configure destination, Lamassu-to-service authentication, method and timeout. The authentication contract explains the device credential and request body. `NO_AUTH` does not establish ownership of the requested ID.",{"_3550":990,"_30605":930,"_21201":53051,"_5":14582,"_27821":52904,"_3006":53052},[],"The webhook authentication modes read `external_webhook_settings` in the same `est_rfc7030_settings` block:",{"_3550":991,"_30605":930,"_21201":53054,"_5":14582,"_27821":52904,"_3006":53055},[],"`external_webhook_settings` field",{"_3550":992,"_30605":930,"_21201":53057,"_5":14582,"_27821":52904,"_3006":52965},[],{"_3550":993,"_30605":930,"_21201":53059,"_5":14582,"_27821":52904,"_3006":53060},[],"`url`",{"_3550":994,"_30605":930,"_21201":53062,"_5":14582,"_27821":52904,"_3006":53063},[],"Absolute `http` or `https` URL of the receiver. It must be the final URL; redirects are not followed.",{"_3550":995,"_30605":930,"_21201":53065,"_5":14582,"_27821":52904,"_3006":53066},[],"`method`",{"_3550":996,"_30605":930,"_21201":53068,"_5":14582,"_27821":52904,"_3006":53069},[],"`POST` or `PUT`; `POST` by default.",{"_3550":997,"_30605":930,"_21201":53071,"_5":14582,"_27821":52904,"_3006":53072},[],"`name`",{"_3550":998,"_30605":930,"_21201":53074,"_5":14582,"_27821":52904,"_3006":53075},[],"Label used in service logs.",{"_3550":999,"_30605":930,"_21201":53077,"_5":14582,"_27821":52904,"_3006":53078},[],"`config.auth_mode`",{"_3550":1000,"_30605":930,"_21201":53080,"_5":14582,"_27821":52904,"_3006":53081},[],"`noauth`, `apikey`, `jwt` or `mtls`. An absent or unknown value behaves as `noauth`.",{"_3550":1001,"_30605":930,"_21201":53083,"_5":14582,"_27821":52904,"_3006":53084},[],"`config.log_level`",{"_3550":1002,"_30605":930,"_21201":53086,"_5":14582,"_27821":52904,"_3006":53087},[],"Log level of the webhook call: `debug`, `info`, `warn` or `error`; `info` by default.",{"_3550":1003,"_30605":930,"_21201":53089,"_5":14582,"_27821":52904,"_3006":53090},[],"`config.apikey_options`",{"_3550":1004,"_30605":930,"_21201":53092,"_5":14582,"_27821":52904,"_3006":53093},[],"Required for `apikey`: `header` and `key`. Reserved header names are rejected.",{"_3550":1005,"_30605":930,"_21201":53095,"_5":14582,"_27821":52904,"_3006":53096},[],"`config.jwt_options`",{"_3550":1006,"_30605":930,"_21201":53098,"_5":14582,"_27821":52904,"_3006":53099},[],"Required for `jwt`: `oidc_client_id`, `oidc_client_secret` and an absolute `http` or `https` `oidc_well_known`.",{"_3550":1007,"_30605":930,"_21201":53101,"_5":14582,"_27821":52904,"_3006":53102},[],"`config.mtls_options`",{"_3550":1008,"_30605":930,"_21201":53104,"_5":14582,"_27821":52904,"_3006":53105},[],"Required for `mtls`: `cert_content` and `key_content` as Base64-encoded PEM, like certificates elsewhere in the API; plain PEM is also accepted.",{"_3550":1009,"_30605":930,"_21201":53107,"_5":14582,"_27821":52904,"_3006":53108},[],"`config.insecure_skip_verify`",{"_3550":1010,"_30605":930,"_21201":53110,"_5":14582,"_27821":52904,"_3006":53111},[],"Skips verification of the receiver certificate when `true`. Verification is on by default. Unlike alert channels, this flag is honored here.",{"_3550":1011,"_30605":930,"_21201":53113,"_5":14582,"_27821":52904,"_3006":53114},[],"`config.call_timeout`",{"_3550":1012,"_30605":930,"_21201":53116,"_5":14582,"_27821":52904,"_3006":53117},[],"Maximum duration of the authorization call (for example `10s`); 10 seconds by default.",{"_3550":1013,"_30605":930,"_21201":53119,"_5":14582,"_27821":52904,"_3006":53120},[],"Rules for that configuration:",{"_3550":1014,"_30605":930,"_21201":53122,"_5":14582,"_27821":52904,"_3006":53123},[],"Creating or updating a DMS whose enrollment or reenrollment `auth_mode` uses the webhook validates the block and returns HTTP 400 — the body starts with `struct validation error:` and continues with `invalid enrollment external webhook config` or `invalid reenrollment external webhook config` — when the URL, method or options are invalid. That includes an `mtls_options.cert_content`/`key_content` pair that does not decode to a matching certificate and private key. File references (`ca_cert_file`, `mtls_options.cert_file`, `mtls_options.key_file`) are always invalid: the service does not read files, so enter the certificate and key as Base64-encoded PEM in `mtls_options.cert_content` and `key_content`, or as plain PEM.",{"_3550":1015,"_30605":930,"_21201":53125,"_5":14582,"_27821":52904,"_3006":53126},[],"A custom `apikey_options.header` may not use names that the platform or the receiving service trusts — for example `X-Principal-Id`, `X-Request-Id`, `Host`, `Content-Type` or `Forwarded` — and no name may start with `X-Forwarded-`, `X-Envoy-` or `X-Lms-` (case-insensitive). The DMS API reference documents the `WebhookCall` and `WebhookCallHttpClient` schemas and that reserved API-key headers are rejected.",{"_3550":1016,"_30605":930,"_21201":53128,"_5":14582,"_27821":52904,"_3006":53129},[],"The nested `http_client` key exists only in alert channel configurations; in a DMS body it is ignored. The DMS key is `external_webhook_settings.config`.",{"_3550":1017,"_30605":930,"_21201":53131,"_5":14582,"_27821":52904,"_3006":53132},[],"A body with `config.auth_mode` set to `apikey`, `jwt` or `mtls` must carry its corresponding option block (`apikey_options`, `jwt_options` or `mtls_options`) — and nothing else. Bodies with those auth modes carrying only `apikey`, `oidc` or `mtls` fail validation with 400, and `validate_server_cert` is always ignored: use `insecure_skip_verify`. Only bodies without option blocks are accepted as `noauth`, and their credentials are dropped.",{"_3550":1018,"_30605":930,"_21201":53134,"_5":14582,"_27821":52904,"_3006":53135},[],"The authorization response must be JSON of at most 1 MiB; a larger body fails the call.",{"_3550":1019,"_30605":930,"_21201":53137,"_5":14582,"_27821":52904,"_3006":53138},[],"With credentials configured, they are sent regardless of the URL scheme: an `http://` webhook receives the API key or bearer token in cleartext, and mTLS has no effect because no TLS handshake takes place, so the client certificate is never presented. Prefer `https://` for `url`, `oidc_well_known` and the token endpoint it advertises.",{"_3550":1020,"_30605":930,"_21201":53140,"_5":14582,"_27821":52904,"_3006":53141},[],"Initial authentication and renewal settings are stored independently. If a DMS only has the initial authentication block, renewal reuses it: read both blocks before editing. The console exposes independent editors for the enrollment and re-enrollment authentication, with the same Log Level, Call Timeout, HTTP Authentication and credential fields as the webhook channels, plus a **Skip TLS Verification** switch (off by default, so verification stays on; the console warns when you enable it).",{"_3550":1021,"_30605":930,"_21201":53143,"_5":14582,"_27821":52904,"_3006":53144},[],"Webhook credentials must be stored as PEM content. File references (`ca_cert_file`, `mtls_options.cert_file`, `mtls_options.key_file`) are never valid in a stored webhook config: delivery rejects any webhook config that references files, whatever its auth mode, so every enroll and reenroll that calls that webhook fails until the certificate and key are entered as Base64-encoded or plain PEM in `mtls_options.cert_content` and `key_content`, or the file fields are removed if the webhook does not use mTLS. If a stored config holds file paths in `mtls_options.cert_content` or `key_content`, every full settings update (`POST /v1/dms`, `PUT /v1/dms/:id`) fails validation — settings are replaced wholesale, so the stored config must be resent — until the values are replaced by PEM content or the webhook stops being used. Meanwhile, delivery of that webhook fails on every call; a metadata-only update through `PUT` or `PATCH` on `/v1/dms/:id/metadata` still succeeds. To fix it in the console, open the DMS, replace any file-path value with PEM content — the editor rejects file paths with an inline field error — and save. Saving rewrites `external_webhook_settings.config` with the current keys, and the console reads both plain and Base64-encoded PEM from migrated configurations and stores the material Base64-encoded. If your stored config previously relied on `validate_server_cert: false`, it now carries `insecure_skip_verify: true`: receiver-certificate verification stays skipped until you set that flag to `false`. See 3.8.0 to 4.0.0 for the upgrade notes and the operator checklist.",{"_3550":1022,"_30605":930,"_21201":53146,"_5":14582,"_27821":52904,"_3006":53147},[],"The re-enrollment trust set lives in `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`. The flat field `reenrollment_settings.additional_validation_cas` is not part of the API: bodies that carry it are accepted but the value is silently ignored — unknown JSON fields are dropped — and GET responses do not include it. Read the DMS before sending API edits: an update body built with that flat field silently empties `validation_cas`.",{"_3550":1023,"_30605":930,"_21201":53149,"_5":14582,"_27821":52908,"_3006":53150},[],"`settings.issuance_profile_id` takes precedence over `settings.issuance_profile`; without either, the CA default profile is used. The resolved profile — including the CA default used as fallback when the DMS defines none — must define an end-entity certificate: a `Sign as CA` profile is rejected at enrollment and re-enrollment time. Rules are documented once in Profiles. DMS changes affect future requests; they do not modify signed certificates or install client trust.",{"_3550":1024,"_30605":930,"_21201":53152,"_5":14582,"_27821":52912,"_3006":53153},[],"`settings.reenrollment_settings` field",{"_3550":1025,"_30605":930,"_21201":53155,"_5":14582,"_27821":52912,"_3006":50353},[],{"_3550":1026,"_30605":930,"_21201":53157,"_5":14582,"_27821":52912,"_3006":53158},[],"`reenrollment_delta`",{"_3550":1027,"_30605":930,"_21201":53160,"_5":14582,"_27821":52912,"_3006":53161},[],"Opens the window at the active certificate’s `NotAfter` minus this delta.",{"_3550":1028,"_30605":930,"_21201":53163,"_5":14582,"_27821":52912,"_3006":53164},[],"`preventive_delta`",{"_3550":1029,"_30605":930,"_21201":53166,"_5":14582,"_27821":52912,"_3006":53167},[],"Preventive operational monitoring threshold.",{"_3550":1030,"_30605":930,"_21201":53169,"_5":14582,"_27821":52912,"_3006":53170},[],"`critical_delta`",{"_3550":1031,"_30605":930,"_21201":53172,"_5":14582,"_27821":52912,"_3006":53173},[],"Critical operational monitoring threshold.",{"_3550":1032,"_30605":930,"_21201":53175,"_5":14582,"_27821":52912,"_3006":53176},[],"`enable_expired_renewal`",{"_3550":1033,"_30605":930,"_21201":53178,"_5":14582,"_27821":52912,"_3006":53179},[],"Accepts an expired presented certificate in the renewal mTLS validator. Does not authorize another mode or remove Gateway constraints by itself.",{"_3550":1034,"_30605":930,"_21201":53181,"_5":14582,"_27821":52912,"_3006":53182},[],"`est_rfc7030_settings.client_certificate_settings.validation_cas`",{"_3550":1035,"_30605":930,"_21201":53184,"_5":14582,"_27821":52912,"_3006":53185},[],"Re-enrollment validation CAs for the renewal mTLS credential, tried after the enrollment CA; optional, because the enrollment CA is always trusted. Typically populated during CA rotation while old-CA cohorts renew.",{"_3550":1036,"_30605":930,"_21201":53187,"_5":14582,"_27821":52912,"_3006":53188},[],"`revoke_on_reenrollment`",{"_3550":1037,"_30605":930,"_21201":53190,"_5":14582,"_27821":52912,"_3006":53191},[],"If the previous certificate is ACTIVE, attempts Superseded revocation before binding its successor.",{"_3550":1038,"_30605":930,"_21201":53193,"_5":14582,"_27821":52912,"_3006":53194},[],"Monitoring does not renew: the client must schedule the request and installation. Webhook and NO\\_AUTH modes do not use the same mTLS expired-credential validator; the webhook must explicitly authorize permitted recovery. Review Renewal and recovery for operation order and partial failures.",{"_3550":1039,"_30605":930,"_21201":53196,"_5":14582,"_27821":52916,"_3006":53197},[],"`settings.server_keygen_settings.enabled` enables software key generation on the server. The console exposes it through an **Enable server-side key generation** switch and a **Key type** selection: `ECDSA` P-256, P-384 or P-521, or `RSA` with 2048, 3072 or 4096 bits; the defaults are P-256 for `ECDSA` and 4096 bit for `RSA`. Algorithm and size come from its `key` field, stored as `{type,bits}` where P-256, P-384 and P-521 map to `bits` 256, 384 and 521; `key` is omitted when disabled. The profile must permit them. The response contains an unencrypted PKCS#8 key inside TLS alongside the certificate. See format and extraction in EST reference.",{"_3550":1040,"_30605":930,"_21201":53199,"_5":14582,"_27821":52920,"_3006":50347},[],{"_3550":1041,"_30605":930,"_21201":53201,"_5":14582,"_27821":52920,"_3006":53202},[],"Published material",{"_3550":1042,"_30605":930,"_21201":53204,"_5":14582,"_27821":52920,"_3006":53205},[],"**Include Lamassu System CA**",{"_3550":1043,"_30605":930,"_21201":53207,"_5":14582,"_27821":52920,"_3006":53208},[],"Available downstream TLS certificate; it can be a leaf, not an issuing CA.",{"_3550":1044,"_30605":930,"_21201":53210,"_5":14582,"_27821":52920,"_3006":53211},[],"**Include Enrollment CA**",{"_3550":1045,"_30605":930,"_21201":53213,"_5":14582,"_27821":52920,"_3006":53214},[],"Selected issuing CA certificate.",{"_3550":1046,"_30605":930,"_21201":53216,"_5":14582,"_27821":52920,"_3006":53217},[],"**Managed CAs**",{"_3550":1047,"_30605":930,"_21201":53219,"_5":14582,"_27821":52920,"_3006":53220},[],"Explicitly selected CA certificates.",{"_3550":1048,"_30605":930,"_21201":53222,"_5":14582,"_27821":52920,"_3006":53223},[],"All ancestors are not added automatically. Trust distribution distinguishes trusted roots, intermediates and initial server trust.",{"_3550":1049,"_30605":930,"_21201":53225,"_5":14582,"_27821":52924,"_3006":53226},[],"**Edit** changes name, settings and metadata. Updates go through the DMS API. `PUT /v1/dms/{id}` always targets the DMS identified by the URL path: the body carries no `id` field, and any `id` or `creation_ts` in it is silently ignored — authorization is evaluated against the same URL identifier. The body must include a non-empty `name` and a `settings` object; missing either returns HTTP 400 and leaves the stored DMS unchanged. `name` and `settings` are always full replacements, so read the DMS before sending API edits to avoid losing fields. `metadata` is optional: omitting it or sending `null` keeps the stored metadata, a supplied object replaces it entirely, and `{}` clears it (a later GET returns an empty object, not `null`). Old-style bodies that carry the full DMS object keep working while they include `name` and `settings`; unknown fields are ignored. Updates reject an empty `name` with HTTP 400: a DMS whose stored name was zeroed by an earlier update must be renamed before any client round-trips it — the AWS IoT connector’s JITP writeback included. If the object does not include the AWS IoT connector key (`lamassu.io/iot/{connector_id}`), the connector ignores the DMS's later events.",{"_3550":1050,"_30605":930,"_21201":53228,"_5":14582,"_27821":52924,"_3006":53229},[],"**Go to DMS owned devices** restricts inventory by owner. **Show/Edit Metadata** contains operational and integration data; consult the integration guide before changing it. &#x2A;*EST (RFC-7030)** helps locate URLs.",{"_3550":1051,"_30605":930,"_21201":53231,"_5":14582,"_27821":52924,"_3006":53232},[],"**Delete** removes the DMS record and configuration; it does not itself cascade revocation across every device and certificate. Migrate dependencies and retain audit references before retirement.",{"_3550":1052,"_30605":930,"_21201":53234,"_5":14582,"_27821":52928,"_3006":53235},[],"Continue with EST client or the enrollment and mTLS tutorial. EST reference covers formats; Troubleshooting covers failures.",{"_3550":1053,"_30605":1053,"_5":14934,"_3006":53237,"_30943":53238,"_21201":53239,"_27821":1053},"Integrate the EST client",[49963,51438,52598,52596,52779],[],{"_3550":1054,"_30605":1053,"_21201":53241,"_5":14582,"_27821":1053,"_3006":53242},[],"Prepare trust, send a CSR and check the identity you receive.",{"_3550":1055,"_30605":1053,"_5":30940,"_21201":53244,"_27821":53245,"_3006":49973},[],"/docs/platform/iot-fleets/enrollment/est-client#before-you-begin",{"_3550":1056,"_30605":1053,"_5":30940,"_21201":53247,"_27821":53248,"_3006":53249},[],"/docs/platform/iot-fleets/enrollment/est-client#download-and-inspect-cacerts","Download and inspect cacerts",{"_3550":1057,"_30605":1053,"_5":30940,"_21201":53251,"_27821":53252,"_3006":53253},[],"/docs/platform/iot-fleets/enrollment/est-client#prepare-the-csr","Prepare the CSR",{"_3550":1058,"_30605":1053,"_5":30940,"_21201":53255,"_27821":53256,"_3006":53257},[],"/docs/platform/iot-fleets/enrollment/est-client#request-the-identity","Request the identity",{"_3550":1059,"_30605":1053,"_5":30940,"_21201":53259,"_27821":53260,"_3006":53261},[],"/docs/platform/iot-fleets/enrollment/est-client#check-and-install-the-result","Check and install the result",{"_3550":1060,"_30605":1053,"_5":30940,"_21201":53263,"_27821":53264,"_3006":53265},[],"/docs/platform/iot-fleets/enrollment/est-client#next-steps","Next steps",{"_3550":1061,"_30605":1053,"_21201":53267,"_5":14582,"_27821":1053,"_3006":53268},[],"This guide is for those implementing the device client. The administrator must have prepared the DMS policy. For a complete first run, follow Enroll and connect your first device.",{"_3550":1062,"_30605":1053,"_21201":53270,"_5":14582,"_27821":53245,"_3006":53271},[],"You need the public HTTPS DMS URL, server trust obtained through an approved channel, the operation's authentication mode and an admitted identifier. The examples use Bash, OpenSSL 3.x and curl with `--fail-with-body`; use a private working directory and compatible versions of these tools.",{"_3550":1063,"_30605":1053,"_21201":53273,"_5":14582,"_27821":53245,"_3006":53274},[],"Prepare `est-trust.pem` to verify the EST server, `bootstrap.crt` and `bootstrap.key` for initial certificate authentication, and `device-root.pem` as the approved root of the device issuer. The two trust files can contain different roots. For another authentication mode, adapt the credentials according to Bootstrap identity.",{"_3550":1064,"_30605":1053,"_21201":53276,"_5":14582,"_27821":53245,"_3006":53277},[],"Replace the host and `REPLACE_DMS_ID` with those of your installation. The URL's APS is the DMS identifier, not its display name.",{"_3550":1065,"_30605":1053,"_21201":53279,"_5":14582,"_27821":53248,"_3006":53280},[],"The default content is Base64-encoded DER PKCS#7. It is not a direct PEM file.",{"_3550":1066,"_30605":1053,"_21201":53282,"_5":14582,"_27821":53248,"_3006":53283},[],"Check fingerprints, issuers and dates against the trust distribution policy. The response can contain a selection of CAs and Lamassu's TLS certificate. Do not turn the entire bundle into trusted roots or use it to authenticate its own initial download. HTTP 200 here does not prove that authentication or issuance works.",{"_3550":1067,"_30605":1053,"_21201":53285,"_5":14582,"_27821":53252,"_3006":53286},[],"The example generates a new EC P-256 key and uses `est-device-001`, which must be available if the DMS registers automatically. The `Common Name` becomes the device identifier. Check that the profile permits the selected key and subject.",{"_3550":1068,"_30605":1053,"_21201":53288,"_5":14582,"_27821":53252,"_3006":53289},[],"An implementation using hardware or its own store must produce the CSR through its resident key. `simpleenroll` sends the request and retains the key in the client. Honor Extensions does not authorize every requested attribute: see Profiles.",{"_3550":1069,"_30605":1053,"_21201":53291,"_5":14582,"_27821":53256,"_3006":53292},[],"With initial `CLIENT_CERTIFICATE` authentication, send the Base64-encoded DER CSR using `Content-Type: application/pkcs10`:",{"_3550":1070,"_30605":1053,"_21201":53294,"_5":14582,"_27821":53256,"_3006":53295},[],"Stop if curl fails. Retain the HTTP code, headers and body for diagnosis; an error response is not decoded as a certificate. The Bash example stops before that conversion. A timeout leaves the operation's result to be checked in Lamassu: do not automatically repeat issuance.",{"_3550":1071,"_30605":1053,"_21201":53297,"_5":14582,"_27821":53260,"_3006":53298},[],"For a root that issues directly:",{"_3550":1072,"_30605":1053,"_21201":53300,"_5":14582,"_27821":53260,"_3006":53301},[],"Also verify that the CN is correct, the certificate is a leaf, its uses permit your application and its dates satisfy the profile. `cmp` must exit with code 0. With intermediates, provide the chain through `-untrusted` as described in PKI validation.",{"_3550":1073,"_30605":1053,"_21201":53303,"_5":14582,"_27821":53260,"_3006":53304},[],"Query the device: the owning DMS, current serial number and history must match the result. Protect the key/certificate pair and install both using the device's mechanism. Association in Lamassu does not install files in the client. Check a real connection before considering the process complete.",{"_3550":1074,"_30605":1053,"_21201":53306,"_5":14582,"_27821":53264,"_3006":53307},[],"Implement renewal and recovery and trust updates. The EST reference covers endpoints, formats and ServerKeyGen; troubleshooting helps distinguish transport, admission and persistence failures.",{"_3550":1075,"_30605":1075,"_5":14934,"_3006":53309,"_30943":53310,"_21201":53311,"_27821":1075},"EST reference",[49963,51438,52598,52596,52779],[],{"_3550":1076,"_30605":1075,"_21201":53313,"_5":14582,"_27821":1075,"_3006":53314},[],"Look up Lamassu routes, formats, authentication and multipart responses.",{"_3550":1077,"_30605":1075,"_5":30940,"_21201":53316,"_27821":53317,"_3006":53318},[],"/docs/platform/iot-fleets/enrollment/est-reference#endpoint-reference","Endpoint reference",{"_3550":1078,"_30605":1075,"_5":30940,"_21201":53320,"_27821":53321,"_3006":22976},[],"/docs/platform/iot-fleets/enrollment/est-reference#cacerts",{"_3550":1079,"_30605":1075,"_5":30940,"_21201":53323,"_27821":53324,"_3006":26393},[],"/docs/platform/iot-fleets/enrollment/est-reference#simpleenroll",{"_3550":1080,"_30605":1075,"_5":30940,"_21201":53326,"_27821":53327,"_3006":26400},[],"/docs/platform/iot-fleets/enrollment/est-reference#simplereenroll",{"_3550":1081,"_30605":1075,"_5":30940,"_21201":53329,"_27821":53330,"_3006":25686},[],"/docs/platform/iot-fleets/enrollment/est-reference#serverkeygen",{"_3550":1082,"_30605":1075,"_5":30940,"_21201":53332,"_27821":53333,"_3006":53334},[],"/docs/platform/iot-fleets/enrollment/est-reference#response-format","Response format",{"_3550":1083,"_30605":1075,"_5":30940,"_21201":53336,"_27821":53337,"_3006":53338},[],"/docs/platform/iot-fleets/enrollment/est-reference#request-and-extraction","Request and extraction",{"_3550":1084,"_30605":1075,"_5":30940,"_21201":53340,"_27821":53341,"_3006":53342},[],"/docs/platform/iot-fleets/enrollment/est-reference#compatibility-notes","Compatibility notes",{"_3550":1085,"_30605":1075,"_21201":53344,"_5":14582,"_27821":1075,"_3006":53345},[],"Reference for the examined backend, based on RFC 7030. Use EST client for the procedure and DMS to configure policy.",{"_3550":1086,"_30605":1075,"_21201":53347,"_5":14582,"_27821":53317,"_3006":53348},[],"Public route in the examples: `/.well-known/est/{APS}/{operation}`. `APS` is the DMS ID. The router admits routes without that segment, but the controller requires it; do not use them as a default service. Gateway configuration determines the public host and route.",{"_3550":1087,"_30605":1075,"_21201":53350,"_5":14582,"_27821":53317,"_3006":53351},[],"Operation",{"_3550":1088,"_30605":1075,"_21201":53353,"_5":14582,"_27821":53317,"_3006":53354},[],"Method",{"_3550":1089,"_30605":1075,"_21201":53356,"_5":14582,"_27821":53317,"_3006":53357},[],"Authentication and condition",{"_3550":1090,"_30605":1075,"_21201":53359,"_5":14582,"_27821":53317,"_3006":53360},[],"`/cacerts`",{"_3550":1091,"_30605":1075,"_21201":53362,"_5":14582,"_27821":53317,"_3006":53363},[],"GET",{"_3550":1092,"_30605":1075,"_21201":53365,"_5":14582,"_27821":53317,"_3006":53366},[],"DMS reading does not require an EST credential; HTTPS and infrastructure controls still apply.",{"_3550":1093,"_30605":1075,"_21201":53368,"_5":14582,"_27821":53317,"_3006":53369},[],"`/simpleenroll`",{"_3550":1094,"_30605":1075,"_21201":53371,"_5":14582,"_27821":53317,"_3006":53372},[],"POST",{"_3550":1095,"_30605":1075,"_21201":53374,"_5":14582,"_27821":53317,"_3006":53375},[],"Initial authentication and DMS registration/replacement policy.",{"_3550":1096,"_30605":1075,"_21201":53377,"_5":14582,"_27821":53317,"_3006":53378},[],"`/simplereenroll`",{"_3550":1097,"_30605":1075,"_21201":53380,"_5":14582,"_27821":53317,"_3006":53372},[],{"_3550":1098,"_30605":1075,"_21201":53382,"_5":14582,"_27821":53317,"_3006":53383},[],"Renewal authentication, existing identity, subject, revocation and window.",{"_3550":1099,"_30605":1075,"_21201":53385,"_5":14582,"_27821":53317,"_3006":53386},[],"`/serverkeygen`",{"_3550":1100,"_30605":1075,"_21201":53388,"_5":14582,"_27821":53317,"_3006":53372},[],{"_3550":1101,"_30605":1075,"_21201":53390,"_5":14582,"_27821":53317,"_3006":53391},[],"Initial authentication and admission; server generation enabled.",{"_3550":1102,"_30605":1075,"_21201":53393,"_5":14582,"_27821":53317,"_3006":53394},[],"These routes do not implement `/csrattrs` or `/fullcmc`. There is no native JWT EST authentication mode; a webhook can interpret a request credential according to its own contract.",{"_3550":1103,"_30605":1075,"_21201":53396,"_5":14582,"_27821":53321,"_3006":53397},[],"The default response has `Content-Type: application/pkcs7-mime; smime-type=certs-only` and `Content-Transfer-Encoding: base64`. The body is Base64-encoded DER PKCS#7 with lines of up to 76 characters. It includes the certificates selected by the DMS, not necessarily every ancestor.",{"_3550":1104,"_30605":1075,"_21201":53399,"_5":14582,"_27821":53321,"_3006":53400},[],"`Accept: application/x-pem-file` requests the bundle in PEM through a Lamassu extension. Inspect and approve its contents before modifying trusted roots.",{"_3550":1105,"_30605":1075,"_21201":53402,"_5":14582,"_27821":53324,"_3006":53403},[],"Send a Base64-encoded DER PKCS#10 CSR with `Content-Type: application/pkcs10`. The examined controller compares that media type literally; avoid adding parameters such as charset. The CN identifies the device and the CSR signature must be verified through DMS policy.",{"_3550":1106,"_30605":1075,"_21201":53405,"_5":14582,"_27821":53324,"_3006":53406},[],"The default response uses the PKCS#7/Base64 format described for cacerts, but contains the issued certificate; do not assume it includes its entire chain. `Accept: application/x-pem-file` returns that certificate in PEM. The client retains the key that signed the CSR.",{"_3550":1107,"_30605":1075,"_21201":53408,"_5":14582,"_27821":53327,"_3006":53409},[],"Use the same request and certificate response formats. Authentication comes from the independent `reenrollment_settings.est_rfc7030_settings` block. With a client certificate, its CN must match the CSR CN; the subject is also checked against the current certificate.",{"_3550":1108,"_30605":1075,"_21201":53411,"_5":14582,"_27821":53327,"_3006":53412},[],"In mTLS mode, the enrollment CA always validates the re-enrollment credential; certificates from other issuers are accepted only if they are listed as validation CAs in the re-enrollment block. The expiry check through `enable_expired_renewal` belongs to that validator. A revoked current certificate and a request before the window are rejected. See Renewal for installation and recovery.",{"_3550":1109,"_30605":1075,"_21201":53414,"_5":14582,"_27821":53330,"_3006":53415},[],"The server generates a software key, rebuilds the CSR with that key and performs initial enrollment. The flag must be enabled and the algorithm permitted by the profile. This operation's key does not become a hardware key because the CA is hosted in an HSM.",{"_3550":1110,"_30605":1075,"_21201":53417,"_5":14582,"_27821":53330,"_3006":53418},[],"The code supports RSA and ECDSA, and the `bits` value of the DMS key setting means something different for each. For ECDSA it selects the curve: 224, 256, 384 or 521 map to P-224, P-256, P-384 and P-521, and an unrecognized size falls back to P-256, so explicitly select a compatible size and check the resulting key. For RSA it is used directly as the modulus size; the console offers 2048, 3072 and 4096 bits. Do not reuse an enrolled ID to test this operation without reviewing replacement.",{"_3550":1111,"_30605":1075,"_21201":53420,"_5":14582,"_27821":53333,"_3006":53421},[],"The body is **MIME multipart/mixed**, with the boundary specified in `Content-Type`. It contains two parts:",{"_3550":1112,"_30605":1075,"_21201":53423,"_5":14582,"_27821":53333,"_3006":53424},[],"Part",{"_3550":1113,"_30605":1075,"_21201":53426,"_5":14582,"_27821":53333,"_3006":53427},[],"Content after decoding its Base64",{"_3550":1114,"_30605":1075,"_21201":53429,"_5":14582,"_27821":53333,"_3006":53430},[],"`application/pkcs8`",{"_3550":1115,"_30605":1075,"_21201":53432,"_5":14582,"_27821":53333,"_3006":53433},[],"Unencrypted DER PKCS#8 private key.",{"_3550":1116,"_30605":1075,"_21201":53435,"_5":14582,"_27821":53333,"_3006":53436},[],"`application/pkcs7-mime; smime-type=certs-only`",{"_3550":1117,"_30605":1075,"_21201":53438,"_5":14582,"_27821":53333,"_3006":53439},[],"DER PKCS#7 containing the issued certificate.",{"_3550":1118,"_30605":1075,"_21201":53441,"_5":14582,"_27821":53333,"_3006":53442},[],"The controller also adds `Content-Transfer-Encoding: base64` to the outer header, although the outer body is MIME text. &#x2A;*Do not Base64-decode the entire body.** Read the actual boundary and decode each part according to its headers.",{"_3550":1119,"_30605":1075,"_21201":53444,"_5":14582,"_27821":53337,"_3006":53445},[],"In a Bash session with `set -euo pipefail` and `umask 077`, use `EST_BASE` and the trust/bootstrap files from EST client. Select an available and admitted `est-serverkeygen-001`. The `server-request.key` only signs the input CSR; the received identity uses the server-generated key.",{"_3550":1120,"_30605":1075,"_21201":53447,"_5":14582,"_27821":53337,"_3006":53448},[],"Save this Python 3 extractor. It validates both parts before writing and rejects existing output files:",{"_3550":1121,"_30605":1075,"_21201":53450,"_5":14582,"_27821":53337,"_3006":53451},[],"Convert and check the result:",{"_3550":1122,"_30605":1075,"_21201":53453,"_5":14582,"_27821":53337,"_3006":53454},[],"Inspect the CN, serial, dates and uses; check association in Lamassu before installing. Protect the DER and PEM files containing the key and remove temporary copies according to the device's storage mechanism. See openssl-pkcs8 and the Python MIME parser.",{"_3550":1123,"_30605":1075,"_21201":53456,"_5":14582,"_27821":53341,"_3006":53457},[],"Do not interpret every 500 as a transient failure. Invalid input typically produces 400; service denials and errors typically produce 500 with a JSON `err` body. Gateway errors and some controller paths can have another format. Retain headers and body before decoding and see troubleshooting.",{"_3550":1124,"_30605":1075,"_21201":53459,"_5":14582,"_27821":53341,"_3006":53460},[],"The examples use openssl-pkcs7 to extract certificates and openssl-x509 to prepare renewal. Check your version's capabilities and responses before integrating a generic EST client.",{"_3550":1125,"_30605":1125,"_5":14934,"_3006":52779,"_30943":53462,"_21201":53463,"_27821":1125},[49963,51438,52598,52596,52779],[],{"_3550":1126,"_30605":1125,"_21201":53465,"_5":14582,"_27821":1125,"_3006":53466},[],"Choose admission policy and connect DMS, initial trust and the EST client.",{"_3550":1127,"_30605":1125,"_5":30940,"_21201":53468,"_27821":53469,"_3006":53470},[],"/docs/platform/iot-fleets/enrollment/overview#the-journey","The journey",{"_3550":1128,"_30605":1125,"_5":30940,"_21201":53472,"_27821":53473,"_3006":53474},[],"/docs/platform/iot-fleets/enrollment/overview#for-the-administrator","For the administrator",{"_3550":1129,"_30605":1125,"_5":30940,"_21201":53476,"_27821":53477,"_3006":53478},[],"/docs/platform/iot-fleets/enrollment/overview#for-the-integrator","For the integrator",{"_3550":1130,"_30605":1125,"_5":30940,"_21201":53480,"_27821":53481,"_3006":53482},[],"/docs/platform/iot-fleets/enrollment/overview#contract-version","Contract version",{"_3550":1131,"_30605":1125,"_21201":53484,"_5":14582,"_27821":1125,"_3006":53485},[],"Enrollment with PKI covers the path from device admission to identity installation and renewal. The DMS acts as a registration authority: it authenticates the request, applies registration policy and asks the CA to sign. The client keeps or receives the key, installs the result and presents it to the consumer.",{"_3550":1132,"_30605":1125,"_21201":53487,"_5":14582,"_27821":53469,"_3006":53488},[],"The administrator prepares the CA, issuance profile and DMS.",{"_3550":1133,"_30605":1125,"_21201":53490,"_5":14582,"_27821":53469,"_3006":53491},[],"The integrator installs initial EST server trust and an admission credential.",{"_3550":1134,"_30605":1125,"_21201":53493,"_5":14582,"_27821":53469,"_3006":53494},[],"The client requests an identity for its `Device ID` through EST.",{"_3550":1135,"_30605":1125,"_21201":53496,"_5":14582,"_27821":53469,"_3006":53497},[],"Certificate, device binding and key/certificate installation are checked.",{"_3550":1136,"_30605":1125,"_21201":53499,"_5":14582,"_27821":53469,"_3006":53500},[],"The consumer validates and authorizes the identity; the client schedules renewal and recovery.",{"_3550":1137,"_30605":1125,"_21201":53502,"_5":14582,"_27821":53469,"_3006":53503},[],"EST uses `/.well-known/est/{DMS_ID}`. Administrative APIs and manual assignment remain separate paths. Enroll and connect a device completes an initial mTLS test.",{"_3550":1138,"_30605":1125,"_21201":53505,"_5":14582,"_27821":53473,"_3006":53506},[],"<Card title=\"Provisioning strategies\" description=\"Choose automatic registration, preregistration or manual assignment.\" href=\"/docs/platform/iot-fleets/enrollment/provisioning-strategies\" />",{"_3550":1139,"_30605":1125,"_21201":53508,"_5":14582,"_27821":53473,"_3006":53509},[],"<Card title=\"Configure the DMS\" description=\"Separate admission, authentication per operation, profiles and distribution.\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_3550":1140,"_30605":1125,"_21201":53511,"_5":14582,"_27821":53473,"_3006":53512},[],"<Card title=\"Bootstrap identity and authentication\" description=\"Decide which proof allows requesting the first identity.\" href=\"/docs/platform/iot-fleets/enrollment/bootstrap-identity\" />",{"_3550":1141,"_30605":1125,"_21201":53514,"_5":14582,"_27821":53473,"_3006":53515},[],"<Card title=\"Trust distribution\" description=\"Update roots and chains with verified overlap.\" href=\"/docs/platform/iot-fleets/enrollment/trust-distribution\" />",{"_3550":1142,"_30605":1125,"_21201":53517,"_5":14582,"_27821":53477,"_3006":53518},[],"<Card title=\"EST client\" description=\"Prepare the request, verify the response and install the identity.\" href=\"/docs/platform/iot-fleets/enrollment/est-client\" />",{"_3550":1143,"_30605":1125,"_21201":53520,"_5":14582,"_27821":53477,"_3006":53521},[],"<Card title=\"Renewal and recovery\" description=\"Generate the successor and handle expired or lost credentials.\" href=\"/docs/platform/iot-fleets/enrollment/renewal-and-recovery\" />",{"_3550":1144,"_30605":1125,"_21201":53523,"_5":14582,"_27821":53477,"_3006":53524},[],"<Card title=\"EST reference\" description=\"Look up paths, formats, authentication and ServerKeyGen.\" href=\"/docs/platform/iot-fleets/enrollment/est-reference\" />",{"_3550":1145,"_30605":1125,"_21201":53526,"_5":14582,"_27821":53477,"_3006":53527},[],"<Card title=\"Troubleshooting\" description=\"Distinguish transport, policy, issuance and installation failures.\" href=\"/docs/platform/iot-fleets/enrollment/troubleshooting\" />",{"_3550":1146,"_30605":1125,"_21201":53529,"_5":14582,"_27821":53481,"_3006":53530},[],"This block describes `main` code inspected at commit `8f42c47157f9a36bac3ed5caa3692aebebe19c4b`. The site catalog publishes `main (unstable)`; this behavior is not attributed to a stable release. Before using another version, check its contract, particularly independent re-enrollment authentication. Client checks and live-instance tests are distinguished in the revision plan.",{"_3550":1147,"_30605":1125,"_21201":53532,"_5":14582,"_27821":53481,"_3006":53533},[],"Gateway, TLS, provider and service configuration belongs to Deployment. Identity use in AWS or other destinations belongs to Integrations.",{"_3550":1148,"_30605":1148,"_5":14934,"_3006":53535,"_30943":53536,"_21201":53537,"_27821":1148},"Provisioning strategies",[49963,51438,52598,52596,52779],[],{"_3550":1149,"_30605":1148,"_21201":53539,"_5":14582,"_27821":1148,"_3006":53540},[],"Choose device registration, identity authorization and key generation.",{"_3550":1150,"_30605":1148,"_5":30940,"_21201":53542,"_27821":53543,"_3006":53544},[],"/docs/platform/iot-fleets/enrollment/provisioning-strategies#choose-registration","Choose registration",{"_3550":1151,"_30605":1148,"_5":30940,"_21201":53546,"_27821":53547,"_3006":53548},[],"/docs/platform/iot-fleets/enrollment/provisioning-strategies#preregistration-and-replacement","Preregistration and replacement",{"_3550":1152,"_30605":1148,"_5":30940,"_21201":53550,"_27821":53551,"_3006":53552},[],"/docs/platform/iot-fleets/enrollment/provisioning-strategies#choose-authentication","Choose authentication",{"_3550":1153,"_30605":1148,"_5":30940,"_21201":53554,"_27821":53555,"_3006":53556},[],"/docs/platform/iot-fleets/enrollment/provisioning-strategies#choose-custody","Choose custody",{"_3550":1154,"_30605":1148,"_5":30940,"_21201":53558,"_27821":53559,"_3006":53560},[],"/docs/platform/iot-fleets/enrollment/provisioning-strategies#check-the-decision","Check the decision",{"_3550":1155,"_30605":1148,"_21201":53562,"_5":14582,"_27821":1148,"_3006":53563},[],"This guide helps the provisioning administrator choose a path before configuring the DMS. Separate three decisions: when the device exists, how its request is authorized and who generates its key. None grants destination access by itself.",{"_3550":1156,"_30605":1148,"_21201":53565,"_5":14582,"_27821":53543,"_3006":53566},[],"Path",{"_3550":1157,"_30605":1148,"_21201":53568,"_5":14582,"_27821":53543,"_3006":53569},[],"When the device exists",{"_3550":1158,"_30605":1148,"_21201":53571,"_5":14582,"_27821":53543,"_3006":53572},[],"What to check",{"_3550":1159,"_30605":1148,"_21201":53574,"_5":14582,"_27821":53543,"_3006":53575},[],"Manual assignment",{"_3550":1160,"_30605":1148,"_21201":53577,"_5":14582,"_27821":53543,"_3006":53578},[],"An operator creates it before associating a certificate.",{"_3550":1161,"_30605":1148,"_21201":53580,"_5":14582,"_27821":53543,"_3006":53581},[],"ID, owning DMS, certificate CN and bound serial.",{"_3550":1162,"_30605":1148,"_21201":53583,"_5":14582,"_27821":53543,"_3006":53584},[],"EST with `JITP`",{"_3550":1163,"_30605":1148,"_21201":53586,"_5":14582,"_27821":53543,"_3006":53587},[],"Created for an unknown CN during `/simpleenroll`.",{"_3550":1164,"_30605":1148,"_21201":53589,"_5":14582,"_27821":53543,"_3006":53590},[],"Authorized credential, unused ID, profile, resulting registration and identity.",{"_3550":1165,"_30605":1148,"_21201":53592,"_5":14582,"_27821":53543,"_3006":53593},[],"EST with `PRE_REGISTRATION`",{"_3550":1166,"_30605":1148,"_21201":53595,"_5":14582,"_27821":53543,"_3006":53596},[],"Must exist before `/simpleenroll`.",{"_3550":1167,"_30605":1148,"_21201":53598,"_5":14582,"_27821":53543,"_3006":53599},[],"Approved record, same DMS and replacement conditions for your version.",{"_3550":1168,"_30605":1148,"_21201":53601,"_5":14582,"_27821":53543,"_3006":53602},[],"Lamassu `JITP` creates inventory and identity in Lamassu. AWS JITP provisions a destination in AWS; these are separate decisions.",{"_3550":1169,"_30605":1148,"_21201":53604,"_5":14582,"_27821":53543,"_3006":53605},[],"For an initial client test, use Enroll and connect a device. To prepare inventory without EST, follow Manual registration.",{"_3550":1170,"_30605":1148,"_21201":53607,"_5":14582,"_27821":53547,"_3006":53608},[],"In the inspected code, finding any device owned by the same DMS triggers the `enable_replaceable_enrollment` check before PRE\\_REGISTRATION. With the flag disabled, a preregistered device can receive `forbiddenNewEnrollment` even in **No Identity**. Selecting PRE\\_REGISTRATION alone therefore does not establish a working path.",{"_3550":1171,"_30605":1148,"_21201":53610,"_5":14582,"_27821":53547,"_3006":53611},[],"Enabling the flag permits repeated `/simpleenroll` for an existing ID. The backend schedules a deferred attempt to revoke the previous certificate with `Superseded`; it can also run if later issuance or binding fails. Without an identity, that attempt can fail because no serial exists. The flag does not provide a replacement transaction or guarantee restoration of previous state.",{"_3550":1172,"_30605":1148,"_21201":53613,"_5":14582,"_27821":53547,"_3006":53614},[],"Test the exact case on your version before enabling it for a population. For an operational identity with authorized renewal, use `/simplereenroll`; for recovery, follow Renewal and recovery and check persisted state before retrying.",{"_3550":1173,"_30605":1148,"_21201":53616,"_5":14582,"_27821":53551,"_3006":53617},[],"Decide initial enrollment and re-enrollment separately:",{"_3550":1174,"_30605":1148,"_21201":53619,"_5":14582,"_27821":53551,"_3006":53620},[],"**Client certificate:** useful when each device has an initial credential whose key it controls.",{"_3550":1175,"_30605":1148,"_21201":53622,"_5":14582,"_27821":53551,"_3006":53623},[],"**Webhook:** useful when another authority knows inventory, credentials or entitlement to a requested ID.",{"_3550":1176,"_30605":1148,"_21201":53625,"_5":14582,"_27821":53551,"_3006":53626},[],"**Certificate and webhook:** requires both controls in the configured operation.",{"_3550":1177,"_30605":1148,"_21201":53628,"_5":14582,"_27821":53551,"_3006":53629},[],"**NO\\_AUTH:** does not establish requester identity; appropriate only when admission is deliberately controlled outside that DMS.",{"_3550":1178,"_30605":1148,"_21201":53631,"_5":14582,"_27821":53551,"_3006":53632},[],"Authenticating an initial certificate does not itself establish entitlement to choose any CSR CN. Define that authorization in Bootstrap identity and authentication.",{"_3550":1179,"_30605":1148,"_21201":53634,"_5":14582,"_27821":53555,"_3006":50347},[],{"_3550":1180,"_30605":1148,"_21201":53636,"_5":14582,"_27821":53555,"_3006":53637},[],"Material crossing EST",{"_3550":1181,"_30605":1148,"_21201":53639,"_5":14582,"_27821":53555,"_3006":53640},[],"Device-generated key",{"_3550":1182,"_30605":1148,"_21201":53642,"_5":14582,"_27821":53555,"_3006":53643},[],"Public CSR and certificate; the key stays on the client.",{"_3550":1183,"_30605":1148,"_21201":53645,"_5":14582,"_27821":53555,"_3006":53646},[],"Existing device key",{"_3550":1184,"_30605":1148,"_21201":53648,"_5":14582,"_27821":53555,"_3006":53649},[],"CSR signed with that key and a new certificate.",{"_3550":1185,"_30605":1148,"_21201":53651,"_5":14582,"_27821":53555,"_3006":52917},[],{"_3550":1186,"_30605":1148,"_21201":53653,"_5":14582,"_27821":53555,"_3006":53654},[],"Private PKCS#8 key and certificate in a TLS-protected multipart response.",{"_3550":1187,"_30605":1148,"_21201":53656,"_5":14582,"_27821":53555,"_3006":53657},[],"ServerKeyGen does not automatically use the CA’s HSM or KMS for the device key. Review its contract and extraction and the device’s ability to install the material.",{"_3550":1188,"_30605":1148,"_21201":53659,"_5":14582,"_27821":53559,"_3006":53660},[],"Before expanding the flow, test allowed registration, incorrect credentials, an ID owned by another DMS, repeated requests and recovery after failure. Keep ID, serial, active version and error. Also test consumer acceptance and rejection; issuance does not imply destination registration or permission to operate.",{"_3550":1189,"_30605":1189,"_5":14934,"_3006":53662,"_30943":53663,"_21201":53664,"_27821":1189},"Renewal and recovery",[49963,51438,52598,52596,52779],[],{"_3550":1190,"_30605":1189,"_21201":53666,"_5":14582,"_27821":1189,"_3006":53667},[],"Renew without losing the identity and recover devices according to their actual state.",{"_3550":1191,"_30605":1189,"_5":30940,"_21201":53669,"_27821":53670,"_3006":53671},[],"/docs/platform/iot-fleets/enrollment/renewal-and-recovery#prepare-renewal","Prepare renewal",{"_3550":1192,"_30605":1189,"_5":30940,"_21201":53673,"_27821":53674,"_3006":53675},[],"/docs/platform/iot-fleets/enrollment/renewal-and-recovery#request-the-successor-certificate","Request the successor certificate",{"_3550":1193,"_30605":1189,"_5":30940,"_21201":53677,"_27821":53678,"_3006":53679},[],"/docs/platform/iot-fleets/enrollment/renewal-and-recovery#install-and-check-the-new-pair","Install and check the new pair",{"_3550":1194,"_30605":1189,"_5":30940,"_21201":53681,"_27821":53682,"_3006":53683},[],"/docs/platform/iot-fleets/enrollment/renewal-and-recovery#recover-according-to-state","Recover according to state",{"_3550":1195,"_30605":1189,"_5":30940,"_21201":53685,"_27821":53686,"_3006":53687},[],"/docs/platform/iot-fleets/enrollment/renewal-and-recovery#continuous-operation","Continuous operation",{"_3550":1196,"_30605":1189,"_21201":53689,"_5":14582,"_27821":1189,"_3006":53690},[],"Renewal retains the device identifier and requests a successor certificate. The client must complete the process: check the response, install the matching pair and demonstrate that the consumer accepts it. Lamassu alerts notify you; they do not perform those steps.",{"_3550":1197,"_30605":1189,"_21201":53692,"_5":14582,"_27821":53670,"_3006":53693},[],"Query the current certificate in Lamassu and compare it with the installed certificate. You need its subject, serial and dates, as well as the client key.",{"_3550":1198,"_30605":1189,"_21201":53695,"_5":14582,"_27821":53670,"_3006":53696},[],"Check the **re-enrollment** authentication mode: it is independent of initial authentication. With `CLIENT_CERTIFICATE`, use the current identity; do not assume the bootstrap credential is admitted.",{"_3550":1199,"_30605":1189,"_21201":53698,"_5":14582,"_27821":53670,"_3006":53699},[],"Calculate the window's start: the current certificate's `NotAfter` minus `reenrollment_delta`. Preventive and critical thresholds produce states/notifications; they do not extend that window.",{"_3550":1200,"_30605":1189,"_21201":53701,"_5":14582,"_27821":53670,"_3006":53702},[],"Review **Revoke on Re-enrollment** and recovery if installation fails. When enabled, Lamassu can revoke the previous identity before the client installs the new one.",{"_3550":1201,"_30605":1189,"_21201":53704,"_5":14582,"_27821":53674,"_3006":53705},[],"The example continues the EST tutorial, in the same Bash session with `set -euo pipefail`, `umask 077` and `EST_BASE`. Use a new key compatible with the profile. Conversion from the certificate preserves the subject and copies only SAN when present; check the subject and requested names before sending it. The backend checks the subject against the current identity: it attempts RawSubject equality and then compares CN, OU, O, L, ST and C. Rebuilding only the CN can lose required attributes.",{"_3550":1202,"_30605":1189,"_21201":53707,"_5":14582,"_27821":53674,"_3006":53708},[],"The request authenticates with `device.crt` and `device.key`; the CSR contains the new public key. Also check extensions, dates and correspondence of the serial with the current slot in Lamassu. Do not resubmit a failed request without querying that state: issuance, previous revocation and successor binding can have partial results.",{"_3550":1203,"_30605":1189,"_21201":53710,"_5":14582,"_27821":53678,"_3006":53711},[],"Keep the result as `device.next.crt` and `device.next.key` until verified. Switch the pair through a coordinated operation in the device store or configuration; avoid temporarily exposing a certificate with another version's key.",{"_3550":1204,"_30605":1189,"_21201":53713,"_5":14582,"_27821":53678,"_3006":53714},[],"Test mTLS with the consumer and verify that it uses the new serial. Confirm the history and current certificate in Lamassu. If **Revoke on Re-enrollment** was disabled, the previous identity can remain valid: retire it according to PKI policy after testing the successor, and check revocation publication and consumption.",{"_3550":1205,"_30605":1189,"_21201":53716,"_5":14582,"_27821":53678,"_3006":53717},[],"If the previous identity is already revoked, retaining its files does not restore a valid connection. Recovery requires an admitted credential and authorized intervention according to the situation.",{"_3550":1206,"_30605":1189,"_21201":53719,"_5":14582,"_27821":53682,"_3006":53720},[],"Situation",{"_3550":1207,"_30605":1189,"_21201":53722,"_5":14582,"_27821":53682,"_3006":53723},[],"Procedure",{"_3550":1208,"_30605":1189,"_21201":53725,"_5":14582,"_27821":53682,"_3006":53726},[],"Valid certificate, outside the window",{"_3550":1209,"_30605":1189,"_21201":53728,"_5":14582,"_27821":53682,"_3006":53729},[],"Schedule the request within the window. Do not use `simpleenroll` to bypass it.",{"_3550":1210,"_30605":1189,"_21201":53731,"_5":14582,"_27821":53682,"_3006":53732},[],"Expired certificate, key available",{"_3550":1211,"_30605":1189,"_21201":53734,"_5":14582,"_27821":53682,"_3006":53735},[],"With certificate authentication, review `enable_expired_renewal` and whether Gateway permits presenting that credential. Revocation, subject and the remaining checks still apply.",{"_3550":1212,"_30605":1189,"_21201":53737,"_5":14582,"_27821":53682,"_3006":53738},[],"Renewal through webhook or `NO_AUTH`",{"_3550":1213,"_30605":1189,"_21201":53740,"_5":14582,"_27821":53682,"_3006":53741},[],"The mTLS expiry check does not run in these modes. Define expiry and authorization policy in the corresponding admission process; the flag is not a universal prohibition.",{"_3550":1214,"_30605":1189,"_21201":53743,"_5":14582,"_27821":53682,"_3006":53744},[],"Lost or inaccessible key",{"_3550":1215,"_30605":1189,"_21201":53746,"_5":14582,"_27821":53682,"_3006":53747},[],"You cannot prove possession of the previous identity. Authorize new admission and, if appropriate, controlled replacement; revoke the compromised identity.",{"_3550":1216,"_30605":1189,"_21201":53749,"_5":14582,"_27821":53682,"_3006":53750},[],"Current identity revoked",{"_3550":1217,"_30605":1189,"_21201":53752,"_5":14582,"_27821":53682,"_3006":53753},[],"`simplereenroll` rejects the revoked current certificate. Investigate the reason and prepare an authorized readmission procedure; do not disable authentication to force it.",{"_3550":1218,"_30605":1189,"_21201":53755,"_5":14582,"_27821":53682,"_3006":53756},[],"Device without an identity",{"_3550":1219,"_30605":1189,"_21201":53758,"_5":14582,"_27821":53682,"_3006":53759},[],"Use initial enrollment. For an existing entry, check the replacement restriction in provisioning.",{"_3550":1220,"_30605":1189,"_21201":53761,"_5":14582,"_27821":53682,"_3006":53762},[],"Retired device",{"_3550":1221,"_30605":1189,"_21201":53764,"_5":14582,"_27821":53682,"_3006":53765},[],"Review the operational decision before readmission. Decommissioned state and revocation of the entire history are not equivalent.",{"_3550":1222,"_30605":1189,"_21201":53767,"_5":14582,"_27821":53682,"_3006":53768},[],"Timeout, HTTP 500 or installation failure",{"_3550":1223,"_30605":1189,"_21201":53770,"_5":14582,"_27821":53682,"_3006":53771},[],"Inspect the device, issued certificates and history before retrying. A successor may have been issued or the previous identity revoked.",{"_3550":1224,"_30605":1189,"_21201":53773,"_5":14582,"_27821":53686,"_3006":53774},[],"Schedule renewal with time for disconnections, trust distribution and consumer checks. Stagger requests across the population and bound retries within the window; authentication, subject and policy errors require correcting their cause. Maintain an admitted and tested recovery mechanism for lost keys and pairs that could not be installed.",{"_3550":1225,"_30605":1189,"_21201":53776,"_5":14582,"_27821":53686,"_3006":53777},[],"Continue with Trust distribution, Devices and identities and Troubleshooting.",{"_3550":1226,"_30605":1226,"_5":14934,"_3006":53779,"_30943":53780,"_21201":53781,"_27821":1226},"Enrollment troubleshooting",[49963,51438,52598,52596,52779],[],{"_3550":1227,"_30605":1226,"_21201":53783,"_5":14582,"_27821":1226,"_3006":53784},[],"Locate transport, authentication, registration, issuance and installation failures.",{"_3550":1228,"_30605":1226,"_5":30940,"_21201":53786,"_27821":53787,"_3006":53788},[],"/docs/platform/iot-fleets/enrollment/troubleshooting#diagnostics-and-compatibility","Diagnostics and compatibility",{"_3550":1229,"_30605":1226,"_5":30940,"_21201":53790,"_27821":53791,"_3006":53792},[],"/docs/platform/iot-fleets/enrollment/troubleshooting#error-codes-and-diagnostics","Error codes and diagnostics",{"_3550":1230,"_30605":1226,"_5":30940,"_21201":53794,"_27821":53795,"_3006":53342},[],"/docs/platform/iot-fleets/enrollment/troubleshooting#compatibility-notes",{"_3550":1231,"_30605":1226,"_5":30940,"_21201":53797,"_27821":53798,"_3006":53799},[],"/docs/platform/iot-fleets/enrollment/troubleshooting#est-enrollment-fails","EST enrollment fails",{"_3550":1232,"_30605":1226,"_21201":53801,"_5":14582,"_27821":1226,"_3006":53802},[],"Diagnose one operation and device at a time. Record the DMS/APS, endpoint, time, HTTP code, presented serial and CSR CN. Retain the response without including private keys or webhook credentials in the report.",{"_3550":1233,"_30605":1226,"_21201":53804,"_5":14582,"_27821":53791,"_3006":53805},[],"The EST controller normally returns 400 when rejecting input and 500 when the service rejects or fails the operation. A 500 can also represent a policy denial; it does not mean retrying is safe. Gateway can produce its own codes and bodies. Examine the actual body and persisted result.",{"_3550":1234,"_30605":1226,"_21201":53807,"_5":14582,"_27821":53791,"_3006":53808},[],"Symptom or message",{"_3550":1235,"_30605":1226,"_21201":53810,"_5":14582,"_27821":53791,"_3006":53572},[],{"_3550":1236,"_30605":1226,"_21201":53812,"_5":14582,"_27821":53791,"_3006":53813},[],"curl rejects TLS, name or issuer",{"_3550":1237,"_30605":1226,"_21201":53815,"_5":14582,"_27821":53791,"_3006":53816},[],"URL, clock, server SAN and approved root in `est-trust.pem`. Resolve trust in Deployment; do not skip verification.",{"_3550":1238,"_30605":1226,"_21201":53818,"_5":14582,"_27821":53791,"_3006":53819},[],"404 or missing APS",{"_3550":1239,"_30605":1226,"_21201":53821,"_5":14582,"_27821":53791,"_3006":53822},[],"Public route `/.well-known/est/{DMS_ID}/{operation}` and existing DMS. APS is not the service name.",{"_3550":1240,"_30605":1226,"_21201":53824,"_5":14582,"_27821":53791,"_3006":53825},[],"400, CSR or format error",{"_3550":1241,"_30605":1226,"_21201":53827,"_5":14582,"_27821":53791,"_3006":53828},[],"`Content-Type: application/pkcs10`, Base64 of DER, valid signature and a body preserved without double encoding.",{"_3550":1242,"_30605":1226,"_21201":53830,"_5":14582,"_27821":53791,"_3006":53831},[],"Missing credential or invalid certificate",{"_3550":1243,"_30605":1226,"_21201":53833,"_5":14582,"_27821":53791,"_3006":53834},[],"Operation mode, validating CA, dates, revocation and credential delivery by Gateway. Do not confuse server TLS trust with the bootstrap CA.",{"_3550":1244,"_30605":1226,"_21201":53836,"_5":14582,"_27821":53791,"_3006":53837},[],"Webhook denies, times out or responds without authorization",{"_3550":1245,"_30605":1226,"_21201":53839,"_5":14582,"_27821":53791,"_3006":53840},[],"Configuration, connectivity and JSON response with `authorized: true`. There is no automatic fallback to `NO_AUTH`.",{"_3550":1246,"_30605":1226,"_21201":53842,"_5":14582,"_27821":53791,"_3006":53843},[],"`unexpected status code: <n>: redirects are not followed`",{"_3550":1247,"_30605":1226,"_21201":53845,"_5":14582,"_27821":53791,"_3006":53846},[],"The webhook answered with a redirect. Configure the final absolute `http` or `https` URL in the webhook config; redirects are never followed.",{"_3550":1248,"_30605":1226,"_21201":53848,"_5":14582,"_27821":53791,"_3006":53849},[],"`webhook response exceeds 1048576 bytes`",{"_3550":1249,"_30605":1226,"_21201":53851,"_5":14582,"_27821":53791,"_3006":53852},[],"The receiver returned more than 1 MiB of JSON. Reduce the response of the authorization webhook.",{"_3550":1250,"_30605":1226,"_21201":53854,"_5":14582,"_27821":53791,"_3006":53855},[],"`webhook config must not reference files`",{"_3550":1251,"_30605":1226,"_21201":53857,"_5":14582,"_27821":53791,"_3006":53858},[],"The webhook config points to files (`ca_cert_file`, `mtls_options.cert_file`, `mtls_options.key_file`). For mTLS, enter the certificate and key as Base64-encoded PEM in `cert_content` and `key_content`, or as plain PEM; remove any other file field, including `ca_cert_file`, which has no inline equivalent (the receiver certificate must chain to the system trust store). See the webhook credentials guidance in DMS.",{"_3550":1252,"_30605":1226,"_21201":53860,"_5":14582,"_27821":53791,"_3006":53861},[],"`mtls_options.cert_content must be base64-encoded PEM`",{"_3550":1253,"_30605":1226,"_21201":53863,"_5":14582,"_27821":53791,"_3006":53864},[],"The value is neither Base64-encoded PEM nor plain PEM: it is a file path or Base64 of non-PEM data. Enter the certificate and key as Base64-encoded PEM, like certificates elsewhere in the API, or as plain PEM (see the webhook settings in DMS). The same message names `mtls_options.key_content` when the key is the offending value.",{"_3550":1254,"_30605":1226,"_21201":53866,"_5":14582,"_27821":53791,"_3006":53867},[],"`webhook mTLS certificate and key are invalid: …`",{"_3550":1255,"_30605":1226,"_21201":53869,"_5":14582,"_27821":53791,"_3006":53870},[],"The certificate and key do not form a matching pair. Enter both values from the same pair; the check runs when the DMS is saved and again on every webhook call.",{"_3550":1256,"_30605":1226,"_21201":53872,"_5":14582,"_27821":53791,"_3006":53873},[],"400 `struct validation error` creating or updating a DMS",{"_3550":1257,"_30605":1226,"_21201":53875,"_5":14582,"_27821":53791,"_3006":53876},[],"The webhook config of the operation that uses it is invalid. Review `external_webhook_settings` in DMS.",{"_3550":1258,"_30605":1226,"_21201":53878,"_5":14582,"_27821":53791,"_3006":53879},[],"HTTP 500 with an `err` body on enroll or reenroll",{"_3550":1259,"_30605":1226,"_21201":53881,"_5":14582,"_27821":53791,"_3006":53882},[],"Service failures reach the EST client as 500 with a body of `err` plus the message; webhook authorization errors are named there.",{"_3550":1260,"_30605":1226,"_21201":53884,"_5":14582,"_27821":53791,"_3006":53885},[],"`device not preregistered`",{"_3550":1261,"_30605":1226,"_21201":53887,"_5":14582,"_27821":53791,"_3006":53888},[],"PRE\\_REGISTRATION requires an existing inventory entry.",{"_3550":1262,"_30605":1226,"_21201":53890,"_5":14582,"_27821":53791,"_3006":53891},[],"`forbiddenNewEnrollment`",{"_3550":1263,"_30605":1226,"_21201":53893,"_5":14582,"_27821":53791,"_3006":53894},[],"An existing device requires replacement to be enabled, even in No Identity. Investigate before enabling the flag.",{"_3550":1264,"_30605":1226,"_21201":53896,"_5":14582,"_27821":53791,"_3006":53897},[],"Different owning DMS",{"_3550":1265,"_30605":1226,"_21201":53899,"_5":14582,"_27821":53791,"_3006":53900},[],"CN/ID, global inventory and owning DMS; do not reuse an ID from another context.",{"_3550":1266,"_30605":1226,"_21201":53902,"_5":14582,"_27821":53791,"_3006":53903},[],"`invalid RawSubject bytes`",{"_3550":1267,"_30605":1226,"_21201":53905,"_5":14582,"_27821":53791,"_3006":53906},[],"CSR subject versus the current certificate. Preserve its attributes as well as its CN.",{"_3550":1268,"_30605":1226,"_21201":53908,"_5":14582,"_27821":53791,"_3006":53909},[],"`invalid reenroll window`",{"_3550":1269,"_30605":1226,"_21201":53911,"_5":14582,"_27821":53791,"_3006":53912},[],"Current identity's NotAfter and reenrollment\\_delta. Alert thresholds do not change that window.",{"_3550":1270,"_30605":1226,"_21201":53914,"_5":14582,"_27821":53791,"_3006":53915},[],"Current certificate revoked",{"_3550":1271,"_30605":1226,"_21201":53917,"_5":14582,"_27821":53791,"_3006":53918},[],"Renewal rejected; prepare authorized recovery according to the cause.",{"_3550":1272,"_30605":1226,"_21201":53920,"_5":14582,"_27821":53791,"_3006":53921},[],"CA, profile or signing error",{"_3550":1273,"_30605":1226,"_21201":53923,"_5":14582,"_27821":53791,"_3006":53924},[],"Active CA, available key, selected profile and restrictions. Successful cacerts does not prove issuance.",{"_3550":1274,"_30605":1226,"_21201":53926,"_5":14582,"_27821":53791,"_3006":53927},[],"HTTP 200 without a device connection",{"_3550":1275,"_30605":1226,"_21201":53929,"_5":14582,"_27821":53791,"_3006":53930},[],"Installed pair, chain, uses, consumer trust and permissions. Also check the slot and history.",{"_3550":1276,"_30605":1226,"_21201":53932,"_5":14582,"_27821":53791,"_3006":53933},[],"Timeout or error after issuance",{"_3550":1277,"_30605":1226,"_21201":53935,"_5":14582,"_27821":53791,"_3006":53936},[],"New certificates, current slot and previous identity's state before retrying.",{"_3550":1278,"_30605":1226,"_21201":53938,"_5":14582,"_27821":53795,"_3006":53939},[],"The examples use the contract of the examined backend. Do not automatically attribute that behavior to another release. Check the saved renewal mode and Gateway behavior with expired certificates and the bootstrap CA.",{"_3550":1279,"_30605":1226,"_21201":53941,"_5":14582,"_27821":53795,"_3006":53942},[],"The default response is Base64-encoded DER PKCS#7; PEM through `Accept: application/x-pem-file` is a Lamassu extension. ServerKeyGen returns multipart and requires handling each part separately. See the EST reference.",{"_3550":1280,"_30605":1226,"_21201":53944,"_5":14582,"_27821":53798,"_3006":53945},[],"Check HTTPS with the approved root and query cacerts for the correct APS.",{"_3550":1281,"_30605":1226,"_21201":53947,"_5":14582,"_27821":53798,"_3006":53948},[],"Review the saved DMS: protocol, registration, authentication for that operation, CA, profile and window.",{"_3550":1282,"_30605":1226,"_21201":53950,"_5":14582,"_27821":53798,"_3006":53951},[],"Verify the CSR locally and relate its CN to the inventory.",{"_3550":1283,"_30605":1226,"_21201":53953,"_5":14582,"_27821":53798,"_3006":53954},[],"Make one request, save headers/body and query the device and certificates.",{"_3550":1284,"_30605":1226,"_21201":53956,"_5":14582,"_27821":53798,"_3006":53957},[],"If you receive an identity, check the key, subject, use and connection with the consumer.",{"_3550":1285,"_30605":1226,"_21201":53959,"_5":14582,"_27821":53798,"_3006":53960},[],"External bootstrap revocation checks have limitations: absence of evidence can be accepted, and OCSP Unknown does not cause the same rejection as Revoked. Do not assume a policy that rejects every uncertainty. An intermediate CA in the TLS chain does not prove that the entire chain reached the DMS validator either.",{"_3550":1286,"_30605":1226,"_21201":53962,"_5":14582,"_27821":53798,"_3006":53963},[],"For logs, networking, pods or Gateway headers, continue in Deployment troubleshooting. For identities issued, revoked or bound partially, use Renewal and recovery and Devices and identities.",{"_3550":1287,"_30605":1287,"_5":14934,"_3006":53965,"_30943":53966,"_21201":53967,"_27821":1287},"Trust distribution and updates",[49963,51438,52598,52596,52779],[],{"_3550":1288,"_30605":1287,"_21201":53969,"_5":14582,"_27821":1287,"_3006":53970},[],"Separate roots, intermediates and initial TLS trust when distributing or migrating certificates.",{"_3550":1289,"_30605":1287,"_5":30940,"_21201":53972,"_27821":53973,"_3006":53974},[],"/docs/platform/iot-fleets/enrollment/trust-distribution#three-trust-relationships","Three trust relationships",{"_3550":1290,"_30605":1287,"_5":30940,"_21201":53976,"_27821":53977,"_3006":53978},[],"/docs/platform/iot-fleets/enrollment/trust-distribution#what-cacerts-returns","What cacerts returns",{"_3550":1291,"_30605":1287,"_5":30940,"_21201":53980,"_27821":53981,"_3006":53982},[],"/docs/platform/iot-fleets/enrollment/trust-distribution#install-the-required-material","Install the required material",{"_3550":1292,"_30605":1287,"_5":30940,"_21201":53984,"_27821":53985,"_3006":53986},[],"/docs/platform/iot-fleets/enrollment/trust-distribution#migrate-trust","Migrate trust",{"_3550":1293,"_30605":1287,"_5":30940,"_21201":53988,"_27821":53989,"_3006":53990},[],"/docs/platform/iot-fleets/enrollment/trust-distribution#check-the-update","Check the update",{"_3550":1294,"_30605":1287,"_21201":53992,"_5":14582,"_27821":1287,"_3006":53993},[],"This guide is for device and consumer trust administrators. You need issuer inventory, trust-store access and an authenticated update channel. Distributing certificates is separate from choosing trusted anchors.",{"_3550":1295,"_30605":1287,"_21201":53995,"_5":14582,"_27821":53973,"_3006":53996},[],"Relationship",{"_3550":1296,"_30605":1287,"_21201":53998,"_5":14582,"_27821":53973,"_3006":53999},[],"Material prepared by its owner",{"_3550":1297,"_30605":1287,"_21201":54001,"_5":14582,"_27821":53973,"_3006":54002},[],"Device → EST server",{"_3550":1298,"_30605":1287,"_21201":54004,"_5":14582,"_27821":53973,"_3006":54005},[],"Previously verified server root, chain or pin and TLS name.",{"_3550":1299,"_30605":1287,"_21201":54007,"_5":14582,"_27821":53973,"_3006":54008},[],"DMS → requester",{"_3550":1300,"_30605":1287,"_21201":54010,"_5":14582,"_27821":53973,"_3006":54011},[],"CAs and rules authorizing initial or renewal credentials.",{"_3550":1301,"_30605":1287,"_21201":54013,"_5":14582,"_27821":53973,"_3006":54014},[],"Consumer → device",{"_3550":1302,"_30605":1287,"_21201":54016,"_5":14582,"_27821":53973,"_3006":54017},[],"Operational identity roots, intermediates, validation and permissions.",{"_3550":1303,"_30605":1287,"_21201":54019,"_5":14582,"_27821":53973,"_3006":54020},[],"Obtaining a certificate does not automatically configure these relationships in third parties. Review the Trust model.",{"_3550":1304,"_30605":1287,"_21201":54022,"_5":14582,"_27821":53977,"_3006":54023},[],"The DMS may include the available downstream TLS certificate, selected Managed CAs and enrollment CA. Selecting the issuer does not include every ancestor. The set may contain leaves, roots and intermediates, including multiple hierarchies during migration.",{"_3550":1305,"_30605":1287,"_21201":54025,"_5":14582,"_27821":53977,"_3006":54026},[],"Position does not define the chain. Identify certificates by subject, issuer, AKI/SKI, signature and constraints. Download and inspect using EST client.",{"_3550":1306,"_30605":1287,"_21201":54028,"_5":14582,"_27821":53981,"_3006":54029},[],"Keep initial EST server trust separate from identity consumer trust.",{"_3550":1307,"_30605":1287,"_21201":54031,"_5":14582,"_27821":53981,"_3006":54032},[],"Select policy-approved roots as anchors.",{"_3550":1308,"_30605":1287,"_21201":54034,"_5":14582,"_27821":53981,"_3006":54035},[],"Retain intermediates for chain building or presentation; do not automatically turn them into roots.",{"_3550":1309,"_30605":1287,"_21201":54037,"_5":14582,"_27821":53981,"_3006":54038},[],"Present the leaf and required intermediates in mTLS. Normally the peer already trusts its root and does not need it sent.",{"_3550":1310,"_30605":1287,"_21201":54040,"_5":14582,"_27821":53981,"_3006":54041},[],"Verify chain, dates, names, usages and revocation from the consumer.",{"_3550":1311,"_30605":1287,"_21201":54043,"_5":14582,"_27821":53981,"_3006":54044},[],"Do not indiscriminately use all of `cacerts.pem` as `-CAfile`: this can expand trusted authorities, hide missing intermediates or trust a TLS leaf intended for another purpose.",{"_3550":1312,"_30605":1287,"_21201":54046,"_5":14582,"_27821":53985,"_3006":54047},[],"Before changing Enrollment CA, inventory disconnected equipment, bootstrap and operational certificates, and consumers. Distribute the new root and required intermediates; check that a cohort accepts both old and new chains.",{"_3550":1313,"_30605":1287,"_21201":54049,"_5":14582,"_27821":53985,"_3006":54050},[],"In the DMS, separate distributed CAs from the re-enrollment validation CAs at `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`, used for re-enrollment credentials. That list is optional because the enrollment CA always validates re-enrollment credentials, but when switching the enrollment CA, add the previous issuance CA to it so old-CA identities keep re-enrolling during overlap. The inspected validator tries the enrollment CA followed by those CAs against the received leaf; accepting a multilevel chain requires checking what reaches the service and which issuer is configured.",{"_3550":1314,"_30605":1287,"_21201":54052,"_5":14582,"_27821":53985,"_3006":54053},[],"Switch issuance, renew in cohorts and compare the installed serial with the active slot. Remove previous trust once no legitimate equipment needs it and policy permits ending overlap. Follow Hierarchy and rotation for the PKI operation.",{"_3550":1315,"_30605":1287,"_21201":54055,"_5":14582,"_27821":53989,"_3006":54056},[],"Test an old identity allowed during overlap, a new one, an unknown chain and the result after removing old trust. Keep trust-store version, approved set, date and result. Reachable `/cacerts` establishes distribution only; it does not establish installation or acceptance across every device.",{"_3550":1316,"_30605":1316,"_5":14934,"_3006":54058,"_30943":54059,"_21201":54061,"_27821":1316},"AWS IoT Core",[49963,51438,52598,52596,54060],"Integrations",[],{"_3550":1317,"_30605":1316,"_21201":54063,"_5":14582,"_27821":1316,"_3006":54064},[],"Lamassu's connector for AWS IoT Core syncs device identities with the AWS platform, handling CA registration, Thing provisioning and certificate lifecycle automatically and event-driven.",{"_3550":1318,"_30605":1316,"_5":30940,"_21201":54066,"_27821":54067,"_3006":54068},[],"/docs/platform/iot-fleets/integrations/aws-iot-core#connector-architecture","Connector architecture",{"_3550":1319,"_30605":1316,"_5":30940,"_21201":54070,"_27821":54071,"_3006":54072},[],"/docs/platform/iot-fleets/integrations/aws-iot-core#prerequisites","Prerequisites",{"_3550":1320,"_30605":1316,"_5":30940,"_21201":54074,"_27821":54075,"_3006":54076},[],"/docs/platform/iot-fleets/integrations/aws-iot-core#required-iam-permissions","Required IAM permissions",{"_3550":1321,"_30605":1316,"_5":30940,"_21201":54078,"_27821":54079,"_3006":54080},[],"/docs/platform/iot-fleets/integrations/aws-iot-core#configuration-parameters","Configuration parameters",{"_3550":1322,"_30605":1316,"_5":30940,"_21201":54082,"_27821":54083,"_3006":54084},[],"/docs/platform/iot-fleets/integrations/aws-iot-core#events-and-aws-resources","Events and AWS resources",{"_3550":1323,"_30605":1316,"_5":30940,"_21201":54086,"_27821":54087,"_3006":54088},[],"/docs/platform/iot-fleets/integrations/aws-iot-core#ca-registration-in-aws-iot-core","CA registration in AWS IoT Core",{"_3550":1324,"_30605":1316,"_5":30940,"_21201":54090,"_27821":54091,"_3006":54092},[],"/docs/platform/iot-fleets/integrations/aws-iot-core#how-to-request-registration","How to request registration",{"_3550":1325,"_30605":1316,"_5":30940,"_21201":54094,"_27821":54095,"_3006":54096},[],"/docs/platform/iot-fleets/integrations/aws-iot-core#ca-registration-states","CA registration states",{"_3550":1326,"_30605":1316,"_5":30940,"_21201":54098,"_27821":54099,"_3006":54100},[],"/docs/platform/iot-fleets/integrations/aws-iot-core#primary-account","Primary Account",{"_3550":1327,"_30605":1316,"_5":30940,"_21201":54102,"_27821":54103,"_3006":54104},[],"/docs/platform/iot-fleets/integrations/aws-iot-core#secondary-account-sni-only","Secondary Account (SNI-only)",{"_3550":1328,"_30605":1316,"_5":30940,"_21201":54106,"_27821":54107,"_3006":54108},[],"/docs/platform/iot-fleets/integrations/aws-iot-core#dms-configuration","DMS configuration",{"_3550":1329,"_30605":1316,"_5":30940,"_21201":54110,"_27821":54111,"_3006":54112},[],"/docs/platform/iot-fleets/integrations/aws-iot-core#none-mode","`none` mode",{"_3550":1330,"_30605":1316,"_5":30940,"_21201":54114,"_27821":54115,"_3006":54116},[],"/docs/platform/iot-fleets/integrations/aws-iot-core#auto-mode","`auto` mode",{"_3550":1331,"_30605":1316,"_5":30940,"_21201":54118,"_27821":54119,"_3006":54120},[],"/docs/platform/iot-fleets/integrations/aws-iot-core#jitp-mode","`jitp` mode",{"_3550":1332,"_30605":1316,"_5":30940,"_21201":54122,"_27821":54123,"_3006":54124},[],"/docs/platform/iot-fleets/integrations/aws-iot-core#dms-registration-mode-states","DMS registration-mode states",{"_3550":1333,"_30605":1316,"_5":30940,"_21201":54126,"_27821":54127,"_3006":54128},[],"/docs/platform/iot-fleets/integrations/aws-iot-core#device-provisioning-automatic-mode","Device provisioning (automatic mode)",{"_3550":1334,"_30605":1316,"_5":30940,"_21201":54130,"_27821":54131,"_3006":54132},[],"/docs/platform/iot-fleets/integrations/aws-iot-core#thing-lifecycle","Thing lifecycle",{"_3550":1335,"_30605":1316,"_5":30940,"_21201":54134,"_27821":54135,"_3006":54136},[],"/docs/platform/iot-fleets/integrations/aws-iot-core#device-provisioning-jitp-mode","Device provisioning (JITP mode)",{"_3550":1336,"_30605":1316,"_5":30940,"_21201":54138,"_27821":54139,"_3006":54140},[],"/docs/platform/iot-fleets/integrations/aws-iot-core#certificate-status-synchronization","Certificate status synchronization",{"_3550":1337,"_30605":1316,"_5":30940,"_21201":54142,"_27821":54143,"_3006":54144},[],"/docs/platform/iot-fleets/integrations/aws-iot-core#certificate-status-states","Certificate status states",{"_3550":1338,"_30605":1316,"_5":30940,"_21201":54146,"_27821":54147,"_3006":54148},[],"/docs/platform/iot-fleets/integrations/aws-iot-core#forced-disconnect-on-revocation","Forced disconnect on revocation",{"_3550":1339,"_30605":1316,"_5":30940,"_21201":54150,"_27821":54151,"_3006":54152},[],"/docs/platform/iot-fleets/integrations/aws-iot-core#device-shadow-and-automation","Device Shadow and automation",{"_3550":1340,"_30605":1316,"_5":30940,"_21201":54154,"_27821":54155,"_3006":54156},[],"/docs/platform/iot-fleets/integrations/aws-iot-core#what-the-connector-writes-to-the-shadow","What the connector writes to the shadow",{"_3550":1341,"_30605":1316,"_5":30940,"_21201":54158,"_27821":54159,"_3006":54160},[],"/docs/platform/iot-fleets/integrations/aws-iot-core#aws-iot-policies","AWS IoT policies",{"_3550":1342,"_30605":1316,"_5":30940,"_21201":54162,"_27821":54163,"_3006":54164},[],"/docs/platform/iot-fleets/integrations/aws-iot-core#troubleshooting","Troubleshooting",{"_3550":1343,"_30605":1316,"_21201":54166,"_5":14582,"_27821":1316,"_3006":54167},[],"Lamassu's integration with AWS IoT Core bridges the PKI managed by Lamassu and AWS's connectivity platform. When a device obtains its certificate through the EST enrollment process, the connector ensures that certificate and its associated identity are recognized in AWS IoT Core without manual intervention. The result is that the device can authenticate directly to AWS with the same X.509 certificate Lamassu issued.",{"_3550":1344,"_30605":1316,"_21201":54169,"_5":14582,"_27821":1316,"_3006":54170},[],"From a protocol standpoint, the device authenticates to AWS IoT Core via mutual TLS (mTLS): it presents its Lamassu-issued X.509 certificate as the client certificate, and AWS IoT Core verifies the certificate chain up to the CA registered in the account. Lamassu acts as the certification authority (CA); the connector ensures that CA is registered in AWS and that the device's certificate is known to the platform before the device attempts to connect (in `auto` mode) or on its first connection (in JITP mode).",{"_3550":1345,"_30605":1316,"_21201":54172,"_5":14582,"_27821":1316,"_3006":54173},[],"This document is aimed both at the PKI administrator, who needs to configure the connector and register CAs, and at the device firmware developer, who needs to understand how Things are named, how the Device Shadow works and what happens when a certificate is revoked. For the firmware developer, the most important fact is that **the AWS Thing name (ThingName) always corresponds to the Common Name (CN) of the certificate issued by Lamassu**, regardless of the provisioning mode.",{"_3550":1346,"_30605":1316,"_21201":54175,"_5":14582,"_27821":54067,"_3006":54176},[],"The AWS IoT Core connector is an independent Go process, a binary or container separate from Lamassu's core. In a monolithic deployment it is compiled by default (build tag `!noaws`) and activated with `aws_iot_manager.enabled: true` in the configuration file. In distributed deployments, it runs as its own container with access to Lamassu's CA, DMS Manager and Device Manager services over HTTP.",{"_3550":1347,"_30605":1316,"_21201":54178,"_5":14582,"_27821":54067,"_3006":54179},[],"The connector does not poll Lamassu's services periodically. Instead, it **subscribes to Lamassu's internal event bus** (AMQP or AWS SQS/SNS, configurable) and reacts to the events it cares about: CA creation or update, DMS creation or update, device identity binding, certificate status change, certificate metadata update and device metadata update. This event-driven model ensures synchronization with AWS is nearly immediate and produces no polling load.",{"_3550":1348,"_30605":1316,"_21201":54181,"_5":14582,"_27821":54067,"_3006":54182},[],"To avoid infinite loops, the connector ignores any event whose CloudEvent `source` field matches its own origin URI. This prevents the metadata writes the connector itself performs from re-triggering the same flow.",{"_3550":1349,"_30605":1316,"_21201":54184,"_5":14582,"_27821":54067,"_3006":54185},[],"When several connectors run in parallel, for example for different AWS accounts, each instance has its own `connector_id`. All metadata the connector writes to Lamassu is stored under the key `lamassu.io/iot/{connector_id}`, allowing coexistence without collisions.",{"_3550":1350,"_30605":1316,"_21201":54187,"_5":14582,"_27821":54071,"_3006":54188},[],"Before enabling the connector you need an AWS account with the proper IAM permissions and the connector correctly configured. The deployment process (Docker Compose, Kubernetes or binary) is described in the deployment documentation.",{"_3550":1351,"_30605":1316,"_21201":54190,"_5":14582,"_27821":54075,"_3006":54191},[],"The IAM identity operating the connector needs at minimum the following permissions on the target account's resources:",{"_3550":1352,"_30605":1316,"_21201":54193,"_5":14582,"_27821":54075,"_3006":54194},[],"IAM action",{"_3550":1353,"_30605":1316,"_21201":54196,"_5":14582,"_27821":54075,"_3006":50353},[],{"_3550":1354,"_30605":1316,"_21201":54198,"_5":14582,"_27821":54075,"_3006":54199},[],"`iot:GetRegistrationCode`",{"_3550":1355,"_30605":1316,"_21201":54201,"_5":14582,"_27821":54075,"_3006":54202},[],"Obtain the verification code for CA registration in the Primary Account",{"_3550":1356,"_30605":1316,"_21201":54204,"_5":14582,"_27821":54075,"_3006":54205},[],"`iot:RegisterCACertificate`",{"_3550":1357,"_30605":1316,"_21201":54207,"_5":14582,"_27821":54075,"_3006":54208},[],"Register the CA in AWS IoT",{"_3550":1358,"_30605":1316,"_21201":54210,"_5":14582,"_27821":54075,"_3006":54211},[],"`iot:DescribeCACertificate`",{"_3550":1359,"_30605":1316,"_21201":54213,"_5":14582,"_27821":54075,"_3006":54214},[],"Check the CA registration status",{"_3550":1360,"_30605":1316,"_21201":54216,"_5":14582,"_27821":54075,"_3006":54217},[],"`iot:CreateThing` / `iot:UpdateThing`",{"_3550":1361,"_30605":1316,"_21201":54219,"_5":14582,"_27821":54075,"_3006":54220},[],"Create or update Things in IoT Core",{"_3550":1362,"_30605":1316,"_21201":54222,"_5":14582,"_27821":54075,"_3006":54223},[],"`iot:RegisterThing`",{"_3550":1363,"_30605":1316,"_21201":54225,"_5":14582,"_27821":54075,"_3006":54226},[],"Provision Things through a template",{"_3550":1364,"_30605":1316,"_21201":54228,"_5":14582,"_27821":54075,"_3006":54229},[],"`iot:RegisterCertificate`",{"_3550":1365,"_30605":1316,"_21201":54231,"_5":14582,"_27821":54075,"_3006":54232},[],"Register device certificates",{"_3550":1366,"_30605":1316,"_21201":54234,"_5":14582,"_27821":54075,"_3006":54235},[],"`iot:UpdateCertificate`",{"_3550":1367,"_30605":1316,"_21201":54237,"_5":14582,"_27821":54075,"_3006":54238},[],"Change a certificate's status (ACTIVE / INACTIVE / REVOKED)",{"_3550":1368,"_30605":1316,"_21201":54240,"_5":14582,"_27821":54075,"_3006":54241},[],"`iot:CreatePolicy` / `iot:AttachPolicy`",{"_3550":1369,"_30605":1316,"_21201":54243,"_5":14582,"_27821":54075,"_3006":54244},[],"Create and attach IoT policies",{"_3550":1370,"_30605":1316,"_21201":54246,"_5":14582,"_27821":54075,"_3006":54247},[],"`iot:CreateThingGroup` / `iot:AddThingToThingGroup`",{"_3550":1371,"_30605":1316,"_21201":54249,"_5":14582,"_27821":54075,"_3006":54250},[],"Manage Thing groups",{"_3550":1372,"_30605":1316,"_21201":54252,"_5":14582,"_27821":54075,"_3006":54253},[],"`iot:CreateProvisioningTemplate`",{"_3550":1373,"_30605":1316,"_21201":54255,"_5":14582,"_27821":54075,"_3006":54256},[],"Create JITP templates",{"_3550":1374,"_30605":1316,"_21201":54258,"_5":14582,"_27821":54075,"_3006":54259},[],"`iotdata:GetThingShadow` / `iotdata:UpdateThingShadow`",{"_3550":1375,"_30605":1316,"_21201":54261,"_5":14582,"_27821":54075,"_3006":54262},[],"Read and write the Device Shadow",{"_3550":1376,"_30605":1316,"_21201":54264,"_5":14582,"_27821":54075,"_3006":54265},[],"The forced-disconnect mechanism after revocation also requires access to the AWS IoT data plane API (`iot:Connect` with SigV4 over WebSocket), negotiated implicitly with the connector's credentials.",{"_3550":1377,"_30605":1316,"_21201":54267,"_5":14582,"_27821":54079,"_3006":54268},[],"Parameter",{"_3550":1378,"_30605":1316,"_21201":54270,"_5":14582,"_27821":54079,"_3006":54271},[],"Type",{"_3550":1379,"_30605":1316,"_21201":54273,"_5":14582,"_27821":54079,"_3006":54274},[],"Required",{"_3550":1380,"_30605":1316,"_21201":54276,"_5":14582,"_27821":54079,"_3006":54277},[],"Description",{"_3550":1381,"_30605":1316,"_21201":54279,"_5":14582,"_27821":54079,"_3006":54280},[],"`connector_id`",{"_3550":1382,"_30605":1316,"_21201":54282,"_5":14582,"_27821":54079,"_3006":25326},[],{"_3550":1383,"_30605":1316,"_21201":54284,"_5":14582,"_27821":54079,"_3006":54285},[],"Yes",{"_3550":1384,"_30605":1316,"_21201":54287,"_5":14582,"_27821":54079,"_3006":54288},[],"Unique identifier of this connector instance. Used as the metadata namespace: `lamassu.io/iot/{connector_id}`.",{"_3550":1385,"_30605":1316,"_21201":54290,"_5":14582,"_27821":54079,"_3006":54291},[],"`aws_config.region`",{"_3550":1386,"_30605":1316,"_21201":54293,"_5":14582,"_27821":54079,"_3006":25326},[],{"_3550":1387,"_30605":1316,"_21201":54295,"_5":14582,"_27821":54079,"_3006":54285},[],{"_3550":1388,"_30605":1316,"_21201":54297,"_5":14582,"_27821":54079,"_3006":54298},[],"AWS region where the connector operates.",{"_3550":1389,"_30605":1316,"_21201":54300,"_5":14582,"_27821":54079,"_3006":54301},[],"`aws_config.auth_method`",{"_3550":1390,"_30605":1316,"_21201":54303,"_5":14582,"_27821":54079,"_3006":25326},[],{"_3550":1391,"_30605":1316,"_21201":54305,"_5":14582,"_27821":54079,"_3006":54285},[],{"_3550":1392,"_30605":1316,"_21201":54307,"_5":14582,"_27821":54079,"_3006":54308},[],"Authentication method: `static`, `role` or empty (SDK default credential chain).",{"_3550":1393,"_30605":1316,"_21201":54310,"_5":14582,"_27821":54079,"_3006":54311},[],"`aws_config.access_key_id`",{"_3550":1394,"_30605":1316,"_21201":54313,"_5":14582,"_27821":54079,"_3006":25326},[],{"_3550":1395,"_30605":1316,"_21201":54315,"_5":14582,"_27821":54079,"_3006":54316},[],"Only with `auth_method=static`",{"_3550":1396,"_30605":1316,"_21201":54318,"_5":14582,"_27821":54079,"_3006":54319},[],"AWS access key.",{"_3550":1397,"_30605":1316,"_21201":54321,"_5":14582,"_27821":54079,"_3006":54322},[],"`aws_config.secret_access_key`",{"_3550":1398,"_30605":1316,"_21201":54324,"_5":14582,"_27821":54079,"_3006":25326},[],{"_3550":1399,"_30605":1316,"_21201":54326,"_5":14582,"_27821":54079,"_3006":54316},[],{"_3550":1400,"_30605":1316,"_21201":54328,"_5":14582,"_27821":54079,"_3006":54329},[],"AWS secret key.",{"_3550":1401,"_30605":1316,"_21201":54331,"_5":14582,"_27821":54079,"_3006":54332},[],"`aws_config.session_token`",{"_3550":1402,"_30605":1316,"_21201":54334,"_5":14582,"_27821":54079,"_3006":25326},[],{"_3550":1403,"_30605":1316,"_21201":54336,"_5":14582,"_27821":54079,"_3006":54337},[],"No",{"_3550":1404,"_30605":1316,"_21201":54339,"_5":14582,"_27821":54079,"_3006":54340},[],"Session token (with `auth_method=static`).",{"_3550":1405,"_30605":1316,"_21201":54342,"_5":14582,"_27821":54079,"_3006":54343},[],"`aws_config.role_arn`",{"_3550":1406,"_30605":1316,"_21201":54345,"_5":14582,"_27821":54079,"_3006":25326},[],{"_3550":1407,"_30605":1316,"_21201":54347,"_5":14582,"_27821":54079,"_3006":54348},[],"Only with `auth_method=role`",{"_3550":1408,"_30605":1316,"_21201":54350,"_5":14582,"_27821":54079,"_3006":54351},[],"ARN of the role to assume.",{"_3550":1409,"_30605":1316,"_21201":54353,"_5":14582,"_27821":54079,"_3006":54354},[],"`aws_config.endpoint_url`",{"_3550":1410,"_30605":1316,"_21201":54356,"_5":14582,"_27821":54079,"_3006":25326},[],{"_3550":1411,"_30605":1316,"_21201":54358,"_5":14582,"_27821":54079,"_3006":54337},[],{"_3550":1412,"_30605":1316,"_21201":54360,"_5":14582,"_27821":54079,"_3006":54361},[],"Alternative URL for all AWS services (useful with LocalStack in tests).",{"_3550":1413,"_30605":1316,"_21201":54363,"_5":14582,"_27821":54079,"_3006":54364},[],"`subscriber_event_bus`",{"_3550":1414,"_30605":1316,"_21201":54366,"_5":14582,"_27821":54079,"_3006":17853},[],{"_3550":1415,"_30605":1316,"_21201":54368,"_5":14582,"_27821":54079,"_3006":54285},[],{"_3550":1416,"_30605":1316,"_21201":54370,"_5":14582,"_27821":54079,"_3006":54371},[],"Configuration of the event bus the connector subscribes to (AMQP or AWS SQS/SNS).",{"_3550":1417,"_30605":1316,"_21201":54373,"_5":14582,"_27821":54079,"_3006":54374},[],"`dms_manager_client`",{"_3550":1418,"_30605":1316,"_21201":54376,"_5":14582,"_27821":54079,"_3006":25326},[],{"_3550":1419,"_30605":1316,"_21201":54378,"_5":14582,"_27821":54079,"_3006":54285},[],{"_3550":1420,"_30605":1316,"_21201":54380,"_5":14582,"_27821":54079,"_3006":54381},[],"HTTP URL of Lamassu's DMS Manager service.",{"_3550":1421,"_30605":1316,"_21201":54383,"_5":14582,"_27821":54079,"_3006":54384},[],"`device_manager_client`",{"_3550":1422,"_30605":1316,"_21201":54386,"_5":14582,"_27821":54079,"_3006":25326},[],{"_3550":1423,"_30605":1316,"_21201":54388,"_5":14582,"_27821":54079,"_3006":54285},[],{"_3550":1424,"_30605":1316,"_21201":54390,"_5":14582,"_27821":54079,"_3006":54391},[],"HTTP URL of Lamassu's Device Manager.",{"_3550":1425,"_30605":1316,"_21201":54393,"_5":14582,"_27821":54079,"_3006":54394},[],"`ca_client`",{"_3550":1426,"_30605":1316,"_21201":54396,"_5":14582,"_27821":54079,"_3006":25326},[],{"_3550":1427,"_30605":1316,"_21201":54398,"_5":14582,"_27821":54079,"_3006":54285},[],{"_3550":1428,"_30605":1316,"_21201":54400,"_5":14582,"_27821":54079,"_3006":54401},[],"HTTP URL of Lamassu's CA service.",{"_3550":1429,"_30605":1316,"_21201":54403,"_5":14582,"_27821":54083,"_3006":54404},[],"The connector owns the AWS side of four resource types — CAs, DMS provisioning templates (JITP), device certificates and Things. This section maps the bus events the connector consumes to the AWS resources they touch and to the AWS calls each flow performs. The state machine of each resource lives next to its detailed explanation; the last column links to it. AWS resources are referenced with the notation `IoTCore/<resource>`.",{"_3550":1430,"_30605":1316,"_21201":54406,"_5":14582,"_27821":54083,"_3006":54407},[],"The **CloudEvent type** column lists the event name on Lamassu's internal event bus; the **IAM actions** column lists the exact AWS SDK operations each flow invokes, so the required permissions can be derived directly from this table.",{"_3550":1431,"_30605":1316,"_21201":54409,"_5":14582,"_27821":54083,"_3006":54410},[],"CloudEvent type",{"_3550":1432,"_30605":1316,"_21201":54412,"_5":14582,"_27821":54083,"_3006":54413},[],"Lamassu resource",{"_3550":1433,"_30605":1316,"_21201":54415,"_5":14582,"_27821":54083,"_3006":54416},[],"AWS Resource",{"_3550":1434,"_30605":1316,"_21201":54418,"_5":14582,"_27821":54083,"_3006":54419},[],"IAM actions",{"_3550":1435,"_30605":1316,"_21201":54421,"_5":14582,"_27821":54083,"_3006":54422},[],"AWS calls and effect",{"_3550":1436,"_30605":1316,"_21201":54424,"_5":14582,"_27821":54083,"_3006":54425},[],"Where in this page",{"_3550":1437,"_30605":1316,"_21201":54427,"_5":14582,"_27821":54083,"_3006":54428},[],"`EventCreateCAKey` / `EventImportCAKey` / `EventUpdateCAMetadataKey`",{"_3550":1438,"_30605":1316,"_21201":54430,"_5":14582,"_27821":54083,"_3006":54431},[],"CA",{"_3550":1439,"_30605":1316,"_21201":54433,"_5":14582,"_27821":54083,"_3006":54434},[],"`IoTCore/CACertificate`",{"_3550":1440,"_30605":1316,"_21201":54436,"_5":14582,"_27821":54083,"_3006":54437},[],"`iot:GetRegistrationCode`, `iot:RegisterCACertificate`, `iot:DescribeCACertificate`, `iot:ListCACertificates`",{"_3550":1441,"_30605":1316,"_21201":54439,"_5":14582,"_27821":54083,"_3006":54440},[],"Loads the CA into connector state; a `registration.status = REQUESTED` write fires the registration flow (Primary with verification certificate, or SNI-only) and writes `SUCCEEDED` or `FAILED` back to the CA's metadata.",{"_3550":1442,"_30605":1316,"_21201":54442,"_5":14582,"_27821":54083,"_3006":54096},[],{"_3550":1443,"_30605":1316,"_21201":54444,"_5":14582,"_27821":54083,"_3006":54445},[],"`EventCreateDMSKey` / `EventUpdateDMSKey`",{"_3550":1444,"_30605":1316,"_21201":54447,"_5":14582,"_27821":54083,"_3006":54448},[],"DMS",{"_3550":1445,"_30605":1316,"_21201":54450,"_5":14582,"_27821":54083,"_3006":54451},[],"`IoTCore/ProvisioningTemplate`",{"_3550":1446,"_30605":1316,"_21201":54453,"_5":14582,"_27821":54083,"_3006":54454},[],"`iot:CreateProvisioningTemplate`, `iot:UpdateCACertificate`",{"_3550":1447,"_30605":1316,"_21201":54456,"_5":14582,"_27821":54083,"_3006":54457},[],"In `jitp` mode, attempts to create the provisioning template and attaches it to the registered CA. Non-idempotent: a `PUT /v1/dms/{id}` edit retries the creation and lands in `lamassu-dlq` after 3 retries. Idempotent for `none` and `auto` (configuration only).",{"_3550":1448,"_30605":1316,"_21201":54459,"_5":14582,"_27821":54083,"_3006":54124},[],{"_3550":1449,"_30605":1316,"_21201":54461,"_5":14582,"_27821":54083,"_3006":54462},[],"`EventBindDeviceIdentityKey`",{"_3550":1450,"_30605":1316,"_21201":54464,"_5":14582,"_27821":54083,"_3006":54465},[],"Device",{"_3550":1451,"_30605":1316,"_21201":54467,"_5":14582,"_27821":54083,"_3006":54468},[],"`IoTCore/Policy`, `IoTCore/ThingGroup`, `IoTCore/Thing`",{"_3550":1452,"_30605":1316,"_21201":54470,"_5":14582,"_27821":54083,"_3006":54471},[],"`iot:CreatePolicy` / `iot:DeletePolicyVersion`, `iot:GetPolicy` / `iot:ListPolicyVersions`, `iot:CreateThingGroup`, `iot:DescribeThing` / `iot:ListThingPrincipals`, `iot:RegisterThing`",{"_3550":1453,"_30605":1316,"_21201":54473,"_5":14582,"_27821":54083,"_3006":54474},[],"In `auto` mode: creates/updates policies, ensures Thing groups, revokes stale principals and provisions the Thing via `iot:RegisterThing`. In `jitp` mode: no AWS calls; AWS runs the JITP template on first connection.",{"_3550":1454,"_30605":1316,"_21201":54476,"_5":14582,"_27821":54083,"_3006":54132},[],{"_3550":1455,"_30605":1316,"_21201":54478,"_5":14582,"_27821":54083,"_3006":54479},[],"`EventUpdateCertificateStatusKey`",{"_3550":1456,"_30605":1316,"_21201":54481,"_5":14582,"_27821":54083,"_3006":54482},[],"Certificate",{"_3550":1457,"_30605":1316,"_21201":54484,"_5":14582,"_27821":54083,"_3006":54485},[],"`IoTCore/Certificate`",{"_3550":1458,"_30605":1316,"_21201":54487,"_5":14582,"_27821":54083,"_3006":54488},[],"`iot:UpdateCertificate`, `iot:Connect` (data plane)",{"_3550":1459,"_30605":1316,"_21201":54490,"_5":14582,"_27821":54083,"_3006":54491},[],"Maps status to AWS (`ACTIVE`, `INACTIVE`, `REVOKED`), calls `iot:UpdateCertificate` and forces an MQTT disconnect on revoke.",{"_3550":1460,"_30605":1316,"_21201":54493,"_5":14582,"_27821":54083,"_3006":54144},[],{"_3550":1461,"_30605":1316,"_21201":54495,"_5":14582,"_27821":54083,"_3006":54496},[],"`EventUpdateCertificateMetadataKey` / `EventUpdateDeviceMetadataKey`",{"_3550":1462,"_30605":1316,"_21201":54498,"_5":14582,"_27821":54083,"_3006":54499},[],"Certificate / Device",{"_3550":1463,"_30605":1316,"_21201":54501,"_5":14582,"_27821":54083,"_3006":54502},[],"`IoTCore/Certificate`, `IoTCore/Thing`",{"_3550":1464,"_30605":1316,"_21201":54504,"_5":14582,"_27821":54083,"_3006":50359},[],{"_3550":1465,"_30605":1316,"_21201":54506,"_5":14582,"_27821":54083,"_3006":54507},[],"Refreshes internal state; the connector ignores events whose CloudEvent `source` matches its own URI to avoid self-triggered loops.",{"_3550":1466,"_30605":1316,"_21201":54509,"_5":14582,"_27821":54083,"_3006":54152},[],{"_3550":1467,"_30605":1316,"_21201":54511,"_5":14582,"_27821":54087,"_3006":54512},[],"For devices to authenticate to AWS IoT Core with certificates issued by a Lamassu CA, that CA must first be registered in the AWS account. The connector handles this registration automatically in response to the `EventCreateCAKey`, `EventImportCAKey` and `EventUpdateCAMetadataKey` events, but the operation **only fires when the administrator explicitly requests it** through the CA metadata field.",{"_3550":1468,"_30605":1316,"_21201":54514,"_5":14582,"_27821":54091,"_3006":54515},[],"Registration is triggered by setting `registration.status = \"REQUESTED\"` on the `lamassu.io/iot/{connector_id}` key of the CA's metadata. This can be done from the Lamassu console in the CA management section or through the API.",{"_3550":1469,"_30605":1316,"_21201":54517,"_5":14582,"_27821":54091,"_3006":54518},[],"Once the event is received, the connector attempts to register the CA in AWS and updates the `registration.status` field in the CA's metadata with the result: `\"SUCCEEDED\"` if registration was successful, or `\"FAILED\"` with an error message otherwise. The process is asynchronous, so you must periodically check the metadata status until the operation completes.",{"_3550":1470,"_30605":1316,"_21201":54520,"_5":14582,"_27821":54095,"_3006":54521},[],"The CA registration flow is driven by the `registration.status` field of the CA's connector metadata:",{"_3550":1471,"_30605":1316,"_21201":54523,"_5":14582,"_27821":54095,"_3006":54524},[],"Transition",{"_3550":1472,"_30605":1316,"_21201":54526,"_5":14582,"_27821":54095,"_3006":54527},[],"AWS calls",{"_3550":1473,"_30605":1316,"_21201":54529,"_5":14582,"_27821":54095,"_3006":54530},[],"`NotRegistered` → `Requested`",{"_3550":1474,"_30605":1316,"_21201":54532,"_5":14582,"_27821":54095,"_3006":54533},[],"none (metadata write only)",{"_3550":1475,"_30605":1316,"_21201":54535,"_5":14582,"_27821":54095,"_3006":54536},[],"`Requested` → `Registering`",{"_3550":1476,"_30605":1316,"_21201":54538,"_5":14582,"_27821":54095,"_3006":54539},[],"`iot:GetRegistrationCode` (Primary Account only)",{"_3550":1477,"_30605":1316,"_21201":54541,"_5":14582,"_27821":54095,"_3006":54542},[],"`Registering` → `Succeeded`",{"_3550":1478,"_30605":1316,"_21201":54544,"_5":14582,"_27821":54095,"_3006":54545},[],"`iot:RegisterCACertificate` (Primary: proof-of-possession with an ephemeral key; SNI-only: `CertificateMode: SNI_ONLY`)",{"_3550":1479,"_30605":1316,"_21201":54547,"_5":14582,"_27821":54095,"_3006":54548},[],"`Registering` → `Failed`",{"_3550":1480,"_30605":1316,"_21201":54550,"_5":14582,"_27821":54095,"_3006":54551},[],"failed `iot:RegisterCACertificate`; the error detail is written to the CA's metadata",{"_3550":1481,"_30605":1316,"_21201":54553,"_5":14582,"_27821":54095,"_3006":54554},[],"`Failed` / `Succeeded` → `Requested`",{"_3550":1482,"_30605":1316,"_21201":54556,"_5":14582,"_27821":54095,"_3006":54557},[],"none (a new `REQUESTED` write re-runs the flow)",{"_3550":1483,"_30605":1316,"_21201":54559,"_5":14582,"_27821":54099,"_3006":54560},[],"When the `primary_account` parameter is `true`, the connector runs the full registration flow with proof-of-possession of the private key:",{"_3550":1484,"_30605":1316,"_21201":54562,"_5":14582,"_27821":54099,"_3006":54563},[],"It calls `iot:GetRegistrationCode` to obtain AWS's verification code.",{"_3550":1485,"_30605":1316,"_21201":54565,"_5":14582,"_27821":54099,"_3006":54566},[],"The connector internally generates an ephemeral RSA-2048 key pair and builds a CSR whose Common Name is exactly that registration code. It then calls Lamassu's signing service so the registered CA issues a real X.509 verification certificate signing that CSR. The ephemeral private key is used only for this purpose and is neither stored nor sent to AWS.",{"_3550":1486,"_30605":1316,"_21201":54568,"_5":14582,"_27821":54099,"_3006":54569},[],"It sends the CA (in PEM) and the verification certificate to AWS via `iot:RegisterCACertificate`, enabling registration with `AllowAutoRegistration: true`.",{"_3550":1487,"_30605":1316,"_21201":54571,"_5":14582,"_27821":54099,"_3006":54572},[],"Only one account can own a CA in a given AWS region. If the CA is already registered with the same serial number, the connector silently skips the step.",{"_3550":1488,"_30605":1316,"_21201":54574,"_5":14582,"_27821":54099,"_3006":54575},[],"The tags AWS IoT Core applies to the registered CA certificate are `LMS.CA.ID`, `LMS.CA.SN` and `LMS.CA.CN`.",{"_3550":1489,"_30605":1316,"_21201":54577,"_5":14582,"_27821":54103,"_3006":54578},[],"When `primary_account` is `false`, the connector registers the CA using `CertificateMode: SNI_ONLY`. This mode requires no verification code or access to the CA's private key, so it is the right choice when the CA is managed from another AWS account or when the administrator does not hold the private key. It is the usual method to register the same CA in several AWS accounts simultaneously.",{"_3550":1490,"_30605":1316,"_21201":54580,"_5":14582,"_27821":54107,"_3006":54581},[],"Each DMS participating in the AWS IoT Core integration must have the metadata key `lamassu.io/iot/{connector_id}` configured. The most important field of that configuration is `registration_mode`, which determines how devices are provisioned in AWS.",{"_3550":1491,"_30605":1316,"_21201":54583,"_5":14582,"_27821":54107,"_3006":54584},[],"There are three registration modes, and the choice among them depends on the fleet's provisioning strategy.",{"_3550":1492,"_30605":1316,"_21201":54586,"_5":14582,"_27821":54111,"_3006":54587},[],"In this mode the connector **creates no Things, groups or policies** in AWS IoT Core. It only syncs certificate status (active, revoked, suspended) as it changes in Lamassu. It is the right mode when Thing provisioning in AWS is managed by an external system and Lamassu only needs to keep certificate status up to date.",{"_3550":1493,"_30605":1316,"_21201":54589,"_5":14582,"_27821":54115,"_3006":54590},[],"`auto` mode delegates full device provisioning in AWS to Lamassu at enrollment time. When the device successfully completes its EST enrollment and Lamassu emits the `EventBindDeviceIdentityKey` event, the connector automatically executes the following sequence:",{"_3550":1494,"_30605":1316,"_21201":54592,"_5":14582,"_27821":54115,"_3006":54593},[],"Creates or updates the IoT policies configured in the DMS.",{"_3550":1495,"_30605":1316,"_21201":54595,"_5":14582,"_27821":54115,"_3006":54596},[],"Creates the root group `LAMASSU` in the AWS account (if it does not exist) and the child groups configured in the DMS as subgroups of `LAMASSU`. If the groups already exist, the `ResourceAlreadyExistsException` error is ignored, making the operation idempotent.",{"_3550":1496,"_30605":1316,"_21201":54598,"_5":14582,"_27821":54115,"_3006":54599},[],"If the Thing already existed in AWS IoT Core, the connector iterates all certificates (principals) currently attached to that Thing and marks them as `REVOKED` in AWS, ensuring previous certificates cannot keep being used to authenticate.",{"_3550":1497,"_30605":1316,"_21201":54601,"_5":14582,"_27821":54115,"_3006":54602},[],"Calls `iot:RegisterThing` with a CloudFormation-style provisioning template that creates the Thing, registers the device's certificate (PEM of the device certificate and of the issuing CA certificate) and attaches the configured policies.",{"_3550":1498,"_30605":1316,"_21201":54604,"_5":14582,"_27821":54115,"_3006":54605},[],"Once provisioning completes, the connector stores the resulting certificate's ARN in the Lamassu certificate's metadata under the key `lamassu.io/iot/{connector_id}` and marks the device as `Registered: true` in Device Manager.",{"_3550":1499,"_30605":1316,"_21201":54607,"_5":14582,"_27821":54115,"_3006":54608},[],"**The Thing name in AWS is the Common Name (CN) of the device's certificate.** This convention is fundamental for the firmware developer: the `/CN=` value the device includes in its CSR when enrolling becomes the ThingName it must identify itself with in all MQTT operations against AWS IoT Core.",{"_3550":1500,"_30605":1316,"_21201":54610,"_5":14582,"_27821":54119,"_3006":54611},[],"Just-In-Time Provisioning (JITP) mode delegates provisioning to AWS instead of the connector doing it directly. When the connector detects the DMS is in `jitp` mode, it creates a JITP provisioning template in AWS IoT Core and attaches it to the registered CA certificate. The connector attempts to create this template when the DMS is created and again on every full DMS edit (`PUT /v1/dms/{id}`) — not at device enrollment time. The attempt is not idempotent: when a template named after the DMS ID already exists, the creation call fails, the event is retried three times and finally lands in the `lamassu-dlq` poison queue (see Troubleshooting). The template is created once; later DMS edits never update its content. A DMS update that omits `metadata` or sends `null` keeps the stored metadata, so the connector key `lamassu.io/iot/{connector_id}` remains present and the attempt is still triggered. A body that supplies a `metadata` object replaces the stored metadata entirely: if that object does not carry the connector key, the key is dropped and the connector silently skips the DMS's future events. Once the template is attached, when a device with a certificate issued by that CA connects to AWS IoT Core for the first time, AWS executes the template automatically: it creates the Thing, registers the certificate and activates it.",{"_3550":1501,"_30605":1316,"_21201":54613,"_5":14582,"_27821":54119,"_3006":54614},[],"The connector creates the template, named after the DMS ID, only once. Each later edit of the DMS that keeps the connector key tries to create it again and fails, because the connector does not update existing templates. Later changes to `jitp_config.provisioning_role_arn`, `jitp_config.enable_template` or to the groups and policies the template references must be applied by hand in AWS IoT Core.",{"_3550":1502,"_30605":1316,"_21201":54616,"_5":14582,"_27821":54119,"_3006":54617},[],"The failed event is retried and ends in `lamassu-dlq`. Groups and policies are registered before the failure, but the assignment of the template to the registered CA, the write-back of the ARN to the DMS and the shadow update when `ManagedCAs` changes are skipped.",{"_3550":1503,"_30605":1316,"_21201":54619,"_5":14582,"_27821":54119,"_3006":54620},[],"The Thing name in the JITP template is derived from `AWS::IoT::Certificate::CommonName`, which corresponds to the device certificate's CN — the same convention as `auto` mode.",{"_3550":1504,"_30605":1316,"_21201":54622,"_5":14582,"_27821":54119,"_3006":54623},[],"This mode requires the `jitp_config.provisioning_role_arn` field to be configured with the ARN of an IAM role AWS IoT Core can assume to execute the template. If not configured, the connector uses the default `arn:aws:iam::{account}:role/JITPRole` and logs a warning. The administrator must ensure that role exists in the account and has the necessary permissions before enabling JITP mode.",{"_3550":1505,"_30605":1316,"_21201":54625,"_5":14582,"_27821":54123,"_3006":54626},[],"The DMS's `registration_mode` determines what the connector does on the AWS side when the DMS is created or fully edited:",{"_3550":1506,"_30605":1316,"_21201":54628,"_5":14582,"_27821":54123,"_3006":54524},[],{"_3550":1507,"_30605":1316,"_21201":54630,"_5":14582,"_27821":54123,"_3006":54527},[],{"_3550":1508,"_30605":1316,"_21201":54632,"_5":14582,"_27821":54123,"_3006":54633},[],"`Unconfigured` → `None` / `Auto`",{"_3550":1509,"_30605":1316,"_21201":54635,"_5":14582,"_27821":54123,"_3006":54636},[],"none (configuration only)",{"_3550":1510,"_30605":1316,"_21201":54638,"_5":14582,"_27821":54123,"_3006":54639},[],"`None` ↔ `Auto`",{"_3550":1511,"_30605":1316,"_21201":54641,"_5":14582,"_27821":54123,"_3006":54636},[],{"_3550":1512,"_30605":1316,"_21201":54643,"_5":14582,"_27821":54123,"_3006":54644},[],"Any → `Jitp`",{"_3550":1513,"_30605":1316,"_21201":54646,"_5":14582,"_27821":54123,"_3006":54647},[],"`iot:CreateProvisioningTemplate` (non-idempotent: it fails when the template already exists; after 3 retries the event lands in `lamassu-dlq`)",{"_3550":1514,"_30605":1316,"_21201":54649,"_5":14582,"_27821":54123,"_3006":54650},[],"`Jitp` → `None` / `Auto`",{"_3550":1515,"_30605":1316,"_21201":54652,"_5":14582,"_27821":54123,"_3006":54653},[],"none (the template stays in the AWS account)",{"_3550":1516,"_30605":1316,"_21201":54655,"_5":14582,"_27821":54127,"_3006":54656},[],"For the firmware developer, `auto` mode is transparent: the device performs its EST enrollment as usual and, as a side effect, it is provisioned in AWS IoT Core with no additional step.",{"_3550":1517,"_30605":1316,"_21201":54658,"_5":14582,"_27821":54127,"_3006":54659},[],"The full flow from the device's perspective is:",{"_3550":1518,"_30605":1316,"_21201":54661,"_5":14582,"_27821":54127,"_3006":54662},[],"Once the connector completes provisioning, the device can connect to the AWS IoT Core MQTT endpoint using its private key and the certificate issued by Lamassu. The ThingName it must identify itself with in AWS is exactly the certificate's CN.",{"_3550":1519,"_30605":1316,"_21201":54664,"_5":14582,"_27821":54131,"_3006":54665},[],"Things only exist under `auto` mode; in `jitp` mode AWS creates the Thing itself when the device first connects. The Thing name is always the device certificate's CN:",{"_3550":1520,"_30605":1316,"_21201":54667,"_5":14582,"_27821":54131,"_3006":54524},[],{"_3550":1521,"_30605":1316,"_21201":54669,"_5":14582,"_27821":54131,"_3006":54527},[],{"_3550":1522,"_30605":1316,"_21201":54671,"_5":14582,"_27821":54131,"_3006":54672},[],"`Absent` → `Provisioned`",{"_3550":1523,"_30605":1316,"_21201":54674,"_5":14582,"_27821":54131,"_3006":54675},[],"policies created/updated, Thing groups ensured, `iot:RegisterThing` (creates the Thing, registers the certificate, attaches policies)",{"_3550":1524,"_30605":1316,"_21201":54677,"_5":14582,"_27821":54131,"_3006":54678},[],"`Provisioned` → `Provisioned` (re-enrollment)",{"_3550":1525,"_30605":1316,"_21201":54680,"_5":14582,"_27821":54131,"_3006":54681},[],"stale principals marked `REVOKED`, new `iot:RegisterThing` run; the new certificate ARN replaces the old one in Lamassu metadata",{"_3550":1526,"_30605":1316,"_21201":54683,"_5":14582,"_27821":54131,"_3006":54684},[],"In `jitp` mode the connector makes no provisioning calls: AWS executes the JITP template on the device's first connection and creates the Thing, registers the certificate and activates it on its own.",{"_3550":1527,"_30605":1316,"_21201":54686,"_5":14582,"_27821":54135,"_3006":54687},[],"In JITP mode the device also performs its EST enrollment conventionally and obtains its certificate from Lamassu. The difference is that AWS IoT Core does not know the device until it attempts its first connection.",{"_3550":1528,"_30605":1316,"_21201":54689,"_5":14582,"_27821":54135,"_3006":54690},[],"When the device establishes its first MQTT connection to AWS IoT Core presenting the Lamassu-issued certificate, AWS detects that the certificate belongs to a CA registered with a JITP template, executes that template and creates the Thing automatically. The initial connection may fail or be delayed while the template runs; firmware must be prepared to retry the connection.",{"_3550":1529,"_30605":1316,"_21201":54692,"_5":14582,"_27821":54135,"_3006":54693},[],"For the JITP flow to work correctly:",{"_3550":1530,"_30605":1316,"_21201":54695,"_5":14582,"_27821":54135,"_3006":54696},[],"The CA must be registered in AWS in Primary Account mode (SNI-only mode does not support JITP).",{"_3550":1531,"_30605":1316,"_21201":54698,"_5":14582,"_27821":54135,"_3006":54699},[],"The IAM role configured in `jitp_config.provisioning_role_arn` must exist and have permissions to create Things, register certificates and attach policies in the AWS account.",{"_3550":1532,"_30605":1316,"_21201":54701,"_5":14582,"_27821":54135,"_3006":54702},[],"The device must present both its certificate and the issuing CA's certificate in the TLS handshake with AWS IoT Core.",{"_3550":1533,"_30605":1316,"_21201":54704,"_5":14582,"_27821":54135,"_3006":54705},[],"Certificates provisioned via JITP **do not have the connector's metadata key** (`lamassu.io/iot/{connector_id}`) in Lamassu. As a consequence, status changes of those certificates in Lamassu are not automatically synced to AWS through the state synchronization mechanism described in the next section.",{"_3550":1534,"_30605":1316,"_21201":54707,"_5":14582,"_27821":54139,"_3006":54708},[],"The connector listens for the `EventUpdateCertificateStatusKey` event and, when a certificate holding the connector's metadata key changes status in Lamassu, replicates that change in AWS IoT Core. The following table shows the status mapping:",{"_3550":1535,"_30605":1316,"_21201":54710,"_5":14582,"_27821":54139,"_3006":54711},[],"Status in Lamassu",{"_3550":1536,"_30605":1316,"_21201":54713,"_5":14582,"_27821":54139,"_3006":54714},[],"Revocation reason",{"_3550":1537,"_30605":1316,"_21201":54716,"_5":14582,"_27821":54139,"_3006":54717},[],"Status in AWS IoT Core",{"_3550":1538,"_30605":1316,"_21201":54719,"_5":14582,"_27821":54139,"_3006":54720},[],"`Active`",{"_3550":1539,"_30605":1316,"_21201":54722,"_5":14582,"_27821":54139,"_3006":54723},[],"None",{"_3550":1540,"_30605":1316,"_21201":54725,"_5":14582,"_27821":54139,"_3006":54726},[],"`ACTIVE`",{"_3550":1541,"_30605":1316,"_21201":54728,"_5":14582,"_27821":54139,"_3006":54729},[],"`Revoked`",{"_3550":1542,"_30605":1316,"_21201":54731,"_5":14582,"_27821":54139,"_3006":54732},[],"`certificateHold`",{"_3550":1543,"_30605":1316,"_21201":54734,"_5":14582,"_27821":54139,"_3006":54735},[],"`INACTIVE`",{"_3550":1544,"_30605":1316,"_21201":54737,"_5":14582,"_27821":54139,"_3006":54729},[],{"_3550":1545,"_30605":1316,"_21201":54739,"_5":14582,"_27821":54139,"_3006":54740},[],"Any other reason",{"_3550":1546,"_30605":1316,"_21201":54742,"_5":14582,"_27821":54139,"_3006":54743},[],"`REVOKED`",{"_3550":1547,"_30605":1316,"_21201":54745,"_5":14582,"_27821":54139,"_3006":54746},[],"Only the `Active` and `Revoked` states produce a call to `iot:UpdateCertificate`. The other lifecycle states of Lamassu (`RenewalWindow`, `AboutToExpire`, `Expired`) are not synced to AWS IoT Core; the certificate status in AWS remains unchanged until the status in Lamassu becomes `Active` or `Revoked`.",{"_3550":1548,"_30605":1316,"_21201":54748,"_5":14582,"_27821":54143,"_3006":54749},[],"Certificates holding the connector's metadata key sync their status; certificates provisioned via JITP have no metadata key and stay out of this machine:",{"_3550":1549,"_30605":1316,"_21201":54751,"_5":14582,"_27821":54143,"_3006":54524},[],{"_3550":1550,"_30605":1316,"_21201":54753,"_5":14582,"_27821":54143,"_3006":54527},[],{"_3550":1551,"_30605":1316,"_21201":54755,"_5":14582,"_27821":54143,"_3006":54756},[],"`NotSynced` → `Active`",{"_3550":1552,"_30605":1316,"_21201":54758,"_5":14582,"_27821":54143,"_3006":54235},[],{"_3550":1553,"_30605":1316,"_21201":54760,"_5":14582,"_27821":54143,"_3006":54761},[],"`Active` → `Inactive`",{"_3550":1554,"_30605":1316,"_21201":54763,"_5":14582,"_27821":54143,"_3006":54764},[],"`iot:UpdateCertificate` + forced MQTT disconnect",{"_3550":1555,"_30605":1316,"_21201":54766,"_5":14582,"_27821":54143,"_3006":54767},[],"`Active` → `Revoked`",{"_3550":1556,"_30605":1316,"_21201":54769,"_5":14582,"_27821":54143,"_3006":54764},[],{"_3550":1557,"_30605":1316,"_21201":54771,"_5":14582,"_27821":54143,"_3006":54772},[],"`Inactive` / `Revoked` → `Active`",{"_3550":1558,"_30605":1316,"_21201":54774,"_5":14582,"_27821":54143,"_3006":54235},[],{"_3550":1559,"_30605":1316,"_21201":54776,"_5":14582,"_27821":54143,"_3006":54777},[],"`RenewalWindow` / `AboutToExpire` / `Expired`",{"_3550":1560,"_30605":1316,"_21201":54779,"_5":14582,"_27821":54143,"_3006":54780},[],"none (these states are not synced to AWS)",{"_3550":1561,"_30605":1316,"_21201":54782,"_5":14582,"_27821":54147,"_3006":54783},[],"When the connector marks a certificate as `REVOKED` or `INACTIVE` in AWS, it additionally performs a forced disconnect of the device. To do so it opens an MQTT connection over WebSocket (with SigV4 authentication using the connector's credentials) to the AWS IoT Core data endpoint, using the certificate's CN as the MQTT client identifier, and closes it immediately. This terminates any active MQTT session the device may have at that moment.",{"_3550":1562,"_30605":1316,"_21201":54785,"_5":14582,"_27821":54147,"_3006":54786},[],"This forced disconnect happens at the moment Lamassu records the status change. If the device tries to reconnect after the disconnect, AWS IoT Core will reject the connection because the certificate is already listed as `REVOKED` or `INACTIVE`.",{"_3550":1563,"_30605":1316,"_21201":54788,"_5":14582,"_27821":54147,"_3006":54789},[],"Certificates provisioned in JITP mode do not have this automatic sync, since they lack the connector's metadata key.",{"_3550":1564,"_30605":1316,"_21201":54791,"_5":14582,"_27821":54151,"_3006":54792},[],"The connector can write to the AWS IoT Core Device Shadow to send action signals to the device firmware. This feature is enabled per DMS with `shadow_config.enable: true`.",{"_3550":1565,"_30605":1316,"_21201":54794,"_5":14582,"_27821":54151,"_3006":54795},[],"If `shadow_config.shadow_name` holds a value, the connector uses a Named Shadow with that name; otherwise it uses the Classic Shadow (the Thing's default shadow).",{"_3550":1566,"_30605":1316,"_21201":54797,"_5":14582,"_27821":54155,"_3006":54798},[],"The connector writes to the `desired.identity_actions` field of the shadow document. Each entry contains a Unix timestamp in milliseconds. The device firmware must read this field and act accordingly.",{"_3550":1567,"_30605":1316,"_21201":54800,"_5":14582,"_27821":54155,"_3006":54801},[],"There are two action types:",{"_3550":1568,"_30605":1316,"_21201":54803,"_5":14582,"_27821":54155,"_3006":54804},[],"**`UPDATE_CERTIFICATE`**: written when a certificate's preventive renewal window activates — that is, when the `triggered` field of the preventive renewal delta flips from `false` to `true`. This action tells the device it must start the re-enrollment process to renew its certificate before it expires.",{"_3550":1569,"_30605":1316,"_21201":54806,"_5":14582,"_27821":54155,"_3006":54807},[],"**`UPDATE_TRUST_ANCHOR_LIST`**: written to all devices of a DMS when the DMS's `ManagedCAs` list changes. This action tells the device it must update its trusted CA store.",{"_3550":1570,"_30605":1316,"_21201":54809,"_5":14582,"_27821":54155,"_3006":54810},[],"The shadow write process consists of reading the current shadow (`iotdata:GetThingShadow`), merging the new actions with the existing ones and writing the result (`iotdata:UpdateThingShadow`). If the shadow does not exist, the connector creates it. After a successful write, the list of pending actions in the device's metadata in Lamassu is cleared.",{"_3550":1571,"_30605":1316,"_21201":54812,"_5":14582,"_27821":54159,"_3006":54813},[],"The connector creates and attaches the policies configured in the DMS. A typical policy for a device using MQTT and the Device Shadow has this structure:",{"_3550":1572,"_30605":1316,"_21201":54815,"_5":14582,"_27821":54159,"_3006":54816},[],"In the policy above, the `<AWS_REGION>` and `<AWS_ACCOUNT_ID>` placeholders must be replaced with the AWS region and the twelve-digit account identifier of the target account before applying the policy. The `${iot:Connection.Thing.ThingName}` variable automatically limits each permission to the Thing the device is connected as, following the principle of least privilege. The `${ShadowName}` variable in the shadow ARNs is a placeholder that must be replaced with the `shadow_config.shadow_name` value configured in the DMS; if the Classic Shadow is used, it can be simplified by removing the `name/${ShadowName}/` segment. AWS IoT policies do not support regex alternation; the `[name/${ShadowName}/]*` notation represents the optionality of that segment within ARN syntax constraints.",{"_3550":1573,"_30605":1316,"_21201":54818,"_5":14582,"_27821":54159,"_3006":54819},[],"The first statement lets the device connect using its ThingName as the MQTT identifier. The second authorizes publishing to the Thing's generic MQTT topic and to the shadow topics, needed so the device can update its reported state. The last two statements grant subscribe and receive permissions over the same topics, letting the device receive shadow updates (for example, the `UPDATE_CERTIFICATE` and `UPDATE_TRUST_ANCHOR_LIST` actions written by the connector).",{"_3550":1574,"_30605":1316,"_21201":54821,"_5":14582,"_27821":54163,"_3006":54822},[],"**Symptom:** The CA registration stays in `REQUESTED` indefinitely.",{"_3550":1575,"_30605":1316,"_21201":54824,"_5":14582,"_27821":54163,"_3006":54825},[],"**Cause:** The connector is not running or is not subscribed to the event bus. It can also indicate incorrect IAM credentials, insufficient permissions or that the metadata key was written with a wrong `connector_id`.",{"_3550":1576,"_30605":1316,"_21201":54827,"_5":14582,"_27821":54163,"_3006":54828},[],"**Resolution:** Verify the connector process is active and the logs show no AWS communication errors. Check the metadata field was written under the exact key `lamassu.io/iot/{connector_id}`. If the error persists, the connector will update the status to `FAILED` with a descriptive message in the CA metadata.",{"_3550":1577,"_30605":1316,"_21201":54830,"_5":14582,"_27821":54163,"_3006":54831},[],"**Symptom:** A certificate's status is not synced to AWS after a revocation.",{"_3550":1578,"_30605":1316,"_21201":54833,"_5":14582,"_27821":54163,"_3006":54834},[],"**Cause:** Most commonly the certificate was provisioned in JITP mode. JITP certificates lack the connector's metadata key and are outside the state synchronization mechanism. If the DMS is in `auto` mode, it may indicate the initial provisioning did not complete correctly and the AWS ARN was not stored in the certificate metadata.",{"_3550":1579,"_30605":1316,"_21201":54836,"_5":14582,"_27821":54163,"_3006":54837},[],"**Resolution:** For JITP certificates, migrate the DMS to `auto` mode and re-provision the affected devices. For `auto` mode certificates, verify the certificate has the AWS ARN stored in its metadata; if not, repeat the provisioning.",{"_3550":1580,"_30605":1316,"_21201":54839,"_5":14582,"_27821":54163,"_3006":54840},[],"**Symptom:** The forced disconnect does not terminate the device's MQTT session after revocation.",{"_3550":1581,"_30605":1316,"_21201":54842,"_5":14582,"_27821":54163,"_3006":54843},[],"**Cause:** The device uses an MQTT client ID different from the certificate's CN. The forced disconnect opens a connection using the CN as client ID; if the firmware uses another identifier, the disconnect does not affect that session.",{"_3550":1582,"_30605":1316,"_21201":54845,"_5":14582,"_27821":54163,"_3006":54846},[],"**Resolution:** Make sure the firmware uses exactly the certificate's CN as the MQTT client identifier. That CN matches the ThingName in AWS IoT Core.",{"_3550":1583,"_30605":1316,"_21201":54848,"_5":14582,"_27821":54163,"_3006":54849},[],"**Symptom:** The device receives `CLIENT_ID_REJECTED` when connecting to AWS IoT Core.",{"_3550":1584,"_30605":1316,"_21201":54851,"_5":14582,"_27821":54163,"_3006":54852},[],"**Cause:** The MQTT client ID does not match the ThingName, which is always the CN of the certificate issued by Lamassu.",{"_3550":1585,"_30605":1316,"_21201":54854,"_5":14582,"_27821":54163,"_3006":54855},[],"**Resolution:** Verify the firmware uses exactly the value of the CN field included in the enrollment CSR as the MQTT client identifier.",{"_3550":1586,"_30605":1316,"_21201":54857,"_5":14582,"_27821":54163,"_3006":54858},[],"**Symptom:** The device's first MQTT connection in JITP mode fails or times out.",{"_3550":1587,"_30605":1316,"_21201":54860,"_5":14582,"_27821":54163,"_3006":54861},[],"**Cause:** This is expected behavior while AWS executes the JITP template on the device's first connection.",{"_3550":1588,"_30605":1316,"_21201":54863,"_5":14582,"_27821":54163,"_3006":54864},[],"**Resolution:** Firmware must implement retries with exponential backoff for the first connection. If the failure persists beyond a few minutes, verify the IAM role configured in `jitp_config.provisioning_role_arn` exists in the account and has permissions to create Things, register certificates and attach policies.",{"_3550":1589,"_30605":1316,"_21201":54866,"_5":14582,"_27821":54163,"_3006":54867},[],"**Symptom:** The Device Shadow is not updated when it should be.",{"_3550":1590,"_30605":1316,"_21201":54869,"_5":14582,"_27821":54163,"_3006":54870},[],"**Cause:** The shadow feature is disabled in the DMS configuration, the connector's credentials lack IoT data-plane permissions, or the firmware reads a different shadow than the configured one.",{"_3550":1591,"_30605":1316,"_21201":54872,"_5":14582,"_27821":54163,"_3006":54873},[],"**Resolution:** Check that `shadow_config.enable` is `true` in the connector metadata for the corresponding DMS. If a Named Shadow is used, verify `shadow_config.shadow_name` holds the correct name and that the firmware reads that Named Shadow and not the Classic Shadow. Confirm the connector's credentials have `iotdata:GetThingShadow` and `iotdata:UpdateThingShadow` permissions.",{"_3550":1592,"_30605":1316,"_21201":54875,"_5":14582,"_27821":54163,"_3006":54876},[],"**Symptom:** After editing a DMS in `jitp` mode, DMS update messages appear in `lamassu-dlq`, or JITP configuration changes have no effect in AWS.",{"_3550":1593,"_30605":1316,"_21201":54878,"_5":14582,"_27821":54163,"_3006":54879},[],"**Cause:** Every full DMS edit (`PUT /v1/dms/{id}`) triggers a `CreateProvisioningTemplate` attempt for the template named after the DMS ID, and the call is not idempotent: when the template already exists, it fails, the event is retried three times and finally lands in `lamassu-dlq`. The connector’s later steps are skipped.",{"_3550":1594,"_30605":1316,"_21201":54881,"_5":14582,"_27821":54163,"_3006":54882},[],"**Resolution:** Check that the template named with the DMS ID exists in AWS IoT Core and that JITP enrollment works. If the JITP configuration was changed, apply it by hand to the AWS template.",{"_3550":1595,"_30605":1316,"_21201":54884,"_5":14582,"_27821":54163,"_3006":54885},[],"<Card title=\"Configure a DMS\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_3550":1596,"_30605":1316,"_21201":54887,"_5":14582,"_27821":54163,"_3006":54888},[],"<Card title=\"Device enrollment (EST)\" href=\"/docs/platform/iot-fleets/enrollment/overview\" />",{"_3550":1597,"_30605":1316,"_21201":54890,"_5":14582,"_27821":54163,"_3006":54891},[],"<Card title=\"Certificate management\" href=\"/docs/platform/pki/certificates\" />",{"_3550":1598,"_30605":1598,"_5":14934,"_3006":52598,"_30943":54893,"_21201":54894,"_27821":1598},[49963,51438,52598],[],{"_3550":1599,"_30605":1598,"_21201":54896,"_5":14582,"_27821":1598,"_3006":54897},[],"Organize devices and their identities, prepare enrollment and integrate consumers.",{"_3550":1600,"_30605":1598,"_5":30940,"_21201":54899,"_27821":54900,"_3006":54901},[],"/docs/platform/iot-fleets/overview#start-here","Start here",{"_3550":1601,"_30605":1598,"_5":30940,"_21201":54903,"_27821":54904,"_3006":52596},[],"/docs/platform/iot-fleets/overview#devices-and-identities",{"_3550":1602,"_30605":1598,"_5":30940,"_21201":54906,"_27821":54907,"_3006":52779},[],"/docs/platform/iot-fleets/overview#enrollment-with-pki",{"_3550":1603,"_30605":1598,"_5":30940,"_21201":54909,"_27821":54910,"_3006":54060},[],"/docs/platform/iot-fleets/overview#integrations",{"_3550":1604,"_30605":1598,"_5":30940,"_21201":54912,"_27821":54913,"_3006":54914},[],"/docs/platform/iot-fleets/overview#who-prepares-each-part","Who prepares each part",{"_3550":1605,"_30605":1598,"_21201":54916,"_5":14582,"_27821":1598,"_3006":54917},[],"IoT Fleets applies PKI to the device lifecycle: registration, obtaining an identity, renewal and retirement. It is intended for those who administer a device population and those who integrate its enrollment client or the system that accepts it.",{"_3550":1606,"_30605":1598,"_21201":54919,"_5":14582,"_27821":54900,"_3006":54920},[],"Follow Enroll and connect your first device to prepare a DMS, obtain the identity from the client and demonstrate an mTLS connection. The automatic path includes initial trust, a CSR and result checks.",{"_3550":1607,"_30605":1598,"_21201":54922,"_5":14582,"_27821":54900,"_3006":54923},[],"To start with an existing certificate, use Register a device manually. You can then prepare enrollment and renewal for the next device.",{"_3550":1608,"_30605":1598,"_21201":54925,"_5":14582,"_27821":54904,"_3006":54926},[],"Resource",{"_3550":1609,"_30605":1598,"_21201":54928,"_5":14582,"_27821":54904,"_3006":54929},[],"What it represents",{"_3550":1610,"_30605":1598,"_21201":54931,"_5":14582,"_27821":54904,"_3006":54932},[],"**Device**",{"_3550":1611,"_30605":1598,"_21201":54934,"_5":14582,"_27821":54904,"_3006":54935},[],"An inventory entry with an identifier, owning DMS and classification.",{"_3550":1612,"_30605":1598,"_21201":54937,"_5":14582,"_27821":54904,"_3006":54938},[],"**Identity**",{"_3550":1613,"_30605":1598,"_21201":54940,"_5":14582,"_27821":54904,"_3006":54941},[],"The device's association with its certificates: an active version and a history.",{"_3550":1614,"_30605":1598,"_21201":54943,"_5":14582,"_27821":54904,"_3006":54944},[],"**DMS**",{"_3550":1615,"_30605":1598,"_21201":54946,"_5":14582,"_27821":54904,"_3006":54947},[],"The service that configures admission, enrollment, renewal and trust distribution.",{"_3550":1616,"_30605":1598,"_21201":54949,"_5":14582,"_27821":54904,"_3006":54950},[],"**Fleet**",{"_3550":1617,"_30605":1598,"_21201":54952,"_5":14582,"_27821":54904,"_3006":54953},[],"The population you operate, represented through devices, DMSs, tags and metadata.",{"_3550":1618,"_30605":1598,"_21201":54955,"_5":14582,"_27821":54904,"_3006":54956},[],"Each device has an owning DMS. You can organize a population through several DMSs when it needs different policies, and use tags to classify it. “Fleet” describes that operational context; the resources you create and query are DMSs and devices.",{"_3550":1619,"_30605":1598,"_21201":54958,"_5":14582,"_27821":54904,"_3006":54959},[],"Device management covers states, certificate history and identity actions. During renewal, retain the relationship with the device and check which certificate becomes the current identity.",{"_3550":1620,"_30605":1598,"_21201":54961,"_5":14582,"_27821":54907,"_3006":54962},[],"This section connects PKI rules to the device client. Preparation follows this order:",{"_3550":1621,"_30605":1598,"_21201":54964,"_5":14582,"_27821":54907,"_3006":54965},[],"**CA and profile:** prepare the issuer and certificate rules in PKI.",{"_3550":1622,"_30605":1598,"_21201":54967,"_5":14582,"_27821":54907,"_3006":54968},[],"**DMS policy:** define how the device is admitted, how requests authenticate and which trust is distributed.",{"_3550":1623,"_30605":1598,"_21201":54970,"_5":14582,"_27821":54907,"_3006":54971},[],"**Client:** prepare the initial credential, server trust, and key generation or custody.",{"_3550":1624,"_30605":1598,"_21201":54973,"_5":14582,"_27821":54907,"_3006":54974},[],"**Result:** request the certificate, install it and check its association with the device.",{"_3550":1625,"_30605":1598,"_21201":54976,"_5":14582,"_27821":54907,"_3006":54977},[],"**Continuity:** configure renewal, successor installation and recovery according to DMS policy.",{"_3550":1626,"_30605":1598,"_21201":54979,"_5":14582,"_27821":54907,"_3006":54980},[],"<Card title=\"Configure the DMS\" description=\"Prepare the CA, admission, authentication and renewal rules.\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_3550":1627,"_30605":1598,"_21201":54982,"_5":14582,"_27821":54907,"_3006":54983},[],"<Card title=\"Integrate the EST client\" description=\"Review the device endpoints, formats and checks.\" href=\"/docs/platform/iot-fleets/enrollment/est-client\" />",{"_3550":1628,"_30605":1598,"_21201":54985,"_5":14582,"_27821":54910,"_3006":54986},[],"An issued identity needs a consumer that trusts its issuer, validates the certificate and grants the device permissions. Prepare both the device's trust in the server and the server's trust in the device.",{"_3550":1629,"_30605":1598,"_21201":54988,"_5":14582,"_27821":54910,"_3006":54989},[],"The AWS IoT Core guide explains how to use the identity in that destination. Provisioning in Lamassu and provisioning in the destination are separate decisions; review the conditions of the chosen mode before expecting state synchronization.",{"_3550":1630,"_30605":1598,"_21201":54991,"_5":14582,"_27821":54913,"_3006":54992},[],"Participant",{"_3550":1631,"_30605":1598,"_21201":54994,"_5":14582,"_27821":54913,"_3006":54995},[],"Responsibility",{"_3550":1632,"_30605":1598,"_21201":54997,"_5":14582,"_27821":54913,"_3006":54998},[],"PKI administrator",{"_3550":1633,"_30605":1598,"_21201":55000,"_5":14582,"_27821":54913,"_3006":55001},[],"CA, issuance profile, chain and revocation publication.",{"_3550":1634,"_30605":1598,"_21201":55003,"_5":14582,"_27821":54913,"_3006":55004},[],"Provisioning administrator",{"_3550":1635,"_30605":1598,"_21201":55006,"_5":14582,"_27821":54913,"_3006":55007},[],"DMS, admission, authentication per operation and inventory.",{"_3550":1636,"_30605":1598,"_21201":55009,"_5":14582,"_27821":54913,"_3006":55010},[],"Device integrator",{"_3550":1637,"_30605":1598,"_21201":55012,"_5":14582,"_27821":54913,"_3006":55013},[],"Initial credential, key, EST client, trust and certificate installation.",{"_3550":1638,"_30605":1598,"_21201":55015,"_5":14582,"_27821":54913,"_3006":55016},[],"Consumer integrator",{"_3550":1639,"_30605":1598,"_21201":55018,"_5":14582,"_27821":54913,"_3006":55019},[],"Trusted issuers, validation and device permissions in the destination.",{"_3550":1640,"_30605":1598,"_21201":55021,"_5":14582,"_27821":54913,"_3006":55022},[],"Permissions and audit are shared with the rest of Platform. Prepare installation and instance connectivity in Deployment.",{"_3550":1641,"_30605":1641,"_5":14934,"_3006":55024,"_30943":55025,"_21201":55027,"_27821":1641},"Enroll and connect your first device",[49963,51438,52598,55026],"Getting started",[],{"_3550":1642,"_30605":1641,"_21201":55029,"_5":14582,"_27821":1641,"_3006":55030},[],"Obtain an identity through EST, verify its association and use it in an mTLS connection.",{"_3550":1643,"_30605":1641,"_5":30940,"_21201":55032,"_27821":55033,"_3006":49973},[],"/docs/platform/iot-fleets/quickstarts/enroll-device#before-you-begin",{"_3550":1644,"_30605":1641,"_5":30940,"_21201":55035,"_27821":55036,"_3006":55037},[],"/docs/platform/iot-fleets/quickstarts/enroll-device#prepare-the-bootstrap-credential","Prepare the bootstrap credential",{"_3550":1645,"_30605":1641,"_5":30940,"_21201":55039,"_27821":55040,"_3006":55041},[],"/docs/platform/iot-fleets/quickstarts/enroll-device#configure-the-evaluation-dms","Configure the evaluation DMS",{"_3550":1646,"_30605":1641,"_5":30940,"_21201":55043,"_27821":55044,"_3006":55045},[],"/docs/platform/iot-fleets/quickstarts/enroll-device#prepare-the-client-and-check-cacerts","Prepare the client and check cacerts",{"_3550":1647,"_30605":1641,"_5":30940,"_21201":55047,"_27821":55048,"_3006":55049},[],"/docs/platform/iot-fleets/quickstarts/enroll-device#enroll-the-device","Enroll the device",{"_3550":1648,"_30605":1641,"_5":30940,"_21201":55051,"_27821":55052,"_3006":55053},[],"/docs/platform/iot-fleets/quickstarts/enroll-device#verify-the-obtained-identity","Verify the obtained identity",{"_3550":1649,"_30605":1641,"_5":30940,"_21201":55055,"_27821":55056,"_3006":55057},[],"/docs/platform/iot-fleets/quickstarts/enroll-device#demonstrate-an-mtls-connection","Demonstrate an mTLS connection",{"_3550":1650,"_30605":1641,"_5":30940,"_21201":55059,"_27821":55060,"_3006":55061},[],"/docs/platform/iot-fleets/quickstarts/enroll-device#result-and-continuity","Result and continuity",{"_3550":1651,"_30605":1641,"_21201":55063,"_5":14582,"_27821":1641,"_3006":55064},[],"Prepare an evaluation DMS, enroll `est-device-001` from the client and use its identity with a local consumer that requires a certificate. The path connects administrator policy to the material the device actually installs.",{"_3550":1652,"_30605":1641,"_21201":55066,"_5":14582,"_27821":55033,"_3006":55067},[],"A Lamassu instance accessible through HTTPS and permissions for CAs, profiles, DMSs and reading devices/certificates.",{"_3550":1653,"_30605":1641,"_21201":55069,"_5":14582,"_27821":55033,"_3006":55070},[],"Bash, OpenSSL 3.x, curl with `--fail-with-body` and two terminals on your computer. Work in a new directory with restricted access.",{"_3550":1654,"_30605":1641,"_21201":55072,"_5":14582,"_27821":55033,"_3006":55073},[],"An active root CA that issues directly, with an available key and sufficient validity. Follow Create your first CA. Save its verified public certificate as `device-root.pem`.",{"_3550":1655,"_30605":1641,"_21201":55075,"_5":14582,"_27821":55033,"_3006":55076},[],"Available global identifier `est-device-001`. This path uses automatic registration: do not create the device in the console first.",{"_3550":1656,"_30605":1641,"_21201":55078,"_5":14582,"_27821":55033,"_3006":55079},[],"The approved root for Lamassu HTTPS in `est-trust.pem`, obtained through an independent channel. It can differ from the device CA; prepare networking/TLS in Deployment.",{"_3550":1657,"_30605":1641,"_21201":55081,"_5":14582,"_27821":55036,"_3006":55082},[],"Issue a bootstrap leaf certificate with `CN=est-device-001`, its own key and Client Authentication use. Follow Issue and verify a certificate, changing its CN and saving the result as `bootstrap.crt` and `bootstrap.key`. Choose validity that covers this test and check the pair and chain.",{"_3550":1658,"_30605":1641,"_21201":55084,"_5":14582,"_27821":55036,"_3006":55085},[],"The same root CA can issue it for this isolated evaluation. The operational identity will have a different key and certificate. The matching CN makes the example easier to read; initial certificate authentication does not itself bind the bootstrap CN to the requested ID. Review admission before applying the policy to a population.",{"_3550":1659,"_30605":1641,"_21201":55087,"_5":14582,"_27821":55040,"_3006":55088},[],"Create an explicit leaf profile compatible with EC P-256, with **Honor Subject**, CN from the CSR, **Digital Signature**, **Client Authentication** and **1 hour** validity within the root's validity. Do not enable CA signing. Rules and precedence are explained in Profiles.",{"_3550":1660,"_30605":1641,"_21201":55090,"_5":14582,"_27821":55040,"_3006":55091},[],"Create the `Acme EST Evaluation` DMS with this configuration:",{"_3550":1661,"_30605":1641,"_21201":55093,"_5":14582,"_27821":55040,"_3006":55094},[],"Setting",{"_3550":1662,"_30605":1641,"_21201":55096,"_5":14582,"_27821":55040,"_3006":55097},[],"Evaluation value",{"_3550":1663,"_30605":1641,"_21201":55099,"_5":14582,"_27821":55040,"_3006":55100},[],"Enrollment CA",{"_3550":1664,"_30605":1641,"_21201":55102,"_5":14582,"_27821":55040,"_3006":55103},[],"Issuing root from `device-root.pem`.",{"_3550":1665,"_30605":1641,"_21201":55105,"_5":14582,"_27821":55040,"_3006":52909},[],{"_3550":1666,"_30605":1641,"_21201":55107,"_5":14582,"_27821":55040,"_3006":55108},[],"The 1-hour leaf profile you just prepared.",{"_3550":1667,"_30605":1641,"_21201":55110,"_5":14582,"_27821":55040,"_3006":55111},[],"Protocol / Registration Mode",{"_3550":1668,"_30605":1641,"_21201":55113,"_5":14582,"_27821":55040,"_3006":55114},[],"`EST_RFC7030` / `JITP`.",{"_3550":1669,"_30605":1641,"_21201":55116,"_5":14582,"_27821":55040,"_3006":55117},[],"Verify CSR Signature",{"_3550":1670,"_30605":1641,"_21201":55119,"_5":14582,"_27821":55040,"_3006":55120},[],"Enabled.",{"_3550":1671,"_30605":1641,"_21201":55122,"_5":14582,"_27821":55040,"_3006":55123},[],"Enable Replaceable Enrollment",{"_3550":1672,"_30605":1641,"_21201":55125,"_5":14582,"_27821":55040,"_3006":55126},[],"Disabled; the ID must be new.",{"_3550":1673,"_30605":1641,"_21201":55128,"_5":14582,"_27821":55040,"_3006":55129},[],"Initial authentication",{"_3550":1674,"_30605":1641,"_21201":55131,"_5":14582,"_27821":55040,"_3006":55132},[],"`CLIENT_CERTIFICATE`; Validation CAs includes the direct bootstrap issuer; no expired certificates.",{"_3550":1675,"_30605":1641,"_21201":55134,"_5":14582,"_27821":55040,"_3006":55135},[],"Renewal authentication",{"_3550":1676,"_30605":1641,"_21201":55137,"_5":14582,"_27821":55040,"_3006":55138},[],"`CLIENT_CERTIFICATE`, configured in the independent re-enrollment block.",{"_3550":1677,"_30605":1641,"_21201":55140,"_5":14582,"_27821":55040,"_3006":55141},[],"Re-enrollment Validation CAs / Enable Expired Renewal",{"_3550":1678,"_30605":1641,"_21201":55143,"_5":14582,"_27821":55040,"_3006":55144},[],"Not needed for this direct issuance; the Enrollment CA is always trusted for re-enrollment / disabled.",{"_3550":1679,"_30605":1641,"_21201":55146,"_5":14582,"_27821":55040,"_3006":55147},[],"Re-enrollment Delta",{"_3550":1680,"_30605":1641,"_21201":55149,"_5":14582,"_27821":55040,"_3006":55150},[],"1 hour.",{"_3550":1681,"_30605":1641,"_21201":55152,"_5":14582,"_27821":55040,"_3006":55153},[],"Preventive / Critical Delta",{"_3550":1682,"_30605":1641,"_21201":55155,"_5":14582,"_27821":55040,"_3006":55156},[],"30 minutes / 10 minutes.",{"_3550":1683,"_30605":1641,"_21201":55158,"_5":14582,"_27821":55040,"_3006":55159},[],"Revoke on Re-enrollment",{"_3550":1684,"_30605":1641,"_21201":55161,"_5":14582,"_27821":55040,"_3006":55162},[],"Disabled to test the successor before retiring the previous identity.",{"_3550":1685,"_30605":1641,"_21201":55164,"_5":14582,"_27821":55040,"_3006":52917},[],{"_3550":1686,"_30605":1641,"_21201":55166,"_5":14582,"_27821":55040,"_3006":55167},[],"Disabled; the operational key is generated in the client.",{"_3550":1687,"_30605":1641,"_21201":55169,"_5":14582,"_27821":55040,"_3006":55170},[],"CA Distribution",{"_3550":1688,"_30605":1641,"_21201":55172,"_5":14582,"_27821":55040,"_3006":55173},[],"Include Enrollment CA enabled; Include Lamassu System CA disabled.",{"_3550":1689,"_30605":1641,"_21201":55175,"_5":14582,"_27821":55040,"_3006":55176},[],"Equal duration and window allow immediate renewal testing. These are evaluation values; size production settings according to connectivity and recovery times. Save, reread both authentication blocks and retain the DMS ID. The console exposes independent editors for the enrollment and re-enrollment authentication; the DMS guide describes their fields, and you can also check the resource through the DMS API.",{"_3550":1690,"_30605":1641,"_21201":55178,"_5":14582,"_27821":55044,"_3006":55179},[],"Place the four trust and bootstrap files in the new directory. Replace the URL with your installation's URL:",{"_3550":1691,"_30605":1641,"_21201":55181,"_5":14582,"_27821":55044,"_3006":55182},[],"The download must succeed and contain the expected enrollment root. Compare its fingerprint with `device-root.pem`. This check does not turn the response into initial trust or prove that you can issue.",{"_3550":1692,"_30605":1641,"_21201":55184,"_5":14582,"_27821":55048,"_3006":55185},[],"Generate a new key and CSR with the selected identifier:",{"_3550":1693,"_30605":1641,"_21201":55187,"_5":14582,"_27821":55048,"_3006":55188},[],"Request the identity with the bootstrap credential and extract the certificate from the default response:",{"_3550":1694,"_30605":1641,"_21201":55190,"_5":14582,"_27821":55048,"_3006":55191},[],"If curl fails, use Troubleshooting with the saved body. Do not convert it or repeat the request without querying inventory: a timeout or error can follow persisted issuance.",{"_3550":1695,"_30605":1641,"_21201":55193,"_5":14582,"_27821":55052,"_3006":55194},[],"Expect `device.crt: OK` and exit code 0 from `cmp`. Check the CN, serial, dates, Digital Signature and Client Authentication. The certificate must be a leaf: it must not declare `CA:TRUE` or Certificate Sign use. Check that its validity matches the one-hour profile.",{"_3550":1696,"_30605":1641,"_21201":55196,"_5":14582,"_27821":55052,"_3006":55197},[],"In Lamassu, open `est-device-001`. It must be created with the intended owning DMS, a current identity and the received certificate in its history. Compare the local serial with the slot; thresholds can show a renewal state rather than simply Active.",{"_3550":1697,"_30605":1641,"_21201":55199,"_5":14582,"_27821":55056,"_3006":55200},[],"In a second terminal, enter the same directory and run `umask 077`. Create a local server certificate and start a test consumer. This server trusts `device-root.pem` and requires a valid client identity:",{"_3550":1698,"_30605":1641,"_21201":55202,"_5":14582,"_27821":55056,"_3006":55203},[],"Leave it running. In the first terminal, connect using the obtained identity:",{"_3550":1699,"_30605":1641,"_21201":55205,"_5":14582,"_27821":55056,"_3006":55206},[],"Expect HTTP `200`. The client's trust in this local server is its self-signed `consumer.crt`; the server verifies the device against `device-root.pem`. The HTML file displays OpenSSL diagnostic information.",{"_3550":1700,"_30605":1641,"_21201":55208,"_5":14582,"_27821":55056,"_3006":55209},[],"With the same server still running, test that a request without a client certificate is rejected:",{"_3550":1701,"_30605":1641,"_21201":55211,"_5":14582,"_27821":55056,"_3006":55212},[],"Rejection must correspond to a missing certificate at the server, not a stopped server. Stop the consumer with Ctrl+C after the test. This exercise demonstrates TLS authentication and key possession; your application must also define authorization and revocation consumption. Server options are described in openssl-s\\_server.",{"_3550":1702,"_30605":1641,"_21201":55214,"_5":14582,"_27821":55060,"_3006":55215},[],"Check",{"_3550":1703,"_30605":1641,"_21201":55217,"_5":14582,"_27821":55060,"_3006":55218},[],"Expected result",{"_3550":1704,"_30605":1641,"_21201":55220,"_5":14582,"_27821":55060,"_3006":55221},[],"Registration",{"_3550":1705,"_30605":1641,"_21201":55223,"_5":14582,"_27821":55060,"_3006":55224},[],"ID created automatically and correct DMS.",{"_3550":1706,"_30605":1641,"_21201":55226,"_5":14582,"_27821":55060,"_3006":54482},[],{"_3550":1707,"_30605":1641,"_21201":55228,"_5":14582,"_27821":55060,"_3006":55229},[],"CN, profile, serial and key verified.",{"_3550":1708,"_30605":1641,"_21201":55231,"_5":14582,"_27821":55060,"_3006":55232},[],"Inventory",{"_3550":1709,"_30605":1641,"_21201":55234,"_5":14582,"_27821":55060,"_3006":55235},[],"Received serial visible as the current identity and in history.",{"_3550":1710,"_30605":1641,"_21201":55237,"_5":14582,"_27821":55060,"_3006":55238},[],"Consumer",{"_3550":1711,"_30605":1641,"_21201":55240,"_5":14582,"_27821":55060,"_3006":55241},[],"mTLS responds 200 with the identity and rejects a missing certificate.",{"_3550":1712,"_30605":1641,"_21201":55243,"_5":14582,"_27821":55060,"_3006":55244},[],"Continue with Renewal and recovery to request a successor pair within the window, install it and repeat the mTLS check. The consumer must use the new files in that test. After checking the successor, retire the previous certificate according to PKI policy; the example does not revoke it automatically.",{"_3550":1713,"_30605":1641,"_21201":55246,"_5":14582,"_27821":55060,"_3006":55247},[],"Devices and identities explains retirement and the limits of historical revocation. For a real destination, prepare consumer trust, validation and permissions; AWS IoT Core is an available integration.",{"_3550":1714,"_30605":1714,"_5":14934,"_3006":52614,"_30943":55249,"_21201":55250,"_27821":1714},[49963,51438,52598,55026],[],{"_3550":1715,"_30605":1714,"_21201":55252,"_5":14582,"_27821":1714,"_3006":55253},[],"Prepare a DMS, register a device and associate a verified certificate with its identity.",{"_3550":1716,"_30605":1714,"_5":30940,"_21201":55255,"_27821":55256,"_3006":49973},[],"/docs/platform/iot-fleets/quickstarts/register-device#before-you-begin",{"_3550":1717,"_30605":1714,"_5":30940,"_21201":55258,"_27821":55259,"_3006":55260},[],"/docs/platform/iot-fleets/quickstarts/register-device#prepare-the-dms","Prepare the DMS",{"_3550":1718,"_30605":1714,"_5":30940,"_21201":55262,"_27821":55263,"_3006":55264},[],"/docs/platform/iot-fleets/quickstarts/register-device#register-the-device","Register the device",{"_3550":1719,"_30605":1714,"_5":30940,"_21201":55266,"_27821":55267,"_3006":55268},[],"/docs/platform/iot-fleets/quickstarts/register-device#check-the-initial-status","Check the initial status",{"_3550":1720,"_30605":1714,"_5":30940,"_21201":55270,"_27821":55271,"_3006":55272},[],"/docs/platform/iot-fleets/quickstarts/register-device#assign-an-identity","Assign an identity",{"_3550":1721,"_30605":1714,"_5":30940,"_21201":55274,"_27821":55275,"_3006":55276},[],"/docs/platform/iot-fleets/quickstarts/register-device#verify-the-device","Verify the device",{"_3550":1722,"_30605":1714,"_5":30940,"_21201":55278,"_27821":55279,"_3006":55218},[],"/docs/platform/iot-fleets/quickstarts/register-device#expected-result",{"_3550":1723,"_30605":1714,"_5":30940,"_21201":55281,"_27821":55282,"_3006":55283},[],"/docs/platform/iot-fleets/quickstarts/register-device#if-the-result-fails","If the result fails",{"_3550":1724,"_30605":1714,"_5":30940,"_21201":55285,"_27821":55286,"_3006":55287},[],"/docs/platform/iot-fleets/quickstarts/register-device#automate-the-next-device","Automate the next device",{"_3550":1725,"_30605":1714,"_21201":55289,"_5":14582,"_27821":1714,"_3006":55290},[],"This path is intended for those starting to administer device identities. You will register `device-001` and assign an existing certificate to check the relationship between device, DMS and identity history.",{"_3550":1726,"_30605":1714,"_21201":55292,"_5":14582,"_27821":1714,"_3006":55293},[],"Assignment updates Lamassu's inventory. Install the key and certificate separately on the device; check the connection to a consumer in that destination's integration.",{"_3550":1727,"_30605":1714,"_21201":55295,"_5":14582,"_27821":55256,"_3006":55296},[],"An accessible instance and permission to administer DMSs, devices and certificate associations.",{"_3550":1728,"_30605":1714,"_21201":55298,"_5":14582,"_27821":55256,"_3006":55299},[],"An active CA with an available key. If one does not exist yet, follow Create your first CA.",{"_3550":1729,"_30605":1714,"_21201":55301,"_5":14582,"_27821":55256,"_3006":55302},[],"An active end-entity certificate from that CA whose `Common Name` is exactly `device-001`, together with its private key. Follow Issue and verify a certificate to obtain and check both.",{"_3550":1730,"_30605":1714,"_21201":55304,"_5":14582,"_27821":55256,"_3006":55305},[],"The identifier `device-001` available in the inventory. If you already used it, choose another and issue the certificate with that same `Common Name`.",{"_3550":1731,"_30605":1714,"_21201":55307,"_5":14582,"_27821":55259,"_3006":55308},[],"A DMS must exist before registering the device. If you already have a suitable one, check its CA and note its identifier; to create one:",{"_3550":1732,"_30605":1714,"_21201":55310,"_5":14582,"_27821":55259,"_3006":55311},[],"Open the DMS inventory and its creation action. Assign a recognizable name, such as `Acme Evaluation DMS`.",{"_3550":1733,"_30605":1714,"_21201":55313,"_5":14582,"_27821":55259,"_3006":55314},[],"In **Enrollment CA**, select the CA that issued `device.crt`.",{"_3550":1734,"_30605":1714,"_21201":55316,"_5":14582,"_27821":55259,"_3006":55317},[],"In **Registration Mode**, select `PRE_REGISTRATION` for the path that starts with explicit registration.",{"_3550":1735,"_30605":1714,"_21201":55319,"_5":14582,"_27821":55259,"_3006":55320},[],"In the authentication section, enable **Require client certificate** and leave **Call external webhook** off. Under **Require client certificate**, add the CA whose initial certificates you will accept to **Validation CAs**; for this evaluation, it can be the same CA. Keep **Verify CSR Signature** enabled and leave **Enable server-side key generation** off if you will not use it.",{"_3550":1736,"_30605":1714,"_21201":55322,"_5":14582,"_27821":55259,"_3006":55323},[],"Review renewal and trust distribution settings with the DMS guide, save the service and note its identifier.",{"_3550":1737,"_30605":1714,"_21201":55325,"_5":14582,"_27821":55259,"_3006":55326},[],"Reopen the DMS and confirm that the enrollment CA is the expected one and the service appears in inventory.",{"_3550":1738,"_30605":1714,"_21201":55328,"_5":14582,"_27821":55259,"_3006":55329},[],"These settings prepare DMS policy. The next steps register and assign through the console; they do not send an EST request or test admission through that protocol.",{"_3550":1739,"_30605":1714,"_21201":55331,"_5":14582,"_27821":55263,"_3006":55332},[],"Open **Managed Devices** and the registration action. Complete:",{"_3550":1740,"_30605":1714,"_21201":55334,"_5":14582,"_27821":55263,"_3006":55335},[],"**Device ID**: `device-001`.",{"_3550":1741,"_30605":1714,"_21201":55337,"_5":14582,"_27821":55263,"_3006":55338},[],"**Registration Authority**: the DMS you just prepared; this label identifies the service fulfilling the registration authority role.",{"_3550":1742,"_30605":1714,"_21201":55340,"_5":14582,"_27821":55263,"_3006":55341},[],"**Icon** and **Tags**: optional classification.",{"_3550":1743,"_30605":1714,"_21201":55343,"_5":14582,"_27821":55263,"_3006":55344},[],"Confirm registration.",{"_3550":1744,"_30605":1714,"_21201":55346,"_5":14582,"_27821":55267,"_3006":55347},[],"Open the device. It should appear in **No Identity** and show the selected owning DMS.",{"_3550":1745,"_30605":1714,"_21201":55349,"_5":14582,"_27821":55267,"_3006":55350},[],"Registration creates the inventory entry; the certificate must still be associated.",{"_3550":1746,"_30605":1714,"_21201":55352,"_5":14582,"_27821":55271,"_3006":55353},[],"Select **Assign Identity** and the existing certificate with `CN=device-001`. Check its serial number, issuer and validity against the certificate you verified in PKI.",{"_3550":1747,"_30605":1714,"_21201":55355,"_5":14582,"_27821":55271,"_3006":55356},[],"Confirm the association. The **Issue New Instead** alternative is explained in Devices and identities.",{"_3550":1748,"_30605":1714,"_21201":55358,"_5":14582,"_27821":55275,"_3006":55359},[],"Check that it has an active identity. In **Certificate History**, verify the associated serial number; in **Device Event Timeline**, find the assignment event.",{"_3550":1749,"_30605":1714,"_21201":55361,"_5":14582,"_27821":55275,"_3006":55362},[],"Keep the device identifier, owning DMS and serial number as references for the result.",{"_3550":1750,"_30605":1714,"_21201":55364,"_5":14582,"_27821":55279,"_3006":55215},[],{"_3550":1751,"_30605":1714,"_21201":55366,"_5":14582,"_27821":55279,"_3006":55367},[],"Result",{"_3550":1752,"_30605":1714,"_21201":55369,"_5":14582,"_27821":55279,"_3006":54465},[],{"_3550":1753,"_30605":1714,"_21201":55371,"_5":14582,"_27821":55279,"_3006":55372},[],"`device-001` appears in inventory with the expected DMS.",{"_3550":1754,"_30605":1714,"_21201":55374,"_5":14582,"_27821":55279,"_3006":55375},[],"Current identity",{"_3550":1755,"_30605":1714,"_21201":55377,"_5":14582,"_27821":55279,"_3006":55378},[],"The associated certificate matches the one you verified in PKI.",{"_3550":1756,"_30605":1714,"_21201":55380,"_5":14582,"_27821":55279,"_3006":55381},[],"History",{"_3550":1757,"_30605":1714,"_21201":55383,"_5":14582,"_27821":55279,"_3006":55384},[],"The associated issuance appears with its serial number and dates.",{"_3550":1758,"_30605":1714,"_21201":55386,"_5":14582,"_27821":55279,"_3006":55387},[],"Key and certificate",{"_3550":1759,"_30605":1714,"_21201":55389,"_5":14582,"_27821":55279,"_3006":55390},[],"You have the verified pair ready to install on the device.",{"_3550":1760,"_30605":1714,"_21201":55392,"_5":14582,"_27821":55282,"_3006":55393},[],"If you cannot select the DMS, confirm its creation and your read permissions.",{"_3550":1761,"_30605":1714,"_21201":55395,"_5":14582,"_27821":55282,"_3006":55396},[],"If no eligible certificate appears, check that its `Common Name` matches the `Device ID` exactly, it is active and it was issued by the expected CA.",{"_3550":1762,"_30605":1714,"_21201":55398,"_5":14582,"_27821":55282,"_3006":55399},[],"If assignment fails, review permissions and operation diagnostics before repeating it. Query the device and its history again to find the persisted result.",{"_3550":1763,"_30605":1714,"_21201":55401,"_5":14582,"_27821":55282,"_3006":55402},[],"If an expiration or renewal state appears, check certificate dates and DMS thresholds in Devices and identities.",{"_3550":1764,"_30605":1714,"_21201":55404,"_5":14582,"_27821":55286,"_3006":55405},[],"Continue with DMS and EST for the device to request and renew certificates. Prepare server trust, the initial credential and policies for each operation before implementing the client.",{"_3550":1765,"_30605":1714,"_21201":55407,"_5":14582,"_27821":55286,"_3006":55408},[],"For a path from the client through mTLS, follow Enroll and connect your first device with a new ID.",{"_3550":1766,"_30605":1714,"_21201":55410,"_5":14582,"_27821":55286,"_3006":55411},[],"To use the identity in AWS IoT Core, also prepare trust and permissions in the destination. Check the connection from the device after installing the required key, certificate and chain.",{"_3550":1767,"_30605":1767,"_5":14934,"_3006":55413,"_30943":55414,"_21201":55415,"_27821":1767},"Lamassu IoT Platform",[49963,51438],[],{"_3550":1768,"_30605":1767,"_21201":55417,"_5":14582,"_27821":1767,"_3006":55418},[],"Build a PKI and apply its certificates to your devices' lifecycle.",{"_3550":1769,"_30605":1767,"_5":30940,"_21201":55420,"_27821":55421,"_3006":54901},[],"/docs/platform/overview#start-here",{"_3550":1770,"_30605":1767,"_5":30940,"_21201":55423,"_27821":55424,"_3006":55425},[],"/docs/platform/overview#choose-your-path","Choose your path",{"_3550":1771,"_30605":1767,"_5":30940,"_21201":55427,"_27821":55428,"_3006":55429},[],"/docs/platform/overview#architecture-at-a-glance","Architecture at a glance",{"_3550":1772,"_30605":1767,"_5":30940,"_21201":55431,"_27821":55432,"_3006":55433},[],"/docs/platform/overview#core-capabilities","Core capabilities",{"_3550":1773,"_30605":1767,"_5":30940,"_21201":55435,"_27821":55436,"_3006":55437},[],"/docs/platform/overview#build-your-trust-hierarchy","Build your trust hierarchy",{"_3550":1774,"_30605":1767,"_5":30940,"_21201":55439,"_27821":55440,"_3006":55441},[],"/docs/platform/overview#protect-cryptographic-keys","Protect cryptographic keys",{"_3550":1775,"_30605":1767,"_5":30940,"_21201":55443,"_27821":55444,"_3006":55445},[],"/docs/platform/overview#issue-and-control-certificates","Issue and control certificates",{"_3550":1776,"_30605":1767,"_5":30940,"_21201":55447,"_27821":55448,"_3006":55449},[],"/docs/platform/overview#automate-device-identities","Automate device identities",{"_3550":1777,"_30605":1767,"_5":30940,"_21201":55451,"_27821":55452,"_3006":55453},[],"/docs/platform/overview#publish-validation-status","Publish validation status",{"_3550":1778,"_30605":1767,"_5":30940,"_21201":55455,"_27821":55456,"_3006":55457},[],"/docs/platform/overview#react-to-events","React to events",{"_3550":1779,"_30605":1767,"_5":30940,"_21201":55459,"_27821":55460,"_3006":55461},[],"/docs/platform/overview#operational-reference","Operational reference",{"_3550":1780,"_30605":1767,"_21201":55463,"_5":14582,"_27821":1767,"_3006":55464},[],"Lamassu IoT lets you administer a private PKI and use it to issue, renew and revoke X.509 device identities. The Platform documentation follows two paths: **PKI**, for authorities and certificates, and **IoT Fleets**, for applying those identities to a device population.",{"_3550":1781,"_30605":1767,"_21201":55466,"_5":14582,"_27821":55421,"_3006":55467},[],"Choose the result you need:",{"_3550":1782,"_30605":1767,"_21201":55469,"_5":14582,"_27821":55421,"_3006":55470},[],"<Card title=\"Issue and verify a certificate\" description=\"Prepare a CA, issue an X.509 identity and check its chain and key.\" href=\"/docs/platform/pki/quickstarts/overview\" />",{"_3550":1783,"_30605":1767,"_21201":55472,"_5":14582,"_27821":55421,"_3006":55473},[],"<Card title=\"Enroll and connect a device\" description=\"Prepare the DMS, request an identity through EST and check an mTLS connection.\" href=\"/docs/platform/iot-fleets/quickstarts/enroll-device\" />",{"_3550":1784,"_30605":1767,"_21201":55475,"_5":14582,"_27821":55421,"_3006":55476},[],"If you are still preparing the instance, start in Deployment. The Platform paths assume an accessible console and permission to perform the operations.",{"_3550":1785,"_30605":1767,"_21201":55478,"_5":14582,"_27821":55424,"_3006":55479},[],"Section",{"_3550":1786,"_30605":1767,"_21201":55481,"_5":14582,"_27821":55424,"_3006":55482},[],"What you manage",{"_3550":1787,"_30605":1767,"_21201":55484,"_5":14582,"_27821":55424,"_3006":55485},[],"Entry point",{"_3550":1788,"_30605":1767,"_21201":55487,"_5":14582,"_27821":55424,"_3006":55488},[],"**PKI**",{"_3550":1789,"_30605":1767,"_21201":55490,"_5":14582,"_27821":55424,"_3006":55491},[],"Keys, authorities, profiles, certificates and publication of revocation status.",{"_3550":1790,"_30605":1767,"_21201":55493,"_5":14582,"_27821":55424,"_3006":55494},[],"PKI overview",{"_3550":1791,"_30605":1767,"_21201":55496,"_5":14582,"_27821":55424,"_3006":55497},[],"**IoT Fleets**",{"_3550":1792,"_30605":1767,"_21201":55499,"_5":14582,"_27821":55424,"_3006":55500},[],"Devices, identity history, DMS policies, EST enrollment and integrations.",{"_3550":1793,"_30605":1767,"_21201":55502,"_5":14582,"_27821":55424,"_3006":55503},[],"IoT Fleets overview",{"_3550":1794,"_30605":1767,"_21201":55505,"_5":14582,"_27821":55424,"_3006":55506},[],"**Administration**",{"_3550":1795,"_30605":1767,"_21201":55508,"_5":14582,"_27821":55424,"_3006":55509},[],"Operator permissions, audit and event subscriptions.",{"_3550":1796,"_30605":1767,"_21201":55511,"_5":14582,"_27821":55424,"_3006":51440},[],{"_3550":1797,"_30605":1767,"_21201":55513,"_5":14582,"_27821":55424,"_3006":55514},[],"A CA determines who signs, and a profile defines what can be issued. The DMS applies admission and enrollment policy. The device retains its association with certificates, and the external consumer decides which identity it accepts.",{"_3550":1798,"_30605":1767,"_21201":55516,"_5":14582,"_27821":55428,"_3006":55517},[],"An identity's journey connects four responsibilities:",{"_3550":1799,"_30605":1767,"_21201":55519,"_5":14582,"_27821":55428,"_3006":55520},[],"The PKI administrator prepares the authority, its key and issuance rules.",{"_3550":1800,"_30605":1767,"_21201":55522,"_5":14582,"_27821":55428,"_3006":55523},[],"The provisioning administrator configures the DMS and initial trust.",{"_3550":1801,"_30605":1767,"_21201":55525,"_5":14582,"_27821":55428,"_3006":55526},[],"The device client requests a certificate and installs it with the matching key.",{"_3550":1802,"_30605":1767,"_21201":55528,"_5":14582,"_27821":55428,"_3006":55529},[],"The consumer validates the identity and applies its access permissions.",{"_3550":1803,"_30605":1767,"_21201":55531,"_5":14582,"_27821":55428,"_3006":55532},[],"See How Lamassu works to understand the resources and platform architecture for the services. Installation, network exposure and dependencies are explained in Deployment.",{"_3550":1804,"_30605":1767,"_21201":55534,"_5":14582,"_27821":55436,"_3006":55535},[],"Create or incorporate authorities and organize their relationships in PKI. The hierarchy and its rotation determine which chains consumers must recognize.",{"_3550":1805,"_30605":1767,"_21201":55537,"_5":14582,"_27821":55440,"_3006":55538},[],"Choose the engine that keeps authority keys and control who can use them. See Keys and engines; provider setup belongs to deployment.",{"_3550":1806,"_30605":1767,"_21201":55540,"_5":14582,"_27821":55444,"_3006":55541},[],"Define issuance profiles, sign requests and review the certificate inventory. Check the issued certificate from the client that will use it.",{"_3550":1807,"_30605":1767,"_21201":55543,"_5":14582,"_27821":55448,"_3006":55544},[],"Configure a DMS and use EST to request and renew certificates. Preparing the initial credential and installing the result belong to device integration.",{"_3550":1808,"_30605":1767,"_21201":55546,"_5":14582,"_27821":55452,"_3006":55547},[],"Use OCSP and CRL to publish revocation status. Each consumer must configure how it retrieves and applies that information.",{"_3550":1809,"_30605":1767,"_21201":55549,"_5":14582,"_27821":55456,"_3006":55550},[],"Use audit logs to investigate changes and configure alerts and subscriptions to react to lifecycle events.",{"_3550":1810,"_30605":1767,"_21201":55552,"_5":14582,"_27821":55460,"_3006":54995},[],{"_3550":1811,"_30605":1767,"_21201":55554,"_5":14582,"_27821":55460,"_3006":55555},[],"What it prepares or checks",{"_3550":1812,"_30605":1767,"_21201":55557,"_5":14582,"_27821":55460,"_3006":54998},[],{"_3550":1813,"_30605":1767,"_21201":55559,"_5":14582,"_27821":55460,"_3006":55560},[],"Key custody, CA hierarchy, profiles and validation.",{"_3550":1814,"_30605":1767,"_21201":55562,"_5":14582,"_27821":55460,"_3006":55563},[],"Fleet administrator",{"_3550":1815,"_30605":1767,"_21201":55565,"_5":14582,"_27821":55460,"_3006":55566},[],"DMS, device admission, renewal policy and inventory.",{"_3550":1816,"_30605":1767,"_21201":55568,"_5":14582,"_27821":55460,"_3006":55010},[],{"_3550":1817,"_30605":1767,"_21201":55570,"_5":14582,"_27821":55460,"_3006":55571},[],"Initial credential, server trust, EST client, and key and certificate storage.",{"_3550":1818,"_30605":1767,"_21201":55573,"_5":14582,"_27821":55460,"_3006":55016},[],{"_3550":1819,"_30605":1767,"_21201":55575,"_5":14582,"_27821":55460,"_3006":55576},[],"Issuer trust, certificate validation and permissions in the destination.",{"_3550":1820,"_30605":1767,"_21201":55578,"_5":14582,"_27821":55460,"_3006":55579},[],"Infrastructure operator",{"_3550":1821,"_30605":1767,"_21201":55581,"_5":14582,"_27821":55460,"_3006":55582},[],"Installation, network, availability, dependencies and deployment diagnosis.",{"_3550":1822,"_30605":1767,"_21201":55584,"_5":14582,"_27821":55460,"_3006":55585},[],"The API reference contains contracts for automating operations. To investigate a failure, start in the affected section: PKI, EST or Deployment.",{"_3550":1823,"_30605":1823,"_5":14934,"_3006":55587,"_30943":55588,"_21201":55591,"_27821":1823},"CA hierarchy and rotation",[49963,51438,55589,55590],"PKI","Keys, authorities and certificates",[],{"_3550":1824,"_30605":1823,"_21201":55593,"_5":14582,"_27821":1823,"_3006":55594},[],"Design root and intermediate authorities and replace certificates or keys without breaking trust.",{"_3550":1825,"_30605":1823,"_5":30940,"_21201":55596,"_27821":55597,"_3006":55598},[],"/docs/platform/pki/ca-hierarchy-and-rotation#design-the-hierarchy","Design the hierarchy",{"_3550":1826,"_30605":1823,"_5":30940,"_21201":55600,"_27821":55601,"_3006":55602},[],"/docs/platform/pki/ca-hierarchy-and-rotation#reissuance-and-rotation-are-not-the-same","Reissuance and rotation are not the same",{"_3550":1827,"_30605":1823,"_5":30940,"_21201":55604,"_27821":55605,"_3006":55606},[],"/docs/platform/pki/ca-hierarchy-and-rotation#when-to-choose-each-operation","When to choose each operation",{"_3550":1828,"_30605":1823,"_5":30940,"_21201":55608,"_27821":55609,"_3006":55610},[],"/docs/platform/pki/ca-hierarchy-and-rotation#key-rotation-procedure","Key rotation procedure",{"_3550":1829,"_30605":1823,"_5":30940,"_21201":55612,"_27821":55613,"_3006":55614},[],"/docs/platform/pki/ca-hierarchy-and-rotation#inventory-the-dependencies","Inventory the dependencies",{"_3550":1830,"_30605":1823,"_5":30940,"_21201":55616,"_27821":55617,"_3006":55618},[],"/docs/platform/pki/ca-hierarchy-and-rotation#create-the-successor-ca","Create the successor CA",{"_3550":1831,"_30605":1823,"_5":30940,"_21201":55620,"_27821":55621,"_3006":55622},[],"/docs/platform/pki/ca-hierarchy-and-rotation#distribute-the-new-trust","Distribute the new trust",{"_3550":1832,"_30605":1823,"_5":30940,"_21201":55624,"_27821":55625,"_3006":55626},[],"/docs/platform/pki/ca-hierarchy-and-rotation#switch-issuance","Switch issuance",{"_3550":1833,"_30605":1823,"_5":30940,"_21201":55628,"_27821":55629,"_3006":55630},[],"/docs/platform/pki/ca-hierarchy-and-rotation#renew-in-batches","Renew in batches",{"_3550":1834,"_30605":1823,"_5":30940,"_21201":55632,"_27821":55633,"_3006":55634},[],"/docs/platform/pki/ca-hierarchy-and-rotation#close-the-overlap","Close the overlap",{"_3550":1835,"_30605":1823,"_5":30940,"_21201":55636,"_27821":55637,"_3006":55638},[],"/docs/platform/pki/ca-hierarchy-and-rotation#cascading-revocation","Cascading revocation",{"_3550":1836,"_30605":1823,"_5":30940,"_21201":55640,"_27821":55641,"_3006":55642},[],"/docs/platform/pki/ca-hierarchy-and-rotation#checks-after-the-change","Checks after the change",{"_3550":1837,"_30605":1823,"_21201":55644,"_5":14582,"_27821":1823,"_3006":55645},[],"The hierarchy determines the blast radius of any error or compromise. A root signs intermediate CAs; intermediates issue the identities used by devices and services. This separation lets you isolate environments and rotate a branch without replacing all trust.",{"_3550":1838,"_30605":1823,"_21201":55647,"_5":14582,"_27821":1823,"_3006":55648},[],"This procedure is for the PKI operator replacing an authority in use. You need access to CAs, keys and profiles, a dependency inventory and coordination with trust-store and device owners. Before switching issuance, prepare a test cohort and decide the criterion for ending overlap.",{"_3550":1839,"_30605":1823,"_21201":55650,"_5":14582,"_27821":55597,"_3006":55651},[],"For a production installation, use a very restricted root and one or more operational intermediates. Separate intermediates when any of these boundaries change:",{"_3550":1840,"_30605":1823,"_21201":55653,"_5":14582,"_27821":55597,"_3006":55654},[],"environment, such as production and preproduction;",{"_3550":1841,"_30605":1823,"_21201":55656,"_5":14582,"_27821":55597,"_3006":55657},[],"owner or operating team;",{"_3550":1842,"_30605":1823,"_21201":55659,"_5":14582,"_27821":55597,"_3006":55660},[],"device family or manufacturing process;",{"_3550":1843,"_30605":1823,"_21201":55662,"_5":14582,"_27821":55597,"_3006":55663},[],"region or regulatory requirement;",{"_3550":1844,"_30605":1823,"_21201":55665,"_5":14582,"_27821":55597,"_3006":55666},[],"cryptographic engine or key policy;",{"_3550":1845,"_30605":1823,"_21201":55668,"_5":14582,"_27821":55597,"_3006":55669},[],"maintenance window and renewal cadence.",{"_3550":1846,"_30605":1823,"_21201":55671,"_5":14582,"_27821":55597,"_3006":55672},[],"Avoid deep hierarchies without a concrete need. Each level adds chain distribution, validation and one more certificate you must renew.",{"_3550":1847,"_30605":1823,"_21201":55674,"_5":14582,"_27821":55597,"_3006":55675},[],"A child CA and its end-entity certificates must expire before their issuer. Reserve a margin that allows distributing another chain and renewing dependent certificates.",{"_3550":1848,"_30605":1823,"_21201":55677,"_5":14582,"_27821":55601,"_3006":55678},[],"**Reissuing a CA** creates a new certificate over the existing key. Lamassu generates a CSR with that key, self-signs it if it is a root or asks the parent CA to sign it if it is subordinate. The new certificate becomes active and the CA points to its serial number; the old and new certificates are linked through metadata.",{"_3550":1849,"_30605":1823,"_21201":55680,"_5":14582,"_27821":55601,"_3006":55681},[],"If the CRL settings of the CA are signed by the superseded CA certificate, reissuing moves the signer to the new certificate — provided it carries `cRLSign` — and republishes the CRL. Otherwise, and for settings signed by a different certificate, the signer is kept, so check the new certificate’s key usage after reissuing; see the CRL guide.",{"_3550":1850,"_30605":1823,"_21201":55683,"_5":14582,"_27821":55601,"_3006":55684},[],"**Rotating a CA** creates a successor key and authority. It is the right choice in the face of compromise, a cryptographic change, an engine migration or non-exportable key policies.",{"_3550":1851,"_30605":1823,"_21201":55686,"_5":14582,"_27821":55601,"_3006":55687},[],"Lamassu does not allow reissuing an already-revoked CA or a CA whose expiration date has passed. Plan ahead for both conditions.",{"_3550":1852,"_30605":1823,"_21201":55689,"_5":14582,"_27821":55605,"_3006":55690},[],"Reissue if the key is still trustworthy and you only need another validity period or an updated certificate.",{"_3550":1853,"_30605":1823,"_21201":55692,"_5":14582,"_27821":55605,"_3006":55693},[],"Rotate the key if compromise is suspected, the algorithm changes or you want to move custody to another engine.",{"_3550":1854,"_30605":1823,"_21201":55695,"_5":14582,"_27821":55605,"_3006":55696},[],"Create a parallel branch if you cannot update all consumers at the same time.",{"_3550":1855,"_30605":1823,"_21201":55698,"_5":14582,"_27821":55605,"_3006":55699},[],"Revoke immediately only when the risk of keeping the CA outweighs the impact of interrupting the fleet.",{"_3550":1856,"_30605":1823,"_21201":55701,"_5":14582,"_27821":55613,"_3006":55702},[],"Locate child CAs, issued certificates, DMSs, connectors and external trust stores. Include devices that may stay offline for weeks or months.",{"_3550":1857,"_30605":1823,"_21201":55704,"_5":14582,"_27821":55617,"_3006":55705},[],"Generate a new key in the planned engine, create the CA and assign it an explicit profile. Do not reuse the operational identifier to hide that it is a different generation.",{"_3550":1858,"_30605":1823,"_21201":55707,"_5":14582,"_27821":55621,"_3006":55708},[],"Add the new root or chain to consumers before issuing with it. If distributing through EST `/cacerts`, explicitly include the required managed CAs and inspect the content; including the issuer does not automatically include every intermediate. Install the new trust in a cohort and verify that it still accepts the previous identity.",{"_3550":1859,"_30605":1823,"_21201":55710,"_5":14582,"_27821":55625,"_3006":55711},[],"Update the enrollment CA and profile of the DMSs. While old-CA cohorts still renew, add the previous enrollment CA to each DMS's re-enrollment validation CAs (`reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`): the new enrollment CA is trusted automatically, but the old one was the enrollment CA and appears in no re-enrollment trust list, so without that entry its certificates can no longer renew. The DMS guide documents the setting.",{"_3550":1860,"_30605":1823,"_21201":55713,"_5":14582,"_27821":55629,"_3006":55714},[],"Migrate a small cohort, validate mTLS, OCSP and CRL from the consumer and expand progressively. Monitor which devices still present the old chain.",{"_3550":1861,"_30605":1823,"_21201":55716,"_5":14582,"_27821":55633,"_3006":55717},[],"Once no legitimate consumer depends on the previous authority, remove it from issuance, from the re-enrollment validation CAs and from the distributed CAs. Revoke it if policy requires it.",{"_3550":1862,"_30605":1823,"_21201":55719,"_5":14582,"_27821":55637,"_3006":55720},[],"Lamassu saves the CA’s revocation, then attempts to revoke child CAs and issued certificates with `CessationOfOperation`. Propagation continues recursively through child CAs. This is not a transaction over the whole hierarchy: some resources may have changed while other updates failed.",{"_3550":1863,"_30605":1823,"_21201":55722,"_5":14582,"_27821":55637,"_3006":55723},[],"Resources in `EXPIRED` state and resources already revoked for a final reason reject further status transitions. Per-descendant failures are logged; review the inventory and logs even when the parent operation completes.",{"_3550":1864,"_30605":1823,"_21201":55725,"_5":14582,"_27821":55637,"_3006":55726},[],"`CertificateHold` allows reactivating the parent while it is not expired, but does not restore child CAs or certificates permanently revoked during the cascade. Holding a CA therefore does not provide a reversible pause for its entire branch.",{"_3550":1865,"_30605":1823,"_21201":55728,"_5":14582,"_27821":55637,"_3006":55729},[],"Before closing the change, compare the original dependency inventory with final states and verify revocation publication for each issuer. Do not use revocation as the ordinary mechanism to stop issuance: complete migration and remove the CA from operational flows.",{"_3550":1866,"_30605":1823,"_21201":55731,"_5":14582,"_27821":55641,"_3006":55732},[],"The new chain ends in an anchor installed by the consumer.",{"_3550":1867,"_30605":1823,"_21201":55734,"_5":14582,"_27821":55641,"_3006":55735},[],"New certificates contain the expected AKI, SKI, KU, EKU and SAN.",{"_3550":1868,"_30605":1823,"_21201":55737,"_5":14582,"_27821":55641,"_3006":55738},[],"The DMS delivers the correct chain through EST `/cacerts`.",{"_3550":1869,"_30605":1823,"_21201":55740,"_5":14582,"_27821":55641,"_3006":55741},[],"Re-enrollment accepts the old identity during the planned period.",{"_3550":1870,"_30605":1823,"_21201":55743,"_5":14582,"_27821":55641,"_3006":55744},[],"OCSP and CRL respond for the authorities that remain active.",{"_3550":1871,"_30605":1823,"_21201":55746,"_5":14582,"_27821":55641,"_3006":55747},[],"No DMS is left accidentally issuing from the old CA.",{"_3550":1872,"_30605":1823,"_21201":55749,"_5":14582,"_27821":55641,"_3006":55750},[],"See the Trust model to understand the DMS's CA sets and Certificate lifecycle for states and revocation effects.",{"_3550":1873,"_30605":1873,"_5":14934,"_3006":55752,"_30943":55753,"_21201":55754,"_27821":1873},"Certification authorities",[49963,51438,55589,55590],[],{"_3550":1874,"_30605":1873,"_21201":55756,"_5":14582,"_27821":1873,"_3006":55757},[],"Create, import and operate the authorities that establish your PKI's trust.",{"_3550":1875,"_30605":1873,"_5":30940,"_21201":55759,"_27821":55760,"_3006":55761},[],"/docs/platform/pki/certificate-authorities#choose-a-flow","Choose a flow",{"_3550":1876,"_30605":1873,"_5":30940,"_21201":55763,"_27821":55764,"_3006":55765},[],"/docs/platform/pki/certificate-authorities#create-a-new-authority","Create a new authority",{"_3550":1877,"_30605":1873,"_5":30940,"_21201":55767,"_27821":55768,"_3006":49973},[],"/docs/platform/pki/certificate-authorities#before-you-begin",{"_3550":1878,"_30605":1873,"_5":30940,"_21201":55770,"_27821":55771,"_3006":55772},[],"/docs/platform/pki/certificate-authorities#open-the-wizard","Open the wizard",{"_3550":1879,"_30605":1873,"_5":30940,"_21201":55774,"_27821":55775,"_3006":55776},[],"/docs/platform/pki/certificate-authorities#configure-the-key","Configure the key",{"_3550":1880,"_30605":1873,"_5":30940,"_21201":55778,"_27821":55779,"_3006":55780},[],"/docs/platform/pki/certificate-authorities#choose-the-ca-type","Choose the CA type",{"_3550":1881,"_30605":1873,"_5":30940,"_21201":55782,"_27821":55783,"_3006":55784},[],"/docs/platform/pki/certificate-authorities#define-the-identity","Define the identity",{"_3550":1882,"_30605":1873,"_5":30940,"_21201":55786,"_27821":55787,"_3006":55788},[],"/docs/platform/pki/certificate-authorities#configure-validity-and-uses","Configure validity and uses",{"_3550":1883,"_30605":1873,"_5":30940,"_21201":55790,"_27821":55791,"_3006":55792},[],"/docs/platform/pki/certificate-authorities#create-and-verify","Create and verify",{"_3550":1884,"_30605":1873,"_5":30940,"_21201":55794,"_27821":55795,"_3006":55796},[],"/docs/platform/pki/certificate-authorities#use-a-key-from-the-kms","Use a key from the KMS",{"_3550":1885,"_30605":1873,"_5":30940,"_21201":55798,"_27821":55799,"_3006":55800},[],"/docs/platform/pki/certificate-authorities#import-an-external-ca","Import an external CA",{"_3550":1886,"_30605":1873,"_5":30940,"_21201":55802,"_27821":55803,"_3006":55804},[],"/docs/platform/pki/certificate-authorities#select-the-engine","Select the engine",{"_3550":1887,"_30605":1873,"_5":30940,"_21201":55806,"_27821":55807,"_3006":55808},[],"/docs/platform/pki/certificate-authorities#load-the-material","Load the material",{"_3550":1888,"_30605":1873,"_5":30940,"_21201":55810,"_27821":55811,"_3006":55812},[],"/docs/platform/pki/certificate-authorities#define-the-default-issuance","Define the default issuance",{"_3550":1889,"_30605":1873,"_5":30940,"_21201":55814,"_27821":55815,"_3006":55816},[],"/docs/platform/pki/certificate-authorities#verify-the-import","Verify the import",{"_3550":1890,"_30605":1873,"_5":30940,"_21201":55818,"_27821":55819,"_3006":55820},[],"/docs/platform/pki/certificate-authorities#inspect-an-authority","Inspect an authority",{"_3550":1891,"_30605":1873,"_5":30940,"_21201":55822,"_27821":55823,"_3006":55824},[],"/docs/platform/pki/certificate-authorities#issue-certificates","Issue certificates",{"_3550":1892,"_30605":1873,"_5":30940,"_21201":55826,"_27821":55827,"_3006":55828},[],"/docs/platform/pki/certificate-authorities#revoke-a-ca","Revoke a CA",{"_3550":1893,"_30605":1873,"_5":30940,"_21201":55830,"_27821":55831,"_3006":55832},[],"/docs/platform/pki/certificate-authorities#assess-the-impact","Assess the impact",{"_3550":1894,"_30605":1873,"_5":30940,"_21201":55834,"_27821":55835,"_3006":55836},[],"/docs/platform/pki/certificate-authorities#start-the-revocation","Start the revocation",{"_3550":1895,"_30605":1873,"_5":30940,"_21201":55838,"_27821":55839,"_3006":55840},[],"/docs/platform/pki/certificate-authorities#confirm-the-identity","Confirm the identity",{"_3550":1896,"_30605":1873,"_5":30940,"_21201":55842,"_27821":55843,"_3006":55844},[],"/docs/platform/pki/certificate-authorities#check-the-publication","Check the publication",{"_3550":1897,"_30605":1873,"_5":30940,"_21201":55846,"_27821":55847,"_3006":55848},[],"/docs/platform/pki/certificate-authorities#delete-a-ca","Delete a CA",{"_3550":1898,"_30605":1873,"_21201":55850,"_5":14582,"_27821":1873,"_3006":55851},[],"A certification authority (CA) binds identities to public keys through signed certificates. In Lamassu you can create a new hierarchy, use a key already in the KMS or incorporate an external CA.",{"_3550":1899,"_30605":1873,"_21201":55853,"_5":14582,"_27821":1873,"_3006":55854},[],"To design a full chain or replace an authority in production, see CA hierarchy and rotation. If you need to standardize what each authority can sign, use Certificate profiles.",{"_3550":1900,"_30605":1873,"_21201":55856,"_5":14582,"_27821":1873,"_3006":55857},[],"To administer CAs, you need authority and key permissions, a reachable engine and a reviewed profile. An external consumer does not trust a CA merely because it appears in this inventory: agree root and chain distribution separately.",{"_3550":1901,"_30605":1873,"_21201":55859,"_5":14582,"_27821":55760,"_3006":55860},[],"**New CA with a new key:** create a root of trust from scratch. Lamassu generates and keeps the key pair.",{"_3550":1902,"_30605":1873,"_21201":55862,"_5":14582,"_27821":55760,"_3006":55863},[],"**New CA from the KMS:** reuse a key already registered in the platform.",{"_3550":1903,"_30605":1873,"_21201":55865,"_5":14582,"_27821":55760,"_3006":55866},[],"**Import a CA with its private key:** incorporate an external authority that Lamassu can issue with.",{"_3550":1904,"_30605":1873,"_21201":55868,"_5":14582,"_27821":55760,"_3006":55869},[],"**Import only the certificate:** register public material. If Lamassu finds its key in the KMS, it can associate it; otherwise, the CA has no usable key for issuance.",{"_3550":1905,"_30605":1873,"_21201":55871,"_5":14582,"_27821":55760,"_3006":55872},[],"First time here? Follow Create your first CA to complete the minimal journey.",{"_3550":1906,"_30605":1873,"_21201":55874,"_5":14582,"_27821":55768,"_3006":55875},[],"Decide whether the CA will be a root or an intermediate.",{"_3550":1907,"_30605":1873,"_21201":55877,"_5":14582,"_27821":55768,"_3006":55878},[],"Choose the engine that will keep the key.",{"_3550":1908,"_30605":1873,"_21201":55880,"_5":14582,"_27821":55768,"_3006":55881},[],"Define a validity longer than that of the certificates it will issue.",{"_3550":1909,"_30605":1873,"_21201":55883,"_5":14582,"_27821":55768,"_3006":55884},[],"For an intermediate CA, make sure the parent CA is active.",{"_3550":1910,"_30605":1873,"_21201":55886,"_5":14582,"_27821":55771,"_3006":55887},[],"In **Certification Authorities**, select **Create New CA** and choose to generate a new key pair.",{"_3550":1911,"_30605":1873,"_21201":55889,"_5":14582,"_27821":55775,"_3006":55890},[],"Select the cryptographic engine, the algorithm and the size or curve. Lamassu supports RSA and EC keys according to the engine's capabilities.",{"_3550":1912,"_30605":1873,"_21201":55892,"_5":14582,"_27821":55775,"_3006":55893},[],"Use only sizes and curves supported by the engine and the profile’s cryptographic policy. Read Keys and engines before reusing external material.",{"_3550":1913,"_30605":1873,"_21201":55895,"_5":14582,"_27821":55779,"_3006":55896},[],"Select **Root CA** for a self-signed authority or **Intermediate CA** for an authority signed by another CA. In the latter case, choose the issuing CA.",{"_3550":1914,"_30605":1873,"_21201":55898,"_5":14582,"_27821":55783,"_3006":55899},[],"Enter a unique **CA Name**. This name becomes the certificate's `Common Name`. Complete the Distinguished Name fields your policy requires:",{"_3550":1915,"_30605":1873,"_21201":55901,"_5":14582,"_27821":55783,"_3006":55902},[],"`C`: two-letter ISO 3166-1 country code.",{"_3550":1916,"_30605":1873,"_21201":55904,"_5":14582,"_27821":55783,"_3006":55905},[],"`ST`: state or province.",{"_3550":1917,"_30605":1873,"_21201":55907,"_5":14582,"_27821":55783,"_3006":55908},[],"`L`: locality.",{"_3550":1918,"_30605":1873,"_21201":55910,"_5":14582,"_27821":55783,"_3006":55911},[],"`O`: organization.",{"_3550":1919,"_30605":1873,"_21201":55913,"_5":14582,"_27821":55783,"_3006":55914},[],"`OU`: organizational unit.",{"_3550":1920,"_30605":1873,"_21201":55916,"_5":14582,"_27821":55783,"_3006":55917},[],"The CA's internal identifier is generated automatically and cannot be changed.",{"_3550":1921,"_30605":1873,"_21201":55919,"_5":14582,"_27821":55787,"_3006":55920},[],"Define **CA Certificate Expiration** and **Default End-Entity Certificate Issuance Expiration**. You can express a duration (`5y 8w 4d`), pick a date or use the maximum allowed date.",{"_3550":1922,"_30605":1873,"_21201":55922,"_5":14582,"_27821":55787,"_3006":55923},[],"Review the CA’s own certificate separately from the default profile for certificates it will issue later. Choose an explicit issuance policy; do not assume the form’s initial values suit your consumers.",{"_3550":1923,"_30605":1873,"_21201":55925,"_5":14582,"_27821":55791,"_3006":55926},[],"Confirm the form and open the CA. Check status, issuer, dates, associated engine and key. Download the certificate: it should contain `CA:TRUE` and a usage permitting certificate signing. Verify the self-signature for a root or the chain to your root for an intermediate. Complete a test issuance to check that the key can actually sign.",{"_3550":1924,"_30605":1873,"_21201":55928,"_5":14582,"_27821":55791,"_3006":55929},[],"Plan and verify expiration using the Profiles rules. Issuance does not automatically clamp validity to the issuer’s expiration; leave time to replace the authority and renew identities.",{"_3550":1925,"_30605":1873,"_21201":55931,"_5":14582,"_27821":55795,"_3006":55932},[],"Select &#x2A;*Create New CA (Existing Key)** when the key is already registered in Lamassu. The wizard first asks for the backing key and then shows the same configuration of type, identity, validity and profile.",{"_3550":1926,"_30605":1873,"_21201":55934,"_5":14582,"_27821":55795,"_3006":55935},[],"This flow is useful when the key was previously created in an HSM, imported through BYOK or must be reused under a specific custody policy.",{"_3550":1927,"_30605":1873,"_21201":55937,"_5":14582,"_27821":55799,"_3006":55938},[],"You need the CA certificate in PEM, its chain to a known root and, when importing it, an exportable private key. Before uploading material, verify signature, dates, `CA:TRUE`, signing usages (including `cRLSign`, without which the CA cannot publish its CRL) and public-key correspondence. The key verification procedure also compares a CA key and certificate.",{"_3550":1928,"_30605":1873,"_21201":55940,"_5":14582,"_27821":55799,"_3006":55941},[],"The backend rejects an import whose certificate lacks the CA basic constraint (`basicConstraints cA flag is not set`), whose serial number matches a stored certificate with different contents, or whose identical certificate already belongs to an existing CA. A deleted CA's certificate record is kept and can be reused when re-importing the same certificate, including its previous status. Re-importing a different certificate with that serial number is rejected; check the certificate and status after re-importing.",{"_3550":1929,"_30605":1873,"_21201":55943,"_5":14582,"_27821":55799,"_3006":55944},[],"Deleting a CA releases the key references of its own current certificate and linked reissued certificates, while keeping those records for its issuer's CRL and OCSP. It then attempts to delete the key; the KMS keeps it if other certificates still reference it, such as another CA sharing the key. Revoking certificates issued by the deleted CA does not release their own key references.",{"_3550":1930,"_30605":1873,"_21201":55946,"_5":14582,"_27821":55803,"_3006":55947},[],"Check the installation’s default engine before importing a CA with a key. CA import delegates key import to that engine; it does not guarantee arbitrary provider selection from the form. To select an engine while importing the key separately, use the KMS.",{"_3550":1931,"_30605":1873,"_21201":55949,"_5":14582,"_27821":55807,"_3006":55950},[],"Import the certificate and, when applicable, its PEM key. Register the CAs needed to identify the issuer. Registering a CA does not install it in external trust stores.",{"_3550":1932,"_30605":1873,"_21201":55952,"_5":14582,"_27821":55807,"_3006":55953},[],"The backend validates before importing any key: a duplicate CA ID and a certificate that is not a CA (missing `basicConstraints` `cA=TRUE`) are rejected, the latter with `400` `certificate is not a CA: basicConstraints cA flag is not set`. If a failure occurs after the key was imported, the key is kept in the KMS and a warning tells you to delete it manually.",{"_3550":1933,"_30605":1873,"_21201":55955,"_5":14582,"_27821":55811,"_3006":55956},[],"Associate an explicit issuance profile if the CA will sign. Check usages and dates using Profiles.",{"_3550":1934,"_30605":1873,"_21201":55958,"_5":14582,"_27821":55815,"_3006":55959},[],"Review the registered type, associated key and engine, and issuer relationship. Certificate-only import may associate an existing KMS key using the certificate’s key identifier. Without a usable key, the CA is public material and cannot sign.",{"_3550":1935,"_30605":1873,"_21201":55961,"_5":14582,"_27821":55815,"_3006":55962},[],"For an issuing CA, complete a test issuance and check OCSP and CRL. Creating the record alone does not establish key availability, complete chain consistency or status publication.",{"_3550":1936,"_30605":1873,"_21201":55964,"_5":14582,"_27821":55819,"_3006":55965},[],"Open a CA from the inventory to review:",{"_3550":1937,"_30605":1873,"_21201":55967,"_5":14582,"_27821":55819,"_3006":55968},[],"Status and validity period.",{"_3550":1938,"_30605":1873,"_21201":55970,"_5":14582,"_27821":55819,"_3006":55971},[],"Certificate and chain in PEM format.",{"_3550":1939,"_30605":1873,"_21201":55973,"_5":14582,"_27821":55819,"_3006":55974},[],"Number of active, expired and revoked certificates.",{"_3550":1940,"_30605":1873,"_21201":55976,"_5":14582,"_27821":55819,"_3006":55977},[],"Certificates issued in **Issued Certificates**.",{"_3550":1941,"_30605":1873,"_21201":55979,"_5":14582,"_27821":55819,"_3006":55980},[],"The CRL linked to the authority.",{"_3550":1942,"_30605":1873,"_21201":55982,"_5":14582,"_27821":55819,"_3006":55983},[],"Metadata and the associated cryptographic engine.",{"_3550":1943,"_30605":1873,"_21201":55985,"_5":14582,"_27821":55819,"_3006":55986},[],"You can filter the inventory by name, status and CA type.",{"_3550":1944,"_30605":1873,"_21201":55988,"_5":14582,"_27821":55823,"_3006":55989},[],"You can start an issuance from **Issued Certificates**, from a CA's action menu or from the global certificate inventory.",{"_3550":1945,"_30605":1873,"_21201":55991,"_5":14582,"_27821":55823,"_3006":55992},[],"**Generate Key & CSR in Browser** is useful for a manual operation or a quick test. The browser generates the key and you must download it at the end.",{"_3550":1946,"_30605":1873,"_21201":55994,"_5":14582,"_27821":55823,"_3006":55995},[],"**Upload Existing CSR** is the right option when the key must remain on the target system. Lamassu receives the request but never the private key.",{"_3550":1947,"_30605":1873,"_21201":55997,"_5":14582,"_27821":55823,"_3006":55998},[],"Follow Issue your first certificate for the guided flow. Certificate management explains the inventory, inspection and revocation.",{"_3550":1948,"_30605":1873,"_21201":56000,"_5":14582,"_27821":55827,"_3006":56001},[],"Revoking a CA prevents issuance and may interrupt its entire branch. Only `CertificateHold` allows reactivating the CA itself if it is not expired. Descendant revocation is attempted with `CessationOfOperation`; reactivating the parent does not restore those descendants. Follow the cascading revocation conditions.",{"_3550":1949,"_30605":1873,"_21201":56003,"_5":14582,"_27821":55831,"_3006":56004},[],"Identify the certificates, devices and consumers that depend on the CA. Prepare a replacement authority and chain when necessary.",{"_3550":1950,"_30605":1873,"_21201":56006,"_5":14582,"_27821":55835,"_3006":56007},[],"Open the authority and select **Revoke CA**. Choose the reason that describes the incident, for example `KeyCompromise`, `CACompromise`, `Superseded` or `CessationOfOperation`.",{"_3550":1951,"_30605":1873,"_21201":56009,"_5":14582,"_27821":55839,"_3006":56010},[],"Type the CA's name exactly to enable **Confirm Revocation**.",{"_3550":1952,"_30605":1873,"_21201":56012,"_5":14582,"_27821":55843,"_3006":56013},[],"Check **REVOKED** on the CA and review descendants individually; propagation permits partial failures. Independently verify OCSP and CRL publication and consumer rejection. A revoked record does not guarantee that an existing session closes.",{"_3550":1953,"_30605":1873,"_21201":56015,"_5":14582,"_27821":55847,"_3006":56016},[],"Permanent deletion is only available with the CA revoked or expired; a CA imported without a key can be deleted in any state. Delete the record only when your retention and audit policy allows it.",{"_3550":1954,"_30605":1873,"_21201":56018,"_5":14582,"_27821":55847,"_3006":56019},[],"The CA’s CRL settings are kept. A deletion is refused with a `409` error while they are still `ACTIVE`: the VA must first publish the CA’s final CRL, which can take up to about an hour after revocation with the default job schedule, so retry after the final CRL is published. An expired CA is finalized without a final CRL, and a CA on hold (`CertificateHold`) is refused with a message asking you to revoke it permanently first. The deletion is also refused with a `409` when the CA’s key signs the CRLs of another CA: the error names that CA, so change its CRL signer, or delete or revoke it, before deleting this one. The CA and all its descendants are checked before anything is deleted; nothing changes if any of them cannot be deleted.",{"_3550":1955,"_30605":1873,"_21201":56021,"_5":14582,"_27821":55847,"_3006":56022},[],"After the deletion, the settings are archived and the last CRL keeps being served but is never regenerated; you can remove them once no certificate issued by the CA still needs revocation evidence, using `DELETE /v1/crl-settings/{ca-id}` or the console's **Verification Authorities** page. Deleting them stops the CRL from being served and cannot be undone. Adjust the validity and signer before revoking or deleting the CA (see CRL). The CA’s key is released, but the KMS keeps it while other certificates still reference it.",{"_3550":1956,"_30605":1873,"_21201":56024,"_5":14582,"_27821":55847,"_3006":56025},[],"Lamassu keeps the certificate record of a deleted CA. If that same certificate is imported again, the import succeeds and reuses the record: it updates the type, issuer and key but keeps the status, so the CA reappears in the state it had when deleted (normally revoked or expired). A different certificate with the same serial number is rejected with a 400 error, and a certificate that already belongs to an existing CA with a 409 error. To avoid inheriting the previous status, use a certificate with a different serial number and check the result after importing. The reimported CA is registered under a new, backend-generated CA ID and does not inherit the CRL settings of the deleted CA: until those settings are deleted, those keep serving their last CRL at the CA ID URL, and at `/crl/<ski>` — the URL that certificates issued before the 4.0.0 upgrade carry — when the settings were migrated by that upgrade; when they are archived, they can no longer be edited (see CRL).",{"_3550":1957,"_30605":1957,"_5":14934,"_3006":56027,"_30943":56028,"_21201":56029,"_27821":1957},"Certificate profiles",[49963,51438,55589,55590],[],{"_3550":1958,"_30605":1957,"_21201":56031,"_5":14582,"_27821":1957,"_3006":56032},[],"Define reusable policies to issue consistent certificates and constrain accepted keys.",{"_3550":1959,"_30605":1957,"_5":30940,"_21201":56034,"_27821":56035,"_3006":56036},[],"/docs/platform/pki/certificate-profiles#what-a-profile-controls","What a profile controls",{"_3550":1960,"_30605":1957,"_5":30940,"_21201":56038,"_27821":56039,"_3006":56040},[],"/docs/platform/pki/certificate-profiles#validity","Validity",{"_3550":1961,"_30605":1957,"_5":30940,"_21201":56042,"_27821":56043,"_3006":56044},[],"/docs/platform/pki/certificate-profiles#ca-certificate-or-end-entity-certificate","CA certificate or end-entity certificate",{"_3550":1962,"_30605":1957,"_5":30940,"_21201":56046,"_27821":56047,"_3006":56048},[],"/docs/platform/pki/certificate-profiles#key-usage-and-extended-key-usage","Key Usage and Extended Key Usage",{"_3550":1963,"_30605":1957,"_5":30940,"_21201":56050,"_27821":56051,"_3006":56052},[],"/docs/platform/pki/certificate-profiles#subject","Subject",{"_3550":1964,"_30605":1957,"_5":30940,"_21201":56054,"_27821":56055,"_3006":56056},[],"/docs/platform/pki/certificate-profiles#csr-extensions","CSR extensions",{"_3550":1965,"_30605":1957,"_5":30940,"_21201":56058,"_27821":56059,"_3006":56060},[],"/docs/platform/pki/certificate-profiles#cryptographic-constraints","Cryptographic constraints",{"_3550":1966,"_30605":1957,"_5":30940,"_21201":56062,"_27821":56063,"_3006":56064},[],"/docs/platform/pki/certificate-profiles#profile-precedence","Profile precedence",{"_3550":1967,"_30605":1957,"_5":30940,"_21201":56066,"_27821":56067,"_3006":56068},[],"/docs/platform/pki/certificate-profiles#create-a-profile","Create a profile",{"_3550":1968,"_30605":1957,"_5":30940,"_21201":56070,"_27821":56071,"_3006":56072},[],"/docs/platform/pki/certificate-profiles#define-a-single-purpose","Define a single purpose",{"_3550":1969,"_30605":1957,"_5":30940,"_21201":56074,"_27821":56075,"_3006":56076},[],"/docs/platform/pki/certificate-profiles#choose-the-validity","Choose the validity",{"_3550":1970,"_30605":1957,"_5":30940,"_21201":56078,"_27821":56079,"_3006":56080},[],"/docs/platform/pki/certificate-profiles#fix-usages-and-subject","Fix usages and subject",{"_3550":1971,"_30605":1957,"_5":30940,"_21201":56082,"_27821":56083,"_3006":56084},[],"/docs/platform/pki/certificate-profiles#constrain-the-keys","Constrain the keys",{"_3550":1972,"_30605":1957,"_5":30940,"_21201":56086,"_27821":56087,"_3006":56088},[],"/docs/platform/pki/certificate-profiles#attach-it-and-test","Attach it and test",{"_3550":1973,"_30605":1957,"_5":30940,"_21201":56090,"_27821":56091,"_3006":56092},[],"/docs/platform/pki/certificate-profiles#design-examples","Design examples",{"_3550":1974,"_30605":1957,"_5":30940,"_21201":56094,"_27821":56095,"_3006":56096},[],"/docs/platform/pki/certificate-profiles#changes-and-deletion","Changes and deletion",{"_3550":1975,"_30605":1957,"_21201":56098,"_5":14582,"_27821":1957,"_3006":56099},[],"An issuance profile turns a certificate policy into reusable configuration. Instead of deciding validity, subject, extensions and algorithms on every request, you define once what is allowed and attach the profile to a CA, a DMS or a specific issuance.",{"_3550":1976,"_30605":1957,"_21201":56101,"_5":14582,"_27821":1957,"_3006":56102},[],"This guide is for the PKI administrator defining issuance policy. You need permissions to manage profiles and associate them with the intended CA or DMS, plus a test consumer with known identity and purpose requirements.",{"_3550":1977,"_30605":1957,"_21201":56104,"_5":14582,"_27821":56039,"_3006":56105},[],"You can express the lifetime as a duration from the moment of issuance or as a fixed end date. A duration works well for recurring identities; a common date is useful to make a whole batch end before a migration or retirement.",{"_3550":1978,"_30605":1957,"_21201":56107,"_5":14582,"_27821":56039,"_3006":56108},[],"Plan the end date within the issuing CA’s validity and leave a renewal margin. The signer calculates the date from the profile; it does not automatically clamp validity to the issuer’s expiration. Check both dates in the resulting certificate. A fixed date in the past does not produce a usable identity either.",{"_3550":1979,"_30605":1957,"_21201":56110,"_5":14582,"_27821":56043,"_3006":56111},[],"`Sign as CA` sets `IsCA` and the basic constraints needed for an authority. Lamassu enforces this: a profile with `Sign as CA` is consumed only when creating or reissuing a CA. Any signing request that resolves to such a profile is rejected — direct signing with a CA, including certificate issuance requests on it, and DMS enrollment or re-enrollment. Nothing validates the profile when it is saved: if a CA's default profile or a DMS profile has `Sign as CA` enabled, the problem appears on the first signing request that resolves to it — for a DMS profile, when a device tries to enroll or re-enroll — and renewal stays blocked until the profile is changed.",{"_3550":1980,"_30605":1957,"_21201":56113,"_5":14582,"_27821":56047,"_3006":56114},[],"The profile can enforce usages such as `DigitalSignature`, `KeyEncipherment`, `CertSign`, `CRLSign`, `ClientAuth`, `ServerAuth` or `OCSPSigning`.",{"_3550":1981,"_30605":1957,"_21201":56116,"_5":14582,"_27821":56047,"_3006":56117},[],"If you enable **Honor Key Usage** or **Honor Extended Key Usages**, Lamassu keeps the values requested by the CSR. If you disable them, it replaces them with the ones defined in the profile.",{"_3550":1982,"_30605":1957,"_21201":56119,"_5":14582,"_27821":56047,"_3006":56120},[],"Do not enable the `Honor…` options for untrusted requests unless another component validates those fields. Otherwise, the requester may choose broader capabilities than intended.",{"_3550":1983,"_30605":1957,"_21201":56122,"_5":14582,"_27821":56051,"_3006":56123},[],"With **Honor Subject**, the certificate keeps the subject of the CSR. Without that option, Lamassu applies the profile's `CN`, `O`, `OU`, `C`, `ST` and `L`. If the profile does not define a `Common Name`, the requested CN is kept.",{"_3550":1984,"_30605":1957,"_21201":56125,"_5":14582,"_27821":56055,"_3006":56126},[],"With **Honor Extensions**, Lamassu filters the additional requested extensions and keeps only SAN. Without that option, it discards the CSR's additional extensions.",{"_3550":1985,"_30605":1957,"_21201":56128,"_5":14582,"_27821":56055,"_3006":56129},[],"This preserves SAN, but does not establish that the requester is entitled to those DNS names, IP addresses, emails or URIs. Validate that authorization before issuing. OCSP and CRL locations come from the issuance service configuration; `Honor Extensions` does not copy CSR distribution points.",{"_3550":1986,"_30605":1957,"_21201":56131,"_5":14582,"_27821":56059,"_3006":56132},[],"The cryptographic enforcement can:",{"_3550":1987,"_30605":1957,"_21201":56134,"_5":14582,"_27821":56059,"_3006":56135},[],"allow or block RSA keys;",{"_3550":1988,"_30605":1957,"_21201":56137,"_5":14582,"_27821":56059,"_3006":56138},[],"limit the supported RSA sizes;",{"_3550":1989,"_30605":1957,"_21201":56140,"_5":14582,"_27821":56059,"_3006":56141},[],"allow or block ECDSA keys;",{"_3550":1990,"_30605":1957,"_21201":56143,"_5":14582,"_27821":56059,"_3006":56144},[],"limit the supported ECDSA sizes or curves.",{"_3550":1991,"_30605":1957,"_21201":56146,"_5":14582,"_27821":56059,"_3006":56147},[],"When it is enabled, Lamassu checks the public key before creating a CA or signing a CSR. A key whose type or size is not listed in the profile is rejected.",{"_3550":1992,"_30605":1957,"_21201":56149,"_5":14582,"_27821":56063,"_3006":56150},[],"Resolution depends on the entry point. One complete profile is selected; its fields are not merged with the CA’s profile.",{"_3550":1993,"_30605":1957,"_21201":56152,"_5":14582,"_27821":56063,"_3006":53351},[],{"_3550":1994,"_30605":1957,"_21201":56154,"_5":14582,"_27821":56063,"_3006":56155},[],"First choice",{"_3550":1995,"_30605":1957,"_21201":56157,"_5":14582,"_27821":56063,"_3006":56158},[],"Second choice",{"_3550":1996,"_30605":1957,"_21201":56160,"_5":14582,"_27821":56063,"_3006":56161},[],"If neither is supplied",{"_3550":1997,"_30605":1957,"_21201":56163,"_5":14582,"_27821":56063,"_3006":56164},[],"Direct signing with a CA",{"_3550":1998,"_30605":1957,"_21201":56166,"_5":14582,"_27821":56063,"_3006":56167},[],"`issuance_profile` embedded in the request",{"_3550":1999,"_30605":1957,"_21201":56169,"_5":14582,"_27821":56063,"_3006":56170},[],"Request `issuance_profile_id`",{"_3550":2000,"_30605":1957,"_21201":56172,"_5":14582,"_27821":56063,"_3006":56173},[],"CA default profile (`profile_id`).",{"_3550":2001,"_30605":1957,"_21201":56175,"_5":14582,"_27821":56063,"_3006":56176},[],"Issuance through a DMS",{"_3550":2002,"_30605":1957,"_21201":56178,"_5":14582,"_27821":56063,"_3006":56179},[],"`settings.issuance_profile_id`",{"_3550":2003,"_30605":1957,"_21201":56181,"_5":14582,"_27821":56063,"_3006":56182},[],"`settings.issuance_profile` embedded in the DMS",{"_3550":2004,"_30605":1957,"_21201":56184,"_5":14582,"_27821":56063,"_3006":56185},[],"Enrollment CA default profile.",{"_3550":2005,"_30605":1957,"_21201":56187,"_5":14582,"_27821":56063,"_3006":56188},[],"If the selected identifier cannot be resolved, the operation fails; it does not silently fall back to the CA’s profile. Avoid setting both options at once. Recording which profile was selected helps explain why a certificate differs from its CSR.",{"_3550":2006,"_30605":1957,"_21201":56190,"_5":14582,"_27821":56063,"_3006":56191},[],"Several fleets can share a CA while keeping different profiles through their DMSs. Requester authentication and device registration policy are configured separately in DMS.",{"_3550":2007,"_30605":1957,"_21201":56193,"_5":14582,"_27821":56071,"_3006":56194},[],"Separate, for example, mTLS devices, servers and intermediate CAs. A small, specific profile is easier to review than one that allows every use.",{"_3550":2008,"_30605":1957,"_21201":56196,"_5":14582,"_27821":56075,"_3006":56197},[],"Align the duration with the fleet's real renewal capacity. Leave margin against the CA's expiration.",{"_3550":2009,"_30605":1957,"_21201":56199,"_5":14582,"_27821":56079,"_3006":56200},[],"For a device that authenticates as a client, the usual starting point is `DigitalSignature` and `ClientAuth`. Add `ServerAuth` or `KeyEncipherment` only if the protocol needs it.",{"_3550":2010,"_30605":1957,"_21201":56202,"_5":14582,"_27821":56083,"_3006":56203},[],"Enable cryptographic enforcement and list only algorithms and sizes compatible with your policy and your devices.",{"_3550":2011,"_30605":1957,"_21201":56205,"_5":14582,"_27821":56087,"_3006":56206},[],"Attach the profile to a CA or DMS and check the precedence above. Issue a CSR with known usages and SAN; inspect the result with `openssl x509 -in device.crt -noout -text`. Check subject, SAN, KU, EKU and dates. For an end-entity identity, disable `Sign as CA`, require no `CA:TRUE` or `Certificate Sign`, and require `CA:FALSE` if Basic Constraints is present.",{"_3550":2012,"_30605":1957,"_21201":56208,"_5":14582,"_27821":56087,"_3006":56209},[],"Also try a key excluded by policy: issuance should fail. Follow the certificate verification and test acceptance in the intended consumer.",{"_3550":2013,"_30605":1957,"_21201":56211,"_5":14582,"_27821":56091,"_3006":56212},[],"**mTLS device**\\\nEnd-entity certificate, short validity, `DigitalSignature`, `ClientAuth`, subject controlled by the DMS and SAN allowed when it identifies the device.",{"_3550":2014,"_30605":1957,"_21201":56214,"_5":14582,"_27821":56091,"_3006":56215},[],"**TLS server**\\\nEnd-entity certificate, `DigitalSignature`, `ServerAuth` and mandatory SAN with the names clients will use.",{"_3550":2015,"_30605":1957,"_21201":56217,"_5":14582,"_27821":56091,"_3006":56218},[],"**Intermediate CA**\\\n`Sign as CA`, `CertSign` and `CRLSign`, validity longer than its end-entity certificates and stricter cryptographic constraints.",{"_3550":2016,"_30605":1957,"_21201":56220,"_5":14582,"_27821":56091,"_3006":56221},[],"These patterns express design decisions. Enabling `Honor Extensions` does not require a CSR to contain SAN or validate its names; enforce that in the request workflow. A profile does not install trust or grant permissions in the consumer.",{"_3550":2017,"_30605":1957,"_21201":56223,"_5":14582,"_27821":56095,"_3006":56224},[],"Updating a profile affects future issuances; it does not modify already-signed certificates. Test changes before applying them to a CA in production and keep the operational justification.",{"_3550":2018,"_30605":1957,"_21201":56226,"_5":14582,"_27821":56095,"_3006":56227},[],"Before deleting a profile, check that no CA or DMS depends on it. If you want to replace it, create the new version, update the references and perform a test issuance before retiring the old one.",{"_3550":2019,"_30605":2019,"_5":14934,"_3006":56229,"_30943":56230,"_21201":56232,"_27821":2019},"Certificate validation",[49963,51438,55589,56231],"Validation",[],{"_3550":2020,"_30605":2019,"_21201":56234,"_5":14582,"_27821":2019,"_3006":56235},[],"Check chain, identity, purpose and revocation from the consumer.",{"_3550":2021,"_30605":2019,"_5":30940,"_21201":56237,"_27821":56238,"_3006":56239},[],"/docs/platform/pki/certificate-validation#before-querying-status","Before querying status",{"_3550":2022,"_30605":2019,"_5":30940,"_21201":56241,"_27821":56242,"_3006":56243},[],"/docs/platform/pki/certificate-validation#choose-a-mechanism","Choose a mechanism",{"_3550":2023,"_30605":2019,"_5":30940,"_21201":56245,"_27821":56246,"_3006":56247},[],"/docs/platform/pki/certificate-validation#check-consumer-behavior","Check consumer behavior",{"_3550":2024,"_30605":2019,"_21201":56249,"_5":14582,"_27821":2019,"_3006":56250},[],"This guide brings together the checks needed when integrating a certificate consumer. You need the presented certificate, intermediates and roots that your application has deliberately chosen to trust. Lamassu publishes status; the consumer applies acceptance policy.",{"_3550":2025,"_30605":2019,"_21201":56252,"_5":14582,"_27821":56238,"_3006":56253},[],"Verify these criteria together:",{"_3550":2026,"_30605":2019,"_21201":56255,"_5":14582,"_27821":56238,"_3006":55215},[],{"_3550":2027,"_30605":2019,"_21201":56257,"_5":14582,"_27821":56238,"_3006":56258},[],"Required result",{"_3550":2028,"_30605":2019,"_21201":56260,"_5":14582,"_27821":56238,"_3006":56261},[],"Chain and signature",{"_3550":2029,"_30605":2019,"_21201":56263,"_5":14582,"_27821":56238,"_3006":56264},[],"Valid chain to a root deliberately installed in the consumer.",{"_3550":2030,"_30605":2019,"_21201":56266,"_5":14582,"_27821":56238,"_3006":56267},[],"Dates",{"_3550":2031,"_30605":2019,"_21201":56269,"_5":14582,"_27821":56238,"_3006":56270},[],"Current time between `Not Before` and `Not After`, including the CAs in the chain.",{"_3550":2032,"_30605":2019,"_21201":56272,"_5":14582,"_27821":56238,"_3006":51107},[],{"_3550":2033,"_30605":2019,"_21201":56274,"_5":14582,"_27821":56238,"_3006":56275},[],"Name, SAN or identifier matches the expected peer.",{"_3550":2034,"_30605":2019,"_21201":56277,"_5":14582,"_27821":56238,"_3006":50353},[],{"_3550":2035,"_30605":2019,"_21201":56279,"_5":14582,"_27821":56238,"_3006":56280},[],"KU, EKU and constraints permit the specific operation.",{"_3550":2036,"_30605":2019,"_21201":56282,"_5":14582,"_27821":56238,"_3006":56283},[],"Revocation",{"_3550":2037,"_30605":2019,"_21201":56285,"_5":14582,"_27821":56238,"_3006":56286},[],"Signed, current evidence corresponding to the queried issuer and certificate.",{"_3550":2038,"_30605":2019,"_21201":56288,"_5":14582,"_27821":56238,"_3006":56289},[],"Authorization",{"_3550":2039,"_30605":2019,"_21201":56291,"_5":14582,"_27821":56238,"_3006":56292},[],"The application permits that identity to perform the action.",{"_3550":2040,"_30605":2019,"_21201":56294,"_5":14582,"_27821":56238,"_3006":56295},[],"The issuance walkthrough checks chain and purpose with OpenSSL. That check does not automatically query OCSP or download a CRL. Inventory presence or an OCSP `Good` response does not replace the other criteria.",{"_3550":2041,"_30605":2019,"_21201":56297,"_5":14582,"_27821":56242,"_3006":56298},[],"Mechanism",{"_3550":2042,"_30605":2019,"_21201":56300,"_5":14582,"_27821":56242,"_3006":56301},[],"When to use it",{"_3550":2043,"_30605":2019,"_21201":56303,"_5":14582,"_27821":56242,"_3006":56304},[],"What you must maintain",{"_3550":2044,"_30605":2019,"_21201":56306,"_5":14582,"_27821":56242,"_3006":56307},[],"OCSP",{"_3550":2045,"_30605":2019,"_21201":56309,"_5":14582,"_27821":56242,"_3006":56310},[],"Status query for a specific certificate.",{"_3550":2046,"_30605":2019,"_21201":56312,"_5":14582,"_27821":56242,"_3006":56313},[],"Responder access, signature verification and cache/freshness policy.",{"_3550":2047,"_30605":2019,"_21201":56315,"_5":14582,"_27821":56242,"_3006":56316},[],"CRL",{"_3550":2048,"_30605":2019,"_21201":56318,"_5":14582,"_27821":56242,"_3006":56319},[],"Local checks for many certificates or offline operation.",{"_3550":2049,"_30605":2019,"_21201":56321,"_5":14582,"_27821":56242,"_3006":56322},[],"Periodic download of an issuer-signed list and rejection of expired lists.",{"_3550":2050,"_30605":2019,"_21201":56324,"_5":14582,"_27821":56242,"_3006":56325},[],"OCSP can also return a response reusable until `nextUpdate`; a CRL changes when a new version is published. Neither mechanism alone guarantees that a consumer learns a revocation at the moment it is saved.",{"_3550":2051,"_30605":2019,"_21201":56327,"_5":14582,"_27821":56242,"_3006":56328},[],"If using both, define when fallback is allowed and what the client does when retrieval, signature or freshness checks fail, or the result is `Unknown`. Accepting an identity when its status cannot be checked must be an explicit application decision.",{"_3550":2052,"_30605":2019,"_21201":56330,"_5":14582,"_27821":56246,"_3006":56331},[],"Accept a current, authorized certificate with a known chain.",{"_3550":2053,"_30605":2019,"_21201":56333,"_5":14582,"_27821":56246,"_3006":56334},[],"Reject another certificate with an unknown root or incompatible purpose.",{"_3550":2054,"_30605":2019,"_21201":56336,"_5":14582,"_27821":56246,"_3006":56337},[],"Revoke a test certificate and verify the OCSP response or new CRL.",{"_3550":2055,"_30605":2019,"_21201":56339,"_5":14582,"_27821":56246,"_3006":56340},[],"Check that a new connection with that identity is rejected.",{"_3550":2056,"_30605":2019,"_21201":56342,"_5":14582,"_27821":56246,"_3006":56343},[],"Simulate an unreachable endpoint and expired evidence; observe whether the result matches policy.",{"_3550":2057,"_30605":2019,"_21201":56345,"_5":14582,"_27821":56246,"_3006":56346},[],"Keep the serial number, issuer, revocation reason, query time and evidence timestamps. An existing session may need explicit closure or reauthentication in the consumer; publishing revocation does not automatically close it.",{"_3550":2058,"_30605":2019,"_21201":56348,"_5":14582,"_27821":56246,"_3006":56349},[],"For a chain with intermediates, validate their status according to consumer policy as well. An end-entity issuer’s CRL does not replace checks on every CA in the chain.",{"_3550":2059,"_30605":2019,"_21201":56351,"_5":14582,"_27821":56246,"_3006":56352},[],"<Card title=\"Online validation with OCSP\" description=\"Generate a query and verify signature, status and timestamps.\" href=\"/docs/platform/pki/ocsp\" />",{"_3550":2060,"_30605":2019,"_21201":56354,"_5":14582,"_27821":56246,"_3006":56355},[],"<Card title=\"Revocation lists\" description=\"Download, inspect and use an issuer’s CRL.\" href=\"/docs/platform/pki/crl\" />",{"_3550":2061,"_30605":2061,"_5":14934,"_3006":56357,"_30943":56358,"_21201":56359,"_27821":2061},"Certificates",[49963,51438,55589,55590],[],{"_3550":2062,"_30605":2061,"_21201":56361,"_5":14582,"_27821":2061,"_3006":56362},[],"Inspect, download and revoke the certificates issued by Lamassu.",{"_3550":2063,"_30605":2061,"_5":30940,"_21201":56364,"_27821":56365,"_3006":56366},[],"/docs/platform/pki/certificates#find-a-certificate","Find a certificate",{"_3550":2064,"_30605":2061,"_5":30940,"_21201":56368,"_27821":56369,"_3006":56370},[],"/docs/platform/pki/certificates#download-the-certificate","Download the certificate",{"_3550":2065,"_30605":2061,"_5":30940,"_21201":56372,"_27821":56373,"_3006":56374},[],"/docs/platform/pki/certificates#issue-from-an-existing-csr","Issue from an existing CSR",{"_3550":2066,"_30605":2061,"_5":30940,"_21201":56376,"_27821":56377,"_3006":56378},[],"/docs/platform/pki/certificates#revoke-a-certificate","Revoke a certificate",{"_3550":2067,"_30605":2061,"_5":30940,"_21201":56380,"_27821":56381,"_3006":56382},[],"/docs/platform/pki/certificates#open-the-action","Open the action",{"_3550":2068,"_30605":2061,"_5":30940,"_21201":56384,"_27821":56385,"_3006":56386},[],"/docs/platform/pki/certificates#choose-a-reason","Choose a reason",{"_3550":2069,"_30605":2061,"_5":30940,"_21201":56388,"_27821":56389,"_3006":56390},[],"/docs/platform/pki/certificates#confirm-and-verify","Confirm and verify",{"_3550":2070,"_30605":2061,"_5":30940,"_21201":56392,"_27821":56393,"_3006":56394},[],"/docs/platform/pki/certificates#reactivate-a-hold","Reactivate a hold",{"_3550":2071,"_30605":2061,"_5":30940,"_21201":56396,"_27821":56397,"_3006":56398},[],"/docs/platform/pki/certificates#continue","Continue",{"_3550":2072,"_30605":2061,"_21201":56400,"_5":14582,"_27821":2061,"_3006":56401},[],"This guide is for a PKI operator inspecting or retiring an issued identity. You need inventory access and, to change states, permissions on the certificate. Open **Certificates** for a global view or **Issued Certificates** within a CA to restrict it to that issuer.",{"_3550":2073,"_30605":2061,"_21201":56403,"_5":14582,"_27821":56365,"_3006":56404},[],"Filter by `Common Name`, serial, status and issuer. A certificate does not contain its private key, so the private-key surfaces answer which certificates have their key held in Lamassu’s KMS:",{"_3550":2074,"_30605":2061,"_21201":56406,"_5":14582,"_27821":56365,"_3006":56407},[],"The advanced **Private Key** filter, available on the Certificates page and on a CA’s **Issued Certificates** tab, narrows the list to **All Certificates**, **With Private Key** or **Without Private Key**.",{"_3550":2075,"_30605":2061,"_21201":56409,"_5":14582,"_27821":56365,"_3006":56410},[],"The sortable **Private Key** column — shown by default, hidden on narrow screens — marks a key held in the KMS with a green check mark and otherwise shows `-`.",{"_3550":2076,"_30605":2061,"_21201":56412,"_5":14582,"_27821":56365,"_3006":56413},[],"In certificate details, the **Information** tab shows a **Private Key** row in the **Key & Signature** section. When the certificate reports a private key and its KMS engine and key IDs are available, the row links to the key (tooltip: **Open private key in KMS**). Otherwise, it shows **Present** if the certificate reports a private key, or **Not available** if it does not. This does not establish whether a key exists outside Lamassu.",{"_3550":2077,"_30605":2061,"_21201":56415,"_5":14582,"_27821":56365,"_3006":56416},[],"Use **Quick Inspect** for a quick review or **View Details** for subject, SAN, usages, chain, dates and metadata.",{"_3550":2078,"_30605":2061,"_21201":56418,"_5":14582,"_27821":56365,"_3006":56419},[],"Certificate records expose `key_id` (the KMS key that holds the private key, empty when the KMS does not hold it) and `has_private_key` (derived at read time from the KMS). Certificate and CA listings accept a `has_private_key` filter, which is useful, for example, to check the result of the CA-to-KMS migration of the 4.0.0 upgrade.",{"_3550":2079,"_30605":2061,"_21201":56421,"_5":14582,"_27821":56365,"_3006":56422},[],"Identify a certificate by issuer and serial; a name can correspond to several renewals. Check which certificate the consumer actually uses and which occupies the device’s active identity. Identity history and the certificate inventory answer different questions.",{"_3550":2080,"_30605":2061,"_21201":56424,"_5":14582,"_27821":56369,"_3006":56425},[],"Download the PEM and inspect it:",{"_3550":2081,"_30605":2061,"_21201":56427,"_5":14582,"_27821":56369,"_3006":56428},[],"Check issuance policy, chain and usages with the verification walkthrough. A certificate does not contain its private key. For an external CSR, the key remains where it was generated; for the browser flow, retain the file downloaded upon issuance. If the key is lost, plan a new identity rather than expecting recovery from the certificate.",{"_3550":2082,"_30605":2061,"_21201":56430,"_5":14582,"_27821":56373,"_3006":56431},[],"Use this flow when the identity’s key must remain on the system that generated it. You need an active CA with a usable key, a PEM CSR and a suitable profile.",{"_3550":2083,"_30605":2061,"_21201":56433,"_5":14582,"_27821":56373,"_3006":56434},[],"Verify the request with `openssl req -in request.csr -noout -verify -text`. Review subject, SAN and algorithm, and authorize the requested identity.",{"_3550":2084,"_30605":2061,"_21201":56436,"_5":14582,"_27821":56373,"_3006":56437},[],"Start issuance from the CA or inventory and select **Upload Existing CSR**.",{"_3550":2085,"_30605":2061,"_21201":56439,"_5":14582,"_27821":56373,"_3006":56440},[],"Confirm the CA and profile resolved according to Profiles; the request does not guarantee that every field is retained.",{"_3550":2086,"_30605":2061,"_21201":56442,"_5":14582,"_27821":56373,"_3006":56443},[],"Download the certificate and inspect dates, issuer, subject, SAN, KU and EKU. Check correspondence with the private key on the originating system.",{"_3550":2087,"_30605":2061,"_21201":56445,"_5":14582,"_27821":56373,"_3006":56446},[],"Install certificate and chain in the intended consumer and test a connection. Issuance alone does not register a device or grant access in an integration.",{"_3550":2088,"_30605":2061,"_21201":56448,"_5":14582,"_27821":56373,"_3006":56449},[],"For browser key generation, follow Issue your first certificate.",{"_3550":2089,"_30605":2061,"_21201":56451,"_5":14582,"_27821":56377,"_3006":56452},[],"Revoke when the key is compromised, the subject is no longer authorized or the identity must stop being accepted before expiration. Before changing status, identify consumers and prepare any required replacement.",{"_3550":2090,"_30605":2061,"_21201":56454,"_5":14582,"_27821":56381,"_3006":56455},[],"Locate the correct issuer and serial and select **Revoke Certificate**. `EXPIRED` records and records revoked for a final reason reject subsequent status changes.",{"_3550":2091,"_30605":2061,"_21201":56457,"_5":14582,"_27821":56385,"_3006":56458},[],"Select the incident reason. `CertificateHold` represents a reversible certificate suspension; other reasons block later changes. Do not use a suspension to address a compromised key.",{"_3550":2092,"_30605":2061,"_21201":56460,"_5":14582,"_27821":56389,"_3006":56461},[],"Save the change and read the record again: require **REVOKED**, reason and timestamp. Then verify a fresh OCSP query and, if using CRL, its published version and the serial’s presence. Finally check rejection of a new connection in the consumer.",{"_3550":2093,"_30605":2061,"_21201":56463,"_5":14582,"_27821":56389,"_3006":56464},[],"Revocation does not erase the certificate, delete the key or guarantee closure of existing sessions. Status and publication are separate steps.",{"_3550":2094,"_30605":2061,"_21201":56466,"_5":14582,"_27821":56389,"_3006":56467},[],"A certificate revoked with `CertificateHold` can be reactivated if it is not in `EXPIRED` state. Its dates and consumer trust remain mandatory.",{"_3550":2095,"_30605":2061,"_21201":56469,"_5":14582,"_27821":56393,"_3006":56470},[],"Check that the saved reason is `CertificateHold` and the identity still satisfies policy. Request `ACTIVE` through the status update operation exposed by your installation; consult the API reference. Do not assume changing consumer permissions also changes status in Lamassu.",{"_3550":2096,"_30605":2061,"_21201":56472,"_5":14582,"_27821":56393,"_3006":56473},[],"Read the record and query OCSP again. With `regenerate_on_revoke` enabled, the reactivation event requests CRL regeneration: check that the new list omits the serial. An earlier list can still mark it revoked until the client refreshes its copy.",{"_3550":2097,"_30605":2061,"_21201":56475,"_5":14582,"_27821":56393,"_3006":56476},[],"This does not undo permanent revocation or a cascade started by revoking a CA.",{"_3550":2098,"_30605":2061,"_21201":56478,"_5":14582,"_27821":56397,"_3006":56479},[],"<Card title=\"Validate with OCSP\" description=\"Query and verify a certificate’s signed status.\" href=\"/docs/platform/pki/ocsp\" />",{"_3550":2099,"_30605":2061,"_21201":56481,"_5":14582,"_27821":56397,"_3006":56482},[],"<Card title=\"Distribute a CRL\" description=\"Publish status for local validation.\" href=\"/docs/platform/pki/crl\" />",{"_3550":2100,"_30605":2100,"_5":14934,"_3006":56484,"_30943":56485,"_21201":56487,"_27821":2100},"Certificate lifecycle",[49963,51438,55589,56486],"Concepts",[],{"_3550":2101,"_30605":2100,"_21201":56489,"_5":14582,"_27821":2100,"_3006":56490},[],"Issuance, use, renewal, revocation and retirement of certificates in Lamassu.",{"_3550":2102,"_30605":2100,"_5":30940,"_21201":56492,"_27821":56493,"_3006":56494},[],"/docs/platform/pki/concepts/certificate-lifecycle#the-full-journey","The full journey",{"_3550":2103,"_30605":2100,"_5":30940,"_21201":56496,"_27821":56497,"_3006":56498},[],"/docs/platform/pki/concepts/certificate-lifecycle#request","Request",{"_3550":2104,"_30605":2100,"_5":30940,"_21201":56500,"_27821":56501,"_3006":56502},[],"/docs/platform/pki/concepts/certificate-lifecycle#issuance","Issuance",{"_3550":2105,"_30605":2100,"_5":30940,"_21201":56504,"_27821":56505,"_3006":56506},[],"/docs/platform/pki/concepts/certificate-lifecycle#use-and-monitoring","Use and monitoring",{"_3550":2106,"_30605":2100,"_5":30940,"_21201":56508,"_27821":56509,"_3006":56510},[],"/docs/platform/pki/concepts/certificate-lifecycle#renewal-or-re-enrollment","Renewal or re-enrollment",{"_3550":2107,"_30605":2100,"_5":30940,"_21201":56512,"_27821":56513,"_3006":56514},[],"/docs/platform/pki/concepts/certificate-lifecycle#revocation-or-retirement","Revocation or retirement",{"_3550":2108,"_30605":2100,"_5":30940,"_21201":56516,"_27821":56517,"_3006":56518},[],"/docs/platform/pki/concepts/certificate-lifecycle#certificate-states","Certificate states",{"_3550":2109,"_30605":2100,"_5":30940,"_21201":56520,"_27821":56521,"_3006":56522},[],"/docs/platform/pki/concepts/certificate-lifecycle#renewal-and-revocation-are-not-equivalent","Renewal and revocation are not equivalent",{"_3550":2110,"_30605":2100,"_5":30940,"_21201":56524,"_27821":56525,"_3006":56526},[],"/docs/platform/pki/concepts/certificate-lifecycle#effect-of-revoking-a-ca","Effect of revoking a CA",{"_3550":2111,"_30605":2100,"_5":30940,"_21201":56528,"_27821":56529,"_3006":56530},[],"/docs/platform/pki/concepts/certificate-lifecycle#what-you-should-watch","What you should watch",{"_3550":2112,"_30605":2100,"_21201":56532,"_5":14582,"_27821":2100,"_3006":56533},[],"Issuing a certificate is only the beginning. During its useful life you must check its validity, renew it before it expires and retire it when it stops being trustworthy. Lamassu keeps the certificate, its issuing CA, its status and, when it belongs to a device, the identity it is linked to.",{"_3550":2113,"_30605":2100,"_21201":56535,"_5":14582,"_27821":56497,"_3006":56536},[],"The requester generates a key and a CSR. In the recommended flows, the private key stays in the device, browser or cryptographic engine that created it.",{"_3550":2114,"_30605":2100,"_21201":56538,"_5":14582,"_27821":56501,"_3006":56539},[],"The CA signs the CSR. The issuance profile determines the validity, uses, subject, allowed extensions and cryptographic constraints.",{"_3550":2115,"_30605":2100,"_21201":56541,"_5":14582,"_27821":56505,"_3006":56542},[],"The certificate enters the `ACTIVE` state. Lamassu monitors its `Not After` date; the cryptographic monitoring job marks certificates that have expired as `EXPIRED`.",{"_3550":2116,"_30605":2100,"_21201":56544,"_5":14582,"_27821":56509,"_3006":56545},[],"A new certificate is issued before the previous one expires. In a DMS you can open preventive and critical windows so the device re-enrolls through EST.",{"_3550":2117,"_30605":2100,"_21201":56547,"_5":14582,"_27821":56513,"_3006":56548},[],"If the identity stops being trustworthy, Lamassu records the reason and time of revocation. OCSP and CRLs let consumers learn that status.",{"_3550":2118,"_30605":2100,"_21201":56550,"_5":14582,"_27821":56517,"_3006":56551},[],"Lamassu persists four X.509 states:",{"_3550":2119,"_30605":2100,"_21201":56553,"_5":14582,"_27821":56517,"_3006":56554},[],"**`ACTIVE`**: the record is enabled. Also check `Not Before` and `Not After`: this state does not establish time validity.",{"_3550":2120,"_30605":2100,"_21201":56556,"_5":14582,"_27821":56517,"_3006":56557},[],"**`EXPIRED`**: it has passed its expiration date. The monitor detects this periodically; it is not a state that should be assigned manually.",{"_3550":2121,"_30605":2100,"_21201":56559,"_5":14582,"_27821":56517,"_3006":56560},[],"**`REVOKED`**: it was invalidated before expiring, with a reason and a timestamp.",{"_3550":2122,"_30605":2100,"_21201":56562,"_5":14582,"_27821":56517,"_3006":56563},[],"**`INACTIVE`**: it is disabled without representing a definitive revocation.",{"_3550":2123,"_30605":2100,"_21201":56565,"_5":14582,"_27821":56517,"_3006":56566},[],"The device view may add operational states such as missing identity, pending renewal, expiring soon or decommissioned. These are an interpretation of the device's status and its certificates, not new X.509 states.",{"_3550":2124,"_30605":2100,"_21201":56568,"_5":14582,"_27821":56521,"_3006":56569},[],"**Renewal** creates a successor certificate for an identity that remains valid. **Revocation** communicates that the current certificate must no longer be accepted. Renew to maintain continuity; revoke in response to compromise, retirement or a change that invalidates the identity.",{"_3550":2125,"_30605":2100,"_21201":56571,"_5":14582,"_27821":56521,"_3006":56572},[],"Only `CertificateHold` allows reactivating a revoked certificate that is not in `EXPIRED` state. Revocation for another reason blocks subsequent status changes. `EXPIRED` records also reject changes; the consumer must check dates even before the monitor updates the state. Certificates explains how to verify revocation and reactivation.",{"_3550":2126,"_30605":2100,"_21201":56574,"_5":14582,"_27821":56521,"_3006":56575},[],"The **Reissue CA** operation generates another certificate for the same key and links both serial numbers through metadata. It is not a key rotation. To change the key, create a successor CA and perform a migration with an overlapping period.",{"_3550":2127,"_30605":2100,"_21201":56577,"_5":14582,"_27821":56525,"_3006":56578},[],"Revoking a CA starts a cascade that attempts to revoke descendants with `CessationOfOperation`. It may end with partial failures and is not undone by reactivating the parent. Read Hierarchy and rotation for conditions and checks.",{"_3550":2128,"_30605":2100,"_21201":56580,"_5":14582,"_27821":56525,"_3006":56581},[],"Before confirming:",{"_3550":2129,"_30605":2100,"_21201":56583,"_5":14582,"_27821":56525,"_3006":56584},[],"Identify DMSs, devices and services that trust that chain.",{"_3550":2130,"_30605":2100,"_21201":56586,"_5":14582,"_27821":56525,"_3006":56587},[],"Distribute the new chain of trust.",{"_3550":2131,"_30605":2100,"_21201":56589,"_5":14582,"_27821":56525,"_3006":56590},[],"Reissue the necessary identities.",{"_3550":2132,"_30605":2100,"_21201":56592,"_5":14582,"_27821":56525,"_3006":56593},[],"Check OCSP and CRL from a real consumer.",{"_3550":2133,"_30605":2100,"_21201":56595,"_5":14582,"_27821":56525,"_3006":56596},[],"Revoke the old CA once no legitimate traffic remains.",{"_3550":2134,"_30605":2100,"_21201":56598,"_5":14582,"_27821":56525,"_3006":56599},[],"Device retirement belongs to the IoT Fleets lifecycle. It affects the active identity; it does not automatically traverse and revoke every historical certificate. Review previous identities and consumer permissions separately in Device management.",{"_3550":2135,"_30605":2100,"_21201":56601,"_5":14582,"_27821":56529,"_3006":56602},[],"Certificates entering the preventive or critical renewal window.",{"_3550":2136,"_30605":2100,"_21201":56604,"_5":14582,"_27821":56529,"_3006":56605},[],"Repeated enrollment or re-enrollment failures.",{"_3550":2137,"_30605":2100,"_21201":56607,"_5":14582,"_27821":56529,"_3006":56608},[],"Status changes and revocation reasons.",{"_3550":2138,"_30605":2100,"_21201":56610,"_5":14582,"_27821":56529,"_3006":56611},[],"OCSP and CRL publication and validity.",{"_3550":2139,"_30605":2100,"_21201":56613,"_5":14582,"_27821":56529,"_3006":56614},[],"Dependencies still presenting a replaced certificate.",{"_3550":2140,"_30605":2100,"_21201":56616,"_5":14582,"_27821":56529,"_3006":56617},[],"The device history relates its previous and current identities. For administrative changes and mutation errors, see Audit logs.",{"_3550":2141,"_30605":2141,"_5":14934,"_3006":56619,"_30943":56620,"_21201":56621,"_27821":2141},"Trust model",[49963,51438,55589,56486],[],{"_3550":2142,"_30605":2141,"_21201":56623,"_5":14582,"_27821":2141,"_3006":56624},[],"Understand where trust originates, how it is distributed and what each component validates.",{"_3550":2143,"_30605":2141,"_5":30940,"_21201":56626,"_27821":56627,"_3006":56628},[],"/docs/platform/pki/concepts/trust-model#the-four-trust-decisions","The four trust decisions",{"_3550":2144,"_30605":2141,"_5":30940,"_21201":56630,"_27821":56631,"_3006":56632},[],"/docs/platform/pki/concepts/trust-model#who-can-issue","Who can issue",{"_3550":2145,"_30605":2141,"_5":30940,"_21201":56634,"_27821":56635,"_3006":56636},[],"/docs/platform/pki/concepts/trust-model#what-can-be-issued","What can be issued",{"_3550":2146,"_30605":2141,"_5":30940,"_21201":56638,"_27821":56639,"_3006":56640},[],"/docs/platform/pki/concepts/trust-model#who-can-request-it","Who can request it",{"_3550":2147,"_30605":2141,"_5":30940,"_21201":56642,"_27821":56643,"_3006":56644},[],"/docs/platform/pki/concepts/trust-model#who-accepts-the-result","Who accepts the result",{"_3550":2148,"_30605":2141,"_5":30940,"_21201":56646,"_27821":56647,"_3006":56648},[],"/docs/platform/pki/concepts/trust-model#identity-flow","Identity flow",{"_3550":2149,"_30605":2141,"_5":30940,"_21201":56650,"_27821":56651,"_3006":56652},[],"/docs/platform/pki/concepts/trust-model#enrollment-validation-and-distribution-cas","Enrollment, validation and distribution CAs",{"_3550":2150,"_30605":2141,"_5":30940,"_21201":56654,"_27821":56655,"_3006":56656},[],"/docs/platform/pki/concepts/trust-model#validation-and-revocation","Validation and revocation",{"_3550":2151,"_30605":2141,"_5":30940,"_21201":56658,"_27821":56659,"_3006":56660},[],"/docs/platform/pki/concepts/trust-model#custody-limits","Custody limits",{"_3550":2152,"_30605":2141,"_5":30940,"_21201":56662,"_27821":56663,"_3006":56664},[],"/docs/platform/pki/concepts/trust-model#recommended-pattern","Recommended pattern",{"_3550":2153,"_30605":2141,"_21201":56666,"_5":14582,"_27821":2141,"_3006":56667},[],"In Lamassu, trust does not simply mean that a certificate exists in the inventory. A consumer trusts an identity when it can build a chain to a root it recognizes, check that the certificate is fit for the intended use and verify that it is still valid.",{"_3550":2154,"_30605":2141,"_21201":56669,"_5":14582,"_27821":56631,"_3006":56670},[],"The CA hierarchy defines which authorities can sign. A root CA establishes the anchor of trust; intermediate CAs separate operating domains and avoid using the root for every issuance.",{"_3550":2155,"_30605":2141,"_21201":56672,"_5":14582,"_27821":56635,"_3006":56673},[],"Certificate profiles limit validity, subject, uses, extensions and cryptographic parameters. Possessing a CA does not replace an issuance policy.",{"_3550":2156,"_30605":2141,"_21201":56675,"_5":14582,"_27821":56639,"_3006":56676},[],"The DMS acts as the enrollment point. It can authenticate an EST request with a client certificate, an external webhook or a combination of both. CAs configured to validate the requester do not have to be the CA that will issue the new identity.",{"_3550":2157,"_30605":2141,"_21201":56678,"_5":14582,"_27821":56643,"_3006":56679},[],"The consumer keeps its own trust store. EST `/cacerts` can distribute the service TLS certificate, the enrollment CA and selected managed CAs. Initial trust for authenticating that service must come from an already trusted channel. Download and inspect the contents: do not assume they form a complete chain or install every entry as a root.",{"_3550":2158,"_30605":2141,"_21201":56681,"_5":14582,"_27821":56647,"_3006":56682},[],"The device proves it can enroll according to the DMS policy.",{"_3550":2159,"_30605":2141,"_21201":56684,"_5":14582,"_27821":56647,"_3006":56685},[],"The DMS validates the request and forwards the CSR to the enrollment CA.",{"_3550":2160,"_30605":2141,"_21201":56687,"_5":14582,"_27821":56647,"_3006":56688},[],"In the device-generated CSR flow, the CA applies the profile and signs without receiving the device’s private key.",{"_3550":2161,"_30605":2141,"_21201":56690,"_5":14582,"_27821":56647,"_3006":56691},[],"The device installs the certificate and the chain it needs.",{"_3550":2162,"_30605":2141,"_21201":56693,"_5":14582,"_27821":56647,"_3006":56694},[],"The system that trusts the device validates the chain, dates, uses and revocation status.",{"_3550":2163,"_30605":2141,"_21201":56696,"_5":14582,"_27821":56647,"_3006":56697},[],"OIDC or X.509 identifies the operator calling Lamassu. The authorization service decides which actions it may perform. The X.509 hierarchy, on the other hand, determines whether a certificate presented by a device is trustworthy.",{"_3550":2164,"_30605":2141,"_21201":56699,"_5":14582,"_27821":56651,"_3006":56700},[],"A DMS relates three sets that are worth designing separately:",{"_3550":2165,"_30605":2141,"_21201":56702,"_5":14582,"_27821":56651,"_3006":56703},[],"**Enrollment CA:** signs the new identities.",{"_3550":2166,"_30605":2141,"_21201":56705,"_5":14582,"_27821":56651,"_3006":56706},[],"**Validation CAs:** authenticate the client certificates used for enrollment or migration. During re-enrollment, the enrollment CA is always trusted and Lamassu then tries the validation CAs configured in the re-enrollment block; those are optional.",{"_3550":2167,"_30605":2141,"_21201":56708,"_5":14582,"_27821":56651,"_3006":56709},[],"**Distributed CAs:** form the content the device obtains through EST `/cacerts`. You can include the service TLS certificate, the enrollment CA and an explicit list of managed CAs. Including the issuer does not automatically add all its ancestors.",{"_3550":2168,"_30605":2141,"_21201":56711,"_5":14582,"_27821":56651,"_3006":56712},[],"This separation makes it possible to migrate a fleet: you temporarily accept certificates from the old hierarchy, issue with the new one and distribute both chains during the overlap.",{"_3550":2169,"_30605":2141,"_21201":56714,"_5":14582,"_27821":56655,"_3006":56715},[],"A valid chain does not by itself guarantee that a certificate should be accepted. The consumer must also check:",{"_3550":2170,"_30605":2141,"_21201":56717,"_5":14582,"_27821":56655,"_3006":56718},[],"that the current date is between `Not Before` and `Not After`;",{"_3550":2171,"_30605":2141,"_21201":56720,"_5":14582,"_27821":56655,"_3006":56721},[],"that `Key Usage` and `Extended Key Usage` allow the operation;",{"_3550":2172,"_30605":2141,"_21201":56723,"_5":14582,"_27821":56655,"_3006":56724},[],"that names, SANs and subject match the expected identity;",{"_3550":2173,"_30605":2141,"_21201":56726,"_5":14582,"_27821":56655,"_3006":56727},[],"that the certificate does not appear revoked in OCSP or a CRL.",{"_3550":2174,"_30605":2141,"_21201":56729,"_5":14582,"_27821":56655,"_3006":56730},[],"An OCSP `Good` status does not replace chain, date, usage and identity checks either; Validation brings those criteria together.",{"_3550":2175,"_30605":2141,"_21201":56732,"_5":14582,"_27821":56655,"_3006":56733},[],"During the mTLS authentication of a DMS, Lamassu attempts to check revocation. If the certificate does not contain enough information to perform that check, the backend logs a warning and continues treating it as not revoked. Design your profiles and distribution points to avoid that situation in production.",{"_3550":2176,"_30605":2141,"_21201":56735,"_5":14582,"_27821":56659,"_3006":56736},[],"The KMS keeps the reference to the key and delegates the operation to the configured engine. With an HSM or a cloud KMS, the private key can remain non-exportable. That protects custody, but it does not by itself prevent misuse: you still must restrict who can request a signature and audit those operations.",{"_3550":2177,"_30605":2141,"_21201":56738,"_5":14582,"_27821":56663,"_3006":56739},[],"Keep the root out of daily operations, or with very restricted access.",{"_3550":2178,"_30605":2141,"_21201":56741,"_5":14582,"_27821":56663,"_3006":56742},[],"Issue from intermediate CAs separated by environment or risk domain.",{"_3550":2179,"_30605":2141,"_21201":56744,"_5":14582,"_27821":56663,"_3006":56745},[],"Assign explicit profiles to every use case.",{"_3550":2180,"_30605":2141,"_21201":56747,"_5":14582,"_27821":56663,"_3006":56748},[],"Distribute the new trust before starting a rotation.",{"_3550":2181,"_30605":2141,"_21201":56750,"_5":14582,"_27821":56663,"_3006":56751},[],"Keep enough overlap to renew a disconnected fleet.",{"_3550":2182,"_30605":2141,"_21201":56753,"_5":14582,"_27821":56663,"_3006":56754},[],"Validate from the consuming system, not only from the Lamassu console.",{"_3550":2183,"_30605":2141,"_21201":56756,"_5":14582,"_27821":56663,"_3006":56757},[],"Continue with CA hierarchy and rotation to turn this model into an operating procedure.",{"_3550":2184,"_30605":2184,"_5":14934,"_3006":56759,"_30943":56760,"_21201":56761,"_27821":2184},"Revocation lists (CRL)",[49963,51438,55589,56231],[],{"_3550":2185,"_30605":2184,"_21201":56763,"_5":14582,"_27821":2184,"_3006":56764},[],"Generate and distribute signed lists to validate certificates offline.",{"_3550":2186,"_30605":2184,"_5":30940,"_21201":56766,"_27821":56767,"_3006":56768},[],"/docs/platform/pki/crl#crl-settings","CRL settings",{"_3550":2187,"_30605":2184,"_5":30940,"_21201":56770,"_27821":56771,"_3006":56772},[],"/docs/platform/pki/crl#cas-that-share-a-key","CAs that share a key",{"_3550":2188,"_30605":2184,"_5":30940,"_21201":56774,"_27821":56775,"_3006":56776},[],"/docs/platform/pki/crl#periodic-and-automatic-regeneration","Periodic and automatic regeneration",{"_3550":2189,"_30605":2184,"_5":30940,"_21201":56778,"_27821":56779,"_3006":56780},[],"/docs/platform/pki/crl#crl-contents","CRL contents",{"_3550":2190,"_30605":2184,"_5":30940,"_21201":56782,"_27821":56783,"_3006":56784},[],"/docs/platform/pki/crl#public-download-endpoint","Public download endpoint",{"_3550":2191,"_30605":2184,"_5":30940,"_21201":56786,"_27821":56787,"_3006":56788},[],"/docs/platform/pki/crl#crl-settings-api","CRL settings API",{"_3550":2192,"_30605":2184,"_5":30940,"_21201":56790,"_27821":56791,"_3006":56792},[],"/docs/platform/pki/crl#common-crl-settings-errors","Common CRL settings errors",{"_3550":2193,"_30605":2184,"_5":30940,"_21201":56794,"_27821":56795,"_3006":56796},[],"/docs/platform/pki/crl#references","References",{"_3550":2194,"_30605":2184,"_21201":56798,"_5":14582,"_27821":2184,"_3006":56799},[],"A CRL is an issuer-signed list of revoked certificates. This guide is for an operator publishing lists and an integrator using them locally. You need the issuing CA certificate, its CA ID and access to the published endpoint. The client must maintain a current copy: offline operation still requires refreshing evidence.",{"_3550":2195,"_30605":2184,"_21201":56801,"_5":14582,"_27821":56767,"_3006":56802},[],"The CRL settings of a CA store the configuration and metadata of its latest published list. Each CA has its own settings, keyed by its CA ID — even when two CAs share a key: they share the SKI, not the CRL. Generation requires a usable issuer key; do not assume an imported CA without a key has an available CRL.",{"_3550":2196,"_30605":2184,"_21201":56804,"_5":14582,"_27821":56767,"_3006":56805},[],"Field",{"_3550":2197,"_30605":2184,"_21201":56807,"_5":14582,"_27821":56767,"_3006":50353},[],{"_3550":2198,"_30605":2184,"_21201":56809,"_5":14582,"_27821":56767,"_3006":51558},[],{"_3550":2199,"_30605":2184,"_21201":56811,"_5":14582,"_27821":56767,"_3006":56812},[],"ID of the CA the settings belong to.",{"_3550":2200,"_30605":2184,"_21201":56814,"_5":14582,"_27821":56767,"_3006":56815},[],"`status`",{"_3550":2201,"_30605":2184,"_21201":56817,"_5":14582,"_27821":56767,"_3006":56818},[],"Lifecycle of the settings. `ACTIVE` ones generate CRLs. `FINAL` ones belong to a CA revoked permanently or expired: the first publishes one final CRL, valid until the CA's current certificate expires, and the second is turned `FINAL` without one. `ARCHIVED` ones belong to a deleted CA: their last CRL is still served, but never regenerated.",{"_3550":2202,"_30605":2184,"_21201":56820,"_5":14582,"_27821":56767,"_3006":56821},[],"`legacy_ski`",{"_3550":2203,"_30605":2184,"_21201":56823,"_5":14582,"_27821":56767,"_3006":56824},[],"Read-only. SKI the settings were keyed by before the 4.0.0 migration; only migrated settings have it, and `/crl/<ski>` keeps resolving to them.",{"_3550":2204,"_30605":2184,"_21201":56826,"_5":14582,"_27821":56767,"_3006":56827},[],"`latest_crl`",{"_3550":2205,"_30605":2184,"_21201":56829,"_5":14582,"_27821":56767,"_3006":56830},[],"Version, validity start and end of the last published list. Read-only.",{"_3550":2206,"_30605":2184,"_21201":56832,"_5":14582,"_27821":56767,"_3006":56833},[],"`crl_options` field",{"_3550":2207,"_30605":2184,"_21201":56835,"_5":14582,"_27821":56767,"_3006":50353},[],{"_3550":2208,"_30605":2184,"_21201":56837,"_5":14582,"_27821":56767,"_3006":56838},[],"Initial value",{"_3550":2209,"_30605":2184,"_21201":56840,"_5":14582,"_27821":56767,"_3006":56841},[],"`validity`",{"_3550":2210,"_30605":2184,"_21201":56843,"_5":14582,"_27821":56767,"_3006":56844},[],"Time from `thisUpdate` to `nextUpdate`.",{"_3550":2211,"_30605":2184,"_21201":56846,"_5":14582,"_27821":56767,"_3006":56847},[],"7 days.",{"_3550":2212,"_30605":2184,"_21201":56849,"_5":14582,"_27821":56767,"_3006":56850},[],"`refresh_interval`",{"_3550":2213,"_30605":2184,"_21201":56852,"_5":14582,"_27821":56767,"_3006":56853},[],"Time since the issuance of the latest published CRL that triggers scheduled renewal; `0` disables only this trigger. The effective granularity is bounded by the job frequency (see Periodic and automatic regeneration).",{"_3550":2214,"_30605":2184,"_21201":56855,"_5":14582,"_27821":56767,"_3006":56856},[],"6 days and 23 hours.",{"_3550":2215,"_30605":2184,"_21201":56858,"_5":14582,"_27821":56767,"_3006":56859},[],"`regenerate_on_revoke`",{"_3550":2216,"_30605":2184,"_21201":56861,"_5":14582,"_27821":56767,"_3006":56862},[],"Request regeneration on revocation or reactivation from `CertificateHold` events.",{"_3550":2217,"_30605":2184,"_21201":56864,"_5":14582,"_27821":56767,"_3006":56865},[],"`true`.",{"_3550":2218,"_30605":2184,"_21201":56867,"_5":14582,"_27821":56767,"_3006":56868},[],"`signer_serial_number`",{"_3550":2219,"_30605":2184,"_21201":56870,"_5":14582,"_27821":56767,"_3006":56871},[],"Serial number of the existing certificate that signs the CRL.",{"_3550":2220,"_30605":2184,"_21201":56873,"_5":14582,"_27821":56767,"_3006":56874},[],"Serial number of the CA’s current certificate.",{"_3550":2221,"_30605":2184,"_21201":56876,"_5":14582,"_27821":56767,"_3006":56877},[],"The signer must be an existing certificate with the `cRLSign` key usage and the same subject and public key as the CA. Certificates from before a reissue qualify. A delegated signer is not supported: a certificate with the CA’s subject but a different key is rejected.",{"_3550":2222,"_30605":2184,"_21201":56879,"_5":14582,"_27821":56767,"_3006":56880},[],"When a CA is reissued and the signer is the superseded CA certificate, the VA moves the signer to the new certificate — provided it carries `cRLSign` — and republishes the CRL. If the new certificate lacks `cRLSign`, the VA keeps the previous signer and logs a warning. If the signer is any other certificate with the CA’s subject and key, it is deliberately left unchanged; the previous certificate then cannot be deleted while the settings use it (the API returns `409` `certificate is in use`), and to retire it you update the signer with `PUT`.",{"_3550":2223,"_30605":2184,"_21201":56882,"_5":14582,"_27821":56767,"_3006":56883},[],"The CRL lifecycle decisions — when publication stops and when the final CRL expires — use only the CA's current certificate. If a reissued certificate expires earlier than an older certificate that is still valid, CRL publication can stop, or the final CRL can expire, while the older certificate is still valid. This is an accepted limitation of the current behavior.",{"_3550":2224,"_30605":2184,"_21201":56885,"_5":14582,"_27821":56767,"_3006":56886},[],"A CA whose signer lacks `cRLSign` cannot generate its CRL, and an update that selects a signer without `cRLSign` is rejected (400 error). Since 4.0 the VA requires this usage. Check before importing with `openssl x509 -noout -ext keyUsage` and, if it is missing, obtain a certificate for the same CA and key that includes it and update the settings to use it as the signer. After reissuing a CA, also check the key usage of the new certificate: it may not keep the original’s usages, and without `cRLSign` the settings keep their previous signer.",{"_3550":2225,"_30605":2184,"_21201":56888,"_5":14582,"_27821":56767,"_3006":56889},[],"Deleting a CA keeps its CRL settings; they remain until you delete the archived ones through the API or from the console's Verification Authorities page (see CRL settings API). What happens to them depends on how the CA ended:",{"_3550":2226,"_30605":2184,"_21201":56891,"_5":14582,"_27821":56767,"_3006":56892},[],"The 4.0.0 upgrade migration archives the settings of the CAs that had been deleted before the upgrade. Their `status` is `ARCHIVED` and their `ca_id` is `legacy-<ski>`: the last CRL keeps being served, but it is never regenerated, any `PUT` returns 409, and there is no API way back to `ACTIVE`.",{"_3550":2227,"_30605":2184,"_21201":56894,"_5":14582,"_27821":56767,"_3006":56895},[],"Revoking a CA permanently or letting it expire finalizes its settings: their `status` becomes `FINAL`, any `PUT` returns 409, and no new CRL is generated. A permanently revoked CA publishes one final CRL, valid until the CA's current certificate expires; an expired CA gets none. Deleting the CA afterwards archives its settings, which then behave like the archived ones of the migration.",{"_3550":2228,"_30605":2184,"_21201":56897,"_5":14582,"_27821":56767,"_3006":56898},[],"The settings can no longer be edited while their `status` is not `ACTIVE`. Adjust validity and signer before revoking or deleting a CA.",{"_3550":2229,"_30605":2184,"_21201":56900,"_5":14582,"_27821":56767,"_3006":56901},[],"`PUT` validates the signer only when the request changes it. If the stored signer is no longer valid, the other options can still be edited, but the CRL cannot be regenerated until a valid signer is set.",{"_3550":2230,"_30605":2184,"_21201":56903,"_5":14582,"_27821":56767,"_3006":56904},[],"Sharing a key between CAs is a migration blocker: the 4.0.0 upgrade aborts while an SKI belongs to more than one CA. See CAs that share a key.",{"_3550":2231,"_30605":2184,"_21201":56906,"_5":14582,"_27821":56767,"_3006":56907},[],"CRL versions are kept as PEM in object storage at `pki/va/crl/<ca-id>/<version>.crl`; the public endpoint returns DER. CRLs published before the 4.0.0 upgrade remain at `pki/va/crl/<ski>/<version>.crl` and keep being served.",{"_3550":2232,"_30605":2184,"_21201":56909,"_5":14582,"_27821":56771,"_3006":56910},[],"Since 4.0.0, each CA publishes its own CRL even when its key is shared: two CAs with the same key have the same SKI, but each has its own CRL settings and its own list, signed by a certificate with that CA’s identity.",{"_3550":2233,"_30605":2184,"_21201":56912,"_5":14582,"_27821":56771,"_3006":56913},[],"Certificates issued from now on carry `/crl/<ca-id>` distribution points, so each CA’s certificates resolve to its own list. Certificates issued before the upgrade keep their `/crl/<ski>` distribution points: that URL keeps resolving to the settings the upgrade migrated, and always serves the list of the CA that owned that SKI when the upgrade ran. It is never rebound to a CA created later with the same key. After regeneration, the migrated list includes both URLs in its *Issuing Distribution Point* (OID `2.5.29.28`), so a verifier that compares the IDP with the CDP of the certificate accepts either form. Until the VA scheduled CRL job successfully regenerates it, the pre-upgrade list contains only the legacy `/crl/<ski>` IDP; IDP-checking verifiers cannot validate newly issued certificates with `/crl/<ca-id>` CDPs. The first run can take up to about an hour with the default schedule, and failures can extend the window.",{"_3550":2234,"_30605":2184,"_21201":56915,"_5":14582,"_27821":56771,"_3006":56916},[],"Sharing an SKI between CAs blocks the upgrade: the migration aborts and names the SKIs. To detect the problem before upgrading, compare the SKI of the CAs in the inventory: two with the same SKI are affected. To fix it, create a CA with its own key and reissue its certificates; those already issued keep the old URL and are not corrected until reissued.",{"_3550":2235,"_30605":2184,"_21201":56918,"_5":14582,"_27821":56771,"_3006":56919},[],"Lamassu takes the SKI of an imported certificate as-is and does not check that it corresponds to its public key. Until Lamassu rejects imports whose SKI collides with an existing CA — proposed in lamassuiot#834, together with the per-CA CRL that 4.0.0 implements — restrict the permission to import CAs as an interim control; it covers only the import path. Creating a CA with &#x2A;*Create New CA (Existing Key)** on a KMS key another CA already uses produces the same SKI collision, so avoid reusing keys across CAs.",{"_3550":2236,"_30605":2184,"_21201":56921,"_5":14582,"_27821":56775,"_3006":56922},[],"The VA scheduled job checks the CRL settings of every CA on each run and requests a new list when either of these conditions is met:",{"_3550":2237,"_30605":2184,"_21201":56924,"_5":14582,"_27821":56775,"_3006":56925},[],"**The list is about to expire:** the remaining validity of `latest_crl` is less than the interval between job runs. This condition always applies and cannot be disabled.",{"_3550":2238,"_30605":2184,"_21201":56927,"_5":14582,"_27821":56775,"_3006":56928},[],"**The refresh interval has elapsed:** the time since the issuance of the latest published CRL reaches `refresh_interval`. Setting `refresh_interval` to `0` disables only this condition; the list is still regenerated when it is about to expire.",{"_3550":2239,"_30605":2184,"_21201":56930,"_5":14582,"_27821":56775,"_3006":56931},[],"Setting `refresh_interval` to `0` therefore does not freeze regeneration. With the default 7-day validity and an hourly job, a CRL is renewed up to an hour before it expires even if `refresh_interval` is `0`. Because the job runs on its own schedule, `refresh_interval` is honored only as precisely as the job frequency allows.",{"_3550":2240,"_30605":2184,"_21201":56933,"_5":14582,"_27821":56775,"_3006":56934},[],"The job frequency is set in Helm with `services.va.job.crl.frequency` (default `0 * * * *`) and accepts a duration (`1h`) or a cron expression. A cron expression is converted into a constant interval equal to the time left until its next firing when the service starts, so it is not aligned with the clock. Keep `validity` well above that interval: with a shorter validity, the list is regenerated on every cycle.",{"_3550":2241,"_30605":2184,"_21201":56936,"_5":14582,"_27821":56775,"_3006":56937},[],"If generation fails (for example, because the CA cannot be resolved or the signer is invalid), the job logs the warning `something went wrong while calculating CRL for CA <ca-id>` and retries on the next cycle. There is no other renewal path until the cause is fixed, and the last published list keeps being served until it expires. All of this depends on working jobs, storage and signing.",{"_3550":2242,"_30605":2184,"_21201":56939,"_5":14582,"_27821":56775,"_3006":56940},[],"Settings whose `status` is not `ACTIVE` — `FINAL` or `ARCHIVED` — are skipped: nothing regenerates their CRL.",{"_3550":2243,"_30605":2184,"_21201":56942,"_5":14582,"_27821":56775,"_3006":56943},[],"With `regenerate_on_revoke`, the event handler requests a new CRL upon revocation or reactivation from `CertificateHold` to `ACTIVE`. This happens after the status change and has its own failure paths: if generation fails (for example, because of an invalid signer), the event is retried and, once retries are exhausted, moves to the failed-events queue. If the issuing CA has no CRL settings, there is no CRL to regenerate: the event is acknowledged without retry, the VA logs a warning, and nothing appears in the failed-events queue. Confirming revocation does not establish that the new CRL is already published or that all clients have downloaded it.",{"_3550":2244,"_30605":2184,"_21201":56945,"_5":14582,"_27821":56775,"_3006":56946},[],"Compare CRL numbers and timestamps before and after a change. Monitor expired lists and generation failures; clients must apply policy when current evidence is unavailable.",{"_3550":2245,"_30605":2184,"_21201":56948,"_5":14582,"_27821":56779,"_3006":56949},[],"Each entry contains serial number, revocation time and reason. The generator queries certificates in `REVOKED` state for the selected CA. A reactivated certificate disappears when the list is recalculated; an earlier downloaded copy retains its contents.",{"_3550":2246,"_30605":2184,"_21201":56951,"_5":14582,"_27821":56779,"_3006":56952},[],"The list contains a critical *Issuing Distribution Point* (OID `2.5.29.28`) with configured distribution URLs. Check that your client interprets this extension and that it matches the list’s scope. If rejected, investigate format and scope; ignoring a critical extension is not successful validation.",{"_3550":2247,"_30605":2184,"_21201":56954,"_5":14582,"_27821":56783,"_3006":56955},[],"The VA service exposes `GET /crl/{id}` without management authorization. Use the **issuing CA’s** ID, not the end-entity certificate’s ID or serial. Certificates issued before the 4.0.0 upgrade carry `/crl/<ski>` URLs with the SKI of the CA key; that form keeps resolving. First inspect the certificate’s CDP:",{"_3550":2248,"_30605":2184,"_21201":56957,"_5":14582,"_27821":56783,"_3006":56958},[],"Replace the following URL with the CDP URL and review exposure in Deployment:",{"_3550":2249,"_30605":2184,"_21201":56960,"_5":14582,"_27821":56783,"_3006":56961},[],"You need OpenSSL 3.x and `issuer.pem` containing the direct issuer’s certificate. An accepted signer certificate has the same subject and public key as the CA, so this signature check also works when the settings point to an earlier certificate for that CA and key. Require a valid signature, current timestamps and the expected issuer. For a root that issues directly:",{"_3550":2250,"_30605":2184,"_21201":56963,"_5":14582,"_27821":56783,"_3006":56964},[],"`roots.pem` contains deliberately trusted roots. For intermediates, add `-untrusted intermediates.pem` before the `device.crt` argument. `-crl_check` checks the end-entity certificate’s revocation against the local list; it does not download other lists or establish the status of the whole chain. A complete chain check needs the corresponding CRLs and a policy requiring them.",{"_3550":2251,"_30605":2184,"_21201":56966,"_5":14582,"_27821":56783,"_3006":56967},[],"The test should accept an allowed certificate absent from the list and reject it with `certificate revoked` after publishing and using the list containing its serial.",{"_3550":2252,"_30605":2184,"_21201":56969,"_5":14582,"_27821":56787,"_3006":56970},[],"The following paths are relative to the VA service; confirm the public prefix in the Gateway. They are not the URLs of the public OCSP and CRL endpoints.",{"_3550":2253,"_30605":2184,"_21201":56972,"_5":14582,"_27821":56787,"_3006":53354},[],{"_3550":2254,"_30605":2184,"_21201":56974,"_5":14582,"_27821":56787,"_3006":56975},[],"Relative path",{"_3550":2255,"_30605":2184,"_21201":56977,"_5":14582,"_27821":56787,"_3006":53351},[],{"_3550":2256,"_30605":2184,"_21201":56979,"_5":14582,"_27821":56787,"_3006":56980},[],"`GET`",{"_3550":2257,"_30605":2184,"_21201":56982,"_5":14582,"_27821":56787,"_3006":56983},[],"`/v1/crl-settings`",{"_3550":2258,"_30605":2184,"_21201":56985,"_5":14582,"_27821":56787,"_3006":56986},[],"List the CRL settings; filterable at least by `ca_id`, `status` and `legacy_ski`.",{"_3550":2259,"_30605":2184,"_21201":56988,"_5":14582,"_27821":56787,"_3006":56980},[],{"_3550":2260,"_30605":2184,"_21201":56990,"_5":14582,"_27821":56787,"_3006":56991},[],"`/v1/crl-settings/{ca-id}`",{"_3550":2261,"_30605":2184,"_21201":56993,"_5":14582,"_27821":56787,"_3006":56994},[],"Read the `crl_options` and `latest_crl` of a CA.",{"_3550":2262,"_30605":2184,"_21201":56996,"_5":14582,"_27821":56787,"_3006":56997},[],"`PUT`",{"_3550":2263,"_30605":2184,"_21201":56999,"_5":14582,"_27821":56787,"_3006":56991},[],{"_3550":2264,"_30605":2184,"_21201":57001,"_5":14582,"_27821":56787,"_3006":57002},[],"Replace the CRL configuration of a CA.",{"_3550":2265,"_30605":2184,"_21201":57004,"_5":14582,"_27821":56787,"_3006":57005},[],"`DELETE`",{"_3550":2266,"_30605":2184,"_21201":57007,"_5":14582,"_27821":56787,"_3006":56991},[],{"_3550":2267,"_30605":2184,"_21201":57009,"_5":14582,"_27821":56787,"_3006":57010},[],"Remove the archived CRL settings of a CA.",{"_3550":2268,"_30605":2184,"_21201":57012,"_5":14582,"_27821":56787,"_3006":57013},[],"You need authentication and CRL settings read, update or delete permissions. Consult your installation’s API reference and Access control. Read current configuration before updating and send the full object expected by the contract — `refresh_interval`, `validity`, `signer_serial_number` and `regenerate_on_revoke`: the backend replaces all four; it does not merge omitted fields. `status`, `legacy_ski` and `latest_crl` are read-only. A `PUT` returns 409 when the settings are not `ACTIVE`, validates the signer only when it changes, and does not regenerate the CRL.",{"_3550":2269,"_30605":2184,"_21201":57015,"_5":14582,"_27821":56787,"_3006":57016},[],"Archived settings, whose CA no longer exists, can be removed with `DELETE`: the call returns 204 on success, 404 when the CA has no settings and 409 while the settings are not yet archived. After the deletion, the public `/crl/{id}` endpoint and any legacy `/crl/<ski>` endpoint stop serving the CA’s list, although the published CRL files remain in the bucket. Keep the archived settings while any certificate issued by the CA may still need revocation evidence: `DELETE` stops serving the list immediately, regardless of `latest_crl` validity. The action cannot be undone.",{"_3550":2270,"_30605":2184,"_21201":57018,"_5":14582,"_27821":56787,"_3006":57019},[],"After a change, check saved configuration and the next list actually published. Updating the settings alone does not establish regeneration or client acceptance.",{"_3550":2271,"_30605":2184,"_21201":57021,"_5":14582,"_27821":56791,"_3006":57022},[],"Symptom",{"_3550":2272,"_30605":2184,"_21201":57024,"_5":14582,"_27821":56791,"_3006":57025},[],"Cause",{"_3550":2273,"_30605":2184,"_21201":57027,"_5":14582,"_27821":56791,"_3006":57028},[],"Action",{"_3550":2274,"_30605":2184,"_21201":57030,"_5":14582,"_27821":56791,"_3006":57031},[],"`PUT /v1/crl-settings/{ca-id}` returns 409.",{"_3550":2275,"_30605":2184,"_21201":57033,"_5":14582,"_27821":56791,"_3006":57034},[],"The settings are not `ACTIVE`: revoking the CA permanently or letting it expire finalized them, or the migration archived them because their CA was deleted before the upgrade.",{"_3550":2276,"_30605":2184,"_21201":57036,"_5":14582,"_27821":56791,"_3006":57037},[],"There is no API way back to `ACTIVE`. The last CRL keeps being served.",{"_3550":2277,"_30605":2184,"_21201":57039,"_5":14582,"_27821":56791,"_3006":57040},[],"`DELETE /v1/crl-settings/{ca-id}` returns 409.",{"_3550":2278,"_30605":2184,"_21201":57042,"_5":14582,"_27821":56791,"_3006":57043},[],"The settings are not yet `ARCHIVED`: the CA has not been deleted.",{"_3550":2279,"_30605":2184,"_21201":57045,"_5":14582,"_27821":56791,"_3006":57046},[],"Delete the CA first; deleting it archives its settings.",{"_3550":2280,"_30605":2184,"_21201":57048,"_5":14582,"_27821":56791,"_3006":57049},[],"`PUT` returns 400.",{"_3550":2281,"_30605":2184,"_21201":57051,"_5":14582,"_27821":56791,"_3006":57052},[],"The new signer lacks `cRLSign`, or its subject and public key do not match the CA.",{"_3550":2282,"_30605":2184,"_21201":57054,"_5":14582,"_27821":56791,"_3006":57055},[],"Set the serial number of a valid certificate of that CA.",{"_3550":2283,"_30605":2184,"_21201":57057,"_5":14582,"_27821":56791,"_3006":57058},[],"`PUT` returns 404.",{"_3550":2284,"_30605":2184,"_21201":57060,"_5":14582,"_27821":56791,"_3006":57061},[],"The CA or the new signer certificate does not exist, or the CA has no CRL settings (for example, an imported CA).",{"_3550":2285,"_30605":2184,"_21201":57063,"_5":14582,"_27821":56791,"_3006":57064},[],"Check the CA ID and the signer serial number.",{"_3550":2286,"_30605":2184,"_21201":57066,"_5":14582,"_27821":56791,"_3006":57067},[],"`PUT` returns 400 from a 3.x client.",{"_3550":2287,"_30605":2184,"_21201":57069,"_5":14582,"_27821":56791,"_3006":57070},[],"`crl_options.subject_key_id_signer` was replaced by `crl_options.signer_serial_number`, which is required.",{"_3550":2288,"_30605":2184,"_21201":57072,"_5":14582,"_27821":56791,"_3006":57073},[],"Update the client to send the new field.",{"_3550":2289,"_30605":2184,"_21201":57075,"_5":14582,"_27821":56791,"_3006":57076},[],"The CRL does not change after revoking a certificate.",{"_3550":2290,"_30605":2184,"_21201":57078,"_5":14582,"_27821":56791,"_3006":57079},[],"`regenerate_on_revoke` is `false`, the issuing CA has no CRL settings, or generation failed because of an invalid signer.",{"_3550":2291,"_30605":2184,"_21201":57081,"_5":14582,"_27821":56791,"_3006":57082},[],"Check the VA logs. Missing settings only produce a warning (no retry, no failed-events entry); an invalid signer also leaves the event in the failed-events queue, so fix the signer.",{"_3550":2292,"_30605":2184,"_21201":57084,"_5":14582,"_27821":56791,"_3006":57085},[],"A verifier rejects the CRL because of the issuer.",{"_3550":2293,"_30605":2184,"_21201":57087,"_5":14582,"_27821":56791,"_3006":57088},[],"The list was fetched through a legacy `/crl/<ski>` URL and belongs to the CA that owned that SKI when the upgrade ran.",{"_3550":2294,"_30605":2184,"_21201":57090,"_5":14582,"_27821":56791,"_3006":57091},[],"Use the CDP of the certificate being validated: certificates issued in 4.0.0 carry `/crl/<ca-id>` URLs.",{"_3550":2295,"_30605":2184,"_21201":57093,"_5":14582,"_27821":56795,"_3006":57094},[],"RFC 5280: X.509 and CRL profile.",{"_3550":2296,"_30605":2184,"_21201":57096,"_5":14582,"_27821":56795,"_3006":57097},[],"OpenSSL: openssl-crl.",{"_3550":2297,"_30605":2184,"_21201":57099,"_5":14582,"_27821":56795,"_3006":57100},[],"OpenSSL: openssl-verify.",{"_3550":2298,"_30605":2184,"_21201":57102,"_5":14582,"_27821":56795,"_3006":57103},[],"<Card title=\"OCSP service\" href=\"/docs/platform/pki/ocsp\" />",{"_3550":2299,"_30605":2184,"_21201":57105,"_5":14582,"_27821":56795,"_3006":57106},[],"<Card title=\"Certificate validation\" href=\"/docs/platform/pki/certificate-validation\" />",{"_3550":2300,"_30605":2300,"_5":14934,"_3006":57108,"_30943":57109,"_21201":57110,"_27821":2300},"Keys and cryptographic engines",[49963,51438,55589,55590],[],{"_3550":2301,"_30605":2300,"_21201":57112,"_5":14582,"_27821":2300,"_3006":57113},[],"Generate, import and operate keys without coupling the PKI to a specific provider.",{"_3550":2302,"_30605":2300,"_5":30940,"_21201":57115,"_27821":57116,"_3006":57117},[],"/docs/platform/pki/key-management#what-the-kms-solves","What the KMS solves",{"_3550":2303,"_30605":2300,"_5":30940,"_21201":57119,"_27821":57120,"_3006":57121},[],"/docs/platform/pki/key-management#cryptographic-engines","Cryptographic engines",{"_3550":2304,"_30605":2300,"_5":30940,"_21201":57123,"_27821":57124,"_3006":57125},[],"/docs/platform/pki/key-management#file-system","File System",{"_3550":2305,"_30605":2300,"_5":30940,"_21201":57127,"_27821":57128,"_3006":57129},[],"/docs/platform/pki/key-management#hashicorp-vault","HashiCorp Vault",{"_3550":2306,"_30605":2300,"_5":30940,"_21201":57131,"_27821":57132,"_3006":57133},[],"/docs/platform/pki/key-management#aws-secrets-manager","AWS Secrets Manager",{"_3550":2307,"_30605":2300,"_5":30940,"_21201":57135,"_27821":57136,"_3006":57137},[],"/docs/platform/pki/key-management#aws-kms","AWS KMS",{"_3550":2308,"_30605":2300,"_5":30940,"_21201":57139,"_27821":57140,"_3006":57141},[],"/docs/platform/pki/key-management#pkcs11","PKCS#11",{"_3550":2309,"_30605":2300,"_5":30940,"_21201":57143,"_27821":57144,"_3006":57145},[],"/docs/platform/pki/key-management#azure-key-vault","Azure Key Vault",{"_3550":2310,"_30605":2300,"_5":30940,"_21201":57147,"_27821":57148,"_3006":57149},[],"/docs/platform/pki/key-management#key-inventory","Key inventory",{"_3550":2311,"_30605":2300,"_5":30940,"_21201":57151,"_27821":57152,"_3006":57153},[],"/docs/platform/pki/key-management#create-or-import-keys","Create or import keys",{"_3550":2312,"_30605":2300,"_5":30940,"_21201":57155,"_27821":57156,"_3006":57157},[],"/docs/platform/pki/key-management#generate-a-new-key-pair","Generate a new key pair",{"_3550":2313,"_30605":2300,"_5":30940,"_21201":57159,"_27821":57160,"_3006":57161},[],"/docs/platform/pki/key-management#import-an-existing-pair","Import an existing pair",{"_3550":2314,"_30605":2300,"_5":30940,"_21201":57163,"_27821":57164,"_3006":57165},[],"/docs/platform/pki/key-management#operations-on-a-key","Operations on a key",{"_3550":2315,"_30605":2300,"_5":30940,"_21201":57167,"_27821":57168,"_3006":57169},[],"/docs/platform/pki/key-management#view-details","View details",{"_3550":2316,"_30605":2300,"_5":30940,"_21201":57171,"_27821":57172,"_3006":57173},[],"/docs/platform/pki/key-management#sign-and-verify","Sign and verify",{"_3550":2317,"_30605":2300,"_5":30940,"_21201":57175,"_27821":57176,"_3006":57177},[],"/docs/platform/pki/key-management#sign","Sign",{"_3550":2318,"_30605":2300,"_5":30940,"_21201":57179,"_27821":57180,"_3006":57181},[],"/docs/platform/pki/key-management#verify","Verify",{"_3550":2319,"_30605":2300,"_5":30940,"_21201":57183,"_27821":57184,"_3006":57185},[],"/docs/platform/pki/key-management#generate-a-csr","Generate a CSR",{"_3550":2320,"_30605":2300,"_5":30940,"_21201":57187,"_27821":57188,"_3006":57189},[],"/docs/platform/pki/key-management#sign-locally-with-pkcs11","Sign locally with PKCS#11",{"_3550":2321,"_30605":2300,"_5":30940,"_21201":57191,"_27821":57192,"_3006":57193},[],"/docs/platform/pki/key-management#before-deleting-a-key","Before deleting a key",{"_3550":2322,"_30605":2300,"_21201":57195,"_5":14582,"_27821":2300,"_3006":57196},[],"The Cryptographic Key Management Service (KMS) of Lamassu IoT centralizes the generation, import, custody and use of the platform's keys. This is where you manage the keys that support the CAs and the rest of the signing operations that depend on the PKI.",{"_3550":2323,"_30605":2300,"_21201":57198,"_5":14582,"_27821":2300,"_3006":57199},[],"In the current configuration, Lamassu IoT works exclusively with asymmetric keys, such as RSA and elliptic curves. These keys are used to issue X.509 certificates, sign requests and perform authentication and validation operations within the system.",{"_3550":2324,"_30605":2300,"_21201":57201,"_5":14582,"_27821":57116,"_3006":57202},[],"The KMS unifies key lifecycle management and prevents every service from having to integrate directly with a specific cryptographic provider.",{"_3550":2325,"_30605":2300,"_21201":57204,"_5":14582,"_27821":57116,"_3006":57205},[],"In practice, it lets you:",{"_3550":2326,"_30605":2300,"_21201":57207,"_5":14582,"_27821":57116,"_3006":57208},[],"Generate new key pairs from Lamassu IoT.",{"_3550":2327,"_30605":2300,"_21201":57210,"_5":14582,"_27821":57116,"_3006":57211},[],"Import keys created externally.",{"_3550":2328,"_30605":2300,"_21201":57213,"_5":14582,"_27821":57116,"_3006":57214},[],"Delegate custody and cryptographic operations to external engines.",{"_3550":2329,"_30605":2300,"_21201":57216,"_5":14582,"_27821":57116,"_3006":57217},[],"Reuse existing keys for CAs, CSRs and signing or verification tasks.",{"_3550":2330,"_30605":2300,"_21201":57219,"_5":14582,"_27821":57120,"_3006":57220},[],"Lamassu can work with different cryptographic engines depending on deployment requirements. In some environments a software engine is enough; in others custody must be delegated to an HSM, a cloud service or a specialized platform.",{"_3550":2331,"_30605":2300,"_21201":57222,"_5":14582,"_27821":57120,"_3006":57223},[],"A single instance can have several engines configured at the same time, including multiple instances of the same type. This lets you adapt operations to different security, cost and regulatory requirements.",{"_3550":2332,"_30605":2300,"_21201":57225,"_5":14582,"_27821":57120,"_3006":57226},[],"This guide is for the PKI operator: select and use an already enabled engine. Installation, credentials, persistent storage and connectivity belong to Deployment. Before generating a CA, check the default engine, advertised algorithms and a test signature. Availability in your installation depends on its version and configuration.",{"_3550":2333,"_30605":2300,"_21201":57228,"_5":14582,"_27821":57124,"_3006":57229},[],"Generates software keys and stores private material in files. Custody depends on installation permissions, storage and backups. Before using it for an operational CA, agree how the key will be recovered and how replicas will access it; the KMS record does not replace those files.",{"_3550":2334,"_30605":2300,"_21201":57231,"_5":14582,"_27821":57128,"_3006":57232},[],"The adapter uses KV storage for private material. This is not signing within Vault Transit: someone able to read the secret can recover the key. Review read permissions, availability and recovery with the deployment owner.",{"_3550":2335,"_30605":2300,"_21201":57234,"_5":14582,"_27821":57128,"_3006":57235},[],"The adapter reaches Vault over its configured HTTP(S) endpoint. The Vault server certificate is verified against the system trust store; a Vault signed by a private CA is trusted by adding its CA certificate to the engine's `ca_cert_file` (PEM-encoded). `insecure_skip_verify=true` disables verification and is a last resort; agree the transport settings with the deployment owner.",{"_3550":2336,"_30605":2300,"_21201":57237,"_5":14582,"_27821":57132,"_3006":57238},[],"Offers encrypted persistence in AWS at a cost. It protects the key at rest, but an authorized administrator can recover it; it does not provide the same extraction resistance as a KMS or HSM.",{"_3550":2337,"_30605":2300,"_21201":57240,"_5":14582,"_27821":57136,"_3006":57241},[],"Delegates signing to AWS KMS. The adapter also implements external material import, subject to provider capabilities and permissions. A key generated outside the service has already existed outside its custody; importing it does not remove those copies. Check generation, import and signing as separate operations.",{"_3550":2338,"_30605":2300,"_21201":57243,"_5":14582,"_27821":57140,"_3006":57244},[],"Allows integrating local HSMs, isolated environments and *Key as a Service* offerings. Generation, persistence and extraction resistance depend on the specific device or provider. It is the most flexible option when policy requires hardware custody.",{"_3550":2339,"_30605":2300,"_21201":57246,"_5":14582,"_27821":57144,"_3006":57247},[],"The backend also provides adapters for **Key Vault Keys** and **Key Vault Secrets**. The former delegates signing to the key service; the latter stores private material as secrets and signs using that material. These are different custody models. Confirm which adapter is enabled in your installation and test the required operations.",{"_3550":2340,"_30605":2300,"_21201":57249,"_5":14582,"_27821":57144,"_3006":57250},[],"Lamassu shows the enabled engines in the console.",{"_3550":2341,"_30605":2300,"_21201":57252,"_5":14582,"_27821":57144,"_3006":57253},[],"Each engine defines which algorithms it supports, such as RSA or ECC/ECDSA, and which key sizes it can generate.",{"_3550":2342,"_30605":2300,"_21201":57255,"_5":14582,"_27821":57144,"_3006":57256},[],"Confirm with the deployment operator which engine is configured as the default. That engine will be used when a process needs to create or persist a key and the user has not selected a specific one, for example when creating or importing a CA.",{"_3550":2343,"_30605":2300,"_21201":57258,"_5":14582,"_27821":57148,"_3006":57259},[],"The main KMS screen shows the complete inventory of keys registered in the system. It is the reference view for reviewing which keys exist, where they are kept and which entities they relate to.",{"_3550":2344,"_30605":2300,"_21201":57261,"_5":14582,"_27821":57148,"_3006":57262},[],"The table includes the following fields:",{"_3550":2345,"_30605":2300,"_21201":57264,"_5":14582,"_27821":57148,"_3006":57265},[],"**Name**: descriptive name of the key.",{"_3550":2346,"_30605":2300,"_21201":57267,"_5":14582,"_27821":57148,"_3006":57268},[],"**Type**: algorithm and key size, for example RSA 2048 or EC P-256.",{"_3550":2347,"_30605":2300,"_21201":57270,"_5":14582,"_27821":57148,"_3006":57271},[],"**Strength**: visual indicator of cryptographic strength.",{"_3550":2348,"_30605":2300,"_21201":57273,"_5":14582,"_27821":57148,"_3006":57274},[],"**Public/Private**: whether Lamassu manages the full pair or only the public key.",{"_3550":2349,"_30605":2300,"_21201":57276,"_5":14582,"_27821":57148,"_3006":57277},[],"**Crypto Engine**: cryptographic engine keeping the key.",{"_3550":2350,"_30605":2300,"_21201":57279,"_5":14582,"_27821":57148,"_3006":57280},[],"**Aliases**: alternative names associated with the key.",{"_3550":2351,"_30605":2300,"_21201":57282,"_5":14582,"_27821":57148,"_3006":57283},[],"**Tags**: labels for classification and search.",{"_3550":2352,"_30605":2300,"_21201":57285,"_5":14582,"_27821":57148,"_3006":57286},[],"**Related Entities**: certificates or other entities linked to that key.",{"_3550":2353,"_30605":2300,"_21201":57288,"_5":14582,"_27821":57148,"_3006":57289},[],"From this view you also reach the most common actions:",{"_3550":2354,"_30605":2300,"_21201":57291,"_5":14582,"_27821":57148,"_3006":57292},[],"**View Details** to inspect metadata, identifiers and relationships.",{"_3550":2355,"_30605":2300,"_21201":57294,"_5":14582,"_27821":57148,"_3006":57295},[],"**Generate CSR** to create a PKCS#10 request with the selected key.",{"_3550":2356,"_30605":2300,"_21201":57297,"_5":14582,"_27821":57148,"_3006":57298},[],"**Sign / Verify** to test cryptographic operations on the key.",{"_3550":2357,"_30605":2300,"_21201":57300,"_5":14582,"_27821":57148,"_3006":57301},[],"**Delete Key** to remove the key from the system.",{"_3550":2358,"_30605":2300,"_21201":57303,"_5":14582,"_27821":57152,"_3006":57304},[],"You need key administration permissions and a reachable engine. The issuance profile must allow the chosen algorithm if the key will be used in a CA or CSR. Open **Create New Key** and choose generation or import.",{"_3550":2359,"_30605":2300,"_21201":57306,"_5":14582,"_27821":57156,"_3006":57307},[],"If the key will be born inside Lamassu, the recommended flow is to generate a new pair managed directly by one of the configured engines.",{"_3550":2360,"_30605":2300,"_21201":57309,"_5":14582,"_27821":57156,"_3006":57310},[],"On the wizard's first screen, choose **Generate New Key Pair** and then define the main parameters:",{"_3550":2361,"_30605":2300,"_21201":57312,"_5":14582,"_27821":57156,"_3006":57313},[],"**Key Name**: unique and descriptive name.",{"_3550":2362,"_30605":2300,"_21201":57315,"_5":14582,"_27821":57156,"_3006":57316},[],"**Crypto Engine**: engine that will keep the key.",{"_3550":2363,"_30605":2300,"_21201":57318,"_5":14582,"_27821":57156,"_3006":57319},[],"**Key Type** and **Key Size**: algorithm and size or curve.",{"_3550":2364,"_30605":2300,"_21201":57321,"_5":14582,"_27821":57156,"_3006":57322},[],"**Tags**: metadata to classify the key.",{"_3550":2365,"_30605":2300,"_21201":57324,"_5":14582,"_27821":57156,"_3006":57325},[],"**Metadata**: additional information for advanced uses.",{"_3550":2366,"_30605":2300,"_21201":57327,"_5":14582,"_27821":57160,"_3006":57328},[],"Importing lets you register in Lamassu a key generated outside the platform. It is the usual flow in BYOK scenarios, migrations or integration with cryptographic material already in production.",{"_3550":2367,"_30605":2300,"_21201":57330,"_5":14582,"_27821":57160,"_3006":57331},[],"When you have an exportable private key and the destination engine supports import.",{"_3550":2368,"_30605":2300,"_21201":57333,"_5":14582,"_27821":57160,"_3006":57334},[],"When an existing PKI needs to be migrated without reissuing certificates.",{"_3550":2369,"_30605":2300,"_21201":57336,"_5":14582,"_27821":57160,"_3006":57337},[],"When Lamassu must operate with a root of trust created by a third party.",{"_3550":2370,"_30605":2300,"_21201":57339,"_5":14582,"_27821":57160,"_3006":57340},[],"In the wizard, choose **Import Existing Key Pair** and complete the requested fields:",{"_3550":2371,"_30605":2300,"_21201":57342,"_5":14582,"_27821":57160,"_3006":57343},[],"**Key Name**: descriptive name within Lamassu IoT.",{"_3550":2372,"_30605":2300,"_21201":57345,"_5":14582,"_27821":57160,"_3006":57346},[],"**Crypto Engine**: engine that will keep the imported key.",{"_3550":2373,"_30605":2300,"_21201":57348,"_5":14582,"_27821":57160,"_3006":57349},[],"**Tags**: labels for organization and search.",{"_3550":2374,"_30605":2300,"_21201":57351,"_5":14582,"_27821":57160,"_3006":57352},[],"**Metadata**: additional optional information.",{"_3550":2375,"_30605":2300,"_21201":57354,"_5":14582,"_27821":57160,"_3006":57355},[],"**Private Key (PEM)**: private key in PEM format.",{"_3550":2376,"_30605":2300,"_21201":57357,"_5":14582,"_27821":57160,"_3006":57358},[],"After a successful import, open the record, check the engine and public key, and perform a test signature. A non-exportable HSM key cannot be uploaded through this PEM form: configure engine access and check how the existing key is registered. Review dependencies and any provider resources already created if an operation fails partway through.",{"_3550":2377,"_30605":2300,"_21201":57360,"_5":14582,"_27821":57164,"_3006":57361},[],"Each registered key has a detail view and several operational actions.",{"_3550":2378,"_30605":2300,"_21201":57363,"_5":14582,"_27821":57168,"_3006":57364},[],"The **View Details** screen concentrates the technical and administrative information of the key.",{"_3550":2379,"_30605":2300,"_21201":57366,"_5":14582,"_27821":57168,"_3006":57367},[],"The **Overview** tab shows, among others, these fields:",{"_3550":2380,"_30605":2300,"_21201":57369,"_5":14582,"_27821":57168,"_3006":57370},[],"**Key Name**: descriptive name.",{"_3550":2381,"_30605":2300,"_21201":57372,"_5":14582,"_27821":57168,"_3006":57373},[],"**Key Identifier**: unique system identifier. Lamassu uses PKCS11-based ID formats.",{"_3550":2382,"_30605":2300,"_21201":57375,"_5":14582,"_27821":57168,"_3006":57376},[],"**Tags**: associated labels.",{"_3550":2383,"_30605":2300,"_21201":57378,"_5":14582,"_27821":57168,"_3006":57379},[],"**Aliases**: alternative names.",{"_3550":2384,"_30605":2300,"_21201":57381,"_5":14582,"_27821":57168,"_3006":57382},[],"**Crypto Engine**: engine where the key resides.",{"_3550":2385,"_30605":2300,"_21201":57384,"_5":14582,"_27821":57168,"_3006":57385},[],"**Algorithm, Key Size & Strength**: algorithm, parameters and strength level.",{"_3550":2386,"_30605":2300,"_21201":57387,"_5":14582,"_27821":57168,"_3006":57388},[],"The **Related Entities** section shows which Lamassu objects depend on that key.",{"_3550":2387,"_30605":2300,"_21201":57390,"_5":14582,"_27821":57168,"_3006":57391},[],"The **Public Key** tab shows public material in PEM. The record’s identifier and URI locate the key; a PKCS#11-formatted URI does not establish that the engine is an HSM or that a local module can access it.",{"_3550":2388,"_30605":2300,"_21201":57393,"_5":14582,"_27821":57172,"_3006":57394},[],"The **Sign / Verify** action validates that the key and the cryptographic engine work correctly.",{"_3550":2389,"_30605":2300,"_21201":57396,"_5":14582,"_27821":57172,"_3006":57397},[],"Sign a test message, save the signature and verify it using the same public key, algorithm and encoding. Then change the message: verification should fail. This tests one operation; it does not establish every engine capability or a CA’s chain.",{"_3550":2390,"_30605":2300,"_21201":57399,"_5":14582,"_27821":57172,"_3006":57400},[],"When you open it, two areas appear: **Sign** and **Verify**.",{"_3550":2391,"_30605":2300,"_21201":57402,"_5":14582,"_27821":57176,"_3006":57403},[],"This tab uses the private key to generate a digital signature over a message or an already computed *digest*.",{"_3550":2392,"_30605":2300,"_21201":57405,"_5":14582,"_27821":57176,"_3006":57406},[],"Main fields:",{"_3550":2393,"_30605":2300,"_21201":57408,"_5":14582,"_27821":57176,"_3006":57409},[],"**Algorithm**: signing algorithm available for the key type.",{"_3550":2394,"_30605":2300,"_21201":57411,"_5":14582,"_27821":57176,"_3006":57412},[],"**Message Type**: `Raw` for clear data or `Digest` for a precomputed hash.",{"_3550":2395,"_30605":2300,"_21201":57414,"_5":14582,"_27821":57176,"_3006":57415},[],"**Payload Encoding**: input encoding, such as UTF-8, Hex or Base64.",{"_3550":2396,"_30605":2300,"_21201":57417,"_5":14582,"_27821":57176,"_3006":57418},[],"**Message**: content to sign.",{"_3550":2397,"_30605":2300,"_21201":57420,"_5":14582,"_27821":57176,"_3006":57421},[],"**Signature**: result of the operation, shown in hexadecimal.",{"_3550":2398,"_30605":2300,"_21201":57423,"_5":14582,"_27821":57180,"_3006":57424},[],"This tab checks whether a signature corresponds to the associated public key.",{"_3550":2399,"_30605":2300,"_21201":57426,"_5":14582,"_27821":57180,"_3006":57406},[],{"_3550":2400,"_30605":2300,"_21201":57428,"_5":14582,"_27821":57180,"_3006":57429},[],"**Algorithm**: must match the algorithm used for the signature.",{"_3550":2401,"_30605":2300,"_21201":57431,"_5":14582,"_27821":57180,"_3006":57432},[],"**Message Type**: `Raw` or `Digest`.",{"_3550":2402,"_30605":2300,"_21201":57434,"_5":14582,"_27821":57180,"_3006":57435},[],"**Payload Encoding**: encoding of the message.",{"_3550":2403,"_30605":2300,"_21201":57437,"_5":14582,"_27821":57180,"_3006":57438},[],"**Message**: original message or hash.",{"_3550":2404,"_30605":2300,"_21201":57440,"_5":14582,"_27821":57180,"_3006":57441},[],"**Signature**: signature to check.",{"_3550":2405,"_30605":2300,"_21201":57443,"_5":14582,"_27821":57180,"_3006":57444},[],"**Result**: indicator of the validation result.",{"_3550":2406,"_30605":2300,"_21201":57446,"_5":14582,"_27821":57184,"_3006":57447},[],"The **Generate CSR** action creates a PKCS#10 request signed with the private key kept in Lamassu, without exposing it outside the cryptographic engine.",{"_3550":2407,"_30605":2300,"_21201":57449,"_5":14582,"_27821":57184,"_3006":57450},[],"This flow is useful for:",{"_3550":2408,"_30605":2300,"_21201":57452,"_5":14582,"_27821":57184,"_3006":57453},[],"Requesting certificates from an external CA.",{"_3550":2409,"_30605":2300,"_21201":57455,"_5":14582,"_27821":57184,"_3006":57456},[],"Renewing an identity while keeping the same key.",{"_3550":2410,"_30605":2300,"_21201":57458,"_5":14582,"_27821":57184,"_3006":57459},[],"When you open the form, it asks for the subject data and the main certificate attributes:",{"_3550":2411,"_30605":2300,"_21201":57461,"_5":14582,"_27821":57184,"_3006":57462},[],"**Common Name (CN)**: main name of the identity.",{"_3550":2412,"_30605":2300,"_21201":57464,"_5":14582,"_27821":57184,"_3006":57465},[],"**Organization (O)**: organization or company.",{"_3550":2413,"_30605":2300,"_21201":57467,"_5":14582,"_27821":57184,"_3006":57468},[],"**Organizational Unit (OU)**: department or unit.",{"_3550":2414,"_30605":2300,"_21201":57470,"_5":14582,"_27821":57184,"_3006":57471},[],"**Country (C)**: two-letter country code.",{"_3550":2415,"_30605":2300,"_21201":57473,"_5":14582,"_27821":57184,"_3006":57474},[],"**State / Province (ST)**: state or province.",{"_3550":2416,"_30605":2300,"_21201":57476,"_5":14582,"_27821":57184,"_3006":57477},[],"**Locality (L)**: city or locality.",{"_3550":2417,"_30605":2300,"_21201":57479,"_5":14582,"_27821":57184,"_3006":57480},[],"**Email Address**: contact email.",{"_3550":2418,"_30605":2300,"_21201":57482,"_5":14582,"_27821":57184,"_3006":57483},[],"**Subject Alternative Names (SANs)**: alternative names or identifiers, such as DNS or IP.",{"_3550":2419,"_30605":2300,"_21201":57485,"_5":14582,"_27821":57184,"_3006":57486},[],"Download the CSR and run `openssl req -in request.csr -noout -verify -text`. Check signature, subject and SAN before sending it. A CSR does not determine the final certificate by itself: issuance policy can replace its fields.",{"_3550":2420,"_30605":2300,"_21201":57488,"_5":14582,"_27821":57188,"_3006":57489},[],"Lamassu also offers specific help for local integrations through **Sign locally with OpenSSL & PKCS11 tools**.",{"_3550":2421,"_30605":2300,"_21201":57491,"_5":14582,"_27821":57188,"_3006":57492},[],"It requires the module, token and permissions of the corresponding provider. Check that the Lamassu identifier matches the object accessible from that module. Module configuration belongs to the client environment or Deployment.",{"_3550":2422,"_30605":2300,"_21201":57494,"_5":14582,"_27821":57192,"_3006":57495},[],"Review **Related Entities** and locate CAs, certificates and validation processes that still need signatures. Revoking a CA does not remove the need to publish status during its retention period. Deleting a key does not automatically revoke its certificates either. Plan replacement and retention before using **Delete Key**; provider deletion behavior depends on the engine.",{"_3550":2423,"_30605":2300,"_21201":57497,"_5":14582,"_27821":57192,"_3006":57498},[],"The KMS refuses to delete a key that certificates still reference, with `409` `key is in use`. Revoking a certificate or letting it expire does not release its key reference. Deleting a CA releases the references from its own current certificate and linked reissued certificates, which stay in place to back the CRL and OCSP, and then attempts to delete the key. If other certificates still reference the key, such as another CA sharing it, the KMS keeps it. The certificates the CA issued keep their own key references, even when revoked. The API lets you delete such a certificate only once its issuer CA no longer exists, and deleting it removes it from the CRL and OCSP responses, so keep revoked certificates for their retention period and delete only expired or superseded ones. The KMS also refuses to delete a key that signs the CRL of a CA whose CRL settings are still `ACTIVE`, with the same `409` `key is in use`; that reference is released when the settings are finalized, after the CA is revoked permanently or expires (see CRL). Legacy references retained by the upgrade migration are described in the upgrade guide.",{"_3550":2424,"_30605":2424,"_5":14934,"_3006":57500,"_30943":57501,"_21201":57502,"_27821":2424},"Online validation with OCSP",[49963,51438,55589,56231],[],{"_3550":2425,"_30605":2424,"_21201":57504,"_5":14582,"_27821":2424,"_3006":57505},[],"Query signed status and verify the responder’s response.",{"_3550":2426,"_30605":2424,"_5":30940,"_21201":57507,"_27821":57508,"_3006":57509},[],"/docs/platform/pki/ocsp#how-the-responder-works-in-lamassu","How the responder works in Lamassu",{"_3550":2427,"_30605":2424,"_5":30940,"_21201":57511,"_27821":57512,"_3006":57513},[],"/docs/platform/pki/ocsp#embedding-in-issued-certificates","Embedding in issued certificates",{"_3550":2428,"_30605":2424,"_5":30940,"_21201":57515,"_27821":57516,"_3006":57517},[],"/docs/platform/pki/ocsp#http-endpoints","HTTP endpoints",{"_3550":2429,"_30605":2424,"_5":30940,"_21201":57519,"_27821":57520,"_3006":57521},[],"/docs/platform/pki/ocsp#generate-and-verify-a-query","Generate and verify a query",{"_3550":2430,"_30605":2424,"_5":30940,"_21201":57523,"_27821":57524,"_3006":57525},[],"/docs/platform/pki/ocsp#check-from-the-interface","Check from the interface",{"_3550":2431,"_30605":2424,"_5":30940,"_21201":57527,"_27821":57528,"_3006":56796},[],"/docs/platform/pki/ocsp#references",{"_3550":2432,"_30605":2424,"_21201":57530,"_5":14582,"_27821":2424,"_3006":57531},[],"OCSP queries a certificate’s status and returns a signed response. This guide is for an integrator checking what Lamassu publishes and how the consumer must verify it. For complete identity validation, follow Certificate validation.",{"_3550":2433,"_30605":2424,"_21201":57533,"_5":14582,"_27821":57508,"_3006":57534},[],"The responder retrieves the certificate by serial number and locates its issuing CA in the inventory. It translates persisted status as follows:",{"_3550":2434,"_30605":2424,"_21201":57536,"_5":14582,"_27821":57508,"_3006":57537},[],"Record status",{"_3550":2435,"_30605":2424,"_21201":57539,"_5":14582,"_27821":57508,"_3006":57540},[],"Signed response",{"_3550":2436,"_30605":2424,"_21201":57542,"_5":14582,"_27821":57508,"_3006":54726},[],{"_3550":2437,"_30605":2424,"_21201":57544,"_5":14582,"_27821":57508,"_3006":57545},[],"`Good`.",{"_3550":2438,"_30605":2424,"_21201":57547,"_5":14582,"_27821":57508,"_3006":54743},[],{"_3550":2439,"_30605":2424,"_21201":57549,"_5":14582,"_27821":57508,"_3006":57550},[],"`Revoked`, with revocation reason and timestamp.",{"_3550":2440,"_30605":2424,"_21201":57552,"_5":14582,"_27821":57508,"_3006":57553},[],"Other states, including `INACTIVE` and `EXPIRED`",{"_3550":2441,"_30605":2424,"_21201":57555,"_5":14582,"_27821":57508,"_3006":57556},[],"`Unknown` if the certificate and issuer can be retrieved.",{"_3550":2442,"_30605":2424,"_21201":57558,"_5":14582,"_27821":57508,"_3006":57559},[],"An absent serial number causes a lookup error; it does not guarantee a signed `Unknown` response. Lookup or signing errors produce an HTTP failure. Treat that as unavailable evidence according to consumer policy.",{"_3550":2443,"_30605":2424,"_21201":57561,"_5":14582,"_27821":57508,"_3006":57562},[],"The issuing CA itself signs the response through its KMS-associated key. A delegated OCSP signing certificate is not used. An imported CA without a usable key cannot sign responses.",{"_3550":2444,"_30605":2424,"_21201":57564,"_5":14582,"_27821":57508,"_3006":57565},[],"The implementation sets `thisUpdate` approximately one day before response generation and `nextUpdate` one day after: the declared window is about 48 hours. Inspect received values and apply your freshness policy. The response reflects stored status when queried; a previously cached copy does not change upon revocation.",{"_3550":2445,"_30605":2424,"_21201":57567,"_5":14582,"_27821":57512,"_3006":57568},[],"The signer constructs OCSP URLs from configured VA domains and adds them to AIA. Without domains, there is no URL to add; an imported certificate retains its original extensions. Inspect the actual certificate:",{"_3550":2446,"_30605":2424,"_21201":57570,"_5":14582,"_27821":57512,"_3006":57571},[],"Check that the consumer can reach this URL. DNS, endpoint exposure and domain configuration belong to Deployment. Changing configuration does not modify already signed certificates.",{"_3550":2447,"_30605":2424,"_21201":57573,"_5":14582,"_27821":57516,"_3006":57574},[],"The service accepts:",{"_3550":2448,"_30605":2424,"_21201":57576,"_5":14582,"_27821":57516,"_3006":53354},[],{"_3550":2449,"_30605":2424,"_21201":57578,"_5":14582,"_27821":57516,"_3006":57579},[],"VA service path",{"_3550":2450,"_30605":2424,"_21201":57581,"_5":14582,"_27821":57516,"_3006":57582},[],"Format",{"_3550":2451,"_30605":2424,"_21201":57584,"_5":14582,"_27821":57516,"_3006":57585},[],"`POST`",{"_3550":2452,"_30605":2424,"_21201":57587,"_5":14582,"_27821":57516,"_3006":57588},[],"`/ocsp`",{"_3550":2453,"_30605":2424,"_21201":57590,"_5":14582,"_27821":57516,"_3006":57591},[],"DER request, `Content-Type: application/ocsp-request`.",{"_3550":2454,"_30605":2424,"_21201":57593,"_5":14582,"_27821":57516,"_3006":56980},[],{"_3550":2455,"_30605":2424,"_21201":57595,"_5":14582,"_27821":57516,"_3006":57596},[],"`/ocsp/{ocsp_request}`",{"_3550":2456,"_30605":2424,"_21201":57598,"_5":14582,"_27821":57516,"_3006":57599},[],"DER request encoded using padded URL Base64.",{"_3550":2457,"_30605":2424,"_21201":57601,"_5":14582,"_27821":57516,"_3006":57602},[],"Use POST to avoid client encoding differences. A successful response has `Content-Type: application/ocsp-response` and a DER body. The public prefix depends on the Gateway; use the URL published in the certificate and checked by the operator.",{"_3550":2458,"_30605":2424,"_21201":57604,"_5":14582,"_27821":57520,"_3006":57605},[],"You need OpenSSL 3.x, `device.crt`, its direct issuer’s certificate `issuer.pem` and the consumer’s trusted roots in `roots.pem`. For an intermediate issuer, also prepare `intermediates.pem` containing the intermediate CAs.",{"_3550":2459,"_30605":2424,"_21201":57607,"_5":14582,"_27821":57520,"_3006":57608},[],"Generate the request:",{"_3550":2460,"_30605":2424,"_21201":57610,"_5":14582,"_27821":57520,"_3006":57611},[],"This example omits the nonce because the responder does not echo it. Verification relies on signature, response correspondence and timestamps; it does not demonstrate freshness through a nonce.",{"_3550":2461,"_30605":2424,"_21201":57613,"_5":14582,"_27821":57520,"_3006":57614},[],"Replace the example URL with the inspected endpoint:",{"_3550":2462,"_30605":2424,"_21201":57616,"_5":14582,"_27821":57520,"_3006":57617},[],"Verify the returned DER:",{"_3550":2463,"_30605":2424,"_21201":57619,"_5":14582,"_27821":57520,"_3006":57620},[],"For intermediates, add `-verify_other intermediates.pem`. Require successful response verification and inspect the status corresponding to `device.crt`, issuer, serial, `thisUpdate` and `nextUpdate`. `Response verify OK` validates the response only: also observe `good`, `revoked` or `unknown`. Do not accept an identity based only on the command’s exit code.",{"_3550":2464,"_30605":2424,"_21201":57622,"_5":14582,"_27821":57524,"_3006":57623},[],"**OCSP Check** shows what Lamassu returns for a selected certificate. Complete the check from the consumer’s network and trust store: a console query does not establish its validation configuration.",{"_3550":2465,"_30605":2424,"_21201":57625,"_5":14582,"_27821":57524,"_3006":57626},[],"To check a change, save an earlier response, revoke a test certificate and request another response. The new query should reflect persisted status; compare timestamps to rule out reuse of an earlier response. If it fails, follow PKI troubleshooting.",{"_3550":2466,"_30605":2424,"_21201":57628,"_5":14582,"_27821":57528,"_3006":57629},[],"RFC 6960: OCSP.",{"_3550":2467,"_30605":2424,"_21201":57631,"_5":14582,"_27821":57528,"_3006":57632},[],"OpenSSL: openssl-ocsp.",{"_3550":2468,"_30605":2424,"_21201":57634,"_5":14582,"_27821":57528,"_3006":57635},[],"<Card title=\"CRL service\" href=\"/docs/platform/pki/crl\" />",{"_3550":2469,"_30605":2424,"_21201":57637,"_5":14582,"_27821":57528,"_3006":57106},[],{"_3550":2470,"_30605":2470,"_5":14934,"_3006":55589,"_30943":57639,"_21201":57640,"_27821":2470},[49963,51438,55589],[],{"_3550":2471,"_30605":2470,"_21201":57642,"_5":14582,"_27821":2470,"_3006":57643},[],"Administer keys and authorities, define issuance and verify the resulting certificates.",{"_3550":2472,"_30605":2470,"_5":30940,"_21201":57645,"_27821":57646,"_3006":54901},[],"/docs/platform/pki/overview#start-here",{"_3550":2473,"_30605":2470,"_5":30940,"_21201":57648,"_27821":57649,"_3006":57650},[],"/docs/platform/pki/overview#what-you-need","What you need",{"_3550":2474,"_30605":2470,"_5":30940,"_21201":57652,"_27821":57653,"_3006":55433},[],"/docs/platform/pki/overview#core-capabilities",{"_3550":2475,"_30605":2470,"_5":30940,"_21201":57655,"_27821":57656,"_3006":55437},[],"/docs/platform/pki/overview#build-your-trust-hierarchy",{"_3550":2476,"_30605":2470,"_5":30940,"_21201":57658,"_27821":57659,"_3006":55441},[],"/docs/platform/pki/overview#protect-cryptographic-keys",{"_3550":2477,"_30605":2470,"_5":30940,"_21201":57661,"_27821":57662,"_3006":55445},[],"/docs/platform/pki/overview#issue-and-control-certificates",{"_3550":2478,"_30605":2470,"_5":30940,"_21201":57664,"_27821":57665,"_3006":55453},[],"/docs/platform/pki/overview#publish-validation-status",{"_3550":2479,"_30605":2470,"_5":30940,"_21201":57667,"_27821":57668,"_3006":57669},[],"/docs/platform/pki/overview#how-to-check-the-result","How to check the result",{"_3550":2480,"_30605":2470,"_5":30940,"_21201":57671,"_27821":57672,"_3006":56398},[],"/docs/platform/pki/overview#continue",{"_3550":2481,"_30605":2470,"_21201":57674,"_5":14582,"_27821":2470,"_3006":57675},[],"The PKI section explains how to build and operate X.509 trust in Lamassu: which authorities issue, which rules apply and how to check certificates. It is intended for PKI administrators and anyone who needs to use certificates in a consuming system.",{"_3550":2482,"_30605":2470,"_21201":57677,"_5":14582,"_27821":57646,"_3006":57678},[],"Follow PKI getting started to create a CA, issue a client certificate and verify it with OpenSSL. The result is a certificate, its private key and a verified chain.",{"_3550":2483,"_30605":2470,"_21201":57680,"_5":14582,"_27821":57646,"_3006":57681},[],"You can complete that path before managing devices. When you need to associate the identity with an inventory or automate its enrollment, continue in IoT Fleets.",{"_3550":2484,"_30605":2470,"_21201":57683,"_5":14582,"_27821":57649,"_3006":57684},[],"An accessible instance and permission to manage the keys, CAs and certificates you will use.",{"_3550":2485,"_30605":2470,"_21201":57686,"_5":14582,"_27821":57649,"_3006":57687},[],"An available cryptographic engine to keep the authority's key.",{"_3550":2486,"_30605":2470,"_21201":57689,"_5":14582,"_27821":57649,"_3006":57690},[],"The certificate's purpose, such as authenticating a client through mTLS.",{"_3550":2487,"_30605":2470,"_21201":57692,"_5":14582,"_27821":57649,"_3006":57693},[],"Consumer requirements: accepted issuers, algorithms, names and permitted usages.",{"_3550":2488,"_30605":2470,"_21201":57695,"_5":14582,"_27821":57649,"_3006":57696},[],"Prepare the instance and cryptographic provider in Deployment. The trust model explains hierarchy choices.",{"_3550":2489,"_30605":2470,"_21201":57698,"_5":14582,"_27821":57656,"_3006":57699},[],"Authorities sign certificates. A root establishes the trust anchor, and an intermediate separates issuance by environment or purpose. Hierarchy and rotation explains how to maintain trust when replacing an authority.",{"_3550":2490,"_30605":2470,"_21201":57701,"_5":14582,"_27821":57659,"_3006":57702},[],"CA signing keys are managed through KMS and cryptographic engines. A client that generates a CSR can keep its own key: preserve that custody when choosing the issuance method.",{"_3550":2491,"_30605":2470,"_21201":57704,"_5":14582,"_27821":57662,"_3006":57705},[],"A profile establishes subject, validity, usage and key restrictions. The CA applies issuance configuration and signs the certificate. In the inventory, you can inspect the result, download it and manage its status.",{"_3550":2492,"_30605":2470,"_21201":57707,"_5":14582,"_27821":57665,"_3006":57708},[],"Validation covers the chain, validity, usages and revocation status. Lamassu publishes status through OCSP and CRL; the consumer configures which issuers it recognizes and how it checks that status.",{"_3550":2493,"_30605":2470,"_21201":57710,"_5":14582,"_27821":57668,"_3006":57711},[],"An active certificate in the console is one part of the check. Also verify that:",{"_3550":2494,"_30605":2470,"_21201":57713,"_5":14582,"_27821":57668,"_3006":57714},[],"its subject and extensions identify the expected client;",{"_3550":2495,"_30605":2470,"_21201":57716,"_5":14582,"_27821":57668,"_3006":57717},[],"its public key matches the client's private key;",{"_3550":2496,"_30605":2470,"_21201":57719,"_5":14582,"_27821":57668,"_3006":57720},[],"its chain reaches a root trusted by the consumer;",{"_3550":2497,"_30605":2470,"_21201":57722,"_5":14582,"_27821":57668,"_3006":57723},[],"its dates and usages allow the operation;",{"_3550":2498,"_30605":2470,"_21201":57725,"_5":14582,"_27821":57668,"_3006":57726},[],"the consumer applies revocation checks and authorization.",{"_3550":2499,"_30605":2470,"_21201":57728,"_5":14582,"_27821":57668,"_3006":57729},[],"The issuance path includes the first independent checks.",{"_3550":2500,"_30605":2470,"_21201":57731,"_5":14582,"_27821":57672,"_3006":57732},[],"<Card title=\"PKI getting started\" description=\"Create a CA, then issue and verify a client certificate.\" href=\"/docs/platform/pki/quickstarts/overview\" />",{"_3550":2501,"_30605":2470,"_21201":57734,"_5":14582,"_27821":57672,"_3006":57735},[],"<Card title=\"Apply PKI to devices\" description=\"Associate certificates with inventory and prepare enrollment.\" href=\"/docs/platform/iot-fleets/overview\" />",{"_3550":2502,"_30605":2470,"_21201":57737,"_5":14582,"_27821":57672,"_3006":57738},[],"<Card title=\"PKI diagnostics\" description=\"Check issuance, OCSP and CRL when the result fails.\" href=\"/docs/platform/pki/troubleshooting\" />",{"_3550":2503,"_30605":2503,"_5":14934,"_3006":57740,"_30943":57741,"_21201":57742,"_27821":2503},"Create your first CA",[49963,51438,55589,55026],[],{"_3550":2504,"_30605":2503,"_21201":57744,"_5":14582,"_27821":2503,"_3006":57745},[],"Create an evaluation root and check its certificate before issuing.",{"_3550":2505,"_30605":2503,"_5":30940,"_21201":57747,"_27821":57748,"_3006":49973},[],"/docs/platform/pki/quickstarts/create-certificate-authority#before-you-begin",{"_3550":2506,"_30605":2503,"_5":30940,"_21201":57750,"_27821":57751,"_3006":57752},[],"/docs/platform/pki/quickstarts/create-certificate-authority#open-the-creation-wizard-toc","Open the creation wizard [!toc]",{"_3550":2507,"_30605":2503,"_5":30940,"_21201":57754,"_27821":57755,"_3006":57756},[],"/docs/platform/pki/quickstarts/create-certificate-authority#select-the-key-toc","Select the key [!toc]",{"_3550":2508,"_30605":2503,"_5":30940,"_21201":57758,"_27821":57759,"_3006":57760},[],"/docs/platform/pki/quickstarts/create-certificate-authority#define-the-authority-toc","Define the authority [!toc]",{"_3550":2509,"_30605":2503,"_5":30940,"_21201":57762,"_27821":57763,"_3006":57764},[],"/docs/platform/pki/quickstarts/create-certificate-authority#review-and-create-the-ca-toc","Review and create the CA [!toc]",{"_3550":2510,"_30605":2503,"_5":30940,"_21201":57766,"_27821":57767,"_3006":57768},[],"/docs/platform/pki/quickstarts/create-certificate-authority#verify-the-result-toc","Verify the result [!toc]",{"_3550":2511,"_30605":2503,"_5":30940,"_21201":57770,"_27821":57771,"_3006":57772},[],"/docs/platform/pki/quickstarts/create-certificate-authority#check-the-ca-certificate","Check the CA certificate",{"_3550":2512,"_30605":2503,"_5":30940,"_21201":57774,"_27821":57775,"_3006":55283},[],"/docs/platform/pki/quickstarts/create-certificate-authority#if-the-result-fails",{"_3550":2513,"_30605":2503,"_5":30940,"_21201":57777,"_27821":57778,"_3006":49997},[],"/docs/platform/pki/quickstarts/create-certificate-authority#next-step",{"_3550":2514,"_30605":2503,"_21201":57780,"_5":14582,"_27821":2503,"_3006":57781},[],"You will create a root authority with a new key kept by a Lamassu engine. The result is an active CA and its public certificate in `ca.pem`, ready to verify issuance in the next path.",{"_3550":2515,"_30605":2503,"_21201":57783,"_5":14582,"_27821":57748,"_3006":57784},[],"Console access and permission to create keys and authorities.",{"_3550":2516,"_30605":2503,"_21201":57786,"_5":14582,"_27821":57748,"_3006":57787},[],"An available cryptographic engine that supports the chosen algorithm.",{"_3550":2517,"_30605":2503,"_21201":57789,"_5":14582,"_27821":57748,"_3006":57790},[],"OpenSSL 3.x to check the downloaded certificate.",{"_3550":2518,"_30605":2503,"_21201":57792,"_5":14582,"_27821":57748,"_3006":57793},[],"Use an evaluation instance or an authority intended for these tests. The example creates a root that issues directly; to design an operational hierarchy, see Hierarchy and rotation.",{"_3550":2519,"_30605":2503,"_21201":57795,"_5":14582,"_27821":57751,"_3006":57796},[],"In **Certification Authorities**, select **Create New CA** and choose to create a CA with a new key pair.",{"_3550":2520,"_30605":2503,"_21201":57798,"_5":14582,"_27821":57751,"_3006":57799},[],"The &#x2A;*Create New CA (Existing Key)** flow is explained in the authorities guide.",{"_3550":2521,"_30605":2503,"_21201":57801,"_5":14582,"_27821":57755,"_3006":57802},[],"Choose the engine that will keep the key and an algorithm its capabilities allow. For this example, you can use **EC P-384** if available.",{"_3550":2522,"_30605":2503,"_21201":57804,"_5":14582,"_27821":57755,"_3006":57805},[],"The CA private key is used through the engine. In this path, you will download only the authority's public certificate.",{"_3550":2523,"_30605":2503,"_21201":57807,"_5":14582,"_27821":57759,"_3006":57808},[],"Select **Root CA** and complete:",{"_3550":2524,"_30605":2503,"_21201":57810,"_5":14582,"_27821":57759,"_3006":57811},[],"**CA Name**: `Acme Evaluation Root CA`.",{"_3550":2525,"_30605":2503,"_21201":57813,"_5":14582,"_27821":57759,"_3006":57814},[],"**Subject**: organization and country details for your evaluation.",{"_3550":2526,"_30605":2503,"_21201":57816,"_5":14582,"_27821":57759,"_3006":57817},[],"**CA Certificate Expiration**: for example, one year from creation.",{"_3550":2527,"_30605":2503,"_21201":57819,"_5":14582,"_27821":57759,"_3006":57820},[],"**Default End-Entity Certificate Issuance Expiration**: for example, 90 days, within the CA's lifetime.",{"_3550":2528,"_30605":2503,"_21201":57822,"_5":14582,"_27821":57759,"_3006":57823},[],"The CA name becomes its `Common Name`. Keep the CA usages needed to sign certificates and CRLs.",{"_3550":2529,"_30605":2503,"_21201":57825,"_5":14582,"_27821":57763,"_3006":57826},[],"Check the engine, algorithm, subject, root type and dates. Confirm creation and note the authority identifier so you can recognize it in the DMS or API.",{"_3550":2530,"_30605":2503,"_21201":57828,"_5":14582,"_27821":57767,"_3006":57829},[],"Open the new CA. It should appear active, show its certificate and allow access to **Issued Certificates**.",{"_3550":2531,"_30605":2503,"_21201":57831,"_5":14582,"_27821":57767,"_3006":57832},[],"Download or copy the authority's PEM certificate and save it as `ca.pem`. Check that the file contains the complete block, including `BEGIN CERTIFICATE` and `END CERTIFICATE`.",{"_3550":2532,"_30605":2503,"_21201":57834,"_5":14582,"_27821":57771,"_3006":57835},[],"Run from the directory where you saved `ca.pem`:",{"_3550":2533,"_30605":2503,"_21201":57837,"_5":14582,"_27821":57771,"_3006":57838},[],"Check that the subject and issuer match the root you created, the dates include the current time, **Basic Constraints** contains `CA:TRUE` and **Key Usage** allows certificate signing. The last command should return `ca.pem: OK`.",{"_3550":2534,"_30605":2503,"_21201":57840,"_5":14582,"_27821":57771,"_3006":57841},[],"You explicitly selected `ca.pem` as the trust anchor for this test. A valid self-signature does not install that trust in other consumers. See the openssl-verify reference for verification options.",{"_3550":2535,"_30605":2503,"_21201":57843,"_5":14582,"_27821":57775,"_3006":57844},[],"If creation fails, check permissions, engine availability and the selected algorithm.",{"_3550":2536,"_30605":2503,"_21201":57846,"_5":14582,"_27821":57775,"_3006":57847},[],"If OpenSSL cannot read the file, copy the complete PEM block again.",{"_3550":2537,"_30605":2503,"_21201":57849,"_5":14582,"_27821":57775,"_3006":57850},[],"If signature or date checks fail, check that you downloaded this CA's certificate and that your computer's clock is correct.",{"_3550":2538,"_30605":2503,"_21201":57852,"_5":14582,"_27821":57775,"_3006":57853},[],"PKI diagnostics covers issuance checks and cryptographic dependencies.",{"_3550":2539,"_30605":2503,"_21201":57855,"_5":14582,"_27821":57778,"_3006":57856},[],"Continue with Issue and verify a certificate, using this authority and `ca.pem`.",{"_3550":2540,"_30605":2540,"_5":14934,"_3006":57858,"_30943":57859,"_21201":57860,"_27821":2540},"Issue and verify a certificate",[49963,51438,55589,55026],[],{"_3550":2541,"_30605":2540,"_21201":57862,"_5":14582,"_27821":2540,"_3006":57863},[],"Issue a client certificate and check content, chain and key correspondence.",{"_3550":2542,"_30605":2540,"_5":30940,"_21201":57865,"_27821":57866,"_3006":49973},[],"/docs/platform/pki/quickstarts/issue-certificate#before-you-begin",{"_3550":2543,"_30605":2540,"_5":30940,"_21201":57868,"_27821":57869,"_3006":57870},[],"/docs/platform/pki/quickstarts/issue-certificate#start-the-issuance","Start the issuance",{"_3550":2544,"_30605":2540,"_5":30940,"_21201":57872,"_27821":57873,"_3006":57874},[],"/docs/platform/pki/quickstarts/issue-certificate#choose-the-method","Choose the method",{"_3550":2545,"_30605":2540,"_5":30940,"_21201":57876,"_27821":57877,"_3006":57878},[],"/docs/platform/pki/quickstarts/issue-certificate#identify-the-certificate","Identify the certificate",{"_3550":2546,"_30605":2540,"_5":30940,"_21201":57880,"_27821":57881,"_3006":57882},[],"/docs/platform/pki/quickstarts/issue-certificate#configure-key-and-uses","Configure key and uses",{"_3550":2547,"_30605":2540,"_5":30940,"_21201":57884,"_27821":57885,"_3006":57886},[],"/docs/platform/pki/quickstarts/issue-certificate#issue-and-download","Issue and download",{"_3550":2548,"_30605":2540,"_5":30940,"_21201":57888,"_27821":57889,"_3006":57890},[],"/docs/platform/pki/quickstarts/issue-certificate#verify-the-result","Verify the result",{"_3550":2549,"_30605":2540,"_5":30940,"_21201":57892,"_27821":57893,"_3006":57894},[],"/docs/platform/pki/quickstarts/issue-certificate#inspect-content-and-dates","Inspect content and dates",{"_3550":2550,"_30605":2540,"_5":30940,"_21201":57896,"_27821":57897,"_3006":57898},[],"/docs/platform/pki/quickstarts/issue-certificate#verify-the-chain","Verify the chain",{"_3550":2551,"_30605":2540,"_5":30940,"_21201":57900,"_27821":57901,"_3006":57902},[],"/docs/platform/pki/quickstarts/issue-certificate#check-that-the-key-matches","Check that the key matches",{"_3550":2552,"_30605":2540,"_5":30940,"_21201":57904,"_27821":57905,"_3006":55283},[],"/docs/platform/pki/quickstarts/issue-certificate#if-the-result-fails",{"_3550":2553,"_30605":2540,"_5":30940,"_21201":57907,"_27821":57908,"_3006":49997},[],"/docs/platform/pki/quickstarts/issue-certificate#next-step",{"_3550":2554,"_30605":2540,"_21201":57910,"_5":14582,"_27821":2540,"_3006":57911},[],"You will issue an end-entity certificate for `device-001` using browser key and CSR generation. The result is `device.crt`, `device.key` and the issuing root's public certificate, `ca.pem`.",{"_3550":2555,"_30605":2540,"_21201":57913,"_5":14582,"_27821":57866,"_3006":57914},[],"An active root CA with an available signing key and permission to issue. If one does not exist yet, follow Create your first CA.",{"_3550":2556,"_30605":2540,"_21201":57916,"_5":14582,"_27821":57866,"_3006":57917},[],"Its public certificate in `ca.pem`; this example uses the root created in the previous path.",{"_3550":2557,"_30605":2540,"_21201":57919,"_5":14582,"_27821":57866,"_3006":57920},[],"OpenSSL 3.x and a working directory with restricted access.",{"_3550":2558,"_30605":2540,"_21201":57922,"_5":14582,"_27821":57866,"_3006":57923},[],"A client identifier: here we use `device-001`.",{"_3550":2559,"_30605":2540,"_21201":57925,"_5":14582,"_27821":57866,"_3006":57926},[],"In this flow, the client's key is generated in the browser and must be downloaded when issuance finishes. If you lose it, you must generate a key and issue another certificate. The certificate inventory lets you download the public certificate, but cannot recover this key.",{"_3550":2560,"_30605":2540,"_21201":57928,"_5":14582,"_27821":57869,"_3006":57929},[],"Open the CA from the previous path, go to **Issued Certificates** and select **Issue New**.",{"_3550":2561,"_30605":2540,"_21201":57931,"_5":14582,"_27821":57873,"_3006":57932},[],"Select **Generate Key & CSR in Browser** to follow this example.",{"_3550":2562,"_30605":2540,"_21201":57934,"_5":14582,"_27821":57873,"_3006":57935},[],"If the key must be generated and kept on the destination system, use **Upload Existing CSR**, described in the authorities guide.",{"_3550":2563,"_30605":2540,"_21201":57937,"_5":14582,"_27821":57877,"_3006":57938},[],"Enter `device-001` as the `Common Name`. Add subject details required by your policy and SANs if the consumer uses them to identify the client.",{"_3550":2564,"_30605":2540,"_21201":57940,"_5":14582,"_27821":57877,"_3006":57941},[],"If you continue with manual registration, the `Device ID` will be exactly `device-001`.",{"_3550":2565,"_30605":2540,"_21201":57943,"_5":14582,"_27821":57881,"_3006":57944},[],"Choose an algorithm and size allowed by the profile; for example, ECDSA P-256 if permitted. For this client certificate, select **Digital Signature** and **Client Authentication**, and issue it as an end-entity certificate.",{"_3550":2566,"_30605":2540,"_21201":57946,"_5":14582,"_27821":57881,"_3006":57947},[],"Request, for example, 30 days of validity, always within the CA's lifetime. Review the issuance profile if the resulting content differs from the request.",{"_3550":2567,"_30605":2540,"_21201":57949,"_5":14582,"_27821":57885,"_3006":57950},[],"Confirm issuance. Save the PEM certificate as `device.crt` and the private key as `device.key` in your prepared directory.",{"_3550":2568,"_30605":2540,"_21201":57952,"_5":14582,"_27821":57889,"_3006":57953},[],"Check in **Issued Certificates** that the certificate appears active. Note its serial number and verify the downloaded material using the checks below.",{"_3550":2569,"_30605":2540,"_21201":57955,"_5":14582,"_27821":57893,"_3006":57956},[],"Check `CN=device-001`, the expected issuer, current validity, **Digital Signature** and the extended usage **TLS Web Client Authentication**. It must be an end-entity certificate: it must not declare `CA:TRUE` or enable **Certificate Sign**. If **Basic Constraints** is present, it must indicate `CA:FALSE`. If you requested SANs, check that the expected identifiers appear in the certificate.",{"_3550":2570,"_30605":2540,"_21201":57958,"_5":14582,"_27821":57897,"_3006":57959},[],"The expected result is `device.crt: OK`. This check uses your explicit root and evaluates the chain, dates and compatibility with the TLS client purpose. Also check for the expected usages and names through the inspection above.",{"_3550":2571,"_30605":2540,"_21201":57961,"_5":14582,"_27821":57897,"_3006":57962},[],"If you use an intermediate CA, the trusted root must be in `ca.pem` and you must supply the intermediates with `-untrusted intermediates.pem`. This variant is covered in the trust model.",{"_3550":2572,"_30605":2540,"_21201":57964,"_5":14582,"_27821":57897,"_3006":57965},[],"The command does not query OCSP or CRL. For revocation checks, continue with Certificate validation. See the openssl-verify reference for its options.",{"_3550":2573,"_30605":2540,"_21201":57967,"_5":14582,"_27821":57901,"_3006":57968},[],"In Bash, compare the two public-key digests:",{"_3550":2574,"_30605":2540,"_21201":57970,"_5":14582,"_27821":57901,"_3006":57971},[],"Both commands must finish successfully and show the same SHA-256 digest. If they differ, the private key does not match the selected certificate. Find the correct pair before installing it.",{"_3550":2575,"_30605":2540,"_21201":57973,"_5":14582,"_27821":57901,"_3006":57974},[],"The options used are documented in openssl-x509 and openssl-pkey.",{"_3550":2576,"_30605":2540,"_21201":57976,"_5":14582,"_27821":57905,"_3006":55367},[],{"_3550":2577,"_30605":2540,"_21201":57978,"_5":14582,"_27821":57905,"_3006":57979},[],"What to review",{"_3550":2578,"_30605":2540,"_21201":57981,"_5":14582,"_27821":57905,"_3006":57982},[],"The CA rejects issuance",{"_3550":2579,"_30605":2540,"_21201":57984,"_5":14582,"_27821":57905,"_3006":57985},[],"Permissions, CA state and key, algorithm and profile.",{"_3550":2580,"_30605":2540,"_21201":57987,"_5":14582,"_27821":57905,"_3006":57988},[],"Different subject or usages",{"_3550":2581,"_30605":2540,"_21201":57990,"_5":14582,"_27821":57905,"_3006":57991},[],"Applied profile and requested values.",{"_3550":2582,"_30605":2540,"_21201":57993,"_5":14582,"_27821":57905,"_3006":57994},[],"Issuer cannot be found",{"_3550":2583,"_30605":2540,"_21201":57996,"_5":14582,"_27821":57905,"_3006":57997},[],"Downloaded CA and required intermediate chain.",{"_3550":2584,"_30605":2540,"_21201":57999,"_5":14582,"_27821":57905,"_3006":58000},[],"Validity fails",{"_3550":2585,"_30605":2540,"_21201":58002,"_5":14582,"_27821":57905,"_3006":58003},[],"Certificate and CA dates, and the computer's clock.",{"_3550":2586,"_30605":2540,"_21201":58005,"_5":14582,"_27821":57905,"_3006":58006},[],"Public-key digests differ",{"_3550":2587,"_30605":2540,"_21201":58008,"_5":14582,"_27821":57905,"_3006":58009},[],"Certificate and key files from the same issuance.",{"_3550":2588,"_30605":2540,"_21201":58011,"_5":14582,"_27821":57905,"_3006":58012},[],"See PKI diagnostics to narrow an issuance failure.",{"_3550":2589,"_30605":2540,"_21201":58014,"_5":14582,"_27821":57908,"_3006":58015},[],"You have completed the PKI path when the certificate verifies and the key matches. Choose how to use it:",{"_3550":2590,"_30605":2540,"_21201":58017,"_5":14582,"_27821":57908,"_3006":58018},[],"Manage certificates for inspection, status and revocation.",{"_3550":2591,"_30605":2540,"_21201":58020,"_5":14582,"_27821":57908,"_3006":58021},[],"Register a device manually to associate this identity with Lamassu's inventory.",{"_3550":2592,"_30605":2540,"_21201":58023,"_5":14582,"_27821":57908,"_3006":58024},[],"Prepare EST for the device to request its next identities.",{"_3550":2593,"_30605":2540,"_21201":58026,"_5":14582,"_27821":57908,"_3006":58027},[],"Acceptance by a consumer requires configuring its trust, revocation checks and permissions granted to the identity.",{"_3550":2594,"_30605":2594,"_5":14934,"_3006":58029,"_30943":58030,"_21201":58031,"_27821":2594},"PKI getting started",[49963,51438,55589,55026],[],{"_3550":2595,"_30605":2594,"_21201":58033,"_5":14582,"_27821":2594,"_3006":58034},[],"Create a CA, issue a client certificate and check its chain and key.",{"_3550":2596,"_30605":2594,"_5":30940,"_21201":58036,"_27821":58037,"_3006":49973},[],"/docs/platform/pki/quickstarts/overview#before-you-begin",{"_3550":2597,"_30605":2594,"_5":30940,"_21201":58039,"_27821":58040,"_3006":58041},[],"/docs/platform/pki/quickstarts/overview#recommended-path","Recommended path",{"_3550":2598,"_30605":2594,"_5":30940,"_21201":58043,"_27821":58044,"_3006":55218},[],"/docs/platform/pki/quickstarts/overview#expected-result",{"_3550":2599,"_30605":2594,"_5":30940,"_21201":58046,"_27821":58047,"_3006":58048},[],"/docs/platform/pki/quickstarts/overview#continue-according-to-your-goal","Continue according to your goal",{"_3550":2600,"_30605":2594,"_21201":58050,"_5":14582,"_27821":2594,"_3006":58051},[],"This path is intended for those starting to administer PKI or needing a first X.509 client identity. It ends with three files: a root CA certificate, an end-entity certificate and the client's private key.",{"_3550":2601,"_30605":2594,"_21201":58053,"_5":14582,"_27821":58037,"_3006":58054},[],"A Lamassu instance accessible from your browser. To prepare one, see Deployment.",{"_3550":2602,"_30605":2594,"_21201":58056,"_5":14582,"_27821":58037,"_3006":58057},[],"Permission to manage keys, authorities and issuance. See Access control if an operation is blocked.",{"_3550":2603,"_30605":2594,"_21201":58059,"_5":14582,"_27821":58037,"_3006":58060},[],"An available cryptographic engine for the CA key; check the keys and engines inventory.",{"_3550":2604,"_30605":2594,"_21201":58062,"_5":14582,"_27821":58037,"_3006":58063},[],"OpenSSL 3.x on the computer where you will verify the files.",{"_3550":2605,"_30605":2594,"_21201":58065,"_5":14582,"_27821":58037,"_3006":58066},[],"A working directory with restricted access for the downloaded key.",{"_3550":2606,"_30605":2594,"_21201":58068,"_5":14582,"_27821":58040,"_3006":58069},[],"<Card title=\"1. Create your first CA\" description=\"Create an evaluation root and save its public certificate as ca.pem.\" href=\"/docs/platform/pki/quickstarts/create-certificate-authority\" />",{"_3550":2607,"_30605":2594,"_21201":58071,"_5":14582,"_27821":58040,"_3006":58072},[],"<Card title=\"2. Issue and verify a certificate\" description=\"Issue for device-001 and check content, chain and key correspondence.\" href=\"/docs/platform/pki/quickstarts/issue-certificate\" />",{"_3550":2608,"_30605":2594,"_21201":58074,"_5":14582,"_27821":58040,"_3006":58075},[],"We use `Acme Evaluation Root CA` and `device-001` as example names. If you replace them, keep the same client identifier in the steps you want to connect.",{"_3550":2609,"_30605":2594,"_21201":58077,"_5":14582,"_27821":58040,"_3006":58078},[],"The root in this path signs the end-entity certificate directly to simplify evaluation. Before designing an operational PKI, review the trust model and CA hierarchy.",{"_3550":2610,"_30605":2594,"_21201":58080,"_5":14582,"_27821":58044,"_3006":58081},[],"File or resource",{"_3550":2611,"_30605":2594,"_21201":58083,"_5":14582,"_27821":58044,"_3006":55215},[],{"_3550":2612,"_30605":2594,"_21201":58085,"_5":14582,"_27821":58044,"_3006":58086},[],"Active root CA and `ca.pem`",{"_3550":2613,"_30605":2594,"_21201":58088,"_5":14582,"_27821":58044,"_3006":58089},[],"It is a CA certificate, is currently valid and its self-signature verifies.",{"_3550":2614,"_30605":2594,"_21201":58091,"_5":14582,"_27821":58044,"_3006":58092},[],"End-entity certificate and `device.crt`",{"_3550":2615,"_30605":2594,"_21201":58094,"_5":14582,"_27821":58044,"_3006":58095},[],"It identifies `device-001`, supports client authentication and verifies against `ca.pem`.",{"_3550":2616,"_30605":2594,"_21201":58097,"_5":14582,"_27821":58044,"_3006":58098},[],"Private key `device.key`",{"_3550":2617,"_30605":2594,"_21201":58100,"_5":14582,"_27821":58044,"_3006":58101},[],"Its public key matches the one included in `device.crt`.",{"_3550":2618,"_30605":2594,"_21201":58103,"_5":14582,"_27821":58044,"_3006":58104},[],"These checks validate the issued material. Acceptance by a service also requires its trust, authorization and revocation configuration.",{"_3550":2619,"_30605":2594,"_21201":58106,"_5":14582,"_27821":58047,"_3006":58107},[],"To operate certificates, continue with Certificates and Validation.",{"_3550":2620,"_30605":2594,"_21201":58109,"_5":14582,"_27821":58047,"_3006":58110},[],"To manage a device identity in Lamassu, follow Manual registration. That path includes DMS preparation.",{"_3550":2621,"_30605":2594,"_21201":58112,"_5":14582,"_27821":58047,"_3006":58113},[],"For the device to request its certificate, prepare the DMS and EST client.",{"_3550":2622,"_30605":2622,"_5":14934,"_3006":58115,"_30943":58116,"_21201":58117,"_27821":2622},"PKI troubleshooting",[49963,51438,55589,54164],[],{"_3550":2623,"_30605":2622,"_21201":58119,"_5":14582,"_27821":2622,"_3006":58120},[],"Diagnose certificate issuance, OCSP and CRL.",{"_3550":2624,"_30605":2622,"_5":30940,"_21201":58122,"_27821":58123,"_3006":58124},[],"/docs/platform/pki/troubleshooting#issuance-fails","Issuance fails",{"_3550":2625,"_30605":2622,"_5":30940,"_21201":58126,"_27821":58127,"_3006":58128},[],"/docs/platform/pki/troubleshooting#ocsp-or-crl-do-not-reflect-a-change","OCSP or CRL do not reflect a change",{"_3550":2626,"_30605":2622,"_5":30940,"_21201":58130,"_27821":58131,"_3006":58132},[],"/docs/platform/pki/troubleshooting#the-chain-validates-but-the-connection-fails","The chain validates but the connection fails",{"_3550":2627,"_30605":2622,"_21201":58134,"_5":14582,"_27821":2622,"_3006":58135},[],"This guide helps a PKI operator locate issuance and status publication failures. Keep the Lamassu version, operation, CA, issuer, serial, time and returned error. Do not include private keys or tokens in diagnostics.",{"_3550":2628,"_30605":2622,"_21201":58137,"_5":14582,"_27821":2622,"_3006":58138},[],"For Gateway, sign-in, pods, dependencies and messaging, see Deployment troubleshooting. For device enrollment, see EST diagnostics.",{"_3550":2629,"_30605":2622,"_21201":58140,"_5":14582,"_27821":58123,"_3006":55215},[],{"_3550":2630,"_30605":2622,"_21201":58142,"_5":14582,"_27821":58123,"_3006":58143},[],"What to inspect",{"_3550":2631,"_30605":2622,"_21201":58145,"_5":14582,"_27821":58123,"_3006":49997},[],{"_3550":2632,"_30605":2622,"_21201":58147,"_5":14582,"_27821":58123,"_3006":54431},[],{"_3550":2633,"_30605":2622,"_21201":58149,"_5":14582,"_27821":58123,"_3006":58150},[],"Exists, is active and has usable dates.",{"_3550":2634,"_30605":2622,"_21201":58152,"_5":14582,"_27821":58123,"_3006":58153},[],"Authorities.",{"_3550":2635,"_30605":2622,"_21201":58155,"_5":14582,"_27821":58123,"_3006":58156},[],"Key",{"_3550":2636,"_30605":2622,"_21201":58158,"_5":14582,"_27821":58123,"_3006":58159},[],"The record has a usable private key and the engine can sign.",{"_3550":2637,"_30605":2622,"_21201":58161,"_5":14582,"_27821":58123,"_3006":58162},[],"Try **Sign / Verify** in KMS; check provider permissions and availability.",{"_3550":2638,"_30605":2622,"_21201":58164,"_5":14582,"_27821":58123,"_3006":58165},[],"CSR",{"_3550":2639,"_30605":2622,"_21201":58167,"_5":14582,"_27821":58123,"_3006":58168},[],"Correct PEM and verifiable signature.",{"_3550":2640,"_30605":2622,"_21201":58170,"_5":14582,"_27821":58123,"_3006":58171},[],"`openssl req -in request.csr -noout -verify -text`.",{"_3550":2641,"_30605":2622,"_21201":58173,"_5":14582,"_27821":58123,"_3006":58174},[],"Profile",{"_3550":2642,"_30605":2622,"_21201":58176,"_5":14582,"_27821":58123,"_3006":58177},[],"Selected source, existing ID, allowed algorithm and size.",{"_3550":2643,"_30605":2622,"_21201":58179,"_5":14582,"_27821":58123,"_3006":58180},[],"Check Profiles precedence; CA and DMS resolve differently.",{"_3550":2644,"_30605":2622,"_21201":58182,"_5":14582,"_27821":58123,"_3006":55367},[],{"_3550":2645,"_30605":2622,"_21201":58184,"_5":14582,"_27821":58123,"_3006":58185},[],"Appropriate subject, SAN, usages and dates.",{"_3550":2646,"_30605":2622,"_21201":58187,"_5":14582,"_27821":58123,"_3006":58188},[],"Compare CSR, profile and certificate; successful issuance does not establish consumer acceptance.",{"_3550":2647,"_30605":2622,"_21201":58190,"_5":14582,"_27821":58123,"_3006":58191},[],"For unexpected certificate fields, review `Honor Subject`, `Honor Key Usage`, `Honor Extended Key Usages` and `Honor Extensions`. The latter preserves SAN only, without validating entitlement to those names. Validity is not automatically clamped to CA expiration.",{"_3550":2648,"_30605":2622,"_21201":58193,"_5":14582,"_27821":58123,"_3006":58194},[],"For CA reissuance failures, check revocation and date: reissuance is not supported for a revoked or already expired CA. To change its key, use Hierarchy and rotation.",{"_3550":2649,"_30605":2622,"_21201":58196,"_5":14582,"_27821":58127,"_3006":58197},[],"Check each boundary independently:",{"_3550":2650,"_30605":2622,"_21201":58199,"_5":14582,"_27821":58127,"_3006":58200},[],"**Record:** read the correct certificate again by serial and issuer. Confirm status, reason and time; expired or permanently revoked records reject further transitions.",{"_3550":2651,"_30605":2622,"_21201":58202,"_5":14582,"_27821":58127,"_3006":58203},[],"**Endpoint:** inspect AIA and CDP. Query those URLs from the consumer’s network; an old route or incorrect issuer can explain a discrepancy.",{"_3550":2652,"_30605":2622,"_21201":58205,"_5":14582,"_27821":58127,"_3006":58206},[],"**OCSP:** save a fresh response, verify signature and timestamps, and observe status. An HTTP error for an absent serial does not mean `Good` or guarantee a signed `Unknown`.",{"_3550":2653,"_30605":2622,"_21201":58208,"_5":14582,"_27821":58127,"_3006":58209},[],"**CRL:** compare `latest_crl`, number and timestamps with the downloaded list. Check the serial in its contents. If unchanged, review `regenerate_on_revoke`, event delivery, jobs, signing and storage with the deployment operator.",{"_3550":2654,"_30605":2622,"_21201":58211,"_5":14582,"_27821":58127,"_3006":58212},[],"**Client:** check cache, policy for expired or unavailable evidence, critical IDP extension and rejection of a new connection.",{"_3550":2655,"_30605":2622,"_21201":58214,"_5":14582,"_27821":58127,"_3006":58215},[],"Reactivation from `CertificateHold` needs a new CRL for the client to stop seeing the hold. Reactivating a CA does not restore its descendant cascade; inspect every status and individual operation failure.",{"_3550":2656,"_30605":2622,"_21201":58217,"_5":14582,"_27821":58131,"_3006":58218},[],"Check expected identity, SAN, KU/EKU, matching key, presented intermediates and consumer permissions. Distinguish server TLS trust, client authentication and action authorization. Follow Validation for positive and rejection tests.",{"_3550":2657,"_30605":2622,"_21201":58220,"_5":14582,"_27821":58131,"_3006":58221},[],"When escalating a problem, provide identifiers, error and relevant public evidence, including query timestamps and version. This distinguishes issuance, publication and consumer application failures.",{"_3550":2658,"_30605":2658,"_5":14934,"_3006":58223,"_30943":58224,"_21201":58225,"_27821":2658},"Security",[49963],[],{"_3550":2659,"_30605":2658,"_21201":58227,"_5":14582,"_27821":2658,"_3006":58228},[],"How to report a security vulnerability in Lamassu privately, what to include in a report and which releases receive security fixes.",{"_3550":2660,"_30605":2658,"_5":30940,"_21201":58230,"_27821":58231,"_3006":58232},[],"/docs/security#report-a-vulnerability","Report a vulnerability",{"_3550":2661,"_30605":2658,"_5":30940,"_21201":58234,"_27821":58235,"_3006":58236},[],"/docs/security#what-to-include-in-a-report","What to include in a report",{"_3550":2662,"_30605":2658,"_5":30940,"_21201":58238,"_27821":58239,"_3006":58240},[],"/docs/security#supported-versions","Supported versions",{"_3550":2663,"_30605":2658,"_5":30940,"_21201":58242,"_27821":58243,"_3006":58244},[],"/docs/security#responsible-disclosure","Responsible disclosure",{"_3550":2664,"_30605":2658,"_21201":58246,"_5":14582,"_27821":2658,"_3006":58247},[],"Found a security vulnerability in lamassuiot, lamassu-dashboard, or lamassu-helm? This page explains how to report it privately, what to include in your report and which releases receive security fixes.",{"_3550":2665,"_30605":2658,"_21201":58249,"_5":14582,"_27821":58231,"_3006":58250},[],"Do not report security vulnerabilities through public GitHub issues, discussions, or pull requests. Public reports disclose the problem before maintainers can fix it.",{"_3550":2666,"_30605":2658,"_21201":58252,"_5":14582,"_27821":58231,"_3006":58253},[],"Instead, report privately using GitHub Security Advisories for the affected repository:",{"_3550":2667,"_30605":2658,"_21201":58255,"_5":14582,"_27821":58231,"_3006":15201},[],{"_3550":2668,"_30605":2658,"_21201":58257,"_5":14582,"_27821":58231,"_3006":15141},[],{"_3550":2669,"_30605":2658,"_21201":58259,"_5":14582,"_27821":58231,"_3006":15188},[],{"_3550":2670,"_30605":2658,"_21201":58261,"_5":14582,"_27821":58231,"_3006":58262},[],"This lets maintainers assess and address the issue before it is publicly disclosed.",{"_3550":2671,"_30605":2658,"_21201":58264,"_5":14582,"_27821":58231,"_3006":58265},[],"If private vulnerability reporting is not enabled for that repository, report the vulnerability privately to lamassuiot\\@lksnext.com before disclosing any details publicly.",{"_3550":2672,"_30605":2658,"_21201":58267,"_5":14582,"_27821":58235,"_3006":58268},[],"Describe the vulnerability, its potential impact, and steps to reproduce it using non-sensitive, redacted examples.",{"_3550":2673,"_30605":2658,"_21201":58270,"_5":14582,"_27821":58235,"_3006":58271},[],"Do not include in the report:",{"_3550":2674,"_30605":2658,"_21201":58273,"_5":14582,"_27821":58235,"_3006":58274},[],"Credentials, tokens, or private keys",{"_3550":2675,"_30605":2658,"_21201":58276,"_5":14582,"_27821":58235,"_3006":58277},[],"Customer data or customer-identifiable information",{"_3550":2676,"_30605":2658,"_21201":58279,"_5":14582,"_27821":58235,"_3006":58280},[],"Confidential architecture or internal infrastructure details",{"_3550":2677,"_30605":2658,"_21201":58282,"_5":14582,"_27821":58239,"_3006":58283},[],"Only the latest stable release receives security support. Support for a stable release ends when the next stable release is published. Older releases and pre-releases are not supported.",{"_3550":2678,"_30605":2658,"_21201":58285,"_5":14582,"_27821":58239,"_3006":58286},[],"For upgrade guidance, see Upgrades.",{"_3550":2679,"_30605":2658,"_21201":58288,"_5":14582,"_27821":58243,"_3006":58289},[],"Give maintainers reasonable time to investigate and address a reported vulnerability before any public disclosure.",{"_3550":2680,"_30605":2658,"_21201":58291,"_5":14582,"_27821":58243,"_3006":58292},[],"Avoid privacy violations, data destruction, and service disruption while researching a vulnerability.",{"_3550":2681,"_30605":2658,"_21201":58294,"_5":14582,"_27821":58243,"_3006":58295},[],"Only interact with accounts or data you own, or for which you have explicit permission.",{"_3550":2682,"_30605":2658,"_21201":58297,"_5":14582,"_27821":58243,"_3006":58298},[],"Maintainers acknowledge reports in a timely manner and keep you informed of remediation progress.",{"_3550":2683,"_30605":2658,"_21201":58300,"_5":14582,"_27821":58243,"_3006":58301},[],"This policy covers the source code, configuration, and CI/CD workflows of the lamassuiot, lamassu-dashboard, and lamassu-helm repositories.",{"_3550":2684,"_30605":2684,"_5":14934,"_3006":58303,"_30943":58304,"_21201":58306,"_27821":2684},"3.8.0 to 4.0.0",[49963,58305],"Upgrades",[],{"_3550":2685,"_30605":2684,"_21201":58308,"_5":14582,"_27821":2684,"_3006":58309},[],"What changes in the 4.0.0 architecture, which changes break a 3.8.0 deployment, how to upgrade a Helm release step by step and how to validate the result.",{"_3550":2686,"_30605":2684,"_5":30940,"_21201":58311,"_27821":58312,"_3006":58313},[],"/docs/upgrades/3-8-0-to-4-0-0#architecture-changes","Architecture changes",{"_3550":2687,"_30605":2684,"_5":30940,"_21201":58315,"_27821":58316,"_3006":58317},[],"/docs/upgrades/3-8-0-to-4-0-0#one-postgresql-database-with-schemas","One PostgreSQL database with schemas",{"_3550":2688,"_30605":2684,"_5":30940,"_21201":58319,"_27821":58320,"_3006":58321},[],"/docs/upgrades/3-8-0-to-4-0-0#authorization-moves-into-the-authz-service","Authorization moves into the authz service",{"_3550":2689,"_30605":2684,"_5":30940,"_21201":58323,"_27821":58324,"_3006":58325},[],"/docs/upgrades/3-8-0-to-4-0-0#device-events-get-their-own-store","Device events get their own store",{"_3550":2690,"_30605":2684,"_5":30940,"_21201":58327,"_27821":58328,"_3006":58329},[],"/docs/upgrades/3-8-0-to-4-0-0#a-hardened-helm-chart","A hardened Helm chart",{"_3550":2691,"_30605":2684,"_5":30940,"_21201":58331,"_27821":58332,"_3006":58333},[],"/docs/upgrades/3-8-0-to-4-0-0#what-the-upgrade-migrates-automatically","What the upgrade migrates automatically",{"_3550":2692,"_30605":2684,"_5":30940,"_21201":58335,"_27821":58336,"_3006":58337},[],"/docs/upgrades/3-8-0-to-4-0-0#breaking-changes","Breaking changes",{"_3550":2693,"_30605":2684,"_5":30940,"_21201":58339,"_27821":58340,"_3006":58341},[],"/docs/upgrades/3-8-0-to-4-0-0#helm-chart-and-values","Helm chart and values",{"_3550":2694,"_30605":2684,"_5":30940,"_21201":58343,"_27821":58344,"_3006":58345},[],"/docs/upgrades/3-8-0-to-4-0-0#release-scoped-resource-names","Release-scoped resource names",{"_3550":2695,"_30605":2684,"_5":30940,"_21201":58347,"_27821":58348,"_3006":58349},[],"/docs/upgrades/3-8-0-to-4-0-0#strict-values-validation","Strict values validation",{"_3550":2696,"_30605":2684,"_5":30940,"_21201":58351,"_27821":58352,"_3006":58353},[],"/docs/upgrades/3-8-0-to-4-0-0#required-authorization-configuration","Required authorization configuration",{"_3550":2697,"_30605":2684,"_5":30940,"_21201":58355,"_27821":58356,"_3006":58357},[],"/docs/upgrades/3-8-0-to-4-0-0#gateway-token-validation-removed","Gateway token validation removed",{"_3550":2698,"_30605":2684,"_5":30940,"_21201":58359,"_27821":58360,"_3006":58361},[],"/docs/upgrades/3-8-0-to-4-0-0#non-root-containers","Non-root containers",{"_3550":2699,"_30605":2684,"_5":30940,"_21201":58363,"_27821":58364,"_3006":58365},[],"/docs/upgrades/3-8-0-to-4-0-0#amqp-over-tls","AMQP over TLS",{"_3550":2700,"_30605":2684,"_5":30940,"_21201":58367,"_27821":58368,"_3006":58369},[],"/docs/upgrades/3-8-0-to-4-0-0#renamed-and-reshaped-values","Renamed and reshaped values",{"_3550":2701,"_30605":2684,"_5":30940,"_21201":58371,"_27821":58372,"_3006":58373},[],"/docs/upgrades/3-8-0-to-4-0-0#data-and-storage","Data and storage",{"_3550":2702,"_30605":2684,"_5":30940,"_21201":58375,"_27821":58376,"_3006":58377},[],"/docs/upgrades/3-8-0-to-4-0-0#postgresql-consolidation","PostgreSQL consolidation",{"_3550":2703,"_30605":2684,"_5":30940,"_21201":58379,"_27821":58380,"_3006":58381},[],"/docs/upgrades/3-8-0-to-4-0-0#sqlite-storage-removed","SQLite storage removed",{"_3550":2704,"_30605":2684,"_5":30940,"_21201":58383,"_27821":58384,"_3006":58385},[],"/docs/upgrades/3-8-0-to-4-0-0#legacy-ca-keys-in-the-kms","Legacy CA keys in the KMS",{"_3550":2705,"_30605":2684,"_5":30940,"_21201":58387,"_27821":58388,"_3006":58389},[],"/docs/upgrades/3-8-0-to-4-0-0#references-between-certificates-keys-and-crl-settings","References between certificates, keys and CRL settings",{"_3550":2706,"_30605":2684,"_5":30940,"_21201":58391,"_27821":58392,"_3006":58393},[],"/docs/upgrades/3-8-0-to-4-0-0#apis-and-stored-configuration","APIs and stored configuration",{"_3550":2707,"_30605":2684,"_5":30940,"_21201":58395,"_27821":58396,"_3006":58397},[],"/docs/upgrades/3-8-0-to-4-0-0#dms-webhooks","DMS webhooks",{"_3550":2708,"_30605":2684,"_5":30940,"_21201":58399,"_27821":58400,"_3006":58401},[],"/docs/upgrades/3-8-0-to-4-0-0#re-enrollment-trust-set","Re-enrollment trust set",{"_3550":2709,"_30605":2684,"_5":30940,"_21201":58403,"_27821":58404,"_3006":58405},[],"/docs/upgrades/3-8-0-to-4-0-0#independent-re-enrollment-authentication","Independent re-enrollment authentication",{"_3550":2710,"_30605":2684,"_5":30940,"_21201":58407,"_27821":58408,"_3006":58409},[],"/docs/upgrades/3-8-0-to-4-0-0#dms-update-api","DMS update API",{"_3550":2711,"_30605":2684,"_5":30940,"_21201":58411,"_27821":58412,"_3006":58413},[],"/docs/upgrades/3-8-0-to-4-0-0#certificate-type-values","Certificate type values",{"_3550":2712,"_30605":2684,"_5":30940,"_21201":58415,"_27821":58416,"_3006":58417},[],"/docs/upgrades/3-8-0-to-4-0-0#device-events","Device events",{"_3550":2713,"_30605":2684,"_5":30940,"_21201":58419,"_27821":58420,"_3006":58421},[],"/docs/upgrades/3-8-0-to-4-0-0#crl-signer-field","CRL signer field",{"_3550":2714,"_30605":2684,"_5":30940,"_21201":58423,"_27821":58424,"_3006":58425},[],"/docs/upgrades/3-8-0-to-4-0-0#crl-settings-keyed-by-ca-id","CRL settings keyed by CA ID",{"_3550":2715,"_30605":2684,"_5":30940,"_21201":58427,"_27821":58428,"_3006":58429},[],"/docs/upgrades/3-8-0-to-4-0-0#renamed-va-events","Renamed VA events",{"_3550":2716,"_30605":2684,"_5":30940,"_21201":58431,"_27821":58432,"_3006":58433},[],"/docs/upgrades/3-8-0-to-4-0-0#ca-ids-are-always-assigned-by-the-backend","CA IDs are always assigned by the backend",{"_3550":2717,"_30605":2684,"_5":30940,"_21201":58435,"_27821":58436,"_3006":58437},[],"/docs/upgrades/3-8-0-to-4-0-0#va-crl-signer","VA CRL signer",{"_3550":2718,"_30605":2684,"_5":30940,"_21201":58439,"_27821":58440,"_3006":58441},[],"/docs/upgrades/3-8-0-to-4-0-0#helm-migration-guide","Helm migration guide",{"_3550":2719,"_30605":2684,"_5":30940,"_21201":58443,"_27821":58444,"_3006":58445},[],"/docs/upgrades/3-8-0-to-4-0-0#step-1-prepare","Step 1: Prepare",{"_3550":2720,"_30605":2684,"_5":30940,"_21201":58447,"_27821":58448,"_3006":58449},[],"/docs/upgrades/3-8-0-to-4-0-0#pre-upgrade-check","Pre-upgrade check",{"_3550":2721,"_30605":2684,"_5":30940,"_21201":58451,"_27821":58452,"_3006":58453},[],"/docs/upgrades/3-8-0-to-4-0-0#step-2-update-the-values-file","Step 2: Update the values file",{"_3550":2722,"_30605":2684,"_5":30940,"_21201":58455,"_27821":58456,"_3006":58457},[],"/docs/upgrades/3-8-0-to-4-0-0#step-3-run-the-upgrade","Step 3: Run the upgrade",{"_3550":2723,"_30605":2684,"_5":30940,"_21201":58459,"_27821":58460,"_3006":58461},[],"/docs/upgrades/3-8-0-to-4-0-0#step-4-migrate-the-kms-and-va-data","Step 4: Migrate the KMS and VA data",{"_3550":2724,"_30605":2684,"_5":30940,"_21201":58463,"_27821":58464,"_3006":58465},[],"/docs/upgrades/3-8-0-to-4-0-0#step-5-remove-the-one-off-migration-values","Step 5: Remove the one-off migration values",{"_3550":2725,"_30605":2684,"_5":30940,"_21201":58467,"_27821":58468,"_3006":58469},[],"/docs/upgrades/3-8-0-to-4-0-0#deployments-without-helm","Deployments without Helm",{"_3550":2726,"_30605":2684,"_5":30940,"_21201":58471,"_27821":58472,"_3006":54164},[],"/docs/upgrades/3-8-0-to-4-0-0#troubleshooting",{"_3550":2727,"_30605":2684,"_5":30940,"_21201":58474,"_27821":58475,"_3006":58476},[],"/docs/upgrades/3-8-0-to-4-0-0#validation-checklist","Validation checklist",{"_3550":2728,"_30605":2684,"_5":30940,"_21201":58478,"_27821":58479,"_3006":58480},[],"/docs/upgrades/3-8-0-to-4-0-0#delete-the-old-volumes","Delete the old volumes",{"_3550":2729,"_30605":2684,"_21201":58482,"_5":14582,"_27821":2684,"_3006":58483},[],"Lamassu 4.0.0 is a major release. Storage consolidates into a single PostgreSQL database, a new `authz` service authorizes every request, the Helm chart is hardened, and several APIs and stored configurations change shape. Most data converts automatically during the upgrade, but some changes need operator action before, during or after it.",{"_3550":2730,"_30605":2684,"_21201":58485,"_5":14582,"_27821":2684,"_3006":58486},[],"This page is organized in four parts. Read them in order before you upgrade production:",{"_3550":2731,"_30605":2684,"_21201":58488,"_5":14582,"_27821":2684,"_3006":58489},[],"Architecture changes: what is different in 4.0.0 and what the upgrade migrates on its own.",{"_3550":2732,"_30605":2684,"_21201":58491,"_5":14582,"_27821":2684,"_3006":58492},[],"Breaking changes: every change that can break a 3.8.0 deployment, who it affects and what to do.",{"_3550":2733,"_30605":2684,"_21201":58494,"_5":14582,"_27821":2684,"_3006":58495},[],"Helm migration guide: the step-by-step procedure for a Helm-managed release.",{"_3550":2734,"_30605":2684,"_21201":58497,"_5":14582,"_27821":2684,"_3006":58498},[],"Validation checklist: how to confirm the upgrade worked before you remove the old data.",{"_3550":2735,"_30605":2684,"_21201":58500,"_5":14582,"_27821":2684,"_3006":58501},[],"The 4.0.0 release is upcoming and the backend migration steps on this page are provisional. Verify each procedure against the final release artifacts before upgrading production.",{"_3550":2736,"_30605":2684,"_21201":58503,"_5":14582,"_27821":58316,"_3006":58504},[],"3.8.0 gave each service its own database. The 4.0.0 backend connects to a single PostgreSQL database named `pki` and isolates each service in a schema: `kms`, `ca`, `va`, `devicemanager`, `dmsmanager` and `alerts`. The `authz` service keeps its principals, grants and policies in a separate `authz` database (the development monolith uses an `authz` schema inside `pki` instead), and WFX keeps its own `wfx` database.",{"_3550":2737,"_30605":2684,"_21201":58506,"_5":14582,"_27821":58316,"_3006":58507},[],"PostgreSQL is now the only storage engine. SQLite support is removed, and the `couch_db` and `dynamo_db` engines are not registered in 4.0.0.",{"_3550":2738,"_30605":2684,"_21201":58509,"_5":14582,"_27821":58320,"_3006":58510},[],"In 3.8.0 the API Gateway validated tokens: a JWT policy on every private route checked the signature and only let through tokens that carried the administrator role. Every route was open to any token that passed that check.",{"_3550":2739,"_30605":2684,"_21201":58512,"_5":14582,"_27821":58320,"_3006":58513},[],"4.0.0 removes the gateway policy. The `/api/*` routes reach the services directly, and each service authorizes every request through `authz`, which validates the token against the identity provider's JWKS endpoint and applies fine-grained, entity-level policies to CAs, certificates, devices, DMSs, KMS keys and CRL settings. There is no implicit superuser: the first administrator comes from a bootstrap principal that you configure. The access control page documents principals, policies and the first administrator.",{"_3550":2740,"_30605":2684,"_21201":58515,"_5":14582,"_27821":58324,"_3006":58516},[],"Historical device events move from the `devices.events` column to a dedicated `device_events` store with their own endpoints. The events endpoint can also stream events over Server-Sent Events (SSE); to fan events out across service instances, each Device Manager instance binds its own durable AMQP queue.",{"_3550":2741,"_30605":2684,"_21201":58518,"_5":14582,"_27821":58328,"_3006":58519},[],"Version 4.0.0 of the chart is a security-hardening release:",{"_3550":2742,"_30605":2684,"_21201":58521,"_5":14582,"_27821":58328,"_3006":58522},[],"**Release-scoped resource names.** Every chart-managed resource is named `<release>-lamassu-<component>` instead of the fixed names used in 3.8.0 (`kms`, `va`, `ca`, ...). With a release named `prod` the StatefulSets become `prod-lamassu-kms` and `prod-lamassu-va`. The `nameOverride` and `fullnameOverride` values change the prefix.",{"_3550":2743,"_30605":2684,"_21201":58524,"_5":14582,"_27821":58328,"_3006":58525},[],"**Non-root containers.** Every workload runs as the numeric user `65532:65532` with a `RuntimeDefault` seccomp profile and dropped capabilities. Pods do not mount the service-account token by default, and the chart creates a dedicated ServiceAccount.",{"_3550":2744,"_30605":2684,"_21201":58527,"_5":14582,"_27821":58328,"_3006":58528},[],"**Strict values validation.** `values.schema.json` rejects unknown keys, so leftover 3.8.0 blocks fail `helm lint` and `helm upgrade` instead of being silently ignored.",{"_3550":2745,"_30605":2684,"_21201":58530,"_5":14582,"_27821":58328,"_3006":58531},[],"**No injected scheduling rules.** The chart no longer adds pod anti-affinity or topology spread constraints on its own.",{"_3550":2746,"_30605":2684,"_21201":58533,"_5":14582,"_27821":58332,"_3006":58534},[],"Several migrations run without intervention when you upgrade a Helm release:",{"_3550":2747,"_30605":2684,"_21201":58536,"_5":14582,"_27821":58332,"_3006":58537},[],"Before any service starts, the chart's pre-install/pre-upgrade job prepares PostgreSQL. It creates the `pki`, `authz` and `wfx` databases when they do not exist, creates one schema per service inside `pki`, and imports each 3.8.0 per-service database into its schema. Each import runs as a single transaction, so a failed import leaves no partial schema and a retried job imports again. The job then runs the database migrations for every schema, migrates `authz`, preloads its policies and seeds the `services.authz.bootstrap` principals. It is idempotent and requires a PostgreSQL role allowed to create databases and schemas, as described in Install with Helm.",{"_3550":2748,"_30605":2684,"_21201":58539,"_5":14582,"_27821":58332,"_3006":58540},[],"Stored DMS configuration is rewritten to the 4.0.0 layout, and historical device events are transformed into the new store.",{"_3550":2749,"_30605":2684,"_21201":58542,"_5":14582,"_27821":58332,"_3006":58543},[],"The KMS migration removes the stale `lamassu.io/kms/binded-resources` key metadata, and the VA migration resolves each role's CRL signer (see VA CRL signer).",{"_3550":2750,"_30605":2684,"_21201":58545,"_5":14582,"_27821":58332,"_3006":58546},[],"When `migrations.caToKms.enabled` is set, a pre-upgrade hook registers legacy CA keys in the KMS.",{"_3550":2751,"_30605":2684,"_21201":58548,"_5":14582,"_27821":58332,"_3006":58549},[],"Two things never migrate on their own: the KMS and VA data on local volumes, which stays on volumes the upgraded pods no longer use, and the values file, which you update by hand. Deployments that do not use the Helm chart also have to move their database data themselves; see Deployments without Helm.",{"_3550":2752,"_30605":2684,"_21201":58551,"_5":14582,"_27821":58336,"_3006":58552},[],"Change",{"_3550":2753,"_30605":2684,"_21201":58554,"_5":14582,"_27821":58336,"_3006":58555},[],"Who is affected",{"_3550":2754,"_30605":2684,"_21201":58557,"_5":14582,"_27821":58336,"_3006":58558},[],"Severity",{"_3550":2755,"_30605":2684,"_21201":58560,"_5":14582,"_27821":58336,"_3006":57028},[],{"_3550":2756,"_30605":2684,"_21201":58562,"_5":14582,"_27821":58336,"_3006":58345},[],{"_3550":2757,"_30605":2684,"_21201":58564,"_5":14582,"_27821":58336,"_3006":58565},[],"Helm releases with a filesystem KMS engine or local VA CRL storage",{"_3550":2758,"_30605":2684,"_21201":58567,"_5":14582,"_27821":58336,"_3006":58568},[],"High: KMS and VA start on empty volumes",{"_3550":2759,"_30605":2684,"_21201":58570,"_5":14582,"_27821":58336,"_3006":58571},[],"Copy the data into the new volumes",{"_3550":2760,"_30605":2684,"_21201":58573,"_5":14582,"_27821":58336,"_3006":58349},[],{"_3550":2761,"_30605":2684,"_21201":58575,"_5":14582,"_27821":58336,"_3006":58576},[],"Every Helm release",{"_3550":2762,"_30605":2684,"_21201":58578,"_5":14582,"_27821":58336,"_3006":58579},[],"High: `helm upgrade` fails",{"_3550":2763,"_30605":2684,"_21201":58581,"_5":14582,"_27821":58336,"_3006":58582},[],"Remove or rename legacy keys",{"_3550":2764,"_30605":2684,"_21201":58584,"_5":14582,"_27821":58336,"_3006":58353},[],{"_3550":2765,"_30605":2684,"_21201":58586,"_5":14582,"_27821":58336,"_3006":58587},[],"Every deployment",{"_3550":2766,"_30605":2684,"_21201":58589,"_5":14582,"_27821":58336,"_3006":58590},[],"High: without a bootstrap principal there is no administrator",{"_3550":2767,"_30605":2684,"_21201":58592,"_5":14582,"_27821":58336,"_3006":58593},[],"Configure `services.authz`",{"_3550":2768,"_30605":2684,"_21201":58595,"_5":14582,"_27821":58336,"_3006":58357},[],{"_3550":2769,"_30605":2684,"_21201":58597,"_5":14582,"_27821":58336,"_3006":58576},[],{"_3550":2770,"_30605":2684,"_21201":58599,"_5":14582,"_27821":58336,"_3006":58600},[],"High: `helm upgrade` fails on the old keys",{"_3550":2771,"_30605":2684,"_21201":58602,"_5":14582,"_27821":58336,"_3006":58603},[],"Move JWKS and roles into `services.authz`",{"_3550":2772,"_30605":2684,"_21201":58605,"_5":14582,"_27821":58336,"_3006":58377},[],{"_3550":2773,"_30605":2684,"_21201":58607,"_5":14582,"_27821":58336,"_3006":58608},[],"3.8.0 deployments with per-service databases",{"_3550":2774,"_30605":2684,"_21201":58610,"_5":14582,"_27821":58336,"_3006":58611},[],"High: services find no data, or a migration aborts",{"_3550":2775,"_30605":2684,"_21201":58613,"_5":14582,"_27821":58336,"_3006":58614},[],"Clean duplicate CA IDs and empty `engine_id` values first; move data manually outside Helm",{"_3550":2776,"_30605":2684,"_21201":58616,"_5":14582,"_27821":58336,"_3006":58381},[],{"_3550":2777,"_30605":2684,"_21201":58618,"_5":14582,"_27821":58336,"_3006":58619},[],"Deployments on SQLite, `couch_db` or `dynamo_db`",{"_3550":2778,"_30605":2684,"_21201":58621,"_5":14582,"_27821":58336,"_3006":58622},[],"High: the backend no longer starts with them",{"_3550":2779,"_30605":2684,"_21201":58624,"_5":14582,"_27821":58336,"_3006":58625},[],"Move to PostgreSQL before upgrading",{"_3550":2780,"_30605":2684,"_21201":58627,"_5":14582,"_27821":58336,"_3006":58425},[],{"_3550":2781,"_30605":2684,"_21201":58629,"_5":14582,"_27821":58336,"_3006":58630},[],"Every deployment; API clients, custom policies and alert subscriptions are also affected",{"_3550":2782,"_30605":2684,"_21201":58632,"_5":14582,"_27821":58336,"_3006":58633},[],"High: the `/v1/roles` routes are removed and the migration is irreversible",{"_3550":2783,"_30605":2684,"_21201":58635,"_5":14582,"_27821":58336,"_3006":58636},[],"Fix the data the migration aborts on, and back up the database and the CRL bucket",{"_3550":2784,"_30605":2684,"_21201":58638,"_5":14582,"_27821":58336,"_3006":58639},[],"Webhooks with file references",{"_3550":2785,"_30605":2684,"_21201":58641,"_5":14582,"_27821":58336,"_3006":58642},[],"DMSs whose webhook mTLS certificate or key were file paths",{"_3550":2786,"_30605":2684,"_21201":58644,"_5":14582,"_27821":58336,"_3006":58645},[],"High: enrollments calling the webhook fail",{"_3550":2787,"_30605":2684,"_21201":58647,"_5":14582,"_27821":58336,"_3006":58648},[],"Re-enter certificate and key as PEM, or remove the file fields",{"_3550":2788,"_30605":2684,"_21201":58650,"_5":14582,"_27821":58336,"_3006":58361},[],{"_3550":2789,"_30605":2684,"_21201":58652,"_5":14582,"_27821":58336,"_3006":58653},[],"Releases with per-service identity overrides or mounted key material",{"_3550":2790,"_30605":2684,"_21201":58655,"_5":14582,"_27821":58336,"_3006":58656},[],"Medium: services cannot read their files",{"_3550":2791,"_30605":2684,"_21201":58658,"_5":14582,"_27821":58336,"_3006":58659},[],"Remove the overrides and fix volume ownership",{"_3550":2792,"_30605":2684,"_21201":58661,"_5":14582,"_27821":58336,"_3006":58365},[],{"_3550":2793,"_30605":2684,"_21201":58663,"_5":14582,"_27821":58336,"_3006":58664},[],"Releases that set `amqp.tls`",{"_3550":2794,"_30605":2684,"_21201":58666,"_5":14582,"_27821":58336,"_3006":58667},[],"Medium: clients connect to the wrong port",{"_3550":2795,"_30605":2684,"_21201":58669,"_5":14582,"_27821":58336,"_3006":58670},[],"Point `amqp.port` at the TLS listener, or disable TLS",{"_3550":2796,"_30605":2684,"_21201":58672,"_5":14582,"_27821":58336,"_3006":58385},[],{"_3550":2797,"_30605":2684,"_21201":58674,"_5":14582,"_27821":58336,"_3006":58675},[],"Installations whose CA keys predate the KMS",{"_3550":2798,"_30605":2684,"_21201":58677,"_5":14582,"_27821":58336,"_3006":58678},[],"Medium: CA keys stay unmanaged",{"_3550":2799,"_30605":2684,"_21201":58680,"_5":14582,"_27821":58336,"_3006":58681},[],"Run the CA-to-KMS migration",{"_3550":2800,"_30605":2684,"_21201":58683,"_5":14582,"_27821":58336,"_3006":58684},[],"Receiver certificate verification",{"_3550":2801,"_30605":2684,"_21201":58686,"_5":14582,"_27821":58336,"_3006":58687},[],"DMSs whose webhook had `validate_server_cert: false`",{"_3550":2802,"_30605":2684,"_21201":58689,"_5":14582,"_27821":58336,"_3006":58690},[],"Medium: credentials go to an unverified receiver",{"_3550":2803,"_30605":2684,"_21201":58692,"_5":14582,"_27821":58336,"_3006":58693},[],"Set `insecure_skip_verify` to `false`",{"_3550":2804,"_30605":2684,"_21201":58695,"_5":14582,"_27821":58336,"_3006":58401},[],{"_3550":2805,"_30605":2684,"_21201":58697,"_5":14582,"_27821":58336,"_3006":58698},[],"Scripts and consoles that edit DMSs through the API",{"_3550":2806,"_30605":2684,"_21201":58700,"_5":14582,"_27821":58336,"_3006":58701},[],"Medium: an old-layout edit silently empties `validation_cas`",{"_3550":2807,"_30605":2684,"_21201":58703,"_5":14582,"_27821":58336,"_3006":58704},[],"Read the DMS before editing and use the new field",{"_3550":2808,"_30605":2684,"_21201":58706,"_5":14582,"_27821":58336,"_3006":58421},[],{"_3550":2809,"_30605":2684,"_21201":58708,"_5":14582,"_27821":58336,"_3006":58709},[],"Clients that create or update CRL settings through the API",{"_3550":2810,"_30605":2684,"_21201":58711,"_5":14582,"_27821":58336,"_3006":58712},[],"Medium: requests with the old field return an error",{"_3550":2811,"_30605":2684,"_21201":58714,"_5":14582,"_27821":58336,"_3006":58715},[],"Replace `crl_options.subject_key_id_signer` with the required `crl_options.signer_serial_number`",{"_3550":2812,"_30605":2684,"_21201":58717,"_5":14582,"_27821":58336,"_3006":58429},[],{"_3550":2813,"_30605":2684,"_21201":58719,"_5":14582,"_27821":58336,"_3006":58720},[],"Alert subscriptions and consumers of the VA events",{"_3550":2814,"_30605":2684,"_21201":58722,"_5":14582,"_27821":58336,"_3006":58723},[],"Medium: subscription types are renamed automatically, their conditions are not",{"_3550":2815,"_30605":2684,"_21201":58725,"_5":14582,"_27821":58336,"_3006":58726},[],"Review conditions filtering on the old event payload or subject",{"_3550":2816,"_30605":2684,"_21201":58728,"_5":14582,"_27821":58336,"_3006":58417},[],{"_3550":2817,"_30605":2684,"_21201":58730,"_5":14582,"_27821":58336,"_3006":58731},[],"Consumers that read the device `events` field",{"_3550":2818,"_30605":2684,"_21201":58733,"_5":14582,"_27821":58336,"_3006":58734},[],"Medium: the field disappears",{"_3550":2819,"_30605":2684,"_21201":58736,"_5":14582,"_27821":58336,"_3006":58737},[],"Use the new event endpoints",{"_3550":2820,"_30605":2684,"_21201":58739,"_5":14582,"_27821":58336,"_3006":58437},[],{"_3550":2821,"_30605":2684,"_21201":58741,"_5":14582,"_27821":58336,"_3006":58742},[],"Deployments with VA roles whose signer cannot be resolved uniquely",{"_3550":2822,"_30605":2684,"_21201":58744,"_5":14582,"_27821":58336,"_3006":58745},[],"Medium: the VA migration aborts",{"_3550":2823,"_30605":2684,"_21201":58747,"_5":14582,"_27821":58336,"_3006":58748},[],"Fix the affected roles before upgrading",{"_3550":2824,"_30605":2684,"_21201":58750,"_5":14582,"_27821":58336,"_3006":58369},[],{"_3550":2825,"_30605":2684,"_21201":58752,"_5":14582,"_27821":58336,"_3006":58753},[],"Releases that override `toolbox`, `services.connectors`, ports, probes or scheduling",{"_3550":2826,"_30605":2684,"_21201":58755,"_5":14582,"_27821":58336,"_3006":58756},[],"Low to medium: validation errors or changed defaults",{"_3550":2827,"_30605":2684,"_21201":58758,"_5":14582,"_27821":58336,"_3006":58759},[],"Update the values file",{"_3550":2828,"_30605":2684,"_21201":58761,"_5":14582,"_27821":58336,"_3006":58409},[],{"_3550":2829,"_30605":2684,"_21201":58763,"_5":14582,"_27821":58336,"_3006":58764},[],"Clients that send the DMS ID in the update body",{"_3550":2830,"_30605":2684,"_21201":58766,"_5":14582,"_27821":58336,"_3006":58767},[],"Low: the ID in the URL wins",{"_3550":2831,"_30605":2684,"_21201":58769,"_5":14582,"_27821":58336,"_3006":58770},[],"Send the ID in the URL",{"_3550":2832,"_30605":2684,"_21201":58772,"_5":14582,"_27821":58336,"_3006":58433},[],{"_3550":2833,"_30605":2684,"_21201":58774,"_5":14582,"_27821":58336,"_3006":58775},[],"Clients that send an `id` when creating or importing CAs",{"_3550":2834,"_30605":2684,"_21201":58777,"_5":14582,"_27821":58336,"_3006":58778},[],"Low: the ID in the body is ignored, and the field is removed",{"_3550":2835,"_30605":2684,"_21201":58780,"_5":14582,"_27821":58336,"_3006":58781},[],"Let the backend assign the ID and use the returned one",{"_3550":2836,"_30605":2684,"_21201":58783,"_5":14582,"_27821":58336,"_3006":58413},[],{"_3550":2837,"_30605":2684,"_21201":58785,"_5":14582,"_27821":58336,"_3006":58786},[],"Consumers that match on certificate `type`",{"_3550":2838,"_30605":2684,"_21201":58788,"_5":14582,"_27821":58336,"_3006":58789},[],"Low: two values are renamed",{"_3550":2839,"_30605":2684,"_21201":58791,"_5":14582,"_27821":58336,"_3006":58792},[],"Adapt consumers",{"_3550":2840,"_30605":2684,"_21201":58794,"_5":14582,"_27821":58336,"_3006":58405},[],{"_3550":2841,"_30605":2684,"_21201":58796,"_5":14582,"_27821":58336,"_3006":58797},[],"Any DMS",{"_3550":2842,"_30605":2684,"_21201":58799,"_5":14582,"_27821":58336,"_3006":58800},[],"Low: informational",{"_3550":2843,"_30605":2684,"_21201":58802,"_5":14582,"_27821":58336,"_3006":58803},[],"Read both blocks before editing",{"_3550":2844,"_30605":2684,"_21201":58805,"_5":14582,"_27821":58344,"_3006":58806},[],"Kubernetes derives a StatefulSet's PVC name from its pod name (`<volumeClaimTemplate>-<pod-name>`). Renaming the `kms` and `va` StatefulSets means `helm upgrade` binds brand-new, empty PVCs instead of the existing ones. The KMS key material and VA CRLs are not deleted — the old PVCs are orphaned, not removed — but the upgraded pods fail with `no such file or directory` (KMS) or `code=NotFound` (VA) until you copy the data across. This affects KMS when `services.kms.cryptoEngines` uses a `filesystem` engine and VA when `services.va.fileStore.type` is `local`. Every other renamed resource is stateless and is recreated without data-loss risk.",{"_3550":2845,"_30605":2684,"_21201":58808,"_5":14582,"_27821":58344,"_3006":58809},[],"Step 4 of the migration guide copies the data.",{"_3550":2846,"_30605":2684,"_21201":58811,"_5":14582,"_27821":58348,"_3006":58812},[],"`values.schema.json` rejects unknown keys, so every block that 4.0.0 removed or renamed — `toolbox`, `auth.oidc.apiGateway`, `auth.authorization` and others — fails `helm lint` and `helm upgrade` outright. Step 2 lists every change.",{"_3550":2847,"_30605":2684,"_21201":58814,"_5":14582,"_27821":58352,"_3006":58815},[],"3.8.0 had no authorization service, so a 3.8.0 values file has nothing to migrate from: you must add the `services.authz` configuration yourself. It needs the JWKS endpoint of your identity provider, the database mappings the authorization engine uses, and a bootstrap principal that matches how your provider assigns the administrator role. Without a matching principal nobody can administer the PKI.",{"_3550":2848,"_30605":2684,"_21201":58817,"_5":14582,"_27821":58356,"_3006":58818},[],"`auth.oidc.apiGateway.jwks`, `auth.authorization.rolesClaim` and `auth.authorization.roles.admin` are removed with no compatibility aliases, and the schema rejects them. Their settings move into `services.authz`: the JWKS URL becomes `services.authz.jwkUrl`, and the role claim and administrator role become a claim rule of the bootstrap principal. `auth.oidc.frontend` is unchanged.",{"_3550":2849,"_30605":2684,"_21201":58820,"_5":14582,"_27821":58360,"_3006":58821},[],"Service images run on a distroless base as the numeric user `65532`; the `authz` image is Ubuntu with a non-root user that has the same UID. The per-service overrides `services.kms.securityContext.runAsGroup: 0` and `services.authz.securityContext.runAsUser`/`runAsGroup: 999` are removed; group access to the KMS volume and PKCS#11 socket is now handled by the pod-level `fsGroup: 65532`.",{"_3550":2850,"_30605":2684,"_21201":58823,"_5":14582,"_27821":58360,"_3006":58824},[],"3.8.0 did not pin a container identity, so existing files can carry any UID. Any volume that holds keys or CRLs must be owned by `65532:65532`, or at least readable (and, where needed, writable) by that identity.",{"_3550":2851,"_30605":2684,"_21201":58826,"_5":14582,"_27821":58364,"_3006":58827},[],"In 3.8.0 `amqp.tls` was not applied and event-bus clients always connected over plaintext. In 4.0.0 `amqp.tls: true` switches them to AMQPS. The default `amqp.port` stays `5672` and does not change when TLS is enabled, so a values file that already set `amqp.tls: true` must point `amqp.port` at the broker's TLS listener (`amqps`, commonly `5671`), or set `amqp.tls: false` to keep plaintext. Clients must also trust the broker's certificate.",{"_3550":2852,"_30605":2684,"_21201":58829,"_5":14582,"_27821":58368,"_3006":58830},[],"`toolbox` is renamed to `connectivityTest`, and the `helm test` hook uses the upstream `curlimages/curl` image pinned by digest.",{"_3550":2853,"_30605":2684,"_21201":58832,"_5":14582,"_27821":58368,"_3006":58833},[],"`services.connectors` is a map keyed by connector ID instead of a list.",{"_3550":2854,"_30605":2684,"_21201":58835,"_5":14582,"_27821":58368,"_3006":58836},[],"The `services.ui.port` default is `8085`, the unprivileged port of the rootless image.",{"_3550":2855,"_30605":2684,"_21201":58838,"_5":14582,"_27821":58368,"_3006":58839},[],"The shared `probes:` block is replaced by independent `livenessProbe`, `readinessProbe` and `startupProbe` blocks.",{"_3550":2856,"_30605":2684,"_21201":58841,"_5":14582,"_27821":58368,"_3006":58842},[],"With `tls.certManagerOptions.issuer` empty, the chart creates a release-scoped self-signed issuer, for example `lamassu-downstream-ca-selfsigned-issuer`. The legacy literal `downstream-ca-selfsigned-issuer` is still accepted and resolves to it.",{"_3550":2857,"_30605":2684,"_21201":58844,"_5":14582,"_27821":58368,"_3006":58845},[],"Anti-affinity and topology spread must be configured explicitly through `affinity` and `topologySpreadConstraints`.",{"_3550":2858,"_30605":2684,"_21201":58847,"_5":14582,"_27821":58376,"_3006":58848},[],"Every 3.8.0 per-service database must end up as a schema of `pki`, keeping its structure, indexes, constraints, data and migration history. The Helm chart does this automatically; deployments without Helm do it by hand (see Deployments without Helm).",{"_3550":2859,"_30605":2684,"_21201":58850,"_5":14582,"_27821":58376,"_3006":58851},[],"Two schema migrations abort on data that 3.8.0 allowed, so clean the data before upgrading:",{"_3550":2860,"_30605":2684,"_21201":58853,"_5":14582,"_27821":58376,"_3006":58854},[],"The CA migration adds a UNIQUE constraint on `ca_certificates.id` and aborts if duplicate CA IDs exist. Imports already reject duplicates with `409`, so new ones cannot normally appear.",{"_3550":2861,"_30605":2684,"_21201":58856,"_5":14582,"_27821":58376,"_3006":58857},[],"The KMS migration promotes the primary key to `(key_id, engine_id)` and aborts with `cannot promote (key_id, engine_id) to primary key: N row(s) have no engine_id; backfill them before migrating` when `kms_keys` rows lack `engine_id`. Backfill `engine_id` first.",{"_3550":2862,"_30605":2684,"_21201":58859,"_5":14582,"_27821":58376,"_3006":58860},[],"The same KMS migration deletes, with a `NOTICE`, aliases that equal an existing key ID, because identifiers now resolve as a key ID before an alias. Affected aliases are dropped, not redirected.",{"_3550":2863,"_30605":2684,"_21201":58862,"_5":14582,"_27821":58380,"_3006":58863},[],"The SQLite storage engine is removed, and the `couch_db` and `dynamo_db` engines are not registered in 4.0.0: their configuration constants remain, but they select no engine. Deployments on any of them must move to PostgreSQL and consolidate their data into the `pki` schemas before upgrading.",{"_3550":2864,"_30605":2684,"_21201":58865,"_5":14582,"_27821":58384,"_3006":58866},[],"CA certificates of type `MANAGED` or `IMPORTED_WITH_KEY` whose private keys predate the KMS service have the key stored only in the crypto engine, under the certificate's `subject_key_id`, with no KMS record. The `ca-to-kms-migration` tool registers them:",{"_3550":2865,"_30605":2684,"_21201":58868,"_5":14582,"_27821":58384,"_3006":58869},[],"The `key_id` is the certificate's `subject_key_id`; it matches the SHA-256 digest of the public key only when the SKI was computed that way.",{"_3550":2866,"_30605":2684,"_21201":58871,"_5":14582,"_27821":58384,"_3006":58872},[],"The tool is idempotent: keys already in the KMS are skipped, so it can be run several times.",{"_3550":2867,"_30605":2684,"_21201":58874,"_5":14582,"_27821":58384,"_3006":58875},[],"Certificates that cannot be read, or lack an engine or a subject key ID, are skipped with a warning. Review the logs and resolve the affected records.",{"_3550":2868,"_30605":2684,"_21201":58877,"_5":14582,"_27821":58384,"_3006":58878},[],"When CA certificates sharing a `subject_key_id` declare conflicting `engine_id`s, the tool fails that key and exits with code `1`, which fails a Helm pre-upgrade hook. Resolve the conflict manually before rerunning.",{"_3550":2869,"_30605":2684,"_21201":58880,"_5":14582,"_27821":58384,"_3006":58881},[],"Once the keys are registered, certificates reference them in the database and the KMS refuses to delete a key that a certificate still uses (`409` `key is in use`). Deleting a certificate record removes it from the CRL and OCSP, so read Before deleting a key before freeing a key.",{"_3550":2870,"_30605":2684,"_21201":58883,"_5":14582,"_27821":58384,"_3006":58884},[],"Optionally, installations with imported CAs from before 3.7 can start the KMS once with `crypto_engines.migrate_keys_format: true`: the KMS renames those SKI-named legacy keys to the SHA-256 digest of their public key (the old name is kept as an alias, and the certificate references follow automatically). Run it once and disable the option again; running it again is safe.",{"_3550":2871,"_30605":2684,"_21201":58886,"_5":14582,"_27821":58384,"_3006":58887},[],"With Helm, enable the hook for the upgrade in step 2; without Helm, run the tool by hand.",{"_3550":2872,"_30605":2684,"_21201":58889,"_5":14582,"_27821":58388,"_3006":58890},[],"Certificates now reference their KMS key, and CRL settings reference their signer certificate, so a key or certificate in use cannot be deleted. The KMS migration drops the legacy `lamassu.io/kms/binded-resources` key metadata. Before 4.0.0, deleting a CA could remove its key while leaving key references in its retained certificate records. The CA migration registers those missing keys in the KMS with only their public key to satisfy the retained references. These entries cannot be deleted while the retained certificates reference them; they do not restore the private key. In 4.0.0, deleting a CA releases the references from its own current certificate and linked reissued certificates before attempting to delete the key; other certificates that still reference it prevent deletion.",{"_3550":2873,"_30605":2684,"_21201":58892,"_5":14582,"_27821":58396,"_3006":58893},[],"Stored webhook configs are rewritten to the current layout and their fields renamed:",{"_3550":2874,"_30605":2684,"_21201":58895,"_5":14582,"_27821":58396,"_3006":58896},[],"Field in 3.8.0",{"_3550":2875,"_30605":2684,"_21201":58898,"_5":14582,"_27821":58396,"_3006":58899},[],"Field in 4.0.0",{"_3550":2876,"_30605":2684,"_21201":58901,"_5":14582,"_27821":58396,"_3006":58902},[],"`validate_server_cert`",{"_3550":2877,"_30605":2684,"_21201":58904,"_5":14582,"_27821":58396,"_3006":58905},[],"`insecure_skip_verify` (value negated)",{"_3550":2878,"_30605":2684,"_21201":58907,"_5":14582,"_27821":58396,"_3006":58908},[],"`oidc`",{"_3550":2879,"_30605":2684,"_21201":58910,"_5":14582,"_27821":58396,"_3006":58911},[],"`jwt_options`",{"_3550":2880,"_30605":2684,"_21201":58913,"_5":14582,"_27821":58396,"_3006":58914},[],"`apikey`",{"_3550":2881,"_30605":2684,"_21201":58916,"_5":14582,"_27821":58396,"_3006":58917},[],"`apikey_options`",{"_3550":2882,"_30605":2684,"_21201":58919,"_5":14582,"_27821":58396,"_3006":58920},[],"`mtls`",{"_3550":2883,"_30605":2684,"_21201":58922,"_5":14582,"_27821":58396,"_3006":58923},[],"`mtls_options`",{"_3550":2884,"_30605":2684,"_21201":58925,"_5":14582,"_27821":58396,"_3006":58926},[],"When the legacy mTLS certificate and key are both PEM, they move into `mtls_options.cert_content` and `mtls_options.key_content` and need no action. Two cases do need it.",{"_3550":2885,"_30605":2684,"_21201":58928,"_5":14582,"_27821":58396,"_3006":58929},[],"**Webhooks with file references.** A mixed config, with a PEM certificate and a file-path key, is migrated to `mtls_options.cert_file` and `mtls_options.key_file`. Webhook delivery rejects those fields on every call, whatever the configured authentication mode, so every enroll and re-enroll that calls that webhook fails until the config is fixed. If the webhook uses mTLS, re-enter the certificate and key as Base64-encoded or plain PEM; if it does not, remove the leftover file fields. Metadata-only updates keep working in the meantime (`PUT` or `PATCH` on `/v1/dms/:id/metadata`). In a variant of the same problem, a stored config with file paths inside `mtls_options.cert_content` or `mtls_options.key_content` makes every full settings update (`POST /v1/dms` or `PUT /v1/dms/:id`) fail validation; settings are replaced wholesale, so resend the config with the certificate and key as PEM.",{"_3550":2886,"_30605":2684,"_21201":58931,"_5":14582,"_27821":58396,"_3006":58932},[],"**Receiver certificate verification.** A config with `validate_server_cert: false` becomes `insecure_skip_verify: true`, so receiver verification stays skipped until that field is set to `false`. Correct it on every migrated config: the webhook authorization channel carries the API key or bearer token, and skipping verification exposes those credentials to a network-positioned attacker. Keep `insecure_skip_verify: true` only when the receiver certificate is deliberately unverifiable.",{"_3550":2887,"_30605":2684,"_21201":58934,"_5":14582,"_27821":58400,"_3006":58935},[],"The flat field `reenrollment_settings.additional_validation_cas` moves into the nested field `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`:",{"_3550":2888,"_30605":2684,"_21201":58937,"_5":14582,"_27821":58400,"_3006":58938},[],"The effective trust set does not change, because the nested value was never consulted when validating re-enrollments. If the flat list was missing or null, it becomes an empty list.",{"_3550":2889,"_30605":2684,"_21201":58940,"_5":14582,"_27821":58400,"_3006":58941},[],"What changes is how API requests are handled. Bodies that still carry `additional_validation_cas` are accepted, but the value is silently dropped because unknown JSON fields are ignored, and GET responses no longer include it. An update body built from the old layout therefore empties `validation_cas` without any error. Always read the DMS before sending an edit and reuse the layout the API returns.",{"_3550":2890,"_30605":2684,"_21201":58943,"_5":14582,"_27821":58404,"_3006":58944},[],"Re-enrollment authentication settings are now stored independently from initial authentication. Nothing needs migrating, but read both blocks before editing a DMS so that you do not modify one while believing you are editing the other. The console exposes independent editors for both blocks; the DMS guide describes their fields, and you can also edit them through the DMS API.",{"_3550":2891,"_30605":2684,"_21201":58946,"_5":14582,"_27821":58408,"_3006":58947},[],"`PUT /v1/dms/:id` takes the DMS ID from the URL and validates the request body. An ID in the body is ignored, so update clients that relied on it.",{"_3550":2892,"_30605":2684,"_21201":58949,"_5":14582,"_27821":58412,"_3006":58950},[],"Stored certificate type values are renamed: `IMPORTED` becomes `IMPORTED_WITH_KEY` and `EXTERNAL` becomes `IMPORTED_WITHOUT_KEY`. `MANAGED` is unchanged. Adapt consumers that read or match on those values.",{"_3550":2893,"_30605":2684,"_21201":58952,"_5":14582,"_27821":58416,"_3006":58953},[],"The `events` field no longer appears in the device representation. Point consumers at the new endpoints:",{"_3550":2894,"_30605":2684,"_21201":58955,"_5":14582,"_27821":58416,"_3006":58956},[],"`GET /v1/devices/:id/events` returns a device's events.",{"_3550":2895,"_30605":2684,"_21201":58958,"_5":14582,"_27821":58416,"_3006":58959},[],"`POST /v1/devices/:id/events` creates an event.",{"_3550":2896,"_30605":2684,"_21201":58961,"_5":14582,"_27821":58416,"_3006":58962},[],"When the request `Accept` header includes `text/event-stream`, the events endpoint streams over SSE with a keepalive every 15 seconds, and returns `501` when SSE is disabled in the deployment. Each Device Manager instance binds a durable AMQP queue named after its service ID, `device-manager-sse-<uuid>`. Queues from crashed or replaced instances linger until removed, so configure an expiration or cleanup policy on the broker.",{"_3550":2897,"_30605":2684,"_21201":58964,"_5":14582,"_27821":58420,"_3006":58965},[],"`crl_options.subject_key_id_signer` is replaced by the required `crl_options.signer_serial_number`, the serial number of the existing certificate that signs the CRL. A new CA's initial value is the serial number of its current certificate. Requests that still carry `subject_key_id_signer` return an error. The authorization entity that holds these settings is also renamed; see CRL settings keyed by CA ID.",{"_3550":2898,"_30605":2684,"_21201":58967,"_5":14582,"_27821":58424,"_3006":58968},[],"In 3.8.0 the VA keyed each CRL by the CA's SKI, and `GET`/`PUT /v1/roles/{ca-ski}` read and updated it. In 4.0.0 the CRL settings of a CA are keyed by its CA ID, and every CA has its own, even when two CAs share a key:",{"_3550":2899,"_30605":2684,"_21201":58970,"_5":14582,"_27821":58424,"_3006":58971},[],"Route",{"_3550":2900,"_30605":2684,"_21201":58973,"_5":14582,"_27821":58424,"_3006":53351},[],{"_3550":2901,"_30605":2684,"_21201":58975,"_5":14582,"_27821":58424,"_3006":58976},[],"`GET /v1/crl-settings`",{"_3550":2902,"_30605":2684,"_21201":58978,"_5":14582,"_27821":58424,"_3006":58979},[],"Lists the CRL settings; filterable at least by `ca_id`, `status` and `legacy_ski`.",{"_3550":2903,"_30605":2684,"_21201":58981,"_5":14582,"_27821":58424,"_3006":58982},[],"`GET /v1/crl-settings/{ca-id}`",{"_3550":2904,"_30605":2684,"_21201":58984,"_5":14582,"_27821":58424,"_3006":58985},[],"Reads the settings of a CA.",{"_3550":2905,"_30605":2684,"_21201":58987,"_5":14582,"_27821":58424,"_3006":58988},[],"`PUT /v1/crl-settings/{ca-id}`",{"_3550":2906,"_30605":2684,"_21201":58990,"_5":14582,"_27821":58424,"_3006":58991},[],"Replaces `crl_options`.",{"_3550":2907,"_30605":2684,"_21201":58993,"_5":14582,"_27821":58424,"_3006":58994},[],"`DELETE /v1/crl-settings/{ca-id}`",{"_3550":2908,"_30605":2684,"_21201":58996,"_5":14582,"_27821":58424,"_3006":58997},[],"Removes the archived settings of a CA.",{"_3550":2909,"_30605":2684,"_21201":58999,"_5":14582,"_27821":58424,"_3006":59000},[],"The options keep their meaning and their defaults: 7 days of `validity`, 6 days and 23 hours of `refresh_interval`, and `regenerate_on_revoke` `true`. `status` (`ACTIVE`, `FINAL` or `ARCHIVED`), `legacy_ski` and `latest_crl` are read-only. A `PUT` validates the signer only when it changes, does not regenerate the CRL, and returns `409` when the settings are not `ACTIVE`.",{"_3550":2910,"_30605":2684,"_21201":59002,"_5":14582,"_27821":58424,"_3006":59003},[],"The public endpoint `GET /crl/{id}` takes the CA ID — the form the CDPs of newly issued certificates use — and keeps resolving the SKI form of certificates issued before the upgrade. Certificates issued before the upgrade keep their `/crl/<ski>` distribution points; newly issued ones carry `/crl/<ca-id>`, and both resolve to the same settings. The VA scheduled CRL job requests a new list on its first run, and the new list includes both URLs in its *Issuing Distribution Point*. Until it succeeds, the old list has only the legacy `/crl/<ski>` IDP: verifiers that compare it with the CDP of newly issued certificates cannot validate those certificates. The default schedule can delay the first run by up to about an hour; failures can extend the window.",{"_3550":2911,"_30605":2684,"_21201":59005,"_5":14582,"_27821":58424,"_3006":59006},[],"The migration that turns VA roles into CRL settings cannot be rolled back: its rollback does nothing. CRLs generated after the upgrade are stored under the CA ID, where 3.8.0 does not look for them, and the archived settings of CAs deleted before the upgrade have no signer to go back to. Returning to 3.8.0 requires restoring both the database and the CRL bucket — the object storage that holds the published lists — from the backups taken before the upgrade.",{"_3550":2912,"_30605":2684,"_21201":59008,"_5":14582,"_27821":58424,"_3006":59009},[],"The migration aborts, and the upgrade fails, on five kinds of data:",{"_3550":2913,"_30605":2684,"_21201":59011,"_5":14582,"_27821":58424,"_3006":59012},[],"CA IDs containing `/`: they cannot be used in CRL URLs. Recreate those CAs with a different ID.",{"_3550":2914,"_30605":2684,"_21201":59014,"_5":14582,"_27821":58424,"_3006":59015},[],"An SKI shared by more than one CA: the error names the SKIs and asks you to recreate all but one of them on a different key.",{"_3550":2915,"_30605":2684,"_21201":59017,"_5":14582,"_27821":58424,"_3006":59018},[],"A VA role whose signer certificate has no key: point the role to a signer with a key, or fix the key reference of the certificate, before upgrading.",{"_3550":2916,"_30605":2684,"_21201":59020,"_5":14582,"_27821":58424,"_3006":59021},[],"A CA whose ID equals the `legacy-<ski>` ID the migration reserves for the archived settings of another role whose CA was deleted: recreate that CA with a different ID.",{"_3550":2917,"_30605":2684,"_21201":59023,"_5":14582,"_27821":58424,"_3006":59024},[],"A CA ID equal to the SKI of another VA role: their CRL URLs would be ambiguous.",{"_3550":2918,"_30605":2684,"_21201":59026,"_5":14582,"_27821":58424,"_3006":59027},[],"The settings of a CA deleted before the upgrade are migrated as `ARCHIVED`, with a `legacy-<ski>` ID and no signer: their last CRL is still served, but never regenerated, and `PUT` returns `409`. There is no API way back to `ACTIVE`. The CRL guide describes the full behavior.",{"_3550":2919,"_30605":2684,"_21201":59029,"_5":14582,"_27821":58424,"_3006":59030},[],"**Custom authorization policies.** The entity `va_role` is renamed to `crl_settings`, with `ca_id` as its primary key and `signer_serial_number` as its relation to certificates. Update policies referencing the old entity. The entity gains the `delete` atomic action, a `signer_key_id` relation to KMS keys, and the filterable columns `signer_engine_id` and `signer_key_id`; grant the new action to whoever may delete archived CRL settings. Replace the 3.8.0 signer filter `crl_subject_key_id_signer` (or `crl_signer_certificate_serial_number` if used by an intermediate version) with `signer_serial_number`. Replace SKI filter values with the corresponding certificate serial numbers; renaming the filter alone is insufficient.",{"_3550":2920,"_30605":2684,"_21201":59032,"_5":14582,"_27821":58428,"_3006":59033},[],"`va.role.update` becomes `va.crl-settings.update` and `va.role.crl.init` becomes `va.crl-settings.init`; `va.role.crl.create` keeps its name and its payload. Every subject changes from `crl/<ski>` to `crl/<ca-id>`, and the payload of the renamed events changes from the old VA role to the CRL settings of the CA, with `ca_id` instead of `ca_ski`. The alerts migration renames the event types of existing subscriptions automatically, but it does not rewrite their conditions — JSON Path, JSON Schema or JavaScript: review conditions that filter on the old payload or on the old `crl/<ski>` subject, including those for `va.role.crl.create`. Direct event-bus consumers and audit searches must adopt the new names and payload themselves.",{"_3550":2921,"_30605":2684,"_21201":59035,"_5":14582,"_27821":58432,"_3006":59036},[],"Creating or importing a CA registers it under a backend-generated UUID. Any `id` sent in the request body is ignored, and the field is removed from the create and import bodies. Scripts that supplied their own IDs and addressed CAs by them must read the ID the backend returns instead.",{"_3550":2922,"_30605":2684,"_21201":59038,"_5":14582,"_27821":58436,"_3006":59039},[],"The VA migration resolves each role's signer from its stored SKI. It first looks for CA certificates with that SKI; if several match, it selects the oldest CA and logs a warning. If no CA certificate matches, it looks among all certificates with that SKI. The migration aborts with `cannot resolve signer certificate for VA role <ca-ski>, SKI <ski>` if that fallback finds zero or multiple candidates. Fix affected roles before upgrading.",{"_3550":2923,"_30605":2684,"_21201":59041,"_5":14582,"_27821":58440,"_3006":59042},[],"The upgrade runs in a fixed order: prepare the data and values, run `helm upgrade`, then copy the KMS and VA data into the new volumes. The copy must run after the upgrade, because the destination StatefulSets and PVCs do not exist before it. If you are not upgrading an existing release, go straight to Install with Helm.",{"_3550":2924,"_30605":2684,"_21201":59044,"_5":14582,"_27821":58444,"_3006":59045},[],"Take a verifiable backup of PostgreSQL and of the CRL object storage — the VA bucket, or the local volume that holds the CRLs — and schedule downtime. The upgrade moves every service's data into `pki`, and the VA migration is irreversible: returning to 3.8.0 needs both backups (see CRL settings keyed by CA ID).",{"_3550":2925,"_30605":2684,"_21201":59047,"_5":14582,"_27821":58444,"_3006":59048},[],"If the deployment runs on SQLite, `couch_db` or `dynamo_db`, move it to PostgreSQL first.",{"_3550":2926,"_30605":2684,"_21201":59050,"_5":14582,"_27821":58444,"_3006":59051},[],"Resolve duplicate CA IDs and backfill `engine_id` in `kms_keys`, as described in PostgreSQL consolidation.",{"_3550":2927,"_30605":2684,"_21201":59053,"_5":14582,"_27821":58444,"_3006":59054},[],"Optionally, run the pre-upgrade check against the consolidated 3.8.0 data before applying the migrations.",{"_3550":2928,"_30605":2684,"_21201":59056,"_5":14582,"_27821":58444,"_3006":59057},[],"Record the names of your local-storage PVCs:",{"_3550":2929,"_30605":2684,"_21201":59059,"_5":14582,"_27821":58444,"_3006":59060},[],"`helm upgrade` does not touch or delete the old PVCs, but nothing references them after the upgrade. You need their names to copy the data and to clean up later.",{"_3550":2930,"_30605":2684,"_21201":59062,"_5":14582,"_27821":58448,"_3006":59063},[],"The 4.0.0 database migrations refuse data they cannot migrate safely: they abort and name the offending objects. The `upgrade-check` tool reports all of those problems before the upgrade, in one run, with the same wording the migration would use. It is read-only: it never writes database rows or keys.",{"_3550":2931,"_30605":2684,"_21201":59065,"_5":14582,"_27821":58448,"_3006":59066},[],"Image: `ghcr.io/lamassuiot/lamassu-upgrade-check`. Configure it with a KMS-style YAML file passed through `LAMASSU_CONFIG_FILE`; only the `postgres` storage provider is supported.",{"_3550":2932,"_30605":2684,"_21201":59068,"_5":14582,"_27821":58448,"_3006":59069},[],"Run it on the 3.8.0 data after it has been consolidated into the `pki` schemas, and before any 4.0.0 migration runs or any 4.0.0 service starts.",{"_3550":2933,"_30605":2684,"_21201":59071,"_5":14582,"_27821":58448,"_3006":59072},[],"Exit codes: `0` means no problems were found, `1` means at least one problem was found, and `2` means the command could not run (bad configuration, unreachable database, or a database that is not a 3.8.0 one), or a check could not run.",{"_3550":2934,"_30605":2684,"_21201":59074,"_5":14582,"_27821":58448,"_3006":59075},[],"It covers the VA migrations only: an all-clear does not prove that the CA and KMS migration guards pass, so it does not replace the duplicate CA ID and `engine_id` checks described in PostgreSQL consolidation.",{"_3550":2935,"_30605":2684,"_21201":59077,"_5":14582,"_27821":58452,"_3006":59078},[],"**Add `services.authz`.** Configure the JWKS endpoint, the database mappings and the bootstrap principal:",{"_3550":2936,"_30605":2684,"_21201":59080,"_5":14582,"_27821":58452,"_3006":59081},[],"`jwkUrl` is fetched from the `authz` pod, not from the gateway, so a Service in the release namespace can be referenced by its short name. The default points at a Keycloak Service named `auth-keycloak`; set it explicitly if your identity provider lives anywhere else.",{"_3550":2937,"_30605":2684,"_21201":59083,"_5":14582,"_27821":58452,"_3006":59084},[],"`authz` is the authorization service's own storage for principals, grants and policies. `pki` is the database the authorization engine queries when it evaluates policies against entities. Only the `database` field of each entry is read; the connection always uses the global `postgres.hostname`, `postgres.port`, `postgres.username` and `postgres.password` values.",{"_3550":2938,"_30605":2684,"_21201":59086,"_5":14582,"_27821":58452,"_3006":59087},[],"If you kept the 3.8.0 role defaults (`realm_access.roles` and `pki-admin`), the default `services.authz.bootstrap` already matches them.",{"_3550":2939,"_30605":2684,"_21201":59089,"_5":14582,"_27821":58452,"_3006":59090},[],"**Delete the gateway token validation blocks.** Remove `auth.oidc.apiGateway` and `auth.authorization` once their settings are in `services.authz`:",{"_3550":2940,"_30605":2684,"_21201":59092,"_5":14582,"_27821":58452,"_3006":59093},[],"**Rename `toolbox` to `connectivityTest`:**",{"_3550":2941,"_30605":2684,"_21201":59095,"_5":14582,"_27821":58452,"_3006":59096},[],"**Remove the per-service identity overrides** `services.kms.securityContext.runAsGroup` and `services.authz.securityContext.runAsUser`/`runAsGroup`.",{"_3550":2942,"_30605":2684,"_21201":59098,"_5":14582,"_27821":58452,"_3006":59099},[],"**Convert `services.connectors` to a map** keyed by connector ID, each entry with its `type` and `image`:",{"_3550":2943,"_30605":2684,"_21201":59101,"_5":14582,"_27821":58452,"_3006":59102},[],"**Check AMQP.** If you set `amqp.tls: true`, also set `amqp.port` to the broker's TLS listener (commonly `5671`), or set `amqp.tls: false` to stay on plaintext.",{"_3550":2944,"_30605":2684,"_21201":59104,"_5":14582,"_27821":58452,"_3006":59105},[],"**Enable the CA-to-KMS migration** if your CA keys predate the KMS:",{"_3550":2945,"_30605":2684,"_21201":59107,"_5":14582,"_27821":58452,"_3006":59108},[],"**Review the remaining values:** overrides that pinned `services.ui.port` to `80`, the old `probes:` block, the TLS issuer, and explicit `affinity` and `topologySpreadConstraints` where your cluster needs them. Renamed and reshaped values describes each one.",{"_3550":2946,"_30605":2684,"_21201":59110,"_5":14582,"_27821":58452,"_3006":59111},[],"Run `helm lint` with the new values before upgrading; the strict schema reports any key that is still unknown.",{"_3550":2947,"_30605":2684,"_21201":59113,"_5":14582,"_27821":58456,"_3006":59114},[],"Helm runs the pre-upgrade hooks — the CA-to-KMS migration when enabled, and the database job — before applying any workload, so services never start against an unprepared database. If validation rejects unknown values, fix the values file and re-run.",{"_3550":2948,"_30605":2684,"_21201":59116,"_5":14582,"_27821":58456,"_3006":59117},[],"If the deployment uses local KMS or VA storage, those pods fail until you complete step 4, so `--wait` cannot succeed: Helm waits for them to become ready, times out, exits with an error and marks the release `failed`. The hooks have already run by then, and every manifest, including the new StatefulSets and their PVCs, has been applied. Helm does not roll anything back without `--atomic`. Continue with step 4, then re-run the same `helm upgrade` command so it completes and Helm records the release as `deployed`. Both hooks are idempotent, so they are safe to run again.",{"_3550":2949,"_30605":2684,"_21201":59119,"_5":14582,"_27821":58460,"_3006":59120},[],"Skip this step when `services.kms.cryptoEngines` never used a `filesystem` engine and `services.va.fileStore.type` was never `local`.",{"_3550":2950,"_30605":2684,"_21201":59122,"_5":14582,"_27821":58460,"_3006":59123},[],"**Find the new StatefulSets and PVCs.** Their names depend on the release name and any `nameOverride` or `fullnameOverride`; the PVC name is `<volumeClaimTemplate>-<StatefulSet name>-0`:",{"_3550":2951,"_30605":2684,"_21201":59125,"_5":14582,"_27821":58460,"_3006":59126},[],"With release `lamassu` and the default chart name, the new PVCs are `golang-engine-storage-lamassu-kms-0` and `local-crl-file-storage-lamassu-va-0`; with release `prod` they are `golang-engine-storage-prod-lamassu-kms-0` and `local-crl-file-storage-prod-lamassu-va-0`. Confirm both old and new PVCs exist before continuing. If `claims_ok` prints `ABORT`, the block stops before listing the claims: either a StatefulSet lookup failed, or a new claim resolves to the 3.8.0 claim. In the second case the copy would verify against itself and the final cleanup would delete the live volume. The chart always appends `-kms` and `-va` to the release-scoped name, so a collision means the claims are not what this guide expects; investigate before going on. Item 3 runs the same check and refuses to create the helper pod, so nothing touches the volumes. The check returns instead of calling `exit`, which would close your shell and lose the variables set so far. If you only migrate one of the two services, drop the other one's claims from the commands that follow.",{"_3550":2952,"_30605":2684,"_21201":59128,"_5":14582,"_27821":58460,"_3006":59129},[],"**Record the replica counts, scale the new StatefulSets down and wait for every pod that uses the claims to exit**, so nothing writes to either volume while you copy. Helm removes the 3.8.0 `kms` and `va` StatefulSets during the upgrade, but their pods `kms-0` and `va-0` can still be terminating and holding the old claims. While they run, the helper pod either cannot attach the claims or copies a volume that is still being written. The `wait` returns at once for pods that are already gone:",{"_3550":2953,"_30605":2684,"_21201":59131,"_5":14582,"_27821":58460,"_3006":59132},[],"**Run a short-lived helper pod** that mounts all four claims. It runs as root so it can change file ownership, so pin its image by digest and do not mount the service-account token:",{"_3550":2954,"_30605":2684,"_21201":59134,"_5":14582,"_27821":58460,"_3006":59135},[],"**Inspect before writing** so you do not clobber data the new pods may already have written:",{"_3550":2955,"_30605":2684,"_21201":59137,"_5":14582,"_27821":58460,"_3006":59138},[],"An empty result is the common case: a StatefulSet's own pod rarely gets far enough to write anything when its dependent data is missing. If the output is not empty, record the files and confirm with the service owner that they are disposable before you run the copy; do not overlay the 3.8.0 data onto an unknown store.",{"_3550":2956,"_30605":2684,"_21201":59140,"_5":14582,"_27821":58460,"_3006":59141},[],"**Copy the data, align ownership and verify the copy.** The second command must print `copy verified`; any `diff` output means the copy is incomplete, so do not continue:",{"_3550":2957,"_30605":2684,"_21201":59143,"_5":14582,"_27821":58460,"_3006":59144},[],"The `chown` is required even if the old files already look non-root-owned, because 4.0.0 requires exactly `65532:65532` and does not fall back to whatever the image declares.",{"_3550":2958,"_30605":2684,"_21201":59146,"_5":14582,"_27821":58460,"_3006":59147},[],"**Remove the helper and restore the recorded replica counts:**",{"_3550":2959,"_30605":2684,"_21201":59149,"_5":14582,"_27821":58460,"_3006":59150},[],"**Re-run the step 3 `helm upgrade` command.** The KMS and VA pods now start against the copied data, so `--wait` succeeds and the release moves from `failed` to `deployed`.",{"_3550":2960,"_30605":2684,"_21201":59152,"_5":14582,"_27821":58464,"_3006":59153},[],"After the upgrade that performed the CA-to-KMS migration succeeds, remove `migrations.caToKms.enabled` from your values (it defaults to `false`). The hook reads the legacy 3.8.0 `kms-config` ConfigMap while it still exists and falls back to the release-scoped `<release>-lamassu-kms-config` once it is gone.",{"_3550":2961,"_30605":2684,"_21201":59155,"_5":14582,"_27821":58464,"_3006":59156},[],"Then go through the validation checklist. Keep the old PVCs until it passes.",{"_3550":2962,"_30605":2684,"_21201":59158,"_5":14582,"_27821":58468,"_3006":59159},[],"Without the chart's database job, no tool moves data between databases: the migration tooling only applies migrations to a schema that already exists. Move each per-service database into its `pki` schema yourself, preserving structure, indexes, constraints, data and migration history, with writes stopped and a verified backup in hand.",{"_3550":2963,"_30605":2684,"_21201":59161,"_5":14582,"_27821":58468,"_3006":59162},[],"Run the migrations in the required order, one schema at a time: `kms` first, then the `ca-to-kms-migration` tool (needed only for legacy deployments whose CA keys are named by SKI), then `ca`, then `va`. The `devicemanager`, `dmsmanager` and `alerts` schemas are independent and can be migrated in any order. With Helm, the chart's pre-install job applies the schemas in the correct order automatically.",{"_3550":2964,"_30605":2684,"_21201":59164,"_5":14582,"_27821":58468,"_3006":59165},[],"If `kms` has not been migrated, the `ca` migration fails with `kms schema not found: migrate the kms schema before the ca schema`. The `va` migration requires `ca` and `kms` to be migrated first: it fails with `ca schema not found: migrate the ca schema before the va schema` or `kms schema not found: migrate the kms schema before the va schema` if one of them is missing.",{"_3550":2965,"_30605":2684,"_21201":59167,"_5":14582,"_27821":58468,"_3006":59168},[],"The schemas reference each other, so the PostgreSQL role running the migrations needs cross-schema privileges: the `ca` schema needs `USAGE` on `kms` plus `SELECT`, `REFERENCES` and `INSERT` on `kms.kms_keys`, and the `va` schema needs `USAGE` on `ca` plus `SELECT` and `REFERENCES` on `ca.certificates`, `SELECT` on `ca.ca_certificates`, and `USAGE` on `kms` plus `SELECT` and `REFERENCES` on `kms.kms_keys`. Without them the migration aborts; grant the missing privileges and rerun the failed schema. After migrating `ca`, if the CA service runs as a different user than the migration user, grant it `SELECT` on `ca.certificates_view` (`GRANT SELECT ON ca.certificates_view TO service_user`). Without this grant, certificate and CA reads fail with `permission denied for table certificates_view`. After migrating `va`, if the CA service runs as a different user, grant it `USAGE` on the `va` schema and `SELECT` on `va.crl_settings` (`GRANT USAGE ON SCHEMA va TO service_user; GRANT SELECT ON va.crl_settings TO service_user`): the CA service reads `va.crl_settings` when it deletes a CA, and without these grants every deletion of a CA that has a crypto engine fails with `permission denied for schema va` (or `for table crl_settings`).",{"_3550":2966,"_30605":2684,"_21201":59170,"_5":14582,"_27821":58468,"_3006":59171},[],"To apply migrations by hand, `goose-lamassu` must run against the `pki` database with `search_path=<schema>` in the connection string. The binary validates only `search_path`, not the database name, so check `dbname=pki` before running it, and repeat for `kms`, `ca`, `va`, `devicemanager`, `dmsmanager` and `alerts`:",{"_3550":2967,"_30605":2684,"_21201":59173,"_5":14582,"_27821":58468,"_3006":59174},[],"Run `ca-to-kms-migration` first with `--dry-run`, which reports without writing to KMS storage, and then for real:",{"_3550":2968,"_30605":2684,"_21201":59176,"_5":14582,"_27821":58468,"_3006":59177},[],"Point the tool's `storage` configuration at the `pki` database, where the CA and KMS data now live in the `ca` and `kms` schemas. The tool's options are described in `backend/cmd/ca-to-kms-migration/README.md` in the `lamassuiot` repository.",{"_3550":2969,"_30605":2684,"_21201":59179,"_5":14582,"_27821":58468,"_3006":59180},[],"Both tools' READMEs document the 4.0.0 `pki` layout and match this page: `goose-lamassu` uses `dbname=pki` examples and does not validate the database name, and the `ca-to-kms-migration` README describes the single `pki` database and the migration order.",{"_3550":2970,"_30605":2684,"_21201":59182,"_5":14582,"_27821":58472,"_3006":59183},[],"**KMS or VA pods crash with `no such file or directory` or `code=NotFound` right after the upgrade.** The pods are bound to the new, empty PVCs and the data migration has not run yet, or was copied into the wrong PVC. Follow step 4 and check that all four claims exist.",{"_3550":2971,"_30605":2684,"_21201":59185,"_5":14582,"_27821":58472,"_3006":59186},[],"**`helm upgrade --wait` times out and `helm status` reports the release as `failed`.** With local KMS or VA storage this is expected on the first run: the new pods cannot become ready before their data is copied. The hooks ran and the manifests and PVCs were applied, so complete step 4 and re-run the same `helm upgrade` command. If other pods are also not ready, check their logs, because something else is wrong.",{"_3550":2972,"_30605":2684,"_21201":59188,"_5":14582,"_27821":58472,"_3006":59189},[],"**The helper pod stays `Pending` or `ContainerCreating` and `kubectl wait` times out.** Another pod still holds one of the claims; on block storage `kubectl describe pod pvc-migrate-helper` shows a `Multi-Attach error`. Check with `kubectl get pods -n $NAMESPACE` that `kms-0`, `va-0` and the new KMS and VA pods are gone, then re-run the wait.",{"_3550":2973,"_30605":2684,"_21201":59191,"_5":14582,"_27821":58472,"_3006":59192},[],"**`helm upgrade` fails with an unknown-key validation error.** Remove or rename the legacy values — typically `toolbox`, `auth.oidc.apiGateway` or `auth.authorization` — because the strict schema rejects keys it does not know.",{"_3550":2974,"_30605":2684,"_21201":59194,"_5":14582,"_27821":58472,"_3006":59195},[],"**The upgrade fails at the database job.** The PostgreSQL role cannot create databases or schemas, or a schema migration aborted: on duplicate CA IDs or missing `engine_id` values, or in the VA schema on a CA ID containing `/`, an SKI shared by more than one CA (the error asks you to recreate all but one of them on a different key), a role whose signer certificate has no key, a CA ID reserved for the archived settings of another role, or a CA ID equal to another role's SKI. The abort message names the offending objects; fix them and re-run the upgrade.",{"_3550":2975,"_30605":2684,"_21201":59197,"_5":14582,"_27821":58472,"_3006":59198},[],"**The upgrade fails at the CA-to-KMS hook.** CA certificates that share a `subject_key_id` declare conflicting `engine_id`s. Resolve the conflict and re-run.",{"_3550":2976,"_30605":2684,"_21201":59200,"_5":14582,"_27821":58472,"_3006":59201},[],"**Nobody can log in after the upgrade.** Check that `services.authz.jwkUrl` is reachable from the `authz` pod, that `services.authz.bootstrap` matches a role your OIDC provider actually assigns, and that the database job completed.",{"_3550":2977,"_30605":2684,"_21201":59203,"_5":14582,"_27821":58472,"_3006":59204},[],"**A migration aborts with `kms schema not found`.** The schemas must be migrated in order: run the `kms` schema migration before the `ca` and `va` schema migrations.",{"_3550":2978,"_30605":2684,"_21201":59206,"_5":14582,"_27821":58472,"_3006":59207},[],"**A migration aborts with `ca schema not found`.** Run the `ca` schema migration before the `va` schema migration.",{"_3550":2979,"_30605":2684,"_21201":59209,"_5":14582,"_27821":58472,"_3006":59210},[],"**The VA migration fails with `cannot resolve signer certificate for VA role ... N candidates`.** The migration cannot uniquely identify a signer certificate from the SKI stored on the role. Review the SKI and candidate certificates reported in the error; correct the pre-migration data with a verified backup and rerun the migration. The new `signer_serial_number` field is created during that migration, so it cannot be set through the VA API while the migration is failing.",{"_3550":2980,"_30605":2684,"_21201":59212,"_5":14582,"_27821":58472,"_3006":59213},[],"**A migration or service fails with `permission denied for table ...` or `permission denied for schema ...`.** The PostgreSQL role is missing the cross-schema privileges listed in Deployments without Helm; this includes `certificates_view` when the post-migration `GRANT SELECT` was skipped, and `permission denied for schema va` (or `for table crl_settings`) when deleting a CA without the `va` grants. Grant the missing privileges and re-run.",{"_3550":2981,"_30605":2684,"_21201":59215,"_5":14582,"_27821":58475,"_3006":59216},[],"After the upgrade, check in this order:",{"_3550":2982,"_30605":2684,"_21201":59218,"_5":14582,"_27821":58475,"_3006":59219},[],"**Databases.** Each service reads the `pki` database with its own schema, `authz` and `wfx` data are reachable, and the migration status is registered per schema, including the CA unique-ID and KMS composite-key migrations and the foreign-key migrations that run per schema in the required order.",{"_3550":2983,"_30605":2684,"_21201":59221,"_5":14582,"_27821":58475,"_3006":59222},[],"**KMS and VA start cleanly.** Their logs show no `no such file or directory` or `code=NotFound` errors.",{"_3550":2984,"_30605":2684,"_21201":59224,"_5":14582,"_27821":58475,"_3006":59225},[],"**Existing KMS keys work.** Issue a certificate from a CA that existed before the upgrade. None of the other checks reads a KMS key, so this is the only one that proves the key material was copied.",{"_3550":2985,"_30605":2684,"_21201":59227,"_5":14582,"_27821":58475,"_3006":59228},[],"**Existing CRLs are served.** `GET /crl/<ca-id>` on VA returns a previously issued CRL, and `GET /crl/<ca-ski>` with the legacy SKI of a certificate issued before the upgrade also resolves. The VA scheduled CRL job has issued a new list under the CA ID with both URLs in its IDP; check its logs if regeneration has not succeeded.",{"_3550":2986,"_30605":2684,"_21201":59230,"_5":14582,"_27821":58475,"_3006":59231},[],"**Renamed VA events.** Alert subscriptions to `va.role.update` and `va.role.crl.init` now subscribe to `va.crl-settings.update` and `va.crl-settings.init`, and conditions for all VA events, including `va.role.crl.create`, have been reviewed against the new payload (`ca_id` instead of `ca_ski`) and subject (`crl/<ca-id>` instead of `crl/<ski>`). Direct consumers and audit searches use the new event names.",{"_3550":2987,"_30605":2684,"_21201":59233,"_5":14582,"_27821":58475,"_3006":59234},[],"**Legacy CA keys.** If the CA-to-KMS migration ran, review its report and warnings and confirm the expected keys appear in the KMS. Migrated CA certificates now report `key_id` and `has_private_key`, which you can use to confirm the registration.",{"_3550":2988,"_30605":2684,"_21201":59236,"_5":14582,"_27821":58475,"_3006":59237},[],"**Connectivity.** `helm test \"$RELEASE\" -n $NAMESPACE --logs` passes; the hook checks the CA, DMS Manager, Device Manager and VA health endpoints and the UI response.",{"_3550":2989,"_30605":2684,"_21201":59239,"_5":14582,"_27821":58475,"_3006":59240},[],"**Authorization.** Sign in as the bootstrap principal and confirm administration works, check that an identity without permissions receives `403`, and review client and integration permissions.",{"_3550":2990,"_30605":2684,"_21201":59242,"_5":14582,"_27821":58475,"_3006":59243},[],"**AMQP.** The backend connects to the broker with the expected TLS settings, and the cleanup policy for SSE queues is in place.",{"_3550":2991,"_30605":2684,"_21201":59245,"_5":14582,"_27821":58475,"_3006":59246},[],"**Device events.** `GET /v1/devices/:id/events` returns the historical events of a device that had them.",{"_3550":2992,"_30605":2684,"_21201":59248,"_5":14582,"_27821":58475,"_3006":59249},[],"**Webhooks without file fields.** For each DMS that uses a webhook for enrollment or re-enrollment, the `config` block carries `insecure_skip_verify` and the expected option block (`apikey_options`, `jwt_options` or `mtls_options`), with the certificate and key as PEM and no `cert_file` or `key_file`.",{"_3550":2993,"_30605":2684,"_21201":59251,"_5":14582,"_27821":58475,"_3006":59252},[],"**Receiver verification.** `insecure_skip_verify` is `false`, unless the receiver certificate is intentionally unverified.",{"_3550":2994,"_30605":2684,"_21201":59254,"_5":14582,"_27821":58475,"_3006":59255},[],"**Webhook delivery.** One enroll or re-enroll through each migrated webhook completes its authorization call.",{"_3550":2995,"_30605":2684,"_21201":59257,"_5":14582,"_27821":58475,"_3006":59258},[],"**Trust set.** `est_rfc7030_settings.client_certificate_settings.validation_cas` holds the expected CAs, in particular those of the old CA during rotation overlaps.",{"_3550":2996,"_30605":2684,"_21201":59260,"_5":14582,"_27821":58475,"_3006":59261},[],"**API clients.** Scripts and consoles no longer use the old DMS layout (flat `additional_validation_cas`, or the legacy `mtls`, `apikey` and `oidc` fields), send DMS updates with the ID in the URL, and match on the new certificate `type` values.",{"_3550":2997,"_30605":2684,"_21201":59263,"_5":14582,"_27821":58479,"_3006":59264},[],"Only once every check passes, delete the orphaned 3.8.0 volumes to reclaim storage. The delete is irreversible and the old KMS volume may hold the last copy of your CA key material, so take a `VolumeSnapshot` or a backup of both old PVCs first and keep it until you are confident the upgraded deployment is healthy. These are the fixed 3.8.0 names recorded in step 1; before deleting, confirm that neither is mounted by a running pod, for example with `kubectl describe pvc -n $NAMESPACE golang-engine-storage-kms-0 local-crl-file-storage-va-0`, where `Used By` must be `<none>`:",{"_3550":2998,"_30605":2684,"_21201":59266,"_5":14582,"_27821":58479,"_3006":59267},[],"The 3.8.0 per-service databases are no longer used either. Drop them only after the same checks pass and your PostgreSQL backup is verified.",{"_3550":2999,"_30605":2684,"_21201":59269,"_5":14582,"_27821":58479,"_3006":59270},[],"<Card title=\"Install with Helm\" description=\"Prepare dependencies, configure values and install a controlled deployment.\" href=\"/docs/deployment/self-hosted/helm\" />",{"_3550":3000,"_30605":2684,"_21201":59272,"_5":14582,"_27821":58479,"_3006":59273},[],"<Card title=\"Access control\" description=\"Principals, policies and the first administrator.\" href=\"/docs/platform/administration/access-control\" />",{"_3550":3001,"_30605":2684,"_21201":59275,"_5":14582,"_27821":58479,"_3006":59276},[],"<Card title=\"Configure a DMS\" description=\"Enrollment, re-enrollment and webhook settings.\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />","sorting",{"_59279":59280,"_59281":59282,"_59283":59284,"_59285":59286,"_18377":3041,"_71248":3041},"language","english","sortableProperties",[3006,30605,5,27821],"sortablePropertiesWithTypes",{"_3006":25326,"_30605":25326,"_5":25326,"_27821":25326},"sorts",{"_3006":59287,"_30605":62278,"_5":65268,"_27821":68258},{"_4739":59288,"_59289":59290,"_5":25326},{"_14658":5219,"_15033":14514,"_15052":14080,"_29608":3376,"_15039":4457,"_20119":4074,"_14679":11155,"_14686":7744,"_29550":7625,"_29959":7636,"_29980":5136,"_29584":4577,"_34955":5041,"_29687":7652,"_30024":5031,"_34962":4882,"_34965":9028,"_34968":7786,"_34971":4075,"_30431":6183,"_34976":3175,"_34978":19439,"_30461":6305,"_15048":3294,"_34982":23892,"_34985":3262,"_34987":6319,"_30008":17484,"_30426":7775,"_30474":5083,"_34992":6192,"_34994":5253,"_34996":7111,"_29704":3106,"_34999":10668,"_35001":4689,"_35003":7181,"_35005":3731,"_35007":3220,"_29621":4446,"_35010":7793,"_35012":3400,"_29615":3417,"_30045":7971,"_35016":7329,"_35018":6662,"_35021":6493,"_29661":7102,"_35025":6414,"_29541":19468,"_35028":14515,"_29589":6345,"_35031":5402,"_35033":3407,"_35036":16929,"_15042":14129,"_35039":29826,"_35041":11317,"_35044":7108,"_35046":3319,"_35048":15091,"_35050":7790,"_35052":3743,"_20122":12659,"_35055":7440,"_35057":6058,"_29562":7629,"_30002":5313,"_35061":13479,"_35063":3257,"_35065":3329,"_30491":6680,"_35068":3714,"_35070":4686,"_35072":4910,"_30585":12231,"_30061":7185,"_35076":3130,"_35078":5845,"_29599":3102,"_35081":7563,"_35083":5944,"_35085":11776,"_30507":3299,"_29681":3602,"_29066":7166,"_35090":8719,"_35092":7714,"_35094":4462,"_29730":7089,"_35098":5231,"_29996":15988,"_35102":3340,"_35104":4402,"_35106":5777,"_35108":14626,"_35110":7731,"_35112":10444,"_29719":4270,"_29964":13245,"_35116":3814,"_35118":4157,"_35120":7088,"_35123":3461,"_35125":8574,"_35127":6714,"_35129":18253,"_35131":8895,"_35133":3189,"_35135":25946,"_35138":7190,"_35140":15989,"_35142":1599