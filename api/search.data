531":129401,"_41533":129404,"_41535":129407,"_41537":129410,"_41539":129413,"_41541":129415,"_41543":129418,"_41545":129421,"_41547":129424,"_41549":129426,"_41551":129429,"_41553":129432,"_41555":129434,"_41557":129436,"_41559":129438,"_41561":129440,"_41563":129443,"_41565":129446,"_41567":129449,"_41569":129452,"_41571":129455,"_41573":129458,"_41575":129461,"_41577":129464,"_41579":129467,"_41581":129470,"_41583":129473,"_41585":129476,"_41587":129479,"_41589":129482,"_41591":129485,"_41593":129488,"_41595":129491,"_41597":129494,"_41599":129497,"_41601":129500,"_41603":129503,"_41606":129506,"_41608":129509,"_41610":129512,"_41612":129515,"_41614":129518,"_41616":129521,"_41618":129524,"_41620":129527,"_41622":129530,"_41624":129533,"_41626":129536,"_41628":129539,"_41630":129542,"_41632":129545,"_41635":129548,"_41637":129551,"_41639":129554,"_41641":129557,"_41643":129560,"_41645":129563,"_41647":129566,"_41649":129569,"_41651":129572,"_41653":129575,"_41655":129578,"_41657":129581,"_41659":129584,"_41661":129587,"_41663":129590,"_41665":129593,"_41667":129596,"_41669":129599,"_41671":129602,"_41673":129605,"_41675":129608,"_41677":129611,"_41679":129614,"_41681":129617,"_41683":129620,"_41685":129623,"_41687":129626,"_41689":129629,"_41691":129632,"_41693":129635,"_41695":129638,"_41697":129641,"_41700":129644,"_41702":129647,"_41704":129650},{"_3697":72696,"_31245":72696,"_5":15238,"_3074":120404,"_31570":120405,"_21577":120408,"_28435":72696},"Despliega desde AWS Marketplace",[50948,120406,120407],"Despliegue","Otros modelos",[],{"_3697":72697,"_31245":72696,"_21577":120410,"_5":14884,"_28435":72696,"_3074":120411},[],"Ejecuta una instancia preconfigurada de Lamassu IoT en Amazon EC2.",{"_3697":72698,"_31245":72696,"_5":31567,"_21577":120413,"_28435":120414,"_3074":120415},[],"/docs/es/deployment/aws-marketplace#antes-de-empezar","Antes de empezar",{"_3697":72699,"_31245":72696,"_5":31567,"_21577":120417,"_28435":120418,"_3074":120419},[],"/docs/es/deployment/aws-marketplace#requisitos-de-infraestructura","Requisitos de infraestructura",{"_3697":72700,"_31245":72696,"_5":31567,"_21577":120421,"_28435":120422,"_3074":120423},[],"/docs/es/deployment/aws-marketplace#abre-la-oferta","Abre la oferta",{"_3697":72701,"_31245":72696,"_5":31567,"_21577":120425,"_28435":120426,"_3074":120427},[],"/docs/es/deployment/aws-marketplace#configura-la-instancia","Configura la instancia",{"_3697":72702,"_31245":72696,"_5":31567,"_21577":120429,"_28435":120430,"_3074":120431},[],"/docs/es/deployment/aws-marketplace#limita-el-acceso-de-red","Limita el acceso de red",{"_3697":72703,"_31245":72696,"_5":31567,"_21577":120433,"_28435":120434,"_3074":120435},[],"/docs/es/deployment/aws-marketplace#lanza-y-verifica","Lanza y verifica",{"_3697":72704,"_31245":72696,"_5":31567,"_21577":120437,"_28435":120438,"_3074":120439},[],"/docs/es/deployment/aws-marketplace#siguiente-paso","Siguiente paso",{"_3697":72705,"_31245":72696,"_21577":120441,"_5":14884,"_28435":72696,"_3074":120442},[],"La oferta de AWS Marketplace reduce la preparación inicial a una instancia EC2 dentro de tu cuenta. Tú mantienes el control de la red, el almacenamiento y la operación de la máquina.",{"_3697":72706,"_31245":72696,"_21577":120444,"_5":14884,"_28435":120414,"_3074":120445},[],"Permisos para suscribirte a productos de AWS Marketplace y lanzar instancias EC2.",{"_3697":72707,"_31245":72696,"_21577":120447,"_5":14884,"_28435":120414,"_3074":120448},[],"Una VPC y una subred desde la que puedan acceder administradores y dispositivos.",{"_3697":72708,"_31245":72696,"_21577":120450,"_5":14884,"_28435":120414,"_3074":120451},[],"Un grupo de seguridad que permita los endpoints necesarios.",{"_3697":72709,"_31245":72696,"_21577":120453,"_5":14884,"_28435":120418,"_3074":120454},[],"**Cómputo:** una instancia `t3.large` como mínimo. Utiliza `t3.xlarge` o superior cuando la carga lo requiera.",{"_3697":72710,"_31245":72696,"_21577":120456,"_5":14884,"_28435":120418,"_3074":120457},[],"**Almacenamiento:** un volumen EBS `gp3` de al menos 50 GB, ajustado al tamaño del inventario y la retención.",{"_3697":72711,"_31245":72696,"_21577":120459,"_5":14884,"_28435":120418,"_3074":120460},[],"**Red:** acceso HTTPS desde los consumidores necesarios, restringido a redes de confianza.",{"_3697":72712,"_31245":72696,"_21577":120462,"_5":14884,"_28435":120422,"_3074":120463},[],"Accede a Lamassu IoT en AWS Marketplace y revisa las condiciones antes de suscribirte.",{"_3697":72713,"_31245":72696,"_21577":120465,"_5":14884,"_28435":120426,"_3074":120466},[],"Selecciona `t3.large` o superior, asigna al menos 50 GB de almacenamiento `gp3` y elige la VPC y subred de destino.",{"_3697":72714,"_31245":72696,"_21577":120468,"_5":14884,"_28435":120430,"_3074":120469},[],"Configura el grupo de seguridad para los puertos `443`, `8443` y `9443`. Restringe los orígenes a las redes administrativas y de dispositivos que realmente necesiten conectarse.",{"_3697":72715,"_31245":72696,"_21577":120471,"_5":14884,"_28435":120434,"_3074":120472},[],"Inicia la instancia y abre la consola en `https://<ip-publica>`. Comprueba que puedes autenticarte antes de continuar.",{"_3697":72716,"_31245":72696,"_21577":120474,"_5":14884,"_28435":120438,"_3074":120475},[],"Continúa con Crea tu primera CA para validar la configuración criptográfica de la instancia.",{"_3697":72717,"_31245":72717,"_5":15238,"_3074":120477,"_31570":120478,"_21577":120479,"_28435":72717},"Despliega Lamassu",[50948,120406],[],{"_3697":72718,"_31245":72717,"_21577":120481,"_5":14884,"_28435":72717,"_3074":120482},[],"Elige el modelo operativo que encaja con tu infraestructura y requisitos de control.",{"_3697":72719,"_31245":72717,"_5":31567,"_21577":120484,"_28435":120485,"_3074":120486},[],"/docs/es/deployment/overview#elige-un-modelo","Elige un modelo",{"_3697":72720,"_31245":72717,"_5":31567,"_21577":120488,"_28435":120489,"_3074":120490},[],"/docs/es/deployment/overview#solo-quieres-evaluar-la-plataforma","¿Solo quieres evaluar la plataforma?",{"_3697":72721,"_31245":72717,"_5":31567,"_21577":120492,"_28435":120493,"_3074":120494},[],"/docs/es/deployment/overview#después-del-despliegue","Después del despliegue",{"_3697":72722,"_31245":72717,"_21577":120496,"_5":14884,"_28435":72717,"_3074":120497},[],"Puedes ejecutar Lamassu en tu propio clúster Kubernetes, desplegar una imagen preparada desde AWS Marketplace o consumir la plataforma como servicio gestionado.",{"_3697":72723,"_31245":72717,"_21577":120499,"_5":14884,"_28435":120485,"_3074":120500},[],"Modelo",{"_3697":72724,"_31245":72717,"_21577":120502,"_5":14884,"_28435":120485,"_3074":120503},[],"Recomendado para",{"_3697":72725,"_31245":72717,"_21577":120505,"_5":14884,"_28435":120485,"_3074":120506},[],"Quién opera la infraestructura",{"_3697":72726,"_31245":72717,"_21577":120508,"_5":14884,"_28435":120485,"_3074":120509},[],"Punto de partida",{"_3697":72727,"_31245":72717,"_21577":120511,"_5":14884,"_28435":120485,"_3074":51055},[],{"_3697":72728,"_31245":72717,"_21577":120513,"_5":14884,"_28435":120485,"_3074":120514},[],"Producción, entornos regulados y despliegues personalizados",{"_3697":72729,"_31245":72717,"_21577":120516,"_5":14884,"_28435":120485,"_3074":120517},[],"Tu equipo",{"_3697":72730,"_31245":72717,"_21577":120519,"_5":14884,"_28435":120485,"_3074":120520},[],"Helm o Fastlane",{"_3697":72731,"_31245":72717,"_21577":120522,"_5":14884,"_28435":120485,"_3074":51067},[],{"_3697":72732,"_31245":72717,"_21577":120524,"_5":14884,"_28435":120485,"_3074":120525},[],"Evaluación o despliegue dedicado dentro de una cuenta AWS",{"_3697":72733,"_31245":72717,"_21577":120527,"_5":14884,"_28435":120485,"_3074":120517},[],{"_3697":72734,"_31245":72717,"_21577":120529,"_5":14884,"_28435":120485,"_3074":120530},[],"Imagen preconfigurada en EC2",{"_3697":72735,"_31245":72717,"_21577":120532,"_5":14884,"_28435":120485,"_3074":51078},[],{"_3697":72736,"_31245":72717,"_21577":120534,"_5":14884,"_28435":120485,"_3074":120535},[],"Equipos que quieren utilizar la plataforma sin operarla",{"_3697":72737,"_31245":72717,"_21577":120537,"_5":14884,"_28435":120485,"_3074":51084},[],{"_3697":72738,"_31245":72717,"_21577":120539,"_5":14884,"_28435":120485,"_3074":120540},[],"Suscripción gestionada",{"_3697":72739,"_31245":72717,"_21577":120542,"_5":14884,"_28435":120485,"_3074":120543},[],"<Card title=\"Kubernetes self-managed\" description=\"Controla red, almacenamiento, claves, dependencias y ciclo de actualización.\" href=\"/docs/deployment/self-hosted/overview\" />",{"_3697":72740,"_31245":72717,"_21577":120545,"_5":14884,"_28435":120485,"_3074":120546},[],"<Card title=\"AWS Marketplace\" description=\"Lanza una instancia preconfigurada de Lamassu en AWS EC2.\" href=\"/docs/deployment/aws-marketplace\" />",{"_3697":72741,"_31245":72717,"_21577":120548,"_5":14884,"_28435":120485,"_3074":120549},[],"<Card title=\"Lamassu SaaS\" description=\"Utiliza una instancia operada y actualizada como servicio gestionado.\" href=\"/docs/deployment/saas\" />",{"_3697":72742,"_31245":72717,"_21577":120551,"_5":14884,"_28435":120489,"_3074":120552},[],"Usa Fastlane para levantar PostgreSQL, Keycloak, RabbitMQ y Lamassu en un clúster Kubernetes mediante un único flujo. Está pensado para laboratorios, demos y bootstrap; para producción, configura las dependencias y los valores Helm de forma explícita.",{"_3697":72743,"_31245":72717,"_21577":120554,"_5":14884,"_28435":120493,"_3074":120555},[],"Cuando la consola esté disponible, continúa con Crea tu primera CA. Ese quickstart verifica que el motor criptográfico y la emisión funcionan correctamente.",{"_3697":72744,"_31245":72744,"_5":15238,"_3074":120557,"_31570":120558,"_21577":120559,"_28435":72744},"Utiliza Lamassu como SaaS",[50948,120406,120407],[],{"_3697":72745,"_31245":72744,"_21577":120561,"_5":14884,"_28435":72744,"_3074":120562},[],"Consume Lamassu como servicio gestionado sin operar infraestructura propia.",{"_3697":72746,"_31245":72744,"_5":31567,"_21577":120564,"_28435":120565,"_3074":120566},[],"/docs/es/deployment/saas#qué-gestiona-el-servicio","Qué gestiona el servicio",{"_3697":72747,"_31245":72744,"_5":31567,"_21577":120568,"_28435":120569,"_3074":120570},[],"/docs/es/deployment/saas#planes","Planes",{"_3697":72748,"_31245":72744,"_5":31567,"_21577":120572,"_28435":120573,"_3074":120574},[],"/docs/es/deployment/saas#solicita-acceso","Solicita acceso",{"_3697":72749,"_31245":72744,"_21577":120576,"_5":14884,"_28435":72744,"_3074":120577},[],"Lamassu SaaS ofrece las capacidades de la plataforma en un entorno administrado. Es la opción indicada cuando tu equipo quiere centrarse en la PKI y las identidades de los dispositivos, no en mantener la infraestructura que las soporta.",{"_3697":72750,"_31245":72744,"_21577":120579,"_5":14884,"_28435":120565,"_3074":120580},[],"Disponibilidad y mantenimiento de la plataforma.",{"_3697":72751,"_31245":72744,"_21577":120582,"_5":14884,"_28435":120565,"_3074":120583},[],"Copias de seguridad automáticas.",{"_3697":72752,"_31245":72744,"_21577":120585,"_5":14884,"_28435":120565,"_3074":120586},[],"Actualizaciones de versión.",{"_3697":72753,"_31245":72744,"_21577":120588,"_5":14884,"_28435":120565,"_3074":120589},[],"Soporte técnico y SLA según el plan contratado.",{"_3697":72754,"_31245":72744,"_21577":120591,"_5":14884,"_28435":120569,"_3074":51139},[],{"_3697":72755,"_31245":72744,"_21577":120593,"_5":14884,"_28435":120569,"_3074":120594},[],"Dispositivos",{"_3697":72756,"_31245":72744,"_21577":120596,"_5":14884,"_28435":120569,"_3074":120597},[],"Soporte",{"_3697":72757,"_31245":72744,"_21577":120599,"_5":14884,"_28435":120569,"_3074":51148},[],{"_3697":72758,"_31245":72744,"_21577":120601,"_5":14884,"_28435":120569,"_3074":51151},[],{"_3697":72759,"_31245":72744,"_21577":120603,"_5":14884,"_28435":120569,"_3074":120604},[],"Hasta 1.000",{"_3697":72760,"_31245":72744,"_21577":120606,"_5":14884,"_28435":120569,"_3074":51157},[],{"_3697":72761,"_31245":72744,"_21577":120608,"_5":14884,"_28435":120569,"_3074":120609},[],"99,5 %",{"_3697":72762,"_31245":72744,"_21577":120611,"_5":14884,"_28435":120569,"_3074":51163},[],{"_3697":72763,"_31245":72744,"_21577":120613,"_5":14884,"_28435":120569,"_3074":120614},[],"Hasta 10.000",{"_3697":72764,"_31245":72744,"_21577":120616,"_5":14884,"_28435":120569,"_3074":120617},[],"Email y chat",{"_3697":72765,"_31245":72744,"_21577":120619,"_5":14884,"_28435":120569,"_3074":120620},[],"99,9 %",{"_3697":72766,"_31245":72744,"_21577":120622,"_5":14884,"_28435":120569,"_3074":51175},[],{"_3697":72767,"_31245":72744,"_21577":120624,"_5":14884,"_28435":120569,"_3074":120625},[],"Ilimitados",{"_3697":72768,"_31245":72744,"_21577":120627,"_5":14884,"_28435":120569,"_3074":120628},[],"Dedicado",{"_3697":72769,"_31245":72744,"_21577":120630,"_5":14884,"_28435":120569,"_3074":120631},[],"99,99 %",{"_3697":72770,"_31245":72744,"_21577":120633,"_5":14884,"_28435":120573,"_3074":120634},[],"Contacta con el equipo de Lamassu a través de lamassu.io para solicitar una demo o elegir un plan.",{"_3697":72771,"_31245":72744,"_21577":120636,"_5":14884,"_28435":120573,"_3074":120637},[],"Cuando recibas las credenciales de tu instancia, continúa con Primeros pasos.",{"_3697":72772,"_31245":72772,"_5":15238,"_3074":51192,"_31570":120639,"_21577":120641,"_28435":72772},[50948,120406,120640],"Kubernetes autogestionado",[],{"_3697":72773,"_31245":72772,"_21577":120643,"_5":14884,"_28435":72772,"_3074":120644},[],"Arranca un entorno completo de evaluación o laboratorio de Lamassu en un clúster Kubernetes existente.",{"_3697":72774,"_31245":72772,"_5":31567,"_21577":120646,"_28435":120647,"_3074":120648},[],"/docs/es/deployment/self-hosted/fastlane#despliega-con-fastlane","Despliega con Fastlane",{"_3697":72775,"_31245":72772,"_5":31567,"_21577":120650,"_28435":120651,"_3074":120652},[],"/docs/es/deployment/self-hosted/fastlane#qué-añade-fastlane","Qué añade Fastlane",{"_3697":72776,"_31245":72772,"_5":31567,"_21577":120654,"_28435":120655,"_3074":120656},[],"/docs/es/deployment/self-hosted/fastlane#antes-de-comenzar","Antes de comenzar",{"_3697":72777,"_31245":72772,"_5":31567,"_21577":120658,"_28435":120659,"_3074":120660},[],"/docs/es/deployment/self-hosted/fastlane#inicio-rápido","Inicio rápido",{"_3697":72778,"_31245":72772,"_5":31567,"_21577":120662,"_28435":120663,"_3074":120664},[],"/docs/es/deployment/self-hosted/fastlane#selección-de-la-dirección-del-gateway","Selección de la dirección del Gateway",{"_3697":72779,"_31245":72772,"_5":31567,"_21577":120666,"_28435":120667,"_3074":120668},[],"/docs/es/deployment/self-hosted/fastlane#opciones-de-línea-de-comandos","Opciones de línea de comandos",{"_3697":72780,"_31245":72772,"_5":31567,"_21577":120670,"_28435":120671,"_3074":120672},[],"/docs/es/deployment/self-hosted/fastlane#modo-de-desarrollo","Modo de desarrollo",{"_3697":72781,"_31245":72772,"_5":31567,"_21577":120674,"_28435":120675,"_3074":120676},[],"/docs/es/deployment/self-hosted/fastlane#qué-configura-el-script","Qué configura el script",{"_3697":72782,"_31245":72772,"_5":31567,"_21577":120678,"_28435":120679,"_3074":120680},[],"/docs/es/deployment/self-hosted/fastlane#comportamiento-tls","Comportamiento TLS",{"_3697":72783,"_31245":72772,"_5":31567,"_21577":120682,"_28435":120683,"_3074":120684},[],"/docs/es/deployment/self-hosted/fastlane#credenciales-y-archivos-generados","Credenciales y archivos generados",{"_3697":72784,"_31245":72772,"_5":31567,"_21577":120686,"_28435":120687,"_3074":120688},[],"/docs/es/deployment/self-hosted/fastlane#verifica-la-instalación","Verifica la instalación",{"_3697":72785,"_31245":72772,"_21577":120690,"_5":14884,"_28435":120647,"_3074":120691},[],"Fastlane es el camino automatizado para evaluaciones, demos, CI y pequeños clústeres de laboratorio. Instala PostgreSQL, Keycloak, RabbitMQ, Envoy Gateway y Lamassu, y los configura para trabajar juntos.",{"_3697":72786,"_31245":72772,"_21577":120693,"_5":14884,"_28435":120647,"_3074":120694},[],"Para producción, usa Helm para mantener explícitas las decisiones de base de datos, identidad, credenciales, certificados, almacenamiento y upgrades.",{"_3697":72787,"_31245":72772,"_21577":120696,"_5":14884,"_28435":120651,"_3074":120697},[],"Fastlane cubre algunas de las dependencias que el chart de aplicación deja deliberadamente fuera:",{"_3697":72788,"_31245":72772,"_21577":120699,"_5":14884,"_28435":120651,"_3074":120700},[],"Fastlane instala o configura",{"_3697":72789,"_31245":72772,"_21577":120702,"_5":14884,"_28435":120651,"_3074":120703},[],"Tú sigues proporcionando",{"_3697":72790,"_31245":72772,"_21577":120705,"_5":14884,"_28435":120651,"_3074":120706},[],"Instancias de PostgreSQL, RabbitMQ y Keycloak para evaluación",{"_3697":72791,"_31245":72772,"_21577":120708,"_5":14884,"_28435":120651,"_3074":120709},[],"El clúster Kubernetes, sus nodos y el almacenamiento persistente",{"_3697":72792,"_31245":72772,"_21577":120711,"_5":14884,"_28435":120651,"_3074":120712},[],"Envoy Gateway 1.8 y la `GatewayClass` `eg`",{"_3697":72793,"_31245":72772,"_21577":120714,"_5":14884,"_28435":120651,"_3074":120715},[],"cert-manager, accesibilidad desde la red externa, DNS y reglas de firewall/NAT",{"_3697":72794,"_31245":72772,"_21577":120717,"_5":14884,"_28435":120651,"_3074":120718},[],"Un flujo de certificado self-signed para Lamassu, credenciales de las dependencias almacenadas en Secrets de Kubernetes (mediante el External Secrets Operator) y un usuario inicial",{"_3697":72795,"_31245":72772,"_21577":120720,"_5":14884,"_28435":120651,"_3074":120721},[],"Confianza de los clientes en la CA self-signed, o un certificado de confianza pasado al script",{"_3697":72796,"_31245":72772,"_21577":120723,"_5":14884,"_28435":120651,"_3074":120724},[],"Componentes opcionales de observabilidad y HSM de laboratorio",{"_3697":72797,"_31245":72772,"_21577":120726,"_5":14884,"_28435":120651,"_3074":120727},[],"Retención de monitorización, backups, HA y un HSM/servicio de claves de producción",{"_3697":72798,"_31245":72772,"_21577":120729,"_5":14884,"_28435":120651,"_3074":120730},[],"Fastlane no convierte el stack en un servicio de producción: no crea el clúster, DNS público, reglas de firewall, backups, alta disponibilidad ni un certificado público de confianza.",{"_3697":72799,"_31245":72772,"_21577":120732,"_5":14884,"_28435":120655,"_3074":120733},[],"Necesitas:",{"_3697":72800,"_31245":72772,"_21577":120735,"_5":14884,"_28435":120655,"_3074":120736},[],"un clúster Kubernetes existente",{"_3697":72801,"_31245":72772,"_21577":120738,"_5":14884,"_28435":120655,"_3074":120739},[],"`kubectl` y Helm, o la CLI de MicroK8s",{"_3697":72802,"_31245":72772,"_21577":120741,"_5":14884,"_28435":120655,"_3074":51294},[],{"_3697":72803,"_31245":72772,"_21577":120743,"_5":14884,"_28435":120655,"_3074":24380},[],{"_3697":72804,"_31245":72772,"_21577":120745,"_5":14884,"_28435":120655,"_3074":120746},[],"`jq` solo si usas `--sample-data` o `--development`",{"_3697":72805,"_31245":72772,"_21577":120748,"_5":14884,"_28435":120655,"_3074":120749},[],"`ssh-keygen` solo si usas `--with-hsm`",{"_3697":72806,"_31245":72772,"_21577":120751,"_5":14884,"_28435":120655,"_3074":120752},[],"los puertos externos 80 y 443 libres en un host K3s de un único nodo",{"_3697":72807,"_31245":72772,"_21577":120754,"_5":14884,"_28435":120655,"_3074":120755},[],"Fastlane detecta MicroK8s, K3s, kind o un kubeconfig estándar. Usa `--context` cuando el clúster deseado no sea el contexto actual.",{"_3697":72808,"_31245":72772,"_21577":120757,"_5":14884,"_28435":120655,"_3074":120758},[],"Fastlane instala varios componentes y crea credenciales. Comprueba `kubectl config current-context` o pasa `--context` antes de ejecutarlo.",{"_3697":72809,"_31245":72772,"_21577":120760,"_5":14884,"_28435":120659,"_3074":120761},[],"Ejecuta el script desde un clon del repositorio Helm:",{"_3697":72810,"_31245":72772,"_21577":120763,"_5":14884,"_28435":120659,"_3074":120764},[],"Crea un registro DNS para el dominio elegido antes de probar desde otra máquina. En una VM pequeña, apúntalo a la dirección de la VM o del balanceador que realmente recibe los puertos 80 y 443.",{"_3697":72811,"_31245":72772,"_21577":120766,"_5":14884,"_28435":120663,"_3074":120767},[],"Por defecto, Fastlane ejecuta `hostname -I` y escribe las direcciones devueltas en `gateway.addresses` y en los SAN IP del certificado self-signed.",{"_3697":72812,"_31245":72772,"_21577":120769,"_5":14884,"_28435":120663,"_3074":120770},[],"En una VM de laboratorio con una única interfaz puede seleccionar la dirección esperada. En hosts con Docker, VPN, WireGuard o varias interfaces también puede elegir direcciones inaccesibles para los clientes. Sobrescribe el resultado:",{"_3697":72813,"_31245":72772,"_21577":120772,"_5":14884,"_28435":120663,"_3074":120773},[],"El valor debe ser una dirección gestionada en el lado Kubernetes de la ruta. Si una IP pública de EC2 reenvía tráfico por WireGuard, pasa la dirección accesible de la VM o clúster, no la IP pública de EC2.",{"_3697":72814,"_31245":72772,"_21577":120775,"_5":14884,"_28435":120663,"_3074":120776},[],"Consulta Expón el Gateway para los conflictos de puertos de K3s, VIP, NAT externo y diseños con varios Gateways.",{"_3697":72815,"_31245":72772,"_21577":120778,"_5":14884,"_28435":120667,"_3074":120779},[],"Opción",{"_3697":72816,"_31245":72772,"_21577":120781,"_5":14884,"_28435":120667,"_3074":120782},[],"Valor predeterminado",{"_3697":72817,"_31245":72772,"_21577":120784,"_5":14884,"_28435":120667,"_3074":120785},[],"Propósito",{"_3697":72818,"_31245":72772,"_21577":120787,"_5":14884,"_28435":120667,"_3074":51341},[],{"_3697":72819,"_31245":72772,"_21577":120789,"_5":14884,"_28435":120667,"_3074":51344},[],{"_3697":72820,"_31245":72772,"_21577":120791,"_5":14884,"_28435":120667,"_3074":120792},[],"Muestra la ayuda",{"_3697":72821,"_31245":72772,"_21577":120794,"_5":14884,"_28435":120667,"_3074":51350},[],{"_3697":72822,"_31245":72772,"_21577":120796,"_5":14884,"_28435":120667,"_3074":120797},[],"contexto actual",{"_3697":72823,"_31245":72772,"_21577":120799,"_5":14884,"_28435":120667,"_3074":120800},[],"Selecciona el contexto de kubeconfig para kubectl y Helm",{"_3697":72824,"_31245":72772,"_21577":120802,"_5":14884,"_28435":120667,"_3074":51359},[],{"_3697":72825,"_31245":72772,"_21577":120804,"_5":14884,"_28435":120667,"_3074":6823},[],{"_3697":72826,"_31245":72772,"_21577":120806,"_5":14884,"_28435":120667,"_3074":120807},[],"Omite prompts y genera credenciales para las dependencias",{"_3697":72827,"_31245":72772,"_21577":120809,"_5":14884,"_28435":120667,"_3074":51367},[],{"_3697":72828,"_31245":72772,"_21577":120811,"_5":14884,"_28435":120667,"_3074":51370},[],{"_3697":72829,"_31245":72772,"_21577":120813,"_5":14884,"_28435":120667,"_3074":120814},[],"Namespace de la instalación",{"_3697":72830,"_31245":72772,"_21577":120816,"_5":14884,"_28435":120667,"_3074":51376},[],{"_3697":72831,"_31245":72772,"_21577":120818,"_5":14884,"_28435":120667,"_3074":51379},[],{"_3697":72832,"_31245":72772,"_21577":120820,"_5":14884,"_28435":120667,"_3074":120821},[],"Dominio usado por la UI, OIDC y el certificado",{"_3697":72833,"_31245":72772,"_21577":120823,"_5":14884,"_28435":120667,"_3074":51385},[],{"_3697":72834,"_31245":72772,"_21577":120825,"_5":14884,"_28435":120667,"_3074":15562},[],{"_3697":72835,"_31245":72772,"_21577":120827,"_5":14884,"_28435":120667,"_3074":120828},[],"Versión del chart de Lamassu",{"_3697":72836,"_31245":72772,"_21577":120830,"_5":14884,"_28435":120667,"_3074":51393},[],{"_3697":72837,"_31245":72772,"_21577":120832,"_5":14884,"_28435":120667,"_3074":51396},[],{"_3697":72838,"_31245":72772,"_21577":120834,"_5":14884,"_28435":120667,"_3074":120835},[],"Puerto del listener HTTPS",{"_3697":72839,"_31245":72772,"_21577":120837,"_5":14884,"_28435":120667,"_3074":51402},[],{"_3697":72840,"_31245":72772,"_21577":120839,"_5":14884,"_28435":120667,"_3074":51405},[],{"_3697":72841,"_31245":72772,"_21577":120841,"_5":14884,"_28435":120667,"_3074":120842},[],"Puerto del listener HTTP",{"_3697":72842,"_31245":72772,"_21577":120844,"_5":14884,"_28435":120667,"_3074":51411},[],{"_3697":72843,"_31245":72772,"_21577":120846,"_5":14884,"_28435":120667,"_3074":51344},[],{"_3697":72844,"_31245":72772,"_21577":120848,"_5":14884,"_28435":120667,"_3074":120849},[],"Certificado PEM para TLS downstream",{"_3697":72845,"_31245":72772,"_21577":120851,"_5":14884,"_28435":120667,"_3074":51419},[],{"_3697":72846,"_31245":72772,"_21577":120853,"_5":14884,"_28435":120667,"_3074":51344},[],{"_3697":72847,"_31245":72772,"_21577":120855,"_5":14884,"_28435":120667,"_3074":120856},[],"Clave privada PEM para TLS downstream",{"_3697":72848,"_31245":72772,"_21577":120858,"_5":14884,"_28435":120667,"_3074":51427},[],{"_3697":72849,"_31245":72772,"_21577":120860,"_5":14884,"_28435":120667,"_3074":120861},[],"chart del repositorio",{"_3697":72850,"_31245":72772,"_21577":120863,"_5":14884,"_28435":120667,"_3074":120864},[],"Usa un chart local de Lamassu sin empaquetar",{"_3697":72851,"_31245":72772,"_21577":120866,"_5":14884,"_28435":120667,"_3074":51436},[],{"_3697":72852,"_31245":72772,"_21577":120868,"_5":14884,"_28435":120667,"_3074":120869},[],"detección automática",{"_3697":72853,"_31245":72772,"_21577":120871,"_5":14884,"_28435":120667,"_3074":120872},[],"Sobrescribe la dirección escrita en `gateway.addresses`",{"_3697":72854,"_31245":72772,"_21577":120874,"_5":14884,"_28435":120667,"_3074":51444},[],{"_3697":72855,"_31245":72772,"_21577":120876,"_5":14884,"_28435":120667,"_3074":6823},[],{"_3697":72856,"_31245":72772,"_21577":120878,"_5":14884,"_28435":120667,"_3074":120879},[],"Instala Victoria Logs, VictoriaTraces, Jaeger y un OpenTelemetry Collector",{"_3697":72857,"_31245":72772,"_21577":120881,"_5":14884,"_28435":120667,"_3074":51452},[],{"_3697":72858,"_31245":72772,"_21577":120883,"_5":14884,"_28435":120667,"_3074":6823},[],{"_3697":72859,"_31245":72772,"_21577":120885,"_5":14884,"_28435":120667,"_3074":120886},[],"Modo desarrollo: provisiona completamente el usuario `lamassu` de Keycloak (contraseña fija `lamassu`/`lamassu`, sin pasos en el primer inicio) y permite al cliente `frontend` aceptar cualquier redirect URI u origen web. No es para producción",{"_3697":72860,"_31245":72772,"_21577":120888,"_5":14884,"_28435":120667,"_3074":51460},[],{"_3697":72861,"_31245":72772,"_21577":120890,"_5":14884,"_28435":120667,"_3074":6823},[],{"_3697":72862,"_31245":72772,"_21577":120892,"_5":14884,"_28435":120667,"_3074":120893},[],"Crea CA, perfiles, certificados, DMS y dispositivos de ejemplo",{"_3697":72863,"_31245":72772,"_21577":120895,"_5":14884,"_28435":120667,"_3074":51468},[],{"_3697":72864,"_31245":72772,"_21577":120897,"_5":14884,"_28435":120667,"_3074":6823},[],{"_3697":72865,"_31245":72772,"_21577":120899,"_5":14884,"_28435":120667,"_3074":120900},[],"Instala componentes HSM de laboratorio y configura KMS con PKCS#11",{"_3697":72866,"_31245":72772,"_21577":120902,"_5":14884,"_28435":120667,"_3074":51476},[],{"_3697":72867,"_31245":72772,"_21577":120904,"_5":14884,"_28435":120667,"_3074":51479},[],{"_3697":72868,"_31245":72772,"_21577":120906,"_5":14884,"_28435":120667,"_3074":120907},[],"Usa otro chart local de SoftHSM",{"_3697":72869,"_31245":72772,"_21577":120909,"_5":14884,"_28435":120667,"_3074":120910},[],"Fastlane no ofrece un modo offline. Para entornos sin conexión, usa el flujo manual con Helm y prepara un registro y mirror de charts.",{"_3697":72870,"_31245":72772,"_21577":120912,"_5":14884,"_28435":120671,"_3074":120913},[],"`--development` ajusta el realm `lamassu` de Keycloak que genera Fastlane para un entorno de evaluación desechable:",{"_3697":72871,"_31245":72772,"_21577":120915,"_5":14884,"_28435":120671,"_3074":120916},[],"el usuario `lamassu` queda completamente provisionado (nombre Lamassu, apellido Admin, email `lamassu@lamassu.io`, verificado): no hay pasos de perfil ni de cambio de contraseña en el primer inicio de sesión",{"_3697":72872,"_31245":72772,"_21577":120918,"_5":14884,"_28435":120671,"_3074":120919},[],"la contraseña conocida `lamassu`/`lamassu` es fija y permanente: no se rota nunca y concede el rol `pki-admin`, incluidos tokens no interactivos a través del cliente `frontend`",{"_3697":72873,"_31245":72772,"_21577":120921,"_5":14884,"_28435":120671,"_3074":120922},[],"el cliente `frontend` acepta cualquier redirect URI y cualquier origen web (`*`) en lugar de los patrones `/*` originales",{"_3697":72874,"_31245":72772,"_21577":120924,"_5":14884,"_28435":120671,"_3074":120925},[],"Con `--development`, la contraseña fija `lamassu`/`lamassu` concede acceso `pki-admin` a cualquiera que alcance la instalación. No lo uses nunca en nada expuesto más allá de una máquina de desarrollo o de un host accesible por red.",{"_3697":72875,"_31245":72772,"_21577":120927,"_5":14884,"_28435":120671,"_3074":120928},[],"`--development` se aplica cuando el realm `lamassu` se importa por primera vez. No modifica un clúster existente. Puede combinarse con `--sample-data`: la transformación de desarrollo se ejecuta primero y después se añaden los datos de ejemplo a la misma configuración del realm.",{"_3697":72876,"_31245":72772,"_21577":120930,"_5":14884,"_28435":120675,"_3074":51506},[],{"_3697":72877,"_31245":72772,"_21577":120932,"_5":14884,"_28435":120675,"_3074":120933},[],"valida las herramientas locales y el clúster seleccionado",{"_3697":72878,"_31245":72772,"_21577":120935,"_5":14884,"_28435":120675,"_3074":120936},[],"instala o actualiza Envoy Gateway 1.8 y crea la `GatewayClass` `eg`",{"_3697":72879,"_31245":72772,"_21577":120938,"_5":14884,"_28435":120675,"_3074":120939},[],"crea el namespace",{"_3697":72880,"_31245":72772,"_21577":120941,"_5":14884,"_28435":120675,"_3074":120942},[],"instala el External Secrets Operator y crea las credenciales de PostgreSQL, RabbitMQ y del administrador de Keycloak como Secrets a través de un `ClusterSecretStore` Fake",{"_3697":72881,"_31245":72772,"_21577":120944,"_5":14884,"_28435":120675,"_3074":120945},[],"instala PostgreSQL y crea las bases de datos necesarias",{"_3697":72882,"_31245":72772,"_21577":120947,"_5":14884,"_28435":120675,"_3074":120948},[],"instala Keycloak y crea el realm `lamassu`, el cliente frontend, el rol administrador y el usuario inicial",{"_3697":72883,"_31245":72772,"_21577":120950,"_5":14884,"_28435":120675,"_3074":120951},[],"instala RabbitMQ",{"_3697":72884,"_31245":72772,"_21577":120953,"_5":14884,"_28435":120675,"_3074":120954},[],"instala opcionalmente observabilidad y componentes HSM de laboratorio",{"_3697":72885,"_31245":72772,"_21577":120956,"_5":14884,"_28435":120675,"_3074":120957},[],"genera `lamassu.yaml`, que referencia los Secrets en lugar de credenciales inline, e instala el chart de Lamassu",{"_3697":72886,"_31245":72772,"_21577":120959,"_5":14884,"_28435":120675,"_3074":120960},[],"carga datos de ejemplo opcionalmente",{"_3697":72887,"_31245":72772,"_21577":120962,"_5":14884,"_28435":120675,"_3074":120963},[],"La configuración generada expone Keycloak en `/auth` a través del mismo Gateway y provisiona al usuario inicial `lamassu` como superadministrador de Lamassu.",{"_3697":72888,"_31245":72772,"_21577":120965,"_5":14884,"_28435":120679,"_3074":120966},[],"Al proporcionar `--tls-crt` y `--tls-key`, Fastlane crea el Secret `downstream-provided-crt` y configura `tls.type: external`.",{"_3697":72889,"_31245":72772,"_21577":120968,"_5":14884,"_28435":120679,"_3074":120969},[],"Sin ellos, configura cert-manager con un emisor self-signed. Es adecuado para laboratorio, pero los clientes no confiarán en él hasta que distribuyas la CA. Usa Helm si necesitas un Issuer corporativo, un emisor ACME público o un Secret existente gestionado por otro sistema.",{"_3697":72890,"_31245":72772,"_21577":120971,"_5":14884,"_28435":120683,"_3074":120972},[],"El modo no interactivo genera contraseñas aleatorias para los administradores de PostgreSQL, RabbitMQ y Keycloak y las almacena en Secrets de Kubernetes a través del `ClusterSecretStore` Fake del External Secrets Operator. Fastlane escribe `lamassu.yaml` en el directorio actual referenciando esos Secrets — el archivo de valores ya no contiene las credenciales.",{"_3697":72891,"_31245":72772,"_21577":120974,"_5":14884,"_28435":120683,"_3074":120975},[],"La contraseña del administrador de Keycloak ya no se imprime por pantalla. Recupérala del Secret cuando la necesites:",{"_3697":72892,"_31245":72772,"_21577":120977,"_5":14884,"_28435":120683,"_3074":120978},[],"El acceso inicial a Lamassu es `lamassu` / `lamassu` y obliga a cambiar la contraseña en el primer uso, salvo que se haya usado `--development`: en ese caso la contraseña permanece fija y permanente.",{"_3697":72893,"_31245":72772,"_21577":120980,"_5":14884,"_28435":120683,"_3074":120981},[],"El `ClusterSecretStore` Fake almacena las credenciales en texto plano y es solo para laboratorio: sustitúyelo por un proveedor ESO real para cualquier uso que vaya más allá de un entorno desechable. Protege el archivo de valores generado, guarda las credenciales en un almacén de secretos apropiado y no reutilices la configuración de identidad de evaluación en producción.",{"_3697":72894,"_31245":72772,"_21577":120983,"_5":14884,"_28435":120687,"_3074":120984},[],"Abre `https://pki.example.com` e inicia sesión con el usuario inicial. Si el Gateway está programado pero la URL no es accesible, sigue las comprobaciones de Expón el Gateway.",{"_3697":72895,"_31245":72895,"_5":15238,"_3074":120986,"_31570":120987,"_21577":120988,"_28435":72895},"Instala con Helm",[50948,120406,120640],[],{"_3697":72896,"_31245":72895,"_21577":120990,"_5":14884,"_28435":72895,"_3074":120991},[],"Prepara las dependencias, configura el chart de Lamassu y verifica un despliegue controlado en Kubernetes.",{"_3697":72897,"_31245":72895,"_5":31567,"_21577":120993,"_28435":120994,"_3074":120995},[],"/docs/es/deployment/self-hosted/helm#instala-lamassu-con-helm","Instala Lamassu con Helm",{"_3697":72898,"_31245":72895,"_5":31567,"_21577":120997,"_28435":120998,"_3074":120656},[],"/docs/es/deployment/self-hosted/helm#antes-de-comenzar",{"_3697":72899,"_31245":72895,"_5":31567,"_21577":121000,"_28435":121001,"_3074":121002},[],"/docs/es/deployment/self-hosted/helm#1-instala-los-requisitos-del-gateway","1\\. Instala los requisitos del Gateway",{"_3697":72900,"_31245":72895,"_5":31567,"_21577":121004,"_28435":121005,"_3074":121006},[],"/docs/es/deployment/self-hosted/helm#2-crea-un-archivo-de-valores","2\\. Crea un archivo de valores",{"_3697":72901,"_31245":72895,"_5":31567,"_21577":121008,"_28435":121009,"_3074":121010},[],"/docs/es/deployment/self-hosted/helm#credenciales-en-secrets-de-kubernetes","Credenciales en Secrets de Kubernetes",{"_3697":72902,"_31245":72895,"_5":31567,"_21577":121012,"_28435":121013,"_3074":121014},[],"/docs/es/deployment/self-hosted/helm#tls-con-un-secret-existente","TLS con un Secret existente",{"_3697":72903,"_31245":72895,"_5":31567,"_21577":121016,"_28435":121017,"_3074":121018},[],"/docs/es/deployment/self-hosted/helm#tls-de-amqp-amqps","TLS de AMQP (AMQPS)",{"_3697":72904,"_31245":72895,"_5":31567,"_21577":121020,"_28435":121021,"_3074":121022},[],"/docs/es/deployment/self-hosted/helm#flujo-de-eventos-de-dispositivo-sse","Flujo de eventos de dispositivo (SSE)",{"_3697":72905,"_31245":72895,"_5":31567,"_21577":121024,"_28435":121025,"_3074":121026},[],"/docs/es/deployment/self-hosted/helm#provisiona-el-primer-administrador","Provisiona el primer administrador",{"_3697":72906,"_31245":72895,"_5":31567,"_21577":121028,"_28435":121029,"_3074":121030},[],"/docs/es/deployment/self-hosted/helm#terminal-experimental-del-dashboard-opcional","Terminal experimental del dashboard (opcional)",{"_3697":72907,"_31245":72895,"_5":31567,"_21577":121032,"_28435":121033,"_3074":121034},[],"/docs/es/deployment/self-hosted/helm#3-instala-lamassu","3\\. Instala Lamassu",{"_3697":72908,"_31245":72895,"_5":31567,"_21577":121036,"_28435":121037,"_3074":121038},[],"/docs/es/deployment/self-hosted/helm#4-verifica-el-despliegue","4\\. Verifica el despliegue",{"_3697":72909,"_31245":72895,"_5":31567,"_21577":121040,"_28435":121041,"_3074":121042},[],"/docs/es/deployment/self-hosted/helm#actualiza-lamassu","Actualiza Lamassu",{"_3697":72910,"_31245":72895,"_5":31567,"_21577":121044,"_28435":121045,"_3074":121046},[],"/docs/es/deployment/self-hosted/helm#decisiones-para-producción","Decisiones para producción",{"_3697":72911,"_31245":72895,"_21577":121048,"_5":14884,"_28435":120994,"_3074":121049},[],"Usa Helm cuando necesites control explícito sobre identidad, bases de datos, mensajería, certificados, almacenamiento y upgrades. Para un entorno de evaluación en el que el script pueda tomar esas decisiones, usa Fastlane.",{"_3697":72912,"_31245":72895,"_21577":121051,"_5":14884,"_28435":120998,"_3074":121052},[],"Prepara los servicios de plataforma que quedan deliberadamente fuera del chart de Lamassu:",{"_3697":72913,"_31245":72895,"_21577":121054,"_5":14884,"_28435":120998,"_3074":121055},[],"un clúster Kubernetes 1.24+ y Helm 3.2+",{"_3697":72914,"_31245":72895,"_21577":121057,"_5":14884,"_28435":120998,"_3074":121058},[],"un servidor PostgreSQL accesible y un rol autorizado para crear bases de datos y schemas",{"_3697":72915,"_31245":72895,"_21577":121060,"_5":14884,"_28435":120998,"_3074":121061},[],"un broker RabbitMQ accesible y sus credenciales",{"_3697":72916,"_31245":72895,"_21577":121063,"_5":14884,"_28435":120998,"_3074":121064},[],"Secrets de Kubernetes en el namespace del release con las credenciales de PostgreSQL y RabbitMQ (y las credenciales SMTP cuando el SMTP exija autenticación) — el chart lee las credenciales de Secrets y rechaza los valores inline (consulta Credenciales en Secrets de Kubernetes)",{"_3697":72917,"_31245":72895,"_21577":121066,"_5":14884,"_28435":120998,"_3074":121067},[],"un proveedor OIDC, normalmente Keycloak, con un realm/tenant y un cliente para Lamassu",{"_3697":72918,"_31245":72895,"_21577":121069,"_5":14884,"_28435":120998,"_3074":121070},[],"Envoy Gateway 1.8+ y una `GatewayClass`",{"_3697":72919,"_31245":72895,"_21577":121072,"_5":14884,"_28435":120998,"_3074":121073},[],"cert-manager 1.14+ (solo para el modo predeterminado `tls.type: certManager`); para TLS de confianza, un emisor de confianza o un Secret TLS de Kubernetes",{"_3697":72920,"_31245":72895,"_21577":121075,"_5":14884,"_28435":120998,"_3074":121076},[],"una StorageClass y un diseño de tráfico externo",{"_3697":72921,"_31245":72895,"_21577":121078,"_5":14884,"_28435":120998,"_3074":121079},[],"El chart usa por defecto una `GatewayClass` llamada `eg`. Cambia `gateway.className` si tu equipo de plataforma utiliza otro nombre.",{"_3697":72922,"_31245":72895,"_21577":121081,"_5":14884,"_28435":120998,"_3074":121082},[],"Tú proporcionas el servidor PostgreSQL. El job de pre-install del chart se conecta con las credenciales indicadas, crea las bases de datos `pki`, `authz` y `wfx` y los schemas de los servicios, ejecuta las migraciones y aplica `services.authz.bootstrap`.",{"_3697":72923,"_31245":72895,"_21577":121084,"_5":14884,"_28435":120998,"_3074":121085},[],"El chart no tiene dependencias Helm que instalen PostgreSQL, RabbitMQ, un proveedor OIDC, Envoy Gateway ni cert-manager.",{"_3697":72924,"_31245":72895,"_21577":121087,"_5":14884,"_28435":121001,"_3074":121088},[],"Instala o actualiza las CRD de Envoy Gateway antes de su controlador. Estos comandos usan la misma versión que el repositorio Helm de Lamassu:",{"_3697":72925,"_31245":72895,"_21577":121090,"_5":14884,"_28435":121001,"_3074":121091},[],"Crea la `GatewayClass` predeterminada si todavía no existe. Guarda este manifiesto como `gateway-class.yaml`:",{"_3697":72926,"_31245":72895,"_21577":121093,"_5":14884,"_28435":121001,"_3074":121094},[],"Instala cert-manager por separado antes de Lamassu, pero solo para el modo predeterminado `tls.type: certManager`. En ese modo el chart renderiza sus recursos de Issuer self-signed y Certificate CA tanto si `tls.certManagerOptions.clusterIssuer` está definido como si no, por lo que cert-manager sigue siendo un requisito. Con `tls.type: external`, el chart no renderiza recursos de cert-manager y el Gateway termina el TLS con un Secret existente que tú proporcionas.",{"_3697":72927,"_31245":72895,"_21577":121096,"_5":14884,"_28435":121005,"_3074":121097},[],"Parte de los valores predeterminados del chart y sobrescribe los específicos del entorno. Este ejemplo supone que PostgreSQL, RabbitMQ y Keycloak son accesibles mediante DNS de Kubernetes y expone Keycloak en `/auth` a través del Gateway compartido:",{"_3697":72928,"_31245":72895,"_21577":121099,"_5":14884,"_28435":121005,"_3074":121100},[],"No añadas `gateway.addresses` por defecto. Deja la asignación de dirección a la implementación del balanceador salvo que tu diseño de red requiera una VIP concreta en Kubernetes. La IP pública de un NAT o proxy upstream no corresponde a este valor.",{"_3697":72929,"_31245":72895,"_21577":121102,"_5":14884,"_28435":121005,"_3074":121103},[],"Si Keycloak es externo y ya tiene una URL accesible, apunta la configuración OIDC hacia él y omite la entrada `/auth` de `gateway.extraRouting`.",{"_3697":72930,"_31245":72895,"_21577":121105,"_5":14884,"_28435":121005,"_3074":121106},[],"Si tu archivo de valores aún contiene los ajustes heredados de validación JWT del Gateway — `auth.oidc.apiGateway.jwks`, `auth.authorization.rolesClaim` o `auth.authorization.roles.admin` — elimínalos. La guía de migración `charts/lamassu/CHANGELOG/3.8.0->4.0.0.md` documenta su eliminación sin alias de compatibilidad, y `values.schema.json` rechaza los bloques residuales en lugar de ignorarlos silenciosamente. Los reemplazos son `services.authz.jwkUrl` y `services.authz.bootstrap`, que ya aparecen en el ejemplo anterior.",{"_3697":72931,"_31245":72895,"_21577":121108,"_5":14884,"_28435":121005,"_3074":121109},[],"El chart ejecuta las cargas con `65532:65532`, el perfil seccomp `RuntimeDefault` y sin capabilities. Crea una ServiceAccount dedicada y no monta su token por defecto. Asegura que los volúmenes montados sean accesibles para esa identidad.",{"_3697":72932,"_31245":72895,"_21577":121111,"_5":14884,"_28435":121009,"_3074":121112},[],"El chart lee las credenciales de PostgreSQL, AMQP y SMTP de Secrets de Kubernetes en el namespace del release. Referéncialas con `existingSecret` más las claves de datos `usernameKey` y `passwordKey`; los valores inline `username` y `password` se han eliminado y `values.schema.json` los rechaza.",{"_3697":72933,"_31245":72895,"_21577":121114,"_5":14884,"_28435":121009,"_3074":121115},[],"Los Secrets deben existir antes de instalar o actualizar: el job de migración de pre-install y pre-upgrade se conecta a PostgreSQL con el Secret de PostgreSQL, y los contenedores de los servicios leen las credenciales de AMQP y SMTP cuando arrancan.",{"_3697":72934,"_31245":72895,"_21577":121117,"_5":14884,"_28435":121009,"_3074":121118},[],"`postgres.existingSecret` (por defecto `lamassu-postgres`) y `amqp.existingSecret` (por defecto `lamassu-amqp`) son obligatorios siempre.",{"_3697":72935,"_31245":72895,"_21577":121120,"_5":14884,"_28435":121009,"_3074":121121},[],"`services.alerts.smtp_server.existingSecret` está vacío por defecto, lo que significa SMTP sin autenticación. Defínelo, junto con sus nombres de clave, solo cuando tu servidor SMTP exija autenticación.",{"_3697":72936,"_31245":72895,"_21577":121123,"_5":14884,"_28435":121009,"_3074":121124},[],"Cada entrada de `services.authz.credentials` nombra su `database` y usa el Secret global de PostgreSQL — `postgres.existingSecret` con sus nombres de clave configurados — salvo que la entrada defina su propio `existingSecret`.",{"_3697":72937,"_31245":72895,"_21577":121126,"_5":14884,"_28435":121009,"_3074":121127},[],"Cambiar el contenido de un Secret no reinicia los pods que lo consumen: los servicios leen las credenciales cuando arrancan. Reinicia los pods afectados después de rotar una credencial.",{"_3697":72938,"_31245":72895,"_21577":121129,"_5":14884,"_28435":121009,"_3074":121130},[],"Para producción, gestiona los Secrets con el External Secrets Operator (ESO), que el chart no instala. El `charts/lamassu/README.md` del repositorio Helm documenta en su sección *Secret management* un ejemplo completo y funcional: instalar external-secrets 0.20.2, un `ClusterSecretStore` de prueba, los recursos `ExternalSecret` y la espera antes de instalar el chart. Su proveedor Fake es solo para pruebas — sustitúyelo por la configuración de tu proveedor para cualquier uso que vaya más allá de un entorno desechable; AWS Secrets Manager, Vault, Azure Key Vault, GCP Secret Manager y otros proveedores están documentados en external-secrets.io.",{"_3697":72939,"_31245":72895,"_21577":121132,"_5":14884,"_28435":121009,"_3074":121133},[],"Solo estas credenciales pasan a Secrets: el resto de values, como la configuración de conectores o de motores criptográficos, sigue configurándose en el archivo de values.",{"_3697":72940,"_31245":72895,"_21577":121135,"_5":14884,"_28435":121013,"_3074":121136},[],"Crea un Secret con `tls.crt` y `tls.key` y referéncialo. El Secret debe existir antes de instalar: en modo `external` el chart no renderiza recursos de cert-manager ni crea nunca este Secret.",{"_3697":72941,"_31245":72895,"_21577":121138,"_5":14884,"_28435":121017,"_3074":121139},[],"`amqp.tls: true` selecciona AMQPS en todos los bloques de configuración del bus de eventos. El puerto por defecto sigue siendo `5672` y no cambia automáticamente al habilitar TLS, así que define `amqp.port` con el listener TLS del broker, normalmente `5671`.",{"_3697":72942,"_31245":72895,"_21577":121141,"_5":14884,"_28435":121017,"_3074":121142},[],"Sin un Secret de CA configurado, los clientes del bus de eventos usan las CA de confianza del sistema. Para confiar en una CA privada, crea un Secret en el namespace del release con el certificado de la CA en formato PEM y define `amqp.ca.secretName` (y `amqp.ca.certificateKey` si la clave de datos no es `ca.crt`).",{"_3697":72943,"_31245":72895,"_21577":121144,"_5":14884,"_28435":121017,"_3074":121145},[],"Para brokers que exijan TLS mutuo, crea un Secret con el certificado de cliente y su clave privada y define `amqp.client.secretName` (con `amqp.client.certificateKey` y `amqp.client.privateKeyKey` si las claves de datos no son `tls.crt` y `tls.key`).",{"_3697":72944,"_31245":72895,"_21577":121147,"_5":14884,"_28435":121017,"_3074":121148},[],"El chart monta los Secrets configurados en modo de solo lectura en todas las cargas de trabajo que consumen AMQP: el certificado de la CA en `/etc/lamassu/amqp/ca` y el certificado y la clave de cliente en `/etc/lamassu/amqp/client`. Los nombres de los archivos montados son siempre `ca.crt`, `tls.crt` y `tls.key` — los valores `certificateKey` y `privateKeyKey` renombran solo las claves de datos del Secret, nunca las rutas en disco. La clave privada del cliente se monta con permisos restrictivos (`defaultMode: 0440`; el volumen de la CA usa `0444`), que funcionan porque el chart añade `fsGroup` al security context del pod cuando `amqp.client.secretName` está definido — el security context del pod por defecto del chart ya define `fsGroup: 65532` para todos los pods de servicio, por lo que este ajuste solo se aplica cuando se ha sobrescrito un `podSecurityContext` explícito sin `fsGroup` y hay un Secret de cliente AMQP configurado — y usa el `runAsGroup` del contenedor (por defecto `65532`) cuando `fsGroup` no está ya definido.",{"_3697":72945,"_31245":72895,"_21577":121150,"_5":14884,"_28435":121017,"_3074":121151},[],"Ambas opciones de Secret exigen `amqp.tls: true`: `values.schema.json` rechaza un `secretName` no vacío cuando `tls` es false, rechaza claves desconocidas y rechaza nombres de clave de datos fuera de `^[A-Za-z0-9._-]+$`. El Secret referenciado debe existir en el namespace del release o los pods consumidores no llegan a arrancar.",{"_3697":72946,"_31245":72895,"_21577":121153,"_5":14884,"_28435":121017,"_3074":121154},[],"El cliente AMQP carga los certificados al arrancar, así que reinicia los pods consumidores tras actualizar cualquiera de los dos Secrets. Cambiar cualquier valor de `amqp` reinicia las cargas de trabajo consumidoras mediante la anotación `checksum/config`, pero cambiar solo el contenido de un Secret no desencadena un rollout.",{"_3697":72947,"_31245":72895,"_21577":121156,"_5":14884,"_28435":121017,"_3074":121157},[],"Según la guía de migración `charts/lamassu/CHANGELOG/3.8.0->4.0.0.md`: en 3.8.0 `amqp.tls` no se aplicaba y los clientes del bus de eventos usaban AMQP en claro; desde 4.0.0, `amqp.tls: true` los cambia a AMQPS. Define `amqp.port` con el listener TLS del broker antes del upgrade, o usa `amqp.tls: false` para mantener AMQP en claro. `amqp.tls: false` envía las credenciales del broker y todo el tráfico del bus de eventos en claro.",{"_3697":72948,"_31245":72895,"_21577":121159,"_5":14884,"_28435":121021,"_3074":121160},[],"`services.deviceManager.sseEnabled` (por defecto `true`) controla si Device Manager sirve su flujo de eventos de dispositivo mediante Server-Sent Events (SSE). Con el valor por defecto, el chart renderiza una regla de gateway dedicada para el endpoint de eventos de dispositivo con un timeout de petición de 11 minutos, porque el timeout de petición por defecto del Gateway es demasiado corto para estos flujos, que el servicio mantiene abiertos hasta unos diez minutos. Las llamadas a Device Manager que no son peticiones SSE conservan el timeout por defecto del Gateway.",{"_3697":72949,"_31245":72895,"_21577":121162,"_5":14884,"_28435":121021,"_3074":121163},[],"Defínelo como `false` para deshabilitar el flujo: el chart renderiza entonces `sse_enabled: false` en la configuración de Device Manager y omite la regla de gateway, y las peticiones SSE al endpoint de eventos de dispositivo fallan. Consulta Eventos de dispositivo en la guía de actualización de 3.8.0 a 4.0.0.",{"_3697":72950,"_31245":72895,"_21577":121165,"_5":14884,"_28435":121025,"_3074":121166},[],"No existe un superusuario implícito. Crea en el proveedor OIDC el rol o grupo esperado por `services.authz.bootstrap` y asígnalo al menos a un administrador antes de exponer Lamassu.",{"_3697":72951,"_31245":72895,"_21577":121168,"_5":14884,"_28435":121025,"_3074":121169},[],"El job de pre-install y pre-upgrade aplica el bootstrap de forma idempotente: conserva los principales existentes y añade los grants que falten.",{"_3697":72952,"_31245":72895,"_21577":121171,"_5":14884,"_28435":121025,"_3074":121172},[],"Prueba una identidad autorizada y otra denegada. Si ningún token coincide con un principal activo del bootstrap, nadie podrá administrar la PKI.",{"_3697":72953,"_31245":72895,"_21577":121174,"_5":14884,"_28435":121025,"_3074":121175},[],"Consulta Control de acceso para conocer el modelo de principales y políticas.",{"_3697":72954,"_31245":72895,"_21577":121177,"_5":14884,"_28435":121029,"_3074":121178},[],"El dashboard incluye un terminal experimental en el navegador para trabajar con los dispositivos. Está deshabilitado por defecto; actívalo en el archivo de valores:",{"_3697":72955,"_31245":72895,"_21577":121180,"_5":14884,"_28435":121029,"_3074":121181},[],"Para habilitar el terminal se requiere la autorización externa: define `auth.externalAuthorization.enabled: true` y `auth.externalAuthorization.failOpen: false`. Si no, el chart se niega a renderizar el release, porque el endpoint WebSocket del terminal quedaría expuesto a través del Gateway sin autorización externa.",{"_3697":72956,"_31245":72895,"_21577":121183,"_5":14884,"_28435":121029,"_3074":121184},[],"Solo las identidades que tengan concedida la política precargada \"Terminal Network\" pueden abrir sesiones de terminal. Consulta Control de acceso para saber cómo se asignan las políticas.",{"_3697":72957,"_31245":72895,"_21577":121186,"_5":14884,"_28435":121029,"_3074":121187},[],"Ten en cuenta que, incluso con el terminal habilitado, los pods dentro del clúster pueden seguir llegando directamente al servicio de la UI salvo que las network policies restrinjan ese acceso: la autorización externa se aplica al tráfico que entra por el Gateway.",{"_3697":72958,"_31245":72895,"_21577":121189,"_5":14884,"_28435":121033,"_3074":121190},[],"Para instalar un checkout local:",{"_3697":72959,"_31245":72895,"_21577":121192,"_5":14884,"_28435":121037,"_3074":121193},[],"El Gateway debe mostrar `PROGRAMMED=True`. Si está programado pero no tiene una dirección utilizable, continúa con Expón el Gateway.",{"_3697":72960,"_31245":72895,"_21577":121195,"_5":14884,"_28435":121037,"_3074":121196},[],"El test de Helm comprueba los endpoints de salud de CA, DMS Manager, Device Manager y VA, y verifica la respuesta de la UI.",{"_3697":72961,"_31245":72895,"_21577":121198,"_5":14884,"_28435":121041,"_3074":121199},[],"Los pasos de upgrade específicos de cada versión se mantienen en `charts/lamassu/CHANGELOG/` dentro del repositorio Helm. El chart también incluye un job de pre-upgrade opcional que migra las claves privadas de CA existentes al motor KMS configurado para el release. Está desactivado por defecto (`migrations.caToKms.enabled: false`) y solo es necesario cuando actualizas desde una versión anterior a 3.7.0.",{"_3697":72962,"_31245":72895,"_21577":121201,"_5":14884,"_28435":121041,"_3074":121202},[],"Mientras el flag esté activo, cada `helm upgrade` crea el job `<chart fullname>-ca-to-kms-migration` (`lamassu-ca-to-kms-migration` para el release `lamassu`); una instalación nueva no lo crea. Su hook weight es `-10`, por lo que se ejecuta antes de los otros hooks de pre-upgrade: la configuración de bootstrap de autorización (peso `-4`) y el job de migración de base de datos (peso `-3`).",{"_3697":72963,"_31245":72895,"_21577":121204,"_5":14884,"_28435":121041,"_3074":121205},[],"El job consume la misma configuración del servicio KMS que el chart renderiza en el ConfigMap de KMS, incluidos los motores de `services.kms.cryptoEngines`, y ejecuta la imagen de la herramienta de migración definida en `migrations.caToKms.image`. La monta en modo read-only en `/etc/lamassuiot/config.yml` desde la clave `config` del ConfigMap, así que configura el motor de destino en tus valores antes del upgrade que realiza la migración.",{"_3697":72964,"_31245":72895,"_21577":121207,"_5":14884,"_28435":121041,"_3074":121208},[],"El job resuelve su configuración mediante un volumen proyectado con dos fuentes opcionales: el ConfigMap `<chart fullname>-kms-config`, cuyo nombre incorpora el release (`lamassu-kms-config` para el release `lamassu`, `prod-lamassu-kms-config` para el release `prod`), y el ConfigMap legacy `kms-config`, sin el nombre del release, creado por versiones anteriores del chart. La configuración legacy mantiene la autoridad mientras siga presente y el job usa el ConfigMap del release una vez el legacy desaparece. Ambas fuentes son opcionales, por lo que un ConfigMap ausente nunca deja el pod del upgrade en `ContainerCreating`.",{"_3697":72965,"_31245":72895,"_21577":121210,"_5":14884,"_28435":121041,"_3074":121211},[],"Mantén `migrations.caToKms.enabled: true` en el upgrade que realiza la migración y elimina después el flag de tus valores una vez completada la migración; su valor por defecto es `false`.",{"_3697":72966,"_31245":72895,"_21577":121213,"_5":14884,"_28435":121045,"_3074":121214},[],"Antes de pasar a producción, revisa:",{"_3697":72967,"_31245":72895,"_21577":121216,"_5":14884,"_28435":121045,"_3074":121217},[],"backup y recuperación de PostgreSQL y volúmenes persistentes",{"_3697":72968,"_31245":72895,"_21577":121219,"_5":14884,"_28435":121045,"_3074":121220},[],"un motor KMS de producción; el motor filesystem predeterminado no ofrece alta disponibilidad",{"_3697":72969,"_31245":72895,"_21577":121222,"_5":14884,"_28435":121045,"_3074":121223},[],"almacenamiento compartido para VA antes de aumentar sus réplicas",{"_3697":72970,"_31245":72895,"_21577":121225,"_5":14884,"_28435":121045,"_3074":121226},[],"roles OIDC gestionados y eliminación de credenciales de evaluación",{"_3697":72971,"_31245":72895,"_21577":121228,"_5":14884,"_28435":121045,"_3074":121229},[],"un emisor TLS de confianza o un certificado gestionado externamente",{"_3697":72972,"_31245":72895,"_21577":121231,"_5":14884,"_28435":121045,"_3074":121232},[],"recursos, réplicas, autoscaling, disruption budgets y placement",{"_3697":72973,"_31245":72895,"_21577":121234,"_5":14884,"_28435":121045,"_3074":121235},[],"SMTP, observabilidad y entrega de alertas",{"_3697":72974,"_31245":72895,"_21577":121237,"_5":14884,"_28435":121045,"_3074":121238},[],"las guías de actualización entre versiones y las notas de migración de `charts/lamassu/CHANGELOG/` antes de cada upgrade, incluido el hook opcional de migración CA-to-KMS descrito arriba",{"_3697":72975,"_31245":72895,"_21577":121240,"_5":14884,"_28435":121045,"_3074":121241},[],"La referencia completa de valores se mantiene en `charts/lamassu/VALUES.md` dentro del repositorio Helm.",{"_3697":72976,"_31245":72976,"_5":15238,"_3074":121243,"_31570":121244,"_21577":121245,"_28435":72976},"Expón el Gateway",[50948,120406,120640],[],{"_3697":72977,"_31245":72976,"_21577":121247,"_5":14884,"_28435":72976,"_3074":121248},[],"Elige cómo llegan los clientes a Lamassu, cuándo definir gateway.addresses y cómo diseñar varios Gateways.",{"_3697":72978,"_31245":72976,"_5":31567,"_21577":121250,"_28435":121251,"_3074":121252},[],"/docs/es/deployment/self-hosted/networking#expón-el-gateway-de-lamassu","Expón el Gateway de Lamassu",{"_3697":72979,"_31245":72976,"_5":31567,"_21577":121254,"_28435":121255,"_3074":121256},[],"/docs/es/deployment/self-hosted/networking#necesitas-gatewayaddresses","¿Necesitas `gateway.addresses`?",{"_3697":72980,"_31245":72976,"_5":31567,"_21577":121258,"_28435":121259,"_3074":121260},[],"/docs/es/deployment/self-hosted/networking#diseño-recomendado-para-un-solo-nodo","Diseño recomendado para un solo nodo",{"_3697":72981,"_31245":72976,"_5":31567,"_21577":121262,"_28435":121263,"_3074":51840},[],"/docs/es/deployment/self-hosted/networking#k3s",{"_3697":72982,"_31245":72976,"_5":31567,"_21577":121265,"_28435":121266,"_3074":121267},[],"/docs/es/deployment/self-hosted/networking#bare-metal-con-metallb-o-kube-vip","Bare metal con MetalLB o kube-vip",{"_3697":72983,"_31245":72976,"_5":31567,"_21577":121269,"_28435":121270,"_3074":121271},[],"/docs/es/deployment/self-hosted/networking#proxy-externo-nat-o-vpn","Proxy externo, NAT o VPN",{"_3697":72984,"_31245":72976,"_5":31567,"_21577":121273,"_28435":121274,"_3074":121275},[],"/docs/es/deployment/self-hosted/networking#qué-ocurre-si-necesitas-tres-gateways","¿Qué ocurre si necesitas tres Gateways?",{"_3697":72985,"_31245":72976,"_5":31567,"_21577":121277,"_28435":121278,"_3074":121279},[],"/docs/es/deployment/self-hosted/networking#certificados-de-cliente-y-cabeceras-de-identidad","Certificados de cliente y cabeceras de identidad",{"_3697":72986,"_31245":72976,"_5":31567,"_21577":121281,"_28435":121282,"_3074":121283},[],"/docs/es/deployment/self-hosted/networking#guía-de-decisión","Guía de decisión",{"_3697":72987,"_31245":72976,"_5":31567,"_21577":121285,"_28435":121286,"_3074":121287},[],"/docs/es/deployment/self-hosted/networking#proxy-de-salida","Proxy de salida",{"_3697":72988,"_31245":72976,"_5":31567,"_21577":121289,"_28435":121290,"_3074":121291},[],"/docs/es/deployment/self-hosted/networking#verifica-la-ruta-de-tráfico","Verifica la ruta de tráfico",{"_3697":72989,"_31245":72976,"_21577":121293,"_5":14884,"_28435":121251,"_3074":121294},[],"El chart de Lamassu crea un Gateway compartido con listeners HTTP y HTTPS. Envoy Gateway crea normalmente un deployment de proxy dedicado y un Service `LoadBalancer`.",{"_3697":72990,"_31245":72976,"_21577":121296,"_5":14884,"_28435":121251,"_3074":121297},[],"La accesibilidad externa depende de toda la ruta. Un recurso `Gateway` no configura por sí mismo el router, firewall, DNS, balanceador cloud ni NAT upstream.",{"_3697":72991,"_31245":72976,"_21577":121299,"_5":14884,"_28435":121255,"_3074":121300},[],"Normalmente no. Si lo omites, el controlador del Gateway y la implementación del balanceador pueden asignar una dirección y publicarla en `Gateway.status.addresses` y en el estado del Service generado.",{"_3697":72992,"_31245":72976,"_21577":121302,"_5":14884,"_28435":121255,"_3074":121303},[],"Defínelo únicamente cuando:",{"_3697":72993,"_31245":72976,"_21577":121305,"_5":14884,"_28435":121255,"_3074":121306},[],"tu balanceador cloud o bare metal permite solicitar una dirección concreta",{"_3697":72994,"_31245":72976,"_21577":121308,"_5":14884,"_28435":121255,"_3074":121309},[],"esa dirección está asignada a este Gateway",{"_3697":72995,"_31245":72976,"_21577":121311,"_5":14884,"_28435":121255,"_3074":121312},[],"la red ya enruta el tráfico de esa dirección hasta el clúster",{"_3697":72996,"_31245":72976,"_21577":121314,"_5":14884,"_28435":121255,"_3074":121315},[],"Esto solicita `192.168.1.50`; no reclama la IP en tu LAN ni la vuelve accesible.",{"_3697":72997,"_31245":72976,"_21577":121317,"_5":14884,"_28435":121255,"_3074":121318},[],"No confundas estos valores:",{"_3697":72998,"_31245":72976,"_21577":121320,"_5":14884,"_28435":121255,"_3074":121321},[],"`gateway.addresses` solicita una dirección para el Gateway.",{"_3697":72999,"_31245":72976,"_21577":121323,"_5":14884,"_28435":121255,"_3074":121324},[],"`tls.certManagerOptions.certSpec.addresses` añade direcciones IP a los SAN del certificado TLS.",{"_3697":73000,"_31245":72976,"_21577":121326,"_5":14884,"_28435":121255,"_3074":121327},[],"Si los usuarios se conectan por DNS, añade el nombre a `tls.certManagerOptions.certSpec.hostnames`. No copies la IP pública de un proxy upstream en `gateway.addresses`.",{"_3697":73001,"_31245":72976,"_21577":121329,"_5":14884,"_28435":121259,"_3074":121330},[],"Para una VM pequeña con K3s o MicroK8s, usa un único Gateway externo de Lamassu y enruta todos los endpoints a través de él:",{"_3697":73002,"_31245":72976,"_21577":121332,"_5":14884,"_28435":121259,"_3074":121333},[],"Este diseño utiliza una IP, un punto de entrada TLS y un único par de puertos. El chart ya crea las rutas necesarias.",{"_3697":73003,"_31245":72976,"_21577":121335,"_5":14884,"_28435":121263,"_3074":121336},[],"K3s ServiceLB implementa cada Service `LoadBalancer` mediante pods que reservan los puertos del Service en el nodo. En un único nodo, solo un Service puede ocupar el puerto 80 y otro el 443. El Service Traefik que K3s instala por defecto puede estar ocupando ambos.",{"_3697":73004,"_31245":72976,"_21577":121338,"_5":14884,"_28435":121263,"_3074":121339},[],"Para el diseño recomendado:",{"_3697":73005,"_31245":72976,"_21577":121341,"_5":14884,"_28435":121263,"_3074":121342},[],"Usa un único Gateway de Lamassu expuesto externamente.",{"_3697":73006,"_31245":72976,"_21577":121344,"_5":14884,"_28435":121263,"_3074":121345},[],"Comprueba que los puertos 80 y 443 están libres. Deshabilita o reconfigura Traefik si no forma parte de la ruta de tráfico.",{"_3697":73007,"_31245":72976,"_21577":121347,"_5":14884,"_28435":121263,"_3074":121348},[],"Permite esos puertos en el firewall de la VM y en cualquier security group upstream.",{"_3697":73008,"_31245":72976,"_21577":121350,"_5":14884,"_28435":121263,"_3074":121351},[],"Apunta DNS a la dirección accesible de la VM.",{"_3697":73009,"_31245":72976,"_21577":121353,"_5":14884,"_28435":121263,"_3074":121354},[],"Consulta la documentación de K3s ServiceLB para conocer el uso de host ports y cómo sustituirlo por otro balanceador.",{"_3697":73010,"_31245":72976,"_21577":121356,"_5":14884,"_28435":121266,"_3074":121357},[],"Asigna una VIP de un pool accesible desde la LAN. Puedes solicitarla con `gateway.addresses` si la implementación lo permite. Confirma la dirección asignada en el estado en lugar de asumir que la solicitud tuvo éxito.",{"_3697":73011,"_31245":72976,"_21577":121359,"_5":14884,"_28435":121270,"_3074":121360},[],"Una dirección pública externa puede reenviar TCP 80 y 443 a la VM o a una VIP de Kubernetes:",{"_3697":73012,"_31245":72976,"_21577":121362,"_5":14884,"_28435":121270,"_3074":121363},[],"La IP pública pertenece al dispositivo externo. Deja `gateway.addresses` sin definir o usa la dirección real del lado de Kubernetes, nunca una IP que el clúster no pueda asociar.",{"_3697":73013,"_31245":72976,"_21577":121365,"_5":14884,"_28435":121274,"_3074":121366},[],"Primero decide si necesitas tres data planes independientes o solo tres nombres de host.",{"_3697":73014,"_31245":72976,"_21577":121368,"_5":14884,"_28435":121274,"_3074":121369},[],"Requisito",{"_3697":73015,"_31245":72976,"_21577":121371,"_5":14884,"_28435":121274,"_3074":121372},[],"Diseño recomendado",{"_3697":73016,"_31245":72976,"_21577":121374,"_5":14884,"_28435":121274,"_3074":121375},[],"Consecuencia",{"_3697":73017,"_31245":72976,"_21577":121377,"_5":14884,"_28435":121274,"_3074":121378},[],"Varias URL o servicios de Lamassu",{"_3697":73018,"_31245":72976,"_21577":121380,"_5":14884,"_28435":121274,"_3074":121381},[],"Un Gateway con varias rutas",{"_3697":73019,"_31245":72976,"_21577":121383,"_5":14884,"_28435":121274,"_3074":121384},[],"Una IP y un proxy fleet; es el comportamiento predeterminado del chart",{"_3697":73020,"_31245":72976,"_21577":121386,"_5":14884,"_28435":121274,"_3074":121387},[],"Gateways independientes e IP externas distintas",{"_3697":73021,"_31245":72976,"_21577":121389,"_5":14884,"_28435":121274,"_3074":121390},[],"Una VIP por Gateway",{"_3697":73022,"_31245":72976,"_21577":121392,"_5":14884,"_28435":121274,"_3074":121393},[],"Todos pueden usar 80/443; requiere un balanceador con un pool de direcciones",{"_3697":73023,"_31245":72976,"_21577":121395,"_5":14884,"_28435":121274,"_3074":121396},[],"Gateways independientes, un nodo y una IP",{"_3697":73024,"_31245":72976,"_21577":121398,"_5":14884,"_28435":121274,"_3074":121399},[],"Puertos externos diferentes",{"_3697":73025,"_31245":72976,"_21577":121401,"_5":14884,"_28435":121274,"_3074":121402},[],"Los clientes deben indicar puertos no estándar",{"_3697":73026,"_31245":72976,"_21577":121404,"_5":14884,"_28435":121274,"_3074":121405},[],"Terminación TLS/mTLS separada detrás de una IP",{"_3697":73027,"_31245":72976,"_21577":121407,"_5":14884,"_28435":121274,"_3074":121408},[],"Front door con enrutamiento SNI hacia Gateways internos",{"_3697":73028,"_31245":72976,"_21577":121410,"_5":14884,"_28435":121274,"_3074":121411},[],"Diseño avanzado; el front door usa TLS passthrough y cada Gateway termina su propio TLS",{"_3697":73029,"_31245":72976,"_21577":121413,"_5":14884,"_28435":121274,"_3074":121414},[],"Recursos Gateway separados pero proxy compartido",{"_3697":73030,"_31245":72976,"_21577":121416,"_5":14884,"_28435":121274,"_3074":121417},[],"Modo merged Gateway de Envoy",{"_3697":73031,"_31245":72976,"_21577":121419,"_5":14884,"_28435":121274,"_3074":121420},[],"Solo separación lógica; cada listener necesita una tupla única de puerto, protocolo y hostname",{"_3697":73032,"_31245":72976,"_21577":121422,"_5":14884,"_28435":121274,"_3074":121423},[],"Tres Services `LoadBalancer` independientes no pueden reservar a la vez los mismos puertos 80 y 443 mediante K3s ServiceLB. Usa un Gateway compartido, asigna VIP distintas con otro balanceador o utiliza puertos diferentes.",{"_3697":73033,"_31245":72976,"_21577":121425,"_5":14884,"_28435":121274,"_3074":121426},[],"Envoy Gateway provisiona normalmente un proxy fleet por `Gateway`. Su modo merged Gateway puede compartir un fleet y una dirección, pero no es un cambio directo para varias releases de Lamassu: los listeners generados usan los mismos puertos y protocolos sin hostnames distintos, por lo que entran en conflicto salvo que personalices el diseño.",{"_3697":73034,"_31245":72976,"_21577":121428,"_5":14884,"_28435":121274,"_3074":121429},[],"Usa un front door con SNI solo cuando los Gateways internos deban mantener políticas TLS o mTLS independientes:",{"_3697":73035,"_31245":72976,"_21577":121431,"_5":14884,"_28435":121274,"_3074":121432},[],"Esto requiere hostnames SNI distintos y configuración de red externa al chart de Lamassu.",{"_3697":73036,"_31245":72976,"_21577":121434,"_5":14884,"_28435":121278,"_3074":121435},[],"El chart aplica automáticamente una `ClientTrafficPolicy` llamada `enable-mtls` a su Gateway compartido; ningún valor de Helm la activa ni la desactiva. La terminación TLS acepta peticiones con o sin certificado de cliente: los dispositivos pueden presentar uno, pero no están obligados a hacerlo. Antes de reenviar una petición, el Gateway elimina las cabeceras de identidad y de certificado que un cliente podría suministrarse por sí mismo: `X-Principal-Id`, `X-Lms-Source`, `X-Forwarded-Client-Cert`, `X-Forwarded-Cert`, `X-Forwarded-Tls-Client-Cert` (la grafía de Traefik), `Ssl-Client-Cert` y `X-Amzn-Mtls-Clientcert`. La grafía de Traefik se incluye porque los backends que aceptan `X-Forwarded-Tls-Client-Cert` directamente recibirían, si no, datos de identidad de certificado suministrados por el propio cliente sin haber presentado un certificado. Tras la eliminación, Envoy añade su propia cabecera `X-Forwarded-Client-Cert` con el certificado presentado y su cadena, de modo que los servicios que leen la identidad del certificado reciben solo valores generados por el Gateway. Ningún valor de Helm modifica la lista de cabeceras eliminadas. La página Control de acceso describe cómo aprovecha `authz` esta protección para mantener `X-Principal-ID` fuera del alcance de los clientes.",{"_3697":73037,"_31245":72976,"_21577":121437,"_5":14884,"_28435":121282,"_3074":121438},[],"Si un Gateway puede gestionar TLS y el enrutamiento, usa el valor predeterminado del chart.",{"_3697":73038,"_31245":72976,"_21577":121440,"_5":14884,"_28435":121282,"_3074":121441},[],"Si los Gateways necesitan políticas independientes y puedes asignar IP, usa una VIP por Gateway.",{"_3697":73039,"_31245":72976,"_21577":121443,"_5":14884,"_28435":121282,"_3074":121444},[],"Si solo necesitas separar los recursos Kubernetes, evalúa merged Gateway y usa tuplas de listener únicas.",{"_3697":73040,"_31245":72976,"_21577":121446,"_5":14884,"_28435":121282,"_3074":121447},[],"Si los data planes y la terminación TLS deben ser independientes detrás de una IP, añade un front door con TLS passthrough y SNI.",{"_3697":73041,"_31245":72976,"_21577":121449,"_5":14884,"_28435":121282,"_3074":121450},[],"Si nada de lo anterior es posible, usa puertos externos distintos o cambia el diseño de red.",{"_3697":73042,"_31245":72976,"_21577":121452,"_5":14884,"_28435":121286,"_3074":121453},[],"Los clientes internos de Lamassu — la conexión con el motor de Vault, las llamadas entre servicios y los webhooks salientes — respetan las variables de entorno `HTTP_PROXY`, `HTTPS_PROXY` y `NO_PROXY`. La excepción es el conector del motor de autorización: usa su propio transporte y no consulta estas variables de proxy. Si tu despliegue enruta el tráfico de salida por un proxy, incluye los nombres de servicio internos del clúster en `NO_PROXY` (por ejemplo `.svc,.cluster.local`) para que el tráfico interno permanezca dentro del clúster. El tráfico de loopback nunca se envía por un proxy.",{"_3697":73043,"_31245":72976,"_21577":121455,"_5":14884,"_28435":121286,"_3074":121456},[],"El transporte predeterminado de estos clientes acota el timeout de conexión (30 segundos), el handshake TLS (10 segundos) y la reutilización de conexiones inactivas (90 segundos), de modo que una dependencia inalcanzable falla rápido en lugar de bloquearse; estos valores son los predeterminados del transporte de Go, no configuración de Lamassu. HTTP/2 se negocia cuando el otro extremo lo soporta. El conector del motor de autorización mantiene su propio transporte sin estos timeouts de conexión ni de handshake TLS; solo su timeout global de petición de 30 segundos acota cada llamada.",{"_3697":73044,"_31245":72976,"_21577":121458,"_5":14884,"_28435":121290,"_3074":121459},[],"Comprueba, en orden:",{"_3697":73045,"_31245":72976,"_21577":121461,"_5":14884,"_28435":121290,"_3074":121462},[],"El `Gateway` muestra `Accepted=True` y `Programmed=True`.",{"_3697":73046,"_31245":72976,"_21577":121464,"_5":14884,"_28435":121290,"_3074":121465},[],"Su estado contiene la dirección esperada.",{"_3697":73047,"_31245":72976,"_21577":121467,"_5":14884,"_28435":121290,"_3074":121468},[],"El Service `LoadBalancer` generado tiene una dirección externa utilizable.",{"_3697":73048,"_31245":72976,"_21577":121470,"_5":14884,"_28435":121290,"_3074":121471},[],"El puerto 443 de esa dirección es accesible desde la red del cliente.",{"_3697":73049,"_31245":72976,"_21577":121473,"_5":14884,"_28435":121290,"_3074":121474},[],"DNS resuelve al endpoint accesible externamente.",{"_3697":73050,"_31245":72976,"_21577":121476,"_5":14884,"_28435":121290,"_3074":121477},[],"El certificado contiene el nombre DNS o la IP usada por el cliente.",{"_3697":73051,"_31245":72976,"_21577":121479,"_5":14884,"_28435":121290,"_3074":121480},[],"Gateway API trata las direcciones como estado deseado que el controlador puede asignar o rechazar; consulta la introducción a Gateway API para conocer el modelo.",{"_3697":73052,"_31245":73052,"_5":15238,"_3074":51055,"_31570":121482,"_21577":121483,"_28435":73052},[50948,120406,120640],[],{"_3697":73053,"_31245":73052,"_21577":121485,"_5":14884,"_28435":73052,"_3074":121486},[],"Elige un flujo de instalación y una arquitectura de red para Lamassu en tu clúster Kubernetes.",{"_3697":73054,"_31245":73052,"_5":31567,"_21577":121488,"_28435":121489,"_3074":121490},[],"/docs/es/deployment/self-hosted/overview#despliegue-self-managed-con-kubernetes","Despliegue self-managed con Kubernetes",{"_3697":73055,"_31245":73052,"_5":31567,"_21577":121492,"_28435":121493,"_3074":121494},[],"/docs/es/deployment/self-hosted/overview#elige-un-flujo-de-instalación","Elige un flujo de instalación",{"_3697":73056,"_31245":73052,"_5":31567,"_21577":121496,"_28435":121497,"_3074":121498},[],"/docs/es/deployment/self-hosted/overview#qué-proporciona-el-chart-de-lamassu","Qué proporciona el chart de Lamassu",{"_3697":73057,"_31245":73052,"_5":31567,"_21577":121500,"_28435":121501,"_3074":121502},[],"/docs/es/deployment/self-hosted/overview#cómo-encaja-el-despliegue","Cómo encaja el despliegue",{"_3697":73058,"_31245":73052,"_5":31567,"_21577":121504,"_28435":121505,"_3074":121506},[],"/docs/es/deployment/self-hosted/overview#requisitos-de-plataforma","Requisitos de plataforma",{"_3697":73059,"_31245":73052,"_5":31567,"_21577":121508,"_28435":121509,"_3074":121510},[],"/docs/es/deployment/self-hosted/overview#elige-la-siguiente-página","Elige la siguiente página",{"_3697":73060,"_31245":73052,"_21577":121512,"_5":14884,"_28435":121489,"_3074":121513},[],"Ejecuta Lamassu en un clúster Kubernetes operado por tu equipo. El chart Helm despliega los servicios de Lamassu y sus recursos de enrutamiento; tú proporcionas el clúster, el almacenamiento persistente, el proveedor de identidad, PostgreSQL, RabbitMQ y la ruta de red utilizada por los clientes.",{"_3697":73061,"_31245":73052,"_21577":121515,"_5":14884,"_28435":121493,"_3074":121516},[],"Flujo",{"_3697":73062,"_31245":73052,"_21577":121518,"_5":14884,"_28435":121493,"_3074":121519},[],"Úsalo para",{"_3697":73063,"_31245":73052,"_21577":121521,"_5":14884,"_28435":121493,"_3074":121522},[],"Qué instala",{"_3697":73064,"_31245":73052,"_21577":121524,"_5":14884,"_28435":121493,"_3074":52102},[],{"_3697":73065,"_31245":73052,"_21577":121526,"_5":14884,"_28435":121493,"_3074":121527},[],"Producción y entornos controlados",{"_3697":73066,"_31245":73052,"_21577":121529,"_5":14884,"_28435":121493,"_3074":121530},[],"Servicios de Lamassu y recursos de Gateway API",{"_3697":73067,"_31245":73052,"_21577":121532,"_5":14884,"_28435":121493,"_3074":51192},[],{"_3697":73068,"_31245":73052,"_21577":121534,"_5":14884,"_28435":121493,"_3074":121535},[],"Evaluación, demos, CI y pequeños clústeres de laboratorio",{"_3697":73069,"_31245":73052,"_21577":121537,"_5":14884,"_28435":121493,"_3074":121538},[],"PostgreSQL, Keycloak, RabbitMQ, Envoy Gateway y Lamassu",{"_3697":73070,"_31245":73052,"_21577":121540,"_5":14884,"_28435":121497,"_3074":121541},[],"El chart de Lamassu es un **chart de aplicación**, no un chart de bootstrap del clúster. Crea los recursos Kubernetes que ejecutan y configuran Lamassu, pero espera que ya existan los servicios de plataforma de los que dependen.",{"_3697":73071,"_31245":73052,"_21577":121543,"_5":14884,"_28435":121497,"_3074":121544},[],"Área",{"_3697":73072,"_31245":73052,"_21577":121546,"_5":14884,"_28435":121497,"_3074":121547},[],"El chart de Lamassu proporciona",{"_3697":73073,"_31245":73052,"_21577":121549,"_5":14884,"_28435":121497,"_3074":121550},[],"Tú proporcionas",{"_3697":73074,"_31245":73052,"_21577":121552,"_5":14884,"_28435":121497,"_3074":121553},[],"Aplicaciones Lamassu",{"_3697":73075,"_31245":73052,"_21577":121555,"_5":14884,"_28435":121497,"_3074":121556},[],"Deployments y StatefulSets para la UI y las APIs, Services internos, ConfigMaps, una ServiceAccount y HPA/PDB opcionales",{"_3697":73076,"_31245":73052,"_21577":121558,"_5":14884,"_28435":121497,"_3074":121559},[],"Un clúster Kubernetes operativo, capacidad de cómputo y acceso a las imágenes",{"_3697":73077,"_31245":73052,"_21577":121561,"_5":14884,"_28435":121497,"_3074":121562},[],"Datos PostgreSQL",{"_3697":73078,"_31245":73052,"_21577":121564,"_5":14884,"_28435":121497,"_3074":121565},[],"Un job de pre-install/pre-upgrade que crea las bases de datos y schemas necesarios, ejecuta migraciones y aplica el bootstrap de autorización",{"_3697":73079,"_31245":73052,"_21577":121567,"_5":14884,"_28435":121497,"_3074":121568},[],"Un servidor PostgreSQL accesible, credenciales autorizadas para crear bases de datos y schemas, y operaciones de backup/HA",{"_3697":73080,"_31245":73052,"_21577":121570,"_5":14884,"_28435":121497,"_3074":121571},[],"Mensajería",{"_3697":73081,"_31245":73052,"_21577":121573,"_5":14884,"_28435":121497,"_3074":121574},[],"Configuración de conexión a RabbitMQ para los servicios Lamassu; la conexión puede usar AMQPS, con una CA privada y un certificado de cliente opcionales, definidos mediante valores del chart",{"_3697":73082,"_31245":73052,"_21577":121576,"_5":14884,"_28435":121497,"_3074":121577},[],"Un broker RabbitMQ accesible, credenciales y la gestión de su ciclo de vida",{"_3697":73083,"_31245":73052,"_21577":121579,"_5":14884,"_28435":121497,"_3074":121580},[],"Identidad",{"_3697":73084,"_31245":73052,"_21577":121582,"_5":14884,"_28435":121497,"_3074":121583},[],"Configuración OIDC/JWT y de autorización externa, además de los principales iniciales de Lamassu",{"_3697":73085,"_31245":73052,"_21577":121585,"_5":14884,"_28435":121497,"_3074":121586},[],"Un proveedor OIDC, realm/tenant, cliente, usuarios, grupos y roles",{"_3697":73086,"_31245":73052,"_21577":121588,"_5":14884,"_28435":121497,"_3074":121589},[],"Enrutamiento externo",{"_3697":73087,"_31245":73052,"_21577":121591,"_5":14884,"_28435":121497,"_3074":121592},[],"Un `Gateway`, recursos `HTTPRoute`, una configuración `EnvoyProxy` y políticas de seguridad de Envoy",{"_3697":73088,"_31245":73052,"_21577":121594,"_5":14884,"_28435":121497,"_3074":121595},[],"Las CRD de Gateway API y Envoy, el controlador Envoy Gateway, una `GatewayClass`, un balanceador y la ruta de red externa",{"_3697":73089,"_31245":73052,"_21577":121597,"_5":14884,"_28435":121497,"_3074":52176},[],{"_3697":73090,"_31245":73052,"_21577":121599,"_5":14884,"_28435":121497,"_3074":121600},[],"En el modo predeterminado `tls.type: certManager`, recursos `Issuer` y `Certificate` CA de cert-manager y un `Certificate` downstream gestionado por el chart; en el modo `tls.type: external`, una referencia a tu Secret TLS",{"_3697":73091,"_31245":73052,"_21577":121602,"_5":14884,"_28435":121497,"_3074":121603},[],"cert-manager solo para el modo predeterminado `tls.type: certManager`; para TLS de confianza, un emisor de confianza o un Secret TLS ya poblado",{"_3697":73092,"_31245":73052,"_21577":121605,"_5":14884,"_28435":121497,"_3074":121606},[],"Datos persistentes de la aplicación",{"_3697":73093,"_31245":73052,"_21577":121608,"_5":14884,"_28435":121497,"_3074":121609},[],"PersistentVolumeClaims necesarios para el almacenamiento local predeterminado de KMS y VA",{"_3697":73094,"_31245":73052,"_21577":121611,"_5":14884,"_28435":121497,"_3074":121612},[],"Una StorageClass, almacenamiento físico, backups y un backend compartido/externo cuando el escalado lo requiera",{"_3697":73095,"_31245":73052,"_21577":121614,"_5":14884,"_28435":121497,"_3074":121615},[],"Integraciones opcionales",{"_3697":73096,"_31245":73052,"_21577":121617,"_5":14884,"_28435":121497,"_3074":121618},[],"Puntos de configuración para observabilidad, conectores AWS y conectividad PKCS#11/HSM",{"_3697":73097,"_31245":73052,"_21577":121620,"_5":14884,"_28435":121497,"_3074":121621},[],"Los backends de observabilidad, credenciales cloud y un HSM de producción o servicio externo de claves",{"_3697":73098,"_31245":73052,"_21577":121623,"_5":14884,"_28435":121497,"_3074":121624},[],"El chart crea el `Gateway` y las rutas de Lamassu. No instala el controlador Envoy Gateway ni hace que el Service `LoadBalancer` generado sea accesible desde tu red.",{"_3697":73099,"_31245":73052,"_21577":121626,"_5":14884,"_28435":121497,"_3074":121627},[],"Usa un único Gateway de Lamassu en los puertos 80 y 443 y deja que sus HTTPRoutes distribuyan el tráfico a todos los servicios. Proporciona a ese Gateway un único endpoint accesible mediante el balanceador del clúster, o reenvía tráfico desde un proxy externo o un dispositivo NAT. No necesitas un Gateway por servicio.",{"_3697":73100,"_31245":73052,"_21577":121629,"_5":14884,"_28435":121501,"_3074":121630},[],"El chart crea un `Gateway` compartido por cada release de Helm. Todos los recursos `HTTPRoute` gestionados por el chart se conectan a él. Envoy Gateway provisiona el data plane del proxy y un Service `LoadBalancer` de Kubernetes para ese Gateway.",{"_3697":73101,"_31245":73052,"_21577":121632,"_5":14884,"_28435":121501,"_3074":121633},[],"El valor `gateway.addresses` solo solicita una dirección al controlador del Gateway. No hace que una IP sea enrutable, abre un firewall, configura DNS ni crea NAT. Consulta Expón el Gateway antes de definirlo.",{"_3697":73102,"_31245":73052,"_21577":121635,"_5":14884,"_28435":121505,"_3074":121636},[],"Kubernetes 1.24 o posterior",{"_3697":73103,"_31245":73052,"_21577":121638,"_5":14884,"_28435":121505,"_3074":121639},[],"Helm 3.2 o posterior",{"_3697":73104,"_31245":73052,"_21577":121641,"_5":14884,"_28435":121505,"_3074":121642},[],"Envoy Gateway 1.8 o posterior y una `GatewayClass`",{"_3697":73105,"_31245":73052,"_21577":121644,"_5":14884,"_28435":121505,"_3074":121645},[],"cert-manager 1.14 o posterior; necesario solo para el modo TLS predeterminado `tls.type: certManager`, no para `tls.type: external`",{"_3697":73106,"_31245":73052,"_21577":121647,"_5":14884,"_28435":121505,"_3074":121648},[],"almacenamiento persistente adecuado para la configuración elegida de PostgreSQL, RabbitMQ, VA y KMS",{"_3697":73107,"_31245":73052,"_21577":121650,"_5":14884,"_28435":121505,"_3074":121651},[],"una implementación de balanceador o alguna otra ruta deliberada desde los clientes hasta el Gateway",{"_3697":73108,"_31245":73052,"_21577":121653,"_5":14884,"_28435":121505,"_3074":121654},[],"Los despliegues KMS que usan el sidecar PKCS#11 nativo requieren Kubernetes 1.29 o posterior. Las imágenes de contenedor precompiladas de Lamassu se publican para `linux/amd64` y `linux/arm64`, y el módulo cliente PKCS#11 del KMS (`p11-kit-client.so`) se instala en la ruta de biblioteca Debian de la arquitectura destino: `/usr/lib/x86_64-linux-gnu/pkcs11/p11-kit-client.so` en amd64 y `/usr/lib/aarch64-linux-gnu/pkcs11/p11-kit-client.so` en arm64. La ruta x86\\_64 se conserva como alias de compatibilidad para configuraciones existentes.",{"_3697":73109,"_31245":73052,"_21577":121656,"_5":14884,"_28435":121509,"_3074":121657},[],"<Card title=\"Instala con Helm\" description=\"Prepara dependencias, configura valores, instala y verifica un despliegue controlado.\" href=\"/docs/deployment/self-hosted/helm\" />",{"_3697":73110,"_31245":73052,"_21577":121659,"_5":14884,"_28435":121509,"_3074":121660},[],"<Card title=\"Actualiza desde 3.8.0\" description=\"Actualiza una release de Helm existente a 4.0.0: cambios de arquitectura, breaking changes, pasos de migración y validación.\" href=\"/docs/upgrades/3-8-0-to-4-0-0\" />",{"_3697":73111,"_31245":73052,"_21577":121662,"_5":14884,"_28435":121509,"_3074":121663},[],"<Card title=\"Expón el Gateway\" description=\"Elige un diseño de tráfico externo, comprende gateway.addresses y gestiona varios Gateways.\" href=\"/docs/deployment/self-hosted/networking\" />",{"_3697":73112,"_31245":73052,"_21577":121665,"_5":14884,"_28435":121509,"_3074":121666},[],"<Card title=\"Usa Fastlane\" description=\"Arranca un entorno completo de evaluación o laboratorio con un script.\" href=\"/docs/deployment/self-hosted/fastlane\" />",{"_3697":73113,"_31245":73113,"_5":15238,"_3074":121668,"_31570":121669,"_21577":121671,"_28435":73113},"Resolución de problemas de despliegue",[50948,120406,121670],"Operación",[],{"_3697":73114,"_31245":73113,"_21577":121673,"_5":14884,"_28435":73113,"_3074":121674},[],"Diagnostica acceso, salud de los servicios y dependencias de infraestructura.",{"_3697":73115,"_31245":73113,"_5":31567,"_21577":121676,"_28435":121677,"_3074":121678},[],"/docs/es/deployment/troubleshooting#secuencia-de-diagnóstico","Secuencia de diagnóstico",{"_3697":73116,"_31245":73113,"_5":31567,"_21577":121680,"_28435":121681,"_3074":121682},[],"/docs/es/deployment/troubleshooting#reproduce-una-sola-operación","Reproduce una sola operación",{"_3697":73117,"_31245":73113,"_5":31567,"_21577":121684,"_28435":121685,"_3074":121686},[],"/docs/es/deployment/troubleshooting#separa-cliente-gateway-y-servicio","Separa cliente, Gateway y servicio",{"_3697":73118,"_31245":73113,"_5":31567,"_21577":121688,"_28435":121689,"_3074":121690},[],"/docs/es/deployment/troubleshooting#revisa-el-estado-de-kubernetes","Revisa el estado de Kubernetes",{"_3697":73119,"_31245":73113,"_5":31567,"_21577":121692,"_28435":121693,"_3074":121694},[],"/docs/es/deployment/troubleshooting#consulta-el-servicio-afectado","Consulta el servicio afectado",{"_3697":73120,"_31245":73113,"_5":31567,"_21577":121696,"_28435":121697,"_3074":121698},[],"/docs/es/deployment/troubleshooting#valida-el-resultado-desde-fuera","Valida el resultado desde fuera",{"_3697":73121,"_31245":73113,"_5":31567,"_21577":121700,"_28435":121701,"_3074":121702},[],"/docs/es/deployment/troubleshooting#recogida-mínima-de-evidencias","Recogida mínima de evidencias",{"_3697":73122,"_31245":73113,"_5":31567,"_21577":121704,"_28435":121705,"_3074":121706},[],"/docs/es/deployment/troubleshooting#no-puedo-iniciar-sesión","No puedo iniciar sesión",{"_3697":73123,"_31245":73113,"_5":31567,"_21577":121708,"_28435":121709,"_3074":121710},[],"/docs/es/deployment/troubleshooting#todo-devuelve-403-o-5xx","Todo devuelve 403 o 5xx",{"_3697":73124,"_31245":73113,"_5":31567,"_21577":121712,"_28435":121713,"_3074":121714},[],"/docs/es/deployment/troubleshooting#errores-500-de-la-api","Errores 500 de la API",{"_3697":73125,"_31245":73113,"_5":31567,"_21577":121716,"_28435":121717,"_3074":121718},[],"/docs/es/deployment/troubleshooting#un-pod-no-está-ready","Un pod no está Ready",{"_3697":73126,"_31245":73113,"_5":31567,"_21577":121720,"_28435":121721,"_3074":121722},[],"/docs/es/deployment/troubleshooting#los-eventos-no-llegan","Los eventos no llegan",{"_3697":73127,"_31245":73113,"_5":31567,"_21577":121724,"_28435":121725,"_3074":121726},[],"/docs/es/deployment/troubleshooting#observabilidad","Observabilidad",{"_3697":73128,"_31245":73113,"_21577":121728,"_5":14884,"_28435":73113,"_3074":121729},[],"Empieza por localizar la capa que falla. Una respuesta del Gateway y un pod no preparado requieren evidencias distintas. Para emisión rechazada o resultados de validación, consulta el diagnóstico PKI; para enrolamiento, el diagnóstico EST.",{"_3697":73129,"_31245":73113,"_21577":121731,"_5":14884,"_28435":121681,"_3074":121732},[],"Anota hora en UTC, usuario o principal, recurso, endpoint y resultado. Evita repetir una acción destructiva como revocación o eliminación.",{"_3697":73130,"_31245":73113,"_21577":121734,"_5":14884,"_28435":121685,"_3074":121735},[],"Comprueba el código HTTP. Un 401 apunta a autenticación; un 403, a autorización; un 404, a ruta o recurso; un 5xx, al servicio o una dependencia.",{"_3697":73131,"_31245":73113,"_21577":121737,"_5":14884,"_28435":121689,"_3074":121738},[],"Localiza pods no preparados, reinicios, eventos recientes y el estado del release.",{"_3697":73132,"_31245":73113,"_21577":121740,"_5":14884,"_28435":121693,"_3074":121741},[],"Revisa su endpoint /health y sus logs en la misma ventana temporal. Después sigue la dependencia indicada: PostgreSQL, RabbitMQ, proveedor OIDC o motor criptográfico.",{"_3697":73133,"_31245":73113,"_21577":121743,"_5":14884,"_28435":121697,"_3074":121744},[],"Para PKI, comprueba el certificado, la cadena, OCSP o CRL con el mismo tipo de cliente que utiliza producción.",{"_3697":73134,"_31245":73113,"_21577":121746,"_5":14884,"_28435":121701,"_3074":121747},[],"Sustituye los marcadores por tu release, namespace y deployment reales.",{"_3697":73135,"_31245":73113,"_21577":121749,"_5":14884,"_28435":121701,"_3074":121750},[],"Ejecuta también la prueba de conectividad del chart:",{"_3697":73136,"_31245":73113,"_21577":121752,"_5":14884,"_28435":121701,"_3074":121753},[],"El test consulta la salud de CA, DMS Manager, Device Manager y VA, y comprueba que la UI devuelve HTML. Un test correcto confirma conectividad básica, no un flujo completo de emisión.",{"_3697":73137,"_31245":73113,"_21577":121755,"_5":14884,"_28435":121701,"_3074":121756},[],"Los servicios del chart exponen sondas de inicio, disponibilidad y vida sobre /health. Un pod puede estar ejecutándose pero no recibir tráfico si la readiness probe falla.",{"_3697":73138,"_31245":73113,"_21577":121758,"_5":14884,"_28435":121705,"_3074":121759},[],"Si recibes un 401:",{"_3697":73139,"_31245":73113,"_21577":121761,"_5":14884,"_28435":121705,"_3074":121762},[],"comprueba que la autoridad OIDC de la UI sea accesible desde el navegador;",{"_3697":73140,"_31245":73113,"_21577":121764,"_5":14884,"_28435":121705,"_3074":121765},[],"verifica emisor, audiencia y expiración del token;",{"_3697":73141,"_31245":73113,"_21577":121767,"_5":14884,"_28435":121705,"_3074":121768},[],"confirma que el Gateway puede obtener las claves de la URI JWKS;",{"_3697":73142,"_31245":73113,"_21577":121770,"_5":14884,"_28435":121705,"_3074":121771},[],"revisa que la ruta pública e interna del proveedor apunten al mismo realm.",{"_3697":73143,"_31245":73113,"_21577":121773,"_5":14884,"_28435":121705,"_3074":121774},[],"Si el login termina pero las APIs devuelven 403:",{"_3697":73144,"_31245":73113,"_21577":121776,"_5":14884,"_28435":121705,"_3074":121777},[],"inspecciona los claims reales del token;",{"_3697":73145,"_31245":73113,"_21577":121779,"_5":14884,"_28435":121705,"_3074":121780},[],"confirma que coinciden con un principal activo;",{"_3697":73146,"_31245":73113,"_21577":121782,"_5":14884,"_28435":121705,"_3074":121783},[],"revisa las políticas concedidas al principal;",{"_3697":73147,"_31245":73113,"_21577":121785,"_5":14884,"_28435":121705,"_3074":121786},[],"verifica que authz alcanza PostgreSQL y su JWKS.",{"_3697":73148,"_31245":73113,"_21577":121788,"_5":14884,"_28435":121705,"_3074":121789},[],"En una instalación nueva, confirma que el Job de migración terminó. Ese Job crea esquemas, migra authz, precarga políticas y provisiona los principales definidos en services.authz.bootstrap.",{"_3697":73149,"_31245":73113,"_21577":121791,"_5":14884,"_28435":121709,"_3074":121792},[],"La autorización externa falla cerrada por defecto. Si authz no está disponible, las rutas protegidas se bloquean.",{"_3697":73150,"_31245":73113,"_21577":121794,"_5":14884,"_28435":121709,"_3074":121795},[],"Localiza el pod y Service de authz.",{"_3697":73151,"_31245":73113,"_21577":121797,"_5":14884,"_28435":121709,"_3074":121798},[],"Comprueba /health, logs y conexión a su base de datos.",{"_3697":73152,"_31245":73113,"_21577":121800,"_5":14884,"_28435":121709,"_3074":121801},[],"Verifica el DNS y puerto configurados en externalAuthorization.",{"_3697":73153,"_31245":73113,"_21577":121803,"_5":14884,"_28435":121709,"_3074":121804},[],"Comprueba que la ruta del check es /v1/ext\\_authz/check.",{"_3697":73154,"_31245":73113,"_21577":121806,"_5":14884,"_28435":121709,"_3074":121807},[],"No cambies a failOpen: true como solución permanente: permitiría tráfico sin autorización durante la caída.",{"_3697":73155,"_31245":73113,"_21577":121809,"_5":14884,"_28435":121713,"_3074":121810},[],"Un 500 indica un fallo interno, como una base de datos no disponible. El cuerpo `{\"err\": ...}` incluye hoy el texto del error interno, que puede contener nombres de esquema, tabla y restricción y, en fallos de conexión, el host y el usuario de la base de datos (no la contraseña). Localiza la causa en el log del servicio con la hora de la petición, y no reenvíes el cuerpo a terceros ni lo muestres a usuarios finales. Es un defecto conocido de divulgación de información: está previsto devolver un mensaje genérico en los 500 y dejar el detalle solo en el log del servicio (seguimiento en lamassuiot#814). El conector de autorización también devuelve el error interno, en el campo `details.error`. Algunos errores de petición, como un tamaño de clave que el motor no admite, se devuelven también como 500.",{"_3697":73156,"_31245":73113,"_21577":121812,"_5":14884,"_28435":121717,"_3074":121813},[],"Revisa primero kubectl describe pod. Las causas habituales son:",{"_3697":73157,"_31245":73113,"_21577":121815,"_5":14884,"_28435":121717,"_3074":121816},[],"credenciales o DNS incorrectos para PostgreSQL o RabbitMQ;",{"_3697":73158,"_31245":73113,"_21577":121818,"_5":14884,"_28435":121717,"_3074":121819},[],"un Secret de CA o de certificado de cliente de AMQP inexistente referenciado por `amqp.ca.secretName` o `amqp.client.secretName`;",{"_3697":73159,"_31245":73113,"_21577":121821,"_5":14884,"_28435":121717,"_3074":121822},[],"volumen persistente sin enlazar;",{"_3697":73160,"_31245":73113,"_21577":121824,"_5":14884,"_28435":121717,"_3074":121825},[],"imagen inaccesible o política de pull incorrecta;",{"_3697":73161,"_31245":73113,"_21577":121827,"_5":14884,"_28435":121717,"_3074":121828},[],"configuración inválida del motor criptográfico;",{"_3697":73162,"_31245":73113,"_21577":121830,"_5":14884,"_28435":121717,"_3074":121831},[],"límites de CPU o memoria demasiado bajos;",{"_3697":73163,"_31245":73113,"_21577":121833,"_5":14884,"_28435":121717,"_3074":121834},[],"migración previa incompleta.",{"_3697":73164,"_31245":73113,"_21577":121836,"_5":14884,"_28435":121717,"_3074":121837},[],"Los valores genéricos solicitan 100 mCPU y 128 MiB y limitan a 500 mCPU y 512 MiB. Ajusta por servicio cuando haya OOMKills, throttling o arranques lentos.",{"_3697":73165,"_31245":73113,"_21577":121839,"_5":14884,"_28435":121717,"_3074":121840},[],"Los motores KMS basados en filesystem y el almacenamiento local de VA utilizan volúmenes de acceso exclusivo. Mantén una réplica o migra a backends compartidos antes de habilitar autoscaling.",{"_3697":73166,"_31245":73113,"_21577":121842,"_5":14884,"_28435":121717,"_3074":121843},[],"Las llamadas internas ahora fallan rápido en lugar de bloquearse para los clientes cubiertos por Proxy de salida: los intentos de conexión agotan el tiempo tras 30 segundos y los handshakes TLS tras 10 segundos. El conector del motor de autorización mantiene su propio transporte sin estos timeouts de conexión ni de handshake TLS; solo su timeout global de petición de 30 segundos acota cada llamada. Si un proxy de salida gestiona el tráfico de salida del clúster, comprueba las variables de entorno `HTTP_PROXY`, `HTTPS_PROXY` y `NO_PROXY` del pod e incluye los nombres de servicio internos en `NO_PROXY`.",{"_3697":73167,"_31245":73113,"_21577":121845,"_5":14884,"_28435":121721,"_3074":121846},[],"Los eventos de dominio y auditoría dependen del publisher del bus:",{"_3697":73168,"_31245":73113,"_21577":121848,"_5":14884,"_28435":121721,"_3074":121849},[],"verifica que esté habilitado en el servicio emisor;",{"_3697":73169,"_31245":73113,"_21577":121851,"_5":14884,"_28435":121721,"_3074":121852},[],"comprueba conectividad y credenciales AMQP;",{"_3697":73170,"_31245":73113,"_21577":121854,"_5":14884,"_28435":121721,"_3074":121855},[],"revisa exchange, routing key, colas y consumidores;",{"_3697":73171,"_31245":73113,"_21577":121857,"_5":14884,"_28435":121721,"_3074":121858},[],"inspecciona dead-letter queues;",{"_3697":73172,"_31245":73113,"_21577":121860,"_5":14884,"_28435":121721,"_3074":121861},[],"alerta sobre colas durables huérfanas y crecimiento de backlog.",{"_3697":73173,"_31245":73113,"_21577":121863,"_5":14884,"_28435":121721,"_3074":121864},[],"Si `amqp.tls` está habilitado, revisa también la parte TLS:",{"_3697":73174,"_31245":73113,"_21577":121866,"_5":14884,"_28435":121721,"_3074":121867},[],"confirma que el listener del broker hable AMQPS en el puerto configurado — el puerto por defecto sigue siendo `5672` y no cambia automáticamente al habilitar TLS;",{"_3697":73175,"_31245":73113,"_21577":121869,"_5":14884,"_28435":121721,"_3074":121870},[],"si defines `amqp.ca.secretName`, confirma que el Secret exista en el namespace del release y que su clave de datos coincida con `amqp.ca.certificateKey` (por defecto `ca.crt`); si no defines `amqp.ca.secretName`, los clientes confían en las CA del sistema;",{"_3697":73176,"_31245":73113,"_21577":121872,"_5":14884,"_28435":121721,"_3074":121873},[],"recuerda que un Secret referenciado inexistente impide arrancar los pods consumidores;",{"_3697":73177,"_31245":73113,"_21577":121875,"_5":14884,"_28435":121721,"_3074":121876},[],"tras actualizar el Secret de la CA o del certificado de cliente, reinicia los pods consumidores: el cliente AMQP carga los certificados al arrancar.",{"_3697":73178,"_31245":73113,"_21577":121878,"_5":14884,"_28435":121721,"_3074":121879},[],"Consulta TLS de AMQP (AMQPS) para la configuración completa.",{"_3697":73179,"_31245":73113,"_21577":121881,"_5":14884,"_28435":121721,"_3074":121882},[],"Una caída del consumidor no siempre impide que la operación principal termine. Por eso debes monitorizar RabbitMQ y verificar de forma independiente la persistencia de auditoría.",{"_3697":73180,"_31245":73113,"_21577":121884,"_5":14884,"_28435":121725,"_3074":121885},[],"El chart puede habilitar la instrumentación OpenTelemetry para los servicios que la admiten, incluido authz; no configura OpenTelemetry para el AWS Connector, wfx ni la UI. Las trazas se exportan por OTLP HTTP y los logs pueden dirigirse a un endpoint compatible, como VictoriaLogs. Usa un identificador de correlación y la misma ventana temporal para unir Gateway, servicio y dependencia.",{"_3697":73181,"_31245":73113,"_21577":121887,"_5":14884,"_28435":121725,"_3074":121888},[],"Antes de cerrar una incidencia, guarda:",{"_3697":73182,"_31245":73113,"_21577":121890,"_5":14884,"_28435":121725,"_3074":121891},[],"causa confirmada;",{"_3697":73183,"_31245":73113,"_21577":121893,"_5":14884,"_28435":121725,"_3074":121894},[],"alcance temporal y recursos afectados;",{"_3697":73184,"_31245":73113,"_21577":121896,"_5":14884,"_28435":121725,"_3074":121897},[],"comandos o consultas utilizados;",{"_3697":73185,"_31245":73113,"_21577":121899,"_5":14884,"_28435":121725,"_3074":121900},[],"cambio aplicado y forma de revertirlo;",{"_3697":73186,"_31245":73113,"_21577":121902,"_5":14884,"_28435":121725,"_3074":121903},[],"validación desde un consumidor;",{"_3697":73187,"_31245":73113,"_21577":121905,"_5":14884,"_28435":121725,"_3074":121906},[],"acción preventiva y propietario.",{"_3697":73188,"_31245":73188,"_5":15238,"_3074":121908,"_31570":121909,"_21577":121913,"_28435":73188},"Modelo de datos",[50948,121910,121911,121912],"Plataforma","Administración","Control de acceso",[],{"_3697":73189,"_31245":73188,"_21577":121915,"_5":14884,"_28435":73188,"_3074":121916},[],"Entidades y relaciones del esquema pki.json que utiliza authz para evaluar políticas de acceso.",{"_3697":73190,"_31245":73188,"_5":31567,"_21577":121918,"_28435":121919,"_3074":121920},[],"/docs/es/platform/administration/access-control/data-model#relaciones-del-esquema","Relaciones del esquema",{"_3697":73191,"_31245":73188,"_5":31567,"_21577":121922,"_28435":121923,"_3074":121924},[],"/docs/es/platform/administration/access-control/data-model#entidades-del-esquema","Entidades del esquema",{"_3697":73192,"_31245":73188,"_21577":121926,"_5":14884,"_28435":73188,"_3074":121927},[],"El esquema `connectors/authz/pki.json` define las entidades del dominio `pki` para el control de acceso. Una política identifica el tipo de recurso mediante `namespace: pki`, `schema_name` y `entity_type`. Por ejemplo, `ca.certificate` corresponde al esquema `ca` y al tipo de entidad `certificate`.",{"_3697":73193,"_31245":73188,"_21577":121929,"_5":14884,"_28435":121919,"_3074":121930},[],"Cada flecha sale de la entidad que declara la relación y apunta a su `target_entity`. Debajo de la etiqueta aparece el valor de `foreign_key`, la columna de origen. En `pki.json`, el `name` de cada relación coincide con esa columna. El diagrama se puede pulsar para ampliarlo y recorrerlo.",{"_3697":73194,"_31245":73188,"_21577":121932,"_5":14884,"_28435":121919,"_3074":121933},[],"Una política puede propagar acciones desde la entidad referenciada hacia la que declara la relación. Por ejemplo, para conceder lectura de los dispositivos de un DMS, la regla parte de `dmsmanager.dms`, apunta a `devicemanager.device` y especifica `via: dms_owner`.",{"_3697":73195,"_31245":73188,"_21577":121935,"_5":14884,"_28435":121919,"_3074":121936},[],"En los filtros de acceso heredado, `authz` compara la columna `foreign_key` con la primera columna de `primary_key` de la entidad referenciada. Así, `subject_common_name` se compara con `device.id`, `issuer_meta_serial_number` con `ca_certificate.id` y los enlaces hacia `kms_key` con `kms_key.key_id`.",{"_3697":73196,"_31245":73188,"_21577":121938,"_5":14884,"_28435":121923,"_3074":121939},[],"Entidad (`schema_name.entity_type`)",{"_3697":73197,"_31245":73188,"_21577":121941,"_5":14884,"_28435":121923,"_3074":121942},[],"Tabla (`table_name`)",{"_3697":73198,"_31245":73188,"_21577":121944,"_5":14884,"_28435":121923,"_3074":121945},[],"Clave (`primary_key`)",{"_3697":73199,"_31245":73188,"_21577":121947,"_5":14884,"_28435":121923,"_3074":52527},[],{"_3697":73200,"_31245":73188,"_21577":121949,"_5":14884,"_28435":121923,"_3074":52530},[],{"_3697":73201,"_31245":73188,"_21577":121951,"_5":14884,"_28435":121923,"_3074":52533},[],{"_3697":73202,"_31245":73188,"_21577":121953,"_5":14884,"_28435":121923,"_3074":52536},[],{"_3697":73203,"_31245":73188,"_21577":121955,"_5":14884,"_28435":121923,"_3074":52539},[],{"_3697":73204,"_31245":73188,"_21577":121957,"_5":14884,"_28435":121923,"_3074":52542},[],{"_3697":73205,"_31245":73188,"_21577":121959,"_5":14884,"_28435":121923,"_3074":52545},[],{"_3697":73206,"_31245":73188,"_21577":121961,"_5":14884,"_28435":121923,"_3074":52548},[],{"_3697":73207,"_31245":73188,"_21577":121963,"_5":14884,"_28435":121923,"_3074":52542},[],{"_3697":73208,"_31245":73188,"_21577":121965,"_5":14884,"_28435":121923,"_3074":52553},[],{"_3697":73209,"_31245":73188,"_21577":121967,"_5":14884,"_28435":121923,"_3074":52556},[],{"_3697":73210,"_31245":73188,"_21577":121969,"_5":14884,"_28435":121923,"_3074":52559},[],{"_3697":73211,"_31245":73188,"_21577":121971,"_5":14884,"_28435":121923,"_3074":52562},[],{"_3697":73212,"_31245":73188,"_21577":121973,"_5":14884,"_28435":121923,"_3074":52565},[],{"_3697":73213,"_31245":73188,"_21577":121975,"_5":14884,"_28435":121923,"_3074":52542},[],{"_3697":73214,"_31245":73188,"_21577":121977,"_5":14884,"_28435":121923,"_3074":52570},[],{"_3697":73215,"_31245":73188,"_21577":121979,"_5":14884,"_28435":121923,"_3074":52573},[],{"_3697":73216,"_31245":73188,"_21577":121981,"_5":14884,"_28435":121923,"_3074":52542},[],{"_3697":73217,"_31245":73188,"_21577":121983,"_5":14884,"_28435":121923,"_3074":52578},[],{"_3697":73218,"_31245":73188,"_21577":121985,"_5":14884,"_28435":121923,"_3074":52581},[],{"_3697":73219,"_31245":73188,"_21577":121987,"_5":14884,"_28435":121923,"_3074":52542},[],{"_3697":73220,"_31245":73188,"_21577":121989,"_5":14884,"_28435":121923,"_3074":52586},[],{"_3697":73221,"_31245":73188,"_21577":121991,"_5":14884,"_28435":121923,"_3074":52589},[],{"_3697":73222,"_31245":73188,"_21577":121993,"_5":14884,"_28435":121923,"_3074":52542},[],{"_3697":73223,"_31245":73188,"_21577":121995,"_5":14884,"_28435":121923,"_3074":52594},[],{"_3697":73224,"_31245":73188,"_21577":121997,"_5":14884,"_28435":121923,"_3074":52597},[],{"_3697":73225,"_31245":73188,"_21577":121999,"_5":14884,"_28435":121923,"_3074":52600},[],{"_3697":73226,"_31245":73188,"_21577":122001,"_5":14884,"_28435":121923,"_3074":52603},[],{"_3697":73227,"_31245":73188,"_21577":122003,"_5":14884,"_28435":121923,"_3074":52606},[],{"_3697":73228,"_31245":73188,"_21577":122005,"_5":14884,"_28435":121923,"_3074":52609},[],{"_3697":73229,"_31245":73188,"_21577":122007,"_5":14884,"_28435":121923,"_3074":122008},[],"Los eventos, las suscripciones y los grupos de dispositivos tienen acciones y filtros propios. Sus listas `relations` están vacías y tienen cero referencias entrantes en el esquema. Para `ca.certificate`, `view_tables` también registra `certificates_view`.",{"_3697":73230,"_31245":73188,"_21577":122010,"_5":14884,"_28435":121923,"_3074":122011},[],"Cada entidad declara sus acciones sobre instancias en `atomic_actions`, sus acciones sin identificador de recurso en `global_actions` y las columnas y tipos que admite en `column_filters` mediante `filterable`.",{"_3697":73231,"_31245":73188,"_21577":122013,"_5":14884,"_28435":121923,"_3074":122014},[],"<Card title=\"Acceso heredado por relaciones\" href=\"/docs/platform/administration/access-control#acceso-heredado-por-relaciones\" />",{"_3697":73232,"_31245":73232,"_5":15238,"_3074":122016,"_31570":122017,"_21577":122018,"_28435":73232},"Visión general del control de acceso",[50948,121910,121911,121912],[],{"_3697":73233,"_31245":73232,"_21577":122020,"_5":14884,"_28435":73232,"_3074":122021},[],"Diseña quién puede acceder a Lamassu mediante principales, políticas, permisos sobre recursos y autorización de rutas HTTP.",{"_3697":73234,"_31245":73232,"_5":31567,"_21577":122023,"_28435":122024,"_3074":122025},[],"/docs/es/platform/administration/access-control#conceptos-esenciales","Conceptos esenciales",{"_3697":73235,"_31245":73232,"_5":31567,"_21577":122027,"_28435":122028,"_3074":122029},[],"/docs/es/platform/administration/access-control#dos-sistemas-de-decisión","Dos sistemas de decisión",{"_3697":73236,"_31245":73232,"_5":31567,"_21577":122031,"_28435":122032,"_3074":122033},[],"/docs/es/platform/administration/access-control#servicios-http-integrados-o-externos","Servicios HTTP integrados o externos",{"_3697":73237,"_31245":73232,"_5":31567,"_21577":122035,"_28435":122036,"_3074":122037},[],"/docs/es/platform/administration/access-control#rutas-solo-de-autenticación-y-rutas-no-mapeadas","Rutas solo de autenticación y rutas no mapeadas",{"_3697":73238,"_31245":73232,"_5":31567,"_21577":122039,"_28435":122040,"_3074":122041},[],"/docs/es/platform/administration/access-control#servicios-desarrollados-por-lamassu","Servicios desarrollados por Lamassu",{"_3697":73239,"_31245":73232,"_5":31567,"_21577":122043,"_28435":122044,"_3074":122045},[],"/docs/es/platform/administration/access-control#cómo-se-relacionan-ambos-caminos","Cómo se relacionan ambos caminos",{"_3697":73240,"_31245":73232,"_5":31567,"_21577":122047,"_28435":122048,"_3074":122049},[],"/docs/es/platform/administration/access-control#principales-oidc","Principales OIDC",{"_3697":73241,"_31245":73232,"_5":31567,"_21577":122051,"_28435":122052,"_3074":122053},[],"/docs/es/platform/administration/access-control#principales-x509","Principales X.509",{"_3697":73242,"_31245":73232,"_5":31567,"_21577":122055,"_28435":122056,"_3074":122057},[],"/docs/es/platform/administration/access-control#cuando-coinciden-varios-principales","Cuando coinciden varios principales",{"_3697":73243,"_31245":73232,"_5":31567,"_21577":122059,"_28435":122060,"_3074":122061},[],"/docs/es/platform/administration/access-control#cómo-expresan-acceso-las-políticas","Cómo expresan acceso las políticas",{"_3697":73244,"_31245":73232,"_5":31567,"_21577":122063,"_28435":122064,"_3074":122065},[],"/docs/es/platform/administration/access-control#acceso-global-y-acceso-directo","Acceso global y acceso directo",{"_3697":73245,"_31245":73232,"_5":31567,"_21577":122067,"_28435":122068,"_3074":122069},[],"/docs/es/platform/administration/access-control#acceso-heredado-por-relaciones","Acceso heredado por relaciones",{"_3697":73246,"_31245":73232,"_5":31567,"_21577":122071,"_28435":122072,"_3074":122073},[],"/docs/es/platform/administration/access-control#acceso-filtrado-por-atributos","Acceso filtrado por atributos",{"_3697":73247,"_31245":73232,"_5":31567,"_21577":122075,"_28435":122076,"_3074":122077},[],"/docs/es/platform/administration/access-control#reglas-http","Reglas HTTP",{"_3697":73248,"_31245":73232,"_5":31567,"_21577":122079,"_28435":122080,"_3074":122081},[],"/docs/es/platform/administration/access-control#políticas-incluidas","Políticas incluidas",{"_3697":73249,"_31245":73232,"_5":31567,"_21577":122083,"_28435":122084,"_3074":121026},[],"/docs/es/platform/administration/access-control#provisiona-el-primer-administrador",{"_3697":73250,"_31245":73232,"_5":31567,"_21577":122086,"_28435":122087,"_3074":122088},[],"/docs/es/platform/administration/access-control#prepara-el-proveedor-de-identidad","Prepara el proveedor de identidad",{"_3697":73251,"_31245":73232,"_5":31567,"_21577":122090,"_28435":122091,"_3074":122092},[],"/docs/es/platform/administration/access-control#configura-la-validación-de-tokens","Configura la validación de tokens",{"_3697":73252,"_31245":73232,"_5":31567,"_21577":122094,"_28435":122095,"_3074":122096},[],"/docs/es/platform/administration/access-control#instala-y-verifica-el-acceso-administrativo","Instala y verifica el acceso administrativo",{"_3697":73253,"_31245":73232,"_5":31567,"_21577":122098,"_28435":122099,"_3074":122100},[],"/docs/es/platform/administration/access-control#prueba-una-identidad-sin-privilegios","Prueba una identidad sin privilegios",{"_3697":73254,"_31245":73232,"_5":31567,"_21577":122102,"_28435":122103,"_3074":122104},[],"/docs/es/platform/administration/access-control#reduce-el-uso-del-administrador-de-bootstrap","Reduce el uso del administrador de bootstrap",{"_3697":73255,"_31245":73232,"_5":31567,"_21577":122106,"_28435":122107,"_3074":122108},[],"/docs/es/platform/administration/access-control#bootstrap-de-fastlane","Bootstrap de Fastlane",{"_3697":73256,"_31245":73232,"_5":31567,"_21577":122110,"_28435":122111,"_3074":122112},[],"/docs/es/platform/administration/access-control#diseña-roles-de-mínimo-privilegio","Diseña roles de mínimo privilegio",{"_3697":73257,"_31245":73232,"_5":31567,"_21577":122114,"_28435":122115,"_3074":122116},[],"/docs/es/platform/administration/access-control#cambios-y-revocación-de-acceso","Cambios y revocación de acceso",{"_3697":73258,"_31245":73232,"_5":31567,"_21577":122118,"_28435":122119,"_3074":122120},[],"/docs/es/platform/administration/access-control#lista-de-comprobación-operativa","Lista de comprobación operativa",{"_3697":73259,"_31245":73232,"_5":31567,"_21577":122122,"_28435":122123,"_3074":122124},[],"/docs/es/platform/administration/access-control#diagnóstico","Diagnóstico",{"_3697":73260,"_31245":73232,"_5":31567,"_21577":122126,"_28435":122127,"_3074":122128},[],"/docs/es/platform/administration/access-control#la-respuesta-es-401","La respuesta es 401",{"_3697":73261,"_31245":73232,"_5":31567,"_21577":122130,"_28435":122131,"_3074":122132},[],"/docs/es/platform/administration/access-control#la-respuesta-es-403","La respuesta es 403",{"_3697":73262,"_31245":73232,"_5":31567,"_21577":122134,"_28435":122135,"_3074":122136},[],"/docs/es/platform/administration/access-control#todo-devuelve-403","Todo devuelve 403",{"_3697":73263,"_31245":73232,"_5":31567,"_21577":122138,"_28435":122139,"_3074":122140},[],"/docs/es/platform/administration/access-control#aparece-acceso-sin-política-concedida","Aparece acceso sin política concedida",{"_3697":73264,"_31245":73232,"_5":31567,"_21577":122142,"_28435":122143,"_3074":122144},[],"/docs/es/platform/administration/access-control#todo-falla-cuando-authz-no-está-disponible","Todo falla cuando authz no está disponible",{"_3697":73265,"_31245":73232,"_21577":122146,"_5":14884,"_28435":73232,"_3074":122147},[],"El control de acceso de Lamassu transforma una identidad autenticada en permisos concretos. El proveedor OIDC o el certificado cliente demuestra **quién** realiza una petición; el servicio `authz` decide **qué puede hacer** esa identidad y **sobre qué recursos**.",{"_3697":73266,"_31245":73232,"_21577":122149,"_5":14884,"_28435":73232,"_3074":122150},[],"Lamassu no asigna permisos directamente a usuarios. La cadena completa es:",{"_3697":73267,"_31245":73232,"_21577":122152,"_5":14884,"_28435":73232,"_3074":122153},[],"Este modelo permite representar personas, grupos del proveedor de identidad, cuentas de servicio y dispositivos sin acoplar la autorización a un proveedor concreto.",{"_3697":73268,"_31245":73232,"_21577":122155,"_5":14884,"_28435":122024,"_3074":122156},[],"Un **principal** conecta una credencial con Lamassu. Define cómo reconocer una identidad OIDC o X.509 y puede estar activo o desactivado.",{"_3697":73269,"_31245":73232,"_21577":122158,"_5":14884,"_28435":122024,"_3074":122159},[],"Una **política** agrupa permisos reutilizables. Puede concederse a varios principales y puede contener reglas sobre entidades de Lamassu, reglas sobre rutas HTTP o ambas.",{"_3697":73270,"_31245":73232,"_21577":122161,"_5":14884,"_28435":122024,"_3074":122162},[],"Una **regla de entidad** concede acciones sobre recursos como autoridades certificadoras, certificados, perfiles de emisión, dispositivos, DMS, claves o suscripciones de alertas. Puede abarcar todos los recursos de un tipo o limitarse por identificador, relación o atributo.",{"_3697":73271,"_31245":73232,"_21577":122164,"_5":14884,"_28435":122024,"_3074":122165},[],"Una **regla HTTP** concede acciones asociadas a rutas de una API. Es el mecanismo que utiliza el Gateway para decidir si una petición puede atravesar el perímetro.",{"_3697":73272,"_31245":73232,"_21577":122167,"_5":14884,"_28435":122024,"_3074":122168},[],"Un **grant** es la asociación entre un principal y una política. Quitar el grant elimina todos los permisos aportados por esa política, sin modificarla para los demás principales.",{"_3697":73273,"_31245":73232,"_21577":122170,"_5":14884,"_28435":122024,"_3074":122171},[],"Un JWT válido o un certificado cliente válido no concede acceso por sí mismo. La credencial debe coincidir con al menos un principal activo y, salvo que el esquema HTTP exima la ruta, alguna de sus políticas debe permitir la operación solicitada. Consulta *Rutas solo de autenticación y rutas no mapeadas* para esas excepciones.",{"_3697":73274,"_31245":73232,"_21577":122173,"_5":14884,"_28435":122028,"_3074":122174},[],"Lamassu utiliza dos caminos de autorización según quién implementa el servicio protegido. Comparten principales, políticas y grants, pero no interpretan las reglas de la misma manera.",{"_3697":73275,"_31245":73232,"_21577":122176,"_5":14884,"_28435":122028,"_3074":122177},[],"Un servicio externo puede quedar protegido sin conocer el modelo interno de autorización de Lamassu. Un servicio desarrollado por Lamassu integra el motor de autorización y puede decidir sobre recursos concretos y filtrar sus consultas.",{"_3697":73276,"_31245":73232,"_21577":122179,"_5":14884,"_28435":122032,"_3074":122180},[],"Este camino protege APIs que se incorporan a la plataforma a través del Gateway pero que no implementan de forma nativa el SDK de autorización de Lamassu. Job Manager es el ejemplo actual. El mismo patrón permite integrar otros servicios HTTP siempre que sus rutas estén descritas en un esquema HTTP de `authz`.",{"_3697":73277,"_31245":73232,"_21577":122182,"_5":14884,"_28435":122032,"_3074":122183},[],"La decisión se toma **antes de reenviar la petición al servicio**:",{"_3697":73278,"_31245":73232,"_21577":122185,"_5":14884,"_28435":122032,"_3074":122186},[],"Envoy Gateway autentica la petición, normalmente validando un JWT contra el JWKS del proveedor OIDC.",{"_3697":73279,"_31245":73232,"_21577":122188,"_5":14884,"_28435":122032,"_3074":122189},[],"Para una ruta protegida, Envoy envía el método, la URL, las cabeceras y los datos necesarios a `/v1/ext_authz/check`.",{"_3697":73280,"_31245":73232,"_21577":122191,"_5":14884,"_28435":122032,"_3074":122192},[],"`authz` extrae la credencial y resuelve todos los principales activos que coinciden con ella.",{"_3697":73281,"_31245":73232,"_21577":122194,"_5":14884,"_28435":122032,"_3074":122195},[],"Carga por separado las políticas concedidas a cada principal.",{"_3697":73282,"_31245":73232,"_21577":122197,"_5":14884,"_28435":122032,"_3074":122198},[],"El esquema HTTP traduce la combinación de método y ruta a una acción lógica, como `nbi-job-read` o `nbi-workflow-create`.",{"_3697":73283,"_31245":73232,"_21577":122200,"_5":14884,"_28435":122032,"_3074":122201},[],"`authz` busca una regla HTTP que conceda esa acción.",{"_3697":73284,"_31245":73232,"_21577":122203,"_5":14884,"_28435":122032,"_3074":122204},[],"Si la ruta declara restricciones, compara datos de la petición con los atributos normalizados del mismo principal que aporta la política; los `param_constraints` de la propia política también fijan la acción concedida a valores literales de la petición.",{"_3697":73285,"_31245":73232,"_21577":122206,"_5":14884,"_28435":122032,"_3074":122207},[],"Un resultado satisfactorio permite a Envoy reenviar la petición; cualquier otra respuesta la bloquea en el Gateway.",{"_3697":73286,"_31245":73232,"_21577":122209,"_5":14884,"_28435":122032,"_3074":122210},[],"Cuando permite el acceso, `authz` devuelve el principal seleccionado en la cabecera de respuesta `X-Principal-ID`. El Gateway puede propagar esa cabecera al servicio para conservar el contexto de identidad. Los clientes no pueden falsificarla: el Gateway elimina la cabecera `X-Principal-Id` suministrada por el cliente (y las demás cabeceras de identidad y certificado reenviadas) antes de reenviar, de modo que solo `authz` puede establecerla. Consulta Expón el Gateway para ver la lista completa de cabeceras eliminadas.",{"_3697":73287,"_31245":73232,"_21577":122212,"_5":14884,"_28435":122032,"_3074":122213},[],"Las reglas HTTP responden principalmente a &#x2A;*“¿puede esta identidad llamar a esta operación de la API?”**. Por sí solas no generan filtros sobre la base de datos del servicio externo. Para limitar una ruta a un dispositivo, tenant o cliente concreto, o bien el esquema declara una restricción que relaciona un valor de la petición con un atributo normalizado del principal, o bien la política fija ese valor de la petición a un literal con `param_constraints`. Lo primero limita cada identidad a sus propios recursos con un único grant; lo segundo restringe un grant a un valor fijo, sin importar quién lo posea.",{"_3697":73288,"_31245":73232,"_21577":122215,"_5":14884,"_28435":122036,"_3074":122216},[],"Dos ajustes del propio esquema cubren endpoints que las políticas no mencionan:",{"_3697":73289,"_31245":73232,"_21577":122218,"_5":14884,"_28435":122036,"_3074":122219},[],"**`skip_authz: true` en una ruta** permite alcanzarla a cualquier identidad que coincida con un principal activo, aunque no tenga políticas concedidas. Úsalo para rutas como `/openapi.json` o `/health` que todo cliente autenticado debería poder consultar. La petición sigue necesitando una autenticación válida: una credencial que no supera la validación o no coincide con ningún principal activo se rechaza antes de considerar este ajuste. Una ruta con `skip_authz` no puede declarar restricciones, y prevalece sobre la ruta o la acción por defecto de cualquier otro esquema para la misma petición.",{"_3697":73290,"_31245":73232,"_21577":122221,"_5":14884,"_28435":122036,"_3074":122222},[],"**`default_action` con `base_paths`** decide qué ocurre cuando una petición cae bajo un prefijo de ruta que el esquema posee pero ninguna ruta explícita coincide. `deny` — el valor con el que se entrega el esquema del Job Manager — convierte la denegación implícita de las rutas no mapeadas en una declaración explícita y auditable; `allow` abre los endpoints no mapeados bajo ese prefijo a cualquier identidad que coincida con un principal activo.",{"_3697":73291,"_31245":73232,"_21577":122224,"_5":14884,"_28435":122036,"_3074":122225},[],"Son decisiones del esquema, no de una política: `skip_authz` elimina la comprobación del grant para esa ruta, incluso cuando otro esquema asigna la misma petición a una acción que exige un grant, y `default_action` solo cubre las peticiones que ninguna ruta explícita de ningún esquema cubre. Ten en cuenta tres reglas:",{"_3697":73292,"_31245":73232,"_21577":122227,"_5":14884,"_28435":122036,"_3074":122228},[],"`default_action` exige al menos una entrada en `base_paths`, y las rutas base son rutas absolutas como `/api/wfx/nbi/v1`.",{"_3697":73293,"_31245":73232,"_21577":122230,"_5":14884,"_28435":122036,"_3074":122231},[],"Una ruta explícita de cualquier esquema tiene prioridad: la acción por defecto solo decide peticiones que ninguna ruta de ningún esquema cubre. Cuando los prefijos de dos esquemas se solapan, decide el prefijo coincidente más largo.",{"_3697":73294,"_31245":73232,"_21577":122233,"_5":14884,"_28435":122036,"_3074":122234},[],"Dos esquemas no pueden reclamar la misma ruta base con acciones por defecto distintas; el esquema en conflicto no llega a cargar.",{"_3697":73295,"_31245":73232,"_21577":122236,"_5":14884,"_28435":122036,"_3074":122237},[],"Una ruta con `skip_authz` y un prefijo con `default_action: \"allow\"` conceden acceso sin consultar ninguna política. Cualquier identidad que coincida con un principal activo puede alcanzar lo que abran, incluidas las identidades sin políticas concedidas. Una ruta con `skip_authz` en un esquema también abre una petición que otro esquema asigna a una acción protegida por un grant. Revisa estos ajustes cada vez que integres o actualices un servicio.",{"_3697":73296,"_31245":73232,"_21577":122239,"_5":14884,"_28435":122036,"_3074":122240},[],"Un esquema también puede hacer que una ruta individual acepte la credencial por la URL. **`query_token: true` en una ruta** hace que acepte el token de acceso OIDC del parámetro de consulta `access_token`, pero solo cuando la petición no lleva ni una cabecera `Authorization: Bearer` ni una cabecera de certificado de cliente: la credencial en una cabecera siempre prevalece. El token se valida y autoriza exactamente igual que un token Bearer, así que la acción de la ruta sigue exigiendo un grant, y las rutas que no activan esta opción nunca leen el parámetro de consulta. La terminal experimental del dashboard usa este mecanismo, porque la conexión WebSocket que abre su cliente de navegador no puede establecer cabeceras de petición.",{"_3697":73297,"_31245":73232,"_21577":122242,"_5":14884,"_28435":122036,"_3074":122243},[],"Las cadenas de consulta suelen quedar registradas. `authz` sustituye el valor de `access_token` por `REDACTED` en sus propios logs de decisión, pero otros logs que capturan la URL —el access log del Gateway, los logs de petición de los servicios, el tracing— no la redactan. Reserva `query_token` para rutas WebSocket y tokens de corta duración.",{"_3697":73298,"_31245":73232,"_21577":122245,"_5":14884,"_28435":122040,"_3074":122246},[],"Los servicios nativos de Lamassu integran autorización en su middleware y conocen las entidades sobre las que operan: certificados, CAs, perfiles de emisión, claves, dispositivos, DMS o suscripciones, entre otras.",{"_3697":73299,"_31245":73232,"_21577":122248,"_5":14884,"_28435":122040,"_3074":122249},[],"La decisión se toma con el contexto de la operación de dominio:",{"_3697":73300,"_31245":73232,"_21577":122251,"_5":14884,"_28435":122040,"_3074":122252},[],"El middleware extrae la credencial y resuelve los principales coincidentes.",{"_3697":73301,"_31245":73232,"_21577":122254,"_5":14884,"_28435":122040,"_3074":122255},[],"El endpoint identifica la acción, el tipo de entidad y, cuando corresponde, la clave del recurso solicitado.",{"_3697":73302,"_31245":73232,"_21577":122257,"_5":14884,"_28435":122040,"_3074":122258},[],"`authz` reúne las reglas de entidad de las políticas concedidas.",{"_3697":73303,"_31245":73232,"_21577":122260,"_5":14884,"_28435":122040,"_3074":122261},[],"El motor evalúa grants directos, filtros por atributos y relaciones con otras entidades.",{"_3697":73304,"_31245":73232,"_21577":122263,"_5":14884,"_28435":122040,"_3074":122264},[],"Para una operación individual, comprueba que el recurso concreto satisface el alcance calculado.",{"_3697":73305,"_31245":73232,"_21577":122266,"_5":14884,"_28435":122040,"_3074":122267},[],"Para un listado, genera un filtro SQL que el servicio añade a su propia consulta.",{"_3697":73306,"_31245":73232,"_21577":122269,"_5":14884,"_28435":122040,"_3074":122270},[],"Aquí el motor responde a &#x2A;*“¿puede esta identidad realizar esta acción sobre este recurso concreto?”**.",{"_3697":73307,"_31245":73232,"_21577":122272,"_5":14884,"_28435":122040,"_3074":122273},[],"Las acciones se dividen en dos grupos:",{"_3697":73308,"_31245":73232,"_21577":122275,"_5":14884,"_28435":122040,"_3074":122276},[],"Las **acciones globales** no necesitan un identificador de recurso. `create`, `import` o el acceso a una sección de la interfaz son ejemplos habituales.",{"_3697":73309,"_31245":73232,"_21577":122278,"_5":14884,"_28435":122040,"_3074":122279},[],"Las **acciones atómicas** se evalúan sobre una instancia concreta. En certificados aparecen `read`, `metadata-update`, `status-update` y `delete`; para una CA también existen `sign`, `reissue` y otras operaciones de ciclo de vida.",{"_3697":73310,"_31245":73232,"_21577":122281,"_5":14884,"_28435":122040,"_3074":122282},[],"El filtrado dentro del servicio evita fugas en listados: los recursos no autorizados quedan fuera de la consulta SQL en lugar de recuperarse y ocultarse después en la interfaz.",{"_3697":73311,"_31245":73232,"_21577":122284,"_5":14884,"_28435":122044,"_3074":122285},[],"No son dos controles equivalentes aplicados dos veces. Las reglas HTTP protegen el perímetro de un servicio integrado; las reglas de entidad expresan permisos sobre el modelo de datos de los servicios nativos.",{"_3697":73312,"_31245":73232,"_21577":122287,"_5":14884,"_28435":122044,"_3074":122288},[],"Una política puede contener ambos tipos de reglas cuando una identidad necesita operar recursos de Lamassu y también llamar a una API integrada. Conceder una regla de entidad no concede automáticamente una acción HTTP, ni una regla HTTP crea acceso sobre una entidad.",{"_3697":73313,"_31245":73232,"_21577":122290,"_5":14884,"_28435":122044,"_3074":122291},[],"Si ninguna combinación de principal, política y regla permite la operación, Lamassu la deniega, salvo que el esquema HTTP declare `skip_authz` en la ruta o `default_action: allow` en una ruta base que la cubra (consulta *Rutas solo de autenticación y rutas no mapeadas*). Además, `auth.externalAuthorization.failOpen` vale `false` por defecto: si `authz` no está disponible, el Gateway bloquea las rutas protegidas.",{"_3697":73314,"_31245":73232,"_21577":122293,"_5":14884,"_28435":122048,"_3074":122294},[],"Un principal OIDC coincide con los claims de un JWT validado. Es apropiado para usuarios humanos, grupos corporativos, roles del IdP y cuentas de servicio que obtienen tokens.",{"_3697":73315,"_31245":73232,"_21577":122296,"_5":14884,"_28435":122048,"_3074":122297},[],"El siguiente principal representa a cualquier identidad que tenga el rol `pki-operators` en Keycloak:",{"_3697":73316,"_31245":73232,"_21577":122299,"_5":14884,"_28435":122048,"_3074":122300},[],"Las rutas de claims pueden estar anidadas, como `realm_access.roles`. Dentro de un mismo principal, **todas** las condiciones deben cumplirse. Esto permite exigir, por ejemplo, un grupo y una audiencia organizativa a la vez.",{"_3697":73317,"_31245":73232,"_21577":122302,"_5":14884,"_28435":122048,"_3074":122303},[],"Los operadores implementados son:",{"_3697":73318,"_31245":73232,"_21577":122305,"_5":14884,"_28435":122048,"_3074":122306},[],"`equals`, para igualdad exacta;",{"_3697":73319,"_31245":73232,"_21577":122308,"_5":14884,"_28435":122048,"_3074":122309},[],"`contains`, para comprobar la pertenencia a una lista o la presencia de texto en un valor escalar.",{"_3697":73320,"_31245":73232,"_21577":122311,"_5":14884,"_28435":122048,"_3074":122312},[],"Diseña la coincidencia con atributos estables. Para personas, suele ser mejor enlazar permisos a grupos o roles gestionados centralmente que al correo o al nombre de usuario. Para una cuenta de servicio, un `sub` estable evita que sus permisos se mezclen con los de un operador humano.",{"_3697":73321,"_31245":73232,"_21577":122314,"_5":14884,"_28435":122048,"_3074":122315},[],"Aunque el modelo reconoce el nombre de operador `matches`, la implementación actual no evalúa expresiones regulares y la condición nunca coincide. Usa `equals` o `contains`.",{"_3697":73322,"_31245":73232,"_21577":122317,"_5":14884,"_28435":122052,"_3074":122318},[],"Un principal X.509 permite reconocer una carga de trabajo o un dispositivo mediante su certificado cliente. Lamassu comprueba la firma del certificado contra la CA configurada y, según el modo, también su número de serie o Common Name.",{"_3697":73323,"_31245":73232,"_21577":122320,"_5":14884,"_28435":122052,"_3074":122321},[],"Los modos disponibles son:",{"_3697":73324,"_31245":73232,"_21577":122323,"_5":14884,"_28435":122052,"_3074":122324},[],"`serial_and_ca`: un certificado exacto, identificado por número de serie y CA;",{"_3697":73325,"_31245":73232,"_21577":122326,"_5":14884,"_28435":122052,"_3074":122327},[],"`cn_and_ca`: un Common Name exacto o con comodines y una CA concreta;",{"_3697":73326,"_31245":73232,"_21577":122329,"_5":14884,"_28435":122052,"_3074":122330},[],"`any_from_ca`: cualquier certificado emitido directamente por la CA indicada.",{"_3697":73327,"_31245":73232,"_21577":122332,"_5":14884,"_28435":122052,"_3074":122333},[],"Este ejemplo reconoce certificados cuyo CN comienza por `factory-a-` y que están firmados por la CA configurada:",{"_3697":73328,"_31245":73232,"_21577":122335,"_5":14884,"_28435":122052,"_3074":122336},[],"`ca_trust.identity_type` acepta `fingerprint` o `authority_key_id`. En ambos casos debes aportar el certificado de la CA en `ca_trust.pem`; Lamassu verifica tanto la firma como la identidad esperada de la CA.",{"_3697":73329,"_31245":73232,"_21577":122338,"_5":14884,"_28435":122052,"_3074":122339},[],"Usa `any_from_ca` únicamente cuando todas las identidades emitidas por esa CA deban compartir los mismos permisos. Si una CA emite certificados para poblaciones distintas, separa el acceso por serie o CN, o utiliza CAs de emisión diferentes.",{"_3697":73330,"_31245":73232,"_21577":122341,"_5":14884,"_28435":122056,"_3074":122342},[],"Una misma credencial puede coincidir con más de un principal. Es habitual que un usuario coincida con un principal de su equipo y con otro de su función operativa.",{"_3697":73331,"_31245":73232,"_21577":122344,"_5":14884,"_28435":122056,"_3074":122345},[],"Para permisos de entidad, Lamassu combina los permisos con lógica OR: basta con que una de las políticas de uno de los principales permita la acción. Los listados contienen la unión de los recursos visibles para todos ellos.",{"_3697":73332,"_31245":73232,"_21577":122347,"_5":14884,"_28435":122056,"_3074":122348},[],"Las rutas HTTP con restricciones son más estrictas. El mismo principal que aporta la política debe satisfacer también los atributos exigidos por la ruta. Lamassu no combina la política de un principal con un atributo perteneciente a otro.",{"_3697":73333,"_31245":73232,"_21577":122350,"_5":14884,"_28435":122056,"_3074":122351},[],"Por esta razón, añadir un principal coincidente solo puede ampliar el acceso. Antes de crear reglas solapadas, revisa el conjunto completo de políticas que recibirá una identidad real.",{"_3697":73334,"_31245":73232,"_21577":122353,"_5":14884,"_28435":122064,"_3074":122354},[],"Una regla identifica el dominio (`namespace`), el esquema de datos (`schema_name`) y el tipo de entidad (`entity_type`). `actions` enumera las operaciones permitidas.",{"_3697":73335,"_31245":73232,"_21577":122356,"_5":14884,"_28435":122064,"_3074":122357},[],"`direct_grants` limita la regla a identificadores concretos. El valor `*` abarca todas las instancias del tipo. Una política de superadministrador utiliza comodines en esquema, entidad, acciones y grants; una política de mínimo privilegio debe evitarlos siempre que sea posible.",{"_3697":73336,"_31245":73232,"_21577":122359,"_5":14884,"_28435":122068,"_3074":122360},[],"Las reglas pueden seguir relaciones declaradas entre entidades. Por ejemplo, el esquema conoce la relación de un certificado con su CA emisora, la de un dispositivo con su DMS y la de un certificado con la clave KMS que almacena su clave privada, de modo que un grant sobre la clave también cubre los certificados que la utilizan. Una política puede conceder acceso a un recurso padre y propagar acciones seleccionadas hacia sus recursos relacionados.",{"_3697":73337,"_31245":73232,"_21577":122362,"_5":14884,"_28435":122068,"_3074":122363},[],"Esto permite expresar modelos como “puede operar los dispositivos de este DMS” sin mantener una lista individual de cada dispositivo. Cuando se añade un recurso bajo esa relación, hereda el alcance previsto por la política.",{"_3697":73338,"_31245":73232,"_21577":122365,"_5":14884,"_28435":122068,"_3074":122366},[],"El modelo de datos muestra cómo se conectan los recursos sobre los que se aplican las reglas de entidad.",{"_3697":73339,"_31245":73232,"_21577":122368,"_5":14884,"_28435":122068,"_3074":122369},[],"Una regla solo puede seguir relaciones que el esquema de datos declare entre sus dos entidades. Puedes referenciar la relación por su nombre o por su columna de clave foránea —ambas formas son equivalentes— y es el esquema el que decide qué columna utiliza la consulta. Al guardar una política, `authz` comprueba cada relación contra los esquemas cargados: una que ningún esquema declare, o que apunte a una entidad no cargada, se rechaza en ese momento.",{"_3697":73340,"_31245":73232,"_21577":122371,"_5":14884,"_28435":122068,"_3074":122372},[],"Las políticas almacenadas antes de esta validación pueden contener todavía relaciones que los esquemas no declaran. Esa relación no concede nada: `authz` registra una advertencia, `skipping relation that grants nothing`, indicando la política y la relación, y continúa evaluando el resto de la política. La referencia siempre se resuelve contra el esquema antes de construir cualquier consulta, por lo que una relación no declarada nunca puede alterarla. Si el acceso heredado se reduce tras una actualización, busca esta advertencia en los logs de `authz` y corrige la relación de la política afectada.",{"_3697":73341,"_31245":73232,"_21577":122374,"_5":14884,"_28435":122072,"_3074":122375},[],"`column_filters` aplica condiciones a columnas que el esquema haya declarado como filtrables. Todos los filtros de una misma regla se combinan con AND.",{"_3697":73342,"_31245":73232,"_21577":122377,"_5":14884,"_28435":122072,"_3074":122378},[],"Por ejemplo, esta regla permite leer certificados activos emitidos por una CA concreta:",{"_3697":73343,"_31245":73232,"_21577":122380,"_5":14884,"_28435":122072,"_3074":122381},[],"Los operadores disponibles son `eq`, `neq`, `gt`, `gte`, `lt`, `lte`, `in` y `like`. Usa comparaciones coherentes con el tipo de columna: `like` para texto, comparaciones de orden para números o fechas y `in` cuando haya una colección de valores aceptados.",{"_3697":73344,"_31245":73232,"_21577":122383,"_5":14884,"_28435":122076,"_3074":122384},[],"Las reglas HTTP no apuntan directamente a tablas. Referencian un esquema de rutas y conceden sus acciones lógicas. Las políticas del Job Manager son un ejemplo: distinguen lectura, creación, actualización y eliminación de workflows o jobs.",{"_3697":73345,"_31245":73232,"_21577":122386,"_5":14884,"_28435":122076,"_3074":122387},[],"Algunas rutas también comparan un valor de la petición —extraído de la ruta, query, cabecera o cuerpo JSON— con un atributo normalizado del principal. Así puede verificarse que un dispositivo solo consulte trabajos dirigidos a su propio `client_id`.",{"_3697":73346,"_31245":73232,"_21577":122389,"_5":14884,"_28435":122076,"_3074":122390},[],"Los atributos normalizados desacoplan la política del mecanismo de autenticación. `subject_attribute_mappings` puede derivar, por ejemplo, `device_id` desde `oidc.claim.device_id` o desde `x509.subject.cn`. La regla consume `device_id` en ambos casos.",{"_3697":73347,"_31245":73232,"_21577":122392,"_5":14884,"_28435":122076,"_3074":122393},[],"Una regla HTTP también puede fijar una acción concedida a un valor literal que la propia petición transporte, mediante `param_constraints`. Extrae el valor con las mismas fuentes que las restricciones de ruta —`path_regex_group`, `query`, `header` o `json_body`— pero lo compara con un literal `equals` escrito en la política, no con un atributo del principal. El grant depende entonces solo de la petición, no de quién posea la política:",{"_3697":73348,"_31245":73232,"_21577":122395,"_5":14884,"_28435":122076,"_3074":122396},[],"Combinada con una ruta del esquema como `^/api/mysvc/system/([^/]+)/info$`, concede `GET /api/mysvc/system/1/info` y deniega la misma llamada para el sistema `2`, con independencia de los atributos del principal. El mismo mecanismo fija parámetros de query, cabeceras o campos del cuerpo JSON, por ejemplo `{ \"source\": \"query\", \"name\": \"tenant_id\" }` con `\"equals\": \"1\"` para aceptar solo peticiones que lleven `?tenant_id=1`.",{"_3697":73349,"_31245":73232,"_21577":122398,"_5":14884,"_28435":122076,"_3074":122399},[],"Ten en cuenta que:",{"_3697":73350,"_31245":73232,"_21577":122401,"_5":14884,"_28435":122076,"_3074":122402},[],"`action` debe estar entre las acciones concedidas por la regla; `equals` es obligatorio; `path_regex_group` necesita un `index` mayor que cero, `query` y `header` un `name`, y `json_body` un `path` como `$.tenant_id`.",{"_3697":73351,"_31245":73232,"_21577":122404,"_5":14884,"_28435":122076,"_3074":122405},[],"`param_constraints` no se coteja con el esquema al cargar la política. Una referencia que la ruta no puede satisfacer —por ejemplo, un `path_regex_group` sobre una ruta sin grupos de captura— simplemente nunca coincide y la petición se deniega.",{"_3697":73352,"_31245":73232,"_21577":122407,"_5":14884,"_28435":122076,"_3074":122408},[],"Varios `param_constraints` para la misma acción se combinan con AND. Una regla sin ellos conserva el comportamiento habitual: la acción se concede donde la ruta coincida y las restricciones del principal se cumplan.",{"_3697":73353,"_31245":73232,"_21577":122410,"_5":14884,"_28435":122080,"_3074":122411},[],"La precarga de `authz` instala políticas reutilizables para los dominios principales. Entre ellas se encuentran:",{"_3697":73354,"_31245":73232,"_21577":122413,"_5":14884,"_28435":122080,"_3074":122414},[],"acceso completo y de solo lectura a certificados y autoridades;",{"_3697":73355,"_31245":73232,"_21577":122416,"_5":14884,"_28435":122080,"_3074":122417},[],"acceso completo y de solo lectura a KMS;",{"_3697":73356,"_31245":73232,"_21577":122419,"_5":14884,"_28435":122080,"_3074":122420},[],"acceso completo y de solo lectura a Device Manager, DMS Manager, Validation Authority y alertas;",{"_3697":73357,"_31245":73232,"_21577":122422,"_5":14884,"_28435":122080,"_3074":122423},[],"una política `Auditor` de lectura de PKI y visibilidad de autorización;",{"_3697":73358,"_31245":73232,"_21577":122425,"_5":14884,"_28435":122080,"_3074":122426},[],"acceso a la interfaz;",{"_3697":73359,"_31245":73232,"_21577":122428,"_5":14884,"_28435":122080,"_3074":122429},[],"políticas de administración y observación para las APIs NBI y SBI del Job Manager;",{"_3697":73360,"_31245":73232,"_21577":122431,"_5":14884,"_28435":122080,"_3074":122432},[],"acceso a la terminal experimental del dashboard (Terminal Network);",{"_3697":73361,"_31245":73232,"_21577":122434,"_5":14884,"_28435":122080,"_3074":122435},[],"`SUPER ADMIN`, que concede todas las acciones sobre los dominios `authz` y `pki`.",{"_3697":73362,"_31245":73232,"_21577":122437,"_5":14884,"_28435":122080,"_3074":122438},[],"Empieza por estas políticas antes de crear otras. Si ninguna refleja el límite que necesitas, crea una política específica y pequeña en lugar de copiar `SUPER ADMIN` y retirar permisos de forma informal.",{"_3697":73363,"_31245":73232,"_21577":122440,"_5":14884,"_28435":122080,"_3074":122441},[],"La política de Terminal Network la crea la precarga de `authz` la próxima vez que `authz` arranque tras la actualización. Las políticas precargadas son políticas del sistema —sus identificadores empiezan por `lamassu.`— y no se pueden editar a través de la API.",{"_3697":73364,"_31245":73232,"_21577":122443,"_5":14884,"_28435":122084,"_3074":122444},[],"Una instalación sin un principal que coincida con tu identidad queda sin nadie capaz de administrar la autorización. Configura el IdP y el bootstrap antes de exponer la plataforma.",{"_3697":73365,"_31245":73232,"_21577":122446,"_5":14884,"_28435":122084,"_3074":122447},[],"El chart incluye un principal de bootstrap que busca el rol OIDC `pki-admin` en `realm_access.roles`. Le concede `SUPER ADMIN` y, cuando Job Manager está habilitado, la política administrativa de su API NBI.",{"_3697":73366,"_31245":73232,"_21577":122449,"_5":14884,"_28435":122084,"_3074":122450},[],"El Job Helm de preinstalación y preactualización ejecuta las migraciones de `authz`, precarga las políticas y crea los principales de bootstrap antes de iniciar los servicios. Si el principal ya existe, no lo reemplaza: añade únicamente los grants configurados que todavía falten. Puedes conservar la entrada en `values.yaml` durante las actualizaciones.",{"_3697":73367,"_31245":73232,"_21577":122452,"_5":14884,"_28435":122087,"_3074":122453},[],"Crea el rol o grupo que utilizarás para recuperar y administrar Lamassu. Asígnalo al menos a dos identidades humanas controladas. Si tu proveedor no usa `realm_access.roles`, adapta la ruta del claim tanto en el frontend como en `auth_config.claims`.",{"_3697":73368,"_31245":73232,"_21577":122455,"_5":14884,"_28435":122091,"_3074":122456},[],"`authz` valida cada token contra `services.authz.jwkUrl`, que se consulta desde el pod de `authz`. El Gateway no valida los tokens por sí mismo: los servicios de Lamassu autorizan cada petición a través de `authz`, y las rutas con la etiqueta `auth=external`, como las de Job Manager, las comprueba el Gateway a través de `authz` cuando `auth.externalAuthorization` está habilitado. El endpoint debe servir las claves del emisor configurado en `auth.oidc.frontend.authority`.",{"_3697":73369,"_31245":73232,"_21577":122458,"_5":14884,"_28435":122091,"_3074":122459},[],"Las releases actualizadas desde 3.8.0 deben eliminar `auth.oidc.apiGateway` y `auth.authorization`, que el chart 4.0.0 rechaza. Consulta 3.8.0 a 4.0.0.",{"_3697":73370,"_31245":73232,"_21577":122461,"_5":14884,"_28435":122095,"_3074":122462},[],"Inicia sesión con una identidad que tenga `pki-admin`. Confirma que puede acceder a la administración de autorización y realizar una operación de lectura no destructiva.",{"_3697":73371,"_31245":73232,"_21577":122464,"_5":14884,"_28435":122099,"_3074":122465},[],"Usa un segundo usuario sin el rol y confirma que la misma operación queda denegada. Esta prueba detecta claims mal interpretados, políticas demasiado amplias y configuraciones `failOpen` accidentales.",{"_3697":73372,"_31245":73232,"_21577":122467,"_5":14884,"_28435":122103,"_3074":122468},[],"Crea principales operativos con políticas de menor alcance. Reserva `pki-admin` para administración de autorización y recuperación, no para el trabajo diario.",{"_3697":73373,"_31245":73232,"_21577":122470,"_5":14884,"_28435":122107,"_3074":122471},[],"Fastlane instala un realm de Keycloak para laboratorio y crea el usuario `lamassu` con contraseña temporal `lamassu`, rol `pki-admin` y cambio de contraseña obligatorio. Su principal de bootstrap coincide mediante `preferred_username=lamassu`.",{"_3697":73374,"_31245":73232,"_21577":122473,"_5":14884,"_28435":122107,"_3074":122474},[],"Cambia la contraseña en el primer acceso. No reutilices el usuario, la contraseña ni el IdP de Fastlane como diseño de producción.",{"_3697":73375,"_31245":73232,"_21577":122476,"_5":14884,"_28435":122111,"_3074":122477},[],"Evita reproducir la estructura interna de tu empresa con decenas de políticas casi idénticas. Empieza por las responsabilidades que realmente necesitan acceso:",{"_3697":73376,"_31245":73232,"_21577":122479,"_5":14884,"_28435":122111,"_3074":122480},[],"**Administración de autorización**: gestiona principales, políticas y grants. Debe pertenecer a un grupo pequeño y separado.",{"_3697":73377,"_31245":73232,"_21577":122482,"_5":14884,"_28435":122111,"_3074":122483},[],"**Operación de PKI**: administra CAs, perfiles y certificados, pero no necesariamente puede modificar quién obtiene acceso.",{"_3697":73378,"_31245":73232,"_21577":122485,"_5":14884,"_28435":122111,"_3074":122486},[],"**Registro de dispositivos**: opera dispositivos y DMS sin recibir permisos sobre claves o configuración de autorización.",{"_3697":73379,"_31245":73232,"_21577":122488,"_5":14884,"_28435":122111,"_3074":122489},[],"**Auditoría**: consulta configuración y actividad sin crear, modificar, firmar, revocar ni eliminar.",{"_3697":73380,"_31245":73232,"_21577":122491,"_5":14884,"_28435":122111,"_3074":122492},[],"**Automatización**: utiliza una cuenta técnica o certificado independiente, con permisos limitados al flujo y recursos que controla.",{"_3697":73381,"_31245":73232,"_21577":122494,"_5":14884,"_28435":122111,"_3074":122495},[],"Para cada rol, separa “ver” de “cambiar”, limita los recursos mediante grants, relaciones o atributos y evita `*` salvo que el rol deba abarcar futuras acciones automáticamente.",{"_3697":73382,"_31245":73232,"_21577":122497,"_5":14884,"_28435":122111,"_3074":122498},[],"Una regla con `actions: [\"*\"]` se expande a todas las acciones definidas por el esquema. Cuando una versión nueva añade una acción, una política con comodín puede empezar a concederla. Revisa estas políticas durante cada actualización.",{"_3697":73383,"_31245":73232,"_21577":122500,"_5":14884,"_28435":122115,"_3074":122501},[],"Para retirar acceso de inmediato, desactiva el principal o revoca sus grants. Desactivar un principal conserva su configuración y asociaciones para investigación o restauración, pero deja de participar en la coincidencia.",{"_3697":73384,"_31245":73232,"_21577":122503,"_5":14884,"_28435":122115,"_3074":122504},[],"Eliminar un rol o grupo en el IdP evita que nuevos tokens contengan el claim, pero un token ya emitido puede seguir siendo válido hasta expirar. Si la retirada es urgente, combina el cambio en el IdP con la desactivación del principal en Lamassu y la revocación de sesiones o tokens en el proveedor.",{"_3697":73385,"_31245":73232,"_21577":122506,"_5":14884,"_28435":122115,"_3074":122507},[],"Cuando edites una política compartida, recuerda que el cambio afecta a todos sus principales. Para probar un nuevo alcance, crea una política separada, concédela a una identidad de prueba y valida operaciones permitidas y denegadas antes de sustituir la anterior.",{"_3697":73386,"_31245":73232,"_21577":122509,"_5":14884,"_28435":122119,"_3074":122510},[],"Mantén `failOpen: false` salvo que una evaluación de riesgo documentada justifique lo contrario.",{"_3697":73387,"_31245":73232,"_21577":122512,"_5":14884,"_28435":122119,"_3074":122513},[],"Usa grupos o roles estables para personas e identidades independientes para automatizaciones.",{"_3697":73388,"_31245":73232,"_21577":122515,"_5":14884,"_28435":122119,"_3074":122516},[],"Conserva al menos dos administradores de recuperación y prueba su acceso periódicamente.",{"_3697":73389,"_31245":73232,"_21577":122518,"_5":14884,"_28435":122119,"_3074":122519},[],"Revisa los principales activos, sus coincidencias y sus grants después de cambios en el IdP.",{"_3697":73390,"_31245":73232,"_21577":122521,"_5":14884,"_28435":122119,"_3074":122522},[],"Busca comodines en políticas antes de actualizar Lamassu.",{"_3697":73391,"_31245":73232,"_21577":122524,"_5":14884,"_28435":122119,"_3074":122525},[],"Revisa las rutas `skip_authz` y los ajustes de `default_action` de los esquemas HTTP al integrar o actualizar un servicio.",{"_3697":73392,"_31245":73232,"_21577":122527,"_5":14884,"_28435":122119,"_3074":122528},[],"Prueba siempre una operación permitida y otra denegada para cada rol.",{"_3697":73393,"_31245":73232,"_21577":122530,"_5":14884,"_28435":122119,"_3074":122531},[],"Correlaciona los cambios de principales, políticas y grants con los registros de auditoría.",{"_3697":73394,"_31245":73232,"_21577":122533,"_5":14884,"_28435":122127,"_3074":122534},[],"La autenticación falló antes de evaluar permisos. Comprueba la firma y expiración del JWT, el emisor, la audiencia y la disponibilidad del JWKS configurado en el Gateway. Para X.509, revisa que el certificado cliente llegue hasta el punto que extrae la credencial.",{"_3697":73395,"_31245":73232,"_21577":122536,"_5":14884,"_28435":122131,"_3074":122537},[],"La credencial pudo procesarse, pero no produjo una autorización positiva. Revisa en este orden:",{"_3697":73396,"_31245":73232,"_21577":122539,"_5":14884,"_28435":122131,"_3074":122540},[],"que exista un principal activo del tipo correcto;",{"_3697":73397,"_31245":73232,"_21577":122542,"_5":14884,"_28435":122131,"_3074":122543},[],"que las rutas de claims y sus valores coincidan exactamente con el token real;",{"_3697":73398,"_31245":73232,"_21577":122545,"_5":14884,"_28435":122131,"_3074":122546},[],"que todas las condiciones del principal se cumplan;",{"_3697":73399,"_31245":73232,"_21577":122548,"_5":14884,"_28435":122131,"_3074":122549},[],"que el principal tenga concedida la política esperada;",{"_3697":73400,"_31245":73232,"_21577":122551,"_5":14884,"_28435":122131,"_3074":122552},[],"que la política incluya la acción y el tipo de recurso o ruta solicitados;",{"_3697":73401,"_31245":73232,"_21577":122554,"_5":14884,"_28435":122131,"_3074":122555},[],"que el identificador, relación, filtro de columna o restricción HTTP incluya el recurso real.",{"_3697":73402,"_31245":73232,"_21577":122557,"_5":14884,"_28435":122131,"_3074":122558},[],"En los logs de `authz`, una decisión del endpoint externo incluye `allowed`, `reason`, `matched_principals`, `evaluated_policy_ids`, `matched_policy_id` y el código de estado. Estos campos permiten separar un fallo de coincidencia de un fallo de permisos. Con las trazas OpenTelemetry habilitadas, una solicitud que llega al motor de políticas genera un span `engine.CheckHTTPRequest` cuyos atributos registran `authz.allowed`, la política coincidente y el principal coincidente. Para correlacionarlo con la traza del Gateway, el contexto de traza debe propagarse hasta authz.",{"_3697":73403,"_31245":73232,"_21577":122560,"_5":14884,"_28435":122131,"_3074":122561},[],"Si una política que dependía de acceso heredado dejó de concederlo tras una actualización, busca en los logs de `authz` el mensaje `skipping relation that grants nothing`: la advertencia indica la política y la relación que los esquemas ya no declaran. Corrige la relación de esa política para que coincida con los esquemas actuales.",{"_3697":73404,"_31245":73232,"_21577":122563,"_5":14884,"_28435":122135,"_3074":122564},[],"Comprueba que el principal de bootstrap fue creado y que las políticas fueron precargadas por el Job de migración. Verifica también que `services.authz.jwkUrl` sea alcanzable desde el pod de `authz`; no asumas que una URL pública accesible desde el navegador también funciona dentro del clúster.",{"_3697":73405,"_31245":73232,"_21577":122566,"_5":14884,"_28435":122139,"_3074":122567},[],"La ruta puede estar cubierta por una decisión del esquema y no por una política: las rutas marcadas con `skip_authz` permiten el paso a cualquier identidad que coincida con un principal activo, y una petición bajo un prefijo de `base_paths` cuyo esquema fija `default_action: allow` también se concede sin consultar políticas. Comprueba cuál de las dos situaciones aplica antes de buscar grants ausentes o mal asignados.",{"_3697":73406,"_31245":73232,"_21577":122569,"_5":14884,"_28435":122143,"_3074":122570},[],"Es el comportamiento esperado con `failOpen: false`. Restaura el servicio, su conexión con PostgreSQL y su conectividad con el JWKS. No cambies temporalmente a `failOpen: true` sin aceptar que las rutas protegidas podrían quedar accesibles sin decisión de autorización.",{"_3697":73407,"_31245":73232,"_21577":122572,"_5":14884,"_28435":122143,"_3074":122573},[],"Continúa con Registros de auditoría para investigar cambios de configuración o con Resolución de problemas para diagnosticar el despliegue.",{"_3697":73408,"_31245":73408,"_5":15238,"_3074":122575,"_31570":122576,"_21577":122577,"_28435":73408},"Alertas y suscripciones",[50948,121910,121911],[],{"_3697":73409,"_31245":73408,"_21577":122579,"_5":14884,"_28435":73408,"_3074":122580},[],"Envía eventos de la PKI a personas y sistemas externos.",{"_3697":73410,"_31245":73408,"_5":31567,"_21577":122582,"_28435":122583,"_3074":122584},[],"/docs/es/platform/administration/alerts#cómo-funciona","Cómo funciona",{"_3697":73411,"_31245":73408,"_5":31567,"_21577":122586,"_28435":122587,"_3074":122588},[],"/docs/es/platform/administration/alerts#canales-disponibles","Canales disponibles",{"_3697":73412,"_31245":73408,"_5":31567,"_21577":122590,"_28435":122591,"_3074":122592},[],"/docs/es/platform/administration/alerts#crea-una-suscripción","Crea una suscripción",{"_3697":73413,"_31245":73408,"_5":31567,"_21577":122594,"_28435":122595,"_3074":122596},[],"/docs/es/platform/administration/alerts#elige-el-evento","Elige el evento",{"_3697":73414,"_31245":73408,"_5":31567,"_21577":122598,"_28435":122599,"_3074":122600},[],"/docs/es/platform/administration/alerts#configura-el-destino","Configura el destino",{"_3697":73415,"_31245":73408,"_5":31567,"_21577":122602,"_28435":122603,"_3074":122604},[],"/docs/es/platform/administration/alerts#limita-las-notificaciones","Limita las notificaciones",{"_3697":73416,"_31245":73408,"_5":31567,"_21577":122606,"_28435":122607,"_3074":122608},[],"/docs/es/platform/administration/alerts#revisa-y-activa","Revisa y activa",{"_3697":73417,"_31245":73408,"_5":31567,"_21577":122610,"_28435":122611,"_3074":122612},[],"/docs/es/platform/administration/alerts#configura-el-cliente-http-del-webhook","Configura el cliente HTTP del webhook",{"_3697":73418,"_31245":73408,"_5":31567,"_21577":122614,"_28435":122615,"_3074":122616},[],"/docs/es/platform/administration/alerts#reglas-de-entrega-del-webhook","Reglas de entrega del webhook",{"_3697":73419,"_31245":73408,"_5":31567,"_21577":122618,"_28435":122619,"_3074":122620},[],"/docs/es/platform/administration/alerts#gestiona-una-suscripción","Gestiona una suscripción",{"_3697":73420,"_31245":73408,"_5":31567,"_21577":122622,"_28435":122623,"_3074":122624},[],"/docs/es/platform/administration/alerts#familias-de-eventos","Familias de eventos",{"_3697":73421,"_31245":73408,"_21577":122626,"_5":14884,"_28435":73408,"_3074":122627},[],"Las suscripciones convierten los eventos de Lamassu en notificaciones accionables. Puedes avisar a un equipo, alimentar un sistema de incidentes o activar una automatización cuando cambia una CA, un certificado o un dispositivo.",{"_3697":73422,"_31245":73408,"_21577":122629,"_5":14884,"_28435":122583,"_3074":122630},[],"Un servicio publica un evento de dominio.",{"_3697":73423,"_31245":73408,"_21577":122632,"_5":14884,"_28435":122583,"_3074":122633},[],"Lamassu evalúa las suscripciones asociadas a ese tipo de evento.",{"_3697":73424,"_31245":73408,"_21577":122635,"_5":14884,"_28435":122583,"_3074":122636},[],"El filtro de cada suscripción decide si debe notificarse.",{"_3697":73425,"_31245":73408,"_21577":122638,"_5":14884,"_28435":122583,"_3074":122639},[],"Lamassu entrega el evento al canal configurado.",{"_3697":73426,"_31245":73408,"_21577":122641,"_5":14884,"_28435":122583,"_3074":122642},[],"El inventario de eventos muestra cuándo se observó cada tipo por última vez, cuántas veces ha ocurrido y cuántas suscripciones tiene. Puedes expandir un evento para inspeccionar un ejemplo de su payload JSON antes de crear el filtro.",{"_3697":73427,"_31245":73408,"_21577":122644,"_5":14884,"_28435":122587,"_3074":122645},[],"**Email** envía avisos a una persona o lista operativa. Solo requiere la dirección de destino. El contenido del evento se entrega como texto HTML escapado, nunca como marcado.",{"_3697":73428,"_31245":73408,"_21577":122647,"_5":14884,"_28435":122587,"_3074":122648},[],"**Microsoft Teams** publica la notificación en un canal mediante su URL de webhook.",{"_3697":73429,"_31245":73408,"_21577":122650,"_5":14884,"_28435":122587,"_3074":122651},[],"**Webhook** entrega el evento a una automatización, SIEM o sistema de incidentes mediante `POST` o `PUT`.",{"_3697":73430,"_31245":73408,"_21577":122653,"_5":14884,"_28435":122587,"_3074":122654},[],"Los canales Microsoft Teams y Webhook aceptan un bloque opcional `http_client` que autentica la llamada al receptor. `auth_mode` selecciona `noauth` (por defecto), `apikey`, `jwt` o `mtls`; cada modo exige sus propias opciones:",{"_3697":73431,"_31245":73408,"_21577":122656,"_5":14884,"_28435":122587,"_3074":122657},[],"`apikey_options` necesita `header` y `key`.",{"_3697":73432,"_31245":73408,"_21577":122659,"_5":14884,"_28435":122587,"_3074":122660},[],"`jwt_options` necesita `oidc_client_id`, `oidc_client_secret` y un `oidc_well_known` absoluto `http` o `https`.",{"_3697":73433,"_31245":73408,"_21577":122662,"_5":14884,"_28435":122587,"_3074":122663},[],"`mtls_options` necesita `cert_content` y `key_content` como PEM codificado en Base64, como el resto de certificados de la API; también se acepta el PEM en claro. Los valores que referencian archivos del servidor se rechazan, y el par debe corresponder a un certificado y una clave privada coincidentes.",{"_3697":73434,"_31245":73408,"_21577":122665,"_5":14884,"_28435":122587,"_3074":122666},[],"La referencia de la API de Alerts documenta el esquema completo de `http_client`.",{"_3697":73435,"_31245":73408,"_21577":122668,"_5":14884,"_28435":122595,"_3074":122669},[],"Abre **Alerts**, localiza el tipo de evento y selecciona **Subscribe**. Revisa el último ejemplo JSON para identificar los campos que necesitarás filtrar.",{"_3697":73436,"_31245":73408,"_21577":122671,"_5":14884,"_28435":122599,"_3074":122672},[],"Selecciona Email, Microsoft Teams o Webhook e introduce los datos del canal.",{"_3697":73437,"_31245":73408,"_21577":122674,"_5":14884,"_28435":122603,"_3074":122675},[],"Añade un filtro si no quieres recibir todas las instancias del evento.",{"_3697":73438,"_31245":73408,"_21577":122677,"_5":14884,"_28435":122603,"_3074":122678},[],"**None** notifica todas las instancias del evento.",{"_3697":73439,"_31245":73408,"_21577":122680,"_5":14884,"_28435":122603,"_3074":122681},[],"**JSON Path** evalúa uno o varios campos concretos.",{"_3697":73440,"_31245":73408,"_21577":122683,"_5":14884,"_28435":122603,"_3074":122684},[],"**JSON Schema** acepta únicamente payloads con una estructura determinada.",{"_3697":73441,"_31245":73408,"_21577":122686,"_5":14884,"_28435":122603,"_3074":122687},[],"**JavaScript** permite expresar lógica personalizada. Cada filtro se ejecuta como máximo durante 100 milisegundos; un filtro que supera ese límite hace fallar la condición y la notificación se omite con el error `javascript filter execution timed out`.",{"_3697":73442,"_31245":73408,"_21577":122689,"_5":14884,"_28435":122603,"_3074":122690},[],"Por ejemplo, `function (event) { return event.data.status == \"NO_IDENTITY\"; }` limita una suscripción a dispositivos sin identidad.",{"_3697":73443,"_31245":73408,"_21577":122692,"_5":14884,"_28435":122603,"_3074":122693},[],"La consola evalúa el filtro contra el JSON del editor **Input Event**, que está prellenado con el último evento, e indica si coincide. Para los filtros JSON Path y JavaScript, muestra **The filter matches this Cloud Event** o **The filter does not match this Cloud Event**. Las expresiones JSON Path se evalúan sobre el Cloud Event completo, así que el valor por defecto, `$.data`, selecciona el campo `data` del evento, y la expresión debe empezar por `$`.",{"_3697":73444,"_31245":73408,"_21577":122695,"_5":14884,"_28435":122607,"_3074":122696},[],"Comprueba el evento, el canal y el filtro en el resumen. Selecciona **Confirm Subscription** para comenzar la entrega.",{"_3697":73445,"_31245":73408,"_21577":122698,"_5":14884,"_28435":122611,"_3074":122699},[],"Los canales Webhook y Microsoft Teams muestran esta configuración en el formulario de suscripción, en el paso del canal, y de nuevo al editar una suscripción; Email no la utiliza. Los campos se corresponden con el bloque opcional `http_client` descrito arriba:",{"_3697":73446,"_31245":73408,"_21577":122701,"_5":14884,"_28435":122611,"_3074":122702},[],"**Log Level** selecciona `debug`, `info`, `warn` o `error`; `info` es el valor por defecto.",{"_3697":73447,"_31245":73408,"_21577":122704,"_5":14884,"_28435":122611,"_3074":122705},[],"**Call Timeout** es de 10 segundos por defecto. La consola rechaza un valor superior a 30 segundos con `Webhook timeout must be at most 30s.`; la API ajusta ese mismo valor al tope en lugar de rechazarlo (ver Las llamadas están limitadas).",{"_3697":73448,"_31245":73408,"_21577":122707,"_5":14884,"_28435":122611,"_3074":122708},[],"No hay interruptor de verificación TLS para estos canales, porque el servicio siempre verifica el certificado del receptor (ver TLS siempre se verifica).",{"_3697":73449,"_31245":73408,"_21577":122710,"_5":14884,"_28435":122611,"_3074":122711},[],"**HTTP Authentication** selecciona `No Authentication` (por defecto), `API Key` (valor de la API key y Header Name, `X-API-Key` por defecto), `OIDC Client Credentials` (Client ID, Client Secret y Well-Known URL) o `Mutual TLS` (Client Certificate y Client Private Key pegados como PEM). Una clave privada guardada permanece oculta hasta que seleccionas **Show**.",{"_3697":73450,"_31245":73408,"_21577":122713,"_5":14884,"_28435":122611,"_3074":122714},[],"Una URL `http://` muestra en la consola la advertencia `Unencrypted HTTP connection` (ver la llamada Credenciales sobre http\\:// más abajo).",{"_3697":73451,"_31245":73408,"_21577":122716,"_5":14884,"_28435":122611,"_3074":122717},[],"Los campos se validan en línea con las mismas reglas de entrega: la URL del webhook y la Well-Known URL de OIDC deben ser URLs absolutas `http` o `https`, una cabecera API-key no puede usar un nombre reservado y el certificado y la clave mTLS deben ser contenido PEM, no rutas de ficheros.",{"_3697":73452,"_31245":73408,"_21577":122719,"_5":14884,"_28435":122611,"_3074":122720},[],"El resumen del paso de confirmación muestra la autenticación como `None`, `OIDC client credentials`, `API key` o `Mutual TLS`. Los detalles de la suscripción muestran la autenticación, el nombre de la cabecera API-key (nunca el valor), la URL del emisor OIDC, mTLS como `Configured` y una fila fija `TLS verification: Verified`. La API key, el client secret y la clave privada no se muestran en los detalles de la suscripción.",{"_3697":73453,"_31245":73408,"_21577":122722,"_5":14884,"_28435":122615,"_3074":122723},[],"Las notificaciones enviadas por los canales Microsoft Teams y Webhook siguen una política HTTP fija:",{"_3697":73454,"_31245":73408,"_21577":122725,"_5":14884,"_28435":122615,"_3074":122726},[],"**TLS siempre se verifica.** El certificado del receptor se comprueba contra el almacén de confianza del sistema. `insecure_skip_verify` se aplica siempre como `false` — también cuando se establece en `true` — así que un receptor con certificado propio o no confiable falla la entrega.",{"_3697":73455,"_31245":73408,"_21577":122728,"_5":14884,"_28435":122615,"_3074":122729},[],"**No se siguen redirecciones.** Una respuesta `3xx` falla con `unexpected status code: <n>: redirects are not followed`. Configura `webhook_url` con la URL final absoluta `http` o `https`: una dirección `http://` que un ingress redirige a `https://` deja de funcionar.",{"_3697":73456,"_31245":73408,"_21577":122731,"_5":14884,"_28435":122615,"_3074":122732},[],"**Las llamadas están limitadas.** Una llamada tiene por defecto un timeout de 10 segundos; un `call_timeout` configurado se limita a 30 segundos. Los valores por encima del tope se ajustan, no se rechazan.",{"_3697":73457,"_31245":73408,"_21577":122734,"_5":14884,"_28435":122615,"_3074":122735},[],"**El cuerpo de la respuesta se ignora.** La entrega comprueba solo el código de estado, así que el receptor puede responder con cualquier cuerpo.",{"_3697":73458,"_31245":73408,"_21577":122737,"_5":14884,"_28435":122615,"_3074":122738},[],"**Las cabeceras API-key están restringidas.** Un `apikey_options.header` propio no puede usar nombres en los que la plataforma o los servicios receptores confían — por ejemplo `X-Principal-Id`, `X-Request-Id`, `Host`, `Content-Type` o `Forwarded` — y ningún nombre puede empezar por `X-Forwarded-`, `X-Envoy-` o `X-Lms-`. La comparación no distingue mayúsculas.",{"_3697":73459,"_31245":73408,"_21577":122740,"_5":14884,"_28435":122615,"_3074":122741},[],"**Las configuraciones inválidas se rechazan al suscribir.** Una configuración de canal que fallaría en cada entrega devuelve HTTP 400 con un cuerpo que empieza por `struct validation error:` y la suscripción no se crea.",{"_3697":73460,"_31245":73408,"_21577":122743,"_5":14884,"_28435":122615,"_3074":122744},[],"Las credenciales se envían sea cual sea el esquema de la URL. Con un `webhook_url` `http://`, la API key o el bearer token viajan en texto claro y mTLS no tiene efecto. Prefiere `https://` para `webhook_url`, `oidc_well_known` y el token endpoint que anuncia.",{"_3697":73461,"_31245":73408,"_21577":122746,"_5":14884,"_28435":122619,"_3074":122747},[],"Abre una suscripción existente para consultar su destino y filtro, modificar la configuración o seleccionar **Unsubscribe**. Elimina las suscripciones que ya no tengan un propietario operativo para evitar entregas ignoradas o endpoints obsoletos.",{"_3697":73462,"_31245":73408,"_21577":122749,"_5":14884,"_28435":122619,"_3074":122750},[],"Las suscripciones creadas con versiones anteriores de la consola pueden guardar el destino del webhook en `url` y `method` en lugar de `webhook_url` y `webhook_method`. El servicio entrega solo a través de `webhook_url` y `webhook_method`, así que una suscripción así no entrega aunque los detalles de la suscripción muestren el destino guardado. Abre la suscripción y vuelve a guardarla: el formulario de edición precarga el destino guardado, y al guardar se reescribe la configuración del canal con el formato actual.",{"_3697":73463,"_31245":73408,"_21577":122752,"_5":14884,"_28435":122623,"_3074":122753},[],"**Autoridades:** `ca.create`, `ca.import`, `ca.reissue` y `ca.delete`.",{"_3697":73464,"_31245":73408,"_21577":122755,"_5":14884,"_28435":122623,"_3074":122756},[],"**Certificados:** `ca.sign.certificate` y `certificate.delete`.",{"_3697":73465,"_31245":73408,"_21577":122758,"_5":14884,"_28435":122623,"_3074":122759},[],"**Perfiles:** `profile.issuance.create`, `profile.issuance.update` y `profile.issuance.delete`.",{"_3697":73466,"_31245":73408,"_21577":122761,"_5":14884,"_28435":122623,"_3074":122762},[],"**Enrolamiento:** `dms.create`, `dms.update`, `dms.enroll` y `dms.reenroll`.",{"_3697":73467,"_31245":73408,"_21577":122764,"_5":14884,"_28435":122623,"_3074":122765},[],"**Dispositivos:** `device.create`, `device.identity.update` y `device.status.update`.",{"_3697":73468,"_31245":73408,"_21577":122767,"_5":14884,"_28435":122623,"_3074":122768},[],"**Validación:** `va.role.crl.create`, `va.crl-settings.init`, `va.crl-settings.update`, `va.crl-settings.finalize`, `va.crl-settings.archive` y `va.crl-settings.delete`.",{"_3697":73469,"_31245":73408,"_21577":122770,"_5":14884,"_28435":122623,"_3074":122771},[],"**Claves:** `kms.create`, `kms.import`, `kms.sign` y `kms.delete`.",{"_3697":73470,"_31245":73408,"_21577":122773,"_5":14884,"_28435":122623,"_3074":122774},[],"Utiliza el catálogo que muestra la consola como fuente para los tipos disponibles en la versión que tienes desplegada.",{"_3697":73471,"_31245":73408,"_21577":122776,"_5":14884,"_28435":122623,"_3074":122777},[],"Desde 4.0.0, `va.crl-settings.init` y `va.crl-settings.update` transportan los ajustes de CRL de una CA (`ca_id`) y sustituyen a `va.role.crl.init` y `va.role.update`. La migración de la actualización renombra automáticamente los tipos de las suscripciones existentes, pero no reescribe sus condiciones: revisa los filtros que lean el payload antiguo o el subject antiguo `crl/<ski>`, incluidos los de `va.role.crl.create` (consulta 3.8.0 a 4.0.0).",{"_3697":73472,"_31245":73408,"_21577":122779,"_5":14884,"_28435":122623,"_3074":122780},[],"La VA publica además `va.crl-settings.finalize` cuando una CA se revoca de forma permanente o caduca, `va.crl-settings.archive` cuando la CA se elimina, y `va.crl-settings.delete` cuando se eliminan ajustes archivados.",{"_3697":73473,"_31245":73473,"_5":15238,"_3074":122782,"_31570":122783,"_21577":122784,"_28435":73473},"Registros de auditoría",[50948,121910,121911],[],{"_3697":73474,"_31245":73473,"_21577":122786,"_5":14884,"_28435":73473,"_3074":122787},[],"Entiende qué eventos de auditoría genera Lamassu y cómo convertirlos en una pista durable.",{"_3697":73475,"_31245":73473,"_5":31567,"_21577":122789,"_28435":122790,"_3074":122791},[],"/docs/es/platform/administration/audit-logs#qué-contiene-un-evento","Qué contiene un evento",{"_3697":73476,"_31245":73473,"_5":31567,"_21577":122793,"_28435":122794,"_3074":122795},[],"/docs/es/platform/administration/audit-logs#cobertura","Cobertura",{"_3697":73477,"_31245":73473,"_5":31567,"_21577":122797,"_28435":122798,"_3074":122799},[],"/docs/es/platform/administration/audit-logs#publicación-y-persistencia","Publicación y persistencia",{"_3697":73478,"_31245":73473,"_5":31567,"_21577":122801,"_28435":122802,"_3074":122803},[],"/docs/es/platform/administration/audit-logs#datos-sensibles","Datos sensibles",{"_3697":73479,"_31245":73473,"_5":31567,"_21577":122805,"_28435":122806,"_3074":122807},[],"/docs/es/platform/administration/audit-logs#una-investigación-reproducible","Una investigación reproducible",{"_3697":73480,"_31245":73473,"_5":31567,"_21577":122809,"_28435":122810,"_3074":122811},[],"/docs/es/platform/administration/audit-logs#acota-el-intervalo","Acota el intervalo",{"_3697":73481,"_31245":73473,"_5":31567,"_21577":122813,"_28435":122814,"_3074":122815},[],"/docs/es/platform/administration/audit-logs#identifica-la-operación","Identifica la operación",{"_3697":73482,"_31245":73473,"_5":31567,"_21577":122817,"_28435":122818,"_3074":122819},[],"/docs/es/platform/administration/audit-logs#atribuye-el-principal","Atribuye el principal",{"_3697":73483,"_31245":73473,"_5":31567,"_21577":122821,"_28435":122822,"_3074":122823},[],"/docs/es/platform/administration/audit-logs#compara-intención-y-resultado","Compara intención y resultado",{"_3697":73484,"_31245":73473,"_5":31567,"_21577":122825,"_28435":122826,"_3074":122827},[],"/docs/es/platform/administration/audit-logs#sigue-el-efecto","Sigue el efecto",{"_3697":73485,"_31245":73473,"_5":31567,"_21577":122829,"_28435":122830,"_3074":122831},[],"/docs/es/platform/administration/audit-logs#verificación-periódica","Verificación periódica",{"_3697":73486,"_31245":73473,"_21577":122833,"_5":14884,"_28435":73473,"_3074":122834},[],"Lamassu instrumenta las operaciones mutables de sus servicios con eventos de auditoría. Cada evento describe la operación, los principales que coincidieron, la entrada, el resultado y si terminó con error.",{"_3697":73487,"_31245":73473,"_21577":122836,"_5":14884,"_28435":122790,"_3074":122837},[],"El cuerpo de auditoría incluye:",{"_3697":73488,"_31245":73473,"_21577":122839,"_5":14884,"_28435":122790,"_3074":122840},[],"input: datos recibidos por la operación;",{"_3697":73489,"_31245":73473,"_21577":122842,"_5":14884,"_28435":122790,"_3074":122843},[],"has\\_error: indica si el servicio devolvió un error;",{"_3697":73490,"_31245":73473,"_21577":122845,"_5":14884,"_28435":122790,"_3074":122846},[],"output: resultado producido o mensaje de error;",{"_3697":73491,"_31245":73473,"_21577":122848,"_5":14884,"_28435":122790,"_3074":122849},[],"principals: identificadores de los principales que coincidieron con la petición.",{"_3697":73492,"_31245":73473,"_21577":122851,"_5":14884,"_28435":122790,"_3074":122852},[],"Las operaciones correctas usan un tipo con prefijo audit.. Los fallos publican el tipo de operación con sufijo .error. El evento CloudEvents añade, además, fuente, identificador, fecha y tipo.",{"_3697":73493,"_31245":73473,"_21577":122854,"_5":14884,"_28435":122790,"_3074":122855},[],"Los middlewares publican el registro después de ejecutar la operación, tanto si tuvo éxito como si devolvió un error. Esto permite investigar intentos además de cambios confirmados.",{"_3697":73494,"_31245":73473,"_21577":122857,"_5":14884,"_28435":122794,"_3074":122858},[],"El backend aplica auditoría a mutaciones de:",{"_3697":73495,"_31245":73473,"_21577":122860,"_5":14884,"_28435":122794,"_3074":122861},[],"autoridades, certificados y perfiles de emisión;",{"_3697":73496,"_31245":73473,"_21577":122863,"_5":14884,"_28435":122794,"_3074":122864},[],"claves y motores KMS;",{"_3697":73497,"_31245":73473,"_21577":122866,"_5":14884,"_28435":122794,"_3074":122867},[],"dispositivos e identidades;",{"_3697":73498,"_31245":73473,"_21577":122869,"_5":14884,"_28435":122794,"_3074":122870},[],"DMS y operaciones de enrolamiento;",{"_3697":73499,"_31245":73473,"_21577":122872,"_5":14884,"_28435":122794,"_3074":122873},[],"funciones de validación y CRL;",{"_3697":73500,"_31245":73473,"_21577":122875,"_5":14884,"_28435":122794,"_3074":122876},[],"principales, políticas y concesiones de autorización.",{"_3697":73501,"_31245":73473,"_21577":122878,"_5":14884,"_28435":122794,"_3074":122879},[],"No confundas estos eventos con los eventos de dominio. Un evento de dominio comunica que un recurso cambió para que otro componente reaccione; el evento de auditoría conserva contexto de entrada, salida y principal para investigación.",{"_3697":73502,"_31245":73473,"_21577":122881,"_5":14884,"_28435":122798,"_3074":122882},[],"Los servicios publican auditoría en el bus de eventos cuando su PublisherEventBus está habilitado. El código del backend no implementa un archivo de auditoría consultable y durable por sí solo.",{"_3697":73503,"_31245":73473,"_21577":122884,"_5":14884,"_28435":122798,"_3074":122885},[],"Si necesitas retención, búsquedas, protección contra alteraciones o exportación regulatoria, conecta un consumidor que persista los eventos en el sistema aprobado por tu organización.",{"_3697":73504,"_31245":73473,"_21577":122887,"_5":14884,"_28435":122798,"_3074":122888},[],"Diseña el consumidor para:",{"_3697":73505,"_31245":73473,"_21577":122890,"_5":14884,"_28435":122798,"_3074":122891},[],"suscribirse a los tipos audit.# y también a los tipos de operación terminados en .error;",{"_3697":73506,"_31245":73473,"_21577":122893,"_5":14884,"_28435":122798,"_3074":122894},[],"conservar el CloudEvent completo sin modificar;",{"_3697":73507,"_31245":73473,"_21577":122896,"_5":14884,"_28435":122798,"_3074":122897},[],"registrar el momento de ingestión y detectar duplicados por ID;",{"_3697":73508,"_31245":73473,"_21577":122899,"_5":14884,"_28435":122798,"_3074":122900},[],"cifrar en tránsito y en reposo;",{"_3697":73509,"_31245":73473,"_21577":122902,"_5":14884,"_28435":122798,"_3074":122903},[],"limitar lectura y borrado a un rol separado del operador de PKI;",{"_3697":73510,"_31245":73473,"_21577":122905,"_5":14884,"_28435":122798,"_3074":122906},[],"aplicar una política explícita de retención y legal hold;",{"_3697":73511,"_31245":73473,"_21577":122908,"_5":14884,"_28435":122798,"_3074":122909},[],"alertar si deja de consumir o aumenta la cola pendiente.",{"_3697":73512,"_31245":73473,"_21577":122911,"_5":14884,"_28435":122802,"_3074":122912},[],"Los campos input y output pueden contener sujetos, metadatos, material público, configuración o mensajes de error. Evalúa su clasificación antes de enviarlos a una plataforma externa.",{"_3697":73513,"_31245":73473,"_21577":122914,"_5":14884,"_28435":122802,"_3074":122915},[],"No registres claves privadas, secretos de proveedores ni tokens completos en automatizaciones que rodean a Lamassu. Restringe la exportación y aplica redacción en el destino sin destruir los campos necesarios para atribución.",{"_3697":73514,"_31245":73473,"_21577":122917,"_5":14884,"_28435":122810,"_3074":122918},[],"Parte de la hora reportada y normaliza todas las fuentes a UTC.",{"_3697":73515,"_31245":73473,"_21577":122920,"_5":14884,"_28435":122814,"_3074":122921},[],"Filtra por tipo de evento, fuente de servicio e identificador del recurso.",{"_3697":73516,"_31245":73473,"_21577":122923,"_5":14884,"_28435":122818,"_3074":122924},[],"Revisa principals y correlaciónalo con el proveedor OIDC o la identidad X.509 vigente en ese momento.",{"_3697":73517,"_31245":73473,"_21577":122926,"_5":14884,"_28435":122822,"_3074":122927},[],"Contrasta input, has\\_error y output. Un intento fallido no implica que el recurso haya cambiado.",{"_3697":73518,"_31245":73473,"_21577":122929,"_5":14884,"_28435":122826,"_3074":122930},[],"Busca los eventos de dominio y registros del servicio que compartan recurso y ventana temporal. En una revocación de CA, incluye las operaciones en cascada.",{"_3697":73519,"_31245":73473,"_21577":122932,"_5":14884,"_28435":122830,"_3074":122933},[],"Genera una mutación controlada en un entorno de prueba y comprueba que:",{"_3697":73520,"_31245":73473,"_21577":122935,"_5":14884,"_28435":122830,"_3074":122936},[],"aparece un evento de auditoría correcto;",{"_3697":73521,"_31245":73473,"_21577":122938,"_5":14884,"_28435":122830,"_3074":122939},[],"el principal coincide con la identidad utilizada;",{"_3697":73522,"_31245":73473,"_21577":122941,"_5":14884,"_28435":122830,"_3074":122942},[],"el consumidor lo persiste una sola vez;",{"_3697":73523,"_31245":73473,"_21577":122944,"_5":14884,"_28435":122830,"_3074":122945},[],"puede recuperarse por recurso, actor y periodo;",{"_3697":73524,"_31245":73473,"_21577":122947,"_5":14884,"_28435":122830,"_3074":122948},[],"una interrupción del consumidor produce una alerta.",{"_3697":73525,"_31245":73473,"_21577":122950,"_5":14884,"_28435":122830,"_3074":122951},[],"Para métricas, trazas y logs técnicos del despliegue, consulta Resolución de problemas. La auditoría responde a “quién intentó cambiar qué”; la observabilidad explica cómo se comportó el sistema.",{"_3697":73526,"_31245":73526,"_5":15238,"_3074":122953,"_31570":122954,"_21577":122955,"_28435":73526},"Arquitectura de la plataforma",[50948,121910],[],{"_3697":73527,"_31245":73526,"_21577":122957,"_5":14884,"_28435":73526,"_3074":122958},[],"Componentes de Lamassu y relación entre control, claves, emisión y dispositivos.",{"_3697":73528,"_31245":73526,"_5":31567,"_21577":122960,"_28435":122961,"_3074":122962},[],"/docs/es/platform/concepts/architecture#plano-de-control","Plano de control",{"_3697":73529,"_31245":73526,"_5":31567,"_21577":122964,"_28435":122965,"_3074":122966},[],"/docs/es/platform/concepts/architecture#custodia-y-operaciones-criptográficas","Custodia y operaciones criptográficas",{"_3697":73530,"_31245":73526,"_5":31567,"_21577":122968,"_28435":122969,"_3074":122970},[],"/docs/es/platform/concepts/architecture#emisión-y-enrolamiento","Emisión y enrolamiento",{"_3697":73531,"_31245":73526,"_5":31567,"_21577":122972,"_28435":122973,"_3074":122974},[],"/docs/es/platform/concepts/architecture#estado-y-validación","Estado y validación",{"_3697":73532,"_31245":73526,"_5":31567,"_21577":122976,"_28435":122977,"_3074":122978},[],"/docs/es/platform/concepts/architecture#dependencias-de-la-plataforma","Dependencias de la plataforma",{"_3697":73533,"_31245":73526,"_21577":122980,"_5":14884,"_28435":73526,"_3074":122981},[],"Lamassu se despliega como un conjunto de servicios independientes. La separación evita que todos los componentes necesiten acceso directo a las claves privadas y permite escalar cada capacidad según la carga.",{"_3697":73534,"_31245":73526,"_21577":122983,"_5":14884,"_28435":73526,"_3074":122984},[],"Cambia al nivel bajo para ver el interior de la caja de la plataforma Lamassu (CA, KMS, DMS, Device Manager, VA, Alerts, el conector de AWS IoT, Job Manager y la consola/API), y al nivel medio para verla como una única plataforma junto a sus dependencias externas.",{"_3697":73535,"_31245":73526,"_21577":122986,"_5":14884,"_28435":122961,"_3074":122987},[],"La consola y las APIs administran autoridades, certificados, DMS, dispositivos, alertas y configuración. Los eventos de dominio permiten que conectores y automatizaciones reaccionen a los cambios sin sondear continuamente la plataforma.",{"_3697":73536,"_31245":73526,"_21577":122989,"_5":14884,"_28435":122965,"_3074":122990},[],"El KMS ofrece una interfaz común sobre motores software, PKCS#11 y proveedores cloud. El motor seleccionado conserva la clave o delega la operación criptográfica sin que los demás servicios conozcan su implementación.",{"_3697":73537,"_31245":73526,"_21577":122992,"_5":14884,"_28435":122969,"_3074":122993},[],"El servicio de CA emite certificados y mantiene la relación con su autoridad. El DMS aplica las reglas de enrolamiento y expone los flujos EST para que un dispositivo solicite o renueve una identidad.",{"_3697":73538,"_31245":73526,"_21577":122995,"_5":14884,"_28435":122973,"_3074":122996},[],"Device Manager conserva la vista operativa del dispositivo y su historial. Validation Authority publica OCSP y CRLs para que otros sistemas decidan si deben confiar en un certificado presentado.",{"_3697":73539,"_31245":73526,"_21577":122998,"_5":14884,"_28435":122977,"_3074":122999},[],"En un despliegue autogestionado, Lamassu utiliza PostgreSQL para persistencia, RabbitMQ para mensajería y un proveedor OIDC para autenticación. Consulta la arquitectura de despliegue para ver cómo se publican los servicios en Kubernetes.",{"_3697":73540,"_31245":73540,"_5":15238,"_3074":123001,"_31570":123002,"_21577":123003,"_28435":73540},"Cómo funciona Lamassu",[50948,121910],[],{"_3697":73541,"_31245":73540,"_21577":123005,"_5":14884,"_28435":73540,"_3074":123006},[],"El modelo mental de confianza, claves, certificados y dispositivos.",{"_3697":73542,"_31245":73540,"_5":31567,"_21577":123008,"_28435":123009,"_3074":123010},[],"/docs/es/platform/concepts/overview#el-modelo-en-cinco-piezas","El modelo en cinco piezas",{"_3697":73543,"_31245":73540,"_5":31567,"_21577":123012,"_28435":123013,"_3074":123014},[],"/docs/es/platform/concepts/overview#del-alta-a-la-operación","Del alta a la operación",{"_3697":73544,"_31245":73540,"_21577":123016,"_5":14884,"_28435":73540,"_3074":123017},[],"Lamassu conecta tres elementos: una **raíz de confianza**, una **política de emisión** y una **entidad que necesita demostrar su identidad**. La plataforma coordina esos elementos durante todo el ciclo de vida del certificado.",{"_3697":73545,"_31245":73540,"_21577":123019,"_5":14884,"_28435":123009,"_3074":123020},[],"**Motor criptográfico.** Genera o custodia claves y ejecuta las operaciones privadas sin exponer el material criptográfico al resto de servicios.",{"_3697":73546,"_31245":73540,"_21577":123022,"_5":14884,"_28435":123009,"_3074":123023},[],"**Autoridad de certificación (CA).** Firma certificados y establece la cadena de confianza.",{"_3697":73547,"_31245":73540,"_21577":123025,"_5":14884,"_28435":123009,"_3074":123026},[],"**Device Management Service (DMS).** Define cómo se registran, autentican y renuevan los dispositivos de una flota.",{"_3697":73548,"_31245":73540,"_21577":123028,"_5":14884,"_28435":123009,"_3074":123029},[],"**Dispositivo.** Conserva su clave privada y presenta el certificado para demostrar su identidad.",{"_3697":73549,"_31245":73540,"_21577":123031,"_5":14884,"_28435":123009,"_3074":123032},[],"**Validation Authority (VA).** Publica el estado de los certificados mediante OCSP y CRL.",{"_3697":73550,"_31245":73540,"_21577":123034,"_5":14884,"_28435":123013,"_3074":123035},[],"Un administrador configura un motor criptográfico y crea o importa una CA.",{"_3697":73551,"_31245":73540,"_21577":123037,"_5":14884,"_28435":123013,"_3074":123038},[],"Un DMS relaciona esa CA con una política de enrolamiento.",{"_3697":73552,"_31245":73540,"_21577":123040,"_5":14884,"_28435":123013,"_3074":123041},[],"El dispositivo genera una clave y solicita un certificado mediante EST, o un operador le asigna una identidad.",{"_3697":73553,"_31245":73540,"_21577":123043,"_5":14884,"_28435":123013,"_3074":123044},[],"Lamassu conserva el inventario, el historial y el estado de la identidad.",{"_3697":73554,"_31245":73540,"_21577":123046,"_5":14884,"_28435":123013,"_3074":123047},[],"Los consumidores comprueban la cadena y consultan OCSP o una CRL cuando necesitan conocer su vigencia.",{"_3697":73555,"_31245":73540,"_21577":123049,"_5":14884,"_28435":123013,"_3074":123050},[],"<Card title=\"Arquitectura\" description=\"Conoce los componentes y dónde termina la responsabilidad de cada uno.\" href=\"/docs/platform/concepts/architecture\" />",{"_3697":73556,"_31245":73540,"_21577":123052,"_5":14884,"_28435":123013,"_3074":123053},[],"<Card title=\"Ciclo de vida de una identidad\" description=\"Sigue un certificado desde el enrolamiento hasta la renovación o revocación.\" href=\"/docs/platform/pki/concepts/certificate-lifecycle\" />",{"_3697":73557,"_31245":73557,"_5":15238,"_3074":123055,"_31570":123056,"_21577":123057,"_28435":73557},"Dispositivos e identidades",[50948,121910,53661,123055],[],{"_3697":73558,"_31245":73557,"_21577":123059,"_5":14884,"_28435":73557,"_3074":123060},[],"Registra, inspecciona y retira dispositivos comprobando su identidad actual y su historial.",{"_3697":73559,"_31245":73557,"_5":31567,"_21577":123062,"_28435":123063,"_3074":123064},[],"/docs/es/platform/iot-fleets/device-management#estados-del-dispositivo","Estados del dispositivo",{"_3697":73560,"_31245":73557,"_5":31567,"_21577":123066,"_28435":123067,"_3074":123068},[],"/docs/es/platform/iot-fleets/device-management#inspecciona-un-dispositivo","Inspecciona un dispositivo",{"_3697":73561,"_31245":73557,"_5":31567,"_21577":123070,"_28435":123071,"_3074":123072},[],"/docs/es/platform/iot-fleets/device-management#api-de-eventos-y-flujo-en-vivo","API de eventos y flujo en vivo",{"_3697":73562,"_31245":73557,"_5":31567,"_21577":123074,"_28435":123075,"_3074":123076},[],"/docs/es/platform/iot-fleets/device-management#registra-un-dispositivo-manualmente","Registra un dispositivo manualmente",{"_3697":73563,"_31245":73557,"_5":31567,"_21577":123078,"_28435":123079,"_3074":123080},[],"/docs/es/platform/iot-fleets/device-management#crea-el-dispositivo","Crea el dispositivo",{"_3697":73564,"_31245":73557,"_5":31567,"_21577":123082,"_28435":123083,"_3074":123084},[],"/docs/es/platform/iot-fleets/device-management#define-su-pertenencia","Define su pertenencia",{"_3697":73565,"_31245":73557,"_5":31567,"_21577":123086,"_28435":123087,"_3074":123088},[],"/docs/es/platform/iot-fleets/device-management#clasifica-el-dispositivo","Clasifica el dispositivo",{"_3697":73566,"_31245":73557,"_5":31567,"_21577":123090,"_28435":123091,"_3074":123092},[],"/docs/es/platform/iot-fleets/device-management#verifica-el-alta","Verifica el alta",{"_3697":73567,"_31245":73557,"_5":31567,"_21577":123094,"_28435":123095,"_3074":123096},[],"/docs/es/platform/iot-fleets/device-management#asigna-una-identidad-manualmente","Asigna una identidad manualmente",{"_3697":73568,"_31245":73557,"_5":31567,"_21577":123098,"_28435":123099,"_3074":123100},[],"/docs/es/platform/iot-fleets/device-management#revoca-la-identidad-actual","Revoca la identidad actual",{"_3697":73569,"_31245":73557,"_5":31567,"_21577":123102,"_28435":123103,"_3074":123104},[],"/docs/es/platform/iot-fleets/device-management#retira-un-dispositivo","Retira un dispositivo",{"_3697":73570,"_31245":73557,"_5":31567,"_21577":123106,"_28435":123107,"_3074":123108},[],"/docs/es/platform/iot-fleets/device-management#automatiza-el-enrolamiento","Automatiza el enrolamiento",{"_3697":73571,"_31245":73557,"_21577":123110,"_5":14884,"_28435":73557,"_3074":123111},[],"Esta guía se dirige al operador de una flota. Necesitas permisos sobre dispositivos, DMS y certificados para las acciones que vayas a realizar. Una flota se organiza mediante esos recursos, etiquetas y metadatos; no se crea un objeto independiente de «flota».",{"_3697":73572,"_31245":73557,"_21577":123113,"_5":14884,"_28435":73557,"_3074":123114},[],"Cada dispositivo tiene un `Device ID`, un DMS propietario (`dms_owner`) y, cuando está aprovisionado, un slot de identidad con una versión activa y versiones anteriores. En los flujos descritos, mantén el `Common Name` de la CSR y del certificado igual al `Device ID`: la vinculación utiliza ese CN para actualizar el dispositivo.",{"_3697":73573,"_31245":73557,"_21577":123116,"_5":14884,"_28435":123063,"_3074":123117},[],"Vista operativa",{"_3697":73574,"_31245":73557,"_21577":123119,"_5":14884,"_28435":123063,"_3074":123120},[],"Interpretación",{"_3697":73575,"_31245":73557,"_21577":123122,"_5":14884,"_28435":123063,"_3074":53728},[],{"_3697":73576,"_31245":73557,"_21577":123124,"_5":14884,"_28435":123063,"_3074":123125},[],"Hay registro, pero todavía no hay identidad asociada.",{"_3697":73577,"_31245":73557,"_21577":123127,"_5":14884,"_28435":123063,"_3074":53734},[],{"_3697":73578,"_31245":73557,"_21577":123129,"_5":14884,"_28435":123063,"_3074":123130},[],"El slot está activo; comprueba además las fechas, estado y usos del certificado.",{"_3697":73579,"_31245":73557,"_21577":123132,"_5":14884,"_28435":123063,"_3074":53740},[],{"_3697":73580,"_31245":73557,"_21577":123134,"_5":14884,"_28435":123063,"_3074":123135},[],"La identidad está en la ventana operativa de renovación.",{"_3697":73581,"_31245":73557,"_21577":123137,"_5":14884,"_28435":123063,"_3074":53746},[],{"_3697":73582,"_31245":73557,"_21577":123139,"_5":14884,"_28435":123063,"_3074":123140},[],"Se aproxima al vencimiento según los umbrales configurados.",{"_3697":73583,"_31245":73557,"_21577":123142,"_5":14884,"_28435":123063,"_3074":53752},[],{"_3697":73584,"_31245":73557,"_21577":123144,"_5":14884,"_28435":123063,"_3074":123145},[],"La identidad ha vencido.",{"_3697":73585,"_31245":73557,"_21577":123147,"_5":14884,"_28435":123063,"_3074":53758},[],{"_3697":73586,"_31245":73557,"_21577":123149,"_5":14884,"_28435":123063,"_3074":123150},[],"La identidad está marcada como revocada. Una suspensión en cascada desde su CA se muestra aquí y se levanta al reactivar esa CA.",{"_3697":73587,"_31245":73557,"_21577":123152,"_5":14884,"_28435":123063,"_3074":53764},[],{"_3697":73588,"_31245":73557,"_21577":123154,"_5":14884,"_28435":123063,"_3074":123155},[],"El registro está retirado y no vuelve al estado operativo mediante una actualización normal.",{"_3697":73589,"_31245":73557,"_21577":123157,"_5":14884,"_28435":123063,"_3074":123158},[],"Los estados de dispositivo, slot y certificado son distintos. Los eventos y trabajos pueden actualizar la vista después de guardar el certificado; una etiqueta **Active** no prueba aceptación por un consumidor.",{"_3697":73590,"_31245":73557,"_21577":123160,"_5":14884,"_28435":123067,"_3074":123161},[],"Filtra el inventario por ID, etiquetas y estado. Abre el detalle y registra DMS propietario, versión activa y serie del certificado actual.",{"_3697":73591,"_31245":73557,"_21577":123163,"_5":14884,"_28435":123067,"_3074":123164},[],"**Certificate History** relaciona versiones anteriores y actuales. Sustituir el slot no revoca por sí solo todas las versiones anteriores.",{"_3697":73592,"_31245":73557,"_21577":123166,"_5":14884,"_28435":123067,"_3074":123167},[],"**Device Event Timeline** ayuda a reconstruir altas, aprovisionamientos, renovaciones y cambios de estado. En el modo **Live**, sigue automáticamente los eventos nuevos y los cambios del dispositivo (como el estado o el propietario) sin recargar la página, y muestra un indicador **Connected** o **Disconnected**. Tras una interrupción se reconecta y recupera sin huecos ni duplicados, de modo que **Live** muestra el mismo contenido que una recarga de la página. Cuando las actualizaciones en vivo no pueden usarse — falta de permisos, dispositivo no encontrado o actualizaciones en vivo no habilitadas en el servidor —, la línea de tiempo muestra `Live updates unavailable: ...` con el motivo, y la navegación por el historial (**Load more**) sigue funcionando. Un cambio puede haberse guardado aunque falle la persistencia de su evento; contrasta también el registro y los certificados.",{"_3697":73593,"_31245":73557,"_21577":123169,"_5":14884,"_28435":123067,"_3074":123170},[],"Compara esos datos con la identidad instalada en el dispositivo. Un slot actualizado en Lamassu no instala archivos en el equipo remoto.",{"_3697":73594,"_31245":73557,"_21577":123172,"_5":14884,"_28435":123071,"_3074":123173},[],"`GET /v1/devices/:id/events` consulta los eventos de un dispositivo y `POST /v1/devices/:id/events` crea uno.",{"_3697":73595,"_31245":73557,"_21577":123175,"_5":14884,"_28435":123071,"_3074":123176},[],"Cuando la cabecera `Accept` de la petición incluye `text/event-stream`, el endpoint de eventos emite por SSE con un keepalive cada 15 segundos, y responde `501` cuando SSE está deshabilitado en el despliegue. La entrega es de tipo best effort: los eventos emitidos mientras no hay ningún cliente conectado no se reenvían en la siguiente conexión. El servidor cierra cada stream tras un tiempo de vida máximo, 10 minutos por omisión y configurable con la opción `sse_max_stream_duration` de Device Manager, y el cliente se reconecta para seguir recibiendo eventos. Cuando una instancia alcanza su límite de suscriptores, configurado con la opción `sse_max_subscribers` de Device Manager (1000 por omisión y compartido por todos los streams de la instancia), los nuevos streams reciben una respuesta `503` con una cabecera `Retry-After`. Cada stream vuelve a comprobar el permiso de lectura del dispositivo mientras está activo, y lo cierra cuando el permiso se revoca o no se puede verificar; la reconexión vuelve a pasar por las comprobaciones de autorización habituales. En un despliegue con Helm, define `services.deviceManager.sseEnabled` como `false` para deshabilitar SSE (por defecto `true`); consulta Flujo de eventos de dispositivo (SSE).",{"_3697":73596,"_31245":73557,"_21577":123178,"_5":14884,"_28435":123071,"_3074":123179},[],"En AMQP, cada instancia de Device Manager enlaza una cola de suscriptores con el nombre de su ID de servicio, `device-manager-sse-<uuid>`. La cola es duradera y auto-delete, con una expiración de una hora (`x-expires`), de modo que el broker la elimina cuando la instancia se detiene o su conexión muere, y no hace falta ninguna política de limpieza. Solo en proveedores de event bus sin soporte de suscriptores efímeros puede quedar una cola duradera por proceso tras detenerse su instancia; revisa esos proveedores si observas colas residuales.",{"_3697":73597,"_31245":73557,"_21577":123181,"_5":14884,"_28435":123075,"_3074":123182},[],"Utiliza este flujo para preparar inventario o asignar una identidad desde la consola. Necesitas un DMS existente.",{"_3697":73598,"_31245":73557,"_21577":123184,"_5":14884,"_28435":123079,"_3074":123185},[],"Desde **Managed Devices**, abre el registro. Confirma que el ID no exista en otro DMS: la búsqueda por ID no está limitada a una flota.",{"_3697":73599,"_31245":73557,"_21577":123187,"_5":14884,"_28435":123083,"_3074":123188},[],"Introduce el **Device ID** y selecciona el DMS que será su propietario. La etiqueta **Registration Authority** de la consola se refiere a ese DMS.",{"_3697":73600,"_31245":73557,"_21577":123190,"_5":14884,"_28435":123087,"_3074":123191},[],"Añade icono y etiquetas de modelo, entorno o ubicación según tu inventario.",{"_3697":73601,"_31245":73557,"_21577":123193,"_5":14884,"_28435":123091,"_3074":123194},[],"Vuelve a leer el dispositivo: debe tener el DMS previsto y estar en **No Identity**. Sigue Registro manual para completar la asignación.",{"_3697":73602,"_31245":73557,"_21577":123196,"_5":14884,"_28435":123091,"_3074":123197},[],"Prerregistrar no demuestra que `/simpleenroll` vaya a admitir la solicitud. Revisa la interacción con `enable_replaceable_enrollment` en Estrategias de aprovisionamiento.",{"_3697":73603,"_31245":73557,"_21577":123199,"_5":14884,"_28435":123095,"_3074":123200},[],"Desde **No Identity**, utiliza **Assign Identity**:",{"_3697":73604,"_31245":73557,"_21577":123202,"_5":14884,"_28435":123095,"_3074":123203},[],"Elige un certificado activo, vigente y adecuado para el consumidor, con `CN` exactamente igual al `Device ID`.",{"_3697":73605,"_31245":73557,"_21577":123205,"_5":14884,"_28435":123095,"_3074":123206},[],"Si no existe, **Issue New Instead** permite iniciar una emisión con la CA prevista. Revisa primero el perfil.",{"_3697":73606,"_31245":73557,"_21577":123208,"_5":14884,"_28435":123095,"_3074":123209},[],"Confirma y vuelve a consultar serie, versión activa e historial.",{"_3697":73607,"_31245":73557,"_21577":123211,"_5":14884,"_28435":123095,"_3074":123212},[],"Instala la pareja clave/certificado y las intermedias necesarias en el dispositivo, y prueba su uso.",{"_3697":73608,"_31245":73557,"_21577":123214,"_5":14884,"_28435":123095,"_3074":123215},[],"Emitir, vincular e instalar son pasos distintos. Si falla la operación, comprueba cuáles se guardaron antes de repetirla.",{"_3697":73609,"_31245":73557,"_21577":123217,"_5":14884,"_28435":123099,"_3074":123218},[],"Localiza la serie activa en el historial y revócala con una razón apropiada. Comprueba registro, publicación OCSP/CRL y rechazo de una conexión nueva en el consumidor con la guía de certificados.",{"_3697":73610,"_31245":73557,"_21577":123220,"_5":14884,"_28435":123099,"_3074":123221},[],"La revocación no elimina el dispositivo. Tampoco habilita automáticamente una nueva inscripción: la recuperación depende de su credencial, estado y política DMS. `CertificateHold` puede reactivarse bajo las condiciones de PKI; otras razones bloquean cambios posteriores del certificado.",{"_3697":73611,"_31245":73557,"_21577":123223,"_5":14884,"_28435":123099,"_3074":123224},[],"Un certificado suspendido por una cascada de suspensión de una CA se muestra como **Revoked** y vuelve a estar activo cuando se reactiva esa CA. Si su certificado caducó durante la suspensión, el trabajo de monitorización lo marca de nuevo como caducado tras la reactivación. Si tú revocas una identidad suspendida, esa revocación es permanente.",{"_3697":73612,"_31245":73557,"_21577":123226,"_5":14884,"_28435":123103,"_3074":123227},[],"Antes de **Decommission**, inventaría identidades activas y anteriores, conexiones y permisos del destino. Prepara su retirada en el consumidor.",{"_3697":73613,"_31245":73557,"_21577":123229,"_5":14884,"_28435":123103,"_3074":123230},[],"El backend guarda **Decommissioned** e intenta revocar el certificado de la versión activa con `CessationOfOperation` si el slot no estaba expirado o revocado. No recorre todo el historial. La revocación diferida puede fallar después de guardar la baja; verifica su resultado por serie.",{"_3697":73614,"_31245":73557,"_21577":123232,"_5":14884,"_28435":123103,"_3074":123233},[],"El estado retirado protege las actualizaciones normales del dispositivo y su slot. No constituye una garantía de que toda solicitud EST sea rechazada antes de emitir: la vinculación puede omitir un dispositivo retirado sin devolver error. Confirma que no quedan certificados o permisos utilizables y bloquea nuevas admisiones en el control correspondiente.",{"_3697":73615,"_31245":73557,"_21577":123235,"_5":14884,"_28435":123103,"_3074":123236},[],"Conserva los registros según tu política de auditoría. No reutilices un ID retirado para ocultar el cambio de equipo.",{"_3697":73616,"_31245":73557,"_21577":123238,"_5":14884,"_28435":123107,"_3074":123239},[],"<Card title=\"Enrola y conecta un dispositivo\" description=\"Obtén una identidad desde el cliente y prueba mTLS.\" href=\"/docs/platform/iot-fleets/quickstarts/enroll-device\" />",{"_3697":73617,"_31245":73557,"_21577":123241,"_5":14884,"_28435":123107,"_3074":123242},[],"<Card title=\"Renovación y recuperación\" description=\"Instala el sucesor y trata fallos sin perder el estado conocido.\" href=\"/docs/platform/iot-fleets/est/configuration\" />",{"_3697":73618,"_31245":73618,"_5":15238,"_3074":123244,"_31570":123245,"_21577":123247,"_28435":73618},"Configura y opera el DMS",[50948,121910,53661,123055,123246],"Enrolamiento con PKI",[],{"_3697":73619,"_31245":73618,"_21577":123249,"_5":14884,"_28435":73618,"_3074":123250},[],"Define registro, autenticación por operación, emisión, renovación y confianza distribuida.",{"_3697":73620,"_31245":73618,"_5":31567,"_21577":123252,"_28435":123253,"_3074":120415},[],"/docs/es/platform/iot-fleets/enrollment/dms#antes-de-empezar",{"_3697":73621,"_31245":73618,"_5":31567,"_21577":123255,"_28435":123256,"_3074":123257},[],"/docs/es/platform/iot-fleets/enrollment/dms#configura-un-dms","Configura un DMS",{"_3697":73622,"_31245":73618,"_5":31567,"_21577":123259,"_28435":123260,"_3074":123261},[],"/docs/es/platform/iot-fleets/enrollment/dms#identifica-la-flota","Identifica la flota",{"_3697":73623,"_31245":73618,"_5":31567,"_21577":123263,"_28435":123264,"_3074":123265},[],"/docs/es/platform/iot-fleets/enrollment/dms#selecciona-la-ca-de-enrolamiento","Selecciona la CA de enrolamiento",{"_3697":73624,"_31245":73618,"_5":31567,"_21577":123267,"_28435":123268,"_3074":123269},[],"/docs/es/platform/iot-fleets/enrollment/dms#configura-est","Configura EST",{"_3697":73625,"_31245":73618,"_5":31567,"_21577":123271,"_28435":123272,"_3074":123273},[],"/docs/es/platform/iot-fleets/enrollment/dms#distribuye-la-confianza","Distribuye la confianza",{"_3697":73626,"_31245":73618,"_5":31567,"_21577":123275,"_28435":123276,"_3074":123277},[],"/docs/es/platform/iot-fleets/enrollment/dms#verifica-los-endpoints","Verifica los endpoints",{"_3697":73627,"_31245":73618,"_5":31567,"_21577":123279,"_28435":123280,"_3074":123281},[],"/docs/es/platform/iot-fleets/enrollment/dms#configuración-del-protocolo","Configuración del protocolo",{"_3697":73628,"_31245":73618,"_5":31567,"_21577":123283,"_28435":123284,"_3074":123285},[],"/docs/es/platform/iot-fleets/enrollment/dms#opera-el-inventario-de-dms","Opera el inventario de DMS",{"_3697":73629,"_31245":73618,"_5":31567,"_21577":123287,"_28435":123288,"_3074":123289},[],"/docs/es/platform/iot-fleets/enrollment/dms#integra-los-dispositivos","Integra los dispositivos",{"_3697":73630,"_31245":73618,"_21577":123291,"_5":14884,"_28435":73618,"_3074":123292},[],"Un &#x2A;*Device Management Service (DMS)** configura la admisión y el ciclo de identidad de sus dispositivos. Actúa como autoridad de registro; la CA indicada en `Enrollment CA` firma los certificados. Esta guía se dirige a quien administra esa política.",{"_3697":73631,"_31245":73618,"_21577":123294,"_5":14884,"_28435":123253,"_3074":123295},[],"Necesitas permisos para gestionar DMS, una CA activa con clave utilizable y un perfil de emisión probado. Acuerda con el integrador ID del dispositivo, credencial inicial, consumidor y ventana de renovación. Revisa la estrategia de aprovisionamiento antes de elegir registro y sustitución.",{"_3697":73632,"_31245":73618,"_21577":123297,"_5":14884,"_28435":123253,"_3074":123298},[],"Prepara confianza del servidor EST y acceso desde el dispositivo con Despliegue. La autenticación administrativa de tu operador no sustituye la autenticación EST del dispositivo.",{"_3697":73633,"_31245":73618,"_21577":123300,"_5":14884,"_28435":123260,"_3074":123301},[],"Crea el DMS con un nombre reconocible y conserva su ID. Las URLs EST utilizan ese identificador, no el nombre visible. Cada dispositivo conserva un DMS propietario.",{"_3697":73634,"_31245":73618,"_21577":123303,"_5":14884,"_28435":123264,"_3074":123304},[],"Elige **Enrollment CA** y un perfil explícito apropiado para la identidad final. Mantén CN compatible con `Device ID`. El certificado de prueba debe permitir el uso previsto y terminar dentro de la vigencia del emisor.",{"_3697":73635,"_31245":73618,"_21577":123306,"_5":14884,"_28435":123268,"_3074":123307},[],"Selecciona registro y autenticación del primer enrolamiento. Configura por separado la autenticación de reenrolamiento, sus umbrales y la retirada del certificado anterior. Deja ServerKeyGen deshabilitado si el cliente genera su clave.",{"_3697":73636,"_31245":73618,"_21577":123309,"_5":14884,"_28435":123272,"_3074":123310},[],"Selecciona los certificados que devolverá `/cacerts`. Incluye explícitamente las intermedias y raíces necesarias, sin confundir distribución con instalación automática de confianza.",{"_3697":73637,"_31245":73618,"_21577":123312,"_5":14884,"_28435":123276,"_3074":123313},[],"Guarda y vuelve a leer la configuración. Consulta `/cacerts`, realiza un enrolamiento permitido y otro rechazado, y comprueba dispositivo, serie e historial. Crear el DMS o descargar cacerts no demuestra que autenticación y emisión funcionen.",{"_3697":73638,"_31245":73618,"_21577":123315,"_5":14884,"_28435":123280,"_3074":123316},[],"Consulta Configuración de EST en el DMS para definir registro, autenticación, emisión, renovación, generación de claves y distribución de confianza.",{"_3697":73639,"_31245":73618,"_21577":123318,"_5":14884,"_28435":123284,"_3074":123319},[],"**Edit** cambia nombre, ajustes y metadatos. Las actualizaciones se realizan mediante la API de DMS. `PUT /v1/dms/{id}` siempre actúa sobre el DMS identificado en la ruta de la URL: el cuerpo no lleva campo `id`, y cualquier `id` o `creation_ts` que contenga se ignora silenciosamente; la autorización se evalúa contra ese mismo identificador de la ruta. El cuerpo debe incluir un `name` no vacío y un objeto `settings`; si falta alguno, la respuesta es HTTP 400 y el DMS almacenado no se modifica. `name` y `settings` se sustituyen siempre por completo, así que lee el DMS antes de enviar una edición por API para no perder campos. `metadata` es opcional: si se omite o se envía `null`, se conservan los metadatos almacenados; un objeto suministrado los sustituye por completo; `{}` los borra (una consulta GET posterior devuelve un objeto vacío, no `null`). Los cuerpos al estilo antiguo que transportan el DMS completo siguen funcionando mientras incluyan `name` y `settings`; los campos desconocidos se ignoran. La actualización rechaza un `name` vacío con HTTP 400: un DMS cuyo nombre almacenado quedó vacío por una actualización anterior debe renombrarse antes de que cualquier cliente lo vuelva a leer y reenviar, incluida la escritura de vuelta del conector de AWS IoT en modo JITP. Si el objeto no incluye la clave del conector de AWS IoT (`lamassu.io/iot/{connector_id}`), el conector ignora los eventos siguientes del DMS.",{"_3697":73640,"_31245":73618,"_21577":123321,"_5":14884,"_28435":123284,"_3074":123322},[],"**Go to DMS owned devices** limita el inventario al propietario. **Show/Edit Metadata** contiene datos operativos y de integraciones; consulta su guía antes de alterarlos. &#x2A;*EST (RFC-7030)** ayuda a localizar las URLs.",{"_3697":73641,"_31245":73618,"_21577":123324,"_5":14884,"_28435":123284,"_3074":123325},[],"**Delete** elimina el registro y la configuración del DMS; no realiza por sí solo una cascada de revocación sobre todos sus dispositivos y certificados. Migra dependencias y conserva las referencias de auditoría antes de retirarlo.",{"_3697":73642,"_31245":73618,"_21577":123327,"_5":14884,"_28435":123288,"_3074":123328},[],"Continúa con Cliente EST o el tutorial de enrolamiento y mTLS. La Referencia EST recoge formatos; Diagnóstico recoge fallos.",{"_3697":73643,"_31245":73643,"_5":15238,"_3074":123246,"_31570":123330,"_21577":123331,"_28435":73643},[50948,121910,53661,123055,123246],[],{"_3697":73644,"_31245":73643,"_21577":123333,"_5":14884,"_28435":73643,"_3074":123334},[],"Prepara la admisión, la política de registro y la emisión de certificados para los dispositivos.",{"_3697":73645,"_31245":73643,"_5":31567,"_21577":123336,"_28435":123337,"_3074":123338},[],"/docs/es/platform/iot-fleets/enrollment/overview#el-recorrido","El recorrido",{"_3697":73646,"_31245":73643,"_5":31567,"_21577":123340,"_28435":123341,"_3074":123342},[],"/docs/es/platform/iot-fleets/enrollment/overview#para-el-administrador","Para el administrador",{"_3697":73647,"_31245":73643,"_5":31567,"_21577":123344,"_28435":123345,"_3074":123346},[],"/docs/es/platform/iot-fleets/enrollment/overview#para-el-integrador","Para el integrador",{"_3697":73648,"_31245":73643,"_21577":123348,"_5":14884,"_28435":73643,"_3074":123349},[],"El enrolamiento con PKI reúne el recorrido desde la admisión del dispositivo hasta la instalación y renovación de su identidad. El DMS actúa como autoridad de registro: autentica la solicitud, aplica la política de registro y pide a la CA que firme. El cliente conserva o recibe la clave, instala el resultado y lo presenta al consumidor.",{"_3697":73649,"_31245":73643,"_21577":123351,"_5":14884,"_28435":123337,"_3074":123352},[],"El administrador prepara CA, perfil de emisión y DMS.",{"_3697":73650,"_31245":73643,"_21577":123354,"_5":14884,"_28435":123337,"_3074":123355},[],"El integrador instala confianza inicial en el servidor EST y una credencial de admisión.",{"_3697":73651,"_31245":73643,"_21577":123357,"_5":14884,"_28435":123337,"_3074":123358},[],"El cliente solicita una identidad para su `Device ID` mediante EST.",{"_3697":73652,"_31245":73643,"_21577":123360,"_5":14884,"_28435":123337,"_3074":123361},[],"Se comprueban certificado, vinculación al dispositivo e instalación de la pareja clave/certificado.",{"_3697":73653,"_31245":73643,"_21577":123363,"_5":14884,"_28435":123337,"_3074":123364},[],"El consumidor valida y autoriza la identidad; el cliente programa renovación y recuperación.",{"_3697":73654,"_31245":73643,"_21577":123366,"_5":14884,"_28435":123337,"_3074":123367},[],"EST utiliza `/.well-known/est/{DMS_ID}`. Las APIs administrativas y la asignación manual siguen siendo recorridos distintos. Enrola y conecta un dispositivo completa una primera prueba con mTLS.",{"_3697":73655,"_31245":73643,"_21577":123369,"_5":14884,"_28435":123341,"_3074":123370},[],"<Card title=\"Estrategias de aprovisionamiento\" description=\"Elige registro automático, prerregistro o asignación manual.\" href=\"/docs/platform/iot-fleets/enrollment/provisioning-strategies\" />",{"_3697":73656,"_31245":73643,"_21577":123372,"_5":14884,"_28435":123341,"_3074":123373},[],"<Card title=\"Configura el DMS\" description=\"Separa admisión, autenticación por operación, perfil y distribución.\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_3697":73657,"_31245":73643,"_21577":123375,"_5":14884,"_28435":123345,"_3074":123376},[],"Consulta EST (RFC 7030) para preparar la autenticación y la confianza inicial, integrar el cliente y mantener la identidad.",{"_3697":73658,"_31245":73643,"_21577":123378,"_5":14884,"_28435":123345,"_3074":123379},[],"La configuración del Gateway, TLS, proveedores y servicios pertenece a Despliegue. El uso de la identidad en AWS u otros destinos corresponde a Integraciones.",{"_3697":73659,"_31245":73659,"_5":15238,"_3074":123381,"_31570":123382,"_21577":123383,"_28435":73659},"Estrategias de aprovisionamiento",[50948,121910,53661,123055,123246],[],{"_3697":73660,"_31245":73659,"_21577":123385,"_5":14884,"_28435":73659,"_3074":123386},[],"Elige cómo se registra el dispositivo, quién autoriza su identidad y dónde se genera la clave.",{"_3697":73661,"_31245":73659,"_5":31567,"_21577":123388,"_28435":123389,"_3074":123390},[],"/docs/es/platform/iot-fleets/enrollment/provisioning-strategies#elige-el-registro","Elige el registro",{"_3697":73662,"_31245":73659,"_5":31567,"_21577":123392,"_28435":123393,"_3074":123394},[],"/docs/es/platform/iot-fleets/enrollment/provisioning-strategies#prerregistro-y-sustitución","Prerregistro y sustitución",{"_3697":73663,"_31245":73659,"_5":31567,"_21577":123396,"_28435":123397,"_3074":123398},[],"/docs/es/platform/iot-fleets/enrollment/provisioning-strategies#elige-la-autenticación","Elige la autenticación",{"_3697":73664,"_31245":73659,"_5":31567,"_21577":123400,"_28435":123401,"_3074":123402},[],"/docs/es/platform/iot-fleets/enrollment/provisioning-strategies#elige-la-custodia","Elige la custodia",{"_3697":73665,"_31245":73659,"_5":31567,"_21577":123404,"_28435":123405,"_3074":123406},[],"/docs/es/platform/iot-fleets/enrollment/provisioning-strategies#comprueba-la-decisión","Comprueba la decisión",{"_3697":73666,"_31245":73659,"_21577":123408,"_5":14884,"_28435":73659,"_3074":123409},[],"Esta guía ayuda al administrador de aprovisionamiento a elegir un recorrido antes de configurar el DMS. Separa tres decisiones: cuándo existe el dispositivo, cómo se autoriza la solicitud y quién genera su clave. Ninguna de ellas concede por sí sola acceso en el destino.",{"_3697":73667,"_31245":73659,"_21577":123411,"_5":14884,"_28435":123389,"_3074":123412},[],"Recorrido",{"_3697":73668,"_31245":73659,"_21577":123414,"_5":14884,"_28435":123389,"_3074":123415},[],"Cuándo existe el dispositivo",{"_3697":73669,"_31245":73659,"_21577":123417,"_5":14884,"_28435":123389,"_3074":123418},[],"Qué compruebas",{"_3697":73670,"_31245":73659,"_21577":123420,"_5":14884,"_28435":123389,"_3074":123421},[],"Asignación manual",{"_3697":73671,"_31245":73659,"_21577":123423,"_5":14884,"_28435":123389,"_3074":123424},[],"El operador lo crea antes de asociar un certificado.",{"_3697":73672,"_31245":73659,"_21577":123426,"_5":14884,"_28435":123389,"_3074":123427},[],"ID, DMS propietario, CN del certificado y serie vinculada.",{"_3697":73673,"_31245":73659,"_21577":123429,"_5":14884,"_28435":123389,"_3074":123430},[],"EST con `JITP`",{"_3697":73674,"_31245":73659,"_21577":123432,"_5":14884,"_28435":123389,"_3074":123433},[],"Se crea para un CN desconocido durante `/simpleenroll`.",{"_3697":73675,"_31245":73659,"_21577":123435,"_5":14884,"_28435":123389,"_3074":123436},[],"Credencial autorizada, ID libre, perfil, alta e identidad resultantes.",{"_3697":73676,"_31245":73659,"_21577":123438,"_5":14884,"_28435":123389,"_3074":123439},[],"EST con `PRE_REGISTRATION`",{"_3697":73677,"_31245":73659,"_21577":123441,"_5":14884,"_28435":123389,"_3074":123442},[],"Debe existir antes de `/simpleenroll`.",{"_3697":73678,"_31245":73659,"_21577":123444,"_5":14884,"_28435":123389,"_3074":123445},[],"Registro aprobado, mismo DMS y condiciones de sustitución de tu versión.",{"_3697":73679,"_31245":73659,"_21577":123447,"_5":14884,"_28435":123389,"_3074":123448},[],"`JITP` de Lamassu crea inventario e identidad en Lamassu. JITP de AWS aprovisiona un destino en AWS; son decisiones diferentes.",{"_3697":73680,"_31245":73659,"_21577":123450,"_5":14884,"_28435":123389,"_3074":123451},[],"Para una primera prueba desde el cliente, utiliza Enrola y conecta un dispositivo. Para preparar inventario sin EST, sigue Registro manual.",{"_3697":73681,"_31245":73659,"_21577":123453,"_5":14884,"_28435":123393,"_3074":123454},[],"Encontrar cualquier dispositivo del mismo DMS activa el control `enable_replaceable_enrollment` antes de comprobar PRE\\_REGISTRATION. Con el flag desactivado, un dispositivo prerregistrado puede recibir `forbiddenNewEnrollment` incluso estando en **No Identity**. No se presenta ese recorrido como garantizado por seleccionar únicamente PRE\\_REGISTRATION.",{"_3697":73682,"_31245":73659,"_21577":123456,"_5":14884,"_28435":123393,"_3074":123457},[],"Activar el flag permite repetir `/simpleenroll` para un ID existente. El backend programa un intento diferido de revocación del certificado anterior con `Superseded`; también puede ejecutarlo si después falla la emisión o vinculación. Si no había identidad, el intento puede fallar por falta de serie. El flag no es una transacción de sustitución ni garantiza restaurar el estado anterior.",{"_3697":73683,"_31245":73659,"_21577":123459,"_5":14884,"_28435":123393,"_3074":123460},[],"Prueba el caso exacto de tu versión antes de habilitarlo en una población. Para una identidad ya operativa y una renovación autorizada, utiliza `/simplereenroll`; para recuperar una identidad, sigue Renovación y recuperación y confirma el estado persistido antes de reintentar.",{"_3697":73684,"_31245":73659,"_21577":123462,"_5":14884,"_28435":123397,"_3074":123463},[],"Decide por separado primer enrolamiento y reenrolamiento:",{"_3697":73685,"_31245":73659,"_21577":123465,"_5":14884,"_28435":123397,"_3074":123466},[],"**Certificado cliente:** útil cuando cada equipo dispone de una credencial inicial cuya clave controla.",{"_3697":73686,"_31245":73659,"_21577":123468,"_5":14884,"_28435":123397,"_3074":123469},[],"**Webhook:** útil cuando otra autoridad conoce inventario, credenciales o derecho a solicitar un ID.",{"_3697":73687,"_31245":73659,"_21577":123471,"_5":14884,"_28435":123397,"_3074":123472},[],"**Certificado y webhook:** exige ambos controles en la operación configurada.",{"_3697":73688,"_31245":73659,"_21577":123474,"_5":14884,"_28435":123397,"_3074":123475},[],"**NO\\_AUTH:** no acredita al solicitante; solo encaja cuando el control de admisión se resuelve de forma deliberada fuera de ese DMS.",{"_3697":73689,"_31245":73659,"_21577":123477,"_5":14884,"_28435":123397,"_3074":123478},[],"Autenticar un certificado inicial no demuestra por sí solo el derecho a elegir cualquier CN en la CSR. Define esa autorización en Identidad inicial y autenticación.",{"_3697":73690,"_31245":73659,"_21577":123480,"_5":14884,"_28435":123401,"_3074":120779},[],{"_3697":73691,"_31245":73659,"_21577":123482,"_5":14884,"_28435":123401,"_3074":123483},[],"Material que atraviesa EST",{"_3697":73692,"_31245":73659,"_21577":123485,"_5":14884,"_28435":123401,"_3074":123486},[],"Clave generada por el dispositivo",{"_3697":73693,"_31245":73659,"_21577":123488,"_5":14884,"_28435":123401,"_3074":123489},[],"CSR pública y certificado; la clave permanece en el cliente.",{"_3697":73694,"_31245":73659,"_21577":123491,"_5":14884,"_28435":123401,"_3074":123492},[],"Clave ya disponible en el dispositivo",{"_3697":73695,"_31245":73659,"_21577":123494,"_5":14884,"_28435":123401,"_3074":123495},[],"CSR firmada con la clave existente y certificado nuevo.",{"_3697":73696,"_31245":73659,"_21577":123497,"_5":14884,"_28435":123401,"_3074":54110},[],{"_3697":73697,"_31245":73659,"_21577":123499,"_5":14884,"_28435":123401,"_3074":123500},[],"Clave privada PKCS#8 y certificado en una respuesta multipart protegida por TLS.",{"_3697":73698,"_31245":73659,"_21577":123502,"_5":14884,"_28435":123401,"_3074":123503},[],"Elegir ServerKeyGen no utiliza automáticamente el HSM o KMS de la CA para la clave del dispositivo. Revisa su contrato y extracción y la capacidad del dispositivo para instalar el material.",{"_3697":73699,"_31245":73659,"_21577":123505,"_5":14884,"_28435":123405,"_3074":123506},[],"Antes de extender el flujo, prueba alta permitida, credencial incorrecta, ID de otro DMS, solicitud repetida y recuperación tras un fallo. Conserva ID, serie, versión activa y error. Comprueba también aceptación y rechazo en el consumidor; un certificado emitido no implica que el destino lo conozca o permita operar.",{"_3697":73700,"_31245":73700,"_5":15238,"_3074":123508,"_31570":123509,"_21577":123510,"_28435":73700},"Autenticación y confianza",[50948,121910,53661,54123],[],{"_3697":73701,"_31245":73700,"_21577":123512,"_5":14884,"_28435":73700,"_3074":123513},[],"Prepara las credenciales, la autenticación y la distribución de confianza para EST.",{"_3697":73702,"_31245":73700,"_5":31567,"_21577":123515,"_28435":123516,"_3074":123517},[],"/docs/es/platform/iot-fleets/est/bootstrap-identity#confianza-inicial-del-servidor","Confianza inicial del servidor",{"_3697":73703,"_31245":73700,"_5":31567,"_21577":123519,"_28435":123520,"_3074":123521},[],"/docs/es/platform/iot-fleets/est/bootstrap-identity#credencial-bootstrap","Credencial bootstrap",{"_3697":73704,"_31245":73700,"_5":31567,"_21577":123523,"_28435":123524,"_3074":123525},[],"/docs/es/platform/iot-fleets/est/bootstrap-identity#modos-por-operación","Modos por operación",{"_3697":73705,"_31245":73700,"_5":31567,"_21577":123527,"_28435":123528,"_3074":123529},[],"/docs/es/platform/iot-fleets/est/bootstrap-identity#contrato-del-webhook","Contrato del webhook",{"_3697":73706,"_31245":73700,"_5":31567,"_21577":123531,"_28435":123532,"_3074":123533},[],"/docs/es/platform/iot-fleets/est/bootstrap-identity#revocación-y-comprobaciones","Revocación y comprobaciones",{"_3697":73707,"_31245":73700,"_21577":123535,"_5":14884,"_28435":73700,"_3074":123536},[],"Esta guía conecta al administrador DMS con quien fabrica o integra el dispositivo. Antes de solicitar su identidad operativa, el cliente debe poder autenticar al servidor EST y demostrar que tiene derecho a solicitar el ID previsto.",{"_3697":73708,"_31245":73700,"_21577":123538,"_5":14884,"_28435":123516,"_3074":123539},[],"Instala una raíz, cadena o pin previamente verificado mediante un canal confiable: fabricación, configuración aprobada o distribución autenticada. Ese material permite verificar TLS y el nombre del servidor antes de descargar `/cacerts`.",{"_3697":73709,"_31245":73700,"_21577":123541,"_5":14884,"_28435":123516,"_3074":123542},[],"No puedes obtener tu única prueba de confianza del mismo servidor todavía no autenticado. El certificado TLS del servidor EST, el certificado bootstrap y la CA emisora de la identidad operativa pueden pertenecer a jerarquías distintas.",{"_3697":73710,"_31245":73700,"_21577":123544,"_5":14884,"_28435":123520,"_3074":123545},[],"Con `CLIENT_CERTIFICATE`, el dispositivo presenta su certificado inicial y demuestra posesión de su clave en TLS. El DMS lo valida frente a sus CAs de admisión. El validador recibe una credencial de hoja: configura y prueba el emisor directo para el caso sencillo; enviar más intermedias desde el cliente no demuestra que lleguen al servicio.",{"_3697":73711,"_31245":73700,"_21577":123547,"_5":14884,"_28435":123520,"_3074":123548},[],"Comprueba fechas, certificado y clave correspondientes y estado de revocación antes de provisionarlos. Una credencial compartida entre equipos identifica esa credencial compartida, no a un equipo concreto.",{"_3697":73712,"_31245":73700,"_21577":123550,"_5":14884,"_28435":123520,"_3074":123551},[],"En el primer enrolamiento, la validación mTLS no compara por sí sola el CN del bootstrap con el CN solicitado en la CSR. Si necesitas que un solicitante solo pueda pedir su propio `Device ID`, añade un control que vincule credencial e ID, por ejemplo el webhook combinado, y prueba una solicitud con otro CN. En reenrolamiento con certificado sí se compara su CN con el de la CSR; las comprobaciones posteriores utilizan la identidad activa registrada.",{"_3697":73713,"_31245":73700,"_21577":123553,"_5":14884,"_28435":123524,"_3074":123554},[],"Los cuatro modos se seleccionan independientemente para enrolamiento y reenrolamiento en DMS. La credencial utilizada al renovar depende de ese bloque; no presupongas que siempre será el bootstrap o que el webhook desaparezca.",{"_3697":73714,"_31245":73700,"_21577":123556,"_5":14884,"_28435":123524,"_3074":123557},[],"Un token OIDC de administración no es un modo EST nativo. Un webhook puede interpretar una cabecera de credencial que acuerdes con él; en ese caso la autorización la realiza ese servicio. En NO\\_AUTH, enviar un token no añade autenticación al DMS.",{"_3697":73715,"_31245":73700,"_21577":123559,"_5":14884,"_28435":123528,"_3074":123560},[],"El DMS envía el contexto de la operación al servicio configurado. El método procede de la configuración; acuerda su contrato antes de seleccionar POST o PUT. La espera de autorización tiene un valor inicial de 10 segundos, sustituido por un timeout positivo configurado. El DMS verifica el certificado del receptor salvo que se active `insecure_skip_verify` en la configuración del webhook (por defecto se verifica) y no sigue redirecciones, así que la URL configurada debe ser la final. La respuesta de autorización debe ser JSON de como máximo 1 MiB. Con la autenticación de Lamassu hacia el webhook configurada sobre `http://`, la API key o el bearer token viajan en texto claro, y mTLS no tiene efecto porque no hay handshake TLS, así que el certificado de cliente nunca se presenta; prefiere `https://`. Configura esas opciones en los ajustes del webhook externo de la guía DMS.",{"_3697":73716,"_31245":73700,"_21577":123562,"_5":14884,"_28435":123528,"_3074":123563},[],"Ejemplo de cuerpo:",{"_3697":73717,"_31245":73700,"_21577":123565,"_5":14884,"_28435":123528,"_3074":123566},[],"`csr` contiene **base64 del PEM**, a diferencia del cuerpo EST, que contiene base64 del DER. `http_request` recoge URL y primeras entradas de cabeceras del contexto HTTP disponible. El campo `operation` no se envía en este cuerpo; distingue enroll y reenroll mediante la ruta y la política configurada.",{"_3697":73718,"_31245":73700,"_21577":123568,"_5":14884,"_28435":123528,"_3074":123569},[],"El webhook debe verificar la credencial, su relación con `device_cn`, DMS, operación y política de admisión. Las cabeceras transportadas no son por sí mismas evidencia de confianza. La autenticación de **Lamassu hacia el webhook** es otra relación distinta que se configura en el cliente HTTP del servidor.",{"_3697":73719,"_31245":73700,"_21577":123571,"_5":14884,"_28435":123528,"_3074":123572},[],"La continuación requiere respuesta HTTP satisfactoria y JSON:",{"_3697":73720,"_31245":73700,"_21577":123574,"_5":14884,"_28435":123528,"_3074":123575},[],"Un `204` sin cuerpo no cumple el contrato. Rechazo, error de transporte, respuesta no interpretable o timeout abortan la autorización. En modo combinado, primero se valida el certificado y después se consulta el webhook. Consulta la especificación del webhook.",{"_3697":73721,"_31245":73700,"_21577":123577,"_5":14884,"_28435":123532,"_3074":123578},[],"El DMS busca primero el certificado presentado en Lamassu; los certificados que emitió y gestiona se comprueban con su estado almacenado. Los certificados externos se comprueban mediante sus servidores OCSP y, después, sus puntos de distribución CRL. Por defecto, una revocación no verificable es un rechazo, no una aceptación: un certificado que no gestiona Lamassu y no lista ningún endpoint OCSP o CRL se rechaza, salvo que se active `allow_unverifiable_revocation` en el bloque de esa operación (consulta Autenticación por operación).",{"_3697":73722,"_31245":73700,"_21577":123580,"_5":14884,"_28435":123532,"_3074":123581},[],"Un certificado que sí lista endpoints se exige con un estándar más estricto, con o sin la opción: los endpoints que no responden, la evidencia caducada o inválida o un estado no concluyente (desconocido) rechazan el certificado. La evidencia debe estar fresca (`thisUpdate` no en el futuro, `nextUpdate` no superado, y una respuesta sin `nextUpdate` solo se acepta mientras tenga menos de unas 24 horas) y las respuestas OCSP deben estar firmadas por el propio emisor del certificado o por un responder delegado que lleve el EKU `id-kp-OCSPSigning` y esté dentro de su validez. Un veredicto de revocado se respeta con independencia de su antigüedad. Cada solicitud OCSP o CRL tiene un timeout de 10 segundos.",{"_3697":73723,"_31245":73700,"_21577":123583,"_5":14884,"_28435":123532,"_3074":123584},[],"Queda un matiz: una respuesta OCSP Good o una CRL firmadas y capturadas antes de una revocación siguen validando hasta su `nextUpdate` (hasta unas 24 horas sin `nextUpdate`). La revocación se propaga a los dispositivos al ritmo con que los responders publican evidencia, no en el momento de la revocación.",{"_3697":73724,"_31245":73700,"_21577":123586,"_5":14884,"_28435":123532,"_3074":123587},[],"Prueba certificado permitido, certificado incorrecto, CN ajeno, webhook denegado, timeout y reenrolamiento bajo su propia política. Conserva el resultado y programa la retirada de las credenciales bootstrap cuando corresponda. Continúa con Cliente EST.",{"_3697":73725,"_31245":73725,"_5":15238,"_3074":123589,"_31570":123590,"_21577":123591,"_28435":73725},"EST en Lamassu",[50948,121910,53661,54123],[],{"_3697":73726,"_31245":73725,"_21577":123593,"_5":14884,"_28435":73725,"_3074":123594},[],"Configura las operaciones EST, la autenticación y la distribución de confianza.",{"_3697":73727,"_31245":73725,"_5":31567,"_21577":123596,"_28435":123597,"_3074":123598},[],"/docs/es/platform/iot-fleets/est/configuration#referencia-de-endpoints","Referencia de endpoints",{"_3697":73728,"_31245":73725,"_5":31567,"_21577":123600,"_28435":123601,"_3074":123602},[],"/docs/es/platform/iot-fleets/est/configuration#autenticación-por-operación","Autenticación por operación",{"_3697":73729,"_31245":73725,"_5":31567,"_21577":123604,"_28435":123605,"_3074":123606},[],"/docs/es/platform/iot-fleets/est/configuration#certificado-de-cliente","Certificado de cliente",{"_3697":73730,"_31245":73725,"_5":31567,"_21577":123608,"_28435":123609,"_3074":123610},[],"/docs/es/platform/iot-fleets/est/configuration#ajustes-del-webhook-externo","Ajustes del webhook externo",{"_3697":73731,"_31245":73725,"_5":31567,"_21577":123612,"_28435":123613,"_3074":120415},[],"/docs/es/platform/iot-fleets/est/configuration#antes-de-empezar",{"_3697":73732,"_31245":73725,"_5":31567,"_21577":123615,"_28435":123616,"_3074":54231},[],"/docs/es/platform/iot-fleets/est/configuration#cacerts",{"_3697":73733,"_31245":73725,"_5":31567,"_21577":123618,"_28435":123619,"_3074":123620},[],"/docs/es/platform/iot-fleets/est/configuration#distribución-de-confianza","Configuración",{"_3697":73734,"_31245":73725,"_5":31567,"_21577":123622,"_28435":123623,"_3074":123624},[],"/docs/es/platform/iot-fleets/est/configuration#petición-y-respuesta-de-cacerts","Petición y respuesta",{"_3697":73735,"_31245":73725,"_5":31567,"_21577":123626,"_28435":123627,"_3074":123628},[],"/docs/es/platform/iot-fleets/est/configuration#descarga-e-inspecciona-cacerts","Ejemplo",{"_3697":73736,"_31245":73725,"_5":31567,"_21577":123630,"_28435":123631,"_3074":54247},[],"/docs/es/platform/iot-fleets/est/configuration#simpleenroll",{"_3697":73737,"_31245":73725,"_5":31567,"_21577":123633,"_28435":123634,"_3074":123620},[],"/docs/es/platform/iot-fleets/est/configuration#configuración-de-enrollment",{"_3697":73738,"_31245":73725,"_5":31567,"_21577":123636,"_28435":123637,"_3074":123624},[],"/docs/es/platform/iot-fleets/est/configuration#petición-y-respuesta-de-simpleenroll",{"_3697":73739,"_31245":73725,"_5":31567,"_21577":123639,"_28435":123640,"_3074":123628},[],"/docs/es/platform/iot-fleets/est/configuration#ejemplo-de-enrolamiento-inicial",{"_3697":73740,"_31245":73725,"_5":31567,"_21577":123642,"_28435":123643,"_3074":54260},[],"/docs/es/platform/iot-fleets/est/configuration#simplereenroll",{"_3697":73741,"_31245":73725,"_5":31567,"_21577":123645,"_28435":123646,"_3074":123620},[],"/docs/es/platform/iot-fleets/est/configuration#configuración-de-re-enrollment",{"_3697":73742,"_31245":73725,"_5":31567,"_21577":123648,"_28435":123649,"_3074":123624},[],"/docs/es/platform/iot-fleets/est/configuration#petición-y-respuesta-de-simplereenroll",{"_3697":73743,"_31245":73725,"_5":31567,"_21577":123651,"_28435":123652,"_3074":123628},[],"/docs/es/platform/iot-fleets/est/configuration#ejemplo-de-renovación",{"_3697":73744,"_31245":73725,"_5":31567,"_21577":123654,"_28435":123655,"_3074":123656},[],"/docs/es/platform/iot-fleets/est/configuration#recupera-según-el-estado","Recupera según el estado",{"_3697":73745,"_31245":73725,"_5":31567,"_21577":123658,"_28435":123659,"_3074":54277},[],"/docs/es/platform/iot-fleets/est/configuration#serverkeygen",{"_3697":73746,"_31245":73725,"_5":31567,"_21577":123661,"_28435":123662,"_3074":123620},[],"/docs/es/platform/iot-fleets/est/configuration#configuración-de-serverkeygen",{"_3697":73747,"_31245":73725,"_5":31567,"_21577":123664,"_28435":123665,"_3074":123624},[],"/docs/es/platform/iot-fleets/est/configuration#petición-y-respuesta-de-serverkeygen",{"_3697":73748,"_31245":73725,"_5":31567,"_21577":123667,"_28435":123668,"_3074":123628},[],"/docs/es/platform/iot-fleets/est/configuration#solicitud-y-extracción",{"_3697":73749,"_31245":73725,"_21577":123670,"_5":14884,"_28435":73725,"_3074":123671},[],"Cada DMS expone en Lamassu las operaciones EST que sus dispositivos usan para obtener y renovar su identidad. Esta página describe las rutas, cómo se autentica cada operación, los ajustes del DMS que gobiernan cada endpoint y ejemplos de petición con curl y OpenSSL. Para crear y administrar el DMS, consulta la guía del DMS; para preparar las credenciales y la confianza inicial del dispositivo, Autenticación y confianza.",{"_3697":73750,"_31245":73725,"_21577":123673,"_5":14884,"_28435":123597,"_3074":123674},[],"Cada DMS publica sus operaciones en `/.well-known/est/{APS}/{operation}`, donde `APS` es el ID del DMS, no su nombre visible. La configuración del Gateway determina el host y la ruta públicos. El router también admite rutas sin el segmento `APS`, pero el controlador lo requiere, así que no las utilices.",{"_3697":73751,"_31245":73725,"_21577":123676,"_5":14884,"_28435":123597,"_3074":121670},[],{"_3697":73752,"_31245":73725,"_21577":123678,"_5":14884,"_28435":123597,"_3074":123679},[],"Método",{"_3697":73753,"_31245":73725,"_21577":123681,"_5":14884,"_28435":123597,"_3074":123682},[],"Autenticación y condición",{"_3697":73754,"_31245":73725,"_21577":123684,"_5":14884,"_28435":123597,"_3074":54304},[],{"_3697":73755,"_31245":73725,"_21577":123686,"_5":14884,"_28435":123597,"_3074":54307},[],{"_3697":73756,"_31245":73725,"_21577":123688,"_5":14884,"_28435":123597,"_3074":123689},[],"No exige credencial EST; HTTPS y los controles de infraestructura siguen aplicándose.",{"_3697":73757,"_31245":73725,"_21577":123691,"_5":14884,"_28435":123597,"_3074":54313},[],{"_3697":73758,"_31245":73725,"_21577":123693,"_5":14884,"_28435":123597,"_3074":54316},[],{"_3697":73759,"_31245":73725,"_21577":123695,"_5":14884,"_28435":123597,"_3074":123696},[],"Autenticación inicial y política de registro y sustitución del DMS.",{"_3697":73760,"_31245":73725,"_21577":123698,"_5":14884,"_28435":123597,"_3074":54322},[],{"_3697":73761,"_31245":73725,"_21577":123700,"_5":14884,"_28435":123597,"_3074":54316},[],{"_3697":73762,"_31245":73725,"_21577":123702,"_5":14884,"_28435":123597,"_3074":123703},[],"Autenticación de renovación, identidad existente, sujeto, revocación y ventana.",{"_3697":73763,"_31245":73725,"_21577":123705,"_5":14884,"_28435":123597,"_3074":54330},[],{"_3697":73764,"_31245":73725,"_21577":123707,"_5":14884,"_28435":123597,"_3074":54316},[],{"_3697":73765,"_31245":73725,"_21577":123709,"_5":14884,"_28435":123597,"_3074":123710},[],"Autenticación inicial y generación de claves habilitada.",{"_3697":73766,"_31245":73725,"_21577":123712,"_5":14884,"_28435":123597,"_3074":123713},[],"Lamassu no implementa `/csrattrs` ni `/fullcmc`. Tampoco hay un modo EST nativo de autenticación JWT; un webhook puede interpretar una credencial de la petición según su propio contrato.",{"_3697":73767,"_31245":73725,"_21577":123715,"_5":14884,"_28435":123601,"_3074":123716},[],"El DMS autentica la solicitud antes de aplicar las reglas de registro y emisión. Cada operación lee su autenticación de un bloque `est_rfc7030_settings` propio:",{"_3697":73768,"_31245":73725,"_21577":123718,"_5":14884,"_28435":123601,"_3074":123719},[],"`settings.enrollment_settings.est_rfc7030_settings` para `/simpleenroll` y `/serverkeygen`.",{"_3697":73769,"_31245":73725,"_21577":123721,"_5":14884,"_28435":123601,"_3074":123722},[],"`settings.reenrollment_settings.est_rfc7030_settings` para `/simplereenroll`.",{"_3697":73770,"_31245":73725,"_21577":123724,"_5":14884,"_28435":123601,"_3074":123725},[],"Los dos bloques se almacenan por separado y uno no hereda del otro, así que lee ambos antes de editar. `auth_mode` admite estos valores:",{"_3697":73771,"_31245":73725,"_21577":123727,"_5":14884,"_28435":123601,"_3074":54353},[],{"_3697":73772,"_31245":73725,"_21577":123729,"_5":14884,"_28435":123601,"_3074":123730},[],"Control aplicado en la operación configurada",{"_3697":73773,"_31245":73725,"_21577":123732,"_5":14884,"_28435":123601,"_3074":54359},[],{"_3697":73774,"_31245":73725,"_21577":123734,"_5":14884,"_28435":123601,"_3074":123735},[],"Validación del certificado presentado.",{"_3697":73775,"_31245":73725,"_21577":123737,"_5":14884,"_28435":123601,"_3074":54365},[],{"_3697":73776,"_31245":73725,"_21577":123739,"_5":14884,"_28435":123601,"_3074":123740},[],"Autorización del webhook configurado.",{"_3697":73777,"_31245":73725,"_21577":123742,"_5":14884,"_28435":123601,"_3074":54371},[],{"_3697":73778,"_31245":73725,"_21577":123744,"_5":14884,"_28435":123601,"_3074":123745},[],"Validación del certificado y, después, aprobación del webhook.",{"_3697":73779,"_31245":73725,"_21577":123747,"_5":14884,"_28435":123601,"_3074":54377},[],{"_3697":73780,"_31245":73725,"_21577":123749,"_5":14884,"_28435":123601,"_3074":123750},[],"Sin autenticación del solicitante por el DMS.",{"_3697":73781,"_31245":73725,"_21577":123752,"_5":14884,"_28435":123601,"_3074":123753},[],"Los modos con webhook también se ejecutan en el reenrolamiento si se configuran en su bloque. Un modo ausente o no reconocido hace fallar la operación: no hay una degradación implícita a `NO_AUTH`. `NO_AUTH` no acredita la propiedad del ID solicitado.",{"_3697":73782,"_31245":73725,"_21577":123755,"_5":14884,"_28435":123605,"_3074":123756},[],"Los modos con certificado leen `client_certificate_settings` en el mismo bloque:",{"_3697":73783,"_31245":73725,"_21577":123758,"_5":14884,"_28435":123605,"_3074":123759},[],"Campo",{"_3697":73784,"_31245":73725,"_21577":123761,"_5":14884,"_28435":123605,"_3074":123762},[],"Descripción",{"_3697":73785,"_31245":73725,"_21577":123764,"_5":14884,"_28435":123605,"_3074":54395},[],{"_3697":73786,"_31245":73725,"_21577":123766,"_5":14884,"_28435":123605,"_3074":123767},[],"IDs de las CAs frente a las que se valida el certificado presentado. Se usa la primera que lo valida.",{"_3697":73787,"_31245":73725,"_21577":123769,"_5":14884,"_28435":123605,"_3074":54401},[],{"_3697":73788,"_31245":73725,"_21577":123771,"_5":14884,"_28435":123605,"_3074":123772},[],"**Allow expired certificates**: acepta certificados vencidos en el enrolamiento inicial.",{"_3697":73789,"_31245":73725,"_21577":123774,"_5":14884,"_28435":123605,"_3074":54407},[],{"_3697":73790,"_31245":73725,"_21577":123776,"_5":14884,"_28435":123605,"_3074":123777},[],"Si es mayor que 0, solo se validan ese número de certificados de la cadena presentada.",{"_3697":73791,"_31245":73725,"_21577":123779,"_5":14884,"_28435":123605,"_3074":54413},[],{"_3697":73792,"_31245":73725,"_21577":123781,"_5":14884,"_28435":123605,"_3074":123782},[],"**Allow certificates without revocation information**: acepta certificados sin información de revocación; `false` por defecto.",{"_3697":73793,"_31245":73725,"_21577":123784,"_5":14884,"_28435":123605,"_3074":123785},[],"El validador recibe una credencial de certificado; el flujo no garantiza transportar hasta él todas las intermedias del handshake. Para el caso directo, configura como CA de validación el emisor directo del bootstrap y prueba la ruta real del Gateway.",{"_3697":73794,"_31245":73725,"_21577":123787,"_5":14884,"_28435":123605,"_3074":123788},[],"**Revocación.** En el enrolamiento inicial se comprueban el certificado de cliente y todas las CAs intermedias entre él y la CA de validación, cada una frente a su emisor; los certificados adicionales que envíe el dispositivo en el handshake se ignoran. Los certificados gestionados por Lamassu se comprueban con su estado almacenado, y los externos mediante sus endpoints OCSP y CRL. La operación falla cerrada cuando la revocación no puede verificarse: los endpoints que no responden, la evidencia caducada o inválida y los estados no concluyentes rechazan siempre el certificado. Una CA de validación revocada en Lamassu también rechaza la operación, sin recurrir a las demás CAs de validación. Revocación y comprobaciones detalla la evidencia que deben presentar los endpoints.",{"_3697":73795,"_31245":73725,"_21577":123790,"_5":14884,"_28435":123605,"_3074":123791},[],"`allow_unverifiable_revocation` relaja solo un caso: un certificado, o una CA intermedia de la cadena, que Lamassu no gestiona y que no declara ningún endpoint OCSP o CRL. Con la opción activada ese certificado se acepta aunque esté revocado, y la consola muestra el aviso **Revocation will not be verified**. La opción se configura por separado en el bloque de enrolamiento y en el de reenrolamiento, y está desactivada en los DMS creados antes de que existiera.",{"_3697":73796,"_31245":73725,"_21577":123793,"_5":14884,"_28435":123605,"_3074":123794},[],"**Reenrolamiento.** El validador prueba primero la CA de enrolamiento y después las `validation_cas` del bloque de reenrolamiento. Esa lista es opcional porque la CA de enrolamiento siempre es confiable, y las CAs que solo figuran en la `validation_cas` del bloque inicial no amplían la aceptación: durante una rotación de CAs, añade la CA de emisión anterior a la lista del bloque de reenrolamiento. El validador compara solo la hoja TLS presentada con esas CAs y comprueba únicamente su revocación. En este bloque `chain_level_validation` y `allow_expired` se almacenan pero no se consultan; el vencimiento lo rige `enable_expired_renewal`.",{"_3697":73797,"_31245":73725,"_21577":123796,"_5":14884,"_28435":123609,"_3074":123797},[],"Los modos con webhook leen `external_webhook_settings` en el mismo bloque `est_rfc7030_settings`. Estos ajustes definen el destino, el método, el timeout y cómo se autentica Lamassu ante el receptor; el contrato del webhook describe la credencial del dispositivo, el cuerpo de la llamada y la respuesta esperada.",{"_3697":73798,"_31245":73725,"_21577":123799,"_5":14884,"_28435":123609,"_3074":123800},[],"Campo de `external_webhook_settings`",{"_3697":73799,"_31245":73725,"_21577":123802,"_5":14884,"_28435":123609,"_3074":123803},[],"Decisión",{"_3697":73800,"_31245":73725,"_21577":123805,"_5":14884,"_28435":123609,"_3074":54440},[],{"_3697":73801,"_31245":73725,"_21577":123807,"_5":14884,"_28435":123609,"_3074":123808},[],"URL absoluta `http` o `https` del receptor. Debe ser la URL final; no se siguen redirecciones.",{"_3697":73802,"_31245":73725,"_21577":123810,"_5":14884,"_28435":123609,"_3074":54446},[],{"_3697":73803,"_31245":73725,"_21577":123812,"_5":14884,"_28435":123609,"_3074":123813},[],"`POST` o `PUT`; `POST` por defecto.",{"_3697":73804,"_31245":73725,"_21577":123815,"_5":14884,"_28435":123609,"_3074":54452},[],{"_3697":73805,"_31245":73725,"_21577":123817,"_5":14884,"_28435":123609,"_3074":123818},[],"Etiqueta usada en los logs del servicio.",{"_3697":73806,"_31245":73725,"_21577":123820,"_5":14884,"_28435":123609,"_3074":54458},[],{"_3697":73807,"_31245":73725,"_21577":123822,"_5":14884,"_28435":123609,"_3074":123823},[],"`noauth`, `apikey`, `jwt` o `mtls`. Un valor ausente o desconocido se comporta como `noauth`.",{"_3697":73808,"_31245":73725,"_21577":123825,"_5":14884,"_28435":123609,"_3074":54464},[],{"_3697":73809,"_31245":73725,"_21577":123827,"_5":14884,"_28435":123609,"_3074":123828},[],"Nivel de log de la llamada del webhook: `debug`, `info`, `warn` o `error`; `info` por defecto.",{"_3697":73810,"_31245":73725,"_21577":123830,"_5":14884,"_28435":123609,"_3074":54470},[],{"_3697":73811,"_31245":73725,"_21577":123832,"_5":14884,"_28435":123609,"_3074":123833},[],"Obligatorios para `apikey`: `header` y `key`. Los nombres de cabecera reservados se rechazan.",{"_3697":73812,"_31245":73725,"_21577":123835,"_5":14884,"_28435":123609,"_3074":54476},[],{"_3697":73813,"_31245":73725,"_21577":123837,"_5":14884,"_28435":123609,"_3074":123838},[],"Obligatorios para `jwt`: `oidc_client_id`, `oidc_client_secret` y un `oidc_well_known` absoluto `http` o `https`.",{"_3697":73814,"_31245":73725,"_21577":123840,"_5":14884,"_28435":123609,"_3074":54482},[],{"_3697":73815,"_31245":73725,"_21577":123842,"_5":14884,"_28435":123609,"_3074":123843},[],"Obligatorios para `mtls`: `cert_content` y `key_content` como PEM codificado en Base64, como el resto de certificados de la API; también se acepta el PEM en claro.",{"_3697":73816,"_31245":73725,"_21577":123845,"_5":14884,"_28435":123609,"_3074":54488},[],{"_3697":73817,"_31245":73725,"_21577":123847,"_5":14884,"_28435":123609,"_3074":123848},[],"Con `true`, omite la verificación del certificado del receptor. Por defecto se verifica. A diferencia de los canales de alertas, este ajuste se respeta aquí.",{"_3697":73818,"_31245":73725,"_21577":123850,"_5":14884,"_28435":123609,"_3074":54494},[],{"_3697":73819,"_31245":73725,"_21577":123852,"_5":14884,"_28435":123609,"_3074":123853},[],"Duración máxima de la llamada de autorización (por ejemplo `10s`); 10 segundos por defecto.",{"_3697":73820,"_31245":73725,"_21577":123855,"_5":14884,"_28435":123609,"_3074":123856},[],"Crear o actualizar un DMS que usa el webhook en alguno de sus bloques valida esta configuración. Si no es válida, la respuesta es HTTP 400, con un cuerpo que empieza por `struct validation error:` y continúa con `invalid enrollment external webhook config` o `invalid reenrollment external webhook config`. Estas reglas se aplican:",{"_3697":73821,"_31245":73725,"_21577":123858,"_5":14884,"_28435":123609,"_3074":123859},[],"La URL, el método y las opciones deben ser válidos, y `mtls_options.cert_content` y `key_content` deben corresponderse con un certificado y una clave privada coincidentes.",{"_3697":73822,"_31245":73725,"_21577":123861,"_5":14884,"_28435":123609,"_3074":123862},[],"Las referencias a archivos (`ca_cert_file`, `mtls_options.cert_file`, `mtls_options.key_file`) nunca son válidas, porque el servicio no lee archivos. Introduce el certificado y la clave como PEM, codificado en Base64 o en claro, en `cert_content` y `key_content`.",{"_3697":73823,"_31245":73725,"_21577":123864,"_5":14884,"_28435":123609,"_3074":123865},[],"Un `apikey_options.header` propio no puede usar nombres en los que la plataforma o el servicio receptor confían (por ejemplo `X-Principal-Id`, `X-Request-Id`, `Host`, `Content-Type` o `Forwarded`), y ningún nombre puede empezar por `X-Forwarded-`, `X-Envoy-` o `X-Lms-` (sin distinguir mayúsculas). La referencia de la API DMS documenta los esquemas `WebhookCall` y `WebhookCallHttpClient`.",{"_3697":73824,"_31245":73725,"_21577":123867,"_5":14884,"_28435":123609,"_3074":123868},[],"Con `config.auth_mode` a `apikey`, `jwt` o `mtls`, el cuerpo debe llevar su bloque de opciones (`apikey_options`, `jwt_options` o `mtls_options`) y ningún otro. Los nombres heredados `apikey`, `oidc` y `mtls` fallan la validación, y `validate_server_cert` se ignora: usa `insecure_skip_verify`. Solo se aceptan como `noauth` los cuerpos sin bloques de opciones, y sus credenciales se descartan.",{"_3697":73825,"_31245":73725,"_21577":123870,"_5":14884,"_28435":123609,"_3074":123871},[],"La clave `http_client` pertenece a los canales de alertas; en un cuerpo de DMS se ignora. La configuración del DMS va en `external_webhook_settings.config`.",{"_3697":73826,"_31245":73725,"_21577":123873,"_5":14884,"_28435":123609,"_3074":123874},[],"Si hay credenciales configuradas, se envían sea cual sea el esquema de la URL: un webhook `http://` recibe la API key o el bearer token en claro, y mTLS no tiene efecto porque no hay handshake TLS, así que el certificado de cliente nunca se presenta. Usa preferentemente `https://` en `url`, en `oidc_well_known` y en el endpoint de token que este anuncia.",{"_3697":73827,"_31245":73725,"_21577":123876,"_5":14884,"_28435":123609,"_3074":123877},[],"La consola ofrece editores independientes para la autenticación de enrolamiento y de reenrolamiento, con los mismos campos **Log Level**, **Call Timeout**, **HTTP Authentication** y credenciales que los canales webhook, además del interruptor **Skip TLS Verification** (`insecure_skip_verify`, desactivado por defecto; la consola avisa al activarlo). El editor rechaza las rutas de archivo en los campos de certificado y clave, y al guardar reescribe `external_webhook_settings.config` con las claves actuales y el material codificado en Base64. Las configuraciones migradas desde 3.8.0 que referenciaban archivos o dependían de `validate_server_cert: false` requieren corrección; consulta Webhooks del DMS.",{"_3697":73828,"_31245":73725,"_21577":123879,"_5":14884,"_28435":123613,"_3074":123880},[],"Para recorrer todas las operaciones de un primer enrolamiento, sigue Enrola y conecta tu primer dispositivo.",{"_3697":73829,"_31245":73725,"_21577":123882,"_5":14884,"_28435":123613,"_3074":123883},[],"Los ejemplos de esta página necesitan el URL HTTPS público del DMS, la confianza del servidor obtenida por un canal aprobado, el modo de autenticación de la operación y un identificador admitido. Usan Bash, curl con `--fail-with-body` y OpenSSL 3.x (openssl-pkcs7 para extraer certificados y openssl-x509 para preparar la renovación); trabaja en un directorio privado. Si integras un cliente EST genérico, comprueba antes las particularidades de Lamassu descritas en cada operación, como la respuesta PEM o el formato multipart de `/serverkeygen`.",{"_3697":73830,"_31245":73725,"_21577":123885,"_5":14884,"_28435":123613,"_3074":123886},[],"Prepara `est-trust.pem` para verificar al servidor EST, `bootstrap.crt` y `bootstrap.key` para la autenticación inicial por certificado, y `device-root.pem` como raíz aprobada del emisor de dispositivos. Los dos archivos de confianza pueden contener raíces distintas. Si usas otra autenticación, adapta las credenciales según Autenticación y confianza. Sustituye el host y `REPLACE_DMS_ID` por los de tu instalación:",{"_3697":73831,"_31245":73725,"_21577":123888,"_5":14884,"_28435":123613,"_3074":123889},[],"Cuando una petición falla, conserva el código HTTP, las cabeceras y el cuerpo antes de decodificar nada. Un 500 no implica un fallo transitorio: los rechazos del servicio también lo devuelven. El diagnóstico explica cómo interpretarlos.",{"_3697":73832,"_31245":73725,"_21577":123891,"_5":14884,"_28435":123616,"_3074":123892},[],"`GET /cacerts` descarga el conjunto de certificados que publica el DMS. El cliente puede inspeccionarlo y usar los certificados aprobados para construir cadenas de confianza.",{"_3697":73833,"_31245":73725,"_21577":123894,"_5":14884,"_28435":123619,"_3074":123895},[],"`settings.ca_distribution_settings` determina qué certificados devuelve `/cacerts`:",{"_3697":73834,"_31245":73725,"_21577":123897,"_5":14884,"_28435":123619,"_3074":123759},[],{"_3697":73835,"_31245":73725,"_21577":123899,"_5":14884,"_28435":123619,"_3074":123900},[],"Contenido que añade",{"_3697":73836,"_31245":73725,"_21577":123902,"_5":14884,"_28435":123619,"_3074":54547},[],{"_3697":73837,"_31245":73725,"_21577":123904,"_5":14884,"_28435":123619,"_3074":123905},[],"El certificado TLS downstream disponible. Puede ser una hoja, no una CA de emisión.",{"_3697":73838,"_31245":73725,"_21577":123907,"_5":14884,"_28435":123619,"_3074":54553},[],{"_3697":73839,"_31245":73725,"_21577":123909,"_5":14884,"_28435":123619,"_3074":123910},[],"El certificado de la CA de enrolamiento seleccionada.",{"_3697":73840,"_31245":73725,"_21577":123912,"_5":14884,"_28435":123619,"_3074":54559},[],{"_3697":73841,"_31245":73725,"_21577":123914,"_5":14884,"_28435":123619,"_3074":123915},[],"Los certificados de las CAs elegidas explícitamente.",{"_3697":73842,"_31245":73725,"_21577":123917,"_5":14884,"_28435":123619,"_3074":123918},[],"El DMS no añade los ascendientes de esas CAs: seleccionar la CA de enrolamiento no publica su raíz ni sus intermedias, que deben elegirse en **Managed CAs**. El conjunto puede contener hojas, raíces e intermedias, incluso de más de una jerarquía durante una migración. La posición de cada certificado no define la cadena: identifícalos por sujeto, emisor, AKI/SKI, firma y restricciones.",{"_3697":73843,"_31245":73725,"_21577":123920,"_5":14884,"_28435":123623,"_3074":123921},[],"Envía un GET por HTTPS sin cuerpo y sin credencial EST. Siguen aplicándose los controles del Gateway.",{"_3697":73844,"_31245":73725,"_21577":123923,"_5":14884,"_28435":123623,"_3074":123924},[],"**Respuesta predeterminada.** `Content-Type: application/pkcs7-mime; smime-type=certs-only` y `Content-Transfer-Encoding: base64`. El cuerpo es PKCS#7 DER en Base64 con líneas de hasta 76 caracteres.",{"_3697":73845,"_31245":73725,"_21577":123926,"_5":14884,"_28435":123623,"_3074":123927},[],"**Respuesta PEM.** Lamassu selecciona este formato cuando `Accept` es exactamente `application/x-pem-file` y devuelve ese mismo valor en `Content-Type`. El cuerpo contiene los certificados en PEM.",{"_3697":73846,"_31245":73725,"_21577":123929,"_5":14884,"_28435":123627,"_3074":123930},[],"El ejemplo descarga la respuesta predeterminada y la convierte a PEM. Usa `EST_BASE` y `est-trust.pem` de Antes de empezar.",{"_3697":73847,"_31245":73725,"_21577":123932,"_5":14884,"_28435":123627,"_3074":123933},[],"Comprueba las huellas, emisores y fechas frente a la configuración de distribución. No conviertas todo el contenido en raíces confiables ni lo utilices para autenticar la misma descarga inicial. Un HTTP 200 aquí no demuestra que la autenticación ni la emisión funcionen.",{"_3697":73848,"_31245":73725,"_21577":123935,"_5":14884,"_28435":123631,"_3074":123936},[],"`POST /simpleenroll` emite el certificado inicial de un dispositivo a partir de una CSR. Lamassu toma el identificador del dispositivo del CN y vincula el certificado emitido a su identidad. La clave privada permanece en el cliente.",{"_3697":73849,"_31245":73725,"_21577":123938,"_5":14884,"_28435":123634,"_3074":123939},[],"Las opciones del enrolamiento inicial se guardan en `settings.enrollment_settings`:",{"_3697":73850,"_31245":73725,"_21577":123941,"_5":14884,"_28435":123634,"_3074":123759},[],{"_3697":73851,"_31245":73725,"_21577":123943,"_5":14884,"_28435":123634,"_3074":123762},[],{"_3697":73852,"_31245":73725,"_21577":123945,"_5":14884,"_28435":123634,"_3074":54593},[],{"_3697":73853,"_31245":73725,"_21577":123947,"_5":14884,"_28435":123634,"_3074":123948},[],"`EST_RFC7030` para estas operaciones.",{"_3697":73854,"_31245":73725,"_21577":123950,"_5":14884,"_28435":123634,"_3074":54599},[],{"_3697":73855,"_31245":73725,"_21577":123952,"_5":14884,"_28435":123634,"_3074":123953},[],"ID de la CA que firma los certificados.",{"_3697":73856,"_31245":73725,"_21577":123955,"_5":14884,"_28435":123634,"_3074":54605},[],{"_3697":73857,"_31245":73725,"_21577":123957,"_5":14884,"_28435":123634,"_3074":123958},[],"`JITP` crea el dispositivo desconocido con el CN de la CSR como ID y el DMS como propietario. `PRE_REGISTRATION` exige que el ID exista previamente.",{"_3697":73858,"_31245":73725,"_21577":123960,"_5":14884,"_28435":123634,"_3074":54611},[],{"_3697":73859,"_31245":73725,"_21577":123962,"_5":14884,"_28435":123634,"_3074":123963},[],"Etiquetas, metadatos e icono que recibe un dispositivo dado de alta por JITP.",{"_3697":73860,"_31245":73725,"_21577":123965,"_5":14884,"_28435":123634,"_3074":54617},[],{"_3697":73861,"_31245":73725,"_21577":123967,"_5":14884,"_28435":123634,"_3074":123968},[],"Permite `/simpleenroll` para un ID existente del mismo DMS.",{"_3697":73862,"_31245":73725,"_21577":123970,"_5":14884,"_28435":123634,"_3074":54623},[],{"_3697":73863,"_31245":73725,"_21577":123972,"_5":14884,"_28435":123634,"_3074":123973},[],"Comprueba la posesión de la clave de la CSR. Mantenlo en `true`.",{"_3697":73864,"_31245":73725,"_21577":123975,"_5":14884,"_28435":123634,"_3074":54629},[],{"_3697":73865,"_31245":73725,"_21577":123977,"_5":14884,"_28435":123634,"_3074":123978},[],"Autenticación del enrolamiento inicial; consulta Autenticación por operación.",{"_3697":73866,"_31245":73725,"_21577":123980,"_5":14884,"_28435":123634,"_3074":123981},[],"**Registro y sustitución.** En `PRE_REGISTRATION`, un dispositivo existente pasa antes por el control de sustitución, incluso si no tiene identidad; consulta las condiciones de prerregistro antes de utilizar este modo. Si el ID pertenece a otro DMS, el enrolamiento inicial se rechaza. La sustitución puede intentar revocar el certificado anterior aunque falle una fase posterior: no es un cambio atómico. No la actives como respuesta automática a un error; el diagnóstico distingue ID repetido, propiedad y cambios parciales.",{"_3697":73867,"_31245":73725,"_21577":123983,"_5":14884,"_28435":123634,"_3074":123984},[],"**Perfil de emisión.** El perfil se define en `settings`, no en `enrollment_settings`, y se aplica a las tres operaciones que emiten certificados. `settings.issuance_profile_id` tiene precedencia sobre `settings.issuance_profile`; si ninguno existe, se usa el perfil predeterminado de la CA. El perfil resuelto debe definir un certificado final: un perfil con `Sign as CA` se rechaza en el enrolamiento y en el reenrolamiento. Las reglas se documentan en Perfiles. Cambiar el DMS afecta a las solicitudes futuras; no modifica certificados ya firmados ni instala confianza en los clientes.",{"_3697":73868,"_31245":73725,"_21577":123986,"_5":14884,"_28435":123637,"_3074":123987},[],"Envía `Content-Type: application/pkcs10` y una CSR PKCS#10 DER codificada en Base64 en el cuerpo. Lamassu decodifica el cuerpo como Base64, sin envoltorio PEM ni JSON.",{"_3697":73869,"_31245":73725,"_21577":123989,"_5":14884,"_28435":123637,"_3074":123990},[],"**Respuesta predeterminada.** `Content-Type: application/pkcs7-mime; smime-type=certs-only` y `Content-Transfer-Encoding: base64`. El PKCS#7 contiene el certificado emitido. Obtén por separado los certificados de CA que necesites para verificar su cadena.",{"_3697":73870,"_31245":73725,"_21577":123992,"_5":14884,"_28435":123637,"_3074":123993},[],"**Respuesta PEM.** Envía exactamente `Accept: application/x-pem-file` para recibir el certificado en PEM con `Content-Type: application/x-pem-file`.",{"_3697":73871,"_31245":73725,"_21577":123995,"_5":14884,"_28435":123640,"_3074":123996},[],"El ejemplo usa la autenticación inicial `CLIENT_CERTIFICATE` y los archivos de Antes de empezar.",{"_3697":73872,"_31245":73725,"_21577":123998,"_5":14884,"_28435":123640,"_3074":123999},[],"**Prepara la CSR.** El ejemplo genera una clave EC P-256 nueva y usa `est-device-001`, que debe estar libre si el DMS registra automáticamente. El `Common Name` será el identificador del dispositivo. Comprueba que el perfil permite la clave y el sujeto elegidos.",{"_3697":73873,"_31245":73725,"_21577":124001,"_5":14884,"_28435":123640,"_3074":124002},[],"Una implementación con hardware o almacén propio debe producir la CSR mediante su clave residente. Honor Extensions no autoriza todos los atributos pedidos: consulta Perfiles.",{"_3697":73874,"_31245":73725,"_21577":124004,"_5":14884,"_28435":123640,"_3074":124005},[],"**Solicita la identidad.** Envía la CSR autenticándote con la credencial bootstrap:",{"_3697":73875,"_31245":73725,"_21577":124007,"_5":14884,"_28435":123640,"_3074":124008},[],"Si curl falla, el ejemplo se detiene antes de decodificar: una respuesta de error no es un certificado. Un timeout deja el resultado de la operación por comprobar en Lamassu, así que no repitas automáticamente una emisión.",{"_3697":73876,"_31245":73725,"_21577":124010,"_5":14884,"_28435":123640,"_3074":124011},[],"**Comprueba e instala el resultado.** Para el caso de una raíz que emite directamente:",{"_3697":73877,"_31245":73725,"_21577":124013,"_5":14884,"_28435":123640,"_3074":124014},[],"`cmp` debe terminar con código 0. Verifica además que el CN es el esperado, el certificado es final, los usos permiten tu aplicación y las fechas satisfacen el perfil. Si hay intermedias, aporta la cadena con `-untrusted` según Validación PKI.",{"_3697":73878,"_31245":73725,"_21577":124016,"_5":14884,"_28435":123640,"_3074":124017},[],"Consulta el dispositivo en Lamassu: DMS propietario, número de serie actual e historial deben corresponder al resultado. Guarda la pareja clave/certificado de forma protegida e instala ambos mediante el mecanismo del dispositivo; la asociación en Lamassu no instala archivos en el cliente. Comprueba una conexión real antes de considerar terminado el proceso.",{"_3697":73879,"_31245":73725,"_21577":124019,"_5":14884,"_28435":123643,"_3074":124020},[],"`POST /simplereenroll` emite un certificado sucesor para una identidad activa. El cliente conserva el identificador del dispositivo y puede solicitar el certificado con una clave nueva.",{"_3697":73880,"_31245":73725,"_21577":124022,"_5":14884,"_28435":123646,"_3074":124023},[],"Las opciones de renovación se guardan en `settings.reenrollment_settings`:",{"_3697":73881,"_31245":73725,"_21577":124025,"_5":14884,"_28435":123646,"_3074":123759},[],{"_3697":73882,"_31245":73725,"_21577":124027,"_5":14884,"_28435":123646,"_3074":123762},[],{"_3697":73883,"_31245":73725,"_21577":124029,"_5":14884,"_28435":123646,"_3074":54629},[],{"_3697":73884,"_31245":73725,"_21577":124031,"_5":14884,"_28435":123646,"_3074":124032},[],"Autenticación del reenrolamiento, independiente de la inicial; consulta Autenticación por operación.",{"_3697":73885,"_31245":73725,"_21577":124034,"_5":14884,"_28435":123646,"_3074":54689},[],{"_3697":73886,"_31245":73725,"_21577":124036,"_5":14884,"_28435":123646,"_3074":124037},[],"CAs de validación de reenrolamiento, probadas después de la CA de enrolamiento. Es opcional y suele poblarse durante una rotación de CAs, mientras se renuevan los dispositivos con certificados de la CA anterior.",{"_3697":73887,"_31245":73725,"_21577":124039,"_5":14884,"_28435":123646,"_3074":54695},[],{"_3697":73888,"_31245":73725,"_21577":124041,"_5":14884,"_28435":123646,"_3074":124042},[],"La ventana de renovación abre en el `NotAfter` del certificado activo menos este delta.",{"_3697":73889,"_31245":73725,"_21577":124044,"_5":14884,"_28435":123646,"_3074":54701},[],{"_3697":73890,"_31245":73725,"_21577":124046,"_5":14884,"_28435":123646,"_3074":124047},[],"Umbral preventivo de monitorización. Produce estados y avisos; no amplía la ventana.",{"_3697":73891,"_31245":73725,"_21577":124049,"_5":14884,"_28435":123646,"_3074":54707},[],{"_3697":73892,"_31245":73725,"_21577":124051,"_5":14884,"_28435":123646,"_3074":124052},[],"Umbral crítico de monitorización. Produce estados y avisos; no amplía la ventana.",{"_3697":73893,"_31245":73725,"_21577":124054,"_5":14884,"_28435":123646,"_3074":54713},[],{"_3697":73894,"_31245":73725,"_21577":124056,"_5":14884,"_28435":123646,"_3074":124057},[],"Acepta un certificado presentado vencido en el validador mTLS de renovación. No autoriza por sí solo otro modo ni elimina restricciones del Gateway.",{"_3697":73895,"_31245":73725,"_21577":124059,"_5":14884,"_28435":123646,"_3074":54719},[],{"_3697":73896,"_31245":73725,"_21577":124061,"_5":14884,"_28435":123646,"_3074":124062},[],"Si el certificado anterior está `ACTIVE`, intenta revocarlo con motivo Superseded antes de vincular el sucesor.",{"_3697":73897,"_31245":73725,"_21577":124064,"_5":14884,"_28435":123646,"_3074":124065},[],"El campo plano heredado `reenrollment_settings.additional_validation_cas` no forma parte de la API: se ignora sin error, así que un cuerpo de actualización construido con él vacía `validation_cas`. Lee el DMS antes de editarlo por API.",{"_3697":73898,"_31245":73725,"_21577":124067,"_5":14884,"_28435":123646,"_3074":124068},[],"Monitorizar no renueva: el cliente debe programar la solicitud y la instalación con margen para desconexiones, distribución de confianza y comprobación del consumidor. Escalona las solicitudes de la población y limita los reintentos dentro de la ventana; los errores de autenticación, sujeto o política requieren corregir su causa. Mantén un mecanismo de recuperación admitido y probado para las claves perdidas y las parejas que no pudieron instalarse; consulta Recupera según el estado.",{"_3697":73899,"_31245":73725,"_21577":124070,"_5":14884,"_28435":123649,"_3074":124071},[],"Usa el mismo formato de CSR y cabeceras que en `simpleenroll`. La respuesta contiene el certificado sucesor en PKCS#7 DER codificado en Base64, o en PEM si envías exactamente `Accept: application/x-pem-file`.",{"_3697":73900,"_31245":73725,"_21577":124073,"_5":14884,"_28435":123649,"_3074":124074},[],"Con autenticación por certificado, Lamassu exige que el CN de la credencial coincida con el de la CSR y compara el sujeto solicitado con el del certificado actual. El DMS rechaza un certificado activo revocado o una solicitud anterior a la ventana de renovación. Certificado de cliente detalla las CAs admitidas, el vencimiento y las comprobaciones de revocación.",{"_3697":73901,"_31245":73725,"_21577":124076,"_5":14884,"_28435":123652,"_3074":124077},[],"El ejemplo continúa el enrolamiento inicial en la misma sesión Bash, con `device.crt` y `device.key` como identidad actual.",{"_3697":73902,"_31245":73725,"_21577":124079,"_5":14884,"_28435":123652,"_3074":124080},[],"**Prepara la renovación.** Antes de solicitar el sucesor:",{"_3697":73903,"_31245":73725,"_21577":124082,"_5":14884,"_28435":123652,"_3074":124083},[],"Consulta el certificado actual en Lamassu y compáralo con el instalado. Necesitas su sujeto, serie y fechas, además de la clave del cliente.",{"_3697":73904,"_31245":73725,"_21577":124085,"_5":14884,"_28435":123652,"_3074":124086},[],"Comprueba el modo de autenticación del reenrolamiento: es independiente del inicial. En `CLIENT_CERTIFICATE`, utiliza la identidad actual; no asumas que la credencial bootstrap está admitida.",{"_3697":73905,"_31245":73725,"_21577":124088,"_5":14884,"_28435":123652,"_3074":124089},[],"Calcula el inicio de la ventana: `NotAfter` del certificado actual menos `reenrollment_delta`.",{"_3697":73906,"_31245":73725,"_21577":124091,"_5":14884,"_28435":123652,"_3074":124092},[],"Revisa **Revoke on Re-enrollment**. Si está habilitado, Lamassu puede revocar la identidad anterior antes de que el cliente instale la nueva.",{"_3697":73907,"_31245":73725,"_21577":124094,"_5":14884,"_28435":123652,"_3074":124095},[],"**Solicita el certificado sucesor.** La petición se autentica con `device.crt` y `device.key`, y la CSR contiene una clave nueva compatible con el perfil. La conversión desde el certificado conserva el sujeto y copia solo el SAN cuando existe; comprueba el sujeto y los nombres solicitados antes de enviarla. El backend compara el sujeto con la identidad actual: intenta la igualdad de RawSubject y después compara CN, OU, O, L, ST y C, así que reconstruir solo el CN puede perder atributos requeridos.",{"_3697":73908,"_31245":73725,"_21577":124097,"_5":14884,"_28435":123652,"_3074":124098},[],"Comprueba también las extensiones, las fechas y que la serie corresponde al slot actual en Lamassu. No vuelvas a enviar una solicitud que falló sin consultar ese estado: la emisión, la revocación anterior y la vinculación del sucesor pueden tener resultados parciales.",{"_3697":73909,"_31245":73725,"_21577":124100,"_5":14884,"_28435":123652,"_3074":124101},[],"**Instala y comprueba la nueva pareja.** Conserva el resultado como `device.next.crt` y `device.next.key` hasta verificarlo. Cambia la pareja mediante una operación coordinada del almacén o configuración del dispositivo; evita exponer temporalmente un certificado con la clave de otra versión.",{"_3697":73910,"_31245":73725,"_21577":124103,"_5":14884,"_28435":123652,"_3074":124104},[],"Prueba mTLS con el consumidor y verifica que utiliza la nueva serie. Confirma el historial y el certificado actual en Lamassu. Si **Revoke on Re-enrollment** estaba deshabilitado, la identidad anterior puede seguir válida: retírala conforme a la política de PKI después de probar el sucesor y comprueba la publicación y el consumo de su revocación.",{"_3697":73911,"_31245":73725,"_21577":124106,"_5":14884,"_28435":123655,"_3074":124107},[],"Situación",{"_3697":73912,"_31245":73725,"_21577":124109,"_5":14884,"_28435":123655,"_3074":124110},[],"Procedimiento",{"_3697":73913,"_31245":73725,"_21577":124112,"_5":14884,"_28435":123655,"_3074":124113},[],"Certificado vigente, fuera de ventana",{"_3697":73914,"_31245":73725,"_21577":124115,"_5":14884,"_28435":123655,"_3074":124116},[],"Programa la solicitud dentro de la ventana. No recurras a `simpleenroll` para saltarla.",{"_3697":73915,"_31245":73725,"_21577":124118,"_5":14884,"_28435":123655,"_3074":124119},[],"Certificado vencido, clave disponible",{"_3697":73916,"_31245":73725,"_21577":124121,"_5":14884,"_28435":123655,"_3074":124122},[],"Con autenticación por certificado, revisa `enable_expired_renewal` y que Gateway permita presentar esa credencial. Siguen aplicándose revocación, sujeto y el resto de comprobaciones.",{"_3697":73917,"_31245":73725,"_21577":124124,"_5":14884,"_28435":123655,"_3074":124125},[],"Renovación por webhook o `NO_AUTH`",{"_3697":73918,"_31245":73725,"_21577":124127,"_5":14884,"_28435":123655,"_3074":124128},[],"La comprobación mTLS de vencimiento no se ejecuta en esos modos. Define la política de vencimiento y autorización en la admisión correspondiente; el webhook debe autorizar explícitamente la recuperación que admita.",{"_3697":73919,"_31245":73725,"_21577":124130,"_5":14884,"_28435":123655,"_3074":124131},[],"Clave perdida o inaccesible",{"_3697":73920,"_31245":73725,"_21577":124133,"_5":14884,"_28435":123655,"_3074":124134},[],"No puedes probar posesión de la identidad anterior. Autoriza una nueva admisión y, si procede, sustitución controlada; revoca la identidad comprometida.",{"_3697":73921,"_31245":73725,"_21577":124136,"_5":14884,"_28435":123655,"_3074":124137},[],"Identidad actual revocada",{"_3697":73922,"_31245":73725,"_21577":124139,"_5":14884,"_28435":123655,"_3074":124140},[],"`simplereenroll` rechaza el certificado actual revocado y conservar sus archivos no restaura una conexión válida. Investiga la razón y prepara un procedimiento de readmisión autorizado; no desactives autenticación para forzarlo.",{"_3697":73923,"_31245":73725,"_21577":124142,"_5":14884,"_28435":123655,"_3074":124143},[],"Dispositivo sin identidad",{"_3697":73924,"_31245":73725,"_21577":124145,"_5":14884,"_28435":123655,"_3074":124146},[],"Usa el enrolamiento inicial. En un registro existente, comprueba la restricción de sustitución de aprovisionamiento.",{"_3697":73925,"_31245":73725,"_21577":124148,"_5":14884,"_28435":123655,"_3074":124149},[],"Dispositivo retirado",{"_3697":73926,"_31245":73725,"_21577":124151,"_5":14884,"_28435":123655,"_3074":124152},[],"Revisa la decisión operativa antes de readmitirlo. El estado Decommissioned y la revocación de todo el historial no son equivalentes.",{"_3697":73927,"_31245":73725,"_21577":124154,"_5":14884,"_28435":123655,"_3074":124155},[],"Timeout, HTTP 500 o fallo de instalación",{"_3697":73928,"_31245":73725,"_21577":124157,"_5":14884,"_28435":123655,"_3074":124158},[],"Inspecciona dispositivo, certificados emitidos e historial antes de reintentar. Puede haberse emitido un sucesor o revocado el anterior.",{"_3697":73929,"_31245":73725,"_21577":124160,"_5":14884,"_28435":123659,"_3074":124161},[],"`POST /serverkeygen` genera una clave software en Lamassu, reconstruye la CSR con esa clave y ejecuta el enrolamiento inicial. El cliente recibe la clave privada y el certificado.",{"_3697":73930,"_31245":73725,"_21577":124163,"_5":14884,"_28435":123662,"_3074":124164},[],"`settings.server_keygen_settings` controla la generación de claves. El resto de la operación aplica la configuración del enrolamiento inicial; antes de probarla con un ID registrado, revisa si esa configuración permite sustituir el certificado.",{"_3697":73931,"_31245":73725,"_21577":124166,"_5":14884,"_28435":123662,"_3074":123759},[],{"_3697":73932,"_31245":73725,"_21577":124168,"_5":14884,"_28435":123662,"_3074":123762},[],{"_3697":73933,"_31245":73725,"_21577":124170,"_5":14884,"_28435":123662,"_3074":54831},[],{"_3697":73934,"_31245":73725,"_21577":124172,"_5":14884,"_28435":123662,"_3074":124173},[],"Activa la operación. Con la operación deshabilitada, la consola omite el campo `key`.",{"_3697":73935,"_31245":73725,"_21577":124175,"_5":14884,"_28435":123662,"_3074":54837},[],{"_3697":73936,"_31245":73725,"_21577":124177,"_5":14884,"_28435":123662,"_3074":124178},[],"RSA o ECDSA. El perfil de emisión debe permitir el algoritmo y el tamaño elegidos.",{"_3697":73937,"_31245":73725,"_21577":124180,"_5":14884,"_28435":123662,"_3074":54843},[],{"_3697":73938,"_31245":73725,"_21577":124182,"_5":14884,"_28435":123662,"_3074":124183},[],"Tamaño del módulo para RSA o curva para ECDSA. La consola ofrece RSA de 2048, 3072 y 4096 bits (4096 por defecto) y ECDSA P-256, P-384 y P-521 (P-256 por defecto).",{"_3697":73939,"_31245":73725,"_21577":124185,"_5":14884,"_28435":123662,"_3074":124186},[],"Para ECDSA, el servicio también reconoce los valores 224, 256, 384 y 521 como P-224, P-256, P-384 y P-521, y un valor desconocido selecciona P-256. Elige un tamaño compatible y comprueba la clave resultante.",{"_3697":73940,"_31245":73725,"_21577":124188,"_5":14884,"_28435":123665,"_3074":124189},[],"Envía una CSR PKCS#10 DER codificada en Base64 con `Content-Type: application/pkcs10`. La respuesta usa el formato multipart de esta operación incluso si se solicita PEM mediante `Accept`. La clave se genera en software aunque la CA firme con una clave alojada en HSM.",{"_3697":73941,"_31245":73725,"_21577":124191,"_5":14884,"_28435":123665,"_3074":124192},[],"El cuerpo es **MIME multipart/mixed**, con el boundary indicado en `Content-Type`, y tiene dos partes:",{"_3697":73942,"_31245":73725,"_21577":124194,"_5":14884,"_28435":123665,"_3074":124195},[],"Parte",{"_3697":73943,"_31245":73725,"_21577":124197,"_5":14884,"_28435":123665,"_3074":124198},[],"Contenido tras decodificar su Base64",{"_3697":73944,"_31245":73725,"_21577":124200,"_5":14884,"_28435":123665,"_3074":54864},[],{"_3697":73945,"_31245":73725,"_21577":124202,"_5":14884,"_28435":123665,"_3074":124203},[],"Clave privada PKCS#8 DER sin cifrar.",{"_3697":73946,"_31245":73725,"_21577":124205,"_5":14884,"_28435":123665,"_3074":54870},[],{"_3697":73947,"_31245":73725,"_21577":124207,"_5":14884,"_28435":123665,"_3074":124208},[],"PKCS#7 DER con el certificado emitido.",{"_3697":73948,"_31245":73725,"_21577":124210,"_5":14884,"_28435":123665,"_3074":124211},[],"El controlador también añade `Content-Transfer-Encoding: base64` en la cabecera exterior, aunque el cuerpo exterior es texto MIME. &#x2A;*No decodifiques el cuerpo completo como Base64.** Lee el boundary real y decodifica cada parte según sus cabeceras.",{"_3697":73949,"_31245":73725,"_21577":124213,"_5":14884,"_28435":123668,"_3074":124214},[],"El ejemplo usa `EST_BASE` y los archivos de confianza y bootstrap de Antes de empezar. Elige un ID libre y admitido, como `est-serverkeygen-001`. La clave `server-request.key` solo firma la CSR de entrada; la identidad recibida utilizará la clave generada por el servidor.",{"_3697":73950,"_31245":73725,"_21577":124216,"_5":14884,"_28435":123668,"_3074":124217},[],"Procesa las partes MIME según sus cabeceras y comprueba que la clave recibida corresponde al certificado. Inspecciona el CN, la serie, las fechas y los usos, y comprueba la asociación en Lamassu antes de instalar. Protege los archivos que contienen la clave y elimina las copias temporales según el almacenamiento del dispositivo.",{"_3697":73951,"_31245":73725,"_21577":124219,"_5":14884,"_28435":123668,"_3074":124220},[],"<Card title=\"Autenticación y confianza\" description=\"Credenciales bootstrap, contrato del webhook y comprobaciones de revocación.\" href=\"/docs/platform/iot-fleets/est/bootstrap-identity\" />",{"_3697":73952,"_31245":73725,"_21577":124222,"_5":14884,"_28435":123668,"_3074":124223},[],"<Card title=\"Dispositivos e identidades\" description=\"Consulta el slot, el historial y el estado de cada identidad emitida.\" href=\"/docs/platform/iot-fleets/device-management\" />",{"_3697":73953,"_31245":73725,"_21577":124225,"_5":14884,"_28435":123668,"_3074":124226},[],"<Card title=\"Diagnóstico de enrolamiento\" description=\"Localiza fallos de transporte, autenticación, registro, emisión e instalación.\" href=\"/docs/platform/iot-fleets/est/troubleshooting\" />",{"_3697":73954,"_31245":73954,"_5":15238,"_3074":124228,"_31570":124229,"_21577":124230,"_28435":73954},"Referencia EST",[50948,121910,53661,54123],[],{"_3697":73955,"_31245":73954,"_21577":124232,"_5":14884,"_28435":73954,"_3074":124233},[],"El protocolo Enrollment over Secure Transport definido en RFC 7030.",{"_3697":73956,"_31245":73954,"_5":31567,"_21577":124235,"_28435":124236,"_3074":124237},[],"/docs/es/platform/iot-fleets/est#operaciones","Operaciones",{"_3697":73957,"_31245":73954,"_5":31567,"_21577":124239,"_28435":124240,"_3074":124241},[],"/docs/es/platform/iot-fleets/est#autenticación-y-mensajes","Autenticación y mensajes",{"_3697":73958,"_31245":73954,"_21577":124243,"_5":14884,"_28435":73954,"_3074":124244},[],"Enrollment over Secure Transport (EST) es un protocolo para obtener y renovar certificados X.509 mediante HTTPS. Un cliente EST se comunica con un servidor EST, que gestiona la solicitud de certificado y facilita los certificados de las autoridades de certificación. El estándar define mensajes, operaciones y mecanismos de autenticación. RFC 7030",{"_3697":73959,"_31245":73954,"_21577":124246,"_5":14884,"_28435":124236,"_3074":124247},[],"Las rutas de operación se añaden al prefijo `/.well-known/est`, que puede incluir una etiqueta para identificar la CA o el servicio.",{"_3697":73960,"_31245":73954,"_21577":124249,"_5":14884,"_28435":124236,"_3074":121670},[],{"_3697":73961,"_31245":73954,"_21577":124251,"_5":14884,"_28435":124236,"_3074":123679},[],{"_3697":73962,"_31245":73954,"_21577":124253,"_5":14884,"_28435":124236,"_3074":124254},[],"Función",{"_3697":73963,"_31245":73954,"_21577":124256,"_5":14884,"_28435":124236,"_3074":124257},[],"Soporte del servidor",{"_3697":73964,"_31245":73954,"_21577":124259,"_5":14884,"_28435":124236,"_3074":54304},[],{"_3697":73965,"_31245":73954,"_21577":124261,"_5":14884,"_28435":124236,"_3074":54307},[],{"_3697":73966,"_31245":73954,"_21577":124263,"_5":14884,"_28435":124236,"_3074":124264},[],"Obtener certificados de CA.",{"_3697":73967,"_31245":73954,"_21577":124266,"_5":14884,"_28435":124236,"_3074":124267},[],"Obligatorio",{"_3697":73968,"_31245":73954,"_21577":124269,"_5":14884,"_28435":124236,"_3074":54313},[],{"_3697":73969,"_31245":73954,"_21577":124271,"_5":14884,"_28435":124236,"_3074":54316},[],{"_3697":73970,"_31245":73954,"_21577":124273,"_5":14884,"_28435":124236,"_3074":124274},[],"Solicitar un certificado inicial mediante una CSR.",{"_3697":73971,"_31245":73954,"_21577":124276,"_5":14884,"_28435":124236,"_3074":124267},[],{"_3697":73972,"_31245":73954,"_21577":124278,"_5":14884,"_28435":124236,"_3074":54322},[],{"_3697":73973,"_31245":73954,"_21577":124280,"_5":14884,"_28435":124236,"_3074":54316},[],{"_3697":73974,"_31245":73954,"_21577":124282,"_5":14884,"_28435":124236,"_3074":124283},[],"Solicitar la renovación o sustitución de clave de un certificado.",{"_3697":73975,"_31245":73954,"_21577":124285,"_5":14884,"_28435":124236,"_3074":124267},[],{"_3697":73976,"_31245":73954,"_21577":124287,"_5":14884,"_28435":124236,"_3074":54330},[],{"_3697":73977,"_31245":73954,"_21577":124289,"_5":14884,"_28435":124236,"_3074":54316},[],{"_3697":73978,"_31245":73954,"_21577":124291,"_5":14884,"_28435":124236,"_3074":124292},[],"Solicitar una clave generada por el servidor y el certificado asociado.",{"_3697":73979,"_31245":73954,"_21577":124294,"_5":14884,"_28435":124236,"_3074":124295},[],"Opcional",{"_3697":73980,"_31245":73954,"_21577":124297,"_5":14884,"_28435":124236,"_3074":54961},[],{"_3697":73981,"_31245":73954,"_21577":124299,"_5":14884,"_28435":124236,"_3074":54307},[],{"_3697":73982,"_31245":73954,"_21577":124301,"_5":14884,"_28435":124236,"_3074":124302},[],"Consultar atributos sugeridos para la CSR.",{"_3697":73983,"_31245":73954,"_21577":124304,"_5":14884,"_28435":124236,"_3074":124295},[],{"_3697":73984,"_31245":73954,"_21577":124306,"_5":14884,"_28435":124236,"_3074":54971},[],{"_3697":73985,"_31245":73954,"_21577":124308,"_5":14884,"_28435":124236,"_3074":54316},[],{"_3697":73986,"_31245":73954,"_21577":124310,"_5":14884,"_28435":124236,"_3074":124311},[],"Enviar una solicitud Full CMC.",{"_3697":73987,"_31245":73954,"_21577":124313,"_5":14884,"_28435":124236,"_3074":124295},[],{"_3697":73988,"_31245":73954,"_21577":124315,"_5":14884,"_28435":124240,"_3074":124316},[],"EST utiliza TLS para proteger el intercambio. El cliente autentica al servidor y el servidor autentica y autoriza al cliente mediante los mecanismos definidos por el estándar. La distribución inicial de certificados de CA tiene condiciones particulares para establecer la confianza. RFC 7030, secciones 3.3 y 4.1",{"_3697":73989,"_31245":73954,"_21577":124318,"_5":14884,"_28435":124240,"_3074":124319},[],"Las solicitudes de `/simpleenroll` y `/simplereenroll` utilizan una CSR PKCS#10. La respuesta de certificado utiliza PKCS#7. La respuesta de `/serverkeygen` es `multipart/mixed` y contiene la clave y el certificado. El estándar también define la solicitud y la respuesta Full CMC y el formato de atributos de CSR. RFC 7030, sección 3.2.4",{"_3697":73990,"_31245":73954,"_21577":124321,"_5":14884,"_28435":124240,"_3074":124322},[],"Consulta EST en Lamassu para conocer las operaciones disponibles y su configuración.",{"_3697":73991,"_31245":73991,"_5":15238,"_3074":124324,"_31570":124325,"_21577":124326,"_28435":73991},"Diagnóstico de enrolamiento",[50948,121910,53661,54123],[],{"_3697":73992,"_31245":73991,"_21577":124328,"_5":14884,"_28435":73991,"_3074":124329},[],"Localiza fallos de transporte, autenticación, registro, emisión e instalación.",{"_3697":73993,"_31245":73991,"_5":31567,"_21577":124331,"_28435":124332,"_3074":124333},[],"/docs/es/platform/iot-fleets/est/troubleshooting#diagnóstico-y-compatibilidad","Diagnóstico y compatibilidad",{"_3697":73994,"_31245":73991,"_5":31567,"_21577":124335,"_28435":124336,"_3074":124337},[],"/docs/es/platform/iot-fleets/est/troubleshooting#códigos-de-error-y-diagnóstico","Códigos de error y diagnóstico",{"_3697":73995,"_31245":73991,"_5":31567,"_21577":124339,"_28435":124340,"_3074":124341},[],"/docs/es/platform/iot-fleets/est/troubleshooting#notas-de-compatibilidad","Notas de compatibilidad",{"_3697":73996,"_31245":73991,"_5":31567,"_21577":124343,"_28435":124344,"_3074":124345},[],"/docs/es/platform/iot-fleets/est/troubleshooting#el-enrolamiento-est-falla","El enrolamiento EST falla",{"_3697":73997,"_31245":73991,"_21577":124347,"_5":14884,"_28435":73991,"_3074":124348},[],"Diagnostica una operación y un dispositivo cada vez. Anota DMS/APS, endpoint, hora, código HTTP, serie presentada y CN de la CSR. Conserva la respuesta sin incluir claves privadas ni credenciales de webhook en el informe.",{"_3697":73998,"_31245":73991,"_21577":124350,"_5":14884,"_28435":124336,"_3074":124351},[],"El controlador EST devuelve normalmente 400 al rechazar entrada y 500 cuando el servicio rechaza o falla la operación. Un 500 también puede representar una denegación de política; no implica que reintentar sea seguro. Gateway puede generar sus propios códigos y cuerpos. Revisa el cuerpo real y el resultado persistido.",{"_3697":73999,"_31245":73991,"_21577":124353,"_5":14884,"_28435":124336,"_3074":124354},[],"Síntoma o mensaje",{"_3697":74000,"_31245":73991,"_21577":124356,"_5":14884,"_28435":124336,"_3074":124357},[],"Qué revisar",{"_3697":74001,"_31245":73991,"_21577":124359,"_5":14884,"_28435":124336,"_3074":124360},[],"curl rechaza TLS, nombre o emisor",{"_3697":74002,"_31245":73991,"_21577":124362,"_5":14884,"_28435":124336,"_3074":124363},[],"URL, reloj, SAN del servidor y raíz aprobada en `est-trust.pem`. Resolver la confianza en Despliegue; no omitir la verificación.",{"_3697":74003,"_31245":73991,"_21577":124365,"_5":14884,"_28435":124336,"_3074":124366},[],"404 o APS ausente",{"_3697":74004,"_31245":73991,"_21577":124368,"_5":14884,"_28435":124336,"_3074":124369},[],"Ruta pública `/.well-known/est/{DMS_ID}/{operation}` y DMS existente. El APS no es el nombre del servicio.",{"_3697":74005,"_31245":73991,"_21577":124371,"_5":14884,"_28435":124336,"_3074":124372},[],"400, error de CSR o formato",{"_3697":74006,"_31245":73991,"_21577":124374,"_5":14884,"_28435":124336,"_3074":124375},[],"`Content-Type: application/pkcs10`, Base64 de DER, firma válida y cuerpo conservado sin doble codificación.",{"_3697":74007,"_31245":73991,"_21577":124377,"_5":14884,"_28435":124336,"_3074":124378},[],"Credencial ausente o certificado no válido",{"_3697":74008,"_31245":73991,"_21577":124380,"_5":14884,"_28435":124336,"_3074":124381},[],"Modo de la operación, CA validante, fechas, revocación y entrega de la credencial por Gateway. No confundir confianza TLS del servidor con CA de bootstrap.",{"_3697":74009,"_31245":73991,"_21577":124383,"_5":14884,"_28435":124336,"_3074":124384},[],"El enrolamiento o el reenrolamiento rechaza un certificado por revocación no verificable",{"_3697":74010,"_31245":73991,"_21577":124386,"_5":14884,"_28435":124336,"_3074":124387},[],"Si el certificado lo gestiona Lamassu, si sus endpoints OCSP/CRL están configurados y son alcanzables desde el servicio, y si `allow_unverifiable_revocation` está activo en el bloque de esa operación. Consulta DMS y Revocación y comprobaciones.",{"_3697":74011,"_31245":73991,"_21577":124389,"_5":14884,"_28435":124336,"_3074":124390},[],"Webhook deniega, expira o responde sin autorización",{"_3697":74012,"_31245":73991,"_21577":124392,"_5":14884,"_28435":124336,"_3074":124393},[],"Configuración, conectividad y respuesta JSON con `authorized: true`. No hay degradación automática a `NO_AUTH`.",{"_3697":74013,"_31245":73991,"_21577":124395,"_5":14884,"_28435":124336,"_3074":55060},[],{"_3697":74014,"_31245":73991,"_21577":124397,"_5":14884,"_28435":124336,"_3074":124398},[],"El webhook respondió con una redirección. Configura la URL final absoluta `http` o `https` en la configuración del webhook; nunca se siguen redirecciones.",{"_3697":74015,"_31245":73991,"_21577":124400,"_5":14884,"_28435":124336,"_3074":55066},[],{"_3697":74016,"_31245":73991,"_21577":124402,"_5":14884,"_28435":124336,"_3074":124403},[],"El receptor devolvió más de 1 MiB de JSON. Reduce la respuesta del webhook de autorización.",{"_3697":74017,"_31245":73991,"_21577":124405,"_5":14884,"_28435":124336,"_3074":55072},[],{"_3697":74018,"_31245":73991,"_21577":124407,"_5":14884,"_28435":124336,"_3074":124408},[],"La configuración del webhook apunta a archivos (`ca_cert_file`, `mtls_options.cert_file`, `mtls_options.key_file`). Para mTLS, introduce el certificado y la clave como PEM codificado en Base64 en `cert_content` y `key_content`, o como PEM en claro; elimina cualquier otro campo de archivo, incluido `ca_cert_file`, que no tiene equivalente en línea (el certificado del receptor debe encadenar con el almacén de confianza del sistema). Consulta la guía de credenciales del webhook en DMS.",{"_3697":74019,"_31245":73991,"_21577":124410,"_5":14884,"_28435":124336,"_3074":55078},[],{"_3697":74020,"_31245":73991,"_21577":124412,"_5":14884,"_28435":124336,"_3074":124413},[],"El valor no es ni PEM codificado en Base64 ni PEM en claro: es una ruta de archivo o es Base64 de datos que no son PEM. Introduce el certificado y la clave como PEM codificado en Base64, como el resto de certificados de la API, o como PEM en claro (consulta los ajustes del webhook en DMS). El mismo mensaje nombra `mtls_options.key_content` cuando el valor no válido es la clave.",{"_3697":74021,"_31245":73991,"_21577":124415,"_5":14884,"_28435":124336,"_3074":55084},[],{"_3697":74022,"_31245":73991,"_21577":124417,"_5":14884,"_28435":124336,"_3074":124418},[],"El certificado y la clave no forman un par coincidente. Introduce ambos valores del mismo par; la comprobación se ejecuta al guardar el DMS y de nuevo en cada llamada del webhook.",{"_3697":74023,"_31245":73991,"_21577":124420,"_5":14884,"_28435":124336,"_3074":124421},[],"400 `struct validation error` al crear o actualizar un DMS",{"_3697":74024,"_31245":73991,"_21577":124423,"_5":14884,"_28435":124336,"_3074":124424},[],"La configuración del webhook de la operación que lo usa no es válida. Revisa `external_webhook_settings` en DMS.",{"_3697":74025,"_31245":73991,"_21577":124426,"_5":14884,"_28435":124336,"_3074":124427},[],"HTTP 500 con cuerpo `err` en enroll o reenroll",{"_3697":74026,"_31245":73991,"_21577":124429,"_5":14884,"_28435":124336,"_3074":124430},[],"Los fallos del servicio llegan al cliente EST como 500 con un cuerpo de `err` más el mensaje; los errores de autorización del webhook se nombran ahí.",{"_3697":74027,"_31245":73991,"_21577":124432,"_5":14884,"_28435":124336,"_3074":55102},[],{"_3697":74028,"_31245":73991,"_21577":124434,"_5":14884,"_28435":124336,"_3074":124435},[],"PRE\\_REGISTRATION requiere la entrada de inventario previa.",{"_3697":74029,"_31245":73991,"_21577":124437,"_5":14884,"_28435":124336,"_3074":55108},[],{"_3697":74030,"_31245":73991,"_21577":124439,"_5":14884,"_28435":124336,"_3074":124440},[],"Un dispositivo ya existente exige sustitución habilitada, incluso en No Identity. Investiga antes de activar el flag.",{"_3697":74031,"_31245":73991,"_21577":124442,"_5":14884,"_28435":124336,"_3074":124443},[],"DMS propietario distinto",{"_3697":74032,"_31245":73991,"_21577":124445,"_5":14884,"_28435":124336,"_3074":124446},[],"CN/ID, inventario global y DMS dueño; no reutilices un ID de otro contexto.",{"_3697":74033,"_31245":73991,"_21577":124448,"_5":14884,"_28435":124336,"_3074":55120},[],{"_3697":74034,"_31245":73991,"_21577":124450,"_5":14884,"_28435":124336,"_3074":124451},[],"Sujeto de la CSR frente al certificado actual. Conserva sus atributos, además del CN.",{"_3697":74035,"_31245":73991,"_21577":124453,"_5":14884,"_28435":124336,"_3074":55126},[],{"_3697":74036,"_31245":73991,"_21577":124455,"_5":14884,"_28435":124336,"_3074":124456},[],"NotAfter de la identidad actual y reenrollment\\_delta. Los umbrales de alerta no cambian esa ventana.",{"_3697":74037,"_31245":73991,"_21577":124458,"_5":14884,"_28435":124336,"_3074":124459},[],"Certificado actual revocado",{"_3697":74038,"_31245":73991,"_21577":124461,"_5":14884,"_28435":124336,"_3074":124462},[],"Renovación rechazada; prepara recuperación autorizada según la causa.",{"_3697":74039,"_31245":73991,"_21577":124464,"_5":14884,"_28435":124336,"_3074":124465},[],"Error de CA, perfil o firma",{"_3697":74040,"_31245":73991,"_21577":124467,"_5":14884,"_28435":124336,"_3074":124468},[],"CA activa, clave disponible, perfil seleccionado y restricciones. Un cacerts correcto no prueba emisión.",{"_3697":74041,"_31245":73991,"_21577":124470,"_5":14884,"_28435":124336,"_3074":124471},[],"HTTP 200 sin conexión del dispositivo",{"_3697":74042,"_31245":73991,"_21577":124473,"_5":14884,"_28435":124336,"_3074":124474},[],"Pareja instalada, cadena, usos, confianza y permisos del consumidor. Comprueba también el slot e historial.",{"_3697":74043,"_31245":73991,"_21577":124476,"_5":14884,"_28435":124336,"_3074":124477},[],"Timeout o error después de emitir",{"_3697":74044,"_31245":73991,"_21577":124479,"_5":14884,"_28435":124336,"_3074":124480},[],"Certificados nuevos, slot actual y estado de la identidad anterior antes de repetir.",{"_3697":74045,"_31245":73991,"_21577":124482,"_5":14884,"_28435":124340,"_3074":124483},[],"Verifica el modo de renovación guardado y el comportamiento del Gateway con certificados vencidos y con la CA inicial.",{"_3697":74046,"_31245":73991,"_21577":124485,"_5":14884,"_28435":124340,"_3074":124486},[],"La respuesta predeterminada es PKCS#7 DER en Base64; el PEM por `Accept: application/x-pem-file` es una extensión de Lamassu. ServerKeyGen devuelve multipart y requiere tratar cada parte por separado. Consulta la guía de EST en Lamassu.",{"_3697":74047,"_31245":73991,"_21577":124488,"_5":14884,"_28435":124344,"_3074":124489},[],"Comprueba HTTPS con la raíz aprobada y consulta cacerts para el APS correcto.",{"_3697":74048,"_31245":73991,"_21577":124491,"_5":14884,"_28435":124344,"_3074":124492},[],"Revisa el DMS guardado: protocolo, registro, autenticación de esa operación, CA, perfil y ventana.",{"_3697":74049,"_31245":73991,"_21577":124494,"_5":14884,"_28435":124344,"_3074":124495},[],"Verifica la CSR localmente y relaciona su CN con el inventario.",{"_3697":74050,"_31245":73991,"_21577":124497,"_5":14884,"_28435":124344,"_3074":124498},[],"Ejecuta una solicitud, guarda cabeceras/cuerpo y consulta el dispositivo y los certificados.",{"_3697":74051,"_31245":73991,"_21577":124500,"_5":14884,"_28435":124344,"_3074":124501},[],"Si recibes identidad, comprueba clave, sujeto, uso y conexión con el consumidor.",{"_3697":74052,"_31245":73991,"_21577":124503,"_5":14884,"_28435":124344,"_3074":124504},[],"Las comprobaciones externas de revocación del bootstrap fallan cerradas: un certificado cuya revocación no puede verificarse (incluido un estado OCSP Unknown) se rechaza por defecto. Solo `allow_unverifiable_revocation` en el bloque de esa operación (consulta DMS) lo relaja, y solo para certificados que no llevan ningún endpoint OCSP/CRL; los endpoints que no responden, devuelven evidencia caducada o no concluyente se rechazan, lo que diga la opción. Consulta Revocación y comprobaciones. Una CA intermedia en la cadena TLS tampoco demuestra que toda la cadena haya llegado al validador DMS.",{"_3697":74053,"_31245":73991,"_21577":124506,"_5":14884,"_28435":124344,"_3074":124507},[],"Para logs, red, pods o cabeceras de Gateway, continúa en Diagnóstico de Despliegue. Para identidades emitidas, revocadas o vinculadas parcialmente, utiliza Renovación y recuperación y Dispositivos e identidades.",{"_3697":74054,"_31245":74054,"_5":15238,"_3074":55182,"_31570":124509,"_21577":124511,"_28435":74054},[50948,121910,53661,123055,124510],"Integraciones",[],{"_3697":74055,"_31245":74054,"_21577":124513,"_5":14884,"_28435":74054,"_3074":124514},[],"El conector de Lamassu para AWS IoT Core sincroniza las identidades de los dispositivos con la plataforma AWS, gestionando el registro de CAs, el aprovisionamiento de Things y el ciclo de vida de los certificados de forma automática y orientada a eventos.",{"_3697":74056,"_31245":74054,"_5":31567,"_21577":124516,"_28435":124517,"_3074":124518},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#arquitectura-del-conector","Arquitectura del conector",{"_3697":74057,"_31245":74054,"_5":31567,"_21577":124520,"_28435":124521,"_3074":124522},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#prerrequisitos","Prerrequisitos",{"_3697":74058,"_31245":74054,"_5":31567,"_21577":124524,"_28435":124525,"_3074":124526},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#permisos-iam-necesarios","Permisos IAM necesarios",{"_3697":74059,"_31245":74054,"_5":31567,"_21577":124528,"_28435":124529,"_3074":124530},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#parámetros-de-configuración","Parámetros de configuración",{"_3697":74060,"_31245":74054,"_5":31567,"_21577":124532,"_28435":124533,"_3074":124534},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#eventos-y-recursos-de-aws","Eventos y recursos de AWS",{"_3697":74061,"_31245":74054,"_5":31567,"_21577":124536,"_28435":124537,"_3074":124538},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#registro-de-la-ca-en-aws-iot-core","Registro de la CA en AWS IoT Core",{"_3697":74062,"_31245":74054,"_5":31567,"_21577":124540,"_28435":124541,"_3074":124542},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#cómo-solicitar-el-registro","Cómo solicitar el registro",{"_3697":74063,"_31245":74054,"_5":31567,"_21577":124544,"_28435":124545,"_3074":124546},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#estados-del-registro-de-la-ca","Estados del registro de la CA",{"_3697":74064,"_31245":74054,"_5":31567,"_21577":124548,"_28435":124549,"_3074":55224},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#primary-account",{"_3697":74065,"_31245":74054,"_5":31567,"_21577":124551,"_28435":124552,"_3074":55228},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#secondary-account-sni-only",{"_3697":74066,"_31245":74054,"_5":31567,"_21577":124554,"_28435":124555,"_3074":124556},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#configuración-del-dms","Configuración del DMS",{"_3697":74067,"_31245":74054,"_5":31567,"_21577":124558,"_28435":124559,"_3074":124560},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#modo-none","Modo `none`",{"_3697":74068,"_31245":74054,"_5":31567,"_21577":124562,"_28435":124563,"_3074":124564},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#modo-auto","Modo `auto`",{"_3697":74069,"_31245":74054,"_5":31567,"_21577":124566,"_28435":124567,"_3074":124568},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#modo-jitp","Modo `jitp`",{"_3697":74070,"_31245":74054,"_5":31567,"_21577":124570,"_28435":124571,"_3074":124572},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#estados-del-modo-de-registro-del-dms","Estados del modo de registro del DMS",{"_3697":74071,"_31245":74054,"_5":31567,"_21577":124574,"_28435":124575,"_3074":124576},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#aprovisionamiento-de-dispositivos-modo-automático","Aprovisionamiento de dispositivos (modo automático)",{"_3697":74072,"_31245":74054,"_5":31567,"_21577":124578,"_28435":124579,"_3074":124580},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#ciclo-de-vida-del-thing","Ciclo de vida del Thing",{"_3697":74073,"_31245":74054,"_5":31567,"_21577":124582,"_28435":124583,"_3074":124584},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#aprovisionamiento-de-dispositivos-modo-jitp","Aprovisionamiento de dispositivos (modo JITP)",{"_3697":74074,"_31245":74054,"_5":31567,"_21577":124586,"_28435":124587,"_3074":124588},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#sincronización-del-estado-del-certificado","Sincronización del estado del certificado",{"_3697":74075,"_31245":74054,"_5":31567,"_21577":124590,"_28435":124591,"_3074":124592},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#estados-del-certificado","Estados del certificado",{"_3697":74076,"_31245":74054,"_5":31567,"_21577":124594,"_28435":124595,"_3074":124596},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#desconexión-forzada-al-revocar","Desconexión forzada al revocar",{"_3697":74077,"_31245":74054,"_5":31567,"_21577":124598,"_28435":124599,"_3074":124600},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#device-shadow-y-automatización","Device Shadow y automatización",{"_3697":74078,"_31245":74054,"_5":31567,"_21577":124602,"_28435":124603,"_3074":124604},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#qué-escribe-el-conector-en-el-shadow","Qué escribe el conector en el shadow",{"_3697":74079,"_31245":74054,"_5":31567,"_21577":124606,"_28435":124607,"_3074":124608},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#políticas-de-aws-iot","Políticas de AWS IoT",{"_3697":74080,"_31245":74054,"_5":31567,"_21577":124610,"_28435":124611,"_3074":124612},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#solución-de-problemas","Solución de problemas",{"_3697":74081,"_31245":74054,"_21577":124614,"_5":14884,"_28435":74054,"_3074":124615},[],"La integración de Lamassu con AWS IoT Core cubre el puente entre la PKI gestionada por Lamassu y la plataforma de conectividad de AWS. Cuando un dispositivo obtiene su certificado a través del proceso de enrolamiento EST, el conector se encarga de que ese certificado y la identidad asociada sean reconocidos en AWS IoT Core sin intervención manual. El resultado es que el dispositivo puede autenticarse directamente en AWS con el mismo certificado X.509 que Lamassu emitió.",{"_3697":74082,"_31245":74054,"_21577":124617,"_5":14884,"_28435":74054,"_3074":124618},[],"Desde el punto de vista del protocolo, el dispositivo se autentica ante AWS IoT Core mediante TLS mutuo (mTLS): presenta su certificado X.509 emitido por Lamassu como certificado de cliente, y AWS IoT Core verifica la cadena de certificados hasta llegar a la CA registrada en la cuenta. Lamassu actúa como autoridad de certificación (CA); el conector se encarga de que esa CA esté registrada en AWS y de que el certificado del dispositivo sea conocido por la plataforma antes de que el dispositivo intente conectarse (en modo `auto`) o en su primera conexión (en modo JITP).",{"_3697":74083,"_31245":74054,"_21577":124620,"_5":14884,"_28435":74054,"_3074":124621},[],"Este documento está dirigido tanto al administrador PKI, que necesita configurar el conector y registrar las CAs, como al desarrollador de firmware de dispositivos, que necesita entender cómo se nombran los Things, cómo funciona el Device Shadow y qué ocurre cuando un certificado se revoca. Para el desarrollador de firmware, el dato más importante es que el **nombre del Thing en AWS (ThingName) corresponde siempre al Common Name (CN) del certificado emitido por Lamassu**, independientemente del modo de aprovisionamiento.",{"_3697":74084,"_31245":74054,"_21577":124623,"_5":14884,"_28435":124517,"_3074":124624},[],"El conector de AWS IoT Core es un proceso Go independiente, un binario o contenedor separado del núcleo de Lamassu. En un despliegue monolítico se compila por defecto (etiqueta de compilación `!noaws`) y se activa mediante `aws_iot_manager.enabled: true` en el fichero de configuración. En despliegues distribuidos, se ejecuta como un contenedor propio con acceso a los servicios de CA, DMS Manager y Device Manager de Lamassu a través de HTTP.",{"_3697":74085,"_31245":74054,"_21577":124626,"_5":14884,"_28435":124517,"_3074":124627},[],"El conector no sondea los servicios de Lamassu periódicamente. En su lugar, **se suscribe al bus de eventos interno** de Lamassu (AMQP o AWS SQS/SNS, configurable) y reacciona a los eventos que le interesan: creación o actualización de CAs, creación o actualización de DMS, vinculación de identidad de dispositivo, cambio de estado de certificado, actualización de metadatos de certificado y actualización de metadatos de dispositivo. Este modelo orientado a eventos garantiza que la sincronización con AWS sea casi inmediata y no genere carga de sondeo.",{"_3697":74086,"_31245":74054,"_21577":124629,"_5":14884,"_28435":124517,"_3074":124630},[],"Para evitar bucles infinitos, el conector ignora cualquier evento cuyo campo `source` de CloudEvent coincida con su propia URI de origen. Esto previene que las escrituras de metadatos que el propio conector realiza vuelvan a disparar el mismo flujo.",{"_3697":74087,"_31245":74054,"_21577":124632,"_5":14884,"_28435":124517,"_3074":124633},[],"Cuando se ejecutan varios conectores en paralelo, por ejemplo, para distintas cuentas de AWS, cada instancia tiene su propio `connector_id`. Todos los metadatos que el conector escribe en Lamassu se almacenan bajo la clave `lamassu.io/iot/{connector_id}`, lo que permite coexistencia sin colisiones.",{"_3697":74088,"_31245":74054,"_21577":124635,"_5":14884,"_28435":124521,"_3074":124636},[],"Antes de activar el conector es necesario disponer de una cuenta AWS con los permisos IAM adecuados y tener el conector correctamente configurado. El proceso de despliegue (Docker Compose, Kubernetes o binario) se describe en la documentación de despliegue.",{"_3697":74089,"_31245":74054,"_21577":124638,"_5":14884,"_28435":124525,"_3074":124639},[],"La identidad IAM con la que opera el conector debe tener al mínimo los siguientes permisos sobre los recursos de la cuenta destino:",{"_3697":74090,"_31245":74054,"_21577":124641,"_5":14884,"_28435":124525,"_3074":124642},[],"Acción IAM",{"_3697":74091,"_31245":74054,"_21577":124644,"_5":14884,"_28435":124525,"_3074":120785},[],{"_3697":74092,"_31245":74054,"_21577":124646,"_5":14884,"_28435":124525,"_3074":55323},[],{"_3697":74093,"_31245":74054,"_21577":124648,"_5":14884,"_28435":124525,"_3074":124649},[],"Obtener el código de verificación para el registro de CA en Primary Account",{"_3697":74094,"_31245":74054,"_21577":124651,"_5":14884,"_28435":124525,"_3074":55329},[],{"_3697":74095,"_31245":74054,"_21577":124653,"_5":14884,"_28435":124525,"_3074":124654},[],"Registrar la CA en AWS IoT",{"_3697":74096,"_31245":74054,"_21577":124656,"_5":14884,"_28435":124525,"_3074":55335},[],{"_3697":74097,"_31245":74054,"_21577":124658,"_5":14884,"_28435":124525,"_3074":124659},[],"Consultar el estado del registro de la CA",{"_3697":74098,"_31245":74054,"_21577":124661,"_5":14884,"_28435":124525,"_3074":55341},[],{"_3697":74099,"_31245":74054,"_21577":124663,"_5":14884,"_28435":124525,"_3074":124664},[],"Crear o actualizar Things en IoT Core",{"_3697":74100,"_31245":74054,"_21577":124666,"_5":14884,"_28435":124525,"_3074":55347},[],{"_3697":74101,"_31245":74054,"_21577":124668,"_5":14884,"_28435":124525,"_3074":124669},[],"Aprovisionar Things mediante plantilla",{"_3697":74102,"_31245":74054,"_21577":124671,"_5":14884,"_28435":124525,"_3074":55353},[],{"_3697":74103,"_31245":74054,"_21577":124673,"_5":14884,"_28435":124525,"_3074":124674},[],"Registrar certificados de dispositivo",{"_3697":74104,"_31245":74054,"_21577":124676,"_5":14884,"_28435":124525,"_3074":55359},[],{"_3697":74105,"_31245":74054,"_21577":124678,"_5":14884,"_28435":124525,"_3074":124679},[],"Cambiar el estado de un certificado (ACTIVE / INACTIVE / REVOKED)",{"_3697":74106,"_31245":74054,"_21577":124681,"_5":14884,"_28435":124525,"_3074":55365},[],{"_3697":74107,"_31245":74054,"_21577":124683,"_5":14884,"_28435":124525,"_3074":124684},[],"Crear y adjuntar políticas IoT",{"_3697":74108,"_31245":74054,"_21577":124686,"_5":14884,"_28435":124525,"_3074":55371},[],{"_3697":74109,"_31245":74054,"_21577":124688,"_5":14884,"_28435":124525,"_3074":124689},[],"Gestionar grupos de Things",{"_3697":74110,"_31245":74054,"_21577":124691,"_5":14884,"_28435":124525,"_3074":55377},[],{"_3697":74111,"_31245":74054,"_21577":124693,"_5":14884,"_28435":124525,"_3074":124694},[],"Crear plantillas JITP",{"_3697":74112,"_31245":74054,"_21577":124696,"_5":14884,"_28435":124525,"_3074":55383},[],{"_3697":74113,"_31245":74054,"_21577":124698,"_5":14884,"_28435":124525,"_3074":124699},[],"Leer y escribir el Device Shadow",{"_3697":74114,"_31245":74054,"_21577":124701,"_5":14884,"_28435":124525,"_3074":124702},[],"Para el mecanismo de desconexión forzada tras revocación también se requiere acceso a la API del plano de datos de AWS IoT (`iot:Connect` con SigV4 sobre WebSocket), que se negocia de forma implícita con las credenciales del conector.",{"_3697":74115,"_31245":74054,"_21577":124704,"_5":14884,"_28435":124529,"_3074":124705},[],"Parámetro",{"_3697":74116,"_31245":74054,"_21577":124707,"_5":14884,"_28435":124529,"_3074":124708},[],"Tipo",{"_3697":74117,"_31245":74054,"_21577":124710,"_5":14884,"_28435":124529,"_3074":124711},[],"Requerido",{"_3697":74118,"_31245":74054,"_21577":124713,"_5":14884,"_28435":124529,"_3074":123762},[],{"_3697":74119,"_31245":74054,"_21577":124715,"_5":14884,"_28435":124529,"_3074":55403},[],{"_3697":74120,"_31245":74054,"_21577":124717,"_5":14884,"_28435":124529,"_3074":25773},[],{"_3697":74121,"_31245":74054,"_21577":124719,"_5":14884,"_28435":124529,"_3074":124720},[],"Sí",{"_3697":74122,"_31245":74054,"_21577":124722,"_5":14884,"_28435":124529,"_3074":124723},[],"Identificador único de esta instancia del conector. Se usa como espacio de nombres para los metadatos: `lamassu.io/iot/{connector_id}`.",{"_3697":74123,"_31245":74054,"_21577":124725,"_5":14884,"_28435":124529,"_3074":55414},[],{"_3697":74124,"_31245":74054,"_21577":124727,"_5":14884,"_28435":124529,"_3074":25773},[],{"_3697":74125,"_31245":74054,"_21577":124729,"_5":14884,"_28435":124529,"_3074":124720},[],{"_3697":74126,"_31245":74054,"_21577":124731,"_5":14884,"_28435":124529,"_3074":124732},[],"Región AWS donde opera el conector.",{"_3697":74127,"_31245":74054,"_21577":124734,"_5":14884,"_28435":124529,"_3074":55424},[],{"_3697":74128,"_31245":74054,"_21577":124736,"_5":14884,"_28435":124529,"_3074":25773},[],{"_3697":74129,"_31245":74054,"_21577":124738,"_5":14884,"_28435":124529,"_3074":124720},[],{"_3697":74130,"_31245":74054,"_21577":124740,"_5":14884,"_28435":124529,"_3074":124741},[],"Método de autenticación: `static`, `role` o vacío (cadena de credenciales por defecto del SDK).",{"_3697":74131,"_31245":74054,"_21577":124743,"_5":14884,"_28435":124529,"_3074":55434},[],{"_3697":74132,"_31245":74054,"_21577":124745,"_5":14884,"_28435":124529,"_3074":25773},[],{"_3697":74133,"_31245":74054,"_21577":124747,"_5":14884,"_28435":124529,"_3074":124748},[],"Solo con `auth_method=static`",{"_3697":74134,"_31245":74054,"_21577":124750,"_5":14884,"_28435":124529,"_3074":124751},[],"Clave de acceso AWS.",{"_3697":74135,"_31245":74054,"_21577":124753,"_5":14884,"_28435":124529,"_3074":55445},[],{"_3697":74136,"_31245":74054,"_21577":124755,"_5":14884,"_28435":124529,"_3074":25773},[],{"_3697":74137,"_31245":74054,"_21577":124757,"_5":14884,"_28435":124529,"_3074":124748},[],{"_3697":74138,"_31245":74054,"_21577":124759,"_5":14884,"_28435":124529,"_3074":124760},[],"Clave secreta AWS.",{"_3697":74139,"_31245":74054,"_21577":124762,"_5":14884,"_28435":124529,"_3074":55455},[],{"_3697":74140,"_31245":74054,"_21577":124764,"_5":14884,"_28435":124529,"_3074":25773},[],{"_3697":74141,"_31245":74054,"_21577":124766,"_5":14884,"_28435":124529,"_3074":55460},[],{"_3697":74142,"_31245":74054,"_21577":124768,"_5":14884,"_28435":124529,"_3074":124769},[],"Token de sesión (con `auth_method=static`).",{"_3697":74143,"_31245":74054,"_21577":124771,"_5":14884,"_28435":124529,"_3074":55466},[],{"_3697":74144,"_31245":74054,"_21577":124773,"_5":14884,"_28435":124529,"_3074":25773},[],{"_3697":74145,"_31245":74054,"_21577":124775,"_5":14884,"_28435":124529,"_3074":124776},[],"Solo con `auth_method=role`",{"_3697":74146,"_31245":74054,"_21577":124778,"_5":14884,"_28435":124529,"_3074":124779},[],"ARN del rol a asumir.",{"_3697":74147,"_31245":74054,"_21577":124781,"_5":14884,"_28435":124529,"_3074":55477},[],{"_3697":74148,"_31245":74054,"_21577":124783,"_5":14884,"_28435":124529,"_3074":25773},[],{"_3697":74149,"_31245":74054,"_21577":124785,"_5":14884,"_28435":124529,"_3074":55460},[],{"_3697":74150,"_31245":74054,"_21577":124787,"_5":14884,"_28435":124529,"_3074":124788},[],"URL alternativa para todos los servicios AWS (útil con LocalStack en pruebas).",{"_3697":74151,"_31245":74054,"_21577":124790,"_5":14884,"_28435":124529,"_3074":55487},[],{"_3697":74152,"_31245":74054,"_21577":124792,"_5":14884,"_28435":124529,"_3074":92990},[],{"_3697":74153,"_31245":74054,"_21577":124794,"_5":14884,"_28435":124529,"_3074":124720},[],{"_3697":74154,"_31245":74054,"_21577":124796,"_5":14884,"_28435":124529,"_3074":124797},[],"Configuración del bus de eventos al que se suscribe el conector (AMQP o AWS SQS/SNS).",{"_3697":74155,"_31245":74054,"_21577":124799,"_5":14884,"_28435":124529,"_3074":55497},[],{"_3697":74156,"_31245":74054,"_21577":124801,"_5":14884,"_28435":124529,"_3074":25773},[],{"_3697":74157,"_31245":74054,"_21577":124803,"_5":14884,"_28435":124529,"_3074":124720},[],{"_3697":74158,"_31245":74054,"_21577":124805,"_5":14884,"_28435":124529,"_3074":124806},[],"URL HTTP del servicio DMS Manager de Lamassu.",{"_3697":74159,"_31245":74054,"_21577":124808,"_5":14884,"_28435":124529,"_3074":55507},[],{"_3697":74160,"_31245":74054,"_21577":124810,"_5":14884,"_28435":124529,"_3074":25773},[],{"_3697":74161,"_31245":74054,"_21577":124812,"_5":14884,"_28435":124529,"_3074":124720},[],{"_3697":74162,"_31245":74054,"_21577":124814,"_5":14884,"_28435":124529,"_3074":124815},[],"URL HTTP del Device Manager de Lamassu.",{"_3697":74163,"_31245":74054,"_21577":124817,"_5":14884,"_28435":124529,"_3074":55517},[],{"_3697":74164,"_31245":74054,"_21577":124819,"_5":14884,"_28435":124529,"_3074":25773},[],{"_3697":74165,"_31245":74054,"_21577":124821,"_5":14884,"_28435":124529,"_3074":124720},[],{"_3697":74166,"_31245":74054,"_21577":124823,"_5":14884,"_28435":124529,"_3074":124824},[],"URL HTTP del servicio de CA de Lamassu.",{"_3697":74167,"_31245":74054,"_21577":124826,"_5":14884,"_28435":124533,"_3074":124827},[],"El conector gestiona el lado AWS de cuatro tipos de recursos: CAs, plantillas de aprovisionamiento de DMS (JITP), certificados de dispositivo y Things. Esta sección mapea los eventos del bus que consume el conector a los recursos de AWS que toca y a las llamadas AWS que ejecuta cada flujo. La máquina de estados de cada recurso está junto a su explicación detallada; la última columna enlaza a ella. Los recursos de AWS se referencian con la notación `IoTCore/<recurso>`.",{"_3697":74168,"_31245":74054,"_21577":124829,"_5":14884,"_28435":124533,"_3074":124830},[],"La columna **Tipo de CloudEvent** lista el nombre del evento en el bus interno de Lamassu; la columna **Acciones IAM** lista las operaciones exactas del SDK de AWS que invoca cada flujo, para que los permisos necesarios se deriven directamente de esta tabla.",{"_3697":74169,"_31245":74054,"_21577":124832,"_5":14884,"_28435":124533,"_3074":124833},[],"Tipo de CloudEvent",{"_3697":74170,"_31245":74054,"_21577":124835,"_5":14884,"_28435":124533,"_3074":124836},[],"Recurso en Lamassu",{"_3697":74171,"_31245":74054,"_21577":124838,"_5":14884,"_28435":124533,"_3074":124839},[],"Recurso AWS",{"_3697":74172,"_31245":74054,"_21577":124841,"_5":14884,"_28435":124533,"_3074":124842},[],"Acciones IAM",{"_3697":74173,"_31245":74054,"_21577":124844,"_5":14884,"_28435":124533,"_3074":124845},[],"Llamadas AWS y efecto",{"_3697":74174,"_31245":74054,"_21577":124847,"_5":14884,"_28435":124533,"_3074":124848},[],"Dónde en esta página",{"_3697":74175,"_31245":74054,"_21577":124850,"_5":14884,"_28435":124533,"_3074":55551},[],{"_3697":74176,"_31245":74054,"_21577":124852,"_5":14884,"_28435":124533,"_3074":55554},[],{"_3697":74177,"_31245":74054,"_21577":124854,"_5":14884,"_28435":124533,"_3074":55557},[],{"_3697":74178,"_31245":74054,"_21577":124856,"_5":14884,"_28435":124533,"_3074":55560},[],{"_3697":74179,"_31245":74054,"_21577":124858,"_5":14884,"_28435":124533,"_3074":124859},[],"Carga la CA en el estado del conector; una escritura de `registration.status = REQUESTED` dispara el flujo de registro (Primary con certificado de verificación, o SNI-only) y escribe `SUCCEEDED` o `FAILED` en los metadatos de la CA.",{"_3697":74180,"_31245":74054,"_21577":124861,"_5":14884,"_28435":124533,"_3074":124546},[],{"_3697":74181,"_31245":74054,"_21577":124863,"_5":14884,"_28435":124533,"_3074":55568},[],{"_3697":74182,"_31245":74054,"_21577":124865,"_5":14884,"_28435":124533,"_3074":55571},[],{"_3697":74183,"_31245":74054,"_21577":124867,"_5":14884,"_28435":124533,"_3074":55574},[],{"_3697":74184,"_31245":74054,"_21577":124869,"_5":14884,"_28435":124533,"_3074":55577},[],{"_3697":74185,"_31245":74054,"_21577":124871,"_5":14884,"_28435":124533,"_3074":124872},[],"En modo `jitp`, intenta crear la plantilla de aprovisionamiento y la adjunta a la CA registrada. No idempotente: una edición `PUT /v1/dms/{id}` reintenta la creación y acaba en `lamassu-dlq` tras 3 reintentos. Idempotente para `none` y `auto` (solo configuración).",{"_3697":74186,"_31245":74054,"_21577":124874,"_5":14884,"_28435":124533,"_3074":124572},[],{"_3697":74187,"_31245":74054,"_21577":124876,"_5":14884,"_28435":124533,"_3074":55585},[],{"_3697":74188,"_31245":74054,"_21577":124878,"_5":14884,"_28435":124533,"_3074":124879},[],"Dispositivo",{"_3697":74189,"_31245":74054,"_21577":124881,"_5":14884,"_28435":124533,"_3074":55591},[],{"_3697":74190,"_31245":74054,"_21577":124883,"_5":14884,"_28435":124533,"_3074":55594},[],{"_3697":74191,"_31245":74054,"_21577":124885,"_5":14884,"_28435":124533,"_3074":124886},[],"En modo `auto`: crea/actualiza políticas, asegura los grupos de Things, revoca principals obsoletos y aprovisiona el Thing vía `iot:RegisterThing`. En modo `jitp`: no hay llamadas AWS; AWS ejecuta la plantilla JITP en la primera conexión.",{"_3697":74192,"_31245":74054,"_21577":124888,"_5":14884,"_28435":124533,"_3074":124580},[],{"_3697":74193,"_31245":74054,"_21577":124890,"_5":14884,"_28435":124533,"_3074":55602},[],{"_3697":74194,"_31245":74054,"_21577":124892,"_5":14884,"_28435":124533,"_3074":124893},[],"Certificado",{"_3697":74195,"_31245":74054,"_21577":124895,"_5":14884,"_28435":124533,"_3074":55608},[],{"_3697":74196,"_31245":74054,"_21577":124897,"_5":14884,"_28435":124533,"_3074":124898},[],"`iot:UpdateCertificate`, `iot:Connect` (plano de datos)",{"_3697":74197,"_31245":74054,"_21577":124900,"_5":14884,"_28435":124533,"_3074":124901},[],"Mapea el estado a AWS (`ACTIVE`, `INACTIVE`, `REVOKED`), llama a `iot:UpdateCertificate` y fuerza una desconexión MQTT al revocar.",{"_3697":74198,"_31245":74054,"_21577":124903,"_5":14884,"_28435":124533,"_3074":124592},[],{"_3697":74199,"_31245":74054,"_21577":124905,"_5":14884,"_28435":124533,"_3074":55619},[],{"_3697":74200,"_31245":74054,"_21577":124907,"_5":14884,"_28435":124533,"_3074":124908},[],"Certificado / Dispositivo",{"_3697":74201,"_31245":74054,"_21577":124910,"_5":14884,"_28435":124533,"_3074":55625},[],{"_3697":74202,"_31245":74054,"_21577":124912,"_5":14884,"_28435":124533,"_3074":51344},[],{"_3697":74203,"_31245":74054,"_21577":124914,"_5":14884,"_28435":124533,"_3074":124915},[],"Refresca el estado interno; el conector ignora los eventos cuyo campo CloudEvent `source` coincide con su propia URI para evitar bucles autodisparados.",{"_3697":74204,"_31245":74054,"_21577":124917,"_5":14884,"_28435":124533,"_3074":124600},[],{"_3697":74205,"_31245":74054,"_21577":124919,"_5":14884,"_28435":124537,"_3074":124920},[],"Para que los dispositivos puedan autenticarse en AWS IoT Core con certificados emitidos por una CA de Lamassu, esa CA debe registrarse previamente en la cuenta AWS. El conector gestiona este registro de forma automática en respuesta a los eventos `EventCreateCAKey`, `EventImportCAKey` y `EventUpdateCAMetadataKey`, pero la operación **solo se dispara cuando el administrador la solicita explícitamente** mediante el campo de metadatos de la CA.",{"_3697":74206,"_31245":74054,"_21577":124922,"_5":14884,"_28435":124541,"_3074":124923},[],"El registro se desencadena estableciendo el valor `registration.status = \"REQUESTED\"` en la clave `lamassu.io/iot/{connector_id}` de los metadatos de la CA. Esto puede hacerse desde la consola de Lamassu en la sección de gestión de la CA o mediante la API.",{"_3697":74207,"_31245":74054,"_21577":124925,"_5":14884,"_28435":124541,"_3074":124926},[],"Una vez recibido el evento, el conector intenta registrar la CA en AWS y actualiza el campo `registration.status` en los metadatos de la CA con el resultado: `\"SUCCEEDED\"` si el registro fue correcto, o `\"FAILED\"` acompañado de un mensaje de error en caso contrario. El proceso es asíncrono, por lo que es necesario consultar periódicamente el estado de los metadatos hasta que la operación concluya.",{"_3697":74208,"_31245":74054,"_21577":124928,"_5":14884,"_28435":124545,"_3074":124929},[],"El flujo de registro de la CA se gobierna por el campo `registration.status` de los metadatos del conector en la CA:",{"_3697":74209,"_31245":74054,"_21577":124931,"_5":14884,"_28435":124545,"_3074":124932},[],"Transición",{"_3697":74210,"_31245":74054,"_21577":124934,"_5":14884,"_28435":124545,"_3074":124935},[],"Llamadas AWS",{"_3697":74211,"_31245":74054,"_21577":124937,"_5":14884,"_28435":124545,"_3074":124938},[],"`NoRegistrada` → `Solicitada`",{"_3697":74212,"_31245":74054,"_21577":124940,"_5":14884,"_28435":124545,"_3074":124941},[],"ninguna (solo escritura de metadatos)",{"_3697":74213,"_31245":74054,"_21577":124943,"_5":14884,"_28435":124545,"_3074":124944},[],"`Solicitada` → `Registrando`",{"_3697":74214,"_31245":74054,"_21577":124946,"_5":14884,"_28435":124545,"_3074":124947},[],"`iot:GetRegistrationCode` (solo Primary Account)",{"_3697":74215,"_31245":74054,"_21577":124949,"_5":14884,"_28435":124545,"_3074":124950},[],"`Registrando` → `Completada`",{"_3697":74216,"_31245":74054,"_21577":124952,"_5":14884,"_28435":124545,"_3074":124953},[],"`iot:RegisterCACertificate` (Primary: prueba de posesión con clave efímera; SNI-only: `CertificateMode: SNI_ONLY`)",{"_3697":74217,"_31245":74054,"_21577":124955,"_5":14884,"_28435":124545,"_3074":124956},[],"`Registrando` → `Fallida`",{"_3697":74218,"_31245":74054,"_21577":124958,"_5":14884,"_28435":124545,"_3074":124959},[],"`iot:RegisterCACertificate` fallida; el detalle del error se escribe en los metadatos de la CA",{"_3697":74219,"_31245":74054,"_21577":124961,"_5":14884,"_28435":124545,"_3074":124962},[],"`Fallida` / `Completada` → `Solicitada`",{"_3697":74220,"_31245":74054,"_21577":124964,"_5":14884,"_28435":124545,"_3074":124965},[],"ninguna (una nueva escritura `REQUESTED` reejecuta el flujo)",{"_3697":74221,"_31245":74054,"_21577":124967,"_5":14884,"_28435":124549,"_3074":124968},[],"Cuando el parámetro `primary_account` es `true`, el conector ejecuta el flujo completo de registro con verificación de posesión de clave privada:",{"_3697":74222,"_31245":74054,"_21577":124970,"_5":14884,"_28435":124549,"_3074":124971},[],"Llama a `iot:GetRegistrationCode` para obtener el código de verificación de AWS.",{"_3697":74223,"_31245":74054,"_21577":124973,"_5":14884,"_28435":124549,"_3074":124974},[],"El conector genera internamente un par de claves RSA-2048 efímero y construye un CSR cuyo Common Name es exactamente ese código de registro. A continuación llama al servicio de firma de Lamassu para que la CA registrada emita un certificado de verificación X.509 real firmando ese CSR. La clave privada efímera se usa únicamente para este propósito y no se almacena ni se envía a AWS.",{"_3697":74224,"_31245":74054,"_21577":124976,"_5":14884,"_28435":124549,"_3074":124977},[],"Envía a AWS la CA (en PEM) y el certificado de verificación mediante `iot:RegisterCACertificate`, activando el registro con `AllowAutoRegistration: true`.",{"_3697":74225,"_31245":74054,"_21577":124979,"_5":14884,"_28435":124549,"_3074":124980},[],"Solo una cuenta puede ser propietaria de una CA en una región AWS dada. Si la CA ya está registrada con el mismo número de serie, el conector omite el paso silenciosamente.",{"_3697":74226,"_31245":74054,"_21577":124982,"_5":14884,"_28435":124549,"_3074":124983},[],"Los tags que AWS IoT Core aplica al certificado de CA registrado son `LMS.CA.ID`, `LMS.CA.SN` y `LMS.CA.CN`.",{"_3697":74227,"_31245":74054,"_21577":124985,"_5":14884,"_28435":124552,"_3074":124986},[],"Cuando `primary_account` es `false`, el conector registra la CA usando el modo `CertificateMode: SNI_ONLY`. Este modo no requiere código de verificación ni acceso a la clave privada de la CA, por lo que es la opción adecuada cuando la CA se gestiona desde otra cuenta de AWS o cuando el administrador no dispone de la clave privada. Es el método habitual para registrar la misma CA en varias cuentas de AWS simultáneamente.",{"_3697":74228,"_31245":74054,"_21577":124988,"_5":14884,"_28435":124555,"_3074":124989},[],"Cada DMS que participe en la integración con AWS IoT Core debe tener configurada la clave de metadatos `lamassu.io/iot/{connector_id}`. El campo más importante de esa configuración es `registration_mode`, que determina cómo se aprovisionan los dispositivos en AWS.",{"_3697":74229,"_31245":74054,"_21577":124991,"_5":14884,"_28435":124555,"_3074":124992},[],"Existen tres modos de registro, y la elección entre ellos depende de la estrategia de aprovisionamiento de la flota.",{"_3697":74230,"_31245":74054,"_21577":124994,"_5":14884,"_28435":124559,"_3074":124995},[],"En este modo el conector **no crea Things, grupos ni políticas** en AWS IoT Core. Se limita a sincronizar el estado de los certificados (activo, revocado, suspendido) a medida que cambian en Lamassu. Es el modo adecuado cuando el aprovisionamiento de Things en AWS se gestiona por un sistema externo y solo se necesita que Lamassu mantenga el estado de los certificados actualizado.",{"_3697":74231,"_31245":74054,"_21577":124997,"_5":14884,"_28435":124563,"_3074":124998},[],"El modo `auto` delega en Lamassu el aprovisionamiento completo del dispositivo en AWS en el momento del enrolamiento. Cuando el dispositivo completa con éxito su enrolamiento EST y Lamassu emite el evento `EventBindDeviceIdentityKey`, el conector ejecuta automáticamente la siguiente secuencia:",{"_3697":74232,"_31245":74054,"_21577":125000,"_5":14884,"_28435":124563,"_3074":125001},[],"Crea o actualiza las políticas IoT configuradas en el DMS.",{"_3697":74233,"_31245":74054,"_21577":125003,"_5":14884,"_28435":124563,"_3074":125004},[],"Crea el grupo raíz `LAMASSU` en la cuenta AWS (si no existe) y los grupos hijos configurados en el DMS como subgrupos de `LAMASSU`. Si los grupos ya existen, el error `ResourceAlreadyExistsException` se ignora, por lo que la operación es idempotente.",{"_3697":74234,"_31245":74054,"_21577":125006,"_5":14884,"_28435":124563,"_3074":125007},[],"Si el Thing ya existía en AWS IoT Core, el conector itera todos los certificados (principals) actualmente adjuntos a ese Thing y los marca como `REVOKED` en AWS, para garantizar que los certificados anteriores no puedan seguir siendo usados para autenticarse.",{"_3697":74235,"_31245":74054,"_21577":125009,"_5":14884,"_28435":124563,"_3074":125010},[],"Llama a `iot:RegisterThing` con una plantilla de aprovisionamiento de estilo CloudFormation que crea el Thing, registra el certificado del dispositivo (PEM del certificado del dispositivo y del certificado de la CA emisora) y adjunta las políticas configuradas.\nUna vez completado el aprovisionamiento, el conector almacena el ARN del certificado resultante en los metadatos del certificado de Lamassu bajo la clave `lamassu.io/iot/{connector_id}` y marca el dispositivo como `Registered: true` en Device Manager.",{"_3697":74236,"_31245":74054,"_21577":125012,"_5":14884,"_28435":124563,"_3074":125013},[],"**El nombre del Thing en AWS es el Common Name (CN) del certificado del dispositivo.** Esta convención es fundamental para el desarrollador de firmware: el valor `/CN=` que el dispositivo incluye en su CSR al enrolarse se convierte en el ThingName con el que deberá identificarse en todas las operaciones MQTT contra AWS IoT Core.",{"_3697":74237,"_31245":74054,"_21577":125015,"_5":14884,"_28435":124567,"_3074":125016},[],"El modo Just-In-Time Provisioning (JITP) delega el aprovisionamiento en AWS en lugar de hacerlo el conector directamente. Cuando el conector detecta que el DMS está en modo `jitp`, crea una plantilla de aprovisionamiento JITP en AWS IoT Core y la adjunta al certificado de CA registrado. El conector intenta crear esta plantilla cuando el DMS se crea y de nuevo en cada edición completa del DMS (`PUT /v1/dms/{id}`) - no en el momento del enrolamiento del dispositivo. El intento no es idempotente: cuando ya existe una plantilla nombrada con el ID del DMS, la llamada de creación falla, el evento se reintenta tres veces y acaba en la cola de mensajes fallidos `lamassu-dlq` (ver Solución de problemas). La plantilla se crea una sola vez; las ediciones posteriores nunca actualizan su contenido. Una actualización del DMS que omite `metadata` o envía `null` conserva los metadatos almacenados, así que la clave del conector `lamassu.io/iot/{connector_id}` sigue presente y el intento se sigue disparando. Un cuerpo que suministra un objeto `metadata` sustituye por completo los metadatos almacenados: si ese objeto no lleva la clave del conector, la clave se elimina y el conector omite silenciosamente los eventos futuros del DMS. Una vez adjuntada la plantilla, cuando un dispositivo con un certificado emitido por esa CA se conecta por primera vez a AWS IoT Core, AWS ejecuta la plantilla automáticamente: crea el Thing, registra el certificado y lo activa.",{"_3697":74238,"_31245":74054,"_21577":125018,"_5":14884,"_28435":124567,"_3074":125019},[],"El conector crea la plantilla, nombrada con el ID del DMS, una sola vez. Cada edición posterior del DMS que conserve la clave del conector intenta crearla de nuevo y falla, porque el conector no actualiza plantillas existentes. Los cambios posteriores en `jitp_config.provisioning_role_arn`, `jitp_config.enable_template` o en los grupos y políticas que la plantilla referencia deben aplicarse a mano en AWS IoT Core.",{"_3697":74239,"_31245":74054,"_21577":125021,"_5":14884,"_28435":124567,"_3074":125022},[],"El evento fallido se reintenta y termina en `lamassu-dlq`. Los grupos y las políticas se registran antes del fallo, pero se omiten la asignación de la plantilla a la CA registrada, la escritura del ARN en el DMS y la actualización de las shadows al cambiar `ManagedCAs`.",{"_3697":74240,"_31245":74054,"_21577":125024,"_5":14884,"_28435":124567,"_3074":125025},[],"El nombre del Thing en la plantilla JITP se deriva de `AWS::IoT::Certificate::CommonName`, que corresponde al CN del certificado del dispositivo - la misma convención que el modo `auto`.",{"_3697":74241,"_31245":74054,"_21577":125027,"_5":14884,"_28435":124567,"_3074":125028},[],"Este modo requiere que se configure el campo `jitp_config.provisioning_role_arn` con el ARN de un rol IAM que AWS IoT Core pueda asumir para ejecutar la plantilla. Si no se configura, el conector utiliza el valor por defecto `arn:aws:iam::{account}:role/JITPRole` y registra un aviso en el log. El administrador debe asegurarse de que ese rol existe en la cuenta y tiene los permisos necesarios antes de activar el modo JITP.",{"_3697":74242,"_31245":74054,"_21577":125030,"_5":14884,"_28435":124571,"_3074":125031},[],"El `registration_mode` del DMS determina qué hace el conector en el lado AWS cuando el DMS se crea o se edita por completo:",{"_3697":74243,"_31245":74054,"_21577":125033,"_5":14884,"_28435":124571,"_3074":124932},[],{"_3697":74244,"_31245":74054,"_21577":125035,"_5":14884,"_28435":124571,"_3074":124935},[],{"_3697":74245,"_31245":74054,"_21577":125037,"_5":14884,"_28435":124571,"_3074":125038},[],"`SinConfigurar` → `None` / `Auto`",{"_3697":74246,"_31245":74054,"_21577":125040,"_5":14884,"_28435":124571,"_3074":125041},[],"ninguna (solo configuración)",{"_3697":74247,"_31245":74054,"_21577":125043,"_5":14884,"_28435":124571,"_3074":55762},[],{"_3697":74248,"_31245":74054,"_21577":125045,"_5":14884,"_28435":124571,"_3074":125041},[],{"_3697":74249,"_31245":74054,"_21577":125047,"_5":14884,"_28435":124571,"_3074":125048},[],"Cualquiera → `Jitp`",{"_3697":74250,"_31245":74054,"_21577":125050,"_5":14884,"_28435":124571,"_3074":125051},[],"`iot:CreateProvisioningTemplate` (no idempotente: falla si la plantilla ya existe; tras 3 reintentos el evento acaba en `lamassu-dlq`)",{"_3697":74251,"_31245":74054,"_21577":125053,"_5":14884,"_28435":124571,"_3074":55773},[],{"_3697":74252,"_31245":74054,"_21577":125055,"_5":14884,"_28435":124571,"_3074":125056},[],"ninguna (la plantilla permanece en la cuenta AWS)",{"_3697":74253,"_31245":74054,"_21577":125058,"_5":14884,"_28435":124575,"_3074":125059},[],"Para el desarrollador de firmware, el modo `auto` es transparente: el dispositivo realiza su enrolamiento EST de la forma habitual y, como efecto secundario, queda aprovisionado en AWS IoT Core sin ningún paso adicional.",{"_3697":74254,"_31245":74054,"_21577":125061,"_5":14884,"_28435":124575,"_3074":125062},[],"El flujo completo desde el punto de vista del dispositivo es el siguiente:",{"_3697":74255,"_31245":74054,"_21577":125064,"_5":14884,"_28435":124575,"_3074":125065},[],"Una vez que el conector completa el aprovisionamiento, el dispositivo puede conectarse al endpoint AWS IoT Core de MQTT usando su clave privada y el certificado emitido por Lamassu. El ThingName con el que debe identificarse en AWS es exactamente el CN del certificado.",{"_3697":74256,"_31245":74054,"_21577":125067,"_5":14884,"_28435":124579,"_3074":125068},[],"Los Things solo existen en modo `auto`; en modo `jitp` AWS crea el Thing por sí mismo cuando el dispositivo se conecta por primera vez. El nombre del Thing es siempre el CN del certificado del dispositivo:",{"_3697":74257,"_31245":74054,"_21577":125070,"_5":14884,"_28435":124579,"_3074":124932},[],{"_3697":74258,"_31245":74054,"_21577":125072,"_5":14884,"_28435":124579,"_3074":124935},[],{"_3697":74259,"_31245":74054,"_21577":125074,"_5":14884,"_28435":124579,"_3074":125075},[],"`Ausente` → `Aprovisionado`",{"_3697":74260,"_31245":74054,"_21577":125077,"_5":14884,"_28435":124579,"_3074":125078},[],"políticas creadas/actualizadas, grupos de Things asegurados, `iot:RegisterThing` (crea el Thing, registra el certificado, adjunta políticas)",{"_3697":74261,"_31245":74054,"_21577":125080,"_5":14884,"_28435":124579,"_3074":125081},[],"`Aprovisionado` → `Aprovisionado` (re-enrolamiento)",{"_3697":74262,"_31245":74054,"_21577":125083,"_5":14884,"_28435":124579,"_3074":125084},[],"principals obsoletos marcados como `REVOKED`, nueva ejecución de `iot:RegisterThing`; el nuevo ARN del certificado sustituye al anterior en los metadatos de Lamassu",{"_3697":74263,"_31245":74054,"_21577":125086,"_5":14884,"_28435":124579,"_3074":125087},[],"En modo `jitp` el conector no hace llamadas de aprovisionamiento: AWS ejecuta la plantilla JITP en la primera conexión del dispositivo y crea el Thing, registra el certificado y lo activa por su cuenta.",{"_3697":74264,"_31245":74054,"_21577":125089,"_5":14884,"_28435":124583,"_3074":125090},[],"En el modo JITP el dispositivo también realiza su enrolamiento EST de forma convencional y obtiene su certificado de Lamassu. La diferencia es que AWS IoT Core no conoce al dispositivo hasta que este intenta conectarse por primera vez.",{"_3697":74265,"_31245":74054,"_21577":125092,"_5":14884,"_28435":124583,"_3074":125093},[],"Cuando el dispositivo establece su primera conexión MQTT a AWS IoT Core presentando el certificado emitido por Lamassu, AWS detecta que el certificado pertenece a una CA registrada con una plantilla JITP, ejecuta esa plantilla y crea el Thing automáticamente. La conexión inicial puede fallar o demorarse mientras se ejecuta la plantilla; el firmware debe estar preparado para reintentar la conexión.",{"_3697":74266,"_31245":74054,"_21577":125095,"_5":14884,"_28435":124583,"_3074":125096},[],"Para que el flujo JITP funcione correctamente:",{"_3697":74267,"_31245":74054,"_21577":125098,"_5":14884,"_28435":124583,"_3074":125099},[],"La CA debe estar registrada en AWS en modo Primary Account (el modo SNI-only no admite JITP).",{"_3697":74268,"_31245":74054,"_21577":125101,"_5":14884,"_28435":124583,"_3074":125102},[],"El rol IAM configurado en `jitp_config.provisioning_role_arn` debe existir y tener permisos para crear Things, registrar certificados y adjuntar políticas en la cuenta AWS.",{"_3697":74269,"_31245":74054,"_21577":125104,"_5":14884,"_28435":124583,"_3074":125105},[],"El dispositivo debe presentar tanto su certificado como el certificado de la CA emisora en el handshake TLS con AWS IoT Core.",{"_3697":74270,"_31245":74054,"_21577":125107,"_5":14884,"_28435":124583,"_3074":125108},[],"Los certificados aprovisionados mediante JITP **no tienen asociada la clave de metadatos del conector** (`lamassu.io/iot/{connector_id}`) en Lamassu. Como consecuencia, los cambios de estado de esos certificados en Lamassu no se sincronizan automáticamente con AWS a través del mecanismo de sincronización de estado descrito en la siguiente sección.",{"_3697":74271,"_31245":74054,"_21577":125110,"_5":14884,"_28435":124587,"_3074":125111},[],"El conector escucha el evento `EventUpdateCertificateStatusKey` y, cuando un certificado que tiene la clave de metadatos del conector cambia de estado en Lamassu, replica ese cambio en AWS IoT Core. La tabla siguiente muestra la correspondencia de estados:",{"_3697":74272,"_31245":74054,"_21577":125113,"_5":14884,"_28435":124587,"_3074":125114},[],"Estado en Lamassu",{"_3697":74273,"_31245":74054,"_21577":125116,"_5":14884,"_28435":124587,"_3074":125117},[],"Razón de revocación",{"_3697":74274,"_31245":74054,"_21577":125119,"_5":14884,"_28435":124587,"_3074":125120},[],"Estado en AWS IoT Core",{"_3697":74275,"_31245":74054,"_21577":125122,"_5":14884,"_28435":124587,"_3074":55843},[],{"_3697":74276,"_31245":74054,"_21577":125124,"_5":14884,"_28435":124587,"_3074":125125},[],"Ninguna",{"_3697":74277,"_31245":74054,"_21577":125127,"_5":14884,"_28435":124587,"_3074":55849},[],{"_3697":74278,"_31245":74054,"_21577":125129,"_5":14884,"_28435":124587,"_3074":55852},[],{"_3697":74279,"_31245":74054,"_21577":125131,"_5":14884,"_28435":124587,"_3074":55855},[],{"_3697":74280,"_31245":74054,"_21577":125133,"_5":14884,"_28435":124587,"_3074":55858},[],{"_3697":74281,"_31245":74054,"_21577":125135,"_5":14884,"_28435":124587,"_3074":55852},[],{"_3697":74282,"_31245":74054,"_21577":125137,"_5":14884,"_28435":124587,"_3074":125138},[],"Cualquier otra razón",{"_3697":74283,"_31245":74054,"_21577":125140,"_5":14884,"_28435":124587,"_3074":55866},[],{"_3697":74284,"_31245":74054,"_21577":125142,"_5":14884,"_28435":124587,"_3074":125143},[],"Solo los estados `Active` y `Revoked` producen una llamada a `iot:UpdateCertificate`. Los demás estados del ciclo de vida de Lamassu (`RenewalWindow`, `AboutToExpire`, `Expired`) no se sincronizan con AWS IoT Core; el estado del certificado en AWS permanece sin cambios hasta que el estado en Lamassu sea `Active` o `Revoked`.",{"_3697":74285,"_31245":74054,"_21577":125145,"_5":14884,"_28435":124591,"_3074":125146},[],"Los certificados con la clave de metadatos del conector sincronizan su estado; los aprovisionados vía JITP no tienen clave de metadatos y quedan fuera de esta máquina:",{"_3697":74286,"_31245":74054,"_21577":125148,"_5":14884,"_28435":124591,"_3074":124932},[],{"_3697":74287,"_31245":74054,"_21577":125150,"_5":14884,"_28435":124591,"_3074":124935},[],{"_3697":74288,"_31245":74054,"_21577":125152,"_5":14884,"_28435":124591,"_3074":125153},[],"`NoSincronizado` → `Active`",{"_3697":74289,"_31245":74054,"_21577":125155,"_5":14884,"_28435":124591,"_3074":55359},[],{"_3697":74290,"_31245":74054,"_21577":125157,"_5":14884,"_28435":124591,"_3074":55884},[],{"_3697":74291,"_31245":74054,"_21577":125159,"_5":14884,"_28435":124591,"_3074":125160},[],"`iot:UpdateCertificate` + desconexión MQTT forzada",{"_3697":74292,"_31245":74054,"_21577":125162,"_5":14884,"_28435":124591,"_3074":55890},[],{"_3697":74293,"_31245":74054,"_21577":125164,"_5":14884,"_28435":124591,"_3074":125160},[],{"_3697":74294,"_31245":74054,"_21577":125166,"_5":14884,"_28435":124591,"_3074":55895},[],{"_3697":74295,"_31245":74054,"_21577":125168,"_5":14884,"_28435":124591,"_3074":55359},[],{"_3697":74296,"_31245":74054,"_21577":125170,"_5":14884,"_28435":124591,"_3074":55900},[],{"_3697":74297,"_31245":74054,"_21577":125172,"_5":14884,"_28435":124591,"_3074":125173},[],"ninguna (estos estados no se sincronizan con AWS)",{"_3697":74298,"_31245":74054,"_21577":125175,"_5":14884,"_28435":124595,"_3074":125176},[],"Cuando el conector marca un certificado como `REVOKED` o `INACTIVE` en AWS, ejecuta adicionalmente una desconexión forzada del dispositivo. Para ello abre una conexión MQTT sobre WebSocket (con autenticación SigV4 con las credenciales del conector) al endpoint de datos de AWS IoT Core, usando el CN del certificado como identificador de cliente MQTT, y la cierra inmediatamente. Esto termina cualquier sesión MQTT activa que el dispositivo pueda tener en ese momento.",{"_3697":74299,"_31245":74054,"_21577":125178,"_5":14884,"_28435":124595,"_3074":125179},[],"Esta desconexión forzada se produce en el momento en que Lamassu registra el cambio de estado. Si el dispositivo vuelve a intentar conectarse tras la desconexión, AWS IoT Core rechazará la conexión porque el certificado ya figura como `REVOKED` o `INACTIVE`.",{"_3697":74300,"_31245":74054,"_21577":125181,"_5":14884,"_28435":124595,"_3074":125182},[],"Los certificados aprovisionados en modo JITP no disponen de esta sincronización automática, ya que no tienen la clave de metadatos del conector.",{"_3697":74301,"_31245":74054,"_21577":125184,"_5":14884,"_28435":124599,"_3074":125185},[],"El conector puede escribir en el Device Shadow de AWS IoT Core para enviar señales de acción al firmware del dispositivo. Esta funcionalidad se activa por DMS mediante `shadow_config.enable: true`.",{"_3697":74302,"_31245":74054,"_21577":125187,"_5":14884,"_28435":124599,"_3074":125188},[],"Si `shadow_config.shadow_name` contiene un valor, el conector usa un Named Shadow con ese nombre; en caso contrario, usa el Classic Shadow (shadow predeterminado del Thing).",{"_3697":74303,"_31245":74054,"_21577":125190,"_5":14884,"_28435":124603,"_3074":125191},[],"El conector escribe en el campo `desired.identity_actions` del documento shadow. Cada entrada contiene un timestamp Unix en milisegundos. El firmware del dispositivo debe leer este campo y actuar en consecuencia.",{"_3697":74304,"_31245":74054,"_21577":125193,"_5":14884,"_28435":124603,"_3074":125194},[],"Existen dos tipos de acciones:",{"_3697":74305,"_31245":74054,"_21577":125196,"_5":14884,"_28435":124603,"_3074":125197},[],"**`UPDATE_CERTIFICATE`**: se escribe cuando la ventana de renovación preventiva de un certificado se activa - es decir, cuando el campo `triggered` de la delta de renovación preventiva pasa de `false` a `true`. Esta acción indica al dispositivo que debe iniciar el proceso de re-enrolamiento para renovar su certificado antes de que expire.",{"_3697":74306,"_31245":74054,"_21577":125199,"_5":14884,"_28435":124603,"_3074":125200},[],"**`UPDATE_TRUST_ANCHOR_LIST`**: se escribe en todos los dispositivos de un DMS cuando la lista `ManagedCAs` del DMS cambia. Esta acción indica al dispositivo que debe actualizar su almacén de CAs de confianza.",{"_3697":74307,"_31245":74054,"_21577":125202,"_5":14884,"_28435":124603,"_3074":125203},[],"El proceso de escritura en el shadow consiste en leer el shadow actual (`iotdata:GetThingShadow`), combinar las nuevas acciones con las existentes y escribir el resultado (`iotdata:UpdateThingShadow`). Si el shadow no existe, el conector lo crea. Tras una escritura correcta, la lista de acciones pendientes en los metadatos del dispositivo en Lamassu se limpia.",{"_3697":74308,"_31245":74054,"_21577":125205,"_5":14884,"_28435":124607,"_3074":125206},[],"El conector crea y adjunta las políticas que se configuran en el DMS. Una política típica para un dispositivo que usa MQTT y Device Shadow tiene la siguiente estructura:",{"_3697":74309,"_31245":74054,"_21577":125208,"_5":14884,"_28435":124607,"_3074":125209},[],"En la política anterior, los marcadores `<AWS_REGION>` y `<AWS_ACCOUNT_ID>` deben reemplazarse por la región AWS y el identificador de cuenta de doce dígitos de la cuenta destino antes de aplicar la política. La variable `${iot:Connection.Thing.ThingName}` limita automáticamente cada permiso al Thing al que el dispositivo está conectado, siguiendo el principio de mínimo privilegio. La variable `${ShadowName}` en los ARN de shadow es un marcador que debe reemplazarse con el valor de `shadow_config.shadow_name` configurado en el DMS; si se usa el Classic Shadow, se puede simplificar eliminando el segmento `name/${ShadowName}/`. Las políticas de AWS IoT no admiten expresiones regulares con alternancia; la notación `[name/${ShadowName}/]*` representa la opcionalidad del segmento dentro de las restricciones de la sintaxis de ARN.",{"_3697":74310,"_31245":74054,"_21577":125211,"_5":14884,"_28435":124607,"_3074":125212},[],"El primer statement permite que el dispositivo se conecte usando su ThingName como identificador MQTT. El segundo autoriza la publicación en el topic MQTT genérico del Thing y en los topics del shadow, necesario para que el dispositivo pueda actualizar el estado reportado. Los dos últimos statements otorgan permisos de suscripción y recepción sobre los mismos topics, lo que permite al dispositivo recibir actualizaciones del shadow (por ejemplo, las acciones `UPDATE_CERTIFICATE` y `UPDATE_TRUST_ANCHOR_LIST` escritas por el conector).",{"_3697":74311,"_31245":74054,"_21577":125214,"_5":14884,"_28435":124611,"_3074":125215},[],"**Síntoma:** El registro de la CA permanece indefinidamente en estado `REQUESTED`.",{"_3697":74312,"_31245":74054,"_21577":125217,"_5":14884,"_28435":124611,"_3074":125218},[],"**Causa:** El conector no está en ejecución o no está suscrito al bus de eventos. También puede indicar credenciales IAM incorrectas, permisos insuficientes o que la clave de metadatos se escribió con un `connector_id` incorrecto.",{"_3697":74313,"_31245":74054,"_21577":125220,"_5":14884,"_28435":124611,"_3074":125221},[],"**Resolución:** Verificar que el proceso del conector está activo y que los logs no muestran errores de comunicación con AWS. Comprobar que el campo de metadatos se escribió bajo la clave exacta `lamassu.io/iot/{connector_id}`. Si el error persiste, el conector actualizará el estado a `FAILED` con un mensaje descriptivo en los metadatos de la CA.",{"_3697":74314,"_31245":74054,"_21577":125223,"_5":14884,"_28435":124611,"_3074":125224},[],"**Síntoma:** El estado de un certificado no se sincroniza con AWS tras una revocación.",{"_3697":74315,"_31245":74054,"_21577":125226,"_5":14884,"_28435":124611,"_3074":125227},[],"**Causa:** Lo más habitual es que el certificado fue aprovisionado en modo JITP. Los certificados JITP no tienen la clave de metadatos del conector y quedan fuera del mecanismo de sincronización de estado. Si el DMS está en modo `auto`, puede indicar que el aprovisionamiento inicial no completó correctamente y el ARN de AWS no se almacenó en los metadatos del certificado.",{"_3697":74316,"_31245":74054,"_21577":125229,"_5":14884,"_28435":124611,"_3074":125230},[],"**Resolución:** Para certificados JITP, migrar el DMS a modo `auto` y re-aprovisionar los dispositivos afectados. Para certificados en modo `auto`, verificar que el certificado tiene el ARN de AWS almacenado en sus metadatos; si no lo tiene, repetir el aprovisionamiento.",{"_3697":74317,"_31245":74054,"_21577":125232,"_5":14884,"_28435":124611,"_3074":125233},[],"**Síntoma:** La desconexión forzada no termina la sesión MQTT del dispositivo tras la revocación.",{"_3697":74318,"_31245":74054,"_21577":125235,"_5":14884,"_28435":124611,"_3074":125236},[],"**Causa:** El dispositivo usa un client ID MQTT diferente al CN del certificado. La desconexión forzada abre una conexión usando el CN como client ID; si el firmware usa otro identificador, la desconexión no afecta a esa sesión.",{"_3697":74319,"_31245":74054,"_21577":125238,"_5":14884,"_28435":124611,"_3074":125239},[],"**Resolución:** Asegurarse de que el firmware usa exactamente el CN del certificado como identificador de cliente MQTT. Ese CN coincide con el ThingName en AWS IoT Core.",{"_3697":74320,"_31245":74054,"_21577":125241,"_5":14884,"_28435":124611,"_3074":125242},[],"**Síntoma:** El dispositivo recibe `CLIENT_ID_REJECTED` al conectarse a AWS IoT Core.",{"_3697":74321,"_31245":74054,"_21577":125244,"_5":14884,"_28435":124611,"_3074":125245},[],"**Causa:** El client ID MQTT no coincide con el ThingName, que es siempre el CN del certificado emitido por Lamassu.",{"_3697":74322,"_31245":74054,"_21577":125247,"_5":14884,"_28435":124611,"_3074":125248},[],"**Resolución:** Verificar que el firmware usa exactamente el valor del campo CN incluido en el CSR de enrolamiento como identificador de cliente MQTT.",{"_3697":74323,"_31245":74054,"_21577":125250,"_5":14884,"_28435":124611,"_3074":125251},[],"**Síntoma:** La primera conexión MQTT del dispositivo en modo JITP falla o excede el tiempo de espera.",{"_3697":74324,"_31245":74054,"_21577":125253,"_5":14884,"_28435":124611,"_3074":125254},[],"**Causa:** Es el comportamiento esperado mientras AWS ejecuta la plantilla JITP en la primera conexión del dispositivo.",{"_3697":74325,"_31245":74054,"_21577":125256,"_5":14884,"_28435":124611,"_3074":125257},[],"**Resolución:** El firmware debe implementar reintentos con backoff exponencial para la primera conexión. Si el fallo persiste más allá de unos minutos, verificar que el rol IAM configurado en `jitp_config.provisioning_role_arn` existe en la cuenta y tiene permisos para crear Things, registrar certificados y adjuntar políticas.",{"_3697":74326,"_31245":74054,"_21577":125259,"_5":14884,"_28435":124611,"_3074":125260},[],"**Síntoma:** El Device Shadow no se actualiza cuando debería.",{"_3697":74327,"_31245":74054,"_21577":125262,"_5":14884,"_28435":124611,"_3074":125263},[],"**Causa:** La función de shadow está desactivada en la configuración del DMS, las credenciales del conector carecen de permisos sobre la API de datos de IoT, o el firmware lee un shadow diferente al configurado.",{"_3697":74328,"_31245":74054,"_21577":125265,"_5":14884,"_28435":124611,"_3074":125266},[],"**Resolución:** Comprobar que `shadow_config.enable` está a `true` en los metadatos del conector para el DMS correspondiente. Si se usa Named Shadow, verificar que `shadow_config.shadow_name` contiene el nombre correcto y que el firmware lee ese Named Shadow y no el Classic Shadow. Confirmar que las credenciales del conector tienen permisos `iotdata:GetThingShadow` y `iotdata:UpdateThingShadow`.",{"_3697":74329,"_31245":74054,"_21577":125268,"_5":14884,"_28435":124611,"_3074":125269},[],"**Síntoma:** Tras editar un DMS en modo `jitp`, aparecen mensajes de actualización del DMS en `lamassu-dlq`, o los cambios de configuración JITP no tienen efecto en AWS.",{"_3697":74330,"_31245":74054,"_21577":125271,"_5":14884,"_28435":124611,"_3074":125272},[],"**Causa:** Cada edición completa del DMS (`PUT /v1/dms/{id}`) dispara un nuevo intento de `CreateProvisioningTemplate` para la plantilla nombrada con el ID del DMS, y la llamada no es idempotente: cuando la plantilla ya existe, falla, el evento se reintenta tres veces y acaba en `lamassu-dlq`. Se omiten los pasos posteriores del conector.",{"_3697":74331,"_31245":74054,"_21577":125274,"_5":14884,"_28435":124611,"_3074":125275},[],"**Resolución:** Comprobar que la plantilla nombrada con el ID del DMS existe en AWS IoT Core y que el enrolamiento JITP funciona. Si se cambió la configuración JITP, aplicarla a mano en la plantilla de AWS.",{"_3697":74332,"_31245":74054,"_21577":125277,"_5":14884,"_28435":124611,"_3074":125278},[],"<Card title=\"Configurar un DMS\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_3697":74333,"_31245":74054,"_21577":125280,"_5":14884,"_28435":124611,"_3074":125281},[],"<Card title=\"Enrolamiento de dispositivos (EST)\" href=\"/docs/platform/iot-fleets/est\" />",{"_3697":74334,"_31245":74054,"_21577":125283,"_5":14884,"_28435":124611,"_3074":125284},[],"<Card title=\"Gestión de certificados\" href=\"/docs/platform/pki/certificates\" />",{"_3697":74335,"_31245":74335,"_5":15238,"_3074":53661,"_31570":125286,"_21577":125287,"_28435":74335},[50948,121910,53661],[],{"_3697":74336,"_31245":74335,"_21577":125289,"_5":14884,"_28435":74335,"_3074":125290},[],"Organiza los dispositivos y sus identidades, prepara el enrolamiento e integra consumidores.",{"_3697":74337,"_31245":74335,"_5":31567,"_21577":125292,"_28435":125293,"_3074":125294},[],"/docs/es/platform/iot-fleets/overview#empieza-aquí","Empieza aquí",{"_3697":74338,"_31245":74335,"_5":31567,"_21577":125296,"_28435":125297,"_3074":123055},[],"/docs/es/platform/iot-fleets/overview#dispositivos-e-identidades",{"_3697":74339,"_31245":74335,"_5":31567,"_21577":125299,"_28435":125300,"_3074":123246},[],"/docs/es/platform/iot-fleets/overview#enrolamiento-con-pki",{"_3697":74340,"_31245":74335,"_5":31567,"_21577":125302,"_28435":125303,"_3074":124510},[],"/docs/es/platform/iot-fleets/overview#integraciones",{"_3697":74341,"_31245":74335,"_5":31567,"_21577":125305,"_28435":125306,"_3074":125307},[],"/docs/es/platform/iot-fleets/overview#quién-prepara-cada-parte","Quién prepara cada parte",{"_3697":74342,"_31245":74335,"_21577":125309,"_5":14884,"_28435":74335,"_3074":125310},[],"IoT Fleets aplica la PKI al ciclo de vida de dispositivos: registro, obtención de identidad, renovación y retirada. Está dirigido a quien administra una población de dispositivos y a quien integra su cliente de enrolamiento o el sistema que los acepta.",{"_3697":74343,"_31245":74335,"_21577":125312,"_5":14884,"_28435":125293,"_3074":125313},[],"Sigue Enrola y conecta tu primer dispositivo para preparar un DMS, obtener la identidad desde el cliente y demostrar una conexión mTLS. El recorrido automático incluye confianza inicial, CSR y comprobación del resultado.",{"_3697":74344,"_31245":74335,"_21577":125315,"_5":14884,"_28435":125293,"_3074":125316},[],"Si necesitas comenzar con un certificado existente, utiliza Registra un dispositivo manualmente. Después podrás preparar el enrolamiento y la renovación del siguiente dispositivo.",{"_3697":74345,"_31245":74335,"_21577":125318,"_5":14884,"_28435":125297,"_3074":125319},[],"Recurso",{"_3697":74346,"_31245":74335,"_21577":125321,"_5":14884,"_28435":125297,"_3074":125322},[],"Qué representa",{"_3697":74347,"_31245":74335,"_21577":125324,"_5":14884,"_28435":125297,"_3074":125325},[],"**Dispositivo**",{"_3697":74348,"_31245":74335,"_21577":125327,"_5":14884,"_28435":125297,"_3074":125328},[],"Una entrada de inventario con identificador, DMS propietario y clasificación.",{"_3697":74349,"_31245":74335,"_21577":125330,"_5":14884,"_28435":125297,"_3074":125331},[],"**Identidad**",{"_3697":74350,"_31245":74335,"_21577":125333,"_5":14884,"_28435":125297,"_3074":125334},[],"La asociación del dispositivo con sus certificados: una versión activa y un historial.",{"_3697":74351,"_31245":74335,"_21577":125336,"_5":14884,"_28435":125297,"_3074":56067},[],{"_3697":74352,"_31245":74335,"_21577":125338,"_5":14884,"_28435":125297,"_3074":125339},[],"El servicio que configura admisión, enrolamiento, renovación y distribución de confianza.",{"_3697":74353,"_31245":74335,"_21577":125341,"_5":14884,"_28435":125297,"_3074":125342},[],"**Flota**",{"_3697":74354,"_31245":74335,"_21577":125344,"_5":14884,"_28435":125297,"_3074":125345},[],"La población que operas, representada mediante dispositivos, DMS, etiquetas y metadatos.",{"_3697":74355,"_31245":74335,"_21577":125347,"_5":14884,"_28435":125297,"_3074":125348},[],"Cada dispositivo tiene un DMS propietario. Puedes organizar una población mediante varios DMS cuando necesita políticas distintas, y utilizar etiquetas para clasificarla. «Flota» describe ese contexto operativo; los recursos que creas y consultas son DMS y dispositivos.",{"_3697":74356,"_31245":74335,"_21577":125350,"_5":14884,"_28435":125297,"_3074":125351},[],"La gestión de dispositivos reúne estados, historial de certificados y acciones sobre la identidad. Al renovar, debes conservar la relación con el dispositivo y comprobar qué certificado pasa a ser la identidad actual.",{"_3697":74357,"_31245":74335,"_21577":125353,"_5":14884,"_28435":125300,"_3074":125354},[],"Este bloque conecta las reglas PKI con el cliente del dispositivo. La preparación sigue este orden:",{"_3697":74358,"_31245":74335,"_21577":125356,"_5":14884,"_28435":125300,"_3074":125357},[],"**CA y perfil:** prepara el emisor y las reglas del certificado en PKI.",{"_3697":74359,"_31245":74335,"_21577":125359,"_5":14884,"_28435":125300,"_3074":125360},[],"**Política DMS:** define cómo se admite el dispositivo, cómo se autentican sus solicitudes y qué confianza se distribuye.",{"_3697":74360,"_31245":74335,"_21577":125362,"_5":14884,"_28435":125300,"_3074":125363},[],"**Cliente:** prepara la credencial inicial, la confianza del servidor y la generación o custodia de la clave.",{"_3697":74361,"_31245":74335,"_21577":125365,"_5":14884,"_28435":125300,"_3074":125366},[],"**Resultado:** solicita el certificado, instálalo y comprueba su asociación con el dispositivo.",{"_3697":74362,"_31245":74335,"_21577":125368,"_5":14884,"_28435":125300,"_3074":125369},[],"**Continuidad:** configura renovación, instalación del sucesor y recuperación según la política del DMS.",{"_3697":74363,"_31245":74335,"_21577":125371,"_5":14884,"_28435":125300,"_3074":125372},[],"<Card title=\"Configura el DMS\" description=\"Prepara la CA, la admisión, la autenticación y las reglas de renovación.\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_3697":74364,"_31245":74335,"_21577":125374,"_5":14884,"_28435":125300,"_3074":125375},[],"<Card title=\"EST (RFC 7030)\" description=\"Consulta las guías de autenticación, cliente y renovación.\" href=\"/docs/platform/iot-fleets/est\" />",{"_3697":74365,"_31245":74335,"_21577":125377,"_5":14884,"_28435":125303,"_3074":125378},[],"Una identidad emitida necesita un consumidor que confíe en su emisor, valide el certificado y conceda permisos al dispositivo. Prepara tanto la confianza del dispositivo en el servidor como la del servidor en el dispositivo.",{"_3697":74366,"_31245":74335,"_21577":125380,"_5":14884,"_28435":125303,"_3074":125381},[],"La guía de AWS IoT Core explica cómo utilizar la identidad en ese destino. El aprovisionamiento en Lamassu y el aprovisionamiento en el destino son decisiones distintas; revisa las condiciones del modo elegido antes de esperar sincronización de estados.",{"_3697":74367,"_31245":74335,"_21577":125383,"_5":14884,"_28435":125306,"_3074":125384},[],"Participante",{"_3697":74368,"_31245":74335,"_21577":125386,"_5":14884,"_28435":125306,"_3074":125387},[],"Responsabilidad",{"_3697":74369,"_31245":74335,"_21577":125389,"_5":14884,"_28435":125306,"_3074":125390},[],"Administrador PKI",{"_3697":74370,"_31245":74335,"_21577":125392,"_5":14884,"_28435":125306,"_3074":125393},[],"CA, perfil de emisión, cadena y publicación de revocación.",{"_3697":74371,"_31245":74335,"_21577":125395,"_5":14884,"_28435":125306,"_3074":125396},[],"Administrador del aprovisionamiento",{"_3697":74372,"_31245":74335,"_21577":125398,"_5":14884,"_28435":125306,"_3074":125399},[],"DMS, admisión, autenticación por operación e inventario.",{"_3697":74373,"_31245":74335,"_21577":125401,"_5":14884,"_28435":125306,"_3074":125402},[],"Integrador del dispositivo",{"_3697":74374,"_31245":74335,"_21577":125404,"_5":14884,"_28435":125306,"_3074":125405},[],"Credencial inicial, clave, cliente EST, confianza e instalación de certificados.",{"_3697":74375,"_31245":74335,"_21577":125407,"_5":14884,"_28435":125306,"_3074":125408},[],"Integrador del consumidor",{"_3697":74376,"_31245":74335,"_21577":125410,"_5":14884,"_28435":125306,"_3074":125411},[],"Emisores confiables, validación y permisos del dispositivo en el destino.",{"_3697":74377,"_31245":74335,"_21577":125413,"_5":14884,"_28435":125306,"_3074":125414},[],"Los permisos y la auditoría son compartidos con el resto de Plataforma. La instalación y la conectividad de la instancia se preparan en Despliegue.",{"_3697":74378,"_31245":74378,"_5":15238,"_3074":125416,"_31570":125417,"_21577":125419,"_28435":74378},"Enrola y conecta tu primer dispositivo",[50948,121910,53661,125418],"Primeros pasos",[],{"_3697":74379,"_31245":74378,"_21577":125421,"_5":14884,"_28435":74378,"_3074":125422},[],"Obtén una identidad por EST, verifica su asociación y úsala en una conexión mTLS.",{"_3697":74380,"_31245":74378,"_5":31567,"_21577":125424,"_28435":125425,"_3074":120415},[],"/docs/es/platform/iot-fleets/quickstarts/enroll-device#antes-de-empezar",{"_3697":74381,"_31245":74378,"_5":31567,"_21577":125427,"_28435":125428,"_3074":125429},[],"/docs/es/platform/iot-fleets/quickstarts/enroll-device#prepara-la-credencial-inicial","Prepara la credencial inicial",{"_3697":74382,"_31245":74378,"_5":31567,"_21577":125431,"_28435":125432,"_3074":125433},[],"/docs/es/platform/iot-fleets/quickstarts/enroll-device#configura-el-dms-de-evaluación","Configura el DMS de evaluación",{"_3697":74383,"_31245":74378,"_5":31567,"_21577":125435,"_28435":125436,"_3074":125437},[],"/docs/es/platform/iot-fleets/quickstarts/enroll-device#prepara-el-cliente-y-comprueba-cacerts","Prepara el cliente y comprueba cacerts",{"_3697":74384,"_31245":74378,"_5":31567,"_21577":125439,"_28435":125440,"_3074":125441},[],"/docs/es/platform/iot-fleets/quickstarts/enroll-device#enrola-el-dispositivo","Enrola el dispositivo",{"_3697":74385,"_31245":74378,"_5":31567,"_21577":125443,"_28435":125444,"_3074":125445},[],"/docs/es/platform/iot-fleets/quickstarts/enroll-device#verifica-la-identidad-obtenida","Verifica la identidad obtenida",{"_3697":74386,"_31245":74378,"_5":31567,"_21577":125447,"_28435":125448,"_3074":125449},[],"/docs/es/platform/iot-fleets/quickstarts/enroll-device#demuestra-una-conexión-mtls","Demuestra una conexión mTLS",{"_3697":74387,"_31245":74378,"_5":31567,"_21577":125451,"_28435":125452,"_3074":125453},[],"/docs/es/platform/iot-fleets/quickstarts/enroll-device#resultado-y-continuidad","Resultado y continuidad",{"_3697":74388,"_31245":74378,"_21577":125455,"_5":14884,"_28435":74378,"_3074":125456},[],"Prepararás un DMS de evaluación, enrolarás `est-device-001` desde el cliente y usarás su identidad frente a un consumidor local que exige certificado. El recorrido conecta la política del administrador con el material que realmente instala el dispositivo.",{"_3697":74389,"_31245":74378,"_21577":125458,"_5":14884,"_28435":125425,"_3074":125459},[],"Instancia Lamassu accesible por HTTPS y permisos para CAs, perfiles, DMS y lectura de dispositivos/certificados.",{"_3697":74390,"_31245":74378,"_21577":125461,"_5":14884,"_28435":125425,"_3074":125462},[],"Bash, OpenSSL 3.x, curl con `--fail-with-body` y dos terminales en tu equipo. Trabaja en un directorio nuevo con acceso restringido.",{"_3697":74391,"_31245":74378,"_21577":125464,"_5":14884,"_28435":125425,"_3074":125465},[],"Una CA raíz activa que emita directamente, con clave disponible y vigencia suficiente. Sigue Crea tu primera CA. Guarda su certificado público verificado como `device-root.pem`.",{"_3697":74392,"_31245":74378,"_21577":125467,"_5":14884,"_28435":125425,"_3074":125468},[],"El identificador global `est-device-001` libre. Este recorrido utiliza registro automático: no crees primero el dispositivo desde la consola.",{"_3697":74393,"_31245":74378,"_21577":125470,"_5":14884,"_28435":125425,"_3074":125471},[],"La raíz aprobada para el HTTPS de Lamassu en `est-trust.pem`, obtenida por un canal independiente. Puede ser distinta de la CA de dispositivos; prepara red/TLS en Despliegue.",{"_3697":74394,"_31245":74378,"_21577":125473,"_5":14884,"_28435":125428,"_3074":125474},[],"Emite un certificado final bootstrap con `CN=est-device-001`, clave propia y uso Client Authentication. Puedes seguir Emite y verifica un certificado, sustituyendo su CN y guardando el resultado como `bootstrap.crt` y `bootstrap.key`. Elige una validez que cubra esta prueba y comprueba la pareja y la cadena.",{"_3697":74395,"_31245":74378,"_21577":125476,"_5":14884,"_28435":125428,"_3074":125477},[],"Para esta evaluación aislada puede emitirlo la misma CA raíz. La identidad operativa tendrá una clave y un certificado distintos. El CN igual facilita la lectura del ejemplo; la autenticación inicial por certificado no vincula por sí sola el CN del bootstrap con el ID pedido. Revisa la admisión antes de aplicar la política a una población.",{"_3697":74396,"_31245":74378,"_21577":125479,"_5":14884,"_28435":125432,"_3074":125480},[],"Crea un perfil final explícito, compatible con EC P-256, con **Honor Subject**, CN de la CSR, **Digital Signature**, **Client Authentication** y una validez de **1 hora** dentro de la vigencia de la raíz. No habilites firma como CA. Las reglas y precedencia se explican en Perfiles.",{"_3697":74397,"_31245":74378,"_21577":125482,"_5":14884,"_28435":125432,"_3074":125483},[],"Crea el DMS `Acme EST Evaluation` con esta configuración:",{"_3697":74398,"_31245":74378,"_21577":125485,"_5":14884,"_28435":125432,"_3074":125486},[],"Ajuste",{"_3697":74399,"_31245":74378,"_21577":125488,"_5":14884,"_28435":125432,"_3074":125489},[],"Valor de evaluación",{"_3697":74400,"_31245":74378,"_21577":125491,"_5":14884,"_28435":125432,"_3074":56223},[],{"_3697":74401,"_31245":74378,"_21577":125493,"_5":14884,"_28435":125432,"_3074":125494},[],"Raíz emisora de `device-root.pem`.",{"_3697":74402,"_31245":74378,"_21577":125496,"_5":14884,"_28435":125432,"_3074":125497},[],"Perfil de emisión",{"_3697":74403,"_31245":74378,"_21577":125499,"_5":14884,"_28435":125432,"_3074":125500},[],"Perfil final de 1 hora que acabas de preparar.",{"_3697":74404,"_31245":74378,"_21577":125502,"_5":14884,"_28435":125432,"_3074":56235},[],{"_3697":74405,"_31245":74378,"_21577":125504,"_5":14884,"_28435":125432,"_3074":56238},[],{"_3697":74406,"_31245":74378,"_21577":125506,"_5":14884,"_28435":125432,"_3074":56241},[],{"_3697":74407,"_31245":74378,"_21577":125508,"_5":14884,"_28435":125432,"_3074":125509},[],"Habilitado.",{"_3697":74408,"_31245":74378,"_21577":125511,"_5":14884,"_28435":125432,"_3074":56247},[],{"_3697":74409,"_31245":74378,"_21577":125513,"_5":14884,"_28435":125432,"_3074":125514},[],"Deshabilitado; el ID debe ser nuevo.",{"_3697":74410,"_31245":74378,"_21577":125516,"_5":14884,"_28435":125432,"_3074":125517},[],"Autenticación inicial",{"_3697":74411,"_31245":74378,"_21577":125519,"_5":14884,"_28435":125432,"_3074":125520},[],"`CLIENT_CERTIFICATE`; Validation CAs incluye el emisor directo del bootstrap; no aceptar vencidos.",{"_3697":74412,"_31245":74378,"_21577":125522,"_5":14884,"_28435":125432,"_3074":125523},[],"Autenticación de renovación",{"_3697":74413,"_31245":74378,"_21577":125525,"_5":14884,"_28435":125432,"_3074":125526},[],"`CLIENT_CERTIFICATE`, configurada en el bloque independiente de re-enrollment.",{"_3697":74414,"_31245":74378,"_21577":125528,"_5":14884,"_28435":125432,"_3074":56265},[],{"_3697":74415,"_31245":74378,"_21577":125530,"_5":14884,"_28435":125432,"_3074":125531},[],"No se necesitan para esta emisión directa; la CA de enrolamiento siempre es confiable en el reenrolamiento / deshabilitado.",{"_3697":74416,"_31245":74378,"_21577":125533,"_5":14884,"_28435":125432,"_3074":56271},[],{"_3697":74417,"_31245":74378,"_21577":125535,"_5":14884,"_28435":125432,"_3074":125536},[],"1 hora.",{"_3697":74418,"_31245":74378,"_21577":125538,"_5":14884,"_28435":125432,"_3074":56277},[],{"_3697":74419,"_31245":74378,"_21577":125540,"_5":14884,"_28435":125432,"_3074":125541},[],"30 minutos / 10 minutos.",{"_3697":74420,"_31245":74378,"_21577":125543,"_5":14884,"_28435":125432,"_3074":56283},[],{"_3697":74421,"_31245":74378,"_21577":125545,"_5":14884,"_28435":125432,"_3074":125546},[],"Deshabilitado para probar el sucesor antes de retirar el anterior.",{"_3697":74422,"_31245":74378,"_21577":125548,"_5":14884,"_28435":125432,"_3074":54110},[],{"_3697":74423,"_31245":74378,"_21577":125550,"_5":14884,"_28435":125432,"_3074":125551},[],"Deshabilitado; la clave operativa se genera en el cliente.",{"_3697":74424,"_31245":74378,"_21577":125553,"_5":14884,"_28435":125432,"_3074":56294},[],{"_3697":74425,"_31245":74378,"_21577":125555,"_5":14884,"_28435":125432,"_3074":125556},[],"Include Enrollment CA habilitado; Include Lamassu System CA deshabilitado.",{"_3697":74426,"_31245":74378,"_21577":125558,"_5":14884,"_28435":125432,"_3074":125559},[],"La duración y ventana iguales permiten probar renovación inmediatamente. Son valores de evaluación; dimensiona producción según conectividad y tiempos de recuperación. Guarda, vuelve a leer los dos bloques de autenticación y conserva el ID del DMS. La consola expone editores independientes para la autenticación de enrolamiento y de reenrolamiento; la guía DMS describe sus campos, y también puedes comprobar el recurso mediante la API DMS.",{"_3697":74427,"_31245":74378,"_21577":125561,"_5":14884,"_28435":125436,"_3074":125562},[],"En el directorio nuevo, coloca los cuatro archivos de confianza y bootstrap. Sustituye el URL por el de tu instalación:",{"_3697":74428,"_31245":74378,"_21577":125564,"_5":14884,"_28435":125436,"_3074":125565},[],"La descarga debe ser satisfactoria y contener la raíz de enrolamiento prevista. Compara su huella con `device-root.pem`. Esta comprobación no convierte la respuesta en confianza inicial ni demuestra que puedas emitir.",{"_3697":74429,"_31245":74378,"_21577":125567,"_5":14884,"_28435":125440,"_3074":125568},[],"Genera una clave nueva y una CSR con el identificador elegido:",{"_3697":74430,"_31245":74378,"_21577":125570,"_5":14884,"_28435":125440,"_3074":125571},[],"Solicita la identidad con la credencial inicial y extrae el certificado de la respuesta predeterminada:",{"_3697":74431,"_31245":74378,"_21577":125573,"_5":14884,"_28435":125440,"_3074":125574},[],"Si curl falla, consulta Diagnóstico con el cuerpo guardado. No ejecutes la conversión ni repitas la solicitud sin consultar el inventario: un timeout o error puede seguir a una emisión persistida.",{"_3697":74432,"_31245":74378,"_21577":125576,"_5":14884,"_28435":125444,"_3074":125577},[],"Espera `device.crt: OK` y código 0 de `cmp`. Comprueba CN, serie, fechas, Digital Signature y Client Authentication. El certificado debe ser final: no declarar `CA:TRUE` ni uso Certificate Sign. Revisa que su validez corresponda al perfil de una hora.",{"_3697":74433,"_31245":74378,"_21577":125579,"_5":14884,"_28435":125444,"_3074":125580},[],"En Lamassu, abre `est-device-001`. Debe estar creado con el DMS propietario previsto, una identidad actual y el certificado recibido en su historial. Compara la serie local con la del slot; los umbrales pueden mostrar un estado de renovación en vez de un simple Active.",{"_3697":74434,"_31245":74378,"_21577":125582,"_5":14884,"_28435":125448,"_3074":125583},[],"En una segunda terminal, entra en el mismo directorio y ejecuta `umask 077`. Crea un certificado local de servidor y arranca un consumidor de prueba. Este servidor confía en `device-root.pem` y exige una identidad cliente válida:",{"_3697":74435,"_31245":74378,"_21577":125585,"_5":14884,"_28435":125448,"_3074":125586},[],"Déjalo funcionando. En la primera terminal, realiza la conexión con la identidad obtenida:",{"_3697":74436,"_31245":74378,"_21577":125588,"_5":14884,"_28435":125448,"_3074":125589},[],"Espera HTTP `200`. La confianza del cliente en este servidor local es su certificado autofirmado `consumer.crt`; el servidor verifica al dispositivo contra `device-root.pem`. El archivo HTML muestra información de diagnóstico de OpenSSL.",{"_3697":74437,"_31245":74378,"_21577":125591,"_5":14884,"_28435":125448,"_3074":125592},[],"Con el mismo servidor todavía funcionando, prueba que una solicitud sin certificado cliente se rechaza:",{"_3697":74438,"_31245":74378,"_21577":125594,"_5":14884,"_28435":125448,"_3074":125595},[],"El rechazo debe corresponder a la falta de certificado en el servidor, no a un servidor detenido. Termina el consumidor con Ctrl+C después de la prueba. Este ejercicio demuestra autenticación TLS y posesión de la clave; tu aplicación debe definir además autorización y consumo de revocación. Las opciones del servidor se describen en openssl-s\\_server.",{"_3697":74439,"_31245":74378,"_21577":125597,"_5":14884,"_28435":125452,"_3074":125598},[],"Comprobación",{"_3697":74440,"_31245":74378,"_21577":125600,"_5":14884,"_28435":125452,"_3074":125601},[],"Resultado esperado",{"_3697":74441,"_31245":74378,"_21577":125603,"_5":14884,"_28435":125452,"_3074":125604},[],"Registro",{"_3697":74442,"_31245":74378,"_21577":125606,"_5":14884,"_28435":125452,"_3074":125607},[],"ID creado automáticamente y DMS correcto.",{"_3697":74443,"_31245":74378,"_21577":125609,"_5":14884,"_28435":125452,"_3074":124893},[],{"_3697":74444,"_31245":74378,"_21577":125611,"_5":14884,"_28435":125452,"_3074":125612},[],"CN, perfil, serie y clave verificados.",{"_3697":74445,"_31245":74378,"_21577":125614,"_5":14884,"_28435":125452,"_3074":125615},[],"Inventario",{"_3697":74446,"_31245":74378,"_21577":125617,"_5":14884,"_28435":125452,"_3074":125618},[],"Serie recibida visible como identidad actual y en el historial.",{"_3697":74447,"_31245":74378,"_21577":125620,"_5":14884,"_28435":125452,"_3074":125621},[],"Consumidor",{"_3697":74448,"_31245":74378,"_21577":125623,"_5":14884,"_28435":125452,"_3074":125624},[],"mTLS responde 200 con la identidad y rechaza falta de certificado.",{"_3697":74449,"_31245":74378,"_21577":125626,"_5":14884,"_28435":125452,"_3074":125627},[],"Continúa con Renovación y recuperación para solicitar una pareja sucesora dentro de la ventana, instalarla y repetir la comprobación mTLS. El consumidor debe utilizar los archivos nuevos en esa prueba. Después de comprobar el sucesor, retira el certificado anterior según la política PKI; el ejemplo no lo revoca automáticamente.",{"_3697":74450,"_31245":74378,"_21577":125629,"_5":14884,"_28435":125452,"_3074":125630},[],"Dispositivos e identidades explica la retirada y los límites de revocación del historial. Para un destino real, prepara confianza, validación y permisos del consumidor; AWS IoT Core es una integración disponible.",{"_3697":74451,"_31245":74451,"_5":15238,"_3074":123076,"_31570":125632,"_21577":125633,"_28435":74451},[50948,121910,53661,125418],[],{"_3697":74452,"_31245":74451,"_21577":125635,"_5":14884,"_28435":74451,"_3074":125636},[],"Prepara un DMS, registra un dispositivo y asocia un certificado comprobado a su identidad.",{"_3697":74453,"_31245":74451,"_5":31567,"_21577":125638,"_28435":125639,"_3074":120415},[],"/docs/es/platform/iot-fleets/quickstarts/register-device#antes-de-empezar",{"_3697":74454,"_31245":74451,"_5":31567,"_21577":125641,"_28435":125642,"_3074":125643},[],"/docs/es/platform/iot-fleets/quickstarts/register-device#prepara-el-dms","Prepara el DMS",{"_3697":74455,"_31245":74451,"_5":31567,"_21577":125645,"_28435":125646,"_3074":125647},[],"/docs/es/platform/iot-fleets/quickstarts/register-device#registra-el-dispositivo","Registra el dispositivo",{"_3697":74456,"_31245":74451,"_5":31567,"_21577":125649,"_28435":125650,"_3074":125651},[],"/docs/es/platform/iot-fleets/quickstarts/register-device#comprueba-el-estado-inicial","Comprueba el estado inicial",{"_3697":74457,"_31245":74451,"_5":31567,"_21577":125653,"_28435":125654,"_3074":125655},[],"/docs/es/platform/iot-fleets/quickstarts/register-device#asigna-una-identidad","Asigna una identidad",{"_3697":74458,"_31245":74451,"_5":31567,"_21577":125657,"_28435":125658,"_3074":125659},[],"/docs/es/platform/iot-fleets/quickstarts/register-device#verifica-el-dispositivo","Verifica el dispositivo",{"_3697":74459,"_31245":74451,"_5":31567,"_21577":125661,"_28435":125662,"_3074":125601},[],"/docs/es/platform/iot-fleets/quickstarts/register-device#resultado-esperado",{"_3697":74460,"_31245":74451,"_5":31567,"_21577":125664,"_28435":125665,"_3074":125666},[],"/docs/es/platform/iot-fleets/quickstarts/register-device#si-el-resultado-falla","Si el resultado falla",{"_3697":74461,"_31245":74451,"_5":31567,"_21577":125668,"_28435":125669,"_3074":125670},[],"/docs/es/platform/iot-fleets/quickstarts/register-device#automatiza-el-siguiente-dispositivo","Automatiza el siguiente dispositivo",{"_3697":74462,"_31245":74451,"_21577":125672,"_5":14884,"_28435":74451,"_3074":125673},[],"Este recorrido está dirigido a quien empieza a administrar identidades de dispositivos. Registrarás `device-001` y le asignarás un certificado existente para comprobar la relación entre dispositivo, DMS e historial de identidad.",{"_3697":74463,"_31245":74451,"_21577":125675,"_5":14884,"_28435":74451,"_3074":125676},[],"La asignación modifica el inventario de Lamassu. La clave y el certificado se instalan por separado en el dispositivo; la conexión con un consumidor se comprueba en la integración de ese destino.",{"_3697":74464,"_31245":74451,"_21577":125678,"_5":14884,"_28435":125639,"_3074":125679},[],"Una instancia accesible y permisos para administrar DMS, dispositivos y la asociación de certificados.",{"_3697":74465,"_31245":74451,"_21577":125681,"_5":14884,"_28435":125639,"_3074":125682},[],"Una CA activa con clave disponible. Si todavía no existe, sigue Crea tu primera CA.",{"_3697":74466,"_31245":74451,"_21577":125684,"_5":14884,"_28435":125639,"_3074":125685},[],"Un certificado final activo de esa CA cuyo `Common Name` sea exactamente `device-001`, con su clave privada. Sigue Emite y verifica un certificado para obtener y comprobar ambos.",{"_3697":74467,"_31245":74451,"_21577":125687,"_5":14884,"_28435":125639,"_3074":125688},[],"El identificador `device-001` libre en el inventario. Si ya lo usaste, elige otro y emite el certificado con ese mismo `Common Name`.",{"_3697":74468,"_31245":74451,"_21577":125690,"_5":14884,"_28435":125642,"_3074":125691},[],"Un DMS debe existir antes de registrar el dispositivo. Si ya tienes uno adecuado, comprueba su CA y anota su identificador; si necesitas crearlo:",{"_3697":74469,"_31245":74451,"_21577":125693,"_5":14884,"_28435":125642,"_3074":125694},[],"Abre el inventario de DMS y la acción de creación. Asigna un nombre reconocible, como `Acme Evaluation DMS`.",{"_3697":74470,"_31245":74451,"_21577":125696,"_5":14884,"_28435":125642,"_3074":125697},[],"En **Enrollment CA**, selecciona la CA que emitió `device.crt`.",{"_3697":74471,"_31245":74451,"_21577":125699,"_5":14884,"_28435":125642,"_3074":125700},[],"En **Registration Mode**, selecciona `PRE_REGISTRATION` para el recorrido que comienza con un alta explícita.",{"_3697":74472,"_31245":74451,"_21577":125702,"_5":14884,"_28435":125642,"_3074":125703},[],"En la sección de autenticación, activa **Require client certificate** y deja **Call external webhook** desactivado. Bajo **Require client certificate**, añade a **Validation CAs** la CA cuyos certificados iniciales aceptarás; para esta evaluación puede ser la misma CA. Mantén habilitada **Verify CSR Signature** y deja **Enable server-side key generation** desactivado si no lo vas a utilizar.",{"_3697":74473,"_31245":74451,"_21577":125705,"_5":14884,"_28435":125642,"_3074":125706},[],"Revisa los ajustes de renovación y distribución de confianza con la guía DMS, guarda el servicio y anota su identificador.",{"_3697":74474,"_31245":74451,"_21577":125708,"_5":14884,"_28435":125642,"_3074":125709},[],"Vuelve a abrir el DMS y confirma que la CA de enrolamiento es la prevista y que el servicio aparece en el inventario.",{"_3697":74475,"_31245":74451,"_21577":125711,"_5":14884,"_28435":125642,"_3074":125712},[],"Estos ajustes preparan la política DMS. Los pasos siguientes realizan el alta y la asignación desde la consola; no envían una solicitud EST ni prueban la admisión por ese protocolo.",{"_3697":74476,"_31245":74451,"_21577":125714,"_5":14884,"_28435":125646,"_3074":125715},[],"Abre **Managed Devices** y la acción de registro. Completa:",{"_3697":74477,"_31245":74451,"_21577":125717,"_5":14884,"_28435":125646,"_3074":56459},[],{"_3697":74478,"_31245":74451,"_21577":125719,"_5":14884,"_28435":125646,"_3074":125720},[],"**Registration Authority**: el DMS que acabas de preparar; la etiqueta identifica al servicio que cumple el rol de autoridad de registro.",{"_3697":74479,"_31245":74451,"_21577":125722,"_5":14884,"_28435":125646,"_3074":125723},[],"**Icon** y **Tags**: clasificación opcional.",{"_3697":74480,"_31245":74451,"_21577":125725,"_5":14884,"_28435":125646,"_3074":125726},[],"Confirma el registro.",{"_3697":74481,"_31245":74451,"_21577":125728,"_5":14884,"_28435":125650,"_3074":125729},[],"Abre el dispositivo. Debe aparecer en **No Identity** y mostrar el DMS propietario seleccionado.",{"_3697":74482,"_31245":74451,"_21577":125731,"_5":14884,"_28435":125650,"_3074":125732},[],"El registro crea la entrada de inventario; el certificado todavía debe asociarse.",{"_3697":74483,"_31245":74451,"_21577":125734,"_5":14884,"_28435":125654,"_3074":125735},[],"Selecciona **Assign Identity** y el certificado existente con `CN=device-001`. Comprueba su número de serie, emisor y vigencia frente al certificado que verificaste en PKI.",{"_3697":74484,"_31245":74451,"_21577":125737,"_5":14884,"_28435":125654,"_3074":125738},[],"Confirma la asociación. La alternativa **Issue New Instead** se explica en Dispositivos e identidades.",{"_3697":74485,"_31245":74451,"_21577":125740,"_5":14884,"_28435":125658,"_3074":125741},[],"Comprueba que tiene una identidad activa. En **Certificate History**, verifica el número de serie asociado; en **Device Event Timeline**, localiza el evento de asignación.",{"_3697":74486,"_31245":74451,"_21577":125743,"_5":14884,"_28435":125658,"_3074":125744},[],"Conserva el identificador del dispositivo, el DMS propietario y el número de serie como referencias del resultado.",{"_3697":74487,"_31245":74451,"_21577":125746,"_5":14884,"_28435":125662,"_3074":125598},[],{"_3697":74488,"_31245":74451,"_21577":125748,"_5":14884,"_28435":125662,"_3074":125749},[],"Resultado",{"_3697":74489,"_31245":74451,"_21577":125751,"_5":14884,"_28435":125662,"_3074":124879},[],{"_3697":74490,"_31245":74451,"_21577":125753,"_5":14884,"_28435":125662,"_3074":125754},[],"`device-001` aparece en el inventario con el DMS previsto.",{"_3697":74491,"_31245":74451,"_21577":125756,"_5":14884,"_28435":125662,"_3074":125757},[],"Identidad actual",{"_3697":74492,"_31245":74451,"_21577":125759,"_5":14884,"_28435":125662,"_3074":125760},[],"El certificado asociado coincide con el que verificaste en PKI.",{"_3697":74493,"_31245":74451,"_21577":125762,"_5":14884,"_28435":125662,"_3074":125763},[],"Historial",{"_3697":74494,"_31245":74451,"_21577":125765,"_5":14884,"_28435":125662,"_3074":125766},[],"La emisión asociada aparece con su número de serie y fechas.",{"_3697":74495,"_31245":74451,"_21577":125768,"_5":14884,"_28435":125662,"_3074":125769},[],"Clave y certificado",{"_3697":74496,"_31245":74451,"_21577":125771,"_5":14884,"_28435":125662,"_3074":125772},[],"Dispones de la pareja comprobada para instalarla en el dispositivo.",{"_3697":74497,"_31245":74451,"_21577":125774,"_5":14884,"_28435":125665,"_3074":125775},[],"Si el DMS no puede seleccionarse, confirma su creación y tus permisos de lectura.",{"_3697":74498,"_31245":74451,"_21577":125777,"_5":14884,"_28435":125665,"_3074":125778},[],"Si no aparece un certificado elegible, comprueba que su `Common Name` coincide exactamente con el `Device ID`, está activo y lo emitió la CA prevista.",{"_3697":74499,"_31245":74451,"_21577":125780,"_5":14884,"_28435":125665,"_3074":125781},[],"Si falla la asignación, revisa los permisos y el diagnóstico de la operación antes de repetirla. Vuelve a consultar el dispositivo y su historial para conocer el resultado persistido.",{"_3697":74500,"_31245":74451,"_21577":125783,"_5":14884,"_28435":125665,"_3074":125784},[],"Si aparece un estado relacionado con vencimiento o renovación, comprueba las fechas del certificado y los umbrales del DMS en Dispositivos e identidades.",{"_3697":74501,"_31245":74451,"_21577":125786,"_5":14884,"_28435":125669,"_3074":125787},[],"Continúa con DMS y EST para que el dispositivo solicite y renueve sus certificados. Prepara la confianza del servidor, la credencial inicial y las políticas de cada operación antes de implementar el cliente.",{"_3697":74502,"_31245":74451,"_21577":125789,"_5":14884,"_28435":125669,"_3074":125790},[],"Para un recorrido desde el cliente hasta mTLS, sigue Enrola y conecta tu primer dispositivo con un ID nuevo.",{"_3697":74503,"_31245":74451,"_21577":125792,"_5":14884,"_28435":125669,"_3074":125793},[],"Para utilizar la identidad en AWS IoT Core, prepara también la confianza y los permisos del destino. Comprueba la conexión desde el dispositivo después de instalar la clave, el certificado y la cadena necesarios.",{"_3697":74504,"_31245":74504,"_5":15238,"_3074":125795,"_31570":125796,"_21577":125797,"_28435":74504},"Plataforma Lamassu IoT",[50948,121910],[],{"_3697":74505,"_31245":74504,"_21577":125799,"_5":14884,"_28435":74504,"_3074":125800},[],"Construye una PKI y aplica sus certificados al ciclo de vida de tus dispositivos.",{"_3697":74506,"_31245":74504,"_5":31567,"_21577":125802,"_28435":125803,"_3074":125294},[],"/docs/es/platform/overview#empieza-aquí",{"_3697":74507,"_31245":74504,"_5":31567,"_21577":125805,"_28435":125806,"_3074":125807},[],"/docs/es/platform/overview#elige-tu-recorrido","Elige tu recorrido",{"_3697":74508,"_31245":74504,"_5":31567,"_21577":125809,"_28435":125810,"_3074":125811},[],"/docs/es/platform/overview#arquitectura-de-un-vistazo","Arquitectura de un vistazo",{"_3697":74509,"_31245":74504,"_5":31567,"_21577":125813,"_28435":125814,"_3074":125815},[],"/docs/es/platform/overview#capacidades-principales","Capacidades principales",{"_3697":74510,"_31245":74504,"_5":31567,"_21577":125817,"_28435":125818,"_3074":125819},[],"/docs/es/platform/overview#construye-tu-jerarquía-de-confianza","Construye tu jerarquía de confianza",{"_3697":74511,"_31245":74504,"_5":31567,"_21577":125821,"_28435":125822,"_3074":125823},[],"/docs/es/platform/overview#protege-las-claves-criptográficas","Protege las claves criptográficas",{"_3697":74512,"_31245":74504,"_5":31567,"_21577":125825,"_28435":125826,"_3074":125827},[],"/docs/es/platform/overview#emite-y-controla-certificados","Emite y controla certificados",{"_3697":74513,"_31245":74504,"_5":31567,"_21577":125829,"_28435":125830,"_3074":125831},[],"/docs/es/platform/overview#automatiza-identidades-de-dispositivos","Automatiza identidades de dispositivos",{"_3697":74514,"_31245":74504,"_5":31567,"_21577":125833,"_28435":125834,"_3074":125835},[],"/docs/es/platform/overview#publica-el-estado-de-validación","Publica el estado de validación",{"_3697":74515,"_31245":74504,"_5":31567,"_21577":125837,"_28435":125838,"_3074":125839},[],"/docs/es/platform/overview#reacciona-a-los-eventos","Reacciona a los eventos",{"_3697":74516,"_31245":74504,"_5":31567,"_21577":125841,"_28435":125842,"_3074":125843},[],"/docs/es/platform/overview#referencia-operativa","Referencia operativa",{"_3697":74517,"_31245":74504,"_21577":125845,"_5":14884,"_28435":74504,"_3074":125846},[],"Lamassu IoT permite administrar una PKI privada y utilizarla para emitir, renovar y revocar identidades X.509 de dispositivos. La documentación de Plataforma sigue dos recorridos: **PKI**, para gestionar las autoridades y los certificados, e **IoT Fleets**, para aplicar esas identidades a una población de dispositivos.",{"_3697":74518,"_31245":74504,"_21577":125848,"_5":14884,"_28435":125803,"_3074":125849},[],"Elige el resultado que necesitas obtener:",{"_3697":74519,"_31245":74504,"_21577":125851,"_5":14884,"_28435":125803,"_3074":125852},[],"<Card title=\"Emitir y verificar un certificado\" description=\"Prepara una CA, emite una identidad X.509 y comprueba su cadena y su clave.\" href=\"/docs/platform/pki/quickstarts/overview\" />",{"_3697":74520,"_31245":74504,"_21577":125854,"_5":14884,"_28435":125803,"_3074":125855},[],"<Card title=\"Enrolar y conectar un dispositivo\" description=\"Prepara el DMS, solicita la identidad por EST y comprueba una conexión mTLS.\" href=\"/docs/platform/iot-fleets/quickstarts/enroll-device\" />",{"_3697":74521,"_31245":74504,"_21577":125857,"_5":14884,"_28435":125803,"_3074":125858},[],"Si todavía estás preparando la instancia, empieza en Despliegue. Los recorridos de Plataforma parten de una consola accesible y de permisos para realizar las operaciones.",{"_3697":74522,"_31245":74504,"_21577":125860,"_5":14884,"_28435":125806,"_3074":125861},[],"Bloque",{"_3697":74523,"_31245":74504,"_21577":125863,"_5":14884,"_28435":125806,"_3074":125864},[],"Qué gestionas",{"_3697":74524,"_31245":74504,"_21577":125866,"_5":14884,"_28435":125806,"_3074":125867},[],"Punto de entrada",{"_3697":74525,"_31245":74504,"_21577":125869,"_5":14884,"_28435":125806,"_3074":56612},[],{"_3697":74526,"_31245":74504,"_21577":125871,"_5":14884,"_28435":125806,"_3074":125872},[],"Claves, autoridades, perfiles, certificados y publicación del estado de revocación.",{"_3697":74527,"_31245":74504,"_21577":125874,"_5":14884,"_28435":125806,"_3074":125875},[],"Visión general de PKI",{"_3697":74528,"_31245":74504,"_21577":125877,"_5":14884,"_28435":125806,"_3074":56621},[],{"_3697":74529,"_31245":74504,"_21577":125879,"_5":14884,"_28435":125806,"_3074":125880},[],"Dispositivos, historial de identidad, políticas DMS, enrolamiento EST e integraciones.",{"_3697":74530,"_31245":74504,"_21577":125882,"_5":14884,"_28435":125806,"_3074":125883},[],"Visión general de IoT Fleets",{"_3697":74531,"_31245":74504,"_21577":125885,"_5":14884,"_28435":125806,"_3074":125886},[],"**Administración**",{"_3697":74532,"_31245":74504,"_21577":125888,"_5":14884,"_28435":125806,"_3074":125889},[],"Permisos de operadores, auditoría y suscripciones a eventos.",{"_3697":74533,"_31245":74504,"_21577":125891,"_5":14884,"_28435":125806,"_3074":121912},[],{"_3697":74534,"_31245":74504,"_21577":125893,"_5":14884,"_28435":125806,"_3074":125894},[],"Una CA determina quién firma y un perfil establece qué puede emitirse. El DMS aplica la política de admisión y enrolamiento. El dispositivo conserva la asociación con sus certificados, y el consumidor externo decide qué identidad acepta.",{"_3697":74535,"_31245":74504,"_21577":125896,"_5":14884,"_28435":125810,"_3074":125897},[],"El recorrido de una identidad conecta cuatro responsabilidades:",{"_3697":74536,"_31245":74504,"_21577":125899,"_5":14884,"_28435":125810,"_3074":125900},[],"El administrador PKI prepara la autoridad, su clave y las reglas de emisión.",{"_3697":74537,"_31245":74504,"_21577":125902,"_5":14884,"_28435":125810,"_3074":125903},[],"El administrador del aprovisionamiento configura el DMS y la confianza inicial.",{"_3697":74538,"_31245":74504,"_21577":125905,"_5":14884,"_28435":125810,"_3074":125906},[],"El cliente del dispositivo solicita un certificado y lo instala junto con la clave que le corresponde.",{"_3697":74539,"_31245":74504,"_21577":125908,"_5":14884,"_28435":125810,"_3074":125909},[],"El consumidor valida la identidad y aplica sus permisos de acceso.",{"_3697":74540,"_31245":74504,"_21577":125911,"_5":14884,"_28435":125810,"_3074":125912},[],"Consulta Cómo funciona Lamassu para entender los recursos y la arquitectura de la plataforma para conocer los servicios. La instalación, la exposición de red y las dependencias se explican en Despliegue.",{"_3697":74541,"_31245":74504,"_21577":125914,"_5":14884,"_28435":125818,"_3074":125915},[],"Crea o incorpora autoridades y organiza sus relaciones en PKI. La jerarquía y su rotación determinan qué cadenas deberán reconocer los consumidores.",{"_3697":74542,"_31245":74504,"_21577":125917,"_5":14884,"_28435":125822,"_3074":125918},[],"Elige el motor que custodiará las claves de las autoridades y controla quién puede utilizarlas. Consulta Claves y motores; la preparación del proveedor forma parte del despliegue.",{"_3697":74543,"_31245":74504,"_21577":125920,"_5":14884,"_28435":125826,"_3074":125921},[],"Define perfiles de emisión, firma solicitudes y consulta el inventario de certificados. El certificado emitido debe comprobarse desde el cliente que lo utilizará.",{"_3697":74544,"_31245":74504,"_21577":125923,"_5":14884,"_28435":125830,"_3074":125924},[],"Configura un DMS y utiliza EST para solicitar y renovar certificados. La preparación de la credencial inicial y la instalación del resultado pertenecen a la integración del dispositivo.",{"_3697":74545,"_31245":74504,"_21577":125926,"_5":14884,"_28435":125834,"_3074":125927},[],"Utiliza OCSP y CRL para publicar el estado de revocación. Cada consumidor debe configurar cómo consulta y aplica esa información.",{"_3697":74546,"_31245":74504,"_21577":125929,"_5":14884,"_28435":125838,"_3074":125930},[],"Consulta auditoría para investigar cambios y configura alertas y suscripciones para reaccionar a eventos del ciclo de vida.",{"_3697":74547,"_31245":74504,"_21577":125932,"_5":14884,"_28435":125842,"_3074":125387},[],{"_3697":74548,"_31245":74504,"_21577":125934,"_5":14884,"_28435":125842,"_3074":125935},[],"Qué prepara o comprueba",{"_3697":74549,"_31245":74504,"_21577":125937,"_5":14884,"_28435":125842,"_3074":125390},[],{"_3697":74550,"_31245":74504,"_21577":125939,"_5":14884,"_28435":125842,"_3074":125940},[],"Custodia de claves, jerarquía de CAs, perfiles y validación.",{"_3697":74551,"_31245":74504,"_21577":125942,"_5":14884,"_28435":125842,"_3074":125943},[],"Administrador de la flota",{"_3697":74552,"_31245":74504,"_21577":125945,"_5":14884,"_28435":125842,"_3074":125946},[],"DMS, admisión de dispositivos, política de renovación e inventario.",{"_3697":74553,"_31245":74504,"_21577":125948,"_5":14884,"_28435":125842,"_3074":125402},[],{"_3697":74554,"_31245":74504,"_21577":125950,"_5":14884,"_28435":125842,"_3074":125951},[],"Credencial inicial, confianza en el servidor, cliente EST y almacenamiento de clave y certificado.",{"_3697":74555,"_31245":74504,"_21577":125953,"_5":14884,"_28435":125842,"_3074":125408},[],{"_3697":74556,"_31245":74504,"_21577":125955,"_5":14884,"_28435":125842,"_3074":125956},[],"Confianza en los emisores, validación de certificados y permisos en el destino.",{"_3697":74557,"_31245":74504,"_21577":125958,"_5":14884,"_28435":125842,"_3074":125959},[],"Operador de infraestructura",{"_3697":74558,"_31245":74504,"_21577":125961,"_5":14884,"_28435":125842,"_3074":125962},[],"Instalación, red, disponibilidad, dependencias y diagnóstico de despliegue.",{"_3697":74559,"_31245":74504,"_21577":125964,"_5":14884,"_28435":125842,"_3074":125965},[],"La Referencia API recoge los contratos para automatizar las operaciones. Para resolver un fallo, empieza en el bloque afectado: PKI, EST o Despliegue.",{"_3697":74560,"_31245":74560,"_5":15238,"_3074":125967,"_31570":125968,"_21577":125970,"_28435":74560},"Jerarquía y rotación de CAs",[50948,121910,56713,125969],"Claves, autoridades y certificados",[],{"_3697":74561,"_31245":74560,"_21577":125972,"_5":14884,"_28435":74560,"_3074":125973},[],"Diseña autoridades raíz e intermedias y sustituye certificados o claves sin romper la confianza.",{"_3697":74562,"_31245":74560,"_5":31567,"_21577":125975,"_28435":125976,"_3074":125977},[],"/docs/es/platform/pki/ca-hierarchy-and-rotation#diseña-la-jerarquía","Diseña la jerarquía",{"_3697":74563,"_31245":74560,"_5":31567,"_21577":125979,"_28435":125980,"_3074":125981},[],"/docs/es/platform/pki/ca-hierarchy-and-rotation#reemisión-y-rotación-no-son-lo-mismo","Reemisión y rotación no son lo mismo",{"_3697":74564,"_31245":74560,"_5":31567,"_21577":125983,"_28435":125984,"_3074":125985},[],"/docs/es/platform/pki/ca-hierarchy-and-rotation#cuándo-elegir-cada-operación","Cuándo elegir cada operación",{"_3697":74565,"_31245":74560,"_5":31567,"_21577":125987,"_28435":125988,"_3074":125989},[],"/docs/es/platform/pki/ca-hierarchy-and-rotation#procedimiento-de-rotación-de-clave","Procedimiento de rotación de clave",{"_3697":74566,"_31245":74560,"_5":31567,"_21577":125991,"_28435":125992,"_3074":125993},[],"/docs/es/platform/pki/ca-hierarchy-and-rotation#inventaría-las-dependencias","Inventaría las dependencias",{"_3697":74567,"_31245":74560,"_5":31567,"_21577":125995,"_28435":125996,"_3074":125997},[],"/docs/es/platform/pki/ca-hierarchy-and-rotation#crea-la-ca-sucesora","Crea la CA sucesora",{"_3697":74568,"_31245":74560,"_5":31567,"_21577":125999,"_28435":126000,"_3074":126001},[],"/docs/es/platform/pki/ca-hierarchy-and-rotation#distribuye-la-nueva-confianza","Distribuye la nueva confianza",{"_3697":74569,"_31245":74560,"_5":31567,"_21577":126003,"_28435":126004,"_3074":126005},[],"/docs/es/platform/pki/ca-hierarchy-and-rotation#cambia-la-emisión","Cambia la emisión",{"_3697":74570,"_31245":74560,"_5":31567,"_21577":126007,"_28435":126008,"_3074":126009},[],"/docs/es/platform/pki/ca-hierarchy-and-rotation#renueva-por-lotes","Renueva por lotes",{"_3697":74571,"_31245":74560,"_5":31567,"_21577":126011,"_28435":126012,"_3074":126013},[],"/docs/es/platform/pki/ca-hierarchy-and-rotation#cierra-el-solapamiento","Cierra el solapamiento",{"_3697":74572,"_31245":74560,"_5":31567,"_21577":126015,"_28435":126016,"_3074":126017},[],"/docs/es/platform/pki/ca-hierarchy-and-rotation#revocación-en-cascada","Revocación en cascada",{"_3697":74573,"_31245":74560,"_5":31567,"_21577":126019,"_28435":126020,"_3074":126021},[],"/docs/es/platform/pki/ca-hierarchy-and-rotation#comprobaciones-después-del-cambio","Comprobaciones después del cambio",{"_3697":74574,"_31245":74560,"_21577":126023,"_5":14884,"_28435":74560,"_3074":126024},[],"La jerarquía determina el alcance de cualquier error o compromiso. Una raíz firma CAs intermedias; las intermedias emiten las identidades que usan dispositivos y servicios. Esta separación permite aislar entornos y rotar una rama sin reemplazar toda la confianza.",{"_3697":74575,"_31245":74560,"_21577":126026,"_5":14884,"_28435":74560,"_3074":126027},[],"Este procedimiento se dirige al operador PKI que sustituye una autoridad en uso. Necesitas acceso a las CAs, claves y perfiles, un inventario de dependencias y coordinación con quienes gestionan los almacenes de confianza y dispositivos. Antes de cambiar la emisión, prepara una cohorte de prueba y decide el criterio para cerrar el solapamiento.",{"_3697":74576,"_31245":74560,"_21577":126029,"_5":14884,"_28435":125976,"_3074":126030},[],"Para una instalación de producción, utiliza una raíz muy restringida y una o más intermedias operativas. Separa intermedias cuando cambie alguno de estos límites:",{"_3697":74577,"_31245":74560,"_21577":126032,"_5":14884,"_28435":125976,"_3074":126033},[],"entorno, como producción y preproducción;",{"_3697":74578,"_31245":74560,"_21577":126035,"_5":14884,"_28435":125976,"_3074":126036},[],"propietario o equipo operador;",{"_3697":74579,"_31245":74560,"_21577":126038,"_5":14884,"_28435":125976,"_3074":126039},[],"familia de dispositivos o proceso de fabricación;",{"_3697":74580,"_31245":74560,"_21577":126041,"_5":14884,"_28435":125976,"_3074":126042},[],"región o requisito regulatorio;",{"_3697":74581,"_31245":74560,"_21577":126044,"_5":14884,"_28435":125976,"_3074":126045},[],"motor criptográfico o política de clave;",{"_3697":74582,"_31245":74560,"_21577":126047,"_5":14884,"_28435":125976,"_3074":126048},[],"ventana de mantenimiento y ritmo de renovación.",{"_3697":74583,"_31245":74560,"_21577":126050,"_5":14884,"_28435":125976,"_3074":126051},[],"Evita jerarquías profundas sin una necesidad concreta. Cada nivel añade distribución de cadena, validación y otro certificado que debes renovar.",{"_3697":74584,"_31245":74560,"_21577":126053,"_5":14884,"_28435":125976,"_3074":126054},[],"Una CA hija y los certificados finales deben expirar antes que su emisor. Reserva un margen que permita distribuir otra cadena y renovar los certificados dependientes.",{"_3697":74585,"_31245":74560,"_21577":126056,"_5":14884,"_28435":125980,"_3074":126057},[],"**Reemitir una CA** crea un certificado nuevo sobre la clave existente. Lamassu genera una CSR con esa clave, autofirma si es una raíz o pide a la CA padre que firme si es subordinada. El nuevo certificado queda activo y la CA apunta a su número de serie; los certificados anterior y nuevo quedan enlazados mediante metadatos.",{"_3697":74586,"_31245":74560,"_21577":126059,"_5":14884,"_28435":125980,"_3074":126060},[],"Si los ajustes de CRL de la CA están firmados por el certificado de la CA sustituido, al reemitir el firmante se mueve al certificado nuevo, siempre que incluya `cRLSign`, y se republica la CRL. En caso contrario, y para unos ajustes firmados por otro certificado, el firmante se conserva, así que comprueba el uso de clave del certificado nuevo tras reemitir. Una CA sin ajustes de CRL — por ejemplo, una importada sin su clave o sin `cRLSign` — obtiene los ajustes inicializados con la reemisión cuando el nuevo certificado incluye `cRLSign`; en caso contrario se queda sin ellos. Consulta la guía de CRL.",{"_3697":74587,"_31245":74560,"_21577":126062,"_5":14884,"_28435":125980,"_3074":126063},[],"**Rotar una CA** crea una clave y una autoridad sucesoras. Es la opción adecuada ante compromiso, cambio criptográfico, migración de motor o política de claves no exportables.",{"_3697":74588,"_31245":74560,"_21577":126065,"_5":14884,"_28435":125980,"_3074":126066},[],"Lamassu no permite reemitir una CA ya revocada ni una CA cuya fecha de expiración haya pasado. Una CA subordinada la firma su CA padre, de modo que esta también debe estar `ACTIVE` y dentro de su periodo de validez; en caso contrario la reemisión falla con `400`. Anticípate a estas condiciones.",{"_3697":74589,"_31245":74560,"_21577":126068,"_5":14884,"_28435":125984,"_3074":126069},[],"Reemite si la clave sigue siendo confiable y solo necesitas otro periodo de validez o un certificado actualizado.",{"_3697":74590,"_31245":74560,"_21577":126071,"_5":14884,"_28435":125984,"_3074":126072},[],"Rota la clave si existe sospecha de compromiso, cambia el algoritmo o quieres mover la custodia a otro motor.",{"_3697":74591,"_31245":74560,"_21577":126074,"_5":14884,"_28435":125984,"_3074":126075},[],"Crea una rama paralela si no puedes actualizar todos los consumidores al mismo tiempo.",{"_3697":74592,"_31245":74560,"_21577":126077,"_5":14884,"_28435":125984,"_3074":126078},[],"Revoca inmediatamente solo cuando el riesgo de mantener la CA supera el impacto de interrumpir la flota.",{"_3697":74593,"_31245":74560,"_21577":126080,"_5":14884,"_28435":125992,"_3074":126081},[],"Localiza CAs hijas, certificados emitidos, DMS, conectores y almacenes de confianza externos. Incluye dispositivos que pueden permanecer desconectados durante semanas o meses.",{"_3697":74594,"_31245":74560,"_21577":126083,"_5":14884,"_28435":125996,"_3074":126084},[],"Genera una clave nueva en el motor previsto, crea la CA y asígnale un perfil explícito. No reutilices el identificador operativo para ocultar que es una generación distinta.",{"_3697":74595,"_31245":74560,"_21577":126086,"_5":14884,"_28435":126000,"_3074":126087},[],"Añade la nueva raíz o cadena a los consumidores antes de emitir con ella. Si distribuyes mediante EST `/cacerts`, incluye explícitamente las CAs gestionadas necesarias y comprueba el contenido; no presupongas que incluir la CA emisora añade todas sus intermedias. Instala la nueva confianza en una cohorte y verifica que también sigue aceptando la identidad anterior.",{"_3697":74596,"_31245":74560,"_21577":126089,"_5":14884,"_28435":126004,"_3074":126090},[],"Actualiza la CA de enrolamiento y el perfil de los DMS. Mientras sigan renovando cohortes con certificados antiguos, añade la CA de enrolamiento anterior a las CAs de validación de re-enrolamiento (`reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`) de cada DMS: la nueva CA de enrolamiento se considera confiable automáticamente, pero la antigua era la CA de enrolamiento y no figura en ninguna lista de confianza de re-enrolamiento, así que sin esa entrada sus certificados ya no podrán renovarse. La guía DMS documenta ese ajuste.",{"_3697":74597,"_31245":74560,"_21577":126092,"_5":14884,"_28435":126008,"_3074":126093},[],"Migra una cohorte pequeña, valida mTLS, OCSP y CRL desde el consumidor y amplía progresivamente. Supervisa qué dispositivos siguen presentando la cadena antigua.",{"_3697":74598,"_31245":74560,"_21577":126095,"_5":14884,"_28435":126012,"_3074":126096},[],"Cuando ningún consumidor legítimo dependa de la autoridad anterior, retírala de la emisión, de las CAs de validación de re-enrolamiento y de las CAs distribuidas. Revócala si la política lo exige.",{"_3697":74599,"_31245":74560,"_21577":126098,"_5":14884,"_28435":126016,"_3074":126099},[],"Lamassu guarda la revocación de la CA y después aplica la misma revocación a sus CAs hijas y certificados emitidos. La propagación continúa recursivamente por las hijas. No es una transacción sobre toda la jerarquía: puede haber recursos ya modificados y otros cuya actualización haya fallado.",{"_3697":74600,"_31245":74560,"_21577":126101,"_5":14884,"_28435":126016,"_3074":126102},[],"Los recursos en estado `EXPIRED` y los ya revocados por una razón definitiva no admiten otra transición de estado. Los errores por descendiente se registran; revisa el inventario y los registros aunque la operación sobre el padre haya terminado.",{"_3697":74601,"_31245":74560,"_21577":126104,"_5":14884,"_28435":126016,"_3074":126105},[],"`CertificateHold` es la excepción reversible. Suspender una CA suspende sus CAs hijas activas y sus certificados emitidos con `CertificateHold` y los marca como suspendidos por esa CA. Al reactivar la CA — a `ACTIVE` o a cualquier otro estado no revocado, como `EXPIRED` — se reactivan exactamente los descendientes que siguen suspendidos y conservan esa marca. Las suspensiones colocadas manualmente antes o después de la cascada no se tocan, y cualquier cambio de estado posterior de un descendiente elimina la marca. Revocar definitivamente una CA suspendida con cualquier otra razón sigue siendo permanente: los descendientes se revocan con `CessationOfOperation` y no pueden restaurarse.",{"_3697":74602,"_31245":74560,"_21577":126107,"_5":14884,"_28435":126016,"_3074":126108},[],"Antes de cerrar el cambio, contrasta el listado de dependencias inicial con los estados finales y verifica la publicación de revocación en cada emisor. No utilices la revocación como mecanismo ordinario para dejar de emitir: completa la migración y retira la CA de los flujos operativos.",{"_3697":74603,"_31245":74560,"_21577":126110,"_5":14884,"_28435":126020,"_3074":126111},[],"La cadena nueva termina en un ancla instalada por el consumidor.",{"_3697":74604,"_31245":74560,"_21577":126113,"_5":14884,"_28435":126020,"_3074":126114},[],"Los certificados nuevos contienen AKI, SKI, KU, EKU y SAN esperados.",{"_3697":74605,"_31245":74560,"_21577":126116,"_5":14884,"_28435":126020,"_3074":126117},[],"El DMS entrega la cadena correcta mediante EST `/cacerts`.",{"_3697":74606,"_31245":74560,"_21577":126119,"_5":14884,"_28435":126020,"_3074":126120},[],"El re-enrolamiento acepta la identidad antigua durante el periodo previsto.",{"_3697":74607,"_31245":74560,"_21577":126122,"_5":14884,"_28435":126020,"_3074":126123},[],"OCSP y CRL responden para las autoridades que siguen activas.",{"_3697":74608,"_31245":74560,"_21577":126125,"_5":14884,"_28435":126020,"_3074":126126},[],"No quedan DMS emitiendo accidentalmente desde la CA anterior.",{"_3697":74609,"_31245":74560,"_21577":126128,"_5":14884,"_28435":126020,"_3074":126129},[],"Consulta el Modelo de confianza para entender los conjuntos de CAs del DMS y Ciclo de vida de un certificado para los estados y efectos de revocación.",{"_3697":74610,"_31245":74610,"_5":15238,"_3074":126131,"_31570":126132,"_21577":126133,"_28435":74610},"Autoridades de certificación",[50948,121910,56713,125969],[],{"_3697":74611,"_31245":74610,"_21577":126135,"_5":14884,"_28435":74610,"_3074":126136},[],"Crea, importa y opera las autoridades que establecen la confianza de tu PKI.",{"_3697":74612,"_31245":74610,"_5":31567,"_21577":126138,"_28435":126139,"_3074":126140},[],"/docs/es/platform/pki/certificate-authorities#elige-un-flujo","Elige un flujo",{"_3697":74613,"_31245":74610,"_5":31567,"_21577":126142,"_28435":126143,"_3074":126144},[],"/docs/es/platform/pki/certificate-authorities#crea-una-autoridad-nueva","Crea una autoridad nueva",{"_3697":74614,"_31245":74610,"_5":31567,"_21577":126146,"_28435":126147,"_3074":120415},[],"/docs/es/platform/pki/certificate-authorities#antes-de-empezar",{"_3697":74615,"_31245":74610,"_5":31567,"_21577":126149,"_28435":126150,"_3074":126151},[],"/docs/es/platform/pki/certificate-authorities#abre-el-asistente","Abre el asistente",{"_3697":74616,"_31245":74610,"_5":31567,"_21577":126153,"_28435":126154,"_3074":126155},[],"/docs/es/platform/pki/certificate-authorities#configura-la-clave","Configura la clave",{"_3697":74617,"_31245":74610,"_5":31567,"_21577":126157,"_28435":126158,"_3074":126159},[],"/docs/es/platform/pki/certificate-authorities#elige-el-tipo-de-ca","Elige el tipo de CA",{"_3697":74618,"_31245":74610,"_5":31567,"_21577":126161,"_28435":126162,"_3074":126163},[],"/docs/es/platform/pki/certificate-authorities#define-la-identidad","Define la identidad",{"_3697":74619,"_31245":74610,"_5":31567,"_21577":126165,"_28435":126166,"_3074":126167},[],"/docs/es/platform/pki/certificate-authorities#configura-validez-y-usos","Configura validez y usos",{"_3697":74620,"_31245":74610,"_5":31567,"_21577":126169,"_28435":126170,"_3074":126171},[],"/docs/es/platform/pki/certificate-authorities#crea-y-verifica","Crea y verifica",{"_3697":74621,"_31245":74610,"_5":31567,"_21577":126173,"_28435":126174,"_3074":126175},[],"/docs/es/platform/pki/certificate-authorities#utiliza-una-clave-del-kms","Utiliza una clave del KMS",{"_3697":74622,"_31245":74610,"_5":31567,"_21577":126177,"_28435":126178,"_3074":126179},[],"/docs/es/platform/pki/certificate-authorities#importa-una-ca-externa","Importa una CA externa",{"_3697":74623,"_31245":74610,"_5":31567,"_21577":126181,"_28435":126182,"_3074":126183},[],"/docs/es/platform/pki/certificate-authorities#selecciona-el-motor","Selecciona el motor",{"_3697":74624,"_31245":74610,"_5":31567,"_21577":126185,"_28435":126186,"_3074":126187},[],"/docs/es/platform/pki/certificate-authorities#carga-el-material","Carga el material",{"_3697":74625,"_31245":74610,"_5":31567,"_21577":126189,"_28435":126190,"_3074":126191},[],"/docs/es/platform/pki/certificate-authorities#define-la-emisión-predeterminada","Define la emisión predeterminada",{"_3697":74626,"_31245":74610,"_5":31567,"_21577":126193,"_28435":126194,"_3074":126195},[],"/docs/es/platform/pki/certificate-authorities#verifica-la-importación","Verifica la importación",{"_3697":74627,"_31245":74610,"_5":31567,"_21577":126197,"_28435":126198,"_3074":126199},[],"/docs/es/platform/pki/certificate-authorities#estados-de-una-ca","Estados de una CA",{"_3697":74628,"_31245":74610,"_5":31567,"_21577":126201,"_28435":126202,"_3074":126203},[],"/docs/es/platform/pki/certificate-authorities#inspecciona-una-autoridad","Inspecciona una autoridad",{"_3697":74629,"_31245":74610,"_5":31567,"_21577":126205,"_28435":126206,"_3074":126207},[],"/docs/es/platform/pki/certificate-authorities#emite-certificados","Emite certificados",{"_3697":74630,"_31245":74610,"_5":31567,"_21577":126209,"_28435":126210,"_3074":126211},[],"/docs/es/platform/pki/certificate-authorities#revoca-una-ca","Revoca una CA",{"_3697":74631,"_31245":74610,"_5":31567,"_21577":126213,"_28435":126214,"_3074":126215},[],"/docs/es/platform/pki/certificate-authorities#evalúa-el-impacto","Evalúa el impacto",{"_3697":74632,"_31245":74610,"_5":31567,"_21577":126217,"_28435":126218,"_3074":126219},[],"/docs/es/platform/pki/certificate-authorities#inicia-la-revocación","Inicia la revocación",{"_3697":74633,"_31245":74610,"_5":31567,"_21577":126221,"_28435":126222,"_3074":126223},[],"/docs/es/platform/pki/certificate-authorities#confirma-la-identidad","Confirma la identidad",{"_3697":74634,"_31245":74610,"_5":31567,"_21577":126225,"_28435":126226,"_3074":126227},[],"/docs/es/platform/pki/certificate-authorities#comprueba-la-publicación","Comprueba la publicación",{"_3697":74635,"_31245":74610,"_5":31567,"_21577":126229,"_28435":126230,"_3074":126231},[],"/docs/es/platform/pki/certificate-authorities#elimina-una-ca","Elimina una CA",{"_3697":74636,"_31245":74610,"_21577":126233,"_5":14884,"_28435":74610,"_3074":126234},[],"Una autoridad de certificación (CA) vincula identidades con claves públicas mediante certificados firmados. En Lamassu puedes crear una jerarquía nueva, utilizar una clave que ya está en el KMS o incorporar una CA externa.",{"_3697":74637,"_31245":74610,"_21577":126236,"_5":14884,"_28435":74610,"_3074":126237},[],"Para diseñar una cadena completa o sustituir una autoridad en producción, consulta Jerarquía y rotación de CAs. Si necesitas estandarizar qué puede firmar cada autoridad, utiliza Perfiles de certificado.",{"_3697":74638,"_31245":74610,"_21577":126239,"_5":14884,"_28435":74610,"_3074":126240},[],"Para administrar CAs necesitas permisos sobre las autoridades y las claves, un motor accesible y un perfil revisado. La CA de un consumidor externo no queda confiada por aparecer en este inventario: acuerda por separado la distribución de su raíz y cadena.",{"_3697":74639,"_31245":74610,"_21577":126242,"_5":14884,"_28435":126139,"_3074":126243},[],"**Nueva CA y nueva clave:** crea una raíz de confianza desde cero. Lamassu genera y custodia el par de claves.",{"_3697":74640,"_31245":74610,"_21577":126245,"_5":14884,"_28435":126139,"_3074":126246},[],"**Nueva CA desde KMS:** reutiliza una clave que ya está registrada en la plataforma.",{"_3697":74641,"_31245":74610,"_21577":126248,"_5":14884,"_28435":126139,"_3074":126249},[],"**Importar CA con clave privada:** incorpora una autoridad externa con la que Lamassu podrá emitir.",{"_3697":74642,"_31245":74610,"_21577":126251,"_5":14884,"_28435":126139,"_3074":126252},[],"**Importar solo el certificado:** registra material público. Si Lamassu encuentra su clave en el KMS, puede asociarla; si no la encuentra, la CA queda sin clave utilizable para emitir.",{"_3697":74643,"_31245":74610,"_21577":126254,"_5":14884,"_28435":126139,"_3074":126255},[],"¿Es tu primera vez? Sigue Crea tu primera CA para completar el recorrido mínimo.",{"_3697":74644,"_31245":74610,"_21577":126257,"_5":14884,"_28435":126147,"_3074":126258},[],"Decide si la CA será raíz o intermedia.",{"_3697":74645,"_31245":74610,"_21577":126260,"_5":14884,"_28435":126147,"_3074":126261},[],"Elige el motor que custodiará la clave.",{"_3697":74646,"_31245":74610,"_21577":126263,"_5":14884,"_28435":126147,"_3074":126264},[],"Define una validez superior a la de los certificados que emitirá.",{"_3697":74647,"_31245":74610,"_21577":126266,"_5":14884,"_28435":126147,"_3074":126267},[],"Para una CA intermedia, asegúrate de que la CA padre esté activa.",{"_3697":74648,"_31245":74610,"_21577":126269,"_5":14884,"_28435":126150,"_3074":126270},[],"En **Certification Authorities**, selecciona **Create New CA** y elige generar un par de claves nuevo.",{"_3697":74649,"_31245":74610,"_21577":126272,"_5":14884,"_28435":126154,"_3074":126273},[],"Selecciona el motor criptográfico, el algoritmo y el tamaño o curva. Lamassu admite claves RSA y EC según las capacidades del motor.",{"_3697":74650,"_31245":74610,"_21577":126275,"_5":14884,"_28435":126154,"_3074":126276},[],"Utiliza únicamente tamaños y curvas admitidos por el motor y por la política criptográfica del perfil. Consulta Claves y motores antes de reutilizar material externo.",{"_3697":74651,"_31245":74610,"_21577":126278,"_5":14884,"_28435":126158,"_3074":126279},[],"Selecciona **Root CA** para una autoridad autofirmada o **Intermediate CA** para una autoridad firmada por otra CA. En el segundo caso, elige la CA emisora.",{"_3697":74652,"_31245":74610,"_21577":126281,"_5":14884,"_28435":126162,"_3074":126282},[],"Introduce un **CA Name** único. Este nombre se convierte en el `Common Name` del certificado. Completa los campos del Distinguished Name que necesite tu política:",{"_3697":74653,"_31245":74610,"_21577":126284,"_5":14884,"_28435":126162,"_3074":126285},[],"`C`: código de país ISO 3166-1 de dos letras.",{"_3697":74654,"_31245":74610,"_21577":126287,"_5":14884,"_28435":126162,"_3074":126288},[],"`ST`: estado o provincia.",{"_3697":74655,"_31245":74610,"_21577":126290,"_5":14884,"_28435":126162,"_3074":126291},[],"`L`: localidad.",{"_3697":74656,"_31245":74610,"_21577":126293,"_5":14884,"_28435":126162,"_3074":126294},[],"`O`: organización.",{"_3697":74657,"_31245":74610,"_21577":126296,"_5":14884,"_28435":126162,"_3074":126297},[],"`OU`: unidad organizativa.",{"_3697":74658,"_31245":74610,"_21577":126299,"_5":14884,"_28435":126162,"_3074":126300},[],"El identificador interno de la CA se genera automáticamente y no se puede modificar.",{"_3697":74659,"_31245":74610,"_21577":126302,"_5":14884,"_28435":126166,"_3074":126303},[],"Define **CA Certificate Expiration** y **Default End-Entity Certificate Issuance Expiration**. Puedes expresar una duración (`5y 8w 4d`), seleccionar una fecha o utilizar la fecha máxima permitida.",{"_3697":74660,"_31245":74610,"_21577":126305,"_5":14884,"_28435":126166,"_3074":126306},[],"Revisa por separado el certificado de la propia CA y el perfil predeterminado para lo que emitirá después. Elige una política explícita de emisión; no confíes en que los valores iniciales del formulario sean adecuados para tus consumidores.",{"_3697":74661,"_31245":74610,"_21577":126308,"_5":14884,"_28435":126170,"_3074":126309},[],"Confirma el formulario y abre la CA. Comprueba estado, emisor, fechas, motor y clave asociados. Descarga el certificado: debe tener `CA:TRUE` y un uso que permita firmar certificados. Verifica la autofirma para una raíz o la cadena hasta tu raíz para una intermedia. Completa una emisión de prueba para comprobar que la clave realmente puede firmar.",{"_3697":74662,"_31245":74610,"_21577":126311,"_5":14884,"_28435":126170,"_3074":126312},[],"Planifica y verifica los vencimientos con las reglas de Perfiles. La emisión no recorta automáticamente la validez al vencimiento del emisor; deja margen para sustituir la autoridad y renovar las identidades.",{"_3697":74663,"_31245":74610,"_21577":126314,"_5":14884,"_28435":126174,"_3074":126315},[],"Selecciona &#x2A;*Create New CA (Existing Key)** cuando la clave ya esté registrada en Lamassu. El asistente pide primero la clave de soporte y después muestra la misma configuración de tipo, identidad, validez y perfil.",{"_3697":74664,"_31245":74610,"_21577":126317,"_5":14884,"_28435":126174,"_3074":126318},[],"Este flujo resulta útil cuando la clave se creó previamente en un HSM, se importó mediante BYOK o debe reutilizarse con una política de custodia concreta.",{"_3697":74665,"_31245":74610,"_21577":126320,"_5":14884,"_28435":126178,"_3074":126321},[],"Necesitas el certificado de CA en PEM, su cadena hasta una raíz conocida y, si vas a importarla, una clave privada exportable. Antes de cargar el material, verifica firma, fechas, `CA:TRUE`, usos de firma (incluido `cRLSign`, sin el cual la CA no puede publicar su CRL) y correspondencia de la clave pública. El procedimiento de verificación de claves también sirve para comparar la clave y el certificado de una CA.",{"_3697":74666,"_31245":74610,"_21577":126323,"_5":14884,"_28435":126178,"_3074":126324},[],"El backend rechaza una importación cuyo certificado carece de la restricción básica de CA (`basicConstraints cA flag is not set`), cuyo número de serie coincide con el de un certificado almacenado con contenido distinto, o cuyo certificado idéntico ya pertenece a una CA existente. El registro de certificado de una CA eliminada se conserva y puede reutilizarse al reimportar el mismo certificado, incluido su estado anterior. Reimportar otro certificado con ese número de serie se rechaza; comprueba el certificado y su estado tras reimportarlo.",{"_3697":74667,"_31245":74610,"_21577":126326,"_5":14884,"_28435":126178,"_3074":126327},[],"Un certificado cuyo periodo de validez ya ha terminado, como el de una autoridad externa retirada, se acepta y, cuando Lamassu aún no tiene un registro de ese certificado, la CA se almacena como `EXPIRED` desde el principio, igual que al importar un certificado simple. Si la importación reutiliza el registro de una CA eliminada (véase arriba y Elimina una CA), se conserva el estado anterior aunque el certificado haya caducado entretanto. Una CA `EXPIRED` rechaza los cambios de estado; consulta el ciclo de vida del certificado.",{"_3697":74668,"_31245":74610,"_21577":126329,"_5":14884,"_28435":126178,"_3074":126330},[],"Eliminar una CA libera las referencias a la clave de su propio certificado actual y de sus certificados reemitidos vinculados, pero conserva esos registros para la CRL y el OCSP de su emisor. Después intenta eliminar la clave; el KMS la conserva si otros certificados todavía la referencian, como los de otra CA que comparte la clave. Revocar los certificados emitidos por la CA eliminada no libera sus propias referencias a claves.",{"_3697":74669,"_31245":74610,"_21577":126332,"_5":14884,"_28435":126182,"_3074":126333},[],"Comprueba el motor predeterminado de la instalación antes de importar una CA con clave. La operación de importación de CA delega la importación de la clave en ese motor; no garantiza selección de cualquier proveedor desde el formulario. Para seleccionar un motor al importar la clave por separado, utiliza el KMS.",{"_3697":74670,"_31245":74610,"_21577":126335,"_5":14884,"_28435":126186,"_3074":126336},[],"Importa el certificado y, cuando corresponda, su clave PEM. Registra las CAs de la cadena necesarias para identificar al emisor. Tener una CA en el inventario no la instala en los almacenes de confianza externos.",{"_3697":74671,"_31245":74610,"_21577":126338,"_5":14884,"_28435":126186,"_3074":126339},[],"El backend valida antes de importar ninguna clave: se rechazan un ID de CA duplicado y un certificado que no es de CA (falta `basicConstraints` `cA=TRUE`), este último con `400` `certificate is not a CA: basicConstraints cA flag is not set`. Si ocurre un fallo después de haber importado la clave, la clave se conserva en el KMS y un aviso te pide eliminarla manualmente.",{"_3697":74672,"_31245":74610,"_21577":126341,"_5":14884,"_28435":126190,"_3074":126342},[],"Asocia un perfil de emisión explícito si la CA va a firmar. Comprueba sus usos y fechas según Perfiles.",{"_3697":74673,"_31245":74610,"_21577":126344,"_5":14884,"_28435":126194,"_3074":126345},[],"Revisa el tipo registrado, la clave y el motor asociados y la relación con el emisor. Una importación sin clave puede asociarse a una clave ya existente en KMS mediante el identificador de clave del certificado. Si no existe una clave utilizable, la CA sirve como material público pero no puede firmar.",{"_3697":74674,"_31245":74610,"_21577":126347,"_5":14884,"_28435":126194,"_3074":126348},[],"Una CA importada cuya clave está en el KMS y cuyo certificado incluye `cRLSign` recibe automáticamente sus ajustes de CRL y su primera CRL; sin una clave en el KMS o sin `cRLSign` no los recibe, y esto no es un error de importación (consulta CRL).",{"_3697":74675,"_31245":74610,"_21577":126350,"_5":14884,"_28435":126194,"_3074":126351},[],"Para una CA emisora, completa una emisión de prueba y comprueba OCSP y CRL. El alta del registro por sí sola no demuestra disponibilidad de la clave, coherencia completa de la cadena ni publicación del estado.",{"_3697":74676,"_31245":74610,"_21577":126353,"_5":14884,"_28435":126198,"_3074":126354},[],"Una CA solo firma en `ACTIVE`. Desde ahí puede pasar a `EXPIRED` o a `REVOKED`, y de esos estados solo sale por la eliminación, salvo en un caso: la revocación con `CertificateHold` se puede deshacer.",{"_3697":74677,"_31245":74610,"_21577":126356,"_5":14884,"_28435":126198,"_3074":126357},[],"**Caducidad.** El monitor de expiración marca como `EXPIRED` las CAs `ACTIVE` cuyo periodo de validez ha terminado. Hasta que se ejecuta, la CA ya no firma, porque Lamassu comprueba las fechas (Emite certificados).",{"_3697":74678,"_31245":74610,"_21577":126359,"_5":14884,"_28435":126198,"_3074":126360},[],"**Revocación.** Revocar con la razón `CertificateHold` es reversible. Una revocación con cualquier otra razón, igual que `EXPIRED`, rechaza todo cambio de estado posterior. Revocar, también con `CertificateHold`, actúa además sobre las CAs subordinadas y los certificados que emitió: Revoca una CA.",{"_3697":74679,"_31245":74610,"_21577":126362,"_5":14884,"_28435":126198,"_3074":126363},[],"**Eliminación.** Solo una CA revocada con otra razón o caducada puede eliminarse; una importada sin clave, desde cualquier estado. Condiciones y efectos en Elimina una CA.",{"_3697":74680,"_31245":74610,"_21577":126365,"_5":14884,"_28435":126202,"_3074":126366},[],"Abre una CA desde el inventario para consultar:",{"_3697":74681,"_31245":74610,"_21577":126368,"_5":14884,"_28435":126202,"_3074":126369},[],"Estado y periodo de validez.",{"_3697":74682,"_31245":74610,"_21577":126371,"_5":14884,"_28435":126202,"_3074":126372},[],"Certificado y cadena en formato PEM.",{"_3697":74683,"_31245":74610,"_21577":126374,"_5":14884,"_28435":126202,"_3074":126375},[],"Número de certificados activos, expirados y revocados.",{"_3697":74684,"_31245":74610,"_21577":126377,"_5":14884,"_28435":126202,"_3074":126378},[],"Certificados emitidos en **Issued Certificates**.",{"_3697":74685,"_31245":74610,"_21577":126380,"_5":14884,"_28435":126202,"_3074":126381},[],"CRL vinculada a la autoridad.",{"_3697":74686,"_31245":74610,"_21577":126383,"_5":14884,"_28435":126202,"_3074":126384},[],"Metadatos y motor criptográfico asociado.",{"_3697":74687,"_31245":74610,"_21577":126386,"_5":14884,"_28435":126202,"_3074":126387},[],"Puedes filtrar el inventario por nombre, estado y tipo de CA.",{"_3697":74688,"_31245":74610,"_21577":126389,"_5":14884,"_28435":126206,"_3074":126390},[],"Puedes iniciar una emisión desde **Issued Certificates**, desde la acción de una CA o desde el inventario global de certificados.",{"_3697":74689,"_31245":74610,"_21577":126392,"_5":14884,"_28435":126206,"_3074":126393},[],"**Generate Key & CSR in Browser** resulta útil para una operación manual o una prueba rápida. El navegador genera la clave y debes descargarla al finalizar.",{"_3697":74690,"_31245":74610,"_21577":126395,"_5":14884,"_28435":126206,"_3074":126396},[],"**Upload Existing CSR** es la opción adecuada cuando la clave debe permanecer en el sistema de destino. Lamassu recibe la solicitud, pero nunca la clave privada.",{"_3697":74691,"_31245":74610,"_21577":126398,"_5":14884,"_28435":126206,"_3074":126399},[],"Sigue Emite tu primer certificado para el flujo guiado. La gestión de certificados explica el inventario, la inspección y la revocación.",{"_3697":74692,"_31245":74610,"_21577":126401,"_5":14884,"_28435":126206,"_3074":126402},[],"La clave de una CA solo firma certificados. La API de CA no tiene ningún endpoint para firmar o verificar datos arbitrarios. Para firmar y verificar un mensaje con una clave, utiliza las operaciones del KMS descritas en Gestión de claves, sujetas a sus propios permisos.",{"_3697":74693,"_31245":74610,"_21577":126404,"_5":14884,"_28435":126206,"_3074":126405},[],"Una CA solo firma mientras su estado es `ACTIVE` y la hora actual está dentro del periodo de validez de su certificado. Lamassu comprueba ambas condiciones porque el estado almacenado puede ir por detrás de las fechas hasta que se ejecuta el monitor de expiración. En caso contrario, la petición falla con `400` y el mensaje `CA Status inconsistent`, antes de llamar al KMS. La misma comprobación se aplica cuando la CA firma el certificado de una CA subordinada, también al crearla o reemitirla.",{"_3697":74694,"_31245":74610,"_21577":126407,"_5":14884,"_28435":126210,"_3074":126408},[],"Revocar una CA impide que emita y puede interrumpir toda su rama. Con `CertificateHold` la cascada es reversible: los descendientes quedan suspendidos y se restauran al reactivar la CA. Cualquier otra razón de revocación revoca los descendientes definitivamente con `CessationOfOperation`. Sigue las condiciones de revocación en cascada.",{"_3697":74695,"_31245":74610,"_21577":126410,"_5":14884,"_28435":126214,"_3074":126411},[],"Identifica los certificados, dispositivos y consumidores que dependen de la CA. Prepara una autoridad y una cadena de sustitución cuando sea necesario.",{"_3697":74696,"_31245":74610,"_21577":126413,"_5":14884,"_28435":126218,"_3074":126414},[],"Abre la autoridad y selecciona **Revoke CA**. Elige la razón que describa el incidente, por ejemplo `KeyCompromise`, `CACompromise`, `Superseded` o `CessationOfOperation`.",{"_3697":74697,"_31245":74610,"_21577":126416,"_5":14884,"_28435":126222,"_3074":126417},[],"Escribe exactamente el nombre de la CA para habilitar **Confirm Revocation**.",{"_3697":74698,"_31245":74610,"_21577":126419,"_5":14884,"_28435":126226,"_3074":126420},[],"Comprueba **REVOKED** en la CA y revisa los descendientes uno a uno; la propagación admite fallos parciales. Verifica por separado la publicación de OCSP y CRL y el rechazo por los consumidores. Un registro revocado no garantiza que una sesión existente se cierre.",{"_3697":74699,"_31245":74610,"_21577":126422,"_5":14884,"_28435":126230,"_3074":126423},[],"La eliminación permanente solo está disponible con la CA revocada o caducada; una CA importada sin clave puede eliminarse en cualquier estado. Elimina el registro únicamente cuando la política de retención y auditoría lo permita.",{"_3697":74700,"_31245":74610,"_21577":126425,"_5":14884,"_28435":126230,"_3074":126426},[],"Lo que la eliminación hace con lo emitido por la CA depende de su estado. Eliminar una CA activa importada sin clave cuyo periodo de validez no ha terminado solo elimina el registro de Lamassu: la CA, sus descendientes y los certificados que emitió conservan su estado, ya que la CA sigue operando fuera de Lamassu — su clave nunca estuvo en Lamassu. Pero si el periodo de validez ya terminó y el estado almacenado sigue siendo `ACTIVE` — el estado almacenado puede ir por detrás de las fechas hasta que se ejecute el monitor de expiración —, para la eliminación la CA cuenta como caducada. Eliminar una CA revocada o caducada revoca lo que emitió con `CessationOfOperation`, la misma cascada que al revocar una CA. Para retirar una CA activa sin clave junto con todo lo que emitió, revócala primero con `POST /v1/cas/:id/status` y después elimínala.",{"_3697":74701,"_31245":74610,"_21577":126428,"_5":14884,"_28435":126230,"_3074":126429},[],"Los ajustes de CRL de la CA se conservan. La eliminación se rechaza con un error `409` mientras sigan `ACTIVE`: la VA debe publicar primero la CRL final de la CA, lo que puede tardar hasta aproximadamente una hora después de la revocación con la programación predeterminada del trabajo, así que reintenta cuando se haya publicado la CRL final. Una CA caducada se finaliza sin CRL final, y una CA en retención (`CertificateHold`) se rechaza con un mensaje que te pide revocarla de forma permanente primero. La eliminación también se rechaza con un `409` cuando la clave de la CA firma las CRLs de otra CA: el error nombra a esa CA, así que cambia su firmante de CRL, o elimínala o revócala, antes de eliminar esta. La CA y todos sus descendientes se comprueban antes de eliminar nada; si alguno no puede eliminarse, no cambia nada.",{"_3697":74702,"_31245":74610,"_21577":126431,"_5":14884,"_28435":126230,"_3074":126432},[],"Tras la eliminación, los ajustes quedan archivados y la última CRL sigue sirviéndose pero nunca se regenera; puedes eliminarlos cuando ningún certificado emitido por la CA necesite ya evidencia de revocación, con `DELETE /v1/crl-settings/{ca-id}` o desde la página **Verification Authorities** de la consola. Borrarlos deja de servir la CRL y no puede deshacerse. Ajusta la validez y el firmante antes de revocar o eliminar la CA (consulta CRL). La clave de la CA se libera, pero el KMS la conserva mientras otros certificados la referencien.",{"_3697":74703,"_31245":74610,"_21577":126434,"_5":14884,"_28435":126230,"_3074":126435},[],"Lamassu conserva el registro del certificado de una CA eliminada. Si se importa de nuevo ese mismo certificado, la importación termina bien y reutiliza el registro: actualiza el tipo, el emisor y la clave, pero conserva el estado, así que la CA reaparece con el que tenía al eliminarse (normalmente revocada o caducada). Un certificado distinto con el mismo número de serie se rechaza con error 400, y un certificado que ya pertenece a una CA existente, con error 409. Para no heredar el estado anterior, usa un certificado con otro número de serie y comprueba el resultado tras importar. La CA reimportada se registra con un ID de CA nuevo generado por el backend y no hereda los ajustes de CRL de la CA eliminada: hasta que se eliminen esos ajustes, estos siguen sirviendo su última CRL en la URL del ID de CA y, si los migró la actualización, en `/crl/<ski>` — la que llevan los certificados emitidos antes de la actualización a 4.0.0 —; cuando están archivados, dejan de poder editarse (consulta CRL).",{"_3697":74704,"_31245":74704,"_5":15238,"_3074":126437,"_31570":126438,"_21577":126439,"_28435":74704},"Perfiles de certificado",[50948,121910,56713,125969],[],{"_3697":74705,"_31245":74704,"_21577":126441,"_5":14884,"_28435":74704,"_3074":126442},[],"Define políticas reutilizables para emitir certificados coherentes y limitar las claves aceptadas.",{"_3697":74706,"_31245":74704,"_5":31567,"_21577":126444,"_28435":126445,"_3074":126446},[],"/docs/es/platform/pki/certificate-profiles#qué-controla-un-perfil","Qué controla un perfil",{"_3697":74707,"_31245":74704,"_5":31567,"_21577":126448,"_28435":126449,"_3074":126450},[],"/docs/es/platform/pki/certificate-profiles#validez","Validez",{"_3697":74708,"_31245":74704,"_5":31567,"_21577":126452,"_28435":126453,"_3074":126454},[],"/docs/es/platform/pki/certificate-profiles#certificado-de-ca-o-certificado-final","Certificado de CA o certificado final",{"_3697":74709,"_31245":74704,"_5":31567,"_21577":126456,"_28435":126457,"_3074":126458},[],"/docs/es/platform/pki/certificate-profiles#key-usage-y-extended-key-usage","Key Usage y Extended Key Usage",{"_3697":74710,"_31245":74704,"_5":31567,"_21577":126460,"_28435":126461,"_3074":126462},[],"/docs/es/platform/pki/certificate-profiles#sujeto","Sujeto",{"_3697":74711,"_31245":74704,"_5":31567,"_21577":126464,"_28435":126465,"_3074":126466},[],"/docs/es/platform/pki/certificate-profiles#extensiones-de-la-csr","Extensiones de la CSR",{"_3697":74712,"_31245":74704,"_5":31567,"_21577":126468,"_28435":126469,"_3074":126470},[],"/docs/es/platform/pki/certificate-profiles#restricciones-criptográficas","Restricciones criptográficas",{"_3697":74713,"_31245":74704,"_5":31567,"_21577":126472,"_28435":126473,"_3074":126474},[],"/docs/es/platform/pki/certificate-profiles#precedencia-del-perfil","Precedencia del perfil",{"_3697":74714,"_31245":74704,"_5":31567,"_21577":126476,"_28435":126477,"_3074":126478},[],"/docs/es/platform/pki/certificate-profiles#crea-un-perfil","Crea un perfil",{"_3697":74715,"_31245":74704,"_5":31567,"_21577":126480,"_28435":126481,"_3074":126482},[],"/docs/es/platform/pki/certificate-profiles#define-un-único-propósito","Define un único propósito",{"_3697":74716,"_31245":74704,"_5":31567,"_21577":126484,"_28435":126485,"_3074":126486},[],"/docs/es/platform/pki/certificate-profiles#elige-la-validez","Elige la validez",{"_3697":74717,"_31245":74704,"_5":31567,"_21577":126488,"_28435":126489,"_3074":126490},[],"/docs/es/platform/pki/certificate-profiles#fija-usos-y-sujeto","Fija usos y sujeto",{"_3697":74718,"_31245":74704,"_5":31567,"_21577":126492,"_28435":126493,"_3074":126494},[],"/docs/es/platform/pki/certificate-profiles#restringe-las-claves","Restringe las claves",{"_3697":74719,"_31245":74704,"_5":31567,"_21577":126496,"_28435":126497,"_3074":126498},[],"/docs/es/platform/pki/certificate-profiles#asócialo-y-prueba","Asócialo y prueba",{"_3697":74720,"_31245":74704,"_5":31567,"_21577":126500,"_28435":126501,"_3074":126502},[],"/docs/es/platform/pki/certificate-profiles#ejemplos-de-diseño","Ejemplos de diseño",{"_3697":74721,"_31245":74704,"_5":31567,"_21577":126504,"_28435":126505,"_3074":126506},[],"/docs/es/platform/pki/certificate-profiles#cambios-y-eliminación","Cambios y eliminación",{"_3697":74722,"_31245":74704,"_21577":126508,"_5":14884,"_28435":74704,"_3074":126509},[],"Un perfil de emisión convierte una política de certificados en configuración reutilizable. En lugar de decidir validez, sujeto, extensiones y algoritmos en cada solicitud, defines una vez qué está permitido y asocias el perfil a una CA, un DMS o una emisión concreta.",{"_3697":74723,"_31245":74704,"_21577":126511,"_5":14884,"_28435":74704,"_3074":126512},[],"Esta guía se dirige al administrador PKI que define la política de emisión. Necesitas permisos para gestionar perfiles y asociarlos a la CA o DMS previstos, además de un consumidor de prueba con requisitos de identidad y uso conocidos.",{"_3697":74724,"_31245":74704,"_21577":126514,"_5":14884,"_28435":126449,"_3074":126515},[],"Puedes expresar la vigencia como una duración desde el momento de emisión o como una fecha final fija. Una duración funciona bien para identidades recurrentes; una fecha común sirve para hacer que todo un lote termine antes de una migración o retirada.",{"_3697":74725,"_31245":74704,"_21577":126517,"_5":14884,"_28435":126449,"_3074":126518},[],"Planifica la fecha final dentro de la vigencia de la CA emisora y deja margen para renovar. El firmador calcula la fecha desde el perfil; no recorta automáticamente la validez al vencimiento del emisor. Comprueba ambas fechas en el certificado resultante. Una fecha fija ya pasada tampoco representa una identidad utilizable.",{"_3697":74726,"_31245":74704,"_21577":126520,"_5":14884,"_28435":126453,"_3074":126521},[],"`Sign as CA` establece `IsCA` y las restricciones básicas necesarias para una autoridad. Lamassu lo aplica: un perfil con `Sign as CA` solo se consume al crear o reemitir una CA. Toda solicitud de firma que resuelva a un perfil así se rechaza — la firma directa con una CA, incluidas las solicitudes de emisión de certificados sobre ella, y el enrolamiento o reenrolamiento del DMS. Nada valida el perfil al guardarlo: si el perfil predeterminado de una CA o el perfil de un DMS lo tiene activado, el problema aparece en la primera solicitud de firma que lo resuelva — en el caso de un DMS, cuando un dispositivo intenta enrolarse o reenrolarse — y la renovación sigue bloqueada hasta que se cambia el perfil.",{"_3697":74727,"_31245":74704,"_21577":126523,"_5":14884,"_28435":126457,"_3074":126524},[],"El perfil puede imponer usos como `DigitalSignature`, `KeyEncipherment`, `CertSign`, `CRLSign`, `ClientAuth`, `ServerAuth` u `OCSPSigning`.",{"_3697":74728,"_31245":74704,"_21577":126526,"_5":14884,"_28435":126457,"_3074":126527},[],"Si activas **Honor Key Usage** o **Honor Extended Key Usages**, Lamassu conserva los valores solicitados por la CSR. Si los desactivas, los sustituye por los definidos en el perfil.",{"_3697":74729,"_31245":74704,"_21577":126529,"_5":14884,"_28435":126457,"_3074":126530},[],"No habilites las opciones `Honor…` para solicitudes no confiables salvo que otro componente valide esos campos. De lo contrario, el solicitante puede elegir capacidades más amplias de las previstas.",{"_3697":74730,"_31245":74704,"_21577":126532,"_5":14884,"_28435":126461,"_3074":126533},[],"Con **Honor Subject**, el certificado conserva el sujeto de la CSR. Sin esa opción, Lamassu aplica `CN`, `O`, `OU`, `C`, `ST` y `L` del perfil. Si el perfil no define `Common Name`, se conserva el CN solicitado.",{"_3697":74731,"_31245":74704,"_21577":126535,"_5":14884,"_28435":126465,"_3074":126536},[],"Con **Honor Extensions**, Lamassu filtra las extensiones adicionales solicitadas y conserva únicamente SAN. Sin esa opción, descarta las extensiones adicionales de la CSR.",{"_3697":74732,"_31245":74704,"_21577":126538,"_5":14884,"_28435":126465,"_3074":126539},[],"Esto conserva SAN, pero no comprueba que el solicitante tenga derecho a utilizar esos DNS, IP, correos o URI. Valida esa autorización antes de emitir. Los puntos OCSP y CRL proceden de la configuración del servicio de emisión; `Honor Extensions` no copia los puntos de distribución de la CSR.",{"_3697":74733,"_31245":74704,"_21577":126541,"_5":14884,"_28435":126469,"_3074":126542},[],"La aplicación criptográfica puede:",{"_3697":74734,"_31245":74704,"_21577":126544,"_5":14884,"_28435":126469,"_3074":126545},[],"permitir o bloquear claves RSA;",{"_3697":74735,"_31245":74704,"_21577":126547,"_5":14884,"_28435":126469,"_3074":126548},[],"limitar los tamaños RSA admitidos;",{"_3697":74736,"_31245":74704,"_21577":126550,"_5":14884,"_28435":126469,"_3074":126551},[],"permitir o bloquear claves ECDSA;",{"_3697":74737,"_31245":74704,"_21577":126553,"_5":14884,"_28435":126469,"_3074":126554},[],"limitar los tamaños o curvas ECDSA admitidos.",{"_3697":74738,"_31245":74704,"_21577":126556,"_5":14884,"_28435":126469,"_3074":126557},[],"Cuando está habilitada, Lamassu comprueba la clave pública antes de crear una CA o firmar una CSR. Una clave cuyo tipo o tamaño no figure en el perfil se rechaza.",{"_3697":74739,"_31245":74704,"_21577":126559,"_5":14884,"_28435":126473,"_3074":126560},[],"La resolución depende del punto de entrada. Se selecciona un perfil completo; sus campos no se fusionan con los del perfil de la CA.",{"_3697":74740,"_31245":74704,"_21577":126562,"_5":14884,"_28435":126473,"_3074":121670},[],{"_3697":74741,"_31245":74704,"_21577":126564,"_5":14884,"_28435":126473,"_3074":126565},[],"Primera opción",{"_3697":74742,"_31245":74704,"_21577":126567,"_5":14884,"_28435":126473,"_3074":126568},[],"Segunda opción",{"_3697":74743,"_31245":74704,"_21577":126570,"_5":14884,"_28435":126473,"_3074":126571},[],"Si no hay ninguna",{"_3697":74744,"_31245":74704,"_21577":126573,"_5":14884,"_28435":126473,"_3074":126574},[],"Firma directa con una CA",{"_3697":74745,"_31245":74704,"_21577":126576,"_5":14884,"_28435":126473,"_3074":126577},[],"`issuance_profile` incluido en la solicitud",{"_3697":74746,"_31245":74704,"_21577":126579,"_5":14884,"_28435":126473,"_3074":126580},[],"`issuance_profile_id` de la solicitud",{"_3697":74747,"_31245":74704,"_21577":126582,"_5":14884,"_28435":126473,"_3074":126583},[],"Perfil predeterminado de la CA (`profile_id`).",{"_3697":74748,"_31245":74704,"_21577":126585,"_5":14884,"_28435":126473,"_3074":126586},[],"Emisión mediante DMS",{"_3697":74749,"_31245":74704,"_21577":126588,"_5":14884,"_28435":126473,"_3074":57334},[],{"_3697":74750,"_31245":74704,"_21577":126590,"_5":14884,"_28435":126473,"_3074":126591},[],"`settings.issuance_profile` incluido en el DMS",{"_3697":74751,"_31245":74704,"_21577":126593,"_5":14884,"_28435":126473,"_3074":126594},[],"Perfil predeterminado de la CA de enrolamiento.",{"_3697":74752,"_31245":74704,"_21577":126596,"_5":14884,"_28435":126473,"_3074":126597},[],"Si el identificador seleccionado no puede resolverse, la operación falla; no se sustituye silenciosamente por el perfil de la CA. Evita definir las dos opciones a la vez. Registrar qué perfil se seleccionó facilita explicar por qué el resultado difiere de la CSR.",{"_3697":74753,"_31245":74704,"_21577":126599,"_5":14884,"_28435":126473,"_3074":126600},[],"Varias flotas pueden compartir CA y mantener perfiles distintos mediante sus DMS. La autenticación del solicitante y la política de registro del dispositivo se configuran aparte en DMS.",{"_3697":74754,"_31245":74704,"_21577":126602,"_5":14884,"_28435":126481,"_3074":126603},[],"Separa, por ejemplo, dispositivos mTLS, servidores y CAs intermedias. Un perfil pequeño y específico es más fácil de revisar que uno que permita todos los usos.",{"_3697":74755,"_31245":74704,"_21577":126605,"_5":14884,"_28435":126485,"_3074":126606},[],"Alinea la duración con la capacidad real de renovación de la flota. Deja margen respecto a la expiración de la CA.",{"_3697":74756,"_31245":74704,"_21577":126608,"_5":14884,"_28435":126489,"_3074":126609},[],"Para un dispositivo que se autentica como cliente, el punto de partida habitual es `DigitalSignature` y `ClientAuth`. Añade `ServerAuth` o `KeyEncipherment` solo si el protocolo lo necesita.",{"_3697":74757,"_31245":74704,"_21577":126611,"_5":14884,"_28435":126493,"_3074":126612},[],"Habilita la aplicación criptográfica y enumera únicamente algoritmos y tamaños compatibles con tu política y tus dispositivos.",{"_3697":74758,"_31245":74704,"_21577":126614,"_5":14884,"_28435":126497,"_3074":126615},[],"Asocia el perfil a una CA o DMS y verifica la precedencia anterior. Emite una CSR con usos y SAN conocidos; inspecciona el resultado con `openssl x509 -in device.crt -noout -text`. Comprueba sujeto, SAN, KU, EKU y fechas. Para una identidad final, `Sign as CA` debe estar desactivado, no debe aparecer `CA:TRUE` ni `Certificate Sign`; si existe Basic Constraints, debe indicar `CA:FALSE`.",{"_3697":74759,"_31245":74704,"_21577":126617,"_5":14884,"_28435":126497,"_3074":126618},[],"Prueba también una clave excluida por la política: la emisión debe rechazarse. Sigue la verificación del certificado y prueba su aceptación en el consumidor previsto.",{"_3697":74760,"_31245":74704,"_21577":126620,"_5":14884,"_28435":126501,"_3074":126621},[],"**Dispositivo mTLS**\\\nCertificado final, validez corta, `DigitalSignature`, `ClientAuth`, sujeto controlado por el DMS y SAN permitido cuando identifica al dispositivo.",{"_3697":74761,"_31245":74704,"_21577":126623,"_5":14884,"_28435":126501,"_3074":126624},[],"**Servidor TLS**\\\nCertificado final, `DigitalSignature`, `ServerAuth` y SAN obligatorio con los nombres que utilizarán los clientes.",{"_3697":74762,"_31245":74704,"_21577":126626,"_5":14884,"_28435":126501,"_3074":126627},[],"**CA intermedia**\\\n`Sign as CA`, `CertSign` y `CRLSign`, validez superior a sus certificados finales y restricciones criptográficas más exigentes.",{"_3697":74763,"_31245":74704,"_21577":126629,"_5":14884,"_28435":126501,"_3074":126630},[],"Estos patrones expresan decisiones de diseño. Activar `Honor Extensions` no exige que la CSR incluya SAN ni valida sus nombres; debes hacer esa comprobación en el flujo de solicitud. El perfil tampoco instala confianza ni concede permisos en el consumidor.",{"_3697":74764,"_31245":74704,"_21577":126632,"_5":14884,"_28435":126505,"_3074":126633},[],"Actualizar un perfil afecta a emisiones futuras; no modifica certificados ya firmados. Prueba los cambios antes de aplicarlos a una CA en producción y conserva la justificación operativa.",{"_3697":74765,"_31245":74704,"_21577":126635,"_5":14884,"_28435":126505,"_3074":126636},[],"Antes de eliminar un perfil, comprueba que ninguna CA o DMS dependa de él. Si deseas sustituirlo, crea la versión nueva, actualiza las referencias y realiza una emisión de prueba antes de retirar el anterior.",{"_3697":74766,"_31245":74766,"_5":15238,"_3074":126638,"_31570":126639,"_21577":126641,"_28435":74766},"Validación de certificados",[50948,121910,56713,126640],"Validación",[],{"_3697":74767,"_31245":74766,"_21577":126643,"_5":14884,"_28435":74766,"_3074":126644},[],"Comprueba cadena, identidad, usos y revocación desde el consumidor.",{"_3697":74768,"_31245":74766,"_5":31567,"_21577":126646,"_28435":126647,"_3074":126648},[],"/docs/es/platform/pki/certificate-validation#antes-de-consultar-el-estado","Antes de consultar el estado",{"_3697":74769,"_31245":74766,"_5":31567,"_21577":126650,"_28435":126651,"_3074":126652},[],"/docs/es/platform/pki/certificate-validation#elige-un-mecanismo","Elige un mecanismo",{"_3697":74770,"_31245":74766,"_5":31567,"_21577":126654,"_28435":126655,"_3074":126656},[],"/docs/es/platform/pki/certificate-validation#comprueba-el-comportamiento-del-consumidor","Comprueba el comportamiento del consumidor",{"_3697":74771,"_31245":74766,"_21577":126658,"_5":14884,"_28435":74766,"_3074":126659},[],"Esta guía reúne las comprobaciones que necesita quien integra un consumidor de certificados. Necesitas el certificado presentado, las intermedias y las raíces que tu aplicación ha decidido confiar. Lamassu publica estado; el consumidor aplica la política de aceptación.",{"_3697":74772,"_31245":74766,"_21577":126661,"_5":14884,"_28435":126647,"_3074":126662},[],"Verifica estos criterios juntos:",{"_3697":74773,"_31245":74766,"_21577":126664,"_5":14884,"_28435":126647,"_3074":125598},[],{"_3697":74774,"_31245":74766,"_21577":126666,"_5":14884,"_28435":126647,"_3074":126667},[],"Resultado necesario",{"_3697":74775,"_31245":74766,"_21577":126669,"_5":14884,"_28435":126647,"_3074":126670},[],"Cadena y firma",{"_3697":74776,"_31245":74766,"_21577":126672,"_5":14884,"_28435":126647,"_3074":126673},[],"Cadena válida hasta una raíz instalada deliberadamente en el consumidor.",{"_3697":74777,"_31245":74766,"_21577":126675,"_5":14884,"_28435":126647,"_3074":126676},[],"Fechas",{"_3697":74778,"_31245":74766,"_21577":126678,"_5":14884,"_28435":126647,"_3074":126679},[],"Fecha actual entre `Not Before` y `Not After`, también para las CAs de la cadena.",{"_3697":74779,"_31245":74766,"_21577":126681,"_5":14884,"_28435":126647,"_3074":121580},[],{"_3697":74780,"_31245":74766,"_21577":126683,"_5":14884,"_28435":126647,"_3074":126684},[],"Nombre, SAN o identificador corresponden al interlocutor esperado.",{"_3697":74781,"_31245":74766,"_21577":126686,"_5":14884,"_28435":126647,"_3074":126687},[],"Uso",{"_3697":74782,"_31245":74766,"_21577":126689,"_5":14884,"_28435":126647,"_3074":126690},[],"KU, EKU y restricciones permiten la operación concreta.",{"_3697":74783,"_31245":74766,"_21577":126692,"_5":14884,"_28435":126647,"_3074":126693},[],"Revocación",{"_3697":74784,"_31245":74766,"_21577":126695,"_5":14884,"_28435":126647,"_3074":126696},[],"Evidencia firmada, vigente y correspondiente al emisor y certificado consultados.",{"_3697":74785,"_31245":74766,"_21577":126698,"_5":14884,"_28435":126647,"_3074":126699},[],"Autorización",{"_3697":74786,"_31245":74766,"_21577":126701,"_5":14884,"_28435":126647,"_3074":126702},[],"La aplicación permite la acción a esa identidad.",{"_3697":74787,"_31245":74766,"_21577":126704,"_5":14884,"_28435":126647,"_3074":126705},[],"El recorrido de emisión comprueba cadena y uso con OpenSSL. Esa comprobación no consulta automáticamente OCSP ni descarga una CRL. Un certificado presente en el inventario o una respuesta OCSP `Good` no sustituyen los demás criterios.",{"_3697":74788,"_31245":74766,"_21577":126707,"_5":14884,"_28435":126651,"_3074":126708},[],"Mecanismo",{"_3697":74789,"_31245":74766,"_21577":126710,"_5":14884,"_28435":126651,"_3074":126711},[],"Cuándo utilizarlo",{"_3697":74790,"_31245":74766,"_21577":126713,"_5":14884,"_28435":126651,"_3074":126714},[],"Qué debes mantener",{"_3697":74791,"_31245":74766,"_21577":126716,"_5":14884,"_28435":126651,"_3074":57462},[],{"_3697":74792,"_31245":74766,"_21577":126718,"_5":14884,"_28435":126651,"_3074":126719},[],"Consulta del estado de un certificado concreto.",{"_3697":74793,"_31245":74766,"_21577":126721,"_5":14884,"_28435":126651,"_3074":126722},[],"Acceso al respondedor, verificación de la firma y política de caché/vigencia.",{"_3697":74794,"_31245":74766,"_21577":126724,"_5":14884,"_28435":126651,"_3074":57471},[],{"_3697":74795,"_31245":74766,"_21577":126726,"_5":14884,"_28435":126651,"_3074":126727},[],"Consulta local de muchos certificados o funcionamiento offline.",{"_3697":74796,"_31245":74766,"_21577":126729,"_5":14884,"_28435":126651,"_3074":126730},[],"Descarga periódica de una lista firmada por el emisor y rechazo de listas vencidas.",{"_3697":74797,"_31245":74766,"_21577":126732,"_5":14884,"_28435":126651,"_3074":126733},[],"OCSP también puede devolver una respuesta reutilizable hasta `nextUpdate`; una CRL cambia al publicarse una versión nueva. Ninguno garantiza por sí solo que un consumidor conozca una revocación en el momento de guardarla.",{"_3697":74798,"_31245":74766,"_21577":126735,"_5":14884,"_28435":126651,"_3074":126736},[],"Si utilizas ambos, define cuándo se permite el mecanismo alternativo y qué hace el cliente si falla la descarga, la firma, la vigencia o devuelve `Unknown`. Aceptar una identidad cuando no puedes comprobar su estado debe ser una decisión explícita de tu aplicación.",{"_3697":74799,"_31245":74766,"_21577":126738,"_5":14884,"_28435":126655,"_3074":126739},[],"Acepta un certificado vigente, autorizado y con cadena conocida.",{"_3697":74800,"_31245":74766,"_21577":126741,"_5":14884,"_28435":126655,"_3074":126742},[],"Rechaza otro con raíz desconocida o uso incompatible.",{"_3697":74801,"_31245":74766,"_21577":126744,"_5":14884,"_28435":126655,"_3074":126745},[],"Revoca un certificado de prueba y verifica la respuesta OCSP o la nueva CRL.",{"_3697":74802,"_31245":74766,"_21577":126747,"_5":14884,"_28435":126655,"_3074":126748},[],"Comprueba que una conexión nueva con esa identidad se rechaza.",{"_3697":74803,"_31245":74766,"_21577":126750,"_5":14884,"_28435":126655,"_3074":126751},[],"Simula un endpoint inaccesible y evidencia vencida; observa si el resultado coincide con tu política.",{"_3697":74804,"_31245":74766,"_21577":126753,"_5":14884,"_28435":126655,"_3074":126754},[],"Conserva número de serie, emisor, razón de revocación, hora de consulta y tiempos de la evidencia. Una sesión ya abierta puede necesitar cierre o reautenticación explícita en el servicio consumidor; publicar revocación no la cierra automáticamente.",{"_3697":74805,"_31245":74766,"_21577":126756,"_5":14884,"_28435":126655,"_3074":126757},[],"Para una cadena con intermedias, valida también su estado según la política del consumidor. La CRL del emisor de una identidad final no reemplaza las comprobaciones de todas las CAs de la cadena.",{"_3697":74806,"_31245":74766,"_21577":126759,"_5":14884,"_28435":126655,"_3074":126760},[],"<Card title=\"Validación online con OCSP\" description=\"Genera una consulta y verifica firma, estado y tiempos.\" href=\"/docs/platform/pki/ocsp\" />",{"_3697":74807,"_31245":74766,"_21577":126762,"_5":14884,"_28435":126655,"_3074":126763},[],"<Card title=\"Listas de revocación\" description=\"Descarga, inspecciona y utiliza una CRL del emisor.\" href=\"/docs/platform/pki/crl\" />",{"_3697":74808,"_31245":74808,"_5":15238,"_3074":126765,"_31570":126766,"_21577":126767,"_28435":74808},"Certificados",[50948,121910,56713,125969],[],{"_3697":74809,"_31245":74808,"_21577":126769,"_5":14884,"_28435":74808,"_3074":126770},[],"Consulta, descarga y revoca los certificados emitidos por Lamassu.",{"_3697":74810,"_31245":74808,"_5":31567,"_21577":126772,"_28435":126773,"_3074":126774},[],"/docs/es/platform/pki/certificates#busca-un-certificado","Busca un certificado",{"_3697":74811,"_31245":74808,"_5":31567,"_21577":126776,"_28435":126777,"_3074":126778},[],"/docs/es/platform/pki/certificates#descarga-el-certificado","Descarga el certificado",{"_3697":74812,"_31245":74808,"_5":31567,"_21577":126780,"_28435":126781,"_3074":126782},[],"/docs/es/platform/pki/certificates#emite-desde-una-csr-existente","Emite desde una CSR existente",{"_3697":74813,"_31245":74808,"_5":31567,"_21577":126784,"_28435":126785,"_3074":126786},[],"/docs/es/platform/pki/certificates#revoca-un-certificado","Revoca un certificado",{"_3697":74814,"_31245":74808,"_5":31567,"_21577":126788,"_28435":126789,"_3074":126790},[],"/docs/es/platform/pki/certificates#abre-la-acción","Abre la acción",{"_3697":74815,"_31245":74808,"_5":31567,"_21577":126792,"_28435":126793,"_3074":126794},[],"/docs/es/platform/pki/certificates#elige-una-razón","Elige una razón",{"_3697":74816,"_31245":74808,"_5":31567,"_21577":126796,"_28435":126797,"_3074":126798},[],"/docs/es/platform/pki/certificates#confirma-y-verifica","Confirma y verifica",{"_3697":74817,"_31245":74808,"_5":31567,"_21577":126800,"_28435":126801,"_3074":126802},[],"/docs/es/platform/pki/certificates#reactiva-una-suspensión","Reactiva una suspensión",{"_3697":74818,"_31245":74808,"_5":31567,"_21577":126804,"_28435":126805,"_3074":126806},[],"/docs/es/platform/pki/certificates#continúa","Continúa",{"_3697":74819,"_31245":74808,"_21577":126808,"_5":14884,"_28435":74808,"_3074":126809},[],"Esta guía sirve al operador PKI que necesita inspeccionar o retirar una identidad ya emitida. Necesitas acceso al inventario y, para cambiar estados, permisos sobre el certificado. Abre **Certificates** para una vista global o **Issued Certificates** dentro de una CA para limitarla a ese emisor.",{"_3697":74820,"_31245":74808,"_21577":126811,"_5":14884,"_28435":126773,"_3074":126812},[],"Filtra por `Common Name`, serie, estado y autoridad emisora. Un certificado no contiene su clave privada, así que las superficies de clave privada responden qué certificados tienen su clave custodiada en el KMS de Lamassu:",{"_3697":74821,"_31245":74808,"_21577":126814,"_5":14884,"_28435":126773,"_3074":126815},[],"El filtro avanzado **Private Key**, disponible en la página Certificates y en la pestaña **Issued Certificates** de una CA, limita la lista a **All Certificates**, **With Private Key** o **Without Private Key**.",{"_3697":74822,"_31245":74808,"_21577":126817,"_5":14884,"_28435":126773,"_3074":126818},[],"La columna ordenable **Private Key** — visible por defecto y oculta en pantallas estrechas — marca con una marca de verificación verde la clave custodiada en el KMS y muestra `-` en los demás casos.",{"_3697":74823,"_31245":74808,"_21577":126820,"_5":14884,"_28435":126773,"_3074":126821},[],"En los detalles del certificado, la pestaña **Information** muestra una fila **Private Key** en la sección **Key & Signature**. Cuando el certificado indica que tiene clave privada y están disponibles los identificadores de la clave y del motor del KMS, la fila enlaza a la clave (tooltip: **Open private key in KMS**). En caso contrario, muestra **Present** si el certificado indica que tiene clave privada o **Not available** si no lo indica. Esto no determina si existe una clave fuera de Lamassu.",{"_3697":74824,"_31245":74808,"_21577":126823,"_5":14884,"_28435":126773,"_3074":126824},[],"Usa **Quick Inspect** para una revisión rápida o **View Details** para sujeto, SAN, usos, cadena, fechas y metadatos.",{"_3697":74825,"_31245":74808,"_21577":126826,"_5":14884,"_28435":126773,"_3074":126827},[],"Los registros de certificados exponen `key_id` (la clave del KMS que custodia la clave privada, vacía cuando el KMS no la custodia) y `has_private_key` (derivada al leerla desde el KMS). Los listados de certificados y CAs admiten un filtro `has_private_key`, útil, por ejemplo, para comprobar el resultado de la migración de CA a KMS de la actualización a 4.0.0.",{"_3697":74826,"_31245":74808,"_21577":126829,"_5":14884,"_28435":126773,"_3074":126830},[],"Identifica el certificado por emisor y número de serie; un nombre puede corresponder a varias renovaciones. Comprueba cuál utiliza realmente el consumidor y cuál ocupa la identidad activa del dispositivo. El historial de identidades y el inventario de certificados responden preguntas distintas.",{"_3697":74827,"_31245":74808,"_21577":126832,"_5":14884,"_28435":126777,"_3074":126833},[],"Descarga el PEM e inspecciónalo:",{"_3697":74828,"_31245":74808,"_21577":126835,"_5":14884,"_28435":126777,"_3074":126836},[],"Comprueba la política de emisión, cadena y usos con el recorrido de verificación. El certificado no contiene su clave privada. Para una CSR externa, esa clave permanece donde se generó; para el flujo de navegador, conserva el archivo descargado al completar la emisión. Si has perdido la clave, planifica una identidad nueva en lugar de esperar recuperarla desde el certificado.",{"_3697":74829,"_31245":74808,"_21577":126838,"_5":14884,"_28435":126781,"_3074":126839},[],"Utiliza este flujo cuando la clave de la identidad debe permanecer en el sistema que la generó. Necesitas una CA activa con clave utilizable, una CSR PEM y un perfil apropiado.",{"_3697":74830,"_31245":74808,"_21577":126841,"_5":14884,"_28435":126781,"_3074":126842},[],"Verifica la solicitud con `openssl req -in request.csr -noout -verify -text`. Revisa sujeto, SAN y algoritmo, y autoriza la identidad solicitada.",{"_3697":74831,"_31245":74808,"_21577":126844,"_5":14884,"_28435":126781,"_3074":126845},[],"Inicia la emisión desde la CA o el inventario y selecciona **Upload Existing CSR**.",{"_3697":74832,"_31245":74808,"_21577":126847,"_5":14884,"_28435":126781,"_3074":126848},[],"Confirma la CA y el perfil que se resolverá según Perfiles; la solicitud no garantiza que todos sus campos se conserven.",{"_3697":74833,"_31245":74808,"_21577":126850,"_5":14884,"_28435":126781,"_3074":126851},[],"Descarga el certificado e inspecciona fechas, emisor, sujeto, SAN, KU y EKU. Comprueba su correspondencia con la clave privada en el sistema de origen.",{"_3697":74834,"_31245":74808,"_21577":126853,"_5":14884,"_28435":126781,"_3074":126854},[],"Instala certificado y cadena en el consumidor previsto y prueba una conexión. Emitir no registra por sí solo un dispositivo ni concede acceso en una integración.",{"_3697":74835,"_31245":74808,"_21577":126856,"_5":14884,"_28435":126781,"_3074":126857},[],"Para generar la clave en el navegador, sigue Emite tu primer certificado.",{"_3697":74836,"_31245":74808,"_21577":126859,"_5":14884,"_28435":126785,"_3074":126860},[],"Revoca cuando la clave se haya comprometido, el sujeto ya no esté autorizado o la identidad deba dejar de aceptarse antes de expirar. Antes de cambiar el estado, identifica los consumidores y prepara la sustitución necesaria.",{"_3697":74837,"_31245":74808,"_21577":126862,"_5":14884,"_28435":126789,"_3074":126863},[],"Localiza emisor y serie correctos y selecciona **Revoke Certificate**. Los registros `EXPIRED` y los revocados por una razón definitiva no admiten posteriores cambios de estado.",{"_3697":74838,"_31245":74808,"_21577":126865,"_5":14884,"_28435":126793,"_3074":126866},[],"Selecciona la razón del incidente. `CertificateHold` representa una suspensión reversible del certificado; las demás razones bloquean cambios posteriores. No uses una suspensión para tratar una clave comprometida.",{"_3697":74839,"_31245":74808,"_21577":126868,"_5":14884,"_28435":126797,"_3074":126869},[],"Guarda el cambio y vuelve a consultar el registro: exige **REVOKED**, razón y fecha. Verifica después una consulta OCSP nueva y, si utilizas CRL, su versión publicada y presencia de la serie. Finalmente, comprueba el rechazo de una conexión nueva en el consumidor.",{"_3697":74840,"_31245":74808,"_21577":126871,"_5":14884,"_28435":126797,"_3074":126872},[],"La revocación no borra el certificado, no elimina la clave ni garantiza cierre de sesiones existentes. El estado y su publicación son pasos distintos.",{"_3697":74841,"_31245":74808,"_21577":126874,"_5":14884,"_28435":126797,"_3074":126875},[],"Un certificado revocado con `CertificateHold` puede reactivarse si no está en estado `EXPIRED`. Sus fechas y la confianza del consumidor siguen siendo obligatorias.",{"_3697":74842,"_31245":74808,"_21577":126877,"_5":14884,"_28435":126801,"_3074":126878},[],"Comprueba que la razón guardada es `CertificateHold` y que la identidad todavía cumple tu política. Solicita `ACTIVE` mediante la operación de actualización de estado que exponga tu instalación; consulta la Referencia API. No supongas que cambiar permisos del consumidor cambia también el estado en Lamassu.",{"_3697":74843,"_31245":74808,"_21577":126880,"_5":14884,"_28435":126801,"_3074":126881},[],"Vuelve a consultar el registro y OCSP. Con `regenerate_on_revoke` habilitado, el evento de reactivación solicita regeneración de la CRL: verifica que la nueva lista omite la serie. Una lista anterior puede seguir marcándola como revocada hasta que el cliente renueve su copia.",{"_3697":74844,"_31245":74808,"_21577":126883,"_5":14884,"_28435":126801,"_3074":126884},[],"Esto no revierte una revocación definitiva ni la cascada de una CA revocada para siempre; la suspensión en cascada desde una CA se levanta reactivando esa CA.",{"_3697":74845,"_31245":74808,"_21577":126886,"_5":14884,"_28435":126805,"_3074":126887},[],"<Card title=\"Validar con OCSP\" description=\"Consulta y verifica el estado firmado de un certificado.\" href=\"/docs/platform/pki/ocsp\" />",{"_3697":74846,"_31245":74808,"_21577":126889,"_5":14884,"_28435":126805,"_3074":126890},[],"<Card title=\"Distribuir una CRL\" description=\"Publica el estado para validación local.\" href=\"/docs/platform/pki/crl\" />",{"_3697":74847,"_31245":74847,"_5":15238,"_3074":126892,"_31570":126893,"_21577":126895,"_28435":74847},"Ciclo de vida de un certificado",[50948,121910,56713,126894],"Conceptos",[],{"_3697":74848,"_31245":74847,"_21577":126897,"_5":14884,"_28435":74847,"_3074":126898},[],"Emisión, uso, renovación, revocación y retirada de certificados en Lamassu.",{"_3697":74849,"_31245":74847,"_5":31567,"_21577":126900,"_28435":126901,"_3074":126902},[],"/docs/es/platform/pki/concepts/certificate-lifecycle#el-recorrido-completo","El recorrido completo",{"_3697":74850,"_31245":74847,"_5":31567,"_21577":126904,"_28435":126905,"_3074":126906},[],"/docs/es/platform/pki/concepts/certificate-lifecycle#solicitud","Solicitud",{"_3697":74851,"_31245":74847,"_5":31567,"_21577":126908,"_28435":126909,"_3074":126910},[],"/docs/es/platform/pki/concepts/certificate-lifecycle#emisión","Emisión",{"_3697":74852,"_31245":74847,"_5":31567,"_21577":126912,"_28435":126913,"_3074":126914},[],"/docs/es/platform/pki/concepts/certificate-lifecycle#uso-y-supervisión","Uso y supervisión",{"_3697":74853,"_31245":74847,"_5":31567,"_21577":126916,"_28435":126917,"_3074":126918},[],"/docs/es/platform/pki/concepts/certificate-lifecycle#renovación-o-re-enrolamiento","Renovación o re-enrolamiento",{"_3697":74854,"_31245":74847,"_5":31567,"_21577":126920,"_28435":126921,"_3074":126922},[],"/docs/es/platform/pki/concepts/certificate-lifecycle#revocación-o-retirada","Revocación o retirada",{"_3697":74855,"_31245":74847,"_5":31567,"_21577":126924,"_28435":126925,"_3074":124592},[],"/docs/es/platform/pki/concepts/certificate-lifecycle#estados-del-certificado",{"_3697":74856,"_31245":74847,"_5":31567,"_21577":126927,"_28435":126928,"_3074":126929},[],"/docs/es/platform/pki/concepts/certificate-lifecycle#renovación-y-revocación-no-son-equivalentes","Renovación y revocación no son equivalentes",{"_3697":74857,"_31245":74847,"_5":31567,"_21577":126931,"_28435":126932,"_3074":126933},[],"/docs/es/platform/pki/concepts/certificate-lifecycle#efecto-de-revocar-una-ca","Efecto de revocar una CA",{"_3697":74858,"_31245":74847,"_5":31567,"_21577":126935,"_28435":126936,"_3074":126937},[],"/docs/es/platform/pki/concepts/certificate-lifecycle#qué-debes-observar","Qué debes observar",{"_3697":74859,"_31245":74847,"_21577":126939,"_5":14884,"_28435":74847,"_3074":126940},[],"Emitir un certificado es solo el comienzo. Durante su vida útil debes comprobar su vigencia, renovarlo antes de que caduque y retirarlo cuando deje de ser fiable. Lamassu conserva el certificado, su CA emisora, su estado y, cuando pertenece a un dispositivo, la identidad a la que está vinculado.",{"_3697":74860,"_31245":74847,"_21577":126942,"_5":14884,"_28435":126905,"_3074":126943},[],"El solicitante genera una clave y una CSR. En los flujos recomendados, la clave privada permanece en el dispositivo, navegador o motor criptográfico que la creó.",{"_3697":74861,"_31245":74847,"_21577":126945,"_5":14884,"_28435":126909,"_3074":126946},[],"La CA firma la CSR. El perfil de emisión determina la validez, los usos, el sujeto, las extensiones admitidas y las restricciones criptográficas.",{"_3697":74862,"_31245":74847,"_21577":126948,"_5":14884,"_28435":126913,"_3074":126949},[],"El certificado queda en estado `ACTIVE`. Lamassu monitoriza su fecha `Not After`; el trabajo de monitorización criptográfica marca como `EXPIRED` los certificados que han vencido.",{"_3697":74863,"_31245":74847,"_21577":126951,"_5":14884,"_28435":126917,"_3074":126952},[],"Se emite un certificado nuevo antes de que caduque el anterior. En un DMS puedes abrir ventanas preventiva y crítica para que el dispositivo se re-enrole mediante EST.",{"_3697":74864,"_31245":74847,"_21577":126954,"_5":14884,"_28435":126921,"_3074":126955},[],"Si la identidad deja de ser fiable, Lamassu registra la razón y la hora de revocación. OCSP y las CRLs permiten que los consumidores conozcan ese estado.",{"_3697":74865,"_31245":74847,"_21577":126957,"_5":14884,"_28435":126925,"_3074":126958},[],"Lamassu persiste cuatro estados X.509:",{"_3697":74866,"_31245":74847,"_21577":126960,"_5":14884,"_28435":126925,"_3074":126961},[],"**`ACTIVE`**: el registro está habilitado. Comprueba además `Not Before` y `Not After`: este estado no demuestra vigencia temporal.",{"_3697":74867,"_31245":74847,"_21577":126963,"_5":14884,"_28435":126925,"_3074":126964},[],"**`EXPIRED`**: ha superado su fecha de expiración. El monitor lo detecta de forma periódica; no es un estado que deba asignarse manualmente.",{"_3697":74868,"_31245":74847,"_21577":126966,"_5":14884,"_28435":126925,"_3074":126967},[],"**`REVOKED`**: fue invalidado antes de expirar, con una razón y una marca temporal.",{"_3697":74869,"_31245":74847,"_21577":126969,"_5":14884,"_28435":126925,"_3074":126970},[],"**`INACTIVE`**: está deshabilitado sin representar una revocación definitiva.",{"_3697":74870,"_31245":74847,"_21577":126972,"_5":14884,"_28435":126925,"_3074":126973},[],"La vista del dispositivo puede añadir estados operativos como ausencia de identidad, renovación pendiente, expiración próxima o baja. Son una interpretación del estado del dispositivo y de sus certificados, no nuevos estados X.509.",{"_3697":74871,"_31245":74847,"_21577":126975,"_5":14884,"_28435":126928,"_3074":126976},[],"La **renovación** crea un certificado sucesor para una identidad que continúa siendo válida. La **revocación** comunica que el certificado actual ya no debe aceptarse. Renueva para mantener continuidad; revoca ante compromiso, retirada o un cambio que invalide la identidad.",{"_3697":74872,"_31245":74847,"_21577":126978,"_5":14884,"_28435":126928,"_3074":126979},[],"Solo `CertificateHold` permite reactivar un certificado revocado que no esté en estado `EXPIRED`. Una revocación con otra razón bloquea posteriores cambios de estado. Los registros `EXPIRED` también rechazan cambios; el consumidor debe comprobar las fechas aunque el monitor todavía no haya actualizado el estado. Certificados explica cómo comprobar revocación y reactivación.",{"_3697":74873,"_31245":74847,"_21577":126981,"_5":14884,"_28435":126928,"_3074":126982},[],"La operación **Reissue CA** genera otro certificado para la misma clave y enlaza ambos números de serie mediante metadatos. No equivale a una rotación de clave. Para cambiar la clave, crea una CA sucesora y realiza una migración con periodo de solapamiento.",{"_3697":74874,"_31245":74847,"_21577":126984,"_5":14884,"_28435":126932,"_3074":126985},[],"Revocar una CA inicia una cascada que intenta revocar sus descendientes. Una cascada con `CertificateHold` los suspende de forma reversible: al reactivar la CA se restauran los que sigan suspendidos. Cualquier otra razón de revocación revoca los descendientes definitivamente con `CessationOfOperation`. Consulta Jerarquía y rotación para sus condiciones y comprobaciones.",{"_3697":74875,"_31245":74847,"_21577":126987,"_5":14884,"_28435":126932,"_3074":126988},[],"Antes de confirmar:",{"_3697":74876,"_31245":74847,"_21577":126990,"_5":14884,"_28435":126932,"_3074":126991},[],"Identifica DMS, dispositivos y servicios que confían en esa cadena.",{"_3697":74877,"_31245":74847,"_21577":126993,"_5":14884,"_28435":126932,"_3074":126994},[],"Distribuye la nueva cadena de confianza.",{"_3697":74878,"_31245":74847,"_21577":126996,"_5":14884,"_28435":126932,"_3074":126997},[],"Reemite las identidades necesarias.",{"_3697":74879,"_31245":74847,"_21577":126999,"_5":14884,"_28435":126932,"_3074":127000},[],"Comprueba OCSP y CRL desde un consumidor real.",{"_3697":74880,"_31245":74847,"_21577":127002,"_5":14884,"_28435":126932,"_3074":127003},[],"Revoca la CA antigua cuando ya no exista tráfico legítimo.",{"_3697":74881,"_31245":74847,"_21577":127005,"_5":14884,"_28435":126932,"_3074":127006},[],"La baja de un dispositivo pertenece al ciclo de vida de IoT Fleets. Afecta a su identidad activa; no equivale a recorrer y revocar automáticamente todos los certificados del historial. Revisa por separado las identidades anteriores y los permisos del consumidor en Gestión de dispositivos.",{"_3697":74882,"_31245":74847,"_21577":127008,"_5":14884,"_28435":126936,"_3074":127009},[],"Certificados que entran en la ventana preventiva o crítica de renovación.",{"_3697":74883,"_31245":74847,"_21577":127011,"_5":14884,"_28435":126936,"_3074":127012},[],"Errores repetidos de enrolamiento o re-enrolamiento.",{"_3697":74884,"_31245":74847,"_21577":127014,"_5":14884,"_28435":126936,"_3074":127015},[],"Cambios de estado y razones de revocación.",{"_3697":74885,"_31245":74847,"_21577":127017,"_5":14884,"_28435":126936,"_3074":127018},[],"Publicación y vigencia de OCSP y CRLs.",{"_3697":74886,"_31245":74847,"_21577":127020,"_5":14884,"_28435":126936,"_3074":127021},[],"Dependencias que todavía presentan un certificado sustituido.",{"_3697":74887,"_31245":74847,"_21577":127023,"_5":14884,"_28435":126936,"_3074":127024},[],"El historial del dispositivo relaciona sus identidades anteriores y actuales. Para cambios administrativos y errores de mutación, consulta Registros de auditoría.",{"_3697":74888,"_31245":74888,"_5":15238,"_3074":127026,"_31570":127027,"_21577":127028,"_28435":74888},"Modelo de confianza",[50948,121910,56713,126894],[],{"_3697":74889,"_31245":74888,"_21577":127030,"_5":14884,"_28435":74888,"_3074":127031},[],"Entiende dónde nace la confianza, cómo se distribuye y qué valida cada componente.",{"_3697":74890,"_31245":74888,"_5":31567,"_21577":127033,"_28435":127034,"_3074":127035},[],"/docs/es/platform/pki/concepts/trust-model#las-cuatro-decisiones-de-confianza","Las cuatro decisiones de confianza",{"_3697":74891,"_31245":74888,"_5":31567,"_21577":127037,"_28435":127038,"_3074":127039},[],"/docs/es/platform/pki/concepts/trust-model#quién-puede-emitir","Quién puede emitir",{"_3697":74892,"_31245":74888,"_5":31567,"_21577":127041,"_28435":127042,"_3074":127043},[],"/docs/es/platform/pki/concepts/trust-model#qué-puede-emitirse","Qué puede emitirse",{"_3697":74893,"_31245":74888,"_5":31567,"_21577":127045,"_28435":127046,"_3074":127047},[],"/docs/es/platform/pki/concepts/trust-model#quién-puede-solicitarlo","Quién puede solicitarlo",{"_3697":74894,"_31245":74888,"_5":31567,"_21577":127049,"_28435":127050,"_3074":127051},[],"/docs/es/platform/pki/concepts/trust-model#quién-acepta-el-resultado","Quién acepta el resultado",{"_3697":74895,"_31245":74888,"_5":31567,"_21577":127053,"_28435":127054,"_3074":127055},[],"/docs/es/platform/pki/concepts/trust-model#flujo-de-una-identidad","Flujo de una identidad",{"_3697":74896,"_31245":74888,"_5":31567,"_21577":127057,"_28435":127058,"_3074":127059},[],"/docs/es/platform/pki/concepts/trust-model#cas-de-enrolamiento-validación-y-distribución","CAs de enrolamiento, validación y distribución",{"_3697":74897,"_31245":74888,"_5":31567,"_21577":127061,"_28435":127062,"_3074":127063},[],"/docs/es/platform/pki/concepts/trust-model#validación-y-revocación","Validación y revocación",{"_3697":74898,"_31245":74888,"_5":31567,"_21577":127065,"_28435":127066,"_3074":127067},[],"/docs/es/platform/pki/concepts/trust-model#límites-de-custodia","Límites de custodia",{"_3697":74899,"_31245":74888,"_5":31567,"_21577":127069,"_28435":127070,"_3074":127071},[],"/docs/es/platform/pki/concepts/trust-model#patrón-recomendado","Patrón recomendado",{"_3697":74900,"_31245":74888,"_21577":127073,"_5":14884,"_28435":74888,"_3074":127074},[],"En Lamassu, confianza no significa simplemente que un certificado exista en el inventario. Un consumidor confía en una identidad cuando puede construir una cadena hasta una raíz que reconoce, comprobar que el certificado sirve para el uso esperado y verificar que sigue vigente.",{"_3697":74901,"_31245":74888,"_21577":127076,"_5":14884,"_28435":127038,"_3074":127077},[],"La jerarquía de CAs define qué autoridades pueden firmar. Una CA raíz establece el ancla de confianza; las CAs intermedias separan ámbitos operativos y evitan utilizar la raíz para cada emisión.",{"_3697":74902,"_31245":74888,"_21577":127079,"_5":14884,"_28435":127042,"_3074":127080},[],"Los perfiles de certificado limitan validez, sujeto, usos, extensiones y parámetros criptográficos. La posesión de una CA no sustituye a una política de emisión.",{"_3697":74903,"_31245":74888,"_21577":127082,"_5":14884,"_28435":127046,"_3074":127083},[],"El DMS actúa como punto de enrolamiento. Puede autenticar una solicitud EST con certificado cliente, webhook externo o una combinación de ambos. Las CAs configuradas para validar al solicitante no tienen por qué ser la CA que emitirá la identidad nueva.",{"_3697":74904,"_31245":74888,"_21577":127085,"_5":14884,"_28435":127050,"_3074":127086},[],"El consumidor mantiene su propio almacén de confianza. EST `/cacerts` puede distribuir el certificado TLS del servicio, la CA de enrolamiento y CAs gestionadas seleccionadas. La confianza inicial para autenticar ese servicio debe proceder de un canal ya confiable. Descarga e inspecciona el contenido: no asumas que es una cadena completa ni instales todas las entradas como raíces.",{"_3697":74905,"_31245":74888,"_21577":127088,"_5":14884,"_28435":127054,"_3074":127089},[],"El dispositivo demuestra que puede enrolarse según la política del DMS.",{"_3697":74906,"_31245":74888,"_21577":127091,"_5":14884,"_28435":127054,"_3074":127092},[],"El DMS valida la solicitud y remite la CSR a la CA de enrolamiento.",{"_3697":74907,"_31245":74888,"_21577":127094,"_5":14884,"_28435":127054,"_3074":127095},[],"En el flujo con CSR generado en el dispositivo, la CA aplica el perfil y firma sin recibir su clave privada.",{"_3697":74908,"_31245":74888,"_21577":127097,"_5":14884,"_28435":127054,"_3074":127098},[],"El dispositivo instala el certificado y la cadena que necesita.",{"_3697":74909,"_31245":74888,"_21577":127100,"_5":14884,"_28435":127054,"_3074":127101},[],"El sistema que confía en el dispositivo valida cadena, fechas, usos y estado de revocación.",{"_3697":74910,"_31245":74888,"_21577":127103,"_5":14884,"_28435":127054,"_3074":127104},[],"OIDC o X.509 identifica al operador que llama a Lamassu. El servicio de autorización decide qué acciones puede realizar. La jerarquía X.509, en cambio, determina si un certificado presentado por un dispositivo es confiable.",{"_3697":74911,"_31245":74888,"_21577":127106,"_5":14884,"_28435":127058,"_3074":127107},[],"Un DMS relaciona tres conjuntos que conviene diseñar por separado:",{"_3697":74912,"_31245":74888,"_21577":127109,"_5":14884,"_28435":127058,"_3074":127110},[],"**CA de enrolamiento:** firma las nuevas identidades.",{"_3697":74913,"_31245":74888,"_21577":127112,"_5":14884,"_28435":127058,"_3074":127113},[],"**CAs de validación:** autentican certificados cliente usados para enrolamiento o migración. En re-enrolamiento, la CA de enrolamiento siempre es confiable y Lamassu prueba después las CAs de validación configuradas en el bloque de re-enrolamiento; estas son opcionales.",{"_3697":74914,"_31245":74888,"_21577":127115,"_5":14884,"_28435":127058,"_3074":127116},[],"**CAs distribuidas:** forman el contenido que el dispositivo obtiene mediante EST `/cacerts`. Puedes incluir el certificado TLS del servicio, la CA de enrolamiento y una lista explícita de CAs gestionadas. Incluir la CA emisora no añade automáticamente todos sus ascendientes.",{"_3697":74915,"_31245":74888,"_21577":127118,"_5":14884,"_28435":127058,"_3074":127119},[],"Esta separación permite migrar una flota: aceptas temporalmente certificados de la jerarquía anterior, emites con la nueva y distribuyes ambas cadenas durante el solapamiento.",{"_3697":74916,"_31245":74888,"_21577":127121,"_5":14884,"_28435":127062,"_3074":127122},[],"Una cadena válida no garantiza por sí sola que el certificado deba aceptarse. El consumidor también debe comprobar:",{"_3697":74917,"_31245":74888,"_21577":127124,"_5":14884,"_28435":127062,"_3074":127125},[],"que la fecha actual está entre `Not Before` y `Not After`;",{"_3697":74918,"_31245":74888,"_21577":127127,"_5":14884,"_28435":127062,"_3074":127128},[],"que `Key Usage` y `Extended Key Usage` permiten la operación;",{"_3697":74919,"_31245":74888,"_21577":127130,"_5":14884,"_28435":127062,"_3074":127131},[],"que nombres, SANs y sujeto coinciden con la identidad esperada;",{"_3697":74920,"_31245":74888,"_21577":127133,"_5":14884,"_28435":127062,"_3074":127134},[],"que el certificado no aparece revocado mediante OCSP o una CRL.",{"_3697":74921,"_31245":74888,"_21577":127136,"_5":14884,"_28435":127062,"_3074":127137},[],"El estado `Good` de OCSP tampoco sustituye la comprobación de cadena, fechas, uso e identidad; Validación reúne esos criterios.",{"_3697":74922,"_31245":74888,"_21577":127139,"_5":14884,"_28435":127062,"_3074":127140},[],"Durante la autenticación mTLS de un DMS, Lamassu comprueba la revocación y falla cerrada: un certificado cuya revocación no puede verificarse se rechaza por defecto. La opción `allow_unverifiable_revocation` del DMS (consulta DMS) es la excepción, y solo relaja los certificados que no llevan ningún endpoint OCSP/CRL. Diseña los perfiles y puntos de distribución para que la comprobación tenga éxito.",{"_3697":74923,"_31245":74888,"_21577":127142,"_5":14884,"_28435":127066,"_3074":127143},[],"El KMS conserva la referencia de la clave y delega la operación al motor configurado. Con un HSM o un KMS cloud, la clave privada puede permanecer no exportable. Eso protege la custodia, pero no impide por sí solo el uso indebido: todavía debes restringir quién puede ordenar una firma y auditar esas operaciones.",{"_3697":74924,"_31245":74888,"_21577":127145,"_5":14884,"_28435":127070,"_3074":127146},[],"Mantén la raíz fuera de las operaciones diarias o con acceso muy restringido.",{"_3697":74925,"_31245":74888,"_21577":127148,"_5":14884,"_28435":127070,"_3074":127149},[],"Emite desde CAs intermedias separadas por entorno o dominio de riesgo.",{"_3697":74926,"_31245":74888,"_21577":127151,"_5":14884,"_28435":127070,"_3074":127152},[],"Asigna perfiles explícitos a cada caso de uso.",{"_3697":74927,"_31245":74888,"_21577":127154,"_5":14884,"_28435":127070,"_3074":127155},[],"Distribuye la nueva confianza antes de comenzar una rotación.",{"_3697":74928,"_31245":74888,"_21577":127157,"_5":14884,"_28435":127070,"_3074":127158},[],"Mantén solapamiento suficiente para renovar una flota desconectada.",{"_3697":74929,"_31245":74888,"_21577":127160,"_5":14884,"_28435":127070,"_3074":127161},[],"Valida desde el sistema consumidor, no solo desde la consola de Lamassu.",{"_3697":74930,"_31245":74888,"_21577":127163,"_5":14884,"_28435":127070,"_3074":127164},[],"Continúa con Jerarquía y rotación de CAs para convertir este modelo en un procedimiento operativo.",{"_3697":74931,"_31245":74931,"_5":15238,"_3074":127166,"_31570":127167,"_21577":127168,"_28435":74931},"Listas de revocación (CRL)",[50948,121910,56713,126640],[],{"_3697":74932,"_31245":74931,"_21577":127170,"_5":14884,"_28435":74931,"_3074":127171},[],"Genera y distribuye listas firmadas para validar certificados sin conexión.",{"_3697":74933,"_31245":74931,"_5":31567,"_21577":127173,"_28435":127174,"_3074":127175},[],"/docs/es/platform/pki/crl#ajustes-de-crl","Ajustes de CRL",{"_3697":74934,"_31245":74931,"_5":31567,"_21577":127177,"_28435":127178,"_3074":127179},[],"/docs/es/platform/pki/crl#cas-que-comparten-clave","CAs que comparten clave",{"_3697":74935,"_31245":74931,"_5":31567,"_21577":127181,"_28435":127182,"_3074":127183},[],"/docs/es/platform/pki/crl#regeneración-periódica-y-automática","Regeneración periódica y automática",{"_3697":74936,"_31245":74931,"_5":31567,"_21577":127185,"_28435":127186,"_3074":127187},[],"/docs/es/platform/pki/crl#contenido-de-la-crl","Contenido de la CRL",{"_3697":74937,"_31245":74931,"_5":31567,"_21577":127189,"_28435":127190,"_3074":127191},[],"/docs/es/platform/pki/crl#endpoint-público-de-descarga","Endpoint público de descarga",{"_3697":74938,"_31245":74931,"_5":31567,"_21577":127193,"_28435":127194,"_3074":127195},[],"/docs/es/platform/pki/crl#api-de-gestión-de-los-ajustes-de-crl","API de gestión de los ajustes de CRL",{"_3697":74939,"_31245":74931,"_5":31567,"_21577":127197,"_28435":127198,"_3074":127199},[],"/docs/es/platform/pki/crl#errores-frecuentes-de-los-ajustes-de-crl","Errores frecuentes de los ajustes de CRL",{"_3697":74940,"_31245":74931,"_5":31567,"_21577":127201,"_28435":127202,"_3074":127203},[],"/docs/es/platform/pki/crl#referencias","Referencias",{"_3697":74941,"_31245":74931,"_21577":127205,"_5":14884,"_28435":74931,"_3074":127206},[],"Una CRL es una lista firmada de certificados revocados por un emisor. Esta guía sirve al operador que publica listas y al integrador que las utiliza localmente. Necesitas el certificado de la CA emisora, su ID de CA y acceso al endpoint publicado. El cliente debe mantener una copia vigente: funcionar offline no elimina la necesidad de renovar la evidencia.",{"_3697":74942,"_31245":74931,"_21577":127208,"_5":14884,"_28435":127174,"_3074":127209},[],"Los ajustes de CRL de una CA guardan la configuración y los metadatos de su última lista publicada. Cada CA tiene los suyos, indexados por su ID de CA — incluso cuando dos CAs comparten clave: comparten el SKI, no la CRL. La VA los crea al crear una CA; al importar una CA cuya clave está en el KMS — importada con la clave privada, o que el KMS ya tenía — y cuyo certificado incluye `cRLSign`: esa CA publica su primera CRL de inmediato, igual que una creada; y al reemitir una CA sin ajustes con un certificado que pueda firmar CRLs. Una CA importada cuya clave no está en el KMS, o cuyo certificado carece de `cRLSign`, no recibe ajustes: la importación termina sin error, y los endpoints de CRL de la CA informan de que faltan los ajustes. Los ajustes nunca se crean retroactivamente: una CA que no los tiene se queda sin ellos hasta que se reemita. La generación requiere una clave emisora utilizable; no presupongas que una CA importada sin clave tiene una CRL disponible.",{"_3697":74943,"_31245":74931,"_21577":127211,"_5":14884,"_28435":127174,"_3074":123759},[],{"_3697":74944,"_31245":74931,"_21577":127213,"_5":14884,"_28435":127174,"_3074":124254},[],{"_3697":74945,"_31245":74931,"_21577":127215,"_5":14884,"_28435":127174,"_3074":52609},[],{"_3697":74946,"_31245":74931,"_21577":127217,"_5":14884,"_28435":127174,"_3074":127218},[],"ID de la CA a la que pertenecen los ajustes.",{"_3697":74947,"_31245":74931,"_21577":127220,"_5":14884,"_28435":127174,"_3074":57969},[],{"_3697":74948,"_31245":74931,"_21577":127222,"_5":14884,"_28435":127174,"_3074":127223},[],"Ciclo de vida de los ajustes. Los `ACTIVE` generan CRLs. Los `FINAL` pertenecen a una CA revocada de forma permanente o caducada: la primera publica una CRL final, válida hasta que expire el certificado actual de la CA, y la segunda pasa a `FINAL` sin CRL final. Los `ARCHIVED` pertenecen a una CA eliminada: su última CRL sigue sirviéndose, pero nunca se regenera.",{"_3697":74949,"_31245":74931,"_21577":127225,"_5":14884,"_28435":127174,"_3074":57975},[],{"_3697":74950,"_31245":74931,"_21577":127227,"_5":14884,"_28435":127174,"_3074":127228},[],"Solo lectura. SKI por el que los ajustes estaban indexados antes de la migración de 4.0.0; solo lo tienen los migrados, y `/crl/<ski>` sigue resolviendo a ellos.",{"_3697":74951,"_31245":74931,"_21577":127230,"_5":14884,"_28435":127174,"_3074":57981},[],{"_3697":74952,"_31245":74931,"_21577":127232,"_5":14884,"_28435":127174,"_3074":127233},[],"Versión, inicio y fin de validez de la última lista publicada. Solo lectura.",{"_3697":74953,"_31245":74931,"_21577":127235,"_5":14884,"_28435":127174,"_3074":127236},[],"Campo de `crl_options`",{"_3697":74954,"_31245":74931,"_21577":127238,"_5":14884,"_28435":127174,"_3074":124254},[],{"_3697":74955,"_31245":74931,"_21577":127240,"_5":14884,"_28435":127174,"_3074":127241},[],"Valor inicial",{"_3697":74956,"_31245":74931,"_21577":127243,"_5":14884,"_28435":127174,"_3074":57995},[],{"_3697":74957,"_31245":74931,"_21577":127245,"_5":14884,"_28435":127174,"_3074":127246},[],"Tiempo desde `thisUpdate` hasta `nextUpdate`.",{"_3697":74958,"_31245":74931,"_21577":127248,"_5":14884,"_28435":127174,"_3074":127249},[],"7 días.",{"_3697":74959,"_31245":74931,"_21577":127251,"_5":14884,"_28435":127174,"_3074":58004},[],{"_3697":74960,"_31245":74931,"_21577":127253,"_5":14884,"_28435":127174,"_3074":127254},[],"Tiempo desde la emisión de la última CRL publicada que activa la renovación programada; `0` desactiva solo este disparador. La granularidad efectiva está limitada por la frecuencia del job (consulta Regeneración periódica y automática).",{"_3697":74961,"_31245":74931,"_21577":127256,"_5":14884,"_28435":127174,"_3074":127257},[],"6 días y 23 horas.",{"_3697":74962,"_31245":74931,"_21577":127259,"_5":14884,"_28435":127174,"_3074":58013},[],{"_3697":74963,"_31245":74931,"_21577":127261,"_5":14884,"_28435":127174,"_3074":127262},[],"Solicitar regeneración por eventos de revocación o reactivación desde `CertificateHold`.",{"_3697":74964,"_31245":74931,"_21577":127264,"_5":14884,"_28435":127174,"_3074":58019},[],{"_3697":74965,"_31245":74931,"_21577":127266,"_5":14884,"_28435":127174,"_3074":58022},[],{"_3697":74966,"_31245":74931,"_21577":127268,"_5":14884,"_28435":127174,"_3074":127269},[],"Número de serie del certificado existente que firma la CRL.",{"_3697":74967,"_31245":74931,"_21577":127271,"_5":14884,"_28435":127174,"_3074":127272},[],"Número de serie del certificado actual de la CA.",{"_3697":74968,"_31245":74931,"_21577":127274,"_5":14884,"_28435":127174,"_3074":127275},[],"El firmante debe ser un certificado existente con el uso `cRLSign`, el mismo sujeto y la misma clave pública que la CA. Quedan incluidos los certificados anteriores a una reemisión. No se admite un firmante delegado: un certificado con el sujeto de la CA pero con otra clave se rechaza.",{"_3697":74969,"_31245":74931,"_21577":127277,"_5":14884,"_28435":127174,"_3074":127278},[],"Al reemitir una CA, si el firmante es el certificado de la CA sustituido, la VA lo mueve al certificado nuevo — siempre que incluya `cRLSign` — y republica la CRL. Si el certificado nuevo carece de `cRLSign`, la VA mantiene el firmante anterior y registra un aviso. Si el firmante es cualquier otro certificado con el sujeto y la clave de la CA, se deja deliberadamente sin cambios; en ese caso el certificado anterior no puede eliminarse mientras los ajustes lo usen (la API devuelve `409` `certificate is in use`), y para retirarlo actualizas el firmante con `PUT`.",{"_3697":74970,"_31245":74931,"_21577":127280,"_5":14884,"_28435":127174,"_3074":127281},[],"Las decisiones del ciclo de vida de la CRL — cuándo deja de publicarse y cuándo expira la CRL final — usan únicamente el certificado actual de la CA. Si un certificado reemitido expira antes que un certificado antiguo que sigue vigente, la publicación de CRLs puede detenerse, o la CRL final puede expirar, mientras el certificado antiguo siga vigente. Es una limitación aceptada del comportamiento actual.",{"_3697":74971,"_31245":74931,"_21577":127283,"_5":14884,"_28435":127174,"_3074":127284},[],"Una CA cuyo firmante no tiene `cRLSign` no puede generar su CRL, y una actualización que seleccione un firmante sin `cRLSign` se rechaza (error 400). Desde 4.0 la VA exige este uso. Comprueba antes de importar con `openssl x509 -noout -ext keyUsage` y, si falta, obtén un certificado de la misma CA y clave que lo incluya y actualiza los ajustes para usarlo como firmante. Una CA que no tiene ajustes — por ejemplo, una importada sin `cRLSign` — no tiene nada que actualizar: la única vía para obtenerlos es reemitir la CA con un certificado que incluya `cRLSign`. Tras reemitir una CA, comprueba también el uso de clave del certificado nuevo: puede no conservar los usos del original, y sin `cRLSign` los ajustes conservan su firmante anterior.",{"_3697":74972,"_31245":74931,"_21577":127286,"_5":14884,"_28435":127174,"_3074":127287},[],"Eliminar una CA conserva sus ajustes de CRL; permanecen hasta que borres los archivados por API o desde la página Verification Authorities de la consola (consulta API de gestión de los ajustes de CRL). Lo que ocurre con ellos depende de cómo terminó la CA:",{"_3697":74973,"_31245":74931,"_21577":127289,"_5":14884,"_28435":127174,"_3074":127290},[],"La migración de la actualización a 4.0.0 archiva los ajustes de las CAs que se habían eliminado antes de la actualización. Su `status` es `ARCHIVED` y su `ca_id` es `legacy-<ski>`: la última CRL sigue sirviéndose, pero nunca se regenera, cualquier `PUT` devuelve 409 y no hay forma de volver a `ACTIVE` por API.",{"_3697":74974,"_31245":74931,"_21577":127292,"_5":14884,"_28435":127174,"_3074":127293},[],"Revocar una CA de forma permanente o dejar que caduque finaliza sus ajustes: su `status` pasa a `FINAL`, cualquier `PUT` devuelve 409 y no se genera ninguna CRL nueva. Una CA revocada permanentemente publica una CRL final, válida hasta que expire el certificado actual de la CA; una CA caducada no recibe ninguna. Eliminar después la CA archiva sus ajustes, que pasan a comportarse como los archivados de la migración.",{"_3697":74975,"_31245":74931,"_21577":127295,"_5":14884,"_28435":127174,"_3074":127296},[],"Los ajustes dejan de poder editarse mientras su `status` no sea `ACTIVE`. Ajusta validez y firmante antes de revocar o eliminar una CA.",{"_3697":74976,"_31245":74931,"_21577":127298,"_5":14884,"_28435":127174,"_3074":127299},[],"El `PUT` valida el firmante solo cuando la petición lo cambia. Si el firmante guardado ya no es válido, las demás opciones siguen editándose, pero la CRL no puede regenerarse hasta asignar uno válido.",{"_3697":74977,"_31245":74931,"_21577":127301,"_5":14884,"_28435":127174,"_3074":127302},[],"Compartir una clave entre CAs bloquea la migración: la actualización a 4.0.0 aborta mientras un SKI pertenezca a más de una CA. Consulta CAs que comparten clave.",{"_3697":74978,"_31245":74931,"_21577":127304,"_5":14884,"_28435":127174,"_3074":127305},[],"Las versiones de las CRLs se conservan en el almacenamiento de objetos como PEM bajo `pki/va/crl/<ca-id>/<version>.crl`; el endpoint público entrega DER. Las CRLs publicadas antes de la actualización a 4.0.0 permanecen bajo `pki/va/crl/<ski>/<version>.crl` y siguen sirviéndose.",{"_3697":74979,"_31245":74931,"_21577":127307,"_5":14884,"_28435":127178,"_3074":127308},[],"Desde 4.0.0, cada CA publica su propia CRL aunque comparta clave: dos CAs con la misma clave tienen el mismo SKI, pero cada una tiene sus propios ajustes de CRL y su propia lista, firmada por un certificado con la identidad de esa CA.",{"_3697":74980,"_31245":74931,"_21577":127310,"_5":14884,"_28435":127178,"_3074":127311},[],"Los certificados emitidos a partir de ahora llevan puntos de distribución `/crl/<ca-id>`, así que los certificados de cada CA resuelven a su propia lista. Los certificados emitidos antes de la actualización conservan sus puntos de distribución `/crl/<ski>`: esa URL sigue resolviendo a los ajustes que migró la actualización y sirve siempre la lista de la CA propietaria de ese SKI cuando se ejecutó la actualización. Nunca se reasigna a una CA creada después con la misma clave. Tras la regeneración, la lista migrada incluye ambas URLs en su *Issuing Distribution Point* (OID `2.5.29.28`), de modo que un verificador que compara el IDP con el CDP del certificado acepta cualquiera de las dos formas. Hasta que el job de CRL de la VA la regenere correctamente, la lista anterior a la actualización solo contiene el IDP heredado `/crl/<ski>`; los verificadores que comprueban el IDP no pueden validar los certificados recién emitidos con CDP `/crl/<ca-id>`. Con la frecuencia predeterminada, la primera ejecución puede tardar hasta aproximadamente una hora y los fallos pueden prolongar ese intervalo.",{"_3697":74981,"_31245":74931,"_21577":127313,"_5":14884,"_28435":127178,"_3074":127314},[],"Compartir un SKI entre CAs bloquea la actualización: la migración aborta y nombra los SKIs. Para detectar el problema antes de actualizar, compara el SKI de las CAs en el inventario: dos con el mismo SKI están afectadas. Para resolverlo, crea una CA con clave propia y reemite sus certificados; los ya emitidos conservan la URL antigua y no se corrigen hasta reemitirlos.",{"_3697":74982,"_31245":74931,"_21577":127316,"_5":14884,"_28435":127178,"_3074":127317},[],"Lamassu toma el SKI del certificado importado tal cual y no comprueba que corresponda a su clave pública. Hasta que Lamassu rechace las importaciones cuyo SKI colisione con el de una CA existente — rechazo propuesto en lamassuiot#834, junto con la CRL por CA que 4.0.0 implementa —, limita el permiso de importar CAs como control provisional; cubre solo la vía de importación. Crear una CA con &#x2A;*Create New CA (Existing Key)** sobre una clave KMS que otra CA ya usa produce la misma colisión de SKI, así que evita reutilizar claves entre CAs.",{"_3697":74983,"_31245":74931,"_21577":127319,"_5":14884,"_28435":127182,"_3074":127320},[],"El job de la VA revisa los ajustes de CRL de todas las CA en cada ejecución y solicita una lista nueva cuando se cumple alguna de estas condiciones:",{"_3697":74984,"_31245":74931,"_21577":127322,"_5":14884,"_28435":127182,"_3074":127323},[],"**La lista está a punto de vencer:** a `latest_crl` le queda menos validez que el intervalo entre ejecuciones del trabajo. Esta condición se aplica siempre y no puede desactivarse.",{"_3697":74985,"_31245":74931,"_21577":127325,"_5":14884,"_28435":127182,"_3074":127326},[],"**Ha transcurrido el intervalo de renovación:** el tiempo desde la emisión de la última CRL publicada alcanza `refresh_interval`. Con `refresh_interval` a `0` se desactiva solo esta condición; la lista se sigue regenerando cuando está a punto de vencer.",{"_3697":74986,"_31245":74931,"_21577":127328,"_5":14884,"_28435":127182,"_3074":127329},[],"Poner `refresh_interval` a `0` no congela, por tanto, la regeneración. Con la validez por defecto de 7 días y un trabajo cada hora, la CRL se renueva hasta una hora antes de vencer aunque `refresh_interval` sea `0`. Como el trabajo se ejecuta según su propia planificación, el `refresh_interval` se respeta solo con la precisión que permita la frecuencia del job.",{"_3697":74987,"_31245":74931,"_21577":127331,"_5":14884,"_28435":127182,"_3074":127332},[],"La frecuencia del trabajo se configura en Helm con `services.va.job.crl.frequency` (por defecto `0 * * * *`) y admite una duración (`1h`) o una expresión cron. Una expresión cron se convierte en un intervalo constante igual al tiempo que falta para su siguiente disparo cuando arranca el servicio, así que no se alinea con el reloj. Mantén `validity` claramente por encima de ese intervalo: con una validez menor, la lista se regenera en cada ciclo.",{"_3697":74988,"_31245":74931,"_21577":127334,"_5":14884,"_28435":127182,"_3074":127335},[],"Si la generación falla (por ejemplo, porque no puede resolver la CA o el firmante es inválido), el trabajo registra el aviso `something went wrong while calculating CRL for CA <ca-id>` y lo reintenta en el ciclo siguiente. No hay otra vía de renovación hasta corregir la causa, y la última lista publicada se sigue sirviendo hasta vencer. Todo ello depende de que el trabajo, el almacenamiento y la firma funcionen.",{"_3697":74989,"_31245":74931,"_21577":127337,"_5":14884,"_28435":127182,"_3074":127338},[],"Los ajustes con `status` distinto de `ACTIVE` — `FINAL` o `ARCHIVED` — se omiten: nada regenera su CRL.",{"_3697":74990,"_31245":74931,"_21577":127340,"_5":14884,"_28435":127182,"_3074":127341},[],"Con `regenerate_on_revoke`, el manejador de eventos solicita una nueva CRL cuando recibe una revocación o la reactivación de un certificado desde `CertificateHold` a `ACTIVE`. Es un paso posterior al cambio de estado, con sus propios posibles errores: si falla la generación (por ejemplo, por un firmante inválido), el evento se reintenta y, agotados los reintentos, pasa a la cola de eventos fallidos. Si la CA emisora no tiene ajustes de CRL, no hay CRL que regenerar: el evento se da por atendido sin reintento, la VA registra un aviso y no aparece nada en la cola de eventos fallidos. Confirmar la revocación no demuestra que la CRL nueva ya esté publicada ni que todos los clientes la hayan descargado.",{"_3697":74991,"_31245":74931,"_21577":127343,"_5":14884,"_28435":127182,"_3074":127344},[],"Comprueba el número de CRL y sus tiempos antes y después del cambio. Supervisa listas vencidas y fallos de generación; los clientes deben aplicar su política cuando no disponen de evidencia vigente.",{"_3697":74992,"_31245":74931,"_21577":127346,"_5":14884,"_28435":127186,"_3074":127347},[],"Cada entrada incluye serie, fecha de revocación y razón. El generador consulta certificados en estado `REVOKED` para la CA seleccionada. Un certificado reactivado deja de aparecer al recalcular la lista; una copia descargada anteriormente conserva su contenido.",{"_3697":74993,"_31245":74931,"_21577":127349,"_5":14884,"_28435":127186,"_3074":127350},[],"Cuando la VA tiene dominios configurados, la lista incluye un *Issuing Distribution Point* crítico (OID `2.5.29.28`) con esas URLs de distribución; una VA sin dominios configurados publica la lista sin IDP, y una CRL sin IDP cubre todos los certificados de su CA. Cuando la extensión está presente, comprueba que tu cliente la interpreta y que corresponde al ámbito de la lista. Si la rechaza, investiga el formato y el alcance; ignorar una extensión crítica no es una validación satisfactoria.",{"_3697":74994,"_31245":74931,"_21577":127352,"_5":14884,"_28435":127190,"_3074":127353},[],"El servicio VA expone `GET /crl/{id}` sin autorización de gestión. Usa el **ID de la CA emisora**, no el ID ni el número de serie del certificado final. Los certificados emitidos antes de la actualización a 4.0.0 llevan URLs `/crl/<ski>` con el SKI de la clave de la CA; esa forma sigue resolviendo. Inspecciona primero el CDP del certificado:",{"_3697":74995,"_31245":74931,"_21577":127355,"_5":14884,"_28435":127190,"_3074":127356},[],"Sustituye la URL siguiente por la del CDP y revisa la exposición en Despliegue:",{"_3697":74996,"_31245":74931,"_21577":127358,"_5":14884,"_28435":127190,"_3074":127359},[],"Necesitas OpenSSL 3.x e `issuer.pem` con el certificado del emisor directo. Un certificado firmante aceptado tiene el mismo sujeto y la misma clave pública que la CA, por lo que esta comprobación de firma también funciona cuando los ajustes apuntan a un certificado anterior de esa CA y clave. Exige firma válida, tiempos vigentes y emisor esperado. Para una prueba con una raíz que emite directamente:",{"_3697":74997,"_31245":74931,"_21577":127361,"_5":14884,"_28435":127190,"_3074":127362},[],"`roots.pem` contiene las raíces deliberadamente confiables. Si hay intermedias, añade `-untrusted intermediates.pem` antes del argumento `device.crt`. `-crl_check` comprueba la revocación del certificado final usando la lista local; no descarga otras listas ni demuestra el estado de toda la cadena. Para comprobarla completa, necesitas las CRL correspondientes y una política que las exija.",{"_3697":74998,"_31245":74931,"_21577":127364,"_5":14884,"_28435":127190,"_3074":127365},[],"La prueba debe aceptar un certificado permitido que no esté en la lista y rechazarlo con `certificate revoked` después de publicar y utilizar la lista que contiene su serie.",{"_3697":74999,"_31245":74931,"_21577":127367,"_5":14884,"_28435":127194,"_3074":127368},[],"Los paths siguientes son relativos al servicio VA; el prefijo público debe confirmarse en el Gateway. No son las URLs de los endpoints públicos de OCSP y CRL.",{"_3697":75000,"_31245":74931,"_21577":127370,"_5":14884,"_28435":127194,"_3074":123679},[],{"_3697":75001,"_31245":74931,"_21577":127372,"_5":14884,"_28435":127194,"_3074":127373},[],"Path relativo",{"_3697":75002,"_31245":74931,"_21577":127375,"_5":14884,"_28435":127194,"_3074":121670},[],{"_3697":75003,"_31245":74931,"_21577":127377,"_5":14884,"_28435":127194,"_3074":58134},[],{"_3697":75004,"_31245":74931,"_21577":127379,"_5":14884,"_28435":127194,"_3074":58137},[],{"_3697":75005,"_31245":74931,"_21577":127381,"_5":14884,"_28435":127194,"_3074":127382},[],"Listar los ajustes de CRL; filtrable al menos por `ca_id`, `status` y `legacy_ski`.",{"_3697":75006,"_31245":74931,"_21577":127384,"_5":14884,"_28435":127194,"_3074":58134},[],{"_3697":75007,"_31245":74931,"_21577":127386,"_5":14884,"_28435":127194,"_3074":58145},[],{"_3697":75008,"_31245":74931,"_21577":127388,"_5":14884,"_28435":127194,"_3074":127389},[],"Consultar los `crl_options` y `latest_crl` de una CA.",{"_3697":75009,"_31245":74931,"_21577":127391,"_5":14884,"_28435":127194,"_3074":58151},[],{"_3697":75010,"_31245":74931,"_21577":127393,"_5":14884,"_28435":127194,"_3074":58145},[],{"_3697":75011,"_31245":74931,"_21577":127395,"_5":14884,"_28435":127194,"_3074":127396},[],"Sustituir la configuración de CRL de una CA.",{"_3697":75012,"_31245":74931,"_21577":127398,"_5":14884,"_28435":127194,"_3074":58159},[],{"_3697":75013,"_31245":74931,"_21577":127400,"_5":14884,"_28435":127194,"_3074":58145},[],{"_3697":75014,"_31245":74931,"_21577":127402,"_5":14884,"_28435":127194,"_3074":127403},[],"Eliminar los ajustes de CRL archivados de una CA.",{"_3697":75015,"_31245":74931,"_21577":127405,"_5":14884,"_28435":127194,"_3074":127406},[],"Necesitas autenticación y permisos de lectura, actualización o borrado de los ajustes de CRL. Consulta la Referencia API y el control de acceso de tu instalación. Lee la configuración actual antes de actualizarla y envía el objeto completo esperado por el contrato — `refresh_interval`, `validity`, `signer_serial_number` y `regenerate_on_revoke`: el backend sustituye los cuatro; no fusiona campos omitidos. `status`, `legacy_ski` y `latest_crl` son de solo lectura. Un `PUT` devuelve 409 cuando los ajustes no están `ACTIVE`, valida el firmante solo cuando cambia y no regenera la CRL.",{"_3697":75016,"_31245":74931,"_21577":127408,"_5":14884,"_28435":127194,"_3074":127409},[],"Los ajustes archivados, cuya CA ya no existe, pueden eliminarse con `DELETE`: la llamada devuelve 204 en caso de éxito, 404 cuando la CA no tiene ajustes y 409 mientras los ajustes no estén todavía archivados. Tras el borrado, el endpoint público `/crl/{id}` y cualquier endpoint heredado `/crl/<ski>` dejan de servir la lista de la CA, aunque los ficheros de CRL publicados permanecen en el bucket. Conserva los ajustes archivados mientras cualquier certificado emitido por la CA pueda necesitar evidencia de revocación: `DELETE` deja de servir la lista inmediatamente, independientemente de la validez de `latest_crl`. La acción no puede deshacerse.",{"_3697":75017,"_31245":74931,"_21577":127411,"_5":14884,"_28435":127194,"_3074":127412},[],"Después de un cambio, comprueba la configuración guardada y la siguiente lista efectivamente publicada. Modificar los ajustes no prueba por sí solo regeneración ni aceptación por el cliente.",{"_3697":75018,"_31245":74931,"_21577":127414,"_5":14884,"_28435":127198,"_3074":127415},[],"Síntoma",{"_3697":75019,"_31245":74931,"_21577":127417,"_5":14884,"_28435":127198,"_3074":127418},[],"Causa",{"_3697":75020,"_31245":74931,"_21577":127420,"_5":14884,"_28435":127198,"_3074":127421},[],"Acción",{"_3697":75021,"_31245":74931,"_21577":127423,"_5":14884,"_28435":127198,"_3074":127424},[],"`PUT /v1/crl-settings/{ca-id}` devuelve 409.",{"_3697":75022,"_31245":74931,"_21577":127426,"_5":14884,"_28435":127198,"_3074":127427},[],"Los ajustes no están `ACTIVE`: revocar la CA de forma permanente o dejar que caduque los finalizó, o la migración los archivó porque su CA se eliminó antes de la actualización.",{"_3697":75023,"_31245":74931,"_21577":127429,"_5":14884,"_28435":127198,"_3074":127430},[],"No hay vuelta a `ACTIVE` por API. La última CRL sigue sirviéndose.",{"_3697":75024,"_31245":74931,"_21577":127432,"_5":14884,"_28435":127198,"_3074":127433},[],"`DELETE /v1/crl-settings/{ca-id}` devuelve 409.",{"_3697":75025,"_31245":74931,"_21577":127435,"_5":14884,"_28435":127198,"_3074":127436},[],"Los ajustes no están todavía `ARCHIVED`: la CA no se ha eliminado.",{"_3697":75026,"_31245":74931,"_21577":127438,"_5":14884,"_28435":127198,"_3074":127439},[],"Elimina primero la CA; su eliminación archiva los ajustes.",{"_3697":75027,"_31245":74931,"_21577":127441,"_5":14884,"_28435":127198,"_3074":127442},[],"`PUT` devuelve 400.",{"_3697":75028,"_31245":74931,"_21577":127444,"_5":14884,"_28435":127198,"_3074":127445},[],"El firmante nuevo no tiene `cRLSign`, o su sujeto y su clave pública no coinciden con los de la CA.",{"_3697":75029,"_31245":74931,"_21577":127447,"_5":14884,"_28435":127198,"_3074":127448},[],"Asigna el número de serie de un certificado válido de esa CA.",{"_3697":75030,"_31245":74931,"_21577":127450,"_5":14884,"_28435":127198,"_3074":127451},[],"`PUT` devuelve 404.",{"_3697":75031,"_31245":74931,"_21577":127453,"_5":14884,"_28435":127198,"_3074":127454},[],"La CA o el certificado firmante nuevo no existen, o la CA no tiene ajustes de CRL, por ejemplo porque se importó sin su clave o su certificado carece de `cRLSign`.",{"_3697":75032,"_31245":74931,"_21577":127456,"_5":14884,"_28435":127198,"_3074":127457},[],"Revisa el ID de CA y el número de serie del firmante.",{"_3697":75033,"_31245":74931,"_21577":127459,"_5":14884,"_28435":127198,"_3074":127460},[],"`PUT` devuelve 400 desde un cliente de 3.x.",{"_3697":75034,"_31245":74931,"_21577":127462,"_5":14884,"_28435":127198,"_3074":127463},[],"`crl_options.subject_key_id_signer` se sustituyó por `crl_options.signer_serial_number`, que es obligatorio.",{"_3697":75035,"_31245":74931,"_21577":127465,"_5":14884,"_28435":127198,"_3074":127466},[],"Actualiza el cliente para enviar el campo nuevo.",{"_3697":75036,"_31245":74931,"_21577":127468,"_5":14884,"_28435":127198,"_3074":127469},[],"La CRL no cambia tras revocar un certificado.",{"_3697":75037,"_31245":74931,"_21577":127471,"_5":14884,"_28435":127198,"_3074":127472},[],"`regenerate_on_revoke` es `false`, la CA emisora no tiene ajustes de CRL, o la generación falló por un firmante inválido.",{"_3697":75038,"_31245":74931,"_21577":127474,"_5":14884,"_28435":127198,"_3074":127475},[],"Revisa los logs de la VA. La falta de ajustes solo genera un aviso (sin reintento ni entrada en la cola de eventos fallidos); un firmante inválido además deja el evento en la cola de eventos fallidos, así que corrige el firmante.",{"_3697":75039,"_31245":74931,"_21577":127477,"_5":14884,"_28435":127198,"_3074":127478},[],"Un verificador rechaza la CRL por el emisor.",{"_3697":75040,"_31245":74931,"_21577":127480,"_5":14884,"_28435":127198,"_3074":127481},[],"La lista se descargó por una URL heredada `/crl/<ski>` y pertenece a la CA propietaria de ese SKI cuando se ejecutó la actualización.",{"_3697":75041,"_31245":74931,"_21577":127483,"_5":14884,"_28435":127198,"_3074":127484},[],"Usa el CDP del certificado que validas: los certificados emitidos en 4.0.0 llevan URLs `/crl/<ca-id>`.",{"_3697":75042,"_31245":74931,"_21577":127486,"_5":14884,"_28435":127202,"_3074":127487},[],"RFC 5280: perfil X.509 y CRL.",{"_3697":75043,"_31245":74931,"_21577":127489,"_5":14884,"_28435":127202,"_3074":58251},[],{"_3697":75044,"_31245":74931,"_21577":127491,"_5":14884,"_28435":127202,"_3074":58254},[],{"_3697":75045,"_31245":74931,"_21577":127493,"_5":14884,"_28435":127202,"_3074":127494},[],"<Card title=\"Servicio OCSP\" href=\"/docs/platform/pki/ocsp\" />",{"_3697":75046,"_31245":74931,"_21577":127496,"_5":14884,"_28435":127202,"_3074":127497},[],"<Card title=\"Validación de certificados\" href=\"/docs/platform/pki/certificate-validation\" />",{"_3697":75047,"_31245":75047,"_5":15238,"_3074":127499,"_31570":127500,"_21577":127501,"_28435":75047},"Protocolos de enrolamiento",[50948,121910,56713,125969],[],{"_3697":75048,"_31245":75047,"_21577":127503,"_5":14884,"_28435":75047,"_3074":127504},[],"Solicita y renueva certificados de una CA de Lamassu.",{"_3697":75049,"_31245":75047,"_21577":127506,"_5":14884,"_28435":75047,"_3074":127507},[],"Lamassu admite EST (Enrollment over Secure Transport), definido en el RFC 7030. El DMS aplica la política de enrolamiento y la CA configurada emite los certificados.",{"_3697":75050,"_31245":75047,"_21577":127509,"_5":14884,"_28435":75047,"_3074":127510},[],"Endpoint principal",{"_3697":75051,"_31245":75047,"_21577":127512,"_5":14884,"_28435":75047,"_3074":127513},[],"Para qué sirve",{"_3697":75052,"_31245":75047,"_21577":127515,"_5":14884,"_28435":75047,"_3074":58278},[],{"_3697":75053,"_31245":75047,"_21577":127517,"_5":14884,"_28435":75047,"_3074":127518},[],"Obtiene los certificados de CA publicados por el DMS.",{"_3697":75054,"_31245":75047,"_21577":127520,"_5":14884,"_28435":75047,"_3074":58284},[],{"_3697":75055,"_31245":75047,"_21577":127522,"_5":14884,"_28435":75047,"_3074":127523},[],"Solicita un certificado inicial mediante una CSR.",{"_3697":75056,"_31245":75047,"_21577":127525,"_5":14884,"_28435":75047,"_3074":58289},[],{"_3697":75057,"_31245":75047,"_21577":127527,"_5":14884,"_28435":75047,"_3074":127528},[],"Solicita un certificado sucesor para una identidad existente.",{"_3697":75058,"_31245":75047,"_21577":127530,"_5":14884,"_28435":75047,"_3074":127531},[],"Consulta EST (RFC 7030) para configurar el cliente, preparar la autenticación, consultar los formatos y usar la generación opcional de claves en el servidor.",{"_3697":75059,"_31245":75059,"_5":15238,"_3074":127533,"_31570":127534,"_21577":127535,"_28435":75059},"Claves y motores criptográficos",[50948,121910,56713,125969],[],{"_3697":75060,"_31245":75059,"_21577":127537,"_5":14884,"_28435":75059,"_3074":127538},[],"Genera, importa y opera claves sin acoplar la PKI a un proveedor concreto.",{"_3697":75061,"_31245":75059,"_5":31567,"_21577":127540,"_28435":127541,"_3074":127542},[],"/docs/es/platform/pki/key-management#qué-resuelve-el-kms","Qué resuelve el KMS",{"_3697":75062,"_31245":75059,"_5":31567,"_21577":127544,"_28435":127545,"_3074":127546},[],"/docs/es/platform/pki/key-management#motores-criptográficos","Motores criptográficos",{"_3697":75063,"_31245":75059,"_5":31567,"_21577":127548,"_28435":127549,"_3074":58314},[],"/docs/es/platform/pki/key-management#file-system",{"_3697":75064,"_31245":75059,"_5":31567,"_21577":127551,"_28435":127552,"_3074":58318},[],"/docs/es/platform/pki/key-management#hashicorp-vault",{"_3697":75065,"_31245":75059,"_5":31567,"_21577":127554,"_28435":127555,"_3074":58322},[],"/docs/es/platform/pki/key-management#aws-secrets-manager",{"_3697":75066,"_31245":75059,"_5":31567,"_21577":127557,"_28435":127558,"_3074":58326},[],"/docs/es/platform/pki/key-management#aws-kms",{"_3697":75067,"_31245":75059,"_5":31567,"_21577":127560,"_28435":127561,"_3074":58330},[],"/docs/es/platform/pki/key-management#pkcs11",{"_3697":75068,"_31245":75059,"_5":31567,"_21577":127563,"_28435":127564,"_3074":58334},[],"/docs/es/platform/pki/key-management#azure-key-vault",{"_3697":75069,"_31245":75059,"_5":31567,"_21577":127566,"_28435":127567,"_3074":127568},[],"/docs/es/platform/pki/key-management#inventario-de-claves","Inventario de claves",{"_3697":75070,"_31245":75059,"_5":31567,"_21577":127570,"_28435":127571,"_3074":127572},[],"/docs/es/platform/pki/key-management#crear-o-importar-claves","Crear o importar claves",{"_3697":75071,"_31245":75059,"_5":31567,"_21577":127574,"_28435":127575,"_3074":127576},[],"/docs/es/platform/pki/key-management#generar-un-nuevo-par-de-claves","Generar un nuevo par de claves",{"_3697":75072,"_31245":75059,"_5":31567,"_21577":127578,"_28435":127579,"_3074":127580},[],"/docs/es/platform/pki/key-management#importar-un-par-existente","Importar un par existente",{"_3697":75073,"_31245":75059,"_5":31567,"_21577":127582,"_28435":127583,"_3074":127584},[],"/docs/es/platform/pki/key-management#operaciones-sobre-una-clave","Operaciones sobre una clave",{"_3697":75074,"_31245":75059,"_5":31567,"_21577":127586,"_28435":127587,"_3074":127588},[],"/docs/es/platform/pki/key-management#ver-detalles","Ver detalles",{"_3697":75075,"_31245":75059,"_5":31567,"_21577":127590,"_28435":127591,"_3074":127592},[],"/docs/es/platform/pki/key-management#firmar-y-verificar","Firmar y verificar",{"_3697":75076,"_31245":75059,"_5":31567,"_21577":127594,"_28435":127595,"_3074":58366},[],"/docs/es/platform/pki/key-management#sign",{"_3697":75077,"_31245":75059,"_5":31567,"_21577":127597,"_28435":127598,"_3074":58370},[],"/docs/es/platform/pki/key-management#verify",{"_3697":75078,"_31245":75059,"_5":31567,"_21577":127600,"_28435":127601,"_3074":127602},[],"/docs/es/platform/pki/key-management#generar-un-csr","Generar un CSR",{"_3697":75079,"_31245":75059,"_5":31567,"_21577":127604,"_28435":127605,"_3074":127606},[],"/docs/es/platform/pki/key-management#firma-local-con-pkcs11","Firma local con PKCS#11",{"_3697":75080,"_31245":75059,"_5":31567,"_21577":127608,"_28435":127609,"_3074":127610},[],"/docs/es/platform/pki/key-management#antes-de-eliminar-una-clave","Antes de eliminar una clave",{"_3697":75081,"_31245":75059,"_21577":127612,"_5":14884,"_28435":75059,"_3074":127613},[],"El servicio de Gestión de Claves Criptográficas (KMS) de Lamassu IoT centraliza la generación, importación, custodia y uso de las claves de la plataforma. Desde aquí se gestionan las claves que soportan a las CAs y al resto de operaciones de firma que dependen de la PKI.",{"_3697":75082,"_31245":75059,"_21577":127615,"_5":14884,"_28435":75059,"_3074":127616},[],"En la configuración actual, Lamassu IoT trabaja exclusivamente con claves asimétricas, como RSA y curvas elípticas. Estas claves se usan para emitir certificados X.509, firmar solicitudes y realizar operaciones de autenticación y validación dentro del sistema.",{"_3697":75083,"_31245":75059,"_21577":127618,"_5":14884,"_28435":127541,"_3074":127619},[],"El KMS unifica la gestión del ciclo de vida de las claves y evita que cada servicio tenga que integrarse directamente con un proveedor criptográfico concreto.",{"_3697":75084,"_31245":75059,"_21577":127621,"_5":14884,"_28435":127541,"_3074":127622},[],"En la práctica, permite:",{"_3697":75085,"_31245":75059,"_21577":127624,"_5":14884,"_28435":127541,"_3074":127625},[],"Generar nuevos pares de claves desde Lamassu IoT.",{"_3697":75086,"_31245":75059,"_21577":127627,"_5":14884,"_28435":127541,"_3074":127628},[],"Importar claves creadas externamente.",{"_3697":75087,"_31245":75059,"_21577":127630,"_5":14884,"_28435":127541,"_3074":127631},[],"Delegar la custodia y las operaciones criptográficas en motores externos.",{"_3697":75088,"_31245":75059,"_21577":127633,"_5":14884,"_28435":127541,"_3074":127634},[],"Reutilizar claves ya existentes para CAs, CSR y tareas de firma o verificación.",{"_3697":75089,"_31245":75059,"_21577":127636,"_5":14884,"_28435":127545,"_3074":127637},[],"Lamassu puede trabajar con distintos motores criptográficos según los requisitos del despliegue. En algunos entornos bastará con un motor software; en otros será necesario delegar la custodia en un HSM, en un servicio cloud o en una plataforma especializada.",{"_3697":75090,"_31245":75059,"_21577":127639,"_5":14884,"_28435":127545,"_3074":127640},[],"Una misma instancia puede tener varios motores configurados al mismo tiempo, incluso varias instancias del mismo tipo. Esto permite adaptar la operación a distintos niveles de seguridad, coste y requisitos regulatorios.",{"_3697":75091,"_31245":75059,"_21577":127642,"_5":14884,"_28435":127545,"_3074":127643},[],"Esta guía se dirige al operador PKI: elige y utiliza un motor ya habilitado. La instalación, credenciales, almacenamiento persistente y conectividad corresponden a Despliegue. Antes de generar una CA, comprueba el motor predeterminado, los algoritmos publicados y que una firma de prueba funciona. La disponibilidad en tu instalación depende de su versión y configuración.",{"_3697":75092,"_31245":75059,"_21577":127645,"_5":14884,"_28435":127549,"_3074":127646},[],"Genera claves software y almacena el material privado en archivos. Su custodia depende de permisos, almacenamiento y copias de seguridad de la instalación. Antes de utilizarlo para una CA operativa, acuerda cómo se recuperará la clave y cómo accederán a ella las réplicas; el registro del KMS no sustituye esos archivos.",{"_3697":75093,"_31245":75059,"_21577":127648,"_5":14884,"_28435":127552,"_3074":127649},[],"El adaptador utiliza almacenamiento KV para el material privado. No equivale a una operación de firma dentro de Vault Transit: quien pueda leer el secreto puede recuperar la clave. Revisa los permisos de lectura, disponibilidad y recuperación con el responsable de Despliegue.",{"_3697":75094,"_31245":75059,"_21577":127651,"_5":14884,"_28435":127552,"_3074":127652},[],"El adaptador se comunica con Vault a través de su endpoint HTTP(S) configurado. El certificado del servidor de Vault se verifica contra el almacén de confianza del sistema; para confiar en un Vault con certificado emitido por una CA privada, añade ese certificado de CA al `ca_cert_file` del motor (codificado en PEM). `insecure_skip_verify=true` desactiva la verificación y es un último recurso; acuerda los ajustes de transporte con el responsable de Despliegue.",{"_3697":75095,"_31245":75059,"_21577":127654,"_5":14884,"_28435":127555,"_3074":127655},[],"Ofrece persistencia cifrada en AWS con coste asociado. Protege la clave en reposo, pero un administrador autorizado puede recuperarla; no proporciona la misma resistencia a la extracción que un KMS o HSM.",{"_3697":75096,"_31245":75059,"_21577":127657,"_5":14884,"_28435":127558,"_3074":127658},[],"Delega las firmas en el servicio AWS KMS. El adaptador también contempla importación de material externo, sujeta a las capacidades y permisos del proveedor. Una clave generada fuera del servicio ya ha existido fuera de su custodia; importarla no elimina esas copias. Comprueba generación, importación y firma como operaciones distintas.",{"_3697":75097,"_31245":75059,"_21577":127660,"_5":14884,"_28435":127561,"_3074":127661},[],"Permite integrar HSMs locales, entornos aislados y servicios *Key as a Service*. La generación, persistencia y resistencia a la extracción dependen del dispositivo o proveedor concreto. Es la opción más flexible cuando la política exige custodia hardware.",{"_3697":75098,"_31245":75059,"_21577":127663,"_5":14884,"_28435":127564,"_3074":127664},[],"El backend también dispone de adaptadores para **Key Vault Keys** y **Key Vault Secrets**. El primero delega firmas al servicio de claves; el segundo conserva material privado como secretos y firma con ese material. No intercambies ambos modelos de custodia. Confirma qué adaptador está habilitado en tu instalación y prueba las operaciones necesarias.",{"_3697":75099,"_31245":75059,"_21577":127666,"_5":14884,"_28435":127564,"_3074":127667},[],"Lamassu muestra en la consola el listado de motores habilitados.",{"_3697":75100,"_31245":75059,"_21577":127669,"_5":14884,"_28435":127564,"_3074":127670},[],"Cada motor define qué algoritmos soporta, como RSA o ECC/ECDSA, y qué tamaños de clave puede generar.",{"_3697":75101,"_31245":75059,"_21577":127672,"_5":14884,"_28435":127564,"_3074":127673},[],"Revisa con el operador de Despliegue qué motor está definido como predeterminado. Ese motor se utilizará cuando un proceso necesite crear o persistir una clave y el usuario no haya seleccionado uno específico, por ejemplo al crear o importar una CA.",{"_3697":75102,"_31245":75059,"_21577":127675,"_5":14884,"_28435":127567,"_3074":127676},[],"La pantalla principal de KMS muestra el inventario completo de claves registradas en el sistema. Es la vista de referencia para revisar qué claves existen, dónde están custodiadas y con qué entidades están relacionadas.",{"_3697":75103,"_31245":75059,"_21577":127678,"_5":14884,"_28435":127567,"_3074":127679},[],"La tabla incluye los siguientes campos:",{"_3697":75104,"_31245":75059,"_21577":127681,"_5":14884,"_28435":127567,"_3074":127682},[],"**Name**: nombre descriptivo de la clave.",{"_3697":75105,"_31245":75059,"_21577":127684,"_5":14884,"_28435":127567,"_3074":127685},[],"**Type**: algoritmo y tamaño de clave, por ejemplo RSA 2048 o EC P-256.",{"_3697":75106,"_31245":75059,"_21577":127687,"_5":14884,"_28435":127567,"_3074":127688},[],"**Strength**: indicador visual de fortaleza criptográfica.",{"_3697":75107,"_31245":75059,"_21577":127690,"_5":14884,"_28435":127567,"_3074":127691},[],"**Public/Private**: indica si Lamassu gestiona el par completo o solo la clave pública.",{"_3697":75108,"_31245":75059,"_21577":127693,"_5":14884,"_28435":127567,"_3074":127694},[],"**Crypto Engine**: motor criptográfico que custodia la clave.",{"_3697":75109,"_31245":75059,"_21577":127696,"_5":14884,"_28435":127567,"_3074":127697},[],"**Aliases**: nombres alternativos asociados a la clave.",{"_3697":75110,"_31245":75059,"_21577":127699,"_5":14884,"_28435":127567,"_3074":127700},[],"**Tags**: etiquetas para clasificación y búsqueda.",{"_3697":75111,"_31245":75059,"_21577":127702,"_5":14884,"_28435":127567,"_3074":127703},[],"**Related Entities**: certificados u otras entidades vinculadas a esa clave.",{"_3697":75112,"_31245":75059,"_21577":127705,"_5":14884,"_28435":127567,"_3074":127706},[],"Desde esta vista también se accede a las acciones más habituales:",{"_3697":75113,"_31245":75059,"_21577":127708,"_5":14884,"_28435":127567,"_3074":127709},[],"**View Details** para consultar metadatos, identificadores y relaciones.",{"_3697":75114,"_31245":75059,"_21577":127711,"_5":14884,"_28435":127567,"_3074":127712},[],"**Generate CSR** para crear una solicitud PKCS#10 con la clave seleccionada.",{"_3697":75115,"_31245":75059,"_21577":127714,"_5":14884,"_28435":127567,"_3074":127715},[],"**Sign / Verify** para probar operaciones criptográficas sobre la clave.",{"_3697":75116,"_31245":75059,"_21577":127717,"_5":14884,"_28435":127567,"_3074":127718},[],"**Delete Key** para eliminar la clave del sistema.",{"_3697":75117,"_31245":75059,"_21577":127720,"_5":14884,"_28435":127571,"_3074":127721},[],"Necesitas permisos de administración de claves y un motor accesible. El perfil de emisión debe admitir el algoritmo que eliges si la clave va a utilizarse en una CA o CSR. Abre **Create New Key** y elige generación o importación.",{"_3697":75118,"_31245":75059,"_21577":127723,"_5":14884,"_28435":127575,"_3074":127724},[],"Si la clave va a nacer dentro de Lamassu, el flujo recomendado es generar un nuevo par gestionado directamente por uno de los motores configurados.",{"_3697":75119,"_31245":75059,"_21577":127726,"_5":14884,"_28435":127575,"_3074":127727},[],"En la primera pantalla del asistente, elige **Generate New Key Pair** y después define los parámetros principales:",{"_3697":75120,"_31245":75059,"_21577":127729,"_5":14884,"_28435":127575,"_3074":127730},[],"**Key Name**: nombre único y descriptivo.",{"_3697":75121,"_31245":75059,"_21577":127732,"_5":14884,"_28435":127575,"_3074":127733},[],"**Crypto Engine**: motor que custodiará la clave.",{"_3697":75122,"_31245":75059,"_21577":127735,"_5":14884,"_28435":127575,"_3074":127736},[],"**Key Type** y **Key Size**: algoritmo y tamaño o curva.",{"_3697":75123,"_31245":75059,"_21577":127738,"_5":14884,"_28435":127575,"_3074":127739},[],"**Tags**: metadatos para clasificar la clave.",{"_3697":75124,"_31245":75059,"_21577":127741,"_5":14884,"_28435":127575,"_3074":127742},[],"**Metadata**: información adicional para usos avanzados.",{"_3697":75125,"_31245":75059,"_21577":127744,"_5":14884,"_28435":127579,"_3074":127745},[],"La importación permite registrar en Lamassu una clave generada fuera de la plataforma. Es el flujo habitual en escenarios BYOK, migraciones o integración con material criptográfico que ya está en producción.",{"_3697":75126,"_31245":75059,"_21577":127747,"_5":14884,"_28435":127579,"_3074":127748},[],"Cuando tienes una clave privada exportable y el motor de destino admite su importación.",{"_3697":75127,"_31245":75059,"_21577":127750,"_5":14884,"_28435":127579,"_3074":127751},[],"Cuando se necesita migrar una PKI existente sin reemitir certificados.",{"_3697":75128,"_31245":75059,"_21577":127753,"_5":14884,"_28435":127579,"_3074":127754},[],"Cuando Lamassu debe operar con una raíz de confianza creada por un tercero.",{"_3697":75129,"_31245":75059,"_21577":127756,"_5":14884,"_28435":127579,"_3074":127757},[],"En el asistente, elige **Import Existing Key Pair** y completa los campos solicitados:",{"_3697":75130,"_31245":75059,"_21577":127759,"_5":14884,"_28435":127579,"_3074":127760},[],"**Key Name**: nombre descriptivo dentro de Lamassu IoT.",{"_3697":75131,"_31245":75059,"_21577":127762,"_5":14884,"_28435":127579,"_3074":127763},[],"**Crypto Engine**: motor que custodiará la clave importada.",{"_3697":75132,"_31245":75059,"_21577":127765,"_5":14884,"_28435":127579,"_3074":127766},[],"**Tags**: etiquetas para organización y búsqueda.",{"_3697":75133,"_31245":75059,"_21577":127768,"_5":14884,"_28435":127579,"_3074":127769},[],"**Metadata**: información adicional opcional.",{"_3697":75134,"_31245":75059,"_21577":127771,"_5":14884,"_28435":127579,"_3074":127772},[],"**Private Key (PEM)**: clave privada en formato PEM.",{"_3697":75135,"_31245":75059,"_21577":127774,"_5":14884,"_28435":127579,"_3074":127775},[],"Si la importación termina correctamente, abre el registro, comprueba motor y clave pública y realiza una firma de prueba. Una clave no exportable en un HSM no puede cargarse mediante este formulario PEM: configura el acceso al motor y comprueba cómo se registra la clave existente. Revisa dependencias y recursos que puedan haberse creado en el proveedor si una operación falla a mitad.",{"_3697":75136,"_31245":75059,"_21577":127777,"_5":14884,"_28435":127583,"_3074":127778},[],"Cada clave registrada dispone de una vista de detalle y de varias acciones operativas.",{"_3697":75137,"_31245":75059,"_21577":127780,"_5":14884,"_28435":127587,"_3074":127781},[],"La pantalla **View Details** concentra la información técnica y administrativa de la clave.",{"_3697":75138,"_31245":75059,"_21577":127783,"_5":14884,"_28435":127587,"_3074":127784},[],"En la pestaña **Overview** se muestran, entre otros, estos campos:",{"_3697":75139,"_31245":75059,"_21577":127786,"_5":14884,"_28435":127587,"_3074":127787},[],"**Key Name**: nombre descriptivo.",{"_3697":75140,"_31245":75059,"_21577":127789,"_5":14884,"_28435":127587,"_3074":127790},[],"**Key Identifier**: identificador único del sistema. Lamassu utiliza formatos de ID basados en PKCS11.",{"_3697":75141,"_31245":75059,"_21577":127792,"_5":14884,"_28435":127587,"_3074":127793},[],"**Tags**: etiquetas asociadas.",{"_3697":75142,"_31245":75059,"_21577":127795,"_5":14884,"_28435":127587,"_3074":127796},[],"**Aliases**: nombres alternativos.",{"_3697":75143,"_31245":75059,"_21577":127798,"_5":14884,"_28435":127587,"_3074":127799},[],"**Crypto Engine**: motor en el que reside la clave.",{"_3697":75144,"_31245":75059,"_21577":127801,"_5":14884,"_28435":127587,"_3074":127802},[],"**Algorithm, Key Size & Strength**: algoritmo, parámetros y nivel de fortaleza.",{"_3697":75145,"_31245":75059,"_21577":127804,"_5":14884,"_28435":127587,"_3074":127805},[],"La sección **Related Entities** muestra qué objetos de Lamassu dependen de esa clave.",{"_3697":75146,"_31245":75059,"_21577":127807,"_5":14884,"_28435":127587,"_3074":127808},[],"La pestaña **Public Key** muestra el material público en PEM. El identificador y la URI del registro sirven para localizar la clave; una URI con formato PKCS#11 no demuestra que el motor sea un HSM ni que exista un módulo local para acceder a ella.",{"_3697":75147,"_31245":75059,"_21577":127810,"_5":14884,"_28435":127591,"_3074":127811},[],"La acción **Sign / Verify** sirve para validar que la clave y el motor criptográfico funcionan correctamente.",{"_3697":75148,"_31245":75059,"_21577":127813,"_5":14884,"_28435":127591,"_3074":127814},[],"Firma un mensaje de prueba, guarda la firma y verifícala con la misma clave pública, algoritmo y codificación. Cambia después el mensaje: la verificación debe fallar. Esto comprueba una operación concreta; no certifica todas las capacidades del motor ni la cadena de una CA.",{"_3697":75149,"_31245":75059,"_21577":127816,"_5":14884,"_28435":127591,"_3074":127817},[],"Al abrirla aparecen dos áreas: **Sign** y **Verify**.",{"_3697":75150,"_31245":75059,"_21577":127819,"_5":14884,"_28435":127595,"_3074":127820},[],"Esta pestaña usa la clave privada para generar una firma digital sobre un mensaje o sobre un *digest* ya calculado.",{"_3697":75151,"_31245":75059,"_21577":127822,"_5":14884,"_28435":127595,"_3074":127823},[],"Campos principales:",{"_3697":75152,"_31245":75059,"_21577":127825,"_5":14884,"_28435":127595,"_3074":127826},[],"**Algorithm**: algoritmo de firma disponible para el tipo de clave.",{"_3697":75153,"_31245":75059,"_21577":127828,"_5":14884,"_28435":127595,"_3074":127829},[],"**Message Type**: `Raw` para datos en claro o `Digest` para un hash precalculado.",{"_3697":75154,"_31245":75059,"_21577":127831,"_5":14884,"_28435":127595,"_3074":127832},[],"**Payload Encoding**: codificación de entrada, como UTF-8, Hex o Base64.",{"_3697":75155,"_31245":75059,"_21577":127834,"_5":14884,"_28435":127595,"_3074":127835},[],"**Message**: contenido que se va a firmar.",{"_3697":75156,"_31245":75059,"_21577":127837,"_5":14884,"_28435":127595,"_3074":127838},[],"**Signature**: resultado de la operación, mostrado en hexadecimal.",{"_3697":75157,"_31245":75059,"_21577":127840,"_5":14884,"_28435":127598,"_3074":127841},[],"Esta pestaña comprueba si una firma corresponde a la clave pública asociada.",{"_3697":75158,"_31245":75059,"_21577":127843,"_5":14884,"_28435":127598,"_3074":127823},[],{"_3697":75159,"_31245":75059,"_21577":127845,"_5":14884,"_28435":127598,"_3074":127846},[],"**Algorithm**: debe coincidir con el algoritmo usado para la firma.",{"_3697":75160,"_31245":75059,"_21577":127848,"_5":14884,"_28435":127598,"_3074":127849},[],"**Message Type**: `Raw` o `Digest`.",{"_3697":75161,"_31245":75059,"_21577":127851,"_5":14884,"_28435":127598,"_3074":127852},[],"**Payload Encoding**: codificación del mensaje.",{"_3697":75162,"_31245":75059,"_21577":127854,"_5":14884,"_28435":127598,"_3074":127855},[],"**Message**: mensaje original o hash.",{"_3697":75163,"_31245":75059,"_21577":127857,"_5":14884,"_28435":127598,"_3074":127858},[],"**Signature**: firma que se desea comprobar.",{"_3697":75164,"_31245":75059,"_21577":127860,"_5":14884,"_28435":127598,"_3074":127861},[],"**Result**: indicador del resultado de la validación.",{"_3697":75165,"_31245":75059,"_21577":127863,"_5":14884,"_28435":127601,"_3074":127864},[],"La acción **Generate CSR** crea una solicitud PKCS#10 firmada con la clave privada custodiada en Lamassu, sin exponerla fuera del motor criptográfico.",{"_3697":75166,"_31245":75059,"_21577":127866,"_5":14884,"_28435":127601,"_3074":127867},[],"Este flujo es útil para:",{"_3697":75167,"_31245":75059,"_21577":127869,"_5":14884,"_28435":127601,"_3074":127870},[],"Solicitar certificados a una CA externa.",{"_3697":75168,"_31245":75059,"_21577":127872,"_5":14884,"_28435":127601,"_3074":127873},[],"Renovar una identidad manteniendo la misma clave.",{"_3697":75169,"_31245":75059,"_21577":127875,"_5":14884,"_28435":127601,"_3074":127876},[],"Al abrir el formulario se solicitan los datos del sujeto y los atributos principales del certificado:",{"_3697":75170,"_31245":75059,"_21577":127878,"_5":14884,"_28435":127601,"_3074":127879},[],"**Common Name (CN)**: nombre principal de la identidad.",{"_3697":75171,"_31245":75059,"_21577":127881,"_5":14884,"_28435":127601,"_3074":127882},[],"**Organization (O)**: organización o empresa.",{"_3697":75172,"_31245":75059,"_21577":127884,"_5":14884,"_28435":127601,"_3074":127885},[],"**Organizational Unit (OU)**: departamento o unidad.",{"_3697":75173,"_31245":75059,"_21577":127887,"_5":14884,"_28435":127601,"_3074":127888},[],"**Country (C)**: código de país de dos letras.",{"_3697":75174,"_31245":75059,"_21577":127890,"_5":14884,"_28435":127601,"_3074":127891},[],"**State / Province (ST)**: estado o provincia.",{"_3697":75175,"_31245":75059,"_21577":127893,"_5":14884,"_28435":127601,"_3074":127894},[],"**Locality (L)**: ciudad o localidad.",{"_3697":75176,"_31245":75059,"_21577":127896,"_5":14884,"_28435":127601,"_3074":127897},[],"**Email Address**: correo de contacto.",{"_3697":75177,"_31245":75059,"_21577":127899,"_5":14884,"_28435":127601,"_3074":127900},[],"**Subject Alternative Names (SANs)**: nombres o identificadores alternativos, como DNS o IP.",{"_3697":75178,"_31245":75059,"_21577":127902,"_5":14884,"_28435":127601,"_3074":127903},[],"Descarga la CSR y ejecuta `openssl req -in request.csr -noout -verify -text`. Comprueba firma, sujeto y SAN antes de enviarla. La CSR no determina por sí sola el certificado final: la política de emisión puede sustituir sus campos.",{"_3697":75179,"_31245":75059,"_21577":127905,"_5":14884,"_28435":127605,"_3074":127906},[],"Lamassu también ofrece una ayuda específica para integraciones locales mediante **Sign locally with OpenSSL & PKCS11 tools**.",{"_3697":75180,"_31245":75059,"_21577":127908,"_5":14884,"_28435":127605,"_3074":127909},[],"Requiere el módulo, token y permisos del proveedor correspondiente. Comprueba que el identificador de Lamassu se corresponde con el objeto accesible desde ese módulo. La configuración del módulo pertenece al entorno del cliente o al Despliegue.",{"_3697":75181,"_31245":75059,"_21577":127911,"_5":14884,"_28435":127609,"_3074":127912},[],"Revisa **Related Entities** y localiza CAs, certificados y procesos de validación que siguen necesitando firmas. Revocar una CA no elimina la necesidad de publicar estado durante su periodo de retención. Eliminar una clave tampoco revoca automáticamente sus certificados. Planifica sustitución y retención antes de usar **Delete Key**; el efecto de borrado en el proveedor depende del motor.",{"_3697":75182,"_31245":75059,"_21577":127914,"_5":14884,"_28435":127609,"_3074":127915},[],"El KMS se niega a eliminar una clave que todavía está referenciada por certificados, con `409` `key is in use`. Revocar un certificado o dejar que caduque no libera su referencia a la clave. Eliminar una CA libera las referencias de su propio certificado actual y de sus certificados reemitidos vinculados, que se conservan para respaldar la CRL y OCSP, y después intenta eliminar la clave. Si otros certificados todavía la referencian, como los de otra CA que la comparte, el KMS la conserva. Los certificados emitidos por la CA conservan sus propias referencias a claves, incluso revocados. La API solo permite eliminar uno de ellos cuando su CA emisora ya no existe, y eliminarlo lo quita de la CRL y de las respuestas OCSP, así que conserva los certificados revocados durante su periodo de retención y elimina solo los caducados o sustituidos. El KMS también se niega a eliminar una clave que firma la CRL de una CA cuyos ajustes de CRL siguen `ACTIVE`, con el mismo `409` `key is in use`; esa referencia se libera cuando los ajustes se finalizan, después de que la CA se revoca de forma permanente o caduca (consulta CRL). La guía de actualización describe las referencias heredadas que conserva la migración.",{"_3697":75183,"_31245":75183,"_5":15238,"_3074":127917,"_31570":127918,"_21577":127919,"_28435":75183},"Validación online con OCSP",[50948,121910,56713,126640],[],{"_3697":75184,"_31245":75183,"_21577":127921,"_5":14884,"_28435":75183,"_3074":127922},[],"Consulta el estado firmado y verifica la respuesta del respondedor.",{"_3697":75185,"_31245":75183,"_5":31567,"_21577":127924,"_28435":127925,"_3074":127926},[],"/docs/es/platform/pki/ocsp#cómo-funciona-el-respondedor-en-lamassu","Cómo funciona el respondedor en Lamassu",{"_3697":75186,"_31245":75183,"_5":31567,"_21577":127928,"_28435":127929,"_3074":127930},[],"/docs/es/platform/pki/ocsp#enlace-en-los-certificados-emitidos","Enlace en los certificados emitidos",{"_3697":75187,"_31245":75183,"_5":31567,"_21577":127932,"_28435":127933,"_3074":127934},[],"/docs/es/platform/pki/ocsp#endpoints-http","Endpoints HTTP",{"_3697":75188,"_31245":75183,"_5":31567,"_21577":127936,"_28435":127937,"_3074":127938},[],"/docs/es/platform/pki/ocsp#genera-y-verifica-una-consulta","Genera y verifica una consulta",{"_3697":75189,"_31245":75183,"_5":31567,"_21577":127940,"_28435":127941,"_3074":127942},[],"/docs/es/platform/pki/ocsp#comprobación-desde-la-interfaz","Comprobación desde la interfaz",{"_3697":75190,"_31245":75183,"_5":31567,"_21577":127944,"_28435":127945,"_3074":127203},[],"/docs/es/platform/pki/ocsp#referencias",{"_3697":75191,"_31245":75183,"_21577":127947,"_5":14884,"_28435":75183,"_3074":127948},[],"OCSP permite consultar el estado de un certificado y obtener una respuesta firmada. Esta guía sirve al integrador que necesita comprobar qué publica Lamassu y cómo debe verificarlo el consumidor. Para la validación completa de una identidad, sigue Validación de certificados.",{"_3697":75192,"_31245":75183,"_21577":127950,"_5":14884,"_28435":127925,"_3074":127951},[],"El respondedor obtiene el certificado por número de serie y localiza su CA emisora en el inventario. Traduce el estado persistido así:",{"_3697":75193,"_31245":75183,"_21577":127953,"_5":14884,"_28435":127925,"_3074":127954},[],"Estado del registro",{"_3697":75194,"_31245":75183,"_21577":127956,"_5":14884,"_28435":127925,"_3074":127957},[],"Respuesta firmada",{"_3697":75195,"_31245":75183,"_21577":127959,"_5":14884,"_28435":127925,"_3074":55849},[],{"_3697":75196,"_31245":75183,"_21577":127961,"_5":14884,"_28435":127925,"_3074":58734},[],{"_3697":75197,"_31245":75183,"_21577":127963,"_5":14884,"_28435":127925,"_3074":55866},[],{"_3697":75198,"_31245":75183,"_21577":127965,"_5":14884,"_28435":127925,"_3074":127966},[],"`Revoked`, con razón y fecha de revocación.",{"_3697":75199,"_31245":75183,"_21577":127968,"_5":14884,"_28435":127925,"_3074":127969},[],"Otros estados, incluidos `INACTIVE` y `EXPIRED`",{"_3697":75200,"_31245":75183,"_21577":127971,"_5":14884,"_28435":127925,"_3074":127972},[],"`Unknown` si puede obtener el certificado y su emisor.",{"_3697":75201,"_31245":75183,"_21577":127974,"_5":14884,"_28435":127925,"_3074":127975},[],"Un número de serie ausente provoca un error de búsqueda; no garantiza una respuesta firmada `Unknown`. Los errores de búsqueda o firma se devuelven como fallo HTTP. Trata ese fallo como falta de evidencia, según la política del consumidor.",{"_3697":75202,"_31245":75183,"_21577":127977,"_5":14884,"_28435":127925,"_3074":127978},[],"La propia CA emisora firma la respuesta mediante su clave asociada al KMS. No se utiliza un certificado delegado de firma OCSP. Una CA importada sin clave utilizable no puede firmar respuestas.",{"_3697":75203,"_31245":75183,"_21577":127980,"_5":14884,"_28435":127925,"_3074":127981},[],"La implementación establece `thisUpdate` aproximadamente un día antes de generar la respuesta y `nextUpdate` un día después: la ventana declarada es de unas 48 horas. Inspecciona los valores recibidos y aplica tu política de vigencia. La respuesta refleja el estado almacenado al consultarla; una copia anterior en caché no cambia al revocar.",{"_3697":75204,"_31245":75183,"_21577":127983,"_5":14884,"_28435":127929,"_3074":127984},[],"El firmador construye las URLs OCSP a partir de los dominios VA configurados y las añade a AIA. Si no hay dominios, no hay URL que añadir; un certificado importado conserva sus extensiones originales. Revisa el certificado real:",{"_3697":75205,"_31245":75183,"_21577":127986,"_5":14884,"_28435":127929,"_3074":127987},[],"Comprueba que esa URL es accesible desde el consumidor. DNS, exposición del endpoint y configuración de dominios pertenecen a Despliegue. Cambiar esa configuración no modifica certificados ya firmados.",{"_3697":75206,"_31245":75183,"_21577":127989,"_5":14884,"_28435":127933,"_3074":127990},[],"El servicio acepta:",{"_3697":75207,"_31245":75183,"_21577":127992,"_5":14884,"_28435":127933,"_3074":123679},[],{"_3697":75208,"_31245":75183,"_21577":127994,"_5":14884,"_28435":127933,"_3074":127995},[],"Ruta del servicio VA",{"_3697":75209,"_31245":75183,"_21577":127997,"_5":14884,"_28435":127933,"_3074":127998},[],"Formato",{"_3697":75210,"_31245":75183,"_21577":128000,"_5":14884,"_28435":127933,"_3074":58774},[],{"_3697":75211,"_31245":75183,"_21577":128002,"_5":14884,"_28435":127933,"_3074":58777},[],{"_3697":75212,"_31245":75183,"_21577":128004,"_5":14884,"_28435":127933,"_3074":128005},[],"Solicitud DER, `Content-Type: application/ocsp-request`.",{"_3697":75213,"_31245":75183,"_21577":128007,"_5":14884,"_28435":127933,"_3074":58134},[],{"_3697":75214,"_31245":75183,"_21577":128009,"_5":14884,"_28435":127933,"_3074":58785},[],{"_3697":75215,"_31245":75183,"_21577":128011,"_5":14884,"_28435":127933,"_3074":128012},[],"Solicitud DER codificada en Base64 URL con padding.",{"_3697":75216,"_31245":75183,"_21577":128014,"_5":14884,"_28435":127933,"_3074":128015},[],"Utiliza POST para evitar diferencias de codificación entre clientes. La respuesta correcta tiene `Content-Type: application/ocsp-response` y cuerpo DER. El prefijo público depende del Gateway; utiliza la URL publicada en el certificado y comprobada por el operador.",{"_3697":75217,"_31245":75183,"_21577":128017,"_5":14884,"_28435":127937,"_3074":128018},[],"Necesitas OpenSSL 3.x, `device.crt`, el certificado de su emisor directo `issuer.pem` y las raíces confiables del consumidor en `roots.pem`. Si el emisor es intermedio, prepara además `intermediates.pem` con las CAs intermedias.",{"_3697":75218,"_31245":75183,"_21577":128020,"_5":14884,"_28435":127937,"_3074":128021},[],"Genera la solicitud:",{"_3697":75219,"_31245":75183,"_21577":128023,"_5":14884,"_28435":127937,"_3074":128024},[],"Este ejemplo omite el nonce porque el respondedor no lo devuelve. La verificación depende de firma, correspondencia de la respuesta y tiempos; no demuestra frescura mediante un nonce.",{"_3697":75220,"_31245":75183,"_21577":128026,"_5":14884,"_28435":127937,"_3074":128027},[],"Sustituye la URL de ejemplo por el endpoint inspeccionado:",{"_3697":75221,"_31245":75183,"_21577":128029,"_5":14884,"_28435":127937,"_3074":128030},[],"Verifica el DER recibido:",{"_3697":75222,"_31245":75183,"_21577":128032,"_5":14884,"_28435":127937,"_3074":128033},[],"Si hay intermedias, añade `-verify_other intermediates.pem`. Exige verificación correcta de la respuesta y comprueba el estado correspondiente a `device.crt`, emisor, serie, `thisUpdate` y `nextUpdate`. Un resultado `Response verify OK` solo valida la respuesta: también debes observar `good`, `revoked` o `unknown`. No aceptes una identidad basándote únicamente en el código de salida del comando.",{"_3697":75223,"_31245":75183,"_21577":128035,"_5":14884,"_28435":127941,"_3074":128036},[],"**OCSP Check** permite observar lo que responde Lamassu para un certificado seleccionado. Completa la comprobación desde la red y el almacén de confianza del consumidor: la consulta de la consola no prueba su configuración de validación.",{"_3697":75224,"_31245":75183,"_21577":128038,"_5":14884,"_28435":127941,"_3074":128039},[],"Para comprobar un cambio, guarda una respuesta anterior, revoca un certificado de prueba y solicita otra. La consulta nueva debe reflejar el estado persistido; compara los tiempos para descartar reutilización de una respuesta anterior. Si falla, sigue Diagnóstico PKI.",{"_3697":75225,"_31245":75183,"_21577":128041,"_5":14884,"_28435":127945,"_3074":58818},[],{"_3697":75226,"_31245":75183,"_21577":128043,"_5":14884,"_28435":127945,"_3074":58821},[],{"_3697":75227,"_31245":75183,"_21577":128045,"_5":14884,"_28435":127945,"_3074":128046},[],"<Card title=\"Servicio CRL\" href=\"/docs/platform/pki/crl\" />",{"_3697":75228,"_31245":75183,"_21577":128048,"_5":14884,"_28435":127945,"_3074":127497},[],{"_3697":75229,"_31245":75229,"_5":15238,"_3074":56713,"_31570":128050,"_21577":128051,"_28435":75229},[50948,121910,56713],[],{"_3697":75230,"_31245":75229,"_21577":128053,"_5":14884,"_28435":75229,"_3074":128054},[],"Administra claves y autoridades, define la emisión y verifica los certificados resultantes.",{"_3697":75231,"_31245":75229,"_5":31567,"_21577":128056,"_28435":128057,"_3074":125294},[],"/docs/es/platform/pki/overview#empieza-aquí",{"_3697":75232,"_31245":75229,"_5":31567,"_21577":128059,"_28435":128060,"_3074":128061},[],"/docs/es/platform/pki/overview#qué-necesitas","Qué necesitas",{"_3697":75233,"_31245":75229,"_5":31567,"_21577":128063,"_28435":128064,"_3074":125815},[],"/docs/es/platform/pki/overview#capacidades-principales",{"_3697":75234,"_31245":75229,"_5":31567,"_21577":128066,"_28435":128067,"_3074":125819},[],"/docs/es/platform/pki/overview#construye-tu-jerarquía-de-confianza",{"_3697":75235,"_31245":75229,"_5":31567,"_21577":128069,"_28435":128070,"_3074":125823},[],"/docs/es/platform/pki/overview#protege-las-claves-criptográficas",{"_3697":75236,"_31245":75229,"_5":31567,"_21577":128072,"_28435":128073,"_3074":125827},[],"/docs/es/platform/pki/overview#emite-y-controla-certificados",{"_3697":75237,"_31245":75229,"_5":31567,"_21577":128075,"_28435":128076,"_3074":125835},[],"/docs/es/platform/pki/overview#publica-el-estado-de-validación",{"_3697":75238,"_31245":75229,"_5":31567,"_21577":128078,"_28435":128079,"_3074":128080},[],"/docs/es/platform/pki/overview#cómo-comprobar-el-resultado","Cómo comprobar el resultado",{"_3697":75239,"_31245":75229,"_5":31567,"_21577":128082,"_28435":128083,"_3074":126806},[],"/docs/es/platform/pki/overview#continúa",{"_3697":75240,"_31245":75229,"_21577":128085,"_5":14884,"_28435":75229,"_3074":128086},[],"El bloque PKI explica cómo construir y operar la confianza X.509 de Lamassu: qué autoridades emiten, qué reglas aplican y cómo se comprueban los certificados. Está dirigido al administrador PKI y a quien necesita utilizar certificados en un sistema consumidor.",{"_3697":75241,"_31245":75229,"_21577":128088,"_5":14884,"_28435":128057,"_3074":128089},[],"Sigue Primeros pasos de PKI para crear una CA, emitir un certificado de cliente y verificarlo con OpenSSL. El resultado es un certificado, su clave privada y una cadena comprobada.",{"_3697":75242,"_31245":75229,"_21577":128091,"_5":14884,"_28435":128057,"_3074":128092},[],"Puedes completar ese recorrido antes de gestionar dispositivos. Cuando necesites asociar la identidad a un inventario o automatizar su enrolamiento, continúa en IoT Fleets.",{"_3697":75243,"_31245":75229,"_21577":128094,"_5":14884,"_28435":128060,"_3074":128095},[],"Una instancia accesible y permisos para gestionar las claves, CAs y certificados que usarás.",{"_3697":75244,"_31245":75229,"_21577":128097,"_5":14884,"_28435":128060,"_3074":128098},[],"Un motor criptográfico disponible para custodiar la clave de la autoridad.",{"_3697":75245,"_31245":75229,"_21577":128100,"_5":14884,"_28435":128060,"_3074":128101},[],"El propósito del certificado: por ejemplo, autenticar un cliente mediante mTLS.",{"_3697":75246,"_31245":75229,"_21577":128103,"_5":14884,"_28435":128060,"_3074":128104},[],"Los requisitos del consumidor: emisores aceptados, algoritmos, nombres y usos permitidos.",{"_3697":75247,"_31245":75229,"_21577":128106,"_5":14884,"_28435":128060,"_3074":128107},[],"La configuración de la instancia y del proveedor criptográfico se prepara en Despliegue. La elección de jerarquía se explica en el modelo de confianza.",{"_3697":75248,"_31245":75229,"_21577":128109,"_5":14884,"_28435":128067,"_3074":128110},[],"Las autoridades firman certificados. Una raíz establece el ancla de confianza y una intermedia permite separar la emisión por entorno o propósito. La jerarquía y rotación explica cómo mantener esa confianza al sustituir una autoridad.",{"_3697":75249,"_31245":75229,"_21577":128112,"_5":14884,"_28435":128070,"_3074":128113},[],"Las claves de firma de las CAs se gestionan mediante KMS y motores criptográficos. La clave de un cliente que genera una CSR puede permanecer en ese cliente: conserva su custodia al elegir el método de emisión.",{"_3697":75250,"_31245":75229,"_21577":128115,"_5":14884,"_28435":128073,"_3074":128116},[],"Un perfil establece restricciones de sujeto, validez, usos y claves. La CA aplica la configuración de emisión y firma el certificado. En el inventario puedes inspeccionar el resultado, descargarlo y gestionar su estado.",{"_3697":75251,"_31245":75229,"_21577":128118,"_5":14884,"_28435":128073,"_3074":128119},[],"Los protocolos de enrolamiento permiten que los clientes obtengan y renueven certificados de una CA de Lamassu.",{"_3697":75252,"_31245":75229,"_21577":128121,"_5":14884,"_28435":128076,"_3074":128122},[],"La validación reúne cadena, vigencia, usos y estado de revocación. Lamassu publica estado mediante OCSP y CRL; el consumidor configura qué emisores reconoce y cómo comprueba ese estado.",{"_3697":75253,"_31245":75229,"_21577":128124,"_5":14884,"_28435":128079,"_3074":128125},[],"Un certificado activo en la consola es una parte de la comprobación. Revisa también que:",{"_3697":75254,"_31245":75229,"_21577":128127,"_5":14884,"_28435":128079,"_3074":128128},[],"su sujeto y sus extensiones identifiquen al cliente esperado;",{"_3697":75255,"_31245":75229,"_21577":128130,"_5":14884,"_28435":128079,"_3074":128131},[],"su clave pública corresponda a la clave privada del cliente;",{"_3697":75256,"_31245":75229,"_21577":128133,"_5":14884,"_28435":128079,"_3074":128134},[],"su cadena alcance una raíz confiable para el consumidor;",{"_3697":75257,"_31245":75229,"_21577":128136,"_5":14884,"_28435":128079,"_3074":128137},[],"sus fechas y usos permitan la operación;",{"_3697":75258,"_31245":75229,"_21577":128139,"_5":14884,"_28435":128079,"_3074":128140},[],"el consumidor aplique la comprobación de revocación y su autorización.",{"_3697":75259,"_31245":75229,"_21577":128142,"_5":14884,"_28435":128079,"_3074":128143},[],"El recorrido de emisión incluye las primeras comprobaciones independientes.",{"_3697":75260,"_31245":75229,"_21577":128145,"_5":14884,"_28435":128083,"_3074":128146},[],"<Card title=\"Primeros pasos de PKI\" description=\"Crea una CA y emite y verifica un certificado de cliente.\" href=\"/docs/platform/pki/quickstarts/overview\" />",{"_3697":75261,"_31245":75229,"_21577":128148,"_5":14884,"_28435":128083,"_3074":128149},[],"<Card title=\"Aplica la PKI a dispositivos\" description=\"Asocia certificados al inventario y prepara el enrolamiento.\" href=\"/docs/platform/iot-fleets/overview\" />",{"_3697":75262,"_31245":75229,"_21577":128151,"_5":14884,"_28435":128083,"_3074":128152},[],"<Card title=\"Diagnóstico PKI\" description=\"Comprueba emisión, OCSP y CRL cuando el resultado falla.\" href=\"/docs/platform/pki/troubleshooting\" />",{"_3697":75263,"_31245":75263,"_5":15238,"_3074":128154,"_31570":128155,"_21577":128156,"_28435":75263},"Crea tu primera CA",[50948,121910,56713,125418],[],{"_3697":75264,"_31245":75263,"_21577":128158,"_5":14884,"_28435":75263,"_3074":128159},[],"Crea una raíz de evaluación y comprueba su certificado antes de emitir.",{"_3697":75265,"_31245":75263,"_5":31567,"_21577":128161,"_28435":128162,"_3074":120415},[],"/docs/es/platform/pki/quickstarts/create-certificate-authority#antes-de-empezar",{"_3697":75266,"_31245":75263,"_5":31567,"_21577":128164,"_28435":128165,"_3074":128166},[],"/docs/es/platform/pki/quickstarts/create-certificate-authority#abre-el-asistente-de-creación-toc","Abre el asistente de creación [!toc]",{"_3697":75267,"_31245":75263,"_5":31567,"_21577":128168,"_28435":128169,"_3074":128170},[],"/docs/es/platform/pki/quickstarts/create-certificate-authority#selecciona-la-clave-toc","Selecciona la clave [!toc]",{"_3697":75268,"_31245":75263,"_5":31567,"_21577":128172,"_28435":128173,"_3074":128174},[],"/docs/es/platform/pki/quickstarts/create-certificate-authority#define-la-autoridad-toc","Define la autoridad [!toc]",{"_3697":75269,"_31245":75263,"_5":31567,"_21577":128176,"_28435":128177,"_3074":128178},[],"/docs/es/platform/pki/quickstarts/create-certificate-authority#revisa-y-crea-la-ca-toc","Revisa y crea la CA [!toc]",{"_3697":75270,"_31245":75263,"_5":31567,"_21577":128180,"_28435":128181,"_3074":128182},[],"/docs/es/platform/pki/quickstarts/create-certificate-authority#verifica-el-resultado-toc","Verifica el resultado [!toc]",{"_3697":75271,"_31245":75263,"_5":31567,"_21577":128184,"_28435":128185,"_3074":128186},[],"/docs/es/platform/pki/quickstarts/create-certificate-authority#comprueba-el-certificado-de-ca","Comprueba el certificado de CA",{"_3697":75272,"_31245":75263,"_5":31567,"_21577":128188,"_28435":128189,"_3074":125666},[],"/docs/es/platform/pki/quickstarts/create-certificate-authority#si-el-resultado-falla",{"_3697":75273,"_31245":75263,"_5":31567,"_21577":128191,"_28435":128192,"_3074":120439},[],"/docs/es/platform/pki/quickstarts/create-certificate-authority#siguiente-paso",{"_3697":75274,"_31245":75263,"_21577":128194,"_5":14884,"_28435":75263,"_3074":128195},[],"Crearás una autoridad raíz con una clave nueva custodiada por un motor de Lamassu. Al terminar tendrás una CA activa y su certificado público en `ca.pem`, preparado para verificar la emisión del siguiente recorrido.",{"_3697":75275,"_31245":75263,"_21577":128197,"_5":14884,"_28435":128162,"_3074":128198},[],"Acceso a la consola y permisos para crear claves y autoridades.",{"_3697":75276,"_31245":75263,"_21577":128200,"_5":14884,"_28435":128162,"_3074":128201},[],"Un motor criptográfico disponible que admita el algoritmo elegido.",{"_3697":75277,"_31245":75263,"_21577":128203,"_5":14884,"_28435":128162,"_3074":128204},[],"OpenSSL 3.x para comprobar el certificado descargado.",{"_3697":75278,"_31245":75263,"_21577":128206,"_5":14884,"_28435":128162,"_3074":128207},[],"Utiliza una instancia de evaluación o una autoridad destinada a estas pruebas. El ejemplo crea una raíz que emite directamente; para diseñar una jerarquía operativa, consulta Jerarquía y rotación.",{"_3697":75279,"_31245":75263,"_21577":128209,"_5":14884,"_28435":128165,"_3074":128210},[],"En **Certification Authorities**, selecciona **Create New CA** y elige crear una CA con un par de claves nuevo.",{"_3697":75280,"_31245":75263,"_21577":128212,"_5":14884,"_28435":128165,"_3074":128213},[],"El flujo &#x2A;*Create New CA (Existing Key)** se explica en la guía de autoridades.",{"_3697":75281,"_31245":75263,"_21577":128215,"_5":14884,"_28435":128169,"_3074":128216},[],"Elige el motor que custodiará la clave y un algoritmo permitido por sus capacidades. Para este ejemplo puedes utilizar **EC P-384** si está disponible.",{"_3697":75282,"_31245":75263,"_21577":128218,"_5":14884,"_28435":128169,"_3074":128219},[],"La clave privada de la CA se utiliza a través del motor. En este recorrido descargarás únicamente el certificado público de la autoridad.",{"_3697":75283,"_31245":75263,"_21577":128221,"_5":14884,"_28435":128173,"_3074":128222},[],"Selecciona **Root CA** y completa:",{"_3697":75284,"_31245":75263,"_21577":128224,"_5":14884,"_28435":128173,"_3074":59003},[],{"_3697":75285,"_31245":75263,"_21577":128226,"_5":14884,"_28435":128173,"_3074":128227},[],"**Subject**: los datos de organización y país de tu evaluación.",{"_3697":75286,"_31245":75263,"_21577":128229,"_5":14884,"_28435":128173,"_3074":128230},[],"**CA Certificate Expiration**: por ejemplo, un año desde la creación.",{"_3697":75287,"_31245":75263,"_21577":128232,"_5":14884,"_28435":128173,"_3074":128233},[],"**Default End-Entity Certificate Issuance Expiration**: por ejemplo, 90 días, dentro de la vigencia de la CA.",{"_3697":75288,"_31245":75263,"_21577":128235,"_5":14884,"_28435":128173,"_3074":128236},[],"El nombre de la CA se utilizará como `Common Name`. Mantén los usos de CA necesarios para firmar certificados y CRLs.",{"_3697":75289,"_31245":75263,"_21577":128238,"_5":14884,"_28435":128177,"_3074":128239},[],"Comprueba motor, algoritmo, sujeto, tipo raíz y fechas. Confirma la creación y anota el identificador de la autoridad para reconocerla en el DMS o en la API.",{"_3697":75290,"_31245":75263,"_21577":128241,"_5":14884,"_28435":128181,"_3074":128242},[],"Abre la nueva CA. Debe aparecer activa, mostrar su certificado y permitir acceder a **Issued Certificates**.",{"_3697":75291,"_31245":75263,"_21577":128244,"_5":14884,"_28435":128181,"_3074":128245},[],"Descarga o copia el certificado PEM de la autoridad y guárdalo como `ca.pem`. Comprueba que el archivo contiene el bloque completo, incluidos `BEGIN CERTIFICATE` y `END CERTIFICATE`.",{"_3697":75292,"_31245":75263,"_21577":128247,"_5":14884,"_28435":128185,"_3074":128248},[],"Ejecuta desde el directorio donde guardaste `ca.pem`:",{"_3697":75293,"_31245":75263,"_21577":128250,"_5":14884,"_28435":128185,"_3074":128251},[],"Comprueba que sujeto y emisor corresponden a la raíz creada, las fechas incluyen el momento actual, **Basic Constraints** contiene `CA:TRUE` y **Key Usage** permite firmar certificados. El último comando debe devolver `ca.pem: OK`.",{"_3697":75294,"_31245":75263,"_21577":128253,"_5":14884,"_28435":128185,"_3074":128254},[],"Has elegido explícitamente `ca.pem` como ancla de esta prueba. Que la autofirma sea válida no instala esa confianza en otros consumidores. Consulta la referencia de openssl-verify para las opciones de comprobación.",{"_3697":75295,"_31245":75263,"_21577":128256,"_5":14884,"_28435":128189,"_3074":128257},[],"Si la creación falla, comprueba permisos, disponibilidad del motor y algoritmo seleccionado.",{"_3697":75296,"_31245":75263,"_21577":128259,"_5":14884,"_28435":128189,"_3074":128260},[],"Si OpenSSL no lee el archivo, vuelve a copiar el bloque PEM completo.",{"_3697":75297,"_31245":75263,"_21577":128262,"_5":14884,"_28435":128189,"_3074":128263},[],"Si fallan la firma o las fechas, revisa que hayas descargado el certificado de esta CA y que el reloj del equipo sea correcto.",{"_3697":75298,"_31245":75263,"_21577":128265,"_5":14884,"_28435":128189,"_3074":128266},[],"El diagnóstico PKI reúne las comprobaciones de emisión y dependencias criptográficas.",{"_3697":75299,"_31245":75263,"_21577":128268,"_5":14884,"_28435":128192,"_3074":128269},[],"Continúa con Emite y verifica un certificado, utilizando esta autoridad y `ca.pem`.",{"_3697":75300,"_31245":75300,"_5":15238,"_3074":128271,"_31570":128272,"_21577":128273,"_28435":75300},"Emite y verifica un certificado",[50948,121910,56713,125418],[],{"_3697":75301,"_31245":75300,"_21577":128275,"_5":14884,"_28435":75300,"_3074":128276},[],"Emite un certificado de cliente y comprueba contenido, cadena y correspondencia de clave.",{"_3697":75302,"_31245":75300,"_5":31567,"_21577":128278,"_28435":128279,"_3074":120415},[],"/docs/es/platform/pki/quickstarts/issue-certificate#antes-de-empezar",{"_3697":75303,"_31245":75300,"_5":31567,"_21577":128281,"_28435":128282,"_3074":128283},[],"/docs/es/platform/pki/quickstarts/issue-certificate#inicia-la-emisión","Inicia la emisión",{"_3697":75304,"_31245":75300,"_5":31567,"_21577":128285,"_28435":128286,"_3074":128287},[],"/docs/es/platform/pki/quickstarts/issue-certificate#elige-el-método","Elige el método",{"_3697":75305,"_31245":75300,"_5":31567,"_21577":128289,"_28435":128290,"_3074":128291},[],"/docs/es/platform/pki/quickstarts/issue-certificate#identifica-el-certificado","Identifica el certificado",{"_3697":75306,"_31245":75300,"_5":31567,"_21577":128293,"_28435":128294,"_3074":128295},[],"/docs/es/platform/pki/quickstarts/issue-certificate#configura-clave-y-usos","Configura clave y usos",{"_3697":75307,"_31245":75300,"_5":31567,"_21577":128297,"_28435":128298,"_3074":128299},[],"/docs/es/platform/pki/quickstarts/issue-certificate#emite-y-descarga","Emite y descarga",{"_3697":75308,"_31245":75300,"_5":31567,"_21577":128301,"_28435":128302,"_3074":128303},[],"/docs/es/platform/pki/quickstarts/issue-certificate#verifica-el-resultado","Verifica el resultado",{"_3697":75309,"_31245":75300,"_5":31567,"_21577":128305,"_28435":128306,"_3074":128307},[],"/docs/es/platform/pki/quickstarts/issue-certificate#inspecciona-contenido-y-fechas","Inspecciona contenido y fechas",{"_3697":75310,"_31245":75300,"_5":31567,"_21577":128309,"_28435":128310,"_3074":128311},[],"/docs/es/platform/pki/quickstarts/issue-certificate#verifica-la-cadena","Verifica la cadena",{"_3697":75311,"_31245":75300,"_5":31567,"_21577":128313,"_28435":128314,"_3074":128315},[],"/docs/es/platform/pki/quickstarts/issue-certificate#comprueba-que-la-clave-corresponde","Comprueba que la clave corresponde",{"_3697":75312,"_31245":75300,"_5":31567,"_21577":128317,"_28435":128318,"_3074":125666},[],"/docs/es/platform/pki/quickstarts/issue-certificate#si-el-resultado-falla",{"_3697":75313,"_31245":75300,"_5":31567,"_21577":128320,"_28435":128321,"_3074":120439},[],"/docs/es/platform/pki/quickstarts/issue-certificate#siguiente-paso",{"_3697":75314,"_31245":75300,"_21577":128323,"_5":14884,"_28435":75300,"_3074":128324},[],"Emitirás un certificado final para `device-001` mediante el flujo de generación de clave y CSR en el navegador. Al terminar conservarás `device.crt`, `device.key` y el certificado público de la raíz emisora, `ca.pem`.",{"_3697":75315,"_31245":75300,"_21577":128326,"_5":14884,"_28435":128279,"_3074":128327},[],"Una CA raíz activa con clave de firma disponible y permisos para emitir. Si todavía no existe, sigue Crea tu primera CA.",{"_3697":75316,"_31245":75300,"_21577":128329,"_5":14884,"_28435":128279,"_3074":128330},[],"Su certificado público en `ca.pem`; este ejemplo utiliza la raíz creada en el recorrido anterior.",{"_3697":75317,"_31245":75300,"_21577":128332,"_5":14884,"_28435":128279,"_3074":128333},[],"OpenSSL 3.x y un directorio de trabajo con acceso restringido.",{"_3697":75318,"_31245":75300,"_21577":128335,"_5":14884,"_28435":128279,"_3074":128336},[],"Un identificador para el cliente: aquí usaremos `device-001`.",{"_3697":75319,"_31245":75300,"_21577":128338,"_5":14884,"_28435":128279,"_3074":128339},[],"En este flujo la clave del cliente se genera en el navegador y debes descargarla al finalizar. Si la pierdes, tendrás que generar una clave y emitir otro certificado. El inventario de certificados permite descargar el certificado público, pero no recuperar esta clave.",{"_3697":75320,"_31245":75300,"_21577":128341,"_5":14884,"_28435":128282,"_3074":128342},[],"Abre la CA del recorrido anterior, entra en **Issued Certificates** y selecciona **Issue New**.",{"_3697":75321,"_31245":75300,"_21577":128344,"_5":14884,"_28435":128286,"_3074":128345},[],"Selecciona **Generate Key & CSR in Browser** para seguir este ejemplo.",{"_3697":75322,"_31245":75300,"_21577":128347,"_5":14884,"_28435":128286,"_3074":128348},[],"Si la clave debe generarse y permanecer en el sistema de destino, utiliza **Upload Existing CSR**, descrito en la guía de autoridades.",{"_3697":75323,"_31245":75300,"_21577":128350,"_5":14884,"_28435":128290,"_3074":128351},[],"Introduce `device-001` como `Common Name`. Añade los datos de sujeto requeridos por tu política y SANs si el consumidor los utiliza para identificar al cliente.",{"_3697":75324,"_31245":75300,"_21577":128353,"_5":14884,"_28435":128290,"_3074":128354},[],"Si vas a continuar con el registro manual, el `Device ID` será exactamente `device-001`.",{"_3697":75325,"_31245":75300,"_21577":128356,"_5":14884,"_28435":128294,"_3074":128357},[],"Elige un algoritmo y tamaño admitidos por el perfil; por ejemplo, ECDSA P-256 si está permitido. Para este certificado de cliente, selecciona **Digital Signature** y **Client Authentication** y emite como certificado final.",{"_3697":75326,"_31245":75300,"_21577":128359,"_5":14884,"_28435":128294,"_3074":128360},[],"Solicita, por ejemplo, 30 días de validez, siempre dentro de la vigencia de la CA. Revisa el perfil de emisión si el contenido resultante difiere de lo solicitado.",{"_3697":75327,"_31245":75300,"_21577":128362,"_5":14884,"_28435":128298,"_3074":128363},[],"Confirma la emisión. Guarda el certificado PEM como `device.crt` y la clave privada como `device.key` en el directorio preparado.",{"_3697":75328,"_31245":75300,"_21577":128365,"_5":14884,"_28435":128302,"_3074":128366},[],"Comprueba en **Issued Certificates** que el certificado aparece activo. Anota su número de serie y verifica el material descargado con las comprobaciones siguientes.",{"_3697":75329,"_31245":75300,"_21577":128368,"_5":14884,"_28435":128306,"_3074":128369},[],"Comprueba `CN=device-001`, el emisor esperado, fechas vigentes, **Digital Signature** y el uso extendido **TLS Web Client Authentication**. Debe ser un certificado final: no debe declarar `CA:TRUE` ni habilitar **Certificate Sign**. Si **Basic Constraints** está presente, debe indicar `CA:FALSE`. Si solicitaste SANs, revisa que los identificadores esperados aparezcan en el certificado.",{"_3697":75330,"_31245":75300,"_21577":128371,"_5":14884,"_28435":128310,"_3074":128372},[],"El resultado esperado es `device.crt: OK`. Esta comprobación utiliza tu raíz explícita y evalúa la cadena, las fechas y la compatibilidad con el propósito de cliente TLS. La presencia de los usos y nombres esperados se comprueba también mediante la inspección anterior.",{"_3697":75331,"_31245":75300,"_21577":128374,"_5":14884,"_28435":128310,"_3074":128375},[],"Si utilizas una CA intermedia, la raíz confiable debe estar en `ca.pem` y debes aportar las intermedias mediante `-untrusted intermediates.pem`. Esta variante se desarrolla en el modelo de confianza.",{"_3697":75332,"_31245":75300,"_21577":128377,"_5":14884,"_28435":128310,"_3074":128378},[],"El comando no consulta OCSP ni CRL. Para comprobar revocación, continúa con Validación de certificados. Consulta la referencia de openssl-verify para sus opciones.",{"_3697":75333,"_31245":75300,"_21577":128380,"_5":14884,"_28435":128314,"_3074":128381},[],"En Bash, compara los dos resúmenes de clave pública:",{"_3697":75334,"_31245":75300,"_21577":128383,"_5":14884,"_28435":128314,"_3074":128384},[],"Ambos comandos deben terminar correctamente y mostrar el mismo resumen SHA-256. Si difieren, la clave privada no corresponde al certificado seleccionado. Vuelve a localizar la pareja correcta antes de instalarla.",{"_3697":75335,"_31245":75300,"_21577":128386,"_5":14884,"_28435":128314,"_3074":128387},[],"Las opciones utilizadas se recogen en openssl-x509 y openssl-pkey.",{"_3697":75336,"_31245":75300,"_21577":128389,"_5":14884,"_28435":128318,"_3074":125749},[],{"_3697":75337,"_31245":75300,"_21577":128391,"_5":14884,"_28435":128318,"_3074":124357},[],{"_3697":75338,"_31245":75300,"_21577":128393,"_5":14884,"_28435":128318,"_3074":128394},[],"La CA rechaza la emisión",{"_3697":75339,"_31245":75300,"_21577":128396,"_5":14884,"_28435":128318,"_3074":128397},[],"Permisos, estado y clave de la CA, algoritmo y perfil.",{"_3697":75340,"_31245":75300,"_21577":128399,"_5":14884,"_28435":128318,"_3074":128400},[],"Sujeto o usos diferentes",{"_3697":75341,"_31245":75300,"_21577":128402,"_5":14884,"_28435":128318,"_3074":128403},[],"Perfil aplicado y valores solicitados.",{"_3697":75342,"_31245":75300,"_21577":128405,"_5":14884,"_28435":128318,"_3074":128406},[],"No se encuentra el emisor",{"_3697":75343,"_31245":75300,"_21577":128408,"_5":14884,"_28435":128318,"_3074":128409},[],"CA descargada y cadena intermedia necesaria.",{"_3697":75344,"_31245":75300,"_21577":128411,"_5":14884,"_28435":128318,"_3074":128412},[],"Falla la vigencia",{"_3697":75345,"_31245":75300,"_21577":128414,"_5":14884,"_28435":128318,"_3074":128415},[],"Fechas del certificado y de la CA, y reloj del equipo.",{"_3697":75346,"_31245":75300,"_21577":128417,"_5":14884,"_28435":128318,"_3074":128418},[],"Los resúmenes de clave difieren",{"_3697":75347,"_31245":75300,"_21577":128420,"_5":14884,"_28435":128318,"_3074":128421},[],"Archivos de certificado y clave de la misma emisión.",{"_3697":75348,"_31245":75300,"_21577":128423,"_5":14884,"_28435":128318,"_3074":128424},[],"Consulta Diagnóstico PKI si necesitas acotar un fallo de emisión.",{"_3697":75349,"_31245":75300,"_21577":128426,"_5":14884,"_28435":128321,"_3074":128427},[],"Has completado el recorrido PKI cuando el certificado verifica y su clave corresponde. Elige cómo utilizarlo:",{"_3697":75350,"_31245":75300,"_21577":128429,"_5":14884,"_28435":128321,"_3074":128430},[],"Gestionar certificados para inspección, estado y revocación.",{"_3697":75351,"_31245":75300,"_21577":128432,"_5":14884,"_28435":128321,"_3074":128433},[],"Registrar un dispositivo manualmente para asociar esta identidad al inventario de Lamassu.",{"_3697":75352,"_31245":75300,"_21577":128435,"_5":14884,"_28435":128321,"_3074":128436},[],"Preparar EST para que el dispositivo solicite sus siguientes identidades.",{"_3697":75353,"_31245":75300,"_21577":128438,"_5":14884,"_28435":128321,"_3074":128439},[],"La aceptación en un consumidor requiere configurar su confianza, su comprobación de revocación y los permisos concedidos a la identidad.",{"_3697":75354,"_31245":75354,"_5":15238,"_3074":128441,"_31570":128442,"_21577":128443,"_28435":75354},"Primeros pasos de PKI",[50948,121910,56713,125418],[],{"_3697":75355,"_31245":75354,"_21577":128445,"_5":14884,"_28435":75354,"_3074":128446},[],"Crea una CA, emite un certificado de cliente y comprueba su cadena y su clave.",{"_3697":75356,"_31245":75354,"_5":31567,"_21577":128448,"_28435":128449,"_3074":120415},[],"/docs/es/platform/pki/quickstarts/overview#antes-de-empezar",{"_3697":75357,"_31245":75354,"_5":31567,"_21577":128451,"_28435":128452,"_3074":128453},[],"/docs/es/platform/pki/quickstarts/overview#ruta-recomendada","Ruta recomendada",{"_3697":75358,"_31245":75354,"_5":31567,"_21577":128455,"_28435":128456,"_3074":125601},[],"/docs/es/platform/pki/quickstarts/overview#resultado-esperado",{"_3697":75359,"_31245":75354,"_5":31567,"_21577":128458,"_28435":128459,"_3074":128460},[],"/docs/es/platform/pki/quickstarts/overview#continúa-según-tu-objetivo","Continúa según tu objetivo",{"_3697":75360,"_31245":75354,"_21577":128462,"_5":14884,"_28435":75354,"_3074":128463},[],"Este recorrido está dirigido a quien empieza a administrar la PKI o necesita una primera identidad X.509 de cliente. Termina con tres archivos: el certificado de una CA raíz, un certificado final y la clave privada de ese cliente.",{"_3697":75361,"_31245":75354,"_21577":128465,"_5":14884,"_28435":128449,"_3074":128466},[],"Una instancia de Lamassu accesible desde el navegador. Si necesitas prepararla, consulta Despliegue.",{"_3697":75362,"_31245":75354,"_21577":128468,"_5":14884,"_28435":128449,"_3074":128469},[],"Permisos para gestionar claves, autoridades y emisión. Consulta Control de acceso si una operación está bloqueada.",{"_3697":75363,"_31245":75354,"_21577":128471,"_5":14884,"_28435":128449,"_3074":128472},[],"Un motor criptográfico disponible para la clave de la CA; comprueba el inventario de claves y motores.",{"_3697":75364,"_31245":75354,"_21577":128474,"_5":14884,"_28435":128449,"_3074":128475},[],"OpenSSL 3.x en el equipo desde el que verificarás los archivos.",{"_3697":75365,"_31245":75354,"_21577":128477,"_5":14884,"_28435":128449,"_3074":128478},[],"Un directorio de trabajo con acceso restringido para custodiar la clave descargada.",{"_3697":75366,"_31245":75354,"_21577":128480,"_5":14884,"_28435":128452,"_3074":128481},[],"<Card title=\"1. Crea tu primera CA\" description=\"Crea una raíz de evaluación y guarda su certificado público como ca.pem.\" href=\"/docs/platform/pki/quickstarts/create-certificate-authority\" />",{"_3697":75367,"_31245":75354,"_21577":128483,"_5":14884,"_28435":128452,"_3074":128484},[],"<Card title=\"2. Emite y verifica un certificado\" description=\"Emite para device-001 y comprueba contenido, cadena y correspondencia de clave.\" href=\"/docs/platform/pki/quickstarts/issue-certificate\" />",{"_3697":75368,"_31245":75354,"_21577":128486,"_5":14884,"_28435":128452,"_3074":128487},[],"Usaremos `Acme Evaluation Root CA` y `device-001` como nombres de ejemplo. Si los sustituyes, conserva el mismo identificador de cliente en los pasos que quieras conectar.",{"_3697":75369,"_31245":75354,"_21577":128489,"_5":14884,"_28435":128452,"_3074":128490},[],"La raíz de este recorrido firma directamente el certificado final para facilitar la evaluación. Antes de diseñar una PKI operativa, revisa el modelo de confianza y la jerarquía de CAs.",{"_3697":75370,"_31245":75354,"_21577":128492,"_5":14884,"_28435":128456,"_3074":128493},[],"Archivo o recurso",{"_3697":75371,"_31245":75354,"_21577":128495,"_5":14884,"_28435":128456,"_3074":125598},[],{"_3697":75372,"_31245":75354,"_21577":128497,"_5":14884,"_28435":128456,"_3074":128498},[],"CA raíz activa y `ca.pem`",{"_3697":75373,"_31245":75354,"_21577":128500,"_5":14884,"_28435":128456,"_3074":128501},[],"Es un certificado de CA, está vigente y su autofirma se comprueba.",{"_3697":75374,"_31245":75354,"_21577":128503,"_5":14884,"_28435":128456,"_3074":128504},[],"Certificado final y `device.crt`",{"_3697":75375,"_31245":75354,"_21577":128506,"_5":14884,"_28435":128456,"_3074":128507},[],"Identifica a `device-001`, admite autenticación de cliente y verifica hasta `ca.pem`.",{"_3697":75376,"_31245":75354,"_21577":128509,"_5":14884,"_28435":128456,"_3074":128510},[],"Clave privada `device.key`",{"_3697":75377,"_31245":75354,"_21577":128512,"_5":14884,"_28435":128456,"_3074":128513},[],"Su clave pública coincide con la incluida en `device.crt`.",{"_3697":75378,"_31245":75354,"_21577":128515,"_5":14884,"_28435":128456,"_3074":128516},[],"Estas comprobaciones validan el material emitido. La aceptación en un servicio requiere además su configuración de confianza, autorización y revocación.",{"_3697":75379,"_31245":75354,"_21577":128518,"_5":14884,"_28435":128459,"_3074":128519},[],"Para operar certificados, continúa con Certificados y Validación.",{"_3697":75380,"_31245":75354,"_21577":128521,"_5":14884,"_28435":128459,"_3074":128522},[],"Para gestionar una identidad de dispositivo en Lamassu, sigue Registro manual. Ese recorrido incluye la preparación del DMS.",{"_3697":75381,"_31245":75354,"_21577":128524,"_5":14884,"_28435":128459,"_3074":128525},[],"Para que el dispositivo solicite su certificado, prepara el DMS y el cliente EST.",{"_3697":75382,"_31245":75382,"_5":15238,"_3074":128527,"_31570":128528,"_21577":128530,"_28435":75382},"Resolución de problemas PKI",[50948,121910,56713,128529],"Resolución de problemas",[],{"_3697":75383,"_31245":75382,"_21577":128532,"_5":14884,"_28435":75382,"_3074":128533},[],"Diagnostica emisión de certificados, OCSP y CRL.",{"_3697":75384,"_31245":75382,"_5":31567,"_21577":128535,"_28435":128536,"_3074":128537},[],"/docs/es/platform/pki/troubleshooting#la-emisión-falla","La emisión falla",{"_3697":75385,"_31245":75382,"_5":31567,"_21577":128539,"_28435":128540,"_3074":128541},[],"/docs/es/platform/pki/troubleshooting#ocsp-o-crl-no-reflejan-un-cambio","OCSP o CRL no reflejan un cambio",{"_3697":75386,"_31245":75382,"_5":31567,"_21577":128543,"_28435":128544,"_3074":128545},[],"/docs/es/platform/pki/troubleshooting#la-cadena-se-valida-pero-la-conexión-falla","La cadena se valida pero la conexión falla",{"_3697":75387,"_31245":75382,"_21577":128547,"_5":14884,"_28435":75382,"_3074":128548},[],"Esta guía ayuda al operador PKI a localizar fallos de emisión y publicación de estado. Conserva versión de Lamassu, operación, CA, emisor, serie, hora y error devuelto. No incluyas claves privadas ni tokens en el diagnóstico.",{"_3697":75388,"_31245":75382,"_21577":128550,"_5":14884,"_28435":75382,"_3074":128551},[],"Para Gateway, inicio de sesión, pods, dependencias y mensajería, consulta Diagnóstico de Despliegue. Para enrolamiento de dispositivos, consulta Diagnóstico EST.",{"_3697":75389,"_31245":75382,"_21577":128553,"_5":14884,"_28435":128536,"_3074":125598},[],{"_3697":75390,"_31245":75382,"_21577":128555,"_5":14884,"_28435":128536,"_3074":124357},[],{"_3697":75391,"_31245":75382,"_21577":128557,"_5":14884,"_28435":128536,"_3074":120439},[],{"_3697":75392,"_31245":75382,"_21577":128559,"_5":14884,"_28435":128536,"_3074":55554},[],{"_3697":75393,"_31245":75382,"_21577":128561,"_5":14884,"_28435":128536,"_3074":128562},[],"Existe, está activa y sus fechas son utilizables.",{"_3697":75394,"_31245":75382,"_21577":128564,"_5":14884,"_28435":128536,"_3074":128565},[],"Autoridades.",{"_3697":75395,"_31245":75382,"_21577":128567,"_5":14884,"_28435":128536,"_3074":128568},[],"Clave",{"_3697":75396,"_31245":75382,"_21577":128570,"_5":14884,"_28435":128536,"_3074":128571},[],"El registro tiene clave privada utilizable y el motor puede firmar.",{"_3697":75397,"_31245":75382,"_21577":128573,"_5":14884,"_28435":128536,"_3074":128574},[],"Prueba **Sign / Verify** en KMS; revisa permisos y disponibilidad del proveedor.",{"_3697":75398,"_31245":75382,"_21577":128576,"_5":14884,"_28435":128536,"_3074":59357},[],{"_3697":75399,"_31245":75382,"_21577":128578,"_5":14884,"_28435":128536,"_3074":128579},[],"PEM correcto y firma verificable.",{"_3697":75400,"_31245":75382,"_21577":128581,"_5":14884,"_28435":128536,"_3074":59363},[],{"_3697":75401,"_31245":75382,"_21577":128583,"_5":14884,"_28435":128536,"_3074":128584},[],"Perfil",{"_3697":75402,"_31245":75382,"_21577":128586,"_5":14884,"_28435":128536,"_3074":128587},[],"Fuente seleccionada, ID existente, algoritmo y tamaño admitidos.",{"_3697":75403,"_31245":75382,"_21577":128589,"_5":14884,"_28435":128536,"_3074":128590},[],"Revisa la precedencia de Perfiles; CA y DMS resuelven de forma distinta.",{"_3697":75404,"_31245":75382,"_21577":128592,"_5":14884,"_28435":128536,"_3074":125749},[],{"_3697":75405,"_31245":75382,"_21577":128594,"_5":14884,"_28435":128536,"_3074":128595},[],"Sujeto, SAN, usos y fechas adecuados.",{"_3697":75406,"_31245":75382,"_21577":128597,"_5":14884,"_28435":128536,"_3074":128598},[],"Compara CSR, perfil y certificado; emitir correctamente no demuestra aceptación por el consumidor.",{"_3697":75407,"_31245":75382,"_21577":128600,"_5":14884,"_28435":128536,"_3074":128601},[],"Si el certificado emitido tiene campos inesperados, revisa `Honor Subject`, `Honor Key Usage`, `Honor Extended Key Usages` y `Honor Extensions`. Esta última solo conserva SAN, sin validar el derecho a esos nombres. La validez no se recorta automáticamente al vencimiento de la CA.",{"_3697":75408,"_31245":75382,"_21577":128603,"_5":14884,"_28435":128536,"_3074":128604},[],"Si la emisión falla con `400` y `CA Status inconsistent`, la CA emisora no está `ACTIVE` o está fuera del periodo de validez de su certificado. El estado almacenado puede ir por detrás de las fechas hasta que se ejecuta el monitor de expiración, así que comprueba también las fechas. Reemite la CA mientras siga vigente o emite desde otra CA.",{"_3697":75409,"_31245":75382,"_21577":128606,"_5":14884,"_28435":128536,"_3074":128607},[],"Si falla la reemisión de una CA, comprueba revocación y fecha: no se admite para una CA revocada o ya vencida. Si es subordinada, comprueba también el estado y las fechas de su CA padre. Para cambiar la clave, utiliza Jerarquía y rotación.",{"_3697":75410,"_31245":75382,"_21577":128609,"_5":14884,"_28435":128540,"_3074":128610},[],"Revisa cada frontera por separado:",{"_3697":75411,"_31245":75382,"_21577":128612,"_5":14884,"_28435":128540,"_3074":128613},[],"**Registro:** vuelve a leer el certificado correcto por serie y emisor. Confirma estado, razón y hora; los registros expirados o revocados definitivamente no admiten otra transición.",{"_3697":75412,"_31245":75382,"_21577":128615,"_5":14884,"_28435":128540,"_3074":128616},[],"**Endpoint:** inspecciona AIA y CDP del certificado. Consulta esas URLs desde la red del consumidor; una ruta antigua o un emisor incorrecto puede explicar la diferencia.",{"_3697":75413,"_31245":75382,"_21577":128618,"_5":14884,"_28435":128540,"_3074":128619},[],"**OCSP:** guarda una respuesta nueva, verifica firma y tiempos y observa su estado. Un error HTTP por una serie ausente no equivale a `Good` ni garantiza un `Unknown` firmado.",{"_3697":75414,"_31245":75382,"_21577":128621,"_5":14884,"_28435":128540,"_3074":128622},[],"**CRL:** compara `latest_crl`, número y tiempos de la lista descargada. Confirma la serie en el contenido. Si no cambia, revisa `regenerate_on_revoke`, entrega del evento, trabajos, firma y almacenamiento con el operador de Despliegue.",{"_3697":75415,"_31245":75382,"_21577":128624,"_5":14884,"_28435":128540,"_3074":128625},[],"**Cliente:** comprueba caché, política ante evidencia vencida o no disponible, extensión IDP crítica y rechazo de una conexión nueva.",{"_3697":75416,"_31245":75382,"_21577":128627,"_5":14884,"_28435":128540,"_3074":128628},[],"Una reactivación desde `CertificateHold` requiere una CRL nueva para que el cliente deje de ver la suspensión. Una suspensión en cascada desde una CA se levanta reactivando esa CA; la cascada de una CA revocada definitivamente no. Revisa todos los estados y los errores individuales de la operación.",{"_3697":75417,"_31245":75382,"_21577":128630,"_5":14884,"_28435":128544,"_3074":128631},[],"Comprueba la identidad esperada, SAN, KU/EKU, clave correspondiente, intermedias enviadas y permisos del consumidor. Diferencia confianza TLS en el servidor, autenticación del cliente y autorización de la acción. Sigue Validación para una prueba positiva y otras de rechazo.",{"_3697":75418,"_31245":75382,"_21577":128633,"_5":14884,"_28435":128544,"_3074":128634},[],"Cuando necesites escalar un problema, entrega los identificadores, error y evidencia pública relevante, con tiempos de consulta y versión. Esto permite distinguir un fallo de emisión, de publicación o de la aplicación consumidora.",{"_3697":75419,"_31245":75419,"_5":15238,"_3074":128636,"_31570":128637,"_21577":128638,"_28435":75419},"Seguridad",[50948],[],{"_3697":75420,"_31245":75419,"_21577":128640,"_5":14884,"_28435":75419,"_3074":128641},[],"Cómo reportar de forma privada una vulnerabilidad de seguridad en Lamassu, qué incluir en el reporte y qué releases reciben correcciones de seguridad.",{"_3697":75421,"_31245":75419,"_5":31567,"_21577":128643,"_28435":128644,"_3074":128645},[],"/docs/es/security#cómo-reportar-una-vulnerabilidad","Cómo reportar una vulnerabilidad",{"_3697":75422,"_31245":75419,"_5":31567,"_21577":128647,"_28435":128648,"_3074":128649},[],"/docs/es/security#qué-incluir-en-un-reporte","Qué incluir en un reporte",{"_3697":75423,"_31245":75419,"_5":31567,"_21577":128651,"_28435":128652,"_3074":128653},[],"/docs/es/security#versiones-soportadas","Versiones soportadas",{"_3697":75424,"_31245":75419,"_5":31567,"_21577":128655,"_28435":128656,"_3074":128657},[],"/docs/es/security#divulgación-responsable","Divulgación responsable",{"_3697":75425,"_31245":75419,"_21577":128659,"_5":14884,"_28435":75419,"_3074":128660},[],"¿Has encontrado una vulnerabilidad de seguridad en lamassuiot, lamassu-dashboard o lamassu-helm? Esta página explica cómo reportarla de forma privada, qué incluir en tu reporte y qué releases reciben correcciones de seguridad.",{"_3697":75426,"_31245":75419,"_21577":128662,"_5":14884,"_28435":128644,"_3074":128663},[],"No reportes vulnerabilidades de seguridad mediante issues, discusiones o pull requests públicos de GitHub. Un reporte público divulga el problema antes de que los mantenedores puedan corregirlo.",{"_3697":75427,"_31245":75419,"_21577":128665,"_5":14884,"_28435":128644,"_3074":128666},[],"En su lugar, reporta de forma privada mediante GitHub Security Advisories para el repositorio afectado:",{"_3697":75428,"_31245":75419,"_21577":128668,"_5":14884,"_28435":128644,"_3074":15494},[],{"_3697":75429,"_31245":75419,"_21577":128670,"_5":14884,"_28435":128644,"_3074":15435},[],{"_3697":75430,"_31245":75419,"_21577":128672,"_5":14884,"_28435":128644,"_3074":15481},[],{"_3697":75431,"_31245":75419,"_21577":128674,"_5":14884,"_28435":128644,"_3074":128675},[],"Así los mantenedores pueden evaluar y resolver el problema antes de que se publique.",{"_3697":75432,"_31245":75419,"_21577":128677,"_5":14884,"_28435":128644,"_3074":128678},[],"Si el reporte privado de vulnerabilidades no está habilitado en ese repositorio, reporta la vulnerabilidad de forma privada a lamassuiot\\@lksnext.com antes de divulgar cualquier detalle públicamente.",{"_3697":75433,"_31245":75419,"_21577":128680,"_5":14884,"_28435":128648,"_3074":128681},[],"Describe la vulnerabilidad, su impacto potencial y los pasos para reproducirla usando ejemplos no sensibles y anonimizados.",{"_3697":75434,"_31245":75419,"_21577":128683,"_5":14884,"_28435":128648,"_3074":128684},[],"No incluyas en el reporte:",{"_3697":75435,"_31245":75419,"_21577":128686,"_5":14884,"_28435":128648,"_3074":128687},[],"Credenciales, tokens o claves privadas",{"_3697":75436,"_31245":75419,"_21577":128689,"_5":14884,"_28435":128648,"_3074":128690},[],"Datos de clientes o información identificable de clientes",{"_3697":75437,"_31245":75419,"_21577":128692,"_5":14884,"_28435":128648,"_3074":128693},[],"Detalles confidenciales de arquitectura o de infraestructura interna",{"_3697":75438,"_31245":75419,"_21577":128695,"_5":14884,"_28435":128652,"_3074":128696},[],"Solo el último release estable recibe soporte de seguridad. El soporte de un release estable termina cuando se publica el siguiente release estable. Los releases anteriores y los pre-releases no tienen soporte.",{"_3697":75439,"_31245":75419,"_21577":128698,"_5":14884,"_28435":128652,"_3074":128699},[],"Para saber cómo actualizar, consulta Actualizaciones.",{"_3697":75440,"_31245":75419,"_21577":128701,"_5":14884,"_28435":128656,"_3074":128702},[],"Da a los mantenedores un tiempo razonable para investigar y resolver la vulnerabilidad reportada antes de cualquier divulgación pública.",{"_3697":75441,"_31245":75419,"_21577":128704,"_5":14884,"_28435":128656,"_3074":128705},[],"Evita violaciones de privacidad, destrucción de datos e interrupciones de servicio mientras investigas la vulnerabilidad.",{"_3697":75442,"_31245":75419,"_21577":128707,"_5":14884,"_28435":128656,"_3074":128708},[],"Interactúa solo con cuentas o datos que sean tuyos o sobre los que tengas permiso explícito.",{"_3697":75443,"_31245":75419,"_21577":128710,"_5":14884,"_28435":128656,"_3074":128711},[],"Los mantenedores reconocen los reportes en un tiempo razonable y te mantienen informado del progreso de la remediación.",{"_3697":75444,"_31245":75419,"_21577":128713,"_5":14884,"_28435":128656,"_3074":128714},[],"Esta política cubre el código fuente, la configuración y los flujos de CI/CD de los repositorios lamassuiot, lamassu-dashboard y lamassu-helm.",{"_3697":75445,"_31245":75445,"_5":15238,"_3074":128716,"_31570":128717,"_21577":128719,"_28435":75445},"3.8.0 a 4.0.0",[50948,128718],"Actualizaciones",[],{"_3697":75446,"_31245":75445,"_21577":128721,"_5":14884,"_28435":75445,"_3074":128722},[],"Qué cambia en 4.0.0, qué cambios rompen los clientes de API, los consumidores de eventos y los dispositivos de 3.8.0, cómo actualizar paso a paso una release de Helm y cómo validar el resultado.",{"_3697":75447,"_31245":75445,"_5":31567,"_21577":128724,"_28435":128725,"_3074":128726},[],"/docs/es/upgrades/3-8-0-to-4-0-0#cambios","Cambios",{"_3697":75448,"_31245":75445,"_5":31567,"_21577":128728,"_28435":128729,"_3074":128730},[],"/docs/es/upgrades/3-8-0-to-4-0-0#qué-migra-automáticamente-la-actualización","Qué migra automáticamente la actualización",{"_3697":75449,"_31245":75445,"_5":31567,"_21577":128732,"_28435":128733,"_3074":128734},[],"/docs/es/upgrades/3-8-0-to-4-0-0#chart-de-helm-y-despliegue","Chart de Helm y despliegue",{"_3697":75450,"_31245":75445,"_5":31567,"_21577":128736,"_28435":128737,"_3074":128738},[],"/docs/es/upgrades/3-8-0-to-4-0-0#un-chart-de-helm-reforzado","Un chart de Helm reforzado",{"_3697":75451,"_31245":75445,"_5":31567,"_21577":128740,"_28435":128741,"_3074":128742},[],"/docs/es/upgrades/3-8-0-to-4-0-0#nombres-de-recursos-con-ámbito-de-release","Nombres de recursos con ámbito de release",{"_3697":75452,"_31245":75445,"_5":31567,"_21577":128744,"_28435":128745,"_3074":128746},[],"/docs/es/upgrades/3-8-0-to-4-0-0#contenedores-sin-root","Contenedores sin root",{"_3697":75453,"_31245":75445,"_5":31567,"_21577":128748,"_28435":128749,"_3074":128750},[],"/docs/es/upgrades/3-8-0-to-4-0-0#validación-estricta-de-values","Validación estricta de values",{"_3697":75454,"_31245":75445,"_5":31567,"_21577":128752,"_28435":128753,"_3074":121010},[],"/docs/es/upgrades/3-8-0-to-4-0-0#credenciales-en-secrets-de-kubernetes",{"_3697":75455,"_31245":75445,"_5":31567,"_21577":128755,"_28435":128756,"_3074":128757},[],"/docs/es/upgrades/3-8-0-to-4-0-0#values-renombrados-y-reestructurados","Values renombrados y reestructurados",{"_3697":75456,"_31245":75445,"_5":31567,"_21577":128759,"_28435":128760,"_3074":128761},[],"/docs/es/upgrades/3-8-0-to-4-0-0#amqp-sobre-tls","AMQP sobre TLS",{"_3697":75457,"_31245":75445,"_5":31567,"_21577":128763,"_28435":128764,"_3074":126699},[],"/docs/es/upgrades/3-8-0-to-4-0-0#autorización",{"_3697":75458,"_31245":75445,"_5":31567,"_21577":128766,"_28435":128767,"_3074":128768},[],"/docs/es/upgrades/3-8-0-to-4-0-0#la-autorización-pasa-al-servicio-authz","La autorización pasa al servicio authz",{"_3697":75459,"_31245":75445,"_5":31567,"_21577":128770,"_28435":128771,"_3074":128772},[],"/docs/es/upgrades/3-8-0-to-4-0-0#configuración-de-autorización-obligatoria","Configuración de autorización obligatoria",{"_3697":75460,"_31245":75445,"_5":31567,"_21577":128774,"_28435":128775,"_3074":128776},[],"/docs/es/upgrades/3-8-0-to-4-0-0#retirada-de-la-validación-de-tokens-en-el-gateway","Retirada de la validación de tokens en el gateway",{"_3697":75461,"_31245":75445,"_5":31567,"_21577":128778,"_28435":128779,"_3074":128780},[],"/docs/es/upgrades/3-8-0-to-4-0-0#almacenamiento-y-datos","Almacenamiento y datos",{"_3697":75462,"_31245":75445,"_5":31567,"_21577":128782,"_28435":128783,"_3074":128784},[],"/docs/es/upgrades/3-8-0-to-4-0-0#una-única-base-de-datos-postgresql-con-esquemas","Una única base de datos PostgreSQL con esquemas",{"_3697":75463,"_31245":75445,"_5":31567,"_21577":128786,"_28435":128787,"_3074":128788},[],"/docs/es/upgrades/3-8-0-to-4-0-0#consolidación-en-postgresql","Consolidación en PostgreSQL",{"_3697":75464,"_31245":75445,"_5":31567,"_21577":128790,"_28435":128791,"_3074":128792},[],"/docs/es/upgrades/3-8-0-to-4-0-0#claves-de-ca-heredadas-en-el-kms","Claves de CA heredadas en el KMS",{"_3697":75465,"_31245":75445,"_5":31567,"_21577":128794,"_28435":128795,"_3074":128796},[],"/docs/es/upgrades/3-8-0-to-4-0-0#referencias-entre-certificados-claves-y-ajustes-de-crl","Referencias entre certificados, claves y ajustes de CRL",{"_3697":75466,"_31245":75445,"_5":31567,"_21577":128798,"_28435":128799,"_3074":128800},[],"/docs/es/upgrades/3-8-0-to-4-0-0#migración-de-los-ajustes-de-crl","Migración de los ajustes de CRL",{"_3697":75467,"_31245":75445,"_5":31567,"_21577":128802,"_28435":128803,"_3074":128804},[],"/docs/es/upgrades/3-8-0-to-4-0-0#firmante-de-crl-de-la-va","Firmante de CRL de la VA",{"_3697":75468,"_31245":75445,"_5":31567,"_21577":128806,"_28435":128807,"_3074":128808},[],"/docs/es/upgrades/3-8-0-to-4-0-0#los-eventos-de-dispositivo-tienen-almacenamiento-propio","Los eventos de dispositivo tienen almacenamiento propio",{"_3697":75469,"_31245":75445,"_5":31567,"_21577":128810,"_28435":128811,"_3074":124556},[],"/docs/es/upgrades/3-8-0-to-4-0-0#configuración-del-dms",{"_3697":75470,"_31245":75445,"_5":31567,"_21577":128813,"_28435":128814,"_3074":128815},[],"/docs/es/upgrades/3-8-0-to-4-0-0#autenticación-de-reenrolamiento-independiente","Autenticación de reenrolamiento independiente",{"_3697":75471,"_31245":75445,"_5":31567,"_21577":128817,"_28435":128818,"_3074":128819},[],"/docs/es/upgrades/3-8-0-to-4-0-0#verificación-del-certificado-del-receptor-del-webhook","Verificación del certificado del receptor del webhook",{"_3697":75472,"_31245":75445,"_5":31567,"_21577":128821,"_28435":128822,"_3074":59605},[],"/docs/es/upgrades/3-8-0-to-4-0-0#breaking-changes",{"_3697":75473,"_31245":75445,"_5":31567,"_21577":128824,"_28435":128825,"_3074":128826},[],"/docs/es/upgrades/3-8-0-to-4-0-0#api-y-sdk","API y SDK",{"_3697":75474,"_31245":75445,"_5":31567,"_21577":128828,"_28435":128829,"_3074":128830},[],"/docs/es/upgrades/3-8-0-to-4-0-0#ajustes-de-crl-indexados-por-id-de-ca","Ajustes de CRL indexados por ID de CA",{"_3697":75475,"_31245":75445,"_5":31567,"_21577":128832,"_28435":128833,"_3074":128834},[],"/docs/es/upgrades/3-8-0-to-4-0-0#campo-firmante-de-la-crl","Campo firmante de la CRL",{"_3697":75476,"_31245":75445,"_5":31567,"_21577":128836,"_28435":128837,"_3074":128838},[],"/docs/es/upgrades/3-8-0-to-4-0-0#eliminación-de-los-endpoints-de-firma-arbitraria-de-la-ca","Eliminación de los endpoints de firma arbitraria de la CA",{"_3697":75477,"_31245":75445,"_5":31567,"_21577":128840,"_28435":128841,"_3074":128842},[],"/docs/es/upgrades/3-8-0-to-4-0-0#los-ids-de-ca-los-asigna-siempre-el-backend","Los IDs de CA los asigna siempre el backend",{"_3697":75478,"_31245":75445,"_5":31567,"_21577":128844,"_28435":128845,"_3074":128846},[],"/docs/es/upgrades/3-8-0-to-4-0-0#valores-de-tipo-de-certificado","Valores de tipo de certificado",{"_3697":75479,"_31245":75445,"_5":31567,"_21577":128848,"_28435":128849,"_3074":128850},[],"/docs/es/upgrades/3-8-0-to-4-0-0#alias-de-claves-del-kms-en-conflicto","Alias de claves del KMS en conflicto",{"_3697":75480,"_31245":75445,"_5":31567,"_21577":128852,"_28435":128853,"_3074":128854},[],"/docs/es/upgrades/3-8-0-to-4-0-0#webhooks-del-dms","Webhooks del DMS",{"_3697":75481,"_31245":75445,"_5":31567,"_21577":128856,"_28435":128857,"_3074":128858},[],"/docs/es/upgrades/3-8-0-to-4-0-0#conjunto-de-confianza-del-reenrolamiento","Conjunto de confianza del reenrolamiento",{"_3697":75482,"_31245":75445,"_5":31567,"_21577":128860,"_28435":128861,"_3074":128862},[],"/docs/es/upgrades/3-8-0-to-4-0-0#api-de-actualización-del-dms","API de actualización del DMS",{"_3697":75483,"_31245":75445,"_5":31567,"_21577":128864,"_28435":128865,"_3074":128866},[],"/docs/es/upgrades/3-8-0-to-4-0-0#eventos-de-dispositivo","Eventos de dispositivo",{"_3697":75484,"_31245":75445,"_5":31567,"_21577":128868,"_28435":128869,"_3074":128870},[],"/docs/es/upgrades/3-8-0-to-4-0-0#eventos","Eventos",{"_3697":75485,"_31245":75445,"_5":31567,"_21577":128872,"_28435":128873,"_3074":128874},[],"/docs/es/upgrades/3-8-0-to-4-0-0#eventos-de-va-renombrados","Eventos de VA renombrados",{"_3697":75486,"_31245":75445,"_5":31567,"_21577":128876,"_28435":128877,"_3074":128878},[],"/docs/es/upgrades/3-8-0-to-4-0-0#comportamiento-del-enrolamiento","Comportamiento del enrolamiento",{"_3697":75487,"_31245":75445,"_5":31567,"_21577":128880,"_28435":128881,"_3074":128882},[],"/docs/es/upgrades/3-8-0-to-4-0-0#comprobaciones-de-revocación-que-fallan-cerradas","Comprobaciones de revocación que fallan cerradas",{"_3697":75488,"_31245":75445,"_5":31567,"_21577":128884,"_28435":128885,"_3074":128886},[],"/docs/es/upgrades/3-8-0-to-4-0-0#guía-de-migración-con-helm","Guía de migración con Helm",{"_3697":75489,"_31245":75445,"_5":31567,"_21577":128888,"_28435":128889,"_3074":128890},[],"/docs/es/upgrades/3-8-0-to-4-0-0#paso-1-prepara","Paso 1: Prepara",{"_3697":75490,"_31245":75445,"_5":31567,"_21577":128892,"_28435":128893,"_3074":128894},[],"/docs/es/upgrades/3-8-0-to-4-0-0#comprobación-previa-a-la-actualización","Comprobación previa a la actualización",{"_3697":75491,"_31245":75445,"_5":31567,"_21577":128896,"_28435":128897,"_3074":128898},[],"/docs/es/upgrades/3-8-0-to-4-0-0#paso-2-actualiza-el-archivo-de-values","Paso 2: Actualiza el archivo de values",{"_3697":75492,"_31245":75445,"_5":31567,"_21577":128900,"_28435":128901,"_3074":128902},[],"/docs/es/upgrades/3-8-0-to-4-0-0#paso-3-ejecuta-la-actualización","Paso 3: Ejecuta la actualización",{"_3697":75493,"_31245":75445,"_5":31567,"_21577":128904,"_28435":128905,"_3074":128906},[],"/docs/es/upgrades/3-8-0-to-4-0-0#paso-4-migra-los-datos-del-kms-y-la-va","Paso 4: Migra los datos del KMS y la VA",{"_3697":75494,"_31245":75445,"_5":31567,"_21577":128908,"_28435":128909,"_3074":128910},[],"/docs/es/upgrades/3-8-0-to-4-0-0#paso-5-elimina-los-values-de-migración-puntual","Paso 5: Elimina los values de migración puntual",{"_3697":75495,"_31245":75445,"_5":31567,"_21577":128912,"_28435":128913,"_3074":128914},[],"/docs/es/upgrades/3-8-0-to-4-0-0#despliegues-sin-helm","Despliegues sin Helm",{"_3697":75496,"_31245":75445,"_5":31567,"_21577":128916,"_28435":128917,"_3074":124612},[],"/docs/es/upgrades/3-8-0-to-4-0-0#solución-de-problemas",{"_3697":75497,"_31245":75445,"_5":31567,"_21577":128919,"_28435":128920,"_3074":128921},[],"/docs/es/upgrades/3-8-0-to-4-0-0#checklist-de-validación","Checklist de validación",{"_3697":75498,"_31245":75445,"_5":31567,"_21577":128923,"_28435":128924,"_3074":128925},[],"/docs/es/upgrades/3-8-0-to-4-0-0#elimina-los-volúmenes-antiguos","Elimina los volúmenes antiguos",{"_3697":75499,"_31245":75445,"_21577":128927,"_5":14884,"_28435":75445,"_3074":128928},[],"Lamassu 4.0.0 es una versión mayor. El almacenamiento se consolida en una única base de datos PostgreSQL, un nuevo servicio `authz` autoriza cada petición, el chart de Helm se refuerza y varias APIs y configuraciones almacenadas cambian de forma. La mayoría de los datos se convierten automáticamente durante la actualización, pero algunos cambios requieren acción del operador antes, durante o después.",{"_3697":75500,"_31245":75445,"_21577":128930,"_5":14884,"_28435":75445,"_3074":128931},[],"La página se organiza en cuatro partes. Léelas en orden antes de actualizar producción:",{"_3697":75501,"_31245":75445,"_21577":128933,"_5":14884,"_28435":75445,"_3074":128934},[],"Cambios: qué es distinto en el despliegue, el almacenamiento y los datos guardados, qué migra la actualización por sí sola y cuáles de estos cambios requieren tu intervención.",{"_3697":75502,"_31245":75445,"_21577":128936,"_5":14884,"_28435":75445,"_3074":128937},[],"Breaking changes: cambios en la API, los eventos y el comportamiento del que dependen los clientes, las integraciones y los dispositivos, a quién afecta cada uno y qué hacer.",{"_3697":75503,"_31245":75445,"_21577":128939,"_5":14884,"_28435":75445,"_3074":128940},[],"Guía de migración con Helm: el procedimiento paso a paso para una release gestionada con Helm.",{"_3697":75504,"_31245":75445,"_21577":128942,"_5":14884,"_28435":75445,"_3074":128943},[],"Checklist de validación: cómo confirmar que la actualización ha funcionado antes de eliminar los datos antiguos.",{"_3697":75505,"_31245":75445,"_21577":128945,"_5":14884,"_28435":75445,"_3074":128946},[],"La versión 4.0.0 está próxima y los pasos de migración del backend de esta página son provisionales. Verifica cada procedimiento con los artefactos definitivos de la versión antes de actualizar producción.",{"_3697":75506,"_31245":75445,"_21577":128948,"_5":14884,"_28435":128725,"_3074":128949},[],"Estos cambios afectan a cómo se despliega Lamassu, dónde guarda sus datos y cómo se convierten esos datos. No cambian la API ni los eventos: lo que deben adaptar los clientes, las integraciones y los dispositivos se recoge en Breaking changes. La propia actualización aplica la mayoría de estos cambios; los que requieren acción del operador lo indican, y la guía de migración con Helm realiza esa acción en orden.",{"_3697":75507,"_31245":75445,"_21577":128951,"_5":14884,"_28435":128729,"_3074":128952},[],"Al actualizar una release de Helm se ejecutan varias migraciones sin intervención:",{"_3697":75508,"_31245":75445,"_21577":128954,"_5":14884,"_28435":128729,"_3074":128955},[],"Antes de que arranque ningún servicio, el job de preinstalación y preactualización del chart prepara PostgreSQL. Crea las bases `pki`, `authz` y `wfx` si no existen, crea un esquema por servicio dentro de `pki` e importa cada base de datos por servicio de 3.8.0 en su esquema. Cada importación se ejecuta en una única transacción, de modo que una importación fallida no deja un esquema a medias y un reintento del job vuelve a importar. Después, el job ejecuta las migraciones de base de datos de cada esquema, migra `authz`, precarga sus políticas y da de alta los principales de `services.authz.bootstrap`. Es idempotente y necesita un rol de PostgreSQL con permiso para crear bases de datos y esquemas, como se describe en Instalar con Helm.",{"_3697":75509,"_31245":75445,"_21577":128957,"_5":14884,"_28435":128729,"_3074":128958},[],"La configuración almacenada de los DMS se reescribe al formato de 4.0.0, y los eventos históricos de los dispositivos se transforman al nuevo almacenamiento.",{"_3697":75510,"_31245":75445,"_21577":128960,"_5":14884,"_28435":128729,"_3074":128961},[],"La migración del KMS elimina los metadatos de clave obsoletos `lamassu.io/kms/binded-resources` y los alias iguales a un ID de clave existente (consulta Alias de claves del KMS en conflicto). La migración de la VA convierte cada rol de VA en los ajustes de CRL de su CA y resuelve su firmante de CRL (consulta Migración de los ajustes de CRL).",{"_3697":75511,"_31245":75445,"_21577":128963,"_5":14884,"_28435":128729,"_3074":128964},[],"Si se activa `migrations.caToKms.enabled`, un hook de preactualización registra en el KMS las claves de CA heredadas.",{"_3697":75512,"_31245":75445,"_21577":128966,"_5":14884,"_28435":128729,"_3074":128967},[],"Dos cosas nunca migran solas: los datos del KMS y de la VA en volúmenes locales, que se quedan en volúmenes que los pods actualizados ya no usan, y el archivo de values, que se actualiza a mano. Los despliegues que no usan el chart de Helm también tienen que mover ellos mismos los datos de la base de datos; consulta Despliegues sin Helm.",{"_3697":75513,"_31245":75445,"_21577":128969,"_5":14884,"_28435":128737,"_3074":128970},[],"La versión 4.0.0 del chart refuerza la seguridad:",{"_3697":75514,"_31245":75445,"_21577":128972,"_5":14884,"_28435":128737,"_3074":128973},[],"**Nombres de recursos con ámbito de release.** Cada recurso gestionado por el chart se llama `<release>-lamassu-<componente>` en lugar de los nombres fijos de 3.8.0 (`kms`, `va`, `ca`...). Con una release llamada `prod`, los StatefulSets pasan a ser `prod-lamassu-kms` y `prod-lamassu-va`. Los values `nameOverride` y `fullnameOverride` cambian el prefijo.",{"_3697":75515,"_31245":75445,"_21577":128975,"_5":14884,"_28435":128737,"_3074":128976},[],"**Contenedores sin root.** Todas las cargas se ejecutan con el usuario numérico `65532:65532`, y los volúmenes existentes deben ser accesibles por esa identidad.",{"_3697":75516,"_31245":75445,"_21577":128978,"_5":14884,"_28435":128737,"_3074":128979},[],"**Validación estricta de values.** `values.schema.json` rechaza las claves desconocidas, así que los bloques sobrantes de 3.8.0 hacen fallar `helm lint` y `helm upgrade` en lugar de ignorarse en silencio.",{"_3697":75517,"_31245":75445,"_21577":128981,"_5":14884,"_28435":128737,"_3074":128982},[],"**Sin reglas de planificación inyectadas.** El chart ya no añade por su cuenta reglas de anti-afinidad ni de topology spread.",{"_3697":75518,"_31245":75445,"_21577":128984,"_5":14884,"_28435":128741,"_3074":128985},[],"Kubernetes deriva el nombre del PVC de un StatefulSet a partir del nombre de su pod (`<volumeClaimTemplate>-<nombre-del-pod>`). Al renombrar los StatefulSets `kms` y `va`, `helm upgrade` enlaza PVC nuevos y vacíos en lugar de los existentes. El material de claves del KMS y las CRLs de la VA no se borran —los PVC antiguos quedan huérfanos, no eliminados—, pero los pods actualizados fallan con `no such file or directory` (KMS) o `code=NotFound` (VA) hasta que copies los datos. Afecta al KMS cuando `services.kms.cryptoEngines` usa un motor `filesystem` y a la VA cuando `services.va.fileStore.type` es `local`. El resto de recursos renombrados no tienen estado y se recrean sin riesgo de pérdida de datos.",{"_3697":75519,"_31245":75445,"_21577":128987,"_5":14884,"_28435":128741,"_3074":128988},[],"El paso 4 de la guía de migración copia los datos.",{"_3697":75520,"_31245":75445,"_21577":128990,"_5":14884,"_28435":128745,"_3074":128991},[],"Las imágenes de servicio se basan en distroless y se ejecutan con el usuario numérico `65532`; la imagen de `authz` es Ubuntu con un usuario sin root que tiene el mismo UID. Se eliminan las sobrescrituras por servicio `services.kms.securityContext.runAsGroup: 0` y `services.authz.securityContext.runAsUser`/`runAsGroup: 999`; el acceso de grupo al volumen del KMS y al socket PKCS#11 lo gestiona ahora el `fsGroup: 65532` del pod.",{"_3697":75521,"_31245":75445,"_21577":128993,"_5":14884,"_28435":128745,"_3074":128994},[],"3.8.0 no fijaba la identidad del contenedor, por lo que los archivos existentes pueden tener cualquier UID. Todo volumen con claves o CRLs debe pertenecer a `65532:65532`, o al menos ser legible (y, si hace falta, escribible) por esa identidad.",{"_3697":75522,"_31245":75445,"_21577":128996,"_5":14884,"_28435":128745,"_3074":128997},[],"Los pods llevan ahora un `fsGroup: 65532` a nivel de pod con `fsGroupChangePolicy: OnRootMismatch`, que se salta los cambios recursivos de propiedad cuando la raíz del volumen ya tiene el grupo esperado. Si tus herramientas de backup o jobs usan otro GID, verifica que sigan pudiendo acceder a los volúmenes que necesitan.",{"_3697":75523,"_31245":75445,"_21577":128999,"_5":14884,"_28435":128749,"_3074":129000},[],"`values.schema.json` rechaza las claves desconocidas, así que cualquier bloque que 4.0.0 haya eliminado o renombrado —`toolbox`, `auth.oidc.apiGateway`, `auth.authorization` y otros— hace fallar directamente `helm lint` y `helm upgrade`. El paso 2 recoge todos los cambios.",{"_3697":75524,"_31245":75445,"_21577":129002,"_5":14884,"_28435":128753,"_3074":129003},[],"En 4.0.0 el chart lee las credenciales de PostgreSQL, AMQP y SMTP de Secrets de Kubernetes en el namespace del release en lugar de valores inline: `postgres.existingSecret`, `amqp.existingSecret` y — cuando hay autenticación SMTP configurada — `services.alerts.smtp_server.existingSecret`, cada uno con `usernameKey` y `passwordKey` nombrando las claves de datos del Secret. Los valores inline `postgres.username`/`postgres.password` y `amqp.username`/`amqp.password` se eliminan y `values.schema.json` los rechaza, así que un archivo de values de 3.8.0 hace fallar `helm lint` y `helm upgrade` hasta que las credenciales pasen a Secrets.",{"_3697":75525,"_31245":75445,"_21577":129005,"_5":14884,"_28435":128753,"_3074":129006},[],"Los Secrets deben existir antes de ejecutar `helm upgrade`: el job de base de datos de pre-upgrade se conecta a PostgreSQL con ellos. El paso 2 los crea mediante el External Secrets Operator.",{"_3697":75526,"_31245":75445,"_21577":129008,"_5":14884,"_28435":128756,"_3074":129009},[],"`toolbox` pasa a llamarse `connectivityTest`, y el hook de `helm test` usa la imagen upstream `curlimages/curl` fijada por digest.",{"_3697":75527,"_31245":75445,"_21577":129011,"_5":14884,"_28435":128756,"_3074":129012},[],"`services.connectors` pasa a ser un mapa indexado por ID de conector en lugar de una lista.",{"_3697":75528,"_31245":75445,"_21577":129014,"_5":14884,"_28435":128756,"_3074":129015},[],"El valor por defecto de `services.ui.port` es `8085`, el puerto sin privilegios de la imagen sin root.",{"_3697":75529,"_31245":75445,"_21577":129017,"_5":14884,"_28435":128756,"_3074":129018},[],"El bloque compartido `probes:` se sustituye por los bloques independientes `livenessProbe`, `readinessProbe` y `startupProbe`.",{"_3697":75530,"_31245":75445,"_21577":129020,"_5":14884,"_28435":128756,"_3074":129021},[],"Con `tls.certManagerOptions.issuer` vacío, el chart crea un issuer autofirmado con ámbito de release, por ejemplo `lamassu-downstream-ca-selfsigned-issuer`. El literal heredado `downstream-ca-selfsigned-issuer` se sigue aceptando y se resuelve a ese issuer.",{"_3697":75531,"_31245":75445,"_21577":129023,"_5":14884,"_28435":128756,"_3074":129024},[],"La anti-afinidad y el topology spread deben configurarse explícitamente con `affinity` y `topologySpreadConstraints`.",{"_3697":75532,"_31245":75445,"_21577":129026,"_5":14884,"_28435":128760,"_3074":129027},[],"En 3.8.0 `amqp.tls` no se aplicaba y los clientes del bus de eventos se conectaban siempre en texto plano. En 4.0.0, `amqp.tls: true` los pasa a AMQPS. El valor por defecto de `amqp.port` sigue siendo `5672` y no cambia al activar TLS, así que un archivo de values que ya tuviera `amqp.tls: true` debe apuntar `amqp.port` al listener TLS del broker (`amqps`, habitualmente `5671`), o poner `amqp.tls: false` para seguir en texto plano. Los clientes deben además confiar en el certificado del broker.",{"_3697":75533,"_31245":75445,"_21577":129029,"_5":14884,"_28435":128767,"_3074":129030},[],"En 3.8.0 el API Gateway validaba los tokens: una política JWT en cada ruta privada comprobaba la firma y solo dejaba pasar los tokens con el rol de administrador. Cualquier token que superase esa comprobación tenía acceso a todas las rutas.",{"_3697":75534,"_31245":75445,"_21577":129032,"_5":14884,"_28435":128767,"_3074":129033},[],"4.0.0 elimina la política del gateway. Las rutas `/api/*` llegan directamente a los servicios, y cada servicio autoriza cada petición a través de `authz`, que valida el token contra el endpoint JWKS del proveedor de identidad y aplica políticas de grano fino, a nivel de entidad, sobre CAs, certificados, dispositivos, DMS, claves del KMS y ajustes de CRL. No existe un superusuario implícito: el primer administrador sale de un principal de bootstrap que configuras tú. La página de control de acceso documenta los principales, las políticas y el primer administrador.",{"_3697":75535,"_31245":75445,"_21577":129035,"_5":14884,"_28435":128771,"_3074":129036},[],"3.8.0 no tenía servicio de autorización, así que un archivo de values de 3.8.0 no tiene nada desde lo que migrar: hay que añadir la configuración de `services.authz` a mano. Necesita el endpoint JWKS del proveedor de identidad, las bases de datos que usa el motor de autorización y un principal de bootstrap que coincida con la forma en que el proveedor asigna el rol de administrador. Sin un principal coincidente nadie puede administrar la PKI.",{"_3697":75536,"_31245":75445,"_21577":129038,"_5":14884,"_28435":128775,"_3074":129039},[],"`auth.oidc.apiGateway.jwks`, `auth.authorization.rolesClaim` y `auth.authorization.roles.admin` se eliminan sin alias de compatibilidad, y el schema los rechaza. Su configuración pasa a `services.authz`: la URL de JWKS se convierte en `services.authz.jwkUrl`, y el claim de roles y el rol de administrador pasan a ser una regla de claims del principal de bootstrap. `auth.oidc.frontend` no cambia.",{"_3697":75537,"_31245":75445,"_21577":129041,"_5":14884,"_28435":128783,"_3074":129042},[],"En 3.8.0 cada servicio tenía su propia base de datos. El backend de 4.0.0 se conecta a una única base de datos PostgreSQL llamada `pki` y aísla cada servicio en un esquema: `kms`, `ca`, `va`, `devicemanager`, `dmsmanager` y `alerts`. El servicio `authz` guarda sus principales, permisos y políticas en una base de datos `authz` separada (el monolítico de desarrollo usa en su lugar un esquema `authz` dentro de `pki`), y WFX conserva su propia base `wfx`.",{"_3697":75538,"_31245":75445,"_21577":129044,"_5":14884,"_28435":128783,"_3074":129045},[],"PostgreSQL pasa a ser el único motor de almacenamiento. Se elimina el motor de almacenamiento SQLite, y los motores `couch_db` y `dynamo_db` no están registrados en 4.0.0: sus constantes de configuración siguen existiendo, pero no seleccionan ningún motor. Los despliegues sobre cualquiera de ellos deben pasar a PostgreSQL y consolidar sus datos en los esquemas de `pki` antes de actualizar.",{"_3697":75539,"_31245":75445,"_21577":129047,"_5":14884,"_28435":128787,"_3074":129048},[],"Cada base de datos por servicio de 3.8.0 debe acabar como un esquema de `pki`, conservando su estructura, índices, restricciones, datos e historial de migraciones. El chart de Helm lo hace automáticamente; los despliegues sin Helm lo hacen a mano (consulta Despliegues sin Helm).",{"_3697":75540,"_31245":75445,"_21577":129050,"_5":14884,"_28435":128787,"_3074":129051},[],"Dos migraciones de esquema abortan con datos que 3.8.0 permitía, así que limpia los datos antes de actualizar:",{"_3697":75541,"_31245":75445,"_21577":129053,"_5":14884,"_28435":128787,"_3074":129054},[],"La migración de CA añade una restricción UNIQUE sobre `ca_certificates.id` y aborta si existen IDs de CA duplicados. Las importaciones ya rechazan los duplicados con `409`, así que normalmente no aparecen duplicados nuevos.",{"_3697":75542,"_31245":75445,"_21577":129056,"_5":14884,"_28435":128787,"_3074":129057},[],"La migración del KMS convierte la clave primaria en `(key_id, engine_id)` y aborta con `cannot promote (key_id, engine_id) to primary key: N row(s) have no engine_id; backfill them before migrating` cuando hay filas de `kms_keys` sin `engine_id`. Rellena antes `engine_id`.",{"_3697":75543,"_31245":75445,"_21577":129059,"_5":14884,"_28435":128791,"_3074":129060},[],"Los certificados de CA de tipo `MANAGED` o `IMPORTED_WITH_KEY` cuyas claves privadas son anteriores al servicio KMS tienen la clave guardada solo en el motor criptográfico, bajo el `subject_key_id` del certificado, sin registro en el KMS. La herramienta `ca-to-kms-migration` los registra:",{"_3697":75544,"_31245":75445,"_21577":129062,"_5":14884,"_28435":128791,"_3074":129063},[],"El `key_id` es el `subject_key_id` del certificado; solo coincide con el resumen SHA-256 de la clave pública si el SKI se calculó de esa forma.",{"_3697":75545,"_31245":75445,"_21577":129065,"_5":14884,"_28435":128791,"_3074":129066},[],"La herramienta es idempotente: las claves que ya están en el KMS se omiten, así que puede ejecutarse varias veces.",{"_3697":75546,"_31245":75445,"_21577":129068,"_5":14884,"_28435":128791,"_3074":129069},[],"Los certificados que no pueden leerse, o que carecen de motor o de ID de clave de sujeto, se omiten con un aviso. Revisa los logs y resuelve los registros afectados.",{"_3697":75547,"_31245":75445,"_21577":129071,"_5":14884,"_28435":128791,"_3074":129072},[],"Cuando certificados de CA que comparten un `subject_key_id` declaran `engine_id` en conflicto, la herramienta marca esa clave como fallida y sale con código `1`, lo que hace fallar un hook de preactualización de Helm. Resuelve el conflicto a mano antes de volver a ejecutarla.",{"_3697":75548,"_31245":75445,"_21577":129074,"_5":14884,"_28435":128791,"_3074":129075},[],"Una vez registradas las claves, los certificados las referencian en la base de datos y el KMS se niega a eliminar una clave que un certificado aún usa (`409` `key is in use`). Eliminar el registro de un certificado lo quita de la CRL y de OCSP, así que lee Antes de eliminar una clave antes de liberar una clave.",{"_3697":75549,"_31245":75445,"_21577":129077,"_5":14884,"_28435":128791,"_3074":129078},[],"Opcionalmente, las instalaciones con CAs importadas anteriores a 3.7 pueden arrancar el KMS una vez con `crypto_engines.migrate_keys_format: true`: el KMS renombra esas claves heredadas con nombre de SKI al resumen SHA-256 de su clave pública (el nombre antiguo se conserva como alias, y las referencias de los certificados se actualizan solas). Ejecútalo una vez y vuelve a desactivar la opción; repetirla es seguro.",{"_3697":75550,"_31245":75445,"_21577":129080,"_5":14884,"_28435":128791,"_3074":129081},[],"Con Helm, activa el hook para la actualización en el paso 2; sin Helm, ejecuta la herramienta a mano.",{"_3697":75551,"_31245":75445,"_21577":129083,"_5":14884,"_28435":128795,"_3074":129084},[],"La migración elimina los metadatos heredados `lamassu.io/kms/binded-resources` y registra en el KMS, solo con su clave pública, las claves ausentes necesarias para conservar referencias de certificados. Estas entradas no recuperan la clave privada. Consulta Gestión de claves y CRL para el comportamiento de las referencias.",{"_3697":75552,"_31245":75445,"_21577":129086,"_5":14884,"_28435":128799,"_3074":129087},[],"La migración de la VA convierte cada rol de VA de 3.8.0, indexado por el SKI de la CA, en los ajustes de CRL de una CA, indexados por su ID de CA. Cada CA obtiene sus propios ajustes, incluso cuando dos CAs comparten clave. Ajustes de CRL indexados por ID de CA describe lo que cambia para los clientes de API.",{"_3697":75553,"_31245":75445,"_21577":129089,"_5":14884,"_28435":128799,"_3074":129090},[],"La migración que convierte los roles de VA en ajustes de CRL no puede revertirse: su rollback no hace nada. Las CRLs generadas después de la actualización se guardan bajo el ID de CA, donde 3.8.0 no las busca, y los ajustes archivados de las CAs eliminadas antes de la actualización no tienen firmante al que volver. Volver a 3.8.0 exige restaurar tanto la base de datos como el bucket de CRLs — el almacenamiento de objetos que contiene las listas publicadas — a partir de las copias de seguridad tomadas antes de la actualización.",{"_3697":75554,"_31245":75445,"_21577":129092,"_5":14884,"_28435":128799,"_3074":129093},[],"La migración aborta, y con ella la actualización, con cinco tipos de datos:",{"_3697":75555,"_31245":75445,"_21577":129095,"_5":14884,"_28435":128799,"_3074":129096},[],"IDs de CA que contienen `/`: no pueden usarse en URLs de CRL. Recrea esas CAs con otro ID.",{"_3697":75556,"_31245":75445,"_21577":129098,"_5":14884,"_28435":128799,"_3074":129099},[],"Un SKI compartido por más de una CA: el error nombra los SKIs y pide recrear todas menos una con otra clave.",{"_3697":75557,"_31245":75445,"_21577":129101,"_5":14884,"_28435":128799,"_3074":129102},[],"Un rol de VA cuyo certificado firmante no tiene clave: apunta el rol a un firmante con clave, o corrige la referencia de clave del certificado, antes de actualizar.",{"_3697":75558,"_31245":75445,"_21577":129104,"_5":14884,"_28435":128799,"_3074":129105},[],"Una CA cuyo ID coincide con el ID `legacy-<ski>` que la migración reserva para los ajustes archivados de otro rol cuya CA se eliminó: recrea esa CA con otro ID.",{"_3697":75559,"_31245":75445,"_21577":129107,"_5":14884,"_28435":128799,"_3074":129108},[],"Un ID de CA igual al SKI de otro rol de VA: sus URLs de CRL serían ambiguas.",{"_3697":75560,"_31245":75445,"_21577":129110,"_5":14884,"_28435":128799,"_3074":129111},[],"Los ajustes de una CA eliminada antes de la actualización se migran como `ARCHIVED`, con un ID `legacy-<ski>` y sin firmante: su última CRL sigue sirviéndose, pero nunca se regenera, y `PUT` devuelve `409`. No hay forma de volver a `ACTIVE` por API. La guía de CRL describe el comportamiento completo.",{"_3697":75561,"_31245":75445,"_21577":129113,"_5":14884,"_28435":128803,"_3074":129114},[],"La migración de la VA resuelve el firmante de cada rol a partir de su SKI guardado. Primero busca certificados de CA con ese SKI; si coinciden varios, selecciona la CA más antigua y registra un aviso. Si no coincide ningún certificado de CA, busca entre todos los certificados con ese SKI. La migración aborta con `cannot resolve signer certificate for VA role <ca-ski>, SKI <ski>` si esa búsqueda encuentra cero o varios candidatos. Corrige los roles afectados antes de actualizar.",{"_3697":75562,"_31245":75445,"_21577":129116,"_5":14884,"_28435":128807,"_3074":129117},[],"Los eventos históricos de los dispositivos pasan de la columna `devices.events` a un almacenamiento dedicado, `device_events`, con sus propios endpoints. Consulta Eventos de dispositivo para adaptar los consumidores.",{"_3697":75563,"_31245":75445,"_21577":129119,"_5":14884,"_28435":128814,"_3074":129120},[],"Los ajustes de autenticación del reenrolamiento son independientes de los del enrolamiento inicial; no requieren migración. Consulta Autenticación por operación.",{"_3697":75564,"_31245":75445,"_21577":129122,"_5":14884,"_28435":128818,"_3074":129123},[],"Una configuración con `validate_server_cert: false` pasa a `insecure_skip_verify: true`, así que la verificación del receptor sigue sin realizarse hasta que ese campo se ponga a `false`. Corrígelo en cada configuración migrada: el canal de autorización del webhook transporta la API key o el bearer token, y saltarse la verificación expone esas credenciales a un atacante con posición de red. Mantén `insecure_skip_verify: true` solo si el certificado del receptor no es verificable de forma deliberada.",{"_3697":75565,"_31245":75445,"_21577":129125,"_5":14884,"_28435":128822,"_3074":129126},[],"Estos cambios modifican el contrato del que dependen los clientes de 3.8.0: endpoints y campos de la API REST, métodos del SDK de Go, los eventos que publican los servicios y el comportamiento que ven los dispositivos durante el enrolamiento. Los clientes, las integraciones y los dispositivos construidos para 3.8.0 tienen que adaptarse a ellos. Cada uno afecta solo a las integraciones que usan lo que cambia; comprueba la columna «A quién afecta». Los cambios en el despliegue, el almacenamiento y los datos guardados están en Cambios, aunque requieran acción durante la actualización.",{"_3697":75566,"_31245":75445,"_21577":129128,"_5":14884,"_28435":128822,"_3074":129129},[],"Cambio",{"_3697":75567,"_31245":75445,"_21577":129131,"_5":14884,"_28435":128822,"_3074":129132},[],"A quién afecta",{"_3697":75568,"_31245":75445,"_21577":129134,"_5":14884,"_28435":128822,"_3074":129135},[],"Gravedad",{"_3697":75569,"_31245":75445,"_21577":129137,"_5":14884,"_28435":128822,"_3074":127421},[],{"_3697":75570,"_31245":75445,"_21577":129139,"_5":14884,"_28435":128822,"_3074":128830},[],{"_3697":75571,"_31245":75445,"_21577":129141,"_5":14884,"_28435":128822,"_3074":129142},[],"Clientes de `/v1/roles`, políticas de autorización personalizadas sobre `va_role` y verificadores de certificados emitidos tras la actualización",{"_3697":75572,"_31245":75445,"_21577":129144,"_5":14884,"_28435":128822,"_3074":129145},[],"Alta: se eliminan las rutas `/v1/roles`",{"_3697":75573,"_31245":75445,"_21577":129147,"_5":14884,"_28435":128822,"_3074":129148},[],"Pasar los clientes a `/v1/crl-settings` con el ID de CA y actualizar las políticas",{"_3697":75574,"_31245":75445,"_21577":129150,"_5":14884,"_28435":128822,"_3074":128854},[],{"_3697":75575,"_31245":75445,"_21577":129152,"_5":14884,"_28435":128822,"_3074":129153},[],"Clientes que leen o escriben configuraciones de webhook por API, y DMS cuyo certificado o clave mTLS del webhook eran rutas de archivo",{"_3697":75576,"_31245":75445,"_21577":129155,"_5":14884,"_28435":128822,"_3074":129156},[],"Alta: los enrolamientos que llaman a un webhook con referencias a archivos fallan",{"_3697":75577,"_31245":75445,"_21577":129158,"_5":14884,"_28435":128822,"_3074":129159},[],"Usar los nombres de campo nuevos; volver a introducir certificado y clave como PEM, o eliminar los campos de archivo",{"_3697":75578,"_31245":75445,"_21577":129161,"_5":14884,"_28435":128822,"_3074":128882},[],{"_3697":75579,"_31245":75445,"_21577":129163,"_5":14884,"_28435":128822,"_3074":129164},[],"Todos los despliegues con dispositivos que presentan certificados no gestionados por Lamassu",{"_3697":75580,"_31245":75445,"_21577":129166,"_5":14884,"_28435":128822,"_3074":129167},[],"Media: el enrolamiento o el reenrolamiento de esos dispositivos falla",{"_3697":75581,"_31245":75445,"_21577":129169,"_5":14884,"_28435":128822,"_3074":129170},[],"Poner `allow_unverifiable_revocation` a `true` en los bloques DMS afectados, o asegurarse de que los certificados llevan puntos de distribución OCSP/CRL alcanzables",{"_3697":75582,"_31245":75445,"_21577":129172,"_5":14884,"_28435":128822,"_3074":128858},[],{"_3697":75583,"_31245":75445,"_21577":129174,"_5":14884,"_28435":128822,"_3074":129175},[],"Scripts y consolas que editan DMS por API",{"_3697":75584,"_31245":75445,"_21577":129177,"_5":14884,"_28435":128822,"_3074":129178},[],"Media: una edición con el formato antiguo vacía `validation_cas` sin avisar",{"_3697":75585,"_31245":75445,"_21577":129180,"_5":14884,"_28435":128822,"_3074":129181},[],"Leer el DMS antes de editarlo y usar el campo nuevo",{"_3697":75586,"_31245":75445,"_21577":129183,"_5":14884,"_28435":128822,"_3074":128834},[],{"_3697":75587,"_31245":75445,"_21577":129185,"_5":14884,"_28435":128822,"_3074":129186},[],"Clientes que crean o actualizan ajustes de CRL por API",{"_3697":75588,"_31245":75445,"_21577":129188,"_5":14884,"_28435":128822,"_3074":129189},[],"Media: las peticiones con el campo antiguo devuelven un error",{"_3697":75589,"_31245":75445,"_21577":129191,"_5":14884,"_28435":128822,"_3074":129192},[],"Sustituir `crl_options.subject_key_id_signer` por el obligatorio `crl_options.signer_serial_number`",{"_3697":75590,"_31245":75445,"_21577":129194,"_5":14884,"_28435":128822,"_3074":128874},[],{"_3697":75591,"_31245":75445,"_21577":129196,"_5":14884,"_28435":128822,"_3074":129197},[],"Suscripciones de alertas y consumidores de los eventos de la VA",{"_3697":75592,"_31245":75445,"_21577":129199,"_5":14884,"_28435":128822,"_3074":129200},[],"Media: los tipos de suscripción se renombran automáticamente, sus condiciones no",{"_3697":75593,"_31245":75445,"_21577":129202,"_5":14884,"_28435":128822,"_3074":129203},[],"Revisar las condiciones que filtran por el payload o el subject antiguo del evento",{"_3697":75594,"_31245":75445,"_21577":129205,"_5":14884,"_28435":128822,"_3074":128838},[],{"_3697":75595,"_31245":75445,"_21577":129207,"_5":14884,"_28435":128822,"_3074":129208},[],"Clientes que firman o verifican datos arbitrarios con la API o el SDK de Go de la CA, y suscripciones de alertas al evento `ca.sign.signature`",{"_3697":75596,"_31245":75445,"_21577":129210,"_5":14884,"_28435":128822,"_3074":129211},[],"Media: los endpoints, los métodos del SDK y el evento dejan de existir",{"_3697":75597,"_31245":75445,"_21577":129213,"_5":14884,"_28435":128822,"_3074":129214},[],"Firmar y verificar con claves del KMS; eliminar las suscripciones al evento",{"_3697":75598,"_31245":75445,"_21577":129216,"_5":14884,"_28435":128822,"_3074":128866},[],{"_3697":75599,"_31245":75445,"_21577":129218,"_5":14884,"_28435":128822,"_3074":129219},[],"Consumidores que leen el campo `events` del dispositivo",{"_3697":75600,"_31245":75445,"_21577":129221,"_5":14884,"_28435":128822,"_3074":129222},[],"Media: el campo desaparece",{"_3697":75601,"_31245":75445,"_21577":129224,"_5":14884,"_28435":128822,"_3074":129225},[],"Usar los nuevos endpoints de eventos",{"_3697":75602,"_31245":75445,"_21577":129227,"_5":14884,"_28435":128822,"_3074":128850},[],{"_3697":75603,"_31245":75445,"_21577":129229,"_5":14884,"_28435":128822,"_3074":129230},[],"Clientes que usan un alias igual a un ID de clave existente",{"_3697":75604,"_31245":75445,"_21577":129232,"_5":14884,"_28435":128822,"_3074":129233},[],"Media: el alias se elimina y el ID tiene prioridad",{"_3697":75605,"_31245":75445,"_21577":129235,"_5":14884,"_28435":128822,"_3074":129236},[],"Revisar y actualizar las referencias afectadas",{"_3697":75606,"_31245":75445,"_21577":129238,"_5":14884,"_28435":128822,"_3074":128862},[],{"_3697":75607,"_31245":75445,"_21577":129240,"_5":14884,"_28435":128822,"_3074":129241},[],"Clientes que envían el ID del DMS en el cuerpo de la actualización",{"_3697":75608,"_31245":75445,"_21577":129243,"_5":14884,"_28435":128822,"_3074":129244},[],"Baja: prevalece el ID de la URL",{"_3697":75609,"_31245":75445,"_21577":129246,"_5":14884,"_28435":128822,"_3074":129247},[],"Enviar el ID en la URL",{"_3697":75610,"_31245":75445,"_21577":129249,"_5":14884,"_28435":128822,"_3074":128842},[],{"_3697":75611,"_31245":75445,"_21577":129251,"_5":14884,"_28435":128822,"_3074":129252},[],"Clientes que envían un `id` al crear o importar CAs",{"_3697":75612,"_31245":75445,"_21577":129254,"_5":14884,"_28435":128822,"_3074":129255},[],"Baja: el ID del cuerpo se ignora y el campo desaparece",{"_3697":75613,"_31245":75445,"_21577":129257,"_5":14884,"_28435":128822,"_3074":129258},[],"Dejar que el backend asigne el ID y usar el que devuelve",{"_3697":75614,"_31245":75445,"_21577":129260,"_5":14884,"_28435":128822,"_3074":128846},[],{"_3697":75615,"_31245":75445,"_21577":129262,"_5":14884,"_28435":128822,"_3074":129263},[],"Consumidores que comparan el `type` del certificado",{"_3697":75616,"_31245":75445,"_21577":129265,"_5":14884,"_28435":128822,"_3074":129266},[],"Baja: dos valores cambian de nombre",{"_3697":75617,"_31245":75445,"_21577":129268,"_5":14884,"_28435":128822,"_3074":129269},[],"Adaptar los consumidores",{"_3697":75618,"_31245":75445,"_21577":129271,"_5":14884,"_28435":128829,"_3074":129272},[],"En 3.8.0 la VA indexaba cada CRL por el SKI de la CA, y `GET`/`PUT /v1/roles/{ca-ski}` la leían y actualizaban. En 4.0.0 los ajustes de CRL de una CA se indexan por su ID de CA, y cada CA tiene los suyos, incluso cuando dos CAs comparten clave.",{"_3697":75619,"_31245":75445,"_21577":129274,"_5":14884,"_28435":128829,"_3074":129275},[],"Adapta los clientes de `/v1/roles` a `/v1/crl-settings` usando el ID de CA. La guía de CRL describe las operaciones y opciones.",{"_3697":75620,"_31245":75445,"_21577":129277,"_5":14884,"_28435":128829,"_3074":129278},[],"El endpoint público `GET /crl/{id}` toma el ID de la CA — la forma que usan los CDP de los certificados emitidos a partir de ahora — y sigue resolviendo la forma por SKI de los certificados emitidos antes de la actualización. Los certificados anteriores a la actualización conservan sus puntos de distribución `/crl/<ski>`; los recién emitidos llevan `/crl/<ca-id>`, y ambos resuelven a los mismos ajustes. El job de CRL de la VA solicita una lista nueva en su primera ejecución, y esta incluye ambas URLs en su *Issuing Distribution Point*. Hasta que lo consiga, la lista antigua solo contiene el IDP heredado `/crl/<ski>`: los verificadores que lo comparan con el CDP de certificados recién emitidos no pueden validar esos certificados. Con la frecuencia predeterminada, la primera ejecución puede tardar hasta aproximadamente una hora; los fallos pueden prolongar ese intervalo.",{"_3697":75621,"_31245":75445,"_21577":129280,"_5":14884,"_28435":128829,"_3074":129281},[],"Migración de los ajustes de CRL describe cómo convierte la actualización los roles guardados, con qué datos aborta y por qué no puede revertirse.",{"_3697":75622,"_31245":75445,"_21577":129283,"_5":14884,"_28435":128829,"_3074":129284},[],"**Políticas de autorización personalizadas.** La entidad `va_role` se renombra a `crl_settings`, con `ca_id` como clave primaria y `signer_serial_number` como su relación con certificados. Actualiza las políticas que referencien la entidad antigua. La entidad incorpora la acción atómica `delete`, una relación `signer_key_id` con las claves del KMS y las columnas filtrables `signer_engine_id` y `signer_key_id`; concede la acción nueva a quien pueda borrar ajustes de CRL archivados. Sustituye el filtro de firmante de 3.8.0 `crl_subject_key_id_signer` (o `crl_signer_certificate_serial_number` si se usa en una versión intermedia) por `signer_serial_number`. Sustituye los valores SKI del filtro por los números de serie de los certificados correspondientes; cambiar solo el nombre del filtro no basta.",{"_3697":75623,"_31245":75445,"_21577":129286,"_5":14884,"_28435":128833,"_3074":129287},[],"`crl_options.subject_key_id_signer` se sustituye por el obligatorio `crl_options.signer_serial_number`, el número de serie del certificado existente que firma la CRL. El valor inicial de una CA nueva es el número de serie de su certificado actual. Las peticiones que aún contienen `subject_key_id_signer` devuelven un error. La entidad de autorización que guarda estos ajustes también cambia de nombre; consulta Ajustes de CRL indexados por ID de CA.",{"_3697":75624,"_31245":75445,"_21577":129289,"_5":14884,"_28435":128837,"_3074":129290},[],"`POST /v1/cas/{id}/signature/sign` y `POST /v1/cas/{id}/signature/verify` ya no existen: el servicio de CA ya no firma ni verifica datos arbitrarios, de modo que la clave privada de una CA solo firma certificados. Los métodos `CAService.SignatureSign` y `CAService.SignatureVerify` del SDK de Go también se eliminan, y el evento `ca.sign.signature` deja de publicarse, así que las suscripciones de alertas y los consumidores del bus de eventos que se basen en él nunca vuelven a dispararse — elimina esas suscripciones y redirige a los consumidores. Firma y verifica datos arbitrarios con una clave del KMS, mediante `POST /api/kms/v1/keys/{id}/sign` y `POST /api/kms/v1/keys/{id}/verify` (en el SDK de Go, `KMSService.SignMessage` y `KMSService.VerifySignature`); el equivalente en la consola se describe en Firmar y verificar. Una CA además solo se acepta para firmar cuando su ventana de validez incluye el momento actual, aunque su estado almacenado siga mostrando `ACTIVE`.",{"_3697":75625,"_31245":75445,"_21577":129292,"_5":14884,"_28435":128841,"_3074":129293},[],"Crear o importar una CA la registra con un UUID generado por el backend. Cualquier `id` enviado en el cuerpo de la petición se ignora, y el campo desaparece de los cuerpos de creación e importación. Los scripts que enviaban su propio ID y se dirigían a la CA con él deben leer el ID que devuelve el backend.",{"_3697":75626,"_31245":75445,"_21577":129295,"_5":14884,"_28435":128845,"_3074":129296},[],"Los valores del campo `type` del certificado cambian de nombre: `IMPORTED` pasa a `IMPORTED_WITH_KEY` y `EXTERNAL` pasa a `IMPORTED_WITHOUT_KEY`. `MANAGED` no cambia. La actualización convierte los valores almacenados; adapta los consumidores que leen o comparan esos valores.",{"_3697":75627,"_31245":75445,"_21577":129298,"_5":14884,"_28435":128849,"_3074":129299},[],"Los identificadores del KMS se resuelven ahora como ID de clave antes que como alias. Por eso la migración del KMS elimina, con un `NOTICE`, los alias iguales a un ID de clave existente. Los alias afectados se descartan, no se redirigen: un cliente que usaba uno llega ahora a la clave con ese ID.",{"_3697":75628,"_31245":75445,"_21577":129301,"_5":14884,"_28435":128853,"_3074":129302},[],"Las configuraciones de webhook cambian de formato y sus campos se renombran. La actualización reescribe las configuraciones almacenadas; los clientes de API que las leen o escriben deben usar los nombres nuevos:",{"_3697":75629,"_31245":75445,"_21577":129304,"_5":14884,"_28435":128853,"_3074":129305},[],"Campo en 3.8.0",{"_3697":75630,"_31245":75445,"_21577":129307,"_5":14884,"_28435":128853,"_3074":129308},[],"Campo en 4.0.0",{"_3697":75631,"_31245":75445,"_21577":129310,"_5":14884,"_28435":128853,"_3074":60094},[],{"_3697":75632,"_31245":75445,"_21577":129312,"_5":14884,"_28435":128853,"_3074":129313},[],"`insecure_skip_verify` (con el valor negado)",{"_3697":75633,"_31245":75445,"_21577":129315,"_5":14884,"_28435":128853,"_3074":60100},[],{"_3697":75634,"_31245":75445,"_21577":129317,"_5":14884,"_28435":128853,"_3074":60103},[],{"_3697":75635,"_31245":75445,"_21577":129319,"_5":14884,"_28435":128853,"_3074":60106},[],{"_3697":75636,"_31245":75445,"_21577":129321,"_5":14884,"_28435":128853,"_3074":60109},[],{"_3697":75637,"_31245":75445,"_21577":129323,"_5":14884,"_28435":128853,"_3074":60112},[],{"_3697":75638,"_31245":75445,"_21577":129325,"_5":14884,"_28435":128853,"_3074":60115},[],{"_3697":75639,"_31245":75445,"_21577":129327,"_5":14884,"_28435":128853,"_3074":129328},[],"Cuando el certificado y la clave mTLS heredados son ambos PEM, se trasladan a `mtls_options.cert_content` y `mtls_options.key_content` y no requieren acción. Las referencias a archivos sí requieren intervención; revisa también la verificación del receptor.",{"_3697":75640,"_31245":75445,"_21577":129330,"_5":14884,"_28435":128853,"_3074":129331},[],"**Webhooks con referencias a archivos.** Una configuración mixta, con el certificado en PEM y la clave como ruta de archivo, se migra a `mtls_options.cert_file` y `mtls_options.key_file`. La entrega del webhook rechaza esos campos en cada llamada, sea cual sea el modo de autenticación configurado, de modo que todos los enrolamientos y reenrolamientos que llaman a ese webhook fallan hasta corregir la configuración. Si el webhook usa mTLS, vuelve a introducir el certificado y la clave como PEM, en Base64 o en texto plano; si no lo usa, elimina los campos de archivo sobrantes. Mientras tanto, las actualizaciones de solo metadatos siguen funcionando (`PUT` o `PATCH` sobre `/v1/dms/:id/metadata`). En una variante del mismo problema, una configuración almacenada con rutas de archivo dentro de `mtls_options.cert_content` o `mtls_options.key_content` hace fallar la validación de toda actualización completa de ajustes (`POST /v1/dms` o `PUT /v1/dms/:id`); los ajustes se sustituyen al completo, así que reenvía la configuración con el certificado y la clave como PEM.",{"_3697":75641,"_31245":75445,"_21577":129333,"_5":14884,"_28435":128857,"_3074":129334},[],"El campo plano `reenrollment_settings.additional_validation_cas` se traslada al campo anidado `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`:",{"_3697":75642,"_31245":75445,"_21577":129336,"_5":14884,"_28435":128857,"_3074":129337},[],"El conjunto de confianza efectivo no cambia, porque el valor anidado nunca se consultó al validar reenrolamientos. Si la lista plana estaba ausente o era nula, pasa a ser una lista vacía.",{"_3697":75643,"_31245":75445,"_21577":129339,"_5":14884,"_28435":128857,"_3074":129340},[],"Lo que cambia es el tratamiento de las peticiones por API. Los cuerpos que aún contienen `additional_validation_cas` se aceptan, pero su valor se descarta en silencio porque los campos JSON desconocidos se ignoran, y las respuestas GET ya no lo incluyen. Por tanto, un cuerpo de actualización construido con el formato antiguo vacía `validation_cas` sin ningún error. Lee siempre el DMS antes de enviar una edición y reutiliza el formato que devuelve la API.",{"_3697":75644,"_31245":75445,"_21577":129342,"_5":14884,"_28435":128861,"_3074":129343},[],"`PUT /v1/dms/:id` toma el ID del DMS de la URL y valida el cuerpo de la petición. Un ID en el cuerpo se ignora, así que actualiza los clientes que dependían de él.",{"_3697":75645,"_31245":75445,"_21577":129345,"_5":14884,"_28435":128865,"_3074":129346},[],"El campo `events` ya no aparece en la representación del dispositivo. Apunta los consumidores a los nuevos endpoints:",{"_3697":75646,"_31245":75445,"_21577":129348,"_5":14884,"_28435":128865,"_3074":129349},[],"`GET /v1/devices/:id/events` devuelve los eventos de un dispositivo.",{"_3697":75647,"_31245":75445,"_21577":129351,"_5":14884,"_28435":128865,"_3074":129352},[],"`POST /v1/devices/:id/events` crea un evento.",{"_3697":75648,"_31245":75445,"_21577":129354,"_5":14884,"_28435":128865,"_3074":129355},[],"El endpoint también admite SSE. Consulta API de eventos y flujo en vivo.",{"_3697":75649,"_31245":75445,"_21577":129357,"_5":14884,"_28435":128869,"_3074":129358},[],"Dos cambios afectan a las suscripciones de alertas y a los consumidores del bus de eventos: los eventos de la VA cambian de nombre y de forma, y `ca.sign.signature` deja de publicarse porque la CA ya no firma datos arbitrarios (consulta Eliminación de los endpoints de firma arbitraria de la CA).",{"_3697":75650,"_31245":75445,"_21577":129360,"_5":14884,"_28435":128873,"_3074":129361},[],"`va.role.update` pasa a `va.crl-settings.update` y `va.role.crl.init` pasa a `va.crl-settings.init`; `va.role.crl.create` conserva su nombre y su payload. Todos los subjects cambian de `crl/<ski>` a `crl/<ca-id>`, y el payload de los eventos renombrados pasa del rol de VA antiguo a los ajustes de CRL de la CA, con `ca_id` en lugar de `ca_ski`. La migración de alerts renombra automáticamente los tipos de evento de las suscripciones existentes, pero no reescribe sus condiciones — JSON Path, JSON Schema o JavaScript: revisa las condiciones que filtren por el payload antiguo o por el subject antiguo `crl/<ski>`, incluidas las de `va.role.crl.create`. Los consumidores directos del bus de eventos y las búsquedas de auditoría deben adoptar por su cuenta los nombres y el payload nuevos.",{"_3697":75651,"_31245":75445,"_21577":129363,"_5":14884,"_28435":128881,"_3074":129364},[],"El enrolamiento y el reenrolamiento comprueban ahora la revocación de los certificados presentados y fallan cerrados cuando no puede verificarse. No hay migración: todo DMS preexistente tiene la nueva opción `allow_unverifiable_revocation` con su valor por defecto `false`, así que un certificado que no gestiona Lamassu y no lleva puntos de distribución OCSP o CRL se rechaza hasta que la opción se ponga a `true` en el bloque afectado, de forma independiente en el bloque de enrolamiento y en el de reenrolamiento.",{"_3697":75652,"_31245":75445,"_21577":129366,"_5":14884,"_28435":128881,"_3074":129367},[],"Los certificados que sí llevan endpoints siguen comprobándose con rigor: los endpoints que no responden o devuelven respuestas caducadas o no concluyentes rechazan el certificado aunque `allow_unverifiable_revocation` esté activo, y los certificados gestionados por Lamassu no se ven afectados porque se usa su estado almacenado. Una CA de validación revocada en Lamassu también rechaza la operación, sin recurrir a las demás CAs de validación. Consulta la guía de DMS y Revocación y comprobaciones.",{"_3697":75653,"_31245":75445,"_21577":129369,"_5":14884,"_28435":128885,"_3074":129370},[],"La actualización sigue un orden fijo: preparar los datos y los values, ejecutar `helm upgrade` y después copiar los datos del KMS y la VA a los volúmenes nuevos. La copia debe hacerse después de la actualización, porque los StatefulSets y PVC de destino no existen antes. Si no estás actualizando una release existente, ve directamente a Instalar con Helm.",{"_3697":75654,"_31245":75445,"_21577":129372,"_5":14884,"_28435":128889,"_3074":129373},[],"Haz una copia de seguridad verificable de PostgreSQL y del almacenamiento de objetos de las CRLs — el bucket de la VA, o el volumen local que contiene las CRLs — y programa una parada de servicio. La actualización mueve los datos de todos los servicios a `pki`, y la migración de la VA es irreversible: volver a 3.8.0 requiere ambas copias (consulta Migración de los ajustes de CRL).",{"_3697":75655,"_31245":75445,"_21577":129375,"_5":14884,"_28435":128889,"_3074":129376},[],"Si el despliegue usa SQLite, `couch_db` o `dynamo_db`, pásalo antes a PostgreSQL.",{"_3697":75656,"_31245":75445,"_21577":129378,"_5":14884,"_28435":128889,"_3074":129379},[],"Resuelve los IDs de CA duplicados y rellena `engine_id` en `kms_keys`, como se describe en Consolidación en PostgreSQL.",{"_3697":75657,"_31245":75445,"_21577":129381,"_5":14884,"_28435":128889,"_3074":129382},[],"Opcionalmente, ejecuta la comprobación previa a la actualización sobre los datos de 3.8.0 consolidados antes de aplicar las migraciones.",{"_3697":75658,"_31245":75445,"_21577":129384,"_5":14884,"_28435":128889,"_3074":129385},[],"Anota los nombres de tus PVC de almacenamiento local:",{"_3697":75659,"_31245":75445,"_21577":129387,"_5":14884,"_28435":128889,"_3074":129388},[],"`helm upgrade` no toca ni borra los PVC antiguos, pero tras la actualización nada los referencia. Necesitas sus nombres para copiar los datos y para limpiar más tarde.",{"_3697":75660,"_31245":75445,"_21577":129390,"_5":14884,"_28435":128893,"_3074":129391},[],"Las migraciones de base de datos de 4.0.0 se niegan a ejecutarse con datos que no pueden migrar de forma segura: abortan y nombran los objetos conflictivos. La herramienta `upgrade-check` informa de todos esos problemas antes de la actualización, en una única ejecución y con el mismo texto que usaría la migración. Es de solo lectura: nunca escribe filas en la base de datos ni claves.",{"_3697":75661,"_31245":75445,"_21577":129393,"_5":14884,"_28435":128893,"_3074":129394},[],"Imagen: `ghcr.io/lamassuiot/lamassu-upgrade-check`. Se configura con un archivo YAML al estilo del KMS pasado por `LAMASSU_CONFIG_FILE`; solo admite el proveedor de almacenamiento `postgres`.",{"_3697":75662,"_31245":75445,"_21577":129396,"_5":14884,"_28435":128893,"_3074":129397},[],"Ejecútala sobre los datos de 3.8.0 una vez consolidados en los esquemas de `pki`, y antes de que se ejecute cualquier migración de 4.0.0 o arranque cualquier servicio de 4.0.0.",{"_3697":75663,"_31245":75445,"_21577":129399,"_5":14884,"_28435":128893,"_3074":129400},[],"Códigos de salida: `0` significa que no se encontraron problemas, `1` que se encontró al menos uno y `2` que la orden no pudo ejecutarse (configuración incorrecta, base de datos inalcanzable o una base de datos que no es de 3.8.0), o que alguna comprobación no pudo ejecutarse.",{"_3697":75664,"_31245":75445,"_21577":129402,"_5":14884,"_28435":128893,"_3074":129403},[],"Cubre solo las migraciones de la VA: un resultado limpio no demuestra que las comprobaciones de las migraciones de CA y del KMS vayan a pasar, así que no sustituye a las verificaciones de IDs de CA duplicados y de `engine_id` descritas en Consolidación en PostgreSQL.",{"_3697":75665,"_31245":75445,"_21577":129405,"_5":14884,"_28435":128897,"_3074":129406},[],"**Crea los Secrets de credenciales.** El chart de 4.0.0 lee las credenciales de PostgreSQL, AMQP y SMTP de Secrets de Kubernetes, y el job de base de datos de pre-upgrade las necesita antes de que se ejecute la actualización. Copia las credenciales de 3.8.0 a tu proveedor de gestión de secretos y crea los Secrets con el External Secrets Operator (ESO), que el chart no instala:",{"_3697":75666,"_31245":75445,"_21577":129408,"_5":14884,"_28435":128897,"_3074":129409},[],"Configura ESO y su proveedor (`SecretStore` o `ClusterSecretStore`).",{"_3697":75667,"_31245":75445,"_21577":129411,"_5":14884,"_28435":128897,"_3074":129412},[],"Crea un `ExternalSecret` por cada conjunto de credenciales que uses. Su Secret de destino debe vivir en el namespace de la release, llamarse como el valor `existingSecret` correspondiente y contener estas claves:",{"_3697":75668,"_31245":75445,"_21577":129414,"_5":14884,"_28435":128897,"_3074":60205},[],{"_3697":75669,"_31245":75445,"_21577":129416,"_5":14884,"_28435":128897,"_3074":129417},[],"Claves de datos obligatorias",{"_3697":75670,"_31245":75445,"_21577":129419,"_5":14884,"_28435":128897,"_3074":129420},[],"Cuándo",{"_3697":75671,"_31245":75445,"_21577":129422,"_5":14884,"_28435":128897,"_3074":129423},[],"`lamassu-postgres` (por defecto de `postgres.existingSecret`)",{"_3697":75672,"_31245":75445,"_21577":129425,"_5":14884,"_28435":128897,"_3074":60217},[],{"_3697":75673,"_31245":75445,"_21577":129427,"_5":14884,"_28435":128897,"_3074":129428},[],"Siempre",{"_3697":75674,"_31245":75445,"_21577":129430,"_5":14884,"_28435":128897,"_3074":129431},[],"`lamassu-amqp` (por defecto de `amqp.existingSecret`)",{"_3697":75675,"_31245":75445,"_21577":129433,"_5":14884,"_28435":128897,"_3074":60217},[],{"_3697":75676,"_31245":75445,"_21577":129435,"_5":14884,"_28435":128897,"_3074":129428},[],{"_3697":75677,"_31245":75445,"_21577":129437,"_5":14884,"_28435":128897,"_3074":60230},[],{"_3697":75678,"_31245":75445,"_21577":129439,"_5":14884,"_28435":128897,"_3074":60217},[],{"_3697":75679,"_31245":75445,"_21577":129441,"_5":14884,"_28435":128897,"_3074":129442},[],"Solo cuando hay autenticación SMTP",{"_3697":75680,"_31245":75445,"_21577":129444,"_5":14884,"_28435":128897,"_3074":129445},[],"Espera a que cada `ExternalSecret` esté Ready y verifica los Secrets generados antes de ejecutar la actualización.",{"_3697":75681,"_31245":75445,"_21577":129447,"_5":14884,"_28435":128897,"_3074":129448},[],"No cambies las contraseñas de la base de datos ni del broker como parte de esta migración: ESO sincroniza credenciales en Secrets, pero no actualiza los usuarios configurados en el servidor PostgreSQL ni en el broker. Quitar credenciales del archivo de values no deshace la exposición previa — si se llegaron a subir a Git, rotarlas cuando la migración se haya completado.",{"_3697":75682,"_31245":75445,"_21577":129450,"_5":14884,"_28435":128897,"_3074":129451},[],"El `charts/lamassu/README.md` del repositorio Helm documenta en su sección *Secret management* un ejemplo completo y funcional: instalar external-secrets 0.20.2, un `ClusterSecretStore` Fake de prueba, los recursos `ExternalSecret` y la espera de la sincronización. Su proveedor Fake es solo para pruebas; para producción, sustitúyelo por la configuración de tu proveedor.",{"_3697":75683,"_31245":75445,"_21577":129453,"_5":14884,"_28435":128897,"_3074":129454},[],"**Añade `services.authz`.** Configura el endpoint JWKS, las bases de datos y el principal de bootstrap:",{"_3697":75684,"_31245":75445,"_21577":129456,"_5":14884,"_28435":128897,"_3074":129457},[],"`jwkUrl` se consulta desde el pod de `authz`, no desde el gateway, así que un Service del namespace de la release puede referenciarse por su nombre corto. El valor por defecto apunta a un Service de Keycloak llamado `auth-keycloak`; defínelo explícitamente si tu proveedor de identidad está en otro sitio.",{"_3697":75685,"_31245":75445,"_21577":129459,"_5":14884,"_28435":128897,"_3074":129460},[],"`authz` es el almacenamiento propio del servicio de autorización para principales, permisos y políticas. `pki` es la base de datos que consulta el motor de autorización al evaluar las políticas sobre las entidades. Solo se exige el campo `database` de cada entrada; los `hostname` y `port` por esquema se siguen aceptando pero se ignoran — la conexión usa siempre los `postgres.hostname` y `postgres.port` globales con el Secret de credenciales de PostgreSQL global, `postgres.existingSecret` con sus nombres de clave configurados, salvo que la entrada defina su propio `existingSecret` (con `usernameKey` y `passwordKey` opcionales).",{"_3697":75686,"_31245":75445,"_21577":129462,"_5":14884,"_28435":128897,"_3074":129463},[],"Si mantuviste los roles por defecto de 3.8.0 (`realm_access.roles` y `pki-admin`), el `services.authz.bootstrap` por defecto ya coincide con ellos.",{"_3697":75687,"_31245":75445,"_21577":129465,"_5":14884,"_28435":128897,"_3074":129466},[],"**Elimina los bloques de validación de tokens del gateway.** Quita `auth.oidc.apiGateway` y `auth.authorization` una vez que su configuración esté en `services.authz`:",{"_3697":75688,"_31245":75445,"_21577":129468,"_5":14884,"_28435":128897,"_3074":129469},[],"**Renombra `toolbox` a `connectivityTest`:**",{"_3697":75689,"_31245":75445,"_21577":129471,"_5":14884,"_28435":128897,"_3074":129472},[],"**Elimina las sobrescrituras de identidad por servicio** `services.kms.securityContext.runAsGroup` y `services.authz.securityContext.runAsUser`/`runAsGroup`.",{"_3697":75690,"_31245":75445,"_21577":129474,"_5":14884,"_28435":128897,"_3074":129475},[],"**Convierte `services.connectors` en un mapa** indexado por ID de conector, con el `type` y la `image` de cada entrada:",{"_3697":75691,"_31245":75445,"_21577":129477,"_5":14884,"_28435":128897,"_3074":129478},[],"**Revisa AMQP.** Si defines `amqp.tls: true`, define también `amqp.port` con el listener TLS del broker (habitualmente `5671`), o pon `amqp.tls: false` para seguir en texto plano.",{"_3697":75692,"_31245":75445,"_21577":129480,"_5":14884,"_28435":128897,"_3074":129481},[],"**Activa la migración de CA a KMS** si tus claves de CA son anteriores al KMS:",{"_3697":75693,"_31245":75445,"_21577":129483,"_5":14884,"_28435":128897,"_3074":129484},[],"**Revisa el resto de values:** sobrescrituras que fijaban `services.ui.port` a `80`, el antiguo bloque `probes:`, el issuer de TLS, y `affinity` y `topologySpreadConstraints` explícitos donde tu clúster los necesite. Values renombrados y reestructurados describe cada uno.",{"_3697":75694,"_31245":75445,"_21577":129486,"_5":14884,"_28435":128897,"_3074":129487},[],"Ejecuta `helm lint` con los values nuevos antes de actualizar; el schema estricto informa de cualquier clave que siga siendo desconocida. Antes de ejecutar el paso 3, confirma que cada `ExternalSecret` de credenciales esté Ready y que los Secrets generados contengan las claves esperadas.",{"_3697":75695,"_31245":75445,"_21577":129489,"_5":14884,"_28435":128901,"_3074":129490},[],"Helm ejecuta los hooks de preactualización —la migración de CA a KMS si está activada y el job de base de datos— antes de aplicar ninguna carga, así que los servicios nunca arrancan contra una base de datos sin preparar. Si la validación rechaza values desconocidos, corrige el archivo y vuelve a ejecutar.",{"_3697":75696,"_31245":75445,"_21577":129492,"_5":14884,"_28435":128901,"_3074":129493},[],"Si el despliegue usa almacenamiento local en el KMS o la VA, esos pods fallan hasta que completes el paso 4, así que `--wait` no puede terminar bien: Helm espera a que estén listos, agota el tiempo, sale con error y marca la release como `failed`. Para entonces los hooks ya se han ejecutado y se han aplicado todos los manifiestos, incluidos los nuevos StatefulSets y sus PVC. Sin `--atomic`, Helm no revierte nada. Continúa con el paso 4 y después vuelve a lanzar el mismo comando `helm upgrade` para que termine y Helm registre la release como `deployed`. Los dos hooks son idempotentes, así que es seguro volver a ejecutarlos.",{"_3697":75697,"_31245":75445,"_21577":129495,"_5":14884,"_28435":128905,"_3074":129496},[],"Omite este paso si `services.kms.cryptoEngines` nunca usó un motor `filesystem` y `services.va.fileStore.type` nunca fue `local`.",{"_3697":75698,"_31245":75445,"_21577":129498,"_5":14884,"_28435":128905,"_3074":129499},[],"**Localiza los nuevos StatefulSets y PVC.** Sus nombres dependen del nombre de la release y de cualquier `nameOverride` o `fullnameOverride`; el nombre del PVC es `<volumeClaimTemplate>-<nombre del StatefulSet>-0`:",{"_3697":75699,"_31245":75445,"_21577":129501,"_5":14884,"_28435":128905,"_3074":129502},[],"Con la release `lamassu` y el nombre de chart por defecto, los nuevos PVC son `golang-engine-storage-lamassu-kms-0` y `local-crl-file-storage-lamassu-va-0`; con la release `prod` son `golang-engine-storage-prod-lamassu-kms-0` y `local-crl-file-storage-prod-lamassu-va-0`. Comprueba que existen los PVC antiguos y nuevos antes de continuar. Si `claims_ok` imprime `ABORT`, el bloque se detiene antes de listar las PVC: o falló la búsqueda de un StatefulSet, o una PVC nueva resuelve a la PVC de 3.8.0. En el segundo caso la copia se verificaría contra sí misma y la limpieza final borraría el volumen en uso. El chart siempre añade `-kms` y `-va` al nombre con ámbito de release, así que una colisión indica que las PVC no son las que esta guía espera; investiga antes de seguir. El punto 3 repite la comprobación y no crea el pod auxiliar, así que nada toca los volúmenes. La comprobación devuelve un error en lugar de llamar a `exit`, que cerraría tu shell y perdería las variables definidas hasta ahora. Si solo migras uno de los dos servicios, quita las PVC del otro de los comandos siguientes.",{"_3697":75700,"_31245":75445,"_21577":129504,"_5":14884,"_28435":128905,"_3074":129505},[],"**Anota el número de réplicas, reduce a cero los nuevos StatefulSets y espera a que terminen todos los pods que usan las PVC**, para que nada escriba en ninguno de los volúmenes mientras copias. Helm elimina los StatefulSets `kms` y `va` de 3.8.0 durante la actualización, pero sus pods `kms-0` y `va-0` pueden seguir terminando y reteniendo las PVC antiguas. Mientras sigan en marcha, el pod auxiliar no puede montar las PVC o copia un volumen en el que aún se escribe. El `wait` termina al instante para los pods que ya no existen:",{"_3697":75701,"_31245":75445,"_21577":129507,"_5":14884,"_28435":128905,"_3074":129508},[],"**Arranca un pod auxiliar efímero** que monte las cuatro PVC. Se ejecuta como root para poder cambiar la propiedad de los archivos, así que fija su imagen por digest y no montes el token de la service account:",{"_3697":75702,"_31245":75445,"_21577":129510,"_5":14884,"_28435":128905,"_3074":129511},[],"**Inspecciona antes de escribir** para no machacar datos que los pods nuevos pudieran haber escrito ya:",{"_3697":75703,"_31245":75445,"_21577":129513,"_5":14884,"_28435":128905,"_3074":129514},[],"Un resultado vacío es lo habitual: el pod propio de un StatefulSet rara vez llega a escribir nada cuando le faltan sus datos. Si la salida no está vacía, anota los archivos y confirma con el responsable del servicio que se pueden descartar antes de copiar; no superpongas los datos de 3.8.0 sobre un almacén desconocido.",{"_3697":75704,"_31245":75445,"_21577":129516,"_5":14884,"_28435":128905,"_3074":129517},[],"**Copia los datos, ajusta la propiedad y verifica la copia.** El segundo comando debe imprimir `copy verified`; cualquier salida de `diff` indica que la copia está incompleta, así que no continúes:",{"_3697":75705,"_31245":75445,"_21577":129519,"_5":14884,"_28435":128905,"_3074":129520},[],"El `chown` es obligatorio aunque los archivos antiguos ya parezcan pertenecer a un usuario sin root, porque 4.0.0 exige exactamente `65532:65532` y no recurre a lo que declare la imagen.",{"_3697":75706,"_31245":75445,"_21577":129522,"_5":14884,"_28435":128905,"_3074":129523},[],"**Elimina el auxiliar y restaura el número de réplicas anotado:**",{"_3697":75707,"_31245":75445,"_21577":129525,"_5":14884,"_28435":128905,"_3074":129526},[],"**Vuelve a lanzar el comando `helm upgrade` del paso 3.** Los pods del KMS y la VA arrancan ahora con los datos copiados, así que `--wait` termina bien y la release pasa de `failed` a `deployed`.",{"_3697":75708,"_31245":75445,"_21577":129528,"_5":14884,"_28435":128909,"_3074":129529},[],"Cuando la actualización que realizó la migración de CA a KMS termine correctamente, quita `migrations.caToKms.enabled` de tus values (su valor por defecto es `false`). El hook lee el ConfigMap heredado `kms-config` de 3.8.0 mientras existe y, cuando desaparece, recurre al ConfigMap con ámbito de release `<release>-lamassu-kms-config`.",{"_3697":75709,"_31245":75445,"_21577":129531,"_5":14884,"_28435":128909,"_3074":129532},[],"Después recorre el checklist de validación. Conserva los PVC antiguos hasta que lo superes.",{"_3697":75710,"_31245":75445,"_21577":129534,"_5":14884,"_28435":128913,"_3074":129535},[],"Sin el job de base de datos del chart, ninguna herramienta mueve datos entre bases de datos: las herramientas de migración solo aplican migraciones sobre un esquema que ya existe. Traslada tú cada base de datos por servicio a su esquema de `pki`, conservando estructura, índices, restricciones, datos e historial de migraciones, con las escrituras detenidas y una copia de seguridad verificada.",{"_3697":75711,"_31245":75445,"_21577":129537,"_5":14884,"_28435":128913,"_3074":129538},[],"Ejecuta las migraciones en el orden obligatorio, un esquema cada vez: primero `kms`, después la herramienta `ca-to-kms-migration` (necesaria solo en despliegues heredados cuyas claves de CA se nombran por SKI), luego `ca` y por último `va`. Los esquemas `devicemanager`, `dmsmanager` y `alerts` son independientes y pueden migrarse en cualquier orden. Con Helm, el job de preinstalación del chart aplica los esquemas en el orden correcto automáticamente.",{"_3697":75712,"_31245":75445,"_21577":129540,"_5":14884,"_28435":128913,"_3074":129541},[],"Si `kms` no se ha migrado, la migración de `ca` falla con `kms schema not found: migrate the kms schema before the ca schema`. La migración de `va` requiere que `ca` y `kms` se hayan migrado primero: falla con `ca schema not found: migrate the ca schema before the va schema` o `kms schema not found: migrate the kms schema before the va schema` si falta alguno de los dos.",{"_3697":75713,"_31245":75445,"_21577":129543,"_5":14884,"_28435":128913,"_3074":129544},[],"Los esquemas se referencian entre sí, así que el rol de PostgreSQL que ejecuta las migraciones necesita privilegios entre esquemas: el esquema `ca` necesita `USAGE` sobre `kms` más `SELECT`, `REFERENCES` e `INSERT` sobre `kms.kms_keys`, y el esquema `va` necesita `USAGE` sobre `ca` más `SELECT` y `REFERENCES` sobre `ca.certificates`, `SELECT` sobre `ca.ca_certificates`, y `USAGE` sobre `kms` más `SELECT` y `REFERENCES` sobre `kms.kms_keys`. Sin ellos la migración aborta; concede los privilegios que falten y vuelve a ejecutar el esquema fallido. Tras migrar `ca`, si el servicio de CA corre con un usuario distinto del usuario de migración, concédele `SELECT` sobre `ca.certificates_view` (`GRANT SELECT ON ca.certificates_view TO service_user`). Sin ese permiso, las lecturas de certificados y CAs fallan con `permission denied for table certificates_view`. Tras migrar `va`, si el servicio de CA corre con un usuario distinto, concédele `USAGE` sobre el esquema `va` y `SELECT` sobre `va.crl_settings` (`GRANT USAGE ON SCHEMA va TO service_user; GRANT SELECT ON va.crl_settings TO service_user`): el servicio de CA lee `va.crl_settings` cuando elimina una CA, y sin estos permisos toda eliminación de una CA que tenga motor criptográfico falla con `permission denied for schema va` (o `for table crl_settings`).",{"_3697":75714,"_31245":75445,"_21577":129546,"_5":14884,"_28435":128913,"_3074":129547},[],"Para aplicar las migraciones a mano, `goose-lamassu` debe ejecutarse contra la base `pki` con `search_path=<esquema>` en la cadena de conexión. El binario solo valida `search_path`, no el nombre de la base de datos, así que comprueba `dbname=pki` antes de ejecutarlo, y repítelo para `kms`, `ca`, `va`, `devicemanager`, `dmsmanager` y `alerts`:",{"_3697":75715,"_31245":75445,"_21577":129549,"_5":14884,"_28435":128913,"_3074":129550},[],"Ejecuta `ca-to-kms-migration` primero con `--dry-run`, que informa sin escribir en el almacenamiento del KMS, y después de forma real:",{"_3697":75716,"_31245":75445,"_21577":129552,"_5":14884,"_28435":128913,"_3074":129553},[],"Apunta la configuración `storage` de la herramienta a la base `pki`, donde los datos de CA y del KMS viven ahora en los esquemas `ca` y `kms`. Las opciones de la herramienta se describen en `backend/cmd/ca-to-kms-migration/README.md`, en el repositorio `lamassuiot`.",{"_3697":75717,"_31245":75445,"_21577":129555,"_5":14884,"_28435":128913,"_3074":129556},[],"Los README de ambas herramientas documentan el formato de 4.0.0 con la base `pki` y coinciden con esta página: `goose-lamassu` usa ejemplos con `dbname=pki` y no valida el nombre de la base de datos, y el README de `ca-to-kms-migration` describe la base única `pki` y el orden de migración.",{"_3697":75718,"_31245":75445,"_21577":129558,"_5":14884,"_28435":128917,"_3074":129559},[],"**Los pods del KMS o la VA fallan con `no such file or directory` o `code=NotFound` justo después de actualizar.** Los pods están enlazados a los PVC nuevos y vacíos y la migración de datos aún no se ha hecho, o se copió en el PVC equivocado. Sigue el paso 4 y comprueba que existen las cuatro PVC.",{"_3697":75719,"_31245":75445,"_21577":129561,"_5":14884,"_28435":128917,"_3074":129562},[],"**`helm upgrade --wait` agota el tiempo y `helm status` muestra la release como `failed`.** Con almacenamiento local en el KMS o la VA es lo esperado en la primera ejecución: los nuevos pods no pueden estar listos hasta que se copien sus datos. Los hooks se ejecutaron y los manifiestos y PVC se aplicaron, así que completa el paso 4 y vuelve a lanzar el mismo comando `helm upgrade`. Si otros pods tampoco están listos, revisa sus logs, porque falla algo más.",{"_3697":75720,"_31245":75445,"_21577":129564,"_5":14884,"_28435":128917,"_3074":129565},[],"**El pod auxiliar se queda en `Pending` o `ContainerCreating` y `kubectl wait` agota el tiempo.** Otro pod sigue reteniendo alguna de las PVC; en almacenamiento de bloque, `kubectl describe pod pvc-migrate-helper` muestra un `Multi-Attach error`. Comprueba con `kubectl get pods -n $NAMESPACE` que `kms-0`, `va-0` y los nuevos pods del KMS y la VA han desaparecido, y vuelve a ejecutar el wait.",{"_3697":75721,"_31245":75445,"_21577":129567,"_5":14884,"_28435":128917,"_3074":129568},[],"**`helm upgrade` falla con un error de validación por clave desconocida.** Elimina o renombra los values heredados —normalmente `toolbox`, `auth.oidc.apiGateway` o `auth.authorization`—, porque el schema estricto rechaza las claves que no conoce.",{"_3697":75722,"_31245":75445,"_21577":129570,"_5":14884,"_28435":128917,"_3074":129571},[],"**La actualización falla en el job de base de datos.** El rol de PostgreSQL no puede crear bases de datos o esquemas, o una migración de esquema abortó: por IDs de CA duplicados o por valores de `engine_id` vacíos, o en el esquema de la VA por un ID de CA que contiene `/`, un SKI compartido por más de una CA (el error pide recrear todas menos una con otra clave), un rol cuyo certificado firmante no tiene clave, un ID de CA reservado para los ajustes archivados de otro rol, o un ID de CA igual al SKI de otro rol. El mensaje de aborto nombra los objetos conflictivos; corrígelos y vuelve a ejecutar la actualización.",{"_3697":75723,"_31245":75445,"_21577":129573,"_5":14884,"_28435":128917,"_3074":129574},[],"**La actualización falla en el hook de CA a KMS.** Hay certificados de CA que comparten un `subject_key_id` y declaran `engine_id` en conflicto. Resuelve el conflicto y vuelve a ejecutar.",{"_3697":75724,"_31245":75445,"_21577":129576,"_5":14884,"_28435":128917,"_3074":129577},[],"**Nadie puede iniciar sesión tras la actualización.** Comprueba que `services.authz.jwkUrl` es accesible desde el pod de `authz`, que `services.authz.bootstrap` coincide con un rol que tu proveedor OIDC asigna realmente y que el job de base de datos terminó.",{"_3697":75725,"_31245":75445,"_21577":129579,"_5":14884,"_28435":128917,"_3074":129580},[],"**Una migración aborta con `kms schema not found`.** Los esquemas deben migrarse en orden: ejecuta la migración del esquema `kms` antes que las migraciones de los esquemas `ca` y `va`.",{"_3697":75726,"_31245":75445,"_21577":129582,"_5":14884,"_28435":128917,"_3074":129583},[],"**Una migración aborta con `ca schema not found`.** Ejecuta la migración del esquema `ca` antes que la del esquema `va`.",{"_3697":75727,"_31245":75445,"_21577":129585,"_5":14884,"_28435":128917,"_3074":129586},[],"**La migración de VA falla con `cannot resolve signer certificate for VA role ... N candidates`.** La migración no puede identificar un certificado firmante de forma única a partir del SKI guardado en el rol. Revisa el SKI y los certificados candidatos indicados en el error; corrige los datos anteriores a la migración con una copia de seguridad verificada y vuelve a ejecutar la migración. El nuevo campo `signer_serial_number` se crea durante esa migración, por lo que no se puede configurar mediante la API de VA mientras esta falla.",{"_3697":75728,"_31245":75445,"_21577":129588,"_5":14884,"_28435":128917,"_3074":129589},[],"**Una migración o un servicio falla con `permission denied for table ...` o `permission denied for schema ...`.** Al rol de PostgreSQL le faltan los privilegios entre esquemas listados en Despliegues sin Helm; incluye `certificates_view` cuando se omitió el `GRANT SELECT` posterior a la migración, y `permission denied for schema va` (o `for table crl_settings`) al eliminar una CA sin los permisos de `va`. Concede los privilegios que falten y vuelve a ejecutar.",{"_3697":75729,"_31245":75445,"_21577":129591,"_5":14884,"_28435":128920,"_3074":129592},[],"Tras la actualización, comprueba en este orden:",{"_3697":75730,"_31245":75445,"_21577":129594,"_5":14884,"_28435":128920,"_3074":129595},[],"**Bases de datos.** Cada servicio lee la base `pki` con su propio esquema, los datos de `authz` y `wfx` son accesibles y el estado de las migraciones está registrado por esquema, incluidas las migraciones del ID único de CA y de la clave compuesta del KMS, y las migraciones de claves foráneas que se ejecutan por esquema en el orden obligatorio.",{"_3697":75731,"_31245":75445,"_21577":129597,"_5":14884,"_28435":128920,"_3074":129598},[],"**KMS y VA arrancan sin errores.** Sus logs no muestran errores `no such file or directory` ni `code=NotFound`.",{"_3697":75732,"_31245":75445,"_21577":129600,"_5":14884,"_28435":128920,"_3074":129601},[],"**Las claves existentes del KMS funcionan.** Emite un certificado desde una CA que ya existía antes de la actualización. Ninguna de las otras comprobaciones lee una clave del KMS, así que esta es la única que demuestra que el material de claves se ha copiado.",{"_3697":75733,"_31245":75445,"_21577":129603,"_5":14884,"_28435":128920,"_3074":129604},[],"**Las CRLs existentes se sirven.** `GET /crl/<ca-id>` sobre la VA devuelve una CRL emitida anteriormente, y `GET /crl/<ca-ski>` con el SKI heredado de un certificado emitido antes de la actualización también resuelve. El job de CRL de la VA ha emitido una lista nueva bajo el ID de CA con ambas URLs en su IDP; revisa sus logs si la regeneración aún no ha terminado correctamente.",{"_3697":75734,"_31245":75445,"_21577":129606,"_5":14884,"_28435":128920,"_3074":129607},[],"**Eventos de VA renombrados.** Las suscripciones de alertas a `va.role.update` y `va.role.crl.init` se suscriben ahora a `va.crl-settings.update` y `va.crl-settings.init`, y se han revisado las condiciones de todos los eventos de la VA, incluido `va.role.crl.create`, frente al payload nuevo (`ca_id` en lugar de `ca_ski`) y al subject nuevo (`crl/<ca-id>` en lugar de `crl/<ski>`). Los consumidores directos y las búsquedas de auditoría usan los nombres de evento nuevos.",{"_3697":75735,"_31245":75445,"_21577":129609,"_5":14884,"_28435":128920,"_3074":129610},[],"**Claves de CA heredadas.** Si se ejecutó la migración de CA a KMS, revisa su informe y sus avisos y confirma que las claves esperadas aparecen en el KMS. Los certificados de CA migrados informan ahora de `key_id` y `has_private_key`, que permiten confirmar el registro.",{"_3697":75736,"_31245":75445,"_21577":129612,"_5":14884,"_28435":128920,"_3074":129613},[],"**Conectividad.** `helm test \"$RELEASE\" -n $NAMESPACE --logs` pasa; el hook comprueba los endpoints de salud de CA, DMS Manager, Device Manager y VA, y la respuesta de la UI.",{"_3697":75737,"_31245":75445,"_21577":129615,"_5":14884,"_28435":128920,"_3074":129616},[],"**Autorización.** Inicia sesión con el principal de bootstrap y confirma que la administración funciona, comprueba que una identidad sin permisos recibe `403` y revisa los permisos de clientes e integraciones.",{"_3697":75738,"_31245":75445,"_21577":129618,"_5":14884,"_28435":128920,"_3074":129619},[],"**AMQP.** El backend se conecta al broker con la configuración TLS esperada. En AMQP las colas de suscriptores de SSE son auto-delete y desaparecen cuando su instancia se detiene; en proveedores de event bus sin soporte de suscriptores efímeros, comprueba que no se acumulen colas de SSE por proceso.",{"_3697":75739,"_31245":75445,"_21577":129621,"_5":14884,"_28435":128920,"_3074":129622},[],"**Eventos de dispositivo.** `GET /v1/devices/:id/events` devuelve los eventos históricos de un dispositivo que los tenía.",{"_3697":75740,"_31245":75445,"_21577":129624,"_5":14884,"_28435":128920,"_3074":129625},[],"**Webhooks sin campos de archivo.** En cada DMS que usa webhook en enrolamiento o reenrolamiento, el bloque `config` incluye `insecure_skip_verify` y el bloque de opciones esperado (`apikey_options`, `jwt_options` o `mtls_options`), con el certificado y la clave en PEM y sin `cert_file` ni `key_file`.",{"_3697":75741,"_31245":75445,"_21577":129627,"_5":14884,"_28435":128920,"_3074":129628},[],"**Verificación del receptor.** `insecure_skip_verify` es `false`, salvo que el certificado del receptor no sea verificable de forma intencionada.",{"_3697":75742,"_31245":75445,"_21577":129630,"_5":14884,"_28435":128920,"_3074":129631},[],"**Entrega de webhooks.** Un enrolamiento o reenrolamiento a través de cada webhook migrado completa su llamada de autorización.",{"_3697":75743,"_31245":75445,"_21577":129633,"_5":14884,"_28435":128920,"_3074":129634},[],"**Conjunto de confianza.** `est_rfc7030_settings.client_certificate_settings.validation_cas` contiene las CAs esperadas, en particular las de la CA antigua durante los solapamientos de rotación.",{"_3697":75744,"_31245":75445,"_21577":129636,"_5":14884,"_28435":128920,"_3074":129637},[],"**Clientes de la API.** Los scripts y consolas ya no usan el formato antiguo del DMS (`additional_validation_cas` plano, o los campos heredados `mtls`, `apikey` y `oidc`), envían las actualizaciones del DMS con el ID en la URL y comparan con los nuevos valores de `type` del certificado.",{"_3697":75745,"_31245":75445,"_21577":129639,"_5":14884,"_28435":128924,"_3074":129640},[],"Solo cuando pasen todas las comprobaciones, elimina los volúmenes huérfanos de 3.8.0 para recuperar almacenamiento. El borrado es irreversible y el volumen antiguo del KMS puede contener la última copia del material de claves de tus CA, así que antes haz un `VolumeSnapshot` o una copia de seguridad de ambos PVC antiguos y consérvala hasta que confíes en que el despliegue actualizado funciona correctamente. Son los nombres fijos de 3.8.0 que anotaste en el paso 1; antes de borrarlos, confirma que ningún pod en marcha los monta, por ejemplo con `kubectl describe pvc -n $NAMESPACE golang-engine-storage-kms-0 local-crl-file-storage-va-0`, donde `Used By` debe ser `<none>`:",{"_3697":75746,"_31245":75445,"_21577":129642,"_5":14884,"_28435":128924,"_3074":129643},[],"Las bases de datos por servicio de 3.8.0 tampoco se usan ya. Elimínalas solo cuando pasen las mismas comprobaciones y tengas verificada la copia de seguridad de PostgreSQL.",{"_3697":75747,"_31245":75445,"_21577":129645,"_5":14884,"_28435":128924,"_3074":129646},[],"<Card title=\"Instalar con Helm\" description=\"Prepara las dependencias, configura los values e instala un despliegue controlado.\" href=\"/docs/deployment/self-hosted/helm\" />",{"_3697":75748,"_31245":75445,"_21577":129648,"_5":14884,"_28435":128924,"_3074":129649},[],"<Card title=\"Control de acceso\" description=\"Principales, políticas y el primer administrador.\" href=\"/docs/platform/administration/access-control\" />",{"_3697":75749,"_31245":75445,"_21577":129651,"_5":14884,"_28435":128924,"_3074":129652},[],"<Card title=\"Configurar un DMS\" description=\"Ajustes de enrolamiento, reenrolamiento y webhooks.\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_60448":129654,"_60450":129655,"_60452":129656,"_60454":129657,"_18746":3109,"_72689":3109},"spanish",[3074,31245,5,28435],{"_3074":25773,"_31245":25773,"_5":25773,"_28435":25773},{"_3074":129658,"_31245":132715,"_5":135772,"_28435":138829},{"_4847":129659,"_60458":129660,"_5":25773},{"_14965":4358,"_15332":5880,"_15351":8370,"_30250":3163,"_15338":7801,"_20500":5675,"_14986":17768,"_14993":3918,"_30187":15438,"_30600":6414,"_30632":7982,"_30226":3997,"_35600":5455,"_30329":20978,"_30676":16464,"_35607":3753,"_35610":6954,"_35613":11631,"_35616":7253,"_31068":10968,"_35621":24945,"_35623":6906,"_31103":3417,"_15347":5129,"_35627":7842,"_35630":6760,"_35632":8496,"_30671":3501,"_31088":7991,"_31116":18507,"_35637":5917,"_35639":17242,"_35641":7308,"_30340":3186,"_35644":8768,"_35646":4593,"_35648":13385,"_35650":5182,"_35652":25557,"_30263":3669,"_35655":3440,"_35657":4561,"_30257":3584,"_30708":7227,"_35661":11493,"_35663":6205,"_35666":4986,"_30303":17360,"_35670":5208,"_30178":4925,"_35673":6276,"_30231":6267,"_35676":20982,"_35678":5278,"_35681":12441,"_15341":9427,"_35684":4697,"_35686":8515,"_35689":7303,"_35691":7257,"_35693":6765,"_35695":5175,"_35697":21722,"_20503":4819,"_35700":6921,"_35702":4587,"_30204":17577,"_30665":3571,"_35706":4115,"_35708":6070,"_35710":5537,"_31132":14841,"_35713":6759,"_35715":5165,"_35717":6077,"_31225":5361,"_30724":18748,"_35721":6608,"_35723":3397,"_30241":5172,"_35726":4700,"