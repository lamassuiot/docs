46852,"_32653":46855,"_32655":46858,"_32657":46861,"_32659":46864,"_32661":46868,"_32663":46871,"_32665":46874,"_32667":46878,"_32669":46881,"_32671":46885,"_32673":46888,"_32675":46891,"_32677":46894,"_32679":46897,"_32681":46900,"_32683":46903,"_32685":46906,"_32687":46909,"_32689":46912,"_32691":46915,"_32693":46918,"_32695":46920,"_32697":46923,"_32699":46926,"_32701":46929,"_32703":46932,"_32705":46935,"_32707":46938,"_32709":46941,"_32711":46944,"_32713":46947,"_32715":46950,"_32717":46954,"_32719":46957,"_32721":46961,"_32723":46965,"_32725":46969,"_32727":46972,"_32729":46975,"_32731":46977,"_32733":46980,"_32735":46982,"_32737":46985,"_32739":46988,"_32741":46991,"_32743":46994,"_32745":46997,"_32747":47000,"_32749":47003,"_32751":47006,"_32753":47009,"_32755":47012,"_32757":47015,"_32759":47018,"_32761":47020,"_32763":47023,"_32765":47026,"_32767":47029,"_32769":47032,"_32771":47035,"_32773":47038,"_32775":47041,"_32777":47044,"_32779":47047,"_32781":47050,"_32783":47053,"_32785":47056},{"_2802":15,"_24443":15,"_5":12033,"_2329":39788,"_24758":39789,"_17120":39793,"_23194":15},"Deploy from AWS Marketplace",[39790,39791,39792],"Docs","Deployment","Other models",[],{"_2802":16,"_24443":15,"_17120":39795,"_5":17015,"_23194":15,"_2329":39796},[],"Run a preconfigured Lamassu IoT instance on Amazon EC2.",{"_2802":17,"_24443":15,"_5":24755,"_17120":39798,"_23194":39799,"_2329":39800},[],"/docs/deployment/aws-marketplace#before-you-begin","Before you begin",{"_2802":18,"_24443":15,"_5":24755,"_17120":39802,"_23194":39803,"_2329":39804},[],"/docs/deployment/aws-marketplace#infrastructure-requirements","Infrastructure requirements",{"_2802":19,"_24443":15,"_5":24755,"_17120":39806,"_23194":39807,"_2329":39808},[],"/docs/deployment/aws-marketplace#open-the-offer","Open the offer",{"_2802":20,"_24443":15,"_5":24755,"_17120":39810,"_23194":39811,"_2329":39812},[],"/docs/deployment/aws-marketplace#configure-the-instance","Configure the instance",{"_2802":21,"_24443":15,"_5":24755,"_17120":39814,"_23194":39815,"_2329":39816},[],"/docs/deployment/aws-marketplace#limit-network-access","Limit network access",{"_2802":22,"_24443":15,"_5":24755,"_17120":39818,"_23194":39819,"_2329":39820},[],"/docs/deployment/aws-marketplace#launch-and-verify","Launch and verify",{"_2802":23,"_24443":15,"_5":24755,"_17120":39822,"_23194":39823,"_2329":39824},[],"/docs/deployment/aws-marketplace#next-step","Next step",{"_2802":24,"_24443":15,"_17120":39826,"_5":17015,"_23194":15,"_2329":39827},[],"The AWS Marketplace offering reduces initial setup to an EC2 instance inside your account. You keep control of the network, storage and operation of the machine.",{"_2802":25,"_24443":15,"_17120":39829,"_5":17015,"_23194":39799,"_2329":39830},[],"Permissions to subscribe to AWS Marketplace products and launch EC2 instances.",{"_2802":26,"_24443":15,"_17120":39832,"_5":17015,"_23194":39799,"_2329":39833},[],"A VPC and a subnet from which administrators and devices can reach the instance.",{"_2802":27,"_24443":15,"_17120":39835,"_5":17015,"_23194":39799,"_2329":39836},[],"A security group allowing the necessary endpoints.",{"_2802":28,"_24443":15,"_17120":39838,"_5":17015,"_23194":39803,"_2329":39839},[],"**Compute:** a `t3.large` instance at minimum. Use `t3.xlarge` or higher when the load requires it.",{"_2802":29,"_24443":15,"_17120":39841,"_5":17015,"_23194":39803,"_2329":39842},[],"**Storage:** an EBS `gp3` volume of at least 50 GB, sized to your inventory and retention needs.",{"_2802":30,"_24443":15,"_17120":39844,"_5":17015,"_23194":39803,"_2329":39845},[],"**Network:** HTTPS access from the necessary consumers, restricted to trusted networks.",{"_2802":31,"_24443":15,"_17120":39847,"_5":17015,"_23194":39807,"_2329":39848},[],"Go to Lamassu IoT on AWS Marketplace and review the terms before subscribing.",{"_2802":32,"_24443":15,"_17120":39850,"_5":17015,"_23194":39811,"_2329":39851},[],"Select `t3.large` or higher, assign at least 50 GB of `gp3` storage and choose the target VPC and subnet.",{"_2802":33,"_24443":15,"_17120":39853,"_5":17015,"_23194":39815,"_2329":39854},[],"Configure the security group for ports `443`, `8443` and `9443`. Restrict the origins to the administrative and device networks that really need to connect.",{"_2802":34,"_24443":15,"_17120":39856,"_5":17015,"_23194":39819,"_2329":39857},[],"Start the instance and open the console at `https://<public-ip>`. Check you can authenticate before continuing.",{"_2802":35,"_24443":15,"_17120":39859,"_5":17015,"_23194":39823,"_2329":39860},[],"Continue with Create your first CA to validate the instance's cryptographic configuration.",{"_2802":36,"_24443":36,"_5":12033,"_2329":39862,"_24758":39863,"_17120":39864,"_23194":36},"Deploy Lamassu",[39790,39791],[],{"_2802":37,"_24443":36,"_17120":39866,"_5":17015,"_23194":36,"_2329":39867},[],"Choose the operating model that fits your infrastructure and control requirements.",{"_2802":38,"_24443":36,"_5":24755,"_17120":39869,"_23194":39870,"_2329":39871},[],"/docs/deployment/overview#choose-a-model","Choose a model",{"_2802":39,"_24443":36,"_5":24755,"_17120":39873,"_23194":39874,"_2329":39875},[],"/docs/deployment/overview#just-want-to-evaluate-the-platform","Just want to evaluate the platform?",{"_2802":40,"_24443":36,"_5":24755,"_17120":39877,"_23194":39878,"_2329":39879},[],"/docs/deployment/overview#after-deployment","After deployment",{"_2802":41,"_24443":36,"_17120":39881,"_5":17015,"_23194":36,"_2329":39882},[],"You can run Lamassu on your own Kubernetes cluster, deploy a prebuilt image from AWS Marketplace or consume the platform as a managed service.",{"_2802":42,"_24443":36,"_17120":39884,"_5":17015,"_23194":39870,"_2329":39885},[],"Model",{"_2802":43,"_24443":36,"_17120":39887,"_5":17015,"_23194":39870,"_2329":39888},[],"Recommended for",{"_2802":44,"_24443":36,"_17120":39890,"_5":17015,"_23194":39870,"_2329":39891},[],"Who operates the infrastructure",{"_2802":45,"_24443":36,"_17120":39893,"_5":17015,"_23194":39870,"_2329":39894},[],"Starting point",{"_2802":46,"_24443":36,"_17120":39896,"_5":17015,"_23194":39870,"_2329":39897},[],"Kubernetes self-managed",{"_2802":47,"_24443":36,"_17120":39899,"_5":17015,"_23194":39870,"_2329":39900},[],"Production, regulated environments and custom deployments",{"_2802":48,"_24443":36,"_17120":39902,"_5":17015,"_23194":39870,"_2329":39903},[],"Your team",{"_2802":49,"_24443":36,"_17120":39905,"_5":17015,"_23194":39870,"_2329":39906},[],"Helm or Fastlane",{"_2802":50,"_24443":36,"_17120":39908,"_5":17015,"_23194":39870,"_2329":39909},[],"AWS Marketplace",{"_2802":51,"_24443":36,"_17120":39911,"_5":17015,"_23194":39870,"_2329":39912},[],"Evaluation or a dedicated deployment inside an AWS account",{"_2802":52,"_24443":36,"_17120":39914,"_5":17015,"_23194":39870,"_2329":39903},[],{"_2802":53,"_24443":36,"_17120":39916,"_5":17015,"_23194":39870,"_2329":39917},[],"Preconfigured image on EC2",{"_2802":54,"_24443":36,"_17120":39919,"_5":17015,"_23194":39870,"_2329":39920},[],"SaaS",{"_2802":55,"_24443":36,"_17120":39922,"_5":17015,"_23194":39870,"_2329":39923},[],"Teams that want to use the platform without operating it",{"_2802":56,"_24443":36,"_17120":39925,"_5":17015,"_23194":39870,"_2329":39926},[],"Lamassu",{"_2802":57,"_24443":36,"_17120":39928,"_5":17015,"_23194":39870,"_2329":39929},[],"Managed subscription",{"_2802":58,"_24443":36,"_17120":39931,"_5":17015,"_23194":39870,"_2329":39932},[],"<Card title=\"Kubernetes self-managed\" description=\"Control network, storage, keys, dependencies and the upgrade cycle.\" href=\"/docs/deployment/self-hosted/overview\" />",{"_2802":59,"_24443":36,"_17120":39934,"_5":17015,"_23194":39870,"_2329":39935},[],"<Card title=\"AWS Marketplace\" description=\"Launch a preconfigured Lamassu instance on AWS EC2.\" href=\"/docs/deployment/aws-marketplace\" />",{"_2802":60,"_24443":36,"_17120":39937,"_5":17015,"_23194":39870,"_2329":39938},[],"<Card title=\"Lamassu SaaS\" description=\"Use an operated and updated instance as a managed service.\" href=\"/docs/deployment/saas\" />",{"_2802":61,"_24443":36,"_17120":39940,"_5":17015,"_23194":39874,"_2329":39941},[],"Use Fastlane to bring up PostgreSQL, Keycloak, RabbitMQ and Lamassu on a Kubernetes cluster through a single flow. It is intended for labs, demos and bootstrap; for production, configure dependencies and Helm values explicitly.",{"_2802":62,"_24443":36,"_17120":39943,"_5":17015,"_23194":39878,"_2329":39944},[],"Once the console is available, continue with Create your first CA. That quickstart verifies the cryptographic engine and issuance work correctly.",{"_2802":63,"_24443":63,"_5":12033,"_2329":39946,"_24758":39947,"_17120":39948,"_23194":63},"Use Lamassu as SaaS",[39790,39791,39792],[],{"_2802":64,"_24443":63,"_17120":39950,"_5":17015,"_23194":63,"_2329":39951},[],"Consume Lamassu as a managed service without operating your own infrastructure.",{"_2802":65,"_24443":63,"_5":24755,"_17120":39953,"_23194":39954,"_2329":39955},[],"/docs/deployment/saas#what-the-service-manages","What the service manages",{"_2802":66,"_24443":63,"_5":24755,"_17120":39957,"_23194":39958,"_2329":39959},[],"/docs/deployment/saas#plans","Plans",{"_2802":67,"_24443":63,"_5":24755,"_17120":39961,"_23194":39962,"_2329":39963},[],"/docs/deployment/saas#request-access","Request access",{"_2802":68,"_24443":63,"_17120":39965,"_5":17015,"_23194":63,"_2329":39966},[],"Lamassu SaaS offers the platform's capabilities in a managed environment. It is the right option when your team wants to focus on PKI and device identities, not on maintaining the infrastructure that supports them.",{"_2802":69,"_24443":63,"_17120":39968,"_5":17015,"_23194":39954,"_2329":39969},[],"Platform availability and maintenance.",{"_2802":70,"_24443":63,"_17120":39971,"_5":17015,"_23194":39954,"_2329":39972},[],"Automatic backups.",{"_2802":71,"_24443":63,"_17120":39974,"_5":17015,"_23194":39954,"_2329":39975},[],"Version upgrades.",{"_2802":72,"_24443":63,"_17120":39977,"_5":17015,"_23194":39954,"_2329":39978},[],"Technical support and SLA according to your plan.",{"_2802":73,"_24443":63,"_17120":39980,"_5":17015,"_23194":39958,"_2329":39981},[],"Plan",{"_2802":74,"_24443":63,"_17120":39983,"_5":17015,"_23194":39958,"_2329":39984},[],"Devices",{"_2802":75,"_24443":63,"_17120":39986,"_5":17015,"_23194":39958,"_2329":39987},[],"Support",{"_2802":76,"_24443":63,"_17120":39989,"_5":17015,"_23194":39958,"_2329":39990},[],"SLA",{"_2802":77,"_24443":63,"_17120":39992,"_5":17015,"_23194":39958,"_2329":39993},[],"Starter",{"_2802":78,"_24443":63,"_17120":39995,"_5":17015,"_23194":39958,"_2329":39996},[],"Up to 1,000",{"_2802":79,"_24443":63,"_17120":39998,"_5":17015,"_23194":39958,"_2329":39999},[],"Email",{"_2802":80,"_24443":63,"_17120":40001,"_5":17015,"_23194":39958,"_2329":40002},[],"99.5 %",{"_2802":81,"_24443":63,"_17120":40004,"_5":17015,"_23194":39958,"_2329":40005},[],"Professional",{"_2802":82,"_24443":63,"_17120":40007,"_5":17015,"_23194":39958,"_2329":40008},[],"Up to 10,000",{"_2802":83,"_24443":63,"_17120":40010,"_5":17015,"_23194":39958,"_2329":40011},[],"Email and chat",{"_2802":84,"_24443":63,"_17120":40013,"_5":17015,"_23194":39958,"_2329":40014},[],"99.9 %",{"_2802":85,"_24443":63,"_17120":40016,"_5":17015,"_23194":39958,"_2329":40017},[],"Enterprise",{"_2802":86,"_24443":63,"_17120":40019,"_5":17015,"_23194":39958,"_2329":40020},[],"Unlimited",{"_2802":87,"_24443":63,"_17120":40022,"_5":17015,"_23194":39958,"_2329":40023},[],"Dedicated",{"_2802":88,"_24443":63,"_17120":40025,"_5":17015,"_23194":39958,"_2329":40026},[],"99.99 %",{"_2802":89,"_24443":63,"_17120":40028,"_5":17015,"_23194":39962,"_2329":40029},[],"Contact the Lamassu team through lamassu.io to request a demo or choose a plan.",{"_2802":90,"_24443":63,"_17120":40031,"_5":17015,"_23194":39962,"_2329":40032},[],"When you receive your instance's credentials, continue with Get started.",{"_2802":91,"_24443":91,"_5":12033,"_2329":40034,"_24758":40035,"_17120":40036,"_23194":91},"Fastlane",[39790,39791,39897],[],{"_2802":92,"_24443":91,"_17120":40038,"_5":17015,"_23194":91,"_2329":40039},[],"Bootstrap a complete Lamassu evaluation or lab environment on an existing Kubernetes cluster.",{"_2802":93,"_24443":91,"_5":24755,"_17120":40041,"_23194":40042,"_2329":40043},[],"/docs/deployment/self-hosted/fastlane#deploy-with-fastlane","Deploy with Fastlane",{"_2802":94,"_24443":91,"_5":24755,"_17120":40045,"_23194":40046,"_2329":40047},[],"/docs/deployment/self-hosted/fastlane#what-fastlane-adds","What Fastlane adds",{"_2802":95,"_24443":91,"_5":24755,"_17120":40049,"_23194":40050,"_2329":39800},[],"/docs/deployment/self-hosted/fastlane#before-you-begin",{"_2802":96,"_24443":91,"_5":24755,"_17120":40052,"_23194":40053,"_2329":40054},[],"/docs/deployment/self-hosted/fastlane#quick-start","Quick start",{"_2802":97,"_24443":91,"_5":24755,"_17120":40056,"_23194":40057,"_2329":40058},[],"/docs/deployment/self-hosted/fastlane#gateway-address-selection","Gateway address selection",{"_2802":98,"_24443":91,"_5":24755,"_17120":40060,"_23194":40061,"_2329":40062},[],"/docs/deployment/self-hosted/fastlane#command-line-options","Command-line options",{"_2802":99,"_24443":91,"_5":24755,"_17120":40064,"_23194":40065,"_2329":40066},[],"/docs/deployment/self-hosted/fastlane#what-the-script-configures","What the script configures",{"_2802":100,"_24443":91,"_5":24755,"_17120":40068,"_23194":40069,"_2329":40070},[],"/docs/deployment/self-hosted/fastlane#tls-behavior","TLS behavior",{"_2802":101,"_24443":91,"_5":24755,"_17120":40072,"_23194":40073,"_2329":40074},[],"/docs/deployment/self-hosted/fastlane#credentials-and-generated-files","Credentials and generated files",{"_2802":102,"_24443":91,"_5":24755,"_17120":40076,"_23194":40077,"_2329":40078},[],"/docs/deployment/self-hosted/fastlane#verify-the-installation","Verify the installation",{"_2802":103,"_24443":91,"_17120":40080,"_5":17015,"_23194":40042,"_2329":40081},[],"Fastlane is the automated path for evaluations, demos, CI and small lab clusters. It installs PostgreSQL, Keycloak, RabbitMQ, Envoy Gateway and Lamassu, then configures them to work together.",{"_2802":104,"_24443":91,"_17120":40083,"_5":17015,"_23194":40042,"_2329":40084},[],"For production, use Helm so database, identity, credentials, certificates, storage and upgrades remain explicit.",{"_2802":105,"_24443":91,"_17120":40086,"_5":17015,"_23194":40046,"_2329":40087},[],"Fastlane closes some of the gaps intentionally left by the application chart:",{"_2802":106,"_24443":91,"_17120":40089,"_5":17015,"_23194":40046,"_2329":40090},[],"Fastlane installs or configures",{"_2802":107,"_24443":91,"_17120":40092,"_5":17015,"_23194":40046,"_2329":40093},[],"You still provide",{"_2802":108,"_24443":91,"_17120":40095,"_5":17015,"_23194":40046,"_2329":40096},[],"PostgreSQL, RabbitMQ and Keycloak instances for evaluation",{"_2802":109,"_24443":91,"_17120":40098,"_5":17015,"_23194":40046,"_2329":40099},[],"The Kubernetes cluster, nodes and persistent storage",{"_2802":110,"_24443":91,"_17120":40101,"_5":17015,"_23194":40046,"_2329":40102},[],"Envoy Gateway 1.8 and the `eg` `GatewayClass`",{"_2802":111,"_24443":91,"_17120":40104,"_5":17015,"_23194":40046,"_2329":40105},[],"cert-manager, external network reachability, DNS and firewall/NAT rules",{"_2802":112,"_24443":91,"_17120":40107,"_5":17015,"_23194":40046,"_2329":40108},[],"A self-signed Lamassu certificate flow, generated dependency credentials and an initial user",{"_2802":113,"_24443":91,"_17120":40110,"_5":17015,"_23194":40046,"_2329":40111},[],"Client trust for the self-signed CA, or a trusted certificate passed to the script",{"_2802":114,"_24443":91,"_17120":40113,"_5":17015,"_23194":40046,"_2329":40114},[],"Optional observability and lab HSM components",{"_2802":115,"_24443":91,"_17120":40116,"_5":17015,"_23194":40046,"_2329":40117},[],"Production monitoring retention, backups, HA and a production HSM/key service",{"_2802":116,"_24443":91,"_17120":40119,"_5":17015,"_23194":40046,"_2329":40120},[],"Fastlane does not turn the resulting stack into a production service: it does not create the cluster, public DNS, firewall rules, backups, high availability or a trusted public certificate.",{"_2802":117,"_24443":91,"_17120":40122,"_5":17015,"_23194":40050,"_2329":40123},[],"You need:",{"_2802":118,"_24443":91,"_17120":40125,"_5":17015,"_23194":40050,"_2329":40126},[],"an existing Kubernetes cluster",{"_2802":119,"_24443":91,"_17120":40128,"_5":17015,"_23194":40050,"_2329":40129},[],"`kubectl` and Helm, or the MicroK8s CLI",{"_2802":120,"_24443":91,"_17120":40131,"_5":17015,"_23194":40050,"_2329":40132},[],"`yq`",{"_2802":121,"_24443":91,"_17120":40134,"_5":17015,"_23194":40050,"_2329":19378},[],{"_2802":122,"_24443":91,"_17120":40136,"_5":17015,"_23194":40050,"_2329":40137},[],"`jq` only when using `--sample-data`",{"_2802":123,"_24443":91,"_17120":40139,"_5":17015,"_23194":40050,"_2329":40140},[],"free external ports 80 and 443 on a single-node K3s host",{"_2802":124,"_24443":91,"_17120":40142,"_5":17015,"_23194":40050,"_2329":40143},[],"Fastlane detects MicroK8s, K3s, kind or a standard kubeconfig. Use `--context` when the intended cluster is not the current context.",{"_2802":125,"_24443":91,"_17120":40145,"_5":17015,"_23194":40050,"_2329":40146},[],"Fastlane installs several components and creates credentials. Check `kubectl config current-context` or pass `--context` before running it.",{"_2802":126,"_24443":91,"_17120":40148,"_5":17015,"_23194":40053,"_2329":40149},[],"Run the script from a clone of the Helm repository:",{"_2802":127,"_24443":91,"_17120":40151,"_5":17015,"_23194":40053,"_2329":40152},[],"Create a DNS record for the chosen domain before testing from another machine. For a small VM, point it at the VM or load-balancer address that actually receives ports 80 and 443.",{"_2802":128,"_24443":91,"_17120":40154,"_5":17015,"_23194":40057,"_2329":40155},[],"By default, Fastlane runs `hostname -I` and writes the returned addresses to `gateway.addresses` and to the self-signed certificate's IP SANs.",{"_2802":129,"_24443":91,"_17120":40157,"_5":17015,"_23194":40057,"_2329":40158},[],"On a single-homed lab VM this can select the expected node address. On hosts with Docker, VPN, WireGuard or several interfaces it can also select addresses clients cannot reach. Override the result explicitly:",{"_2802":130,"_24443":91,"_17120":40160,"_5":17015,"_23194":40057,"_2329":40161},[],"The value must be an address handled on the Kubernetes side of the traffic path. If a public EC2 address forwards through WireGuard to the cluster, pass the reachable cluster/VM address, not the EC2 public address.",{"_2802":131,"_24443":91,"_17120":40163,"_5":17015,"_23194":40057,"_2329":40164},[],"See Expose the Gateway for K3s port conflicts, VIPs, external NAT and multi-Gateway designs.",{"_2802":132,"_24443":91,"_17120":40166,"_5":17015,"_23194":40061,"_2329":40167},[],"Option",{"_2802":133,"_24443":91,"_17120":40169,"_5":17015,"_23194":40061,"_2329":40170},[],"Default",{"_2802":134,"_24443":91,"_17120":40172,"_5":17015,"_23194":40061,"_2329":40173},[],"Purpose",{"_2802":135,"_24443":91,"_17120":40175,"_5":17015,"_23194":40061,"_2329":40176},[],"`-h`, `--help`",{"_2802":136,"_24443":91,"_17120":40178,"_5":17015,"_23194":40061,"_2329":40179},[],"—",{"_2802":137,"_24443":91,"_17120":40181,"_5":17015,"_23194":40061,"_2329":40182},[],"Show help",{"_2802":138,"_24443":91,"_17120":40184,"_5":17015,"_23194":40061,"_2329":40185},[],"`-c`, `--context`",{"_2802":139,"_24443":91,"_17120":40187,"_5":17015,"_23194":40061,"_2329":40188},[],"current context",{"_2802":140,"_24443":91,"_17120":40190,"_5":17015,"_23194":40061,"_2329":40191},[],"Select the kubeconfig context for kubectl and Helm",{"_2802":141,"_24443":91,"_17120":40193,"_5":17015,"_23194":40061,"_2329":40194},[],"`-n`, `--non-interactive`",{"_2802":142,"_24443":91,"_17120":40196,"_5":17015,"_23194":40061,"_2329":5230},[],{"_2802":143,"_24443":91,"_17120":40198,"_5":17015,"_23194":40061,"_2329":40199},[],"Skip prompts and generate dependency credentials",{"_2802":144,"_24443":91,"_17120":40201,"_5":17015,"_23194":40061,"_2329":40202},[],"`-ns`, `--namespace`",{"_2802":145,"_24443":91,"_17120":40204,"_5":17015,"_23194":40061,"_2329":40205},[],"`lamassu-dev`",{"_2802":146,"_24443":91,"_17120":40207,"_5":17015,"_23194":40061,"_2329":40208},[],"Namespace for the installation",{"_2802":147,"_24443":91,"_17120":40210,"_5":17015,"_23194":40061,"_2329":40211},[],"`-d`, `--domain`",{"_2802":148,"_24443":91,"_17120":40213,"_5":17015,"_23194":40061,"_2329":40214},[],"`dev.lamassu.io`",{"_2802":149,"_24443":91,"_17120":40216,"_5":17015,"_23194":40061,"_2329":40217},[],"Domain used by the UI, OIDC and certificate",{"_2802":150,"_24443":91,"_17120":40219,"_5":17015,"_23194":40061,"_2329":40220},[],"`-v`, `--version`",{"_2802":151,"_24443":91,"_17120":40222,"_5":17015,"_23194":40061,"_2329":12253},[],{"_2802":152,"_24443":91,"_17120":40224,"_5":17015,"_23194":40061,"_2329":40225},[],"Lamassu chart version",{"_2802":153,"_24443":91,"_17120":40227,"_5":17015,"_23194":40061,"_2329":40228},[],"`--https-port`",{"_2802":154,"_24443":91,"_17120":40230,"_5":17015,"_23194":40061,"_2329":40231},[],"`443`",{"_2802":155,"_24443":91,"_17120":40233,"_5":17015,"_23194":40061,"_2329":40234},[],"Gateway HTTPS listener port",{"_2802":156,"_24443":91,"_17120":40236,"_5":17015,"_23194":40061,"_2329":40237},[],"`--http-port`",{"_2802":157,"_24443":91,"_17120":40239,"_5":17015,"_23194":40061,"_2329":40240},[],"`80`",{"_2802":158,"_24443":91,"_17120":40242,"_5":17015,"_23194":40061,"_2329":40243},[],"Gateway HTTP listener port",{"_2802":159,"_24443":91,"_17120":40245,"_5":17015,"_23194":40061,"_2329":40246},[],"`--tls-crt`",{"_2802":160,"_24443":91,"_17120":40248,"_5":17015,"_23194":40061,"_2329":40179},[],{"_2802":161,"_24443":91,"_17120":40250,"_5":17015,"_23194":40061,"_2329":40251},[],"PEM certificate for downstream TLS",{"_2802":162,"_24443":91,"_17120":40253,"_5":17015,"_23194":40061,"_2329":40254},[],"`--tls-key`",{"_2802":163,"_24443":91,"_17120":40256,"_5":17015,"_23194":40061,"_2329":40179},[],{"_2802":164,"_24443":91,"_17120":40258,"_5":17015,"_23194":40061,"_2329":40259},[],"PEM private key for downstream TLS",{"_2802":165,"_24443":91,"_17120":40261,"_5":17015,"_23194":40061,"_2329":40262},[],"`-l`, `--local-chart-path`",{"_2802":166,"_24443":91,"_17120":40264,"_5":17015,"_23194":40061,"_2329":40265},[],"repository chart",{"_2802":167,"_24443":91,"_17120":40267,"_5":17015,"_23194":40061,"_2329":40268},[],"Use an unpacked local Lamassu chart",{"_2802":168,"_24443":91,"_17120":40270,"_5":17015,"_23194":40061,"_2329":40271},[],"`-ip`, `--gateway-ip`",{"_2802":169,"_24443":91,"_17120":40273,"_5":17015,"_23194":40061,"_2329":7111},[],{"_2802":170,"_24443":91,"_17120":40275,"_5":17015,"_23194":40061,"_2329":40276},[],"Override the address written to `gateway.addresses`",{"_2802":171,"_24443":91,"_17120":40278,"_5":17015,"_23194":40061,"_2329":40279},[],"`--otel`",{"_2802":172,"_24443":91,"_17120":40281,"_5":17015,"_23194":40061,"_2329":5230},[],{"_2802":173,"_24443":91,"_17120":40283,"_5":17015,"_23194":40061,"_2329":40284},[],"Install Victoria Logs, VictoriaTraces, Jaeger and an OpenTelemetry Collector",{"_2802":174,"_24443":91,"_17120":40286,"_5":17015,"_23194":40061,"_2329":40287},[],"`--sample-data`",{"_2802":175,"_24443":91,"_17120":40289,"_5":17015,"_23194":40061,"_2329":5230},[],{"_2802":176,"_24443":91,"_17120":40291,"_5":17015,"_23194":40061,"_2329":40292},[],"Create sample CAs, profiles, certificates, DMS data and devices",{"_2802":177,"_24443":91,"_17120":40294,"_5":17015,"_23194":40061,"_2329":40295},[],"`--with-hsm`",{"_2802":178,"_24443":91,"_17120":40297,"_5":17015,"_23194":40061,"_2329":5230},[],{"_2802":179,"_24443":91,"_17120":40299,"_5":17015,"_23194":40061,"_2329":40300},[],"Install lab HSM components and configure KMS for PKCS#11",{"_2802":180,"_24443":91,"_17120":40302,"_5":17015,"_23194":40061,"_2329":40303},[],"`--softhsm-chart-path`",{"_2802":181,"_24443":91,"_17120":40305,"_5":17015,"_23194":40061,"_2329":40306},[],"`./charts/softhsm`",{"_2802":182,"_24443":91,"_17120":40308,"_5":17015,"_23194":40061,"_2329":40309},[],"Use a different local SoftHSM chart",{"_2802":183,"_24443":91,"_17120":40311,"_5":17015,"_23194":40061,"_2329":40312},[],"Fastlane does not provide an offline mode. Use the manual Helm workflow and a prepared registry/chart mirror for disconnected environments.",{"_2802":184,"_24443":91,"_17120":40314,"_5":17015,"_23194":40065,"_2329":40315},[],"Fastlane:",{"_2802":185,"_24443":91,"_17120":40317,"_5":17015,"_23194":40065,"_2329":40318},[],"validates local tools and the selected cluster",{"_2802":186,"_24443":91,"_17120":40320,"_5":17015,"_23194":40065,"_2329":40321},[],"installs or upgrades Envoy Gateway 1.8 and creates the `eg` `GatewayClass`",{"_2802":187,"_24443":91,"_17120":40323,"_5":17015,"_23194":40065,"_2329":40324},[],"creates the namespace",{"_2802":188,"_24443":91,"_17120":40326,"_5":17015,"_23194":40065,"_2329":40327},[],"installs PostgreSQL and creates the required databases",{"_2802":189,"_24443":91,"_17120":40329,"_5":17015,"_23194":40065,"_2329":40330},[],"installs Keycloak and creates the `lamassu` realm, frontend client, admin role and initial user",{"_2802":190,"_24443":91,"_17120":40332,"_5":17015,"_23194":40065,"_2329":40333},[],"installs RabbitMQ",{"_2802":191,"_24443":91,"_17120":40335,"_5":17015,"_23194":40065,"_2329":40336},[],"optionally installs observability and lab HSM components",{"_2802":192,"_24443":91,"_17120":40338,"_5":17015,"_23194":40065,"_2329":40339},[],"generates `lamassu.yaml` and installs the Lamassu chart",{"_2802":193,"_24443":91,"_17120":40341,"_5":17015,"_23194":40065,"_2329":40342},[],"optionally loads sample data",{"_2802":194,"_24443":91,"_17120":40344,"_5":17015,"_23194":40065,"_2329":40345},[],"The generated configuration exposes Keycloak at `/auth` through the same Gateway and bootstraps the initial `lamassu` user as a Lamassu super administrator.",{"_2802":195,"_24443":91,"_17120":40347,"_5":17015,"_23194":40069,"_2329":40348},[],"With both `--tls-crt` and `--tls-key`, Fastlane creates the `downstream-provided-crt` Secret and configures `tls.type: external`.",{"_2802":196,"_24443":91,"_17120":40350,"_5":17015,"_23194":40069,"_2329":40351},[],"Without them, it configures cert-manager with a self-signed issuer. This is suitable for a lab but will not be trusted by clients until you distribute the CA. Use Helm when you need a corporate Issuer, public ACME issuer or an existing Secret managed by another system.",{"_2802":197,"_24443":91,"_17120":40353,"_5":17015,"_23194":40073,"_2329":40354},[],"Non-interactive mode generates random PostgreSQL, RabbitMQ and Keycloak administrator passwords. The initial Lamassu login is `lamassu` / `lamassu` and requires a password change on first use.",{"_2802":198,"_24443":91,"_17120":40356,"_5":17015,"_23194":40073,"_2329":40357},[],"Fastlane writes `lamassu.yaml` in the current directory and injects credentials into it.",{"_2802":199,"_24443":91,"_17120":40359,"_5":17015,"_23194":40073,"_2329":40360},[],"Protect the generated values file, record the generated credentials in an appropriate secret store and do not reuse the evaluation identity setup in production.",{"_2802":200,"_24443":91,"_17120":40362,"_5":17015,"_23194":40077,"_2329":40363},[],"Then open `https://pki.example.com` and sign in with the initial user. If the Gateway is programmed but the URL is unreachable, follow the checks in Expose the Gateway.",{"_2802":201,"_24443":201,"_5":12033,"_2329":40365,"_24758":40366,"_17120":40367,"_23194":201},"Install with Helm",[39790,39791,39897],[],{"_2802":202,"_24443":201,"_17120":40369,"_5":17015,"_23194":201,"_2329":40370},[],"Prepare dependencies, configure the Lamassu chart and verify a controlled Kubernetes deployment.",{"_2802":203,"_24443":201,"_5":24755,"_17120":40372,"_23194":40373,"_2329":40374},[],"/docs/deployment/self-hosted/helm#install-lamassu-with-helm","Install Lamassu with Helm",{"_2802":204,"_24443":201,"_5":24755,"_17120":40376,"_23194":40377,"_2329":39800},[],"/docs/deployment/self-hosted/helm#before-you-begin",{"_2802":205,"_24443":201,"_5":24755,"_17120":40379,"_23194":40380,"_2329":40381},[],"/docs/deployment/self-hosted/helm#1-install-the-gateway-prerequisites","1\\. Install the Gateway prerequisites",{"_2802":206,"_24443":201,"_5":24755,"_17120":40383,"_23194":40384,"_2329":40385},[],"/docs/deployment/self-hosted/helm#2-create-a-values-file","2\\. Create a values file",{"_2802":207,"_24443":201,"_5":24755,"_17120":40387,"_23194":40388,"_2329":40389},[],"/docs/deployment/self-hosted/helm#tls-with-an-existing-secret","TLS with an existing Secret",{"_2802":208,"_24443":201,"_5":24755,"_17120":40391,"_23194":40392,"_2329":40393},[],"/docs/deployment/self-hosted/helm#provision-the-first-administrator","Provision the first administrator",{"_2802":209,"_24443":201,"_5":24755,"_17120":40395,"_23194":40396,"_2329":40397},[],"/docs/deployment/self-hosted/helm#3-install-lamassu","3\\. Install Lamassu",{"_2802":210,"_24443":201,"_5":24755,"_17120":40399,"_23194":40400,"_2329":40401},[],"/docs/deployment/self-hosted/helm#4-verify-the-deployment","4\\. Verify the deployment",{"_2802":211,"_24443":201,"_5":24755,"_17120":40403,"_23194":40404,"_2329":40405},[],"/docs/deployment/self-hosted/helm#production-decisions","Production decisions",{"_2802":212,"_24443":201,"_17120":40407,"_5":17015,"_23194":40373,"_2329":40408},[],"Use the Helm workflow when you need explicit control over identity, databases, messaging, certificates, storage and upgrades. For an evaluation environment where the script can make those choices for you, use Fastlane.",{"_2802":213,"_24443":201,"_17120":40410,"_5":17015,"_23194":40377,"_2329":40411},[],"Prepare the platform services that are deliberately outside the Lamassu chart:",{"_2802":214,"_24443":201,"_17120":40413,"_5":17015,"_23194":40377,"_2329":40414},[],"a Kubernetes 1.24+ cluster and Helm 3.2+",{"_2802":215,"_24443":201,"_17120":40416,"_5":17015,"_23194":40377,"_2329":40417},[],"a reachable PostgreSQL server and a role allowed to create databases and schemas",{"_2802":216,"_24443":201,"_17120":40419,"_5":17015,"_23194":40377,"_2329":40420},[],"a reachable RabbitMQ broker and credentials",{"_2802":217,"_24443":201,"_17120":40422,"_5":17015,"_23194":40377,"_2329":40423},[],"an OIDC provider, normally Keycloak, with a realm/tenant and client for Lamassu",{"_2802":218,"_24443":201,"_17120":40425,"_5":17015,"_23194":40377,"_2329":40426},[],"Envoy Gateway 1.8+ and a `GatewayClass`",{"_2802":219,"_24443":201,"_17120":40428,"_5":17015,"_23194":40377,"_2329":40429},[],"cert-manager 1.14+; for trusted TLS, either a trusted issuer or a Kubernetes TLS Secret",{"_2802":220,"_24443":201,"_17120":40431,"_5":17015,"_23194":40377,"_2329":40432},[],"a StorageClass and an external traffic design",{"_2802":221,"_24443":201,"_17120":40434,"_5":17015,"_23194":40377,"_2329":40435},[],"The chart defaults to a `GatewayClass` named `eg`. Change `gateway.className` if your platform team uses another name.",{"_2802":222,"_24443":201,"_17120":40437,"_5":17015,"_23194":40377,"_2329":40438},[],"You provide the PostgreSQL server. The chart's pre-install job connects with the supplied credentials, creates the required `pki`, `authz` and `wfx` databases and service schemas, runs migrations, and applies `services.authz.bootstrap`.",{"_2802":223,"_24443":201,"_17120":40440,"_5":17015,"_23194":40377,"_2329":40441},[],"The chart has no Helm dependencies that install PostgreSQL, RabbitMQ, an OIDC provider, Envoy Gateway or cert-manager.",{"_2802":224,"_24443":201,"_17120":40443,"_5":17015,"_23194":40380,"_2329":40444},[],"Install or upgrade the Envoy Gateway CRDs before its controller. The commands below match the version used by the Lamassu Helm repository:",{"_2802":225,"_24443":201,"_17120":40446,"_5":17015,"_23194":40380,"_2329":40447},[],"Create the default `GatewayClass` if it does not already exist. Save this manifest as `gateway-class.yaml`:",{"_2802":226,"_24443":201,"_17120":40449,"_5":17015,"_23194":40380,"_2329":40450},[],"Install cert-manager separately before Lamassu. The current chart renders its self-signed issuer and CA certificate resources even when `tls.type: external` makes the Gateway use an existing TLS Secret. Selecting external TLS therefore does not remove the cert-manager prerequisite.",{"_2802":227,"_24443":201,"_17120":40452,"_5":17015,"_23194":40384,"_2329":40453},[],"Start with the chart defaults and override the environment-specific values. This example assumes PostgreSQL, RabbitMQ and Keycloak are reachable through Kubernetes DNS, and exposes Keycloak at `/auth` through the shared Lamassu Gateway:",{"_2802":228,"_24443":201,"_17120":40455,"_5":17015,"_23194":40384,"_2329":40456},[],"Do not add `gateway.addresses` by default. Leave address assignment to the load-balancer implementation unless your network design requires a specific Kubernetes-side VIP. The public IP of an upstream NAT gateway or reverse proxy does not belong in this value.",{"_2802":229,"_24443":201,"_17120":40458,"_5":17015,"_23194":40384,"_2329":40459},[],"If Keycloak is external and already has its own reachable URL, point the OIDC settings at it and omit the `/auth` entry from `gateway.extraRouting`.",{"_2802":230,"_24443":201,"_17120":40461,"_5":17015,"_23194":40388,"_2329":40462},[],"Create a Secret containing `tls.crt` and `tls.key`, then reference it:",{"_2802":231,"_24443":201,"_17120":40464,"_5":17015,"_23194":40392,"_2329":40465},[],"There is no implicit superuser. Create the role or group expected by `services.authz.bootstrap` in the OIDC provider and assign it to at least one administrator before exposing Lamassu.",{"_2802":232,"_24443":201,"_17120":40467,"_5":17015,"_23194":40392,"_2329":40468},[],"The pre-install and pre-upgrade job applies the bootstrap idempotently: existing principals are preserved and missing grants are added.",{"_2802":233,"_24443":201,"_17120":40470,"_5":17015,"_23194":40392,"_2329":40471},[],"Test both an authorized identity and a denied identity. If no token matches an active bootstrap principal, nobody can administer the PKI.",{"_2802":234,"_24443":201,"_17120":40473,"_5":17015,"_23194":40392,"_2329":40474},[],"See Access control for the principal and policy model.",{"_2802":235,"_24443":201,"_17120":40476,"_5":17015,"_23194":40396,"_2329":40477},[],"To install a local checkout instead:",{"_2802":236,"_24443":201,"_17120":40479,"_5":17015,"_23194":40400,"_2329":40480},[],"The Gateway should report `PROGRAMMED=True`. If it is programmed but has no usable address, continue with Expose the Gateway.",{"_2802":237,"_24443":201,"_17120":40482,"_5":17015,"_23194":40400,"_2329":40483},[],"The Helm test checks the CA, DMS Manager, Device Manager and VA health endpoints and verifies the UI response.",{"_2802":238,"_24443":201,"_17120":40485,"_5":17015,"_23194":40404,"_2329":40486},[],"Before going live, review:",{"_2802":239,"_24443":201,"_17120":40488,"_5":17015,"_23194":40404,"_2329":40489},[],"backup and recovery for PostgreSQL and persistent volumes",{"_2802":240,"_24443":201,"_17120":40491,"_5":17015,"_23194":40404,"_2329":40492},[],"a production KMS engine; the default filesystem engine is not an HA design",{"_2802":241,"_24443":201,"_17120":40494,"_5":17015,"_23194":40404,"_2329":40495},[],"shared VA storage before increasing VA replicas",{"_2802":242,"_24443":201,"_17120":40497,"_5":17015,"_23194":40404,"_2329":40498},[],"managed OIDC roles and removal of evaluation credentials",{"_2802":243,"_24443":201,"_17120":40500,"_5":17015,"_23194":40404,"_2329":40501},[],"a trusted TLS issuer or externally managed certificate",{"_2802":244,"_24443":201,"_17120":40503,"_5":17015,"_23194":40404,"_2329":40504},[],"resource requests, replicas, autoscaling, disruption budgets and placement",{"_2802":245,"_24443":201,"_17120":40506,"_5":17015,"_23194":40404,"_2329":40507},[],"SMTP, observability and alert delivery",{"_2802":246,"_24443":201,"_17120":40509,"_5":17015,"_23194":40404,"_2329":40510},[],"the migration notes in `charts/lamassu/CHANGELOG/` before every upgrade",{"_2802":247,"_24443":201,"_17120":40512,"_5":17015,"_23194":40404,"_2329":40513},[],"The complete values reference is maintained in `charts/lamassu/VALUES.md` in the Helm repository.",{"_2802":248,"_24443":248,"_5":12033,"_2329":40515,"_24758":40516,"_17120":40517,"_23194":248},"Expose the Gateway",[39790,39791,39897],[],{"_2802":249,"_24443":248,"_17120":40519,"_5":17015,"_23194":248,"_2329":40520},[],"Choose how clients reach Lamassu, when to set gateway.addresses and how to design multiple Gateways.",{"_2802":250,"_24443":248,"_5":24755,"_17120":40522,"_23194":40523,"_2329":40524},[],"/docs/deployment/self-hosted/networking#expose-the-lamassu-gateway","Expose the Lamassu Gateway",{"_2802":251,"_24443":248,"_5":24755,"_17120":40526,"_23194":40527,"_2329":40528},[],"/docs/deployment/self-hosted/networking#do-you-need-gatewayaddresses","Do you need `gateway.addresses`?",{"_2802":252,"_24443":248,"_5":24755,"_17120":40530,"_23194":40531,"_2329":40532},[],"/docs/deployment/self-hosted/networking#recommended-single-node-design","Recommended single-node design",{"_2802":253,"_24443":248,"_5":24755,"_17120":40534,"_23194":40535,"_2329":40536},[],"/docs/deployment/self-hosted/networking#k3s","K3s",{"_2802":254,"_24443":248,"_5":24755,"_17120":40538,"_23194":40539,"_2329":40540},[],"/docs/deployment/self-hosted/networking#bare-metal-with-metallb-or-kube-vip","Bare metal with MetalLB or kube-vip",{"_2802":255,"_24443":248,"_5":24755,"_17120":40542,"_23194":40543,"_2329":40544},[],"/docs/deployment/self-hosted/networking#external-reverse-proxy-nat-or-vpn","External reverse proxy, NAT or VPN",{"_2802":256,"_24443":248,"_5":24755,"_17120":40546,"_23194":40547,"_2329":40548},[],"/docs/deployment/self-hosted/networking#what-if-you-need-three-gateways","What if you need three Gateways?",{"_2802":257,"_24443":248,"_5":24755,"_17120":40550,"_23194":40551,"_2329":40552},[],"/docs/deployment/self-hosted/networking#decision-guide","Decision guide",{"_2802":258,"_24443":248,"_5":24755,"_17120":40554,"_23194":40555,"_2329":40556},[],"/docs/deployment/self-hosted/networking#verify-the-traffic-path","Verify the traffic path",{"_2802":259,"_24443":248,"_17120":40558,"_5":17015,"_23194":40523,"_2329":40559},[],"The Lamassu chart creates one shared Gateway with HTTP and HTTPS listeners. Envoy Gateway normally creates a dedicated proxy deployment and a `LoadBalancer` Service for it.",{"_2802":260,"_24443":248,"_17120":40561,"_5":17015,"_23194":40523,"_2329":40562},[],"External reachability is the result of the whole path. A `Gateway` resource alone does not configure your router, firewall, DNS, cloud load balancer or upstream NAT.",{"_2802":261,"_24443":248,"_17120":40564,"_5":17015,"_23194":40527,"_2329":40565},[],"Usually, no. If you omit it, the Gateway controller and the cluster load-balancer implementation can assign an address and report it in `Gateway.status.addresses` and the generated Service status.",{"_2802":262,"_24443":248,"_17120":40567,"_5":17015,"_23194":40527,"_2329":40568},[],"Set it only when:",{"_2802":263,"_24443":248,"_17120":40570,"_5":17015,"_23194":40527,"_2329":40571},[],"your cloud or bare-metal load balancer supports requesting a specific address",{"_2802":264,"_24443":248,"_17120":40573,"_5":17015,"_23194":40527,"_2329":40574},[],"that address is allocated to this Gateway",{"_2802":265,"_24443":248,"_17120":40576,"_5":17015,"_23194":40527,"_2329":40577},[],"the surrounding network already routes traffic for it to the cluster",{"_2802":266,"_24443":248,"_17120":40579,"_5":17015,"_23194":40527,"_2329":40580},[],"This requests `192.168.1.50`; it does not claim the IP on your LAN or make it reachable.",{"_2802":267,"_24443":248,"_17120":40582,"_5":17015,"_23194":40527,"_2329":40583},[],"Keep these two settings separate:",{"_2802":268,"_24443":248,"_17120":40585,"_5":17015,"_23194":40527,"_2329":40586},[],"`gateway.addresses` requests an address for the Gateway.",{"_2802":269,"_24443":248,"_17120":40588,"_5":17015,"_23194":40527,"_2329":40589},[],"`tls.certManagerOptions.certSpec.addresses` adds IP subject alternative names to the TLS certificate.",{"_2802":270,"_24443":248,"_17120":40591,"_5":17015,"_23194":40527,"_2329":40592},[],"If users connect by DNS name, put that name in `tls.certManagerOptions.certSpec.hostnames`. Do not copy an upstream proxy's public IP into `gateway.addresses`.",{"_2802":271,"_24443":248,"_17120":40594,"_5":17015,"_23194":40531,"_2329":40595},[],"For a small VM running K3s or MicroK8s, use one external Lamassu Gateway and route every Lamassu endpoint through it:",{"_2802":272,"_24443":248,"_17120":40597,"_5":17015,"_23194":40531,"_2329":40598},[],"This design uses one IP, one TLS entry point and one pair of ports. The chart already creates the required routes.",{"_2802":273,"_24443":248,"_17120":40600,"_5":17015,"_23194":40535,"_2329":40601},[],"K3s ServiceLB implements each `LoadBalancer` Service with pods that reserve the Service ports on the node. On a single node, only one Service can therefore own port 80 and one can own port 443. The default K3s Traefik Service may already hold both ports.",{"_2802":274,"_24443":248,"_17120":40603,"_5":17015,"_23194":40535,"_2329":40604},[],"For the recommended design:",{"_2802":275,"_24443":248,"_17120":40606,"_5":17015,"_23194":40535,"_2329":40607},[],"Use only one externally exposed Lamassu Gateway.",{"_2802":276,"_24443":248,"_17120":40609,"_5":17015,"_23194":40535,"_2329":40610},[],"Ensure ports 80 and 443 are free. Disable or reconfigure Traefik if it is not part of your traffic path.",{"_2802":277,"_24443":248,"_17120":40612,"_5":17015,"_23194":40535,"_2329":40613},[],"Allow those ports through the VM firewall and any upstream security group.",{"_2802":278,"_24443":248,"_17120":40615,"_5":17015,"_23194":40535,"_2329":40616},[],"Point DNS at the VM's reachable address.",{"_2802":279,"_24443":248,"_17120":40618,"_5":17015,"_23194":40535,"_2329":40619},[],"See the K3s ServiceLB documentation for its host-port behavior and how to replace it with another load-balancer implementation.",{"_2802":280,"_24443":248,"_17120":40621,"_5":17015,"_23194":40539,"_2329":40622},[],"Allocate a VIP from an address pool reachable on your LAN. You may request that VIP with `gateway.addresses` if the selected implementation supports it. Confirm the assigned address in status rather than assuming the request succeeded.",{"_2802":281,"_24443":248,"_17120":40624,"_5":17015,"_23194":40543,"_2329":40625},[],"An external public address can forward TCP 80 and 443 to the VM or to a Kubernetes-side VIP:",{"_2802":282,"_24443":248,"_17120":40627,"_5":17015,"_23194":40543,"_2329":40628},[],"The public IP belongs to the external device. Leave `gateway.addresses` unset or set it to the actual Kubernetes-side address, never to an address that the cluster cannot bind.",{"_2802":283,"_24443":248,"_17120":40630,"_5":17015,"_23194":40547,"_2329":40631},[],"First decide whether you need three independent data planes or only three hostnames.",{"_2802":284,"_24443":248,"_17120":40633,"_5":17015,"_23194":40547,"_2329":40634},[],"Requirement",{"_2802":285,"_24443":248,"_17120":40636,"_5":17015,"_23194":40547,"_2329":40637},[],"Recommended design",{"_2802":286,"_24443":248,"_17120":40639,"_5":17015,"_23194":40547,"_2329":40640},[],"Consequence",{"_2802":287,"_24443":248,"_17120":40642,"_5":17015,"_23194":40547,"_2329":40643},[],"Several Lamassu URLs or services",{"_2802":288,"_24443":248,"_17120":40645,"_5":17015,"_23194":40547,"_2329":40646},[],"One Gateway with multiple routes",{"_2802":289,"_24443":248,"_17120":40648,"_5":17015,"_23194":40547,"_2329":40649},[],"One IP and one proxy fleet; this is the chart default",{"_2802":290,"_24443":248,"_17120":40651,"_5":17015,"_23194":40547,"_2329":40652},[],"Independent Gateways and separate external IPs",{"_2802":291,"_24443":248,"_17120":40654,"_5":17015,"_23194":40547,"_2329":40655},[],"One VIP per Gateway",{"_2802":292,"_24443":248,"_17120":40657,"_5":17015,"_23194":40547,"_2329":40658},[],"All Gateways can use 80/443; requires a load balancer with an address pool",{"_2802":293,"_24443":248,"_17120":40660,"_5":17015,"_23194":40547,"_2329":40661},[],"Independent Gateways on one node and one IP",{"_2802":294,"_24443":248,"_17120":40663,"_5":17015,"_23194":40547,"_2329":40664},[],"Use different external ports",{"_2802":295,"_24443":248,"_17120":40666,"_5":17015,"_23194":40547,"_2329":40667},[],"Clients must include non-standard ports",{"_2802":296,"_24443":248,"_17120":40669,"_5":17015,"_23194":40547,"_2329":40670},[],"Separate TLS/mTLS termination behind one IP",{"_2802":297,"_24443":248,"_17120":40672,"_5":17015,"_23194":40547,"_2329":40673},[],"Front-door SNI routing to internal Gateways",{"_2802":298,"_24443":248,"_17120":40675,"_5":17015,"_23194":40547,"_2329":40676},[],"Advanced design; the front door uses TLS passthrough and each internal Gateway terminates its own TLS",{"_2802":299,"_24443":248,"_17120":40678,"_5":17015,"_23194":40547,"_2329":40679},[],"Separate Gateway resources but shared proxy infrastructure",{"_2802":300,"_24443":248,"_17120":40681,"_5":17015,"_23194":40547,"_2329":40682},[],"Envoy merged-Gateway mode",{"_2802":301,"_24443":248,"_17120":40684,"_5":17015,"_23194":40547,"_2329":40685},[],"Logical separation only; listeners must have unique port, protocol and hostname tuples",{"_2802":302,"_24443":248,"_17120":40687,"_5":17015,"_23194":40547,"_2329":40688},[],"Three independent `LoadBalancer` Services cannot all reserve the same node ports 80 and 443 through K3s ServiceLB. Use one shared Gateway, allocate distinct VIPs with another load-balancer implementation, or use different ports.",{"_2802":303,"_24443":248,"_17120":40690,"_5":17015,"_23194":40547,"_2329":40691},[],"Envoy Gateway normally provisions a proxy fleet per `Gateway`. Its merged-Gateway mode can share one fleet and address, but it is not a drop-in switch for multiple Lamassu releases: the generated Lamassu listeners use the same ports and protocols without distinct hostnames, so they conflict unless you deliberately customize the listener design.",{"_2802":304,"_24443":248,"_17120":40693,"_5":17015,"_23194":40547,"_2329":40694},[],"Use a front-door SNI design only when the internal Gateways must retain independent TLS or mTLS policy:",{"_2802":305,"_24443":248,"_17120":40696,"_5":17015,"_23194":40547,"_2329":40697},[],"This requires distinct SNI hostnames and cluster networking outside the Lamassu chart.",{"_2802":306,"_24443":248,"_17120":40699,"_5":17015,"_23194":40551,"_2329":40700},[],"If one Gateway can own TLS and routing, use the chart default.",{"_2802":307,"_24443":248,"_17120":40702,"_5":17015,"_23194":40551,"_2329":40703},[],"If Gateways need independent policy and you can allocate IPs, use one VIP per Gateway.",{"_2802":308,"_24443":248,"_17120":40705,"_5":17015,"_23194":40551,"_2329":40706},[],"If only the Kubernetes resources need separation, evaluate merged-Gateway mode and make every listener tuple unique.",{"_2802":309,"_24443":248,"_17120":40708,"_5":17015,"_23194":40551,"_2329":40709},[],"If data planes and TLS termination must stay independent behind one IP, add a front-door SNI passthrough layer.",{"_2802":310,"_24443":248,"_17120":40711,"_5":17015,"_23194":40551,"_2329":40712},[],"If none of those are possible, use different external ports or change the external network design.",{"_2802":311,"_24443":248,"_17120":40714,"_5":17015,"_23194":40555,"_2329":40715},[],"Check, in order:",{"_2802":312,"_24443":248,"_17120":40717,"_5":17015,"_23194":40555,"_2329":40718},[],"`Gateway` has `Accepted=True` and `Programmed=True`.",{"_2802":313,"_24443":248,"_17120":40720,"_5":17015,"_23194":40555,"_2329":40721},[],"Its status contains the expected address.",{"_2802":314,"_24443":248,"_17120":40723,"_5":17015,"_23194":40555,"_2329":40724},[],"The generated `LoadBalancer` Service has a usable external address.",{"_2802":315,"_24443":248,"_17120":40726,"_5":17015,"_23194":40555,"_2329":40727},[],"Port 443 reaches that address from the client network.",{"_2802":316,"_24443":248,"_17120":40729,"_5":17015,"_23194":40555,"_2329":40730},[],"DNS resolves to the externally reachable endpoint.",{"_2802":317,"_24443":248,"_17120":40732,"_5":17015,"_23194":40555,"_2329":40733},[],"The certificate contains the DNS name or IP used by the client.",{"_2802":318,"_24443":248,"_17120":40735,"_5":17015,"_23194":40555,"_2329":40736},[],"The Gateway API treats addresses as desired state that a controller may assign or reject; see the Gateway API overview for the resource model.",{"_2802":319,"_24443":319,"_5":12033,"_2329":39897,"_24758":40738,"_17120":40739,"_23194":319},[39790,39791,39897],[],{"_2802":320,"_24443":319,"_17120":40741,"_5":17015,"_23194":319,"_2329":40742},[],"Choose an installation workflow and network architecture for Lamassu on your Kubernetes cluster.",{"_2802":321,"_24443":319,"_5":24755,"_17120":40744,"_23194":40745,"_2329":40746},[],"/docs/deployment/self-hosted/overview#self-managed-kubernetes-deployment","Self-managed Kubernetes deployment",{"_2802":322,"_24443":319,"_5":24755,"_17120":40748,"_23194":40749,"_2329":40750},[],"/docs/deployment/self-hosted/overview#choose-an-installation-workflow","Choose an installation workflow",{"_2802":323,"_24443":319,"_5":24755,"_17120":40752,"_23194":40753,"_2329":40754},[],"/docs/deployment/self-hosted/overview#what-the-lamassu-chart-provides","What the Lamassu chart provides",{"_2802":324,"_24443":319,"_5":24755,"_17120":40756,"_23194":40757,"_2329":40758},[],"/docs/deployment/self-hosted/overview#how-the-deployment-fits-together","How the deployment fits together",{"_2802":325,"_24443":319,"_5":24755,"_17120":40760,"_23194":40761,"_2329":40762},[],"/docs/deployment/self-hosted/overview#platform-requirements","Platform requirements",{"_2802":326,"_24443":319,"_5":24755,"_17120":40764,"_23194":40765,"_2329":40766},[],"/docs/deployment/self-hosted/overview#choose-the-next-page","Choose the next page",{"_2802":327,"_24443":319,"_17120":40768,"_5":17015,"_23194":40745,"_2329":40769},[],"Run Lamassu in a Kubernetes cluster operated by your team. The Helm chart deploys the Lamassu services and their routing resources; you provide the cluster, persistent storage, identity provider, PostgreSQL, RabbitMQ and the network path used by clients.",{"_2802":328,"_24443":319,"_17120":40771,"_5":17015,"_23194":40749,"_2329":40772},[],"Workflow",{"_2802":329,"_24443":319,"_17120":40774,"_5":17015,"_23194":40749,"_2329":40775},[],"Use it for",{"_2802":330,"_24443":319,"_17120":40777,"_5":17015,"_23194":40749,"_2329":40778},[],"What it installs",{"_2802":331,"_24443":319,"_17120":40780,"_5":17015,"_23194":40749,"_2329":40781},[],"Helm",{"_2802":332,"_24443":319,"_17120":40783,"_5":17015,"_23194":40749,"_2329":40784},[],"Production and controlled environments",{"_2802":333,"_24443":319,"_17120":40786,"_5":17015,"_23194":40749,"_2329":40787},[],"Lamassu services and Gateway API resources",{"_2802":334,"_24443":319,"_17120":40789,"_5":17015,"_23194":40749,"_2329":40034},[],{"_2802":335,"_24443":319,"_17120":40791,"_5":17015,"_23194":40749,"_2329":40792},[],"Evaluation, demos, CI and small lab clusters",{"_2802":336,"_24443":319,"_17120":40794,"_5":17015,"_23194":40749,"_2329":40795},[],"PostgreSQL, Keycloak, RabbitMQ, Envoy Gateway and Lamassu",{"_2802":337,"_24443":319,"_17120":40797,"_5":17015,"_23194":40753,"_2329":40798},[],"The Lamassu chart is an **application chart**, not a cluster bootstrap chart. It creates the Kubernetes resources that run and configure Lamassu, but it expects the platform services those resources depend on to exist.",{"_2802":338,"_24443":319,"_17120":40800,"_5":17015,"_23194":40753,"_2329":40801},[],"Area",{"_2802":339,"_24443":319,"_17120":40803,"_5":17015,"_23194":40753,"_2329":40804},[],"The Lamassu chart provides",{"_2802":340,"_24443":319,"_17120":40806,"_5":17015,"_23194":40753,"_2329":40807},[],"You provide",{"_2802":341,"_24443":319,"_17120":40809,"_5":17015,"_23194":40753,"_2329":40810},[],"Lamassu applications",{"_2802":342,"_24443":319,"_17120":40812,"_5":17015,"_23194":40753,"_2329":40813},[],"Deployments and StatefulSets for the UI and APIs, internal Services, ConfigMaps, a ServiceAccount, and optional HPAs and PDBs",{"_2802":343,"_24443":319,"_17120":40815,"_5":17015,"_23194":40753,"_2329":40816},[],"A working Kubernetes cluster, compute capacity and access to the container images",{"_2802":344,"_24443":319,"_17120":40818,"_5":17015,"_23194":40753,"_2329":40819},[],"PostgreSQL data",{"_2802":345,"_24443":319,"_17120":40821,"_5":17015,"_23194":40753,"_2329":40822},[],"A pre-install/pre-upgrade job that creates the required databases and schemas, runs migrations and applies the authorization bootstrap",{"_2802":346,"_24443":319,"_17120":40824,"_5":17015,"_23194":40753,"_2329":40825},[],"A reachable PostgreSQL server, credentials allowed to create databases and schemas, and backup/HA operations",{"_2802":347,"_24443":319,"_17120":40827,"_5":17015,"_23194":40753,"_2329":40828},[],"Messaging",{"_2802":348,"_24443":319,"_17120":40830,"_5":17015,"_23194":40753,"_2329":40831},[],"RabbitMQ connection configuration for the Lamassu services",{"_2802":349,"_24443":319,"_17120":40833,"_5":17015,"_23194":40753,"_2329":40834},[],"A reachable RabbitMQ broker, credentials and its lifecycle",{"_2802":350,"_24443":319,"_17120":40836,"_5":17015,"_23194":40753,"_2329":40837},[],"Identity",{"_2802":351,"_24443":319,"_17120":40839,"_5":17015,"_23194":40753,"_2329":40840},[],"OIDC/JWT and external-authorization configuration, plus initial Lamassu authorization principals",{"_2802":352,"_24443":319,"_17120":40842,"_5":17015,"_23194":40753,"_2329":40843},[],"An OIDC provider, realm/tenant, client, users, groups and roles",{"_2802":353,"_24443":319,"_17120":40845,"_5":17015,"_23194":40753,"_2329":40846},[],"External routing",{"_2802":354,"_24443":319,"_17120":40848,"_5":17015,"_23194":40753,"_2329":40849},[],"One `Gateway`, `HTTPRoute` resources, an `EnvoyProxy` configuration and Envoy security policies",{"_2802":355,"_24443":319,"_17120":40851,"_5":17015,"_23194":40753,"_2329":40852},[],"Gateway API and Envoy CRDs, the Envoy Gateway controller, a `GatewayClass`, a load-balancer implementation and the external network path",{"_2802":356,"_24443":319,"_17120":40854,"_5":17015,"_23194":40753,"_2329":40855},[],"TLS",{"_2802":357,"_24443":319,"_17120":40857,"_5":17015,"_23194":40753,"_2329":40858},[],"cert-manager `Issuer` and CA `Certificate` resources; either a chart-managed downstream `Certificate` or a reference to your TLS Secret",{"_2802":358,"_24443":319,"_17120":40860,"_5":17015,"_23194":40753,"_2329":40861},[],"cert-manager itself; for trusted TLS, a trusted issuer or a populated TLS Secret",{"_2802":359,"_24443":319,"_17120":40863,"_5":17015,"_23194":40753,"_2329":40864},[],"Persistent application data",{"_2802":360,"_24443":319,"_17120":40866,"_5":17015,"_23194":40753,"_2329":40867},[],"PersistentVolumeClaims required by the default local KMS and VA storage",{"_2802":361,"_24443":319,"_17120":40869,"_5":17015,"_23194":40753,"_2329":40870},[],"A StorageClass, physical storage, backups and a shared/external backend when scaling requires one",{"_2802":362,"_24443":319,"_17120":40872,"_5":17015,"_23194":40753,"_2329":40873},[],"Optional integrations",{"_2802":363,"_24443":319,"_17120":40875,"_5":17015,"_23194":40753,"_2329":40876},[],"Configuration hooks for observability, AWS connectors and PKCS#11/HSM connectivity",{"_2802":364,"_24443":319,"_17120":40878,"_5":17015,"_23194":40753,"_2329":40879},[],"The observability backends, cloud credentials and production HSM or external key service",{"_2802":365,"_24443":319,"_17120":40881,"_5":17015,"_23194":40753,"_2329":40882},[],"The chart creates Lamassu's `Gateway` and routes. It does not install the Envoy Gateway controller or make the generated `LoadBalancer` Service reachable from your network.",{"_2802":366,"_24443":319,"_17120":40884,"_5":17015,"_23194":40753,"_2329":40885},[],"Use one Lamassu Gateway on ports 80 and 443 and let its HTTPRoutes dispatch traffic to every Lamassu service. Give that Gateway one externally reachable endpoint through the cluster load balancer, or forward traffic to it from an external proxy or NAT device. You do not need one Gateway per service.",{"_2802":367,"_24443":319,"_17120":40887,"_5":17015,"_23194":40757,"_2329":40888},[],"The chart creates one shared `Gateway` per Helm release. All chart-managed `HTTPRoute` resources attach to it. Envoy Gateway provisions the proxy data plane and a Kubernetes `LoadBalancer` Service for that Gateway.",{"_2802":368,"_24443":319,"_17120":40890,"_5":17015,"_23194":40757,"_2329":40891},[],"The `gateway.addresses` value is only an address request to the Gateway controller. It does not make an IP routable, open a firewall, configure DNS or create NAT. See Expose the Gateway before setting it.",{"_2802":369,"_24443":319,"_17120":40893,"_5":17015,"_23194":40761,"_2329":40894},[],"Kubernetes 1.24 or newer",{"_2802":370,"_24443":319,"_17120":40896,"_5":17015,"_23194":40761,"_2329":40897},[],"Helm 3.2 or newer",{"_2802":371,"_24443":319,"_17120":40899,"_5":17015,"_23194":40761,"_2329":40900},[],"Envoy Gateway 1.8 or newer and a `GatewayClass`",{"_2802":372,"_24443":319,"_17120":40902,"_5":17015,"_23194":40761,"_2329":40903},[],"cert-manager 1.14 or newer; the current chart renders cert-manager issuer and certificate resources",{"_2802":373,"_24443":319,"_17120":40905,"_5":17015,"_23194":40761,"_2329":40906},[],"persistent storage suitable for the selected PostgreSQL, RabbitMQ, VA and KMS configuration",{"_2802":374,"_24443":319,"_17120":40908,"_5":17015,"_23194":40761,"_2329":40909},[],"a load-balancer implementation or another deliberate path from clients to the Gateway",{"_2802":375,"_24443":319,"_17120":40911,"_5":17015,"_23194":40761,"_2329":40912},[],"KMS deployments using the native PKCS#11 sidecar require Kubernetes 1.29 or newer.",{"_2802":376,"_24443":319,"_17120":40914,"_5":17015,"_23194":40765,"_2329":40915},[],"<Card title=\"Install with Helm\" description=\"Prepare dependencies, configure values, install and verify a controlled deployment.\" href=\"/docs/deployment/self-hosted/helm\" />",{"_2802":377,"_24443":319,"_17120":40917,"_5":17015,"_23194":40765,"_2329":40918},[],"<Card title=\"Expose the Gateway\" description=\"Choose an external traffic design, understand gateway.addresses and handle multiple Gateways.\" href=\"/docs/deployment/self-hosted/networking\" />",{"_2802":378,"_24443":319,"_17120":40920,"_5":17015,"_23194":40765,"_2329":40921},[],"<Card title=\"Use Fastlane\" description=\"Bootstrap a complete evaluation or lab environment with one script.\" href=\"/docs/deployment/self-hosted/fastlane\" />",{"_2802":379,"_24443":379,"_5":12033,"_2329":40923,"_24758":40924,"_17120":40926,"_23194":379},"Deployment troubleshooting",[39790,39791,40925],"Operations",[],{"_2802":380,"_24443":379,"_17120":40928,"_5":17015,"_23194":379,"_2329":40929},[],"Diagnose access, service health and infrastructure dependencies.",{"_2802":381,"_24443":379,"_5":24755,"_17120":40931,"_23194":40932,"_2329":40933},[],"/docs/deployment/troubleshooting#diagnostic-sequence","Diagnostic sequence",{"_2802":382,"_24443":379,"_5":24755,"_17120":40935,"_23194":40936,"_2329":40937},[],"/docs/deployment/troubleshooting#reproduce-a-single-operation","Reproduce a single operation",{"_2802":383,"_24443":379,"_5":24755,"_17120":40939,"_23194":40940,"_2329":40941},[],"/docs/deployment/troubleshooting#separate-client-gateway-and-service","Separate client, Gateway and service",{"_2802":384,"_24443":379,"_5":24755,"_17120":40943,"_23194":40944,"_2329":40945},[],"/docs/deployment/troubleshooting#review-kubernetes-status","Review Kubernetes status",{"_2802":385,"_24443":379,"_5":24755,"_17120":40947,"_23194":40948,"_2329":40949},[],"/docs/deployment/troubleshooting#query-the-affected-service","Query the affected service",{"_2802":386,"_24443":379,"_5":24755,"_17120":40951,"_23194":40952,"_2329":40953},[],"/docs/deployment/troubleshooting#validate-the-result-from-outside","Validate the result from outside",{"_2802":387,"_24443":379,"_5":24755,"_17120":40955,"_23194":40956,"_2329":40957},[],"/docs/deployment/troubleshooting#minimal-evidence-collection","Minimal evidence collection",{"_2802":388,"_24443":379,"_5":24755,"_17120":40959,"_23194":40960,"_2329":40961},[],"/docs/deployment/troubleshooting#i-cannot-sign-in","I cannot sign in",{"_2802":389,"_24443":379,"_5":24755,"_17120":40963,"_23194":40964,"_2329":40965},[],"/docs/deployment/troubleshooting#everything-returns-403-or-5xx","Everything returns 403 or 5xx",{"_2802":390,"_24443":379,"_5":24755,"_17120":40967,"_23194":40968,"_2329":40969},[],"/docs/deployment/troubleshooting#a-pod-is-not-ready","A pod is not Ready",{"_2802":391,"_24443":379,"_5":24755,"_17120":40971,"_23194":40972,"_2329":40973},[],"/docs/deployment/troubleshooting#events-are-not-arriving","Events are not arriving",{"_2802":392,"_24443":379,"_5":24755,"_17120":40975,"_23194":40976,"_2329":40977},[],"/docs/deployment/troubleshooting#observability","Observability",{"_2802":393,"_24443":379,"_17120":40979,"_5":17015,"_23194":379,"_2329":40980},[],"Start by locating the failing layer. A Gateway response and an unready pod require different evidence. For rejected issuance or validation results, see PKI troubleshooting; for enrollment, see EST diagnostics.",{"_2802":394,"_24443":379,"_17120":40982,"_5":17015,"_23194":40936,"_2329":40983},[],"Note the time in UTC, user or principal, resource, endpoint and result. Avoid repeating a destructive action such as revocation or deletion.",{"_2802":395,"_24443":379,"_17120":40985,"_5":17015,"_23194":40940,"_2329":40986},[],"Check the HTTP status. A 401 points to authentication; a 403, to authorization; a 404, to route or resource; a 5xx, to the service or a dependency.",{"_2802":396,"_24443":379,"_17120":40988,"_5":17015,"_23194":40944,"_2329":40989},[],"Locate unready pods, restarts, recent events and the state of the release.",{"_2802":397,"_24443":379,"_17120":40991,"_5":17015,"_23194":40948,"_2329":40992},[],"Review its /health endpoint and its logs in the same time window. Then follow the indicated dependency: PostgreSQL, RabbitMQ, the OIDC provider or the cryptographic engine.",{"_2802":398,"_24443":379,"_17120":40994,"_5":17015,"_23194":40952,"_2329":40995},[],"For PKI, check the certificate, the chain, OCSP or CRL with the same type of client production uses.",{"_2802":399,"_24443":379,"_17120":40997,"_5":17015,"_23194":40956,"_2329":40998},[],"Replace the placeholders with your real release, namespace and deployment.",{"_2802":400,"_24443":379,"_17120":41000,"_5":17015,"_23194":40956,"_2329":41001},[],"Also run the chart's connectivity test:",{"_2802":401,"_24443":379,"_17120":41003,"_5":17015,"_23194":40956,"_2329":41004},[],"The test checks the health of CA, DMS Manager, Device Manager and VA, and verifies that the UI returns HTML. A passing test confirms basic connectivity, not a full issuance flow.",{"_2802":402,"_24443":379,"_17120":41006,"_5":17015,"_23194":40956,"_2329":41007},[],"The chart's services expose startup, readiness and liveness probes over /health. A pod can be running but receive no traffic if the readiness probe fails.",{"_2802":403,"_24443":379,"_17120":41009,"_5":17015,"_23194":40960,"_2329":41010},[],"If you receive a 401:",{"_2802":404,"_24443":379,"_17120":41012,"_5":17015,"_23194":40960,"_2329":41013},[],"check that the UI's OIDC authority is reachable from the browser;",{"_2802":405,"_24443":379,"_17120":41015,"_5":17015,"_23194":40960,"_2329":41016},[],"verify issuer, audience and expiration of the token;",{"_2802":406,"_24443":379,"_17120":41018,"_5":17015,"_23194":40960,"_2329":41019},[],"confirm the Gateway can fetch the keys from the JWKS URI;",{"_2802":407,"_24443":379,"_17120":41021,"_5":17015,"_23194":40960,"_2329":41022},[],"check that the provider's public and internal routes point to the same realm.",{"_2802":408,"_24443":379,"_17120":41024,"_5":17015,"_23194":40960,"_2329":41025},[],"If login succeeds but the APIs return 403:",{"_2802":409,"_24443":379,"_17120":41027,"_5":17015,"_23194":40960,"_2329":41028},[],"inspect the token's real claims;",{"_2802":410,"_24443":379,"_17120":41030,"_5":17015,"_23194":40960,"_2329":41031},[],"confirm they match an active principal;",{"_2802":411,"_24443":379,"_17120":41033,"_5":17015,"_23194":40960,"_2329":41034},[],"review the policies granted to that principal;",{"_2802":412,"_24443":379,"_17120":41036,"_5":17015,"_23194":40960,"_2329":41037},[],"verify that authz reaches PostgreSQL and its JWKS.",{"_2802":413,"_24443":379,"_17120":41039,"_5":17015,"_23194":40960,"_2329":41040},[],"On a fresh installation, confirm the migration Job finished. That Job creates schemas, migrates authz, preloads policies and provisions the principals defined in services.authz.bootstrap.",{"_2802":414,"_24443":379,"_17120":41042,"_5":17015,"_23194":40964,"_2329":41043},[],"External authorization fails closed by default. If authz is unavailable, protected routes are blocked.",{"_2802":415,"_24443":379,"_17120":41045,"_5":17015,"_23194":40964,"_2329":41046},[],"Locate the authz pod and Service.",{"_2802":416,"_24443":379,"_17120":41048,"_5":17015,"_23194":40964,"_2329":41049},[],"Check /health, logs and its database connection.",{"_2802":417,"_24443":379,"_17120":41051,"_5":17015,"_23194":40964,"_2329":41052},[],"Verify the DNS and port configured in externalAuthorization.",{"_2802":418,"_24443":379,"_17120":41054,"_5":17015,"_23194":40964,"_2329":41055},[],"Check the check route is /v1/ext\\_authz/check.",{"_2802":419,"_24443":379,"_17120":41057,"_5":17015,"_23194":40964,"_2329":41058},[],"Do not switch to failOpen: true as a permanent workaround: it would allow traffic without authorization during the outage.",{"_2802":420,"_24443":379,"_17120":41060,"_5":17015,"_23194":40968,"_2329":41061},[],"Review kubectl describe pod first. Common causes are:",{"_2802":421,"_24443":379,"_17120":41063,"_5":17015,"_23194":40968,"_2329":41064},[],"wrong credentials or DNS for PostgreSQL or RabbitMQ;",{"_2802":422,"_24443":379,"_17120":41066,"_5":17015,"_23194":40968,"_2329":41067},[],"unbound persistent volume;",{"_2802":423,"_24443":379,"_17120":41069,"_5":17015,"_23194":40968,"_2329":41070},[],"inaccessible image or incorrect pull policy;",{"_2802":424,"_24443":379,"_17120":41072,"_5":17015,"_23194":40968,"_2329":41073},[],"invalid cryptographic engine configuration;",{"_2802":425,"_24443":379,"_17120":41075,"_5":17015,"_23194":40968,"_2329":41076},[],"CPU or memory limits set too low;",{"_2802":426,"_24443":379,"_17120":41078,"_5":17015,"_23194":40968,"_2329":41079},[],"an incomplete prior migration.",{"_2802":427,"_24443":379,"_17120":41081,"_5":17015,"_23194":40968,"_2329":41082},[],"Generic values request 100 mCPU and 128 MiB and limit to 500 mCPU and 512 MiB. Tune per service when you see OOMKills, throttling or slow startups.",{"_2802":428,"_24443":379,"_17120":41084,"_5":17015,"_23194":40968,"_2329":41085},[],"Filesystem-based KMS engines and VA local storage use exclusive-access volumes. Keep a single replica or migrate to shared backends before enabling autoscaling.",{"_2802":429,"_24443":379,"_17120":41087,"_5":17015,"_23194":40972,"_2329":41088},[],"Domain and audit events depend on the bus publisher:",{"_2802":430,"_24443":379,"_17120":41090,"_5":17015,"_23194":40972,"_2329":41091},[],"verify it is enabled in the emitting service;",{"_2802":431,"_24443":379,"_17120":41093,"_5":17015,"_23194":40972,"_2329":41094},[],"check AMQP connectivity and credentials;",{"_2802":432,"_24443":379,"_17120":41096,"_5":17015,"_23194":40972,"_2329":41097},[],"review exchange, routing key, queues and consumers;",{"_2802":433,"_24443":379,"_17120":41099,"_5":17015,"_23194":40972,"_2329":41100},[],"inspect dead-letter queues;",{"_2802":434,"_24443":379,"_17120":41102,"_5":17015,"_23194":40972,"_2329":41103},[],"alert on orphan durable queues and backlog growth.",{"_2802":435,"_24443":379,"_17120":41105,"_5":17015,"_23194":40972,"_2329":41106},[],"A consumer outage does not always prevent the main operation from completing. That is why you must monitor RabbitMQ and independently verify the persistence of audit logs.",{"_2802":436,"_24443":379,"_17120":41108,"_5":17015,"_23194":40976,"_2329":41109},[],"The chart can enable OpenTelemetry instrumentation. Traces are exported over OTLP HTTP and logs can be directed to a compatible endpoint, such as VictoriaLogs. Use a correlation identifier and the same time window to join Gateway, authz, service and dependency.",{"_2802":437,"_24443":379,"_17120":41111,"_5":17015,"_23194":40976,"_2329":41112},[],"Before closing an incident, record:",{"_2802":438,"_24443":379,"_17120":41114,"_5":17015,"_23194":40976,"_2329":41115},[],"the confirmed cause;",{"_2802":439,"_24443":379,"_17120":41117,"_5":17015,"_23194":40976,"_2329":41118},[],"the time scope and affected resources;",{"_2802":440,"_24443":379,"_17120":41120,"_5":17015,"_23194":40976,"_2329":41121},[],"the commands or queries used;",{"_2802":441,"_24443":379,"_17120":41123,"_5":17015,"_23194":40976,"_2329":41124},[],"the applied change and how to revert it;",{"_2802":442,"_24443":379,"_17120":41126,"_5":17015,"_23194":40976,"_2329":41127},[],"validation from a consumer;",{"_2802":443,"_24443":379,"_17120":41129,"_5":17015,"_23194":40976,"_2329":41130},[],"the preventive action and its owner.",{"_2802":444,"_24443":444,"_5":12033,"_2329":41132,"_24758":41133,"_17120":41136,"_23194":444},"Access control",[39790,41134,41135],"Platform","Administration",[],{"_2802":445,"_24443":444,"_17120":41138,"_5":17015,"_23194":444,"_2329":41139},[],"Design who can access Lamassu through principals, policies, resource permissions and HTTP route authorization.",{"_2802":446,"_24443":444,"_5":24755,"_17120":41141,"_23194":41142,"_2329":41143},[],"/docs/platform/administration/access-control#essential-concepts","Essential concepts",{"_2802":447,"_24443":444,"_5":24755,"_17120":41145,"_23194":41146,"_2329":41147},[],"/docs/platform/administration/access-control#two-decision-systems","Two decision systems",{"_2802":448,"_24443":444,"_5":24755,"_17120":41149,"_23194":41150,"_2329":41151},[],"/docs/platform/administration/access-control#integrated-or-external-http-services","Integrated or external HTTP services",{"_2802":449,"_24443":444,"_5":24755,"_17120":41153,"_23194":41154,"_2329":41155},[],"/docs/platform/administration/access-control#authentication-only-routes-and-unmapped-paths","Authentication-only routes and unmapped paths",{"_2802":450,"_24443":444,"_5":24755,"_17120":41157,"_23194":41158,"_2329":41159},[],"/docs/platform/administration/access-control#services-developed-by-lamassu","Services developed by Lamassu",{"_2802":451,"_24443":444,"_5":24755,"_17120":41161,"_23194":41162,"_2329":41163},[],"/docs/platform/administration/access-control#how-the-two-paths-relate","How the two paths relate",{"_2802":452,"_24443":444,"_5":24755,"_17120":41165,"_23194":41166,"_2329":41167},[],"/docs/platform/administration/access-control#oidc-principals","OIDC principals",{"_2802":453,"_24443":444,"_5":24755,"_17120":41169,"_23194":41170,"_2329":41171},[],"/docs/platform/administration/access-control#x509-principals","X.509 principals",{"_2802":454,"_24443":444,"_5":24755,"_17120":41173,"_23194":41174,"_2329":41175},[],"/docs/platform/administration/access-control#when-several-principals-match","When several principals match",{"_2802":455,"_24443":444,"_5":24755,"_17120":41177,"_23194":41178,"_2329":41179},[],"/docs/platform/administration/access-control#how-policies-express-access","How policies express access",{"_2802":456,"_24443":444,"_5":24755,"_17120":41181,"_23194":41182,"_2329":41183},[],"/docs/platform/administration/access-control#global-and-direct-access","Global and direct access",{"_2802":457,"_24443":444,"_5":24755,"_17120":41185,"_23194":41186,"_2329":41187},[],"/docs/platform/administration/access-control#access-inherited-through-relations","Access inherited through relations",{"_2802":458,"_24443":444,"_5":24755,"_17120":41189,"_23194":41190,"_2329":41191},[],"/docs/platform/administration/access-control#attribute-filtered-access","Attribute-filtered access",{"_2802":459,"_24443":444,"_5":24755,"_17120":41193,"_23194":41194,"_2329":41195},[],"/docs/platform/administration/access-control#http-rules","HTTP rules",{"_2802":460,"_24443":444,"_5":24755,"_17120":41197,"_23194":41198,"_2329":41199},[],"/docs/platform/administration/access-control#included-policies","Included policies",{"_2802":461,"_24443":444,"_5":24755,"_17120":41201,"_23194":41202,"_2329":40393},[],"/docs/platform/administration/access-control#provision-the-first-administrator",{"_2802":462,"_24443":444,"_5":24755,"_17120":41204,"_23194":41205,"_2329":41206},[],"/docs/platform/administration/access-control#prepare-the-identity-provider","Prepare the identity provider",{"_2802":463,"_24443":444,"_5":24755,"_17120":41208,"_23194":41209,"_2329":41210},[],"/docs/platform/administration/access-control#configure-the-two-jwt-validations","Configure the two JWT validations",{"_2802":464,"_24443":444,"_5":24755,"_17120":41212,"_23194":41213,"_2329":41214},[],"/docs/platform/administration/access-control#install-and-verify-administrative-access","Install and verify administrative access",{"_2802":465,"_24443":444,"_5":24755,"_17120":41216,"_23194":41217,"_2329":41218},[],"/docs/platform/administration/access-control#test-an-unprivileged-identity","Test an unprivileged identity",{"_2802":466,"_24443":444,"_5":24755,"_17120":41220,"_23194":41221,"_2329":41222},[],"/docs/platform/administration/access-control#reduce-use-of-the-bootstrap-administrator","Reduce use of the bootstrap administrator",{"_2802":467,"_24443":444,"_5":24755,"_17120":41224,"_23194":41225,"_2329":41226},[],"/docs/platform/administration/access-control#fastlane-bootstrap","Fastlane bootstrap",{"_2802":468,"_24443":444,"_5":24755,"_17120":41228,"_23194":41229,"_2329":41230},[],"/docs/platform/administration/access-control#design-least-privilege-roles","Design least-privilege roles",{"_2802":469,"_24443":444,"_5":24755,"_17120":41232,"_23194":41233,"_2329":41234},[],"/docs/platform/administration/access-control#changes-and-access-revocation","Changes and access revocation",{"_2802":470,"_24443":444,"_5":24755,"_17120":41236,"_23194":41237,"_2329":41238},[],"/docs/platform/administration/access-control#operational-checklist","Operational checklist",{"_2802":471,"_24443":444,"_5":24755,"_17120":41240,"_23194":41241,"_2329":41242},[],"/docs/platform/administration/access-control#diagnostics","Diagnostics",{"_2802":472,"_24443":444,"_5":24755,"_17120":41244,"_23194":41245,"_2329":41246},[],"/docs/platform/administration/access-control#the-response-is-401","The response is 401",{"_2802":473,"_24443":444,"_5":24755,"_17120":41248,"_23194":41249,"_2329":41250},[],"/docs/platform/administration/access-control#the-response-is-403","The response is 403",{"_2802":474,"_24443":444,"_5":24755,"_17120":41252,"_23194":41253,"_2329":41254},[],"/docs/platform/administration/access-control#everything-returns-403","Everything returns 403",{"_2802":475,"_24443":444,"_5":24755,"_17120":41256,"_23194":41257,"_2329":41258},[],"/docs/platform/administration/access-control#access-appears-without-a-policy-grant","Access appears without a policy grant",{"_2802":476,"_24443":444,"_5":24755,"_17120":41260,"_23194":41261,"_2329":41262},[],"/docs/platform/administration/access-control#everything-fails-when-authz-is-unavailable","Everything fails when authz is unavailable",{"_2802":477,"_24443":444,"_17120":41264,"_5":17015,"_23194":444,"_2329":41265},[],"Lamassu access control turns an authenticated identity into concrete permissions. The OIDC provider or the client certificate proves **who** makes a request; the `authz` service decides **what that identity can do** and **over which resources**.",{"_2802":478,"_24443":444,"_17120":41267,"_5":17015,"_23194":444,"_2329":41268},[],"Lamassu does not assign permissions directly to users. The full chain is:",{"_2802":479,"_24443":444,"_17120":41270,"_5":17015,"_23194":444,"_2329":41271},[],"This model lets you represent people, identity-provider groups, service accounts and devices without coupling authorization to a specific provider.",{"_2802":480,"_24443":444,"_17120":41273,"_5":17015,"_23194":41142,"_2329":41274},[],"A **principal** connects a credential to Lamassu. It defines how to recognize an OIDC or X.509 identity and can be active or disabled.",{"_2802":481,"_24443":444,"_17120":41276,"_5":17015,"_23194":41142,"_2329":41277},[],"A **policy** groups reusable permissions. It can be granted to several principals and can contain rules about Lamassu entities, rules about HTTP routes or both.",{"_2802":482,"_24443":444,"_17120":41279,"_5":17015,"_23194":41142,"_2329":41280},[],"An **entity rule** grants actions over resources such as certification authorities, certificates, issuance profiles, devices, DMSs, keys or alert subscriptions. It can cover all resources of a type or be limited by identifier, relation or attribute.",{"_2802":483,"_24443":444,"_17120":41282,"_5":17015,"_23194":41142,"_2329":41283},[],"An **HTTP rule** grants actions associated with API routes. It is the mechanism the Gateway uses to decide whether a request may cross the perimeter.",{"_2802":484,"_24443":444,"_17120":41285,"_5":17015,"_23194":41142,"_2329":41286},[],"A **grant** is the association between a principal and a policy. Removing the grant removes all permissions contributed by that policy, without modifying it for other principals.",{"_2802":485,"_24443":444,"_17120":41288,"_5":17015,"_23194":41142,"_2329":41289},[],"A valid JWT or a valid client certificate does not grant access by itself. The credential must match at least one active principal and, unless the HTTP schema exempts the route, one of its policies must allow the requested operation. See *Authentication-only routes and unmapped paths* for those exemptions.",{"_2802":486,"_24443":444,"_17120":41291,"_5":17015,"_23194":41146,"_2329":41292},[],"Lamassu uses two authorization paths depending on who implements the protected service. They share principals, policies and grants, but they do not interpret the rules the same way.",{"_2802":487,"_24443":444,"_17120":41294,"_5":17015,"_23194":41146,"_2329":41295},[],"An external service can be protected without knowing Lamassu's internal authorization model. A service developed by Lamassu embeds the authorization engine and can decide on concrete resources and filter its queries.",{"_2802":488,"_24443":444,"_17120":41297,"_5":17015,"_23194":41150,"_2329":41298},[],"This path protects APIs that join the platform through the Gateway but do not natively implement Lamassu's authorization SDK. Job Manager is the current example. The same pattern allows integrating other HTTP services as long as their routes are described in an `authz` HTTP schema.",{"_2802":489,"_24443":444,"_17120":41300,"_5":17015,"_23194":41150,"_2329":41301},[],"The decision is made **before forwarding the request to the service**:",{"_2802":490,"_24443":444,"_17120":41303,"_5":17015,"_23194":41150,"_2329":41304},[],"Envoy Gateway authenticates the request, usually validating a JWT against the OIDC provider's JWKS.",{"_2802":491,"_24443":444,"_17120":41306,"_5":17015,"_23194":41150,"_2329":41307},[],"For a protected route, Envoy sends the method, URL, headers and required data to `/v1/ext_authz/check`.",{"_2802":492,"_24443":444,"_17120":41309,"_5":17015,"_23194":41150,"_2329":41310},[],"`authz` extracts the credential and resolves all active principals matching it.",{"_2802":493,"_24443":444,"_17120":41312,"_5":17015,"_23194":41150,"_2329":41313},[],"It separately loads the policies granted to each principal.",{"_2802":494,"_24443":444,"_17120":41315,"_5":17015,"_23194":41150,"_2329":41316},[],"The HTTP schema translates the method and route combination into a logical action, such as `nbi-job-read` or `nbi-workflow-create`.",{"_2802":495,"_24443":444,"_17120":41318,"_5":17015,"_23194":41150,"_2329":41319},[],"`authz` looks for an HTTP rule granting that action.",{"_2802":496,"_24443":444,"_17120":41321,"_5":17015,"_23194":41150,"_2329":41322},[],"If the route declares constraints, it compares request data with the normalized attributes of the same principal contributing the policy; the policy's own `param_constraints` also pin the granted action to literal request values.",{"_2802":497,"_24443":444,"_17120":41324,"_5":17015,"_23194":41150,"_2329":41325},[],"A satisfying result lets Envoy forward the request; any other response blocks it at the Gateway.",{"_2802":498,"_24443":444,"_17120":41327,"_5":17015,"_23194":41150,"_2329":41328},[],"When it allows access, `authz` returns the selected principal in `x-current-user`. The Gateway can propagate that header to the service to preserve the identity context.",{"_2802":499,"_24443":444,"_17120":41330,"_5":17015,"_23194":41150,"_2329":41331},[],"HTTP rules primarily answer &#x2A;*\"can this identity call this API operation?\"**. On their own they do not produce filters over the external service's database. To limit a route to a specific device, tenant or client, either the schema declares a constraint relating a request value to a normalized attribute of the principal, or the policy pins the request value to a literal with `param_constraints`. The first scopes each identity to its own resources through a single grant; the second restricts a grant to a fixed value regardless of who holds it.",{"_2802":500,"_24443":444,"_17120":41333,"_5":17015,"_23194":41154,"_2329":41334},[],"Two schema-level settings cover endpoints that policies do not mention:",{"_2802":501,"_24443":444,"_17120":41336,"_5":17015,"_23194":41154,"_2329":41337},[],"**`skip_authz: true` on a route** allows any identity that matches an active principal to reach it, even one with no granted policies. Use it for paths such as `/openapi.json` or `/health` that every authenticated caller should be able to access. The request still has to authenticate successfully: a credential that fails validation or matches no active principal is rejected before this setting is considered. A `skip_authz` route cannot declare constraints, and it wins over any other schema's route or default action for the same request.",{"_2802":502,"_24443":444,"_17120":41339,"_5":17015,"_23194":41154,"_2329":41340},[],"**`default_action` with `base_paths`** decides what happens when a request falls under a path prefix the schema owns but no explicit route matches. `deny` — the value the Job Manager schema ships with — turns the implicit denial of unmapped paths into an explicit, auditable statement; `allow` opens unmapped endpoints under that prefix to any identity that matches an active principal.",{"_2802":503,"_24443":444,"_17120":41342,"_5":17015,"_23194":41154,"_2329":41343},[],"These are decisions of the schema, not of a policy: `skip_authz` removes the grant check for that route, even when another schema maps the same request to an action that requires a grant, and `default_action` only covers requests that no explicit route in any schema matches. Keep three rules in mind:",{"_2802":504,"_24443":444,"_17120":41345,"_5":17015,"_23194":41154,"_2329":41346},[],"`default_action` requires at least one `base_paths` entry, and base paths are absolute paths such as `/api/wfx/nbi/v1`.",{"_2802":505,"_24443":444,"_17120":41348,"_5":17015,"_23194":41154,"_2329":41349},[],"An explicit route in any schema takes precedence: the fallback only decides requests that no schema's routes cover. When the prefixes of two schemas overlap, the longest matching prefix decides.",{"_2802":506,"_24443":444,"_17120":41351,"_5":17015,"_23194":41154,"_2329":41352},[],"Two schemas cannot claim the same base path with different default actions; the conflicting schema fails to load.",{"_2802":507,"_24443":444,"_17120":41354,"_5":17015,"_23194":41154,"_2329":41355},[],"A `skip_authz` route and a `default_action: \"allow\"` prefix grant access without consulting any policy. Every identity that matches an active principal can reach what they open, including identities with no granted policies. A `skip_authz` route in one schema also opens a request that another schema maps to a grant-protected action. Review these settings whenever you add or upgrade an integrated service.",{"_2802":508,"_24443":444,"_17120":41357,"_5":17015,"_23194":41158,"_2329":41358},[],"Lamassu's native services embed authorization in their middleware and know the entities they operate on: certificates, CAs, issuance profiles, keys, devices, DMSs or subscriptions, among others.",{"_2802":509,"_24443":444,"_17120":41360,"_5":17015,"_23194":41158,"_2329":41361},[],"The decision is made with the domain operation context:",{"_2802":510,"_24443":444,"_17120":41363,"_5":17015,"_23194":41158,"_2329":41364},[],"The middleware extracts the credential and resolves the matching principals.",{"_2802":511,"_24443":444,"_17120":41366,"_5":17015,"_23194":41158,"_2329":41367},[],"The endpoint identifies the action, the entity type and, when applicable, the key of the requested resource.",{"_2802":512,"_24443":444,"_17120":41369,"_5":17015,"_23194":41158,"_2329":41370},[],"`authz` gathers the entity rules of the granted policies.",{"_2802":513,"_24443":444,"_17120":41372,"_5":17015,"_23194":41158,"_2329":41373},[],"The engine evaluates direct grants, attribute filters and relations with other entities.",{"_2802":514,"_24443":444,"_17120":41375,"_5":17015,"_23194":41158,"_2329":41376},[],"For an individual operation, it checks that the concrete resource satisfies the computed scope.",{"_2802":515,"_24443":444,"_17120":41378,"_5":17015,"_23194":41158,"_2329":41379},[],"For a listing, it generates a SQL filter that the service adds to its own query.",{"_2802":516,"_24443":444,"_17120":41381,"_5":17015,"_23194":41158,"_2329":41382},[],"Here the engine answers &#x2A;*\"can this identity perform this action on this concrete resource?\"**.",{"_2802":517,"_24443":444,"_17120":41384,"_5":17015,"_23194":41158,"_2329":41385},[],"Actions fall into two groups:",{"_2802":518,"_24443":444,"_17120":41387,"_5":17015,"_23194":41158,"_2329":41388},[],"**Global actions** do not need a resource identifier. `create`, `import` or access to a console section are common examples.",{"_2802":519,"_24443":444,"_17120":41390,"_5":17015,"_23194":41158,"_2329":41391},[],"**Atomic actions** are evaluated on a concrete instance. For certificates these include `read`, `metadata-update`, `status-update` and `delete`; for a CA there are also `sign`, `reissue` and other lifecycle operations.",{"_2802":520,"_24443":444,"_17120":41393,"_5":17015,"_23194":41158,"_2329":41394},[],"Filtering inside the service prevents leaks in listings: unauthorized resources are excluded from the SQL query instead of being fetched and hidden later in the interface.",{"_2802":521,"_24443":444,"_17120":41396,"_5":17015,"_23194":41162,"_2329":41397},[],"They are not two equivalent controls applied twice. HTTP rules protect the perimeter of an integrated service; entity rules express permissions over the data model of the native services.",{"_2802":522,"_24443":444,"_17120":41399,"_5":17015,"_23194":41162,"_2329":41400},[],"A policy can contain both rule types when an identity needs to operate Lamassu resources and also call an integrated API. Granting an entity rule does not automatically grant an HTTP action, nor does an HTTP rule create access over an entity.",{"_2802":523,"_24443":444,"_17120":41402,"_5":17015,"_23194":41162,"_2329":41403},[],"If no combination of principal, policy and rule allows the operation, Lamassu denies it, unless the HTTP schema declares `skip_authz` on the route or `default_action: allow` on a base path that covers it (see *Authentication-only routes and unmapped paths*). Additionally, `auth.externalAuthorization.failOpen` is `false` by default: if `authz` is unavailable, the Gateway blocks protected routes.",{"_2802":524,"_24443":444,"_17120":41405,"_5":17015,"_23194":41166,"_2329":41406},[],"An OIDC principal matches the claims of a validated JWT. It is appropriate for human users, corporate groups, IdP roles and service accounts that obtain tokens.",{"_2802":525,"_24443":444,"_17120":41408,"_5":17015,"_23194":41166,"_2329":41409},[],"The following principal represents any identity holding the `pki-operators` role in Keycloak:",{"_2802":526,"_24443":444,"_17120":41411,"_5":17015,"_23194":41166,"_2329":41412},[],"Claim paths can be nested, such as `realm_access.roles`. Within a single principal, **all** conditions must hold. This lets you require, for example, a group and an organizational audience at the same time.",{"_2802":527,"_24443":444,"_17120":41414,"_5":17015,"_23194":41166,"_2329":41415},[],"The implemented operators are:",{"_2802":528,"_24443":444,"_17120":41417,"_5":17015,"_23194":41166,"_2329":41418},[],"`equals`, for exact equality;",{"_2802":529,"_24443":444,"_17120":41420,"_5":17015,"_23194":41166,"_2329":41421},[],"`contains`, to check membership in a list or the presence of text in a scalar value.",{"_2802":530,"_24443":444,"_17120":41423,"_5":17015,"_23194":41166,"_2329":41424},[],"Design matching with stable attributes. For people, it is usually better to bind permissions to centrally managed groups or roles than to the email or username. For a service account, a stable `sub` keeps its permissions from mixing with a human operator's.",{"_2802":531,"_24443":444,"_17120":41426,"_5":17015,"_23194":41166,"_2329":41427},[],"Although the model recognizes the operator name `matches`, the current implementation does not evaluate regular expressions and the condition never matches. Use `equals` or `contains`.",{"_2802":532,"_24443":444,"_17120":41429,"_5":17015,"_23194":41170,"_2329":41430},[],"An X.509 principal lets you recognize a workload or a device by its client certificate. Lamassu checks the certificate signature against the configured CA and, depending on the mode, also its serial number or Common Name.",{"_2802":533,"_24443":444,"_17120":41432,"_5":17015,"_23194":41170,"_2329":41433},[],"The available modes are:",{"_2802":534,"_24443":444,"_17120":41435,"_5":17015,"_23194":41170,"_2329":41436},[],"`serial_and_ca`: an exact certificate, identified by serial number and CA;",{"_2802":535,"_24443":444,"_17120":41438,"_5":17015,"_23194":41170,"_2329":41439},[],"`cn_and_ca`: an exact or wildcard Common Name and a specific CA;",{"_2802":536,"_24443":444,"_17120":41441,"_5":17015,"_23194":41170,"_2329":41442},[],"`any_from_ca`: any certificate issued directly by the given CA.",{"_2802":537,"_24443":444,"_17120":41444,"_5":17015,"_23194":41170,"_2329":41445},[],"This example recognizes certificates whose CN starts with `factory-a-` and that are signed by the configured CA:",{"_2802":538,"_24443":444,"_17120":41447,"_5":17015,"_23194":41170,"_2329":41448},[],"`ca_trust.identity_type` accepts `fingerprint` or `authority_key_id`. In both cases you must provide the CA certificate in `ca_trust.pem`; Lamassu verifies both the signature and the expected identity of the CA.",{"_2802":539,"_24443":444,"_17120":41450,"_5":17015,"_23194":41170,"_2329":41451},[],"Use `any_from_ca` only when every identity issued by that CA should share the same permissions. If a CA issues certificates for different populations, separate access by serial or CN, or use different issuing CAs.",{"_2802":540,"_24443":444,"_17120":41453,"_5":17015,"_23194":41174,"_2329":41454},[],"A single credential can match more than one principal. It is common for a user to match a principal of their team and another of their operational function.",{"_2802":541,"_24443":444,"_17120":41456,"_5":17015,"_23194":41174,"_2329":41457},[],"For entity permissions, Lamassu combines permissions with OR logic: it is enough that one policy of one of the principals allows the action. Listings contain the union of the resources visible to all of them.",{"_2802":542,"_24443":444,"_17120":41459,"_5":17015,"_23194":41174,"_2329":41460},[],"HTTP routes with constraints are stricter. The same principal contributing the policy must also satisfy the attributes required by the route. Lamassu does not combine one principal's policy with an attribute belonging to another.",{"_2802":543,"_24443":444,"_17120":41462,"_5":17015,"_23194":41174,"_2329":41463},[],"For this reason, adding a matching principal can only broaden access. Before creating overlapping rules, review the full set of policies a real identity will receive.",{"_2802":544,"_24443":444,"_17120":41465,"_5":17015,"_23194":41182,"_2329":41466},[],"A rule identifies the domain (`namespace`), the data schema (`schema_name`) and the entity type (`entity_type`). `actions` lists the allowed operations.",{"_2802":545,"_24443":444,"_17120":41468,"_5":17015,"_23194":41182,"_2329":41469},[],"`direct_grants` limits the rule to concrete identifiers. The value `*` covers all instances of the type. A superadministrator policy uses wildcards in schema, entity, actions and grants; a least-privilege policy should avoid them whenever possible.",{"_2802":546,"_24443":444,"_17120":41471,"_5":17015,"_23194":41186,"_2329":41472},[],"Rules can follow relations declared between entities. For example, the schema knows the relation of a certificate to its issuing CA and of a device to its DMS. A policy can grant access to a parent resource and propagate selected actions to its related resources.",{"_2802":547,"_24443":444,"_17120":41474,"_5":17015,"_23194":41186,"_2329":41475},[],"This lets you express models like \"can operate the devices of this DMS\" without maintaining an individual list of every device. When a resource is added under that relation, it inherits the scope planned by the policy.",{"_2802":548,"_24443":444,"_17120":41477,"_5":17015,"_23194":41190,"_2329":41478},[],"`column_filters` applies conditions to columns the schema has declared filterable. All filters of the same rule are combined with AND.",{"_2802":549,"_24443":444,"_17120":41480,"_5":17015,"_23194":41190,"_2329":41481},[],"For example, this rule allows reading active certificates issued by a specific CA:",{"_2802":550,"_24443":444,"_17120":41483,"_5":17015,"_23194":41190,"_2329":41484},[],"The available operators are `eq`, `neq`, `gt`, `gte`, `lt`, `lte`, `in` and `like`. Use comparisons consistent with the column type: `like` for text, ordering comparisons for numbers or dates and `in` when there is a collection of accepted values.",{"_2802":551,"_24443":444,"_17120":41486,"_5":17015,"_23194":41194,"_2329":41487},[],"HTTP rules do not point directly at tables. They reference a route schema and grant its logical actions. Job Manager's policies are an example: they distinguish reading, creating, updating and deleting workflows or jobs.",{"_2802":552,"_24443":444,"_17120":41489,"_5":17015,"_23194":41194,"_2329":41490},[],"Some routes also compare a request value — taken from the path, query, header or JSON body — with a normalized attribute of the principal. This way you can verify that a device only queries jobs addressed to its own `client_id`.",{"_2802":553,"_24443":444,"_17120":41492,"_5":17015,"_23194":41194,"_2329":41493},[],"Normalized attributes decouple the policy from the authentication mechanism. `subject_attribute_mappings` can derive, for example, `device_id` from `oidc.claim.device_id` or from `x509.subject.cn`. The rule consumes `device_id` in both cases.",{"_2802":554,"_24443":444,"_17120":41495,"_5":17015,"_23194":41194,"_2329":41496},[],"An HTTP rule can also pin a granted action to a literal value carried by the request itself through `param_constraints`. It extracts the value with the same sources as route constraints — `path_regex_group`, `query`, `header` or `json_body` — but compares it against an `equals` literal written into the policy rather than against a subject attribute. The grant then depends only on the request, not on who holds the policy:",{"_2802":555,"_24443":444,"_17120":41498,"_5":17015,"_23194":41194,"_2329":41499},[],"Combined with a schema route such as `^/api/mysvc/system/([^/]+)/info$`, this grants `GET /api/mysvc/system/1/info` and denies the same call for system `2`, regardless of the principal's attributes. The same mechanism pins query parameters, headers or JSON body fields, for example `{ \"source\": \"query\", \"name\": \"tenant_id\" }` with `\"equals\": \"1\"` to accept only requests carrying `?tenant_id=1`.",{"_2802":556,"_24443":444,"_17120":41501,"_5":17015,"_23194":41194,"_2329":41502},[],"Note that:",{"_2802":557,"_24443":444,"_17120":41504,"_5":17015,"_23194":41194,"_2329":41505},[],"`action` must be one of the actions granted by the rule; `equals` is required; `path_regex_group` needs an `index` greater than zero, `query` and `header` need a `name`, and `json_body` needs a `path` such as `$.tenant_id`.",{"_2802":558,"_24443":444,"_17120":41507,"_5":17015,"_23194":41194,"_2329":41508},[],"`param_constraints` are not cross-checked against the schema when the policy is loaded. A reference the route cannot satisfy — for instance a `path_regex_group` on a route without capture groups — simply never matches, and the request is denied.",{"_2802":559,"_24443":444,"_17120":41510,"_5":17015,"_23194":41194,"_2329":41511},[],"Several `param_constraints` for the same action combine with AND. A rule without them keeps the usual behavior: the action is granted wherever the route matches and the subject constraints pass.",{"_2802":560,"_24443":444,"_17120":41513,"_5":17015,"_23194":41198,"_2329":41514},[],"The `authz` preload installs reusable policies for the main domains. Among them are:",{"_2802":561,"_24443":444,"_17120":41516,"_5":17015,"_23194":41198,"_2329":41517},[],"full and read-only access to certificates and authorities;",{"_2802":562,"_24443":444,"_17120":41519,"_5":17015,"_23194":41198,"_2329":41520},[],"full and read-only access to the KMS;",{"_2802":563,"_24443":444,"_17120":41522,"_5":17015,"_23194":41198,"_2329":41523},[],"full and read-only access to Device Manager, DMS Manager, Validation Authority and alerts;",{"_2802":564,"_24443":444,"_17120":41525,"_5":17015,"_23194":41198,"_2329":41526},[],"an `Auditor` policy with PKI read access and authorization visibility;",{"_2802":565,"_24443":444,"_17120":41528,"_5":17015,"_23194":41198,"_2329":41529},[],"console access;",{"_2802":566,"_24443":444,"_17120":41531,"_5":17015,"_23194":41198,"_2329":41532},[],"administration and observation policies for the Job Manager NBI and SBI APIs;",{"_2802":567,"_24443":444,"_17120":41534,"_5":17015,"_23194":41198,"_2329":41535},[],"`SUPER ADMIN`, which grants all actions over the `authz` and `pki` domains.",{"_2802":568,"_24443":444,"_17120":41537,"_5":17015,"_23194":41198,"_2329":41538},[],"Start with these policies before creating others. If none reflects the boundary you need, create a specific, small policy instead of copying `SUPER ADMIN` and informally removing permissions.",{"_2802":569,"_24443":444,"_17120":41540,"_5":17015,"_23194":41202,"_2329":41541},[],"An installation without a principal matching your identity is left with nobody able to administer authorization. Configure the IdP and the bootstrap before exposing the platform.",{"_2802":570,"_24443":444,"_17120":41543,"_5":17015,"_23194":41202,"_2329":41544},[],"The chart includes a bootstrap principal that looks for the OIDC role `pki-admin` in `realm_access.roles`. It grants it `SUPER ADMIN` and, when Job Manager is enabled, the administrative policy of its NBI API.",{"_2802":571,"_24443":444,"_17120":41546,"_5":17015,"_23194":41202,"_2329":41547},[],"The pre-install and pre-upgrade Helm Job runs the `authz` migrations, preloads the policies and creates the bootstrap principals before the services start. If the principal already exists, it does not replace it: it only adds the configured grants that are still missing. You can keep the entry in `values.yaml` across upgrades.",{"_2802":572,"_24443":444,"_17120":41549,"_5":17015,"_23194":41205,"_2329":41550},[],"Create the role or group you will use to administer Lamassu. Assign it to at least two controlled human identities. If your provider does not use `realm_access.roles`, adapt the claim path in both the frontend and `auth_config.claims`.",{"_2802":573,"_24443":444,"_17120":41552,"_5":17015,"_23194":41209,"_2329":41553},[],"The Gateway uses `auth.authentication.apiGateway.jwks` to authenticate requests. `authz` uses `services.authz.jwkUrl` to resolve OIDC principals. Both endpoints must contain the keys of the same issuer and be reachable from their respective components.",{"_2802":574,"_24443":444,"_17120":41555,"_5":17015,"_23194":41213,"_2329":41556},[],"Sign in with an identity holding `pki-admin`. Confirm it can access authorization administration and perform a non-destructive read operation.",{"_2802":575,"_24443":444,"_17120":41558,"_5":17015,"_23194":41217,"_2329":41559},[],"Use a second user without the role and confirm the same operation is denied. This test catches misread claims, overly broad policies and accidental `failOpen` configurations.",{"_2802":576,"_24443":444,"_17120":41561,"_5":17015,"_23194":41221,"_2329":41562},[],"Create operational principals with narrower policies. Reserve `pki-admin` for authorization administration and recovery, not for daily work.",{"_2802":577,"_24443":444,"_17120":41564,"_5":17015,"_23194":41225,"_2329":41565},[],"Fastlane installs a Keycloak realm for the lab and creates the user `lamassu` with the temporary password `lamassu`, the role `pki-admin` and a mandatory password change. Its bootstrap principal matches through `preferred_username=lamassu`.",{"_2802":578,"_24443":444,"_17120":41567,"_5":17015,"_23194":41225,"_2329":41568},[],"Change the password on first login. Do not reuse the Fastlane user, password or IdP as a production design.",{"_2802":579,"_24443":444,"_17120":41570,"_5":17015,"_23194":41229,"_2329":41571},[],"Avoid reproducing your company's internal structure with dozens of nearly identical policies. Start from the responsibilities that actually need access:",{"_2802":580,"_24443":444,"_17120":41573,"_5":17015,"_23194":41229,"_2329":41574},[],"**Authorization administration**: manages principals, policies and grants. It should belong to a small, separate group.",{"_2802":581,"_24443":444,"_17120":41576,"_5":17015,"_23194":41229,"_2329":41577},[],"**PKI operation**: administers CAs, profiles and certificates, but not necessarily who gets access.",{"_2802":582,"_24443":444,"_17120":41579,"_5":17015,"_23194":41229,"_2329":41580},[],"**Device registration**: operates devices and DMSs without receiving permissions over keys or authorization configuration.",{"_2802":583,"_24443":444,"_17120":41582,"_5":17015,"_23194":41229,"_2329":41583},[],"**Audit**: reviews configuration and activity without creating, modifying, signing, revoking or deleting.",{"_2802":584,"_24443":444,"_17120":41585,"_5":17015,"_23194":41229,"_2329":41586},[],"**Automation**: uses a technical account or a separate certificate, with permissions limited to the flow and resources it controls.",{"_2802":585,"_24443":444,"_17120":41588,"_5":17015,"_23194":41229,"_2329":41589},[],"For each role, separate \"view\" from \"change\", limit resources through grants, relations or attributes and avoid `*` unless the role must automatically cover future actions.",{"_2802":586,"_24443":444,"_17120":41591,"_5":17015,"_23194":41229,"_2329":41592},[],"A rule with `actions: [\"*\"]` expands to every action defined by the schema. When a new version adds an action, a wildcard policy may start granting it. Review these policies on every upgrade.",{"_2802":587,"_24443":444,"_17120":41594,"_5":17015,"_23194":41233,"_2329":41595},[],"To revoke access immediately, disable the principal or revoke its grants. Disabling a principal keeps its configuration and associations for investigation or restoration, but it stops taking part in matching.",{"_2802":588,"_24443":444,"_17120":41597,"_5":17015,"_23194":41233,"_2329":41598},[],"Deleting a role or group in the IdP prevents new tokens from containing the claim, but an already-issued token may remain valid until it expires. If removal is urgent, combine the IdP change with disabling the principal in Lamassu and revoking sessions or tokens at the provider.",{"_2802":589,"_24443":444,"_17120":41600,"_5":17015,"_23194":41233,"_2329":41601},[],"When you edit a shared policy, remember the change affects all its principals. To test a new scope, create a separate policy, grant it to a test identity and validate allowed and denied operations before replacing the old one.",{"_2802":590,"_24443":444,"_17120":41603,"_5":17015,"_23194":41237,"_2329":41604},[],"Keep `failOpen: false` unless a documented risk assessment justifies otherwise.",{"_2802":591,"_24443":444,"_17120":41606,"_5":17015,"_23194":41237,"_2329":41607},[],"Use groups or stable roles for people and independent identities for automations.",{"_2802":592,"_24443":444,"_17120":41609,"_5":17015,"_23194":41237,"_2329":41610},[],"Keep at least two recovery administrators and test their access periodically.",{"_2802":593,"_24443":444,"_17120":41612,"_5":17015,"_23194":41237,"_2329":41613},[],"Review active principals, their matches and their grants after IdP changes.",{"_2802":594,"_24443":444,"_17120":41615,"_5":17015,"_23194":41237,"_2329":41616},[],"Search for wildcards in policies before upgrading Lamassu.",{"_2802":595,"_24443":444,"_17120":41618,"_5":17015,"_23194":41237,"_2329":41619},[],"Review `skip_authz` routes and `default_action` settings in HTTP schemas when integrating or upgrading a service.",{"_2802":596,"_24443":444,"_17120":41621,"_5":17015,"_23194":41237,"_2329":41622},[],"Always test one allowed and one denied operation for each role.",{"_2802":597,"_24443":444,"_17120":41624,"_5":17015,"_23194":41237,"_2329":41625},[],"Correlate changes to principals, policies and grants with the audit logs.",{"_2802":598,"_24443":444,"_17120":41627,"_5":17015,"_23194":41245,"_2329":41628},[],"Authentication failed before permissions were evaluated. Check the JWT signature and expiration, issuer, audience and the availability of the JWKS configured in the Gateway. For X.509, check that the client certificate reaches the point that extracts the credential.",{"_2802":599,"_24443":444,"_17120":41630,"_5":17015,"_23194":41249,"_2329":41631},[],"The credential could be processed but did not produce a positive authorization. Review in this order:",{"_2802":600,"_24443":444,"_17120":41633,"_5":17015,"_23194":41249,"_2329":41634},[],"that an active principal of the correct type exists;",{"_2802":601,"_24443":444,"_17120":41636,"_5":17015,"_23194":41249,"_2329":41637},[],"that the claim paths and values match the real token exactly;",{"_2802":602,"_24443":444,"_17120":41639,"_5":17015,"_23194":41249,"_2329":41640},[],"that all of the principal's conditions hold;",{"_2802":603,"_24443":444,"_17120":41642,"_5":17015,"_23194":41249,"_2329":41643},[],"that the principal has the expected policy granted;",{"_2802":604,"_24443":444,"_17120":41645,"_5":17015,"_23194":41249,"_2329":41646},[],"that the policy includes the action and the requested resource type or route;",{"_2802":605,"_24443":444,"_17120":41648,"_5":17015,"_23194":41249,"_2329":41649},[],"that the identifier, relation, column filter or HTTP constraint includes the real resource.",{"_2802":606,"_24443":444,"_17120":41651,"_5":17015,"_23194":41249,"_2329":41652},[],"In the `authz` logs, an external endpoint decision includes `allowed`, `reason`, `matched_principals`, `evaluated_policy_ids`, `matched_policy_id` and the status code. These fields let you separate a matching failure from a permissions failure. With OpenTelemetry instrumentation enabled, each decision also produces a span — `engine.CheckHTTP` on the Gateway path — whose attributes record `authz.allowed`, the matched policy and the matched principal, so you can correlate the denial with the Gateway trace.",{"_2802":607,"_24443":444,"_17120":41654,"_5":17015,"_23194":41253,"_2329":41655},[],"Check that the bootstrap principal was created and that the policies were preloaded by the migration Job. Also verify that `services.authz.jwkUrl` is reachable from the `authz` pod; do not assume that a URL accessible from the browser also works inside the cluster.",{"_2802":608,"_24443":444,"_17120":41657,"_5":17015,"_23194":41257,"_2329":41658},[],"The path may be covered by a schema-level decision rather than by a policy: routes marked `skip_authz` allow any identity that matches an active principal, and a request under a `base_paths` prefix whose schema sets `default_action: allow` is likewise allowed without consulting policies. Confirm which of the two applies before looking for missing or misassigned grants.",{"_2802":609,"_24443":444,"_17120":41660,"_5":17015,"_23194":41261,"_2329":41661},[],"This is the expected behavior with `failOpen: false`. Restore the service, its PostgreSQL connection and its JWKS connectivity. Do not temporarily switch to `failOpen: true` without accepting that protected routes could become accessible without an authorization decision.",{"_2802":610,"_24443":444,"_17120":41663,"_5":17015,"_23194":41261,"_2329":41664},[],"Continue with Audit logs to investigate configuration changes or with Troubleshooting to diagnose the deployment.",{"_2802":611,"_24443":611,"_5":12033,"_2329":41666,"_24758":41667,"_17120":41668,"_23194":611},"Alerts and subscriptions",[39790,41134,41135],[],{"_2802":612,"_24443":611,"_17120":41670,"_5":17015,"_23194":611,"_2329":41671},[],"Send PKI events to people and external systems.",{"_2802":613,"_24443":611,"_5":24755,"_17120":41673,"_23194":41674,"_2329":41675},[],"/docs/platform/administration/alerts#how-it-works","How it works",{"_2802":614,"_24443":611,"_5":24755,"_17120":41677,"_23194":41678,"_2329":41679},[],"/docs/platform/administration/alerts#available-channels","Available channels",{"_2802":615,"_24443":611,"_5":24755,"_17120":41681,"_23194":41682,"_2329":41683},[],"/docs/platform/administration/alerts#create-a-subscription","Create a subscription",{"_2802":616,"_24443":611,"_5":24755,"_17120":41685,"_23194":41686,"_2329":41687},[],"/docs/platform/administration/alerts#choose-the-event","Choose the event",{"_2802":617,"_24443":611,"_5":24755,"_17120":41689,"_23194":41690,"_2329":41691},[],"/docs/platform/administration/alerts#configure-the-destination","Configure the destination",{"_2802":618,"_24443":611,"_5":24755,"_17120":41693,"_23194":41694,"_2329":41695},[],"/docs/platform/administration/alerts#limit-the-notifications","Limit the notifications",{"_2802":619,"_24443":611,"_5":24755,"_17120":41697,"_23194":41698,"_2329":41699},[],"/docs/platform/administration/alerts#review-and-activate","Review and activate",{"_2802":620,"_24443":611,"_5":24755,"_17120":41701,"_23194":41702,"_2329":41703},[],"/docs/platform/administration/alerts#manage-a-subscription","Manage a subscription",{"_2802":621,"_24443":611,"_5":24755,"_17120":41705,"_23194":41706,"_2329":41707},[],"/docs/platform/administration/alerts#event-families","Event families",{"_2802":622,"_24443":611,"_17120":41709,"_5":17015,"_23194":611,"_2329":41710},[],"Subscriptions turn Lamassu events into actionable notifications. You can alert a team, feed an incident system or trigger an automation when a CA, certificate or device changes.",{"_2802":623,"_24443":611,"_17120":41712,"_5":17015,"_23194":41674,"_2329":41713},[],"A service publishes a domain event.",{"_2802":624,"_24443":611,"_17120":41715,"_5":17015,"_23194":41674,"_2329":41716},[],"Lamassu evaluates the subscriptions associated with that event type.",{"_2802":625,"_24443":611,"_17120":41718,"_5":17015,"_23194":41674,"_2329":41719},[],"Each subscription's filter decides whether it should be notified.",{"_2802":626,"_24443":611,"_17120":41721,"_5":17015,"_23194":41674,"_2329":41722},[],"Lamassu delivers the event to the configured channel.",{"_2802":627,"_24443":611,"_17120":41724,"_5":17015,"_23194":41674,"_2329":41725},[],"The event inventory shows when each type was last observed, how many times it has occurred and how many subscriptions it has. You can expand an event to inspect an example of its JSON payload before creating the filter.",{"_2802":628,"_24443":611,"_17120":41727,"_5":17015,"_23194":41678,"_2329":41728},[],"**Email** sends alerts to a person or an operational list. It only requires the destination address.",{"_2802":629,"_24443":611,"_17120":41730,"_5":17015,"_23194":41678,"_2329":41731},[],"**Microsoft Teams** posts the notification to a channel through its webhook URL.",{"_2802":630,"_24443":611,"_17120":41733,"_5":17015,"_23194":41678,"_2329":41734},[],"**Webhook** delivers the event to an automation, SIEM or incident system via `POST` or `PUT`.",{"_2802":631,"_24443":611,"_17120":41736,"_5":17015,"_23194":41686,"_2329":41737},[],"Open **Alerts**, locate the event type and select **Subscribe**. Review the latest JSON example to identify the fields you will need to filter on.",{"_2802":632,"_24443":611,"_17120":41739,"_5":17015,"_23194":41690,"_2329":41740},[],"Select Email, Microsoft Teams or Webhook and enter the channel details.",{"_2802":633,"_24443":611,"_17120":41742,"_5":17015,"_23194":41694,"_2329":41743},[],"Add a filter if you don't want to receive every instance of the event.",{"_2802":634,"_24443":611,"_17120":41745,"_5":17015,"_23194":41694,"_2329":41746},[],"**None** notifies all instances of the event.",{"_2802":635,"_24443":611,"_17120":41748,"_5":17015,"_23194":41694,"_2329":41749},[],"**JSON Path** evaluates one or more specific fields.",{"_2802":636,"_24443":611,"_17120":41751,"_5":17015,"_23194":41694,"_2329":41752},[],"**JSON Schema** accepts only payloads with a particular structure.",{"_2802":637,"_24443":611,"_17120":41754,"_5":17015,"_23194":41694,"_2329":41755},[],"**JavaScript** lets you express custom logic.",{"_2802":638,"_24443":611,"_17120":41757,"_5":17015,"_23194":41694,"_2329":41758},[],"For example, `function (event) { return event.data.status == \"NO_IDENTITY\"; }` limits a subscription to devices without an identity.",{"_2802":639,"_24443":611,"_17120":41760,"_5":17015,"_23194":41698,"_2329":41761},[],"Check the event, channel and filter in the summary. Select **Confirm Subscription** to start delivery.",{"_2802":640,"_24443":611,"_17120":41763,"_5":17015,"_23194":41702,"_2329":41764},[],"Open an existing subscription to review its destination and filter, modify the configuration or select **Unsubscribe**. Remove subscriptions that no longer have an operational owner to avoid ignored deliveries or stale endpoints.",{"_2802":641,"_24443":611,"_17120":41766,"_5":17015,"_23194":41706,"_2329":41767},[],"**Authorities:** `ca.create`, `ca.import`, `ca.reissue` and `ca.delete`.",{"_2802":642,"_24443":611,"_17120":41769,"_5":17015,"_23194":41706,"_2329":41770},[],"**Certificates:** `ca.sign.certificate` and `certificate.delete`.",{"_2802":643,"_24443":611,"_17120":41772,"_5":17015,"_23194":41706,"_2329":41773},[],"**Profiles:** `profile.create`, `profile.update` and `profile.delete`.",{"_2802":644,"_24443":611,"_17120":41775,"_5":17015,"_23194":41706,"_2329":41776},[],"**Enrollment:** `dms.create`, `dms.update`, `dms.enroll` and `dms.reenroll`.",{"_2802":645,"_24443":611,"_17120":41778,"_5":17015,"_23194":41706,"_2329":41779},[],"**Devices:** `device.create`, `device.identity.update` and `device.status.update`.",{"_2802":646,"_24443":611,"_17120":41781,"_5":17015,"_23194":41706,"_2329":41782},[],"**Validation:** `va.role.crl.create`.",{"_2802":647,"_24443":611,"_17120":41784,"_5":17015,"_23194":41706,"_2329":41785},[],"**Keys:** `kms.create`, `kms.import`, `kms.sign.message` and `kms.delete`.",{"_2802":648,"_24443":611,"_17120":41787,"_5":17015,"_23194":41706,"_2329":41788},[],"Use the catalog shown in the console as the source for the types available in your deployed version.",{"_2802":649,"_24443":649,"_5":12033,"_2329":41790,"_24758":41791,"_17120":41792,"_23194":649},"Audit logs",[39790,41134,41135],[],{"_2802":650,"_24443":649,"_17120":41794,"_5":17015,"_23194":649,"_2329":41795},[],"Understand which audit events Lamassu generates and how to turn them into a durable trail.",{"_2802":651,"_24443":649,"_5":24755,"_17120":41797,"_23194":41798,"_2329":41799},[],"/docs/platform/administration/audit-logs#what-an-event-contains","What an event contains",{"_2802":652,"_24443":649,"_5":24755,"_17120":41801,"_23194":41802,"_2329":41803},[],"/docs/platform/administration/audit-logs#coverage","Coverage",{"_2802":653,"_24443":649,"_5":24755,"_17120":41805,"_23194":41806,"_2329":41807},[],"/docs/platform/administration/audit-logs#publication-and-persistence","Publication and persistence",{"_2802":654,"_24443":649,"_5":24755,"_17120":41809,"_23194":41810,"_2329":41811},[],"/docs/platform/administration/audit-logs#sensitive-data","Sensitive data",{"_2802":655,"_24443":649,"_5":24755,"_17120":41813,"_23194":41814,"_2329":41815},[],"/docs/platform/administration/audit-logs#a-reproducible-investigation","A reproducible investigation",{"_2802":656,"_24443":649,"_5":24755,"_17120":41817,"_23194":41818,"_2329":41819},[],"/docs/platform/administration/audit-logs#bound-the-interval","Bound the interval",{"_2802":657,"_24443":649,"_5":24755,"_17120":41821,"_23194":41822,"_2329":41823},[],"/docs/platform/administration/audit-logs#identify-the-operation","Identify the operation",{"_2802":658,"_24443":649,"_5":24755,"_17120":41825,"_23194":41826,"_2329":41827},[],"/docs/platform/administration/audit-logs#attribute-the-principal","Attribute the principal",{"_2802":659,"_24443":649,"_5":24755,"_17120":41829,"_23194":41830,"_2329":41831},[],"/docs/platform/administration/audit-logs#compare-intent-and-result","Compare intent and result",{"_2802":660,"_24443":649,"_5":24755,"_17120":41833,"_23194":41834,"_2329":41835},[],"/docs/platform/administration/audit-logs#follow-the-effect","Follow the effect",{"_2802":661,"_24443":649,"_5":24755,"_17120":41837,"_23194":41838,"_2329":41839},[],"/docs/platform/administration/audit-logs#periodic-verification","Periodic verification",{"_2802":662,"_24443":649,"_17120":41841,"_5":17015,"_23194":649,"_2329":41842},[],"Lamassu instruments the mutable operations of its services with audit events. Each event describes the operation, the principals that matched, the input, the result and whether it ended in error.",{"_2802":663,"_24443":649,"_17120":41844,"_5":17015,"_23194":41798,"_2329":41845},[],"The audit body includes:",{"_2802":664,"_24443":649,"_17120":41847,"_5":17015,"_23194":41798,"_2329":41848},[],"input: data received by the operation;",{"_2802":665,"_24443":649,"_17120":41850,"_5":17015,"_23194":41798,"_2329":41851},[],"has\\_error: whether the service returned an error;",{"_2802":666,"_24443":649,"_17120":41853,"_5":17015,"_23194":41798,"_2329":41854},[],"output: produced result or error message;",{"_2802":667,"_24443":649,"_17120":41856,"_5":17015,"_23194":41798,"_2329":41857},[],"principals: identifiers of the principals that matched the request.",{"_2802":668,"_24443":649,"_17120":41859,"_5":17015,"_23194":41798,"_2329":41860},[],"Successful operations use a type prefixed with audit.. Failures publish the operation type suffixed with .error. The CloudEvents event additionally adds source, identifier, date and type.",{"_2802":669,"_24443":649,"_17120":41862,"_5":17015,"_23194":41798,"_2329":41863},[],"The middlewares publish the record after executing the operation, whether it succeeded or returned an error. This lets you investigate attempts as well as confirmed changes.",{"_2802":670,"_24443":649,"_17120":41865,"_5":17015,"_23194":41802,"_2329":41866},[],"The backend applies auditing to mutations of:",{"_2802":671,"_24443":649,"_17120":41868,"_5":17015,"_23194":41802,"_2329":41869},[],"authorities, certificates and issuance profiles;",{"_2802":672,"_24443":649,"_17120":41871,"_5":17015,"_23194":41802,"_2329":41872},[],"keys and KMS engines;",{"_2802":673,"_24443":649,"_17120":41874,"_5":17015,"_23194":41802,"_2329":41875},[],"devices and identities;",{"_2802":674,"_24443":649,"_17120":41877,"_5":17015,"_23194":41802,"_2329":41878},[],"DMSs and enrollment operations;",{"_2802":675,"_24443":649,"_17120":41880,"_5":17015,"_23194":41802,"_2329":41881},[],"validation functions and CRL;",{"_2802":676,"_24443":649,"_17120":41883,"_5":17015,"_23194":41802,"_2329":41884},[],"principals, policies and authorization grants.",{"_2802":677,"_24443":649,"_17120":41886,"_5":17015,"_23194":41802,"_2329":41887},[],"Do not confuse these events with domain events. A domain event announces that a resource changed so another component can react; the audit event keeps input, output and principal context for investigation.",{"_2802":678,"_24443":649,"_17120":41889,"_5":17015,"_23194":41806,"_2329":41890},[],"Services publish audit records to the event bus when their PublisherEventBus is enabled. The backend code does not, by itself, implement a queryable, durable audit file.",{"_2802":679,"_24443":649,"_17120":41892,"_5":17015,"_23194":41806,"_2329":41893},[],"If you need retention, search, tamper protection or regulatory export, connect a consumer that persists the events into the system approved by your organization.",{"_2802":680,"_24443":649,"_17120":41895,"_5":17015,"_23194":41806,"_2329":41896},[],"Design the consumer to:",{"_2802":681,"_24443":649,"_17120":41898,"_5":17015,"_23194":41806,"_2329":41899},[],"subscribe to the audit.# types and also to operation types ending in .error;",{"_2802":682,"_24443":649,"_17120":41901,"_5":17015,"_23194":41806,"_2329":41902},[],"keep the complete CloudEvent unmodified;",{"_2802":683,"_24443":649,"_17120":41904,"_5":17015,"_23194":41806,"_2329":41905},[],"record the ingestion time and detect duplicates by ID;",{"_2802":684,"_24443":649,"_17120":41907,"_5":17015,"_23194":41806,"_2329":41908},[],"encrypt in transit and at rest;",{"_2802":685,"_24443":649,"_17120":41910,"_5":17015,"_23194":41806,"_2329":41911},[],"restrict reading and deletion to a role separate from the PKI operator;",{"_2802":686,"_24443":649,"_17120":41913,"_5":17015,"_23194":41806,"_2329":41914},[],"apply an explicit retention and legal hold policy;",{"_2802":687,"_24443":649,"_17120":41916,"_5":17015,"_23194":41806,"_2329":41917},[],"alert if it stops consuming or the pending queue grows.",{"_2802":688,"_24443":649,"_17120":41919,"_5":17015,"_23194":41810,"_2329":41920},[],"The input and output fields can contain subjects, metadata, public material, configuration or error messages. Evaluate their classification before sending them to an external platform.",{"_2802":689,"_24443":649,"_17120":41922,"_5":17015,"_23194":41810,"_2329":41923},[],"Do not log private keys, provider secrets or full tokens in automations around Lamassu. Restrict export and apply redaction at the destination without destroying the fields needed for attribution.",{"_2802":690,"_24443":649,"_17120":41925,"_5":17015,"_23194":41818,"_2329":41926},[],"Start from the reported time and normalize every source to UTC.",{"_2802":691,"_24443":649,"_17120":41928,"_5":17015,"_23194":41822,"_2329":41929},[],"Filter by event type, service source and resource identifier.",{"_2802":692,"_24443":649,"_17120":41931,"_5":17015,"_23194":41826,"_2329":41932},[],"Review principals and correlate them with the OIDC provider or the X.509 identity valid at that moment.",{"_2802":693,"_24443":649,"_17120":41934,"_5":17015,"_23194":41830,"_2329":41935},[],"Contrast input, has\\_error and output. A failed attempt does not mean the resource changed.",{"_2802":694,"_24443":649,"_17120":41937,"_5":17015,"_23194":41834,"_2329":41938},[],"Look for the domain events and service records that share resource and time window. In a CA revocation, include the cascading operations.",{"_2802":695,"_24443":649,"_17120":41940,"_5":17015,"_23194":41838,"_2329":41941},[],"Generate a controlled mutation in a test environment and check that:",{"_2802":696,"_24443":649,"_17120":41943,"_5":17015,"_23194":41838,"_2329":41944},[],"a successful audit event appears;",{"_2802":697,"_24443":649,"_17120":41946,"_5":17015,"_23194":41838,"_2329":41947},[],"the principal matches the identity used;",{"_2802":698,"_24443":649,"_17120":41949,"_5":17015,"_23194":41838,"_2329":41950},[],"the consumer persists it exactly once;",{"_2802":699,"_24443":649,"_17120":41952,"_5":17015,"_23194":41838,"_2329":41953},[],"it can be retrieved by resource, actor and period;",{"_2802":700,"_24443":649,"_17120":41955,"_5":17015,"_23194":41838,"_2329":41956},[],"a consumer outage raises an alert.",{"_2802":701,"_24443":649,"_17120":41958,"_5":17015,"_23194":41838,"_2329":41959},[],"For metrics, traces and technical logs of the deployment, see Troubleshooting. Audit answers \"who tried to change what\"; observability explains how the system behaved.",{"_2802":702,"_24443":702,"_5":12033,"_2329":41961,"_24758":41962,"_17120":41963,"_23194":702},"Platform architecture",[39790,41134],[],{"_2802":703,"_24443":702,"_17120":41965,"_5":17015,"_23194":702,"_2329":41966},[],"Lamassu components and how control, keys, issuance and devices relate.",{"_2802":704,"_24443":702,"_5":24755,"_17120":41968,"_23194":41969,"_2329":41970},[],"/docs/platform/concepts/architecture#control-plane","Control plane",{"_2802":705,"_24443":702,"_5":24755,"_17120":41972,"_23194":41973,"_2329":41974},[],"/docs/platform/concepts/architecture#key-custody-and-cryptographic-operations","Key custody and cryptographic operations",{"_2802":706,"_24443":702,"_5":24755,"_17120":41976,"_23194":41977,"_2329":41978},[],"/docs/platform/concepts/architecture#issuance-and-enrollment","Issuance and enrollment",{"_2802":707,"_24443":702,"_5":24755,"_17120":41980,"_23194":41981,"_2329":41982},[],"/docs/platform/concepts/architecture#status-and-validation","Status and validation",{"_2802":708,"_24443":702,"_5":24755,"_17120":41984,"_23194":41985,"_2329":41986},[],"/docs/platform/concepts/architecture#platform-dependencies","Platform dependencies",{"_2802":709,"_24443":702,"_17120":41988,"_5":17015,"_23194":702,"_2329":41989},[],"Lamassu deploys as a set of independent services. This separation keeps every component from needing direct access to private keys and lets each capability scale according to load.",{"_2802":710,"_24443":702,"_17120":41991,"_5":17015,"_23194":702,"_2329":41992},[],"Switch to the low level to see the internals of the Lamassu platform box (CA, KMS, DMS, Device Manager, VA, Alerts, AWS IoT connector, Job Manager and the console/API), and to medium to see it as a single platform alongside its external dependencies.",{"_2802":711,"_24443":702,"_17120":41994,"_5":17015,"_23194":41969,"_2329":41995},[],"The console and the APIs manage authorities, certificates, DMSs, devices, alerts and configuration. Domain events allow connectors and automations to react to changes without continuously polling the platform.",{"_2802":712,"_24443":702,"_17120":41997,"_5":17015,"_23194":41973,"_2329":41998},[],"The KMS offers a common interface over software engines, PKCS#11 and cloud providers. The selected engine keeps the key or delegates the cryptographic operation without the other services knowing its implementation.",{"_2802":713,"_24443":702,"_17120":42000,"_5":17015,"_23194":41977,"_2329":42001},[],"The CA service issues certificates and maintains the relationship with its authority. The DMS applies the enrollment rules and exposes the EST flows so a device can request or renew an identity.",{"_2802":714,"_24443":702,"_17120":42003,"_5":17015,"_23194":41981,"_2329":42004},[],"Device Manager keeps the operational view of the device and its history. The Validation Authority publishes OCSP and CRLs so other systems can decide whether to trust a presented certificate.",{"_2802":715,"_24443":702,"_17120":42006,"_5":17015,"_23194":41985,"_2329":42007},[],"In a self-managed deployment, Lamassu uses PostgreSQL for persistence, RabbitMQ for messaging and an OIDC provider for authentication. See the deployment architecture for how the services are published on Kubernetes.",{"_2802":716,"_24443":716,"_5":12033,"_2329":42009,"_24758":42010,"_17120":42011,"_23194":716},"How Lamassu works",[39790,41134],[],{"_2802":717,"_24443":716,"_17120":42013,"_5":17015,"_23194":716,"_2329":42014},[],"The mental model of trust, keys, certificates and devices.",{"_2802":718,"_24443":716,"_5":24755,"_17120":42016,"_23194":42017,"_2329":42018},[],"/docs/platform/concepts/overview#the-model-in-five-pieces","The model in five pieces",{"_2802":719,"_24443":716,"_5":24755,"_17120":42020,"_23194":42021,"_2329":42022},[],"/docs/platform/concepts/overview#from-onboarding-to-operation","From onboarding to operation",{"_2802":720,"_24443":716,"_17120":42024,"_5":17015,"_23194":716,"_2329":42025},[],"Lamassu connects three elements: a **root of trust**, an **issuance policy** and an **entity that needs to prove its identity**. The platform coordinates these elements throughout the certificate lifecycle.",{"_2802":721,"_24443":716,"_17120":42027,"_5":17015,"_23194":42017,"_2329":42028},[],"**Cryptographic engine.** Generates or safeguards keys and executes private-key operations without exposing key material to the rest of the services.",{"_2802":722,"_24443":716,"_17120":42030,"_5":17015,"_23194":42017,"_2329":42031},[],"**Certification Authority (CA).** Signs certificates and establishes the chain of trust.",{"_2802":723,"_24443":716,"_17120":42033,"_5":17015,"_23194":42017,"_2329":42034},[],"**Device Management Service (DMS).** Defines how the devices of a fleet are registered, authenticated and renewed.",{"_2802":724,"_24443":716,"_17120":42036,"_5":17015,"_23194":42017,"_2329":42037},[],"**Device.** Keeps its private key and presents the certificate to prove its identity.",{"_2802":725,"_24443":716,"_17120":42039,"_5":17015,"_23194":42017,"_2329":42040},[],"**Validation Authority (VA).** Publishes the status of certificates through OCSP and CRL.",{"_2802":726,"_24443":716,"_17120":42042,"_5":17015,"_23194":42021,"_2329":42043},[],"An administrator configures a cryptographic engine and creates or imports a CA.",{"_2802":727,"_24443":716,"_17120":42045,"_5":17015,"_23194":42021,"_2329":42046},[],"A DMS relates that CA to an enrollment policy.",{"_2802":728,"_24443":716,"_17120":42048,"_5":17015,"_23194":42021,"_2329":42049},[],"The device generates a key and requests a certificate through EST, or an operator assigns it an identity.",{"_2802":729,"_24443":716,"_17120":42051,"_5":17015,"_23194":42021,"_2329":42052},[],"Lamassu keeps the inventory, history and status of the identity.",{"_2802":730,"_24443":716,"_17120":42054,"_5":17015,"_23194":42021,"_2329":42055},[],"Consumers check the chain and query OCSP or a CRL when they need to know whether it is still valid.",{"_2802":731,"_24443":716,"_17120":42057,"_5":17015,"_23194":42021,"_2329":42058},[],"<Card title=\"Architecture\" description=\"Get to know the components and where each one's responsibility ends.\" href=\"/docs/platform/concepts/architecture\" />",{"_2802":732,"_24443":716,"_17120":42060,"_5":17015,"_23194":42021,"_2329":42061},[],"<Card title=\"Identity lifecycle\" description=\"Follow a certificate from enrollment to renewal or revocation.\" href=\"/docs/platform/pki/concepts/certificate-lifecycle\" />",{"_2802":733,"_24443":733,"_5":12033,"_2329":42063,"_24758":42064,"_17120":42066,"_23194":733},"Devices and identities",[39790,41134,42065,42063],"IoT Fleets",[],{"_2802":734,"_24443":733,"_17120":42068,"_5":17015,"_23194":733,"_2329":42069},[],"Register, inspect and retire devices while checking their current identity and history.",{"_2802":735,"_24443":733,"_5":24755,"_17120":42071,"_23194":42072,"_2329":42073},[],"/docs/platform/iot-fleets/device-management#device-states","Device states",{"_2802":736,"_24443":733,"_5":24755,"_17120":42075,"_23194":42076,"_2329":42077},[],"/docs/platform/iot-fleets/device-management#inspect-a-device","Inspect a device",{"_2802":737,"_24443":733,"_5":24755,"_17120":42079,"_23194":42080,"_2329":42081},[],"/docs/platform/iot-fleets/device-management#register-a-device-manually","Register a device manually",{"_2802":738,"_24443":733,"_5":24755,"_17120":42083,"_23194":42084,"_2329":42085},[],"/docs/platform/iot-fleets/device-management#create-the-device","Create the device",{"_2802":739,"_24443":733,"_5":24755,"_17120":42087,"_23194":42088,"_2329":42089},[],"/docs/platform/iot-fleets/device-management#define-its-membership","Define its membership",{"_2802":740,"_24443":733,"_5":24755,"_17120":42091,"_23194":42092,"_2329":42093},[],"/docs/platform/iot-fleets/device-management#classify-the-device","Classify the device",{"_2802":741,"_24443":733,"_5":24755,"_17120":42095,"_23194":42096,"_2329":42097},[],"/docs/platform/iot-fleets/device-management#verify-the-registration","Verify the registration",{"_2802":742,"_24443":733,"_5":24755,"_17120":42099,"_23194":42100,"_2329":42101},[],"/docs/platform/iot-fleets/device-management#assign-an-identity-manually","Assign an identity manually",{"_2802":743,"_24443":733,"_5":24755,"_17120":42103,"_23194":42104,"_2329":42105},[],"/docs/platform/iot-fleets/device-management#revoke-the-current-identity","Revoke the current identity",{"_2802":744,"_24443":733,"_5":24755,"_17120":42107,"_23194":42108,"_2329":42109},[],"/docs/platform/iot-fleets/device-management#decommission-a-device","Decommission a device",{"_2802":745,"_24443":733,"_5":24755,"_17120":42111,"_23194":42112,"_2329":42113},[],"/docs/platform/iot-fleets/device-management#automate-enrollment","Automate enrollment",{"_2802":746,"_24443":733,"_17120":42115,"_5":17015,"_23194":733,"_2329":42116},[],"This guide is for a fleet operator. You need device, DMS and certificate permissions for the intended actions. A fleet is organized through these resources, tags and metadata; there is no separate “fleet” object to create.",{"_2802":747,"_24443":733,"_17120":42118,"_5":17015,"_23194":733,"_2329":42119},[],"Each device has a `Device ID`, one owning DMS (`dms_owner`) and, once provisioned, an identity slot with an active version and previous versions. In these flows, keep the CSR and certificate `Common Name` equal to `Device ID`: binding uses that CN to update the device.",{"_2802":748,"_24443":733,"_17120":42121,"_5":17015,"_23194":42072,"_2329":42122},[],"Operational view",{"_2802":749,"_24443":733,"_17120":42124,"_5":17015,"_23194":42072,"_2329":42125},[],"Meaning",{"_2802":750,"_24443":733,"_17120":42127,"_5":17015,"_23194":42072,"_2329":42128},[],"**No Identity**",{"_2802":751,"_24443":733,"_17120":42130,"_5":17015,"_23194":42072,"_2329":42131},[],"A record exists without an associated identity.",{"_2802":752,"_24443":733,"_17120":42133,"_5":17015,"_23194":42072,"_2329":42134},[],"**Active**",{"_2802":753,"_24443":733,"_17120":42136,"_5":17015,"_23194":42072,"_2329":42137},[],"The slot is active; also check certificate dates, status and usages.",{"_2802":754,"_24443":733,"_17120":42139,"_5":17015,"_23194":42072,"_2329":42140},[],"**Renewal Pending**",{"_2802":755,"_24443":733,"_17120":42142,"_5":17015,"_23194":42072,"_2329":42143},[],"The identity is in the operational renewal window.",{"_2802":756,"_24443":733,"_17120":42145,"_5":17015,"_23194":42072,"_2329":42146},[],"**Expiring Soon**",{"_2802":757,"_24443":733,"_17120":42148,"_5":17015,"_23194":42072,"_2329":42149},[],"Expiration is approaching according to configured thresholds.",{"_2802":758,"_24443":733,"_17120":42151,"_5":17015,"_23194":42072,"_2329":42152},[],"**Expired**",{"_2802":759,"_24443":733,"_17120":42154,"_5":17015,"_23194":42072,"_2329":42155},[],"The identity has expired.",{"_2802":760,"_24443":733,"_17120":42157,"_5":17015,"_23194":42072,"_2329":42158},[],"**Revoked**",{"_2802":761,"_24443":733,"_17120":42160,"_5":17015,"_23194":42072,"_2329":42161},[],"The identity is marked revoked.",{"_2802":762,"_24443":733,"_17120":42163,"_5":17015,"_23194":42072,"_2329":42164},[],"**Decommissioned**",{"_2802":763,"_24443":733,"_17120":42166,"_5":17015,"_23194":42072,"_2329":42167},[],"The record is retired and ordinary updates do not restore operation.",{"_2802":764,"_24443":733,"_17120":42169,"_5":17015,"_23194":42072,"_2329":42170},[],"Device, slot and certificate states are distinct. Events and jobs can update the view after saving a certificate; an **Active** label does not establish consumer acceptance.",{"_2802":765,"_24443":733,"_17120":42172,"_5":17015,"_23194":42076,"_2329":42173},[],"Filter the inventory by ID, tags and status. Open details and record the owning DMS, active version and current certificate serial.",{"_2802":766,"_24443":733,"_17120":42175,"_5":17015,"_23194":42076,"_2329":42176},[],"**Certificate History** relates previous and current versions. Replacing the slot does not by itself revoke every previous version.",{"_2802":767,"_24443":733,"_17120":42178,"_5":17015,"_23194":42076,"_2329":42179},[],"**Device Event Timeline** helps reconstruct registration, provisioning, renewal and status changes. A change may be saved even if event persistence fails; also inspect the record and certificates.",{"_2802":768,"_24443":733,"_17120":42181,"_5":17015,"_23194":42076,"_2329":42182},[],"Compare these values with the identity installed on the device. Updating a Lamassu slot does not install files on the remote equipment.",{"_2802":769,"_24443":733,"_17120":42184,"_5":17015,"_23194":42080,"_2329":42185},[],"Use this flow to prepare inventory or assign an identity through the console. You need an existing DMS.",{"_2802":770,"_24443":733,"_17120":42187,"_5":17015,"_23194":42084,"_2329":42188},[],"Open registration in **Managed Devices**. Confirm the ID does not already exist in another DMS: ID lookup is not restricted to a fleet.",{"_2802":771,"_24443":733,"_17120":42190,"_5":17015,"_23194":42088,"_2329":42191},[],"Enter **Device ID** and select its owning DMS. The console’s **Registration Authority** label refers to that DMS.",{"_2802":772,"_24443":733,"_17120":42193,"_5":17015,"_23194":42092,"_2329":42194},[],"Add model, environment or location tags and an icon according to your inventory.",{"_2802":773,"_24443":733,"_17120":42196,"_5":17015,"_23194":42096,"_2329":42197},[],"Read the device again: require the intended DMS and **No Identity**. Follow Manual registration to complete assignment.",{"_2802":774,"_24443":733,"_17120":42199,"_5":17015,"_23194":42096,"_2329":42200},[],"Preregistration does not establish that `/simpleenroll` will admit the request. Review its interaction with `enable_replaceable_enrollment` in Provisioning strategies.",{"_2802":775,"_24443":733,"_17120":42202,"_5":17015,"_23194":42100,"_2329":42203},[],"From **No Identity**, use **Assign Identity**:",{"_2802":776,"_24443":733,"_17120":42205,"_5":17015,"_23194":42100,"_2329":42206},[],"Select an active, current certificate suitable for the consumer, with `CN` exactly equal to `Device ID`.",{"_2802":777,"_24443":733,"_17120":42208,"_5":17015,"_23194":42100,"_2329":42209},[],"If unavailable, **Issue New Instead** starts issuance using the intended CA. Review the profile first.",{"_2802":778,"_24443":733,"_17120":42211,"_5":17015,"_23194":42100,"_2329":42212},[],"Confirm and read the serial, active version and history again.",{"_2802":779,"_24443":733,"_17120":42214,"_5":17015,"_23194":42100,"_2329":42215},[],"Install the key/certificate pair and required intermediates on the device and test usage.",{"_2802":780,"_24443":733,"_17120":42217,"_5":17015,"_23194":42100,"_2329":42218},[],"Issuing, binding and installing are separate steps. If an operation fails, check which steps persisted before repeating it.",{"_2802":781,"_24443":733,"_17120":42220,"_5":17015,"_23194":42104,"_2329":42221},[],"Locate the active serial in history and revoke it with an appropriate reason. Verify the record, OCSP/CRL publication and rejection of a new consumer connection using the certificate guide.",{"_2802":782,"_24443":733,"_17120":42223,"_5":17015,"_23194":42104,"_2329":42224},[],"Revocation does not remove the device. It does not automatically enable another enrollment either: recovery depends on its credential, status and DMS policy. `CertificateHold` can be reactivated under PKI conditions; other reasons block subsequent certificate changes.",{"_2802":783,"_24443":733,"_17120":42226,"_5":17015,"_23194":42108,"_2329":42227},[],"Before **Decommission**, inventory active and previous identities, connections and destination permissions. Prepare retirement in the consumer.",{"_2802":784,"_24443":733,"_17120":42229,"_5":17015,"_23194":42108,"_2329":42230},[],"The backend saves **Decommissioned** and attempts to revoke the active version’s certificate with `CessationOfOperation` if the slot was not expired or revoked. It does not traverse all history. Deferred revocation can fail after retirement is saved; check the result by serial.",{"_2802":785,"_24443":733,"_17120":42232,"_5":17015,"_23194":42108,"_2329":42233},[],"Retired status protects ordinary device and slot updates. It does not guarantee that every EST request is rejected before issuance: binding can skip a retired device without returning an error. Check for remaining usable certificates or permissions and block new admission in the relevant control.",{"_2802":786,"_24443":733,"_17120":42235,"_5":17015,"_23194":42108,"_2329":42236},[],"Retain records according to audit policy. Do not reuse a retired ID to hide an equipment change.",{"_2802":787,"_24443":733,"_17120":42238,"_5":17015,"_23194":42112,"_2329":42239},[],"<Card title=\"Enroll and connect a device\" description=\"Obtain an identity from the client and test mTLS.\" href=\"/docs/platform/iot-fleets/quickstarts/enroll-device\" />",{"_2802":788,"_24443":733,"_17120":42241,"_5":17015,"_23194":42112,"_2329":42242},[],"<Card title=\"Renewal and recovery\" description=\"Install the successor and handle failures without losing known state.\" href=\"/docs/platform/iot-fleets/enrollment/renewal-and-recovery\" />",{"_2802":789,"_24443":789,"_5":12033,"_2329":42244,"_24758":42245,"_17120":42247,"_23194":789},"Bootstrap identity and authentication",[39790,41134,42065,42063,42246],"Enrollment with PKI",[],{"_2802":790,"_24443":789,"_17120":42249,"_5":17015,"_23194":789,"_2329":42250},[],"Prepare server trust and admission proofs for enroll and reenroll.",{"_2802":791,"_24443":789,"_5":24755,"_17120":42252,"_23194":42253,"_2329":42254},[],"/docs/platform/iot-fleets/enrollment/bootstrap-identity#initial-server-trust","Initial server trust",{"_2802":792,"_24443":789,"_5":24755,"_17120":42256,"_23194":42257,"_2329":42258},[],"/docs/platform/iot-fleets/enrollment/bootstrap-identity#bootstrap-credential","Bootstrap credential",{"_2802":793,"_24443":789,"_5":24755,"_17120":42260,"_23194":42261,"_2329":42262},[],"/docs/platform/iot-fleets/enrollment/bootstrap-identity#modes-per-operation","Modes per operation",{"_2802":794,"_24443":789,"_5":24755,"_17120":42264,"_23194":42265,"_2329":42266},[],"/docs/platform/iot-fleets/enrollment/bootstrap-identity#webhook-contract","Webhook contract",{"_2802":795,"_24443":789,"_5":24755,"_17120":42268,"_23194":42269,"_2329":42270},[],"/docs/platform/iot-fleets/enrollment/bootstrap-identity#revocation-and-checks","Revocation and checks",{"_2802":796,"_24443":789,"_17120":42272,"_5":17015,"_23194":789,"_2329":42273},[],"This guide connects the DMS administrator with device manufacturing and integration. Before requesting an operational identity, the client must authenticate the EST server and establish entitlement to request the intended ID.",{"_2802":797,"_24443":789,"_17120":42275,"_5":17015,"_23194":42253,"_2329":42276},[],"Install a previously verified root, chain or pin through a trusted channel: manufacturing, approved configuration or authenticated distribution. It enables TLS and server-name verification before downloading `/cacerts`.",{"_2802":798,"_24443":789,"_17120":42278,"_5":17015,"_23194":42253,"_2329":42279},[],"Your only trust proof cannot come from the same unauthenticated server. The EST server TLS certificate, bootstrap certificate and operational identity issuer may belong to different hierarchies.",{"_2802":799,"_24443":789,"_17120":42281,"_5":17015,"_23194":42257,"_2329":42282},[],"With `CLIENT_CERTIFICATE`, the device presents its initial certificate and proves key possession through TLS. The DMS validates it against admission CAs. In the inspected flow, the validator receives one leaf credential: configure and test the direct issuer for the simple case; sending more intermediates does not establish delivery to the service.",{"_2802":800,"_24443":789,"_17120":42284,"_5":17015,"_23194":42257,"_2329":42285},[],"Check dates, matching certificate/key and revocation before provisioning. A credential shared across equipment identifies that shared credential, not an individual device.",{"_2802":801,"_24443":789,"_17120":42287,"_5":17015,"_23194":42257,"_2329":42288},[],"Initial mTLS validation does not by itself compare bootstrap CN with the requested CSR CN. If a requester should only request its own `Device ID`, add a control binding credential to ID, such as the combined webhook, and test a request with another CN. Certificate re-enrollment does compare its CN to the CSR; subsequent checks use the registered active identity.",{"_2802":802,"_24443":789,"_17120":42290,"_5":17015,"_23194":42261,"_2329":42291},[],"Select the four modes independently for enrollment and re-enrollment in DMS. Renewal credentials depend on that block; do not assume the bootstrap is always used or the webhook disappears.",{"_2802":803,"_24443":789,"_17120":42293,"_5":17015,"_23194":42261,"_2329":42294},[],"An administrative OIDC token is not a native EST mode. A webhook may interpret an agreed credential header; that service then performs authorization. In NO\\_AUTH, sending a token does not add DMS authentication.",{"_2802":804,"_24443":789,"_17120":42296,"_5":17015,"_23194":42265,"_2329":42297},[],"The DMS sends operation context to the configured service. Method comes from configuration; agree the contract before selecting POST or PUT. Authorization wait defaults to 10 seconds, replaced by a configured positive timeout.",{"_2802":805,"_24443":789,"_17120":42299,"_5":17015,"_23194":42265,"_2329":42300},[],"Example body:",{"_2802":806,"_24443":789,"_17120":42302,"_5":17015,"_23194":42265,"_2329":42303},[],"`csr` is **base64 of PEM**, unlike the EST body, which is base64 of DER. `http_request` contains URL and first header entries from available HTTP context. This body does not include an `operation` field; distinguish enroll and reenroll through the path and configured policy.",{"_2802":807,"_24443":789,"_17120":42305,"_5":17015,"_23194":42265,"_2329":42306},[],"The webhook should verify credential, its relationship to `device_cn`, DMS, operation and admission policy. Forwarded headers are not themselves trusted evidence. **Lamassu-to-webhook authentication** is a separate relationship configured in the server’s HTTP client.",{"_2802":808,"_24443":789,"_17120":42308,"_5":17015,"_23194":42265,"_2329":42309},[],"Continuation requires a successful HTTP response and JSON:",{"_2802":809,"_24443":789,"_17120":42311,"_5":17015,"_23194":42265,"_2329":42312},[],"A bodyless `204` does not satisfy the contract. Denial, transport error, uninterpretable response or timeout abort authorization. Combined mode validates the certificate first, then queries the webhook. See the webhook specification.",{"_2802":810,"_24443":789,"_17120":42314,"_5":17015,"_23194":42269,"_2329":42315},[],"The DMS first looks up the certificate in Lamassu; for external certificates it attempts OCSP and CRL. If revocation cannot be checked, validators can continue treating it as not revoked. The code also does not establish rejection of every external status other than Good. Test required behavior with your actual credential and endpoint; do not present this as guaranteed strict enforcement across every source.",{"_2802":811,"_24443":789,"_17120":42317,"_5":17015,"_23194":42269,"_2329":42318},[],"Test an allowed certificate, an incorrect one, another CN, webhook denial, timeout and re-enrollment under its own policy. Keep results and schedule bootstrap credential retirement where appropriate. Continue with EST client.",{"_2802":812,"_24443":812,"_5":12033,"_2329":42320,"_24758":42321,"_17120":42322,"_23194":812},"Configure and operate the DMS",[39790,41134,42065,42063,42246],[],{"_2802":813,"_24443":812,"_17120":42324,"_5":17015,"_23194":812,"_2329":42325},[],"Define registration, authentication per operation, issuance, renewal and distributed trust.",{"_2802":814,"_24443":812,"_5":24755,"_17120":42327,"_23194":42328,"_2329":39800},[],"/docs/platform/iot-fleets/enrollment/dms#before-you-begin",{"_2802":815,"_24443":812,"_5":24755,"_17120":42330,"_23194":42331,"_2329":42332},[],"/docs/platform/iot-fleets/enrollment/dms#configure-a-dms","Configure a DMS",{"_2802":816,"_24443":812,"_5":24755,"_17120":42334,"_23194":42335,"_2329":42336},[],"/docs/platform/iot-fleets/enrollment/dms#identify-the-fleet","Identify the fleet",{"_2802":817,"_24443":812,"_5":24755,"_17120":42338,"_23194":42339,"_2329":42340},[],"/docs/platform/iot-fleets/enrollment/dms#select-the-enrollment-ca","Select the enrollment CA",{"_2802":818,"_24443":812,"_5":24755,"_17120":42342,"_23194":42343,"_2329":42344},[],"/docs/platform/iot-fleets/enrollment/dms#configure-est","Configure EST",{"_2802":819,"_24443":812,"_5":24755,"_17120":42346,"_23194":42347,"_2329":42348},[],"/docs/platform/iot-fleets/enrollment/dms#distribute-trust","Distribute trust",{"_2802":820,"_24443":812,"_5":24755,"_17120":42350,"_23194":42351,"_2329":42352},[],"/docs/platform/iot-fleets/enrollment/dms#verify-the-endpoints","Verify the endpoints",{"_2802":821,"_24443":812,"_5":24755,"_17120":42354,"_23194":42355,"_2329":42356},[],"/docs/platform/iot-fleets/enrollment/dms#enrollment-configuration","Enrollment configuration",{"_2802":822,"_24443":812,"_5":24755,"_17120":42358,"_23194":42359,"_2329":42360},[],"/docs/platform/iot-fleets/enrollment/dms#enrollment-device-registration","Enrollment Device Registration",{"_2802":823,"_24443":812,"_5":24755,"_17120":42362,"_23194":42363,"_2329":42364},[],"/docs/platform/iot-fleets/enrollment/dms#enrollment-settings","Enrollment Settings",{"_2802":824,"_24443":812,"_5":24755,"_17120":42366,"_23194":42367,"_2329":42368},[],"/docs/platform/iot-fleets/enrollment/dms#authentication-per-operation","Authentication per operation",{"_2802":825,"_24443":812,"_5":24755,"_17120":42370,"_23194":42371,"_2329":42372},[],"/docs/platform/iot-fleets/enrollment/dms#issuance-profile","Issuance profile",{"_2802":826,"_24443":812,"_5":24755,"_17120":42374,"_23194":42375,"_2329":42376},[],"/docs/platform/iot-fleets/enrollment/dms#re-enrollment-configuration","Re-enrollment configuration",{"_2802":827,"_24443":812,"_5":24755,"_17120":42378,"_23194":42379,"_2329":42380},[],"/docs/platform/iot-fleets/enrollment/dms#serverkeygen","ServerKeyGen",{"_2802":828,"_24443":812,"_5":24755,"_17120":42382,"_23194":42383,"_2329":42384},[],"/docs/platform/iot-fleets/enrollment/dms#trust-distribution","Trust distribution",{"_2802":829,"_24443":812,"_5":24755,"_17120":42386,"_23194":42387,"_2329":42388},[],"/docs/platform/iot-fleets/enrollment/dms#operate-the-dms-inventory","Operate the DMS inventory",{"_2802":830,"_24443":812,"_5":24755,"_17120":42390,"_23194":42391,"_2329":42392},[],"/docs/platform/iot-fleets/enrollment/dms#integrate-the-devices","Integrate the devices",{"_2802":831,"_24443":812,"_17120":42394,"_5":17015,"_23194":812,"_2329":42395},[],"A &#x2A;*Device Management Service (DMS)** configures admission and identity lifecycle for its devices. It acts as a registration authority; the CA selected in `Enrollment CA` signs certificates. This guide is for the policy administrator.",{"_2802":832,"_24443":812,"_17120":42397,"_5":17015,"_23194":42328,"_2329":42398},[],"You need DMS management permissions, an active CA with a usable key and a tested issuance profile. Agree device ID, initial credential, consumer and renewal window with the integrator. Review Provisioning strategies before choosing registration and replacement.",{"_2802":833,"_24443":812,"_17120":42400,"_5":17015,"_23194":42328,"_2329":42401},[],"Prepare EST server trust and device connectivity through Deployment. Your operator’s administrative authentication does not replace device EST authentication.",{"_2802":834,"_24443":812,"_17120":42403,"_5":17015,"_23194":42335,"_2329":42404},[],"Create the DMS with a recognizable name and retain its ID. EST URLs use this identifier, not the display name. Each device retains one owning DMS.",{"_2802":835,"_24443":812,"_17120":42406,"_5":17015,"_23194":42339,"_2329":42407},[],"Choose **Enrollment CA** and an explicit profile appropriate for the end-entity identity. Keep CN compatible with `Device ID`. The test certificate should allow its intended purpose and expire within issuer validity.",{"_2802":836,"_24443":812,"_17120":42409,"_5":17015,"_23194":42343,"_2329":42410},[],"Select initial enrollment registration and authentication. Separately configure re-enrollment authentication, thresholds and previous certificate retirement. Leave ServerKeyGen disabled if the client generates its key.",{"_2802":837,"_24443":812,"_17120":42412,"_5":17015,"_23194":42347,"_2329":42413},[],"Select certificates returned by `/cacerts`. Explicitly include required intermediates and roots, keeping distribution distinct from automatic trust installation.",{"_2802":838,"_24443":812,"_17120":42415,"_5":17015,"_23194":42351,"_2329":42416},[],"Save and read configuration again. Query `/cacerts`, perform an allowed and a rejected enrollment, and inspect device, serial and history. Creating the DMS or downloading cacerts does not establish working authentication and issuance.",{"_2802":839,"_24443":812,"_17120":42418,"_5":17015,"_23194":42359,"_2329":42419},[],"`settings.enrollment_settings.registration_mode` accepts `JITP` or `PRE_REGISTRATION`. JITP creates an unknown device with the CSR CN as ID and the DMS as owner. `device_provisioning_profile` supplies tags, metadata and icon for that registration.",{"_2802":840,"_24443":812,"_17120":42421,"_5":17015,"_23194":42359,"_2329":42422},[],"PRE\\_REGISTRATION requires an existing ID. In the inspected code, an existing device encounters replacement checks first, even without an identity. Review preregistration conditions before using this mode.",{"_2802":841,"_24443":812,"_17120":42424,"_5":17015,"_23194":42363,"_2329":42425},[],"`settings.enrollment_settings` field",{"_2802":842,"_24443":812,"_17120":42427,"_5":17015,"_23194":42363,"_2329":42428},[],"Decision",{"_2802":843,"_24443":812,"_17120":42430,"_5":17015,"_23194":42363,"_2329":42431},[],"`protocol`",{"_2802":844,"_24443":812,"_17120":42433,"_5":17015,"_23194":42363,"_2329":42434},[],"`EST_RFC7030` for these operations.",{"_2802":845,"_24443":812,"_17120":42436,"_5":17015,"_23194":42363,"_2329":42437},[],"`enrollment_ca`",{"_2802":846,"_24443":812,"_17120":42439,"_5":17015,"_23194":42363,"_2329":42440},[],"ID of the signing CA.",{"_2802":847,"_24443":812,"_17120":42442,"_5":17015,"_23194":42363,"_2329":42443},[],"`verify_csr_signature`",{"_2802":848,"_24443":812,"_17120":42445,"_5":17015,"_23194":42363,"_2329":42446},[],"Keep `true` to verify CSR key possession.",{"_2802":849,"_24443":812,"_17120":42448,"_5":17015,"_23194":42363,"_2329":42449},[],"`enable_replaceable_enrollment`",{"_2802":850,"_24443":812,"_17120":42451,"_5":17015,"_23194":42363,"_2329":42452},[],"Allows `/simpleenroll` for an existing ID in the same DMS. It can attempt previous certificate revocation even if a later phase fails; this is not atomic.",{"_2802":851,"_24443":812,"_17120":42454,"_5":17015,"_23194":42363,"_2329":42455},[],"`est_rfc7030_settings.auth_mode`",{"_2802":852,"_24443":812,"_17120":42457,"_5":17015,"_23194":42363,"_2329":42458},[],"One of the four authentication modes.",{"_2802":853,"_24443":812,"_17120":42460,"_5":17015,"_23194":42363,"_2329":42461},[],"Initial enrollment rejects an ID owned by another DMS. Do not automatically enable replacement in response to an error; Troubleshooting distinguishes repeated IDs, ownership and partial changes.",{"_2802":854,"_24443":812,"_17120":42463,"_5":17015,"_23194":42367,"_2329":42464},[],"The blocks are independent:",{"_2802":855,"_24443":812,"_17120":42466,"_5":17015,"_23194":42367,"_2329":42467},[],"`settings.enrollment_settings.est_rfc7030_settings` for `/simpleenroll` and `/serverkeygen`.",{"_2802":856,"_24443":812,"_17120":42469,"_5":17015,"_23194":42367,"_2329":42470},[],"`settings.reenrollment_settings.est_rfc7030_settings` for `/simplereenroll`.",{"_2802":857,"_24443":812,"_17120":42472,"_5":17015,"_23194":42367,"_2329":42473},[],"`auth_mode`",{"_2802":858,"_24443":812,"_17120":42475,"_5":17015,"_23194":42367,"_2329":42476},[],"Control applied in the configured operation",{"_2802":859,"_24443":812,"_17120":42478,"_5":17015,"_23194":42367,"_2329":42479},[],"`CLIENT_CERTIFICATE`",{"_2802":860,"_24443":812,"_17120":42481,"_5":17015,"_23194":42367,"_2329":42482},[],"Presented certificate validation.",{"_2802":861,"_24443":812,"_17120":42484,"_5":17015,"_23194":42367,"_2329":42485},[],"`EXTERNAL_WEBHOOK`",{"_2802":862,"_24443":812,"_17120":42487,"_5":17015,"_23194":42367,"_2329":42488},[],"Configured webhook authorization.",{"_2802":863,"_24443":812,"_17120":42490,"_5":17015,"_23194":42367,"_2329":42491},[],"`CLIENT_CERTIFICATE_AND_EXTERNAL_WEBHOOK`",{"_2802":864,"_24443":812,"_17120":42493,"_5":17015,"_23194":42367,"_2329":42494},[],"Certificate validation followed by webhook approval.",{"_2802":865,"_24443":812,"_17120":42496,"_5":17015,"_23194":42367,"_2329":42497},[],"`NO_AUTH`",{"_2802":866,"_24443":812,"_17120":42499,"_5":17015,"_23194":42367,"_2329":42500},[],"No DMS requester authentication.",{"_2802":867,"_24443":812,"_17120":42502,"_5":17015,"_23194":42367,"_2329":42503},[],"Webhook and combined modes also execute during re-enrollment when configured in its block. They do not implicitly degrade to NO\\_AUTH. An absent or unrecognized mode fails.",{"_2802":868,"_24443":812,"_17120":42505,"_5":17015,"_23194":42367,"_2329":42506},[],"For initial mTLS, `client_certificate_settings` contains `validation_cas`, `allow_expired` and `chain_level_validation`. The inspected flow receives one certificate credential; it does not guarantee forwarding every handshake intermediate to the validator. For a direct case, configure the bootstrap’s direct issuer as validation CA and test the actual Gateway path.",{"_2802":869,"_24443":812,"_17120":42508,"_5":17015,"_23194":42367,"_2329":42509},[],"For certificate re-enrollment, the validator uses the enrollment CA, then `additional_validation_cas`, and `enable_expired_renewal`. Do not assume copying initial `validation_cas` changes those issuers.",{"_2802":870,"_24443":812,"_17120":42511,"_5":17015,"_23194":42367,"_2329":42512},[],"For a webhook, configure destination, Lamassu-to-service authentication, method and timeout. The authentication contract explains the device credential and request body. `NO_AUTH` does not establish ownership of the requested ID.",{"_2802":871,"_24443":812,"_17120":42514,"_5":17015,"_23194":42367,"_2329":42515},[],"Migration `20260604110000` copies initial authentication into renewal settings if missing and the required structure exists. It preserves existing configuration. After upgrading, read both blocks; if your version’s console does not expose independent settings, use the DMS API.",{"_2802":872,"_24443":812,"_17120":42517,"_5":17015,"_23194":42371,"_2329":42518},[],"`settings.issuance_profile_id` takes precedence over `settings.issuance_profile`; without either, the CA default profile is used. Rules are documented once in Profiles. DMS changes affect future requests; they do not modify signed certificates or install client trust.",{"_2802":873,"_24443":812,"_17120":42520,"_5":17015,"_23194":42375,"_2329":42521},[],"`settings.reenrollment_settings` field",{"_2802":874,"_24443":812,"_17120":42523,"_5":17015,"_23194":42375,"_2329":40173},[],{"_2802":875,"_24443":812,"_17120":42525,"_5":17015,"_23194":42375,"_2329":42526},[],"`reenrollment_delta`",{"_2802":876,"_24443":812,"_17120":42528,"_5":17015,"_23194":42375,"_2329":42529},[],"Opens the window at the active certificate’s `NotAfter` minus this delta.",{"_2802":877,"_24443":812,"_17120":42531,"_5":17015,"_23194":42375,"_2329":42532},[],"`preventive_delta`",{"_2802":878,"_24443":812,"_17120":42534,"_5":17015,"_23194":42375,"_2329":42535},[],"Preventive operational monitoring threshold.",{"_2802":879,"_24443":812,"_17120":42537,"_5":17015,"_23194":42375,"_2329":42538},[],"`critical_delta`",{"_2802":880,"_24443":812,"_17120":42540,"_5":17015,"_23194":42375,"_2329":42541},[],"Critical operational monitoring threshold.",{"_2802":881,"_24443":812,"_17120":42543,"_5":17015,"_23194":42375,"_2329":42544},[],"`enable_expired_renewal`",{"_2802":882,"_24443":812,"_17120":42546,"_5":17015,"_23194":42375,"_2329":42547},[],"Accepts an expired presented certificate in the renewal mTLS validator. Does not authorize another mode or remove Gateway constraints by itself.",{"_2802":883,"_24443":812,"_17120":42549,"_5":17015,"_23194":42375,"_2329":42550},[],"`additional_validation_cas`",{"_2802":884,"_24443":812,"_17120":42552,"_5":17015,"_23194":42375,"_2329":42553},[],"Additional mTLS credential issuers during migration.",{"_2802":885,"_24443":812,"_17120":42555,"_5":17015,"_23194":42375,"_2329":42556},[],"`revoke_on_reenrollment`",{"_2802":886,"_24443":812,"_17120":42558,"_5":17015,"_23194":42375,"_2329":42559},[],"If the previous certificate is ACTIVE, attempts Superseded revocation before binding its successor.",{"_2802":887,"_24443":812,"_17120":42561,"_5":17015,"_23194":42375,"_2329":42562},[],"Monitoring does not renew: the client must schedule the request and installation. Webhook and NO\\_AUTH modes do not use the same mTLS expired-credential validator; the webhook must explicitly authorize permitted recovery. Review Renewal and recovery for operation order and partial failures.",{"_2802":888,"_24443":812,"_17120":42564,"_5":17015,"_23194":42379,"_2329":42565},[],"`settings.server_keygen_settings.enabled` enables software key generation on the server. Algorithm and size come from its `key` field; the profile must permit them. The response contains an unencrypted PKCS#8 key inside TLS alongside the certificate. See format and extraction in EST reference.",{"_2802":889,"_24443":812,"_17120":42567,"_5":17015,"_23194":42383,"_2329":40167},[],{"_2802":890,"_24443":812,"_17120":42569,"_5":17015,"_23194":42383,"_2329":42570},[],"Published material",{"_2802":891,"_24443":812,"_17120":42572,"_5":17015,"_23194":42383,"_2329":42573},[],"**Include Lamassu System CA**",{"_2802":892,"_24443":812,"_17120":42575,"_5":17015,"_23194":42383,"_2329":42576},[],"Available downstream TLS certificate; it can be a leaf, not an issuing CA.",{"_2802":893,"_24443":812,"_17120":42578,"_5":17015,"_23194":42383,"_2329":42579},[],"**Include Enrollment CA**",{"_2802":894,"_24443":812,"_17120":42581,"_5":17015,"_23194":42383,"_2329":42582},[],"Selected issuing CA certificate.",{"_2802":895,"_24443":812,"_17120":42584,"_5":17015,"_23194":42383,"_2329":42585},[],"**Managed CAs**",{"_2802":896,"_24443":812,"_17120":42587,"_5":17015,"_23194":42383,"_2329":42588},[],"Explicitly selected CA certificates.",{"_2802":897,"_24443":812,"_17120":42590,"_5":17015,"_23194":42383,"_2329":42591},[],"All ancestors are not added automatically. Trust distribution distinguishes trusted roots, intermediates and initial server trust.",{"_2802":898,"_24443":812,"_17120":42593,"_5":17015,"_23194":42387,"_2329":42594},[],"**Edit** changes name, settings and metadata. Backend updates replace these complete blocks; read the DMS before sending API edits to avoid losing fields.",{"_2802":899,"_24443":812,"_17120":42596,"_5":17015,"_23194":42387,"_2329":42597},[],"**Go to DMS owned devices** restricts inventory by owner. **Show/Edit Metadata** contains operational and integration data; consult the integration guide before changing it. &#x2A;*EST (RFC-7030)** helps locate URLs.",{"_2802":900,"_24443":812,"_17120":42599,"_5":17015,"_23194":42387,"_2329":42600},[],"**Delete** removes the DMS record and configuration; it does not itself cascade revocation across every device and certificate. Migrate dependencies and retain audit references before retirement.",{"_2802":901,"_24443":812,"_17120":42602,"_5":17015,"_23194":42391,"_2329":42603},[],"Continue with EST client or the enrollment and mTLS tutorial. EST reference covers formats; Troubleshooting covers failures.",{"_2802":902,"_24443":902,"_5":12033,"_2329":42605,"_24758":42606,"_17120":42607,"_23194":902},"Integrate the EST client",[39790,41134,42065,42063,42246],[],{"_2802":903,"_24443":902,"_17120":42609,"_5":17015,"_23194":902,"_2329":42610},[],"Prepare trust, send a CSR and check the identity you receive.",{"_2802":904,"_24443":902,"_5":24755,"_17120":42612,"_23194":42613,"_2329":39800},[],"/docs/platform/iot-fleets/enrollment/est-client#before-you-begin",{"_2802":905,"_24443":902,"_5":24755,"_17120":42615,"_23194":42616,"_2329":42617},[],"/docs/platform/iot-fleets/enrollment/est-client#download-and-inspect-cacerts","Download and inspect cacerts",{"_2802":906,"_24443":902,"_5":24755,"_17120":42619,"_23194":42620,"_2329":42621},[],"/docs/platform/iot-fleets/enrollment/est-client#prepare-the-csr","Prepare the CSR",{"_2802":907,"_24443":902,"_5":24755,"_17120":42623,"_23194":42624,"_2329":42625},[],"/docs/platform/iot-fleets/enrollment/est-client#request-the-identity","Request the identity",{"_2802":908,"_24443":902,"_5":24755,"_17120":42627,"_23194":42628,"_2329":42629},[],"/docs/platform/iot-fleets/enrollment/est-client#check-and-install-the-result","Check and install the result",{"_2802":909,"_24443":902,"_5":24755,"_17120":42631,"_23194":42632,"_2329":42633},[],"/docs/platform/iot-fleets/enrollment/est-client#next-steps","Next steps",{"_2802":910,"_24443":902,"_17120":42635,"_5":17015,"_23194":902,"_2329":42636},[],"This guide is for those implementing the device client. The administrator must have prepared the DMS policy. For a complete first run, follow Enroll and connect your first device.",{"_2802":911,"_24443":902,"_17120":42638,"_5":17015,"_23194":42613,"_2329":42639},[],"You need the public HTTPS DMS URL, server trust obtained through an approved channel, the operation's authentication mode and an admitted identifier. The examples use Bash, OpenSSL 3.x and curl with `--fail-with-body`; use a private working directory and compatible versions of these tools.",{"_2802":912,"_24443":902,"_17120":42641,"_5":17015,"_23194":42613,"_2329":42642},[],"Prepare `est-trust.pem` to verify the EST server, `bootstrap.crt` and `bootstrap.key` for initial certificate authentication, and `device-root.pem` as the approved root of the device issuer. The two trust files can contain different roots. For another authentication mode, adapt the credentials according to Bootstrap identity.",{"_2802":913,"_24443":902,"_17120":42644,"_5":17015,"_23194":42613,"_2329":42645},[],"Replace the host and `REPLACE_DMS_ID` with those of your installation. The URL's APS is the DMS identifier, not its display name.",{"_2802":914,"_24443":902,"_17120":42647,"_5":17015,"_23194":42616,"_2329":42648},[],"The default content is Base64-encoded DER PKCS#7. It is not a direct PEM file.",{"_2802":915,"_24443":902,"_17120":42650,"_5":17015,"_23194":42616,"_2329":42651},[],"Check fingerprints, issuers and dates against the trust distribution policy. The response can contain a selection of CAs and Lamassu's TLS certificate. Do not turn the entire bundle into trusted roots or use it to authenticate its own initial download. HTTP 200 here does not prove that authentication or issuance works.",{"_2802":916,"_24443":902,"_17120":42653,"_5":17015,"_23194":42620,"_2329":42654},[],"The example generates a new EC P-256 key and uses `est-device-001`, which must be available if the DMS registers automatically. The `Common Name` becomes the device identifier. Check that the profile permits the selected key and subject.",{"_2802":917,"_24443":902,"_17120":42656,"_5":17015,"_23194":42620,"_2329":42657},[],"An implementation using hardware or its own store must produce the CSR through its resident key. `simpleenroll` sends the request and retains the key in the client. Honor Extensions does not authorize every requested attribute: see Profiles.",{"_2802":918,"_24443":902,"_17120":42659,"_5":17015,"_23194":42624,"_2329":42660},[],"With initial `CLIENT_CERTIFICATE` authentication, send the Base64-encoded DER CSR using `Content-Type: application/pkcs10`:",{"_2802":919,"_24443":902,"_17120":42662,"_5":17015,"_23194":42624,"_2329":42663},[],"Stop if curl fails. Retain the HTTP code, headers and body for diagnosis; an error response is not decoded as a certificate. The Bash example stops before that conversion. A timeout leaves the operation's result to be checked in Lamassu: do not automatically repeat issuance.",{"_2802":920,"_24443":902,"_17120":42665,"_5":17015,"_23194":42628,"_2329":42666},[],"For a root that issues directly:",{"_2802":921,"_24443":902,"_17120":42668,"_5":17015,"_23194":42628,"_2329":42669},[],"Also verify that the CN is correct, the certificate is a leaf, its uses permit your application and its dates satisfy the profile. `cmp` must exit with code 0. With intermediates, provide the chain through `-untrusted` as described in PKI validation.",{"_2802":922,"_24443":902,"_17120":42671,"_5":17015,"_23194":42628,"_2329":42672},[],"Query the device: the owning DMS, current serial number and history must match the result. Protect the key/certificate pair and install both using the device's mechanism. Association in Lamassu does not install files in the client. Check a real connection before considering the process complete.",{"_2802":923,"_24443":902,"_17120":42674,"_5":17015,"_23194":42632,"_2329":42675},[],"Implement renewal and recovery and trust updates. The EST reference covers endpoints, formats and ServerKeyGen; troubleshooting helps distinguish transport, admission and persistence failures.",{"_2802":924,"_24443":924,"_5":12033,"_2329":42677,"_24758":42678,"_17120":42679,"_23194":924},"EST reference",[39790,41134,42065,42063,42246],[],{"_2802":925,"_24443":924,"_17120":42681,"_5":17015,"_23194":924,"_2329":42682},[],"Look up Lamassu routes, formats, authentication and multipart responses.",{"_2802":926,"_24443":924,"_5":24755,"_17120":42684,"_23194":42685,"_2329":42686},[],"/docs/platform/iot-fleets/enrollment/est-reference#endpoint-reference","Endpoint reference",{"_2802":927,"_24443":924,"_5":24755,"_17120":42688,"_23194":42689,"_2329":18580},[],"/docs/platform/iot-fleets/enrollment/est-reference#cacerts",{"_2802":928,"_24443":924,"_5":24755,"_17120":42691,"_23194":42692,"_2329":21287},[],"/docs/platform/iot-fleets/enrollment/est-reference#simpleenroll",{"_2802":929,"_24443":924,"_5":24755,"_17120":42694,"_23194":42695,"_2329":21294},[],"/docs/platform/iot-fleets/enrollment/est-reference#simplereenroll",{"_2802":930,"_24443":924,"_5":24755,"_17120":42697,"_23194":42698,"_2329":20663},[],"/docs/platform/iot-fleets/enrollment/est-reference#serverkeygen",{"_2802":931,"_24443":924,"_5":24755,"_17120":42700,"_23194":42701,"_2329":42702},[],"/docs/platform/iot-fleets/enrollment/est-reference#response-format","Response format",{"_2802":932,"_24443":924,"_5":24755,"_17120":42704,"_23194":42705,"_2329":42706},[],"/docs/platform/iot-fleets/enrollment/est-reference#request-and-extraction","Request and extraction",{"_2802":933,"_24443":924,"_5":24755,"_17120":42708,"_23194":42709,"_2329":42710},[],"/docs/platform/iot-fleets/enrollment/est-reference#compatibility-notes","Compatibility notes",{"_2802":934,"_24443":924,"_17120":42712,"_5":17015,"_23194":924,"_2329":42713},[],"Reference for the examined backend, based on RFC 7030. Use EST client for the procedure and DMS to configure policy.",{"_2802":935,"_24443":924,"_17120":42715,"_5":17015,"_23194":42685,"_2329":42716},[],"Public route in the examples: `/.well-known/est/{APS}/{operation}`. `APS` is the DMS ID. The router admits routes without that segment, but the controller requires it; do not use them as a default service. Gateway configuration determines the public host and route.",{"_2802":936,"_24443":924,"_17120":42718,"_5":17015,"_23194":42685,"_2329":42719},[],"Operation",{"_2802":937,"_24443":924,"_17120":42721,"_5":17015,"_23194":42685,"_2329":42722},[],"Method",{"_2802":938,"_24443":924,"_17120":42724,"_5":17015,"_23194":42685,"_2329":42725},[],"Authentication and condition",{"_2802":939,"_24443":924,"_17120":42727,"_5":17015,"_23194":42685,"_2329":42728},[],"`/cacerts`",{"_2802":940,"_24443":924,"_17120":42730,"_5":17015,"_23194":42685,"_2329":42731},[],"GET",{"_2802":941,"_24443":924,"_17120":42733,"_5":17015,"_23194":42685,"_2329":42734},[],"DMS reading does not require an EST credential; HTTPS and infrastructure controls still apply.",{"_2802":942,"_24443":924,"_17120":42736,"_5":17015,"_23194":42685,"_2329":42737},[],"`/simpleenroll`",{"_2802":943,"_24443":924,"_17120":42739,"_5":17015,"_23194":42685,"_2329":42740},[],"POST",{"_2802":944,"_24443":924,"_17120":42742,"_5":17015,"_23194":42685,"_2329":42743},[],"Initial authentication and DMS registration/replacement policy.",{"_2802":945,"_24443":924,"_17120":42745,"_5":17015,"_23194":42685,"_2329":42746},[],"`/simplereenroll`",{"_2802":946,"_24443":924,"_17120":42748,"_5":17015,"_23194":42685,"_2329":42740},[],{"_2802":947,"_24443":924,"_17120":42750,"_5":17015,"_23194":42685,"_2329":42751},[],"Renewal authentication, existing identity, subject, revocation and window.",{"_2802":948,"_24443":924,"_17120":42753,"_5":17015,"_23194":42685,"_2329":42754},[],"`/serverkeygen`",{"_2802":949,"_24443":924,"_17120":42756,"_5":17015,"_23194":42685,"_2329":42740},[],{"_2802":950,"_24443":924,"_17120":42758,"_5":17015,"_23194":42685,"_2329":42759},[],"Initial authentication and admission; server generation enabled.",{"_2802":951,"_24443":924,"_17120":42761,"_5":17015,"_23194":42685,"_2329":42762},[],"These routes do not implement `/csrattrs` or `/fullcmc`. There is no native JWT EST authentication mode; a webhook can interpret a request credential according to its own contract.",{"_2802":952,"_24443":924,"_17120":42764,"_5":17015,"_23194":42689,"_2329":42765},[],"The default response has `Content-Type: application/pkcs7-mime; smime-type=certs-only` and `Content-Transfer-Encoding: base64`. The body is Base64-encoded DER PKCS#7 with lines of up to 76 characters. It includes the certificates selected by the DMS, not necessarily every ancestor.",{"_2802":953,"_24443":924,"_17120":42767,"_5":17015,"_23194":42689,"_2329":42768},[],"`Accept: application/x-pem-file` requests the bundle in PEM through a Lamassu extension. Inspect and approve its contents before modifying trusted roots.",{"_2802":954,"_24443":924,"_17120":42770,"_5":17015,"_23194":42692,"_2329":42771},[],"Send a Base64-encoded DER PKCS#10 CSR with `Content-Type: application/pkcs10`. The examined controller compares that media type literally; avoid adding parameters such as charset. The CN identifies the device and the CSR signature must be verified through DMS policy.",{"_2802":955,"_24443":924,"_17120":42773,"_5":17015,"_23194":42692,"_2329":42774},[],"The default response uses the PKCS#7/Base64 format described for cacerts, but contains the issued certificate; do not assume it includes its entire chain. `Accept: application/x-pem-file` returns that certificate in PEM. The client retains the key that signed the CSR.",{"_2802":956,"_24443":924,"_17120":42776,"_5":17015,"_23194":42695,"_2329":42777},[],"Use the same request and certificate response formats. Authentication comes from the independent `reenrollment_settings.est_rfc7030_settings` block. With a client certificate, its CN must match the CSR CN; the subject is also checked against the current certificate.",{"_2802":957,"_24443":924,"_17120":42779,"_5":17015,"_23194":42695,"_2329":42780},[],"The enrollment CA or an additional CA validates the credential in mTLS mode. The expiry check through `enable_expired_renewal` belongs to that validator. A revoked current certificate and a request before the window are rejected. See Renewal for installation and recovery.",{"_2802":958,"_24443":924,"_17120":42782,"_5":17015,"_23194":42698,"_2329":42783},[],"The server generates a software key, rebuilds the CSR with that key and performs initial enrollment. The flag must be enabled and the algorithm permitted by the profile. This operation's key does not become a hardware key because the CA is hosted in an HSM.",{"_2802":959,"_24443":924,"_17120":42785,"_5":17015,"_23194":42698,"_2329":42786},[],"The code supports RSA and ECDSA with 224, 256, 384 or 521 bits. An unrecognized ECDSA size can fall back to 256; explicitly select a compatible size and check the resulting key. Do not reuse an enrolled ID to test this operation without reviewing replacement.",{"_2802":960,"_24443":924,"_17120":42788,"_5":17015,"_23194":42701,"_2329":42789},[],"The body is **MIME multipart/mixed**, with the boundary specified in `Content-Type`. It contains two parts:",{"_2802":961,"_24443":924,"_17120":42791,"_5":17015,"_23194":42701,"_2329":42792},[],"Part",{"_2802":962,"_24443":924,"_17120":42794,"_5":17015,"_23194":42701,"_2329":42795},[],"Content after decoding its Base64",{"_2802":963,"_24443":924,"_17120":42797,"_5":17015,"_23194":42701,"_2329":42798},[],"`application/pkcs8`",{"_2802":964,"_24443":924,"_17120":42800,"_5":17015,"_23194":42701,"_2329":42801},[],"Unencrypted DER PKCS#8 private key.",{"_2802":965,"_24443":924,"_17120":42803,"_5":17015,"_23194":42701,"_2329":42804},[],"`application/pkcs7-mime; smime-type=certs-only`",{"_2802":966,"_24443":924,"_17120":42806,"_5":17015,"_23194":42701,"_2329":42807},[],"DER PKCS#7 containing the issued certificate.",{"_2802":967,"_24443":924,"_17120":42809,"_5":17015,"_23194":42701,"_2329":42810},[],"The controller also adds `Content-Transfer-Encoding: base64` to the outer header, although the outer body is MIME text. &#x2A;*Do not Base64-decode the entire body.** Read the actual boundary and decode each part according to its headers.",{"_2802":968,"_24443":924,"_17120":42812,"_5":17015,"_23194":42705,"_2329":42813},[],"In a Bash session with `set -euo pipefail` and `umask 077`, use `EST_BASE` and the trust/bootstrap files from EST client. Select an available and admitted `est-serverkeygen-001`. The `server-request.key` only signs the input CSR; the received identity uses the server-generated key.",{"_2802":969,"_24443":924,"_17120":42815,"_5":17015,"_23194":42705,"_2329":42816},[],"Save this Python 3 extractor. It validates both parts before writing and rejects existing output files:",{"_2802":970,"_24443":924,"_17120":42818,"_5":17015,"_23194":42705,"_2329":42819},[],"Convert and check the result:",{"_2802":971,"_24443":924,"_17120":42821,"_5":17015,"_23194":42705,"_2329":42822},[],"Inspect the CN, serial, dates and uses; check association in Lamassu before installing. Protect the DER and PEM files containing the key and remove temporary copies according to the device's storage mechanism. See openssl-pkcs8 and the Python MIME parser.",{"_2802":972,"_24443":924,"_17120":42824,"_5":17015,"_23194":42709,"_2329":42825},[],"Do not interpret every 500 as a transient failure. Invalid input typically produces 400; service denials and errors typically produce 500 with a JSON `err` body. Gateway errors and some controller paths can have another format. Retain headers and body before decoding and see troubleshooting.",{"_2802":973,"_24443":924,"_17120":42827,"_5":17015,"_23194":42709,"_2329":42828},[],"The examples use openssl-pkcs7 to extract certificates and openssl-x509 to prepare renewal. Check your version's capabilities and responses before integrating a generic EST client.",{"_2802":974,"_24443":974,"_5":12033,"_2329":42246,"_24758":42830,"_17120":42831,"_23194":974},[39790,41134,42065,42063,42246],[],{"_2802":975,"_24443":974,"_17120":42833,"_5":17015,"_23194":974,"_2329":42834},[],"Choose admission policy and connect DMS, initial trust and the EST client.",{"_2802":976,"_24443":974,"_5":24755,"_17120":42836,"_23194":42837,"_2329":42838},[],"/docs/platform/iot-fleets/enrollment/overview#the-journey","The journey",{"_2802":977,"_24443":974,"_5":24755,"_17120":42840,"_23194":42841,"_2329":42842},[],"/docs/platform/iot-fleets/enrollment/overview#for-the-administrator","For the administrator",{"_2802":978,"_24443":974,"_5":24755,"_17120":42844,"_23194":42845,"_2329":42846},[],"/docs/platform/iot-fleets/enrollment/overview#for-the-integrator","For the integrator",{"_2802":979,"_24443":974,"_5":24755,"_17120":42848,"_23194":42849,"_2329":42850},[],"/docs/platform/iot-fleets/enrollment/overview#contract-version","Contract version",{"_2802":980,"_24443":974,"_17120":42852,"_5":17015,"_23194":974,"_2329":42853},[],"Enrollment with PKI covers the path from device admission to identity installation and renewal. The DMS acts as a registration authority: it authenticates the request, applies registration policy and asks the CA to sign. The client keeps or receives the key, installs the result and presents it to the consumer.",{"_2802":981,"_24443":974,"_17120":42855,"_5":17015,"_23194":42837,"_2329":42856},[],"The administrator prepares the CA, issuance profile and DMS.",{"_2802":982,"_24443":974,"_17120":42858,"_5":17015,"_23194":42837,"_2329":42859},[],"The integrator installs initial EST server trust and an admission credential.",{"_2802":983,"_24443":974,"_17120":42861,"_5":17015,"_23194":42837,"_2329":42862},[],"The client requests an identity for its `Device ID` through EST.",{"_2802":984,"_24443":974,"_17120":42864,"_5":17015,"_23194":42837,"_2329":42865},[],"Certificate, device binding and key/certificate installation are checked.",{"_2802":985,"_24443":974,"_17120":42867,"_5":17015,"_23194":42837,"_2329":42868},[],"The consumer validates and authorizes the identity; the client schedules renewal and recovery.",{"_2802":986,"_24443":974,"_17120":42870,"_5":17015,"_23194":42837,"_2329":42871},[],"EST uses `/.well-known/est/{DMS_ID}`. Administrative APIs and manual assignment remain separate paths. Enroll and connect a device completes an initial mTLS test.",{"_2802":987,"_24443":974,"_17120":42873,"_5":17015,"_23194":42841,"_2329":42874},[],"<Card title=\"Provisioning strategies\" description=\"Choose automatic registration, preregistration or manual assignment.\" href=\"/docs/platform/iot-fleets/enrollment/provisioning-strategies\" />",{"_2802":988,"_24443":974,"_17120":42876,"_5":17015,"_23194":42841,"_2329":42877},[],"<Card title=\"Configure the DMS\" description=\"Separate admission, authentication per operation, profiles and distribution.\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_2802":989,"_24443":974,"_17120":42879,"_5":17015,"_23194":42841,"_2329":42880},[],"<Card title=\"Bootstrap identity and authentication\" description=\"Decide which proof allows requesting the first identity.\" href=\"/docs/platform/iot-fleets/enrollment/bootstrap-identity\" />",{"_2802":990,"_24443":974,"_17120":42882,"_5":17015,"_23194":42841,"_2329":42883},[],"<Card title=\"Trust distribution\" description=\"Update roots and chains with verified overlap.\" href=\"/docs/platform/iot-fleets/enrollment/trust-distribution\" />",{"_2802":991,"_24443":974,"_17120":42885,"_5":17015,"_23194":42845,"_2329":42886},[],"<Card title=\"EST client\" description=\"Prepare the request, verify the response and install the identity.\" href=\"/docs/platform/iot-fleets/enrollment/est-client\" />",{"_2802":992,"_24443":974,"_17120":42888,"_5":17015,"_23194":42845,"_2329":42889},[],"<Card title=\"Renewal and recovery\" description=\"Generate the successor and handle expired or lost credentials.\" href=\"/docs/platform/iot-fleets/enrollment/renewal-and-recovery\" />",{"_2802":993,"_24443":974,"_17120":42891,"_5":17015,"_23194":42845,"_2329":42892},[],"<Card title=\"EST reference\" description=\"Look up paths, formats, authentication and ServerKeyGen.\" href=\"/docs/platform/iot-fleets/enrollment/est-reference\" />",{"_2802":994,"_24443":974,"_17120":42894,"_5":17015,"_23194":42845,"_2329":42895},[],"<Card title=\"Troubleshooting\" description=\"Distinguish transport, policy, issuance and installation failures.\" href=\"/docs/platform/iot-fleets/enrollment/troubleshooting\" />",{"_2802":995,"_24443":974,"_17120":42897,"_5":17015,"_23194":42849,"_2329":42898},[],"This block describes `main` code inspected at commit `8f42c47157f9a36bac3ed5caa3692aebebe19c4b`. The site catalog publishes `main (unstable)`; this behavior is not attributed to a stable release. Before using another version, check its contract and migrations, particularly independent re-enrollment authentication. Client checks and live-instance tests are distinguished in the revision plan.",{"_2802":996,"_24443":974,"_17120":42900,"_5":17015,"_23194":42849,"_2329":42901},[],"Gateway, TLS, provider and service configuration belongs to Deployment. Identity use in AWS or other destinations belongs to Integrations.",{"_2802":997,"_24443":997,"_5":12033,"_2329":42903,"_24758":42904,"_17120":42905,"_23194":997},"Provisioning strategies",[39790,41134,42065,42063,42246],[],{"_2802":998,"_24443":997,"_17120":42907,"_5":17015,"_23194":997,"_2329":42908},[],"Choose device registration, identity authorization and key generation.",{"_2802":999,"_24443":997,"_5":24755,"_17120":42910,"_23194":42911,"_2329":42912},[],"/docs/platform/iot-fleets/enrollment/provisioning-strategies#choose-registration","Choose registration",{"_2802":1000,"_24443":997,"_5":24755,"_17120":42914,"_23194":42915,"_2329":42916},[],"/docs/platform/iot-fleets/enrollment/provisioning-strategies#preregistration-and-replacement","Preregistration and replacement",{"_2802":1001,"_24443":997,"_5":24755,"_17120":42918,"_23194":42919,"_2329":42920},[],"/docs/platform/iot-fleets/enrollment/provisioning-strategies#choose-authentication","Choose authentication",{"_2802":1002,"_24443":997,"_5":24755,"_17120":42922,"_23194":42923,"_2329":42924},[],"/docs/platform/iot-fleets/enrollment/provisioning-strategies#choose-custody","Choose custody",{"_2802":1003,"_24443":997,"_5":24755,"_17120":42926,"_23194":42927,"_2329":42928},[],"/docs/platform/iot-fleets/enrollment/provisioning-strategies#check-the-decision","Check the decision",{"_2802":1004,"_24443":997,"_17120":42930,"_5":17015,"_23194":997,"_2329":42931},[],"This guide helps the provisioning administrator choose a path before configuring the DMS. Separate three decisions: when the device exists, how its request is authorized and who generates its key. None grants destination access by itself.",{"_2802":1005,"_24443":997,"_17120":42933,"_5":17015,"_23194":42911,"_2329":42934},[],"Path",{"_2802":1006,"_24443":997,"_17120":42936,"_5":17015,"_23194":42911,"_2329":42937},[],"When the device exists",{"_2802":1007,"_24443":997,"_17120":42939,"_5":17015,"_23194":42911,"_2329":42940},[],"What to check",{"_2802":1008,"_24443":997,"_17120":42942,"_5":17015,"_23194":42911,"_2329":42943},[],"Manual assignment",{"_2802":1009,"_24443":997,"_17120":42945,"_5":17015,"_23194":42911,"_2329":42946},[],"An operator creates it before associating a certificate.",{"_2802":1010,"_24443":997,"_17120":42948,"_5":17015,"_23194":42911,"_2329":42949},[],"ID, owning DMS, certificate CN and bound serial.",{"_2802":1011,"_24443":997,"_17120":42951,"_5":17015,"_23194":42911,"_2329":42952},[],"EST with `JITP`",{"_2802":1012,"_24443":997,"_17120":42954,"_5":17015,"_23194":42911,"_2329":42955},[],"Created for an unknown CN during `/simpleenroll`.",{"_2802":1013,"_24443":997,"_17120":42957,"_5":17015,"_23194":42911,"_2329":42958},[],"Authorized credential, unused ID, profile, resulting registration and identity.",{"_2802":1014,"_24443":997,"_17120":42960,"_5":17015,"_23194":42911,"_2329":42961},[],"EST with `PRE_REGISTRATION`",{"_2802":1015,"_24443":997,"_17120":42963,"_5":17015,"_23194":42911,"_2329":42964},[],"Must exist before `/simpleenroll`.",{"_2802":1016,"_24443":997,"_17120":42966,"_5":17015,"_23194":42911,"_2329":42967},[],"Approved record, same DMS and replacement conditions for your version.",{"_2802":1017,"_24443":997,"_17120":42969,"_5":17015,"_23194":42911,"_2329":42970},[],"Lamassu `JITP` creates inventory and identity in Lamassu. AWS JITP provisions a destination in AWS; these are separate decisions.",{"_2802":1018,"_24443":997,"_17120":42972,"_5":17015,"_23194":42911,"_2329":42973},[],"For an initial client test, use Enroll and connect a device. To prepare inventory without EST, follow Manual registration.",{"_2802":1019,"_24443":997,"_17120":42975,"_5":17015,"_23194":42915,"_2329":42976},[],"In the inspected code, finding any device owned by the same DMS triggers the `enable_replaceable_enrollment` check before PRE\\_REGISTRATION. With the flag disabled, a preregistered device can receive `forbiddenNewEnrollment` even in **No Identity**. Selecting PRE\\_REGISTRATION alone therefore does not establish a working path.",{"_2802":1020,"_24443":997,"_17120":42978,"_5":17015,"_23194":42915,"_2329":42979},[],"Enabling the flag permits repeated `/simpleenroll` for an existing ID. The backend schedules a deferred attempt to revoke the previous certificate with `Superseded`; it can also run if later issuance or binding fails. Without an identity, that attempt can fail because no serial exists. The flag does not provide a replacement transaction or guarantee restoration of previous state.",{"_2802":1021,"_24443":997,"_17120":42981,"_5":17015,"_23194":42915,"_2329":42982},[],"Test the exact case on your version before enabling it for a population. For an operational identity with authorized renewal, use `/simplereenroll`; for recovery, follow Renewal and recovery and check persisted state before retrying.",{"_2802":1022,"_24443":997,"_17120":42984,"_5":17015,"_23194":42919,"_2329":42985},[],"Decide initial enrollment and re-enrollment separately:",{"_2802":1023,"_24443":997,"_17120":42987,"_5":17015,"_23194":42919,"_2329":42988},[],"**Client certificate:** useful when each device has an initial credential whose key it controls.",{"_2802":1024,"_24443":997,"_17120":42990,"_5":17015,"_23194":42919,"_2329":42991},[],"**Webhook:** useful when another authority knows inventory, credentials or entitlement to a requested ID.",{"_2802":1025,"_24443":997,"_17120":42993,"_5":17015,"_23194":42919,"_2329":42994},[],"**Certificate and webhook:** requires both controls in the configured operation.",{"_2802":1026,"_24443":997,"_17120":42996,"_5":17015,"_23194":42919,"_2329":42997},[],"**NO\\_AUTH:** does not establish requester identity; appropriate only when admission is deliberately controlled outside that DMS.",{"_2802":1027,"_24443":997,"_17120":42999,"_5":17015,"_23194":42919,"_2329":43000},[],"Authenticating an initial certificate does not itself establish entitlement to choose any CSR CN. Define that authorization in Bootstrap identity and authentication.",{"_2802":1028,"_24443":997,"_17120":43002,"_5":17015,"_23194":42923,"_2329":40167},[],{"_2802":1029,"_24443":997,"_17120":43004,"_5":17015,"_23194":42923,"_2329":43005},[],"Material crossing EST",{"_2802":1030,"_24443":997,"_17120":43007,"_5":17015,"_23194":42923,"_2329":43008},[],"Device-generated key",{"_2802":1031,"_24443":997,"_17120":43010,"_5":17015,"_23194":42923,"_2329":43011},[],"Public CSR and certificate; the key stays on the client.",{"_2802":1032,"_24443":997,"_17120":43013,"_5":17015,"_23194":42923,"_2329":43014},[],"Existing device key",{"_2802":1033,"_24443":997,"_17120":43016,"_5":17015,"_23194":42923,"_2329":43017},[],"CSR signed with that key and a new certificate.",{"_2802":1034,"_24443":997,"_17120":43019,"_5":17015,"_23194":42923,"_2329":42380},[],{"_2802":1035,"_24443":997,"_17120":43021,"_5":17015,"_23194":42923,"_2329":43022},[],"Private PKCS#8 key and certificate in a TLS-protected multipart response.",{"_2802":1036,"_24443":997,"_17120":43024,"_5":17015,"_23194":42923,"_2329":43025},[],"ServerKeyGen does not automatically use the CA’s HSM or KMS for the device key. Review its contract and extraction and the device’s ability to install the material.",{"_2802":1037,"_24443":997,"_17120":43027,"_5":17015,"_23194":42927,"_2329":43028},[],"Before expanding the flow, test allowed registration, incorrect credentials, an ID owned by another DMS, repeated requests and recovery after failure. Keep ID, serial, active version and error. Also test consumer acceptance and rejection; issuance does not imply destination registration or permission to operate.",{"_2802":1038,"_24443":1038,"_5":12033,"_2329":43030,"_24758":43031,"_17120":43032,"_23194":1038},"Renewal and recovery",[39790,41134,42065,42063,42246],[],{"_2802":1039,"_24443":1038,"_17120":43034,"_5":17015,"_23194":1038,"_2329":43035},[],"Renew without losing the identity and recover devices according to their actual state.",{"_2802":1040,"_24443":1038,"_5":24755,"_17120":43037,"_23194":43038,"_2329":43039},[],"/docs/platform/iot-fleets/enrollment/renewal-and-recovery#prepare-renewal","Prepare renewal",{"_2802":1041,"_24443":1038,"_5":24755,"_17120":43041,"_23194":43042,"_2329":43043},[],"/docs/platform/iot-fleets/enrollment/renewal-and-recovery#request-the-successor-certificate","Request the successor certificate",{"_2802":1042,"_24443":1038,"_5":24755,"_17120":43045,"_23194":43046,"_2329":43047},[],"/docs/platform/iot-fleets/enrollment/renewal-and-recovery#install-and-check-the-new-pair","Install and check the new pair",{"_2802":1043,"_24443":1038,"_5":24755,"_17120":43049,"_23194":43050,"_2329":43051},[],"/docs/platform/iot-fleets/enrollment/renewal-and-recovery#recover-according-to-state","Recover according to state",{"_2802":1044,"_24443":1038,"_5":24755,"_17120":43053,"_23194":43054,"_2329":43055},[],"/docs/platform/iot-fleets/enrollment/renewal-and-recovery#continuous-operation","Continuous operation",{"_2802":1045,"_24443":1038,"_17120":43057,"_5":17015,"_23194":1038,"_2329":43058},[],"Renewal retains the device identifier and requests a successor certificate. The client must complete the process: check the response, install the matching pair and demonstrate that the consumer accepts it. Lamassu alerts notify you; they do not perform those steps.",{"_2802":1046,"_24443":1038,"_17120":43060,"_5":17015,"_23194":43038,"_2329":43061},[],"Query the current certificate in Lamassu and compare it with the installed certificate. You need its subject, serial and dates, as well as the client key.",{"_2802":1047,"_24443":1038,"_17120":43063,"_5":17015,"_23194":43038,"_2329":43064},[],"Check the **re-enrollment** authentication mode: it is independent of initial authentication. With `CLIENT_CERTIFICATE`, use the current identity; do not assume the bootstrap credential is admitted.",{"_2802":1048,"_24443":1038,"_17120":43066,"_5":17015,"_23194":43038,"_2329":43067},[],"Calculate the window's start: the current certificate's `NotAfter` minus `reenrollment_delta`. Preventive and critical thresholds produce states/notifications; they do not extend that window.",{"_2802":1049,"_24443":1038,"_17120":43069,"_5":17015,"_23194":43038,"_2329":43070},[],"Review **Revoke on Re-enrollment** and recovery if installation fails. When enabled, Lamassu can revoke the previous identity before the client installs the new one.",{"_2802":1050,"_24443":1038,"_17120":43072,"_5":17015,"_23194":43042,"_2329":43073},[],"The example continues the EST tutorial, in the same Bash session with `set -euo pipefail`, `umask 077` and `EST_BASE`. Use a new key compatible with the profile. Conversion from the certificate preserves the subject and copies only SAN when present; check the subject and requested names before sending it. The backend checks the subject against the current identity: it attempts RawSubject equality and then compares CN, OU, O, L, ST and C. Rebuilding only the CN can lose required attributes.",{"_2802":1051,"_24443":1038,"_17120":43075,"_5":17015,"_23194":43042,"_2329":43076},[],"The request authenticates with `device.crt` and `device.key`; the CSR contains the new public key. Also check extensions, dates and correspondence of the serial with the current slot in Lamassu. Do not resubmit a failed request without querying that state: issuance, previous revocation and successor binding can have partial results.",{"_2802":1052,"_24443":1038,"_17120":43078,"_5":17015,"_23194":43046,"_2329":43079},[],"Keep the result as `device.next.crt` and `device.next.key` until verified. Switch the pair through a coordinated operation in the device store or configuration; avoid temporarily exposing a certificate with another version's key.",{"_2802":1053,"_24443":1038,"_17120":43081,"_5":17015,"_23194":43046,"_2329":43082},[],"Test mTLS with the consumer and verify that it uses the new serial. Confirm the history and current certificate in Lamassu. If **Revoke on Re-enrollment** was disabled, the previous identity can remain valid: retire it according to PKI policy after testing the successor, and check revocation publication and consumption.",{"_2802":1054,"_24443":1038,"_17120":43084,"_5":17015,"_23194":43046,"_2329":43085},[],"If the previous identity is already revoked, retaining its files does not restore a valid connection. Recovery requires an admitted credential and authorized intervention according to the situation.",{"_2802":1055,"_24443":1038,"_17120":43087,"_5":17015,"_23194":43050,"_2329":43088},[],"Situation",{"_2802":1056,"_24443":1038,"_17120":43090,"_5":17015,"_23194":43050,"_2329":43091},[],"Procedure",{"_2802":1057,"_24443":1038,"_17120":43093,"_5":17015,"_23194":43050,"_2329":43094},[],"Valid certificate, outside the window",{"_2802":1058,"_24443":1038,"_17120":43096,"_5":17015,"_23194":43050,"_2329":43097},[],"Schedule the request within the window. Do not use `simpleenroll` to bypass it.",{"_2802":1059,"_24443":1038,"_17120":43099,"_5":17015,"_23194":43050,"_2329":43100},[],"Expired certificate, key available",{"_2802":1060,"_24443":1038,"_17120":43102,"_5":17015,"_23194":43050,"_2329":43103},[],"With certificate authentication, review `enable_expired_renewal` and whether Gateway permits presenting that credential. Revocation, subject and the remaining checks still apply.",{"_2802":1061,"_24443":1038,"_17120":43105,"_5":17015,"_23194":43050,"_2329":43106},[],"Renewal through webhook or `NO_AUTH`",{"_2802":1062,"_24443":1038,"_17120":43108,"_5":17015,"_23194":43050,"_2329":43109},[],"The mTLS expiry check does not run in these modes. Define expiry and authorization policy in the corresponding admission process; the flag is not a universal prohibition.",{"_2802":1063,"_24443":1038,"_17120":43111,"_5":17015,"_23194":43050,"_2329":43112},[],"Lost or inaccessible key",{"_2802":1064,"_24443":1038,"_17120":43114,"_5":17015,"_23194":43050,"_2329":43115},[],"You cannot prove possession of the previous identity. Authorize new admission and, if appropriate, controlled replacement; revoke the compromised identity.",{"_2802":1065,"_24443":1038,"_17120":43117,"_5":17015,"_23194":43050,"_2329":43118},[],"Current identity revoked",{"_2802":1066,"_24443":1038,"_17120":43120,"_5":17015,"_23194":43050,"_2329":43121},[],"`simplereenroll` rejects the revoked current certificate. Investigate the reason and prepare an authorized readmission procedure; do not disable authentication to force it.",{"_2802":1067,"_24443":1038,"_17120":43123,"_5":17015,"_23194":43050,"_2329":43124},[],"Device without an identity",{"_2802":1068,"_24443":1038,"_17120":43126,"_5":17015,"_23194":43050,"_2329":43127},[],"Use initial enrollment. For an existing entry, check the replacement restriction in provisioning.",{"_2802":1069,"_24443":1038,"_17120":43129,"_5":17015,"_23194":43050,"_2329":43130},[],"Retired device",{"_2802":1070,"_24443":1038,"_17120":43132,"_5":17015,"_23194":43050,"_2329":43133},[],"Review the operational decision before readmission. Decommissioned state and revocation of the entire history are not equivalent.",{"_2802":1071,"_24443":1038,"_17120":43135,"_5":17015,"_23194":43050,"_2329":43136},[],"Timeout, HTTP 500 or installation failure",{"_2802":1072,"_24443":1038,"_17120":43138,"_5":17015,"_23194":43050,"_2329":43139},[],"Inspect the device, issued certificates and history before retrying. A successor may have been issued or the previous identity revoked.",{"_2802":1073,"_24443":1038,"_17120":43141,"_5":17015,"_23194":43054,"_2329":43142},[],"Schedule renewal with time for disconnections, trust distribution and consumer checks. Stagger requests across the population and bound retries within the window; authentication, subject and policy errors require correcting their cause. Maintain an admitted and tested recovery mechanism for lost keys and pairs that could not be installed.",{"_2802":1074,"_24443":1038,"_17120":43144,"_5":17015,"_23194":43054,"_2329":43145},[],"Continue with Trust distribution, Devices and identities and Troubleshooting.",{"_2802":1075,"_24443":1075,"_5":12033,"_2329":43147,"_24758":43148,"_17120":43149,"_23194":1075},"Enrollment troubleshooting",[39790,41134,42065,42063,42246],[],{"_2802":1076,"_24443":1075,"_17120":43151,"_5":17015,"_23194":1075,"_2329":43152},[],"Locate transport, authentication, registration, issuance and installation failures.",{"_2802":1077,"_24443":1075,"_5":24755,"_17120":43154,"_23194":43155,"_2329":43156},[],"/docs/platform/iot-fleets/enrollment/troubleshooting#diagnostics-and-compatibility","Diagnostics and compatibility",{"_2802":1078,"_24443":1075,"_5":24755,"_17120":43158,"_23194":43159,"_2329":43160},[],"/docs/platform/iot-fleets/enrollment/troubleshooting#error-codes-and-diagnostics","Error codes and diagnostics",{"_2802":1079,"_24443":1075,"_5":24755,"_17120":43162,"_23194":43163,"_2329":42710},[],"/docs/platform/iot-fleets/enrollment/troubleshooting#compatibility-notes",{"_2802":1080,"_24443":1075,"_5":24755,"_17120":43165,"_23194":43166,"_2329":43167},[],"/docs/platform/iot-fleets/enrollment/troubleshooting#est-enrollment-fails","EST enrollment fails",{"_2802":1081,"_24443":1075,"_17120":43169,"_5":17015,"_23194":1075,"_2329":43170},[],"Diagnose one operation and device at a time. Record the DMS/APS, endpoint, time, HTTP code, presented serial and CSR CN. Retain the response without including private keys or webhook credentials in the report.",{"_2802":1082,"_24443":1075,"_17120":43172,"_5":17015,"_23194":43159,"_2329":43173},[],"The EST controller normally returns 400 when rejecting input and 500 when the service rejects or fails the operation. A 500 can also represent a policy denial; it does not mean retrying is safe. Gateway can produce its own codes and bodies. Examine the actual body and persisted result.",{"_2802":1083,"_24443":1075,"_17120":43175,"_5":17015,"_23194":43159,"_2329":43176},[],"Symptom or message",{"_2802":1084,"_24443":1075,"_17120":43178,"_5":17015,"_23194":43159,"_2329":42940},[],{"_2802":1085,"_24443":1075,"_17120":43180,"_5":17015,"_23194":43159,"_2329":43181},[],"curl rejects TLS, name or issuer",{"_2802":1086,"_24443":1075,"_17120":43183,"_5":17015,"_23194":43159,"_2329":43184},[],"URL, clock, server SAN and approved root in `est-trust.pem`. Resolve trust in Deployment; do not skip verification.",{"_2802":1087,"_24443":1075,"_17120":43186,"_5":17015,"_23194":43159,"_2329":43187},[],"404 or missing APS",{"_2802":1088,"_24443":1075,"_17120":43189,"_5":17015,"_23194":43159,"_2329":43190},[],"Public route `/.well-known/est/{DMS_ID}/{operation}` and existing DMS. APS is not the service name.",{"_2802":1089,"_24443":1075,"_17120":43192,"_5":17015,"_23194":43159,"_2329":43193},[],"400, CSR or format error",{"_2802":1090,"_24443":1075,"_17120":43195,"_5":17015,"_23194":43159,"_2329":43196},[],"`Content-Type: application/pkcs10`, Base64 of DER, valid signature and a body preserved without double encoding.",{"_2802":1091,"_24443":1075,"_17120":43198,"_5":17015,"_23194":43159,"_2329":43199},[],"Missing credential or invalid certificate",{"_2802":1092,"_24443":1075,"_17120":43201,"_5":17015,"_23194":43159,"_2329":43202},[],"Operation mode, validating CA, dates, revocation and credential delivery by Gateway. Do not confuse server TLS trust with the bootstrap CA.",{"_2802":1093,"_24443":1075,"_17120":43204,"_5":17015,"_23194":43159,"_2329":43205},[],"Webhook denies, times out or responds without authorization",{"_2802":1094,"_24443":1075,"_17120":43207,"_5":17015,"_23194":43159,"_2329":43208},[],"Configuration, connectivity and JSON response with `authorized: true`. There is no automatic fallback to `NO_AUTH`.",{"_2802":1095,"_24443":1075,"_17120":43210,"_5":17015,"_23194":43159,"_2329":43211},[],"`device not preregistered`",{"_2802":1096,"_24443":1075,"_17120":43213,"_5":17015,"_23194":43159,"_2329":43214},[],"PRE\\_REGISTRATION requires an existing inventory entry.",{"_2802":1097,"_24443":1075,"_17120":43216,"_5":17015,"_23194":43159,"_2329":43217},[],"`forbiddenNewEnrollment`",{"_2802":1098,"_24443":1075,"_17120":43219,"_5":17015,"_23194":43159,"_2329":43220},[],"An existing device requires replacement to be enabled, even in No Identity. Investigate before enabling the flag.",{"_2802":1099,"_24443":1075,"_17120":43222,"_5":17015,"_23194":43159,"_2329":43223},[],"Different owning DMS",{"_2802":1100,"_24443":1075,"_17120":43225,"_5":17015,"_23194":43159,"_2329":43226},[],"CN/ID, global inventory and owning DMS; do not reuse an ID from another context.",{"_2802":1101,"_24443":1075,"_17120":43228,"_5":17015,"_23194":43159,"_2329":43229},[],"`invalid RawSubject bytes`",{"_2802":1102,"_24443":1075,"_17120":43231,"_5":17015,"_23194":43159,"_2329":43232},[],"CSR subject versus the current certificate. Preserve its attributes as well as its CN.",{"_2802":1103,"_24443":1075,"_17120":43234,"_5":17015,"_23194":43159,"_2329":43235},[],"`invalid reenroll window`",{"_2802":1104,"_24443":1075,"_17120":43237,"_5":17015,"_23194":43159,"_2329":43238},[],"Current identity's NotAfter and reenrollment\\_delta. Alert thresholds do not change that window.",{"_2802":1105,"_24443":1075,"_17120":43240,"_5":17015,"_23194":43159,"_2329":43241},[],"Current certificate revoked",{"_2802":1106,"_24443":1075,"_17120":43243,"_5":17015,"_23194":43159,"_2329":43244},[],"Renewal rejected; prepare authorized recovery according to the cause.",{"_2802":1107,"_24443":1075,"_17120":43246,"_5":17015,"_23194":43159,"_2329":43247},[],"CA, profile or signing error",{"_2802":1108,"_24443":1075,"_17120":43249,"_5":17015,"_23194":43159,"_2329":43250},[],"Active CA, available key, selected profile and restrictions. Successful cacerts does not prove issuance.",{"_2802":1109,"_24443":1075,"_17120":43252,"_5":17015,"_23194":43159,"_2329":43253},[],"HTTP 200 without a device connection",{"_2802":1110,"_24443":1075,"_17120":43255,"_5":17015,"_23194":43159,"_2329":43256},[],"Installed pair, chain, uses, consumer trust and permissions. Also check the slot and history.",{"_2802":1111,"_24443":1075,"_17120":43258,"_5":17015,"_23194":43159,"_2329":43259},[],"Timeout or error after issuance",{"_2802":1112,"_24443":1075,"_17120":43261,"_5":17015,"_23194":43159,"_2329":43262},[],"New certificates, current slot and previous identity's state before retrying.",{"_2802":1113,"_24443":1075,"_17120":43264,"_5":17015,"_23194":43163,"_2329":43265},[],"The examples use the contract of the examined backend. Do not automatically attribute that behavior to another release. Check the saved renewal mode after migration and Gateway behavior with expired certificates and the bootstrap CA.",{"_2802":1114,"_24443":1075,"_17120":43267,"_5":17015,"_23194":43163,"_2329":43268},[],"The default response is Base64-encoded DER PKCS#7; PEM through `Accept: application/x-pem-file` is a Lamassu extension. ServerKeyGen returns multipart and requires handling each part separately. See the EST reference.",{"_2802":1115,"_24443":1075,"_17120":43270,"_5":17015,"_23194":43166,"_2329":43271},[],"Check HTTPS with the approved root and query cacerts for the correct APS.",{"_2802":1116,"_24443":1075,"_17120":43273,"_5":17015,"_23194":43166,"_2329":43274},[],"Review the saved DMS: protocol, registration, authentication for that operation, CA, profile and window.",{"_2802":1117,"_24443":1075,"_17120":43276,"_5":17015,"_23194":43166,"_2329":43277},[],"Verify the CSR locally and relate its CN to the inventory.",{"_2802":1118,"_24443":1075,"_17120":43279,"_5":17015,"_23194":43166,"_2329":43280},[],"Make one request, save headers/body and query the device and certificates.",{"_2802":1119,"_24443":1075,"_17120":43282,"_5":17015,"_23194":43166,"_2329":43283},[],"If you receive an identity, check the key, subject, use and connection with the consumer.",{"_2802":1120,"_24443":1075,"_17120":43285,"_5":17015,"_23194":43166,"_2329":43286},[],"External bootstrap revocation checks have limitations: absence of evidence can be accepted, and OCSP Unknown does not cause the same rejection as Revoked. Do not assume a policy that rejects every uncertainty. An intermediate CA in the TLS chain does not prove that the entire chain reached the DMS validator either.",{"_2802":1121,"_24443":1075,"_17120":43288,"_5":17015,"_23194":43166,"_2329":43289},[],"For logs, networking, pods or Gateway headers, continue in Deployment troubleshooting. For identities issued, revoked or bound partially, use Renewal and recovery and Devices and identities.",{"_2802":1122,"_24443":1122,"_5":12033,"_2329":43291,"_24758":43292,"_17120":43293,"_23194":1122},"Trust distribution and updates",[39790,41134,42065,42063,42246],[],{"_2802":1123,"_24443":1122,"_17120":43295,"_5":17015,"_23194":1122,"_2329":43296},[],"Separate roots, intermediates and initial TLS trust when distributing or migrating certificates.",{"_2802":1124,"_24443":1122,"_5":24755,"_17120":43298,"_23194":43299,"_2329":43300},[],"/docs/platform/iot-fleets/enrollment/trust-distribution#three-trust-relationships","Three trust relationships",{"_2802":1125,"_24443":1122,"_5":24755,"_17120":43302,"_23194":43303,"_2329":43304},[],"/docs/platform/iot-fleets/enrollment/trust-distribution#what-cacerts-returns","What cacerts returns",{"_2802":1126,"_24443":1122,"_5":24755,"_17120":43306,"_23194":43307,"_2329":43308},[],"/docs/platform/iot-fleets/enrollment/trust-distribution#install-the-required-material","Install the required material",{"_2802":1127,"_24443":1122,"_5":24755,"_17120":43310,"_23194":43311,"_2329":43312},[],"/docs/platform/iot-fleets/enrollment/trust-distribution#migrate-trust","Migrate trust",{"_2802":1128,"_24443":1122,"_5":24755,"_17120":43314,"_23194":43315,"_2329":43316},[],"/docs/platform/iot-fleets/enrollment/trust-distribution#check-the-update","Check the update",{"_2802":1129,"_24443":1122,"_17120":43318,"_5":17015,"_23194":1122,"_2329":43319},[],"This guide is for device and consumer trust administrators. You need issuer inventory, trust-store access and an authenticated update channel. Distributing certificates is separate from choosing trusted anchors.",{"_2802":1130,"_24443":1122,"_17120":43321,"_5":17015,"_23194":43299,"_2329":43322},[],"Relationship",{"_2802":1131,"_24443":1122,"_17120":43324,"_5":17015,"_23194":43299,"_2329":43325},[],"Material prepared by its owner",{"_2802":1132,"_24443":1122,"_17120":43327,"_5":17015,"_23194":43299,"_2329":43328},[],"Device → EST server",{"_2802":1133,"_24443":1122,"_17120":43330,"_5":17015,"_23194":43299,"_2329":43331},[],"Previously verified server root, chain or pin and TLS name.",{"_2802":1134,"_24443":1122,"_17120":43333,"_5":17015,"_23194":43299,"_2329":43334},[],"DMS → requester",{"_2802":1135,"_24443":1122,"_17120":43336,"_5":17015,"_23194":43299,"_2329":43337},[],"CAs and rules authorizing initial or renewal credentials.",{"_2802":1136,"_24443":1122,"_17120":43339,"_5":17015,"_23194":43299,"_2329":43340},[],"Consumer → device",{"_2802":1137,"_24443":1122,"_17120":43342,"_5":17015,"_23194":43299,"_2329":43343},[],"Operational identity roots, intermediates, validation and permissions.",{"_2802":1138,"_24443":1122,"_17120":43345,"_5":17015,"_23194":43299,"_2329":43346},[],"Obtaining a certificate does not automatically configure these relationships in third parties. Review the Trust model.",{"_2802":1139,"_24443":1122,"_17120":43348,"_5":17015,"_23194":43303,"_2329":43349},[],"The DMS may include the available downstream TLS certificate, selected Managed CAs and enrollment CA. Selecting the issuer does not include every ancestor. The set may contain leaves, roots and intermediates, including multiple hierarchies during migration.",{"_2802":1140,"_24443":1122,"_17120":43351,"_5":17015,"_23194":43303,"_2329":43352},[],"Position does not define the chain. Identify certificates by subject, issuer, AKI/SKI, signature and constraints. Download and inspect using EST client.",{"_2802":1141,"_24443":1122,"_17120":43354,"_5":17015,"_23194":43307,"_2329":43355},[],"Keep initial EST server trust separate from identity consumer trust.",{"_2802":1142,"_24443":1122,"_17120":43357,"_5":17015,"_23194":43307,"_2329":43358},[],"Select policy-approved roots as anchors.",{"_2802":1143,"_24443":1122,"_17120":43360,"_5":17015,"_23194":43307,"_2329":43361},[],"Retain intermediates for chain building or presentation; do not automatically turn them into roots.",{"_2802":1144,"_24443":1122,"_17120":43363,"_5":17015,"_23194":43307,"_2329":43364},[],"Present the leaf and required intermediates in mTLS. Normally the peer already trusts its root and does not need it sent.",{"_2802":1145,"_24443":1122,"_17120":43366,"_5":17015,"_23194":43307,"_2329":43367},[],"Verify chain, dates, names, usages and revocation from the consumer.",{"_2802":1146,"_24443":1122,"_17120":43369,"_5":17015,"_23194":43307,"_2329":43370},[],"Do not indiscriminately use all of `cacerts.pem` as `-CAfile`: this can expand trusted authorities, hide missing intermediates or trust a TLS leaf intended for another purpose.",{"_2802":1147,"_24443":1122,"_17120":43372,"_5":17015,"_23194":43311,"_2329":43373},[],"Before changing Enrollment CA, inventory disconnected equipment, bootstrap and operational certificates, and consumers. Distribute the new root and required intermediates; check that a cohort accepts both old and new chains.",{"_2802":1148,"_24443":1122,"_17120":43375,"_5":17015,"_23194":43311,"_2329":43376},[],"In the DMS, separate distributed CAs from `additional_validation_cas`, used for re-enrollment credentials. The inspected validator tries the enrollment CA followed by those CAs against the received leaf; accepting a multilevel chain requires checking what reaches the service and which issuer is configured.",{"_2802":1149,"_24443":1122,"_17120":43378,"_5":17015,"_23194":43311,"_2329":43379},[],"Switch issuance, renew in cohorts and compare the installed serial with the active slot. Remove previous trust once no legitimate equipment needs it and policy permits ending overlap. Follow Hierarchy and rotation for the PKI operation.",{"_2802":1150,"_24443":1122,"_17120":43381,"_5":17015,"_23194":43315,"_2329":43382},[],"Test an old identity allowed during overlap, a new one, an unknown chain and the result after removing old trust. Keep trust-store version, approved set, date and result. Reachable `/cacerts` establishes distribution only; it does not establish installation or acceptance across every device.",{"_2802":1151,"_24443":1151,"_5":12033,"_2329":43384,"_24758":43385,"_17120":43387,"_23194":1151},"AWS IoT Core",[39790,41134,42065,42063,43386],"Integrations",[],{"_2802":1152,"_24443":1151,"_17120":43389,"_5":17015,"_23194":1151,"_2329":43390},[],"Lamassu's connector for AWS IoT Core syncs device identities with the AWS platform, handling CA registration, Thing provisioning and certificate lifecycle automatically and event-driven.",{"_2802":1153,"_24443":1151,"_5":24755,"_17120":43392,"_23194":43393,"_2329":43394},[],"/docs/platform/iot-fleets/integrations/aws-iot-core#connector-architecture","Connector architecture",{"_2802":1154,"_24443":1151,"_5":24755,"_17120":43396,"_23194":43397,"_2329":43398},[],"/docs/platform/iot-fleets/integrations/aws-iot-core#prerequisites","Prerequisites",{"_2802":1155,"_24443":1151,"_5":24755,"_17120":43400,"_23194":43401,"_2329":43402},[],"/docs/platform/iot-fleets/integrations/aws-iot-core#required-iam-permissions","Required IAM permissions",{"_2802":1156,"_24443":1151,"_5":24755,"_17120":43404,"_23194":43405,"_2329":43406},[],"/docs/platform/iot-fleets/integrations/aws-iot-core#configuration-parameters","Configuration parameters",{"_2802":1157,"_24443":1151,"_5":24755,"_17120":43408,"_23194":43409,"_2329":43410},[],"/docs/platform/iot-fleets/integrations/aws-iot-core#ca-registration-in-aws-iot-core","CA registration in AWS IoT Core",{"_2802":1158,"_24443":1151,"_5":24755,"_17120":43412,"_23194":43413,"_2329":43414},[],"/docs/platform/iot-fleets/integrations/aws-iot-core#how-to-request-registration","How to request registration",{"_2802":1159,"_24443":1151,"_5":24755,"_17120":43416,"_23194":43417,"_2329":43418},[],"/docs/platform/iot-fleets/integrations/aws-iot-core#primary-account","Primary Account",{"_2802":1160,"_24443":1151,"_5":24755,"_17120":43420,"_23194":43421,"_2329":43422},[],"/docs/platform/iot-fleets/integrations/aws-iot-core#secondary-account-sni-only","Secondary Account (SNI-only)",{"_2802":1161,"_24443":1151,"_5":24755,"_17120":43424,"_23194":43425,"_2329":43426},[],"/docs/platform/iot-fleets/integrations/aws-iot-core#dms-configuration","DMS configuration",{"_2802":1162,"_24443":1151,"_5":24755,"_17120":43428,"_23194":43429,"_2329":43430},[],"/docs/platform/iot-fleets/integrations/aws-iot-core#none-mode","`none` mode",{"_2802":1163,"_24443":1151,"_5":24755,"_17120":43432,"_23194":43433,"_2329":43434},[],"/docs/platform/iot-fleets/integrations/aws-iot-core#auto-mode","`auto` mode",{"_2802":1164,"_24443":1151,"_5":24755,"_17120":43436,"_23194":43437,"_2329":43438},[],"/docs/platform/iot-fleets/integrations/aws-iot-core#jitp-mode","`jitp` mode",{"_2802":1165,"_24443":1151,"_5":24755,"_17120":43440,"_23194":43441,"_2329":43442},[],"/docs/platform/iot-fleets/integrations/aws-iot-core#device-provisioning-automatic-mode","Device provisioning (automatic mode)",{"_2802":1166,"_24443":1151,"_5":24755,"_17120":43444,"_23194":43445,"_2329":43446},[],"/docs/platform/iot-fleets/integrations/aws-iot-core#device-provisioning-jitp-mode","Device provisioning (JITP mode)",{"_2802":1167,"_24443":1151,"_5":24755,"_17120":43448,"_23194":43449,"_2329":43450},[],"/docs/platform/iot-fleets/integrations/aws-iot-core#certificate-status-synchronization","Certificate status synchronization",{"_2802":1168,"_24443":1151,"_5":24755,"_17120":43452,"_23194":43453,"_2329":43454},[],"/docs/platform/iot-fleets/integrations/aws-iot-core#forced-disconnect-on-revocation","Forced disconnect on revocation",{"_2802":1169,"_24443":1151,"_5":24755,"_17120":43456,"_23194":43457,"_2329":43458},[],"/docs/platform/iot-fleets/integrations/aws-iot-core#device-shadow-and-automation","Device Shadow and automation",{"_2802":1170,"_24443":1151,"_5":24755,"_17120":43460,"_23194":43461,"_2329":43462},[],"/docs/platform/iot-fleets/integrations/aws-iot-core#what-the-connector-writes-to-the-shadow","What the connector writes to the shadow",{"_2802":1171,"_24443":1151,"_5":24755,"_17120":43464,"_23194":43465,"_2329":43466},[],"/docs/platform/iot-fleets/integrations/aws-iot-core#aws-iot-policies","AWS IoT policies",{"_2802":1172,"_24443":1151,"_5":24755,"_17120":43468,"_23194":43469,"_2329":43470},[],"/docs/platform/iot-fleets/integrations/aws-iot-core#troubleshooting","Troubleshooting",{"_2802":1173,"_24443":1151,"_17120":43472,"_5":17015,"_23194":1151,"_2329":43473},[],"Lamassu's integration with AWS IoT Core bridges the PKI managed by Lamassu and AWS's connectivity platform. When a device obtains its certificate through the EST enrollment process, the connector ensures that certificate and its associated identity are recognized in AWS IoT Core without manual intervention. The result is that the device can authenticate directly to AWS with the same X.509 certificate Lamassu issued.",{"_2802":1174,"_24443":1151,"_17120":43475,"_5":17015,"_23194":1151,"_2329":43476},[],"From a protocol standpoint, the device authenticates to AWS IoT Core via mutual TLS (mTLS): it presents its Lamassu-issued X.509 certificate as the client certificate, and AWS IoT Core verifies the certificate chain up to the CA registered in the account. Lamassu acts as the certification authority (CA); the connector ensures that CA is registered in AWS and that the device's certificate is known to the platform before the device attempts to connect (in `auto` mode) or on its first connection (in JITP mode).",{"_2802":1175,"_24443":1151,"_17120":43478,"_5":17015,"_23194":1151,"_2329":43479},[],"This document is aimed both at the PKI administrator, who needs to configure the connector and register CAs, and at the device firmware developer, who needs to understand how Things are named, how the Device Shadow works and what happens when a certificate is revoked. For the firmware developer, the most important fact is that **the AWS Thing name (ThingName) always corresponds to the Common Name (CN) of the certificate issued by Lamassu**, regardless of the provisioning mode.",{"_2802":1176,"_24443":1151,"_17120":43481,"_5":17015,"_23194":43393,"_2329":43482},[],"The AWS IoT Core connector is an independent Go process, a binary or container separate from Lamassu's core. In a monolithic deployment it is compiled by default (build tag `!noaws`) and activated with `aws_iot_manager.enabled: true` in the configuration file. In distributed deployments, it runs as its own container with access to Lamassu's CA, DMS Manager and Device Manager services over HTTP.",{"_2802":1177,"_24443":1151,"_17120":43484,"_5":17015,"_23194":43393,"_2329":43485},[],"The connector does not poll Lamassu's services periodically. Instead, it **subscribes to Lamassu's internal event bus** (AMQP or AWS SQS/SNS, configurable) and reacts to the events it cares about: CA creation or update, DMS creation or update, device identity binding, certificate status change, certificate metadata update and device metadata update. This event-driven model ensures synchronization with AWS is nearly immediate and produces no polling load.",{"_2802":1178,"_24443":1151,"_17120":43487,"_5":17015,"_23194":43393,"_2329":43488},[],"To avoid infinite loops, the connector ignores any event whose CloudEvent `source` field matches its own origin URI. This prevents the metadata writes the connector itself performs from re-triggering the same flow.",{"_2802":1179,"_24443":1151,"_17120":43490,"_5":17015,"_23194":43393,"_2329":43491},[],"When several connectors run in parallel, for example for different AWS accounts, each instance has its own `connector_id`. All metadata the connector writes to Lamassu is stored under the key `lamassu.io/iot/{connector_id}`, allowing coexistence without collisions.",{"_2802":1180,"_24443":1151,"_17120":43493,"_5":17015,"_23194":43397,"_2329":43494},[],"Before enabling the connector you need an AWS account with the proper IAM permissions and the connector correctly configured. The deployment process (Docker Compose, Kubernetes or binary) is described in the deployment documentation.",{"_2802":1181,"_24443":1151,"_17120":43496,"_5":17015,"_23194":43401,"_2329":43497},[],"The IAM identity operating the connector needs at minimum the following permissions on the target account's resources:",{"_2802":1182,"_24443":1151,"_17120":43499,"_5":17015,"_23194":43401,"_2329":43500},[],"IAM action",{"_2802":1183,"_24443":1151,"_17120":43502,"_5":17015,"_23194":43401,"_2329":40173},[],{"_2802":1184,"_24443":1151,"_17120":43504,"_5":17015,"_23194":43401,"_2329":43505},[],"`iot:GetRegistrationCode`",{"_2802":1185,"_24443":1151,"_17120":43507,"_5":17015,"_23194":43401,"_2329":43508},[],"Obtain the verification code for CA registration in the Primary Account",{"_2802":1186,"_24443":1151,"_17120":43510,"_5":17015,"_23194":43401,"_2329":43511},[],"`iot:RegisterCACertificate`",{"_2802":1187,"_24443":1151,"_17120":43513,"_5":17015,"_23194":43401,"_2329":43514},[],"Register the CA in AWS IoT",{"_2802":1188,"_24443":1151,"_17120":43516,"_5":17015,"_23194":43401,"_2329":43517},[],"`iot:DescribeCACertificate`",{"_2802":1189,"_24443":1151,"_17120":43519,"_5":17015,"_23194":43401,"_2329":43520},[],"Check the CA registration status",{"_2802":1190,"_24443":1151,"_17120":43522,"_5":17015,"_23194":43401,"_2329":43523},[],"`iot:CreateThing` / `iot:UpdateThing`",{"_2802":1191,"_24443":1151,"_17120":43525,"_5":17015,"_23194":43401,"_2329":43526},[],"Create or update Things in IoT Core",{"_2802":1192,"_24443":1151,"_17120":43528,"_5":17015,"_23194":43401,"_2329":43529},[],"`iot:RegisterThing`",{"_2802":1193,"_24443":1151,"_17120":43531,"_5":17015,"_23194":43401,"_2329":43532},[],"Provision Things through a template",{"_2802":1194,"_24443":1151,"_17120":43534,"_5":17015,"_23194":43401,"_2329":43535},[],"`iot:RegisterCertificate`",{"_2802":1195,"_24443":1151,"_17120":43537,"_5":17015,"_23194":43401,"_2329":43538},[],"Register device certificates",{"_2802":1196,"_24443":1151,"_17120":43540,"_5":17015,"_23194":43401,"_2329":43541},[],"`iot:UpdateCertificate`",{"_2802":1197,"_24443":1151,"_17120":43543,"_5":17015,"_23194":43401,"_2329":43544},[],"Change a certificate's status (ACTIVE / INACTIVE / REVOKED)",{"_2802":1198,"_24443":1151,"_17120":43546,"_5":17015,"_23194":43401,"_2329":43547},[],"`iot:CreatePolicy` / `iot:AttachPolicy`",{"_2802":1199,"_24443":1151,"_17120":43549,"_5":17015,"_23194":43401,"_2329":43550},[],"Create and attach IoT policies",{"_2802":1200,"_24443":1151,"_17120":43552,"_5":17015,"_23194":43401,"_2329":43553},[],"`iot:CreateThingGroup` / `iot:AddThingToThingGroup`",{"_2802":1201,"_24443":1151,"_17120":43555,"_5":17015,"_23194":43401,"_2329":43556},[],"Manage Thing groups",{"_2802":1202,"_24443":1151,"_17120":43558,"_5":17015,"_23194":43401,"_2329":43559},[],"`iot:CreateProvisioningTemplate`",{"_2802":1203,"_24443":1151,"_17120":43561,"_5":17015,"_23194":43401,"_2329":43562},[],"Create JITP templates",{"_2802":1204,"_24443":1151,"_17120":43564,"_5":17015,"_23194":43401,"_2329":43565},[],"`iotdata:GetThingShadow` / `iotdata:UpdateThingShadow`",{"_2802":1205,"_24443":1151,"_17120":43567,"_5":17015,"_23194":43401,"_2329":43568},[],"Read and write the Device Shadow",{"_2802":1206,"_24443":1151,"_17120":43570,"_5":17015,"_23194":43401,"_2329":43571},[],"The forced-disconnect mechanism after revocation also requires access to the AWS IoT data plane API (`iot:Connect` with SigV4 over WebSocket), negotiated implicitly with the connector's credentials.",{"_2802":1207,"_24443":1151,"_17120":43573,"_5":17015,"_23194":43405,"_2329":43574},[],"Parameter",{"_2802":1208,"_24443":1151,"_17120":43576,"_5":17015,"_23194":43405,"_2329":43577},[],"Type",{"_2802":1209,"_24443":1151,"_17120":43579,"_5":17015,"_23194":43405,"_2329":43580},[],"Required",{"_2802":1210,"_24443":1151,"_17120":43582,"_5":17015,"_23194":43405,"_2329":43583},[],"Description",{"_2802":1211,"_24443":1151,"_17120":43585,"_5":17015,"_23194":43405,"_2329":43586},[],"`connector_id`",{"_2802":1212,"_24443":1151,"_17120":43588,"_5":17015,"_23194":43405,"_2329":20415},[],{"_2802":1213,"_24443":1151,"_17120":43590,"_5":17015,"_23194":43405,"_2329":43591},[],"Yes",{"_2802":1214,"_24443":1151,"_17120":43593,"_5":17015,"_23194":43405,"_2329":43594},[],"Unique identifier of this connector instance. Used as the metadata namespace: `lamassu.io/iot/{connector_id}`.",{"_2802":1215,"_24443":1151,"_17120":43596,"_5":17015,"_23194":43405,"_2329":43597},[],"`aws_config.region`",{"_2802":1216,"_24443":1151,"_17120":43599,"_5":17015,"_23194":43405,"_2329":20415},[],{"_2802":1217,"_24443":1151,"_17120":43601,"_5":17015,"_23194":43405,"_2329":43591},[],{"_2802":1218,"_24443":1151,"_17120":43603,"_5":17015,"_23194":43405,"_2329":43604},[],"AWS region where the connector operates.",{"_2802":1219,"_24443":1151,"_17120":43606,"_5":17015,"_23194":43405,"_2329":43607},[],"`aws_config.auth_method`",{"_2802":1220,"_24443":1151,"_17120":43609,"_5":17015,"_23194":43405,"_2329":20415},[],{"_2802":1221,"_24443":1151,"_17120":43611,"_5":17015,"_23194":43405,"_2329":43591},[],{"_2802":1222,"_24443":1151,"_17120":43613,"_5":17015,"_23194":43405,"_2329":43614},[],"Authentication method: `static`, `role` or empty (SDK default credential chain).",{"_2802":1223,"_24443":1151,"_17120":43616,"_5":17015,"_23194":43405,"_2329":43617},[],"`aws_config.access_key_id`",{"_2802":1224,"_24443":1151,"_17120":43619,"_5":17015,"_23194":43405,"_2329":20415},[],{"_2802":1225,"_24443":1151,"_17120":43621,"_5":17015,"_23194":43405,"_2329":43622},[],"Only with `auth_method=static`",{"_2802":1226,"_24443":1151,"_17120":43624,"_5":17015,"_23194":43405,"_2329":43625},[],"AWS access key.",{"_2802":1227,"_24443":1151,"_17120":43627,"_5":17015,"_23194":43405,"_2329":43628},[],"`aws_config.secret_access_key`",{"_2802":1228,"_24443":1151,"_17120":43630,"_5":17015,"_23194":43405,"_2329":20415},[],{"_2802":1229,"_24443":1151,"_17120":43632,"_5":17015,"_23194":43405,"_2329":43622},[],{"_2802":1230,"_24443":1151,"_17120":43634,"_5":17015,"_23194":43405,"_2329":43635},[],"AWS secret key.",{"_2802":1231,"_24443":1151,"_17120":43637,"_5":17015,"_23194":43405,"_2329":43638},[],"`aws_config.session_token`",{"_2802":1232,"_24443":1151,"_17120":43640,"_5":17015,"_23194":43405,"_2329":20415},[],{"_2802":1233,"_24443":1151,"_17120":43642,"_5":17015,"_23194":43405,"_2329":43643},[],"No",{"_2802":1234,"_24443":1151,"_17120":43645,"_5":17015,"_23194":43405,"_2329":43646},[],"Session token (with `auth_method=static`).",{"_2802":1235,"_24443":1151,"_17120":43648,"_5":17015,"_23194":43405,"_2329":43649},[],"`aws_config.role_arn`",{"_2802":1236,"_24443":1151,"_17120":43651,"_5":17015,"_23194":43405,"_2329":20415},[],{"_2802":1237,"_24443":1151,"_17120":43653,"_5":17015,"_23194":43405,"_2329":43654},[],"Only with `auth_method=role`",{"_2802":1238,"_24443":1151,"_17120":43656,"_5":17015,"_23194":43405,"_2329":43657},[],"ARN of the role to assume.",{"_2802":1239,"_24443":1151,"_17120":43659,"_5":17015,"_23194":43405,"_2329":43660},[],"`aws_config.endpoint_url`",{"_2802":1240,"_24443":1151,"_17120":43662,"_5":17015,"_23194":43405,"_2329":20415},[],{"_2802":1241,"_24443":1151,"_17120":43664,"_5":17015,"_23194":43405,"_2329":43643},[],{"_2802":1242,"_24443":1151,"_17120":43666,"_5":17015,"_23194":43405,"_2329":43667},[],"Alternative URL for all AWS services (useful with LocalStack in tests).",{"_2802":1243,"_24443":1151,"_17120":43669,"_5":17015,"_23194":43405,"_2329":43670},[],"`subscriber_event_bus`",{"_2802":1244,"_24443":1151,"_17120":43672,"_5":17015,"_23194":43405,"_2329":14397},[],{"_2802":1245,"_24443":1151,"_17120":43674,"_5":17015,"_23194":43405,"_2329":43591},[],{"_2802":1246,"_24443":1151,"_17120":43676,"_5":17015,"_23194":43405,"_2329":43677},[],"Configuration of the event bus the connector subscribes to (AMQP or AWS SQS/SNS).",{"_2802":1247,"_24443":1151,"_17120":43679,"_5":17015,"_23194":43405,"_2329":43680},[],"`dms_manager_client`",{"_2802":1248,"_24443":1151,"_17120":43682,"_5":17015,"_23194":43405,"_2329":20415},[],{"_2802":1249,"_24443":1151,"_17120":43684,"_5":17015,"_23194":43405,"_2329":43591},[],{"_2802":1250,"_24443":1151,"_17120":43686,"_5":17015,"_23194":43405,"_2329":43687},[],"HTTP URL of Lamassu's DMS Manager service.",{"_2802":1251,"_24443":1151,"_17120":43689,"_5":17015,"_23194":43405,"_2329":43690},[],"`device_manager_client`",{"_2802":1252,"_24443":1151,"_17120":43692,"_5":17015,"_23194":43405,"_2329":20415},[],{"_2802":1253,"_24443":1151,"_17120":43694,"_5":17015,"_23194":43405,"_2329":43591},[],{"_2802":1254,"_24443":1151,"_17120":43696,"_5":17015,"_23194":43405,"_2329":43697},[],"HTTP URL of Lamassu's Device Manager.",{"_2802":1255,"_24443":1151,"_17120":43699,"_5":17015,"_23194":43405,"_2329":43700},[],"`ca_client`",{"_2802":1256,"_24443":1151,"_17120":43702,"_5":17015,"_23194":43405,"_2329":20415},[],{"_2802":1257,"_24443":1151,"_17120":43704,"_5":17015,"_23194":43405,"_2329":43591},[],{"_2802":1258,"_24443":1151,"_17120":43706,"_5":17015,"_23194":43405,"_2329":43707},[],"HTTP URL of Lamassu's CA service.",{"_2802":1259,"_24443":1151,"_17120":43709,"_5":17015,"_23194":43409,"_2329":43710},[],"For devices to authenticate to AWS IoT Core with certificates issued by a Lamassu CA, that CA must first be registered in the AWS account. The connector handles this registration automatically in response to the `EventCreateCAKey`, `EventImportCAKey` and `EventUpdateCAMetadataKey` events, but the operation **only fires when the administrator explicitly requests it** through the CA metadata field.",{"_2802":1260,"_24443":1151,"_17120":43712,"_5":17015,"_23194":43413,"_2329":43713},[],"Registration is triggered by setting `registration.status = \"REQUESTED\"` on the `lamassu.io/iot/{connector_id}` key of the CA's metadata. This can be done from the Lamassu console in the CA management section or through the API.",{"_2802":1261,"_24443":1151,"_17120":43715,"_5":17015,"_23194":43413,"_2329":43716},[],"Once the event is received, the connector attempts to register the CA in AWS and updates the `registration.status` field in the CA's metadata with the result: `\"SUCCEEDED\"` if registration was successful, or `\"FAILED\"` with an error message otherwise. The process is asynchronous, so you must periodically check the metadata status until the operation completes.",{"_2802":1262,"_24443":1151,"_17120":43718,"_5":17015,"_23194":43417,"_2329":43719},[],"When the `primary_account` parameter is `true`, the connector runs the full registration flow with proof-of-possession of the private key:",{"_2802":1263,"_24443":1151,"_17120":43721,"_5":17015,"_23194":43417,"_2329":43722},[],"It calls `iot:GetRegistrationCode` to obtain AWS's verification code.",{"_2802":1264,"_24443":1151,"_17120":43724,"_5":17015,"_23194":43417,"_2329":43725},[],"The connector internally generates an ephemeral RSA-2048 key pair and builds a CSR whose Common Name is exactly that registration code. It then calls Lamassu's signing service so the registered CA issues a real X.509 verification certificate signing that CSR. The ephemeral private key is used only for this purpose and is neither stored nor sent to AWS.",{"_2802":1265,"_24443":1151,"_17120":43727,"_5":17015,"_23194":43417,"_2329":43728},[],"It sends the CA (in PEM) and the verification certificate to AWS via `iot:RegisterCACertificate`, enabling registration with `AllowAutoRegistration: true`.",{"_2802":1266,"_24443":1151,"_17120":43730,"_5":17015,"_23194":43417,"_2329":43731},[],"Only one account can own a CA in a given AWS region. If the CA is already registered with the same serial number, the connector silently skips the step.",{"_2802":1267,"_24443":1151,"_17120":43733,"_5":17015,"_23194":43417,"_2329":43734},[],"The tags AWS IoT Core applies to the registered CA certificate are `LMS.CA.ID`, `LMS.CA.SN` and `LMS.CA.CN`.",{"_2802":1268,"_24443":1151,"_17120":43736,"_5":17015,"_23194":43421,"_2329":43737},[],"When `primary_account` is `false`, the connector registers the CA using `CertificateMode: SNI_ONLY`. This mode requires no verification code or access to the CA's private key, so it is the right choice when the CA is managed from another AWS account or when the administrator does not hold the private key. It is the usual method to register the same CA in several AWS accounts simultaneously.",{"_2802":1269,"_24443":1151,"_17120":43739,"_5":17015,"_23194":43425,"_2329":43740},[],"Each DMS participating in the AWS IoT Core integration must have the metadata key `lamassu.io/iot/{connector_id}` configured. The most important field of that configuration is `registration_mode`, which determines how devices are provisioned in AWS.",{"_2802":1270,"_24443":1151,"_17120":43742,"_5":17015,"_23194":43425,"_2329":43743},[],"There are three registration modes, and the choice among them depends on the fleet's provisioning strategy.",{"_2802":1271,"_24443":1151,"_17120":43745,"_5":17015,"_23194":43429,"_2329":43746},[],"In this mode the connector **creates no Things, groups or policies** in AWS IoT Core. It only syncs certificate status (active, revoked, suspended) as it changes in Lamassu. It is the right mode when Thing provisioning in AWS is managed by an external system and Lamassu only needs to keep certificate status up to date.",{"_2802":1272,"_24443":1151,"_17120":43748,"_5":17015,"_23194":43433,"_2329":43749},[],"`auto` mode delegates full device provisioning in AWS to Lamassu at enrollment time. When the device successfully completes its EST enrollment and Lamassu emits the `EventBindDeviceIdentityKey` event, the connector automatically executes the following sequence:",{"_2802":1273,"_24443":1151,"_17120":43751,"_5":17015,"_23194":43433,"_2329":43752},[],"Creates or updates the IoT policies configured in the DMS.",{"_2802":1274,"_24443":1151,"_17120":43754,"_5":17015,"_23194":43433,"_2329":43755},[],"Creates the root group `LAMASSU` in the AWS account (if it does not exist) and the child groups configured in the DMS as subgroups of `LAMASSU`. If the groups already exist, the `ResourceAlreadyExistsException` error is ignored, making the operation idempotent.",{"_2802":1275,"_24443":1151,"_17120":43757,"_5":17015,"_23194":43433,"_2329":43758},[],"If the Thing already existed in AWS IoT Core, the connector iterates all certificates (principals) currently attached to that Thing and marks them as `REVOKED` in AWS, ensuring previous certificates cannot keep being used to authenticate.",{"_2802":1276,"_24443":1151,"_17120":43760,"_5":17015,"_23194":43433,"_2329":43761},[],"Calls `iot:RegisterThing` with a CloudFormation-style provisioning template that creates the Thing, registers the device's certificate (PEM of the device certificate and of the issuing CA certificate) and attaches the configured policies.",{"_2802":1277,"_24443":1151,"_17120":43763,"_5":17015,"_23194":43433,"_2329":43764},[],"Once provisioning completes, the connector stores the resulting certificate's ARN in the Lamassu certificate's metadata under the key `lamassu.io/iot/{connector_id}` and marks the device as `Registered: true` in Device Manager.",{"_2802":1278,"_24443":1151,"_17120":43766,"_5":17015,"_23194":43433,"_2329":43767},[],"**The Thing name in AWS is the Common Name (CN) of the device's certificate.** This convention is fundamental for the firmware developer: the `/CN=` value the device includes in its CSR when enrolling becomes the ThingName it must identify itself with in all MQTT operations against AWS IoT Core.",{"_2802":1279,"_24443":1151,"_17120":43769,"_5":17015,"_23194":43437,"_2329":43770},[],"Just-In-Time Provisioning (JITP) mode delegates provisioning to AWS instead of the connector doing it directly. When the connector detects the DMS is in `jitp` mode, it creates a JITP provisioning template in AWS IoT Core and attaches it to the registered CA certificate. This template is created or updated at the moment the DMS is created or updated in Lamassu — not at device enrollment time. From then on, when a device with a certificate issued by that CA connects to AWS IoT Core for the first time, AWS executes the template automatically: it creates the Thing, registers the certificate and activates it.",{"_2802":1280,"_24443":1151,"_17120":43772,"_5":17015,"_23194":43437,"_2329":43773},[],"The Thing name in the JITP template is derived from `AWS::IoT::Certificate::CommonName`, which corresponds to the device certificate's CN — the same convention as `auto` mode.",{"_2802":1281,"_24443":1151,"_17120":43775,"_5":17015,"_23194":43437,"_2329":43776},[],"This mode requires the `jitp_config.provisioning_role_arn` field to be configured with the ARN of an IAM role AWS IoT Core can assume to execute the template. If not configured, the connector uses the default `arn:aws:iam::{account}:role/JITPRole` and logs a warning. The administrator must ensure that role exists in the account and has the necessary permissions before enabling JITP mode.",{"_2802":1282,"_24443":1151,"_17120":43778,"_5":17015,"_23194":43441,"_2329":43779},[],"For the firmware developer, `auto` mode is transparent: the device performs its EST enrollment as usual and, as a side effect, it is provisioned in AWS IoT Core with no additional step.",{"_2802":1283,"_24443":1151,"_17120":43781,"_5":17015,"_23194":43441,"_2329":43782},[],"The full flow from the device's perspective is:",{"_2802":1284,"_24443":1151,"_17120":43784,"_5":17015,"_23194":43441,"_2329":43785},[],"Once the connector completes provisioning, the device can connect to the AWS IoT Core MQTT endpoint using its private key and the certificate issued by Lamassu. The ThingName it must identify itself with in AWS is exactly the certificate's CN.",{"_2802":1285,"_24443":1151,"_17120":43787,"_5":17015,"_23194":43445,"_2329":43788},[],"In JITP mode the device also performs its EST enrollment conventionally and obtains its certificate from Lamassu. The difference is that AWS IoT Core does not know the device until it attempts its first connection.",{"_2802":1286,"_24443":1151,"_17120":43790,"_5":17015,"_23194":43445,"_2329":43791},[],"When the device establishes its first MQTT connection to AWS IoT Core presenting the Lamassu-issued certificate, AWS detects that the certificate belongs to a CA registered with a JITP template, executes that template and creates the Thing automatically. The initial connection may fail or be delayed while the template runs; firmware must be prepared to retry the connection.",{"_2802":1287,"_24443":1151,"_17120":43793,"_5":17015,"_23194":43445,"_2329":43794},[],"For the JITP flow to work correctly:",{"_2802":1288,"_24443":1151,"_17120":43796,"_5":17015,"_23194":43445,"_2329":43797},[],"The CA must be registered in AWS in Primary Account mode (SNI-only mode does not support JITP).",{"_2802":1289,"_24443":1151,"_17120":43799,"_5":17015,"_23194":43445,"_2329":43800},[],"The IAM role configured in `jitp_config.provisioning_role_arn` must exist and have permissions to create Things, register certificates and attach policies in the AWS account.",{"_2802":1290,"_24443":1151,"_17120":43802,"_5":17015,"_23194":43445,"_2329":43803},[],"The device must present both its certificate and the issuing CA's certificate in the TLS handshake with AWS IoT Core.",{"_2802":1291,"_24443":1151,"_17120":43805,"_5":17015,"_23194":43445,"_2329":43806},[],"Certificates provisioned via JITP **do not have the connector's metadata key** (`lamassu.io/iot/{connector_id}`) in Lamassu. As a consequence, status changes of those certificates in Lamassu are not automatically synced to AWS through the state synchronization mechanism described in the next section.",{"_2802":1292,"_24443":1151,"_17120":43808,"_5":17015,"_23194":43449,"_2329":43809},[],"The connector listens for the `EventUpdateCertificateStatusKey` event and, when a certificate holding the connector's metadata key changes status in Lamassu, replicates that change in AWS IoT Core. The following table shows the status mapping:",{"_2802":1293,"_24443":1151,"_17120":43811,"_5":17015,"_23194":43449,"_2329":43812},[],"Status in Lamassu",{"_2802":1294,"_24443":1151,"_17120":43814,"_5":17015,"_23194":43449,"_2329":43815},[],"Revocation reason",{"_2802":1295,"_24443":1151,"_17120":43817,"_5":17015,"_23194":43449,"_2329":43818},[],"Status in AWS IoT Core",{"_2802":1296,"_24443":1151,"_17120":43820,"_5":17015,"_23194":43449,"_2329":43821},[],"`Active`",{"_2802":1297,"_24443":1151,"_17120":43823,"_5":17015,"_23194":43449,"_2329":43824},[],"None",{"_2802":1298,"_24443":1151,"_17120":43826,"_5":17015,"_23194":43449,"_2329":43827},[],"`ACTIVE`",{"_2802":1299,"_24443":1151,"_17120":43829,"_5":17015,"_23194":43449,"_2329":43830},[],"`Revoked`",{"_2802":1300,"_24443":1151,"_17120":43832,"_5":17015,"_23194":43449,"_2329":43833},[],"`certificateHold`",{"_2802":1301,"_24443":1151,"_17120":43835,"_5":17015,"_23194":43449,"_2329":43836},[],"`INACTIVE`",{"_2802":1302,"_24443":1151,"_17120":43838,"_5":17015,"_23194":43449,"_2329":43830},[],{"_2802":1303,"_24443":1151,"_17120":43840,"_5":17015,"_23194":43449,"_2329":43841},[],"Any other reason",{"_2802":1304,"_24443":1151,"_17120":43843,"_5":17015,"_23194":43449,"_2329":43844},[],"`REVOKED`",{"_2802":1305,"_24443":1151,"_17120":43846,"_5":17015,"_23194":43449,"_2329":43847},[],"Only the `Active` and `Revoked` states produce a call to `iot:UpdateCertificate`. The other lifecycle states of Lamassu (`RenewalWindow`, `AboutToExpire`, `Expired`) are not synced to AWS IoT Core; the certificate status in AWS remains unchanged until the status in Lamassu becomes `Active` or `Revoked`.",{"_2802":1306,"_24443":1151,"_17120":43849,"_5":17015,"_23194":43453,"_2329":43850},[],"When the connector marks a certificate as `REVOKED` or `INACTIVE` in AWS, it additionally performs a forced disconnect of the device. To do so it opens an MQTT connection over WebSocket (with SigV4 authentication using the connector's credentials) to the AWS IoT Core data endpoint, using the certificate's CN as the MQTT client identifier, and closes it immediately. This terminates any active MQTT session the device may have at that moment.",{"_2802":1307,"_24443":1151,"_17120":43852,"_5":17015,"_23194":43453,"_2329":43853},[],"This forced disconnect happens at the moment Lamassu records the status change. If the device tries to reconnect after the disconnect, AWS IoT Core will reject the connection because the certificate is already listed as `REVOKED` or `INACTIVE`.",{"_2802":1308,"_24443":1151,"_17120":43855,"_5":17015,"_23194":43453,"_2329":43856},[],"Certificates provisioned in JITP mode do not have this automatic sync, since they lack the connector's metadata key.",{"_2802":1309,"_24443":1151,"_17120":43858,"_5":17015,"_23194":43457,"_2329":43859},[],"The connector can write to the AWS IoT Core Device Shadow to send action signals to the device firmware. This feature is enabled per DMS with `shadow_config.enable: true`.",{"_2802":1310,"_24443":1151,"_17120":43861,"_5":17015,"_23194":43457,"_2329":43862},[],"If `shadow_config.shadow_name` holds a value, the connector uses a Named Shadow with that name; otherwise it uses the Classic Shadow (the Thing's default shadow).",{"_2802":1311,"_24443":1151,"_17120":43864,"_5":17015,"_23194":43461,"_2329":43865},[],"The connector writes to the `desired.identity_actions` field of the shadow document. Each entry contains a Unix timestamp in milliseconds. The device firmware must read this field and act accordingly.",{"_2802":1312,"_24443":1151,"_17120":43867,"_5":17015,"_23194":43461,"_2329":43868},[],"There are two action types:",{"_2802":1313,"_24443":1151,"_17120":43870,"_5":17015,"_23194":43461,"_2329":43871},[],"**`UPDATE_CERTIFICATE`**: written when a certificate's preventive renewal window activates — that is, when the `triggered` field of the preventive renewal delta flips from `false` to `true`. This action tells the device it must start the re-enrollment process to renew its certificate before it expires.",{"_2802":1314,"_24443":1151,"_17120":43873,"_5":17015,"_23194":43461,"_2329":43874},[],"**`UPDATE_TRUST_ANCHOR_LIST`**: written to all devices of a DMS when the DMS's `ManagedCAs` list changes. This action tells the device it must update its trusted CA store.",{"_2802":1315,"_24443":1151,"_17120":43876,"_5":17015,"_23194":43461,"_2329":43877},[],"The shadow write process consists of reading the current shadow (`iotdata:GetThingShadow`), merging the new actions with the existing ones and writing the result (`iotdata:UpdateThingShadow`). If the shadow does not exist, the connector creates it. After a successful write, the list of pending actions in the device's metadata in Lamassu is cleared.",{"_2802":1316,"_24443":1151,"_17120":43879,"_5":17015,"_23194":43465,"_2329":43880},[],"The connector creates and attaches the policies configured in the DMS. A typical policy for a device using MQTT and the Device Shadow has this structure:",{"_2802":1317,"_24443":1151,"_17120":43882,"_5":17015,"_23194":43465,"_2329":43883},[],"In the policy above, the `<AWS_REGION>` and `<AWS_ACCOUNT_ID>` placeholders must be replaced with the AWS region and the twelve-digit account identifier of the target account before applying the policy. The `${iot:Connection.Thing.ThingName}` variable automatically limits each permission to the Thing the device is connected as, following the principle of least privilege. The `${ShadowName}` variable in the shadow ARNs is a placeholder that must be replaced with the `shadow_config.shadow_name` value configured in the DMS; if the Classic Shadow is used, it can be simplified by removing the `name/${ShadowName}/` segment. AWS IoT policies do not support regex alternation; the `[name/${ShadowName}/]*` notation represents the optionality of that segment within ARN syntax constraints.",{"_2802":1318,"_24443":1151,"_17120":43885,"_5":17015,"_23194":43465,"_2329":43886},[],"The first statement lets the device connect using its ThingName as the MQTT identifier. The second authorizes publishing to the Thing's generic MQTT topic and to the shadow topics, needed so the device can update its reported state. The last two statements grant subscribe and receive permissions over the same topics, letting the device receive shadow updates (for example, the `UPDATE_CERTIFICATE` and `UPDATE_TRUST_ANCHOR_LIST` actions written by the connector).",{"_2802":1319,"_24443":1151,"_17120":43888,"_5":17015,"_23194":43469,"_2329":43889},[],"**Symptom:** The CA registration stays in `REQUESTED` indefinitely.",{"_2802":1320,"_24443":1151,"_17120":43891,"_5":17015,"_23194":43469,"_2329":43892},[],"**Cause:** The connector is not running or is not subscribed to the event bus. It can also indicate incorrect IAM credentials, insufficient permissions or that the metadata key was written with a wrong `connector_id`.",{"_2802":1321,"_24443":1151,"_17120":43894,"_5":17015,"_23194":43469,"_2329":43895},[],"**Resolution:** Verify the connector process is active and the logs show no AWS communication errors. Check the metadata field was written under the exact key `lamassu.io/iot/{connector_id}`. If the error persists, the connector will update the status to `FAILED` with a descriptive message in the CA metadata.",{"_2802":1322,"_24443":1151,"_17120":43897,"_5":17015,"_23194":43469,"_2329":43898},[],"**Symptom:** A certificate's status is not synced to AWS after a revocation.",{"_2802":1323,"_24443":1151,"_17120":43900,"_5":17015,"_23194":43469,"_2329":43901},[],"**Cause:** Most commonly the certificate was provisioned in JITP mode. JITP certificates lack the connector's metadata key and are outside the state synchronization mechanism. If the DMS is in `auto` mode, it may indicate the initial provisioning did not complete correctly and the AWS ARN was not stored in the certificate metadata.",{"_2802":1324,"_24443":1151,"_17120":43903,"_5":17015,"_23194":43469,"_2329":43904},[],"**Resolution:** For JITP certificates, migrate the DMS to `auto` mode and re-provision the affected devices. For `auto` mode certificates, verify the certificate has the AWS ARN stored in its metadata; if not, repeat the provisioning.",{"_2802":1325,"_24443":1151,"_17120":43906,"_5":17015,"_23194":43469,"_2329":43907},[],"**Symptom:** The forced disconnect does not terminate the device's MQTT session after revocation.",{"_2802":1326,"_24443":1151,"_17120":43909,"_5":17015,"_23194":43469,"_2329":43910},[],"**Cause:** The device uses an MQTT client ID different from the certificate's CN. The forced disconnect opens a connection using the CN as client ID; if the firmware uses another identifier, the disconnect does not affect that session.",{"_2802":1327,"_24443":1151,"_17120":43912,"_5":17015,"_23194":43469,"_2329":43913},[],"**Resolution:** Make sure the firmware uses exactly the certificate's CN as the MQTT client identifier. That CN matches the ThingName in AWS IoT Core.",{"_2802":1328,"_24443":1151,"_17120":43915,"_5":17015,"_23194":43469,"_2329":43916},[],"**Symptom:** The device receives `CLIENT_ID_REJECTED` when connecting to AWS IoT Core.",{"_2802":1329,"_24443":1151,"_17120":43918,"_5":17015,"_23194":43469,"_2329":43919},[],"**Cause:** The MQTT client ID does not match the ThingName, which is always the CN of the certificate issued by Lamassu.",{"_2802":1330,"_24443":1151,"_17120":43921,"_5":17015,"_23194":43469,"_2329":43922},[],"**Resolution:** Verify the firmware uses exactly the value of the CN field included in the enrollment CSR as the MQTT client identifier.",{"_2802":1331,"_24443":1151,"_17120":43924,"_5":17015,"_23194":43469,"_2329":43925},[],"**Symptom:** The device's first MQTT connection in JITP mode fails or times out.",{"_2802":1332,"_24443":1151,"_17120":43927,"_5":17015,"_23194":43469,"_2329":43928},[],"**Cause:** This is expected behavior while AWS executes the JITP template on the device's first connection.",{"_2802":1333,"_24443":1151,"_17120":43930,"_5":17015,"_23194":43469,"_2329":43931},[],"**Resolution:** Firmware must implement retries with exponential backoff for the first connection. If the failure persists beyond a few minutes, verify the IAM role configured in `jitp_config.provisioning_role_arn` exists in the account and has permissions to create Things, register certificates and attach policies.",{"_2802":1334,"_24443":1151,"_17120":43933,"_5":17015,"_23194":43469,"_2329":43934},[],"**Symptom:** The Device Shadow is not updated when it should be.",{"_2802":1335,"_24443":1151,"_17120":43936,"_5":17015,"_23194":43469,"_2329":43937},[],"**Cause:** The shadow feature is disabled in the DMS configuration, the connector's credentials lack IoT data-plane permissions, or the firmware reads a different shadow than the configured one.",{"_2802":1336,"_24443":1151,"_17120":43939,"_5":17015,"_23194":43469,"_2329":43940},[],"**Resolution:** Check that `shadow_config.enable` is `true` in the connector metadata for the corresponding DMS. If a Named Shadow is used, verify `shadow_config.shadow_name` holds the correct name and that the firmware reads that Named Shadow and not the Classic Shadow. Confirm the connector's credentials have `iotdata:GetThingShadow` and `iotdata:UpdateThingShadow` permissions.",{"_2802":1337,"_24443":1151,"_17120":43942,"_5":17015,"_23194":43469,"_2329":43943},[],"<Card title=\"Configure a DMS\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_2802":1338,"_24443":1151,"_17120":43945,"_5":17015,"_23194":43469,"_2329":43946},[],"<Card title=\"Device enrollment (EST)\" href=\"/docs/platform/iot-fleets/enrollment/overview\" />",{"_2802":1339,"_24443":1151,"_17120":43948,"_5":17015,"_23194":43469,"_2329":43949},[],"<Card title=\"Certificate management\" href=\"/docs/platform/pki/certificates\" />",{"_2802":1340,"_24443":1340,"_5":12033,"_2329":42065,"_24758":43951,"_17120":43952,"_23194":1340},[39790,41134,42065],[],{"_2802":1341,"_24443":1340,"_17120":43954,"_5":17015,"_23194":1340,"_2329":43955},[],"Organize devices and their identities, prepare enrollment and integrate consumers.",{"_2802":1342,"_24443":1340,"_5":24755,"_17120":43957,"_23194":43958,"_2329":43959},[],"/docs/platform/iot-fleets/overview#start-here","Start here",{"_2802":1343,"_24443":1340,"_5":24755,"_17120":43961,"_23194":43962,"_2329":42063},[],"/docs/platform/iot-fleets/overview#devices-and-identities",{"_2802":1344,"_24443":1340,"_5":24755,"_17120":43964,"_23194":43965,"_2329":42246},[],"/docs/platform/iot-fleets/overview#enrollment-with-pki",{"_2802":1345,"_24443":1340,"_5":24755,"_17120":43967,"_23194":43968,"_2329":43386},[],"/docs/platform/iot-fleets/overview#integrations",{"_2802":1346,"_24443":1340,"_5":24755,"_17120":43970,"_23194":43971,"_2329":43972},[],"/docs/platform/iot-fleets/overview#who-prepares-each-part","Who prepares each part",{"_2802":1347,"_24443":1340,"_17120":43974,"_5":17015,"_23194":1340,"_2329":43975},[],"IoT Fleets applies PKI to the device lifecycle: registration, obtaining an identity, renewal and retirement. It is intended for those who administer a device population and those who integrate its enrollment client or the system that accepts it.",{"_2802":1348,"_24443":1340,"_17120":43977,"_5":17015,"_23194":43958,"_2329":43978},[],"Follow Enroll and connect your first device to prepare a DMS, obtain the identity from the client and demonstrate an mTLS connection. The automatic path includes initial trust, a CSR and result checks.",{"_2802":1349,"_24443":1340,"_17120":43980,"_5":17015,"_23194":43958,"_2329":43981},[],"To start with an existing certificate, use Register a device manually. You can then prepare enrollment and renewal for the next device.",{"_2802":1350,"_24443":1340,"_17120":43983,"_5":17015,"_23194":43962,"_2329":43984},[],"Resource",{"_2802":1351,"_24443":1340,"_17120":43986,"_5":17015,"_23194":43962,"_2329":43987},[],"What it represents",{"_2802":1352,"_24443":1340,"_17120":43989,"_5":17015,"_23194":43962,"_2329":43990},[],"**Device**",{"_2802":1353,"_24443":1340,"_17120":43992,"_5":17015,"_23194":43962,"_2329":43993},[],"An inventory entry with an identifier, owning DMS and classification.",{"_2802":1354,"_24443":1340,"_17120":43995,"_5":17015,"_23194":43962,"_2329":43996},[],"**Identity**",{"_2802":1355,"_24443":1340,"_17120":43998,"_5":17015,"_23194":43962,"_2329":43999},[],"The device's association with its certificates: an active version and a history.",{"_2802":1356,"_24443":1340,"_17120":44001,"_5":17015,"_23194":43962,"_2329":44002},[],"**DMS**",{"_2802":1357,"_24443":1340,"_17120":44004,"_5":17015,"_23194":43962,"_2329":44005},[],"The service that configures admission, enrollment, renewal and trust distribution.",{"_2802":1358,"_24443":1340,"_17120":44007,"_5":17015,"_23194":43962,"_2329":44008},[],"**Fleet**",{"_2802":1359,"_24443":1340,"_17120":44010,"_5":17015,"_23194":43962,"_2329":44011},[],"The population you operate, represented through devices, DMSs, tags and metadata.",{"_2802":1360,"_24443":1340,"_17120":44013,"_5":17015,"_23194":43962,"_2329":44014},[],"Each device has an owning DMS. You can organize a population through several DMSs when it needs different policies, and use tags to classify it. “Fleet” describes that operational context; the resources you create and query are DMSs and devices.",{"_2802":1361,"_24443":1340,"_17120":44016,"_5":17015,"_23194":43962,"_2329":44017},[],"Device management covers states, certificate history and identity actions. During renewal, retain the relationship with the device and check which certificate becomes the current identity.",{"_2802":1362,"_24443":1340,"_17120":44019,"_5":17015,"_23194":43965,"_2329":44020},[],"This section connects PKI rules to the device client. Preparation follows this order:",{"_2802":1363,"_24443":1340,"_17120":44022,"_5":17015,"_23194":43965,"_2329":44023},[],"**CA and profile:** prepare the issuer and certificate rules in PKI.",{"_2802":1364,"_24443":1340,"_17120":44025,"_5":17015,"_23194":43965,"_2329":44026},[],"**DMS policy:** define how the device is admitted, how requests authenticate and which trust is distributed.",{"_2802":1365,"_24443":1340,"_17120":44028,"_5":17015,"_23194":43965,"_2329":44029},[],"**Client:** prepare the initial credential, server trust, and key generation or custody.",{"_2802":1366,"_24443":1340,"_17120":44031,"_5":17015,"_23194":43965,"_2329":44032},[],"**Result:** request the certificate, install it and check its association with the device.",{"_2802":1367,"_24443":1340,"_17120":44034,"_5":17015,"_23194":43965,"_2329":44035},[],"**Continuity:** configure renewal, successor installation and recovery according to DMS policy.",{"_2802":1368,"_24443":1340,"_17120":44037,"_5":17015,"_23194":43965,"_2329":44038},[],"<Card title=\"Configure the DMS\" description=\"Prepare the CA, admission, authentication and renewal rules.\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_2802":1369,"_24443":1340,"_17120":44040,"_5":17015,"_23194":43965,"_2329":44041},[],"<Card title=\"Integrate the EST client\" description=\"Review the device endpoints, formats and checks.\" href=\"/docs/platform/iot-fleets/enrollment/est-client\" />",{"_2802":1370,"_24443":1340,"_17120":44043,"_5":17015,"_23194":43968,"_2329":44044},[],"An issued identity needs a consumer that trusts its issuer, validates the certificate and grants the device permissions. Prepare both the device's trust in the server and the server's trust in the device.",{"_2802":1371,"_24443":1340,"_17120":44046,"_5":17015,"_23194":43968,"_2329":44047},[],"The AWS IoT Core guide explains how to use the identity in that destination. Provisioning in Lamassu and provisioning in the destination are separate decisions; review the conditions of the chosen mode before expecting state synchronization.",{"_2802":1372,"_24443":1340,"_17120":44049,"_5":17015,"_23194":43971,"_2329":44050},[],"Participant",{"_2802":1373,"_24443":1340,"_17120":44052,"_5":17015,"_23194":43971,"_2329":44053},[],"Responsibility",{"_2802":1374,"_24443":1340,"_17120":44055,"_5":17015,"_23194":43971,"_2329":44056},[],"PKI administrator",{"_2802":1375,"_24443":1340,"_17120":44058,"_5":17015,"_23194":43971,"_2329":44059},[],"CA, issuance profile, chain and revocation publication.",{"_2802":1376,"_24443":1340,"_17120":44061,"_5":17015,"_23194":43971,"_2329":44062},[],"Provisioning administrator",{"_2802":1377,"_24443":1340,"_17120":44064,"_5":17015,"_23194":43971,"_2329":44065},[],"DMS, admission, authentication per operation and inventory.",{"_2802":1378,"_24443":1340,"_17120":44067,"_5":17015,"_23194":43971,"_2329":44068},[],"Device integrator",{"_2802":1379,"_24443":1340,"_17120":44070,"_5":17015,"_23194":43971,"_2329":44071},[],"Initial credential, key, EST client, trust and certificate installation.",{"_2802":1380,"_24443":1340,"_17120":44073,"_5":17015,"_23194":43971,"_2329":44074},[],"Consumer integrator",{"_2802":1381,"_24443":1340,"_17120":44076,"_5":17015,"_23194":43971,"_2329":44077},[],"Trusted issuers, validation and device permissions in the destination.",{"_2802":1382,"_24443":1340,"_17120":44079,"_5":17015,"_23194":43971,"_2329":44080},[],"Permissions and audit are shared with the rest of Platform. Prepare installation and instance connectivity in Deployment.",{"_2802":1383,"_24443":1383,"_5":12033,"_2329":44082,"_24758":44083,"_17120":44085,"_23194":1383},"Enroll and connect your first device",[39790,41134,42065,44084],"Getting started",[],{"_2802":1384,"_24443":1383,"_17120":44087,"_5":17015,"_23194":1383,"_2329":44088},[],"Obtain an identity through EST, verify its association and use it in an mTLS connection.",{"_2802":1385,"_24443":1383,"_5":24755,"_17120":44090,"_23194":44091,"_2329":39800},[],"/docs/platform/iot-fleets/quickstarts/enroll-device#before-you-begin",{"_2802":1386,"_24443":1383,"_5":24755,"_17120":44093,"_23194":44094,"_2329":44095},[],"/docs/platform/iot-fleets/quickstarts/enroll-device#prepare-the-bootstrap-credential","Prepare the bootstrap credential",{"_2802":1387,"_24443":1383,"_5":24755,"_17120":44097,"_23194":44098,"_2329":44099},[],"/docs/platform/iot-fleets/quickstarts/enroll-device#configure-the-evaluation-dms","Configure the evaluation DMS",{"_2802":1388,"_24443":1383,"_5":24755,"_17120":44101,"_23194":44102,"_2329":44103},[],"/docs/platform/iot-fleets/quickstarts/enroll-device#prepare-the-client-and-check-cacerts","Prepare the client and check cacerts",{"_2802":1389,"_24443":1383,"_5":24755,"_17120":44105,"_23194":44106,"_2329":44107},[],"/docs/platform/iot-fleets/quickstarts/enroll-device#enroll-the-device","Enroll the device",{"_2802":1390,"_24443":1383,"_5":24755,"_17120":44109,"_23194":44110,"_2329":44111},[],"/docs/platform/iot-fleets/quickstarts/enroll-device#verify-the-obtained-identity","Verify the obtained identity",{"_2802":1391,"_24443":1383,"_5":24755,"_17120":44113,"_23194":44114,"_2329":44115},[],"/docs/platform/iot-fleets/quickstarts/enroll-device#demonstrate-an-mtls-connection","Demonstrate an mTLS connection",{"_2802":1392,"_24443":1383,"_5":24755,"_17120":44117,"_23194":44118,"_2329":44119},[],"/docs/platform/iot-fleets/quickstarts/enroll-device#result-and-continuity","Result and continuity",{"_2802":1393,"_24443":1383,"_17120":44121,"_5":17015,"_23194":1383,"_2329":44122},[],"Prepare an evaluation DMS, enroll `est-device-001` from the client and use its identity with a local consumer that requires a certificate. The path connects administrator policy to the material the device actually installs.",{"_2802":1394,"_24443":1383,"_17120":44124,"_5":17015,"_23194":44091,"_2329":44125},[],"A Lamassu instance accessible through HTTPS and permissions for CAs, profiles, DMSs and reading devices/certificates.",{"_2802":1395,"_24443":1383,"_17120":44127,"_5":17015,"_23194":44091,"_2329":44128},[],"Bash, OpenSSL 3.x, curl with `--fail-with-body` and two terminals on your computer. Work in a new directory with restricted access.",{"_2802":1396,"_24443":1383,"_17120":44130,"_5":17015,"_23194":44091,"_2329":44131},[],"An active root CA that issues directly, with an available key and sufficient validity. Follow Create your first CA. Save its verified public certificate as `device-root.pem`.",{"_2802":1397,"_24443":1383,"_17120":44133,"_5":17015,"_23194":44091,"_2329":44134},[],"Available global identifier `est-device-001`. This path uses automatic registration: do not create the device in the console first.",{"_2802":1398,"_24443":1383,"_17120":44136,"_5":17015,"_23194":44091,"_2329":44137},[],"The approved root for Lamassu HTTPS in `est-trust.pem`, obtained through an independent channel. It can differ from the device CA; prepare networking/TLS in Deployment.",{"_2802":1399,"_24443":1383,"_17120":44139,"_5":17015,"_23194":44094,"_2329":44140},[],"Issue a bootstrap leaf certificate with `CN=est-device-001`, its own key and Client Authentication use. Follow Issue and verify a certificate, changing its CN and saving the result as `bootstrap.crt` and `bootstrap.key`. Choose validity that covers this test and check the pair and chain.",{"_2802":1400,"_24443":1383,"_17120":44142,"_5":17015,"_23194":44094,"_2329":44143},[],"The same root CA can issue it for this isolated evaluation. The operational identity will have a different key and certificate. The matching CN makes the example easier to read; initial certificate authentication does not itself bind the bootstrap CN to the requested ID. Review admission before applying the policy to a population.",{"_2802":1401,"_24443":1383,"_17120":44145,"_5":17015,"_23194":44098,"_2329":44146},[],"Create an explicit leaf profile compatible with EC P-256, with **Honor Subject**, CN from the CSR, **Digital Signature**, **Client Authentication** and **1 hour** validity within the root's validity. Do not enable CA signing. Rules and precedence are explained in Profiles.",{"_2802":1402,"_24443":1383,"_17120":44148,"_5":17015,"_23194":44098,"_2329":44149},[],"Create the `Acme EST Evaluation` DMS with this configuration:",{"_2802":1403,"_24443":1383,"_17120":44151,"_5":17015,"_23194":44098,"_2329":44152},[],"Setting",{"_2802":1404,"_24443":1383,"_17120":44154,"_5":17015,"_23194":44098,"_2329":44155},[],"Evaluation value",{"_2802":1405,"_24443":1383,"_17120":44157,"_5":17015,"_23194":44098,"_2329":44158},[],"Enrollment CA",{"_2802":1406,"_24443":1383,"_17120":44160,"_5":17015,"_23194":44098,"_2329":44161},[],"Issuing root from `device-root.pem`.",{"_2802":1407,"_24443":1383,"_17120":44163,"_5":17015,"_23194":44098,"_2329":42372},[],{"_2802":1408,"_24443":1383,"_17120":44165,"_5":17015,"_23194":44098,"_2329":44166},[],"The 1-hour leaf profile you just prepared.",{"_2802":1409,"_24443":1383,"_17120":44168,"_5":17015,"_23194":44098,"_2329":44169},[],"Protocol / Registration Mode",{"_2802":1410,"_24443":1383,"_17120":44171,"_5":17015,"_23194":44098,"_2329":44172},[],"`EST_RFC7030` / `JITP`.",{"_2802":1411,"_24443":1383,"_17120":44174,"_5":17015,"_23194":44098,"_2329":44175},[],"Verify CSR Signature",{"_2802":1412,"_24443":1383,"_17120":44177,"_5":17015,"_23194":44098,"_2329":44178},[],"Enabled.",{"_2802":1413,"_24443":1383,"_17120":44180,"_5":17015,"_23194":44098,"_2329":44181},[],"Enable Replaceable Enrollment",{"_2802":1414,"_24443":1383,"_17120":44183,"_5":17015,"_23194":44098,"_2329":44184},[],"Disabled; the ID must be new.",{"_2802":1415,"_24443":1383,"_17120":44186,"_5":17015,"_23194":44098,"_2329":44187},[],"Initial authentication",{"_2802":1416,"_24443":1383,"_17120":44189,"_5":17015,"_23194":44098,"_2329":44190},[],"`CLIENT_CERTIFICATE`; Validation CAs includes the direct bootstrap issuer; no expired certificates.",{"_2802":1417,"_24443":1383,"_17120":44192,"_5":17015,"_23194":44098,"_2329":44193},[],"Renewal authentication",{"_2802":1418,"_24443":1383,"_17120":44195,"_5":17015,"_23194":44098,"_2329":44196},[],"`CLIENT_CERTIFICATE`, configured in the independent re-enrollment block.",{"_2802":1419,"_24443":1383,"_17120":44198,"_5":17015,"_23194":44098,"_2329":44199},[],"Additional Validation CAs / Enable Expired Renewal",{"_2802":1420,"_24443":1383,"_17120":44201,"_5":17015,"_23194":44098,"_2329":44202},[],"Empty list for this direct issuance / disabled.",{"_2802":1421,"_24443":1383,"_17120":44204,"_5":17015,"_23194":44098,"_2329":44205},[],"Re-enrollment Delta",{"_2802":1422,"_24443":1383,"_17120":44207,"_5":17015,"_23194":44098,"_2329":44208},[],"1 hour.",{"_2802":1423,"_24443":1383,"_17120":44210,"_5":17015,"_23194":44098,"_2329":44211},[],"Preventive / Critical Delta",{"_2802":1424,"_24443":1383,"_17120":44213,"_5":17015,"_23194":44098,"_2329":44214},[],"30 minutes / 10 minutes.",{"_2802":1425,"_24443":1383,"_17120":44216,"_5":17015,"_23194":44098,"_2329":44217},[],"Revoke on Re-enrollment",{"_2802":1426,"_24443":1383,"_17120":44219,"_5":17015,"_23194":44098,"_2329":44220},[],"Disabled to test the successor before retiring the previous identity.",{"_2802":1427,"_24443":1383,"_17120":44222,"_5":17015,"_23194":44098,"_2329":42380},[],{"_2802":1428,"_24443":1383,"_17120":44224,"_5":17015,"_23194":44098,"_2329":44225},[],"Disabled; the operational key is generated in the client.",{"_2802":1429,"_24443":1383,"_17120":44227,"_5":17015,"_23194":44098,"_2329":44228},[],"CA Distribution",{"_2802":1430,"_24443":1383,"_17120":44230,"_5":17015,"_23194":44098,"_2329":44231},[],"Include Enrollment CA enabled; Include Lamassu System CA disabled.",{"_2802":1431,"_24443":1383,"_17120":44233,"_5":17015,"_23194":44098,"_2329":44234},[],"Equal duration and window allow immediate renewal testing. These are evaluation values; size production settings according to connectivity and recovery times. Save, reread both authentication blocks and retain the DMS ID. If your console does not expose the independent block, configure and check the resource through the DMS API and DMS guide.",{"_2802":1432,"_24443":1383,"_17120":44236,"_5":17015,"_23194":44102,"_2329":44237},[],"Place the four trust and bootstrap files in the new directory. Replace the URL with your installation's URL:",{"_2802":1433,"_24443":1383,"_17120":44239,"_5":17015,"_23194":44102,"_2329":44240},[],"The download must succeed and contain the expected enrollment root. Compare its fingerprint with `device-root.pem`. This check does not turn the response into initial trust or prove that you can issue.",{"_2802":1434,"_24443":1383,"_17120":44242,"_5":17015,"_23194":44106,"_2329":44243},[],"Generate a new key and CSR with the selected identifier:",{"_2802":1435,"_24443":1383,"_17120":44245,"_5":17015,"_23194":44106,"_2329":44246},[],"Request the identity with the bootstrap credential and extract the certificate from the default response:",{"_2802":1436,"_24443":1383,"_17120":44248,"_5":17015,"_23194":44106,"_2329":44249},[],"If curl fails, use Troubleshooting with the saved body. Do not convert it or repeat the request without querying inventory: a timeout or error can follow persisted issuance.",{"_2802":1437,"_24443":1383,"_17120":44251,"_5":17015,"_23194":44110,"_2329":44252},[],"Expect `device.crt: OK` and exit code 0 from `cmp`. Check the CN, serial, dates, Digital Signature and Client Authentication. The certificate must be a leaf: it must not declare `CA:TRUE` or Certificate Sign use. Check that its validity matches the one-hour profile.",{"_2802":1438,"_24443":1383,"_17120":44254,"_5":17015,"_23194":44110,"_2329":44255},[],"In Lamassu, open `est-device-001`. It must be created with the intended owning DMS, a current identity and the received certificate in its history. Compare the local serial with the slot; thresholds can show a renewal state rather than simply Active.",{"_2802":1439,"_24443":1383,"_17120":44257,"_5":17015,"_23194":44114,"_2329":44258},[],"In a second terminal, enter the same directory and run `umask 077`. Create a local server certificate and start a test consumer. This server trusts `device-root.pem` and requires a valid client identity:",{"_2802":1440,"_24443":1383,"_17120":44260,"_5":17015,"_23194":44114,"_2329":44261},[],"Leave it running. In the first terminal, connect using the obtained identity:",{"_2802":1441,"_24443":1383,"_17120":44263,"_5":17015,"_23194":44114,"_2329":44264},[],"Expect HTTP `200`. The client's trust in this local server is its self-signed `consumer.crt`; the server verifies the device against `device-root.pem`. The HTML file displays OpenSSL diagnostic information.",{"_2802":1442,"_24443":1383,"_17120":44266,"_5":17015,"_23194":44114,"_2329":44267},[],"With the same server still running, test that a request without a client certificate is rejected:",{"_2802":1443,"_24443":1383,"_17120":44269,"_5":17015,"_23194":44114,"_2329":44270},[],"Rejection must correspond to a missing certificate at the server, not a stopped server. Stop the consumer with Ctrl+C after the test. This exercise demonstrates TLS authentication and key possession; your application must also define authorization and revocation consumption. Server options are described in openssl-s\\_server.",{"_2802":1444,"_24443":1383,"_17120":44272,"_5":17015,"_23194":44118,"_2329":44273},[],"Check",{"_2802":1445,"_24443":1383,"_17120":44275,"_5":17015,"_23194":44118,"_2329":44276},[],"Expected result",{"_2802":1446,"_24443":1383,"_17120":44278,"_5":17015,"_23194":44118,"_2329":44279},[],"Registration",{"_2802":1447,"_24443":1383,"_17120":44281,"_5":17015,"_23194":44118,"_2329":44282},[],"ID created automatically and correct DMS.",{"_2802":1448,"_24443":1383,"_17120":44284,"_5":17015,"_23194":44118,"_2329":44285},[],"Certificate",{"_2802":1449,"_24443":1383,"_17120":44287,"_5":17015,"_23194":44118,"_2329":44288},[],"CN, profile, serial and key verified.",{"_2802":1450,"_24443":1383,"_17120":44290,"_5":17015,"_23194":44118,"_2329":44291},[],"Inventory",{"_2802":1451,"_24443":1383,"_17120":44293,"_5":17015,"_23194":44118,"_2329":44294},[],"Received serial visible as the current identity and in history.",{"_2802":1452,"_24443":1383,"_17120":44296,"_5":17015,"_23194":44118,"_2329":44297},[],"Consumer",{"_2802":1453,"_24443":1383,"_17120":44299,"_5":17015,"_23194":44118,"_2329":44300},[],"mTLS responds 200 with the identity and rejects a missing certificate.",{"_2802":1454,"_24443":1383,"_17120":44302,"_5":17015,"_23194":44118,"_2329":44303},[],"Continue with Renewal and recovery to request a successor pair within the window, install it and repeat the mTLS check. The consumer must use the new files in that test. After checking the successor, retire the previous certificate according to PKI policy; the example does not revoke it automatically.",{"_2802":1455,"_24443":1383,"_17120":44305,"_5":17015,"_23194":44118,"_2329":44306},[],"Devices and identities explains retirement and the limits of historical revocation. For a real destination, prepare consumer trust, validation and permissions; AWS IoT Core is an available integration.",{"_2802":1456,"_24443":1456,"_5":12033,"_2329":42081,"_24758":44308,"_17120":44309,"_23194":1456},[39790,41134,42065,44084],[],{"_2802":1457,"_24443":1456,"_17120":44311,"_5":17015,"_23194":1456,"_2329":44312},[],"Prepare a DMS, register a device and associate a verified certificate with its identity.",{"_2802":1458,"_24443":1456,"_5":24755,"_17120":44314,"_23194":44315,"_2329":39800},[],"/docs/platform/iot-fleets/quickstarts/register-device#before-you-begin",{"_2802":1459,"_24443":1456,"_5":24755,"_17120":44317,"_23194":44318,"_2329":44319},[],"/docs/platform/iot-fleets/quickstarts/register-device#prepare-the-dms","Prepare the DMS",{"_2802":1460,"_24443":1456,"_5":24755,"_17120":44321,"_23194":44322,"_2329":44323},[],"/docs/platform/iot-fleets/quickstarts/register-device#register-the-device","Register the device",{"_2802":1461,"_24443":1456,"_5":24755,"_17120":44325,"_23194":44326,"_2329":44327},[],"/docs/platform/iot-fleets/quickstarts/register-device#check-the-initial-status","Check the initial status",{"_2802":1462,"_24443":1456,"_5":24755,"_17120":44329,"_23194":44330,"_2329":44331},[],"/docs/platform/iot-fleets/quickstarts/register-device#assign-an-identity","Assign an identity",{"_2802":1463,"_24443":1456,"_5":24755,"_17120":44333,"_23194":44334,"_2329":44335},[],"/docs/platform/iot-fleets/quickstarts/register-device#verify-the-device","Verify the device",{"_2802":1464,"_24443":1456,"_5":24755,"_17120":44337,"_23194":44338,"_2329":44276},[],"/docs/platform/iot-fleets/quickstarts/register-device#expected-result",{"_2802":1465,"_24443":1456,"_5":24755,"_17120":44340,"_23194":44341,"_2329":44342},[],"/docs/platform/iot-fleets/quickstarts/register-device#if-the-result-fails","If the result fails",{"_2802":1466,"_24443":1456,"_5":24755,"_17120":44344,"_23194":44345,"_2329":44346},[],"/docs/platform/iot-fleets/quickstarts/register-device#automate-the-next-device","Automate the next device",{"_2802":1467,"_24443":1456,"_17120":44348,"_5":17015,"_23194":1456,"_2329":44349},[],"This path is intended for those starting to administer device identities. You will register `device-001` and assign an existing certificate to check the relationship between device, DMS and identity history.",{"_2802":1468,"_24443":1456,"_17120":44351,"_5":17015,"_23194":1456,"_2329":44352},[],"Assignment updates Lamassu's inventory. Install the key and certificate separately on the device; check the connection to a consumer in that destination's integration.",{"_2802":1469,"_24443":1456,"_17120":44354,"_5":17015,"_23194":44315,"_2329":44355},[],"An accessible instance and permission to administer DMSs, devices and certificate associations.",{"_2802":1470,"_24443":1456,"_17120":44357,"_5":17015,"_23194":44315,"_2329":44358},[],"An active CA with an available key. If one does not exist yet, follow Create your first CA.",{"_2802":1471,"_24443":1456,"_17120":44360,"_5":17015,"_23194":44315,"_2329":44361},[],"An active end-entity certificate from that CA whose `Common Name` is exactly `device-001`, together with its private key. Follow Issue and verify a certificate to obtain and check both.",{"_2802":1472,"_24443":1456,"_17120":44363,"_5":17015,"_23194":44315,"_2329":44364},[],"The identifier `device-001` available in the inventory. If you already used it, choose another and issue the certificate with that same `Common Name`.",{"_2802":1473,"_24443":1456,"_17120":44366,"_5":17015,"_23194":44318,"_2329":44367},[],"A DMS must exist before registering the device. If you already have a suitable one, check its CA and note its identifier; to create one:",{"_2802":1474,"_24443":1456,"_17120":44369,"_5":17015,"_23194":44318,"_2329":44370},[],"Open the DMS inventory and its creation action. Assign a recognizable name, such as `Acme Evaluation DMS`.",{"_2802":1475,"_24443":1456,"_17120":44372,"_5":17015,"_23194":44318,"_2329":44373},[],"In **Enrollment CA**, select the CA that issued `device.crt`.",{"_2802":1476,"_24443":1456,"_17120":44375,"_5":17015,"_23194":44318,"_2329":44376},[],"In **Registration Mode**, select `PRE_REGISTRATION` for the path that starts with explicit registration.",{"_2802":1477,"_24443":1456,"_17120":44378,"_5":17015,"_23194":44318,"_2329":44379},[],"Set **Authentication Mode** to `CLIENT_CERTIFICATE` and add the CA whose initial certificates you will accept in **Validation CAs**. For this evaluation, it can be the same CA. Keep **Verify CSR Signature** enabled and server key generation disabled if you will not use it.",{"_2802":1478,"_24443":1456,"_17120":44381,"_5":17015,"_23194":44318,"_2329":44382},[],"Review renewal and trust distribution settings with the DMS guide, save the service and note its identifier.",{"_2802":1479,"_24443":1456,"_17120":44384,"_5":17015,"_23194":44318,"_2329":44385},[],"Reopen the DMS and confirm that the enrollment CA is the expected one and the service appears in inventory.",{"_2802":1480,"_24443":1456,"_17120":44387,"_5":17015,"_23194":44318,"_2329":44388},[],"These settings prepare DMS policy. The next steps register and assign through the console; they do not send an EST request or test admission through that protocol.",{"_2802":1481,"_24443":1456,"_17120":44390,"_5":17015,"_23194":44322,"_2329":44391},[],"Open **Managed Devices** and the registration action. Complete:",{"_2802":1482,"_24443":1456,"_17120":44393,"_5":17015,"_23194":44322,"_2329":44394},[],"**Device ID**: `device-001`.",{"_2802":1483,"_24443":1456,"_17120":44396,"_5":17015,"_23194":44322,"_2329":44397},[],"**Registration Authority**: the DMS you just prepared; this label identifies the service fulfilling the registration authority role.",{"_2802":1484,"_24443":1456,"_17120":44399,"_5":17015,"_23194":44322,"_2329":44400},[],"**Icon** and **Tags**: optional classification.",{"_2802":1485,"_24443":1456,"_17120":44402,"_5":17015,"_23194":44322,"_2329":44403},[],"Confirm registration.",{"_2802":1486,"_24443":1456,"_17120":44405,"_5":17015,"_23194":44326,"_2329":44406},[],"Open the device. It should appear in **No Identity** and show the selected owning DMS.",{"_2802":1487,"_24443":1456,"_17120":44408,"_5":17015,"_23194":44326,"_2329":44409},[],"Registration creates the inventory entry; the certificate must still be associated.",{"_2802":1488,"_24443":1456,"_17120":44411,"_5":17015,"_23194":44330,"_2329":44412},[],"Select **Assign Identity** and the existing certificate with `CN=device-001`. Check its serial number, issuer and validity against the certificate you verified in PKI.",{"_2802":1489,"_24443":1456,"_17120":44414,"_5":17015,"_23194":44330,"_2329":44415},[],"Confirm the association. The **Issue New Instead** alternative is explained in Devices and identities.",{"_2802":1490,"_24443":1456,"_17120":44417,"_5":17015,"_23194":44334,"_2329":44418},[],"Check that it has an active identity. In **Certificate History**, verify the associated serial number; in **Device Event Timeline**, find the assignment event.",{"_2802":1491,"_24443":1456,"_17120":44420,"_5":17015,"_23194":44334,"_2329":44421},[],"Keep the device identifier, owning DMS and serial number as references for the result.",{"_2802":1492,"_24443":1456,"_17120":44423,"_5":17015,"_23194":44338,"_2329":44273},[],{"_2802":1493,"_24443":1456,"_17120":44425,"_5":17015,"_23194":44338,"_2329":44426},[],"Result",{"_2802":1494,"_24443":1456,"_17120":44428,"_5":17015,"_23194":44338,"_2329":44429},[],"Device",{"_2802":1495,"_24443":1456,"_17120":44431,"_5":17015,"_23194":44338,"_2329":44432},[],"`device-001` appears in inventory with the expected DMS.",{"_2802":1496,"_24443":1456,"_17120":44434,"_5":17015,"_23194":44338,"_2329":44435},[],"Current identity",{"_2802":1497,"_24443":1456,"_17120":44437,"_5":17015,"_23194":44338,"_2329":44438},[],"The associated certificate matches the one you verified in PKI.",{"_2802":1498,"_24443":1456,"_17120":44440,"_5":17015,"_23194":44338,"_2329":44441},[],"History",{"_2802":1499,"_24443":1456,"_17120":44443,"_5":17015,"_23194":44338,"_2329":44444},[],"The associated issuance appears with its serial number and dates.",{"_2802":1500,"_24443":1456,"_17120":44446,"_5":17015,"_23194":44338,"_2329":44447},[],"Key and certificate",{"_2802":1501,"_24443":1456,"_17120":44449,"_5":17015,"_23194":44338,"_2329":44450},[],"You have the verified pair ready to install on the device.",{"_2802":1502,"_24443":1456,"_17120":44452,"_5":17015,"_23194":44341,"_2329":44453},[],"If you cannot select the DMS, confirm its creation and your read permissions.",{"_2802":1503,"_24443":1456,"_17120":44455,"_5":17015,"_23194":44341,"_2329":44456},[],"If no eligible certificate appears, check that its `Common Name` matches the `Device ID` exactly, it is active and it was issued by the expected CA.",{"_2802":1504,"_24443":1456,"_17120":44458,"_5":17015,"_23194":44341,"_2329":44459},[],"If assignment fails, review permissions and operation diagnostics before repeating it. Query the device and its history again to find the persisted result.",{"_2802":1505,"_24443":1456,"_17120":44461,"_5":17015,"_23194":44341,"_2329":44462},[],"If an expiration or renewal state appears, check certificate dates and DMS thresholds in Devices and identities.",{"_2802":1506,"_24443":1456,"_17120":44464,"_5":17015,"_23194":44345,"_2329":44465},[],"Continue with DMS and EST for the device to request and renew certificates. Prepare server trust, the initial credential and policies for each operation before implementing the client.",{"_2802":1507,"_24443":1456,"_17120":44467,"_5":17015,"_23194":44345,"_2329":44468},[],"For a path from the client through mTLS, follow Enroll and connect your first device with a new ID.",{"_2802":1508,"_24443":1456,"_17120":44470,"_5":17015,"_23194":44345,"_2329":44471},[],"To use the identity in AWS IoT Core, also prepare trust and permissions in the destination. Check the connection from the device after installing the required key, certificate and chain.",{"_2802":1509,"_24443":1509,"_5":12033,"_2329":44473,"_24758":44474,"_17120":44475,"_23194":1509},"Lamassu IoT Platform",[39790,41134],[],{"_2802":1510,"_24443":1509,"_17120":44477,"_5":17015,"_23194":1509,"_2329":44478},[],"Build a PKI and apply its certificates to your devices' lifecycle.",{"_2802":1511,"_24443":1509,"_5":24755,"_17120":44480,"_23194":44481,"_2329":43959},[],"/docs/platform/overview#start-here",{"_2802":1512,"_24443":1509,"_5":24755,"_17120":44483,"_23194":44484,"_2329":44485},[],"/docs/platform/overview#choose-your-path","Choose your path",{"_2802":1513,"_24443":1509,"_5":24755,"_17120":44487,"_23194":44488,"_2329":44489},[],"/docs/platform/overview#architecture-at-a-glance","Architecture at a glance",{"_2802":1514,"_24443":1509,"_5":24755,"_17120":44491,"_23194":44492,"_2329":44493},[],"/docs/platform/overview#core-capabilities","Core capabilities",{"_2802":1515,"_24443":1509,"_5":24755,"_17120":44495,"_23194":44496,"_2329":44497},[],"/docs/platform/overview#build-your-trust-hierarchy","Build your trust hierarchy",{"_2802":1516,"_24443":1509,"_5":24755,"_17120":44499,"_23194":44500,"_2329":44501},[],"/docs/platform/overview#protect-cryptographic-keys","Protect cryptographic keys",{"_2802":1517,"_24443":1509,"_5":24755,"_17120":44503,"_23194":44504,"_2329":44505},[],"/docs/platform/overview#issue-and-control-certificates","Issue and control certificates",{"_2802":1518,"_24443":1509,"_5":24755,"_17120":44507,"_23194":44508,"_2329":44509},[],"/docs/platform/overview#automate-device-identities","Automate device identities",{"_2802":1519,"_24443":1509,"_5":24755,"_17120":44511,"_23194":44512,"_2329":44513},[],"/docs/platform/overview#publish-validation-status","Publish validation status",{"_2802":1520,"_24443":1509,"_5":24755,"_17120":44515,"_23194":44516,"_2329":44517},[],"/docs/platform/overview#react-to-events","React to events",{"_2802":1521,"_24443":1509,"_5":24755,"_17120":44519,"_23194":44520,"_2329":44521},[],"/docs/platform/overview#operational-reference","Operational reference",{"_2802":1522,"_24443":1509,"_17120":44523,"_5":17015,"_23194":1509,"_2329":44524},[],"Lamassu IoT lets you administer a private PKI and use it to issue, renew and revoke X.509 device identities. The Platform documentation follows two paths: **PKI**, for authorities and certificates, and **IoT Fleets**, for applying those identities to a device population.",{"_2802":1523,"_24443":1509,"_17120":44526,"_5":17015,"_23194":44481,"_2329":44527},[],"Choose the result you need:",{"_2802":1524,"_24443":1509,"_17120":44529,"_5":17015,"_23194":44481,"_2329":44530},[],"<Card title=\"Issue and verify a certificate\" description=\"Prepare a CA, issue an X.509 identity and check its chain and key.\" href=\"/docs/platform/pki/quickstarts/overview\" />",{"_2802":1525,"_24443":1509,"_17120":44532,"_5":17015,"_23194":44481,"_2329":44533},[],"<Card title=\"Enroll and connect a device\" description=\"Prepare the DMS, request an identity through EST and check an mTLS connection.\" href=\"/docs/platform/iot-fleets/quickstarts/enroll-device\" />",{"_2802":1526,"_24443":1509,"_17120":44535,"_5":17015,"_23194":44481,"_2329":44536},[],"If you are still preparing the instance, start in Deployment. The Platform paths assume an accessible console and permission to perform the operations.",{"_2802":1527,"_24443":1509,"_17120":44538,"_5":17015,"_23194":44484,"_2329":44539},[],"Section",{"_2802":1528,"_24443":1509,"_17120":44541,"_5":17015,"_23194":44484,"_2329":44542},[],"What you manage",{"_2802":1529,"_24443":1509,"_17120":44544,"_5":17015,"_23194":44484,"_2329":44545},[],"Entry point",{"_2802":1530,"_24443":1509,"_17120":44547,"_5":17015,"_23194":44484,"_2329":44548},[],"**PKI**",{"_2802":1531,"_24443":1509,"_17120":44550,"_5":17015,"_23194":44484,"_2329":44551},[],"Keys, authorities, profiles, certificates and publication of revocation status.",{"_2802":1532,"_24443":1509,"_17120":44553,"_5":17015,"_23194":44484,"_2329":44554},[],"PKI overview",{"_2802":1533,"_24443":1509,"_17120":44556,"_5":17015,"_23194":44484,"_2329":44557},[],"**IoT Fleets**",{"_2802":1534,"_24443":1509,"_17120":44559,"_5":17015,"_23194":44484,"_2329":44560},[],"Devices, identity history, DMS policies, EST enrollment and integrations.",{"_2802":1535,"_24443":1509,"_17120":44562,"_5":17015,"_23194":44484,"_2329":44563},[],"IoT Fleets overview",{"_2802":1536,"_24443":1509,"_17120":44565,"_5":17015,"_23194":44484,"_2329":44566},[],"**Administration**",{"_2802":1537,"_24443":1509,"_17120":44568,"_5":17015,"_23194":44484,"_2329":44569},[],"Operator permissions, audit and event subscriptions.",{"_2802":1538,"_24443":1509,"_17120":44571,"_5":17015,"_23194":44484,"_2329":41132},[],{"_2802":1539,"_24443":1509,"_17120":44573,"_5":17015,"_23194":44484,"_2329":44574},[],"A CA determines who signs, and a profile defines what can be issued. The DMS applies admission and enrollment policy. The device retains its association with certificates, and the external consumer decides which identity it accepts.",{"_2802":1540,"_24443":1509,"_17120":44576,"_5":17015,"_23194":44488,"_2329":44577},[],"An identity's journey connects four responsibilities:",{"_2802":1541,"_24443":1509,"_17120":44579,"_5":17015,"_23194":44488,"_2329":44580},[],"The PKI administrator prepares the authority, its key and issuance rules.",{"_2802":1542,"_24443":1509,"_17120":44582,"_5":17015,"_23194":44488,"_2329":44583},[],"The provisioning administrator configures the DMS and initial trust.",{"_2802":1543,"_24443":1509,"_17120":44585,"_5":17015,"_23194":44488,"_2329":44586},[],"The device client requests a certificate and installs it with the matching key.",{"_2802":1544,"_24443":1509,"_17120":44588,"_5":17015,"_23194":44488,"_2329":44589},[],"The consumer validates the identity and applies its access permissions.",{"_2802":1545,"_24443":1509,"_17120":44591,"_5":17015,"_23194":44488,"_2329":44592},[],"See How Lamassu works to understand the resources and platform architecture for the services. Installation, network exposure and dependencies are explained in Deployment.",{"_2802":1546,"_24443":1509,"_17120":44594,"_5":17015,"_23194":44496,"_2329":44595},[],"Create or incorporate authorities and organize their relationships in PKI. The hierarchy and its rotation determine which chains consumers must recognize.",{"_2802":1547,"_24443":1509,"_17120":44597,"_5":17015,"_23194":44500,"_2329":44598},[],"Choose the engine that keeps authority keys and control who can use them. See Keys and engines; provider setup belongs to deployment.",{"_2802":1548,"_24443":1509,"_17120":44600,"_5":17015,"_23194":44504,"_2329":44601},[],"Define issuance profiles, sign requests and review the certificate inventory. Check the issued certificate from the client that will use it.",{"_2802":1549,"_24443":1509,"_17120":44603,"_5":17015,"_23194":44508,"_2329":44604},[],"Configure a DMS and use EST to request and renew certificates. Preparing the initial credential and installing the result belong to device integration.",{"_2802":1550,"_24443":1509,"_17120":44606,"_5":17015,"_23194":44512,"_2329":44607},[],"Use OCSP and CRL to publish revocation status. Each consumer must configure how it retrieves and applies that information.",{"_2802":1551,"_24443":1509,"_17120":44609,"_5":17015,"_23194":44516,"_2329":44610},[],"Use audit logs to investigate changes and configure alerts and subscriptions to react to lifecycle events.",{"_2802":1552,"_24443":1509,"_17120":44612,"_5":17015,"_23194":44520,"_2329":44053},[],{"_2802":1553,"_24443":1509,"_17120":44614,"_5":17015,"_23194":44520,"_2329":44615},[],"What it prepares or checks",{"_2802":1554,"_24443":1509,"_17120":44617,"_5":17015,"_23194":44520,"_2329":44056},[],{"_2802":1555,"_24443":1509,"_17120":44619,"_5":17015,"_23194":44520,"_2329":44620},[],"Key custody, CA hierarchy, profiles and validation.",{"_2802":1556,"_24443":1509,"_17120":44622,"_5":17015,"_23194":44520,"_2329":44623},[],"Fleet administrator",{"_2802":1557,"_24443":1509,"_17120":44625,"_5":17015,"_23194":44520,"_2329":44626},[],"DMS, device admission, renewal policy and inventory.",{"_2802":1558,"_24443":1509,"_17120":44628,"_5":17015,"_23194":44520,"_2329":44068},[],{"_2802":1559,"_24443":1509,"_17120":44630,"_5":17015,"_23194":44520,"_2329":44631},[],"Initial credential, server trust, EST client, and key and certificate storage.",{"_2802":1560,"_24443":1509,"_17120":44633,"_5":17015,"_23194":44520,"_2329":44074},[],{"_2802":1561,"_24443":1509,"_17120":44635,"_5":17015,"_23194":44520,"_2329":44636},[],"Issuer trust, certificate validation and permissions in the destination.",{"_2802":1562,"_24443":1509,"_17120":44638,"_5":17015,"_23194":44520,"_2329":44639},[],"Infrastructure operator",{"_2802":1563,"_24443":1509,"_17120":44641,"_5":17015,"_23194":44520,"_2329":44642},[],"Installation, network, availability, dependencies and deployment diagnosis.",{"_2802":1564,"_24443":1509,"_17120":44644,"_5":17015,"_23194":44520,"_2329":44645},[],"The API reference contains contracts for automating operations. To investigate a failure, start in the affected section: PKI, EST or Deployment.",{"_2802":1565,"_24443":1565,"_5":12033,"_2329":44647,"_24758":44648,"_17120":44651,"_23194":1565},"CA hierarchy and rotation",[39790,41134,44649,44650],"PKI","Keys, authorities and certificates",[],{"_2802":1566,"_24443":1565,"_17120":44653,"_5":17015,"_23194":1565,"_2329":44654},[],"Design root and intermediate authorities and replace certificates or keys without breaking trust.",{"_2802":1567,"_24443":1565,"_5":24755,"_17120":44656,"_23194":44657,"_2329":44658},[],"/docs/platform/pki/ca-hierarchy-and-rotation#design-the-hierarchy","Design the hierarchy",{"_2802":1568,"_24443":1565,"_5":24755,"_17120":44660,"_23194":44661,"_2329":44662},[],"/docs/platform/pki/ca-hierarchy-and-rotation#reissuance-and-rotation-are-not-the-same","Reissuance and rotation are not the same",{"_2802":1569,"_24443":1565,"_5":24755,"_17120":44664,"_23194":44665,"_2329":44666},[],"/docs/platform/pki/ca-hierarchy-and-rotation#when-to-choose-each-operation","When to choose each operation",{"_2802":1570,"_24443":1565,"_5":24755,"_17120":44668,"_23194":44669,"_2329":44670},[],"/docs/platform/pki/ca-hierarchy-and-rotation#key-rotation-procedure","Key rotation procedure",{"_2802":1571,"_24443":1565,"_5":24755,"_17120":44672,"_23194":44673,"_2329":44674},[],"/docs/platform/pki/ca-hierarchy-and-rotation#inventory-the-dependencies","Inventory the dependencies",{"_2802":1572,"_24443":1565,"_5":24755,"_17120":44676,"_23194":44677,"_2329":44678},[],"/docs/platform/pki/ca-hierarchy-and-rotation#create-the-successor-ca","Create the successor CA",{"_2802":1573,"_24443":1565,"_5":24755,"_17120":44680,"_23194":44681,"_2329":44682},[],"/docs/platform/pki/ca-hierarchy-and-rotation#distribute-the-new-trust","Distribute the new trust",{"_2802":1574,"_24443":1565,"_5":24755,"_17120":44684,"_23194":44685,"_2329":44686},[],"/docs/platform/pki/ca-hierarchy-and-rotation#switch-issuance","Switch issuance",{"_2802":1575,"_24443":1565,"_5":24755,"_17120":44688,"_23194":44689,"_2329":44690},[],"/docs/platform/pki/ca-hierarchy-and-rotation#renew-in-batches","Renew in batches",{"_2802":1576,"_24443":1565,"_5":24755,"_17120":44692,"_23194":44693,"_2329":44694},[],"/docs/platform/pki/ca-hierarchy-and-rotation#close-the-overlap","Close the overlap",{"_2802":1577,"_24443":1565,"_5":24755,"_17120":44696,"_23194":44697,"_2329":44698},[],"/docs/platform/pki/ca-hierarchy-and-rotation#cascading-revocation","Cascading revocation",{"_2802":1578,"_24443":1565,"_5":24755,"_17120":44700,"_23194":44701,"_2329":44702},[],"/docs/platform/pki/ca-hierarchy-and-rotation#checks-after-the-change","Checks after the change",{"_2802":1579,"_24443":1565,"_17120":44704,"_5":17015,"_23194":1565,"_2329":44705},[],"The hierarchy determines the blast radius of any error or compromise. A root signs intermediate CAs; intermediates issue the identities used by devices and services. This separation lets you isolate environments and rotate a branch without replacing all trust.",{"_2802":1580,"_24443":1565,"_17120":44707,"_5":17015,"_23194":1565,"_2329":44708},[],"This procedure is for the PKI operator replacing an authority in use. You need access to CAs, keys and profiles, a dependency inventory and coordination with trust-store and device owners. Before switching issuance, prepare a test cohort and decide the criterion for ending overlap.",{"_2802":1581,"_24443":1565,"_17120":44710,"_5":17015,"_23194":44657,"_2329":44711},[],"For a production installation, use a very restricted root and one or more operational intermediates. Separate intermediates when any of these boundaries change:",{"_2802":1582,"_24443":1565,"_17120":44713,"_5":17015,"_23194":44657,"_2329":44714},[],"environment, such as production and preproduction;",{"_2802":1583,"_24443":1565,"_17120":44716,"_5":17015,"_23194":44657,"_2329":44717},[],"owner or operating team;",{"_2802":1584,"_24443":1565,"_17120":44719,"_5":17015,"_23194":44657,"_2329":44720},[],"device family or manufacturing process;",{"_2802":1585,"_24443":1565,"_17120":44722,"_5":17015,"_23194":44657,"_2329":44723},[],"region or regulatory requirement;",{"_2802":1586,"_24443":1565,"_17120":44725,"_5":17015,"_23194":44657,"_2329":44726},[],"cryptographic engine or key policy;",{"_2802":1587,"_24443":1565,"_17120":44728,"_5":17015,"_23194":44657,"_2329":44729},[],"maintenance window and renewal cadence.",{"_2802":1588,"_24443":1565,"_17120":44731,"_5":17015,"_23194":44657,"_2329":44732},[],"Avoid deep hierarchies without a concrete need. Each level adds chain distribution, validation and one more certificate you must renew.",{"_2802":1589,"_24443":1565,"_17120":44734,"_5":17015,"_23194":44657,"_2329":44735},[],"A child CA and its end-entity certificates must expire before their issuer. Reserve a margin that allows distributing another chain and renewing dependent certificates.",{"_2802":1590,"_24443":1565,"_17120":44737,"_5":17015,"_23194":44661,"_2329":44738},[],"**Reissuing a CA** creates a new certificate over the existing key. Lamassu generates a CSR with that key, self-signs it if it is a root or asks the parent CA to sign it if it is subordinate. The new certificate becomes active and the CA points to its serial number; the old and new certificates are linked through metadata.",{"_2802":1591,"_24443":1565,"_17120":44740,"_5":17015,"_23194":44661,"_2329":44741},[],"**Rotating a CA** creates a successor key and authority. It is the right choice in the face of compromise, a cryptographic change, an engine migration or non-exportable key policies.",{"_2802":1592,"_24443":1565,"_17120":44743,"_5":17015,"_23194":44661,"_2329":44744},[],"Lamassu does not allow reissuing an already-revoked CA or a CA whose expiration date has passed. Plan ahead for both conditions.",{"_2802":1593,"_24443":1565,"_17120":44746,"_5":17015,"_23194":44665,"_2329":44747},[],"Reissue if the key is still trustworthy and you only need another validity period or an updated certificate.",{"_2802":1594,"_24443":1565,"_17120":44749,"_5":17015,"_23194":44665,"_2329":44750},[],"Rotate the key if compromise is suspected, the algorithm changes or you want to move custody to another engine.",{"_2802":1595,"_24443":1565,"_17120":44752,"_5":17015,"_23194":44665,"_2329":44753},[],"Create a parallel branch if you cannot update all consumers at the same time.",{"_2802":1596,"_24443":1565,"_17120":44755,"_5":17015,"_23194":44665,"_2329":44756},[],"Revoke immediately only when the risk of keeping the CA outweighs the impact of interrupting the fleet.",{"_2802":1597,"_24443":1565,"_17120":44758,"_5":17015,"_23194":44673,"_2329":44759},[],"Locate child CAs, issued certificates, DMSs, connectors and external trust stores. Include devices that may stay offline for weeks or months.",{"_2802":1598,"_24443":1565,"_17120":44761,"_5":17015,"_23194":44677,"_2329":44762},[],"Generate a new key in the planned engine, create the CA and assign it an explicit profile. Do not reuse the operational identifier to hide that it is a different generation.",{"_2802":1599,"_24443":1565,"_17120":44764,"_5":17015,"_23194":44681,"_2329":44765},[],"Add the new root or chain to consumers before issuing with it. If distributing through EST `/cacerts`, explicitly include the required managed CAs and inspect the content; including the issuer does not automatically include every intermediate. Install the new trust in a cohort and verify that it still accepts the previous identity.",{"_2802":1600,"_24443":1565,"_17120":44767,"_5":17015,"_23194":44685,"_2329":44768},[],"Update the enrollment CA and profile of the DMSs. Keep the additional validation CAs if old certificates still need to be accepted during re-enrollment.",{"_2802":1601,"_24443":1565,"_17120":44770,"_5":17015,"_23194":44689,"_2329":44771},[],"Migrate a small cohort, validate mTLS, OCSP and CRL from the consumer and expand progressively. Monitor which devices still present the old chain.",{"_2802":1602,"_24443":1565,"_17120":44773,"_5":17015,"_23194":44693,"_2329":44774},[],"Once no legitimate consumer depends on the previous authority, remove it from issuance and from the distributed CAs. Revoke it if policy requires it.",{"_2802":1603,"_24443":1565,"_17120":44776,"_5":17015,"_23194":44697,"_2329":44777},[],"Lamassu saves the CA’s revocation, then attempts to revoke child CAs and issued certificates with `CessationOfOperation`. Propagation continues recursively through child CAs. This is not a transaction over the whole hierarchy: some resources may have changed while other updates failed.",{"_2802":1604,"_24443":1565,"_17120":44779,"_5":17015,"_23194":44697,"_2329":44780},[],"Resources in `EXPIRED` state and resources already revoked for a final reason reject further status transitions. Per-descendant failures are logged; review the inventory and logs even when the parent operation completes.",{"_2802":1605,"_24443":1565,"_17120":44782,"_5":17015,"_23194":44697,"_2329":44783},[],"`CertificateHold` allows reactivating the parent while it is not expired, but does not restore child CAs or certificates permanently revoked during the cascade. Holding a CA therefore does not provide a reversible pause for its entire branch.",{"_2802":1606,"_24443":1565,"_17120":44785,"_5":17015,"_23194":44697,"_2329":44786},[],"Before closing the change, compare the original dependency inventory with final states and verify revocation publication for each issuer. Do not use revocation as the ordinary mechanism to stop issuance: complete migration and remove the CA from operational flows.",{"_2802":1607,"_24443":1565,"_17120":44788,"_5":17015,"_23194":44701,"_2329":44789},[],"The new chain ends in an anchor installed by the consumer.",{"_2802":1608,"_24443":1565,"_17120":44791,"_5":17015,"_23194":44701,"_2329":44792},[],"New certificates contain the expected AKI, SKI, KU, EKU and SAN.",{"_2802":1609,"_24443":1565,"_17120":44794,"_5":17015,"_23194":44701,"_2329":44795},[],"The DMS delivers the correct chain through EST `/cacerts`.",{"_2802":1610,"_24443":1565,"_17120":44797,"_5":17015,"_23194":44701,"_2329":44798},[],"Re-enrollment accepts the old identity during the planned period.",{"_2802":1611,"_24443":1565,"_17120":44800,"_5":17015,"_23194":44701,"_2329":44801},[],"OCSP and CRL respond for the authorities that remain active.",{"_2802":1612,"_24443":1565,"_17120":44803,"_5":17015,"_23194":44701,"_2329":44804},[],"No DMS is left accidentally issuing from the old CA.",{"_2802":1613,"_24443":1565,"_17120":44806,"_5":17015,"_23194":44701,"_2329":44807},[],"See the Trust model to understand the DMS's CA sets and Certificate lifecycle for states and revocation effects.",{"_2802":1614,"_24443":1614,"_5":12033,"_2329":44809,"_24758":44810,"_17120":44811,"_23194":1614},"Certification authorities",[39790,41134,44649,44650],[],{"_2802":1615,"_24443":1614,"_17120":44813,"_5":17015,"_23194":1614,"_2329":44814},[],"Create, import and operate the authorities that establish your PKI's trust.",{"_2802":1616,"_24443":1614,"_5":24755,"_17120":44816,"_23194":44817,"_2329":44818},[],"/docs/platform/pki/certificate-authorities#choose-a-flow","Choose a flow",{"_2802":1617,"_24443":1614,"_5":24755,"_17120":44820,"_23194":44821,"_2329":44822},[],"/docs/platform/pki/certificate-authorities#create-a-new-authority","Create a new authority",{"_2802":1618,"_24443":1614,"_5":24755,"_17120":44824,"_23194":44825,"_2329":39800},[],"/docs/platform/pki/certificate-authorities#before-you-begin",{"_2802":1619,"_24443":1614,"_5":24755,"_17120":44827,"_23194":44828,"_2329":44829},[],"/docs/platform/pki/certificate-authorities#open-the-wizard","Open the wizard",{"_2802":1620,"_24443":1614,"_5":24755,"_17120":44831,"_23194":44832,"_2329":44833},[],"/docs/platform/pki/certificate-authorities#configure-the-key","Configure the key",{"_2802":1621,"_24443":1614,"_5":24755,"_17120":44835,"_23194":44836,"_2329":44837},[],"/docs/platform/pki/certificate-authorities#choose-the-ca-type","Choose the CA type",{"_2802":1622,"_24443":1614,"_5":24755,"_17120":44839,"_23194":44840,"_2329":44841},[],"/docs/platform/pki/certificate-authorities#define-the-identity","Define the identity",{"_2802":1623,"_24443":1614,"_5":24755,"_17120":44843,"_23194":44844,"_2329":44845},[],"/docs/platform/pki/certificate-authorities#configure-validity-and-uses","Configure validity and uses",{"_2802":1624,"_24443":1614,"_5":24755,"_17120":44847,"_23194":44848,"_2329":44849},[],"/docs/platform/pki/certificate-authorities#create-and-verify","Create and verify",{"_2802":1625,"_24443":1614,"_5":24755,"_17120":44851,"_23194":44852,"_2329":44853},[],"/docs/platform/pki/certificate-authorities#use-a-key-from-the-kms","Use a key from the KMS",{"_2802":1626,"_24443":1614,"_5":24755,"_17120":44855,"_23194":44856,"_2329":44857},[],"/docs/platform/pki/certificate-authorities#import-an-external-ca","Import an external CA",{"_2802":1627,"_24443":1614,"_5":24755,"_17120":44859,"_23194":44860,"_2329":44861},[],"/docs/platform/pki/certificate-authorities#select-the-engine","Select the engine",{"_2802":1628,"_24443":1614,"_5":24755,"_17120":44863,"_23194":44864,"_2329":44865},[],"/docs/platform/pki/certificate-authorities#load-the-material","Load the material",{"_2802":1629,"_24443":1614,"_5":24755,"_17120":44867,"_23194":44868,"_2329":44869},[],"/docs/platform/pki/certificate-authorities#define-the-default-issuance","Define the default issuance",{"_2802":1630,"_24443":1614,"_5":24755,"_17120":44871,"_23194":44872,"_2329":44873},[],"/docs/platform/pki/certificate-authorities#verify-the-import","Verify the import",{"_2802":1631,"_24443":1614,"_5":24755,"_17120":44875,"_23194":44876,"_2329":44877},[],"/docs/platform/pki/certificate-authorities#inspect-an-authority","Inspect an authority",{"_2802":1632,"_24443":1614,"_5":24755,"_17120":44879,"_23194":44880,"_2329":44881},[],"/docs/platform/pki/certificate-authorities#issue-certificates","Issue certificates",{"_2802":1633,"_24443":1614,"_5":24755,"_17120":44883,"_23194":44884,"_2329":44885},[],"/docs/platform/pki/certificate-authorities#revoke-a-ca","Revoke a CA",{"_2802":1634,"_24443":1614,"_5":24755,"_17120":44887,"_23194":44888,"_2329":44889},[],"/docs/platform/pki/certificate-authorities#assess-the-impact","Assess the impact",{"_2802":1635,"_24443":1614,"_5":24755,"_17120":44891,"_23194":44892,"_2329":44893},[],"/docs/platform/pki/certificate-authorities#start-the-revocation","Start the revocation",{"_2802":1636,"_24443":1614,"_5":24755,"_17120":44895,"_23194":44896,"_2329":44897},[],"/docs/platform/pki/certificate-authorities#confirm-the-identity","Confirm the identity",{"_2802":1637,"_24443":1614,"_5":24755,"_17120":44899,"_23194":44900,"_2329":44901},[],"/docs/platform/pki/certificate-authorities#check-the-publication","Check the publication",{"_2802":1638,"_24443":1614,"_17120":44903,"_5":17015,"_23194":1614,"_2329":44904},[],"A certification authority (CA) binds identities to public keys through signed certificates. In Lamassu you can create a new hierarchy, use a key already in the KMS or incorporate an external CA.",{"_2802":1639,"_24443":1614,"_17120":44906,"_5":17015,"_23194":1614,"_2329":44907},[],"To design a full chain or replace an authority in production, see CA hierarchy and rotation. If you need to standardize what each authority can sign, use Certificate profiles.",{"_2802":1640,"_24443":1614,"_17120":44909,"_5":17015,"_23194":1614,"_2329":44910},[],"To administer CAs, you need authority and key permissions, a reachable engine and a reviewed profile. An external consumer does not trust a CA merely because it appears in this inventory: agree root and chain distribution separately.",{"_2802":1641,"_24443":1614,"_17120":44912,"_5":17015,"_23194":44817,"_2329":44913},[],"**New CA with a new key:** create a root of trust from scratch. Lamassu generates and keeps the key pair.",{"_2802":1642,"_24443":1614,"_17120":44915,"_5":17015,"_23194":44817,"_2329":44916},[],"**New CA from the KMS:** reuse a key already registered in the platform.",{"_2802":1643,"_24443":1614,"_17120":44918,"_5":17015,"_23194":44817,"_2329":44919},[],"**Import a CA with its private key:** incorporate an external authority that Lamassu can issue with.",{"_2802":1644,"_24443":1614,"_17120":44921,"_5":17015,"_23194":44817,"_2329":44922},[],"**Import only the certificate:** register public material. If Lamassu finds its key in the KMS, it can associate it; otherwise, the CA has no usable key for issuance.",{"_2802":1645,"_24443":1614,"_17120":44924,"_5":17015,"_23194":44817,"_2329":44925},[],"First time here? Follow Create your first CA to complete the minimal journey.",{"_2802":1646,"_24443":1614,"_17120":44927,"_5":17015,"_23194":44825,"_2329":44928},[],"Decide whether the CA will be a root or an intermediate.",{"_2802":1647,"_24443":1614,"_17120":44930,"_5":17015,"_23194":44825,"_2329":44931},[],"Choose the engine that will keep the key.",{"_2802":1648,"_24443":1614,"_17120":44933,"_5":17015,"_23194":44825,"_2329":44934},[],"Define a validity longer than that of the certificates it will issue.",{"_2802":1649,"_24443":1614,"_17120":44936,"_5":17015,"_23194":44825,"_2329":44937},[],"For an intermediate CA, make sure the parent CA is active.",{"_2802":1650,"_24443":1614,"_17120":44939,"_5":17015,"_23194":44828,"_2329":44940},[],"In **Certification Authorities**, select **Create New CA** and choose to generate a new key pair.",{"_2802":1651,"_24443":1614,"_17120":44942,"_5":17015,"_23194":44832,"_2329":44943},[],"Select the cryptographic engine, the algorithm and the size or curve. Lamassu supports RSA and EC keys according to the engine's capabilities.",{"_2802":1652,"_24443":1614,"_17120":44945,"_5":17015,"_23194":44832,"_2329":44946},[],"Use only sizes and curves supported by the engine and the profile’s cryptographic policy. Read Keys and engines before reusing external material.",{"_2802":1653,"_24443":1614,"_17120":44948,"_5":17015,"_23194":44836,"_2329":44949},[],"Select **Root CA** for a self-signed authority or **Intermediate CA** for an authority signed by another CA. In the latter case, choose the issuing CA.",{"_2802":1654,"_24443":1614,"_17120":44951,"_5":17015,"_23194":44840,"_2329":44952},[],"Enter a unique **CA Name**. This name becomes the certificate's `Common Name`. Complete the Distinguished Name fields your policy requires:",{"_2802":1655,"_24443":1614,"_17120":44954,"_5":17015,"_23194":44840,"_2329":44955},[],"`C`: two-letter ISO 3166-1 country code.",{"_2802":1656,"_24443":1614,"_17120":44957,"_5":17015,"_23194":44840,"_2329":44958},[],"`ST`: state or province.",{"_2802":1657,"_24443":1614,"_17120":44960,"_5":17015,"_23194":44840,"_2329":44961},[],"`L`: locality.",{"_2802":1658,"_24443":1614,"_17120":44963,"_5":17015,"_23194":44840,"_2329":44964},[],"`O`: organization.",{"_2802":1659,"_24443":1614,"_17120":44966,"_5":17015,"_23194":44840,"_2329":44967},[],"`OU`: organizational unit.",{"_2802":1660,"_24443":1614,"_17120":44969,"_5":17015,"_23194":44840,"_2329":44970},[],"The CA's internal identifier is generated automatically and cannot be changed.",{"_2802":1661,"_24443":1614,"_17120":44972,"_5":17015,"_23194":44844,"_2329":44973},[],"Define **CA Certificate Expiration** and **Default End-Entity Certificate Issuance Expiration**. You can express a duration (`5y 8w 4d`), pick a date or use the maximum allowed date.",{"_2802":1662,"_24443":1614,"_17120":44975,"_5":17015,"_23194":44844,"_2329":44976},[],"Review the CA’s own certificate separately from the default profile for certificates it will issue later. Choose an explicit issuance policy; do not assume the form’s initial values suit your consumers.",{"_2802":1663,"_24443":1614,"_17120":44978,"_5":17015,"_23194":44848,"_2329":44979},[],"Confirm the form and open the CA. Check status, issuer, dates, associated engine and key. Download the certificate: it should contain `CA:TRUE` and a usage permitting certificate signing. Verify the self-signature for a root or the chain to your root for an intermediate. Complete a test issuance to check that the key can actually sign.",{"_2802":1664,"_24443":1614,"_17120":44981,"_5":17015,"_23194":44848,"_2329":44982},[],"Plan and verify expiration using the Profiles rules. Issuance does not automatically clamp validity to the issuer’s expiration; leave time to replace the authority and renew identities.",{"_2802":1665,"_24443":1614,"_17120":44984,"_5":17015,"_23194":44852,"_2329":44985},[],"Select &#x2A;*Create New CA (Existing Key)** when the key is already registered in Lamassu. The wizard first asks for the backing key and then shows the same configuration of type, identity, validity and profile.",{"_2802":1666,"_24443":1614,"_17120":44987,"_5":17015,"_23194":44852,"_2329":44988},[],"This flow is useful when the key was previously created in an HSM, imported through BYOK or must be reused under a specific custody policy.",{"_2802":1667,"_24443":1614,"_17120":44990,"_5":17015,"_23194":44856,"_2329":44991},[],"You need the CA certificate in PEM, its chain to a known root and, when importing it, an exportable private key. Before uploading material, verify signature, dates, `CA:TRUE`, signing usages and public-key correspondence. The key verification procedure also compares a CA key and certificate.",{"_2802":1668,"_24443":1614,"_17120":44993,"_5":17015,"_23194":44860,"_2329":44994},[],"Check the installation’s default engine before importing a CA with a key. CA import delegates key import to that engine; it does not guarantee arbitrary provider selection from the form. To select an engine while importing the key separately, use the KMS.",{"_2802":1669,"_24443":1614,"_17120":44996,"_5":17015,"_23194":44864,"_2329":44997},[],"Import the certificate and, when applicable, its PEM key. Register the CAs needed to identify the issuer. Registering a CA does not install it in external trust stores.",{"_2802":1670,"_24443":1614,"_17120":44999,"_5":17015,"_23194":44868,"_2329":45000},[],"Associate an explicit issuance profile if the CA will sign. Check usages and dates using Profiles.",{"_2802":1671,"_24443":1614,"_17120":45002,"_5":17015,"_23194":44872,"_2329":45003},[],"Review the registered type, associated key and engine, and issuer relationship. Certificate-only import may associate an existing KMS key using the certificate’s key identifier. Without a usable key, the CA is public material and cannot sign.",{"_2802":1672,"_24443":1614,"_17120":45005,"_5":17015,"_23194":44872,"_2329":45006},[],"For an issuing CA, complete a test issuance and check OCSP and CRL. Creating the record alone does not establish key availability, complete chain consistency or status publication.",{"_2802":1673,"_24443":1614,"_17120":45008,"_5":17015,"_23194":44876,"_2329":45009},[],"Open a CA from the inventory to review:",{"_2802":1674,"_24443":1614,"_17120":45011,"_5":17015,"_23194":44876,"_2329":45012},[],"Status and validity period.",{"_2802":1675,"_24443":1614,"_17120":45014,"_5":17015,"_23194":44876,"_2329":45015},[],"Certificate and chain in PEM format.",{"_2802":1676,"_24443":1614,"_17120":45017,"_5":17015,"_23194":44876,"_2329":45018},[],"Number of active, expired and revoked certificates.",{"_2802":1677,"_24443":1614,"_17120":45020,"_5":17015,"_23194":44876,"_2329":45021},[],"Certificates issued in **Issued Certificates**.",{"_2802":1678,"_24443":1614,"_17120":45023,"_5":17015,"_23194":44876,"_2329":45024},[],"The CRL linked to the authority.",{"_2802":1679,"_24443":1614,"_17120":45026,"_5":17015,"_23194":44876,"_2329":45027},[],"Metadata and the associated cryptographic engine.",{"_2802":1680,"_24443":1614,"_17120":45029,"_5":17015,"_23194":44876,"_2329":45030},[],"You can filter the inventory by name, status and CA type.",{"_2802":1681,"_24443":1614,"_17120":45032,"_5":17015,"_23194":44880,"_2329":45033},[],"You can start an issuance from **Issued Certificates**, from a CA's action menu or from the global certificate inventory.",{"_2802":1682,"_24443":1614,"_17120":45035,"_5":17015,"_23194":44880,"_2329":45036},[],"**Generate Key & CSR in Browser** is useful for a manual operation or a quick test. The browser generates the key and you must download it at the end.",{"_2802":1683,"_24443":1614,"_17120":45038,"_5":17015,"_23194":44880,"_2329":45039},[],"**Upload Existing CSR** is the right option when the key must remain on the target system. Lamassu receives the request but never the private key.",{"_2802":1684,"_24443":1614,"_17120":45041,"_5":17015,"_23194":44880,"_2329":45042},[],"Follow Issue your first certificate for the guided flow. Certificate management explains the inventory, inspection and revocation.",{"_2802":1685,"_24443":1614,"_17120":45044,"_5":17015,"_23194":44884,"_2329":45045},[],"Revoking a CA prevents issuance and may interrupt its entire branch. Only `CertificateHold` allows reactivating the CA itself if it is not expired. Descendant revocation is attempted with `CessationOfOperation`; reactivating the parent does not restore those descendants. Follow the cascading revocation conditions.",{"_2802":1686,"_24443":1614,"_17120":45047,"_5":17015,"_23194":44888,"_2329":45048},[],"Identify the certificates, devices and consumers that depend on the CA. Prepare a replacement authority and chain when necessary.",{"_2802":1687,"_24443":1614,"_17120":45050,"_5":17015,"_23194":44892,"_2329":45051},[],"Open the authority and select **Revoke CA**. Choose the reason that describes the incident, for example `KeyCompromise`, `CACompromise`, `Superseded` or `CessationOfOperation`.",{"_2802":1688,"_24443":1614,"_17120":45053,"_5":17015,"_23194":44896,"_2329":45054},[],"Type the CA's name exactly to enable **Confirm Revocation**.",{"_2802":1689,"_24443":1614,"_17120":45056,"_5":17015,"_23194":44900,"_2329":45057},[],"Check **REVOKED** on the CA and review descendants individually; propagation permits partial failures. Independently verify OCSP and CRL publication and consumer rejection. A revoked record does not guarantee that an existing session closes.",{"_2802":1690,"_24443":1614,"_17120":45059,"_5":17015,"_23194":44900,"_2329":45060},[],"Permanent deletion is only available after revoking. Delete the record only when your retention and audit policy allows it.",{"_2802":1691,"_24443":1691,"_5":12033,"_2329":45062,"_24758":45063,"_17120":45064,"_23194":1691},"Certificate profiles",[39790,41134,44649,44650],[],{"_2802":1692,"_24443":1691,"_17120":45066,"_5":17015,"_23194":1691,"_2329":45067},[],"Define reusable policies to issue consistent certificates and constrain accepted keys.",{"_2802":1693,"_24443":1691,"_5":24755,"_17120":45069,"_23194":45070,"_2329":45071},[],"/docs/platform/pki/certificate-profiles#what-a-profile-controls","What a profile controls",{"_2802":1694,"_24443":1691,"_5":24755,"_17120":45073,"_23194":45074,"_2329":45075},[],"/docs/platform/pki/certificate-profiles#validity","Validity",{"_2802":1695,"_24443":1691,"_5":24755,"_17120":45077,"_23194":45078,"_2329":45079},[],"/docs/platform/pki/certificate-profiles#ca-certificate-or-end-entity-certificate","CA certificate or end-entity certificate",{"_2802":1696,"_24443":1691,"_5":24755,"_17120":45081,"_23194":45082,"_2329":45083},[],"/docs/platform/pki/certificate-profiles#key-usage-and-extended-key-usage","Key Usage and Extended Key Usage",{"_2802":1697,"_24443":1691,"_5":24755,"_17120":45085,"_23194":45086,"_2329":45087},[],"/docs/platform/pki/certificate-profiles#subject","Subject",{"_2802":1698,"_24443":1691,"_5":24755,"_17120":45089,"_23194":45090,"_2329":45091},[],"/docs/platform/pki/certificate-profiles#csr-extensions","CSR extensions",{"_2802":1699,"_24443":1691,"_5":24755,"_17120":45093,"_23194":45094,"_2329":45095},[],"/docs/platform/pki/certificate-profiles#cryptographic-constraints","Cryptographic constraints",{"_2802":1700,"_24443":1691,"_5":24755,"_17120":45097,"_23194":45098,"_2329":45099},[],"/docs/platform/pki/certificate-profiles#profile-precedence","Profile precedence",{"_2802":1701,"_24443":1691,"_5":24755,"_17120":45101,"_23194":45102,"_2329":45103},[],"/docs/platform/pki/certificate-profiles#create-a-profile","Create a profile",{"_2802":1702,"_24443":1691,"_5":24755,"_17120":45105,"_23194":45106,"_2329":45107},[],"/docs/platform/pki/certificate-profiles#define-a-single-purpose","Define a single purpose",{"_2802":1703,"_24443":1691,"_5":24755,"_17120":45109,"_23194":45110,"_2329":45111},[],"/docs/platform/pki/certificate-profiles#choose-the-validity","Choose the validity",{"_2802":1704,"_24443":1691,"_5":24755,"_17120":45113,"_23194":45114,"_2329":45115},[],"/docs/platform/pki/certificate-profiles#fix-usages-and-subject","Fix usages and subject",{"_2802":1705,"_24443":1691,"_5":24755,"_17120":45117,"_23194":45118,"_2329":45119},[],"/docs/platform/pki/certificate-profiles#constrain-the-keys","Constrain the keys",{"_2802":1706,"_24443":1691,"_5":24755,"_17120":45121,"_23194":45122,"_2329":45123},[],"/docs/platform/pki/certificate-profiles#attach-it-and-test","Attach it and test",{"_2802":1707,"_24443":1691,"_5":24755,"_17120":45125,"_23194":45126,"_2329":45127},[],"/docs/platform/pki/certificate-profiles#design-examples","Design examples",{"_2802":1708,"_24443":1691,"_5":24755,"_17120":45129,"_23194":45130,"_2329":45131},[],"/docs/platform/pki/certificate-profiles#changes-and-deletion","Changes and deletion",{"_2802":1709,"_24443":1691,"_17120":45133,"_5":17015,"_23194":1691,"_2329":45134},[],"An issuance profile turns a certificate policy into reusable configuration. Instead of deciding validity, subject, extensions and algorithms on every request, you define once what is allowed and attach the profile to a CA, a DMS or a specific issuance.",{"_2802":1710,"_24443":1691,"_17120":45136,"_5":17015,"_23194":1691,"_2329":45137},[],"This guide is for the PKI administrator defining issuance policy. You need permissions to manage profiles and associate them with the intended CA or DMS, plus a test consumer with known identity and purpose requirements.",{"_2802":1711,"_24443":1691,"_17120":45139,"_5":17015,"_23194":45074,"_2329":45140},[],"You can express the lifetime as a duration from the moment of issuance or as a fixed end date. A duration works well for recurring identities; a common date is useful to make a whole batch end before a migration or retirement.",{"_2802":1712,"_24443":1691,"_17120":45142,"_5":17015,"_23194":45074,"_2329":45143},[],"Plan the end date within the issuing CA’s validity and leave a renewal margin. The signer calculates the date from the profile; it does not automatically clamp validity to the issuer’s expiration. Check both dates in the resulting certificate. A fixed date in the past does not produce a usable identity either.",{"_2802":1713,"_24443":1691,"_17120":45145,"_5":17015,"_23194":45078,"_2329":45146},[],"`Sign as CA` sets `IsCA` and the basic constraints needed for an authority. Enable it only in profiles intended to create or reissue subordinate CAs.",{"_2802":1714,"_24443":1691,"_17120":45148,"_5":17015,"_23194":45082,"_2329":45149},[],"The profile can enforce usages such as `DigitalSignature`, `KeyEncipherment`, `CertSign`, `CRLSign`, `ClientAuth`, `ServerAuth` or `OCSPSigning`.",{"_2802":1715,"_24443":1691,"_17120":45151,"_5":17015,"_23194":45082,"_2329":45152},[],"If you enable **Honor Key Usage** or **Honor Extended Key Usages**, Lamassu keeps the values requested by the CSR. If you disable them, it replaces them with the ones defined in the profile.",{"_2802":1716,"_24443":1691,"_17120":45154,"_5":17015,"_23194":45082,"_2329":45155},[],"Do not enable the `Honor…` options for untrusted requests unless another component validates those fields. Otherwise, the requester may choose broader capabilities than intended.",{"_2802":1717,"_24443":1691,"_17120":45157,"_5":17015,"_23194":45086,"_2329":45158},[],"With **Honor Subject**, the certificate keeps the subject of the CSR. Without that option, Lamassu applies the profile's `CN`, `O`, `OU`, `C`, `ST` and `L`. If the profile does not define a `Common Name`, the requested CN is kept.",{"_2802":1718,"_24443":1691,"_17120":45160,"_5":17015,"_23194":45090,"_2329":45161},[],"With **Honor Extensions**, Lamassu filters the additional requested extensions and keeps only SAN. Without that option, it discards the CSR's additional extensions.",{"_2802":1719,"_24443":1691,"_17120":45163,"_5":17015,"_23194":45090,"_2329":45164},[],"This preserves SAN, but does not establish that the requester is entitled to those DNS names, IP addresses, emails or URIs. Validate that authorization before issuing. OCSP and CRL locations come from the issuance service configuration; `Honor Extensions` does not copy CSR distribution points.",{"_2802":1720,"_24443":1691,"_17120":45166,"_5":17015,"_23194":45094,"_2329":45167},[],"The cryptographic enforcement can:",{"_2802":1721,"_24443":1691,"_17120":45169,"_5":17015,"_23194":45094,"_2329":45170},[],"allow or block RSA keys;",{"_2802":1722,"_24443":1691,"_17120":45172,"_5":17015,"_23194":45094,"_2329":45173},[],"limit the supported RSA sizes;",{"_2802":1723,"_24443":1691,"_17120":45175,"_5":17015,"_23194":45094,"_2329":45176},[],"allow or block ECDSA keys;",{"_2802":1724,"_24443":1691,"_17120":45178,"_5":17015,"_23194":45094,"_2329":45179},[],"limit the supported ECDSA sizes or curves.",{"_2802":1725,"_24443":1691,"_17120":45181,"_5":17015,"_23194":45094,"_2329":45182},[],"When it is enabled, Lamassu checks the public key before creating a CA or signing a CSR. A key whose type or size is not listed in the profile is rejected.",{"_2802":1726,"_24443":1691,"_17120":45184,"_5":17015,"_23194":45098,"_2329":45185},[],"Resolution depends on the entry point. One complete profile is selected; its fields are not merged with the CA’s profile.",{"_2802":1727,"_24443":1691,"_17120":45187,"_5":17015,"_23194":45098,"_2329":42719},[],{"_2802":1728,"_24443":1691,"_17120":45189,"_5":17015,"_23194":45098,"_2329":45190},[],"First choice",{"_2802":1729,"_24443":1691,"_17120":45192,"_5":17015,"_23194":45098,"_2329":45193},[],"Second choice",{"_2802":1730,"_24443":1691,"_17120":45195,"_5":17015,"_23194":45098,"_2329":45196},[],"If neither is supplied",{"_2802":1731,"_24443":1691,"_17120":45198,"_5":17015,"_23194":45098,"_2329":45199},[],"Direct signing with a CA",{"_2802":1732,"_24443":1691,"_17120":45201,"_5":17015,"_23194":45098,"_2329":45202},[],"`issuance_profile` embedded in the request",{"_2802":1733,"_24443":1691,"_17120":45204,"_5":17015,"_23194":45098,"_2329":45205},[],"Request `issuance_profile_id`",{"_2802":1734,"_24443":1691,"_17120":45207,"_5":17015,"_23194":45098,"_2329":45208},[],"CA default profile (`profile_id`).",{"_2802":1735,"_24443":1691,"_17120":45210,"_5":17015,"_23194":45098,"_2329":45211},[],"Issuance through a DMS",{"_2802":1736,"_24443":1691,"_17120":45213,"_5":17015,"_23194":45098,"_2329":45214},[],"`settings.issuance_profile_id`",{"_2802":1737,"_24443":1691,"_17120":45216,"_5":17015,"_23194":45098,"_2329":45217},[],"`settings.issuance_profile` embedded in the DMS",{"_2802":1738,"_24443":1691,"_17120":45219,"_5":17015,"_23194":45098,"_2329":45220},[],"Enrollment CA default profile.",{"_2802":1739,"_24443":1691,"_17120":45222,"_5":17015,"_23194":45098,"_2329":45223},[],"If the selected identifier cannot be resolved, the operation fails; it does not silently fall back to the CA’s profile. Avoid setting both options at once. Recording which profile was selected helps explain why a certificate differs from its CSR.",{"_2802":1740,"_24443":1691,"_17120":45225,"_5":17015,"_23194":45098,"_2329":45226},[],"Several fleets can share a CA while keeping different profiles through their DMSs. Requester authentication and device registration policy are configured separately in DMS.",{"_2802":1741,"_24443":1691,"_17120":45228,"_5":17015,"_23194":45106,"_2329":45229},[],"Separate, for example, mTLS devices, servers and intermediate CAs. A small, specific profile is easier to review than one that allows every use.",{"_2802":1742,"_24443":1691,"_17120":45231,"_5":17015,"_23194":45110,"_2329":45232},[],"Align the duration with the fleet's real renewal capacity. Leave margin against the CA's expiration.",{"_2802":1743,"_24443":1691,"_17120":45234,"_5":17015,"_23194":45114,"_2329":45235},[],"For a device that authenticates as a client, the usual starting point is `DigitalSignature` and `ClientAuth`. Add `ServerAuth` or `KeyEncipherment` only if the protocol needs it.",{"_2802":1744,"_24443":1691,"_17120":45237,"_5":17015,"_23194":45118,"_2329":45238},[],"Enable cryptographic enforcement and list only algorithms and sizes compatible with your policy and your devices.",{"_2802":1745,"_24443":1691,"_17120":45240,"_5":17015,"_23194":45122,"_2329":45241},[],"Attach the profile to a CA or DMS and check the precedence above. Issue a CSR with known usages and SAN; inspect the result with `openssl x509 -in device.crt -noout -text`. Check subject, SAN, KU, EKU and dates. For an end-entity identity, disable `Sign as CA`, require no `CA:TRUE` or `Certificate Sign`, and require `CA:FALSE` if Basic Constraints is present.",{"_2802":1746,"_24443":1691,"_17120":45243,"_5":17015,"_23194":45122,"_2329":45244},[],"Also try a key excluded by policy: issuance should fail. Follow the certificate verification and test acceptance in the intended consumer.",{"_2802":1747,"_24443":1691,"_17120":45246,"_5":17015,"_23194":45126,"_2329":45247},[],"**mTLS device**\\\nEnd-entity certificate, short validity, `DigitalSignature`, `ClientAuth`, subject controlled by the DMS and SAN allowed when it identifies the device.",{"_2802":1748,"_24443":1691,"_17120":45249,"_5":17015,"_23194":45126,"_2329":45250},[],"**TLS server**\\\nEnd-entity certificate, `DigitalSignature`, `ServerAuth` and mandatory SAN with the names clients will use.",{"_2802":1749,"_24443":1691,"_17120":45252,"_5":17015,"_23194":45126,"_2329":45253},[],"**Intermediate CA**\\\n`Sign as CA`, `CertSign` and `CRLSign`, validity longer than its end-entity certificates and stricter cryptographic constraints.",{"_2802":1750,"_24443":1691,"_17120":45255,"_5":17015,"_23194":45126,"_2329":45256},[],"These patterns express design decisions. Enabling `Honor Extensions` does not require a CSR to contain SAN or validate its names; enforce that in the request workflow. A profile does not install trust or grant permissions in the consumer.",{"_2802":1751,"_24443":1691,"_17120":45258,"_5":17015,"_23194":45130,"_2329":45259},[],"Updating a profile affects future issuances; it does not modify already-signed certificates. Test changes before applying them to a CA in production and keep the operational justification.",{"_2802":1752,"_24443":1691,"_17120":45261,"_5":17015,"_23194":45130,"_2329":45262},[],"Before deleting a profile, check that no CA or DMS depends on it. If you want to replace it, create the new version, update the references and perform a test issuance before retiring the old one.",{"_2802":1753,"_24443":1753,"_5":12033,"_2329":45264,"_24758":45265,"_17120":45267,"_23194":1753},"Certificate validation",[39790,41134,44649,45266],"Validation",[],{"_2802":1754,"_24443":1753,"_17120":45269,"_5":17015,"_23194":1753,"_2329":45270},[],"Check chain, identity, purpose and revocation from the consumer.",{"_2802":1755,"_24443":1753,"_5":24755,"_17120":45272,"_23194":45273,"_2329":45274},[],"/docs/platform/pki/certificate-validation#before-querying-status","Before querying status",{"_2802":1756,"_24443":1753,"_5":24755,"_17120":45276,"_23194":45277,"_2329":45278},[],"/docs/platform/pki/certificate-validation#choose-a-mechanism","Choose a mechanism",{"_2802":1757,"_24443":1753,"_5":24755,"_17120":45280,"_23194":45281,"_2329":45282},[],"/docs/platform/pki/certificate-validation#check-consumer-behavior","Check consumer behavior",{"_2802":1758,"_24443":1753,"_17120":45284,"_5":17015,"_23194":1753,"_2329":45285},[],"This guide brings together the checks needed when integrating a certificate consumer. You need the presented certificate, intermediates and roots that your application has deliberately chosen to trust. Lamassu publishes status; the consumer applies acceptance policy.",{"_2802":1759,"_24443":1753,"_17120":45287,"_5":17015,"_23194":45273,"_2329":45288},[],"Verify these criteria together:",{"_2802":1760,"_24443":1753,"_17120":45290,"_5":17015,"_23194":45273,"_2329":44273},[],{"_2802":1761,"_24443":1753,"_17120":45292,"_5":17015,"_23194":45273,"_2329":45293},[],"Required result",{"_2802":1762,"_24443":1753,"_17120":45295,"_5":17015,"_23194":45273,"_2329":45296},[],"Chain and signature",{"_2802":1763,"_24443":1753,"_17120":45298,"_5":17015,"_23194":45273,"_2329":45299},[],"Valid chain to a root deliberately installed in the consumer.",{"_2802":1764,"_24443":1753,"_17120":45301,"_5":17015,"_23194":45273,"_2329":45302},[],"Dates",{"_2802":1765,"_24443":1753,"_17120":45304,"_5":17015,"_23194":45273,"_2329":45305},[],"Current time between `Not Before` and `Not After`, including the CAs in the chain.",{"_2802":1766,"_24443":1753,"_17120":45307,"_5":17015,"_23194":45273,"_2329":40837},[],{"_2802":1767,"_24443":1753,"_17120":45309,"_5":17015,"_23194":45273,"_2329":45310},[],"Name, SAN or identifier matches the expected peer.",{"_2802":1768,"_24443":1753,"_17120":45312,"_5":17015,"_23194":45273,"_2329":40173},[],{"_2802":1769,"_24443":1753,"_17120":45314,"_5":17015,"_23194":45273,"_2329":45315},[],"KU, EKU and constraints permit the specific operation.",{"_2802":1770,"_24443":1753,"_17120":45317,"_5":17015,"_23194":45273,"_2329":45318},[],"Revocation",{"_2802":1771,"_24443":1753,"_17120":45320,"_5":17015,"_23194":45273,"_2329":45321},[],"Signed, current evidence corresponding to the queried issuer and certificate.",{"_2802":1772,"_24443":1753,"_17120":45323,"_5":17015,"_23194":45273,"_2329":45324},[],"Authorization",{"_2802":1773,"_24443":1753,"_17120":45326,"_5":17015,"_23194":45273,"_2329":45327},[],"The application permits that identity to perform the action.",{"_2802":1774,"_24443":1753,"_17120":45329,"_5":17015,"_23194":45273,"_2329":45330},[],"The issuance walkthrough checks chain and purpose with OpenSSL. That check does not automatically query OCSP or download a CRL. Inventory presence or an OCSP `Good` response does not replace the other criteria.",{"_2802":1775,"_24443":1753,"_17120":45332,"_5":17015,"_23194":45277,"_2329":45333},[],"Mechanism",{"_2802":1776,"_24443":1753,"_17120":45335,"_5":17015,"_23194":45277,"_2329":45336},[],"When to use it",{"_2802":1777,"_24443":1753,"_17120":45338,"_5":17015,"_23194":45277,"_2329":45339},[],"What you must maintain",{"_2802":1778,"_24443":1753,"_17120":45341,"_5":17015,"_23194":45277,"_2329":45342},[],"OCSP",{"_2802":1779,"_24443":1753,"_17120":45344,"_5":17015,"_23194":45277,"_2329":45345},[],"Status query for a specific certificate.",{"_2802":1780,"_24443":1753,"_17120":45347,"_5":17015,"_23194":45277,"_2329":45348},[],"Responder access, signature verification and cache/freshness policy.",{"_2802":1781,"_24443":1753,"_17120":45350,"_5":17015,"_23194":45277,"_2329":45351},[],"CRL",{"_2802":1782,"_24443":1753,"_17120":45353,"_5":17015,"_23194":45277,"_2329":45354},[],"Local checks for many certificates or offline operation.",{"_2802":1783,"_24443":1753,"_17120":45356,"_5":17015,"_23194":45277,"_2329":45357},[],"Periodic download of an issuer-signed list and rejection of expired lists.",{"_2802":1784,"_24443":1753,"_17120":45359,"_5":17015,"_23194":45277,"_2329":45360},[],"OCSP can also return a response reusable until `nextUpdate`; a CRL changes when a new version is published. Neither mechanism alone guarantees that a consumer learns a revocation at the moment it is saved.",{"_2802":1785,"_24443":1753,"_17120":45362,"_5":17015,"_23194":45277,"_2329":45363},[],"If using both, define when fallback is allowed and what the client does when retrieval, signature or freshness checks fail, or the result is `Unknown`. Accepting an identity when its status cannot be checked must be an explicit application decision.",{"_2802":1786,"_24443":1753,"_17120":45365,"_5":17015,"_23194":45281,"_2329":45366},[],"Accept a current, authorized certificate with a known chain.",{"_2802":1787,"_24443":1753,"_17120":45368,"_5":17015,"_23194":45281,"_2329":45369},[],"Reject another certificate with an unknown root or incompatible purpose.",{"_2802":1788,"_24443":1753,"_17120":45371,"_5":17015,"_23194":45281,"_2329":45372},[],"Revoke a test certificate and verify the OCSP response or new CRL.",{"_2802":1789,"_24443":1753,"_17120":45374,"_5":17015,"_23194":45281,"_2329":45375},[],"Check that a new connection with that identity is rejected.",{"_2802":1790,"_24443":1753,"_17120":45377,"_5":17015,"_23194":45281,"_2329":45378},[],"Simulate an unreachable endpoint and expired evidence; observe whether the result matches policy.",{"_2802":1791,"_24443":1753,"_17120":45380,"_5":17015,"_23194":45281,"_2329":45381},[],"Keep the serial number, issuer, revocation reason, query time and evidence timestamps. An existing session may need explicit closure or reauthentication in the consumer; publishing revocation does not automatically close it.",{"_2802":1792,"_24443":1753,"_17120":45383,"_5":17015,"_23194":45281,"_2329":45384},[],"For a chain with intermediates, validate their status according to consumer policy as well. An end-entity issuer’s CRL does not replace checks on every CA in the chain.",{"_2802":1793,"_24443":1753,"_17120":45386,"_5":17015,"_23194":45281,"_2329":45387},[],"<Card title=\"Online validation with OCSP\" description=\"Generate a query and verify signature, status and timestamps.\" href=\"/docs/platform/pki/ocsp\" />",{"_2802":1794,"_24443":1753,"_17120":45389,"_5":17015,"_23194":45281,"_2329":45390},[],"<Card title=\"Revocation lists\" description=\"Download, inspect and use an issuer’s CRL.\" href=\"/docs/platform/pki/crl\" />",{"_2802":1795,"_24443":1795,"_5":12033,"_2329":45392,"_24758":45393,"_17120":45394,"_23194":1795},"Certificates",[39790,41134,44649,44650],[],{"_2802":1796,"_24443":1795,"_17120":45396,"_5":17015,"_23194":1795,"_2329":45397},[],"Inspect, download and revoke the certificates issued by Lamassu.",{"_2802":1797,"_24443":1795,"_5":24755,"_17120":45399,"_23194":45400,"_2329":45401},[],"/docs/platform/pki/certificates#find-a-certificate","Find a certificate",{"_2802":1798,"_24443":1795,"_5":24755,"_17120":45403,"_23194":45404,"_2329":45405},[],"/docs/platform/pki/certificates#download-the-certificate","Download the certificate",{"_2802":1799,"_24443":1795,"_5":24755,"_17120":45407,"_23194":45408,"_2329":45409},[],"/docs/platform/pki/certificates#issue-from-an-existing-csr","Issue from an existing CSR",{"_2802":1800,"_24443":1795,"_5":24755,"_17120":45411,"_23194":45412,"_2329":45413},[],"/docs/platform/pki/certificates#revoke-a-certificate","Revoke a certificate",{"_2802":1801,"_24443":1795,"_5":24755,"_17120":45415,"_23194":45416,"_2329":45417},[],"/docs/platform/pki/certificates#open-the-action","Open the action",{"_2802":1802,"_24443":1795,"_5":24755,"_17120":45419,"_23194":45420,"_2329":45421},[],"/docs/platform/pki/certificates#choose-a-reason","Choose a reason",{"_2802":1803,"_24443":1795,"_5":24755,"_17120":45423,"_23194":45424,"_2329":45425},[],"/docs/platform/pki/certificates#confirm-and-verify","Confirm and verify",{"_2802":1804,"_24443":1795,"_5":24755,"_17120":45427,"_23194":45428,"_2329":45429},[],"/docs/platform/pki/certificates#reactivate-a-hold","Reactivate a hold",{"_2802":1805,"_24443":1795,"_5":24755,"_17120":45431,"_23194":45432,"_2329":45433},[],"/docs/platform/pki/certificates#continue","Continue",{"_2802":1806,"_24443":1795,"_17120":45435,"_5":17015,"_23194":1795,"_2329":45436},[],"This guide is for a PKI operator inspecting or retiring an issued identity. You need inventory access and, to change states, permissions on the certificate. Open **Certificates** for a global view or **Issued Certificates** within a CA to restrict it to that issuer.",{"_2802":1807,"_24443":1795,"_17120":45438,"_5":17015,"_23194":45400,"_2329":45439},[],"Filter by `Common Name`, serial, status and issuer. Use **Quick Inspect** for a quick review or **View Details** for subject, SAN, usages, chain, dates and metadata.",{"_2802":1808,"_24443":1795,"_17120":45441,"_5":17015,"_23194":45400,"_2329":45442},[],"Identify a certificate by issuer and serial; a name can correspond to several renewals. Check which certificate the consumer actually uses and which occupies the device’s active identity. Identity history and the certificate inventory answer different questions.",{"_2802":1809,"_24443":1795,"_17120":45444,"_5":17015,"_23194":45404,"_2329":45445},[],"Download the PEM and inspect it:",{"_2802":1810,"_24443":1795,"_17120":45447,"_5":17015,"_23194":45404,"_2329":45448},[],"Check issuance policy, chain and usages with the verification walkthrough. A certificate does not contain its private key. For an external CSR, the key remains where it was generated; for the browser flow, retain the file downloaded upon issuance. If the key is lost, plan a new identity rather than expecting recovery from the certificate.",{"_2802":1811,"_24443":1795,"_17120":45450,"_5":17015,"_23194":45408,"_2329":45451},[],"Use this flow when the identity’s key must remain on the system that generated it. You need an active CA with a usable key, a PEM CSR and a suitable profile.",{"_2802":1812,"_24443":1795,"_17120":45453,"_5":17015,"_23194":45408,"_2329":45454},[],"Verify the request with `openssl req -in request.csr -noout -verify -text`. Review subject, SAN and algorithm, and authorize the requested identity.",{"_2802":1813,"_24443":1795,"_17120":45456,"_5":17015,"_23194":45408,"_2329":45457},[],"Start issuance from the CA or inventory and select **Upload Existing CSR**.",{"_2802":1814,"_24443":1795,"_17120":45459,"_5":17015,"_23194":45408,"_2329":45460},[],"Confirm the CA and profile resolved according to Profiles; the request does not guarantee that every field is retained.",{"_2802":1815,"_24443":1795,"_17120":45462,"_5":17015,"_23194":45408,"_2329":45463},[],"Download the certificate and inspect dates, issuer, subject, SAN, KU and EKU. Check correspondence with the private key on the originating system.",{"_2802":1816,"_24443":1795,"_17120":45465,"_5":17015,"_23194":45408,"_2329":45466},[],"Install certificate and chain in the intended consumer and test a connection. Issuance alone does not register a device or grant access in an integration.",{"_2802":1817,"_24443":1795,"_17120":45468,"_5":17015,"_23194":45408,"_2329":45469},[],"For browser key generation, follow Issue your first certificate.",{"_2802":1818,"_24443":1795,"_17120":45471,"_5":17015,"_23194":45412,"_2329":45472},[],"Revoke when the key is compromised, the subject is no longer authorized or the identity must stop being accepted before expiration. Before changing status, identify consumers and prepare any required replacement.",{"_2802":1819,"_24443":1795,"_17120":45474,"_5":17015,"_23194":45416,"_2329":45475},[],"Locate the correct issuer and serial and select **Revoke Certificate**. `EXPIRED` records and records revoked for a final reason reject subsequent status changes.",{"_2802":1820,"_24443":1795,"_17120":45477,"_5":17015,"_23194":45420,"_2329":45478},[],"Select the incident reason. `CertificateHold` represents a reversible certificate suspension; other reasons block later changes. Do not use a suspension to address a compromised key.",{"_2802":1821,"_24443":1795,"_17120":45480,"_5":17015,"_23194":45424,"_2329":45481},[],"Save the change and read the record again: require **REVOKED**, reason and timestamp. Then verify a fresh OCSP query and, if using CRL, its published version and the serial’s presence. Finally check rejection of a new connection in the consumer.",{"_2802":1822,"_24443":1795,"_17120":45483,"_5":17015,"_23194":45424,"_2329":45484},[],"Revocation does not erase the certificate, delete the key or guarantee closure of existing sessions. Status and publication are separate steps.",{"_2802":1823,"_24443":1795,"_17120":45486,"_5":17015,"_23194":45424,"_2329":45487},[],"A certificate revoked with `CertificateHold` can be reactivated if it is not in `EXPIRED` state. Its dates and consumer trust remain mandatory.",{"_2802":1824,"_24443":1795,"_17120":45489,"_5":17015,"_23194":45428,"_2329":45490},[],"Check that the saved reason is `CertificateHold` and the identity still satisfies policy. Request `ACTIVE` through the status update operation exposed by your installation; consult the API reference. Do not assume changing consumer permissions also changes status in Lamassu.",{"_2802":1825,"_24443":1795,"_17120":45492,"_5":17015,"_23194":45428,"_2329":45493},[],"Read the record and query OCSP again. With `regenerate_on_revoke` enabled, the reactivation event requests CRL regeneration: check that the new list omits the serial. An earlier list can still mark it revoked until the client refreshes its copy.",{"_2802":1826,"_24443":1795,"_17120":45495,"_5":17015,"_23194":45428,"_2329":45496},[],"This does not undo permanent revocation or a cascade started by revoking a CA.",{"_2802":1827,"_24443":1795,"_17120":45498,"_5":17015,"_23194":45432,"_2329":45499},[],"<Card title=\"Validate with OCSP\" description=\"Query and verify a certificate’s signed status.\" href=\"/docs/platform/pki/ocsp\" />",{"_2802":1828,"_24443":1795,"_17120":45501,"_5":17015,"_23194":45432,"_2329":45502},[],"<Card title=\"Distribute a CRL\" description=\"Publish status for local validation.\" href=\"/docs/platform/pki/crl\" />",{"_2802":1829,"_24443":1829,"_5":12033,"_2329":45504,"_24758":45505,"_17120":45507,"_23194":1829},"Certificate lifecycle",[39790,41134,44649,45506],"Concepts",[],{"_2802":1830,"_24443":1829,"_17120":45509,"_5":17015,"_23194":1829,"_2329":45510},[],"Issuance, use, renewal, revocation and retirement of certificates in Lamassu.",{"_2802":1831,"_24443":1829,"_5":24755,"_17120":45512,"_23194":45513,"_2329":45514},[],"/docs/platform/pki/concepts/certificate-lifecycle#the-full-journey","The full journey",{"_2802":1832,"_24443":1829,"_5":24755,"_17120":45516,"_23194":45517,"_2329":45518},[],"/docs/platform/pki/concepts/certificate-lifecycle#request","Request",{"_2802":1833,"_24443":1829,"_5":24755,"_17120":45520,"_23194":45521,"_2329":45522},[],"/docs/platform/pki/concepts/certificate-lifecycle#issuance","Issuance",{"_2802":1834,"_24443":1829,"_5":24755,"_17120":45524,"_23194":45525,"_2329":45526},[],"/docs/platform/pki/concepts/certificate-lifecycle#use-and-monitoring","Use and monitoring",{"_2802":1835,"_24443":1829,"_5":24755,"_17120":45528,"_23194":45529,"_2329":45530},[],"/docs/platform/pki/concepts/certificate-lifecycle#renewal-or-re-enrollment","Renewal or re-enrollment",{"_2802":1836,"_24443":1829,"_5":24755,"_17120":45532,"_23194":45533,"_2329":45534},[],"/docs/platform/pki/concepts/certificate-lifecycle#revocation-or-retirement","Revocation or retirement",{"_2802":1837,"_24443":1829,"_5":24755,"_17120":45536,"_23194":45537,"_2329":45538},[],"/docs/platform/pki/concepts/certificate-lifecycle#certificate-states","Certificate states",{"_2802":1838,"_24443":1829,"_5":24755,"_17120":45540,"_23194":45541,"_2329":45542},[],"/docs/platform/pki/concepts/certificate-lifecycle#renewal-and-revocation-are-not-equivalent","Renewal and revocation are not equivalent",{"_2802":1839,"_24443":1829,"_5":24755,"_17120":45544,"_23194":45545,"_2329":45546},[],"/docs/platform/pki/concepts/certificate-lifecycle#effect-of-revoking-a-ca","Effect of revoking a CA",{"_2802":1840,"_24443":1829,"_5":24755,"_17120":45548,"_23194":45549,"_2329":45550},[],"/docs/platform/pki/concepts/certificate-lifecycle#what-you-should-watch","What you should watch",{"_2802":1841,"_24443":1829,"_17120":45552,"_5":17015,"_23194":1829,"_2329":45553},[],"Issuing a certificate is only the beginning. During its useful life you must check its validity, renew it before it expires and retire it when it stops being trustworthy. Lamassu keeps the certificate, its issuing CA, its status and, when it belongs to a device, the identity it is linked to.",{"_2802":1842,"_24443":1829,"_17120":45555,"_5":17015,"_23194":45517,"_2329":45556},[],"The requester generates a key and a CSR. In the recommended flows, the private key stays in the device, browser or cryptographic engine that created it.",{"_2802":1843,"_24443":1829,"_17120":45558,"_5":17015,"_23194":45521,"_2329":45559},[],"The CA signs the CSR. The issuance profile determines the validity, uses, subject, allowed extensions and cryptographic constraints.",{"_2802":1844,"_24443":1829,"_17120":45561,"_5":17015,"_23194":45525,"_2329":45562},[],"The certificate enters the `ACTIVE` state. Lamassu monitors its `Not After` date; the cryptographic monitoring job marks certificates that have expired as `EXPIRED`.",{"_2802":1845,"_24443":1829,"_17120":45564,"_5":17015,"_23194":45529,"_2329":45565},[],"A new certificate is issued before the previous one expires. In a DMS you can open preventive and critical windows so the device re-enrolls through EST.",{"_2802":1846,"_24443":1829,"_17120":45567,"_5":17015,"_23194":45533,"_2329":45568},[],"If the identity stops being trustworthy, Lamassu records the reason and time of revocation. OCSP and CRLs let consumers learn that status.",{"_2802":1847,"_24443":1829,"_17120":45570,"_5":17015,"_23194":45537,"_2329":45571},[],"Lamassu persists four X.509 states:",{"_2802":1848,"_24443":1829,"_17120":45573,"_5":17015,"_23194":45537,"_2329":45574},[],"**`ACTIVE`**: the record is enabled. Also check `Not Before` and `Not After`: this state does not establish time validity.",{"_2802":1849,"_24443":1829,"_17120":45576,"_5":17015,"_23194":45537,"_2329":45577},[],"**`EXPIRED`**: it has passed its expiration date. The monitor detects this periodically; it is not a state that should be assigned manually.",{"_2802":1850,"_24443":1829,"_17120":45579,"_5":17015,"_23194":45537,"_2329":45580},[],"**`REVOKED`**: it was invalidated before expiring, with a reason and a timestamp.",{"_2802":1851,"_24443":1829,"_17120":45582,"_5":17015,"_23194":45537,"_2329":45583},[],"**`INACTIVE`**: it is disabled without representing a definitive revocation.",{"_2802":1852,"_24443":1829,"_17120":45585,"_5":17015,"_23194":45537,"_2329":45586},[],"The device view may add operational states such as missing identity, pending renewal, expiring soon or decommissioned. These are an interpretation of the device's status and its certificates, not new X.509 states.",{"_2802":1853,"_24443":1829,"_17120":45588,"_5":17015,"_23194":45541,"_2329":45589},[],"**Renewal** creates a successor certificate for an identity that remains valid. **Revocation** communicates that the current certificate must no longer be accepted. Renew to maintain continuity; revoke in response to compromise, retirement or a change that invalidates the identity.",{"_2802":1854,"_24443":1829,"_17120":45591,"_5":17015,"_23194":45541,"_2329":45592},[],"Only `CertificateHold` allows reactivating a revoked certificate that is not in `EXPIRED` state. Revocation for another reason blocks subsequent status changes. `EXPIRED` records also reject changes; the consumer must check dates even before the monitor updates the state. Certificates explains how to verify revocation and reactivation.",{"_2802":1855,"_24443":1829,"_17120":45594,"_5":17015,"_23194":45541,"_2329":45595},[],"The **Reissue CA** operation generates another certificate for the same key and links both serial numbers through metadata. It is not a key rotation. To change the key, create a successor CA and perform a migration with an overlapping period.",{"_2802":1856,"_24443":1829,"_17120":45597,"_5":17015,"_23194":45545,"_2329":45598},[],"Revoking a CA starts a cascade that attempts to revoke descendants with `CessationOfOperation`. It may end with partial failures and is not undone by reactivating the parent. Read Hierarchy and rotation for conditions and checks.",{"_2802":1857,"_24443":1829,"_17120":45600,"_5":17015,"_23194":45545,"_2329":45601},[],"Before confirming:",{"_2802":1858,"_24443":1829,"_17120":45603,"_5":17015,"_23194":45545,"_2329":45604},[],"Identify DMSs, devices and services that trust that chain.",{"_2802":1859,"_24443":1829,"_17120":45606,"_5":17015,"_23194":45545,"_2329":45607},[],"Distribute the new chain of trust.",{"_2802":1860,"_24443":1829,"_17120":45609,"_5":17015,"_23194":45545,"_2329":45610},[],"Reissue the necessary identities.",{"_2802":1861,"_24443":1829,"_17120":45612,"_5":17015,"_23194":45545,"_2329":45613},[],"Check OCSP and CRL from a real consumer.",{"_2802":1862,"_24443":1829,"_17120":45615,"_5":17015,"_23194":45545,"_2329":45616},[],"Revoke the old CA once no legitimate traffic remains.",{"_2802":1863,"_24443":1829,"_17120":45618,"_5":17015,"_23194":45545,"_2329":45619},[],"Device retirement belongs to the IoT Fleets lifecycle. It affects the active identity; it does not automatically traverse and revoke every historical certificate. Review previous identities and consumer permissions separately in Device management.",{"_2802":1864,"_24443":1829,"_17120":45621,"_5":17015,"_23194":45549,"_2329":45622},[],"Certificates entering the preventive or critical renewal window.",{"_2802":1865,"_24443":1829,"_17120":45624,"_5":17015,"_23194":45549,"_2329":45625},[],"Repeated enrollment or re-enrollment failures.",{"_2802":1866,"_24443":1829,"_17120":45627,"_5":17015,"_23194":45549,"_2329":45628},[],"Status changes and revocation reasons.",{"_2802":1867,"_24443":1829,"_17120":45630,"_5":17015,"_23194":45549,"_2329":45631},[],"OCSP and CRL publication and validity.",{"_2802":1868,"_24443":1829,"_17120":45633,"_5":17015,"_23194":45549,"_2329":45634},[],"Dependencies still presenting a replaced certificate.",{"_2802":1869,"_24443":1829,"_17120":45636,"_5":17015,"_23194":45549,"_2329":45637},[],"The device history relates its previous and current identities. For administrative changes and mutation errors, see Audit logs.",{"_2802":1870,"_24443":1870,"_5":12033,"_2329":45639,"_24758":45640,"_17120":45641,"_23194":1870},"Trust model",[39790,41134,44649,45506],[],{"_2802":1871,"_24443":1870,"_17120":45643,"_5":17015,"_23194":1870,"_2329":45644},[],"Understand where trust originates, how it is distributed and what each component validates.",{"_2802":1872,"_24443":1870,"_5":24755,"_17120":45646,"_23194":45647,"_2329":45648},[],"/docs/platform/pki/concepts/trust-model#the-four-trust-decisions","The four trust decisions",{"_2802":1873,"_24443":1870,"_5":24755,"_17120":45650,"_23194":45651,"_2329":45652},[],"/docs/platform/pki/concepts/trust-model#who-can-issue","Who can issue",{"_2802":1874,"_24443":1870,"_5":24755,"_17120":45654,"_23194":45655,"_2329":45656},[],"/docs/platform/pki/concepts/trust-model#what-can-be-issued","What can be issued",{"_2802":1875,"_24443":1870,"_5":24755,"_17120":45658,"_23194":45659,"_2329":45660},[],"/docs/platform/pki/concepts/trust-model#who-can-request-it","Who can request it",{"_2802":1876,"_24443":1870,"_5":24755,"_17120":45662,"_23194":45663,"_2329":45664},[],"/docs/platform/pki/concepts/trust-model#who-accepts-the-result","Who accepts the result",{"_2802":1877,"_24443":1870,"_5":24755,"_17120":45666,"_23194":45667,"_2329":45668},[],"/docs/platform/pki/concepts/trust-model#identity-flow","Identity flow",{"_2802":1878,"_24443":1870,"_5":24755,"_17120":45670,"_23194":45671,"_2329":45672},[],"/docs/platform/pki/concepts/trust-model#enrollment-validation-and-distribution-cas","Enrollment, validation and distribution CAs",{"_2802":1879,"_24443":1870,"_5":24755,"_17120":45674,"_23194":45675,"_2329":45676},[],"/docs/platform/pki/concepts/trust-model#validation-and-revocation","Validation and revocation",{"_2802":1880,"_24443":1870,"_5":24755,"_17120":45678,"_23194":45679,"_2329":45680},[],"/docs/platform/pki/concepts/trust-model#custody-limits","Custody limits",{"_2802":1881,"_24443":1870,"_5":24755,"_17120":45682,"_23194":45683,"_2329":45684},[],"/docs/platform/pki/concepts/trust-model#recommended-pattern","Recommended pattern",{"_2802":1882,"_24443":1870,"_17120":45686,"_5":17015,"_23194":1870,"_2329":45687},[],"In Lamassu, trust does not simply mean that a certificate exists in the inventory. A consumer trusts an identity when it can build a chain to a root it recognizes, check that the certificate is fit for the intended use and verify that it is still valid.",{"_2802":1883,"_24443":1870,"_17120":45689,"_5":17015,"_23194":45651,"_2329":45690},[],"The CA hierarchy defines which authorities can sign. A root CA establishes the anchor of trust; intermediate CAs separate operating domains and avoid using the root for every issuance.",{"_2802":1884,"_24443":1870,"_17120":45692,"_5":17015,"_23194":45655,"_2329":45693},[],"Certificate profiles limit validity, subject, uses, extensions and cryptographic parameters. Possessing a CA does not replace an issuance policy.",{"_2802":1885,"_24443":1870,"_17120":45695,"_5":17015,"_23194":45659,"_2329":45696},[],"The DMS acts as the enrollment point. It can authenticate an EST request with a client certificate, an external webhook or a combination of both. CAs configured to validate the requester do not have to be the CA that will issue the new identity.",{"_2802":1886,"_24443":1870,"_17120":45698,"_5":17015,"_23194":45663,"_2329":45699},[],"The consumer keeps its own trust store. EST `/cacerts` can distribute the service TLS certificate, the enrollment CA and selected managed CAs. Initial trust for authenticating that service must come from an already trusted channel. Download and inspect the contents: do not assume they form a complete chain or install every entry as a root.",{"_2802":1887,"_24443":1870,"_17120":45701,"_5":17015,"_23194":45667,"_2329":45702},[],"The device proves it can enroll according to the DMS policy.",{"_2802":1888,"_24443":1870,"_17120":45704,"_5":17015,"_23194":45667,"_2329":45705},[],"The DMS validates the request and forwards the CSR to the enrollment CA.",{"_2802":1889,"_24443":1870,"_17120":45707,"_5":17015,"_23194":45667,"_2329":45708},[],"In the device-generated CSR flow, the CA applies the profile and signs without receiving the device’s private key.",{"_2802":1890,"_24443":1870,"_17120":45710,"_5":17015,"_23194":45667,"_2329":45711},[],"The device installs the certificate and the chain it needs.",{"_2802":1891,"_24443":1870,"_17120":45713,"_5":17015,"_23194":45667,"_2329":45714},[],"The system that trusts the device validates the chain, dates, uses and revocation status.",{"_2802":1892,"_24443":1870,"_17120":45716,"_5":17015,"_23194":45667,"_2329":45717},[],"OIDC or X.509 identifies the operator calling Lamassu. The authorization service decides which actions it may perform. The X.509 hierarchy, on the other hand, determines whether a certificate presented by a device is trustworthy.",{"_2802":1893,"_24443":1870,"_17120":45719,"_5":17015,"_23194":45671,"_2329":45720},[],"A DMS relates three sets that are worth designing separately:",{"_2802":1894,"_24443":1870,"_17120":45722,"_5":17015,"_23194":45671,"_2329":45723},[],"**Enrollment CA:** signs the new identities.",{"_2802":1895,"_24443":1870,"_17120":45725,"_5":17015,"_23194":45671,"_2329":45726},[],"**Validation CAs:** authenticate the client certificates used for enrollment or migration. During re-enrollment, Lamassu tries the enrollment CA first and then the additional validation CAs.",{"_2802":1896,"_24443":1870,"_17120":45728,"_5":17015,"_23194":45671,"_2329":45729},[],"**Distributed CAs:** form the content the device obtains through EST `/cacerts`. You can include the service TLS certificate, the enrollment CA and an explicit list of managed CAs. Including the issuer does not automatically add all its ancestors.",{"_2802":1897,"_24443":1870,"_17120":45731,"_5":17015,"_23194":45671,"_2329":45732},[],"This separation makes it possible to migrate a fleet: you temporarily accept certificates from the old hierarchy, issue with the new one and distribute both chains during the overlap.",{"_2802":1898,"_24443":1870,"_17120":45734,"_5":17015,"_23194":45675,"_2329":45735},[],"A valid chain does not by itself guarantee that a certificate should be accepted. The consumer must also check:",{"_2802":1899,"_24443":1870,"_17120":45737,"_5":17015,"_23194":45675,"_2329":45738},[],"that the current date is between `Not Before` and `Not After`;",{"_2802":1900,"_24443":1870,"_17120":45740,"_5":17015,"_23194":45675,"_2329":45741},[],"that `Key Usage` and `Extended Key Usage` allow the operation;",{"_2802":1901,"_24443":1870,"_17120":45743,"_5":17015,"_23194":45675,"_2329":45744},[],"that names, SANs and subject match the expected identity;",{"_2802":1902,"_24443":1870,"_17120":45746,"_5":17015,"_23194":45675,"_2329":45747},[],"that the certificate does not appear revoked in OCSP or a CRL.",{"_2802":1903,"_24443":1870,"_17120":45749,"_5":17015,"_23194":45675,"_2329":45750},[],"An OCSP `Good` status does not replace chain, date, usage and identity checks either; Validation brings those criteria together.",{"_2802":1904,"_24443":1870,"_17120":45752,"_5":17015,"_23194":45675,"_2329":45753},[],"During the mTLS authentication of a DMS, Lamassu attempts to check revocation. If the certificate does not contain enough information to perform that check, the backend logs a warning and continues treating it as not revoked. Design your profiles and distribution points to avoid that situation in production.",{"_2802":1905,"_24443":1870,"_17120":45755,"_5":17015,"_23194":45679,"_2329":45756},[],"The KMS keeps the reference to the key and delegates the operation to the configured engine. With an HSM or a cloud KMS, the private key can remain non-exportable. That protects custody, but it does not by itself prevent misuse: you still must restrict who can request a signature and audit those operations.",{"_2802":1906,"_24443":1870,"_17120":45758,"_5":17015,"_23194":45683,"_2329":45759},[],"Keep the root out of daily operations, or with very restricted access.",{"_2802":1907,"_24443":1870,"_17120":45761,"_5":17015,"_23194":45683,"_2329":45762},[],"Issue from intermediate CAs separated by environment or risk domain.",{"_2802":1908,"_24443":1870,"_17120":45764,"_5":17015,"_23194":45683,"_2329":45765},[],"Assign explicit profiles to every use case.",{"_2802":1909,"_24443":1870,"_17120":45767,"_5":17015,"_23194":45683,"_2329":45768},[],"Distribute the new trust before starting a rotation.",{"_2802":1910,"_24443":1870,"_17120":45770,"_5":17015,"_23194":45683,"_2329":45771},[],"Keep enough overlap to renew a disconnected fleet.",{"_2802":1911,"_24443":1870,"_17120":45773,"_5":17015,"_23194":45683,"_2329":45774},[],"Validate from the consuming system, not only from the Lamassu console.",{"_2802":1912,"_24443":1870,"_17120":45776,"_5":17015,"_23194":45683,"_2329":45777},[],"Continue with CA hierarchy and rotation to turn this model into an operating procedure.",{"_2802":1913,"_24443":1913,"_5":12033,"_2329":45779,"_24758":45780,"_17120":45781,"_23194":1913},"Revocation lists (CRL)",[39790,41134,44649,45266],[],{"_2802":1914,"_24443":1913,"_17120":45783,"_5":17015,"_23194":1913,"_2329":45784},[],"Generate and distribute signed lists to validate certificates offline.",{"_2802":1915,"_24443":1913,"_5":24755,"_17120":45786,"_23194":45787,"_2329":45788},[],"/docs/platform/pki/crl#va-role-and-per-ca-configuration","VA role and per-CA configuration",{"_2802":1916,"_24443":1913,"_5":24755,"_17120":45790,"_23194":45791,"_2329":45792},[],"/docs/platform/pki/crl#periodic-and-automatic-regeneration","Periodic and automatic regeneration",{"_2802":1917,"_24443":1913,"_5":24755,"_17120":45794,"_23194":45795,"_2329":45796},[],"/docs/platform/pki/crl#crl-contents","CRL contents",{"_2802":1918,"_24443":1913,"_5":24755,"_17120":45798,"_23194":45799,"_2329":45800},[],"/docs/platform/pki/crl#public-download-endpoint","Public download endpoint",{"_2802":1919,"_24443":1913,"_5":24755,"_17120":45802,"_23194":45803,"_2329":45804},[],"/docs/platform/pki/crl#va-role-management-api","VA role management API",{"_2802":1920,"_24443":1913,"_5":24755,"_17120":45806,"_23194":45807,"_2329":45808},[],"/docs/platform/pki/crl#from-the-interface","From the interface",{"_2802":1921,"_24443":1913,"_5":24755,"_17120":45810,"_23194":45811,"_2329":45812},[],"/docs/platform/pki/crl#references","References",{"_2802":1922,"_24443":1913,"_17120":45814,"_5":17015,"_23194":1913,"_2329":45815},[],"A CRL is an issuer-signed list of revoked certificates. This guide is for an operator publishing lists and an integrator using them locally. You need the issuing CA certificate, its SKI and access to the published endpoint. The client must maintain a current copy: offline operation still requires refreshing evidence.",{"_2802":1923,"_24443":1913,"_17120":45817,"_5":17015,"_23194":45787,"_2329":45818},[],"The VA role stores configuration and metadata for the latest list published for a CA’s SKI. Generation requires a usable issuer key; do not assume an imported CA without a key has an available CRL.",{"_2802":1924,"_24443":1913,"_17120":45820,"_5":17015,"_23194":45787,"_2329":45821},[],"`crl_options` field",{"_2802":1925,"_24443":1913,"_17120":45823,"_5":17015,"_23194":45787,"_2329":40173},[],{"_2802":1926,"_24443":1913,"_17120":45825,"_5":17015,"_23194":45787,"_2329":45826},[],"Backend initial value",{"_2802":1927,"_24443":1913,"_17120":45828,"_5":17015,"_23194":45787,"_2329":45829},[],"`validity`",{"_2802":1928,"_24443":1913,"_17120":45831,"_5":17015,"_23194":45787,"_2329":45832},[],"Time from `thisUpdate` to `nextUpdate`.",{"_2802":1929,"_24443":1913,"_17120":45834,"_5":17015,"_23194":45787,"_2329":45835},[],"7 days.",{"_2802":1930,"_24443":1913,"_17120":45837,"_5":17015,"_23194":45787,"_2329":45838},[],"`refresh_interval`",{"_2802":1931,"_24443":1913,"_17120":45840,"_5":17015,"_23194":45787,"_2329":45841},[],"Time since publication that triggers scheduled renewal.",{"_2802":1932,"_24443":1913,"_17120":45843,"_5":17015,"_23194":45787,"_2329":45844},[],"6 days and 23 hours.",{"_2802":1933,"_24443":1913,"_17120":45846,"_5":17015,"_23194":45787,"_2329":45847},[],"`regenerate_on_revoke`",{"_2802":1934,"_24443":1913,"_17120":45849,"_5":17015,"_23194":45787,"_2329":45850},[],"Request regeneration on revocation or reactivation from `CertificateHold` events.",{"_2802":1935,"_24443":1913,"_17120":45852,"_5":17015,"_23194":45787,"_2329":45853},[],"`true`.",{"_2802":1936,"_24443":1913,"_17120":45855,"_5":17015,"_23194":45787,"_2329":45856},[],"`subject_key_id_signer`",{"_2802":1937,"_24443":1913,"_17120":45858,"_5":17015,"_23194":45787,"_2329":45859},[],"Configuration field initialized with the CA’s SKI.",{"_2802":1938,"_24443":1913,"_17120":45861,"_5":17015,"_23194":45787,"_2329":45862},[],"CA SKI.",{"_2802":1939,"_24443":1913,"_17120":45864,"_5":17015,"_23194":45787,"_2329":45865},[],"The generator uses the key of the CA identified by the requested SKI. Do not interpret `subject_key_id_signer` as verified support for a different delegated CA: changing that field does not change the signer in this flow.",{"_2802":1940,"_24443":1913,"_17120":45867,"_5":17015,"_23194":45787,"_2329":45868},[],"`latest_crl` contains version, validity start and end. Versions are kept as PEM in object storage at `pki/va/crl/{subject_key_id}/{version}.crl`; the public endpoint returns DER.",{"_2802":1941,"_24443":1913,"_17120":45870,"_5":17015,"_23194":45791,"_2329":45871},[],"The scheduled job requests another list when `refresh_interval` is reached or when the list approaches expiration within the configured watch period. This depends on working jobs, storage and signing; it does not guarantee renewal during a service failure.",{"_2802":1942,"_24443":1913,"_17120":45873,"_5":17015,"_23194":45791,"_2329":45874},[],"With `regenerate_on_revoke`, the event handler requests a new CRL upon revocation or reactivation from `CertificateHold` to `ACTIVE`. This happens after the status change and has its own failure paths. Confirming revocation does not establish that the new CRL is already published or that all clients have downloaded it.",{"_2802":1943,"_24443":1913,"_17120":45876,"_5":17015,"_23194":45791,"_2329":45877},[],"Compare CRL numbers and timestamps before and after a change. Monitor expired lists and generation failures; clients must apply policy when current evidence is unavailable.",{"_2802":1944,"_24443":1913,"_17120":45879,"_5":17015,"_23194":45795,"_2329":45880},[],"Each entry contains serial number, revocation time and reason. The generator queries certificates in `REVOKED` state for the selected CA. A reactivated certificate disappears when the list is recalculated; an earlier downloaded copy retains its contents.",{"_2802":1945,"_24443":1913,"_17120":45882,"_5":17015,"_23194":45795,"_2329":45883},[],"The list contains a critical *Issuing Distribution Point* (OID `2.5.29.28`) with configured distribution URLs. Check that your client interprets this extension and that it matches the list’s scope. If rejected, investigate format and scope; ignoring a critical extension is not successful validation.",{"_2802":1946,"_24443":1913,"_17120":45885,"_5":17015,"_23194":45799,"_2329":45886},[],"The VA service exposes `GET /crl/{subject_key_id}` without management authorization. Use the **issuing CA’s** SKI, not the end-entity certificate’s SKI or serial. First inspect the certificate’s CDP:",{"_2802":1947,"_24443":1913,"_17120":45888,"_5":17015,"_23194":45799,"_2329":45889},[],"Replace the following URL with the CDP URL and review exposure in Deployment:",{"_2802":1948,"_24443":1913,"_17120":45891,"_5":17015,"_23194":45799,"_2329":45892},[],"You need OpenSSL 3.x and `issuer.pem` containing the direct issuer’s certificate. Require a valid signature, current timestamps and the expected issuer. For a root that issues directly:",{"_2802":1949,"_24443":1913,"_17120":45894,"_5":17015,"_23194":45799,"_2329":45895},[],"`roots.pem` contains deliberately trusted roots. For intermediates, add `-untrusted intermediates.pem` before the `device.crt` argument. `-crl_check` checks the end-entity certificate’s revocation against the local list; it does not download other lists or establish the status of the whole chain. A complete chain check needs the corresponding CRLs and a policy requiring them.",{"_2802":1950,"_24443":1913,"_17120":45897,"_5":17015,"_23194":45799,"_2329":45898},[],"The test should accept an allowed certificate absent from the list and reject it with `certificate revoked` after publishing and using the list containing its serial.",{"_2802":1951,"_24443":1913,"_17120":45900,"_5":17015,"_23194":45803,"_2329":45901},[],"The following paths are relative to the VA service; confirm the public prefix in the Gateway. They are not the URLs of the public OCSP and CRL endpoints.",{"_2802":1952,"_24443":1913,"_17120":45903,"_5":17015,"_23194":45803,"_2329":42722},[],{"_2802":1953,"_24443":1913,"_17120":45905,"_5":17015,"_23194":45803,"_2329":45906},[],"Relative path",{"_2802":1954,"_24443":1913,"_17120":45908,"_5":17015,"_23194":45803,"_2329":42719},[],{"_2802":1955,"_24443":1913,"_17120":45910,"_5":17015,"_23194":45803,"_2329":45911},[],"`GET`",{"_2802":1956,"_24443":1913,"_17120":45913,"_5":17015,"_23194":45803,"_2329":45914},[],"`/v1/roles/{ca-ski}`",{"_2802":1957,"_24443":1913,"_17120":45916,"_5":17015,"_23194":45803,"_2329":45917},[],"Read `crl_options` and `latest_crl`.",{"_2802":1958,"_24443":1913,"_17120":45919,"_5":17015,"_23194":45803,"_2329":45920},[],"`PUT`",{"_2802":1959,"_24443":1913,"_17120":45922,"_5":17015,"_23194":45803,"_2329":45914},[],{"_2802":1960,"_24443":1913,"_17120":45924,"_5":17015,"_23194":45803,"_2329":45925},[],"Replace CRL configuration.",{"_2802":1961,"_24443":1913,"_17120":45927,"_5":17015,"_23194":45803,"_2329":45928},[],"You need authentication and role read or update permissions. Consult your installation’s API reference and Access control. Read current configuration before updating and send the full object expected by the contract: the backend replaces `crl_options`; it does not merge omitted fields.",{"_2802":1962,"_24443":1913,"_17120":45930,"_5":17015,"_23194":45803,"_2329":45931},[],"After a change, check saved configuration and the next list actually published. Updating the role alone does not establish regeneration or client acceptance.",{"_2802":1963,"_24443":1913,"_17120":45933,"_5":17015,"_23194":45807,"_2329":45934},[],"The CA view lets you inspect and download the available list. Compare version, issuer and timestamps with the copy downloaded from the public endpoint. Diagnose differences using PKI troubleshooting.",{"_2802":1964,"_24443":1913,"_17120":45936,"_5":17015,"_23194":45811,"_2329":45937},[],"RFC 5280: X.509 and CRL profile.",{"_2802":1965,"_24443":1913,"_17120":45939,"_5":17015,"_23194":45811,"_2329":45940},[],"OpenSSL: openssl-crl.",{"_2802":1966,"_24443":1913,"_17120":45942,"_5":17015,"_23194":45811,"_2329":45943},[],"OpenSSL: openssl-verify.",{"_2802":1967,"_24443":1913,"_17120":45945,"_5":17015,"_23194":45811,"_2329":45946},[],"<Card title=\"OCSP service\" href=\"/docs/platform/pki/ocsp\" />",{"_2802":1968,"_24443":1913,"_17120":45948,"_5":17015,"_23194":45811,"_2329":45949},[],"<Card title=\"Certificate validation\" href=\"/docs/platform/pki/certificate-validation\" />",{"_2802":1969,"_24443":1969,"_5":12033,"_2329":45951,"_24758":45952,"_17120":45953,"_23194":1969},"Keys and cryptographic engines",[39790,41134,44649,44650],[],{"_2802":1970,"_24443":1969,"_17120":45955,"_5":17015,"_23194":1969,"_2329":45956},[],"Generate, import and operate keys without coupling the PKI to a specific provider.",{"_2802":1971,"_24443":1969,"_5":24755,"_17120":45958,"_23194":45959,"_2329":45960},[],"/docs/platform/pki/key-management#what-the-kms-solves","What the KMS solves",{"_2802":1972,"_24443":1969,"_5":24755,"_17120":45962,"_23194":45963,"_2329":45964},[],"/docs/platform/pki/key-management#cryptographic-engines","Cryptographic engines",{"_2802":1973,"_24443":1969,"_5":24755,"_17120":45966,"_23194":45967,"_2329":45968},[],"/docs/platform/pki/key-management#file-system","File System",{"_2802":1974,"_24443":1969,"_5":24755,"_17120":45970,"_23194":45971,"_2329":45972},[],"/docs/platform/pki/key-management#hashicorp-vault","HashiCorp Vault",{"_2802":1975,"_24443":1969,"_5":24755,"_17120":45974,"_23194":45975,"_2329":45976},[],"/docs/platform/pki/key-management#aws-secrets-manager","AWS Secrets Manager",{"_2802":1976,"_24443":1969,"_5":24755,"_17120":45978,"_23194":45979,"_2329":45980},[],"/docs/platform/pki/key-management#aws-kms","AWS KMS",{"_2802":1977,"_24443":1969,"_5":24755,"_17120":45982,"_23194":45983,"_2329":45984},[],"/docs/platform/pki/key-management#pkcs11","PKCS#11",{"_2802":1978,"_24443":1969,"_5":24755,"_17120":45986,"_23194":45987,"_2329":45988},[],"/docs/platform/pki/key-management#azure-key-vault","Azure Key Vault",{"_2802":1979,"_24443":1969,"_5":24755,"_17120":45990,"_23194":45991,"_2329":45992},[],"/docs/platform/pki/key-management#key-inventory","Key inventory",{"_2802":1980,"_24443":1969,"_5":24755,"_17120":45994,"_23194":45995,"_2329":45996},[],"/docs/platform/pki/key-management#create-or-import-keys","Create or import keys",{"_2802":1981,"_24443":1969,"_5":24755,"_17120":45998,"_23194":45999,"_2329":46000},[],"/docs/platform/pki/key-management#generate-a-new-key-pair","Generate a new key pair",{"_2802":1982,"_24443":1969,"_5":24755,"_17120":46002,"_23194":46003,"_2329":46004},[],"/docs/platform/pki/key-management#import-an-existing-pair","Import an existing pair",{"_2802":1983,"_24443":1969,"_5":24755,"_17120":46006,"_23194":46007,"_2329":46008},[],"/docs/platform/pki/key-management#operations-on-a-key","Operations on a key",{"_2802":1984,"_24443":1969,"_5":24755,"_17120":46010,"_23194":46011,"_2329":46012},[],"/docs/platform/pki/key-management#view-details","View details",{"_2802":1985,"_24443":1969,"_5":24755,"_17120":46014,"_23194":46015,"_2329":46016},[],"/docs/platform/pki/key-management#sign-and-verify","Sign and verify",{"_2802":1986,"_24443":1969,"_5":24755,"_17120":46018,"_23194":46019,"_2329":46020},[],"/docs/platform/pki/key-management#sign","Sign",{"_2802":1987,"_24443":1969,"_5":24755,"_17120":46022,"_23194":46023,"_2329":46024},[],"/docs/platform/pki/key-management#verify","Verify",{"_2802":1988,"_24443":1969,"_5":24755,"_17120":46026,"_23194":46027,"_2329":46028},[],"/docs/platform/pki/key-management#generate-a-csr","Generate a CSR",{"_2802":1989,"_24443":1969,"_5":24755,"_17120":46030,"_23194":46031,"_2329":46032},[],"/docs/platform/pki/key-management#sign-locally-with-pkcs11","Sign locally with PKCS#11",{"_2802":1990,"_24443":1969,"_5":24755,"_17120":46034,"_23194":46035,"_2329":46036},[],"/docs/platform/pki/key-management#before-deleting-a-key","Before deleting a key",{"_2802":1991,"_24443":1969,"_17120":46038,"_5":17015,"_23194":1969,"_2329":46039},[],"The Cryptographic Key Management Service (KMS) of Lamassu IoT centralizes the generation, import, custody and use of the platform's keys. This is where you manage the keys that support the CAs and the rest of the signing operations that depend on the PKI.",{"_2802":1992,"_24443":1969,"_17120":46041,"_5":17015,"_23194":1969,"_2329":46042},[],"In the current configuration, Lamassu IoT works exclusively with asymmetric keys, such as RSA and elliptic curves. These keys are used to issue X.509 certificates, sign requests and perform authentication and validation operations within the system.",{"_2802":1993,"_24443":1969,"_17120":46044,"_5":17015,"_23194":45959,"_2329":46045},[],"The KMS unifies key lifecycle management and prevents every service from having to integrate directly with a specific cryptographic provider.",{"_2802":1994,"_24443":1969,"_17120":46047,"_5":17015,"_23194":45959,"_2329":46048},[],"In practice, it lets you:",{"_2802":1995,"_24443":1969,"_17120":46050,"_5":17015,"_23194":45959,"_2329":46051},[],"Generate new key pairs from Lamassu IoT.",{"_2802":1996,"_24443":1969,"_17120":46053,"_5":17015,"_23194":45959,"_2329":46054},[],"Import keys created externally.",{"_2802":1997,"_24443":1969,"_17120":46056,"_5":17015,"_23194":45959,"_2329":46057},[],"Delegate custody and cryptographic operations to external engines.",{"_2802":1998,"_24443":1969,"_17120":46059,"_5":17015,"_23194":45959,"_2329":46060},[],"Reuse existing keys for CAs, CSRs and signing or verification tasks.",{"_2802":1999,"_24443":1969,"_17120":46062,"_5":17015,"_23194":45963,"_2329":46063},[],"Lamassu can work with different cryptographic engines depending on deployment requirements. In some environments a software engine is enough; in others custody must be delegated to an HSM, a cloud service or a specialized platform.",{"_2802":2000,"_24443":1969,"_17120":46065,"_5":17015,"_23194":45963,"_2329":46066},[],"A single instance can have several engines configured at the same time, including multiple instances of the same type. This lets you adapt operations to different security, cost and regulatory requirements.",{"_2802":2001,"_24443":1969,"_17120":46068,"_5":17015,"_23194":45963,"_2329":46069},[],"This guide is for the PKI operator: select and use an already enabled engine. Installation, credentials, persistent storage and connectivity belong to Deployment. Before generating a CA, check the default engine, advertised algorithms and a test signature. Availability in your installation depends on its version and configuration.",{"_2802":2002,"_24443":1969,"_17120":46071,"_5":17015,"_23194":45967,"_2329":46072},[],"Generates software keys and stores private material in files. Custody depends on installation permissions, storage and backups. Before using it for an operational CA, agree how the key will be recovered and how replicas will access it; the KMS record does not replace those files.",{"_2802":2003,"_24443":1969,"_17120":46074,"_5":17015,"_23194":45971,"_2329":46075},[],"The adapter uses KV storage for private material. This is not signing within Vault Transit: someone able to read the secret can recover the key. Review read permissions, availability and recovery with the deployment owner.",{"_2802":2004,"_24443":1969,"_17120":46077,"_5":17015,"_23194":45975,"_2329":46078},[],"Offers encrypted persistence in AWS at a cost. It protects the key at rest, but an authorized administrator can recover it; it does not provide the same extraction resistance as a KMS or HSM.",{"_2802":2005,"_24443":1969,"_17120":46080,"_5":17015,"_23194":45979,"_2329":46081},[],"Delegates signing to AWS KMS. The adapter also implements external material import, subject to provider capabilities and permissions. A key generated outside the service has already existed outside its custody; importing it does not remove those copies. Check generation, import and signing as separate operations.",{"_2802":2006,"_24443":1969,"_17120":46083,"_5":17015,"_23194":45983,"_2329":46084},[],"Allows integrating local HSMs, isolated environments and *Key as a Service* offerings. Generation, persistence and extraction resistance depend on the specific device or provider. It is the most flexible option when policy requires hardware custody.",{"_2802":2007,"_24443":1969,"_17120":46086,"_5":17015,"_23194":45987,"_2329":46087},[],"The backend also provides adapters for **Key Vault Keys** and **Key Vault Secrets**. The former delegates signing to the key service; the latter stores private material as secrets and signs using that material. These are different custody models. Confirm which adapter is enabled in your installation and test the required operations.",{"_2802":2008,"_24443":1969,"_17120":46089,"_5":17015,"_23194":45987,"_2329":46090},[],"Lamassu shows the enabled engines in the console.",{"_2802":2009,"_24443":1969,"_17120":46092,"_5":17015,"_23194":45987,"_2329":46093},[],"Each engine defines which algorithms it supports, such as RSA or ECC/ECDSA, and which key sizes it can generate.",{"_2802":2010,"_24443":1969,"_17120":46095,"_5":17015,"_23194":45987,"_2329":46096},[],"Confirm with the deployment operator which engine is configured as the default. That engine will be used when a process needs to create or persist a key and the user has not selected a specific one, for example when creating or importing a CA.",{"_2802":2011,"_24443":1969,"_17120":46098,"_5":17015,"_23194":45991,"_2329":46099},[],"The main KMS screen shows the complete inventory of keys registered in the system. It is the reference view for reviewing which keys exist, where they are kept and which entities they relate to.",{"_2802":2012,"_24443":1969,"_17120":46101,"_5":17015,"_23194":45991,"_2329":46102},[],"The table includes the following fields:",{"_2802":2013,"_24443":1969,"_17120":46104,"_5":17015,"_23194":45991,"_2329":46105},[],"**Name**: descriptive name of the key.",{"_2802":2014,"_24443":1969,"_17120":46107,"_5":17015,"_23194":45991,"_2329":46108},[],"**Type**: algorithm and key size, for example RSA 2048 or EC P-256.",{"_2802":2015,"_24443":1969,"_17120":46110,"_5":17015,"_23194":45991,"_2329":46111},[],"**Strength**: visual indicator of cryptographic strength.",{"_2802":2016,"_24443":1969,"_17120":46113,"_5":17015,"_23194":45991,"_2329":46114},[],"**Public/Private**: whether Lamassu manages the full pair or only the public key.",{"_2802":2017,"_24443":1969,"_17120":46116,"_5":17015,"_23194":45991,"_2329":46117},[],"**Crypto Engine**: cryptographic engine keeping the key.",{"_2802":2018,"_24443":1969,"_17120":46119,"_5":17015,"_23194":45991,"_2329":46120},[],"**Aliases**: alternative names associated with the key.",{"_2802":2019,"_24443":1969,"_17120":46122,"_5":17015,"_23194":45991,"_2329":46123},[],"**Tags**: labels for classification and search.",{"_2802":2020,"_24443":1969,"_17120":46125,"_5":17015,"_23194":45991,"_2329":46126},[],"**Related Entities**: certificates or other entities linked to that key.",{"_2802":2021,"_24443":1969,"_17120":46128,"_5":17015,"_23194":45991,"_2329":46129},[],"From this view you also reach the most common actions:",{"_2802":2022,"_24443":1969,"_17120":46131,"_5":17015,"_23194":45991,"_2329":46132},[],"**View Details** to inspect metadata, identifiers and relationships.",{"_2802":2023,"_24443":1969,"_17120":46134,"_5":17015,"_23194":45991,"_2329":46135},[],"**Generate CSR** to create a PKCS#10 request with the selected key.",{"_2802":2024,"_24443":1969,"_17120":46137,"_5":17015,"_23194":45991,"_2329":46138},[],"**Sign / Verify** to test cryptographic operations on the key.",{"_2802":2025,"_24443":1969,"_17120":46140,"_5":17015,"_23194":45991,"_2329":46141},[],"**Delete Key** to remove the key from the system.",{"_2802":2026,"_24443":1969,"_17120":46143,"_5":17015,"_23194":45995,"_2329":46144},[],"You need key administration permissions and a reachable engine. The issuance profile must allow the chosen algorithm if the key will be used in a CA or CSR. Open **Create New Key** and choose generation or import.",{"_2802":2027,"_24443":1969,"_17120":46146,"_5":17015,"_23194":45999,"_2329":46147},[],"If the key will be born inside Lamassu, the recommended flow is to generate a new pair managed directly by one of the configured engines.",{"_2802":2028,"_24443":1969,"_17120":46149,"_5":17015,"_23194":45999,"_2329":46150},[],"On the wizard's first screen, choose **Generate New Key Pair** and then define the main parameters:",{"_2802":2029,"_24443":1969,"_17120":46152,"_5":17015,"_23194":45999,"_2329":46153},[],"**Key Name**: unique and descriptive name.",{"_2802":2030,"_24443":1969,"_17120":46155,"_5":17015,"_23194":45999,"_2329":46156},[],"**Crypto Engine**: engine that will keep the key.",{"_2802":2031,"_24443":1969,"_17120":46158,"_5":17015,"_23194":45999,"_2329":46159},[],"**Key Type** and **Key Size**: algorithm and size or curve.",{"_2802":2032,"_24443":1969,"_17120":46161,"_5":17015,"_23194":45999,"_2329":46162},[],"**Tags**: metadata to classify the key.",{"_2802":2033,"_24443":1969,"_17120":46164,"_5":17015,"_23194":45999,"_2329":46165},[],"**Metadata**: additional information for advanced uses.",{"_2802":2034,"_24443":1969,"_17120":46167,"_5":17015,"_23194":46003,"_2329":46168},[],"Importing lets you register in Lamassu a key generated outside the platform. It is the usual flow in BYOK scenarios, migrations or integration with cryptographic material already in production.",{"_2802":2035,"_24443":1969,"_17120":46170,"_5":17015,"_23194":46003,"_2329":46171},[],"When you have an exportable private key and the destination engine supports import.",{"_2802":2036,"_24443":1969,"_17120":46173,"_5":17015,"_23194":46003,"_2329":46174},[],"When an existing PKI needs to be migrated without reissuing certificates.",{"_2802":2037,"_24443":1969,"_17120":46176,"_5":17015,"_23194":46003,"_2329":46177},[],"When Lamassu must operate with a root of trust created by a third party.",{"_2802":2038,"_24443":1969,"_17120":46179,"_5":17015,"_23194":46003,"_2329":46180},[],"In the wizard, choose **Import Existing Key Pair** and complete the requested fields:",{"_2802":2039,"_24443":1969,"_17120":46182,"_5":17015,"_23194":46003,"_2329":46183},[],"**Key Name**: descriptive name within Lamassu IoT.",{"_2802":2040,"_24443":1969,"_17120":46185,"_5":17015,"_23194":46003,"_2329":46186},[],"**Crypto Engine**: engine that will keep the imported key.",{"_2802":2041,"_24443":1969,"_17120":46188,"_5":17015,"_23194":46003,"_2329":46189},[],"**Tags**: labels for organization and search.",{"_2802":2042,"_24443":1969,"_17120":46191,"_5":17015,"_23194":46003,"_2329":46192},[],"**Metadata**: additional optional information.",{"_2802":2043,"_24443":1969,"_17120":46194,"_5":17015,"_23194":46003,"_2329":46195},[],"**Private Key (PEM)**: private key in PEM format.",{"_2802":2044,"_24443":1969,"_17120":46197,"_5":17015,"_23194":46003,"_2329":46198},[],"After a successful import, open the record, check the engine and public key, and perform a test signature. A non-exportable HSM key cannot be uploaded through this PEM form: configure engine access and check how the existing key is registered. Review dependencies and any provider resources already created if an operation fails partway through.",{"_2802":2045,"_24443":1969,"_17120":46200,"_5":17015,"_23194":46007,"_2329":46201},[],"Each registered key has a detail view and several operational actions.",{"_2802":2046,"_24443":1969,"_17120":46203,"_5":17015,"_23194":46011,"_2329":46204},[],"The **View Details** screen concentrates the technical and administrative information of the key.",{"_2802":2047,"_24443":1969,"_17120":46206,"_5":17015,"_23194":46011,"_2329":46207},[],"The **Overview** tab shows, among others, these fields:",{"_2802":2048,"_24443":1969,"_17120":46209,"_5":17015,"_23194":46011,"_2329":46210},[],"**Key Name**: descriptive name.",{"_2802":2049,"_24443":1969,"_17120":46212,"_5":17015,"_23194":46011,"_2329":46213},[],"**Key Identifier**: unique system identifier. Lamassu uses PKCS11-based ID formats.",{"_2802":2050,"_24443":1969,"_17120":46215,"_5":17015,"_23194":46011,"_2329":46216},[],"**Tags**: associated labels.",{"_2802":2051,"_24443":1969,"_17120":46218,"_5":17015,"_23194":46011,"_2329":46219},[],"**Aliases**: alternative names.",{"_2802":2052,"_24443":1969,"_17120":46221,"_5":17015,"_23194":46011,"_2329":46222},[],"**Crypto Engine**: engine where the key resides.",{"_2802":2053,"_24443":1969,"_17120":46224,"_5":17015,"_23194":46011,"_2329":46225},[],"**Algorithm, Key Size & Strength**: algorithm, parameters and strength level.",{"_2802":2054,"_24443":1969,"_17120":46227,"_5":17015,"_23194":46011,"_2329":46228},[],"The **Related Entities** section shows which Lamassu objects depend on that key.",{"_2802":2055,"_24443":1969,"_17120":46230,"_5":17015,"_23194":46011,"_2329":46231},[],"The **Public Key** tab shows public material in PEM. The record’s identifier and URI locate the key; a PKCS#11-formatted URI does not establish that the engine is an HSM or that a local module can access it.",{"_2802":2056,"_24443":1969,"_17120":46233,"_5":17015,"_23194":46015,"_2329":46234},[],"The **Sign / Verify** action validates that the key and the cryptographic engine work correctly.",{"_2802":2057,"_24443":1969,"_17120":46236,"_5":17015,"_23194":46015,"_2329":46237},[],"Sign a test message, save the signature and verify it using the same public key, algorithm and encoding. Then change the message: verification should fail. This tests one operation; it does not establish every engine capability or a CA’s chain.",{"_2802":2058,"_24443":1969,"_17120":46239,"_5":17015,"_23194":46015,"_2329":46240},[],"When you open it, two areas appear: **Sign** and **Verify**.",{"_2802":2059,"_24443":1969,"_17120":46242,"_5":17015,"_23194":46019,"_2329":46243},[],"This tab uses the private key to generate a digital signature over a message or an already computed *digest*.",{"_2802":2060,"_24443":1969,"_17120":46245,"_5":17015,"_23194":46019,"_2329":46246},[],"Main fields:",{"_2802":2061,"_24443":1969,"_17120":46248,"_5":17015,"_23194":46019,"_2329":46249},[],"**Algorithm**: signing algorithm available for the key type.",{"_2802":2062,"_24443":1969,"_17120":46251,"_5":17015,"_23194":46019,"_2329":46252},[],"**Message Type**: `Raw` for clear data or `Digest` for a precomputed hash.",{"_2802":2063,"_24443":1969,"_17120":46254,"_5":17015,"_23194":46019,"_2329":46255},[],"**Payload Encoding**: input encoding, such as UTF-8, Hex or Base64.",{"_2802":2064,"_24443":1969,"_17120":46257,"_5":17015,"_23194":46019,"_2329":46258},[],"**Message**: content to sign.",{"_2802":2065,"_24443":1969,"_17120":46260,"_5":17015,"_23194":46019,"_2329":46261},[],"**Signature**: result of the operation, shown in hexadecimal.",{"_2802":2066,"_24443":1969,"_17120":46263,"_5":17015,"_23194":46023,"_2329":46264},[],"This tab checks whether a signature corresponds to the associated public key.",{"_2802":2067,"_24443":1969,"_17120":46266,"_5":17015,"_23194":46023,"_2329":46246},[],{"_2802":2068,"_24443":1969,"_17120":46268,"_5":17015,"_23194":46023,"_2329":46269},[],"**Algorithm**: must match the algorithm used for the signature.",{"_2802":2069,"_24443":1969,"_17120":46271,"_5":17015,"_23194":46023,"_2329":46272},[],"**Message Type**: `Raw` or `Digest`.",{"_2802":2070,"_24443":1969,"_17120":46274,"_5":17015,"_23194":46023,"_2329":46275},[],"**Payload Encoding**: encoding of the message.",{"_2802":2071,"_24443":1969,"_17120":46277,"_5":17015,"_23194":46023,"_2329":46278},[],"**Message**: original message or hash.",{"_2802":2072,"_24443":1969,"_17120":46280,"_5":17015,"_23194":46023,"_2329":46281},[],"**Signature**: signature to check.",{"_2802":2073,"_24443":1969,"_17120":46283,"_5":17015,"_23194":46023,"_2329":46284},[],"**Result**: indicator of the validation result.",{"_2802":2074,"_24443":1969,"_17120":46286,"_5":17015,"_23194":46027,"_2329":46287},[],"The **Generate CSR** action creates a PKCS#10 request signed with the private key kept in Lamassu, without exposing it outside the cryptographic engine.",{"_2802":2075,"_24443":1969,"_17120":46289,"_5":17015,"_23194":46027,"_2329":46290},[],"This flow is useful for:",{"_2802":2076,"_24443":1969,"_17120":46292,"_5":17015,"_23194":46027,"_2329":46293},[],"Requesting certificates from an external CA.",{"_2802":2077,"_24443":1969,"_17120":46295,"_5":17015,"_23194":46027,"_2329":46296},[],"Renewing an identity while keeping the same key.",{"_2802":2078,"_24443":1969,"_17120":46298,"_5":17015,"_23194":46027,"_2329":46299},[],"When you open the form, it asks for the subject data and the main certificate attributes:",{"_2802":2079,"_24443":1969,"_17120":46301,"_5":17015,"_23194":46027,"_2329":46302},[],"**Common Name (CN)**: main name of the identity.",{"_2802":2080,"_24443":1969,"_17120":46304,"_5":17015,"_23194":46027,"_2329":46305},[],"**Organization (O)**: organization or company.",{"_2802":2081,"_24443":1969,"_17120":46307,"_5":17015,"_23194":46027,"_2329":46308},[],"**Organizational Unit (OU)**: department or unit.",{"_2802":2082,"_24443":1969,"_17120":46310,"_5":17015,"_23194":46027,"_2329":46311},[],"**Country (C)**: two-letter country code.",{"_2802":2083,"_24443":1969,"_17120":46313,"_5":17015,"_23194":46027,"_2329":46314},[],"**State / Province (ST)**: state or province.",{"_2802":2084,"_24443":1969,"_17120":46316,"_5":17015,"_23194":46027,"_2329":46317},[],"**Locality (L)**: city or locality.",{"_2802":2085,"_24443":1969,"_17120":46319,"_5":17015,"_23194":46027,"_2329":46320},[],"**Email Address**: contact email.",{"_2802":2086,"_24443":1969,"_17120":46322,"_5":17015,"_23194":46027,"_2329":46323},[],"**Subject Alternative Names (SANs)**: alternative names or identifiers, such as DNS or IP.",{"_2802":2087,"_24443":1969,"_17120":46325,"_5":17015,"_23194":46027,"_2329":46326},[],"Download the CSR and run `openssl req -in request.csr -noout -verify -text`. Check signature, subject and SAN before sending it. A CSR does not determine the final certificate by itself: issuance policy can replace its fields.",{"_2802":2088,"_24443":1969,"_17120":46328,"_5":17015,"_23194":46031,"_2329":46329},[],"Lamassu also offers specific help for local integrations through **Sign locally with OpenSSL & PKCS11 tools**.",{"_2802":2089,"_24443":1969,"_17120":46331,"_5":17015,"_23194":46031,"_2329":46332},[],"Requiere el módulo, token y permisos del proveedor correspondiente. Comprueba que el identificador de Lamassu se corresponde con el objeto accesible desde ese módulo. La configuración del módulo pertenece al entorno del cliente o al Despliegue.",{"_2802":2090,"_24443":1969,"_17120":46334,"_5":17015,"_23194":46035,"_2329":46335},[],"Review **Related Entities** and locate CAs, certificates and validation processes that still need signatures. Revoking a CA does not remove the need to publish status during its retention period. Deleting a key does not automatically revoke its certificates either. Plan replacement and retention before using **Delete Key**; provider deletion behavior depends on the engine.",{"_2802":2091,"_24443":2091,"_5":12033,"_2329":46337,"_24758":46338,"_17120":46339,"_23194":2091},"Online validation with OCSP",[39790,41134,44649,45266],[],{"_2802":2092,"_24443":2091,"_17120":46341,"_5":17015,"_23194":2091,"_2329":46342},[],"Query signed status and verify the responder’s response.",{"_2802":2093,"_24443":2091,"_5":24755,"_17120":46344,"_23194":46345,"_2329":46346},[],"/docs/platform/pki/ocsp#how-the-responder-works-in-lamassu","How the responder works in Lamassu",{"_2802":2094,"_24443":2091,"_5":24755,"_17120":46348,"_23194":46349,"_2329":46350},[],"/docs/platform/pki/ocsp#embedding-in-issued-certificates","Embedding in issued certificates",{"_2802":2095,"_24443":2091,"_5":24755,"_17120":46352,"_23194":46353,"_2329":46354},[],"/docs/platform/pki/ocsp#http-endpoints","HTTP endpoints",{"_2802":2096,"_24443":2091,"_5":24755,"_17120":46356,"_23194":46357,"_2329":46358},[],"/docs/platform/pki/ocsp#generate-and-verify-a-query","Generate and verify a query",{"_2802":2097,"_24443":2091,"_5":24755,"_17120":46360,"_23194":46361,"_2329":46362},[],"/docs/platform/pki/ocsp#check-from-the-interface","Check from the interface",{"_2802":2098,"_24443":2091,"_5":24755,"_17120":46364,"_23194":46365,"_2329":45812},[],"/docs/platform/pki/ocsp#references",{"_2802":2099,"_24443":2091,"_17120":46367,"_5":17015,"_23194":2091,"_2329":46368},[],"OCSP queries a certificate’s status and returns a signed response. This guide is for an integrator checking what Lamassu publishes and how the consumer must verify it. For complete identity validation, follow Certificate validation.",{"_2802":2100,"_24443":2091,"_17120":46370,"_5":17015,"_23194":46345,"_2329":46371},[],"The responder retrieves the certificate by serial number and locates its issuing CA in the inventory. It translates persisted status as follows:",{"_2802":2101,"_24443":2091,"_17120":46373,"_5":17015,"_23194":46345,"_2329":46374},[],"Record status",{"_2802":2102,"_24443":2091,"_17120":46376,"_5":17015,"_23194":46345,"_2329":46377},[],"Signed response",{"_2802":2103,"_24443":2091,"_17120":46379,"_5":17015,"_23194":46345,"_2329":43827},[],{"_2802":2104,"_24443":2091,"_17120":46381,"_5":17015,"_23194":46345,"_2329":46382},[],"`Good`.",{"_2802":2105,"_24443":2091,"_17120":46384,"_5":17015,"_23194":46345,"_2329":43844},[],{"_2802":2106,"_24443":2091,"_17120":46386,"_5":17015,"_23194":46345,"_2329":46387},[],"`Revoked`, with revocation reason and timestamp.",{"_2802":2107,"_24443":2091,"_17120":46389,"_5":17015,"_23194":46345,"_2329":46390},[],"Other states, including `INACTIVE` and `EXPIRED`",{"_2802":2108,"_24443":2091,"_17120":46392,"_5":17015,"_23194":46345,"_2329":46393},[],"`Unknown` if the certificate and issuer can be retrieved.",{"_2802":2109,"_24443":2091,"_17120":46395,"_5":17015,"_23194":46345,"_2329":46396},[],"An absent serial number causes a lookup error; it does not guarantee a signed `Unknown` response. Lookup or signing errors produce an HTTP failure. Treat that as unavailable evidence according to consumer policy.",{"_2802":2110,"_24443":2091,"_17120":46398,"_5":17015,"_23194":46345,"_2329":46399},[],"The issuing CA itself signs the response through its KMS-associated key. A delegated OCSP signing certificate is not used. An imported CA without a usable key cannot sign responses.",{"_2802":2111,"_24443":2091,"_17120":46401,"_5":17015,"_23194":46345,"_2329":46402},[],"The implementation sets `thisUpdate` approximately one day before response generation and `nextUpdate` one day after: the declared window is about 48 hours. Inspect received values and apply your freshness policy. The response reflects stored status when queried; a previously cached copy does not change upon revocation.",{"_2802":2112,"_24443":2091,"_17120":46404,"_5":17015,"_23194":46349,"_2329":46405},[],"The signer constructs OCSP URLs from configured VA domains and adds them to AIA. Without domains, there is no URL to add; an imported certificate retains its original extensions. Inspect the actual certificate:",{"_2802":2113,"_24443":2091,"_17120":46407,"_5":17015,"_23194":46349,"_2329":46408},[],"Check that the consumer can reach this URL. DNS, endpoint exposure and domain configuration belong to Deployment. Changing configuration does not modify already signed certificates.",{"_2802":2114,"_24443":2091,"_17120":46410,"_5":17015,"_23194":46353,"_2329":46411},[],"The service accepts:",{"_2802":2115,"_24443":2091,"_17120":46413,"_5":17015,"_23194":46353,"_2329":42722},[],{"_2802":2116,"_24443":2091,"_17120":46415,"_5":17015,"_23194":46353,"_2329":46416},[],"VA service path",{"_2802":2117,"_24443":2091,"_17120":46418,"_5":17015,"_23194":46353,"_2329":46419},[],"Format",{"_2802":2118,"_24443":2091,"_17120":46421,"_5":17015,"_23194":46353,"_2329":46422},[],"`POST`",{"_2802":2119,"_24443":2091,"_17120":46424,"_5":17015,"_23194":46353,"_2329":46425},[],"`/ocsp`",{"_2802":2120,"_24443":2091,"_17120":46427,"_5":17015,"_23194":46353,"_2329":46428},[],"DER request, `Content-Type: application/ocsp-request`.",{"_2802":2121,"_24443":2091,"_17120":46430,"_5":17015,"_23194":46353,"_2329":45911},[],{"_2802":2122,"_24443":2091,"_17120":46432,"_5":17015,"_23194":46353,"_2329":46433},[],"`/ocsp/{ocsp_request}`",{"_2802":2123,"_24443":2091,"_17120":46435,"_5":17015,"_23194":46353,"_2329":46436},[],"DER request encoded using padded URL Base64.",{"_2802":2124,"_24443":2091,"_17120":46438,"_5":17015,"_23194":46353,"_2329":46439},[],"Use POST to avoid client encoding differences. A successful response has `Content-Type: application/ocsp-response` and a DER body. The public prefix depends on the Gateway; use the URL published in the certificate and checked by the operator.",{"_2802":2125,"_24443":2091,"_17120":46441,"_5":17015,"_23194":46357,"_2329":46442},[],"You need OpenSSL 3.x, `device.crt`, its direct issuer’s certificate `issuer.pem` and the consumer’s trusted roots in `roots.pem`. For an intermediate issuer, also prepare `intermediates.pem` containing the intermediate CAs.",{"_2802":2126,"_24443":2091,"_17120":46444,"_5":17015,"_23194":46357,"_2329":46445},[],"Generate the request:",{"_2802":2127,"_24443":2091,"_17120":46447,"_5":17015,"_23194":46357,"_2329":46448},[],"This example omits the nonce because the responder does not echo it. Verification relies on signature, response correspondence and timestamps; it does not demonstrate freshness through a nonce.",{"_2802":2128,"_24443":2091,"_17120":46450,"_5":17015,"_23194":46357,"_2329":46451},[],"Replace the example URL with the inspected endpoint:",{"_2802":2129,"_24443":2091,"_17120":46453,"_5":17015,"_23194":46357,"_2329":46454},[],"Verify the returned DER:",{"_2802":2130,"_24443":2091,"_17120":46456,"_5":17015,"_23194":46357,"_2329":46457},[],"For intermediates, add `-verify_other intermediates.pem`. Require successful response verification and inspect the status corresponding to `device.crt`, issuer, serial, `thisUpdate` and `nextUpdate`. `Response verify OK` validates the response only: also observe `good`, `revoked` or `unknown`. Do not accept an identity based only on the command’s exit code.",{"_2802":2131,"_24443":2091,"_17120":46459,"_5":17015,"_23194":46361,"_2329":46460},[],"**OCSP Check** shows what Lamassu returns for a selected certificate. Complete the check from the consumer’s network and trust store: a console query does not establish its validation configuration.",{"_2802":2132,"_24443":2091,"_17120":46462,"_5":17015,"_23194":46361,"_2329":46463},[],"To check a change, save an earlier response, revoke a test certificate and request another response. The new query should reflect persisted status; compare timestamps to rule out reuse of an earlier response. If it fails, follow PKI troubleshooting.",{"_2802":2133,"_24443":2091,"_17120":46465,"_5":17015,"_23194":46365,"_2329":46466},[],"RFC 6960: OCSP.",{"_2802":2134,"_24443":2091,"_17120":46468,"_5":17015,"_23194":46365,"_2329":46469},[],"OpenSSL: openssl-ocsp.",{"_2802":2135,"_24443":2091,"_17120":46471,"_5":17015,"_23194":46365,"_2329":46472},[],"<Card title=\"CRL service\" href=\"/docs/platform/pki/crl\" />",{"_2802":2136,"_24443":2091,"_17120":46474,"_5":17015,"_23194":46365,"_2329":45949},[],{"_2802":2137,"_24443":2137,"_5":12033,"_2329":44649,"_24758":46476,"_17120":46477,"_23194":2137},[39790,41134,44649],[],{"_2802":2138,"_24443":2137,"_17120":46479,"_5":17015,"_23194":2137,"_2329":46480},[],"Administer keys and authorities, define issuance and verify the resulting certificates.",{"_2802":2139,"_24443":2137,"_5":24755,"_17120":46482,"_23194":46483,"_2329":43959},[],"/docs/platform/pki/overview#start-here",{"_2802":2140,"_24443":2137,"_5":24755,"_17120":46485,"_23194":46486,"_2329":46487},[],"/docs/platform/pki/overview#what-you-need","What you need",{"_2802":2141,"_24443":2137,"_5":24755,"_17120":46489,"_23194":46490,"_2329":44493},[],"/docs/platform/pki/overview#core-capabilities",{"_2802":2142,"_24443":2137,"_5":24755,"_17120":46492,"_23194":46493,"_2329":44497},[],"/docs/platform/pki/overview#build-your-trust-hierarchy",{"_2802":2143,"_24443":2137,"_5":24755,"_17120":46495,"_23194":46496,"_2329":44501},[],"/docs/platform/pki/overview#protect-cryptographic-keys",{"_2802":2144,"_24443":2137,"_5":24755,"_17120":46498,"_23194":46499,"_2329":44505},[],"/docs/platform/pki/overview#issue-and-control-certificates",{"_2802":2145,"_24443":2137,"_5":24755,"_17120":46501,"_23194":46502,"_2329":44513},[],"/docs/platform/pki/overview#publish-validation-status",{"_2802":2146,"_24443":2137,"_5":24755,"_17120":46504,"_23194":46505,"_2329":46506},[],"/docs/platform/pki/overview#how-to-check-the-result","How to check the result",{"_2802":2147,"_24443":2137,"_5":24755,"_17120":46508,"_23194":46509,"_2329":45433},[],"/docs/platform/pki/overview#continue",{"_2802":2148,"_24443":2137,"_17120":46511,"_5":17015,"_23194":2137,"_2329":46512},[],"The PKI section explains how to build and operate X.509 trust in Lamassu: which authorities issue, which rules apply and how to check certificates. It is intended for PKI administrators and anyone who needs to use certificates in a consuming system.",{"_2802":2149,"_24443":2137,"_17120":46514,"_5":17015,"_23194":46483,"_2329":46515},[],"Follow PKI getting started to create a CA, issue a client certificate and verify it with OpenSSL. The result is a certificate, its private key and a verified chain.",{"_2802":2150,"_24443":2137,"_17120":46517,"_5":17015,"_23194":46483,"_2329":46518},[],"You can complete that path before managing devices. When you need to associate the identity with an inventory or automate its enrollment, continue in IoT Fleets.",{"_2802":2151,"_24443":2137,"_17120":46520,"_5":17015,"_23194":46486,"_2329":46521},[],"An accessible instance and permission to manage the keys, CAs and certificates you will use.",{"_2802":2152,"_24443":2137,"_17120":46523,"_5":17015,"_23194":46486,"_2329":46524},[],"An available cryptographic engine to keep the authority's key.",{"_2802":2153,"_24443":2137,"_17120":46526,"_5":17015,"_23194":46486,"_2329":46527},[],"The certificate's purpose, such as authenticating a client through mTLS.",{"_2802":2154,"_24443":2137,"_17120":46529,"_5":17015,"_23194":46486,"_2329":46530},[],"Consumer requirements: accepted issuers, algorithms, names and permitted usages.",{"_2802":2155,"_24443":2137,"_17120":46532,"_5":17015,"_23194":46486,"_2329":46533},[],"Prepare the instance and cryptographic provider in Deployment. The trust model explains hierarchy choices.",{"_2802":2156,"_24443":2137,"_17120":46535,"_5":17015,"_23194":46493,"_2329":46536},[],"Authorities sign certificates. A root establishes the trust anchor, and an intermediate separates issuance by environment or purpose. Hierarchy and rotation explains how to maintain trust when replacing an authority.",{"_2802":2157,"_24443":2137,"_17120":46538,"_5":17015,"_23194":46496,"_2329":46539},[],"CA signing keys are managed through KMS and cryptographic engines. A client that generates a CSR can keep its own key: preserve that custody when choosing the issuance method.",{"_2802":2158,"_24443":2137,"_17120":46541,"_5":17015,"_23194":46499,"_2329":46542},[],"A profile establishes subject, validity, usage and key restrictions. The CA applies issuance configuration and signs the certificate. In the inventory, you can inspect the result, download it and manage its status.",{"_2802":2159,"_24443":2137,"_17120":46544,"_5":17015,"_23194":46502,"_2329":46545},[],"Validation covers the chain, validity, usages and revocation status. Lamassu publishes status through OCSP and CRL; the consumer configures which issuers it recognizes and how it checks that status.",{"_2802":2160,"_24443":2137,"_17120":46547,"_5":17015,"_23194":46505,"_2329":46548},[],"An active certificate in the console is one part of the check. Also verify that:",{"_2802":2161,"_24443":2137,"_17120":46550,"_5":17015,"_23194":46505,"_2329":46551},[],"its subject and extensions identify the expected client;",{"_2802":2162,"_24443":2137,"_17120":46553,"_5":17015,"_23194":46505,"_2329":46554},[],"its public key matches the client's private key;",{"_2802":2163,"_24443":2137,"_17120":46556,"_5":17015,"_23194":46505,"_2329":46557},[],"its chain reaches a root trusted by the consumer;",{"_2802":2164,"_24443":2137,"_17120":46559,"_5":17015,"_23194":46505,"_2329":46560},[],"its dates and usages allow the operation;",{"_2802":2165,"_24443":2137,"_17120":46562,"_5":17015,"_23194":46505,"_2329":46563},[],"the consumer applies revocation checks and authorization.",{"_2802":2166,"_24443":2137,"_17120":46565,"_5":17015,"_23194":46505,"_2329":46566},[],"The issuance path includes the first independent checks.",{"_2802":2167,"_24443":2137,"_17120":46568,"_5":17015,"_23194":46509,"_2329":46569},[],"<Card title=\"PKI getting started\" description=\"Create a CA, then issue and verify a client certificate.\" href=\"/docs/platform/pki/quickstarts/overview\" />",{"_2802":2168,"_24443":2137,"_17120":46571,"_5":17015,"_23194":46509,"_2329":46572},[],"<Card title=\"Apply PKI to devices\" description=\"Associate certificates with inventory and prepare enrollment.\" href=\"/docs/platform/iot-fleets/overview\" />",{"_2802":2169,"_24443":2137,"_17120":46574,"_5":17015,"_23194":46509,"_2329":46575},[],"<Card title=\"PKI diagnostics\" description=\"Check issuance, OCSP and CRL when the result fails.\" href=\"/docs/platform/pki/troubleshooting\" />",{"_2802":2170,"_24443":2170,"_5":12033,"_2329":46577,"_24758":46578,"_17120":46579,"_23194":2170},"Create your first CA",[39790,41134,44649,44084],[],{"_2802":2171,"_24443":2170,"_17120":46581,"_5":17015,"_23194":2170,"_2329":46582},[],"Create an evaluation root and check its certificate before issuing.",{"_2802":2172,"_24443":2170,"_5":24755,"_17120":46584,"_23194":46585,"_2329":39800},[],"/docs/platform/pki/quickstarts/create-certificate-authority#before-you-begin",{"_2802":2173,"_24443":2170,"_5":24755,"_17120":46587,"_23194":46588,"_2329":46589},[],"/docs/platform/pki/quickstarts/create-certificate-authority#open-the-creation-wizard","Open the creation wizard",{"_2802":2174,"_24443":2170,"_5":24755,"_17120":46591,"_23194":46592,"_2329":46593},[],"/docs/platform/pki/quickstarts/create-certificate-authority#select-the-key","Select the key",{"_2802":2175,"_24443":2170,"_5":24755,"_17120":46595,"_23194":46596,"_2329":46597},[],"/docs/platform/pki/quickstarts/create-certificate-authority#define-the-authority","Define the authority",{"_2802":2176,"_24443":2170,"_5":24755,"_17120":46599,"_23194":46600,"_2329":46601},[],"/docs/platform/pki/quickstarts/create-certificate-authority#review-and-create-the-ca","Review and create the CA",{"_2802":2177,"_24443":2170,"_5":24755,"_17120":46603,"_23194":46604,"_2329":46605},[],"/docs/platform/pki/quickstarts/create-certificate-authority#verify-the-result","Verify the result",{"_2802":2178,"_24443":2170,"_5":24755,"_17120":46607,"_23194":46608,"_2329":46609},[],"/docs/platform/pki/quickstarts/create-certificate-authority#check-the-ca-certificate","Check the CA certificate",{"_2802":2179,"_24443":2170,"_5":24755,"_17120":46611,"_23194":46612,"_2329":44342},[],"/docs/platform/pki/quickstarts/create-certificate-authority#if-the-result-fails",{"_2802":2180,"_24443":2170,"_5":24755,"_17120":46614,"_23194":46615,"_2329":39824},[],"/docs/platform/pki/quickstarts/create-certificate-authority#next-step",{"_2802":2181,"_24443":2170,"_17120":46617,"_5":17015,"_23194":2170,"_2329":46618},[],"You will create a root authority with a new key kept by a Lamassu engine. The result is an active CA and its public certificate in `ca.pem`, ready to verify issuance in the next path.",{"_2802":2182,"_24443":2170,"_17120":46620,"_5":17015,"_23194":46585,"_2329":46621},[],"Console access and permission to create keys and authorities.",{"_2802":2183,"_24443":2170,"_17120":46623,"_5":17015,"_23194":46585,"_2329":46624},[],"An available cryptographic engine that supports the chosen algorithm.",{"_2802":2184,"_24443":2170,"_17120":46626,"_5":17015,"_23194":46585,"_2329":46627},[],"OpenSSL 3.x to check the downloaded certificate.",{"_2802":2185,"_24443":2170,"_17120":46629,"_5":17015,"_23194":46585,"_2329":46630},[],"Use an evaluation instance or an authority intended for these tests. The example creates a root that issues directly; to design an operational hierarchy, see Hierarchy and rotation.",{"_2802":2186,"_24443":2170,"_17120":46632,"_5":17015,"_23194":46588,"_2329":46633},[],"In **Certification Authorities**, select **Create New CA** and choose to create a CA with a new key pair.",{"_2802":2187,"_24443":2170,"_17120":46635,"_5":17015,"_23194":46588,"_2329":46636},[],"The &#x2A;*Create New CA (Existing Key)** flow is explained in the authorities guide.",{"_2802":2188,"_24443":2170,"_17120":46638,"_5":17015,"_23194":46592,"_2329":46639},[],"Choose the engine that will keep the key and an algorithm its capabilities allow. For this example, you can use **EC P-384** if available.",{"_2802":2189,"_24443":2170,"_17120":46641,"_5":17015,"_23194":46592,"_2329":46642},[],"The CA private key is used through the engine. In this path, you will download only the authority's public certificate.",{"_2802":2190,"_24443":2170,"_17120":46644,"_5":17015,"_23194":46596,"_2329":46645},[],"Select **Root CA** and complete:",{"_2802":2191,"_24443":2170,"_17120":46647,"_5":17015,"_23194":46596,"_2329":46648},[],"**CA Name**: `Acme Evaluation Root CA`.",{"_2802":2192,"_24443":2170,"_17120":46650,"_5":17015,"_23194":46596,"_2329":46651},[],"**Subject**: organization and country details for your evaluation.",{"_2802":2193,"_24443":2170,"_17120":46653,"_5":17015,"_23194":46596,"_2329":46654},[],"**CA Certificate Expiration**: for example, one year from creation.",{"_2802":2194,"_24443":2170,"_17120":46656,"_5":17015,"_23194":46596,"_2329":46657},[],"**Default End-Entity Certificate Issuance Expiration**: for example, 90 days, within the CA's lifetime.",{"_2802":2195,"_24443":2170,"_17120":46659,"_5":17015,"_23194":46596,"_2329":46660},[],"The CA name becomes its `Common Name`. Keep the CA usages needed to sign certificates and CRLs.",{"_2802":2196,"_24443":2170,"_17120":46662,"_5":17015,"_23194":46600,"_2329":46663},[],"Check the engine, algorithm, subject, root type and dates. Confirm creation and note the authority identifier so you can recognize it in the DMS or API.",{"_2802":2197,"_24443":2170,"_17120":46665,"_5":17015,"_23194":46604,"_2329":46666},[],"Open the new CA. It should appear active, show its certificate and allow access to **Issued Certificates**.",{"_2802":2198,"_24443":2170,"_17120":46668,"_5":17015,"_23194":46604,"_2329":46669},[],"Download or copy the authority's PEM certificate and save it as `ca.pem`. Check that the file contains the complete block, including `BEGIN CERTIFICATE` and `END CERTIFICATE`.",{"_2802":2199,"_24443":2170,"_17120":46671,"_5":17015,"_23194":46608,"_2329":46672},[],"Run from the directory where you saved `ca.pem`:",{"_2802":2200,"_24443":2170,"_17120":46674,"_5":17015,"_23194":46608,"_2329":46675},[],"Check that the subject and issuer match the root you created, the dates include the current time, **Basic Constraints** contains `CA:TRUE` and **Key Usage** allows certificate signing. The last command should return `ca.pem: OK`.",{"_2802":2201,"_24443":2170,"_17120":46677,"_5":17015,"_23194":46608,"_2329":46678},[],"You explicitly selected `ca.pem` as the trust anchor for this test. A valid self-signature does not install that trust in other consumers. See the openssl-verify reference for verification options.",{"_2802":2202,"_24443":2170,"_17120":46680,"_5":17015,"_23194":46612,"_2329":46681},[],"If creation fails, check permissions, engine availability and the selected algorithm.",{"_2802":2203,"_24443":2170,"_17120":46683,"_5":17015,"_23194":46612,"_2329":46684},[],"If OpenSSL cannot read the file, copy the complete PEM block again.",{"_2802":2204,"_24443":2170,"_17120":46686,"_5":17015,"_23194":46612,"_2329":46687},[],"If signature or date checks fail, check that you downloaded this CA's certificate and that your computer's clock is correct.",{"_2802":2205,"_24443":2170,"_17120":46689,"_5":17015,"_23194":46612,"_2329":46690},[],"PKI diagnostics covers issuance checks and cryptographic dependencies.",{"_2802":2206,"_24443":2170,"_17120":46692,"_5":17015,"_23194":46615,"_2329":46693},[],"Continue with Issue and verify a certificate, using this authority and `ca.pem`.",{"_2802":2207,"_24443":2207,"_5":12033,"_2329":46695,"_24758":46696,"_17120":46697,"_23194":2207},"Issue and verify a certificate",[39790,41134,44649,44084],[],{"_2802":2208,"_24443":2207,"_17120":46699,"_5":17015,"_23194":2207,"_2329":46700},[],"Issue a client certificate and check content, chain and key correspondence.",{"_2802":2209,"_24443":2207,"_5":24755,"_17120":46702,"_23194":46703,"_2329":39800},[],"/docs/platform/pki/quickstarts/issue-certificate#before-you-begin",{"_2802":2210,"_24443":2207,"_5":24755,"_17120":46705,"_23194":46706,"_2329":46707},[],"/docs/platform/pki/quickstarts/issue-certificate#start-the-issuance","Start the issuance",{"_2802":2211,"_24443":2207,"_5":24755,"_17120":46709,"_23194":46710,"_2329":46711},[],"/docs/platform/pki/quickstarts/issue-certificate#choose-the-method","Choose the method",{"_2802":2212,"_24443":2207,"_5":24755,"_17120":46713,"_23194":46714,"_2329":46715},[],"/docs/platform/pki/quickstarts/issue-certificate#identify-the-certificate","Identify the certificate",{"_2802":2213,"_24443":2207,"_5":24755,"_17120":46717,"_23194":46718,"_2329":46719},[],"/docs/platform/pki/quickstarts/issue-certificate#configure-key-and-uses","Configure key and uses",{"_2802":2214,"_24443":2207,"_5":24755,"_17120":46721,"_23194":46722,"_2329":46723},[],"/docs/platform/pki/quickstarts/issue-certificate#issue-and-download","Issue and download",{"_2802":2215,"_24443":2207,"_5":24755,"_17120":46725,"_23194":46726,"_2329":46605},[],"/docs/platform/pki/quickstarts/issue-certificate#verify-the-result",{"_2802":2216,"_24443":2207,"_5":24755,"_17120":46728,"_23194":46729,"_2329":46730},[],"/docs/platform/pki/quickstarts/issue-certificate#inspect-content-and-dates","Inspect content and dates",{"_2802":2217,"_24443":2207,"_5":24755,"_17120":46732,"_23194":46733,"_2329":46734},[],"/docs/platform/pki/quickstarts/issue-certificate#verify-the-chain","Verify the chain",{"_2802":2218,"_24443":2207,"_5":24755,"_17120":46736,"_23194":46737,"_2329":46738},[],"/docs/platform/pki/quickstarts/issue-certificate#check-that-the-key-matches","Check that the key matches",{"_2802":2219,"_24443":2207,"_5":24755,"_17120":46740,"_23194":46741,"_2329":44342},[],"/docs/platform/pki/quickstarts/issue-certificate#if-the-result-fails",{"_2802":2220,"_24443":2207,"_5":24755,"_17120":46743,"_23194":46744,"_2329":39824},[],"/docs/platform/pki/quickstarts/issue-certificate#next-step",{"_2802":2221,"_24443":2207,"_17120":46746,"_5":17015,"_23194":2207,"_2329":46747},[],"You will issue an end-entity certificate for `device-001` using browser key and CSR generation. The result is `device.crt`, `device.key` and the issuing root's public certificate, `ca.pem`.",{"_2802":2222,"_24443":2207,"_17120":46749,"_5":17015,"_23194":46703,"_2329":46750},[],"An active root CA with an available signing key and permission to issue. If one does not exist yet, follow Create your first CA.",{"_2802":2223,"_24443":2207,"_17120":46752,"_5":17015,"_23194":46703,"_2329":46753},[],"Its public certificate in `ca.pem`; this example uses the root created in the previous path.",{"_2802":2224,"_24443":2207,"_17120":46755,"_5":17015,"_23194":46703,"_2329":46756},[],"OpenSSL 3.x and a working directory with restricted access.",{"_2802":2225,"_24443":2207,"_17120":46758,"_5":17015,"_23194":46703,"_2329":46759},[],"A client identifier: here we use `device-001`.",{"_2802":2226,"_24443":2207,"_17120":46761,"_5":17015,"_23194":46703,"_2329":46762},[],"In this flow, the client's key is generated in the browser and must be downloaded when issuance finishes. If you lose it, you must generate a key and issue another certificate. The certificate inventory lets you download the public certificate, but cannot recover this key.",{"_2802":2227,"_24443":2207,"_17120":46764,"_5":17015,"_23194":46706,"_2329":46765},[],"Open the CA from the previous path, go to **Issued Certificates** and select **Issue New**.",{"_2802":2228,"_24443":2207,"_17120":46767,"_5":17015,"_23194":46710,"_2329":46768},[],"Select **Generate Key & CSR in Browser** to follow this example.",{"_2802":2229,"_24443":2207,"_17120":46770,"_5":17015,"_23194":46710,"_2329":46771},[],"If the key must be generated and kept on the destination system, use **Upload Existing CSR**, described in the authorities guide.",{"_2802":2230,"_24443":2207,"_17120":46773,"_5":17015,"_23194":46714,"_2329":46774},[],"Enter `device-001` as the `Common Name`. Add subject details required by your policy and SANs if the consumer uses them to identify the client.",{"_2802":2231,"_24443":2207,"_17120":46776,"_5":17015,"_23194":46714,"_2329":46777},[],"If you continue with manual registration, the `Device ID` will be exactly `device-001`.",{"_2802":2232,"_24443":2207,"_17120":46779,"_5":17015,"_23194":46718,"_2329":46780},[],"Choose an algorithm and size allowed by the profile; for example, ECDSA P-256 if permitted. For this client certificate, select **Digital Signature** and **Client Authentication**, and issue it as an end-entity certificate.",{"_2802":2233,"_24443":2207,"_17120":46782,"_5":17015,"_23194":46718,"_2329":46783},[],"Request, for example, 30 days of validity, always within the CA's lifetime. Review the issuance profile if the resulting content differs from the request.",{"_2802":2234,"_24443":2207,"_17120":46785,"_5":17015,"_23194":46722,"_2329":46786},[],"Confirm issuance. Save the PEM certificate as `device.crt` and the private key as `device.key` in your prepared directory.",{"_2802":2235,"_24443":2207,"_17120":46788,"_5":17015,"_23194":46726,"_2329":46789},[],"Check in **Issued Certificates** that the certificate appears active. Note its serial number and verify the downloaded material using the checks below.",{"_2802":2236,"_24443":2207,"_17120":46791,"_5":17015,"_23194":46729,"_2329":46792},[],"Check `CN=device-001`, the expected issuer, current validity, **Digital Signature** and the extended usage **TLS Web Client Authentication**. It must be an end-entity certificate: it must not declare `CA:TRUE` or enable **Certificate Sign**. If **Basic Constraints** is present, it must indicate `CA:FALSE`. If you requested SANs, check that the expected identifiers appear in the certificate.",{"_2802":2237,"_24443":2207,"_17120":46794,"_5":17015,"_23194":46733,"_2329":46795},[],"The expected result is `device.crt: OK`. This check uses your explicit root and evaluates the chain, dates and compatibility with the TLS client purpose. Also check for the expected usages and names through the inspection above.",{"_2802":2238,"_24443":2207,"_17120":46797,"_5":17015,"_23194":46733,"_2329":46798},[],"If you use an intermediate CA, the trusted root must be in `ca.pem` and you must supply the intermediates with `-untrusted intermediates.pem`. This variant is covered in the trust model.",{"_2802":2239,"_24443":2207,"_17120":46800,"_5":17015,"_23194":46733,"_2329":46801},[],"The command does not query OCSP or CRL. For revocation checks, continue with Certificate validation. See the openssl-verify reference for its options.",{"_2802":2240,"_24443":2207,"_17120":46803,"_5":17015,"_23194":46737,"_2329":46804},[],"In Bash, compare the two public-key digests:",{"_2802":2241,"_24443":2207,"_17120":46806,"_5":17015,"_23194":46737,"_2329":46807},[],"Both commands must finish successfully and show the same SHA-256 digest. If they differ, the private key does not match the selected certificate. Find the correct pair before installing it.",{"_2802":2242,"_24443":2207,"_17120":46809,"_5":17015,"_23194":46737,"_2329":46810},[],"The options used are documented in openssl-x509 and openssl-pkey.",{"_2802":2243,"_24443":2207,"_17120":46812,"_5":17015,"_23194":46741,"_2329":44426},[],{"_2802":2244,"_24443":2207,"_17120":46814,"_5":17015,"_23194":46741,"_2329":46815},[],"What to review",{"_2802":2245,"_24443":2207,"_17120":46817,"_5":17015,"_23194":46741,"_2329":46818},[],"The CA rejects issuance",{"_2802":2246,"_24443":2207,"_17120":46820,"_5":17015,"_23194":46741,"_2329":46821},[],"Permissions, CA state and key, algorithm and profile.",{"_2802":2247,"_24443":2207,"_17120":46823,"_5":17015,"_23194":46741,"_2329":46824},[],"Different subject or usages",{"_2802":2248,"_24443":2207,"_17120":46826,"_5":17015,"_23194":46741,"_2329":46827},[],"Applied profile and requested values.",{"_2802":2249,"_24443":2207,"_17120":46829,"_5":17015,"_23194":46741,"_2329":46830},[],"Issuer cannot be found",{"_2802":2250,"_24443":2207,"_17120":46832,"_5":17015,"_23194":46741,"_2329":46833},[],"Downloaded CA and required intermediate chain.",{"_2802":2251,"_24443":2207,"_17120":46835,"_5":17015,"_23194":46741,"_2329":46836},[],"Validity fails",{"_2802":2252,"_24443":2207,"_17120":46838,"_5":17015,"_23194":46741,"_2329":46839},[],"Certificate and CA dates, and the computer's clock.",{"_2802":2253,"_24443":2207,"_17120":46841,"_5":17015,"_23194":46741,"_2329":46842},[],"Public-key digests differ",{"_2802":2254,"_24443":2207,"_17120":46844,"_5":17015,"_23194":46741,"_2329":46845},[],"Certificate and key files from the same issuance.",{"_2802":2255,"_24443":2207,"_17120":46847,"_5":17015,"_23194":46741,"_2329":46848},[],"See PKI diagnostics to narrow an issuance failure.",{"_2802":2256,"_24443":2207,"_17120":46850,"_5":17015,"_23194":46744,"_2329":46851},[],"You have completed the PKI path when the certificate verifies and the key matches. Choose how to use it:",{"_2802":2257,"_24443":2207,"_17120":46853,"_5":17015,"_23194":46744,"_2329":46854},[],"Manage certificates for inspection, status and revocation.",{"_2802":2258,"_24443":2207,"_17120":46856,"_5":17015,"_23194":46744,"_2329":46857},[],"Register a device manually to associate this identity with Lamassu's inventory.",{"_2802":2259,"_24443":2207,"_17120":46859,"_5":17015,"_23194":46744,"_2329":46860},[],"Prepare EST for the device to request its next identities.",{"_2802":2260,"_24443":2207,"_17120":46862,"_5":17015,"_23194":46744,"_2329":46863},[],"Acceptance by a consumer requires configuring its trust, revocation checks and permissions granted to the identity.",{"_2802":2261,"_24443":2261,"_5":12033,"_2329":46865,"_24758":46866,"_17120":46867,"_23194":2261},"PKI getting started",[39790,41134,44649,44084],[],{"_2802":2262,"_24443":2261,"_17120":46869,"_5":17015,"_23194":2261,"_2329":46870},[],"Create a CA, issue a client certificate and check its chain and key.",{"_2802":2263,"_24443":2261,"_5":24755,"_17120":46872,"_23194":46873,"_2329":39800},[],"/docs/platform/pki/quickstarts/overview#before-you-begin",{"_2802":2264,"_24443":2261,"_5":24755,"_17120":46875,"_23194":46876,"_2329":46877},[],"/docs/platform/pki/quickstarts/overview#recommended-path","Recommended path",{"_2802":2265,"_24443":2261,"_5":24755,"_17120":46879,"_23194":46880,"_2329":44276},[],"/docs/platform/pki/quickstarts/overview#expected-result",{"_2802":2266,"_24443":2261,"_5":24755,"_17120":46882,"_23194":46883,"_2329":46884},[],"/docs/platform/pki/quickstarts/overview#continue-according-to-your-goal","Continue according to your goal",{"_2802":2267,"_24443":2261,"_17120":46886,"_5":17015,"_23194":2261,"_2329":46887},[],"This path is intended for those starting to administer PKI or needing a first X.509 client identity. It ends with three files: a root CA certificate, an end-entity certificate and the client's private key.",{"_2802":2268,"_24443":2261,"_17120":46889,"_5":17015,"_23194":46873,"_2329":46890},[],"A Lamassu instance accessible from your browser. To prepare one, see Deployment.",{"_2802":2269,"_24443":2261,"_17120":46892,"_5":17015,"_23194":46873,"_2329":46893},[],"Permission to manage keys, authorities and issuance. See Access control if an operation is blocked.",{"_2802":2270,"_24443":2261,"_17120":46895,"_5":17015,"_23194":46873,"_2329":46896},[],"An available cryptographic engine for the CA key; check the keys and engines inventory.",{"_2802":2271,"_24443":2261,"_17120":46898,"_5":17015,"_23194":46873,"_2329":46899},[],"OpenSSL 3.x on the computer where you will verify the files.",{"_2802":2272,"_24443":2261,"_17120":46901,"_5":17015,"_23194":46873,"_2329":46902},[],"A working directory with restricted access for the downloaded key.",{"_2802":2273,"_24443":2261,"_17120":46904,"_5":17015,"_23194":46876,"_2329":46905},[],"<Card title=\"1. Create your first CA\" description=\"Create an evaluation root and save its public certificate as ca.pem.\" href=\"/docs/platform/pki/quickstarts/create-certificate-authority\" />",{"_2802":2274,"_24443":2261,"_17120":46907,"_5":17015,"_23194":46876,"_2329":46908},[],"<Card title=\"2. Issue and verify a certificate\" description=\"Issue for device-001 and check content, chain and key correspondence.\" href=\"/docs/platform/pki/quickstarts/issue-certificate\" />",{"_2802":2275,"_24443":2261,"_17120":46910,"_5":17015,"_23194":46876,"_2329":46911},[],"We use `Acme Evaluation Root CA` and `device-001` as example names. If you replace them, keep the same client identifier in the steps you want to connect.",{"_2802":2276,"_24443":2261,"_17120":46913,"_5":17015,"_23194":46876,"_2329":46914},[],"The root in this path signs the end-entity certificate directly to simplify evaluation. Before designing an operational PKI, review the trust model and CA hierarchy.",{"_2802":2277,"_24443":2261,"_17120":46916,"_5":17015,"_23194":46880,"_2329":46917},[],"File or resource",{"_2802":2278,"_24443":2261,"_17120":46919,"_5":17015,"_23194":46880,"_2329":44273},[],{"_2802":2279,"_24443":2261,"_17120":46921,"_5":17015,"_23194":46880,"_2329":46922},[],"Active root CA and `ca.pem`",{"_2802":2280,"_24443":2261,"_17120":46924,"_5":17015,"_23194":46880,"_2329":46925},[],"It is a CA certificate, is currently valid and its self-signature verifies.",{"_2802":2281,"_24443":2261,"_17120":46927,"_5":17015,"_23194":46880,"_2329":46928},[],"End-entity certificate and `device.crt`",{"_2802":2282,"_24443":2261,"_17120":46930,"_5":17015,"_23194":46880,"_2329":46931},[],"It identifies `device-001`, supports client authentication and verifies against `ca.pem`.",{"_2802":2283,"_24443":2261,"_17120":46933,"_5":17015,"_23194":46880,"_2329":46934},[],"Private key `device.key`",{"_2802":2284,"_24443":2261,"_17120":46936,"_5":17015,"_23194":46880,"_2329":46937},[],"Its public key matches the one included in `device.crt`.",{"_2802":2285,"_24443":2261,"_17120":46939,"_5":17015,"_23194":46880,"_2329":46940},[],"These checks validate the issued material. Acceptance by a service also requires its trust, authorization and revocation configuration.",{"_2802":2286,"_24443":2261,"_17120":46942,"_5":17015,"_23194":46883,"_2329":46943},[],"To operate certificates, continue with Certificates and Validation.",{"_2802":2287,"_24443":2261,"_17120":46945,"_5":17015,"_23194":46883,"_2329":46946},[],"To manage a device identity in Lamassu, follow Manual registration. That path includes DMS preparation.",{"_2802":2288,"_24443":2261,"_17120":46948,"_5":17015,"_23194":46883,"_2329":46949},[],"For the device to request its certificate, prepare the DMS and EST client.",{"_2802":2289,"_24443":2289,"_5":12033,"_2329":46951,"_24758":46952,"_17120":46953,"_23194":2289},"PKI troubleshooting",[39790,41134,44649,43470],[],{"_2802":2290,"_24443":2289,"_17120":46955,"_5":17015,"_23194":2289,"_2329":46956},[],"Diagnose certificate issuance, OCSP and CRL.",{"_2802":2291,"_24443":2289,"_5":24755,"_17120":46958,"_23194":46959,"_2329":46960},[],"/docs/platform/pki/troubleshooting#issuance-fails","Issuance fails",{"_2802":2292,"_24443":2289,"_5":24755,"_17120":46962,"_23194":46963,"_2329":46964},[],"/docs/platform/pki/troubleshooting#ocsp-or-crl-do-not-reflect-a-change","OCSP or CRL do not reflect a change",{"_2802":2293,"_24443":2289,"_5":24755,"_17120":46966,"_23194":46967,"_2329":46968},[],"/docs/platform/pki/troubleshooting#the-chain-validates-but-the-connection-fails","The chain validates but the connection fails",{"_2802":2294,"_24443":2289,"_17120":46970,"_5":17015,"_23194":2289,"_2329":46971},[],"This guide helps a PKI operator locate issuance and status publication failures. Keep the Lamassu version, operation, CA, issuer, serial, time and returned error. Do not include private keys or tokens in diagnostics.",{"_2802":2295,"_24443":2289,"_17120":46973,"_5":17015,"_23194":2289,"_2329":46974},[],"For Gateway, sign-in, pods, dependencies and messaging, see Deployment troubleshooting. For device enrollment, see EST diagnostics.",{"_2802":2296,"_24443":2289,"_17120":46976,"_5":17015,"_23194":46959,"_2329":44273},[],{"_2802":2297,"_24443":2289,"_17120":46978,"_5":17015,"_23194":46959,"_2329":46979},[],"What to inspect",{"_2802":2298,"_24443":2289,"_17120":46981,"_5":17015,"_23194":46959,"_2329":39824},[],{"_2802":2299,"_24443":2289,"_17120":46983,"_5":17015,"_23194":46959,"_2329":46984},[],"CA",{"_2802":2300,"_24443":2289,"_17120":46986,"_5":17015,"_23194":46959,"_2329":46987},[],"Exists, is active and has usable dates.",{"_2802":2301,"_24443":2289,"_17120":46989,"_5":17015,"_23194":46959,"_2329":46990},[],"Authorities.",{"_2802":2302,"_24443":2289,"_17120":46992,"_5":17015,"_23194":46959,"_2329":46993},[],"Key",{"_2802":2303,"_24443":2289,"_17120":46995,"_5":17015,"_23194":46959,"_2329":46996},[],"The record has a usable private key and the engine can sign.",{"_2802":2304,"_24443":2289,"_17120":46998,"_5":17015,"_23194":46959,"_2329":46999},[],"Try **Sign / Verify** in KMS; check provider permissions and availability.",{"_2802":2305,"_24443":2289,"_17120":47001,"_5":17015,"_23194":46959,"_2329":47002},[],"CSR",{"_2802":2306,"_24443":2289,"_17120":47004,"_5":17015,"_23194":46959,"_2329":47005},[],"Correct PEM and verifiable signature.",{"_2802":2307,"_24443":2289,"_17120":47007,"_5":17015,"_23194":46959,"_2329":47008},[],"`openssl req -in request.csr -noout -verify -text`.",{"_2802":2308,"_24443":2289,"_17120":47010,"_5":17015,"_23194":46959,"_2329":47011},[],"Profile",{"_2802":2309,"_24443":2289,"_17120":47013,"_5":17015,"_23194":46959,"_2329":47014},[],"Selected source, existing ID, allowed algorithm and size.",{"_2802":2310,"_24443":2289,"_17120":47016,"_5":17015,"_23194":46959,"_2329":47017},[],"Check Profiles precedence; CA and DMS resolve differently.",{"_2802":2311,"_24443":2289,"_17120":47019,"_5":17015,"_23194":46959,"_2329":44426},[],{"_2802":2312,"_24443":2289,"_17120":47021,"_5":17015,"_23194":46959,"_2329":47022},[],"Appropriate subject, SAN, usages and dates.",{"_2802":2313,"_24443":2289,"_17120":47024,"_5":17015,"_23194":46959,"_2329":47025},[],"Compare CSR, profile and certificate; successful issuance does not establish consumer acceptance.",{"_2802":2314,"_24443":2289,"_17120":47027,"_5":17015,"_23194":46959,"_2329":47028},[],"For unexpected certificate fields, review `Honor Subject`, `Honor Key Usage`, `Honor Extended Key Usages` and `Honor Extensions`. The latter preserves SAN only, without validating entitlement to those names. Validity is not automatically clamped to CA expiration.",{"_2802":2315,"_24443":2289,"_17120":47030,"_5":17015,"_23194":46959,"_2329":47031},[],"For CA reissuance failures, check revocation and date: reissuance is not supported for a revoked or already expired CA. To change its key, use Hierarchy and rotation.",{"_2802":2316,"_24443":2289,"_17120":47033,"_5":17015,"_23194":46963,"_2329":47034},[],"Check each boundary independently:",{"_2802":2317,"_24443":2289,"_17120":47036,"_5":17015,"_23194":46963,"_2329":47037},[],"**Record:** read the correct certificate again by serial and issuer. Confirm status, reason and time; expired or permanently revoked records reject further transitions.",{"_2802":2318,"_24443":2289,"_17120":47039,"_5":17015,"_23194":46963,"_2329":47040},[],"**Endpoint:** inspect AIA and CDP. Query those URLs from the consumer’s network; an old route or incorrect issuer can explain a discrepancy.",{"_2802":2319,"_24443":2289,"_17120":47042,"_5":17015,"_23194":46963,"_2329":47043},[],"**OCSP:** save a fresh response, verify signature and timestamps, and observe status. An HTTP error for an absent serial does not mean `Good` or guarantee a signed `Unknown`.",{"_2802":2320,"_24443":2289,"_17120":47045,"_5":17015,"_23194":46963,"_2329":47046},[],"**CRL:** compare `latest_crl`, number and timestamps with the downloaded list. Check the serial in its contents. If unchanged, review `regenerate_on_revoke`, event delivery, jobs, signing and storage with the deployment operator.",{"_2802":2321,"_24443":2289,"_17120":47048,"_5":17015,"_23194":46963,"_2329":47049},[],"**Client:** check cache, policy for expired or unavailable evidence, critical IDP extension and rejection of a new connection.",{"_2802":2322,"_24443":2289,"_17120":47051,"_5":17015,"_23194":46963,"_2329":47052},[],"Reactivation from `CertificateHold` needs a new CRL for the client to stop seeing the hold. Reactivating a CA does not restore its descendant cascade; inspect every status and individual operation failure.",{"_2802":2323,"_24443":2289,"_17120":47054,"_5":17015,"_23194":46967,"_2329":47055},[],"Check expected identity, SAN, KU/EKU, matching key, presented intermediates and consumer permissions. Distinguish server TLS trust, client authentication and action authorization. Follow Validation for positive and rejection tests.",{"_2802":2324,"_24443":2289,"_17120":47057,"_5":17015,"_23194":46967,"_2329":47058},[],"When escalating a problem, provide identifiers, error and relevant public evidence, including query timestamps and ve