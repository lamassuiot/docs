{
  "title": "Create a root CA",
  "url": "http://localhost:32775/",
  "viewport": {
    "width": 1600,
    "height": 900
  },
  "steps": [
    {
      "action": "click",
      "target": {
        "role": "link",
        "name": "Certification Authorities",
        "exact": true
      },
      "tooltip": "Open the certification authorities inventory."
    },
    {
      "action": "wait",
      "for": {
        "role": "button",
        "name": "Create New CA"
      }
    },
    {
      "action": "click",
      "target": {
        "role": "button",
        "name": "Create New CA",
        "exact": true
      },
      "tooltip": "Start creating an authority."
    },
    {
      "action": "click",
      "target": {
        "role": "button",
        "name": "New Key Pair"
      },
      "tooltip": "Generate a new key managed by Lamassu."
    },
    {
      "action": "wait",
      "ms": 2000
    },
    {
      "action": "click",
      "target": {
        "role": "combobox",
        "name": "Key Type"
      },
      "tooltip": "Open the key algorithm list and choose ECDSA."
    },
    {
      "action": "click",
      "target": {
        "role": "option",
        "name": "ECDSA"
      }
    },
    {
      "action": "click",
      "target": {
        "role": "combobox",
        "name": "ECDSA Curve"
      },
      "tooltip": "Open the curve list and choose P-384."
    },
    {
      "action": "click",
      "target": {
        "role": "option",
        "name": "P-384"
      }
    },
    {
      "action": "click",
      "target": {
        "label": "CA Name (Common Name)"
      },
      "tooltip": "The CA name becomes the certificate subject’s Common Name (CN)."
    },
    {
      "action": "fill",
      "target": {
        "label": "CA Name (Common Name)"
      },
      "value": "Acme Showcase Root CA"
    },
    {
      "action": "click",
      "target": {
        "label": "Country (C)"
      },
      "tooltip": "Country (C): optional two-letter country code of the subject."
    },
    {
      "action": "fill",
      "target": {
        "label": "Country (C)"
      },
      "value": "ES"
    },
    {
      "action": "click",
      "target": {
        "label": "Organization (O)"
      },
      "tooltip": "Organization (O): optional organization name of the subject."
    },
    {
      "action": "fill",
      "target": {
        "label": "Organization (O)"
      },
      "value": "Acme"
    },
    {
      "action": "click",
      "target": {
        "placeholder": "e.g., 10y, 365d, 2w"
      },
      "tooltip": "Set how long the CA certificate stays valid, for example 1y."
    },
    {
      "action": "press",
      "key": "Control+A"
    },
    {
      "action": "press",
      "key": "1"
    },
    {
      "action": "press",
      "key": "y"
    },
    {
      "action": "click",
      "target": {
        "role": "combobox",
        "name": "Issuance Profile"
      },
      "tooltip": "Open the issuance profiles and choose Client Certificates as the default for issued certificates."
    },
    {
      "action": "click",
      "target": {
        "role": "option",
        "name": "Client Certificates"
      }
    },
    {
      "action": "click",
      "target": {
        "role": "button",
        "name": "Create Certification Authority"
      },
      "tooltip": "Create the root authority."
    },
    {
      "action": "wait",
      "ms": 2500
    },
    {
      "action": "click",
      "target": {
        "role": "link",
        "name": "Acme Showcase Root CA",
        "exact": true
      },
      "tooltip": "Open the new active authority."
    },
    {
      "action": "wait",
      "ms": 1500
    },
    {
      "action": "click",
      "target": {
        "role": "tab",
        "name": "Certificate PEM"
      },
      "tooltip": "Access the public CA certificate."
    },
    {
      "action": "wait",
      "ms": 1000
    }
  ]
}