FROM golang:1.27.3-alpine AS builder
RUN apk add --no-cache git
ARG SSHEASY_REV=7aebf5d24afed7b25ddf880887f14dd6fc6a76d5
RUN git clone https://github.com/hullarb/ssheasy.git /src \
    && git -C /src checkout --detach "$SSHEASY_REV"
WORKDIR /src/proxy
RUN go build -o /proxy .

FROM alpine:3.24
COPY --from=builder /proxy /proxy
CMD ["/proxy"]
