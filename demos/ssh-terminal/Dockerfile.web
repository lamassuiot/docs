FROM golang:1.27.3-alpine AS builder
RUN apk add --no-cache git python3
ARG SSHEASY_REV=7aebf5d24afed7b25ddf880887f14dd6fc6a76d5
RUN git clone https://github.com/hullarb/ssheasy.git /src \
    && git -C /src checkout --detach "$SSHEASY_REV"
COPY prepare.py /tmp/prepare.py
RUN python3 /tmp/prepare.py /src/web/html/index.html
WORKDIR /src/web
RUN GOOS=js GOARCH=wasm go build -o main.wasm

FROM nginx:1.31.8
COPY --from=builder /usr/local/go/lib/wasm/wasm_exec.js /usr/share/nginx/html/
COPY --from=builder /src/nginx/nginx.conf /etc/nginx/nginx.conf
COPY --from=builder /src/web/html /usr/share/nginx/html
COPY --from=builder /src/web/main.wasm /usr/share/nginx/html/
