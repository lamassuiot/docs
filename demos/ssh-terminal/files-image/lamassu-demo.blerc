# Colores de ble.sh para la terminal de las demos (truecolor).
bleopt term_true_colors=semicolon
bleopt complete_auto_menu=
bleopt highlight_timeout_sync=500
# Sin marca "[ble: exit N]" tras un comando que falla.
bleopt exec_errexit_mark=

# Sugerencia en gris mientras se escribe; Tab / flecha derecha la aceptan.
ble-face -s auto_complete    fg=#5d7480

ble-face -s command_builtin   fg=#cfe6ec,bold
ble-face -s command_function  fg=#cfe6ec,bold
ble-face -s command_file      fg=#cfe6ec,bold
ble-face -s command_alias     fg=#cfe6ec,bold
ble-face -s command_keyword   fg=#b79ae0,bold
ble-face -s command_directory fg=#6fb1d6,bold
ble-face -s syntax_error      fg=#e58a8a,bold
ble-face -s argument_option   fg=#74c3d4,bold
ble-face -s argument_error    fg=#e58a8a,bold
ble-face -s filename_directory fg=#6fb1d6,bold
ble-face -s filename_other    fg=#cfe6ec,bold
ble-face -s varname_unset     fg=#e58a8a,bold
ble-face -s syntax_default    fg=#cfe6ec,bold
ble-face -s syntax_quoted     fg=#e6cf97,bold
ble-face -s syntax_quotation  fg=#e6cf97,bold
ble-face -s syntax_param_expansion fg=#b79ae0,bold
ble-face -s syntax_comment    fg=#5d7480
ble-face -s syntax_varname    fg=#b79ae0,bold
ble-face -s syntax_expr       fg=#6fb1d6,bold
ble-face -s syntax_function_name fg=#b79ae0,bold
ble-face -s syntax_brace      fg=#b79ae0,bold
ble-face -s syntax_glob       fg=#b79ae0,bold
ble-face -s syntax_history_expansion fg=#b79ae0,bold
ble-face -s syntax_tilde      fg=#6fb1d6,bold
ble-face -s syntax_delimiter  fg=#b79ae0,bold
