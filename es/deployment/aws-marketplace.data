",{"_47":117},"platform/pki/concepts/glossary.mdx",{"_21":119,"_28":51,"_43":-7,"_23":120},"es:_2","Operar Lamassu",{"_21":122,"_28":40,"_23":123,"_34":124,"_43":-7,"_11":125,"_45":126},"es:platform/pki/key-management.mdx","Overview","Genera, importa y opera claves sin acoplar la PKI a un proveedor concreto.","/docs/es/platform/pki/key-management",{"_47":127},"platform/pki/key-management.mdx",{"_21":129,"_28":40,"_23":130,"_34":131,"_43":-7,"_11":132,"_45":133},"es:platform/pki/certificate-authorities.mdx","Authorities","Crea, importa y opera las autoridades que establecen la confianza de tu PKI.","/docs/es/platform/pki/certificate-authorities",{"_47":134},"platform/pki/certificate-authorities.mdx",{"_21":136,"_28":40,"_23":137,"_34":138,"_43":-7,"_11":139,"_45":140},"es:platform/pki/certificate-profiles.mdx","Certificate profiles","Define políticas reutilizables para emitir certificados coherentes y limitar las claves aceptadas.","/docs/es/platform/pki/certificate-profiles",{"_47":141},"platform/pki/certificate-profiles.mdx",{"_21":143,"_28":40,"_23":144,"_34":145,"_43":-7,"_11":146,"_45":147},"es:platform/pki/ca-hierarchy-and-rotation.mdx","Hierarchy and rotation","Diseña autoridades raíz e intermedias y sustituye certificados o claves sin romper la confianza.","/docs/es/platform/pki/ca-hierarchy-and-rotation",{"_47":148},"platform/pki/ca-hierarchy-and-rotation.mdx",{"_21":150,"_28":40,"_23":151,"_34":152,"_43":-7,"_11":153,"_45":154},"es:platform/pki/certificates.mdx","Certificados","Consulta, descarga y revoca los certificados emitidos por Lamassu.","/docs/es/platform/pki/certificates",{"_47":155},"platform/pki/certificates.mdx",{"_21":157,"_28":40,"_23":123,"_34":158,"_43":-7,"_11":159,"_45":160},"es:platform/pki/certificate-validation.mdx","Publica el estado de las identidades mediante OCSP y CRL.","/docs/es/platform/pki/certificate-validation",{"_47":161},"platform/pki/certificate-validation.mdx",{"_21":163,"_28":40,"_23":164,"_34":165,"_43":-7,"_11":166,"_45":167},"es:platform/pki/ocsp.mdx","OCSP","Consulta en tiempo real si un certificado sigue vigente o se ha revocado.","/docs/es/platform/pki/ocsp",{"_47":168},"platform/pki/ocsp.mdx",{"_21":170,"_28":40,"_23":171,"_34":172,"_43":-7,"_11":173,"_45":174},"es:platform/pki/crl.mdx","CRL","Genera y distribuye listas firmadas para validar certificados sin conexión.","/docs/es/platform/pki/crl",{"_47":175},"platform/pki/crl.mdx",{"_21":177,"_28":40,"_23":123,"_34":178,"_43":-7,"_11":179,"_45":180},"es:platform/pki/device-enrollment.mdx","Define cómo una flota recibe, renueva y utiliza sus identidades.","/docs/es/platform/pki/device-enrollment",{"_47":181},"platform/pki/device-enrollment.mdx",{"_21":183,"_28":40,"_23":184,"_34":185,"_43":-7,"_11":186,"_45":187},"es:platform/pki/est-enrollment.mdx","EST","Guía del protocolo EST en Lamassu IoT, con la configuración del DMS para el administrador PKI y la referencia de endpoints para el integrador de dispositivos.","/docs/es/platform/pki/est-enrollment",{"_47":188},"platform/pki/est-enrollment.mdx",{"_21":190,"_28":40,"_23":191,"_34":192,"_43":-7,"_11":193,"_45":194},"es:platform/pki/device-management.mdx","Dispositivos e identidades","Registra dispositivos y controla sus identidades durante todo el ciclo de vida.","/docs/es/platform/pki/device-management",{"_47":195},"platform/pki/device-management.mdx",{"_21":197,"_28":40,"_23":198,"_34":199,"_43":-7,"_11":200,"_45":201},"es:platform/pki/alerts.mdx","Alertas y suscripciones","Envía eventos de la PKI a personas y sistemas externos.","/docs/es/platform/pki/alerts",{"_47":202},"platform/pki/alerts.mdx",{"_21":204,"_28":51,"_43":-7,"_23":205},"es:_3","Administrar Lamassu",{"_21":207,"_28":40,"_23":208,"_34":209,"_43":-7,"_11":210,"_45":211},"es:platform/pki/access-control.mdx","Control de acceso","Diseña quién puede acceder a Lamassu mediante principales, políticas, permisos sobre recursos y autorización de rutas HTTP.","/docs/es/platform/pki/access-control",{"_47":212},"platform/pki/access-control.mdx",{"_21":214,"_28":40,"_23":215,"_34":216,"_43":-7,"_11":217,"_45":218},"es:platform/pki/audit-logs.mdx","Registros de auditoría","Entiende qué eventos de auditoría genera Lamassu y cómo convertirlos en una pista durable.","/docs/es/platform/pki/audit-logs",{"_47":219},"platform/pki/audit-logs.mdx",{"_21":221,"_28":40,"_23":222,"_34":223,"_43":-7,"_11":224,"_45":225},"es:platform/pki/troubleshooting.mdx","Resolución de problemas","Diagnostica acceso, salud, emisión, enrolamiento y dependencias en un despliegue de Lamassu.","/docs/es/platform/pki/troubleshooting",{"_47":226},"platform/pki/troubleshooting.mdx",{"_21":228,"_28":51,"_43":-7,"_23":229},"es:_4","Integraciones",{"_21":231,"_28":40,"_23":232,"_34":233,"_43":-7,"_11":234,"_45":235},"es:platform/pki/integrations/aws-iot-core.mdx","AWS IoT Core","El conector de Lamassu para AWS IoT Core sincroniza las identidades de los dispositivos con la plataforma AWS, gestionando el registro de CAs, el aprovisionamiento de Things y el ciclo de vida de los certificados de forma automática y orientada a eventos.","/docs/es/platform/pki/integrations/aws-iot-core",{"_47":236},"platform/pki/integrations/aws-iot-core.mdx","es:platform",{"_239":240},"metaFile","platform/meta.json","<link rel=\"preload\" as=\"image\" href=\"/docs/images/lamassu.svg\"/><img src=\"/docs/images/lamassu.svg\" width=\"20\" height=\"20\" style=\"width:1.25rem;height:1.25rem;vertical-align:middle;flex-shrink:0;object-fit:contain\"/>",{"_28":29,"_23":243,"_31":32,"_33":-7,"_34":244,"_36":-7,"_25":245,"_21":299,"_45":300,"_43":302},"Despliegue","Ejecuta Lamassu en tu entorno",[246,253,256,262,269,276,283,286,292],{"_21":247,"_28":40,"_23":248,"_34":249,"_43":-7,"_11":250,"_45":251},"es:deployment/overview.mdx","Despliega Lamassu","Elige el modelo operativo que encaja con tu infraestructura y requisitos de control.","/docs/es/deployment/overview",{"_47":252},"deployment/overview.mdx",{"_21":254,"_28":51,"_43":-7,"_23":255},"es:_5","Kubernetes self-managed",{"_21":257,"_28":40,"_23":255,"_34":258,"_43":-7,"_11":259,"_45":260},"es:deployment/self-hosted/overview.mdx","Elige un flujo de instalación y una arquitectura de red para Lamassu en tu clúster Kubernetes.","/docs/es/deployment/self-hosted/overview",{"_47":261},"deployment/self-hosted/overview.mdx",{"_21":263,"_28":40,"_23":264,"_34":265,"_43":-7,"_11":266,"_45":267},"es:deployment/self-hosted/helm.mdx","Instala con Helm","Prepara las dependencias, configura el chart de Lamassu y verifica un despliegue controlado en Kubernetes.","/docs/es/deployment/self-hosted/helm",{"_47":268},"deployment/self-hosted/helm.mdx",{"_21":270,"_28":40,"_23":271,"_34":272,"_43":-7,"_11":273,"_45":274},"es:deployment/self-hosted/networking.mdx","Expón el Gateway","Elige cómo llegan los clientes a Lamassu, cuándo definir gateway.addresses y cómo diseñar varios Gateways.","/docs/es/deployment/self-hosted/networking",{"_47":275},"deployment/self-hosted/networking.mdx",{"_21":277,"_28":40,"_23":278,"_34":279,"_43":-7,"_11":280,"_45":281},"es:deployment/self-hosted/fastlane.mdx","Fastlane","Arranca un entorno completo de evaluación o laboratorio de Lamassu en un clúster Kubernetes existente.","/docs/es/deployment/self-hosted/fastlane",{"_47":282},"deployment/self-hosted/fastlane.mdx",{"_21":284,"_28":51,"_43":-7,"_23":285},"es:_6","Otros modelos",{"_21":287,"_28":40,"_23":288,"_34":289,"_43":-7,"_11":12,"_45":290},"es:deployment/aws-marketplace.mdx","Despliega desde AWS Marketplace","Ejecuta una instancia preconfigurada de Lamassu IoT en Amazon EC2.",{"_47":291},"deployment/aws-marketplace.mdx",{"_21":293,"_28":40,"_23":294,"_34":295,"_43":-7,"_11":296,"_45":297},"es:deployment/saas.mdx","Utiliza Lamassu como SaaS","Consume Lamassu como servicio gestionado sin operar infraestructura propia.","/docs/es/deployment/saas",{"_47":298},"deployment/saas.mdx","es:deployment",{"_239":301},"deployment/meta.json","<link rel=\"preload\" as=\"image\" href=\"/docs/images/kubernetes.s