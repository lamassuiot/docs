x.mdx","Referencia EST","El protocolo Enrollment over Secure Transport definido en RFC 7030.","/docs/es/platform/iot-fleets/est",{"_50":280},"platform/iot-fleets/est/index.mdx",{"_24":282,"_31":43,"_26":283,"_37":284,"_46":-7,"_11":285,"_48":286},"es:platform/iot-fleets/est/configuration.mdx","EST en Lamassu","Configura las operaciones EST, la autenticación y la distribución de confianza.","/docs/es/platform/iot-fleets/est/configuration",{"_50":287},"platform/iot-fleets/est/configuration.mdx",{"_24":289,"_31":43,"_26":290,"_37":291,"_46":-7,"_11":292,"_48":293},"es:platform/iot-fleets/est/bootstrap-identity.mdx","Autenticación y confianza","Prepara las credenciales, la autenticación y la distribución de confianza para EST.","/docs/es/platform/iot-fleets/est/bootstrap-identity",{"_50":294},"platform/iot-fleets/est/bootstrap-identity.mdx",{"_24":296,"_31":43,"_26":297,"_37":298,"_46":-7,"_11":299,"_48":300},"es:platform/iot-fleets/est/troubleshooting.mdx","Diagnóstico de enrolamiento","Localiza fallos de transporte, autenticación, registro, emisión e instalación.","/docs/es/platform/iot-fleets/est/troubleshooting",{"_50":301},"platform/iot-fleets/est/troubleshooting.mdx","es:platform/iot-fleets",{"_192":304},"platform/iot-fleets/meta.json","<svg xmlns=\"http://www.w3.org/2000/svg\" width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-cpu shrink-0\" aria-hidden=\"true\"><path d=\"M12 20v2\"></path><path d=\"M12 2v2\"></path><path d=\"M17 20v2\"></path><path d=\"M17 2v2\"></path><path d=\"M2 12h2\"></path><path d=\"M2 17h2\"></path><path d=\"M2 7h2\"></path><path d=\"M20 12h2\"></path><path d=\"M20 17h2\"></path><path d=\"M20 7h2\"></path><path d=\"M7 20v2\"></path><path d=\"M7 2v2\"></path><rect x=\"4\" y=\"4\" width=\"16\" height=\"16\" rx=\"2\"></rect><rect x=\"8\" y=\"8\" width=\"8\" height=\"8\" rx=\"1\"></rect></svg>",{"_24":307,"_31":43,"_