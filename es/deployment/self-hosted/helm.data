/glossary",{"_48":118},"platform/pki/concepts/glossary.mdx",{"_22":120,"_29":52,"_44":-7,"_24":121},"es:_2","Operar Lamassu",{"_22":123,"_29":41,"_24":124,"_35":125,"_44":-7,"_12":126,"_46":127},"es:platform/pki/key-management.mdx","Overview","Genera, importa y opera claves sin acoplar la PKI a un proveedor concreto.","/docs/es/platform/pki/key-management",{"_48":128},"platform/pki/key-management.mdx",{"_22":130,"_29":41,"_24":131,"_35":132,"_44":-7,"_12":133,"_46":134},"es:platform/pki/certificate-authorities.mdx","Authorities","Crea, importa y opera las autoridades que establecen la confianza de tu PKI.","/docs/es/platform/pki/certificate-authorities",{"_48":135},"platform/pki/certificate-authorities.mdx",{"_22":137,"_29":41,"_24":138,"_35":139,"_44":-7,"_12":140,"_46":141},"es:platform/pki/certificate-profiles.mdx","Certificate profiles","Define políticas reutilizables para emitir certificados coherentes y limitar las claves aceptadas.","/docs/es/platform/pki/certificate-profiles",{"_48":142},"platform/pki/certificate-profiles.mdx",{"_22":144,"_29":41,"_24":145,"_35":146,"_44":-7,"_12":147,"_46":148},"es:platform/pki/ca-hierarchy-and-rotation.mdx","Hierarchy and rotation","Diseña autoridades raíz e intermedias y sustituye certificados o claves sin romper la confianza.","/docs/es/platform/pki/ca-hierarchy-and-rotation",{"_48":149},"platform/pki/ca-hierarchy-and-rotation.mdx",{"_22":151,"_29":41,"_24":152,"_35":153,"_44":-7,"_12":154,"_46":155},"es:platform/pki/certificates.mdx","Certificados","Consulta, descarga y revoca los certificados emitidos por Lamassu.","/docs/es/platform/pki/certificates",{"_48":156},"platform/pki/certificates.mdx",{"_22":158,"_29":41,"_24":124,"_35":159,"_44":-7,"_12":160,"_46":161},"es:platform/pki/certificate-validation.mdx","Publica el estado de las identidades mediante OCSP y CRL.","/docs/es/platform/pki/certificate-validation",{"_48":162},"platform/pki/certificate-validation.mdx",{"_22":164,"_29":41,"_24":165,"_35":166,"_44":-7,"_12":167,"_46":168},"es:platform/pki/ocsp.mdx","OCSP","Consulta en tiempo real si un certificado sigue vigente o se ha revocado.","/docs/es/platform/pki/ocsp",{"_48":169},"platform/pki/ocsp.mdx",{"_22":171,"_29":41,"_24":172,"_35":173,"_44":-7,"_12":174,"_46":175},"es:platform/pki/crl.mdx","CRL","Genera y distribuye listas firmadas para validar certificados sin conexión.","/docs/es/platform/pki/crl",{"_48":176},"platform/pki/crl.mdx",{"_22":178,"_29":41,"_24":124,"_35":179,"_44":-7,"_12":180,"_46":181},"es:platform/pki/device-enrollment.mdx","Define cómo una flota recibe, renueva y utiliza sus identidades.","/docs/es/platform/pki/device-enrollment",{"_48":182},"platform/pki/device-enrollment.mdx",{"_22":184,"_29":41,"_24":185,"_35":186,"_44":-7,"_12":187,"_46":188},"es:platform/pki/est-enrollment.mdx","EST","Guía del protocolo EST en Lamassu IoT, con la configuración del DMS para el administrador PKI y la referencia de endpoints para el integrador de dispositivos.","/docs/es/platform/pki/est-enrollment",{"_48":189},"platform/pki/est-enrollment.mdx",{"_22":191,"_29":41,"_24":192,"_35":193,"_44":-7,"_12":194,"_46":195},"es:platform/pki/device-management.mdx","Dispositivos e identidades","Registra dispositivos y controla sus identidades durante todo el ciclo de vida.","/docs/es/platform/pki/device-management",{"_48":196},"platform/pki/device-management.mdx",{"_22":198,"_29":41,"_24":199,"_35":200,"_44":-7,"_12":201,"_46":202},"es:platform/pki/alerts.mdx","Alertas y suscripciones","Envía eventos de la PKI a personas y sistemas externos.","/docs/es/platform/pki/alerts",{"_48":203},"platform/pki/alerts.mdx",{"_22":205,"_29":52,"_44":-7,"_24":206},"es:_3","Administrar Lamassu",{"_22":208,"_29":41,"_24":209,"_35":210,"_44":-7,"_12":211,"_46":212},"es:platform/pki/access-control.mdx","Control de acceso","Diseña quién puede acceder a Lamassu mediante principales, políticas, permisos sobre recursos y autorización de rutas HTTP.","/docs/es/platform/pki/access-control",{"_48":213},"