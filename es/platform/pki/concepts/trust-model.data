atform/pki/ocsp.mdx","OCSP","Consulta en tiempo real si un certificado sigue vigente o se ha revocado.","/docs/es/platform/pki/ocsp",{"_49":169},"platform/pki/ocsp.mdx",{"_23":171,"_30":42,"_25":172,"_36":173,"_45":-7,"_13":174,"_47":175},"es:platform/pki/crl.mdx","CRL","Genera y distribuye listas firmadas para validar certificados sin conexión.","/docs/es/platform/pki/crl",{"_49":176},"platform/pki/crl.mdx",{"_23":178,"_30":42,"_25":124,"_36":179,"_45":-7,"_13":180,"_47":181},"es:platform/pki/device-enrollment.mdx","Define cómo una flota recibe, renueva y utiliza sus identidades.","/docs/es/platform/pki/device-enrollment",{"_49":182},"platform/pki/device-enrollment.mdx",{"_23":184,"_30":42,"_25":185,"_36":186,"_45":-7,"_13":187,"_47":188},"es:platform/pki/est-enrollment.mdx","EST","Guía del protocolo EST en Lamassu IoT, con la configuración del DMS para el administrador PKI y la referencia de endpoints para el integrador de dispositivos.","/docs/es/platform/pki/est-enrollment",{"_49":189},"platform/pki/est-enrollment.mdx",{"_23":191,"_30":42,"_25":192,"_36":193,"_45":-7,"_13":194,"_47":195},"es:platform/pki/device-management.mdx","Dispositivos e identidades","Registra dispositivos y controla sus identidades durante todo el ciclo de vida.","/docs/es/platform/pki/device-management",{"_49":196},"platform/pki/device-management.mdx",{"_23":198,"_30":42,"_25":199,"_36":200,"_45":-7,"_13":201,"_47":202},"es:platform/pki/alerts.mdx","Alertas y suscripciones","Envía eventos de la PKI a personas y sistemas externos.","/docs/es/platform/pki/alerts",{"_49":203},"platform/pki/alerts.mdx",{"_23":205,"_30":53,"_45":-7,"_25":206},"es:_3","Administrar Lamassu",{"_23":208,"_30":42,"_25":209,"_36":210,"_45":-7,"_13":211,"_47":212},"es:platform/pki/access-control.mdx","Control de acceso","Diseña quién puede acceder a Lamassu mediante principales, políticas, permisos sobre recursos y autorización de rutas HTTP.","/docs/es/platform/pki/access-control",{"_49":213},"platform/pki/access-control.mdx",{"_23":215,"_30":42,"_25":216,"_36":217,"_45":-7,"_13":218,"_47":219},"es:platform/pki/audit-logs.mdx","Registros de auditoría","Entiende qué eventos de auditoría genera Lamassu y cómo convertirlos en una pista durable.","/docs/es/platform/pki/audit-logs",{"_49":220},"platform/pki/audit-logs.mdx",{"_23":222,"_30":42,"_25":223,"_36":224,"_45":-7,"_13":225,"_47":226},"es:platform/pki/troubleshooting.mdx","Resolución de problemas","Diagnostica acceso, salud, emisión, enrolamiento y dependencias en un despliegue de Lamassu.","/docs/es/platform/pki/troubleshooting",{"_49":227},"platform/pki/troubleshooting.mdx",{"_23":229,"_30":53,"_45":-7,"_25":230},"es:_4","Integraciones",{"_23":232,"_30":42,"_25":233,"_36":234,"_45":-7,"_13":235,"_47":236},"es:platform/pki/integrations/aws-iot-core.mdx","AWS IoT Core","El conector de Lamassu para AWS IoT Core sincroniza las identidades de los dispositivos con la plataforma AWS, gestionando el registro de CAs, el aprovisionamiento de Things y el ciclo de vida de los certificados de forma automática y orientada a eventos.","/docs/es/platform/pki/integrations/aws-iot-core",{"_49":237},"platform/pki/integrations/aws-iot-core.mdx","es:platform",{"_240":241},"metaFile","platform/meta.json","<link rel=\"preload\" as=\"image\" href=\"/docs/images/lamassu.svg\"/><img src=\"/docs/images/lamassu.svg\" width=\"20\" height=\"20\" style=\"width:1.25rem;height:1.25rem;vertical-align:middle;flex-shrink:0;object-fit:contain\"/>",{"_30":31,"_25":244,"_33":34,"_35":-7,"_36":245,"_38":-7,"_27":246,"_23":301,"_47":302,"_45":304},"Despliegue","Ejecuta Lamassu en tu entorno",[247,254,257,263,270,277,284,287,294],{"_23":248,"_30":42,"_25":249,"_36":250,"_45":-7,"_13":251,"_47":252},"es:deployment/overview.mdx","Despliega Lamassu","Elige el modelo operativo que encaja con tu infraestructura y requisitos de control.","/docs/es/deployment/overview",{"_49":253},"deployment/overview.mdx",{"_23":255,"_30":53,"_45":-7,"_25":256},"es:_5","Kubernetes self-