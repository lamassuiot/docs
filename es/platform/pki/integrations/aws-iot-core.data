":42,"_25":166,"_36":167,"_45":-7,"_13":168,"_47":169},"es:platform/pki/ocsp.mdx","OCSP","Consulta en tiempo real si un certificado sigue vigente o se ha revocado.","/docs/es/platform/pki/ocsp",{"_49":170},"platform/pki/ocsp.mdx",{"_23":172,"_30":42,"_25":173,"_36":174,"_45":-7,"_13":175,"_47":176},"es:platform/pki/crl.mdx","CRL","Genera y distribuye listas firmadas para validar certificados sin conexión.","/docs/es/platform/pki/crl",{"_49":177},"platform/pki/crl.mdx",{"_23":179,"_30":42,"_25":125,"_36":180,"_45":-7,"_13":181,"_47":182},"es:platform/pki/device-enrollment.mdx","Define cómo una flota recibe, renueva y utiliza sus identidades.","/docs/es/platform/pki/device-enrollment",{"_49":183},"platform/pki/device-enrollment.mdx",{"_23":185,"_30":42,"_25":186,"_36":187,"_45":-7,"_13":188,"_47":189},"es:platform/pki/est-enrollment.mdx","EST","Guía del protocolo EST en Lamassu IoT, con la configuración del DMS para el administrador PKI y la referencia de endpoints para el integrador de dispositivos.","/docs/es/platform/pki/est-enrollment",{"_49":190},"platform/pki/est-enrollment.mdx",{"_23":192,"_30":42,"_25":193,"_36":194,"_45":-7,"_13":195,"_47":196},"es:platform/pki/device-management.mdx","Dispositivos e identidades","Registra dispositivos y controla sus identidades durante todo el ciclo de vida.","/docs/es/platform/pki/device-management",{"_49":197},"platform/pki/device-management.mdx",{"_23":199,"_30":42,"_25":200,"_36":201,"_45":-7,"_13":202,"_47":203},"es:platform/pki/alerts.mdx","Alertas y suscripciones","Envía eventos de la PKI a personas y sistemas externos.","/docs/es/platform/pki/alerts",{"_49":204},"platform/pki/alerts.mdx",{"_23":206,"_30":53,"_45":-7,"_25":207},"es:_3","Administrar Lamassu",{"_23":209,"_30":42,"_25":210,"_36":211,"_45":-7,"_13":212,"_47":213},"es:platform/pki/access-control.mdx","Control de acceso","Diseña quién puede acceder a Lamassu mediante principales, políticas, permisos sobre recursos y autorización de rutas HTTP.","/docs/es/pla