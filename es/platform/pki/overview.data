ry.mdx",{"_22":119,"_29":51,"_44":-7,"_24":120},"es:_2","Operar Lamassu",{"_22":122,"_29":41,"_24":123,"_35":124,"_44":-7,"_12":125,"_45":126},"es:platform/pki/key-management.mdx","Overview","Genera, importa y opera claves sin acoplar la PKI a un proveedor concreto.","/docs/es/platform/pki/key-management",{"_47":127},"platform/pki/key-management.mdx",{"_22":129,"_29":41,"_24":130,"_35":131,"_44":-7,"_12":132,"_45":133},"es:platform/pki/certificate-authorities.mdx","Authorities","Crea, importa y opera las autoridades que establecen la confianza de tu PKI.","/docs/es/platform/pki/certificate-authorities",{"_47":134},"platform/pki/certificate-authorities.mdx",{"_22":136,"_29":41,"_24":137,"_35":138,"_44":-7,"_12":139,"_45":140},"es:platform/pki/certificate-profiles.mdx","Certificate profiles","Define políticas reutilizables para emitir certificados coherentes y limitar las claves aceptadas.","/docs/es/platform/pki/certificate-profiles",{"_47":141},"platform/pki/certificate-profiles.mdx",{"_22":143,"_29":41,"_24":144,"_35":145,"_44":-7,"_12":146,"_45":147},"es:platform/pki/ca-hierarchy-and-rotation.mdx","Hierarchy and rotation","Diseña autoridades raíz e intermedias y sustituye certificados o claves sin romper la confianza.","/docs/es/platform/pki/ca-hierarchy-and-rotation",{"_47":148},"platform/pki/ca-hierarchy-and-rotation.mdx",{"_22":150,"_29":41,"_24":151,"_35":152,"_44":-7,"_12":153,"_45":154},"es:platform/pki/certificates.mdx","Certificados","Consulta, descarga y revoca los certificados emitidos por Lamassu.","/docs/es/platform/pki/certificates",{"_47":155},"platform/pki/certificates.mdx",{"_22":157,"_29":41,"_24":123,"_35":158,"_44":-7,"_12":159,"_45":160},"es:platform/pki/certificate-validation.mdx","Publica el estado de las identidades mediante OCSP y CRL.","/docs/es/platform/pki/certificate-validation",{"_47":161},"platform/pki/certificate-validation.mdx",{"_22":163,"_29":41,"_24":164,"_35":165,"_44":-7,"_12":166,"_45":167},"es:platform/pki/ocsp.mdx","OCSP","Consulta en tiempo real si un certificado sigue vigente o se ha revocado.","/docs/es/platform/pki/ocsp",{"_47":168},"platform/pki/ocsp.mdx",{"_22":170,"_29":41,"_24":171,"_35":172,"_44":-7,"_12":173,"_45":174},"es:platform/pki/crl.mdx","CRL","Genera y distribuye listas firmadas para validar certificados sin conexión.","/docs/es/platform/pki/crl",{"_47":175},"platform/pki/crl.mdx",{"_22":177,"_29":41,"_24":123,"_35":178,"_44":-7,"_12":179,"_45":180},"es:platform/pki/device-enrollment.mdx","Define cómo una flota recibe, renueva y utiliza sus identidades.","/docs/es/platform/pki/device-enrollment",{"_47":181},"platform/pki/device-enrollment.mdx",{"_22":183,"_29":41,"_24":184,"_35":185,"_44":-7,"_12":186,"_45":187},"es:platform/pki/est-enrollment.mdx","EST","Guía del protocolo EST en Lamassu IoT, con la configuración del DMS para el administrador PKI y la referencia de endpoints para el integrador de dispositivos.","/docs/es/platform/pki/est-enrollment",{"_47":188},"platform/pki/est-enrollment.mdx",{"_22":190,"_29":41,"_24":191,"_35":192,"_44":-7,"_12":193,"_45":194},"es:platform/pki/device-management.mdx","Dispositivos e identidades","Registra dispositivos y controla sus identidades durante todo el ciclo de vida.","/docs/es/platform/pki/device-management",{"_47":195},"platform/pki/device-management.mdx",{"_22":197,"_29":41,"_24":198,"_35":199,"_44":-7,"_12":200,"_45":201},"es:platform/pki/alerts.mdx","Alertas y suscripciones","Envía eventos de la PKI a personas y sistemas externos.","/docs/es/platform/pki/alerts",{"_47":202},"platform/pki/alerts.mdx",{"_22":204,"_29":51,"_44":-7,"_24":205},"es:_3","Administrar Lamassu",{"_22":207,"_29":41,"_24":208,"_35":209,"_44":-7,"_12":210,"_45":211},"es:platform/pki/access-control.mdx","Control de acceso","Diseña quién puede acceder a Lamassu mediante principales, políticas, permisos sobre recursos y autorización de rutas HTTP.","/docs/es/platform/pki/access-control",{"_47":212},"platform/pki/access-control.mdx",{"_22":214,"_29":41,"_24":215,"_35":216,"_44":-7,"_12":217,"_45":218},"es:platform/pki/audit-logs.mdx","Registros de auditoría","Entiende qué eventos de auditoría genera Lamassu y cómo convertirlos en una pista durable.","/docs/es/platform/pki/audit-logs",{"_47":219},"platform/pki/audit-logs.mdx",{"_22":221,"_29":41,"_24":222,"_35":223,"_44":-7,"_12":224,"_45":225},"es:platform/pki/troubleshooting.mdx","Resolución de problemas","Diagnostica acceso, salud, emisión, enrolamiento y dependencias en un despliegue de Lamassu.","/docs/es/platform/pki/troubleshooting",{"_47":226},"platform/pki/troubleshooting.mdx",{"_22":228,"_29":51,"_44":-7,"_24":229},"es:_4","Integraciones",{"_22":231,"_29":41,"_24":232,"_35":233,"_44":-7,"_12":234,"_45":235},"es:platform/pki/integrations/aws-iot-core.mdx","AWS IoT Core","El conector de Lamassu para AWS IoT Core sincroniza las identidades de los dispositivos con la plataforma AWS, gestionando el registro de CAs, el aprovisionamiento de Things y el ciclo de vida de los certificados de forma automática y orientada a eventos.","/docs/es/platform/pki/integrations/aws-iot-core",{"_47":236},"platform/pki/integrations/aws-iot-core.mdx","es:platform",{"_239":240},"metaFile","platform/meta.json","<link rel=\"preload\" as=\"image\" href=\"/docs/images/lamassu.svg\"/><img src=\"/docs/images/lamassu.svg\" width=\"20\" height=\"20\" style=\"width:1.25rem;height:1.25rem;vertical-align:middle;flex-shrink:0;object-fit:contain\"/>",{"_29":30,"_24":243,"_32":33,"_34":-7,"_35":244,"_37":-7,"_26":245,"_22":300,"_45":301,"_44":303},"Despliegue","Ejecuta Lamassu en tu entorno",[246,253,256,262,269,276,283,286,293],{"_22":247,"_29":41,"_24":248,"_35":249,"_44":-7,"_12":250,"_45":251},"es:deployment/overview.mdx","Despliega Lamassu","Elige el modelo operativo que encaja con tu infraestructura y requisitos de control.","/docs/es/deployment/overview",{"_47":252},"deployment/overview.mdx",{"_22":254,"_29":51,"_44":-7,"_24":255},"es:_5","Kubernetes self-managed",{"_22":257,"_29":41,"_24":255,"_35":258,"_44":-7,"_12":259,"_45":260},"es:deployment/self-hosted/overview.mdx","Elige un flujo de instalación y una arquitectura de red para Lamassu en tu clúster Kubernetes.","/docs/es/deployment/self-hosted/overview",{"_47":261},"deployment/self-hosted/overview.mdx",{"_22":263,"_29":41,"_24":264,"_35":265,"_44":-7,"_12":266,"_45":267},"es:deployment/self-hosted/helm.mdx","Instala con Helm","Prepara las dependencias, configura el chart de Lamassu y verifica un despliegue controlado en Kubernetes.","/docs/es/deployment/self-hosted/helm",{"_47":268},"deployment/self-hosted/helm.mdx",{"_22":270,"_29":41,"_24":271,"_35":272,"_44":-7,"_12":273,"_45":274},"es:deployment/self-hosted/networking.mdx","Expón el Gateway","Elige cómo llegan los clientes a Lamassu, cuándo definir gateway.addresses y cómo diseñar varios Gateways.","/docs/es/deployment/self-hosted/networking",{"_47":275},"deployment/self-hosted/networking.mdx",{"_22":277,"_29":41,"_24":278,"_35":279,"_44":-7,"_12":280,"_45":281},"es:deployment/self-hosted/fastlane.mdx","Fastlane","Arranca un entorno completo de evaluación o laboratorio de Lamassu en un clúster Kubernetes existente.","/docs/es/deployment/self-hosted/fastlane",{"_47":282},"deployment/self-hosted/fastlane.mdx",{"_22":284,"_29":51,"_44":-7,"_24":285},"es:_6","Otros modelos",{"_22":287,"_29":41,"_24":288,"_35":289,"_44":-7,"_12":290,"_45":291},"es:deployment/aws-marketplace.mdx","Despliega desde AWS Marketplace","Ejecuta una instancia preconfigurada de Lamassu IoT en Amazon EC2.","/docs/es/deployment/aws-marketplace",{"_47":292},"deployment/aws-marketplace.mdx",{"_22":294,"_29":41,"_24":295,"_35":296,"_44":-7,"_12":297,"_45":298},"es:deployment/saas.mdx","Utiliza Lamassu como SaaS","Consume Lamassu como servicio gestionado sin operar infraestructura propia.","/docs/es/deployment/saas",{"_47":299},"deployment/saas.mdx","es:deployment",{"_239":302},"deployment/meta.json","<link rel=\"preload\" as=\"image\" href=\"/docs/images/kubernetes.svg\"