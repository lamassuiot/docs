ientada a eventos.","/docs/manual/integraciones/aws",{"_45":197},{"_203":204},"metaFile","manual/meta.json","<link rel=\"preload\" as=\"image\" href=\"/docs/images/lamassu.svg\"/><img src=\"/docs/images/lamassu.svg\" width=\"20\" height=\"20\" style=\"width:1.25rem;height:1.25rem;vertical-align:middle;flex-shrink:0;object-fit:contain\"/>",{"_27":28,"_22":207,"_21":30,"_31":-7,"_32":208,"_34":-7,"_24":209,"_20":248,"_43":249,"_41":251},"Despliegue","Ejecuta Lamassu en tu entorno",[210,216,219,224,230,233,239,242],{"_20":211,"_27":38,"_22":212,"_32":213,"_41":-7,"_12":214,"_43":215},"despliegue/index.mdx","Despliega Lamassu","Elige el modelo operativo que encaja con tu infraestructura y requisitos de control.","/docs/despliegue",{"_45":211},{"_20":217,"_27":48,"_41":-7,"_22":218},"_4","Kubernetes self-managed",{"_20":220,"_27":38,"_22":218,"_32":221,"_41":-7,"_12":222,"_43":223},"despliegue/onprem/index.mdx","Despliega Lamassu en tu propio clúster Kubernetes con Helm o Fastlane.","/docs/despliegue/onprem",{"_45":220},{"_20":225,"_27":38,"_22":226,"_32":227,"_41":-7,"_12":228,"_43":229},"despliegue/onprem/fastlane.mdx","Fastlane","Referencia del script scripts/lamassu-fast-lane.sh para desplegar Lamassu PKI de forma automatizada en Kubernetes","/docs/despliegue/onprem/fastlane",{"_45":225},{"_20":231,"_27":48,"_41":-7,"_22":232},"_5","AWS Marketplace",{"_20":234,"_27":38,"_22":235,"_32":236,"_41":-7,"_12":237,"_43":238},"despliegue/cloud/index.mdx","Despliega desde AWS Marketplace","Ejecuta una instancia preconfigurada de Lamassu IoT en Amazon EC2.","/docs/despliegue/cloud",{"_45":234},{"_20":240,"_27":48,"_41":-7,"_22":241},"_6","SaaS",{"_20":243,"_27":38,"_22":244,"_32":245,"_41":-7,"_12":246,"_43":247},"despliegue/saas/index.mdx","Utiliza Lamassu como SaaS","Consume Lamassu como servicio gestionado sin operar infraestructura propia.","/docs/despliegue/saas",{"_45":243},"despliegue",{"_203":250},"despliegue/meta.json","<link rel=\"preload\" as=\"image\" href=\"/docs/