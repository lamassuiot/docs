leshooting",{"_46":238},{"_21":244,"_28":49,"_42":-7,"_23":245},"_4","Integraciones",{"_21":12,"_28":39,"_23":247,"_33":248,"_42":-7,"_13":14,"_44":249},"AWS IoT Core","El conector de Lamassu para AWS IoT Core sincroniza las identidades de los dispositivos con la plataforma AWS, gestionando el registro de CAs, el aprovisionamiento de Things y el ciclo de vida de los certificados de forma automática y orientada a eventos.",{"_46":12},{"_251":252},"metaFile","platform/meta.json","<link rel=\"preload\" as=\"image\" href=\"/docs/images/lamassu.svg\"/><img src=\"/docs/images/lamassu.svg\" width=\"20\" height=\"20\" style=\"width:1.25rem;height:1.25rem;vertical-align:middle;flex-shrink:0;object-fit:contain\"/>",{"_28":29,"_23":255,"_22":31,"_32":-7,"_33":256,"_35":-7,"_25":257,"_21":293,"_44":294,"_42":296},"Despliegue","Ejecuta Lamassu en tu entorno",[258,264,267,272,278,281,287],{"_21":259,"_28":39,"_23":260,"_33":261,"_42":-7,"_13":262,"_44":263},"deployment/overview.mdx","Despliega Lamassu","Elige el modelo operativo que encaja con tu infraestructura y requisitos de control.","/docs/deployment/overview",{"_46":259},{"_21":265,"_28":49,"_42":-7,"_23":266},"_5","Kubernetes self-managed",{"_21":268,"_28":39,"_23":266,"_33":269,"_42":-7,"_13":270,"_44":271},"deployment/self-hosted/overview.mdx","Despliega Lamassu en tu propio clúster Kubernetes con Helm o Fastlane.","/docs/deployment/self-hosted/overview",{"_46":268},{"_21":273,"_28":39,"_23":274,"_33":275,"_42":-7,"_13":276,"_44":277},"deployment/self-hosted/fastlane.mdx","Fastlane","Referencia del script scripts/lamassu-fast-lane.sh para desplegar Lamassu PKI de forma automatizada en Kubernetes","/docs/deployment/self-hosted/fastlane",{"_46":273},{"_21":279,"_28":49,"_42":-7,"_23":280},"_6","Otros modelos",{"_21":282,"_28":39,"_23":283,"_33":284,"_42":-7,"_13":285,"_44":286},"deployment/aws-marketplace.mdx","Despliega desde AWS Marketplace","Ejecuta una instancia preconfigurada de Lamassu IoT en Amazon EC2.","/docs/depl