264,"_15096":31873,"_1571":32113},[],"La función `detect_distribution` identifica la distribución con el siguiente orden de prioridad:",{"_7914":115,"_22115":34,"_18751":32115,"_5":22264,"_15096":31873,"_1571":32116},[],"`microk8s`",{"_7914":116,"_22115":34,"_18751":32118,"_5":22264,"_15096":31873,"_1571":32119},[],"`k3s`",{"_7914":117,"_22115":34,"_18751":32121,"_5":22264,"_15096":31873,"_1571":32122},[],"`kind`",{"_7914":118,"_22115":34,"_18751":32124,"_5":22264,"_15096":31873,"_1571":32125},[],"Kubernetes estándar",{"_7914":119,"_22115":34,"_18751":32127,"_5":22264,"_15096":31873,"_1571":32128},[],"Comportamientos específicos:",{"_7914":120,"_22115":34,"_18751":32130,"_5":22264,"_15096":31873,"_1571":32131},[],"En `microk8s`, los comandos se ejecutan con prefijos `microk8s kubectl` y `microk8s helm`.",{"_7914":121,"_22115":34,"_18751":32133,"_5":22264,"_15096":31873,"_1571":32134},[],"En `kind`, el script muestra una advertencia de uso exclusivo para pruebas.",{"_7914":122,"_22115":34,"_18751":32136,"_5":22264,"_15096":31877,"_1571":32137},[],"La función `check_dependencies` valida prerequisitos según la distribución detectada.",{"_7914":123,"_22115":34,"_18751":32139,"_5":22264,"_15096":31877,"_1571":32140},[],"Requisitos generales:",{"_7914":124,"_22115":34,"_18751":32142,"_5":22264,"_15096":31877,"_1571":32143},[],"`yq`",{"_7914":125,"_22115":34,"_18751":32145,"_5":22264,"_15096":31877,"_1571":32146},[],"CLI de la distribución detectada",{"_7914":126,"_22115":34,"_18751":32148,"_5":22264,"_15096":31877,"_1571":32149},[],"Requisitos específicos:",{"_7914":127,"_22115":34,"_18751":32151,"_5":22264,"_15096":31877,"_1571":32152},[],"Distribución",{"_7914":128,"_22115":34,"_18751":32154,"_5":22264,"_15096":31877,"_1571":32155},[],"Herramientas requeridas",{"_7914":129,"_22115":34,"_18751":32157,"_5":22264,"_15096":31877,"_1571":32119},[],{"_7914":130,"_22115":34,"_18751":32159,"_5":22264,"_15096":31877,"_1571":32160},[],"`kubectl`, `helm`",{"_7914":131,"_22115":34,"_18751":32162,"_5":22264,"_15096":31877,"_1571":32116},[],{"_7914":132,"_22115":34,"_18751":32164,"_5":22264,"_15096":31877,"_1571":32165},[],"`microk8s kubectl`, `microk8s helm`",{"_7914":133,"_22115":34,"_18751":32167,"_5":22264,"_15096":31881,"_1571":32168},[],"Se valida que estén habilitados:",{"_7914":134,"_22115":34,"_18751":32170,"_5":22264,"_15096":31881,"_1571":32171},[],"`helm`",{"_7914":135,"_22115":34,"_18751":32173,"_5":22264,"_15096":31881,"_1571":32174},[],"`hostpath-storage`",{"_7914":136,"_22115":34,"_18751":32176,"_5":22264,"_15096":31881,"_1571":32177},[],"`dns`",{"_7914":137,"_22115":34,"_18751":32179,"_5":22264,"_15096":31881,"_1571":32180},[],"`cert-manager`",{"_7914":138,"_22115":34,"_18751":32182,"_5":22264,"_15096":31881,"_1571":32183},[],"También se verifica un release Helm de Envoy Gateway llamado `eg` en el namespace `envoy-gateway-system`.\nSi no existe, se instala automáticamente la versión `v1.3.0` y se crea un `GatewayClass` llamado `eg`.",{"_7914":139,"_22115":34,"_18751":32185,"_5":22264,"_15096":31889,"_1571":32186},[],"La función `request_config_data` solicita:",{"_7914":140,"_22115":34,"_18751":32188,"_5":22264,"_15096":31889,"_1571":32189},[],"Dominio Lamassu",{"_7914":141,"_22115":34,"_18751":32191,"_5":22264,"_15096":31889,"_1571":32192},[],"Usuario y contraseña admin PostgreSQL",{"_7914":142,"_22115":34,"_18751":32194,"_5":22264,"_15096":31889,"_1571":32195},[],"Usuario y contraseña admin RabbitMQ",{"_7914":143,"_22115":34,"_18751":32197,"_5":22264,"_15096":31889,"_1571":32198},[],"Usuario y contraseña admin Keycloak",{"_7914":144,"_22115":34,"_18751":32200,"_5":22264,"_15096":31889,"_1571":32201},[],"Namespace Kubernetes",{"_7914":145,"_22115":34,"_18751":32203,"_5":22264,"_15096":31893,"_1571":32204},[],"Se generan credenciales aleatorias de 30 caracteres alfanuméricos.",{"_7914":146,"_22115":34,"_18751":32206,"_5":22264,"_15096":31893,"_1571":32207},[],"Se usan valores por defecto para dominio y namespace, salvo que se sobrescriban con flags.",{"_7914":147,"_22115":34,"_18751":32209,"_5":22264,"_15096":31897,"_1571":32210},[],"El script admite dos estrategias para obtener charts Helm.",{"_7914":148,"_22115":34,"_18751":32212,"_5":22264,"_15096":31901,"_1571":32213},[],"Los charts se descargan desde repositorios remotos.",{"_7914":149,"_22115":34,"_18751":32215,"_5":22264,"_15096":31905,"_1571":32216},[],"Requiere obligatoriamente rutas a los cuatro charts:",{"_7914":150,"_22115":34,"_18751":32218,"_5":22264,"_15096":31905,"_1571":32073},[],{"_7914":151,"_22115":34,"_18751":32220,"_5":22264,"_15096":31905,"_1571":32081},[],{"_7914":152,"_22115":34,"_18751":32222,"_5":22264,"_15096":31905,"_1571":32089},[],{"_7914":153,"_22115":34,"_18751":32224,"_5":22264,"_15096":31905,"_1571":32097},[],{"_7914":154,"_22115":34,"_18751":32226,"_5":22264,"_15096":31905,"_1571":32227},[],"Si falta cualquiera de ellos, el script finaliza con error.",{"_7914":155,"_22115":34,"_18751":32229,"_5":22264,"_15096":31905,"_1571":32230},[],"En este modo se fuerza:",{"_7914":156,"_22115":34,"_18751":32232,"_5":22264,"_15096":31913,"_1571":32233},[],"Chart: `oci://registry-1.docker.io/cloudpirates/postgres`",{"_7914":157,"_22115":34,"_18751":32235,"_5":22264,"_15096":31913,"_1571":32236},[],"Versión del chart: `0.19.0`",{"_7914":158,"_22115":34,"_18751":32238,"_5":22264,"_15096":31913,"_1571":32239},[],"Release: `postgres`",{"_7914":159,"_22115":34,"_18751":32241,"_5":22264,"_15096":31913,"_1571":32242},[],"`fullnameOverride: \"postgresql\"`",{"_7914":160,"_22115":34,"_18751":32244,"_5":22264,"_15096":31913,"_1571":32245},[],"Se crea un script SQL de inicialización con estas bases de datos:",{"_7914":161,"_22115":34,"_18751":32247,"_5":22264,"_15096":31913,"_1571":32248},[],"Base de datos",{"_7914":162,"_22115":34,"_18751":32250,"_5":22264,"_15096":31913,"_1571":32251},[],"Servicio",{"_7914":163,"_22115":34,"_18751":32253,"_5":22264,"_15096":31913,"_1571":32254},[],"`auth`",{"_7914":164,"_22115":34,"_18751":32256,"_5":22264,"_15096":31913,"_1571":31966},[],{"_7914":165,"_22115":34,"_18751":32258,"_5":22264,"_15096":31913,"_1571":32259},[],"`alerts`",{"_7914":166,"_22115":34,"_18751":32261,"_5":22264,"_15096":31913,"_1571":32262},[],"Alerts",{"_7914":167,"_22115":34,"_18751":32264,"_5":22264,"_15096":31913,"_1571":32265},[],"`ca`",{"_7914":168,"_22115":34,"_18751":32267,"_5":22264,"_15096":31913,"_1571":32268},[],"CA",{"_7914":169,"_22115":34,"_18751":32270,"_5":22264,"_15096":31913,"_1571":32271},[],"`va`",{"_7914":170,"_22115":34,"_18751":32273,"_5":22264,"_15096":31913,"_1571":32274},[],"VA",{"_7914":171,"_22115":34,"_18751":32276,"_5":22264,"_15096":31913,"_1571":32277},[],"`cloudproxy`",{"_7914":172,"_22115":34,"_18751":32279,"_5":22264,"_15096":31913,"_1571":32280},[],"Cloud Proxy",{"_7914":173,"_22115":34,"_18751":32282,"_5":22264,"_15096":31913,"_1571":32283},[],"`devicemanager`",{"_7914":174,"_22115":34,"_18751":32285,"_5":22264,"_15096":31913,"_1571":32286},[],"Device Manager",{"_7914":175,"_22115":34,"_18751":32288,"_5":22264,"_15096":31913,"_1571":32289},[],"`dmsmanager`",{"_7914":176,"_22115":34,"_18751":32291,"_5":22264,"_15096":31913,"_1571":32292},[],"DMS Manager",{"_7914":177,"_22115":34,"_18751":32294,"_5":22264,"_15096":31913,"_1571":32295},[],"`kms`",{"_7914":178,"_22115":34,"_18751":32297,"_5":22264,"_15096":31913,"_1571":32298},[],"KMS",{"_7914":179,"_22115":34,"_18751":32300,"_5":22264,"_15096":31917,"_1571":32301},[],"Chart: `oci://registry-1.docker.io/cloudpirates/keycloak`",{"_7914":180,"_22115":34,"_18751":32303,"_5":22264,"_15096":31917,"_1571":32304},[],"Versión del chart: `0.20.0`",{"_7914":181,"_22115":34,"_18751":32306,"_5":22264,"_15096":31917,"_1571":32307},[],"Release: `auth`",{"_7914":182,"_22115":34,"_18751":32309,"_5":22264,"_15096":31917,"_1571":32310},[],"Uso de base de datos externa: `postgresql:5432/auth`",{"_7914":183,"_22115":34,"_18751":32312,"_5":22264,"_15096":31917,"_1571":32313},[],"Imagen de Keycloak fijada en `keycloak/keycloak:26.6.0`",{"_7914":184,"_22115":34,"_18751":32315,"_5":22264,"_15096":31917,"_1571":32316},[],"`httpRelativePath: /auth/`",{"_7914":185,"_22115":34,"_18751":32318,"_5":22264,"_15096":31917,"_1571":32319},[],"`proxyHeaders: xforwarded`",{"_7914":186,"_22115":34,"_18751":32321,"_5":22264,"_15096":31917,"_1571":32322},[],"Configuración automática del realm `lamassu`:",{"_7914":187,"_22115":34,"_18751":32324,"_5":22264,"_15096":31917,"_1571":32325},[],"Rol: `pki-admin`",{"_7914":188,"_22115":34,"_18751":32327,"_5":22264,"_15096":31917,"_1571":32328},[],"Usuario inicial: `lamassu` / `lamassu` (cambio obligatorio)",{"_7914":189,"_22115":34,"_18751":32330,"_5":22264,"_15096":31917,"_1571":32331},[],"Cliente público: `frontend` con `/*` en redirect URIs",{"_7914":190,"_22115":34,"_18751":32333,"_5":22264,"_15096":31917,"_1571":32334},[],"En modo online se descarga automáticamente un tema personalizado desde:",{"_7914":191,"_22115":34,"_18751":32336,"_5":22264,"_15096":31917,"_1571":32337},[],"`github.com/lamassuiot/keycloak-theme`",{"_7914":192,"_22115":34,"_18751":32339,"_5":22264,"_15096":31921,"_1571":32340},[],"Chart: `oci://registry-1.docker.io/cloudpirates/rabbitmq`",{"_7914":193,"_22115":34,"_18751":32342,"_5":22264,"_15096":31921,"_1571":32304},[],{"_7914":194,"_22115":34,"_18751":32344,"_5":22264,"_15096":31921,"_1571":32345},[],"Release: `rabbitmq`",{"_7914":195,"_22115":34,"_18751":32347,"_5":22264,"_15096":31921,"_1571":32348},[],"`fullnameOverride: \"rabbitmq\"`",{"_7914":196,"_22115":34,"_18751":32350,"_5":22264,"_15096":31921,"_1571":32351},[],"Credenciales inyectadas dinámicamente mediante `yq`",{"_7914":197,"_22115":34,"_18751":32353,"_5":22264,"_15096":31925,"_1571":32354},[],"Se genera un archivo `lamassu.yaml` que se pasa a `helm install`.",{"_7914":198,"_22115":34,"_18751":32356,"_5":22264,"_15096":31925,"_1571":32357},[],"Configuraciones principales:",{"_7914":199,"_22115":34,"_18751":32359,"_5":22264,"_15096":31925,"_1571":32360},[],"PostgreSQL: host `postgresql`, puerto `5432`",{"_7914":200,"_22115":34,"_18751":32362,"_5":22264,"_15096":31925,"_1571":32363},[],"AMQP: host `rabbitmq`, puerto `5672`, TLS deshabilitado",{"_7914":201,"_22115":34,"_18751":32365,"_5":22264,"_15096":31925,"_1571":32366},[],"OIDC JWKS:\n`http://auth-keycloak.<NAMESPACE>/auth/realms/lamassu/protocol/openid-connect/certs`",{"_7914":202,"_22115":34,"_18751":32368,"_5":22264,"_15096":31925,"_1571":32369},[],"Ruta adicional de gateway: `/auth -> auth-keycloak:8080`",{"_7914":203,"_22115":34,"_18751":32371,"_5":22264,"_15096":31925,"_1571":32372},[],"Direcciones de gateway: IP(s) obtenidas con `hostname -I`",{"_7914":204,"_22115":34,"_18751":32374,"_5":22264,"_15096":31925,"_1571":32375},[],"Puertos de gateway: desde `--https-port` y `--http-port`",{"_7914":205,"_22115":34,"_18751":32377,"_5":22264,"_15096":31925,"_1571":32378},[],"Dominios CA: valor de `--domain`",{"_7914":206,"_22115":34,"_18751":32380,"_5":22264,"_15096":31925,"_1571":32381},[],"Cuando se ejecuta en modo online y no se usa `--local-chart-path`, el script añade el repositorio Helm:",{"_7914":207,"_22115":34,"_18751":32383,"_5":22264,"_15096":31925,"_1571":32384},[],"Después instala el release `lamassu` usando la versión indicada por `--version` si se ha proporcionado.",{"_7914":208,"_22115":34,"_18751":32386,"_5":22264,"_15096":31925,"_1571":32387},[],"Si `--https-port` es distinto de `443`, el puerto se añade al dominio antes de escribirlo en `values`.",{"_7914":209,"_22115":34,"_18751":32389,"_5":22264,"_15096":31933,"_1571":32390},[],"Si se proporcionan:",{"_7914":210,"_22115":34,"_18751":32392,"_5":22264,"_15096":31933,"_1571":32057},[],{"_7914":211,"_22115":34,"_18751":32394,"_5":22264,"_15096":31933,"_1571":32065},[],{"_7914":212,"_22115":34,"_18751":32396,"_5":22264,"_15096":31933,"_1571":32397},[],"Se crea un secret Kubernetes:",{"_7914":213,"_22115":34,"_18751":32399,"_5":22264,"_15096":31933,"_1571":32400},[],"`downstream-provided-crt`",{"_7914":214,"_22115":34,"_18751":32402,"_5":22264,"_15096":31933,"_1571":32403},[],"Y se configura:",{"_7914":215,"_22115":34,"_18751":32405,"_5":22264,"_15096":31937,"_1571":32406},[],"Si no se proporciona certificado:",{"_7914":216,"_22115":34,"_18751":32408,"_5":22264,"_15096":31937,"_1571":32409},[],"Además, el script crea un `Issuer` self-signed y el recurso `Certificate`.",{"_7914":217,"_22115":34,"_18751":32411,"_5":22264,"_15096":31937,"_1571":32412},[],"Si el usuario quiere reutilizar un `Issuer` o `ClusterIssuer` corporativo, ese flujo no lo automatiza Fastlane; en ese caso es preferible un despliegue manual del chart con un archivo `values.yaml` propio.",{"_7914":218,"_22115":34,"_18751":32414,"_5":22264,"_15096":31941,"_1571":32415},[],"En caso de éxito, se muestra:",{"_7914":219,"_22115":34,"_18751":32417,"_5":22264,"_15096":31941,"_1571":32418},[],"URL de Lamassu UI: `https://<DOMAIN>`",{"_7914":220,"_22115":34,"_18751":32420,"_5":22264,"_15096":31941,"_1571":32421},[],"Credenciales iniciales: `lamassu / lamassu`",{"_7914":221,"_22115":34,"_18751":32423,"_5":22264,"_15096":31941,"_1571":32424},[],"Consola Keycloak: `https://<DOMAIN>/auth/admin`",{"_7914":222,"_22115":34,"_18751":32426,"_5":22264,"_15096":31941,"_1571":32427},[],"Credenciales admin de Keycloak",{"_7914":223,"_22115":34,"_18751":32429,"_5":22264,"_15096":31941,"_1571":32430},[],"El usuario `lamassu` se crea con:",{"_7914":224,"_22115":34,"_18751":32432,"_5":22264,"_15096":31941,"_1571":32433},[],"Por tanto, debe cambiar contraseña en el primer acceso.",{"_7914":225,"_22115":34,"_18751":32435,"_5":22264,"_15096":31945,"_1571":32436},[],"El script está pensado también para validaciones rápidas y smoke tests locales. Tras la instalación puede ejecutarse:",{"_7914":226,"_22115":34,"_18751":32438,"_5":22264,"_15096":31945,"_1571":32439},[],"El chart incluye una prueba que valida conectividad contra `ca`, `dms-manager`, `device-manager`, `va` y `ui`.",{"_7914":227,"_22115":34,"_18751":32441,"_5":22264,"_15096":31945,"_1571":32442},[],"Ejemplo:",{"_7914":228,"_22115":34,"_18751":32444,"_5":22264,"_15096":31945,"_1571":32445},[],"En este escenario:",{"_7914":229,"_22115":34,"_18751":32447,"_5":22264,"_15096":31945,"_1571":32448},[],"`-n`: modo no interactivo",{"_7914":230,"_22115":34,"_18751":32450,"_5":22264,"_15096":31945,"_1571":32451},[],"`-ns`: namespace específico",{"_7914":231,"_22115":34,"_18751":32453,"_5":22264,"_15096":31945,"_1571":32454},[],"`-d`: dominio de CI",{"_7914":232,"_22115":34,"_18751":32456,"_5":22264,"_15096":31945,"_1571":32457},[],"`-l`: chart local",{"_7914":233,"_22115":34,"_18751":32459,"_5":22264,"_15096":31953,"_1571":32460},[],"`lamassu-fast-lane.sh` proporciona un mecanismo totalmente automatizado para desplegar un entorno Lamassu funcional en Kubernetes en pocos minutos, integrando base de datos, autenticación, mensajería, gateway y TLS.",{"_7914":234,"_22115":34,"_18751":32462,"_5":22264,"_15096":31953,"_1571":32463},[],"Está optimizado para rapidez, reproducibilidad y uso en entornos no productivos, con soporte para escenarios offline y pipelines de CI.",{"_7914":235,"_22115":235,"_5":22259,"_1571":32465,"_22272":32466,"_18751":32467,"_15096":235},"Introducción",[31781,31782,31833],[],{"_7914":236,"_22115":235,"_18751":32469,"_5":22264,"_15096":235,"_1571":32470},[],"Despliegue de Lamassu IoT en infraestructura on-premise gestionada con Kubernetes",{"_7914":237,"_22115":235,"_5":22269,"_18751":32472,"_15096":32473,"_1571":32474},[],"/docs/pr-preview/pr-20/despliegue/onprem#despliegue-onprem-con-kubernetes","Despliegue OnPrem con Kubernetes",{"_7914":238,"_22115":235,"_5":22269,"_18751":32476,"_15096":32477,"_1571":32478},[],"/docs/pr-preview/pr-20/despliegue/onprem#quickstart","Quickstart",{"_7914":239,"_22115":235,"_5":22269,"_18751":32480,"_15096":32481,"_1571":32482},[],"/docs/pr-preview/pr-20/despliegue/onprem#qué-se-despliega","Qué se despliega",{"_7914":240,"_22115":235,"_5":22269,"_18751":32484,"_15096":32485,"_1571":32486},[],"/docs/pr-preview/pr-20/despliegue/onprem#requisitos-previos","Requisitos previos",{"_7914":241,"_22115":235,"_5":22269,"_18751":32488,"_15096":32489,"_1571":32490},[],"/docs/pr-preview/pr-20/despliegue/onprem#opciones-de-despliegue","Opciones de despliegue",{"_7914":242,"_22115":235,"_5":22269,"_18751":32492,"_15096":32493,"_1571":32494},[],"/docs/pr-preview/pr-20/despliegue/onprem#1-despliegue-manual-con-helm","1\\. Despliegue manual con Helm",{"_7914":243,"_22115":235,"_5":22269,"_18751":32496,"_15096":32497,"_1571":32498},[],"/docs/pr-preview/pr-20/despliegue/onprem#2-despliegue-automatizado-con-fastlane","2\\. Despliegue automatizado con Fastlane",{"_7914":244,"_22115":235,"_5":22269,"_18751":32500,"_15096":32501,"_1571":32502},[],"/docs/pr-preview/pr-20/despliegue/onprem#arquitectura","Arquitectura",{"_7914":245,"_22115":235,"_5":22269,"_18751":32504,"_15096":32505,"_1571":32506},[],"/docs/pr-preview/pr-20/despliegue/onprem#instalación-manual-con-helm","Instalación manual con Helm",{"_7914":246,"_22115":235,"_5":22269,"_18751":32508,"_15096":32509,"_1571":32510},[],"/docs/pr-preview/pr-20/despliegue/onprem#valores-mínimos-que-deben-definirse","Valores mínimos que deben definirse",{"_7914":247,"_22115":235,"_5":22269,"_18751":32512,"_15096":32513,"_1571":32514},[],"/docs/pr-preview/pr-20/despliegue/onprem#áreas-de-configuración-más-relevantes","Áreas de configuración más relevantes",{"_7914":248,"_22115":235,"_5":22269,"_18751":32516,"_15096":32517,"_1571":32518},[],"/docs/pr-preview/pr-20/despliegue/onprem#verificación-del-despliegue","Verificación del despliegue",{"_7914":249,"_22115":235,"_5":22269,"_18751":32520,"_15096":32521,"_1571":32522},[],"/docs/pr-preview/pr-20/despliegue/onprem#repositorio-helm","Repositorio Helm",{"_7914":250,"_22115":235,"_5":22269,"_18751":32524,"_15096":32525,"_1571":32526},[],"/docs/pr-preview/pr-20/despliegue/onprem#softhsm-como-complemento-opcional","SoftHSM como complemento opcional",{"_7914":251,"_22115":235,"_5":22269,"_18751":32528,"_15096":32529,"_1571":32530},[],"/docs/pr-preview/pr-20/despliegue/onprem#versionado-y-migraciones","Versionado y migraciones",{"_7914":252,"_22115":235,"_18751":32532,"_5":22264,"_15096":32473,"_1571":32533},[],"Lamassu IoT puede desplegarse en infraestructura propia mediante **Kubernetes**, tanto en clústeres gestionados internamente como en entornos self-managed.",{"_7914":253,"_22115":235,"_18751":32535,"_5":22264,"_15096":32473,"_1571":32536},[],"La referencia principal para este despliegue es el repositorio `lamassu-helm`, que incluye:",{"_7914":254,"_22115":235,"_18751":32538,"_5":22264,"_15096":32473,"_1571":32539},[],"el chart principal de Lamassu",{"_7914":255,"_22115":235,"_18751":32541,"_5":22264,"_15096":32473,"_1571":32542},[],"un chart auxiliar de SoftHSM",{"_7914":256,"_22115":235,"_18751":32544,"_5":22264,"_15096":32473,"_1571":32545},[],"el script de despliegue automatizado `scripts/lamassu-fast-lane.sh`",{"_7914":257,"_22115":235,"_18751":32547,"_5":22264,"_15096":32477,"_1571":32548},[],"Si lo que necesitas es levantar un entorno funcional lo antes posible, la vía más rápida es usar Fastlane desde el repositorio `lamassu-helm`:",{"_7914":258,"_22115":235,"_18751":32550,"_5":22264,"_15096":32477,"_1571":32551},[],"Ese flujo:",{"_7914":259,"_22115":235,"_18751":32553,"_5":22264,"_15096":32477,"_1571":32554},[],"crea o reutiliza el namespace indicado",{"_7914":260,"_22115":235,"_18751":32556,"_5":22264,"_15096":32477,"_1571":32557},[],"instala PostgreSQL, Keycloak y RabbitMQ",{"_7914":261,"_22115":235,"_18751":32559,"_5":22264,"_15096":32477,"_1571":32560},[],"despliega el chart de Lamassu",{"_7914":262,"_22115":235,"_18751":32562,"_5":22264,"_15096":32477,"_1571":32563},[],"deja la UI expuesta en `https://<dominio>`",{"_7914":263,"_22115":235,"_18751":32565,"_5":22264,"_15096":32477,"_1571":32566},[],"Si buscas un despliegue productivo o más controlado, sigue con la instalación manual mediante Helm que se describe más abajo.",{"_7914":264,"_22115":235,"_18751":32568,"_5":22264,"_15096":32481,"_1571":32569},[],"El chart principal `charts/lamassu`, actualmente en la serie `3.7.x`, despliega estos componentes:",{"_7914":265,"_22115":235,"_18751":32571,"_5":22264,"_15096":32481,"_1571":32572},[],"`ui`",{"_7914":266,"_22115":235,"_18751":32574,"_5":22264,"_15096":32481,"_1571":32265},[],{"_7914":267,"_22115":235,"_18751":32576,"_5":22264,"_15096":32481,"_1571":32271},[],{"_7914":268,"_22115":235,"_18751":32578,"_5":22264,"_15096":32481,"_1571":32295},[],{"_7914":269,"_22115":235,"_18751":32580,"_5":22264,"_15096":32481,"_1571":32581},[],"`device-manager`",{"_7914":270,"_22115":235,"_18751":32583,"_5":22264,"_15096":32481,"_1571":32584},[],"`dms-manager`",{"_7914":271,"_22115":235,"_18751":32586,"_5":22264,"_15096":32481,"_1571":32259},[],{"_7914":272,"_22115":235,"_18751":32588,"_5":22264,"_15096":32481,"_1571":32589},[],"recursos de Gateway API y políticas de Envoy Gateway",{"_7914":273,"_22115":235,"_18751":32591,"_5":22264,"_15096":32481,"_1571":32592},[],"job de migraciones de base de datos",{"_7914":274,"_22115":235,"_18751":32594,"_5":22264,"_15096":32485,"_1571":32595},[],"Clúster Kubernetes `1.19+`",{"_7914":275,"_22115":235,"_18751":32597,"_5":22264,"_15096":32485,"_1571":32598},[],"`kubectl` configurado con acceso al clúster",{"_7914":276,"_22115":235,"_18751":32600,"_5":22264,"_15096":32485,"_1571":32601},[],"Helm `3.2.0+`",{"_7914":277,"_22115":235,"_18751":32603,"_5":22264,"_15096":32485,"_1571":32604},[],"`cert-manager 1.14+` para la gestión de certificados cuando se usa `tls.type=certManager`",{"_7914":278,"_22115":235,"_18751":32606,"_5":22264,"_15096":32485,"_1571":32607},[],"`Envoy Gateway 1.3.0+`, ya que el chart publica servicios mediante Gateway API y no mediante Ingress",{"_7914":279,"_22115":235,"_18751":32609,"_5":22264,"_15096":32485,"_1571":32610},[],"Acceso a un registro de contenedores o imágenes previamente importadas si se trabaja en modo offline",{"_7914":280,"_22115":235,"_18751":32612,"_5":22264,"_15096":32485,"_1571":32613},[],"Almacenamiento persistente disponible para PostgreSQL, RabbitMQ, VA y KMS",{"_7914":281,"_22115":235,"_18751":32615,"_5":22264,"_15096":32489,"_1571":32616},[],"Hay dos formas de desplegar Lamassu on-prem:",{"_7914":282,"_22115":235,"_18751":32618,"_5":22264,"_15096":32493,"_1571":32619},[],"Es la opción recomendada para entornos productivos o controlados, donde PostgreSQL, RabbitMQ, Keycloak, certificados y direccionamiento del Gateway ya están definidos por el equipo de plataforma.",{"_7914":283,"_22115":235,"_18751":32621,"_5":22264,"_15096":32497,"_1571":32622},[],"Es la opción más útil para pruebas, demos, CI o bootstrap rápido de un entorno. Fastlane levanta PostgreSQL, Keycloak, RabbitMQ y Lamassu en un único flujo. Su comportamiento está documentado en la página siguiente.",{"_7914":284,"_22115":235,"_18751":32624,"_5":22264,"_15096":32501,"_1571":32625},[],"Lamassu IoT se despliega como un conjunto de microservicios Kubernetes independientes. El chart principal crea `Deployment`, `StatefulSet`, `Service`, `ConfigMap`, `HTTPRoute`, `Gateway`, certificados y recursos auxiliares según los valores definidos.",{"_7914":285,"_22115":235,"_18751":32627,"_5":22264,"_15096":32501,"_1571":32628},[],"Dependencias externas requeridas por el chart principal:",{"_7914":286,"_22115":235,"_18751":32630,"_5":22264,"_15096":32501,"_1571":31963},[],{"_7914":287,"_22115":235,"_18751":32632,"_5":22264,"_15096":32501,"_1571":31969},[],{"_7914":288,"_22115":235,"_18751":32634,"_5":22264,"_15096":32501,"_1571":32635},[],"proveedor OIDC, típicamente Keycloak",{"_7914":289,"_22115":235,"_18751":32637,"_5":22264,"_15096":32501,"_1571":32638},[],"El chart no instala estas dependencias por sí solo. Para un despliegue manual hay que provisionarlas antes. Si se busca un entorno funcional rápido para laboratorio o validación, el script Fastlane sí instala PostgreSQL, RabbitMQ y Keycloak además del chart de Lamassu.",{"_7914":290,"_22115":235,"_18751":32640,"_5":22264,"_15096":32505,"_1571":32641},[],"Agregar el repositorio Helm:",{"_7914":291,"_22115":235,"_18751":32643,"_5":22264,"_15096":32505,"_1571":32644},[],"O instalar desde una copia local del repositorio:",{"_7914":292,"_22115":235,"_18751":32646,"_5":22264,"_15096":32509,"_1571":32647},[],"Los valores por defecto del chart son deliberadamente incompletos para dependencias externas. Como mínimo, un despliegue manual debe definir:",{"_7914":293,"_22115":235,"_18751":32649,"_5":22264,"_15096":32509,"_1571":32650},[],"`postgres.hostname`, `postgres.username`, `postgres.password`",{"_7914":294,"_22115":235,"_18751":32652,"_5":22264,"_15096":32509,"_1571":32653},[],"`amqp.hostname`, `amqp.username`, `amqp.password`",{"_7914":295,"_22115":235,"_18751":32655,"_5":22264,"_15096":32509,"_1571":32656},[],"`auth.oidc.frontend.authority`",{"_7914":296,"_22115":235,"_18751":32658,"_5":22264,"_15096":32509,"_1571":32659},[],"`auth.oidc.apiGateway.jwks`",{"_7914":297,"_22115":235,"_18751":32661,"_5":22264,"_15096":32509,"_1571":32662},[],"`services.ca.domains`",{"_7914":298,"_22115":235,"_18751":32664,"_5":22264,"_15096":32509,"_1571":32665},[],"`gateway.addresses` o una estrategia equivalente de publicación según el clúster",{"_7914":299,"_22115":235,"_18751":32667,"_5":22264,"_15096":32509,"_1571":32668},[],"`tls.*` según se use `certManager` o certificado externo",{"_7914":300,"_22115":235,"_18751":32670,"_5":22264,"_15096":32509,"_1571":32671},[],"Ejemplo base:",{"_7914":301,"_22115":235,"_18751":32673,"_5":22264,"_15096":32513,"_1571":32674},[],"Área",{"_7914":302,"_22115":235,"_18751":32676,"_5":22264,"_15096":32513,"_1571":32677},[],"Valores clave",{"_7914":303,"_22115":235,"_18751":32679,"_5":22264,"_15096":32513,"_1571":32680},[],"Uso",{"_7914":304,"_22115":235,"_18751":32682,"_5":22264,"_15096":32513,"_1571":32683},[],"TLS",{"_7914":305,"_22115":235,"_18751":32685,"_5":22264,"_15096":32513,"_1571":32686},[],"`tls.type`, `tls.certManagerOptions.*`, `tls.externalOptions.secretName`",{"_7914":306,"_22115":235,"_18751":32688,"_5":22264,"_15096":32513,"_1571":32689},[],"Certificado downstream del Gateway",{"_7914":307,"_22115":235,"_18751":32691,"_5":22264,"_15096":32513,"_1571":32692},[],"Gateway",{"_7914":308,"_22115":235,"_18751":32694,"_5":22264,"_15096":32513,"_1571":32695},[],"`gateway.addresses`, `gateway.ports.*`, `gateway.extraRouting`",{"_7914":309,"_22115":235,"_18751":32697,"_5":22264,"_15096":32513,"_1571":32698},[],"Exposición de UI y APIs vía Envoy Gateway",{"_7914":310,"_22115":235,"_18751":32700,"_5":22264,"_15096":32513,"_1571":32248},[],{"_7914":311,"_22115":235,"_18751":32702,"_5":22264,"_15096":32513,"_1571":32703},[],"`postgres.*`",{"_7914":312,"_22115":235,"_18751":32705,"_5":22264,"_15096":32513,"_1571":32706},[],"Conexión a PostgreSQL externa",{"_7914":313,"_22115":235,"_18751":32708,"_5":22264,"_15096":32513,"_1571":32709},[],"Mensajería",{"_7914":314,"_22115":235,"_18751":32711,"_5":22264,"_15096":32513,"_1571":32712},[],"`amqp.*`",{"_7914":315,"_22115":235,"_18751":32714,"_5":22264,"_15096":32513,"_1571":32715},[],"Conexión a RabbitMQ",{"_7914":316,"_22115":235,"_18751":32717,"_5":22264,"_15096":32513,"_1571":32718},[],"OIDC",{"_7914":317,"_22115":235,"_18751":32720,"_5":22264,"_15096":32513,"_1571":32721},[],"`auth.oidc.frontend.*`, `auth.oidc.apiGateway.jwks`",{"_7914":318,"_22115":235,"_18751":32723,"_5":22264,"_15096":32513,"_1571":32724},[],"Login de UI y validación JWT en el Gateway",{"_7914":319,"_22115":235,"_18751":32726,"_5":22264,"_15096":32513,"_1571":32268},[],{"_7914":320,"_22115":235,"_18751":32728,"_5":22264,"_15096":32513,"_1571":32662},[],{"_7914":321,"_22115":235,"_18751":32730,"_5":22264,"_15096":32513,"_1571":32731},[],"Dominios autorizados para CA y certificados",{"_7914":322,"_22115":235,"_18751":32733,"_5":22264,"_15096":32513,"_1571":32298},[],{"_7914":323,"_22115":235,"_18751":32735,"_5":22264,"_15096":32513,"_1571":32736},[],"`services.kms.cryptoEngines.*`",{"_7914":324,"_22115":235,"_18751":32738,"_5":22264,"_15096":32513,"_1571":32739},[],"Motor criptográfico y almacenamiento de claves",{"_7914":325,"_22115":235,"_18751":32741,"_5":22264,"_15096":32513,"_1571":32262},[],{"_7914":326,"_22115":235,"_18751":32743,"_5":22264,"_15096":32513,"_1571":32744},[],"`services.alerts.smtp_server.*`",{"_7914":327,"_22115":235,"_18751":32746,"_5":22264,"_15096":32513,"_1571":32747},[],"Envío de correo para alertas",{"_7914":328,"_22115":235,"_18751":32749,"_5":22264,"_15096":32517,"_1571":32750},[],"El chart incluye una prueba Helm en `charts/lamassu/templates/tests/test-connections.yml`. Tras instalarlo, puede validarse con:",{"_7914":329,"_22115":235,"_18751":32752,"_5":22264,"_15096":32517,"_1571":32753},[],"La prueba comprueba al menos:",{"_7914":330,"_22115":235,"_18751":32755,"_5":22264,"_15096":32517,"_1571":32756},[],"salud de `ca`",{"_7914":331,"_22115":235,"_18751":32758,"_5":22264,"_15096":32517,"_1571":32759},[],"salud de `dms-manager`",{"_7914":332,"_22115":235,"_18751":32761,"_5":22264,"_15096":32517,"_1571":32762},[],"salud de `device-manager`",{"_7914":333,"_22115":235,"_18751":32764,"_5":22264,"_15096":32517,"_1571":32765},[],"salud de `va`",{"_7914":334,"_22115":235,"_18751":32767,"_5":22264,"_15096":32517,"_1571":32768},[],"respuesta HTML esperada del servicio `ui`",{"_7914":335,"_22115":235,"_18751":32770,"_5":22264,"_15096":32521,"_1571":32771},[],"El repositorio `lamassu-helm` está organizado en tres bloques principales:",{"_7914":336,"_22115":235,"_18751":32773,"_5":22264,"_15096":32521,"_1571":32774},[],"`charts/lamassu`: chart principal de Lamassu",{"_7914":337,"_22115":235,"_18751":32776,"_5":22264,"_15096":32521,"_1571":32777},[],"`charts/softhsm`: chart opcional para laboratorios o escenarios de integración con PKCS#11 emulado",{"_7914":338,"_22115":235,"_18751":32779,"_5":22264,"_15096":32521,"_1571":32780},[],"`scripts/lamassu-fast-lane.sh`: automatización para levantar dependencias y desplegar Lamassu con intervención mínima",{"_7914":339,"_22115":235,"_18751":32782,"_5":22264,"_15096":32525,"_1571":32783},[],"El chart `charts/softhsm` no forma parte del despliegue estándar, pero resulta útil en entornos de laboratorio cuando se necesita simular un HSM compatible con PKCS#11. No sustituye al backend KMS principal; sirve como soporte para pruebas o integraciones concretas.",{"_7914":340,"_22115":235,"_18751":32785,"_5":22264,"_15096":32529,"_1571":32786},[],"La serie actual del chart principal es `3.7.x`. Para upgrades entre versiones, el repositorio incluye guías específicas en `charts/lamassu/CHANGELOG/`, especialmente en cambios importantes como la adopción de Envoy Gateway o la introducción del servicio KMS.",{"_7914":341,"_22115":341,"_5":22259,"_1571":32788,"_22272":32789,"_18751":32790,"_15096":341},"SaaS · Suscripción",[31781,31782,31840],[],{"_7914":342,"_22115":341,"_18751":32792,"_5":22264,"_15096":341,"_1571":32793},[],"Acceso a Lamassu IoT como servicio gestionado basado en suscripción",{"_7914":343,"_22115":341,"_5":22269,"_18751":32795,"_15096":32796,"_1571":32797},[],"/docs/pr-preview/pr-20/despliegue/saas#lamassu-iot-saas--basada-en-suscripción","Lamassu IoT SaaS – Basada en suscripción",{"_7914":344,"_22115":341,"_5":22269,"_18751":32799,"_15096":32800,"_1571":32801},[],"/docs/pr-preview/pr-20/despliegue/saas#qué-incluye-la-suscripción","¿Qué incluye la suscripción?",{"_7914":345,"_22115":341,"_5":22269,"_18751":32803,"_15096":32804,"_1571":32805},[],"/docs/pr-preview/pr-20/despliegue/saas#planes-disponibles","Planes disponibles",{"_7914":346,"_22115":341,"_5":22269,"_18751":32807,"_15096":32808,"_1571":32809},[],"/docs/pr-preview/pr-20/despliegue/saas#contacto","Contacto",{"_7914":347,"_22115":341,"_18751":32811,"_5":22264,"_15096":32796,"_1571":32812},[],"La modalidad **SaaS** de Lamassu IoT ofrece acceso completo a la plataforma como servicio totalmente gestionado por LKS Next, sin necesidad de gestionar infraestructura propia.",{"_7914":348,"_22115":341,"_18751":32814,"_5":22264,"_15096":32800,"_1571":32815},[],"Acceso a la plataforma Lamassu IoT completamente gestionada",{"_7914":349,"_22115":341,"_18751":32817,"_5":22264,"_15096":32800,"_1571":32818},[],"Alta disponibilidad y backups automáticos",{"_7914":350,"_22115":341,"_18751":32820,"_5":22264,"_15096":32800,"_1571":32821},[],"Actualizaciones automáticas a las últimas versiones",{"_7914":351,"_22115":341,"_18751":32823,"_5":22264,"_15096":32800,"_1571":32824},[],"Soporte técnico incluido",{"_7914":352,"_22115":341,"_18751":32826,"_5":22264,"_15096":32800,"_1571":32827},[],"SLA garantizado",{"_7914":353,"_22115":341,"_18751":32829,"_5":22264,"_15096":32804,"_1571":32830},[],"Plan",{"_7914":354,"_22115":341,"_18751":32832,"_5":22264,"_15096":32804,"_1571":32833},[],"Dispositivos",{"_7914":355,"_22115":341,"_18751":32835,"_5":22264,"_15096":32804,"_1571":32836},[],"Soporte",{"_7914":356,"_22115":341,"_18751":32838,"_5":22264,"_15096":32804,"_1571":32839},[],"SLA",{"_7914":357,"_22115":341,"_18751":32841,"_5":22264,"_15096":32804,"_1571":32842},[],"Starter",{"_7914":358,"_22115":341,"_18751":32844,"_5":22264,"_15096":32804,"_1571":32845},[],"Hasta 1.000",{"_7914":359,"_22115":341,"_18751":32847,"_5":22264,"_15096":32804,"_1571":32848},[],"Email",{"_7914":360,"_22115":341,"_18751":32850,"_5":22264,"_15096":32804,"_1571":32851},[],"99,5%",{"_7914":361,"_22115":341,"_18751":32853,"_5":22264,"_15096":32804,"_1571":32854},[],"Professional",{"_7914":362,"_22115":341,"_18751":32856,"_5":22264,"_15096":32804,"_1571":32857},[],"Hasta 10.000",{"_7914":363,"_22115":341,"_18751":32859,"_5":22264,"_15096":32804,"_1571":32860},[],"Email + Chat",{"_7914":364,"_22115":341,"_18751":32862,"_5":22264,"_15096":32804,"_1571":32863},[],"99,9%",{"_7914":365,"_22115":341,"_18751":32865,"_5":22264,"_15096":32804,"_1571":32866},[],"Enterprise",{"_7914":366,"_22115":341,"_18751":32868,"_5":22264,"_15096":32804,"_1571":32869},[],"Ilimitado",{"_7914":367,"_22115":341,"_18751":32871,"_5":22264,"_15096":32804,"_1571":32872},[],"Dedicado",{"_7914":368,"_22115":341,"_18751":32874,"_5":22264,"_15096":32804,"_1571":32875},[],"99,99%",{"_7914":369,"_22115":341,"_18751":32877,"_5":22264,"_15096":32808,"_1571":32878},[],"Para suscribirte o solicitar una demo, contacta con el equipo de Lamassu IoT a través de lamassu.io.",{"_7914":370,"_22115":370,"_5":22259,"_1571":32880,"_22272":32881,"_18751":32882,"_15096":370},"Manual de Usuario",[31781,32880],[],{"_7914":371,"_22115":370,"_18751":32884,"_5":22264,"_15096":370,"_1571":32885},[],"Guía completa de uso de la plataforma Lamassu IoT",{"_7914":372,"_22115":370,"_5":22269,"_18751":32887,"_15096":32888,"_1571":32889},[],"/docs/pr-preview/pr-20/manual#servicios-core","Servicios Core",{"_7914":373,"_22115":370,"_5":22269,"_18751":32891,"_15096":32892,"_1571":32893},[],"/docs/pr-preview/pr-20/manual#integraciones-con-terceros","Integraciones con terceros",{"_7914":374,"_22115":370,"_18751":32895,"_5":22264,"_15096":370,"_1571":32896},[],"Bienvenido al **Manual de Usuario de Lamassu IoT**. Esta documentación cubre todas las funcionalidades de la plataforma para la gestión de identidades digitales en entornos IoT industriales.",{"_7914":375,"_22115":370,"_18751":32898,"_5":22264,"_15096":32888,"_1571":32899},[],"<Card title=\"Gestión de Claves (KMS)\" description=\"Motores criptográficos, generación e importación de claves\" href=\"/docs/manual/servicios-core/kms\" />",{"_7914":376,"_22115":370,"_18751":32901,"_5":22264,"_15096":32888,"_1571":32902},[],"<Card title=\"Entidades de Confianza (CAs)\" description=\"Creación, importación y gestión de Autoridades de Certificación\" href=\"/docs/manual/servicios-core/cas\" />",{"_7914":377,"_22115":370,"_18751":32904,"_5":22264,"_15096":32888,"_1571":32905},[],"<Card title=\"Gestión de Certificados\" description=\"Visualización y revocación de certificados emitidos\" href=\"/docs/manual/servicios-core/certificates\" />",{"_7914":378,"_22115":370,"_18751":32907,"_5":22264,"_15096":32888,"_1571":32908},[],"<Card title=\"Validación de Certificados (VA)\" description=\"Servicios OCSP y CRL\" href=\"/docs/manual/servicios-core/validation\" />",{"_7914":379,"_22115":370,"_18751":32910,"_5":22264,"_15096":32888,"_1571":32911},[],"<Card title=\"Registration Authority (RA)\" description=\"Automatización del ciclo de vida de certificados y protocolo EST\" href=\"/docs/manual/servicios-core/ra\" />",{"_7914":380,"_22115":370,"_18751":32913,"_5":22264,"_15096":32888,"_1571":32914},[],"<Card title=\"Dispositivos e Identidades\" description=\"Gestión de End Entities y ciclo de vida de dispositivos IoT\" href=\"/docs/manual/servicios-core/devices\" />",{"_7914":381,"_22115":370,"_18751":32916,"_5":22264,"_15096":32888,"_1571":32917},[],"<Card title=\"Alertas y Suscripciones\" description=\"Monitorización de eventos y notificaciones\" href=\"/docs/manual/servicios-core/alerts\" />",{"_7914":382,"_22115":370,"_18751":32919,"_5":22264,"_15096":32892,"_1571":32920},[],"<Card title=\"Integración AWS IoT Core\" description=\"Aprovisionamiento de dispositivos en AWS IoT Core\" href=\"/docs/manual/integraciones/aws\" />",{"_7914":383,"_22115":383,"_5":22259,"_1571":32922,"_22272":32923,"_18751":32924,"_15096":383},"Integración con AWS IoT Core",[31781,32880,32893],[],{"_7914":384,"_22115":383,"_18751":32926,"_5":22264,"_15096":383,"_1571":32927},[],"El conector de Lamassu para AWS IoT Core sincroniza las identidades de los dispositivos con la plataforma AWS, gestionando el registro de CAs, el aprovisionamiento de Things y el ciclo de vida de los certificados de forma automática y orientada a eventos.",{"_7914":385,"_22115":383,"_5":22269,"_18751":32929,"_15096":32930,"_1571":32931},[],"/docs/pr-preview/pr-20/manual/integraciones/aws#arquitectura-del-conector","Arquitectura del conector",{"_7914":386,"_22115":383,"_5":22269,"_18751":32933,"_15096":32934,"_1571":32935},[],"/docs/pr-preview/pr-20/manual/integraciones/aws#prerrequisitos","Prerrequisitos",{"_7914":387,"_22115":383,"_5":22269,"_18751":32937,"_15096":32938,"_1571":32939},[],"/docs/pr-preview/pr-20/manual/integraciones/aws#permisos-iam-necesarios","Permisos IAM necesarios",{"_7914":388,"_22115":383,"_5":22269,"_18751":32941,"_15096":32942,"_1571":32943},[],"/docs/pr-preview/pr-20/manual/integraciones/aws#parámetros-de-configuración","Parámetros de configuración",{"_7914":389,"_22115":383,"_5":22269,"_18751":32945,"_15096":32946,"_1571":32947},[],"/docs/pr-preview/pr-20/manual/integraciones/aws#registro-de-la-ca-en-aws-iot-core","Registro de la CA en AWS IoT Core",{"_7914":390,"_22115":383,"_5":22269,"_18751":32949,"_15096":32950,"_1571":32951},[],"/docs/pr-preview/pr-20/manual/integraciones/aws#cómo-solicitar-el-registro","Cómo solicitar el registro",{"_7914":391,"_22115":383,"_5":22269,"_18751":32953,"_15096":32954,"_1571":32955},[],"/docs/pr-preview/pr-20/manual/integraciones/aws#primary-account","Primary Account",{"_7914":392,"_22115":383,"_5":22269,"_18751":32957,"_15096":32958,"_1571":32959},[],"/docs/pr-preview/pr-20/manual/integraciones/aws#secondary-account-sni-only","Secondary Account (SNI-only)",{"_7914":393,"_22115":383,"_5":22269,"_18751":32961,"_15096":32962,"_1571":32963},[],"/docs/pr-preview/pr-20/manual/integraciones/aws#configuración-del-dms","Configuración del DMS",{"_7914":394,"_22115":383,"_5":22269,"_18751":32965,"_15096":32966,"_1571":32967},[],"/docs/pr-preview/pr-20/manual/integraciones/aws#modo-none","Modo `none`",{"_7914":395,"_22115":383,"_5":22269,"_18751":32969,"_15096":32970,"_1571":32971},[],"/docs/pr-preview/pr-20/manual/integraciones/aws#modo-auto","Modo `auto`",{"_7914":396,"_22115":383,"_5":22269,"_18751":32973,"_15096":32974,"_1571":32975},[],"/docs/pr-preview/pr-20/manual/integraciones/aws#modo-jitp","Modo `jitp`",{"_7914":397,"_22115":383,"_5":22269,"_18751":32977,"_15096":32978,"_1571":32979},[],"/docs/pr-preview/pr-20/manual/integraciones/aws#aprovisionamiento-de-dispositivos-modo-automático","Aprovisionamiento de dispositivos (modo automático)",{"_7914":398,"_22115":383,"_5":22269,"_18751":32981,"_15096":32982,"_1571":32983},[],"/docs/pr-preview/pr-20/manual/integraciones/aws#aprovisionamiento-de-dispositivos-modo-jitp","Aprovisionamiento de dispositivos (modo JITP)",{"_7914":399,"_22115":383,"_5":22269,"_18751":32985,"_15096":32986,"_1571":32987},[],"/docs/pr-preview/pr-20/manual/integraciones/aws#sincronización-del-estado-del-certificado","Sincronización del estado del certificado",{"_7914":400,"_22115":383,"_5":22269,"_18751":32989,"_15096":32990,"_1571":32991},[],"/docs/pr-preview/pr-20/manual/integraciones/aws#desconexión-forzada-al-revocar","Desconexión forzada al revocar",{"_7914":401,"_22115":383,"_5":22269,"_18751":32993,"_15096":32994,"_1571":32995},[],"/docs/pr-preview/pr-20/manual/integraciones/aws#device-shadow-y-automatización","Device Shadow y automatización",{"_7914":402,"_22115":383,"_5":22269,"_18751":32997,"_15096":32998,"_1571":32999},[],"/docs/pr-preview/pr-20/manual/integraciones/aws#qué-escribe-el-conector-en-el-shadow","Qué escribe el conector en el shadow",{"_7914":403,"_22115":383,"_5":22269,"_18751":33001,"_15096":33002,"_1571":33003},[],"/docs/pr-preview/pr-20/manual/integraciones/aws#políticas-de-aws-iot","Políticas de AWS IoT",{"_7914":404,"_22115":383,"_5":22269,"_18751":33005,"_15096":33006,"_1571":33007},[],"/docs/pr-preview/pr-20/manual/integraciones/aws#solución-de-problemas","Solución de problemas",{"_7914":405,"_22115":383,"_18751":33009,"_5":22264,"_15096":383,"_1571":33010},[],"La integración de Lamassu con AWS IoT Core cubre el puente entre la PKI gestionada por Lamassu y la plataforma de conectividad de AWS. Cuando un dispositivo obtiene su certificado a través del proceso de enrolamiento EST, el conector se encarga de que ese certificado y la identidad asociada sean reconocidos en AWS IoT Core sin intervención manual. El resultado es que el dispositivo puede autenticarse directamente en AWS con el mismo certificado X.509 que Lamassu emitió.",{"_7914":406,"_22115":383,"_18751":33012,"_5":22264,"_15096":383,"_1571":33013},[],"Desde el punto de vista del protocolo, el dispositivo se autentica ante AWS IoT Core mediante TLS mutuo (mTLS): presenta su certificado X.509 emitido por Lamassu como certificado de cliente, y AWS IoT Core verifica la cadena de certificados hasta llegar a la CA registrada en la cuenta. Lamassu actúa como autoridad de certificación (CA); el conector se encarga de que esa CA esté registrada en AWS y de que el certificado del dispositivo sea conocido por la plataforma antes de que el dispositivo intente conectarse (en modo `auto`) o en su primera conexión (en modo JITP).",{"_7914":407,"_22115":383,"_18751":33015,"_5":22264,"_15096":383,"_1571":33016},[],"Este documento está dirigido tanto al administrador PKI, que necesita configurar el conector y registrar las CAs, como al desarrollador de firmware de dispositivos, que necesita entender cómo se nombran los Things, cómo funciona el Device Shadow y qué ocurre cuando un certificado se revoca. Para el desarrollador de firmware, el dato más importante es que el **nombre del Thing en AWS (ThingName) corresponde siempre al Common Name (CN) del certificado emitido por Lamassu**, independientemente del modo de aprovisionamiento.",{"_7914":408,"_22115":383,"_18751":33018,"_5":22264,"_15096":32930,"_1571":33019},[],"El conector de AWS IoT Core es un proceso Go independiente, un binario o contenedor separado del núcleo de Lamassu. En un despliegue monolítico se compila por defecto (etiqueta de compilación `!noaws`) y se activa mediante `aws_iot_manager.enabled: true` en el fichero de configuración. En despliegues distribuidos, se ejecuta como un contenedor propio con acceso a los servicios de CA, DMS Manager y Device Manager de Lamassu a través de HTTP.",{"_7914":409,"_22115":383,"_18751":33021,"_5":22264,"_15096":32930,"_1571":33022},[],"El conector no sondea los servicios de Lamassu periódicamente. En su lugar, **se suscribe al bus de eventos interno** de Lamassu (AMQP o AWS SQS/SNS, configurable) y reacciona a los eventos que le interesan: creación o actualización de CAs, creación o actualización de DMS, vinculación de identidad de dispositivo, cambio de estado de certificado, actualización de metadatos de certificado y actualización de metadatos de dispositivo. Este modelo orientado a eventos garantiza que la sincronización con AWS sea casi inmediata y no genere carga de sondeo.",{"_7914":410,"_22115":383,"_18751":33024,"_5":22264,"_15096":32930,"_1571":33025},[],"Para evitar bucles infinitos, el conector ignora cualquier evento cuyo campo `source` de CloudEvent coincida con su propia URI de origen. Esto previene que las escrituras de metadatos que el propio conector realiza vuelvan a disparar el mismo flujo.",{"_7914":411,"_22115":383,"_18751":33027,"_5":22264,"_15096":32930,"_1571":33028},[],"Cuando se ejecutan varios conectores en paralelo, por ejemplo, para distintas cuentas de AWS, cada instancia tiene su propio `connector_id`. Todos los metadatos que el conector escribe en Lamassu se almacenan bajo la clave `lamassu.io/iot/{connector_id}`, lo que permite coexistencia sin colisiones.",{"_7914":412,"_22115":383,"_18751":33030,"_5":22264,"_15096":32934,"_1571":33031},[],"Antes de activar el conector es necesario disponer de una cuenta AWS con los permisos IAM adecuados y tener el conector correctamente configurado. El proceso de despliegue (Docker Compose, Kubernetes o binario) se describe en la documentación de despliegue.",{"_7914":413,"_22115":383,"_18751":33033,"_5":22264,"_15096":32938,"_1571":33034},[],"La identidad IAM con la que opera el conector debe tener al mínimo los siguientes permisos sobre los recursos de la cuenta destino:",{"_7914":414,"_22115":383,"_18751":33036,"_5":22264,"_15096":32938,"_1571":33037},[],"Acción IAM",{"_7914":415,"_22115":383,"_18751":33039,"_5":22264,"_15096":32938,"_1571":33040},[],"Propósito",{"_7914":416,"_22115":383,"_18751":33042,"_5":22264,"_15096":32938,"_1571":33043},[],"`iot:GetRegistrationCode`",{"_7914":417,"_22115":383,"_18751":33045,"_5":22264,"_15096":32938,"_1571":33046},[],"Obtener el código de verificación para el registro de CA en Primary Account",{"_7914":418,"_22115":383,"_18751":33048,"_5":22264,"_15096":32938,"_1571":33049},[],"`iot:RegisterCACertificate`",{"_7914":419,"_22115":383,"_18751":33051,"_5":22264,"_15096":32938,"_1571":33052},[],"Registrar la CA en AWS IoT",{"_7914":420,"_22115":383,"_18751":33054,"_5":22264,"_15096":32938,"_1571":33055},[],"`iot:DescribeCACertificate`",{"_7914":421,"_22115":383,"_18751":33057,"_5":22264,"_15096":32938,"_1571":33058},[],"Consultar el estado del registro de la CA",{"_7914":422,"_22115":383,"_18751":33060,"_5":22264,"_15096":32938,"_1571":33061},[],"`iot:CreateThing` / `iot:UpdateThing`",{"_7914":423,"_22115":383,"_18751":33063,"_5":22264,"_15096":32938,"_1571":33064},[],"Crear o actualizar Things en IoT Core",{"_7914":424,"_22115":383,"_18751":33066,"_5":22264,"_15096":32938,"_1571":33067},[],"`iot:RegisterThing`",{"_7914":425,"_22115":383,"_18751":33069,"_5":22264,"_15096":32938,"_1571":33070},[],"Aprovisionar Things mediante plantilla",{"_7914":426,"_22115":383,"_18751":33072,"_5":22264,"_15096":32938,"_1571":33073},[],"`iot:RegisterCertificate`",{"_7914":427,"_22115":383,"_18751":33075,"_5":22264,"_15096":32938,"_1571":33076},[],"Registrar certificados de dispositivo",{"_7914":428,"_22115":383,"_18751":33078,"_5":22264,"_15096":32938,"_1571":33079},[],"`iot:UpdateCertificate`",{"_7914":429,"_22115":383,"_18751":33081,"_5":22264,"_15096":32938,"_1571":33082},[],"Cambiar el estado de un certificado (ACTIVE / INACTIVE / REVOKED)",{"_7914":430,"_22115":383,"_18751":33084,"_5":22264,"_15096":32938,"_1571":33085},[],"`iot:CreatePolicy` / `iot:AttachPolicy`",{"_7914":431,"_22115":383,"_18751":33087,"_5":22264,"_15096":32938,"_1571":33088},[],"Crear y adjuntar políticas IoT",{"_7914":432,"_22115":383,"_18751":33090,"_5":22264,"_15096":32938,"_1571":33091},[],"`iot:CreateThingGroup` / `iot:AddThingToThingGroup`",{"_7914":433,"_22115":383,"_18751":33093,"_5":22264,"_15096":32938,"_1571":33094},[],"Gestionar grupos de Things",{"_7914":434,"_22115":383,"_18751":33096,"_5":22264,"_15096":32938,"_1571":33097},[],"`iot:CreateProvisioningTemplate`",{"_7914":435,"_22115":383,"_18751":33099,"_5":22264,"_15096":32938,"_1571":33100},[],"Crear plantillas JITP",{"_7914":436,"_22115":383,"_18751":33102,"_5":22264,"_15096":32938,"_1571":33103},[],"`iotdata:GetThingShadow` / `iotdata:UpdateThingShadow`",{"_7914":437,"_22115":383,"_18751":33105,"_5":22264,"_15096":32938,"_1571":33106},[],"Leer y escribir el Device Shadow",{"_7914":438,"_22115":383,"_18751":33108,"_5":22264,"_15096":32938,"_1571":33109},[],"Para el mecanismo de desconexión forzada tras revocación también se requiere acceso a la API del plano de datos de AWS IoT (`iot:Connect` con SigV4 sobre WebSocket), que se negocia de forma implícita con las credenciales del conector.",{"_7914":439,"_22115":383,"_18751":33111,"_5":22264,"_15096":32942,"_1571":33112},[],"Parámetro",{"_7914":440,"_22115":383,"_18751":33114,"_5":22264,"_15096":32942,"_1571":33115},[],"Tipo",{"_7914":441,"_22115":383,"_18751":33117,"_5":22264,"_15096":32942,"_1571":33118},[],"Requerido",{"_7914":442,"_22115":383,"_18751":33120,"_5":22264,"_15096":32942,"_1571":31984},[],{"_7914":443,"_22115":383,"_18751":33122,"_5":22264,"_15096":32942,"_1571":33123},[],"`connector_id`",{"_7914":444,"_22115":383,"_18751":33125,"_5":22264,"_15096":32942,"_1571":11523},[],{"_7914":445,"_22115":383,"_18751":33127,"_5":22264,"_15096":32942,"_1571":33128},[],"Sí",{"_7914":446,"_22115":383,"_18751":33130,"_5":22264,"_15096":32942,"_1571":33131},[],"Identificador único de esta instancia del conector. Se usa como espacio de nombres para los metadatos: `lamassu.io/iot/{connector_id}`.",{"_7914":447,"_22115":383,"_18751":33133,"_5":22264,"_15096":32942,"_1571":33134},[],"`aws_config.region`",{"_7914":448,"_22115":383,"_18751":33136,"_5":22264,"_15096":32942,"_1571":11523},[],{"_7914":449,"_22115":383,"_18751":33138,"_5":22264,"_15096":32942,"_1571":33128},[],{"_7914":450,"_22115":383,"_18751":33140,"_5":22264,"_15096":32942,"_1571":33141},[],"Región AWS donde opera el conector.",{"_7914":451,"_22115":383,"_18751":33143,"_5":22264,"_15096":32942,"_1571":33144},[],"`aws_config.auth_method`",{"_7914":452,"_22115":383,"_18751":33146,"_5":22264,"_15096":32942,"_1571":11523},[],{"_7914":453,"_22115":383,"_18751":33148,"_5":22264,"_15096":32942,"_1571":33128},[],{"_7914":454,"_22115":383,"_18751":33150,"_5":22264,"_15096":32942,"_1571":33151},[],"Método de autenticación: `static`, `role` o vacío (cadena de credenciales por defecto del SDK).",{"_7914":455,"_22115":383,"_18751":33153,"_5":22264,"_15096":32942,"_1571":33154},[],"`aws_config.access_key_id`",{"_7914":456,"_22115":383,"_18751":33156,"_5":22264,"_15096":32942,"_1571":11523},[],{"_7914":457,"_22115":383,"_18751":33158,"_5":22264,"_15096":32942,"_1571":33159},[],"Solo con `auth_method=static`",{"_7914":458,"_22115":383,"_18751":33161,"_5":22264,"_15096":32942,"_1571":33162},[],"Clave de acceso AWS.",{"_7914":459,"_22115":383,"_18751":33164,"_5":22264,"_15096":32942,"_1571":33165},[],"`aws_config.secret_access_key`",{"_7914":460,"_22115":383,"_18751":33167,"_5":22264,"_15096":32942,"_1571":11523},[],{"_7914":461,"_22115":383,"_18751":33169,"_5":22264,"_15096":32942,"_1571":33159},[],{"_7914":462,"_22115":383,"_18751":33171,"_5":22264,"_15096":32942,"_1571":33172},[],"Clave secreta AWS.",{"_7914":463,"_22115":383,"_18751":33174,"_5":22264,"_15096":32942,"_1571":33175},[],"`aws_config.session_token`",{"_7914":464,"_22115":383,"_18751":33177,"_5":22264,"_15096":32942,"_1571":11523},[],{"_7914":465,"_22115":383,"_18751":33179,"_5":22264,"_15096":32942,"_1571":33180},[],"No",{"_7914":466,"_22115":383,"_18751":33182,"_5":22264,"_15096":32942,"_1571":33183},[],"Token de sesión (con `auth_method=static`).",{"_7914":467,"_22115":383,"_18751":33185,"_5":22264,"_15096":32942,"_1571":33186},[],"`aws_config.role_arn`",{"_7914":468,"_22115":383,"_18751":33188,"_5":22264,"_15096":32942,"_1571":11523},[],{"_7914":469,"_22115":383,"_18751":33190,"_5":22264,"_15096":32942,"_1571":33191},[],"Solo con `auth_method=role`",{"_7914":470,"_22115":383,"_18751":33193,"_5":22264,"_15096":32942,"_1571":33194},[],"ARN del rol a asumir.",{"_7914":471,"_22115":383,"_18751":33196,"_5":22264,"_15096":32942,"_1571":33197},[],"`aws_config.endpoint_url`",{"_7914":472,"_22115":383,"_18751":33199,"_5":22264,"_15096":32942,"_1571":11523},[],{"_7914":473,"_22115":383,"_18751":33201,"_5":22264,"_15096":32942,"_1571":33180},[],{"_7914":474,"_22115":383,"_18751":33203,"_5":22264,"_15096":32942,"_1571":33204},[],"URL alternativa para todos los servicios AWS (útil con LocalStack en pruebas).",{"_7914":475,"_22115":383,"_18751":33206,"_5":22264,"_15096":32942,"_1571":33207},[],"`subscriber_event_bus`",{"_7914":476,"_22115":383,"_18751":33209,"_5":22264,"_15096":32942,"_1571":19056},[],{"_7914":477,"_22115":383,"_18751":33211,"_5":22264,"_15096":32942,"_1571":33128},[],{"_7914":478,"_22115":383,"_18751":33213,"_5":22264,"_15096":32942,"_1571":33214},[],"Configuración del bus de eventos al que se suscribe el conector (AMQP o AWS SQS/SNS).",{"_7914":479,"_22115":383,"_18751":33216,"_5":22264,"_15096":32942,"_1571":33217},[],"`dms_manager_client`",{"_7914":480,"_22115":383,"_18751":33219,"_5":22264,"_15096":32942,"_1571":11523},[],{"_7914":481,"_22115":383,"_18751":33221,"_5":22264,"_15096":32942,"_1571":33128},[],{"_7914":482,"_22115":383,"_18751":33223,"_5":22264,"_15096":32942,"_1571":33224},[],"URL HTTP del servicio DMS Manager de Lamassu.",{"_7914":483,"_22115":383,"_18751":33226,"_5":22264,"_15096":32942,"_1571":33227},[],"`device_manager_client`",{"_7914":484,"_22115":383,"_18751":33229,"_5":22264,"_15096":32942,"_1571":11523},[],{"_7914":485,"_22115":383,"_18751":33231,"_5":22264,"_15096":32942,"_1571":33128},[],{"_7914":486,"_22115":383,"_18751":33233,"_5":22264,"_15096":32942,"_1571":33234},[],"URL HTTP del Device Manager de Lamassu.",{"_7914":487,"_22115":383,"_18751":33236,"_5":22264,"_15096":32942,"_1571":33237},[],"`ca_client`",{"_7914":488,"_22115":383,"_18751":33239,"_5":22264,"_15096":32942,"_1571":11523},[],{"_7914":489,"_22115":383,"_18751":33241,"_5":22264,"_15096":32942,"_1571":33128},[],{"_7914":490,"_22115":383,"_18751":33243,"_5":22264,"_15096":32942,"_1571":33244},[],"URL HTTP del servicio de CA de Lamassu.",{"_7914":491,"_22115":383,"_18751":33246,"_5":22264,"_15096":32946,"_1571":33247},[],"Para que los dispositivos puedan autenticarse en AWS IoT Core con certificados emitidos por una CA de Lamassu, esa CA debe registrarse previamente en la cuenta AWS. El conector gestiona este registro de forma automática en respuesta a los eventos `EventCreateCAKey`, `EventImportCAKey` y `EventUpdateCAMetadataKey`, pero la operación **solo se dispara cuando el administrador la solicita explícitamente** mediante el campo de metadatos de la CA.",{"_7914":492,"_22115":383,"_18751":33249,"_5":22264,"_15096":32950,"_1571":33250},[],"El registro se desencadena estableciendo el valor `registration.status = \"REQUESTED\"` en la clave `lamassu.io/iot/{connector_id}` de los metadatos de la CA. Esto puede hacerse desde la consola de Lamassu en la sección de gestión de la CA o mediante la API.",{"_7914":493,"_22115":383,"_18751":33252,"_5":22264,"_15096":32950,"_1571":33253},[],"Una vez recibido el evento, el conector intenta registrar la CA en AWS y actualiza el campo `registration.status` en los metadatos de la CA con el resultado: `\"SUCCEEDED\"` si el registro fue correcto, o `\"FAILED\"` acompañado de un mensaje de error en caso contrario. El proceso es asíncrono, por lo que es necesario consultar periódicamente el estado de los metadatos hasta que la operación concluya.",{"_7914":494,"_22115":383,"_18751":33255,"_5":22264,"_15096":32954,"_1571":33256},[],"Cuando el parámetro `primary_account` es `true`, el conector ejecuta el flujo completo de registro con verificación de posesión de clave privada:",{"_7914":495,"_22115":383,"_18751":33258,"_5":22264,"_15096":32954,"_1571":33259},[],"Llama a `iot:GetRegistrationCode` para obtener el código de verificación de AWS.",{"_7914":496,"_22115":383,"_18751":33261,"_5":22264,"_15096":32954,"_1571":33262},[],"El conector genera internamente un par de claves RSA-2048 efímero y construye un CSR cuyo Common Name es exactamente ese código de registro. A continuación llama al servicio de firma de Lamassu para que la CA registrada emita un certificado de verificación X.509 real firmando ese CSR. La clave privada efímera se usa únicamente para este propósito y no se almacena ni se envía a AWS.",{"_7914":497,"_22115":383,"_18751":33264,"_5":22264,"_15096":32954,"_1571":33265},[],"Envía a AWS la CA (en PEM) y el certificado de verificación mediante `iot:RegisterCACertificate`, activando el registro con `AllowAutoRegistration: true`.",{"_7914":498,"_22115":383,"_18751":33267,"_5":22264,"_15096":32954,"_1571":33268},[],"Solo una cuenta puede ser propietaria de una CA en una región AWS dada. Si la CA ya está registrada con el mismo número de serie, el conector omite el paso silenciosamente.",{"_7914":499,"_22115":383,"_18751":33270,"_5":22264,"_15096":32954,"_1571":33271},[],"Los tags que AWS IoT Core aplica al certificado de CA registrado son `LMS.CA.ID`, `LMS.CA.SN` y `LMS.CA.CN`.",{"_7914":500,"_22115":383,"_18751":33273,"_5":22264,"_15096":32958,"_1571":33274},[],"Cuando `primary_account` es `false`, el conector registra la CA usando el modo `CertificateMode: SNI_ONLY`. Este modo no requiere código de verificación ni acceso a la clave privada de la CA, por lo que es la opción adecuada cuando la CA se gestiona desde otra cuenta de AWS o cuando el administrador no dispone de la clave privada. Es el método habitual para registrar la misma CA en varias cuentas de AWS simultáneamente.",{"_7914":501,"_22115":383,"_18751":33276,"_5":22264,"_15096":32962,"_1571":33277},[],"Cada DMS que participe en la integración con AWS IoT Core debe tener configurada la clave de metadatos `lamassu.io/iot/{connector_id}`. El campo más importante de esa configuración es `registration_mode`, que determina cómo se aprovisionan los dispositivos en AWS.",{"_7914":502,"_22115":383,"_18751":33279,"_5":22264,"_15096":32962,"_1571":33280},[],"Existen tres modos de registro, y la elección entre ellos depende de la estrategia de aprovisionamiento de la flota.",{"_7914":503,"_22115":383,"_18751":33282,"_5":22264,"_15096":32966,"_1571":33283},[],"En este modo el conector **no crea Things, grupos ni políticas** en AWS IoT Core. Se limita a sincronizar el estado de los certificados (activo, revocado, suspendido) a medida que cambian en Lamassu. Es el modo adecuado cuando el aprovisionamiento de Things en AWS se gestiona por un sistema externo y solo se necesita que Lamassu mantenga el estado de los certificados actualizado.",{"_7914":504,"_22115":383,"_18751":33285,"_5":22264,"_15096":32970,"_1571":33286},[],"El modo `auto` delega en Lamassu el aprovisionamiento completo del dispositivo en AWS en el momento del enrolamiento. Cuando el dispositivo completa con éxito su enrolamiento EST y Lamassu emite el evento `EventBindDeviceIdentityKey`, el conector ejecuta automáticamente la siguiente secuencia:",{"_7914":505,"_22115":383,"_18751":33288,"_5":22264,"_15096":32970,"_1571":33289},[],"Crea o actualiza las políticas IoT configuradas en el DMS.",{"_7914":506,"_22115":383,"_18751":33291,"_5":22264,"_15096":32970,"_1571":33292},[],"Crea el grupo raíz `LAMASSU` en la cuenta AWS (si no existe) y los grupos hijos configurados en el DMS como subgrupos de `LAMASSU`. Si los grupos ya existen, el error `ResourceAlreadyExistsException` se ignora, por lo que la operación es idempotente.",{"_7914":507,"_22115":383,"_18751":33294,"_5":22264,"_15096":32970,"_1571":33295},[],"Si el Thing ya existía en AWS IoT Core, el conector itera todos los certificados (principals) actualmente adjuntos a ese Thing y los marca como `REVOKED` en AWS, para garantizar que los certificados anteriores no puedan seguir siendo usados para autenticarse.",{"_7914":508,"_22115":383,"_18751":33297,"_5":22264,"_15096":32970,"_1571":33298},[],"Llama a `iot:RegisterThing` con una plantilla de aprovisionamiento de estilo CloudFormation que crea el Thing, registra el certificado del dispositivo (PEM del certificado del dispositivo y del certificado de la CA emisora) y adjunta las políticas configuradas.\nUna vez completado el aprovisionamiento, el conector almacena el ARN del certificado resultante en los metadatos del certificado de Lamassu bajo la clave `lamassu.io/iot/{connector_id}` y marca el dispositivo como `Registered: true` en Device Manager.",{"_7914":509,"_22115":383,"_18751":33300,"_5":22264,"_15096":32970,"_1571":33301},[],"**El nombre del Thing en AWS es el Common Name (CN) del certificado del dispositivo.** Esta convención es fundamental para el desarrollador de firmware: el valor `/CN=` que el dispositivo incluye en su CSR al enrolarse se convierte en el ThingName con el que deberá identificarse en todas las operaciones MQTT contra AWS IoT Core.",{"_7914":510,"_22115":383,"_18751":33303,"_5":22264,"_15096":32974,"_1571":33304},[],"El modo Just-In-Time Provisioning (JITP) delega el aprovisionamiento en AWS en lugar de hacerlo el conector directamente. Cuando el conector detecta que el DMS está en modo `jitp`, crea una plantilla de aprovisionamiento JITP en AWS IoT Core y la adjunta al certificado de CA registrado. Esta plantilla se crea o actualiza en el momento en que el DMS se crea o actualiza en Lamassu - no en el momento del enrolamiento del dispositivo. A partir de ese momento, cuando un dispositivo con un certificado emitido por esa CA se conecta por primera vez a AWS IoT Core, AWS ejecuta la plantilla automáticamente: crea el Thing, registra el certificado y lo activa.",{"_7914":511,"_22115":383,"_18751":33306,"_5":22264,"_15096":32974,"_1571":33307},[],"El nombre del Thing en la plantilla JITP se deriva de `AWS::IoT::Certificate::CommonName`, que corresponde al CN del certificado del dispositivo - la misma convención que el modo `auto`.",{"_7914":512,"_22115":383,"_18751":33309,"_5":22264,"_15096":32974,"_1571":33310},[],"Este modo requiere que se configure el campo `jitp_config.provisioning_role_arn` con el ARN de un rol IAM que AWS IoT Core pueda asumir para ejecutar la plantilla. Si no se configura, el conector utiliza el valor por defecto `arn:aws:iam::{account}:role/JITPRole` y registra un aviso en el log. El administrador debe asegurarse de que ese rol existe en la cuenta y tiene los permisos necesarios antes de activar el modo JITP.",{"_7914":513,"_22115":383,"_18751":33312,"_5":22264,"_15096":32978,"_1571":33313},[],"Para el desarrollador de firmware, el modo `auto` es transparente: el dispositivo realiza su enrolamiento EST de la forma habitual y, como efecto secundario, queda aprovisionado en AWS IoT Core sin ningún paso adicional.",{"_7914":514,"_22115":383,"_18751":33315,"_5":22264,"_15096":32978,"_1571":33316},[],"El flujo completo desde el punto de vista del dispositivo es el siguiente:",{"_7914":515,"_22115":383,"_18751":33318,"_5":22264,"_15096":32978,"_1571":33319},[],"Una vez que el conector completa el aprovisionamiento, el dispositivo puede conectarse al endpoint AWS IoT Core de MQTT usando su clave privada y el certificado emitido por Lamassu. El ThingName con el que debe identificarse en AWS es exactamente el CN del certificado.",{"_7914":516,"_22115":383,"_18751":33321,"_5":22264,"_15096":32982,"_1571":33322},[],"En el modo JITP el dispositivo también realiza su enrolamiento EST de forma convencional y obtiene su certificado de Lamassu. La diferencia es que AWS IoT Core no conoce al dispositivo hasta que este intenta conectarse por primera vez.",{"_7914":517,"_22115":383,"_18751":33324,"_5":22264,"_15096":32982,"_1571":33325},[],"Cuando el dispositivo establece su primera conexión MQTT a AWS IoT Core presentando el certificado emitido por Lamassu, AWS detecta que el certificado pertenece a una CA registrada con una plantilla JITP, ejecuta esa plantilla y crea el Thing automáticamente. La conexión inicial puede fallar o demorarse mientras se ejecuta la plantilla; el firmware debe estar preparado para reintentar la conexión.",{"_7914":518,"_22115":383,"_18751":33327,"_5":22264,"_15096":32982,"_1571":33328},[],"Para que el flujo JITP funcione correctamente:",{"_7914":519,"_22115":383,"_18751":33330,"_5":22264,"_15096":32982,"_1571":33331},[],"La CA debe estar registrada en AWS en modo Primary Account (el modo SNI-only no admite JITP).",{"_7914":520,"_22115":383,"_18751":33333,"_5":22264,"_15096":32982,"_1571":33334},[],"El rol IAM configurado en `jitp_config.provisioning_role_arn` debe existir y tener permisos para crear Things, registrar certificados y adjuntar políticas en la cuenta AWS.",{"_7914":521,"_22115":383,"_18751":33336,"_5":22264,"_15096":32982,"_1571":33337},[],"El dispositivo debe presentar tanto su certificado como el certificado de la CA emisora en el handshake TLS con AWS IoT Core.",{"_7914":522,"_22115":383,"_18751":33339,"_5":22264,"_15096":32982,"_1571":33340},[],"Los certificados aprovisionados mediante JITP **no tienen asociada la clave de metadatos del conector** (`lamassu.io/iot/{connector_id}`) en Lamassu. Como consecuencia, los cambios de estado de esos certificados en Lamassu no se sincronizan automáticamente con AWS a través del mecanismo de sincronización de estado descrito en la siguiente sección.",{"_7914":523,"_22115":383,"_18751":33342,"_5":22264,"_15096":32986,"_1571":33343},[],"El conector escucha el evento `EventUpdateCertificateStatusKey` y, cuando un certificado que tiene la clave de metadatos del conector cambia de estado en Lamassu, replica ese cambio en AWS IoT Core. La tabla siguiente muestra la correspondencia de estados:",{"_7914":524,"_22115":383,"_18751":33345,"_5":22264,"_15096":32986,"_1571":33346},[],"Estado en Lamassu",{"_7914":525,"_22115":383,"_18751":33348,"_5":22264,"_15096":32986,"_1571":33349},[],"Razón de revocación",{"_7914":526,"_22115":383,"_18751":33351,"_5":22264,"_15096":32986,"_1571":33352},[],"Estado en AWS IoT Core",{"_7914":527,"_22115":383,"_18751":33354,"_5":22264,"_15096":32986,"_1571":33355},[],"`Active`",{"_7914":528,"_22115":383,"_18751":33357,"_5":22264,"_15096":32986,"_1571":33358},[],"—",{"_7914":529,"_22115":383,"_18751":33360,"_5":22264,"_15096":32986,"_1571":33361},[],"`ACTIVE`",{"_7914":530,"_22115":383,"_18751":33363,"_5":22264,"_15096":32986,"_1571":33364},[],"`Revoked`",{"_7914":531,"_22115":383,"_18751":33366,"_5":22264,"_15096":32986,"_1571":33367},[],"`certificateHold`",{"_7914":532,"_22115":383,"_18751":33369,"_5":22264,"_15096":32986,"_1571":33370},[],"`INACTIVE`",{"_7914":533,"_22115":383,"_18751":33372,"_5":22264,"_15096":32986,"_1571":33364},[],{"_7914":534,"_22115":383,"_18751":33374,"_5":22264,"_15096":32986,"_1571":33375},[],"Cualquier otra razón",{"_7914":535,"_22115":383,"_18751":33377,"_5":22264,"_15096":32986,"_1571":33378},[],"`REVOKED`",{"_7914":536,"_22115":383,"_18751":33380,"_5":22264,"_15096":32986,"_1571":33381},[],"Solo los estados `Active` y `Revoked` producen una llamada a `iot:UpdateCertificate`. Los demás estados del ciclo de vida de Lamassu (`RenewalWindow`, `AboutToExpire`, `Expired`) no se sincronizan con AWS IoT Core; el estado del certificado en AWS permanece sin cambios hasta que el estado en Lamassu sea `Active` o `Revoked`.",{"_7914":537,"_22115":383,"_18751":33383,"_5":22264,"_15096":32990,"_1571":33384},[],"Cuando el conector marca un certificado como `REVOKED` o `INACTIVE` en AWS, ejecuta adicionalmente una desconexión forzada del dispositivo. Para ello abre una conexión MQTT sobre WebSocket (con autenticación SigV4 con las credenciales del conector) al endpoint de datos de AWS IoT Core, usando el CN del certificado como identificador de cliente MQTT, y la cierra inmediatamente. Esto termina cualquier sesión MQTT activa que el dispositivo pueda tener en ese momento.",{"_7914":538,"_22115":383,"_18751":33386,"_5":22264,"_15096":32990,"_1571":33387},[],"Esta desconexión forzada se produce en el momento en que Lamassu registra el cambio de estado. Si el dispositivo vuelve a intentar conectarse tras la desconexión, AWS IoT Core rechazará la conexión porque el certificado ya figura como `REVOKED` o `INACTIVE`.",{"_7914":539,"_22115":383,"_18751":33389,"_5":22264,"_15096":32990,"_1571":33390},[],"Los certificados aprovisionados en modo JITP no disponen de esta sincronización automática, ya que no tienen la clave de metadatos del conector.",{"_7914":540,"_22115":383,"_18751":33392,"_5":22264,"_15096":32994,"_1571":33393},[],"El conector puede escribir en el Device Shadow de AWS IoT Core para enviar señales de acción al firmware del dispositivo. Esta funcionalidad se activa por DMS mediante `shadow_config.enable: true`.",{"_7914":541,"_22115":383,"_18751":33395,"_5":22264,"_15096":32994,"_1571":33396},[],"Si `shadow_config.shadow_name` contiene un valor, el conector usa un Named Shadow con ese nombre; en caso contrario, usa el Classic Shadow (shadow predeterminado del Thing).",{"_7914":542,"_22115":383,"_18751":33398,"_5":22264,"_15096":32998,"_1571":33399},[],"El conector escribe en el campo `desired.identity_actions` del documento shadow. Cada entrada contiene un timestamp Unix en milisegundos. El firmware del dispositivo debe leer este campo y actuar en consecuencia.",{"_7914":543,"_22115":383,"_18751":33401,"_5":22264,"_15096":32998,"_1571":33402},[],"Existen dos tipos de acciones:",{"_7914":544,"_22115":383,"_18751":33404,"_5":22264,"_15096":32998,"_1571":33405},[],"**`UPDATE_CERTIFICATE`**: se escribe cuando la ventana de renovación preventiva de un certificado se activa - es decir, cuando el campo `triggered` de la delta de renovación preventiva pasa de `false` a `true`. Esta acción indica al dispositivo que debe iniciar el proceso de re-enrolamiento para renovar su certificado antes de que expire.",{"_7914":545,"_22115":383,"_18751":33407,"_5":22264,"_15096":32998,"_1571":33408},[],"**`UPDATE_TRUST_ANCHOR_LIST`**: se escribe en todos los dispositivos de un DMS cuando la lista `ManagedCAs` del DMS cambia. Esta acción indica al dispositivo que debe actualizar su almacén de CAs de confianza.",{"_7914":546,"_22115":383,"_18751":33410,"_5":22264,"_15096":32998,"_1571":33411},[],"El proceso de escritura en el shadow consiste en leer el shadow actual (`iotdata:GetThingShadow`), combinar las nuevas acciones con las existentes y escribir el resultado (`iotdata:UpdateThingShadow`). Si el shadow no existe, el conector lo crea. Tras una escritura correcta, la lista de acciones pendientes en los metadatos del dispositivo en Lamassu se limpia.",{"_7914":547,"_22115":383,"_18751":33413,"_5":22264,"_15096":33002,"_1571":33414},[],"El conector crea y adjunta las políticas que se configuran en el DMS. Una política típica para un dispositivo que usa MQTT y Device Shadow tiene la siguiente estructura:",{"_7914":548,"_22115":383,"_18751":33416,"_5":22264,"_15096":33002,"_1571":33417},[],"En la política anterior, los marcadores `<AWS_REGION>` y `<AWS_ACCOUNT_ID>` deben reemplazarse por la región AWS y el identificador de cuenta de doce dígitos de la cuenta destino antes de aplicar la política. La variable `${iot:Connection.Thing.ThingName}` limita automáticamente cada permiso al Thing al que el dispositivo está conectado, siguiendo el principio de mínimo privilegio. La variable `${ShadowName}` en los ARN de shadow es un marcador que debe reemplazarse con el valor de `shadow_config.shadow_name` configurado en el DMS; si se usa el Classic Shadow, se puede simplificar eliminando el segmento `name/${ShadowName}/`. Las políticas de AWS IoT no admiten expresiones regulares con alternancia; la notación `[name/${ShadowName}/]*` representa la opcionalidad del segmento dentro de las restricciones de la sintaxis de ARN.",{"_7914":549,"_22115":383,"_18751":33419,"_5":22264,"_15096":33002,"_1571":33420},[],"El primer statement permite que el dispositivo se conecte usando su ThingName como identificador MQTT. El segundo autoriza la publicación en el topic MQTT genérico del Thing y en los topics del shadow, necesario para que el dispositivo pueda actualizar el estado reportado. Los dos últimos statements otorgan permisos de suscripción y recepción sobre los mismos topics, lo que permite al dispositivo recibir actualizaciones del shadow (por ejemplo, las acciones `UPDATE_CERTIFICATE` y `UPDATE_TRUST_ANCHOR_LIST` escritas por el conector).",{"_7914":550,"_22115":383,"_18751":33422,"_5":22264,"_15096":33006,"_1571":33423},[],"**Síntoma:** El registro de la CA permanece indefinidamente en estado `REQUESTED`.",{"_7914":551,"_22115":383,"_18751":33425,"_5":22264,"_15096":33006,"_1571":33426},[],"**Causa:** El conector no está en ejecución o no está suscrito al bus de eventos. También puede indicar credenciales IAM incorrectas, permisos insuficientes o que la clave de metadatos se escribió con un `connector_id` incorrecto.",{"_7914":552,"_22115":383,"_18751":33428,"_5":22264,"_15096":33006,"_1571":33429},[],"**Resolución:** Verificar que el proceso del conector está activo y que los logs no muestran errores de comunicación con AWS. Comprobar que el campo de metadatos se escribió bajo la clave exacta `lamassu.io/iot/{connector_id}`. Si el error persiste, el conector actualizará el estado a `FAILED` con un mensaje descriptivo en los metadatos de la CA.",{"_7914":553,"_22115":383,"_18751":33431,"_5":22264,"_15096":33006,"_1571":33432},[],"**Síntoma:** El estado de un certificado no se sincroniza con AWS tras una revocación.",{"_7914":554,"_22115":383,"_18751":33434,"_5":22264,"_15096":33006,"_1571":33435},[],"**Causa:** Lo más habitual es que el certificado fue aprovisionado en modo JITP. Los certificados JITP no tienen la clave de metadatos del conector y quedan fuera del mecanismo de sincronización de estado. Si el DMS está en modo `auto`, puede indicar que el aprovisionamiento inicial no completó correctamente y el ARN de AWS no se almacenó en los metadatos del certificado.",{"_7914":555,"_22115":383,"_18751":33437,"_5":22264,"_15096":33006,"_1571":33438},[],"**Resolución:** Para certificados JITP, migrar el DMS a modo `auto` y re-aprovisionar los dispositivos afectados. Para certificados en modo `auto`, verificar que el certificado tiene el ARN de AWS almacenado en sus metadatos; si no lo tiene, repetir el aprovisionamiento.",{"_7914":556,"_22115":383,"_18751":33440,"_5":22264,"_15096":33006,"_1571":33441},[],"**Síntoma:** La desconexión forzada no termina la sesión MQTT del dispositivo tras la revocación.",{"_7914":557,"_22115":383,"_18751":33443,"_5":22264,"_15096":33006,"_1571":33444},[],"**Causa:** El dispositivo usa un client ID MQTT diferente al CN del certificado. La desconexión forzada abre una conexión usando el CN como client ID; si el firmware usa otro identificador, la desconexión no afecta a esa sesión.",{"_7914":558,"_22115":383,"_18751":33446,"_5":22264,"_15096":33006,"_1571":33447},[],"**Resolución:** Asegurarse de que el firmware usa exactamente el CN del certificado como identificador de cliente MQTT. Ese CN coincide con el ThingName en AWS IoT Core.",{"_7914":559,"_22115":383,"_18751":33449,"_5":22264,"_15096":33006,"_1571":33450},[],"**Síntoma:** El dispositivo recibe `CLIENT_ID_REJECTED` al conectarse a AWS IoT Core.",{"_7914":560,"_22115":383,"_18751":33452,"_5":22264,"_15096":33006,"_1571":33453},[],"**Causa:** El client ID MQTT no coincide con el ThingName, que es siempre el CN del certificado emitido por Lamassu.",{"_7914":561,"_22115":383,"_18751":33455,"_5":22264,"_15096":33006,"_1571":33456},[],"**Resolución:** Verificar que el firmware usa exactamente el valor del campo CN incluido en el CSR de enrolamiento como identificador de cliente MQTT.",{"_7914":562,"_22115":383,"_18751":33458,"_5":22264,"_15096":33006,"_1571":33459},[],"**Síntoma:** La primera conexión MQTT del dispositivo en modo JITP falla o excede el tiempo de espera.",{"_7914":563,"_22115":383,"_18751":33461,"_5":22264,"_15096":33006,"_1571":33462},[],"**Causa:** Es el comportamiento esperado mientras AWS ejecuta la plantilla JITP en la primera conexión del dispositivo.",{"_7914":564,"_22115":383,"_18751":33464,"_5":22264,"_15096":33006,"_1571":33465},[],"**Resolución:** El firmware debe implementar reintentos con backoff exponencial para la primera conexión. Si el fallo persiste más allá de unos minutos, verificar que el rol IAM configurado en `jitp_config.provisioning_role_arn` existe en la cuenta y tiene permisos para crear Things, registrar certificados y adjuntar políticas.",{"_7914":565,"_22115":383,"_18751":33467,"_5":22264,"_15096":33006,"_1571":33468},[],"**Síntoma:** El Device Shadow no se actualiza cuando debería.",{"_7914":566,"_22115":383,"_18751":33470,"_5":22264,"_15096":33006,"_1571":33471},[],"**Causa:** La función de shadow está desactivada en la configuración del DMS, las credenciales del conector carecen de permisos sobre la API de datos de IoT, o el firmware lee un shadow diferente al configurado.",{"_7914":567,"_22115":383,"_18751":33473,"_5":22264,"_15096":33006,"_1571":33474},[],"**Resolución:** Comprobar que `shadow_config.enable` está a `true` en los metadatos del conector para el DMS correspondiente. Si se usa Named Shadow, verificar que `shadow_config.shadow_name` contiene el nombre correcto y que el firmware lee ese Named Shadow y no el Classic Shadow. Confirmar que las credenciales del conector tienen permisos `iotdata:GetThingShadow` y `iotdata:UpdateThingShadow`.",{"_7914":568,"_22115":383,"_18751":33476,"_5":22264,"_15096":33006,"_1571":33477},[],"<Card title=\"Configurar un DMS\" href=\"/docs/manual/servicios-core/ra\" />",{"_7914":569,"_22115":383,"_18751":33479,"_5":22264,"_15096":33006,"_1571":33480},[],"<Card title=\"Enrolamiento de dispositivos (EST)\" href=\"/docs/manual/servicios-core/est\" />",{"_7914":570,"_22115":383,"_18751":33482,"_5":22264,"_15096":33006,"_1571":33483},[],"<Card title=\"Gestión de certificados\" href=\"/docs/manual/servicios-core/certificates\" />",{"_7914":571,"_22115":571,"_5":22259,"_1571":33485,"_22272":33486,"_18751":33487,"_15096":571},"[Alerts] Alertas y Suscripciones",[31781,32880,32889],[],{"_7914":572,"_22115":571,"_18751":33489,"_5":22264,"_15096":571,"_1571":33490},[],"Monitorización proactiva mediante eventos y suscripciones",{"_7914":573,"_22115":571,"_5":22269,"_18751":33492,"_15096":33493,"_1571":33494},[],"/docs/pr-preview/pr-20/manual/servicios-core/alerts#alertas","Alertas",{"_7914":574,"_22115":571,"_5":22269,"_18751":33496,"_15096":33497,"_1571":33498},[],"/docs/pr-preview/pr-20/manual/servicios-core/alerts#eventos-y-suscripciones","Eventos y Suscripciones",{"_7914":575,"_22115":571,"_5":22269,"_18751":33500,"_15096":33501,"_1571":33502},[],"/docs/pr-preview/pr-20/manual/servicios-core/alerts#gestión-de-suscripciones","Gestión de Suscripciones",{"_7914":576,"_22115":571,"_5":22269,"_18751":33504,"_15096":33505,"_1571":33506},[],"/docs/pr-preview/pr-20/manual/servicios-core/alerts#filtros-y-condiciones","Filtros y condiciones",{"_7914":577,"_22115":571,"_5":22269,"_18751":33508,"_15096":33509,"_1571":33510},[],"/docs/pr-preview/pr-20/manual/servicios-core/alerts#confirmación-de-la-suscripción","Confirmación de la suscripción",{"_7914":578,"_22115":571,"_5":22269,"_18751":33512,"_15096":33513,"_1571":33514},[],"/docs/pr-preview/pr-20/manual/servicios-core/alerts#gestión-de-suscripciones-existentes","Gestión de Suscripciones Existentes",{"_7914":579,"_22115":571,"_5":22269,"_18751":33516,"_15096":33517,"_1571":33518},[],"/docs/pr-preview/pr-20/manual/servicios-core/alerts#catálogo-de-eventos-del-sistema","Catálogo de Eventos del Sistema",{"_7914":580,"_22115":571,"_18751":33520,"_5":22264,"_15096":33493,"_1571":33521},[],"La funcionalidad de **Alertas** en Lamassu IoT es una herramienta avanzada para la monitorización y la observación del estado de la PKI. Va más allá de la simple visualización, permitiendo a los usuarios **reaccionar de forma proactiva y automatizada** a los eventos que ocurren en la infraestructura. Esta capacidad es crucial en entornos de IoT, donde el número de dispositivos y la frecuencia de las operaciones hacen inviable la monitorización manual. A través de la gestión de suscripciones, los administradores pueden asegurarse de que eventos críticos, como la revocación de un certificado o la detección de un intento de registro fallido, no pasen desapercibidos, lo que mejora la seguridad y la resiliencia del sistema.",{"_7914":581,"_22115":571,"_18751":33523,"_5":22264,"_15096":33497,"_1571":33524},[],"La página principal de alertas presenta una lista exhaustiva de todos los **tipos de eventos** que pueden ser generados por la PKI de Lamassu IoT. Estos eventos cubren un amplio espectro de actividades, desde operaciones de ciclo de vida de certificados y dispositivos hasta cambios de estado en las RA. Para cada tipo de evento, la interfaz proporciona un conjunto de métricas clave que facilitan la toma de decisiones:",{"_7914":582,"_22115":571,"_18751":33526,"_5":22264,"_15096":33497,"_1571":33527},[],"**Last Seen**: Muestra cuándo ocurrió la última instancia del evento. Esto ayuda a identificar si un evento es recurrente o si ha ocurrido recientemente, lo cual es fundamental para el diagnóstico.",{"_7914":583,"_22115":571,"_18751":33529,"_5":22264,"_15096":33497,"_1571":33530},[],"**Counter**: Indica el número total de veces que el evento ha sido registrado en el sistema. Un contador alto puede señalar una tendencia, un problema subyacente en un dispositivo o una configuración errónea.",{"_7914":584,"_22115":571,"_18751":33532,"_5":22264,"_15096":33497,"_1571":33533},[],"**Subscriptions**: Informa si ya existen suscripciones activas para ese evento, evitando la creación de suscripciones duplicadas y proporcionando una visión general de la monitorización ya implementada.",{"_7914":585,"_22115":571,"_18751":33535,"_5":22264,"_15096":33497,"_1571":33536},[],"**Actions**: El botón **Subscribe** permite iniciar el proceso de creación de una nueva suscripción, adaptada a las necesidades específicas del usuario o equipo.",{"_7914":586,"_22115":571,"_18751":33538,"_5":22264,"_15096":33497,"_1571":33539},[],"Adicionalmente, al expandir la información de cada evento, se presenta un **ejemplo de la estructura de datos JSON** de la última instancia registrada. Esta información es de gran valor, ya que permite a los desarrolladores y administradores entender con precisión el esquema de la notificación y cómo procesarla en sistemas externos, como un sistema de gestión de incidentes o una aplicación de automatización.",{"_7914":587,"_22115":571,"_18751":33541,"_5":22264,"_15096":33501,"_1571":33542},[],"Para cada evento, se puede crear una suscripción a la que se envían notificaciones cuando el evento ocurre. Este proceso permite a los administradores del sistema personalizar qué eventos monitorizan y cómo son notificados. La configuración de las suscripciones, incluyendo el destino de las notificaciones, se gestiona de forma individual para cada tipo de evento.",{"_7914":588,"_22115":571,"_18751":33544,"_5":22264,"_15096":33501,"_1571":33545},[],"Al pulsar sobre el botón **Subscribe** se abre un modal de configuración que permite seleccionar uno de los tres mecanismos de notificación disponibles en Lamassu IoT.",{"_7914":589,"_22115":571,"_18751":33547,"_5":22264,"_15096":33501,"_1571":33548},[],"**Email Notification**: Envía una notificación por correo electrónico a una dirección específica cada vez que el evento se registra. Para configurar este método, solo es necesario proporcionar la dirección de correo electrónico de destino.",{"_7914":590,"_22115":571,"_18751":33550,"_5":22264,"_15096":33501,"_1571":33551},[],"**Microsoft Teams Webhook**: Utiliza un webhook para enviar una notificación al canal de Microsoft Teams configurado, lo que permite integrar las alertas directamente en los flujos de trabajo de colaboración. Se debe proporcionar un nombre para la suscripción y la URL del webhook de Microsoft Teams.",{"_7914":591,"_22115":571,"_18751":33553,"_5":22264,"_15096":33501,"_1571":33554},[],"**Webhook**: Envía una notificación en formato JSON a una URL de webhook personalizada, lo que permite integrar las alertas con cualquier servicio o aplicación que soporte este protocolo. Para este mecanismo, se debe especificar un nombre, el **Método HTTP** (siempre **POST** o **PUT**) y la URL de destino. El documento JSON del evento se entregará como el cuerpo de la solicitud HTTP.",{"_7914":592,"_22115":571,"_18751":33556,"_5":22264,"_15096":33505,"_1571":33557},[],"Después de seleccionar el mecanismo de notificación, se puede establecer un filtro para determinar las condiciones que deben cumplirse para que el evento sea notificado. Esto permite un control más granular y evita recibir notificaciones irrelevantes. Los formatos de filtro disponibles son:",{"_7914":593,"_22115":571,"_18751":33559,"_5":22264,"_15096":33505,"_1571":33560},[],"**None**: No se aplica ningún filtro. Se enviarán notificaciones para todas las instancias del evento.",{"_7914":594,"_22115":571,"_18751":33562,"_5":22264,"_15096":33505,"_1571":33563},[],"**JSON Path**: Utiliza la sintaxis de JSON Path para evaluar una condición sobre un campo específico del evento JSON.",{"_7914":595,"_22115":571,"_18751":33565,"_5":22264,"_15096":33505,"_1571":33566},[],"**JSON Schema**: Permite aplicar un esquema JSON para validar el evento. Las notificaciones solo se enviarán si el evento cumple con el esquema definido. Esto es útil para asegurar que solo se procesen eventos con un formato de datos esperado y consistente.",{"_7914":596,"_22115":571,"_18751":33568,"_5":22264,"_15096":33505,"_1571":33569},[],"**Javascript**: Permite escribir una función de JavaScript personalizada para evaluar condiciones complejas sobre el evento JSON. Por ejemplo, la función `function (event) { return event.data.status == \"NO_IDENTITY\"; }` podría usarse para notificar solo cuando el estado de un dispositivo cambia a \"No Identity\". Esto ofrece la mayor flexibilidad, ya que se pueden aplicar lógicas avanzadas para filtrar los eventos antes de que se envíen las notificaciones.",{"_7914":597,"_22115":571,"_18751":33571,"_5":22264,"_15096":33509,"_1571":33572},[],"El último paso del proceso es la **confirmación**. Una vez que se ha configurado el canal de notificación y el filtro (si corresponde), la interfaz muestra un resumen de la suscripción. Aquí puedes revisar el tipo de evento, el canal de notificación seleccionado y la condición del filtro antes de confirmar.",{"_7914":598,"_22115":571,"_18751":33574,"_5":22264,"_15096":33509,"_1571":33575},[],"Al hacer clic en **Confirm Subscription**, la suscripción se activa y Lamassu IoT comenzará a enviar notificaciones basadas en la configuración que has establecido.",{"_7914":599,"_22115":571,"_18751":33577,"_5":22264,"_15096":33513,"_1571":33578},[],"Para gestionar una suscripción que ya está activa, simplemente selecciónala en el listado de la página principal de alertas. Al hacerlo, se abrirá un modal de **Subscription Details** que muestra toda la información de la suscripción. Desde esta ventana, se pueden realizar las siguientes acciones:",{"_7914":600,"_22115":571,"_18751":33580,"_5":22264,"_15096":33513,"_1571":33581},[],"**Ver detalles**: Muestra información completa sobre la suscripción, incluyendo su tipo de evento, el canal de notificación, los detalles de contacto (como la dirección de correo electrónico) y las condiciones de filtrado aplicadas.",{"_7914":601,"_22115":571,"_18751":33583,"_5":22264,"_15096":33513,"_1571":33584},[],"**Editar**: Permite modificar la configuración de la suscripción, como el canal de notificación o el filtro.",{"_7914":602,"_22115":571,"_18751":33586,"_5":22264,"_15096":33513,"_1571":33587},[],"**Anular suscripción (Unsubscribe)**: Desactiva y elimina la suscripción. Esta acción es útil cuando una alerta ya no es necesaria.",{"_7914":603,"_22115":571,"_18751":33589,"_5":22264,"_15096":33517,"_1571":33590},[],"La siguiente tabla resume los eventos que pueden ser generados por la plataforma Lamassu IoT, clasificados por el componente que los origina.",{"_7914":604,"_22115":571,"_18751":33592,"_5":22264,"_15096":33517,"_1571":33593},[],"Evento",{"_7914":605,"_22115":571,"_18751":33595,"_5":22264,"_15096":33517,"_1571":31984},[],{"_7914":606,"_22115":571,"_18751":33597,"_5":22264,"_15096":33517,"_1571":33598},[],"**ca.create**",{"_7914":607,"_22115":571,"_18751":33600,"_5":22264,"_15096":33517,"_1571":33601},[],"Creación de una CA",{"_7914":608,"_22115":571,"_18751":33603,"_5":22264,"_15096":33517,"_1571":33604},[],"**ca.import**",{"_7914":609,"_22115":571,"_18751":33606,"_5":22264,"_15096":33517,"_1571":33607},[],"Importación de una CA",{"_7914":610,"_22115":571,"_18751":33609,"_5":22264,"_15096":33517,"_1571":33610},[],"**ca.profile.update**",{"_7914":611,"_22115":571,"_18751":33612,"_5":22264,"_15096":33517,"_1571":33613},[],"Actualización de perfil de CA",{"_7914":612,"_22115":571,"_18751":33615,"_5":22264,"_15096":33517,"_1571":33616},[],"**ca.reissue**",{"_7914":613,"_22115":571,"_18751":33618,"_5":22264,"_15096":33517,"_1571":33619},[],"Reemisión de una CA",{"_7914":614,"_22115":571,"_18751":33621,"_5":22264,"_15096":33517,"_1571":33622},[],"**ca.sign.certificate**",{"_7914":615,"_22115":571,"_18751":33624,"_5":22264,"_15096":33517,"_1571":33625},[],"Firma / emisión de certificado",{"_7914":616,"_22115":571,"_18751":33627,"_5":22264,"_15096":33517,"_1571":33628},[],"**ca.signature.sign**",{"_7914":617,"_22115":571,"_18751":33630,"_5":22264,"_15096":33517,"_1571":33631},[],"Operación de firma criptográfica",{"_7914":618,"_22115":571,"_18751":33633,"_5":22264,"_15096":33517,"_1571":33634},[],"**ca.delete**",{"_7914":619,"_22115":571,"_18751":33636,"_5":22264,"_15096":33517,"_1571":33637},[],"Eliminación de una CA",{"_7914":620,"_22115":571,"_18751":33639,"_5":22264,"_15096":33517,"_1571":33640},[],"**certificate.delete**",{"_7914":621,"_22115":571,"_18751":33642,"_5":22264,"_15096":33517,"_1571":33643},[],"Eliminación de un certificado",{"_7914":622,"_22115":571,"_18751":33645,"_5":22264,"_15096":33517,"_1571":33646},[],"**profile.create**",{"_7914":623,"_22115":571,"_18751":33648,"_5":22264,"_15096":33517,"_1571":33649},[],"Creación de perfil de emisión",{"_7914":624,"_22115":571,"_18751":33651,"_5":22264,"_15096":33517,"_1571":33652},[],"**profile.update**",{"_7914":625,"_22115":571,"_18751":33654,"_5":22264,"_15096":33517,"_1571":33655},[],"Actualización de perfil de emisión",{"_7914":626,"_22115":571,"_18751":33657,"_5":22264,"_15096":33517,"_1571":33658},[],"**profile.delete**",{"_7914":627,"_22115":571,"_18751":33660,"_5":22264,"_15096":33517,"_1571":33661},[],"Eliminación de perfil de emisión",{"_7914":628,"_22115":571,"_18751":33663,"_5":22264,"_15096":33517,"_1571":33664},[],"**dms.create**",{"_7914":629,"_22115":571,"_18751":33666,"_5":22264,"_15096":33517,"_1571":33667},[],"Creación de un DMS",{"_7914":630,"_22115":571,"_18751":33669,"_5":22264,"_15096":33517,"_1571":33670},[],"**dms.update**",{"_7914":631,"_22115":571,"_18751":33672,"_5":22264,"_15096":33517,"_1571":33673},[],"Actualización de un DMS",{"_7914":632,"_22115":571,"_18751":33675,"_5":22264,"_15096":33517,"_1571":33676},[],"**dms.delete**",{"_7914":633,"_22115":571,"_18751":33678,"_5":22264,"_15096":33517,"_1571":33679},[],"Eliminación de un DMS",{"_7914":634,"_22115":571,"_18751":33681,"_5":22264,"_15096":33517,"_1571":33682},[],"**dms.enroll**",{"_7914":635,"_22115":571,"_18751":33684,"_5":22264,"_15096":33517,"_1571":33685},[],"Inscripción (enroll) de dispositivo",{"_7914":636,"_22115":571,"_18751":33687,"_5":22264,"_15096":33517,"_1571":33688},[],"**dms.reenroll**",{"_7914":637,"_22115":571,"_18751":33690,"_5":22264,"_15096":33517,"_1571":33691},[],"Re-inscripción (reenroll) de dispositivo",{"_7914":638,"_22115":571,"_18751":33693,"_5":22264,"_15096":33517,"_1571":33694},[],"**dms.bind-device-id**",{"_7914":639,"_22115":571,"_18751":33696,"_5":22264,"_15096":33517,"_1571":33697},[],"Asociación de identidad a dispositivo",{"_7914":640,"_22115":571,"_18751":33699,"_5":22264,"_15096":33517,"_1571":33700},[],"**device.create**",{"_7914":641,"_22115":571,"_18751":33702,"_5":22264,"_15096":33517,"_1571":33703},[],"Creación de dispositivo",{"_7914":642,"_22115":571,"_18751":33705,"_5":22264,"_15096":33517,"_1571":33706},[],"**device.identity.update**",{"_7914":643,"_22115":571,"_18751":33708,"_5":22264,"_15096":33517,"_1571":33709},[],"Actualización de identidad del dispositivo",{"_7914":644,"_22115":571,"_18751":33711,"_5":22264,"_15096":33517,"_1571":33712},[],"**device.status.update**",{"_7914":645,"_22115":571,"_18751":33714,"_5":22264,"_15096":33517,"_1571":33715},[],"Cambio de estado del dispositivo",{"_7914":646,"_22115":571,"_18751":33717,"_5":22264,"_15096":33517,"_1571":33718},[],"**device.metadata.update**",{"_7914":647,"_22115":571,"_18751":33720,"_5":22264,"_15096":33517,"_1571":33721},[],"Actualización de metadatos del dispositivo",{"_7914":648,"_22115":571,"_18751":33723,"_5":22264,"_15096":33517,"_1571":33724},[],"**device.delete**",{"_7914":649,"_22115":571,"_18751":33726,"_5":22264,"_15096":33517,"_1571":33727},[],"Eliminación de un dispositivo",{"_7914":650,"_22115":571,"_18751":33729,"_5":22264,"_15096":33517,"_1571":33730},[],"**va.role.crl.create**",{"_7914":651,"_22115":571,"_18751":33732,"_5":22264,"_15096":33517,"_1571":33733},[],"Cálculo/creación de CRL",{"_7914":652,"_22115":571,"_18751":33735,"_5":22264,"_15096":33517,"_1571":33736},[],"**kms.create**",{"_7914":653,"_22115":571,"_18751":33738,"_5":22264,"_15096":33517,"_1571":33739},[],"Creación de clave en KMS",{"_7914":654,"_22115":571,"_18751":33741,"_5":22264,"_15096":33517,"_1571":33742},[],"**kms.import**",{"_7914":655,"_22115":571,"_18751":33744,"_5":22264,"_15096":33517,"_1571":33745},[],"Importación de una clave KMS",{"_7914":656,"_22115":571,"_18751":33747,"_5":22264,"_15096":33517,"_1571":33748},[],"**kms.update.metadata**",{"_7914":657,"_22115":571,"_18751":33750,"_5":22264,"_15096":33517,"_1571":33751},[],"Actualización de metadatos de clave KMS",{"_7914":658,"_22115":571,"_18751":33753,"_5":22264,"_15096":33517,"_1571":33754},[],"**kms.update.aliases**",{"_7914":659,"_22115":571,"_18751":33756,"_5":22264,"_15096":33517,"_1571":33757},[],"Actualización de alias de clave KMS",{"_7914":660,"_22115":571,"_18751":33759,"_5":22264,"_15096":33517,"_1571":33760},[],"**kms.update.name**",{"_7914":661,"_22115":571,"_18751":33762,"_5":22264,"_15096":33517,"_1571":33763},[],"Cambio de nombre de una clave KMS",{"_7914":662,"_22115":571,"_18751":33765,"_5":22264,"_15096":33517,"_1571":33766},[],"**kms.update.tags**",{"_7914":663,"_22115":571,"_18751":33768,"_5":22264,"_15096":33517,"_1571":33769},[],"Actualización de etiquetas (tags) de clave KMS",{"_7914":664,"_22115":571,"_18751":33771,"_5":22264,"_15096":33517,"_1571":33772},[],"**kms.delete**",{"_7914":665,"_22115":571,"_18751":33774,"_5":22264,"_15096":33517,"_1571":33775},[],"Eliminación de una clave KMS",{"_7914":666,"_22115":571,"_18751":33777,"_5":22264,"_15096":33517,"_1571":33778},[],"**kms.sign.message**",{"_7914":667,"_22115":571,"_18751":33780,"_5":22264,"_15096":33517,"_1571":33781},[],"Firma de un mensaje con clave KMS",{"_7914":668,"_22115":571,"_18751":33783,"_5":22264,"_15096":33517,"_1571":33784},[],"**kms.verify.signature**",{"_7914":669,"_22115":571,"_18751":33786,"_5":22264,"_15096":33517,"_1571":33787},[],"Verificación de firma con clave KMS",{"_7914":670,"_22115":670,"_5":22259,"_1571":33789,"_22272":33790,"_18751":33791,"_15096":670},"[CA] Gestión de Entidades de Confianza",[31781,32880,32889],[],{"_7914":671,"_22115":670,"_18751":33793,"_5":22264,"_15096":670,"_1571":33794},[],"Creación y gestión de Autoridades de Certificación en Lamassu IoT",{"_7914":672,"_22115":670,"_5":22269,"_18751":33796,"_15096":33797,"_1571":33798},[],"/docs/pr-preview/pr-20/manual/servicios-core/cas#gestión-de-entidades-de-confianza","Gestión de entidades de confianza",{"_7914":673,"_22115":670,"_5":22269,"_18751":33800,"_15096":33801,"_1571":33802},[],"/docs/pr-preview/pr-20/manual/servicios-core/cas#creación-de-entidades-de-certificación","Creación de entidades de certificación",{"_7914":674,"_22115":670,"_5":22269,"_18751":33804,"_15096":33805,"_1571":33806},[],"/docs/pr-preview/pr-20/manual/servicios-core/cas#creación-de-una-nueva-autoridad-de-certificación","Creación de una nueva autoridad de certificación",{"_7914":675,"_22115":670,"_5":22269,"_18751":33808,"_15096":33809,"_1571":33810},[],"/docs/pr-preview/pr-20/manual/servicios-core/cas#creación-de-cas-a-partir-de-claves-del-kms","Creación de CAs a partir de claves del KMS",{"_7914":676,"_22115":670,"_5":22269,"_18751":33812,"_15096":33813,"_1571":33814},[],"/docs/pr-preview/pr-20/manual/servicios-core/cas#importación-de-autoridades-de-certificación","Importación de autoridades de certificación",{"_7914":677,"_22115":670,"_5":22269,"_18751":33816,"_15096":33817,"_1571":33818},[],"/docs/pr-preview/pr-20/manual/servicios-core/cas#operando-con-entidades-de-confianza","Operando con entidades de confianza",{"_7914":678,"_22115":670,"_5":22269,"_18751":33820,"_15096":33821,"_1571":33822},[],"/docs/pr-preview/pr-20/manual/servicios-core/cas#visualización-de-autoridades-de-certificación","Visualización de autoridades de certificación",{"_7914":679,"_22115":670,"_5":22269,"_18751":33824,"_15096":33825,"_1571":33826},[],"/docs/pr-preview/pr-20/manual/servicios-core/cas#emisión-de-certificados","Emisión de certificados",{"_7914":680,"_22115":670,"_5":22269,"_18751":33828,"_15096":33829,"_1571":33830},[],"/docs/pr-preview/pr-20/manual/servicios-core/cas#revocación-de-cas-y-certificados","Revocación de CAs y certificados",{"_7914":681,"_22115":670,"_18751":33832,"_5":22264,"_15096":33801,"_1571":33833},[],"Para acceder a la creación de nuevas entidades certificación se debe acceder la opción de entidades de certificación del menú lateral y luego seleccionar la acción de creación de nueva CA.",{"_7914":682,"_22115":670,"_18751":33835,"_5":22264,"_15096":33801,"_1571":33836},[],"Actualmente hay disponibles 3 acciones:",{"_7914":683,"_22115":670,"_18751":33838,"_5":22264,"_15096":33801,"_1571":33839},[],"**Creación de una nueva autoridad de certificación**, esta acción generará un nuevo par de claves para soportar la nueva autoridad de certificación.",{"_7914":684,"_22115":670,"_18751":33841,"_5":22264,"_15096":33801,"_1571":33842},[],"**Importar una nueva autoridad de certificación generada externamente**, permite importar en Lamassu una autoridad de certificación, cuyo par de claves ha sido generado de manera externa.",{"_7914":685,"_22115":670,"_18751":33844,"_5":22264,"_15096":33801,"_1571":33845},[],"**Importar un certificado de autoridad de certificación sin clave privada**, en este caso se importa la CA para poder usarla en procesos de validación y no como fuente de nuevos certificados gestionados por Lamassu.",{"_7914":686,"_22115":670,"_18751":33847,"_5":22264,"_15096":33805,"_1571":33848},[],"La creación de una Autoridad de Certificación (CA) es un proceso fundamental en el establecimiento de una infraestructura de clave pública (PKI). Lamassu IoT permite provisionar tanto autoridades raíz como intermedias mediante la generación automática de pares de claves criptográficas que son gestionados de forma segura por el sistema integrado de gestión de claves.",{"_7914":687,"_22115":670,"_18751":33850,"_5":22264,"_15096":33805,"_1571":33851},[],"En el formulario de creación se definen los siguientes bloques de configuración.",{"_7914":688,"_22115":670,"_18751":33853,"_5":22264,"_15096":33805,"_1571":33854},[],"**Motor criptográfico**",{"_7914":689,"_22115":670,"_18751":33856,"_5":22264,"_15096":33805,"_1571":33857},[],"**Selector:** Desplegable con motores disponibles, ofrece los configurados en el sistema.",{"_7914":690,"_22115":670,"_18751":33859,"_5":22264,"_15096":33805,"_1571":33860},[],"**Ejemplo mostrado:** go1.24.3",{"_7914":691,"_22115":670,"_18751":33862,"_5":22264,"_15096":33805,"_1571":33863},[],"**Función:** Permite seleccionar el motor criptográfico deseado",{"_7914":692,"_22115":670,"_18751":33865,"_5":22264,"_15096":33805,"_1571":33866},[],"**Parámetros de clave**",{"_7914":693,"_22115":670,"_18751":33868,"_5":22264,"_15096":33805,"_1571":33869},[],"**Key Type:** RSA / EC (Elliptic Curve)",{"_7914":694,"_22115":670,"_18751":33871,"_5":22264,"_15096":33805,"_1571":33872},[],"**Key Size:**",{"_7914":695,"_22115":670,"_18751":33874,"_5":22264,"_15096":33805,"_1571":33875},[],"RSA: 1024, 2048, 3072, 4096 bits",{"_7914":696,"_22115":670,"_18751":33877,"_5":22264,"_15096":33805,"_1571":33878},[],"EC: P-256, P-384, P-521",{"_7914":697,"_22115":670,"_18751":33880,"_5":22264,"_15096":33805,"_1571":33881},[],"**Recomendado:** EC P-384",{"_7914":698,"_22115":670,"_18751":33883,"_5":22264,"_15096":33805,"_1571":33884},[],"**Perfil de emisión del certificado de la CA**",{"_7914":699,"_22115":670,"_18751":33886,"_5":22264,"_15096":33805,"_1571":33887},[],"Aquí se puede seleccionar un perfil existente o definir uno en línea para la operación. Ese perfil permite especificar la duración de la CA que se está creando y los `Key Usage` y `Extended Key Usage` del certificado de soporte.",{"_7914":700,"_22115":670,"_18751":33889,"_5":22264,"_15096":33805,"_1571":33890},[],"Si no se proporciona ningún perfil se aplicará uno por defecto con los usos de clave básicos.",{"_7914":701,"_22115":670,"_18751":33892,"_5":22264,"_15096":33805,"_1571":33893},[],"**Configuración de la CA**",{"_7914":702,"_22115":670,"_18751":33895,"_5":22264,"_15096":33805,"_1571":33896},[],"**Tipo de CA**",{"_7914":703,"_22115":670,"_18751":33898,"_5":22264,"_15096":33805,"_1571":33899},[],"**Root CA:** Autoridad raíz autofirmada",{"_7914":704,"_22115":670,"_18751":33901,"_5":22264,"_15096":33805,"_1571":33902},[],"**Intermediate CA:** Autoridad subordinada",{"_7914":705,"_22115":670,"_18751":33904,"_5":22264,"_15096":33805,"_1571":33905},[],"**Emisor**",{"_7914":706,"_22115":670,"_18751":33907,"_5":22264,"_15096":33805,"_1571":33908},[],"**Root CA:** Self-signed (auto-firmada)",{"_7914":707,"_22115":670,"_18751":33910,"_5":22264,"_15096":33805,"_1571":33911},[],"**Intermediate CA:** Selector desplegable de CA superior disponible",{"_7914":708,"_22115":670,"_18751":33913,"_5":22264,"_15096":33805,"_1571":33914},[],"Permite seleccionar la CA padre que firmará la nueva CA intermedia",{"_7914":709,"_22115":670,"_18751":33916,"_5":22264,"_15096":33805,"_1571":33917},[],"**Identificación**",{"_7914":710,"_22115":670,"_18751":33919,"_5":22264,"_15096":33805,"_1571":33920},[],"**CA ID:** Generado automáticamente (formato UUID),no puede ser modificado. Estos IDs los gestiona el sistema.",{"_7914":711,"_22115":670,"_18751":33922,"_5":22264,"_15096":33805,"_1571":33923},[],"Ejemplo: 8f7c170-c84e-4c08-904f-8d3247c77fc2",{"_7914":712,"_22115":670,"_18751":33925,"_5":22264,"_15096":33805,"_1571":33926},[],"**CA Name:** Nombre descriptivo (obligatorio)",{"_7914":713,"_22115":670,"_18751":33928,"_5":22264,"_15096":33805,"_1571":33929},[],"Ejemplo: Lamassu IoT Secure Services CA",{"_7914":714,"_22115":670,"_18751":33931,"_5":22264,"_15096":33805,"_1571":33932},[],"**Subject Distinguished Name (DN)**",{"_7914":715,"_22115":670,"_18751":33934,"_5":22264,"_15096":33805,"_1571":33935},[],"Campos opcionales:",{"_7914":716,"_22115":670,"_18751":33937,"_5":22264,"_15096":33805,"_1571":33938},[],"**Country (C):** Código país ISO 3166-1 (2 letras)",{"_7914":717,"_22115":670,"_18751":33940,"_5":22264,"_15096":33805,"_1571":33941},[],"Ejemplo: US, ES, DE",{"_7914":718,"_22115":670,"_18751":33943,"_5":22264,"_15096":33805,"_1571":33944},[],"**State/Province (ST):** Estado o provincia",{"_7914":719,"_22115":670,"_18751":33946,"_5":22264,"_15096":33805,"_1571":33947},[],"Ejemplo: California, Madrid",{"_7914":720,"_22115":670,"_18751":33949,"_5":22264,"_15096":33805,"_1571":33950},[],"**Locality (L):** Ciudad o localidad",{"_7914":721,"_22115":670,"_18751":33952,"_5":22264,"_15096":33805,"_1571":33953},[],"Ejemplo: San Francisco, Arrasate",{"_7914":722,"_22115":670,"_18751":33955,"_5":22264,"_15096":33805,"_1571":33956},[],"**Organization (O):** Nombre de la organización",{"_7914":723,"_22115":670,"_18751":33958,"_5":22264,"_15096":33805,"_1571":33959},[],"Ejemplo: Lamassu IoT Corp",{"_7914":724,"_22115":670,"_18751":33961,"_5":22264,"_15096":33805,"_1571":33962},[],"**Organizational Unit (OU):** Unidad organizacional",{"_7914":725,"_22115":670,"_18751":33964,"_5":22264,"_15096":33805,"_1571":33965},[],"Ejemplo: Secure Devices Division",{"_7914":726,"_22115":670,"_18751":33967,"_5":22264,"_15096":33805,"_1571":33968},[],"El \"Certification Authority Name\" configurado se utilizará como Common Name (CN) del subject del certificado de la CA.",{"_7914":727,"_22115":670,"_18751":33970,"_5":22264,"_15096":33805,"_1571":33971},[],"**Configuración de expiración**\nLa configuración de expiración define la validez temporal tanto del certificado de la propia CA como de los certificados que ésta emitirá por defecto. Si se ha seleccionado un perfil se dará prioridad al dato proporcionado en el perfil.",{"_7914":728,"_22115":670,"_18751":33973,"_5":22264,"_15096":33805,"_1571":33974},[],"Para el certificado de la CA (`CA Certificate Expiration`):",{"_7914":729,"_22115":670,"_18751":33976,"_5":22264,"_15096":33805,"_1571":33977},[],"**Función:** Establece la duración de validez del certificado de la Autoridad de Certificación",{"_7914":730,"_22115":670,"_18751":33979,"_5":22264,"_15096":33805,"_1571":33980},[],"**Implicación:** Una vez expirado, la CA no podrá emitir nuevos certificados válidos",{"_7914":731,"_22115":670,"_18751":33982,"_5":22264,"_15096":33805,"_1571":33983},[],"**Duración:** Configurable según necesidades organizacionales",{"_7914":732,"_22115":670,"_18751":33985,"_5":22264,"_15096":33805,"_1571":33986},[],"**Valor por defecto:** 10 años (10y)",{"_7914":733,"_22115":670,"_18751":33988,"_5":22264,"_15096":33805,"_1571":33989},[],"**Consideración:** Debe ser mayor que la duración de los certificados que emitirá",{"_7914":734,"_22115":670,"_18751":33991,"_5":22264,"_15096":33805,"_1571":33992},[],"La expiración de la CA se puede definir como un expresión de duración, fijar una fecha fija, o marcarla como indefinida, lo que en términos prácticos permitirá la emisión de una CA sin caducidad.",{"_7914":735,"_22115":670,"_18751":33994,"_5":22264,"_15096":33805,"_1571":33995},[],"En el caso de expresar una duración, las unidades permitidas son: y (años), w (semanas), d (días), h (horas), m (minutos) y s (segundos), pudiendo componer expresiones como la siguiente: *5y 8w 4d 2h 1m 2s*",{"_7914":736,"_22115":670,"_18751":33997,"_5":22264,"_15096":33805,"_1571":33998},[],"En caso de elegir la opción de fecha específica, se ofrecerá un calendario para seleccionar la fecha de caducidad.",{"_7914":737,"_22115":670,"_18751":34000,"_5":22264,"_15096":33805,"_1571":34001},[],"Para el caso de indefinido, se fijará la fecha de expiración máxima permitida.",{"_7914":738,"_22115":670,"_18751":34003,"_5":22264,"_15096":33805,"_1571":34004},[],"Para la expiración por defecto de certificados finales (`Default End-Entity Certificate Issuance Expiration`):",{"_7914":739,"_22115":670,"_18751":34006,"_5":22264,"_15096":33805,"_1571":34007},[],"**Función:** Define la duración predeterminada para certificados emitidos por esta CA",{"_7914":740,"_22115":670,"_18751":34009,"_5":22264,"_15096":33805,"_1571":34010},[],"**Aplicación:** Se aplica automáticamente a nuevos certificados si no se especifica otra duración",{"_7914":741,"_22115":670,"_18751":34012,"_5":22264,"_15096":33805,"_1571":34013},[],"**Flexibilidad:** Puede ser modificada individualmente al emitir cada certificado",{"_7914":742,"_22115":670,"_18751":34015,"_5":22264,"_15096":33805,"_1571":34016},[],"**Valor por defecto:** 1 año (1y)",{"_7914":743,"_22115":670,"_18751":34018,"_5":22264,"_15096":33805,"_1571":34019},[],"Se expresa en los mismos términos que la caducidad de la CA.",{"_7914":744,"_22115":670,"_18751":34021,"_5":22264,"_15096":33805,"_1571":34022},[],"Una vez creada la CA debe ser visible en el listado de CAs del sistema.",{"_7914":745,"_22115":670,"_18751":34024,"_5":22264,"_15096":33809,"_1571":34025},[],"Lamassu IoT permite la creación de CAs a partir de claves previamente generadas o importadas en el servicio KMS. Una vez seleccionada la opción &#x2A;*Create New CA (Existing Key)** se muestra el formulario de creación de CAs con los siguientes elementos diferenciales respecto a la creación de la CA a partir de un nuevo par de claves descrito en el punto anterior.",{"_7914":746,"_22115":670,"_18751":34027,"_5":22264,"_15096":33809,"_1571":34028},[],"En este caso, primero se solicita la selección de la clave de soporte para esta nueva CA.",{"_7914":747,"_22115":670,"_18751":34030,"_5":22264,"_15096":33809,"_1571":34031},[],"Se abre un popup que permite al usuario seleccionar la clave deseada de entre las disponibles en el KMS. Una vez seleccionada la clave, el proceso continúa como se describe en el punto anterior.",{"_7914":748,"_22115":670,"_18751":34033,"_5":22264,"_15096":33813,"_1571":34034},[],"La importación de entidades de certificación permite importar en el sistema una CA que ha sido generada de manera externa. Para ello se sigue el siguiente proceso:",{"_7914":749,"_22115":670,"_18751":34036,"_5":22264,"_15096":33813,"_1571":34037},[],"Se debe seleccionar el motor que gestionará el par de claves importado.",{"_7914":750,"_22115":670,"_18751":34039,"_5":22264,"_15096":33813,"_1571":33857},[],{"_7914":751,"_22115":670,"_18751":34041,"_5":22264,"_15096":33813,"_1571":33860},[],{"_7914":752,"_22115":670,"_18751":34043,"_5":22264,"_15096":33813,"_1571":33863},[],{"_7914":753,"_22115":670,"_18751":34045,"_5":22264,"_15096":33813,"_1571":34046},[],"También se define la expiración por defecto de certificados finales (`Default End-Entity Certificate Issuance Expiration`):",{"_7914":754,"_22115":670,"_18751":34048,"_5":22264,"_15096":33813,"_1571":34007},[],{"_7914":755,"_22115":670,"_18751":34050,"_5":22264,"_15096":33813,"_1571":34010},[],{"_7914":756,"_22115":670,"_18751":34052,"_5":22264,"_15096":33813,"_1571":34013},[],{"_7914":757,"_22115":670,"_18751":34054,"_5":22264,"_15096":33813,"_1571":34016},[],{"_7914":758,"_22115":670,"_18751":34056,"_5":22264,"_15096":33813,"_1571":34019},[],{"_7914":759,"_22115":670,"_18751":34058,"_5":22264,"_15096":33813,"_1571":34059},[],"Se debe proporcionar de manera obligatoria:",{"_7914":760,"_22115":670,"_18751":34061,"_5":22264,"_15096":33813,"_1571":34062},[],"Certificado de la CA en formato PEM. Se comprueba que el certificado importado corresponda con el de una CA.",{"_7914":761,"_22115":670,"_18751":34064,"_5":22264,"_15096":33813,"_1571":34065},[],"Clave privada de la CA en formato PEM",{"_7914":762,"_22115":670,"_18751":34067,"_5":22264,"_15096":33813,"_1571":34068},[],"De manera opcional se proporcionarán en formato PEM la cadena de certificados de la cadena de validación en caso de importar una CA subordinada.",{"_7914":763,"_22115":670,"_18751":34070,"_5":22264,"_15096":33821,"_1571":34071},[],"Accediendo a la sección de autoridades de certificación se mostrará el listado de CAs registradas en el sistema. El listado permitirá el filtro mediante el nombre de la CA, el estado o el tipo de CA.",{"_7914":764,"_22115":670,"_18751":34073,"_5":22264,"_15096":33821,"_1571":34074},[],"La acción de ver detalles da acceso a los detalles de la CA y a diferentes opciones de gestión.",{"_7914":765,"_22115":670,"_18751":34076,"_5":22264,"_15096":33821,"_1571":34077},[],"En los detalles se muestra el resumen del estado de los certificados emitidos por la CA: certificados activos, expirados y revocados.",{"_7914":766,"_22115":670,"_18751":34079,"_5":22264,"_15096":33821,"_1571":34080},[],"Se ofrecen dos acciones:",{"_7914":767,"_22115":670,"_18751":34082,"_5":22264,"_15096":33821,"_1571":34083},[],"la descarga de la CRL vinculada a la CA que permitirá a otros sistemas realizar comprobaciones de vigencia de los certificados emitidos por la CA de manera desconectada.",{"_7914":768,"_22115":670,"_18751":34085,"_5":22264,"_15096":33821,"_1571":34086},[],"la acción de revocación de la CA",{"_7914":769,"_22115":670,"_18751":34088,"_5":22264,"_15096":33821,"_1571":34089},[],"Se muestra información detallada, el certificado en formato PEM y se da acceso a la relación de certificados emitidos por la CA a través de la pestaña “Issued Certificates”",{"_7914":770,"_22115":670,"_18751":34091,"_5":22264,"_15096":33825,"_1571":34092},[],"La acción de emisión de certificados se puede realizar desde la pestaña “Issued Certificates” de los detalles de la CA, mediante la acción “Issue New”.",{"_7914":771,"_22115":670,"_18751":34094,"_5":22264,"_15096":33825,"_1571":34095},[],"La funcionalidad de emisión es accesible también desde el listado de CAs mediante la acción correspondiente de emisión.",{"_7914":772,"_22115":670,"_18751":34097,"_5":22264,"_15096":33825,"_1571":34098},[],"Y desde la funcionalidad  listado completo de certificados emitidos por Lamassu mediante la acción “Issue Certificate”",{"_7914":773,"_22115":670,"_18751":34100,"_5":22264,"_15096":33825,"_1571":34101},[],"En este caso se solicitará la selección de una CA antes de acceder al formulario de emisión.",{"_7914":774,"_22115":670,"_18751":34103,"_5":22264,"_15096":33825,"_1571":34104},[],"El formulario de emisión de certificados ofrece 2 opciones para la emisión:",{"_7914":775,"_22115":670,"_18751":34106,"_5":22264,"_15096":33825,"_1571":34107},[],"Emisión a partir de una clave privada y el CSR generado en el browser",{"_7914":776,"_22115":670,"_18751":34109,"_5":22264,"_15096":33825,"_1571":34110},[],"Emisión a partir de un CSR generado de manera externa",{"_7914":777,"_22115":670,"_18751":34112,"_5":22264,"_15096":33825,"_1571":34113},[],"**Emisión a partir de una clave privada y el CSR generados en el browser**",{"_7914":778,"_22115":670,"_18751":34115,"_5":22264,"_15096":33825,"_1571":34116},[],"El usuario proporciona la información requerida para la creación del CSR, la consola genera una clave In Place y genera el CSR correspondiente mediante el cual se solicita la emisión del certificado a la CA.",{"_7914":779,"_22115":670,"_18751":34118,"_5":22264,"_15096":33825,"_1571":34119},[],"**Método de emisión:** Seleccionar  \"Generate Key & CSR in Browser\" para la generación del par de claves y la solicitud de certificado (CSR) directamente en el navegador",{"_7914":780,"_22115":670,"_18751":34121,"_5":22264,"_15096":33825,"_1571":34122},[],"**Certificate Subject (Sujeto del certificado)**",{"_7914":781,"_22115":670,"_18751":34124,"_5":22264,"_15096":33825,"_1571":34125},[],"**Common Name (CN)**",{"_7914":782,"_22115":670,"_18751":34127,"_5":22264,"_15096":33825,"_1571":34128},[],"**Campo:** Obligatorio",{"_7914":783,"_22115":670,"_18751":34130,"_5":22264,"_15096":33825,"_1571":34131},[],"**Función:** Identifica de forma única al titular del certificado",{"_7914":784,"_22115":670,"_18751":34133,"_5":22264,"_15096":33825,"_1571":34134},[],"**Ejemplos:**",{"_7914":785,"_22115":670,"_18751":34136,"_5":22264,"_15096":33825,"_1571":34137},[],"Para dispositivos: device001.company.com",{"_7914":786,"_22115":670,"_18751":34139,"_5":22264,"_15096":33825,"_1571":34140},[],"Para usuarios: john.doe\\@company.com",{"_7914":787,"_22115":670,"_18751":34142,"_5":22264,"_15096":33825,"_1571":34143},[],"Para servicios: api.service.company.com",{"_7914":788,"_22115":670,"_18751":34145,"_5":22264,"_15096":33825,"_1571":34146},[],"**Campos Organizacionales**",{"_7914":789,"_22115":670,"_18751":34148,"_5":22264,"_15096":33825,"_1571":34149},[],"**Organizational Unit (OU):** Unidad organizacional del titular",{"_7914":790,"_22115":670,"_18751":34151,"_5":22264,"_15096":33825,"_1571":34152},[],"Ejemplo: IT Department, Manufacturing",{"_7914":791,"_22115":670,"_18751":34154,"_5":22264,"_15096":33825,"_1571":33956},[],{"_7914":792,"_22115":670,"_18751":34156,"_5":22264,"_15096":33825,"_1571":34157},[],"Ejemplo: LamassuIoT Corp, Acme Industries",{"_7914":793,"_22115":670,"_18751":34159,"_5":22264,"_15096":33825,"_1571":34160},[],"**Información Geográfica**",{"_7914":794,"_22115":670,"_18751":34162,"_5":22264,"_15096":33825,"_1571":34163},[],"**Locality (L):** Ciudad o localidad del titular",{"_7914":795,"_22115":670,"_18751":34165,"_5":22264,"_15096":33825,"_1571":33944},[],{"_7914":796,"_22115":670,"_18751":34167,"_5":22264,"_15096":33825,"_1571":34168},[],"**Country (C):** Código de país ISO 3166-1 (2 letras)",{"_7914":797,"_22115":670,"_18751":34170,"_5":22264,"_15096":33825,"_1571":34171},[],"Valor por defecto mostrado: US",{"_7914":798,"_22115":670,"_18751":34173,"_5":22264,"_15096":33825,"_1571":34174},[],"**Subject Alternative Names (SANs)**\nLos SANs proporcionan identificadores alternativos para el certificado, permitiendo que un mismo certificado sea válido para múltiples nombres o direcciones.",{"_7914":799,"_22115":670,"_18751":34176,"_5":22264,"_15096":33825,"_1571":34177},[],"**Tipos de SAN Disponibles**",{"_7914":800,"_22115":670,"_18751":34179,"_5":22264,"_15096":33825,"_1571":34180},[],"**DNS:** Nombres de dominio",{"_7914":801,"_22115":670,"_18751":34182,"_5":22264,"_15096":33825,"_1571":34183},[],"Ejemplo: example.com, \\*.example.com",{"_7914":802,"_22115":670,"_18751":34185,"_5":22264,"_15096":33825,"_1571":34186},[],"**IP Address:** Direcciones IP",{"_7914":803,"_22115":670,"_18751":34188,"_5":22264,"_15096":33825,"_1571":34189},[],"**Email:** Direcciones de correo electrónico",{"_7914":804,"_22115":670,"_18751":34191,"_5":22264,"_15096":33825,"_1571":34192},[],"**URI:** Identificadores de recursos uniformes",{"_7914":805,"_22115":670,"_18751":34194,"_5":22264,"_15096":33825,"_1571":34195},[],"Es posible añadir múltiples SAN de cada tipo, se selecciona el tipo, añadiendo el valor y pulsando la acción “Add”.",{"_7914":806,"_22115":670,"_18751":34197,"_5":22264,"_15096":33825,"_1571":34198},[],"**Key Generation Details (Detalles de generación de claves)**\nSe debe especificar el tipo de clave a ser generada para la solicitud del certificado.",{"_7914":807,"_22115":670,"_18751":34200,"_5":22264,"_15096":33825,"_1571":34201},[],"**Algorithm (Algoritmo)**",{"_7914":808,"_22115":670,"_18751":34203,"_5":22264,"_15096":33825,"_1571":34204},[],"**ECDSA:** Algoritmo de curva elíptica, se debe especificar la curva a utilizar",{"_7914":809,"_22115":670,"_18751":34206,"_5":22264,"_15096":33825,"_1571":34207},[],"**RSA:** Algoritmo RSA tradicional, se debe indicar el tamaño de clave",{"_7914":810,"_22115":670,"_18751":34209,"_5":22264,"_15096":33825,"_1571":34210},[],"**Certificate Configuration (Configuración del certificado)**",{"_7914":811,"_22115":670,"_18751":34212,"_5":22264,"_15096":33825,"_1571":34213},[],"**Validity Duration (Duración de validez)**",{"_7914":812,"_22115":670,"_18751":34215,"_5":22264,"_15096":33825,"_1571":34216},[],"Indica la fecha de expiración del certificado a emitir como una expresión de duración",{"_7914":813,"_22115":670,"_18751":34218,"_5":22264,"_15096":33825,"_1571":34219},[],"**Campo:** Configurable según necesidades",{"_7914":814,"_22115":670,"_18751":34221,"_5":22264,"_15096":33825,"_1571":34016},[],{"_7914":815,"_22115":670,"_18751":34223,"_5":22264,"_15096":33825,"_1571":34224},[],"**Unidades válidas:** y (años), w (semanas), d (días), h (horas), m (minutos), s (segundos)",{"_7914":816,"_22115":670,"_18751":34226,"_5":22264,"_15096":33825,"_1571":34227},[],"**Consideración:** No puede exceder la validez de la CA emisora",{"_7914":817,"_22115":670,"_18751":34229,"_5":22264,"_15096":33825,"_1571":34230},[],"**Key Usage (Uso de claves)**\nDefine los propósitos criptográficos para los que puede utilizarse la clave privada del certificado.",{"_7914":818,"_22115":670,"_18751":34232,"_5":22264,"_15096":33825,"_1571":34233},[],"**Usos Básicos**",{"_7914":819,"_22115":670,"_18751":34235,"_5":22264,"_15096":33825,"_1571":34236},[],"**Digital Signature:** ✓ (marcado por defecto) - Firmas digitales",{"_7914":820,"_22115":670,"_18751":34238,"_5":22264,"_15096":33825,"_1571":34239},[],"**Content Commitment (Non-Repudiation):** No repudio",{"_7914":821,"_22115":670,"_18751":34241,"_5":22264,"_15096":33825,"_1571":34242},[],"**Key Encipherment:** Cifrado de claves",{"_7914":822,"_22115":670,"_18751":34244,"_5":22264,"_15096":33825,"_1571":34245},[],"**Data Encipherment:** Cifrado de datos",{"_7914":823,"_22115":670,"_18751":34247,"_5":22264,"_15096":33825,"_1571":34248},[],"**Key Agreement:** Acuerdo de claves",{"_7914":824,"_22115":670,"_18751":34250,"_5":22264,"_15096":33825,"_1571":34251},[],"**Certificate Signing:** Firma de certificados",{"_7914":825,"_22115":670,"_18751":34253,"_5":22264,"_15096":33825,"_1571":34254},[],"**CRL Signing:** Firma de listas de revocación",{"_7914":826,"_22115":670,"_18751":34256,"_5":22264,"_15096":33825,"_1571":34257},[],"**Encipher Only:** Solo cifrado",{"_7914":827,"_22115":670,"_18751":34259,"_5":22264,"_15096":33825,"_1571":34260},[],"**Decipher Only:** Solo descifrado",{"_7914":828,"_22115":670,"_18751":34262,"_5":22264,"_15096":33825,"_1571":34263},[],"**Uso Extendido de Claves**",{"_7914":829,"_22115":670,"_18751":34265,"_5":22264,"_15096":33825,"_1571":34266},[],"Especifica aplicaciones específicas para las que está autorizado el certificado.",{"_7914":830,"_22115":670,"_18751":34268,"_5":22264,"_15096":33825,"_1571":34269},[],"**Server Authentication:** ✓ (marcado por defecto) - Autenticación de servidor",{"_7914":831,"_22115":670,"_18751":34271,"_5":22264,"_15096":33825,"_1571":34272},[],"**Client Authentication:** ✓ (marcado por defecto) - Autenticación de cliente",{"_7914":832,"_22115":670,"_18751":34274,"_5":22264,"_15096":33825,"_1571":34275},[],"**Code Signing:** Firma de código",{"_7914":833,"_22115":670,"_18751":34277,"_5":22264,"_15096":33825,"_1571":34278},[],"**Email Protection:** Protección de correo electrónico",{"_7914":834,"_22115":670,"_18751":34280,"_5":22264,"_15096":33825,"_1571":34281},[],"**Time Stamping:** Sellado de tiempo",{"_7914":835,"_22115":670,"_18751":34283,"_5":22264,"_15096":33825,"_1571":34284},[],"**OCSP Signing:** Firma de respuestas OCSP",{"_7914":836,"_22115":670,"_18751":34286,"_5":22264,"_15096":33825,"_1571":34287},[],"Una vez completado los campos del formulario se solicita la emisión del certificado obteniendo el certificado y la clave privada generada en formato PEM. Esta clave privada no se almacena debe ser descargada y custodiada por el usuario ya que no se podrá volver a obtener.",{"_7914":837,"_22115":670,"_18751":34289,"_5":22264,"_15096":33825,"_1571":34290},[],"**Emisión a partir de un CSR generado de manera externa**",{"_7914":838,"_22115":670,"_18751":34292,"_5":22264,"_15096":33825,"_1571":34293},[],"Mediante esta opción se podrá realizar la emisión de certificados a partir de CSRs que hayan sido generados de manera externa. Para ello en el selector de modo del formulario de emisión es necesario seleccionar “Upload Existing CSR”.",{"_7914":839,"_22115":670,"_18751":34295,"_5":22264,"_15096":33825,"_1571":34296},[],"Se debe proporcionar un CSR válido que contenga los detalles del certificado a emitir, Subject Name, SANs,..",{"_7914":840,"_22115":670,"_18751":34298,"_5":22264,"_15096":33825,"_1571":34299},[],"Adicionalmente se proporcionará la duración deseada para el certificado y los usos permitidos. Con esta información se procederá a la emisión como se describe en el apartado anterior.",{"_7914":841,"_22115":670,"_18751":34301,"_5":22264,"_15096":33829,"_1571":34302},[],"La revocación de una Autoridad de Certificación (CA) es una acción crítica que invalida todos los certificados emitidos por esa CA, lo que puede causar interrupciones generalizadas en los dispositivos y servicios que confían en ella. Este proceso es irreversible y debe realizarse con extrema precaución.",{"_7914":842,"_22115":670,"_18751":34304,"_5":22264,"_15096":33829,"_1571":34305},[],"Para iniciar el proceso, entra en la sección de Autoridades de Certificación y localiza la CA deseada usando los filtros por **Nombre**, **Estado** y **Tipo**.",{"_7914":843,"_22115":670,"_18751":34307,"_5":22264,"_15096":33829,"_1571":34308},[],"Accede a la ficha de detalle de la CA. Allí se muestran la información general, los certificados PEM, los metadatos y los certificados emitidos, además del botón **Revoke CA**.",{"_7914":844,"_22115":670,"_18751":34310,"_5":22264,"_15096":33829,"_1571":34311},[],"Al pulsar **Revoke CA** se abre una ventana de confirmación con una advertencia sobre el impacto de la acción. En ese cuadro hay que seleccionar una **Razón de Revocación**. Las opciones incluyen:",{"_7914":845,"_22115":670,"_18751":34313,"_5":22264,"_15096":33829,"_1571":34314},[],"Unspecified (No especificado)",{"_7914":846,"_22115":670,"_18751":34316,"_5":22264,"_15096":33829,"_1571":34317},[],"KeyCompromise (Compromiso de clave)",{"_7914":847,"_22115":670,"_18751":34319,"_5":22264,"_15096":33829,"_1571":34320},[],"CACompromise (Compromiso de CA)",{"_7914":848,"_22115":670,"_18751":34322,"_5":22264,"_15096":33829,"_1571":34323},[],"AffiliationChanged (Afiliación cambiada)",{"_7914":849,"_22115":670,"_18751":34325,"_5":22264,"_15096":33829,"_1571":34326},[],"Superseded (Sustituida)",{"_7914":850,"_22115":670,"_18751":34328,"_5":22264,"_15096":33829,"_1571":34329},[],"CessationOfOperation (Cese de operación)",{"_7914":851,"_22115":670,"_18751":34331,"_5":22264,"_15096":33829,"_1571":34332},[],"CertificateHold (Retención de certificado)",{"_7914":852,"_22115":670,"_18751":34334,"_5":22264,"_15096":33829,"_1571":34335},[],"RemoveFromCRL (Eliminar de la CRL)",{"_7914":853,"_22115":670,"_18751":34337,"_5":22264,"_15096":33829,"_1571":34338},[],"Para evitar revocaciones accidentales, el sistema pedirá confirmar el nombre de la CA. En el campo de texto, escribe el **nombre exacto de la CA** que estás revocando. Una vez introducido correctamente, se habilitará el botón **Confirm Revocation**.",{"_7914":854,"_22115":670,"_18751":34340,"_5":22264,"_15096":33829,"_1571":34341},[],"Haz clic en el botón **Confirm Revocation**. Una vez completada la revocación, la CA cambiará su estado a **REVOKED** (Revocada) en la página de detalles, y ya no podrás emitir certificados nuevos con ella. En su lugar, verás la opción **Permanently Delete** (Eliminar Permanentemente).",{"_7914":855,"_22115":670,"_18751":34343,"_5":22264,"_15096":33829,"_1571":34344},[],"Consideraciones importantes:",{"_7914":856,"_22115":670,"_18751":34346,"_5":22264,"_15096":33829,"_1571":34347},[],"Impacto: La revocación de una CA es una acción irreversible que afectará a todos los dispositivos y servicios que dependen de ella. Asegúrate de comprender completamente las implicaciones antes de proceder.",{"_7914":857,"_22115":670,"_18751":34349,"_5":22264,"_15096":33829,"_1571":34350},[],"Eliminación Permanente: Después de la revocación, tendrás la opción de eliminar permanentemente la CA. Esta acción eliminará la CA del sistema de Lamassu IoT.",{"_7914":858,"_22115":858,"_5":22259,"_1571":34352,"_22272":34353,"_18751":34354,"_15096":858},"[Certs] Gestión de Certificados",[31781,32880,32889],[],{"_7914":859,"_22115":858,"_18751":34356,"_5":22264,"_15096":858,"_1571":34357},[],"Visualización y gestión de certificados emitidos",{"_7914":860,"_22115":858,"_5":22269,"_18751":34359,"_15096":34360,"_1571":34361},[],"/docs/pr-preview/pr-20/manual/servicios-core/certificates#gestión-de-certificados","Gestión de certificados",{"_7914":861,"_22115":858,"_5":22269,"_18751":34363,"_15096":34364,"_1571":34365},[],"/docs/pr-preview/pr-20/manual/servicios-core/certificates#revocación-de-certificados","Revocación de certificados",{"_7914":862,"_22115":858,"_18751":34367,"_5":22264,"_15096":34360,"_1571":34368},[],"Los certificados emitidos por Lamassu son accesibles, tanto desde la pestaña de Issued Certificates de los detalles de una CA como desde la opción “Certificates” del menú lateral.\\\nEn la pestaña de “Issued Certificates” se muestran los certificados emitidos por la CA seleccionada.",{"_7914":863,"_22115":858,"_18751":34370,"_5":22264,"_15096":34360,"_1571":34371},[],"Como desde la opción “Certificates” del menú lateral, donde se presentan todos los certificados emitidos por Lamassu independientemente de la CA que lo haya emitido. Esta pantalla incluye la opción de filtro de los certificados por CN, número de serie, estado y por la CA que lo emitió.",{"_7914":864,"_22115":858,"_18751":34373,"_5":22264,"_15096":34360,"_1571":34374},[],"Por cada certificado se incluye un conjunto de acciones vinculadas al certificado.\\\nAcceso a los detalles “View Details”, un mecanismo de inspección rápida (Quick Inspect) con la información básica del certificado, la opción de descarga en formato PEM y el acceso a las acciones de revocación.\\\nLa vista de detalle, proporciona información adicional y el acceso a las acciones de revocación.",{"_7914":865,"_22115":858,"_18751":34376,"_5":22264,"_15096":34364,"_1571":34377},[],"Ya sea desde las acciones del listado de certificados, como desde la vista de detalle se puede desencadenar la acción de revocación. Al pulsar sobre “Revoke Certificate” se abre una ventana modal en la que se debe seleccionar la razón de la revocación.",{"_7914":866,"_22115":858,"_18751":34379,"_5":22264,"_15096":34364,"_1571":34380},[],"Es importante destacar que la única razón reversible es “CertificateHold”, una revocación por cualquier otra  razón no podrá ser revertida. En caso de seleccionar “CertificateHold” se ofrecerá una acción de reactivación.",{"_7914":867,"_22115":867,"_5":22259,"_1571":34382,"_22272":34383,"_18751":34384,"_15096":867},"[Devices] Dispositivos e Identidades",[31781,32880,32889],[],{"_7914":868,"_22115":867,"_18751":34386,"_5":22264,"_15096":867,"_1571":34387},[],"Gestión de dispositivos IoT y sus identidades digitales",{"_7914":869,"_22115":867,"_5":22269,"_18751":34389,"_15096":34390,"_1571":34391},[],"/docs/pr-preview/pr-20/manual/servicios-core/devices#dispositivos-y-gestión-de-las-identidades--end-entities","Dispositivos y gestión de las identidades – End entities",{"_7914":870,"_22115":867,"_5":22269,"_18751":34393,"_15096":34394,"_1571":34395},[],"/docs/pr-preview/pr-20/manual/servicios-core/devices#visualización-de-dispositivos-gestionados","Visualización de Dispositivos Gestionados",{"_7914":871,"_22115":867,"_5":22269,"_18751":34397,"_15096":34398,"_1571":34399},[],"/docs/pr-preview/pr-20/manual/servicios-core/devices#detalle-del-dispositivo-historial-de-certificados","Detalle del Dispositivo: Historial de Certificados",{"_7914":872,"_22115":867,"_5":22269,"_18751":34401,"_15096":34402,"_1571":34403},[],"/docs/pr-preview/pr-20/manual/servicios-core/devices#detalle-del-dispositivo-línea-de-tiempo-de-eventos","Detalle del Dispositivo: Línea de tiempo de eventos",{"_7914":873,"_22115":867,"_5":22269,"_18751":34405,"_15096":34406,"_1571":34407},[],"/docs/pr-preview/pr-20/manual/servicios-core/devices#registro-de-nuevos-dispositivos","Registro de Nuevos Dispositivos",{"_7914":874,"_22115":867,"_5":22269,"_18751":34409,"_15096":34410,"_1571":34411},[],"/docs/pr-preview/pr-20/manual/servicios-core/devices#asignación-manual-de-identidad","Asignación Manual de Identidad",{"_7914":875,"_22115":867,"_5":22269,"_18751":34413,"_15096":34414,"_1571":34415},[],"/docs/pr-preview/pr-20/manual/servicios-core/devices#revocación-de-identidad","Revocación de Identidad",{"_7914":876,"_22115":867,"_5":22269,"_18751":34417,"_15096":34418,"_1571":34419},[],"/docs/pr-preview/pr-20/manual/servicios-core/devices#desactivación-de-dispositivos-decommissioning","Desactivación de Dispositivos (Decommissioning)",{"_7914":877,"_22115":867,"_18751":34421,"_5":22264,"_15096":34390,"_1571":34422},[],"La gestión del ciclo de vida de las identidades de los dispositivos es una funcionalidad central en Lamassu IoT. Esta sección del manual se enfoca en la visualización y administración de las identidades de los dispositivos ya enrolados, conocidos como *End Entities* (entidades finales). Permite una visión completa del estado, los certificados y los eventos históricos de cada dispositivo, facilitando su monitorización y control a lo largo de su ciclo de vida.",{"_7914":878,"_22115":867,"_18751":34424,"_5":22264,"_15096":34394,"_1571":34425},[],"La página de **Dispositivos** (Managed Devices) ofrece una vista general de todos los dispositivos registrados en el sistema. Puedes ver un resumen del estado de cada dispositivo, su grupo, la fecha de creación y las etiquetas asociadas. Esta visualización es clave para tener una perspectiva general del parque de dispositivos y su salud respecto al estado de su identidad.",{"_7914":879,"_22115":867,"_18751":34427,"_5":22264,"_15096":34394,"_1571":34428},[],"Para facilitar la búsqueda y el seguimiento, la interfaz permite filtrar los dispositivos por **Device ID** y por **Tags**. Además, se puede filtrar por los siguientes estados:",{"_7914":880,"_22115":867,"_18751":34430,"_5":22264,"_15096":34394,"_1571":34431},[],"**Active**: El dispositivo y su certificado están en uso y son válidos.",{"_7914":881,"_22115":867,"_18751":34433,"_5":22264,"_15096":34394,"_1571":34434},[],"**No Identity**: El dispositivo existe en el sistema, pero no tiene una identidad digital (certificado) asociada.",{"_7914":882,"_22115":867,"_18751":34436,"_5":22264,"_15096":34394,"_1571":34437},[],"**Renewal Pending**: El dispositivo se encuentra en la ventana de tiempo de renovación y su certificado expirará pronto.",{"_7914":883,"_22115":867,"_18751":34439,"_5":22264,"_15096":34394,"_1571":34440},[],"**Expiring Soon**: El certificado del dispositivo está a punto de caducar.",{"_7914":884,"_22115":867,"_18751":34442,"_5":22264,"_15096":34394,"_1571":34443},[],"**Expired**: El certificado del dispositivo ha caducado.",{"_7914":885,"_22115":867,"_18751":34445,"_5":22264,"_15096":34394,"_1571":34446},[],"**Revoked**: El certificado del dispositivo ha sido revocado.",{"_7914":886,"_22115":867,"_18751":34448,"_5":22264,"_15096":34394,"_1571":34449},[],"**Decommissioned**: El dispositivo ha sido dado de baja y ya no está en uso.",{"_7914":887,"_22115":867,"_18751":34451,"_5":22264,"_15096":34398,"_1571":34452},[],"Al seleccionar un dispositivo específico, se accede a su página de detalles. La pestaña de **Historial de Certificados** muestra un registro cronológico de todos los certificados X.509 que han sido asociados a la identidad de ese dispositivo. Aquí se pueden ver detalles como el número de serie, el estado del certificado (por ejemplo, activo, expirado o revocado), el nombre común, la CA emisora y los periodos de validez.",{"_7914":888,"_22115":867,"_18751":34454,"_5":22264,"_15096":34398,"_1571":34455},[],"Esta funcionalidad es fundamental para auditar y rastrear la historia de la identidad del dispositivo, lo que permite identificar si un certificado ha sido reemplazado o revocado en algún momento.",{"_7914":889,"_22115":867,"_18751":34457,"_5":22264,"_15096":34402,"_1571":34458},[],"La pestaña de **Línea de tiempo de eventos** (Device Event Timeline) proporciona un registro detallado y cronológico de los eventos más importantes relacionados con el dispositivo y su identidad. Estos eventos pueden incluir el aprovisionamiento inicial, la renovación de certificados o cambios de estado.",{"_7914":890,"_22115":867,"_18751":34460,"_5":22264,"_15096":34402,"_1571":34461},[],"Esta línea de tiempo es una herramienta poderosa para el análisis forense y la resolución de problemas, ya que permite ver la secuencia exacta de las acciones que han ocurrido en la vida del dispositivo.",{"_7914":891,"_22115":867,"_18751":34463,"_5":22264,"_15096":34406,"_1571":34464},[],"Además de la gestión de dispositivos ya enrolados, Lamassu IoT permite el registro manual de nuevos dispositivos. Esto es particularmente útil para el modo de registro por **Pre-registration**, donde la identidad del dispositivo debe existir en el sistema antes de que pueda solicitar un certificado.",{"_7914":892,"_22115":867,"_18751":34466,"_5":22264,"_15096":34406,"_1571":34467},[],"El proceso de registro de un nuevo dispositivo se realiza a través de un formulario que permite configurar los siguientes campos:",{"_7914":893,"_22115":867,"_18751":34469,"_5":22264,"_15096":34406,"_1571":34470},[],"**Device ID (GUID)**: Es el identificador único del dispositivo, normalmente un GUID (Globally Unique Identifier).",{"_7914":894,"_22115":867,"_18751":34472,"_5":22264,"_15096":34406,"_1571":34473},[],"**Registration Authority**: Se debe seleccionar la RA a la que se asociará el dispositivo, lo que definirá las políticas de *enrollment* y *re-enrollment* que se aplicarán.",{"_7914":895,"_22115":867,"_18751":34475,"_5":22264,"_15096":34406,"_1571":34476},[],"**Device Registration Profile**: En esta sección se pueden configurar aspectos visuales para facilitar la identificación del dispositivo.",{"_7914":896,"_22115":867,"_18751":34478,"_5":22264,"_15096":34406,"_1571":34479},[],"**Icon**: Permite seleccionar un icono que represente visualmente el tipo de dispositivo.",{"_7914":897,"_22115":867,"_18751":34481,"_5":22264,"_15096":34406,"_1571":34482},[],"**Tags**: Se pueden añadir etiquetas para agrupar y organizar el dispositivo con otros de características similares.",{"_7914":898,"_22115":867,"_18751":34484,"_5":22264,"_15096":34406,"_1571":34485},[],"Una vez registrado, el dispositivo aparecerá en el listado de dispositivos con el estado **No Identity** hasta que complete el proceso de *enrollment* y obtenga su primer certificado.",{"_7914":899,"_22115":867,"_18751":34487,"_5":22264,"_15096":34410,"_1571":34488},[],"La **Asignación manual de identidad** es una acción que solo está disponible para dispositivos en estado **No Identity**, es decir, que han sido registrados en el sistema pero aún no tienen un certificado asignado. Esta funcionalidad permite vincular un certificado ya existente o emitir uno nuevo de forma manual.",{"_7914":900,"_22115":867,"_18751":34490,"_5":22264,"_15096":34410,"_1571":34491},[],"El proceso se lleva a cabo desde la vista de detalles del dispositivo:",{"_7914":901,"_22115":867,"_18751":34493,"_5":22264,"_15096":34410,"_1571":34494},[],"**Iniciar la asignación**: Se hace clic en el botón **Assign Identity**. Esto abrirá una ventana emergente.",{"_7914":902,"_22115":867,"_18751":34496,"_5":22264,"_15096":34410,"_1571":34497},[],"**Vincular certificado existente**: La aplicación buscará certificados activos con un Common Name (CN) que coincida con el Device ID. Si se encuentra un certificado, se puede seleccionar y vincular al dispositivo.",{"_7914":903,"_22115":867,"_18751":34499,"_5":22264,"_15096":34410,"_1571":34500},[],"**Emitir un nuevo certificado**: Si no se encuentra un certificado existente, o si se desea emitir uno nuevo, se puede seleccionar la opción **Issue New Instead**. Esto te permite elegir la **Certification Authority** que emitirá el nuevo certificado para el dispositivo. Se muestran por defecto las CAs vinculadas a la RA que gestiona ell dispositivo.",{"_7914":904,"_22115":867,"_18751":34502,"_5":22264,"_15096":34410,"_1571":34503},[],"**Confirmar y asignar**: Una vez seleccionado el certificado (existente o nuevo), se confirma la asignación. El dispositivo pasará del estado **No Identity** al estado **Active** y el certificado aparecerá en su historial.",{"_7914":905,"_22115":867,"_18751":34505,"_5":22264,"_15096":34414,"_1571":34506},[],"La revocación de la identidad es un proceso crítico para la seguridad que permite invalidar un certificado antes de su fecha de caducidad. Esta acción es irreversible. En Lamassu IoT, la revocación se realiza desde la sección de detalle del dispositivo, específicamente desde la línea de tiempo de eventos.",{"_7914":906,"_22115":867,"_18751":34508,"_5":22264,"_15096":34414,"_1571":34509},[],"El proceso de revocación se lleva a cabo de la siguiente manera:",{"_7914":907,"_22115":867,"_18751":34511,"_5":22264,"_15096":34414,"_1571":34512},[],"**Acceder a la revocación**: En la sección **Device Event Timeline**, junto al último certificado **Active**, se encuentra la opción de **Revoke**. Al hacer clic en ella, se abre una ventana de confirmación.",{"_7914":908,"_22115":867,"_18751":34514,"_5":22264,"_15096":34414,"_1571":34515},[],"**Seleccionar el motivo de revocación**: La ventana emergente solicita seleccionar un motivo de revocación (Revocation Reason). Esto es esencial para el registro de auditoría y la generación de la CRL (Certificate Revocation List). Los motivos disponibles, definidos en el **RFC 5280**, y otros adicionales son:",{"_7914":909,"_22115":867,"_18751":34517,"_5":22264,"_15096":34414,"_1571":34518},[],"**Unspecified**: Motivo de revocación no especificado.",{"_7914":910,"_22115":867,"_18751":34520,"_5":22264,"_15096":34414,"_1571":34521},[],"**KeyCompromise**: La clave privada del certificado ha sido comprometida.",{"_7914":911,"_22115":867,"_18751":34523,"_5":22264,"_15096":34414,"_1571":34524},[],"**CACompromise**: La clave privada de la CA ha sido comprometida.",{"_7914":912,"_22115":867,"_18751":34526,"_5":22264,"_15096":34414,"_1571":34527},[],"**AffiliationChanged**: El nombre del sujeto o su afiliación ha cambiado.",{"_7914":913,"_22115":867,"_18751":34529,"_5":22264,"_15096":34414,"_1571":34530},[],"**Superseded**: El certificado ha sido reemplazado por uno nuevo.",{"_7914":914,"_22115":867,"_18751":34532,"_5":22264,"_15096":34414,"_1571":34533},[],"**CessationOfOperation**: La entidad ha dejado de operar o usar el certificado.",{"_7914":915,"_22115":867,"_18751":34535,"_5":22264,"_15096":34414,"_1571":34536},[],"**CertificateHold**: El certificado está temporalmente en espera de revocación.",{"_7914":916,"_22115":867,"_18751":34538,"_5":22264,"_15096":34414,"_1571":34539},[],"**RemoveFromCRL**: Se usa en un *delta-CRL* para indicar que el certificado fue previamente puesto en espera y ahora debe ser revocado definitivamente.",{"_7914":917,"_22115":867,"_18751":34541,"_5":22264,"_15096":34414,"_1571":34542},[],"**PrivilegeWithdrawn**: Se han retirado los privilegios de la entidad asociada al certificado.",{"_7914":918,"_22115":867,"_18751":34544,"_5":22264,"_15096":34414,"_1571":34545},[],"**AACompromise**: La clave de un servidor de autorización de atributos ha sido comprometida.",{"_7914":919,"_22115":867,"_18751":34547,"_5":22264,"_15096":34414,"_1571":34548},[],"**WeakAlgorithmOrKey**: La clave o el algoritmo del certificado se consideran débiles o han sido comprometidos.",{"_7914":920,"_22115":867,"_18751":34550,"_5":22264,"_15096":34414,"_1571":34551},[],"**Confirmar la revocación**: Una vez seleccionado el motivo, se confirma la acción. El estado del certificado cambiará a **Revoked** en la línea de tiempo y en el historial de certificados. El certificado revocado dejará de ser válido.\nEs importante destacar que, una vez revocado un certificado, la identidad del dispositivo puede ser restaurada asignándole un nuevo certificado válido. En caso de que la razón de revocación sea CertificateHold, se permitirá la reactivación.",{"_7914":921,"_22115":867,"_18751":34553,"_5":22264,"_15096":34418,"_1571":34554},[],"El *Decommissioning* es el proceso irreversible de dar de baja un dispositivo de forma definitiva del sistema. A diferencia de la revocación, que sólo invalida el certificado, la desactivación revoca todos los certificados asociados al dispositivo y le impide obtener nuevas identidades en el futuro. Es una acción de seguridad crítica que se utiliza cuando un dispositivo es retirado permanentemente o ya no es de confianza.",{"_7914":922,"_22115":867,"_18751":34556,"_5":22264,"_15096":34418,"_1571":34557},[],"El proceso se realiza de la siguiente manera:",{"_7914":923,"_22115":867,"_18751":34559,"_5":22264,"_15096":34418,"_1571":34560},[],"**Acceder a la acción**: Desde la vista de detalles de un dispositivo activo, se hace clic en el botón **Decommission**.",{"_7914":924,"_22115":867,"_18751":34562,"_5":22264,"_15096":34418,"_1571":34563},[],"**Confirmar la acción irreversible**: Aparecerá una ventana de advertencia que explica que la acción es irreversible y que se revocarán todos los certificados asociados al dispositivo, impidiendo que vuelva a obtener una identidad.",{"_7914":925,"_22115":867,"_18751":34565,"_5":22264,"_15096":34418,"_1571":34566},[],"**Confirmar y desactivar**: Al confirmar la desactivación, el sistema revoca el certificado activo del dispositivo con la razón CessationOfOperation y cambia su estado a **Decommissioned**. El dispositivo ya no podrá realizar operaciones con la PKI.",{"_7914":926,"_22115":926,"_5":22259,"_1571":34568,"_22272":34569,"_18751":34570,"_15096":926},"EST: Enrollment over Secure Transport",[31781,32880,32889],[],{"_7914":927,"_22115":926,"_18751":34572,"_5":22264,"_15096":926,"_1571":34573},[],"Guía del protocolo EST en Lamassu IoT, con la configuración del DMS para el administrador PKI y la referencia de endpoints para el integrador de dispositivos.",{"_7914":928,"_22115":926,"_5":22269,"_18751":34575,"_15096":34576,"_1571":34568},[],"/docs/pr-preview/pr-20/manual/servicios-core/est#est-enrollment-over-secure-transport",{"_7914":929,"_22115":926,"_5":22269,"_18751":34578,"_15096":34579,"_1571":32963},[],"/docs/pr-preview/pr-20/manual/servicios-core/est#configuración-del-dms",{"_7914":930,"_22115":926,"_5":22269,"_18751":34581,"_15096":34582,"_1571":32486},[],"/docs/pr-preview/pr-20/manual/servicios-core/est#requisitos-previos",{"_7914":931,"_22115":926,"_5":22269,"_18751":34584,"_15096":34585,"_1571":34586},[],"/docs/pr-preview/pr-20/manual/servicios-core/est#configuración-de-enrollment","Configuración de enrollment",{"_7914":932,"_22115":926,"_5":22269,"_18751":34588,"_15096":34589,"_1571":34590},[],"/docs/pr-preview/pr-20/manual/servicios-core/est#enrollment-device-registration","Enrollment Device Registration",{"_7914":933,"_22115":926,"_5":22269,"_18751":34592,"_15096":34593,"_1571":34594},[],"/docs/pr-preview/pr-20/manual/servicios-core/est#enrollment-settings","Enrollment Settings",{"_7914":934,"_22115":926,"_5":22269,"_18751":34596,"_15096":34597,"_1571":34598},[],"/docs/pr-preview/pr-20/manual/servicios-core/est#perfil-de-emisión","Perfil de emisión",{"_7914":935,"_22115":926,"_5":22269,"_18751":34600,"_15096":34601,"_1571":34602},[],"/docs/pr-preview/pr-20/manual/servicios-core/est#configuración-de-re-enrollment","Configuración de re-enrollment",{"_7914":936,"_22115":926,"_5":22269,"_18751":34604,"_15096":34605,"_1571":34606},[],"/docs/pr-preview/pr-20/manual/servicios-core/est#configuración-de-serverkeygen","Configuración de ServerKeyGen",{"_7914":937,"_22115":926,"_5":22269,"_18751":34608,"_15096":34609,"_1571":34610},[],"/docs/pr-preview/pr-20/manual/servicios-core/est#verificar-la-configuración","Verificar la configuración",{"_7914":938,"_22115":926,"_5":22269,"_18751":34612,"_15096":34613,"_1571":34614},[],"/docs/pr-preview/pr-20/manual/servicios-core/est#integración-de-dispositivos","Integración de dispositivos",{"_7914":939,"_22115":926,"_5":22269,"_18751":34616,"_15096":34617,"_1571":34618},[],"/docs/pr-preview/pr-20/manual/servicios-core/est#antes-de-empezar","Antes de empezar",{"_7914":940,"_22115":926,"_5":22269,"_18751":34620,"_15096":34621,"_1571":34622},[],"/docs/pr-preview/pr-20/manual/servicios-core/est#resumen-del-flujo","Resumen del flujo",{"_7914":941,"_22115":926,"_5":22269,"_18751":34624,"_15096":34625,"_1571":34626},[],"/docs/pr-preview/pr-20/manual/servicios-core/est#modelo-de-autenticación-del-cliente","Modelo de autenticación del cliente",{"_7914":942,"_22115":926,"_5":22269,"_18751":34628,"_15096":34629,"_1571":34630},[],"/docs/pr-preview/pr-20/manual/servicios-core/est#referencia-de-endpoints","Referencia de endpoints",{"_7914":943,"_22115":926,"_5":22269,"_18751":34632,"_15096":34633,"_1571":34634},[],"/docs/pr-preview/pr-20/manual/servicios-core/est#cacerts","`/cacerts`",{"_7914":944,"_22115":926,"_5":22269,"_18751":34636,"_15096":34637,"_1571":34638},[],"/docs/pr-preview/pr-20/manual/servicios-core/est#simpleenroll","`/simpleenroll`",{"_7914":945,"_22115":926,"_5":22269,"_18751":34640,"_15096":34641,"_1571":34642},[],"/docs/pr-preview/pr-20/manual/servicios-core/est#simplereenroll","`/simplereenroll`",{"_7914":946,"_22115":926,"_5":22269,"_18751":34644,"_15096":34645,"_1571":34646},[],"/docs/pr-preview/pr-20/manual/servicios-core/est#serverkeygen","`/serverkeygen`",{"_7914":947,"_22115":926,"_5":22269,"_18751":34648,"_15096":34649,"_1571":34650},[],"/docs/pr-preview/pr-20/manual/servicios-core/est#flujos-completos","Flujos completos",{"_7914":948,"_22115":926,"_5":22269,"_18751":34652,"_15096":34653,"_1571":34654},[],"/docs/pr-preview/pr-20/manual/servicios-core/est#ejemplo-end-to-end-enroll","Ejemplo end-to-end: enroll",{"_7914":949,"_22115":926,"_5":22269,"_18751":34656,"_15096":34657,"_1571":34658},[],"/docs/pr-preview/pr-20/manual/servicios-core/est#ejemplo-end-to-end-reenroll","Ejemplo end-to-end: reenroll",{"_7914":950,"_22115":926,"_5":22269,"_18751":34660,"_15096":34661,"_1571":34662},[],"/docs/pr-preview/pr-20/manual/servicios-core/est#próximos-pasos-tras-el-enrolamiento","Próximos pasos tras el enrolamiento",{"_7914":951,"_22115":926,"_5":22269,"_18751":34664,"_15096":34665,"_1571":34666},[],"/docs/pr-preview/pr-20/manual/servicios-core/est#diagnóstico-y-compatibilidad","Diagnóstico y compatibilidad",{"_7914":952,"_22115":926,"_5":22269,"_18751":34668,"_15096":34669,"_1571":34670},[],"/docs/pr-preview/pr-20/manual/servicios-core/est#códigos-de-error-y-diagnóstico","Códigos de error y diagnóstico",{"_7914":953,"_22115":926,"_5":22269,"_18751":34672,"_15096":34673,"_1571":34674},[],"/docs/pr-preview/pr-20/manual/servicios-core/est#notas-de-compatibilidad","Notas de compatibilidad",{"_7914":954,"_22115":926,"_18751":34676,"_5":22264,"_15096":34576,"_1571":34677},[],"Lamassu IoT implementa el protocolo &#x2A;*EST (Enrollment over Secure Transport)** descrito en el RFC 7030 como su único mecanismo de inscripción de certificados para dispositivos. Cada DMS expone los endpoints EST, valida al dispositivo y aplica sus propias políticas de autenticación, registro y renovación — actuando como autoridad de registro (RA) frente al cliente.",{"_7914":955,"_22115":926,"_18751":34679,"_5":22264,"_15096":34576,"_1571":34680},[],"La entidad que emite y firma criptográficamente el certificado es siempre la **CA asociada al DMS**, no el DMS. El DMS coordina el proceso: recibe el CSR, autentica al dispositivo y aplica la política de emisión. Esta distinción es relevante para el administrador PKI al seleccionar la `EnrollmentCA` y para el integrador al interpretar la cadena de confianza recibida de `/cacerts`.",{"_7914":956,"_22115":926,"_18751":34682,"_5":22264,"_15096":34576,"_1571":34683},[],"Esta guía está dividida en dos partes:",{"_7914":957,"_22115":926,"_18751":34685,"_5":22264,"_15096":34576,"_1571":34686},[],"Configuración del DMS, para el administrador PKI.",{"_7914":958,"_22115":926,"_18751":34688,"_5":22264,"_15096":34576,"_1571":34689},[],"Integración de dispositivos, para quien consume los endpoints EST desde firmware, scripts o servicios de aprovisionamiento.",{"_7914":959,"_22115":926,"_18751":34691,"_5":22264,"_15096":34576,"_1571":34692},[],"Si solo necesita una orientación rápida, este es el recorrido recomendado:",{"_7914":960,"_22115":926,"_18751":34694,"_5":22264,"_15096":34576,"_1571":34695},[],"Perfil",{"_7914":961,"_22115":926,"_18751":34697,"_5":22264,"_15096":34576,"_1571":34698},[],"Leer primero",{"_7914":962,"_22115":926,"_18751":34700,"_5":22264,"_15096":34576,"_1571":34701},[],"Después",{"_7914":963,"_22115":926,"_18751":34703,"_5":22264,"_15096":34576,"_1571":34704},[],"Administrador PKI",{"_7914":964,"_22115":926,"_18751":34706,"_5":22264,"_15096":34576,"_1571":32963},[],{"_7914":965,"_22115":926,"_18751":34708,"_5":22264,"_15096":34576,"_1571":34666},[],{"_7914":966,"_22115":926,"_18751":34710,"_5":22264,"_15096":34576,"_1571":34711},[],"Integrador de dispositivos",{"_7914":967,"_22115":926,"_18751":34713,"_5":22264,"_15096":34576,"_1571":34618},[],{"_7914":968,"_22115":926,"_18751":34715,"_5":22264,"_15096":34576,"_1571":34716},[],"Los endpoints `/cacerts`, `/simpleenroll`, `/simplereenroll` o `/serverkeygen`, según el flujo",{"_7914":969,"_22115":926,"_18751":34718,"_5":22264,"_15096":34582,"_1571":34719},[],"Antes de configurar un DMS para EST, deben existir los siguientes recursos en la plataforma:",{"_7914":970,"_22115":926,"_18751":34721,"_5":22264,"_15096":34582,"_1571":34722},[],"**Una CA disponible**: la CA que actuará como `EnrollmentCA` debe estar creada y en estado activo en Lamassu. Si el modo de autenticación es `CLIENT_CERTIFICATE`, también deben estar creadas las CAs de validación del certificado bootstrap.",{"_7914":971,"_22115":926,"_18751":34724,"_5":22264,"_15096":34582,"_1571":34725},[],"**Un DMS creado**: el DMS al que se aplicará esta configuración debe existir previamente. La configuración EST se aplica sobre un DMS existente, no lo crea.",{"_7914":972,"_22115":926,"_18751":34727,"_5":22264,"_15096":34582,"_1571":34728},[],"Conviene separar cuatro bloques de configuración:",{"_7914":973,"_22115":926,"_18751":34730,"_5":22264,"_15096":34582,"_1571":34731},[],"Cómo se realizará el enrollment inicial, incluyendo el modo de alta y la autenticación del cliente.",{"_7914":974,"_22115":926,"_18751":34733,"_5":22264,"_15096":34582,"_1571":34734},[],"Cómo se gestionará el re-enrollment de certificados ya emitidos.",{"_7914":975,"_22115":926,"_18751":34736,"_5":22264,"_15096":34582,"_1571":34737},[],"Cómo se configurará el endpoint cacerts para la distribución de las CAs de confianza utilizadas por los dispositivos.",{"_7914":976,"_22115":926,"_18751":34739,"_5":22264,"_15096":34582,"_1571":34740},[],"Si se habilitará la generación de claves en servidor mediante `ServerKeyGen`.",{"_7914":977,"_22115":926,"_18751":34742,"_5":22264,"_15096":34589,"_1571":34743},[],"En esta sección se define cómo se registran los dispositivos nuevos y con qué credenciales se autentican.",{"_7914":978,"_22115":926,"_18751":34745,"_5":22264,"_15096":34589,"_1571":34746},[],"**Registration Mode**: determina el comportamiento al recibir una inscripción inicial. En modo `JITP` (*Just-In-Time Provisioning*), el dispositivo se crea automáticamente la primera vez que se presenta, aplicando los tags, metadatos e icono definidos en el perfil de aprovisionamiento. En modo `PRE_REGISTRATION`, el dispositivo debe existir previamente en la plataforma; si no existe, la solicitud se rechaza con `device not preregistered`. El modo JITP es adecuado para flotas grandes donde el inventario se construye durante el despliegue; el modo `PRE_REGISTRATION` encaja en entornos de alta seguridad donde cada dispositivo se aprueba de forma explícita antes de recibir un certificado.",{"_7914":979,"_22115":926,"_18751":34748,"_5":22264,"_15096":34589,"_1571":34749},[],"**Tags**: se aplican a cada dispositivo creado automáticamente por este DMS. Son opcionales y solo tienen efecto en modo JITP. Los tags permiten mejorar la búsqueda de dispositivos.",{"_7914":980,"_22115":926,"_18751":34751,"_5":22264,"_15096":34589,"_1571":34752},[],"**Icon**: se aplica a cada dispositivo creado automáticamente por este DMS. Es opcional y solo tiene efecto en modo JITP. Únicamente visual.",{"_7914":981,"_22115":926,"_18751":34754,"_5":22264,"_15096":34593,"_1571":34755},[],"**Enrollment CA**: identifica la CA que firmará los certificados de identidad emitidos a través de este DMS. Su elección determina la cadena de confianza que el dispositivo recibirá y la raíz contra la que los sistemas de backend validarán los certificados de flota.",{"_7914":982,"_22115":926,"_18751":34757,"_5":22264,"_15096":34593,"_1571":34758},[],"**Allow Override Enrollment** (`enable_replaceable_enrollment`): permite que un dispositivo ya enrolado vuelva a inscribirse mediante `/simpleenroll`. Cuando está activa, el certificado anterior se revoca con la razón `superseded` y el slot de identidad se actualiza. Cuando está inactiva, un segundo intento de `simpleenroll` se rechaza con `forbiddenNewEnrollment`. Esta opción debe habilitarse con precaución en entornos de producción, ya que permite sustituir la identidad de un dispositivo sin pasar por el flujo de re-enrollment.",{"_7914":983,"_22115":926,"_18751":34760,"_5":22264,"_15096":34593,"_1571":34761},[],"**Verify CSR Signature** (`verify_csr_signature`): controla si el servidor valida la firma del CSR contra la clave pública declarada en él (prueba de posesión PKCS#10). Cuando está inactiva, un solicitante podría enviar un CSR con una clave pública que no controla y obtener un certificado vinculado a ella. Para flotas IoT en redes abiertas debe estar activa.",{"_7914":984,"_22115":926,"_18751":34763,"_5":22264,"_15096":34593,"_1571":34764},[],"**Authentication Mode**: define cómo el DMS valida la identidad del dispositivo durante el enrollment. Los cuatro modos disponibles son:",{"_7914":985,"_22115":926,"_18751":34766,"_5":22264,"_15096":34593,"_1571":34767},[],"Modo",{"_7914":986,"_22115":926,"_18751":34769,"_5":22264,"_15096":34593,"_1571":31984},[],{"_7914":987,"_22115":926,"_18751":34771,"_5":22264,"_15096":34593,"_1571":34772},[],"`CLIENT_CERTIFICATE`",{"_7914":988,"_22115":926,"_18751":34774,"_5":22264,"_15096":34593,"_1571":34775},[],"mTLS. El dispositivo presenta un certificado X.509 emitido por alguna de las CAs declaradas en **Validation CAs**.",{"_7914":989,"_22115":926,"_18751":34777,"_5":22264,"_15096":34593,"_1571":34778},[],"`EXTERNAL_WEBHOOK`",{"_7914":990,"_22115":926,"_18751":34780,"_5":22264,"_15096":34593,"_1571":34781},[],"La decisión de autorización se delega en un servicio HTTP externo. Solo aplica en `/simpleenroll`; en `/simplereenroll` este modo degrada silenciosamente a `NO_AUTH`.",{"_7914":991,"_22115":926,"_18751":34783,"_5":22264,"_15096":34593,"_1571":34784},[],"`CLIENT_CERTIFICATE_AND_EXTERNAL_WEBHOOK`",{"_7914":992,"_22115":926,"_18751":34786,"_5":22264,"_15096":34593,"_1571":34787},[],"Combina los dos anteriores: se exige un certificado cliente válido **y** la confirmación del webhook externo.",{"_7914":993,"_22115":926,"_18751":34789,"_5":22264,"_15096":34593,"_1571":34790},[],"`NO_AUTH`",{"_7914":994,"_22115":926,"_18751":34792,"_5":22264,"_15096":34593,"_1571":34793},[],"Sin autenticación. Cualquier CSR se acepta. **Exclusivo para entornos de laboratorio o redes de aprovisionamiento aisladas**; no debe usarse en producción.",{"_7914":995,"_22115":926,"_18751":34795,"_5":22264,"_15096":34593,"_1571":34796},[],"Cuando el modo es `CLIENT_CERTIFICATE` o `CLIENT_CERTIFICATE_AND_EXTERNAL_WEBHOOK`, se configuran además estos parámetros:",{"_7914":996,"_22115":926,"_18751":34798,"_5":22264,"_15096":34593,"_1571":34799},[],"**Validation CAs**: lista de CAs de confianza para validar el certificado bootstrap presentado por el dispositivo.",{"_7914":997,"_22115":926,"_18751":34801,"_5":22264,"_15096":34593,"_1571":34802},[],"**Chain Validation Level**: profundidad máxima de la cadena de validación. El valor `-1` valida la cadena completa hasta la CA raíz.",{"_7914":998,"_22115":926,"_18751":34804,"_5":22264,"_15096":34593,"_1571":34805},[],"**Allow Authenticating Expired Certificates**: si está activo, acepta certificados cliente caducados. Es útil en escenarios de recuperación donde el dispositivo no pudo renovar su certificado a tiempo.",{"_7914":999,"_22115":926,"_18751":34807,"_5":22264,"_15096":34593,"_1571":34808},[],"Cuando el modo incluye `EXTERNAL_WEBHOOK`, se configuran además estos parámetros:",{"_7914":1000,"_22115":926,"_18751":34810,"_5":22264,"_15096":34593,"_1571":34811},[],"**Webhook URL**: dirección del servicio externo que decidirá la autorización.",{"_7914":1001,"_22115":926,"_18751":34813,"_5":22264,"_15096":34593,"_1571":34814},[],"**HTTP Method**: método HTTP utilizado para invocar el webhook. Admite `POST` (por defecto) o `PUT`; ambos son equivalentes para el webhook, solo cambia el verbo con el que Lamassu realiza la llamada.",{"_7914":1002,"_22115":926,"_18751":34816,"_5":22264,"_15096":34593,"_1571":34817},[],"**Timeout**: tiempo máximo de espera de la llamada al webhook. Si no se especifica, el valor por defecto es de **10 segundos**; superado ese plazo sin respuesta, Lamassu deniega la operación.",{"_7914":1003,"_22115":926,"_18751":34819,"_5":22264,"_15096":34593,"_1571":34820},[],"**Webhook Authentication Mode**: modo de autenticación del webhook hacia el servicio externo, por ejemplo `ApiKey`, `OIDC` o `mTLS`.",{"_7914":1004,"_22115":926,"_18751":34822,"_5":22264,"_15096":34593,"_1571":34823},[],"El contrato exacto que debe implementar el servicio webhook (esquema de petición y respuesta, ejemplos) está publicado como especificación OpenAPI: referencia del webhook de autorización.",{"_7914":1005,"_22115":926,"_18751":34825,"_5":22264,"_15096":34597,"_1571":34826},[],"El comportamiento del certificado emitido no lo determina únicamente el CSR del dispositivo, sino el **perfil de emisión** (`IssuanceProfile`) asociado al DMS. El integrador no configura este perfil, pero sus reglas afectan al contenido del certificado final:",{"_7914":1006,"_22115":926,"_18751":34828,"_5":22264,"_15096":34597,"_1571":34829},[],"Campo",{"_7914":1007,"_22115":926,"_18751":34831,"_5":22264,"_15096":34597,"_1571":33115},[],{"_7914":1008,"_22115":926,"_18751":34833,"_5":22264,"_15096":34597,"_1571":34834},[],"Efecto sobre el certificado emitido",{"_7914":1009,"_22115":926,"_18751":34836,"_5":22264,"_15096":34597,"_1571":34837},[],"`HonorSubject`",{"_7914":1010,"_22115":926,"_18751":34839,"_5":22264,"_15096":34597,"_1571":20460},[],{"_7914":1011,"_22115":926,"_18751":34841,"_5":22264,"_15096":34597,"_1571":34842},[],"Si `true`, el subject del CSR se traslada literalmente al certificado. Si `false`, la CA aplica la plantilla del perfil e ignora el subject del CSR.",{"_7914":1012,"_22115":926,"_18751":34844,"_5":22264,"_15096":34597,"_1571":34845},[],"`HonorKeyUsage`",{"_7914":1013,"_22115":926,"_18751":34847,"_5":22264,"_15096":34597,"_1571":20460},[],{"_7914":1014,"_22115":926,"_18751":34849,"_5":22264,"_15096":34597,"_1571":34850},[],"Si `true`, el `KeyUsage` del CSR se respeta. Si `false`, se aplica la plantilla del perfil.",{"_7914":1015,"_22115":926,"_18751":34852,"_5":22264,"_15096":34597,"_1571":34853},[],"`HonorExtendedKeyUsages`",{"_7914":1016,"_22115":926,"_18751":34855,"_5":22264,"_15096":34597,"_1571":20460},[],{"_7914":1017,"_22115":926,"_18751":34857,"_5":22264,"_15096":34597,"_1571":34858},[],"Igual que `HonorKeyUsage`, pero para `ExtKeyUsage`.",{"_7914":1018,"_22115":926,"_18751":34860,"_5":22264,"_15096":34597,"_1571":34861},[],"`HonorExtensions`",{"_7914":1019,"_22115":926,"_18751":34863,"_5":22264,"_15096":34597,"_1571":20460},[],{"_7914":1020,"_22115":926,"_18751":34865,"_5":22264,"_15096":34597,"_1571":34866},[],"Controla si el resto de extensiones del CSR (SAN, CDP, etc.) se incluyen en el certificado.",{"_7914":1021,"_22115":926,"_18751":34868,"_5":22264,"_15096":34597,"_1571":34869},[],"Esto es relevante para el integrador: el `KeyUsage`, `ExtKeyUsage` y los SAN que declara el CSR pueden no aparecer tal cual en el certificado final si el perfil así lo decide. Consulte con el administrador PKI si el certificado emitido no contiene las extensiones esperadas.",{"_7914":1022,"_22115":926,"_18751":34871,"_5":22264,"_15096":34601,"_1571":34872},[],"La sección **Re-Enrollment Settings** controla el proceso de renovación de certificados. El re-enrollment puede realizarse únicamente cuando el certificado está dentro de la ventana configurada, y opcionalmente también cuando el certificado ya ha caducado.",{"_7914":1023,"_22115":926,"_18751":34874,"_5":22264,"_15096":34601,"_1571":34875},[],"**Revoke On Re-Enroll**: si está activo, el certificado anterior se revoca automáticamente con la razón `superseded` una vez emitido el nuevo.",{"_7914":1024,"_22115":926,"_18751":34877,"_5":22264,"_15096":34601,"_1571":34878},[],"**Allow Expired Renewal**: permite renovar un certificado ya caducado. Es útil cuando un dispositivo ha estado desconectado y no pudo renovar dentro de la ventana.",{"_7914":1025,"_22115":926,"_18751":34880,"_5":22264,"_15096":34601,"_1571":34881},[],"**Allowed Renewal Delta**: ventana de tiempo previa a la caducidad durante la cual se permite el re-enrollment. Antes de que se abra esta ventana, la solicitud se rechaza con `invalid reenroll window`.",{"_7914":1026,"_22115":926,"_18751":34883,"_5":22264,"_15096":34601,"_1571":34884},[],"**Preventive Renewal Delta**: tiempo previo a la caducidad a partir del cual se emiten alertas de renovación preventiva.",{"_7914":1027,"_22115":926,"_18751":34886,"_5":22264,"_15096":34601,"_1571":34887},[],"**Critical Renewal Delta**: umbral más cercano al vencimiento que activa alertas de estado crítico.",{"_7914":1028,"_22115":926,"_18751":34889,"_5":22264,"_15096":34601,"_1571":34890},[],"**Additional Validation CAs**: CAs adicionales aceptadas como emisoras del certificado en vigor durante el re-enrollment. Permite migrar a una nueva CA de enrolamiento sin interrumpir la renovación de dispositivos ya enrolados con la CA anterior.",{"_7914":1029,"_22115":926,"_18751":34892,"_5":22264,"_15096":34605,"_1571":34893},[],"La sección **Server Key Generation** permite que Lamassu genere el par de claves del dispositivo en el servidor y lo devuelva junto con el certificado emitido. Es útil para dispositivos con capacidad criptográfica limitada.",{"_7914":1030,"_22115":926,"_18751":34895,"_5":22264,"_15096":34605,"_1571":34896},[],"La opción **Enable Server-Side Key Generation** activa el endpoint `/serverkeygen`. Cuando está inactiva, cualquier llamada a ese endpoint se rechaza con `server key generation not enabled`.",{"_7914":1031,"_22115":926,"_18751":34898,"_5":22264,"_15096":34605,"_1571":34899},[],"**Key Type** selecciona el algoritmo: `RSA` o `ECDSA`. El campo &#x2A;*Key Size (bits)** determina el tamaño de la clave. Para ECDSA, el tamaño en bits determina también la curva: 256 corresponde a P-256, 384 a P-384 y 521 a P-521.",{"_7914":1032,"_22115":926,"_18751":34901,"_5":22264,"_15096":34605,"_1571":34902},[],"La clave se genera en el motor software del servidor, no en un Crypto Engine de hardware como AWS KMS o PKCS#11. La única protección de la clave en tránsito es el canal TLS; no se aplica cifrado adicional (CMS EnvelopedData) sobre la clave antes de enviarla al dispositivo. Consulte el apartado `/serverkeygen` de la referencia para integrador para conocer el formato exacto de la respuesta y las consideraciones de seguridad.",{"_7914":1033,"_22115":926,"_18751":34904,"_5":22264,"_15096":34609,"_1571":34905},[],"Una vez aplicados los ajustes de enrollment, re-enrollment y ServerKeyGen, puede confirmar que el DMS está operativo de las siguientes formas:",{"_7914":1034,"_22115":926,"_18751":34907,"_5":22264,"_15096":34609,"_1571":34908},[],"**Desde la consola**: accede al detalle del DMS y comprueba que la sección EST muestra la CA de enrolamiento asignada y el modo de autenticación configurado.",{"_7914":1035,"_22115":926,"_18751":34910,"_5":22264,"_15096":34609,"_1571":34911},[],"**Con una solicitud de prueba**: invoca el endpoint `/cacerts` del DMS desde un cliente `curl` con la confianza del servidor. Una respuesta `200 OK` con contenido base64 confirma que el DMS está activo y que la CA de enrolamiento es accesible.",{"_7914":1036,"_22115":926,"_18751":34913,"_5":22264,"_15096":34609,"_1571":34914},[],"Si el DMS no existe o la CA no está disponible, el servidor responde con `DMS not found` u otro mensaje de error. Consulte la sección Diagnóstico y compatibilidad para interpretar los mensajes de error.",{"_7914":1037,"_22115":926,"_18751":34916,"_5":22264,"_15096":34613,"_1571":34917},[],"*Esta sección está dirigida al integrador de dispositivos.*",{"_7914":1038,"_22115":926,"_18751":34919,"_5":22264,"_15096":34613,"_1571":34920},[],"Los endpoints EST de Lamassu se publican bajo el prefijo `/.well-known/est` y exigen siempre la presencia del segmento de ruta `{aps}`, que se interpreta como el identificador del DMS al que se dirige la operación. La asociación es directa: el valor de `{aps}` recibido en la URL se utiliza como ID de DMS al consultar el almacén interno. Las variantes registradas sin `{aps}` (por ejemplo `/.well-known/est/cacerts`) están enrutadas en el código, pero su gestor exige el campo `APS` y devuelve `400 Bad Request` con el mensaje `Field validation for 'APS' failed` cuando el segmento no se proporciona.",{"_7914":1039,"_22115":926,"_18751":34922,"_5":22264,"_15096":34613,"_1571":34923},[],"Esta parte sigue el orden habitual de trabajo del integrador: primero los requisitos previos y el modelo de autenticación, después la referencia de cada endpoint y, al final, ejemplos completos y material de diagnóstico.",{"_7914":1040,"_22115":926,"_18751":34925,"_5":22264,"_15096":34617,"_1571":34926},[],"El administrador PKI debe haber configurado un DMS con el protocolo `EST_RFC7030`, una CA de enrolamiento asignada y al menos un modo de autenticación. Sin esa configuración previa, Lamassu rechaza cualquier solicitud de enrolamiento. Los detalles de esa configuración se encuentran en la sección de configuración del DMS de esta misma página.",{"_7914":1041,"_22115":926,"_18751":34928,"_5":22264,"_15096":34617,"_1571":34929},[],"Antes de realizar la primera llamada, asegúrese de tener:",{"_7914":1042,"_22115":926,"_18751":34931,"_5":22264,"_15096":34617,"_1571":34932},[],"Elemento",{"_7914":1043,"_22115":926,"_18751":34934,"_5":22264,"_15096":34617,"_1571":31984},[],{"_7914":1044,"_22115":926,"_18751":34936,"_5":22264,"_15096":34617,"_1571":34937},[],"**URL del host EST**",{"_7914":1045,"_22115":926,"_18751":34939,"_5":22264,"_15096":34617,"_1571":34940},[],"Dirección base del servidor, por ejemplo `https://est.lamassu.example`. La proporciona el administrador PKI.",{"_7914":1046,"_22115":926,"_18751":34942,"_5":22264,"_15096":34617,"_1571":34943},[],"**Ancla de confianza del servidor** (`lamassu-trust.pem`)",{"_7914":1047,"_22115":926,"_18751":34945,"_5":22264,"_15096":34617,"_1571":34946},[],"Certificado raíz o intermedio con el que validar el TLS del servidor Lamassu. Sin él, el cliente rechazará el certificado del servidor.",{"_7914":1048,"_22115":926,"_18751":34948,"_5":22264,"_15096":34617,"_1571":34949},[],"**Certificado bootstrap + clave privada**",{"_7914":1049,"_22115":926,"_18751":34951,"_5":22264,"_15096":34617,"_1571":34952},[],"Solo para modos `CLIENT_CERTIFICATE` o `CLIENT_CERTIFICATE_AND_EXTERNAL_WEBHOOK`. Es el certificado de aprovisionamiento emitido por alguna de las `ValidationCAs` del DMS, normalmente una CA dedicada al provisioning y distinta de la CA de enrolamiento.",{"_7914":1050,"_22115":926,"_18751":34954,"_5":22264,"_15096":34617,"_1571":34955},[],"**ID del DMS** (`{aps}`)",{"_7914":1051,"_22115":926,"_18751":34957,"_5":22264,"_15096":34617,"_1571":34958},[],"Identificador del DMS que aparece en todas las rutas EST. Lo proporciona el administrador PKI.",{"_7914":1052,"_22115":926,"_18751":34960,"_5":22264,"_15096":34621,"_1571":34961},[],"Caso",{"_7914":1053,"_22115":926,"_18751":34963,"_5":22264,"_15096":34621,"_1571":34964},[],"Credencial habitual",{"_7914":1054,"_22115":926,"_18751":34966,"_5":22264,"_15096":34621,"_1571":34967},[],"Endpoint principal",{"_7914":1055,"_22115":926,"_18751":34969,"_5":22264,"_15096":34621,"_1571":34970},[],"Resultado",{"_7914":1056,"_22115":926,"_18751":34972,"_5":22264,"_15096":34621,"_1571":34973},[],"Alta inicial",{"_7914":1057,"_22115":926,"_18751":34975,"_5":22264,"_15096":34621,"_1571":34976},[],"Certificado bootstrap o el modo definido en `AuthMode`",{"_7914":1058,"_22115":926,"_18751":34978,"_5":22264,"_15096":34621,"_1571":34638},[],{"_7914":1059,"_22115":926,"_18751":34980,"_5":22264,"_15096":34621,"_1571":34981},[],"Certificado de dispositivo",{"_7914":1060,"_22115":926,"_18751":34983,"_5":22264,"_15096":34621,"_1571":34984},[],"Renovación",{"_7914":1061,"_22115":926,"_18751":34986,"_5":22264,"_15096":34621,"_1571":34987},[],"Certificado actual del dispositivo",{"_7914":1062,"_22115":926,"_18751":34989,"_5":22264,"_15096":34621,"_1571":34642},[],{"_7914":1063,"_22115":926,"_18751":34991,"_5":22264,"_15096":34621,"_1571":34992},[],"Certificado renovado",{"_7914":1064,"_22115":926,"_18751":34994,"_5":22264,"_15096":34621,"_1571":34995},[],"Descarga de confianza",{"_7914":1065,"_22115":926,"_18751":34997,"_5":22264,"_15096":34621,"_1571":34998},[],"TLS del servidor",{"_7914":1066,"_22115":926,"_18751":35000,"_5":22264,"_15096":34621,"_1571":34634},[],{"_7914":1067,"_22115":926,"_18751":35002,"_5":22264,"_15096":34621,"_1571":35003},[],"PKCS#7 o PEM con certificados",{"_7914":1068,"_22115":926,"_18751":35005,"_5":22264,"_15096":34621,"_1571":35006},[],"Clave generada en servidor",{"_7914":1069,"_22115":926,"_18751":35008,"_5":22264,"_15096":34621,"_1571":35009},[],"Igual que `/simpleenroll`",{"_7914":1070,"_22115":926,"_18751":35011,"_5":22264,"_15096":34621,"_1571":34646},[],{"_7914":1071,"_22115":926,"_18751":35013,"_5":22264,"_15096":34621,"_1571":35014},[],"Clave privada PKCS#8 + certificado",{"_7914":1072,"_22115":926,"_18751":35016,"_5":22264,"_15096":34625,"_1571":35017},[],"La implementación de Lamassu reconoce cuatro configuraciones de autenticación para `/simpleenroll`, expresadas mediante el campo `EnrollmentOptionsESTRFC7030.AuthMode` del DMS. Tres son modos simples (`CLIENT_CERTIFICATE`, `EXTERNAL_WEBHOOK`, `NO_AUTH`) y una combina dos controles (`CLIENT_CERTIFICATE_AND_EXTERNAL_WEBHOOK`). El cliente debe presentarse en el modo que el DMS espera; cualquier otra combinación genera un fallo en la inscripción.",{"_7914":1073,"_22115":926,"_18751":35019,"_5":22264,"_15096":34625,"_1571":35020},[],"Modo (`AuthMode`)",{"_7914":1074,"_22115":926,"_18751":35022,"_5":22264,"_15096":34625,"_1571":31984},[],{"_7914":1075,"_22115":926,"_18751":35024,"_5":22264,"_15096":34625,"_1571":35025},[],"Credencial esperada",{"_7914":1076,"_22115":926,"_18751":35027,"_5":22264,"_15096":34625,"_1571":35028},[],"Aplica en enroll",{"_7914":1077,"_22115":926,"_18751":35030,"_5":22264,"_15096":34625,"_1571":35031},[],"Aplica en reenroll",{"_7914":1078,"_22115":926,"_18751":35033,"_5":22264,"_15096":34625,"_1571":34772},[],{"_7914":1079,"_22115":926,"_18751":35035,"_5":22264,"_15096":34625,"_1571":35036},[],"mTLS con certificado X.509",{"_7914":1080,"_22115":926,"_18751":35038,"_5":22264,"_15096":34625,"_1571":35039},[],"Certificado y clave privada cliente",{"_7914":1081,"_22115":926,"_18751":35041,"_5":22264,"_15096":34625,"_1571":33128},[],{"_7914":1082,"_22115":926,"_18751":35043,"_5":22264,"_15096":34625,"_1571":35044},[],"Sí (con el certificado en vigor)",{"_7914":1083,"_22115":926,"_18751":35046,"_5":22264,"_15096":34625,"_1571":34784},[],{"_7914":1084,"_22115":926,"_18751":35048,"_5":22264,"_15096":34625,"_1571":35049},[],"mTLS más validación por webhook",{"_7914":1085,"_22115":926,"_18751":35051,"_5":22264,"_15096":34625,"_1571":35052},[],"Certificado y clave privada cliente, más aprobación del webhook",{"_7914":1086,"_22115":926,"_18751":35054,"_5":22264,"_15096":34625,"_1571":33128},[],{"_7914":1087,"_22115":926,"_18751":35056,"_5":22264,"_15096":34625,"_1571":35057},[],"No como combinación; en reenroll no mantiene ambos controles",{"_7914":1088,"_22115":926,"_18751":35059,"_5":22264,"_15096":34625,"_1571":34778},[],{"_7914":1089,"_22115":926,"_18751":35061,"_5":22264,"_15096":34625,"_1571":35062},[],"Webhook externo de autorización",{"_7914":1090,"_22115":926,"_18751":35064,"_5":22264,"_15096":34625,"_1571":35065},[],"Ninguna en el canal TLS",{"_7914":1091,"_22115":926,"_18751":35067,"_5":22264,"_15096":34625,"_1571":33128},[],{"_7914":1092,"_22115":926,"_18751":35069,"_5":22264,"_15096":34625,"_1571":35070},[],"No, degrada a `NO_AUTH`",{"_7914":1093,"_22115":926,"_18751":35072,"_5":22264,"_15096":34625,"_1571":34790},[],{"_7914":1094,"_22115":926,"_18751":35074,"_5":22264,"_15096":34625,"_1571":35075},[],"Sin autenticación",{"_7914":1095,"_22115":926,"_18751":35077,"_5":22264,"_15096":34625,"_1571":35078},[],"Ninguna",{"_7914":1096,"_22115":926,"_18751":35080,"_5":22264,"_15096":34625,"_1571":35081},[],"Sí (uso restringido)",{"_7914":1097,"_22115":926,"_18751":35083,"_5":22264,"_15096":34625,"_1571":35081},[],{"_7914":1098,"_22115":926,"_18751":35085,"_5":22264,"_15096":34625,"_1571":35086},[],"JWT **no es un modo de autenticación válido en EST**. El extractor de identidad JWT existe en el código pero solo se evalúa en la API de administración de Lamassu. Cualquier *Bearer token* enviado a `/.well-known/est/...` se ignora silenciosamente. Cuando el DMS está configurado con `AuthMode: CLIENT_CERTIFICATE`, una petición que solo aporte JWT se rechaza por falta de certificado cliente. Cuando el DMS está en `AuthMode: NO_AUTH`, la petición se procesa como tal y el JWT no añade ni resta autorización.",{"_7914":1099,"_22115":926,"_18751":35088,"_5":22264,"_15096":34625,"_1571":35089},[],"**`CLIENT_CERTIFICATE`**: el cliente presenta un certificado X.509 emitido por una de las CAs declaradas en `AuthOptionsMTLS.ValidationCAs`. El proceso valida la cadena del certificado contra esas CAs mediante los parámetros `ValidationCAs`, `AllowExpired` y `ChainLevelValidation`. Además, el servicio comprueba el estado de revocación en tres pasos: primero busca el cert en la base de datos local de Lamassu; si no lo encuentra, consulta los responders OCSP listados en la extensión AIA; si OCSP falla, intenta los CRL Distribution Points (CDP). Un certificado revocado interrumpe la inscripción con `certificate is revoked`.",{"_7914":1100,"_22115":926,"_18751":35091,"_5":22264,"_15096":34625,"_1571":33112},[],{"_7914":1101,"_22115":926,"_18751":35093,"_5":22264,"_15096":34625,"_1571":33115},[],{"_7914":1102,"_22115":926,"_18751":35095,"_5":22264,"_15096":34625,"_1571":31984},[],{"_7914":1103,"_22115":926,"_18751":35097,"_5":22264,"_15096":34625,"_1571":35098},[],"`ValidationCAs`",{"_7914":1104,"_22115":926,"_18751":35100,"_5":22264,"_15096":34625,"_1571":35101},[],"lista de IDs de CA",{"_7914":1105,"_22115":926,"_18751":35103,"_5":22264,"_15096":34625,"_1571":35104},[],"CAs de confianza para validar el certificado bootstrap (en enroll) o el certificado en vigor (en reenroll).",{"_7914":1106,"_22115":926,"_18751":35106,"_5":22264,"_15096":34625,"_1571":35107},[],"`AllowExpired`",{"_7914":1107,"_22115":926,"_18751":35109,"_5":22264,"_15096":34625,"_1571":20460},[],{"_7914":1108,"_22115":926,"_18751":35111,"_5":22264,"_15096":34625,"_1571":35112},[],"Si está activado, acepta certificados cliente caducados. Si es `false`, los certificados expirados se rechazan.",{"_7914":1109,"_22115":926,"_18751":35114,"_5":22264,"_15096":34625,"_1571":35115},[],"`ChainLevelValidation`",{"_7914":1110,"_22115":926,"_18751":35117,"_5":22264,"_15096":34625,"_1571":4288},[],{"_7914":1111,"_22115":926,"_18751":35119,"_5":22264,"_15096":34625,"_1571":35120},[],"Si es mayor que cero, recorta la cadena de validación al número de niveles indicado.",{"_7914":1112,"_22115":926,"_18751":35122,"_5":22264,"_15096":34625,"_1571":35123},[],"**`EXTERNAL_WEBHOOK`**: Lamassu delega la decisión de autorización en un servicio HTTP externo. El servidor EST construye una petición `POST` al webhook configurado con un cuerpo JSON que reproduce el contexto de la inscripción.",{"_7914":1113,"_22115":926,"_18751":35125,"_5":22264,"_15096":34625,"_1571":35126},[],"El valor del campo `csr` es la **codificación base64 del PEM** del CSR (no el DER, y no el PEM en claro). El webhook debe responder con `2xx` y un cuerpo JSON `{\"authorized\": true}` para continuar; cualquier otra respuesta aborta el enrolamiento con `external webhook denied enrollment`. Un `204 No Content` **no es una respuesta válida** aunque sea un código `2xx`: Lamassu exige un cuerpo JSON con el campo `authorized`, así que un webhook que responda sin cuerpo deniega la operación igual que un error.",{"_7914":1114,"_22115":926,"_18751":35128,"_5":22264,"_15096":34625,"_1571":35129},[],"**`CLIENT_CERTIFICATE_AND_EXTERNAL_WEBHOOK`**: combina los dos modos anteriores durante `/simpleenroll` — el cliente debe presentar un certificado mTLS válido y el webhook debe devolver `authorized: true`. En `/simplereenroll` la combinación no se conserva: el chequeo conjunto mTLS + webhook no se mantiene, por lo que el integrador no debe asumir que las mismas garantías del enrollment inicial aplican en reenroll.",{"_7914":1115,"_22115":926,"_18751":35131,"_5":22264,"_15096":34625,"_1571":35132},[],"**`NO_AUTH`**: el DMS acepta cualquier CSR sin validar identidad del cliente. Lamassu emite un aviso en su log (`DMS is configured with NoAuth, allowing enrollment`) y procede al alta. Debe restringirse a entornos controlados (una red de aprovisionamiento aislada); cualquier red expuesta a internet con un DMS en `NO_AUTH` queda abierta a la emisión de certificados por terceros no autorizados.",{"_7914":1116,"_22115":926,"_18751":35134,"_5":22264,"_15096":34629,"_1571":35135},[],"Las siguientes secciones describen los endpoints en el orden más habitual de uso dentro del ciclo de vida del dispositivo:",{"_7914":1117,"_22115":926,"_18751":35137,"_5":22264,"_15096":34629,"_1571":35138},[],"`/cacerts`: descarga de la cadena de confianza.",{"_7914":1118,"_22115":926,"_18751":35140,"_5":22264,"_15096":34629,"_1571":35141},[],"`/simpleenroll`: inscripción inicial del certificado.",{"_7914":1119,"_22115":926,"_18751":35143,"_5":22264,"_15096":34629,"_1571":35144},[],"`/simplereenroll`: renovación de un certificado ya emitido.",{"_7914":1120,"_22115":926,"_18751":35146,"_5":22264,"_15096":34629,"_1571":35147},[],"`/serverkeygen`: inscripción con generación de clave en servidor.",{"_7914":1121,"_22115":926,"_18751":35149,"_5":22264,"_15096":34633,"_1571":35150},[],"El endpoint `GET /.well-known/est/{aps}/cacerts` distribuye los certificados que el dispositivo necesita para validar al servidor EST y al resto de las CAs gestionadas por el DMS. Lamassu inserta los certificados en este orden: primero el certificado **downstream** del servidor Lamassu, que es la hoja TLS del servidor y no una CA, útil para pinning si `IncludeLamassuSystemCA` está activado; después la lista `ManagedCAs` declarada en el DMS; y por último la CA de enrolamiento, si `IncludeEnrollmentCA` está activado.",{"_7914":1122,"_22115":926,"_18751":35152,"_5":22264,"_15096":34633,"_1571":35153},[],"Campo de `CADistributionSettings`",{"_7914":1123,"_22115":926,"_18751":35155,"_5":22264,"_15096":34633,"_1571":33115},[],{"_7914":1124,"_22115":926,"_18751":35157,"_5":22264,"_15096":34633,"_1571":31984},[],{"_7914":1125,"_22115":926,"_18751":35159,"_5":22264,"_15096":34633,"_1571":35160},[],"`IncludeLamassuSystemCA`",{"_7914":1126,"_22115":926,"_18751":35162,"_5":22264,"_15096":34633,"_1571":20460},[],{"_7914":1127,"_22115":926,"_18751":35164,"_5":22264,"_15096":34633,"_1571":35165},[],"Incluye el certificado *downstream* del servidor Lamassu, es decir, la hoja TLS que el cliente puede usar para anclar la conexión. Es un cert de extremo, no una CA.",{"_7914":1128,"_22115":926,"_18751":35167,"_5":22264,"_15096":34633,"_1571":35168},[],"`IncludeEnrollmentCA`",{"_7914":1129,"_22115":926,"_18751":35170,"_5":22264,"_15096":34633,"_1571":20460},[],{"_7914":1130,"_22115":926,"_18751":35172,"_5":22264,"_15096":34633,"_1571":35173},[],"Incluye la CA emisora del DMS, es decir, la que firmará los certificados de dispositivo.",{"_7914":1131,"_22115":926,"_18751":35175,"_5":22264,"_15096":34633,"_1571":35176},[],"`ManagedCAs`",{"_7914":1132,"_22115":926,"_18751":35178,"_5":22264,"_15096":34633,"_1571":35101},[],{"_7914":1133,"_22115":926,"_18751":35180,"_5":22264,"_15096":34633,"_1571":35181},[],"CAs adicionales que se publican como anclas de confianza al dispositivo.",{"_7914":1134,"_22115":926,"_18751":35183,"_5":22264,"_15096":34633,"_1571":35184},[],"El formato por defecto es PKCS#7 *degenerate* (sólo certificados) codificado en base64. La respuesta declara `Content-Type: application/pkcs7-mime; smime-type=certs-only` y `Content-Transfer-Encoding: base64`. El base64 viene troceado en líneas de **76 caracteres** terminadas en CRLF, una anchura conforme con S/MIME (RFC 5751), no los 64 que sugieren ciertas guías de RFC 7030. Este troceo aplica únicamente a `/cacerts` y `/simpleenroll`; las partes internas de `/serverkeygen` no llevan wrap, como se explica más abajo.",{"_7914":1135,"_22115":926,"_18751":35186,"_5":22264,"_15096":34633,"_1571":35187},[],"El PKCS#7 *degenerate* es un **conjunto** de certificados sin orden semántico definido. Aunque Lamassu los inserta en el orden indicado, el integrador no debe asumir ese orden al validar cadenas: la cadena debe construirse por correspondencia `Subject`/`Issuer` (o por AKI/SKI), no por la posición en la respuesta.",{"_7914":1136,"_22115":926,"_18751":35189,"_5":22264,"_15096":34633,"_1571":35190},[],"El flag `-i` (ignore garbage) ayuda a tolerar el CRLF que Lamassu añade y es necesario en algunos `base64` (BusyBox, BSD); en GNU coreutils se ignora.",{"_7914":1137,"_22115":926,"_18751":35192,"_5":22264,"_15096":34633,"_1571":35193},[],"Lamassu añade además una extensión sobre el RFC: si el cliente envía la cabecera `Accept: application/x-pem-file`, el servidor responde con la concatenación PEM de los mismos certificados, sin el envoltorio PKCS#7. Esto facilita el consumo desde scripts. La extensión también funciona en `/simpleenroll` y `/simplereenroll`.",{"_7914":1138,"_22115":926,"_18751":35195,"_5":22264,"_15096":34637,"_1571":35196},[],"El endpoint `POST /.well-known/est/{aps}/simpleenroll` recibe un CSR y devuelve el certificado emitido. El cuerpo de la petición debe ser el **PKCS#10 (CSR) en DER, codificado en base64** sin saltos de línea. La base64 envuelve directamente al DER, no al PEM. La cabecera `Content-Type` debe valer `application/pkcs10`. Si el `Content-Type` es diferente, el servidor responde `400` con `content-type must be application/pkcs10`; si el cuerpo no es base64 válido, responde `400` con `body payload must be base64 encoded`.",{"_7914":1139,"_22115":926,"_18751":35198,"_5":22264,"_15096":34637,"_1571":35199},[],"La respuesta sigue el mismo envoltorio que `/cacerts`: PKCS#7 *degenerate* en base64, con `Content-Type: application/pkcs7-mime; smime-type=certs-only`. El PKCS#7 contiene **únicamente el certificado de hoja** recién emitido; no incluye la CA emisora ni intermediarios. Esto cumple RFC 7030 §4.2.3 (donde la cadena es opcional) pero implica que el integrador debe combinar este certificado con la cadena obtenida de `/cacerts` antes de presentarlo a cualquier relying party que valide cadena completa (por ejemplo, un broker MQTT con mTLS estricta).",{"_7914":1140,"_22115":926,"_18751":35201,"_5":22264,"_15096":34637,"_1571":35202},[],"Varios campos del DMS gobiernan el comportamiento de `/simpleenroll`. El integrador no los configura, pero conviene conocerlos para interpretar los rechazos.",{"_7914":1141,"_22115":926,"_18751":35204,"_5":22264,"_15096":34637,"_1571":34829},[],{"_7914":1142,"_22115":926,"_18751":35206,"_5":22264,"_15096":34637,"_1571":33115},[],{"_7914":1143,"_22115":926,"_18751":35208,"_5":22264,"_15096":34637,"_1571":35209},[],"Efecto",{"_7914":1144,"_22115":926,"_18751":35211,"_5":22264,"_15096":34637,"_1571":35212},[],"`EnrollmentSettings.RegistrationMode`",{"_7914":1145,"_22115":926,"_18751":35214,"_5":22264,"_15096":34637,"_1571":35215},[],"`JITP` / `PRE_REGISTRATION`",{"_7914":1146,"_22115":926,"_18751":35217,"_5":22264,"_15096":34637,"_1571":35218},[],"Decide si el dispositivo se crea automáticamente en la primera inscripción (`JITP`) o si debe existir previamente (`PRE_REGISTRATION`).",{"_7914":1147,"_22115":926,"_18751":35220,"_5":22264,"_15096":34637,"_1571":35221},[],"`EnrollmentSettings.EnableReplaceableEnrollment`",{"_7914":1148,"_22115":926,"_18751":35223,"_5":22264,"_15096":34637,"_1571":20460},[],{"_7914":1149,"_22115":926,"_18751":35225,"_5":22264,"_15096":34637,"_1571":35226},[],"Si es `true`, un dispositivo ya enrolado puede volver a inscribirse mediante `/simpleenroll`; el certificado anterior se revoca con razón `superseded`. Si es `false`, el segundo intento se rechaza con `forbiddenNewEnrollment`.",{"_7914":1150,"_22115":926,"_18751":35228,"_5":22264,"_15096":34637,"_1571":35229},[],"`EnrollmentSettings.VerifyCSRSignature`",{"_7914":1151,"_22115":926,"_18751":35231,"_5":22264,"_15096":34637,"_1571":20460},[],{"_7914":1152,"_22115":926,"_18751":35233,"_5":22264,"_15096":34637,"_1571":35234},[],"Si es `true`, el servidor valida la firma del CSR contra la clave pública declarada en él (proof-of-possession estándar de PKCS#10/RFC 2986). Si es `false`, se omite la prueba de posesión. Para flotas IoT en redes abiertas debe estar en `true`.",{"_7914":1153,"_22115":926,"_18751":35236,"_5":22264,"_15096":34637,"_1571":35237},[],"En modo `JITP`, el primer `simpleenroll` con un `CommonName` que aún no existe en Lamassu crea el dispositivo automáticamente. En modo `PRE_REGISTRATION`, el dispositivo debe existir previamente; un `CommonName` desconocido se rechaza con `device not preregistered`. Consulte Configuración de enrollment para más detalles sobre ambos modos y el comportamiento del perfil de emisión.",{"_7914":1154,"_22115":926,"_18751":35239,"_5":22264,"_15096":34641,"_1571":35240},[],"El endpoint `POST /.well-known/est/{aps}/simplereenroll` renueva el certificado de un dispositivo ya enrolado. El formato del cuerpo es idéntico al de `/simpleenroll` (DER base64 sin saltos, `Content-Type: application/pkcs10`). La diferencia está en la autenticación: el cliente debe presentar **el certificado en vigor** del dispositivo (no el bootstrap) como credencial mTLS.",{"_7914":1155,"_22115":926,"_18751":35242,"_5":22264,"_15096":34641,"_1571":35243},[],"Si el DMS está configurado con `AuthMode: EXTERNAL_WEBHOOK`, el webhook **no se invoca** durante `/simplereenroll`. El flujo de renovación degrada silenciosamente a `NO_AUTH`: cualquier cliente que conozca un `CommonName` válido puede solicitar reenroll para ese dispositivo sin autenticación (`allowing reenroll: using NO AUTH mode` en el log). Un DMS con `EXTERNAL_WEBHOOK` no debe usarse en producción para flujos de reenroll a menos que se controle la red de acceso al endpoint.",{"_7914":1156,"_22115":926,"_18751":35245,"_5":22264,"_15096":34641,"_1571":35246},[],"El comportamiento del reenroll está condicionado por varios campos de `ReEnrollmentSettings`:",{"_7914":1157,"_22115":926,"_18751":35248,"_5":22264,"_15096":34641,"_1571":34829},[],{"_7914":1158,"_22115":926,"_18751":35250,"_5":22264,"_15096":34641,"_1571":33115},[],{"_7914":1159,"_22115":926,"_18751":35252,"_5":22264,"_15096":34641,"_1571":35209},[],{"_7914":1160,"_22115":926,"_18751":35254,"_5":22264,"_15096":34641,"_1571":35255},[],"`ReEnrollmentDelta`",{"_7914":1161,"_22115":926,"_18751":35257,"_5":22264,"_15096":34641,"_1571":35258},[],"duración",{"_7914":1162,"_22115":926,"_18751":35260,"_5":22264,"_15096":34641,"_1571":35261},[],"Define la ventana de renovación: el cliente solo puede renovar a partir de `NotAfter - ReEnrollmentDelta`. Antes de ese instante, el servidor responde con `invalid reenroll window`.",{"_7914":1163,"_22115":926,"_18751":35263,"_5":22264,"_15096":34641,"_1571":35264},[],"`EnableExpiredRenewal`",{"_7914":1164,"_22115":926,"_18751":35266,"_5":22264,"_15096":34641,"_1571":20460},[],{"_7914":1165,"_22115":926,"_18751":35268,"_5":22264,"_15096":34641,"_1571":35269},[],"Si es `true`, acepta certificados ya caducados como prueba de identidad. Si es `false`, un certificado expirado provoca `expired certificate`.",{"_7914":1166,"_22115":926,"_18751":35271,"_5":22264,"_15096":34641,"_1571":35272},[],"`RevokeOnReEnrollment`",{"_7914":1167,"_22115":926,"_18751":35274,"_5":22264,"_15096":34641,"_1571":20460},[],{"_7914":1168,"_22115":926,"_18751":35276,"_5":22264,"_15096":34641,"_1571":35277},[],"Si es `true`, revoca automáticamente el certificado anterior tras emitir el nuevo, con la razón `superseded` (código 4 de RFC 5280).",{"_7914":1169,"_22115":926,"_18751":35279,"_5":22264,"_15096":34641,"_1571":35280},[],"`AdditionalValidationCAs`",{"_7914":1170,"_22115":926,"_18751":35282,"_5":22264,"_15096":34641,"_1571":35101},[],{"_7914":1171,"_22115":926,"_18751":35284,"_5":22264,"_15096":34641,"_1571":35285},[],"CAs adicionales que el servidor admite como emisores válidos del certificado en vigor, además de la CA de enrolamiento del DMS.",{"_7914":1172,"_22115":926,"_18751":35287,"_5":22264,"_15096":34641,"_1571":35288},[],"**Inmutabilidad del subject**: el CSR de renovación debe tener exactamente el mismo subject que el certificado en vigor. Lamassu compara, byte a byte, el `RawSubject` del CSR con el del certificado (`slices.Compare`). Si los bytes difieren, el servidor cae a una comparación semántica de respaldo sobre los atributos `CommonName`, `OrganizationalUnit`, `Organization`, `Locality`, `Province` y `Country`. Si todos esos atributos coinciden, el reenroll continúa pese a la diferencia de bytes (rescata casos donde solo cambia la codificación, `PrintableString` frente a `UTF8String`). Si algún atributo difiere, el reenroll se aborta con `invalid RawSubject bytes`. El integrador debe regenerar el CSR con exactamente el mismo subject que en la inscripción inicial para no depender del comportamiento de fallback.",{"_7914":1173,"_22115":926,"_18751":35290,"_5":22264,"_15096":34641,"_1571":35291},[],"**Validación de la cadena del certificado presentado**: la validación se intenta primero contra la CA de enrolamiento del DMS; si falla, recorre las `AdditionalValidationCAs`. La validación es \"shallow\": cada CA se prueba como ancla, no se compone una cadena multinivel. El cliente debe presentar la cadena completa en el handshake mTLS. Un certificado revocado aborta el reenroll con `certificate is revoked`.",{"_7914":1174,"_22115":926,"_18751":35293,"_5":22264,"_15096":34645,"_1571":35294},[],"El endpoint `POST /.well-known/est/{aps}/serverkeygen` permite que Lamassu genere el par de claves del dispositivo en el servidor y devuelva, en la misma respuesta, la clave privada y el certificado emitido. Es útil para dispositivos con capacidad criptográfica limitada o flujos donde la clave se aprovisiona durante la fabricación.",{"_7914":1175,"_22115":926,"_18751":35296,"_5":22264,"_15096":34645,"_1571":35297},[],"Este endpoint requiere que `ServerKeyGen.Enabled` valga `true` en el DMS. Si no está activado, el servidor responde con `server key generation not enabled`. La autenticación se aplica igual que en `/simpleenroll`: el integrador presenta la credencial que corresponda al `AuthMode` del DMS.",{"_7914":1176,"_22115":926,"_18751":35299,"_5":22264,"_15096":34645,"_1571":35300},[],"El algoritmo y el tamaño de la clave generada se deciden por el DMS, no por el cliente.",{"_7914":1177,"_22115":926,"_18751":35302,"_5":22264,"_15096":34645,"_1571":35303},[],"Tipo de clave",{"_7914":1178,"_22115":926,"_18751":35305,"_5":22264,"_15096":34645,"_1571":35306},[],"Parámetro válido",{"_7914":1179,"_22115":926,"_18751":35308,"_5":22264,"_15096":34645,"_1571":35309},[],"Curva NIST equivalente",{"_7914":1180,"_22115":926,"_18751":35311,"_5":22264,"_15096":34645,"_1571":35312},[],"Comportamiento ante valores no válidos",{"_7914":1181,"_22115":926,"_18751":35314,"_5":22264,"_15096":34645,"_1571":35315},[],"`RSA`",{"_7914":1182,"_22115":926,"_18751":35317,"_5":22264,"_15096":34645,"_1571":35318},[],"Cualquier número de bits aceptado por `crypto/rsa` (típico: 2048, 3072, 4096)",{"_7914":1183,"_22115":926,"_18751":35320,"_5":22264,"_15096":34645,"_1571":35321},[],"No aplica",{"_7914":1184,"_22115":926,"_18751":35323,"_5":22264,"_15096":34645,"_1571":35324},[],"Si el valor no es válido para RSA, la generación falla y devuelve `500`.",{"_7914":1185,"_22115":926,"_18751":35326,"_5":22264,"_15096":34645,"_1571":35327},[],"`ECDSA`",{"_7914":1186,"_22115":926,"_18751":35329,"_5":22264,"_15096":34645,"_1571":35330},[],"224, 256, 384, 521",{"_7914":1187,"_22115":926,"_18751":35332,"_5":22264,"_15096":34645,"_1571":35333},[],"P-224 / P-256 (prime256v1) / P-384 / P-521",{"_7914":1188,"_22115":926,"_18751":35335,"_5":22264,"_15096":34645,"_1571":35336},[],"Cualquier otro valor degrada **silenciosamente** a P-256, solo con un aviso en log (`invalid key size of N for ECDSA. Defaulting to 256 curve`). El cliente no recibe error: el certificado se emite con una curva distinta de la solicitada.",{"_7914":1189,"_22115":926,"_18751":35338,"_5":22264,"_15096":34645,"_1571":35339},[],"El CSR enviado por el cliente sirve únicamente para transportar el subject y las extensiones; la prueba de posesión PKCS#10 no aplica aquí porque el cliente no es quien generó la clave. Lamassu descarta la clave pública del CSR original, genera un par de claves nuevo con su entropía interna, en motor software y no en un Crypto Engine de hardware como AWS KMS o PKCS#11, construye un CSR nuevo con esa clave y procede a una inscripción interna equivalente a `/simpleenroll`.",{"_7914":1190,"_22115":926,"_18751":35341,"_5":22264,"_15096":34645,"_1571":35342},[],"La respuesta es un `multipart/mixed` con el boundary literal `estServerLamassuBoundary`. Contiene dos partes:",{"_7914":1191,"_22115":926,"_18751":35344,"_5":22264,"_15096":34645,"_1571":35345},[],"La clave privada en formato **PKCS#8 sin cifrar**, codificada en base64 dentro de una parte con `Content-Type: application/pkcs8`.",{"_7914":1192,"_22115":926,"_18751":35347,"_5":22264,"_15096":34645,"_1571":35348},[],"El certificado emitido en PKCS#7 *degenerate* base64, dentro de una parte con `Content-Type: application/pkcs7-mime; smime-type=certs-only`.",{"_7914":1193,"_22115":926,"_18751":35350,"_5":22264,"_15096":34645,"_1571":35351},[],"A diferencia de `/cacerts` y `/simpleenroll`, donde el base64 va troceado en líneas de 76 caracteres, cada parte de `/serverkeygen` viaja como **una única línea base64 sin saltos**. Cualquier proxy inverso que reescriba el cuerpo (por ejemplo, normalizando line endings) puede romper el parseo.",{"_7914":1194,"_22115":926,"_18751":35353,"_5":22264,"_15096":34645,"_1571":35354},[],"Este endpoint invierte el principio PKI por el que el subscriber controla su clave privada. La clave se serializa en PKCS#8 sin cifrar (`PrivateKeyInfo`, sin `EncryptedPrivateKeyInfo`). No se aplica el envoltorio CMS `EnvelopedData` contemplado en RFC 7030 §4.4.2; no se aplica AES key wrap ni cifrado simétrico por contraseña. La única protección es el TLS del canal. El integrador debe garantizar que: (a) ningún proxy inverso termine TLS y registre el cuerpo de la respuesta; (b) la clave se cifre en reposo inmediatamente tras recibirla; (c) la cuenta de auditoría en el servidor Lamassu queda como punto único de origen de la clave.",{"_7914":1195,"_22115":926,"_18751":35356,"_5":22264,"_15096":34645,"_1571":35357},[],"Para separar las dos partes, el siguiente fragmento usa `awk` con el boundary literal. Funciona con la estructura exacta de Lamassu (cada parte = headers + línea en blanco + una sola línea base64); cualquier proxy intermedio que reescriba el cuerpo lo romperá.",{"_7914":1196,"_22115":926,"_18751":35359,"_5":22264,"_15096":34649,"_1571":35360},[],"Una vez revisados los endpoints por separado, estos ejemplos muestran cómo encadenarlos en dos escenarios habituales: el alta inicial de un dispositivo y la renovación de un certificado ya emitido.",{"_7914":1197,"_22115":926,"_18751":35362,"_5":22264,"_15096":34653,"_1571":35363},[],"El siguiente script ilustra el proceso completo de inscripción de un dispositivo con clave EC P-256 generada localmente y autenticación mTLS contra un certificado bootstrap.",{"_7914":1198,"_22115":926,"_18751":35365,"_5":22264,"_15096":34657,"_1571":35366},[],"El siguiente script reproduce un proceso de renovación: detecta la expiración del certificado actual, regenera el CSR con el **mismo subject** y se autentica con el certificado en vigor.",{"_7914":1199,"_22115":926,"_18751":35368,"_5":22264,"_15096":34661,"_1571":35369},[],"Una vez que el dispositivo ha obtenido su certificado de identidad, los pasos habituales son:",{"_7914":1200,"_22115":926,"_18751":35371,"_5":22264,"_15096":34661,"_1571":35372},[],"**Instalar la cadena de confianza** (`cacerts.pem`) en el almacén de confianza del dispositivo. El broker MQTT, el servidor HTTPS o cualquier relying party que valide mTLS necesitará esta cadena.",{"_7914":1201,"_22115":926,"_18751":35374,"_5":22264,"_15096":34661,"_1571":35375},[],"**Combinar el certificado de hoja con la cadena** antes de presentarlo en conexiones mTLS. La respuesta de `/simpleenroll` contiene solo el certificado de hoja; el relying party puede rechazar la conexión si no recibe la cadena completa.",{"_7914":1202,"_22115":926,"_18751":35377,"_5":22264,"_15096":34661,"_1571":35378},[],"**Planificar la renovación**: configurar en el dispositivo un temporizador que invoque `/simplereenroll` dentro de la ventana `ReEnrollmentDelta` antes de la caducidad del certificado. No espere a que caduque salvo que `EnableExpiredRenewal` esté activo.",{"_7914":1203,"_22115":926,"_18751":35380,"_5":22264,"_15096":34669,"_1571":35381},[],"Lamassu mapea casi todos los errores de negocio a `500 Internal Server Error`, no a `4xx`. El código de estado HTTP no es suficiente para distinguir entre un error de red y un error de política. El integrador debe inspeccionar el campo `err` del cuerpo JSON (`{\"err\": \"<mensaje>\"}`) para determinar la causa exacta del fallo.",{"_7914":1204,"_22115":926,"_18751":35383,"_5":22264,"_15096":34669,"_1571":35384},[],"HTTP",{"_7914":1205,"_22115":926,"_18751":35386,"_5":22264,"_15096":34669,"_1571":35387},[],"Mensaje",{"_7914":1206,"_22115":926,"_18751":35389,"_5":22264,"_15096":34669,"_1571":35390},[],"Causa",{"_7914":1207,"_22115":926,"_18751":35392,"_5":22264,"_15096":34669,"_1571":35393},[],"Acción del integrador",{"_7914":1208,"_22115":926,"_18751":35395,"_5":22264,"_15096":34669,"_1571":19571},[],{"_7914":1209,"_22115":926,"_18751":35397,"_5":22264,"_15096":34669,"_1571":35398},[],"`Field validation for 'APS' failed`",{"_7914":1210,"_22115":926,"_18751":35400,"_5":22264,"_15096":34669,"_1571":35401},[],"El segmento `{aps}` falta en la URL.",{"_7914":1211,"_22115":926,"_18751":35403,"_5":22264,"_15096":34669,"_1571":35404},[],"Incluir el ID del DMS en la ruta.",{"_7914":1212,"_22115":926,"_18751":35406,"_5":22264,"_15096":34669,"_1571":19571},[],{"_7914":1213,"_22115":926,"_18751":35408,"_5":22264,"_15096":34669,"_1571":35409},[],"`content-type must be application/pkcs10`",{"_7914":1214,"_22115":926,"_18751":35411,"_5":22264,"_15096":34669,"_1571":35412},[],"Cabecera `Content-Type` ausente o incorrecta.",{"_7914":1215,"_22115":926,"_18751":35414,"_5":22264,"_15096":34669,"_1571":35415},[],"Fijar `Content-Type: application/pkcs10`.",{"_7914":1216,"_22115":926,"_18751":35417,"_5":22264,"_15096":34669,"_1571":19571},[],{"_7914":1217,"_22115":926,"_18751":35419,"_5":22264,"_15096":34669,"_1571":35420},[],"`body payload must be base64 encoded`",{"_7914":1218,"_22115":926,"_18751":35422,"_5":22264,"_15096":34669,"_1571":35423},[],"El cuerpo no es base64 válido.",{"_7914":1219,"_22115":926,"_18751":35425,"_5":22264,"_15096":34669,"_1571":35426},[],"Usar `base64 -w 0` para evitar saltos de línea.",{"_7914":1220,"_22115":926,"_18751":35428,"_5":22264,"_15096":34669,"_1571":20096},[],{"_7914":1221,"_22115":926,"_18751":35430,"_5":22264,"_15096":34669,"_1571":35431},[],"`DMS not found`",{"_7914":1222,"_22115":926,"_18751":35433,"_5":22264,"_15096":34669,"_1571":35434},[],"El valor `{aps}` no se corresponde con ningún DMS.",{"_7914":1223,"_22115":926,"_18751":35436,"_5":22264,"_15096":34669,"_1571":35437},[],"Verificar el identificador con el administrador PKI.",{"_7914":1224,"_22115":926,"_18751":35439,"_5":22264,"_15096":34669,"_1571":20096},[],{"_7914":1225,"_22115":926,"_18751":35441,"_5":22264,"_15096":34669,"_1571":35442},[],"`invalid certificate`",{"_7914":1226,"_22115":926,"_18751":35444,"_5":22264,"_15096":34669,"_1571":35445},[],"El certificado cliente no es válido contra `ValidationCAs`.",{"_7914":1227,"_22115":926,"_18751":35447,"_5":22264,"_15096":34669,"_1571":35448},[],"Comprobar la cadena del certificado bootstrap.",{"_7914":1228,"_22115":926,"_18751":35450,"_5":22264,"_15096":34669,"_1571":20096},[],{"_7914":1229,"_22115":926,"_18751":35452,"_5":22264,"_15096":34669,"_1571":35453},[],"`certificate is revoked`",{"_7914":1230,"_22115":926,"_18751":35455,"_5":22264,"_15096":34669,"_1571":35456},[],"El certificado **presentado como credencial mTLS** está revocado en Lamassu o vía OCSP/CRL externos.",{"_7914":1231,"_22115":926,"_18751":35458,"_5":22264,"_15096":34669,"_1571":35459},[],"Solicitar un nuevo certificado bootstrap o investigar la revocación.",{"_7914":1232,"_22115":926,"_18751":35461,"_5":22264,"_15096":34669,"_1571":20096},[],{"_7914":1233,"_22115":926,"_18751":35463,"_5":22264,"_15096":34669,"_1571":35464},[],"`revoked certificate`",{"_7914":1234,"_22115":926,"_18751":35466,"_5":22264,"_15096":34669,"_1571":35467},[],"En reenroll, el certificado **activo del dispositivo en la base de datos** figura como revocado.",{"_7914":1235,"_22115":926,"_18751":35469,"_5":22264,"_15096":34669,"_1571":35470},[],"Revisar el estado del slot de identidad; si la revocación fue intencional, emitir un nuevo enroll en lugar de reenroll.",{"_7914":1236,"_22115":926,"_18751":35472,"_5":22264,"_15096":34669,"_1571":20096},[],{"_7914":1237,"_22115":926,"_18751":35474,"_5":22264,"_15096":34669,"_1571":35475},[],"`expired certificate`",{"_7914":1238,"_22115":926,"_18751":35477,"_5":22264,"_15096":34669,"_1571":35478},[],"El certificado presentado ha caducado y el DMS no permite `AllowExpired`/`EnableExpiredRenewal`.",{"_7914":1239,"_22115":926,"_18751":35480,"_5":22264,"_15096":34669,"_1571":35481},[],"Renovar antes de la caducidad o solicitar habilitar `EnableExpiredRenewal`.",{"_7914":1240,"_22115":926,"_18751":35483,"_5":22264,"_15096":34669,"_1571":20096},[],{"_7914":1241,"_22115":926,"_18751":35485,"_5":22264,"_15096":34669,"_1571":35486},[],"`forbiddenNewEnrollment`",{"_7914":1242,"_22115":926,"_18751":35488,"_5":22264,"_15096":34669,"_1571":35489},[],"El dispositivo ya está enrolado y `EnableReplaceableEnrollment` es `false`.",{"_7914":1243,"_22115":926,"_18751":35491,"_5":22264,"_15096":34669,"_1571":35492},[],"Usar `/simplereenroll` o pedir al administrador que habilite el flag.",{"_7914":1244,"_22115":926,"_18751":35494,"_5":22264,"_15096":34669,"_1571":20096},[],{"_7914":1245,"_22115":926,"_18751":35496,"_5":22264,"_15096":34669,"_1571":35497},[],"`device not preregistered`",{"_7914":1246,"_22115":926,"_18751":35499,"_5":22264,"_15096":34669,"_1571":35500},[],"El DMS está en `PRE_REGISTRATION` y el dispositivo no existe.",{"_7914":1247,"_22115":926,"_18751":35502,"_5":22264,"_15096":34669,"_1571":35503},[],"Registrar el dispositivo antes de inscribirlo.",{"_7914":1248,"_22115":926,"_18751":35505,"_5":22264,"_15096":34669,"_1571":20096},[],{"_7914":1249,"_22115":926,"_18751":35507,"_5":22264,"_15096":34669,"_1571":35508},[],"`invalid reenroll window`",{"_7914":1250,"_22115":926,"_18751":35510,"_5":22264,"_15096":34669,"_1571":35511},[],"Se intenta renovar antes de `NotAfter - ReEnrollmentDelta`.",{"_7914":1251,"_22115":926,"_18751":35513,"_5":22264,"_15096":34669,"_1571":35514},[],"Esperar a la apertura de la ventana o pedir un `ReEnrollmentDelta` mayor.",{"_7914":1252,"_22115":926,"_18751":35516,"_5":22264,"_15096":34669,"_1571":20096},[],{"_7914":1253,"_22115":926,"_18751":35518,"_5":22264,"_15096":34669,"_1571":35519},[],"`invalid RawSubject bytes`",{"_7914":1254,"_22115":926,"_18751":35521,"_5":22264,"_15096":34669,"_1571":35522},[],"El subject del CSR de renovación no coincide con el del certificado en vigor.",{"_7914":1255,"_22115":926,"_18751":35524,"_5":22264,"_15096":34669,"_1571":35525},[],"Regenerar el CSR con el subject exacto del cert anterior.",{"_7914":1256,"_22115":926,"_18751":35527,"_5":22264,"_15096":34669,"_1571":20096},[],{"_7914":1257,"_22115":926,"_18751":35529,"_5":22264,"_15096":34669,"_1571":35530},[],"`external webhook denied enrollment`",{"_7914":1258,"_22115":926,"_18751":35532,"_5":22264,"_15096":34669,"_1571":35533},[],"El webhook devolvió un código no `2xx` o `authorized != true`.",{"_7914":1259,"_22115":926,"_18751":35535,"_5":22264,"_15096":34669,"_1571":35536},[],"Revisar los logs del servicio webhook.",{"_7914":1260,"_22115":926,"_18751":35538,"_5":22264,"_15096":34669,"_1571":20096},[],{"_7914":1261,"_22115":926,"_18751":35540,"_5":22264,"_15096":34669,"_1571":35541},[],"`server key generation not enabled`",{"_7914":1262,"_22115":926,"_18751":35543,"_5":22264,"_15096":34669,"_1571":35544},[],"`/serverkeygen` está deshabilitado en el DMS.",{"_7914":1263,"_22115":926,"_18751":35546,"_5":22264,"_15096":34669,"_1571":35547},[],"Pedir al administrador activar `ServerKeyGen.Enabled`.",{"_7914":1264,"_22115":926,"_18751":35549,"_5":22264,"_15096":34669,"_1571":35550},[],"Para los mensajes que no figuren en esta tabla, los logs del servidor Lamassu (con los campos `func`, `dms`, `device-cn`, `step`, `auth-method`, `auth-status`) son el primer lugar donde buscar la causa.",{"_7914":1265,"_22115":926,"_18751":35552,"_5":22264,"_15096":34673,"_1571":35553},[],"La implementación de Lamassu se ajusta al RFC 7030 en lo esencial pero introduce varias particularidades que pueden afectar a clientes EST estrictos o a librerías de terceros:",{"_7914":1266,"_22115":926,"_18751":35555,"_5":22264,"_15096":34673,"_1571":35556},[],"Los endpoints `/csrattrs` y `/fullcmc` del RFC 7030 **no están implementados** en Lamassu. Un cliente que invoque `/.well-known/est/<DMS_ID>/csrattrs` recibirá `404 Not Found` en lugar del `204 No Content` que el RFC sugiere para \"sin atributos\". Las librerías EST estrictas deben configurarse para no intentar `csrattrs`.",{"_7914":1267,"_22115":926,"_18751":35558,"_5":22264,"_15096":34673,"_1571":35559},[],"El base64 de la respuesta de `/cacerts` y `/simpleenroll` se trocea en líneas de **76 caracteres** terminadas con CRLF (conforme con S/MIME, RFC 5751). Las partes de `/serverkeygen` no aplican wrap.",{"_7914":1268,"_22115":926,"_18751":35561,"_5":22264,"_15096":34673,"_1571":35562},[],"El boundary del `multipart/mixed` en `/serverkeygen` está fijado y no se puede negociar.",{"_7914":1269,"_22115":926,"_18751":35564,"_5":22264,"_15096":34673,"_1571":35565},[],"El segmento `{aps}` es **obligatorio** en todas las rutas EST. Las rutas registradas sin `{aps}` están en el código pero responden `400`.",{"_7914":1270,"_22115":926,"_18751":35567,"_5":22264,"_15096":34673,"_1571":35568},[],"El cuerpo de `/cacerts`, `/simpleenroll` y `/simplereenroll` puede devolverse como PEM concatenado si el cliente envía `Accept: application/x-pem-file`. Esta es una extensión específica de Lamassu y no aparece en el RFC.",{"_7914":1271,"_22115":926,"_18751":35570,"_5":22264,"_15096":34673,"_1571":35571},[],"El servidor no rechaza explícitamente CSRs firmados con SHA-1 o MD5; el integrador debe generar el CSR con SHA-256 o superior.",{"_7914":1272,"_22115":926,"_18751":35573,"_5":22264,"_15096":34673,"_1571":35574},[],"<Card title=\"Visión general del DMS\" href=\"/docs/manual/servicios-core/ra\" />",{"_7914":1273,"_22115":926,"_18751":35576,"_5":22264,"_15096":34673,"_1571":35577},[],"<Card title=\"Validación OCSP\" href=\"/docs/manual/servicios-core/validation-ocsp\" />",{"_7914":1274,"_22115":926,"_18751":35579,"_5":22264,"_15096":34673,"_1571":35580},[],"<Card title=\"Gestionar dispositivos\" href=\"/docs/manual/servicios-core/devices\" />",{"_7914":1275,"_22115":1275,"_5":22259,"_1571":35582,"_22272":35583,"_18751":35584,"_15096":1275},"[KMS] Gestión de Claves Criptográficas",[31781,32880,32889],[],{"_7914":1276,"_22115":1275,"_18751":35586,"_5":22264,"_15096":1275,"_1571":35587},[],"Gestión y operación de claves criptográficas en Lamassu IoT",{"_7914":1277,"_22115":1275,"_5":22269,"_18751":35589,"_15096":35590,"_1571":35591},[],"/docs/pr-preview/pr-20/manual/servicios-core/kms#gestión-de-claves-criptográficas","Gestión de claves criptográficas",{"_7914":1278,"_22115":1275,"_5":22269,"_18751":35593,"_15096":35594,"_1571":35595},[],"/docs/pr-preview/pr-20/manual/servicios-core/kms#qué-resuelve-el-kms","Qué resuelve el KMS",{"_7914":1279,"_22115":1275,"_5":22269,"_18751":35597,"_15096":35598,"_1571":35599},[],"/docs/pr-preview/pr-20/manual/servicios-core/kms#motores-criptográficos","Motores criptográficos",{"_7914":1280,"_22115":1275,"_5":22269,"_18751":35601,"_15096":35602,"_1571":35603},[],"/docs/pr-preview/pr-20/manual/servicios-core/kms#inventario-de-claves","Inventario de claves",{"_7914":1281,"_22115":1275,"_5":22269,"_18751":35605,"_15096":35606,"_1571":35607},[],"/docs/pr-preview/pr-20/manual/servicios-core/kms#crear-o-importar-claves","Crear o importar claves",{"_7914":1282,"_22115":1275,"_5":22269,"_18751":35609,"_15096":35610,"_1571":35611},[],"/docs/pr-preview/pr-20/manual/servicios-core/kms#generar-un-nuevo-par-de-claves","Generar un nuevo par de claves",{"_7914":1283,"_22115":1275,"_5":22269,"_18751":35613,"_15096":35614,"_1571":35615},[],"/docs/pr-preview/pr-20/manual/servicios-core/kms#importar-un-par-existente","Importar un par existente",{"_7914":1284,"_22115":1275,"_5":22269,"_18751":35617,"_15096":35618,"_1571":35619},[],"/docs/pr-preview/pr-20/manual/servicios-core/kms#operaciones-sobre-una-clave","Operaciones sobre una clave",{"_7914":1285,"_22115":1275,"_5":22269,"_18751":35621,"_15096":35622,"_1571":35623},[],"/docs/pr-preview/pr-20/manual/servicios-core/kms#ver-detalles","Ver detalles",{"_7914":1286,"_22115":1275,"_5":22269,"_18751":35625,"_15096":35626,"_1571":35627},[],"/docs/pr-preview/pr-20/manual/servicios-core/kms#firmar-y-verificar","Firmar y verificar",{"_7914":1287,"_22115":1275,"_5":22269,"_18751":35629,"_15096":35630,"_1571":35631},[],"/docs/pr-preview/pr-20/manual/servicios-core/kms#sign","Sign",{"_7914":1288,"_22115":1275,"_5":22269,"_18751":35633,"_15096":35634,"_1571":35635},[],"/docs/pr-preview/pr-20/manual/servicios-core/kms#verify","Verify",{"_7914":1289,"_22115":1275,"_5":22269,"_18751":35637,"_15096":35638,"_1571":35639},[],"/docs/pr-preview/pr-20/manual/servicios-core/kms#generar-un-csr","Generar un CSR",{"_7914":1290,"_22115":1275,"_5":22269,"_18751":35641,"_15096":35642,"_1571":35643},[],"/docs/pr-preview/pr-20/manual/servicios-core/kms#firma-local-con-pkcs11","Firma local con PKCS#11",{"_7914":1291,"_22115":1275,"_18751":35645,"_5":22264,"_15096":35590,"_1571":35646},[],"El servicio de Gestión de Claves Criptográficas (KMS) de Lamassu IoT centraliza la generación, importación, custodia y uso de las claves de la plataforma. Desde aquí se gestionan las claves que soportan a las CAs y al resto de operaciones de firma que dependen de la PKI.",{"_7914":1292,"_22115":1275,"_18751":35648,"_5":22264,"_15096":35590,"_1571":35649},[],"En la configuración actual, Lamassu IoT trabaja exclusivamente con claves asimétricas, como RSA y curvas elípticas. Estas claves se usan para emitir certificados X.509, firmar solicitudes y realizar operaciones de autenticación y validación dentro del sistema.",{"_7914":1293,"_22115":1275,"_18751":35651,"_5":22264,"_15096":35594,"_1571":35652},[],"El KMS unifica la gestión del ciclo de vida de las claves y evita que cada servicio tenga que integrarse directamente con un proveedor criptográfico concreto.",{"_7914":1294,"_22115":1275,"_18751":35654,"_5":22264,"_15096":35594,"_1571":35655},[],"En la práctica, permite:",{"_7914":1295,"_22115":1275,"_18751":35657,"_5":22264,"_15096":35594,"_1571":35658},[],"Generar nuevos pares de claves desde Lamassu IoT.",{"_7914":1296,"_22115":1275,"_18751":35660,"_5":22264,"_15096":35594,"_1571":35661},[],"Importar claves creadas externamente.",{"_7914":1297,"_22115":1275,"_18751":35663,"_5":22264,"_15096":35594,"_1571":35664},[],"Delegar la custodia y las operaciones criptográficas en motores externos.",{"_7914":1298,"_22115":1275,"_18751":35666,"_5":22264,"_15096":35594,"_1571":35667},[],"Reutilizar claves ya existentes para CAs, CSR y tareas de firma o verificación.",{"_7914":1299,"_22115":1275,"_18751":35669,"_5":22264,"_15096":35598,"_1571":35670},[],"Lamassu puede trabajar con distintos motores criptográficos según los requisitos del despliegue. En algunos entornos bastará con un motor software; en otros será necesario delegar la custodia en un HSM, en un servicio cloud o en una plataforma especializada.",{"_7914":1300,"_22115":1275,"_18751":35672,"_5":22264,"_15096":35598,"_1571":35673},[],"Una misma instancia puede tener varios motores configurados al mismo tiempo, incluso varias instancias del mismo tipo. Esto permite adaptar la operación a distintos niveles de seguridad, coste y requisitos regulatorios.",{"_7914":1301,"_22115":1275,"_18751":35675,"_5":22264,"_15096":35598,"_1571":35676},[],"Actualmente, Lamassu soporta los siguientes motores:",{"_7914":1302,"_22115":1275,"_18751":35678,"_5":22264,"_15096":35598,"_1571":35679},[],"Crypto Engine",{"_7914":1303,"_22115":1275,"_18751":35681,"_5":22264,"_15096":35598,"_1571":35682},[],"Nivel de seguridad",{"_7914":1304,"_22115":1275,"_18751":35684,"_5":22264,"_15096":35598,"_1571":35685},[],"OnPrem / Cloud",{"_7914":1305,"_22115":1275,"_18751":35687,"_5":22264,"_15096":35598,"_1571":35688},[],"Coste adicional",{"_7914":1306,"_22115":1275,"_18751":35690,"_5":22264,"_15096":35598,"_1571":35691},[],"Generación de claves",{"_7914":1307,"_22115":1275,"_18751":35693,"_5":22264,"_15096":35598,"_1571":35694},[],"Persistencia *at-rest* segura",{"_7914":1308,"_22115":1275,"_18751":35696,"_5":22264,"_15096":35598,"_1571":35697},[],"Filtración de claves",{"_7914":1309,"_22115":1275,"_18751":35699,"_5":22264,"_15096":35598,"_1571":35700},[],"Consideraciones",{"_7914":1310,"_22115":1275,"_18751":35702,"_5":22264,"_15096":35598,"_1571":35703},[],"File System",{"_7914":1311,"_22115":1275,"_18751":35705,"_5":22264,"_15096":35598,"_1571":11239},[],{"_7914":1312,"_22115":1275,"_18751":35707,"_5":22264,"_15096":35598,"_1571":35708},[],"OnPrem y Cloud",{"_7914":1313,"_22115":1275,"_18751":35710,"_5":22264,"_15096":35598,"_1571":33180},[],{"_7914":1314,"_22115":1275,"_18751":35712,"_5":22264,"_15096":35598,"_1571":35713},[],"**Entropía software**. La generación se realiza con las librerías criptográficas de Go.",{"_7914":1315,"_22115":1275,"_18751":35715,"_5":22264,"_15096":35598,"_1571":35716},[],"**Insegura**. Delegada en el sistema de archivos.",{"_7914":1316,"_22115":1275,"_18751":35718,"_5":22264,"_15096":35598,"_1571":35716},[],{"_7914":1317,"_22115":1275,"_18751":35720,"_5":22264,"_15096":35598,"_1571":35721},[],"No recomendado para producción.",{"_7914":1318,"_22115":1275,"_18751":35723,"_5":22264,"_15096":35598,"_1571":35724},[],"HashiCorp Vault",{"_7914":1319,"_22115":1275,"_18751":35726,"_5":22264,"_15096":35598,"_1571":4002},[],{"_7914":1320,"_22115":1275,"_18751":35728,"_5":22264,"_15096":35598,"_1571":35708},[],{"_7914":1321,"_22115":1275,"_18751":35730,"_5":22264,"_15096":35598,"_1571":33180},[],{"_7914":1322,"_22115":1275,"_18751":35732,"_5":22264,"_15096":35598,"_1571":35733},[],"Depende de la configuración de Vault.",{"_7914":1323,"_22115":1275,"_18751":35735,"_5":22264,"_15096":35598,"_1571":35736},[],"**Segura**",{"_7914":1324,"_22115":1275,"_18751":35738,"_5":22264,"_15096":35598,"_1571":35739},[],"**Insegura**. Un administrador con permisos suficientes puede visualizar la clave privada.",{"_7914":1325,"_22115":1275,"_18751":35741,"_5":22264,"_15096":35598,"_1571":35742},[],"Conviene limitar al máximo el acceso administrativo y custodiar correctamente las claves de *unseal*.",{"_7914":1326,"_22115":1275,"_18751":35744,"_5":22264,"_15096":35598,"_1571":35745},[],"AWS Secrets Manager",{"_7914":1327,"_22115":1275,"_18751":35747,"_5":22264,"_15096":35598,"_1571":4002},[],{"_7914":1328,"_22115":1275,"_18751":35749,"_5":22264,"_15096":35598,"_1571":35750},[],"Cloud",{"_7914":1329,"_22115":1275,"_18751":35752,"_5":22264,"_15096":35598,"_1571":33128},[],{"_7914":1330,"_22115":1275,"_18751":35754,"_5":22264,"_15096":35598,"_1571":35755},[],"Depende del proceso de alta de la clave.",{"_7914":1331,"_22115":1275,"_18751":35757,"_5":22264,"_15096":35598,"_1571":35736},[],{"_7914":1332,"_22115":1275,"_18751":35759,"_5":22264,"_15096":35598,"_1571":35739},[],{"_7914":1333,"_22115":1275,"_18751":35761,"_5":22264,"_15096":35598,"_1571":35762},[],"La protección *at-rest* la proporciona AWS, pero no evita el acceso administrativo al material privado.",{"_7914":1334,"_22115":1275,"_18751":35764,"_5":22264,"_15096":35598,"_1571":35765},[],"AWS KMS",{"_7914":1335,"_22115":1275,"_18751":35767,"_5":22264,"_15096":35598,"_1571":13367},[],{"_7914":1336,"_22115":1275,"_18751":35769,"_5":22264,"_15096":35598,"_1571":35750},[],{"_7914":1337,"_22115":1275,"_18751":35771,"_5":22264,"_15096":35598,"_1571":33128},[],{"_7914":1338,"_22115":1275,"_18751":35773,"_5":22264,"_15096":35598,"_1571":35774},[],"**Entropía hardware**",{"_7914":1339,"_22115":1275,"_18751":35776,"_5":22264,"_15096":35598,"_1571":35736},[],{"_7914":1340,"_22115":1275,"_18751":35778,"_5":22264,"_15096":35598,"_1571":35736},[],{"_7914":1341,"_22115":1275,"_18751":35780,"_5":22264,"_15096":35598,"_1571":35781},[],"Aunque la clave privada no se expone, un actor con permisos suficientes podría usarla para firmar artefactos.",{"_7914":1342,"_22115":1275,"_18751":35783,"_5":22264,"_15096":35598,"_1571":35784},[],"PKCS11",{"_7914":1343,"_22115":1275,"_18751":35786,"_5":22264,"_15096":35598,"_1571":35787},[],"3\\*",{"_7914":1344,"_22115":1275,"_18751":35789,"_5":22264,"_15096":35598,"_1571":35790},[],"AirGap OnPrem y Cloud",{"_7914":1345,"_22115":1275,"_18751":35792,"_5":22264,"_15096":35598,"_1571":35793},[],"Depende del hardware o del servicio usado. Puede integrarse con HSMs OnPrem o con ofertas Key as a Service.",{"_7914":1346,"_22115":1275,"_18751":35795,"_5":22264,"_15096":35598,"_1571":35774},[],{"_7914":1347,"_22115":1275,"_18751":35797,"_5":22264,"_15096":35598,"_1571":35798},[],"**Segura**\\*",{"_7914":1348,"_22115":1275,"_18751":35800,"_5":22264,"_15096":35598,"_1571":35801},[],"Depende del HSM",{"_7914":1349,"_22115":1275,"_18751":35803,"_5":22264,"_15096":35598,"_1571":35804},[],"El nivel real depende de la implementación PKCS11 y del HSM utilizado.",{"_7914":1350,"_22115":1275,"_18751":35806,"_5":22264,"_15096":35598,"_1571":35807},[],"Lamassu muestra en la consola el listado completo de motores habilitados.",{"_7914":1351,"_22115":1275,"_18751":35809,"_5":22264,"_15096":35598,"_1571":35810},[],"Cada motor define qué algoritmos soporta, como RSA o ECC/ECDSA, y qué tamaños de clave puede generar.",{"_7914":1352,"_22115":1275,"_18751":35812,"_5":22264,"_15096":35598,"_1571":35813},[],"Durante el despliegue es obligatorio definir un motor por defecto. Ese motor se utilizará cuando un proceso necesite crear o persistir una clave y el usuario no haya seleccionado uno específico, por ejemplo al crear o importar una CA.",{"_7914":1353,"_22115":1275,"_18751":35815,"_5":22264,"_15096":35602,"_1571":35816},[],"La pantalla principal de KMS muestra el inventario completo de claves registradas en el sistema. Es la vista de referencia para revisar qué claves existen, dónde están custodiadas y con qué entidades están relacionadas.",{"_7914":1354,"_22115":1275,"_18751":35818,"_5":22264,"_15096":35602,"_1571":35819},[],"La tabla incluye los siguientes campos:",{"_7914":1355,"_22115":1275,"_18751":35821,"_5":22264,"_15096":35602,"_1571":35822},[],"**Name**: nombre descriptivo de la clave.",{"_7914":1356,"_22115":1275,"_18751":35824,"_5":22264,"_15096":35602,"_1571":35825},[],"**Type**: algoritmo y tamaño de clave, por ejemplo RSA 2048 o EC P-256.",{"_7914":1357,"_22115":1275,"_18751":35827,"_5":22264,"_15096":35602,"_1571":35828},[],"**Strength**: indicador visual de fortaleza criptográfica.",{"_7914":1358,"_22115":1275,"_18751":35830,"_5":22264,"_15096":35602,"_1571":35831},[],"**Public/Private**: indica si Lamassu gestiona el par completo o solo la clave pública.",{"_7914":1359,"_22115":1275,"_18751":35833,"_5":22264,"_15096":35602,"_1571":35834},[],"**Crypto Engine**: motor criptográfico que custodia la clave.",{"_7914":1360,"_22115":1275,"_18751":35836,"_5":22264,"_15096":35602,"_1571":35837},[],"**Aliases**: nombres alternativos asociados a la clave.",{"_7914":1361,"_22115":1275,"_18751":35839,"_5":22264,"_15096":35602,"_1571":35840},[],"**Tags**: etiquetas para clasificación y búsqueda.",{"_7914":1362,"_22115":1275,"_18751":35842,"_5":22264,"_15096":35602,"_1571":35843},[],"**Related Entities**: certificados u otras entidades vinculadas a esa clave.",{"_7914":1363,"_22115":1275,"_18751":35845,"_5":22264,"_15096":35602,"_1571":35846},[],"Desde esta vista también se accede a las acciones más habituales:",{"_7914":1364,"_22115":1275,"_18751":35848,"_5":22264,"_15096":35602,"_1571":35849},[],"**View Details** para consultar metadatos, identificadores y relaciones.",{"_7914":1365,"_22115":1275,"_18751":35851,"_5":22264,"_15096":35602,"_1571":35852},[],"**Generate CSR** para crear una solicitud PKCS#10 con la clave seleccionada.",{"_7914":1366,"_22115":1275,"_18751":35854,"_5":22264,"_15096":35602,"_1571":35855},[],"**Sign / Verify** para probar operaciones criptográficas sobre la clave.",{"_7914":1367,"_22115":1275,"_18751":35857,"_5":22264,"_15096":35602,"_1571":35858},[],"**Delete Key** para eliminar la clave del sistema.",{"_7914":1368,"_22115":1275,"_18751":35860,"_5":22264,"_15096":35606,"_1571":35861},[],"El alta de claves se realiza desde el asistente que se abre con **Create New Key**.",{"_7914":1369,"_22115":1275,"_18751":35863,"_5":22264,"_15096":35610,"_1571":35864},[],"Si la clave va a nacer dentro de Lamassu, el flujo recomendado es generar un nuevo par gestionado directamente por uno de los motores configurados.",{"_7914":1370,"_22115":1275,"_18751":35866,"_5":22264,"_15096":35610,"_1571":35867},[],"En la primera pantalla del asistente, elija **Generate New Key Pair** y después defina los parámetros principales:",{"_7914":1371,"_22115":1275,"_18751":35869,"_5":22264,"_15096":35610,"_1571":35870},[],"**Key Name**: nombre único y descriptivo.",{"_7914":1372,"_22115":1275,"_18751":35872,"_5":22264,"_15096":35610,"_1571":35873},[],"**Crypto Engine**: motor que custodiará la clave.",{"_7914":1373,"_22115":1275,"_18751":35875,"_5":22264,"_15096":35610,"_1571":35876},[],"**Key Type** y **Key Size**: algoritmo y tamaño o curva.",{"_7914":1374,"_22115":1275,"_18751":35878,"_5":22264,"_15096":35610,"_1571":35879},[],"**Tags**: metadatos para clasificar la clave.",{"_7914":1375,"_22115":1275,"_18751":35881,"_5":22264,"_15096":35610,"_1571":35882},[],"**Metadata**: información adicional para usos avanzados.",{"_7914":1376,"_22115":1275,"_18751":35884,"_5":22264,"_15096":35614,"_1571":35885},[],"La importación permite registrar en Lamassu una clave generada fuera de la plataforma. Es el flujo habitual en escenarios BYOK, migraciones o integración con material criptográfico que ya está en producción.",{"_7914":1377,"_22115":1275,"_18751":35887,"_5":22264,"_15096":35614,"_1571":35888},[],"Cuando la clave se ha generado en un entorno aislado o en un HSM externo.",{"_7914":1378,"_22115":1275,"_18751":35890,"_5":22264,"_15096":35614,"_1571":35891},[],"Cuando se necesita migrar una PKI existente sin reemitir certificados.",{"_7914":1379,"_22115":1275,"_18751":35893,"_5":22264,"_15096":35614,"_1571":35894},[],"Cuando Lamassu debe operar con una raíz de confianza creada por un tercero.",{"_7914":1380,"_22115":1275,"_18751":35896,"_5":22264,"_15096":35614,"_1571":35897},[],"En el asistente, elija **Import Existing Key Pair** y complete los campos solicitados:",{"_7914":1381,"_22115":1275,"_18751":35899,"_5":22264,"_15096":35614,"_1571":35900},[],"**Key Name**: nombre descriptivo dentro de Lamassu IoT.",{"_7914":1382,"_22115":1275,"_18751":35902,"_5":22264,"_15096":35614,"_1571":35903},[],"**Crypto Engine**: motor que custodiará la clave importada.",{"_7914":1383,"_22115":1275,"_18751":35905,"_5":22264,"_15096":35614,"_1571":35906},[],"**Tags**: etiquetas para organización y búsqueda.",{"_7914":1384,"_22115":1275,"_18751":35908,"_5":22264,"_15096":35614,"_1571":35909},[],"**Metadata**: información adicional opcional.",{"_7914":1385,"_22115":1275,"_18751":35911,"_5":22264,"_15096":35614,"_1571":35912},[],"**Private Key (PEM)**: clave privada en formato PEM.",{"_7914":1386,"_22115":1275,"_18751":35914,"_5":22264,"_15096":35614,"_1571":35915},[],"Una vez completado el asistente, la clave queda almacenada en el motor seleccionado y puede utilizarse para firma, generación de CSR y el resto de operaciones soportadas por KMS.",{"_7914":1387,"_22115":1275,"_18751":35917,"_5":22264,"_15096":35618,"_1571":35918},[],"Cada clave registrada dispone de una vista de detalle y de varias acciones operativas.",{"_7914":1388,"_22115":1275,"_18751":35920,"_5":22264,"_15096":35622,"_1571":35921},[],"La pantalla **View Details** concentra la información técnica y administrativa de la clave.",{"_7914":1389,"_22115":1275,"_18751":35923,"_5":22264,"_15096":35622,"_1571":35924},[],"En la pestaña **Overview** se muestran, entre otros, estos campos:",{"_7914":1390,"_22115":1275,"_18751":35926,"_5":22264,"_15096":35622,"_1571":35927},[],"**Key Name**: nombre descriptivo.",{"_7914":1391,"_22115":1275,"_18751":35929,"_5":22264,"_15096":35622,"_1571":35930},[],"**Key Identifier**: identificador único del sistema. Lamassu utiliza formatos de ID basados en PKCS11.",{"_7914":1392,"_22115":1275,"_18751":35932,"_5":22264,"_15096":35622,"_1571":35933},[],"**Tags**: etiquetas asociadas.",{"_7914":1393,"_22115":1275,"_18751":35935,"_5":22264,"_15096":35622,"_1571":35936},[],"**Aliases**: nombres alternativos.",{"_7914":1394,"_22115":1275,"_18751":35938,"_5":22264,"_15096":35622,"_1571":35939},[],"**Crypto Engine**: motor en el que reside la clave.",{"_7914":1395,"_22115":1275,"_18751":35941,"_5":22264,"_15096":35622,"_1571":35942},[],"**Algorithm, Key Size & Strength**: algoritmo, parámetros y nivel de fortaleza.",{"_7914":1396,"_22115":1275,"_18751":35944,"_5":22264,"_15096":35622,"_1571":35945},[],"La sección **Related Entities** muestra qué objetos de Lamassu dependen de esa clave.",{"_7914":1397,"_22115":1275,"_18751":35947,"_5":22264,"_15096":35622,"_1571":35948},[],"La pestaña **Public Key** presenta la clave pública en formato PEM, lista para consulta o copia.",{"_7914":1398,"_22115":1275,"_18751":35950,"_5":22264,"_15096":35626,"_1571":35951},[],"La acción **Sign / Verify** sirve para validar que la clave y el motor criptográfico funcionan correctamente.",{"_7914":1399,"_22115":1275,"_18751":35953,"_5":22264,"_15096":35626,"_1571":35954},[],"Al abrirla aparecen dos áreas: **Sign** y **Verify**.",{"_7914":1400,"_22115":1275,"_18751":35956,"_5":22264,"_15096":35630,"_1571":35957},[],"Esta pestaña usa la clave privada para generar una firma digital sobre un mensaje o sobre un *digest* ya calculado.",{"_7914":1401,"_22115":1275,"_18751":35959,"_5":22264,"_15096":35630,"_1571":35960},[],"Campos principales:",{"_7914":1402,"_22115":1275,"_18751":35962,"_5":22264,"_15096":35630,"_1571":35963},[],"**Algorithm**: algoritmo de firma disponible para el tipo de clave.",{"_7914":1403,"_22115":1275,"_18751":35965,"_5":22264,"_15096":35630,"_1571":35966},[],"**Message Type**: `Raw` para datos en claro o `Digest` para un hash precalculado.",{"_7914":1404,"_22115":1275,"_18751":35968,"_5":22264,"_15096":35630,"_1571":35969},[],"**Payload Encoding**: codificación de entrada, como UTF-8, Hex o Base64.",{"_7914":1405,"_22115":1275,"_18751":35971,"_5":22264,"_15096":35630,"_1571":35972},[],"**Message**: contenido que se va a firmar.",{"_7914":1406,"_22115":1275,"_18751":35974,"_5":22264,"_15096":35630,"_1571":35975},[],"**Signature**: resultado de la operación, mostrado en hexadecimal.",{"_7914":1407,"_22115":1275,"_18751":35977,"_5":22264,"_15096":35634,"_1571":35978},[],"Esta pestaña comprueba si una firma corresponde a la clave pública asociada.",{"_7914":1408,"_22115":1275,"_18751":35980,"_5":22264,"_15096":35634,"_1571":35960},[],{"_7914":1409,"_22115":1275,"_18751":35982,"_5":22264,"_15096":35634,"_1571":35983},[],"**Algorithm**: debe coincidir con el algoritmo usado para la firma.",{"_7914":1410,"_22115":1275,"_18751":35985,"_5":22264,"_15096":35634,"_1571":35986},[],"**Message Type**: `Raw` o `Digest`.",{"_7914":1411,"_22115":1275,"_18751":35988,"_5":22264,"_15096":35634,"_1571":35989},[],"**Payload Encoding**: codificación del mensaje.",{"_7914":1412,"_22115":1275,"_18751":35991,"_5":22264,"_15096":35634,"_1571":35992},[],"**Message**: mensaje original o hash.",{"_7914":1413,"_22115":1275,"_18751":35994,"_5":22264,"_15096":35634,"_1571":35995},[],"**Signature**: firma que se desea comprobar.",{"_7914":1414,"_22115":1275,"_18751":35997,"_5":22264,"_15096":35634,"_1571":35998},[],"**Result**: indicador del resultado de la validación.",{"_7914":1415,"_22115":1275,"_18751":36000,"_5":22264,"_15096":35638,"_1571":36001},[],"La acción **Generate CSR** crea una solicitud PKCS#10 firmada con la clave privada custodiada en Lamassu, sin exponerla fuera del motor criptográfico.",{"_7914":1416,"_22115":1275,"_18751":36003,"_5":22264,"_15096":35638,"_1571":36004},[],"Este flujo es útil para:",{"_7914":1417,"_22115":1275,"_18751":36006,"_5":22264,"_15096":35638,"_1571":36007},[],"Solicitar certificados a una CA externa.",{"_7914":1418,"_22115":1275,"_18751":36009,"_5":22264,"_15096":35638,"_1571":36010},[],"Renovar una identidad manteniendo la misma clave.",{"_7914":1419,"_22115":1275,"_18751":36012,"_5":22264,"_15096":35638,"_1571":36013},[],"Al abrir el formulario se solicitan los datos del sujeto y los atributos principales del certificado:",{"_7914":1420,"_22115":1275,"_18751":36015,"_5":22264,"_15096":35638,"_1571":36016},[],"**Common Name (CN)**: nombre principal de la identidad.",{"_7914":1421,"_22115":1275,"_18751":36018,"_5":22264,"_15096":35638,"_1571":36019},[],"**Organization (O)**: organización o empresa.",{"_7914":1422,"_22115":1275,"_18751":36021,"_5":22264,"_15096":35638,"_1571":36022},[],"**Organizational Unit (OU)**: departamento o unidad.",{"_7914":1423,"_22115":1275,"_18751":36024,"_5":22264,"_15096":35638,"_1571":36025},[],"**Country (C)**: código de país de dos letras.",{"_7914":1424,"_22115":1275,"_18751":36027,"_5":22264,"_15096":35638,"_1571":36028},[],"**State / Province (ST)**: estado o provincia.",{"_7914":1425,"_22115":1275,"_18751":36030,"_5":22264,"_15096":35638,"_1571":36031},[],"**Locality (L)**: ciudad o localidad.",{"_7914":1426,"_22115":1275,"_18751":36033,"_5":22264,"_15096":35638,"_1571":36034},[],"**Email Address**: correo de contacto.",{"_7914":1427,"_22115":1275,"_18751":36036,"_5":22264,"_15096":35638,"_1571":36037},[],"**Subject Alternative Names (SANs)**: nombres o identificadores alternativos, como DNS o IP.",{"_7914":1428,"_22115":1275,"_18751":36039,"_5":22264,"_15096":35638,"_1571":36040},[],"Una vez completado el formulario, Lamassu genera la CSR y la presenta para su descarga o copia.",{"_7914":1429,"_22115":1275,"_18751":36042,"_5":22264,"_15096":35642,"_1571":36043},[],"Lamassu también ofrece una ayuda específica para integraciones locales mediante **Sign locally with OpenSSL & PKCS11 tools**.",{"_7914":1430,"_22115":1275,"_18751":36045,"_5":22264,"_15096":35642,"_1571":36046},[],"Esta opción muestra los pasos necesarios para configurar el entorno local, cargar el módulo PKCS#11 y ejecutar firmas con herramientas como OpenSSL sin extraer la clave privada del entorno custodiado.",{"_7914":1431,"_22115":1431,"_5":22259,"_1571":36048,"_22272":36049,"_18751":36050,"_15096":1431},"[DMS] Device Management Service",[31781,32880,32889],[],{"_7914":1432,"_22115":1431,"_18751":36052,"_5":22264,"_15096":1431,"_1571":36053},[],"Visión general del Device Management Service en Lamassu IoT - concepto, panel de gestión y configuración común a todos los protocolos de enrolamiento.",{"_7914":1433,"_22115":1431,"_5":22269,"_18751":36055,"_15096":36056,"_1571":36057},[],"/docs/pr-preview/pr-20/manual/servicios-core/ra#device-management-service","Device Management Service",{"_7914":1434,"_22115":1431,"_5":22269,"_18751":36059,"_15096":36060,"_1571":34618},[],"/docs/pr-preview/pr-20/manual/servicios-core/ra#antes-de-empezar",{"_7914":1435,"_22115":1431,"_5":22269,"_18751":36062,"_15096":36063,"_1571":36064},[],"/docs/pr-preview/pr-20/manual/servicios-core/ra#panel-de-dms","Panel de DMS",{"_7914":1436,"_22115":1431,"_5":22269,"_18751":36066,"_15096":36067,"_1571":36068},[],"/docs/pr-preview/pr-20/manual/servicios-core/ra#distribución-de-entidades-de-confianza","Distribución de entidades de confianza",{"_7914":1437,"_22115":1431,"_5":22269,"_18751":36070,"_15096":36071,"_1571":36072},[],"/docs/pr-preview/pr-20/manual/servicios-core/ra#protocolos-de-enrolamiento","Protocolos de enrolamiento",{"_7914":1438,"_22115":1431,"_18751":36074,"_5":22264,"_15096":36056,"_1571":36075},[],"El &#x2A;*DMS (Device Management Service)** es el componente de Lamassu IoT que actúa como Autoridad de Registro (RA) frente a los dispositivos. Cada DMS recibe las solicitudes de certificado, valida la identidad del solicitante según las políticas configuradas y encarga la emisión a la CA asignada. El resultado es un canal de aprovisionamiento controlado e independiente por flota, línea de producto o entorno.",{"_7914":1439,"_22115":1431,"_18751":36077,"_5":22264,"_15096":36056,"_1571":36078},[],"En la práctica, cada DMS representa un punto de entrada diferenciado: tiene su propia CA de enrolamiento, sus propias reglas de autenticación y su propia ventana de renovación. Una organización puede operar varios DMS en paralelo - por ejemplo, uno para dispositivos de campo y otro para pasarelas internas - con políticas completamente distintas en cada caso.",{"_7914":1440,"_22115":1431,"_18751":36080,"_5":22264,"_15096":36060,"_1571":36081},[],"Para crear un DMS es necesario que exista al menos una CA activa en la plataforma, ya que el DMS requiere seleccionar una CA de enrolamiento. El usuario debe disponer del rol de administrador PKI o de permisos equivalentes sobre el módulo DMS.",{"_7914":1441,"_22115":1431,"_18751":36083,"_5":22264,"_15096":36063,"_1571":36084},[],"El panel lista todos los DMS configurados en la plataforma. Cada entrada muestra el nombre del DMS, el protocolo de enrolamiento activo y la CA de enrolamiento asignada. Desde el menú de opciones de cada DMS están disponibles las siguientes acciones:",{"_7914":1442,"_22115":1431,"_18751":36086,"_5":22264,"_15096":36063,"_1571":36087},[],"Acción",{"_7914":1443,"_22115":1431,"_18751":36089,"_5":22264,"_15096":36063,"_1571":31984},[],{"_7914":1444,"_22115":1431,"_18751":36091,"_5":22264,"_15096":36063,"_1571":36092},[],"**Edit**",{"_7914":1445,"_22115":1431,"_18751":36094,"_5":22264,"_15096":36063,"_1571":36095},[],"Modifica la configuración del DMS.",{"_7914":1446,"_22115":1431,"_18751":36097,"_5":22264,"_15096":36063,"_1571":36098},[],"**Go to DMS owned devices**",{"_7914":1447,"_22115":1431,"_18751":36100,"_5":22264,"_15096":36063,"_1571":36101},[],"Abre el listado de dispositivos gestionados por este DMS.",{"_7914":1448,"_22115":1431,"_18751":36103,"_5":22264,"_15096":36063,"_1571":36104},[],"**Show/Edit Metadata**",{"_7914":1449,"_22115":1431,"_18751":36106,"_5":22264,"_15096":36063,"_1571":36107},[],"Accede a los metadatos del DMS para usos avanzados.",{"_7914":1450,"_22115":1431,"_18751":36109,"_5":22264,"_15096":36063,"_1571":36110},[],"**EST (RFC-7030)**",{"_7914":1451,"_22115":1431,"_18751":36112,"_5":22264,"_15096":36063,"_1571":36113},[],"Muestra los endpoints EST del DMS con su URL base y ejemplos de invocación.",{"_7914":1452,"_22115":1431,"_18751":36115,"_5":22264,"_15096":36063,"_1571":36116},[],"**Delete**",{"_7914":1453,"_22115":1431,"_18751":36118,"_5":22264,"_15096":36063,"_1571":36119},[],"Elimina el DMS y su configuración. Acción irreversible.",{"_7914":1454,"_22115":1431,"_18751":36121,"_5":22264,"_15096":36067,"_1571":36122},[],"La sección **CA Distribution** controla qué certificados de CA recibe el dispositivo al consultar el endpoint de distribución de confianza del protocolo activo. Esta configuración es independiente del protocolo de enrolamiento: los parámetros tienen el mismo significado con independencia de cómo el dispositivo obtenga sus certificados.",{"_7914":1455,"_22115":1431,"_18751":36124,"_5":22264,"_15096":36067,"_1571":33112},[],{"_7914":1456,"_22115":1431,"_18751":36126,"_5":22264,"_15096":36067,"_1571":31984},[],{"_7914":1457,"_22115":1431,"_18751":36128,"_5":22264,"_15096":36067,"_1571":36129},[],"**Include Lamassu System CA**",{"_7914":1458,"_22115":1431,"_18751":36131,"_5":22264,"_15096":36067,"_1571":36132},[],"Incluye el certificado TLS del servidor Lamassu en la respuesta. Este es el certificado de extremo del servidor, no una CA - útil para *pinning* de la conexión.",{"_7914":1459,"_22115":1431,"_18751":36134,"_5":22264,"_15096":36067,"_1571":36135},[],"**Include Enrollment CA**",{"_7914":1460,"_22115":1431,"_18751":36137,"_5":22264,"_15096":36067,"_1571":36138},[],"Incluye la CA emisora configurada en este DMS, es decir, la que firmará los certificados de dispositivo.",{"_7914":1461,"_22115":1431,"_18751":36140,"_5":22264,"_15096":36067,"_1571":36141},[],"**Managed CAs**",{"_7914":1462,"_22115":1431,"_18751":36143,"_5":22264,"_15096":36067,"_1571":36144},[],"CAs adicionales distribuidas al dispositivo como anclas de confianza.",{"_7914":1463,"_22115":1431,"_18751":36146,"_5":22264,"_15096":36071,"_1571":36147},[],"El DMS expone un protocolo de enrolamiento a los dispositivos. En la versión actual de Lamassu, el único protocolo soportado es &#x2A;*EST (RFC 7030)**. La configuración del protocolo y la guía de integración para dispositivos se encuentran en las páginas correspondientes.",{"_7914":1464,"_22115":1431,"_18751":36149,"_5":22264,"_15096":36071,"_1571":36150},[],"<Card title=\"EST (RFC 7030)\" href=\"/docs/manual/servicios-core/est\" />",{"_7914":1465,"_22115":1431,"_18751":36152,"_5":22264,"_15096":36071,"_1571":35580},[],{"_7914":1466,"_22115":1466,"_5":22259,"_1571":36154,"_22272":36155,"_18751":36156,"_15096":1466},"[VA] Servicio CRL",[31781,32880,32889],[],{"_7914":1467,"_22115":1466,"_18751":36158,"_5":22264,"_15096":1466,"_1571":36159},[],"Gestión y consulta de listas de revocación para validación offline",{"_7914":1468,"_22115":1466,"_5":22269,"_18751":36161,"_15096":36162,"_1571":36163},[],"/docs/pr-preview/pr-20/manual/servicios-core/validation-crl#servicio-crl","Servicio CRL",{"_7914":1469,"_22115":1466,"_5":22269,"_18751":36165,"_15096":36166,"_1571":36167},[],"/docs/pr-preview/pr-20/manual/servicios-core/validation-crl#rol-va-y-configuración-por-ca","Rol VA y configuración por CA",{"_7914":1470,"_22115":1466,"_5":22269,"_18751":36169,"_15096":36170,"_1571":36171},[],"/docs/pr-preview/pr-20/manual/servicios-core/validation-crl#regeneración-periódica-y-automática","Regeneración periódica y automática",{"_7914":1471,"_22115":1466,"_5":22269,"_18751":36173,"_15096":36174,"_1571":36175},[],"/docs/pr-preview/pr-20/manual/servicios-core/validation-crl#contenido-de-la-crl","Contenido de la CRL",{"_7914":1472,"_22115":1466,"_5":22269,"_18751":36177,"_15096":36178,"_1571":36179},[],"/docs/pr-preview/pr-20/manual/servicios-core/validation-crl#endpoint-público-de-descarga","Endpoint público de descarga",{"_7914":1473,"_22115":1466,"_5":22269,"_18751":36181,"_15096":36182,"_1571":36183},[],"/docs/pr-preview/pr-20/manual/servicios-core/validation-crl#api-de-gestión-del-rol-va","API de gestión del rol VA",{"_7914":1474,"_22115":1466,"_5":22269,"_18751":36185,"_15096":36186,"_1571":36187},[],"/docs/pr-preview/pr-20/manual/servicios-core/validation-crl#desde-la-interfaz","Desde la interfaz",{"_7914":1475,"_22115":1466,"_5":22269,"_18751":36189,"_15096":36190,"_1571":36191},[],"/docs/pr-preview/pr-20/manual/servicios-core/validation-crl#referencias","Referencias",{"_7914":1476,"_22115":1466,"_18751":36193,"_5":22264,"_15096":36162,"_1571":36194},[],"Una CRL (*Certificate Revocation List*) es una lista firmada que contiene los números de serie de los certificados revocados antes de su fecha de caducidad. A diferencia de OCSP, no requiere una consulta en tiempo real: la parte que confía descarga la lista periódicamente y la consulta de forma local.",{"_7914":1477,"_22115":1466,"_18751":36196,"_5":22264,"_15096":36162,"_1571":36197},[],"Lamassu genera y mantiene una CRL por cada CA que gestiona. Cada CRL está firmada con la clave privada de la propia CA emisora y se almacena en el sistema de almacenamiento de objetos configurado en la plataforma.",{"_7914":1478,"_22115":1466,"_18751":36199,"_5":22264,"_15096":36166,"_1571":36200},[],"La publicación de la CRL de cada CA se controla mediante un *rol VA*. Este objeto define cómo se genera, cuándo se regenera y qué clave se utiliza para firmarla.",{"_7914":1479,"_22115":1466,"_18751":36202,"_5":22264,"_15096":36166,"_1571":36203},[],"Los parámetros principales son:",{"_7914":1480,"_22115":1466,"_18751":36205,"_5":22264,"_15096":36166,"_1571":33112},[],{"_7914":1481,"_22115":1466,"_18751":36207,"_5":22264,"_15096":36166,"_1571":31981},[],{"_7914":1482,"_22115":1466,"_18751":36209,"_5":22264,"_15096":36166,"_1571":31984},[],{"_7914":1483,"_22115":1466,"_18751":36211,"_5":22264,"_15096":36166,"_1571":36212},[],"`validity`",{"_7914":1484,"_22115":1466,"_18751":36214,"_5":22264,"_15096":36166,"_1571":36215},[],"7 días",{"_7914":1485,"_22115":1466,"_18751":36217,"_5":22264,"_15096":36166,"_1571":36218},[],"Período de validez de cada CRL emitida, reflejado en el campo `nextUpdate`.",{"_7914":1486,"_22115":1466,"_18751":36220,"_5":22264,"_15096":36166,"_1571":36221},[],"`refresh_interval`",{"_7914":1487,"_22115":1466,"_18751":36223,"_5":22264,"_15096":36166,"_1571":36224},[],"\\~6 días y 23 horas",{"_7914":1488,"_22115":1466,"_18751":36226,"_5":22264,"_15096":36166,"_1571":36227},[],"Intervalo mínimo entre regeneraciones periódicas programadas.",{"_7914":1489,"_22115":1466,"_18751":36229,"_5":22264,"_15096":36166,"_1571":36230},[],"`regenerate_on_revoke`",{"_7914":1490,"_22115":1466,"_18751":36232,"_5":22264,"_15096":36166,"_1571":36233},[],"`true`",{"_7914":1491,"_22115":1466,"_18751":36235,"_5":22264,"_15096":36166,"_1571":36236},[],"Cuando se revoca un certificado, se genera una nueva CRL de inmediato sin esperar al ciclo periódico.",{"_7914":1492,"_22115":1466,"_18751":36238,"_5":22264,"_15096":36166,"_1571":36239},[],"El campo `subject_key_id_signer` identifica la CA cuya clave privada firma la CRL. Por defecto, cada CA firma su propia CRL.",{"_7914":1493,"_22115":1466,"_18751":36241,"_5":22264,"_15096":36166,"_1571":36242},[],"Cada CRL lleva un número de versión incremental. Lamassu almacena todas las versiones en la ruta `pki/va/crl/{subject_key_id}/{version}.crl` del almacenamiento de objetos.",{"_7914":1494,"_22115":1466,"_18751":36244,"_5":22264,"_15096":36170,"_1571":36245},[],"Un proceso en segundo plano supervisa los roles VA activos. Cuando la validez restante de la CRL vigente cae por debajo del período de vigilancia configurado (*blind period*), el sistema solicita la generación de una nueva CRL. Así se evita que la CRL publicada caduque sin que exista una versión válida disponible.",{"_7914":1495,"_22115":1466,"_18751":36247,"_5":22264,"_15096":36170,"_1571":36248},[],"Además, cuando `regenerate_on_revoke` está activo, que es el comportamiento por defecto, cualquier revocación de un certificado desencadena inmediatamente la generación de una nueva CRL para la CA afectada. Esto reduce al mínimo el tiempo entre la revocación y su publicación.",{"_7914":1496,"_22115":1466,"_18751":36250,"_5":22264,"_15096":36174,"_1571":36251},[],"Cada entrada de la CRL incluye el número de serie del certificado revocado, la fecha de revocación y el código de razón conforme a RFC 5280.",{"_7914":1497,"_22115":1466,"_18751":36253,"_5":22264,"_15096":36174,"_1571":36254},[],"La CRL incluye también la extensión *Issuing Distribution Point* (IDP, OID 2.5.29.28), marcada como crítica, que indica la URL pública desde la que puede descargarse. Esa URL apunta al endpoint `/crl/{subject_key_id}` de cada dominio VA configurado.",{"_7914":1498,"_22115":1466,"_18751":36256,"_5":22264,"_15096":36178,"_1571":36257},[],"La CRL más reciente de una CA se puede obtener directamente sin autenticación:",{"_7914":1499,"_22115":1466,"_18751":36259,"_5":22264,"_15096":36178,"_1571":36260},[],"La respuesta tiene `Content-Type: application/pkix-crl` y contiene la CRL en formato DER.",{"_7914":1500,"_22115":1466,"_18751":36262,"_5":22264,"_15096":36182,"_1571":36263},[],"El rol VA de una CA se puede consultar y actualizar mediante la API:",{"_7914":1501,"_22115":1466,"_18751":36265,"_5":22264,"_15096":36182,"_1571":36266},[],"Método",{"_7914":1502,"_22115":1466,"_18751":36268,"_5":22264,"_15096":36182,"_1571":36269},[],"Ruta",{"_7914":1503,"_22115":1466,"_18751":36271,"_5":22264,"_15096":36182,"_1571":31984},[],{"_7914":1504,"_22115":1466,"_18751":36273,"_5":22264,"_15096":36182,"_1571":36274},[],"`GET`",{"_7914":1505,"_22115":1466,"_18751":36276,"_5":22264,"_15096":36182,"_1571":36277},[],"`/v1/roles/{ca-ski}`",{"_7914":1506,"_22115":1466,"_18751":36279,"_5":22264,"_15096":36182,"_1571":36280},[],"Devuelve la configuración del rol VA y los metadatos de la última CRL emitida.",{"_7914":1507,"_22115":1466,"_18751":36282,"_5":22264,"_15096":36182,"_1571":36283},[],"`PUT`",{"_7914":1508,"_22115":1466,"_18751":36285,"_5":22264,"_15096":36182,"_1571":36277},[],{"_7914":1509,"_22115":1466,"_18751":36287,"_5":22264,"_15096":36182,"_1571":36288},[],"Actualiza los parámetros de la configuración del rol VA (`validity`, `refresh_interval`, `regenerate_on_revoke`).",{"_7914":1510,"_22115":1466,"_18751":36290,"_5":22264,"_15096":36182,"_1571":36291},[],"Ejemplo de consulta del rol VA:",{"_7914":1511,"_22115":1466,"_18751":36293,"_5":22264,"_15096":36182,"_1571":36294},[],"La respuesta incluye el campo `latest_crl` con la versión, la fecha de inicio de validez y la fecha de caducidad de la CRL actualmente publicada.",{"_7914":1512,"_22115":1466,"_18751":36296,"_5":22264,"_15096":36186,"_1571":36297},[],"Desde el panel de detalle de una CA es posible previsualizar el contenido de la CRL activa y descargarla directamente para su uso offline o para importarla en aplicaciones que realicen validación local.",{"_7914":1513,"_22115":1466,"_18751":36299,"_5":22264,"_15096":36190,"_1571":36300},[],"RFC 5280 - *Internet X.509 Public Key Infrastructure Certificate and Certificate Revocation List (CRL) Profile*",{"_7914":1514,"_22115":1466,"_18751":36302,"_5":22264,"_15096":36190,"_1571":36303},[],"<Card title=\"Servicio OCSP\" href=\"/docs/manual/servicios-core/validation-ocsp\" />",{"_7914":1515,"_22115":1466,"_18751":36305,"_5":22264,"_15096":36190,"_1571":36306},[],"<Card title=\"Validación de certificados\" href=\"/docs/manual/servicios-core/validation\" />",{"_7914":1516,"_22115":1516,"_5":22259,"_1571":36308,"_22272":36309,"_18751":36310,"_15096":1516},"[VA] Servicio OCSP",[31781,32880,32889],[],{"_7914":1517,"_22115":1516,"_18751":36312,"_5":22264,"_15096":1516,"_1571":36313},[],"Validación online del estado de certificados mediante OCSP",{"_7914":1518,"_22115":1516,"_5":22269,"_18751":36315,"_15096":36316,"_1571":36317},[],"/docs/pr-preview/pr-20/manual/servicios-core/validation-ocsp#servicio-ocsp","Servicio OCSP",{"_7914":1519,"_22115":1516,"_5":22269,"_18751":36319,"_15096":36320,"_1571":36321},[],"/docs/pr-preview/pr-20/manual/servicios-core/validation-ocsp#cómo-funciona-el-respondedor-en-lamassu","Cómo funciona el respondedor en Lamassu",{"_7914":1520,"_22115":1516,"_5":22269,"_18751":36323,"_15096":36324,"_1571":36325},[],"/docs/pr-preview/pr-20/manual/servicios-core/validation-ocsp#enlace-en-los-certificados-emitidos","Enlace en los certificados emitidos",{"_7914":1521,"_22115":1516,"_5":22269,"_18751":36327,"_15096":36328,"_1571":36329},[],"/docs/pr-preview/pr-20/manual/servicios-core/validation-ocsp#endpoints-http","Endpoints HTTP",{"_7914":1522,"_22115":1516,"_5":22269,"_18751":36331,"_15096":36332,"_1571":36333},[],"/docs/pr-preview/pr-20/manual/servicios-core/validation-ocsp#comprobación-desde-la-interfaz","Comprobación desde la interfaz",{"_7914":1523,"_22115":1516,"_5":22269,"_18751":36335,"_15096":36336,"_1571":36191},[],"/docs/pr-preview/pr-20/manual/servicios-core/validation-ocsp#referencias",{"_7914":1524,"_22115":1516,"_18751":36338,"_5":22264,"_15096":36316,"_1571":36339},[],"OCSP (Online Certificate Status Protocol) es el mecanismo que permite a una parte que confía comprobar, en tiempo real, si un certificado concreto está vigente o ha sido revocado. En lugar de descargar una lista completa de certificados revocados, el cliente envía una consulta con el número de serie del certificado y recibe una respuesta firmada con el estado actual.",{"_7914":1525,"_22115":1516,"_18751":36341,"_5":22264,"_15096":36316,"_1571":36342},[],"Lamassu integra un respondedor OCSP propio que atiende estas consultas consultando directamente la base de datos interna de certificados. No se requiere ningún componente externo.",{"_7914":1526,"_22115":1516,"_18751":36344,"_5":22264,"_15096":36320,"_1571":36345},[],"Cuando un cliente solicita el estado de un certificado, el respondedor localiza el certificado por su número de serie y determina su estado según el registro interno:",{"_7914":1527,"_22115":1516,"_18751":36347,"_5":22264,"_15096":36320,"_1571":36348},[],"Si el certificado está activo, la respuesta indica `Good`.",{"_7914":1528,"_22115":1516,"_18751":36350,"_5":22264,"_15096":36320,"_1571":36351},[],"Si el certificado ha sido revocado, la respuesta indica `Revoked` e incluye la marca de tiempo de revocación y el código de razón conforme a RFC 5280.",{"_7914":1529,"_22115":1516,"_18751":36353,"_5":22264,"_15096":36320,"_1571":36354},[],"Si el número de serie no se encuentra o el estado no es reconocible, la respuesta indica `Unknown`.",{"_7914":1530,"_22115":1516,"_18751":36356,"_5":22264,"_15096":36320,"_1571":36357},[],"La respuesta OCSP es firmada por la CA emisora del certificado consultado, utilizando el motor criptográfico asociado a esa CA. Lamassu no utiliza un certificado delegado de firma OCSP: la CA actúa directamente como respondedor.",{"_7914":1531,"_22115":1516,"_18751":36359,"_5":22264,"_15096":36320,"_1571":36360},[],"Cada respuesta tiene una ventana de validez de 24 horas, reflejada en los campos `thisUpdate` y `nextUpdate` de la respuesta. Los clientes que cacheen respuestas deben tener en cuenta esta ventana al determinar durante cuánto tiempo una respuesta sigue siendo válida.",{"_7914":1532,"_22115":1516,"_18751":36362,"_5":22264,"_15096":36324,"_1571":36363},[],"La URL del respondedor OCSP se incorpora automáticamente en la extensión AIA (*Authority Information Access*) de todos los certificados emitidos por Lamassu. Los clientes que verifican certificados pueden leer esta URL directamente del certificado sin necesidad de configuración adicional.",{"_7914":1533,"_22115":1516,"_18751":36365,"_5":22264,"_15096":36328,"_1571":36366},[],"El respondedor acepta consultas en dos formatos, ambos definidos en RFC 6960:",{"_7914":1534,"_22115":1516,"_18751":36368,"_5":22264,"_15096":36328,"_1571":36266},[],{"_7914":1535,"_22115":1516,"_18751":36370,"_5":22264,"_15096":36328,"_1571":36269},[],{"_7914":1536,"_22115":1516,"_18751":36372,"_5":22264,"_15096":36328,"_1571":31984},[],{"_7914":1537,"_22115":1516,"_18751":36374,"_5":22264,"_15096":36328,"_1571":36274},[],{"_7914":1538,"_22115":1516,"_18751":36376,"_5":22264,"_15096":36328,"_1571":36377},[],"`/ocsp/{ocsp_request}`",{"_7914":1539,"_22115":1516,"_18751":36379,"_5":22264,"_15096":36328,"_1571":36380},[],"La petición OCSP va codificada en Base64url en la propia URL.",{"_7914":1540,"_22115":1516,"_18751":36382,"_5":22264,"_15096":36328,"_1571":36383},[],"`POST`",{"_7914":1541,"_22115":1516,"_18751":36385,"_5":22264,"_15096":36328,"_1571":36386},[],"`/ocsp`",{"_7914":1542,"_22115":1516,"_18751":36388,"_5":22264,"_15096":36328,"_1571":36389},[],"La petición OCSP va en el cuerpo de la petición con `Content-Type: application/ocsp-request`.",{"_7914":1543,"_22115":1516,"_18751":36391,"_5":22264,"_15096":36328,"_1571":36392},[],"Ejemplo de consulta con `curl` mediante POST:",{"_7914":1544,"_22115":1516,"_18751":36394,"_5":22264,"_15096":36328,"_1571":36395},[],"La respuesta tiene `Content-Type: application/ocsp-response` y contiene la respuesta OCSP en formato DER.",{"_7914":1545,"_22115":1516,"_18751":36397,"_5":22264,"_15096":36332,"_1571":36398},[],"Desde la pantalla de certificados de Lamassu es posible lanzar una petición OCSP directamente sobre el certificado seleccionado mediante la acción **OCSP Check**. Esta acción muestra el estado devuelto por el respondedor sin necesidad de herramientas externas.",{"_7914":1546,"_22115":1516,"_18751":36400,"_5":22264,"_15096":36336,"_1571":36401},[],"RFC 6960 - *X.509 Internet Public Key Infrastructure Online Certificate Status Protocol – OCSP*",{"_7914":1547,"_22115":1516,"_18751":36403,"_5":22264,"_15096":36336,"_1571":36404},[],"RFC 5280 - *Internet X.509 Public Key Infrastructure Certificate and Certificate Revocation List (CRL) Profile* (razones de revocación, sección 5.3.1)",{"_7914":1548,"_22115":1516,"_18751":36406,"_5":22264,"_15096":36336,"_1571":36407},[],"<Card title=\"Servicio CRL\" href=\"/docs/manual/servicios-core/validation-crl\" />",{"_7914":1549,"_22115":1516,"_18751":36409,"_5":22264,"_15096":36336,"_1571":36306},[],{"_7914":1550,"_22115":1550,"_5":22259,"_1571":36411,"_22272":36412,"_18751":36413,"_15096":1550},"[VA] Validación de Certificados",[31781,32880,32889],[],{"_7914":1551,"_22115":1550,"_18751":36415,"_5":22264,"_15096":1550,"_1571":36416},[],"Servicios OCSP y CRL para validación de certificados",{"_7914":1552,"_22115":1550,"_5":22269,"_18751":36418,"_15096":36419,"_1571":36420},[],"/docs/pr-preview/pr-20/manual/servicios-core/validation#validación-de-certificados--va","Validación de certificados – VA",{"_7914":1553,"_22115":1550,"_18751":36422,"_5":22264,"_15096":36419,"_1571":36423},[],"Lamassu ofrece dos mecanismos complementarios para validar el estado de los certificados emitidos por la plataforma:",{"_7914":1554,"_22115":1550,"_18751":36425,"_5":22264,"_15096":36419,"_1571":36426},[],"`OCSP`, para consultas online y en tiempo real del estado del certificado.",{"_7914":1555,"_22115":1550,"_18751":36428,"_5":22264,"_15096":36419,"_1571":36429},[],"`CRL`, para distribución y consulta offline de listas de revocación.",{"_7914":1556,"_22115":1550,"_18751":36431,"_5":22264,"_15096":36419,"_1571":36432},[],"En el menú lateral del módulo `VA` encontrarás cada capacidad documentada en su propia página.",{"_7914":1557,"_22115":1557,"_5":22259,"_1571":36434,"_18751":36435,"_15096":1557},"Test",[],{"_7914":1558,"_22115":1557,"_18751":36437,"_5":22264,"_15096":1557,"_1571":36438},[],"A document to test Fumadocs",{"_7914":1559,"_22115":1557,"_5":22269,"_18751":36440,"_15096":36441,"_1571":36442},[],"/docs/pr-preview/pr-20/test#cards","Cards",{"_7914":1560,"_22115":1557,"_5":22269,"_18751":36444,"_15096":36445,"_1571":36446},[],"/docs/pr-preview/pr-20/test#codeblock","CodeBlock",{"_7914":1561,"_22115":1557,"_5":22269,"_18751":36448,"_15096":36449,"_1571":36450},[],"/docs/pr-preview/pr-20/test#list","List",{"_7914":1562,"_22115":1557,"_18751":36452,"_5":22264,"_15096":1557,"_1571":36453},[],"Hey there!",{"_7914":15