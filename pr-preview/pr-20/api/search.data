22115":34,"_18751":32006,"_5":22264,"_15096":31869,"_1571":32007},[],"`lamassu-dev`",{"_7914":77,"_22115":34,"_18751":32009,"_5":22264,"_15096":31869,"_1571":32010},[],"Namespace Kubernetes donde se despliegan los recursos",{"_7914":78,"_22115":34,"_18751":32012,"_5":22264,"_15096":31869,"_1571":32013},[],"`-d`, `--domain`",{"_7914":79,"_22115":34,"_18751":32015,"_5":22264,"_15096":31869,"_1571":32016},[],"`dev.lamassu.io`",{"_7914":80,"_22115":34,"_18751":32018,"_5":22264,"_15096":31869,"_1571":32019},[],"Dominio usado para endpoint y certificados TLS",{"_7914":81,"_22115":34,"_18751":32021,"_5":22264,"_15096":31869,"_1571":32022},[],"`-v`, `--version`",{"_7914":82,"_22115":34,"_18751":32024,"_5":22264,"_15096":31869,"_1571":32025},[],"`latest`",{"_7914":83,"_22115":34,"_18751":32027,"_5":22264,"_15096":31869,"_1571":32028},[],"Versión del chart Helm de Lamassu",{"_7914":84,"_22115":34,"_18751":32030,"_5":22264,"_15096":31869,"_1571":32031},[],"`--https-port`",{"_7914":85,"_22115":34,"_18751":32033,"_5":22264,"_15096":31869,"_1571":32034},[],"`443`",{"_7914":86,"_22115":34,"_18751":32036,"_5":22264,"_15096":31869,"_1571":32037},[],"Puerto HTTPS del gateway",{"_7914":87,"_22115":34,"_18751":32039,"_5":22264,"_15096":31869,"_1571":32040},[],"`--http-port`",{"_7914":88,"_22115":34,"_18751":32042,"_5":22264,"_15096":31869,"_1571":32043},[],"`80`",{"_7914":89,"_22115":34,"_18751":32045,"_5":22264,"_15096":31869,"_1571":32046},[],"Puerto HTTP del gateway",{"_7914":90,"_22115":34,"_18751":32048,"_5":22264,"_15096":31869,"_1571":32049},[],"`--offline`",{"_7914":91,"_22115":34,"_18751":32051,"_5":22264,"_15096":31869,"_1571":31998},[],{"_7914":92,"_22115":34,"_18751":32053,"_5":22264,"_15096":31869,"_1571":32054},[],"Activa modo offline",{"_7914":93,"_22115":34,"_18751":32056,"_5":22264,"_15096":31869,"_1571":32057},[],"`--tls-crt`",{"_7914":94,"_22115":34,"_18751":32059,"_5":22264,"_15096":31869,"_1571":3011},[],{"_7914":95,"_22115":34,"_18751":32061,"_5":22264,"_15096":31