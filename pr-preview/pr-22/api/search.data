Q (`.tgz`)",{"_7897":111,"_22053":34,"_18699":32037,"_5":22203,"_15048":31802,"_1570":32038},[],"`-l`, `--local-chart-path`",{"_7897":112,"_22053":34,"_18699":32040,"_5":22203,"_15048":31802,"_1570":3008},[],{"_7897":113,"_22053":34,"_18699":32042,"_5":22203,"_15048":31802,"_1570":32043},[],"Ruta a directorio local descomprimido del chart Lamassu",{"_7897":114,"_22053":34,"_18699":32045,"_5":22203,"_15048":31806,"_1570":32046},[],"La función `detect_distribution` identifica la distribución con el siguiente orden de prioridad:",{"_7897":115,"_22053":34,"_18699":32048,"_5":22203,"_15048":31806,"_1570":32049},[],"`microk8s`",{"_7897":116,"_22053":34,"_18699":32051,"_5":22203,"_15048":31806,"_1570":32052},[],"`k3s`",{"_7897":117,"_22053":34,"_18699":32054,"_5":22203,"_15048":31806,"_1570":32055},[],"`kind`",{"_7897":118,"_22053":34,"_18699":32057,"_5":22203,"_15048":31806,"_1570":32058},[],"Kubernetes estándar",{"_7897":119,"_22053":34,"_18699":32060,"_5":22203,"_15048":31806,"_1570":32061},[],"Comportamientos específicos:",{"_7897":120,"_22053":34,"_18699":32063,"_5":22203,"_15048":31806,"_1570":32064},[],"En `microk8s`, los comandos se ejecutan con prefijos `microk8s kubectl` y `microk8s helm`.",{"_7897":121,"_22053":34,"_18699":32066,"_5":22203,"_15048":31806,"_1570":32067},[],"En `kind`, el script muestra una advertencia de uso exclusivo para pruebas.",{"_7897":122,"_22053":34,"_18699":32069,"_5":22203,"_15048":31810,"_1570":32070},[],"La función `check_dependencies` valida prerequisitos según la distribución detectada.",{"_7897":123,"_22053":34,"_18699":32072,"_5":22203,"_15048":31810,"_1570":32073},[],"Requisitos generales:",{"_7897":124,"_22053":34,"_18699":32075,"_5":22203,"_15048":31810,"_1570":32076},[],"`yq`",{"_7897":125,"_22053":34,"_18699":32078,"_5":22203,"_15048":31810,"_1570":32079},[],"CLI de la distribución detectada",{"_7897":126,"_22053":34,"_18699":32081,"_5":22203,"_15048":31810,"_1570":32082},[],"Requisitos específicos:",{"_7897":127,"_22053":34,"_18699":32084,"_5":22203,"_15048":31810,"_1570":32085},[],"Distribución",{"_7897":128,"_22053":34,"_18699":32087,"_5":22203,"_15048":31810,"_1570":32088},[],"Herramientas requeridas",{"_7897":129,"_22053":34,"_18699":32090,"_5":22203,"_15048":31810,"_1570":32052},[],{"_7897":130,"_22053":34,"_18699":32092,"_5":22203,"_15048":31810,"_1570":32093},[],"`kubectl`, `helm`",{"_7897":131,"_22053":34,"_18699":32095,"_5":22203,"_15048":31810,"_1570":32049},[],{"_7897":132,"_22053":34,"_18699":32097,"_5":22203,"_15048":31810,"_1570":32098},[],"`microk8s kubectl`, `microk8s helm`",{"_7897":133,"_22053":34,"_18699":32100,"_5":22203,"_15048":31814,"_1570":32101},[],"Se valida que estén habilitados:",{"_7897":134,"_22053":34,"_18699":32103,"_5":22203,"_15048":31814,"_1570":32104},[],"`helm`",{"_7897":135,"_22053":34,"_18699":32106,"_5":22203,"_15048":31814,"_1570":32107},[],"`hostpath-storage`",{"_7897":136,"_22053":34,"_18699":32109,"_5":22203,"_15048":31814,"_1570":32110},[],"`dns`",{"_7897":137,"_22053":34,"_18699":32112,"_5":22203,"_15048":31814,"_1570":32113},[],"`cert-manager`",{"_7897":138,"_22053":34,"_18699":32115,"_5":22203,"_15048":31814,"_1570":32116},[],"También se verifica un release Helm de Envoy Gateway llamado `eg` en el namespace `envoy-gateway-system`.\nSi no existe, se instala automáticamente la versión `v1.3.0` y se crea un `GatewayClass` llamado `eg`.",{"_7897":139,"_22053":34,"_18699":32118,"_5":22203,"_15048":31822,"_1570":32119},[],"La función `request_config_data` solicita:",{"_7897":140,"_22053":34,"_18699":32121,"_5":22203,"_15048":31822,"_1570":32122},[],"Dominio Lamassu",{"_7897":141,"_22053":34,"_18699":32124,"_5":22203,"_15048":31822,"_1570":32125},[],"Usuario y contraseña admin PostgreSQL",{"_7897":142,"_22053":34,"_18699":32127,"_5":22203,"_15048":31822,"_1570":32128},[],"Usuario y contraseña admin RabbitMQ",{"_7897":143,"_22053":34,"_18699":32130,"_5":22203,"_15048":31822,"_1570":32131},[],"Usuario y contraseña admin Keycloak",{"_7897":144,"_22053":34,"_18699":32133,"_5":22203,"_15048":31822,"_1570":32134},[],"Namespace Kubernetes",{"_7897":145,"_22053":34,"_18699":32136,"_5":22203,"_15048":31826,"_1570":32137},[],"Se generan credenciales aleatorias de 30 caracteres alfanuméricos.",{"_7897":146,"_22053":34,"_18699":32139,"_5":22203,"_15048":31826,"_1570":32140},[],"Se usan valores por defecto para dominio y namespace, salvo que se sobrescriban con flags.",{"_7897":147,"_22053":34,"_18699":32142,"_5":22203,"_15048":31830,"_1570":32143},[],"El script admite dos estrategias para obtener charts Helm.",{"_7897":148,"_22053":34,"_18699":32145,"_5":22203,"_15048":31834,"_1570":32146},[],"Los charts se descargan desde repositorios remotos.",{"_7897":149,"_22053":34,"_18699":32148,"_5":22203,"_15048":31838,"_1570":32149},[],"Requiere obligatoriamente rutas a los cuatro charts:",{"_7897":150,"_22053":34,"_18699":32151,"_5":22203,"_15048":31838,"_1570":32006},[],{"_7897":151,"_22053":34,"_18699":32153,"_5":22203,"_15048":31838,"_1570":32014},[],{"_7897":152,"_22053":34,"_18699":32155,"_5":22203,"_15048":31838,"_1570":32022},[],{"_7897":153,"_22053":34,"_18699":32157,"_5":22203,"_15048":31838,"_1570":32030},[],{"_7897":154,"_22053":34,"_18699":32159,"_5":22203,"_15048":31838,"_1570":32160},[],"Si falta cualquiera de ellos, el script finaliza con error.",{"_7897":155,"_22053":34,"_18699":32162,"_5":22203,"_15048":31838,"_1570":32163},[],"En este modo se fuerza:",{"_7897":156,"_22053":34,"_18699":32165,"_5":22203,"_15048":31846,"_1570":32166},[],"Chart: `oci://registry-1.docker.io/cloudpirates/postgres`",{"_7897":157,"_22053":34,"_18699":32168,"_5":22203,"_15048":31846,"_1570":32169},[],"Versión del chart: `0.19.0`",{"_7897":158,"_22053":34,"_18699":32171,"_5":22203,"_15048":31846,"_1570":32172},[],"Release: `postgres`",{"_7897":159,"_22053":34,"_18699":32174,"_5":22203,"_15048":31846,"_1570":32175},[],"`fullnameOverride: \"postgresql\"`",{"_7897":160,"_22053":34,"_18699":32177,"_5":22203,"_15048":31846,"_1570":32178},