ersión del chart: `0.20.0`",{"_7897":181,"_22053":34,"_18699":32239,"_5":22203,"_15048":31850,"_1570":32240},[],"Release: `auth`",{"_7897":182,"_22053":34,"_18699":32242,"_5":22203,"_15048":31850,"_1570":32243},[],"Uso de base de datos externa: `postgresql:5432/auth`",{"_7897":183,"_22053":34,"_18699":32245,"_5":22203,"_15048":31850,"_1570":32246},[],"Imagen de Keycloak fijada en `keycloak/keycloak:26.6.0`",{"_7897":184,"_22053":34,"_18699":32248,"_5":22203,"_15048":31850,"_1570":32249},[],"`httpRelativePath: /auth/`",{"_7897":185,"_22053":34,"_18699":32251,"_5":22203,"_15048":31850,"_1570":32252},[],"`proxyHeaders: xforwarded`",{"_7897":186,"_22053":34,"_18699":32254,"_5":22203,"_15048":31850,"_1570":32255},[],"Configuración automática del realm `lamassu`:",{"_7897":187,"_22053":34,"_18699":32257,"_5":22203,"_15048":31850,"_1570":32258},[],"Rol: `pki-admin`",{"_7897":188,"_22053":34,"_18699":32260,"_5":22203,"_15048":31850,"_1570":32261},[],"Usuario inicial: `lamassu` / `lamassu` (cambio obligatorio)",{"_7897":189,"_22053":34,"_18699":32263,"_5":22203,"_15048":31850,"_1570":32264},[],"Cliente público: `frontend` con `/*` en redirect URIs",{"_7897":190,"_22053":34,"_18699":32266,"_5":22203,"_15048":31850,"_1570":32267},[],"En modo online se descarga automáticamente un tema personalizado desde:",{"_7897":191,"_22053":34,"_18699":32269,"_5":22203,"_15048":31850,"_1570":32270},[],"`github.com/lamassuiot/keycloak-theme`",{"_7897":192,"_22053":34,"_18699":32272,"_5":22203,"_15048":31854,"_1570":32273},[],"Chart: `oci://registry-1.docker.io/cloudpirates/rabbitmq`",{"_7897":193,"_22053":34,"_18699":32275,"_5":22203,"_15048":31854,"_1570":32237},[],{"_7897":194,"_22053":34,"_18699":32277,"_5":22203,"_15048":31854,"_1570":32278},[],"Release: `rabbitmq`",{"_7897":195,"_22053":34,"_18699":32280,"_5":22203,"_15048":31854,"_1570":32281},[],"`fullnameOverride: \"rabbitmq\"`",{"_7897":196,"_22053":34,"_18699":32283,"_5":22203,"_15048":31854,"_1570":32284},[],"Credenciales inyectadas dinámicamente mediante `yq`",{"_7897":197,"_22053":34,"_18699":32286,"_5":22203,"_15048":31858,"_1570":32287},[],"Se genera un archivo `lamassu.yaml` que se pasa a `helm install`.",{"_7897":198,"_22053":34,"_18699":32289,"_5":22203,"_15048":31858,"_1570":32290},[],"Configuraciones principales:",{"_7897":199,"_22053":34,"_18699":32292,"_5":22203,"_15048":31858,"_1570":32293},[],"PostgreSQL: host `postgresql`, puerto `5432`",{"_7897":200,"_22053":34,"_18699":32295,"_5":22203,"_15048":31858,"_1570":32296},[],"AMQP: host `rabbitmq`, puerto `5672`, TLS deshabilitado",{"_7897":201,"_22053":34,"_18699":32298,"_5":22203,"_15048":31858,"_1570":32299},[],"OIDC JWKS:\n`http://auth-keycloak.<NAMESPACE>/auth/realms/lamassu/protocol/openid-connect/certs`",{"_7897":202,"_22053":34,"_18699":32301,"_5":22203,"_15048":31858,"_1570":32302},[],"Ruta adicional de gateway: `/auth -> auth-keycloak:8080`",{"_7897":203,"_22053":34,"_18699":32304,"_5":22203,"_15048":31858,"_1570":32305},[],"Direcciones de gateway: IP(s) obtenidas con `hostname -I`",{"_7897":204,"_22053":34,"_18699":32307,"_5":22203,"_15048":31858,"_1570":32308},[],"Puertos de gateway: desde `--https-port` y `--http-port`",{"_7897":205,"_22053":34,"_18699":32310,"_5":22203,"_15048":31858,"_1570":32311},[],"Dominios CA: valor de `--domain`",{"_7897":206,"_22053":34,"_18699":32313,"_5":22203,"_15048":31858,"_1570":32314},[],"Cuando se ejecuta en modo online y no se usa `--local-chart-path`, el script añade el repositorio Helm:",{"_7897":207,"_22053":34,"_18699":32316,"_5":22203,"_15048":31858,"_1570":32317},[],"Después instala el release `lamassu` usando la versión indicada por `--version` si se ha proporcionado.",{"_7897":208,"_22053":34,"_18699":32319,"_5":22203,"_15048":31858,"_1570":32320},[],"Si `--https-port` es distinto de `443`, el puerto se añade al dominio antes de escribirlo en `values`.",{"_7897":209,"_22053":34,"_18699":32322,"_5":22203,"_15048":31866,"_1570":32323},[],"Si se proporcionan:",{"_7897":210,"_22053":34,"_18699":32325,"_5":22203,"_15048":31866,"_1570":31990},[],{"_7897":211,"_22053":34,"_18699":32327,"_5":22203,"_15048":31866,"_1570":31998},[],{"_7897":212,"_22053":34,"_18699":32329,"_5":22203,"_15048":31866,"_1570":32330},[],"Se crea un secret Kubernetes:",{"_7897":213,"_22053":34,"_18699":32332,"_5":22203,"_15048":31866,"_1570":32333},[],"`downstream-provided-crt`",{"_7897":214,"_22053":34,"_18699":32335,"_5":22203,"_15048":31866,"_1570":32336},[],"Y se configura:",{"_7897":215,"_22053":34,"_18699":32338,"_5":22203,"_15048":31870,"_1570":32339},[],"Si no se proporciona certificado:",{"_7897":216,"_22053":34,"_18699":32341,"_5":22203,"_15048":31870,"_1570":32342},[],"Además, el script crea un `Issuer` self-signed y el recurso `Certificate`.",{"_7897":217,"_22053":34,"_18699":32344,"_5":22203,"_15048":31870,"_1570":32345},[],"Si el usuario quiere reutilizar un `Issuer` o `ClusterIssuer` corporativo, ese flujo no lo automatiza Fastlane; en ese caso es preferible un despliegue manual del chart con un archivo `values.yaml` propio.",{"_7897":218,"_22053":34,"_18699":32347,"_5":22203,"_15048":31874,"_1570":32348},[],"En caso de éxito, se muestra:",{"_7897":219,"_22053":34,"_18699":32350,"_5":22203,"_15048":31874,"_1570":32351},[],"URL de Lamassu UI: `https://<DOMAIN>`",{"_7897":220,"_22053":34,"_18699":32353,"_5":22203,"_15048":31874,"_1570":32354},[],"Credenciales iniciales: `lamassu / lamassu`",{"_7897":221,"_22053":34,"_18699":32356,"_5":22203,"_15048":31874,"_1570":32357},[],"Consola Keycloak: `https://<DOMAIN>/auth/admin`",{"_7897":222,"_22053":34,"_18699":32359,"_5":22203,"_15048":31874,"_1570":32360},[],"Credenciales admin de Keycloak",{"_7897":223,"_22053":34,"_18699":32362,"_5":22203,"_15048":31874,"_1570":32363},[],"El usuario `lamassu` se crea con:",{"_7897":224,"_22053":34,"_18699":32365,"_5":22203,"_15048":31874,"_1570":32366},[],"Por tanto, debe cambiar contraseña en el primer acceso.",{"_7897":225,"_22053":34,"_18699":32368,"_5":22203,"_15048":31878,"_1570":32369},[],"El script está pensado también para validaciones rápidas y smoke tests locales. Tras la instalación puede ejecutarse:",{"_7897":226,"_22053":34,"_18699":32371,"_5":22203,"_15048":31878,"_1570":32372},[],"El chart incluye una prueba que valida conectividad contra `ca`, `dms-manager`, `device-manager`, `va` y `ui`.",{"_7897":227,"_22053":34,"_18699":32374,"_5":22203,"_15048":31878,"_1570":32375},[],"Ejemplo:",{"_7897":228,"_22053":34,"_18699":32377,"_5":22203,"_15048":31878,"_1570":32378},[],"En este escenario:",{"_7897":229,"_22053":34,"_18699":32380,"_5":22203,"_15048":31878,"_1570":32381},[],"`-n`: modo no interactivo",{"_7897":230,"_22053":34,"_18699":32383,"_5":22203,"_15048":31878,"_1570":32384},[],"`-ns`: namespace específico",{"_7897":231,"_22053":34,"_18699":32386,"_5":22203,"_15048":31878,"_1570":32387},[],"`-d`: dominio de CI",{"_7897":232,"_22053":34,"_18699":32389,"_5":22203,"_15048":31878,"_1570":32390},[],"`-l`: chart local",{"_7897":233,"_22053":34,"_18699":32392,"_5":22203,"_15048":31886,"_1570":32393},[],"`lamassu-fast-lane.sh` proporciona un mecanismo totalmente automatizado para desplegar un entorno Lamassu funcional en Kubernetes en pocos minutos, integrando base de datos, autenticación, mensajería, gateway y TLS.",{"_7897":234,"_22053":34,"_18699":32395,"_5":22203,"_15048":31886,"_1570":32396},[],"Está optimizado para rapidez, reproducibilidad y uso en entornos no productivos, con soporte para escenarios offline y pipelines de CI.",{"_7897":235,"_22053":235,"_5":22198,"_1570":32398,"_22211":32399,"_18699":32400,"_15048":235},"Introducción",[31714,31715,31766],[],{"_7897":236,"_22053":235,"_18699":32402,"_5":22203,"_15048":235,"_1570":32403},[],"Despliegue de Lamassu IoT en infraestructura on-premise gestionada con Kubernetes",{"_7897":237,"_22053":235,"_5":22208,"_18699":32405,"_15048":32406,"_1570":32407},[],"/docs/pr-preview/pr-22/despliegue/onprem#despliegue-onprem-con-kubernetes","Despliegue OnPrem con Kubernetes",{"_7897":238,"_22053":235,"_5":22208,"_18699":32409,"_15048":32410,"_1570":32411},[],"/docs/pr-preview/pr-22/despliegue/onprem#quickstart","Quickstart",{"_7897":239,"_22053":235,"_5":22208,"_18699":32413,"_15048":32414,"_1570":32415},[],"/docs/pr-preview/pr-22/despliegue/onprem#qué-se-despliega","Qué se despliega",{"_7897":240,"_22053":235,"_5":22208,"_18699":32417,"_15048":32418,"_1570":32419},[],"/docs/pr-preview/pr-22/despliegue/onprem#requisitos-previos","Requisitos previos",{"_7897":241,"_22053":235,"_5":22208,"_18699":32421,"_15048":32422,"_1570":32423},[],"/docs/pr-preview/pr-22/despliegue/onprem#opciones-de-despliegue","Opciones de despliegue",{"_7897":242,"_22053":235,"_5":22208,"_18699":32425,"_15048":32426,"_1570":32427},[],"/docs/pr-preview/pr-22/despliegue/onprem#1-despliegue-manual-con-helm","1\\. Despliegue manual con Helm",{"_7897":243,"_22053":235,"_5":22208,"_18699":32429,"_15048":32430,"_1570":32431},[],"/docs/pr-preview/pr-22/despliegue/onprem#2-despliegue-automatizado-con-fastlane","2\\. Despliegue automatizado con Fastlane",{"_7897":244,"_22053":235,"_5":22208,"_18699":32433,"_15048":32434,"_1570":32435},[],"/docs/pr-preview/pr-22/despliegue/onprem#arquitectura","Arquitectura",{"_7897":245,"_22053":235,"_5":22208,"_18699":32437,"_15048":32438,"_1570":32439},[],"/docs/pr-preview/pr-22/despliegue/onprem#instalación-manual-con-helm","Instalación manual con Helm",{"_7897":246,"_22053":235,"_5":22208,"_18699":32441,"_15048":32442,"_1570":32443},[],"/docs/pr-preview/pr-22/despliegue/onprem#valores-mínimos-que-deben-definirse","Valores mínimos que deben definirse",{"_7897":247,"_22053":235,"_5":22208,"_18699":32445,"_15048":32446,"_1570":32447},[],"/docs/pr-preview/pr-22/despliegue/onprem#áreas-de-configuración-más-relevantes","Áreas de configuración más relevantes",{"_7897":248,"_22053":235,"_5":22208,"_18699":32449,"_15048":32450,"_1570":32451},[],"/docs/pr-preview/pr-22/despliegue/onprem#verificación-del-despliegue","Verificación del despliegue",{"_7897":249,"_22053":235,"_5":22208,"_18699":32453,"_15048":32454,"_1570":32455},[],"/docs/pr-preview/pr-22/despliegue/onprem#repositorio-helm","Repositorio Helm",{"_7897":250,"_22053":235,"_5":22208,"_18699":32457,"_15048":32458,"_1570":32459},[],"/docs/pr-preview/pr-22/despliegue/onprem#softhsm-como-complemento-opcional","SoftHSM como complemento opcional",{"_7897":251,"_22053":235,"_5":22208,"_18699":32461,"_15048":32462,"_1570":32463},[],"/docs/pr-preview/pr-22/despliegue/onprem#versionado-y-migraciones","Versionado y migraciones",{"_7897":252,"_22053":235,"_18699":32465,"_5":22203,"_15048":32406,"_1570":32466},[],"Lamassu IoT puede desplegarse en infraestructura propia mediante **Kubernetes**, tanto en clústeres gestionados internamente como en entornos self-managed.",{"_7897":253,"_22053":235,"_18699":32468,"_5":22203,"_15048":32406,"_1570":32469},[],"La referencia principal para este despliegue es el repositorio `lamassu-helm`, que incluye:",{"_7897":254,"_22053":235,"_18699":32471,"_5":22203,"_15048":32406,"_1570":32472},[],"el chart principal de Lamassu",{"_7897":255,"_22053":235,"_18699":32474,"_5":22203,"_15048":32406,"_1570":32475},[],"un chart auxiliar de SoftHSM",{"_7897":256,"_22053":235,"_18699":32477,"_5":22203,"_15048":32406,"_1570":32478},[],"el script de despliegue automatizado `scripts/lamassu-fast-lane.sh`",{"_7897":257,"_22053":235,"_18699":32480,"_5":22203,"_15048":32410,"_1570":32481},[],"Si lo que necesitas es levantar un entorno funcional lo antes posible, la vía más rápida es usar Fastlane desde el repositorio `lamassu-helm`:",{"_7897":258,"_22053":235,"_18699":32483,"_5":22203,"_15048":32410,"_1570":32484},[],"Ese flujo:",{"_7897":259,"_22053":235,"_18699":32486,"_5":22203,"_15048":32410,"_1570":32487},[],"crea o reutiliza el namespace indicado",{"_7897":260,"_22053":235,"_18699":32489,"_5":22203,"_15048":32410,"_1570":32490},[],"instala PostgreSQL, Keycloak y RabbitMQ",{"_7897":261,"_22053":235,"_18699":32492,"_5":22203,"_15048":32410,"_1570":32493},[],"despliega el chart de Lamassu",{"_7897":262,"_22053":235,"_18699":32495,"_5":22203,"_15048":32410,"_1570":32496},[],"deja la UI expuesta en `https://<dominio>`",{"_7897":263,"_22053":235,"_18699":32498,"_5":22203,"_15048":32410,"_1570":32499},[],"Si buscas un despliegue productivo o más controlado, sigue con la instalación manual mediante Helm que se describe más abajo.",{"_7897":264,"_22053":235,"_18699":32501,"_5":22203,"_15048":32414,"_1570":32502},[],"El chart principal `charts/lamassu`, actualmente en la serie `3.7.x`, despliega estos componentes:",{"_7897":265,"_22053":235,"_18699":32504,"_5":22203,"_15048":32414,"_1570":32505},[],"`ui`",{"_7897":266,"_22053":235,"_18699":32507,"_5":22203,"_15048":32414,"_1570":32198},[],{"_7897":267,"_22053":235,"_18699":32509,"_5":22203,"_15048":32414,"_1570":32204},[],{"_7897":268,"_22053":235,"_18699":32511,"_5":22203,"_15048":32414,"_1570":32228},[],{"_7897":269,"_22053":235,"_18699":32513,"_5":22203,"_15048":32414,"_1570":32514},[],"`device-manager`",{"_7897":270,"_22053":235,"_18699":32516,"_5":22203,"_15048":32414,"_1570":32517},[],"`dms-manager`",{"_7897":271,"_22053":235,"_18699":32519,"_5":22203,"_15048":32414,"_1570":32192},[],{"_7897":272,"_22053":235,"_18699":32521,"_5":22203,"_15048":32414,"_1570":32522},[],"recursos de Gateway API y políticas de Envoy Gateway",{"_7897":273,"_22053":235,"_18699":32524,"_5":22203,"_15048":32414,"_1570":32525},[],"job de migraciones de base de datos",{"_7897":274,"_22053":235,"_18699":32527,"_5":22203,"_15048":32418,"_1570":32528},[],"Clúster Kubernetes `1.19+`",{"_7897":275,"_22053":235,"_18699":32530,"_5":22203,"_15048":32418,"_1570":32531},[],"`kubectl` configurado con acceso al clúster",{"_7897":276,"_22053":235,"_18699":32533,"_5":22203,"_15048":32418,"_1570":32534},[],"Helm `3.2.0+`",{"_7897":277,"_22053":235,"_18699":32536,"_5":22203,"_15048":32418,"_1570":32537},[],"`cert-manager 1.14+` para la gestión de certificados cuando se usa `tls.type=certManager`",{"_7897":278,"_22053":235,"_18699":32539,"_5":22203,"_15048":32418,"_1570":32540},[],"`Envoy Gateway 1.3.0+`, ya que el chart publica servicios mediante Gateway API y no mediante Ingress",{"_7897":279,"_22053":235,"_18699":32542,"_5":22203,"_15048":32418,"_1570":32543},[],"Acceso a un registro de contenedores o imágenes previamente importadas si se trabaja en modo offline",{"_7897":280,"_22053":235,"_18699":32545,"_5":22203,"_15048":32418,"_1570":32546},[],"Almacenamiento persistente disponible para PostgreSQL, RabbitMQ, VA y KMS",{"_7897":281,"_22053":235,"_18699":32548,"_5":22203,"_15048":32422,"_1570":32549},[],"Hay dos formas de desplegar Lamassu on-prem:",{"_7897":282,"_22053":235,"_18699":32551,"_5":22203,"_15048":32426,"_1570":32552},[],"Es la opción recomendada para entornos productivos o controlados, donde PostgreSQL, RabbitMQ, Keycloak, certificados y direccionamiento del Gateway ya están definidos por el equipo de plataforma.",{"_7897":283,"_22053":235,"_18699":32554,"_5":22203,"_15048":32430,"_1570":32555},[],"Es la opción más útil para pruebas, demos, CI o bootstrap rápido de un entorno. Fastlane levanta PostgreSQL, Keycloak, RabbitMQ y Lamassu en un único flujo. Su comportamiento está documentado en la página siguiente.",{"_7897":284,"_22053":235,"_18699":32557,"_5":22203,"_15048":32434,"_1570":32558},[],"Lamassu IoT se despliega como un conjunto de microservicios Kubernetes independientes. El chart principal crea `Deployment`, `StatefulSet`, `Service`, `ConfigMap`, `HTTPRoute`, `Gateway`, certificados y recursos auxiliares según los valores definidos.",{"_7897":285,"_22053":235,"_18699":32560,"_5":22203,"_15048":32434,"_1570":32561},[],"Dependencias externas requeridas por el chart principal:",{"_7897":286,"_22053":235,"_18699":32563,"_5":22203,"_15048":32434,"_1570":31896},[],{"_7897":287,"_22053":235,"_18699":32565,"_5":22203,"_15048":32434,"_1570":31902},[],{"_7897":288,"_22053":235,"_18699":32567,"_5":22203,"_15048":32434,"_1570":32568},[],"proveedor OIDC, típicamente Keycloak",{"_7897":289,"_22053":235,"_18699":32570,"_5":22203,"_15048":32434,"_1570":32571},[],"El chart no instala estas dependencias por sí solo. Para un despliegue manual hay que provisionarlas antes. Si se busca un entorno funcional rápido para laboratorio o validación, el script Fastlane sí instala PostgreSQL, RabbitMQ y Keycloak además del chart de Lamassu.",{"_7897":290,"_22053":235,"_18699":32573,"_5":22203,"_15048":32438,"_1570":32574},[],"Agregar el repositorio Helm:",{"_7897":291,"_22053":235,"_18699":32576,"_5":22203,"_15048":32438,"_1570":32577},[],"O instalar desde una copia local del repositorio:",{"_7897":292,"_22053":235,"_18699":32579,"_5":22203,"_15048":32442,"_1570":32580},[],"Los valores por defecto del chart son deliberadamente incompletos para dependencias externas. Como mínimo, un despliegue manual debe definir:",{"_7897":293,"_22053":235,"_18699":32582,"_5":22203,"_15048":32442,"_1570":32583},[],"`postgres.hostname`, `postgres.username`, `postgres.password`",{"_7897":294,"_22053":235,"_18699":32585,"_5":22203,"_15048":32442,"_1570":32586},[],"`amqp.hostname`, `amqp.username`, `amqp.password`",{"_7897":295,"_22053":235,"_18699":32588,"_5":22203,"_15048":32442,"_1570":32589},[],"`auth.oidc.frontend.authority`",{"_7897":296,"_22053":235,"_18699":32591,"_5":22203,"_15048":32442,"_1570":32592},[],"`auth.oidc.apiGateway.jwks`",{"_7897":297,"_22053":235,"_18699":32594,"_5":22203,"_15048":32442,"_1570":32595},[],"`services.ca.domains`",{"_7897":298,"_22053":235,"_18699":32597,"_5":22203,"_15048":32442,"_1570":32598},[],"`gateway.addresses` o una estrategia equivalente de publicación según el clúster",{"_7897":299,"_22053":235,"_18699":32600,"_5":22203,"_15048":32442,"_1570":32601},[],"`tls.*` según se use `certManager` o certificado externo",{"_7897":300,"_22053":235,"_18699":32603,"_5":22203,"_15048":32442,"_1570":32604},[],"Ejemplo base:",{"_7897":301,"_22053":235,"_18699":32606,"_5":22203,"_15048":32446,"_1570":32607},[],"Área",{"_7897":302,"_22053":235,"_18699":32609,"_5":22203,"_15048":32446,"_1570":32610},[],"Valores clave",{"_7897":303,"_22053":235,"_18699":32612,"_5":22203,"_15048":32446,"_1570":32613},[],"Uso",{"_7897":304,"_22053":235,"_18699":32615,"_5":22203,"_15048":32446,"_1570":32616},[],"TLS",{"_7897":305,"_22053":235,"_18699":32618,"_5":22203,"_15048":32446,"_1570":32619},[],"`tls.type`, `tls.certManagerOptions.*`, `tls.externalOptions.secretName`",{"_7897":306,"_22053":235,"_18699":32621,"_5":22203,"_15048":32446,"_1570":32622},[],"Certificado downstream del Gateway",{"_7897":307,"_22053":235,"_18699":32624,"_5":22203,"_15048":32446,"_1570":32625},[],"Gateway",{"_7897":308,"_22053":235,"_18699":32627,"_5":22203,"_15048":32446,"_1570":32628},[],"`gateway.addresses`, `gateway.ports.*`, `gateway.extraRouting`",{"_7897":309,"_22053":235,"_18699":32630,"_5":22203,"_15048":32446,"_1570":32631},[],"Exposición de UI y APIs vía Envoy Gateway",{"_7897":310,"_22053":235,"_18699":32633,"_5":22203,"_15048":32446,"_1570":32181},[],{"_7897":311,"_22053":235,"_18699":32635,"_5":22203,"_15048":32446,"_1570":32636},[],"`postgres.*`",{"_7897":312,"_22053":235,"_18699":32638,"_5":22203,"_15048":32446,"_1570":32639},[],"Conexión a PostgreSQL externa",{"_7897":313,"_22053":235,"_18699":32641,"_5":22203,"_15048":32446,"_1570":32642},[],"Mensajería",{"_7897":314,"_22053":235,"_18699":32644,"_5":22203,"_15048":32446,"_1570":32645},[],"`amqp.*`",{"_7897":315,"_22053":235,"_18699":32647,"_5":22203,"_15048":32446,"_1570":32648},[],"Conexión a RabbitMQ",{"_7897":316,"_22053":235,"_18699":32650,"_5":22203,"_15048":32446,"_1570":32651},[],"OIDC",{"_7897":317,"_22053":235,"_18699":32653,"_5":22203,"_15048":32446,"_1570":32654},[],"`auth.oidc.frontend.*`, `auth.oidc.apiGateway.jwks`",{"_7897":318,"_22053":235,"_18699":32656,"_5":22203,"_15048":32446,"_1570":32657},[],"Login de UI y validación JWT en el Gateway",{"_7897":319,"_22053":235,"_18699":32659,"_5":22203,"_15048":32446,"_1570":32201},[],{"_7897":320,"_22053":235,"_18699":32661,"_5":22203,"_15048":32446,"_1570":32595},[],{"_7897":321,"_22053":235,"_18699":32663,"_5":22203,"_15048":32446,"_1570":32664},[],"Dominios autorizados para CA y certificados",{"_7897":322,"_22053":235,"_18699":32666,"_5":22203,"_15048":32446,"_1570":32231},[],{"_7897":323,"_22053":235,"_18699":32668,"_5":22203,"_15048":32446,"_1570":32669},[],"`services.kms.cryptoEngines.*`",{"_7897":324,"_22053":235,"_18699":32671,"_5":22203,"_15048":32446,"_1570":32672},[],"Motor criptográfico y almacenamiento de claves",{"_7897":325,"_22053":235,"_18699":32674,"_5":22203,"_15048":32446,"_1570":32195},[],{"_7897":326,"_22053":235,"_18699":32676,"_5":22203,"_15048":32446,"_1570":32677},[],"`services.alerts.smtp_server.*`",{"_7897":327,"_22053":235,"_18699":32679,"_5":22203,"_15048":32446,"_1570":32680},[],"Envío de correo para alertas",{"_7897":328,"_22053":235,"_18699":32682,"_5":22203,"_15048":32450,"_1570":32683},[],"El chart incluye una prueba Helm en `charts/lamassu/templates/tests/test-connections.yml`. Tras instalarlo, puede validarse con:",{"_7897":329,"_22053":235,"_18699":32685,"_5":22203,"_15048":32450,"_1570":32686},[],"La prueba comprueba al menos:",{"_7897":330,"_22053":235,"_18699":32688,"_5":22203,"_15048":32450,"_1570":32689},[],"salud de `ca`",{"_7897":331,"_22053":235,"_18699":32691,"_5":22203,"_15048":32450,"_1570":32692},[],"salud de `dms-manager`",{"_7897":332,"_22053":235,"_18699":32694,"_5":22203,"_15048":32450,"_1570":32695},[],"salud de `device-manager`",{"_7897":333,"_22053":235,"_18699":32697,"_5":22203,"_15048":32450,"_1570":32698},[],"salud de `va`",{"_7897":334,"_22053":235,"_18699":32700,"_5":22203,"_15048":32450,"_1570":32701},[],"respuesta HTML esperada del servicio `ui`",{"_7897":335,"_22053":235,"_18699":32703,"_5":22203,"_15048":32454,"_1570":32704},[],"El repositorio `lamassu-helm` está organizado en tres bloques principales:",{"_7897":336,"_22053":235,"_18699":32706,"_5":22203,"_15048":32454,"_1570":32707},[],"`charts/lamassu`: chart principal de Lamassu",{"_7897":337,"_22053":235,"_18699":32709,"_5":22203,"_15048":32454,"_1570":32710},[],"`charts/softhsm`: chart opcional para laboratorios o escenarios de integración con PKCS#11 emulado",{"_7897":338,"_22053":235,"_18699":32712,"_5":22203,"_15048":32454,"_1570":32713},[],"`scripts/lamassu-fast-lane.sh`: automatización para levantar dependencias y desplegar Lamassu con intervención mínima",{"_7897":339,"_22053":235,"_18699":32715,"_5":22203,"_15048":32458,"_1570":32716},[],"El chart `charts/softhsm` no forma parte del despliegue estándar, pero resulta útil en entornos de laboratorio cuando se necesita simular un HSM compatible con PKCS#11. No sustituye al backend KMS principal; sirve como soporte para pruebas o integraciones concretas.",{"_7897":340,"_22053":235,"_18699":32718,"_5":22203,"_15048":32462,"_1570":32719},[],"La serie actual del chart principal es `3.7.x`. Para upgrades entre versiones, el repositorio incluye guías específicas en `charts/lamassu/CHANGELOG/`, especialmente en cambios importantes como la adopción de Envoy Gateway o la introducción del servicio KMS.",{"_7897":341,"_22053":341,"_5":22198,"_1570":32721,"_22211":32722,"_18699":32723,"_15048":341},"SaaS · Suscripción",[31714,31715,31773],[],{"_7897":342,"_22053":341,"_18699":32725,"_5":22203,"_15048":341,"_1570":32726},[],"Acceso a Lamassu IoT como servicio gestionado basado en suscripción",{"_7897":343,"_22053":341,"_5":22208,"_18699":32728,"_15048":32729,"_1570":32730},[],"/docs/pr-preview/pr-22/despliegue/saas#lamassu-iot-saas--basada-en-suscripción","Lamassu IoT SaaS – Basada en suscripción",{"_7897":344,"_22053":341,"_5":22208,"_18699":32732,"_15048":32733,"_1570":32734},[],"/docs/pr-preview/pr-22/despliegue/saas#qué-incluye-la-suscripción","¿Qué incluye la suscripción?",{"_7897":345,"_22053":341,"_5":22208,"_18699":32736,"_15048":32737,"_1570":32738},[],"/docs/pr-preview/pr-22/despliegue/saas#planes-disponibles","Planes disponibles",{"_7897":346,"_22053":341,"_5":22208,"_18699":32740,"_15048":32741,"_1570":32742},[],"/docs/pr-preview/pr-22/despliegue/saas#contacto","Contacto",{"_7897":347,"_22053":341,"_18699":32744,"_5":22203,"_15048":32729,"_1570":32745},[],"La modalidad **SaaS** de Lamassu IoT ofrece acceso completo a la plataforma como servicio totalmente gestionado por LKS Next, sin necesidad de gestionar infraestructura propia.",{"_7897":348,"_22053":341,"_18699":32747,"_5":22203,"_15048":32733,"_1570":32748},[],"Acceso a la plataforma Lamassu IoT completamente gestionada",{"_7897":349,"_22053":341,"_18699":32750,"_5":22203,"_15048":32733,"_1570":32751},[],"Alta disponibilidad y backups automáticos",{"_7897":350,"_22053":341,"_18699":32753,"_5":22203,"_15048":32733,"_1570":32754},[],"Actualizaciones automáticas a las últimas versiones",{"_7897":351,"_22053":341,"_18699":32756,"_5":22203,"_15048":32733,"_1570":32757},[],"Soporte técnico incluido",{"_7897":352,"_22053":341,"_18699":32759,"_5":22203,"_15048":32733,"_1570":32760},[],"SLA garantizado",{"_7897":353,"_22053":341,"_18699":32762,"_5":22203,"_15048":32737,"_1570":32763},[],"Plan",{"_7897":354,"_22053":341,"_18699":32765,"_5":22203,"_15048":32737,"_1570":32766},[],"Dispositivos",{"_7897":355,"_22053":341,"_18699":32768,"_5":22203,"_15048":32737,"_1570":32769},[],"Soporte",{"_7897":356,"_22053":341,"_18699":32771,"_5":22203,"_15048":32737,"_1570":32772},[],"SLA",{"_7897":357,"_22053":341,"_18699":32774,"_5":22203,"_15048":32737,"_1570":32775},[],"Starter",{"_7897":358,"_22053":341,"_18699":32777,"_5":22203,"_15048":32737,"_1570":32778},[],"Hasta 1.000",{"_7897":359,"_22053":341,"_18699":32780,"_5":22203,"_15048":32737,"_1570":32781},[],"Email",{"_7897":360,"_22053":341,"_18699":32783,"_5":22203,"_15048":32737,"_1570":32784},[],"99,5%",{"_7897":361,"_22053":341,"_18699":32786,"_5":22203,"_15048":32737,"_1570":32787},[],"Professional",{"_7897":362,"_22053":341,"_18699":32789,"_5":22203,"_15048":32737,"_1570":32790},[],"Hasta 10.000",{"_7897":363,"_22053":341,"_18699":32792,"_5":22203,"_15048":32737,"_1570":32793},[],"Email + Chat",{"_7897":364,"_22053":341,"_18699":32795,"_5":22203,"_15048":32737,"_1570":32796},[],"99,9%",{"_7897":365,"_22053":341,"_18699":32798,"_5":22203,"_15048":32737,"_1570":32799},[],"Enterprise",{"_7897":366,"_22053":341,"_18699":32801,"_5":22203,"_15048":32737,"_1570":32802},[],"Ilimitado",{"_7897":367,"_22053":341,"_18699":32804,"_5":22203,"_15048":32737,"_1570":32805},[],"Dedicado",{"_7897":368,"_22053":341,"_18699":32807,"_5":22203,"_15048":32737,"_1570":32808},[],"99,99%",{"_7897":369,"_22053":341,"_18699":32810,"_5":22203,"_15048":32741,"_1570":32811},[],"Para suscribirte o solicitar una demo, contacta con el equipo de Lamassu IoT a través de lamassu.io.",{"_7897":370,"_22053":370,"_5":22198,"_1570":32813,"_22211":32814,"_18699":32815,"_15048":370},"Manual de Usuario",[31714,32813],[],{"_7897":371,"_22053":370,"_18699":32817,"_5":22203,"_15048":370,"_1570":32818},[],"Guía completa de uso de la plataforma Lamassu IoT",{"_7897":372,"_22053":370,"_5":22208,"_18699":32820,"_15048":32821,"_1570":32822},[],"/docs/pr-preview/pr-22/manual#servicios-core","Servicios Core",{"_7897":373,"_22053":370,"_5":22208,"_18699":32824,"_15048":32825,"_1570":32826},[],"/docs/pr-preview/pr-22/manual#integraciones-con-terceros","Integraciones con terceros",{"_7897":374,"_22053":370,"_18699":32828,"_5":22203,"_15048":370,"_1570":32829},[],"Bienvenido al **Manual de Usuario de Lamassu IoT**. Esta documentación cubre todas las funcionalidades de la plataforma para la gestión de identidades digitales en entornos IoT industriales.",{"_7897":375,"_22053":370,"_18699":32831,"_5":22203,"_15048":32821,"_1570":32832},[],"<Card title=\"Gestión de Claves (KMS)\" description=\"Motores criptográficos, generación e importación de claves\" href=\"/docs/manual/servicios-core/kms\" />",{"_7897":376,"_22053":370,"_18699":32834,"_5":22203,"_15048":32821,"_1570":32835},[],"<Card title=\"Entidades de Confianza (CAs)\" description=\"Creación, importación y gestión de Autoridades de Certificación\" href=\"/docs/manual/servicios-core/cas\" />",{"_7897":377,"_22053":370,"_18699":32837,"_5":22203,"_15048":32821,"_1570":32838},[],"<Card title=\"Gestión de Certificados\" description=\"Visualización y revocación de certificados emitidos\" href=\"/docs/manual/servicios-core/certificates\" />",{"_7897":378,"_22053":370,"_18699":32840,"_5":22203,"_15048":32821,"_1570":32841},[],"<Card title=\"Validación de Certificados (VA)\" description=\"Servicios OCSP y CRL\" href=\"/docs/manual/servicios-core/validation\" />",{"_7897":379,"_22053":370,"_18699":32843,"_5":22203,"_15048":32821,"_1570":32844},[],"<Card title=\"Registration Authority (RA)\" description=\"Automatización del ciclo de vida de certificados y protocolo EST\" href=\"/docs/manual/servicios-core/ra\" />",{"_7897":380,"_22053":370,"_18699":32846,"_5":22203,"_15048":32821,"_1570":32847},[],"<Card title=\"Dispositivos e Identidades\" description=\"Gestión de End Entities y ciclo de vida de dispositivos IoT\" href=\"/docs/manual/servicios-core/devices\" />",{"_7897":381,"_22053":370,"_18699":32849,"_5":22203,"_15048":32821,"_1570":32850},[],"<Card title=\"Alertas y Suscripciones\" description=\"Monitorización de eventos y notificaciones\" href=\"/docs/manual/servicios-core/alerts\" />",{"_7897":382,"_22053":370,"_18699":32852,"_5":22203,"_15048":32825,"_1570":32853},[],"<Card title=\"Integración AWS IoT Core\" description=\"Aprovisionamiento de dispositivos en AWS IoT Core\" href=\"/docs/manual/integraciones/aws\" />",{"_7897":383,"_22053":383,"_5":22198,"_1570":32855,"_22211":32856,"_18699":32857,"_15048":383},"Integración con AWS IoT Core",[31714,32813,32826],[],{"_7897":384,"_22053":383,"_18699":32859,"_5":22203,"_15048":383,"_1570":32860},[],"El conector de Lamassu para AWS IoT Core sincroniza las identidades de los dispositivos con la plataforma AWS, gestionando el registro de CAs, el aprovisionamiento de Things y el ciclo de vida de los certificados de forma automática y orientada a eventos.",{"_7897":385,"_22053":383,"_5":22208,"_18699":32862,"_15048":32863,"_1570":32864},[],"/docs/pr-preview/pr-22/manual/integraciones/aws#arquitectura-del-conector","Arquitectura del conector",{"_7897":386,"_22053":383,"_5":22208,"_18699":32866,"_15048":32867,"_1570":32868},[],"/docs/pr-preview/pr-22/manual/integraciones/aws#prerrequisitos","Prerrequisitos",{"_7897":387,"_22053":383,"_5":22208,"_18699":32870,"_15048":32871,"_1570":32872},[],"/docs/pr-preview/pr-22/manual/integraciones/aws#permisos-iam-necesarios","Permisos IAM necesarios",{"_7897":388,"_22053":383,"_5":22208,"_18699":32874,"_15048":32875,"_1570":32876},[],"/docs/pr-preview/pr-22/manual/integraciones/aws#parámetros-de-configuración","Parámetros de configuración",{"_7897":389,"_22053":383,"_5":22208,"_18699":32878,"_15048":32879,"_1570":32880},[],"/docs/pr-preview/pr-22/manual/integraciones/aws#registro-de-la-ca-en-aws-iot-core","Registro de la CA en AWS IoT Core",{"_7897":390,"_22053":383,"_5":22208,"_18699":32882,"_15048":32883,"_1570":32884},[],"/docs/pr-preview/pr-22/manual/integraciones/aws#cómo-solicitar-el-registro","Cómo solicitar el registro",{"_7897":391,"_22053":383,"_5":22208,"_18699":32886,"_15048":32887,"_1570":32888},[],"/docs/pr-preview/pr-22/manual/integraciones/aws#primary-account","Primary Account",{"_7897":392,"_22053":383,"_5":22208,"_18699":32890,"_15048":32891,"_1570":32892},[],"/docs/pr-preview/pr-22/manual/integraciones/aws#secondary-account-sni-only","Secondary Account (SNI-only)",{"_7897":393,"_22053":383,"_5":22208,"_18699":32894,"_15048":32895,"_1570":32896},[],"/docs/pr-preview/pr-22/manual/integraciones/aws#configuración-del-dms","Configuración del DMS",{"_7897":394,"_22053":383,"_5":22208,"_18699":32898,"_15048":32899,"_1570":32900},[],"/docs/pr-preview/pr-22/manual/integraciones/aws#modo-none","Modo `none`",{"_7897":395,"_22053":383,"_5":22208,"_18699":32902,"_15048":32903,"_1570":32904},[],"/docs/pr-preview/pr-22/manual/integraciones/aws#modo-auto","Modo `auto`",{"_7897":396,"_22053":383,"_5":22208,"_18699":32906,"_15048":32907,"_1570":32908},[],"/docs/pr-preview/pr-22/manual/integraciones/aws#modo-jitp","Modo `jitp`",{"_7897":397,"_22053":383,"_5":22208,"_18699":32910,"_15048":32911,"_1570":32912},[],"/docs/pr-preview/pr-22/manual/integraciones/aws#aprovisionamiento-de-dispositivos-modo-automático","Aprovisionamiento de dispositivos (modo automático)",{"_7897":398,"_22053":383,"_5":22208,"_18699":32914,"_15048":32915,"_1570":32916},[],"/docs/pr-preview/pr-22/manual/integraciones/aws#aprovisionamiento-de-dispositivos-modo-jitp","Aprovisionamiento de dispositivos (modo JITP)",{"_7897":399,"_22053":383,"_5":22208,"_18699":32918,"_15048":32919,"_1570":32920},[],"/docs/pr-preview/pr-22/manual/integraciones/aws#sincronización-del-estado-del-certificado","Sincronización del estado del certificado",{"_7897":400,"_22053":383,"_5":22208,"_18699":32922,"_15048":32923,"_1570":32924},[],"/docs/pr-preview/pr-22/manual/integraciones/aws#desconexión-forzada-al-revocar","Desconexión forzada al revocar",{"_7897":401,"_22053":383,"_5":22208,"_18699":32926,"_15048":32927,"_1570":32928},[],"/docs/pr-preview/pr-22/manual/integraciones/aws#device-shadow-y-automatización","Device Shadow y automatización",{"_7897":402,"_22053":383,"_5":22208,"_18699":32930,"_15048":32931,"_1570":32932},[],"/docs/pr-preview/pr-22/manual/integraciones/aws#qué-escribe-el-conector-en-el-shadow","Qué escribe el conector en el shadow",{"_7897":403,"_22053":383,"_5":22208,"_18699":32934,"_15048":32935,"_1570":32936},[],"/docs/pr-preview/pr-22/manual/integraciones/aws#políticas-de-aws-iot","Políticas de AWS IoT",{"_7897":404,"_22053":383,"_5":22208,"_18699":32938,"_15048":32939,"_1570":32940},[],"/docs/pr-preview/pr-22/manual/integraciones/aws#solución-de-problemas","Solución de problemas",{"_7897":405,"_22053":383,"_18699":32942,"_5":22203,"_15048":383,"_1570":32943},[],"La integración de Lamassu con AWS IoT Core cubre el puente entre la PKI gestionada por Lamassu y la plataforma de conectividad de AWS. Cuando un dispositivo obtiene su certificado a través del proceso de enrolamiento EST, el conector se encarga de que ese certificado y la identidad asociada sean reconocidos en AWS IoT Core sin intervención manual. El resultado es que el dispositivo puede autenticarse directamente en AWS con el mismo certificado X.509 que Lamassu emitió.",{"_7897":406,"_22053":383,"_18699":32945,"_5":22203,"_15048":383,"_1570":32946},[],"Desde el punto de vista del protocolo, el dispositivo se autentica ante AWS IoT Core mediante TLS mutuo (mTLS): presenta su certificado X.509 emitido por Lamassu como certificado de cliente, y AWS IoT Core verifica la cadena de certificados hasta llegar a la CA registrada en la cuenta. Lamassu actúa como autoridad de certificación (CA); el conector se encarga de que esa CA esté registrada en AWS y de que el certificado del dispositivo sea conocido por la plataforma antes de que el dispositivo intente conectarse (en modo `auto`) o en su primera conexión (en modo JITP).",{"_7897":407,"_22053":383,"_18699":32948,"_5":22203,"_15048":383,"_1570":32949},[],"Este documento está dirigido tanto al administrador PKI, que necesita configurar el conector y registrar las CAs, como al desarrollador de firmware de dispositivos, que necesita entender cómo se nombran los Things, cómo funciona el Device Shadow y qué ocurre cuando un certificado se revoca. Para el desarrollador de firmware, el dato más importante es que el **nombre del Thing en AWS (ThingName) corresponde siempre al Common Name (CN) del certificado emitido por Lamassu**, independientemente del modo de aprovisionamiento.",{"_7897":408,"_22053":383,"_18699":32951,"_5":22203,"_15048":32863,"_1570":32952},[],"El conector de AWS IoT Core es un proceso Go independiente, un binario o contenedor separado del núcleo de Lamassu. En un despliegue monolítico se compila por defecto (etiqueta de compilación `!noaws`) y se activa mediante `aws_iot_manager.enabled: true` en el fichero de configuración. En despliegues distribuidos, se ejecuta como un contenedor propio con acceso a los servicios de CA, DMS Manager y Device Manager de Lamassu a través de HTTP.",{"_7897":409,"_22053":383,"_18699":32954,"_5":22203,"_15048":32863,"_1570":32955},[],"El conector no sondea los servicios de Lamassu periódicamente. En su lugar, **se suscribe al bus de eventos interno** de Lamassu (AMQP o AWS SQS/SNS, configurable) y reacciona a los eventos que le interesan: creación o actualización de CAs, creación o actualización de DMS, vinculación de identidad de dispositivo, cambio de estado de certificado, actualización de metadatos de certificado y actualización de metadatos de dispositivo. Este modelo orientado a eventos garantiza que la sincronización con AWS sea casi inmediata y no genere carga de sondeo.",{"_7897":410,"_22053":383,"_18699":32957,"_5":22203,"_15048":32863,"_1570":32958},[],"Para evitar bucles infinitos, el conector ignora cualquier evento cuyo campo `source` de CloudEvent coincida con su propia URI de origen. Esto previene que las escrituras de metadatos que el propio conector realiza vuelvan a disparar el mismo flujo.",{"_7897":411,"_22053":383,"_18699":32960,"_5":22203,"_15048":32863,"_1570":32961},[],"Cuando se ejecutan varios conectores en paralelo, por ejemplo, para distintas cuentas de AWS, cada instancia tiene su propio `connector_id`. Todos los metadatos que el conector escribe en Lamassu se almacenan bajo la clave `lamassu.io/iot/{connector_id}`, lo que permite coexistencia sin colisiones.",{"_7897":412,"_22053":383,"_18699":32963,"_5":22203,"_15048":32867,"_1570":32964},[],"Antes de activar el conector es necesario disponer de una cuenta AWS con los permisos IAM adecuados y tener el conector correctamente configurado. El proceso de despliegue (Docker Compose, Kubernetes o binario) se describe en la documentación de despliegue.",{"_7897":413,"_22053":383,"_18699":32966,"_5":22203,"_15048":32871,"_1570":32967},[],"La identidad IAM con la que opera el conector debe tener al mínimo los siguientes permisos sobre los recursos de la cuenta destino:",{"_7897":414,"_22053":383,"_18699":32969,"_5":22203,"_15048":32871,"_1570":32970},[],"Acción IAM",{"_7897":415,"_22053":383,"_18699":32972,"_5":22203,"_15048":32871,"_1570":32973},[],"Propósito",{"_7897":416,"_22053":383,"_18699":32975,"_5":22203,"_15048":32871,"_1570":32976},[],"`iot:GetRegistrationCode`",{"_7897":417,"_22053":383,"_18699":32978,"_5":22203,"_15048":32871,"_1570":32979},[],"Obtener el código de verificación para el registro de CA en Primary Account",{"_7897":418,"_22053":383,"_18699":32981,"_5":22203,"_15048":32871,"_1570":32982},[],"`iot:RegisterCACertificate`",{"_7897":419,"_22053":383,"_18699":32984,"_5":22203,"_15048":32871,"_1570":32985},[],"Registrar la CA en AWS IoT",{"_7897":420,"_22053":383,"_18699":32987,"_5":22203,"_15048":32871,"_1570":32988},[],"`iot:DescribeCACertificate`",{"_7897":421,"_22053":383,"_18699":32990,"_5":22203,"_15048":32871,"_1570":32991},[],"Consultar el estado del registro de la CA",{"_7897":422,"_22053":383,"_18699":32993,"_5":22203,"_15048":32871,"_1570":32994},[],"`iot:CreateThing` / `iot:UpdateThing`",{"_7897":423,"_22053":383,"_18699":32996,"_5":22203,"_15048":32871,"_1570":32997},[],"Crear o actualizar Things en IoT Core",{"_7897":424,"_22053":383,"_18699":32999,"_5":22203,"_15048":32871,"_1570":33000},[],"`iot:RegisterThing`",{"_7897":425,"_22053":383,"_18699":33002,"_5":22203,"_15048":32871,"_1570":33003},[],"Aprovisionar Things mediante plantilla",{"_7897":426,"_22053":383,"_18699":33005,"_5":22203,"_15048":32871,"_1570":33006},[],"`iot:RegisterCertificate`",{"_7897":427,"_22053":383,"_18699":33008,"_5":22203,"_15048":32871,"_1570":33009},[],"Registrar certificados de dispositivo",{"_7897":428,"_22053":383,"_18699":33011,"_5":22203,"_15048":32871,"_1570":33012},[],"`iot:UpdateCertificate`",{"_7897":429,"_22053":383,"_18699":33014,"_5":22203,"_15048":32871,"_1570":33015},[],"Cambiar el estado de un certificado (ACTIVE / INACTIVE / REVOKED)",{"_7897":430,"_22053":383,"_18699":33017,"_5":22203,"_15048":32871,"_1570":33018},[],"`iot:CreatePolicy` / `iot:AttachPolicy`",{"_7897":431,"_22053":383,"_18699":33020,"_5":22203,"_15048":32871,"_1570":33021},[],"Crear y adjuntar políticas IoT",{"_7897":432,"_22053":383,"_18699":33023,"_5":22203,"_15048":32871,"_1570":33024},[],"`iot:CreateThingGroup` / `iot:AddThingToThingGroup`",{"_7897":433,"_22053":383,"_18699":33026,"_5":22203,"_15048":32871,"_1570":33027},[],"Gestionar grupos de Things",{"_7897":434,"_22053":383,"_18699":33029,"_5":22203,"_15048":32871,"_1570":33030},[],"`iot:CreateProvisioningTemplate`",{"_7897":435,"_22053":383,"_18699":33032,"_5":22203,"_15048":32871,"_1570":33033},[],"Crear plantillas JITP",{"_7897":436,"_22053":383,"_18699":33035,"_5":22203,"_15048":32871,"_1570":33036},[],"`iotdata:GetThingShadow` / `iotdata:UpdateThingShadow`",{"_7897":437,"_22053":383,"_18699":33038,"_5":22203,"_15048":32871,"_1570":33039},[],"Leer y escribir el Device Shadow",{"_7897":438,"_22053":383,"_18699":33041,"_5":22203,"_15048":32871,"_1570":33042},[],"Para el mecanismo de desconexión forzada tras revocación también se requiere acceso a la API del plano de datos de AWS IoT (`iot:Connect` con SigV4 sobre WebSocket), que se negocia de forma implícita con las credenciales del conector.",{"_7897":439,"_22053":383,"_18699":33044,"_5":22203,"_15048":32875,"_1570":33045},[],"Parámetro",{"_7897":440,"_22053":383,"_18699":33047,"_5":22203,"_15048":32875,"_1570":33048},[],"Tipo",{"_7897":441,"_22053":383,"_18699":33050,"_5":22203,"_15048":32875,"_1570":33051},[],"Requerido",{"_7897":442,"_22053":383,"_18699":33053,"_5":22203,"_15048":32875,"_1570":31917},[],{"_7897":443,"_22053":383,"_18699":33055,"_5":22203,"_15048":32875,"_1570":33056},[],"`connector_id`",{"_7897":444,"_22053":383,"_18699":33058,"_5":22203,"_15048":32875,"_1570":11501},[],{"_7897":445,"_22053":383,"_18699":33060,"_5":22203,"_15048":32875,"_1570":33061},[],"Sí",{"_7897":446,"_22053":383,"_18699":33063,"_5":22203,"_15048":32875,"_1570":33064},[],"Identificador único de esta instancia del conector. Se usa como espacio de nombres para los metadatos: `lamassu.io/iot/{connector_id}`.",{"_7897":447,"_22053":383,"_18699":33066,"_5":22203,"_15048":32875,"_1570":33067},[],"`aws_config.region`",{"_7897":448,"_22053":383,"_18699":33069,"_5":22203,"_15048":32875,"_1570":11501},[],{"_7897":449,"_22053":383,"_18699":33071,"_5":22203,"_15048":32875,"_1570":33061},[],{"_7897":450,"_22053":383,"_18699":33073,"_5":22203,"_15048":32875,"_1570":33074},[],"Región AWS donde opera el conector.",{"_7897":451,"_22053":383,"_18699":33076,"_5":22203,"_15048":32875,"_1570":33077},[],"`aws_config.auth_method`",{"_7897":452,"_22053":383,"_18699":33079,"_5":22203,"_15048":32875,"_1570":11501},[],{"_7897":453,"_22053":383,"_18699":33081,"_5":22203,"_15048":32875,"_1570":33061},[],{"_7897":454,"_22053":383,"_18699":33083,"_5":22203,"_15048":32875,"_1570":33084},[],"Método de autenticación: `static`, `role` o vacío (cadena de credenciales por defecto del SDK).",{"_7897":455,"_22053":383,"_18699":33086,"_5":22203,"_15048":32875,"_1570":33087},[],"`aws_config.access_key_id`",{"_7897":456,"_22053":383,"_18699":33089,"_5":22203,"_15048":32875,"_1570":11501},[],{"_7897":457,"_22053":383,"_18699":33091,"_5":22203,"_15048":32875,"_1570":33092},[],"Solo con `auth_method=static`",{"_7897":458,"_22053":383,"_18699":33094,"_5":22203,"_15048":32875,"_1570":33095},[],"Clave de acceso AWS.",{"_7897":459,"_22053":383,"_18699":33097,"_5":22203,"_15048":32875,"_1570":33098},[],"`aws_config.secret_access_key`",{"_7897":460,"_22053":383,"_18699":33100,"_5":22203,"_15048":32875,"_1570":11501},[],{"_7897":461,"_22053":383,"_18699":33102,"_5":22203,"_15048":32875,"_1570":33092},[],{"_7897":462,"_22053":383,"_18699":33104,"_5":22203,"_15048":32875,"_1570":33105},[],"Clave secreta AWS.",{"_7897":463,"_22053":383,"_18699":33107,"_5":22203,"_15048":32875,"_1570":33108},[],"`aws_config.session_token`",{"_7897":464,"_22053":383,"_18699":33110,"_5":22203,"_15048":32875,"_1570":11501},[],{"_7897":465,"_22053":383,"_18699":33112,"_5":22203,"_15048":32875,"_1570":33113},[],"No",{"_7897":466,"_22053":383,"_18699":33115,"_5":22203,"_15048":32875,"_1570":33116},[],"Token de sesión (con `auth_method=static`).",{"_7897":467,"_22053":383,"_18699":33118,"_5":22203,"_15048":32875,"_1570":33119},[],"`aws_config.role_arn`",{"_7897":468,"_22053":383,"_18699":33121,"_5":22203,"_15048":32875,"_1570":11501},[],{"_7897":469,"_22053":383,"_18699":33123,"_5":22203,"_15048":32875,"_1570":33124},[],"Solo con `auth_method=role`",{"_7897":470,"_22053":383,"_18699":33126,"_5":22203,"_15048":32875,"_1570":33127},[],"ARN del rol a asumir.",{"_7897":471,"_22053":383,"_18699":33129,"_5":22203,"_15048":32875,"_1570":33130},[],"`aws_config.endpoint_url`",{"_7897":472,"_22053":383,"_18699":33132,"_5":22203,"_15048":32875,"_1570":11501},[],{"_7897":473,"_22053":383,"_18699":33134,"_5":22203,"_15048":32875,"_1570":33113},[],{"_7897":474,"_22053":383,"_18699":33136,"_5":22203,"_15048":32875,"_1570":33137},[],"URL alternativa para todos los servicios AWS (útil con LocalStack en pruebas).",{"_7897":475,"_22053":383,"_18699":33139,"_5":22203,"_15048":32875,"_1570":33140},[],"`subscriber_event_bus`",{"_7897":476,"_22053":383,"_18699":33142,"_5":22203,"_15048":32875,"_1570":19004},[],{"_7897":477,"_22053":383,"_18699":33144,"_5":22203,"_15048":32875,"_1570":33061},[],{"_7897":478,"_22053":383,"_18699":33146,"_5":22203,"_15048":32875,"_1570":33147},[],"Configuración del bus de eventos al que se suscribe el conector (AMQP o AWS SQS/SNS).",{"_7897":479,"_22053":383,"_18699":33149,"_5":22203,"_15048":32875,"_1570":33150},[],"`dms_manager_client`",{"_7897":480,"_22053":383,"_18699":33152,"_5":22203,"_15048":32875,"_1570":11501},[],{"_7897":481,"_22053":383,"_18699":33154,"_5":22203,"_15048":32875,"_1570":33061},[],{"_7897":482,"_22053":383,"_18699":33156,"_5":22203,"_15048":32875,"_1570":33157},[],"URL HTTP del servicio DMS Manager de Lamassu.",{"_7897":483,"_22053":383,"_18699":33159,"_5":22203,"_15048":32875,"_1570":33160},[],"`device_manager_client`",{"_7897":484,"_22053":383,"_18699":33162,"_5":22203,"_15048":32875,"_1570":11501},[],{"_7897":485,"_22053":383,"_18699":33164,"_5":22203,"_15048":32875,"_1570":33061},[],{"_7897":486,"_22053":383,"_18699":33166,"_5":22203,"_15048":32875,"_1570":33167},[],"URL HTTP del Device Manager de Lamassu.",{"_7897":487,"_22053":383,"_18699":33169,"_5":22203,"_15048":32875,"_1570":33170},[],"`ca_client`",{"_7897":488,"_22053":383,"_18699":33172,"_5":22203,"_15048":32875,"_1570":11501},[],{"_7897":489,"_22053":383,"_18699":33174,"_5":22203,"_15048":32875,"_1570":33061},[],{"_7897":490,"_22053":383,"_18699":33176,"_5":22203,"_15048":32875,"_1570":33177},[],"URL HTTP del servicio de CA de Lamassu.",{"_7897":491,"_22053":383,"_18699":33179,"_5":22203,"_15048":32879,"_1570":33180},[],"Para que los dispositivos puedan autenticarse en AWS IoT Core con certificados emitidos por una CA de Lamassu, esa CA debe registrarse previamente en la cuenta AWS. El conector gestiona este registro de forma automática en respuesta a los eventos `EventCreateCAKey`, `EventImportCAKey` y `EventUpdateCAMetadataKey`, pero la operación **solo se dispara cuando el administrador la solicita explícitamente** mediante el campo de metadatos de la CA.",{"_7897":492,"_22053":383,"_18699":33182,"_5":22203,"_15048":32883,"_1570":33183},[],"El registro se desencadena estableciendo el valor `registration.status = \"REQUESTED\"` en la clave `lamassu.io/iot/{connector_id}` de los metadatos de la CA. Esto puede hacerse desde la consola de Lamassu en la sección de gestión de la CA o mediante la API.",{"_7897":493,"_22053":383,"_18699":33185,"_5":22203,"_15048":32883,"_1570":33186},[],"Una vez recibido el evento, el conector intenta registrar la CA en AWS y actualiza el campo `registration.status` en los metadatos de la CA con el resultado: `\"SUCCEEDED\"` si el registro fue correcto, o `\"FAILED\"` acompañado de un mensaje de error en caso contrario. El proceso es asíncrono, por lo que es necesario consultar periódicamente el estado de los metadatos hasta que la operación concluya.",{"_7897":494,"_22053":383,"_18699":33188,"_5":22203,"_15048":32887,"_1570":33189},[],"Cuando el parámetro `primary_account` es `true`, el conector ejecuta el flujo completo de registro con verificación de posesión de clave privada:",{"_7897":495,"_22053":383,"_18699":33191,"_5":22203,"_15048":32887,"_1570":33192},[],"Llama a `iot:GetRegistrationCode` para obtener el código de verificación de AWS.",{"_7897":496,"_22053":383,"_18699":33194,"_5":22203,"_15048":32887,"_1570":33195},[],"El conector genera internamente un par de claves RSA-2048 efímero y construye un CSR cuyo Common Name es exactamente ese código de registro. A continuación llama al servicio de firma de Lamassu para que la CA registrada emita un certificado de verificación X.509 real firmando ese CSR. La clave privada efímera se usa únicamente para este propósito y no se almacena ni se envía a AWS.",{"_7897":497,"_22053":383,"_18699":33197,"_5":22203,"_15048":32887,"_1570":33198},[],"Envía a AWS la CA (en PEM) y el certificado de verificación mediante `iot:RegisterCACertificate`, activando el registro con `AllowAutoRegistration: true`.",{"_7897":498,"_22053":383,"_18699":33200,"_5":22203,"_15048":32887,"_1570":33201},[],"Solo una cuenta puede ser propietaria de una CA en una región AWS dada. Si la CA ya está registrada con el mismo número de serie, el conector omite el paso silenciosamente.",{"_7897":499,"_22053":383,"_18699":33203,"_5":22203,"_15048":32887,"_1570":33204},[],"Los tags que AWS IoT Core aplica al certificado de CA registrado son `LMS.CA.ID`, `LMS.CA.SN` y `LMS.CA.CN`.",{"_7897":500,"_22053":383,"_18699":33206,"_5":22203,"_15048":32891,"_1570":33207},[],"Cuando `primary_account` es `false`, el conector registra la CA usando el modo `CertificateMode: SNI_ONLY`. Este modo no requiere código de verificación ni acceso a la clave privada de la CA, por lo que es la opción adecuada cuando la CA se gestiona desde otra cuenta de AWS o cuando el administrador no dispone de la clave privada. Es el método habitual para registrar la misma CA en varias cuentas de AWS simultáneamente.",{"_7897":501,"_22053":383,"_18699":33209,"_5":22203,"_15048":32895,"_1570":33210},[],"Cada DMS que participe en la integración con AWS IoT Core debe tener configurada la clave de metadatos `lamassu.io/iot/{connector_id}`. El campo más importante de esa configuración es `registration_mode`, que determina cómo se aprovisionan los dispositivos en AWS.",{"_7897":502,"_22053":383,"_18699":33212,"_5":22203,"_15048":32895,"_1570":33213},[],"Existen tres modos de registro, y la elección entre ellos depende de la estrategia de aprovisionamiento de la flota.",{"_7897":503,"_22053":383,"_18699":33215,"_5":22203,"_15048":32899,"_1570":33216},[],"En este modo el conector **no crea Things, grupos ni políticas** en AWS IoT Core. Se limita a sincronizar el estado de los certificados (activo, revocado, suspendido) a medida que cambian en Lamassu. Es el modo adecuado cuando el aprovisionamiento de Things en AWS se gestiona por un sistema externo y solo se necesita que Lamassu mantenga el estado de los certificados actualizado.",{"_7897":504,"_22053":383,"_18699":33218,"_5":22203,"_15048":32903,"_1570":33219},[],"El modo `auto` delega en Lamassu el aprovisionamiento completo del dispositivo en AWS en el momento del enrolamiento. Cuando el dispositivo completa con éxito su enrolamiento EST y Lamassu emite el evento `EventBindDeviceIdentityKey`, el conector ejecuta automáticamente la siguiente secuencia:",{"_7897":505,"_22053":383,"_18699":33221,"_5":22203,"_15048":32903,"_1570":33222},[],"Crea o actualiza las políticas IoT configuradas en el DMS.",{"_7897":506,"_22053":383,"_18699":33224,"_5":22203,"_15048":32903,"_1570":33225},[],"Crea el grupo raíz `LAMASSU` en la cuenta AWS (si no existe) y los grupos hijos configurados en el DMS como subgrupos de `LAMASSU`. Si los grupos ya existen, el error `ResourceAlreadyExistsException` se ignora, por lo que la operación es idempotente.",{"_7897":507,"_22053":383,"_18699":33227,"_5":22203,"_15048":32903,"_1570":33228},[],"Si el Thing ya existía en AWS IoT Core, el conector itera todos los certificados (principals) actualmente adjuntos a ese Thing y los marca como `REVOKED` en AWS, para garantizar que los certificados anteriores no puedan seguir siendo usados para autenticarse.",{"_7897":508,"_22053":383,"_18699":33230,"_5":22203,"_15048":32903,"_1570":33231},[],"Llama a `iot:RegisterThing` con una plantilla de aprovisionamiento de estilo CloudFormation que crea el Thing, registra el certificado del dispositivo (PEM del certificado del dispositivo y del certificado de la CA emisora) y adjunta las políticas configuradas.\nUna vez completado el aprovisionamiento, el conector almacena el ARN del certificado resultante en los metadatos del certificado de Lamassu bajo la clave `lamassu.io/iot/{connector_id}` y marca el dispositivo como `Registered: true` en Device Manager.",{"_7897":509,"_22053":383,"_18699":33233,"_5":22203,"_15048":32903,"_1570":33234},[],"**El nombre del Thing en AWS es el Common Name (CN) del certificado del dispositivo.** Esta convención es fundamental para el desarrollador de firmware: el valor `/CN=` que el dispositivo incluye en su CSR al enrolarse se convierte en el ThingName con el que deberá identificarse en todas las operaciones MQTT contra AWS IoT Core.",{"_7897":510,"_22053":383,"_18699":33236,"_5":22203,"_15048":32907,"_1570":33237},[],"El modo Just-In-Time Provisioning (JITP) delega el aprovisionamiento en AWS en lugar de hacerlo el conector directamente. Cuando el conector detecta que el DMS está en modo `jitp`, crea una plantilla de aprovisionamiento JITP en AWS IoT Core y la adjunta al certificado de CA registrado. Esta plantilla se crea o actualiza en el momento en que el DMS se crea o actualiza en Lamassu - no en el momento del enrolamiento del dispositivo. A partir de ese momento, cuando un dispositivo con un certificado emitido por esa CA se conecta por primera vez a AWS IoT Core, AWS ejecuta la plantilla automáticamente: crea el Thing, registra el certificado y lo activa.",{"_7897":511,"_22053":383,"_18699":33239,"_5":22203,"_15048":32907,"_1570":33240},[],"El nombre del Thing en la plantilla JITP se deriva de `AWS::IoT::Certificate::CommonName`, que corresponde al CN del certificado del dispositivo - la misma convención que el modo `auto`.",{"_7897":512,"_22053":383,"_18699":33242,"_5":22203,"_15048":32907,"_1570":33243},[],"Este modo requiere que se configure el campo `jitp_config.provisioning_role_arn` con el ARN de un rol IAM que AWS IoT Core pueda asumir para ejecutar la plantilla. Si no se configura, el conector utiliza el valor por defecto `arn:aws:iam::{account}:role/JITPRole` y registra un aviso en el log. El administrador debe asegurarse de que ese rol existe en la cuenta y tiene los permisos necesarios antes de activar el modo JITP.",{"_7897":513,"_22053":383,"_18699":33245,"_5":22203,"_15048":32911,"_1570":33246},[],"Para el desarrollador de firmware, el modo `auto` es transparente: el dispositivo realiza su enrolamiento EST de la forma habitual y, como efecto secundario, queda aprovisionado en AWS IoT Core sin ningún paso adicional.",{"_7897":514,"_22053":383,"_18699":33248,"_5":22203,"_15048":32911,"_1570":33249},[],"El flujo completo desde el punto de vista del dispositivo es el siguiente:",{"_7897":515,"_22053":383,"_18699":33251,"_5":22203,"_15048":32911,"_1570":33252},[],"Una vez que el conector completa el aprovisionamiento, el dispositivo puede conectarse al endpoint AWS IoT Core de MQTT usando su clave privada y el certificado emitido por Lamassu. El ThingName con el que debe identificarse en AWS es exactamente el CN del certificado.",{"_7897":516,"_22053":383,"_18699":33254,"_5":22203,"_15048":32915,"_1570":33255},[],"En el modo JITP el dispositivo también realiza su enrolamiento EST de forma convencional y obtiene su certificado de Lamassu. La diferencia es que AWS IoT Core no conoce al dispositivo hasta que este intenta conectarse por primera vez.",{"_7897":517,"_22053":383,"_18699":33257,"_5":22203,"_15048":32915,"_1570":33258},[],"Cuando el dispositivo establece su primera conexión MQTT a AWS IoT Core presentando el certificado emitido por Lamassu, AWS detecta que el certificado pertenece a una CA registrada con una plantilla JITP, ejecuta esa plantilla y crea el Thing automáticamente. La conexión inicial puede fallar o demorarse mientras se ejecuta la plantilla; el firmware debe estar preparado para reintentar la conexión.",{"_7897":518,"_22053":383,"_18699":33260,"_5":22203,"_15048":32915,"_1570":33261},[],"Para que el flujo JITP funcione correctamente:",{"_7897":519,"_22053":383,"_18699":33263,"_5":22203,"_15048":32915,"_1570":33264},[],"La CA debe estar registrada en AWS en modo Primary Account (el modo SNI-only no admite JITP).",{"_7897":520,"_22053":383,"_18699":33266,"_5":22203,"_15048":32915,"_1570":33267},[],"El rol IAM configurado en `jitp_config.provisioning_role_arn` debe existir y tener permisos para crear Things, registrar certificados y adjuntar políticas en la cuenta AWS.",{"_7897":521,"_22053":383,"_18699":33269,"_5":22203,"_15048":32915,"_1570":33270},[],"El dispositivo debe presentar tanto su certificado como el certificado de la CA emisora en el handshake TLS con AWS IoT Core.",{"_7897":522,"_22053":383,"_18699":33272,"_5":22203,"_15048":32915,"_1570":33273},[],"Los certificados aprovisionados mediante JITP **no tienen asociada la clave de metadatos del conector** (`lamassu.io/iot/{connector_id}`) en Lamassu. Como consecuencia, los cambios de estado de esos certificados en Lamassu no se sincronizan automáticamente con AWS a través del mecanismo de sincronización de estado descrito en la siguiente sección.",{"_7897":523,"_22053":383,"_18699":33275,"_5":22203,"_15048":32919,"_1570":33276},[],"El conector escucha el evento `EventUpdateCertificateStatusKey` y, cuando un certificado que tiene la clave de metadatos del conector cambia de estado en Lamassu, replica ese cambio en AWS IoT Core. La tabla siguiente muestra la correspondencia de estados:",{"_7897":524,"_22053":383,"_18699":33278,"_5":22203,"_15048":32919,"_1570":33279},[],"Estado en Lamassu",{"_7897":525,"_22053":383,"_18699":33281,"_5":22203,"_15048":32919,"_1570":33282},[],"Razón de revocación",{"_7897":526,"_22053":383,"_18699":33284,"_5":22203,"_15048":32919,"_1570":33285},[],"Estado en AWS IoT Core",{"_7897":527,"_22053":383,"_18699":33287,"_5":22203,"_15048":32919,"_1570":33288},[],"`Active`",{"_7897":528,"_22053":383,"_18699":33290,"_5":22203,"_15048":32919,"_1570":33291},[],"—",{"_7897":529,"_22053":383,"_18699":33293,"_5":22203,"_15048":32919,"_1570":33294},[],"`ACTIVE`",{"_7897":530,"_22053":383,"_18699":33296,"_5":22203,"_15048":32919,"_1570":33297},[],"`Revoked`",{"_7897":531,"_22053":383,"_18699":33299,"_5":22203,"_15048":32919,"_1570":33300},[],"`certificateHold`",{"_7897":532,"_22053":383,"_18699":33302,"_5":22203,"_15048":32919,"_1570":33303},[],"`INACTIVE`",{"_7897":533,"_22053":383,"_18699":33305,"_5":22203,"_15048":32919,"_1570":33297},[],{"_7897":534,"_22053":383,"_18699":33307,"_5":22203,"_15048":32919,"_1570":33308},[],"Cualquier otra razón",{"_7897":535,"_22053":383,"_18699":33310,"_5":22203,"_15048":32919,"_1570":33311},[],"`REVOKED`",{"_7897":536,"_22053":383,"_18699":33313,"_5":22203,"_15048":32919,"_1570":33314},[],"Solo los estados `Active` y `Revoked` producen una llamada a `iot:UpdateCertificate`. Los demás estados del ciclo de vida de Lamassu (`RenewalWindow`, `AboutToExpire`, `Expired`) no se sincronizan con AWS IoT Core; el estado del certificado en AWS permanece sin cambios hasta que el estado en Lamassu sea `Active` o `Revoked`.",{"_7897":537,"_22053":383,"_18699":33316,"_5":22203,"_15048":32923,"_1570":33317},[],"Cuando el conector marca un certificado como `REVOKED` o `INACTIVE` en AWS, ejecuta adicionalmente una desconexión forzada del dispositivo. Para ello abre una conexión MQTT sobre WebSocket (con autenticación SigV4 con las credenciales del conector) al endpoint de datos de AWS IoT Core, usando el CN del certificado como identificador de cliente MQTT, y la cierra inmediatamente. Esto termina cualquier sesión MQTT activa que el dispositivo pueda tener en ese momento.",{"_7897":538,"_22053":383,"_18699":33319,"_5":22203,"_15048":32923,"_1570":33320},[],"Esta desconexión forzada se produce en el momento en que Lamassu registra el cambio de estado. Si el dispositivo vuelve a intentar conectarse tras la desconexión, AWS IoT Core rechazará la conexión porque el certificado ya figura como `REVOKED` o `INACTIVE`.",{"_7897":539,"_22053":383,"_18699":33322,"_5":22203,"_15048":32923,"_1570":33323},[],"Los certificados aprovisionados en modo JITP no disponen de esta sincronización automática, ya que no tienen la clave de metadatos del conector.",{"_7897":540,"_22053":383,"_18699":33325,"_5":22203,"_15048":32927,"_1570":33326},[],"El conector puede escribir en el Device Shadow de AWS IoT Core para enviar señales de acción al firmware del dispositivo. Esta funcionalidad se activa por DMS mediante `shadow_config.enable: true`.",{"_7897":541,"_22053":383,"_18699":33328,"_5":22203,"_15048":32927,"_1570":33329},[],"Si `shadow_config.shadow_name` contiene un valor, el conector usa un Named Shadow con ese nombre; en caso contrario, usa el Classic Shadow (shadow predeterminado del Thing).",{"_7897":542,"_22053":383,"_18699":33331,"_5":22203,"_15048":32931,"_1570":33332},[],"El conector escribe en el campo `desired.identity_actions` del documento shadow. Cada entrada contiene un timestamp Unix en milisegundos. El firmware del dispositivo debe leer este campo y actuar en consecuencia.",{"_7897":543,"_22053":383,"_18699":33334,"_5":22203,"_15048":32931,"_1570":33335},[],"Existen dos tipos de acciones:",{"_7897":544,"_22053":383,"_18699":33337,"_5":22203,"_15048":32931,"_1570":33338},[],"**`UPDATE_CERTIFICATE`**: se escribe cuando la ventana de renovación preventiva de un certificado se activa - es decir, cuando el campo `triggered` de la delta de renovación preventiva pasa de `false` a `true`. Esta acción indica al dispositivo que debe iniciar el proceso de re-enrolamiento para renovar su certificado antes de que expire.",{"_7897":545,"_22053":383,"_18699":33340,"_5":22203,"_15048":32931,"_1570":33341},[],"**`UPDATE_TRUST_ANCHOR_LIST`**: se escribe en todos los dispositivos de un DMS cuando la lista `ManagedCAs` del DMS cambia. Esta acción indica al dispositivo que debe actualizar su almacén de CAs de confianza.",{"_7897":546,"_22053":383,"_18699":33343,"_5":22203,"_15048":32931,"_1570":33344},[],"El proceso de escritura en el shadow consiste en leer el shadow actual (`iotdata:GetThingShadow`), combinar las nuevas acciones con las existentes y escribir el resultado (`iotdata:UpdateThingShadow`). Si el shadow no existe, el conector lo crea. Tras una escritura correcta, la lista de acciones pendientes en los metadatos del dispositivo en Lamassu se limpia.",{"_7897":547,"_22053":383,"_18699":33346,"_5":22203,"_15048":32935,"_1570":33347},[],"El conector crea y adjunta las políticas que se configuran en el DMS. Una política típica para un dispositivo que usa MQTT y Device Shadow tiene la siguiente estructura:",{"_7897":548,"_22053":383,"_18699":33349,"_5":22203,"_15048":32935,"_1570":33350},[],"En la política anterior, los marcadores `<AWS_REGION>` y `<AWS_ACCOUNT_ID>` deben reemplazarse por la región AWS y el identificador de cuenta de doce dígitos de la cuenta destino antes de aplicar la política. La variable `${iot:Connection.Thing.ThingName}` limita automáticamente cada permiso al Thing al que el dispositivo está conectado, siguiendo el principio de mínimo privilegio. La variable `${ShadowName}` en los ARN de shadow es un marcador que debe reemplazarse con el valor de `shadow_config.shadow_name` configurado en el DMS; si se usa el Classic Shadow, se puede simplificar eliminando el segmento `name/${ShadowName}/`. Las políticas de AWS IoT no admiten expresiones regulares con alternancia; la notación `[name/${ShadowName}/]*` representa la opcionalidad del segmento dentro de las restricciones de la sintaxis de ARN.",{"_7897":549,"_22053":383,"_18699":33352,"_5":22203,"_15048":32935,"_1570":33353},[],"El primer statement permite que el dispositivo se conecte usando su ThingName como identificador MQTT. El segundo autoriza la publicación en el topic MQTT genérico del Thing y en los topics del shadow, necesario para que el dispositivo pueda actualizar el estado reportado. Los dos últimos statements otorgan permisos de suscripción y recepción sobre los mismos topics, lo que permite al dispositivo recibir actualizaciones del shadow (por ejemplo, las acciones `UPDATE_CERTIFICATE` y `UPDATE_TRUST_ANCHOR_LIST` escritas por el conector).",{"_7897":550,"_22053":383,"_18699":33355,"_5":22203,"_15048":32939,"_1570":33356},[],"**Síntoma:** El registro de la CA permanece indefinidamente en estado `REQUESTED`.",{"_7897":551,"_22053":383,"_18699":33358,"_5":22203,"_15048":32939,"_1570":33359},[],"**Causa:** El conector no está en ejecución o no está suscrito al bus de eventos. También puede indicar credenciales IAM incorrectas, permisos insuficientes o que la clave de metadatos se escribió con un `connector_id` incorrecto.",{"_7897":552,"_22053":383,"_18699":33361,"_5":22203,"_15048":32939,"_1570":33362},[],"**Resolución:** Verificar que el proceso del conector está activo y que los logs no muestran errores de comunicación con AWS. Comprobar que el campo de metadatos se escribió bajo la clave exacta `lamassu.io/iot/{connector_id}`. Si el error persiste, el conector actualizará el estado a `FAILED` con un mensaje descriptivo en los metadatos de la CA.",{"_7897":553,"_22053":383,"_18699":33364,"_5":22203,"_15048":32939,"_1570":33365},[],"**Síntoma:** El estado de un certificado no se sincroniza con AWS tras una revocación.",{"_7897":554,"_22053":383,"_18699":33367,"_5":22203,"_15048":32939,"_1570":33368},[],"**Causa:** Lo más habitual es que el certificado fue aprovisionado en modo JITP. Los certificados JITP no tienen la clave de metadatos del conector y quedan fuera del mecanismo de sincronización de estado. Si el DMS está en modo `auto`, puede indicar que el aprovisionamiento inicial no completó correctamente y el ARN de AWS no se almacenó en los metadatos del certificado.",{"_7897":555,"_22053":383,"_18699":33370,"_5":22203,"_15048":32939,"_1570":33371},[],"**Resolución:** Para certificados JITP, migrar el DMS a modo `auto` y re-aprovisionar los dispositivos afectados. Para certificados en modo `auto`, verificar que el certificado tiene el ARN de AWS almacenado en sus metadatos; si no lo tiene, repetir el aprovisionamiento.",{"_7897":556,"_22053":383,"_18699":33373,"_5":22203,"_15048":32939,"_1570":33374},[],"**Síntoma:** La desconexión forzada no termina la sesión MQTT del dispositivo tras la revocación.",{"_7897":557,"_22053":383,"_18699":33376,"_5":22203,"_15048":32939,"_1570":33377},[],"**Causa:** El dispositivo usa un client ID MQTT diferente al CN del certificado. La desconexión forzada abre una conexión usando el CN como client ID; si el firmware usa otro identificador, la desconexión no afecta a esa sesión.",{"_7897":558,"_22053":383,"_18699":33379,"_5":22203,"_15048":32939,"_1570":33380},[],"**Resolución:** Asegurarse de que el firmware usa exactamente el CN del certificado como identificador de cliente MQTT. Ese CN coincide con el ThingName en AWS IoT Core.",{"_7897":559,"_22053":383,"_18699":33382,"_5":22203,"_15048":32939,"_1570":33383},[],"**Síntoma:** El dispositivo recibe `CLIENT_ID_REJECTED` al conectarse a AWS IoT Core.",{"_7897":560,"_22053":383,"_18699":33385,"_5":22203,"_15048":32939,"_1570":33386},[],"**Causa:** El client ID MQTT no coincide con el ThingName, que es siempre el CN del certificado emitido por Lamassu.",{"_7897":561,"_22053":383,"_18699":33388,"_5":22203,"_15048":32939,"_1570":33389},[],"**Resolución:** Verificar que el firmware usa exactamente el valor del campo CN incluido en el CSR de enrolamiento como identificador de cliente MQTT.",{"_7897":562,"_22053":383,"_18699":33391,"_5":22203,"_15048":32939,"_1570":33392},[],"**Síntoma:** La primera conexión MQTT del dispositivo en modo JITP falla o excede el tiempo de espera.",{"_7897":563,"_22053":383,"_18699":33394,"_5":22203,"_15048":32939,"_1570":33395},[],"**Causa:** Es el comportamiento esperado mientras AWS ejecuta la plantilla JITP en la primera conexión del dispositivo.",{"_7897":564,"_22053":383,"_18699":33397,"_5":22203,"_15048":32939,"_1570":33398},[],"**Resolución:** El firmware debe implementar reintentos con backoff exponencial para la primera conexión. Si el fallo persiste más allá de unos minutos, verificar que el rol IAM configurado en `jitp_config.provisioning_role_arn` existe en la cuenta y tiene permisos para crear Things, registrar certificados y adjuntar políticas.",{"_7897":565,"_22053":383,"_18699":33400,"_5":22203,"_15048":32939,"_1570":33401},[],"**Síntoma:** El Device Shadow no se actualiza cuando debería.",{"_7897":566,"_22053":383,"_18699":33403,"_5":22203,"_15048":32939,"_1570":33404},[],"**Causa:** La función de shadow está desactivada en la configuración del DMS, las credenciales del conector carecen de permisos sobre la API de datos de IoT, o el firmware lee un shadow diferente al configurado.",{"_7897":567,"_22053":383,"_18699":33406,"_5":22203,"_15048":32939,"_1570":33407},[],"**Resolución:** Comprobar que `shadow_config.enable` está a `true` en los metadatos del conector para el DMS correspondiente. Si se usa Named Shadow, verificar que `shadow_config.shadow_name` contiene el nombre correcto y que el firmware lee ese Named Shadow y no el Classic Shadow. Confirmar que las credenciales del conector tienen permisos `iotdata:GetThingShadow` y `iotdata:UpdateThingShadow`.",{"_7897":568,"_22053":383,"_18699":33409,"_5":22203,"_15048":32939,"_1570":33410},[],"<Card title=\"Configurar un DMS\" href=\"/docs/manual/servicios-core/ra\" />",{"_7897":569,"_22053":383,"_18699":33412,"_5":22203,"_15048":32939,"_1570":33413},[],"<Card title=\"Enrolamiento de dispositivos (EST)\" href=\"/docs/manual/servicios-core/est\" />",{"_7897":570,"_22053":383,"_18699":33415,"_5":22203,"_15048":32939,"_1570":33416},[],"<Card title=\"Gestión de certificados\" href=\"/docs/manual/servicios-core/certificates\" />",{"_7897":571,"_22053":571,"_5":22198,"_1570":33418,"_22211":33419,"_18699":33420,"_15048":571},"[Alerts] Alertas y Suscripciones",[31714,32813,32822],[],{"_7897":572,"_22053":571,"_18699":33422,"_5":22203,"_15048":571,"_1570":33423},[],"Monitorización proactiva mediante eventos y suscripciones",{"_7897":573,"_22053":571,"_5":22208,"_18699":33425,"_15048":33426,"_1570":33427},[],"/docs/pr-preview/pr-22/manual/servicios-core/alerts#alertas","Alertas",{"_7897":574,"_22053":571,"_5":22208,"_18699":33429,"_15048":33430,"_1570":33431},[],"/docs/pr-preview/pr-22/manual/servicios-core/alerts#eventos-y-suscripciones","Eventos y Suscripciones",{"_7897":575,"_22053":571,"_5":22208,"_18699":33433,"_15048":33434,"_1570":33435},[],"/docs/pr-preview/pr-22/manual/servicios-core/alerts#gestión-de-suscripciones","Gestión de Suscripciones",{"_7897":576,"_22053":571,"_5":22208,"_18699":33437,"_15048":33438,"_1570":33439},[],"/docs/pr-preview/pr-22/manual/servicios-core/alerts#filtros-y-condiciones","Filtros y condiciones",{"_7897":577,"_22053":571,"_5":22208,"_18699":33441,"_15048":33442,"_1570":33443},[],"/docs/pr-preview/pr-22/manual/servicios-core/alerts#confirmación-de-la-suscripción","Confirmación de la suscripción",{"_7897":578,"_22053":571,"_5":22208,"_18699":33445,"_15048":33446,"_1570":33447},[],"/docs/pr-preview/pr-22/manual/servicios-core/alerts#gestión-de-suscripciones-existentes","Gestión de Suscripciones Existentes",{"_7897":579,"_22053":571,"_5":22208,"_18699":33449,"_15048":33450,"_1570":33451},[],"/docs/pr-preview/pr-22/manual/servicios-core/alerts#catálogo-de-eventos-del-sistema","Catálogo de Eventos del Sistema",{"_7897":580,"_22053":571,"_18699":33453,"_5":22203,"_15048":33426,"_1570":33454},[],"La funcionalidad de **Alertas** en Lamassu IoT es una herramienta avanzada para la monitorización y la observación del estado de la PKI. Va más allá de la simple visualización, permitiendo a los usuarios **reaccionar de forma proactiva y automatizada** a los eventos que ocurren en la infraestructura. Esta capacidad es crucial en entornos de IoT, donde el número de dispositivos y la frecuencia de las operaciones hacen inviable la monitorización manual. A través de la gestión de suscripciones, los administradores pueden asegurarse de que eventos críticos, como la revocación de un certificado o la detección de un intento de registro fallido, no pasen desapercibidos, lo que mejora la seguridad y la resiliencia del sistema.",{"_7897":581,"_22053":571,"_18699":33456,"_5":22203,"_15048":33430,"_1570":33457},[],"La página principal de alertas presenta una lista exhaustiva de todos los **tipos de eventos** que pueden ser generados por la PKI de Lamassu IoT. Estos eventos cubren un amplio espectro de actividades, desde operaciones de ciclo de vida de certificados y dispositivos hasta cambios de estado en las RA. Para cada tipo de evento, la interfaz proporciona un conjunto de métricas clave que facilitan la toma de decisiones:",{"_7897":582,"_22053":571,"_18699":33459,"_5":22203,"_15048":33430,"_1570":33460},[],"**Last Seen**: Muestra cuándo ocurrió la última instancia del evento. Esto ayuda a identificar si un evento es recurrente o si ha ocurrido recientemente, lo cual es fundamental para el diagnóstico.",{"_7897":583,"_22053":571,"_18699":33462,"_5":22203,"_15048":33430,"_1570":33463},[],"**Counter**: Indica el número total de veces que el evento ha sido registrado en el sistema. Un contador alto puede señalar una tendencia, un problema subyacente en un dispositivo o una configuración errónea.",{"_7897":584,"_22053":571,"_18699":33465,"_5":22203,"_15048":33430,"_1570":33466},[],"**Subscriptions**: Informa si ya existen suscripciones activas para ese evento, evitando la creación de suscripciones duplicadas y proporcionando una visión general de la monitorización ya implementada.",{"_7897":585,"_22053":571,"_18699":33468,"_5":22203,"_15048":33430,"_1570":33469},[],"**Actions**: El botón **Subscribe** permite iniciar el proceso de creación de una nueva suscripción, adaptada a las necesidades específicas del usuario o equipo.",{"_7897":586,"_22053":571,"_18699":33471,"_5":22203,"_15048":33430,"_1570":33472},[],"Adicionalmente, al expandir la información de cada evento, se presenta un **ejemplo de la estructura de datos JSON** de la última instancia registrada. Esta información es de gran valor, ya que permite a los desarrolladores y administradores entender con precisión el esquema de la notificación y cómo procesarla en sistemas externos, como un sistema de gestión de incidentes o una aplicación de automatización.",{"_7897":587,"_22053":571,"_18699":33474,"_5":22203,"_15048":33434,"_1570":33475},[],"Para cada evento, se puede crear una suscripción a la que se envían notificaciones cuando el evento ocurre. Este proceso permite a los administradores del sistema personalizar qué eventos monitorizan y cómo son notificados. La configuración de las suscripciones, incluyendo el destino de las notificaciones, se gestiona de forma individual para cada tipo de evento.",{"_7897":588,"_22053":571,"_18699":33477,"_5":22203,"_15048":33434,"_1570":33478},[],"Al pulsar sobre el botón **Subscribe** se abre un modal de configuración que permite seleccionar uno de los tres mecanismos de notificación disponibles en Lamassu IoT.",{"_7897":589,"_22053":571,"_18699":33480,"_5":22203,"_15048":33434,"_1570":33481},[],"**Email Notification**: Envía una notificación por correo electrónico a una dirección específica cada vez que el evento se registra. Para configurar este método, solo es necesario proporcionar la dirección de correo electrónico de destino.",{"_7897":590,"_22053":571,"_18699":33483,"_5":22203,"_15048":33434,"_1570":33484},[],"**Microsoft Teams Webhook**: Utiliza un webhook para enviar una notificación al canal de Microsoft Teams configurado, lo que permite integrar las alertas directamente en los flujos de trabajo de colaboración. Se debe proporcionar un nombre para la suscripción y la URL del webhook de Microsoft Teams.",{"_7897":591,"_22053":571,"_18699":33486,"_5":22203,"_15048":33434,"_1570":33487},[],"**Webhook**: Envía una notificación en formato JSON a una URL de webhook personalizada, lo que permite integrar las alertas con cualquier servicio o aplicación que soporte este protocolo. Para este mecanismo, se debe especificar un nombre, el **Método HTTP** (siempre **POST** o **PUT**) y la URL de destino. El documento JSON del evento se entregará como el cuerpo de la solicitud HTTP.",{"_7897":592,"_22053":571,"_18699":33489,"_5":22203,"_15048":33438,"_1570":33490},[],"Después de seleccionar el mecanismo de notificación, se puede establecer un filtro para determinar las condiciones que deben cumplirse para que el evento sea notificado. Esto permite un control más granular y evita recibir notificaciones irrelevantes. Los formatos de filtro disponibles son:",{"_7897":593,"_22053":571,"_18699":33492,"_5":22203,"_15048":33438,"_1570":33493},[],"**None**: No se aplica ningún filtro. Se enviarán notificaciones para todas las instancias del evento.",{"_7897":594,"_22053":571,"_18699":33495,"_5":22203,"_15048":33438,"_1570":33496},[],"**JSON Path**: Utiliza la sintaxis de JSON Path para evaluar una condición sobre un campo específico del evento JSON.",{"_7897":595,"_22053":571,"_18699":33498,"_5":22203,"_15048":33438,"_1570":33499},[],"**JSON Schema**: Permite aplicar un esquema JSON para validar el evento. Las notificaciones solo se enviarán si el evento cumple con el esquema definido. Esto es útil para asegurar que solo se procesen eventos con un formato de datos esperado y consistente.",{"_7897":596,"_22053":571,"_18699":33501,"_5":22203,"_15048":33438,"_1570":33502},[],"**Javascript**: Permite escribir una función de JavaScript personalizada para evaluar condiciones complejas sobre el evento JSON. Por ejemplo, la función `function (event) { return event.data.status == \"NO_IDENTITY\"; }` podría usarse para notificar solo cuando el estado de un dispositivo cambia a \"No Identity\". Esto ofrece la mayor flexibilidad, ya que se pueden aplicar lógicas avanzadas para filtrar los eventos antes de que se envíen las notificaciones.",{"_7897":597,"_22053":571,"_18699":33504,"_5":22203,"_15048":33442,"_1570":33505},[],"El último paso del proceso es la **confirmación**. Una vez que se ha configurado el canal de notificación y el filtro (si corresponde), la interfaz muestra un resumen de la suscripción. Aquí puedes revisar el tipo de evento, el canal de notificación seleccionado y la condición del filtro antes de confirmar.",{"_7897":598,"_22053":571,"_18699":33507,"_5":22203,"_15048":33442,"_1570":33508},[],"Al hacer clic en **Confirm Subscription**, la suscripción se activa y Lamassu IoT comenzará a enviar notificaciones basadas en la configuración que has establecido.",{"_7897":599,"_22053":571,"_18699":33510,"_5":22203,"_15048":33446,"_1570":33511},[],"Para gestionar una suscripción que ya está activa, simplemente selecciónala en el listado de la página principal de alertas. Al hacerlo, se abrirá un modal de **Subscription Details** que muestra toda la información de la suscripción. Desde esta ventana, se pueden realizar las siguientes acciones:",{"_7897":600,"_22053":571,"_18699":33513,"_5":22203,"_15048":33446,"_1570":33514},[],"**Ver detalles**: Muestra información completa sobre la suscripción, incluyendo su tipo de evento, el canal de notificación, los detalles de contacto (como la dirección de correo electrónico) y las condiciones de filtrado aplicadas.",{"_7897":601,"_22053":571,"_18699":33516,"_5":22203,"_15048":33446,"_1570":33517},[],"**Editar**: Permite modificar la configuración de la suscripción, como el canal de notificación o el filtro.",{"_7897":602,"_22053":571,"_18699":33519,"_5":22203,"_15048":33446,"_1570":33520},[],"**Anular suscripción (Unsubscribe)**: Desactiva y elimina la suscripción. Esta acción es útil cuando una alerta ya no es necesaria.",{"_7897":603,"_22053":571,"_18699":33522,"_5":22203,"_15048":33450,"_1570":33523},[],"La siguiente tabla resume los eventos que pueden ser generados por la plataforma Lamassu IoT, clasificados por el componente que los origina.",{"_7897":604,"_22053":571,"_18699":33525,"_5":22203,"_15048":33450,"_1570":33526},[],"Evento",{"_7897":605,"_22053":571,"_18699":33528,"_5":22203,"_15048":33450,"_1570":31917},[],{"_7897":606,"_22053":571,"_18699":33530,"_5":22203,"_15048":33450,"_1570":33531},[],"**ca.create**",{"_7897":607,"_22053":571,"_18699":33533,"_5":22203,"_15048":33450,"_1570":33534},[],"Creación de una CA",{"_7897":608,"_22053":571,"_18699":33536,"_5":22203,"_15048":33450,"_1570":33537},[],"**ca.import**",{"_7897":609,"_22053":571,"_18699":33539,"_5":22203,"_15048":33450,"_1570":33540},[],"Importación de una CA",{"_7897":610,"_22053":571,"_18699":33542,"_5":22203,"_15048":33450,"_1570":33543},[],"**ca.profile.update**",{"_7897":611,"_22053":571,"_18699":33545,"_5":22203,"_15048":33450,"_1570":33546},[],"Actualización de perfil de CA",{"_7897":612,"_22053":571,"_18699":33548,"_5":22203,"_15048":33450,"_1570":33549},[],"**ca.reissue**",{"_7897":613,"_22053":571,"_18699":33551,"_5":22203,"_15048":33450,"_1570":33552},[],"Reemisión de una CA",{"_7897":614,"_22053":571,"_18699":33554,"_5":22203,"_15048":33450,"_1570":33555},[],"**ca.sign.certificate**",{"_7897":615,"_22053":571,"_18699":33557,"_5":22203,"_15048":33450,"_1570":33558},[],"Firma / emisión de certificado",{"_7897":616,"_22053":571,"_18699":33560,"_5":22203,"_15048":33450,"_1570":33561},[],"**ca.signature.sign**",{"_7897":617,"_22053":571,"_18699":33563,"_5":22203,"_15048":33450,"_1570":33564},[],"Operación de firma criptográfica",{"_7897":618,"_22053":571,"_18699":33566,"_5":22203,"_15048":33450,"_1570":33567},[],"**ca.delete**",{"_7897":619,"_22053":571,"_18699":33569,"_5":22203,"_15048":33450,"_1570":33570},[],"Eliminación de una CA",{"_7897":620,"_22053":571,"_18699":33572,"_5":22203,"_15048":33450,"_1570":33573},[],"**certificate.delete**",{"_7897":621,"_22053":571,"_18699":33575,"_5":22203,"_15048":33450,"_1570":33576},[],"Eliminación de un certificado",{"_7897":622,"_22053":571,"_18699":33578,"_5":22203,"_15048":33450,"_1570":33579},[],"**profile.create**",{"_7897":623,"_22053":571,"_18699":33581,"_5":22203,"_15048":33450,"_1570":33582},[],"Creación de perfil de emisión",{"_7897":624,"_22053":571,"_18699":33584,"_5":22203,"_15048":33450,"_1570":33585},[],"**profile.update**",{"_7897":625,"_22053":571,"_18699":33587,"_5":22203,"_15048":33450,"_1570":33588},[],"Actualización de perfil de emisión",{"_7897":626,"_22053":571,"_18699":33590,"_5":22203,"_15048":33450,"_1570":33591},[],"**profile.delete**",{"_7897":627,"_22053":571,"_18699":33593,"_5":22203,"_15048":33450,"_1570":33594},[],"Eliminación de perfil de emisión",{"_7897":628,"_22053":571,"_18699":33596,"_5":22203,"_15048":33450,"_1570":33597},[],"**dms.create**",{"_7897":629,"_22053":571,"_18699":33599,"_5":22203,"_15048":33450,"_1570":33600},[],"Creación de un DMS",{"_7897":630,"_22053":571,"_18699":33602,"_5":22203,"_15048":33450,"_1570":33603},[],"**dms.update**",{"_7897":631,"_22053":571,"_18699":33605,"_5":22203,"_15048":33450,"_1570":33606},[],"Actualización de un DMS",{"_7897":632,"_22053":571,"_18699":33608,"_5":22203,"_15048":33450,"_1570":33609},[],"**dms.delete**",{"_7897":633,"_22053":571,"_18699":33611,"_5":22203,"_15048":33450,"_1570":33612},[],"Eliminación de un DMS",{"_7897":634,"_22053":571,"_18699":33614,"_5":22203,"_15048":33450,"_1570":33615},[],"**dms.enroll**",{"_7897":635,"_22053":571,"_18699":33617,"_5":22203,"_15048":33450,"_1570":33618},[],"Inscripción (enroll) de dispositivo",{"_7897":636,"_22053":571,"_18699":33620,"_5":22203,"_15048":33450,"_1570":33621},[],"**dms.reenroll**",{"_7897":637,"_22053":571,"_18699":33623,"_5":22203,"_15048":33450,"_1570":33624},[],"Re-inscripción (reenroll) de dispositivo",{"_7897":638,"_22053":571,"_18699":33626,"_5":22203,"_15048":33450,"_1570":33627},[],"**dms.bind-device-id**",{"_7897":639,"_22053":571,"_18699":33629,"_5":22203,"_15048":33450,"_1570":33630},[],"Asociación de identidad a dispositivo",{"_7897":640,"_22053":571,"_18699":33632,"_5":22203,"_15048":33450,"_1570":33633},[],"**device.create**",{"_7897":641,"_22053":571,"_18699":33635,"_5":22203,"_15048":33450,"_1570":33636},[],"Creación de dispositivo",{"_7897":642,"_22053":571,"_18699":33638,"_5":22203,"_15048":33450,"_1570":33639},[],"**device.identity.update**",{"_7897":643,"_22053":571,"_18699":33641,"_5":22203,"_15048":33450,"_1570":33642},[],"Actualización de identidad del dispositivo",{"_7897":644,"_22053":571,"_18699":33644,"_5":22203,"_15048":33450,"_1570":33645},[],"**device.status.update**",{"_7897":645,"_22053":571,"_18699":33647,"_5":22203,"_15048":33450,"_1570":33648},[],"Cambio de estado del dispositivo",{"_7897":646,"_22053":571,"_18699":33650,"_5":22203,"_15048":33450,"_1570":33651},[],"**device.metadata.update**",{"_7897":647,"_22053":571,"_18699":33653,"_5":22203,"_15048":33450,"_1570":33654},[],"Actualización de metadatos del dispositivo",{"_7897":648,"_22053":571,"_18699":33656,"_5":22203,"_15048":33450,"_1570":33657},[],"**device.delete**",{"_7897":649,"_22053":571,"_18699":33659,"_5":22203,"_15048":33450,"_1570":33660},[],"Eliminación de un dispositivo",{"_7897":650,"_22053":571,"_18699":33662,"_5":22203,"_15048":33450,"_1570":33663},[],"**va.role.crl.create**",{"_7897":651,"_22053":571,"_18699":33665,"_5":22203,"_15048":33450,"_1570":33666},[],"Cálculo/creación de CRL",{"_7897":652,"_22053":571,"_18699":33668,"_5":22203,"_15048":33450,"_1570":33669},[],"**kms.create**",{"_7897":653,"_22053":571,"_18699":33671,"_5":22203,"_15048":33450,"_1570":33672},[],"Creación de clave en KMS",{"_7897":654,"_22053":571,"_18699":33674,"_5":22203,"_15048":33450,"_1570":33675},[],"**kms.import**",{"_7897":655,"_22053":571,"_18699":33677,"_5":22203,"_15048":33450,"_1570":33678},[],"Importación de una clave KMS",{"_7897":656,"_22053":571,"_18699":33680,"_5":22203,"_15048":33450,"_1570":33681},[],"**kms.update.metadata**",{"_7897":657,"_22053":571,"_18699":33683,"_5":22203,"_15048":33450,"_1570":33684},[],"Actualización de metadatos de clave KMS",{"_7897":658,"_22053":571,"_18699":33686,"_5":22203,"_15048":33450,"_1570":33687},[],"**kms.update.aliases**",{"_7897":659,"_22053":571,"_18699":33689,"_5":22203,"_15048":33450,"_1570":33690},[],"Actualización de alias de clave KMS",{"_7897":660,"_22053":571,"_18699":33692,"_5":22203,"_15048":33450,"_1570":33693},[],"**kms.update.name**",{"_7897":661,"_22053":571,"_18699":33695,"_5":22203,"_15048":33450,"_1570":33696},[],"Cambio de nombre de una clave KMS",{"_7897":662,"_22053":571,"_18699":33698,"_5":22203,"_15048":33450,"_1570":33699},[],"**kms.update.tags**",{"_7897":663,"_22053":571,"_18699":33701,"_5":22203,"_15048":33450,"_1570":33702},[],"Actualización de etiquetas (tags) de clave KMS",{"_7897":664,"_22053":571,"_18699":33704,"_5":22203,"_15048":33450,"_1570":33705},[],"**kms.delete**",{"_7897":665,"_22053":571,"_18699":33707,"_5":22203,"_15048":33450,"_1570":33708},[],"Eliminación de una clave KMS",{"_7897":666,"_22053":571,"_18699":33710,"_5":22203,"_15048":33450,"_1570":33711},[],"**kms.sign.message**",{"_7897":667,"_22053":571,"_18699":33713,"_5":22203,"_15048":33450,"_1570":33714},[],"Firma de un mensaje con clave KMS",{"_7897":668,"_22053":571,"_18699":33716,"_5":22203,"_15048":33450,"_1570":33717},[],"**kms.verify.signature**",{"_7897":669,"_22053":571,"_18699":33719,"_5":22203,"_15048":33450,"_1570":33720},[],"Verificación de firma con clave KMS",{"_7897":670,"_22053":670,"_5":22198,"_1570":33722,"_22211":33723,"_18699":33724,"_15048":670},"[CA] Gestión de Entidades de Confianza",[31714,32813,32822],[],{"_7897":671,"_22053":670,"_18699":33726,"_5":22203,"_15048":670,"_1570":33727},[],"Creación y gestión de Autoridades de Certificación en Lamassu IoT",{"_7897":672,"_22053":670,"_5":22208,"_18699":33729,"_15048":33730,"_1570":33731},[],"/docs/pr-preview/pr-22/manual/servicios-core/cas#gestión-de-entidades-de-confianza","Gestión de entidades de confianza",{"_7897":673,"_22053":670,"_5":22208,"_18699":33733,"_15048":33734,"_1570":33735},[],"/docs/pr-preview/pr-22/manual/servicios-core/cas#creación-de-entidades-de-certificación","Creación de entidades de certificación",{"_7897":674,"_22053":670,"_5":22208,"_18699":33737,"_15048":33738,"_1570":33739},[],"/docs/pr-preview/pr-22/manual/servicios-core/cas#creación-de-una-nueva-autoridad-de-certificación","Creación de una nueva autoridad de certificación",{"_7897":675,"_22053":670,"_5":22208,"_18699":33741,"_15048":33742,"_1570":33743},[],"/docs/pr-preview/pr-22/manual/servicios-core/cas#creación-de-cas-a-partir-de-claves-del-kms","Creación de CAs a partir de claves del KMS",{"_7897":676,"_22053":670,"_5":22208,"_18699":33745,"_15048":33746,"_1570":33747},[],"/docs/pr-preview/pr-22/manual/servicios-core/cas#importación-de-autoridades-de-certificación","Importación de autoridades de certificación",{"_7897":677,"_22053":670,"_5":22208,"_18699":33749,"_15048":33750,"_1570":33751},[],"/docs/pr-preview/pr-22/manual/servicios-core/cas#operando-con-entidades-de-confianza","Operando con entidades de confianza",{"_7897":678,"_22053":670,"_5":22208,"_18699":33753,"_15048":33754,"_1570":33755},[],"/docs/pr-preview/pr-22/manual/servicios-core/cas#visualización-de-autoridades-de-certificación","Visualización de autoridades de certificación",{"_7897":679,"_22053":670,"_5":22208,"_18699":33757,"_15048":33758,"_1570":33759},[],"/docs/pr-preview/pr-22/manual/servicios-core/cas#emisión-de-certificados","Emisión de certificados",{"_7897":680,"_22053":670,"_5":22208,"_18699":33761,"_15048":33762,"_1570":33763},[],"/docs/pr-preview/pr-22/manual/servicios-core/cas#revocación-de-cas-y-certificados","Revocación de CAs y certificados",{"_7897":681,"_22053":670,"_18699":33765,"_5":22203,"_15048":33734,"_1570":33766},[],"Para acceder a la creación de nuevas entidades certificación se debe acceder la opción de entidades de certificación del menú lateral y luego seleccionar la acción de creación de nueva CA.",{"_7897":682,"_22053":670,"_18699":33768,"_5":22203,"_15048":33734,"_1570":33769},[],"Actualmente hay disponibles 3 acciones:",{"_7897":683,"_22053":670,"_18699":33771,"_5":22203,"_15048":33734,"_1570":33772},[],"**Creación de una nueva autoridad de certificación**, esta acción generará un nuevo par de claves para soportar la nueva autoridad de certificación.",{"_7897":684,"_22053":670,"_18699":33774,"_5":22203,"_15048":33734,"_1570":33775},[],"**Importar una nueva autoridad de certificación generada externamente**, permite importar en Lamassu una autoridad de certificación, cuyo par de claves ha sido generado de manera externa.",{"_7897":685,"_22053":670,"_18699":33777,"_5":22203,"_15048":33734,"_1570":33778},[],"**Importar un certificado de autoridad de certificación sin clave privada**, en este caso se importa la CA para poder usarla en procesos de validación y no como fuente de nuevos certificados gestionados por Lamassu.",{"_7897":686,"_22053":670,"_18699":33780,"_5":22203,"_15048":33738,"_1570":33781},[],"La creación de una Autoridad de Certificación (CA) es un proceso fundamental en el establecimiento de una infraestructura de clave pública (PKI). Lamassu IoT permite provisionar tanto autoridades raíz como intermedias mediante la generación automática de pares de claves criptográficas que son gestionados de forma segura por el sistema integrado de gestión de claves.",{"_7897":687,"_22053":670,"_18699":33783,"_5":22203,"_15048":33738,"_1570":33784},[],"En el formulario de creación se definen los siguientes bloques de configuración.",{"_7897":688,"_22053":670,"_18699":33786,"_5":22203,"_15048":33738,"_1570":33787},[],"**Motor criptográfico**",{"_7897":689,"_22053":670,"_18699":33789,"_5":22203,"_15048":33738,"_1570":33790},[],"**Selector:** Desplegable con motores disponibles, ofrece los configurados en el sistema.",{"_7897":690,"_22053":670,"_18699":33792,"_5":22203,"_15048":33738,"_1570":33793},[],"**Ejemplo mostrado:** go1.24.3",{"_7897":691,"_22053":670,"_18699":33795,"_5":22203,"_15048":33738,"_1570":33796},[],"**Función:** Permite seleccionar el motor criptográfico deseado",{"_7897":692,"_22053":670,"_18699":33798,"_5":22203,"_15048":33738,"_1570":33799},[],"**Parámetros de clave**",{"_7897":693,"_22053":670,"_18699":33801,"_5":22203,"_15048":33738,"_1570":33802},[],"**Key Type:** RSA / EC (Elliptic Curve)",{"_7897":694,"_22053":670,"_18699":33804,"_5":22203,"_15048":33738,"_1570":33805},[],"**Key Size:**",{"_7897":695,"_22053":670,"_18699":33807,"_5":22203,"_15048":33738,"_1570":33808},[],"RSA: 1024, 2048, 3072, 4096 bits",{"_7897":696,"_22053":670,"_18699":33810,"_5":22203,"_15048":33738,"_1570":33811},[],"EC: P-256, P-384, P-521",{"_7897":697,"_22053":670,"_18699":33813,"_5":22203,"_15048":33738,"_1570":33814},[],"**Recomendado:** EC P-384",{"_7897":698,"_22053":670,"_18699":33816,"_5":22203,"_15048":33738,"_1570":33817},[],"**Perfil de emisión del certificado de la CA**",{"_7897":699,"_22053":670,"_18699":33819,"_5":22203,"_15048":33738,"_1570":33820},[],"Aquí se puede seleccionar un perfil existente o definir uno en línea para la operación. Ese perfil permite especificar la duración de la CA que se está creando y los `Key Usage` y `Extended Key Usage` del certificado de soporte.",{"_7897":700,"_22053":670,"_18699":33822,"_5":22203,"_15048":33738,"_1570":33823},[],"Si no se proporciona ningún perfil se aplicará uno por defecto con los usos de clave básicos.",{"_7897":701,"_22053":670,"_18699":33825,"_5":22203,"_15048":33738,"_1570":33826},[],"**Configuración de la CA**",{"_7897":702,"_22053":670,"_18699":33828,"_5":22203,"_15048":33738,"_1570":33829},[],"**Tipo de CA**",{"_7897":703,"_22053":670,"_18699":33831,"_5":22203,"_15048":33738,"_1570":33832},[],"**Root CA:** Autoridad raíz autofirmada",{"_7897":704,"_22053":670,"_18699":33834,"_5":22203,"_15048":33738,"_1570":33835},[],"**Intermediate CA:** Autoridad subordinada",{"_7897":705,"_22053":670,"_18699":33837,"_5":22203,"_15048":33738,"_1570":33838},[],"**Emisor**",{"_7897":706,"_22053":670,"_18699":33840,"_5":22203,"_15048":33738,"_1570":33841},[],"**Root CA:** Self-signed (auto-firmada)",{"_7897":707,"_22053":670,"_18699":33843,"_5":22203,"_15048":33738,"_1570":33844},[],"**Intermediate CA:** Selector desplegable de CA superior disponible",{"_7897":708,"_22053":670,"_18699":33846,"_5":22203,"_15048":33738,"_1570":33847},[],"Permite seleccionar la CA padre que firmará la nueva CA intermedia",{"_7897":709,"_22053":670,"_18699":33849,"_5":22203,"_15048":33738,"_1570":33850},[],"**Identificación**",{"_7897":710,"_22053":670,"_18699":33852,"_5":22203,"_15048":33738,"_1570":33853},[],"**CA ID:** Generado automáticamente (formato UUID),no puede ser modificado. Estos IDs los gestiona el sistema.",{"_7897":711,"_22053":670,"_18699":33855,"_5":22203,"_15048":33738,"_1570":33856},[],"Ejemplo: 8f7c170-c84e-4c08-904f-8d3247c77fc2",{"_7897":712,"_22053":670,"_18699":33858,"_5":22203,"_15048":33738,"_1570":33859},[],"**CA Name:** Nombre descriptivo (obligatorio)",{"_7897":713,"_22053":670,"_18699":33861,"_5":22203,"_15048":33738,"_1570":33862},[],"Ejemplo: Lamassu IoT Secure Services CA",{"_7897":714,"_22053":670,"_18699":33864,"_5":22203,"_15048":33738,"_1570":33865},[],"**Subject Distinguished Name (DN)**",{"_7897":715,"_22053":670,"_18699":33867,"_5":22203,"_15048":33738,"_1570":33868},[],"Campos opcionales:",{"_7897":716,"_22053":670,"_18699":33870,"_5":22203,"_15048":33738,"_1570":33871},[],"**Country (C):** Código país ISO 3166-1 (2 letras)",{"_7897":717,"_22053":670,"_18699":33873,"_5":22203,"_15048":33738,"_1570":33874},[],"Ejemplo: US, ES, DE",{"_7897":718,"_22053":670,"_18699":33876,"_5":22203,"_15048":33738,"_1570":33877},[],"**State/Province (ST):** Estado o provincia",{"_7897":719,"_22053":670,"_18699":33879,"_5":22203,"_15048":33738,"_1570":33880},[],"Ejemplo: California, Madrid",{"_7897":720,"_22053":670,"_18699":33882,"_5":22203,"_15048":33738,"_1570":33883},[],"**Locality (L):** Ciudad o localidad",{"_7897":721,"_22053":670,"_18699":33885,"_5":22203,"_15048":33738,"_1570":33886},[],"Ejemplo: San Francisco, Arrasate",{"_7897":722,"_22053":670,"_18699":33888,"_5":22203,"_15048":33738,"_1570":33889},[],"**Organization (O):** Nombre de la organización",{"_7897":723,"_22053":670,"_18699":33891,"_5":22203,"_15048":33738,"_1570":33892},[],"Ejemplo: Lamassu IoT Corp",{"_7897":724,"_22053":670,"_18699":33894,"_5":22203,"_15048":33738,"_1570":33895},[],"**Organizational Unit (OU):** Unidad organizacional",{"_7897":725,"_22053":670,"_18699":33897,"_5":22203,"_15048":33738,"_1570":33898},[],"Ejemplo: Secure Devices Division",{"_7897":726,"_22053":670,"_18699":33900,"_5":22203,"_15048":33738,"_1570":33901},[],"El \"Certification Authority Name\" configurado se utilizará como Common Name (CN) del subject del certificado de la CA.",{"_7897":727,"_22053":670,"_18699":33903,"_5":22203,"_15048":33738,"_1570":33904},[],"**Configuración de expiración**\nLa configuración de expiración define la validez temporal tanto del certificado de la propia CA como de los certificados que ésta emitirá por defecto. Si se ha seleccionado un perfil se dará prioridad al dato proporcionado en el perfil.",{"_7897":728,"_22053":670,"_18699":33906,"_5":22203,"_15048":33738,"_1570":33907},[],"Para el certificado de la CA (`CA Certificate Expiration`):",{"_7897":729,"_22053":670,"_18699":33909,"_5":22203,"_15048":33738,"_1570":33910},[],"**Función:** Establece la duración de validez del certificado de la Autoridad de Certificación",{"_7897":730,"_22053":670,"_18699":33912,"_5":22203,"_15048":33738,"_1570":33913},[],"**Implicación:** Una vez expirado, la CA no podrá emitir nuevos certificados válidos",{"_7897":731,"_22053":670,"_18699":33915,"_5":22203,"_15048":33738,"_1570":33916},[],"**Duración:** Configurable según necesidades organizacionales",{"_7897":732,"_22053":670,"_18699":33918,"_5":22203,"_15048":33738,"_1570":33919},[],"**Valor por defecto:** 10 años (10y)",{"_7897":733,"_22053":670,"_18699":33921,"_5":22203,"_15048":33738,"_1570":33922},[],"**Consideración:** Debe ser mayor que la duración de los certificados que emitirá",{"_7897":734,"_22053":670,"_18699":33924,"_5":22203,"_15048":33738,"_1570":33925},[],"La expiración de la CA se puede definir como un expresión de duración, fijar una fecha fija, o marcarla como indefinida, lo que en términos prácticos permitirá la emisión de una CA sin caducidad.",{"_7897":735,"_22053":670,"_18699":33927,"_5":22203,"_15048":33738,"_1570":33928},[],"En el caso de expresar una duración, las unidades permitidas son: y (años), w (semanas), d (días), h (horas), m (minutos) y s (segundos), pudiendo componer expresiones como la siguiente: *5y 8w 4d 2h 1m 2s*",{"_7897":736,"_22053":670,"_18699":33930,"_5":22203,"_15048":33738,"_1570":33931},[],"En caso de elegir la opción de fecha específica, se ofrecerá un calendario para seleccionar la fecha de caducidad.",{"_7897":737,"_22053":670,"_18699":33933,"_5":22203,"_15048":33738,"_1570":33934},[],"Para el caso de indefinido, se fijará la fecha de expiración máxima permitida.",{"_7897":738,"_22053":670,"_18699":33936,"_5":22203,"_15048":33738,"_1570":33937},[],"Para la expiración por defecto de certificados finales (`Default End-Entity Certificate Issuance Expiration`):",{"_7897":739,"_22053":670,"_18699":33939,"_5":22203,"_15048":33738,"_1570":33940},[],"**Función:** Define la duración predeterminada para certificados emitidos por esta CA",{"_7897":740,"_22053":670,"_18699":33942,"_5":22203,"_15048":33738,"_1570":33943},[],"**Aplicación:** Se aplica automáticamente a nuevos certificados si no se especifica otra duración",{"_7897":741,"_22053":670,"_18699":33945,"_5":22203,"_15048":33738,"_1570":33946},[],"**Flexibilidad:** Puede ser modificada individualmente al emitir cada certificado",{"_7897":742,"_22053":670,"_18699":33948,"_5":22203,"_15048":33738,"_1570":33949},[],"**Valor por defecto:** 1 año (1y)",{"_7897":743,"_22053":670,"_18699":33951,"_5":22203,"_15048":33738,"_1570":33952},[],"Se expresa en los mismos términos que la caducidad de la CA.",{"_7897":744,"_22053":670,"_18699":33954,"_5":22203,"_15048":33738,"_1570":33955},[],"Una vez creada la CA debe ser visible en el listado de CAs del sistema.",{"_7897":745,"_22053":670,"_18699":33957,"_5":22203,"_15048":33742,"_1570":33958},[],"Lamassu IoT permite la creación de CAs a partir de claves previamente generadas o importadas en el servicio KMS. Una vez seleccionada la opción &#x2A;*Create New CA (Existing Key)** se muestra el formulario de creación de CAs con los siguientes elementos diferenciales respecto a la creación de la CA a partir de un nuevo par de claves descrito en el punto anterior.",{"_7897":746,"_22053":670,"_18699":33960,"_5":22203,"_15048":33742,"_1570":33961},[],"En este caso, primero se solicita la selección de la clave de soporte para esta nueva CA.",{"_7897":747,"_22053":670,"_18699":33963,"_5":22203,"_15048":33742,"_1570":33964},[],"Se abre un popup que permite al usuario seleccionar la clave deseada de entre las disponibles en el KMS. Una vez seleccionada la clave, el proceso continúa como se describe en el punto anterior.",{"_7897":748,"_22053":670,"_18699":33966,"_5":22203,"_15048":33746,"_1570":33967},[],"La importación de entidades de certificación permite importar en el sistema una CA que ha sido generada de manera externa. Para ello se sigue el siguiente proceso:",{"_7897":749,"_22053":670,"_18699":33969,"_5":22203,"_15048":33746,"_1570":33970},[],"Se debe seleccionar el motor que gestionará el par de claves importado.",{"_7897":750,"_22053":670,"_18699":33972,"_5":22203,"_15048":33746,"_1570":33790},[],{"_7897":751,"_22053":670,"_18699":33974,"_5":22203,"_15048":33746,"_1570":33793},[],{"_7897":752,"_22053":670,"_18699":33976,"_5":22203,"_15048":33746,"_1570":33796},[],{"_7897":753,"_22053":670,"_18699":33978,"_5":22203,"_15048":33746,"_1570":33979},[],"También se define la expiración por defecto de certificados finales (`Default End-Entity Certificate Issuance Expiration`):",{"_7897":754,"_22053":670,"_18699":33981,"_5":22203,"_15048":33746,"_1570":33940},[],{"_7897":755,"_22053":670,"_18699":33983,"_5":22203,"_15048":33746,"_1570":33943},[],{"_7897":756,"_22053":670,"_18699":33985,"_5":22203,"_15048":33746,"_1570":33946},[],{"_7897":757,"_22053":670,"_18699":33987,"_5":22203,"_15048":33746,"_1570":33949},[],{"_7897":758,"_22053":670,"_18699":33989,"_5":22203,"_15048":33746,"_1570":33952},[],{"_7897":759,"_22053":670,"_18699":33991,"_5":22203,"_15048":33746,"_1570":33992},[],"Se debe proporcionar de manera obligatoria:",{"_7897":760,"_22053":670,"_18699":33994,"_5":22203,"_15048":33746,"_1570":33995},[],"Certificado de la CA en formato PEM. Se comprueba que el certificado importado corresponda con el de una CA.",{"_7897":761,"_22053":670,"_18699":33997,"_5":22203,"_15048":33746,"_1570":33998},[],"Clave privada de la CA en formato PEM",{"_7897":762,"_22053":670,"_18699":34000,"_5":22203,"_15048":33746,"_1570":34001},[],"De manera opcional se proporcionarán en formato PEM la cadena de certificados de la cadena de validación en caso de importar una CA subordinada.",{"_7897":763,"_22053":670,"_18699":34003,"_5":22203,"_15048":33754,"_1570":34004},[],"Accediendo a la sección de autoridades de certificación se mostrará el listado de CAs registradas en el sistema. El listado permitirá el filtro mediante el nombre de la CA, el estado o el tipo de CA.",{"_7897":764,"_22053":670,"_18699":34006,"_5":22203,"_15048":33754,"_1570":34007},[],"La acción de ver detalles da acceso a los detalles de la CA y a diferentes opciones de gestión.",{"_7897":765,"_22053":670,"_18699":34009,"_5":22203,"_15048":33754,"_1570":34010},[],"En los detalles se muestra el resumen del estado de los certificados emitidos por la CA: certificados activos, expirados y revocados.",{"_7897":766,"_22053":670,"_18699":34012,"_5":22203,"_15048":33754,"_1570":34013},[],"Se ofrecen dos acciones:",{"_7897":767,"_22053":670,"_18699":34015,"_5":22203,"_15048":33754,"_1570":34016},[],"la descarga de la CRL vinculada a la CA que permitirá a otros sistemas realizar comprobaciones de vigencia de los certificados emitidos por la CA de manera desconectada.",{"_7897":768,"_22053":670,"_18699":34018,"_5":22203,"_15048":33754,"_1570":34019},[],"la acción de revocación de la CA",{"_7897":769,"_22053":670,"_18699":34021,"_5":22203,"_15048":33754,"_1570":34022},[],"Se muestra información detallada, el certificado en formato PEM y se da acceso a la relación de certificados emitidos por la CA a través de la pestaña “Issued Certificates”",{"_7897":770,"_22053":670,"_18699":34024,"_5":22203,"_15048":33758,"_1570":34025},[],"La acción de emisión de certificados se puede realizar desde la pestaña “Issued Certificates” de los detalles de la CA, mediante la acción “Issue New”.",{"_7897":771,"_22053":670,"_18699":34027,"_5":22203,"_15048":33758,"_1570":34028},[],"La funcionalidad de emisión es accesible también desde el listado de CAs mediante la acción correspondiente de emisión.",{"_7897":772,"_22053":670,"_18699":34030,"_5":22203,"_15048":33758,"_1570":34031},[],"Y desde la funcionalidad  listado completo de certificados emitidos por Lamassu mediante la acción “Issue Certificate”",{"_7897":773,"_22053":670,"_18699":34033,"_5":22203,"_15048":33758,"_1570":34034},[],"En este caso se solicitará la selección de una CA antes de acceder al formulario de emisión.",{"_7897":774,"_22053":670,"_18699":34036,"_5":22203,"_15048":33758,"_1570":34037},[],"El formulario de emisión de certificados ofrece 2 opciones para la emisión:",{"_7897":775,"_22053":670,"_18699":34039,"_5":22203,"_15048":33758,"_1570":34040},[],"Emisión a partir de una clave privada y el CSR generado en el browser",{"_7897":776,"_22053":670,"_18699":34042,"_5":22203,"_15048":33758,"_1570":34043},[],"Emisión a partir de un CSR generado de manera externa",{"_7897":777,"_22053":670,"_18699":34045,"_5":22203,"_15048":33758,"_1570":34046},[],"**Emisión a partir de una clave privada y el CSR generados en el browser**",{"_7897":778,"_22053":670,"_18699":34048,"_5":22203,"_15048":33758,"_1570":34049},[],"El usuario proporciona la información requerida para la creación del CSR, la consola genera una clave In Place y genera el CSR correspondiente mediante el cual se solicita la emisión del certificado a la CA.",{"_7897":779,"_22053":670,"_18699":34051,"_5":22203,"_15048":33758,"_1570":34052},[],"**Método de emisión:** Seleccionar  \"Generate Key & CSR in Browser\" para la generación del par de claves y la solicitud de certificado (CSR) directamente en el navegador",{"_7897":780,"_22053":670,"_18699":34054,"_5":22203,"_15048":33758,"_1570":34055},[],"**Certificate Subject (Sujeto del certificado)**",{"_7897":781,"_22053":670,"_18699":34057,"_5":22203,"_15048":33758,"_1570":34058},[],"**Common Name (CN)**",{"_7897":782,"_22053":670,"_18699":34060,"_5":22203,"_15048":33758,"_1570":34061},[],"**Campo:** Obligatorio",{"_7897":783,"_22053":670,"_18699":34063,"_5":22203,"_15048":33758,"_1570":34064},[],"**Función:** Identifica de forma única al titular del certificado",{"_7897":784,"_22053":670,"_18699":34066,"_5":22203,"_15048":33758,"_1570":34067},[],"**Ejemplos:**",{"_7897":785,"_22053":670,"_18699":34069,"_5":22203,"_15048":33758,"_1570":34070},[],"Para dispositivos: device001.company.com",{"_7897":786,"_22053":670,"_18699":34072,"_5":22203,"_15048":33758,"_1570":34073},[],"Para usuarios: john.doe\\@company.com",{"_7897":787,"_22053":670,"_18699":34075,"_5":22203,"_15048":33758,"_1570":34076},[],"Para servicios: api.service.company.com",{"_7897":788,"_22053":670,"_18699":34078,"_5":22203,"_15048":33758,"_1570":34079},[],"**Campos Organizacionales**",{"_7897":789,"_22053":670,"_18699":34081,"_5":22203,"_15048":33758,"_1570":34082},[],"**Organizational Unit (OU):** Unidad organizacional del titular",{"_7897":790,"_22053":670,"_18699":34084,"_5":22203,"_15048":33758,"_1570":34085},[],"Ejemplo: IT Department, Manufacturing",{"_7897":791,"_22053":670,"_18699":34087,"_5":22203,"_15048":33758,"_1570":33889},[],{"_7897":792,"_22053":670,"_18699":34089,"_5":22203,"_15048":33758,"_1570":34090},[],"Ejemplo: LamassuIoT Corp, Acme Industries",{"_7897":793,"_22053":670,"_18699":34092,"_5":22203,"_15048":33758,"_1570":34093},[],"**Información Geográfica**",{"_7897":794,"_22053":670,"_18699":34095,"_5":22203,"_15048":33758,"_1570":34096},[],"**Locality (L):** Ciudad o localidad del titular",{"_7897":795,"_22053":670,"_18699":34098,"_5":22203,"_15048":33758,"_1570":33877},[],{"_7897":796,"_22053":670,"_18699":34100,"_5":22203,"_15048":33758,"_1570":34101},[],"**Country (C):** Código de país ISO 3166-1 (2 letras)",{"_7897":797,"_22053":670,"_18699":34103,"_5":22203,"_15048":33758,"_1570":34104},[],"Valor por defecto mostrado: US",{"_7897":798,"_22053":670,"_18699":34106,"_5":22203,"_15048":33758,"_1570":34107},[],"**Subject Alternative Names (SANs)**\nLos SANs proporcionan identificadores alternativos para el certificado, permitiendo que un mismo certificado sea válido para múltiples nombres o direcciones.",{"_7897":799,"_22053":670,"_18699":34109,"_5":22203,"_15048":33758,"_1570":34110},[],"**Tipos de SAN Disponibles**",{"_7897":800,"_22053":670,"_18699":34112,"_5":22203,"_15048":33758,"_1570":34113},[],"**DNS:** Nombres de dominio",{"_7897":801,"_22053":670,"_18699":34115,"_5":22203,"_15048":33758,"_1570":34116},[],"Ejemplo: example.com, \\*.example.com",{"_7897":802,"_22053":670,"_18699":34118,"_5":22203,"_15048":33758,"_1570":34119},[],"**IP Address:** Direcciones IP",{"_7897":803,"_22053":670,"_18699":34121,"_5":22203,"_15048":33758,"_1570":34122},[],"**Email:** Direcciones de correo electrónico",{"_7897":804,"_22053":670,"_18699":34124,"_5":22203,"_15048":33758,"_1570":34125},[],"**URI:** Identificadores de recursos uniformes",{"_7897":805,"_22053":670,"_18699":34127,"_5":22203,"_15048":33758,"_1570":34128},[],"Es posible añadir múltiples SAN de cada tipo, se selecciona el tipo, añadiendo el valor y pulsando la acción “Add”.",{"_7897":806,"_22053":670,"_18699":34130,"_5":22203,"_15048":33758,"_1570":34131},[],"**Key Generation Details (Detalles de generación de claves)**\nSe debe especificar el tipo de clave a ser generada para la solicitud del certificado.",{"_7897":807,"_22053":670,"_18699":34133,"_5":22203,"_15048":33758,"_1570":34134},[],"**Algorithm (Algoritmo)**",{"_7897":808,"_22053":670,"_18699":34136,"_5":22203,"_15048":33758,"_1570":34137},[],"**ECDSA:** Algoritmo de curva elíptica, se debe especificar la curva a utilizar",{"_7897":809,"_22053":670,"_18699":34139,"_5":22203,"_15048":33758,"_1570":34140},[],"**RSA:** Algoritmo RSA tradicional, se debe indicar el tamaño de clave",{"_7897":810,"_22053":670,"_18699":34142,"_5":22203,"_15048":33758,"_1570":34143},[],"**Certificate Configuration (Configuración del certificado)**",{"_7897":811,"_22053":670,"_18699":34145,"_5":22203,"_15048":33758,"_1570":34146},[],"**Validity Duration (Duración de validez)**",{"_7897":812,"_22053":670,"_18699":34148,"_5":22203,"_15048":33758,"_1570":34149},[],"Indica la fecha de expiración del certificado a emitir como una expresión de duración",{"_7897":813,"_22053":670,"_18699":34151,"_5":22203,"_15048":33758,"_1570":34152},[],"**Campo:** Configurable según necesidades",{"_7897":814,"_22053":670,"_18699":34154,"_5":22203,"_15048":33758,"_1570":33949},[],{"_7897":815,"_22053":670,"_18699":34156,"_5":22203,"_15048":33758,"_1570":34157},[],"**Unidades válidas:** y (años), w (semanas), d (días), h (horas), m (minutos), s (segundos)",{"_7897":816,"_22053":670,"_18699":34159,"_5":22203,"_15048":33758,"_1570":34160},[],"**Consideración:** No puede exceder la validez de la CA emisora",{"_7897":817,"_22053":670,"_18699":34162,"_5":22203,"_15048":33758,"_1570":34163},[],"**Key Usage (Uso de claves)**\nDefine los propósitos criptográficos para los que puede utilizarse la clave privada del certificado.",{"_7897":818,"_22053":670,"_18699":34165,"_5":22203,"_15048":33758,"_1570":34166},[],"**Usos Básicos**",{"_7897":819,"_22053":670,"_18699":34168,"_5":22203,"_15048":33758,"_1570":34169},[],"**Digital Signature:** ✓ (marcado por defecto) - Firmas digitales",{"_7897":820,"_22053":670,"_18699":34171,"_5":22203,"_15048":33758,"_1570":34172},[],"**Content Commitment (Non-Repudiation):** No repudio",{"_7897":821,"_22053":670,"_18699":34174,"_5":22203,"_15048":33758,"_1570":34175},[],"**Key Encipherment:** Cifrado de claves",{"_7897":822,"_22053":670,"_18699":34177,"_5":22203,"_15048":33758,"_1570":34178},[],"**Data Encipherment:** Cifrado de datos",{"_7897":823,"_22053":670,"_18699":34180,"_5":22203,"_15048":33758,"_1570":34181},[],"**Key Agreement:** Acuerdo de claves",{"_7897":824,"_22053":670,"_18699":34183,"_5":22203,"_15048":33758,"_1570":34184},[],"**Certificate Signing:** Firma de certificados",{"_7897":825,"_22053":670,"_18699":34186,"_5":22203,"_15048":33758,"_1570":34187},[],"**CRL Signing:** Firma de listas de revocación",{"_7897":826,"_22053":670,"_18699":34189,"_5":22203,"_15048":33758,"_1570":34190},[],"**Encipher Only:** Solo cifrado",{"_7897":827,"_22053":670,"_18699":34192,"_5":22203,"_15048":33758,"_1570":34193},[],"**Decipher Only:** Solo descifrado",{"_7897":828,"_22053":670,"_18699":34195,"_5":22203,"_15048":33758,"_1570":34196},[],"**Uso Extendido de Claves**",{"_7897":829,"_22053":670,"_18699":34198,"_5":22203,"_15048":33758,"_1570":34199},[],"Especifica aplicaciones específicas para las que está autorizado el certificado.",{"_7897":830,"_22053":670,"_18699":34201,"_5":22203,"_15048":33758,"_1570":34202},[],"**Server Authentication:** ✓ (marcado por defecto) - Autenticación de servidor",{"_7897":831,"_22053":670,"_18699":34204,"_5":22203,"_15048":33758,"_1570":34205},[],"**Client Authentication:** ✓ (marcado por defecto) - Autenticación de cliente",{"_7897":832,"_22053":670,"_18699":34207,"_5":22203,"_15048":33758,"_1570":34208},[],"**Code Signing:** Firma de código",{"_7897":833,"_22053":670,"_18699":34210,"_5":22203,"_15048":33758,"_1570":34211},[],"**Email Protection:** Protección de correo electrónico",{"_7897":834,"_22053":670,"_18699":34213,"_5":22203,"_15048":33758,"_1570":34214},[],"**Time Stamping:** Sellado de tiempo",{"_7897":835,"_22053":670,"_18699":34216,"_5":22203,"_15048":33758,"_1570":34217},[],"**OCSP Signing:** Firma de respuestas OCSP",{"_7897":836,"_22053":670,"_18699":34219,"_5":22203,"_15048":33758,"_1570":34220},[],"Una vez completado los campos del formulario se solicita la emisión del certificado obteniendo el certificado y la clave privada generada en formato PEM. Esta clave privada no se almacena debe ser descargada y custodiada por el usuario ya que no se podrá volver a obtener.",{"_7897":837,"_22053":670,"_18699":34222,"_5":22203,"_15048":33758,"_1570":34223},[],"**Emisión a partir de un CSR generado de manera externa**",{"_7897":838,"_22053":670,"_18699":34225,"_5":22203,"_15048":33758,"_1570":34226},[],"Mediante esta opción se podrá realizar la emisión de certificados a partir de CSRs que hayan sido generados de manera externa. Para ello en el selector de modo del formulario de emisión es necesario seleccionar “Upload Existing CSR”.",{"_7897":839,"_22053":670,"_18699":34228,"_5":22203,"_15048":33758,"_1570":34229},[],"Se debe proporcionar un CSR válido que contenga los detalles del certificado a emitir, Subject Name, SANs,..",{"_7897":840,"_22053":670,"_18699":34231,"_5":22203,"_15048":33758,"_1570":34232},[],"Adicionalmente se proporcionará la duración deseada para el certificado y los usos permitidos. Con esta información se procederá a la emisión como se describe en el apartado anterior.",{"_7897":841,"_22053":670,"_18699":34234,"_5":22203,"_15048":33762,"_1570":34235},[],"La revocación de una Autoridad de Certificación (CA) es una acción crítica que invalida todos los certificados emitidos por esa CA, lo que puede causar interrupciones generalizadas en los dispositivos y servicios que confían en ella. Este proceso es irreversible y debe realizarse con extrema precaución.",{"_7897":842,"_22053":670,"_18699":34237,"_5":22203,"_15048":33762,"_1570":34238},[],"Para iniciar el proceso, entra en la sección de Autoridades de Certificación y localiza la CA deseada usando los filtros por **Nombre**, **Estado** y **Tipo**.",{"_7897":843,"_22053":670,"_18699":34240,"_5":22203,"_15048":33762,"_1570":34241},[],"Accede a la ficha de detalle de la CA. Allí se muestran la información general, los certificados PEM, los metadatos y los certificados emitidos, además del botón **Revoke CA**.",{"_7897":844,"_22053":670,"_18699":34243,"_5":22203,"_15048":33762,"_1570":34244},[],"Al pulsar **Revoke CA** se abre una ventana de confirmación con una advertencia sobre el impacto de la acción. En ese cuadro hay que seleccionar una **Razón de Revocación**. Las opciones incluyen:",{"_7897":845,"_22053":670,"_18699":34246,"_5":22203,"_15048":33762,"_1570":34247},[],"Unspecified (No especificado)",{"_7897":846,"_22053":670,"_18699":34249,"_5":22203,"_15048":33762,"_1570":34250},[],"KeyCompromise (Compromiso de clave)",{"_7897":847,"_22053":670,"_18699":34252,"_5":22203,"_15048":33762,"_1570":34253},[],"CACompromise (Compromiso de CA)",{"_7897":848,"_22053":670,"_18699":34255,"_5":22203,"_15048":33762,"_1570":34256},[],"AffiliationChanged (Afiliación cambiada)",{"_7897":849,"_22053":670,"_18699":34258,"_5":22203,"_15048":33762,"_1570":34259},[],"Superseded (Sustituida)",{"_7897":850,"_22053":670,"_18699":34261,"_5":22203,"_15048":33762,"_1570":34262},[],"CessationOfOperation (Cese de operación)",{"_7897":851,"_22053":670,"_18699":34264,"_5":22203,"_15048":33762,"_1570":34265},[],"CertificateHold (Retención de certificado)",{"_7897":852,"_22053":670,"_18699":34267,"_5":22203,"_15048":33762,"_1570":34268},[],"RemoveFromCRL (Eliminar de la CRL)",{"_7897":853,"_22053":670,"_18699":34270,"_5":22203,"_15048":33762,"_1570":34271},[],"Para evitar revocaciones accidentales, el sistema pedirá confirmar el nombre de la CA. En el campo de texto, escribe el **nombre exacto de la CA** que estás revocando. Una vez introducido correctamente, se habilitará el botón **Confirm Revocation**.",{"_7897":854,"_22053":670,"_18699":34273,"_5":22203,"_15048":33762,"_1570":34274},[],"Haz clic en el botón **Confirm Revocation**. Una vez completada la revocación, la CA cambiará su estado a **REVOKED** (Revocada) en la página de detalles, y ya no podrás emitir certificados nuevos con ella. En su lugar, verás la opción **Permanently Delete** (Eliminar Permanentemente).",{"_7897":855,"_22053":670,"_18699":34276,"_5":22203,"_15048":33762,"_1570":34277},[],"Consideraciones importantes:",{"_7897":856,"_22053":670,"_18699":34279,"_5":22203,"_15048":33762,"_1570":34280},[],"Impacto: La revocación de una CA es una acción irreversible que afectará a todos los dispositivos y servicios que dependen de ella. Asegúrate de comprender completamente las implicaciones antes de proceder.",{"_7897":857,"_22053":670,"_18699":34282,"_5":22203,"_15048":33762,"_1570":34283},[],"Eliminación Permanente: Después de la revocación, tendrás la opción de eliminar permanentemente la CA. Esta acción eliminará la CA del sistema de Lamassu IoT.",{"_7897":858,"_22053":858,"_5":22198,"_1570":34285,"_22211":34286,"_18699":34287,"_15048":858},"[Certs] Gestión de Certificados",[31714,32813,32822],[],{"_7897":859,"_22053":858,"_18699":34289,"_5":22203,"_15048":858,"_1570":34290},[],"Visualización y gestión de certificados emitidos",{"_7897":860,"_22053":858,"_5":22208,"_18699":34292,"_15048":34293,"_1570":34294},[],"/docs/pr-preview/pr-22/manual/servicios-core/certificates#gestión-de-certificados","Gestión de certificados",{"_7897":861,"_22053":858,"_5":22208,"_18699":34296,"_15048":34297,"_1570":34298},[],"/docs/pr-preview/pr-22/manual/servicios-core/certificates#revocación-de-certificados","Revocación de certificados",{"_7897":862,"_22053":858,"_18699":34300,"_5":22203,"_15048":34293,"_1570":34301},[],"Los certificados emitidos por Lamassu son accesibles, tanto desde la pestaña de Issued Certificates de los detalles de una CA como desde la opción “Certificates” del menú lateral.\\\nEn la pestaña de “Issued Certificates” se muestran los certificados emitidos por la CA seleccionada.",{"_7897":863,"_22053":858,"_18699":34303,"_5":22203,"_15048":34293,"_1570":34304},[],"Como desde la opción “Certificates” del menú lateral, donde se presentan todos los certificados emitidos por Lamassu independientemente de la CA que lo haya emitido. Esta pantalla incluye la opción de filtro de los certificados por CN, número de serie, estado y por la CA que lo emitió.",{"_7897":864,"_22053":858,"_18699":34306,"_5":22203,"_15048":34293,"_1570":34307},[],"Por cada certificado se incluye un conjunto de acciones vinculadas al certificado.\\\nAcceso a los detalles “View Details”, un mecanismo de inspección rápida (Quick Inspect) con la información básica del certificado, la opción de descarga en formato PEM y el acceso a las acciones de revocación.\\\nLa vista de detalle, proporciona información adicional y el acceso a las acciones de revocación.",{"_7897":865,"_22053":858,"_18699":34309,"_5":22203,"_15048":34297,"_1570":34310},[],"Ya sea desde las acciones del listado de certificados, como desde la vista de detalle se puede desencadenar la acción de revocación. Al pulsar sobre “Revoke Certificate” se abre una ventana modal en la que se debe seleccionar la razón de la revocación.",{"_7897":866,"_22053":858,"_18699":34312,"_5":22203,"_15048":34297,"_1570":34313},[],"Es importante destacar que la única razón reversible es “CertificateHold”, una revocación por cualquier otra  razón no podrá ser revertida. En caso de seleccionar “CertificateHold” se ofrecerá una acción de reactivación.",{"_7897":867,"_22053":867,"_5":22198,"_1570":34315,"_22211":34316,"_18699":34317,"_15048":867},"[Devices] Dispositivos e Identidades",[31714,32813,32822],[],{"_7897":868,"_22053":867,"_18699":34319,"_5":22203,"_15048":867,"_1570":34320},[],"Gestión de dispositivos IoT y sus identidades digitales",{"_7897":869,"_22053":867,"_5":22208,"_18699":34322,"_15048":34323,"_1570":34324},[],"/docs/pr-preview/pr-22/manual/servicios-core/devices#dispositivos-y-gestión-de-las-identidades--end-entities","Dispositivos y gestión de las identidades – End entities",{"_7897":870,"_22053":867,"_5":22208,"_18699":34326,"_15048":34327,"_1570":34328},[],"/docs/pr-preview/pr-22/manual/servicios-core/devices#visualización-de-dispositivos-gestionados","Visualización de Dispositivos Gestionados",{"_7897":871,"_22053":867,"_5":22208,"_18699":34330,"_15048":34331,"_1570":34332},[],"/docs/pr-preview/pr-22/manual/servicios-core/devices#detalle-del-dispositivo-historial-de-certificados","Detalle del Dispositivo: Historial de Certificados",{"_7897":872,"_22053":867,"_5":22208,"_18699":34334,"_15048":34335,"_1570":34336},[],"/docs/pr-preview/pr-22/manual/servicios-core/devices#detalle-del-dispositivo-línea-de-tiempo-de-eventos","Detalle del Dispositivo: Línea de tiempo de eventos",{"_7897":873,"_22053":867,"_5":22208,"_18699":34338,"_15048":34339,"_1570":34340},[],"/docs/pr-preview/pr-22/manual/servicios-core/devices#registro-de-nuevos-dispositivos","Registro de Nuevos Dispositivos",{"_7897":874,"_22053":867,"_5":22208,"_18699":34342,"_15048":34343,"_1570":34344},[],"/docs/pr-preview/pr-22/manual/servicios-core/devices#asignación-manual-de-identidad","Asignación Manual de Identidad",{"_7897":875,"_22053":867,"_5":22208,"_18699":34346,"_15048":34347,"_1570":34348},[],"/docs/pr-preview/pr-22/manual/servicios-core/devices#revocación-de-identidad","Revocación de Identidad",{"_7897":876,"_22053":867,"_5":22208,"_18699":34350,"_15048":34351,"_1570":34352},[],"/docs/pr-preview/pr-22/manual/servicios-core/devices#desactivación-de-dispositivos-decommissioning","Desactivación de Dispositivos (Decommissioning)",{"_7897":877,"_22053":867,"_18699":34354,"_5":22203,"_15048":34323,"_1570":34355},[],"La gestión del ciclo de vida de las identidades de los dispositivos es una funcionalidad central en Lamassu IoT. Esta sección del manual se enfoca en la visualización y administración de las identidades de los dispositivos ya enrolados, conocidos como *End Entities* (entidades finales). Permite una visión completa del estado, los certificados y los eventos históricos de cada dispositivo, facilitando su monitorización y control a lo largo de su ciclo de vida.",{"_7897":878,"_22053":867,"_18699":34357,"_5":22203,"_15048":34327,"_1570":34358},[],"La página de **Dispositivos** (Managed Devices) ofrece una vista general de todos los dispositivos registrados en el sistema. Puedes ver un resumen del estado de cada dispositivo, su grupo, la fecha de creación y las etiquetas asociadas. Esta visualización es clave para tener una perspectiva general del parque de dispositivos y su salud respecto al estado de su identidad.",{"_7897":879,"_22053":867,"_18699":34360,"_5":22203,"_15048":34327,"_1570":34361},[],"Para facilitar la búsqueda y el seguimiento, la interfaz permite filtrar los dispositivos por **Device ID** y por **Tags**. Además, se puede filtrar por los siguientes estados:",{"_7897":880,"_22053":867,"_18699":34363,"_5":22203,"_15048":34327,"_1570":34364},[],"**Active**: El dispositivo y su certificado están en uso y son válidos.",{"_7897":881,"_22053":867,"_18699":34366,"_5":22203,"_15048":34327,"_1570":34367},[],"**No Identity**: El dispositivo existe en el sistema, pero no tiene una identidad digital (certificado) asociada.",{"_7897":882,"_22053":867,"_18699":34369,"_5":22203,"_15048":34327,"_1570":34370},[],"**Renewal Pending**: El dispositivo se encuentra en la ventana de tiempo de renovación y su certificado expirará pronto.",{"_7897":883,"_22053":867,"_18699":34372,"_5":22203,"_15048":34327,"_1570":34373},[],"**Expiring Soon**: El certificado del dispositivo está a punto de caducar.",{"_7897":884,"_22053":867,"_18699":34375,"_5":22203,"_15048":34327,"_1570":34376},[],"**Expired**: El certificado del dispositivo ha caducado.",{"_7897":885,"_22053":867,"_18699":34378,"_5":22203,"_15048":34327,"_1570":34379},[],"**Revoked**: El certificado del dispositivo ha sido revocado.",{"_7897":886,"_22053":867,"_18699":34381,"_5":22203,"_15048":34327,"_1570":34382},[],"**Decommissioned**: El dispositivo ha sido dado de baja y ya no está en uso.",{"_7897":887,"_22053":867,"_18699":34384,"_5":22203,"_15048":34331,"_1570":34385},[],"Al seleccionar un dispositivo específico, se accede a su página de detalles. La pestaña de **Historial de Certificados** muestra un registro cronológico de todos los certificados X.509 que han sido asociados a la identidad de ese dispositivo. Aquí se pueden ver detalles como el número de serie, el estado del certificado (por ejemplo, activo, expirado o revocado), el nombre común, la CA emisora y los periodos de validez.",{"_7897":888,"_22053":867,"_18699":34387,"_5":22203,"_15048":34331,"_1570":34388},[],"Esta funcionalidad es fundamental para auditar y rastrear la historia de la identidad del dispositivo, lo que permite identificar si un certificado ha sido reemplazado o revocado en algún momento.",{"_7897":889,"_22053":867,"_18699":34390,"_5":22203,"_15048":34335,"_1570":34391},[],"La pestaña de **Línea de tiempo de eventos** (Device Event Timeline) proporciona un registro detallado y cronológico de los eventos más importantes relacionados con el dispositivo y su identidad. Estos eventos pueden incluir el aprovisionamiento inicial, la renovación de certificados o cambios de estado.",{"_7897":890,"_22053":867,"_18699":34393,"_5":22203,"_15048":34335,"_1570":34394},[],"Esta línea de tiempo es una herramienta poderosa para el análisis forense y la resolución de problemas, ya que permite ver la secuencia exacta de las acciones que han ocurrido en la vida del dispositivo.",{"_7897":891,"_22053":867,"_18699":34396,"_5":22203,"_15048":34339,"_1570":34397},[],"Además de la gestión de dispositivos ya enrolados, Lamassu IoT permite el registro manual de nuevos dispositivos. Esto es particularmente útil para el modo de registro por **Pre-registration**, donde la identidad del dispositivo debe existir en el sistema antes de que pueda solicitar un certificado.",{"_7897":892,"_22053":867,"_18699":34399,"_5":22203,"_15048":34339,"_1570":34400},[],"El proceso de registro de un nuevo dispositivo se realiza a través de un formulario que permite configurar los siguientes campos:",{"_7897":893,"_22053":867,"_18699":34402,"_5":22203,"_15048":34339,"_1570":34403},[],"**Device ID (GUID)**: Es el identificador único del dispositivo, normalmente un GUID (Globally Unique Identifier).",{"_7897":894,"_22053":867,"_18699":34405,"_5":22203,"_15048":34339,"_1570":34406},[],"**Registration Authority**: Se debe seleccionar la RA a la que se asociará el dispositivo, lo que definirá las políticas de *enrollment* y *re-enrollment* que se aplicarán.",{"_7897":895,"_22053":867,"_18699":34408,"_5":22203,"_15048":34339,"_1570":34409},[],"**Device Registration Profile**: En esta sección se pueden configurar aspectos visuales para facilitar la identificación del dispositivo.",{"_7897":896,"_22053":867,"_18699":34411,"_5":22203,"_15048":34339,"_1570":34412},[],"**Icon**: Permite seleccionar un icono que represente visualmente el tipo de dispositivo.",{"_7897":897,"_22053":867,"_18699":34414,"_5":22203,"_15048":34339,"_1570":34415},[],"**Tags**: Se pueden añadir etiquetas para agrupar y organizar el dispositivo con otros de características similares.",{"_7897":898,"_22053":867,"_18699":34417,"_5":22203,"_15048":34339,"_1570":34418},[],"Una vez registrado, el dispositivo aparecerá en el listado de dispositivos con el estado **No Identity** hasta que complete el proceso de *enrollment* y obtenga su primer certificado.",{"_7897":899,"_22053":867,"_18699":34420,"_5":22203,"_15048":34343,"_1570":34421},[],"La **Asignación manual de identidad** es una acción que solo está disponible para dispositivos en estado **No Identity**, es decir, que han sido registrados en el sistema pero aún no tienen un certificado asignado. Esta funcionalidad permite vincular un certificado ya existente o emitir uno nuevo de forma manual.",{"_7897":900,"_22053":867,"_18699":34423,"_5":22203,"_15048":34343,"_1570":34424},[],"El proceso se lleva a cabo desde la vista de detalles del dispositivo:",{"_7897":901,"_22053":867,"_18699":34426,"_5":22203,"_15048":34343,"_1570":34427},[],"**Iniciar la asignación**: Se hace clic en el botón **Assign Identity**. Esto abrirá una ventana emergente.",{"_7897":902,"_22053":867,"_18699":34429,"_5":22203,"_15048":34343,"_1570":34430},[],"**Vincular certificado existente**: La aplicación buscará certificados activos con un Common Name (CN) que coincida con el Device ID. Si se encuentra un certificado, se puede seleccionar y vincular al dispositivo.",{"_7897":903,"_22053":867,"_18699":34432,"_5":22203,"_15048":34343,"_1570":34433},[],"**Emitir un nuevo certificado**: Si no se encuentra un certificado existente, o si se desea emitir uno nuevo, se puede seleccionar la opción **Issue New Instead**. Esto te permite elegir la **Certification Authority** que emitirá el nuevo certificado para el dispositivo. Se muestran por defecto las CAs vinculadas a la RA que gestiona ell dispositivo.",{"_7897":904,"_22053":867,"_18699":34435,"_5":22203,"_15048":34343,"_1570":34436},[],"**Confirmar y asignar**: Una vez seleccionado el certificado (existente o nuevo), se confirma la asignación. El dispositivo pasará del estado **No Identity** al estado **Active** y el certificado aparecerá en su historial.",{"_7897":905,"_22053":867,"_18699":34438,"_5":22203,"_15048":34347,"_1570":34439},[],"La revocación de la identidad es un proceso crítico para la seguridad que permite invalidar un certificado antes de su fecha de caducidad. Esta acción es irreversible. En Lamassu IoT, la revocación se realiza desde la sección de detalle del dispositivo, específicamente desde la línea de tiempo de eventos.",{"_7897":906,"_22053":867,"_18699":34441,"_5":22203,"_15048":34347,"_1570":34442},[],"El proceso de revocación se lleva a cabo de la siguiente manera:",{"_7897":907,"_22053":867,"_18699":34444,"_5":22203,"_15048":34347,"_1570":34445},[],"**Acceder a la revocación**: En la sección **Device Event Timeline**, junto al último certificado **Active**, se encuentra la opción de **Revoke**. Al hacer clic en ella, se abre una ventana de confirmación.",{"_7897":908,"_22053":867,"_18699":34447,"_5":22203,"_15048":34347,"_1570":34448},[],"**Seleccionar el motivo de revocación**: La ventana emergente solicita seleccionar un motivo de revocación (Revocation Reason). Esto es esencial para el registro de auditoría y la generación de la CRL (Certificate Revocation List). Los motivos disponibles, definidos en el **RFC 5280**, y otros adicionales son:",{"_7897":909,"_22053":867,"_18699":34450,"_5":22203,"_15048":34347,"_1570":34451},[],"**Unspecified**: Motivo de revocación no especificado.",{"_7897":910,"_22053":867,"_18699":34453,"_5":22203,"_15048":34347,"_1570":34454},[],"**KeyCompromise**: La clave privada del certificado ha sido comprometida.",{"_7897":911,"_22053":867,"_18699":34456,"_5":22203,"_15048":34347,"_1570":34457},[],"**CACompromise**: La clave privada de la CA ha sido comprometida.",{"_7897":912,"_22053":867,"_18699":34459,"_5":22203,"_15048":34347,"_1570":34460},[],"**AffiliationChanged**: El nombre del sujeto o su afiliación ha cambiado.",{"_7897":913,"_22053":867,"_18699":34462,"_5":22203,"_15048":34347,"_1570":34463},[],"**Superseded**: El certificado ha sido reemplazado por uno nuevo.",{"_7897":914,"_22053":867,"_18699":34465,"_5":22203,"_15048":34347,"_1570":34466},[],"**CessationOfOperation**: La entidad ha dejado de operar o usar el certificado.",{"_7897":915,"_22053":867,"_18699":34468,"_5":22203,"_15048":34347,"_1570":34469},[],"**CertificateHold**: El certificado está temporalmente en espera de revocación.",{"_7897":916,"_22053":867,"_18699":34471,"_5":22203,"_15048":34347,"_1570":34472},[],"**RemoveFromCRL**: Se usa en un *delta-CRL* para indicar que el certificado fue previamente puesto en espera y ahora debe ser revocado definitivamente.",{"_7897":917,"_22053":867,"_18699":34474,"_5":22203,"_15048":34347,"_1570":34475},[],"**PrivilegeWithdrawn**: Se han retirado los privilegios de la entidad asociada al certificado.",{"_7897":918,"_22053":867,"_18699":34477,"_5":22203,"_15048":34347,"_1570":34478},[],"**AACompromise**: La clave de un servidor de autorización de atributos ha sido comprometida.",{"_7897":919,"_22053":867,"_18699":34480,"_5":22203,"_15048":34347,"_1570":34481},[],"**WeakAlgorithmOrKey**: La clave o el algoritmo del certificado se consideran débiles o han sido comprometidos.",{"_7897":920,"_22053":867,"_18699":34483,"_5":22203,"_15048":34347,"_1570":34484},[],"**Confirmar la revocación**: Una vez seleccionado el motivo, se confirma la acción. El estado del certificado cambiará a **Revoked** en la línea de tiempo y en el historial de certificados. El certificado revocado dejará de ser válido.\nEs importante destacar que, una vez revocado un certificado, la identidad del dispositivo puede ser restaurada asignándole un nuevo certificado válido. En caso de que la razón de revocación sea CertificateHold, se permitirá la reactivación.",{"_7897":921,"_22053":867,"_18699":34486,"_5":22203,"_15048":34351,"_1570":34487},[],"El *Decommissioning* es el proceso irreversible de dar de baja un dispositivo de forma definitiva del sistema. A diferencia de la revocación, que sólo invalida el certificado, la desactivación revoca todos los certificados asociados al dispositivo y le impide obtener nuevas identidades en el futuro. Es una acción de seguridad crítica que se utiliza cuando un dispositivo es retirado permanentemente o ya no es de confianza.",{"_7897":922,"_22053":867,"_18699":34489,"_5":22203,"_15048":34351,"_1570":34490},[],"El proceso se realiza de la siguiente manera:",{"_7897":923,"_22053":867,"_18699":34492,"_5":22203,"_15048":34351,"_1570":34493},[],"**Acceder a la acción**: Desde la vista de detalles de un dispositivo activo, se hace clic en el botón **Decommission**.",{"_7897":924,"_22053":867,"_18699":34495,"_5":22203,"_15048":34351,"_1570":34496},[],"**Confirmar la acción irreversible**: Aparecerá una ventana de advertencia que explica que la acción es irreversible y que se revocarán todos los certificados asociados al dispositivo, impidiendo que vuelva a obtener una identidad.",{"_7897":925,"_22053":867,"_18699":34498,"_5":22203,"_15048":34351,"_1570":34499},[],"**Confirmar y desactivar**: Al confirmar la desactivación, el sistema revoca el certificado activo del dispositivo con la razón CessationOfOperation y cambia su estado a **Decommissioned**. El dispositivo ya no podrá realizar operaciones con la PKI.",{"_7897":926,"_22053":926,"_5":22198,"_1570":34501,"_22211":34502,"_18699":34503,"_15048":926},"EST: Enrollment over Secure Transport",[31714,32813,32822],[],{"_7897":927,"_22053":926,"_18699":34505,"_5":22203,"_15048":926,"_1570":34506},[],"Guía del protocolo EST en Lamassu IoT, con la configuración del DMS para el administrador PKI y la referencia de endpoints para el integrador de dispositivos.",{"_7897":928,"_22053":926,"_5":22208,"_18699":34508,"_15048":34509,"_1570":34501},[],"/docs/pr-preview/pr-22/manual/servicios-core/est#est-enrollment-over-secure-transport",{"_7897":929,"_22053":926,"_5":22208,"_18699":34511,"_15048":34512,"_1570":32896},[],"/docs/pr-preview/pr-22/manual/servicios-core/est#configuración-del-dms",{"_7897":930,"_22053":926,"_5":22208,"_18699":34514,"_15048":34515,"_1570":32419},[],"/docs/pr-preview/pr-22/manual/servicios-core/est#requisitos-previos",{"_7897":931,"_22053":926,"_5":22208,"_18699":34517,"_15048":34518,"_1570":34519},[],"/docs/pr-preview/pr-22/manual/servicios-core/est#configuración-de-enrollment","Configuración de enrollment",{"_7897":932,"_22053":926,"_5":22208,"_18699":34521,"_15048":34522,"_1570":34523},[],"/docs/pr-preview/pr-22/manual/servicios-core/est#enrollment-device-registration","Enrollment Device Registration",{"_7897":933,"_22053":926,"_5":22208,"_18699":34525,"_15048":34526,"_1570":34527},[],"/docs/pr-preview/pr-22/manual/servicios-core/est#enrollment-settings","Enrollment Settings",{"_7897":934,"_22053":926,"_5":22208,"_18699":34529,"_15048":34530,"_1570":34531},[],"/docs/pr-preview/pr-22/manual/servicios-core/est#perfil-de-emisión","Perfil de emisión",{"_7897":935,"_22053":926,"_5":22208,"_18699":34533,"_15048":34534,"_1570":34535},[],"/docs/pr-preview/pr-22/manual/servicios-core/est#configuración-de-re-enrollment","Configuración de re-enrollment",{"_7897":936,"_22053":926,"_5":22208,"_18699":34537,"_15048":34538,"_1570":34539},[],"/docs/pr-preview/pr-22/manual/servicios-core/est#configuración-de-serverkeygen","Configuración de ServerKeyGen",{"_7897":937,"_22053":926,"_5":22208,"_18699":34541,"_15048":34542,"_1570":34543},[],"/docs/pr-preview/pr-22/manual/servicios-core/est#verificar-la-configuración","Verificar la configuración",{"_7897":938,"_22053":926,"_5":22208,"_18699":34545,"_15048":34546,"_1570":34547},[],"/docs/pr-preview/pr-22/manual/servicios-core/est#integración-de-dispositivos","Integración de dispositivos",{"_7897":939,"_22053":926,"_5":22208,"_18699":34549,"_15048":34550,"_1570":34551},[],"/docs/pr-preview/pr-22/manual/servicios-core/est#antes-de-empezar","Antes de empezar",{"_7897":940,"_22053":926,"_5":22208,"_18699":34553,"_15048":34554,"_1570":34555},[],"/docs/pr-preview/pr-22/manual/servicios-core/est#resumen-del-flujo","Resumen del flujo",{"_7897":941,"_22053":926,"_5":22208,"_18699":34557,"_15048":34558,"_1570":34559},[],"/docs/pr-preview/pr-22/manual/servicios-core/est#modelo-de-autenticación-del-cliente","Modelo de autenticación del cliente",{"_7897":942,"_22053":926,"_5":22208,"_18699":34561,"_15048":34562,"_1570":34563},[],"/docs/pr-preview/pr-22/manual/servicios-core/est#referencia-de-endpoints","Referencia de endpoints",{"_7897":943,"_22053":926,"_5":22208,"_18699":34565,"_15048":34566,"_1570":34567},[],"/docs/pr-preview/pr-22/manual/servicios-core/est#cacerts","`/cacerts`",{"_7897":944,"_22053":926,"_5":22208,"_18699":34569,"_15048":34570,"_1570":34571},[],"/docs/pr-preview/pr-22/manual/servicios-core/est#simpleenroll","`/simpleenroll`",{"_7897":945,"_22053":926,"_5":22208,"_18699":34573,"_15048":34574,"_1570":34575},[],"/docs/pr-preview/pr-22/manual/servicios-core/est#simplereenroll","`/simplereenroll`",{"_7897":946,"_22053":926,"_5":22208,"_18699":34577,"_15048":34578,"_1570":34579},[],"/docs/pr-preview/pr-22/manual/servicios-core/est#serverkeygen","`/serverkeygen`",{"_7897":947,"_22053":926,"_5":22208,"_18699":34581,"_15048":34582,"_1570":34583},[],"/docs/pr-preview/pr-22/manual/servicios-core/est#flujos-completos","Flujos completos",{"_7897":948,"_22053":926,"_5":22208,"_18699":34585,"_15048":34586,"_1570":34587},[],"/docs/pr-preview/pr-22/manual/servicios-core/est#ejemplo-end-to-end-enroll","Ejemplo end-to-end: enroll",{"_7897":949,"_22053":926,"_5":22208,"_18699":34589,"_15048":34590,"_1570":34591},[],"/docs/pr-preview/pr-22/manual/servicios-core/est#ejemplo-end-to-end-reenroll","Ejemplo end-to-end: reenroll",{"_7897":950,"_22053":926,"_5":22208,"_18699":34593,"_15048":34594,"_1570":34595},[],"/docs/pr-preview/pr-22/manual/servicios-core/est#próximos-pasos-tras-el-enrolamiento","Próximos pasos tras el enrolamiento",{"_7897":951,"_22053":926,"_5":22208,"_18699":34597,"_15048":34598,"_1570":34599},[],"/docs/pr-preview/pr-22/manual/servicios-core/est#diagnóstico-y-compatibilidad","Diagnóstico y compatibilidad",{"_7897":952,"_22053":926,"_5":22208,"_18699":34601,"_15048":34602,"_1570":34603},[],"/docs/pr-preview/pr-22/manual/servicios-core/est#códigos-de-error-y-diagnóstico","Códigos de error y diagnóstico",{"_7897":953,"_22053":926,"_5":22208,"_18699":34605,"_15048":34606,"_1570":34607},[],"/docs/pr-preview/pr-22/manual/servicios-core/est#notas-de-compatibilidad","Notas de compatibilidad",{"_7897":954,"_22053":926,"_18699":34609,"_5":22203,"_15048":34509,"_1570":34610},[],"Lamassu IoT implementa el protocolo &#x2A;*EST (Enrollment over Secure Transport)** descrito en el RFC 7030 como su único mecanismo de inscripción de certificados para dispositivos. Cada DMS expone los endpoints EST, valida al dispositivo y aplica sus propias políticas de autenticación, registro y renovación — actuando como autoridad de registro (RA) frente al cliente.",{"_7897":955,"_22053":926,"_18699":34612,"_5":22203,"_15048":34509,"_1570":34613},[],"La entidad que emite y firma criptográficamente el certificado es siempre la **CA asociada al DMS**, no el DMS. El DMS coordina el proceso: recibe el CSR, autentica al dispositivo y aplica la política de emisión. Esta distinción es relevante para el administrador PKI al seleccionar la `EnrollmentCA` y para el integrador al interpretar la cadena de confianza recibida de `/cacerts`.",{"_7897":956,"_22053":926,"_18699":34615,"_5":22203,"_15048":34509,"_1570":34616},[],"Esta guía está dividida en dos partes:",{"_7897":957,"_22053":926,"_18699":34618,"_5":22203,"_15048":34509,"_1570":34619},[],"Configuración del DMS, para el administrador PKI.",{"_7897":958,"_22053":926,"_18699":34621,"_5":22203,"_15048":34509,"_1570":34622},[],"Integración de dispositivos, para quien consume los endpoints EST desde firmware, scripts o servicios de aprovisionamiento.",{"_7897":959,"_22053":926,"_18699":34624,"_5":22203,"_15048":34509,"_1570":34625},[],"Si solo necesita una orientación rápida, este es el recorrido recomendado:",{"_7897":960,"_22053":926,"_18699":34627,"_5":22203,"_15048":34509,"_1570":34628},[],"Perfil",{"_7897":961,"_22053":926,"_18699":34630,"_5":22203,"_15048":34509,"_1570":34631},[],"Leer primero",{"_7897":962,"_22053":926,"_18699":34633,"_5":22203,"_15048":34509,"_1570":34634},[],"Después",{"_7897":963,"_22053":926,"_18699":34636,"_5":22203,"_15048":34509,"_1570":34637},[],"Administrador PKI",{"_7897":964,"_22053":926,"_18699":34639,"_5":22203,"_15048":34509,"_1570":32896},[],{"_7897":965,"_22053":926,"_18699":34641,"_5":22203,"_15048":34509,"_1570":34599},[],{"_7897":966,"_22053":926,"_18699":34643,"_5":22203,"_15048":34509,"_1570":34644},[],"Integrador de dispositivos",{"_7897":967,"_22053":926,"_18699":34646,"_5":22203,"_15048":34509,"_1570":34551},[],{"_7897":968,"_22053":926,"_18699":34648,"_5":22203,"_15048":34509,"_1570":34649},[],"Los endpoints `/cacerts`, `/simpleenroll`, `/simplereenroll` o `/serverkeygen`, según el flujo",{"_7897":969,"_22053":926,"_18699":34651,"_5":22203,"_15048":34515,"_1570":34652},[],"Antes de configurar un DMS para EST, deben existir los siguientes recursos en la plataforma:",{"_7897":970,"_22053":926,"_18699":34654,"_5":22203,"_15048":34515,"_1570":34655},[],"**Una CA disponible**: la CA que actuará como `EnrollmentCA` debe estar creada y en estado activo en Lamassu. Si el modo de autenticación es `CLIENT_CERTIFICATE`, también deben estar creadas las CAs de validación del certificado bootstrap.",{"_7897":971,"_22053":926,"_18699":34657,"_5":22203,"_15048":34515,"_1570":34658},[],"**Un DMS creado**: el DMS al que se aplicará esta configuración debe existir previamente. La configuración EST se aplica sobre un DMS existente, no lo crea.",{"_7897":972,"_22053":926,"_18699":34660,"_5":22203,"_15048":34515,"_1570":34661},[],"Conviene separar cuatro bloques de configuración:",{"_7897":973,"_22053":926,"_18699":34663,"_5":22203,"_15048":34515,"_1570":34664},[],"Cómo se realizará el enrollment inicial, incluyendo el modo de alta y la autenticación del cliente.",{"_7897":974,"_22053":926,"_18699":34666,"_5":22203,"_15048":34515,"_1570":34667},[],"Cómo se gestionará el re-enrollment de certificados ya emitidos.",{"_7897":975,"_22053":926,"_18699":34669,"_5":22203,"_15048":34515,"_1570":34670},[],"Cómo se configurará el endpoint cacerts para la distribución de las CAs de confianza utilizadas por los dispositivos.",{"_7897":976,"_22053":926,"_18699":34672,"_5":22203,"_15048":34515,"_1570":34673},[],"Si se habilitará la generación de claves en servidor mediante `ServerKeyGen`.",{"_7897":977,"_22053":926,"_18699":34675,"_5":22203,"_15048":34522,"_1570":34676},[],"En esta sección se define cómo se registran los dispositivos nuevos y con qué credenciales se autentican.",{"_7897":978,"_22053":926,"_18699":34678,"_5":22203,"_15048":34522,"_1570":34679},[],"**Registration Mode**: determina el comportamiento al recibir una inscripción inicial. En modo `JITP` (*Just-In-Time Provisioning*), el dispositivo se crea automáticamente la primera vez que se presenta, aplicando los tags, metadatos e icono definidos en el perfil de aprovisionamiento. En modo `PRE_REGISTRATION`, el dispositivo debe existir previamente en la plataforma; si no existe, la solicitud se rechaza con `device not preregistered`. El modo JITP es adecuado para flotas grandes donde el inventario se construye durante el despliegue; el modo `PRE_REGISTRATION` encaja en entornos de alta seguridad donde cada dispositivo se aprueba de forma explícita antes de recibir un certificado.",{"_7897":979,"_22053":926,"_18699":34681,"_5":22203,"_15048":34522,"_1570":34682},[],"**Tags**: se aplican a cada dispositivo creado automáticamente por este DMS. Son opcionales y solo tienen efecto en modo JITP. Los tags permiten mejorar la búsqueda de dispositivos.",{"_7897":980,"_22053":926,"_18699":34684,"_5":22203,"_15048":34522,"_1570":34685},[],"**Icon**: se aplica a cada dispositivo creado automáticamente por este DMS. Es opcional y solo tiene efecto en modo JITP. Únicamente visual.",{"_7897":981,"_22053":926,"_18699":34687,"_5":22203,"_15048":34526,"_1570":34688},[],"**Enrollment CA**: identifica la CA que firmará los certificados de identidad emitidos a través de este DMS. Su elección determina la cadena de confianza que el dispositivo recibirá y la raíz contra la que los sistemas de backend validarán los certificados de flota.",{"_7897":982,"_22053":926,"_18699":34690,"_5":22203,"_15048":34526,"_1570":34691},[],"**Allow Override Enrollment** (`enable_replaceable_enrollment`): permite que un dispositivo ya enrolado vuelva a inscribirse mediante `/simpleenroll`. Cuando está activa, el certificado anterior se revoca con la razón `superseded` y el slot de identidad se actualiza. Cuando está inactiva, un segundo intento de `simpleenroll` se rechaza con `forbiddenNewEnrollment`. Esta opción debe habilitarse con precaución en entornos de producción, ya que permite sustituir la identidad de un dispositivo sin pasar por el flujo de re-enrollment.",{"_7897":983,"_22053":926,"_18699":34693,"_5":22203,"_15048":34526,"_1570":34694},[],"**Verify CSR Signature** (`verify_csr_signature`): controla si el servidor valida la firma del CSR contra la clave pública declarada en él (prueba de posesión PKCS#10). Cuando está inactiva, un solicitante podría enviar un CSR con una clave pública que no controla y obtener un certificado vinculado a ella. Para flotas IoT en redes abiertas debe estar activa.",{"_7897":984,"_22053":926,"_18699":34696,"_5":22203,"_15048":34526,"_1570":34697},[],"**Authentication Mode**: define cómo el DMS valida la identidad del dispositivo durante el enrollment. Los cuatro modos disponibles son:",{"_7897":985,"_22053":926,"_18699":34699,"_5":22203,"_15048":34526,"_1570":34700},[],"Modo",{"_7897":986,"_22053":926,"_18699":34702,"_5":22203,"_15048":34526,"_1570":31917},[],{"_7897":987,"_22053":926,"_18699":34704,"_5":22203,"_15048":34526,"_1570":34705},[],"`CLIENT_CERTIFICATE`",{"_7897":988,"_22053":926,"_18699":34707,"_5":22203,"_15048":34526,"_1570":34708},[],"mTLS. El dispositivo presenta un certificado X.509 emitido por alguna de las CAs declaradas en **Validation CAs**.",{"_7897":989,"_22053":926,"_18699":34710,"_5":22203,"_15048":34526,"_1570":34711},[],"`EXTERNAL_WEBHOOK`",{"_7897":990,"_22053":926,"_18699":34713,"_5":22203,"_15048":34526,"_1570":34714},[],"La decisión de autorización se delega en un servicio HTTP externo. Solo aplica en `/simpleenroll`; en `/simplereenroll` este modo degrada silenciosamente a `NO_AUTH`.",{"_7897":991,"_22053":926,"_18699":34716,"_5":22203,"_15048":34526,"_1570":34717},[],"`CLIENT_CERTIFICATE_AND_EXTERNAL_WEBHOOK`",{"_7897":992,"_22053":926,"_18699":34719,"_5":22203,"_15048":34526,"_1570":34720},[],"Combina los dos anteriores: se exige un certificado cliente válido **y** la confirmación del webhook externo.",{"_7897":993,"_22053":926,"_18699":34722,"_5":22203,"_15048":34526,"_1570":34723},[],"`NO_AUTH`",{"_7897":994,"_22053":926,"_18699":34725,"_5":22203,"_15048":34526,"_1570":34726},[],"Sin autenticación. Cualquier CSR se acepta. **Exclusivo para entornos de laboratorio o redes de aprovisionamiento aisladas**; no debe usarse en producción.",{"_7897":995,"_22053":926,"_18699":34728,"_5":22203,"_15048":34526,"_1570":34729},[],"Cuando el modo es `CLIENT_CERTIFICATE` o `CLIENT_CERTIFICATE_AND_EXTERNAL_WEBHOOK`, se configuran además estos parámetros:",{"_7897":996,"_22053":926,"_18699":34731,"_5":22203,"_15048":34526,"_1570":34732},[],"**Validation CAs**: lista de CAs de confianza para validar el certificado bootstrap presentado por el dispositivo.",{"_7897":997,"_22053":926,"_18699":34734,"_5":22203,"_15048":34526,"_1570":34735},[],"**Chain Validation Level**: profundidad máxima de la cadena de validación. El valor `-1` valida la cadena completa hasta la CA raíz.",{"_7897":998,"_22053":926,"_18699":34737,"_5":22203,"_15048":34526,"_1570":34738},[],"**Allow Authenticating Expired Certificates**: si está activo, acepta certificados cliente caducados. Es útil en escenarios de recuperación donde el dispositivo no pudo renovar su certificado a tiempo.",{"_7897":999,"_22053":926,"_18699":34740,"_5":22203,"_15048":34526,"_1570":34741},[],"Cuando el modo incluye `EXTERNAL_WEBHOOK`, se configuran además estos parámetros:",{"_7897":1000,"_22053":926,"_18699":34743,"_5":22203,"_15048":34526,"_1570":34744},[],"**Webhook URL**: dirección del servicio externo que decidirá la autorización.",{"_7897":1001,"_22053":926,"_18699":34746,"_5":22203,"_15048":34526,"_1570":34747},[],"**HTTP Method**: método HTTP utilizado para invocar el webhook.",{"_7897":1002,"_22053":926,"_18699":34749,"_5":22203,"_15048":34526,"_1570":34750},[],"**Timeout**: tiempo máximo de espera de la llamada al webhook.",{"_7897":1003,"_22053":926,"_18699":34752,"_5":22203,"_15048":34526,"_1570":34753},[],"**Webhook Authentication Mode**: modo de autenticación del webhook hacia el servicio externo, por ejemplo `ApiKey`, `OIDC` o `mTLS`.",{"_7897":1004,"_22053":926,"_18699":34755,"_5":22203,"_15048":34530,"_1570":34756},[],"El comportamiento del certificado emitido no lo determina únicamente el CSR del dispositivo, sino el **perfil de emisión** (`IssuanceProfile`) asociado al DMS. El integrador no configura este perfil, pero sus reglas afectan al contenido del certificado final:",{"_7897":1005,"_22053":926,"_18699":34758,"_5":22203,"_15048":34530,"_1570":34759},[],"Campo",{"_7897":1006,"_22053":926,"_18699":34761,"_5":22203,"_15048":34530,"_1570":33048},[],{"_7897":1007,"_22053":926,"_18699":34763,"_5":22203,"_15048":34530,"_1570":34764},[],"Efecto sobre el certificado emitido",{"_7897":1008,"_22053":926,"_18699":34766,"_5":22203,"_15048":34530,"_1570":34767},[],"`HonorSubject`",{"_7897":1009,"_22053":926,"_18699":34769,"_5":22203,"_15048":34530,"_1570":20403},[],{"_7897":1010,"_22053":926,"_18699":34771,"_5":22203,"_15048":34530,"_1570":34772},[],"Si `true`, el subject del CSR se traslada literalmente al certificado. Si `false`, la CA aplica la plantilla del perfil e ignora el subject del CSR.",{"_7897":1011,"_22053":926,"_18699":34774,"_5":22203,"_15048":34530,"_1570":34775},[],"`HonorKeyUsage`",{"_7897":1012,"_22053":926,"_18699":34777,"_5":22203,"_15048":34530,"_1570":20403},[],{"_7897":1013,"_22053":926,"_18699":34779,"_5":22203,"_15048":34530,"_1570":34780},[],"Si `true`, el `KeyUsage` del CSR se respeta. Si `false`, se aplica la plantilla del perfil.",{"_7897":1014,"_22053":926,"_18699":34782,"_5":22203,"_15048":34530,"_1570":34783},[],"`HonorExtendedKeyUsages`",{"_7897":1015,"_22053":926,"_18699":34785,"_5":22203,"_15048":34530,"_1570":20403},[],{"_7897":1016,"_22053":926,"_18699":34787,"_5":22203,"_15048":34530,"_1570":34788},[],"Igual que `HonorKeyUsage`, pero para `ExtKeyUsage`.",{"_7897":1017,"_22053":926,"_18699":34790,"_5":22203,"_15048":34530,"_1570":34791},[],"`HonorExtensions`",{"_7897":1018,"_22053":926,"_18699":34793,"_5":22203,"_15048":34530,"_1570":20403},[],{"_7897":1019,"_22053":926,"_18699":34795,"_5":22203,"_15048":34530,"_1570":34796},[],"Controla si el resto de extensiones del CSR (SAN, CDP, etc.) se incluyen en el certificado.",{"_7897":1020,"_22053":926,"_18699":34798,"_5":22203,"_15048":34530,"_1570":34799},[],"Esto es relevante para el integrador: el `KeyUsage`, `ExtKeyUsage` y los SAN que declara el CSR pueden no aparecer tal cual en el certificado final si el perfil así lo decide. Consulte con el administrador PKI si el certificado emitido no contiene las extensiones esperadas.",{"_7897":1021,"_22053":926,"_18699":34801,"_5":22203,"_15048":34534,"_1570":34802},[],"La sección **Re-Enrollment Settings** controla el proceso de renovación de certificados. El re-enrollment puede realizarse únicamente cuando el certificado está dentro de la ventana configurada, y opcionalmente también cuando el certificado ya ha caducado.",{"_7897":1022,"_22053":926,"_18699":34804,"_5":22203,"_15048":34534,"_1570":34805},[],"**Revoke On Re-Enroll**: si está activo, el certificado anterior se revoca automáticamente con la razón `superseded` una vez emitido el nuevo.",{"_7897":1023,"_22053":926,"_18699":34807,"_5":22203,"_15048":34534,"_1570":34808},[],"**Allow Expired Renewal**: permite renovar un certificado ya caducado. Es útil cuando un dispositivo ha estado desconectado y no pudo renovar dentro de la ventana.",{"_7897":1024,"_22053":926,"_18699":34810,"_5":22203,"_15048":34534,"_1570":34811},[],"**Allowed Renewal Delta**: ventana de tiempo previa a la caducidad durante la cual se permite el re-enrollment. Antes de que se abra esta ventana, la solicitud se rechaza con `invalid reenroll window`.",{"_7897":1025,"_22053":926,"_18699":34813,"_5":22203,"_15048":34534,"_1570":34814},[],"**Preventive Renewal Delta**: tiempo previo a la caducidad a partir del cual se emiten alertas de renovación preventiva.",{"_7897":1026,"_22053":926,"_18699":34816,"_5":22203,"_15048":34534,"_1570":34817},[],"**Critical Renewal Delta**: umbral más cercano al vencimiento que activa alertas de estado crítico.",{"_7897":1027,"_22053":926,"_18699":34819,"_5":22203,"_15048":34534,"_1570":34820},[],"**Additional Validation CAs**: CAs adicionales aceptadas como emisoras del certificado en vigor durante el re-enrollment. Permite migrar a una nueva CA de enrolamiento sin interrumpir la renovación de dispositivos ya enrolados con la CA anterior.",{"_7897":1028,"_22053":926,"_18699":34822,"_5":22203,"_15048":34538,"_1570":34823},[],"La sección **Server Key Generation** permite que Lamassu genere el par de claves del dispositivo en el servidor y lo devuelva junto con el certificado emitido. Es útil para dispositivos con capacidad criptográfica limitada.",{"_7897":1029,"_22053":926,"_18699":34825,"_5":22203,"_15048":34538,"_1570":34826},[],"La opción **Enable Server-Side Key Generation** activa el endpoint `/serverkeygen`. Cuando está inactiva, cualquier llamada a ese endpoint se rechaza con `server key generation not enabled`.",{"_7897":1030,"_22053":926,"_18699":34828,"_5":22203,"_15048":34538,"_1570":34829},[],"**Key Type** selecciona el algoritmo: `RSA` o `ECDSA`. El campo &#x2A;*Key Size (bits)** determina el tamaño de la clave. Para ECDSA, el tamaño en bits determina también la curva: 256 corresponde a P-256, 384 a P-384 y 521 a P-521.",{"_7897":1031,"_22053":926,"_18699":34831,"_5":22203,"_15048":34538,"_1570":34832},[],"La clave se genera en el motor software del servidor, no en un Crypto Engine de hardware como AWS KMS o PKCS#11. La única protección de la clave en tránsito es el canal TLS; no se aplica cifrado adicional (CMS EnvelopedData) sobre la clave antes de enviarla al dispositivo. Consulte el apartado `/serverkeygen` de la referencia para integrador para conocer el formato exacto de la respuesta y las consideraciones de seguridad.",{"_7897":1032,"_22053":926,"_18699":34834,"_5":22203,"_15048":34542,"_1570":34835},[],"Una vez aplicados los ajustes de enrollment, re-enrollment y ServerKeyGen, puede confirmar que el DMS está operativo de las siguientes formas:",{"_7897":1033,"_22053":926,"_18699":34837,"_5":22203,"_15048":34542,"_1570":34838},[],"**Desde la consola**: accede al detalle del DMS y comprueba que la sección EST muestra la CA de enrolamiento asignada y el modo de autenticación configurado.",{"_7897":1034,"_22053":926,"_18699":34840,"_5":22203,"_15048":34542,"_1570":34841},[],"**Con una solicitud de prueba**: invoca el endpoint `/cacerts` del DMS desde un cliente `curl` con la confianza del servidor. Una respuesta `200 OK` con contenido base64 confirma que el DMS está activo y que la CA de enrolamiento es accesible.",{"_7897":1035,"_22053":926,"_18699":34843,"_5":22203,"_15048":34542,"_1570":34844},[],"Si el DMS no existe o la CA no está disponible, el servidor responde con `DMS not found` u otro mensaje de error. Consulte la sección Diagnóstico y compatibilidad para interpretar los mensajes de error.",{"_7897":1036,"_22053":926,"_18699":34846,"_5":22203,"_15048":34546,"_1570":34847},[],"*Esta sección está dirigida al integrador de dispositivos.*",{"_7897":1037,"_22053":926,"_18699":34849,"_5":22203,"_15048":34546,"_1570":34850},[],"Los endpoints EST de Lamassu se publican bajo el prefijo `/.well-known/est` y exigen siempre la presencia del segmento de ruta `{aps}`, que se interpreta como el identificador del DMS al que se dirige la operación. La asociación es directa: el valor de `{aps}` recibido en la URL se utiliza como ID de DMS al consultar el almacén interno. Las variantes registradas sin `{aps}` (por ejemplo `/.well-known/est/cacerts`) están enrutadas en el código, pero su gestor exige el campo `APS` y devuelve `400 Bad Request` con el mensaje `Field validation for 'APS' failed` cuando el segmento no se proporciona.",{"_7897":1038,"_22053":926,"_18699":34852,"_5":22203,"_15048":34546,"_1570":34853},[],"Esta parte sigue el orden habitual de trabajo del integrador: primero los requisitos previos y el modelo de autenticación, después la referencia de cada endpoint y, al final, ejemplos completos y material de diagnóstico.",{"_7897":1039,"_22053":926,"_18699":34855,"_5":22203,"_15048":34550,"_1570":34856},[],"El administrador PKI debe haber configurado un DMS con el protocolo `EST_RFC7030`, una CA de enrolamiento asignada y al menos un modo de autenticación. Sin esa configuración previa, Lamassu rechaza cualquier solicitud de enrolamiento. Los detalles de esa configuración se encuentran en la sección de configuración del DMS de esta misma página.",{"_7897":1040,"_22053":926,"_18699":34858,"_5":22203,"_15048":34550,"_1570":34859},[],"Antes de realizar la primera llamada, asegúrese de tener:",{"_7897":1041,"_22053":926,"_18699":34861,"_5":22203,"_15048":34550,"_1570":34862},[],"Elemento",{"_7897":1042,"_22053":926,"_18699":34864,"_5":22203,"_15048":34550,"_1570":31917},[],{"_7897":1043,"_22053":926,"_18699":34866,"_5":22203,"_15048":34550,"_1570":34867},[],"**URL del host EST**",{"_7897":1044,"_22053":926,"_18699":34869,"_5":22203,"_15048":34550,"_1570":34870},[],"Dirección base del servidor, por ejemplo `https://est.lamassu.example`. La proporciona el administrador PKI.",{"_7897":1045,"_22053":926,"_18699":34872,"_5":22203,"_15048":34550,"_1570":34873},[],"**Ancla de confianza del servidor** (`lamassu-trust.pem`)",{"_7897":1046,"_22053":926,"_18699":34875,"_5":22203,"_15048":34550,"_1570":34876},[],"Certificado raíz o intermedio con el que validar el TLS del servidor Lamassu. Sin él, el cliente rechazará el certificado del servidor.",{"_7897":1047,"_22053":926,"_18699":34878,"_5":22203,"_15048":34550,"_1570":34879},[],"**Certificado bootstrap + clave privada**",{"_7897":1048,"_22053":926,"_18699":34881,"_5":22203,"_15048":34550,"_1570":34882},[],"Solo para modos `CLIENT_CERTIFICATE` o `CLIENT_CERTIFICATE_AND_EXTERNAL_WEBHOOK`. Es el certificado de aprovisionamiento emitido por alguna de las `ValidationCAs` del DMS, normalmente una CA dedicada al provisioning y distinta de la CA de enrolamiento.",{"_7897":1049,"_22053":926,"_18699":34884,"_5":22203,"_15048":34550,"_1570":34885},[],"**ID del DMS** (`{aps}`)",{"_7897":1050,"_22053":926,"_18699":34887,"_5":22203,"_15048":34550,"_1570":34888},[],"Identificador del DMS que aparece en todas las rutas EST. Lo proporciona el administrador PKI.",{"_7897":1051,"_22053":926,"_18699":34890,"_5":22203,"_15048":34554,"_1570":34891},[],"Caso",{"_7897":1052,"_22053":926,"_18699":34893,"_5":22203,"_15048":34554,"_1570":34894},[],"Credencial habitual",{"_7897":1053,"_22053":926,"_18699":34896,"_5":22203,"_15048":34554,"_1570":34897},[],"Endpoint principal",{"_7897":1054,"_22053":926,"_18699":34899,"_5":22203,"_15048":34554,"_1570":34900},[],"Resultado",{"_7897":1055,"_22053":926,"_18699":34902,"_5":22203,"_15048":34554,"_1570":34903},[],"Alta inicial",{"_7897":1056,"_22053":926,"_18699":34905,"_5":22203,"_15048":34554,"_1570":34906},[],"Certificado bootstrap o el modo definido en `AuthMode`",{"_7897":1057,"_22053":926,"_18699":34908,"_5":22203,"_15048":34554,"_1570":34571},[],{"_7897":1058,"_22053":926,"_18699":34910,"_5":22203,"_15048":34554,"_1570":34911},[],"Certificado de dispositivo",{"_7897":1059,"_22053":926,"_18699":34913,"_5":22203,"_15048":34554,"_1570":34914},[],"Renovación",{"_7897":1060,"_22053":926,"_18699":34916,"_5":22203,"_15048":34554,"_1570":34917},[],"Certificado actual del dispositivo",{"_7897":1061,"_22053":926,"_18699":34919,"_5":22203,"_15048":34554,"_1570":34575},[],{"_7897":1062,"_22053":926,"_18699":34921,"_5":22203,"_15048":34554,"_1570":34922},[],"Certificado renovado",{"_7897":1063,"_22053":926,"_18699":34924,"_5":22203,"_15048":34554,"_1570":34925},[],"Descarga de confianza",{"_7897":1064,"_22053":926,"_18699":34927,"_5":22203,"_15048":34554,"_1570":34928},[],"TLS del servidor",{"_7897":1065,"_22053":926,"_18699":34930,"_5":22203,"_15048":34554,"_1570":34567},[],{"_7897":1066,"_22053":926,"_18699":34932,"_5":22203,"_15048":34554,"_1570":34933},[],"PKCS#7 o PEM con certificados",{"_7897":1067,"_22053":926,"_18699":34935,"_5":22203,"_15048":34554,"_1570":34936},[],"Clave generada en servidor",{"_7897":1068,"_22053":926,"_18699":34938,"_5":22203,"_15048":34554,"_1570":34939},[],"Igual que `/simpleenroll`",{"_7897":1069,"_22053":926,"_18699":34941,"_5":22203,"_15048":34554,"_1570":34579},[],{"_7897":1070,"_22053":926,"_18699":34943,"_5":22203,"_15048":34554,"_1570":34944},[],"Clave privada PKCS#8 + certificado",{"_7897":1071,"_22053":926,"_18699":34946,"_5":22203,"_15048":34558,"_1570":34947},[],"La implementación de Lamassu reconoce cuatro configuraciones de autenticación para `/simpleenroll`, expresadas mediante el campo `EnrollmentOptionsESTRFC7030.AuthMode` del DMS. Tres son modos simples (`CLIENT_CERTIFICATE`, `EXTERNAL_WEBHOOK`, `NO_AUTH`) y una combina dos controles (`CLIENT_CERTIFICATE_AND_EXTERNAL_WEBHOOK`). El cliente debe presentarse en el modo que el DMS espera; cualquier otra combinación genera un fallo en la inscripción.",{"_7897":1072,"_22053":926,"_18699":34949,"_5":22203,"_15048":34558,"_1570":34950},[],"Modo (`AuthMode`)",{"_7897":1073,"_22053":926,"_18699":34952,"_5":22203,"_15048":34558,"_1570":31917},[],{"_7897":1074,"_22053":926,"_18699":34954,"_5":22203,"_15048":34558,"_1570":34955},[],"Credencial esperada",{"_7897":1075,"_22053":926,"_18699":34957,"_5":22203,"_15048":34558,"_1570":34958},[],"Aplica en enroll",{"_7897":1076,"_22053":926,"_18699":34960,"_5":22203,"_15048":34558,"_1570":34961},[],"Aplica en reenroll",{"_7897":1077,"_22053":926,"_18699":34963,"_5":22203,"_15048":34558,"_1570":34705},[],{"_7897":1078,"_22053":926,"_18699":34965,"_5":22203,"_15048":34558,"_1570":34966},[],"mTLS con certificado X.509",{"_7897":1079,"_22053":926,"_18699":34968,"_5":22203,"_15048":34558,"_1570":34969},[],"Certificado y clave privada cliente",{"_7897":1080,"_22053":926,"_18699":34971,"_5":22203,"_15048":34558,"_1570":33061},[],{"_7897":1081,"_22053":926,"_18699":34973,"_5":22203,"_15048":34558,"_1570":34974},[],"Sí (con el certificado en vigor)",{"_7897":1082,"_22053":926,"_18699":34976,"_5":22203,"_15048":34558,"_1570":34717},[],{"_7897":1083,"_22053":926,"_18699":34978,"_5":22203,"_15048":34558,"_1570":34979},[],"mTLS más validación por webhook",{"_7897":1084,"_22053":926,"_18699":34981,"_5":22203,"_15048":34558,"_1570":34982},[],"Certificado y clave privada cliente, más aprobación del webhook",{"_7897":1085,"_22053":926,"_18699":34984,"_5":22203,"_15048":34558,"_1570":33061},[],{"_7897":1086,"_22053":926,"_18699":34986,"_5":22203,"_15048":34558,"_1570":34987},[],"No como combinación; en reenroll no mantiene ambos controles",{"_7897":1087,"_22053":926,"_18699":34989,"_5":22203,"_15048":34558,"_1570":34711},[],{"_7897":1088,"_22053":926,"_18699":34991,"_5":22203,"_15048":34558,"_1570":34992},[],"Webhook externo de autorización",{"_7897":1089,"_22053":926,"_18699":34994,"_5":22203,"_15048":34558,"_1570":34995},[],"Ninguna en el canal TLS",{"_7897":1090,"_22053":926,"_18699":34997,"_5":22203,"_15048":34558,"_1570":33061},[],{"_7897":1091,"_22053":926,"_18699":34999,"_5":22203,"_15048":34558,"_1570":35000},[],"No, degrada a `NO_AUTH`",{"_7897":1092,"_22053":926,"_18699":35002,"_5":22203,"_15048":34558,"_1570":34723},[],{"_7897":1093,"_22053":926,"_18699":35004,"_5":22203,"_15048":34558,"_1570":35005},[],"Sin autenticación",{"_7897":1094,"_22053":926,"_18699":35007,"_5":22203,"_15048":34558,"_1570":35008},[],"Ninguna",{"_7897":1095,"_22053":926,"_18699":35010,"_5":22203,"_15048":34558,"_1570":35011},[],"Sí (uso restringido)",{"_7897":1096,"_22053":926,"_18699":35013,"_5":22203,"_15048":34558,"_1570":35011},[],{"_7897":1097,"_22053":926,"_18699":35015,"_5":22203,"_15048":34558,"_1570":35016},[],"JWT **no es un modo de autenticación válido en EST**. El extractor de identidad JWT existe en el código pero solo se evalúa en la API de administración de Lamassu. Cualquier *Bearer token* enviado a `/.well-known/est/...` se ignora silenciosamente. Cuando el DMS está configurado con `AuthMode: CLIENT_CERTIFICATE`, una petición que solo aporte JWT se rechaza por falta de certificado cliente. Cuando el DMS está en `AuthMode: NO_AUTH`, la petición se procesa como tal y el JWT no añade ni resta autorización.",{"_7897":1098,"_22053":926,"_18699":35018,"_5":22203,"_15048":34558,"_1570":35019},[],"**`CLIENT_CERTIFICATE`**: el cliente presenta un certificado X.509 emitido por una de las CAs declaradas en `AuthOptionsMTLS.ValidationCAs`. El proceso valida la cadena del certificado contra esas CAs mediante los parámetros `ValidationCAs`, `AllowExpired` y `ChainLevelValidation`. Además, el servicio comprueba el estado de revocación en tres pasos: primero busca el cert en la base de datos local de Lamassu; si no lo encuentra, consulta los responders OCSP listados en la extensión AIA; si OCSP falla, intenta los CRL Distribution Points (CDP). Un certificado revocado interrumpe la inscripción con `certificate is revoked`.",{"_7897":1099,"_22053":926,"_18699":35021,"_5":22203,"_15048":34558,"_1570":33045},[],{"_7897":1100,"_22053":926,"_18699":35023,"_5":22203,"_15048":34558,"_1570":33048},[],{"_7897":1101,"_22053":926,"_18699":35025,"_5":22203,"_15048":34558,"_1570":31917},[],{"_7897":1102,"_22053":926,"_18699":35027,"_5":22203,"_15048":34558,"_1570":35028},[],"`ValidationCAs`",{"_7897":1103,"_22053":926,"_18699":35030,"_5":22203,"_15048":34558,"_1570":35031},[],"lista de IDs de CA",{"_7897":1104,"_22053":926,"_18699":35033,"_5":22203,"_15048":34558,"_1570":35034},[],"CAs de confianza para validar el certificado bootstrap (en enroll) o el certificado en vigor (en reenroll).",{"_7897":1105,"_22053":926,"_18699":35036,"_5":22203,"_15048":34558,"_1570":35037},[],"`AllowExpired`",{"_7897":1106,"_22053":926,"_18699":35039,"_5":22203,"_15048":34558,"_1570":20403},[],{"_7897":1107,"_22053":926,"_18699":35041,"_5":22203,"_15048":34558,"_1570":35042},[],"Si está activado, acepta certificados cliente caducados. Si es `false`, los certificados expirados se rechazan.",{"_7897":1108,"_22053":926,"_18699":35044,"_5":22203,"_15048":34558,"_1570":35045},[],"`ChainLevelValidation`",{"_7897":1109,"_22053":926,"_18699":35047,"_5":22203,"_15048":34558,"_1570":4285},[],{"_7897":1110,"_22053":926,"_18699":35049,"_5":22203,"_15048":34558,"_1570":35050},[],"Si es mayor que cero, recorta la cadena de validación al número de niveles indicado.",{"_7897":1111,"_22053":926,"_18699":35052,"_5":22203,"_15048":34558,"_1570":35053},[],"**`EXTERNAL_WEBHOOK`**: Lamassu delega la decisión de autorización en un servicio HTTP externo. El servidor EST construye una petición `POST` al webhook configurado con un cuerpo JSON que reproduce el contexto de la inscripción.",{"_7897":1112,"_22053":926,"_18699":35055,"_5":22203,"_15048":34558,"_1570":35056},[],"El valor del campo `csr` es la **codificación base64 del PEM** del CSR (no el DER, y no el PEM en claro). El webhook debe responder con `2xx` y `{\"authorized\": true}` para continuar; cualquier otra respuesta aborta el enrolamiento con `external webhook denied enrollment`.",{"_7897":1113,"_22053":926,"_18699":35058,"_5":22203,"_15048":34558,"_1570":35059},[],"**`CLIENT_CERTIFICATE_AND_EXTERNAL_WEBHOOK`**: combina los dos modos anteriores durante `/simpleenroll` — el cliente debe presentar un certificado mTLS válido y el webhook debe devolver `authorized: true`. En `/simplereenroll` la combinación no se conserva: el chequeo conjunto mTLS + webhook no se mantiene, por lo que el integrador no debe asumir que las mismas garantías del enrollment inicial aplican en reenroll.",{"_7897":1114,"_22053":926,"_18699":35061,"_5":22203,"_15048":34558,"_1570":35062},[],"**`NO_AUTH`**: el DMS acepta cualquier CSR sin validar identidad del cliente. Lamassu emite un aviso en su log (`DMS is configured with NoAuth, allowing enrollment`) y procede al alta. Debe restringirse a entornos controlados (una red de aprovisionamiento aislada); cualquier red expuesta a internet con un DMS en `NO_AUTH` queda abierta a la emisión de certificados por terceros no autorizados.",{"_7897":1115,"_22053":926,"_18699":35064,"_5":22203,"_15048":34562,"_1570":35065},[],"Las siguientes secciones describen los endpoints en el orden más habitual de uso dentro del ciclo de vida del dispositivo:",{"_7897":1116,"_22053":926,"_18699":35067,"_5":22203,"_15048":34562,"_1570":35068},[],"`/cacerts`: descarga de la cadena de confianza.",{"_7897":1117,"_22053":926,"_18699":35070,"_5":22203,"_15048":34562,"_1570":35071},[],"`/simpleenroll`: inscripción inicial del certificado.",{"_7897":1118,"_22053":926,"_18699":35073,"_5":22203,"_15048":34562,"_1570":35074},[],"`/simplereenroll`: renovación de un certificado ya emitido.",{"_7897":1119,"_22053":926,"_18699":35076,"_5":22203,"_15048":34562,"_1570":35077},[],"`/serverkeygen`: inscripción con generación de clave en servidor.",{"_7897":1120,"_22053":926,"_18699":35079,"_5":22203,"_15048":34566,"_1570":35080},[],"El endpoint `GET /.well-known/est/{aps}/cacerts` distribuye los certificados que el dispositivo necesita para validar al servidor EST y al resto de las CAs gestionadas por el DMS. Lamassu inserta los certificados en este orden: primero el certificado **downstream** del servidor Lamassu, que es la hoja TLS del servidor y no una CA, útil para pinning si `IncludeLamassuSystemCA` está activado; después la lista `ManagedCAs` declarada en el DMS; y por último la CA de enrolamiento, si `IncludeEnrollmentCA` está activado.",{"_7897":1121,"_22053":926,"_18699":35082,"_5":22203,"_15048":34566,"_1570":35083},[],"Campo de `CADistributionSettings`",{"_7897":1122,"_22053":926,"_18699":35085,"_5":22203,"_15048":34566,"_1570":33048},[],{"_7897":1123,"_22053":926,"_18699":35087,"_5":22203,"_15048":34566,"_1570":31917},[],{"_7897":1124,"_22053":926,"_18699":35089,"_5":22203,"_15048":34566,"_1570":35090},[],"`IncludeLamassuSystemCA`",{"_7897":1125,"_22053":926,"_18699":35092,"_5":22203,"_15048":34566,"_1570":20403},[],{"_7897":1126,"_22053":926,"_18699":35094,"_5":22203,"_15048":34566,"_1570":35095},[],"Incluye el certificado *downstream* del servidor Lamassu, es decir, la hoja TLS que el cliente puede usar para anclar la conexión. Es un cert de extremo, no una CA.",{"_7897":1127,"_22053":926,"_18699":35097,"_5":22203,"_15048":34566,"_1570":35098},[],"`IncludeEnrollmentCA`",{"_7897":1128,"_22053":926,"_18699":35100,"_5":22203,"_15048":34566,"_1570":20403},[],{"_7897":1129,"_22053":926,"_18699":35102,"_5":22203,"_15048":34566,"_1570":35103},[],"Incluye la CA emisora del DMS, es decir, la que firmará los certificados de dispositivo.",{"_7897":1130,"_22053":926,"_18699":35105,"_5":22203,"_15048":34566,"_1570":35106},[],"`ManagedCAs`",{"_7897":1131,"_22053":926,"_18699":35108,"_5":22203,"_15048":34566,"_1570":35031},[],{"_7897":1132,"_22053":926,"_18699":35110,"_5":22203,"_15048":34566,"_1570":35111},[],"CAs adicionales que se publican como anclas de confianza al dispositivo.",{"_7897":1133,"_22053":926,"_18699":35113,"_5":22203,"_15048":34566,"_1570":35114},[],"El formato por defecto es PKCS#7 *degenerate* (sólo certificados) codificado en base64. La respuesta declara `Content-Type: application/pkcs7-mime; smime-type=certs-only` y `Content-Transfer-Encoding: base64`. El base64 viene troceado en líneas de **76 caracteres** terminadas en CRLF, una anchura conforme con S/MIME (RFC 5751), no los 64 que sugieren ciertas guías de RFC 7030. Este troceo aplica únicamente a `/cacerts` y `/simpleenroll`; las partes internas de `/serverkeygen` no llevan wrap, como se explica más abajo.",{"_7897":1134,"_22053":926,"_18699":35116,"_5":22203,"_15048":34566,"_1570":35117},[],"El PKCS#7 *degenerate* es un **conjunto** de certificados sin orden semántico definido. Aunque Lamassu los inserta en el orden indicado, el integrador no debe asumir ese orden al validar cadenas: la cadena debe construirse por correspondencia `Subject`/`Issuer` (o por AKI/SKI), no por la posición en la respuesta.",{"_7897":1135,"_22053":926,"_18699":35119,"_5":22203,"_15048":34566,"_1570":35120},[],"El flag `-i` (ignore garbage) ayuda a tolerar el CRLF que Lamassu añade y es necesario en algunos `base64` (BusyBox, BSD); en GNU coreutils se ignora.",{"_7897":1136,"_22053":926,"_18699":35122,"_5":22203,"_15048":34566,"_1570":35123},[],"Lamassu añade además una extensión sobre el RFC: si el cliente envía la cabecera `Accept: application/x-pem-file`, el servidor responde con la concatenación PEM de los mismos certificados, sin el envoltorio PKCS#7. Esto facilita el consumo desde scripts. La extensión también funciona en `/simpleenroll` y `/simplereenroll`.",{"_7897":1137,"_22053":926,"_18699":35125,"_5":22203,"_15048":34570,"_1570":35126},[],"El endpoint `POST /.well-known/est/{aps}/simpleenroll` recibe un CSR y devuelve el certificado emitido. El cuerpo de la petición debe ser el **PKCS#10 (CSR) en DER, codificado en base64** sin saltos de línea. La base64 envuelve directamente al DER, no al PEM. La cabecera `Content-Type` debe valer `application/pkcs10`. Si el `Content-Type` es diferente, el servidor responde `400` con `content-type must be application/pkcs10`; si el cuerpo no es base64 válido, responde `400` con `body payload must be base64 encoded`.",{"_7897":1138,"_22053":926,"_18699":35128,"_5":22203,"_15048":34570,"_1570":35129},[],"La respuesta sigue el mismo envoltorio que `/cacerts`: PKCS#7 *degenerate* en base64, con `Content-Type: application/pkcs7-mime; smime-type=certs-only`. El PKCS#7 contiene **únicamente el certificado de hoja** recién emitido; no incluye la CA emisora ni intermediarios. Esto cumple RFC 7030 §4.2.3 (donde la cadena es opcional) pero implica que el integrador debe combinar este certificado con la cadena obtenida de `/cacerts` antes de presentarlo a cualquier relying party que valide cadena completa (por ejemplo, un broker MQTT con mTLS estricta).",{"_7897":1139,"_22053":926,"_18699":35131,"_5":22203,"_15048":34570,"_1570":35132},[],"Varios campos del DMS gobiernan el comportamiento de `/simpleenroll`. El integrador no los configura, pero conviene conocerlos para interpretar los rechazos.",{"_7897":1140,"_22053":926,"_18699":35134,"_5":22203,"_15048":34570,"_1570":34759},[],{"_7897":1141,"_22053":926,"_18699":35136,"_5":22203,"_15048":34570,"_1570":33048},[],{"_7897":1142,"_22053":926,"_18699":35138,"_5":22203,"_15048":34570,"_1570":35139},[],"Efecto",{"_7897":1143,"_22053":926,"_18699":35141,"_5":22203,"_15048":34570,"_1570":35142},[],"`EnrollmentSettings.RegistrationMode`",{"_7897":1144,"_22053":926,"_18699":35144,"_5":22203,"_15048":34570,"_1570":35145},[],"`JITP` / `PRE_REGISTRATION`",{"_7897":1145,"_22053":926,"_18699":35147,"_5":22203,"_15048":34570,"_1570":35148},[],"Decide si el dispositivo se crea automáticamente en la primera inscripción (`JITP`) o si debe existir previamente (`PRE_REGISTRATION`).",{"_7897":1146,"_22053":926,"_18699":35150,"_5":22203,"_15048":34570,"_1570":35151},[],"`EnrollmentSettings.EnableReplaceableEnrollment`",{"_7897":1147,"_22053":926,"_18699":35153,"_5":22203,"_15048":34570,"_1570":20403},[],{"_7897":1148,"_22053":926,"_18699":35155,"_5":22203,"_15048":34570,"_1570":35156},[],"Si es `true`, un dispositivo ya enrolado puede volver a inscribirse mediante `/simpleenroll`; el certificado anterior se revoca con razón `superseded`. Si es `false`, el segundo intento se rechaza con `forbiddenNewEnrollment`.",{"_7897":1149,"_22053":926,"_18699":35158,"_5":22203,"_15048":34570,"_1570":35159},[],"`EnrollmentSettings.VerifyCSRSignature`",{"_7897":1150,"_22053":926,"_18699":35161,"_5":22203,"_15048":34570,"_1570":20403},[],{"_7897":1151,"_22053":926,"_18699":35163,"_5":22203,"_15048":34570,"_1570":35164},[],"Si es `true`, el servidor valida la firma del CSR contra la clave pública declarada en él (proof-of-possession estándar de PKCS#10/RFC 2986). Si es `false`, se omite la prueba de posesión. Para flotas IoT en redes abiertas debe estar en `true`.",{"_7897":1152,"_22053":926,"_18699":35166,"_5":22203,"_15048":34570,"_1570":35167},[],"En modo `JITP`, el primer `simpleenroll` con un `CommonName` que aún no existe en Lamassu crea el dispositivo automáticamente. En modo `PRE_REGISTRATION`, el dispositivo debe existir previamente; un `CommonName` desconocido se rechaza con `device not preregistered`. Consulte Configuración de enrollment para más detalles sobre ambos modos y el comportamiento del perfil de emisión.",{"_7897":1153,"_22053":926,"_18699":35169,"_5":22203,"_15048":34574,"_1570":35170},[],"El endpoint `POST /.well-known/est/{aps}/simplereenroll` renueva el certificado de un dispositivo ya enrolado. El formato del cuerpo es idéntico al de `/simpleenroll` (DER base64 sin saltos, `Content-Type: application/pkcs10`). La diferencia está en la autenticación: el cliente debe presentar **el certificado en vigor** del dispositivo (no el bootstrap) como credencial mTLS.",{"_7897":1154,"_22053":926,"_18699":35172,"_5":22203,"_15048":34574,"_1570":35173},[],"Si el DMS está configurado con `AuthMode: EXTERNAL_WEBHOOK`, el webhook **no se invoca** durante `/simplereenroll`. El flujo de renovación degrada silenciosamente a `NO_AUTH`: cualquier cliente que conozca un `CommonName` válido puede solicitar reenroll para ese dispositivo sin autenticación (`allowing reenroll: using NO AUTH mode` en el log). Un DMS con `EXTERNAL_WEBHOOK` no debe usarse en producción para flujos de reenroll a menos que se controle la red de acceso al endpoint.",{"_7897":1155,"_22053":926,"_18699":35175,"_5":22203,"_15048":34574,"_1570":35176},[],"El comportamiento del reenroll está condicionado por varios campos de `ReEnrollmentSettings`:",{"_7897":1156,"_22053":926,"_18699":35178,"_5":22203,"_15048":34574,"_1570":34759},[],{"_7897":1157,"_22053":926,"_18699":35180,"_5":22203,"_15048":34574,"_1570":33048},[],{"_7897":1158,"_22053":926,"_18699":35182,"_5":22203,"_15048":34574,"_1570":35139},[],{"_7897":1159,"_22053":926,"_18699":35184,"_5":22203,"_15048":34574,"_1570":35185},[],"`ReEnrollmentDelta`",{"_7897":1160,"_22053":926,"_18699":35187,"_5":22203,"_15048":34574,"_1570":35188},[],"duración",{"_7897":1161,"_22053":926,"_18699":35190,"_5":22203,"_15048":34574,"_1570":35191},[],"Define la ventana de renovación: el cliente solo puede renovar a partir de `NotAfter - ReEnrollmentDelta`. Antes de ese instante, el servidor responde con `invalid reenroll window`.",{"_7897":1162,"_22053":926,"_18699":35193,"_5":22203,"_15048":34574,"_1570":35194},[],"`EnableExpiredRenewal`",{"_7897":1163,"_22053":926,"_18699":35196,"_5":22203,"_15048":34574,"_1570":20403},[],{"_7897":1164,"_22053":926,"_18699":35198,"_5":22203,"_15048":34574,"_1570":35199},[],"Si es `true`, acepta certificados ya caducados como prueba de identidad. Si es `false`, un certificado expirado provoca `expired certificate`.",{"_7897":1165,"_22053":926,"_18699":35201,"_5":22203,"_15048":34574,"_1570":35202},[],"`RevokeOnReEnrollment`",{"_7897":1166,"_22053":926,"_18699":35204,"_5":22203,"_15048":34574,"_1570":20403},[],{"_7897":1167,"_22053":926,"_18699":35206,"_5":22203,"_15048":34574,"_1570":35207},[],"Si es `true`, revoca automáticamente el certificado anterior tras emitir el nuevo, con la razón `superseded` (código 4 de RFC 5280).",{"_7897":1168,"_22053":926,"_18699":35209,"_5":22203,"_15048":34574,"_1570":35210},[],"`AdditionalValidationCAs`",{"_7897":1169,"_22053":926,"_18699":35212,"_5":22203,"_15048":34574,"_1570":35031},[],{"_7897":1170,"_22053":926,"_18699":35214,"_5":22203,"_15048":34574,"_1570":35215},[],"CAs adicionales que el servidor admite como emisores válidos del certificado en vigor, además de la CA de enrolamiento del DMS.",{"_7897":1171,"_22053":926,"_18699":35217,"_5":22203,"_15048":34574,"_1570":35218},[],"**Inmutabilidad del subject**: el CSR de renovación debe tener exactamente el mismo subject que el certificado en vigor. Lamassu compara, byte a byte, el `RawSubject` del CSR con el del certificado (`slices.Compare`). Si los bytes difieren, el servidor cae a una comparación semántica de respaldo sobre los atributos `CommonName`, `OrganizationalUnit`, `Organization`, `Locality`, `Province` y `Country`. Si todos esos atributos coinciden, el reenroll continúa pese a la diferencia de bytes (rescata casos donde solo cambia la codificación, `PrintableString` frente a `UTF8String`). Si algún atributo difiere, el reenroll se aborta con `invalid RawSubject bytes`. El integrador debe regenerar el CSR con exactamente el mismo subject que en la inscripción inicial para no depender del comportamiento de fallback.",{"_7897":1172,"_22053":926,"_18699":35220,"_5":22203,"_15048":34574,"_1570":35221},[],"**Validación de la cadena del certificado presentado**: la validación se intenta primero contra la CA de enrolamiento del DMS; si falla, recorre las `AdditionalValidationCAs`. La validación es \"shallow\": cada CA se prueba como ancla, no se compone una cadena multinivel. El cliente debe presentar la cadena completa en el handshake mTLS. Un certificado revocado aborta el reenroll con `certificate is revoked`.",{"_7897":1173,"_22053":926,"_18699":35223,"_5":22203,"_15048":34578,"_1570":35224},[],"El endpoint `POST /.well-known/est/{aps}/serverkeygen` permite que Lamassu genere el par de claves del dispositivo en el servidor y devuelva, en la misma respuesta, la clave privada y el certificado emitido. Es útil para dispositivos con capacidad criptográfica limitada o flujos donde la clave se aprovisiona durante la fabricación.",{"_7897":1174,"_22053":926,"_18699":35226,"_5":22203,"_15048":34578,"_1570":35227},[],"Este endpoint requiere que `ServerKeyGen.Enabled` valga `true` en el DMS. Si no está activado, el servidor responde con `server key generation not enabled`. La autenticación se aplica igual que en `/simpleenroll`: el integrador presenta la credencial que corresponda al `AuthMode` del DMS.",{"_7897":1175,"_22053":926,"_18699":35229,"_5":22203,"_15048":34578,"_1570":35230},[],"El algoritmo y el tamaño de la clave generada se deciden por el DMS, no por el cliente.",{"_7897":1176,"_22053":926,"_18699":35232,"_5":22203,"_15048":34578,"_1570":35233},[],"Tipo de clave",{"_7897":1177,"_22053":926,"_18699":35235,"_5":22203,"_15048":34578,"_1570":35236},[],"Parámetro válido",{"_7897":1178,"_22053":926,"_18699":35238,"_5":22203,"_15048":34578,"_1570":35239},[],"Curva NIST equivalente",{"_7897":1179,"_22053":926,"_18699":35241,"_5":22203,"_15048":34578,"_1570":35242},[],"Comportamiento ante valores no válidos",{"_7897":1180,"_22053":926,"_18699":35244,"_5":22203,"_15048":34578,"_1570":35245},[],"`RSA`",{"_7897":1181,"_22053":926,"_18699":35247,"_5":22203,"_15048":34578,"_1570":35248},[],"Cualquier número de bits aceptado por `crypto/rsa` (típico: 2048, 3072, 4096)",{"_7897":1182,"_22053":926,"_18699":35250,"_5":22203,"_15048":34578,"_1570":35251},[],"No aplica",{"_7897":1183,"_22053":926,"_18699":35253,"_5":22203,"_15048":34578,"_1570":35254},[],"Si el valor no es válido para RSA, la generación falla y devuelve `500`.",{"_7897":1184,"_22053":926,"_18699":35256,"_5":22203,"_15048":34578,"_1570":35257},[],"`ECDSA`",{"_7897":1185,"_22053":926,"_18699":35259,"_5":22203,"_15048":34578,"_1570":35260},[],"224, 256, 384, 521",{"_7897":1186,"_22053":926,"_18699":35262,"_5":22203,"_15048":34578,"_1570":35263},[],"P-224 / P-256 (prime256v1) / P-384 / P-521",{"_7897":1187,"_22053":926,"_18699":35265,"_5":22203,"_15048":34578,"_1570":35266},[],"Cualquier otro valor degrada **silenciosamente** a P-256, solo con un aviso en log (`invalid key size of N for ECDSA. Defaulting to 256 curve`). El cliente no recibe error: el certificado se emite con una curva distinta de la solicitada.",{"_7897":1188,"_22053":926,"_18699":35268,"_5":22203,"_15048":34578,"_1570":35269},[],"El CSR enviado por el cliente sirve únicamente para transportar el subject y las extensiones; la prueba de posesión PKCS#10 no aplica aquí porque el cliente no es quien generó la clave. Lamassu descarta la clave pública del CSR original, genera un par de claves nuevo con su entropía interna, en motor software y no en un Crypto Engine de hardware como AWS KMS o PKCS#11, construye un CSR nuevo con esa clave y procede a una inscripción interna equivalente a `/simpleenroll`.",{"_7897":1189,"_22053":926,"_18699":35271,"_5":22203,"_15048":34578,"_1570":35272},[],"La respuesta es un `multipart/mixed` con el boundary literal `estServerLamassuBoundary`. Contiene dos partes:",{"_7897":1190,"_22053":926,"_18699":35274,"_5":22203,"_15048":34578,"_1570":35275},[],"La clave privada en formato **PKCS#8 sin cifrar**, codificada en base64 dentro de una parte con `Content-Type: application/pkcs8`.",{"_7897":1191,"_22053":926,"_18699":35277,"_5":22203,"_15048":34578,"_1570":35278},[],"El certificado emitido en PKCS#7 *degenerate* base64, dentro de una parte con `Content-Type: application/pkcs7-mime; smime-type=certs-only`.",{"_7897":1192,"_22053":926,"_18699":35280,"_5":22203,"_15048":34578,"_1570":35281},[],"A diferencia de `/cacerts` y `/simpleenroll`, donde el base64 va troceado en líneas de 76 caracteres, cada parte de `/serverkeygen` viaja como **una única línea base64 sin saltos**. Cualquier proxy inverso que reescriba el cuerpo (por ejemplo, normalizando line endings) puede romper el parseo.",{"_7897":1193,"_22053":926,"_18699":35283,"_5":22203,"_15048":34578,"_1570":35284},[],"Este endpoint invierte el principio PKI por el que el subscriber controla su clave privada. La clave se serializa en PKCS#8 sin cifrar (`PrivateKeyInfo`, sin `EncryptedPrivateKeyInfo`). No se aplica el envoltorio CMS `EnvelopedData` contemplado en RFC 7030 §4.4.2; no se aplica AES key wrap ni cifrado simétrico por contraseña. La única protección es el TLS del canal. El integrador debe garantizar que: (a) ningún proxy inverso termine TLS y registre el cuerpo de la respuesta; (b) la clave se cifre en reposo inmediatamente tras recibirla; (c) la cuenta de auditoría en el servidor Lamassu queda como punto único de origen de la clave.",{"_7897":1194,"_22053":926,"_18699":35286,"_5":22203,"_15048":34578,"_1570":35287},[],"Para separar las dos partes, el siguiente fragmento usa `awk` con el boundary literal. Funciona con la estructura exacta de Lamassu (cada parte = headers + línea en blanco + una sola línea base64); cualquier proxy intermedio que reescriba el cuerpo lo romperá.",{"_7897":1195,"_22053":926,"_18699":35289,"_5":22203,"_15048":34582,"_1570":35290},[],"Una vez revisados los endpoints por separado, estos ejemplos muestran cómo encadenarlos en dos escenarios habituales: el alta inicial de un dispositivo y la renovación de un certificado ya emitido.",{"_7897":1196,"_22053":926,"_18699":35292,"_5":22203,"_15048":34586,"_1570":35293},[],"El siguiente script ilustra el proceso completo de inscripción de un dispositivo con clave EC P-256 generada localmente y autenticación mTLS contra un certificado bootstrap.",{"_7897":1197,"_22053":926,"_18699":35295,"_5":22203,"_15048":34590,"_1570":35296},[],"El siguiente script reproduce un proceso de renovación: detecta la expiración del certificado actual, regenera el CSR con el **mismo subject** y se autentica con el certificado en vigor.",{"_7897":1198,"_22053":926,"_18699":35298,"_5":22203,"_15048":34594,"_1570":35299},[],"Una vez que el dispositivo ha obtenido su certificado de identidad, los pasos habituales son:",{"_7897":1199,"_22053":926,"_18699":35301,"_5":22203,"_15048":34594,"_1570":35302},[],"**Instalar la cadena de confianza** (`cacerts.pem`) en el almacén de confianza del dispositivo. El broker MQTT, el servidor HTTPS o cualquier relying party que valide mTLS necesitará esta cadena.",{"_7897":1200,"_22053":926,"_18699":35304,"_5":22203,"_15048":34594,"_1570":35305},[],"**Combinar el certificado de hoja con la cadena** antes de presentarlo en conexiones mTLS. La respuesta de `/simpleenroll` contiene solo el certificado de hoja; el relying party puede rechazar la conexión si no recibe la cadena completa.",{"_7897":1201,"_22053":926,"_18699":35307,"_5":22203,"_15048":34594,"_1570":35308},[],"**Planificar la renovación**: configurar en el dispositivo un temporizador que invoque `/simplereenroll` dentro de la ventana `ReEnrollmentDelta` antes de la caducidad del certificado. No espere a que caduque salvo que `EnableExpiredRenewal` esté activo.",{"_7897":1202,"_22053":926,"_18699":35310,"_5":22203,"_15048":34602,"_1570":35311},[],"Lamassu mapea casi todos los errores de negocio a `500 Internal Server Error`, no a `4xx`. El código de estado HTTP no es suficiente para distinguir entre un error de red y un error de política. El integrador debe inspeccionar el campo `err` del cuerpo JSON (`{\"err\": \"<mensaje>\"}`) para determinar la causa exacta del fallo.",{"_7897":1203,"_22053":926,"_18699":35313,"_5":22203,"_15048":34602,"_1570":35314},[],"HTTP",{"_7897":1204,"_22053":926,"_18699":35316,"_5":22203,"_15048":34602,"_1570":35317},[],"Mensaje",{"_7897":1205,"_22053":926,"_18699":35319,"_5":22203,"_15048":34602,"_1570":35320},[],"Causa",{"_7897":1206,"_22053":926,"_18699":35322,"_5":22203,"_15048":34602,"_1570":35323},[],"Acción del integrador",{"_7897":1207,"_22053":926,"_18699":35325,"_5":22203,"_15048":34602,"_1570":19514},[],{"_7897":1208,"_22053":926,"_18699":35327,"_5":22203,"_15048":34602,"_1570":35328},[],"`Field validation for 'APS' failed`",{"_7897":1209,"_22053":926,"_18699":35330,"_5":22203,"_15048":34602,"_1570":35331},[],"El segmento `{aps}` falta en la URL.",{"_7897":1210,"_22053":926,"_18699":35333,"_5":22203,"_15048":34602,"_1570":35334},[],"Incluir el ID del DMS en la ruta.",{"_7897":1211,"_22053":926,"_18699":35336,"_5":22203,"_15048":34602,"_1570":19514},[],{"_7897":1212,"_22053":926,"_18699":35338,"_5":22203,"_15048":34602,"_1570":35339},[],"`content-type must be application/pkcs10`",{"_7897":1213,"_22053":926,"_18699":35341,"_5":22203,"_15048":34602,"_1570":35342},[],"Cabecera `Content-Type` ausente o incorrecta.",{"_7897":1214,"_22053":926,"_18699":35344,"_5":22203,"_15048":34602,"_1570":35345},[],"Fijar `Content-Type: application/pkcs10`.",{"_7897":1215,"_22053":926,"_18699":35347,"_5":22203,"_15048":34602,"_1570":19514},[],{"_7897":1216,"_22053":926,"_18699":35349,"_5":22203,"_15048":34602,"_1570":35350},[],"`body payload must be base64 encoded`",{"_7897":1217,"_22053":926,"_18699":35352,"_5":22203,"_15048":34602,"_1570":35353},[],"El cuerpo no es base64 válido.",{"_7897":1218,"_22053":926,"_18699":35355,"_5":22203,"_15048":34602,"_1570":35356},[],"Usar `base64 -w 0` para evitar saltos de línea.",{"_7897":1219,"_22053":926,"_18699":35358,"_5":22203,"_15048":34602,"_1570":20039},[],{"_7897":1220,"_22053":926,"_18699":35360,"_5":22203,"_15048":34602,"_1570":35361},[],"`DMS not found`",{"_7897":1221,"_22053":926,"_18699":35363,"_5":22203,"_15048":34602,"_1570":35364},[],"El valor `{aps}` no se corresponde con ningún DMS.",{"_7897":1222,"_22053":926,"_18699":35366,"_5":22203,"_15048":34602,"_1570":35367},[],"Verificar el identificador con el administrador PKI.",{"_7897":1223,"_22053":926,"_18699":35369,"_5":22203,"_15048":34602,"_1570":20039},[],{"_7897":1224,"_22053":926,"_18699":35371,"_5":22203,"_15048":34602,"_1570":35372},[],"`invalid certificate`",{"_7897":1225,"_22053":926,"_18699":35374,"_5":22203,"_15048":34602,"_1570":35375},[],"El certificado cliente no es válido contra `ValidationCAs`.",{"_7897":1226,"_22053":926,"_18699":35377,"_5":22203,"_15048":34602,"_1570":35378},[],"Comprobar la cadena del certificado bootstrap.",{"_7897":1227,"_22053":926,"_18699":35380,"_5":22203,"_15048":34602,"_1570":20039},[],{"_7897":1228,"_22053":926,"_18699":35382,"_5":22203,"_15048":34602,"_1570":35383},[],"`certificate is revoked`",{"_7897":1229,"_22053":926,"_18699":35385,"_5":22203,"_15048":34602,"_1570":35386},[],"El certificado **presentado como credencial mTLS** está revocado en Lamassu o vía OCSP/CRL externos.",{"_7897":1230,"_22053":926,"_18699":35388,"_5":22203,"_15048":34602,"_1570":35389},[],"Solicitar un nuevo certificado bootstrap o investigar la revocación.",{"_7897":1231,"_22053":926,"_18699":35391,"_5":22203,"_15048":34602,"_1570":20039},[],{"_7897":1232,"_22053":926,"_18699":35393,"_5":22203,"_15048":34602,"_1570":35394},[],"`revoked certificate`",{"_7897":1233,"_22053":926,"_18699":35396,"_5":22203,"_15048":34602,"_1570":35397},[],"En reenroll, el certificado **activo del dispositivo en la base de datos** figura como revocado.",{"_7897":1234,"_22053":926,"_18699":35399,"_5":22203,"_15048":34602,"_1570":35400},[],"Revisar el estado del slot de identidad; si la revocación fue intencional, emitir un nuevo enroll en lugar de reenroll.",{"_7897":1235,"_22053":926,"_18699":35402,"_5":22203,"_15048":34602,"_1570":20039},[],{"_7897":1236,"_22053":926,"_18699":35404,"_5":22203,"_15048":34602,"_1570":35405},[],"`expired certificate`",{"_7897":1237,"_22053":926,"_18699":35407,"_5":22203,"_15048":34602,"_1570":35408},[],"El certificado presentado ha caducado y el DMS no permite `AllowExpired`/`EnableExpiredRenewal`.",{"_7897":1238,"_22053":926,"_18699":35410,"_5":22203,"_15048":34602,"_1570":35411},[],"Renovar antes de la caducidad o solicitar habilitar `EnableExpiredRenewal`.",{"_7897":1239,"_22053":926,"_18699":35413,"_5":22203,"_15048":34602,"_1570":20039},[],{"_7897":1240,"_22053":926,"_18699":35415,"_5":22203,"_15048":34602,"_1570":35416},[],"`forbiddenNewEnrollment`",{"_7897":1241,"_22053":926,"_18699":35418,"_5":22203,"_15048":34602,"_1570":35419},[],"El dispositivo ya está enrolado y `EnableReplaceableEnrollment` es `false`.",{"_7897":1242,"_22053":926,"_18699":35421,"_5":22203,"_15048":34602,"_1570":35422},[],"Usar `/simplereenroll` o pedir al administrador que habilite el flag.",{"_7897":1243,"_22053":926,"_18699":35424,"_5":22203,"_15048":34602,"_1570":20039},[],{"_7897":1244,"_22053":926,"_18699":35426,"_5":22203,"_15048":34602,"_1570":35427},[],"`device not preregistered`",{"_7897":1245,"_22053":926,"_18699":35429,"_5":22203,"_15048":34602,"_1570":35430},[],"El DMS está en `PRE_REGISTRATION` y el dispositivo no existe.",{"_7897":1246,"_22053":926,"_18699":35432,"_5":22203,"_15048":34602,"_1570":35433},[],"Registrar el dispositivo antes de inscribirlo.",{"_7897":1247,"_22053":926,"_18699":35435,"_5":22203,"_15048":34602,"_1570":20039},[],{"_7897":1248,"_22053":926,"_18699":35437,"_5":22203,"_15048":34602,"_1570":35438},[],"`invalid reenroll window`",{"_7897":1249,"_22053":926,"_18699":35440,"_5":22203,"_15048":34602,"_1570":35441},[],"Se intenta renovar antes de `NotAfter - ReEnrollmentDelta`.",{"_7897":1250,"_22053":926,"_18699":35443,"_5":22203,"_15048":34602,"_1570":35444},[],"Esperar a la apertura de la ventana o pedir un `ReEnrollmentDelta` mayor.",{"_7897":1251,"_22053":926,"_18699":35446,"_5":22203,"_15048":34602,"_1570":20039},[],{"_7897":1252,"_22053":926,"_18699":35448,"_5":22203,"_15048":34602,"_1570":35449},[],"`invalid RawSubject bytes`",{"_7897":1253,"_22053":926,"_18699":35451,"_5":22203,"_15048":34602,"_1570":35452},[],"El subject del CSR de renovación no coincide con el del certificado en vigor.",{"_7897":1254,"_22053":926,"_18699":35454,"_5":22203,"_15048":34602,"_1570":35455},[],"Regenerar el CSR con el subject exacto del cert anterior.",{"_7897":1255,"_22053":926,"_18699":35457,"_5":22203,"_15048":34602,"_1570":20039},[],{"_7897":1256,"_22053":926,"_18699":35459,"_5":22203,"_15048":34602,"_1570":35460},[],"`external webhook denied enrollment`",{"_7897":1257,"_22053":926,"_18699":35462,"_5":22203,"_15048":34602,"_1570":35463},[],"El webhook devolvió un código no `2xx` o `authorized != true`.",{"_7897":1258,"_22053":926,"_18699":35465,"_5":22203,"_15048":34602,"_1570":35466},[],"Revisar los logs del servicio webhook.",{"_7897":1259,"_22053":926,"_18699":35468,"_5":22203,"_15048":34602,"_1570":20039},[],{"_7897":1260,"_22053":926,"_18699":35470,"_5":22203,"_15048":34602,"_1570":35471},[],"`server key generation not enabled`",{"_7897":1261,"_22053":926,"_18699":35473,"_5":22203,"_15048":34602,"_1570":35474},[],"`/serverkeygen` está deshabilitado en el DMS.",{"_7897":1262,"_22053":926,"_18699":35476,"_5":22203,"_15048":34602,"_1570":35477},[],"Pedir al administrador activar `ServerKeyGen.Enabled`.",{"_7897":1263,"_22053":926,"_18699":35479,"_5":22203,"_15048":34602,"_1570":35480},[],"Para los mensajes que no figuren en esta tabla, los logs del servidor Lamassu (con los campos `func`, `dms`, `device-cn`, `step`, `auth-method`, `auth-status`) son el primer lugar donde buscar la causa.",{"_7897":1264,"_22053":926,"_18699":35482,"_5":22203,"_15048":34606,"_1570":35483},[],"La implementación de Lamassu se ajusta al RFC 7030 en lo esencial pero introduce varias particularidades que pueden afectar a clientes EST estrictos o a librerías de terceros:",{"_7897":1265,"_22053":926,"_18699":35485,"_5":22203,"_15048":34606,"_1570":35486},[],"Los endpoints `/csrattrs` y `/fullcmc` del RFC 7030 **no están implementados** en Lamassu. Un cliente que invoque `/.well-known/est/<DMS_ID>/csrattrs` recibirá `404 Not Found` en lugar del `204 No Content` que el RFC sugiere para \"sin atributos\". Las librerías EST estrictas deben configurarse para no intentar `csrattrs`.",{"_7897":1266,"_22053":926,"_18699":35488,"_5":22203,"_15048":34606,"_1570":35489},[],"El base64 de la respuesta de `/cacerts` y `/simpleenroll` se trocea en líneas de **76 caracteres** terminadas con CRLF (conforme con S/MIME, RFC 5751). Las partes de `/serverkeygen` no aplican wrap.",{"_7897":1267,"_22053":926,"_18699":35491,"_5":22203,"_15048":34606,"_1570":35492},[],"El boundary del `multipart/mixed` en `/serverkeygen` está fijado y no se puede negociar.",{"_7897":1268,"_22053":926,"_18699":35494,"_5":22203,"_15048":34606,"_1570":35495},[],"El segmento `{aps}` es **obligatorio** en todas las rutas EST. Las rutas registradas sin `{aps}` están en el código pero responden `400`.",{"_7897":1269,"_22053":926,"_18699":35497,"_5":22203,"_15048":34606,"_1570":35498},[],"El cuerpo de `/cacerts`, `/simpleenroll` y `/simplereenroll` puede devolverse como PEM concatenado si el cliente envía `Accept: application/x-pem-file`. Esta es una extensión específica de Lamassu y no aparece en el RFC.",{"_7897":1270,"_22053":926,"_18699":35500,"_5":22203,"_15048":34606,"_1570":35501},[],"El servidor no rechaza explícitamente CSRs firmados con SHA-1 o MD5; el integrador debe generar el CSR con SHA-256 o superior.",{"_7897":1271,"_22053":926,"_18699":35503,"_5":22203,"_15048":34606,"_1570":35504},[],"<Card title=\"Visión general del DMS\" href=\"/docs/manual/servicios-core/ra\" />",{"_7897":1272,"_22053":926,"_18699":35506,"_5":22203,"_15048":34606,"_1570":35507},[],"<Card title=\"Validación OCSP\" href=\"/docs/manual/servicios-core/validation-ocsp\" />",{"_7897":1273,"_22053":926,"_18699":35509,"_5":22203,"_15048":34606,"_1570":35510},[],"<Card title=\"Gestionar dispositivos\" href=\"/docs/manual/servicios-core/devices\" />",{"_7897":1274,"_22053":1274,"_5":22198,"_1570":35512,"_22211":35513,"_18699":35514,"_15048":1274},"[KMS] Gestión de Claves Criptográficas",[31714,32813,32822],[],{"_7897":1275,"_22053":1274,"_18699":35516,"_5":22203,"_15048":1274,"_1570":35517},[],"Gestión y operación de claves criptográficas en Lamassu IoT",{"_7897":1276,"_22053":1274,"_5":22208,"_18699":35519,"_15048":35520,"_1570":35521},[],"/docs/pr-preview/pr-22/manual/servicios-core/kms#gestión-de-claves-criptográficas","Gestión de claves criptográficas",{"_7897":1277,"_22053":1274,"_5":22208,"_18699":35523,"_15048":35524,"_1570":35525},[],"/docs/pr-preview/pr-22/manual/servicios-core/kms#qué-resuelve-el-kms","Qué resuelve el KMS",{"_7897":1278,"_22053":1274,"_5":22208,"_18699":35527,"_15048":35528,"_1570":35529},[],"/docs/pr-preview/pr-22/manual/servicios-core/kms#motores-criptográficos","Motores criptográficos",{"_7897":1279,"_22053":1274,"_5":22208,"_18699":35531,"_15048":35532,"_1570":35533},[],"/docs/pr-preview/pr-22/manual/servicios-core/kms#inventario-de-claves","Inventario de claves",{"_7897":1280,"_22053":1274,"_5":22208,"_18699":35535,"_15048":35536,"_1570":35537},[],"/docs/pr-preview/pr-22/manual/servicios-core/kms#crear-o-importar-claves","Crear o importar claves",{"_7897":1281,"_22053":1274,"_5":22208,"_18699":35539,"_15048":35540,"_1570":35541},[],"/docs/pr-preview/pr-22/manual/servicios-core/kms#generar-un-nuevo-par-de-claves","Generar un nuevo par de claves",{"_7897":1282,"_22053":1274,"_5":22208,"_18699":35543,"_15048":35544,"_1570":35545},[],"/docs/pr-preview/pr-22/manual/servicios-core/kms#importar-un-par-existente","Importar un par existente",{"_7897":1283,"_22053":1274,"_5":22208,"_18699":35547,"_15048":35548,"_1570":35549},[],"/docs/pr-preview/pr-22/manual/servicios-core/kms#operaciones-sobre-una-clave","Operaciones sobre una clave",{"_7897":1284,"_22053":1274,"_5":22208,"_18699":35551,"_15048":35552,"_1570":35553},[],"/docs/pr-preview/pr-22/manual/servicios-core/kms#ver-detalles","Ver detalles",{"_7897":1285,"_22053":1274,"_5":22208,"_18699":35555,"_15048":35556,"_1570":35557},[],"/docs/pr-preview/pr-22/manual/servicios-core/kms#firmar-y-verificar","Firmar y verificar",{"_7897":1286,"_22053":1274,"_5":22208,"_18699":35559,"_15048":35560,"_1570":35561},[],"/docs/pr-preview/pr-22/manual/servicios-core/kms#sign","Sign",{"_7897":1287,"_22053":1274,"_5":22208,"_18699":35563,"_15048":35564,"_1570":35565},[],"/docs/pr-preview/pr-22/manual/servicios-core/kms#verify","Verify",{"_7897":1288,"_22053":1274,"_5":22208,"_18699":35567,"_15048":35568,"_1570":35569},[],"/docs/pr-preview/pr-22/manual/servicios-core/kms#generar-un-csr","Generar un CSR",{"_7897":1289,"_22053":1274,"_5":22208,"_18699":35571,"_15048":35572,"_1570":35573},[],"/docs/pr-preview/pr-22/manual/servicios-core/kms#firma-local-con-pkcs11","Firma local con PKCS#11",{"_7897":1290,"_22053":1274,"_18699":35575,"_5":22203,"_15048":35520,"_1570":35576},[],"El servicio de Gestión de Claves Criptográficas (KMS) de Lamassu IoT centraliza la generación, importación, custodia y uso de las claves de la plataforma. Desde aquí se gestionan las claves que soportan a las CAs y al resto de operaciones de firma que dependen de la PKI.",{"_7897":1291,"_22053":1274,"_18699":35578,"_5":22203,"_15048":35520,"_1570":35579},[],"En la configuración actual, Lamassu IoT trabaja exclusivamente con claves asimétricas, como RSA y curvas elípticas. Estas claves se usan para emitir certificados X.509, firmar solicitudes y realizar operaciones de autenticación y validación dentro del sistema.",{"_7897":1292,"_22053":1274,"_18699":35581,"_5":22203,"_15048":35524,"_1570":35582},[],"El KMS unifica la gestión del ciclo de vida de las claves y evita que cada servicio tenga que integrarse directamente con un proveedor criptográfico concreto.",{"_7897":1293,"_22053":1274,"_18699":35584,"_5":22203,"_15048":35524,"_1570":35585},[],"En la práctica, permite:",{"_7897":1294,"_22053":1274,"_18699":35587,"_5":22203,"_15048":35524,"_1570":35588},[],"Generar nuevos pares de claves desde Lamassu IoT.",{"_7897":1295,"_22053":1274,"_18699":35590,"_5":22203,"_15048":35524,"_1570":35591},[],"Importar claves creadas externamente.",{"_7897":1296,"_22053":1274,"_18699":35593,"_5":22203,"_15048":35524,"_1570":35594},[],"Delegar la custodia y las operaciones criptográficas en motores externos.",{"_7897":1297,"_22053":1274,"_18699":35596,"_5":22203,"_15048":35524,"_1570":35597},[],"Reutilizar claves ya existentes para CAs, CSR y tareas de firma o verificación.",{"_7897":1298,"_22053":1274,"_18699":35599,"_5":22203,"_15048":35528,"_1570":35600},[],"Lamassu puede trabajar con distintos motores criptográficos según los requisitos del despliegue. En algunos entornos bastará con un motor software; en otros será necesario delegar la custodia en un HSM, en un servicio cloud o en una plataforma especializada.",{"_7897":1299,"_22053":1274,"_18699":35602,"_5":22203,"_15048":35528,"_1570":35603},[],"Una misma instancia puede tener varios motores configurados al mismo tiempo, incluso varias instancias del mismo tipo. Esto permite adaptar la operación a distintos niveles de seguridad, coste y requisitos regulatorios.",{"_7897":1300,"_22053":1274,"_18699":35605,"_5":22203,"_15048":35528,"_1570":35606},[],"Actualmente, Lamassu soporta los siguientes motores:",{"_7897":1301,"_22053":1274,"_18699":35608,"_5":22203,"_15048":35528,"_1570":35609},[],"Crypto Engine",{"_7897":1302,"_22053":1274,"_18699":35611,"_5":22203,"_15048":35528,"_1570":35612},[],"Nivel de seguridad",{"_7897":1303,"_22053":1274,"_18699":35614,"_5":22203,"_15048":35528,"_1570":35615},[],"OnPrem / Cloud",{"_7897":1304,"_22053":1274,"_18699":35617,"_5":22203,"_15048":35528,"_1570":35618},[],"Coste adicional",{"_7897":1305,"_22053":1274,"_18699":35620,"_5":22203,"_15048":35528,"_1570":35621},[],"Generación de claves",{"_7897":1306,"_22053":1274,"_18699":35623,"_5":22203,"_15048":35528,"_1570":35624},[],"Persistencia *at-rest* segura",{"_7897":1307,"_22053":1274,"_18699":35626,"_5":22203,"_15048":35528,"_1570":35627},[],"Filtración de claves",{"_7897":1308,"_22053":1274,"_18699":35629,"_5":22203,"_15048":35528,"_1570":35630},[],"Consideraciones",{"_7897":1309,"_22053":1274,"_18699":35632,"_5":22203,"_15048":35528,"_1570":35633},[],"File System",{"_7897":1310,"_22053":1274,"_18699":35635,"_5":22203,"_15048":35528,"_1570":11217},[],{"_7897":1311,"_22053":1274,"_18699":35637,"_5":22203,"_15048":35528,"_1570":35638},[],"OnPrem y Cloud",{"_7897":1312,"_22053":1274,"_18699":35640,"_5":22203,"_15048":35528,"_1570":33113},[],{"_7897":1313,"_22053":1274,"_18699":35642,"_5":22203,"_15048":35528,"_1570":35643},[],"**Entropía software**. La generación se realiza con las librerías criptográficas de Go.",{"_7897":1314,"_22053":1274,"_18699":35645,"_5":22203,"_15048":35528,"_1570":35646},[],"**Insegura**. Delegada en el sistema de archivos.",{"_7897":1315,"_22053":1274,"_18699":35648,"_5":22203,"_15048":35528,"_1570":35646},[],{"_7897":1316,"_22053":1274,"_18699":35650,"_5":22203,"_15048":35528,"_1570":35651},[],"No recomendado para producción.",{"_7897":1317,"_22053":1274,"_18699":35653,"_5":22203,"_15048":35528,"_1570":35654},[],"HashiCorp Vault",{"_7897":1318,"_22053":1274,"_18699":35656,"_5":22203,"_15048":35528,"_1570":3999},[],{"_7897":1319,"_22053":1274,"_18699":35658,"_5":22203,"_15048":35528,"_1570":35638},[],{"_7897":1320,"_22053":1274,"_18699":35660,"_5":22203,"_15048":35528,"_1570":33113},[],{"_7897":1321,"_22053":1274,"_18699":35662,"_5":22203,"_15048":35528,"_1570":35663},[],"Depende de la configuración de Vault.",{"_7897":1322,"_22053":1274,"_18699":35665,"_5":22203,"_15048":35528,"_1570":35666},[],"**Segura**",{"_7897":1323,"_22053":1274,"_18699":35668,"_5":22203,"_15048":35528,"_1570":35669},[],"**Insegura**. Un administrador con permisos suficientes puede visualizar la clave privada.",{"_7897":1324,"_22053":1274,"_18699":35671,"_5":22203,"_15048":35528,"_1570":35672},[],"Conviene limitar al máximo el acceso administrativo y custodiar correctamente las claves de *unseal*.",{"_7897":1325,"_22053":1274,"_18699":35674,"_5":22203,"_15048":35528,"_1570":35675},[],"AWS Secrets Manager",{"_7897":1326,"_22053":1274,"_18699":35677,"_5":22203,"_15048":35528,"_1570":3999},[],{"_7897":1327,"_22053":1274,"_18699":35679,"_5":22203,"_15048":35528,"_1570":35680},[],"Cloud",{"_7897":1328,"_22053":1274,"_18699":35682,"_5":22203,"_15048":35528,"_1570":33061},[],{"_7897":1329,"_22053":1274,"_18699":35684,"_5":22203,"_15048":35528,"_1570":35685},[],"Depende del proceso de alta de la clave.",{"_7897":1330,"_22053":1274,"_18699":35687,"_5":22203,"_15048":35528,"_1570":35666},[],{"_7897":1331,"_22053":1274,"_18699":35689,"_5":22203,"_15048":35528,"_1570":35669},[],{"_7897":1332,"_22053":1274,"_18699":35691,"_5":22203,"_15048":35528,"_1570":35692},[],"La protección *at-rest* la proporciona AWS, pero no evita el acceso administrativo al material privado.",{"_7897":1333,"_22053":1274,"_18699":35694,"_5":22203,"_15048":35528,"_1570":35695},[],"AWS KMS",{"_7897":1334,"_22053":1274,"_18699":35697,"_5":22203,"_15048":35528,"_1570":13329},[],{"_7897":1335,"_22053":1274,"_18699":35699,"_5":22203,"_15048":35528,"_1570":35680},[],{"_7897":1336,"_22053":1274,"_18699":35701,"_5":22203,"_15048":35528,"_1570":33061},[],{"_7897":1337,"_22053":1274,"_18699":35703,"_5":22203,"_15048":35528,"_1570":35704},[],"**Entropía hardware**",{"_7897":1338,"_22053":1274,"_18699":35706,"_5":22203,"_15048":35528,"_1570":35666},[],{"_7897":1339,"_22053":1274,"_18699":35708,"_5":22203,"_15048":35528,"_1570":35666},[],{"_7897":1340,"_22053":1274,"_18699":35710,"_5":22203,"_15048":35528,"_1570":35711},[],"Aunque la clave privada no se expone, un actor con permisos suficientes podría usarla para firmar artefactos.",{"_7897":1341,"_22053":1274,"_18699":35713,"_5":22203,"_15048":35528,"_1570":35714},[],"PKCS11",{"_7897":1342,"_22053":1274,"_18699":35716,"_5":22203,"_15048":35528,"_1570":35717},[],"3\\*",{"_7897":1343,"_22053":1274,"_18699":35719,"_5":22203,"_15048":35528,"_1570":35720},[],"AirGap OnPrem y Cloud",{"_7897":1344,"_22053":1274,"_18699":35722,"_5":22203,"_15048":35528,"_1570":35723},[],"Depende del hardware o del servicio usado. Puede integrarse con HSMs OnPrem o con ofertas Key as a Service.",{"_7897":1345,"_22053":1274,"_18699":35725,"_5":22203,"_15048":35528,"_1570":35704},[],{"_7897":1346,"_22053":1274,"_18699":35727,"_5":22203,"_15048":35528,"_1570":35728},[],"**Segura**\\*",{"_7897":1347,"_22053":1274,"_18699":35730,"_5":22203,"_15048":35528,"_1570":35731},[],"Depende del HSM",{"_7897":1348,"_22053":1274,"_18699":35733,"_5":22203,"_15048":35528,"_1570":35734},[],"El nivel real depende de la implementación PKCS11 y del HSM utilizado.",{"_7897":1349,"_22053":1274,"_18699":35736,"_5":22203,"_15048":35528,"_1570":35737},[],"Lamassu muestra en la consola el listado completo de motores habilitados.",{"_7897":1350,"_22053":1274,"_18699":35739,"_5":22203,"_15048":35528,"_1570":35740},[],"Cada motor define qué algoritmos soporta, como RSA o ECC/ECDSA, y qué tamaños de clave puede generar.",{"_7897":1351,"_22053":1274,"_18699":35742,"_5":22203,"_15048":35528,"_1570":35743},[],"Durante el despliegue es obligatorio definir un motor por defecto. Ese motor se utilizará cuando un proceso necesite crear o persistir una clave y el usuario no haya seleccionado uno específico, por ejemplo al crear o importar una CA.",{"_7897":1352,"_22053":1274,"_18699":35745,"_5":22203,"_15048":35532,"_1570":35746},[],"La pantalla principal de KMS muestra el inventario completo de claves registradas en el sistema. Es la vista de referencia para revisar qué claves existen, dónde están custodiadas y con qué entidades están relacionadas.",{"_7897":1353,"_22053":1274,"_18699":35748,"_5":22203,"_15048":35532,"_1570":35749},[],"La tabla incluye los siguientes campos:",{"_7897":1354,"_22053":1274,"_18699":35751,"_5":22203,"_15048":35532,"_1570":35752},[],"**Name**: nombre descriptivo de la clave.",{"_7897":1355,"_22053":1274,"_18699":35754,"_5":22203,"_15048":35532,"_1570":35755},[],"**Type**: algoritmo y tamaño de clave, por ejemplo RSA 2048 o EC P-256.",{"_7897":1356,"_22053":1274,"_18699":35757,"_5":22203,"_15048":35532,"_1570":35758},[],"**Strength**: indicador visual de fortaleza criptográfica.",{"_7897":1357,"_22053":1274,"_18699":35760,"_5":22203,"_15048":35532,"_1570":35761},[],"**Public/Private**: indica si Lamassu gestiona el par completo o solo la clave pública.",{"_7897":1358,"_22053":1274,"_18699":35763,"_5":22203,"_15048":35532,"_1570":35764},[],"**Crypto Engine**: motor criptográfico que custodia la clave.",{"_7897":1359,"_22053":1274,"_18699":35766,"_5":22203,"_15048":35532,"_1570":35767},[],"**Aliases**: nombres alternativos asociados a la clave.",{"_7897":1360,"_22053":1274,"_18699":35769,"_5":22203,"_15048":35532,"_1570":35770},[],"**Tags**: etiquetas para clasificación y búsqueda.",{"_7897":1361,"_22053":1274,"_18699":35772,"_5":22203,"_15048":35532,"_1570":35773},[],"**Related Entities**: certificados u otras entidades vinculadas a esa clave.",{"_7897":1362,"_22053":1274,"_18699":35775,"_5":22203,"_15048":35532,"_1570":35776},[],"Desde esta vista también se accede a las acciones más habituales:",{"_7897":1363,"_22053":1274,"_18699":35778,"_5":22203,"_15048":35532,"_1570":35779},[],"**View Details** para consultar metadatos, identificadores y relaciones.",{"_7897":1364,"_22053":1274,"_18699":35781,"_5":22203,"_15048":35532,"_1570":35782},[],"**Generate CSR** para crear una solicitud PKCS#10 con la clave seleccionada.",{"_7897":1365,"_22053":1274,"_18699":35784,"_5":22203,"_15048":35532,"_1570":35785},[],"**Sign / Verify** para probar operaciones criptográficas sobre la clave.",{"_7897":1366,"_22053":1274,"_18699":35787,"_5":22203,"_15048":35532,"_1570":35788},[],"**Delete Key** para eliminar la clave del sistema.",{"_7897":1367,"_22053":1274,"_18699":35790,"_5":22203,"_15048":35536,"_1570":35791},[],"El alta de claves se realiza desde el asistente que se abre con **Create New Key**.",{"_7897":1368,"_22053":1274,"_18699":35793,"_5":22203,"_15048":35540,"_1570":35794},[],"Si la clave va a nacer dentro de Lamassu, el flujo recomendado es generar un nuevo par gestionado directamente por uno de los motores configurados.",{"_7897":1369,"_22053":1274,"_18699":35796,"_5":22203,"_15048":35540,"_1570":35797},[],"En la primera pantalla del asistente, elija **Generate New Key Pair** y después defina los parámetros principales:",{"_7897":1370,"_22053":1274,"_18699":35799,"_5":22203,"_15048":35540,"_1570":35800},[],"**Key Name**: nombre único y descriptivo.",{"_7897":1371,"_22053":1274,"_18699":35802,"_5":22203,"_15048":35540,"_1570":35803},[],"**Crypto Engine**: motor que custodiará la clave.",{"_7897":1372,"_22053":1274,"_18699":35805,"_5":22203,"_15048":35540,"_1570":35806},[],"**Key Type** y **Key Size**: algoritmo y tamaño o curva.",{"_7897":1373,"_22053":1274,"_18699":35808,"_5":22203,"_15048":35540,"_1570":35809},[],"**Tags**: metadatos para clasificar la clave.",{"_7897":1374,"_22053":1274,"_18699":35811,"_5":22203,"_15048":35540,"_1570":35812},[],"**Metadata**: información adicional para usos avanzados.",{"_7897":1375,"_22053":1274,"_18699":35814,"_5":22203,"_15048":35544,"_1570":35815},[],"La importación permite registrar en Lamassu una clave generada fuera de la plataforma. Es el flujo habitual en escenarios BYOK, migraciones o integración con material criptográfico que ya está en producción.",{"_7897":1376,"_22053":1274,"_18699":35817,"_5":22203,"_15048":35544,"_1570":35818},[],"Cuando la clave se ha generado en un entorno aislado o en un HSM externo.",{"_7897":1377,"_22053":1274,"_18699":35820,"_5":22203,"_15048":35544,"_1570":35821},[],"Cuando se necesita migrar una PKI existente sin reemitir certificados.",{"_7897":1378,"_22053":1274,"_18699":35823,"_5":22203,"_15048":35544,"_1570":35824},[],"Cuando Lamassu debe operar con una raíz de confianza creada por un tercero.",{"_7897":1379,"_22053":1274,"_18699":35826,"_5":22203,"_15048":35544,"_1570":35827},[],"En el asistente, elija **Import Existing Key Pair** y complete los campos solicitados:",{"_7897":1380,"_22053":1274,"_18699":35829,"_5":22203,"_15048":35544,"_1570":35830},[],"**Key Name**: nombre descriptivo dentro de Lamassu IoT.",{"_7897":1381,"_22053":1274,"_18699":35832,"_5":22203,"_15048":35544,"_1570":35833},[],"**Crypto Engine**: motor que custodiará la clave importada.",{"_7897":1382,"_22053":1274,"_18699":35835,"_5":22203,"_15048":35544,"_1570":35836},[],"**Tags**: etiquetas para organización y búsqueda.",{"_7897":1383,"_22053":1274,"_18699":35838,"_5":22203,"_15048":35544,"_1570":35839},[],"**Metadata**: información adicional opcional.",{"_7897":1384,"_22053":1274,"_18699":35841,"_5":22203,"_15048":35544,"_1570":35842},[],"**Private Key (PEM)**: clave privada en formato PEM.",{"_7897":1385,"_22053":1274,"_18699":35844,"_5":22203,"_15048":35544,"_1570":35845},[],"Una vez completado el asistente, la clave queda almacenada en el motor seleccionado y puede utilizarse para firma, generación de CSR y el resto de operaciones soportadas por KMS.",{"_7897":1386,"_22053":1274,"_18699":35847,"_5":22203,"_15048":35548,"_1570":35848},[],"Cada clave registrada dispone de una vista de detalle y de varias acciones operativas.",{"_7897":1387,"_22053":1274,"_18699":35850,"_5":22203,"_15048":35552,"_1570":35851},[],"La pantalla **View Details** concentra la información técnica y administrativa de la clave.",{"_7897":1388,"_22053":1274,"_18699":35853,"_5":22203,"_15048":35552,"_1570":35854},[],"En la pestaña **Overview** se muestran, entre otros, estos campos:",{"_7897":1389,"_22053":1274,"_18699":35856,"_5":22203,"_15048":35552,"_1570":35857},[],"**Key Name**: nombre descriptivo.",{"_7897":1390,"_22053":1274,"_18699":35859,"_5":22203,"_15048":35552,"_1570":35860},[],"**Key Identifier**: identificador único del sistema. Lamassu utiliza formatos de ID basados en PKCS11.",{"_7897":1391,"_22053":1274,"_18699":35862,"_5":22203,"_15048":35552,"_1570":35863},[],"**Tags**: etiquetas asociadas.",{"_7897":1392,"_22053":1274,"_18699":35865,"_5":22203,"_15048":35552,"_1570":35866},[],"**Aliases**: nombres alternativos.",{"_7897":1393,"_22053":1274,"_18699":35868,"_5":22203,"_15048":35552,"_1570":35869},[],"**Crypto Engine**: motor en el que reside la clave.",{"_7897":1394,"_22053":1274,"_18699":35871,"_5":22203,"_15048":35552,"_1570":35872},[],"**Algorithm, Key Size & Strength**: algoritmo, parámetros y nivel de fortaleza.",{"_7897":1395,"_22053":1274,"_18699":35874,"_5":22203,"_15048":35552,"_1570":35875},[],"La sección **Related Entities** muestra qué objetos de Lamassu dependen de esa clave.",{"_7897":1396,"_22053":1274,"_18699":35877,"_5":22203,"_15048":35552,"_1570":35878},[],"La pestaña **Public Key** presenta la clave pública en formato PEM, lista para consulta o copia.",{"_7897":1397,"_22053":1274,"_18699":35880,"_5":22203,"_15048":35556,"_1570":35881},[],"La acción **Sign / Verify** sirve para validar que la clave y el motor criptográfico funcionan correctamente.",{"_7897":1398,"_22053":1274,"_18699":35883,"_5":22203,"_15048":35556,"_1570":35884},[],"Al abrirla aparecen dos áreas: **Sign** y **Verify**.",{"_7897":1399,"_22053":1274,"_18699":35886,"_5":22203,"_15048":35560,"_1570":35887},[],"Esta pestaña usa la clave privada para generar una firma digital sobre un mensaje o sobre un *digest* ya calculado.",{"_7897":1400,"_22053":1274,"_18699":35889,"_5":22203,"_15048":35560,"_1570":35890},[],"Campos principales:",{"_7897":1401,"_22053":1274,"_18699":35892,"_5":22203,"_15048":35560,"_1570":35893},[],"**Algorithm**: algoritmo de firma disponible para el tipo de clave.",{"_7897":1402,"_22053":1274,"_18699":35895,"_5":22203,"_15048":35560,"_1570":35896},[],"**Message Type**: `Raw` para datos en claro o `Digest` para un hash precalculado.",{"_7897":1403,"_22053":1274,"_18699":35898,"_5":22203,"_15048":35560,"_1570":35899},[],"**Payload Encoding**: codificación de entrada, como UTF-8, Hex o Base64.",{"_7897":1404,"_22053":1274,"_18699":35901,"_5":22203,"_15048":35560,"_1570":35902},[],"**Message**: contenido que se va a firmar.",{"_7897":1405,"_22053":1274,"_18699":35904,"_5":22203,"_15048":35560,"_1570":35905},[],"**Signature**: resultado de la operación, mostrado en hexadecimal.",{"_7897":1406,"_22053":1274,"_18699":35907,"_5":22203,"_15048":35564,"_1570":35908},[],"Esta pestaña comprueba si una firma corresponde a la clave pública asociada.",{"_7897":1407,"_22053":1274,"_18699":35910,"_5":22203,"_15048":35564,"_1570":35890},[],{"_7897":1408,"_22053":1274,"_18699":35912,"_5":22203,"_15048":35564,"_1570":35913},[],"**Algorithm**: debe coincidir con el algoritmo usado para la firma.",{"_7897":1409,"_22053":1274,"_18699":35915,"_5":22203,"_15048":35564,"_1570":35916},[],"**Message Type**: `Raw` o `Digest`.",{"_7897":1410,"_22053":1274,"_18699":35918,"_5":22203,"_15048":35564,"_1570":35919},[],"**Payload Encoding**: codificación del mensaje.",{"_7897":1411,"_22053":1274,"_18699":35921,"_5":22203,"_15048":35564,"_1570":35922},[],"**Message**: mensaje original o hash.",{"_7897":1412,"_22053":1274,"_18699":35924,"_5":22203,"_15048":35564,"_1570":35925},[],"**Signature**: firma que se desea comprobar.",{"_7897":1413,"_22053":1274,"_18699":35927,"_5":22203,"_15048":35564,"_1570":35928},[],"**Result**: indicador del resultado de la validación.",{"_7897":1414,"_22053":1274,"_18699":35930,"_5":22203,"_15048":35568,"_1570":35931},[],"La acción **Generate CSR** crea una solicitud PKCS#10 firmada con la clave privada custodiada en Lamassu, sin exponerla fuera del motor criptográfico.",{"_7897":1415,"_22053":1274,"_18699":35933,"_5":22203,"_15048":35568,"_1570":35934},[],"Este flujo es útil para:",{"_7897":1416,"_22053":1274,"_18699":35936,"_5":22203,"_15048":35568,"_1570":35937},[],"Solicitar certificados a una CA externa.",{"_7897":1417,"_22053":1274,"_18699":35939,"_5":22203,"_15048":35568,"_1570":35940},[],"Renovar una identidad manteniendo la misma clave.",{"_7897":1418,"_22053":1274,"_18699":35942,"_5":22203,"_15048":35568,"_1570":35943},[],"Al abrir el formulario se solicitan los datos del sujeto y los atributos principales del certificado:",{"_7897":1419,"_22053":1274,"_18699":35945,"_5":22203,"_15048":35568,"_1570":35946},[],"**Common Name (CN)**: nombre principal de la identidad.",{"_7897":1420,"_22053":1274,"_18699":35948,"_5":22203,"_15048":35568,"_1570":35949},[],"**Organization (O)**: organización o empresa.",{"_7897":1421,"_22053":1274,"_18699":35951,"_5":22203,"_15048":35568,"_1570":35952},[],"**Organizational Unit (OU)**: departamento o unidad.",{"_7897":1422,"_22053":1274,"_18699":35954,"_5":22203,"_15048":35568,"_1570":35955},[],"**Country (C)**: código de país de dos letras.",{"_7897":1423,"_22053":1274,"_18699":35957,"_5":22203,"_15048":35568,"_1570":35958},[],"**State / Province (ST)**: estado o provincia.",{"_7897":1424,"_22053":1274,"_18699":35960,"_5":22203,"_15048":35568,"_1570":35961},[],"**Locality (L)**: ciudad o localidad.",{"_7897":1425,"_22053":1274,"_18699":35963,"_5":22203,"_15048":35568,"_1570":35964},[],"**Email Address**: correo de contacto.",{"_7897":1426,"_22053":1274,"_18699":35966,"_5":22203,"_15048":35568,"_1570":35967},[],"**Subject Alternative Names (SANs)**: nombres o identificadores alternativos, como DNS o IP.",{"_7897":1427,"_22053":1274,"_18699":35969,"_5":22203,"_15048":35568,"_1570":35970},[],"Una vez completado el formulario, Lamassu genera la CSR y la presenta para su descarga o copia.",{"_7897":1428,"_22053":1274,"_18699":35972,"_5":22203,"_15048":35572,"_1570":35973},[],"Lamassu también ofrece una ayuda específica para integraciones locales mediante **Sign locally with OpenSSL & PKCS11 tools**.",{"_7897":1429,"_22053":1274,"_18699":35975,"_5":22203,"_15048":35572,"_1570":35976},[],"Esta opción muestra los pasos necesarios para configurar el entorno local, cargar el módulo PKCS#11 y ejecutar firmas con herramientas como OpenSSL sin extraer la clave privada del entorno custodiado.",{"_7897":1430,"_22053":1430,"_5":22198,"_1570":35978,"_22211":35979,"_18699":35980,"_15048":1430},"[DMS] Device Management Service",[31714,32813,32822],[],{"_7897":1431,"_22053":1430,"_18699":35982,"_5":22203,"_15048":1430,"_1570":35983},[],"Visión general del Device Management Service en Lamassu IoT - concepto, panel de gestión y configuración común a todos los protocolos de enrolamiento.",{"_7897":1432,"_22053":1430,"_5":22208,"_18699":35985,"_15048":35986,"_1570":35987},[],"/docs/pr-preview/pr-22/manual/servicios-core/ra#device-management-service","Device Management Service",{"_7897":1433,"_22053":1430,"_5":22208,"_18699":35989,"_15048":35990,"_1570":34551},[],"/docs/pr-preview/pr-22/manual/servicios-core/ra#antes-de-empezar",{"_7897":1434,"_22053":1430,"_5":22208,"_18699":35992,"_15048":35993,"_1570":35994},[],"/docs/pr-preview/pr-22/manual/servicios-core/ra#panel-de-dms","Panel de DMS",{"_7897":1435,"_22053":1430,"_5":22208,"_18699":35996,"_15048":35997,"_1570":35998},[],"/docs/pr-preview/pr-22/manual/servicios-core/ra#distribución-de-entidades-de-confianza","Distribución de entidades de confianza",{"_7897":1436,"_22053":1430,"_5":22208,"_18699":36000,"_15048":36001,"_1570":36002},[],"/docs/pr-preview/pr-22/manual/servicios-core/ra#protocolos-de-enrolamiento","Protocolos de enrolamiento",{"_7897":1437,"_22053":1430,"_18699":36004,"_5":22203,"_15048":35986,"_1570":36005},[],"El &#x2A;*DMS (Device Management Service)** es el componente de Lamassu IoT que actúa como Autoridad de Registro (RA) frente a los dispositivos. Cada DMS recibe las solicitudes de certificado, valida la identidad del solicitante según las políticas configuradas y encarga la emisión a la CA asignada. El resultado es un canal de aprovisionamiento controlado e independiente por flota, línea de producto o entorno.",{"_7897":1438,"_22053":1430,"_18699":36007,"_5":22203,"_15048":35986,"_1570":36008},[],"En la práctica, cada DMS representa un punto de entrada diferenciado: tiene su propia CA de enrolamiento, sus propias reglas de autenticación y su propia ventana de renovación. Una organización puede operar varios DMS en paralelo - por ejemplo, uno para dispositivos de campo y otro para pasarelas internas - con políticas completamente distintas en cada caso.",{"_7897":1439,"_22053":1430,"_18699":36010,"_5":22203,"_15048":35990,"_1570":36011},[],"Para crear un DMS es necesario que exista al menos una CA activa en la plataforma, ya que el DMS requiere seleccionar una CA de enrolamiento. El usuario debe disponer del rol de administrador PKI o de permisos equivalentes sobre el módulo DMS.",{"_7897":1440,"_22053":1430,"_18699":36013,"_5":22203,"_15048":35993,"_1570":36014},[],"El panel lista todos los DMS configurados en la plataforma. Cada entrada muestra el nombre del DMS, el protocolo de enrolamiento activo y la CA de enrolamiento asignada. Desde el menú de opciones de cada DMS están disponibles las siguientes acciones:",{"_7897":1441,"_22053":1430,"_18699":36016,"_5":22203,"_15048":35993,"_1570":36017},[],"Acción",{"_7897":1442,"_22053":1430,"_18699":36019,"_5":22203,"_15048":35993,"_1570":31917},[],{"_7897":1443,"_22053":1430,"_18699":36021,"_5":22203,"_15048":35993,"_1570":36022},[],"**Edit**",{"_7897":1444,"_22053":1430,"_18699":36024,"_5":22203,"_15048":35993,"_1570":36025},[],"Modifica la configuración del DMS.",{"_7897":1445,"_22053":1430,"_18699":36027,"_5":22203,"_15048":35993,"_1570":36028},[],"**Go to DMS owned devices**",{"_7897":1446,"_22053":1430,"_18699":36030,"_5":22203,"_15048":35993,"_1570":36031},[],"Abre el listado de dispositivos gestionados por este DMS.",{"_7897":1447,"_22053":1430,"_18699":36033,"_5":22203,"_15048":35993,"_1570":36034},[],"**Show/Edit Metadata**",{"_7897":1448,"_22053":1430,"_18699":36036,"_5":22203,"_15048":35993,"_1570":36037},[],"Accede a los metadatos del DMS para usos avanzados.",{"_7897":1449,"_22053":1430,"_18699":36039,"_5":22203,"_15048":35993,"_1570":36040},[],"**EST (RFC-7030)**",{"_7897":1450,"_22053":1430,"_18699":36042,"_5":22203,"_15048":35993,"_1570":36043},[],"Muestra los endpoints EST del DMS con su URL base y ejemplos de invocación.",{"_7897":1451,"_22053":1430,"_18699":36045,"_5":22203,"_15048":35993,"_1570":36046},[],"**Delete**",{"_7897":1452,"_22053":1430,"_18699":36048,"_5":22203,"_15048":35993,"_1570":36049},[],"Elimina el DMS y su configuración. Acción irreversible.",{"_7897":1453,"_22053":1430,"_18699":36051,"_5":22203,"_15048":35997,"_1570":36052},[],"La sección **CA Distribution** controla qué certificados de CA recibe el dispositivo al consultar el endpoint de distribución de confianza del protocolo activo. Esta configuración es independiente del protocolo de enrolamiento: los parámetros tienen el mismo significado con independencia de cómo el dispositivo obtenga sus certificados.",{"_7897":1454,"_22053":1430,"_18699":36054,"_5":22203,"_15048":35997,"_1570":33045},[],{"_7897":1455,"_22053":1430,"_18699":36056,"_5":22203,"_15048":35997,"_1570":31917},[],{"_7897":1456,"_22053":1430,"_18699":36058,"_5":22203,"_15048":35997,"_1570":36059},[],"**Include Lamassu System CA**",{"_7897":1457,"_22053":1430,"_18699":36061,"_5":22203,"_15048":35997,"_1570":36062},[],"Incluye el certificado TLS del servidor Lamassu en la respuesta. Este es el certificado de extremo del servidor, no una CA - útil para *pinning* de la conexión.",{"_7897":1458,"_22053":1430,"_18699":36064,"_5":22203,"_15048":35997,"_1570":36065},[],"**Include Enrollment CA**",{"_7897":1459,"_22053":1430,"_18699":36067,"_5":22203,"_15048":35997,"_1570":36068},[],"Incluye la CA emisora configurada en este DMS, es decir, la que firmará los certificados de dispositivo.",{"_7897":1460,"_22053":1430,"_18699":36070,"_5":22203,"_15048":35997,"_1570":36071},[],"**Managed CAs**",{"_7897":1461,"_22053":1430,"_18699":36073,"_5":22203,"_15048":35997,"_1570":36074},[],"CAs adicionales distribuidas al dispositivo como anclas de confianza.",{"_7897":1462,"_22053":1430,"_18699":36076,"_5":22203,"_15048":36001,"_1570":36077},[],"El DMS expone un protocolo de enrolamiento a los dispositivos. En la versión actual de Lamassu, el único protocolo soportado es &#x2A;*EST (RFC 7030)**. La configuración del protocolo y la guía de integración para dispositivos se encuentran en las páginas correspondientes.",{"_7897":1463,"_22053":1430,"_18699":36079,"_5":22203,"_15048":36001,"_1570":36080},[],"<Card title=\"EST (RFC 7030)\" href=\"/docs/manual/servicios-core/est\" />",{"_7897":1464,"_22053":1430,"_18699":36082,"_5":22203,"_15048":36001,"_1570":35510},[],{"_7897":1465,"_22053":1465,"_5":22198,"_1570":36084,"_22211":36085,"_18699":36086,"_15048":1465},"[VA] Servicio CRL",[31714,32813,32822],[],{"_7897":1466,"_22053":1465,"_18699":36088,"_5":22203,"_15048":1465,"_1570":36089},[],"Gestión y consulta de listas de revocación para validación offline",{"_7897":1467,"_22053":1465,"_5":22208,"_18699":36091,"_15048":36092,"_1570":36093},[],"/docs/pr-preview/pr-22/manual/servicios-core/validation-crl#servicio-crl","Servicio CRL",{"_7897":1468,"_22053":1465,"_5":22208,"_18699":36095,"_15048":36096,"_1570":36097},[],"/docs/pr-preview/pr-22/manual/servicios-core/validation-crl#rol-va-y-configuración-por-ca","Rol VA y configuración por CA",{"_7897":1469,"_22053":1465,"_5":22208,"_18699":36099,"_15048":36100,"_1570":36101},[],"/docs/pr-preview/pr-22/manual/servicios-core/validation-crl#regeneración-periódica-y-automática","Regeneración periódica y automática",{"_7897":1470,"_22053":1465,"_5":22208,"_18699":36103,"_15048":36104,"_1570":36105},[],"/docs/pr-preview/pr-22/manual/servicios-core/validation-crl#contenido-de-la-crl","Contenido de la CRL",{"_7897":1471,"_22053":1465,"_5":22208,"_18699":36107,"_15048":36108,"_1570":36109},[],"/docs/pr-preview/pr-22/manual/servicios-core/validation-crl#endpoint-público-de-descarga","Endpoint público de descarga",{"_7897":1472,"_22053":1465,"_5":22208,"_18699":36111,"_15048":36112,"_1570":36113},[],"/docs/pr-preview/pr-22/manual/servicios-core/validation-crl#api-de-gestión-del-rol-va","API de gestión del rol VA",{"_7897":1473,"_22053":1465,"_5":22208,"_18699":36115,"_15048":36116,"_1570":36117},[],"/docs/pr-preview/pr-22/manual/servicios-core/validation-crl#desde-la-interfaz","Desde la interfaz",{"_7897":1474,"_22053":1465,"_5":22208,"_18699":36119,"_15048":36120,"_1570":36121},[],"/docs/pr-preview/pr-22/manual/servicios-core/validation-crl#referencias","Referencias",{"_7897":1475,"_22053":1465,"_18699":36123,"_5":22203,"_15048":36092,"_1570":36124},[],"Una CRL (*Certificate Revocation List*) es una lista firmada que contiene los números de serie de los certificados revocados antes de su fecha de caducidad. A diferencia de OCSP, no requiere una consulta en tiempo real: la parte que confía descarga la lista periódicamente y la consulta de forma local.",{"_7897":1476,"_22053":1465,"_18699":36126,"_5":22203,"_15048":36092,"_1570":36127},[],"Lamassu genera y mantiene una CRL por cada CA que gestiona. Cada CRL está firmada con la clave privada de la propia CA emisora y se almacena en el sistema de almacenamiento de objetos configurado en la plataforma.",{"_7897":1477,"_22053":1465,"_18699":36129,"_5":22203,"_15048":36096,"_1570":36130},[],"La publicación de la CRL de cada CA se controla mediante un *rol VA*. Este objeto define cómo se genera, cuándo se regenera y qué clave se utiliza para firmarla.",{"_7897":1478,"_22053":1465,"_18699":36132,"_5":22203,"_15048":36096,"_1570":36133},[],"Los parámetros principales son:",{"_7897":1479,"_22053":1465,"_18699":36135,"_5":22203,"_15048":36096,"_1570":33045},[],{"_7897":1480,"_22053":1465,"_18699":36137,"_5":22203,"_15048":36096,"_1570":31914},[],{"_7897":1481,"_22053":1465,"_18699":36139,"_5":22203,"_15048":36096,"_1570":31917},[],{"_7897":1482,"_22053":1465,"_18699":36141,"_5":22203,"_15048":36096,"_1570":36142},[],"`validity`",{"_7897":1483,"_22053":1465,"_18699":36144,"_5":22203,"_15048":36096,"_1570":36145},[],"7 días",{"_7897":1484,"_22053":1465,"_18699":36147,"_5":22203,"_15048":36096,"_1570":36148},[],"Período de validez de cada CRL emitida, reflejado en el campo `nextUpdate`.",{"_7897":1485,"_22053":1465,"_18699":36150,"_5":22203,"_15048":36096,"_1570":36151},[],"`refresh_interval`",{"_7897":1486,"_22053":1465,"_18699":36153,"_5":22203,"_15048":36096,"_1570":36154},[],"\\~6 días y 23 horas",{"_7897":1487,"_22053":1465,"_18699":36156,"_5":22203,"_15048":36096,"_1570":36157},[],"Intervalo mínimo entre regeneraciones periódicas programadas.",{"_7897":1488,"_22053":1465,"_18699":36159,"_5":22203,"_15048":36096,"_1570":36160},[],"`regenerate_on_revoke`",{"_7897":1489,"_22053":1465,"_18699":36162,"_5":22203,"_15048":36096,"_1570":36163},[],"`true`",{"_7897":1490,"_22053":1465,"_18699":36165,"_5":22203,"_15048":36096,"_1570":36166},[],"Cuando se revoca un certificado, se genera una nueva CRL de inmediato sin esperar al ciclo periódico.",{"_7897":1491,"_22053":1465,"_18699":36168,"_5":22203,"_15048":36096,"_1570":36169},[],"El campo `subject_key_id_signer` identifica la CA cuya clave privada firma la CRL. Por defecto, cada CA firma su propia CRL.",{"_7897":1492,"_22053":1465,"_18699":36171,"_5":22203,"_15048":36096,"_1570":36172},[],"Cada CRL lleva un número de versión incremental. Lamassu almacena todas las versiones en la ruta `pki/va/crl/{subject_key_id}/{version}.crl` del almacenamiento de objetos.",{"_7897":1493,"_22053":1465,"_18699":36174,"_5":22203,"_15048":36100,"_1570":36175},[],"Un proceso en segundo plano supervisa los roles VA activos. Cuando la validez restante de la CRL vigente cae por debajo del período de vigilancia configurado (*blind period*), el sistema solicita la generación de una nueva CRL. Así se evita que la CRL publicada caduque sin que exista una versión válida disponible.",{"_7897":1494,"_22053":1465,"_18699":36177,"_5":22203,"_15048":36100,"_1570":36178},[],"Además, cuando `regenerate_on_revoke` está activo, que es el comportamiento por defecto, cualquier revocación de un certificado desencadena inmediatamente la generación de una nueva CRL para la CA afectada. Esto reduce al mínimo el tiempo entre la revocación y su publicación.",{"_7897":1495,"_22053":1465,"_18699":36180,"_5":22203,"_15048":36104,"_1570":36181},[],"Cada entrada de la CRL incluye el número de serie del certificado revocado, la fecha de revocación y el código de razón conforme a RFC 5280.",{"_7897":1496,"_22053":1465,"_18699":36183,"_5":22203,"_15048":36104,"_1570":36184},[],"La CRL incluye también la extensión *Issuing Distribution Point* (IDP, OID 2.5.29.28), marcada como crítica, que indica la URL pública desde la que puede descargarse. Esa URL apunta al endpoint `/crl/{subject_key_id}` de cada dominio VA configurado.",{"_7897":1497,"_22053":1465,"_18699":36186,"_5":22203,"_15048":36108,"_1570":36187},[],"La CRL más reciente de una CA se puede obtener directamente sin autenticación:",{"_7897":1498,"_22053":1465,"_18699":36189,"_5":22203,"_15048":36108,"_1570":36190},[],"La respuesta tiene `Content-Type: application/pkix-crl` y contiene la CRL en formato DER.",{"_7897":1499,"_22053":1465,"_18699":36192,"_5":22203,"_15048":36112,"_1570":36193},[],"El rol VA de una CA se puede consultar y actualizar mediante la API:",{"_7897":1500,"_22053":1465,"_18699":36195,"_5":22203,"_15048":36112,"_1570":36196},[],"Método",{"_7897":1501,"_22053":1465,"_18699":36198,"_5":22203,"_15048":36112,"_1570":36199},[],"Ruta",{"_7897":1502,"_22053":1465,"_18699":36201,"_5":22203,"_15048":36112,"_1570":31917},[],{"_7897":1503,"_22053":1465,"_18699":36203,"_5":22203,"_15048":36112,"_1570":36204},[],"`GET`",{"_7897":1504,"_22053":1465,"_18699":36206,"_5":22203,"_15048":36112,"_1570":36207},[],"`/v1/roles/{ca-ski}`",{"_7897":1505,"_22053":1465,"_18699":36209,"_5":22203,"_15048":36112,"_1570":36210},[],"Devuelve la configuración del rol VA y los metadatos de la última CRL emitida.",{"_7897":1506,"_22053":1465,"_18699":36212,"_5":22203,"_15048":36112,"_1570":36213},[],"`PUT`",{"_7897":1507,"_22053":1465,"_18699":36215,"_5":22203,"_15048":36112,"_1570":36207},[],{"_7897":1508,"_22053":1465,"_18699":36217,"_5":22203,"_15048":36112,"_1570":36218},[],"Actualiza los parámetros de la configuración del rol VA (`validity`, `refresh_interval`, `regenerate_on_revoke`).",{"_7897":1509,"_22053":1465,"_18699":36220,"_5":22203,"_15048":36112,"_1570":36221},[],"Ejemplo de consulta del rol VA:",{"_7897":1510,"_22053":1465,"_18699":36223,"_5":22203,"_15048":36112,"_1570":36224},[],"La respuesta incluye el campo `latest_crl` con la versión, la fecha de inicio de validez y la fecha de caducidad de la CRL actualmente publicada.",{"_7897":1511,"_22053":1465,"_18699":36226,"_5":22203,"_15048":36116,"_1570":36227},[],"Desde el panel de detalle de una CA es posible previsualizar el contenido de la CRL activa y descargarla directamente para su uso offline o para importarla en aplicaciones que realicen validación local.",{"_7897":1512,"_22053":1465,"_18699":36229,"_5":22203,"_15048":36120,"_1570":36230},[],"RFC 5280 - *Internet X.509 Public Key Infrastructure Certificate and Certificate Revocation List (CRL) Profile*",{"_7897":1513,"_22053":1465,"_18699":36232,"_5":22203,"_15048":36120,"_1570":36233},[],"<Card title=\"Servicio OCSP\" href=\"/docs/manual/servicios-core/validation-ocsp\" />",{"_7897":1514,"_22053":1465,"_18699":36235,"_5":22203,"_15048":36120,"_1570":36236},[],"<Card title=\"Validación de certificados\" href=\"/docs/manual/servicios-core/validation\" />",{"_7897":1515,"_22053":1515,"_5":22198,"_1570":36238,"_22211":36239,"_18699":36240,"_15048":1515},"[VA] Servicio OCSP",[31714,32813,32822],[],{"_7897":1516,"_22053":1515,"_18699":36242,"_5":22203,"_15048":1515,"_1570":36243},[],"Validación online del estado de certificados mediante OCSP",{"_7897":1517,"_22053":1515,"_5":22208,"_18699":36245,"_15048":36246,"_1570":36247},[],"/docs/pr-preview/pr-22/manual/servicios-core/validation-ocsp#servicio-ocsp","Servicio OCSP",{"_7897":1518,"_22053":1515,"_5":22208,"_18699":36249,"_15048":36250,"_1570":36251},[],"/docs/pr-preview/pr-22/manual/servicios-core/validation-ocsp#cómo-funciona-el-respondedor-en-lamassu","Cómo funciona el respondedor en Lamassu",{"_7897":1519,"_22053":1515,"_5":22208,"_18699":36253,"_15048":36254,"_1570":36255},[],"/docs/pr-preview/pr-22/manual/servicios-core/validation-ocsp#enlace-en-los-certificados-emitidos","Enlace en los certificados emitidos",{"_7897":1520,"_22053":1515,"_5":22208,"_18699":36257,"_15048":36258,"_1570":36259},[],"/docs/pr-preview/pr-22/manual/servicios-core/validation-ocsp#endpoints-http","Endpoints HTTP",{"_7897":1521,"_22053":1515,"_5":22208,"_18699":36261,"_15048":36262,"_1570":36263},[],"/docs/pr-preview/pr-22/manual/servicios-core/validation-ocsp#comprobación-desde-la-interfaz","Comprobación desde la interfaz",{"_7897":1522,"_22053":1515,"_5":22208,"_18699":36265,"_15048":36266,"_1570":36121},[],"/docs/pr-preview/pr-22/manual/servicios-core/validation-ocsp#referencias",{"_7897":1523,"_22053":1515,"_18699":36268,"_5":22203,"_15048":36246,"_1570":36269},[],"OCSP (Online Certificate Status Protocol) es el mecanismo que permite a una parte que confía comprobar, en tiempo real, si un certificado concreto está vigente o ha sido revocado. En lugar de descargar una lista completa de certificados revocados, el cliente envía una consulta con el número de serie del certificado y recibe una respuesta firmada con el estado actual.",{"_7897":1524,"_22053":1515,"_18699":36271,"_5":22203,"_15048":36246,"_1570":36272},[],"Lamassu integra un respondedor OCSP propio que atiende estas consultas consultando directamente la base de datos interna de certificados. No se requiere ningún componente externo.",{"_7897":1525,"_22053":1515,"_18699":36274,"_5":22203,"_15048":36250,"_1570":36275},[],"Cuando un cliente solicita el estado de un certificado, el respondedor localiza el certificado por su número de serie y determina su estado según el registro interno:",{"_7897":1526,"_22053":1515,"_18699":36277,"_5":22203,"_15048":36250,"_1570":36278},[],"Si el certificado está activo, la respuesta indica `Good`.",{"_7897":1527,"_22053":1515,"_18699":36280,"_5":22203,"_15048":36250,"_1570":36281},[],"Si el certificado ha sido revocado, la respuesta indica `Revoked` e incluye la marca de tiempo de revocación y el código de razón conforme a RFC 5280.",{"_7897":1528,"_22053":1515,"_18699":36283,"_5":22203,"_15048":36250,"_1570":36284},[],"Si el número de serie no se encuentra o el estado no es reconocible, la respuesta indica `Unknown`.",{"_7897":1529,"_22053":1515,"_18699":36286,"_5":22203,"_15048":36250,"_1570":36287},[],"La respuesta OCSP es firmada por la CA emisora del certificado consultado, utilizando el motor criptográfico asociado a esa CA. Lamassu no utiliza un certificado delegado de firma OCSP: la CA actúa directamente como respondedor.",{"_7897":1530,"_22053":1515,"_18699":36289,"_5":22203,"_15048":36250,"_1570":36290},[],"Cada respuesta tiene una ventana de validez de 24 horas, reflejada en los campos `thisUpdate` y `nextUpdate` de la respuesta. Los clientes que cacheen respuestas deben tener en cuenta esta ventana al determinar durante cuánto tiempo una respuesta sigue siendo válida.",{"_7897":1531,"_22053":1515,"_18699":36292,"_5":22203,"_15048":36254,"_1570":36293},[],"La URL del respondedor OCSP se incorpora automáticamente en la extensión AIA (*Authority Information Access*) de todos los certificados emitidos por Lamassu. Los clientes que verifican certificados pueden leer esta URL directamente del certificado sin necesidad de configuración adicional.",{"_7897":1532,"_22053":1515,"_18699":36295,"_5":22203,"_15048":36258,"_1570":36296},[],"El respondedor acepta consultas en dos formatos, ambos definidos en RFC 6960:",{"_7897":1533,"_22053":1515,"_18699":36298,"_5":22203,"_15048":36258,"_1570":36196},[],{"_7897":1534,"_22053":1515,"_18699":36300,"_5":22203,"_15048":36258,"_1570":36199},[],{"_7897":1535,"_22053":1515,"_18699":36302,"_5":22203,"_15048":36258,"_1570":31917},[],{"_7897":1536,"_22053":1515,"_18699":36304,"_5":22203,"_15048":36258,"_1570":36204},[],{"_7897":1537,"_22053":1515,"_18699":36306,"_5":22203,"_15048":36258,"_1570":36307},[],"`/ocsp/{ocsp_request}`",{"_7897":1538,"_22053":1515,"_18699":36309,"_5":22203,"_15048":36258,"_1570":36310},[],"La petición OCSP va codificada en Base64url en la propia URL.",{"_7897":1539,"_22053":1515,"_18699":36312,"_5":22203,"_15048":36258,"_1570":36313},[],"`POST`",{"_7897":1540,"_22053":1515,"_18699":36315,"_5":22203,"_15048":36258,"_1570":36316},[],"`/ocsp`",{"_7897":1541,"_22053":1515,"_18699":36318,"_5":22203,"_15048":36258,"_1570":36319},[],"La petición OCSP va en el cuerpo de la petición con `Content-Type: application/ocsp-request`.",{"_7897":1542,"_22053":1515,"_18699":36321,"_5":22203,"_15048":36258,"_1570":36322},[],"Ejemplo de consulta con `curl` mediante POST:",{"_7897":1543,"_22053":1515,"_18699":36324,"_5":22203,"_15048":36258,"_1570":36325},[],"La respuesta tiene `Content-Type: application/ocsp-response` y contiene la respuesta OCSP en formato DER.",{"_7897":1544,"_22053":1515,"_18699":36327,"_5":22203,"_15048":36262,"_1570":36328},[],"Desde la pantalla de certificados de Lamassu es posible lanzar una petición OCSP directamente sobre el certificado seleccionado mediante la acción **OCSP Check**. Esta acción muestra el estado devuelto por el respondedor sin necesidad de herramientas externas.",{"_7897":1545,"_22053":1515,"_18699":36330,"_5":22203,"_15048":36266,"_1570":36331},[],"RFC 6960 - *X.509 Internet Public Key Infrastructure Online Certificate Status Protocol – OCSP*",{"_7897":1546,"_22053":1515,"_18699":36333,"_5":22203,"_15048":36266,"_1570":36334},[],"RFC 5280 - *Internet X.509 Public Key Infrastructure Certificate and Certificate Revocation List (CRL) Profile* (razones de revocación, sección 5.3.1)",{"_7897":1547,"_22053":1515,"_18699":36336,"_5":22203,"_15048":36266,"_1570":36337},[],"<Card title=\"Servicio CRL\" href=\"/docs/manual/servicios-core/validation-crl\" />",{"_7897":1548,"_22053":1515,"_18699":36339,"_5":22203,"_15048":36266,"_1570":36236},[],{"_7897":1549,"_22053":1549,"_5":22198,"_1570":36341,"_22211":36342,"_18699":36343,"_15048":1549},"[VA] Validación de Certificados",[31714,32813,32822],[],{"_7897":1550,"_22053":1549,"_18699":36345,"_5":22203,"_15048":1549,"_1570":36346},[],"Servicios OCSP y CRL para validación de certificados",{"_7897":1551,"_22053":1549,"_5":22208,"_18699":36348,"_15048":36349,"_1570":36350},[],"/docs/pr-preview/pr-22/manual/servicios-core/validation#validación-de-certificados--va","Validación de certificados – VA",{"_7897":1552,"_22053":1549,"_18699":36352,"_5":22203,"_15048":36349,"_1570":36353},[],"Lamassu ofrece dos mecanismos complementarios para validar el estado de los certificados emitidos por la plataforma:",{"_7897":1553,"_22053":1549,"_18699":36355,"_5":22203,"_15048":36349,"_1570":36356},[],"`OCSP`, para consultas online y en tiempo real del estado del certificado.",{"_7897":1554,"_22053":1549,"_18699":36358,"_5":22203,"_15048":36349,"_1570":36359},[],"`CRL`, para distribución y consulta offline de listas de revocación.",{"_7897":1555,"_22053":1549,"_18699":36361,"_5":22203,"_15048":36349,"_1570":36362},[],"En el menú lateral del módulo `VA` encontrarás cada capacidad documentada en su propia página.",{"_7897":1556,"_22053":1556,"_5":22198,"_1570":36364,"_18699":36365,"_15048":1556},"Test",[],{"_7897":1557,"_22053":1556,"_18699":36367,"_5":22203,"_15048":1556,"_1570":36368},[],"A document to test Fumadocs",{"_7897":1558,"_22053":1556,"_5":22208,"_18699":36370,"_15048":36371,"_1570":36372},[],"/docs/pr-preview/pr-22/test#cards","Cards",{"_7897":1559,"_22053":1556,"_5":22208,"_18699":36374,"_15048":36375,"_1570":36376},[],"/docs/pr-preview/pr-22/test#codeblock","CodeBlock",{"_7897":1560,"_22053":1556,"_5":22208,"_18699":36378,"_15048":36379,"_1570":36380},[],"/docs/pr-preview/pr-22/test#list","List",{"_7897":1561,"_22053":1556,"_18699":36382,"_5":22203,"_15048":1556,"_1570":36383},[],"Hey there!",{"_7897":1562,"_22053":1556,"_18699":36385,"_5":22203,"_15048":36371,"_1570":36386},[],"<Card title=\"Learn more about Next.js\" href=\"https://nextjs.org/docs\" />",{"_7897":1563,"_22053":1556,"_18699":36388,"_5":22203,"_15048":36371,"_1570":36389},[],"<Card title=\"Learn more about Fumadocs\" href=\"https://fumadocs.dev\" />",{"_7897":1564,"_22053":1556,"_18699":36391,"_5":22203,"_1504