979":66,"_22255":34,"_18887":32162,"_5":22404,"_15195":32054,"_1578":32163},[],"Flag",{"_7979":67,"_22255":34,"_18887":32165,"_5":22404,"_15195":32054,"_1578":32166},[],"Valor por defecto",{"_7979":68,"_22255":34,"_18887":32168,"_5":22404,"_15195":32054,"_1578":32169},[],"Descripción",{"_7979":69,"_22255":34,"_18887":32171,"_5":22404,"_15195":32054,"_1578":32172},[],"`-h`, `--help`",{"_7979":70,"_22255":34,"_18887":32174,"_5":22404,"_15195":32054,"_1578":3022},[],{"_7979":71,"_22255":34,"_18887":32176,"_5":22404,"_15195":32054,"_1578":32177},[],"Muestra la ayuda y finaliza",{"_7979":72,"_22255":34,"_18887":32179,"_5":22404,"_15195":32054,"_1578":32180},[],"`-n`, `--non-interactive`",{"_7979":73,"_22255":34,"_18887":32182,"_5":22404,"_15195":32054,"_1578":32183},[],"`false`",{"_7979":74,"_22255":34,"_18887":32185,"_5":22404,"_15195":32054,"_1578":32186},[],"Omite prompts y genera/usa credenciales por defecto",{"_7979":75,"_22255":34,"_18887":32188,"_5":22404,"_15195":32054,"_1578":32189},[],"`-ns`, `--namespace`",{"_7979":76,"_22255":34,"_18887":32191,"_5":22404,"_15195":32054,"_1578":32192},[],"`lamassu-dev`",{"_7979":77,"_22255":34,"_18887":32194,"_5":22404,"_15195":32054,"_1578":32195},[],"Namespace Kubernetes donde se despliegan los recursos",{"_7979":78,"_22255":34,"_18887":32197,"_5":22404,"_15195":32054,"_1578":32198},[],"`-d`, `--domain`",{"_7979":79,"_22255":34,"_18887":32200,"_5":22404,"_15195":32054,"_1578":32201},[],"`dev.lamassu.io`",{"_7979":80,"_22255":34,"_18887":32203,"_5":22404,"_15195":32054,"_1578":32204},[],"Dominio usado para endpoint y certificados TLS",{"_7979":81,"_22255":34,"_18887":32206,"_5":22404,"_15195":32054,"_1578":32207},[],"`-v`, `--version`",{"_7979":82,"_22255":34,"_18887":32209,"_5":22404,"_15195":32054,"_1578":32210},[],"`latest`",{"_7979":83,"_22255":34,"_18887":32212,"_5":22404,"_15195":32054,"_1578":32213},[],"Versión del chart Helm de Lamassu",{"_7979":84,"_22255":34,"_18887":32215,"_5":22404,"_15195":32054,"_1578":32216},[],"`--https-port`",{"_7979":85,"_22255":34,"_18887":32218,"_5":22404,"_15195":32054,"_1578":32219},[],"`443`",{"_7979":86,"_22255":34,"_18887":32221,"_5":22404,"_15195":32054,"_1578":32222},[],"Puerto HTTPS del gateway",{"_7979":87,"_22255":34,"_18887":32224,"_5":22404,"_15195":32054,"_1578":32225},[],"`--http-port`",{"_7979":88,"_22255":34,"_18887":32227,"_5":22404,"_15195":32054,"_1578":32228},[],"`80`",{"_7979":89,"_22255":34,"_18887":32230,"_5":22404,"_15195":32054,"_1578":32231},[],"Puerto HTTP del gateway",{"_7979":90,"_22255":34,"_18887":32233,"_5":22404,"_15195":32054,"_1578":32234},[],"`--offline`",{"_7979":91,"_22255":34,"_18887":32236,"_5":22404,"_15195":32054,"_1578":32183},[],{"_7979":92,"_22255":34,"_18887":32238,"_5":22404,"_15195":32054,"_1578":32239},[],"Activa modo offline",{"_7979":93,"_22255":34,"_18887":32241,"_5":22404,"_15195":32054,"_1578":32242},[],"`--tls-crt`",{"_7979":94,"_22255":34,"_18887":32244,"_5":22404,"_15195":32054,"_1578":3022},[],{"_7979":95,"_22255":34,"_18887":32246,"_5":22404,"_15195":32054,"_1578":32247},[],"Ruta al certificado TLS (PEM)",{"_7979":96,"_22255":34,"_18887":32249,"_5":22404,"_15195":32054,"_1578":32250},[],"`--tls-key`",{"_7979":97,"_22255":34,"_18887":32252,"_5":22404,"_15195":32054,"_1578":3022},[],{"_7979":98,"_22255":34,"_18887":32254,"_5":22404,"_15195":32054,"_1578":32255},[],"Ruta a la clave privada TLS (PEM)",{"_7979":99,"_22255":34,"_18887":32257,"_5":22404,"_15195":32054,"_1578":32258},[],"`--helm-chart-lamassu`",{"_7979":100,"_22255":34,"_18887":32260,"_5":22404,"_15195":32054,"_1578":3022},[],{"_7979":101,"_22255":34,"_18887":32262,"_5":22404,"_15195":32054,"_1578":32263},[],"Ruta a chart local Lamassu (`.tgz`)",{"_7979":102,"_22255":34,"_18887":32265,"_5":22404,"_15195":32054,"_1578":32266},[],"`--helm-chart-postgres`",{"_7979":103,"_22255":34,"_18887":32268,"_5":22404,"_15195":32054,"_1578":3022},[],{"_7979":104,"_22255":34,"_18887":32270,"_5":22404,"_15195":32054,"_1578":32271},[],"Ruta a chart local PostgreSQL (`.tgz`)",{"_7979":105,"_22255":34,"_18887":32273,"_5":22404,"_15195":32054,"_1578":32274},[],"`--helm-chart-keycloak`",{"_7979":106,"_22255":34,"_18887":32276,"_5":22404,"_15195":32054,"_1578":3022},[],{"_7979":107,"_22255":34,"_18887":32278,"_5":22404,"_15195":32054,"_1578":32279},[],"Ruta a chart local Keycloak (`.tgz`)",{"_7979":108,"_22255":34,"_18887":32281,"_5":22404,"_15195":32054,"_1578":32282},[],"`--helm-chart-rabbitmq`",{"_7979":109,"_22255":34,"_18887":32284,"_5":22404,"_15195":32054,"_1578":3022},[],{"_7979":110,"_22255":34,"_18887":32286,"_5":22404,"_15195":32054,"_1578":32287},[],"Ruta a chart local RabbitMQ (`.tgz`)",{"_7979":111,"_22255":34,"_18887":32289,"_5":22404,"_15195":32054,"_1578":32290},[],"`-l`, `--local-chart-path`",{"_7979":112,"_22255":34,"_18887":32292,"_5":22404,"_15195":32054,"_1578":3022},[],{"_7979":113,"_22255":34,"_18887":32294,"_5":22404,"_15195":32054,"_1578":32295},[],"Ruta a directorio local descomprimido del chart Lamassu",{"_7979":114,"_22255":34,"_18887":32297,"_5":22404,"_15195":32058,"_1578":32298},[],"La función `detect_distribution` identifica la distribución con el siguiente orden de prioridad:",{"_7979":115,"_22255":34,"_18887":32300,"_5":22404,"_15195":32058,"_1578":32301},[],"`microk8s`",{"_7979":116,"_22255":34,"_18887":32303,"_5":22404,"_15195":32058,"_1578":32304},[],"`k3s`",{"_7979":117,"_22255":34,"_18887":32306,"_5":22404,"_15195":32058,"_1578":32307},[],"`kind`",{"_7979":118,"_22255":34,"_18887":32309,"_5":22404,"_15195":32058,"_1578":32310},[],"Kubernetes estándar",{"_7979":119,"_22255":34,"_18887":32312,"_5":22404,"_15195":32058,"_1578":32313},[],"Comportamientos específicos:",{"_7979":120,"_22255":34,"_18887":32315,"_5":22404,"_15195":32058,"_1578":32316},[],"En `microk8s`, los comandos se ejecutan con prefijos `microk8s kubectl` y `microk8s helm`.",{"_7979":121,"_22255":34,"_18887":32318,"_5":22404,"_15195":32058,"_1578":32319},[],"En `kind`, el script muestra una advertencia de uso exclusivo para pruebas.",{"_7979":122,"_22255":34,"_18887":32321,"_5":22404,"_15195":32062,"_1578":32322},[],"La función `check_dependencies` valida prerequisitos según la distribución detectada.",{"_7979":123,"_22255":34,"_18887":32324,"_5":22404,"_15195":32062,"_1578":32325},[],"Requisitos generales:",{"_7979":124,"_22255":34,"_18887":32327,"_5":22404,"_15195":32062,"_1578":32328},[],"`yq`",{"_7979":125,"_22255":34,"_18887":32330,"_5":22404,"_15195":32062,"_1578":32331},[],"CLI de la distribución detectada",{"_7979":126,"_22255":34,"_18887":32333,"_5":22404,"_15195":32062,"_1578":32334},[],"Requisitos específicos:",{"_7979":127,"_22255":34,"_18887":32336,"_5":22404,"_15195":32062,"_1578":32337},[],"Distribución",{"_7979":128,"_22255":34,"_18887":32339,"_5":22404,"_15195":32062,"_1578":32340},[],"Herramientas requeridas",{"_7979":129,"_22255":34,"_18887":32342,"_5":22404,"_15195":32062,"_1578":32304},[],{"_7979":130,"_22255":34,"_18887":32344,"_5":22404,"_15195":32062,"_1578":32345},[],"`kubectl`, `helm`",{"_7979":131,"_22255":34,"_18887":32347,"_5":22404,"_15195":32062,"_1578":32301},[],{"_7979":132,"_22255":34,"_18887":32349,"_5":22404,"_15195":32062,"_1578":32350},[],"`microk8s kubectl`, `microk8s helm`",{"_7979":133,"_22255":34,"_18887":32352,"_5":22404,"_15195":32066,"_1578":32353},[],"Se valida que estén habilitados:",{"_7979":134,"_22255":34,"_18887":32355,"_5":22404,"_15195":32066,"_1578":32356},[],"`helm`",{"_7979":135,"_22255":34,"_18887":32358,"_5":22404,"_15195":32066,"_1578":32359},[],"`hostpath-storage`",{"_7979":136,"_22255":34,"_18887":32361,"_5":22404,"_15195":32066,"_1578":32362},[],"`dns`",{"_7979":137,"_22255":34,"_18887":32364,"_5":22404,"_15195":32066,"_1578":32365},[],"`cert-manager`",{"_7979":138,"_22255":34,"_18887":32367,"_5":22404,"_15195":32066,"_1578":32368},[],"También se verifica un release Helm de Envoy Gateway llamado `eg` en el namespace `envoy-gateway-system`.\nSi no existe, se instala automáticamente la versión `v1.3.0` y se crea un `GatewayClass` llamado `eg`.",{"_7979":139,"_22255":34,"_18887":32370,"_5":22404,"_15195":32074,"_1578":32371},[],"La función `request_config_data` solicita:",{"_7979":140,"_22255":34,"_18887":32373,"_5":22404,"_15195":32074,"_1578":32374},[],"Dominio Lamassu",{"_7979":141,"_22255":34,"_18887":32376,"_5":22404,"_15195":32074,"_1578":32377},[],"Usuario y contraseña admin PostgreSQL",{"_7979":142,"_22255":34,"_18887":32379,"_5":22404,"_15195":32074,"_1578":32380},[],"Usuario y contraseña admin RabbitMQ",{"_7979":143,"_22255":34,"_18887":32382,"_5":22404,"_15195":32074,"_1578":32383},[],"Usuario y contraseña admin Keycloak",{"_7979":144,"_22255":34,"_18887":32385,"_5":22404,"_15195":32074,"_1578":32386},[],"Namespace Kubernetes",{"_7979":145,"_22255":34,"_18887":32388,"_5":22404,"_15195":32078,"_1578":32389},[],"Se generan credenciales aleatorias de 30 caracteres alfanuméricos.",{"_7979":146,"_22255":34,"_18887":32391,"_5":22404,"_15195":32078,"_1578":32392},[],"Se usan valores por defecto para dominio y namespace, salvo que se sobrescriban con flags.",{"_7979":147,"_22255":34,"_18887":32394,"_5":22404,"_15195":32082,"_1578":32395},[],"El script admite dos estrategias para obtener charts Helm.",{"_7979":148,"_22255":34,"_18887":32397,"_5":22404,"_15195":32086,"_1578":32398},[],"Los charts se descargan desde repositorios remotos.",{"_7979":149,"_22255":34,"_18887":32400,"_5":22404,"_15195":32090,"_1578":32401},[],"Requiere obligatoriamente rutas a los cuatro charts:",{"_7979":150,"_22255":34,"_18887":32403,"_5":22404,"_15195":32090,"_1578":32258},[],{"_7979":151,"_22255":34,"_18887":32405,"_5":22404,"_15195":32090,"_1578":32266},[],{"_7979":152,"_22255":34,"_18887":32407,"_5":22404,"_15195":32090,"_1578":32274},[],{"_7979":153,"_22255":34,"_18887":32409,"_5":22404,"_15195":32090,"_1578":32282},[],{"_7979":154,"_22255":34,"_18887":32411,"_5":22404,"_15195":32090,"_1578":32412},[],"Si falta cualquiera de ellos, el script finaliza con error.",{"_7979":155,"_22255":34,"_18887":32414,"_5":22404,"_15195":32090,"_1578":32415},[],"En este modo se fuerza:",{"_7979":156,"_22255":34,"_18887":32417,"_5":22404,"_15195":32098,"_1578":32418},[],"Chart: `oci://registry-1.docker.io/cloudpirates/postgres`",{"_7979":157,"_22255":34,"_18887":32420,"_5":22404,"_15195":32098,"_1578":32421},[],"Versión del chart: `0.19.0`",{"_7979":158,"_22255":34,"_18887":32423,"_5":22404,"_15195":32098,"_1578":32424},[],"Release: `postgres`",{"_7979":159,"_22255":34,"_18887":32426,"_5":22404,"_15195":32098,"_1578":32427},[],"`fullnameOverride: \"postgresql\"`",{"_7979":160,"_22255":34,"_18887":32429,"_5":22404,"_15195":32098,"_1578":32430},[],"Se crea un script SQL de inicialización con estas bases de datos:",{"_7979":161,"_22255":34,"_18887":32432,"_5":22404,"_15195":32098,"_1578":32433},[],"Base de datos",{"_7979":162,"_22255":34,"_18887":32435,"_5":22404,"_15195":32098,"_1578":32436},[],"Servicio",{"_7979":163,"_22255":34,"_18887":32438,"_5":22404,"_15195":32098,"_1578":32439},[],"`auth`",{"_7979":164,"_22255":34,"_18887":32441,"_5":22404,"_15195":32098,"_1578":32151},[],{"_7979":165,"_22255":34,"_18887":32443,"_5":22404,"_15195":32098,"_1578":32444},[],"`alerts`",{"_7979":166,"_22255":34,"_18887":32446,"_5":22404,"_15195":32098,"_1578":32447},[],"Alerts",{"_7979":167,"_22255":34,"_18887":32449,"_5":22404,"_15195":32098,"_1578":32450},[],"`ca`",{"_7979":168,"_22255":34,"_18887":32452,"_5":22404,"_15195":32098,"_1578":32453},[],"CA",{"_7979":169,"_22255":34,"_18887":32455,"_5":22404,"_15195":32098,"_1578":32456},[],"`va`",{"_7979":170,"_22255":34,"_18887":32458,"_5":22404,"_15195":32098,"_1578":32459},[],"VA",{"_7979":171,"_22255":34,"_18887":32461,"_5":22404,"_15195":32098,"_1578":32462},[],"`cloudproxy`",{"_7979":172,"_22255":34,"_18887":32464,"_5":22404,"_15195":32098,"_1578":32465},[],"Cloud Proxy",{"_7979":173,"_22255":34,"_18887":32467,"_5":22404,"_15195":32098,"_1578":32468},[],"`devicemanager`",{"_7979":174,"_22255":34,"_18887":32470,"_5":22404,"_15195":32098,"_1578":32471},[],"Device Manager",{"_7979":175,"_22255":34,"_18887":32473,"_5":22404,"_15195":32098,"_1578":32474},[],"`dmsmanager`",{"_7979":176,"_22255":34,"_18887":32476,"_5":22404,"_15195":32098,"_1578":32477},[],"DMS Manager",{"_7979":177,"_22255":34,"_18887":32479,"_5":22404,"_15195":32098,"_1578":32480},[],"`kms`",{"_7979":178,"_22255":34,"_18887":32482,"_5":22404,"_15195":32098,"_1578":32483},[],"KMS",{"_7979":179,"_22255":34,"_18887":32485,"_5":22404,"_15195":32102,"_1578":32486},[],"Chart: `oci://registry-1.docker.io/cloudpirates/keycloak`",{"_7979":180,"_22255":34,"_18887":32488,"_5":22404,"_15195":32102,"_1578":32489},[],"Versión del chart: `0.20.0`",{"_7979":181,"_22255":34,"_18887":32491,"_5":22404,"_15195":32102,"_1578":32492},[],"Release: `auth`",{"_7979":182,"_22255":34,"_18887":32494,"_5":22404,"_15195":32102,"_1578":32495},[],"Uso de base de datos externa: `postgresql:5432/auth`",{"_7979":183,"_22255":34,"_18887":32497,"_5":22404,"_15195":32102,"_1578":32498},[],"Imagen de Keycloak fijada en `keycloak/keycloak:26.6.0`",{"_7979":184,"_22255":34,"_18887":32500,"_5":22404,"_15195":32102,"_1578":32501},[],"`httpRelativePath: /auth/`",{"_7979":185,"_22255":34,"_18887":32503,"_5":22404,"_15195":32102,"_1578":32504},[],"`proxyHeaders: xforwarded`",{"_7979":186,"_22255":34,"_18887":32506,"_5":22404,"_15195":32102,"_1578":32507},[],"Configuración automática del realm `lamassu`:",{"_7979":187,"_22255":34,"_18887":32509,"_5":22404,"_15195":32102,"_1578":32510},[],"Rol: `pki-admin`",{"_7979":188,"_22255":34,"_18887":32512,"_5":22404,"_15195":32102,"_1578":32513},[],"Usuario inicial: `lamassu` / `lamassu` (cambio obligatorio)",{"_7979":189,"_22255":34,"_18887":32515,"_5":22404,"_15195":32102,"_1578":32516},[],"Cliente público: `frontend` con `/*` en redirect URIs",{"_7979":190,"_22255":34,"_18887":32518,"_5":22404,"_15195":32102,"_1578":32519},[],"En modo online se descarga automáticamente un tema personalizado desde:",{"_7979":191,"_22255":34,"_18887":32521,"_5":22404,"_15195":32102,"_1578":32522},[],"`github.com/lamassuiot/keycloak-theme`",{"_7979":192,"_22255":34,"_18887":32524,"_5":22404,"_15195":32106,"_1578":32525},[],"Chart: `oci://registry-1.docker.io/cloudpirates/rabbitmq`",{"_7979":193,"_22255":34,"_18887":32527,"_5":22404,"_15195":32106,"_1578":32489},[],{"_7979":194,"_22255":34,"_18887":32529,"_5":22404,"_15195":32106,"_1578":32530},[],"Release: `rabbitmq`",{"_7979":195,"_22255":34,"_18887":32532,"_5":22404,"_15195":32106,"_1578":32533},[],"`fullnameOverride: \"rabbitmq\"`",{"_7979":196,"_22255":34,"_18887":32535,"_5":22404,"_15195":32106,"_1578":32536},[],"Credenciales inyectadas dinámicamente mediante `yq`",{"_7979":197,"_22255":34,"_18887":32538,"_5":22404,"_15195":32110,"_1578":32539},[],"Se genera un archivo `lamassu.yaml` que se pasa a `helm install`.",{"_7979":198,"_22255":34,"_18887":32541,"_5":22404,"_15195":32110,"_1578":32542},[],"Configuraciones principales:",{"_7979":199,"_22255":34,"_18887":32544,"_5":22404,"_15195":32110,"_1578":32545},[],"PostgreSQL: host `postgresql`, puerto `5432`",{"_7979":200,"_22255":34,"_18887":32547,"_5":22404,"_15195":32110,"_1578":32548},[],"AMQP: host `rabbitmq`, puerto `5672`, TLS deshabilitado",{"_7979":201,"_22255":34,"_18887":32550,"_5":22404,"_15195":32110,"_1578":32551},[],"OIDC JWKS:\n`http://auth-keycloak.<NAMESPACE>/auth/realms/lamassu/protocol/openid-connect/certs`",{"_7979":202,"_22255":34,"_18887":32553,"_5":22404,"_15195":32110,"_1578":32554},[],"Ruta adicional de gateway: `/auth -> auth-keycloak:8080`",{"_7979":203,"_22255":34,"_18887":32556,"_5":22404,"_15195":32110,"_1578":32557},[],"Direcciones de gateway: IP(s) obtenidas con `hostname -I`",{"_7979":204,"_22255":34,"_18887":32559,"_5":22404,"_15195":32110,"_1578":32560},[],"Puertos de gateway: desde `--https-port` y `--http-port`",{"_7979":205,"_22255":34,"_18887":32562,"_5":22404,"_15195":32110,"_1578":32563},[],"Dominios CA: valor de `--domain`",{"_7979":206,"_22255":34,"_18887":32565,"_5":22404,"_15195":32110,"_1578":32566},[],"Cuando se ejecuta en modo online y no se usa `--local-chart-path`, el script añade el repositorio Helm:",{"_7979":207,"_22255":34,"_18887":32568,"_5":22404,"_15195":32110,"_1578":32569},[],"Después instala el release `lamassu` usando la versión indicada por `--version` si se ha proporcionado.",{"_7979":208,"_22255":34,"_18887":32571,"_5":22404,"_15195":32110,"_1578":32572},[],"Si `--https-port` es distinto de `443`, el puerto se añade al dominio antes de escribirlo en `values`.",{"_7979":209,"_22255":34,"_18887":32574,"_5":22404,"_15195":32118,"_1578":32575},[],"Si se proporcionan:",{"_7979":210,"_22255":34,"_18887":32577,"_5":22404,"_15195":32118,"_1578":32242},[],{"_7979":211,"_22255":34,"_18887":32579,"_5":22404,"_15195":32118,"_1578":32250},[],{"_7979":212,"_22255":34,"_18887":32581,"_5":22404,"_15195":32118,"_1578":32582},[],"Se crea un secret Kubernetes:",{"_7979":213,"_22255":34,"_18887":32584,"_5":22404,"_15195":32118,"_1578":32585},[],"`downstream-provided-crt`",{"_7979":214,"_22255":34,"_18887":32587,"_5":22404,"_15195":32118,"_1578":32588},[],"Y se configura:",{"_7979":215,"_22255":34,"_18887":32590,"_5":22404,"_15195":32122,"_1578":32591},[],"Si no se proporciona certificado:",{"_7979":216,"_22255":34,"_18887":32593,"_5":22404,"_15195":32122,"_1578":32594},[],"Además, el script crea un `Issuer` self-signed y el recurso `Certificate`.",{"_7979":217,"_22255":34,"_18887":32596,"_5":22404,"_15195":32122,"_1578":32597},[],"Si el usuario quiere reutilizar un `Issuer` o `ClusterIssuer` corporativo, ese flujo no lo automatiza Fastlane; en ese caso es preferible un despliegue manual del chart con un archivo `values.yaml` propio.",{"_7979":218,"_22255":34,"_18887":32599,"_5":22404,"_15195":32126,"_1578":32600},[],"En caso de éxito, se muestra:",{"_7979":219,"_22255":34,"_18887":32602,"_5":22404,"_15195":32126,"_1578":32603},[],"URL de Lamassu UI: `https://<DOMAIN>`",{"_7979":220,"_22255":34,"_18887":32605,"_5":22404,"_15195":32126,"_1578":32606},[],"Credenciales iniciales: `lamassu / lamassu`",{"_7979":221,"_22255":34,"_18887":32608,"_5":22404,"_15195":32126,"_1578":32609},[],"Consola Keycloak: `https://<DOMAIN>/auth/admin`",{"_7979":222,"_22255":34,"_18887":32611,"_5":22404,"_15195":32126,"_1578":32612},[],"Credenciales admin de Keycloak",{"_7979":223,"_22255":34,"_18887":32614,"_5":22404,"_15195":32126,"_1578":32615},[],"El usuario `lamassu` se crea con:",{"_7979":224,"_22255":34,"_18887":32617,"_5":22404,"_15195":32126,"_1578":32618},[],"Por tanto, debe cambiar contraseña en el primer acceso.",{"_7979":225,"_22255":34,"_18887":32620,"_5":22404,"_15195":32130,"_1578":32621},[],"El script está pensado también para validaciones rápidas y smoke tests locales. Tras la instalación puede ejecutarse:",{"_7979":226,"_22255":34,"_18887":32623,"_5":22404,"_15195":32130,"_1578":32624},[],"El chart incluye una prueba que valida conectividad contra `ca`, `dms-manager`, `device-manager`, `va` y `ui`.",{"_7979":227,"_22255":34,"_18887":32626,"_5":22404,"_15195":32130,"_1578":32627},[],"Ejemplo:",{"_7979":228,"_22255":34,"_18887":32629,"_5":22404,"_15195":32130,"_1578":32630},[],"En este escenario:",{"_7979":229,"_22255":34,"_18887":32632,"_5":22404,"_15195":32130,"_1578":32633},[],"`-n`: modo no interactivo",{"_7979":230,"_22255":34,"_18887":32635,"_5":22404,"_15195":32130,"_1578":32636},[],"`-ns`: namespace específico",{"_7979":231,"_22255":34,"_18887":32638,"_5":22404,"_15195":32130,"_1578":32639},[],"`-d`: dominio de CI",{"_7979":232,"_22255":34,"_18887":32641,"_5":22404,"_15195":32130,"_1578":32642},[],"`-l`: chart local",{"_7979":233,"_22255":34,"_18887":32644,"_5":22404,"_15195":32138,"_1578":32645},[],"`lamassu-fast-lane.sh` proporciona un mecanismo totalmente automatizado para desplegar un entorno Lamassu funcional en Kubernetes en pocos minutos, integrando base de datos, autenticación, mensajería, gateway y TLS.",{"_7979":234,"_22255":34,"_18887":32647,"_5":22404,"_15195":32138,"_1578":32648},[],"Está optimizado para rapidez, reproducibilidad y uso en entornos no productivos, con soporte para escenarios offline y pipelines de CI.",{"_7979":235,"_22255":235,"_5":22399,"_1578":32650,"_22412":32651,"_18887":32652,"_15195":235},"Introducción",[31966,31967,32018],[],{"_7979":236,"_22255":235,"_18887":32654,"_5":22404,"_15195":235,"_1578":32655},[],"Despliegue de Lamassu IoT en infraestructura on-premise gestionada con Kubernetes",{"_7979":237,"_22255":235,"_5":22409,"_18887":32657,"_15195":32658,"_1578":32659},[],"/docs/pr-preview/pr-23/despliegue/onprem#despliegue-onprem-con-kubernetes","Despliegue OnPrem con Kubernetes",{"_7979":238,"_22255":235,"_5":22409,"_18887":32661,"_15195":32662,"_1578":32663},[],"/docs/pr-preview/pr-23/despliegue/onprem#quickstart","Quickstart",{"_7979":239,"_22255":235,"_5":22409,"_18887":32665,"_15195":32666,"_1578":32667},[],"/docs/pr-preview/pr-23/despliegue/onprem#qué-se-despliega","Qué se despliega",{"_7979":240,"_22255":235,"_5":22409,"_18887":32669,"_15195":32670,"_1578":32671},[],"/docs/pr-preview/pr-23/despliegue/onprem#requisitos-previos","Requisitos previos",{"_7979":241,"_22255":235,"_5":22409,"_18887":32673,"_15195":32674,"_1578":32675},[],"/docs/pr-preview/pr-23/despliegue/onprem#opciones-de-despliegue","Opciones de despliegue",{"_7979":242,"_22255":235,"_5":22409,"_18887":32677,"_15195":32678,"_1578":32679},[],"/docs/pr-preview/pr-23/despliegue/onprem#1-despliegue-manual-con-helm","1\\. Despliegue manual con Helm",{"_7979":243,"_22255":235,"_5":22409,"_18887":32681,"_15195":32682,"_1578":32683},[],"/docs/pr-preview/pr-23/despliegue/onprem#2-despliegue-automatizado-con-fastlane","2\\. Despliegue automatizado con Fastlane",{"_7979":244,"_22255":235,"_5":22409,"_18887":32685,"_15195":32686,"_1578":32687},[],"/docs/pr-preview/pr-23/despliegue/onprem#arquitectura","Arquitectura",{"_7979":245,"_22255":235,"_5":22409,"_18887":32689,"_15195":32690,"_1578":32691},[],"/docs/pr-preview/pr-23/despliegue/onprem#instalación-manual-con-helm","Instalación manual con Helm",{"_7979":246,"_22255":235,"_5":22409,"_18887":32693,"_15195":32694,"_1578":32695},[],"/docs/pr-preview/pr-23/despliegue/onprem#valores-mínimos-que-deben-definirse","Valores mínimos que deben definirse",{"_7979":247,"_22255":235,"_5":22409,"_18887":32697,"_15195":32698,"_1578":32699},[],"/docs/pr-preview/pr-23/despliegue/onprem#áreas-de-configuración-más-relevantes","Áreas de configuración más relevantes",{"_7979":248,"_22255":235,"_5":22409,"_18887":32701,"_15195":32702,"_1578":32703},[],"/docs/pr-preview/pr-23/despliegue/onprem#verificación-del-despliegue","Verificación del despliegue",{"_7979":249,"_22255":235,"_5":22409,"_18887":32705,"_15195":32706,"_1578":32707},[],"/docs/pr-preview/pr-23/despliegue/onprem#repositorio-helm","Repositorio Helm",{"_7979":250,"_22255":235,"_5":22409,"_18887":32709,"_15195":32710,"_1578":32711},[],"/docs/pr-preview/pr-23/despliegue/onprem#softhsm-como-complemento-opcional","SoftHSM como complemento opcional",{"_7979":251,"_22255":235,"_5":22409,"_18887":32713,"_15195":32714,"_1578":32715},[],"/docs/pr-preview/pr-23/despliegue/onprem#versionado-y-migraciones","Versionado y migraciones",{"_7979":252,"_22255":235,"_18887":32717,"_5":22404,"_15195":32658,"_1578":32718},[],"Lamassu IoT puede desplegarse en infraestructura propia mediante **Kubernetes**, tanto en clústeres gestionados internamente como en entornos self-managed.",{"_7979":253,"_22255":235,"_18887":32720,"_5":22404,"_15195":32658,"_1578":32721},[],"La referencia principal para este despliegue es el repositorio `lamassu-helm`, que incluye:",{"_7979":254,"_22255":235,"_18887":32723,"_5":22404,"_15195":32658,"_1578":32724},[],"el chart principal de Lamassu",{"_7979":255,"_22255":235,"_18887":32726,"_5":22404,"_15195":32658,"_1578":32727},[],"un chart auxiliar de SoftHSM",{"_7979":256,"_22255":235,"_18887":32729,"_5":22404,"_15195":32658,"_1578":32730},[],"el script de despliegue automatizado `scripts/lamassu-fast-lane.sh`",{"_7979":257,"_22255":235,"_18887":32732,"_5":22404,"_15195":32662,"_1578":32733},[],"Si lo que necesitas es levantar un entorno funcional lo antes posible, la vía más rápida es usar Fastlane desde el repositorio `lamassu-helm`:",{"_7979":258,"_22255":235,"_18887":32735,"_5":22404,"_15195":32662,"_1578":32736},[],"Ese flujo:",{"_7979":259,"_22255":235,"_18887":32738,"_5":22404,"_15195":32662,"_1578":32739},[],"crea o reutiliza el namespace indicado",{"_7979":260,"_22255":235,"_18887":32741,"_5":22404,"_15195":32662,"_1578":32742},[],"instala PostgreSQL, Keycloak y RabbitMQ",{"_7979":261,"_22255":235,"_18887":32744,"_5":22404,"_15195":32662,"_1578":32745},[],"despliega el chart de Lamassu",{"_7979":262,"_22255":235,"_18887":32747,"_5":22404,"_15195":32662,"_1578":32748},[],"deja la UI expuesta en `https://<dominio>`",{"_7979":263,"_22255":235,"_18887":32750,"_5":22404,"_15195":32662,"_1578":32751},[],"Si buscas un despliegue productivo o más controlado, sigue con la instalación manual mediante Helm que se describe más abajo.",{"_7979":264,"_22255":235,"_18887":32753,"_5":22404,"_15195":32666,"_1578":32754},[],"El chart principal `charts/lamassu`, actualmente en la serie `3.7.x`, despliega estos componentes:",{"_7979":265,"_22255":235,"_18887":32756,"_5":22404,"_15195":32666,"_1578":32757},[],"`ui`",{"_7979":266,"_22255":235,"_18887":32759,"_5":22404,"_15195":32666,"_1578":32450},[],{"_7979":267,"_22255":235,"_18887":32761,"_5":22404,"_15195":32666,"_1578":32456},[],{"_7979":268,"_22255":235,"_18887":32763,"_5":22404,"_15195":32666,"_1578":32480},[],{"_7979":269,"_22255":235,"_18887":32765,"_5":22404,"_15195":32666,"_1578":32766},[],"`device-manager`",{"_7979":270,"_22255":235,"_18887":32768,"_5":22404,"_15195":32666,"_1578":32769},[],"`dms-manager`",{"_7979":271,"_22255":235,"_18887":32771,"_5":22404,"_15195":32666,"_1578":32444},[],{"_7979":272,"_22255":235,"_18887":32773,"_5":22404,"_15195":32666,"_1578":32774},[],"recursos de Gateway API y políticas de Envoy Gateway",{"_7979":273,"_22255":235,"_18887":32776,"_5":22404,"_15195":32666,"_1578":32777},[],"job de migraciones de base de datos",{"_7979":274,"_22255":235,"_18887":32779,"_5":22404,"_15195":32670,"_1578":32780},[],"Clúster Kubernetes `1.19+`",{"_7979":275,"_22255":235,"_18887":32782,"_5":22404,"_15195":32670,"_1578":32783},[],"`kubectl` configurado con acceso al clúster",{"_7979":276,"_22255":235,"_18887":32785,"_5":22404,"_15195":32670,"_1578":32786},[],"Helm `3.2.0+`",{"_7979":277,"_22255":235,"_18887":32788,"_5":22404,"_15195":32670,"_1578":32789},[],"`cert-manager 1.14+` para la gestión de certificados cuando se usa `tls.type=certManager`",{"_7979":278,"_22255":235,"_18887":32791,"_5":22404,"_15195":32670,"_1578":32792},[],"`Envoy Gateway 1.3.0+`, ya que el chart publica servicios mediante Gateway API y no mediante Ingress",{"_7979":279,"_22255":235,"_18887":32794,"_5":22404,"_15195":32670,"_1578":32795},[],"Acceso a un registro de contenedores o imágenes previamente importadas si se trabaja en modo offline",{"_7979":280,"_22255":235,"_18887":32797,"_5":22404,"_15195":32670,"_1578":32798},[],"Almacenamiento persistente disponible para PostgreSQL, RabbitMQ, VA y KMS",{"_7979":281,"_22255":235,"_18887":32800,"_5":22404,"_15195":32674,"_1578":32801},[],"Hay dos formas de desplegar Lamassu on-prem:",{"_7979":282,"_22255":235,"_18887":32803,"_5":22404,"_15195":32678,"_1578":32804},[],"Es la opción recomendada para entornos productivos o controlados, donde PostgreSQL, RabbitMQ, Keycloak, certificados y direccionamiento del Gateway ya están definidos por el equipo de plataforma.",{"_7979":283,"_22255":235,"_18887":32806,"_5":22404,"_15195":32682,"_1578":32807},[],"Es la opción más útil para pruebas, demos, CI o bootstrap rápido de un entorno. Fastlane levanta PostgreSQL, Keycloak, RabbitMQ y Lamassu en un único flujo. Su comportamiento está documentado en la página siguiente.",{"_7979":284,"_22255":235,"_18887":32809,"_5":22404,"_15195":32686,"_1578":32810},[],"Lamassu IoT se despliega como un conjunto de microservicios Kubernetes independientes. El chart principal crea `Deployment`, `StatefulSet`, `Service`, `ConfigMap`, `HTTPRoute`, `Gateway`, certificados y recursos auxiliares según los valores definidos.",{"_7979":285,"_22255":235,"_18887":32812,"_5":22404,"_15195":32686,"_1578":32813},[],"Dependencias externas requeridas por el chart principal:",{"_7979":286,"_22255":235,"_18887":32815,"_5":22404,"_15195":32686,"_1578":32148},[],{"_7979":287,"_22255":235,"_18887":32817,"_5":22404,"_15195":32686,"_1578":32154},[],{"_7979":288,"_22255":235,"_18887":32819,"_5":22404,"_15195":32686,"_1578":32820},[],"proveedor OIDC, típicamente Keycloak",{"_7979":289,"_22255":235,"_18887":32822,"_5":22404,"_15195":32686,"_1578":32823},[],"El chart no instala estas dependencias por sí solo. Para un despliegue manual hay que provisionarlas antes. Si se busca un entorno funcional rápido para laboratorio o validación, el script Fastlane sí instala PostgreSQL, RabbitMQ y Keycloak además del chart de Lamassu.",{"_7979":290,"_22255":235,"_18887":32825,"_5":22404,"_15195":32690,"_1578":32826},[],"Agregar el repositorio Helm:",{"_7979":291,"_22255":235,"_18887":32828,"_5":22404,"_15195":32690,"_1578":32829},[],"O instalar desde una copia local del repositorio:",{"_7979":292,"_22255":235,"_18887":32831,"_5":22404,"_15195":32694,"_1578":32832},[],"Los valores por defecto del chart son deliberadamente incompletos para dependencias externas. Como mínimo, un despliegue manual debe definir:",{"_7979":293,"_22255":235,"_18887":32834,"_5":22404,"_15195":32694,"_1578":32835},[],"`postgres.hostname`, `postgres.username`, `postgres.password`",{"_7979":294,"_22255":235,"_18887":32837,"_5":22404,"_15195":32694,"_1578":32838},[],"`amqp.hostname`, `amqp.username`, `amqp.password`",{"_7979":295,"_22255":235,"_18887":32840,"_5":22404,"_15195":32694,"_1578":32841},[],"`auth.oidc.frontend.authority`",{"_7979":296,"_22255":235,"_18887":32843,"_5":22404,"_15195":32694,"_1578":32844},[],"`auth.oidc.apiGateway.jwks`",{"_7979":297,"_22255":235,"_18887":32846,"_5":22404,"_15195":32694,"_1578":32847},[],"`services.ca.domains`",{"_7979":298,"_22255":235,"_18887":32849,"_5":22404,"_15195":32694,"_1578":32850},[],"`gateway.addresses` o una estrategia equivalente de publicación según el clúster",{"_7979":299,"_22255":235,"_18887":32852,"_5":22404,"_15195":32694,"_1578":32853},[],"`tls.*` según se use `certManager` o certificado externo",{"_7979":300,"_22255":235,"_18887":32855,"_5":22404,"_15195":32694,"_1578":32856},[],"Ejemplo base:",{"_7979":301,"_22255":235,"_18887":32858,"_5":22404,"_15195":32698,"_1578":32859},[],"Área",{"_7979":302,"_22255":235,"_18887":32861,"_5":22404,"_15195":32698,"_1578":32862},[],"Valores clave",{"_7979":303,"_22255":235,"_18887":32864,"_5":22404,"_15195":32698,"_1578":32865},[],"Uso",{"_7979":304,"_22255":235,"_18887":32867,"_5":22404,"_15195":32698,"_1578":32868},[],"TLS",{"_7979":305,"_22255":235,"_18887":32870,"_5":22404,"_15195":32698,"_1578":32871},[],"`tls.type`, `tls.certManagerOptions.*`, `tls.externalOptions.secretName`",{"_7979":306,"_22255":235,"_18887":32873,"_5":22404,"_15195":32698,"_1578":32874},[],"Certificado downstream del Gateway",{"_7979":307,"_22255":235,"_18887":32876,"_5":22404,"_15195":32698,"_1578":32877},[],"Gateway",{"_7979":308,"_22255":235,"_18887":32879,"_5":22404,"_15195":32698,"_1578":32880},[],"`gateway.addresses`, `gateway.ports.*`, `gateway.extraRouting`",{"_7979":309,"_22255":235,"_18887":32882,"_5":22404,"_15195":32698,"_1578":32883},[],"Exposición de UI y APIs vía Envoy Gateway",{"_7979":310,"_22255":235,"_18887":32885,"_5":22404,"_15195":32698,"_1578":32433},[],{"_7979":311,"_22255":235,"_18887":32887,"_5":22404,"_15195":32698,"_1578":32888},[],"`postgres.*`",{"_7979":312,"_22255":235,"_18887":32890,"_5":22404,"_15195":32698,"_1578":32891},[],"Conexión a PostgreSQL externa",{"_7979":313,"_22255":235,"_18887":32893,"_5":22404,"_15195":32698,"_1578":32894},[],"Mensajería",{"_7979":314,"_22255":235,"_18887":32896,"_5":22404,"_15195":32698,"_1578":32897},[],"`amqp.*`",{"_7979":315,"_22255":235,"_18887":32899,"_5":22404,"_15195":32698,"_1578":32900},[],"Conexión a RabbitMQ",{"_7979":316,"_22255":235,"_18887":32902,"_5":22404,"_15195":32698,"_1578":32903},[],"OIDC",{"_7979":317,"_22255":235,"_18887":32905,"_5":22404,"_15195":32698,"_1578":32906},[],"`auth.oidc.frontend.*`, `auth.oidc.apiGateway.jwks`",{"_7979":318,"_22255":235,"_18887":32908,"_5":22404,"_15195":32698,"_1578":32909},[],"Login de UI y validación JWT en el Gateway",{"_7979":319,"_22255":235,"_18887":32911,"_5":22404,"_15195":32698,"_1578":32453},[],{"_7979":320,"_22255":235,"_18887":32913,"_5":22404,"_15195":32698,"_1578":32847},[],{"_7979":321,"_22255":235,"_18887":32915,"_5":22404,"_15195":32698,"_1578":32916},[],"Dominios autorizados para CA y certificados",{"_7979":322,"_22255":235,"_18887":32918,"_5":22404,"_15195":32698,"_1578":32483},[],{"_7979":323,"_22255":235,"_18887":32920,"_5":22404,"_15195":32698,"_1578":32921},[],"`services.kms.cryptoEngines.*`",{"_7979":324,"_22255":235,"_18887":32923,"_5":22404,"_15195":32698,"_1578":32924},[],"Motor criptográfico y almacenamiento de claves",{"_7979":325,"_22255":235,"_18887":32926,"_5":22404,"_15195":32698,"_1578":32447},[],{"_7979":326,"_22255":235,"_18887":32928,"_5":22404,"_15195":32698,"_1578":32929},[],"`services.alerts.smtp_server.*`",{"_7979":327,"_22255":235,"_18887":32931,"_5":22404,"_15195":32698,"_1578":32932},[],"Envío de correo para alertas",{"_7979":328,"_22255":235,"_18887":32934,"_5":22404,"_15195":32702,"_1578":32935},[],"El chart incluye una prueba Helm en `charts/lamassu/templates/tests/test-connections.yml`. Tras instalarlo, puede validarse con:",{"_7979":329,"_22255":235,"_18887":32937,"_5":22404,"_15195":32702,"_1578":32938},[],"La prueba comprueba al menos:",{"_7979":330,"_22255":235,"_18887":32940,"_5":22404,"_15195":32702,"_1578":32941},[],"salud de `ca`",{"_7979":331,"_22255":235,"_18887":32943,"_5":22404,"_15195":32702,"_1578":32944},[],"salud de `dms-manager`",{"_7979":332,"_22255":235,"_18887":32946,"_5":22404,"_15195":32702,"_1578":32947},[],"salud de `device-manager`",{"_7979":333,"_22255":235,"_18887":32949,"_5":22404,"_15195":32702,"_1578":32950},[],"salud de `va`",{"_7979":334,"_22255":235,"_18887":32952,"_5":22404,"_15195":32702,"_1578":32953},[],"respuesta HTML esperada del servicio `ui`",{"_7979":335,"_22255":235,"_18887":32955,"_5":22404,"_15195":32706,"_1578":32956},[],"El repositorio `lamassu-helm` está organizado en tres bloques principales:",{"_7979":336,"_22255":235,"_18887":32958,"_5":22404,"_15195":32706,"_1578":32959},[],"`charts/lamassu`: chart principal de Lamassu",{"_7979":337,"_22255":235,"_18887":32961,"_5":22404,"_15195":32706,"_1578":32962},[],"`charts/softhsm`: chart opcional para laboratorios o escenarios de integración con PKCS#11 emulado",{"_7979":338,"_22255":235,"_18887":32964,"_5":22404,"_15195":32706,"_1578":32965},[],"`scripts/lamassu-fast-lane.sh`: automatización para levantar dependencias y desplegar Lamassu con intervención mínima",{"_7979":339,"_22255":235,"_18887":32967,"_5":22404,"_15195":32710,"_1578":32968},[],"El chart `charts/softhsm` no forma parte del despliegue estándar, pero resulta útil en entornos de laboratorio cuando se necesita simular un HSM compatible con PKCS#11. No sustituye al backend KMS principal; sirve como soporte para pruebas o integraciones concretas.",{"_7979":340,"_22255":235,"_18887":32970,"_5":22404,"_15195":32714,"_1578":32971},[],"La serie actual del chart principal es `3.7.x`. Para upgrades entre versiones, el repositorio incluye guías específicas en `charts/lamassu/CHANGELOG/`, especialmente en cambios importantes como la adopción de Envoy Gateway o la introducción del servicio KMS.",{"_7979":341,"_22255":341,"_5":22399,"_1578":32973,"_22412":32974,"_18887":32975,"_15195":341},"SaaS · Suscripción",[31966,31967,32025],[],{"_7979":342,"_22255":341,"_18887":32977,"_5":22404,"_15195":341,"_1578":32978},[],"Acceso a Lamassu IoT como servicio gestionado basado en suscripción",{"_7979":343,"_22255":341,"_5":22409,"_18887":32980,"_15195":32981,"_1578":32982},[],"/docs/pr-preview/pr-23/despliegue/saas#lamassu-iot-saas--basada-en-suscripción","Lamassu IoT SaaS – Basada en suscripción",{"_7979":344,"_22255":341,"_5":22409,"_18887":32984,"_15195":32985,"_1578":32986},[],"/docs/pr-preview/pr-23/despliegue/saas#qué-incluye-la-suscripción","¿Qué incluye la suscripción?",{"_7979":345,"_22255":341,"_5":22409,"_18887":32988,"_15195":32989,"_1578":32990},[],"/docs/pr-preview/pr-23/despliegue/saas#planes-disponibles","Planes disponibles",{"_7979":346,"_22255":341,"_5":22409,"_18887":32992,"_15195":32993,"_1578":32994},[],"/docs/pr-preview/pr-23/despliegue/saas#contacto","Contacto",{"_7979":347,"_22255":341,"_18887":32996,"_5":22404,"_15195":32981,"_1578":32997},[],"La modalidad **SaaS** de Lamassu IoT ofrece acceso completo a la plataforma como servicio totalmente gestionado por LKS Next, sin necesidad de gestionar infraestructura propia.",{"_7979":348,"_22255":341,"_18887":32999,"_5":22404,"_15195":32985,"_1578":33000},[],"Acceso a la plataforma Lamassu IoT completamente gestionada",{"_7979":349,"_22255":341,"_18887":33002,"_5":22404,"_15195":32985,"_1578":33003},[],"Alta disponibilidad y backups automáticos",{"_7979":350,"_22255":341,"_18887":33005,"_5":22404,"_15195":32985,"_1578":33006},[],"Actualizaciones automáticas a las últimas versiones",{"_7979":351,"_22255":341,"_18887":33008,"_5":22404,"_15195":32985,"_1578":33009},[],"Soporte técnico incluido",{"_7979":352,"_22255":341,"_18887":33011,"_5":22404,"_15195":32985,"_1578":33012},[],"SLA garantizado",{"_7979":353,"_22255":341,"_18887":33014,"_5":22404,"_15195":32989,"_1578":33015},[],"Plan",{"_7979":354,"_22255":341,"_18887":33017,"_5":22404,"_15195":32989,"_1578":33018},[],"Dispositivos",{"_7979":355,"_22255":341,"_18887":33020,"_5":22404,"_15195":32989,"_1578":33021},[],"Soporte",{"_7979":356,"_22255":341,"_18887":33023,"_5":22404,"_15195":32989,"_1578":33024},[],"SLA",{"_7979":357,"_22255":341,"_18887":33026,"_5":22404,"_15195":32989,"_1578":33027},[],"Starter",{"_7979":358,"_22255":341,"_18887":33029,"_5":22404,"_15195":32989,"_1578":33030},[],"Hasta 1.000",{"_7979":359,"_22255":341,"_18887":33032,"_5":22404,"_15195":32989,"_1578":33033},[],"Email",{"_7979":360,"_22255":341,"_18887":33035,"_5":22404,"_15195":32989,"_1578":33036},[],"99,5%",{"_7979":361,"_22255":341,"_18887":33038,"_5":22404,"_15195":32989,"_1578":33039},[],"Professional",{"_7979":362,"_22255":341,"_18887":33041,"_5":22404,"_15195":32989,"_1578":33042},[],"Hasta 10.000",{"_7979":363,"_22255":341,"_18887":33044,"_5":22404,"_15195":32989,"_1578":33045},[],"Email + Chat",{"_7979":364,"_22255":341,"_18887":33047,"_5":22404,"_15195":32989,"_1578":33048},[],"99,9%",{"_7979":365,"_22255":341,"_18887":33050,"_5":22404,"_15195":32989,"_1578":33051},[],"Enterprise",{"_7979":366,"_22255":341,"_18887":33053,"_5":22404,"_15195":32989,"_1578":33054},[],"Ilimitado",{"_7979":367,"_22255":341,"_18887":33056,"_5":22404,"_15195":32989,"_1578":33057},[],"Dedicado",{"_7979":368,"_22255":341,"_18887":33059,"_5":22404,"_15195":32989,"_1578":33060},[],"99,99%",{"_7979":369,"_22255":341,"_18887":33062,"_5":22404,"_15195":32993,"_1578":33063},[],"Para suscribirte o solicitar una demo, contacta con el equipo de Lamassu IoT a través de lamassu.io.",{"_7979":370,"_22255":370,"_5":22399,"_1578":33065,"_22412":33066,"_18887":33067,"_15195":370},"Manual de Usuario",[31966,33065],[],{"_7979":371,"_22255":370,"_18887":33069,"_5":22404,"_15195":370,"_1578":33070},[],"Guía completa de uso de la plataforma Lamassu IoT",{"_7979":372,"_22255":370,"_5":22409,"_18887":33072,"_15195":33073,"_1578":33074},[],"/docs/pr-preview/pr-23/manual#servicios-core","Servicios Core",{"_7979":373,"_22255":370,"_5":22409,"_18887":33076,"_15195":33077,"_1578":33078},[],"/docs/pr-preview/pr-23/manual#integraciones-con-terceros","Integraciones con terceros",{"_7979":374,"_22255":370,"_18887":33080,"_5":22404,"_15195":370,"_1578":33081},[],"Bienvenido al **Manual de Usuario de Lamassu IoT**. Esta documentación cubre todas las funcionalidades de la plataforma para la gestión de identidades digitales en entornos IoT industriales.",{"_7979":375,"_22255":370,"_18887":33083,"_5":22404,"_15195":33073,"_1578":33084},[],"<Card title=\"Gestión de Claves (KMS)\" description=\"Motores criptográficos, generación e importación de claves\" href=\"/docs/manual/servicios-core/kms\" />",{"_7979":376,"_22255":370,"_18887":33086,"_5":22404,"_15195":33073,"_1578":33087},[],"<Card title=\"Entidades de Confianza (CAs)\" description=\"Creación, importación y gestión de Autoridades de Certificación\" href=\"/docs/manual/servicios-core/cas\" />",{"_7979":377,"_22255":370,"_18887":33089,"_5":22404,"_15195":33073,"_1578":33090},[],"<Card title=\"Gestión de Certificados\" description=\"Visualización y revocación de certificados emitidos\" href=\"/docs/manual/servicios-core/certificates\" />",{"_7979":378,"_22255":370,"_18887":33092,"_5":22404,"_15195":33073,"_1578":33093},[],"<Card title=\"Validación de Certificados (VA)\" description=\"Servicios OCSP y CRL\" href=\"/docs/manual/servicios-core/validation\" />",{"_7979":379,"_22255":370,"_18887":33095,"_5":22404,"_15195":33073,"_1578":33096},[],"<Card title=\"Registration Authority (RA)\" description=\"Automatización del ciclo de vida de certificados y protocolo EST\" href=\"/docs/manual/servicios-core/ra\" />",{"_7979":380,"_22255":370,"_18887":33098,"_5":22404,"_15195":33073,"_1578":33099},[],"<Card title=\"Dispositivos e Identidades\" description=\"Gestión de End Entities y ciclo de vida de dispositivos IoT\" href=\"/docs/manual/servicios-core/devices\" />",{"_7979":381,"_22255":370,"_18887":33101,"_5":22404,"_15195":33073,"_1578":33102},[],"<Card title=\"Alertas y Suscripciones\" description=\"Monitorización de eventos y notificaciones\" href=\"/docs/manual/servicios-core/alerts\" />",{"_7979":382,"_22255":370,"_18887":33104,"_5":22404,"_15195":33077,"_1578":33105},[],"<Card title=\"Integración AWS IoT Core\" description=\"Aprovisionamiento de dispositivos en AWS IoT Core\" href=\"/docs/manual/integraciones/aws\" />",{"_7979":383,"_22255":383,"_5":22399,"_1578":33107,"_22412":33108,"_18887":33109,"_15195":383},"Integración con AWS IoT Core",[31966,33065,33078],[],{"_7979":384,"_22255":383,"_18887":33111,"_5":22404,"_15195":383,"_1578":33112},[],"El conector de Lamassu para AWS IoT Core sincroniza las identidades de los dispositivos con la plataforma AWS, gestionando el registro de CAs, el aprovisionamiento de Things y el ciclo de vida de los certificados de forma automática y orientada a eventos.",{"_7979":385,"_22255":383,"_5":22409,"_18887":33114,"_15195":33115,"_1578":33116},[],"/docs/pr-preview/pr-23/manual/integraciones/aws#arquitectura-del-conector","Arquitectura del conector",{"_7979":386,"_22255":383,"_5":22409,"_18887":33118,"_15195":33119,"_1578":33120},[],"/docs/pr-preview/pr-23/manual/integraciones/aws#prerrequisitos","Prerrequisitos",{"_7979":387,"_22255":383,"_5":22409,"_18887":33122,"_15195":33123,"_1578":33124},[],"/docs/pr-preview/pr-23/manual/integraciones/aws#permisos-iam-necesarios","Permisos IAM necesarios",{"_7979":388,"_22255":383,"_5":22409,"_18887":33126,"_15195":33127,"_1578":33128},[],"/docs/pr-preview/pr-23/manual/integraciones/aws#parámetros-de-configuración","Parámetros de configuración",{"_7979":389,"_22255":383,"_5":22409,"_18887":33130,"_15195":33131,"_1578":33132},[],"/docs/pr-preview/pr-23/manual/integraciones/aws#registro-de-la-ca-en-aws-iot-core","Registro de la CA en AWS IoT Core",{"_7979":390,"_22255":383,"_5":22409,"_18887":33134,"_15195":33135,"_1578":33136},[],"/docs/pr-preview/pr-23/manual/integraciones/aws#cómo-solicitar-el-registro","Cómo solicitar el registro",{"_7979":391,"_22255":383,"_5":22409,"_18887":33138,"_15195":33139,"_1578":33140},[],"/docs/pr-preview/pr-23/manual/integraciones/aws#primary-account","Primary Account",{"_7979":392,"_22255":383,"_5":22409,"_18887":33142,"_15195":33143,"_1578":33144},[],"/docs/pr-preview/pr-23/manual/integraciones/aws#secondary-account-sni-only","Secondary Account (SNI-only)",{"_7979":393,"_22255":383,"_5":22409,"_18887":33146,"_15195":33147,"_1578":33148},[],"/docs/pr-preview/pr-23/manual/integraciones/aws#configuración-del-dms","Configuración del DMS",{"_7979":394,"_22255":383,"_5":22409,"_18887":33150,"_15195":33151,"_1578":33152},[],"/docs/pr-preview/pr-23/manual/integraciones/aws#modo-none","Modo `none`",{"_7979":395,"_22255":383,"_5":22409,"_18887":33154,"_15195":33155,"_1578":33156},[],"/docs/pr-preview/pr-23/manual/integraciones/aws#modo-auto","Modo `auto`",{"_7979":396,"_22255":383,"_5":22409,"_18887":33158,"_15195":33159,"_1578":33160},[],"/docs/pr-preview/pr-23/manual/integraciones/aws#modo-jitp","Modo `jitp`",{"_7979":397,"_22255":383,"_5":22409,"_18887":33162,"_15195":33163,"_1578":33164},[],"/docs/pr-preview/pr-23/manual/integraciones/aws#aprovisionamiento-de-dispositivos-modo-automático","Aprovisionamiento de dispositivos (modo automático)",{"_7979":398,"_22255":383,"_5":22409,"_18887":33166,"_15195":33167,"_1578":33168},[],"/docs/pr-preview/pr-23/manual/integraciones/aws#aprovisionamiento-de-dispositivos-modo-jitp","Aprovisionamiento de dispositivos (modo JITP)",{"_7979":399,"_22255":383,"_5":22409,"_18887":33170,"_15195":33171,"_1578":33172},[],"/docs/pr-preview/pr-23/manual/integraciones/aws#sincronización-del-estado-del-certificado","Sincronización del estado del certificado",{"_7979":400,"_22255":383,"_5":22409,"_18887":33174,"_15195":33175,"_1578":33176},[],"/docs/pr-preview/pr-23/manual/integraciones/aws#desconexión-forzada-al-revocar","Desconexión forzada al revocar",{"_7979":401,"_22255":383,"_5":22409,"_18887":33178,"_15195":33179,"_1578":33180},[],"/docs/pr-preview/pr-23/manual/integraciones/aws#device-shadow-y-automatización","Device Shadow y automatización",{"_7979":402,"_22255":383,"_5":22409,"_18887":33182,"_15195":33183,"_1578":33184},[],"/docs/pr-preview/pr-23/manual/integraciones/aws#qué-escribe-el-conector-en-el-shadow","Qué escribe el conector en el shadow",{"_7979":403,"_22255":383,"_5":22409,"_18887":33186,"_15195":33187,"_1578":33188},[],"/docs/pr-preview/pr-23/manual/integraciones/aws#políticas-de-aws-iot","Políticas de AWS IoT",{"_7979":404,"_22255":383,"_5":22409,"_18887":33190,"_15195":33191,"_1578":33192},[],"/docs/pr-preview/pr-23/manual/integraciones/aws#solución-de-problemas","Solución de problemas",{"_7979":405,"_22255":383,"_18887":33194,"_5":22404,"_15195":383,"_1578":33195},[],"La integración de Lamassu con AWS IoT Core cubre el puente entre la PKI gestionada por Lamassu y la plataforma de conectividad de AWS. Cuando un dispositivo obtiene su certificado a través del proceso de enrolamiento EST, el conector se encarga de que ese certificado y la identidad asociada sean reconocidos en AWS IoT Core sin intervención manual. El resultado es que el dispositivo puede autenticarse directamente en AWS con el mismo certificado X.509 que Lamassu emitió.",{"_7979":406,"_22255":383,"_18887":33197,"_5":22404,"_15195":383,"_1578":33198},[],"Desde el punto de vista del protocolo, el dispositivo se autentica ante AWS IoT Core mediante TLS mutuo (mTLS): presenta su certificado X.509 emitido por Lamassu como certificado de cliente, y AWS IoT Core verifica la cadena de certificados hasta llegar a la CA registrada en la cuenta. Lamassu actúa como autoridad de certificación (CA); el conector se encarga de que esa CA esté registrada en AWS y de que el certificado del dispositivo sea conocido por la plataforma antes de que el dispositivo intente conectarse (en modo `auto`) o en su primera conexión (en modo JITP).",{"_7979":407,"_22255":383,"_18887":33200,"_5":22404,"_15195":383,"_1578":33201},[],"Este documento está dirigido tanto al administrador PKI, que necesita configurar el conector y registrar las CAs, como al desarrollador de firmware de dispositivos, que necesita entender cómo se nombran los Things, cómo funciona el Device Shadow y qué ocurre cuando un certificado se revoca. Para el desarrollador de firmware, el dato más importante es que el **nombre del Thing en AWS (ThingName) corresponde siempre al Common Name (CN) del certificado emitido por Lamassu**, independientemente del modo de aprovisionamiento.",{"_7979":408,"_22255":383,"_18887":33203,"_5":22404,"_15195":33115,"_1578":33204},[],"El conector de AWS IoT Core es un proceso Go independiente, un binario o contenedor separado del núcleo de Lamassu. En un despliegue monolítico se compila por defecto (etiqueta de compilación `!noaws`) y se activa mediante `aws_iot_manager.enabled: true` en el fichero de configuración. En despliegues distribuidos, se ejecuta como un contenedor propio con acceso a los servicios de CA, DMS Manager y Device Manager de Lamassu a través de HTTP.",{"_7979":409,"_22255":383,"_18887":33206,"_5":22404,"_15195":33115,"_1578":33207},[],"El conector no sondea los servicios de Lamassu periódicamente. En su lugar, **se suscribe al bus de eventos interno** de Lamassu (AMQP o AWS SQS/SNS, configurable) y reacciona a los eventos que le interesan: creación o actualización de CAs, creación o actualización de DMS, vinculación de identidad de dispositivo, cambio de estado de certificado, actualización de metadatos de certificado y actualización de metadatos de dispositivo. Este modelo orientado a eventos garantiza que la sincronización con AWS sea casi inmediata y no genere carga de sondeo.",{"_7979":410,"_22255":383,"_18887":33209,"_5":22404,"_15195":33115,"_1578":33210},[],"Para evitar bucles infinitos, el conector ignora cualquier evento cuyo campo `source` de CloudEvent coincida con su propia URI de origen. Esto previene que las escrituras de metadatos que el propio conector realiza vuelvan a disparar el mismo flujo.",{"_7979":411,"_22255":383,"_18887":33212,"_5":22404,"_15195":33115,"_1578":33213},[],"Cuando se ejecutan varios conectores en paralelo, por ejemplo, para distintas cuentas de AWS, cada instancia tiene su propio `connector_id`. Todos los metadatos que el conector escribe en Lamassu se almacenan bajo la clave `lamassu.io/iot/{connector_id}`, lo que permite coexistencia sin colisiones.",{"_7979":412,"_22255":383,"_18887":33215,"_5":22404,"_15195":33119,"_1578":33216},[],"Antes de activar el conector es necesario disponer de una cuenta AWS con los permisos IAM adecuados y tener el conector correctamente configurado. El proceso de despliegue (Docker Compose, Kubernetes o binario) se describe en la documentación de despliegue.",{"_7979":413,"_22255":383,"_18887":33218,"_5":22404,"_15195":33123,"_1578":33219},[],"La identidad IAM con la que opera el conector debe tener al mínimo los siguientes permisos sobre los recursos de la cuenta destino:",{"_7979":414,"_22255":383,"_18887":33221,"_5":22404,"_15195":33123,"_1578":33222},[],"Acción IAM",{"_7979":415,"_22255":383,"_18887":33224,"_5":22404,"_15195":33123,"_1578":33225},[],"Propósito",{"_7979":416,"_22255":383,"_18887":33227,"_5":22404,"_15195":33123,"_1578":33228},[],"`iot:GetRegistrationCode`",{"_7979":417,"_22255":383,"_18887":33230,"_5":22404,"_15195":33123,"_1578":33231},[],"Obtener el código de verificación para el registro de CA en Primary Account",{"_7979":418,"_22255":383,"_18887":33233,"_5":22404,"_15195":33123,"_1578":33234},[],"`iot:RegisterCACertificate`",{"_7979":419,"_22255":383,"_18887":33236,"_5":22404,"_15195":33123,"_1578":33237},[],"Registrar la CA en AWS IoT",{"_7979":420,"_22255":383,"_18887":33239,"_5":22404,"_15195":33123,"_1578":33240},[],"`iot:DescribeCACertificate`",{"_7979":421,"_22255":383,"_18887":33242,"_5":22404,"_15195":33123,"_1578":33243},[],"Consultar el estado del registro de la CA",{"_7979":422,"_22255":383,"_18887":33245,"_5":22404,"_15195":33123,"_1578":33246},[],"`iot:CreateThing` / `iot:UpdateThing`",{"_7979":423,"_22255":383,"_18887":33248,"_5":22404,"_15195":33123,"_1578":33249},[],"Crear o actualizar Things en IoT Core",{"_7979":424,"_22255":383,"_18887":33251,"_5":22404,"_15195":33123,"_1578":33252},[],"`iot:RegisterThing`",{"_7979":425,"_22255":383,"_18887":33254,"_5":22404,"_15195":33123,"_1578":33255},[],"Aprovisionar Things mediante plantilla",{"_7979":426,"_22255":383,"_18887":33257,"_5":22404,"_15195":33123,"_1578":33258},[],"`iot:RegisterCertificate`",{"_7979":427,"_22255":383,"_18887":33260,"_5":22404,"_15195":33123,"_1578":33261},[],"Registrar certificados de dispositivo",{"_7979":428,"_22255":383,"_18887":33263,"_5":22404,"_15195":33123,"_1578":33264},[],"`iot:UpdateCertificate`",{"_7979":429,"_22255":383,"_18887":33266,"_5":22404,"_15195":33123,"_1578":33267},[],"Cambiar el estado de un certificado (ACTIVE / INACTIVE / REVOKED)",{"_7979":430,"_22255":383,"_18887":33269,"_5":22404,"_15195":33123,"_1578":33270},[],"`iot:CreatePolicy` / `iot:AttachPolicy`",{"_7979":431,"_22255":383,"_18887":33272,"_5":22404,"_15195":33123,"_1578":33273},[],"Crear y adjuntar políticas IoT",{"_7979":432,"_22255":383,"_18887":33275,"_5":22404,"_15195":33123,"_1578":33276},[],"`iot:CreateThingGroup` / `iot:AddThingToThingGroup`",{"_7979":433,"_22255":383,"_18887":33278,"_5":22404,"_15195":33123,"_1578":33279},[],"Gestionar grupos de Things",{"_7979":434,"_22255":383,"_18887":33281,"_5":22404,"_15195":33123,"_1578":33282},[],"`iot:CreateProvisioningTemplate`",{"_7979":435,"_22255":383,"_18887":33284,"_5":22404,"_15195":33123,"_1578":33285},[],"Crear plantillas JITP",{"_7979":436,"_22255":383,"_18887":33287,"_5":22404,"_15195":33123,"_1578":33288},[],"`iotdata:GetThingShadow` / `iotdata:UpdateThingShadow`",{"_7979":437,"_22255":383,"_18887":33290,"_5":22404,"_15195":33123,"_1578":33291},[],"Leer y escribir el Device Shadow",{"_7979":438,"_22255":383,"_18887":33293,"_5":22404,"_15195":33123,"_1578":33294},[],"Para el mecanismo de desconexión forzada tras revocación también se requiere acceso a la API del plano de datos de AWS IoT (`iot:Connect` con SigV4 sobre WebSocket), que se negocia de forma implícita con las credenciales del conector.",{"_7979":439,"_22255":383,"_18887":33296,"_5":22404,"_15195":33127,"_1578":33297},[],"Parámetro",{"_7979":440,"_22255":383,"_18887":33299,"_5":22404,"_15195":33127,"_1578":33300},[],"Tipo",{"_7979":441,"_22255":383,"_18887":33302,"_5":22404,"_15195":33127,"_1578":33303},[],"Requerido",{"_7979":442,"_22255":383,"_18887":33305,"_5":22404,"_15195":33127,"_1578":32169},[],{"_7979":443,"_22255":383,"_18887":33307,"_5":22404,"_15195":33127,"_1578":33308},[],"`connector_id`",{"_7979":444,"_22255":383,"_18887":33310,"_5":22404,"_15195":33127,"_1578":11602},[],{"_7979":445,"_22255":383,"_18887":33312,"_5":22404,"_15195":33127,"_1578":33313},[],"Sí",{"_7979":446,"_22255":383,"_18887":33315,"_5":22404,"_15195":33127,"_1578":33316},[],"Identificador único de esta instancia del conector. Se usa como espacio de nombres para los metadatos: `lamassu.io/iot/{connector_id}`.",{"_7979":447,"_22255":383,"_18887":33318,"_5":22404,"_15195":33127,"_1578":33319},[],"`aws_config.region`",{"_7979":448,"_22255":383,"_18887":33321,"_5":22404,"_15195":33127,"_1578":11602},[],{"_7979":449,"_22255":383,"_18887":33323,"_5":22404,"_15195":33127,"_1578":33313},[],{"_7979":450,"_22255":383,"_18887":33325,"_5":22404,"_15195":33127,"_1578":33326},[],"Región AWS donde opera el conector.",{"_7979":451,"_22255":383,"_18887":33328,"_5":22404,"_15195":33127,"_1578":33329},[],"`aws_config.auth_method`",{"_7979":452,"_22255":383,"_18887":33331,"_5":22404,"_15195":33127,"_1578":11602},[],{"_7979":453,"_22255":383,"_18887":33333,"_5":22404,"_15195":33127,"_1578":33313},[],{"_7979":454,"_22255":383,"_18887":33335,"_5":22404,"_15195":33127,"_1578":33336},[],"Método de autenticación: `static`, `role` o vacío (cadena de credenciales por defecto del SDK).",{"_7979":455,"_22255":383,"_18887":33338,"_5":22404,"_15195":33127,"_1578":33339},[],"`aws_config.access_key_id`",{"_7979":456,"_22255":383,"_18887":33341,"_5":22404,"_15195":33127,"_1578":11602},[],{"_7979":457,"_22255":383,"_18887":33343,"_5":22404,"_15195":33127,"_1578":33344},[],"Solo con `auth_method=static`",{"_7979":458,"_22255":383,"_18887":33346,"_5":22404,"_15195":33127,"_1578":33347},[],"Clave de acceso AWS.",{"_7979":459,"_22255":383,"_18887":33349,"_5":22404,"_15195":33127,"_1578":33350},[],"`aws_config.secret_access_key`",{"_7979":460,"_22255":383,"_18887":33352,"_5":22404,"_15195":33127,"_1578":11602},[],{"_7979":461,"_22255":383,"_18887":33354,"_5":22404,"_15195":33127,"_1578":33344},[],{"_7979":462,"_22255":383,"_18887":33356,"_5":22404,"_15195":33127,"_1578":33357},[],"Clave secreta AWS.",{"_7979":463,"_22255":383,"_18887":33359,"_5":22404,"_15195":33127,"_1578":33360},[],"`aws_config.session_token`",{"_7979":464,"_22255":383,"_18887":33362,"_5":22404,"_15195":33127,"_1578":11602},[],{"_7979":465,"_22255":383,"_18887":33364,"_5":22404,"_15195":33127,"_1578":33365},[],"No",{"_7979":466,"_22255":383,"_18887":33367,"_5":22404,"_15195":33127,"_1578":33368},[],"Token de sesión (con `auth_method=static`).",{"_7979":467,"_22255":383,"_18887":33370,"_5":22404,"_15195":33127,"_1578":33371},[],"`aws_config.role_arn`",{"_7979":468,"_22255":383,"_18887":33373,"_5":22404,"_15195":33127,"_1578":11602},[],{"_7979":469,"_22255":383,"_18887":33375,"_5":22404,"_15195":33127,"_1578":33376},[],"Solo con `auth_method=role`",{"_7979":470,"_22255":383,"_18887":33378,"_5":22404,"_15195":33127,"_1578":33379},[],"ARN del rol a asumir.",{"_7979":471,"_22255":383,"_18887":33381,"_5":22404,"_15195":33127,"_1578":33382},[],"`aws_config.endpoint_url`",{"_7979":472,"_22255":383,"_18887":33384,"_5":22404,"_15195":33127,"_1578":11602},[],{"_7979":473,"_22255":383,"_18887":33386,"_5":22404,"_15195":33127,"_1578":33365},[],{"_7979":474,"_22255":383,"_18887":33388,"_5":22404,"_15195":33127,"_1578":33389},[],"URL alternativa para todos los servicios AWS (útil con LocalStack en pruebas).",{"_7979":475,"_22255":383,"_18887":33391,"_5":22404,"_15195":33127,"_1578":33392},[],"`subscriber_event_bus`",{"_7979":476,"_22255":383,"_18887":33394,"_5":22404,"_15195":33127,"_1578":19192},[],{"_7979":477,"_22255":383,"_18887":33396,"_5":22404,"_15195":33127,"_1578":33313},[],{"_7979":478,"_22255":383,"_18887":33398,"_5":22404,"_15195":33127,"_1578":33399},[],"Configuración del bus de eventos al que se suscribe el conector (AMQP o AWS SQS/SNS).",{"_7979":479,"_22255":383,"_18887":33401,"_5":22404,"_15195":33127,"_1578":33402},[],"`dms_manager_client`",{"_7979":480,"_22255":383,"_18887":33404,"_5":22404,"_15195":33127,"_1578":11602},[],{"_7979":481,"_22255":383,"_18887":33406,"_5":22404,"_15195":33127,"_1578":33313},[],{"_7979":482,"_22255":383,"_18887":33408,"_5":22404,"_15195":33127,"_1578":33409},[],"URL HTTP del servicio DMS Manager de Lamassu.",{"_7979":483,"_22255":383,"_18887":33411,"_5":22404,"_15195":33127,"_1578":33412},[],"`device_manager_client`",{"_7979":484,"_22255":383,"_18887":33414,"_5":22404,"_15195":33127,"_1578":11602},[],{"_7979":485,"_22255":383,"_18887":33416,"_5":22404,"_15195":33127,"_1578":33313},[],{"_7979":486,"_22255":383,"_18887":33418,"_5":22404,"_15195":33127,"_1578":33419},[],"URL HTTP del Device Manager de Lamassu.",{"_7979":487,"_22255":383,"_18887":33421,"_5":22404,"_15195":33127,"_1578":33422},[],"`ca_client`",{"_7979":488,"_22255":383,"_18887":33424,"_5":22404,"_15195":33127,"_1578":11602},[],{"_7979":489,"_22255":383,"_18887":33426,"_5":22404,"_15195":33127,"_1578":33313},[],{"_7979":490,"_22255":383,"_18887":33428,"_5":22404,"_15195":33127,"_1578":33429},[],"URL HTTP del servicio de CA de Lamassu.",{"_7979":491,"_22255":383,"_18887":33431,"_5":22404,"_15195":33131,"_1578":33432},[],"Para que los dispositivos puedan autenticarse en AWS IoT Core con certificados emitidos por una CA de Lamassu, esa CA debe registrarse previamente en la cuenta AWS. El conector gestiona este registro de forma automática en respuesta a los eventos `EventCreateCAKey`, `EventImportCAKey` y `EventUpdateCAMetadataKey`, pero la operación **solo se dispara cuando el administrador la solicita explícitamente** mediante el campo de metadatos de la CA.",{"_7979":492,"_22255":383,"_18887":33434,"_5":22404,"_15195":33135,"_1578":33435},[],"El registro se desencadena estableciendo el valor `registration.status = \"REQUESTED\"` en la clave `lamassu.io/iot/{connector_id}` de los metadatos de la CA. Esto puede hacerse desde la consola de Lamassu en la sección de gestión de la CA o mediante la API.",{"_7979":493,"_22255":383,"_18887":33437,"_5":22404,"_15195":33135,"_1578":33438},[],"Una vez recibido el evento, el conector intenta registrar la CA en AWS y actualiza el campo `registration.status` en los metadatos de la CA con el resultado: `\"SUCCEEDED\"` si el registro fue correcto, o `\"FAILED\"` acompañado de un mensaje de error en caso contrario. El proceso es asíncrono, por lo que es necesario consultar periódicamente el estado de los metadatos hasta que la operación concluya.",{"_7979":494,"_22255":383,"_18887":33440,"_5":22404,"_15195":33139,"_1578":33441},[],"Cuando el parámetro `primary_account` es `true`, el conector ejecuta el flujo completo de registro con verificación de posesión de clave privada:",{"_7979":495,"_22255":383,"_18887":33443,"_5":22404,"_15195":33139,"_1578":33444},[],"Llama a `iot:GetRegistrationCode` para obtener el código de verificación de AWS.",{"_7979":496,"_22255":383,"_18887":33446,"_5":22404,"_15195":33139,"_1578":33447},[],"El conector genera internamente un par de claves RSA-2048 efímero y construye un CSR cuyo Common Name es exactamente ese código de registro. A continuación llama al servicio de firma de Lamassu para que la CA registrada emita un certificado de verificación X.509 real firmando ese CSR. La clave privada efímera se usa únicamente para este propósito y no se almacena ni se envía a AWS.",{"_7979":497,"_22255":383,"_18887":33449,"_5":22404,"_15195":33139,"_1578":33450},[],"Envía a AWS la CA (en PEM) y el certificado de verificación mediante `iot:RegisterCACertificate`, activando el registro con `AllowAutoRegistration: true`.",{"_7979":498,"_22255":383,"_18887":33452,"_5":22404,"_15195":33139,"_1578":33453},[],"Solo una cuenta puede ser propietaria de una CA en una región AWS dada. Si la CA ya está registrada con el mismo número de serie, el conector omite el paso silenciosamente.",{"_7979":499,"_22255":383,"_18887":33455,"_5":22404,"_15195":33139,"_1578":33456},[],"Los tags que AWS IoT Core aplica al certificado de CA registrado son `LMS.CA.ID`, `LMS.CA.SN` y `LMS.CA.CN`.",{"_7979":500,"_22255":383,"_18887":33458,"_5":22404,"_15195":33143,"_1578":33459},[],"Cuando `primary_account` es `false`, el conector registra la CA usando el modo `CertificateMode: SNI_ONLY`. Este modo no requiere código de verificación ni acceso a la clave privada de la CA, por lo que es la opción adecuada cuando la CA se gestiona desde otra cuenta de AWS o cuando el administrador no dispone de la clave privada. Es el método habitual para registrar la misma CA en varias cuentas de AWS simultáneamente.",{"_7979":501,"_22255":383,"_18887":33461,"_5":22404,"_15195":33147,"_1578":33462},[],"Cada DMS que participe en la integración con AWS IoT Core debe tener configurada la clave de metadatos `lamassu.io/iot/{connector_id}`. El campo más importante de esa configuración es `registration_mode`, que determina cómo se aprovisionan los dispositivos en AWS.",{"_7979":502,"_22255":383,"_18887":33464,"_5":22404,"_15195":33147,"_1578":33465},[],"Existen tres modos de registro, y la elección entre ellos depende de la estrategia de aprovisionamiento de la flota.",{"_7979":503,"_22255":383,"_18887":33467,"_5":22404,"_15195":33151,"_1578":33468},[],"En este modo el conector **no crea Things, grupos ni políticas** en AWS IoT Core. Se limita a sincronizar el estado de los certificados (activo, revocado, suspendido) a medida que cambian en Lamassu. Es el modo adecuado cuando el aprovisionamiento de Things en AWS se gestiona por un sistema externo y solo se necesita que Lamassu mantenga el estado de los certificados actualizado.",{"_7979":504,"_22255":383,"_18887":33470,"_5":22404,"_15195":33155,"_1578":33471},[],"El modo `auto` delega en Lamassu el aprovisionamiento completo del dispositivo en AWS en el momento del enrolamiento. Cuando el dispositivo completa con éxito su enrolamiento EST y Lamassu emite el evento `EventBindDeviceIdentityKey`, el conector ejecuta automáticamente la siguiente secuencia:",{"_7979":505,"_22255":383,"_18887":33473,"_5":22404,"_15195":33155,"_1578":33474},[],"Crea o actualiza las políticas IoT configuradas en el DMS.",{"_7979":506,"_22255":383,"_18887":33476,"_5":22404,"_15195":33155,"_1578":33477},[],"Crea el grupo raíz `LAMASSU` en la cuenta AWS (si no existe) y los grupos hijos configurados en el DMS como subgrupos de `LAMASSU`. Si los grupos ya existen, el error `ResourceAlreadyExistsException` se ignora, por lo que la operación es idempotente.",{"_7979":507,"_22255":383,"_18887":33479,"_5":22404,"_15195":33155,"_1578":33480},[],"Si el Thing ya existía en AWS IoT Core, el conector itera todos los certificados (principals) actualmente adjuntos a ese Thing y los marca como `REVOKED` en AWS, para garantizar que los certificados anteriores no puedan seguir siendo usados para autenticarse.",{"_7979":508,"_22255":383,"_18887":33482,"_5":22404,"_15195":33155,"_1578":33483},[],"Llama a `iot:RegisterThing` con una plantilla de aprovisionamiento de estilo CloudFormation que crea el Thing, registra el certificado del dispositivo (PEM del certificado del dispositivo y del certificado de la CA emisora) y adjunta las políticas configuradas.\nUna vez completado el aprovisionamiento, el conector almacena el ARN del certificado resultante en los metadatos del certificado de Lamassu bajo la clave `lamassu.io/iot/{connector_id}` y marca el dispositivo como `Registered: true` en Device Manager.",{"_7979":509,"_22255":383,"_18887":33485,"_5":22404,"_15195":33155,"_1578":33486},[],"**El nombre del Thing en AWS es el Common Name (CN) del certificado del dispositivo.** Esta convención es fundamental para el desarrollador de firmware: el valor `/CN=` que el dispositivo incluye en su CSR al enrolarse se convierte en el ThingName con el que deberá identificarse en todas las operaciones MQTT contra AWS IoT Core.",{"_7979":510,"_22255":383,"_18887":33488,"_5":22404,"_15195":33159,"_1578":33489},[],"El modo Just-In-Time Provisioning (JITP) delega el aprovisionamiento en AWS en lugar de hacerlo el conector directamente. Cuando el conector detecta que el DMS está en modo `jitp`, crea una plantilla de aprovisionamiento JITP en AWS IoT Core y la adjunta al certificado de CA registrado. Esta plantilla se crea o actualiza en el momento en que el DMS se crea o actualiza en Lamassu - no en el momento del enrolamiento del dispositivo. A partir de ese momento, cuando un dispositivo con un certificado emitido por esa CA se conecta por primera vez a AWS IoT Core, AWS ejecuta la plantilla automáticamente: crea el Thing, registra el certificado y lo activa.",{"_7979":511,"_22255":383,"_18887":33491,"_5":22404,"_15195":33159,"_1578":33492},[],"El nombre del Thing en la plantilla JITP se deriva de `AWS::IoT::Certificate::CommonName`, que corresponde al CN del certificado del dispositivo - la misma convención que el modo `auto`.",{"_7979":512,"_22255":383,"_18887":33494,"_5":22404,"_15195":33159,"_1578":33495},[],"Este modo requiere que se configure el campo `jitp_config.provisioning_role_arn` con el ARN de un rol IAM que AWS IoT Core pueda asumir para ejecutar la plantilla. Si no se configura, el conector utiliza el valor por defecto `arn:aws:iam::{account}:role/JITPRole` y registra un aviso en el log. El administrador debe asegurarse de que ese rol existe en la cuenta y tiene los permisos necesarios antes de activar el modo JITP.",{"_7979":513,"_22255":383,"_18887":33497,"_5":22404,"_15195":33163,"_1578":33498},[],"Para el desarrollador de firmware, el modo `auto` es transparente: el dispositivo realiza su enrolamiento EST de la forma habitual y, como efecto secundario, queda aprovisionado en AWS IoT Core sin ningún paso adicional.",{"_7979":514,"_22255":383,"_18887":33500,"_5":22404,"_15195":33163,"_1578":33501},[],"El flujo completo desde el punto de vista del dispositivo es el siguiente:",{"_7979":515,"_22255":383,"_18887":33503,"_5":22404,"_15195":33163,"_1578":33504},[],"Una vez que el conector completa el aprovisionamiento, el dispositivo puede conectarse al endpoint AWS IoT Core de MQTT usando su clave privada y el certificado emitido por Lamassu. El ThingName con el que debe identificarse en AWS es exactamente el CN del certificado.",{"_7979":516,"_22255":383,"_18887":33506,"_5":22404,"_15195":33167,"_1578":33507},[],"En el modo JITP el dispositivo también realiza su enrolamiento EST de forma convencional y obtiene su certificado de Lamassu. La diferencia es que AWS IoT Core no conoce al dispositivo hasta que este intenta conectarse por primera vez.",{"_7979":517,"_22255":383,"_18887":33509,"_5":22404,"_15195":33167,"_1578":33510},[],"Cuando el dispositivo establece su primera conexión MQTT a AWS IoT Core presentando el certificado emitido por Lamassu, AWS detecta que el certificado pertenece a una CA registrada con una plantilla JITP, ejecuta esa plantilla y crea el Thing automáticamente. La conexión inicial puede fallar o demorarse mientras se ejecuta la plantilla; el firmware debe estar preparado para reintentar la conexión.",{"_7979":518,"_22255":383,"_18887":33512,"_5":22404,"_15195":33167,"_1578":33513},[],"Para que el flujo JITP funcione correctamente:",{"_7979":519,"_22255":383,"_18887":33515,"_5":22404,"_15195":33167,"_1578":33516},[],"La CA debe estar registrada en AWS en modo Primary Account (el modo SNI-only no admite JITP).",{"_7979":520,"_22255":383,"_18887":33518,"_5":22404,"_15195":33167,"_1578":33519},[],"El rol IAM configurado en `jitp_config.provisioning_role_arn` debe existir y tener permisos para crear Things, registrar certificados y adjuntar políticas en la cuenta AWS.",{"_7979":521,"_22255":383,"_18887":33521,"_5":22404,"_15195":33167,"_1578":33522},[],"El dispositivo debe presentar tanto su certificado como el certificado de la CA emisora en el handshake TLS con AWS IoT Core.",{"_7979":522,"_22255":383,"_18887":33524,"_5":22404,"_15195":33167,"_1578":33525},[],"Los certificados aprovisionados mediante JITP **no tienen asociada la clave de metadatos del conector** (`lamassu.io/iot/{connector_id}`) en Lamassu. Como consecuencia, los cambios de estado de esos certificados en Lamassu no se sincronizan automáticamente con AWS a través del mecanismo de sincronización de estado descrito en la siguiente sección.",{"_7979":523,"_22255":383,"_18887":33527,"_5":22404,"_15195":33171,"_1578":33528},[],"El conector escucha el evento `EventUpdateCertificateStatusKey` y, cuando un certificado que tiene la clave de metadatos del conector cambia de estado en Lamassu, replica ese cambio en AWS IoT Core. La tabla siguiente muestra la correspondencia de estados:",{"_7979":524,"_22255":383,"_18887":33530,"_5":22404,"_15195":33171,"_1578":33531},[],"Estado en Lamassu",{"_7979":525,"_22255":383,"_18887":33533,"_5":22404,"_15195":33171,"_1578":33534},[],"Razón de revocación",{"_7979":526,"_22255":383,"_18887":33536,"_5":22404,"_15195":33171,"_1578":33537},[],"Estado en AWS IoT Core",{"_7979":527,"_22255":383,"_18887":33539,"_5":22404,"_15195":33171,"_1578":33540},[],"`Active`",{"_7979":528,"_22255":383,"_18887":33542,"_5":22404,"_15195":33171,"_1578":33543},[],"—",{"_7979":529,"_22255":383,"_18887":33545,"_5":22404,"_15195":33171,"_1578":33546},[],"`ACTIVE`",{"_7979":530,"_22255":383,"_18887":33548,"_5":22404,"_15195":33171,"_1578":33549},[],"`Revoked`",{"_7979":531,"_22255":383,"_18887":33551,"_5":22404,"_15195":33171,"_1578":33552},[],"`certificateHold`",{"_7979":532,"_22255":383,"_18887":33554,"_5":22404,"_15195":33171,"_1578":33555},[],"`INACTIVE`",{"_7979":533,"_22255":383,"_18887":33557,"_5":22404,"_15195":33171,"_1578":33549},[],{"_7979":534,"_22255":383,"_18887":33559,"_5":22404,"_15195":33171,"_1578":33560},[],"Cualquier otra razón",{"_7979":535,"_22255":383,"_18887":33562,"_5":22404,"_15195":33171,"_1578":33563},[],"`REVOKED`",{"_7979":536,"_22255":383,"_18887":33565,"_5":22404,"_15195":33171,"_1578":33566},[],"Solo los estados `Active` y `Revoked` producen una llamada a `iot:UpdateCertificate`. Los demás estados del ciclo de vida de Lamassu (`RenewalWindow`, `AboutToExpire`, `Expired`) no se sincronizan con AWS IoT Core; el estado del certificado en AWS permanece sin cambios hasta que el estado en Lamassu sea `Active` o `Revoked`.",{"_7979":537,"_22255":383,"_18887":33568,"_5":22404,"_15195":33175,"_1578":33569},[],"Cuando el conector marca un certificado como `REVOKED` o `INACTIVE` en AWS, ejecuta adicionalmente una desconexión forzada del dispositivo. Para ello abre una conexión MQTT sobre WebSocket (con autenticación SigV4 con las credenciales del conector) al endpoint de datos de AWS IoT Core, usando el CN del certificado como identificador de cliente MQTT, y la cierra inmediatamente. Esto termina cualquier sesión MQTT activa que el dispositivo pueda tener en ese momento.",{"_7979":538,"_22255":383,"_18887":33571,"_5":22404,"_15195":33175,"_1578":33572},[],"Esta desconexión forzada se produce en el momento en que Lamassu registra el cambio de estado. Si el dispositivo vuelve a intentar conectarse tras la desconexión, AWS IoT Core rechazará la conexión porque el certificado ya figura como `REVOKED` o `INACTIVE`.",{"_7979":539,"_22255":383,"_18887":33574,"_5":22404,"_15195":33175,"_1578":33575},[],"Los certificados aprovisionados en modo JITP no disponen de esta sincronización automática, ya que no tienen la clave de metadatos del conector.",{"_7979":540,"_22255":383,"_18887":33577,"_5":22404,"_15195":33179,"_1578":33578},[],"El conector puede escribir en el Device Shadow de AWS IoT Core para enviar señales de acción al firmware del dispositivo. Esta funcionalidad se activa por DMS mediante `shadow_config.enable: true`.",{"_7979":541,"_22255":383,"_18887":33580,"_5":22404,"_15195":33179,"_1578":33581},[],"Si `shadow_config.shadow_name` contiene un valor, el conector usa un Named Shadow con ese nombre; en caso contrario, usa el Classic Shadow (shadow predeterminado del Thing).",{"_7979":542,"_22255":383,"_18887":33583,"_5":22404,"_15195":33183,"_1578":33584},[],"El conector escribe en el campo `desired.identity_actions` del documento shadow. Cada entrada contiene un timestamp Unix en milisegundos. El firmware del dispositivo debe leer este campo y actuar en consecuencia.",{"_7979":543,"_22255":383,"_18887":33586,"_5":22404,"_15195":33183,"_1578":33587},[],"Existen dos tipos de acciones:",{"_7979":544,"_22255":383,"_18887":33589,"_5":22404,"_15195":33183,"_1578":33590},[],"**`UPDATE_CERTIFICATE`**: se escribe cuando la ventana de renovación preventiva de un certificado se activa - es decir, cuando el campo `triggered` de la delta de renovación preventiva pasa de `false` a `true`. Esta acción indica al dispositivo que debe iniciar el proceso de re-enrolamiento para renovar su certificado antes de que expire.",{"_7979":545,"_22255":383,"_18887":33592,"_5":22404,"_15195":33183,"_1578":33593},[],"**`UPDATE_TRUST_ANCHOR_LIST`**: se escribe en todos los dispositivos de un DMS cuando la lista `ManagedCAs` del DMS cambia. Esta acción indica al dispositivo que debe actualizar su almacén de CAs de confianza.",{"_7979":546,"_22255":383,"_18887":33595,"_5":22404,"_15195":33183,"_1578":33596},[],"El proceso de escritura en el shadow consiste en leer el shadow actual (`iotdata:GetThingShadow`), combinar las nuevas acciones con las existentes y escribir el resultado (`iotdata:UpdateThingShadow`). Si el shadow no existe, el conector lo crea. Tras una escritura correcta, la lista de acciones pendientes en los metadatos del dispositivo en Lamassu se limpia.",{"_7979":547,"_22255":383,"_18887":33598,"_5":22404,"_15195":33187,"_1578":33599},[],"El conector crea y adjunta las políticas que se configuran en el DMS. Una política típica para un dispositivo que usa MQTT y Device Shadow tiene la siguiente estructura:",{"_7979":548,"_22255":383,"_18887":33601,"_5":22404,"_15195":33187,"_1578":33602},[],"En la política anterior, los marcadores `<AWS_REGION>` y `<AWS_ACCOUNT_ID>` deben reemplazarse por la región AWS y el identificador de cuenta de doce dígitos de la cuenta destino antes de aplicar la política. La variable `${iot:Connection.Thing.ThingName}` limita automáticamente cada permiso al Thing al que el dispositivo está conectado, siguiendo el principio de mínimo privilegio. La variable `${ShadowName}` en los ARN de shadow es un marcador que debe reemplazarse con el valor de `shadow_config.shadow_name` configurado en el DMS; si se usa el Classic Shadow, se puede simplificar eliminando el segmento `name/${ShadowName}/`. Las políticas de AWS IoT no admiten expresiones regulares con alternancia; la notación `[name/${ShadowName}/]*` representa la opcionalidad del segmento dentro de las restricciones de la sintaxis de ARN.",{"_7979":549,"_22255":383,"_18887":33604,"_5":22404,"_15195":33187,"_1578":33605},[],"El primer statement permite que el dispositivo se conecte usando su ThingName como identificador MQTT. El segundo autoriza la publicación en el topic MQTT genérico del Thing y en los topics del shadow, necesario para que el dispositivo pueda actualizar el estado reportado. Los dos últimos statements otorgan permisos de suscripción y recepción sobre los mismos topics, lo que permite al dispositivo recibir actualizaciones del shadow (por ejemplo, las acciones `UPDATE_CERTIFICATE` y `UPDATE_TRUST_ANCHOR_LIST` escritas por el conector).",{"_7979":550,"_22255":383,"_18887":33607,"_5":22404,"_15195":33191,"_1578":33608},[],"**Síntoma:** El registro de la CA permanece indefinidamente en estado `REQUESTED`.",{"_7979":551,"_22255":383,"_18887":33610,"_5":22404,"_15195":33191,"_1578":33611},[],"**Causa:** El conector no está en ejecución o no está suscrito al bus de eventos. También puede indicar credenciales IAM incorrectas, permisos insuficientes o que la clave de metadatos se escribió con un `connector_id` incorrecto.",{"_7979":552,"_22255":383,"_18887":33613,"_5":22404,"_15195":33191,"_1578":33614},[],"**Resolución:** Verificar que el proceso del conector está activo y que los logs no muestran errores de comunicación con AWS. Comprobar que el campo de metadatos se escribió bajo la clave exacta `lamassu.io/iot/{connector_id}`. Si el error persiste, el conector actualizará el estado a `FAILED` con un mensaje descriptivo en los metadatos de la CA.",{"_7979":553,"_22255":383,"_18887":33616,"_5":22404,"_15195":33191,"_1578":33617},[],"**Síntoma:** El estado de un certificado no se sincroniza con AWS tras una revocación.",{"_7979":554,"_22255":383,"_18887":33619,"_5":22404,"_15195":33191,"_1578":33620},[],"**Causa:** Lo más habitual es que el certificado fue aprovisionado en modo JITP. Los certificados JITP no tienen la clave de metadatos del conector y quedan fuera del mecanismo de sincronización de estado. Si el DMS está en modo `auto`, puede indicar que el aprovisionamiento inicial no completó correctamente y el ARN de AWS no se almacenó en los metadatos del certificado.",{"_7979":555,"_22255":383,"_18887":33622,"_5":22404,"_15195":33191,"_1578":33623},[],"**Resolución:** Para certificados JITP, migrar el DMS a modo `auto` y re-aprovisionar los dispositivos afectados. Para certificados en modo `auto`, verificar que el certificado tiene el ARN de AWS almacenado en sus metadatos; si no lo tiene, repetir el aprovisionamiento.",{"_7979":556,"_22255":383,"_18887":33625,"_5":22404,"_15195":33191,"_1578":33626},[],"**Síntoma:** La desconexión forzada no termina la sesión MQTT del dispositivo tras la revocación.",{"_7979":557,"_22255":383,"_18887":33628,"_5":22404,"_15195":33191,"_1578":33629},[],"**Causa:** El dispositivo usa un client ID MQTT diferente al CN del certificado. La desconexión forzada abre una conexión usando el CN como client ID; si el firmware usa otro identificador, la desconexión no afecta a esa sesión.",{"_7979":558,"_22255":383,"_18887":33631,"_5":22404,"_15195":33191,"_1578":33632},[],"**Resolución:** Asegurarse de que el firmware usa exactamente el CN del certificado como identificador de cliente MQTT. Ese CN coincide con el ThingName en AWS IoT Core.",{"_7979":559,"_22255":383,"_18887":33634,"_5":22404,"_15195":33191,"_1578":33635},[],"**Síntoma:** El dispositivo recibe `CLIENT_ID_REJECTED` al conectarse a AWS IoT Core.",{"_7979":560,"_22255":383,"_18887":33637,"_5":22404,"_15195":33191,"_1578":33638},[],"**Causa:** El client ID MQTT no coincide con el ThingName, que es siempre el CN del certificado emitido por Lamassu.",{"_7979":561,"_22255":383,"_18887":33640,"_5":22404,"_15195":33191,"_1578":33641},[],"**Resolución:** Verificar que el firmware usa exactamente el valor del campo CN incluido en el CSR de enrolamiento como identificador de cliente MQTT.",{"_7979":562,"_22255":383,"_18887":33643,"_5":22404,"_15195":33191,"_1578":33644},[],"**Síntoma:** La primera conexión MQTT del dispositivo en modo JITP falla o excede el tiempo de espera.",{"_7979":563,"_22255":383,"_18887":33646,"_5":22404,"_15195":33191,"_1578":33647},[],"**Causa:** Es el comportamiento esperado mientras AWS ejecuta la plantilla JITP en la primera conexión del dispositivo.",{"_7979":564,"_22255":383,"_18887":33649,"_5":22404,"_15195":33191,"_1578":33650},[],"**Resolución:** El firmware debe implementar reintentos con backoff exponencial para la primera conexión. Si el fallo persiste más allá de unos minutos, verificar que el rol IAM configurado en `jitp_config.provisioning_role_arn` existe en la cuenta y tiene permisos para crear Things, registrar certificados y adjuntar políticas.",{"_7979":565,"_22255":383,"_18887":33652,"_5":22404,"_15195":33191,"_1578":33653},[],"**Síntoma:** El Device Shadow no se actualiza cuando debería.",{"_7979":566,"_22255":383,"_18887":33655,"_5":22404,"_15195":33191,"_1578":33656},[],"**Causa:** La función de shadow está desactivada en la configuración del DMS, las credenciales del conector carecen de permisos sobre la API de datos de IoT, o el firmware lee un shadow diferente al configurado.",{"_7979":567,"_22255":383,"_18887":33658,"_5":22404,"_15195":33191,"_1578":33659},[],"**Resolución:** Comprobar que `shadow_config.enable` está a `true` en los metadatos del conector para el DMS correspondiente. Si se usa Named Shadow, verificar que `shadow_config.shadow_name` contiene el nombre correcto y que el firmware lee ese Named Shadow y no el Classic Shadow. Confirmar que las credenciales del conector tienen permisos `iotdata:GetThingShadow` y `iotdata:UpdateThingShadow`.",{"_7979":568,"_22255":383,"_18887":33661,"_5":22404,"_15195":33191,"_1578":33662},[],"<Card title=\"Configurar un DMS\" href=\"/docs/manual/servicios-core/ra\" />",{"_7979":569,"_22255":383,"_18887":33664,"_5":22404,"_15195":33191,"_1578":33665},[],"<Card title=\"Enrolamiento de dispositivos (EST)\" href=\"/docs/manual/servicios-core/est\" />",{"_7979":570,"_22255":383,"_18887":33667,"_5":22404,"_15195":33191,"_1578":33668},[],"<Card title=\"Gestión de certificados\" href=\"/docs/manual/servicios-core/certificates\" />",{"_7979":571,"_22255":571,"_5":22399,"_1578":33670,"_22412":33671,"_18887":33672,"_15195":571},"[Alerts] Alertas y Suscripciones",[31966,33065,33074],[],{"_7979":572,"_22255":571,"_18887":33674,"_5":22404,"_15195":571,"_1578":33675},[],"Monitorización proactiva mediante eventos y suscripciones",{"_7979":573,"_22255":571,"_5":22409,"_18887":33677,"_15195":33678,"_1578":33679},[],"/docs/pr-preview/pr-23/manual/servicios-core/alerts#alertas","Alertas",{"_7979":574,"_22255":571,"_5":22409,"_18887":33681,"_15195":33682,"_1578":33683},[],"/docs/pr-preview/pr-23/manual/servicios-core/alerts#eventos-y-suscripciones","Eventos y Suscripciones",{"_7979":575,"_22255":571,"_5":22409,"_18887":33685,"_15195":33686,"_1578":33687},[],"/docs/pr-preview/pr-23/manual/servicios-core/alerts#gestión-de-suscripciones","Gestión de Suscripciones",{"_7979":576,"_22255":571,"_5":22409,"_18887":33689,"_15195":33690,"_1578":33691},[],"/docs/pr-preview/pr-23/manual/servicios-core/alerts#filtros-y-condiciones","Filtros y condiciones",{"_7979":577,"_22255":571,"_5":22409,"_18887":33693,"_15195":33694,"_1578":33695},[],"/docs/pr-preview/pr-23/manual/servicios-core/alerts#confirmación-de-la-suscripción","Confirmación de la suscripción",{"_7979":578,"_22255":571,"_5":22409,"_18887":33697,"_15195":33698,"_1578":33699},[],"/docs/pr-preview/pr-23/manual/servicios-core/alerts#gestión-de-suscripciones-existentes","Gestión de Suscripciones Existentes",{"_7979":579,"_22255":571,"_5":22409,"_18887":33701,"_15195":33702,"_1578":33703},[],"/docs/pr-preview/pr-23/manual/servicios-core/alerts#catálogo-de-eventos-del-sistema","Catálogo de Eventos del Sistema",{"_7979":580,"_22255":571,"_18887":33705,"_5":22404,"_15195":33678,"_1578":33706},[],"La funcionalidad de **Alertas** en Lamassu IoT es una herramienta avanzada para la monitorización y la observación del estado de la PKI. Va más allá de la simple visualización, permitiendo a los usuarios **reaccionar de forma proactiva y automatizada** a los eventos que ocurren en la infraestructura. Esta capacidad es crucial en entornos de IoT, donde el número de dispositivos y la frecuencia de las operaciones hacen inviable la monitorización manual. A través de la gestión de suscripciones, los administradores pueden asegurarse de que eventos críticos, como la revocación de un certificado o la detección de un intento de registro fallido, no pasen desapercibidos, lo que mejora la seguridad y la resiliencia del sistema.",{"_7979":581,"_22255":571,"_18887":33708,"_5":22404,"_15195":33682,"_1578":33709},[],"La página principal de alertas presenta una lista exhaustiva de todos los **tipos de eventos** que pueden ser generados por la PKI de Lamassu IoT. Estos eventos cubren un amplio espectro de actividades, desde operaciones de ciclo de vida de certificados y dispositivos hasta cambios de estado en las RA. Para cada tipo de evento, la interfaz proporciona un conjunto de métricas clave que facilitan la toma de decisiones:",{"_7979":582,"_22255":571,"_18887":33711,"_5":22404,"_15195":33682,"_1578":33712},[],"**Last Seen**: Muestra cuándo ocurrió la última instancia del evento. Esto ayuda a identificar si un evento es recurrente o si ha ocurrido recientemente, lo cual es fundamental para el diagnóstico.",{"_7979":583,"_22255":571,"_18887":33714,"_5":22404,"_15195":33682,"_1578":33715},[],"**Counter**: Indica el número total de veces que el evento ha sido registrado en el sistema. Un contador alto puede señalar una tendencia, un problema subyacente en un dispositivo o una configuración errónea.",{"_7979":584,"_22255":571,"_18887":33717,"_5":22404,"_15195":33682,"_1578":33718},[],"**Subscriptions**: Informa si ya existen suscripciones activas para ese evento, evitando la creación de suscripciones duplicadas y proporcionando una visión general de la monitorización ya implementada.",{"_7979":585,"_22255":571,"_18887":33720,"_5":22404,"_15195":33682,"_1578":33721},[],"**Actions**: El botón **Subscribe** permite iniciar el proceso de creación de una nueva suscripción, adaptada a las necesidades específicas del usuario o equipo.",{"_7979":586,"_22255":571,"_18887":33723,"_5":22404,"_15195":33682,"_1578":33724},[],"Adicionalmente, al expandir la información de cada evento, se presenta un **ejemplo de la estructura de datos JSON** de la última instancia registrada. Esta información es de gran valor, ya que permite a los desarrolladores y administradores entender con precisión el esquema de la notificación y cómo procesarla en sistemas externos, como un sistema de gestión de incidentes o una aplicación de automatización.",{"_7979":587,"_22255":571,"_18887":33726,"_5":22404,"_15195":33686,"_1578":33727},[],"Para cada evento, se puede crear una suscripción a la que se envían notificaciones cuando el evento ocurre. Este proceso permite a los administradores del sistema personalizar qué eventos monitorizan y cómo son notificados. La configuración de las suscripciones, incluyendo el destino de las notificaciones, se gestiona de forma individual para cada tipo de evento.",{"_7979":588,"_22255":571,"_18887":33729,"_5":22404,"_15195":33686,"_1578":33730},[],"Al pulsar sobre el botón **Subscribe** se abre un modal de configuración que permite seleccionar uno de los tres mecanismos de notificación disponibles en Lamassu IoT.",{"_7979":589,"_22255":571,"_18887":33732,"_5":22404,"_15195":33686,"_1578":33733},[],"**Email Notification**: Envía una notificación por correo electrónico a una dirección específica cada vez que el evento se registra. Para configurar este método, solo es necesario proporcionar la dirección de correo electrónico de destino.",{"_7979":590,"_22255":571,"_18887":33735,"_5":22404,"_15195":33686,"_1578":33736},[],"**Microsoft Teams Webhook**: Utiliza un webhook para enviar una notificación al canal de Microsoft Teams configurado, lo que permite integrar las alertas directamente en los flujos de trabajo de colaboración. Se debe proporcionar un nombre para la suscripción y la URL del webhook de Microsoft Teams.",{"_7979":591,"_22255":571,"_18887":33738,"_5":22404,"_15195":33686,"_1578":33739},[],"**Webhook**: Envía una notificación en formato JSON a una URL de webhook personalizada, lo que permite integrar las alertas con cualquier servicio o aplicación que soporte este protocolo. Para este mecanismo, se debe especificar un nombre, el **Método HTTP** (siempre **POST** o **PUT**) y la URL de destino. El documento JSON del evento se entregará como el cuerpo de la solicitud HTTP.",{"_7979":592,"_22255":571,"_18887":33741,"_5":22404,"_15195":33690,"_1578":33742},[],"Después de seleccionar el mecanismo de notificación, se puede establecer un filtro para determinar las condiciones que deben cumplirse para que el evento sea notificado. Esto permite un control más granular y evita recibir notificaciones irrelevantes. Los formatos de filtro disponibles son:",{"_7979":593,"_22255":571,"_18887":33744,"_5":22404,"_15195":33690,"_1578":33745},[],"**None**: No se aplica ningún filtro. Se enviarán notificaciones para todas las instancias del evento.",{"_7979":594,"_22255":571,"_18887":33747,"_5":22404,"_15195":33690,"_1578":33748},[],"**JSON Path**: Utiliza la sintaxis de JSON Path para evaluar una condición sobre un campo específico del evento JSON.",{"_7979":595,"_22255":571,"_18887":33750,"_5":22404,"_15195":33690,"_1578":33751},[],"**JSON Schema**: Permite aplicar un esquema JSON para validar el evento. Las notificaciones solo se enviarán si el evento cumple con el esquema definido. Esto es útil para asegurar que solo se procesen eventos con un formato de datos esperado y consistente.",{"_7979":596,"_22255":571,"_18887":33753,"_5":22404,"_15195":33690,"_1578":33754},[],"**Javascript**: Permite escribir una función de JavaScript personalizada para evaluar condiciones complejas sobre el evento JSON. Por ejemplo, la función `function (event) { return event.data.status == \"NO_IDENTITY\"; }` podría usarse para notificar solo cuando el estado de un dispositivo cambia a \"No Identity\". Esto ofrece la mayor flexibilidad, ya que se pueden aplicar lógicas avanzadas para filtrar los eventos antes de que se envíen las notificaciones.",{"_7979":597,"_22255":571,"_18887":33756,"_5":22404,"_15195":33694,"_1578":33757},[],"El último paso del proceso es la **confirmación**. Una vez que se ha configurado el canal de notificación y el filtro (si corresponde), la interfaz muestra un resumen de la suscripción. Aquí puedes revisar el tipo de evento, el canal de notificación seleccionado y la condición del filtro antes de confirmar.",{"_7979":598,"_22255":571,"_18887":33759,"_5":22404,"_15195":33694,"_1578":33760},[],"Al hacer clic en **Confirm Subscription**, la suscripción se activa y Lamassu IoT comenzará a enviar notificaciones basadas en la configuración que has establecido.",{"_7979":599,"_22255":571,"_18887":33762,"_5":22404,"_15195":33698,"_1578":33763},[],"Para gestionar una suscripción que ya está activa, simplemente selecciónala en el listado de la página principal de alertas. Al hacerlo, se abrirá un modal de **Subscription Details** que muestra toda la información de la suscripción. Desde esta ventana, se pueden realizar las siguientes acciones:",{"_7979":600,"_22255":571,"_18887":33765,"_5":22404,"_15195":33698,"_1578":33766},[],"**Ver detalles**: Muestra información completa sobre la suscripción, incluyendo su tipo de evento, el canal de notificación, los detalles de contacto (como la dirección de correo electrónico) y las condiciones de filtrado aplicadas.",{"_7979":601,"_22255":571,"_18887":33768,"_5":22404,"_15195":33698,"_1578":33769},[],"**Editar**: Permite modificar la configuración de la suscripción, como el canal de notificación o el filtro.",{"_7979":602,"_22255":571,"_18887":33771,"_5":22404,"_15195":33698,"_1578":33772},[],"**Anular suscripción (Unsubscribe)**: Desactiva y elimina la suscripción. Esta acción es útil cuando una alerta ya no es necesaria.",{"_7979":603,"_22255":571,"_18887":33774,"_5":22404,"_15195":33702,"_1578":33775},[],"La siguiente tabla resume los eventos que pueden ser generados por la plataforma Lamassu IoT, clasificados por el componente que los origina.",{"_7979":604,"_22255":571,"_18887":33777,"_5":22404,"_15195":33702,"_1578":33778},[],"Evento",{"_7979":605,"_22255":571,"_18887":33780,"_5":22404,"_15195":33702,"_1578":32169},[],{"_7979":606,"_22255":571,"_18887":33782,"_5":22404,"_15195":33702,"_1578":33783},[],"**ca.create**",{"_7979":607,"_22255":571,"_18887":33785,"_5":22404,"_15195":33702,"_1578":33786},[],"Creación de una CA",{"_7979":608,"_22255":571,"_18887":33788,"_5":22404,"_15195":33702,"_1578":33789},[],"**ca.import**",{"_7979":609,"_22255":571,"_18887":33791,"_5":22404,"_15195":33702,"_1578":33792},[],"Importación de una CA",{"_7979":610,"_22255":571,"_18887":33794,"_5":22404,"_15195":33702,"_1578":33795},[],"**ca.profile.update**",{"_7979":611,"_22255":571,"_18887":33797,"_5":22404,"_15195":33702,"_1578":33798},[],"Actualización de perfil de CA",{"_7979":612,"_22255":571,"_18887":33800,"_5":22404,"_15195":33702,"_1578":33801},[],"**ca.reissue**",{"_7979":613,"_22255":571,"_18887":33803,"_5":22404,"_15195":33702,"_1578":33804},[],"Reemisión de una CA",{"_7979":614,"_22255":571,"_18887":33806,"_5":22404,"_15195":33702,"_1578":33807},[],"**ca.sign.certificate**",{"_7979":615,"_22255":571,"_18887":33809,"_5":22404,"_15195":33702,"_1578":33810},[],"Firma / emisión de certificado",{"_7979":616,"_22255":571,"_18887":33812,"_5":22404,"_15195":33702,"_1578":33813},[],"**ca.signature.sign**",{"_7979":617,"_22255":571,"_18887":33815,"_5":22404,"_15195":33702,"_1578":33816},[],"Operación de firma criptográfica",{"_7979":618,"_22255":571,"_18887":33818,"_5":22404,"_15195":33702,"_1578":33819},[],"**ca.delete**",{"_7979":619,"_22255":571,"_18887":33821,"_5":22404,"_15195":33702,"_1578":33822},[],"Eliminación de una CA",{"_7979":620,"_22255":571,"_18887":33824,"_5":22404,"_15195":33702,"_1578":33825},[],"**certificate.delete**",{"_7979":621,"_22255":571,"_18887":33827,"_5":22404,"_15195":33702,"_1578":33828},[],"Eliminación de un certificado",{"_7979":622,"_22255":571,"_18887":33830,"_5":22404,"_15195":33702,"_1578":33831},[],"**profile.create**",{"_7979":623,"_22255":571,"_18887":33833,"_5":22404,"_15195":33702,"_1578":33834},[],"Creación de perfil de emisión",{"_7979":624,"_22255":571,"_18887":33836,"_5":22404,"_15195":33702,"_1578":33837},[],"**profile.update**",{"_7979":625,"_22255":571,"_18887":33839,"_5":22404,"_15195":33702,"_1578":33840},[],"Actualización de perfil de emisión",{"_7979":626,"_22255":571,"_18887":33842,"_5":22404,"_15195":33702,"_1578":33843},[],"**profile.delete**",{"_7979":627,"_22255":571,"_18887":33845,"_5":22404,"_15195":33702,"_1578":33846},[],"Eliminación de perfil de emisión",{"_7979":628,"_22255":571,"_18887":33848,"_5":22404,"_15195":33702,"_1578":33849},[],"**dms.create**",{"_7979":629,"_22255":571,"_18887":33851,"_5":22404,"_15195":33702,"_1578":33852},[],"Creación de un DMS",{"_7979":630,"_22255":571,"_18887":33854,"_5":22404,"_15195":33702,"_1578":33855},[],"**dms.update**",{"_7979":631,"_22255":571,"_18887":33857,"_5":22404,"_15195":33702,"_1578":33858},[],"Actualización de un DMS",{"_7979":632,"_22255":571,"_18887":33860,"_5":22404,"_15195":33702,"_1578":33861},[],"**dms.delete**",{"_7979":633,"_22255":571,"_18887":33863,"_5":22404,"_15195":33702,"_1578":33864},[],"Eliminación de un DMS",{"_7979":634,"_22255":571,"_18887":33866,"_5":22404,"_15195":33702,"_1578":33867},[],"**dms.enroll**",{"_7979":635,"_22255":571,"_18887":33869,"_5":22404,"_15195":33702,"_1578":33870},[],"Inscripción (enroll) de dispositivo",{"_7979":636,"_22255":571,"_18887":33872,"_5":22404,"_15195":33702,"_1578":33873},[],"**dms.reenroll**",{"_7979":637,"_22255":571,"_18887":33875,"_5":22404,"_15195":33702,"_1578":33876},[],"Re-inscripción (reenroll) de dispositivo",{"_7979":638,"_22255":571,"_18887":33878,"_5":22404,"_15195":33702,"_1578":33879},[],"**dms.bind-device-id**",{"_7979":639,"_22255":571,"_18887":33881,"_5":22404,"_15195":33702,"_1578":33882},[],"Asociación de identidad a dispositivo",{"_7979":640,"_22255":571,"_18887":33884,"_5":22404,"_15195":33702,"_1578":33885},[],"**device.create**",{"_7979":641,"_22255":571,"_18887":33887,"_5":22404,"_15195":33702,"_1578":33888},[],"Creación de dispositivo",{"_7979":642,"_22255":571,"_18887":33890,"_5":22404,"_15195":33702,"_1578":33891},[],"**device.identity.update**",{"_7979":643,"_22255":571,"_18887":33893,"_5":22404,"_15195":33702,"_1578":33894},[],"Actualización de identidad del dispositivo",{"_7979":644,"_22255":571,"_18887":33896,"_5":22404,"_15195":33702,"_1578":33897},[],"**device.status.update**",{"_7979":645,"_22255":571,"_18887":33899,"_5":22404,"_15195":33702,"_1578":33900},[],"Cambio de estado del dispositivo",{"_7979":646,"_22255":571,"_18887":33902,"_5":22404,"_15195":33702,"_1578":33903},[],"**device.metadata.update**",{"_7979":647,"_22255":571,"_18887":33905,"_5":22404,"_15195":33702,"_1578":33906},[],"Actualización de metadatos del dispositivo",{"_7979":648,"_22255":571,"_18887":33908,"_5":22404,"_15195":33702,"_1578":33909},[],"**device.delete**",{"_7979":649,"_22255":571,"_18887":33911,"_5":22404,"_15195":33702,"_1578":33912},[],"Eliminación de un dispositivo",{"_7979":650,"_22255":571,"_18887":33914,"_5":22404,"_15195":33702,"_1578":33915},[],"**va.role.crl.create**",{"_7979":651,"_22255":571,"_18887":33917,"_5":22404,"_15195":33702,"_1578":33918},[],"Cálculo/creación de CRL",{"_7979":652,"_22255":571,"_18887":33920,"_5":22404,"_15195":33702,"_1578":33921},[],"**kms.create**",{"_7979":653,"_22255":571,"_18887":33923,"_5":22404,"_15195":33702,"_1578":33924},[],"Creación de clave en KMS",{"_7979":654,"_22255":571,"_18887":33926,"_5":22404,"_15195":33702,"_1578":33927},[],"**kms.import**",{"_7979":655,"_22255":571,"_18887":33929,"_5":22404,"_15195":33702,"_1578":33930},[],"Importación de una clave KMS",{"_7979":656,"_22255":571,"_18887":33932,"_5":22404,"_15195":33702,"_1578":33933},[],"**kms.update.metadata**",{"_7979":657,"_22255":571,"_18887":33935,"_5":22404,"_15195":33702,"_1578":33936},[],"Actualización de metadatos de clave KMS",{"_7979":658,"_22255":571,"_18887":33938,"_5":22404,"_15195":33702,"_1578":33939},[],"**kms.update.aliases**",{"_7979":659,"_22255":571,"_18887":33941,"_5":22404,"_15195":33702,"_1578":33942},[],"Actualización de alias de clave KMS",{"_7979":660,"_22255":571,"_18887":33944,"_5":22404,"_15195":33702,"_1578":33945},[],"**kms.update.name**",{"_7979":661,"_22255":571,"_18887":33947,"_5":22404,"_15195":33702,"_1578":33948},[],"Cambio de nombre de una clave KMS",{"_7979":662,"_22255":571,"_18887":33950,"_5":22404,"_15195":33702,"_1578":33951},[],"**kms.update.tags**",{"_7979":663,"_22255":571,"_18887":33953,"_5":22404,"_15195":33702,"_1578":33954},[],"Actualización de etiquetas (tags) de clave KMS",{"_7979":664,"_22255":571,"_18887":33956,"_5":22404,"_15195":33702,"_1578":33957},[],"**kms.delete**",{"_7979":665,"_22255":571,"_18887":33959,"_5":22404,"_15195":33702,"_1578":33960},[],"Eliminación de una clave KMS",{"_7979":666,"_22255":571,"_18887":33962,"_5":22404,"_15195":33702,"_1578":33963},[],"**kms.sign.message**",{"_7979":667,"_22255":571,"_18887":33965,"_5":22404,"_15195":33702,"_1578":33966},[],"Firma de un mensaje con clave KMS",{"_7979":668,"_22255":571,"_18887":33968,"_5":22404,"_15195":33702,"_1578":33969},[],"**kms.verify.signature**",{"_7979":669,"_22255":571,"_18887":33971,"_5":22404,"_15195":33702,"_1578":33972},[],"Verificación de firma con clave KMS",{"_7979":670,"_22255":670,"_5":22399,"_1578":33974,"_22412":33975,"_18887":33976,"_15195":670},"[CA] Gestión de Entidades de Confianza",[31966,33065,33074],[],{"_7979":671,"_22255":670,"_18887":33978,"_5":22404,"_15195":670,"_1578":33979},[],"Creación y gestión de Autoridades de Certificación en Lamassu IoT",{"_7979":672,"_22255":670,"_5":22409,"_18887":33981,"_15195":33982,"_1578":33983},[],"/docs/pr-preview/pr-23/manual/servicios-core/cas#gestión-de-entidades-de-confianza","Gestión de entidades de confianza",{"_7979":673,"_22255":670,"_5":22409,"_18887":33985,"_15195":33986,"_1578":33987},[],"/docs/pr-preview/pr-23/manual/servicios-core/cas#creación-de-entidades-de-certificación","Creación de entidades de certificación",{"_7979":674,"_22255":670,"_5":22409,"_18887":33989,"_15195":33990,"_1578":33991},[],"/docs/pr-preview/pr-23/manual/servicios-core/cas#creación-de-una-nueva-autoridad-de-certificación","Creación de una nueva autoridad de certificación",{"_7979":675,"_22255":670,"_5":22409,"_18887":33993,"_15195":33994,"_1578":33995},[],"/docs/pr-preview/pr-23/manual/servicios-core/cas#creación-de-cas-a-partir-de-claves-del-kms","Creación de CAs a partir de claves del KMS",{"_7979":676,"_22255":670,"_5":22409,"_18887":33997,"_15195":33998,"_1578":33999},[],"/docs/pr-preview/pr-23/manual/servicios-core/cas#importación-de-autoridades-de-certificación","Importación de autoridades de certificación",{"_7979":677,"_22255":670,"_5":22409,"_18887":34001,"_15195":34002,"_1578":34003},[],"/docs/pr-preview/pr-23/manual/servicios-core/cas#operando-con-entidades-de-confianza","Operando con entidades de confianza",{"_7979":678,"_22255":670,"_5":22409,"_18887":34005,"_15195":34006,"_1578":34007},[],"/docs/pr-preview/pr-23/manual/servicios-core/cas#visualización-de-autoridades-de-certificación","Visualización de autoridades de certificación",{"_7979":679,"_22255":670,"_5":22409,"_18887":34009,"_15195":34010,"_1578":34011},[],"/docs/pr-preview/pr-23/manual/servicios-core/cas#emisión-de-certificados","Emisión de certificados",{"_7979":680,"_22255":670,"_5":22409,"_18887":34013,"_15195":34014,"_1578":34015},[],"/docs/pr-preview/pr-23/manual/servicios-core/cas#revocación-de-cas-y-certificados","Revocación de CAs y certificados",{"_7979":681,"_22255":670,"_18887":34017,"_5":22404,"_15195":33986,"_1578":34018},[],"Para acceder a la creación de nuevas entidades certificación se debe acceder la opción de entidades de certificación del menú lateral y luego seleccionar la acción de creación de nueva CA.",{"_7979":682,"_22255":670,"_18887":34020,"_5":22404,"_15195":33986,"_1578":34021},[],"Actualmente hay disponibles 3 acciones:",{"_7979":683,"_22255":670,"_18887":34023,"_5":22404,"_15195":33986,"_1578":34024},[],"**Creación de una nueva autoridad de certificación**, esta acción generará un nuevo par de claves para soportar la nueva autoridad de certificación.",{"_7979":684,"_22255":670,"_18887":34026,"_5":22404,"_15195":33986,"_1578":34027},[],"**Importar una nueva autoridad de certificación generada externamente**, permite importar en Lamassu una autoridad de certificación, cuyo par de claves ha sido generado de manera externa.",{"_7979":685,"_22255":670,"_18887":34029,"_5":22404,"_15195":33986,"_1578":34030},[],"**Importar un certificado de autoridad de certificación sin clave privada**, en este caso se importa la CA para poder usarla en procesos de validación y no como fuente de nuevos certificados gestionados por Lamassu.",{"_7979":686,"_22255":670,"_18887":34032,"_5":22404,"_15195":33990,"_1578":34033},[],"La creación de una Autoridad de Certificación (CA) es un proceso fundamental en el establecimiento de una infraestructura de clave pública (PKI). Lamassu IoT permite provisionar tanto autoridades raíz como intermedias mediante la generación automática de pares de claves criptográficas que son gestionados de forma segura por el sistema integrado de gestión de claves.",{"_7979":687,"_22255":670,"_18887":34035,"_5":22404,"_15195":33990,"_1578":34036},[],"En el formulario de creación se definen los siguientes bloques de configuración.",{"_7979":688,"_22255":670,"_18887":34038,"_5":22404,"_15195":33990,"_1578":34039},[],"**Motor criptográfico**",{"_7979":689,"_22255":670,"_18887":34041,"_5":22404,"_15195":33990,"_1578":34042},[],"**Selector:** Desplegable con motores disponibles, ofrece los configurados en el sistema.",{"_7979":690,"_22255":670,"_18887":34044,"_5":22404,"_15195":33990,"_1578":34045},[],"**Ejemplo mostrado:** go1.24.3",{"_7979":691,"_22255":670,"_18887":34047,"_5":22404,"_15195":33990,"_1578":34048},[],"**Función:** Permite seleccionar el motor criptográfico deseado",{"_7979":692,"_22255":670,"_18887":34050,"_5":22404,"_15195":33990,"_1578":34051},[],"**Parámetros de clave**",{"_7979":693,"_22255":670,"_18887":34053,"_5":22404,"_15195":33990,"_1578":34054},[],"**Key Type:** RSA / EC (Elliptic Curve)",{"_7979":694,"_22255":670,"_18887":34056,"_5":22404,"_15195":33990,"_1578":34057},[],"**Key Size:**",{"_7979":695,"_22255":670,"_18887":34059,"_5":22404,"_15195":33990,"_1578":34060},[],"RSA: 1024, 2048, 3072, 4096 bits",{"_7979":696,"_22255":670,"_18887":34062,"_5":22404,"_15195":33990,"_1578":34063},[],"EC: P-256, P-384, P-521",{"_7979":697,"_22255":670,"_18887":34065,"_5":22404,"_15195":33990,"_1578":34066},[],"**Recomendado:** EC P-384",{"_7979":698,"_22255":670,"_18887":34068,"_5":22404,"_15195":33990,"_1578":34069},[],"**Perfil de emisión del certificado de la CA**",{"_7979":699,"_22255":670,"_18887":34071,"_5":22404,"_15195":33990,"_1578":34072},[],"Aquí se puede seleccionar un perfil existente o definir uno en línea para la operación. Ese perfil permite especificar la duración de la CA que se está creando y los `Key Usage` y `Extended Key Usage` del certificado de soporte.",{"_7979":700,"_22255":670,"_18887":34074,"_5":22404,"_15195":33990,"_1578":34075},[],"Si no se proporciona ningún perfil se aplicará uno por defecto con los usos de clave básicos.",{"_7979":701,"_22255":670,"_18887":34077,"_5":22404,"_15195":33990,"_1578":34078},[],"**Configuración de la CA**",{"_7979":702,"_22255":670,"_18887":34080,"_5":22404,"_15195":33990,"_1578":34081},[],"**Tipo de CA**",{"_7979":703,"_22255":670,"_18887":34083,"_5":22404,"_15195":33990,"_1578":34084},[],"**Root CA:** Autoridad raíz autofirmada",{"_7979":704,"_22255":670,"_18887":34086,"_5":22404,"_15195":33990,"_1578":34087},[],"**Intermediate CA:** Autoridad subordinada",{"_7979":705,"_22255":670,"_18887":34089,"_5":22404,"_15195":33990,"_1578":34090},[],"**Emisor**",{"_7979":706,"_22255":670,"_18887":34092,"_5":22404,"_15195":33990,"_1578":34093},[],"**Root CA:** Self-signed (auto-firmada)",{"_7979":707,"_22255":670,"_18887":34095,"_5":22404,"_15195":33990,"_1578":34096},[],"**Intermediate CA:** Selector desplegable de CA superior disponible",{"_7979":708,"_22255":670,"_18887":34098,"_5":22404,"_15195":33990,"_1578":34099},[],"Permite seleccionar la CA padre que firmará la nueva CA intermedia",{"_7979":709,"_22255":670,"_18887":34101,"_5":22404,"_15195":33990,"_1578":34102},[],"**Identificación**",{"_7979":710,"_22255":670,"_18887":34104,"_5":22404,"_15195":33990,"_1578":34105},[],"**CA ID:** Generado automáticamente (formato UUID),no puede ser modificado. Estos IDs los gestiona el sistema.",{"_7979":711,"_22255":670,"_18887":34107,"_5":22404,"_15195":33990,"_1578":34108},[],"Ejemplo: 8f7c170-c84e-4c08-904f-8d3247c77fc2",{"_7979":712,"_22255":670,"_18887":34110,"_5":22404,"_15195":33990,"_1578":34111},[],"**CA Name:** Nombre descriptivo (obligatorio)",{"_7979":713,"_22255":670,"_18887":34113,"_5":22404,"_15195":33990,"_1578":34114},[],"Ejemplo: Lamassu IoT Secure Services CA",{"_7979":714,"_22255":670,"_18887":34116,"_5":22404,"_15195":33990,"_1578":34117},[],"**Subject Distinguished Name (DN)**",{"_7979":715,"_22255":670,"_18887":34119,"_5":22404,"_15195":33990,"_1578":34120},[],"Campos opcionales:",{"_7979":716,"_22255":670,"_18887":34122,"_5":22404,"_15195":33990,"_1578":34123},[],"**Country (C):** Código país ISO 3166-1 (2 letras)",{"_7979":717,"_22255":670,"_18887":34125,"_5":22404,"_15195":33990,"_1578":34126},[],"Ejemplo: US, ES, DE",{"_7979":718,"_22255":670,"_18887":34128,"_5":22404,"_15195":33990,"_1578":34129},[],"**State/Province (ST):** Estado o provincia",{"_7979":719,"_22255":670,"_18887":34131,"_5":22404,"_15195":33990,"_1578":34132},[],"Ejemplo: California, Madrid",{"_7979":720,"_22255":670,"_18887":34134,"_5":22404,"_15195":33990,"_1578":34135},[],"**Locality (L):** Ciudad o localidad",{"_7979":721,"_22255":670,"_18887":34137,"_5":22404,"_15195":33990,"_1578":34138},[],"Ejemplo: San Francisco, Arrasate",{"_7979":722,"_22255":670,"_18887":34140,"_5":22404,"_15195":33990,"_1578":34141},[],"**Organization (O):** Nombre de la organización",{"_7979":723,"_22255":670,"_18887":34143,"_5":22404,"_15195":33990,"_1578":34144},[],"Ejemplo: Lamassu IoT Corp",{"_7979":724,"_22255":670,"_18887":34146,"_5":22404,"_15195":33990,"_1578":34147},[],"**Organizational Unit (OU):** Unidad organizacional",{"_7979":725,"_22255":670,"_18887":34149,"_5":22404,"_15195":33990,"_1578":34150},[],"Ejemplo: Secure Devices Division",{"_7979":726,"_22255":670,"_18887":34152,"_5":22404,"_15195":33990,"_1578":34153},[],"El \"Certification Authority Name\" configurado se utilizará como Common Name (CN) del subject del certificado de la CA.",{"_7979":727,"_22255":670,"_18887":34155,"_5":22404,"_15195":33990,"_1578":34156},[],"**Configuración de expiración**\nLa configuración de expiración define la validez temporal tanto del certificado de la propia CA como de los certificados que ésta emitirá por defecto. Si se ha seleccionado un perfil se dará prioridad al dato proporcionado en el perfil.",{"_7979":728,"_22255":670,"_18887":34158,"_5":22404,"_15195":33990,"_1578":34159},[],"Para el certificado de la CA (`CA Certificate Expiration`):",{"_7979":729,"_22255":670,"_18887":34161,"_5":22404,"_15195":33990,"_1578":34162},[],"**Función:** Establece la duración de validez del certificado de la Autoridad de Certificación",{"_7979":730,"_22255":670,"_18887":34164,"_5":22404,"_15195":33990,"_1578":34165},[],"**Implicación:** Una vez expirado, la CA no podrá emitir nuevos certificados válidos",{"_7979":731,"_22255":670,"_18887":34167,"_5":22404,"_15195":33990,"_1578":34168},[],"**Duración:** Configurable según necesidades organizacionales",{"_7979":732,"_22255":670,"_18887":34170,"_5":22404,"_15195":33990,"_1578":34171},[],"**Valor por defecto:** 10 años (10y)",{"_7979":733,"_22255":670,"_18887":34173,"_5":22404,"_15195":33990,"_1578":34174},[],"**Consideración:** Debe ser mayor que la duración de los certificados que emitirá",{"_7979":734,"_22255":670,"_18887":34176,"_5":22404,"_15195":33990,"_1578":34177},[],"La expiración de la CA se puede definir como un expresión de duración, fijar una fecha fija, o marcarla como indefinida, lo que en términos prácticos permitirá la emisión de una CA sin caducidad.",{"_7979":735,"_22255":670,"_18887":34179,"_5":22404,"_15195":33990,"_1578":34180},[],"En el caso de expresar una duración, las unidades permitidas son: y (años), w (semanas), d (días), h (horas), m (minutos) y s (segundos), pudiendo componer expresiones como la siguiente: *5y 8w 4d 2h 1m 2s*",{"_7979":736,"_22255":670,"_18887":34182,"_5":22404,"_15195":33990,"_1578":34183},[],"En caso de elegir la opción de fecha específica, se ofrecerá un calendario para seleccionar la fecha de caducidad.",{"_7979":737,"_22255":670,"_18887":34185,"_5":22404,"_15195":33990,"_1578":34186},[],"Para el caso de indefinido, se fijará la fecha de expiración máxima permitida.",{"_7979":738,"_22255":670,"_18887":34188,"_5":22404,"_15195":33990,"_1578":34189},[],"Para la expiración por defecto de certificados finales (`Default End-Entity Certificate Issuance Expiration`):",{"_7979":739,"_22255":670,"_18887":34191,"_5":22404,"_15195":33990,"_1578":34192},[],"**Función:** Define la duración predeterminada para certificados emitidos por esta CA",{"_7979":740,"_22255":670,"_18887":34194,"_5":22404,"_15195":33990,"_1578":34195},[],"**Aplicación:** Se aplica automáticamente a nuevos certificados si no se especifica otra duración",{"_7979":741,"_22255":670,"_18887":34197,"_5":22404,"_15195":33990,"_1578":34198},[],"**Flexibilidad:** Puede ser modificada individualmente al emitir cada certificado",{"_7979":742,"_22255":670,"_18887":34200,"_5":22404,"_15195":33990,"_1578":34201},[],"**Valor por defecto:** 1 año (1y)",{"_7979":743,"_22255":670,"_18887":34203,"_5":22404,"_15195":33990,"_1578":34204},[],"Se expresa en los mismos términos que la caducidad de la CA.",{"_7979":744,"_22255":670,"_18887":34206,"_5":22404,"_15195":33990,"_1578":34207},[],"Una vez creada la CA debe ser visible en el listado de CAs del sistema.",{"_7979":745,"_22255":670,"_18887":34209,"_5":22404,"_15195":33994,"_1578":34210},[],"Lamassu IoT permite la creación de CAs a partir de claves previamente generadas o importadas en el servicio KMS. Una vez seleccionada la opción &#x2A;*Create New CA (Existing Key)** se muestra el formulario de creación de CAs con los siguientes elementos diferenciales respecto a la creación de la CA a partir de un nuevo par de claves descrito en el punto anterior.",{"_7979":746,"_22255":670,"_18887":34212,"_5":22404,"_15195":33994,"_1578":34213},[],"En este caso, primero se solicita la selección de la clave de soporte para esta nueva CA.",{"_7979":747,"_22255":670,"_18887":34215,"_5":22404,"_15195":33994,"_1578":34216},[],"Se abre un popup que permite al usuario seleccionar la clave deseada de entre las disponibles en el KMS. Una vez seleccionada la clave, el proceso continúa como se describe en el punto anterior.",{"_7979":748,"_22255":670,"_18887":34218,"_5":22404,"_15195":33998,"_1578":34219},[],"La importación de entidades de certificación permite importar en el sistema una CA que ha sido generada de manera externa. Para ello se sigue el siguiente proceso:",{"_7979":749,"_22255":670,"_18887":34221,"_5":22404,"_15195":33998,"_1578":34222},[],"Se debe seleccionar el motor que gestionará el par de claves importado.",{"_7979":750,"_22255":670,"_18887":34224,"_5":22404,"_15195":33998,"_1578":34042},[],{"_7979":751,"_22255":670,"_18887":34226,"_5":22404,"_15195":33998,"_1578":34045},[],{"_7979":752,"_22255":670,"_18887":34228,"_5":22404,"_15195":33998,"_1578":34048},[],{"_7979":753,"_22255":670,"_18887":34230,"_5":22404,"_15195":33998,"_1578":34231},[],"También se define la expiración por defecto de certificados finales (`Default End-Entity Certificate Issuance Expiration`):",{"_7979":754,"_22255":670,"_18887":34233,"_5":22404,"_15195":33998,"_1578":34192},[],{"_7979":755,"_22255":670,"_18887":34235,"_5":22404,"_15195":33998,"_1578":34195},[],{"_7979":756,"_22255":670,"_18887":34237,"_5":22404,"_15195":33998,"_1578":34198},[],{"_7979":757,"_22255":670,"_18887":34239,"_5":22404,"_15195":33998,"_1578":34201},[],{"_7979":758,"_22255":670,"_18887":34241,"_5":22404,"_15195":33998,"_1578":34204},[],{"_7979":759,"_22255":670,"_18887":34243,"_5":22404,"_15195":33998,"_1578":34244},[],"Se debe proporcionar de manera obligatoria:",{"_7979":760,"_22255":670,"_18887":34246,"_5":22404,"_15195":33998,"_1578":34247},[],"Certificado de la CA en formato PEM. Se comprueba que el certificado importado corresponda con el de una CA.",{"_7979":761,"_22255":670,"_18887":34249,"_5":22404,"_15195":33998,"_1578":34250},[],"Clave privada de la CA en formato PEM",{"_7979":762,"_22255":670,"_18887":34252,"_5":22404,"_15195":33998,"_1578":34253},[],"De manera opcional se proporcionarán en formato PEM la cadena de certificados de la cadena de validación en caso de importar una CA subordinada.",{"_7979":763,"_22255":670,"_18887":34255,"_5":22404,"_15195":34006,"_1578":34256},[],"Accediendo a la sección de autoridades de certificación se mostrará el listado de CAs registradas en el sistema. El listado permitirá el filtro mediante el nombre de la CA, el estado o el tipo de CA.",{"_7979":764,"_22255":670,"_18887":34258,"_5":22404,"_15195":34006,"_1578":34259},[],"La acción de ver detalles da acceso a los detalles de la CA y a diferentes opciones de gestión.",{"_7979":765,"_22255":670,"_18887":34261,"_5":22404,"_15195":34006,"_1578":34262},[],"En los detalles se muestra el resumen del estado de los certificados emitidos por la CA: certificados activos, expirados y revocados.",{"_7979":766,"_22255":670,"_18887":34264,"_5":22404,"_15195":34006,"_1578":34265},[],"Se ofrecen dos acciones:",{"_7979":767,"_22255":670,"_18887":34267,"_5":22404,"_15195":34006,"_1578":34268},[],"la descarga de la CRL vinculada a la CA que permitirá a otros sistemas realizar comprobaciones de vigencia de los certificados emitidos por la CA de manera desconectada.",{"_7979":768,"_22255":670,"_18887":34270,"_5":22404,"_15195":34006,"_1578":34271},[],"la acción de revocación de la CA",{"_7979":769,"_22255":670,"_18887":34273,"_5":22404,"_15195":34006,"_1578":34274},[],"Se muestra información detallada, el certificado en formato PEM y se da acceso a la relación de certificados emitidos por la CA a través de la pestaña “Issued Certificates”",{"_7979":770,"_22255":670,"_18887":34276,"_5":22404,"_15195":34010,"_1578":34277},[],"La acción de emisión de certificados se puede realizar desde la pestaña “Issued Certificates” de los detalles de la CA, mediante la acción “Issue New”.",{"_7979":771,"_22255":670,"_18887":34279,"_5":22404,"_15195":34010,"_1578":34280},[],"La funcionalidad de emisión es accesible también desde el listado de CAs mediante la acción correspondiente de emisión.",{"_7979":772,"_22255":670,"_18887":34282,"_5":22404,"_15195":34010,"_1578":34283},[],"Y desde la funcionalidad  listado completo de certificados emitidos por Lamassu mediante la acción “Issue Certificate”",{"_7979":773,"_22255":670,"_18887":34285,"_5":22404,"_15195":34010,"_1578":34286},[],"En este caso se solicitará la selección de una CA antes de acceder al formulario de emisión.",{"_7979":774,"_22255":670,"_18887":34288,"_5":22404,"_15195":34010,"_1578":34289},[],"El formulario de emisión de certificados ofrece 2 opciones para la emisión:",{"_7979":775,"_22255":670,"_18887":34291,"_5":22404,"_15195":34010,"_1578":34292},[],"Emisión a partir de una clave privada y el CSR generado en el browser",{"_7979":776,"_22255":670,"_18887":34294,"_5":22404,"_15195":34010,"_1578":34295},[],"Emisión a partir de un CSR generado de manera externa",{"_7979":777,"_22255":670,"_18887":34297,"_5":22404,"_15195":34010,"_1578":34298},[],"**Emisión a partir de una clave privada y el CSR generados en el browser**",{"_7979":778,"_22255":670,"_18887":34300,"_5":22404,"_15195":34010,"_1578":34301},[],"El usuario proporciona la información requerida para la creación del CSR, la consola genera una clave In Place y genera el CSR correspondiente mediante el cual se solicita la emisión del certificado a la CA.",{"_7979":779,"_22255":670,"_18887":34303,"_5":22404,"_15195":34010,"_1578":34304},[],"**Método de emisión:** Seleccionar  \"Generate Key & CSR in Browser\" para la generación del par de claves y la solicitud de certificado (CSR) directamente en el navegador",{"_7979":780,"_22255":670,"_18887":34306,"_5":22404,"_15195":34010,"_1578":34307},[],"**Certificate Subject (Sujeto del certificado)**",{"_7979":781,"_22255":670,"_18887":34309,"_5":22404,"_15195":34010,"_1578":34310},[],"**Common Name (CN)**",{"_7979":782,"_22255":670,"_18887":34312,"_5":22404,"_15195":34010,"_1578":34313},[],"**Campo:** Obligatorio",{"_7979":783,"_22255":670,"_18887":34315,"_5":22404,"_15195":34010,"_1578":34316},[],"**Función:** Identifica de forma única al titular del certificado",{"_7979":784,"_22255":670,"_18887":34318,"_5":22404,"_15195":34010,"_1578":34319},[],"**Ejemplos:**",{"_7979":785,"_22255":670,"_18887":34321,"_5":22404,"_15195":34010,"_1578":34322},[],"Para dispositivos: device001.company.com",{"_7979":786,"_22255":670,"_18887":34324,"_5":22404,"_15195":34010,"_1578":34325},[],"Para usuarios: john.doe\\@company.com",{"_7979":787,"_22255":670,"_18887":34327,"_5":22404,"_15195":34010,"_1578":34328},[],"Para servicios: api.service.company.com",{"_7979":788,"_22255":670,"_18887":34330,"_5":22404,"_15195":34010,"_1578":34331},[],"**Campos Organizacionales**",{"_7979":789,"_22255":670,"_18887":34333,"_5":22404,"_15195":34010,"_1578":34334},[],"**Organizational Unit (OU):** Unidad organizacional del titular",{"_7979":790,"_22255":670,"_18887":34336,"_5":22404,"_15195":34010,"_1578":34337},[],"Ejemplo: IT Department, Manufacturing",{"_7979":791,"_22255":670,"_18887":34339,"_5":22404,"_15195":34010,"_1578":34141},[],{"_7979":792,"_22255":670,"_18887":34341,"_5":22404,"_15195":34010,"_1578":34342},[],"Ejemplo: LamassuIoT Corp, Acme Industries",{"_7979":793,"_22255":670,"_18887":34344,"_5":22404,"_15195":34010,"_1578":34345},[],"**Información Geográfica**",{"_7979":794,"_22255":670,"_18887":34347,"_5":22404,"_15195":34010,"_1578":34348},[],"**Locality (L):** Ciudad o localidad del titular",{"_7979":795,"_22255":670,"_18887":34350,"_5":22404,"_15195":34010,"_1578":34129},[],{"_7979":796,"_22255":670,"_18887":34352,"_5":22404,"_15195":34010,"_1578":34353},[],"**Country (C):** Código de país ISO 3166-1 (2 letras)",{"_7979":797,"_22255":670,"_18887":34355,"_5":22404,"_15195":34010,"_1578":34356},[],"Valor por defecto mostrado: US",{"_7979":798,"_22255":670,"_18887":34358,"_5":22404,"_15195":34010,"_1578":34359},[],"**Subject Alternative Names (SANs)**\nLos SANs proporcionan identificadores alternativos para el certificado, permitiendo que un mismo certificado sea válido para múltiples nombres o direcciones.",{"_7979":799,"_22255":670,"_18887":34361,"_5":22404,"_15195":34010,"_1578":34362},[],"**Tipos de SAN Disponibles**",{"_7979":800,"_22255":670,"_18887":34364,"_5":22404,"_15195":34010,"_1578":34365},[],"**DNS:** Nombres de dominio",{"_7979":801,"_22255":670,"_18887":34367,"_5":22404,"_15195":34010,"_1578":34368},[],"Ejemplo: example.com, \\*.example.com",{"_7979":802,"_22255":670,"_18887":34370,"_5":22404,"_15195":34010,"_1578":34371},[],"**IP Address:** Direcciones IP",{"_7979":803,"_22255":670,"_18887":34373,"_5":22404,"_15195":34010,"_1578":34374},[],"**Email:** Direcciones de correo electrónico",{"_7979":804,"_22255":670,"_18887":34376,"_5":22404,"_15195":34010,"_1578":34377},[],"**URI:** Identificadores de recursos uniformes",{"_7979":805,"_22255":670,"_18887":34379,"_5":22404,"_15195":34010,"_1578":34380},[],"Es posible añadir múltiples SAN de cada tipo, se selecciona el tipo, añadiendo el valor y pulsando la acción “Add”.",{"_7979":806,"_22255":670,"_18887":34382,"_5":22404,"_15195":34010,"_1578":34383},[],"**Key Generation Details (Detalles de generación de claves)**\nSe debe especificar el tipo de clave a ser generada para la solicitud del certificado.",{"_7979":807,"_22255":670,"_18887":34385,"_5":22404,"_15195":34010,"_1578":34386},[],"**Algorithm (Algoritmo)**",{"_7979":808,"_22255":670,"_18887":34388,"_5":22404,"_15195":34010,"_1578":34389},[],"**ECDSA:** Algoritmo de curva elíptica, se debe especificar la curva a utilizar",{"_7979":809,"_22255":670,"_18887":34391,"_5":22404,"_15195":34010,"_1578":34392},[],"**RSA:** Algoritmo RSA tradicional, se debe indicar el tamaño de clave",{"_7979":810,"_22255":670,"_18887":34394,"_5":22404,"_15195":34010,"_1578":34395},[],"**Certificate Configuration (Configuración del certificado)**",{"_7979":811,"_22255":670,"_18887":34397,"_5":22404,"_15195":34010,"_1578":34398},[],"**Validity Duration (Duración de validez)**",{"_7979":812,"_22255":670,"_18887":34400,"_5":22404,"_15195":34010,"_1578":34401},[],"Indica la fecha de expiración del certificado a emitir como una expresión de duración",{"_7979":813,"_22255":670,"_18887":34403,"_5":22404,"_15195":34010,"_1578":34404},[],"**Campo:** Configurable según necesidades",{"_7979":814,"_22255":670,"_18887":34406,"_5":22404,"_15195":34010,"_1578":34201},[],{"_7979":815,"_22255":670,"_18887":34408,"_5":22404,"_15195":34010,"_1578":34409},[],"**Unidades válidas:** y (años), w (semanas), d (días), h (horas), m (minutos), s (segundos)",{"_7979":816,"_22255":670,"_18887":34411,"_5":22404,"_15195":34010,"_1578":34412},[],"**Consideración:** No puede exceder la validez de la CA emisora",{"_7979":817,"_22255":670,"_18887":34414,"_5":22404,"_15195":34010,"_1578":34415},[],"**Key Usage (Uso de claves)**\nDefine los propósitos criptográficos para los que puede utilizarse la clave privada del certificado.",{"_7979":818,"_22255":670,"_18887":34417,"_5":22404,"_15195":34010,"_1578":34418},[],"**Usos Básicos**",{"_7979":819,"_22255":670,"_18887":34420,"_5":22404,"_15195":34010,"_1578":34421},[],"**Digital Signature:** ✓ (marcado por defecto) - Firmas digitales",{"_7979":820,"_22255":670,"_18887":34423,"_5":22404,"_15195":34010,"_1578":34424},[],"**Content Commitment (Non-Repudiation):** No repudio",{"_7979":821,"_22255":670,"_18887":34426,"_5":22404,"_15195":34010,"_1578":34427},[],"**Key Encipherment:** Cifrado de claves",{"_7979":822,"_22255":670,"_18887":34429,"_5":22404,"_15195":34010,"_1578":34430},[],"**Data Encipherment:** Cifrado de datos",{"_7979":823,"_22255":670,"_18887":34432,"_5":22404,"_15195":34010,"_1578":34433},[],"**Key Agreement:** Acuerdo de claves",{"_7979":824,"_22255":670,"_18887":34435,"_5":22404,"_15195":34010,"_1578":34436},[],"**Certificate Signing:** Firma de certificados",{"_7979":825,"_22255":670,"_18887":34438,"_5":22404,"_15195":34010,"_1578":34439},[],"**CRL Signing:** Firma de listas de revocación",{"_7979":826,"_22255":670,"_18887":34441,"_5":22404,"_15195":34010,"_1578":34442},[],"**Encipher Only:** Solo cifrado",{"_7979":827,"_22255":670,"_18887":34444,"_5":22404,"_15195":34010,"_1578":34445},[],"**Decipher Only:** Solo descifrado",{"_7979":828,"_22255":670,"_18887":34447,"_5":22404,"_15195":34010,"_1578":34448},[],"**Uso Extendido de Claves**",{"_7979":829,"_22255":670,"_18887":34450,"_5":22404,"_15195":34010,"_1578":34451},[],"Especifica aplicaciones específicas para las que está autorizado el certificado.",{"_7979":830,"_22255":670,"_18887":34453,"_5":22404,"_15195":34010,"_1578":34454},[],"**Server Authentication:** ✓ (marcado por defecto) - Autenticación de servidor",{"_7979":831,"_22255":670,"_18887":34456,"_5":22404,"_15195":34010,"_1578":34457},[],"**Client Authentication:** ✓ (marcado por defecto) - Autenticación de cliente",{"_7979":832,"_22255":670,"_18887":34459,"_5":22404,"_15195":34010,"_1578":34460},[],"**Code Signing:** Firma de código",{"_7979":833,"_22255":670,"_18887":34462,"_5":22404,"_15195":34010,"_1578":34463},[],"**Email Protection:** Protección de correo electrónico",{"_7979":834,"_22255":670,"_18887":34465,"_5":22404,"_15195":34010,"_1578":34466},[],"**Time Stamping:** Sellado de tiempo",{"_7979":835,"_22255":670,"_18887":34468,"_5":22404,"_15195":34010,"_1578":34469},[],"**OCSP Signing:** Firma de respuestas OCSP",{"_7979":836,"_22255":670,"_18887":34471,"_5":22404,"_15195":34010,"_1578":34472},[],"Una vez completado los campos del formulario se solicita la emisión del certificado obteniendo el certificado y la clave privada generada en formato PEM. Esta clave privada no se almacena debe ser descargada y custodiada por el usuario ya que no se podrá volver a obtener.",{"_7979":837,"_22255":670,"_18887":34474,"_5":22404,"_15195":34010,"_1578":34475},[],"**Emisión a partir de un CSR generado de manera externa**",{"_7979":838,"_22255":670,"_18887":34477,"_5":22404,"_15195":34010,"_1578":34478},[],"Mediante esta opción se podrá realizar la emisión de certificados a partir de CSRs que hayan sido generados de manera externa. Para ello en el selector de modo del formulario de emisión es necesario seleccionar “Upload Existing CSR”.",{"_7979":839,"_22255":670,"_18887":34480,"_5":22404,"_15195":34010,"_1578":34481},[],"Se debe proporcionar un CSR válido que contenga los detalles del certificado a emitir, Subject Name, SANs,..",{"_7979":840,"_22255":670,"_18887":34483,"_5":22404,"_15195":34010,"_1578":34484},[],"Adicionalmente se proporcionará la duración deseada para el certificado y los usos permitidos. Con esta información se procederá a la emisión como se describe en el apartado anterior.",{"_7979":841,"_22255":670,"_18887":34486,"_5":22404,"_15195":34014,"_1578":34487},[],"La revocación de una Autoridad de Certificación (CA) es una acción crítica que invalida todos los certificados emitidos por esa CA, lo que puede causar interrupciones generalizadas en los dispositivos y servicios que confían en ella. Este proceso es irreversible y debe realizarse con extrema precaución.",{"_7979":842,"_22255":670,"_18887":34489,"_5":22404,"_15195":34014,"_1578":34490},[],"Para iniciar el proceso, entra en la sección de Autoridades de Certificación y localiza la CA deseada usando los filtros por **Nombre**, **Estado** y **Tipo**.",{"_7979":843,"_22255":670,"_18887":34492,"_5":22404,"_15195":34014,"_1578":34493},[],"Accede a la ficha de detalle de la CA. Allí se muestran la información general, los certificados PEM, los metadatos y los certificados emitidos, además del botón **Revoke CA**.",{"_7979":844,"_22255":670,"_18887":34495,"_5":22404,"_15195":34014,"_1578":34496},[],"Al pulsar **Revoke CA** se abre una ventana de confirmación con una advertencia sobre el impacto de la acción. En ese cuadro hay que seleccionar una **Razón de Revocación**. Las opciones incluyen:",{"_7979":845,"_22255":670,"_18887":34498,"_5":22404,"_15195":34014,"_1578":34499},[],"Unspecified (No especificado)",{"_7979":846,"_22255":670,"_18887":34501,"_5":22404,"_15195":34014,"_1578":34502},[],"KeyCompromise (Compromiso de clave)",{"_7979":847,"_22255":670,"_18887":34504,"_5":22404,"_15195":34014,"_1578":34505},[],"CACompromise (Compromiso de CA)",{"_7979":848,"_22255":670,"_18887":34507,"_5":22404,"_15195":34014,"_1578":34508},[],"AffiliationChanged (Afiliación cambiada)",{"_7979":849,"_22255":670,"_18887":34510,"_5":22404,"_15195":34014,"_1578":34511},[],"Superseded (Sustituida)",{"_7979":850,"_22255":670,"_18887":34513,"_5":22404,"_15195":34014,"_1578":34514},[],"CessationOfOperation (Cese de operación)",{"_7979":851,"_22255":670,"_18887":34516,"_5":22404,"_15195":34014,"_1578":34517},[],"CertificateHold (Retención de certificado)",{"_7979":852,"_22255":670,"_18887":34519,"_5":22404,"_15195":34014,"_1578":34520},[],"RemoveFromCRL (Eliminar de la CRL)",{"_7979":853,"_22255":670,"_18887":34522,"_5":22404,"_15195":34014,"_1578":34523},[],"Para evitar revocaciones accidentales, el sistema pedirá confirmar el nombre de la CA. En el campo de texto, escribe el **nombre exacto de la CA** que estás revocando. Una vez introducido correctamente, se habilitará el botón **Confirm Revocation**.",{"_7979":854,"_22255":670,"_18887":34525,"_5":22404,"_15195":34014,"_1578":34526},[],"Haz clic en el botón **Confirm Revocation**. Una vez completada la revocación, la CA cambiará su estado a **REVOKED** (Revocada) en la página de detalles, y ya no podrás emitir certificados nuevos con ella. En su lugar, verás la opción **Permanently Delete** (Eliminar Permanentemente).",{"_7979":855,"_22255":670,"_18887":34528,"_5":22404,"_15195":34014,"_1578":34529},[],"Consideraciones importantes:",{"_7979":856,"_22255":670,"_18887":34531,"_5":22404,"_15195":34014,"_1578":34532},[],"Impacto: La revocación de una CA es una acción irreversible que afectará a todos los dispositivos y servicios que dependen de ella. Asegúrate de comprender completamente las implicaciones antes de proceder.",{"_7979":857,"_22255":670,"_18887":34534,"_5":22404,"_15195":34014,"_1578":34535},[],"Eliminación Permanente: Después de la revocación, tendrás la opción de eliminar permanentemente la CA. Esta acción eliminará la CA del sistema de Lamassu IoT.",{"_7979":858,"_22255":858,"_5":22399,"_1578":34537,"_22412":34538,"_18887":34539,"_15195":858},"[Certs] Gestión de Certificados",[31966,33065,33074],[],{"_7979":859,"_22255":858,"_18887":34541,"_5":22404,"_15195":858,"_1578":34542},[],"Visualización y gestión de certificados emitidos",{"_7979":860,"_22255":858,"_5":22409,"_18887":34544,"_15195":34545,"_1578":34546},[],"/docs/pr-preview/pr-23/manual/servicios-core/certificates#gestión-de-certificados","Gestión de certificados",{"_7979":861,"_22255":858,"_5":22409,"_18887":34548,"_15195":34549,"_1578":34550},[],"/docs/pr-preview/pr-23/manual/servicios-core/certificates#revocación-de-certificados","Revocación de certificados",{"_7979":862,"_22255":858,"_18887":34552,"_5":22404,"_15195":34545,"_1578":34553},[],"Los certificados emitidos por Lamassu son accesibles, tanto desde la pestaña de Issued Certificates de los detalles de una CA como desde la opción “Certificates” del menú lateral.\\\nEn la pestaña de “Issued Certificates” se muestran los certificados emitidos por la CA seleccionada.",{"_7979":863,"_22255":858,"_18887":34555,"_5":22404,"_15195":34545,"_1578":34556},[],"Como desde la opción “Certificates” del menú lateral, donde se presentan todos los certificados emitidos por Lamassu independientemente de la CA que lo haya emitido. Esta pantalla incluye la opción de filtro de los certificados por CN, número de serie, estado y por la CA que lo emitió.",{"_7979":864,"_22255":858,"_18887":34558,"_5":22404,"_15195":34545,"_1578":34559},[],"Por cada certificado se incluye un conjunto de acciones vinculadas al certificado.\\\nAcceso a los detalles “View Details”, un mecanismo de inspección rápida (Quick Inspect) con la información básica del certificado, la opción de descarga en formato PEM y el acceso a las acciones de revocación.\\\nLa vista de detalle, proporciona información adicional y el acceso a las acciones de revocación.",{"_7979":865,"_22255":858,"_18887":34561,"_5":22404,"_15195":34549,"_1578":34562},[],"Ya sea desde las acciones del listado de certificados, como desde la vista de detalle se puede desencadenar la acción de revocación. Al pulsar sobre “Revoke Certificate” se abre una ventana modal en la que se debe seleccionar la razón de la revocación.",{"_7979":866,"_22255":858,"_18887":34564,"_5":22404,"_15195":34549,"_1578":34565},[],"Es importante destacar que la única razón reversible es “CertificateHold”, una revocación por cualquier otra  razón no podrá ser revertida. En caso de seleccionar “CertificateHold” se ofrecerá una acción de reactivación.",{"_7979":867,"_22255":867,"_5":22399,"_1578":34567,"_22412":34568,"_18887":34569,"_15195":867},"[Devices] Dispositivos e Identidades",[31966,33065,33074],[],{"_7979":868,"_22255":867,"_18887":34571,"_5":22404,"_15195":867,"_1578":34572},[],"Gestión de dispositivos IoT y sus identidades digitales",{"_7979":869,"_22255":867,"_5":22409,"_18887":34574,"_15195":34575,"_1578":34576},[],"/docs/pr-preview/pr-23/manual/servicios-core/devices#dispositivos-y-gestión-de-las-identidades--end-entities","Dispositivos y gestión de las identidades – End entities",{"_7979":870,"_22255":867,"_5":22409,"_18887":34578,"_15195":34579,"_1578":34580},[],"/docs/pr-preview/pr-23/manual/servicios-core/devices#visualización-de-dispositivos-gestionados","Visualización de Dispositivos Gestionados",{"_7979":871,"_22255":867,"_5":22409,"_18887":34582,"_15195":34583,"_1578":34584},[],"/docs/pr-preview/pr-23/manual/servicios-core/devices#detalle-del-dispositivo-historial-de-certificados","Detalle del Dispositivo: Historial de Certificados",{"_7979":872,"_22255":867,"_5":22409,"_18887":34586,"_15195":34587,"_1578":34588},[],"/docs/pr-preview/pr-23/manual/servicios-core/devices#detalle-del-dispositivo-línea-de-tiempo-de-eventos","Detalle del Dispositivo: Línea de tiempo de eventos",{"_7979":873,"_22255":867,"_5":22409,"_18887":34590,"_15195":34591,"_1578":34592},[],"/docs/pr-preview/pr-23/manual/servicios-core/devices#registro-de-nuevos-dispositivos","Registro de Nuevos Dispositivos",{"_7979":874,"_22255":867,"_5":22409,"_18887":34594,"_15195":34595,"_1578":34596},[],"/docs/pr-preview/pr-23/manual/servicios-core/devices#asignación-manual-de-identidad","Asignación Manual de Identidad",{"_7979":875,"_22255":867,"_5":22409,"_18887":34598,"_15195":34599,"_1578":34600},[],"/docs/pr-preview/pr-23/manual/servicios-core/devices#revocación-de-identidad","Revocación de Identidad",{"_7979":876,"_22255":867,"_5":22409,"_18887":34602,"_15195":34603,"_1578":34604},[],"/docs/pr-preview/pr-23/manual/servicios-core/devices#desactivación-de-dispositivos-decommissioning","Desactivación de Dispositivos (Decommissioning)",{"_7979":877,"_22255":867,"_18887":34606,"_5":22404,"_15195":34575,"_1578":34607},[],"La gestión del ciclo de vida de las identidades de los dispositivos es una funcionalidad central en Lamassu IoT. Esta sección del manual se enfoca en la visualización y administración de las identidades de los dispositivos ya enrolados, conocidos como *End Entities* (entidades finales). Permite una visión completa del estado, los certificados y los eventos históricos de cada dispositivo, facilitando su monitorización y control a lo largo de su ciclo de vida.",{"_7979":878,"_22255":867,"_18887":34609,"_5":22404,"_15195":34579,"_1578":34610},[],"La página de **Dispositivos** (Managed Devices) ofrece una vista general de todos los dispositivos registrados en el sistema. Puedes ver un resumen del estado de cada dispositivo, su grupo, la fecha de creación y las etiquetas asociadas. Esta visualización es clave para tener una perspectiva general del parque de dispositivos y su salud respecto al estado de su identidad.",{"_7979":879,"_22255":867,"_18887":34612,"_5":22404,"_15195":34579,"_1578":34613},[],"Para facilitar la búsqueda y el seguimiento, la interfaz permite filtrar los dispositivos por **Device ID** y por **Tags**. Además, se puede filtrar por los siguientes estados:",{"_7979":880,"_22255":867,"_18887":34615,"_5":22404,"_15195":34579,"_1578":34616},[],"**Active**: El dispositivo y su certificado están en uso y son válidos.",{"_7979":881,"_22255":867,"_18887":34618,"_5":22404,"_15195":34579,"_1578":34619},[],"**No Identity**: El dispositivo existe en el sistema, pero no tiene una identidad digital (certificado) asociada.",{"_7979":882,"_22255":867,"_18887":34621,"_5":22404,"_15195":34579,"_1578":34622},[],"**Renewal Pending**: El dispositivo se encuentra en la ventana de tiempo de renovación y su certificado expirará pronto.",{"_7979":883,"_22255":867,"_18887":34624,"_5":22404,"_15195":34579,"_1578":34625},[],"**Expiring Soon**: El certificado del dispositivo está a punto de caducar.",{"_7979":884,"_22255":867,"_18887":34627,"_5":22404,"_15195":34579,"_1578":34628},[],"**Expired**: El certificado del dispositivo ha caducado.",{"_7979":885,"_22255":867,"_18887":34630,"_5":22404,"_15195":34579,"_1578":34631},[],"**Revoked**: El certificado del dispositivo ha sido revocado.",{"_7979":886,"_22255":867,"_18887":34633,"_5":22404,"_15195":34579,"_1578":34634},[],"**Decommissioned**: El dispositivo ha sido dado de baja y ya no está en uso.",{"_7979":887,"_22255":867,"_18887":34636,"_5":22404,"_15195":34583,"_1578":34637},[],"Al seleccionar un dispositivo específico, se accede a su página de detalles. La pestaña de **Historial de Certificados** muestra un registro cronológico de todos los certificados X.509 que han sido asociados a la identidad de ese dispositivo. Aquí se pueden ver detalles como el número de serie, el estado del certificado (por ejemplo, activo, expirado o revocado), el nombre común, la CA emisora y los periodos de validez.",{"_7979":888,"_22255":867,"_18887":34639,"_5":22404,"_15195":34583,"_1578":34640},[],"Esta funcionalidad es fundamental para auditar y rastrear la historia de la identidad del dispositivo, lo que permite identificar si un certificado ha sido reemplazado o revocado en algún momento.",{"_7979":889,"_22255":867,"_18887":34642,"_5":22404,"_15195":34587,"_1578":34643},[],"La pestaña de **Línea de tiempo de eventos** (Device Event Timeline) proporciona un registro detallado y cronológico de los eventos más importantes relacionados con el dispositivo y su identidad. Estos eventos pueden incluir el aprovisionamiento inicial, la renovación de certificados o cambios de estado.",{"_7979":890,"_22255":867,"_18887":34645,"_5":22404,"_15195":34587,"_1578":34646},[],"Esta línea de tiempo es una herramienta poderosa para el análisis forense y la resolución de problemas, ya que permite ver la secuencia exacta de las acciones que han ocurrido en la vida del dispositivo.",{"_7979":891,"_22255":867,"_18887":34648,"_5":22404,"_15195":34591,"_1578":34649},[],"Además de la gestión de dispositivos ya enrolados, Lamassu IoT permite el registro manual de nuevos dispositivos. Esto es particularmente útil para el modo de registro por **Pre-registration**, donde la identidad del dispositivo debe existir en el sistema antes de que pueda solicitar un certificado.",{"_7979":892,"_22255":867,"_18887":34651,"_5":22404,"_15195":34591,"_1578":34652},[],"El proceso de registro de un nuevo dispositivo se realiza a través de un formulario que permite configurar los siguientes campos:",{"_7979":893,"_22255":867,"_18887":34654,"_5":22404,"_15195":34591,"_1578":34655},[],"**Device ID (GUID)**: Es el identificador único del dispositivo, normalmente un GUID (Globally Unique Identifier).",{"_7979":894,"_22255":867,"_18887":34657,"_5":22404,"_15195":34591,"_1578":34658},[],"**Registration Authority**: Se debe seleccionar la RA a la que se asociará el dispositivo, lo que definirá las políticas de *enrollment* y *re-enrollment* que se aplicarán.",{"_7979":895,"_22255":867,"_18887":34660,"_5":22404,"_15195":34591,"_1578":34661},[],"**Device Registration Profile**: En esta sección se pueden configurar aspectos visuales para facilitar la identificación del dispositivo.",{"_7979":896,"_22255":867,"_18887":34663,"_5":22404,"_15195":34591,"_1578":34664},[],"**Icon**: Permite seleccionar un icono que represente visualmente el tipo de dispositivo.",{"_7979":897,"_22255":867,"_18887":34666,"_5":22404,"_15195":34591,"_1578":34667},[],"**Tags**: Se pueden añadir etiquetas para agrupar y organizar el dispositivo con otros de características similares.",{"_7979":898,"_22255":867,"_18887":34669,"_5":22404,"_15195":34591,"_1578":34670},[],"Una vez registrado, el dispositivo aparecerá en el listado de dispositivos con el estado **No Identity** hasta que complete el proceso de *enrollment* y obtenga su primer certificado.",{"_7979":899,"_22255":867,"_18887":34672,"_5":22404,"_15195":34595,"_1578":34673},[],"La **Asignación manual de identidad** es una acción que solo está disponible para dispositivos en estado **No Identity**, es decir, que han sido registrados en el sistema pero aún no tienen un certificado asignado. Esta funcionalidad permite vincular un certificado ya existente o emitir uno nuevo de forma manual.",{"_7979":900,"_22255":867,"_18887":34675,"_5":22404,"_15195":34595,"_1578":34676},[],"El proceso se lleva a cabo desde la vista de detalles del dispositivo:",{"_7979":901,"_22255":867,"_18887":34678,"_5":22404,"_15195":34595,"_1578":34679},[],"**Iniciar la asignación**: Se hace clic en el botón **Assign Identity**. Esto abrirá una ventana emergente.",{"_7979":902,"_22255":867,"_18887":34681,"_5":22404,"_15195":34595,"_1578":34682},[],"**Vincular certificado existente**: La aplicación buscará certificados activos con un Common Name (CN) que coincida con el Device ID. Si se encuentra un certificado, se puede seleccionar y vincular al dispositivo.",{"_7979":903,"_22255":867,"_18887":34684,"_5":22404,"_15195":34595,"_1578":34685},[],"**Emitir un nuevo certificado**: Si no se encuentra un certificado existente, o si se desea emitir uno nuevo, se puede seleccionar la opción **Issue New Instead**. Esto te permite elegir la **Certification Authority** que emitirá el nuevo certificado para el dispositivo. Se muestran por defecto las CAs vinculadas a la RA que gestiona ell dispositivo.",{"_7979":904,"_22255":867,"_18887":34687,"_5":22404,"_15195":34595,"_1578":34688},[],"**Confirmar y asignar**: Una vez seleccionado el certificado (existente o nuevo), se confirma la asignación. El dispositivo pasará del estado **No Identity** al estado **Active** y el certificado aparecerá en su historial.",{"_7979":905,"_22255":867,"_18887":34690,"_5":22404,"_15195":34599,"_1578":34691},[],"La revocación de la identidad es un proceso crítico para la seguridad que permite invalidar un certificado antes de su fecha de caducidad. Esta acción es irreversible. En Lamassu IoT, la revocación se realiza desde la sección de detalle del dispositivo, específicamente desde la línea de tiempo de eventos.",{"_7979":906,"_22255":867,"_18887":34693,"_5":22404,"_15195":34599,"_1578":34694},[],"El proceso de revocación se lleva a cabo de la siguiente manera:",{"_7979":907,"_22255":867,"_18887":34696,"_5":22404,"_15195":34599,"_1578":34697},[],"**Acceder a la revocación**: En la sección **Device Event Timeline**, junto al último certificado **Active**, se encuentra la opción de **Revoke**. Al hacer clic en ella, se abre una ventana de confirmación.",{"_7979":908,"_22255":867,"_18887":34699,"_5":22404,"_15195":34599,"_1578":34700},[],"**Seleccionar el motivo de revocación**: La ventana emergente solicita seleccionar un motivo de revocación (Revocation Reason). Esto es esencial para el registro de auditoría y la generación de la CRL (Certificate Revocation List). Los motivos disponibles, definidos en el **RFC 5280**, y otros adicionales son:",{"_7979":909,"_22255":867,"_18887":34702,"_5":22404,"_15195":34599,"_1578":34703},[],"**Unspecified**: Motivo de revocación no especificado.",{"_7979":910,"_22255":867,"_18887":34705,"_5":22404,"_15195":34599,"_1578":34706},[],"**KeyCompromise**: La clave privada del certificado ha sido comprometida.",{"_7979":911,"_22255":867,"_18887":34708,"_5":22404,"_15195":34599,"_1578":34709},[],"**CACompromise**: La clave privada de la CA ha sido comprometida.",{"_7979":912,"_22255":867,"_18887":34711,"_5":22404,"_15195":34599,"_1578":34712},[],"**AffiliationChanged**: El nombre del sujeto o su afiliación ha cambiado.",{"_7979":913,"_22255":867,"_18887":34714,"_5":22404,"_15195":34599,"_1578":34715},[],"**Superseded**: El certificado ha sido reemplazado por uno nuevo.",{"_7979":914,"_22255":867,"_18887":34717,"_5":22404,"_15195":34599,"_1578":34718},[],"**CessationOfOperation**: La entidad ha dejado de operar o usar el certificado.",{"_7979":915,"_22255":867,"_18887":34720,"_5":22404,"_15195":34599,"_1578":34721},[],"**CertificateHold**: El certificado está temporalmente en espera de revocación.",{"_7979":916,"_22255":867,"_18887":34723,"_5":22404,"_15195":34599,"_1578":34724},[],"**RemoveFromCRL**: Se usa en un *delta-CRL* para indicar que el certificado fue previamente puesto en espera y ahora debe ser revocado definitivamente.",{"_7979":917,"_22255":867,"_18887":34726,"_5":22404,"_15195":34599,"_1578":34727},[],"**PrivilegeWithdrawn**: Se han retirado los privilegios de la entidad asociada al certificado.",{"_7979":918,"_22255":867,"_18887":34729,"_5":22404,"_15195":34599,"_1578":34730},[],"**AACompromise**: La clave de un servidor de autorización de atributos ha sido comprometida.",{"_7979":919,"_22255":867,"_18887":34732,"_5":22404,"_15195":34599,"_1578":34733},[],"**WeakAlgorithmOrKey**: La clave o el algoritmo del certificado se consideran débiles o han sido comprometidos.",{"_7979":920,"_22255":867,"_18887":34735,"_5":22404,"_15195":34599,"_1578":34736},[],"**Confirmar la revocación**: Una vez seleccionado el motivo, se confirma la acción. El estado del certificado cambiará a **Revoked** en la línea de tiempo y en el historial de certificados. El certificado revocado dejará de ser válido.\nEs importante destacar que, una vez revocado un certificado, la identidad del dispositivo puede ser restaurada asignándole un nuevo certificado válido. En caso de que la razón de revocación sea CertificateHold, se permitirá la reactivación.",{"_7979":921,"_22255":867,"_18887":34738,"_5":22404,"_15195":34603,"_1578":34739},[],"El *Decommissioning* es el proceso irreversible de dar de baja un dispositivo de forma definitiva del sistema. A diferencia de la revocación, que sólo invalida el certificado, la desactivación revoca todos los certificados asociados al dispositivo y le impide obtener nuevas identidades en el futuro. Es una acción de seguridad crítica que se utiliza cuando un dispositivo es retirado permanentemente o ya no es de confianza.",{"_7979":922,"_22255":867,"_18887":34741,"_5":22404,"_15195":34603,"_1578":34742},[],"El proceso se realiza de la siguiente manera:",{"_7979":923,"_22255":867,"_18887":34744,"_5":22404,"_15195":34603,"_1578":34745},[],"**Acceder a la acción**: Desde la vista de detalles de un dispositivo activo, se hace clic en el botón **Decommission**.",{"_7979":924,"_22255":867,"_18887":34747,"_5":22404,"_15195":34603,"_1578":34748},[],"**Confirmar la acción irreversible**: Aparecerá una ventana de advertencia que explica que la acción es irreversible y que se revocarán todos los certificados asociados al dispositivo, impidiendo que vuelva a obtener una identidad.",{"_7979":925,"_22255":867,"_18887":34750,"_5":22404,"_15195":34603,"_1578":34751},[],"**Confirmar y desactivar**: Al confirmar la desactivación, el sistema revoca el certificado activo del dispositivo con la razón CessationOfOperation y cambia su estado a **Decommissioned**. El dispositivo ya no podrá realizar operaciones con la PKI.",{"_7979":926,"_22255":926,"_5":22399,"_1578":34753,"_22412":34754,"_18887":34755,"_15195":926},"EST: Enrollment over Secure Transport",[31966,33065,33074],[],{"_7979":927,"_22255":926,"_18887":34757,"_5":22404,"_15195":926,"_1578":34758},[],"Guía del protocolo EST en Lamassu IoT, con la configuración del DMS para el administrador PKI y la referencia de endpoints para el integrador de dispositivos.",{"_7979":928,"_22255":926,"_5":22409,"_18887":34760,"_15195":34761,"_1578":34753},[],"/docs/pr-preview/pr-23/manual/servicios-core/est#est-enrollment-over-secure-transport",{"_7979":929,"_22255":926,"_5":22409,"_18887":34763,"_15195":34764,"_1578":33148},[],"/docs/pr-preview/pr-23/manual/servicios-core/est#configuración-del-dms",{"_7979":930,"_22255":926,"_5":22409,"_18887":34766,"_15195":34767,"_1578":32671},[],"/docs/pr-preview/pr-23/manual/servicios-core/est#requisitos-previos",{"_7979":931,"_22255":926,"_5":22409,"_18887":34769,"_15195":34770,"_1578":34771},[],"/docs/pr-preview/pr-23/manual/servicios-core/est#configuración-de-enrollment","Configuración de enrollment",{"_7979":932,"_22255":926,"_5":22409,"_18887":34773,"_15195":34774,"_1578":34775},[],"/docs/pr-preview/pr-23/manual/servicios-core/est#enrollment-device-registration","Enrollment Device Registration",{"_7979":933,"_22255":926,"_5":22409,"_18887":34777,"_15195":34778,"_1578":34779},[],"/docs/pr-preview/pr-23/manual/servicios-core/est#enrollment-settings","Enrollment Settings",{"_7979":934,"_22255":926,"_5":22409,"_18887":34781,"_15195":34782,"_1578":34783},[],"/docs/pr-preview/pr-23/manual/servicios-core/est#perfil-de-emisión","Perfil de emisión",{"_7979":935,"_22255":926,"_5":22409,"_18887":34785,"_15195":34786,"_1578":34787},[],"/docs/pr-preview/pr-23/manual/servicios-core/est#configuración-de-re-enrollment","Configuración de re-enrollment",{"_7979":936,"_22255":926,"_5":22409,"_18887":34789,"_15195":34790,"_1578":34791},[],"/docs/pr-preview/pr-23/manual/servicios-core/est#configuración-de-serverkeygen","Configuración de ServerKeyGen",{"_7979":937,"_22255":926,"_5":22409,"_18887":34793,"_15195":34794,"_1578":34795},[],"/docs/pr-preview/pr-23/manual/servicios-core/est#verificar-la-configuración","Verificar la configuración",{"_7979":938,"_22255":926,"_5":22409,"_18887":34797,"_15195":34798,"_1578":34799},[],"/docs/pr-preview/pr-23/manual/servicios-core/est#integración-de-dispositivos","Integración de dispositivos",{"_7979":939,"_22255":926,"_5":22409,"_18887":34801,"_15195":34802,"_1578":34803},[],"/docs/pr-preview/pr-23/manual/servicios-core/est#antes-de-empezar","Antes de empezar",{"_7979":940,"_22255":926,"_5":22409,"_18887":34805,"_15195":34806,"_1578":34807},[],"/docs/pr-preview/pr-23/manual/servicios-core/est#resumen-del-flujo","Resumen del flujo",{"_7979":941,"_22255":926,"_5":22409,"_18887":34809,"_15195":34810,"_1578":34811},[],"/docs/pr-preview/pr-23/manual/servicios-core/est#modelo-de-autenticación-del-cliente","Modelo de autenticación del cliente",{"_7979":942,"_22255":926,"_5":22409,"_18887":34813,"_15195":34814,"_1578":34815},[],"/docs/pr-preview/pr-23/manual/servicios-core/est#referencia-de-endpoints","Referencia de endpoints",{"_7979":943,"_22255":926,"_5":22409,"_18887":34817,"_15195":34818,"_1578":34819},[],"/docs/pr-preview/pr-23/manual/servicios-core/est#cacerts","`/cacerts`",{"_7979":944,"_22255":926,"_5":22409,"_18887":34821,"_15195":34822,"_1578":34823},[],"/docs/pr-preview/pr-23/manual/servicios-core/est#simpleenroll","`/simpleenroll`",{"_7979":945,"_22255":926,"_5":22409,"_18887":34825,"_15195":34826,"_1578":34827},[],"/docs/pr-preview/pr-23/manual/servicios-core/est#simplereenroll","`/simplereenroll`",{"_7979":946,"_22255":926,"_5":22409,"_18887":34829,"_15195":34830,"_1578":34831},[],"/docs/pr-preview/pr-23/manual/servicios-core/est#serverkeygen","`/serverkeygen`",{"_7979":947,"_22255":926,"_5":22409,"_18887":34833,"_15195":34834,"_1578":34835},[],"/docs/pr-preview/pr-23/manual/servicios-core/est#flujos-completos","Flujos completos",{"_7979":948,"_22255":926,"_5":22409,"_18887":34837,"_15195":34838,"_1578":34839},[],"/docs/pr-preview/pr-23/manual/servicios-core/est#ejemplo-end-to-end-enroll","Ejemplo end-to-end: enroll",{"_7979":949,"_22255":926,"_5":22409,"_18887":34841,"_15195":34842,"_1578":34843},[],"/docs/pr-preview/pr-23/manual/servicios-core/est#ejemplo-end-to-end-reenroll","Ejemplo end-to-end: reenroll",{"_7979":950,"_22255":926,"_5":22409,"_18887":34845,"_15195":34846,"_1578":34847},[],"/docs/pr-preview/pr-23/manual/servicios-core/est#próximos-pasos-tras-el-enrolamiento","Próximos pasos tras el enrolamiento",{"_7979":951,"_22255":926,"_5":22409,"_18887":34849,"_15195":34850,"_1578":34851},[],"/docs/pr-preview/pr-23/manual/servicios-core/est#diagnóstico-y-compatibilidad","Diagnóstico y compatibilidad",{"_7979":952,"_22255":926,"_5":22409,"_18887":34853,"_15195":34854,"_1578":34855},[],"/docs/pr-preview/pr-23/manual/servicios-core/est#códigos-de-error-y-diagnóstico","Códigos de error y diagnóstico",{"_7979":953,"_22255":926,"_5":22409,"_18887":34857,"_15195":34858,"_1578":34859},[],"/docs/pr-preview/pr-23/manual/servicios-core/est#notas-de-compatibilidad","Notas de compatibilidad",{"_7979":954,"_22255":926,"_18887":34861,"_5":22404,"_15195":34761,"_1578":34862},[],"Lamassu IoT implementa el protocolo &#x2A;*EST (Enrollment over Secure Transport)** descrito en el RFC 7030 como su único mecanismo de inscripción de certificados para dispositivos. Cada DMS expone los endpoints EST, valida al dispositivo y aplica sus propias políticas de autenticación, registro y renovación — actuando como autoridad de registro (RA) frente al cliente.",{"_7979":955,"_22255":926,"_18887":34864,"_5":22404,"_15195":34761,"_1578":34865},[],"La entidad que emite y firma criptográficamente el certificado es siempre la **CA asociada al DMS**, no el DMS. El DMS coordina el proceso: recibe el CSR, autentica al dispositivo y aplica la política de emisión. Esta distinción es relevante para el administrador PKI al seleccionar la `EnrollmentCA` y para el integrador al interpretar la cadena de confianza recibida de `/cacerts`.",{"_7979":956,"_22255":926,"_18887":34867,"_5":22404,"_15195":34761,"_1578":34868},[],"Esta guía está dividida en dos partes:",{"_7979":957,"_22255":926,"_18887":34870,"_5":22404,"_15195":34761,"_1578":34871},[],"Configuración del DMS, para el administrador PKI.",{"_7979":958,"_22255":926,"_18887":34873,"_5":22404,"_15195":34761,"_1578":34874},[],"Integración de dispositivos, para quien consume los endpoints EST desde firmware, scripts o servicios de aprovisionamiento.",{"_7979":959,"_22255":926,"_18887":34876,"_5":22404,"_15195":34761,"_1578":34877},[],"Si solo necesita una orientación rápida, este es el recorrido recomendado:",{"_7979":960,"_22255":926,"_18887":34879,"_5":22404,"_15195":34761,"_1578":34880},[],"Perfil",{"_7979":961,"_22255":926,"_18887":34882,"_5":22404,"_15195":34761,"_1578":34883},[],"Leer primero",{"_7979":962,"_22255":926,"_18887":34885,"_5":22404,"_15195":34761,"_1578":34886},[],"Después",{"_7979":963,"_22255":926,"_18887":34888,"_5":22404,"_15195":34761,"_1578":34889},[],"Administrador PKI",{"_7979":964,"_22255":926,"_18887":34891,"_5":22404,"_15195":34761,"_1578":33148},[],{"_7979":965,"_22255":926,"_18887":34893,"_5":22404,"_15195":34761,"_1578":34851},[],{"_7979":966,"_22255":926,"_18887":34895,"_5":22404,"_15195":34761,"_1578":34896},[],"Integrador de dispositivos",{"_7979":967,"_22255":926,"_18887":34898,"_5":22404,"_15195":34761,"_1578":34803},[],{"_7979":968,"_22255":926,"_18887":34900,"_5":22404,"_15195":34761,"_1578":34901},[],"Los endpoints `/cacerts`, `/simpleenroll`, `/simplereenroll` o `/serverkeygen`, según el flujo",{"_7979":969,"_22255":926,"_18887":34903,"_5":22404,"_15195":34767,"_1578":34904},[],"Antes de configurar un DMS para EST, deben existir los siguientes recursos en la plataforma:",{"_7979":970,"_22255":926,"_18887":34906,"_5":22404,"_15195":34767,"_1578":34907},[],"**Una CA disponible**: la CA que actuará como `EnrollmentCA` debe estar creada y en estado activo en Lamassu. Si el modo de autenticación es `CLIENT_CERTIFICATE`, también deben estar creadas las CAs de validación del certificado bootstrap.",{"_7979":971,"_22255":926,"_18887":34909,"_5":22404,"_15195":34767,"_1578":34910},[],"**Un DMS creado**: el DMS al que se aplicará esta configuración debe existir previamente. La configuración EST se aplica sobre un DMS existente, no lo crea.",{"_7979":972,"_22255":926,"_18887":34912,"_5":22404,"_15195":34767,"_1578":34913},[],"Conviene separar cuatro bloques de configuración:",{"_7979":973,"_22255":926,"_18887":34915,"_5":22404,"_15195":34767,"_1578":34916},[],"Cómo se realizará el enrollment inicial, incluyendo el modo de alta y la autenticación del cliente.",{"_7979":974,"_22255":926,"_18887":34918,"_5":22404,"_15195":34767,"_1578":34919},[],"Cómo se gestionará el re-enrollment de certificados ya emitidos.",{"_7979":975,"_22255":926,"_18887":34921,"_5":22404,"_15195":34767,"_1578":34922},[],"Cómo se configurará el endpoint cacerts para la distribución de las CAs de confianza utilizadas por los dispositivos.",{"_7979":976,"_22255":926,"_18887":34924,"_5":22404,"_15195":34767,"_1578":34925},[],"Si se habilitará la generación de claves en servidor mediante `ServerKeyGen`.",{"_7979":977,"_22255":926,"_18887":34927,"_5":22404,"_15195":34774,"_1578":34928},[],"En esta sección se define cómo se registran los dispositivos nuevos y con qué credenciales se autentican.",{"_7979":978,"_22255":926,"_18887":34930,"_5":22404,"_15195":34774,"_1578":34931},[],"**Registration Mode**: determina el comportamiento al recibir una inscripción inicial. En modo `JITP` (*Just-In-Time Provisioning*), el dispositivo se crea automáticamente la primera vez que se presenta, aplicando los tags, metadatos e icono definidos en el perfil de aprovisionamiento. En modo `PRE_REGISTRATION`, el dispositivo debe existir previamente en la plataforma; si no existe, la solicitud se rechaza con `device not preregistered`. El modo JITP es adecuado para flotas grandes donde el inventario se construye durante el despliegue; el modo `PRE_REGISTRATION` encaja en entornos de alta seguridad donde cada dispositivo se aprueba de forma explícita antes de recibir un certificado.",{"_7979":979,"_22255":926,"_18887":34933,"_5":22404,"_15195":34774,"_1578":34934},[],"**Tags**: se aplican a cada dispositivo creado automáticamente por este DMS. Son opcionales y solo tienen efecto en modo JITP. Los tags permiten mejorar la búsqueda de dispositivos.",{"_7979":980,"_22255":926,"_18887":34936,"_5":22404,"_15195":34774,"_1578":34937},[],"**Icon**: se aplica a cada dispositivo creado automáticamente por este DMS. Es opcional y solo tiene efecto en modo JITP. Únicamente visual.",{"_7979":981,"_22255":926,"_18887":34939,"_5":22404,"_15195":34778,"_1578":34940},[],"**Enrollment CA**: identifica la CA que firmará los certificados de identidad emitidos a través de este DMS. Su elección determina la cadena de confianza que el dispositivo recibirá y la raíz contra la que los sistemas de backend validarán los certificados de flota.",{"_7979":982,"_22255":926,"_18887":34942,"_5":22404,"_15195":34778,"_1578":34943},[],"**Allow Override Enrollment** (`enable_replaceable_enrollment`): permite que un dispositivo ya enrolado vuelva a inscribirse mediante `/simpleenroll`. Cuando está activa, el certificado anterior se revoca con la razón `superseded` y el slot de identidad se actualiza. Cuando está inactiva, un segundo intento de `simpleenroll` se rechaza con `forbiddenNewEnrollment`. Esta opción debe habilitarse con precaución en entornos de producción, ya que permite sustituir la identidad de un dispositivo sin pasar por el flujo de re-enrollment.",{"_7979":983,"_22255":926,"_18887":34945,"_5":22404,"_15195":34778,"_1578":34946},[],"**Verify CSR Signature** (`verify_csr_signature`): controla si el servidor valida la firma del CSR contra la clave pública declarada en él (prueba de posesión PKCS#10). Cuando está inactiva, un solicitante podría enviar un CSR con una clave pública que no controla y obtener un certificado vinculado a ella. Para flotas IoT en redes abiertas debe estar activa.",{"_7979":984,"_22255":926,"_18887":34948,"_5":22404,"_15195":34778,"_1578":34949},[],"**Authentication Mode**: define cómo el DMS valida la identidad del dispositivo durante el enrollment. Los cuatro modos disponibles son:",{"_7979":985,"_22255":926,"_18887":34951,"_5":22404,"_15195":34778,"_1578":34952},[],"Modo",{"_7979":986,"_22255":926,"_18887":34954,"_5":22404,"_15195":34778,"_1578":32169},[],{"_7979":987,"_22255":926,"_18887":34956,"_5":22404,"_15195":34778,"_1578":34957},[],"`CLIENT_CERTIFICATE`",{"_7979":988,"_22255":926,"_18887":34959,"_5":22404,"_15195":34778,"_1578":34960},[],"mTLS. El dispositivo presenta un certificado X.509 emitido por alguna de las CAs declaradas en **Validation CAs**.",{"_7979":989,"_22255":926,"_18887":34962,"_5":22404,"_15195":34778,"_1578":34963},[],"`EXTERNAL_WEBHOOK`",{"_7979":990,"_22255":926,"_18887":34965,"_5":22404,"_15195":34778,"_1578":34966},[],"La decisión de autorización se delega en un servicio HTTP externo. Solo aplica en `/simpleenroll`; en `/simplereenroll` este modo degrada silenciosamente a `NO_AUTH`.",{"_7979":991,"_22255":926,"_18887":34968,"_5":22404,"_15195":34778,"_1578":34969},[],"`CLIENT_CERTIFICATE_AND_EXTERNAL_WEBHOOK`",{"_7979":992,"_22255":926,"_18887":34971,"_5":22404,"_15195":34778,"_1578":34972},[],"Combina los dos anteriores: se exige un certificado cliente válido **y** la confirmación del webhook externo.",{"_7979":993,"_22255":926,"_18887":34974,"_5":22404,"_15195":34778,"_1578":34975},[],"`NO_AUTH`",{"_7979":994,"_22255":926,"_18887":34977,"_5":22404,"_15195":34778,"_1578":34978},[],"Sin autenticación. Cualquier CSR se acepta. **Exclusivo para entornos de laboratorio o redes de aprovisionamiento aisladas**; no debe usarse en producción.",{"_7979":995,"_22255":926,"_18887":34980,"_5":22404,"_15195":34778,"_1578":34981},[],"Cuando el modo es `CLIENT_CERTIFICATE` o `CLIENT_CERTIFICATE_AND_EXTERNAL_WEBHOOK`, se configuran además estos parámetros:",{"_7979":996,"_22255":926,"_18887":34983,"_5":22404,"_15195":34778,"_1578":34984},[],"**Validation CAs**: lista de CAs de confianza para validar el certificado bootstrap presentado por el dispositivo.",{"_7979":997,"_22255":926,"_18887":34986,"_5":22404,"_15195":34778,"_1578":34987},[],"**Chain Validation Level**: profundidad máxima de la cadena de validación. El valor `-1` valida la cadena completa hasta la CA raíz.",{"_7979":998,"_22255":926,"_18887":34989,"_5":22404,"_15195":34778,"_1578":34990},[],"**Allow Authenticating Expired Certificates**: si está activo, acepta certificados cliente caducados. Es útil en escenarios de recuperación donde el dispositivo no pudo renovar su certificado a tiempo.",{"_7979":999,"_22255":926,"_18887":34992,"_5":22404,"_15195":34778,"_1578":34993},[],"Cuando el modo incluye `EXTERNAL_WEBHOOK`, se configuran además estos parámetros:",{"_7979":1000,"_22255":926,"_18887":34995,"_5":22404,"_15195":34778,"_1578":34996},[],"**Webhook URL**: dirección del servicio externo que decidirá la autorización.",{"_7979":1001,"_22255":926,"_18887":34998,"_5":22404,"_15195":34778,"_1578":34999},[],"**HTTP Method**: método HTTP utilizado para invocar el webhook. Admite `POST` (por defecto) o `PUT`; ambos son equivalentes para el webhook, solo cambia el verbo con el que Lamassu realiza la llamada.",{"_7979":1002,"_22255":926,"_18887":35001,"_5":22404,"_15195":34778,"_1578":35002},[],"**Timeout**: tiempo máximo de espera de la llamada al webhook. Si no se especifica, el valor por defecto es de **10 segundos**; superado ese plazo sin respuesta, Lamassu deniega la operación.",{"_7979":1003,"_22255":926,"_18887":35004,"_5":22404,"_15195":34778,"_1578":35005},[],"**Webhook Authentication Mode**: modo de autenticación del webhook hacia el servicio externo, por ejemplo `ApiKey`, `OIDC` o `mTLS`.",{"_7979":1004,"_22255":926,"_18887":35007,"_5":22404,"_15195":34778,"_1578":35008},[],"El contrato exacto que debe implementar el servicio webhook (esquema de petición y respuesta, ejemplos) está publicado como especificación OpenAPI: referencia del webhook de autorización.",{"_7979":1005,"_22255":926,"_18887":35010,"_5":22404,"_15195":34782,"_1578":35011},[],"El comportamiento del certificado emitido no lo determina únicamente el CSR del dispositivo, sino el **perfil de emisión** (`IssuanceProfile`) asociado al DMS. El integrador no configura este perfil, pero sus reglas afectan al contenido del certificado final:",{"_7979":1006,"_22255":926,"_18887":35013,"_5":22404,"_15195":34782,"_1578":35014},[],"Campo",{"_7979":1007,"_22255":926,"_18887":35016,"_5":22404,"_15195":34782,"_1578":33300},[],{"_7979":1008,"_22255":926,"_18887":35018,"_5":22404,"_15195":34782,"_1578":35019},[],"Efecto sobre el certificado emitido",{"_7979":1009,"_22255":926,"_18887":35021,"_5":22404,"_15195":34782,"_1578":35022},[],"`HonorSubject`",{"_7979":1010,"_22255":926,"_18887":35024,"_5":22404,"_15195":34782,"_1578":20595},[],{"_7979":1011,"_22255":926,"_18887":35026,"_5":22404,"_15195":34782,"_1578":35027},[],"Si `true`, el subject del CSR se traslada literalmente al certificado. Si `false`, la CA aplica la plantilla del perfil e ignora el subject del CSR.",{"_7979":1012,"_22255":926,"_18887":35029,"_5":22404,"_15195":34782,"_1578":35030},[],"`HonorKeyUsage`",{"_7979":1013,"_22255":926,"_18887":35032,"_5":22404,"_15195":34782,"_1578":20595},[],{"_7979":1014,"_22255":926,"_18887":35034,"_5":22404,"_15195":34782,"_1578":35035},[],"Si `true`, el `KeyUsage` del CSR se respeta. Si `false`, se aplica la plantilla del perfil.",{"_7979":1015,"_22255":926,"_18887":35037,"_5":22404,"_15195":34782,"_1578":35038},[],"`HonorExtendedKeyUsages`",{"_7979":1016,"_22255":926,"_18887":35040,"_5":22404,"_15195":34782,"_1578":20595},[],{"_7979":1017,"_22255":926,"_18887":35042,"_5":22404,"_15195":34782,"_1578":35043},[],"Igual que `HonorKeyUsage`, pero para `ExtKeyUsage`.",{"_7979":1018,"_22255":926,"_18887":35045,"_5":22404,"_15195":34782,"_1578":35046},[],"`HonorExtensions`",{"_7979":1019,"_22255":926,"_18887":35048,"_5":22404,"_15195":34782,"_1578":20595},[],{"_7979":1020,"_22255":926,"_18887":35050,"_5":22404,"_15195":34782,"_1578":35051},[],"Controla si el resto de extensiones del CSR (SAN, CDP, etc.) se incluyen en el certificado.",{"_7979":1021,"_22255":926,"_18887":35053,"_5":22404,"_15195":34782,"_1578":35054},[],"Esto es relevante para el integrador: el `KeyUsage`, `ExtKeyUsage` y los SAN que declara el CSR pueden no aparecer tal cual en el certificado final si el perfil así lo decide. Consulte con el administrador PKI si el certificado emitido no contiene las extensiones esperadas.",{"_7979":1022,"_22255":926,"_18887":35056,"_5":22404,"_15195":34786,"_1578":35057},[],"La sección **Re-Enrollment Settings** controla el proceso de renovación de certificados. El re-enrollment puede realizarse únicamente cuando el certificado está dentro de la ventana configurada, y opcionalmente también cuando el certificado ya ha caducado.",{"_7979":1023,"_22255":926,"_18887":35059,"_5":22404,"_15195":34786,"_1578":35060},[],"**Revoke On Re-Enroll**: si está activo, el certificado anterior se revoca automáticamente con la razón `superseded` una vez emitido el nuevo.",{"_7979":1024,"_22255":926,"_18887":35062,"_5":22404,"_15195":34786,"_1578":35063},[],"**Allow Expired Renewal**: permite renovar un certificado ya caducado. Es útil cuando un dispositivo ha estado desconectado y no pudo renovar dentro de la ventana.",{"_7979":1025,"_22255":926,"_18887":35065,"_5":22404,"_15195":34786,"_1578":35066},[],"**Allowed Renewal Delta**: ventana de tiempo previa a la caducidad durante la cual se permite el re-enrollment. Antes de que se abra esta ventana, la solicitud se rechaza con `invalid reenroll window`.",{"_7979":1026,"_22255":926,"_18887":35068,"_5":22404,"_15195":34786,"_1578":35069},[],"**Preventive Renewal Delta**: tiempo previo a la caducidad a partir del cual se emiten alertas de renovación preventiva.",{"_7979":1027,"_22255":926,"_18887":35071,"_5":22404,"_15195":34786,"_1578":35072},[],"**Critical Renewal Delta**: umbral más cercano al vencimiento que activa alertas de estado crítico.",{"_7979":1028,"_22255":926,"_18887":35074,"_5":22404,"_15195":34786,"_1578":35075},[],"**Additional Validation CAs**: CAs adicionales aceptadas como emisoras del certificado en vigor durante el re-enrollment. Permite migrar a una nueva CA de enrolamiento sin interrumpir la renovación de dispositivos ya enrolados con la CA anterior.",{"_7979":1029,"_22255":926,"_18887":35077,"_5":22404,"_15195":34790,"_1578":35078},[],"La sección **Server Key Generation** permite que Lamassu genere el par de claves del dispositivo en el servidor y lo devuelva junto con el certificado emitido. Es útil para dispositivos con capacidad criptográfica limitada.",{"_7979":1030,"_22255":926,"_18887":35080,"_5":22404,"_15195":34790,"_1578":35081},[],"La opción **Enable Server-Side Key Generation** activa el endpoint `/serverkeygen`. Cuando está inactiva, cualquier llamada a ese endpoint se rechaza con `server key generation not enabled`.",{"_7979":1031,"_22255":926,"_18887":35083,"_5":22404,"_15195":34790,"_1578":35084},[],"**Key Type** selecciona el algoritmo: `RSA` o `ECDSA`. El campo &#x2A;*Key Size (bits)** determina el tamaño de la clave. Para ECDSA, el tamaño en bits determina también la curva: 256 corresponde a P-256, 384 a P-384 y 521 a P-521.",{"_7979":1032,"_22255":926,"_18887":35086,"_5":22404,"_15195":34790,"_1578":35087},[],"La clave se genera en el motor software del servidor, no en un Crypto Engine de hardware como AWS KMS o PKCS#11. La única protección de la clave en tránsito es el canal TLS; no se aplica cifrado adicional (CMS EnvelopedData) sobre la clave antes de enviarla al dispositivo. Consulte el apartado `/serverkeygen` de la referencia para integrador para conocer el formato exacto de la respuesta y las consideraciones de seguridad.",{"_7979":1033,"_22255":926,"_18887":35089,"_5":22404,"_15195":34794,"_1578":35090},[],"Una vez aplicados los ajustes de enrollment, re-enrollment y ServerKeyGen, puede confirmar que el DMS está operativo de las siguientes formas:",{"_7979":1034,"_22255":926,"_18887":35092,"_5":22404,"_15195":34794,"_1578":35093},[],"**Desde la consola**: accede al detalle del DMS y comprueba que la sección EST muestra la CA de enrolamiento asignada y el modo de autenticación configurado.",{"_7979":1035,"_22255":926,"_18887":35095,"_5":22404,"_15195":34794,"_1578":35096},[],"**Con una solicitud de prueba**: invoca el endpoint `/cacerts` del DMS desde un cliente `curl` con la confianza del servidor. Una respuesta `200 OK` con contenido base64 confirma que el DMS está activo y que la CA de enrolamiento es accesible.",{"_7979":1036,"_22255":926,"_18887":35098,"_5":22404,"_15195":34794,"_1578":35099},[],"Si el DMS no existe o la CA no está disponible, el servidor responde con `DMS not found` u otro mensaje de error. Consulte la sección Diagnóstico y compatibilidad para interpretar los mensajes de error.",{"_7979":1037,"_22255":926,"_18887":35101,"_5":22404,"_15195":34798,"_1578":35102},[],"*Esta sección está dirigida al integrador de dispositivos.*",{"_7979":1038,"_22255":926,"_18887":35104,"_5":22404,"_15195":34798,"_1578":35105},[],"Los endpoints EST de Lamassu se publican bajo el prefijo `/.well-known/est` y exigen siempre la presencia del segmento de ruta `{aps}`, que se interpreta como el identificador del DMS al que se dirige la operación. La asociación es directa: el valor de `{aps}` recibido en la URL se utiliza como ID de DMS al consultar el almacén interno. Las variantes registradas sin `{aps}` (por ejemplo `/.well-known/est/cacerts`) están enrutadas en el código, pero su gestor exige el campo `APS` y devuelve `400 Bad Request` con el mensaje `Field validation for 'APS' failed` cuando el segmento no se proporciona.",{"_7979":1039,"_22255":926,"_18887":35107,"_5":22404,"_15195":34798,"_1578":35108},[],"Esta parte sigue el orden habitual de trabajo del integrador: primero los requisitos previos y el modelo de autenticación, después la referencia de cada endpoint y, al final, ejemplos completos y material de diagnóstico.",{"_7979":1040,"_22255":926,"_18887":35110,"_5":22404,"_15195":34802,"_1578":35111},[],"El administrador PKI debe haber configurado un DMS con el protocolo `EST_RFC7030`, una CA de enrolamiento asignada y al menos un modo de autenticación. Sin esa configuración previa, Lamassu rechaza cualquier solicitud de enrolamiento. Los detalles de esa configuración se encuentran en la sección de configuración del DMS de esta misma página.",{"_7979":1041,"_22255":926,"_18887":35113,"_5":22404,"_15195":34802,"_1578":35114},[],"Antes de realizar la primera llamada, asegúrese de tener:",{"_7979":1042,"_22255":926,"_18887":35116,"_5":22404,"_15195":34802,"_1578":35117},[],"Elemento",{"_7979":1043,"_22255":926,"_18887":35119,"_5":22404,"_15195":34802,"_1578":32169},[],{"_7979":1044,"_22255":926,"_18887":35121,"_5":22404,"_15195":34802,"_1578":35122},[],"**URL del host EST**",{"_7979":1045,"_22255":926,"_18887":35124,"_5":22404,"_15195":34802,"_1578":35125},[],"Dirección base del servidor, por ejemplo `https://est.lamassu.example`. La proporciona el administrador PKI.",{"_7979":1046,"_22255":926,"_18887":35127,"_5":22404,"_15195":34802,"_1578":35128},[],"**Ancla de confianza del servidor** (`lamassu-trust.pem`)",{"_7979":1047,"_22255":926,"_18887":35130,"_5":22404,"_15195":34802,"_1578":35131},[],"Certificado raíz o intermedio con el que validar el TLS del servidor Lamassu. Sin él, el cliente rechazará el certificado del servidor.",{"_7979":1048,"_22255":926,"_18887":35133,"_5":22404,"_15195":34802,"_1578":35134},[],"**Certificado bootstrap + clave privada**",{"_7979":1049,"_22255":926,"_18887":35136,"_5":22404,"_15195":34802,"_1578":35137},[],"Solo para modos `CLIENT_CERTIFICATE` o `CLIENT_CERTIFICATE_AND_EXTERNAL_WEBHOOK`. Es el certificado de aprovisionamiento emitido por alguna de las `ValidationCAs` del DMS, normalmente una CA dedicada al provisioning y distinta de la CA de enrolamiento.",{"_7979":1050,"_22255":926,"_18887":35139,"_5":22404,"_15195":34802,"_1578":35140},[],"**ID del DMS** (`{aps}`)",{"_7979":1051,"_22255":926,"_18887":35142,"_5":22404,"_15195":34802,"_1578":35143},[],"Identificador del DMS que aparece en todas las rutas EST. Lo proporciona el administrador PKI.",{"_7979":1052,"_22255":926,"_18887":35145,"_5":22404,"_15195":34806,"_1578":35146},[],"Caso",{"_7979":1053,"_22255":926,"_18887":35148,"_5":22404,"_15195":34806,"_1578":35149},[],"Credencial habitual",{"_7979":1054,"_22255":926,"_18887":35151,"_5":22404,"_15195":34806,"_1578":35152},[],"Endpoint principal",{"_7979":1055,"_22255":926,"_18887":35154,"_5":22404,"_15195":34806,"_1578":35155},[],"Resultado",{"_7979":1056,"_22255":926,"_18887":35157,"_5":22404,"_15195":34806,"_1578":35158},[],"Alta inicial",{"_7979":1057,"_22255":926,"_18887":35160,"_5":22404,"_15195":34806,"_1578":35161},[],"Certificado bootstrap o el modo definido en `AuthMode`",{"_7979":1058,"_22255":926,"_18887":35163,"_5":22404,"_15195":34806,"_1578":34823},[],{"_7979":1059,"_22255":926,"_18887":35165,"_5":22404,"_15195":34806,"_1578":35166},[],"Certificado de dispositivo",{"_7979":1060,"_22255":926,"_18887":35168,"_5":22404,"_15195":34806,"_1578":35169},[],"Renovación",{"_7979":1061,"_22255":926,"_18887":35171,"_5":22404,"_15195":34806,"_1578":35172},[],"Certificado actual del dispositivo",{"_7979":1062,"_22255":926,"_18887":35174,"_5":22404,"_15195":34806,"_1578":34827},[],{"_7979":1063,"_22255":926,"_18887":35176,"_5":22404,"_15195":34806,"_1578":35177},[],"Certificado renovado",{"_7979":1064,"_22255":926,"_18887":35179,"_5":22404,"_15195":34806,"_1578":35180},[],"Descarga de confianza",{"_7979":1065,"_22255":926,"_18887":35182,"_5":22404,"_15195":34806,"_1578":35183},[],"TLS del servidor",{"_7979":1066,"_22255":926,"_18887":35185,"_5":22404,"_15195":34806,"_1578":34819},[],{"_7979":1067,"_22255":926,"_18887":35187,"_5":22404,"_15195":34806,"_1578":35188},[],"PKCS#7 o PEM con certificados",{"_7979":1068,"_22255":926,"_18887":35190,"_5":22404,"_15195":34806,"_1578":35191},[],"Clave generada en servidor",{"_7979":1069,"_22255":926,"_18887":35193,"_5":22404,"_15195":34806,"_1578":35194},[],"Igual que `/simpleenroll`",{"_7979":1070,"_22255":926,"_18887":35196,"_5":22404,"_15195":34806,"_1578":34831},[],{"_7979":1071,"_22255":926,"_18887":35198,"_5":22404,"_15195":34806,"_1578":35199},[],"Clave privada PKCS#8 + certificado",{"_7979":1072,"_22255":926,"_18887":35201,"_5":22404,"_15195":34810,"_1578":35202},[],"La implementación de Lamassu reconoce cuatro configuraciones de autenticación para `/simpleenroll`, expresadas mediante el campo `EnrollmentOptionsESTRFC7030.AuthMode` del DMS. Tres son modos simples (`CLIENT_CERTIFICATE`, `EXTERNAL_WEBHOOK`, `NO_AUTH`) y una combina dos controles (`CLIENT_CERTIFICATE_AND_EXTERNAL_WEBHOOK`). El cliente debe presentarse en el modo que el DMS espera; cualquier otra combinación genera un fallo en la inscripción.",{"_7979":1073,"_22255":926,"_18887":35204,"_5":22404,"_15195":34810,"_1578":35205},[],"Modo (`AuthMode`)",{"_7979":1074,"_22255":926,"_18887":35207,"_5":22404,"_15195":34810,"_1578":32169},[],{"_7979":1075,"_22255":926,"_18887":35209,"_5":22404,"_15195":34810,"_1578":35210},[],"Credencial esperada",{"_7979":1076,"_22255":926,"_18887":35212,"_5":22404,"_15195":34810,"_1578":35213},[],"Aplica en enroll",{"_7979":1077,"_22255":926,"_18887":35215,"_5":22404,"_15195":34810,"_1578":35216},[],"Aplica en reenroll",{"_7979":1078,"_22255":926,"_18887":35218,"_5":22404,"_15195":34810,"_1578":34957},[],{"_7979":1079,"_22255":926,"_18887":35220,"_5":22404,"_15195":34810,"_1578":35221},[],"mTLS con certificado X.509",{"_7979":1080,"_22255":926,"_18887":35223,"_5":22404,"_15195":34810,"_1578":35224},[],"Certificado y clave privada cliente",{"_7979":1081,"_22255":926,"_18887":35226,"_5":22404,"_15195":34810,"_1578":33313},[],{"_7979":1082,"_22255":926,"_18887":35228,"_5":22404,"_15195":34810,"_1578":35229},[],"Sí (con el certificado en vigor)",{"_7979":1083,"_22255":926,"_18887":35231,"_5":22404,"_15195":34810,"_1578":34969},[],{"_7979":1084,"_22255":926,"_18887":35233,"_5":22404,"_15195":34810,"_1578":35234},[],"mTLS más validación por webhook",{"_7979":1085,"_22255":926,"_18887":35236,"_5":22404,"_15195":34810,"_1578":35237},[],"Certificado y clave privada cliente, más aprobación del webhook",{"_7979":1086,"_22255":926,"_18887":35239,"_5":22404,"_15195":34810,"_1578":33313},[],{"_7979":1087,"_22255":926,"_18887":35241,"_5":22404,"_15195":34810,"_1578":35242},[],"No como combinación; en reenroll no mantiene ambos controles",{"_7979":1088,"_22255":926,"_18887":35244,"_5":22404,"_15195":34810,"_1578":34963},[],{"_7979":1089,"_22255":926,"_18887":35246,"_5":22404,"_15195":34810,"_1578":35247},[],"Webhook externo de autorización",{"_7979":1090,"_22255":926,"_18887":35249,"_5":22404,"_15195":34810,"_1578":35250},[],"Ninguna en el canal TLS",{"_7979":1091,"_22255":926,"_18887":35252,"_5":22404,"_15195":34810,"_1578":33313},[],{"_7979":1092,"_22255":926,"_18887":35254,"_5":22404,"_15195":34810,"_1578":35255},[],"No, degrada a `NO_AUTH`",{"_7979":1093,"_22255":926,"_18887":35257,"_5":22404,"_15195":34810,"_1578":34975},[],{"_7979":1094,"_22255":926,"_18887":35259,"_5":22404,"_15195":34810,"_1578":35260},[],"Sin autenticación",{"_7979":1095,"_22255":926,"_18887":35262,"_5":22404,"_15195":34810,"_1578":35263},[],"Ninguna",{"_7979":1096,"_22255":926,"_18887":35265,"_5":22404,"_15195":34810,"_1578":35266},[],"Sí (uso restringido)",{"_7979":1097,"_22255":926,"_18887":35268,"_5":22404,"_15195":34810,"_1578":35266},[],{"_7979":1098,"_22255":926,"_18887":35270,"_5":22404,"_15195":34810,"_1578":35271},[],"JWT **no es un modo de autenticación válido en EST**. El extractor de identidad JWT existe en el código pero solo se evalúa en la API de administración de Lamassu. Cualquier *Bearer token* enviado a `/.well-known/est/...` se ignora silenciosamente. Cuando el DMS está configurado con `AuthMode: CLIENT_CERTIFICATE`, una petición que solo aporte JWT se rechaza por falta de certificado cliente. Cuando el DMS está en `AuthMode: NO_AUTH`, la petición se procesa como tal y el JWT no añade ni resta autorización.",{"_7979":1099,"_22255":926,"_18887":35273,"_5":22404,"_15195":34810,"_1578":35274},[],"**`CLIENT_CERTIFICATE`**: el cliente presenta un certificado X.509 emitido por una de las CAs declaradas en `AuthOptionsMTLS.ValidationCAs`. El proceso valida la cadena del certificado contra esas CAs mediante los parámetros `ValidationCAs`, `AllowExpired` y `ChainLevelValidation`. Además, el servicio comprueba el estado de revocación en tres pasos: primero busca el cert en la base de datos local de Lamassu; si no lo encuentra, consulta los responders OCSP listados en la extensión AIA; si OCSP falla, intenta los CRL Distribution Points (CDP). Un certificado revocado interrumpe la inscripción con `certificate is revoked`.",{"_7979":1100,"_22255":926,"_18887":35276,"_5":22404,"_15195":34810,"_1578":33297},[],{"_7979":1101,"_22255":926,"_18887":35278,"_5":22404,"_15195":34810,"_1578":33300},[],{"_7979":1102,"_22255":926,"_18887":35280,"_5":22404,"_15195":34810,"_1578":32169},[],{"_7979":1103,"_22255":926,"_18887":35282,"_5":22404,"_15195":34810,"_1578":35283},[],"`ValidationCAs`",{"_7979":1104,"_22255":926,"_18887":35285,"_5":22404,"_15195":34810,"_1578":35286},[],"lista de IDs de CA",{"_7979":1105,"_22255":926,"_18887":35288,"_5":22404,"_15195":34810,"_1578":35289},[],"CAs de confianza para validar el certificado bootstrap (en enroll) o el certificado en vigor (en reenroll).",{"_7979":1106,"_22255":926,"_18887":35291,"_5":22404,"_15195":34810,"_1578":35292},[],"`AllowExpired`",{"_7979":1107,"_22255":926,"_18887":35294,"_5":22404,"_15195":34810,"_1578":20595},[],{"_7979":1108,"_22255":926,"_18887":35296,"_5":22404,"_15195":34810,"_1578":35297},[],"Si está activado, acepta certificados cliente caducados. Si es `false`, los certificados expirados se rechazan.",{"_7979":1109,"_22255":926,"_18887":35299,"_5":22404,"_15195":34810,"_1578":35300},[],"`ChainLevelValidation`",{"_7979":1110,"_22255":926,"_18887":35302,"_5":22404,"_15195":34810,"_1578":4328},[],{"_7979":1111,"_22255":926,"_18887":35304,"_5":22404,"_15195":34810,"_1578":35305},[],"Si es mayor que cero, recorta la cadena de validación al número de niveles indicado.",{"_7979":1112,"_22255":926,"_18887":35307,"_5":22404,"_15195":34810,"_1578":35308},[],"**`EXTERNAL_WEBHOOK`**: Lamassu delega la decisión de autorización en un servicio HTTP externo. El servidor EST construye una petición `POST` al webhook configurado con un cuerpo JSON que reproduce el contexto de la inscripción.",{"_7979":1113,"_22255":926,"_18887":35310,"_5":22404,"_15195":34810,"_1578":35311},[],"El valor del campo `csr` es la **codificación base64 del PEM** del CSR (no el DER, y no el PEM en claro). El webhook debe responder con `2xx` y un cuerpo JSON `{\"authorized\": true}` para continuar; cualquier otra respuesta aborta el enrolamiento con `external webhook denied enrollment`. Un `204 No Content` **no es una respuesta válida** aunque sea un código `2xx`: Lamassu exige un cuerpo JSON con el campo `authorized`, así que un webhook que responda sin cuerpo deniega la operación igual que un error.",{"_7979":1114,"_22255":926,"_18887":35313,"_5":22404,"_15195":34810,"_1578":35314},[],"**`CLIENT_CERTIFICATE_AND_EXTERNAL_WEBHOOK`**: combina los dos modos anteriores durante `/simpleenroll` — el cliente debe presentar un certificado mTLS válido y el webhook debe devolver `authorized: true`. En `/simplereenroll` la combinación no se conserva: el chequeo conjunto mTLS + webhook no se mantiene, por lo que el integrador no debe asumir que las mismas garantías del enrollment inicial aplican en reenroll.",{"_7979":1115,"_22255":926,"_18887":35316,"_5":22404,"_15195":34810,"_1578":35317},[],"**`NO_AUTH`**: el DMS acepta cualquier CSR sin validar identidad del cliente. Lamassu emite un aviso en su log (`DMS is configured with NoAuth, allowing enrollment`) y procede al alta. Debe restringirse a entornos controlados (una red de aprovisionamiento aislada); cualquier red expuesta a internet con un DMS en `NO_AUTH` queda abierta a la emisión de certificados por terceros no autorizados.",{"_7979":1116,"_22255":926,"_18887":35319,"_5":22404,"_15195":34814,"_1578":35320},[],"Las siguientes secciones describen los endpoints en el orden más habitual de uso dentro del ciclo de vida del dispositivo:",{"_7979":1117,"_22255":926,"_18887":35322,"_5":22404,"_15195":34814,"_1578":35323},[],"`/cacerts`: descarga de la cadena de confianza.",{"_7979":1118,"_22255":926,"_18887":35325,"_5":22404,"_15195":34814,"_1578":35326},[],"`/simpleenroll`: inscripción inicial del certificado.",{"_7979":1119,"_22255":926,"_18887":35328,"_5":22404,"_15195":34814,"_1578":35329},[],"`/simplereenroll`: renovación de un certificado ya emitido.",{"_7979":1120,"_22255":926,"_18887":35331,"_5":22404,"_15195":34814,"_1578":35332},[],"`/serverkeygen`: inscripción con generación de clave en servidor.",{"_7979":1121,"_22255":926,"_18887":35334,"_5":22404,"_15195":34818,"_1578":35335},[],"El endpoint `GET /.well-known/est/{aps}/cacerts` distribuye los certificados que el dispositivo necesita para validar al servidor EST y al resto de las CAs gestionadas por el DMS. Lamassu inserta los certificados en este orden: primero el certificado **downstream** del servidor Lamassu, que es la hoja TLS del servidor y no una CA, útil para pinning si `IncludeLamassuSystemCA` está activado; después la lista `ManagedCAs` declarada en el DMS; y por último la CA de enrolamiento, si `IncludeEnrollmentCA` está activado.",{"_7979":1122,"_22255":926,"_18887":35337,"_5":22404,"_15195":34818,"_1578":35338},[],"Campo de `CADistributionSettings`",{"_7979":1123,"_22255":926,"_18887":35340,"_5":22404,"_15195":34818,"_1578":33300},[],{"_7979":1124,"_22255":926,"_18887":35342,"_5":22404,"_15195":34818,"_1578":32169},[],{"_7979":1125,"_22255":926,"_18887":35344,"_5":22404,"_15195":34818,"_1578":35345},[],"`IncludeLamassuSystemCA`",{"_7979":1126,"_22255":926,"_18887":35347,"_5":22404,"_15195":34818,"_1578":20595},[],{"_7979":1127,"_22255":926,"_18887":35349,"_5":22404,"_15195":34818,"_1578":35350},[],"Incluye el certificado *downstream* del servidor Lamassu, es decir, la hoja TLS que el cliente puede usar para anclar la conexión. Es un cert de extremo, no una CA.",{"_7979":1128,"_22255":926,"_18887":35352,"_5":22404,"_15195":34818,"_1578":35353},[],"`IncludeEnrollmentCA`",{"_7979":1129,"_22255":926,"_18887":35355,"_5":22404,"_15195":34818,"_1578":20595},[],{"_7979":1130,"_22255":926,"_18887":35357,"_5":22404,"_15195":34818,"_1578":35358},[],"Incluye la CA emisora del DMS, es decir, la que firmará los certificados de dispositivo.",{"_7979":1131,"_22255":926,"_18887":35360,"_5":22404,"_15195":34818,"_1578":35361},[],"`ManagedCAs`",{"_7979":1132,"_22255":926,"_18887":35363,"_5":22404,"_15195":34818,"_1578":35286},[],{"_7979":1133,"_22255":926,"_18887":35365,"_5":22404,"_15195":34818,"_1578":35366},[],"CAs adicionales que se publican como anclas de confianza al dispositivo.",{"_7979":1134,"_22255":926,"_18887":35368,"_5":22404,"_15195":34818,"_1578":35369},[],"El formato por defecto es PKCS#7 *degenerate* (sólo certificados) codificado en base64. La respuesta declara `Content-Type: application/pkcs7-mime; smime-type=certs-only` y `Content-Transfer-Encoding: base64`. El base64 viene troceado en líneas de **76 caracteres** terminadas en CRLF, una anchura conforme con S/MIME (RFC 5751), no los 64 que sugieren ciertas guías de RFC 7030. Este troceo aplica únicamente a `/cacerts` y `/simpleenroll`; las partes internas de `/serverkeygen` no llevan wrap, como se explica más abajo.",{"_7979":1135,"_22255":926,"_18887":35371,"_5":22404,"_15195":34818,"_1578":35372},[],"El PKCS#7 *degenerate* es un **conjunto** de certificados sin orden semántico definido. Aunque Lamassu los inserta en el orden indicado, el integrador no debe asumir ese orden al validar cadenas: la cadena debe construirse por correspondencia `Subject`/`Issuer` (o por AKI/SKI), no por la posición en la respuesta.",{"_7979":1136,"_22255":926,"_18887":35374,"_5":22404,"_15195":34818,"_1578":35375},[],"El flag `-i` (ignore garbage) ayuda a tolerar el CRLF que Lamassu añade y es necesario en algunos `base64` (BusyBox, BSD); en GNU coreutils se ignora.",{"_7979":1137,"_22255":926,"_18887":35377,"_5":22404,"_15195":34818,"_1578":35378},[],"Lamassu añade además una extensión sobre el RFC: si el cliente envía la cabecera `Accept: application/x-pem-file`, el servidor responde con la concatenación PEM de los mismos certificados, sin el envoltorio PKCS#7. Esto facilita el consumo desde scripts. La extensión también funciona en `/simpleenroll` y `/simplereenroll`.",{"_7979":1138,"_22255":926,"_18887":35380,"_5":22404,"_15195":34822,"_1578":35381},[],"El endpoint `POST /.well-known/est/{aps}/simpleenroll` recibe un CSR y devuelve el certificado emitido. El cuerpo de la petición debe ser el **PKCS#10 (CSR) en DER, codificado en base64** sin saltos de línea. La base64 envuelve directamente al DER, no al PEM. La cabecera `Content-Type` debe valer `application/pkcs10`. Si el `Content-Type` es diferente, el servidor responde `400` con `content-type must be application/pkcs10`; si el cuerpo no es base64 válido, responde `400` con `body payload must be base64 encoded`.",{"_7979":1139,"_22255":926,"_18887":35383,"_5":22404,"_15195":34822,"_1578":35384},[],"La respuesta sigue el mismo envoltorio que `/cacerts`: PKCS#7 *degenerate* en base64, con `Content-Type: application/pkcs7-mime; smime-type=certs-only`. El PKCS#7 contiene **únicamente el certificado de hoja** recién emitido; no incluye la CA emisora ni intermediarios. Esto cumple RFC 7030 §4.2.3 (donde la cadena es opcional) pero implica que el integrador debe combinar este certificado con la cadena obtenida de `/cacerts` antes de presentarlo a cualquier relying party que valide cadena completa (por ejemplo, un broker MQTT con mTLS estricta).",{"_7979":1140,"_22255":926,"_18887":35386,"_5":22404,"_15195":34822,"_1578":35387},[],"Varios campos del DMS gobiernan el comportamiento de `/simpleenroll`. El integrador no los configura, pero conviene conocerlos para interpretar los rechazos.",{"_7979":1141,"_22255":926,"_18887":35389,"_5":22404,"_15195":34822,"_1578":35014},[],{"_7979":1142,"_22255":926,"_18887":35391,"_5":22404,"_15195":34822,"_1578":33300},[],{"_7979":1143,"_22255":926,"_18887":35393,"_5":22404,"_15195":34822,"_1578":35394},[],"Efecto",{"_7979":1144,"_22255":926,"_18887":35396,"_5":22404,"_15195":34822,"_1578":35397},[],"`EnrollmentSettings.RegistrationMode`",{"_7979":1145,"_22255":926,"_18887":35399,"_5":22404,"_15195":34822,"_1578":35400},[],"`JITP` / `PRE_REGISTRATION`",{"_7979":1146,"_22255":926,"_18887":35402,"_5":22404,"_15195":34822,"_1578":35403},[],"Decide si el dispositivo se crea automáticamente en la primera inscripción (`JITP`) o si debe existir previamente (`PRE_REGISTRATION`).",{"_7979":1147,"_22255":926,"_18887":35405,"_5":22404,"_15195":34822,"_1578":35406},[],"`EnrollmentSettings.EnableReplaceableEnrollment`",{"_7979":1148,"_22255":926,"_18887":35408,"_5":22404,"_15195":34822,"_1578":20595},[],{"_7979":1149,"_22255":926,"_18887":35410,"_5":22404,"_15195":34822,"_1578":35411},[],"Si es `true`, un dispositivo ya enrolado puede volver a inscribirse mediante `/simpleenroll`; el certificado anterior se revoca con razón `superseded`. Si es `false`, el segundo intento se rechaza con `forbiddenNewEnrollment`.",{"_7979":1150,"_22255":926,"_18887":35413,"_5":22404,"_15195":34822,"_1578":35414},[],"`EnrollmentSettings.VerifyCSRSignature`",{"_7979":1151,"_22255":926,"_18887":35416,"_5":22404,"_15195":34822,"_1578":20595},[],{"_7979":1152,"_22255":926,"_18887":35418,"_5":22404,"_15195":34822,"_1578":35419},[],"Si es `true`, el servidor valida la firma del CSR contra la clave pública declarada en él (proof-of-possession estándar de PKCS#10/RFC 2986). Si es `false`, se omite la prueba de posesión. Para flotas IoT en redes abiertas debe estar en `true`.",{"_7979":1153,"_22255":926,"_18887":35421,"_5":22404,"_15195":34822,"_1578":35422},[],"En modo `JITP`, el primer `simpleenroll` con un `CommonName` que aún no existe en Lamassu crea el dispositivo automáticamente. En modo `PRE_REGISTRATION`, el dispositivo debe existir previamente; un `CommonName` desconocido se rechaza con `device not preregistered`. Consulte Configuración de enrollment para más detalles sobre ambos modos y el comportamiento del perfil de emisión.",{"_7979":1154,"_22255":926,"_18887":35424,"_5":22404,"_15195":34826,"_1578":35425},[],"El endpoint `POST /.well-known/est/{aps}/simplereenroll` renueva el certificado de un dispositivo ya enrolado. El formato del cuerpo es idéntico al de `/simpleenroll` (DER base64 sin saltos, `Content-Type: application/pkcs10`). La diferencia está en la autenticación: el cliente debe presentar **el certificado en vigor** del dispositivo (no el bootstrap) como credencial mTLS.",{"_7979":1155,"_22255":926,"_18887":35427,"_5":22404,"_15195":34826,"_1578":35428},[],"Si el DMS está configurado con `AuthMode: EXTERNAL_WEBHOOK`, el webhook **no se invoca** durante `/simplereenroll`. El flujo de renovación degrada silenciosamente a `NO_AUTH`: cualquier cliente que conozca un `CommonName` válido puede solicitar reenroll para ese dispositivo sin autenticación (`allowing reenroll: using NO AUTH mode` en el log). Un DMS con `EXTERNAL_WEBHOOK` no debe usarse en producción para flujos de reenroll a menos que se controle la red de acceso al endpoint.",{"_7979":1156,"_22255":926,"_18887":35430,"_5":22404,"_15195":34826,"_1578":35431},[],"El comportamiento del reenroll está condicionado por varios campos de `ReEnrollmentSettings`:",{"_7979":1157,"_22255":926,"_18887":35433,"_5":22404,"_15195":34826,"_1578":35014},[],{"_7979":1158,"_22255":926,"_18887":35435,"_5":22404,"_15195":34826,"_1578":33300},[],{"_7979":1159,"_22255":926,"_18887":35437,"_5":22404,"_15195":34826,"_1578":35394},[],{"_7979":1160,"_22255":926,"_18887":35439,"_5":22404,"_15195":34826,"_1578":35440},[],"`ReEnrollmentDelta`",{"_7979":1161,"_22255":926,"_18887":35442,"_5":22404,"_15195":34826,"_1578":35443},[],"duración",{"_7979":1162,"_22255":926,"_18887":35445,"_5":22404,"_15195":34826,"_1578":35446},[],"Define la ventana de renovación: el cliente solo puede renovar a partir de `NotAfter - ReEnrollmentDelta`. Antes de ese instante, el servidor responde con `invalid reenroll window`.",{"_7979":1163,"_22255":926,"_18887":35448,"_5":22404,"_15195":34826,"_1578":35449},[],"`EnableExpiredRenewal`",{"_7979":1164,"_22255":926,"_18887":35451,"_5":22404,"_15195":34826,"_1578":20595},[],{"_7979":1165,"_22255":926,"_18887":35453,"_5":22404,"_15195":34826,"_1578":35454},[],"Si es `true`, acepta certificados ya caducados como prueba de identidad. Si es `false`, un certificado expirado provoca `expired certificate`.",{"_7979":1166,"_22255":926,"_18887":35456,"_5":22404,"_15195":34826,"_1578":35457},[],"`RevokeOnReEnrollment`",{"_7979":1167,"_22255":926,"_18887":35459,"_5":22404,"_15195":34826,"_1578":20595},[],{"_7979":1168,"_22255":926,"_18887":35461,"_5":22404,"_15195":34826,"_1578":35462},[],"Si es `true`, revoca automáticamente el certificado anterior tras emitir el nuevo, con la razón `superseded` (código 4 de RFC 5280).",{"_7979":1169,"_22255":926,"_18887":35464,"_5":22404,"_15195":34826,"_1578":35465},[],"`AdditionalValidationCAs`",{"_7979":1170,"_22255":926,"_18887":35467,"_5":22404,"_15195":34826,"_1578":35286},[],{"_7979":1171,"_22255":926,"_18887":35469,"_5":22404,"_15195":34826,"_1578":35470},[],"CAs adicionales que el servidor admite como emisores válidos del certificado en vigor, además de la CA de enrolamiento del DMS.",{"_7979":1172,"_22255":926,"_18887":35472,"_5":22404,"_15195":34826,"_1578":35473},[],"**Inmutabilidad del subject**: el CSR de renovación debe tener exactamente el mismo subject que el certificado en vigor. Lamassu compara, byte a byte, el `RawSubject` del CSR con el del certificado (`slices.Compare`). Si los bytes difieren, el servidor cae a una comparación semántica de respaldo sobre los atributos `CommonName`, `OrganizationalUnit`, `Organization`, `Locality`, `Province` y `Country`. Si todos esos atributos coinciden, el reenroll continúa pese a la diferencia de bytes (rescata casos donde solo cambia la codificación, `PrintableString` frente a `UTF8String`). Si algún atributo difiere, el reenroll se aborta con `invalid RawSubject bytes`. El integrador debe regenerar el CSR con exactamente el mismo subject que en la inscripción inicial para no depender del comportamiento de fallback.",{"_7979":1173,"_22255":926,"_18887":35475,"_5":22404,"_15195":34826,"_1578":35476},[],"**Validación de la cadena del certificado presentado**: la validación se intenta primero contra la CA de enrolamiento del DMS; si falla, recorre las `AdditionalValidationCAs`. La validación es \"shallow\": cada CA se prueba como ancla, no se compone una cadena multinivel. El cliente debe presentar la cadena completa en el handshake mTLS. Un certificado revocado aborta el reenroll con `certificate is revoked`.",{"_7979":1174,"_22255":926,"_18887":35478,"_5":22404,"_15195":34830,"_1578":35479},[],"El endpoint `POST /.well-known/est/{aps}/serverkeygen` permite que Lamassu genere el par de claves del dispositivo en el servidor y devuelva, en la misma respuesta, la clave privada y el certificado emitido. Es útil para dispositivos con capacidad criptográfica limitada o flujos donde la clave se aprovisiona durante la fabricación.",{"_7979":1175,"_22255":926,"_18887":35481,"_5":22404,"_15195":34830,"_1578":35482},[],"Este endpoint requiere que `ServerKeyGen.Enabled` valga `true` en el DMS. Si no está activado, el servidor responde con `server key generation not enabled`. La autenticación se aplica igual que en `/simpleenroll`: el integrador presenta la credencial que corresponda al `AuthMode` del DMS.",{"_7979":1176,"_22255":926,"_18887":35484,"_5":22404,"_15195":34830,"_1578":35485},[],"El algoritmo y el tamaño de la clave generada se deciden por el DMS, no por el cliente.",{"_7979":1177,"_22255":926,"_18887":35487,"_5":22404,"_15195":34830,"_1578":35488},[],"Tipo de clave",{"_7979":1178,"_22255":926,"_18887":35490,"_5":22404,"_15195":34830,"_1578":35491},[],"Parámetro válido",{"_7979":1179,"_22255":926,"_18887":35493,"_5":22404,"_15195":34830,"_1578":35494},[],"Curva NIST equivalente",{"_7979":1180,"_22255":926,"_18887":35496,"_5":22404,"_15195":34830,"_1578":35497},[],"Comportamiento ante valores no válidos",{"_7979":1181,"_22255":926,"_18887":35499,"_5":22404,"_15195":34830,"_1578":35500},[],"`RSA`",{"_7979":1182,"_22255":926,"_18887":35502,"_5":22404,"_15195":34830,"_1578":35503},[],"Cualquier número de bits aceptado por `crypto/rsa` (típico: 2048, 3072, 4096)",{"_7979":1183,"_22255":926,"_18887":35505,"_5":22404,"_15195":34830,"_1578":35506},[],"No aplica",{"_7979":1184,"_22255":926,"_18887":35508,"_5":22404,"_15195":34830,"_1578":35509},[],"Si el valor no es válido para RSA, la generación falla y devuelve `500`.",{"_7979":1185,"_22255":926,"_18887":35511,"_5":22404,"_15195":34830,"_1578":35512},[],"`ECDSA`",{"_7979":1186,"_22255":926,"_18887":35514,"_5":22404,"_15195":34830,"_1578":35515},[],"224, 256, 384, 521",{"_7979":1187,"_22255":926,"_18887":35517,"_5":22404,"_15195":34830,"_1578":35518},[],"P-224 / P-256 (prime256v1) / P-384 / P-521",{"_7979":1188,"_22255":926,"_18887":35520,"_5":22404,"_15195":34830,"_1578":35521},[],"Cualquier otro valor degrada **silenciosamente** a P-256, solo con un aviso en log (`invalid key size of N for ECDSA. Defaulting to 256 curve`). El cliente no recibe error: el certificado se emite con una curva distinta de la solicitada.",{"_7979":1189,"_22255":926,"_18887":35523,"_5":22404,"_15195":34830,"_1578":35524},[],"El CSR enviado por el cliente sirve únicamente para transportar el subject y las extensiones; la prueba de posesión PKCS#10 no aplica aquí porque el cliente no es quien generó la clave. Lamassu descarta la clave pública del CSR original, genera un par de claves nuevo con su entropía interna, en motor software y no en un Crypto Engine de hardware como AWS KMS o PKCS#11, construye un CSR nuevo con esa clave y procede a una inscripción interna equivalente a `/simpleenroll`.",{"_7979":1190,"_22255":926,"_18887":35526,"_5":22404,"_15195":34830,"_1578":35527},[],"La respuesta es un `multipart/mixed` con el boundary literal `estServerLamassuBoundary`. Contiene dos partes:",{"_7979":1191,"_22255":926,"_18887":35529,"_5":22404,"_15195":34830,"_1578":35530},[],"La clave privada en formato **PKCS#8 sin cifrar**, codificada en base64 dentro de una parte con `Content-Type: application/pkcs8`.",{"_7979":1192,"_22255":926,"_18887":35532,"_5":22404,"_15195":34830,"_1578":35533},[],"El certificado emitido en PKCS#7 *degenerate* base64, dentro de una parte con `Content-Type: application/pkcs7-mime; smime-type=certs-only`.",{"_7979":1193,"_22255":926,"_18887":35535,"_5":22404,"_15195":34830,"_1578":35536},[],"A diferencia de `/cacerts` y `/simpleenroll`, donde el base64 va troceado en líneas de 76 caracteres, cada parte de `/serverkeygen` viaja como **una única línea base64 sin saltos**. Cualquier proxy inverso que reescriba el cuerpo (por ejemplo, normalizando line endings) puede romper el parseo.",{"_7979":1194,"_22255":926,"_18887":35538,"_5":22404,"_15195":34830,"_1578":35539},[],"Este endpoint invierte el principio PKI por el que el subscriber controla su clave privada. La clave se serializa en PKCS#8 sin cifrar (`PrivateKeyInfo`, sin `EncryptedPrivateKeyInfo`). No se aplica el envoltorio CMS `EnvelopedData` contemplado en RFC 7030 §4.4.2; no se aplica AES key wrap ni cifrado simétrico por contraseña. La única protección es el TLS del canal. El integrador debe garantizar que: (a) ningún proxy inverso termine TLS y registre el cuerpo de la respuesta; (b) la clave se cifre en reposo inmediatamente tras recibirla; (c) la cuenta de auditoría en el servidor Lamassu queda como punto único de origen de la clave.",{"_7979":1195,"_22255":926,"_18887":35541,"_5":22404,"_15195":34830,"_1578":35542},[],"Para separar las dos partes, el siguiente fragmento usa `awk` con el boundary literal. Funciona con la estructura exacta de Lamassu (cada parte = headers + línea en blanco + una sola línea base64); cualquier proxy intermedio que reescriba el cuerpo lo romperá.",{"_7979":1196,"_22255":926,"_18887":35544,"_5":22404,"_15195":34834,"_1578":35545},[],"Una vez revisados los endpoints por separado, estos ejemplos muestran cómo encadenarlos en dos escenarios habituales: el alta inicial de un dispositivo y la renovación de un certificado ya emitido.",{"_7979":1197,"_22255":926,"_18887":35547,"_5":22404,"_15195":34838,"_1578":35548},[],"El siguiente script ilustra el proceso completo de inscripción de un dispositivo con clave EC P-256 generada localmente y autenticación mTLS contra un certificado bootstrap.",{"_7979":1198,"_22255":926,"_18887":35550,"_5":22404,"_15195":34842,"_1578":35551},[],"El siguiente script reproduce un proceso de renovación: detecta la expiración del certificado actual, regenera el CSR con el **mismo subject** y se autentica con el certificado en vigor.",{"_7979":1199,"_22255":926,"_18887":35553,"_5":22404,"_15195":34846,"_1578":35554},[],"Una vez que el dispositivo ha obtenido su certificado de identidad, los pasos habituales son:",{"_7979":1200,"_22255":926,"_18887":35556,"_5":22404,"_15195":34846,"_1578":35557},[],"**Instalar la cadena de confianza** (`cacerts.pem`) en el almacén de confianza del dispositivo. El broker MQTT, el servidor HTTPS o cualquier relying party que valide mTLS necesitará esta cadena.",{"_7979":1201,"_22255":926,"_18887":35559,"_5":22404,"_15195":34846,"_1578":35560},[],"**Combinar el certificado de hoja con la cadena** antes de presentarlo en conexiones mTLS. La respuesta de `/simpleenroll` contiene solo el certificado de hoja; el relying party puede rechazar la conexión si no recibe la cadena completa.",{"_7979":1202,"_22255":926,"_18887":35562,"_5":22404,"_15195":34846,"_1578":35563},[],"**Planificar la renovación**: configurar en el dispositivo un temporizador que invoque `/simplereenroll` dentro de la ventana `ReEnrollmentDelta` antes de la caducidad del certificado. No espere a que caduque salvo que `EnableExpiredRenewal` esté activo.",{"_7979":1203,"_22255":926,"_18887":35565,"_5":22404,"_15195":34854,"_1578":35566},[],"Lamassu mapea casi todos los errores de negocio a `500 Internal Server Error`, no a `4xx`. El código de estado HTTP no es suficiente para distinguir entre un error de red y un error de política. El integrador debe inspeccionar el campo `err` del cuerpo JSON (`{\"err\": \"<mensaje>\"}`) para determinar la causa exacta del fallo.",{"_7979":1204,"_22255":926,"_18887":35568,"_5":22404,"_15195":34854,"_1578":35569},[],"HTTP",{"_7979":1205,"_22255":926,"_18887":35571,"_5":22404,"_15195":34854,"_1578":35572},[],"Mensaje",{"_7979":1206,"_22255":926,"_18887":35574,"_5":22404,"_15195":34854,"_1578":35575},[],"Causa",{"_7979":1207,"_22255":926,"_18887":35577,"_5":22404,"_15195":34854,"_1578":35578},[],"Acción del integrador",{"_7979":1208,"_22255":926,"_18887":35580,"_5":22404,"_15195":34854,"_1578":19706},[],{"_7979":1209,"_22255":926,"_18887":35582,"_5":22404,"_15195":34854,"_1578":35583},[],"`Field validation for 'APS' failed`",{"_7979":1210,"_22255":926,"_18887":35585,"_5":22404,"_15195":34854,"_1578":35586},[],"El segmento `{aps}` falta en la URL.",{"_7979":1211,"_22255":926,"_18887":35588,"_5":22404,"_15195":34854,"_1578":35589},[],"Incluir el ID del DMS en la ruta.",{"_7979":1212,"_22255":926,"_18887":35591,"_5":22404,"_15195":34854,"_1578":19706},[],{"_7979":1213,"_22255":926,"_18887":35593,"_5":22404,"_15195":34854,"_1578":35594},[],"`content-type must be application/pkcs10`",{"_7979":1214,"_22255":926,"_18887":35596,"_5":22404,"_15195":34854,"_1578":35597},[],"Cabecera `Content-Type` ausente o incorrecta.",{"_7979":1215,"_22255":926,"_18887":35599,"_5":22404,"_15195":34854,"_1578":35600},[],"Fijar `Content-Type: application/pkcs10`.",{"_7979":1216,"_22255":926,"_18887":35602,"_5":22404,"_15195":34854,"_1578":19706},[],{"_7979":1217,"_22255":926,"_18887":35604,"_5":22404,"_15195":34854,"_1578":35605},[],"`body payload must be base64 encoded`",{"_7979":1218,"_22255":926,"_18887":35607,"_5":22404,"_15195":34854,"_1578":35608},[],"El cuerpo no es base64 válido.",{"_7979":1219,"_22255":926,"_18887":35610,"_5":22404,"_15195":34854,"_1578":35611},[],"Usar `base64 -w 0` para evitar saltos de línea.",{"_7979":1220,"_22255":926,"_18887":35613,"_5":22404,"_15195":34854,"_1578":20231},[],{"_7979":1221,"_22255":926,"_18887":35615,"_5":22404,"_15195":34854,"_1578":35616},[],"`DMS not found`",{"_7979":1222,"_22255":926,"_18887":35618,"_5":22404,"_15195":34854,"_1578":35619},[],"El valor `{aps}` no se corresponde con ningún DMS.",{"_7979":1223,"_22255":926,"_18887":35621,"_5":22404,"_15195":34854,"_1578":35622},[],"Verificar el identificador con el administrador PKI.",{"_7979":1224,"_22255":926,"_18887":35624,"_5":22404,"_15195":34854,"_1578":20231},[],{"_7979":1225,"_22255":926,"_18887":35626,"_5":22404,"_15195":34854,"_1578":35627},[],"`invalid certificate`",{"_7979":1226,"_22255":926,"_18887":35629,"_5":22404,"_15195":34854,"_1578":35630},[],"El certificado cliente no es válido contra `ValidationCAs`.",{"_7979":1227,"_22255":926,"_18887":35632,"_5":22404,"_15195":34854,"_1578":35633},[],"Comprobar la cadena del certificado bootstrap.",{"_7979":1228,"_22255":926,"_18887":35635,"_5":22404,"_15195":34854,"_1578":20231},[],{"_7979":1229,"_22255":926,"_18887":35637,"_5":22404,"_15195":34854,"_1578":35638},[],"`certificate is revoked`",{"_7979":1230,"_22255":926,"_18887":35640,"_5":22404,"_15195":34854,"_1578":35641},[],"El certificado **presentado como credencial mTLS** está revocado en Lamassu o vía OCSP/CRL externos.",{"_7979":1231,"_22255":926,"_18887":35643,"_5":22404,"_15195":34854,"_1578":35644},[],"Solicitar un nuevo certificado bootstrap o investigar la revocación.",{"_7979":1232,"_22255":926,"_18887":35646,"_5":22404,"_15195":34854,"_1578":20231},[],{"_7979":1233,"_22255":926,"_18887":35648,"_5":22404,"_15195":34854,"_1578":35649},[],"`revoked certificate`",{"_7979":1234,"_22255":926,"_18887":35651,"_5":22404,"_15195":34854,"_1578":35652},[],"En reenroll, el certificado **activo del dispositivo en la base de datos** figura como revocado.",{"_7979":1235,"_22255":926,"_18887":35654,"_5":22404,"_15195":34854,"_1578":35655},[],"Revisar el estado del slot de identidad; si la revocación fue intencional, emitir un nuevo enroll en lugar de reenroll.",{"_7979":1236,"_22255":926,"_18887":35657,"_5":22404,"_15195":34854,"_1578":20231},[],{"_7979":1237,"_22255":926,"_18887":35659,"_5":22404,"_15195":34854,"_1578":35660},[],"`expired certificate`",{"_7979":1238,"_22255":926,"_18887":35662,"_5":22404,"_15195":34854,"_1578":35663},[],"El certificado presentado ha caducado y el DMS no permite `AllowExpired`/`EnableExpiredRenewal`.",{"_7979":1239,"_22255":926,"_18887":35665,"_5":22404,"_15195":34854,"_1578":35666},[],"Renovar antes de la caducidad o solicitar habilitar `EnableExpiredRenewal`.",{"_7979":1240,"_22255":926,"_18887":35668,"_5":22404,"_15195":34854,"_1578":20231},[],{"_7979":1241,"_22255":926,"_18887":35670,"_5":22404,"_15195":34854,"_1578":35671},[],"`forbiddenNewEnrollment`",{"_7979":1242,"_22255":926,"_18887":35673,"_5":22404,"_15195":34854,"_1578":35674},[],"El dispositivo ya está enrolado y `EnableReplaceableEnrollment` es `false`.",{"_7979":1243,"_22255":926,"_18887":35676,"_5":22404,"_15195":34854,"_1578":35677},[],"Usar `/simplereenroll` o pedir al administrador que habilite el flag.",{"_7979":1244,"_22255":926,"_18887":35679,"_5":22404,"_15195":34854,"_1578":20231},[],{"_7979":1245,"_22255":926,"_18887":35681,"_5":22404,"_15195":34854,"_1578":35682},[],"`device not preregistered`",{"_7979":1246,"_22255":926,"_18887":35684,"_5":22404,"_15195":34854,"_1578":35685},[],"El DMS está en `PRE_REGISTRATION` y el dispositivo no existe.",{"_7979":1247,"_22255":926,"_18887":35687,"_5":22404,"_15195":34854,"_1578":35688},[],"Registrar el dispositivo antes de inscribirlo.",{"_7979":1248,"_22255":926,"_18887":35690,"_5":22404,"_15195":34854,"_1578":20231},[],{"_7979":1249,"_22255":926,"_18887":35692,"_5":22404,"_15195":34854,"_1578":35693},[],"`invalid reenroll window`",{"_7979":1250,"_22255":926,"_18887":35695,"_5":22404,"_15195":34854,"_1578":35696},[],"Se intenta renovar antes de `NotAfter - ReEnrollmentDelta`.",{"_7979":1251,"_22255":926,"_18887":35698,"_5":22404,"_15195":34854,"_1578":35699},[],"Esperar a la apertura de la ventana o pedir un `ReEnrollmentDelta` mayor.",{"_7979":1252,"_22255":926,"_18887":35701,"_5":22404,"_15195":34854,"_1578":20231},[],{"_7979":1253,"_22255":926,"_18887":35703,"_5":22404,"_15195":34854,"_1578":35704},[],"`invalid RawSubject bytes`",{"_7979":1254,"_22255":926,"_18887":35706,"_5":22404,"_15195":34854,"_1578":35707},[],"El subject del CSR de renovación no coincide con el del certificado en vigor.",{"_7979":1255,"_22255":926,"_18887":35709,"_5":22404,"_15195":34854,"_1578":35710},[],"Regenerar el CSR con el subject exacto del cert anterior.",{"_7979":1256,"_22255":926,"_18887":35712,"_5":22404,"_15195":34854,"_1578":20231},[],{"_7979":1257,"_22255":926,"_18887":35714,"_5":22404,"_15195":34854,"_1578":35715},[],"`external webhook denied enrollment`",{"_7979":1258,"_22255":926,"_18887":35717,"_5":22404,"_15195":34854,"_1578":35718},[],"El webhook devolvió un código no `2xx` o `authorized != true`.",{"_7979":1259,"_22255":926,"_18887":35720,"_5":22404,"_15195":34854,"_1578":35721},[],"Revisar los logs del servicio webhook.",{"_7979":1260,"_22255":926,"_18887":35723,"_5":22404,"_15195":34854,"_1578":20231},[],{"_7979":1261,"_22255":926,"_18887":35725,"_5":22404,"_15195":34854,"_1578":35726},[],"`server key generation not enabled`",{"_7979":1262,"_22255":926,"_18887":35728,"_5":22404,"_15195":34854,"_1578":35729},[],"`/serverkeygen` está deshabilitado en el DMS.",{"_7979":1263,"_22255":926,"_18887":35731,"_5":22404,"_15195":34854,"_1578":35732},[],"Pedir al administrador activar `ServerKeyGen.Enabled`.",{"_7979":1264,"_22255":926,"_18887":35734,"_5":22404,"_15195":34854,"_1578":35735},[],"Para los mensajes que no figuren en esta tabla, los logs del servidor Lamassu (con los campos `func`, `dms`, `device-cn`, `step`, `auth-method`, `auth-status`) son el primer lugar donde buscar la causa.",{"_7979":1265,"_22255":926,"_18887":35737,"_5":22404,"_15195":34858,"_1578":35738},[],"La implementación de Lamassu se ajusta al RFC 7030 en lo esencial pero introduce varias particularidades que pueden afectar a clientes EST estrictos o a librerías de terceros:",{"_7979":1266,"_22255":926,"_18887":35740,"_5":22404,"_15195":34858,"_1578":35741},[],"Los endpoints `/csrattrs` y `/fullcmc` del RFC 7030 **no están implementados** en Lamassu. Un cliente que invoque `/.well-known/est/<DMS_ID>/csrattrs` recibirá `404 Not Found` en lugar del `204 No Content` que el RFC sugiere para \"sin atributos\". Las librerías EST estrictas deben configurarse para no intentar `csrattrs`.",{"_7979":1267,"_22255":926,"_18887":35743,"_5":22404,"_15195":34858,"_1578":35744},[],"El base64 de la respuesta de `/cacerts` y `/simpleenroll` se trocea en líneas de **76 caracteres** terminadas con CRLF (conforme con S/MIME, RFC 5751). Las partes de `/serverkeygen` no aplican wrap.",{"_7979":1268,"_22255":926,"_18887":35746,"_5":22404,"_15195":34858,"_1578":35747},[],"El boundary del `multipart/mixed` en `/serverkeygen` está fijado y no se puede negociar.",{"_7979":1269,"_22255":926,"_18887":35749,"_5":22404,"_15195":34858,"_1578":35750},[],"El segmento `{aps}` es **obligatorio** en todas las rutas EST. Las rutas registradas sin `{aps}` están en el código pero responden `400`.",{"_7979":1270,"_22255":926,"_18887":35752,"_5":22404,"_15195":34858,"_1578":35753},[],"El cuerpo de `/cacerts`, `/simpleenroll` y `/simplereenroll` puede devolverse como PEM concatenado si el cliente envía `Accept: application/x-pem-file`. Esta es una extensión específica de Lamassu y no aparece en el RFC.",{"_7979":1271,"_22255":926,"_18887":35755,"_5":22404,"_15195":34858,"_1578":35756},[],"El servidor no rechaza explícitamente CSRs firmados con SHA-1 o MD5; el integrador debe generar el CSR con SHA-256 o superior.",{"_7979":1272,"_22255":926,"_18887":35758,"_5":22404,"_15195":34858,"_1578":35759},[],"<Card title=\"Visión general del DMS\" href=\"/docs/manual/servicios-core/ra\" />",{"_7979":1273,"_22255":926,"_18887":35761,"_5":22404,"_15195":34858,"_1578":35762},[],"<Card title=\"Validación OCSP\" href=\"/docs/manual/servicios-core/validation-ocsp\" />",{"_7979":1274,"_22255":926,"_18887":35764,"_5":22404,"_15195":34858,"_1578":35765},[],"<Card title=\"Gestionar dispositivos\" href=\"/docs/manual/servicios-core/devices\" />",{"_7979":1275,"_22255":1275,"_5":22399,"_1578":35767,"_22412":35768,"_18887":35769,"_15195":1275},"[KMS] Gestión de Claves Criptográficas",[31966,33065,33074],[],{"_7979":1276,"_22255":1275,"_18887":35771,"_5":22404,"_15195":1275,"_1578":35772},[],"Gestión y operación de claves criptográficas en Lamassu IoT",{"_7979":1277,"_22255":1275,"_5":22409,"_18887":35774,"_15195":35775,"_1578":35776},[],"/docs/pr-preview/pr-23/manual/servicios-core/kms#gestión-de-claves-criptográficas","Gestión de claves criptográficas",{"_7979":1278,"_22255":1275,"_5":22409,"_18887":35778,"_15195":35779,"_1578":35780},[],"/docs/pr-preview/pr-23/manual/servicios-core/kms#qué-resuelve-el-kms","Qué resuelve el KMS",{"_7979":1279,"_22255":1275,"_5":22409,"_18887":35782,"_15195":35783,"_1578":35784},[],"/docs/pr-preview/pr-23/manual/servicios-core/kms#motores-criptográficos","Motores criptográficos",{"_7979":1280,"_22255":1275,"_5":22409,"_18887":35786,"_15195":35787,"_1578":35788},[],"/docs/pr-preview/pr-23/manual/servicios-core/kms#claves-compartidas-entre-varios-motores","Claves compartidas entre varios motores",{"_7979":1281,"_22255":1275,"_5":22409,"_18887":35790,"_15195":35791,"_1578":35792},[],"/docs/pr-preview/pr-23/manual/servicios-core/kms#inventario-de-claves","Inventario de claves",{"_7979":1282,"_22255":1275,"_5":22409,"_18887":35794,"_15195":35795,"_1578":35796},[],"/docs/pr-preview/pr-23/manual/servicios-core/kms#crear-o-importar-claves","Crear o importar claves",{"_7979":1283,"_22255":1275,"_5":22409,"_18887":35798,"_15195":35799,"_1578":35800},[],"/docs/pr-preview/pr-23/manual/servicios-core/kms#generar-un-nuevo-par-de-claves","Generar un nuevo par de claves",{"_7979":1284,"_22255":1275,"_5":22409,"_18887":35802,"_15195":35803,"_1578":35804},[],"/docs/pr-preview/pr-23/manual/servicios-core/kms#importar-un-par-existente","Importar un par existente",{"_7979":1285,"_22255":1275,"_5":22409,"_18887":35806,"_15195":35807,"_1578":35808},[],"/docs/pr-preview/pr-23/manual/servicios-core/kms#operaciones-sobre-una-clave","Operaciones sobre una clave",{"_7979":1286,"_22255":1275,"_5":22409,"_18887":35810,"_15195":35811,"_1578":35812},[],"/docs/pr-preview/pr-23/manual/servicios-core/kms#ver-detalles","Ver detalles",{"_7979":1287,"_22255":1275,"_5":22409,"_18887":35814,"_15195":35815,"_1578":35816},[],"/docs/pr-preview/pr-23/manual/servicios-core/kms#firmar-y-verificar","Firmar y verificar",{"_7979":1288,"_22255":1275,"_5":22409,"_18887":35818,"_15195":35819,"_1578":35820},[],"/docs/pr-preview/pr-23/manual/servicios-core/kms#sign","Sign",{"_7979":1289,"_22255":1275,"_5":22409,"_18887":35822,"_15195":35823,"_1578":35824},[],"/docs/pr-preview/pr-23/manual/servicios-core/kms#verify","Verify",{"_7979":1290,"_22255":1275,"_5":22409,"_18887":35826,"_15195":35827,"_1578":35828},[],"/docs/pr-preview/pr-23/manual/servicios-core/kms#generar-un-csr","Generar un CSR",{"_7979":1291,"_22255":1275,"_5":22409,"_18887":35830,"_15195":35831,"_1578":35832},[],"/docs/pr-preview/pr-23/manual/servicios-core/kms#firma-local-con-pkcs11","Firma local con PKCS#11",{"_7979":1292,"_22255":1275,"_18887":35834,"_5":22404,"_15195":35775,"_1578":35835},[],"El servicio de Gestión de Claves Criptográficas (KMS) de Lamassu IoT centraliza la generación, importación, custodia y uso de las claves de la plataforma. Desde aquí se gestionan las claves que soportan a las CAs y al resto de operaciones de firma que dependen de la PKI.",{"_7979":1293,"_22255":1275,"_18887":35837,"_5":22404,"_15195":35775,"_1578":35838},[],"En la configuración actual, Lamassu IoT trabaja exclusivamente con claves asimétricas, como RSA y curvas elípticas. Estas claves se usan para emitir certificados X.509, firmar solicitudes y realizar operaciones de autenticación y validación dentro del sistema.",{"_7979":1294,"_22255":1275,"_18887":35840,"_5":22404,"_15195":35779,"_1578":35841},[],"El KMS unifica la gestión del ciclo de vida de las claves y evita que cada servicio tenga que integrarse directamente con un proveedor criptográfico concreto.",{"_7979":1295,"_22255":1275,"_18887":35843,"_5":22404,"_15195":35779,"_1578":35844},[],"En la práctica, permite:",{"_7979":1296,"_22255":1275,"_18887":35846,"_5":22404,"_15195":35779,"_1578":35847},[],"Generar nuevos pares de claves desde Lamassu IoT.",{"_7979":1297,"_22255":1275,"_18887":35849,"_5":22404,"_15195":35779,"_1578":35850},[],"Importar claves creadas externamente.",{"_7979":1298,"_22255":1275,"_18887":35852,"_5":22404,"_15195":35779,"_1578":35853},[],"Delegar la custodia y las operaciones criptográficas en motores externos.",{"_7979":1299,"_22255":1275,"_18887":35855,"_5":22404,"_15195":35779,"_1578":35856},[],"Reutilizar claves ya existentes para CAs, CSR y tareas de firma o verificación.",{"_7979":1300,"_22255":1275,"_18887":35858,"_5":22404,"_15195":35783,"_1578":35859},[],"Lamassu puede trabajar con distintos motores criptográficos según los requisitos del despliegue. En algunos entornos bastará con un motor software; en otros será necesario delegar la custodia en un HSM, en un servicio cloud o en una plataforma especializada.",{"_7979":1301,"_22255":1275,"_18887":35861,"_5":22404,"_15195":35783,"_1578":35862},[],"Una misma instancia puede tener varios motores configurados al mismo tiempo, incluso varias instancias del mismo tipo. Esto permite adaptar la operación a distintos niveles de seguridad, coste y requisitos regulatorios.",{"_7979":1302,"_22255":1275,"_18887":35864,"_5":22404,"_15195":35783,"_1578":35865},[],"Actualmente, Lamassu soporta los siguientes motores:",{"_7979":1303,"_22255":1275,"_18887":35867,"_5":22404,"_15195":35783,"_1578":35868},[],"Crypto Engine",{"_7979":1304,"_22255":1275,"_18887":35870,"_5":22404,"_15195":35783,"_1578":35871},[],"Nivel de seguridad",{"_7979":1305,"_22255":1275,"_18887":35873,"_5":22404,"_15195":35783,"_1578":35874},[],"OnPrem / Cloud",{"_7979":1306,"_22255":1275,"_18887":35876,"_5":22404,"_15195":35783,"_1578":35877},[],"Coste adicional",{"_7979":1307,"_22255":1275,"_18887":35879,"_5":22404,"_15195":35783,"_1578":35880},[],"Generación de claves",{"_7979":1308,"_22255":1275,"_18887":35882,"_5":22404,"_15195":35783,"_1578":35883},[],"Persistencia *at-rest* segura",{"_7979":1309,"_22255":1275,"_18887":35885,"_5":22404,"_15195":35783,"_1578":35886},[],"Filtración de claves",{"_7979":1310,"_22255":1275,"_18887":35888,"_5":22404,"_15195":35783,"_1578":35889},[],"Consideraciones",{"_7979":1311,"_22255":1275,"_18887":35891,"_5":22404,"_15195":35783,"_1578":35892},[],"File System",{"_7979":1312,"_22255":1275,"_18887":35894,"_5":22404,"_15195":35783,"_1578":11307},[],{"_7979":1313,"_22255":1275,"_18887":35896,"_5":22404,"_15195":35783,"_1578":35897},[],"OnPrem y Cloud",{"_7979":1314,"_22255":1275,"_18887":35899,"_5":22404,"_15195":35783,"_1578":33365},[],{"_7979":1315,"_22255":1275,"_18887":35901,"_5":22404,"_15195":35783,"_1578":35902},[],"**Entropía software**. La generación se realiza con las librerías criptográficas de Go.",{"_7979":1316,"_22255":1275,"_18887":35904,"_5":22404,"_15195":35783,"_1578":35905},[],"**Insegura**. Delegada en el sistema de archivos.",{"_7979":1317,"_22255":1275,"_18887":35907,"_5":22404,"_15195":35783,"_1578":35905},[],{"_7979":1318,"_22255":1275,"_18887":35909,"_5":22404,"_15195":35783,"_1578":35910},[],"No recomendado para producción.",{"_7979":1319,"_22255":1275,"_18887":35912,"_5":22404,"_15195":35783,"_1578":35913},[],"HashiCorp Vault",{"_7979":1320,"_22255":1275,"_18887":35915,"_5":22404,"_15195":35783,"_1578":4039},[],{"_7979":1321,"_22255":1275,"_18887":35917,"_5":22404,"_15195":35783,"_1578":35897},[],{"_7979":1322,"_22255":1275,"_18887":35919,"_5":22404,"_15195":35783,"_1578":33365},[],{"_7979":1323,"_22255":1275,"_18887":35921,"_5":22404,"_15195":35783,"_1578":35922},[],"Depende de la configuración de Vault.",{"_7979":1324,"_22255":1275,"_18887":35924,"_5":22404,"_15195":35783,"_1578":35925},[],"**Segura**",{"_7979":1325,"_22255":1275,"_18887":35927,"_5":22404,"_15195":35783,"_1578":35928},[],"**Insegura**. Un administrador con permisos suficientes puede visualizar la clave privada.",{"_7979":1326,"_22255":1275,"_18887":35930,"_5":22404,"_15195":35783,"_1578":35931},[],"Conviene limitar al máximo el acceso administrativo y custodiar correctamente las claves de *unseal*.",{"_7979":1327,"_22255":1275,"_18887":35933,"_5":22404,"_15195":35783,"_1578":35934},[],"AWS Secrets Manager",{"_7979":1328,"_22255":1275,"_18887":35936,"_5":22404,"_15195":35783,"_1578":4039},[],{"_7979":1329,"_22255":1275,"_18887":35938,"_5":22404,"_15195":35783,"_1578":35939},[],"Cloud",{"_7979":1330,"_22255":1275,"_18887":35941,"_5":22404,"_15195":35783,"_1578":33313},[],{"_7979":1331,"_22255":1275,"_18887":35943,"_5":22404,"_15195":35783,"_1578":35944},[],"Depende del proceso de alta de la clave.",{"_7979":1332,"_22255":1275,"_18887":35946,"_5":22404,"_15195":35783,"_1578":35925},[],{"_7979":1333,"_22255":1275,"_18887":35948,"_5":22404,"_15195":35783,"_1578":35928},[],{"_7979":1334,"_22255":1275,"_18887":35950,"_5":22404,"_15195":35783,"_1578":35951},[],"La protección *at-rest* la proporciona AWS, pero no evita el acceso administrativo al material privado.",{"_7979":1335,"_22255":1275,"_18887":35953,"_5":22404,"_15195":35783,"_1578":35954},[],"AWS KMS",{"_7979":1336,"_22255":1275,"_18887":35956,"_5":22404,"_15195":35783,"_1578":13446},[],{"_7979":1337,"_22255":1275,"_18887":35958,"_5":22404,"_15195":35783,"_1578":35939},[],{"_7979":1338,"_22255":1275,"_18887":35960,"_5":22404,"_15195":35783,"_1578":33313},[],{"_7979":1339,"_22255":1275,"_18887":35962,"_5":22404,"_15195":35783,"_1578":35963},[],"**Entropía hardware**",{"_7979":1340,"_22255":1275,"_18887":35965,"_5":22404,"_15195":35783,"_1578":35925},[],{"_7979":1341,"_22255":1275,"_18887":35967,"_5":22404,"_15195":35783,"_1578":35925},[],{"_7979":1342,"_22255":1275,"_18887":35969,"_5":22404,"_15195":35783,"_1578":35970},[],"Aunque la clave privada no se expone, un actor con permisos suficientes podría usarla para firmar artefactos.",{"_7979":1343,"_22255":1275,"_18887":35972,"_5":22404,"_15195":35783,"_1578":35973},[],"PKCS11",{"_7979":1344,"_22255":1275,"_18887":35975,"_5":22404,"_15195":35783,"_1578":35976},[],"3\\*",{"_7979":1345,"_22255":1275,"_18887":35978,"_5":22404,"_15195":35783,"_1578":35979},[],"AirGap OnPrem y Cloud",{"_7979":1346,"_22255":1275,"_18887":35981,"_5":22404,"_15195":35783,"_1578":35982},[],"Depende del hardware o del servicio usado. Puede integrarse con HSMs OnPrem o con ofertas Key as a Service.",{"_7979":1347,"_22255":1275,"_18887":35984,"_5":22404,"_15195":35783,"_1578":35963},[],{"_7979":1348,"_22255":1275,"_18887":35986,"_5":22404,"_15195":35783,"_1578":35987},[],"**Segura**\\*",{"_7979":1349,"_22255":1275,"_18887":35989,"_5":22404,"_15195":35783,"_1578":35990},[],"Depende del HSM",{"_7979":1350,"_22255":1275,"_18887":35992,"_5":22404,"_15195":35783,"_1578":35993},[],"El nivel real depende de la implementación PKCS11 y del HSM utilizado.",{"_7979":1351,"_22255":1275,"_18887":35995,"_5":22404,"_15195":35783,"_1578":35996},[],"Lamassu muestra en la consola el listado completo de motores habilitados.",{"_7979":1352,"_22255":1275,"_18887":35998,"_5":22404,"_15195":35783,"_1578":35999},[],"Cada motor define qué algoritmos soporta, como RSA o ECC/ECDSA, y qué tamaños de clave puede generar.",{"_7979":1353,"_22255":1275,"_18887":36001,"_5":22404,"_15195":35783,"_1578":36002},[],"Durante el despliegue es obligatorio definir un motor por defecto. Ese motor se utilizará cuando un proceso necesite crear o persistir una clave y el usuario no haya seleccionado uno específico, por ejemplo al crear o importar una CA.",{"_7979":1354,"_22255":1275,"_18887":36004,"_5":22404,"_15195":35787,"_1578":36005},[],"Una misma clave puede existir en más de un motor criptográfico a la vez. El caso habitual es que la clave privada quede custodiada en un motor aislado (por ejemplo, un HSM air-gapped) mientras una copia de la clave pública se registra en un motor online, disponible para verificar firmas sin necesidad de acceder al HSM.",{"_7979":1355,"_22255":1275,"_18887":36007,"_5":22404,"_15195":35787,"_1578":36008},[],"Cuando esto ocurre, el inventario de claves muestra una fila por cada motor que custodia una copia: comparten el mismo `Key ID`, pero difieren en **Crypto Engine** y en el campo **Public/Private**.",{"_7979":1356,"_22255":1275,"_18887":36010,"_5":22404,"_15195":35787,"_1578":36011},[],"La identidad real de una clave es la combinación de su `Key ID` y el motor que la custodia, no el `Key ID` en solitario:",{"_7979":1357,"_22255":1275,"_18887":36013,"_5":22404,"_15195":35787,"_1578":36014},[],"El **PKCS#11 URI** (`pkcs11:token-id=<engine_id>;id=<key_id>;type=public|private`) y los **Aliases** identifican siempre una copia concreta, sin ambigüedad.",{"_7979":1358,"_22255":1275,"_18887":36016,"_5":22404,"_15195":35787,"_1578":36017},[],"Un `Key ID` por sí solo funciona como atajo de búsqueda, pero sólo mientras exista en un único motor. En cuanto la misma clave se replica en un segundo motor, ese atajo deja de resolver a una copia concreta: cualquier operación por API que dependa de él (reutilizar la clave al crear una CA o un certificado, firmar, actualizar tags o alias, eliminar la clave) debe indicar en su lugar el PKCS#11 URI o un alias.",{"_7979":1359,"_22255":1275,"_18887":36019,"_5":22404,"_15195":35787,"_1578":36020},[],"Un alias no puede coincidir con un `Key ID` ya existente en el sistema; Lamassu rechaza el alta o la actualización en ese caso.",{"_7979":1360,"_22255":1275,"_18887":36022,"_5":22404,"_15195":35791,"_1578":36023},[],"La pantalla principal de KMS muestra el inventario completo de claves registradas en el sistema. Es la vista de referencia para revisar qué claves existen, dónde están custodiadas y con qué entidades están relacionadas.",{"_7979":1361,"_22255":1275,"_18887":36025,"_5":22404,"_15195":35791,"_1578":36026},[],"La tabla incluye los siguientes campos:",{"_7979":1362,"_22255":1275,"_18887":36028,"_5":22404,"_15195":35791,"_1578":36029},[],"**Name**: nombre descriptivo de la clave.",{"_7979":1363,"_22255":1275,"_18887":36031,"_5":22404,"_15195":35791,"_1578":36032},[],"**Type**: algoritmo y tamaño de clave, por ejemplo RSA 2048 o EC P-256.",{"_7979":1364,"_22255":1275,"_18887":36034,"_5":22404,"_15195":35791,"_1578":36035},[],"**Strength**: indicador visual de fortaleza criptográfica.",{"_7979":1365,"_22255":1275,"_18887":36037,"_5":22404,"_15195":35791,"_1578":36038},[],"**Public/Private**: indica si Lamassu gestiona el par completo o solo la clave pública.",{"_7979":1366,"_22255":1275,"_18887":36040,"_5":22404,"_15195":35791,"_1578":36041},[],"**Crypto Engine**: motor criptográfico que custodia la clave.",{"_7979":1367,"_22255":1275,"_18887":36043,"_5":22404,"_15195":35791,"_1578":36044},[],"**Aliases**: nombres alternativos asociados a la clave.",{"_7979":1368,"_22255":1275,"_18887":36046,"_5":22404,"_15195":35791,"_1578":36047},[],"**Tags**: etiquetas para clasificación y búsqueda.",{"_7979":1369,"_22255":1275,"_18887":36049,"_5":22404,"_15195":35791,"_1578":36050},[],"**Related Entities**: certificados u otras entidades vinculadas a esa clave.",{"_7979":1370,"_22255":1275,"_18887":36052,"_5":22404,"_15195":35791,"_1578":36053},[],"Desde esta vista también se accede a las acciones más habituales:",{"_7979":1371,"_22255":1275,"_18887":36055,"_5":22404,"_15195":35791,"_1578":36056},[],"**View Details** para consultar metadatos, identificadores y relaciones.",{"_7979":1372,"_22255":1275,"_18887":36058,"_5":22404,"_15195":35791,"_1578":36059},[],"**Generate CSR** para crear una solicitud PKCS#10 con la clave seleccionada.",{"_7979":1373,"_22255":1275,"_18887":36061,"_5":22404,"_15195":35791,"_1578":36062},[],"**Sign / Verify** para probar operaciones criptográficas sobre la clave.",{"_7979":1374,"_22255":1275,"_18887":36064,"_5":22404,"_15195":35791,"_1578":36065},[],"**Delete Key** para eliminar la clave del sistema.",{"_7979":1375,"_22255":1275,"_18887":36067,"_5":22404,"_15195":35795,"_1578":36068},[],"El alta de claves se realiza desde el asistente que se abre con **Create New Key**.",{"_7979":1376,"_22255":1275,"_18887":36070,"_5":22404,"_15195":35799,"_1578":36071},[],"Si la clave va a nacer dentro de Lamassu, el flujo recomendado es generar un nuevo par gestionado directamente por uno de los motores configurados.",{"_7979":1377,"_22255":1275,"_18887":36073,"_5":22404,"_15195":35799,"_1578":36074},[],"En la primera pantalla del asistente, elija **Generate New Key Pair** y después defina los parámetros principales:",{"_7979":1378,"_22255":1275,"_18887":36076,"_5":22404,"_15195":35799,"_1578":36077},[],"**Key Name**: nombre único y descriptivo.",{"_7979":1379,"_22255":1275,"_18887":36079,"_5":22404,"_15195":35799,"_1578":36080},[],"**Crypto Engine**: motor que custodiará la clave.",{"_7979":1380,"_22255":1275,"_18887":36082,"_5":22404,"_15195":35799,"_1578":36083},[],"**Key Type** y **Key Size**: algoritmo y tamaño o curva.",{"_7979":1381,"_22255":1275,"_18887":36085,"_5":22404,"_15195":35799,"_1578":36086},[],"**Tags**: metadatos para clasificar la clave.",{"_7979":1382,"_22255":1275,"_18887":36088,"_5":22404,"_15195":35799,"_1578":36089},[],"**Metadata**: información adicional para usos avanzados.",{"_7979":1383,"_22255":1275,"_18887":36091,"_5":22404,"_15195":35803,"_1578":36092},[],"La importación permite registrar en Lamassu una clave generada fuera de la plataforma. Es el flujo habitual en escenarios BYOK, migraciones o integración con material criptográfico que ya está en producción.",{"_7979":1384,"_22255":1275,"_18887":36094,"_5":22404,"_15195":35803,"_1578":36095},[],"Cuando la clave se ha generado en un entorno aislado o en un HSM externo.",{"_7979":1385,"_22255":1275,"_18887":36097,"_5":22404,"_15195":35803,"_1578":36098},[],"Cuando se necesita migrar una PKI existente sin reemitir certificados.",{"_7979":1386,"_22255":1275,"_18887":36100,"_5":22404,"_15195":35803,"_1578":36101},[],"Cuando Lamassu debe operar con una raíz de confianza creada por un tercero.",{"_7979":1387,"_22255":1275,"_18887":36103,"_5":22404,"_15195":35803,"_1578":36104},[],"En el asistente, elija **Import Existing Key Pair** y complete los campos solicitados:",{"_7979":1388,"_22255":1275,"_18887":36106,"_5":22404,"_15195":35803,"_1578":36107},[],"**Key Name**: nombre descriptivo dentro de Lamassu IoT.",{"_7979":1389,"_22255":1275,"_18887":36109,"_5":22404,"_15195":35803,"_1578":36110},[],"**Crypto Engine**: motor que custodiará la clave importada.",{"_7979":1390,"_22255":1275,"_18887":36112,"_5":22404,"_15195":35803,"_1578":36113},[],"**Tags**: etiquetas para organización y búsqueda.",{"_7979":1391,"_22255":1275,"_18887":36115,"_5":22404,"_15195":35803,"_1578":36116},[],"**Metadata**: información adicional opcional.",{"_7979":1392,"_22255":1275,"_18887":36118,"_5":22404,"_15195":35803,"_1578":36119},[],"**Private Key (PEM)**: clave privada en formato PEM.",{"_7979":1393,"_22255":1275,"_18887":36121,"_5":22404,"_15195":35803,"_1578":36122},[],"Una vez completado el asistente, la clave queda almacenada en el motor seleccionado y puede utilizarse para firma, generación de CSR y el resto de operaciones soportadas por KMS.",{"_7979":1394,"_22255":1275,"_18887":36124,"_5":22404,"_15195":35807,"_1578":36125},[],"Cada clave registrada dispone de una vista de detalle y de varias acciones operativas.",{"_7979":1395,"_22255":1275,"_18887":36127,"_5":22404,"_15195":35811,"_1578":36128},[],"La pantalla **View Details** concentra la información técnica y administrativa de la clave.",{"_7979":1396,"_22255":1275,"_18887":36130,"_5":22404,"_15195":35811,"_1578":36131},[],"En la pestaña **Overview** se muestran, entre otros, estos campos:",{"_7979":1397,"_22255":1275,"_18887":36133,"_5":22404,"_15195":35811,"_1578":36134},[],"**Key Name**: nombre descriptivo.",{"_7979":1398,"_22255":1275,"_18887":36136,"_5":22404,"_15195":35811,"_1578":36137},[],"**Key Identifier**: identificador PKCS#11 de esta copia de la clave. Es único para esta copia; si la misma clave existe en varios motores, cada una tiene su propio Key Identifier (ver Claves compartidas entre varios motores).",{"_7979":1399,"_22255":1275,"_18887":36139,"_5":22404,"_15195":35811,"_1578":36140},[],"**Tags**: etiquetas asociadas.",{"_7979":1400,"_22255":1275,"_18887":36142,"_5":22404,"_15195":35811,"_1578":36143},[],"**Aliases**: nombres alternativos.",{"_7979":1401,"_22255":1275,"_18887":36145,"_5":22404,"_15195":35811,"_1578":36146},[],"**Crypto Engine**: motor en el que reside la clave.",{"_7979":1402,"_22255":1275,"_18887":36148,"_5":22404,"_15195":35811,"_1578":36149},[],"**Algorithm, Key Size & Strength**: algoritmo, parámetros y nivel de fortaleza.",{"_7979":1403,"_22255":1275,"_18887":36151,"_5":22404,"_15195":35811,"_1578":36152},[],"La sección **Related Entities** muestra qué objetos de Lamassu dependen de esa clave.",{"_7979":1404,"_22255":1275,"_18887":36154,"_5":22404,"_15195":35811,"_1578":36155},[],"La pestaña **Public Key** presenta la clave pública en formato PEM, lista para consulta o copia.",{"_7979":1405,"_22255":1275,"_18887":36157,"_5":22404,"_15195":35815,"_1578":36158},[],"La acción **Sign / Verify** sirve para validar que la clave y el motor criptográfico funcionan correctamente.",{"_7979":1406,"_22255":1275,"_18887":36160,"_5":22404,"_15195":35815,"_1578":36161},[],"Al abrirla aparecen dos áreas: **Sign** y **Verify**.",{"_7979":1407,"_22255":1275,"_18887":36163,"_5":22404,"_15195":35819,"_1578":36164},[],"Esta pestaña usa la clave privada para generar una firma digital sobre un mensaje o sobre un *digest* ya calculado.",{"_7979":1408,"_22255":1275,"_18887":36166,"_5":22404,"_15195":35819,"_1578":36167},[],"Campos principales:",{"_7979":1409,"_22255":1275,"_18887":36169,"_5":22404,"_15195":35819,"_1578":36170},[],"**Algorithm**: algoritmo de firma disponible para el tipo de clave.",{"_7979":1410,"_22255":1275,"_18887":36172,"_5":22404,"_15195":35819,"_1578":36173},[],"**Message Type**: `Raw` para datos en claro o `Digest` para un hash precalculado.",{"_7979":1411,"_22255":1275,"_18887":36175,"_5":22404,"_15195":35819,"_1578":36176},[],"**Payload Encoding**: codificación de entrada, como UTF-8, Hex o Base64.",{"_7979":1412,"_22255":1275,"_18887":36178,"_5":22404,"_15195":35819,"_1578":36179},[],"**Message**: contenido que se va a firmar.",{"_7979":1413,"_22255":1275,"_18887":36181,"_5":22404,"_15195":35819,"_1578":36182},[],"**Signature**: resultado de la operación, mostrado en hexadecimal.",{"_7979":1414,"_22255":1275,"_18887":36184,"_5":22404,"_15195":35823,"_1578":36185},[],"Esta pestaña comprueba si una firma corresponde a la clave pública asociada.",{"_7979":1415,"_22255":1275,"_18887":36187,"_5":22404,"_15195":35823,"_1578":36167},[],{"_7979":1416,"_22255":1275,"_18887":36189,"_5":22404,"_15195":35823,"_1578":36190},[],"**Algorithm**: debe coincidir con el algoritmo usado para la firma.",{"_7979":1417,"_22255":1275,"_18887":36192,"_5":22404,"_15195":35823,"_1578":36193},[],"**Message Type**: `Raw` o `Digest`.",{"_7979":1418,"_22255":1275,"_18887":36195,"_5":22404,"_15195":35823,"_1578":36196},[],"**Payload Encoding**: codificación del mensaje.",{"_7979":1419,"_22255":1275,"_18887":36198,"_5":22404,"_15195":35823,"_1578":36199},[],"**Message**: mensaje original o hash.",{"_7979":1420,"_22255":1275,"_18887":36201,"_5":22404,"_15195":35823,"_1578":36202},[],"**Signature**: firma que se desea comprobar.",{"_7979":1421,"_22255":1275,"_18887":36204,"_5":22404,"_15195":35823,"_1578":36205},[],"**Result**: indicador del resultado de la validación.",{"_7979":1422,"_22255":1275,"_18887":36207,"_5":22404,"_15195":35827,"_1578":36208},[],"La acción **Generate CSR** crea una solicitud PKCS#10 firmada con la clave privada custodiada en Lamassu, sin exponerla fuera del motor criptográfico.",{"_7979":1423,"_22255":1275,"_18887":36210,"_5":22404,"_15195":35827,"_1578":36211},[],"Este flujo es útil para:",{"_7979":1424,"_22255":1275,"_18887":36213,"_5":22404,"_15195":35827,"_1578":36214},[],"Solicitar certificados a una CA externa.",{"_7979":1425,"_22255":1275,"_18887":36216,"_5":22404,"_15195":35827,"_1578":36217},[],"Renovar una identidad manteniendo la misma clave.",{"_7979":1426,"_22255":1275,"_18887":36219,"_5":22404,"_15195":35827,"_1578":36220},[],"Al abrir el formulario se solicitan los datos del sujeto y los atributos principales del certificado:",{"_7979":1427,"_22255":1275,"_18887":36222,"_5":22404,"_15195":35827,"_1578":36223},[],"**Common Name (CN)**: nombre principal de la identidad.",{"_7979":1428,"_22255":1275,"_18887":36225,"_5":22404,"_15195":35827,"_1578":36226},[],"**Organization (O)**: organización o empresa.",{"_7979":1429,"_22255":1275,"_18887":36228,"_5":22404,"_15195":35827,"_1578":36229},[],"**Organizational Unit (OU)**: departamento o unidad.",{"_7979":1430,"_22255":1275,"_18887":36231,"_5":22404,"_15195":35827,"_1578":36232},[],"**Country (C)**: código de país de dos letras.",{"_7979":1431,"_22255":1275,"_18887":36234,"_5":22404,"_15195":35827,"_1578":36235},[],"**State / Province (ST)**: estado o provincia.",{"_7979":1432,"_22255":1275,"_18887":36237,"_5":22404,"_15195":35827,"_1578":36238},[],"**Locality (L)**: ciudad o localidad.",{"_7979":1433,"_22255":1275,"_18887":36240,"_5":22404,"_15195":35827,"_1578":36241},[],"**Email Address**: correo de contacto.",{"_7979":1434,"_22255":1275,"_18887":36243,"_5":22404,"_15195":35827,"_1578":36244},[],"**Subject Alternative Names (SANs)**: nombres o identificadores alternativos, como DNS o IP.",{"_7979":1435,"_22255":1275,"_18887":36246,"_5":22404,"_15195":35827,"_1578":36247},[],"Una vez completado el formulario, Lamassu genera la CSR y la presenta para su descarga o copia.",{"_7979":1436,"_22255":1275,"_18887":36249,"_5":22404,"_15195":35831,"_1578":36250},[],"Lamassu también ofrece una ayuda específica para integraciones locales mediante **Sign locally with OpenSSL & PKCS11 tools**.",{"_7979":1437,"_22255":1275,"_18887":36252,"_5":22404,"_15195":35831,"_1578":36253},[],"Esta opción muestra los pasos necesarios para configurar el entorno local, cargar el módulo PKCS#11 y ejecutar firmas con herramientas como OpenSSL sin extraer la clave privada del entorno custodiado.",{"_7979":1438,"_22255":1438,"_5":22399,"_1578":36255,"_22412":36256,"_18887":36257,"_15195":1438},"[DMS] Device Management Service",[31966,33065,33074],[],{"_7979":1439,"_22255":1438,"_18887":36259,"_5":22404,"_15195":1438,"_1578":36260},[],"Visión general del Device Management Service en Lamassu IoT - concepto, panel de gestión y configuración común a todos los protocolos de enrolamiento.",{"_7979":1440,"_22255":1438,"_5":22409,"_18887":36262,"_15195":36263,"_1578":36264},[],"/docs/pr-preview/pr-23/manual/servicios-core/ra#device-management-service","Device Management Service",{"_7979":1441,"_22255":1438,"_5":22409,"_18887":36266,"_15195":36267,"_1578":34803},[],"/docs/pr-preview/pr-23/manual/servicios-core/ra#antes-de-empezar",{"_7979":1442,"_22255":1438,"_5":22409,"_18887":36269,"_15195":36270,"_1578":36271},[],"/docs/pr-preview/pr-23/manual/servicios-core/ra#panel-de-dms","Panel de DMS",{"_7979":1443,"_22255":1438,"_5":22409,"_18887":36273,"_15195":36274,"_1578":36275},[],"/docs/pr-preview/pr-23/manual/servicios-core/ra#distribución-de-entidades-de-confianza","Distribución de entidades de confianza",{"_7979":1444,"_22255":1438,"_5":22409,"_18887":36277,"_15195":36278,"_1578":36279},[],"/docs/pr-preview/pr-23/manual/servicios-core/ra#protocolos-de-enrolamiento","Protocolos de enrolamiento",{"_7979":1445,"_22255":1438,"_18887":36281,"_5":22404,"_15195":36263,"_1578":36282},[],"El &#x2A;*DMS (Device Management Service)** es el componente de Lamassu IoT que actúa como Autoridad de Registro (RA) frente a los dispositivos. Cada DMS recibe las solicitudes de certificado, valida la identidad del solicitante según las políticas configuradas y encarga la emisión a la CA asignada. El resultado es un canal de aprovisionamiento controlado e independiente por flota, línea de producto o entorno.",{"_7979":1446,"_22255":1438,"_18887":36284,"_5":22404,"_15195":36263,"_1578":36285},[],"En la práctica, cada DMS representa un punto de entrada diferenciado: tiene su propia CA de enrolamiento, sus propias reglas de autenticación y su propia ventana de renovación. Una organización puede operar varios DMS en paralelo - por ejemplo, uno para dispositivos de campo y otro para pasarelas internas - con políticas completamente distintas en cada caso.",{"_7979":1447,"_22255":1438,"_18887":36287,"_5":22404,"_15195":36267,"_1578":36288},[],"Para crear un DMS es necesario que exista al menos una CA activa en la plataforma, ya que el DMS requiere seleccionar una CA de enrolamiento. El usuario debe disponer del rol de administrador PKI o de permisos equivalentes sobre el módulo DMS.",{"_7979":1448,"_22255":1438,"_18887":36290,"_5":22404,"_15195":36270,"_1578":36291},[],"El panel lista todos los DMS configurados en la plataforma. Cada entrada muestra el nombre del DMS, el protocolo de enrolamiento activo y la CA de enrolamiento asignada. Desde el menú de opciones de cada DMS están disponibles las siguientes acciones:",{"_7979":1449,"_22255":1438,"_18887":36293,"_5":22404,"_15195":36270,"_1578":36294},[],"Acción",{"_7979":1450,"_22255":1438,"_18887":36296,"_5":22404,"_15195":36270,"_1578":32169},[],{"_7979":1451,"_22255":1438,"_18887":36298,"_5":22404,"_15195":36270,"_1578":36299},[],"**Edit**",{"_7979":1452,"_22255":1438,"_18887":36301,"_5":22404,"_15195":36270,"_1578":36302},[],"Modifica la configuración del DMS.",{"_7979":1453,"_22255":1438,"_18887":36304,"_5":22404,"_15195":36270,"_1578":36305},[],"**Go to DMS owned devices**",{"_7979":1454,"_22255":1438,"_18887":36307,"_5":22404,"_15195":36270,"_1578":36308},[],"Abre el listado de dispositivos gestionados por este DMS.",{"_7979":1455,"_22255":1438,"_18887":36310,"_5":22404,"_15195":36270,"_1578":36311},[],"**Show/Edit Metadata**",{"_7979":1456,"_22255":1438,"_18887":36313,"_5":22404,"_15195":36270,"_1578":36314},[],"Accede a los metadatos del DMS para usos avanzados.",{"_7979":1457,"_22255":1438,"_18887":36316,"_5":22404,"_15195":36270,"_1578":36317},[],"**EST (RFC-7030)**",{"_7979":1458,"_22255":1438,"_18887":36319,"_5":22404,"_15195":36270,"_1578":36320},[],"Muestra los endpoints EST del DMS con su URL base y ejemplos de invocación.",{"_7979":1459,"_22255":1438,"_18887":36322,"_5":22404,"_15195":36270,"_1578":36323},[],"**Delete**",{"_7979":1460,"_22255":1438,"_18887":36325,"_5":22404,"_15195":36270,"_1578":36326},[],"Elimina el DMS y su configuración. Acción irreversible.",{"_7979":1461,"_22255":1438,"_18887":36328,"_5":22404,"_15195":36274,"_1578":36329},[],"La sección **CA Distribution** controla qué certificados de CA recibe el dispositivo al consultar el endpoint de distribución de confianza del protocolo activo. Esta configuración es independiente del protocolo de enrolamiento: los parámetros tienen el mismo significado con independencia de cómo el dispositivo obtenga sus certificados.",{"_7979":1462,"_22255":1438,"_18887":36331,"_5":22404,"_15195":36274,"_1578":33297},[],{"_7979":1463,"_22255":1438,"_18887":36333,"_5":22404,"_15195":36274,"_1578":32169},[],{"_7979":1464,"_22255":1438,"_18887":36335,"_5":22404,"_15195":36274,"_1578":36336},[],"**Include Lamassu System CA**",{"_7979":1465,"_22255":1438,"_18887":36338,"_5":22404,"_15195":36274,"_1578":36339},[],"Incluye el certificado TLS del servidor Lamassu en la respuesta. Este es el certificado de extremo del servidor, no una CA - útil para *pinning* de la conexión.",{"_7979":1466,"_22255":1438,"_18887":36341,"_5":22404,"_15195":36274,"_1578":36342},[],"**Include Enrollment CA**",{"_7979":1467,"_22255":1438,"_18887":36344,"_5":22404,"_15195":36274,"_1578":36345},[],"Incluye la CA emisora configurada en este DMS, es decir, la que firmará los certificados de dispositivo.",{"_7979":1468,"_22255":1438,"_18887":36347,"_5":22404,"_15195":36274,"_1578":36348},[],"**Managed CAs**",{"_7979":1469,"_22255":1438,"_18887":36350,"_5":22404,"_15195":36274,"_1578":36351},[],"CAs adicionales distribuidas al dispositivo como anclas de confianza.",{"_7979":1470,"_22255":1438,"_18887":36353,"_5":22404,"_15195":36278,"_1578":36354},[],"El DMS expone un protocolo de enrolamiento a los dispositivos. En la versión actual de Lamassu, el único protocolo soportado es &#x2A;*EST (RFC 7030)**. La configuración del protocolo y la guía de integración para dispositivos se encuentran en las páginas correspondientes.",{"_7979":1471,"_22255":1438,"_18887":36356,"_5":22404,"_15195":36278,"_1578":36357},[],"<Card title=\"EST (RFC 7030)\" href=\"/docs/manual/servicios-core/est\" />",{"_7979":1472,"_22255":1438,"_18887":36359,"_5":22404,"_15195":36278,"_1578":35765},[],{"_7979":1473,"_22255":1473,"_5":22399,"_1578":36361,"_22412":36362,"_18887":36363,"_15195":1473},"[VA] Servicio CRL",[31966,33065,33074],[],{"_7979":1474,"_22255":1473,"_18887":36365,"_5":22404,"_15195":1473,"_1578":36366},[],"Gestión y consulta de listas de revocación para validación offline",{"_7979":1475,"_22255":1473,"_5":22409,"_18887":36368,"_15195":36369,"_1578":36370},[],"/docs/pr-preview/pr-23/manual/servicios-core/validation-crl#servicio-crl","Servicio CRL",{"_7979":1476,"_22255":1473,"_5":22409,"_18887":36372,"_15195":36373,"_1578":36374},[],"/docs/pr-preview/pr-23/manual/servicios-core/validation-crl#rol-va-y-configuración-por-ca","Rol VA y configuración por CA",{"_7979":1477,"_22255":1473,"_5":22409,"_18887":36376,"_15195":36377,"_1578":36378},[],"/docs/pr-preview/pr-23/manual/servicios-core/validation-crl#regeneración-periódica-y-automática","Regeneración periódica y automática",{"_7979":1478,"_22255":1473,"_5":22409,"_18887":36380,"_15195":36381,"_1578":36382},[],"/docs/pr-preview/pr-23/manual/servicios-core/validation-crl#contenido-de-la-crl","Contenido de la CRL",{"_7979":1479,"_22255":1473,"_5":22409,"_18887":36384,"_15195":36385,"_1578":36386},[],"/docs/pr-preview/pr-23/manual/servicios-core/validation-crl#endpoint-público-de-descarga","Endpoint público de descarga",{"_7979":1480,"_22255":1473,"_5":22409,"_18887":36388,"_15195":36389,"_1578":36390},[],"/docs/pr-preview/pr-23/manual/servicios-core/validation-crl#api-de-gestión-del-rol-va","API de gestión del rol VA",{"_7979":1481,"_22255":1473,"_5":22409,"_18887":36392,"_15195":36393,"_1578":36394},[],"/docs/pr-preview/pr-23/manual/servicios-core/validation-crl#desde-la-interfaz","Desde la interfaz",{"_7979":1482,"_22255":1473,"_5":22409,"_18887":36396,"_15195":36397,"_1578":36398},[],"/docs/pr-preview/pr-23/manual/servicios-core/validation-crl#referencias","Referencias",{"_7979":1483,"_22255":1473,"_18887":36400,"_5":22404,"_15195":36369,"_1578":36401},[],"Una CRL (*Certificate Revocation List*) es una lista firmada que contiene los números de serie de los certificados revocados antes de su fecha de caducidad. A diferencia de OCSP, no requiere una consulta en tiempo real: la parte que confía descarga la lista periódicamente y la consulta de forma local.",{"_7979":1484,"_22255":1473,"_18887":36403,"_5":22404,"_15195":36369,"_1578":36404},[],"Lamassu genera y mantiene una CRL por cada CA que gestiona. Cada CRL está firmada con la clave privada de la propia CA emisora y se almacena en el sistema de almacenamiento de objetos configurado en la plataforma.",{"_7979":1485,"_22255":1473,"_18887":36406,"_5":22404,"_15195":36373,"_1578":36407},[],"La publicación de la CRL de cada CA se controla mediante un *rol VA*. Este objeto define cómo se genera, cuándo se regenera y qué clave se utiliza para firmarla.",{"_7979":1486,"_22255":1473,"_18887":36409,"_5":22404,"_15195":36373,"_1578":36410},[],"Los parámetros principales son:",{"_7979":1487,"_22255":1473,"_18887":36412,"_5":22404,"_15195":36373,"_1578":33297},[],{"_7979":1488,"_22255":1473,"_18887":36414,"_5":22404,"_15195":36373,"_1578":32166},[],{"_7979":1489,"_22255":1473,"_18887":36416,"_5":22404,"_15195":36373,"_1578":32169},[],{"_7979":1490,"_22255":1473,"_18887":36418,"_5":22404,"_15195":36373,"_1578":36419},[],"`validity`",{"_7979":1491,"_22255":1473,"_18887":36421,"_5":22404,"_15195":36373,"_1578":36422},[],"7 días",{"_7979":1492,"_22255":1473,"_18887":36424,"_5":22404,"_15195":36373,"_1578":36425},[],"Período de validez de cada CRL emitida, reflejado en el campo `nextUpdate`.",{"_7979":1493,"_22255":1473,"_18887":36427,"_5":22404,"_15195":36373,"_1578":36428},[],"`refresh_interval`",{"_7979":1494,"_22255":1473,"_18887":36430,"_5":22404,"_15195":36373,"_1578":36431},[],"\\~6 días y 23 horas",{"_7979":1495,"_22255":1473,"_18887":36433,"_5":22404,"_15195":36373,"_1578":36434},[],"Intervalo mínimo entre regeneraciones periódicas programadas.",{"_7979":1496,"_22255":1473,"_18887":36436,"_5":22404,"_15195":36373,"_1578":36437},[],"`regenerate_on_revoke`",{"_7979":1497,"_22255":1473,"_18887":36439,"_5":22404,"_15195":36373,"_1578":36440},[],"`true`",{"_7979":1498,"_22255":1473,"_18887":36442,"_5":22404,"_15195":36373,"_1578":36443},[],"Cuando se revoca un certificado, se genera una nueva CRL de inmediato sin esperar al ciclo periódico.",{"_7979":1499,"_22255":1473,"_18887":36445,"_5":22404,"_15195":36373,"_1578":36446},[],"El campo `subject_key_id_signer` identifica la CA cuya clave privada firma la CRL. Por defecto, cada CA firma su propia CRL.",{"_7979":1500,"_22255":1473,"_18887":36448,"_5":22404,"_15195":36373,"_1578":36449},[],"Cada CRL lleva un número de versión incremental. Lamassu almacena todas las versiones en la ruta `pki/va/crl/{subject_key_id}/{version}.crl` del almacenamiento de objetos.",{"_7979":1501,"_22255":1473,"_18887":36451,"_5":22404,"_15195":36377,"_1578":36452},[],"Un proceso en segundo plano supervisa los roles VA activos. Cuando la validez restante de la CRL vigente cae por debajo del período de vigilancia configurado (*blind period*), el sistema solicita la generación de una nueva CRL. Así se evita que la CRL publicada caduque sin que exista una versión válida disponible.",{"_7979":1502,"_22255":1473,"_18887":36454,"_5":22404,"_15195":36377,"_1578":36455},[],"Además, cuando `regenerate_on_revoke` está activo, que es el comportamiento por defecto, cualquier revocación de un certificado desencadena inmediatamente la generación de una nueva CRL para la CA afectada. Esto reduce al mínimo el tiempo entre la revocación y su publicación.",{"_7979":1503,"_22255":1473,"_18887":36457,"_5":22404,"_15195":36381,"_1578":36458},[],"Cada entrada de la CRL incluye el número de serie del certificado revocado, la fecha de revocación y el código de razón conforme a RFC 5280.",{"_7979":1504,"_22255":1473,"_18887":36460,"_5":22404,"_15195":36381,"_1578":36461},[],"La CRL incluye también la extensión *Issuing Distribution Point* (IDP, OID 2.5.29.28), marcada como crítica, que indica la URL pública desde la que puede descargarse. Esa URL apunta al endpoint `/crl/{subject_key_id}` de cada dominio VA configurado.",{"_7979":1505,"_22255":1473,"_18887":36463,"_5":22404,"_15195":36385,"_1578":36464},[],"La CRL más reciente de una CA se puede obtener directamente sin autenticación:",{"_7979":1506,"_22255":1473,"_18887":36466,"_5":22404,"_15195":36385,"_1578":36467},[],"La respuesta tiene `Content-Type: application/pkix-crl` y contiene la CRL en formato DER.",{"_7979":1507,"_22255":1473,"_18887":36469,"_5":22404,"_15195":36389,"_1578":36470},[],"El rol VA de una CA se puede consultar y actualizar mediante la API:",{"_7979":1508,"_22255":1473,"_18887":36472,"_5":22404,"_15195":36389,"_1578":36473},[],"Método",{"_7979":1509,"_22255":1473,"_18887":36475,"_5":22404,"_15195":36389,"_1578":36476},[],"Ruta",{"_7979":1510,"_22255":1473,"_18887":36478,"_5":22404,"_15195":36389,"_1578":32169},[],{"_7979":1511,"_22255":1473,"_18887":36480,"_5":22404,"_15195":36389,"_1578":36481},[],"`GET`",{"_7979":1512,"_22255":1473,"_18887":36483,"_5":22404,"_15195":36389,"_1578":36484},[],"`/v1/roles/{ca-ski}`",{"_7979":1513,"_22255":1473,"_18887":36486,"_5":22404,"_15195":36389,"_1578":36487},[],"Devuelve la configuración del rol VA y los metadatos de la última CRL emitida.",{"_7979":1514,"_22255":1473,"_18887":36489,"_5":22404,"_15195":36389,"_1578":36490},[],"`PUT`",{"_7979":1515,"_22255":1473,"_18887":36492,"_5":22404,"_15195":36389,"_1578":36484},[],{"_7979":1516,"_22255":1473,"_18887":36494,"_5":22404,"_15195":36389,"_1578":36495},[],"Actualiza los parámetros de la configuración del rol VA (`validity`, `refresh_interval`, `regenerate_on_revoke`).",{"_7979":1517,"_22255":1473,"_18887":36497,"_5":22404,"_15195":36389,"_1578":36498},[],"Ejemplo de consulta del rol VA:",{"_7979":1518,"_22255":1473,"_18887":36500,"_5":22404,"_15195":36389,"_1578":36501},[],"La respuesta incluye el campo `latest_crl` con la versión, la fecha de inicio de validez y la fecha de caducidad de la CRL actualmente publicada.",{"_7979":1519,"_22255":1473,"_18887":36503,"_5":22404,"_15195":36393,"_1578":36504},[],"Desde el panel de detalle de una CA es posible previsualizar el contenido de la CRL activa y descargarla directamente para su uso offline o para importarla en aplicaciones que realicen validación local.",{"_7979":1520,"_22255":1473,"_18887":36506,"_5":22404,"_15195":36397,"_1578":36507},[],"RFC 5280 - *Internet X.509 Public Key Infrastructure Certificate and Certificate Revocation List (CRL) Profile*",{"_7979":1521,"_22255":1473,"_18887":36509,"_5":22404,"_15195":36397,"_1578":36510},[],"<Card title=\"Servicio OCSP\" href=\"/docs/manual/servicios-core/validation-ocsp\" />",{"_7979":1522,"_22255":1473,"_18887":36512,"_5":22404,"_15195":36397,"_1578":36513},[],"<Card title=\"Validación de certificados\" href=\"/docs/manual/servicios-core/validation\" />",{"_7979":1523,"_22255":1523,"_5":22399,"_1578":36515,"_22412":36516,"_18887":36517,"_15195":1523},"[VA] Servicio OCSP",[31966,33065,33074],[],{"_7979":1524,"_22255":1523,"_18887":36519,"_5":22404,"_15195":1523,"_1578":36520},[],"Validación online del estado de certificados mediante OCSP",{"_7979":1525,"_22255":1523,"_5":22409,"_18887":36522,"_15195":36523,"_1578":36524},[],"/docs/pr-preview/pr-23/manual/servicios-core/validation-ocsp#servicio-ocsp","Servicio OCSP",{"_7979":1526,"_22255":1523,"_5":22409,"_18887":36526,"_15195":36527,"_1578":36528},[],"/docs/pr-preview/pr-23/manual/servicios-core/validation-ocsp#cómo-funciona-el-respondedor-en-lamassu","Cómo funciona el respondedor en Lamassu",{"_7979":1527,"_22255":1523,"_5":22409,"_18887":36530,"_15195":36531,"_1578":36532},[],"/docs/pr-preview/pr-23/manual/servicios-core/validation-ocsp#enlace-en-los-certificados-emitidos","Enlace en los certificados emitidos",{"_7979":1528,"_22255":1523,"_5":22409,"_18887":36534,"_15195":36535,"_1578":36536},[],"/docs/pr-preview/pr-23/manual/servicios-core/validation-ocsp#endpoints-http","Endpoints HTTP",{"_7979":1529,"_22255":1523,"_5":22409,"_18887":36538,"_15195":36539,"_1578":36540},[],"/docs/pr-preview/pr-23/manual/servicios-core/validation-ocsp#comprobación-desde-la-interfaz","Comprobación desde la interfaz",{"_7979":1530,"_22255":1523,"_5":22409,"_18887":36542,"_15195":36543,"_1578":36398},[],"/docs/pr-preview/pr-23/manual/servicios-core/validation-ocsp#referencias",{"_7979":1531,"_22255":1523,"_18887":36545,"_5":22404,"_15195":36523,"_1578":36546},[],"OCSP (Online Certificate Status Protocol) es el mecanismo que permite a una parte que confía comprobar, en tiempo real, si un certificado concreto está vigente o ha sido revocado. En lugar de descargar una lista completa de certificados revocados, el cliente envía una consulta con el número de serie del certificado y recibe una respuesta firmada con el estado actual.",{"_7979":1532,"_22255":1523,"_18887":36548,"_5":22404,"_15195":36523,"_1578":36549},[],"Lamassu integra un respondedor OCSP propio que atiende estas consultas consultando directamente la base de datos interna de certificados. No se requiere ningún componente externo.",{"_7979":1533,"_22255":1523,"_18887":36551,"_5":22404,"_15195":36527,"_1578":36552},[],"Cuando un cliente solicita el estado de un certificado, el respondedor localiza el certificado por su número de serie y determina su estado según el registro interno:",{"_7979":1534,"_22255":1523,"_18887":36554,"_5":22404,"_15195":36527,"_1578":36555},[],"Si el certificado está activo, la respuesta indica `Good`.",{"_7979":1535,"_22255":1523,"_18887":36557,"_5":22404,"_15195":36527,"_1578":36558},[],"Si el certificado ha sido revocado, la respuesta indica `Revoked` e incluye la marca de tiempo de revocación y el código de razón conforme a RFC 5280.",{"_7979":1536,"_22255":1523,"_18887":36560,"_5":22404,"_15195":36527,"_1578":36561},[],"Si el número de serie no se encuentra o el estado no es reconocible, la respuesta indica `Unknown`.",{"_7979":1537,"_22255":1523,"_18887":36563,"_5":22404,"_15195":36527,"_1578":36564},[],"La respuesta OCSP es firmada por la CA emisora del certificado consultado, utilizando el motor criptográfico asociado a esa CA. Lamassu no utiliza un certificado delegado de firma OCSP: la CA actúa directamente como respondedor.",{"_7979":1538,"_22255":1523,"_18887":36566,"_5":22404,"_15195":36527,"_1578":36567},[],"Cada respuesta tiene una ventana de validez de 24 horas, reflejada en los campos `thisUpdate` y `nextUpdate` de la respuesta. Los clientes que cacheen respuestas deben tener en cuenta esta ventana al determinar durante cuánto tiempo una respuesta sigue siendo válida.",{"_7979":1539,"_22255":1523,"_18887":36569,"_5":22404,"_15195":36531,"_1578":36570},[],"La URL del respondedor OCSP se incorpora automáticamente en la extensión AIA (*Authority Information Access*) de todos los certificados emitidos por Lamassu. Los clientes que verifican certificados pueden leer esta URL directamente del certificado sin necesidad de configuración adicional.",{"_7979":1540,"_22255":1523,"_18887":36572,"_5":22404,"_15195":36535,"_1578":36573},[],"El respondedor acepta consultas en dos formatos, ambos definidos en RFC 6960:",{"_7979":1541,"_22255":1523,"_18887":36575,"_5":22404,"_15195":36535,"_1578":36473},[],{"_7979":1542,"_22255":1523,"_18887":36577,"_5":22404,"_15195":36535,"_1578":36476},[],{"_7979":1543,"_22255":1523,"_18887":36579,"_5":22404,"_15195":36535,"_1578":32169},[],{"_7979":1544,"_22255":1523,"_18887":36581,"_5":22404,"_15195":36535,"_1578":36481},[],{"_7979":1545,"_22255":1523,"_18887":36583,"_5":22404,"_15195":36535,"_1578":36584},[],"`/ocsp/{ocsp_request}`",{"_7979":1546,"_22255":1523,"_18887":36586,"_5":22404,"_15195":36535,"_1578":36587},[],"La petición OCSP va codificada en Base64url en la propia URL.",{"_7979":1547,"_22255":1523,"_18887":36589,"_5":22404,"_15195":36535,"_1578":36590},[],"`POST`",{"_7979":1548,"_22255":1523,"_18887":36592,"_5":22404,"_15195":36535,"_1578":36593},[],"`/ocsp`",{"_7979":1549,"_22255":1523,"_18887":36595,"_5":22404,"_15195":36535,"_1578":36596},[],"La petición OCSP va en el cuerpo de la petición con `Content-Type: application/ocsp-request`.",{"_7979":1550,"_22255":1523,"_18887":36598,"_5":22404,"_15195":36535,"_1578":36599},[],"Ejemplo de consulta con `curl` mediante POST:",{"_7979":1551,"_22255":1523,"_18887":36601,"_5":22404,"_15195":36535,"_1578":36602},[],"La respuesta tiene `Content-Type: application/ocsp-response` y contiene la respuesta OCSP en formato DER.",{"_7979":1552,"_22255":1523,"_18887":36604,"_5":22404,"_15195":36539,"_1578":36605},[],"Desde la pantalla de certificados de Lamassu es posible lanzar una petición OCSP directamente sobre el certificado seleccionado mediante la acción **OCSP Check**. Esta acción muestra el estado devuelto por el respondedor sin necesidad de herramientas externas.",{"_7979":1553,"_22255":1523,"_18887":36607,"_5":22404,"_15195":36543,"_1578":36608},[],"RFC 6960 - *X.509 Internet Public Key Infrastructure Online Certificate Status Protocol – OCSP*",{"_7979":1554,"_22255":1523,"_18887":36610,"_5":22404,"_15195":36543,"_1578":36611},[],"RFC 5280 - *Internet X.509 Public Key Infrastructure Certificate and Certificate Revocation List (CRL) Profile* (razones de revocación, sección 5.3.1)",{"_7979":1555,"_22255":1523,"_18887":36613,"_5":22404,"_15195":36543,"_1578":36614},[],"<Card title=\"Servicio CRL\" href=\"/docs/manual/servicios-core/validation-crl\" />",{"_7979":1556,"_22255":1523,"_18887":36616,"_5":22404,"_15195":36543,"_1578":36513},[],{"_7979":1557,"_22255":1557,"_5":22399,"_1578":36618,"_22412":36619,"_18887":36620,"_15195":1557},"[VA] Validación de Certificados",[31966,33065,33074],[],{"_7979":1558,"_22255":1557,"_18887":36622,"_5":22404,"_15195":1557,"_1578":36623},[],"Servicios OCSP y CRL para validación de certificados",{"_7979":1559,"_22255":1557,"_5":22409,"_18887":36625,"_15195":36626,"_1578":36627},[],"/docs/pr-preview/pr-23/manual/servicios-core/validation#validación-de-certificados--va","Validación de certificados – VA",{"_7979":1560,"_22255":1557,"_18887":36629,"_5":22404,"_15195":36626,"_1578":36630},[],"Lamassu ofrece dos mecanismos complementarios para validar el estado de los certificados emitidos por la plataforma:",{"_7979":1561,"_22255":1557,"_18887":36632,"_5":22404,"_15195":36626,"_1578":36633},[],"`OCSP`, para consultas online y en tiempo real del estado del certificado.",{"_7979":1562,"_22255":1557,"_18887":36635,"_5":22404,"_15195":36626,"_1578":36636},[],"`CRL`, para distribución y consulta offline de listas de revocación.",{"_7979":1563,"_22255":1557,"_18887":36638,"_5":22404,"_15195":36626,"_1578":36639},[],"En el menú lateral del módulo `VA` encontrarás cada capacidad documentada en su propia página.",{"_7979":1564,"_22255":1564,"_5":22399,"_1578":36641,"_18887":36642,"_15195":1564},"Test",[],{"_7979":1565,"_22255":1564,"_18887":36644,"_5":22404,"_15195":1564,"_1578":36645},[],"A document to test Fumadocs",{"_7979":1566,"_22255":1564,"_5":22409,"_18887":36647,"_15195":36648,"_1578":36649},[],"/docs/pr-preview/pr-23/test#cards","Cards",{"_7979":1567,"_22255":1564,"_5":22409,"_18887":36651,"_15195":36652,"_1578":36653},[],"/docs/pr-preview/pr-23/test#codeblock","CodeBlock",{"_7979":1568,"_22255":1564,"_5":22409,"_18887":36655,"_15195":36656,"_1578":36657},[],"/docs/pr-preview/pr-23/test#list","List",{"_7979":1569,"_22255":1564,"_18887":36659,"_5":22404,"_15195":1564,"_1578":36660},[],"Hey there!",{"_7979":1570,"_22255":1564,"_18887":36662,"_5":22404,"_15195":36648,"_1578":36663},[],"<Card title=\"Learn more about Next.js\" href=\"https://nextjs.org/docs\" />",{"_7979":1571,"_22255":1564,"_18887":36665,"_5":22404,"_15195":36648,"_1578":36666},[],"<Card title=\"Learn more about Fumadocs\" href=\"https://fumadocs.dev\" />",{"_7979":1572,"_22255":1564,"_18887":36668,"_5":22404,"_15195":36656,"_1578":36669},[],"Hello",{"_7979":1573,"_22255":1564,"_18887":36671,"_5":22404,"_15195":36656,"_1578":36672},[],"World","sorting",{"_36675":36676,"_36677":36678,"_36679":36680,"_36681":36682,"_4550":1596,"_42948":1596},"language","english","sortableProperties",[1578,22255,5,15195],"sortablePropertiesWithTypes",{"_1578":11602,"_22255":11602,"_5":11602,"