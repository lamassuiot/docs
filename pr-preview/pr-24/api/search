pr-preview/pr-24/platform/pki/integrations/aws-iot-core#configuration-parameters","content":"string"},"1950":{"id":"/docs/pr-preview/pr-24/platform/pki/integrations/aws-iot-core-89","page_id":"/docs/pr-preview/pr-24/platform/pki/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/integrations/aws-iot-core#configuration-parameters","content":"No"},"1951":{"id":"/docs/pr-preview/pr-24/platform/pki/integrations/aws-iot-core-90","page_id":"/docs/pr-preview/pr-24/platform/pki/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/integrations/aws-iot-core#configuration-parameters","content":"Alternative URL for all AWS services (useful with LocalStack in tests)."},"1952":{"id":"/docs/pr-preview/pr-24/platform/pki/integrations/aws-iot-core-91","page_id":"/docs/pr-preview/pr-24/platform/pki/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/integrations/aws-iot-core#configuration-parameters","content":"`subscriber_event_bus`"},"1953":{"id":"/docs/pr-preview/pr-24/platform/pki/integrations/aws-iot-core-92","page_id":"/docs/pr-preview/pr-24/platform/pki/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/integrations/aws-iot-core#configuration-parameters","content":"object"},"1954":{"id":"/docs/pr-preview/pr-24/platform/pki/integrations/aws-iot-core-93","page_id":"/docs/pr-preview/pr-24/platform/pki/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/integrations/aws-iot-core#configuration-parameters","content":"Yes"},"1955":{"id":"/docs/pr-preview/pr-24/platform/pki/integrations/aws-iot-core-94","page_id":"/docs/pr-preview/pr-24/platform/pki/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/integrations/aws-iot-core#configuration-parameters","content":"Configuration of the event bus the connector subscribes to (AMQP or AWS SQS/SNS)."},"1956":{"id":"/docs/pr-preview/pr-24/platform/pki/integrations/aws-iot-core-95","page_id":"/docs/pr-preview/pr-24/platform/pki/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/integrations/aws-iot-core#configuration-parameters","content":"`dms_manager_client`"},"1957":{"id":"/docs/pr-preview/pr-24/platform/pki/integrations/aws-iot-core-96","page_id":"/docs/pr-preview/pr-24/platform/pki/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/integrations/aws-iot-core#configuration-parameters","content":"string"},"1958":{"id":"/docs/pr-preview/pr-24/platform/pki/integrations/aws-iot-core-97","page_id":"/docs/pr-preview/pr-24/platform/pki/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/integrations/aws-iot-core#configuration-parameters","content":"Yes"},"1959":{"id":"/docs/pr-preview/pr-24/platform/pki/integrations/aws-iot-core-98","page_id":"/docs/pr-preview/pr-24/platform/pki/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/integrations/aws-iot-core#configuration-parameters","content":"HTTP URL of Lamassu's DMS Manager service."},"1960":{"id":"/docs/pr-preview/pr-24/platform/pki/integrations/aws-iot-core-99","page_id":"/docs/pr-preview/pr-24/platform/pki/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/integrations/aws-iot-core#configuration-parameters","content":"`device_manager_client`"},"1961":{"id":"/docs/pr-preview/pr-24/platform/pki/integrations/aws-iot-core-100","page_id":"/docs/pr-preview/pr-24/platform/pki/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/integrations/aws-iot-core#configuration-parameters","content":"string"},"1962":{"id":"/docs/pr-preview/pr-24/platform/pki/integrations/aws-iot-core-101","page_id":"/docs/pr-preview/pr-24/platform/pki/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/integrations/aws-iot-core#configuration-parameters","content":"Yes"},"1963":{"id":"/docs/pr-preview/pr-24/platform/pki/integrations/aws-iot-core-102","page_id":"/docs/pr-preview/pr-24/platform/pki/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/integrations/aws-iot-core#configuration-parameters","content":"HTTP URL of Lamassu's Device Manager."},"1964":{"id":"/docs/pr-preview/pr-24/platform/pki/integrations/aws-iot-core-103","page_id":"/docs/pr-preview/pr-24/platform/pki/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/integrations/aws-iot-core#configuration-parameters","content":"`ca_client`"},"1965":{"id":"/docs/pr-preview/pr-24/platform/pki/integrations/aws-iot-core-104","page_id":"/docs/pr-preview/pr-24/platform/pki/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/integrations/aws-iot-core#configuration-parameters","content":"string"},"1966":{"id":"/docs/pr-preview/pr-24/platform/pki/integrations/aws-iot-core-105","page_id":"/docs/pr-preview/pr-24/platform/pki/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/integrations/aws-iot-core#configuration-parameters","content":"Yes"},"1967":{"id":"/docs/pr-preview/pr-24/platform/pki/integrations/aws-iot-core-106","page_id":"/docs/pr-preview/pr-24/platform/pki/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/integrations/aws-iot-core#configuration-parameters","content":"HTTP URL of Lamassu's CA service."},"1968":{"id":"/docs/pr-preview/pr-24/platform/pki/integrations/aws-iot-core-107","page_id":"/docs/pr-preview/pr-24/platform/pki/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/integrations/aws-iot-core#ca-registration-in-aws-iot-core","content":"For devices to authenticate to AWS IoT Core with certificates issued by a Lamassu CA, that CA must first be registered in the AWS account. The connector handles this registration automatically in response to the `EventCreateCAKey`, `EventImportCAKey` and `EventUpdateCAMetadataKey` events, but the operation **only fires when the administrator explicitly requests it** through the CA metadata field."},"1969":{"id":"/docs/pr-preview/pr-24/platform/pki/integrations/aws-iot-core-108","page_id":"/docs/pr-preview/pr-24/platform/pki/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/integrations/aws-iot-core#how-to-request-registration","content":"Registration is triggered by setting `registration.status = \"REQUESTED\"` on the `lamassu.io/iot/{connector_id}` key of the CA's metadata. This can be done from the Lamassu console in the CA management section or through the API."},"1970":{"id":"/docs/pr-preview/pr-24/platform/pki/integrations/aws-iot-core-109","page_id":"/docs/pr-preview/pr-24/platform/pki/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/integrations/aws-iot-core#how-to-request-registration","content":"Once the event is received, the connector attempts to register the CA in AWS and updates the `registration.status` field in the CA's metadata with the result: `\"SUCCEEDED\"` if registration was successful, or `\"FAILED\"` with an error message otherwise. The process is asynchronous, so you must periodically check the metadata status until the operation completes."},"1971":{"id":"/docs/pr-preview/pr-24/platform/pki/integrations/aws-iot-core-110","page_id":"/docs/pr-preview/pr-24/platform/pki/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/integrations/aws-iot-core#primary-account","content":"When the `primary_account` parameter is `true`, the connector runs the full registration flow with proof-of-possession of the private key:"},"1972":{"id":"/docs/pr-preview/pr-24/platform/pki/integrations/aws-iot-core-111","page_id":"/docs/pr-preview/pr-24/platform/pki/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/integrations/aws-iot-core#primary-account","content":"It calls `iot:GetRegistrationCode` to obtain AWS's verification code."},"1973":{"id":"/docs/pr-preview/pr-24/platform/pki/integrations/aws-iot-core-112","page_id":"/docs/pr-preview/pr-24/platform/pki/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/integrations/aws-iot-core#primary-account","content":"The connector internally generates an ephemeral RSA-2048 key pair and builds a CSR whose Common Name is exactly that registration code. It then calls Lamassu's signing service so the registered CA issues a real X.509 verification certificate signing that CSR. The ephemeral private key is used only for this purpose and is neither stored nor sent to AWS."},"1974":{"id":"/docs/pr-preview/pr-24/platform/pki/integrations/aws-iot-core-113","page_id":"/docs/pr-preview/pr-24/platform/pki/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/integrations/aws-iot-core#primary-account","content":"It sends the CA (in PEM) and the verification certificate to AWS via `iot:RegisterCACertificate`, enabling registration with `AllowAutoRegistration: true`."},"1975":{"id":"/docs/pr-preview/pr-24/platform/pki/integrations/aws-iot-core-114","page_id":"/docs/pr-preview/pr-24/platform/pki/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/integrations/aws-iot-core#primary-account","content":"Only one account can own a CA in a given AWS region. If the CA is already registered with the same serial number, the connector silently skips the step."},"1976":{"id":"/docs/pr-preview/pr-24/platform/pki/integrations/aws-iot-core-115","page_id":"/docs/pr-preview/pr-24/platform/pki/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/integrations/aws-iot-core#primary-account","content":"The tags AWS IoT Core applies to the registered CA certificate are `LMS.CA.ID`, `LMS.CA.SN` and `LMS.CA.CN`."},"1977":{"id":"/docs/pr-preview/pr-24/platform/pki/integrations/aws-iot-core-116","page_id":"/docs/pr-preview/pr-24/platform/pki/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/integrations/aws-iot-core#secondary-account-sni-only","content":"When `primary_account` is `false`, the connector registers the CA using `CertificateMode: SNI_ONLY`. This mode requires no verification code or access to the CA's private key, so it is the right choice when the CA is managed from another AWS account or when the administrator does not hold the private key. It is the usual method to register the same CA in several AWS accounts simultaneously."},"1978":{"id":"/docs/pr-preview/pr-24/platform/pki/integrations/aws-iot-core-117","page_id":"/docs/pr-preview/pr-24/platform/pki/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/integrations/aws-iot-core#dms-configuration","content":"Each DMS participating in the AWS IoT Core integration must have the metadata key `lamassu.io/iot/{connector_id}` configured. The most important field of that configuration is `registration_mode`, which determines how devices are provisioned in AWS."},"1979":{"id":"/docs/pr-preview/pr-24/platform/pki/integrations/aws-iot-core-118","page_id":"/docs/pr-preview/pr-24/platform/pki/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/integrations/aws-iot-core#dms-configuration","content":"There are three registration modes, and the choice among them depends on the fleet's provisioning strategy."},"1980":{"id":"/docs/pr-preview/pr-24/platform/pki/integrations/aws-iot-core-119","page_id":"/docs/pr-preview/pr-24/platform/pki/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/integrations/aws-iot-core#none-mode","content":"In this mode the connector **creates no Things, groups or policies** in AWS IoT Core. It only syncs certificate status (active, revoked, suspended) as it changes in Lamassu. It is the right mode when Thing provisioning in AWS is managed by an external system and Lamassu only needs to keep certificate status up to date."},"1981":{"id":"/docs/pr-preview/pr-24/platform/pki/integrations/aws-iot-core-120","page_id":"/docs/pr-preview/pr-24/platform/pki/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/integrations/aws-iot-core#auto-mode","content":"`auto` mode delegates full device provisioning in AWS to Lamassu at enrollment time. When the device successfully completes its EST enrollment and Lamassu emits the `EventBindDeviceIdentityKey` event, the connector automatically executes the following sequence:"},"1982":{"id":"/docs/pr-preview/pr-24/platform/pki/integrations/aws-iot-core-121","page_id":"/docs/pr-preview/pr-24/platform/pki/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/integrations/aws-iot-core#auto-mode","content":"Creates or updates the IoT policies configured in the DMS."},"1983":{"id":"/docs/pr-preview/pr-24/platform/pki/integrations/aws-iot-core-122","page_id":"/docs/pr-preview/pr-24/platform/pki/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/integrations/aws-iot-core#auto-mode","content":"Creates the root group `LAMASSU` in the AWS account (if it does not exist) and the child groups configured in the DMS as subgroups of `LAMASSU`. If the groups already exist, the `ResourceAlreadyExistsException` error is ignored, making the operation idempotent."},"1984":{"id":"/docs/pr-preview/pr-24/platform/pki/integrations/aws-iot-core-123","page_id":"/docs/pr-preview/pr-24/platform/pki/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/integrations/aws-iot-core#auto-mode","content":"If the Thing already existed in AWS IoT Core, the connector iterates all certificates (principals) currently attached to that Thing and marks them as `REVOKED` in AWS, ensuring previous certificates cannot keep being used to authenticate."},"1985":{"id":"/docs/pr-preview/pr-24/platform/pki/integrations/aws-iot-core-124","page_id":"/docs/pr-preview/pr-24/platform/pki/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/integrations/aws-iot-core#auto-mode","content":"Calls `iot:RegisterThing` with a CloudFormation-style provisioning template that creates the Thing, registers the device's certificate (PEM of the device certificate and of the issuing CA certificate) and attaches the configured policies."},"1986":{"id":"/docs/pr-preview/pr-24/platform/pki/integrations/aws-iot-core-125","page_id":"/docs/pr-preview/pr-24/platform/pki/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/integrations/aws-iot-core#auto-mode","content":"Once provisioning completes, the connector stores the resulting certificate's ARN in the Lamassu certificate's metadata under the key `lamassu.io/iot/{connector_id}` and marks the device as `Registered: true` in Device Manager."},"1987":{"id":"/docs/pr-preview/pr-24/platform/pki/integrations/aws-iot-core-126","page_id":"/docs/pr-preview/pr-24/platform/pki/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/integrations/aws-iot-core#auto-mode","content":"**The Thing name in AWS is the Common Name (CN) of the device's certificate.** This convention is fundamental for the firmware developer: the `/CN=` value the device includes in its CSR when enrolling becomes the ThingName it must identify itself with in all MQTT operations against AWS IoT Core."},"1988":{"id":"/docs/pr-preview/pr-24/platform/pki/integrations/aws-iot-core-127","page_id":"/docs/pr-preview/pr-24/platform/pki/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/integrations/aws-iot-core#jitp-mode","content":"Just-In-Time Provisioning (JITP) mode delegates provisioning to AWS instead of the connector doing it directly. When the connector detects the DMS is in `jitp` mode, it creates a JITP provisioning template in AWS IoT Core and attaches it to the registered CA certificate. This template is created or updated at the moment the DMS is created or updated in Lamassu — not at device enrollment time. From then on, when a device with a certificate issued by that CA connects to AWS IoT Core for the first time, AWS executes the template automatically: it creates the Thing, registers the certificate and activates it."},"1989":{"id":"/docs/pr-preview/pr-24/platform/pki/integrations/aws-iot-core-128","page_id":"/docs/pr-preview/pr-24/platform/pki/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/integrations/aws-iot-core#jitp-mode","content":"The Thing name in the JITP template is derived from `AWS::IoT::Certificate::CommonName`, which corresponds to the device certificate's CN — the same convention as `auto` mode."},"1990":{"id":"/docs/pr-preview/pr-24/platform/pki/integrations/aws-iot-core-129","page_id":"/docs/pr-preview/pr-24/platform/pki/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/integrations/aws-iot-core#jitp-mode","content":"This mode requires the `jitp_config.provisioning_role_arn` field to be configured with the ARN of an IAM role AWS IoT Core can assume to execute the template. If not configured, the connector uses the default `arn:aws:iam::{account}:role/JITPRole` and logs a warning. The administrator must ensure that role exists in the account and has the necessary permissions before enabling JITP mode."},"1991":{"id":"/docs/pr-preview/pr-24/platform/pki/integrations/aws-iot-core-130","page_id":"/docs/pr-preview/pr-24/platform/pki/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/integrations/aws-iot-core#device-provisioning-automatic-mode","content":"For the firmware developer, `auto` mode is transparent: the device performs its EST enrollment as usual and, as a side effect, it is provisioned in AWS IoT Core with no additional step."},"1992":{"id":"/docs/pr-preview/pr-24/platform/pki/integrations/aws-iot-core-131","page_id":"/docs/pr-preview/pr-24/platform/pki/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/integrations/aws-iot-core#device-provisioning-automatic-mode","content":"The full flow from the device's perspective is:"},"1993":{"id":"/docs/pr-preview/pr-24/platform/pki/integrations/aws-iot-core-132","page_id":"/docs/pr-preview/pr-24/platform/pki/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/integrations/aws-iot-core#device-provisioning-automatic-mode","content":"Once the connector completes provisioning, the device can connect to the AWS IoT Core MQTT endpoint using its private key and the certificate issued by Lamassu. The ThingName it must identify itself with in AWS is exactly the certificate's CN."},"1994":{"id":"/docs/pr-preview/pr-24/platform/pki/integrations/aws-iot-core-133","page_id":"/docs/pr-preview/pr-24/platform/pki/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/integrations/aws-iot-core#device-provisioning-jitp-mode","content":"In JITP mode the device also performs its EST enrollment conventionally and obtains its certificate from Lamassu. The difference is that AWS IoT Core does not know the device until it attempts its first connection."},"1995":{"id":"/docs/pr-preview/pr-24/platform/pki/integrations/aws-iot-core-134","page_id":"/docs/pr-preview/pr-24/platform/pki/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/integrations/aws-iot-core#device-provisioning-jitp-mode","content":"When the device establishes its first MQTT connection to AWS IoT Core presenting the Lamassu-issued certificate, AWS detects that the certificate belongs to a CA registered with a JITP template, executes that template and creates the Thing automatically. The initial connection may fail or be delayed while the template runs; firmware must be prepared to retry the connection."},"1996":{"id":"/docs/pr-preview/pr-24/platform/pki/integrations/aws-iot-core-135","page_id":"/docs/pr-preview/pr-24/platform/pki/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/integrations/aws-iot-core#device-provisioning-jitp-mode","content":"For the JITP flow to work correctly:"},"1997":{"id":"/docs/pr-preview/pr-24/platform/pki/integrations/aws-iot-core-136","page_id":"/docs/pr-preview/pr-24/platform/pki/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/integrations/aws-iot-core#device-provisioning-jitp-mode","content":"The CA must be registered in AWS in Primary Account mode (SNI-only mode does not support JITP)."},"1998":{"id":"/docs/pr-preview/pr-24/platform/pki/integrations/aws-iot-core-137","page_id":"/docs/pr-preview/pr-24/platform/pki/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/integrations/aws-iot-core#device-provisioning-jitp-mode","content":"The IAM role configured in `jitp_config.provisioning_role_arn` must exist and have permissions to create Things, register certificates and attach policies in the AWS account."},"1999":{"id":"/docs/pr-preview/pr-24/platform/pki/integrations/aws-iot-core-138","page_id":"/docs/pr-preview/pr-24/platform/pki/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/integrations/aws-iot-core#device-provisioning-jitp-mode","content":"The device must present both its certificate and the issuing CA's certificate in the TLS handshake with AWS IoT Core."},"2000":{"id":"/docs/pr-preview/pr-24/platform/pki/integrations/aws-iot-core-139","page_id":"/docs/pr-preview/pr-24/platform/pki/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/integrations/aws-iot-core#device-provisioning-jitp-mode","content":"Certificates provisioned via JITP **do not have the connector's metadata key** (`lamassu.io/iot/{connector_id}`) in Lamassu. As a consequence, status changes of those certificates in Lamassu are not automatically synced to AWS through the state synchronization mechanism described in the next section."},"2001":{"id":"/docs/pr-preview/pr-24/platform/pki/integrations/aws-iot-core-140","page_id":"/docs/pr-preview/pr-24/platform/pki/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/integrations/aws-iot-core#certificate-status-synchronization","content":"The connector listens for the `EventUpdateCertificateStatusKey` event and, when a certificate holding the connector's metadata key changes status in Lamassu, replicates that change in AWS IoT Core. The following table shows the status mapping:"},"2002":{"id":"/docs/pr-preview/pr-24/platform/pki/integrations/aws-iot-core-141","page_id":"/docs/pr-preview/pr-24/platform/pki/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/integrations/aws-iot-core#certificate-status-synchronization","content":"Status in Lamassu"},"2003":{"id":"/docs/pr-preview/pr-24/platform/pki/integrations/aws-iot-core-142","page_id":"/docs/pr-preview/pr-24/platform/pki/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/integrations/aws-iot-core#certificate-status-synchronization","content":"Revocation reason"},"2004":{"id":"/docs/pr-preview/pr-24/platform/pki/integrations/aws-iot-core-143","page_id":"/docs/pr-preview/pr-24/platform/pki/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/integrations/aws-iot-core#certificate-status-synchronization","content":"Status in AWS IoT Core"},"2005":{"id":"/docs/pr-preview/pr-24/platform/pki/integrations/aws-iot-core-144","page_id":"/docs/pr-preview/pr-24/platform/pki/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/integrations/aws-iot-core#certificate-status-synchronization","content":"`Active`"},"2006":{"id":"/docs/pr-preview/pr-24/platform/pki/integrations/aws-iot-core-145","page_id":"/docs/pr-preview/pr-24/platform/pki/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/integrations/aws-iot-core#certificate-status-synchronization","content":"None"},"2007":{"id":"/docs/pr-preview/pr-24/platform/pki/integrations/aws-iot-core-146","page_id":"/docs/pr-preview/pr-24/platform/pki/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/integrations/aws-iot-core#certificate-status-synchronization","content":"`ACTIVE`"},"2008":{"id":"/docs/pr-preview/pr-24/platform/pki/integrations/aws-iot-core-147","page_id":"/docs/pr-preview/pr-24/platform/pki/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/integrations/aws-iot-core#certificate-status-synchronization","content":"`Revoked`"},"2009":{"id":"/docs/pr-preview/pr-24/platform/pki/integrations/aws-iot-core-148","page_id":"/docs/pr-preview/pr-24/platform/pki/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/integrations/aws-iot-core#certificate-status-synchronization","content":"`certificateHold`"},"2010":{"id":"/docs/pr-preview/pr-24/platform/pki/integrations/aws-iot-core-149","page_id":"/docs/pr-preview/pr-24/platform/pki/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/integrations/aws-iot-core#certificate-status-synchronization","content":"`INACTIVE`"},"2011":{"id":"/docs/pr-preview/pr-24/platform/pki/integrations/aws-iot-core-150","page_id":"/docs/pr-preview/pr-24/platform/pki/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/integrations/aws-iot-core#certificate-status-synchronization","content":"`Revoked`"},"2012":{"id":"/docs/pr-preview/pr-24/platform/pki/integrations/aws-iot-core-151","page_id":"/docs/pr-preview/pr-24/platform/pki/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/integrations/aws-iot-core#certificate-status-synchronization","content":"Any other reason"},"2013":{"id":"/docs/pr-preview/pr-24/platform/pki/integrations/aws-iot-core-152","page_id":"/docs/pr-preview/pr-24/platform/pki/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/integrations/aws-iot-core#certificate-status-synchronization","content":"`REVOKED`"},"2014":{"id":"/docs/pr-preview/pr-24/platform/pki/integrations/aws-iot-core-153","page_id":"/docs/pr-preview/pr-24/platform/pki/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/integrations/aws-iot-core#certificate-status-synchronization","content":"Only the `Active` and `Revoked` states produce a call to `iot:UpdateCertificate`. The other lifecycle states of Lamassu (`RenewalWindow`, `AboutToExpire`, `Expired`) are not synced to AWS IoT Core; the certificate status in AWS remains unchanged until the status in Lamassu becomes `Active` or `Revoked`."},"2015":{"id":"/docs/pr-preview/pr-24/platform/pki/integrations/aws-iot-core-154","page_id":"/docs/pr-preview/pr-24/platform/pki/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/integrations/aws-iot-core#forced-disconnect-on-revocation","content":"When the connector marks a certificate as `REVOKED` or `INACTIVE` in AWS, it additionally performs a forced disconnect of the device. To do so it opens an MQTT connection over WebSocket (with SigV4 authentication using the connector's credentials) to the AWS IoT Core data endpoint, using the certificate's CN as the MQTT client identifier, and closes it immediately. This terminates any active MQTT session the device may have at that moment."},"2016":{"id":"/docs/pr-preview/pr-24/platform/pki/integrations/aws-iot-core-155","page_id":"/docs/pr-preview/pr-24/platform/pki/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/integrations/aws-iot-core#forced-disconnect-on-revocation","content":"This forced disconnect happens at the moment Lamassu records the status change. If the device tries to reconnect after the disconnect, AWS IoT Core will reject the connection because the certificate is already listed as `REVOKED` or `INACTIVE`."},"2017":{"id":"/docs/pr-preview/pr-24/platform/pki/integrations/aws-iot-core-156","page_id":"/docs/pr-preview/pr-24/platform/pki/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/integrations/aws-iot-core#forced-disconnect-on-revocation","content":"Certificates provisioned in JITP mode do not have this automatic sync, since they lack the connector's metadata key."},"2018":{"id":"/docs/pr-preview/pr-24/platform/pki/integrations/aws-iot-core-157","page_id":"/docs/pr-preview/pr-24/platform/pki/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/integrations/aws-iot-core#device-shadow-and-automation","content":"The connector can write to the AWS IoT Core Device Shadow to send action signals to the device firmware. This feature is enabled per DMS with `shadow_config.enable: true`."},"2019":{"id":"/docs/pr-preview/pr-24/platform/pki/integrations/aws-iot-core-158","page_id":"/docs/pr-preview/pr-24/platform/pki/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/integrations/aws-iot-core#device-shadow-and-automation","content":"If `shadow_config.shadow_name` holds a value, the connector uses a Named Shadow with that name; otherwise it uses the Classic Shadow (the Thing's default shadow)."},"2020":{"id":"/docs/pr-preview/pr-24/platform/pki/integrations/aws-iot-core-159","page_id":"/docs/pr-preview/pr-24/platform/pki/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/integrations/aws-iot-core#what-the-connector-writes-to-the-shadow","content":"The connector writes to the `desired.identity_actions` field of the shadow document. Each entry contains a Unix timestamp in milliseconds. The device firmware must read this field and act accordingly."},"2021":{"id":"/docs/pr-preview/pr-24/platform/pki/integrations/aws-iot-core-160","page_id":"/docs/pr-preview/pr-24/platform/pki/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/integrations/aws-iot-core#what-the-connector-writes-to-the-shadow","content":"There are two action types:"},"2022":{"id":"/docs/pr-preview/pr-24/platform/pki/integrations/aws-iot-core-161","page_id":"/docs/pr-preview/pr-24/platform/pki/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/integrations/aws-iot-core#what-the-connector-writes-to-the-shadow","content":"**`UPDATE_CERTIFICATE`**: written when a certificate's preventive renewal window activates — that is, when the `triggered` field of the preventive renewal delta flips from `false` to `true`. This action tells the device it must start the re-enrollment process to renew its certificate before it expires."},"2023":{"id":"/docs/pr-preview/pr-24/platform/pki/integrations/aws-iot-core-162","page_id":"/docs/pr-preview/pr-24/platform/pki/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/integrations/aws-iot-core#what-the-connector-writes-to-the-shadow","content":"**`UPDATE_TRUST_ANCHOR_LIST`**: written to all devices of a DMS when the DMS's `ManagedCAs` list changes. This action tells the device it must update its trusted CA store."},"2024":{"id":"/docs/pr-preview/pr-24/platform/pki/integrations/aws-iot-core-163","page_id":"/docs/pr-preview/pr-24/platform/pki/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/integrations/aws-iot-core#what-the-connector-writes-to-the-shadow","content":"The shadow write process consists of reading the current shadow (`iotdata:GetThingShadow`), merging the new actions with the existing ones and writing the result (`iotdata:UpdateThingShadow`). If the shadow does not exist, the connector creates it. After a successful write, the list of pending actions in the device's metadata in Lamassu is cleared."},"2025":{"id":"/docs/pr-preview/pr-24/platform/pki/integrations/aws-iot-core-164","page_id":"/docs/pr-preview/pr-24/platform/pki/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/integrations/aws-iot-core#aws-iot-policies","content":"The connector creates and attaches the policies configured in the DMS. A typical policy for a device using MQTT and the Device Shadow has this structure:"},"2026":{"id":"/docs/pr-preview/pr-24/platform/pki/integrations/aws-iot-core-165","page_id":"/docs/pr-preview/pr-24/platform/pki/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/integrations/aws-iot-core#aws-iot-policies","content":"In the policy above, the `<AWS_REGION>` and `<AWS_ACCOUNT_ID>` placeholders must be replaced with the AWS region and the twelve-digit account identifier of the target account before applying the policy. The `${iot:Connection.Thing.ThingName}` variable automatically limits each permission to the Thing the device is connected as, following the principle of least privilege. The `${ShadowName}` variable in the shadow ARNs is a placeholder that must be replaced with the `shadow_config.shadow_name` value configured in the DMS; if the Classic Shadow is used, it can be simplified by removing the `name/${ShadowName}/` segment. AWS IoT policies do not support regex alternation; the `[name/${ShadowName}/]*` notation represents the optionality of that segment within ARN syntax constraints."},"2027":{"id":"/docs/pr-preview/pr-24/platform/pki/integrations/aws-iot-core-166","page_id":"/docs/pr-preview/pr-24/platform/pki/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/integrations/aws-iot-core#aws-iot-policies","content":"The first statement lets the device connect using its ThingName as the MQTT identifier. The second authorizes publishing to the Thing's generic MQTT topic and to the shadow topics, needed so the device can update its reported state. The last two statements grant subscribe and receive permissions over the same topics, letting the device receive shadow updates (for example, the `UPDATE_CERTIFICATE` and `UPDATE_TRUST_ANCHOR_LIST` actions written by the connector)."},"2028":{"id":"/docs/pr-preview/pr-24/platform/pki/integrations/aws-iot-core-167","page_id":"/docs/pr-preview/pr-24/platform/pki/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/integrations/aws-iot-core#troubleshooting","content":"**Symptom:** The CA registration stays in `REQUESTED` indefinitely."},"2029":{"id":"/docs/pr-preview/pr-24/platform/pki/integrations/aws-iot-core-168","page_id":"/docs/pr-preview/pr-24/platform/pki/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/integrations/aws-iot-core#troubleshooting","content":"**Cause:** The connector is not running or is not subscribed to the event bus. It can also indicate incorrect IAM credentials, insufficient permissions or that the metadata key was written with a wrong `connector_id`."},"2030":{"id":"/docs/pr-preview/pr-24/platform/pki/integrations/aws-iot-core-169","page_id":"/docs/pr-preview/pr-24/platform/pki/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/integrations/aws-iot-core#troubleshooting","content":"**Resolution:** Verify the connector process is active and the logs show no AWS communication errors. Check the metadata field was written under the exact key `lamassu.io/iot/{connector_id}`. If the error persists, the connector will update the status to `FAILED` with a descriptive message in the CA metadata."},"2031":{"id":"/docs/pr-preview/pr-24/platform/pki/integrations/aws-iot-core-170","page_id":"/docs/pr-preview/pr-24/platform/pki/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/integrations/aws-iot-core#troubleshooting","content":"**Symptom:** A certificate's status is not synced to AWS after a revocation."},"2032":{"id":"/docs/pr-preview/pr-24/platform/pki/integrations/aws-iot-core-171","page_id":"/docs/pr-preview/pr-24/platform/pki/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/integrations/aws-iot-core#troubleshooting","content":"**Cause:** Most commonly the certificate was provisioned in JITP mode. JITP certificates lack the connector's metadata key and are outside the state synchronization mechanism. If the DMS is in `auto` mode, it may indicate the initial provisioning did not complete correctly and the AWS ARN was not stored in the certificate metadata."},"2033":{"id":"/docs/pr-preview/pr-24/platform/pki/integrations/aws-iot-core-172","page_id":"/docs/pr-preview/pr-24/platform/pki/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/integrations/aws-iot-core#troubleshooting","content":"**Resolution:** For JITP certificates, migrate the DMS to `auto` mode and re-provision the affected devices. For `auto` mode certificates, verify the certificate has the AWS ARN stored in its metadata; if not, repeat the provisioning."},"2034":{"id":"/docs/pr-preview/pr-24/platform/pki/integrations/aws-iot-core-173","page_id":"/docs/pr-preview/pr-24/platform/pki/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/integrations/aws-iot-core#troubleshooting","content":"**Symptom:** The forced disconnect does not terminate the device's MQTT session after revocation."},"2035":{"id":"/docs/pr-preview/pr-24/platform/pki/integrations/aws-iot-core-174","page_id":"/docs/pr-preview/pr-24/platform/pki/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/integrations/aws-iot-core#troubleshooting","content":"**Cause:** The device uses an MQTT client ID different from the certificate's CN. The forced disconnect opens a connection using the CN as client ID; if the firmware uses another identifier, the disconnect does not affect that session."},"2036":{"id":"/docs/pr-preview/pr-24/platform/pki/integrations/aws-iot-core-175","page_id":"/docs/pr-preview/pr-24/platform/pki/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/integrations/aws-iot-core#troubleshooting","content":"**Resolution:** Make sure the firmware uses exactly the certificate's CN as the MQTT client identifier. That CN matches the ThingName in AWS IoT Core."},"2037":{"id":"/docs/pr-preview/pr-24/platform/pki/integrations/aws-iot-core-176","page_id":"/docs/pr-preview/pr-24/platform/pki/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/integrations/aws-iot-core#troubleshooting","content":"**Symptom:** The device receives `CLIENT_ID_REJECTED` when connecting to AWS IoT Core."},"2038":{"id":"/docs/pr-preview/pr-24/platform/pki/integrations/aws-iot-core-177","page_id":"/docs/pr-preview/pr-24/platform/pki/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/integrations/aws-iot-core#troubleshooting","content":"**Cause:** The MQTT client ID does not match the ThingName, which is always the CN of the certificate issued by Lamassu."},"2039":{"id":"/docs/pr-preview/pr-24/platform/pki/integrations/aws-iot-core-178","page_id":"/docs/pr-preview/pr-24/platform/pki/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/integrations/aws-iot-core#troubleshooting","content":"**Resolution:** Verify the firmware uses exactly the value of the CN field included in the enrollment CSR as the MQTT client identifier."},"2040":{"id":"/docs/pr-preview/pr-24/platform/pki/integrations/aws-iot-core-179","page_id":"/docs/pr-preview/pr-24/platform/pki/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/integrations/aws-iot-core#troubleshooting","content":"**Symptom:** The device's first MQTT connection in JITP mode fails or times out."},"2041":{"id":"/docs/pr-preview/pr-24/platform/pki/integrations/aws-iot-core-180","page_id":"/docs/pr-preview/pr-24/platform/pki/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/integrations/aws-iot-core#troubleshooting","content":"**Cause:** This is expected behavior while AWS executes the JITP template on the device's first connection."},"2042":{"id":"/docs/pr-preview/pr-24/platform/pki/integrations/aws-iot-core-181","page_id":"/docs/pr-preview/pr-24/platform/pki/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/integrations/aws-iot-core#troubleshooting","content":"**Resolution:** Firmware must implement retries with exponential backoff for the first connection. If the failure persists beyond a few minutes, verify the IAM role configured in `jitp_config.provisioning_role_arn` exists in the account and has permissions to create Things, register certificates and attach policies."},"2043":{"id":"/docs/pr-preview/pr-24/platform/pki/integrations/aws-iot-core-182","page_id":"/docs/pr-preview/pr-24/platform/pki/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/integrations/aws-iot-core#troubleshooting","content":"**Symptom:** The Device Shadow is not updated when it should be."},"2044":{"id":"/docs/pr-preview/pr-24/platform/pki/integrations/aws-iot-core-183","page_id":"/docs/pr-preview/pr-24/platform/pki/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/integrations/aws-iot-core#troubleshooting","content":"**Cause:** The shadow feature is disabled in the DMS configuration, the connector's credentials lack IoT data-plane permissions, or the firmware reads a different shadow than the configured one."},"2045":{"id":"/docs/pr-preview/pr-24/platform/pki/integrations/aws-iot-core-184","page_id":"/docs/pr-preview/pr-24/platform/pki/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/integrations/aws-iot-core#troubleshooting","content":"**Resolution:** Check that `shadow_config.enable` is `true` in the connector metadata for the corresponding DMS. If a Named Shadow is used, verify `shadow_config.shadow_name` holds the correct name and that the firmware reads that Named Shadow and not the Classic Shadow. Confirm the connector's credentials have `iotdata:GetThingShadow` and `iotdata:UpdateThingShadow` permissions."},"2046":{"id":"/docs/pr-preview/pr-24/platform/pki/integrations/aws-iot-core-185","page_id":"/docs/pr-preview/pr-24/platform/pki/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/integrations/aws-iot-core#troubleshooting","content":"<Card title=\"Configure a DMS\" href=\"/docs/platform/pki/device-enrollment\" />"},"2047":{"id":"/docs/pr-preview/pr-24/platform/pki/integrations/aws-iot-core-186","page_id":"/docs/pr-preview/pr-24/platform/pki/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/integrations/aws-iot-core#troubleshooting","content":"<Card title=\"Device enrollment (EST)\" href=\"/docs/platform/pki/est-enrollment\" />"},"2048":{"id":"/docs/pr-preview/pr-24/platform/pki/integrations/aws-iot-core-187","page_id":"/docs/pr-preview/pr-24/platform/pki/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/integrations/aws-iot-core#troubleshooting","content":"<Card title=\"Certificate management\" href=\"/docs/platform/pki/certificates\" />"},"2049":{"id":"/docs/pr-preview/pr-24/platform/pki/key-management","page_id":"/docs/pr-preview/pr-24/platform/pki/key-management","type":"page","content":"Keys and cryptographic engines","breadcrumbs":["Docs","Platform","Operate Lamassu"],"tags":[],"url":"/docs/pr-preview/pr-24/platform/pki/key-management"},"2050":{"id":"/docs/pr-preview/pr-24/platform/pki/key-management-0","page_id":"/docs/pr-preview/pr-24/platform/pki/key-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/key-management","content":"Generate, import and operate keys without coupling the PKI to a specific provider."},"2051":{"id":"/docs/pr-preview/pr-24/platform/pki/key-management-1","page_id":"/docs/pr-preview/pr-24/platform/pki/key-management","type":"heading","tags":[],"url":"/docs/pr-preview/pr-24/platform/pki/key-management#cryptographic-key-management","content":"Cryptographic key management"},"2052":{"id":"/docs/pr-preview/pr-24/platform/pki/key-management-2","page_id":"/docs/pr-preview/pr-24/platform/pki/key-management","type":"heading","tags":[],"url":"/docs/pr-preview/pr-24/platform/pki/key-management#what-the-kms-solves","content":"What the KMS solves"},"2053":{"id":"/docs/pr-preview/pr-24/platform/pki/key-management-3","page_id":"/docs/pr-preview/pr-24/platform/pki/key-management","type":"heading","tags":[],"url":"/docs/pr-preview/pr-24/platform/pki/key-management#cryptographic-engines","content":"Cryptographic engines"},"2054":{"id":"/docs/pr-preview/pr-24/platform/pki/key-management-4","page_id":"/docs/pr-preview/pr-24/platform/pki/key-management","type":"heading","tags":[],"url":"/docs/pr-preview/pr-24/platform/pki/key-management#file-system","content":"File System"},"2055":{"id":"/docs/pr-preview/pr-24/platform/pki/key-management-5","page_id":"/docs/pr-preview/pr-24/platform/pki/key-management","type":"heading","tags":[],"url":"/docs/pr-preview/pr-24/platform/pki/key-management#hashicorp-vault","content":"HashiCorp Vault"},"2056":{"id":"/docs/pr-preview/pr-24/platform/pki/key-management-6","page_id":"/docs/pr-preview/pr-24/platform/pki/key-management","type":"heading","tags":[],"url":"/docs/pr-preview/pr-24/platform/pki/key-management#aws-secrets-manager","content":"AWS Secrets Manager"},"2057":{"id":"/docs/pr-preview/pr-24/platform/pki/key-management-7","page_id":"/docs/pr-preview/pr-24/platform/pki/key-management","type":"heading","tags":[],"url":"/docs/pr-preview/pr-24/platform/pki/key-management#aws-kms","content":"AWS KMS"},"2058":{"id":"/docs/pr-preview/pr-24/platform/pki/key-management-8","page_id":"/docs/pr-preview/pr-24/platform/pki/key-management","type":"heading","tags":[],"url":"/docs/pr-preview/pr-24/platform/pki/key-management#pkcs11","content":"PKCS#11"},"2059":{"id":"/docs/pr-preview/pr-24/platform/pki/key-management-9","page_id":"/docs/pr-preview/pr-24/platform/pki/key-management","type":"heading","tags":[],"url":"/docs/pr-preview/pr-24/platform/pki/key-management#key-inventory","content":"Key inventory"},"2060":{"id":"/docs/pr-preview/pr-24/platform/pki/key-management-10","page_id":"/docs/pr-preview/pr-24/platform/pki/key-management","type":"heading","tags":[],"url":"/docs/pr-preview/pr-24/platform/pki/key-management#create-or-import-keys","content":"Create or import keys"},"2061":{"id":"/docs/pr-preview/pr-24/platform/pki/key-management-11","page_id":"/docs/pr-preview/pr-24/platform/pki/key-management","type":"heading","tags":[],"url":"/docs/pr-preview/pr-24/platform/pki/key-management#generate-a-new-key-pair","content":"Generate a new key pair"},"2062":{"id":"/docs/pr-preview/pr-24/platform/pki/key-management-12","page_id":"/docs/pr-preview/pr-24/platform/pki/key-management","type":"heading","tags":[],"url":"/docs/pr-preview/pr-24/platform/pki/key-management#import-an-existing-pair","content":"Import an existing pair"},"2063":{"id":"/docs/pr-preview/pr-24/platform/pki/key-management-13","page_id":"/docs/pr-preview/pr-24/platform/pki/key-management","type":"heading","tags":[],"url":"/docs/pr-preview/pr-24/platform/pki/key-management#operations-on-a-key","content":"Operations on a key"},"2064":{"id":"/docs/pr-preview/pr-24/platform/pki/key-management-14","page_id":"/docs/pr-preview/pr-24/platform/pki/key-management","type":"heading","tags":[],"url":"/docs/pr-preview/pr-24/platform/pki/key-management#view-details","content":"View details"},"2065":{"id":"/docs/pr-preview/pr-24/platform/pki/key-management-15","page_id":"/docs/pr-preview/pr-24/platform/pki/key-management","type":"heading","tags":[],"url":"/docs/pr-preview/pr-24/platform/pki/key-management#sign-and-verify","content":"Sign and verify"},"2066":{"id":"/docs/pr-preview/pr-24/platform/pki/key-management-16","page_id":"/docs/pr-preview/pr-24/platform/pki/key-management","type":"heading","tags":[],"url":"/docs/pr-preview/pr-24/platform/pki/key-management#sign","content":"Sign"},"2067":{"id":"/docs/pr-preview/pr-24/platform/pki/key-management-17","page_id":"/docs/pr-preview/pr-24/platform/pki/key-management","type":"heading","tags":[],"url":"/docs/pr-preview/pr-24/platform/pki/key-management#verify","content":"Verify"},"2068":{"id":"/docs/pr-preview/pr-24/platform/pki/key-management-18","page_id":"/docs/pr-preview/pr-24/platform/pki/key-management","type":"heading","tags":[],"url":"/docs/pr-preview/pr-24/platform/pki/key-management#generate-a-csr","content":"Generate a CSR"},"2069":{"id":"/docs/pr-preview/pr-24/platform/pki/key-management-19","page_id":"/docs/pr-preview/pr-24/platform/pki/key-management","type":"heading","tags":[],"url":"/docs/pr-preview/pr-24/platform/pki/key-management#sign-locally-with-pkcs11","content":"Sign locally with PKCS#11"},"2070":{"id":"/docs/pr-preview/pr-24/platform/pki/key-management-20","page_id":"/docs/pr-preview/pr-24/platform/pki/key-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/key-management#cryptographic-key-management","content":"The Cryptographic Key Management Service (KMS) of Lamassu IoT centralizes the generation, import, custody and use of the platform's keys. This is where you manage the keys that support the CAs and the rest of the signing operations that depend on the PKI."},"2071":{"id":"/docs/pr-preview/pr-24/platform/pki/key-management-21","page_id":"/docs/pr-preview/pr-24/platform/pki/key-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/key-management#cryptographic-key-management","content":"In the current configuration, Lamassu IoT works exclusively with asymmetric keys, such as RSA and elliptic curves. These keys are used to issue X.509 certificates, sign requests and perform authentication and validation operations within the system."},"2072":{"id":"/docs/pr-preview/pr-24/platform/pki/key-management-22","page_id":"/docs/pr-preview/pr-24/platform/pki/key-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/key-management#what-the-kms-solves","content":"The KMS unifies key lifecycle management and prevents every service from having to integrate directly with a specific cryptographic provider."},"2073":{"id":"/docs/pr-preview/pr-24/platform/pki/key-management-23","page_id":"/docs/pr-preview/pr-24/platform/pki/key-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/key-management#what-the-kms-solves","content":"In practice, it lets you:"},"2074":{"id":"/docs/pr-preview/pr-24/platform/pki/key-management-24","page_id":"/docs/pr-preview/pr-24/platform/pki/key-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/key-management#what-the-kms-solves","content":"Generate new key pairs from Lamassu IoT."},"2075":{"id":"/docs/pr-preview/pr-24/platform/pki/key-management-25","page_id":"/docs/pr-preview/pr-24/platform/pki/key-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/key-management#what-the-kms-solves","content":"Import keys created externally."},"2076":{"id":"/docs/pr-preview/pr-24/platform/pki/key-management-26","page_id":"/docs/pr-preview/pr-24/platform/pki/key-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/key-management#what-the-kms-solves","content":"Delegate custody and cryptographic operations to external engines."},"2077":{"id":"/docs/pr-preview/pr-24/platform/pki/key-management-27","page_id":"/docs/pr-preview/pr-24/platform/pki/key-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/key-management#what-the-kms-solves","content":"Reuse existing keys for CAs, CSRs and signing or verification tasks."},"2078":{"id":"/docs/pr-preview/pr-24/platform/pki/key-management-28","page_id":"/docs/pr-preview/pr-24/platform/pki/key-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/key-management#cryptographic-engines","content":"Lamassu can work with different cryptographic engines depending on deployment requirements. In some environments a software engine is enough; in others custody must be delegated to an HSM, a cloud service or a specialized platform."},"2079":{"id":"/docs/pr-preview/pr-24/platform/pki/key-management-29","page_id":"/docs/pr-preview/pr-24/platform/pki/key-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/key-management#cryptographic-engines","content":"A single instance can have several engines configured at the same time, including multiple instances of the same type. This lets you adapt operations to different security, cost and regulatory requirements."},"2080":{"id":"/docs/pr-preview/pr-24/platform/pki/key-management-30","page_id":"/docs/pr-preview/pr-24/platform/pki/key-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/key-management#cryptographic-engines","content":"Currently, Lamassu supports five engine types. Choose according to the isolation level you need and who should be able to access private material."},"2081":{"id":"/docs/pr-preview/pr-24/platform/pki/key-management-31","page_id":"/docs/pr-preview/pr-24/platform/pki/key-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/key-management#file-system","content":"Generates keys with Go's cryptographic libraries and delegates their protection to the file system. It works both on-premise and in the cloud, but it does not prevent key extraction and is not recommended for production."},"2082":{"id":"/docs/pr-preview/pr-24/platform/pki/key-management-32","page_id":"/docs/pr-preview/pr-24/platform/pki/key-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/key-management#hashicorp-vault","content":"Protects keys at rest and can run on-premise or in the cloud. An administrator with sufficient permissions can still view private material, so it is wise to limit administrative access and safeguard the *unseal* keys."},"2083":{"id":"/docs/pr-preview/pr-24/platform/pki/key-management-33","page_id":"/docs/pr-preview/pr-24/platform/pki/key-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/key-management#aws-secrets-manager","content":"Offers encrypted persistence in AWS at a cost. It protects the key at rest, but an authorized administrator can recover it; it does not provide the same extraction resistance as a KMS or HSM."},"2084":{"id":"/docs/pr-preview/pr-24/platform/pki/key-management-34","page_id":"/docs/pr-preview/pr-24/platform/pki/key-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/key-management#aws-kms","content":"Generates keys with hardware entropy and never exposes the private key. Operations run inside the service. Even so, an identity with sufficient permissions could use the key to sign, so IAM policy remains critical."},"2085":{"id":"/docs/pr-preview/pr-24/platform/pki/key-management-35","page_id":"/docs/pr-preview/pr-24/platform/pki/key-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/key-management#pkcs11","content":"Allows integrating local HSMs, isolated environments and *Key as a Service* offerings. Generation, persistence and extraction resistance depend on the specific device or provider. It is the most flexible option when policy requires hardware custody."},"2086":{"id":"/docs/pr-preview/pr-24/platform/pki/key-management-36","page_id":"/docs/pr-preview/pr-24/platform/pki/key-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/key-management#pkcs11","content":"Lamassu shows the full list of enabled engines in the console."},"2087":{"id":"/docs/pr-preview/pr-24/platform/pki/key-management-37","page_id":"/docs/pr-preview/pr-24/platform/pki/key-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/key-management#pkcs11","content":"Each engine defines which algorithms it supports, such as RSA or ECC/ECDSA, and which key sizes it can generate."},"2088":{"id":"/docs/pr-preview/pr-24/platform/pki/key-management-38","page_id":"/docs/pr-preview/pr-24/platform/pki/key-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/key-management#pkcs11","content":"During deployment it is mandatory to define a default engine. That engine will be used when a process needs to create or persist a key and the user has not selected a specific one, for example when creating or importing a CA."},"2089":{"id":"/docs/pr-preview/pr-24/platform/pki/key-management-39","page_id":"/docs/pr-preview/pr-24/platform/pki/key-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/key-management#key-inventory","content":"The main KMS screen shows the complete inventory of keys registered in the system. It is the reference view for reviewing which keys exist, where they are kept and which entities they relate to."},"2090":{"id":"/docs/pr-preview/pr-24/platform/pki/key-management-40","page_id":"/docs/pr-preview/pr-24/platform/pki/key-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/key-management#key-inventory","content":"The table includes the following fields:"},"2091":{"id":"/docs/pr-preview/pr-24/platform/pki/key-management-41","page_id":"/docs/pr-preview/pr-24/platform/pki/key-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/key-management#key-inventory","content":"**Name**: descriptive name of the key."},"2092":{"id":"/docs/pr-preview/pr-24/platform/pki/key-management-42","page_id":"/docs/pr-preview/pr-24/platform/pki/key-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/key-management#key-inventory","content":"**Type**: algorithm and key size, for example RSA 2048 or EC P-256."},"2093":{"id":"/docs/pr-preview/pr-24/platform/pki/key-management-43","page_id":"/docs/pr-preview/pr-24/platform/pki/key-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/key-management#key-inventory","content":"**Strength**: visual indicator of cryptographic strength."},"2094":{"id":"/docs/pr-preview/pr-24/platform/pki/key-management-44","page_id":"/docs/pr-preview/pr-24/platform/pki/key-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/key-management#key-inventory","content":"**Public/Private**: whether Lamassu manages the full pair or only the public key."},"2095":{"id":"/docs/pr-preview/pr-24/platform/pki/key-management-45","page_id":"/docs/pr-preview/pr-24/platform/pki/key-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/key-management#key-inventory","content":"**Crypto Engine**: cryptographic engine keeping the key."},"2096":{"id":"/docs/pr-preview/pr-24/platform/pki/key-management-46","page_id":"/docs/pr-preview/pr-24/platform/pki/key-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/key-management#key-inventory","content":"**Aliases**: alternative names associated with the key."},"2097":{"id":"/docs/pr