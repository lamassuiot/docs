/pr-24/platform/pki/cmp-242","page_id":"/docs/pr-preview/pr-24/platform/pki/cmp","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/cmp#genm--general-message","content":"The algorithm configured in `preferred_symmetric_algorithm`."},"1054":{"id":"/docs/pr-preview/pr-24/platform/pki/cmp-243","page_id":"/docs/pr-preview/pr-24/platform/pki/cmp","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/cmp#genm--general-message","content":"`supported_languages`"},"1055":{"id":"/docs/pr-preview/pr-24/platform/pki/cmp-244","page_id":"/docs/pr-preview/pr-24/platform/pki/cmp","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/cmp#genm--general-message","content":"`supportedLangTags` (16)"},"1056":{"id":"/docs/pr-preview/pr-24/platform/pki/cmp-245","page_id":"/docs/pr-preview/pr-24/platform/pki/cmp","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/cmp#genm--general-message","content":"Enabled"},"1057":{"id":"/docs/pr-preview/pr-24/platform/pki/cmp-246","page_id":"/docs/pr-preview/pr-24/platform/pki/cmp","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/cmp#genm--general-message","content":"Language negotiation for `PKIFreeText`; the only supported one is `en`."},"1058":{"id":"/docs/pr-preview/pr-24/platform/pki/cmp-247","page_id":"/docs/pr-preview/pr-24/platform/pki/cmp","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/cmp#genm--general-message","content":"`root_ca_update`"},"1059":{"id":"/docs/pr-preview/pr-24/platform/pki/cmp-248","page_id":"/docs/pr-preview/pr-24/platform/pki/cmp","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/cmp#genm--general-message","content":"`rootCaCert` (20)"},"1060":{"id":"/docs/pr-preview/pr-24/platform/pki/cmp-249","page_id":"/docs/pr-preview/pr-24/platform/pki/cmp","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/cmp#genm--general-message","content":"Disabled"},"1061":{"id":"/docs/pr-preview/pr-24/platform/pki/cmp-250","page_id":"/docs/pr-preview/pr-24/platform/pki/cmp","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/cmp#genm--general-message","content":"Update of the current root (`newWithNew`/`newWithOld`), compared against the root the device declares."},"1062":{"id":"/docs/pr-preview/pr-24/platform/pki/cmp-251","page_id":"/docs/pr-preview/pr-24/platform/pki/cmp","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/cmp#genm--general-message","content":"`certificate_request_template`"},"1063":{"id":"/docs/pr-preview/pr-24/platform/pki/cmp-252","page_id":"/docs/pr-preview/pr-24/platform/pki/cmp","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/cmp#genm--general-message","content":"`certReqTemplate` (19)"},"1064":{"id":"/docs/pr-preview/pr-24/platform/pki/cmp-253","page_id":"/docs/pr-preview/pr-24/platform/pki/cmp","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/cmp#genm--general-message","content":"Disabled"},"1065":{"id":"/docs/pr-preview/pr-24/platform/pki/cmp-254","page_id":"/docs/pr-preview/pr-24/platform/pki/cmp","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/cmp#genm--general-message","content":"Template derived from the DMS's issuance profile: supported key algorithms and sizes, and certificate validity."},"1066":{"id":"/docs/pr-preview/pr-24/platform/pki/cmp-255","page_id":"/docs/pr-preview/pr-24/platform/pki/cmp","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/cmp#genm--general-message","content":"`current_crl`"},"1067":{"id":"/docs/pr-preview/pr-24/platform/pki/cmp-256","page_id":"/docs/pr-preview/pr-24/platform/pki/cmp","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/cmp#genm--general-message","content":"`currentCRL` (6)"},"1068":{"id":"/docs/pr-preview/pr-24/platform/pki/cmp-257","page_id":"/docs/pr-preview/pr-24/platform/pki/cmp","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/cmp#genm--general-message","content":"Disabled"},"1069":{"id":"/docs/pr-preview/pr-24/platform/pki/cmp-258","page_id":"/docs/pr-preview/pr-24/platform/pki/cmp","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/cmp#genm--general-message","content":"Current CRL, served through the VA client of the DMS Manager service."},"1070":{"id":"/docs/pr-preview/pr-24/platform/pki/cmp-259","page_id":"/docs/pr-preview/pr-24/platform/pki/cmp","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/cmp#genm--general-message","content":"`crl_update`"},"1071":{"id":"/docs/pr-preview/pr-24/platform/pki/cmp-260","page_id":"/docs/pr-preview/pr-24/platform/pki/cmp","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/cmp#genm--general-message","content":"`crlStatusList` (22)"},"1072":{"id":"/docs/pr-preview/pr-24/platform/pki/cmp-261","page_id":"/docs/pr-preview/pr-24/platform/pki/cmp","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/cmp#genm--general-message","content":"Disabled"},"1073":{"id":"/docs/pr-preview/pr-24/platform/pki/cmp-262","page_id":"/docs/pr-preview/pr-24/platform/pki/cmp","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/cmp#genm--general-message","content":"CRL updates per issuer, only those newer than the one the device declares."},"1074":{"id":"/docs/pr-preview/pr-24/platform/pki/cmp-263","page_id":"/docs/pr-preview/pr-24/platform/pki/cmp","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/cmp#genm--general-message","content":"`protocol_encryption_certificate`"},"1075":{"id":"/docs/pr-preview/pr-24/platform/pki/cmp-264","page_id":"/docs/pr-preview/pr-24/platform/pki/cmp","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/cmp#genm--general-message","content":"`caProtEncCert` (1)"},"1076":{"id":"/docs/pr-preview/pr-24/platform/pki/cmp-265","page_id":"/docs/pr-preview/pr-24/platform/pki/cmp","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/cmp#genm--general-message","content":"Disabled"},"1077":{"id":"/docs/pr-preview/pr-24/platform/pki/cmp-266","page_id":"/docs/pr-preview/pr-24/platform/pki/cmp","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/cmp#genm--general-message","content":"Always answered without a value — Lamassu does not provision a dedicated protocol-encryption certificate."},"1078":{"id":"/docs/pr-preview/pr-24/platform/pki/cmp-267","page_id":"/docs/pr-preview/pr-24/platform/pki/cmp","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/cmp#genm--general-message","content":"Exchange rules: a `genm` requesting a disabled type is rejected entirely with `notAuthorized`; the types `caCerts`, `certReqTemplate`, `currentCRL`, `signKeyPairTypes`, `encKeyPairTypes` and `preferredSymmAlg` must arrive without `infoValue`; `supportedLangTags` must arrive with the list of offered languages (if none is supported, `badRequest`); `crlStatusList` must carry at least one `CRLStatus` entry. An enabled type whose data provider has nothing to return (for example, a DMS without a VA client for the CRL types, or a root with no newer update) answers with the absent `infoValue` — a valid *not available* per the RFC, not an error. The type `id-it-revPassphrase` (RFC 4210bis §5.3.19.9) is permanently disabled: it is not wired into the revocation flow."},"1079":{"id":"/docs/pr-preview/pr-24/platform/pki/cmp-268","page_id":"/docs/pr-preview/pr-24/platform/pki/cmp","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/cmp#ccr--cross-certification-request","content":"Cross-certification between CAs (RFC 4210bis §5.3.11): a CA asks the DMS's enrollment CA for a cross-certificate for its identity. It is a privileged CA-to-CA operation, **disabled by default**."},"1080":{"id":"/docs/pr-preview/pr-24/platform/pki/cmp-269","page_id":"/docs/pr-preview/pr-24/platform/pki/cmp","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/cmp#ccr--cross-certification-request","content":"Field"},"1081":{"id":"/docs/pr-preview/pr-24/platform/pki/cmp-270","page_id":"/docs/pr-preview/pr-24/platform/pki/cmp","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/cmp#ccr--cross-certification-request","content":"Description"},"1082":{"id":"/docs/pr-preview/pr-24/platform/pki/cmp-271","page_id":"/docs/pr-preview/pr-24/platform/pki/cmp","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/cmp#ccr--cross-certification-request","content":"`enabled`"},"1083":{"id":"/docs/pr-preview/pr-24/platform/pki/cmp-272","page_id":"/docs/pr-preview/pr-24/platform/pki/cmp","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/cmp#ccr--cross-certification-request","content":"Enables the operation. Disabled by default."},"1084":{"id":"/docs/pr-preview/pr-24/platform/pki/cmp-273","page_id":"/docs/pr-preview/pr-24/platform/pki/cmp","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/cmp#ccr--cross-certification-request","content":"`workflow`"},"1085":{"id":"/docs/pr-preview/pr-24/platform/pki/cmp-274","page_id":"/docs/pr-preview/pr-24/platform/pki/cmp","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/cmp#ccr--cross-certification-request","content":"`administrator_approval` (default) or `direct`. It is independent of the general enrollment `workflow`: the administrative approval of a `ccr` is not mixed with that of `ir`/`cr`. With `administrator_approval`, the request stays `PENDING` (type `ccr`) and the requesting CA retrieves the cross-certificate with `pollReq`."},"1086":{"id":"/docs/pr-preview/pr-24/platform/pki/cmp-275","page_id":"/docs/pr-preview/pr-24/platform/pki/cmp","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/cmp#ccr--cross-certification-request","content":"`requester_mode`"},"1087":{"id":"/docs/pr-preview/pr-24/platform/pki/cmp-276","page_id":"/docs/pr-preview/pr-24/platform/pki/cmp","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/cmp#ccr--cross-certification-request","content":"`any` (default): any signer that passes `require_ca_certificate` may request. `restricted`: the signer must chain to a CA in `trusted_requester_ca_ids` — an empty list in `restricted` mode **authorizes nobody**."},"1088":{"id":"/docs/pr-preview/pr-24/platform/pki/cmp-277","page_id":"/docs/pr-preview/pr-24/platform/pki/cmp","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/cmp#ccr--cross-certification-request","content":"`trusted_requester_ca_ids`"},"1089":{"id":"/docs/pr-preview/pr-24/platform/pki/cmp-278","page_id":"/docs/pr-preview/pr-24/platform/pki/cmp","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/cmp#ccr--cross-certification-request","content":"CAs authorized in `restricted` mode."},"1090":{"id":"/docs/pr-preview/pr-24/platform/pki/cmp-279","page_id":"/docs/pr-preview/pr-24/platform/pki/cmp","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/cmp#ccr--cross-certification-request","content":"`require_ca_certificate`"},"1091":{"id":"/docs/pr-preview/pr-24/platform/pki/cmp-280","page_id":"/docs/pr-preview/pr-24/platform/pki/cmp","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/cmp#ccr--cross-certification-request","content":"Default `true`: the signer's protection certificate must be a CA certificate."},"1092":{"id":"/docs/pr-preview/pr-24/platform/pki/cmp-281","page_id":"/docs/pr-preview/pr-24/platform/pki/cmp","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/cmp#ccr--cross-certification-request","content":"`require_proof_of_possession`"},"1093":{"id":"/docs/pr-preview/pr-24/platform/pki/cmp-282","page_id":"/docs/pr-preview/pr-24/platform/pki/cmp","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/cmp#ccr--cross-certification-request","content":"Default `true`: requires a `POPOSigningKey` POPO over the `CertTemplate` key. `EncryptedKey` POPOs (which would disclose the requester's private key) are always rejected, with or without this option."},"1094":{"id":"/docs/pr-preview/pr-24/platform/pki/cmp-283","page_id":"/docs/pr-preview/pr-24/platform/pki/cmp","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/cmp#ccr--cross-certification-request","content":"`maximum_validity`"},"1095":{"id":"/docs/pr-preview/pr-24/platform/pki/cmp-284","page_id":"/docs/pr-preview/pr-24/platform/pki/cmp","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/cmp#ccr--cross-certification-request","content":"Maximum validity of the cross-certificate. Default &#x2A;*8760 hours (365 days)**. The requested `notBefore` is honored as-is (it may be in the past) and the `notAfter` is **truncated** to this limit, not rejected."},"1096":{"id":"/docs/pr-preview/pr-24/platform/pki/cmp-285","page_id":"/docs/pr-preview/pr-24/platform/pki/cmp","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/cmp#ccr--cross-certification-request","content":"`subject_constraints`"},"1097":{"id":"/docs/pr-preview/pr-24/platform/pki/cmp-286","page_id":"/docs/pr-preview/pr-24/platform/pki/cmp","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/cmp#ccr--cross-certification-request","content":"Identity constraints of the cross-certificate: `allowed_dn_patterns` (substring match of the subject in RFC 2253 format) and `allowed_dns_suffixes` (suffix match of the `dNSName` SAN). An empty list on a dimension imposes no constraint on that dimension — unlike the `central_key_generation` list, which denies everything when empty."},"1098":{"id":"/docs/pr-preview/pr-24/platform/pki/cmp-287","page_id":"/docs/pr-preview/pr-24/platform/pki/cmp","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/cmp#ccr--cross-certification-request","content":"`issuance_profile_id`"},"1099":{"id":"/docs/pr-preview/pr-24/platform/pki/cmp-288","page_id":"/docs/pr-preview/pr-24/platform/pki/cmp","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/cmp#ccr--cross-certification-request","content":"**Persisted but not yet enforced**: the cross-certificate is issued with a fixed internal profile (`CMP Cross Certification`), which produces a CA certificate with `keyCertSign`, `cRLSign` and `digitalSignature`."},"1100":{"id":"/docs/pr-preview/pr-24/platform/pki/cmp-289","page_id":"/docs/pr-preview/pr-24/platform/pki/cmp","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/cmp#ccr--cross-certification-request","content":"The `ccr` additionally requires: a complete `CertTemplate` (version, signature algorithm, issuer, validity, subject and public key; version v3 or v1, not v2), a signing-capable key (agreement-only keys such as X25519/X448 are rejected) and no request for server-side key generation. It is not intended for device enrollment, but for interoperability between PKIs."},"1101":{"id":"/docs/pr-preview/pr-24/platform/pki/cmp-290","page_id":"/docs/pr-preview/pr-24/platform/pki/cmp","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/cmp#server-side-key-generation-central-key-generation","content":"CMP allows the DMS itself to generate the device's key pair when the request (`ir`/`cr`) arrives with an empty public key in the `CertTemplate` (RFC 9483 §4.1.6, also called **KGA**, Key Generation Authority)."},"1102":{"id":"/docs/pr-preview/pr-24/platform/pki/cmp-291","page_id":"/docs/pr-preview/pr-24/platform/pki/cmp","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/cmp#server-side-key-generation-central-key-generation","content":"Field"},"1103":{"id":"/docs/pr-preview/pr-24/platform/pki/cmp-292","page_id":"/docs/pr-preview/pr-24/platform/pki/cmp","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/cmp#server-side-key-generation-central-key-generation","content":"Type"},"1104":{"id":"/docs/pr-preview/pr-24/platform/pki/cmp-293","page_id":"/docs/pr-preview/pr-24/platform/pki/cmp","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/cmp#server-side-key-generation-central-key-generation","content":"Description"},"1105":{"id":"/docs/pr-preview/pr-24/platform/pki/cmp-294","page_id":"/docs/pr-preview/pr-24/platform/pki/cmp","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/cmp#server-side-key-generation-central-key-generation","content":"`server_key_gen_enabled`"},"1106":{"id":"/docs/pr-preview/pr-24/platform/pki/cmp-295","page_id":"/docs/pr-preview/pr-24/platform/pki/cmp","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/cmp#server-side-key-generation-central-key-generation","content":"boolean"},"1107":{"id":"/docs/pr-preview/pr-24/platform/pki/cmp-296","page_id":"/docs/pr-preview/pr-24/platform/pki/cmp","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/cmp#server-side-key-generation-central-key-generation","content":"Enables server-side key generation. Disabled by default: a request with an empty public key is rejected with `notAuthorized`. This switch and the `central_key_generation.enabled` of `ir`/`cr` resolve into a single gate: enabling any of the three is enough, and the resulting value is written back to all three."},"1108":{"id":"/docs/pr-preview/pr-24/platform/pki/cmp-297","page_id":"/docs/pr-preview/pr-24/platform/pki/cmp","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/cmp#server-side-key-generation-central-key-generation","content":"`ckg_trusted_encryption_cas`"},"1109":{"id":"/docs/pr-preview/pr-24/platform/pki/cmp-298","page_id":"/docs/pr-preview/pr-24/platform/pki/cmp","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/cmp#server-side-key-generation-central-key-generation","content":"list of CA IDs"},"1110":{"id":"/docs/pr-preview/pr-24/platform/pki/cmp-299","page_id":"/docs/pr-preview/pr-24/platform/pki/cmp","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/cmp#server-side-key-generation-central-key-generation","content":"CAs the recipient certificate (the certificate the generated key is encrypted to — the requester's own protection certificate) must chain to. Empty by default: in that case the DMS's general trust boundary applies (the `EnrollmentCA` plus the validation CAs of `auth_mode` and of `reenrollment_settings.additional_validation_cas`). An explicit list **replaces** that boundary: the recipient must chain to one of the listed CAs. Recipient validation is unconditional, also with `auth_mode: NO_AUTH`: KGA delivers private key material, so it is a trust boundary independent of the authentication mode."},"1111":{"id":"/docs/pr-preview/pr-24/platform/pki/cmp-300","page_id":"/docs/pr-preview/pr-24/platform/pki/cmp","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/cmp#server-side-key-generation-central-key-generation","content":"The server flow: it generates the key with the algorithm implied by the request (RSA-2048 if the `CertTemplate` declares no algorithm; ECDSA P-256 if it declares ECC), issues the certificate through the normal enrollment path and returns in the same `ip`/`cp` response the certificate together with the PKCS#8 private key wrapped in a CMS `EnvelopedData`(`SignedData`(`AsymmetricKeyPackage`)) structure. The recipient is the requester's protection certificate: with an RSA key it uses key transport (`rsa_key_transport`), which requires `keyEncipherment` on the recipient; with an ECC key it uses ECDH key agreement (`ecdh_key_agreement`), which requires `keyAgreement`. A recipient outside the trust boundary is rejected with `signerNotTrusted`."},"1112":{"id":"/docs/pr-preview/pr-24/platform/pki/cmp-301","page_id":"/docs/pr-preview/pr-24/platform/pki/cmp","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/cmp#server-side-key-generation-central-key-generation","content":"The KGA-generated key is produced with the process's software cryptographic engine (not AWS KMS, PKCS#11 or any hardware Crypto Engine), because the key must be exportable in encrypted form to the device — something fundamentally incompatible with an HSM that never exposes private keys. The key exists in process memory only for the duration of the request and is never persisted: if the device loses the response, it cannot recover it with `pollReq` — it must repeat the enrollment with a new `transactionID`. For transport, the DMS also mints ephemeral helper certificates (`Lamassu CMP KGA Signer` with EKU `id-kp-cmKGA`, and `Lamassu CMP KARI Originator` for ECDH agreement), valid for one hour and signed by the enrollment CA. Prefer on-device key generation whenever possible; reserve KGA for devices that genuinely cannot generate their own key."},"1113":{"id":"/docs/pr-preview/pr-24/platform/pki/cmp-302","page_id":"/docs/pr-preview/pr-24/platform/pki/cmp","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/cmp#re-enrollment-configuration","content":"The `reenrollment_settings` section of the CMP block governs renewal (`kur`) with the same fields as EST:"},"1114":{"id":"/docs/pr-preview/pr-24/platform/pki/cmp-303","page_id":"/docs/pr-preview/pr-24/platform/pki/cmp","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/cmp#re-enrollment-configuration","content":"Field"},"1115":{"id":"/docs/pr-preview/pr-24/platform/pki/cmp-304","page_id":"/docs/pr-preview/pr-24/platform/pki/cmp","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/cmp#re-enrollment-configuration","content":"Effect in CMP"},"1116":{"id":"/docs/pr-preview/pr-24/platform/pki/cmp-305","page_id":"/docs/pr-preview/pr-24/platform/pki/cmp","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/cmp#re-enrollment-configuration","content":"`additional_validation_cas`"},"1117":{"id":"/docs/pr-preview/pr-24/platform/pki/cmp-306","page_id":"/docs/pr-preview/pr-24/platform/pki/cmp","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/cmp#re-enrollment-configuration","content":"Additional CAs accepted as issuers of the current certificate during renewal. It allows migrating to a new enrollment CA without interrupting the renewal of already-enrolled devices."},"1118":{"id":"/docs/pr-preview/pr-24/platform/pki/cmp-307","page_id":"/docs/pr-preview/pr-24/platform/pki/cmp","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/cmp#re-enrollment-configuration","content":"`revoke_on_reenrollment`"},"1119":{"id":"/docs/pr-preview/pr-24/platform/pki/cmp-308","page_id":"/docs/pr-preview/pr-24/platform/pki/cmp","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/cmp#re-enrollment-configuration","content":"Revokes the previous certificate with the reason `superseded` once the new one is issued and confirmed. In initial enrollment (`ir`/`cr`/`p10cr`) it controls whether replacing the identity revokes the previous certificate."},"1120":{"id":"/docs/pr-preview/pr-24/platform/pki/cmp-309","page_id":"/docs/pr-preview/pr-24/platform/pki/cmp","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/cmp#re-enrollment-configuration","content":"`enable_expired_renewal`"},"1121":{"id":"/docs/pr-preview/pr-24/platform/pki/cmp-310","page_id":"/docs/pr-preview/pr-24/platform/pki/cmp","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/cmp#re-enrollment-configuration","content":"Allows using an already-expired certificate as the protection credential of the `kur`."},"1122":{"id":"/docs/pr-preview/pr-24/platform/pki/cmp-311","page_id":"/docs/pr-preview/pr-24/platform/pki/cmp","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/cmp#re-enrollment-configuration","content":"`reenrollment_delta`"},"1123":{"id":"/docs/pr-preview/pr-24/platform/pki/cmp-312","page_id":"/docs/pr-preview/pr-24/platform/pki/cmp","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/cmp#re-enrollment-configuration","content":"**Not applied in CMP.** The pre-expiry window that limits EST's `/simplereenroll` does not restrict CMP's `kur`; the policy of when to renew is the device's."},"1124":{"id":"/docs/pr-preview/pr-24/platform/pki/cmp-313","page_id":"/docs/pr-preview/pr-24/platform/pki/cmp","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/cmp#re-enrollment-configuration","content":"`preventive_delta` / `critical_delta`"},"1125":{"id":"/docs/pr-preview/pr-24/platform/pki/cmp-314","page_id":"/docs/pr-preview/pr-24/platform/pki/cmp","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/cmp#re-enrollment-configuration","content":"Thresholds for preventive and critical renewal alerts. They are materialized on the certificate's metadata when the identity is bound, as in EST."},"1126":{"id":"/docs/pr-preview/pr-24/platform/pki/cmp-315","page_id":"/docs/pr-preview/pr-24/platform/pki/cmp","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/cmp#re-enrollment-configuration","content":"The `kur` key and identity policy (what may change and whether the key must rotate) lives in its per-operation block, described in Per-operation settings."},"1127":{"id":"/docs/pr-preview/pr-24/platform/pki/cmp-316","page_id":"/docs/pr-preview/pr-24/platform/pki/cmp","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/cmp#cmp-transactions","content":"Every `ir`/`cr`/`kur`/`p10cr`/`ccr` received by a DMS over CMP is recorded as a **CMP transaction**, identified by the hexadecimal `transactionID` of the `PKIHeader`. The record keeps the state, the issued certificate (without the DER in the API response), the proof-of-possession method used and the `auth_mode` in effect at enrollment time. When the WFX integration is active, each transaction transition is also reflected as a workflow job with the exchange messages attached — see WFX integration."},"1128":{"id":"/docs/pr-preview/pr-24/platform/pki/cmp-317","page_id":"/docs/pr-preview/pr-24/platform/pki/cmp","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/cmp#cmp-transactions","content":"State"},"1129":{"id":"/docs/pr-preview/pr-24/platform/pki/cmp-318","page_id":"/docs/pr-preview/pr-24/platform/pki/cmp","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/cmp#cmp-transactions","content":"Meaning"},"1130":{"id":"/docs/pr-preview/pr-24/platform/pki/cmp-319","page_id":"/docs/pr-preview/pr-24/platform/pki/cmp","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/cmp#cmp-transactions","content":"`PENDING`"},"1131":{"id":"/docs/pr-preview/pr-24/platform/pki/cmp-320","page_id":"/docs/pr-preview/pr-24/platform/pki/cmp","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/cmp#cmp-transactions","content":"Request accepted, awaiting issuance: a `phased` flow waiting for approval, or an `ir`/`cr` waiting for the `popdecr` of a challenge-response POPO."},"1132":{"id":"/docs/pr-preview/pr-24/platform/pki/cmp-321","page_id":"/docs/pr-preview/pr-24/platform/pki/cmp","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/cmp#cmp-transactions","content":"`ISSUED`"},"1133":{"id":"/docs/pr-preview/pr-24/platform/pki/cmp-322","page_id":"/docs/pr-preview/pr-24/platform/pki/cmp","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/cmp#cmp-transactions","content":"Certificate issued, awaiting the device's `certConf`."},"1134":{"id":"/docs/pr-preview/pr-24/platform/pki/cmp-323","page_id":"/docs/pr-preview/pr-24/platform/pki/cmp","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/cmp#cmp-transactions","content":"`CONFIRMED`"},"1135":{"id":"/docs/pr-preview/pr-24/platform/pki/cmp-324","page_id":"/docs/pr-preview/pr-24/platform/pki/cmp","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/cmp#cmp-transactions","content":"The device confirmed receipt with `certConf` (or implicit confirmation was granted). Terminal state."},"1136":{"id":"/docs/pr-preview/pr-24/platform/pki/cmp-325","page_id":"/docs/pr-preview/pr-24/platform/pki/cmp","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/cmp#cmp-transactions","content":"`ISSUE_FAILED`"},"1137":{"id":"/docs/pr-preview/pr-24/platform/pki/cmp-326","page_id":"/docs/pr-preview/pr-24/platform/pki/cmp","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/cmp#cmp-transactions","content":"The CA rejected issuance or an administrator rejected the transaction. The reason remains available to the device via `pollReq`. Terminal state."},"1138":{"id":"/docs/pr-preview/pr-24/platform/pki/cmp-327","page_id":"/docs/pr-preview/pr-24/platform/pki/cmp","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/cmp#cmp-transactions","content":"`REVOKED`"},"1139":{"id":"/docs/pr-preview/pr-24/platform/pki/cmp-328","page_id":"/docs/pr-preview/pr-24/platform/pki/cmp","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/cmp#cmp-transactions","content":"The issued certificate was revoked (by expiry of the confirmation window or by a later `rr`). Terminal state."},"1140":{"id":"/docs/pr-preview/pr-24/platform/pki/cmp-329","page_id":"/docs/pr-preview/pr-24/platform/pki/cmp","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/cmp#cmp-transactions","content":"Internally, the server also uses the transient states `APPROVING` and `REVOKING` as lock markers while it resolves an administrative approval or a revocation: they usually last only instants and could only be observed if the service is interrupted mid-operation, in which case the monitoring job finalizes them automatically. The states exposed by the listing API are only the five above."},"1141":{"id":"/docs/pr-preview/pr-24/platform/pki/cmp-330","page_id":"/docs/pr-preview/pr-24/platform/pki/cmp","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/cmp#cmp-transactions","content":"Endpoint"},"1142":{"id":"/docs/pr-preview/pr-24/platform/pki/cmp-331","page_id":"/docs/pr-preview/pr-24/platform/pki/cmp","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/cmp#cmp-transactions","content":"Description"},"1143":{"id":"/docs/pr-preview/pr-24/platform/pki/cmp-332","page_id":"/docs/pr-preview/pr-24/platform/pki/cmp","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/cmp#cmp-transactions","content":"`GET /v1/dms/{id}/cmp/transactions`"},"1144":{"id":"/docs/pr-preview/pr-24/platform/pki/cmp-333","page_id":"/docs/pr-preview/pr-24/platform/pki/cmp","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/cmp#cmp-transactions","content":"Paginated list of the DMS's transactions (`page_size`, `bookmark`, `sort_by`, `sort_mode` with values `asc`/`desc`, `filter`). It does not include the certificate DER; retrieve it from the CAs API using `certificate_serial_number`."},"1145":{"id":"/docs/pr-preview/pr-24/platform/pki/cmp-334","page_id":"/docs/pr-preview/pr-24/platform/pki/cmp","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/cmp#cmp-transactions","content":"`POST /v1/dms/{id}/cmp/transactions/{txid}/approve`"},"1146":{"id":"/docs/pr-preview/pr-24/platform/pki/cmp-335","page_id":"/docs/pr-preview/pr-24/platform/pki/cmp","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/cmp#cmp-transactions","content":"Approves a `PENDING` transaction of a `phased`-flow DMS, issuing the certificate. The device retrieves it in its next `pollReq`. Approval and rejection use an atomic claim of the record, so two concurrent calls do not issue the certificate twice. After approval, the device's confirmation window becomes that of `confirmation_timeout` (minimum 2 minutes)."},"1147":{"id":"/docs/pr-preview/pr-24/platform/pki/cmp-336","page_id":"/docs/pr-preview/pr-24/platform/pki/cmp","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/cmp#cmp-transactions","content":"`POST /v1/dms/{id}/cmp/transactions/{txid}/reject`"},"1148":{"id":"/docs/pr-preview/pr-24/platform/pki/cmp-337","page_id":"/docs/pr-preview/pr-24/platform/pki/cmp","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/cmp#cmp-transactions","content":"Rejects a `PENDING` transaction; it moves to `ISSUE_FAILED` with an optional reason (`{\"reason\": \"...\"}`; default `transaction rejected by administrator`) that the device receives in its next `pollReq`."},"1149":{"id":"/docs/pr-preview/pr-24/platform/pki/cmp-338","page_id":"/docs/pr-preview/pr-24/platform/pki/cmp","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/cmp#cmp-transactions","content":"Both operations require the **read** permission for the listing and the **update** permission to approve or reject, within the DMS's actions. Approvals and rejections only affect `PENDING` transactions: in `workflow: direct` a transaction is born already in `ISSUED`."},"1150":{"id":"/docs/pr-preview/pr-24/platform/pki/cmp-339","page_id":"/docs/pr-preview/pr-24/platform/pki/cmp","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/cmp#confirmation-monitor","content":"An `ISSUED` certificate that the device never confirms within `confirmation_timeout` is, by RFC 4210 §5.2.8's definition, in a state of indeterminate trust. A periodic background job — enabled and scheduled through the DMS Manager service configuration key `cmp_confirmation_monitoring_job` (`enabled`, `frequency`; every 5 seconds by default when global monitoring is active) — takes care of:"},"1151":{"id":"/docs/pr-preview/pr-24/platform/pki/cmp-340","page_id":"/docs/pr-preview/pr-24/platform/pki/cmp","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/cmp#confirmation-monitor","content":"**Revoking unconfirmed certificates**: `ISSUED` transactions whose confirmation window expired are revoked at the CA with the reason `cessationOfOperation` and move to `REVOKED`. The atomic claim of the record prevents revoking a certificate that a legitimate `certConf` is confirming at that exact moment."},"1152":{"id":"/docs/pr-preview/pr-24/platform/pki/cmp-341","page_id":"/docs/pr-preview/pr-24/platform/pki/cmp","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/cmp#confirmation-monitor","content":"**Closing pending approvals**: `PENDING` transactions in `phased` flow that no administrator resolved within `approval_timeout` move to `ISSUE_FAILED` with the reason `approval window expired`, and are kept for **7 days** so a late `pollReq` can still see the rejection reason."},"1153":{"id":"/docs/pr-preview/pr-24/platform/pki/cmp-342","page_id":"/docs/pr-preview/pr-24/platform/pki/cmp","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/cmp#confirmation-monitor","content":"Each run processes at most **100 transactions** per batch, to avoid a burst of revocations after a prolonged service interruption."},"1154":{"id":"/docs/pr-preview/pr-24/platform/pki/cmp-343","page_id":"/docs/pr-preview/pr-24/platform/pki/cmp","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/cmp#wfx-integration-optional","content":"If the service's WFX client is enabled (`wfx.enabled` in the DMS Manager configuration), every transition of a CMP transaction is reflected as a job in WFX (Siemens' workflow engine), under two predefined templates depending on the DMS's `workflow`: `lamassu.cmp.transaction.direct.v1` for the direct flow and `lamassu.cmp.transaction.phased.v1` for the flow with administrative approval (which adds the `AwaitingApproval` state). The workflow states — `Received`, `Validated`, `Responded`, `AwaitingCertConf`, `Confirmed`, `LogicallyComplete` (implicit confirmation) and `Rejected` — let you follow the lifecycle of each transaction from the WFX console; the job is identified by the device's CN and attaches the base64-encoded exchange messages. This is purely external observability/orchestration: if WFX is not enabled, or if a call to WFX fails, the CMP operation in Lamassu is unaffected."},"1155":{"id":"/docs/pr-preview/pr-24/platform/pki/cmp-344","page_id":"/docs/pr-preview/pr-24/platform/pki/cmp","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/cmp#verify-the-configuration","content":"**From the console**: open the DMS detail and check that the CMP section shows the active protocol, the enrollment CA, the protection certificate and the enabled operations."},"1156":{"id":"/docs/pr-preview/pr-24/platform/pki/cmp-345","page_id":"/docs/pr-preview/pr-24/platform/pki/cmp","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/cmp#verify-the-configuration","content":"**With the transaction listing**: `GET /v1/dms/{id}/cmp/transactions` confirms the endpoint responds even without device traffic."},"1157":{"id":"/docs/pr-preview/pr-24/platform/pki/cmp-346","page_id":"/docs/pr-preview/pr-24/platform/pki/cmp","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/cmp#verify-the-configuration","content":"**With a test request**: use `openssl cmp` with the `ir` command (if you have a valid signer) or `genm` against the DMS's endpoint — see Example with openssl cmp."},"1158":{"id":"/docs/pr-preview/pr-24/platform/pki/cmp-347","page_id":"/docs/pr-preview/pr-24/platform/pki/cmp","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/cmp#device-integration","content":"*This section is aimed at the device integrator.*"},"1159":{"id":"/docs/pr-preview/pr-24/platform/pki/cmp-348","page_id":"/docs/pr-preview/pr-24/platform/pki/cmp","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/cmp#before-you-begin","content":"The PKI administrator must have configured a DMS with the `CMP_RFC9483` protocol, an enrollment CA, a protection certificate and an authentication mode. The details of that configuration are in the DMS configuration section of this same page."},"1160":{"id":"/docs/pr-preview/pr-24/platform/pki/cmp-349","page_id":"/docs/pr-preview/pr-24/platform/pki/cmp","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/cmp#before-you-begin","content":"Before the first call, make sure you have:"},"1161":{"id":"/docs/pr-preview/pr-24/platform/pki/cmp-350","page_id":"/docs/pr-preview/pr-24/platform/pki/cmp","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/cmp#before-you-begin","content":"Item"},"1162":{"id":"/docs/pr-preview/pr-24/platform/pki/cmp-351","page_id":"/docs/pr-preview/pr-24/platform/pki/cmp","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/cmp#before-you-begin","content":"Description"},"1163":{"id":"/docs/pr-preview/pr-24/platform/pki/cmp-352","page_id":"/docs/pr-preview/pr-24/platform/pki/cmp","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/cmp#before-you-begin","content":"**CMP host URL**"},"1164":{"id":"/docs/pr-preview/pr-24/platform/pki/cmp-353","page_id":"/docs/pr-preview/pr-24/platform/pki/cmp","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/cmp#before-you-begin","content":"Base address of the server, for example `https://cmp.lamassu.example`. Provided by the PKI administrator."},"1165":{"id":"/docs/pr-preview/pr-24/platform/pki/cmp-354","page_id":"/docs/pr-preview/pr-24/platform/pki/cmp","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/cmp#before-you-begin","content":"**DMS ID**"},"1166":{"id":"/docs/pr-preview/pr-24/platform/pki/cmp-355","page_id":"/docs/pr-preview/pr-24/platform/pki/cmp","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/cmp#before-you-begin","content":"Identifier of the DMS, included in the endpoint path (`/.well-known/cmp/p/{id}`)."},"1167":{"id":"/docs/pr-preview/pr-24/platform/pki/cmp-356","page_id":"/docs/pr-preview/pr-24/platform/pki/cmp","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/cmp#before-you-begin","content":"**Message signing certificate and key**"},"1168":{"id":"/docs/pr-preview/pr-24/platform/pki/cmp-357","page_id":"/docs/pr-preview/pr-24/platform/pki/cmp","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/cmp#before-you-begin","content":"Only for the `CLIENT_CERTIFICATE` and `CLIENT_CERTIFICATE_AND_EXTERNAL_WEBHOOK` modes (and always for `kur`/`rr`). Unlike EST, it is not used as an mTLS credential: it is included as `extraCerts[0]` and signs the `PKIMessage`."},"1169":{"id":"/docs/pr-preview/pr-24/platform/pki/cmp-358","page_id":"/docs/pr-preview/pr-24/platform/pki/cmp","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/cmp#before-you-begin","content":"**DMS protection certificate**"},"1170":{"id":"/docs/pr-preview/pr-24/platform/pki/cmp-359","page_id":"/docs/pr-preview/pr-24/platform/pki/cmp","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/cmp#before-you-begin","content":"The certificate with which the DMS signs its responses. Clients that pin the responder's identity (for example `openssl cmp -srvcert`) need it."},"1171":{"id":"/docs/pr-preview/pr-24/platform/pki/cmp-360","page_id":"/docs/pr-preview/pr-24/platform/pki/cmp","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/cmp#the-cmp-endpoint","content":"CMP is served from a **single endpoint**:"},"1172":{"id":"/docs/pr-preview/pr-24/platform/pki/cmp-361","page_id":"/docs/pr-preview/pr-24/platform/pki/cmp","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/cmp#the-cmp-endpoint","content":"where `{id}` is the DMS identifier. The path follows the *well-known* URI format of RFC 9480 §3.3, so standard CMP clients recognize it without additional configuration (`openssl cmp -server <host> -path /.well-known/cmp/p/<dms-id>`)."},"1173":{"id":"/docs/pr-preview/pr-24/platform/pki/cmp-362","page_id":"/docs/pr-preview/pr-24/platform/pki/cmp","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/cmp#the-cmp-endpoint","content":"**Content-Type**: `application/pkixcmp` in both the request and the response. A request with a different `Content-Type` is rejected with `415 Unsupported Media Type`."},"1174":{"id":"/docs/pr-preview/pr-24/platform/pki/cmp-363","page_id":"/docs/pr-preview/pr-24/platform/pki/cmp","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/cmp#the-cmp-endpoint","content":"**Body**: a `PKIMessage` in binary DER (not base64, unlike the EST endpoints). The response is equally binary DER."},"1175":{"id":"/docs/pr-preview/pr-24/platform/pki/cmp-364","page_id":"/docs/pr-preview/pr-24/platform/pki/cmp","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/cmp#the-cmp-endpoint","content":"**Dispatch by content, not by path**: the server decodes the `PKIMessage`, validates the envelope (protocol version, `transactionID`, `senderNonce`, `messageTime`) and dispatches the operation according to the `PKIBody` tag — `ir`, `cr`, `p10cr`, `kur`, `rr`, `certConf`, `pollReq`, `genm`, `ccr`, `nested`, etc."},"1176":{"id":"/docs/pr-preview/pr-24/platform/pki/cmp-365","page_id":"/docs/pr-preview/pr-24/platform/pki/cmp","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/cmp#the-cmp-endpoint","content":"**No transport-layer authentication**: the endpoint requires neither mTLS nor authorization headers; all authentication travels inside the message, as described in Authentication model."},"1177":{"id":"/docs/pr-preview/pr-24/platform/pki/cmp-366","page_id":"/docs/pr-preview/pr-24/platform/pki/cmp","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/cmp#the-cmp-endpoint","content":"**Maximum request size**: 1 MiB. A larger request is rejected before decoding is attempted."},"1178":{"id":"/docs/pr-preview/pr-24/platform/pki/cmp-367","page_id":"/docs/pr-preview/pr-24/platform/pki/cmp","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/cmp#the-cmp-endpoint","content":"A rejection arrives with `HTTP 200` in the form corresponding to the operation: as an error `PKIMessage` for failures before dispatch (operation disabled, invalid header, failed protection), as a rejection body inside the operation's own response (`ip`/`cp`/`kup` with `status: rejection`) for issuance policy failures, or as an `rp` body with a rejection status for revocations. In all cases you must inspect the CMP body, not just the HTTP code. The HTTP error codes (`400`, `415` and, for internal server failures, `500`) are reserved for cases where a valid CMP response cannot be delivered — see Error codes and diagnostics."},"1179":{"id":"/docs/pr-preview/pr-24/platform/pki/cmp-368","page_id":"/docs/pr-preview/pr-24/platform/pki/cmp","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/cmp#authentication-model","content":"CMP authenticates **the message**, not the connection: there is no mTLS handshake equivalent to EST's. When the DMS's `auth_mode` requires `CLIENT_CERTIFICATE`, the device must:"},"1180":{"id":"/docs/pr-preview/pr-24/platform/pki/cmp-369","page_id":"/docs/pr-preview/pr-24/platform/pki/cmp","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/cmp#authentication-model","content":"Include its certificate in the `PKIMessage`'s `extraCerts` field (first position)."},"1181":{"id":"/docs/pr-preview/pr-24/platform/pki/cmp-370","page_id":"/docs/pr-preview/pr-24/platform/pki/cmp","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/cmp#authentication-model","content":"Sign the entire `PKIMessage` with the private key corresponding to that certificate (signature-based protection, RFC 9483 §3.2)."},"1182":{"id":"/docs/pr-preview/pr-24/platform/pki/cmp-371","page_id":"/docs/pr-preview/pr-24/platform/pki/cmp","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/cmp#authentication-model","content":"On top of the protected message, the server additionally enforces two RFC 9483 bindings: the header's `sender` field must match the protection certificate's subject, and the `senderKID` must be its `SubjectKeyIdentifier`. A protected request that violates either is rejected with `badMessageCheck`. If a message carries a signature even though the mode does not require one, the signature is still verified and those bindings apply."},"1183":{"id":"/docs/pr-preview/pr-24/platform/pki/cmp-372","page_id":"/docs/pr-preview/pr-24/platform/pki/cmp","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/cmp#authentication-model","content":"The protection requirement per message type:"},"1184":{"id":"/docs/pr-preview/pr-24/platform/pki/cmp-373","page_id":"/docs/pr-preview/pr-24/platform/pki/cmp","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/cmp#authentication-model","content":"Message"},"1185":{"id":"/docs/pr-preview/pr-24/platform/pki/cmp-374","page_id":"/docs/pr-preview/pr-24/platform/pki/cmp","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/cmp#authentication-model","content":"Protection mandatory?"},"1186":{"id":"/docs/pr-preview/pr-24/platform/pki/cmp-375","page_id":"/docs/pr-preview/pr-24/platform/pki/cmp","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/cmp#authentication-model","content":"`ir`, `cr`, `p10cr`"},"1187":{"id":"/docs/pr-preview/pr-24/platform/pki/cmp-376","page_id":"/docs/pr-preview/pr-24/platform/pki/cmp","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/cmp#authentication-model","content":"Only if `auth_mode` is `CLIENT_CERTIFICATE` or `CLIENT_CERTIFICATE_AND_EXTERNAL_WEBHOOK`"},"1188":{"id":"/docs/pr-preview/pr-24/platform/pki/cmp-377","page_id":"/docs/pr-preview/pr-24/platform/pki/cmp","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/cmp#authentication-model","content":"`kur`"},"1189":{"id":"/docs/pr-preview/pr-24/platform/pki/cmp-378","page_id":"/docs/pr-preview/pr-24/platform/pki/cmp","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/cmp#authentication-model","content":"Always (the signature is the renewal's proof of possession)"},"1190":{"id":"/docs/pr-preview/pr-24/platform/pki/cmp-379","page_id":"/docs/pr-preview/pr-24/platform/pki/cmp","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/cmp#authentication-model","content":"`rr`"},"1191":{"id":"/docs/pr-preview/pr-24/platform/pki/cmp-380","page_id":"/docs/pr-preview/pr-24/platform/pki/cmp","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/cmp#authentication-model","content":"Always (the signature is what authorizes the revocation)"},"1192":{"id":"/docs/pr-preview/pr-24/platform/pki/cmp-381","page_id":"/docs/pr-preview/pr-24/platform/pki/cmp","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/cmp#authentication-model","content":"`genm`"},"1193":{"id":"/docs/pr-preview/pr-24/platform/pki/cmp-382","page_id":"/docs/pr-preview/pr-24/platform/pki/cmp","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/cmp#authentication-model","content":"Depending on `access_policy`: `public_discovery` admits unprotected messages; `require_signed` demands a signature"},"1194":{"id":"/docs/pr-preview/pr-24/platform/pki/cmp-383","page_id":"/docs/pr-preview/pr-24/platform/pki/cmp","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/cmp#authentication-model","content":"`certConf`, `pollReq`, `popdecr`, `nested`"},"1195":{"id":"/docs/pr-preview/pr-24/platform/pki/cmp-384","page_id":"/docs/pr-preview/pr-24/platform/pki/cmp","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/cmp#authentication-model","content":"Follow the DMS's `auth_mode` rule"},"1196":{"id":"/docs/pr-preview/pr-24/platform/pki/cmp-385","page_id":"/docs/pr-preview/pr-24/platform/pki/cmp","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/cmp#authentication-model","content":"At the service layer, the protection certificate must chain to a CA declared in `client_certificate_settings.validation_cas` (or, in `kur`, to the enrollment CA and the additional re-enrollment CAs), with the same chain-depth and expired-certificate tolerance parameters as EST, and its revocation status is checked as in the EST flow. In addition, a certificate that was a device's identity remains subject to the identity's state: while a key update is pending confirmation it cannot start new operations, and once the replacement is confirmed it stops being usable as a credential (`certRevoked`). A certificate that is no device's identity (for example, a bootstrap signer) passes without those checks."},"1197":{"id":"/docs/pr-preview/pr-24/platform/pki/cmp-386","page_id":"/docs/pr-preview/pr-24/platform/pki/cmp","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/cmp#supported-operations","content":"Operation"},"1198":{"id":"/docs/pr-preview/pr-24/platform/pki/cmp-387","page_id":"/docs/pr-preview/pr-24/platform/pki/cmp","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/cmp#supported-operations","content":"Use"},"1199":{"id":"/docs/pr-preview/pr-24/platform/pki/cmp-388","page_id":"/docs/pr-preview/pr-24/platform/pki/cmp","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/cmp#supported-operations","content":"Requires prior identity"},"1200":{"id":"/docs/pr-preview/pr-24/platform/pki/cmp-389","page_id":"/docs/pr-preview/pr-24/platform/pki/cmp","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/cmp#supported-operations","content":"`ir`"},"1201":{"id":"/docs/pr-preview/pr-24/platform/pki/cmp-390","page_id":"/docs/pr-preview/pr-24/platform/pki/cmp","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/cmp#supported-operations","content":"Initial enrollment of a new device."},"1202":{"id":"/docs/pr-preview/pr-24/platform/pki/cmp-391","page_id":"/docs/pr-preview/pr-24/platform/pki/cmp","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/cmp#supported-operations","content":"No"},"1203":{"id":"/docs/pr-preview/pr-24/platform/pki/cmp-392","page_id":"/docs/pr-preview/pr-24/platform/pki/cmp","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/cmp#supported-operations","content":"`cr`"},"1204":{"id":"/docs/pr-preview/pr-24/platform/pki/cmp-393","page_id":"/docs/pr-preview/pr-24/platform/pki/cmp","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/cmp#supported-operations","content":"Additional or replacement issuance for an already-identified device."},"1205":{"id":"/docs/pr-preview/pr-24/platform/pki/cmp-394","page_id":"/docs/pr-preview/pr-24/platform/pki/cmp","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/cmp#supported-operations","content":"Yes (if `require_existing_device`)"},"1206":{"id":"/docs/pr-preview/pr-24/platform/pki/cmp-395","page_id":"/docs/pr-preview/pr-24/platform/pki/cmp","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/cmp#supported-operations","content":"`p10cr`"},"1207":{"id":"/docs/pr-preview/pr-24/platform/pki/cmp-396","page_id":"/docs/pr-preview/pr-24/platform/pki/cmp","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/cmp#supported-operations","content":"Enrollment with a PKCS#10 CSR, without CRMF controls or KGA. Must be enabled on the DMS."},"1208":{"id":"/docs/pr-preview/pr-24/platform/pki/cmp-397","page_id":"/docs/pr-preview/pr-24/platform/pki/cmp","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/cmp#supported-operations","content":"No"},"1209":{"id":"/docs/pr-preview/pr-24/platform/pki/cmp-398","page_id":"/docs/pr-preview/pr-24/platform/pki/cmp","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/cmp#supported-operations","content":"`kur`"},"1210":{"id":"/docs/pr-preview/pr-24/platform/pki/cmp-399","page_id":"/docs/pr-preview/pr-24/platform/pki/cmp","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/cmp#supported-operations","content":"Renewal of a certificate; the message is signed with the current certificate."},"1211":{"id":"/docs/pr-preview/pr-24/platform/pki/cmp-400","page_id":"/docs/pr-preview/pr-24/platform/pki/cmp","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/cmp#supported-operations","content":"Yes (the certificate being renewed)"},"1212":{"id":"/docs/pr-preview/pr-24/platform/pki/cmp-401","page_id":"/docs/pr-preview/pr-24/platform/pki/cmp","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/cmp#supported-operations","content":"`rr`"},"1213":{"id":"/docs/pr-preview/pr-24/platform/pki/cmp-402","page_id":"/docs/pr-preview/pr-24/platform/pki/cmp","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/cmp#supported-operations","content":"Revocation of a certificate, always signed."},"1214":{"id":"/docs/pr-preview/pr-24/platform/pki/cmp-403","page_id":"/docs/pr-preview/pr-24/platform/pki/cmp","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/cmp#supported-operations","content":"Yes"},"1215":{"id":"/docs/pr-preview/pr-24/platform/pki/cmp-404","page_id":"/docs/pr-preview/pr-24/platform/pki/cmp","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/cmp#supported-operations","content":"`genm`/`genp`"},"1216":{"id":"/docs/pr-preview/pr-24/platform/pki/cmp-405","page_id":"/docs/pr-preview/pr-24/platform/pki/cmp","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/cmp#supported-operations","content":"Query of the DMS's capabilities (CAs, key types, current CRL, etc.). Issues no certificates."},"1217":{"id":"/docs/pr-preview/pr-24/platform/pki/cmp-406","page_id":"/docs/pr-preview/pr-24/platform/pki/cmp","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/cmp#supported-operations","content":"No"},"1218":{"id":"/docs/pr-preview/pr-24/platform/pki/cmp-407","page_id":"/docs/pr-preview/pr-24/platform/pki/cmp","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/cmp#supported-operations","content":"`ccr`/`ccp`"},"1219":{"id":"/docs/pr-preview/pr-24/platform/pki/cmp-408","page_id":"/docs/pr-preview/pr-24/platform/pki/cmp","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/cmp#supported-operations","content":"Cross-certification between CAs. For CA operators only, disabled by default."},"1220":{"id":"/docs/pr-preview/pr-24/platform/pki/cmp-409","page_id":"/docs/pr-preview/pr-24/platform/pki/cmp","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/cmp#supported-operations","content":"The signer must be a CA"},"1221":{"id":"/docs/pr-preview/pr-24/platform/pki/cmp-410","page_id":"/docs/pr-preview/pr-24/platform/pki/cmp","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/cmp#supported-operations","content":"`nested`"},"1222":{"id":"/docs/pr-preview/pr-24/platform/pki/cmp-411","page_id":"/docs/pr-preview/pr-24/platform/pki/cmp","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/cmp#supported-operations","content":"Wrapper that adds an extra layer of protection (an RA countersigning a device) or groups several messages into a batch. Not an operation in itself."},"1223":{"id":"/docs/pr-preview/pr-24/platform/pki/cmp-412","page_id":"/docs/pr-preview/pr-24/platform/pki/cmp","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/cmp#supported-operations","content":"—"},"1224":{"id":"/docs/pr-preview/pr-24/platform/pki/cmp-413","page_id":"/docs/pr-preview/pr-24/platform/pki/cmp","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/cmp#supported-operations","content":"The protocol steps `certConf` (confirmation), `pollReq` (polling), `popdecc`/`popdecr` (challenge-response proof of possession) and `error` are part of the lifecycle of the operations above, not operations the integrator chooses separately."},"1225":{"id":"/docs/pr-preview/pr-24/platform/pki/cmp-414","page_id":"/docs/pr-preview/pr-24/platform/pki/cmp","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/cmp#ir-and-cr","content":"Both carry a `CertReqMessages` body with the certificate template (`CertTemplate`), the CRMF controls and the proof of possession. The subject may arrive empty (NULL-DN) as long as a `SubjectAltName` extension carries the identity; with neither subject nor SAN, the `ir` is rejected. Responses are `ip` for `ir` and `cp` for `cr`."},"1226":{"id":"/docs/pr-preview/pr-24/platform/pki/cmp-415","page_id":"/docs/pr-preview/pr-24/platform/pki/cmp","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/cmp#ir-and-cr","content":"Enrollment respects the DMS's registration mode: with `JITP`, the first request creates the device with the provisioning profile; with `PRE_REGISTRATION`, an unknown device is rejected with `device not preregistered`. Re-enrolling an already-enrolled device requires `enable_replaceable_enrollment` on the DMS (`forbiddenNewEnrollment` otherwise). The template restrictions are the same for both operations: Lamassu never issues CA certificates over CMP (`BasicConstraints cA=TRUE` → `notAuthorized`), using `keyCertSign` without being a CA or a `pathLenConstraint` in an end-entity template are `badCertTemplate`, and the accepted RSA range is 2048 to 8192 bits."},"1227":{"id":"/docs/pr-preview/pr-24/platform/pki/cmp-416","page_id":"/docs/pr-preview/pr-24/platform/pki/cmp","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/cmp#ir-and-cr","content":"If the DMS's issuance profile drops a **critical** extension requested by the `CertTemplate`, the response arrives with status `grantedWithMods` (1) instead of `accepted` (0): the integrator must compare the issued certificate with what was requested, not assume that acceptance implies an exact match."},"1228":{"id":"/docs/pr-preview/pr-24/platform/pki/cmp-417","page_id":"/docs/pr-preview/pr-24/platform/pki/cmp","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/cmp#ir-and-cr","content":"The CRMF controls, when the DMS requires them, go in the request: `id-regCtrl-regToken` (RFC 4211 §6.1) if the DMS's mode requires it — a one-use value consumed even if issuance later fails — and `id-regCtrl-authenticator` (§6.2) if the DMS configured an expected answer. A control present when the DMS has it disabled, or absent when it is mandatory, is rejected with `badRequest`."},"1229":{"id":"/docs/pr-preview/pr-24/platform/pki/cmp-418","page_id":"/docs/pr-preview/pr-24/platform/pki/cmp","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/cmp#kur","content":"The message carries the template of the renewed certificate and is **protected by signature with the certificate being renewed** — that signature is the proof of possession. With `key_policy: require_new_key`, the public key must differ from the current one; with `identity_change_policy: forbid`, the subject and the SAN must match the current certificate (`san_only` allows changing the SAN; `subject_and_san` allows both changes). The response is `kup`."},"1230":{"id":"/docs/pr-preview/pr-24/platform/pki/cmp-419","page_id":"/docs/pr-preview/pr-24/platform/pki/cmp","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/cmp#kur","content":"The exchange stays pending until the `certConf`: until the device confirms, the previous certificate remains the device's active identity and can keep being used; the new one is bound and the previous one is revoked as `superseded` only upon confirmation (or immediately if implicit confirmation was negotiated). The optional `id-regCtrl-oldCertID` control must reference the certificate being renewed."},"1231":{"id":"/docs/pr-preview/pr-24/platform/pki/cmp-420","page_id":"/docs/pr-preview/pr-24/platform/pki/cmp","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/cmp#p10cr","content":"The body is a complete PKCS#10 CSR. The CSR's signature over its own `CertificationRequestInfo` is the proof of possession and is always verified. The signature algorithm policy follows RFC 9481 §3: RSA, RSA-PSS, ECDSA or Ed25519 with SHA-256/384/512; those signed with SHA-1, SHA-224, MD5 or DSA are rejected with `badPOP`, and an unknown algorithm is rejected with `badAlg`. The response is a `cp` with `certReqId` `-1`, and the subsequent `certConf` must carry that same value."},"1232":{"id":"/docs/pr-preview/pr-24/platform/pki/cmp-421","page_id":"/docs/pr-preview/pr-24/platform/pki/cmp","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/cmp#rr","content":"The body carries `RevReqContent` with the `CertTemplate` of the certificate to revoke and the reason. The message signature must be from the revoked certificate itself (self-revocation) or from a trusted RA entity (EKU `id-kp-cmcRA`, validated against the DMS's CAs according to `trusted_ra`). The fields of the `CertTemplate` — issuer, serial number, subject, public key and extensions — must match the presented certificate. The reason `certificateHold` suspends the certificate (and is not subject to the allowed-reasons list); the reason `removeFromCRL` does not revoke: it asks to reactivate a previously revoked certificate — only possible if that revocation was a suspension —, an operation the DMS must have enabled with `allow_revival`."},"1233":{"id":"/docs/pr-preview/pr-24/platform/pki/cmp-422","page_id":"/docs/pr-preview/pr-24/platform/pki/cmp","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/cmp#rr","content":"The response is always an `rp` — both on success (`Certificate revoked` / `Certificate revived`) and on rejection, with the reason in its `PKIStatusInfo`."},"1234":{"id":"/docs/pr-preview/pr-24/platform/pki/cmp-423","page_id":"/docs/pr-preview/pr-24/platform/pki/cmp","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/cmp#genm","content":"The body is a sequence of `InfoTypeAndValue`; the response is a `genp` with one entry per request. See the information types table to know what each DMS advertises. The infrastructure-dependent types (CRL) require the administrator to have configured a VA client on the DMS Manager service."},"1235":{"id":"/docs/pr-preview/pr-24/platform/pki/cmp-424","page_id":"/docs/pr-preview/pr-24/platform/pki/cmp","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/cmp#ccr","content":"Reserved for CA operators. The signer must be a CA certificate and the template must be complete. With `workflow: administrator_approval` (the default), the first response is a waiting `ccp` and the cross-certificate is retrieved with `pollReq` once approved. The requested validity is honored up to the DMS's `maximum_validity` limit."},"1236":{"id":"/docs/pr-preview/pr-24/platform/pki/cmp-425","page_id":"/docs/pr-preview/pr-24/platform/pki/cmp","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/cmp#certconf-and-pollreq","content":"`certConf` closes the cycle of an issuance with explicit confirmation. Main rules:"},"1237":{"id":"/docs/pr-preview/pr-24/platform/pki/cmp-426","page_id":"/docs/pr-preview/pr-24/platform/pki/cmp","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/cmp#certconf-and-pollreq","content":"It must carry **exactly one** `CertStatus`, with `certReqId` `0` for `ir`/`cr`/`kur` and `-1` for `p10cr`."},"1238":{"id":"/docs/pr-preview/pr-24/platform/pki/cmp-427","page_id":"/docs/pr-preview/pr-24/platform/pki/cmp","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/cmp#certconf-and-pollreq","content":"The `certHash` is verified against the issued certificate; without `hashAlg`, the digest dictated by RFC 9481 §3.3 according to the certificate's own signature algorithm is used (SHA-256, except for certificates signed with SHA-384/512 or Ed25519), and declaring a `hashAlg` requires `pvno` `cmp2021(3)`."},"1239":{"id":"/docs/pr-preview/pr-24/platform/pki/cmp-428","page_id":"/docs/pr-preview/pr-24/platform/pki/cmp","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/cmp#certconf-and-pollreq","content":"It must be protected with **the credential of the original request**, not with the freshly issued certificate."},"1240":{"id":"/docs/pr-preview/pr-24/platform/pki/cmp-429","page_id":"/docs/pr-preview/pr-24/platform/pki/cmp","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/cmp#certconf-and-pollreq","content":"The `recipNonce` must return the response's `senderNonce`, and its own `senderNonce` must be new (reusing the one from the initial request is `badSenderNonce`)."},"1241":{"id":"/docs/pr-preview/pr-24/platform/pki/cmp-430","page_id":"/docs/pr-preview/pr-24/platform/pki/cmp","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/cmp#certconf-and-pollreq","content":"Confirming the same certificate twice answers with the error `certConfirmed`, useful after losing a `pkiConf`."},"1242":{"id":"/docs/pr-preview/pr-24/platform/pki/cmp-431","page_id":"/docs/pr-preview/pr-24/platform/pki/cmp","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/cmp#certconf-and-pollreq","content":"`pollReq` polls the transaction's state and supports two flows: lost-response recovery (the `ISSUED` certificate is re-delivered in the original `ip`/`cp`/`kup`, without consuming the transaction) and polling of the `phased` flow (while the transaction is `PENDING`, the response is a `pollRep` with the retry hint, 60 seconds by default). An `ISSUE_FAILED` transaction returns the failure reason and a `REVOKED` one indicates the enrollment must be repeated. The response of a transaction with server-side key generation **cannot be recovered**: the private key is never stored, so a `pollReq` on it is rejected and the device must repeat the enrollment with a new `transactionID`."},"1243":{"id":"/docs/pr-preview/pr-24/platform/pki/cmp-432","page_id":"/docs/pr-preview/pr-24/platform/pki/cmp","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/cmp#nested","content":"A `nested` (RFC 4210 §5.1.3) is an envelope whose body contains one or more `PKIMessage`. With **a single** inner message it is *added protection* (RFC 9483 §5.2.2.1): an RA wraps and countersigns an already-protected device request; the outer header must copy the inner `transactionID` and `senderNonce`, the inner protection is verified and the request is processed normally. With **two or more** messages it is a batch (§5.2.2.2): the outer header carries new `transactionID`/`senderNonce`, the protection of each inner message is verified before any is processed and the responses come back wrapped in a `nested`, in the same order. A `ccr` inside a `nested` is not re-expedited, and nesting inside a batch is not supported."},"1244":{"id":"/docs/pr-preview/pr-24/platform/pki/cmp-433","page_id":"/docs/pr-preview/pr-24/platform/pki/cmp","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/cmp#server-side-key-generation-kga","content":"When the DMS has `server_key_gen_enabled: true`, a device may send an `ir`/`cr` with an empty public key field in the `CertTemplate` to ask the server to generate the key pair. The mechanism and its limits are described in the configuration section; from the integrator's side:"},"1245":{"id":"/docs/pr-preview/pr-24/platform/pki/cmp-434","page_id":"/docs/pr-preview/pr-24/platform/pki/cmp","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/cmp#server-side-key-generation-kga","content":"The message's protection certificate acts as the recipient: RSA → `rsa_key_transport`, ECC → `ecdh_key_agreement`. The certificate's key and key usage must allow the chosen technique."},"1246":{"id":"/docs/pr-preview/pr-24/platform/pki/cmp-435","page_id":"/docs/pr-preview/pr-24/platform/pki/cmp","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/cmp#server-side-key-generation-kga","content":"The response (`ip`/`cp`) carries the issued certificate and the wrapped key in the same body; the PKCS#8 key travels inside `EnvelopedData`(`SignedData`(`AsymmetricKeyPackage`)) and the certificate to open the envelope with is in `extraCerts[0]`."},"1247":{"id":"/docs/pr-preview/pr-24/platform/pki/cmp-436","page_id":"/docs/pr-preview/pr-24/platform/pki/cmp","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/cmp#server-side-key-generation-kga","content":"The key is never stored on the server: if the response is lost, no `pollReq` can recover it — repeat the enrollment with a new `transactionID`."},"1248":{"id":"/docs/pr-preview/pr-24/platform/pki/cmp-437","page_id":"/docs/pr-preview/pr-24/platform/pki/cmp","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/cmp#server-side-key-generation-kga","content":"The subsequent `certConf` works the same as in an ordinary issuance."},"1249":{"id":"/docs/pr-preview/pr-24/platform/pki/cmp-438","page_id":"/docs/pr-preview/pr-24/platform/pki/cmp","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/cmp#example-with-openssl-cmp","content":"The following commands use OpenSSL's `cmp` client (≥ 3.0) against a DMS configured in `CLIENT_CERTIFICATE` mode."},"1250":{"id":"/docs/pr-preview/pr-24/platform/pki/cmp-439","page_id":"/docs/pr-preview/pr-24/platform/pki/cmp","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/cmp#example-with-openssl-cmp","content":"**Initial enrollment (`ir`)**, signing with a bootstrap certificate (`signer.crt`/`signer.key`) issued by one of the DMS's `validation_cas`, and generating a new key for the device:"},"1251":{"id":"/docs/pr-preview/pr-24/platform/pki/cmp-440","page_id":"/docs/pr-preview/pr-24/platform/pki/cmp","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/cmp#example-with-openssl-cmp","content":"`-tls_used` is necessary in OpenSSL 3.0.x when the server URL uses `https` without pinning the server certificate (`-srvcert`); versions ≥ 3.2 infer it automatically. `-unprotected_errors` allows accepting error responses that arrive unprotected (those whose protection algorithm is NULL); while the DMS has no `protection_certificate` configured, all its responses — including errors — go out unprotected, so this option keeps `openssl cmp` from discarding them."},"1252":{"id":"/docs/pr-preview/pr-24/platform/pki/cmp-441","page_id":"/docs/pr-preview/pr-24/platform/pki/cmp","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/cmp#example-with-openssl-cmp","content":"**Renewal (`kur`)**, authenticating with the device's current certificate:"},"1253":{"id":"/docs/pr-preview/pr-24/platform/pki/cmp-442","page_id":"/docs/pr-preview/pr-24/platform/pki/cmp","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/cmp#example-with-openssl-cmp","content":"`-srvcert` pins the certificate the DMS is expected to protect its response with (the **Protection Certificate** configured on the DMS). Without it, OpenSSL validates the response's protection against its own trust anchors; `-unprotected_errors` only covers unprotected error messages and does not replace `-srvcert` for successful responses."},"1254":{"id":"/docs/pr-preview/pr-24/platform/pki/cmp-443","page_id":"/docs/pr-preview/pr-24/platform/pki/cmp","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/cmp#next-steps-after-enrollment","content":"**Confirm the certificate**: unless `accept_implicit` is active on the DMS and the device requests it, the flow is not complete until the device sends `certConf`. `openssl cmp -cmd ir`/`kur` does it automatically; a manual integration must implement this step."},"1255":{"id":"/docs/pr-preview/pr-24/platform/pki/cmp-444","page_id":"/docs/pr-preview/pr-24/platform/pki/cmp","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/cmp#next-steps-after-enrollment","content":"**Plan the renewal**: schedule the `kur` before the certificate expires. Unlike EST, the `reenrollment_delta` window does not restrict CMP's `kur`, so the policy of when to renew is the device's."},"1256":{"id":"/docs/pr-preview/pr-24/platform/pki/cmp-445","page_id":"/docs/pr-preview/pr-24/platform/pki/cmp","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/cmp#next-steps-after-enrollment","content":"**`phased` flow**: if the DMS uses `workflow: phased` on the operation, the first response to `ir`/`cr`/`kur`/`p10cr` is a wait; the device must retry with `pollReq` until an administrator approves or rejects the transaction."},"1257":{"id":"/docs/pr-preview/pr-24/platform/pki/cmp-446","page_id":"/docs/pr-preview/pr-24/platform/pki/cmp","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/cmp#next-steps-after-enrollment","content":"**Recovering lost responses**: if a response did not arrive, repeat the operation with `pollReq` (the `ISSUED` certificate is re-delivered), except for transactions with server-side key generation, where the enrollment must be repeated."},"1258":{"id":"/docs/pr-preview/pr-24/platform/pki/cmp-447","page_id":"/docs/pr-preview/pr-24/platform/pki/cmp","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/cmp#error-codes-and-diagnostics","content":"An error `PKIMessage` returned with `HTTP 200` is the normal answer to a request rejected by policy (failed authentication, disabled operation, expired confirmation window, etc.). It is protected — signed with the protection certificate — if the DMS has one configured; otherwise it goes out unprotected, and strict clients like `openssl cmp` discard it unless `-unprotected_errors` is used. The HTTP error codes are reserved for failures where a response `PKIMessage` cannot be built."},"1259":{"id":"/docs/pr-preview/pr-24/platform/pki/cmp-448","page_id":"/docs/pr-preview/pr-24/platform/pki/cmp","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/cmp#error-codes-and-diagnostics","content":"HTTP"},"1260":{"id":"/docs/pr-preview/pr-24/platform/pki/cmp-449","page_id":"/docs/pr-preview/pr-24/platform/pki/cmp","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/cmp#error-codes-and-diagnostics","content":"Where the failure is"},"1261":{"id":"/docs/pr-preview/pr-24/platform/pki/cmp-450","page_id":"/docs/pr-preview/pr-24/platform/pki/cmp","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/cmp#error-codes-and-diagnostics","content":"Typical cause"},"1262":{"id":"/docs/pr-preview/pr-24/platform/pki/cmp-451","page_id":"/docs/pr-preview/pr-24/platform/pki/cmp","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/cmp#error-codes-and-diagnostics","content":"Integrator action"},"1263":{"id":"/docs/pr-preview/pr-24/platform/pki/cmp-452","page_id":"/docs/pr-preview/pr-24/platform/pki/cmp","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/cmp#error-codes-and-diagnostics","content":"415"},"1264":{"id":"/docs/pr-preview/pr-24/platform/pki/cmp-453","page_id":"/docs/pr-preview/pr-24/platform/pki/cmp","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/cmp#error-codes-and-diagnostics","content":"JSON error body"},"1265":{"id":"/docs/pr-preview/pr-24/platform/pki/cmp-454","page_id":"/docs/pr-preview/pr-24/platform/pki/cmp","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/cmp#error-codes-and-diagnostics","content":"`Content-Type` other than `application/pkixcmp`."},"1266":{"id":"/docs/pr-preview/pr-24/platform/pki/cmp-455","page_id":"/docs/pr-preview/pr-24/platform/pki/cmp","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/cmp#error-codes-and-diagnostics","content":"Set the correct header."},"1267":{"id":"/docs/pr-preview/pr-24/platform/pki/cmp-456","page_id":"/docs/pr-preview/pr-24/platform/pki/cmp","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/cmp#error-codes-and-diagnostics","content":"400"},"1268":{"id":"/docs/pr-preview/pr-24/platform/pki/cmp-457","page_id":"/docs/pr-preview/pr-24/platform/pki/cmp","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/cmp#error-codes-and-diagnostics","content":"No body"},"1269":{"id":"/docs/pr-preview/pr-24/platform/pki/cmp-458","page_id":"/docs/pr-preview/pr-24/platform/pki/cmp","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/cmp#error-codes-and-diagnostics","content":"The body cannot be decoded as an ASN.1 `PKIMessage` (no valid header to build a CMP response from)."},"1270":{"id":"/docs/pr-preview/pr-24/platform/pki/cmp-459","page_id":"/docs/pr-preview/pr-24/platform/pki/cmp","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/cmp#error-codes-and-diagnostics","content":"Check the body is binary DER, not base64 or PEM."},"1271":{"id":"/docs/pr-preview/pr-24/platform/pki/cmp-460","page_id":"/docs/pr-preview/pr-24/platform/pki/cmp","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/cmp#error-codes-and-diagnostics","content":"200 (`error`)"},"1272":{"id":"/docs/pr-preview/pr-24/platform/pki/cmp-461","page_id":"/docs/pr-preview/pr-24/platform/pki/cmp","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/cmp#error-codes-and-diagnostics","content":"Body's `PKIFailureInfo`"},"1273":{"id":"/docs/pr-preview/pr-24/platform/pki/cmp-462","page_id":"/docs/pr-preview/pr-24/platform/pki/cmp","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/cmp#error-codes-and-diagnostics","content":"`unsupportedVersion`: pvno other than `cmp2000(2)`/`cmp2021(3)`."},"1274":{"id":"/docs/pr-preview/pr-24/platform/pki/cmp-463","page_id":"/docs/pr-preview/pr-24/platform/pki/cmp","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/cmp#error-codes-and-diagnostics","content":"Use a supported version."},"1275":{"id":"/docs/pr-preview/pr-24/platform/pki/cmp-464","page_id":"/docs/pr-preview/pr-24/platform/pki/cmp","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/cmp#error-codes-and-diagnostics","content":"200 (`error`)"},"1276":{"id":"/docs/pr-preview/pr-24/platform/pki/cmp-465","page_id":"/docs/pr-preview/pr-24/platform/pki/cmp","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/cmp#error-codes-and-diagnostics","content":"Body's `PKIFailureInfo`"},"1277":{"id":"/docs/pr-preview/pr-24/platform/pki/cmp-466","page_id":"/docs/pr-preview/pr-24/platform/pki/cmp","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/cmp#error-codes-and-diagnostics","content":"`badDataFormat`: missing or under-128-bit `transactionID`/`senderNonce`; malformed `PKIHeader`; `error` from the EE."},"1278":{"id":"/docs/pr-preview/pr-24/platform/pki/cmp-467","page_id":"/docs/pr-preview/pr-24/platform/pki/cmp","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/cmp#error-codes-and-diagnostics","content":"Review the CMP client implementation."},"1279":{"id":"/docs/pr-preview/pr-24/platform/pki/cmp-468","page_id":"/docs/pr-preview/pr-24/platform/pki/cmp","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/cmp#error-codes-and-diagnostics","content":"200 (`error`)"},"1280":{"id":"/docs/pr-preview/pr-24/platform/pki/cmp-469","page_id":"/docs/pr-preview/pr-24/platform/pki/cmp","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/cmp#error-codes-and-diagnostics","content":"Body's `PKIFailureInfo`"},"1281":{"id":"/docs/pr-preview/pr-24/platform/pki/cmp-470","page_id":"/docs/pr-preview/pr-24/platform/pki/cmp","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/cmp#error-codes-and-diagnostics","content":"`badTime`: `messageTime` absent or drifting more than 5 minutes."},"1282":{"id":"/docs/pr-preview/pr-24/platform/pki/cmp-471","page_id":"/docs/pr-preview/pr-24/platform/pki/cmp","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/cmp#error-codes-and-diagnostics","content":"Synchronize the device's clock."},"1283":{"id":"/docs/pr-preview/pr-24/platform/pki/cmp-472","page_id":"/docs/pr-preview/pr-24/platform/pki/cmp","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/cmp#error-codes-and-diagnostics","content":"200 (`error`)"},"1284":{"id":"/docs/pr-preview/pr-24/platform/pki/cmp-473","page_id":"/docs/pr-preview/pr-24/platform/pki/cmp","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/cmp#error-codes-and-diagnostics","content":"Body's `PKIFailureInfo`"},"1285":{"id":"/docs/pr-preview/pr-24/platform/pki/cmp-474","page_id":"/docs/pr-preview/pr-24/platform/pki/cmp","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/cmp#error-codes-and-diagnostics","content":"`badSenderNonce`/`badRecipientNonce`: reused `senderNonce`, `recipNonce` present in an initial request or mismatched."},"1286":{"id":"/docs/pr-preview/pr-24/platform/pki/cmp-475","page_id":"/docs/pr-preview/pr-24/platform/pki/cmp","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/cmp#error-codes-and-diagnostics","content":"Follow the nonce rules of RFC 9483 §3.1."},"1287":{"id":"/docs/pr-preview/pr-24/platform/pki/cmp-476","page_id":"/docs/pr-preview/pr-24/platform/pki/cmp","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/cmp#error-codes-and-diagnostics","content":"200 (`error`)"},"1288":{"id":"/docs/pr-preview/pr-24/platform/pki/cmp-477","page_id":"/docs/pr-preview/pr-24/platform/pki/cmp","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/cmp#error-codes-and-diagnostics","content":"Body's `PKIFailureInfo`"},"1289":{"id":"/docs/pr-preview/pr-24/platform/pki/cmp-478","page_id":"/docs/pr-preview/pr-24/platform/pki/cmp","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/cmp#error-codes-and-diagnostics","content":"`badMessageCheck`: invalid signature, `sender`/`senderKID` not matching the protection certificate, or failed protection in a nested message."},"1290":{"id":"/docs/pr-preview/pr-24/platform/pki/cmp-479","page_id":"/docs/pr-preview/pr-24/platform/pki/cmp","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/cmp#error-codes-and-diagnostics","content":"Review the certificate used to sign."},"1291":{"id":"/docs/pr-preview/pr-24/platform/pki/cmp-480","page_id":"/docs/pr-preview/pr-24/platform/pki/cmp","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/cmp#error-codes-and-diagnostics","content":"200 (`error`)"},"1292":{"id":"/docs/pr-preview/pr-24/platform/pki/cmp-481","page_id":"/docs/pr-preview/pr-24/platform/pki/cmp","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/cmp#error-codes-and-diagnostics","content":"Body's `PKIFailureInfo`"},"1293":{"id":"/docs/pr-preview/pr-24/platform/pki/cmp-482","page_id":"/docs/pr-preview/pr-24/platform/pki/cmp","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/cmp#error-codes-and-diagnostics","content":"`transactionIdInUse`: `transactionID` already registered (replay of an `rr`)."},"1294":{"id":"/docs/pr-preview/pr-24/platform/pki/cmp-483","page_id":"/docs/pr-preview/pr-24/platform/pki/cmp","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/cmp#error-codes-and-diagnostics","content":"Generate a new `transactionID`."},"1295":{"id":"/docs/pr-preview/pr-24/platform/pki/cmp-484","page_id":"/docs/pr-preview/pr-24/platform/pki/cmp","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/cmp#error-codes-and-diagnostics","content":"200 (`error`)"},"1296":{"id":"/docs/pr-preview/pr-24/platform/pki/cmp-485","page_id":"/docs/pr-preview/pr-24/platform/pki/cmp","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/cmp#error-codes-and-diagnostics","content":"Body's `PKIFailureInfo`"},"1297":{"id":"/docs/pr-preview/pr-24/platform/pki/cmp-486","page_id":"/docs/pr-preview/pr-24/platform/pki/cmp","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/cmp#error-codes-and-diagnostics","content":"`notAuthorized`: operation disabled for the DMS, or revocation of another DMS's certificate."},"1298":{"id":"/docs/pr-preview/pr-24/platform/pki/cmp-487","page_id":"/docs/pr-preview/pr-24/platform/pki/cmp","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/cmp#error-codes-and-diagnostics","content":"Confirm with the PKI administrator that the operation is enabled."},"1299":{"id":"/docs/pr-preview/pr-24/platform/pki/cmp-488","page_id":"/docs/pr-preview/pr-24/platform/pki/cmp","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/cmp#error-codes-and-diagnostics","content":"200 (`error`)"},"1300":{"id":"/docs/pr-preview/pr-24/platform/pki/cmp-489","page_id":"/docs/pr-preview/pr-24/platform/pki/cmp","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/cmp#error-codes-and-diagnostics","content":"Body's `PKIFailureInfo`"},"1301":{"id":"/docs/pr-preview/pr-24/platform/pki/cmp-490","page_id":"/docs/pr-preview/pr-24/platform/pki/cmp","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/cmp#error-codes-and-diagnostics","content":"`signerNotTrusted`: the signer does not chain to the DMS's validation CAs, or the KGA recipient is outside the trust boundary."},"1302":{"id":"/docs/pr-preview/pr-24/platform/pki/cmp-491","page_id":"/docs/pr-preview/pr-24/platform/pki/cmp","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/cmp#error-codes-and-diagnostics","content":"Review the signing certificate and the configured CAs."},"1303":{"id":"/docs/pr-preview/pr-24/platform/pki/cmp-492","page_id":"/docs/pr-preview/pr-24/platform/pki/cmp","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/cmp#error-codes-and-diagnostics","content":"200 (`error`)"},"1304":{"id":"/docs/pr-preview/pr-24/platform/pki/cmp-493","page_id":"/docs/pr-preview/pr-24/platform/pki/cmp","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/cmp#error-codes-and-diagnostics","content":"Body's `PKIFailureInfo`"},"1305":{"id":"/docs/pr-preview/pr-24/platform/pki/cmp-494","page_id":"/docs/pr-preview/pr-24/platform/pki/cmp","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/cmp#error-codes-and-diagnostics","content":"`certRevoked`: the protection certificate was replaced by a confirmed renewal, or the target certificate is already revoked."},"1306":{"id":"/docs/pr-preview/pr-24/platform/pki/cmp-495","page_id":"/docs/pr-preview/pr-24/platform/pki/cmp","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/cmp#error-codes-and-diagnostics","content":"Repeat the enrollment or review the identity's state."},"1307":{"id":"/docs/pr-preview/pr-24/platform/pki/cmp-496","page_id":"/docs/pr-preview/pr-24/platform/pki/cmp","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/cmp#error-codes-and-diagnostics","content":"200 (`error`)"},"1308":{"id":"/docs/pr-preview/pr-24/platform/pki/cmp-497","page_id":"/docs/pr-preview/pr-24/platform/pki/cmp","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/cmp#error-codes-and-diagnostics","content":"Body's `PKIFailureInfo`"},"1309":{"id":"/docs/pr-preview/pr-24/platform/pki/cmp-498","page_id":"/docs/pr-preview/pr-24/platform/pki/cmp","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/cmp#error-codes-and-diagnostics","content":"`certConfirmed`: duplicate `certConf` (the confirmation was already received)."},"1310":{"id":"/docs/pr-preview/pr-24/platform/pki/cmp-499","page_id":"/docs/pr-preview/pr-24/platform/pki/cmp","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/cmp#error-codes-and-diagnostics","content":"Do not repeat the confirmation unless the `pkiConf` was lost."},"1311":{"id":"/docs/pr-preview/pr-24/platform/pki/cmp-500","page_id":"/docs/pr-preview/pr-24/platform/pki/cmp","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/cmp#error-codes-and-diagnostics","content":"200 (`error`)"},"1312":{"id":"/docs/pr-preview/pr-24/platform/pki/cmp-501","page_id":"/docs/pr-preview/pr-24/platform/pki/cmp","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/cmp#error-codes-and-diagnostics","content":"Body's `PKIFailureInfo`"},"1313":{"id":"/docs/pr-preview/pr-24/platform/pki/cmp-502","page_id":"/docs/pr-preview/pr-24/platform/pki/cmp","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/cmp#error-codes-and-diagnostics","content":"`badRequest`: unknown or expired transaction, no certificate to confirm, second pending renewal, or KGA recipient without the necessary key usage."},"1314":{"id":"/docs/pr-preview/pr-24/platform/pki/cmp-503","page_id":"/docs/pr-preview/pr-24/platform/pki/cmp","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/cmp#error-codes-and-diagnostics","content":"Inspect the exact reason (`statusString`) and fix the flow."},"1315":{"id":"/docs/pr-preview/pr-24/platform/pki/cmp-504","page_id":"/docs/pr-preview/pr-24/platform/pki/cmp","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/cmp#error-codes-and-diagnostics","content":"200 (`ip`/`cp`/`kup` with `status: rejection`)"},"1316":{"id":"/docs/pr-preview/pr-24/platform/pki/cmp-505","page_id":"/docs/pr-preview/pr-24/platform/pki/cmp","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/cmp#error-codes-and-diagnostics","content":"Body's `PKIFailureInfo`"},"1317":{"id":"/docs/pr-preview/pr-24/platform/pki/cmp-506","page_id":"/docs/pr-preview/pr-24/platform/pki/cmp","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/cmp#error-codes-and-diagnostics","content":"Issuance policy: missing or failed POPO (`badPOP`), CA certificate request or RSA outside 2048–8192 bits (`badCertTemplate`), `notAuthorized` for POPO/KGA recipients not allowed, invalid `certReqId`."},"1318":{"id":"/docs/pr-preview/pr-24/platform/pki/cmp-507","page_id":"/docs/pr-preview/pr-24/platform/pki/cmp","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/cmp#error-codes-and-diagnostics","content":"Inspect the body's `PKIFailureInfo` and check it against the DMS's per-operation configuration."},"1319":{"id":"/docs/pr-preview/pr-24/platform/pki/cmp-508","page_id":"/docs/pr-preview/pr-24/platform/pki/cmp","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/cmp#error-codes-and-diagnostics","content":"200 (`rp` with `status: rejection`)"},"1320":{"id":"/docs/pr-preview/pr-24/platform/pki/cmp-509","page_id":"/docs/pr-preview/pr-24/platform/pki/cmp","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/cmp#error-codes-and-diagnostics","content":"Body's `PKIStatusInfo`"},"1321":{"id":"/docs/pr-preview/pr-24/platform/pki/cmp-510","page_id":"/docs/pr-preview/pr-24/platform/pki/cmp","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/cmp#error-codes-and-diagnostics","content":"Revocation: reason not allowed (`badRequest`), repeated `transactionID`, certificate not found (`badCertId`), already revoked (`certRevoked`) or not revivable (`badCertId`), or signer without authority over the certificate (`signerNotTrusted`/`notAuthorized`)."},"1322":{"id":"/docs/pr-preview/pr-24/platform/pki/cmp-511","page_id":"/docs/pr-preview/pr-24/platform/pki/cmp","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/cmp#error-codes-and-diagnostics","content":"Check against the DMS's `rr` policy."},"1323":{"id":"/docs/pr-preview/pr-24/platform/pki/cmp-512","page_id":"/docs/pr-preview/pr-24/platform/pki/cmp","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/cmp#error-codes-and-diagnostics","content":"To interpret the exact reason of a CMP rejection, inspect the response `PKIMessage`'s `PKIFailureInfo`/`statusString` field (for example with `openssl cmp ... -rspout response.der` and `openssl asn1parse -inform DER -in response.der`). In the Lamassu server logs, every rejection generates a structured `CMP operation rejected` event with the fields `dms`, `pkiStatus`, `pkiFailureInfo`, `reason` and `txid`; client failures are logged as `WARN` and internal ones (`systemFailure`) as `ERROR`."},"1324":{"id":"/docs/pr-preview/pr-24/platform/pki/cmp-513","page_id":"/docs/pr-preview/pr-24/platform/pki/cmp","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/cmp#compatibility-notes","content":"Lamassu's implementation follows the Lightweight CMP profile with the following quirks that affect strict CMP clients:"},"1325":{"id":"/docs/pr-preview/pr-24/platform/pki/cmp-514","page_id":"/docs/pr-preview/pr-24/platform/pki/cmp","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/cmp#compatibility-notes","content":"CMP is served from a single multiplexed endpoint (`/.well-known/cmp/p/{id}`); there are no per-operation routes as in EST."},"1326":{"id":"/docs/pr-preview/pr-24/platform/pki/cmp-515","page_id":"/docs/pr-preview/pr-24/platform/pki/cmp","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/cmp#compatibility-notes","content":"Both versions `cmp2000(2)` and `cmp2021(3)` are accepted and answered; the response returns the same `pvno` as the request."},"1327":{"id":"/docs/pr-preview/pr-24/platform/pki/cmp-516","page_id":"/docs/pr-preview/pr-24/platform/pki/cmp","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/cmp#compatibility-notes","content":"`messageTime` is mandatory in **all** messages (not only protected ones), with a 5-minute drift tolerance (`badTime`)."},"1328":{"id":"/docs/pr-preview/pr-24/platform/pki/cmp-517","page_id":"/docs/pr-preview/pr-24/platform/pki/cmp","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/cmp#compatibility-notes","content":"`transactionID` and `senderNonce` must carry at least 128 bits of entropy, and the `senderNonce` must be new in every message."},"1329":{"id":"/docs/pr-preview/pr-24/platform/pki/cmp-518","page_id":"/docs/pr-preview/pr-24/platform/pki/cmp","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/cmp#compatibility-notes","content":"The `ir`, `cr` and `p10cr` operations do not admit `recipNonce` in the initial request (RFC 9483 §3.1); a client that includes it receives `badRecipientNonce`. The `generalInfo` rules are enforced equally: `implicitConfirm` and `confirmWaitTime` are mutually exclusive, the value of `implicitConfirm` must be `NULL` and that of `confirmWaitTime` a `GeneralizedTime`."},"1330":{"id":"/docs/pr-preview/pr-24/platform/pki/cmp-519","page_id":"/docs/pr-preview/pr-24/platform/pki/cmp","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/cmp#compatibility-notes","content":"With signature-based protection, the header's `sender` must match the protection certificate's subject and the `senderKID` its `SubjectKeyIdentifier` (`badMessageCheck` otherwise). `genm` messages are exempt from this identity check."},"1331":{"id":"/docs/pr-preview/pr-24/platform/pki/cmp-520","page_id":"/docs/pr-preview/pr-24/platform/pki/cmp","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/cmp#compatibility-notes","content":"The subject may be NULL-DN only if the SAN carries the identity; for the device's internal identity the SAN is used as a fallback, but the issued certificate keeps the empty subject."},"1332":{"id":"/docs/pr-preview/pr-24/platform/pki/cmp-521","page_id":"/docs/pr-preview/pr-24/platform/pki/cmp","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/cmp#compatibility-notes","content":"Lamassu never issues CA certificates over CMP; the only operation that produces CA certificates is `ccr`."},"1333":{"id":"/docs/pr-preview/pr-24/platform/pki/cmp-522","page_id":"/docs/pr-preview/pr-24/platform/pki/cmp","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/cmp#compatibility-notes","content":"The `id-it-revPassphrase` type of the `genm` is permanently disabled."},"1334":{"id":"/docs/pr-preview/pr-24/platform/pki/cmp-523","page_id":"/docs/pr-preview/pr-24/platform/pki/cmp","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/cmp#compatibility-notes","content":"The internal `APPROVING` and `REVOKING` states of a transaction are transient and are not exposed by the listing API; only `PENDING`, `ISSUED`, `ISSUE_FAILED`, `CONFIRMED` and `REVOKED` appear."},"1335":{"id":"/docs/pr-preview/pr-24/platform/pki/cmp-524","page_id":"/docs/pr-preview/pr-24/platform/pki/cmp","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/cmp#compatibility-notes","content":"Transaction records in terminal states (`CONFIRMED`, `REVOKED`) are kept for audit and are not purged by expiration; a completed `transactionID` may be reused in a new operation, except in `rr`, where replay protection also looks at terminal records."},"1336":{"id":"/docs/pr-preview/pr-24/platform/pki/cmp-525","page_id":"/docs/pr-preview/pr-24/platform/pki/cmp","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/cmp#compatibility-notes","content":"The protection certificate must be renewed manually before it expires: the DMS does not renew it automatically, and while none is configured, all responses go out unprotected."},"1337":{"id":"/docs/pr-preview/pr-24/platform/pki/cmp-526","page_id":"/docs/pr-preview/pr-24/platform/pki/cmp","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/cmp#compatibility-notes","content":"<Card title=\"DMS overview\" href=\"/docs/platform/pki/device-enrollment\" />"},"1338":{"id":"/docs/pr-preview/pr-24/platform/pki/cmp-527","page_id":"/docs/pr-preview/pr-24/platform/pki/cmp","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/cmp#compatibility-notes","content":"<Card title=\"EST (RFC 7030)\" href=\"/docs/platform/pki/est-enrollment\" />"},"1339":{"id":"/docs/pr-preview/pr-24/platform/pki/cmp-528","page_id":"/docs/pr-preview/pr-24/platform/pki/cmp","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/cmp#compatibility-notes","content":"<Card title=\"Manage devices\" href=\"/docs/platform/pki/device-management\" />"},"1340":{"id":"/docs/pr-preview/pr-24/platform/pki/concepts/architecture","page_id":"/docs/pr-preview/pr-24/platform/pki/concepts/architecture","type":"page","content":"Platform architecture","breadcrumbs":["Docs","Platform","Concepts"],"tags":[],"url":"/docs/pr-preview/pr-24/platform/pki/concepts/architecture"},"1341":{"id":"/docs/pr-preview/pr-24/platform/pki/concepts/architecture-0","page_id":"/docs/pr-preview/pr-24/platform/pki/concepts/architecture","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/concepts/architecture","content":"Lamassu components and how control, keys, issuance and devices relate."},"1342":{"id":"/docs/pr-preview/pr-24/platform/pki/concepts/architecture-1","page_id":"/docs/pr-preview/pr-24/platform/pki/concepts/architecture","type":"heading","tags":[],"url":"/docs/pr-preview/pr-24/platform/pki/concepts/architecture#control-plane","content":"Control plane"},"1343":{"id":"/docs/pr-preview/pr-24/platform/pki/concepts/architecture-2","page_id":"/docs/pr-preview/pr-24/platform/pki/concepts/architecture","type":"heading","tags":[],"url":"/docs/pr-preview/pr-24/platform/pki/concepts/architecture#key-custody-and-cryptographic-operations","content":"Key custody and cryptographic operations"},"1344":{"id":"/docs/pr-preview/pr-24/platform/pki/concepts/architecture-3","page_id":"/docs/pr-preview/pr-24/platform/pki/concepts/architecture","type":"heading","tags":[],"url":"/docs/pr-preview/pr-24/platform/pki/concepts/architecture#issuance-and-enrollment","content":"Issuance and enrollment"},"1345":{"id":"/docs/pr-preview/pr-24/platform/pki/concepts/architecture-4","page_id":"/docs/pr-preview/pr-24/platform/pki/concepts/architecture","type":"heading","tags":[],"url":"/docs/pr-preview/pr-24/platform/pki/concepts/architecture#status-and-validation","content":"Status and validation"},"1346":{"id":"/docs/pr-preview/pr-24/platform/pki/concepts/architecture-5","page_id":"/docs/pr-preview/pr-24/platform/pki/concepts/architecture","type":"heading","tags":[],"url":"/docs/pr-preview/pr-24/platform/pki/concepts/architecture#platform-dependencies","content":"Platform dependencies"},"1347":{"id":"/docs/pr-preview/pr-24/platform/pki/concepts/architecture-6","page_id":"/docs/pr-preview/pr-24/platform/pki/concepts/architecture","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/concepts/architecture","content":"Lamassu deploys as a set of independent services. This separation keeps every component from needing direct access to private keys and lets each capability scale according to load."},"1348":{"id":"/docs/pr-preview/pr-24/platform/pki/concepts/architecture-7","page_id":"/docs/pr-preview/pr-24/platform/pki/concepts/architecture","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/concepts/architecture#control-plane","content":"The console and the APIs manage authorities, certificates, DMSs, devices, alerts and configuration. Domain events allow connectors and automations to react to changes without continuously polling the platform."},"1349":{"id":"/docs/pr-preview/pr-24/platform/pki/concepts/architecture-8","page_id":"/docs/pr-preview/pr-24/platform/pki/concepts/architecture","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/concepts/architecture#key-custody-and-cryptographic-operations","content":"The KMS offers a common interface over software engines, PKCS#11 and cloud providers. The selected engine keeps the key or delegates the cryptographic operation without the other services knowing its implementation."},"1350":{"id":"/docs/pr-preview/pr-24/platform/pki/concepts/architecture-9","page_id":"/docs/pr-preview/pr-24/platform/pki/concepts/architecture","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/concepts/architecture#issuance-and-enrollment","content":"The CA service issues certificates and maintains the relationship with its authority. The DMS applies the enrollment rules and exposes the flows of the configured protocol — EST or CMP — so a device can request or renew an identity."},"1351":{"id":"/docs/pr-preview/pr-24/platform/pki/concepts/architecture-10","page_id":"/docs/pr-preview/pr-24/platform/pki/concepts/architecture","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/concepts/architecture#status-and-validation","content":"Device Manager keeps the operational view of the device and its history. The Validation Authority publishes OCSP and CRLs so other systems can decide whether to trust a presented certificate."},"1352":{"id":"/docs/pr-preview/pr-24/platform/pki/concepts/architecture-11","page_id":"/docs/pr-preview/pr-24/platform/pki/concepts/architecture","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/concepts/architecture#platform-dependencies","content":"In a self-managed deployment, Lamassu uses PostgreSQL for persistence, RabbitMQ for messaging and an OIDC provider for authentication. See the deployment architecture for how the services are published on Kubernetes."},"1353":{"id":"/docs/pr-preview/pr-24/platform/pki/concepts/certificate-lifecycle","page_id":"/docs/pr-preview/pr-24/platform/pki/concepts/certificate-lifecycle","type":"page","content":"Certificate lifecycle","breadcrumbs":["Docs","Platform","Concepts"],"tags":[],"url":"/docs/pr-preview/pr-24/platform/pki/concepts/certificate-lifecycle"},"1354":{"id":"/docs/pr-preview/pr-24/platform/pki/concepts/certificate-lifecycle-0","page_id":"/docs/pr-preview/pr-24/platform/pki/concepts/certificate-lifecycle","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/concepts/certificate-lifecycle","content":"Issuance, use, renewal, revocation and retirement of certificates in Lamassu."},"1355":{"id":"/docs/pr-preview/pr-24/platform/pki/concepts/certificate-lifecycle-1","page_id":"/docs/pr-preview/pr-24/platform/pki/concepts/certificate-lifecycle","type":"heading","tags":[],"url":"/docs/pr-preview/pr-24/platform/pki/concepts/certificate-lifecycle#the-full-journey","content":"The full journey"},"1356":{"id":"/docs/pr-preview/pr-24/platform/pki/concepts/certificate-lifecycle-2","page_id":"/docs/pr-preview/pr-24/platform/pki/concepts/certificate-lifecycle","type":"heading","tags":[],"url":"/docs/pr-preview/pr-24/platform/pki/concepts/certificate-lifecycle#request","content":"Request"},"1357":{"id":"/docs/pr-preview/pr-24/platform/pki/concepts/certificate-lifecycle-3","page_id":"/docs/pr-preview/pr-24/platform/pki/concepts/certificate-lifecycle","type":"heading","tags":[],"url":"/docs/pr-preview/pr-24/platform/pki/concepts/certificate-lifecycle#issuance","content":"Issuance"},"1358":{"id":"/docs/pr-preview/pr-24/platform/pki/concepts/certificate-lifecycle-4","page_id":"/docs/pr-preview/pr-24/platform/pki/concepts/certificate-lifecycle","type":"heading","tags":[],"url":"/docs/pr-preview/pr-24/platform/pki/concepts/certificate-lifecycle#use-and-monitoring","content":"Use and monitoring"},"1359":{"id":"/docs/pr-preview/pr-24/platform/pki/concepts/certificate-lifecycle-5","page_id":"/docs/pr-preview/pr-24/platform/pki/concepts/certificate-lifecycle","type":"heading","tags":[],"url":"/docs/pr-preview/pr-24/platform/pki/concepts/certificate-lifecycle#renewal-or-re-enrollment","content":"Renewal or re-enrollment"},"1360":{"id":"/docs/pr-preview/pr-24/platform/pki/concepts/certificate-lifecycle-6","page_id":"/docs/pr-preview/pr-24/platform/pki/concepts/certificate-lifecycle","type":"heading","tags":[],"url":"/docs/pr-preview/pr-24/platform/pki/concepts/certificate-lifecycle#revocation-or-retirement","content":"Revocation or retirement"},"1361":{"id":"/docs/pr-preview/pr-24/platform/pki/concepts/certificate-lifecycle-7","page_id":"/docs/pr-preview/pr-24/platform/pki/concepts/certificate-lifecycle","type":"heading","tags":[],"url":"/docs/pr-preview/pr-24/platform/pki/concepts/certificate-lifecycle#certificate-states","content":"Certificate states"},"1362":{"id":"/docs/pr-preview/pr-24/platform/pki/concepts/certificate-lifecycle-8","page_id":"/docs/pr-preview/pr-24/platform/pki/concepts/certificate-lifecycle","type":"heading","tags":[],"url":"/docs/pr-preview/pr-24/platform/pki/concepts/certificate-lifecycle#renewal-and-revocation-are-not-equivalent","content":"Renewal and revocation are not equivalent"},"1363":{"id":"/docs/pr-preview/pr-24/platform/pki/concepts/certificate-lifecycle-9","page_id":"/docs/pr-preview/pr-24/platform/pki/concepts/certificate-lifecycle","type":"heading","tags":[],"url":"/docs/pr-preview/pr-24/platform/pki/concepts/certificate-lifecycle#effect-of-revoking-a-ca","content":"Effect of revoking a CA"},"1364":{"id":"/docs/pr-preview/pr-24/platform/pki/concepts/certificate-lifecycle-10","page_id":"/docs/pr-preview/pr-24/platform/pki/concepts/certificate-lifecycle","type":"heading","tags":[],"url":"/docs/pr-preview/pr-24/platform/pki/concepts/certificate-lifecycle#what-you-should-watch","content":"What you should watch"},"1365":{"id":"/docs/pr-preview/pr-24/platform/pki/concepts/certificate-lifecycle-11","page_id":"/docs/pr-preview/pr-24/platform/pki/concepts/certificate-lifecycle","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/concepts/certificate-lifecycle","content":"Issuing a certificate is only the beginning. During its useful life you must check its validity, renew it before it expires and retire it when it stops being trustworthy. Lamassu keeps the certificate, its issuing CA, its status and, when it belongs to a device, the identity it is linked to."},"1366":{"id":"/docs/pr-preview/pr-24/platform/pki/concepts/certificate-lifecycle-12","page_id":"/docs/pr-preview/pr-24/platform/pki/concepts/certificate-lifecycle","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/concepts/certificate-lifecycle#request","content":"The requester generates a key and a CSR. In the recommended flows, the private key stays in the device, browser or cryptographic engine that created it."},"1367":{"id":"/docs/pr-preview/pr-24/platform/pki/concepts/certificate-lifecycle-13","page_id":"/docs/pr-preview/pr-24/platform/pki/concepts/certificate-lifecycle","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/concepts/certificate-lifecycle#issuance","content":"The CA signs the CSR. The issuance profile determines the validity, uses, subject, allowed extensions and cryptographic constraints."},"1368":{"id":"/docs/pr-preview/pr-24/platform/pki/concepts/certificate-lifecycle-14","page_id":"/docs/pr-preview/pr-24/platform/pki/concepts/certificate-lifecycle","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/concepts/certificate-lifecycle#use-and-monitoring","content":"The certificate enters the `ACTIVE` state. Lamassu monitors its `Not After` date; the cryptographic monitoring job marks certificates that have expired as `EXPIRED`."},"1369":{"id":"/docs/pr-preview/pr-24/platform/pki/concepts/certificate-lifecycle-15","page_id":"/docs/pr-preview/pr-24/platform/pki/concepts/certificate-lifecycle","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/concepts/certificate-lifecycle#renewal-or-re-enrollment","content":"A new certificate is issued before the previous one expires. In a DMS you can open preventive and critical windows so the device re-enrolls through EST."},"1370":{"id":"/docs/pr-preview/pr-24/platform/pki/concepts/certificate-lifecycle-16","page_id":"/docs/pr-preview/pr-24/platform/pki/concepts/certificate-lifecycle","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/concepts/certificate-lifecycle#revocation-or-retirement","content":"If the identity stops being trustworthy, Lamassu records the reason and time of revocation. OCSP and CRLs let consumers learn that status."},"1371":{"id":"/docs/pr-preview/pr-24/platform/pki/concepts/certificate-lifecycle-17","page_id":"/docs/pr-preview/pr-24/platform/pki/concepts/certificate-lifecycle","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/concepts/certificate-lifecycle#certificate-states","content":"Lamassu persists four X.509 states:"},"1372":{"id":"/docs/pr-preview/pr-24/platform/pki/concepts/certificate-lifecycle-18","page_id":"/docs/pr-preview/pr-24/platform/pki/concepts/certificate-lifecycle","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/concepts/certificate-lifecycle#certificate-states","content":"**`ACTIVE`**: the certificate is enabled and within its validity period."},"1373":{"id":"/docs/pr-preview/pr-24/platform/pki/concepts/certificate-lifecycle-19","page_id":"/docs/pr-preview/pr-24/platform/pki/concepts/certificate-lifecycle","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/concepts/certificate-lifecycle#certificate-states","content":"**`EXPIRED`**: it has passed its expiration date. The monitor detects this periodically; it is not a state that should be assigned manually."},"1374":{"id":"/docs/pr-preview/pr-24/platform/pki/concepts/certificate-lifecycle-20","page_id":"/docs/pr-preview/pr-24/platform/pki/concepts/certificate-lifecycle","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/concepts/certificate-lifecycle#certificate-states","content":"**`REVOKED`**: it was invalidated before expiring, with a reason and a timestamp."},"1375":{"id":"/docs/pr-preview/pr-24/platform/pki/concepts/certificate-lifecycle-21","page_id":"/docs/pr-preview/pr-24/platform/pki/concepts/certificate-lifecycle","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/concepts/certificate-lifecycle#certificate-states","content":"**`INACTIVE`**: it is disabled without representing a definitive revocation."},"1376":{"id":"/docs/pr-preview/pr-24/platform/pki/concepts/certificate-lifecycle-22","page_id":"/docs/pr-preview/pr-24/platform/pki/concepts/certificate-lifecycle","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/concepts/certificate-lifecycle#certificate-states","content":"The device view may add operational states such as missing identity, pending renewal, expiring soon or decommissioned. These are an interpretation of the device's status and its certificates, not new X.509 states."},"1377":{"id":"/docs/pr-preview/pr-24/platform/pki/concepts/certificate-lifecycle-23","page_id":"/docs/pr-preview/pr-24/platform/pki/concepts/certificate-lifecycle","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/concepts/certificate-lifecycle#renewal-and-revocation-are-not-equivalent","content":"**Renewal** creates a successor certificate for an identity that remains valid. **Revocation** communicates that the current certificate must no longer be accepted. Renew to maintain continuity; revoke in response to compromise, retirement or a change that invalidates the identity."},"1378":{"id":"/docs/pr-preview/pr-24/platform/pki/concepts/certificate-lifecycle-24","page_id":"/docs/pr-preview/pr-24/platform/pki/concepts/certificate-lifecycle","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/concepts/certificate-lifecycle#renewal-and-revocation-are-not-equivalent","content":"Only a revocation with the reason `CertificateHold` can be undone. A revocation with any other reason is final in Lamassu."},"1379":{"id":"/docs/pr-preview/pr-24/platform/pki/concepts/certificate-lifecycle-25","page_id":"/docs/pr-preview/pr-24/platform/pki/concepts/certificate-lifecycle","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/concepts/certificate-lifecycle#renewal-and-revocation-are-not-equivalent","content":"The **Reissue CA** operation generates another certificate for the same key and links both serial numbers through metadata. It is not a key rotation. To change the key, create a successor CA and perform a migration with an overlapping period."},"1380":{"id":"/docs/pr-preview/pr-24/platform/pki/concepts/certificate-lifecycle-26","page_id":"/docs/pr-preview/pr-24/platform/pki/concepts/certificate-lifecycle","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/concepts/certificate-lifecycle#effect-of-revoking-a-ca","content":"Revoking a CA is a cascading operation. Lamassu revokes its child CAs and the certificates it issued, with the reason `CessationOfOperation`. The propagation continues down the hierarchy."},"1381":{"id":"/docs/pr-preview/pr-24/platform/pki/concepts/certificate-lifecycle-27","page_id":"/docs/pr-preview/pr-24/platform/pki/concepts/certificate-lifecycle","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/concepts/certificate-lifecycle#effect-of-revoking-a-ca","content":"Before confirming:"},"1382":{"id":"/docs/pr-preview/pr-24/platform/pki/concepts/certificate-lifecycle-28","page_id":"/docs/pr-preview/pr-24/platform/pki/concepts/certificate-lifecycle","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/concepts/certificate-lifecycle#effect-of-revoking-a-ca","content":"Identify DMSs, devices and services that trust that chain."},"1383":{"id":"/docs/pr-preview/pr-24/platform/pki/concepts/certificate-lifecycle-29","page_id":"/docs/pr-preview/pr-24/platform/pki/concepts/certificate-lifecycle","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/concepts/certificate-lifecycle#effect-of-revoking-a-ca","content":"Distribute the new chain of trust."},"1384":{"id":"/docs/pr-preview/pr-24/platform/pki/concepts/certificate-lifecycle-30","page_id":"/docs/pr-preview/pr-24/platform/pki/concepts/certificate-lifecycle","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/concepts/certificate-lifecycle#effect-of-revoking-a-ca","content":"Reissue the necessary identities."},"1385":{"id":"/docs/pr-preview/pr-24/platform/pki/concepts/certificate-lifecycle-31","page_id":"/docs/pr-preview/pr-24/platform/pki/concepts/certificate-lifecycle","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/concepts/certificate-lifecycle#effect-of-revoking-a-ca","content":"Check OCSP and CRL from a real consumer."},"1386":{"id":"/docs/pr-preview/pr-24/platform/pki/concepts/certificate-lifecycle-32","page_id":"/docs/pr-preview/pr-24/platform/pki/concepts/certificate-lifecycle","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/concepts/certificate-lifecycle#effect-of-revoking-a-ca","content":"Revoke the old CA once no legitimate traffic remains."},"1387":{"id":"/docs/pr-preview/pr-24/platform/pki/concepts/certificate-lifecycle-33","page_id":"/docs/pr-preview/pr-24/platform/pki/concepts/certificate-lifecycle","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/concepts/certificate-lifecycle#effect-of-revoking-a-ca","content":"Decommissioning a device revokes its certificates and prevents it from obtaining new identities. Use this action only when the device is being retired permanently."},"1388":{"id":"/docs/pr-preview/pr-24/platform/pki/concepts/certificate-lifecycle-34","page_id":"/docs/pr-preview/pr-24/platform/pki/concepts/certificate-lifecycle","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/concepts/certificate-lifecycle#what-you-should-watch","content":"Certificates entering the preventive or critical renewal window."},"1389":{"id":"/docs/pr-preview/pr-24/platform/pki/concepts/certificate-lifecycle-35","page_id":"/docs/pr-preview/pr-24/platform/pki/concepts/certificate-lifecycle","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/concepts/certificate-lifecycle#what-you-should-watch","content":"Repeated enrollment or re-enrollment failures."},"1390":{"id":"/docs/pr-preview/pr-24/platform/pki/concepts/certificate-lifecycle-36","page_id":"/docs/pr-preview/pr-24/platform/pki/concepts/certificate-lifecycle","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/concepts/certificate-lifecycle#what-you-should-watch","content":"Status changes and revocation reasons."},"1391":{"id":"/docs/pr-preview/pr-24/platform/pki/concepts/certificate-lifecycle-37","page_id":"/docs/pr-preview/pr-24/platform/pki/concepts/certificate-lifecycle","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/concepts/certificate-lifecycle#what-you-should-watch","content":"OCSP and CRL publication and validity."},"1392":{"id":"/docs/pr-preview/pr-24/platform/pki/concepts/certificate-lifecycle-38","page_id":"/docs/pr-preview/pr-24/platform/pki/concepts/certificate-lifecycle","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/concepts/certificate-lifecycle#what-you-should-watch","content":"Dependencies still presenting a replaced certificate."},"1393":{"id":"/docs/pr-preview/pr-24/platform/pki/concepts/certificate-lifecycle-39","page_id":"/docs/pr-preview/pr-24/platform/pki/concepts/certificate-lifecycle","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/concepts/certificate-lifecycle#what-you-should-watch","content":"The device history relates its previous and current identities. For administrative changes and mutation errors, see Audit logs."},"1394":{"id":"/docs/pr-preview/pr-24/platform/pki/concepts/glossary","page_id":"/docs/pr-preview/pr-24/platform/pki/concepts/glossary","type":"page","content":"Glossary","breadcrumbs":["Docs","Platform","Concepts"],"tags":[],"url":"/docs/pr-preview/pr-24/platform/pki/concepts/glossary"},"1395":{"id":"/docs/pr-preview/pr-24/platform/pki/concepts/glossary-0","page_id":"/docs/pr-preview/pr-24/platform/pki/concepts/glossary","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/concepts/glossary","content":"PKI, certificate and identity management terms used in Lamassu."},"1396":{"id":"/docs/pr-preview/pr-24/platform/pki/concepts/glossary-1","page_id":"/docs/pr-preview/pr-24/platform/pki/concepts/glossary","type":"heading","tags":[],"url":"/docs/pr-preview/pr-24/platform/pki/concepts/glossary#ac","content":"A–C"},"1397":{"id":"/docs/pr-preview/pr-24/platform/pki/concepts/glossary-2","page_id":"/docs/pr-preview/pr-24/platform/pki/concepts/glossary","type":"heading","tags":[],"url":"/docs/pr-preview/pr-24/platform/pki/concepts/glossary#dk","content":"D–K"},"1398":{"id":"/docs/pr-preview/pr-24/platform/pki/concepts/glossary-3","page_id":"/docs/pr-preview/pr-24/platform/pki/concepts/glossary","type":"heading","tags":[],"url":"/docs/pr-preview/pr-24/platform/pki/concepts/glossary#mr","content":"M–R"},"1399":{"id":"/docs/pr-preview/pr-24/platform/pki/concepts/glossary-4","page_id":"/docs/pr-preview/pr-24/platform/pki/concepts/glossary","type":"heading","tags":[],"url":"/docs/pr-preview/pr-24/platform/pki/concepts/glossary#sz","content":"S–Z"},"1400":{"id":"/docs/pr-preview/pr-24/platform/pki/concepts/glossary-5","page_id":"/docs/pr-preview/pr-24/platform/pki/concepts/glossary","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/concepts/glossary#ac","content":"**AKI (Authority Key Identifier)**\\\nIdentifier of the public key of the authority that signed a certificate. It helps build the chain toward the correct issuer."},"1401":{"id":"/docs/pr-preview/pr-24/platform/pki/concepts/glossary-6","page_id":"/docs/pr-preview/pr-24/platform/pki/concepts/glossary","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/concepts/glossary#ac","content":"**Anchor of trust**\\\nA certificate, usually from a root CA, that a consumer explicitly accepts as the endpoint of a chain."},"1402":{"id":"/docs/pr-preview/pr-24/platform/pki/concepts/glossary-7","page_id":"/docs/pr-preview/pr-24/platform/pki/concepts/glossary","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/concepts/glossary#ac","content":"**CA (Certification Authority)**\\\nAuthority that signs certificates and binds an identity to a public key."},"1403":{"id":"/docs/pr-preview/pr-24/platform/pki/concepts/glossary-8","page_id":"/docs/pr-preview/pr-24/platform/pki/concepts/glossary","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/concepts/glossary#ac","content":"**Intermediate CA**\\\nA CA signed by another authority. Used to issue without exposing the root to daily operation."},"1404":{"id":"/docs/pr-preview/pr-24/platform/pki/concepts/glossary-9","page_id":"/docs/pr-preview/pr-24/platform/pki/concepts/glossary","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/concepts/glossary#ac","content":"**Root CA**\\\nA self-signed CA that starts a hierarchy of trust."},"1405":{"id":"/docs/pr-preview/pr-24/platform/pki/concepts/glossary-10","page_id":"/docs/pr-preview/pr-24/platform/pki/concepts/glossary","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/concepts/glossary#ac","content":"**X.509 certificate**\\\nA signed document containing a public key, a subject, an issuer, a validity period and extensions that constrain its use."},"1406":{"id":"/docs/pr-preview/pr-24/platform/pki/concepts/glossary-11","page_id":"/docs/pr-preview/pr-24/platform/pki/concepts/glossary","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/concepts/glossary#ac","content":"**CRL (Certificate Revocation List)**\\\nSigned list of revoked certificates published by a CA."},"1407":{"id":"/docs/pr-preview/pr-24/platform/pki/concepts/glossary-12","page_id":"/docs/pr-preview/pr-24/platform/pki/concepts/glossary","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/concepts/glossary#ac","content":"**CSR (Certificate Signing Request)**\\\nPKCS#10 request containing a public key and requested attributes. Signing the CSR proves possession of the corresponding private key."},"1408":{"id":"/docs/pr-preview/pr-24/platform/pki/concepts/glossary-13","page_id":"/docs/pr-preview/pr-24/platform/pki/concepts/glossary","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/concepts/glossary#dk","content":"**DMS (Device Management Service)**\\\nConfiguration that groups registration, enrollment, re-enrollment, issuance and CA distribution rules for a fleet."},"1409":{"id":"/docs/pr-preview/pr-24/platform/pki/concepts/glossary-14","page_id":"/docs/pr-preview/pr-24/platform/pki/concepts/glossary","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/concepts/glossary#dk","content":"**Distinguished Name (DN)**\\\nSet of subject or issuer attributes, such as `CN`, `O`, `OU`, `C`, `ST` and `L`."},"1410":{"id":"/docs/pr-preview/pr-24/platform/pki/concepts/glossary-15","page_id":"/docs/pr-preview/pr-24/platform/pki/concepts/glossary","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/concepts/glossary#dk","content":"**EST (Enrollment over Secure Transport)**\\\nProtocol defined in RFC 7030 to obtain CAs, enroll and re-enroll certificates over HTTPS."},"1411":{"id":"/docs/pr-preview/pr-24/platform/pki/concepts/glossary-16","page_id":"/docs/pr-preview/pr-24/platform/pki/concepts/glossary","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/concepts/glossary#dk","content":"**Extended Key Usage (EKU)**\\\nExtension that constrains purposes such as client authentication, server authentication, code signing or OCSP."},"1412":{"id":"/docs/pr-preview/pr-24/platform/pki/concepts/glossary-17","page_id":"/docs/pr-preview/pr-24/platform/pki/concepts/glossary","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/concepts/glossary#dk","content":"**Device identity**\\\nRelationship between a device and one of its certificates. A device can keep a history of identities."},"1413":{"id":"/docs/pr-preview/pr-24/platform/pki/concepts/glossary-18","page_id":"/docs/pr-preview/pr-24/platform/pki/concepts/glossary","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/concepts/glossary#dk","content":"**Identity slot**\\\nLogical position on a device where Lamassu binds an active or historical identity."},"1414":{"id":"/docs/pr-preview/pr-24/platform/pki/concepts/glossary-19","page_id":"/docs/pr-preview/pr-24/platform/pki/concepts/glossary","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/concepts/glossary#dk","content":"**JITP (Just-in-Time Provisioning)**\\\nAutomatic registration of a device when it successfully completes its first enrollment."},"1415":{"id":"/docs/pr-preview/pr-24/platform/pki/concepts/glossary-20","page_id":"/docs/pr-preview/pr-24/platform/pki/concepts/glossary","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/concepts/glossary#dk","content":"**KMS (Key Management Service)**\\\nLamassu service that normalizes key generation, import and use across different cryptographic engines."},"1416":{"id":"/docs/pr-preview/pr-24/platform/pki/concepts/glossary-21","page_id":"/docs/pr-preview/pr-24/platform/pki/concepts/glossary","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/concepts/glossary#dk","content":"**Key Usage**\\\nX.509 extension that allows basic operations such as digital signature, key encryption or certificate signing."},"1417":{"id":"/docs/pr-preview/pr-24/platform/pki/concepts/glossary-22","page_id":"/docs/pr-preview/pr-24/platform/pki/concepts/glossary","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/concepts/glossary#mr","content":"**mTLS (Mutual TLS)**\\\nTLS where both client and server present certificates. A DMS can use the client certificate as an authentication method."},"1418":{"id":"/docs/pr-preview/pr-24/platform/pki/concepts/glossary-23","page_id":"/docs/pr-preview/pr-24/platform/pki/concepts/glossary","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/concepts/glossary#mr","content":"**OCSP (Online Certificate Status Protocol)**\\\nProtocol for querying online whether a certificate is valid, revoked or unknown."},"1419":{"id":"/docs/pr-preview/pr-24/platform/pki/concepts/glossary-24","page_id":"/docs/pr-preview/pr-24/platform/pki/concepts/glossary","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/concepts/glossary#mr","content":"**Issuance profile**\\\nReusable policy that defines how Lamassu builds a certificate and which keys it accepts."},"1420":{"id":"/docs/pr-preview/pr-24/platform/pki/concepts/glossary-25","page_id":"/docs/pr-preview/pr-24/platform/pki/concepts/glossary","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/concepts/glossary#mr","content":"**Principal**\\\nOperator or API client identity recognized by the authorization service. Lamassu supports OIDC and X.509 principals."},"1421":{"id":"/docs/pr-preview/pr-24/platform/pki/concepts/glossary-26","page_id":"/docs/pr-preview/pr-24/platform/pki/concepts/glossary","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/concepts/glossary#mr","content":"**Policy**\\\nSet of permissions assignable to one or more principals."},"1422":{"id":"/docs/pr-preview/pr-24/platform/pki/concepts/glossary-27","page_id":"/docs/pr-preview/pr-24/platform/pki/concepts/glossary","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/concepts/glossary#mr","content":"**RA (Registration Authority)**\\\nComponent that verifies the requester before asking a CA to issue. The DMS plays this role in device enrollment flows."},"1423":{"id":"/docs/pr-preview/pr-24/platform/pki/concepts/glossary-28","page_id":"/docs/pr-preview/pr-24/platform/pki/concepts/glossary","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/concepts/glossary#mr","content":"**Relying party**\\\nConsuming system that decides whether to accept a presented certificate."},"1424":{"id":"/docs/pr-preview/pr-24/platform/pki/concepts/glossary-29","page_id":"/docs/pr-preview/pr-24/platform/pki/concepts/glossary","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/concepts/glossary#mr","content":"**Revocation**\\\nInvalidation of a certificate before its expiration date."},"1425":{"id":"/docs/pr-preview/pr-24/platform/pki/concepts/glossary-30","page_id":"/docs/pr-preview/pr-24/platform/pki/concepts/glossary","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/concepts/glossary#sz","content":"**SAN (Subject Alternative Name)**\\\nExtension that adds identities such as DNS names, IP addresses, emails or URIs."},"1426":{"id":"/docs/pr-preview/pr-24/platform/pki/concepts/glossary-31","page_id":"/docs/pr-preview/pr-24/platform/pki/concepts/glossary","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/concepts/glossary#sz","content":"**SKI (Subject Key Identifier)**\\\nIdentifier derived from the public key of the certificate itself."},"1427":{"id":"/docs/pr-preview/pr-24/platform/pki/concepts/glossary-32","page_id":"/docs/pr-preview/pr-24/platform/pki/concepts/glossary","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/concepts/glossary#sz","content":"**VA (Validation Authority)**\\\nLamassu service responsible for OCSP responses and the generation or publication of CRLs."},"1428":{"id":"/docs/pr-preview/pr-24/platform/pki/concepts/glossary-33","page_id":"/docs/pr-preview/pr-24/platform/pki/concepts/glossary","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/concepts/glossary#sz","content":"**Renewal window**\\\nPeriod before expiration during which a device may or must request another identity."},"1429":{"id":"/docs/pr-preview/pr-24/platform/pki/concepts/glossary-34","page_id":"/docs/pr-preview/pr-24/platform/pki/concepts/glossary","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/concepts/glossary#sz","content":"Missing an operational term? Check How Lamassu works and the Trust model first, where these concepts appear connected."},"1430":{"id":"/docs/pr-preview/pr-24/platform/pki/concepts/overview","page_id":"/docs/pr-preview/pr-24/platform/pki/concepts/overview","type":"page","content":"How Lamassu works","breadcrumbs":["Docs","Platform","Concepts"],"tags":[],"url":"/docs/pr-preview/pr-24/platform/pki/concepts/overview"},"1431":{"id":"/docs/pr-preview/pr-24/platform/pki/concepts/overview-0","page_id":"/docs/pr-preview/pr-24/platform/pki/concepts/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/concepts/overview","content":"The mental model of trust, keys, certificates and devices."},"1432":{"id":"/docs/pr-preview/pr-24/platform/pki/concepts/overview-1","page_id":"/docs/pr-preview/pr-24/platform/pki/concepts/overview","type":"heading","tags":[],"url":"/docs/pr-preview/pr-24/platform/pki/concepts/overview#the-model-in-five-pieces","content":"The model in five pieces"},"1433":{"id":"/docs/pr-preview/pr-24/platform/pki/concepts/overview-2","page_id":"/docs/pr-preview/pr-24/platform/pki/concepts/overview","type":"heading","tags":[],"url":"/docs/pr-preview/pr-24/platform/pki/concepts/overview#from-onboarding-to-operation","content":"From onboarding to operation"},"1434":{"id":"/docs/pr-preview/pr-24/platform/pki/concepts/overview-3","page_id":"/docs/pr-preview/pr-24/platform/pki/concepts/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/concepts/overview","content":"Lamassu connects three elements: a **root of trust**, an **issuance policy** and an **entity that needs to prove its identity**. The platform coordinates these elements throughout the certificate lifecycle."},"1435":{"id":"/docs/pr-preview/pr-24/platform/pki/concepts/overview-4","page_id":"/docs/pr-preview/pr-24/platform/pki/concepts/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/concepts/overview#the-model-in-five-pieces","content":"**Cryptographic engine.** Generates or safeguards keys and executes private-key operations without exposing key material to the rest of the services."},"1436":{"id":"/docs/pr-preview/pr-24/platform/pki/concepts/overview-5","page_id":"/docs/pr-preview/pr-24/platform/pki/concepts/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/concepts/overview#the-model-in-five-pieces","content":"**Certification Authority (CA).** Signs certificates and establishes the chain of trust."},"1437":{"id":"/docs/pr-preview/pr-24/platform/pki/concepts/overview-6","page_id":"/docs/pr-preview/pr-24/platform/pki/concepts/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/concepts/overview#the-model-in-five-pieces","content":"**Device Management Service (DMS).** Defines how the devices of a fleet are registered, authenticated and renewed."},"1438":{"id":"/docs/pr-preview/pr-24/platform/pki/concepts/overview-7","page_id":"/docs/pr-preview/pr-24/platform/pki/concepts/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/concepts/overview#the-model-in-five-pieces","content":"**Device.** Keeps its private key and presents the certificate to prove its identity."},"1439":{"id":"/docs/pr-preview/pr-24/platform/pki/concepts/overview-8","page_id":"/docs/pr-preview/pr-24/platform/pki/concepts/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/concepts/overview#the-model-in-five-pieces","content":"**Validation Authority (VA).** Publishes the status of certificates through OCSP and CRL."},"1440":{"id":"/docs/pr-preview/pr-24/platform/pki/concepts/overview-9","page_id":"/docs/pr-preview/pr-24/platform/pki/concepts/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/concepts/overview#from-onboarding-to-operation","content":"An administrator configures a cryptographic engine and creates or imports a CA."},"1441":{"id":"/docs/pr-preview/pr-24/platform/pki/concepts/overview-10","page_id":"/docs/pr-preview/pr-24/platform/pki/concepts/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/concepts/overview#from-onboarding-to-operation","content":"A DMS relates that CA to an enrollment policy."},"1442":{"id":"/docs/pr-preview/pr-24/platform/pki/concepts/overview-11","page_id":"/docs/pr-preview/pr-24/platform/pki/concepts/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/concepts/overview#from-onboarding-to-operation","content":"The device generates a key and requests a certificate through EST or CMP, or an operator assigns it an identity."},"1443":{"id":"/docs/pr-preview/pr-24/platform/pki/concepts/overview-12","page_id":"/docs/pr-preview/pr-24/platform/pki/concepts/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/concepts/overview#from-onboarding-to-operation","content":"Lamassu keeps the inventory, history and status of the identity."},"1444":{"id":"/docs/pr-preview/pr-24/platform/pki/concepts/overview-13","page_id":"/docs/pr-preview/pr-24/platform/pki/concepts/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/concepts/overview#from-onboarding-to-operation","content":"Consumers check the chain and query OCSP or a CRL when they need to know whether it is still valid."},"1445":{"id":"/docs/pr-preview/pr-24/platform/pki/concepts/overview-14","page_id":"/docs/pr-preview/pr-24/platform/pki/concepts/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/concepts/overview#from-onboarding-to-operation","content":"<Card title=\"Architecture\" description=\"Get to know the components and where each one's responsibility ends.\" href=\"/docs/platform/pki/concepts/architecture\" />"},"1446":{"id":"/docs/pr-preview/pr-24/platform/pki/concepts/overview-15","page_id":"/docs/pr-preview/pr-24/platform/pki/concepts/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/concepts/overview#from-onboarding-to-operation","content":"<Card title=\"Identity lifecycle\" description=\"Follow a certificate from enrollment to renewal or revocation.\" href=\"/docs/platform/pki/concepts/certificate-lifecycle\" />"},"1447":{"id":"/docs/pr-preview/pr-24/platform/pki/concepts/trust-model","page_id":"/docs/pr-preview/pr-24/platform/pki/concepts/trust-model","type":"page","content":"Trust model","breadcrumbs":["Docs","Platform","Concepts"],"tags":[],"url":"/docs/pr-preview/pr-24/platform/pki/concepts/trust-model"},"1448":{"id":"/docs/pr-preview/pr-24/platform/pki/concepts/trust-model-0","page_id":"/docs/pr-preview/pr-24/platform/pki/concepts/trust-model","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/concepts/trust-model","content":"Understand where trust originates, how it is distributed and what each component validates."},"1449":{"id":"/docs/pr-preview/pr-24/platform/pki/concepts/trust-model-1","page_id":"/docs/pr-preview/pr-24/platform/pki/concepts/trust-model","type":"heading","tags":[],"url":"/docs/pr-preview/pr-24/platform/pki/concepts/trust-model#the-four-trust-decisions","content":"The four trust decisions"},"1450":{"id":"/docs/pr-preview/pr-24/platform/pki/concepts/trust-model-2","page_id":"/docs/pr-preview/pr-24/platform/pki/concepts/trust-model","type":"heading","tags":[],"url":"/docs/pr-preview/pr-24/platform/pki/concepts/trust-model#who-can-issue","content":"Who can issue"},"1451":{"id":"/docs/pr-preview/pr-24/platform/pki/concepts/trust-model-3","page_id":"/docs/pr-preview/pr-24/platform/pki/concepts/trust-model","type":"heading","tags":[],"url":"/docs/pr-preview/pr-24/platform/pki/concepts/trust-model#what-can-be-issued","content":"What can be issued"},"1452":{"id":"/docs/pr-preview/pr-24/platform/pki/concepts/trust-model-4","page_id":"/docs/pr-preview/pr-24/platform/pki/concepts/trust-model","type":"heading","tags":[],"url":"/docs/pr-preview/pr-24/platform/pki/concepts/trust-model#who-can-request-it","content":"Who can request it"},"1453":{"id":"/docs/pr-preview/pr-24/platform/pki/concepts/trust-model-5","page_id":"/docs/pr-preview/pr-24/platform/pki/concepts/trust-model","type":"heading","tags":[],"url":"/docs/pr-preview/pr-24/platform/pki/concepts/trust-model#who-accepts-the-result","content":"Who accepts the result"},"1454":{"id":"/docs/pr-preview/pr-24/platform/pki/concepts/trust-model-6","page_id":"/docs/pr-preview/pr-24/platform/pki/concepts/trust-model","type":"heading","tags":[],"url":"/docs/pr-preview/pr-24/platform/pki/concepts/trust-model#identity-flow","content":"Identity flow"},"1455":{"id":"/docs/pr-preview/pr-24/platform/pki/concepts/trust-model-7","page_id":"/docs/pr-preview/pr-24/platform/pki/concepts/trust-model","type":"heading","tags":[],"url":"/docs/pr-preview/pr-24/platform/pki/concepts/trust-model#enrollment-validation-and-distribution-cas","content":"Enrollment, validation and distribution CAs"},"1456":{"id":"/docs/pr-preview/pr-24/platform/pki/concepts/trust-model-8","page_id":"/docs/pr-preview/pr-24/platform/pki/concepts/trust-model","type":"heading","tags":[],"url":"/docs/pr-preview/pr-24/platform/pki/concepts/trust-model#validation-and-revocation","content":"Validation and revocation"},"1457":{"id":"/docs/pr-preview/pr-24/platform/pki/concepts/trust-model-9","page_id":"/docs/pr-preview/pr-24/platform/pki/concepts/trust-model","type":"heading","tags":[],"url":"/docs/pr-preview/pr-24/platform/pki/concepts/trust-model#custody-limits","content":"Custody limits"},"1458":{"id":"/docs/pr-preview/pr-24/platform/pki/concepts/trust-model-10","page_id":"/docs/pr-preview/pr-24/platform/pki/concepts/trust-model","type":"heading","tags":[],"url":"/docs/pr-preview/pr-24/platform/pki/concepts/trust-model#recommended-pattern","content":"Recommended pattern"},"1459":{"id":"/docs/pr-preview/pr-24/platform/pki/concepts/trust-model-11","page_id":"/docs/pr-preview/pr-24/platform/pki/concepts/trust-model","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/concepts/trust-model","content":"In Lamassu, trust does not simply mean that a certificate exists in the inventory. A consumer trusts an identity when it can build a chain to a root it recognizes, check that the certificate is fit for the intended use and verify that it is still valid."},"1460":{"id":"/docs/pr-preview/pr-24/platform/pki/concepts/trust-model-12","page_id":"/docs/pr-preview/pr-24/platform/pki/concepts/trust-model","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/concepts/trust-model#who-can-issue","content":"The CA hierarchy defines which authorities can sign. A root CA establishes the anchor of trust; intermediate CAs separate operating domains and avoid using the root for every issuance."},"1461":{"id":"/docs/pr-preview/pr-24/platform/pki/concepts/trust-model-13","page_id":"/docs/pr-preview/pr-24/platform/pki/concepts/trust-model","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/concepts/trust-model#what-can-be-issued","content":"Certificate profiles limit validity, subject, uses, extensions and cryptographic parameters. Possessing a CA does not replace an issuance policy."},"1462":{"id":"/docs/pr-preview/pr-24/platform/pki/concepts/trust-model-14","page_id":"/docs/pr-preview/pr-24/platform/pki/concepts/trust-model","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/concepts/trust-model#who-can-request-it","content":"The DMS acts as the enrollment point. It can authenticate an EST request with a client certificate, an external webhook or a combination of both. CAs configured to validate the requester do not have to be the CA that will issue the new identity."},"1463":{"id":"/docs/pr-preview/pr-24/platform/pki/concepts/trust-model-15","page_id":"/docs/pr-preview/pr-24/platform/pki/concepts/trust-model","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/concepts/trust-model#who-accepts-the-result","content":"The consuming service or device keeps its own trust store. Lamassu can distribute the system CA, the enrollment CA and other managed CAs through `/cacerts`, but the consumer decides which ones it installs and how it applies validation."},"1464":{"id":"/docs/pr-preview/pr-24/platform/pki/concepts/trust-model-16","page_id":"/docs/pr-preview/pr-24/platform/pki/concepts/trust-model","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/concepts/trust-model#identity-flow","content":"The device proves it can enroll according to the DMS policy."},"1465":{"id":"/docs/pr-preview/pr-24/platform/pki/concepts/trust-model-17","page_id":"/docs/pr-preview/pr-24/platform/pki/concepts/trust-model","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/concepts/trust-model#identity-flow","content":"The DMS validates the request and forwards the CSR to the enrollment CA."},"1466":{"id":"/docs/pr-preview/pr-24/platform/pki/concepts/trust-model-18","page_id":"/docs/pr-preview/pr-24/platform/pki/concepts/trust-model","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/concepts/trust-model#identity-flow","content":"The CA applies the profile and signs without ever receiving the device's private key."},"1467":{"id":"/docs/pr-preview/pr-24/platform/pki/concepts/trust-model-19","page_id":"/docs/pr-preview/pr-24/platform/pki/concepts/trust-model","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/concepts/trust-model#identity-flow","content":"The device installs the certificate and the chain it needs."},"1468":{"id":"/docs/pr-preview/pr-24/platform/pki/concepts/trust-model-20","page_id":"/docs/pr-preview/pr-24/platform/pki/concepts/trust-model","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/concepts/trust-model#identity-flow","content":"The system that trusts the device validates the chain, dates, uses and revocation status."},"1469":{"id":"/docs/pr-preview/pr-24/platform/pki/concepts/trust-model-21","page_id":"/docs/pr-preview/pr-24/platform/pki/concepts/trust-model","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/concepts/trust-model#identity-flow","content":"OIDC or X.509 identifies the operator calling Lamassu. The authorization service decides which actions it may perform. The X.509 hierarchy, on the other hand, determines whether a certificate presented by a device is trustworthy."},"1470":{"id":"/docs/pr-preview/pr-24/platform/pki/concepts/trust-model-22","page_id":"/docs/pr-preview/pr-24/platform/pki/concepts/trust-model","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/concepts/trust-model#enrollment-validation-and-distribution-cas","content":"A DMS relates three sets that are worth designing separately:"},"1471":{"id":"/docs/pr-preview/pr-24/platform/pki/concepts/trust-model-23","page_id":"/docs/pr-preview/pr-24/platform/pki/concepts/trust-model","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/concepts/trust-model#enrollment-validation-and-distribution-cas","content":"**Enrollment CA:** signs the new identities."},"1472":{"id":"/docs/pr-preview/pr-24/platform/pki/concepts/trust-model-24","page_id":"/docs/pr-preview/pr-24/platform/pki/concepts/trust-model","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/concepts/trust-model#enrollment-validation-and-distribution-cas","content":"**Validation CAs:** authenticate the client certificates used for enrollment or migration. During re-enrollment, Lamassu tries the enrollment CA first and then the additional validation CAs."},"1473":{"id":"/docs/pr-preview/pr-24/platform/pki/concepts/trust-model-25","page_id":"/docs/pr-preview/pr-24/platform/pki/concepts/trust-model","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/concepts/trust-model#enrollment-validation-and-distribution-cas","content":"**Distributed CAs:** form the content the device obtains through EST `/cacerts`. You can include the system CA, the enrollment CA and a list of managed CAs."},"1474":{"id":"/docs/pr-preview/pr-24/platform/pki/concepts/trust-model-26","page_id":"/docs/pr-preview/pr-24/platform/pki/concepts/trust-model","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/concepts/trust-model#enrollment-validation-and-distribution-cas","content":"This separation makes it possible to migrate a fleet: you temporarily accept certificates from the old hierarchy, issue with the new one and distribute both chains during the overlap."},"1475":{"id":"/docs/pr-preview/pr-24/platform/pki/concepts/trust-model-27","page_id":"/docs/pr-preview/pr-24/platform/pki/concepts/trust-model","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/concepts/trust-model#validation-and-revocation","content":"A valid chain does not by itself guarantee that a certificate should be accepted. The consumer must also check:"},"1476":{"id":"/docs/pr-preview/pr-24/platform/pki/concepts/trust-model-28","page_id":"/docs/pr-preview/pr-24/platform/pki/concepts/trust-model","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/concepts/trust-model#validation-and-revocation","content":"that the current date is between `Not Before` and `Not After`;"},"1477":{"id":"/docs/pr-preview/pr-24/platform/pki/concepts/trust-model-29","page_id":"/docs/pr-preview/pr-24/platform/pki/concepts/trust-model","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/concepts/trust-model#validation-and-revocation","content":"that `Key Usage` and `Extended Key Usage` allow the operation;"},"1478":{"id":"/docs/pr-preview/pr-24/platform/pki/concepts/trust-model-30","page_id":"/docs/pr-preview/pr-24/platform/pki/concepts/trust-model","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/concepts/trust-model#validation-and-revocation","content":"that names, SANs and subject match the expected identity;"},"1479":{"id":"/docs/pr-preview/pr-24/platform/pki/concepts/trust-model-31","page_id":"/docs/pr-preview/pr-24/platform/pki/concepts/trust-model","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/concepts/trust-model#validation-and-revocation","content":"that the certificate does not appear revoked in OCSP or a CRL."},"1480":{"id":"/docs/pr-preview/pr-24/platform/pki/concepts/trust-model-32","page_id":"/docs/pr-preview/pr-24/platform/pki/concepts/trust-model","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/concepts/trust-model#validation-and-revocation","content":"During the mTLS authentication of a DMS, Lamassu attempts to check revocation. If the certificate does not contain enough information to perform that check, the backend logs a warning and continues treating it as not revoked. Design your profiles and distribution points to avoid that situation in production."},"1481":{"id":"/docs/pr-preview/pr-24/platform/pki/concepts/trust-model-33","page_id":"/docs/pr-preview/pr-24/platform/pki/concepts/trust-model","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/concepts/trust-model#custody-limits","content":"The KMS keeps the reference to the key and delegates the operation to the configured engine. With an HSM or a cloud KMS, the private key can remain non-exportable. That protects custody, but it does not by itself prevent misuse: you still must restrict who can request a signature and audit those operations."},"1482":{"id":"/docs/pr-preview/pr-24/platform/pki/concepts/trust-model-34","page_id":"/docs/pr-preview/pr-24/platform/pki/concepts/trust-model","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/concepts/trust-model#recommended-pattern","content":"Keep the root out of daily operations, or with very restricted access."},"1483":{"id":"/docs/pr-preview/pr-24/platform/pki/concepts/trust-model-35","page_id":"/docs/pr-preview/pr-24/platform/pki/concepts/trust-model","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/concepts/trust-model#recommended-pattern","content":"Issue from intermediate CAs separated by environment or risk domain."},"1484":{"id":"/docs/pr-preview/pr-24/platform/pki/concepts/trust-model-36","page_id":"/docs/pr-preview/pr-24/platform/pki/concepts/trust-model","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/concepts/trust-model#recommended-pattern","content":"Assign explicit profiles to every use case."},"1485":{"id":"/docs/pr-preview/pr-24/platform/pki/concepts/trust-model-37","page_id":"/docs/pr-preview/pr-24/platform/pki/concepts/trust-model","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/concepts/trust-model#recommended-pattern","content":"Distribute the new trust before starting a rotation."},"1486":{"id":"/docs/pr-preview/pr-24/platform/pki/concepts/trust-model-38","page_id":"/docs/pr-preview/pr-24/platform/pki/concepts/trust-model","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/concepts/trust-model#recommended-pattern","content":"Keep enough overlap to renew a disconnected fleet."},"1487":{"id":"/docs/pr-preview/pr-24/platform/pki/concepts/trust-model-39","page_id":"/docs/pr-preview/pr-24/platform/pki/concepts/trust-model","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/concepts/trust-model#recommended-pattern","content":"Validate from the consuming system, not only from the Lamassu console."},"1488":{"id":"/docs/pr-preview/pr-24/platform/pki/concepts/trust-model-40","page_id":"/docs/pr-preview/pr-24/platform/pki/concepts/trust-model","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/concepts/trust-model#recommended-pattern","content":"Continue with CA hierarchy and rotation to turn this model into an operating procedure."},"1489":{"id":"/docs/pr-preview/pr-24/platform/pki/crl","page_id":"/docs/pr-preview/pr-24/platform/pki/crl","type":"page","content":"Revocation lists (CRL)","breadcrumbs":["Docs","Platform","Operate Lamassu"],"tags":[],"url":"/docs/pr-preview/pr-24/platform/pki/crl"},"1490":{"id":"/docs/pr-preview/pr-24/platform/pki/crl-0","page_id":"/docs/pr-preview/pr-24/platform/pki/crl","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/crl","content":"Generate and distribute signed lists to validate certificates offline."},"1491":{"id":"/docs/pr-preview/pr-24/platform/pki/crl-1","page_id":"/docs/pr-preview/pr-24/platform/pki/crl","type":"heading","tags":[],"url":"/docs/pr-preview/pr-24/platform/pki/crl#crl-service","content":"CRL service"},"1492":{"id":"/docs/pr-preview/pr-24/platform/pki/crl-2","page_id":"/docs/pr-preview/pr-24/platform/pki/crl","type":"heading","tags":[],"url":"/docs/pr-preview/pr-24/platform/pki/crl#va-role-and-per-ca-configuration","content":"VA role and per-CA configuration"},"1493":{"id":"/docs/pr-preview/pr-24/platform/pki/crl-3","page_id":"/docs/pr-preview/pr-24/platform/pki/crl","type":"heading","tags":[],"url":"/docs/pr-preview/pr-24/platform/pki/crl#periodic-and-automatic-regeneration","content":"Periodic and automatic regeneration"},"1494":{"id":"/docs/pr-preview/pr-24/platform/pki/crl-4","page_id":"/docs/pr-preview/pr-24/platform/pki/crl","type":"heading","tags":[],"url":"/docs/pr-preview/pr-24/platform/pki/crl#crl-contents","content":"CRL contents"},"1495":{"id":"/docs/pr-preview/pr-24/platform/pki/crl-5","page_id":"/docs/pr-preview/pr-24/platform/pki/crl","type":"heading","tags":[],"url":"/docs/pr-preview/pr-24/platform/pki/crl#public-download-endpoint","content":"Public download endpoint"},"1496":{"id":"/docs/pr-preview/pr-24/platform/pki/crl-6","page_id":"/docs/pr-preview/pr-24/platform/pki/crl","type":"heading","tags":[],"url":"/docs/pr-preview/pr-24/platform/pki/crl#va-role-management-api","content":"VA role management API"},"1497":{"id":"/docs/pr-preview/pr-24/platform/pki/crl-7","page_id":"/docs/pr-preview/pr-24/platform/pki/crl","type":"heading","tags":[],"url":"/docs/pr-preview/pr-24/platform/pki/crl#from-the-interface","content":"From the interface"},"1498":{"id":"/docs/pr-preview/pr-24/platform/pki/crl-8","page_id":"/docs/pr-preview/pr-24/platform/pki/crl","type":"heading","tags":[],"url":"/docs/pr-preview/pr-24/platform/pki/crl#references","content":"References"},"1499":{"id":"/docs/pr-preview/pr-24/platform/pki/crl-9","page_id":"/docs/pr-preview/pr-24/platform/pki/crl","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/crl#crl-service","content":"A CRL (*Certificate Revocation List*) is a signed list containing the serial numbers of certificates revoked before their expiration date. Unlike OCSP, it does not require a real-time query: the relying party downloads the list periodically and consults it locally."},"1500":{"id":"/docs/pr-preview/pr-24/platform/pki/crl-10","page_id":"/docs/pr-preview/pr-24/platform/pki/crl","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/crl#crl-service","content":"Lamassu generates and maintains one CRL per CA it manages. Each CRL is signed with the private key of the issuing CA itself and is stored in the object storage configured on the platform."},"1501":{"id":"/docs/pr-preview/pr-24/platform/pki/crl-11","page_id":"/docs/pr-preview/pr-24/platform/pki/crl","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/crl#va-role-and-per-ca-configuration","content":"The publication of each CA's CRL is controlled by a *VA role*. This object defines how it is generated, when it is regenerated and which key signs it."},"1502":{"id":"/docs/pr-preview/pr-24/platform/pki/crl-12","page_id":"/docs/pr-preview/pr-24/platform/pki/crl","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/crl#va-role-and-per-ca-configuration","content":"The main parameters are:"},"1503":{"id":"/docs/pr-preview/pr-24/platform/pki/crl-13","page_id":"/docs/pr-preview/pr-24/platform/pki/crl","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/crl#va-role-and-per-ca-configuration","content":"**`validity`** defines the validity period reflected in `nextUpdate`. Its default value is 7 days."},"1504":{"id":"/docs/pr-preview/pr-24/platform/pki/crl-14","page_id":"/docs/pr-preview/pr-24/platform/pki/crl","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/crl#va-role-and-per-ca-configuration","content":"**`refresh_interval`** sets the minimum interval between scheduled regenerations. By default it is approximately 6 days and 23 hours."},"1505":{"id":"/docs/pr-preview/pr-24/platform/pki/crl-15","page_id":"/docs/pr-preview/pr-24/platform/pki/crl","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/crl#va-role-and-per-ca-configuration","content":"**`regenerate_on_revoke`** orders publishing a new version immediately after a revocation. It is enabled by default."},"1506":{"id":"/docs/pr-preview/pr-24/platform/pki/crl-16","page_id":"/docs/pr-preview/pr-24/platform/pki/crl","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/crl#va-role-and-per-ca-configuration","content":"The `subject_key_id_signer` field identifies the CA whose private key signs the CRL. By default, each CA signs its own CRL."},"1507":{"id":"/docs/pr-preview/pr-24/platform/pki/crl-17","page_id":"/docs/pr-preview/pr-24/platform/pki/crl","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/crl#va-role-and-per-ca-configuration","content":"Each CRL carries an incremental version number. Lamassu stores all versions under the path `pki/va/crl/{subject_key_id}/{version}.crl` in object storage."},"1508":{"id":"/docs/pr-preview/pr-24/platform/pki/crl-18","page_id":"/docs/pr-preview/pr-24/platform/pki/crl","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/crl#periodic-and-automatic-regeneration","content":"A background process monitors active VA roles. When the remaining validity of the current CRL falls below the configured watch period (*blind period*), the system requests the generation of a new CRL. This prevents the published CRL from expiring without a valid version available."},"1509":{"id":"/docs/pr-preview/pr-24/platform/pki/crl-19","page_id":"/docs/pr-preview/pr-24/platform/pki/crl","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/crl#periodic-and-automatic-regeneration","content":"Additionally, when `regenerate_on_revoke` is enabled, which is the default behavior, any certificate revocation immediately triggers the generation of a new CRL for the affected CA. This minimizes the time between revocation and its publication."},"1510":{"id":"/docs/pr-preview/pr-24/platform/pki/crl-20","page_id":"/docs/pr-preview/pr-24/platform/pki/crl","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/crl#crl-contents","content":"Each entry of the CRL includes the serial number of the revoked certificate, the revocation date and the RFC 5280 reason code."},"1511":{"id":"/docs/pr-preview/pr-24/platform/pki/crl-21","page_id":"/docs/pr-preview/pr-24/platform/pki/crl","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/crl#crl-contents","content":"The CRL also includes the *Issuing Distribution Point* (IDP, OID 2.5.29.28) extension, marked as critical, which indicates the public URL from which it can be downloaded. That URL points to the `/crl/{subject_key_id}` endpoint of each configured VA domain."},"1512":{"id":"/docs/pr-preview/pr-24/platform/pki/crl-22","page_id":"/docs/pr-preview/pr-24/platform/pki/crl","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/crl#public-download-endpoint","content":"The latest CRL of a CA can be obtained directly without authentication:"},"1513":{"id":"/docs/pr-preview/pr-24/platform/pki/crl-23","page_id":"/docs/pr-preview/pr-24/platform/pki/crl","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/crl#public-download-endpoint","content":"The response has `Content-Type: application/pkix-crl` and contains the CRL in DER format."},"1514":{"id":"/docs/pr-preview/pr-24/platform/pki/crl-24","page_id":"/docs/pr-preview/pr-24/platform/pki/crl","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/crl#va-role-management-api","content":"The VA role of a CA can be queried and updated through the API:"},"1515":{"id":"/docs/pr-preview/pr-24/platform/pki/crl-25","page_id":"/docs/pr-preview/pr-24/platform/pki/crl","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/crl#va-role-management-api","content":"Method"},"1516":{"id":"/docs/pr-preview/pr-24/platform/pki/crl-26","page_id":"/docs/pr-preview/pr-24/platform/pki/crl","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/crl#va-role-management-api","content":"Path"},"1517":{"id":"/docs/pr-preview/pr-24/platform/pki/crl-27","page_id":"/docs/pr-preview/pr-24/platform/pki/crl","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/crl#va-role-management-api","content":"Description"},"1518":{"id":"/docs/pr-preview/pr-24/platform/pki/crl-28","page_id":"/docs/pr-preview/pr-24/platform/pki/crl","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/crl#va-role-management-api","content":"`GET`"},"1519":{"id":"/docs/pr-preview/pr-24/platform/pki/crl-29","page_id":"/docs/pr-preview/pr-24/platform/pki/crl","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/crl#va-role-management-api","content":"`/v1/roles/{ca-ski}`"},"1520":{"id":"/docs/pr-preview/pr-24/platform/pki/crl-30","page_id":"/docs/pr-preview/pr-24/platform/pki/crl","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/crl#va-role-management-api","content":"Returns the VA role configuration and the metadata of the last issued CRL."},"1521":{"id":"/docs/pr-preview/pr-24/platform/pki/crl-31","page_id":"/docs/pr-preview/pr-24/platform/pki/crl","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/crl#va-role-management-api","content":"`PUT`"},"1522":{"id":"/docs/pr-preview/pr-24/platform/pki/crl-32","page_id":"/docs/pr-preview/pr-24/platform/pki/crl","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/crl#va-role-management-api","content":"`/v1/roles/{ca-ski}`"},"1523":{"id":"/docs/pr-preview/pr-24/platform/pki/crl-33","page_id":"/docs/pr-preview/pr-24/platform/pki/crl","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/crl#va-role-management-api","content":"Updates