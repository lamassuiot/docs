-24/platform/pki/cmp#protocol-selection","content":"`EST_RFC7030`"},"897":{"id":"/docs/pr-preview/pr-24/platform/pki/cmp-86","page_id":"/docs/pr-preview/pr-24/platform/pki/cmp","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/cmp#protocol-selection","content":"EST — see the EST guide"},"898":{"id":"/docs/pr-preview/pr-24/platform/pki/cmp-87","page_id":"/docs/pr-preview/pr-24/platform/pki/cmp","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/cmp#protocol-selection","content":"`CMP_RFC9483`"},"899":{"id":"/docs/pr-preview/pr-24/platform/pki/cmp-88","page_id":"/docs/pr-preview/pr-24/platform/pki/cmp","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/cmp#protocol-selection","content":"CMP — this page"},"900":{"id":"/docs/pr-preview/pr-24/platform/pki/cmp-89","page_id":"/docs/pr-preview/pr-24/platform/pki/cmp","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/cmp#protocol-selection","content":"Any value other than these two makes DMS creation or edition fail with the error `DMS enrollment protocol must be EST_RFC7030 or CMP_RFC9483`. When the `protocol` of an existing DMS changes, the outgoing protocol's block is discarded entirely and replaced by the incoming one: each protocol's settings are self-contained and are not copied across."},"901":{"id":"/docs/pr-preview/pr-24/platform/pki/cmp-90","page_id":"/docs/pr-preview/pr-24/platform/pki/cmp","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/cmp#settings-shared-with-est","content":"These fields are common to both protocols and mean the same in each:"},"902":{"id":"/docs/pr-preview/pr-24/platform/pki/cmp-91","page_id":"/docs/pr-preview/pr-24/platform/pki/cmp","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/cmp#settings-shared-with-est","content":"Field"},"903":{"id":"/docs/pr-preview/pr-24/platform/pki/cmp-92","page_id":"/docs/pr-preview/pr-24/platform/pki/cmp","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/cmp#settings-shared-with-est","content":"Description"},"904":{"id":"/docs/pr-preview/pr-24/platform/pki/cmp-93","page_id":"/docs/pr-preview/pr-24/platform/pki/cmp","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/cmp#settings-shared-with-est","content":"`enrollment_ca`"},"905":{"id":"/docs/pr-preview/pr-24/platform/pki/cmp-94","page_id":"/docs/pr-preview/pr-24/platform/pki/cmp","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/cmp#settings-shared-with-est","content":"CA that will sign the identity certificates issued by this DMS."},"906":{"id":"/docs/pr-preview/pr-24/platform/pki/cmp-95","page_id":"/docs/pr-preview/pr-24/platform/pki/cmp","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/cmp#settings-shared-with-est","content":"`registration_mode`"},"907":{"id":"/docs/pr-preview/pr-24/platform/pki/cmp-96","page_id":"/docs/pr-preview/pr-24/platform/pki/cmp","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/cmp#settings-shared-with-est","content":"`JITP` (*Just-In-Time Provisioning*) creates the device automatically on the first enrollment, applying the provisioning profile; `PRE_REGISTRATION` requires the device to exist beforehand and rejects anything else with `device not preregistered`."},"908":{"id":"/docs/pr-preview/pr-24/platform/pki/cmp-97","page_id":"/docs/pr-preview/pr-24/platform/pki/cmp","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/cmp#settings-shared-with-est","content":"`device_provisioning_profile`"},"909":{"id":"/docs/pr-preview/pr-24/platform/pki/cmp-98","page_id":"/docs/pr-preview/pr-24/platform/pki/cmp","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/cmp#settings-shared-with-est","content":"Icon, color, metadata and tags applied to each device created in JITP mode."},"910":{"id":"/docs/pr-preview/pr-24/platform/pki/cmp-99","page_id":"/docs/pr-preview/pr-24/platform/pki/cmp","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/cmp#settings-shared-with-est","content":"`enable_replaceable_enrollment`"},"911":{"id":"/docs/pr-preview/pr-24/platform/pki/cmp-100","page_id":"/docs/pr-preview/pr-24/platform/pki/cmp","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/cmp#settings-shared-with-est","content":"Allows an already-enrolled device to enroll again. When inactive, a second `ir`/`cr` attempt against an existing device is rejected with `forbiddenNewEnrollment`. Whether replacing the identity revokes the previous certificate (with the reason `superseded`) is decided by `revoke_on_reenrollment`, or by `cr`'s `certificate_behavior` — see Re-enrollment configuration."},"912":{"id":"/docs/pr-preview/pr-24/platform/pki/cmp-101","page_id":"/docs/pr-preview/pr-24/platform/pki/cmp","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/cmp#settings-shared-with-est","content":"`verify_csr_signature`"},"913":{"id":"/docs/pr-preview/pr-24/platform/pki/cmp-102","page_id":"/docs/pr-preview/pr-24/platform/pki/cmp","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/cmp#settings-shared-with-est","content":"**No effect in CMP.** The server synthesizes the CSR from the `CertTemplate` (its signature is replaced with a dummy value) and proof of possession is established through other means: the POPO of `ir`/`cr`, the PKCS#10 CSR of `p10cr` (always verified) or the protection of `kur`."},"914":{"id":"/docs/pr-preview/pr-24/platform/pki/cmp-103","page_id":"/docs/pr-preview/pr-24/platform/pki/cmp","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/cmp#authentication-mode","content":"`auth_mode` defines how the DMS validates the requester's identity. CMP recognizes the same four modes as EST, but the mechanism changes: **authentication is verified inside the CMP message itself, not at the transport layer**."},"915":{"id":"/docs/pr-preview/pr-24/platform/pki/cmp-104","page_id":"/docs/pr-preview/pr-24/platform/pki/cmp","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/cmp#authentication-mode","content":"Mode"},"916":{"id":"/docs/pr-preview/pr-24/platform/pki/cmp-105","page_id":"/docs/pr-preview/pr-24/platform/pki/cmp","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/cmp#authentication-mode","content":"Description"},"917":{"id":"/docs/pr-preview/pr-24/platform/pki/cmp-106","page_id":"/docs/pr-preview/pr-24/platform/pki/cmp","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/cmp#authentication-mode","content":"`CLIENT_CERTIFICATE`"},"918":{"id":"/docs/pr-preview/pr-24/platform/pki/cmp-107","page_id":"/docs/pr-preview/pr-24/platform/pki/cmp","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/cmp#authentication-mode","content":"The message must be **protected by signature** with the device's certificate (`extraCerts[0]` of the `PKIMessage`), validated against the CAs declared in `client_certificate_settings.validation_cas`. This is not mTLS: it is the signature over the `PKIMessage` (RFC 9483 §3.2)."},"919":{"id":"/docs/pr-preview/pr-24/platform/pki/cmp-108","page_id":"/docs/pr-preview/pr-24/platform/pki/cmp","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/cmp#authentication-mode","content":"`CLIENT_CERTIFICATE_AND_EXTERNAL_WEBHOOK`"},"920":{"id":"/docs/pr-preview/pr-24/platform/pki/cmp-109","page_id":"/docs/pr-preview/pr-24/platform/pki/cmp","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/cmp#authentication-mode","content":"Combines both controls: valid signature **and** webhook approval."},"921":{"id":"/docs/pr-preview/pr-24/platform/pki/cmp-110","page_id":"/docs/pr-preview/pr-24/platform/pki/cmp","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/cmp#authentication-mode","content":"`EXTERNAL_WEBHOOK`"},"922":{"id":"/docs/pr-preview/pr-24/platform/pki/cmp-111","page_id":"/docs/pr-preview/pr-24/platform/pki/cmp","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/cmp#authentication-mode","content":"The authorization decision is delegated to an external HTTP service, with the same contract as in EST. The message may arrive unprotected."},"923":{"id":"/docs/pr-preview/pr-24/platform/pki/cmp-112","page_id":"/docs/pr-preview/pr-24/platform/pki/cmp","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/cmp#authentication-mode","content":"`NO_AUTH`"},"924":{"id":"/docs/pr-preview/pr-24/platform/pki/cmp-113","page_id":"/docs/pr-preview/pr-24/platform/pki/cmp","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/cmp#authentication-mode","content":"No mandatory authentication. The message may arrive unprotected; if it carries a signature, it is still validated. &#x2A;*For laboratories or isolated provisioning networks only.**"},"925":{"id":"/docs/pr-preview/pr-24/platform/pki/cmp-114","page_id":"/docs/pr-preview/pr-24/platform/pki/cmp","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/cmp#authentication-mode","content":"A DMS whose `auth_mode` is empty or undefined is considered misconfigured: every request is rejected with `DMS auth mode not supported`, instead of being accepted unauthenticated. The value `NONE` is accepted as a legacy alias of `NO_AUTH` from the admin console."},"926":{"id":"/docs/pr-preview/pr-24/platform/pki/cmp-115","page_id":"/docs/pr-preview/pr-24/platform/pki/cmp","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/cmp#authentication-mode","content":"When the mode includes `CLIENT_CERTIFICATE`, the same parameters as in EST are configured: **Validation CAs**, **Chain Validation Level** (`-1` validates the full chain) and **Allow Authenticating Expired Certificates**. When it includes `EXTERNAL_WEBHOOK`, the same webhook parameters as in EST are configured (URL, method, timeout — 10 seconds by default — and the webhook's authentication mode). The webhook service contract is identical in both protocols; see the equivalent section of the EST guide for the detail of each field and the authorization webhook reference for the schema."},"927":{"id":"/docs/pr-preview/pr-24/platform/pki/cmp-116","page_id":"/docs/pr-preview/pr-24/platform/pki/cmp","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/cmp#authentication-mode","content":"Unlike EST, CMP has no separate authentication mode for renewal: `kur` is always authenticated with the signature protection of the certificate being renewed."},"928":{"id":"/docs/pr-preview/pr-24/platform/pki/cmp-117","page_id":"/docs/pr-preview/pr-24/platform/pki/cmp","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/cmp#confirmation-and-issuance-flow","content":"Unlike EST, CMP includes an explicit confirmation protocol (RFC 4210 §5.2.8) and supports a deferred-approval flow:"},"929":{"id":"/docs/pr-preview/pr-24/platform/pki/cmp-118","page_id":"/docs/pr-preview/pr-24/platform/pki/cmp","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/cmp#confirmation-and-issuance-flow","content":"Field"},"930":{"id":"/docs/pr-preview/pr-24/platform/pki/cmp-119","page_id":"/docs/pr-preview/pr-24/platform/pki/cmp","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/cmp#confirmation-and-issuance-flow","content":"Type"},"931":{"id":"/docs/pr-preview/pr-24/platform/pki/cmp-120","page_id":"/docs/pr-preview/pr-24/platform/pki/cmp","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/cmp#confirmation-and-issuance-flow","content":"Description"},"932":{"id":"/docs/pr-preview/pr-24/platform/pki/cmp-121","page_id":"/docs/pr-preview/pr-24/platform/pki/cmp","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/cmp#confirmation-and-issuance-flow","content":"`accept_implicit`"},"933":{"id":"/docs/pr-preview/pr-24/platform/pki/cmp-122","page_id":"/docs/pr-preview/pr-24/platform/pki/cmp","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/cmp#confirmation-and-issuance-flow","content":"boolean"},"934":{"id":"/docs/pr-preview/pr-24/platform/pki/cmp-123","page_id":"/docs/pr-preview/pr-24/platform/pki/cmp","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/cmp#confirmation-and-issuance-flow","content":"Allows **skipping** the `certConf` step when the device requests implicit confirmation (`id-it-implicitConfirm` in `generalInfo`). It only takes effect if the device also requests it; the request alone does not force it. Disabled by default."},"935":{"id":"/docs/pr-preview/pr-24/platform/pki/cmp-124","page_id":"/docs/pr-preview/pr-24/platform/pki/cmp","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/cmp#confirmation-and-issuance-flow","content":"`confirmation_timeout`"},"936":{"id":"/docs/pr-preview/pr-24/platform/pki/cmp-125","page_id":"/docs/pr-preview/pr-24/platform/pki/cmp","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/cmp#confirmation-and-issuance-flow","content":"duration"},"937":{"id":"/docs/pr-preview/pr-24/platform/pki/cmp-126","page_id":"/docs/pr-preview/pr-24/platform/pki/cmp","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/cmp#confirmation-and-issuance-flow","content":"Waiting window for the `certConf` (for example `30s`, `5m`, `1h`). A zero or negative value uses the default: **5 minutes**."},"938":{"id":"/docs/pr-preview/pr-24/platform/pki/cmp-127","page_id":"/docs/pr-preview/pr-24/platform/pki/cmp","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/cmp#confirmation-and-issuance-flow","content":"`workflow`"},"939":{"id":"/docs/pr-preview/pr-24/platform/pki/cmp-128","page_id":"/docs/pr-preview/pr-24/platform/pki/cmp","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/cmp#confirmation-and-issuance-flow","content":"`direct` / `phased`"},"940":{"id":"/docs/pr-preview/pr-24/platform/pki/cmp-129","page_id":"/docs/pr-preview/pr-24/platform/pki/cmp","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/cmp#confirmation-and-issuance-flow","content":"`direct` (default) issues the certificate online, in the same response to `ir`/`cr`/`kur`/`p10cr`. `phased` holds the request until an administrator approves it; the device retrieves the result with `pollReq`. Server-side key generation and cross-certification have their own flow and do not depend on this field."},"941":{"id":"/docs/pr-preview/pr-24/platform/pki/cmp-130","page_id":"/docs/pr-preview/pr-24/platform/pki/cmp","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/cmp#confirmation-and-issuance-flow","content":"`approval_timeout`"},"942":{"id":"/docs/pr-preview/pr-24/platform/pki/cmp-131","page_id":"/docs/pr-preview/pr-24/platform/pki/cmp","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/cmp#confirmation-and-issuance-flow","content":"duration"},"943":{"id":"/docs/pr-preview/pr-24/platform/pki/cmp-132","page_id":"/docs/pr-preview/pr-24/platform/pki/cmp","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/cmp#confirmation-and-issuance-flow","content":"Only applies with `workflow: phased`. Time a transaction remains `PENDING` awaiting approval. With no value, the default is **7 days**."},"944":{"id":"/docs/pr-preview/pr-24/platform/pki/cmp-133","page_id":"/docs/pr-preview/pr-24/platform/pki/cmp","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/cmp#protection-certificate-and-proof-of-possession","content":"**Protection Certificate** (`protection_certificate`): serial number of the End Entity certificate, backed by the KMS, with which the DMS protects (signs) its CMP responses. The server does not require it, but without it **every** response — including error messages — goes out unprotected, and standard CMP clients (`openssl cmp` included) reject unprotected responses by default. In practice it is essential."},"945":{"id":"/docs/pr-preview/pr-24/platform/pki/cmp-134","page_id":"/docs/pr-preview/pr-24/platform/pki/cmp","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/cmp#protection-certificate-and-proof-of-possession","content":"**Enforce POPO** (`enforce_popo`): a legacy option that **no longer governs any verification**. The proof-of-possession policy of `ir`/`cr` lives in its per-operation block (`proof_of_possession.required`), `kur` and `rr` are always signature-protected as protocol invariants, and the `p10cr` CSR signature is always verified. The field persists and round-trips through the API, but its value does not change behavior."},"946":{"id":"/docs/pr-preview/pr-24/platform/pki/cmp-135","page_id":"/docs/pr-preview/pr-24/platform/pki/cmp","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/cmp#protection-certificate-and-proof-of-possession","content":"**Expected Authenticator** (`expected_authenticator`): shared answer compared against the `id-regCtrl-authenticator` control (RFC 4211 §6.2) when an issuance request (`ir`/`cr`/`kur`) includes it. Empty by default: a present control is accepted without comparing its value. With a value configured, a control whose content does not match is rejected with `incorrectData`. **Marked as legacy**: it stores a plaintext secret on the DMS; new configuration should use the per-operation `registration_token`/`authenticator_control` controls, which store only a mode."},"947":{"id":"/docs/pr-preview/pr-24/platform/pki/cmp-136","page_id":"/docs/pr-preview/pr-24/platform/pki/cmp","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/cmp#per-operation-settings","content":"Besides the general fields above, each CMP operation has its own configuration block with an `enabled` switch and a specific policy. The issuance operations (`ir`, `cr`, `p10cr`, `kur`) also support `policy_overrides`:"},"948":{"id":"/docs/pr-preview/pr-24/platform/pki/cmp-137","page_id":"/docs/pr-preview/pr-24/platform/pki/cmp","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/cmp#per-operation-settings","content":"`policy_overrides.workflow`: `inherit` (takes the general `workflow`), `direct` or `phased`."},"949":{"id":"/docs/pr-preview/pr-24/platform/pki/cmp-138","page_id":"/docs/pr-preview/pr-24/platform/pki/cmp","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/cmp#per-operation-settings","content":"`policy_overrides.confirmation`: `inherit`, `implicit` (forces willingness to accept implicit confirmation) or `explicit` (forces the `certConf`)."},"950":{"id":"/docs/pr-preview/pr-24/platform/pki/cmp-139","page_id":"/docs/pr-preview/pr-24/platform/pki/cmp","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/cmp#per-operation-settings","content":"`policy_overrides.issuance_profile_id`: pins a specific issuance profile for that operation. It applies in `ir`, `cr` and `p10cr`; `kur` always renews with the DMS's general profile."},"951":{"id":"/docs/pr-preview/pr-24/platform/pki/cmp-140","page_id":"/docs/pr-preview/pr-24/platform/pki/cmp","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/cmp#per-operation-settings","content":"Effective implicit confirmation always additionally requires the device to request it (`id-it-implicitConfirm`): the setting only expresses the server's willingness."},"952":{"id":"/docs/pr-preview/pr-24/platform/pki/cmp-141","page_id":"/docs/pr-preview/pr-24/platform/pki/cmp","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/cmp#per-operation-settings","content":"Each per-operation block detects whether it has never been configured by observing a **key field**: `identity_source` in `ir`, `certificate_behavior` in `cr`, `key_policy` in `kur`, `authorization` in `rr`, `access_policy` in `genm` and `workflow` in `ccr`. If that field arrives empty, the block is filled in entirely with its default values on every read of the DMS — including any other field that was sent. To adjust a secondary field (for example, `cr`'s `maximum_active_certificates`) you must also set the block's key field, or resolution resets it to the default. `p10cr` has no key field: it stays disabled unless `enabled: true` is set explicitly."},"953":{"id":"/docs/pr-preview/pr-24/platform/pki/cmp-142","page_id":"/docs/pr-preview/pr-24/platform/pki/cmp","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/cmp#ir--initialization-request","content":"Initial enrollment of a new device (RFC 9483 §4.1.1), the equivalent of EST's `/simpleenroll`. Enabled by default."},"954":{"id":"/docs/pr-preview/pr-24/platform/pki/cmp-143","page_id":"/docs/pr-preview/pr-24/platform/pki/cmp","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/cmp#ir--initialization-request","content":"Field"},"955":{"id":"/docs/pr-preview/pr-24/platform/pki/cmp-144","page_id":"/docs/pr-preview/pr-24/platform/pki/cmp","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/cmp#ir--initialization-request","content":"Description"},"956":{"id":"/docs/pr-preview/pr-24/platform/pki/cmp-145","page_id":"/docs/pr-preview/pr-24/platform/pki/cmp","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/cmp#ir--initialization-request","content":"`enabled`"},"957":{"id":"/docs/pr-preview/pr-24/platform/pki/cmp-146","page_id":"/docs/pr-preview/pr-24/platform/pki/cmp","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/cmp#ir--initialization-request","content":"Enables the operation. Disabling it rejects any `ir` with `notAuthorized`."},"958":{"id":"/docs/pr-preview/pr-24/platform/pki/cmp-147","page_id":"/docs/pr-preview/pr-24/platform/pki/cmp","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/cmp#ir--initialization-request","content":"`proof_of_possession.required`"},"959":{"id":"/docs/pr-preview/pr-24/platform/pki/cmp-148","page_id":"/docs/pr-preview/pr-24/platform/pki/cmp","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/cmp#ir--initialization-request","content":"Whether the POPO is mandatory. Default `true`: an `ir` without an acceptable proof of possession is rejected with `badPOP`."},"960":{"id":"/docs/pr-preview/pr-24/platform/pki/cmp-149","page_id":"/docs/pr-preview/pr-24/platform/pki/cmp","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/cmp#ir--initialization-request","content":"`proof_of_possession.allowed_methods`"},"961":{"id":"/docs/pr-preview/pr-24/platform/pki/cmp-150","page_id":"/docs/pr-preview/pr-24/platform/pki/cmp","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/cmp#ir--initialization-request","content":"Accepted POPO methods: `signature` (POPOSigningKey over the CertRequest), `trusted_ra` (`raVerified` from a trusted RA with EKU `id-kp-cmcRA`), `challenge_response` (challenge-response `popdecc`/`popdecr`) and `encrypted_certificate` (the certificate is delivered encrypted to the recipient, who proves possession by decrypting it). Default `signature` + `trusted_ra`. An empty list admits no method."},"962":{"id":"/docs/pr-preview/pr-24/platform/pki/cmp-151","page_id":"/docs/pr-preview/pr-24/platform/pki/cmp","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/cmp#ir--initialization-request","content":"`registration_token`"},"963":{"id":"/docs/pr-preview/pr-24/platform/pki/cmp-152","page_id":"/docs/pr-preview/pr-24/platform/pki/cmp","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/cmp#ir--initialization-request","content":"RFC 4211 §6.1 control with mode `disabled` (default), `optional` or `required`. The mode governs the **presence** of the control: `disabled` rejects an `ir` that carries it; `required` demands it; `optional` processes it when present. regToken values are one-use credentials provisioned outside the DMS (never stored in the configuration): an already-consumed value is rejected with `the regToken control was already used (RFC 4211 §6.1)`, and the token is burned even if issuance later fails."},"964":{"id":"/docs/pr-preview/pr-24/platform/pki/cmp-153","page_id":"/docs/pr-preview/pr-24/platform/pki/cmp","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/cmp#ir--initialization-request","content":"`authenticator_control`"},"965":{"id":"/docs/pr-preview/pr-24/platform/pki/cmp-154","page_id":"/docs/pr-preview/pr-24/platform/pki/cmp","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/cmp#ir--initialization-request","content":"RFC 4211 §6.2 control with the same three modes. With `expected_authenticator` configured, `optional`/`required` validate the value; without it, presence is enough."},"966":{"id":"/docs/pr-preview/pr-24/platform/pki/cmp-155","page_id":"/docs/pr-preview/pr-24/platform/pki/cmp","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/cmp#ir--initialization-request","content":"`central_key_generation.allowed_recipient_methods`"},"967":{"id":"/docs/pr-preview/pr-24/platform/pki/cmp-156","page_id":"/docs/pr-preview/pr-24/platform/pki/cmp","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/cmp#ir--initialization-request","content":"Key-delivery methods this operation accepts for the generated key: `rsa_key_transport` and/or `ecdh_key_agreement`. Unset accepts both; an explicitly empty list denies any generated-key delivery."},"968":{"id":"/docs/pr-preview/pr-24/platform/pki/cmp-157","page_id":"/docs/pr-preview/pr-24/platform/pki/cmp","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/cmp#ir--initialization-request","content":"`central_key_generation.enabled`"},"969":{"id":"/docs/pr-preview/pr-24/platform/pki/cmp-158","page_id":"/docs/pr-preview/pr-24/platform/pki/cmp","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/cmp#ir--initialization-request","content":"Merges with the general `server_key_gen_enabled` switch and with `cr`'s into a single KGA gate (see Server-side key generation)."},"970":{"id":"/docs/pr-preview/pr-24/platform/pki/cmp-159","page_id":"/docs/pr-preview/pr-24/platform/pki/cmp","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/cmp#ir--initialization-request","content":"`identity_source`"},"971":{"id":"/docs/pr-preview/pr-24/platform/pki/cmp-160","page_id":"/docs/pr-preview/pr-24/platform/pki/cmp","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/cmp#ir--initialization-request","content":"Selects where the identity is taken from when the subject arrives empty (`subject_only` / `subject_or_san`). **Persisted but not yet enforced**: the current behavior is fixed — with an empty subject, the identity is derived from the SAN (`dNSName`, email, URI, IP, in that order) and the issued certificate keeps the NULL-DN subject."},"972":{"id":"/docs/pr-preview/pr-24/platform/pki/cmp-161","page_id":"/docs/pr-preview/pr-24/platform/pki/cmp","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/cmp#ir--initialization-request","content":"`policy_overrides`"},"973":{"id":"/docs/pr-preview/pr-24/platform/pki/cmp-162","page_id":"/docs/pr-preview/pr-24/platform/pki/cmp","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/cmp#ir--initialization-request","content":"See the introduction of this section."},"974":{"id":"/docs/pr-preview/pr-24/platform/pki/cmp-163","page_id":"/docs/pr-preview/pr-24/platform/pki/cmp","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/cmp#cr--certification-request","content":"Issuance for a device that already participates in the PKI (RFC 9483 §4.1.2). Enabled by default. Shares with `ir` the `proof_of_possession`, `central_key_generation` and `policy_overrides` structure, and adds:"},"975":{"id":"/docs/pr-preview/pr-24/platform/pki/cmp-164","page_id":"/docs/pr-preview/pr-24/platform/pki/cmp","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/cmp#cr--certification-request","content":"Field"},"976":{"id":"/docs/pr-preview/pr-24/platform/pki/cmp-165","page_id":"/docs/pr-preview/pr-24/platform/pki/cmp","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/cmp#cr--certification-request","content":"Description"},"977":{"id":"/docs/pr-preview/pr-24/platform/pki/cmp-166","page_id":"/docs/pr-preview/pr-24/platform/pki/cmp","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/cmp#cr--certification-request","content":"`require_existing_device`"},"978":{"id":"/docs/pr-preview/pr-24/platform/pki/cmp-167","page_id":"/docs/pr-preview/pr-24/platform/pki/cmp","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/cmp#cr--certification-request","content":"Default `true`: a `cr` against an unregistered device is rejected with `certification request requires a pre-existing device identity`. Disabling it lets a `cr` also register the device (subject to the registration mode and, if the device already exists, to `enable_replaceable_enrollment`)."},"979":{"id":"/docs/pr-preview/pr-24/platform/pki/cmp-168","page_id":"/docs/pr-preview/pr-24/platform/pki/cmp","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/cmp#cr--certification-request","content":"`certificate_behavior`"},"980":{"id":"/docs/pr-preview/pr-24/platform/pki/cmp-169","page_id":"/docs/pr-preview/pr-24/platform/pki/cmp","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/cmp#cr--certification-request","content":"`additional` (default) issues one more certificate without revoking the previous one; `replace` replaces the active certificate (the previous one is revoked as `superseded` after the new one is issued and bound). The data model keeps a single active identity slot per device, so `additional` does not create a second active identity in parallel: it only avoids revoking the previous one."},"981":{"id":"/docs/pr-preview/pr-24/platform/pki/cmp-170","page_id":"/docs/pr-preview/pr-24/platform/pki/cmp","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/cmp#cr--certification-request","content":"`maximum_active_certificates`"},"982":{"id":"/docs/pr-preview/pr-24/platform/pki/cmp-171","page_id":"/docs/pr-preview/pr-24/platform/pki/cmp","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/cmp#cr--certification-request","content":"Cap on non-revoked certificates per device. Default `2`; `0` disables the cap. The count is revalidated under lock right before signing, to close the race between two concurrent `cr` requests."},"983":{"id":"/docs/pr-preview/pr-24/platform/pki/cmp-172","page_id":"/docs/pr-preview/pr-24/platform/pki/cmp","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/cmp#cr--certification-request","content":"`allowed_profile_ids`"},"984":{"id":"/docs/pr-preview/pr-24/platform/pki/cmp-173","page_id":"/docs/pr-preview/pr-24/platform/pki/cmp","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/cmp#cr--certification-request","content":"Allow-list of issuance profiles permitted for this operation. The resolved profile (pinned by `policy_overrides.issuance_profile_id` or the DMS's general one) must be on the list; empty does not restrict."},"985":{"id":"/docs/pr-preview/pr-24/platform/pki/cmp-174","page_id":"/docs/pr-preview/pr-24/platform/pki/cmp","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/cmp#cr--certification-request","content":"`cr` also inherits the general enrollment safeguards: the device must belong to this DMS (a device registered to another DMS is rejected with `device already registered to another DMS`) and, if it already exists, `enable_replaceable_enrollment` is required. When a `cr` with `replace` replaces the identity, `kur`'s `key_policy` also applies: with `require_new_key`, the `cr` cannot replace the active certificate using the same public key."},"986":{"id":"/docs/pr-preview/pr-24/platform/pki/cmp-175","page_id":"/docs/pr-preview/pr-24/platform/pki/cmp","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/cmp#p10cr--pkcs10-certification-request","content":"Enrollment with a complete PKCS#10 CSR instead of the CRMF structure (RFC 9483 §4.1.4). **Shipped disabled**: `enabled: true` must be set on the DMS or every `p10cr` request is rejected with `notAuthorized`."},"987":{"id":"/docs/pr-preview/pr-24/platform/pki/cmp-176","page_id":"/docs/pr-preview/pr-24/platform/pki/cmp","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/cmp#p10cr--pkcs10-certification-request","content":"Field"},"988":{"id":"/docs/pr-preview/pr-24/platform/pki/cmp-177","page_id":"/docs/pr-preview/pr-24/platform/pki/cmp","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/cmp#p10cr--pkcs10-certification-request","content":"Description"},"989":{"id":"/docs/pr-preview/pr-24/platform/pki/cmp-178","page_id":"/docs/pr-preview/pr-24/platform/pki/cmp","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/cmp#p10cr--pkcs10-certification-request","content":"`enabled`"},"990":{"id":"/docs/pr-preview/pr-24/platform/pki/cmp-179","page_id":"/docs/pr-preview/pr-24/platform/pki/cmp","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/cmp#p10cr--pkcs10-certification-request","content":"Enables the operation. Disabled by default."},"991":{"id":"/docs/pr-preview/pr-24/platform/pki/cmp-180","page_id":"/docs/pr-preview/pr-24/platform/pki/cmp","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/cmp#p10cr--pkcs10-certification-request","content":"`allowed_profile_ids`"},"992":{"id":"/docs/pr-preview/pr-24/platform/pki/cmp-181","page_id":"/docs/pr-preview/pr-24/platform/pki/cmp","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/cmp#p10cr--pkcs10-certification-request","content":"Allow-list of permitted issuance profiles, same as in `cr`."},"993":{"id":"/docs/pr-preview/pr-24/platform/pki/cmp-182","page_id":"/docs/pr-preview/pr-24/platform/pki/cmp","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/cmp#p10cr--pkcs10-certification-request","content":"`policy_overrides`"},"994":{"id":"/docs/pr-preview/pr-24/platform/pki/cmp-183","page_id":"/docs/pr-preview/pr-24/platform/pki/cmp","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/cmp#p10cr--pkcs10-certification-request","content":"See the introduction of this section."},"995":{"id":"/docs/pr-preview/pr-24/platform/pki/cmp-184","page_id":"/docs/pr-preview/pr-24/platform/pki/cmp","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/cmp#p10cr--pkcs10-certification-request","content":"Fixed protocol invariants, not configurable: the CSR's own signature **is** the proof of possession and is always verified; there is no CRMF POPO to configure; server-side key generation is not available (the client supplies its key); and the CRMF registration controls (`regToken`, `authenticator`) do not apply. The response is a `cp` with `certReqId` `-1`, the value the subsequent `certConf` must use (RFC 4210 Errata 8806)."},"996":{"id":"/docs/pr-preview/pr-24/platform/pki/cmp-185","page_id":"/docs/pr-preview/pr-24/platform/pki/cmp","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/cmp#kur--key-update-request","content":"Renewal of a certificate (RFC 9483 §4.1.3), the equivalent of EST's `/simplereenroll`. Enabled by default. The message must be **protected by signature with the certificate being renewed** — a protocol invariant, not configurable."},"997":{"id":"/docs/pr-preview/pr-24/platform/pki/cmp-186","page_id":"/docs/pr-preview/pr-24/platform/pki/cmp","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/cmp#kur--key-update-request","content":"Field"},"998":{"id":"/docs/pr-preview/pr-24/platform/pki/cmp-187","page_id":"/docs/pr-preview/pr-24/platform/pki/cmp","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/cmp#kur--key-update-request","content":"Description"},"999":{"id":"/docs/pr-preview/pr-24/platform/pki/cmp-188","page_id":"/docs/pr-preview/pr-24/platform/pki/cmp","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/cmp#kur--key-update-request","content":"`enabled`"},"1000":{"id":"/docs/pr-preview/pr-24/platform/pki/cmp-189","page_id":"/docs/pr-preview/pr-24/platform/pki/cmp","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/cmp#kur--key-update-request","content":"Enables the operation."},"1001":{"id":"/docs/pr-preview/pr-24/platform/pki/cmp-190","page_id":"/docs/pr-preview/pr-24/platform/pki/cmp","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/cmp#kur--key-update-request","content":"`key_policy`"},"1002":{"id":"/docs/pr-preview/pr-24/platform/pki/cmp-191","page_id":"/docs/pr-preview/pr-24/platform/pki/cmp","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/cmp#kur--key-update-request","content":"`require_new_key` (default) requires a public key different from the certificate being renewed (`key update must present a new key`); `permit_reuse` allows renewing without rotating the key."},"1003":{"id":"/docs/pr-preview/pr-24/platform/pki/cmp-192","page_id":"/docs/pr-preview/pr-24/platform/pki/cmp","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/cmp#kur--key-update-request","content":"`identity_change_policy`"},"1004":{"id":"/docs/pr-preview/pr-24/platform/pki/cmp-193","page_id":"/docs/pr-preview/pr-24/platform/pki/cmp","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/cmp#kur--key-update-request","content":"How much the identity may change relative to the current certificate: `forbid` (default; subject and SAN must match), `san_only` (the subject must match; the SAN may change) or `subject_and_san` (any change)."},"1005":{"id":"/docs/pr-preview/pr-24/platform/pki/cmp-194","page_id":"/docs/pr-preview/pr-24/platform/pki/cmp","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/cmp#kur--key-update-request","content":"`policy_overrides.workflow` / `.confirmation`"},"1006":{"id":"/docs/pr-preview/pr-24/platform/pki/cmp-195","page_id":"/docs/pr-preview/pr-24/platform/pki/cmp","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/cmp#kur--key-update-request","content":"Same as in the other issuance operations."},"1007":{"id":"/docs/pr-preview/pr-24/platform/pki/cmp-196","page_id":"/docs/pr-preview/pr-24/platform/pki/cmp","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/cmp#kur--key-update-request","content":"Fixed invariants: only one key update may be open per certificate (a second `kur` while the first awaits `certConf` is rejected with `badRequest`); the previous identity stays active until confirmation; and a never-confirmed new certificate is revoked when the window expires. The optional `id-regCtrl-oldCertID` control, if sent, must reference exactly the certificate being renewed (`badCertId` otherwise). `policy_overrides.issuance_profile_id` is defined in the schema but **not yet enforced** in `kur`."},"1008":{"id":"/docs/pr-preview/pr-24/platform/pki/cmp-197","page_id":"/docs/pr-preview/pr-24/platform/pki/cmp","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/cmp#rr--revocation-request","content":"Revocation over CMP (RFC 9483 §4.2). Enabled by default. The message **must always be protected by signature** — a protocol invariant, independent of `auth_mode`: an unsigned `rr` is never accepted, not even in `NO_AUTH` mode."},"1009":{"id":"/docs/pr-preview/pr-24/platform/pki/cmp-198","page_id":"/docs/pr-preview/pr-24/platform/pki/cmp","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/cmp#rr--revocation-request","content":"Field"},"1010":{"id":"/docs/pr-preview/pr-24/platform/pki/cmp-199","page_id":"/docs/pr-preview/pr-24/platform/pki/cmp","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/cmp#rr--revocation-request","content":"Description"},"1011":{"id":"/docs/pr-preview/pr-24/platform/pki/cmp-200","page_id":"/docs/pr-preview/pr-24/platform/pki/cmp","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/cmp#rr--revocation-request","content":"`enabled`"},"1012":{"id":"/docs/pr-preview/pr-24/platform/pki/cmp-201","page_id":"/docs/pr-preview/pr-24/platform/pki/cmp","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/cmp#rr--revocation-request","content":"Enables the operation."},"1013":{"id":"/docs/pr-preview/pr-24/platform/pki/cmp-202","page_id":"/docs/pr-preview/pr-24/platform/pki/cmp","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/cmp#rr--revocation-request","content":"`authorization`"},"1014":{"id":"/docs/pr-preview/pr-24/platform/pki/cmp-203","page_id":"/docs/pr-preview/pr-24/platform/pki/cmp","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/cmp#rr--revocation-request","content":"`self_only` (default): only the device itself may revoke its certificate — the message signer must be the revoked certificate. `self_and_trusted_ra`: a trusted PKI management entity (EKU `id-kp-cmcRA`, validated against the DMS's CAs) may additionally revoke another's certificate."},"1015":{"id":"/docs/pr-preview/pr-24/platform/pki/cmp-204","page_id":"/docs/pr-preview/pr-24/platform/pki/cmp","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/cmp#rr--revocation-request","content":"`allow_revival`"},"1016":{"id":"/docs/pr-preview/pr-24/platform/pki/cmp-205","page_id":"/docs/pr-preview/pr-24/platform/pki/cmp","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/cmp#rr--revocation-request","content":"Disabled by default. Allows reactivating a revoked certificate through the reason `removeFromCRL`; revival is only possible for certificates whose revocation was a suspension (`certificateHold`)."},"1017":{"id":"/docs/pr-preview/pr-24/platform/pki/cmp-206","page_id":"/docs/pr-preview/pr-24/platform/pki/cmp","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/cmp#rr--revocation-request","content":"`allowed_reasons`"},"1018":{"id":"/docs/pr-preview/pr-24/platform/pki/cmp-207","page_id":"/docs/pr-preview/pr-24/platform/pki/cmp","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/cmp#rr--revocation-request","content":"Allow-list of accepted revocation reasons. Default `unspecified`, `key_compromise`, `cessation_of_operation` and `superseded`. Accepted values: `unspecified`, `key_compromise`, `ca_compromise`, `affiliation_changed`, `superseded`, `cessation_of_operation`, `privilege_withdrawn`, `aa_compromise`. The reason `certificateHold` is not on the list and is not subject to it: it suspends the certificate and is the only reversible revocation; reactivation is governed by `allow_revival`."},"1019":{"id":"/docs/pr-preview/pr-24/platform/pki/cmp-208","page_id":"/docs/pr-preview/pr-24/platform/pki/cmp","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/cmp#rr--revocation-request","content":"`trusted_ra.require_cmc_ra_eku`"},"1020":{"id":"/docs/pr-preview/pr-24/platform/pki/cmp-209","page_id":"/docs/pr-preview/pr-24/platform/pki/cmp","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/cmp#rr--revocation-request","content":"Default `true`: requires the EKU `id-kp-cmcRA` on the RA signer."},"1021":{"id":"/docs/pr-preview/pr-24/platform/pki/cmp-210","page_id":"/docs/pr-preview/pr-24/platform/pki/cmp","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/cmp#rr--revocation-request","content":"`trusted_ra.validation_ca_ids`"},"1022":{"id":"/docs/pr-preview/pr-24/platform/pki/cmp-211","page_id":"/docs/pr-preview/pr-24/platform/pki/cmp","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/cmp#rr--revocation-request","content":"Fixes which CAs must validate the RA certificate; an explicit list replaces the general boundary. Empty: the DMS's general trust boundary applies (the `EnrollmentCA` plus the authentication and re-enrollment validation CAs)."},"1023":{"id":"/docs/pr-preview/pr-24/platform/pki/cmp-212","page_id":"/docs/pr-preview/pr-24/platform/pki/cmp","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/cmp#rr--revocation-request","content":"Operational notes: revoking an already-expired certificate is never permitted (the CA service rejects status transitions on expired certificates); the target certificate must belong to a device managed by this DMS — a trusted RA cannot revoke certificates of other DMSs (`notAuthorized`); while a certificate has a key update pending confirmation its status cannot change (`badRequest`); and an `rr` cannot be replayed with the same `transactionID` (`transactionIdInUse`)."},"1024":{"id":"/docs/pr-preview/pr-24/platform/pki/cmp-213","page_id":"/docs/pr-preview/pr-24/platform/pki/cmp","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/cmp#genm--general-message","content":"Discovery channel (RFC 9483 §4.3): the device queries the DMS's capabilities and the DMS answers with a `genp`. It issues no certificates. Enabled by default."},"1025":{"id":"/docs/pr-preview/pr-24/platform/pki/cmp-214","page_id":"/docs/pr-preview/pr-24/platform/pki/cmp","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/cmp#genm--general-message","content":"Field"},"1026":{"id":"/docs/pr-preview/pr-24/platform/pki/cmp-215","page_id":"/docs/pr-preview/pr-24/platform/pki/cmp","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/cmp#genm--general-message","content":"Description"},"1027":{"id":"/docs/pr-preview/pr-24/platform/pki/cmp-216","page_id":"/docs/pr-preview/pr-24/platform/pki/cmp","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/cmp#genm--general-message","content":"`access_policy`"},"1028":{"id":"/docs/pr-preview/pr-24/platform/pki/cmp-217","page_id":"/docs/pr-preview/pr-24/platform/pki/cmp","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/cmp#genm--general-message","content":"`public_discovery` (default) answers without requiring a protected message; `require_signed` rejects an unsigned `genm` with `notAuthorized`."},"1029":{"id":"/docs/pr-preview/pr-24/platform/pki/cmp-218","page_id":"/docs/pr-preview/pr-24/platform/pki/cmp","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/cmp#genm--general-message","content":"`preferred_symmetric_algorithm`"},"1030":{"id":"/docs/pr-preview/pr-24/platform/pki/cmp-219","page_id":"/docs/pr-preview/pr-24/platform/pki/cmp","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/cmp#genm--general-message","content":"Symmetric algorithm the DMS advertises for content encryption toward the CA: `aes128_cbc`, `aes192_cbc`, `aes256_cbc` (default), `aes128_gcm`, `aes192_gcm` or `aes256_gcm`."},"1031":{"id":"/docs/pr-preview/pr-24/platform/pki/cmp-220","page_id":"/docs/pr-preview/pr-24/platform/pki/cmp","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/cmp#genm--general-message","content":"`information_types.*`"},"1032":{"id":"/docs/pr-preview/pr-24/platform/pki/cmp-221","page_id":"/docs/pr-preview/pr-24/platform/pki/cmp","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/cmp#genm--general-message","content":"Independent switches per information type — see the table below."},"1033":{"id":"/docs/pr-preview/pr-24/platform/pki/cmp-222","page_id":"/docs/pr-preview/pr-24/platform/pki/cmp","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/cmp#genm--general-message","content":"Each `information_types.*` switch corresponds to an RFC 9483 §4.3 information type. The purely descriptive (static) types are enabled by default; the ones that depend on the DMS's concrete configuration — its CAs, its issuance profile or its VA client — stay disabled until the operator enables them:"},"1034":{"id":"/docs/pr-preview/pr-24/platform/pki/cmp-223","page_id":"/docs/pr-preview/pr-24/platform/pki/cmp","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/cmp#genm--general-message","content":"Information type"},"1035":{"id":"/docs/pr-preview/pr-24/platform/pki/cmp-224","page_id":"/docs/pr-preview/pr-24/platform/pki/cmp","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/cmp#genm--general-message","content":"OID (`id-it-*`)"},"1036":{"id":"/docs/pr-preview/pr-24/platform/pki/cmp-225","page_id":"/docs/pr-preview/pr-24/platform/pki/cmp","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/cmp#genm--general-message","content":"Default"},"1037":{"id":"/docs/pr-preview/pr-24/platform/pki/cmp-226","page_id":"/docs/pr-preview/pr-24/platform/pki/cmp","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/cmp#genm--general-message","content":"Response content"},"1038":{"id":"/docs/pr-preview/pr-24/platform/pki/cmp-227","page_id":"/docs/pr-preview/pr-24/platform/pki/cmp","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/cmp#genm--general-message","content":"`ca_certificates`"},"1039":{"id":"/docs/pr-preview/pr-24/platform/pki/cmp-228","page_id":"/docs/pr-preview/pr-24/platform/pki/cmp","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/cmp#genm--general-message","content":"`caCerts` (17)"},"1040":{"id":"/docs/pr-preview/pr-24/platform/pki/cmp-229","page_id":"/docs/pr-preview/pr-24/platform/pki/cmp","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/cmp#genm--general-message","content":"Enabled"},"1041":{"id":"/docs/pr-preview/pr-24/platform/pki/cmp-230","page_id":"/docs/pr-preview/pr-24/platform/pki/cmp","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/cmp#genm--general-message","content":"Certificates of the DMS's CAs, with the same trust distribution as EST's `/cacerts`."},"1042":{"id":"/docs/pr-preview/pr-24/platform/pki/cmp-231","page_id":"/docs/pr-preview/pr-24/platform/pki/cmp","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/cmp#genm--general-message","content":"`signing_key_types`"},"1043":{"id":"/docs/pr-preview/pr-24/platform/pki/cmp-232","page_id":"/docs/pr-preview/pr-24/platform/pki/cmp","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/cmp#genm--general-message","content":"`signKeyPairTypes` (2)"},"1044":{"id":"/docs/pr-preview/pr-24/platform/pki/cmp-233","page_id":"/docs/pr-preview/pr-24/platform/pki/cmp","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/cmp#genm--general-message","content":"Enabled"},"1045":{"id":