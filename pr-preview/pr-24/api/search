page_id":"/docs/pr-preview/pr-24/platform/pki/quickstarts/register-device","type":"heading","tags":[],"url":"/docs/pr-preview/pr-24/platform/pki/quickstarts/register-device#before-you-begin","content":"Before you begin"},"2286":{"id":"/docs/pr-preview/pr-24/platform/pki/quickstarts/register-device-2","page_id":"/docs/pr-preview/pr-24/platform/pki/quickstarts/register-device","type":"heading","tags":[],"url":"/docs/pr-preview/pr-24/platform/pki/quickstarts/register-device#register-the-device","content":"Register the device"},"2287":{"id":"/docs/pr-preview/pr-24/platform/pki/quickstarts/register-device-3","page_id":"/docs/pr-preview/pr-24/platform/pki/quickstarts/register-device","type":"heading","tags":[],"url":"/docs/pr-preview/pr-24/platform/pki/quickstarts/register-device#check-the-initial-status","content":"Check the initial status"},"2288":{"id":"/docs/pr-preview/pr-24/platform/pki/quickstarts/register-device-4","page_id":"/docs/pr-preview/pr-24/platform/pki/quickstarts/register-device","type":"heading","tags":[],"url":"/docs/pr-preview/pr-24/platform/pki/quickstarts/register-device#assign-an-identity","content":"Assign an identity"},"2289":{"id":"/docs/pr-preview/pr-24/platform/pki/quickstarts/register-device-5","page_id":"/docs/pr-preview/pr-24/platform/pki/quickstarts/register-device","type":"heading","tags":[],"url":"/docs/pr-preview/pr-24/platform/pki/quickstarts/register-device#verify-the-device","content":"Verify the device"},"2290":{"id":"/docs/pr-preview/pr-24/platform/pki/quickstarts/register-device-6","page_id":"/docs/pr-preview/pr-24/platform/pki/quickstarts/register-device","type":"heading","tags":[],"url":"/docs/pr-preview/pr-24/platform/pki/quickstarts/register-device#automate-the-next-device","content":"Automate the next device"},"2291":{"id":"/docs/pr-preview/pr-24/platform/pki/quickstarts/register-device-7","page_id":"/docs/pr-preview/pr-24/platform/pki/quickstarts/register-device","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/quickstarts/register-device","content":"In this quickstart you will manually register a device and assign it its first certificate. It is the shortest path to understanding how Lamassu relates a physical entity to its identity history."},"2292":{"id":"/docs/pr-preview/pr-24/platform/pki/quickstarts/register-device-8","page_id":"/docs/pr-preview/pr-24/platform/pki/quickstarts/register-device","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/quickstarts/register-device#before-you-begin","content":"A configured DMS."},"2293":{"id":"/docs/pr-preview/pr-24/platform/pki/quickstarts/register-device-9","page_id":"/docs/pr-preview/pr-24/platform/pki/quickstarts/register-device","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/quickstarts/register-device#before-you-begin","content":"A CA associated with the DMS."},"2294":{"id":"/docs/pr-preview/pr-24/platform/pki/quickstarts/register-device-10","page_id":"/docs/pr-preview/pr-24/platform/pki/quickstarts/register-device","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/quickstarts/register-device#before-you-begin","content":"A unique identifier for the device."},"2295":{"id":"/docs/pr-preview/pr-24/platform/pki/quickstarts/register-device-11","page_id":"/docs/pr-preview/pr-24/platform/pki/quickstarts/register-device","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/quickstarts/register-device#register-the-device","content":"Open **Managed Devices**, select the action to register a device and complete:"},"2296":{"id":"/docs/pr-preview/pr-24/platform/pki/quickstarts/register-device-12","page_id":"/docs/pr-preview/pr-24/platform/pki/quickstarts/register-device","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/quickstarts/register-device#register-the-device","content":"**Device ID**: unique identifier of the device."},"2297":{"id":"/docs/pr-preview/pr-24/platform/pki/quickstarts/register-device-13","page_id":"/docs/pr-preview/pr-24/platform/pki/quickstarts/register-device","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/quickstarts/register-device#register-the-device","content":"**Registration Authority**: the DMS that will apply the enrollment policies."},"2298":{"id":"/docs/pr-preview/pr-24/platform/pki/quickstarts/register-device-14","page_id":"/docs/pr-preview/pr-24/platform/pki/quickstarts/register-device","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/quickstarts/register-device#register-the-device","content":"**Icon** and **Tags**: optional classification to locate it later."},"2299":{"id":"/docs/pr-preview/pr-24/platform/pki/quickstarts/register-device-15","page_id":"/docs/pr-preview/pr-24/platform/pki/quickstarts/register-device","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/quickstarts/register-device#check-the-initial-status","content":"Open the newly created device. It should appear with status **No Identity**: it exists in the inventory but does not yet have an associated certificate."},"2300":{"id":"/docs/pr-preview/pr-24/platform/pki/quickstarts/register-device-16","page_id":"/docs/pr-preview/pr-24/platform/pki/quickstarts/register-device","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/quickstarts/register-device#assign-an-identity","content":"Select **Assign Identity**. Lamassu will search for active certificates whose `Common Name` matches the `Device ID`."},"2301":{"id":"/docs/pr-preview/pr-24/platform/pki/quickstarts/register-device-17","page_id":"/docs/pr-preview/pr-24/platform/pki/quickstarts/register-device","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/quickstarts/register-device#assign-an-identity","content":"Select an existing certificate or use **Issue New Instead** to issue one from a CA linked to the DMS."},"2302":{"id":"/docs/pr-preview/pr-24/platform/pki/quickstarts/register-device-18","page_id":"/docs/pr-preview/pr-24/platform/pki/quickstarts/register-device","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/quickstarts/register-device#verify-the-device","content":"After confirming, the status should change to **Active**. Review **Certificate History** to check the associated identity and **Device Event Timeline** to see the assignment event."},"2303":{"id":"/docs/pr-preview/pr-24/platform/pki/quickstarts/register-device-19","page_id":"/docs/pr-preview/pr-24/platform/pki/quickstarts/register-device","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/quickstarts/register-device#automate-the-next-device","content":"Manual registration helps you understand the model, but a fleet should use automated enrollment. Continue with Device Management Service and the EST integration or CMP."},"2304":{"id":"/docs/pr-preview/pr-24/platform/pki/troubleshooting","page_id":"/docs/pr-preview/pr-24/platform/pki/troubleshooting","type":"page","content":"Troubleshooting","breadcrumbs":["Docs","Platform","Administer Lamassu"],"tags":[],"url":"/docs/pr-preview/pr-24/platform/pki/troubleshooting"},"2305":{"id":"/docs/pr-preview/pr-24/platform/pki/troubleshooting-0","page_id":"/docs/pr-preview/pr-24/platform/pki/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/troubleshooting","content":"Diagnose access, health, issuance, enrollment and dependencies in a Lamassu deployment."},"2306":{"id":"/docs/pr-preview/pr-24/platform/pki/troubleshooting-1","page_id":"/docs/pr-preview/pr-24/platform/pki/troubleshooting","type":"heading","tags":[],"url":"/docs/pr-preview/pr-24/platform/pki/troubleshooting#diagnostic-sequence","content":"Diagnostic sequence"},"2307":{"id":"/docs/pr-preview/pr-24/platform/pki/troubleshooting-2","page_id":"/docs/pr-preview/pr-24/platform/pki/troubleshooting","type":"heading","tags":[],"url":"/docs/pr-preview/pr-24/platform/pki/troubleshooting#reproduce-a-single-operation","content":"Reproduce a single operation"},"2308":{"id":"/docs/pr-preview/pr-24/platform/pki/troubleshooting-3","page_id":"/docs/pr-preview/pr-24/platform/pki/troubleshooting","type":"heading","tags":[],"url":"/docs/pr-preview/pr-24/platform/pki/troubleshooting#separate-client-gateway-and-service","content":"Separate client, Gateway and service"},"2309":{"id":"/docs/pr-preview/pr-24/platform/pki/troubleshooting-4","page_id":"/docs/pr-preview/pr-24/platform/pki/troubleshooting","type":"heading","tags":[],"url":"/docs/pr-preview/pr-24/platform/pki/troubleshooting#review-kubernetes-status","content":"Review Kubernetes status"},"2310":{"id":"/docs/pr-preview/pr-24/platform/pki/troubleshooting-5","page_id":"/docs/pr-preview/pr-24/platform/pki/troubleshooting","type":"heading","tags":[],"url":"/docs/pr-preview/pr-24/platform/pki/troubleshooting#query-the-affected-service","content":"Query the affected service"},"2311":{"id":"/docs/pr-preview/pr-24/platform/pki/troubleshooting-6","page_id":"/docs/pr-preview/pr-24/platform/pki/troubleshooting","type":"heading","tags":[],"url":"/docs/pr-preview/pr-24/platform/pki/troubleshooting#validate-the-result-from-outside","content":"Validate the result from outside"},"2312":{"id":"/docs/pr-preview/pr-24/platform/pki/troubleshooting-7","page_id":"/docs/pr-preview/pr-24/platform/pki/troubleshooting","type":"heading","tags":[],"url":"/docs/pr-preview/pr-24/platform/pki/troubleshooting#minimal-evidence-collection","content":"Minimal evidence collection"},"2313":{"id":"/docs/pr-preview/pr-24/platform/pki/troubleshooting-8","page_id":"/docs/pr-preview/pr-24/platform/pki/troubleshooting","type":"heading","tags":[],"url":"/docs/pr-preview/pr-24/platform/pki/troubleshooting#i-cannot-sign-in","content":"I cannot sign in"},"2314":{"id":"/docs/pr-preview/pr-24/platform/pki/troubleshooting-9","page_id":"/docs/pr-preview/pr-24/platform/pki/troubleshooting","type":"heading","tags":[],"url":"/docs/pr-preview/pr-24/platform/pki/troubleshooting#everything-returns-403-or-5xx","content":"Everything returns 403 or 5xx"},"2315":{"id":"/docs/pr-preview/pr-24/platform/pki/troubleshooting-10","page_id":"/docs/pr-preview/pr-24/platform/pki/troubleshooting","type":"heading","tags":[],"url":"/docs/pr-preview/pr-24/platform/pki/troubleshooting#a-pod-is-not-ready","content":"A pod is not Ready"},"2316":{"id":"/docs/pr-preview/pr-24/platform/pki/troubleshooting-11","page_id":"/docs/pr-preview/pr-24/platform/pki/troubleshooting","type":"heading","tags":[],"url":"/docs/pr-preview/pr-24/platform/pki/troubleshooting#issuance-fails","content":"Issuance fails"},"2317":{"id":"/docs/pr-preview/pr-24/platform/pki/troubleshooting-12","page_id":"/docs/pr-preview/pr-24/platform/pki/troubleshooting","type":"heading","tags":[],"url":"/docs/pr-preview/pr-24/platform/pki/troubleshooting#est-enrollment-fails","content":"EST enrollment fails"},"2318":{"id":"/docs/pr-preview/pr-24/platform/pki/troubleshooting-13","page_id":"/docs/pr-preview/pr-24/platform/pki/troubleshooting","type":"heading","tags":[],"url":"/docs/pr-preview/pr-24/platform/pki/troubleshooting#ocsp-or-crl-do-not-reflect-a-change","content":"OCSP or CRL do not reflect a change"},"2319":{"id":"/docs/pr-preview/pr-24/platform/pki/troubleshooting-14","page_id":"/docs/pr-preview/pr-24/platform/pki/troubleshooting","type":"heading","tags":[],"url":"/docs/pr-preview/pr-24/platform/pki/troubleshooting#events-are-not-arriving","content":"Events are not arriving"},"2320":{"id":"/docs/pr-preview/pr-24/platform/pki/troubleshooting-15","page_id":"/docs/pr-preview/pr-24/platform/pki/troubleshooting","type":"heading","tags":[],"url":"/docs/pr-preview/pr-24/platform/pki/troubleshooting#observability","content":"Observability"},"2321":{"id":"/docs/pr-preview/pr-24/platform/pki/troubleshooting-16","page_id":"/docs/pr-preview/pr-24/platform/pki/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/troubleshooting","content":"Start by locating the failing layer. A Gateway response, an unready pod and a rejected issuance can look like the same problem from the console, but they require different evidence."},"2322":{"id":"/docs/pr-preview/pr-24/platform/pki/troubleshooting-17","page_id":"/docs/pr-preview/pr-24/platform/pki/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/troubleshooting#reproduce-a-single-operation","content":"Note the time in UTC, user or principal, resource, endpoint and result. Avoid repeating a destructive action such as revocation or deletion."},"2323":{"id":"/docs/pr-preview/pr-24/platform/pki/troubleshooting-18","page_id":"/docs/pr-preview/pr-24/platform/pki/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/troubleshooting#separate-client-gateway-and-service","content":"Check the HTTP status. A 401 points to authentication; a 403, to authorization; a 404, to route or resource; a 5xx, to the service or a dependency."},"2324":{"id":"/docs/pr-preview/pr-24/platform/pki/troubleshooting-19","page_id":"/docs/pr-preview/pr-24/platform/pki/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/troubleshooting#review-kubernetes-status","content":"Locate unready pods, restarts, recent events and the state of the release."},"2325":{"id":"/docs/pr-preview/pr-24/platform/pki/troubleshooting-20","page_id":"/docs/pr-preview/pr-24/platform/pki/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/troubleshooting#query-the-affected-service","content":"Review its /health endpoint and its logs in the same time window. Then follow the indicated dependency: PostgreSQL, RabbitMQ, the OIDC provider or the cryptographic engine."},"2326":{"id":"/docs/pr-preview/pr-24/platform/pki/troubleshooting-21","page_id":"/docs/pr-preview/pr-24/platform/pki/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/troubleshooting#validate-the-result-from-outside","content":"For PKI, check the certificate, the chain, OCSP or CRL with the same type of client production uses."},"2327":{"id":"/docs/pr-preview/pr-24/platform/pki/troubleshooting-22","page_id":"/docs/pr-preview/pr-24/platform/pki/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/troubleshooting#minimal-evidence-collection","content":"Replace the placeholders with your real release, namespace and deployment."},"2328":{"id":"/docs/pr-preview/pr-24/platform/pki/troubleshooting-23","page_id":"/docs/pr-preview/pr-24/platform/pki/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/troubleshooting#minimal-evidence-collection","content":"Also run the chart's connectivity test:"},"2329":{"id":"/docs/pr-preview/pr-24/platform/pki/troubleshooting-24","page_id":"/docs/pr-preview/pr-24/platform/pki/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/troubleshooting#minimal-evidence-collection","content":"The test checks the health of CA, DMS Manager, Device Manager and VA, and verifies that the UI returns HTML. A passing test confirms basic connectivity, not a full issuance flow."},"2330":{"id":"/docs/pr-preview/pr-24/platform/pki/troubleshooting-25","page_id":"/docs/pr-preview/pr-24/platform/pki/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/troubleshooting#minimal-evidence-collection","content":"The chart's services expose startup, readiness and liveness probes over /health. A pod can be running but receive no traffic if the readiness probe fails."},"2331":{"id":"/docs/pr-preview/pr-24/platform/pki/troubleshooting-26","page_id":"/docs/pr-preview/pr-24/platform/pki/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/troubleshooting#i-cannot-sign-in","content":"If you receive a 401:"},"2332":{"id":"/docs/pr-preview/pr-24/platform/pki/troubleshooting-27","page_id":"/docs/pr-preview/pr-24/platform/pki/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/troubleshooting#i-cannot-sign-in","content":"check that the UI'