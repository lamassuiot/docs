ntent-Type: application/pkcs10`."},"1800":{"id":"/docs/pr-preview/pr-24/platform/pki/est-enrollment-190","page_id":"/docs/pr-preview/pr-24/platform/pki/est-enrollment","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/est-enrollment#error-codes-and-diagnostics","content":"400"},"1801":{"id":"/docs/pr-preview/pr-24/platform/pki/est-enrollment-191","page_id":"/docs/pr-preview/pr-24/platform/pki/est-enrollment","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/est-enrollment#error-codes-and-diagnostics","content":"`body payload must be base64 encoded`"},"1802":{"id":"/docs/pr-preview/pr-24/platform/pki/est-enrollment-192","page_id":"/docs/pr-preview/pr-24/platform/pki/est-enrollment","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/est-enrollment#error-codes-and-diagnostics","content":"The body is not valid base64."},"1803":{"id":"/docs/pr-preview/pr-24/platform/pki/est-enrollment-193","page_id":"/docs/pr-preview/pr-24/platform/pki/est-enrollment","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/est-enrollment#error-codes-and-diagnostics","content":"Use `base64 -w 0` to avoid line breaks."},"1804":{"id":"/docs/pr-preview/pr-24/platform/pki/est-enrollment-194","page_id":"/docs/pr-preview/pr-24/platform/pki/est-enrollment","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/est-enrollment#error-codes-and-diagnostics","content":"500"},"1805":{"id":"/docs/pr-preview/pr-24/platform/pki/est-enrollment-195","page_id":"/docs/pr-preview/pr-24/platform/pki/est-enrollment","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/est-enrollment#error-codes-and-diagnostics","content":"`DMS not found`"},"1806":{"id":"/docs/pr-preview/pr-24/platform/pki/est-enrollment-196","page_id":"/docs/pr-preview/pr-24/platform/pki/est-enrollment","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/est-enrollment#error-codes-and-diagnostics","content":"The `{aps}` value does not match any