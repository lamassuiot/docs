/pr-24/platform/pki/cmp#códigos-de-error-y-diagnóstico","content":"Revisar el certificado con el que se firmó."},"1174":{"id":"/docs/pr-preview/pr-24/platform/pki/cmp-480","page_id":"/docs/pr-preview/pr-24/platform/pki/cmp","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/cmp#códigos-de-error-y-diagnóstico","content":"200 (`error`)"},"1175":{"id":"/docs/pr-preview/pr-24/platform/pki/cmp-481","page_id":"/docs/pr-preview/pr-24/platform/pki/cmp","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/cmp#códigos-de-error-y-diagnóstico","content":"`PKIFailureInfo` del cuerpo"},"1176":{"id":"/docs/pr-preview/pr-24/platform/pki/cmp-482","page_id":"/docs/pr-preview/pr-24/platform/pki/cmp","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/cmp#códigos-de-error-y-diagnóstico","content":"`transactionIdInUse`: `transactionID` ya registrado (repetición de un `rr`)."},"1177":{"id":"/docs/pr-preview/pr-24/platform/pki/cmp-483","page_id":"/docs/pr-preview/pr-24/platform/pki/cmp","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/cmp#códigos-de-error-y-diagnóstico","content":"Generar un `transactionID` nuevo."},"1178":{"id":"/docs/pr-preview/pr-24/platform/pki/cmp-484","page_id":"/docs/pr-preview/pr-24/platform/pki/cmp","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/cmp#códigos-de-error-y-diagnóstico","content":"200 (`error`)"},"1179":{"id":"/docs/pr-preview/pr-24/platform/pki/cmp-485","page_id":"/docs/pr-preview/pr-24/platform/pki/cmp","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/cmp#códigos-de-error-y-diagnóstico","content":"`PKIFailureInfo` del cuerpo"},"1180":{"id":"/docs/pr-preview/pr-24/platform/pki/cmp-486","page_id":"/docs/pr-preview/pr-24/platform/pki/cmp","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/cmp#códigos-de-error-y-diagnóstico","content":"`notAuthorized`: operación deshabilitada para el DMS, o revocación de un certificado de otro DMS."},"1181":{"id":"/docs/pr-preview/pr-24/platform/pki/cmp-487","page_id":"/docs/pr-preview/pr-24/platform/pki/cmp","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/cmp#códigos-de-error-y-diagnóstico","content":"Confirmar con el administrador PKI que la operación está habilitada."},"1182":{"id":"/docs/pr-preview/pr-24/platform/pki/cmp-488","page_id":"/docs/pr-preview/pr-24/platform/pki/cmp","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/cmp#códigos-de-error-y-diagnóstico","content":"200 (`error`)"},"1183":{"id":"/docs/pr-preview/pr-24/platform/pki/cmp-489","page_id":"/docs/pr-preview/pr-24/platform/pki/cmp","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/cmp#códigos-de-error-y-diagnóstico","content":"`PKIFailureInfo` del cuerpo"},"1184":{"id":"/docs/pr-preview/pr-24/platform/pki/cmp-490","page_id":"/docs/pr-preview/pr-24/platform/pki/cmp","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/cmp#códigos-de-error-y-diagnóstico","content":"`signerNotTrusted`: el firmante no encadena a las CAs de validación del DMS, o el destinatario de KGA está fuera del límite de confianza."},"1185":{"id":"/docs/pr-preview/pr-24/platform/pki/cmp-491","page_id":"/docs/pr-preview/pr-24/platform/pki/cmp","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/cmp#códigos-de-error-y-diagnóstico","content":"Revisar el certificado con el que se firmó y las CAs configuradas."},"1186":{"id":"/docs/pr-preview/pr-24/platform/pki/cmp-492","page_id":"/docs/pr-preview/pr-24/platform/pki/cmp","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/cmp#códigos-de-error-y-diagnóstico","content":"200 (`error`)"},"1187":{"id":"/docs/pr-preview/pr-24/platform/pki/cmp-493","page_id":"/docs/pr-preview/pr-24/platform/pki/cmp","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/cmp#códigos-de-error-y-diagnóstico","content":"`PKIFailureInfo` del cuerpo"},"1188":{"id":"/docs/pr-preview/pr-24/platform/pki/cmp-494","page_id":"/docs/pr-preview/pr-24/platform/pki/cmp","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/cmp#códigos-de-error-y-diagnóstico","content":"`certRevoked`: el certificado de protección fue sustituido por una renovación confirmada, o el certificado objetivo ya está revocado."},"1189":{"id":"/docs/pr-preview/pr-24/platform/pki/cmp-495","page_id":"/docs/pr-preview/pr-24/platform/pki/cmp","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/cmp#códigos-de-error-y-diagnóstico","content":"Repetir el enrolamiento o revisar el estado de la identidad."},"1190":{"id":"/docs/pr-preview/pr-24/platform/pki/cmp-496","page_id":"/docs/pr-preview/pr-24/platform/pki/cmp","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/cmp#códigos-de-error-y-diagnóstico","content":"200 (`error`)"},"1191":{"id":"/docs/pr-preview/pr-24/platform/pki/cmp-497","page_id":"/docs/pr-preview/pr-24/platform/pki/cmp","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/cmp#códigos-de-error-y-diagnóstico","content":"`PKIFailureInfo` del cuerpo"},"1192":{"id":"/docs/pr-preview/pr-24/platform/pki/cmp-498","page_id":"/docs/pr-preview/pr-24/platform/pki/cmp","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/cmp#códigos-de-error-y-diagnóstico","content":"`certConfirmed`: `certConf` duplicado (la confirmación ya se recibió)."},"1193":{"id":"/docs/pr-preview/pr-24/platform/pki/cmp-499","page_id":"/docs/pr-preview/pr-24/platform/pki/cmp","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/cmp#códigos-de-error-y-diagnóstico","content":"No repetir la confirmación salvo que se haya perdido el `pkiConf`."},"1194":{"id":"/docs/pr-preview/pr-24/platform/pki/cmp-500","page_id":"/docs/pr-preview/pr-24/platform/pki/cmp","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/cmp#códigos-de-error-y-diagnóstico","content":"200 (`error`)"},"1195":{"id":"/docs/pr-preview/pr-24/platform/pki/cmp-501","page_id":"/docs/pr-preview/pr-24/platform/pki/cmp","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/cmp#códigos-de-error-y-diagnóstico","content":"`PKIFailureInfo` del cuerpo"},"1196":{"id":"/docs/pr-preview/pr-24/platform/pki/cmp-502","page_id":"/docs/pr-preview/pr-24/platform/pki/cmp","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/cmp#códigos-de-error-y-diagnóstico","content":"`badRequest`: transacción desconocida o expirada, sin certificado que confirmar, segunda renovación pendiente, o destinatario de KGA sin el uso de clave necesario."},"1197":{"id":"/docs/pr-preview/pr-24/platform/pki/cmp-503","page_id":"/docs/pr-preview/pr-24/platform/pki/cmp","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/cmp#códigos-de-error-y-diagnóstico","content":"Inspeccionar el motivo exacto (`statusString`) y corregir el flujo."},"1198":{"id":"/docs/pr-preview/pr-24/platform/pki/cmp-504","page_id":"/docs/pr-preview/pr-24/platform/pki/cmp","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/cmp#códigos-de-error-y-diagnóstico","content":"200 (`ip`/`cp`/`kup` con `status: rejection`)"},"1199":{"id":"/docs/pr-preview/pr-24/platform/pki/cmp-505","page_id":"/docs/pr-preview/pr-24/platform/pki/cmp","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/cmp#códigos-de-error-y-diagnóstico","content":"`PKIFailureInfo` del cuerpo"},"1200":{"id":"/docs/pr-preview/pr-24/platform/pki/cmp-506","page_id":"/docs/pr-preview/pr-24/platform/pki/cmp","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/cmp#códigos-de-error-y-diagnóstico","content":"Política de emisión: POPO ausente o fallida (`badPOP`), solicitud de certificado de CA o RSA fuera de 2048–8192 bits (`badCertTemplate`), `notAuthorized` para POPO/destinatario de KGA no permitidos, `certReqId` inválido."},"1201":{"id":"/docs/pr-preview/pr-24/platform/pki/cmp-507","page_id":"/docs/pr-preview/pr-24/platform/pki/cmp","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/cmp#códigos-de-error-y-diagnóstico","content":"Inspeccionar el `PKIFailureInfo` del cuerpo y contrastarlo con la configuración por operación del DMS."},"1202":{"id":"/docs/pr-preview/pr-24/platform/pki/cmp-508","page_id":"/docs/pr-preview/pr-24/platform/pki/cmp","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/cmp#códigos-de-error-y-diagnóstico","content":"200 (`rp` con `status: rejection`)"},"1203":{"id":"/docs/pr-preview/pr-24/platform/pki/cmp-509","page_id":"/docs/pr-preview/pr-24/platform/pki/cmp","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/cmp#códigos-de-error-y-diagnóstico","content":"`PKIStatusInfo` del cuerpo"},"1204":{"id":"/docs/pr-preview/pr-24/platform/pki/cmp-510","page_id":"/docs/pr-preview/pr-24/platform/pki/cmp","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/cmp#códigos-de-error-y-diagnóstico","content":"Revocación: motivo no permitido (`badRequest`), `transactionID` repetido, certificado no encontrado (`badCertId`), ya revocado (`certRevoked`) o no revivible (`badCertId`), o firmante sin autoridad sobre el certificado (`signerNotTrusted`/`notAuthorized`)."},"1205":{"id":"/docs/pr-preview/pr-24/platform/pki/cmp-511","page_id":"/docs/pr-preview/pr-24/platform/pki/cmp","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/cmp#códigos-de-error-y-diagnóstico","content":"Contrastar con la política `rr` del DMS."},"1206":{"id":"/docs/pr-preview/pr-24/platform/pki/cmp-512","page_id":"/docs/pr-preview/pr-24/platform/pki/cmp","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/cmp#códigos-de-error-y-diagnóstico","content":"Para interpretar el motivo exacto de un rechazo CMP, inspeccione el campo `PKIFailureInfo`/`statusString` del `PKIMessage` de respuesta (por ejemplo con `openssl cmp ... -rspout response.der` y `openssl asn1parse -inform DER -in response.der`). En los logs del servidor Lamassu, cada rechazo genera un evento estructurado `CMP operation rejected` con los campos `dms`, `pkiStatus`, `pkiFailureInfo`, `reason` y `txid`; los fallos de cliente se registran como `WARN` y los internos (`systemFailure`) como `ERROR`."},"1207":{"id":"/docs/pr-preview/pr-24/platform/pki/cmp-513","page_id":"/docs/pr-preview/pr-24/platform/pki/cmp","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/cmp#notas-de-compatibilidad","content":"La implementación de Lamassu sigue el perfil Lightweight CMP con las siguientes particularidades que afectan a clientes CMP estrictos:"},"1208":{"id":"/docs/pr-preview/pr-24/platform/pki/cmp-514","page_id":"/docs/pr-preview/pr-24/platform/pki/cmp","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/cmp#notas-de-compatibilidad","content":"CMP se sirve en un único endpoint multiplexado (`/.well-known/cmp/p/{id}`); no existen rutas separadas por operación como en EST."},"1209":{"id":"/docs/pr-preview/pr-24/platform/pki/cmp-515","page_id":"/docs/pr-preview/pr-24/platform/pki/cmp","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/cmp#notas-de-compatibilidad","content":"Se aceptan y responden las versiones `cmp2000(2)` y `cmp2021(3)`; la respuesta devuelve el mismo `pvno` que la solicitud."},"1210":{"id":"/docs/pr-preview/pr-24/platform/pki/cmp-516","page_id":"/docs/pr-preview/pr-24/platform/pki/cmp","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/cmp#notas-de-compatibilidad","content":"`messageTime` es obligatorio en **todos** los mensajes (no solo en los protegidos), con una tolerancia de deriva de 5 minutos (`badTime`)."},"1211":{"id":"/docs/pr-preview/pr-24/platform/pki/cmp-517","page_id":"/docs/pr-preview/pr-24/platform/pki/cmp","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/cmp#notas-de-compatibilidad","content":"`transactionID` y `senderNonce` deben tener al menos 128 bits de entropía, y el `senderNonce` debe ser nuevo en cada mensaje."},"1212":{"id":"/docs/pr-preview/pr-24/platform/pki/cmp-518","page_id":"/docs/pr-preview/pr-24/platform/pki/cmp","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/cmp#notas-de-compatibilidad","content":"Las operaciones `ir`, `cr` y `p10cr` no admiten `recipNonce` en la solicitud inicial (RFC 9483 §3.1); un cliente que lo incluya recibe `badRecipientNonce`. Las reglas de `generalInfo` se imponen igualmente: `implicitConfirm` y `confirmWaitTime` son mutuamente excluyentes, el valor de `implicitConfirm` debe ser `NULL` y el de `confirmWaitTime` un `GeneralizedTime`."},"1213":{"id":"/docs/pr-preview/pr-24/platform/pki/cmp-519","page_id":"/docs/pr-preview/pr-24/platform/pki/cmp","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/cmp#notas-de-compatibilidad","content":"Con protección por firma, el `sender` de la cabecera debe coincidir con el subject del certificado de protección y el `senderKID` con su `SubjectKeyIdentifier` (`badMessageCheck` en caso contrario). Los `genm` quedan exentos de esta comprobación de identidad."},"1214":{"id":"/docs/pr-preview/pr-24/platform/pki/cmp-520","page_id":"/docs/pr-preview/pr-24/platform/pki/cmp","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/cmp#notas-de-compatibilidad","content":"El subject puede ser NULL-DN solo si el SAN porta la identidad; para la identidad interna del dispositivo el SAN se usa como reserva, pero el certificado emitido conserva el subject vacío."},"1215":{"id":"/docs/pr-preview/pr-24/platform/pki/cmp-521","page_id":"/docs/pr-preview/pr-24/platform/pki/cmp","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/cmp#notas-de-compatibilidad","content":"Lamassu nunca emite certificados de CA vía CMP; la única operación que produce certificados de CA es `ccr`."},"1216":{"id":"/docs/pr-preview/pr-24/platform/pki/cmp-522","page_id":"/docs/pr-preview/pr-24/platform/pki/cmp","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/cmp#notas-de-compatibilidad","content":"El tipo `id-it-revPassphrase` del `genm` está deshabilitado de forma permanente."},"1217":{"id":"/docs/pr-preview/pr-24/platform/pki/cmp-523","page_id":"/docs/pr-preview/pr-24/platform/pki/cmp","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/cmp#notas-de-compatibilidad","content":"Los estados internos `APPROVING` y `REVOKING` de una transacción son transitorios y no se exponen en la API de listado; solo aparecen `PENDING`, `ISSUED`, `ISSUE_FAILED`, `CONFIRMED` y `REVOKED`."},"1218":{"id":"/docs/pr-preview/pr-24/platform/pki/cmp-524","page_id":"/docs/pr-preview/pr-24/platform/pki/cmp","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/cmp#notas-de-compatibilidad","content":"Los registros de transacción en estado terminal (`CONFIRMED`, `REVOKED`) se conservan para auditoría y no se borran por expiración; un `transactionID` completado puede reutilizarse en una operación nueva, salvo en `rr`, donde la protección contra repetición también mira los registros terminales."},"1219":{"id":"/docs/pr-preview/pr-24/platform/pki/cmp-525","page_id":"/docs/pr-preview/pr-24/platform/pki/cmp","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/cmp#notas-de-compatibilidad","content":"El certificado de protección debe renovarse manualmente antes de caducar: el DMS no lo renueva automáticamente, y mientras no haya uno configurado, todas las respuestas salen sin protección."},"1220":{"id":"/docs/pr-preview/pr-24/platform/pki/cmp-526","page_id":"/docs/pr-preview/pr-24/platform/pki/cmp","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/cmp#notas-de-compatibilidad","content":"<Card title=\"Visión general del DMS\" href=\"/docs/platform/pki/device-enrollment\" />"},"1221":{"id":"/docs/pr-preview/pr-24/platform/pki/cmp-527","page_id":"/docs/pr-preview/pr-24/platform/pki/cmp","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/cmp#notas-de-compatibilidad","content":"<Card title=\"EST (RFC 7030)\" href=\"/docs/platform/pki/est-enrollment\" />"},"1222":{"id":"/docs/pr-preview/pr-24/platform/pki/cmp-528","page_id":"/docs/pr-preview/pr-24/platform/pki/cmp","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/cmp#notas-de-compatibilidad","content":"<Card title=\"Gestionar dispositivos\" href=\"/docs/platform/pki/device-management\" />"},"1223":{"id":"/docs/pr-preview/pr-24/platform/pki/concepts/architecture","page_id":"/docs/pr-preview/pr-24/platform/pki/concepts/architecture","type":"page","content":"Arquitectura de la plataforma","breadcrumbs":["Docs","Plataforma","Conceptos"],"tags":[],"url":"/docs/pr-preview/pr-24/platform/pki/concepts/architecture"},"1224":{"id":"/docs/pr-preview/pr-24/platform/pki/concepts/architecture-0","page_id":"/docs/pr-preview/pr-24/platform/pki/concepts/architecture","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/concepts/architecture","content":"Componentes de Lamassu y relación entre control, claves, emisión y dispositivos."},"1225":{"id":"/docs/pr-preview/pr-24/platform/pki/concepts/architecture-1","page_id":"/docs/pr-preview/pr-24/platform/pki/concepts/architecture","type":"heading","tags":[],"url":"/docs/pr-preview/pr-24/platform/pki/concepts/architecture#plano-de-control","content":"Plano de control"},"1226":{"id":"/docs/pr-preview/pr-24/platform/pki/concepts/architecture-2","page_id":"/docs/pr-preview/pr-24/platform/pki/concepts/architecture","type":"heading","tags":[],"url":"/docs/pr-preview/pr-24/platform/pki/concepts/architecture#custodia-y-operaciones-criptográficas","content":"Custodia y operaciones criptográficas"},"1227":{"id":"/docs/pr-preview/pr-24/platform/pki/concepts/architecture-3","page_id":"/docs/pr-preview/pr-24/platform/pki/concepts/architecture","type":"heading","tags":[],"url":"/docs/pr-preview/pr-24/platform/pki/concepts/architecture#emisión-y-enrolamiento","content":"Emisión y enrolamiento"},"1228":{"id":"/docs/pr-preview/pr-24/platform/pki/concepts/architecture-4","page_id":"/docs/pr-preview/pr-24/platform/pki/concepts/architecture","type":"heading","tags":[],"url":"/docs/pr-preview/pr-24/platform/pki/concepts/architecture#estado-y-validación","content":"Estado y validación"},"1229":{"id":"/docs/pr-preview/pr-24/platform/pki/concepts/architecture-5","page_id":"/docs/pr-preview/pr-24/platform/pki/concepts/architecture","type":"heading","tags":[],"url":"/docs/pr-preview/pr-24/platform/pki/concepts/architecture#dependencias-de-la-plataforma","content":"Dependencias de la plataforma"},"1230":{"id":"/docs/pr-preview/pr-24/platform/pki/concepts/architecture-6","page_id":"/docs/pr-preview/pr-24/platform/pki/concepts/architecture","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/concepts/architecture","content":"Lamassu se despliega como un conjunto de servicios independientes. La separación evita que todos los componentes necesiten acceso directo a las claves privadas y permite escalar cada capacidad según la carga."},"1231":{"id":"/docs/pr-preview/pr-24/platform/pki/concepts/architecture-7","page_id":"/docs/pr-preview/pr-24/platform/pki/concepts/architecture","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/concepts/architecture#plano-de-control","content":"La consola y las APIs administran autoridades, certificados, DMS, dispositivos, alertas y configuración. Los eventos de dominio permiten que conectores y automatizaciones reaccionen a los cambios sin sondear continuamente la plataforma."},"1232":{"id":"/docs/pr-preview/pr-24/platform/pki/concepts/architecture-8","page_id":"/docs/pr-preview/pr-24/platform/pki/concepts/architecture","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/concepts/architecture#custodia-y-operaciones-criptográficas","content":"El KMS ofrece una interfaz común sobre motores software, PKCS#11 y proveedores cloud. El motor seleccionado conserva la clave o delega la operación criptográfica sin que los demás servicios conozcan su implementación."},"1233":{"id":"/docs/pr-preview/pr-24/platform/pki/concepts/architecture-9","page_id":"/docs/pr-preview/pr-24/platform/pki/concepts/architecture","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/concepts/architecture#emisión-y-enrolamiento","content":"El servicio de CA emite certificados y mantiene la relación con su autoridad. El DMS aplica las reglas de enrolamiento y expone los flujos del protocolo configurado —EST o CMP— para que un dispositivo solicite o renueve una identidad."},"1234":{"id":"/docs/pr-preview/pr-24/platform/pki/concepts/architecture-10","page_id":"/docs/pr-preview/pr-24/platform/pki/concepts/architecture","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/concepts/architecture#estado-y-validación","content":"Device Manager conserva la vista operativa del dispositivo y su historial. Validation Authority publica OCSP y CRLs para que otros sistemas decidan si deben confiar en un certificado presentado."},"1235":{"id":"/docs/pr-preview/pr-24/platform/pki/concepts/architecture-11","page_id":"/docs/pr-preview/pr-24/platform/pki/concepts/architecture","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/concepts/architecture#dependencias-de-la-plataforma","content":"En un despliegue autogestionado, Lamassu utiliza PostgreSQL para persistencia, RabbitMQ para mensajería y un proveedor OIDC para autenticación. Consulta la arquitectura de despliegue para ver cómo se publican los servicios en Kubernetes."},"1236":{"id":"/docs/pr-preview/pr-24/platform/pki/concepts/certificate-lifecycle","page_id":"/docs/pr-preview/pr-24/platform/pki/concepts/certificate-lifecycle","type":"page","content":"Ciclo de vida de un certificado","breadcrumbs":["Docs","Plataforma","Conceptos"],"tags":[],"url":"/docs/pr-preview/pr-24/platform/pki/concepts/certificate-lifecycle"},"1237":{"id":"/docs/pr-preview/pr-24/platform/pki/concepts/certificate-lifecycle-0","page_id":"/docs/pr-preview/pr-24/platform/pki/concepts/certificate-lifecycle","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/concepts/certificate-lifecycle","content":"Emisión, uso, renovación, revocación y retirada de certificados en Lamassu."},"1238":{"id":"/docs/pr-preview/pr-24/platform/pki/concepts/certificate-lifecycle-1","page_id":"/docs/pr-preview/pr-24/platform/pki/concepts/certificate-lifecycle","type":"heading","tags":[],"url":"/docs/pr-preview/pr-24/platform/pki/concepts/certificate-lifecycle#el-recorrido-completo","content":"El recorrido completo"},"1239":{"id":"/docs/pr-preview/pr-24/platform/pki/concepts/certificate-lifecycle-2","page_id":"/docs/pr-preview/pr-24/platform/pki/concepts/certificate-lifecycle","type":"heading","tags":[],"url":"/docs/pr-preview/pr-24/platform/pki/concepts/certificate-lifecycle#solicitud","content":"Solicitud"},"1240":{"id":"/docs/pr-preview/pr-24/platform/pki/concepts/certificate-lifecycle-3","page_id":"/docs/pr-preview/pr-24/platform/pki/concepts/certificate-lifecycle","type":"heading","tags":[],"url":"/docs/pr-preview/pr-24/platform/pki/concepts/certificate-lifecycle#emisión","content":"Emisión"},"1241":{"id":"/docs/pr-preview/pr-24/platform/pki/concepts/certificate-lifecycle-4","page_id":"/docs/pr-preview/pr-24/platform/pki/concepts/certificate-lifecycle","type":"heading","tags":[],"url":"/docs/pr-preview/pr-24/platform/pki/concepts/certificate-lifecycle#uso-y-supervisión","content":"Uso y supervisión"},"1242":{"id":"/docs/pr-preview/pr-24/platform/pki/concepts/certificate-lifecycle-5","page_id":"/docs/pr-preview/pr-24/platform/pki/concepts/certificate-lifecycle","type":"heading","tags":[],"url":"/docs/pr-preview/pr-24/platform/pki/concepts/certificate-lifecycle#renovación-o-re-enrolamiento","content":"Renovación o re-enrolamiento"},"1243":{"id":"/docs/pr-preview/pr-24/platform/pki/concepts/certificate-lifecycle-6","page_id":"/docs/pr-preview/pr-24/platform/pki/concepts/certificate-lifecycle","type":"heading","tags":[],"url":"/docs/pr-preview/pr-24/platform/pki/concepts/certificate-lifecycle#revocación-o-retirada","content":"Revocación o retirada"},"1244":{"id":"/docs/pr-preview/pr-24/platform/pki/concepts/certificate-lifecycle-7","page_id":"/docs/pr-preview/pr-24/platform/pki/concepts/certificate-lifecycle","type":"heading","tags":[],"url":"/docs/pr-preview/pr-24/platform/pki/concepts/certificate-lifecycle#estados-del-certificado","content":"Estados del certificado"},"1245":{"id":"/docs/pr-preview/pr-24/platform/pki/concepts/certificate-lifecycle-8","page_id":"/docs/pr-preview/pr-24/platform/pki/concepts/certificate-lifecycle","type":"heading","tags":[],"url":"/docs/pr-preview/pr-24/platform/pki/concepts/certificate-lifecycle#renovación-y-revocación-no-son-equivalentes","content":"Renovación y revocación no son equivalentes"},"1246":{"id":"/docs/pr-preview/pr-24/platform/pki/concepts/certificate-lifecycle-9","page_id":"/docs/pr-preview/pr-24/platform/pki/concepts/certificate-lifecycle","type":"heading","tags":[],"url":"/docs/pr-preview/pr-24/platform/pki/concepts/certificate-lifecycle#efecto-de-revocar-una-ca","content":"Efecto de revocar una CA"},"1247":{"id":"/docs/pr-preview/pr-24/platform/pki/concepts/certificate-lifecycle-10","page_id":"/docs/pr-preview/pr-24/platform/pki/concepts/certificate-lifecycle","type":"heading","tags":[],"url":"/docs/pr-preview/pr-24/platform/pki/concepts/certificate-lifecycle#qué-debes-observar","content":"Qué debes observar"},"1248":{"id":"/docs/pr-preview/pr-24/platform/pki/concepts/certificate-lifecycle-11","page_id":"/docs/pr-preview/pr-24/platform/pki/concepts/certificate-lifecycle","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/concepts/certificate-lifecycle","content":"Emitir un certificado es solo el comienzo. Durante su vida útil debes comprobar su vigencia, renovarlo antes de que caduque y retirarlo cuando deje de ser fiable. Lamassu conserva el certificado, su CA emisora, su estado y, cuando pertenece a un dispositivo, la identidad a la que está vinculado."},"1249":{"id":"/docs/pr-preview/pr-24/platform/pki/concepts/certificate-lifecycle-12","page_id":"/docs/pr-preview/pr-24/platform/pki/concepts/certificate-lifecycle","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/concepts/certificate-lifecycle#solicitud","content":"El solicitante genera una clave y una CSR. En los flujos recomendados, la clave privada permanece en el dispositivo, navegador o motor criptográfico que la creó."},"1250":{"id":"/docs/pr-preview/pr-24/platform/pki/concepts/certificate-lifecycle-13","page_id":"/docs/pr-preview/pr-24/platform/pki/concepts/certificate-lifecycle","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/concepts/certificate-lifecycle#emisión","content":"La CA firma la CSR. El perfil de emisión determina la validez, los usos, el sujeto, las extensiones admitidas y las restricciones criptográficas."},"1251":{"id":"/docs/pr-preview/pr-24/platform/pki/concepts/certificate-lifecycle-14","page_id":"/docs/pr-preview/pr-24/platform/pki/concepts/certificate-lifecycle","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/concepts/certificate-lifecycle#uso-y-supervisión","content":"El certificado queda en estado `ACTIVE`. Lamassu monitoriza su fecha `Not After`; el trabajo de monitorización criptográfica marca como `EXPIRED` los certificados que han vencido."},"1252":{"id":"/docs/pr-preview/pr-24/platform/pki/concepts/certificate-lifecycle-15","page_id":"/docs/pr-preview/pr-24/platform/pki/concepts/certificate-lifecycle","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/concepts/certificate-lifecycle#renovación-o-re-enrolamiento","content":"Se emite un certificado nuevo antes de que caduque el anterior. En un DMS puedes abrir ventanas preventiva y crítica para que el dispositivo se re-enrole mediante EST."},"1253":{"id":"/docs/pr-preview/pr-24/platform/pki/concepts/certificate-lifecycle-16","page_id":"/docs/pr-preview/pr-24/platform/pki/concepts/certificate-lifecycle","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/concepts/certificate-lifecycle#revocación-o-retirada","content":"Si la identidad deja de ser fiable, Lamassu registra la razón y la hora de revocación. OCSP y las CRLs permiten que los consumidores conozcan ese estado."},"1254":{"id":"/docs/pr-preview/pr-24/platform/pki/concepts/certificate-lifecycle-17","page_id":"/docs/pr-preview/pr-24/platform/pki/concepts/certificate-lifecycle","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/concepts/certificate-lifecycle#estados-del-certificado","content":"Lamassu persiste cuatro estados X.509:"},"1255":{"id":"/docs/pr-preview/pr-24/platform/pki/concepts/certificate-lifecycle-18","page_id":"/docs/pr-preview/pr-24/platform/pki/concepts/certificate-lifecycle","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/concepts/certificate-lifecycle#estados-del-certificado","content":"**`ACTIVE`**: el certificado está habilitado y dentro de su periodo de validez."},"1256":{"id":"/docs/pr-preview/pr-24/platform/pki/concepts/certificate-lifecycle-19","page_id":"/docs/pr-preview/pr-24/platform/pki/concepts/certificate-lifecycle","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/concepts/certificate-lifecycle#estados-del-certificado","content":"**`EXPIRED`**: ha superado su fecha de expiración. El monitor lo detecta de forma periódica; no es un estado que deba asignarse manualmente."},"1257":{"id":"/docs/pr-preview/pr-24/platform/pki/concepts/certificate-lifecycle-20","page_id":"/docs/pr-preview/pr-24/platform/pki/concepts/certificate-lifecycle","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/concepts/certificate-lifecycle#estados-del-certificado","content":"**`REVOKED`**: fue invalidado antes de expirar, con una razón y una marca temporal."},"1258":{"id":"/docs/pr-preview/pr-24/platform/pki/concepts/certificate-lifecycle-21","page_id":"/docs/pr-preview/pr-24/platform/pki/concepts/certificate-lifecycle","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/concepts/certificate-lifecycle#estados-del-certificado","content":"**`INACTIVE`**: está deshabilitado sin representar una revocación definitiva."},"1259":{"id":"/docs/pr-preview/pr-24/platform/pki/concepts/certificate-lifecycle-22","page_id":"/docs/pr-preview/pr-24/platform/pki/concepts/certificate-lifecycle","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/concepts/certificate-lifecycle#estados-del-certificado","content":"La vista del dispositivo puede añadir estados operativos como ausencia de identidad, renovación pendiente, expiración próxima o baja. Son una interpretación del estado del dispositivo y de sus certificados, no nuevos estados X.509."},"1260":{"id":"/docs/pr-preview/pr-24/platform/pki/concepts/certificate-lifecycle-23","page_id":"/docs/pr-preview/pr-24/platform/pki/concepts/certificate-lifecycle","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/concepts/certificate-lifecycle#renovación-y-revocación-no-son-equivalentes","content":"La **renovación** crea un certificado sucesor para una identidad que continúa siendo válida. La **revocación** comunica que el certificado actual ya no debe aceptarse. Renueva para mantener continuidad; revoca ante compromiso, retirada o un cambio que invalide la identidad."},"1261":{"id":"/docs/pr-preview/pr-24/platform/pki/concepts/certificate-lifecycle-24","page_id":"/docs/pr-preview/pr-24/platform/pki/concepts/certificate-lifecycle","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/concepts/certificate-lifecycle#renovación-y-revocación-no-son-equivalentes","content":"Solo una revocación con razón `CertificateHold` puede revertirse. Una revocación con cualquier otra razón es definitiva en Lamassu."},"1262":{"id":"/docs/pr-preview/pr-24/platform/pki/concepts/certificate-lifecycle-25","page_id":"/docs/pr-preview/pr-24/platform/pki/concepts/certificate-lifecycle","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/concepts/certificate-lifecycle#renovación-y-revocación-no-son-equivalentes","content":"La operación **Reissue CA** genera otro certificado para la misma clave y enlaza ambos números de serie mediante metadatos. No equivale a una rotación de clave. Para cambiar la clave, crea una CA sucesora y realiza una migración con periodo de solapamiento."},"1263":{"id":"/docs/pr-preview/pr-24/platform/pki/concepts/certificate-lifecycle-26","page_id":"/docs/pr-preview/pr-24/platform/pki/concepts/certificate-lifecycle","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/concepts/certificate-lifecycle#efecto-de-revocar-una-ca","content":"Revocar una CA es una operación en cascada. Lamassu revoca sus CAs hijas y los certificados que ha emitido con la razón `CessationOfOperation`. La propagación continúa por la jerarquía."},"1264":{"id":"/docs/pr-preview/pr-24/platform/pki/concepts/certificate-lifecycle-27","page_id":"/docs/pr-preview/pr-24/platform/pki/concepts/certificate-lifecycle","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/concepts/certificate-lifecycle#efecto-de-revocar-una-ca","content":"Antes de confirmar:"},"1265":{"id":"/docs/pr-preview/pr-24/platform/pki/concepts/certificate-lifecycle-28","page_id":"/docs/pr-preview/pr-24/platform/pki/concepts/certificate-lifecycle","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/concepts/certificate-lifecycle#efecto-de-revocar-una-ca","content":"Identifica DMS, dispositivos y servicios que confían en esa cadena."},"1266":{"id":"/docs/pr-preview/pr-24/platform/pki/concepts/certificate-lifecycle-29","page_id":"/docs/pr-preview/pr-24/platform/pki/concepts/certificate-lifecycle","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/concepts/certificate-lifecycle#efecto-de-revocar-una-ca","content":"Distribuye la nueva cadena de confianza."},"1267":{"id":"/docs/pr-preview/pr-24/platform/pki/concepts/certificate-lifecycle-30","page_id":"/docs/pr-preview/pr-24/platform/pki/concepts/certificate-lifecycle","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/concepts/certificate-lifecycle#efecto-de-revocar-una-ca","content":"Reemite las identidades necesarias."},"1268":{"id":"/docs/pr-preview/pr-24/platform/pki/concepts/certificate-lifecycle-31","page_id":"/docs/pr-preview/pr-24/platform/pki/concepts/certificate-lifecycle","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/concepts/certificate-lifecycle#efecto-de-revocar-una-ca","content":"Comprueba OCSP y CRL desde un consumidor real."},"1269":{"id":"/docs/pr-preview/pr-24/platform/pki/concepts/certificate-lifecycle-32","page_id":"/docs/pr-preview/pr-24/platform/pki/concepts/certificate-lifecycle","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/concepts/certificate-lifecycle#efecto-de-revocar-una-ca","content":"Revoca la CA antigua cuando ya no exista tráfico legítimo."},"1270":{"id":"/docs/pr-preview/pr-24/platform/pki/concepts/certificate-lifecycle-33","page_id":"/docs/pr-preview/pr-24/platform/pki/concepts/certificate-lifecycle","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/concepts/certificate-lifecycle#efecto-de-revocar-una-ca","content":"Dar de baja un dispositivo revoca sus certificados y le impide obtener nuevas identidades. Utiliza esta acción únicamente cuando el dispositivo se retire de forma permanente."},"1271":{"id":"/docs/pr-preview/pr-24/platform/pki/concepts/certificate-lifecycle-34","page_id":"/docs/pr-preview/pr-24/platform/pki/concepts/certificate-lifecycle","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/concepts/certificate-lifecycle#qué-debes-observar","content":"Certificados que entran en la ventana preventiva o crítica de renovación."},"1272":{"id":"/docs/pr-preview/pr-24/platform/pki/concepts/certificate-lifecycle-35","page_id":"/docs/pr-preview/pr-24/platform/pki/concepts/certificate-lifecycle","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/concepts/certificate-lifecycle#qué-debes-observar","content":"Errores repetidos de enrolamiento o re-enrolamiento."},"1273":{"id":"/docs/pr-preview/pr-24/platform/pki/concepts/certificate-lifecycle-36","page_id":"/docs/pr-preview/pr-24/platform/pki/concepts/certificate-lifecycle","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/concepts/certificate-lifecycle#qué-debes-observar","content":"Cambios de estado y razones de revocación."},"1274":{"id":"/docs/pr-preview/pr-24/platform/pki/concepts/certificate-lifecycle-37","page_id":"/docs/pr-preview/pr-24/platform/pki/concepts/certificate-lifecycle","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/concepts/certificate-lifecycle#qué-debes-observar","content":"Publicación y vigencia de OCSP y CRLs."},"1275":{"id":"/docs/pr-preview/pr-24/platform/pki/concepts/certificate-lifecycle-38","page_id":"/docs/pr-preview/pr-24/platform/pki/concepts/certificate-lifecycle","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/concepts/certificate-lifecycle#qué-debes-observar","content":"Dependencias que todavía presentan un certificado sustituido."},"1276":{"id":"/docs/pr-preview/pr-24/platform/pki/concepts/certificate-lifecycle-39","page_id":"/docs/pr-preview/pr-24/platform/pki/concepts/certificate-lifecycle","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/concepts/certificate-lifecycle#qué-debes-observar","content":"El historial del dispositivo relaciona sus identidades anteriores y actuales. Para cambios administrativos y errores de mutación, consulta Registros de auditoría."},"1277":{"id":"/docs/pr-preview/pr-24/platform/pki/concepts/glossary","page_id":"/docs/pr-preview/pr-24/platform/pki/concepts/glossary","type":"page","content":"Glosario","breadcrumbs":["Docs","Plataforma","Conceptos"],"tags":[],"url":"/docs/pr-preview/pr-24/platform/pki/concepts/glossary"},"1278":{"id":"/docs/pr-preview/pr-24/platform/pki/concepts/glossary-0","page_id":"/docs/pr-preview/pr-24/platform/pki/concepts/glossary","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/concepts/glossary","content":"Términos de PKI, certificados y gestión de identidades usados en Lamassu."},"1279":{"id":"/docs/pr-preview/pr-24/platform/pki/concepts/glossary-1","page_id":"/docs/pr-preview/pr-24/platform/pki/concepts/glossary","type":"heading","tags":[],"url":"/docs/pr-preview/pr-24/platform/pki/concepts/glossary#ac","content":"A–C"},"1280":{"id":"/docs/pr-preview/pr-24/platform/pki/concepts/glossary-2","page_id":"/docs/pr-preview/pr-24/platform/pki/concepts/glossary","type":"heading","tags":[],"url":"/docs/pr-preview/pr-24/platform/pki/concepts/glossary#dk","content":"D–K"},"1281":{"id":"/docs/pr-preview/pr-24/platform/pki/concepts/glossary-3","page_id":"/docs/pr-preview/pr-24/platform/pki/concepts/glossary","type":"heading","tags":[],"url":"/docs/pr-preview/pr-24/platform/pki/concepts/glossary#mr","content":"M–R"},"1282":{"id":"/docs/pr-preview/pr-24/platform/pki/concepts/glossary-4","page_id":"/docs/pr-preview/pr-24/platform/pki/concepts/glossary","type":"heading","tags":[],"url":"/docs/pr-preview/pr-24/platform/pki/concepts/glossary#sz","content":"S–Z"},"1283":{"id":"/docs/pr-preview/pr-24/platform/pki/concepts/glossary-5","page_id":"/docs/pr-preview/pr-24/platform/pki/concepts/glossary","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/concepts/glossary#ac","content":"**AKI (Authority Key Identifier)**\\\nIdentificador de la clave pública de la autoridad que firmó un certificado. Ayuda a construir la cadena hacia el emisor correcto."},"1284":{"id":"/docs/pr-preview/pr-24/platform/pki/concepts/glossary-6","page_id":"/docs/pr-preview/pr-24/platform/pki/concepts/glossary","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/concepts/glossary#ac","content":"**Ancla de confianza**\\\nCertificado, normalmente de una CA raíz, que un consumidor acepta de forma explícita como punto final de una cadena."},"1285":{"id":"/docs/pr-preview/pr-24/platform/pki/concepts/glossary-7","page_id":"/docs/pr-preview/pr-24/platform/pki/concepts/glossary","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/concepts/glossary#ac","content":"**CA (Certification Authority)**\\\nAutoridad que firma certificados y vincula una identidad con una clave pública."},"1286":{"id":"/docs/pr-preview/pr-24/platform/pki/concepts/glossary-8","page_id":"/docs/pr-preview/pr-24/platform/pki/concepts/glossary","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/concepts/glossary#ac","content":"**CA intermedia**\\\nCA firmada por otra autoridad. Se utiliza para emitir sin exponer la raíz a la operación diaria."},"1287":{"id":"/docs/pr-preview/pr-24/platform/pki/concepts/glossary-9","page_id":"/docs/pr-preview/pr-24/platform/pki/concepts/glossary","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/concepts/glossary#ac","content":"**CA raíz**\\\nCA autofirmada que inicia una jerarquía de confianza."},"1288":{"id":"/docs/pr-preview/pr-24/platform/pki/concepts/glossary-10","page_id":"/docs/pr-preview/pr-24/platform/pki/concepts/glossary","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/concepts/glossary#ac","content":"**Certificado X.509**\\\nDocumento firmado que contiene una clave pública, un sujeto, un emisor, un periodo de validez y extensiones que delimitan su uso."},"1289":{"id":"/docs/pr-preview/pr-24/platform/pki/concepts/glossary-11","page_id":"/docs/pr-preview/pr-24/platform/pki/concepts/glossary","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/concepts/glossary#ac","content":"**CRL (Certificate Revocation List)**\\\nLista firmada de certificados revocados publicada por una CA."},"1290":{"id":"/docs/pr-preview/pr-24/platform/pki/concepts/glossary-12","page_id":"/docs/pr-preview/pr-24/platform/pki/concepts/glossary","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/concepts/glossary#ac","content":"**CSR (Certificate Signing Request)**\\\nSolicitud PKCS#10 que contiene una clave pública y atributos solicitados. La firma de la CSR demuestra posesión de la clave privada correspondiente."},"1291":{"id":"/docs/pr-preview/pr-24/platform/pki/concepts/glossary-13","page_id":"/docs/pr-preview/pr-24/platform/pki/concepts/glossary","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/concepts/glossary#dk","content":"**DMS (Device Management Service)**\\\nConfiguración que agrupa reglas de registro, enrolamiento, re-enrolamiento, emisión y distribución de CAs para una flota."},"1292":{"id":"/docs/pr-preview/pr-24/platform/pki/concepts/glossary-14","page_id":"/docs/pr-preview/pr-24/platform/pki/concepts/glossary","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/concepts/glossary#dk","content":"**Distinguished Name (DN)**\\\nConjunto de atributos del sujeto o emisor, como `CN`, `O`, `OU`, `C`, `ST` y `L`."},"1293":{"id":"/docs/pr-preview/pr-24/platform/pki/concepts/glossary-15","page_id":"/docs/pr-preview/pr-24/platform/pki/concepts/glossary","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/concepts/glossary#dk","content":"**EST (Enrollment over Secure Transport)**\\\nProtocolo definido en RFC 7030 para obtener CAs, enrolar y re-enrolar certificados sobre HTTPS."},"1294":{"id":"/docs/pr-preview/pr-24/platform/pki/concepts/glossary-16","page_id":"/docs/pr-preview/pr-24/platform/pki/concepts/glossary","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/concepts/glossary#dk","content":"**Extended Key Usage (EKU)**\\\nExtensión que acota finalidades como autenticación de cliente, autenticación de servidor, firma de código u OCSP."},"1295":{"id":"/docs/pr-preview/pr-24/platform/pki/concepts/glossary-17","page_id":"/docs/pr-preview/pr-24/platform/pki/concepts/glossary","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/concepts/glossary#dk","content":"**Identidad de dispositivo**\\\nRelación entre un dispositivo y uno de sus certificados. Un dispositivo puede conservar un historial de identidades."},"1296":{"id":"/docs/pr-preview/pr-24/platform/pki/concepts/glossary-18","page_id":"/docs/pr-preview/pr-24/platform/pki/concepts/glossary","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/concepts/glossary#dk","content":"**Identity slot**\\\nPosición lógica en un dispositivo donde Lamassu vincula una identidad activa o histórica."},"1297":{"id":"/docs/pr-preview/pr-24/platform/pki/concepts/glossary-19","page_id":"/docs/pr-preview/pr-24/platform/pki/concepts/glossary","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/concepts/glossary#dk","content":"**JITP (Just-in-Time Provisioning)**\\\nRegistro automático de un dispositivo cuando completa correctamente su primer enrolamiento."},"1298":{"id":"/docs/pr-preview/pr-24/platform/pki/concepts/glossary-20","page_id":"/docs/pr-preview/pr-24/platform/pki/concepts/glossary","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/concepts/glossary#dk","content":"**KMS (Key Management Service)**\\\nServicio de Lamassu que normaliza generación, importación y uso de claves sobre distintos motores criptográficos."},"1299":{"id":"/docs/pr-preview/pr-24/platform/pki/concepts/glossary-21","page_id":"/docs/pr-preview/pr-24/platform/pki/concepts/glossary","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/concepts/glossary#dk","content":"**Key Usage**\\\nExtensión X.509 que permite operaciones básicas como firma digital, cifrado de clave o firma de certificados."},"1300":{"id":"/docs/pr-preview/pr-24/platform/pki/concepts/glossary-22","page_id":"/docs/pr-preview/pr-24/platform/pki/concepts/glossary","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/concepts/glossary#mr","content":"**mTLS (Mutual TLS)**\\\nTLS donde cliente y servidor presentan certificados. Un DMS puede usar el certificado cliente como método de autenticación."},"1301":{"id":"/docs/pr-preview/pr-24/platform/pki/concepts/glossary-23","page_id":"/docs/pr-preview/pr-24/platform/pki/concepts/glossary","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/concepts/glossary#mr","content":"**OCSP (Online Certificate Status Protocol)**\\\nProtocolo para consultar en línea si un certificado está vigente, revocado o es desconocido."},"1302":{"id":"/docs/pr-preview/pr-24/platform/pki/concepts/glossary-24","page_id":"/docs/pr-preview/pr-24/platform/pki/concepts/glossary","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/concepts/glossary#mr","content":"**Perfil de emisión**\\\nPolítica reutilizable que define cómo Lamassu construye un certificado y qué claves acepta."},"1303":{"id":"/docs/pr-preview/pr-24/platform/pki/concepts/glossary-25","page_id":"/docs/pr-preview/pr-24/platform/pki/concepts/glossary","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/concepts/glossary#mr","content":"**Principal**\\\nIdentidad de operador o cliente de API reconocida por el servicio de autorización. Lamassu admite principales OIDC y X.509."},"1304":{"id":"/docs/pr-preview/pr-24/platform/pki/concepts/glossary-26","page_id":"/docs/pr-preview/pr-24/platform/pki/concepts/glossary","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/concepts/glossary#mr","content":"**Política**\\\nConjunto de permisos asignable a uno o varios principales."},"1305":{"id":"/docs/pr-preview/pr-24/platform/pki/concepts/glossary-27","page_id":"/docs/pr-preview/pr-24/platform/pki/concepts/glossary","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/concepts/glossary#mr","content":"**RA (Registration Authority)**\\\nComponente que verifica al solicitante antes de pedir a una CA que emita. El DMS cumple este papel en los flujos de enrolamiento de dispositivos."},"1306":{"id":"/docs/pr-preview/pr-24/platform/pki/concepts/glossary-28","page_id":"/docs/pr-preview/pr-24/platform/pki/concepts/glossary","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/concepts/glossary#mr","content":"**Relying party**\\\nSistema consumidor que decide si acepta un certificado presentado."},"1307":{"id":"/docs/pr-preview/pr-24/platform/pki/concepts/glossary-29","page_id":"/docs/pr-preview/pr-24/platform/pki/concepts/glossary","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/concepts/glossary#mr","content":"**Revocación**\\\nInvalidación de un certificado antes de su fecha de expiración."},"1308":{"id":"/docs/pr-preview/pr-24/platform/pki/concepts/glossary-30","page_id":"/docs/pr-preview/pr-24/platform/pki/concepts/glossary","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/concepts/glossary#sz","content":"**SAN (Subject Alternative Name)**\\\nExtensión que añade identidades como nombres DNS, direcciones IP, correos o URIs."},"1309":{"id":"/docs/pr-preview/pr-24/platform/pki/concepts/glossary-31","page_id":"/docs/pr-preview/pr-24/platform/pki/concepts/glossary","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/concepts/glossary#sz","content":"**SKI (Subject Key Identifier)**\\\nIdentificador derivado de la clave pública del propio certificado."},"1310":{"id":"/docs/pr-preview/pr-24/platform/pki/concepts/glossary-32","page_id":"/docs/pr-preview/pr-24/platform/pki/concepts/glossary","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/concepts/glossary#sz","content":"**VA (Validation Authority)**\\\nServicio de Lamassu responsable de las respuestas OCSP y la generación o publicación de CRLs."},"1311":{"id":"/docs/pr-preview/pr-24/platform/pki/concepts/glossary-33","page_id":"/docs/pr-preview/pr-24/platform/pki/concepts/glossary","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/concepts/glossary#sz","content":"**Ventana de renovación**\\\nPeriodo anterior a la expiración durante el que un dispositivo puede o debe solicitar otra identidad."},"1312":{"id":"/docs/pr-preview/pr-24/platform/pki/concepts/glossary-34","page_id":"/docs/pr-preview/pr-24/platform/pki/concepts/glossary","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/concepts/glossary#sz","content":"¿Falta un término operativo? Consulta primero Cómo funciona Lamassu y el Modelo de confianza, donde estos conceptos aparecen conectados."},"1313":{"id":"/docs/pr-preview/pr-24/platform/pki/concepts/overview","page_id":"/docs/pr-preview/pr-24/platform/pki/concepts/overview","type":"page","content":"Cómo funciona Lamassu","breadcrumbs":["Docs","Plataforma","Conceptos"],"tags":[],"url":"/docs/pr-preview/pr-24/platform/pki/concepts/overview"},"1314":{"id":"/docs/pr-preview/pr-24/platform/pki/concepts/overview-0","page_id":"/docs/pr-preview/pr-24/platform/pki/concepts/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/concepts/overview","content":"El modelo mental de confianza, claves, certificados y dispositivos."},"1315":{"id":"/docs/pr-preview/pr-24/platform/pki/concepts/overview-1","page_id":"/docs/pr-preview/pr-24/platform/pki/concepts/overview","type":"heading","tags":[],"url":"/docs/pr-preview/pr-24/platform/pki/concepts/overview#el-modelo-en-cinco-piezas","content":"El modelo en cinco piezas"},"1316":{"id":"/docs/pr-preview/pr-24/platform/pki/concepts/overview-2","page_id":"/docs/pr-preview/pr-24/platform/pki/concepts/overview","type":"heading","tags":[],"url":"/docs/pr-preview/pr-24/platform/pki/concepts/overview#del-alta-a-la-operación","content":"Del alta a la operación"},"1317":{"id":"/docs/pr-preview/pr-24/platform/pki/concepts/overview-3","page_id":"/docs/pr-preview/pr-24/platform/pki/concepts/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/concepts/overview","content":"Lamassu conecta tres elementos: una **raíz de confianza**, una **política de emisión** y una **entidad que necesita demostrar su identidad**. La plataforma coordina esos elementos durante todo el ciclo de vida del certificado."},"1318":{"id":"/docs/pr-preview/pr-24/platform/pki/concepts/overview-4","page_id":"/docs/pr-preview/pr-24/platform/pki/concepts/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/concepts/overview#el-modelo-en-cinco-piezas","content":"**Motor criptográfico.** Genera o custodia claves y ejecuta las operaciones privadas sin exponer el material criptográfico al resto de servicios."},"1319":{"id":"/docs/pr-preview/pr-24/platform/pki/concepts/overview-5","page_id":"/docs/pr-preview/pr-24/platform/pki/concepts/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/concepts/overview#el-modelo-en-cinco-piezas","content":"**Autoridad de certificación (CA).** Firma certificados y establece la cadena de confianza."},"1320":{"id":"/docs/pr-preview/pr-24/platform/pki/concepts/overview-6","page_id":"/docs/pr-preview/pr-24/platform/pki/concepts/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/concepts/overview#el-modelo-en-cinco-piezas","content":"**Device Management Service (DMS).** Define cómo se registran, autentican y renuevan los dispositivos de una flota."},"1321":{"id":"/docs/pr-preview/pr-24/platform/pki/concepts/overview-7","page_id":"/docs/pr-preview/pr-24/platform/pki/concepts/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/concepts/overview#el-modelo-en-cinco-piezas","content":"**Dispositivo.** Conserva su clave privada y presenta el certificado para demostrar su identidad."},"1322":{"id":"/docs/pr-preview/pr-24/platform/pki/concepts/overview-8","page_id":"/docs/pr-preview/pr-24/platform/pki/concepts/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/concepts/overview#el-modelo-en-cinco-piezas","content":"**Validation Authority (VA).** Publica el estado de los certificados mediante OCSP y CRL."},"1323":{"id":"/docs/pr-preview/pr-24/platform/pki/concepts/overview-9","page_id":"/docs/pr-preview/pr-24/platform/pki/concepts/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/concepts/overview#del-alta-a-la-operación","content":"Un administrador configura un motor criptográfico y crea o importa una CA."},"1324":{"id":"/docs/pr-preview/pr-24/platform/pki/concepts/overview-10","page_id":"/docs/pr-preview/pr-24/platform/pki/concepts/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/concepts/overview#del-alta-a-la-operación","content":"Un DMS relaciona esa CA con una política de enrolamiento."},"1325":{"id":"/docs/pr-preview/pr-24/platform/pki/concepts/overview-11","page_id":"/docs/pr-preview/pr-24/platform/pki/concepts/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/concepts/overview#del-alta-a-la-operación","content":"El dispositivo genera una clave y solicita un certificado mediante EST o CMP, o un operador le asigna una identidad."},"1326":{"id":"/docs/pr-preview/pr-24/platform/pki/concepts/overview-12","page_id":"/docs/pr-preview/pr-24/platform/pki/concepts/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/concepts/overview#del-alta-a-la-operación","content":"Lamassu conserva el inventario, el historial y el estado de la identidad."},"1327":{"id":"/docs/pr-preview/pr-24/platform/pki/concepts/overview-13","page_id":"/docs/pr-preview/pr-24/platform/pki/concepts/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/concepts/overview#del-alta-a-la-operación","content":"Los consumidores comprueban la cadena y consultan OCSP o una CRL cuando necesitan conocer su vigencia."},"1328":{"id":"/docs/pr-preview/pr-24/platform/pki/concepts/overview-14","page_id":"/docs/pr-preview/pr-24/platform/pki/concepts/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/concepts/overview#del-alta-a-la-operación","content":"<Card title=\"Arquitectura\" description=\"Conoce los componentes y dónde termina la responsabilidad de cada uno.\" href=\"/docs/platform/pki/concepts/architecture\" />"},"1329":{"id":"/docs/pr-preview/pr-24/platform/pki/concepts/overview-15","page_id":"/docs/pr-preview/pr-24/platform/pki/concepts/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/concepts/overview#del-alta-a-la-operación","content":"<Card title=\"Ciclo de vida de una identidad\" description=\"Sigue un certificado desde el enrolamiento hasta la renovación o revocación.\" href=\"/docs/platform/pki/concepts/certificate-lifecycle\" />"},"1330":{"id":"/docs/pr-preview/pr-24/platform/pki/concepts/trust-model","page_id":"/docs/pr-preview/pr-24/platform/pki/concepts/trust-model","type":"page","content":"Modelo de confianza","breadcrumbs":["Docs","Plataforma","Conceptos"],"tags":[],"url":"/docs/pr-preview/pr-24/platform/pki/concepts/trust-model"},"1331":{"id":"/docs/pr-preview/pr-24/platform/pki/concepts/trust-model-0","page_id":"/docs/pr-preview/pr-24/platform/pki/concepts/trust-model","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/concepts/trust-model","content":"Entiende dónde nace la confianza, cómo se distribuye y qué valida cada componente."},"1332":{"id":"/docs/pr-preview/pr-24/platform/pki/concepts/trust-model-1","page_id":"/docs/pr-preview/pr-24/platform/pki/concepts/trust-model","type":"heading","tags":[],"url":"/docs/pr-preview/pr-24/platform/pki/concepts/trust-model#las-cuatro-decisiones-de-confianza","content":"Las cuatro decisiones de confianza"},"1333":{"id":"/docs/pr-preview/pr-24/platform/pki/concepts/trust-model-2","page_id":"/docs/pr-preview/pr-24/platform/pki/concepts/trust-model","type":"heading","tags":[],"url":"/docs/pr-preview/pr-24/platform/pki/concepts/trust-model#quién-puede-emitir","content":"Quién puede emitir"},"1334":{"id":"/docs/pr-preview/pr-24/platform/pki/concepts/trust-model-3","page_id":"/docs/pr-preview/pr-24/platform/pki/concepts/trust-model","type":"heading","tags":[],"url":"/docs/pr-preview/pr-24/platform/pki/concepts/trust-model#qué-puede-emitirse","content":"Qué puede emitirse"},"1335":{"id":"/docs/pr-preview/pr-24/platform/pki/concepts/trust-model-4","page_id":"/docs/pr-preview/pr-24/platform/pki/concepts/trust-model","type":"heading","tags":[],"url":"/docs/pr-preview/pr-24/platform/pki/concepts/trust-model#quién-puede-solicitarlo","content":"Quién puede solicitarlo"},"1336":{"id":"/docs/pr-preview/pr-24/platform/pki/concepts/trust-model-5","page_id":"/docs/pr-preview/pr-24/platform/pki/concepts/trust-model","type":"heading","tags":[],"url":"/docs/pr-preview/pr-24/platform/pki/concepts/trust-model#quién-acepta-el-resultado","content":"Quién acepta el resultado"},"1337":{"id":"/docs/pr-preview/pr-24/platform/pki/concepts/trust-model-6","page_id":"/docs/pr-preview/pr-24/platform/pki/concepts/trust-model","type":"heading","tags":[],"url":"/docs/pr-preview/pr-24/platform/pki/concepts/trust-model#flujo-de-una-identidad","content":"Flujo de una identidad"},"1338":{"id":"/docs/pr-preview/pr-24/platform/pki/concepts/trust-model-7","page_id":"/docs/pr-preview/pr-24/platform/pki/concepts/trust-model","type":"heading","tags":[],"url":"/docs/pr-preview/pr-24/platform/pki/concepts/trust-model#cas-de-enrolamiento-validación-y-distribución","content":"CAs de enrolamiento, validación y distribución"},"1339":{"id":"/docs/pr-preview/pr-24/platform/pki/concepts/trust-model-8","page_id":"/docs/pr-preview/pr-24/platform/pki/concepts/trust-model","type":"heading","tags":[],"url":"/docs/pr-preview/pr-24/platform/pki/concepts/trust-model#validación-y-revocación","content":"Validación y revocación"},"1340":{"id":"/docs/pr-preview/pr-24/platform/pki/concepts/trust-model-9","page_id":"/docs/pr-preview/pr-24/platform/pki/concepts/trust-model","type":"heading","tags":[],"url":"/docs/pr-preview/pr-24/platform/pki/concepts/trust-model#límites-de-custodia","content":"Límites de custodia"},"1341":{"id":"/docs/pr-preview/pr-24/platform/pki/concepts/trust-model-10","page_id":"/docs/pr-preview/pr-24/platform/pki/concepts/trust-model","type":"heading","tags":[],"url":"/docs/pr-preview/pr-24/platform/pki/concepts/trust-model#patrón-recomendado","content":"Patrón recomendado"},"1342":{"id":"/docs/pr-preview/pr-24/platform/pki/concepts/trust-model-11","page_id":"/docs/pr-preview/pr-24/platform/pki/concepts/trust-model","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/concepts/trust-model","content":"En Lamassu, confianza no significa simplemente que un certificado exista en el inventario. Un consumidor confía en una identidad cuando puede construir una cadena hasta una raíz que reconoce, comprobar que el certificado sirve para el uso esperado y verificar que sigue vigente."},"1343":{"id":"/docs/pr-preview/pr-24/platform/pki/concepts/trust-model-12","page_id":"/docs/pr-preview/pr-24/platform/pki/concepts/trust-model","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/concepts/trust-model#quién-puede-emitir","content":"La jerarquía de CAs define qué autoridades pueden firmar. Una CA raíz establece el ancla de confianza; las CAs intermedias separan ámbitos operativos y evitan utilizar la raíz para cada emisión."},"1344":{"id":"/docs/pr-preview/pr-24/platform/pki/concepts/trust-model-13","page_id":"/docs/pr-preview/pr-24/platform/pki/concepts/trust-model","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/concepts/trust-model#qué-puede-emitirse","content":"Los perfiles de certificado limitan validez, sujeto, usos, extensiones y parámetros criptográficos. La posesión de una CA no sustituye a una política de emisión."},"1345":{"id":"/docs/pr-preview/pr-24/platform/pki/concepts/trust-model-14","page_id":"/docs/pr-preview/pr-24/platform/pki/concepts/trust-model","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/concepts/trust-model#quién-puede-solicitarlo","content":"El DMS actúa como punto de enrolamiento. Puede autenticar una solicitud EST con certificado cliente, webhook externo o una combinación de ambos. Las CAs configuradas para validar al solicitante no tienen por qué ser la CA que emitirá la identidad nueva."},"1346":{"id":"/docs/pr-preview/pr-24/platform/pki/concepts/trust-model-15","page_id":"/docs/pr-preview/pr-24/platform/pki/concepts/trust-model","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/concepts/trust-model#quién-acepta-el-resultado","content":"El servicio o dispositivo consumidor mantiene su propio almacén de confianza. Lamassu puede distribuir la CA del sistema, la CA de enrolamiento y otras CAs gestionadas mediante `/cacerts`, pero el consumidor decide cuáles instala y cómo aplica la validación."},"1347":{"id":"/docs/pr-preview/pr-24/platform/pki/concepts/trust-model-16","page_id":"/docs/pr-preview/pr-24/platform/pki/concepts/trust-model","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/concepts/trust-model#flujo-de-una-identidad","content":"El dispositivo demuestra que puede enrolarse según la política del DMS."},"1348":{"id":"/docs/pr-preview/pr-24/platform/pki/concepts/trust-model-17","page_id":"/docs/pr-preview/pr-24/platform/pki/concepts/trust-model","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/concepts/trust-model#flujo-de-una-identidad","content":"El DMS valida la solicitud y remite la CSR a la CA de enrolamiento."},"1349":{"id":"/docs/pr-preview/pr-24/platform/pki/concepts/trust-model-18","page_id":"/docs/pr-preview/pr-24/platform/pki/concepts/trust-model","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/concepts/trust-model#flujo-de-una-identidad","content":"La CA aplica el perfil y firma sin recibir la clave privada del dispositivo."},"1350":{"id":"/docs/pr-preview/pr-24/platform/pki/concepts/trust-model-19","page_id":"/docs/pr-preview/pr-24/platform/pki/concepts/trust-model","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/concepts/trust-model#flujo-de-una-identidad","content":"El dispositivo instala el certificado y la cadena que necesita."},"1351":{"id":"/docs/pr-preview/pr-24/platform/pki/concepts/trust-model-20","page_id":"/docs/pr-preview/pr-24/platform/pki/concepts/trust-model","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/concepts/trust-model#flujo-de-una-identidad","content":"El sistema que confía en el dispositivo valida cadena, fechas, usos y estado de revocación."},"1352":{"id":"/docs/pr-preview/pr-24/platform/pki/concepts/trust-model-21","page_id":"/docs/pr-preview/pr-24/platform/pki/concepts/trust-model","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/concepts/trust-model#flujo-de-una-identidad","content":"OIDC o X.509 identifica al operador que llama a Lamassu. El servicio de autorización decide qué acciones puede realizar. La jerarquía X.509, en cambio, determina si un certificado presentado por un dispositivo es confiable."},"1353":{"id":"/docs/pr-preview/pr-24/platform/pki/concepts/trust-model-22","page_id":"/docs/pr-preview/pr-24/platform/pki/concepts/trust-model","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/concepts/trust-model#cas-de-enrolamiento-validación-y-distribución","content":"Un DMS relaciona tres conjuntos que conviene diseñar por separado:"},"1354":{"id":"/docs/pr-preview/pr-24/platform/pki/concepts/trust-model-23","page_id":"/docs/pr-preview/pr-24/platform/pki/concepts/trust-model","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/concepts/trust-model#cas-de-enrolamiento-validación-y-distribución","content":"**CA de enrolamiento:** firma las nuevas identidades."},"1355":{"id":"/docs/pr-preview/pr-24/platform/pki/concepts/trust-model-24","page_id":"/docs/pr-preview/pr-24/platform/pki/concepts/trust-model","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/concepts/trust-model#cas-de-enrolamiento-validación-y-distribución","content":"**CAs de validación:** autentican certificados cliente usados para enrolamiento o migración. En re-enrolamiento, Lamassu prueba primero la CA de enrolamiento y después las CAs de validación adicionales."},"1356":{"id":"/docs/pr-preview/pr-24/platform/pki/concepts/trust-model-25","page_id":"/docs/pr-preview/pr-24/platform/pki/concepts/trust-model","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/concepts/trust-model#cas-de-enrolamiento-validación-y-distribución","content":"**CAs distribuidas:** forman el contenido que el dispositivo obtiene mediante EST `/cacerts`. Puedes incluir la CA del sistema, la CA de enrolamiento y una lista de CAs gestionadas."},"1357":{"id":"/docs/pr-preview/pr-24/platform/pki/concepts/trust-model-26","page_id":"/docs/pr-preview/pr-24/platform/pki/concepts/trust-model","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/concepts/trust-model#cas-de-enrolamiento-validación-y-distribución","content":"Esta separación permite migrar una flota: aceptas temporalmente certificados de la jerarquía anterior, emites con la nueva y distribuyes ambas cadenas durante el solapamiento."},"1358":{"id":"/docs/pr-preview/pr-24/platform/pki/concepts/trust-model-27","page_id":"/docs/pr-preview/pr-24/platform/pki/concepts/trust-model","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/concepts/trust-model#validación-y-revocación","content":"Una cadena válida no garantiza por sí sola que el certificado deba aceptarse. El consumidor también debe comprobar:"},"1359":{"id":"/docs/pr-preview/pr-24/platform/pki/concepts/trust-model-28","page_id":"/docs/pr-preview/pr-24/platform/pki/concepts/trust-model","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/concepts/trust-model#validación-y-revocación","content":"que la fecha actual está entre `Not Before` y `Not After`;"},"1360":{"id":"/docs/pr-preview/pr-24/platform/pki/concepts/trust-model-29","page_id":"/docs/pr-preview/pr-24/platform/pki/concepts/trust-model","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/concepts/trust-model#validación-y-revocación","content":"que `Key Usage` y `Extended Key Usage` permiten la operación;"},"1361":{"id":"/docs/pr-preview/pr-24/platform/pki/concepts/trust-model-30","page_id":"/docs/pr-preview/pr-24/platform/pki/concepts/trust-model","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/concepts/trust-model#validación-y-revocación","content":"que nombres, SANs y sujeto coinciden con la identidad esperada;"},"1362":{"id":"/docs/pr-preview/pr-24/platform/pki/concepts/trust-model-31","page_id":"/docs/pr-preview/pr-24/platform/pki/concepts/trust-model","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/concepts/trust-model#validación-y-revocación","content":"que el certificado no aparece revocado mediante OCSP o una CRL."},"1363":{"id":"/docs/pr-preview/pr-24/platform/pki/concepts/trust-model-32","page_id":"/docs/pr-preview/pr-24/platform/pki/concepts/trust-model","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/concepts/trust-model#validación-y-revocación","content":"Durante la autenticación mTLS de un DMS, Lamassu intenta comprobar la revocación. Si el certificado no contiene información suficiente para efectuar esa comprobación, el backend registra una advertencia y continúa tratándolo como no revocado. Diseña los perfiles y puntos de distribución para evitar esa situación en producción."},"1364":{"id":"/docs/pr-preview/pr-24/platform/pki/concepts/trust-model-33","page_id":"/docs/pr-preview/pr-24/platform/pki/concepts/trust-model","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/concepts/trust-model#límites-de-custodia","content":"El KMS conserva la referencia de la clave y delega la operación al motor configurado. Con un HSM o un KMS cloud, la clave privada puede permanecer no exportable. Eso protege la custodia, pero no impide por sí solo el uso indebido: todavía debes restringir quién puede ordenar una firma y auditar esas operaciones."},"1365":{"id":"/docs/pr-preview/pr-24/platform/pki/concepts/trust-model-34","page_id":"/docs/pr-preview/pr-24/platform/pki/concepts/trust-model","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/concepts/trust-model#patrón-recomendado","content":"Mantén la raíz fuera de las operaciones diarias o con acceso muy restringido."},"1366":{"id":"/docs/pr-preview/pr-24/platform/pki/concepts/trust-model-35","page_id":"/docs/pr-preview/pr-24/platform/pki/concepts/trust-model","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/concepts/trust-model#patrón-recomendado","content":"Emite desde CAs intermedias separadas por entorno o dominio de riesgo."},"1367":{"id":"/docs/pr-preview/pr-24/platform/pki/concepts/trust-model-36","page_id":"/docs/pr-preview/pr-24/platform/pki/concepts/trust-model","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/concepts/trust-model#patrón-recomendado","content":"Asigna perfiles explícitos a cada caso de uso."},"1368":{"id":"/docs/pr-preview/pr-24/platform/pki/concepts/trust-model-37","page_id":"/docs/pr-preview/pr-24/platform/pki/concepts/trust-model","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/concepts/trust-model#patrón-recomendado","content":"Distribuye la nueva confianza antes de comenzar una rotación."},"1369":{"id":"/docs/pr-preview/pr-24/platform/pki/concepts/trust-model-38","page_id":"/docs/pr-preview/pr-24/platform/pki/concepts/trust-model","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/concepts/trust-model#patrón-recomendado","content":"Mantén solapamiento suficiente para renovar una flota desconectada."},"1370":{"id":"/docs/pr-preview/pr-24/platform/pki/concepts/trust-model-39","page_id":"/docs/pr-preview/pr-24/platform/pki/concepts/trust-model","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/concepts/trust-model#patrón-recomendado","content":"Valida desde el sistema consumidor, no solo desde la consola de Lamassu."},"1371":{"id":"/docs/pr-preview/pr-24/platform/pki/concepts/trust-model-40","page_id":"/docs/pr-preview/pr-24/platform/pki/concepts/trust-model","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/concepts/trust-model#patrón-recomendado","content":"Continúa con Jerarquía y rotación de CAs para convertir este modelo en un procedimiento operativo."},"1372":{"id":"/docs/pr-preview/pr-24/platform/pki/crl","page_id":"/docs/pr-preview/pr-24/platform/pki/crl","type":"page","content":"Listas de revocación (CRL)","breadcrumbs":["Docs","Plataforma","Operar Lamassu"],"tags":[],"url":"/docs/pr-preview/pr-24/platform/pki/crl"},"1373":{"id":"/docs/pr-preview/pr-24/platform/pki/crl-0","page_id":"/docs/pr-preview/pr-24/platform/pki/crl","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/crl","content":"Genera y distribuye listas firmadas para validar certificados sin conexión."},"1374":{"id":"/docs/pr-preview/pr-24/platform/pki/crl-1","page_id":"/docs/pr-preview/pr-24/platform/pki/crl","type":"heading","tags":[],"url":"/docs/pr-preview/pr-24/platform/pki/crl#servicio-crl","content":"Servicio CRL"},"1375":{"id":"/docs/pr-preview/pr-24/platform/pki/crl-2","page_id":"/docs/pr-preview/pr-24/platform/pki/crl","type":"heading","tags":[],"url":"/docs/pr-preview/pr-24/platform/pki/crl#rol-va-y-configuración-por-ca","content":"Rol VA y configuración por CA"},"1376":{"id":"/docs/pr-preview/pr-24/platform/pki/crl-3","page_id":"/docs/pr-preview/pr-24/platform/pki/crl","type":"heading","tags":[],"url":"/docs/pr-preview/pr-24/platform/pki/crl#regeneración-periódica-y-automática","content":"Regeneración periódica y automática"},"1377":{"id":"/docs/pr-preview/pr-24/platform/pki/crl-4","page_id":"/docs/pr-preview/pr-24/platform/pki/crl","type":"heading","tags":[],"url":"/docs/pr-preview/pr-24/platform/pki/crl#contenido-de-la-crl","content":"Contenido de la CRL"},"1378":{"id":"/docs/pr-preview/pr-24/platform/pki/crl-5","page_id":"/docs/pr-preview/pr-24/platform/pki/crl","type":"heading","tags":[],"url":"/docs/pr-preview/pr-24/platform/pki/crl#endpoint-público-de-descarga","content":"Endpoint público de descarga"},"1379":{"id":"/docs/pr-preview/pr-24/platform/pki/crl-6","page_id":"/docs/pr-preview/pr-24/platform/pki/crl","type":"heading","tags":[],"url":"/docs/pr-preview/pr-24/platform/pki/crl#api-de-gestión-del-rol-va","content":"API de gestión del rol VA"},"1380":{"id":"/docs/pr-preview/pr-24/platform/pki/crl-7","page_id":"/docs/pr-preview/pr-24/platform/pki/crl","type":"heading","tags":[],"url":"/docs/pr-preview/pr-24/platform/pki/crl#desde-la-interfaz","content":"Desde la interfaz"},"1381":{"id":"/docs/pr-preview/pr-24/platform/pki/crl-8","page_id":"/docs/pr-preview/pr-24/platform/pki/crl","type":"heading","tags":[],"url":"/docs/pr-preview/pr-24/platform/pki/crl#referencias","content":"Referencias"},"1382":{"id":"/docs/pr-preview/pr-24/platform/pki/crl-9","page_id":"/docs/pr-preview/pr-24/platform/pki/crl","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/crl#servicio-crl","content":"Una CRL (*Certificate Revocation List*) es una lista firmada que contiene los números de serie de los certificados revocados antes de su fecha de caducidad. A diferencia de OCSP, no requiere una consulta en tiempo real: la parte que confía descarga la lista periódicamente y la consulta de forma local."},"1383":{"id":"/docs/pr-preview/pr-24/platform/pki/crl-10","page_id":"/docs/pr-preview/pr-24/platform/pki/crl","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/crl#servicio-crl","content":"Lamassu genera y mantiene una CRL por cada CA que gestiona. Cada CRL está firmada con la clave privada de la propia CA emisora y se almacena en el sistema de almacenamiento de objetos configurado en la plataforma."},"1384":{"id":"/docs/pr-preview/pr-24/platform/pki/crl-11","page_id":"/docs/pr-preview/pr-24/platform/pki/crl","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/crl#rol-va-y-configuración-por-ca","content":"La publicación de la CRL de cada CA se controla mediante un *rol VA*. Este objeto define cómo se genera, cuándo se regenera y qué clave se utiliza para firmarla."},"1385":{"id":"/docs/pr-preview/pr-24/platform/pki/crl-12","page_id":"/docs/pr-preview/pr-24/platform/pki/crl","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/crl#rol-va-y-configuración-por-ca","content":"Los parámetros principales son:"},"1386":{"id":"/docs/pr-preview/pr-24/platform/pki/crl-13","page_id":"/docs/pr-preview/pr-24/platform/pki/crl","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/crl#rol-va-y-configuración-por-ca","content":"**`validity`** define el periodo de validez reflejado en `nextUpdate`. Su valor predeterminado es 7 días."},"1387":{"id":"/docs/pr-preview/pr-24/platform/pki/crl-14","page_id":"/docs/pr-preview/pr-24/platform/pki/crl","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/crl#rol-va-y-configuración-por-ca","content":"**`refresh_interval`** establece el intervalo mínimo entre regeneraciones programadas. Por defecto es aproximadamente 6 días y 23 horas."},"1388":{"id":"/docs/pr-preview/pr-24/platform/pki/crl-15","page_id":"/docs/pr-preview/pr-24/platform/pki/crl","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/crl#rol-va-y-configuración-por-ca","content":"**`regenerate_on_revoke`** ordena publicar una versión nueva inmediatamente después de una revocación. Está activo por defecto."},"1389":{"id":"/docs/pr-preview/pr-24/platform/pki/crl-16","page_id":"/docs/pr-preview/pr-24/platform/pki/crl","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/crl#rol-va-y-configuración-por-ca","content":"El campo `subject_key_id_signer` identifica la CA cuya clave privada firma la CRL. Por defecto, cada CA firma su propia CRL."},"1390":{"id":"/docs/pr-preview/pr-24/platform/pki/crl-17","page_id":"/docs/pr-preview/pr-24/platform/pki/crl","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/crl#rol-va-y-configuración-por-ca","content":"Cada CRL lleva un número de versión incremental. Lamassu almacena todas las versiones en la ruta `pki/va/crl/{subject_key_id}/{version}.crl` del almacenamiento de objetos."},"1391":{"id":"/docs/pr-preview/pr-24/platform/pki/crl-18","page_id":"/docs/pr-preview/pr-24/platform/pki/crl","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/crl#regeneración-periódica-y-automática","content":"Un proceso en segundo plano supervisa los roles VA activos. Cuando la validez restante de la CRL vigente cae por debajo del período de vigilancia configurado (*blind period*), el sistema solicita la generación de una nueva CRL. Así se evita que la CRL publicada caduque sin que exista una versión válida disponible."},"1392":{"id":"/docs/pr-preview/pr-24/platform/pki/crl-19","page_id":"/docs/pr-preview/pr-24/platform/pki/crl","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/crl#regeneración-periódica-y-automática","content":"Además, cuando `regenerate_on_revoke` está activo, que es el comportamiento por defecto, cualquier revocación de un certificado desencadena inmediatamente la generación de una nueva CRL para la CA afectada. Esto reduce al mínimo el tiempo entre la revocación y su publicación."},"1393":{"id":"/docs/pr-preview/pr-24/platform/pki/crl-20","page_id":"/docs/pr-preview/pr-24/platform/pki/crl","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/crl#contenido-de-la-crl","content":"Cada entrada de la CRL incluye el número de serie del certificado revocado, la fecha de revocación y el código de razón conforme a RFC 5280."},"1394":{"id":"/docs/pr-preview/pr-24/platform/pki/crl-21","page_id":"/docs/pr-preview/pr-24/platform/pki/crl","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/crl#contenido-de-la-crl","content":"La CRL incluye también la extensión *Issuing Distribution Point* (IDP, OID 2.5.29.28), marcada como crítica, que indica la URL pública desde la que puede descargarse. Esa URL apunta al endpoint `/crl/{subject_key_id}` de cada dominio VA configurado."},"1395":{"id":"/docs/pr-preview/pr-24/platform/pki/crl-22","page_id":"/docs/pr-preview/pr-24/platform/pki/crl","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/crl#endpoint-público-de-descarga","content":"La CRL más reciente de una CA se puede obtener directamente sin autenticación:"},"1396":{"id":"/docs/pr-preview/pr-24/platform/pki/crl-23","page_id":"/docs/pr-preview/pr-24/platform/pki/crl","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/crl#endpoint-público-de-descarga","content":"La respuesta tiene `Content-Type: application/pkix-crl` y contiene la CRL en formato DER."},"1397":{"id":"/docs/pr-preview/pr-24/platform/pki/crl-24","page_id":"/docs/pr-preview/pr-24/platform/pki/crl","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/crl#api-de-gestión-del-rol-va","content":"El rol VA de una CA se puede consultar y actualizar mediante la API:"},"1398":{"id":"/docs/pr-preview/pr-24/platform/pki/crl-25","page_id":"/docs/pr-preview/pr-24/platform/pki/crl","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/crl#api-de-gestión-del-rol-va","content":"Método"},"1399":{"id":"/docs/pr-preview/pr-24/platform/pki/crl-26","page_id":"/docs/pr-preview/pr-24/platform/pki/crl","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/crl#api-de-gestión-del-rol-va","content":"Ruta"},"1400":{"id":"/docs/pr-preview/pr-24/platform/pki/crl-27","page_id":"/docs/pr-preview/pr-24/platform/pki/crl","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/crl#api-de-gestión-del-rol-va","content":"Descripción"},"1401":{"id":"/docs/pr-preview/pr-24/platform/pki/crl-28","page_id":"/docs/pr-preview/pr-24/platform/pki/crl","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/crl#api-de-gestión-del-rol-va","content":"`GET`"},"1402":{"id":"/docs/pr-preview/pr-24/platform/pki/crl-29","page_id":"/docs/pr-preview/pr-24/platform/pki/crl","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/crl#api-de-gestión-del-rol-va","content":"`/v1/roles/{ca-ski}`"},"1403":{"id":"/docs/pr-preview/pr-24/platform/pki/crl-30","page_id":"/docs/pr-preview/pr-24/platform/pki/crl","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/crl#api-de-gestión-del-rol-va","content":"Devuelve la configuración del rol VA y los metadatos de la última CRL emitida."},"1404":{"id":"/docs/pr-preview/pr-24/platform/pki/crl-31","page_id":"/docs/pr-preview/pr-24/platform/pki/crl","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/crl#api-de-gestión-del-rol-va","content":"`PUT`"},"1405":{"id":"/docs/pr-preview/pr-24/platform/pki/crl-32","page_id":"/docs/pr-preview/pr-24/platform/pki/crl","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/crl#api-de-gestión-del-rol-va","content":"`/v1/roles/{ca-ski}`"},"1406":{"id":"/docs/pr-preview/pr-24/platform/pki/crl-33","page_id":"/docs/pr-preview/pr-24/platform/pki/crl","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/crl#api-de-gestión-del-rol-va","content":"Actualiza los parámetros de la configuración del rol VA (`validity`, `refresh_interval`, `regenerate_on_revoke`)."},"1407":{"id":"/docs/pr-preview/pr-24/platform/pki/crl-34","page_id":"/docs/pr-preview/pr-24/platform/pki/crl","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/crl#api-de-gestión-del-rol-va","content":"Ejemplo de consulta del rol VA:"},"1408":{"id":"/docs/pr-preview/pr-24/platform/pki/crl-35","page_id":"/docs/pr-preview/pr-24/platform/pki/crl","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/crl#api-de-gestión-del-rol-va","content":"La respuesta incluye el campo `latest_crl` con la versión, la fecha de inicio de validez y la fecha de caducidad de la CRL actualmente publicada."},"1409":{"id":"/docs/pr-preview/pr-24/platform/pki/crl-36","page_id":"/docs/pr-preview/pr-24/platform/pki/crl","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/crl#desde-la-interfaz","content":"Desde el panel de detalle de una CA es posible previsualizar el contenido de la CRL activa y descargarla directamente para su uso offline o para importarla en aplicaciones que realicen validación local."},"1410":{"id":"/docs/pr-preview/pr-24/platform/pki/crl-37","page_id":"/docs