/pr-24/es/platform/pki/est-enrollment","type":"heading","tags":[],"url":"/docs/pr-preview/pr-24/es/platform/pki/est-enrollment#configuración-de-enrollment","content":"Configuración de enrollment"},"1615":{"id":"/docs/pr-preview/pr-24/es/platform/pki/est-enrollment-5","page_id":"/docs/pr-preview/pr-24/es/platform/pki/est-enrollment","type":"heading","tags":[],"url":"/docs/pr-preview/pr-24/es/platform/pki/est-enrollment#enrollment-device-registration","content":"Enrollment Device Registration"},"1616":{"id":"/docs/pr-preview/pr-24/es/platform/pki/est-enrollment-6","page_id":"/docs/pr-preview/pr-24/es/platform/pki/est-enrollment","type":"heading","tags":[],"url":"/docs/pr-preview/pr-24/es/platform/pki/est-enrollment#enrollment-settings","content":"Enrollment Settings"},"1617":{"id":"/docs/pr-preview/pr-24/es/platform/pki/est-enrollment-7","page_id":"/docs/pr-preview/pr-24/es/platform/pki/est-enrollment","type":"heading","tags":[],"url":"/docs/pr-preview/pr-24/es/platform/pki/est-enrollment#perfil-de-emisión","content":"Perfil de emisión"},"1618":{"id":"/docs/pr-preview/pr-24/es/platform/pki/est-enrollment-8","page_id":"/docs/pr-preview/pr-24/es/platform/pki/est-enrollment","type":"heading","tags":[],"url":"/docs/pr-preview/pr-24/es/platform/pki/est-enrollment#configuración-de-re-enrollment","content":"Configuración de re-enrollment"},"1619":{"id":"/docs/pr-preview/pr-24/es/platform/pki/est-enrollment-9","page_id":"/docs/pr-preview/pr-24/es/platform/pki/est-enrollment","type":"heading","tags":[],"url":"/docs/pr-preview/pr-24/es/platform/pki/est-enrollment#configuración-de-serverkeygen","content":"Configuración de ServerKeyGen"},"1620":{"id":"/docs/pr-preview/pr-24/es/platform/pki/est-enrollment-10","page_id":"/docs/pr-preview/pr-24/es/platform/pki/est-enrollment","type":"heading","tags":[],"url":"/docs/pr-preview/pr-24/es/platform/pki/est-enrollment#verificar-la-configuración","content":"Verificar la configuración"},"1621":{"id":"/docs/pr-preview/pr-24/es/platform/pki/e