iew/pr-24/platform/pki/certificate-authorities-59","page_id":"/docs/pr-preview/pr-24/platform/pki/certificate-authorities","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/certificate-authorities#inspect-an-authority","content":"Certificate and chain in PEM format."},"712":{"id":"/docs/pr-preview/pr-24/platform/pki/certificate-authorities-60","page_id":"/docs/pr-preview/pr-24/platform/pki/certificate-authorities","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/certificate-authorities#inspect-an-authority","content":"Number of active, expired and revoked certificates."},"713":{"id":"/docs/pr-preview/pr-24/platform/pki/certificate-authorities-61","page_id":"/docs/pr-preview/pr-24/platform/pki/certificate-authorities","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/certificate-authorities#inspect-an-authority","content":"Certificates issued in **Issued Certificates**."},"714":{"id":"/docs/pr-preview/pr-24/platform/pki/certificate-authorities-62","page_id":"/docs/pr-preview/pr-24/platform/pki/certificate-authorities","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/certificate-authorities#inspect-an-authority","content":"The CRL linked to the authority."},"715":{"id":"/docs/pr-preview/pr-24/platform/pki/certificate-authorities-63","page_id":"/docs/pr-preview/pr-24/platform/pki/certificate-authorities","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/certificate-authorities#inspect-an-authority","content":"Metadata and the associated cryptographic engine."},"716":{"id":"/docs/pr-preview/pr-24/platform/pki/certificate-authorities-64","page_id":"/docs/pr-preview/pr-24/platform/pki/certificate-authorities","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/certificate-authorities#inspect-an-authority","content":"You can filter the inventory by name, status and CA type."},"717":{"id":"/docs/pr-preview/pr-24/platform/pki/certificate-authorities-65","page_id":"/docs/pr-preview/pr-24/platform/pki/certificate-authorities","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/certificate-authorities#issue-certificates","content":"You can start an issuance from **Issued Certificates**, from a CA's action menu or from the global certificate inventory."},"718":{"id":"/docs/pr-preview/pr-24/platform/pki/certificate-authorities-66","page_id":"/docs/pr-preview/pr-24/platform/pki/certificate-authorities","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/certificate-authorities#issue-certificates","content":"**Generate Key & CSR in Browser** is useful for a manual operation or a quick test. The browser generates the key and you must download it at the end."},"719":{"id":"/docs/pr-preview/pr-24/platform/pki/certificate-authorities-67","page_id":"/docs/pr-preview/pr-24/platform/pki/certificate-authorities","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/certificate-authorities#issue-certificates","content":"**Upload Existing CSR** is the right option when the key must remain on the target system. Lamassu receives the request but never the private key."},"720":{"id":"/docs/pr-preview/pr-24/platform/pki/certificate-authorities-68","page_id":"/docs/pr-preview/pr-24/platform/pki/certificate-authorities","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/certificate-authorities#issue-certificates","content":"Follow Issue your first certificate for the guided flow. Certificate management explains the inventory, inspection and revocation."},"721":{"id":"/docs/pr-preview/pr-24/platform/pki/certificate-authorities-69","page_id":"/docs/pr-preview/pr-24/platform/pki/certificate-authorities","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/certificate-authorities#revoke-a-ca","content":"Revoking a CA invalidates trust in the certificates it issued and can interrupt devices and services. The action is irreversible."},"722":{"id":"/docs/pr-preview/pr-24/platform/pki/certificate-authorities-70","page_id":"/docs/pr-preview/pr-24/platform/pki/certificate-authorities","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/certificate-authorities#assess-the-impact","content":"Identify the certificates, devices and consumers that depend on the CA. Prepare a replacement authority and chain when necessary."},"723":{"id":"/docs/pr-preview/pr-24/platform/pki/certificate-authorities-71","page_id":"/docs/pr-preview/pr-24/platform/pki/certificate-authorities","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/certificate-authorities#start-the-revocation","content":"Open the authority and select **Revoke CA**. Choose the reason that describes the incident, for example `KeyCompromise`, `CACompromise`, `Superseded` or `CessationOfOperation`."},"724":{"id":"/docs/pr-preview/pr-24/platform/pki/certificate-authorities-72","page_id":"/docs/pr-preview/pr-24/platform/pki/certificate-authorities","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/certificate-authorities#confirm-the-identity","content":"Type the CA's name exactly to enable **Confirm Revocation**."},"725":{"id":"/docs/pr-preview/pr-24/platform/pki/certificate-authorities-73","page_id":"/docs/pr-preview/pr-24/platform/pki/certificate-authorities","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/certificate-authorities#check-the-publication","content":"The status should change to **REVOKED** and the CRL should reflect the new information. The CA can no longer issue certificates."},"726":{"id":"/docs/pr-preview/pr-24/platform/pki/certificate-authorities-74","page_id":"/docs/pr-preview/pr-24/platform/pki/certificate-authorities","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/certificate-authorities#check-the-publication","content":"Permanent deletion is only available after revoking. Delete the record only when your retention and audit policy allows it."},"727":{"id":"/docs/pr-preview/pr-24/platform/pki/certificate-profiles","page_id":"/docs/pr-preview/pr-24/platform/pki/certificate-profiles","type":"page","content":"Certificate profiles","breadcrumbs":["Docs","Platform","Operate Lamassu"],"tags":[],"url":"/docs/pr-preview/pr-24/platform/pki/certificate-profiles"},"728":{"id":"/docs/pr-preview/pr-24/platform/pki/certificate-profiles-0","page_id":"/docs/pr-preview/pr-24/platform/pki/certificate-profiles","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/certificate-profiles","content":"Define reusable policies to issue consistent certificates and constrain accepted keys."},"729":{"id":"/docs/pr-preview/pr-24/platform/pki/certificate-profiles-1","page_id":"/docs/pr-preview/pr-24/platform/pki/certificate-profiles","type":"heading","tags":[],"url":"/docs/pr-preview/pr-24/platform/pki/certificate-profiles#what-a-profile-controls","content":"What a profile controls"},"730":{"id":"/docs/pr-preview/pr-24/platform/pki/certificate-profiles-2","page_id":"/docs/pr-preview/pr-24/platform/pki/certificate-profiles","type":"heading","tags":[],"url":"/docs/pr-preview/pr-24/platform/pki/certificate-profiles#validity","content":"Validity"},"731":{"id":"/docs/pr-preview/pr-24/platform/pki/certificate-profiles-3","page_id":"/docs/pr-preview/pr-24/platform/pki/certificate-profiles","type":"heading","tags":[],"url":"/docs/pr-preview/pr-24/platform/pki/certificate-profiles#ca-certificate-or-end-entity-certificate","content":"CA certificate or end-entity certificate"},"732":{"id":"/docs/pr-preview/pr-24/platform/pki/certificate-profiles-4","page_id":"/docs/pr-preview/pr-24/platform/pki/certificate-profiles","type":"heading","tags":[],"url":"/docs/pr-preview/pr-24/platform/pki/certificate-profiles#key-usage-and-extended-key-usage","content":"Key Usage and Extended Key Usage"},"733":{"id":"/docs/pr-preview/pr-24/platform/pki/certificate-profiles-5","page_id":"/docs/pr-preview/pr-24/platform/pki/certificate-profiles","type":"heading","tags":[],"url":"/docs/pr-preview/pr-24/platform/pki/certificate-profiles#subject","content":"Subject"},"734":{"id":"/docs/pr-preview/pr-24/platform/pki/certificate-profiles-6","page_id":"/docs/pr-preview/pr-24/platform/pki/certificate-profiles","type":"heading","tags":[],"url":"/docs/pr-preview/pr-24/platform/pki/certificate-profiles#csr-extensions","content":"CSR extensions"},"735":{"id":"/docs/pr-preview/pr-24/platform/pki/certificate-profiles-7","page_id":"/docs/pr-preview/pr-24/platform/pki/certificate-profiles","type":"heading","tags":[],"url":"/docs/pr-preview/pr-24/platform/pki/certificate-profiles#cryptographic-constraints","content":"Cryptographic constraints"},"736":{"id":"/docs/pr-preview/pr-24/platform/pki/certificate-profiles-8","page_id":"/docs/pr-preview/pr-24/platform/pki/certificate-profiles","type":"heading","tags":[],"url":"/docs/pr-preview/pr-24/platform/pki/certificate-profiles#profile-precedence","content":"Profile precedence"},"737":{"id":"/docs/pr-preview/pr-24/platform/pki/certificate-profiles-9","page_id":"/docs/pr-preview/pr-24/platform/pki/certificate-profiles","type":"heading","tags":[],"url":"/docs/pr-preview/pr-24/platform/pki/certificate-profiles#create-a-profile","content":"Create a profile"},"738":{"id":"/docs/pr-preview/pr-24/platform/pki/certificate-profiles-10","page_id":"/docs/pr-preview/pr-24/platform/pki/certificate-profiles","type":"heading","tags":[],"url":"/docs/pr-preview/pr-24/platform/pki/certificate-profiles#define-a-single-purpose","content":"Define a single purpose"},"739":{"id":"/docs/pr-preview/pr-24/platform/pki/certificate-profiles-11","page_id":"/docs/pr-preview/pr-24/platform/pki/certificate-profiles","type":"heading","tags":[],"url":"/docs/pr-preview/pr-24/platform/pki/certificate-profiles#choose-the-validity","content":"Choose the validity"},"740":{"id":"/docs/pr-preview/pr-24/platform/pki/certificate-profiles-12","page_id":"/docs/pr-preview/pr-24/platform/pki/certificate-profiles","type":"heading","tags":[],"url":"/docs/pr-preview/pr-24/platform/pki/certificate-profiles#fix-usages-and-subject","content":"Fix usages and subject"},"741":{"id":"/docs/pr-preview/pr-24/platform/pki/certificate-profiles-13","page_id":"/docs/pr-preview/pr-24/platform/pki/certificate-profiles","type":"heading","tags":[],"url":"/docs/pr-preview/pr-24/platform/pki/certificate-profiles#constrain-the-keys","content":"Constrain the keys"},"742":{"id":"/docs/pr-preview/pr-24/platform/pki/certificate-profiles-14","page_id":"/docs/pr-preview/pr-24/platform/pki/certificate-profiles","type":"heading","tags":[],"url":"/docs/pr-preview/pr-24/platform/pki/certificate-profiles#attach-it-and-test","content":"Attach it and test"},"743":{"id":"/docs/pr-preview/pr-24/platform/pki/certificate-profiles-15","page_id":"/docs/pr-preview/pr-24/platform/pki/certificate-profiles","type":"heading","tags":[],"url":"/docs/pr-preview/pr-24/platform/pki/certificate-profiles#design-examples","content":"Design examples"},"744":{"id":"/docs/pr-preview/pr-24/platform/pki/certificate-profiles-16","page_id":"/docs/pr-preview/pr-24/platform/pki/certificate-profiles","type":"heading","tags":[],"url":"/docs/pr-preview/pr-24/platform/pki/certificate-profiles#changes-and-deletion","content":"Changes and deletion"},"745":{"id":"/docs/pr-preview/pr-24/platform/pki/certificate-profiles-17","page_id":"/docs/pr-preview/pr-24/platform/pki/certificate-profiles","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/certificate-profiles","content":"An issuance profile turns a certificate policy into reusable configuration. Instead of deciding validity, subject, extensions and algorithms on every request, you define once what is allowed and attach the profile to a CA, a DMS or a specific issuance."},"746":{"id":"/docs/pr-preview/pr-24/platform/pki/certificate-profiles-18","page_id":"/docs/pr-preview/pr-24/platform/pki/certificate-profiles","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/certificate-profiles#validity","content":"You can express the lifetime as a duration from the moment of issuance or as a fixed end date. A duration works well for recurring identities; a common date is useful to make a whole batch end before a migration or retirement."},"747":{"id":"/docs/pr-preview/pr-24/platform/pki/certificate-profiles-19","page_id":"/docs/pr-preview/pr-24/platform/pki/certificate-profiles","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/certificate-profiles#validity","content":"The end date must never outlive the issuing CA."},"748":{"id":"/docs/pr-preview/pr-24/platform/pki/certificate-profiles-20","page_id":"/docs/pr-preview/pr-24/platform/pki/certificate-profiles","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/certificate-profiles#ca-certificate-or-end-entity-certificate","content":"`Sign as CA` sets `IsCA` and the basic constraints needed for an authority. Enable it only in profiles intended to create or reissue subordinate CAs."},"749":{"id":"/docs/pr-preview/pr-24/platform/pki/certificate-profiles-21","page_id":"/docs/pr-preview/pr-24/platform/pki/certificate-profiles","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/certificate-profiles#key-usage-and-extended-key-usage","content":"The profile can enforce usages such as `DigitalSignature`, `KeyEncipherment`, `CertSign`, `CRLSign`, `ClientAuth`, `ServerAuth` or `OCSPSigning`."},"750":{"id":"/docs/pr-preview/pr-24/platform/pki/certificate-profiles-22","page_id":"/docs/pr-preview/pr-24/platform/pki/certificate-profiles","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/certificate-profiles#key-usage-and-extended-key-usage","content":"If you enable **Honor Key Usage** or **Honor Extended Key Usages**, Lamassu keeps the values requested by the CSR. If you disable them, it replaces them with the ones defined in the profile."},"751":{"id":"/docs/pr-preview/pr-24/platform/pki/certificate-profiles-23","page_id":"/docs/pr-preview/pr-24/platform/pki/certificate-profiles","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/certificate-profiles#key-usage-and-extended-key-usage","content":"Do not enable the `Honor…` options for untrusted requests unless another component validates those fields. Otherwise, the requester may choose broader capabilities than intended."},"752":{"id":"/docs/pr-preview/pr-24/platform/pki/certificate-profiles-24","page_id":"/docs/pr-preview/pr-24/platform/pki/certificate-profiles","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/certificate-profiles#subject","content":"With **Honor Subject**, the certificate keeps the subject of the CSR. Without that option, Lamassu applies the profile's `CN`, `O`, `OU`, `C`, `ST` and `L`. If the profile does not define a `Common Name`, the requested CN is kept."},"753":{"id":"/docs/pr-preview/pr-24/platform/pki/certificate-profiles-25","page_id":"/docs/pr-preview/pr-24/platform/pki/certificate-profiles","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/certificate-profiles#csr-extensions","content":"With **Honor Extensions**, Lamassu filters the additional requested extensions and keeps only SAN. Without that option, it discards the CSR's additional extensions."},"754":{"id":"/docs/pr-preview/pr-24/platform/pki/certificate-profiles-26","page_id":"/docs/pr-preview/pr-24/platform/pki/certificate-profiles","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/certificate-profiles#csr-extensions","content":"This behavior allows accepting DNS, IP, email or URI as alternative identities without accepting arbitrary extensions."},"755":{"id":"/docs/pr-preview/pr-24/platform/pki/certificate-profiles-27","page_id":"/docs/pr-preview/pr-24/platform/pki/certificate-profiles","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/certificate-profiles#cryptographic-constraints","content":"The cryptographic enforcement can:"},"756":{"id":"/docs/pr-preview/pr-24/platform/pki/certificate-profiles-28","page_id":"/docs/pr-preview/pr-24/platform/pki/certificate-profiles","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/certificate-profiles#cryptographic-constraints","content":"allow or block RSA keys;"},"757":{"id":"/docs/pr-preview/pr-24/platform/pki/certificate-profiles-29","page_id":"/docs/pr-preview/pr-24/platform/pki/certificate-profiles","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/certificate-profiles#cryptographic-constraints","content":"limit the supported RSA sizes;"},"758":{"id":"/docs/pr-preview/pr-24/platform/pki/certificate-profiles-30","page_id":"/docs/pr-preview/pr-24/platform/pki/certificate-profiles","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/certificate-profiles#cryptographic-constraints","content":"allow or block ECDSA keys;"},"759":{"id":"/docs/pr-preview/pr-24/platform/pki/certificate-profiles-31","page_id":"/docs/pr-preview/pr-24/platform/pki/certificate-profiles","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/certificate-profiles#cryptographic-constraints","content":"limit the supported ECDSA sizes or curves."},"760":{"id":"/docs/pr-preview/pr-24/platform/pki/certificate-profiles-32","page_id":"/docs/pr-preview/pr-24/platform/pki/certificate-profiles","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/certificate-profiles#cryptographic-constraints","content":"When it is enabled, Lamassu checks the public key before creating a CA or signing a CSR. A key whose type or size is not listed in the profile is rejected."},"761":{"id":"/docs/pr-preview/pr-24/platform/pki/certificate-profiles-33","page_id":"/docs/pr-preview/pr-24/platform/pki/certificate-profiles","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/certificate-profiles#profile-precedence","content":"In operations that accept multiple sources, Lamassu resolves the profile in this order:"},"762":{"id":"/docs/pr-preview/pr-24/platform/pki/certificate-profiles-34","page_id":"/docs/pr-preview/pr-24/platform/pki/certificate-profiles","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/certificate-profiles#profile-precedence","content":"The profile sent within the operation."},"763":{"id":"/docs/pr-preview/pr-24/platform/pki/certificate-profiles-35","page_id":"/docs/pr-preview/pr-24/platform/pki/certificate-profiles","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/certificate-profiles#profile-precedence","content":"The profile identifier sent in the operation."},"764":{"id":"/docs/pr-preview/pr-24/platform/pki/certificate-profiles-36","page_id":"/docs/pr-preview/pr-24/platform/pki/certificate-profiles","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/certificate-profiles#profile-precedence","content":"The default profile associated with the CA."},"765":{"id":"/docs/pr-preview/pr-24/platform/pki/certificate-profiles-37","page_id":"/docs/pr-preview/pr-24/platform/pki/certificate-profiles","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/certificate-profiles#profile-precedence","content":"A DMS can also reference its own issuance profile. This way, several fleets can use the same CA with different policies."},"766":{"id":"/docs/pr-preview/pr-24/platform/pki/certificate-profiles-38","page_id":"/docs/pr-preview/pr-24/platform/pki/certificate-profiles","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/certificate-profiles#define-a-single-purpose","content":"Separate, for example, mTLS devices, servers and intermediate CAs. A small, specific profile is easier to review than one that allows every use."},"767":{"id":"/docs/pr-preview/pr-24/platform/pki/certificate-profiles-39","page_id":"/docs/pr-preview/pr-24/platform/pki/certificate-profiles","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/certificate-profiles#choose-the-validity","content":"Align the duration with the fleet's real renewal capacity. Leave margin against the CA's expiration."},"768":{"id":"/docs/pr-preview/pr-24/platform/pki/certificate-profiles-40","page_id":"/docs/pr-preview/pr-24/platform/pki/certificate-profiles","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/certificate-profiles#fix-usages-and-subject","content":"For a device that authenticates as a client, the usual starting point is `DigitalSignature` and `ClientAuth`. Add `ServerAuth` or `KeyEncipherment` only if the protocol needs it."},"769":{"id":"/docs/pr-preview/pr-24/platform/pki/certificate-profiles-41","page_id":"/docs/pr-preview/pr-24/platform/pki/certificate-profiles","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/certificate-profiles#constrain-the-keys","content":"Enable cryptographic enforcement and list only algorithms and sizes compatible with your policy and your devices."},"770":{"id":"/docs/pr-preview/pr-24/platform/pki/certificate-profiles-42","page_id":"/docs/pr-preview/pr-24/platform/pki/certificate-profiles","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/certificate-profiles#attach-it-and-test","content":"Attach the profile to a CA or DMS. Issue a test certificate and check subject, SAN, KU, EKU, basic constraints and dates with an independent X.509 tool."},"771":{"id":"/docs/pr-preview/pr-24/platform/pki/certificate-profiles-43","page_id":"/docs/pr-preview/pr-24/platform/pki/certificate-profiles","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/certificate-profiles#design-examples","content":"**mTLS device**\\\nEnd-entity certificate, short validity, `DigitalSignature`, `ClientAuth`, subject controlled by the DMS and SAN allowed when it identifies the device."},"772":{"id":"/docs/pr-preview/pr-24/platform/pki/certificate-profiles-44","page_id":"/docs/pr-preview/pr-24/platform/pki/certificate-profiles","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/certificate-profiles#design-examples","content":"**TLS server**\\\nEnd-entity certificate, `DigitalSignature`, `ServerAuth` and mandatory SAN with the names clients will use."},"773":{"id":"/docs/pr-preview/pr-24/platform/pki/certificate-profiles-45","page_id":"/docs/pr-preview/pr-24/platform/pki/certificate-profiles","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/certificate-profiles#design-examples","content":"**Intermediate CA**\\\n`Sign as CA`, `CertSign` and `CRLSign`, validity longer than its end-entity certificates and stricter cryptographic constraints."},"774":{"id":"/docs/pr-preview/pr-24/platform/pki/certificate-profiles-46","page_id":"/docs/pr-preview/pr-24/platform/pki/certificate-profiles","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/certificate-profiles#design-examples","content":"These are starting patterns, not a universal policy. Always verify the requirements of the protocol, the consumer and the applicable regulatory framework."},"775":{"id":"/docs/pr-preview/pr-24/platform/pki/certificate-profiles-47","page_id":"/docs/pr-preview/pr-24/platform/pki/certificate-profiles","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/certificate-profiles#changes-and-deletion","content":"Updating a profile affects future issuances; it does not modify already-signed certificates. Test changes before applying them to a CA in production and keep the operational justification."},"776":{"id":"/docs/pr-preview/pr-24/platform/pki/certificate-profiles-48","page_id":"/docs/pr-preview/pr-24/platform/pki/certificate-profiles","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/certificate-profiles#changes-and-deletion","content":"Before deleting a profile, check that no CA or DMS depends on it. If you want to replace it, create the new version, update the references and perform a test issuance before retiring the old one."},"777":{"id":"/docs/pr-preview/pr-24/platform/pki/certificate-validation","page_id":"/docs/pr-preview/pr-24/platform/pki/certificate-validation","type":"page","content":"Certificate validation","breadcrumbs":["Docs","Platform","Operate Lamassu"],"tags":[],"url":"/docs/pr-preview/pr-24/platform/pki/certificate-validation"},"778":{"id":"/docs/pr-preview/pr-24/platform/pki/certificate-validation-0","page_id":"/docs/pr-preview/pr-24/platform/pki/certificate-validation","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/certificate-validation","content":"Publish the status of identities through OCSP and CRL."},"779":{"id":"/docs/pr-preview/pr-24/platform/pki/certificate-validation-1","page_id":"/docs/pr-preview/pr-24/platform/pki/certificate-validation","type":"heading","tags":[],"url":"/docs/pr-preview/pr-24/platform/pki/certificate-validation#choose-a-mechanism","content":"Choose a mechanism"},"780":{"id":"/docs/pr-preview/pr-24/platform/pki/certificate-validation-2","page_id":"/docs/pr-preview/pr-24/platform/pki/certificate-validation","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/certificate-validation","content":"Issuance proves who signed a certificate; validation tells you whether it should still be accepted. Lamassu publishes status through two complementary mechanisms."},"781":{"id":"/docs/pr-preview/pr-24/platform/pki/certificate-validation-3","page_id":"/docs/pr-preview/pr-24/platform/pki/certificate-validation","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/certificate-validation#choose-a-mechanism","content":"Use **OCSP** when the consumer is online and needs to check the latest status of a specific certificate."},"782":{"id":"/docs/pr-preview/pr-24/platform/pki/certificate-validation-4","page_id":"/docs/pr-preview/pr-24/platform/pki/certificate-validation","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/certificate-validation#choose-a-mechanism","content":"Use a **CRL** when validation must happen locally, offline or over a high volume of certificates. The consumer periodically downloads a signed list and keeps it until the next update."},"783":{"id":"/docs/pr-preview/pr-24/platform/pki/certificate-validation-5","page_id":"/doc