-24/platform/pki/cmp","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/cmp#cmp-certificate-management-protocol","content":"Autenticación"},"746":{"id":"/docs/pr-preview/pr-24/platform/pki/cmp-52","page_id":"/docs/pr-preview/pr-24/platform/pki/cmp","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/cmp#cmp-certificate-management-protocol","content":"mTLS en la capa de transporte"},"747":{"id":"/docs/pr-preview/pr-24/platform/pki/cmp-53","page_id":"/docs/pr-preview/pr-24/platform/pki/cmp","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/cmp#cmp-certificate-management-protocol","content":"**Protección del propio mensaje** (`PKIMessage`) mediante firma o, en `ir`/`cr`, prueba de posesión CRMF"},"748":{"id":"/docs/pr-preview/pr-24/platform/pki/cmp-54","page_id":"/docs/pr-preview/pr-24/platform/pki/cmp","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/cmp#cmp-certificate-management-protocol","content":"Ajustes"},"749":{"id":"/docs/pr-preview/pr-24/platform/pki/cmp-55","page_id":"/docs/pr-preview/pr-24/platform/pki/cmp","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/cmp#cmp-certificate-management-protocol","content":"Bloques generales de enrollment y re-enrollment"},"750":{"id":"/docs/pr-preview/pr-24/platform/pki/cmp-56","page_id":"/docs/pr-preview/pr-24/platform/pki/cmp","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/cmp#cmp-certificate-management-protocol","content":"Ajustes generales **más un bloque de política por operación** (`ir`, `cr`, `p10cr`, `kur`, `rr`, `genm`, `ccr`)"},"751":{"id":"/docs/pr-preview/pr-24/platform/pki/cmp-57","page_id":"/docs/pr-preview/pr-24/platform/pki/cmp","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/cmp#cmp-certificate-management-protocol","content":"Confirmación"},"752":{"id":"/docs/pr-preview/pr-24/platform/pki/cmp-58","page_id":"/docs/pr-preview/pr-24/platform/pki/cmp","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/cmp#cmp-certificate-management-protocol","content":"La respuesta es el final del flujo"},"753":{"id":"/docs/pr-preview/pr-24/platform/pki/cmp-59","page_id":"/docs/pr-preview/pr-24/platform/pki/cmp","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/cmp#cmp-certificate-management-protocol","content":"Protocolo de confirmación explícito (`certConf`), confirmación implícita negociable y transacciones con estados"},"754":{"id":"/docs/pr-preview/pr-24/platform/pki/cmp-60","page_id":"/docs/pr-preview/pr-24/platform/pki/cmp","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/cmp#cmp-certificate-management-protocol","content":"Renovación"},"755":{"id":"/docs/pr-preview/pr-24/platform/pki/cmp-61","page_id":"/docs/pr-preview/pr-24/platform/pki/cmp","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/cmp#cmp-certificate-management-protocol","content":"`/simplereenroll` con el certificado en vigor"},"756":{"id":"/docs/pr-preview/pr-24/platform/pki/cmp-62","page_id":"/docs/pr-preview/pr-24/platform/pki/cmp","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/cmp#cmp-certificate-management-protocol","content":"`kur` protegido por el certificado que se renueva, con política de clave e identidad por DMS"},"757":{"id":"/docs/pr-preview/pr-24/platform/pki/cmp-63","page_id":"/docs/pr-preview/pr-24/platform/pki/cmp","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/cmp#cmp-certificate-management-protocol","content":"El protocolo se selecciona con el campo `protocol` del DMS (`EST_RFC7030` o `CMP_RFC9483`) y cada uno tiene su propio bloque de configuración (`est_settings` / `cmp_settings`). Cambiar el protocolo de un DMS existente sustituye por completo el bloque del protocolo anterior: no hay migración de ajustes entre uno y otro."},"758":{"id":"/docs/pr-preview/pr-24/platform/pki/cmp-64","page_id":"/docs/pr-preview/pr-24/platform/pki/cmp","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/cmp#cmp-certificate-management-protocol","content":"Esta guía está dividida en dos partes:"},"759":{"id":"/docs/pr-preview/pr-24/platform/pki/cmp-65","page_id":"/docs/pr-preview/pr-24/platform/pki/cmp","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/cmp#cmp-certificate-management-protocol","content":"Configuración del DMS, para el administrador PKI: todos los ajustes disponibles, generales y por operación."},"760":{"id":"/docs/pr-preview/pr-24/platform/pki/cmp-66","page_id":"/docs/pr-preview/pr-24/platform/pki/cmp","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/cmp#cmp-certificate-management-protocol","content":"Integración de dispositivos, para quien consume el endpoint CMP desde firmware, librerías CMP estándar o servicios de aprovisionamiento."},"761":{"id":"/docs/pr-preview/pr-24/platform/pki/cmp-67","page_id":"/docs/pr-preview/pr-24/platform/pki/cmp","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/cmp#cmp-certificate-management-protocol","content":"Si solo necesita una orientación rápida:"},"762":{"id":"/docs/pr-preview/pr-24/platform/pki/cmp-68","page_id":"/docs/pr-preview/pr-24/platform/pki/cmp","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/cmp#cmp-certificate-management-protocol","content":"Perfil"},"763":{"id":"/docs/pr-preview/pr-24/platform/pki/cmp-69","page_id":"/docs/pr-preview/pr-24/platform/pki/cmp","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/cmp#cmp-certificate-management-protocol","content":"Leer primero"},"764":{"id":"/docs/pr-preview/pr-24/platform/pki/cmp-70","page_id":"/docs/pr-preview/pr-24/platform/pki/cmp","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/cmp#cmp-certificate-management-protocol","content":"Después"},"765":{"id":"/docs/pr-preview/pr-24/platform/pki/cmp-71","page_id":"/docs/pr-preview/pr-24/platform/pki/cmp","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/cmp#cmp-certificate-management-protocol","content":"Administrador PKI"},"766":{"id":"/docs/pr-preview/pr-24/platform/pki/cmp-72","page_id":"/docs/pr-preview/pr-24/platform/pki/cmp","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/cmp#cmp-certificate-management-protocol","content":"Selección de protocolo y Ajustes por operación"},"767":{"id":"/docs/pr-preview/pr-24/platform/pki/cmp-73","page_id":"/docs/pr-preview/pr-24/platform/pki/cmp","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/cmp#cmp-certificate-management-protocol","content":"Transacciones CMP y Monitor de confirmación"},"768":{"id":"/docs/pr-preview/pr-24/platform/pki/cmp-74","page_id":"/docs/pr-preview/pr-24/platform/pki/cmp","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/cmp#cmp-certificate-management-protocol","content":"Integrador de dispositivos"},"769":{"id":"/docs/pr-preview/pr-24/platform/pki/cmp-75","page_id":"/docs/pr-preview/pr-24/platform/pki/cmp","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/cmp#cmp-certificate-management-protocol","content":"El endpoint CMP y Modelo de autenticación"},"770":{"id":"/docs/pr-preview/pr-24/platform/pki/cmp-76","page_id":"/docs/pr-preview/pr-24/platform/pki/cmp","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/cmp#cmp-certificate-management-protocol","content":"Operaciones soportadas y Códigos de error y diagnóstico"},"771":{"id":"/docs/pr-preview/pr-24/platform/pki/cmp-77","page_id":"/docs/pr-preview/pr-24/platform/pki/cmp","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/cmp#requisitos-previos","content":"Antes de configurar un DMS para CMP, deben existir los siguientes recursos en la plataforma:"},"772":{"id":"/docs/pr-preview/pr-24/platform/pki/cmp-78","page_id":"/docs/pr-preview/pr-24/platform/pki/cmp","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/cmp#requisitos-previos","content":"**Una CA disponible**: la CA que actuará como `EnrollmentCA` debe estar creada y en estado activo. Si se habilita la generación de claves en servidor (KGA), las CAs contra las que se validará el certificado destinatario también deben existir (ver Generación de claves en servidor)."},"773":{"id":"/docs/pr-preview/pr-24/platform/pki/cmp-79","page_id":"/docs/pr-preview/pr-24/platform/pki/cmp","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/cmp#requisitos-previos","content":"**Un certificado de protección**: CMP firma sus propias respuestas. El DMS necesita un certificado de tipo End Entity cuya clave privada resida en el KMS de Lamassu (`protection_certificate`, ver más abajo)."},"774":{"id":"/docs/pr-preview/pr-24/platform/pki/cmp-80","page_id":"/docs/pr-preview/pr-24/platform/pki/cmp","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/cmp#requisitos-previos","content":"**Un DMS creado**: la configuración CMP se aplica sobre un DMS existente, no lo crea."},"775":{"id":"/docs/pr-preview/pr-24/platform/pki/cmp-81","page_id":"/docs/pr-preview/pr-24/platform/pki/cmp","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/cmp#requisitos-previos","content":"Los ajustes de **CA Distribution** (qué autoridades recibe el dispositivo como anclas de confianza) son idénticos para ambos protocolos y se describen en la visión general del DMS."},"776":{"id":"/docs/pr-preview/pr-24/platform/pki/cmp-82","page_id":"/docs/pr-preview/pr-24/platform/pki/cmp","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/cmp#selección-de-protocolo","content":"Al crear o editar un DMS, el campo `protocol` decide qué bloque de configuración aplica:"},"777":{"id":"/docs/pr-preview/pr-24/platform/pki/cmp-83","page_id":"/docs/pr-preview/pr-24/platform/pki/cmp","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/cmp#selección-de-protocolo","content":"Valor"},"778":{"id":"/docs/pr-preview/pr-24/platform/pki/cmp-84","page_id":"/docs/pr-preview/pr-24/platform/pki/cmp","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/cmp#selección-de-protocolo","content":"Protocolo"},"779":{"id":"/docs/pr-preview/pr-24/platform/pki/cmp-85","page_id":"/docs/pr-preview/pr-24/platform/pki/cmp","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/cmp#selección-de-protocolo","content":"`EST_RFC7030`"},"780":{"id":"/docs/pr-preview/pr-24/platform/pki/cmp-86","page_id":"/docs/pr-preview/pr-24/platform/pki/cmp","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/cmp#selección-de-protocolo","content":"EST — ver la guía EST"},"781":{"id":"/docs/pr-preview/pr-24/platform/pki/cmp-87","page_id":"/docs/pr-preview/pr-24/platform/pki/cmp","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/cmp#selección-de-protocolo","content":"`CMP_RFC9483`"},"782":{"id":"/docs/pr-preview/pr-24/platform/pki/cmp-88","page_id":"/docs/pr-preview/pr-24/platform/pki/cmp","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/cmp#selección-de-protocolo","content":"CMP — esta página"},"783":{"id":"/docs/pr-preview/pr-24/platform/pki/cmp-89","page_id":"/docs/pr-preview/pr-24/platform/pki/cmp","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/cmp#selección-de-protocolo","content":"Un valor distinto de los dos anteriores hace fallar la creación o edición del DMS con el error `DMS enrollment protocol must be EST_RFC7030 or CMP_RFC9483`. Al cambiar el `protocol` de un DMS, el bloque del protocolo saliente se descarta por completo y se sustituye por el entrante: los ajustes de cada protocolo son autónomos y no se copian entre sí."},"784":{"id":"/docs/pr-preview/pr-24/platform/pki/cmp-90","page_id":"/docs/pr-preview/pr-24/platform/pki/cmp","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/cmp#ajustes-compartidos-con-est","content":"Estos campos son comunes a los dos protocolos y significan lo mismo en ambos:"},"785":{"id":"/docs/pr-preview/pr-24/platform/pki/cmp-91","page_id":"/docs/pr-preview/pr-24/platform/pki/cmp","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/cmp#ajustes-compartidos-con-est","content":"Campo"},"786":{"id":"/docs/pr-preview/pr-24/platform/pki/cmp-92","page_id":"/docs/pr-preview/pr-24/platform/pki/cmp","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/cmp#ajustes-compartidos-con-est","content":"Descripción"},"787":{"id":"/docs/pr-preview/pr-24/platform/pki/cmp-93","page_id":"/docs/pr-preview/pr-24/platform/pki/cmp","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/cmp#ajustes-compartidos-con-est","content":"`enrollment_ca`"},"788":{"id":"/docs/pr-preview/pr-24/platform/pki/cmp-94","page_id":"/docs/pr-preview/pr-24/platform/pki/cmp","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/cmp#ajustes-compartidos-con-est","content":"CA que firmará los certificados de identidad emitidos por este DMS."},"789":{"id":"/docs/pr-preview/pr-24/platform/pki/cmp-95","page_id":"/docs/pr-preview/pr-24/platform/pki/cmp","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/cmp#ajustes-compartidos-con-est","content":"`registration_mode`"},"790":{"id":"/docs/pr-preview/pr-24/platform/pki/cmp-96","page_id":"/docs/pr-preview/pr-24/platform/pki/cmp","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/cmp#ajustes-compartidos-con-est","content":"`JITP` (*Just-In-Time Provisioning*) crea el dispositivo automáticamente en la primera inscripción, aplicando el perfil de aprovisionamiento; `PRE_REGISTRATION` exige que el dispositivo exista previamente y rechaza lo contrario con `device not preregistered`."},"791":{"id":"/docs/pr-preview/pr-24/platform/pki/cmp-97","page_id":"/docs/pr-preview/pr-24/platform/pki/cmp","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/cmp#ajustes-compartidos-con-est","content":"`device_provisioning_profile`"},"792":{"id":"/docs/pr-preview/pr-24/platform/pki/cmp-98","page_id":"/docs/pr-preview/pr-24/platform/pki/cmp","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/cmp#ajustes-compartidos-con-est","content":"Icono, color, metadatos y tags aplicados a cada dispositivo creado en modo JITP."},"793":{"id":"/docs/pr-preview/pr-24/platform/pki/cmp-99","page_id":"/docs/pr-preview/pr-24/platform/pki/cmp","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/cmp#ajustes-compartidos-con-est","content":"`enable_replaceable_enrollment`"},"794":{"id":"/docs/pr-preview/pr-24/platform/pki/cmp-100","page_id":"/docs/pr-preview/pr-24/platform/pki/cmp","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/cmp#ajustes-compartidos-con-est","content":"Permite que un dispositivo ya enrolado vuelva a inscribirse. Cuando está inactiva, un segundo intento de `ir`/`cr` sobre un dispositivo existente se rechaza con `forbiddenNewEnrollment`. Si la sustitución de la identidad revoca el certificado anterior (con la razón `superseded`) lo decide `revoke_on_reenrollment`, o el `certificate_behavior` de `cr` — ver Configuración de re-enrollment."},"795":{"id":"/docs/pr-preview/pr-24/platform/pki/cmp-101","page_id":"/docs/pr-preview/pr-24/platform/pki/cmp","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/cmp#ajustes-compartidos-con-est","content":"`verify_csr_signature`"},"796":{"id":"/docs/pr-preview/pr-24/platform/pki/cmp-102","page_id":"/docs/pr-preview/pr-24/platform/pki/cmp","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/cmp#ajustes-compartidos-con-est","content":"**Sin efecto en CMP.** El servidor sintetiza el CSR a partir del `CertTemplate` (su firma es sustituida por un valor ficticio) y la prueba de posesión se establece por otras vías: la POPO de `ir`/`cr`, el CSR PKCS#10 de `p10cr` (verificado siempre) o la protección de `kur`."},"797":{"id":"/docs/pr-preview/pr-24/platform/pki/cmp-103","page_id":"/docs/pr-preview/pr-24/platform/pki/cmp","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/cmp#modo-de-autenticación","content":"`auth_mode` define cómo el DMS valida la identidad del solicitante. CMP reconoce los mismos cuatro modos que EST, pero el mecanismo cambia: **la autenticación se verifica dentro del propio mensaje CMP, no en la capa de transporte**."},"798":{"id":"/docs/pr-preview/pr-24/platform/pki/cmp-104","page_id":"/docs/pr-preview/pr-24/platform/pki/cmp","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/cmp#modo-de-autenticación","content":"Modo"},"799":{"id":"/docs/pr-preview/pr-24/platform/pki/cmp-105","page_id":"/docs/pr-preview/pr-24/platform/pki/cmp","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/cmp#modo-de-autenticación","content":"Descripción"},"800":{"id":"/docs/pr-preview/pr-24/platform/pki/cmp-106","page_id":"/docs/pr-preview/pr-24/platform/pki/cmp","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/cmp#modo-de-autenticación","content":"`CLIENT_CERTIFICATE`"},"801":{"id":"/docs/pr-preview/pr-24/platform/pki/cmp-107","page_id":"/docs/pr-preview/pr-24/platform/pki/cmp","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/cmp#modo-de-autenticación","content":"El mensaje debe ir **protegido por firma** con el certificado del dispositivo (`extraCerts[0]` del `PKIMessage`), validado contra las CAs declaradas en `client_certificate_settings.validation_cas`. No es mTLS: es la firma sobre el `PKIMessage` (RFC 9483 §3.2)."},"802":{"id":"/docs/pr-preview/pr-24/platform/pki/cmp-108","page_id":"/docs/pr-preview/pr-24/platform/pki/cmp","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/cmp#modo-de-autenticación","content":"`CLIENT_CERTIFICATE_AND_EXTERNAL_WEBHOOK`"},"803":{"id":"/docs/pr-preview/pr-24/platform/pki/cmp-109","page_id":"/docs/pr-preview/pr-24/platform/pki/cmp","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/cmp#modo-de-autenticación","content":"Combina los dos controles: firma válida **y** aprobación del webhook."},"804":{"id":"/docs/pr-preview/pr-24/platform/pki/cmp-110","page_id":"/docs/pr-preview/pr-24/platform/pki/cmp","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/cmp#modo-de-autenticación","content":"`EXTERNAL_WEBHOOK`"},"805":{"id":"/docs/pr-preview/pr-24/platform/pki/cmp-111","page_id":"/docs/pr-preview/pr-24/platform/pki/cmp","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/cmp#modo-de-autenticación","content":"La decisión de autorización se delega en un servicio HTTP externo, con el mismo contrato que en EST. El mensaje puede llegar sin protección."},"806":{"id":"/docs/pr-preview/pr-24/platform/pki/cmp-112","page_id":"/docs/pr-preview/pr-24/platform/pki/cmp","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/cmp#modo-de-autenticación","content":"`NO_AUTH`"},"807":{"id":"/docs/pr-preview/pr-24/platform/pki/cmp-113","page_id":"/docs/pr-preview/pr-24/platform/pki/cmp","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/cmp#modo-de-autenticación","content":"Sin autenticación obligatoria. El mensaje puede llegar sin protección; si trae una firma, igualmente se valida. &#x2A;*Exclusivo para laboratorios o redes de aprovisionamiento aisladas.**"},"808":{"id":"/docs/pr-preview/pr-24/platform/pki/cmp-114","page_id":"/docs/pr-preview/pr-24/platform/pki/cmp","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/cmp#modo-de-autenticación","content":"Un DMS cuya `auth_mode` está vacía o no definida se considera mal configurado: toda solicitud se rechaza con `DMS auth mode not supported`, en lugar de aceptarse sin autenticación. El valor `NONE` se acepta como alias heredado de `NO_AUTH` desde el panel de administración."},"809":{"id":"/docs/pr-preview/pr-24/platform/pki/cmp-115","page_id":"/docs/pr-preview/pr-24/platform/pki/cmp","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/cmp#modo-de-autenticación","content":"Cuando el modo incluye `CLIENT_CERTIFICATE`, se configuran los mismos parámetros que en EST: **Validation CAs**, **Chain Validation Level** (`-1` valida la cadena completa) y **Allow Authenticating Expired Certificates**. Cuando incluye `EXTERNAL_WEBHOOK`, se configuran los mismos parámetros de webhook que en EST (URL, método, timeout — 10 segundos por defecto — y modo de autenticación del webhook). El contrato del servicio webhook es idéntico en ambos protocolos; consulte la sección equivalente de la guía EST para el detalle de cada campo y la referencia del webhook de autorización para el esquema."},"810":{"id":"/docs/pr-preview/pr-24/platform/pki/cmp-116","page_id":"/docs/pr-preview/pr-24/platform/pki/cmp","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/cmp#modo-de-autenticación","content":"A diferencia de EST, CMP no tiene un modo de autenticación separado para la renovación: `kur` siempre se autentica con la protección por firma del propio certificado que se renueva."},"811":{"id":"/docs/pr-preview/pr-24/platform/pki/cmp-117","page_id":"/docs/pr-preview/pr-24/platform/pki/cmp","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/cmp#confirmación-y-flujo-de-emisión","content":"A diferencia de EST, CMP incluye un protocolo de confirmación explícito (RFC 4210 §5.2.8) y admite un flujo de aprobación diferida:"},"812":{"id":"/docs/pr-preview/pr-24/platform/pki/cmp-118","page_id":"/docs/pr-preview/pr-24/platform/pki/cmp","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/cmp#confirmación-y-flujo-de-emisión","content":"Campo"},"813":{"id":"/docs/pr-preview/pr-24/platform/pki/cmp-119","page_id":"/docs/pr-preview/pr-24/platform/pki/cmp","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/cmp#confirmación-y-flujo-de-emisión","content":"Tipo"},"814":{"id":"/docs/pr-preview/pr-24/platform/pki/cmp-120","page_id":"/docs/pr-preview/pr-24/platform/pki/cmp","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/cmp#confirmación-y-flujo-de-emisión","content":"Descripción"},"815":{"id":"/docs/pr-preview/pr-24/platform/pki/cmp-121","page_id":"/docs/pr-preview/pr-24/platform/pki/cmp","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/cmp#confirmación-y-flujo-de-emisión","content":"`accept_implicit`"},"816":{"id":"/docs/pr-preview/pr-24/platform/pki/cmp-122","page_id":"/docs/pr-preview/pr-24/platform/pki/cmp","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/cmp#confirmación-y-flujo-de-emisión","content":"booleano"},"817":{"id":"/docs/pr-preview/pr-24/platform/pki/cmp-123","page_id":"/docs/pr-preview/pr-24/platform/pki/cmp","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/cmp#confirmación-y-flujo-de-emisión","content":"Permite **omitir** el paso `certConf` cuando el dispositivo solicita confirmación implícita (`id-it-implicitConfirm` en `generalInfo`). Solo tiene efecto si el dispositivo también la solicita; la solicitud sola no la fuerza. Desactivado por defecto."},"818":{"id":"/docs/pr-preview/pr-24/platform/pki/cmp-124","page_id":"/docs/pr-preview/pr-24/platform/pki/cmp","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/cmp#confirmación-y-flujo-de-emisión","content":"`confirmation_timeout`"},"819":{"id":"/docs/pr-preview/pr-24/platform/pki/cmp-125","page_id":"/docs/pr-preview/pr-24/platform/pki/cmp","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/cmp#confirmación-y-flujo-de-emisión","content":"duración"},"820":{"id":"/docs/pr-preview/pr-24/platform/pki/cmp-126","page_id":"/docs/pr-preview/pr-24/platform/pki/cmp","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/cmp#confirmación-y-flujo-de-emisión","content":"Ventana de espera del `certConf` (por ejemplo `30s`, `5m`, `1h`). Un valor cero o negativo usa el por defecto: **5 minutos**."},"821":{"id":"/docs/pr-preview/pr-24/platform/pki/cmp-127","page_id":"/docs/pr-preview/pr-24/platform/pki/cmp","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/cmp#confirmación-y-flujo-de-emisión","content":"`workflow`"},"822":{"id":"/docs/pr-preview/pr-24/platform/pki/cmp-128","page_id":"/docs/pr-preview/pr-24/platform/pki/cmp","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/cmp#confirmación-y-flujo-de-emisión","content":"`direct` / `phased`"},"823":{"id":"/docs/pr-preview/pr-24/platform/pki/cmp-129","page_id":"/docs/pr-preview/pr-24/platform/pki/cmp","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/cmp#confirmación-y-flujo-de-emisión","content":"`direct` (por defecto) emite el certificado en línea, en la misma respuesta a `ir`/`cr`/`kur`/`p10cr`. `phased` retiene la solicitud hasta que un administrador la apruebe; el dispositivo recupera el resultado con `pollReq`. La generación de claves en servidor y la certificación cruzada tienen su propio flujo y no dependen de este campo."},"824":{"id":"/docs/pr-preview/pr-24/platform/pki/cmp-130","page_id":"/docs/pr-preview/pr-24/platform/pki/cmp","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/cmp#confirmación-y-flujo-de-emisión","content":"`approval_timeout`"},"825":{"id":"/docs/pr-preview/pr-24/platform/pki/cmp-131","page_id":"/docs/pr-preview/pr-24/platform/pki/cmp","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/cmp#confirmación-y-flujo-de-emisión","content":"duración"},"826":{"id":"/docs/pr-preview/pr-24/platform/pki/cmp-132","page_id":"/docs/pr-preview/pr-24/platform/pki/cmp","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/cmp#confirmación-y-flujo-de-emisión","content":"Solo aplica con `workflow: phased`. Tiempo que una transacción permanece `PENDING` esperando aprobación. Sin valor, el por defecto es **7 días**."},"827":{"id":"/docs/pr-preview/pr-24/platform/pki/cmp-133","page_id":"/docs/pr-preview/pr-24/platform/pki/cmp","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/cmp#certificado-de-protección-y-prueba-de-posesión","content":"**Protection Certificate** (`protection_certificate`): número de serie del certificado End Entity, respaldado por el KMS, con el que el DMS protege (firma) sus respuestas CMP. El servidor no obliga a configurarlo, pero sin él **todas** las respuestas — incluidos los mensajes de error — salen sin protección, y los clientes CMP estándar (`openssl cmp` incluido) rechazan por defecto las respuestas sin protección. En la práctica es imprescindible."},"828":{"id":"/docs/pr-preview/pr-24/platform/pki/cmp-134","page_id":"/docs/pr-preview/pr-24/platform/pki/cmp","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/cmp#certificado-de-protección-y-prueba-de-posesión","content":"**Enforce POPO** (`enforce_popo`): opción heredada que **ya no gobierna ninguna verificación**. La política de prueba de posesión de `ir`/`cr` vive en su bloque por operación (`proof_of_possession.required`), `kur` y `rr` están siempre protegidos por firma como invariantes del protocolo, y la firma del CSR de `p10cr` se verifica siempre. El campo persiste y round-trip en la API, pero su valor no altera el comportamiento."},"829":{"id":"/docs/pr-preview/pr-24/platform/pki/cmp-135","page_id":"/docs/pr-preview/pr-24/platform/pki/cmp","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/cmp#certificado-de-protección-y-prueba-de-posesión","content":"**Expected Authenticator** (`expected_authenticator`): respuesta compartida que se compara contra el control `id-regCtrl-authenticator` (RFC 4211 §6.2) cuando una solicitud de emisión (`ir`/`cr`/`kur`) lo incluye. Vacío por defecto: un control presente se acepta sin comparar su valor. Con valor configurado, un control cuyo contenido no coincide se rechaza con `incorrectData`. **Marcado como legado**: almacena un secreto en claro en el DMS; la configuración nueva debe usar los controles `registration_token`/`authenticator_control` por operación, que solo almacenan un modo."},"830":{"id":"/docs/pr-preview/pr-24/platform/pki/cmp-136","page_id":"/docs/pr-preview/pr-24/platform/pki/cmp","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/cmp#ajustes-por-operación","content":"Además de los campos generales anteriores, cada operación CMP tiene su propio bloque de configuración con un interruptor `enabled` y una política específica. Las operaciones de emisión (`ir`, `cr`, `p10cr`, `kur`) admiten además `policy_overrides`:"},"831":{"id":"/docs/pr-preview/pr-24/platform/pki/cmp-137","page_id":"/docs/pr-preview/pr-24/platform/pki/cmp","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/cmp#ajustes-por-operación","content":"`policy_overrides.workflow`: `inherit` (toma el `workflow` general), `direct` o `phased`."},"832":{"id":"/docs/pr-preview/pr-24/platform/pki/cmp-138","page_id":"/docs/pr-preview/pr-24/platform/pki/cmp","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/cmp#ajustes-por-operación","content":"`policy_overrides.confirmation`: `inherit`, `implicit` (fuerza disposición a la confirmación implícita) o `explicit` (fuerza el `certConf`)."},"833":{"id":"/docs/pr-preview/pr-24/platform/pki/cmp-139","page_id":"/docs/pr-preview/pr-24/platform/pki/cmp","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/cmp#ajustes-por-operación","content":"`policy_overrides.issuance_profile_id`: fija un perfil de emisión específico para esa operación. Se aplica en `ir`, `cr` y `p10cr`; el `kur` renueva siempre con el perfil general del DMS."},"834":{"id":"/docs/pr-preview/pr-24/platform/pki/cmp-140","page_id":"/docs/pr-preview/pr-24/platform/pki/cmp","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/cmp#ajustes-por-operación","content":"La confirmación implícita efectiva siempre requiere además que el dispositivo la pida (`id-it-implicitConfirm`): el ajuste solo expresa la disposición del servidor."},"835":{"id":"/docs/pr-preview/pr-24/platform/pki/cmp-141","page_id":"/docs/pr-preview/pr-24/platform/pki/cmp","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/cmp#ajustes-por-operación","content":"Cada bloque por operación detecta si nunca se configuró observando un **campo clave**: `identity_source` en `ir`, `certificate_behavior` en `cr`, `key_policy` en `kur`, `authorization` en `rr`, `access_policy` en `genm` y `workflow` en `ccr`. Si ese campo llega vacío, el bloque se rellena íntegro con sus valores por defecto en cada lectura del DMS — incluido cualquier otro campo que se haya enviado. Para ajustar un campo secundario (por ejemplo, `maximum_active_certificates` de `cr`) debe fijarse también el campo clave del bloque, o la resolución lo devuelve a su valor por defecto. `p10cr` no tiene campo clave: permanece deshabilitado salvo que se ponga `enabled: true` explícitamente."},"836":{"id":"/docs/pr-preview/pr-24/platform/pki/cmp-142","page_id":"/docs/pr-preview/pr-24/platform/pki/cmp","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/cmp#ir--initialization-request","content":"Alta inicial de un dispositivo nuevo (RFC 9483 §4.1.1), equivalente al `/simpleenroll` de EST. Habilitado por defecto."},"837":{"id":"/docs/pr-preview/pr-24/platform/pki/cmp-143","page_id":"/docs/pr-preview/pr-24/platform/pki/cmp","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/cmp#ir--initialization-request","content":"Campo"},"838":{"id":"/docs/pr-preview/pr-24/platform/pki/cmp-144","page_id":"/docs/pr-preview/pr-24/platform/pki/cmp","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/cmp#ir--initialization-request","content":"Descripción"},"839":{"id":"/docs/pr-preview/pr-24/platform/pki/cmp-145","page_id":"/docs/pr-preview/pr-24/platform/pki/cmp","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/cmp#ir--initialization-request","content":"`enabled`"},"840":{"id":"/docs/pr-preview/pr-24/platform/pki/cmp-146","page_id":"/docs/pr-preview/pr-24/platform/pki/cmp","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/cmp#ir--initialization-request","content":"Habilita la operación. Deshabilitarla rechaza cualquier `ir` con `notAuthorized`."},"841":{"id":"/docs/pr-preview/pr-24/platform/pki/cmp-147","page_id":"/docs/pr-preview/pr-24/platform/pki/cmp","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/cmp#ir--initialization-request","content":"`proof_of_possession.required`"},"842":{"id":"/docs/pr-preview/pr-24/platform/pki/cmp-148","page_id":"/docs/pr-preview/pr-24/platform/pki/cmp","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/cmp#ir--initialization-request","content":"Si la POPO es obligatoria. Por defecto `true`: un `ir` sin prueba de posesión aceptable se rechaza con `badPOP`."},"843":{"id":"/docs/pr-preview/pr-24/platform/pki/cmp-149","page_id":"/docs/pr-preview/pr-24/platform/pki/cmp","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/cmp#ir--initialization-request","content":"`proof_of_possession.allowed_methods`"},"844":{"id":"/docs/pr-preview/pr-24/platform/pki/cmp-150","page_id":"/docs/pr-preview/pr-24/platform/pki/cmp","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/cmp#ir--initialization-request","content":"Métodos de POPO aceptados: `signature` (POPOSigningKey sobre el CertRequest), `trusted_ra` (`raVerified` de una RA de confianza con EKU `id-kp-cmcRA`), `challenge_response` (reto-respuesta `popdecc`/`popdecr`) y `encrypted_certificate` (el certificado se entrega cifrado al destinatario, que demuestra posesión al descifrarlo). Por defecto `signature` + `trusted_ra`. Una lista vacía no admite ningún método."},"845":{"id":"/docs/pr-preview/pr-24/platform/pki/cmp-151","page_id":"/docs/pr-preview/pr-24/platform/pki/cmp","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/cmp#ir--initialization-request","content":"`registration_token`"},"846":{"id":"/docs/pr-preview/pr-24/platform/pki/cmp-152","page_id":"/docs/pr-preview/pr-24/platform/pki/cmp","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/cmp#ir--initialization-request","content":"Control RFC 4211 §6.1 con modo `disabled` (por defecto), `optional` o `required`. El modo gobierna la **presencia** del control: `disabled` rechaza un `ir` que lo traiga; `required` exige traerlo; `optional` lo procesa cuando está presente. Los valores de regToken son credenciales de un solo uso, aprovisionadas fuera del DMS (nunca se almacenan en la configuración): un valor ya consumido se rechaza con `the regToken control was already used (RFC 4211 §6.1)`, y el token se quema aunque la emisión falle después."},"847":{"id":"/docs/pr-preview/pr-24/platform/pki/cmp-153","page_id":"/docs/pr-preview/pr-24/platform/pki/cmp","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/cmp#ir--initialization-request","content":"`authenticator_control`"},"848":{"id":"/docs/pr-preview/pr-24/platform/pki/cmp-154","page_id":"/docs/pr-preview/pr-24/platform/pki/cmp","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/cmp#ir--initialization-request","content":"Control RFC 4211 §6.2 con los mismos tres modos. Con `expected_authenticator` configurado, `optional`/`required` validan el valor; sin él, la presencia basta."},"849":{"id":"/docs/pr-preview/pr-24/platform/pki/cmp-155","page_id":"/docs/pr-preview/pr-24/platform/pki/cmp","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/cmp#ir--initialization-request","content":"`central_key_generation.allowed_recipient_methods`"},"850":{"id":"/docs/pr-preview/pr-24/platform/pki/cmp-156","page_id":"/docs/pr-preview/pr-24/platform/pki/cmp","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/cmp#ir--initialization-request","content":"Métodos de entrega de la clave generada que acepta esta operación: `rsa_key_transport` y/o `ecdh_key_agreement`. Sin configurar se aceptan ambos; una lista explícitamente vacía deniega cualquier entrega de clave generada."},"851":{"id":"/docs/pr-preview/pr-24/platform/pki/cmp-157","page_id":"/docs/pr-preview/pr-24/platform/pki/cmp","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/cmp#ir--initialization-request","content":"`central_key_generation.enabled`"},"852":{"id":"/docs/pr-preview/pr-24/platform/pki/cmp-158","page_id":"/docs/pr-preview/pr-24/platform/pki/cmp","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/cmp#ir--initialization-request","content":"Se funde con el interruptor general `server_key_gen_enabled` y con el de `cr` en una única puerta de KGA (ver Generación de claves en servidor)."},"853":{"id":"/docs/pr-preview/pr-24/platform/pki/cmp-159","page_id":"/docs/pr-preview/pr-24/platform/pki/cmp","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/cmp#ir--initialization-request","content":"`identity_source`"},"854":{"id":"/docs/pr-preview/pr-24/platform/pki/cmp-160","page_id":"/docs/pr-preview/pr-24/platform/pki/cmp","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/cmp#ir--initialization-request","content":"Selecciona de dónde se toma la identidad cuando el subject llega vacío (`subject_only` / `subject_or_san`). **Persistido pero aún no aplicado**: el comportamiento actual es fijo — con subject vacío, la identidad se deduce del SAN (`dNSName`, correo, URI, IP, en ese orden) y el certificado emitido conserva el subject NULL-DN."},"855":{"id":"/docs/pr-preview/pr-24/platform/pki/cmp-161","page_id":"/docs/pr-preview/pr-24/platform/pki/cmp","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/cmp#ir--initialization-request","content":"`policy_overrides`"},"856":{"id":"/docs/pr-preview/pr-24/platform/pki/cmp-162","page_id":"/docs/pr-preview/pr-24/platform/pki/cmp","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/cmp#ir--initialization-request","content":"Ver la introducción de esta sección."},"857":{"id":"/docs/pr-preview/pr-24/platform/pki/cmp-163","page_id":"/docs/pr-preview/pr-24/platform/pki/cmp","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/cmp#cr--certification-request","content":"Emisión para un dispositivo que ya participa en la PKI (RFC 9483 §4.1.2). Habilitado por defecto. Comparte con `ir` la estructura de `proof_of_possession`, `central_key_generation` y `policy_overrides`, y añade:"},"858":{"id":"/docs/pr-preview/pr-24/platform/pki/cmp-164","page_id":"/docs/pr-preview/pr-24/platform/pki/cmp","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/cmp#cr--certification-request","content":"Campo"},"859":{"id":"/docs/pr-preview/pr-24/platform/pki/cmp-165","page_id":"/docs/pr-preview/pr-24/platform/pki/cmp","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/cmp#cr--certification-request","content":"Descripción"},"860":{"id":"/docs/pr-preview/pr-24/platform/pki/cmp-166","page_id":"/docs/pr-preview/pr-24/platform/pki/cmp","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/cmp#cr--certification-request","content":"`require_existing_device`"},"861":{"id":"/docs/pr-preview/pr-24/platform/pki/cmp-167","page_id":"/docs/pr-preview/pr-24/platform/pki/cmp","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/cmp#cr--certification-request","content":"Por defecto `true`: un `cr` contra un dispositivo no registrado se rechaza con `certification request requires a pre-existing device identity`. Desactivarlo permite que un `cr` también dé de alta el dispositivo (sujeto al modo de registro y, si el dispositivo ya existe, a `enable_replaceable_enrollment`)."},"862":{"id":"/docs/pr-preview/pr-24/platform/pki/cmp-168","page_id":"/docs/pr-preview/pr-24/platform/pki/cmp","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/cmp#cr--certification-request","content":"`certificate_behavior`"},"863":{"id":"/docs/pr-preview/pr-24/platform/pki/cmp-169","page_id":"/docs/pr-preview/pr-24/platform/pki/cmp","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/cmp#cr--certification-request","content":"`additional` (por defecto) emite un certificado más sin revocar el anterior; `replace` sustituye el certificado activo (el anterior se revoca como `superseded` tras emitir y vincular el nuevo). El modelo de datos mantiene un único slot de identidad activa por dispositivo, así que `additional` no crea una segunda identidad activa en paralelo: solo evita revocar la anterior."},"864":{"id":"/docs/pr-preview/pr-24/platform/pki/cmp-170","page_id":"/docs/pr-preview/pr-24/platform/pki/cmp","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/cmp#cr--certification-request","content":"`maximum_active_certificates`"},"865":{"id":"/docs/pr-preview/pr-24/platform/pki/cmp-171","page_id":"/docs/pr-preview/pr-24/platform/pki/cmp","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/cmp#cr--certification-request","content":"Límite de certificados no revocados por dispositivo. Por defecto `2`; `0` desactiva el límite. El recuento se revalida bajo bloqueo justo antes de firmar, para cerrar la carrera entre dos `cr` concurrentes."},"866":{"id":"/docs/pr-preview/pr-24/platform/pki/cmp-172","page_id":"/docs/pr-preview/pr-24/platform/pki/cmp","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/cmp#cr--certification-request","content":"`allowed_profile_ids`"},"867":{"id":"/docs/pr-preview/pr-24/platform/pki/cmp-173","page_id":"/docs/pr-preview/pr-24/platform/pki/cmp","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/cmp#cr--certification-request","content":"Lista blanca de perfiles de emisión permitidos para esta operación. El perfil resuelto (fijado por `policy_overrides.issuance_profile_id` o el general del DMS) debe estar en la lista; vacía no restringe."},"868":{"id":"/docs/pr-preview/pr-24/platform/pki/cmp-174","page_id":"/docs/pr-preview/pr-24/platform/pki/cmp","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/cmp#cr--certification-request","content":"`cr` hereda además las salvaguardas generales del alta: el dispositivo debe pertenecer a este DMS (un dispositivo registrado en otro DMS se rechaza con `device already registered to another DMS`) y si ya existe se exige `enable_replaceable_enrollment`. Cuando un `cr` con `replace` sustituye la identidad, la política `key_policy` de `kur` también se aplica: con `require_new_key`, el `cr` no puede sustituir el certificado activo usando la misma clave pública."},"869":{"id":"/docs/pr-preview/pr-24/platform/pki/cmp-175","page_id":"/docs/pr-preview/pr-24/platform/pki/cmp","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/cmp#p10cr--pkcs10-certification-request","content":"Alta con un CSR PKCS#10 completo en lugar de la estructura CRMF (RFC 9483 §4.1.4). **Llega deshabilitado**: hay que activar `enabled: true` en el DMS o toda solicitud `p10cr` se rechaza con `notAuthorized`."},"870":{"id":"/docs/pr-preview/pr-24/platform/pki/cmp-176","page_id":"/docs/pr-preview/pr-24/platform/pki/cmp","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/cmp#p10cr--pkcs10-certification-request","content":"Campo"},"871":{"id":"/docs/pr-preview/pr-24/platform/pki/cmp-177","page_id":"/docs/pr-preview/pr-24/platform/pki/cmp","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/cmp#p10cr--pkcs10-certification-request","content":"Descripción"},"872":{"id":"/docs/pr-preview/pr-24/platform/pki/cmp-178","page_id":"/docs/pr-preview/pr-24/platform/pki/cmp","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/cmp#p10cr--pkcs10-certification-request","content":"`enabled`"},"873":{"id":"/docs/pr-preview/pr-24/platform/pki/cmp-179","page_id":"/docs/pr-preview/pr-24/platform/pki/cmp","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/cmp#p10cr--pkcs10-certification-request","content":"Habilita la operación. Deshabilitado por defecto."},"874":{"id":"/docs/pr-preview/pr-24/platform/pki/cmp-180","page_id":"/docs/pr-preview/pr-24/platform/pki/cmp","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/cmp#p10cr--pkcs10-certification-request","content":"`allowed_profile_ids`"},"875":{"id":"/docs/pr-preview/pr-24/platform/pki/cmp-181","page_id":"/docs/pr-preview/pr-24/platform/pki/cmp","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/cmp#p10cr--pkcs10-certification-request","content":"Lista blanca de perfiles de emisión permitidos, igual que en `cr`."},"876":{"id":"/docs/pr-preview/pr-24/platform/pki/cmp-182","page_id":"/docs/pr-preview/pr-24/platform/pki/cmp","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/cmp#p10cr--pkcs10-certification-request","content":"`policy_overrides`"},"877":{"id":"/docs/pr-preview/pr-24/platform/pki/cmp-183","page_id":"/docs/pr-preview/pr-24/platform/pki/cmp","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/cmp#p10cr--pkcs10-certification-request","content":"Ver la introducción de esta sección."},"878":{"id":"/docs/pr-preview/pr-24/platform/pki/cmp-184","page_id":"/docs/pr-preview/pr-24/platform/pki/cmp","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/cmp#p10cr--pkcs10-certification-request","content":"Invariantes fijos del protocolo, no configurables: la firma del propio CSR **es** la prueba de posesión y se verifica siempre; no hay POPO CRMF que configurar; la generación de claves en servidor no está disponible (el cliente aporta su clave); y los controles CRMF de registro (`regToken`, `authenticator`) no aplican. La respuesta es un `cp` con `certReqId` `-1`, valor que el `certConf` posterior debe usar (RFC 4210 Errata 8806)."},"879":{"id":"/docs/pr-preview/pr-24/platform/pki/cmp-185","page_id":"/docs/pr-preview/pr-24/platform/pki/cmp","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/cmp#kur--key-update-request","content":"Renovación de un certificado (RFC 9483 §4.1.3), equivalente al `/simplereenroll` de EST. Habilitado por defecto. El mensaje debe ir **protegido por firma con el certificado que se renueva** — invariante del protocolo, no configurable."},"880":{"id":"/docs/pr-preview/pr-24/platform/pki/cmp-186","page_id":"/docs/pr-preview/pr-24/platform/pki/cmp","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/cmp#kur--key-update-request","content":"Campo"},"881":{"id":"/docs/pr-preview/pr-24/platform/pki/cmp-187","page_id":"/docs/pr-preview/pr-24/platform/pki/cmp","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/cmp#kur--key-update-request","content":"Descripción"},"882":{"id":"/docs/pr-preview/pr-24/platform/pki/cmp-188","page_id":"/docs/pr-preview/pr-24/platform/pki/cmp","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/cmp#kur--key-update-request","content":"`enabled`"},"883":{"id":"/docs/pr-preview/pr-24/platform/pki/cmp-189","page_id":"/docs/pr-preview/pr-24/platform/pki/cmp","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/cmp#kur--key-update-request","content":"Habilita la operación."},"884":{"id":"/docs/pr-preview/pr-24/platform/pki/cmp-190","page_id":"/docs/pr-preview/pr-24/platform/pki/cmp","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/cmp#kur--key-update-request","content":"`key_policy`"},"885":{"id":"/docs/pr-preview/pr-24/platform/pki/cmp-191","page_id":"/docs/pr-preview/pr-24/platform/pki/cmp","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/cmp#kur--key-update-request","content":"`require_new_key` (por defecto) exige una clave pública distinta a la del certificado que se renueva (`key update must present a new key`); `permit_reuse` permite renovar sin rotar la clave."},"886":{"id":"/docs/pr-preview/pr-24/platform/pki/cmp-192","page_id":"/docs/pr-preview/pr-24/platform/pki/cmp","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/cmp#kur--key-update-request","content":"`identity_change_policy`"},"887":{"id":"/docs/pr-preview/pr-24/platform/pki/cmp-193","page_id":"/docs/pr-preview/pr-24/platform/pki/cmp","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/cmp#kur--key-update-request","content":"Cuánto puede variar la identidad respecto al certificado vigente: `forbid` (por defecto; subject y SAN deben coincidir), `san_only` (el subject debe coincidir; el SAN puede variar) o `subject_and_san` (cualquier cambio)."},"888":{"id":"/docs/pr-preview/pr-24/platform/pki/cmp-194","page_id":"/docs/pr-preview/pr-24/platform/pki/cmp","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/cmp#kur--key-update-request","content":"`policy_overrides.workflow` / `.confirmation`"},"889":{"id":"/docs/pr-preview/pr-24/platform/pki/cmp-195","page_id":"/docs/pr-preview/pr-24/platform/pki/cmp","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/cmp#kur--key-update-request","content":"Igual que en las demás operaciones de emisión."},"890":{"id":"/docs/pr-preview/pr-24/platform/pki/cmp-196","page_id":"/docs/pr-preview/pr-24/platform/pki/cmp","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/cmp#kur--key-update-request","content":"Invariantes fijos: solo puede haber una actualización de clave abierta por certificado (un segundo `kur` mientras el primero espera `certConf` se rechaza con `badRequest`); la identidad anterior sigue activa hasta la confirmación; y un certificado nuevo nunca confirmado se revoca al expirar la ventana. El control opcional `id-regCtrl-oldCertID`, si se envía, debe referenciar exactamente el certificado que se renueva (`badCertId` en caso contrario). `policy_overrides.issuance_profile_id` está definido en el esquema pero **aún no aplicado** en `kur`."},"891":{"id":"/docs/pr-preview/pr-24/platform/pki/cmp-197","page_id":"/docs/pr-preview/pr-24/platform/pki/cmp","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/cmp#rr--revocation-request","content":"Revocación vía CMP (RFC 9483 §4.2). Habilitado por defecto. El mensaje **siempre debe ir protegido por firma** — invariante del protocolo, independientemente del `auth_mode`: un `rr` sin firma nunca se acepta, ni siquiera en modo `NO_AUTH`."},"892":{"id":"/docs/pr-preview/pr-24/platform/pki/cmp-198","page_id":"/docs/pr-preview/pr-24/platform/pki/cmp","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/cmp#rr--revocation-request","content":"Campo"},"893":{"id":"/docs/pr-preview/pr-24/platform/pki/cmp-199","page_id":"/docs/pr-preview/pr-24/platform/pki/cmp","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/cmp#rr--revocation-request","content":"Descripción"},"894":{"id":"/docs/pr-preview/pr-24/platform/pki/cmp-200","page_id":"/docs/pr-preview/pr-24/platform/pki/cmp","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/cmp#rr--revocation-request","content":"`enabled`"},"895":{"id":"/docs/pr-preview/pr-24/platform/pki/cmp-201","page_id":"/docs/pr-preview/pr-24/platform/pki/cmp","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/cmp#rr--revocation-request","content":"Habilita la operación."},"896":{"id":"/docs/pr-preview/pr-24/platform/pki/cmp-202","page_id":"/docs/pr-preview/pr-24/platform/pki/cmp","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/cmp#rr--revocation-request","content":"`authorization`"},"897":{"id":"/docs/pr-preview/pr-24/platform/pki/cmp-203","page_id":"/docs/pr-preview/pr-24/platform/pki/cmp","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/cmp#rr--revocation-request","content":"`self_only` (por defecto): solo el propio dispositivo puede revocar su certificado — el firmante del mensaje debe ser el certificado revocado. `self_and_trusted_ra`: una entidad de gestión PKI de confianza (EKU `id-kp-cmcRA` validado contra las CAs del DMS) puede además revocar el certificado de otro."},"898":{"id":"/docs/pr-preview/pr-24/platform/pki/cmp-204","page_id":"/docs/pr-preview/pr-24/platform/pki/cmp","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/cmp#rr--revocation-request","content":"`allow_revival`"},"899":{"id":"/docs/pr-preview/pr-24/platform/pki/cmp-205","page_id":"/docs/pr-preview/pr-24/platform/pki/cmp","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/cmp#rr--revocation-request","content":"Por defecto desactivado. Permite reactivar un certificado en estado revocado mediante la razón `removeFromCRL`; la reactivación solo es posible sobre certificados cuya revocación fue una suspensión (`certificateHold`)."},"900":{"id":"/docs/pr-preview/pr-24/platform/pki/cmp-206","page_id":"/docs/pr-preview/pr-24/platform/pki/cmp","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/cmp#rr--revocation-request","content":"`allowed_reasons`"},"901":{"id":"/docs/pr-preview/pr-24/platform/pki/cmp-207","page_id":"/docs/pr-preview/pr-24/platform/pki/cmp","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/cmp#rr--revocation-request","content":"Lista blanca de razones de revocación aceptadas. Por defecto `unspecified`, `key_compromise`, `cessation_of_operation` y `superseded`. Valores admitidos: `unspecified`, `key_compromise`, `ca_compromise`, `affiliation_changed`, `superseded`, `cessation_of_operation`, `privilege_withdrawn`, `aa_compromise`. La razón `certificateHold` no está en la lista ni está sujeta a ella: suspende el certificado y es la única revocación reversible; la reactivación la gobierna `allow_revival`."},"902":{"id":"/docs/pr-preview/pr-24/platform/pki/cmp-208","page_id":"/docs/pr-preview/pr-24/platform/pki/cmp","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/cmp#rr--revocation-request","content":"`trusted_ra.require_cmc_ra_eku`"},"903":{"id":"/docs/pr-preview/pr-24/platform/pki/cmp-209","page_id":"/docs/pr-preview/pr-24/platform/pki/cmp","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/cmp#rr--revocation-request","content":"Por defecto `true`: exige el EKU `id-kp-cmcRA` en el firmante RA."},"904":{"id":"/docs/pr-preview/pr-24/platform/pki/cmp-210","page_id":"/docs/pr-preview/pr-24/platform/pki/cmp","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/cmp#rr--revocation-request","content":"`trusted_ra.validation_ca_ids`"},"905":{"id":"/docs/pr-preview/pr-24/platform/pki/cmp-211","page_id":"/docs/pr-preview/pr-24/platform/pki/cmp","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/cmp#rr--revocation-request","content":"Fija qué CAs deben validar el certificado del RA; una lista explícita sustituye el límite general. Vacío: se aplica el límite de confianza general del DMS (la `EnrollmentCA` más las CAs de validación de autenticación y de re-enrollment)."},"906":{"id":"/docs/pr-preview/pr-24/platform/pki/cmp-212","page_id":"/docs/pr-preview/pr-24/platform/pki/cmp","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/cmp#rr--revocation-request","content":"Notas operativas: la revocación de un certificado ya caducado nunca está permitida (el servicio de CA rechaza transiciones de estado sobre certificados expirados); el certificado objetivo debe pertenecer a un dispositivo gestionado por este DMS — un RA de confianza no puede revocar certificados de otros DMS (`notAuthorized`); mientras un certificado tenga una actualización de clave pendiente de confirmar, su estado no puede cambiar (`badRequest`); y un `rr` no puede repetirse con el mismo `transactionID` (`transactionIdInUse`)."},"907":{"id":"/docs/pr-preview/pr-24/platform/pki/cmp-213","page_id":"/docs/pr-preview/pr-24/platform/pki/cmp","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/cmp#genm--general-message","content":"Canal de descubrimiento (RFC 9483 §4.3): el dispositivo consulta capacidades del DMS y este responde con un `genp`. No emite certificados. Habilitado por defecto."},"908":{"id":"/docs/pr-preview/pr-24/platform/pki/cmp-214","page_id":"/docs/pr-preview/pr-24/platform/pki/cmp","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/cmp#genm--general-message","content":"Campo"},"909":{"id":"/docs/pr-preview/pr-24/platform/pki/cmp-215","page_id":"/docs/pr-preview/pr-24/platform/pki/cmp","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/cmp#genm--general-message","content":"Descripción"},"910":{"id":"/docs/pr-preview/pr-24/platform/pki/cmp-216","page_id":"/docs/pr-preview/pr-24/platform/pki/cmp","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/cmp#genm--general-message","content":"`access_policy`"},"911":{"id":"/docs/pr-preview/pr-24/platform/pki/cmp-217","page_id":"/docs/pr-preview/pr-24/platform/pki/cmp","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/cmp#genm--general-message","content":"`public_discovery` (por defecto) responde sin exigir mensaje protegido; `require_signed` rechaza un `genm` sin firma con `notAuthorized`."},"912":{"id":"/docs/pr-preview/pr-24/platform/pki/cmp-218","page_id":"/docs/pr-preview/pr-24/platform/pki/cmp","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/cmp#genm--general-message","content":"`preferred_symmetric_algorithm`"},"913":{"id":"/docs/pr-preview/pr-24/platform/pki/cmp-219","page_id":"/docs/pr-preview/pr-24/platform/pki/cmp","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/cmp#genm--general-message","content":"Algoritmo simétrico que el DMS anuncia para el cifrado de contenido hacia la CA: `aes128_cbc`, `aes192_cbc`, `aes256_cbc` (por defecto), `aes128_gcm`, `aes192_gcm` o `aes256_gcm`."},"914":{"id":"/docs/pr-preview/pr-24/platform/pki/cmp-220","page_id":"/docs/pr-preview/pr-24/platform/pki/cmp","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/cmp#genm--general-message","content":"`information_types.*`"},"915":{"id":"/docs/pr-preview/pr-24/platform/pki/cmp-221","page_id":"/docs/pr-preview/pr-24/platform/pki/cmp","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/cmp#genm--general-message","content":"Interruptores independientes por tipo de información — ver la tabla siguiente."},"916":{"id":"/docs/pr-preview/pr-24/platform/pki/cmp-222","page_id":"/docs/pr-preview/pr-24/platform/pki/cmp","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/cmp#genm--general-message","content":"Cada interruptor `information_types.*` corresponde a un tipo de información del RFC 9483 §4.3. Los tipos puramente descriptivos (estáticos) están activados por defecto; los que dependen de la configuración concreta del DMS — sus CAs, su perfil de emisión o su cliente VA — quedan desactivados hasta que el operador los habilite:"},"917":{"id":"/docs/pr-preview/pr-24/platform/pki/cmp-223","page_id":"/docs/pr-preview/pr-24/platform/pki/cmp","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/cmp#genm--general-message","content":"Tipo de información"},"918":{"id":"/docs/pr-preview/pr-24/platform/pki/cmp-224","page_id":"/docs/pr-preview/pr-24/platform/pki/cmp","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/cmp#genm--general-message","content":"OID (`id-it-*`)"},"919":{"id":"/docs/pr-preview/pr-24/platform/pki/cmp-225","page_id":"/docs/pr-preview/pr-24/platform/pki/cmp","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/cmp#genm--general-message","content":"Por defecto"},"920":{"id":"/docs/pr-preview/pr-24/platform/pki/cmp-226","page_id":"/docs/pr-preview/pr-24/platform/pki/cmp","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/cmp#genm--general-message","content":"Contenido de la respuesta"},"921":{"id":"/docs/pr-preview/pr-24/platform/pki/cmp-227","page_id":"/docs/pr-preview/pr-24/platform/pki/cmp","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/cmp#genm--general-message","content":"`ca_certificates`"},"922":{"id":"/docs/pr-preview/pr-24/platform/pki/cmp-228","page_id":"/docs/pr-preview/pr-24/platform/pki/cmp","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/cmp#genm--general-message","content":"`caCerts` (17)"},"923":{"id":"/docs/pr-preview/pr-24/platform/pki/cmp-229","page_id":"/docs/pr-preview/pr-24/platform/pki/cmp","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/cmp#genm--general-message","content":"Activado"},"924":{"id":"/docs/pr-preview/pr-24/platfor