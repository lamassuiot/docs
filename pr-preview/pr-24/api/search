,"tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/integrations/aws-iot-core#parámetros-de-configuración","content":"ARN del rol a asumir."},"1831":{"id":"/docs/pr-preview/pr-24/platform/pki/integrations/aws-iot-core-87","page_id":"/docs/pr-preview/pr-24/platform/pki/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/integrations/aws-iot-core#parámetros-de-configuración","content":"`aws_config.endpoint_url`"},"1832":{"id":"/docs/pr-preview/pr-24/platform/pki/integrations/aws-iot-core-88","page_id":"/docs/pr-preview/pr-24/platform/pki/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/integrations/aws-iot-core#parámetros-de-configuración","content":"string"},"1833":{"id":"/docs/pr-preview/pr-24/platform/pki/integrations/aws-iot-core-89","page_id":"/docs/pr-preview/pr-24/platform/pki/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/integrations/aws-iot-core#parámetros-de-configuración","content":"No"},"1834":{"id":"/docs/pr-preview/pr-24/platform/pki/integrations/aws-iot-core-90","page_id":"/docs/pr-preview/pr-24/platform/pki/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/integrations/aws-iot-core#parámetros-de-configuración","content":"URL alternativa para todos los servicios AWS (útil con LocalStack en pruebas)."},"1835":{"id":"/docs/pr-preview/pr-24/platform/pki/integrations/aws-iot-core-91","page_id":"/docs/pr-preview/pr-24/platform/pki/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/integrations/aws-iot-core#parámetros-de-configuración","content":"`subscriber_event_bus`"},"1836":{"id":"/docs/pr-preview/pr-24/platform/pki/integrations/aws-iot-core-92","page_id":"/docs/pr-preview/pr-24/platform/pki/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/integrations/aws-iot-core#parámetros-de-configuración","content":"objeto"},"1837":{"id":"/docs/pr-preview/pr-24/platform/pki/integrations/aws-iot-core-93","page_id":"/docs/pr-preview/pr-24/platform/pki/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/integrations/aws-iot-core#parámetros-de-configuración","content":"Sí"},"1838":{"id":"/docs/pr-preview/pr-24/platform/pki/integrations/aws-iot-core-94","page_id":"/docs/pr-preview/pr-24/platform/pki/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/integrations/aws-iot-core#parámetros-de-configuración","content":"Configuración del bus de eventos al que se suscribe el conector (AMQP o AWS SQS/SNS)."},"1839":{"id":"/docs/pr-preview/pr-24/platform/pki/integrations/aws-iot-core-95","page_id":"/docs/pr-preview/pr-24/platform/pki/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/integrations/aws-iot-core#parámetros-de-configuración","content":"`dms_manager_client`"},"1840":{"id":"/docs/pr-preview/pr-24/platform/pki/integrations/aws-iot-core-96","page_id":"/docs/pr-preview/pr-24/platform/pki/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/integrations/aws-iot-core#parámetros-de-configuración","content":"string"},"1841":{"id":"/docs/pr-preview/pr-24/platform/pki/integrations/aws-iot-core-97","page_id":"/docs/pr-preview/pr-24/platform/pki/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/integrations/aws-iot-core#parámetros-de-configuración","content":"Sí"},"1842":{"id":"/docs/pr-preview/pr-24/platform/pki/integrations/aws-iot-core-98","page_id":"/docs/pr-preview/pr-24/platform/pki/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/integrations/aws-iot-core#parámetros-de-configuración","content":"URL HTTP del servicio DMS Manager de Lamassu."},"1843":{"id":"/docs/pr-preview/pr-24/platform/pki/integrations/aws-iot-core-99","page_id":"/docs/pr-preview/pr-24/platform/pki/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/integrations/aws-iot-core#parámetros-de-configuración","content":"`device_manager_client`"},"1844":{"id":"/docs/pr-preview/pr-24/platform/pki/integrations/aws-iot-core-100","page_id":"/docs/pr-preview/pr-24/platform/pki/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/integrations/aws-iot-core#parámetros-de-configuración","content":"string"},"1845":{"id":"/docs/pr-preview/pr-24/platform/pki/integrations/aws-iot-core-101","page_id":"/docs/pr-preview/pr-24/platform/pki/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/integrations/aws-iot-core#parámetros-de-configuración","content":"Sí"},"1846":{"id":"/docs/pr-preview/pr-24/platform/pki/integrations/aws-iot-core-102","page_id":"/docs/pr-preview/pr-24/platform/pki/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/integrations/aws-iot-core#parámetros-de-configuración","content":"URL HTTP del Device Manager de Lamassu."},"1847":{"id":"/docs/pr-preview/pr-24/platform/pki/integrations/aws-iot-core-103","page_id":"/docs/pr-preview/pr-24/platform/pki/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/integrations/aws-iot-core#parámetros-de-configuración","content":"`ca_client`"},"1848":{"id":"/docs/pr-preview/pr-24/platform/pki/integrations/aws-iot-core-104","page_id":"/docs/pr-preview/pr-24/platform/pki/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/integrations/aws-iot-core#parámetros-de-configuración","content":"string"},"1849":{"id":"/docs/pr-preview/pr-24/platform/pki/integrations/aws-iot-core-105","page_id":"/docs/pr-preview/pr-24/platform/pki/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/integrations/aws-iot-core#parámetros-de-configuración","content":"Sí"},"1850":{"id":"/docs/pr-preview/pr-24/platform/pki/integrations/aws-iot-core-106","page_id":"/docs/pr-preview/pr-24/platform/pki/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/integrations/aws-iot-core#parámetros-de-configuración","content":"URL HTTP del servicio de CA de Lamassu."},"1851":{"id":"/docs/pr-preview/pr-24/platform/pki/integrations/aws-iot-core-107","page_id":"/docs/pr-preview/pr-24/platform/pki/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/integrations/aws-iot-core#registro-de-la-ca-en-aws-iot-core","content":"Para que los dispositivos puedan autenticarse en AWS IoT Core con certificados emitidos por una CA de Lamassu, esa CA debe registrarse previamente en la cuenta AWS. El conector gestiona este registro de forma automática en respuesta a los eventos `EventCreateCAKey`, `EventImportCAKey` y `EventUpdateCAMetadataKey`, pero la operación **solo se dispara cuando el administrador la solicita explícitamente** mediante el campo de metadatos de la CA."},"1852":{"id":"/docs/pr-preview/pr-24/platform/pki/integrations/aws-iot-core-108","page_id":"/docs/pr-preview/pr-24/platform/pki/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/integrations/aws-iot-core#cómo-solicitar-el-registro","content":"El registro se desencadena estableciendo el valor `registration.status = \"REQUESTED\"` en la clave `lamassu.io/iot/{connector_id}` de los metadatos de la CA. Esto puede hacerse desde la consola de Lamassu en la sección de gestión de la CA o mediante la API."},"1853":{"id":"/docs/pr-preview/pr-24/platform/pki/integrations/aws-iot-core-109","page_id":"/docs/pr-preview/pr-24/platform/pki/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/integrations/aws-iot-core#cómo-solicitar-el-registro","content":"Una vez recibido el evento, el conector intenta registrar la CA en AWS y actualiza el campo `registration.status` en los metadatos de la CA con el resultado: `\"SUCCEEDED\"` si el registro fue correcto, o `\"FAILED\"` acompañado de un mensaje de error en caso contrario. El proceso es asíncrono, por lo que es necesario consultar periódicamente el estado de los metadatos hasta que la operación concluya."},"1854":{"id":"/docs/pr-preview/pr-24/platform/pki/integrations/aws-iot-core-110","page_id":"/docs/pr-preview/pr-24/platform/pki/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/integrations/aws-iot-core#primary-account","content":"Cuando el parámetro `primary_account` es `true`, el conector ejecuta el flujo completo de registro con verificación de posesión de clave privada:"},"1855":{"id":"/docs/pr-preview/pr-24/platform/pki/integrations/aws-iot-core-111","page_id":"/docs/pr-preview/pr-24/platform/pki/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/integrations/aws-iot-core#primary-account","content":"Llama a `iot:GetRegistrationCode` para obtener el código de verificación de AWS."},"1856":{"id":"/docs/pr-preview/pr-24/platform/pki/integrations/aws-iot-core-112","page_id":"/docs/pr-preview/pr-24/platform/pki/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/integrations/aws-iot-core#primary-account","content":"El conector genera internamente un par de claves RSA-2048 efímero y construye un CSR cuyo Common Name es exactamente ese código de registro. A continuación llama al servicio de firma de Lamassu para que la CA registrada emita un certificado de verificación X.509 real firmando ese CSR. La clave privada efímera se usa únicamente para este propósito y no se almacena ni se envía a AWS."},"1857":{"id":"/docs/pr-preview/pr-24/platform/pki/integrations/aws-iot-core-113","page_id":"/docs/pr-preview/pr-24/platform/pki/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/integrations/aws-iot-core#primary-account","content":"Envía a AWS la CA (en PEM) y el certificado de verificación mediante `iot:RegisterCACertificate`, activando el registro con `AllowAutoRegistration: true`."},"1858":{"id":"/docs/pr-preview/pr-24/platform/pki/integrations/aws-iot-core-114","page_id":"/docs/pr-preview/pr-24/platform/pki/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/integrations/aws-iot-core#primary-account","content":"Solo una cuenta puede ser propietaria de una CA en una región AWS dada. Si la CA ya está registrada con el mismo número de serie, el conector omite el paso silenciosamente."},"1859":{"id":"/docs/pr-preview/pr-24/platform/pki/integrations/aws-iot-core-115","page_id":"/docs/pr-preview/pr-24/platform/pki/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/integrations/aws-iot-core#primary-account","content":"Los tags que AWS IoT Core aplica al certificado de CA registrado son `LMS.CA.ID`, `LMS.CA.SN` y `LMS.CA.CN`."},"1860":{"id":"/docs/pr-preview/pr-24/platform/pki/integrations/aws-iot-core-116","page_id":"/docs/pr-preview/pr-24/platform/pki/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/integrations/aws-iot-core#secondary-account-sni-only","content":"Cuando `primary_account` es `false`, el conector registra la CA usando el modo `CertificateMode: SNI_ONLY`. Este modo no requiere código de verificación ni acceso a la clave privada de la CA, por lo que es la opción adecuada cuando la CA se gestiona desde otra cuenta de AWS o cuando el administrador no dispone de la clave privada. Es el método habitual para registrar la misma CA en varias cuentas de AWS simultáneamente."},"1861":{"id":"/docs/pr-preview/pr-24/platform/pki/integrations/aws-iot-core-117","page_id":"/docs/pr-preview/pr-24/platform/pki/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/integrations/aws-iot-core#configuración-del-dms","content":"Cada DMS que participe en la integración con AWS IoT Core debe tener configurada la clave de metadatos `lamassu.io/iot/{connector_id}`. El campo más importante de esa configuración es `registration_mode`, que determina cómo se aprovisionan los dispositivos en AWS."},"1862":{"id":"/docs/pr-preview/pr-24/platform/pki/integrations/aws-iot-core-118","page_id":"/docs/pr-preview/pr-24/platform/pki/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/integrations/aws-iot-core#configuración-del-dms","content":"Existen tres modos de registro, y la elección entre ellos depende de la estrategia de aprovisionamiento de la flota."},"1863":{"id":"/docs/pr-preview/pr-24/platform/pki/integrations/aws-iot-core-119","page_id":"/docs/pr-preview/pr-24/platform/pki/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/integrations/aws-iot-core#modo-none","content":"En este modo el conector **no crea Things, grupos ni políticas** en AWS IoT Core. Se limita a sincronizar el estado de los certificados (activo, revocado, suspendido) a medida que cambian en Lamassu. Es el modo adecuado cuando el aprovisionamiento de Things en AWS se gestiona por un sistema externo y solo se necesita que Lamassu mantenga el estado de los certificados actualizado."},"1864":{"id":"/docs/pr-preview/pr-24/platform/pki/integrations/aws-iot-core-120","page_id":"/docs/pr-preview/pr-24/platform/pki/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/integrations/aws-iot-core#modo-auto","content":"El modo `auto` delega en Lamassu el aprovisionamiento completo del dispositivo en AWS en el momento del enrolamiento. Cuando el dispositivo completa con éxito su enrolamiento EST y Lamassu emite el evento `EventBindDeviceIdentityKey`, el conector ejecuta automáticamente la siguiente secuencia:"},"1865":{"id":"/docs/pr-preview/pr-24/platform/pki/integrations/aws-iot-core-121","page_id":"/docs/pr-preview/pr-24/platform/pki/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/integrations/aws-iot-core#modo-auto","content":"Crea o actualiza las políticas IoT configuradas en el DMS."},"1866":{"id":"/docs/pr-preview/pr-24/platform/pki/integrations/aws-iot-core-122","page_id":"/docs/pr-preview/pr-24/platform/pki/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/integrations/aws-iot-core#modo-auto","content":"Crea el grupo raíz `LAMASSU` en la cuenta AWS (si no existe) y los grupos hijos configurados en el DMS como subgrupos de `LAMASSU`. Si los grupos ya existen, el error `ResourceAlreadyExistsException` se ignora, por lo que la operación es idempotente."},"1867":{"id":"/docs/pr-preview/pr-24/platform/pki/integrations/aws-iot-core-123","page_id":"/docs/pr-preview/pr-24/platform/pki/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/integrations/aws-iot-core#modo-auto","content":"Si el Thing ya existía en AWS IoT Core, el conector itera todos los certificados (principals) actualmente adjuntos a ese Thing y los marca como `REVOKED` en AWS, para garantizar que los certificados anteriores no puedan seguir siendo usados para autenticarse."},"1868":{"id":"/docs/pr-preview/pr-24/platform/pki/integrations/aws-iot-core-124","page_id":"/docs/pr-preview/pr-24/platform/pki/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/integrations/aws-iot-core#modo-auto","content":"Llama a `iot:RegisterThing` con una plantilla de aprovisionamiento de estilo CloudFormation que crea el Thing, registra el certificado del dispositivo (PEM del certificado del dispositivo y del certificado de la CA emisora) y adjunta las políticas configuradas.\nUna vez completado el aprovisionamiento, el conector almacena el ARN del certificado resultante en los metadatos del certificado de Lamassu bajo la clave `lamassu.io/iot/{connector_id}` y marca el dispositivo como `Registered: true` en Device Manager."},"1869":{"id":"/docs/pr-preview/pr-24/platform/pki/integrations/aws-iot-core-125","page_id":"/docs/pr-preview/pr-24/platform/pki/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/integrations/aws-iot-core#modo-auto","content":"**El nombre del Thing en AWS es el Common Name (CN) del certificado del dispositivo.** Esta convención es fundamental para el desarrollador de firmware: el valor `/CN=` que el dispositivo incluye en su CSR al enrolarse se convierte en el ThingName con el que deberá identificarse en todas las operaciones MQTT contra AWS IoT Core."},"1870":{"id":"/docs/pr-preview/pr-24/platform/pki/integrations/aws-iot-core-126","page_id":"/docs/pr-preview/pr-24/platform/pki/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/integrations/aws-iot-core#modo-jitp","content":"El modo Just-In-Time Provisioning (JITP) delega el aprovisionamiento en AWS en lugar de hacerlo el conector directamente. Cuando el conector detecta que el DMS está en modo `jitp`, crea una plantilla de aprovisionamiento JITP en AWS IoT Core y la adjunta al certificado de CA registrado. Esta plantilla se crea o actualiza en el momento en que el DMS se crea o actualiza en Lamassu - no en el momento del enrolamiento del dispositivo. A partir de ese momento, cuando un dispositivo con un certificado emitido por esa CA se conecta por primera vez a AWS IoT Core, AWS ejecuta la plantilla automáticamente: crea el Thing, registra el certificado y lo activa."},"1871":{"id":"/docs/pr-preview/pr-24/platform/pki/integrations/aws-iot-core-127","page_id":"/docs/pr-preview/pr-24/platform/pki/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/integrations/aws-iot-core#modo-jitp","content":"El nombre del Thing en la plantilla JITP se deriva de `AWS::IoT::Certificate::CommonName`, que corresponde al CN del certificado del dispositivo - la misma convención que el modo `auto`."},"1872":{"id":"/docs/pr-preview/pr-24/platform/pki/integrations/aws-iot-core-128","page_id":"/docs/pr-preview/pr-24/platform/pki/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/integrations/aws-iot-core#modo-jitp","content":"Este modo requiere que se configure el campo `jitp_config.provisioning_role_arn` con el ARN de un rol IAM que AWS IoT Core pueda asumir para ejecutar la plantilla. Si no se configura, el conector utiliza el valor por defecto `arn:aws:iam::{account}:role/JITPRole` y registra un aviso en el log. El administrador debe asegurarse de que ese rol existe en la cuenta y tiene los permisos necesarios antes de activar el modo JITP."},"1873":{"id":"/docs/pr-preview/pr-24/platform/pki/integrations/aws-iot-core-129","page_id":"/docs/pr-preview/pr-24/platform/pki/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/integrations/aws-iot-core#aprovisionamiento-de-dispositivos-modo-automático","content":"Para el desarrollador de firmware, el modo `auto` es transparente: el dispositivo realiza su enrolamiento EST de la forma habitual y, como efecto secundario, queda aprovisionado en AWS IoT Core sin ningún paso adicional."},"1874":{"id":"/docs/pr-preview/pr-24/platform/pki/integrations/aws-iot-core-130","page_id":"/docs/pr-preview/pr-24/platform/pki/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/integrations/aws-iot-core#aprovisionamiento-de-dispositivos-modo-automático","content":"El flujo completo desde el punto de vista del dispositivo es el siguiente:"},"1875":{"id":"/docs/pr-preview/pr-24/platform/pki/integrations/aws-iot-core-131","page_id":"/docs/pr-preview/pr-24/platform/pki/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/integrations/aws-iot-core#aprovisionamiento-de-dispositivos-modo-automático","content":"Una vez que el conector completa el aprovisionamiento, el dispositivo puede conectarse al endpoint AWS IoT Core de MQTT usando su clave privada y el certificado emitido por Lamassu. El ThingName con el que debe identificarse en AWS es exactamente el CN del certificado."},"1876":{"id":"/docs/pr-preview/pr-24/platform/pki/integrations/aws-iot-core-132","page_id":"/docs/pr-preview/pr-24/platform/pki/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/integrations/aws-iot-core#aprovisionamiento-de-dispositivos-modo-jitp","content":"En el modo JITP el dispositivo también realiza su enrolamiento EST de forma convencional y obtiene su certificado de Lamassu. La diferencia es que AWS IoT Core no conoce al dispositivo hasta que este intenta conectarse por primera vez."},"1877":{"id":"/docs/pr-preview/pr-24/platform/pki/integrations/aws-iot-core-133","page_id":"/docs/pr-preview/pr-24/platform/pki/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/integrations/aws-iot-core#aprovisionamiento-de-dispositivos-modo-jitp","content":"Cuando el dispositivo establece su primera conexión MQTT a AWS IoT Core presentando el certificado emitido por Lamassu, AWS detecta que el certificado pertenece a una CA registrada con una plantilla JITP, ejecuta esa plantilla y crea el Thing automáticamente. La conexión inicial puede fallar o demorarse mientras se ejecuta la plantilla; el firmware debe estar preparado para reintentar la conexión."},"1878":{"id":"/docs/pr-preview/pr-24/platform/pki/integrations/aws-iot-core-134","page_id":"/docs/pr-preview/pr-24/platform/pki/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/integrations/aws-iot-core#aprovisionamiento-de-dispositivos-modo-jitp","content":"Para que el flujo JITP funcione correctamente:"},"1879":{"id":"/docs/pr-preview/pr-24/platform/pki/integrations/aws-iot-core-135","page_id":"/docs/pr-preview/pr-24/platform/pki/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/integrations/aws-iot-core#aprovisionamiento-de-dispositivos-modo-jitp","content":"La CA debe estar registrada en AWS en modo Primary Account (el modo SNI-only no admite JITP)."},"1880":{"id":"/docs/pr-preview/pr-24/platform/pki/integrations/aws-iot-core-136","page_id":"/docs/pr-preview/pr-24/platform/pki/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/integrations/aws-iot-core#aprovisionamiento-de-dispositivos-modo-jitp","content":"El rol IAM configurado en `jitp_config.provisioning_role_arn` debe existir y tener permisos para crear Things, registrar certificados y adjuntar políticas en la cuenta AWS."},"1881":{"id":"/docs/pr-preview/pr-24/platform/pki/integrations/aws-iot-core-137","page_id":"/docs/pr-preview/pr-24/platform/pki/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/integrations/aws-iot-core#aprovisionamiento-de-dispositivos-modo-jitp","content":"El dispositivo debe presentar tanto su certificado como el certificado de la CA emisora en el handshake TLS con AWS IoT Core."},"1882":{"id":"/docs/pr-preview/pr-24/platform/pki/integrations/aws-iot-core-138","page_id":"/docs/pr-preview/pr-24/platform/pki/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/integrations/aws-iot-core#aprovisionamiento-de-dispositivos-modo-jitp","content":"Los certificados aprovisionados mediante JITP **no tienen asociada la clave de metadatos del conector** (`lamassu.io/iot/{connector_id}`) en Lamassu. Como consecuencia, los cambios de estado de esos certificados en Lamassu no se sincronizan automáticamente con AWS a través del mecanismo de sincronización de estado descrito en la siguiente sección."},"1883":{"id":"/docs/pr-preview/pr-24/platform/pki/integrations/aws-iot-core-139","page_id":"/docs/pr-preview/pr-24/platform/pki/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/integrations/aws-iot-core#sincronización-del-estado-del-certificado","content":"El conector escucha el evento `EventUpdateCertificateStatusKey` y, cuando un certificado que tiene la clave de metadatos del conector cambia de estado en Lamassu, replica ese cambio en AWS IoT Core. La tabla siguiente muestra la correspondencia de estados:"},"1884":{"id":"/docs/pr-preview/pr-24/platform/pki/integrations/aws-iot-core-140","page_id":"/docs/pr-preview/pr-24/platform/pki/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/integrations/aws-iot-core#sincronización-del-estado-del-certificado","content":"Estado en Lamassu"},"1885":{"id":"/docs/pr-preview/pr-24/platform/pki/integrations/aws-iot-core-141","page_id":"/docs/pr-preview/pr-24/platform/pki/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/integrations/aws-iot-core#sincronización-del-estado-del-certificado","content":"Razón de revocación"},"1886":{"id":"/docs/pr-preview/pr-24/platform/pki/integrations/aws-iot-core-142","page_id":"/docs/pr-preview/pr-24/platform/pki/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/integrations/aws-iot-core#sincronización-del-estado-del-certificado","content":"Estado en AWS IoT Core"},"1887":{"id":"/docs/pr-preview/pr-24/platform/pki/integrations/aws-iot-core-143","page_id":"/docs/pr-preview/pr-24/platform/pki/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/integrations/aws-iot-core#sincronización-del-estado-del-certificado","content":"`Active`"},"1888":{"id":"/docs/pr-preview/pr-24/platform/pki/integrations/aws-iot-core-144","page_id":"/docs/pr-preview/pr-24/platform/pki/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/integrations/aws-iot-core#sincronización-del-estado-del-certificado","content":"Ninguna"},"1889":{"id":"/docs/pr-preview/pr-24/platform/pki/integrations/aws-iot-core-145","page_id":"/docs/pr-preview/pr-24/platform/pki/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/integrations/aws-iot-core#sincronización-del-estado-del-certificado","content":"`ACTIVE`"},"1890":{"id":"/docs/pr-preview/pr-24/platform/pki/integrations/aws-iot-core-146","page_id":"/docs/pr-preview/pr-24/platform/pki/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/integrations/aws-iot-core#sincronización-del-estado-del-certificado","content":"`Revoked`"},"1891":{"id":"/docs/pr-preview/pr-24/platform/pki/integrations/aws-iot-core-147","page_id":"/docs/pr-preview/pr-24/platform/pki/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/integrations/aws-iot-core#sincronización-del-estado-del-certificado","content":"`certificateHold`"},"1892":{"id":"/docs/pr-preview/pr-24/platform/pki/integrations/aws-iot-core-148","page_id":"/docs/pr-preview/pr-24/platform/pki/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/integrations/aws-iot-core#sincronización-del-estado-del-certificado","content":"`INACTIVE`"},"1893":{"id":"/docs/pr-preview/pr-24/platform/pki/integrations/aws-iot-core-149","page_id":"/docs/pr-preview/pr-24/platform/pki/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/integrations/aws-iot-core#sincronización-del-estado-del-certificado","content":"`Revoked`"},"1894":{"id":"/docs/pr-preview/pr-24/platform/pki/integrations/aws-iot-core-150","page_id":"/docs/pr-preview/pr-24/platform/pki/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/integrations/aws-iot-core#sincronización-del-estado-del-certificado","content":"Cualquier otra razón"},"1895":{"id":"/docs/pr-preview/pr-24/platform/pki/integrations/aws-iot-core-151","page_id":"/docs/pr-preview/pr-24/platform/pki/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/integrations/aws-iot-core#sincronización-del-estado-del-certificado","content":"`REVOKED`"},"1896":{"id":"/docs/pr-preview/pr-24/platform/pki/integrations/aws-iot-core-152","page_id":"/docs/pr-preview/pr-24/platform/pki/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/integrations/aws-iot-core#sincronización-del-estado-del-certificado","content":"Solo los estados `Active` y `Revoked` producen una llamada a `iot:UpdateCertificate`. Los demás estados del ciclo de vida de Lamassu (`RenewalWindow`, `AboutToExpire`, `Expired`) no se sincronizan con AWS IoT Core; el estado del certificado en AWS permanece sin cambios hasta que el estado en Lamassu sea `Active` o `Revoked`."},"1897":{"id":"/docs/pr-preview/pr-24/platform/pki/integrations/aws-iot-core-153","page_id":"/docs/pr-preview/pr-24/platform/pki/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/integrations/aws-iot-core#desconexión-forzada-al-revocar","content":"Cuando el conector marca un certificado como `REVOKED` o `INACTIVE` en AWS, ejecuta adicionalmente una desconexión forzada del dispositivo. Para ello abre una conexión MQTT sobre WebSocket (con autenticación SigV4 con las credenciales del conector) al endpoint de datos de AWS IoT Core, usando el CN del certificado como identificador de cliente MQTT, y la cierra inmediatamente. Esto termina cualquier sesión MQTT activa que el dispositivo pueda tener en ese momento."},"1898":{"id":"/docs/pr-preview/pr-24/platform/pki/integrations/aws-iot-core-154","page_id":"/docs/pr-preview/pr-24/platform/pki/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/integrations/aws-iot-core#desconexión-forzada-al-revocar","content":"Esta desconexión forzada se produce en el momento en que Lamassu registra el cambio de estado. Si el dispositivo vuelve a intentar conectarse tras la desconexión, AWS IoT Core rechazará la conexión porque el certificado ya figura como `REVOKED` o `INACTIVE`."},"1899":{"id":"/docs/pr-preview/pr-24/platform/pki/integrations/aws-iot-core-155","page_id":"/docs/pr-preview/pr-24/platform/pki/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/integrations/aws-iot-core#desconexión-forzada-al-revocar","content":"Los certificados aprovisionados en modo JITP no disponen de esta sincronización automática, ya que no tienen la clave de metadatos del conector."},"1900":{"id":"/docs/pr-preview/pr-24/platform/pki/integrations/aws-iot-core-156","page_id":"/docs/pr-preview/pr-24/platform/pki/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/integrations/aws-iot-core#device-shadow-y-automatización","content":"El conector puede escribir en el Device Shadow de AWS IoT Core para enviar señales de acción al firmware del dispositivo. Esta funcionalidad se activa por DMS mediante `shadow_config.enable: true`."},"1901":{"id":"/docs/pr-preview/pr-24/platform/pki/integrations/aws-iot-core-157","page_id":"/docs/pr-preview/pr-24/platform/pki/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/integrations/aws-iot-core#device-shadow-y-automatización","content":"Si `shadow_config.shadow_name` contiene un valor, el conector usa un Named Shadow con ese nombre; en caso contrario, usa el Classic Shadow (shadow predeterminado del Thing)."},"1902":{"id":"/docs/pr-preview/pr-24/platform/pki/integrations/aws-iot-core-158","page_id":"/docs/pr-preview/pr-24/platform/pki/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/integrations/aws-iot-core#qué-escribe-el-conector-en-el-shadow","content":"El conector escribe en el campo `desired.identity_actions` del documento shadow. Cada entrada contiene un timestamp Unix en milisegundos. El firmware del dispositivo debe leer este campo y actuar en consecuencia."},"1903":{"id":"/docs/pr-preview/pr-24/platform/pki/integrations/aws-iot-core-159","page_id":"/docs/pr-preview/pr-24/platform/pki/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/integrations/aws-iot-core#qué-escribe-el-conector-en-el-shadow","content":"Existen dos tipos de acciones:"},"1904":{"id":"/docs/pr-preview/pr-24/platform/pki/integrations/aws-iot-core-160","page_id":"/docs/pr-preview/pr-24/platform/pki/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/integrations/aws-iot-core#qué-escribe-el-conector-en-el-shadow","content":"**`UPDATE_CERTIFICATE`**: se escribe cuando la ventana de renovación preventiva de un certificado se activa - es decir, cuando el campo `triggered` de la delta de renovación preventiva pasa de `false` a `true`. Esta acción indica al dispositivo que debe iniciar el proceso de re-enrolamiento para renovar su certificado antes de que expire."},"1905":{"id":"/docs/pr-preview/pr-24/platform/pki/integrations/aws-iot-core-161","page_id":"/docs/pr-preview/pr-24/platform/pki/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/integrations/aws-iot-core#qué-escribe-el-conector-en-el-shadow","content":"**`UPDATE_TRUST_ANCHOR_LIST`**: se escribe en todos los dispositivos de un DMS cuando la lista `ManagedCAs` del DMS cambia. Esta acción indica al dispositivo que debe actualizar su almacén de CAs de confianza."},"1906":{"id":"/docs/pr-preview/pr-24/platform/pki/integrations/aws-iot-core-162","page_id":"/docs/pr-preview/pr-24/platform/pki/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/integrations/aws-iot-core#qué-escribe-el-conector-en-el-shadow","content":"El proceso de escritura en el shadow consiste en leer el shadow actual (`iotdata:GetThingShadow`), combinar las nuevas acciones con las existentes y escribir el resultado (`iotdata:UpdateThingShadow`). Si el shadow no existe, el conector lo crea. Tras una escritura correcta, la lista de acciones pendientes en los metadatos del dispositivo en Lamassu se limpia."},"1907":{"id":"/docs/pr-preview/pr-24/platform/pki/integrations/aws-iot-core-163","page_id":"/docs/pr-preview/pr-24/platform/pki/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/integrations/aws-iot-core#políticas-de-aws-iot","content":"El conector crea y adjunta las políticas que se configuran en el DMS. Una política típica para un dispositivo que usa MQTT y Device Shadow tiene la siguiente estructura:"},"1908":{"id":"/docs/pr-preview/pr-24/platform/pki/integrations/aws-iot-core-164","page_id":"/docs/pr-preview/pr-24/platform/pki/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/integrations/aws-iot-core#políticas-de-aws-iot","content":"En la política anterior, los marcadores `<AWS_REGION>` y `<AWS_ACCOUNT_ID>` deben reemplazarse por la región AWS y el identificador de cuenta de doce dígitos de la cuenta destino antes de aplicar la política. La variable `${iot:Connection.Thing.ThingName}` limita automáticamente cada permiso al Thing al que el dispositivo está conectado, siguiendo el principio de mínimo privilegio. La variable `${ShadowName}` en los ARN de shadow es un marcador que debe reemplazarse con el valor de `shadow_config.shadow_name` configurado en el DMS; si se usa el Classic Shadow, se puede simplificar eliminando el segmento `name/${ShadowName}/`. Las políticas de AWS IoT no admiten expresiones regulares con alternancia; la notación `[name/${ShadowName}/]*` representa la opcionalidad del segmento dentro de las restricciones de la sintaxis de ARN."},"1909":{"id":"/docs/pr-preview/pr-24/platform/pki/integrations/aws-iot-core-165","page_id":"/docs/pr-preview/pr-24/platform/pki/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/integrations/aws-iot-core#políticas-de-aws-iot","content":"El primer statement permite que el dispositivo se conecte usando su ThingName como identificador MQTT. El segundo autoriza la publicación en el topic MQTT genérico del Thing y en los topics del shadow, necesario para que el dispositivo pueda actualizar el estado reportado. Los dos últimos statements otorgan permisos de suscripción y recepción sobre los mismos topics, lo que permite al dispositivo recibir actualizaciones del shadow (por ejemplo, las acciones `UPDATE_CERTIFICATE` y `UPDATE_TRUST_ANCHOR_LIST` escritas por el conector)."},"1910":{"id":"/docs/pr-preview/pr-24/platform/pki/integrations/aws-iot-core-166","page_id":"/docs/pr-preview/pr-24/platform/pki/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/integrations/aws-iot-core#solución-de-problemas","content":"**Síntoma:** El registro de la CA permanece indefinidamente en estado `REQUESTED`."},"1911":{"id":"/docs/pr-preview/pr-24/platform/pki/integrations/aws-iot-core-167","page_id":"/docs/pr-preview/pr-24/platform/pki/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/integrations/aws-iot-core#solución-de-problemas","content":"**Causa:** El conector no está en ejecución o no está suscrito al bus de eventos. También puede indicar credenciales IAM incorrectas, permisos insuficientes o que la clave de metadatos se escribió con un `connector_id` incorrecto."},"1912":{"id":"/docs/pr-preview/pr-24/platform/pki/integrations/aws-iot-core-168","page_id":"/docs/pr-preview/pr-24/platform/pki/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/integrations/aws-iot-core#solución-de-problemas","content":"**Resolución:** Verificar que el proceso del conector está activo y que los logs no muestran errores de comunicación con AWS. Comprobar que el campo de metadatos se escribió bajo la clave exacta `lamassu.io/iot/{connector_id}`. Si el error persiste, el conector actualizará el estado a `FAILED` con un mensaje descriptivo en los metadatos de la CA."},"1913":{"id":"/docs/pr-preview/pr-24/platform/pki/integrations/aws-iot-core-169","page_id":"/docs/pr-preview/pr-24/platform/pki/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/integrations/aws-iot-core#solución-de-problemas","content":"**Síntoma:** El estado de un certificado no se sincroniza con AWS tras una revocación."},"1914":{"id":"/docs/pr-preview/pr-24/platform/pki/integrations/aws-iot-core-170","page_id":"/docs/pr-preview/pr-24/platform/pki/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/integrations/aws-iot-core#solución-de-problemas","content":"**Causa:** Lo más habitual es que el certificado fue aprovisionado en modo JITP. Los certificados JITP no tienen la clave de metadatos del conector y quedan fuera del mecanismo de sincronización de estado. Si el DMS está en modo `auto`, puede indicar que el aprovisionamiento inicial no completó correctamente y el ARN de AWS no se almacenó en los metadatos del certificado."},"1915":{"id":"/docs/pr-preview/pr-24/platform/pki/integrations/aws-iot-core-171","page_id":"/docs/pr-preview/pr-24/platform/pki/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/integrations/aws-iot-core#solución-de-problemas","content":"**Resolución:** Para certificados JITP, migrar el DMS a modo `auto` y re-aprovisionar los dispositivos afectados. Para certificados en modo `auto`, verificar que el certificado tiene el ARN de AWS almacenado en sus metadatos; si no lo tiene, repetir el aprovisionamiento."},"1916":{"id":"/docs/pr-preview/pr-24/platform/pki/integrations/aws-iot-core-172","page_id":"/docs/pr-preview/pr-24/platform/pki/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/integrations/aws-iot-core#solución-de-problemas","content":"**Síntoma:** La desconexión forzada no termina la sesión MQTT del dispositivo tras la revocación."},"1917":{"id":"/docs/pr-preview/pr-24/platform/pki/integrations/aws-iot-core-173","page_id":"/docs/pr-preview/pr-24/platform/pki/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/integrations/aws-iot-core#solución-de-problemas","content":"**Causa:** El dispositivo usa un client ID MQTT diferente al CN del certificado. La desconexión forzada abre una conexión usando el CN como client ID; si el firmware usa otro identificador, la desconexión no afecta a esa sesión."},"1918":{"id":"/docs/pr-preview/pr-24/platform/pki/integrations/aws-iot-core-174","page_id":"/docs/pr-preview/pr-24/platform/pki/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/integrations/aws-iot-core#solución-de-problemas","content":"**Resolución:** Asegurarse de que el firmware usa exactamente el CN del certificado como identificador de cliente MQTT. Ese CN coincide con el ThingName en AWS IoT Core."},"1919":{"id":"/docs/pr-preview/pr-24/platform/pki/integrations/aws-iot-core-175","page_id":"/docs/pr-preview/pr-24/platform/pki/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/integrations/aws-iot-core#solución-de-problemas","content":"**Síntoma:** El dispositivo recibe `CLIENT_ID_REJECTED` al conectarse a AWS IoT Core."},"1920":{"id":"/docs/pr-preview/pr-24/platform/pki/integrations/aws-iot-core-176","page_id":"/docs/pr-preview/pr-24/platform/pki/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/integrations/aws-iot-core#solución-de-problemas","content":"**Causa:** El client ID MQTT no coincide con el ThingName, que es siempre el CN del certificado emitido por Lamassu."},"1921":{"id":"/docs/pr-preview/pr-24/platform/pki/integrations/aws-iot-core-177","page_id":"/docs/pr-preview/pr-24/platform/pki/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/integrations/aws-iot-core#solución-de-problemas","content":"**Resolución:** Verificar que el firmware usa exactamente el valor del campo CN incluido en el CSR de enrolamiento como identificador de cliente MQTT."},"1922":{"id":"/docs/pr-preview/pr-24/platform/pki/integrations/aws-iot-core-178","page_id":"/docs/pr-preview/pr-24/platform/pki/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/integrations/aws-iot-core#solución-de-problemas","content":"**Síntoma:** La primera conexión MQTT del dispositivo en modo JITP falla o excede el tiempo de espera."},"1923":{"id":"/docs/pr-preview/pr-24/platform/pki/integrations/aws-iot-core-179","page_id":"/docs/pr-preview/pr-24/platform/pki/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/integrations/aws-iot-core#solución-de-problemas","content":"**Causa:** Es el comportamiento esperado mientras AWS ejecuta la plantilla JITP en la primera conexión del dispositivo."},"1924":{"id":"/docs/pr-preview/pr-24/platform/pki/integrations/aws-iot-core-180","page_id":"/docs/pr-preview/pr-24/platform/pki/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/integrations/aws-iot-core#solución-de-problemas","content":"**Resolución:** El firmware debe implementar reintentos con backoff exponencial para la primera conexión. Si el fallo persiste más allá de unos minutos, verificar que el rol IAM configurado en `jitp_config.provisioning_role_arn` existe en la cuenta y tiene permisos para crear Things, registrar certificados y adjuntar políticas."},"1925":{"id":"/docs/pr-preview/pr-24/platform/pki/integrations/aws-iot-core-181","page_id":"/docs/pr-preview/pr-24/platform/pki/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/integrations/aws-iot-core#solución-de-problemas","content":"**Síntoma:** El Device Shadow no se actualiza cuando debería."},"1926":{"id":"/docs/pr-preview/pr-24/platform/pki/integrations/aws-iot-core-182","page_id":"/docs/pr-preview/pr-24/platform/pki/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/integrations/aws-iot-core#solución-de-problemas","content":"**Causa:** La función de shadow está desactivada en la configuración del DMS, las credenciales del conector carecen de permisos sobre la API de datos de IoT, o el firmware lee un shadow diferente al configurado."},"1927":{"id":"/docs/pr-preview/pr-24/platform/pki/integrations/aws-iot-core-183","page_id":"/docs/pr-preview/pr-24/platform/pki/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/integrations/aws-iot-core#solución-de-problemas","content":"**Resolución:** Comprobar que `shadow_config.enable` está a `true` en los metadatos del conector para el DMS correspondiente. Si se usa Named Shadow, verificar que `shadow_config.shadow_name` contiene el nombre correcto y que el firmware lee ese Named Shadow y no el Classic Shadow. Confirmar que las credenciales del conector tienen permisos `iotdata:GetThingShadow` y `iotdata:UpdateThingShadow`."},"1928":{"id":"/docs/pr-preview/pr-24/platform/pki/integrations/aws-iot-core-184","page_id":"/docs/pr-preview/pr-24/platform/pki/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/integrations/aws-iot-core#solución-de-problemas","content":"<Card title=\"Configurar un DMS\" href=\"/docs/platform/pki/device-enrollment\" />"},"1929":{"id":"/docs/pr-preview/pr-24/platform/pki/integrations/aws-iot-core-185","page_id":"/docs/pr-preview/pr-24/platform/pki/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/integrations/aws-iot-core#solución-de-problemas","content":"<Card title=\"Enrolamiento de dispositivos (EST)\" href=\"/docs/platform/pki/est-enrollment\" />"},"1930":{"id":"/docs/pr-preview/pr-24/platform/pki/integrations/aws-iot-core-186","page_id":"/docs/pr-preview/pr-24/platform/pki/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/integrations/aws-iot-core#solución-de-problemas","content":"<Card title=\"Gestión de certificados\" href=\"/docs/platform/pki/certificates\" />"},"1931":{"id":"/docs/pr-preview/pr-24/platform/pki/key-management","page_id":"/docs/pr-preview/pr-24/platform/pki/key-management","type":"page","content":"Claves y motores criptográficos","breadcrumbs":["Docs","Plataforma","Operar Lamassu"],"tags":[],"url":"/docs/pr-preview/pr-24/platform/pki/key-management"},"1932":{"id":"/docs/pr-preview/pr-24/platform/pki/key-management-0","page_id":"/docs/pr-preview/pr-24/platform/pki/key-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/key-management","content":"Genera, importa y opera claves sin acoplar la PKI a un proveedor concreto."},"1933":{"id":"/docs/pr-preview/pr-24/platform/pki/key-management-1","page_id":"/docs/pr-preview/pr-24/platform/pki/key-management","type":"heading","tags":[],"url":"/docs/pr-preview/pr-24/platform/pki/key-management#gestión-de-claves-criptográficas","content":"Gestión de claves criptográficas"},"1934":{"id":"/docs/pr-preview/pr-24/platform/pki/key-management-2","page_id":"/docs/pr-preview/pr-24/platform/pki/key-management","type":"heading","tags":[],"url":"/docs/pr-preview/pr-24/platform/pki/key-management#qué-resuelve-el-kms","content":"Qué resuelve el KMS"},"1935":{"id":"/docs/pr-preview/pr-24/platform/pki/key-management-3","page_id":"/docs/pr-preview/pr-24/platform/pki/key-management","type":"heading","tags":[],"url":"/docs/pr-preview/pr-24/platform/pki/key-management#motores-criptográficos","content":"Motores criptográficos"},"1936":{"id":"/docs/pr-preview/pr-24/platform/pki/key-management-4","page_id":"/docs/pr-preview/pr-24/platform/pki/key-management","type":"heading","tags":[],"url":"/docs/pr-preview/pr-24/platform/pki/key-management#file-system","content":"File System"},"1937":{"id":"/docs/pr-preview/pr-24/platform/pki/key-management-5","page_id":"/docs/pr-preview/pr-24/platform/pki/key-management","type":"heading","tags":[],"url":"/docs/pr-preview/pr-24/platform/pki/key-management#hashicorp-vault","content":"HashiCorp Vault"},"1938":{"id":"/docs/pr-preview/pr-24/platform/pki/key-management-6","page_id":"/docs/pr-preview/pr-24/platform/pki/key-management","type":"heading","tags":[],"url":"/docs/pr-preview/pr-24/platform/pki/key-management#aws-secrets-manager","content":"AWS Secrets Manager"},"1939":{"id":"/docs/pr-preview/pr-24/platform/pki/key-management-7","page_id":"/docs/pr-preview/pr-24/platform/pki/key-management","type":"heading","tags":[],"url":"/docs/pr-preview/pr-24/platform/pki/key-management#aws-kms","content":"AWS KMS"},"1940":{"id":"/docs/pr-preview/pr-24/platform/pki/key-management-8","page_id":"/docs/pr-preview/pr-24/platform/pki/key-management","type":"heading","tags":[],"url":"/docs/pr-preview/pr-24/platform/pki/key-management#pkcs11","content":"PKCS#11"},"1941":{"id":"/docs/pr-preview/pr-24/platform/pki/key-management-9","page_id":"/docs/pr-preview/pr-24/platform/pki/key-management","type":"heading","tags":[],"url":"/docs/pr-preview/pr-24/platform/pki/key-management#inventario-de-claves","content":"Inventario de claves"},"1942":{"id":"/docs/pr-preview/pr-24/platform/pki/key-management-10","page_id":"/docs/pr-preview/pr-24/platform/pki/key-management","type":"heading","tags":[],"url":"/docs/pr-preview/pr-24/platform/pki/key-management#crear-o-importar-claves","content":"Crear o importar claves"},"1943":{"id":"/docs/pr-preview/pr-24/platform/pki/key-management-11","page_id":"/docs/pr-preview/pr-24/platform/pki/key-management","type":"heading","tags":[],"url":"/docs/pr-preview/pr-24/platform/pki/key-management#generar-un-nuevo-par-de-claves","content":"Generar un nuevo par de claves"},"1944":{"id":"/docs/pr-preview/pr-24/platform/pki/key-management-12","page_id":"/docs/pr-preview/pr-24/platform/pki/key-management","type":"heading","tags":[],"url":"/docs/pr-preview/pr-24/platform/pki/key-management#importar-un-par-existente","content":"Importar un par existente"},"1945":{"id":"/docs/pr-preview/pr-24/platform/pki/key-management-13","page_id":"/docs/pr-preview/pr-24/platform/pki/key-management","type":"heading","tags":[],"url":"/docs/pr-preview/pr-24/platform/pki/key-management#operaciones-sobre-una-clave","content":"Operaciones sobre una clave"},"1946":{"id":"/docs/pr-preview/pr-24/platform/pki/key-management-14","page_id":"/docs/pr-preview/pr-24/platform/pki/key-management","type":"heading","tags":[],"url":"/docs/pr-preview/pr-24/platform/pki/key-management#ver-detalles","content":"Ver detalles"},"1947":{"id":"/docs/pr-preview/pr-24/platform/pki/key-management-15","page_id":"/docs/pr-preview/pr-24/platform/pki/key-management","type":"heading","tags":[],"url":"/docs/pr-preview/pr-24/platform/pki/key-management#firmar-y-verificar","content":"Firmar y verificar"},"1948":{"id":"/docs/pr-preview/pr-24/platform/pki/key-management-16","page_id":"/docs/pr-preview/pr-24/platform/pki/key-management","type":"heading","tags":[],"url":"/docs/pr-preview/pr-24/platform/pki/key-management#sign","content":"Sign"},"1949":{"id":"/docs/pr-preview/pr-24/platform/pki/key-management-17","page_id":"/docs/pr-preview/pr-24/platform/pki/key-management","type":"heading","tags":[],"url":"/docs/pr-preview/pr-24/platform/pki/key-management#verify","content":"Verify"},"1950":{"id":"/docs/pr-preview/pr-24/platform/pki/key-management-18","page_id":"/docs/pr-preview/pr-24/platform/pki/key-management","type":"heading","tags":[],"url":"/docs/pr-preview/pr-24/platform/pki/key-management#generar-un-csr","content":"Generar un CSR"},"1951":{"id":"/docs/pr-preview/pr-24/platform/pki/key-management-19","page_id":"/docs/pr-preview/pr-24/platform/pki/key-management","type":"heading","tags":[],"url":"/docs/pr-preview/pr-24/platform/pki/key-management#firma-local-con-pkcs11","content":"Firma local con PKCS#11"},"1952":{"id":"/docs/pr-preview/pr-24/platform/pki/key-management-20","page_id":"/docs/pr-preview/pr-24/platform/pki/key-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/key-management#gestión-de-claves-criptográficas","content":"El servicio de Gestión de Claves Criptográficas (KMS) de Lamassu IoT centraliza la generación, importación, custodia y uso de las claves de la plataforma. Desde aquí se gestionan las claves que soportan a las CAs y al resto de operaciones de firma que dependen de la PKI."},"1953":{"id":"/docs/pr-preview/pr-24/platform/pki/key-management-21","page_id":"/docs/pr-preview/pr-24/platform/pki/key-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/key-management#gestión-de-claves-criptográficas","content":"En la configuración actual, Lamassu IoT trabaja exclusivamente con claves asimétricas, como RSA y curvas elípticas. Estas claves se usan para emitir certificados X.509, firmar solicitudes y realizar operaciones de autenticación y validación dentro del sistema."},"1954":{"id":"/docs/pr-preview/pr-24/platform/pki/key-management-22","page_id":"/docs/pr-preview/pr-24/platform/pki/key-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/key-management#qué-resuelve-el-kms","content":"El KMS unifica la gestión del ciclo de vida de las claves y evita que cada servicio tenga que integrarse directamente con un proveedor criptográfico concreto."},"1955":{"id":"/docs/pr-preview/pr-24/platform/pki/key-management-23","page_id":"/docs/pr-preview/pr-24/platform/pki/key-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/key-management#qué-resuelve-el-kms","content":"En la práctica, permite:"},"1956":{"id":"/docs/pr-preview/pr-24/platform/pki/key-management-24","page_id":"/docs/pr-preview/pr-24/platform/pki/key-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/key-management#qué-resuelve-el-kms","content":"Generar nuevos pares de claves desde Lamassu IoT."},"1957":{"id":"/docs/pr-preview/pr-24/platform/pki/key-management-25","page_id":"/docs/pr-preview/pr-24/platform/pki/key-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/key-management#qué-resuelve-el-kms","content":"Importar claves creadas externamente."},"1958":{"id":"/docs/pr-preview/pr-24/platform/pki/key-management-26","page_id":"/docs/pr-preview/pr-24/platform/pki/key-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/key-management#qué-resuelve-el-kms","content":"Delegar la custodia y las operaciones criptográficas en motores externos."},"1959":{"id":"/docs/pr-preview/pr-24/platform/pki/key-management-27","page_id":"/docs/pr-preview/pr-24/platform/pki/key-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/key-management#qué-resuelve-el-kms","content":"Reutilizar claves ya existentes para CAs, CSR y tareas de firma o verificación."},"1960":{"id":"/docs/pr-preview/pr-24/platform/pki/key-management-28","page_id":"/docs/pr-preview/pr-24/platform/pki/key-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/key-management#motores-criptográficos","content":"Lamassu puede trabajar con distintos motores criptográficos según los requisitos del despliegue. En algunos entornos bastará con un motor software; en otros será necesario delegar la custodia en un HSM, en un servicio cloud o en una plataforma especializada."},"1961":{"id":"/docs/pr-preview/pr-24/platform/pki/key-management-29","page_id":"/docs/pr-preview/pr-24/platform/pki/key-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/key-management#motores-criptográficos","content":"Una misma instancia puede tener varios motores configurados al mismo tiempo, incluso varias instancias del mismo tipo. Esto permite adaptar la operación a distintos niveles de seguridad, coste y requisitos regulatorios."},"1962":{"id":"/docs/pr-preview/pr-24/platform/pki/key-management-30","page_id":"/docs/pr-preview/pr-24/platform/pki/key-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/key-management#motores-criptográficos","content":"Actualmente, Lamassu soporta cinco tipos de motor. Elige según el nivel de aislamiento que necesites y quién debe poder acceder al material privado."},"1963":{"id":"/docs/pr-preview/pr-24/platform/pki/key-management-31","page_id":"/docs/pr-preview/pr-24/platform/pki/key-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/key-management#file-system","content":"Genera las claves con las librerías criptográficas de Go y delega su protección en el sistema de archivos. Funciona tanto on-premise como en cloud, pero no evita la extracción de la clave y no está recomendado para producción."},"1964":{"id":"/docs/pr-preview/pr-24/platform/pki/key-management-32","page_id":"/docs/pr-preview/pr-24/platform/pki/key-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/key-management#hashicorp-vault","content":"Protege las claves en reposo y puede ejecutarse on-premise o en cloud. Un administrador con permisos suficientes todavía puede visualizar el material privado, por lo que conviene limitar el acceso administrativo y custodiar las claves de *unseal*."},"1965":{"id":"/docs/pr-preview/pr-24/platform/pki/key-management-33","page_id":"/docs/pr-preview/pr-24/platform/pki/key-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/key-management#aws-secrets-manager","content":"Ofrece persistencia cifrada en AWS con coste asociado. Protege la clave en reposo, pero un administrador autorizado puede recuperarla; no proporciona la misma resistencia a la extracción que un KMS o HSM."},"1966":{"id":"/docs/pr-preview/pr-24/platform/pki/key-management-34","page_id":"/docs/pr-preview/pr-24/platform/pki/key-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/key-management#aws-kms","content":"Genera las claves con entropía hardware y no expone la clave privada. Las operaciones se ejecutan dentro del servicio. Aun así, una identidad con permisos suficientes podría utilizar la clave para firmar, por lo que la política IAM sigue siendo crítica."},"1967":{"id":"/docs/pr-preview/pr-24/platform/pki/key-management-35","page_id":"/docs/pr-preview/pr-24/platform/pki/key-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/key-management#pkcs11","content":"Permite integrar HSMs locales, entornos aislados y servicios *Key as a Service*. La generación, persistencia y resistencia a la extracción dependen del dispositivo o proveedor concreto. Es la opción más flexible cuando la política exige custodia hardware."},"1968":{"id":"/docs/pr-preview/pr-24/platform/pki/key-management-36","page_id":"/docs/pr-preview/pr-24/platform/pki/key-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/key-management#pkcs11","content":"Lamassu muestra en la consola el listado completo de motores habilitados."},"1969":{"id":"/docs/pr-preview/pr-24/platform/pki/key-management-37","page_id":"/docs/pr-preview/pr-24/platform/pki/key-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/key-management#pkcs11","content":"Cada motor define qué algoritmos soporta, como RSA o ECC/ECDSA, y qué tamaños de clave puede generar."},"1970":{"id":"/docs/pr-preview/pr-24/platform/pki/key-management-38","page_id":"/docs/pr-preview/pr-24/platform/pki/key-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/key-management#pkcs11","content":"Durante el despliegue es obligatorio definir un motor por defecto. Ese motor se utilizará cuando un proceso necesite crear o persistir una clave y el usuario no haya seleccionado uno específico, por ejemplo al crear o importar una CA."},"1971":{"id":"/docs/pr-preview/pr-24/platform/pki/key-management-39","page_id":"/docs/pr-preview/pr-24/platform/pki/key-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/key-management#inventario-de-claves","content":"La pantalla principal de KMS muestra el inventario completo de claves registradas en el sistema. Es la vista de referencia para revisar qué claves existen, dónde están custodiadas y con qué entidades están relacionadas."},"1972":{"id":"/docs/pr-preview/pr-24/platform/pki/key-management-40","page_id":"/docs/pr-preview/pr-24/platform/pki/key-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/key-management#inventario-de-claves","content":"La tabla incluye los siguientes campos:"},"1973":{"id":"/docs/pr-preview/pr-24/platform/pki/key-management-41","page_id":"/docs/pr-preview/pr-24/platform/pki/key-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/key-management#inventario-de-claves","content":"**Name**: nombre descriptivo de la clave."},"1974":{"id":"/docs/pr-preview/pr-24/platform/pki/key-management-42","page_id":"/docs/pr-preview/pr-24/platform/pki/key-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/key-management#inventario-de-claves","content":"**Type**: algoritmo y tamaño de clave, por ejemplo RSA 2048 o EC P-256."},"1975":{"id":"/docs/pr-preview/pr-24/platform/pki/key-management-43","page_id":"/docs/pr-preview/pr-24/platform/pki/key-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/key-management#inventario-de-claves","content":"**Strength**: indicador visual de fortaleza criptográfica."},"1976":{"id":"/docs/pr-preview/pr-24/platform/pki/key-management-44","page_id":"/docs/pr-preview/pr-24/platform/pki/key-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/key-management#inventario-de-claves","content":"**Public/Private**: indica si Lamassu gestiona el par completo o solo la clave pública."},"1977":{"id":"/docs/pr-preview/pr-24/platform/pki/key-management-45","page_id":"/docs/pr-preview/pr-24/platform/pki/key-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/key-management#inventario-de-claves","content":"**Crypto Engine**: motor criptográfico que custodia la clave."},"1978":{"id":"/docs/pr-preview/pr-24/platform/pki/key-management-46","page_id":"/docs/pr-preview/pr-24/platform/pki/key-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/key-management#inventario-de-claves","content":"**Aliases**: nombres alternativos asociados a la clave."},"1979":{"id":"/docs/pr-preview/pr-24/platform/pki/key-management-47","page_id":"/docs/pr-preview/pr-24/platform/pki/key-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/key-management#inventario-de-claves","content":"**Tags**: etiquetas para clasificación y búsqueda."},"1980":{"id":"/docs/pr-preview/pr-24/platform/pki/key-management-48","page_id":"/docs/pr-preview/pr-24/platform/pki/key-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/key-management#inventario-de-claves","content":"**Related Entities**: certificados u otras entidades vinculadas a esa clave."},"1981":{"id":"/docs/pr-preview/pr-24/platform/pki/key-management-49","page_id":"/docs/pr-preview/pr-24/platform/pki/key-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/key-management#inventario-de-claves","content":"Desde esta vista también se accede a las acciones más habituales:"},"1982":{"id":"/docs/pr-preview/pr-24/platform/pki/key-management-50","page_id":"/docs/pr-preview/pr-24/platform/pki/key-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/key-management#inventario-de-claves","content":"**View Details** para consultar metadatos, identificadores y relaciones."},"1983":{"id":"/docs/pr-preview/pr-24/platform/pki/key-management-51","page_id":"/docs/pr-preview/pr-24/platform/pki/key-management","tags":[],"type":"text","url":"/docs/pr-p