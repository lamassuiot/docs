s/pr-preview/pr-24/platform/pki/device-enrollment-3","page_id":"/docs/pr-preview/pr-24/platform/pki/device-enrollment","type":"heading","tags":[],"url":"/docs/pr-preview/pr-24/platform/pki/device-enrollment#identifica-la-flota","content":"Identifica la flota"},"1418":{"id":"/docs/pr-preview/pr-24/platform/pki/device-enrollment-4","page_id":"/docs/pr-preview/pr-24/platform/pki/device-enrollment","type":"heading","tags":[],"url":"/docs/pr-preview/pr-24/platform/pki/device-enrollment#selecciona-la-ca-de-enrolamiento","content":"Selecciona la CA de enrolamiento"},"1419":{"id":"/docs/pr-preview/pr-24/platform/pki/device-enrollment-5","page_id":"/docs/pr-preview/pr-24/platform/pki/device-enrollment","type":"heading","tags":[],"url":"/docs/pr-preview/pr-24/platform/pki/device-enrollment#configura-el-protocolo-de-enrolamiento","content":"Configura el protocolo de enrolamiento"},"1420":{"id":"/docs/pr-preview/pr-24/platform/pki/device-enrollment-6","page_id":"/docs/pr-preview/pr-24/platform/pki/device-enrollment","type":"heading","tags":[],"url":"/docs/pr-preview/pr-24/platform/pki/device-enrollment#distribuye-la-confianza","content":"Distribuye la confianza"},"1421":{"id":"/docs/pr-preview/pr-24/platform/pki/device-enrollment-7","page_id":"/docs/pr-preview/pr-24/platform/pki/device-enrollment","type":"heading","tags":[],"url":"/docs/pr-preview/pr-24/platform/pki/device-enrollment#verifica-los-endpoints","content":"Verifica los endpoints"},"1422":{"id":"/docs/pr-preview/pr-24/platform/pki/device-enrollment-8","page_id":"/docs/pr-preview/pr-24/platform/pki/device-enrollment","type":"heading","tags":[],"url":"/docs/pr-preview/pr-24/platform/pki/device-enrollment#distribución-de-confianza","content":"Distribución de confianza"},"1423":{"id":"/docs/pr-preview/pr-24/platform/pki/device-enrollment-9","page_id":"/docs/pr-preview/pr-24/platform/pki/device-enrollment","type":"heading","tags":[],"url":"/docs/pr-preview/pr-24/platform/pki/device-enrollment#opera-el-inventario-de-dms","content":"Opera el inventario de DMS"},"1424":{"id":"/docs/pr-preview/pr-24/platform/pki/device-enrollment-10","page_id":"/docs/pr-preview/pr-24/platform/pki/device-enrollment","type":"heading","tags":[],"url":"/docs/pr-preview/pr-24/platform/pki/device-enrollment#integra-los-dispositivos","content":"Integra los dispositivos"},"1425":{"id":"/docs/pr-preview/pr-24/platform/pki/device-enrollment-11","page_id":"/docs/pr-preview/pr-24/platform/pki/device-enrollment","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/device-enrollment","content":"Un &#x2A;*Device Management Service (DMS)** actúa como autoridad de registro frente a una flota. Recibe solicitudes, aplica la política de autenticación y encarga la emisión a la CA configurada."},"1426":{"id":"/docs/pr-preview/pr-24/platform/pki/device-enrollment-12","page_id":"/docs/pr-preview/pr-24/platform/pki/device-enrollment","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/device-enrollment","content":"Cada DMS es un límite operativo independiente: puede representar una línea de producto, un entorno o un tipo de dispositivo con su propia CA, reglas de autenticación, confianza distribuida y ventana de renovación."},"1427":{"id":"/docs/pr-preview/pr-24/platform/pki/device-enrollment-13","page_id":"/docs/pr-preview/pr-24/platform/pki/device-enrollment","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/device-enrollment","content":"Cada DMS expone un único protocolo de enrolamiento, seleccionado al crearlo o editarlo: &#x2A;*EST (RFC 7030)** o &#x2A;*CMP (RFC 9483 Lightweight CMP Profile / RFC 4210)**. Los dos protocolos son mutuamente excluyentes: cambiar el protocolo de un DMS existente sustituye por completo su configuración de enrolamiento, sin migración automática de ajustes. La configuración de cada protocolo y la guía de integración para dispositivos se documentan en las páginas de EST y CMP."},"1428":{"id":"/docs/pr-preview/pr-24/platform/pki/device-enrollment-14","page_id":"/docs/pr-preview/pr-24/platform/pki/device-enrollment","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/device-enrollment#antes-de-empezar","content":"Crea o importa al menos una CA activa."},"1429":{"id":"/docs/pr-preview/pr-24/platform/pki/device-enrollment-15","page_id":"/docs/pr-preview/pr-24/platform/pki/device-enrollment","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/device-enrollment#antes-de-empezar","content":"Decide cómo se autenticarán los dispositivos durante el primer enrolamiento."},"1430":{"id":"/docs/pr-preview/pr-24/platform/pki/device-enrollment-16","page_id":"/docs/pr-preview/pr-24/platform/pki/device-enrollment","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/device-enrollment#antes-de-empezar","content":"Define qué autoridades debe recibir el dispositivo como anclas de confianza."},"1431":{"id":"/docs/pr-preview/pr-24/platform/pki/device-enrollment-17","page_id":"/docs/pr-preview/pr-24/platform/pki/device-enrollment","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/device-enrollment#antes-de-empezar","content":"Asegúrate de tener permisos para administrar DMS."},"1432":{"id":"/docs/pr-preview/pr-24/platform/pki/device-enrollment-18","page_id":"/docs/pr-preview/pr-24/platform/pki/device-enrollment","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/device-enrollment#identifica-la-flota","content":"Asigna al DMS un nombre que describa su alcance, por ejemplo una familia de dispositivos o un entorno."},"1433":{"id":"/docs/pr-preview/pr-24/platform/pki/device-enrollment-19","page_id":"/docs/pr-preview/pr-24/platform/pki/device-enrollment","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/device-enrollment#selecciona-la-ca-de-enrolamiento","content":"Elige la autoridad que emitirá las identidades. Su política y periodo de validez condicionan los certificados que podrá obtener la flota."},"1434":{"id":"/docs/pr-preview/pr-24/platform/pki/device-enrollment-20","page_id":"/docs/pr-preview/pr-24/platform/pki/device-enrollment","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/device-enrollment#configura-el-protocolo-de-enrolamiento","content":"Selecciona EST (RFC 7030) o CMP (RFC 9483) y define la autenticación de `enroll`, la política de `reenroll`, la ventana de renovación y, si se necesita, la generación de claves en servidor."},"1435":{"id":"/docs/pr-preview/pr-24/platform/pki/device-enrollment-21","page_id":"/docs/pr-preview/pr-24/platform/pki/device-enrollment","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/device-enrollment#distribuye-la-confianza","content":"Configura **CA Distribution** para controlar qué autoridades recibe el dispositivo como anclas de confianza, con independencia del protocolo de enrolamiento."},"1436":{"id":"/docs/pr-preview/pr-24/platform/pki/device-enrollment-22","page_id":"/docs/pr-preview/pr-24/platform/pki/device-enrollment","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/device-enrollment#verifica-los-endpoints","content":"Desde el menú del DMS, abre &#x2A;*EST (RFC-7030)** y comprueba la URL base y los ejemplos de invocación antes de integrar el firmware."},"1437":{"id":"/docs/pr-preview/pr-24/platform/pki/device-enrollment-23","page_id":"/docs/pr-preview/pr-24/platform/pki/device-enrollment","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/device-enrollment#distribución-de-confianza","content":"**Include Lamassu System CA** distribuye el certificado TLS del servidor Lamassu, útil para *pinning*. No representa una CA de emisión."},"1438":{"id":"/docs/pr-preview/pr-24/platform/pki/device-enrollment-24","page_id":"/docs/pr-preview/pr-24/platform/pki/device-enrollment","tags":[],"type":"text","url":"/docs/pr-preview/pr-24/platform/pki/device-enrollment#distribución-de-confianza","content":"**Include Enrollment CA** añade la autoridad configurada para emitir las identidades del DMS."},"1439":{"i